import DynExpr.Simplify.EnumProps
import DynExpr.Simplify.HeapOps

/-!
Object and array aliasing for `src/OperatorEnumConstruction.jl`: the node
methods generated by `@extend_operators` on the heap model, and the
vector-form enum constructors.
-/

namespace DynExpr.Simplify

open DynExpr

variable {T : Type}

/-- A new constant leaf, `constructorof(N)(T; val=v)` (src/Node.jl:385-394). -/
def constCellOf (v : T) : Cell T := ⟨0, true, some v, 0, 0, []⟩

/-- A new operator node, `constructorof(N)(; op, children)` (src/Node.jl:407-429);
the `constant` field of a branch is never read. -/
def branchCellOf (op : Nat) (cs : List Addr) : Cell T := ⟨cs.length, false, none, 0, op, cs⟩

/-- Generated method `f(l::N, r::N)` (src/OperatorEnumConstruction.jl:174-183)
on the heap: an all-constant call allocates a new constant leaf, otherwise a
new node whose children are the argument objects themselves. -/
def callBinaryHeap (I : Fn → List T → T) (st : Globals) (f : Fn) (g : Graph T) (l r : Addr) :
    Jl (Addr × Graph T) := do
  if !st.defined 2 f then throw (.methodError "no method")
  if cellConst (← g.read l) && cellConst (← g.read r) then
    let a ← valOf g l
    let b ← valOf g r
    pure (g.alloc (constCellOf (I f [a, b])))
  else
    let idx ← lookupOp st f 2 false
    pure (g.alloc (branchCellOf idx [l, r]))

/-- Generated method `f(l::N, r::T)` (lines 184-196): the scalar becomes a new
constant leaf. -/
def callBinaryNSHeap (I : Fn → List T → T) (st : Globals) (f : Fn) (g : Graph T) (l : Addr)
    (b : T) : Jl (Addr × Graph T) := do
  if !st.defined 2 f then throw (.methodError "no method")
  if cellConst (← g.read l) then
    let a ← valOf g l
    pure (g.alloc (constCellOf (I f [a, b])))
  else
    let idx ← lookupOp st f 2 false
    let (c, g) := g.alloc (constCellOf b)
    pure (g.alloc (branchCellOf idx [l, c]))

/-- Generated method `f(l::N)` (lines 151-164). -/
def callUnaryHeap (I : Fn → List T → T) (st : Globals) (f : Fn) (g : Graph T) (l : Addr) :
    Jl (Addr × Graph T) := do
  if !st.defined 1 f then throw (.methodError "no method")
  if cellConst (← g.read l) then
    let a ← valOf g l
    pure (g.alloc (constCellOf (I f [a])))
  else
    let idx ← lookupOp st f 1 false
    pure (g.alloc (branchCellOf idx [l]))

/-- Generated node methods never create sharing: from alias-free arguments
whose subtrees are disjoint, when the operator has a generated method and a
mapping for the arity (input global state), the unary, node-node binary and
node-scalar binary methods succeed, return an alias-free tree, and leave every
existing object unchanged. -/
def overload_heap_noalias : Prop :=
  ∀ (T : Type) (I : Fn → List T → T) (st : Globals) (f : Fn) (g : Graph T) (l r : Addr)
    (fuel : Nat) (tl tr : Tree T),
    g.unfold fuel l = some tl → g.unfold fuel r = some tr →
    Graph.NoAlias g l → Graph.NoAlias g r →
    (∀ a, Graph.Reachable g l a → ¬ Graph.Reachable g r a) →
    (st.defined 1 f = true → (∃ i, st.mapping 1 f = some i) →
      ∃ n g', callUnaryHeap I st f g l = .ok (n, g') ∧
        Graph.NoAlias g' n ∧ ∀ a, a < g.next → g'.cells a = g.cells a) ∧
    (st.defined 2 f = true → (∃ i, st.mapping 2 f = some i) →
      (∃ n g', callBinaryHeap I st f g l r = .ok (n, g') ∧
        Graph.NoAlias g' n ∧ ∀ a, a < g.next → g'.cells a = g.cells a) ∧
      ∀ b : T, ∃ n g', callBinaryNSHeap I st f g l b = .ok (n, g') ∧
        Graph.NoAlias g' n ∧ ∀ a, a < g.next → g'.cells a = g.cells a)

/-- Vector-form constructors `OperatorEnum(1 => [ops...], ...)`
(src/OperatorEnumConstruction.jl:568-578) convert each vector with `Tuple`,
copying its current elements; vectors live in a heap of operator lists. -/
def makeEnumVec (inBase : Fn → Bool) (kind : EnumKind) (vh : Heap (List Fn))
    (p : Int × Addr) (ps : List (Int × Addr)) (defineHelpers emptyOld : Bool) (st : Globals) :
    Jl (List (List Fn) × Globals) := do
  let tup ← vh.read p.2
  let tups ← ps.mapM (fun q => do pure (q.1, ← vh.read q.2))
  makeEnum inBase kind (p.1, tup) tups defineHelpers emptyOld st

/-- The vector-form constructors (src/OperatorEnumConstruction.jl:568-578)
read each input vector once and build the enum from the contents read: with
reasonable contents and distinct degree keys, construction succeeds and each
degree slot holds exactly the contents of its vector at call time (later
writes to the vectors cannot reach the immutable tuples). -/
def enum_vector_pairs_copy : Prop :=
  ∀ (inBase : Fn → Bool) (kind : EnumKind) (vh : Heap (List Fn)) (p : Int × Addr)
    (ps : List (Int × Addr)) (helpers emptyOld : Bool) (st : Globals)
    (tup : List Fn) (tups : List (Int × List Fn)),
    vh.read p.2 = .ok tup → ps.mapM (fun q => do pure (q.1, ← vh.read q.2)) = .ok tups →
    EnumInput (p.1, tup) tups → (((p.1, tup) :: tups).map Prod.fst).Nodup →
    ∃ ops st', makeEnumVec inBase kind vh p ps helpers emptyOld st = .ok (ops, st') ∧
      ∀ q ∈ (p.1, tup) :: tups, ops[q.1.toNat - 1]? = some q.2

end DynExpr.Simplify
