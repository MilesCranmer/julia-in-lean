import DynExpr.NoAlias.Build

/-!
Node methods generated by `@extend_operators` / `OperatorEnum(...;
define_helper_functions=true)` (`src/OperatorEnumConstruction.jl:148-273`),
mirrored on the NodeBase heap with the generic constructor `NodeBase.ctor`.
Each operator index argument is the value returned by `lookup_op`
(`src/OperatorEnumConstruction.jl:113-121`); `constructorof(N)` is the type
wrapper `Node`, which fixes no maximum degree (`hasD = false`).
-/

namespace DynExpr.NoAlias
open DynExpr Graph NodeBase

variable {T : Type}

/-- `n.degree == 0 && n.constant` (`src/OperatorEnumConstruction.jl:157,177,187,200,251`). -/
def isConstNode (g : SGraph T) (a : Addr) : Jl Bool := do
  let c ← g.read a
  pure (c.degree == 0 && c.constant)

/-- Reading `n.val`; an unset field raises `UndefRefError`. -/
def valNode (g : SGraph T) (a : Addr) : Jl T := do
  let c ← g.read a
  match c.val with
  | some v => pure v
  | none => throw .undefRefError

/-- Unary method (`src/OperatorEnumConstruction.jl:153-163`): fold a constant
operand, otherwise build `N(; op, children=(l,))`. -/
def opUnary (g : SGraph T) (D : Nat) (f : T → T) (idx : Nat) (l : Addr) :
    Jl (Addr × SGraph T) := do
  if ← isConstNode g l then
    ctor g D false { val := some (f (← valNode g l)) }
  else ctor g D false { op := some idx, children := some [l] }

/-- Binary node-node method (`src/OperatorEnumConstruction.jl:173-183`), with
the short-circuit `&&` of line 177. -/
def opBinary (g : SGraph T) (D : Nat) (f : T → T → T) (idx : Nat) (l r : Addr) :
    Jl (Addr × SGraph T) := do
  if ← isConstNode g l then
    if ← isConstNode g r then
      ctor g D false { val := some (f (← valNode g l) (← valNode g r)) }
    else ctor g D false { op := some idx, children := some [l, r] }
  else ctor g D false { op := some idx, children := some [l, r] }

/-- Binary node-scalar method (`src/OperatorEnumConstruction.jl:184-196`): the
scalar becomes a new constant leaf, allocated before the parent. -/
def opNodeScalar (g : SGraph T) (D : Nat) (f : T → T → T) (idx : Nat) (l : Addr) (x : T) :
    Jl (Addr × SGraph T) := do
  if ← isConstNode g l then
    ctor g D false { val := some (f (← valNode g l) x) }
  else
    let (k, g1) ← ctor g D false { val := some x }
    ctor g1 D false { op := some idx, children := some [l, k] }

/-- Binary scalar-node method (`src/OperatorEnumConstruction.jl:197-209`). -/
def opScalarNode (g : SGraph T) (D : Nat) (f : T → T → T) (idx : Nat) (x : T) (r : Addr) :
    Jl (Addr × SGraph T) := do
  if ← isConstNode g r then
    ctor g D false { val := some (f x (← valNode g r)) }
  else
    let (k, g1) ← ctor g D false { val := some x }
    ctor g1 D false { op := some idx, children := some [k, r] }

/-- `foldl(f_outside, args)` through the binary method (`src/OperatorEnumConstruction.jl:263`). -/
def chainBinary (D : Nat) (f : T → T → T) (idx : Nat) :
    Addr → List Addr → SGraph T → Jl (Addr × SGraph T)
  | acc, [], g => pure (acc, g)
  | acc, b :: bs, g => do
    let (n, g1) ← opBinary g D f idx acc b
    chainBinary D f idx n bs g1

/-- N-ary method (`src/OperatorEnumConstruction.jl:245-272`). `idx = 0`
models `lookup_op(...; allow_failure=true)` failing for a chainable `+`/`*`,
in which case the calls are chained through the binary method with index
`binIdx`. -/
def opNary (g : SGraph T) (D : Nat) (f : List T → T) (chainable : Bool) (idx : Nat)
    (bin : T → T → T) (binIdx : Nat) (args : List Addr) : Jl (Addr × SGraph T) := do
  if ← args.allM (isConstNode g) then
    ctor g D false { val := some (f (← args.mapM (valNode g))) }
  else if chainable && idx == 0 then
    match args with
    | [] => throw (.argumentError "reducing over an empty collection is not allowed")
    | a :: as => chainBinary D bin binIdx a as g
  else ctor g D false { op := some idx, children := some args }

/-! ## Build facts -/

theorem built_val {g g' : SGraph T} {D : Nat} {hasD : Bool} {v : T} {n : Addr}
    (ins : List Addr) (h : ctor g D hasD { val := some v } = .ok (n, g')) : Built g g' ins n :=
  built_mono (fun _ h => absurd h List.not_mem_nil)
    (ctor_built (kw := { val := some v }) (trees_nil _) (pairDisj_nil _) h).2

theorem built_kids {g g' : SGraph T} {D : Nat} {hasD : Bool} {o : Nat} {cs : List Addr} {n : Addr}
    (ht : Trees g.view cs) (hp : PairDisj g.view cs)
    (h : ctor g D hasD { op := some o, children := some cs } = .ok (n, g')) : Built g g' cs n :=
  (ctor_built (kw := { op := some o, children := some cs }) ht hp h).2

theorem bind_ok {α β : Type} {x : Jl α} {f : α → Jl β} {b : β} (h : (x >>= f) = .ok b) :
    ∃ a, x = .ok a ∧ f a = .ok b := by
  cases hx : x with
  | error e => rw [hx] at h; cases h
  | ok a => rw [hx] at h; exact ⟨a, rfl, h⟩

theorem ite_bool_ok {α : Type} {c : Bool} {x y : Jl α} {a : α}
    (h : (if c = true then x else y) = .ok a) : (c = true ∧ x = .ok a) ∨ (c = false ∧ y = .ok a) := by
  cases c
  · exact Or.inr ⟨rfl, h⟩
  · exact Or.inl ⟨rfl, h⟩

theorem trees_single {g : Graph T} {a : Addr} (h : Trees g [a]) : PairDisj g [a] :=
  ⟨by simp, fun b hb b' hb' hne => by simp at hb hb'; subst hb hb'; exact absurd rfl hne⟩

theorem opUnary_built {g g' : SGraph T} {D : Nat} {f : T → T} {idx l n : Addr}
    (ht : Trees g.view [l]) (h : opUnary g D f idx l = .ok (n, g')) : Built g g' [l] n := by
  unfold opUnary at h
  obtain ⟨b, _, h⟩ := bind_ok h
  rcases ite_bool_ok h with ⟨_, h⟩ | ⟨_, h⟩
  · obtain ⟨v, _, h⟩ := bind_ok h
    exact built_val _ h
  · exact built_kids ht (trees_single ht) h

theorem opBinary_built {g g' : SGraph T} {D : Nat} {f : T → T → T} {idx l r n : Addr}
    (ht : Trees g.view [l, r]) (hp : PairDisj g.view [l, r])
    (h : opBinary g D f idx l r = .ok (n, g')) : Built g g' [l, r] n := by
  unfold opBinary at h
  obtain ⟨b, _, h⟩ := bind_ok h
  rcases ite_bool_ok h with ⟨_, h⟩ | ⟨_, h⟩
  · obtain ⟨b', _, h⟩ := bind_ok h
    rcases ite_bool_ok h with ⟨_, h⟩ | ⟨_, h⟩
    · obtain ⟨v, _, h⟩ := bind_ok h
      obtain ⟨w, _, h⟩ := bind_ok h
      exact built_val _ h
    · exact built_kids ht hp h
  · exact built_kids ht hp h

theorem opNodeScalar_built {g g' : SGraph T} {D : Nat} {f : T → T → T} {idx l n : Addr} {x : T}
    (ht : Trees g.view [l]) (h : opNodeScalar g D f idx l x = .ok (n, g')) : Built g g' [l] n := by
  unfold opNodeScalar at h
  obtain ⟨b, _, h⟩ := bind_ok h
  rcases ite_bool_ok h with ⟨_, h⟩ | ⟨_, h⟩
  · obtain ⟨v, _, h⟩ := bind_ok h
    exact built_val _ h
  · obtain ⟨⟨k, g1⟩, hk, h⟩ := bind_ok h
    have i1 := inv_step (inv_nil g) (built_input ht) ht (fun _ h => absurd h List.not_mem_nil)
    have i2 := inv_step i1 (built_val (ins := []) hk) (trees_nil _) (fun _ _ _ h => absurd h List.not_mem_nil)
    simpa using built_ctor_inv i2 rfl h

theorem opScalarNode_built {g g' : SGraph T} {D : Nat} {f : T → T → T} {idx r n : Addr} {x : T}
    (ht : Trees g.view [r]) (h : opScalarNode g D f idx x r = .ok (n, g')) : Built g g' [r] n := by
  unfold opScalarNode at h
  obtain ⟨b, _, h⟩ := bind_ok h
  rcases ite_bool_ok h with ⟨_, h⟩ | ⟨_, h⟩
  · obtain ⟨v, _, h⟩ := bind_ok h
    exact built_val _ h
  · obtain ⟨⟨k, g1⟩, hk, h⟩ := bind_ok h
    have i1 := inv_step (inv_nil g) (built_val (ins := []) hk) (trees_nil _)
      (fun _ h => absurd h List.not_mem_nil)
    have i2 := inv_step i1 (built_input (trees_ext (built_val (ins := []) hk).ext ht)) ht
      (fun _ h => absurd h List.not_mem_nil)
    simpa using built_ctor_inv i2 rfl h

theorem chainBinary_built {D : Nat} {f : T → T → T} {idx : Nat} :
    ∀ (bs : List Addr) (g0 g g' : SGraph T) (ins : List Addr) (acc n : Addr),
      Built g0 g ins acc → Trees g0.view (ins ++ bs) → PairDisj g0.view (ins ++ bs) →
      chainBinary D f idx acc bs g = .ok (n, g') → Built g0 g' (ins ++ bs) n := by
  intro bs
  induction bs with
  | nil => intro g0 g g' ins acc n hb _ _ h; cases h; simpa using hb
  | cons b bs ih =>
    intro g0 g g' ins acc n hb ht hp h
    simp only [chainBinary] at h
    obtain ⟨⟨n1, g1⟩, h1, h⟩ := bind_ok h
    have htb : Trees g0.view [b] := fun x hx => ht x (by simp at hx; simp [hx])
    have hpd := pairDisj_append (l := ins) (l' := b :: bs) hp
    have i1 : Inv g0 g ins [acc] := by
      simpa using inv_step (inv_nil g0) hb (trees_append.mp ht).1 (fun _ h => absurd h List.not_mem_nil)
    have i2 := inv_step i1 (built_input (trees_ext i1.ext htb)) htb
      (fun a ha c hc => hpd.2.2 a ha c (by simp at hc; simp [hc]))
    have hb1 : Built g0 g1 (ins ++ [b]) n1 := built_of_inv i2 (opBinary_built i2.trees i2.disj h1)
    have := ih g0 g1 g' (ins ++ [b]) n1 n hb1 (by simpa using ht) (by simpa using hp) h
    simpa using this

theorem opNary_built {g g' : SGraph T} {D : Nat} {f : List T → T} {chainable : Bool}
    {idx binIdx : Nat} {bin : T → T → T} {args : List Addr} {n : Addr}
    (ht : Trees g.view args) (hp : PairDisj g.view args)
    (h : opNary g D f chainable idx bin binIdx args = .ok (n, g')) : Built g g' args n := by
  unfold opNary at h
  obtain ⟨b, _, h⟩ := bind_ok h
  rcases ite_bool_ok h with ⟨_, h⟩ | ⟨_, h⟩
  · obtain ⟨v, _, h⟩ := bind_ok h
    exact built_val _ h
  · rcases ite_bool_ok h with ⟨_, h⟩ | ⟨_, h⟩
    · cases args with
      | nil => simp [throw, throwThe, MonadExceptOf.throw] at h
      | cons a as =>
        have hta : Trees g.view [a] := fun x hx => ht x (by simp at hx; simp [hx])
        exact chainBinary_built as g g g' [a] a n (built_input hta) ht hp h
    · exact built_kids ht hp h

/-! ## Success -/

/-- The root object of a node operand holds a value when it is a constant
leaf (`n.val` is read by the constant-folding paths,
`src/OperatorEnumConstruction.jl:158,178,188,201,252`). -/
def ConstVal (g : SGraph T) (a : Addr) : Prop :=
  ∀ c, g.cells a = some c → c.degree = 0 → c.constant = true → c.val.isSome

theorem cell_of_closed {g : SGraph T} {a : Addr} (h : Closed g.view a) : ∃ c, g.cells a = some c := by
  have := h a (reach_refl _ a)
  rw [view_cells] at this
  cases hc : g.cells a with
  | none => rw [hc] at this; simp at this
  | some c => exact ⟨c, rfl⟩

theorem isConstNode_ok {g : SGraph T} {a : Addr} {c : SCell T} (h : g.cells a = some c) :
    isConstNode g a = .ok (c.degree == 0 && c.constant) := by
  simp only [isConstNode, Heap.read, h, bind, Except.bind, pure, Except.pure]

theorem constVal_val {g : SGraph T} {a : Addr} {c : SCell T} (h : g.cells a = some c)
    (hcv : ConstVal g a) (hb : (c.degree == 0 && c.constant) = true) : ∃ v, valNode g a = .ok v := by
  have hb' : c.degree = 0 ∧ c.constant = true := by simpa using hb
  obtain ⟨v, hv⟩ := Option.isSome_iff_exists.mp (hcv c h hb'.1 hb'.2)
  exact ⟨v, by simp only [valNode, Heap.read, h, hv, bind, Except.bind, pure, Except.pure]⟩

/-- An operand object that exists and satisfies `ConstVal`. -/
def Live (g : SGraph T) (a : Addr) : Prop := (∃ c, g.cells a = some c) ∧ ConstVal g a

theorem live_ext {g g' : SGraph T} {a : Addr} (he : Ext g g') (h : Live g a) : Live g' a := by
  obtain ⟨⟨c, hc⟩, hcv⟩ := h
  have hlt : a < g.next := Nat.lt_of_not_le fun hle => by rw [g.fresh a hle] at hc; cases hc
  have heq := he.2 a hlt
  exact ⟨⟨c, heq.trans hc⟩, fun c' hc' => hcv c' (by rw [← heq]; exact hc')⟩

theorem ctor_ext {g g' : SGraph T} {D : Nat} {hasD : Bool} {kw : Kw T} {n : Addr}
    (h : ctor g D hasD kw = .ok (n, g')) : Ext g g' ∧ ∃ c, g'.cells n = some c := by
  obtain ⟨hn, hnext, hoff, c, hc, _⟩ := ctor_ok h
  exact ⟨⟨by omega, fun x hx => hoff x (Nat.ne_of_lt hx)⟩, c, by rw [hn]; exact hc⟩

theorem ctor_val_live (g : SGraph T) (D : Nat) (v : T) :
    ∃ n g', ctor g D false { val := some v } = .ok (n, g') ∧ Ext g g' ∧ Live g' n := by
  have h : ctor g D false { val := some v } =
      .ok (g.next, (g.alloc { (blankCell : SCell T) with constant := true, val := some v }).2) := rfl
  refine ⟨_, _, h, (ctor_ext h).1, (ctor_ext h).2, fun c hc _ _ => ?_⟩
  have : c = { (blankCell : SCell T) with constant := true, val := some v } := by
    simp [Heap.alloc] at hc; exact hc.symm
  rw [this]; rfl

theorem ctor_op_live (g : SGraph T) (D o : Nat) (cs : List Addr) (ho : o ≤ 255)
    (hlen : cs.length ≤ D) (hne : cs ≠ []) :
    ∃ n g', ctor g D false { op := some o, children := some cs } = .ok (n, g') ∧ Ext g g' ∧
      Live g' n := by
  obtain ⟨g', h, -, -, c, hc, hdeg, -⟩ := (ctor_nodes_holds T g D false).2.2.1 o cs ho hlen
  refine ⟨_, _, h, (ctor_ext h).1, (ctor_ext h).2, fun c' hc' hd _ => ?_⟩
  rw [hc] at hc'; cases hc'
  rw [hdeg] at hd
  cases cs with
  | nil => exact absurd rfl hne
  | cons _ _ => simp at hd

theorem opUnary_ok {g : SGraph T} {D : Nat} {f : T → T} {idx l : Addr} (hidx : idx ≤ 255)
    (hD : 1 ≤ D) (hl : Live g l) : ∃ n g', opUnary g D f idx l = .ok (n, g') := by
  obtain ⟨⟨c, hc⟩, hcv⟩ := hl
  cases hb : (c.degree == 0 && c.constant)
  · obtain ⟨n, g', h, -⟩ := ctor_op_live g D idx [l] hidx hD (by simp)
    exact ⟨n, g', by
      simp only [opUnary, isConstNode_ok hc, hb, bind, Except.bind, Bool.false_eq_true,
        ↓reduceIte, h]⟩
  · obtain ⟨v, hv⟩ := constVal_val hc hcv hb
    obtain ⟨n, g', h, -⟩ := ctor_val_live g D (f v)
    exact ⟨n, g', by simp only [opUnary, isConstNode_ok hc, hb, bind, Except.bind, ↓reduceIte, hv, h]⟩

theorem opBinary_live {g : SGraph T} {D : Nat} {f : T → T → T} {idx l r : Addr}
    (hidx : idx ≤ 255) (hD : 2 ≤ D) (hl : Live g l) (hr : Live g r) :
    ∃ n g', opBinary g D f idx l r = .ok (n, g') ∧ Ext g g' ∧ Live g' n := by
  obtain ⟨⟨cl, hcl⟩, hvl⟩ := hl
  obtain ⟨⟨cr, hcr⟩, hvr⟩ := hr
  obtain ⟨n, g', h, hrest⟩ := ctor_op_live g D idx [l, r] hidx hD (by simp)
  cases hbl : (cl.degree == 0 && cl.constant)
  · exact ⟨n, g', by
      simp only [opBinary, isConstNode_ok hcl, hbl, bind, Except.bind, Bool.false_eq_true,
        ↓reduceIte, h], hrest⟩
  · cases hbr : (cr.degree == 0 && cr.constant)
    · exact ⟨n, g', by
        simp only [opBinary, isConstNode_ok hcl, isConstNode_ok hcr, hbl, hbr, bind, Except.bind,
          Bool.false_eq_true, ↓reduceIte, h], hrest⟩
    · obtain ⟨v, hv⟩ := constVal_val hcl hvl hbl
      obtain ⟨w, hw⟩ := constVal_val hcr hvr hbr
      obtain ⟨n, g', h, hrest⟩ := ctor_val_live g D (f v w)
      exact ⟨n, g', by
        simp only [opBinary, isConstNode_ok hcl, isConstNode_ok hcr, hbl, hbr, bind, Except.bind,
          ↓reduceIte, hv, hw, h], hrest⟩

theorem opNodeScalar_ok {g : SGraph T} {D : Nat} {f : T → T → T} {idx l : Addr} {x : T}
    (hidx : idx ≤ 255) (hD : 2 ≤ D) (hl : Live g l) :
    ∃ n g', opNodeScalar g D f idx l x = .ok (n, g') := by
  obtain ⟨⟨c, hc⟩, hcv⟩ := hl
  cases hb : (c.degree == 0 && c.constant)
  · obtain ⟨k, g1, hk, -⟩ := ctor_val_live g D x
    obtain ⟨n, g', h, -⟩ := ctor_op_live g1 D idx [l, k] hidx hD (by simp)
    exact ⟨n, g', by
      simp only [opNodeScalar, isConstNode_ok hc, hb, bind, Except.bind, Bool.false_eq_true,
        ↓reduceIte, hk, h]⟩
  · obtain ⟨v, hv⟩ := constVal_val hc hcv hb
    obtain ⟨n, g', h, -⟩ := ctor_val_live g D (f v x)
    exact ⟨n, g', by
      simp only [opNodeScalar, isConstNode_ok hc, hb, bind, Except.bind, ↓reduceIte, hv, h]⟩

theorem opScalarNode_ok {g : SGraph T} {D : Nat} {f : T → T → T} {idx r : Addr} {x : T}
    (hidx : idx ≤ 255) (hD : 2 ≤ D) (hr : Live g r) :
    ∃ n g', opScalarNode g D f idx x r = .ok (n, g') := by
  obtain ⟨⟨c, hc⟩, hcv⟩ := hr
  cases hb : (c.degree == 0 && c.constant)
  · obtain ⟨k, g1, hk, -⟩ := ctor_val_live g D x
    obtain ⟨n, g', h, -⟩ := ctor_op_live g1 D idx [k, r] hidx hD (by simp)
    exact ⟨n, g', by
      simp only [opScalarNode, isConstNode_ok hc, hb, bind, Except.bind, Bool.false_eq_true,
        ↓reduceIte, hk, h]⟩
  · obtain ⟨v, hv⟩ := constVal_val hc hcv hb
    obtain ⟨n, g', h, -⟩ := ctor_val_live g D (f x v)
    exact ⟨n, g', by
      simp only [opScalarNode, isConstNode_ok hc, hb, bind, Except.bind, ↓reduceIte, hv, h]⟩

/-- Every step of the chained fallback gets live operands: the accumulator is
an input or a fresh result (a branch, or a folded leaf holding its value). -/
theorem chainBinary_ok {D : Nat} {f : T → T → T} {idx : Nat} (hidx : idx ≤ 255) (hD : 2 ≤ D) :
    ∀ (bs : List Addr) (g : SGraph T) (acc : Addr), Live g acc → (∀ b ∈ bs, Live g b) →
      ∃ n g', chainBinary D f idx acc bs g = .ok (n, g') := by
  intro bs
  induction bs with
  | nil => intro g acc _ _; exact ⟨acc, g, rfl⟩
  | cons b bs ih =>
    intro g acc hacc hbs
    obtain ⟨n1, g1, h1, he, hl1⟩ := opBinary_live (f := f) hidx hD hacc (hbs b (by simp))
    obtain ⟨n, g', h⟩ := ih g1 n1 hl1 (fun b' hb' => live_ext he (hbs b' (by simp [hb'])))
    exact ⟨n, g', by simp only [chainBinary, h1, bind, Except.bind, h]⟩

theorem allM_isConst {g : SGraph T} :
    ∀ (args : List Addr), (∀ a ∈ args, ∃ c, g.cells a = some c) →
      ∃ b, args.allM (isConstNode g) = .ok b ∧
        (b = true → ∀ a ∈ args, ∃ c, g.cells a = some c ∧ (c.degree == 0 && c.constant) = true) ∧
        (b = false → args ≠ [])
  | [], _ => ⟨true, rfl, fun _ a ha => absurd ha List.not_mem_nil, fun h => by cases h⟩
  | a :: as, h => by
    obtain ⟨c, hc⟩ := h a (by simp)
    obtain ⟨b, hb, h1, -⟩ := allM_isConst as (fun x hx => h x (by simp [hx]))
    cases hk : (c.degree == 0 && c.constant)
    · refine ⟨false, ?_, fun h => (by cases h), fun _ => by simp⟩
      simp only [List.allM, isConstNode_ok hc, hk, bind, Except.bind, pure, Except.pure]
    · refine ⟨b, ?_, fun hbt x hx => ?_, fun _ => by simp⟩
      · simp only [List.allM, isConstNode_ok hc, hk, bind, Except.bind, hb]
      · rcases List.mem_cons.mp hx with rfl | hx
        · exact ⟨c, hc, hk⟩
        · exact h1 hbt x hx

theorem mapM_valNode {g : SGraph T} :
    ∀ (args : List Addr), (∀ a ∈ args, ∃ v, valNode g a = .ok v) →
      ∃ vs, args.mapM (valNode g) = .ok vs
  | [], _ => ⟨[], rfl⟩
  | a :: as, h => by
    obtain ⟨v, hv⟩ := h a (by simp)
    obtain ⟨vs, hvs⟩ := mapM_valNode as (fun x hx => h x (by simp [hx]))
    exact ⟨v :: vs, by simp [List.mapM_cons, hv, hvs, bind, Except.bind, pure, Except.pure]⟩

theorem opNary_ok {g : SGraph T} {D : Nat} {f : List T → T} {chainable : Bool}
    {idx binIdx : Nat} {bin : T → T → T} {args : List Addr} (hidx : idx ≤ 255)
    (hch : chainable = true ∧ idx = 0 → 2 ≤ D ∧ binIdx ≤ 255)
    (hlen : ¬ (chainable = true ∧ idx = 0) → args.length ≤ D) (hl : ∀ a ∈ args, Live g a) :
    ∃ n g', opNary g D f chainable idx bin binIdx args = .ok (n, g') := by
  obtain ⟨b, hb, hall, hne⟩ := allM_isConst args (fun a ha => (hl a ha).1)
  cases b
  · have hne := hne rfl
    by_cases hc : chainable = true ∧ idx = 0
    · obtain ⟨hD, hbin⟩ := hch hc
      obtain ⟨rfl, rfl⟩ := hc
      cases args with
      | nil => exact absurd rfl hne
      | cons a as =>
        obtain ⟨n, g', h⟩ := chainBinary_ok (f := bin) hbin hD as g a (hl a (by simp))
          (fun x hx => hl x (by simp [hx]))
        exact ⟨n, g', by
          simp only [opNary, hb, bind, Except.bind, Bool.false_eq_true, ↓reduceIte, Bool.true_and,
            beq_self_eq_true, h]⟩
    · obtain ⟨n, g', h, -⟩ := ctor_op_live g D idx args hidx (hlen hc) hne
      have hcb : (chainable && idx == 0) = false := by
        cases chainable <;> simp_all
      exact ⟨n, g', by
        simp only [opNary, hb, bind, Except.bind, Bool.false_eq_true, ↓reduceIte, hcb, h]⟩
  · obtain ⟨vs, hvs⟩ := mapM_valNode args (fun a ha =>
      let ⟨_, hc, hk⟩ := hall rfl a ha; constVal_val hc (hl a ha).2 hk)
    obtain ⟨n, g', h, -⟩ := ctor_val_live g D (f vs)
    exact ⟨n, g', by simp only [opNary, hb, bind, Except.bind, ↓reduceIte, hvs, h]⟩

/-! ## Properties -/

/-- The node is a constant leaf (`n.degree == 0 && n.constant`,
`src/OperatorEnumConstruction.jl:177,251`): a constant-folding call keeps no
such operand. -/
def IsConstLeaf (g : SGraph T) (a : Addr) : Prop :=
  ∃ c, g.cells a = some c ∧ c.degree = 0 ∧ c.constant = true

theorem isConstNode_false_not {g : SGraph T} {a : Addr} (h : isConstNode g a = .ok false) :
    ¬ IsConstLeaf g a := by
  intro ⟨c, hc, hd, hk⟩
  rw [isConstNode_ok hc] at h
  simp [hd, hk] at h

theorem allM_false_not : ∀ {g : SGraph T} (args : List Addr),
    args.allM (isConstNode g) = .ok false → ¬ ∀ a ∈ args, IsConstLeaf g a
  | _, [], h => by simp [List.allM, pure, Except.pure] at h
  | g, a :: as, h => by
    intro hall
    simp only [List.allM, bind, Except.bind] at h
    cases hp : isConstNode g a with
    | error e => rw [hp] at h; cases h
    | ok b =>
      rw [hp] at h
      cases b with
      | false => exact isConstNode_false_not hp (hall a (by simp))
      | true =>
        exact allM_false_not as h (fun x hx => hall x (by simp [hx]))

/-- Disjointness is needed only for operands the call keeps. -/
theorem opBinary_built_keep {g g' : SGraph T} {D : Nat} {f : T → T → T} {idx l r n : Addr}
    (ht : Trees g.view [l, r])
    (hp : ¬ (IsConstLeaf g l ∧ IsConstLeaf g r) → PairDisj g.view [l, r])
    (h : opBinary g D f idx l r = .ok (n, g')) : Built g g' [l, r] n := by
  unfold opBinary at h
  obtain ⟨b, hb, h⟩ := bind_ok h
  rcases ite_bool_ok h with ⟨_, h⟩ | ⟨hbf, h⟩
  · obtain ⟨b', hb', h⟩ := bind_ok h
    rcases ite_bool_ok h with ⟨_, h⟩ | ⟨hbf', h⟩
    · obtain ⟨v, _, h⟩ := bind_ok h
      obtain ⟨w, _, h⟩ := bind_ok h
      exact built_val _ h
    · subst hbf'
      exact built_kids ht (hp (fun hc => isConstNode_false_not hb' hc.2)) h
  · subst hbf
    exact built_kids ht (hp (fun hc => isConstNode_false_not hb hc.1)) h

theorem opNary_built_keep {g g' : SGraph T} {D : Nat} {f : List T → T} {chainable : Bool}
    {idx binIdx : Nat} {bin : T → T → T} {args : List Addr} {n : Addr}
    (ht : Trees g.view args) (hp : ¬ (∀ a ∈ args, IsConstLeaf g a) → PairDisj g.view args)
    (h : opNary g D f chainable idx bin binIdx args = .ok (n, g')) : Built g g' args n := by
  unfold opNary at h
  obtain ⟨b, hb, h⟩ := bind_ok h
  rcases ite_bool_ok h with ⟨_, h⟩ | ⟨hbf, h⟩
  · obtain ⟨v, _, h⟩ := bind_ok h
    exact built_val _ h
  · subst hbf
    exact opNary_built (f := f) ht (hp (allM_false_not args hb)) (by
      unfold opNary; rw [hb]; exact h)

/-- Every generated `Node` operator method succeeds and returns an alias-free
tree when its node operands are alias-free trees that are distinct and share no
object: unary, binary node-node, node-scalar, scalar-node, and n-ary
(including the chained fallback and all-constant folding). The result consists
of new objects and the operands' objects, and no existing object changes.
Inputs: the operator index fits `UInt8`, the node fits the maximum degree, and
every constant-leaf operand holds a value. -/
def operator_methods_noalias : Prop :=
  ∀ (T : Type) (g : SGraph T) (D idx : Nat), idx ≤ 255 →
    (∀ (f : T → T) (l : Addr), 1 ≤ D → Trees g.view [l] → ConstVal g l →
      ∃ n g', opUnary g D f idx l = .ok (n, g') ∧ Built g g' [l] n) ∧
    (∀ (f : T → T → T) (l r : Addr), 2 ≤ D → Trees g.view [l, r] →
      (¬ (IsConstLeaf g l ∧ IsConstLeaf g r) → PairDisj g.view [l, r]) →
      ConstVal g l → ConstVal g r →
      ∃ n g', opBinary g D f idx l r = .ok (n, g') ∧ Built g g' [l, r] n) ∧
    (∀ (f : T → T → T) (l : Addr) (x : T), 2 ≤ D → Trees g.view [l] → ConstVal g l →
      ∃ n g', opNodeScalar g D f idx l x = .ok (n, g') ∧ Built g g' [l] n) ∧
    (∀ (f : T → T → T) (x : T) (r : Addr), 2 ≤ D → Trees g.view [r] → ConstVal g r →
      ∃ n g', opScalarNode g D f idx x r = .ok (n, g') ∧ Built g g' [r] n) ∧
    (∀ (f : List T → T) (chainable : Bool) (bin : T → T → T) (binIdx : Nat) (args : List Addr),
      (chainable = true ∧ idx = 0 → 2 ≤ D ∧ binIdx ≤ 255) →
      (¬ (chainable = true ∧ idx = 0) → args.length ≤ D) →
      Trees g.view args → (¬ (∀ a ∈ args, IsConstLeaf g a) → PairDisj g.view args) →
      (∀ a ∈ args, ConstVal g a) →
      ∃ n g', opNary g D f chainable idx bin binIdx args = .ok (n, g') ∧ Built g g' args n)

theorem live_of_trees {g : SGraph T} {l : List Addr} (ht : Trees g.view l)
    (hcv : ∀ a ∈ l, ConstVal g a) : ∀ a ∈ l, Live g a :=
  fun a ha => ⟨cell_of_closed (ht a ha).2, hcv a ha⟩

theorem operator_methods_noalias_holds : operator_methods_noalias := by
  intro T g D idx hidx
  refine ⟨fun f l hD ht hcv => ?_, fun f l r hD ht hp hcl hcr => ?_, fun f l x hD ht hcv => ?_,
    fun f x r hD ht hcv => ?_, fun f chainable bin binIdx args hch hlen ht hp hcv => ?_⟩
  · obtain ⟨n, g', h⟩ := opUnary_ok (f := f) hidx hD (live_of_trees ht (by simpa using hcv) l (by simp))
    exact ⟨n, g', h, opUnary_built ht h⟩
  · have hlv := live_of_trees ht (by simp [hcl, hcr])
    obtain ⟨n, g', h, -⟩ := opBinary_live (f := f) hidx hD (hlv l (by simp)) (hlv r (by simp))
    exact ⟨n, g', h, opBinary_built_keep ht hp h⟩
  · obtain ⟨n, g', h⟩ := opNodeScalar_ok (f := f) (x := x) hidx hD
      (live_of_trees ht (by simpa using hcv) l (by simp))
    exact ⟨n, g', h, opNodeScalar_built ht h⟩
  · obtain ⟨n, g', h⟩ := opScalarNode_ok (f := f) (x := x) hidx hD
      (live_of_trees ht (by simpa using hcv) r (by simp))
    exact ⟨n, g', h, opScalarNode_built ht h⟩
  · obtain ⟨n, g', h⟩ := opNary_ok (f := f) (bin := bin) hidx hch hlen (live_of_trees ht hcv)
    exact ⟨n, g', h, opNary_built_keep ht hp h⟩

/-- Example heap: feature leaves `x1` at address 0 and `x2` at address 1. -/
def twoLeaves : SGraph Nat := (okOr (ctor oneLeaf 2 false ({ feature := some 2 } : Kw Nat)) (0, oneLeaf)).2

theorem oneLeaf_constVal : ConstVal (oneLeaf : SGraph Nat) 0 := by
  intro c hc _ hk
  rw [oneLeaf_leaf] at hc; cases hc; cases hk

example : Trees (oneLeaf : SGraph Nat).view [0] ∧ ConstVal (oneLeaf : SGraph Nat) 0 :=
  ⟨fun b hb => by simp at hb; subst hb; exact oneLeaf_tree, oneLeaf_constVal⟩

example : Trees twoLeaves.view [0, 1] ∧ PairDisj twoLeaves.view [0, 1] ∧
    ConstVal twoLeaves 0 ∧ ConstVal twoLeaves 1 := by
  have h : ctor oneLeaf 2 false ({ feature := some 2 } : Kw Nat) = .ok (1, twoLeaves) := rfl
  have ht0 : Trees (oneLeaf : SGraph Nat).view [0] := fun b hb => by
    simp at hb; subst hb; exact oneLeaf_tree
  have hb := (ctor_built (kw := { feature := some 2 }) (trees_nil _) (pairDisj_nil _) h).2
  have i1 := inv_step (inv_nil oneLeaf) (built_input ht0) ht0 (fun _ h => absurd h List.not_mem_nil)
  have i2 := inv_step i1 hb (trees_nil _) (fun _ _ _ h => absurd h List.not_mem_nil)
  have h0 : twoLeaves.cells 0 = some { (blankCell : SCell Nat) with feature := 1 } := rfl
  have h1 : twoLeaves.cells 1 = some { (blankCell : SCell Nat) with feature := 2 } := rfl
  refine ⟨by simpa using i2.trees, by simpa using i2.disj, fun c hc _ hk => ?_, fun c hc _ hk => ?_⟩
  · rw [h0] at hc; cases hc; cases hk
  · rw [h1] at hc; cases hc; cases hk

/-- Example heap: one constant leaf `3` at address 0. -/
def constLeafHeap : SGraph Nat :=
  (Heap.empty.alloc { (blankCell : SCell Nat) with constant := true, val := some 3 }).2

/-- The binary hypotheses hold for `c * c` with one constant leaf `c` used
twice: no disjointness is needed because the call folds. -/
example : Trees constLeafHeap.view [0, 0] ∧ (IsConstLeaf constLeafHeap 0 ∧ IsConstLeaf constLeafHeap 0) ∧
    ConstVal constLeafHeap 0 := by
  have hc : constLeafHeap.cells 0 = some { (blankCell : SCell Nat) with constant := true, val := some 3 } := rfl
  have hv : constLeafHeap.view.cells 0 =
      some (SCell.toCell { (blankCell : SCell Nat) with constant := true, val := some 3 }) := rfl
  have hleaf : ∀ c, constLeafHeap.view.cells 0 = some c → c.children = [] := by
    intro c h; rw [hv] at h; cases h; rfl
  have htree : NoAlias constLeafHeap.view 0 ∧ Closed constLeafHeap.view 0 := by
    refine ⟨noAlias_leaf hleaf, fun z hz => ?_⟩
    rcases reach_inv hz with rfl | ⟨c, b, hc', hb, _⟩
    · rw [hv]; rfl
    · rw [hleaf c hc'] at hb; exact absurd hb List.not_mem_nil
  have hk : IsConstLeaf constLeafHeap 0 := ⟨_, hc, rfl, rfl⟩
  refine ⟨fun b hb => ?_, ⟨hk, hk⟩, fun c h _ _ => ?_⟩
  · simp at hb; subst hb; exact htree
  · rw [hc] at h; cases h; rfl

/-- Exposure (Julia ownership, not a copy): a generated binary method applied
to a non-constant operand succeeds and returns a new node whose children are
the operand objects themselves (`src/OperatorEnumConstruction.jl:181`). -/
def operator_stores_operands : Prop :=
  ∀ (T : Type) (g : SGraph T) (D idx : Nat) (f : T → T → T) (l r : Addr) (c : SCell T),
    idx ≤ 255 → 2 ≤ D → g.cells l = some c → (c.degree == 0 && c.constant) = false →
    ∃ n g', opBinary g D f idx l r = .ok (n, g') ∧ kids g'.view n = some [l, r]

theorem operator_stores_operands_holds : operator_stores_operands := by
  intro T g D idx f l r c hidx hD hc hcf
  obtain ⟨n, g', h, -⟩ := ctor_op_live g D idx [l, r] hidx hD (by simp)
  refine ⟨n, g', by
    simp only [opBinary, isConstNode_ok hc, hcf, bind, Except.bind, Bool.false_eq_true,
      ↓reduceIte, h], ?_⟩
  obtain ⟨hn, -, -, c', hc', hact⟩ := ctor_ok h
  rcases hact with ⟨hop, _⟩ | hkid
  · cases hop
  · rw [view_kids, hn, hc']; simp [hkid, ctorKids]

example : (oneLeaf : SGraph Nat).cells 0 = some { (blankCell : SCell Nat) with feature := 1 } ∧
    (({ (blankCell : SCell Nat) with feature := 1 }).degree == 0 &&
      ({ (blankCell : SCell Nat) with feature := 1 }).constant) = false := ⟨oneLeaf_leaf, rfl⟩

end DynExpr.NoAlias
