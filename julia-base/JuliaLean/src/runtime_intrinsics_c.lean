def integerDivide {w : Nat} (signed remainder checked : Bool) (a b : BitVec w) : IntrinsicResult (BitVec w) := do
  let checked := checked || ![8, 16, 32, 64].contains w
  let a := if signed then a.toInt else (a.toNat : Int)
  let b := if signed then b.toInt else (b.toNat : Int)
  if b == 0 then
    if checked then throw .divideError else throw (.unmodelled "LLVM poison division by zero")
  if signed && a == -(2 ^ (w - 1) : Nat) && b == -1 then
    if remainder then return BitVec.ofNat w 0
    if checked then throw .divideError else throw (.unmodelled "LLVM poison signed division overflow")
  return BitVec.ofInt w (if remainder then a.tmod b else a.tdiv b)

