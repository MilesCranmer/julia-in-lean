inductive IntrinsicError where
  | divideError
  | errorException (message : String)
  | concurrencyViolationError (message : String)
  | unmodelled (message : String)
  deriving Repr, Inhabited

abbrev IntrinsicResult := Except IntrinsicError
abbrev IntrinsicM (m : Type → Type) := ExceptT IntrinsicError m
abbrev Word := BitVec 64

def fromJInt {t : IntTy} (x : JInt t) : BitVec t.bits := BitVec.ofInt t.bits x.val
def toJInt (t : IntTy) (x : BitVec t.bits) : JInt t :=
  JInt.wrap t (if t.signed then x.toInt else (x.toNat : Int))

def bfloat : Fmt := ⟨8, 7⟩

def liftIntrinsic {m : Type → Type} [Monad m] (result : IntrinsicResult α) : IntrinsicM m α :=
  match result with | .ok x => pure x | .error e => throw e

