def jlAtomicPointerreplace {m : Type → Type} [Monad m]
    (cas : Word → α → α → IntrinsicM m (α × Bool)) (egal : α → α → Bool)
    (p : Word) (expected value : α) (size : Nat) (successOrder failureOrder : String)
    (fuel : Nat) (boxed : Bool := false) : IntrinsicM m (α × Bool) := do
  let success ← liftIntrinsic (memoryOrder successOrder true true)
  let failure ← liftIntrinsic (memoryOrder failureOrder true false)
  if failure > success then throw (.concurrencyViolationError "invalid atomic ordering")
  liftIntrinsic (atomicSize size boxed)
  let rec loop : Nat → α → IntrinsicM m (α × Bool)
    | 0, _ => throw (.unmodelled "atomic replace recursion exhausted")
    | n + 1, exp => do
      let (actual, ok) ← cas p exp value
      if ok || !boxed || !egal actual expected then return (actual, ok)
      loop n actual
  loop fuel expected

