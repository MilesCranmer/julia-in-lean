def jlSubPtr (p offset : Word) : Word := p - offset

def memoryOrder (order : String) (loading storing : Bool) : IntrinsicResult Nat :=
  if order == "not_atomic" then .ok 0
  else if order == "unordered" && loading != storing then .ok 1
  else if order == "monotonic" && (loading || storing) then .ok 2
  else if order == "acquire" && loading then .ok 3
  else if order == "release" && storing then .ok 4
  else if order == "acquire_release" && loading && storing then .ok 5
  else if order == "sequentially_consistent" then .ok 6
  else .error (.concurrencyViolationError "invalid atomic ordering")

def atomicSize (size : Nat) (boxed : Bool) : IntrinsicResult Unit :=
  if !boxed && (Nat.land size (size - 1) != 0 || size > 16) then
    .error (.errorException "invalid pointer for atomic operation")
  else .ok ()

def pointerIndex (p i : Word) (stride : Nat) : Word :=
  p + BitVec.ofInt 64 ((i.toInt - 1) * stride)

