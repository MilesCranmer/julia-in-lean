def jlAtomicPointermodifyInvoke {m : Type → Type} [Monad m]
    (load : Word → IntrinsicM m α) (cas : Word → α → α → IntrinsicM m (α × Bool))
    (op : α → β → IntrinsicM m α) (p : Word) (rhs : β) (size : Nat) (order : String)
    (fuel : Nat) (boxed : Bool := false) : IntrinsicM m (α × α) := do
  let _ ← liftIntrinsic (memoryOrder order true true)
  liftIntrinsic (atomicSize size boxed)
  let rec loop : Nat → α → IntrinsicM m (α × α)
    | 0, _ => throw (.unmodelled "atomic modify recursion exhausted")
    | n + 1, old => do
      let value ← op old rhs
      let (actual, success) ← cas p old value
      if success then return (old, value)
      loop n actual
  loop fuel (← load p)

