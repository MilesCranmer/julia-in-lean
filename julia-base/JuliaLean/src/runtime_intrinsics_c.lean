def checkedInteger {w : Nat} (signed : Bool) (op : Int → Int → Int) (a b : BitVec w) : BitVec w × Bool :=
  let a := if signed then a.toInt else (a.toNat : Int)
  let b := if signed then b.toInt else (b.toNat : Int)
  let r := op a b
  let lo : Int := if signed then -(2 ^ (w - 1) : Nat) else 0
  let hi : Int := if signed then (2 ^ (w - 1) : Nat) else (2 ^ w : Nat)
  (BitVec.ofInt w r, r < lo || r ≥ hi)

