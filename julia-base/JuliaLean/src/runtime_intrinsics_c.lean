def quietFloat {f : Fmt} (x : Fl f) : Fl f :=
  Fl.ofBits (Nat.lor x.toBits (2 ^ (f.sb - 1)))

def invalidFloat (f : Fmt) : Fl f :=
  Fl.ofBits (2 ^ (f.eb + f.sb) + f.emax * 2 ^ f.sb + 2 ^ (f.sb - 1))

def floatAdd {f : Fmt} (x y : Fl f) : Fl f :=
  if x.isnan then quietFloat x else if y.isnan then quietFloat y
  else if x.isinf then (if y.isinf && x.signbit != y.signbit then invalidFloat f else x)
  else if y.isinf then y
  else let a := x.toRat; let b := y.toRat
       Fl.roundRat (a.1 * (b.2 : Int) + b.1 * (a.2 : Int)) (a.2 * b.2) (x.signbit && y.signbit)

def floatSub {f : Fmt} (x y : Fl f) : Fl f :=
  if x.isnan then quietFloat x else if y.isnan then quietFloat y else floatAdd x y.neg

def floatMul {f : Fmt} (x y : Fl f) : Fl f :=
  if x.isnan then quietFloat x else if y.isnan then quietFloat y
  else if (x.isinf && y.iszero) || (y.isinf && x.iszero) then invalidFloat f
  else if x.isinf || y.isinf then Fl.inf (x.signbit != y.signbit)
  else let a := x.toRat; let b := y.toRat
       Fl.roundRat (a.1 * b.1) (a.2 * b.2) (x.signbit != y.signbit)

def floatDiv {f : Fmt} (x y : Fl f) : Fl f :=
  let neg := x.signbit != y.signbit
  if x.isnan then quietFloat x else if y.isnan then quietFloat y
  else if (x.isinf && y.isinf) || (x.iszero && y.iszero) then invalidFloat f
  else if x.isinf then Fl.inf neg else if y.isinf then Fl.zero neg else if y.iszero then Fl.inf neg
  else let a := x.toRat; let b := y.toRat
       Fl.roundRat (if b.1 < 0 then -(a.1 * (b.2 : Int)) else a.1 * (b.2 : Int)) (a.2 * b.1.natAbs) neg

def floatFma {f : Fmt} (x y z : Fl f) : Fl f :=
  let neg := x.signbit != y.signbit
  if x.isnan then quietFloat x else if y.isnan then quietFloat y else if z.isnan then quietFloat z
  else if (x.isinf && y.iszero) || (y.isinf && x.iszero) then invalidFloat f
  else if x.isinf || y.isinf then
    if z.isinf && neg != z.signbit then invalidFloat f else Fl.inf neg
  else if z.isinf then z
  else let a := x.toRat; let b := y.toRat; let c := z.toRat
       Fl.roundRat (a.1 * b.1 * (c.2 : Int) + c.1 * ((a.2 * b.2 : Nat) : Int))
         (a.2 * b.2 * c.2) (neg && z.signbit)

def roundFloat {f : Fmt} (mode : Nat) (x : Fl f) : Fl f :=
  if x.isnan then quietFloat x else if !x.isfinite || x.iszero then x
  else
    let (n, d) := x.toRat
    let k := if mode == 0 then -((-n) / (d : Int))
      else if mode == 1 then n / (d : Int)
      else if mode == 2 then n.tdiv (d : Int)
      else let r := Fl.roundQuotient n.natAbs d
           if n < 0 then -(r : Int) else (r : Int)
    Fl.roundRat k 1 x.signbit

def sqrtFloorRatio (n d : Nat) : Nat → Nat → Nat → Nat
  | 0, lo, _ => lo
  | fuel + 1, lo, hi =>
    if hi ≤ lo + 1 then lo else
    let mid := (lo + hi) / 2
    if mid * mid * d ≤ n then sqrtFloorRatio n d fuel mid hi
    else sqrtFloorRatio n d fuel lo mid

def sqrtFloat {f : Fmt} (x : Fl f) : Fl f :=
  if x.isnan then quietFloat x else if x.iszero then x
  else if x.signbit then invalidFloat f else if x.isinf then x
  else
    let a := x.toRat
    let e := Fl.floorLog2Rat a.1.natAbs a.2
    let k := e / 2 - (f.sb : Int)
    let scaled := if 2 * k ≥ 0 then (a.1.natAbs, a.2 * 2 ^ (2 * k).toNat)
      else (a.1.natAbs * 2 ^ (-2 * k).toNat, a.2)
    let q := sqrtFloorRatio scaled.1 scaled.2 (f.sb + 2) 0 (2 ^ (f.sb + 1) + 1)
    let target := 4 * scaled.1
    let midpoint := (2 * q + 1) ^ 2 * scaled.2
    Fl.packRounded false (if target > midpoint || (target == midpoint && q % 2 == 1) then q + 1 else q) k

def finishFloat {f : Fmt} (value : Fl f) : Fl f :=
  if f == bfloat && value.isnan then Fl.nan else value

def unaryFloat {f : Fmt} (op : Fl f → Fl f) (x : Fl f) : Fl f :=
  finishFloat (op (if f == half && x.isnan then quietFloat x else x))

