    JL_TYPECHK(fence, symbol, syncscope_sym);
    enum jl_memory_order order = jl_get_atomic_order_checked((jl_sym_t*)order_sym, 1, 1);
    if ((jl_sym_t*)syncscope_sym == jl_singlethread_sym) {
        asm volatile ("" : : : "memory");
