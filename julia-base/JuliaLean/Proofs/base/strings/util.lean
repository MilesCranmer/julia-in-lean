theorem chopTooMany_refuted : ¬ ChopTooMany := by
  intro h
  let s : Raw := ⟨[0x61, 0x62], by decide⟩
  let head : Index := int ((2 : Int) ^ 63 - 1)
  have hchars : rawChars s = .ok [0x61000000, 0x62000000] := by
    dsimp [rawChars, s]
    decide +kernel
  obtain ⟨cs, hcs, hresult⟩ := h s head (int 0) (by decide) (by decide)
  have hcs' : cs = [0x61000000, 0x62000000] := by
    have heq := hchars
    rw [hcs] at heq
    injection heq
  have hlen : cs.length = 2 := by rw [hcs']; rfl
  have hlarge : Int.ofNat cs.length ≤ head.val + (int 0).val := by
    rw [hlen]
    dsimp [head]
    decide
  obtain ⟨out, hcall, _⟩ := hresult hlarge
  have hnoSuccess :
      (match chopCall s head (int 0) with | .ok _ => true | .error _ => false) = false := by
    dsimp [chopCall, s, head]
    decide +kernel
  have hsuccess :
      (match chopCall s head (int 0) with | .ok _ => true | .error _ => false) = true := by
    simp [hcall]
  rw [hnoSuccess] at hsuccess
  cases hsuccess

