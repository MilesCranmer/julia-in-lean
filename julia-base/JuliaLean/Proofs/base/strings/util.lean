      have hspec : Round6.occurrenceOf (some (.range xStarR2)) = some xStarR2 := by
        decide
      have hr : r = xStarR2 := (Option.some.inj (hspec.symm.trans hocc)).symm
      subst r
      have hkval : k.val = xStarR2.first.val := by rw [h2]; decide
      exact ⟨hkval, by decide, by decide⟩
    · by_cases h3 : k.val = 3
      · have hv : v = some (.range xStarR3) := by
          exact (show some (.range xStarR3) = v by
            simpa [xStarFindnext, h1, h2, h3] using hfind).symm
        subst v
        have hspec : Round6.occurrenceOf (some (.range xStarR3)) = some xStarR3 := by
          decide
        have hr : r = xStarR3 := (Option.some.inj (hspec.symm.trans hocc)).symm
        subst r
        have hkval : k.val = xStarR3.first.val := by rw [h3]; decide
        exact ⟨hkval, by decide, by decide⟩
      · by_cases h4 : k.val = 4
        · have hv : v = some (.range xStarR4) := by
            exact (show some (.range xStarR4) = v by
              simpa [xStarFindnext, h1, h2, h3, h4] using hfind).symm
          subst v
          have hspec : Round6.occurrenceOf (some (.range xStarR4)) = some xStarR4 := by
            decide
          have hr : r = xStarR4 := (Option.some.inj (hspec.symm.trans hocc)).symm
          subst r
          have hkval : k.val = xStarR4.first.val := by rw [h4]; decide
          exact ⟨hkval, by decide, by decide⟩
        · by_cases h5 : k.val = 5
          · have hv : v = some (.range xStarR5) := by
              exact (show some (.range xStarR5) = v by
                simpa [xStarFindnext, h1, h2, h3, h4, h5] using hfind).symm
            subst v
            have hspec : Round6.occurrenceOf (some (.range xStarR5)) = some xStarR5 := by
              decide
            have hr : r = xStarR5 := (Option.some.inj (hspec.symm.trans hocc)).symm
            subst r
            have hkval : k.val = xStarR5.first.val := by rw [h5]; decide
            exact ⟨hkval, by decide, by decide⟩
          · have hv : v = none := by
              exact (show none = v by
                simpa [xStarFindnext, h1, h2, h3, h4, h5] using hfind).symm
            subst v
            simp [Round6.occurrenceOf] at hocc

