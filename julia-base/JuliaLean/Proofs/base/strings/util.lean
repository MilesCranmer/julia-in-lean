  | nil =>
    have hp : p.1 = int 1 := suWalkHead prim s (int 1) p after (by simpa [hsplit] using law.walk)
    obtain ⟨out, hr, ho, hv⟩ := suEmptyRange prim errs s
    refine ⟨int 0, out, ?_, hr, ho, hv, by intros; rfl, ?_⟩
