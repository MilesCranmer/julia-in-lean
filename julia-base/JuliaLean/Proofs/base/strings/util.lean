/-- The user-defined ASCII string methods in `repro/stringutil-split-sentinel-overflow.jl`.
The string value is its nonnegative Int code-unit count; no storage is allocated. -/
def asciiSubstringOps : Sub.SubStringOps Index Unit Unit Unit where
  ncodeunits := id
  codeunitType := fun _ => ()
  length := fun _ i j => .ok (j - i + int 1)
  checkboundsRange := fun s i j =>
    if j.val < i.val ∨ (1 ≤ i.val ∧ j.val ≤ s.val) then .ok () else .error ()
  checkboundsViewRange := fun s i j =>
    if j.val < i.val ∨ (1 ≤ i.val ∧ j.val ≤ s.ncodeunits.val) then .ok () else .error ()
  isvalid := fun s i => .ok (decide (1 ≤ i.val ∧ i.val ≤ s.val))
  stringIndexError := fun _ _ => ()
  boundsError := fun _ _ _ => ()
  viewBoundsError := fun _ _ _ => ()
  nextind := fun _ i => .ok (i + int 1)
  firstindex := fun _ => int 1
  thisindParent := fun s i =>
    if 0 ≤ i.val ∧ i.val ≤ s.val then .ok i else .error ()
  isasciiCodeunits := fun _ => .ok true
  sizeof := id

/-- `iterateSplit` calls the user's index methods, and propagates its `@inbounds`
context into the installed SubString constructors (util.jl:799,806). -/
def asciiSplitOps : SplitStringOps Index (Sub.SubString Index) Unit where
  firstindex := fun _ => .ok (int 1)
  lastindex := fun s => .ok s
  ncodeunits := fun s => .ok s
  nextind := fun _ i => .ok (i + int 1)
  prevind := fun _ i => .ok (i - int 1)
  substringUnchecked := fun s i j => Sub.subStringInt asciiSubstringOps s i j false
  substringFrom := fun s i => Sub.subStringIntegerDefault asciiSubstringOps
    (fun i => .ok i) (fun s => .ok s) s i false
  substringChecked := fun s i j => Sub.subStringInt asciiSubstringOps s i j

inductive NoDelimiter where
  | mk

/-- The reproducer supplies `Base.findnext(::NoDelimiter, ::VirtualAscii, ::Integer) = nothing`. -/
def noDelimiterFindnext (_ : NoDelimiter) (_ _ : Index) :
    JuliaLean.base.strings.search.SearchM Unit (Option (Index × Index)) := pure none

/-- The documented `limit=1` contract also applies to custom splitter dispatch on virtual
ASCII strings of every nonnegative representable length. After the whole string is emitted,
the next call must return `nothing`. -/
def CustomLimitOne : Prop :=
  ∀ (ncu : Index) (keepempty : Bool) (iter : SplitIteratorModel Index NoDelimiter),
    0 ≤ ncu.val → (0 < ncu.val ∨ keepempty = true) →
    eachsplitGeneric (fun _ : Index => true) (fun i => Except.ok i) (fun _ => ())
      ncu NoDelimiter.mk (int 1) keepempty = .ok iter →
    ∃ piece next,
      (iterateSplit asciiSplitOps noDelimiterFindnext iter none).run =
        some (.ok (some (piece, next))) ∧
      piece.ncodeunits = ncu ∧
      (iterateSplit asciiSplitOps noDelimiterFindnext iter (some next)).run = some (.ok none)

private def maxLength : Index := int (2 ^ 63 - 1)
private def overflowState : SplitState := (int (- (2 ^ 63) + 1), int 1, int 1)
private def overflowIterator : SplitIteratorModel Index NoDelimiter :=
  ⟨maxLength, .mk, int 1, true⟩

private theorem firstStep :
    (iterateSplit asciiSplitOps noDelimiterFindnext overflowIterator none).run =
      some (.ok (some (⟨maxLength, int 0, maxLength⟩, overflowState))) := by
  change (iterateSplitLoop asciiSplitOps noDelimiterFindnext overflowIterator
    (int 1) (int 1) (int 0) none).run = _
  rw [iterateSplitLoop.eq_def]
  rfl

private theorem secondStep :
    (iterateSplit asciiSplitOps noDelimiterFindnext overflowIterator (some overflowState)).run =
      some (.ok (some (⟨maxLength, int (- (2 ^ 63)), int (-1)⟩,
        (int (- (2 ^ 63) + 1), int 1, int 2)))) := by
  change (iterateSplitLoop asciiSplitOps noDelimiterFindnext overflowIterator
    (int (- (2 ^ 63) + 1)) (int 1) (int 1) none).run = _
  rw [iterateSplitLoop.eq_def]
  rfl

theorem customLimitOne_refuted : ¬ CustomLimitOne := by
  intro h
  obtain ⟨piece, next, first, _, done⟩ := h maxLength true overflowIterator
    (by decide) (Or.inr rfl) (by rfl)
  rw [firstStep] at first
  cases first
  rw [secondStep] at done
  cases done

/-- Preserve the installed finite-string contract and include custom splitter dispatch
at every representable virtual ASCII length. -/
def SplitIteratorLimitOne : Prop := Round6.SplitIteratorLimitOne ∧ CustomLimitOne

theorem splitIteratorLimitOne_refuted : ¬ SplitIteratorLimitOne :=
  fun h => customLimitOne_refuted h.2

end JuliaLean.Proofs.base.strings.util.SentinelOverflow

