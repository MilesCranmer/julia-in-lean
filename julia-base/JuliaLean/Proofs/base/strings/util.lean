private theorem rawPrefixViewLaw (p : Prepared) (hv : viewValid p.view)
    (n : Nat) (hn : n ≤ (preparedBytes p).length) :
    ∃ v, Sub.rawSubstringView parentOps p.view JuliaLean.base.strings.substring.one
        (JuliaLean.base.strings.substring.int (Int.ofNat n)) = .ok v ∧
      viewValid v ∧ viewBytes v = (preparedBytes p).take n ∧
      v.string = p.view.string ∧ v.offset = p.view.offset := by
  have hlen := viewBytesLength p.view hv
  have hlenNonneg := hv.2.1
  have hnNat : n ≤ p.view.ncodeunits.val.toNat := by
    rw [← hlen]
    exact hn
  have hcountBound : Int.ofNat n ≤ p.view.ncodeunits.val := by
    have h := Int.ofNat_le.mpr hnNat
    rw [Int.toNat_of_nonneg hlenNonneg] at h
    exact h
  have hlengthSmall := viewLengthSmall p.view hv
  have hcount : (JuliaLean.base.strings.basic.int (Int.ofNat n)).val =
      Int.ofNat n := by
    change JuliaLean.wrapInt .i64 (Int.ofNat n) = Int.ofNat n
    apply JuliaLean.wrapInt_of_inRange
    constructor
    · simp [JuliaLean.IntTy.min, JuliaLean.IntTy.signed, JuliaLean.IntTy.bits] <;> omega
    · simp [JuliaLean.IntTy.max, JuliaLean.IntTy.signed, JuliaLean.IntTy.bits] <;> omega
  have hcountSub :
      (JuliaLean.base.strings.substring.int (Int.ofNat n)).val = Int.ofNat n := by
    simpa [JuliaLean.base.strings.substring.int] using hcount
  have hfirst : JuliaLean.base.strings.substring.one.val = 1 := by decide
  have hparentSmall :
      (Str.stringNcodeunits p.view.string).val < (2 : Int) ^ 62 := by
    rw [rawNcodeunitsVal]
    exact Int.ofNat_lt.mpr p.view.string.small
  have hoffSmall : p.view.offset.val < (2 : Int) ^ 62 := by
    have hlenNonneg := hv.2.1
    have hp := hv.2.2
    change p.view.offset.val + p.view.ncodeunits.val ≤
      (Str.stringNcodeunits p.view.string).val at hp
    omega
  have haddOff := chompAddVal JuliaLean.base.strings.substring.one p.view.offset
    (by rw [hfirst]; have ho := hv.1; omega)
    (by rw [hfirst]; omega)
  have hOffsetLower : -(2 ^ 63 : Int) ≤ p.view.offset.val := by
    have ho := hv.1
    omega
  have hOffsetUpper : p.view.offset.val < (2 : Int) ^ 63 := by
    have ho := hv.1
    omega
  have hsubOff := chompSubVal
    (JuliaLean.base.strings.substring.one + p.view.offset)
    JuliaLean.base.strings.substring.one
    (by rw [haddOff, hfirst]; have ho := hOffsetLower; omega)
    (by rw [haddOff, hfirst]; have ho := hOffsetUpper; omega)
  have hoffEq : JuliaLean.base.strings.substring.one + p.view.offset -
      JuliaLean.base.strings.substring.one = p.view.offset := by
    apply Subtype.ext
    calc
      (JuliaLean.base.strings.substring.one + p.view.offset -
        JuliaLean.base.strings.substring.one).val =
          (JuliaLean.base.strings.substring.one + p.view.offset).val -
            JuliaLean.base.strings.substring.one.val := hsubOff
      _ = JuliaLean.base.strings.substring.one.val + p.view.offset.val -
          JuliaLean.base.strings.substring.one.val := by rw [haddOff]
      _ = p.view.offset.val := by rw [hfirst]; omega
  have hsubNcu := chompSubVal p.view.ncodeunits JuliaLean.base.strings.substring.one
    (by rw [hfirst]; have hncu := hv.2.1; omega)
    (by rw [hfirst]; have hs := hlengthSmall; omega)
  have haddNcu := chompAddVal
    (p.view.ncodeunits - JuliaLean.base.strings.substring.one)
    JuliaLean.base.strings.substring.one
    (by rw [hsubNcu, hfirst]; omega)
    (by rw [hsubNcu, hfirst]; omega)
  have hEnd : (p.view.ncodeunits - JuliaLean.base.strings.substring.one +
      JuliaLean.base.strings.substring.one).val = p.view.ncodeunits.val := by
    calc
      (p.view.ncodeunits - JuliaLean.base.strings.substring.one +
        JuliaLean.base.strings.substring.one).val =
          (p.view.ncodeunits - JuliaLean.base.strings.substring.one).val +
            JuliaLean.base.strings.substring.one.val := haddNcu
      _ = p.view.ncodeunits.val := by rw [hsubNcu, hfirst]; omega
  let outView : View := ⟨p.view.string, p.view.offset,
    JuliaLean.base.strings.substring.int (Int.ofNat n)⟩
  have hraw : Sub.rawSubstringView parentOps p.view JuliaLean.base.strings.substring.one
      (JuliaLean.base.strings.substring.int (Int.ofNat n)) = .ok outView := by
    unfold Sub.rawSubstringView
    rw [hcountSub, hfirst]
    simp [hEnd, hoffEq, outView, hcountBound] <;> omega
  have hvout : viewValid outView := by
    have hvalid := JuliaLean.Proofs.base.strings.substring.rawSubstringAllWithinParent_proven.2
      parentOps p.view outView JuliaLean.base.strings.substring.one
      (JuliaLean.base.strings.basic.int (Int.ofNat n)) hv hraw
    exact hvalid.2
  have hcountNat :
      (JuliaLean.base.strings.substring.int (Int.ofNat n)).val.toNat = n := by
    rw [hcountSub]
    simp
  have hbytes : viewBytes outView = (preparedBytes p).take n := by
    change (p.view.string.bytes.drop p.view.offset.val.toNat).take
      (JuliaLean.base.strings.substring.int (Int.ofNat n)).val.toNat =
      ((p.view.string.bytes.drop p.view.offset.val.toNat).take
        p.view.ncodeunits.val.toNat).take n
    rw [hcountNat]
    simp only [List.take_take, Nat.min_eq_left hnNat]
  exact ⟨outView, hraw, hvout, hbytes, rfl, rfl⟩

private theorem goodViewValid (v : View) (hv : GoodView v) : viewValid v := by
  rcases hv with ⟨hoff, hlen, hfit, _⟩
  refine ⟨hoff, hlen, ?_⟩
  change v.offset.val + v.ncodeunits.val ≤ (Str.stringNcodeunits v.string).val
  rw [rawNcodeunitsVal]
  exact hfit

private theorem preparedPrefixContentLaw (s : Prepared) (hsView : GoodView s.view)
    (n : Nat) (hn : n ≤ (preparedBytes s).length) :
    ∃ v out,
      Sub.rawSubstringView parentOps s.view (int 1) (int n) = .ok v ∧
      prepareView v = .ok out ∧
      preparedBytes out = (preparedBytes s).take n := by
  obtain ⟨v, hraw, hv, hbytes, _, _⟩ :=
    rawPrefixViewLaw s (goodViewValid s.view hsView) n hn
  have hraw' : Sub.rawSubstringView parentOps s.view (int 1) (int n) = .ok v := by
    change Sub.rawSubstringView parentOps s.view JuliaLean.base.strings.substring.one
      (JuliaLean.base.strings.substring.int (Int.ofNat n)) = .ok v
    exact hraw
  have hfit : v.offset.val + v.ncodeunits.val ≤ v.string.bytes.length := by
    have hp := hv.2.2
    change v.offset.val + v.ncodeunits.val ≤ (Str.stringNcodeunits v.string).val at hp
    rw [rawNcodeunitsVal] at hp
    exact hp
  obtain ⟨out, hprepare, hview⟩ := prepareView_ok v hv.1 hv.2.1 hfit
  have hbytesOut : preparedBytes out = (preparedBytes s).take n := by
    change viewBytes out.view = List.take n (preparedBytes s)
    rw [hview]
    exact hbytes
  exact ⟨v, out, hraw', hprepare, hbytesOut⟩

private def preparedRawSubstringSmall (s : Prepared) (i : Index) (n : Nat) : Result Prepared := do
  prepareView (← Sub.rawSubstringView parentOps s.view i (int n))

private theorem preparedRawCallOfPrefix (s : Prepared) (n : Nat) (v : View) (out : Prepared)
    (hraw : Sub.rawSubstringView parentOps s.view (int 1) (int n) = .ok v)
    (hprepare : prepareView v = .ok out) :
    (do prepareView (← Sub.rawSubstringView parentOps s.view (int 1) (int n))) = .ok out := by
  rw [hraw]
  exact hprepare

private theorem preparedPrefixCallback (s : Prepared) (hd : DenseArg s) :
    ∀ n, n ≤ (preparedBytes s).length →
      ∃ out, preparedRawSubstringSmall s (int 1) n = .ok out ∧
        preparedBytes out = (preparedBytes s).take n := by
  intro n hn
  obtain ⟨v, out, hraw, hprepare, hbytes⟩ :=
    preparedPrefixContentLaw s (denseArg_good s hd) n hn
  have hrawCall : preparedRawSubstringSmall s (int 1) n = .ok out := by
    change (do prepareView (← Sub.rawSubstringView parentOps s.view (int 1) (int n))) = .ok out
    exact preparedRawCallOfPrefix s n v out hraw hprepare
  exact ⟨out, hrawCall, hbytes⟩

private theorem chompSpecEqReverse (bs : List UInt8) :
    chompSpec bs = chompReverseCharacters 0x0a 0x0d bs.reverse := by
  cases hr : bs.reverse with
  | nil =>
    have hbs : bs = [] := by
      have h := congrArg List.reverse hr
      simpa using h
    simp [hbs, chompSpec, chompReverseCharacters]
  | cons c rest =>
    have hbs : bs = rest.reverse ++ [c] := by
      have h := congrArg List.reverse hr
      simpa using h
    by_cases hc : c = 0x0a
    · subst c
      cases rest with
      | nil => simp [hbs, chompSpec, chompReverseCharacters]
      | cons d tail =>
        by_cases hd : d = 0x0d
        · subst d
          have ht : tail.reverse.take (tail.length + 1) = tail.reverse :=
            List.take_of_length_le (by simp)
          simp [hbs, chompSpec, chompReverseCharacters, List.take_append, ht]
        · have ht : tail.reverse.take (tail.length + 1) = tail.reverse :=
            List.take_of_length_le (by simp)
          simp [hbs, chompSpec, chompReverseCharacters, hd, List.take_append, ht]
    · simp [hbs, chompSpec, chompReverseCharacters, hc]

private theorem chompFastRawResultSmall (s : Prepared) (hd : DenseArg s) :
    ∃ out, chompFastCall s = .ok out ∧
      preparedBytes out = chompReverseCharacters 0x0a 0x0d (preparedBytes s).reverse := by
  obtain ⟨out, hcall, hbytes⟩ :=
    JuliaLean.Proofs.base.strings.util.chompFastCharacters_proven
      preparedBytes preparedRawSubstringSmall preparedBytes s (preparedPrefixCallback s hd)
  have hrawFun :
      preparedRawSubstringSmall =
        (fun s i n => do prepareView (← Sub.rawSubstringView parentOps s.view i (int n))) := by
    funext s i n
    rfl
  rw [hrawFun] at hcall
  exact ⟨out, by simpa [chompFastCall] using hcall, hbytes⟩

theorem chompFastCharacters_proven :
    JuliaLean.Proofs.base.strings.util.Round13.ChompFastCharacters := by
  intro s hd
  obtain ⟨out, hcall, hbytes⟩ := chompFastRawResultSmall s hd
  exact ⟨out, hcall, hbytes.trans (chompSpecEqReverse (preparedBytes s)).symm⟩
