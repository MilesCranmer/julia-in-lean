private theorem cpLowBits (x : BitVec 32) (b : BitVec 8) (n : Nat) (hn : n ≤ 16) :
    ((x ||| (b.setWidth 32 <<< n)) >>> (24 : Nat)) = (x >>> (24 : Nat)) := by
  apply BitVec.eq_of_getLsbD_eq
  intro i hi
  simp only [BitVec.getLsbD_ushiftRight, BitVec.getLsbD_or, BitVec.getLsbD_shiftLeft,
    BitVec.getLsbD_setWidth]
  have h : b.getLsbD (24 + i - n) = false := BitVec.getLsbD_of_ge _ _ (by omega)
  simp only [h, Bool.and_false, Bool.or_false]

private theorem cpTopOr16 (x : UInt32) (b : UInt8) :
    ((x ||| (b.toUInt32 <<< 16)) >>> 24) = (x >>> 24) := by
  apply UInt32.toBitVec_inj.mp
  exact cpLowBits x.toBitVec b.toBitVec 16 (by decide)

private theorem cpTopOr8 (x : UInt32) (b : UInt8) :
    ((x ||| (b.toUInt32 <<< 8)) >>> 24) = (x >>> 24) := by
  apply UInt32.toBitVec_inj.mp
  exact cpLowBits x.toBitVec b.toBitVec 8 (by decide)

private theorem cpTopOr0 (x : UInt32) (b : UInt8) :
    ((x ||| b.toUInt32) >>> 24) = (x >>> 24) := by
  apply UInt32.toBitVec_inj.mp
  change ((x.toBitVec ||| b.toBitVec.setWidth 32) >>> (24 : Nat)) = (x.toBitVec >>> (24 : Nat))
  simpa only [BitVec.shiftLeft_zero] using cpLowBits x.toBitVec b.toBitVec 0 (by decide)

private theorem cpTopShift (b : UInt8) : ((b.toUInt32 <<< 24) >>> 24) = b.toUInt32 := by
  apply UInt32.toBitVec_inj.mp
  change ((b.toBitVec.setWidth 32 <<< (24 : Nat)) >>> (24 : Nat)) = b.toBitVec.setWidth 32
  apply BitVec.eq_of_getLsbD_eq
  intro i hi
  simp only [BitVec.getLsbD_ushiftRight, BitVec.getLsbD_shiftLeft, BitVec.getLsbD_setWidth]
  by_cases hi8 : i < 8
  · simp [show 24 + i < 32 by omega, show 24 ≤ 24 + i by omega, hi]
  · have hb : b.toBitVec.getLsbD i = false := BitVec.getLsbD_of_ge _ _ (by omega)
    simp [show ¬24 + i < 32 by omega, hb]

private theorem cpContinuedTop {S : Type} (isvalid : S → Index → Bool)
    (ncodeunits : S → Index) (codeunit : S → Index → UInt8) (s : S) (i : Index)
    (u : UInt32) (hv : isvalid s i = true) :
    ∃ c, JuliaLean.base.strings.string.getindexContinued isvalid ncodeunits codeunit s i u =
      .ok c ∧ (c >>> 24) = (u >>> 24) := by
  unfold JuliaLean.base.strings.string.getindexContinued
  simp only [hv, if_true, pure, Except.pure, bind, Except.bind, ite_self]
  repeat' split
  all_goals refine ⟨_, rfl, ?_⟩
  all_goals simp only [cpTopOr16, cpTopOr8, cpTopOr0]

private theorem cpGetCharTop (s : Prepared) (gs : GoodView s.view) (i : Index)
    (hi1 : 1 ≤ i.val) (hin : i.val ≤ s.view.ncodeunits.val)
    (hvalid : thisindPure (fun x => parentByte s.view.string (s.view.offset.val + x)) i.val = i.val) :
    ∃ c, getChar s i = .ok c ∧
      (c >>> 24) = (parentByte s.view.string (s.view.offset.val + i.val)).toUInt32 := by
  have hoff := gs.off
  have hfit := gs.fit
  have hsmall := s.view.string.small
  have hsum : (s.view.offset + i).val = s.view.offset.val + i.val :=
    cpAddVal _ _ (by omega) (by omega)
  have hparent : Str.stringIsvalidIndex s.view.string (s.view.offset + i) = true := by
    apply (stringIsvalid_iff_pure s.view.string _ (by omega) (by omega)).mpr
    rw [hsum]
    exact (view_valid_parent s gs i.val hi1 hin).mp hvalid
  have hcb : JuliaLean.base.strings.string.stringCheckbounds s.view.string (s.view.offset + i) = .ok () := by
    simp [JuliaLean.base.strings.string.stringCheckbounds, hsum]
    omega
  have hcode : Str.stringCodeunit s.view.string (s.view.offset + i) =
      .ok (parentByte s.view.string (s.view.offset.val + i.val)) := by
    simp [Str.stringCodeunit, JuliaLean.base.strings.string.codeunitInteger,
      JuliaLean.base.strings.string.codeunitInt, hcb, JuliaLean.base.strings.string.pointerAt,
      JuliaLean.base.strings.string.pointerString, JuliaLean.base.strings.string.stringUnsafeConvert,
      JuliaLean.base.strings.string.stringPreserveByte, JuliaLean.base.strings.string.stringUnsafeLoad,
      parentByte, hsum, bind, Except.bind, pure, Except.pure]
  unfold getChar JuliaLean.base.strings.substring.getindexSubString
  simp only [viewBounds, hi1, hin, and_self, if_true, bind, Except.bind, pure, Except.pure]
  unfold JuliaLean.base.strings.string.stringGetindex JuliaLean.base.strings.string.getindexString
  rw [hcode]
  simp only [bind, Except.bind]
  split
  · exact ⟨_, rfl, cpTopShift _⟩
  · obtain ⟨c, hc, htop⟩ := cpContinuedTop Str.stringIsvalidIndex Str.stringNcodeunits
      JuliaLean.base.strings.string.stringByteAt s.view.string (s.view.offset + i)
      ((parentByte s.view.string (s.view.offset.val + i.val)).toUInt32 <<< 24) hparent
    exact ⟨c, hc, htop.trans (cpTopShift _)⟩

private theorem cpGetCharAscii (s : Prepared) (gs : GoodView s.view) (i : Index)
    (hi1 : 1 ≤ i.val) (hin : i.val ≤ s.view.ncodeunits.val)
    (b : UInt8) (hb : b.toNat < 128)
    (hbyte : parentByte s.view.string (s.view.offset.val + i.val) = b) :
