private theorem find?_mem {α : Type} {p : α → Bool} {xs : List α} {a : α}
    (h : xs.find? p = some a) : a ∈ xs := by
  induction xs with
  | nil => simp at h
  | cons x xs ih =>
    by_cases hp : p x
    · simp [List.find?, hp] at h
      subst a
      simp
    · simp [List.find?, hp] at h
      exact List.mem_cons_of_mem x (ih h)

private theorem minimalPrefixLength_some_of_first
    {A : Type} (w : A → Int) (r : Int) (xs : List A) (j : Nat)
    (hbound : j < xs.length)
    (hhit : r ≤ ((xs.take (j + 1)).map w).sum)
    (hbefore : ∀ k, k < j → ((xs.map w).take (k + 1)).sum < r) :
    minimalPrefixLength w r xs = some (j + 1) := by
  let pred := fun k => decide (r ≤ ((xs.take (k + 1)).map w).sum)
  let tail := xs.length - (j + 1)
  have hlen : xs.length = j.succ + tail := by simp [tail]; omega
  have hsplit : List.range xs.length =
      List.range j ++ [j] ++ List.map (fun k => j.succ + k) (List.range tail) := by
    rw [hlen, List.range_add, List.range_succ]
  have hnone : List.find? pred (List.range j) = none := by
    apply List.find?_eq_none.2
    intro k hk
    have hklt : k < j := List.mem_range.mp hk
    have hwidth := hbefore k hklt
    have hfalse : pred k = false := by
      dsimp [pred]
      simp only [List.map_take]
      exact decide_eq_false_iff_not.mpr (by omega)
    simp [hfalse]
  have htrue : pred j = true := by
    dsimp [pred]
    exact decide_eq_true_eq.mpr (by simpa only [List.map_take] using hhit)
  have hfind : List.find? pred (List.range xs.length) = some j := by
    rw [hsplit]
    simp [List.find?_append, hnone, htrue]
  unfold minimalPrefixLength
  rw [hfind]
  rfl

private theorem minimalPrefixLength_shape
    {A : Type} (w : A → Int) (r : Int) (xs : List A) (n : Nat)
    (hn : n ≤ xs.length)
    (hbefore : ∀ k, 0 < k → k < n → ((xs.map w).take k).sum < r)
    (hstop : n = xs.length ∨ (0 < n ∧ r ≤ ((xs.map w).take n).sum)) :
    minimalPrefixLength w r xs = some n ∨
      (minimalPrefixLength w r xs = none ∧ n = xs.length) := by
  by_cases hlt : n < xs.length
  · rcases hstop with hlen | ⟨hpos, hhit⟩
    · omega
    · have hmin : minimalPrefixLength w r xs = some n := by
        have h := minimalPrefixLength_some_of_first w r xs (n - 1) (by omega)
          (by simpa [List.map_take, Nat.sub_add_cancel hpos] using hhit)
          (by
            intro k hk
            have hk' : 0 < k + 1 ∧ k + 1 < n := by omega
            simpa [List.map_take] using hbefore (k + 1) hk'.1 hk'.2)
        simpa [Nat.sub_add_cancel hpos] using h
      exact Or.inl hmin
  · have hnlen : n = xs.length := by omega
    subst n
    let pred := fun k => decide (r ≤ ((xs.take (k + 1)).map w).sum)
    cases hfind : List.find? pred (List.range xs.length) with
    | none =>
      have hmin : minimalPrefixLength w r xs = none := by
        unfold minimalPrefixLength
        rw [hfind]
        rfl
      exact Or.inr ⟨hmin, rfl⟩
    | some j =>
      have hjmem : j ∈ List.range xs.length := find?_mem hfind
      have hjlt : j < xs.length := List.mem_range.mp hjmem
      have hhit : r ≤ ((xs.map w).take (j + 1)).sum := by
        have h := List.find?_some hfind
        simpa only [pred, decide_eq_true_eq, List.map_take] using h
      have hjlen : j + 1 = xs.length := by
        by_cases hlen : j + 1 = xs.length
        · exact hlen
        · have hsmall : j + 1 < xs.length := by omega
          have hlow := hbefore (j + 1) (by omega) hsmall
          omega
      have hmin : minimalPrefixLength w r xs = some xs.length := by
        unfold minimalPrefixLength
        rw [hfind]
        simp [hjlen]
      exact Or.inl hmin

namespace Affix

private theorem padViewPrefix_eq
    {S R C CU CT : Type} (prim : StringOps S R C CU CT JlError)
    (errs : ViewErrors S JlError) (cops : UCharOps C) (P : Utf8proc)
    (liftU : UError → JlError) (s : S) (i : Index) :
    (padRemOps prim errs cops P liftU).viewPrefix s i =
      gRange prim errs s (int 1) i := by
  simp [padRemOps, JuliaLean.base.strings.substring.viewString,
    JuliaLean.base.strings.substring.subStringRange,
    JuliaLean.base.strings.substring.subStringInteger, gRange,
    bind, Except.bind, pure, Except.pure]

private theorem padWholeViewIterates
    {S R C CU CT : Type} (prim : StringOps S R C CU CT JlError)
    (errs : ViewErrors S JlError) (cops : UCharOps C) (P : Utf8proc)
    (liftU : UError → JlError) (s : S) (ls : List (Index × C))
    (law : Lawful prim s ls) :
    ∃ out, (padRemOps prim errs cops P liftU).whole s = .ok out ∧
      out.string = s ∧ ViewIterates prim errs out (charsIn ls) := by
  obtain ⟨out, hwhole, hstring, hview⟩ := wholeViewIteratesAffix prim errs s ls law
  exact ⟨out, by simpa [padRemOps] using hwhole, hstring, hview⟩

private theorem padPrefixViewIterates
    {S R C CU CT : Type} (prim : StringOps S R C CU CT JlError)
    (errs : ViewErrors S JlError) (cops : UCharOps C) (P : Utf8proc)
    (liftU : UError → JlError) (s : S) (ls : List (Index × C))
    (law : Lawful prim s ls) (before : List (Index × C)) (i : Index) (c : C)
    (after : List (Index × C))
    (hsplit : ls = before ++ (i, c) :: after) :
    ∃ out, (padRemOps prim errs cops P liftU).viewPrefix s i = .ok out ∧
      out.string = s ∧ ViewIterates prim errs out (charsIn (before ++ [(i, c)])) := by
  obtain ⟨out, hrange, hstring, hview⟩ :=
    rangePrefixAffix prim errs s ls law before i c after hsplit
  exact ⟨out, by rw [padViewPrefix_eq]; exact hrange, hstring, hview⟩


private theorem padTextwidthChar
    {S R C CU CT : Type} (prim : StringOps S R C CU CT JlError)
    (errs : ViewErrors S JlError) (cops : UCharOps C) (P : Utf8proc)
    (liftU : UError → JlError) {c : C} {u : UInt32}
    (hto : cops.toChar c = .ok u) :
    (padRemOps prim errs cops P liftU).textwidthChar c = .ok (int (charWidth P u)) := by
  simp [padRemOps, JuliaLean.base.strings.unicode.textwidthAbstractChar,
    JuliaLean.base.strings.unicode.liftChar, charWidth, hto,
    Bind.bind, Except.bind, Pure.pure, Except.pure]

private theorem suWidthSumUpper (P : Utf8proc)
    (hw : ∀ u, 0 ≤ P.charwidth u ∧ P.charwidth u ≤ 2) :
    ∀ codes, (widthsOf P codes).sum ≤ 2 * codes.length := by
  intro codes
  induction codes with
  | nil => simp [widthsOf]
  | cons u rest ih =>
    have hu := suWidthBounds P hw u
    have ih' : (List.map (charWidth P) rest).sum ≤ 2 * rest.length := by
      simpa [widthsOf] using ih
    change charWidth P u + (List.map (charWidth P) rest).sum ≤ 2 * (rest.length + 1)
    omega

private theorem padRemainderLoopViewSpec
    {S R C CU CT : Type} (prim : StringOps S R C CU CT JlError)
    (errs : ViewErrors S JlError) (cops : UCharOps C) (P : Utf8proc)
    (liftU : UError → JlError) (s : S) (ls : List (Index × C))
    (codes : List UInt32) (r : Index)
    (hw : ∀ u, 0 ≤ P.charwidth u ∧ P.charwidth u ≤ 2)
    (hbound : ls.length < 2 ^ 61)
    (wholeLaw : ∃ out,
      (padRemOps prim errs cops P liftU).whole s = .ok out ∧
      out.string = s ∧ ViewIterates prim errs out (charsIn ls))
    (sliceLaw : ∀ before i c after, ls = before ++ (i, c) :: after →
      ∃ out, (padRemOps prim errs cops P liftU).viewPrefix s i = .ok out ∧
        out.string = s ∧ ViewIterates prim errs out (charsIn (before ++ [(i, c)]))) :
    ∀ {seen : List (Index × C)} {seenCodes : List UInt32}
      {rest : List (Index × C)} {restCodes : List UInt32}
      {current : Option ((Index × C) × Index)} {total : Index},
      PairTrace (fun state => pairsStep prim s (some state)) current rest →
      ls = seen ++ rest →
      codes = seenCodes ++ restCodes →
      seenCodes.length = seen.length →
      (charsIn rest).mapM cops.toChar = .ok restCodes →
      total.val = (widthsOf P seenCodes).sum →
      (∀ k, 0 < k → k ≤ seen.length →
        (widthsOf P (codes.take k)).sum < r.val) →
      ∃ out n,
        padRemainderString.loop (padRemOps prim errs cops P liftU) s r current total =
          some (.ok out) ∧
        n ≤ ls.length ∧
        out.string = s ∧
        ViewIterates prim errs out (charsIn (ls.take n)) ∧
        (n = ls.length ∨ (0 < n ∧ r.val ≤ (widthsOf P (codes.take n)).sum)) ∧
        (∀ k, 0 < k → k < n → (widthsOf P (codes.take k)).sum < r.val) := by
  intro seen seenCodes rest restCodes current total trace
  induction trace generalizing seen seenCodes restCodes total with
  | nil =>
    intro hsplit hcodes hlen hmap htotal hbefore
    have hrestCodes : restCodes = [] := by
      simpa [charsIn, List.mapM_nil, pure, Except.pure] using hmap
    subst restCodes
    have hcodes' : codes = seenCodes := by simpa using hcodes
    subst codes
    have hls : ls = seen := by simpa using hsplit
    subst ls
    obtain ⟨out, hwhole, hstring, hview⟩ := wholeLaw
    refine ⟨out, seen.length, ?_, by simp, hstring, ?_, Or.inl (by simp), ?_⟩
    · rw [padRemainderString.loop, JuliaLean.base.reduce.whileLoop]
      simp [hwhole, bind, Except.bind, pure, Except.pure]
    · simpa using hview
    · intro k hk hkn
      exact hbefore k hk (by omega)
  | @cons pair state next rest hstep htail ih =>
    intro hsplit hcodes hlen hmap htotal hbefore
    rcases pair with ⟨i, c⟩
    have hmap' : (c :: charsIn rest).mapM cops.toChar = .ok restCodes := by
      simpa [charsIn] using hmap
    obtain ⟨u, tailCodes, hto, htailMap, hvalues⟩ :=
      mapM_cons_ok cops.toChar c (charsIn rest) hmap'
    subst restCodes
    have hcodes' : codes = seenCodes ++ (u :: tailCodes) := by
      simpa [List.append_assoc] using hcodes
    have hwidth := padTextwidthChar prim errs cops P liftU hto
    have hcharBounds := suWidthBounds P hw u
    have hseenCount : seenCodes.length + 1 ≤ ls.length := by
      rw [hsplit]
      simp [hlen]
    have hsumUpper := suWidthSumUpper P hw seenCodes
    have htotalNonneg := suWidthSumNonneg P hw seenCodes
    have hcap : total.val + charWidth P u < 2 ^ 62 := by
      rw [htotal]
      omega
    have hindexFits : IntTy.min .i64 ≤ total.val + charWidth P u ∧
        total.val + charWidth P u ≤ IntTy.max .i64 := by
      constructor
      · simp [IntTy.min, IntTy.signed, IntTy.bits]
        omega
      · simp [IntTy.max, IntTy.signed, IntTy.bits]
        omega
    have hcharVal : (int (charWidth P u)).val = charWidth P u := by
      apply indexOfIntVal
      constructor <;> simp [IntTy.min, IntTy.max, IntTy.signed, IntTy.bits] <;> omega
    have hwidthVal :
        (total + int (charWidth P u)).val = total.val + charWidth P u := by
      calc
        (total + int (charWidth P u)).val =
            total.val + (int (charWidth P u)).val :=
          indexAddVal total (int (charWidth P u)) (by rw [hcharVal]; exact hindexFits)
        _ = total.val + charWidth P u := by rw [hcharVal]
    let nextWidth := total + int (charWidth P u)
    have hnextWidthVal : nextWidth.val = total.val + charWidth P u := hwidthVal
    let n := seen.length + 1
    have htakeCodes : codes.take n = seenCodes ++ [u] := by
      rw [hcodes']
      rw [List.take_append]
      rw [List.take_of_length_le (by simp [n, hlen])]
      simp [n, hlen]
    have hprefixWidth : (widthsOf P (codes.take n)).sum =
        (widthsOf P seenCodes).sum + charWidth P u := by
      rw [htakeCodes]
      simp [widthsOf, List.map_append, List.sum_append]
    have hprefixVal : nextWidth.val = (widthsOf P (codes.take n)).sum := by
      calc
        nextWidth.val = total.val + charWidth P u := hnextWidthVal
        _ = (widthsOf P seenCodes).sum + charWidth P u := by rw [htotal]
        _ = (widthsOf P (codes.take n)).sum := hprefixWidth.symm
    have htakePairs : ls.take n = seen ++ [(i, c)] := by
      rw [hsplit]
      rw [List.take_append]
      rw [List.take_of_length_le (by simp [n])]
      simp [n]
    by_cases hhit : nextWidth.val ≥ r.val
    · obtain ⟨out, hviewPrefix, hstring, hview⟩ :=
        sliceLaw seen i c rest (by simpa [List.append_assoc] using hsplit)
      refine ⟨out, n, ?_, by omega, hstring, ?_, Or.inr ⟨by omega, ?_⟩, ?_⟩
      · simp [padRemOps] at hwidth hviewPrefix
        rw [padRemainderString.loop, JuliaLean.base.reduce.whileLoop]
        simp [padRemOps, nextWidth, hwidth, hhit, hviewPrefix,
          bind, Except.bind, pure, Except.pure]
      · simpa [htakePairs] using hview
      · rw [← hprefixVal]
        exact hhit
      · intro k hk hkn
        exact hbefore k hk (by omega)
    · have hprefixBelow : (widthsOf P (codes.take n)).sum < r.val := by
        rw [← hprefixVal]
        omega
      have hnewLen : (seen ++ [(i, c)]).length = n := by simp [n]
      have hbefore' : ∀ k, 0 < k → k ≤ (seen ++ [(i, c)]).length →
          (widthsOf P (codes.take k)).sum < r.val := by
        intro k hk hkn
        have hkn' : k ≤ n := by rw [hnewLen] at hkn; exact hkn
        by_cases hkle : k ≤ seen.length
        · exact hbefore k hk hkle
        · have hkeq : k = n := by omega
          subst k
          exact hprefixBelow
      have hsplit' : ls = (seen ++ [(i, c)]) ++ rest := by
        rw [hsplit]
        simp [List.append_assoc]
      have hcodes'' : codes = (seenCodes ++ [u]) ++ tailCodes := by
        rw [hcodes']
        simp [List.append_assoc]
      have hlen' : (seenCodes ++ [u]).length = (seen ++ [(i, c)]).length := by
        simp [hlen]
      have htotal' : nextWidth.val = (widthsOf P (seenCodes ++ [u])).sum := by
        calc
          nextWidth.val = (widthsOf P (codes.take n)).sum := hprefixVal
          _ = (widthsOf P (seenCodes ++ [u])).sum := by rw [htakeCodes]
      have hnext : pairsStep prim s (some state) = .ok next := hstep
      obtain ⟨out, n', hloop, hlenOut, hstring, hviewOut, hstopOut, hbeforeOut⟩ :=
        ih hsplit' hcodes'' hlen' htailMap htotal' hbefore'
      refine ⟨out, n', ?_, hlenOut, hstring, hviewOut, hstopOut, hbeforeOut⟩
      simp [padRemOps] at hwidth
      rw [padRemainderString.loop, JuliaLean.base.reduce.whileLoop]
      simp [padRemOps, nextWidth, hwidth, hhit, hnext,
        bind, Except.bind, pure, Except.pure]
      simpa [padRemainderString.loop, padRemOps, nextWidth,
        bind, Except.bind, pure, Except.pure, Except.map] using hloop

private theorem suMapMLength {A B : Type} {E : Type u} (f : A → Except E B)
    {xs : List A} {ys : List B} (h : xs.mapM f = .ok ys) :
    xs.length = ys.length := by
  induction xs generalizing ys with
  | nil => cases h; rfl
  | cons x xs ih =>
    cases hx : f x with
    | error e => simp [List.mapM_cons, Bind.bind, Except.bind, hx] at h
    | ok y =>
      cases hxs : xs.mapM f with
      | error e => simp [List.mapM_cons, Bind.bind, Except.bind, hx, hxs] at h
      | ok rest =>
        have hwrap : (Except.ok ys : Except E (List B)) = .ok (y :: rest) := by
