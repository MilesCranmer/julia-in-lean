      (by simpa [hpre, List.append_assoc] using hsplit)
    obtain ⟨out, hr, ho, hv⟩ := suPrefixView prim errs s ls (q :: qs) (p :: after) law last hsplit hlast
    refine ⟨last.1, out, hp, hr, ho, hv, ?_, ?_⟩
    · intro h; cases h
    · intro z hz
      rw [hlast] at hz
      cases hz
      rfl


