def asciiCall (s : Raw) : Result Raw := asciiString asciiOps (__throw_invalid_ascii asciiOps) s

/-- id: stringscova-util-ascii-string-rebuilt. Source: ascii docstring, lines 1337-1362.
The earliest non-ASCII byte supplies the reported one-based index. -/
def AsciiAllBytes : Prop := ∀ s : Raw,
  (asciiCall s = .ok s ↔ ∀ b ∈ s.bytes, b.toNat < 128) ∧
  (∀ (before : List UInt8) (bad : UInt8) (after : List UInt8),
    s.bytes = before ++ bad :: after →
    (∀ b ∈ before, b.toNat < 128) → 128 ≤ bad.toNat →
    asciiCall s = .error (__throw_invalid_ascii asciiOps s (int (Int.ofNat before.length + 1))))


private theorem asciiCodeunitAt (s : Raw) (k : Nat) (hk : k < s.bytes.length) :
    (asciiOps.codeunit s (int (Int.ofNat k + 1))).toNat =
      (s.bytes.getD k 0).toNat := by
  have hsmall : s.bytes.length < 2 ^ 62 := s.small
  have hindex : (int (Int.ofNat k + 1)).val = Int.ofNat k + 1 := by
    change wrapInt .i64 (Int.ofNat k + 1) = _
    apply wrapInt_of_inRange
    constructor <;> simp [IntTy.min, IntTy.max, IntTy.signed, IntTy.bits] <;> omega
  have hnat : (Int.ofNat k + 1).toNat - 1 = k := by simp
  change (JuliaLean.base.strings.string.stringByteAt s (int (Int.ofNat k + 1))).toNat = _
  rw [JuliaLean.base.strings.string.stringByteAt, hindex]
  simp [hnat]

private theorem asciiGetDMem (bytes : List UInt8) (k : Nat) (hk : k < bytes.length) :
    bytes.getD k 0 ∈ bytes := by
  apply List.mem_iff_getElem.mpr
  exact ⟨k, hk, by simp [List.getD, hk]⟩

theorem asciiAllBytesProven : AsciiAllBytes := by
  intro s
  have hval : (asciiOps.sizeof s).val = (s.bytes.length : Int) := by
    have hsmall : s.bytes.length < 2 ^ 62 := s.small
    simp only [asciiOps, Str.stringNcodeunits,
      JuliaLean.base.strings.string.stringNcodeunits,
      JuliaLean.base.strings.string.stringCoreSizeof,
      JuliaLean.base.strings.string.ncodeunits,
      JuliaLean.Strings.ix]
    change wrapInt .i64 (Int.ofNat s.bytes.length) = _
    apply wrapInt_of_inRange
    constructor <;> simp [IntTy.min, IntTy.max, IntTy.signed, IntTy.bits] <;> omega
  have hsize : (asciiOps.sizeof s).val.toNat = s.bytes.length := by
    rw [hval]
    simp
  have hgeneric :=
    JuliaLean.Proofs.base.strings.util.asciiAllBytes_proven asciiOps s
  have hgenericResult :
      asciiCall s = .ok s ↔
        ∀ k, k < s.bytes.length →
          (asciiOps.codeunit s (int (Int.ofNat k + 1))).toNat < 128 := by
    simpa only [asciiCall, hsize] using hgeneric.1
  have hresult :
      asciiCall s = .ok s ↔
        ∀ k, k < s.bytes.length → (s.bytes.getD k 0).toNat < 128 := by
    constructor
    · intro h k hk
      have hcode := (hgenericResult.mp h) k hk
      rw [asciiCodeunitAt s k hk] at hcode
      exact hcode
    · intro h
      apply hgenericResult.mpr
      intro k hk
      have hcode := h k hk
      rw [asciiCodeunitAt s k hk]
      exact hcode
  have hbytes :
      (∀ k, k < s.bytes.length → (s.bytes.getD k 0).toNat < 128) ↔
        ∀ b ∈ s.bytes, b.toNat < 128 := by
    constructor
    · intro h b hb
      obtain ⟨k, hk, hbEq⟩ := List.mem_iff_getElem.mp hb
      have hcode := h k hk
      simpa [List.getD, hk, hbEq] using hcode
    · intro h k hk
      exact h _ (asciiGetDMem s.bytes k hk)
  refine ⟨hresult.trans hbytes, ?_⟩
  intro before bad after hsplit hbefore hbad
  let k := before.length
  have hk : k < s.bytes.length := by
    rw [hsplit]
    simp [k]
  have hbadCode : 128 ≤ (asciiOps.codeunit s (int (Int.ofNat k + 1))).toNat := by
    rw [asciiCodeunitAt s k hk]
    simp [k, hsplit, List.getD]
    exact hbad
  have hbeforeCode :
      ∀ j, j < k →
        (asciiOps.codeunit s (int (Int.ofNat j + 1))).toNat < 128 := by
    intro j hj
    have hjpre : j < before.length := by simpa [k] using hj
    have hjBytes : j < s.bytes.length := by
      rw [hsplit]
      simp [k]
      omega
    rw [asciiCodeunitAt s j hjBytes]
    have hmem : s.bytes.getD j 0 ∈ before := by
      rw [hsplit]
      apply List.mem_iff_getElem.mpr
      refine ⟨j, hjpre, ?_⟩
      simp only [List.getD_eq_getElem?_getD]
      rw [List.getElem?_append_left (l₂ := bad :: after) hjpre]
      rw [List.getElem?_eq_getElem hjpre]
      rfl
    exact hbefore _ hmem
  have hfirstBad := hgeneric.2 k (by simpa [hsize] using hk) hbadCode
    (by simpa [asciiCodeunitAt] using hbeforeCode)
  simpa [asciiCall, __throw_invalid_ascii, k] using hfirstBad
/-- id: stringutil-split-collect. Source: split and rsplit docstrings, util.jl:930-1004,
util.jl:958-961 `split(...) = collect(eachsplit(str, splitter; limit, keepempty))` and
util.jl:1001-1004 `rsplit(...) = reverse!(collect(eachrsplit(str, splitter; limit, keepempty)))`.
For every lawful string, every predicate splitter (which may throw), every `Integer` limit with
its `Int` conversion and every `keepempty`: a failing conversion propagates from both; otherwise
`split` returns exactly the substrings of `splitSpecE` runs taken from the left, in order, and
`rsplit` the runs taken from the right in source order; when the predicate throws on a character
the scan reaches, both throw that exception unless allocation fails first.
For every store `mem`, the element-layout query is bound to the actual `SubString{S}` type
tag and its layout exists. Collection returns the specified pieces or the installed allocator's
size `ArgumentError` / checked-growth overflow; allocation failures can precede a predicate
exception.
Non-`Integer` limits wait for R9-9, string and `Regex` splitters for R9-10 and R9-11. -/
def SplitCollect : Prop :=
  ∀ {S R C CU CT E N Tag : Type} (prim : StringOps S R C CU CT E) (errs : ViewErrors S E)
    (tag : Type → Tag) (layout : Tag → JuliaLean.base.array.MemoryLayoutMetadata)
    (l : JuliaLean.base.array.MemoryLayout) (liftA : JuliaLean.base.array.Error → E)
    (isInt : N → Bool) (toIndex : N → Except E Index)
    (f : C → Except E Bool) (s : S) (ls : List (Index × C)) (limit : N) (keepempty : Bool)
    (mem : JuliaLean.base.array.MutableMemory (Sub.SubString S)),
    (layout (tag (Sub.SubString S))).allocation = some l →
    SplitInput prim s ls → isInt limit = true →
    let split := (splitGeneric isInt toIndex prim.methodError (layout (tag (Sub.SubString S)))
      liftA (splitOps prim errs) (fun f s k => predFindnextE prim f s k) s f limit keepempty).run.run mem
    let rsplit := (rsplitGeneric isInt toIndex prim.methodError (layout (tag (Sub.SubString S)))
      liftA (splitOps prim errs) (fun f s k => predFindprevE prim f s k) s f limit keepempty).run.run mem
    let allocationFailure := fun result =>
      ∃ e mem', (e = JuliaLean.base.array.Error.argument JuliaLean.base.array.genericMemorySizeMessage ∨
        e = JuliaLean.base.array.Error.overflow) ∧ result = some (.error (liftA e), mem')
    (∀ e, toIndex limit = .error e →
      (∃ mem', split = some (.error e, mem')) ∧ (∃ mem', rsplit = some (.error e, mem'))) ∧
    (∀ l, toIndex limit = .ok l →
      let spec := splitSpecE f keepempty true (limitCount l) [] (charsIn ls)
      let rspec := splitSpecE f keepempty false (limitCount l) [] (charsIn ls).reverse
      (spec.2 = none →
        (∃ h mem' pieces, split = some (.ok h, mem') ∧
          mem'.contents h = pieces.map some ∧ ViewsIterate prim errs pieces spec.1) ∨
        allocationFailure split) ∧
      (∀ e, spec.2 = some e →
        (∃ mem', split = some (.error e, mem')) ∨ allocationFailure split) ∧
      (rspec.2 = none →
        (∃ h mem' pieces, rsplit = some (.ok h, mem') ∧
          mem'.contents h = pieces.map some ∧
          ViewsIterate prim errs pieces (rspec.1.map List.reverse).reverse) ∨
        allocationFailure rsplit) ∧
      (∀ e, rspec.2 = some e →
        (∃ mem', rsplit = some (.error e, mem')) ∨ allocationFailure rsplit))

theorem startswithCharacterSetProven : StartswithCharacterSet := by
  intro S R C CU CT E Q prim member s set ls hlaw
  cases hwalk : hlaw.walk with
  | stop hend hdone =>
    have hOne : (int 1).val = 1 := by decide
    have hlen : (prim.ncodeunits s).val = 0 := by
      rw [hOne] at hend
      omega
    have hEmpty : isemptyString (gFull prim) s = true := by
      change ((prim.ncodeunits s).val == 0) = true
      simp [hlen]
    simp [startswithChars, hEmpty, charsIn, bind, Except.bind, pure, Except.pure]
  | @step i j c rest hbounds hyield hadvance htail =>
    have hOne : (int 1).val = 1 := by decide
    have hnonempty : 0 < (prim.ncodeunits s).val := by
      have h := hbounds.2
      rw [hOne] at h
      omega
    have hNonzero : (prim.ncodeunits s).val ≠ 0 := by omega
    have hEmpty : isemptyString (gFull prim) s = false := by
      change ((prim.ncodeunits s).val == 0) = false
      simp [hNonzero]
    have hboundAt : 1 ≤ (prim.ncodeunits s).val := by omega
    have hcheck : (gFull prim).checkbounds s (int 1) = .ok () := by
      simp [gFull, modelStringOps, JuliaLean.base.strings.basic.checkbounds,
        JuliaLean.base.strings.basic.checkboundsScalar, hOne, hboundAt, bind, Except.bind,
        pure, Except.pure]
    have hvalid : (gFull prim).isvalid s (int 1) = .ok true := by
      change prim.isvalid s (int 1) = .ok true
      rw [hlaw.isvalid (int 1) (by decide) hboundAt]
      simp [List.any, hOne]
    have hiter : (gFull prim).iterateAt s (int 1) = .ok (some (c, j)) := by
      change prim.iterateAt s (int 1) = .ok (some (c, j))
      exact hyield
    have hfirst : firstString (getindexString (gFull prim)) s = .ok c := by
      simp [firstString, firstindexString, getindexString, getindexInteger,
        hcheck, hvalid, hiter, bind, Except.bind, pure, Except.pure]
    simp [startswithChars, hEmpty, hfirst, charsIn, bind, Except.bind, pure, Except.pure]

