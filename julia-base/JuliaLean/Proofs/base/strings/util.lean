       omega)


private theorem ixAddV (a b : Index) (h0 : -2 ^ 62 ≤ a.val + b.val) (h1 : a.val + b.val ≤ 2 ^ 62) :
    (a + b).val = a.val + b.val := by
  change wrapInt .i64 (a.val + b.val) = _
  exact wrapInt_of_inRange .i64 _ (by simp [IntTy.min, IntTy.max, IntTy.signed, IntTy.bits]; omega)

private theorem ixSubV (a b : Index) (h0 : -2 ^ 62 ≤ a.val - b.val) (h1 : a.val - b.val ≤ 2 ^ 62) :
    (a - b).val = a.val - b.val := by
  change wrapInt .i64 (a.val - b.val) = _
  exact wrapInt_of_inRange .i64 _ (by simp [IntTy.min, IntTy.max, IntTy.signed, IntTy.bits]; omega)

private theorem zeroVal : JuliaLean.base.strings.substring.zero.val = 0 := by
  change wrapInt .i64 0 = 0
  exact wrapInt_of_inRange .i64 0 (by simp [IntTy.min, IntTy.max, IntTy.signed, IntTy.bits])

/-- `nextind(s::String, j)` from a character start `j`. -/
theorem stringNextind_next (s : Raw) (j : Index) (h1 : 1 ≤ j.val) (hj : j.val ≤ s.bytes.length)
    (hv : ¬ joined (parentByte s) j.val) :
    ∃ m, Str.stringNextind s j = .ok m ∧ j.val < m.val ∧ m.val ≤ s.bytes.length + 1 ∧
      (m.val = s.bytes.length + 1 ∨ ¬ joined (parentByte s) m.val) ∧
      ∀ q, j.val < q → q < m.val → joined (parentByte s) q := by
  have hsmall := s.small
  have hn := stringNcodeunits_val s
  have hcu : ∀ k : Index, JuliaLean.base.strings.string.stringCodeunitAt false s k =
      if 1 ≤ k.val ∧ k.val ≤ (Str.stringNcodeunits s).val then .ok (parentByte s k.val)
      else .ok (parentByte s k.val) := by
    intro k; rw [stringCodeunitAt_unchecked]; split <;> rfl
  obtain ⟨m, hm, hgt, hle, hle4, hend, j1, j2, j3⟩ := nextindStr_next Str.stringNcodeunits
    JuliaLean.base.strings.string.stringCodeunitAt s (parentByte s) j
    (fun k => .ok (parentByte s k.val)) hcu h1 (by rw [hn]; exact hj) (by rw [hn]; omega) hv
  refine ⟨m, hm, hgt, by rw [hn] at hle; exact hle, by rw [hn] at hend; exact hend, ?_⟩
  intro q hq1 hq2
  rcases (show q = j.val + 1 ∨ q = j.val + 2 ∨ q = j.val + 3 by omega) with rfl | rfl | rfl
  · exact j1 hq2
  · exact j2 hq2
  · exact j3 hq2

/-- The view ends at a character boundary of its parent. -/
def GoodEnd (v : View) : Prop :=
  v.offset.val + v.ncodeunits.val = v.string.bytes.length ∨
    ¬ joined (parentByte v.string) (v.offset.val + v.ncodeunits.val + 1)

theorem goodEnd_ofStringView (s : Raw) (i j : Index) (v : View)
    (hv : stringView s i j = .ok v) : GoodEnd v := by
  have hone := substringOne_val
  have hsmall := s.small
  unfold stringView Sub.subStringInt at hv
  by_cases hji : j.val < i.val
  · simp [JuliaLean.base.strings.substring.typedSubString, hji, bind, Except.bind, pure,
      Except.pure] at hv
    subst hv
    right
    simp only [zeroVal]
    unfold joined
    omega
  · by_cases hb : 1 ≤ i.val ∧ j.val ≤ (s.bytes.length : Int)
    · cases hvi : Str.stringIsvalidIndex s i with
      | false =>
        simp [JuliaLean.base.strings.substring.typedSubString, hji, parentOps, hb, hb.1, hb.2, hvi,
          bind, Except.bind, pure, Except.pure, throw, throwThe, MonadExceptOf.throw] at hv
      | true =>
        cases hvj : Str.stringIsvalidIndex s j with
        | false =>
          simp [JuliaLean.base.strings.substring.typedSubString, hji, parentOps, hb, hb.1, hb.2, hvi,
            hvj, bind, Except.bind, pure, Except.pure, throw, throwThe,
            MonadExceptOf.throw] at hv
        | true =>
          have hjv : ¬ joined (parentByte s) j.val :=
            (thisindPure_eq_iff _ _).mp ((stringIsvalid_iff_pure s j (by omega)
              (by exact_mod_cast hb.2)).mp hvj)
          obtain ⟨m, hm, hgt, hle, hend, _⟩ := stringNextind_next s j (by omega)
            (by exact_mod_cast hb.2) hjv
          simp [JuliaLean.base.strings.substring.typedSubString, hji, parentOps, hb, hb.1, hb.2, hvi,
            hvj, hm, bind, Except.bind, pure, Except.pure] at hv
          subst hv
          have hoffv : (i - JuliaLean.base.strings.substring.one).val = i.val - 1 := by
            rw [ixSubV _ _ (by rw [hone]; omega) (by rw [hone]; omega), hone]
          have hlenv : (m - i).val = m.val - i.val := ixSubV _ _ (by omega) (by omega)
          unfold GoodEnd
          simp only [hoffv, hlenv]
          rw [show i.val - 1 + (m.val - i.val) + 1 = m.val by omega,
            show i.val - 1 + (m.val - i.val) = m.val - 1 by omega]
          rcases hend with h | h
          · left; omega
          · right; exact h
    · simp [JuliaLean.base.strings.substring.typedSubString, hji, parentOps, hb,
        bind, Except.bind, pure, Except.pure, throw, throwThe, MonadExceptOf.throw] at hv

theorem goodEnd_ofPrepare (s : Raw) (p : Prepared) (hp : prepare s = .ok p) : GoodEnd p.view := by
  unfold prepare at hp
  cases hr : rawView s with
  | error e => rw [hr] at hp; cases hp
  | ok v =>
    rw [hr] at hp
    have hp' : prepareView v = .ok p := hp
    rw [prepareView_view hp']
    rw [rawView_eq s] at hr
    injection hr with hr
    subst hr
    left
    simp only [oneSubOne_val, stringNcodeunits_val]
    omega

theorem denseArg_goodEnd (p : Prepared) (h : DenseArg p) : GoodEnd p.view := by
  cases h with
  | @string s p hp => exact goodEnd_ofPrepare s p hp
  | @view s i j v p hv hp =>
    rw [prepareView_view hp]
    exact goodEnd_ofStringView s i j v hv

theorem prepareView_last {v : View} {p : Prepared} (h : prepareView v = .ok p) :
    viewThisind v v.ncodeunits = .ok p.last := by
  unfold prepareView at h
  cases hl : Sub.lastindexSubString viewThisind v with
  | error e => simp [hl, bind, Except.bind] at h
  | ok l =>
    simp [hl, bind, Except.bind, pure, Except.pure] at h
    rw [← h]
    exact hl

theorem denseArg_last (p : Prepared) (h : DenseArg p) :
    viewThisind p.view p.view.ncodeunits = .ok p.last := by
  cases h with
  | @string s p hp =>
    unfold prepare at hp
    cases hr : rawView s with
    | error e => rw [hr] at hp; cases hp
    | ok v =>
      rw [hr] at hp
      have hp' : prepareView v = .ok p := hp
      rw [prepareView_view hp']
      exact prepareView_last hp'
  | @view s i j v p hv hp =>
    rw [prepareView_view hp]
    exact prepareView_last hp

theorem prepareView_ok (v : View) (hoff : 0 ≤ v.offset.val) (hlen : 0 ≤ v.ncodeunits.val)
    (hfit : v.offset.val + v.ncodeunits.val ≤ v.string.bytes.length) :
    ∃ p, prepareView v = .ok p ∧ p.view = v := by
  have hsmall := v.string.small
  by_cases hz : v.ncodeunits.val = 0
  · have hz' : (v.ncodeunits.val == 0) = true := by simp [hz]
    have hth : viewThisind v v.ncodeunits = .ok (JuliaLean.Strings.ix 0) := by
      simp [viewThisind, Sub.thisindSubString, Str.thisindString,
        JuliaLean.base.strings.string.thisindString, JuliaLean.base.strings.string.thisindStr,
        hz', pure, Except.pure]
    exact ⟨⟨v, JuliaLean.Strings.ix 0⟩, by
      simp [prepareView, Sub.lastindexSubString, Sub.thisindSubString, hth, bind, Except.bind,
        pure, Except.pure], rfl⟩
  · obtain ⟨r, hr, _⟩ := viewThisind_pure v v.ncodeunits (by omega) (Int.le_refl _) hoff hfit
    exact ⟨⟨v, r⟩, by
      simp [prepareView, Sub.lastindexSubString, Sub.thisindSubString, hr, bind, Except.bind,
        pure, Except.pure], rfl⟩

/-- A view's own reader. -/
private theorem joined_view_parent (P : Int → UInt8) (o x : Int) (ho : 0 ≤ o)
    (h : joined (fun y => P (o + y)) x) : joined P (o + x) := by
  have e1 : o + (x - 1) = o + x - 1 := by omega
  have e2 : o + (x - 2) = o + x - 2 := by omega
  have e3 : o + (x - 3) = o + x - 3 := by omega
  unfold joined at h ⊢
  simp only [e1, e2, e3] at h
  rcases h with ⟨p, a, b⟩ | ⟨p, a, b, c⟩ | ⟨p, a, b, c, d⟩
  · exact Or.inl ⟨by omega, a, b⟩
  · exact Or.inr (Or.inl ⟨by omega, a, b, c⟩)
  · exact Or.inr (Or.inr ⟨by omega, a, b, c, d⟩)

private theorem drop_take_drop (l : List UInt8) (o c n : Nat) (hc : c ≤ n) :
    ((l.drop o).take n).drop c = (l.drop (o + c)).take (n - c) := by
  rw [List.drop_take, List.drop_drop]

