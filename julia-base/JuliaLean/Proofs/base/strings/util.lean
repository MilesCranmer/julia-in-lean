open JuliaLean JuliaLean.base.strings.basic JuliaLean.base.strings.util

private theorem ixAdd1' (x : Index) (h0 : 0 ≤ x.val) (h : x.val ≤ 2 ^ 62 + 8) :
    (x + JuliaLean.Strings.ix 1).val = x.val + 1 := by
  change wrapInt .i64 (x.val + wrapInt .i64 1) = _
  rw [show wrapInt .i64 1 = 1 by decide]
  exact wrapInt_of_inRange .i64 _ (by
    simp [IntTy.min, IntTy.max, IntTy.signed, IntTy.bits]; omega)

private theorem leadMonoA (b : UInt8) : leadB 3 b = true → leadB 2 b = true ∧ leadB 1 b = true := by
  simp only [leadB, Str.stringBetweenByte, JuliaLean.base.strings.string.between,
    Bool.and_eq_true, decide_eq_true_eq, UInt8.le_iff_toNat_le]
  intro h
  simp at h ⊢
  omega

private theorem leadMono2A (b : UInt8) : leadB 2 b = true → leadB 1 b = true := by
  simp only [leadB, Str.stringBetweenByte, JuliaLean.base.strings.string.between,
    Bool.and_eq_true, decide_eq_true_eq, UInt8.le_iff_toNat_le]
  intro h
  simp at h ⊢
  omega

private theorem lead_not_cont (k : Nat) (b : UInt8) (h : leadB k b = true) : contB b = false := by
  rw [contB_false_iff]
  rw [leadB_iff] at h
  split at h <;> (try split at h) <;> omega

/-- The start of the character holding `i` is itself a character start. -/
theorem thisindPure_idem (rd : Int → UInt8) (i : Int) :
    thisindPure rd (thisindPure rd i) = thisindPure rd i := by
  rcases thisindPure_cases rd i with h | ⟨h, _, _, hl⟩ | ⟨h, _, _, _, hl⟩ | ⟨h, _, _, _, _, hl⟩ <;>
    rw [h]
  · exact h
  all_goals
    unfold thisindPure
    rw [cont_beq, lead_not_cont _ _ hl]
    simp

/-- Every position after the character start found by `thisind(s, n)`, up to `n`, continues
that character. -/
theorem thisindPure_gap (rd : Int → UInt8) (n q : Int) (hq : thisindPure rd n < q)
    (hqn : q ≤ n) : joined rd q := by
  rcases thisindPure_cases rd n with h | ⟨h, hp, c0, l⟩ | ⟨h, hp, c0, c1, l⟩ |
      ⟨h, hp, c0, c1, c2, l⟩ <;> rw [h] at hq
  · omega
  · have hq' : q = n := by omega
    subst hq'
    exact Or.inl ⟨hp, c0, l⟩
  · rcases (show q = n ∨ q = n - 1 by omega) with rfl | rfl
    · exact Or.inr (Or.inl ⟨hp, c0, c1, l⟩)
    · have e : n - 1 - 1 = n - 2 := by omega
      exact Or.inl ⟨by omega, c1, by rw [e]; exact leadMono2A _ l⟩
  · have l2 := (leadMonoA _ l).1
    have l1 := (leadMonoA _ l).2
    rcases (show q = n ∨ q = n - 1 ∨ q = n - 2 by omega) with rfl | rfl | rfl
    · exact Or.inr (Or.inr ⟨hp, c0, c1, c2, l⟩)
    · have e1 : n - 1 - 1 = n - 2 := by omega
      have e2 : n - 1 - 2 = n - 3 := by omega
      exact Or.inr (Or.inl ⟨by omega, c1, by rw [e1]; exact c2, by rw [e2]; exact l2⟩)
    · have e1 : n - 2 - 1 = n - 3 := by omega
      exact Or.inl ⟨by omega, c2, by rw [e1]; exact l1⟩

/-- A character start at or before `n` is at or before `thisind(s, n)`. -/
theorem thisindPure_ge_valid (rd : Int → UInt8) (n q : Int) (hq : ¬ joined rd q)
    (hqn : q ≤ n) : q ≤ thisindPure rd n := by
  apply Int.not_lt.mp
  intro hlt
  exact hq (thisindPure_gap rd n q hlt hqn)

theorem thisindPure_ge_one (rd : Int → UInt8) (n : Int) (hn : 1 ≤ n) : 1 ≤ thisindPure rd n := by
  rcases thisindPure_cases rd n with h | h | h | h <;> omega

theorem thisindPure_le (rd : Int → UInt8) (n : Int) : thisindPure rd n ≤ n := by
  rcases thisindPure_cases rd n with h | h | h | h <;> omega

