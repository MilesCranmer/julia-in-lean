/-- `_nextind_str` from a character start `g` returns the next character start (or `n + 1`),
and every position strictly between continues the character at `g`. -/
theorem nextindStr_next {S : Type} (ncu : S → Index)
    (cu : Bool → S → Index → Str.StringResult UInt8) (s : S) (rd : Int → UInt8) (g : Index)
    (other : Index → Str.StringResult UInt8)
    (hcu : ∀ k : Index, cu false s k =
      if 1 ≤ k.val ∧ k.val ≤ (ncu s).val then .ok (rd k.val) else other k)
    (hg1 : 1 ≤ g.val) (hgn : g.val ≤ (ncu s).val) (hmax : (ncu s).val < 2 ^ 62)
    (hvalid : ¬ joined rd g.val) :
    ∃ m, JuliaLean.base.strings.string.nextindStr ncu Str.stringBetweenIndex
      Str.stringBetweenByte cu s g = .ok m ∧
      g.val < m.val ∧ m.val ≤ (ncu s).val + 1 ∧ m.val ≤ g.val + 4 ∧
      (m.val = (ncu s).val + 1 ∨ ¬ joined rd m.val) ∧
      (g.val + 1 < m.val → joined rd (g.val + 1)) ∧
      (g.val + 2 < m.val → joined rd (g.val + 2)) ∧
      (g.val + 3 < m.val → joined rd (g.val + 3)) := by
  have hcuC : ∀ k : Index, 1 ≤ k.val → k.val ≤ (ncu s).val → cu false s k = .ok (rd k.val) := by
    intro k h1 h2; rw [hcu k, if_pos ⟨h1, h2⟩]
  have hne0 : (g.val == 0) = false := by simp; omega
  have hbtw : Str.stringBetweenIndex g (JuliaLean.Strings.ix 1) (ncu s) = true := by
    simp [Str.stringBetweenIndex, JuliaLean.base.strings.string.between, hgn]
    change 1 ≤ g.val
    exact hg1
  have r0 : cu false s g = .ok (rd g.val) := hcuC g hg1 hgn
  have v1 := ixAdd1' g (by omega) (by omega)
  have v2 := ixAdd1' (g + JuliaLean.Strings.ix 1) (by omega) (by omega)
  rw [v1] at v2
  have v3 := ixAdd1' (g + JuliaLean.Strings.ix 1 + JuliaLean.Strings.ix 1) (by omega) (by omega)
  rw [v2] at v3
  have v4 := ixAdd1' (g + JuliaLean.Strings.ix 1 + JuliaLean.Strings.ix 1 +
    JuliaLean.Strings.ix 1) (by omega) (by omega)
  rw [v3] at v4
  obtain ⟨r, hr, hrv⟩ := thisindStr_pure ncu cu s rd g hcuC hg1 hgn hmax
  have hthis : JuliaLean.base.strings.string.thisindString ncu Str.stringBetweenIndex
      Str.stringBetweenByte cu s g = .ok r := hr
  have hrg : r.val = g.val := by rw [hrv]; exact (thisindPure_eq_iff rd g.val).mpr hvalid
  have q11 : g.val + 1 - 1 = g.val := by omega
  have q12 : g.val + 1 - 2 = g.val - 1 := by omega
  have q13 : g.val + 1 - 3 = g.val - 2 := by omega
  have q21 : g.val + 1 + 1 - 1 = g.val + 1 := by omega
  have q22 : g.val + 1 + 1 - 2 = g.val := by omega
  have q23 : g.val + 1 + 1 - 3 = g.val - 1 := by omega
  have q31 : g.val + 1 + 1 + 1 - 1 = g.val + 1 + 1 := by omega
  have q32 : g.val + 1 + 1 + 1 - 2 = g.val + 1 := by omega
  have q33 : g.val + 1 + 1 + 1 - 3 = g.val := by omega
  have q41 : g.val + 1 + 1 + 1 + 1 - 1 = g.val + 1 + 1 + 1 := by omega
  have q42 : g.val + 1 + 1 + 1 + 1 - 2 = g.val + 1 + 1 := by omega
  have q43 : g.val + 1 + 1 + 1 + 1 - 3 = g.val + 1 := by omega
  have p2 : g.val + 2 = g.val + 1 + 1 := by omega
  have p3 : g.val + 3 = g.val + 1 + 1 + 1 := by omega
  have p4 : g.val + 4 = g.val + 1 + 1 + 1 + 1 := by omega
  have hgv := hvalid
  unfold joined at hgv
  clear hr hrv hvalid
  unfold JuliaLean.base.strings.string.nextindStr
  simp only [hne0, hbtw, r0, hthis, hcu, v1, v2, v3, v4, hrg, Bool.false_eq_true,
    if_false, Bool.not_true, bind_ite', ok_bind', error_bind', pure_bind', throw_bind']
  clear hcu hcuC r0 hthis hne0 hbtw
  repeat' (refine ex_ite (fun hh => ?_) (fun hh => ?_))
  all_goals first
    | omega
    | (refine ⟨_, rfl, ?_⟩
       (try split) <;>
       (simp only [joined, v1, v2, v3, v4, hrg, p2, p3, p4, q11, q12, q13, q21, q22, q23, q31, q32,
         q33, q41, q42, q43, contB_iff, contB_false_iff, lead1_iff, lead2_iff, lead3_iff,
         btw80_iff, btw80_false_iff, cont_bne, Bool.not_eq_true', Bool.not_eq_true,
         Bool.not_eq_false', Bool.or_eq_true, Bool.or_eq_false_iff, decide_eq_true_eq,
         decide_eq_false_iff_not, lt128_iff, lt192_iff, lt224_iff, lt240_iff, ge248_iff,
         ge192_iff, Bool.not_eq_eq_eq_not, Bool.not_true, Bool.not_false, true_iff, false_iff,
         iff_true, iff_false, true_implies] at *
