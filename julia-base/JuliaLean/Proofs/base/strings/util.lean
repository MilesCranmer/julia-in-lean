private theorem hexIntVal (n : Int) (lo : -2^63 ≤ n) (hi : n < 2^63) :
    (int n).val = n := by
  change wrapInt .i64 n = n
  apply wrapInt_of_inRange
  change -9223372036854775808 ≤ n ∧ n ≤ 9223372036854775807
  constructor <;> omega

private theorem hexadecimalValue_length {codes bytes : List UInt8}
    (h : hexadecimalValue codes = some bytes) : codes.length = 2 * bytes.length := by
  induction codes using hexadecimalValue.induct generalizing bytes with
  | case1 => cases h; rfl
  | case2 b => simp [hexadecimalValue] at h
  | case3 a b rest ih =>
    cases ha : hexNibble a <;> cases hb : hexNibble b <;>
      cases hr : hexadecimalValue rest <;>
      simp [hexadecimalValue, ha, hb, hr, bind, Option.bind] at h
    rename_i hi lo tail
    subst bytes
    have hlen := ih hr
    simp only [List.length_cons]
    omega

private theorem setByteCell_ok (dest : List UInt8) (i : Index) (b : UInt8)
    (h : 1 ≤ i.val ∧ i.val ≤ Int.ofNat dest.length) :
    setByteCell dest i b = .ok (dest.set (i.val.toNat - 1) b) := by
  simp [setByteCell, JuliaLean.base.array.setindexScalar, JuliaLean.base.array.setindexTyped,
    h.1, h.2, Bind.bind, Pure.pure, StateT.bind, StateT.pure, StateT.run, get, set, modify,
    MonadStateOf.get, MonadStateOf.set, getThe, modifyGet, MonadStateOf.modifyGet,
    StateT.get, StateT.modifyGet, Except.bind, Except.pure, Except.map]
  split <;> simp_all [StateT.pure]
  subst_vars
  rfl

private theorem byteArraySet_ok (dest : List UInt8) (i : Index) (b : UInt8)
    (h : 1 ≤ i.val ∧ i.val ≤ Int.ofNat dest.length) :
    (byteArrayOps.set i b).run dest = .ok () (dest.set (i.val.toNat - 1) b) := by
  simp [byteArrayOps, setByteCell_ok dest i b h, Bind.bind, Pure.pure,
    EStateM.bind, EStateM.pure, EStateM.run, get, getThe, set,
    MonadStateOf.get, MonadStateOf.set, EStateM.get, EStateM.set]

private theorem byteIndexWalk (indices xs : List Index) :
    IndexWalk byteArrayOps indices (some xs) xs := by
  induction xs with
  | nil => intro d; rfl
  | cons i xs ih => exact ⟨xs, fun _ => rfl, ih⟩

private theorem bytePureIndices (dest : List UInt8) :
    PureIndices byteArrayOps dest
      ((List.range dest.length).map (fun k => int (Int.ofNat k + 1))) := by
  let indices := (List.range dest.length).map (fun k => int (Int.ofNat k + 1))
  refine ⟨indices, rfl, ?_⟩
  change IndexWalk byteArrayOps indices none indices
  cases hi : indices with
  | nil => intro d; rfl
  | cons i xs => exact ⟨xs, fun _ => rfl, byteIndexWalk (i :: xs) xs⟩

private theorem setAppendHead (before : List UInt8) (old b : UInt8) (after : List UInt8) :
    (before ++ old :: after).set before.length b = before ++ b :: after := by
  induction before with
  | nil => rfl
  | cons x xs ih => simpa using congrArg (List.cons x) ih

private theorem byteWrites_correct :
    ∀ (bytes : List UInt8) (idxs : List Index) (before old : List UInt8),
    idxs.length = bytes.length →
    old.length = bytes.length →
    (∀ k (hk : k < idxs.length), (idxs[k]).val = Int.ofNat before.length + Int.ofNat k + 1) →
    (writesM byteArrayOps idxs bytes).run (before ++ old) = .ok () (before ++ bytes) := by
  intro bytes
  induction bytes with
  | nil =>
    intro idxs before old hi ho slots
    have hidx : idxs = [] := List.eq_nil_of_length_eq_zero hi
    have hold : old = [] := List.eq_nil_of_length_eq_zero ho
    subst idxs; subst old; rfl
  | cons b bs ih =>
    intro idxs before old hi ho slots
    cases idxs with
    | nil => simp at hi
    | cons i idxs =>
      cases old with
      | nil => simp at ho
      | cons oldHead old =>
        have hindex := slots 0 (by simp)
        change i.val = (before.length : Int) + 0 + 1 at hindex
        have hbound : 1 ≤ i.val ∧ i.val ≤ Int.ofNat (before ++ oldHead :: old).length := by
          change 1 ≤ i.val ∧ i.val ≤ ((before ++ oldHead :: old).length : Int)
          simp only [List.length_append, List.length_cons, Int.natCast_add]
          omega
        have hset := byteArraySet_ok (before ++ oldHead :: old) i b hbound
        have hslot : i.val.toNat - 1 = before.length := by omega
        rw [hslot, setAppendHead] at hset
        have htail := ih idxs (before ++ [b]) old (by simpa using hi) (by simpa using ho) (by
          intro k hk
          have hv := slots (k + 1) (by simp only [List.length_cons]; omega)
          change (idxs[k]).val = (before.length : Int) + ((k + 1 : Nat) : Int) + 1 at hv
          change (idxs[k]).val = (((before ++ [b]).length : Nat) : Int) + (k : Int) + 1
          simp only [List.length_append, List.length_singleton, Int.natCast_add]
          omega)
        simp only [writesM, List.zip_cons_cons, List.forM, Bind.bind, EStateM.bind,
          EStateM.run] at hset htail ⊢
        rw [hset]
        simpa only [List.append_assoc, List.singleton_append] using htail

private theorem decodePairs_correct :
    ∀ codes : List UInt8, codes.length % 2 = 0 →
      hexadecimalValue codes =
        match decodePairs codes with
        | (bytes, false) => some bytes
        | (_, true) => none
  | [], _ => rfl
  | [_], heven => by simp at heven
  | a :: b :: rest, heven => by
      have hrest : rest.length % 2 = 0 := by simp at heven; omega
      cases ha : hexNibble a with
      | none => simp [hexadecimalValue, decodePairs, ha]
      | some hi =>
        cases hb : hexNibble b with
        | none => simp [hexadecimalValue, decodePairs, ha, hb]
        | some lo =>
          cases hpair : decodePairs rest with
          | mk bytes failed =>
            cases failed <;>
              simp [hexadecimalValue, decodePairs, ha, hb,
                decodePairs_correct rest hrest, hpair, bind, Option.bind]

private def hexByteFirst : List UInt8 → Option (HexDigit UInt32 UInt32 × List UInt8)
  | [] => none
  | b :: bs => some (.byte b, bs)

private theorem byteHexInput (bytes : List UInt8) (small : bytes.length < 2 ^ 62) :
    HexInput byteIterator sameChar bytes (bytes.map HexDigit.byte) bytes := by
  constructor
  · refine ⟨hexByteFirst bytes, ?_, ?_⟩
    · cases bytes <;> rfl
    have trace : ∀ xs : List UInt8,
        Trace (byteIterator.iterateNext bytes)
          (hexByteFirst xs)
          (xs.map HexDigit.byte) := by
      intro xs
      induction xs with
      | nil => exact .nil
      | cons b bs ih => exact .cons rfl ih
    exact trace bytes
  · simp only [byteIterator, List.length_map]
  · have hmap : ∀ xs : List UInt8,
        (xs.map (HexDigit.byte (A := UInt32) (C := UInt32))).mapM (digitCode sameChar) = .ok xs := by
      intro xs
      induction xs with
      | nil => rfl
      | cons b bs ih =>
        simp only [List.map_cons, List.mapM_cons, digitCode, ih, bind, Except.bind,
          pure, Except.pure]
    exact hmap bytes
  · intro d hd a heq
    obtain ⟨b, _, hb⟩ := List.mem_map.mp hd
    rw [← hb] at heq
    cases heq
  · simpa only [List.length_map] using small

private theorem decodeStringMismatch {Array I IS : Type}
    (arr : ByteArrayOps Array I IS Error) (dest : Array) (s : Raw)
    (h : (JuliaLean.base.strings.string.stringLength s).val ≠
      (Str.stringNcodeunits s).val) :
    argumentFailureAt (decodeStringIntoG arr dest s) dest := by
  refine ⟨"input string must consist of hexadecimal characters only", ?_⟩
  simp only [decodeStringIntoG, hex2bytesString, bne_iff_ne]
  rw [if_pos (Ne.symm h)]
  rfl

private theorem decodeStringEqual {Array I IS : Type}
    (arr : ByteArrayOps Array I IS Error) (dest : Array) (s : Raw)
    (h : (JuliaLean.base.strings.string.stringLength s).val =
      (Str.stringNcodeunits s).val) :
    decodeStringIntoG arr dest s =
      hex2bytesBang arr byteIterator assertHexTuple (.jl ∘ JlError.argumentError)
        sameChar charByte true dest s.bytes := by
  simp only [decodeStringIntoG, hex2bytesString, h, bne_self_eq_false, Bool.false_eq_true,
    ↓reduceIte, JuliaLean.base.strings.cstring.transcodeStringCodeUnits]
  rfl

theorem batch1HexStringDecodeArray :
    ∀ {Array I IS : Type} (arr : ByteArrayOps Array I IS Error) (dest : Array) (s : Raw)
      (destLen : Index) (idxs : List I),
    arr.length.run dest = .ok destLen dest →
    PureIndices arr dest idxs → idxs.length = destLen.val.toNat →
    0 ≤ destLen.val → destLen.val < 2 ^ 62 →
    ((JuliaLean.base.strings.string.stringLength s).val ≠ (Str.stringNcodeunits s).val →
      argumentFailureAt (decodeStringIntoG arr dest s) dest) ∧
    ((JuliaLean.base.strings.string.stringLength s).val = (Str.stringNcodeunits s).val →
      2 * destLen.val = Int.ofNat s.bytes.length →
      match (writesM arr idxs (decodePairs s.bytes).1).run dest with
      | .ok _ d => ((decodePairs s.bytes).2 = false → decodeStringIntoG arr dest s = some (.ok d d)) ∧
          ((decodePairs s.bytes).2 = true → argumentFailureAt (decodeStringIntoG arr dest s) d)
      | .error e d => decodeStringIntoG arr dest s = some (.error e d)) := by
  intro Array I IS arr dest s destLen idxs hl hi hn hnonneg hsmall
  refine ⟨decodeStringMismatch arr dest s, ?_⟩
  intro heq hlen
  rw [decodeStringEqual arr dest s heq]
  have h := (Round6.hexDecodeLengths_proven arr byteIterator sameChar dest s.bytes
    (s.bytes.map HexDigit.byte) s.bytes destLen idxs
    (byteHexInput s.bytes s.small) hl hi hn hnonneg hsmall).2.2
  have h' := h (by simpa only [List.length_map] using hlen)
  cases hr : (writesM arr idxs (decodePairs s.bytes).1).run dest <;>
    simpa only [hr] using h'

private theorem hexStorePreservesString (dest : HexStorage)
    (p : JuliaLean.base.pointer.Ptr JuliaLean.base.pointer.Byte) (b : UInt8) (i : Index) :
    ∃ out, storeHexDigit dest p b i = .ok out ∧ out.1 = dest.1 := by
  refine ⟨(dest.1, (JuliaLean.base.pointer.pointerSet byteCodec dest.2 p
    (JInt.lit .u8 b.toNat) i JuliaLean.base.pointer.oneI64).1), ?_, rfl⟩
  rfl

private theorem hexStoreListPreservesString (allocString : Nat → Result Raw)
    (p : JuliaLean.base.pointer.Ptr JuliaLean.base.pointer.Byte)
    (entries : List (Index × UInt8)) (dest : HexStorage) :
    ∃ out,
      bytes2hexStore (encodingOpsWith true allocString) p (iterStepsOfList () entries) dest =
        .ok out ∧ out.1 = dest.1 := by
  induction entries generalizing dest with
  | nil => exact ⟨dest, rfl, rfl⟩
  | cons pair entries ih =>
    obtain ⟨high, hh, hs⟩ := hexStorePreservesString dest p
      ((encodingOpsWith true allocString).hexChar (hexHighIndex pair.2))
      (int 2 * pair.1 - int 1)
    obtain ⟨low, hl, ls⟩ := hexStorePreservesString high p
      ((encodingOpsWith true allocString).hexChar (hexLowIndex pair.2))
      (int 2 * pair.1)
    obtain ⟨out, ho, os⟩ := ih low
    refine ⟨out, ?_, os.trans (ls.trans hs)⟩
    change (storeHexDigit dest p
      ((encodingOpsWith true allocString).hexChar (hexHighIndex pair.2))
      (int 2 * pair.1 - int 1)).bind (fun high =>
        (storeHexDigit high p
          ((encodingOpsWith true allocString).hexChar (hexLowIndex pair.2))
          (int 2 * pair.1)).bind (fun low =>
            bytes2hexStore (encodingOpsWith true allocString) p
              (iterStepsOfList () entries) low)) = .ok out
    rw [hh]
    change (storeHexDigit high p _ _).bind _ = .ok out
    rw [hl]
    exact ho

private theorem hexCallTrue {Itr State S P E : Type} (ops : Bytes2HexOps Itr State S P E)
    (itr : Itr) (h : ops.isUInt8Iterator itr = true) :
    bytes2hex ops itr =
      (ops.allocate (int 2 * ops.length itr)).bind (fun str =>
        bytes2hexStore ops (ops.pointer str) (ops.enumerate itr) str) := by
  simp only [bytes2hex, h, Bool.not_true, Bool.false_eq_true, ↓reduceIte,
    pure, Except.pure, bind, Except.bind]


/-- These local notations name the existing private loops in the pinned source module. -/
local macro "hexOriginalSeek" : term =>
  pure (Lean.mkIdent (Lean.mkPrivateNameCore `JuliaLean.base.strings.string
    `JuliaLean.base.strings.string.lengthSeekLead))
local macro "hexOriginalCount" : term =>
  pure (Lean.mkIdent (Lean.mkPrivateNameCore `JuliaLean.base.strings.string
    `JuliaLean.base.strings.string.lengthCountLoop))

private abbrev hexLengthSeek {S : Type} (codeunit : S → Index → UInt8)
    (s : S) (n : Index) (fuel : Nat) (i : Index) (b : UInt8) :=
  hexOriginalSeek codeunit s n fuel i b

private abbrev hexLengthCount {S : Type} (codeunit : S → Index → UInt8)
    (s : S) (n : Index) (fuel : Nat) (i : Index) (b : UInt8) (c : Index) :=
  hexOriginalCount codeunit s n fuel i b c

private theorem hexLengthSeek_step {S : Type} (codeunit : S → Index → UInt8)
    (s : S) (n : Index) (fuel : Nat) (i : Index) (b : UInt8) :
    hexLengthSeek codeunit s n (fuel + 1) i b =
      (let i := i + JuliaLean.Strings.ix 1
       if i.val > n.val then none
       else if 0xc0 ≤ b && b ≤ 0xf7 then some (i, b)
       else hexLengthSeek codeunit s n fuel i (codeunit s i)) := by
  rfl

private theorem hexLengthCount_step {S : Type} (codeunit : S → Index → UInt8)
    (s : S) (n : Index) (fuel : Nat) (i : Index) (b : UInt8) (count : Index) :
    hexLengthCount codeunit s n (fuel + 1) i b count =
      (match hexLengthSeek codeunit s n fuel i b with
      | none => count
      | some (i, lead) =>
          let b := codeunit s i
          let firstIsContinuation := JuliaLean.base.strings.string.isValidContinuation b
          let count := count - JuliaLean.base.strings.string.stringIndexBool firstIsContinuation
          if !(firstIsContinuation && lead ≥ 0xe0) then
            hexLengthCount codeunit s n fuel i b count
          else
            let i := i + JuliaLean.Strings.ix 1
            if i.val > n.val then count
            else
              let b := codeunit s i
              let secondIsContinuation := JuliaLean.base.strings.string.isValidContinuation b
              let count := count - JuliaLean.base.strings.string.stringIndexBool secondIsContinuation
              if !(secondIsContinuation && lead ≥ 0xf0) then
                hexLengthCount codeunit s n fuel i b count
              else
                let i := i + JuliaLean.Strings.ix 1
                if i.val > n.val then count
                else
                  let b := codeunit s i
                  hexLengthCount codeunit s n fuel i b
                    (count - JuliaLean.base.strings.string.stringIndexBool
                      (JuliaLean.base.strings.string.isValidContinuation b))) := by
  rfl

private theorem hexGetDAscii (xs : List UInt8) (h : ∀ b ∈ xs, b.toNat < 128) (k : Nat) :
    (xs.getD k 0).toNat < 128 := by
  induction xs generalizing k with
  | nil => simp only [List.getD_nil]; decide
  | cons b bs ih =>
    cases k with
    | zero => exact h b (by simp only [List.mem_cons, true_or])
    | succ k =>
      exact ih (fun b hb => h b (List.mem_cons_of_mem _ hb)) k

private theorem hexLengthSeekAscii {S : Type} (codeunit : S → Index → UInt8)
    (s : S) (n : Index) (hall : ∀ i, (codeunit s i).toNat < 128)
    (fuel : Nat) (i : Index) (b : UInt8) (hb : b.toNat < 128) :
    hexLengthSeek codeunit s n fuel i b = none := by
  induction fuel generalizing i b with
  | zero => rfl
  | succ fuel ih =>
    have hn : ¬ (0xc0 : UInt8) ≤ b := by
      intro h
      have h' := UInt8.le_iff_toNat_le.mp h
      change 192 ≤ b.toNat at h'
      omega
    rw [hexLengthSeek_step]
    simp only [hn, decide_false, Bool.false_and, Bool.false_eq_true,
      ↓reduceIte]
    split
    · rfl
    · exact ih _ _ (hall _)

private theorem hexLengthCountAscii {S : Type} (codeunit : S → Index → UInt8)
    (s : S) (n : Index) (hall : ∀ i, (codeunit s i).toNat < 128)
    (fuel : Nat) (i : Index) (b : UInt8) (c : Index) (hb : b.toNat < 128) :
    hexLengthCount codeunit s n fuel i b c = c := by
  cases fuel with
  | zero => rfl
  | succ fuel =>
    rw [hexLengthCount_step, hexLengthSeekAscii codeunit s n hall fuel i b hb]

private theorem hexLengthContinuedModel {S : Type} (codeunit : S → Index → UInt8)
    (s : S) (i n c : Index) :
    JuliaLean.base.strings.string.lengthContinuedInternal codeunit s i n c =
      (if !(i.val < n.val) then c
       else hexLengthCount codeunit s n (n.val - i.val + 1).toNat i (codeunit s i) c) := by
  rfl

theorem batch1StringLengthAscii (s : Raw) (hascii : ∀ b ∈ s.bytes, b.toNat < 128) :
    JuliaLean.base.strings.string.stringLength s = Str.stringNcodeunits s := by
  let codeunit := JuliaLean.base.strings.string.stringByteAt
  have hall : ∀ i, (codeunit s i).toNat < 128 := by
    intro i
    exact hexGetDAscii s.bytes hascii _
  unfold JuliaLean.base.strings.string.stringLength JuliaLean.base.strings.string.lengthString
    JuliaLean.base.strings.string.lengthContinuedString
  rw [hexLengthContinuedModel]
  split
  · rfl
  · exact hexLengthCountAscii codeunit s _ hall _ _ _ _ (hall _)

private theorem hexDecodedPairSpec {codes expected : List UInt8}
    (h : hexadecimalValue codes = some expected) : decodePairs codes = (expected, false) := by
  have hlen := hexadecimalValue_length h
  have heven : codes.length % 2 = 0 := by omega
  have hv := decodePairs_correct codes heven
  cases hp : decodePairs codes with
  | mk bytes failed =>
    cases failed with
    | false =>
      rw [hp, h] at hv
      cases hv
      rfl
    | true => simp only [hp, h, reduceCtorEq] at hv

private theorem byteWritesAll (dest expected : List UInt8)
    (hlen : dest.length = expected.length) (small : dest.length < 2 ^ 62) :
    (writesM byteArrayOps
      ((List.range dest.length).map (fun k => int (Int.ofNat k + 1))) expected).run dest =
      .ok () expected := by
  let idxs := (List.range dest.length).map (fun k => int (Int.ofNat k + 1))
  have hidx : idxs.length = expected.length := by simp only [idxs, List.length_map,
    List.length_range, hlen]
  have slots : ∀ k (hk : k < idxs.length), (idxs[k]).val =
      Int.ofNat ([] : List UInt8).length + Int.ofNat k + 1 := by
    intro k hk
    have hk' : k < dest.length := by simpa only [idxs, List.length_map, List.length_range] using hk
    simp only [idxs, List.getElem_map, List.getElem_range]
    change (int ((k : Int) + 1)).val = 0 + (k : Int) + 1
    rw [hexIntVal _ (by omega) (by omega)]
    omega
  simpa only [List.nil_append] using byteWrites_correct expected idxs [] dest hidx hlen slots

theorem StringutilHexStringDecoder_proven : Round6.HexStringDecode := by
  refine ⟨batch1HexStringDecodeArray, ?_⟩
  intro s dest expected hascii hlen hdecode
  have hlenExpected := hexadecimalValue_length hdecode
  have hdest : dest.length = expected.length := by omega
  have hsmall : dest.length < 2 ^ 62 := by have := s.small; omega
  have hval : (int dest.length).val = (dest.length : Int) :=
    hexIntVal _ (by omega) (by omega)
  have heq : (JuliaLean.base.strings.string.stringLength s).val =
      (Str.stringNcodeunits s).val := congrArg Subtype.val (batch1StringLengthAscii s hascii)
  have hresult := (batch1HexStringDecodeArray byteArrayOps dest s (int dest.length)
    ((List.range dest.length).map (fun k => int (Int.ofNat k + 1)))
    rfl (bytePureIndices dest) (by simp only [List.length_map, List.length_range, hval,
      Int.toNat_natCast]) (by omega) (by omega)).2 heq (by
        rw [hval]; simp only [Int.ofNat_eq_natCast]; omega)
  rw [hexDecodedPairSpec hdecode, byteWritesAll dest expected hdest hsmall] at hresult
  exact hresult.1 rfl

private theorem mapM_length {A B E : Type} (f : A → Except E B)
    {xs : List A} {ys : List B} (h : xs.mapM f = .ok ys) : xs.length = ys.length := by
  induction xs generalizing ys with
  | nil => cases h; rfl
  | cons x xs ih =>
    cases hx : f x with
    | error e => simp [List.mapM_cons, hx] at h
    | ok y =>
      cases hxs : xs.mapM f with
      | error e => simp [List.mapM_cons, hx, hxs] at h
      | ok rest =>
        have heq : ys = y :: rest := by simpa [List.mapM_cons, hx, hxs] using h.symm
        subst ys
        simpa using congrArg Nat.succ (ih hxs)


private theorem byteWritesPrefix :
    ∀ (bytes : List UInt8) (idxs : List Index) (before old after : List UInt8),
    bytes.length ≤ idxs.length → old.length = bytes.length →
    (∀ k (hk : k < idxs.length), (idxs[k]).val = Int.ofNat before.length + Int.ofNat k + 1) →
    (writesM byteArrayOps idxs bytes).run (before ++ old ++ after) =
      .ok () (before ++ bytes ++ after) := by
  intro bytes
  induction bytes with
  | nil =>
    intro idxs before old after hi ho slots
    have hold : old = [] := List.eq_nil_of_length_eq_zero ho
    subst old
    simp only [writesM, List.zip_nil_right]
    rfl
  | cons b bs ih =>
    intro idxs before old after hi ho slots
    cases idxs with
    | nil => simp only [List.length_cons, List.length_nil] at hi; omega
    | cons i idxs =>
      cases old with
      | nil => simp only [List.length_cons, List.length_nil] at ho; omega
      | cons oldHead old =>
        have hindex := slots 0 (by simp only [List.length_cons]; omega)
        change i.val = (before.length : Int) + 0 + 1 at hindex
        have hbound : 1 ≤ i.val ∧ i.val ≤ Int.ofNat (before ++ oldHead :: old ++ after).length := by
          simp only [Int.ofNat_eq_natCast, List.length_append, List.length_cons, Int.natCast_add]
          omega
        have hset := byteArraySet_ok (before ++ oldHead :: old ++ after) i b hbound
        have hslot : i.val.toNat - 1 = before.length := by omega
        rw [hslot] at hset
        have hset' : (byteArrayOps.set i b).run (before ++ oldHead :: old ++ after) =
            .ok () (before ++ b :: old ++ after) := by
          simpa only [List.append_assoc, List.cons_append, setAppendHead] using hset
        have htail := ih idxs (before ++ [b]) old after (by
          simp only [List.length_cons] at hi; omega) (by
            simp only [List.length_cons] at ho; omega)
          (by
            intro k hk
            have hv := slots (k + 1) (by simp only [List.length_cons]; omega)
            change (idxs[k]).val = (before.length : Int) + ((k + 1 : Nat) : Int) + 1 at hv
            simp only [Int.ofNat_eq_natCast, List.length_append, List.length_singleton, Int.natCast_add]
            omega)
        simp only [writesM, List.zip_cons_cons, List.forM, Bind.bind, EStateM.bind,
          EStateM.run] at hset' htail ⊢
        rw [hset']
        simpa only [List.append_assoc, List.singleton_append] using htail

private theorem byteWritesSuccess (dest bytes : List UInt8)
    (hlen : bytes.length ≤ dest.length) (small : dest.length < 2 ^ 62) :
    ∃ d, (writesM byteArrayOps
      ((List.range dest.length).map (fun k => int (Int.ofNat k + 1))) bytes).run dest = .ok () d := by
  let idxs := (List.range dest.length).map (fun k => int (Int.ofNat k + 1))
  have hidx : bytes.length ≤ idxs.length := by
    simpa only [idxs, List.length_map, List.length_range] using hlen
  have slots : ∀ k (hk : k < idxs.length), (idxs[k]).val =
      Int.ofNat ([] : List UInt8).length + Int.ofNat k + 1 := by
    intro k hk
    have hk' : k < dest.length := by simpa only [idxs, List.length_map, List.length_range] using hk
    simp only [idxs, List.getElem_map, List.getElem_range]
    change (int ((k : Int) + 1)).val = 0 + (k : Int) + 1
    rw [hexIntVal _ (by omega) (by omega)]
    omega
  have h := byteWritesPrefix bytes idxs [] (dest.take bytes.length) (dest.drop bytes.length)
    hidx (by simp only [List.length_take, Nat.min_eq_left hlen]) slots
  refine ⟨bytes ++ dest.drop bytes.length, ?_⟩
  simpa only [List.nil_append, List.take_append_drop] using h

private theorem decodePairsLength (codes : List UInt8) :
    2 * (decodePairs codes).1.length ≤ codes.length := by
  induction codes using hexadecimalValue.induct with
  | case1 => decide
  | case2 b => change 0 ≤ 1; decide
  | case3 a b rest ih =>
    cases ha : hexNibble a <;> cases hb : hexNibble b <;>
      simp only [decodePairs, ha, hb, List.length_cons, List.length_nil]
    · omega
    · omega
    · omega
    · cases hp : decodePairs rest with
      | mk bs failed =>
        simp only [hp, List.length_cons] at ih ⊢
        omega

private theorem hexShiftOne (n : Nat) (small : n < 2 ^ 62) :
    (JuliaLean.base.int.shr_Int (int n) (int 1)).val = (n : Int) / 2 := by
  have h := (JuliaLean.Proofs.base.int.shiftIntCount_proven .i64 (int n) (int 1)).1
  have hone : (int 1).val = 1 := by decide
  rw [hone, hexIntVal _ (by omega) (by omega)] at h
  have hpow : (2 : Int) ^ (1 : Int).toNat = 2 := by decide
  simpa only [show (0 : Int) ≤ 1 by decide, ↓reduceIte, hpow] using h

private theorem genericHexBangCorrect {Itr A St : Type}
    (it : HexIteratorOps Itr A UInt32 St Error) (toChar : A → Result UInt32)
    (itr : Itr) (digits : List (HexDigit A UInt32)) (codes dest : List UInt8)
    (input : HexInput it toChar itr digits codes)
    (hsize : dest.length = digits.length / 2) :
    match hexadecimalValue codes with
    | none => ∃ d, argumentFailureAt
        (hex2bytesBang byteArrayOps it assertHexTuple (.jl ∘ JlError.argumentError)
          toChar charByte true dest itr) d
    | some expected => hex2bytesBang byteArrayOps it assertHexTuple
        (.jl ∘ JlError.argumentError) toChar charByte true dest itr = some (.ok expected expected) := by
  have hlength : digits.length = codes.length := mapM_length (digitCode toChar) input.converts
  have hsmall : dest.length < 2 ^ 62 := by have := input.small; omega
  have hval : (int dest.length).val = (dest.length : Int) :=
    hexIntVal _ (by omega) (by omega)
  let idxs := (List.range dest.length).map (fun k => int (Int.ofNat k + 1))
  have hidx : idxs.length = (int dest.length).val.toNat := by
    simp only [idxs, List.length_map, List.length_range, hval, Int.toNat_natCast]
  have hspec := Round6.hexDecodeLengths_proven byteArrayOps it toChar dest itr digits codes
    (int dest.length) idxs input rfl (bytePureIndices dest) hidx (by omega) (by omega)
  cases hd : hexadecimalValue codes with
  | some expected =>
    have hbytes := hexadecimalValue_length hd
    have heq : dest.length = expected.length := by omega
    have hmatch : 2 * (int dest.length).val = Int.ofNat digits.length := by
      rw [hval]; simp only [Int.ofNat_eq_natCast]; omega
    have h := hspec.2.2 hmatch
    rw [hexDecodedPairSpec hd] at h
    rw [byteWritesAll dest expected heq hsmall] at h
    exact h.1 rfl
  | none =>
    by_cases hodd : digits.length % 2 ≠ 0
    · exact ⟨dest, hspec.1 hodd⟩
    · have heven : digits.length % 2 = 0 := by omega
      have hmatch : 2 * (int dest.length).val = Int.ofNat digits.length := by
        rw [hval]; simp only [Int.ofNat_eq_natCast]; omega
      have hprefix : (decodePairs codes).1.length ≤ dest.length := by
        have := decodePairsLength codes
        omega
      obtain ⟨d, hdwrite⟩ := byteWritesSuccess dest (decodePairs codes).1 hprefix hsmall
      have h := hspec.2.2 hmatch
      rw [hdwrite] at h
      have hfail : (decodePairs codes).2 = true := by
        have hpair := decodePairs_correct codes (by omega)
        cases hp : decodePairs codes with
        | mk bs failed =>
          cases failed with
          | false => simp only [hp, hd, reduceCtorEq] at hpair
          | true => rfl
      exact ⟨d, h.2 hfail⟩

private theorem hexNibbleAscii (b : UInt8) (n : Nat) (h : hexNibble b = some n) :
    b.toNat < 128 := by
  unfold hexNibble at h
  split at h
  · omega
  · split at h
    · omega
    · split at h
      · omega
      · cases h

private theorem hexadecimalValueAscii {codes expected : List UInt8}
    (h : hexadecimalValue codes = some expected) : ∀ b ∈ codes, b.toNat < 128 := by
  induction codes using hexadecimalValue.induct generalizing expected with
  | case1 => intro b hb; cases hb
  | case2 b => simp only [hexadecimalValue, reduceCtorEq] at h
  | case3 a b rest ih =>
    cases ha : hexNibble a <;> cases hb : hexNibble b <;>
      cases hr : hexadecimalValue rest <;>
      simp only [hexadecimalValue, ha, hb, hr, bind, Option.bind, pure, Pure.pure,
        reduceCtorEq] at h
    rename_i hi lo tail
    intro c hc
    rcases List.mem_cons.mp hc with hc | hc
    · subst c; exact hexNibbleAscii a hi ha
    · rcases List.mem_cons.mp hc with hc | hc
      · subst c; exact hexNibbleAscii b lo hb
      · exact ih hr c hc

private theorem hexAsciiGeneric (alloc : Index → Result (List UInt8)) :
    ∀ {Itr A St : Type} (it : HexIteratorOps Itr A UInt32 St Error)
      (toChar : A → Result UInt32) (itr : Itr) (digits : List (HexDigit A UInt32))
      (codes : List UInt8), HexInput it toChar itr digits codes →
      let n := JuliaLean.base.int.shr_Int (int digits.length) (int 1)
      (∀ e, alloc n = .error e → allocatingDecodeG alloc it toChar itr = some (.error e)) ∧
      (∀ d, alloc n = .ok d → d.length = n.val.toNat →
        match hexadecimalValue codes with
        | none => argumentFailureOpt (allocatingDecodeG alloc it toChar itr)
        | some expected => allocatingDecodeG alloc it toChar itr = some (.ok expected)) := by
  intro Itr A St it toChar itr digits codes input
  have hn : (JuliaLean.base.int.shr_Int (int digits.length) (int 1)).val.toNat =
      digits.length / 2 := by
    rw [hexShiftOne digits.length input.small]
    omega
  constructor
  · intro e he
    simp only [allocatingDecodeG, input.length, hex2bytesWrapper, he, partialBind]
  · intro dest ha hd
    have hsize : dest.length = digits.length / 2 := hd.trans hn
    have h := genericHexBangCorrect it toChar itr digits codes dest input hsize
    cases hc : hexadecimalValue codes with
    | none =>
      rw [hc] at h
      obtain ⟨d, message, hm⟩ := h
      refine ⟨message, ?_⟩
      simp only [allocatingDecodeG, input.length, hex2bytesWrapper, ha, partialBind, hm]
    | some expected =>
      rw [hc] at h
      simp only [allocatingDecodeG, input.length, hex2bytesWrapper, ha, partialBind, h]

private theorem hexNcodeunitsIndex (s : Raw) : Str.stringNcodeunits s = int s.bytes.length := by
  rfl

private theorem hexHalfLengthEqual (n : Index) (len : Nat) (hsmall : len < 2 ^ 62)
    (h : n = int len) :
    (JuliaLean.base.int.shr_Int n (int 1)).val.toNat = len / 2 := by
  rw [h, hexShiftOne len hsmall]
  omega

private theorem hexStringAllocationError (alloc : Index → Result (List UInt8)) (s : Raw)
    (e : Error)
    (ha : alloc (JuliaLean.base.int.shr_Int (JuliaLean.base.strings.string.stringLength s)
      (int 1)) = .error e) :
    hexStringCallWith alloc s = some (.error e) := by
  simp only [hexStringCallWith, hex2bytesWrapper, ha, partialBind]

private theorem hexWrapperDecodeError {A S E : Type} (length : S → Index)
    (shift : Index → Index) (alloc : Index → Except E A)
    (decode : A → S → Option (EStateM.Result E A A))
    (s : S) (dest after : A) (e : E)
    (ha : alloc (shift (length s)) = .ok dest)
    (hd : decode dest s = some (.error e after)) :
    hex2bytesWrapper length shift alloc decode s = some (.error e) := by
  simp only [hex2bytesWrapper, ha, partialBind, hd]

private theorem hexWrapperDecodeOk {A S E : Type} (length : S → Index)
    (shift : Index → Index) (alloc : Index → Except E A)
    (decode : A → S → Option (EStateM.Result E A A))
    (s : S) (dest out after : A)
    (ha : alloc (shift (length s)) = .ok dest)
    (hd : decode dest s = some (.ok out after)) :
    hex2bytesWrapper length shift alloc decode s = some (.ok out) := by
  simp only [hex2bytesWrapper, ha, partialBind, hd]

private theorem hexStringDecodeError (alloc : Index → Result (List UInt8)) (s : Raw)
    (dest after : List UInt8) (e : Error)
    (ha : alloc (JuliaLean.base.int.shr_Int (JuliaLean.base.strings.string.stringLength s)
      (int 1)) = .ok dest)
    (hd : decodeStringIntoG byteArrayOps dest s = some (.error e after)) :
    hexStringCallWith alloc s = some (.error e) := by
  exact hexWrapperDecodeError JuliaLean.base.strings.string.stringLength
    (fun n => JuliaLean.base.int.shr_Int n (int 1)) alloc (decodeStringIntoG byteArrayOps)
    s dest after e ha hd

private theorem hexStringDecodeOk (alloc : Index → Result (List UInt8)) (s : Raw)
    (dest out after : List UInt8)
    (ha : alloc (JuliaLean.base.int.shr_Int (JuliaLean.base.strings.string.stringLength s)
      (int 1)) = .ok dest)
    (hd : decodeStringIntoG byteArrayOps dest s = some (.ok out after)) :
    hexStringCallWith alloc s = some (.ok out) := by
  exact hexWrapperDecodeOk JuliaLean.base.strings.string.stringLength
    (fun n => JuliaLean.base.int.shr_Int n (int 1)) alloc (decodeStringIntoG byteArrayOps)
    s dest out after ha hd

private theorem hexAsciiString (alloc : Index → Result (List UInt8)) :
    ∀ s : Raw,
      let n := JuliaLean.base.int.shr_Int (JuliaLean.base.strings.string.stringLength s) (int 1)
      (∀ e, alloc n = .error e → hexStringCallWith alloc s = some (.error e)) ∧
      (∀ d, alloc n = .ok d → d.length = n.val.toNat →
        match hexadecimalValue s.bytes with
        | none => argumentFailureOpt (hexStringCallWith alloc s)
        | some expected => hexStringCallWith alloc s = some (.ok expected)) := by
  intro s
  constructor
  · intro e he
    exact hexStringAllocationError alloc s e he
  · intro dest ha hd
    by_cases heq : (JuliaLean.base.strings.string.stringLength s).val =
        (Str.stringNcodeunits s).val
    · have heqIndex : JuliaLean.base.strings.string.stringLength s = Str.stringNcodeunits s :=
        Subtype.ext heq
      have hindex : JuliaLean.base.strings.string.stringLength s = int s.bytes.length :=
        heqIndex.trans (hexNcodeunitsIndex s)
      have hn : (JuliaLean.base.int.shr_Int
          (JuliaLean.base.strings.string.stringLength s) (int 1)).val.toNat =
          s.bytes.length / 2 := hexHalfLengthEqual _ _ s.small hindex
      have hsize : dest.length = (s.bytes.map (HexDigit.byte (A := UInt32) (C := UInt32))).length / 2 := by
        simpa only [List.length_map] using hd.trans hn
      have h := genericHexBangCorrect byteIterator sameChar s.bytes
        (s.bytes.map HexDigit.byte) s.bytes dest (byteHexInput s.bytes s.small) hsize
      have hdstring := decodeStringEqual byteArrayOps dest s heq
      cases hc : hexadecimalValue s.bytes with
      | none =>
        rw [hc] at h
        obtain ⟨d, message, hm⟩ := h
        refine ⟨message, ?_⟩
        exact hexStringDecodeError alloc s dest d _ ha (hdstring.trans hm)
      | some expected =>
        rw [hc] at h
        exact hexStringDecodeOk alloc s dest expected expected ha (hdstring.trans h)
    · have hm := decodeStringMismatch byteArrayOps dest s heq
      obtain ⟨message, hm⟩ := hm
      cases hc : hexadecimalValue s.bytes with
      | none =>
        refine ⟨message, ?_⟩
        exact hexStringDecodeError alloc s dest dest _ ha hm
      | some expected =>
        exact False.elim (heq (congrArg Subtype.val
          (batch1StringLengthAscii s (hexadecimalValueAscii hc))))

theorem StringutilHex2bytesAscii_proven : Round6.Hex2bytesAsciiContract := by
  intro alloc
  exact ⟨hexAsciiGeneric alloc, hexAsciiString alloc⟩

private theorem hexReadLength (heap : JuliaLean.base.pointer.ByteHeap) (base n : Nat) :
    (heap.readBytes base n).length = n := by
  induction n generalizing base with
  | zero => rfl
  | succ n ih => simp only [JuliaLean.base.pointer.ByteHeap.readBytes, List.length_cons, ih]

private theorem hexReadGet (heap : JuliaLean.base.pointer.ByteHeap) (base n k : Nat)
    (hk : k < n) :
    (heap.readBytes base n)[k]'(by rw [hexReadLength]; exact hk) = heap.readByte (base + k) := by
  induction n generalizing base k with
  | zero => omega
  | succ n ih =>
    cases k with
    | zero => rfl
    | succ k =>
      simpa only [JuliaLean.base.pointer.ByteHeap.readBytes, List.getElem_cons_succ,
        Nat.add_assoc, Nat.add_comm 1 k] using ih (base + 1) k (by omega)

private theorem hexReadWrite (heap : JuliaLean.base.pointer.ByteHeap) (n k : Nat) (b : UInt8)
    (hn : n < 2 ^ 62) (hk : k < n) :
    ((heap.writeByte k (JInt.lit .u8 b.toNat)).readBytes 0 n).map
      (fun v => UInt8.ofNat v.val.toNat) =
    ((heap.readBytes 0 n).map (fun v => UInt8.ofNat v.val.toNat)).set k b := by
  apply List.ext_getElem
  · simp only [List.length_map, List.length_set, hexReadLength]
  · intro j hj hj'
    have hjn : j < n := by simpa only [List.length_map, hexReadLength] using hj
    rw [List.getElem_map, List.getElem_set]
    rw [hexReadGet _ _ n j hjn]
    simp only [List.getElem_map, hexReadGet, Nat.zero_add]
    have hj64 : j < 2 ^ 64 := by omega
    have hk64 : k < 2 ^ 64 := by omega
    have hv : (JInt.lit .u8 b.toNat).val = (b.toNat : Int) := by
      change wrapInt .u8 b.toNat = (b.toNat : Int)
      apply wrapInt_of_inRange
      have hb : b.toNat < 256 := b.toFin.isLt
      change 0 ≤ (b.toNat : Int) ∧ (b.toNat : Int) ≤ 255
      omega
    by_cases heq : k = j
    · subst k
      simp only [JuliaLean.base.pointer.ByteHeap.readByte, JuliaLean.base.pointer.ByteHeap.writeByte,
        JuliaLean.base.pointer.addressMod, Nat.mod_eq_of_lt hj64, beq_self_eq_true,
        ↓reduceIte, hv, Int.toNat_natCast, UInt8.ofNat_toNat]
    · have hne : j ≠ k := Ne.symm heq
      simp only [JuliaLean.base.pointer.ByteHeap.readByte, JuliaLean.base.pointer.ByteHeap.writeByte,
        JuliaLean.base.pointer.addressMod, Nat.mod_eq_of_lt hj64, Nat.mod_eq_of_lt hk64,
        beq_iff_eq, hne, heq, ↓reduceIte]
      rw [hexReadGet heap 0 n j hjn]
      simp only [JuliaLean.base.pointer.ByteHeap.readByte, JuliaLean.base.pointer.addressMod,
        Nat.zero_add, Nat.mod_eq_of_lt hj64]

private abbrev hexZeroPtr : JuliaLean.base.pointer.Ptr JuliaLean.base.pointer.Byte :=
  ⟨JInt.lit .u64 0⟩

private theorem hexPointerAt (i : Index) (hlo : 1 ≤ i.val) (hhi : i.val < 2 ^ 62) :
    (JuliaLean.base.pointer.indexedPointer byteCodec hexZeroPtr i).address.val.toNat =
      i.val.toNat - 1 := by
  have hs : wrapInt .i64 (i.val - 1) = i.val - 1 := by
    apply wrapInt_of_inRange
    change -9223372036854775808 ≤ i.val - 1 ∧ i.val - 1 ≤ 9223372036854775807
    omega
  have hu : wrapInt .u64 (i.val - 1) = i.val - 1 := by
    apply wrapInt_of_inRange
    change 0 ≤ i.val - 1 ∧ i.val - 1 ≤ 18446744073709551615
    omega
  change (wrapInt .u64 (0 + wrapInt .u64 (wrapInt .i64 (1 * wrapInt .i64 (i.val - 1))))).toNat = _
  rw [hs, Int.one_mul, hs, hu, Int.zero_add, hu]
  omega

private theorem hexStoreAt (dest : HexStorage) (b : UInt8) (i : Index)
    (hlo : 1 ≤ i.val) (hhi : i.val < 2 ^ 62) :
    storeHexDigit dest hexZeroPtr b i =
      .ok (dest.1, dest.2.writeByte (i.val.toNat - 1) (JInt.lit .u8 b.toNat)) := by
  change Except.ok (dest.1, dest.2.writeByte
    (JuliaLean.base.pointer.indexedPointer byteCodec hexZeroPtr i).address.val.toNat
    (JInt.lit .u8 b.toNat)) = _
  rw [hexPointerAt i hlo hhi]

private theorem hexStoreLaw (dest : HexStorage) (i : Index) (b : UInt8)
    (before : List UInt8) (old : UInt8) (after : List UInt8)
    (hs : storedBytes dest = before ++ old :: after)
    (hi : i.val = Int.ofNat before.length + 1) :
    ∃ out, storeHexDigit dest hexZeroPtr b i = .ok out ∧
      storedBytes out = before ++ b :: after := by
  simp only [Int.ofNat_eq_natCast] at hi
  have hlen : dest.1.bytes.length = before.length + 1 + after.length := by
    have h := congrArg List.length hs
    simpa only [storedBytes, List.length_map, hexReadLength, List.length_append,
      List.length_cons, Nat.add_assoc, Nat.add_comm 1 after.length] using h
  have hb : before.length < dest.1.bytes.length := by omega
  have hsmall := dest.1.small
  have hlo : 1 ≤ i.val := by omega
  have hhi : i.val < 2 ^ 62 := by omega
  have hindex : i.val.toNat - 1 = before.length := by omega
  refine ⟨(dest.1, dest.2.writeByte before.length (JInt.lit .u8 b.toNat)), ?_, ?_⟩
  · rw [hexStoreAt dest b i hlo hhi, hindex]
  · change ((dest.2.writeByte before.length (JInt.lit .u8 b.toNat)).readBytes 0
        dest.1.bytes.length).map (fun v => UInt8.ofNat v.val.toNat) = _
    rw [hexReadWrite dest.2 _ _ b hsmall hb]
    change (storedBytes dest).set before.length b = _
    rw [hs, setAppendHead]

private theorem utilHexTable (b : UInt8) :
    JuliaLean.base.char.hex_chars.getD ((hexHighIndex b).val.toNat - 1) 0 =
      lowerHexDigit (b.toNat / 16) ∧
    JuliaLean.base.char.hex_chars.getD ((hexLowIndex b).val.toNat - 1) 0 =
      lowerHexDigit (b.toNat % 16) := by
  have hb := b.toFin.isLt
  have hh : (hexHighIndex b).val = 1 + (b >>> 4).toNat := by
    have h : (b >>> 4).toNat < 256 := (b >>> 4).toFin.isLt
    apply hexIntVal <;> omega
  have hl : (hexLowIndex b).val = 1 + (b &&& 0xf).toNat := by
    have h : (b &&& 0xf).toNat < 256 := (b &&& 0xf).toFin.isLt
    apply hexIntVal <;> omega
  rw [hh, hl]
  have all : ∀ n : Fin 256,
      JuliaLean.base.char.hex_chars.getD ((1 + (UInt8.ofNat n.val >>> 4).toNat : Int).toNat - 1) 0 =
        lowerHexDigit ((UInt8.ofNat n.val).toNat / 16) ∧
      JuliaLean.base.char.hex_chars.getD ((1 + (UInt8.ofNat n.val &&& 0xf).toNat : Int).toNat - 1) 0 =
        lowerHexDigit ((UInt8.ofNat n.val).toNat % 16) := by
    decide +kernel
  simpa only [UInt8.ofNat_toNat] using all ⟨b.toNat, hb⟩


private abbrev hexUnitOps (allocString : Nat → Result Raw) :
    Bytes2HexOps (List UInt8) Unit HexStorage Unit Error where
  isUInt8Iterator _ := true
  length bytes := int bytes.length
  allocate := allocateHexStorageWith allocString
  pointer _ := ()
  enumerate bytes := iterStepsOfList () ((bytes.zipIdx).map
    (fun (b, i) => (int (Int.ofNat i + 1), b)))
  hexChar := installedHexChar
  store dest _ b i := storeHexDigit dest hexZeroPtr b i
  argumentError message := .jl (.argumentError message)

private theorem hexUnitTable (allocString : Nat → Result Raw) (b : UInt8) :
    (hexUnitOps allocString).hexChar (hexHighIndex b) = lowerHexDigit (b.toNat / 16) ∧
    (hexUnitOps allocString).hexChar (hexLowIndex b) = lowerHexDigit (b.toNat % 16) := by
  simpa only [hexUnitOps, installedHexChar] using utilHexTable b

private theorem hexUnitStoreLaw (allocString : Nat → Result Raw) (dest : HexStorage)
    (p : Unit) (i : Index) (b : UInt8) (before : List UInt8) (old : UInt8) (after : List UInt8)
    (hs : storedBytes dest = before ++ old :: after)
    (hi : i.val = Int.ofNat before.length + 1) :
    ∃ out, (hexUnitOps allocString).store dest p b i = .ok out ∧
      storedBytes out = before ++ b :: after := by
  simpa only [hexUnitOps] using hexStoreLaw dest i b before old after hs hi

private theorem hexLoopUnit (allocString : Nat → Result Raw)
    (steps : IterSteps (Index × UInt8) Unit Error) (dest : HexStorage) :
    bytes2hexStore (encodingOpsWith true allocString) hexZeroPtr steps dest =
      bytes2hexStore (hexUnitOps allocString) () steps dest := by
  induction steps generalizing dest with
  | done => rfl
  | fail e => rfl
  | yield entry st next ih =>
    simp only [bytes2hexStore, encodingOpsWith, encodingOps, hexUnitOps, installedHexChar]
    change (storeHexDigit dest hexZeroPtr _ _).bind (fun d =>
      (storeHexDigit d hexZeroPtr _ _).bind (fun d => _)) = _
    congr 1
    funext d
    congr 1
    funext d
    exact ih st d

private theorem hexEncodingUnit (allocString : Nat → Result Raw) (bytes : List UInt8) :
    bytes2hex (encodingOpsWith true allocString) bytes = bytes2hex (hexUnitOps allocString) bytes := by
  rw [hexCallTrue (encodingOpsWith true allocString) bytes rfl,
    hexCallTrue (hexUnitOps allocString) bytes rfl]
  apply congrArg (fun k => (allocateHexStorageWith allocString (int 2 * int bytes.length)).bind k)
  funext d
  exact hexLoopUnit allocString _ d

private theorem hexIterTrace (entries : List (Index × UInt8)) :
    IterStepTrace (iterStepsOfList (E := Error) () entries) entries := by
  induction entries with
  | nil => exact .done
  | cons a entries ih => exact .yield ih

private theorem hexTwiceValue (n : Nat) (hn : n < 2 ^ 62) :
    (int 2 * int n).val = 2 * (n : Int) := by
  change wrapInt .i64 ((int 2).val * (int n).val) = _
  rw [hexIntVal 2 (by omega) (by omega), hexIntVal n (by omega) (by omega)]
  apply wrapInt_of_inRange
  change -9223372036854775808 ≤ 2 * (n : Int) ∧ 2 * (n : Int) ≤ 9223372036854775807
  omega

private theorem hexSlots (bytes : List UInt8) (offset : Nat)
    (hsmall : offset + bytes.length < 2 ^ 62) :
    HexOutputSlots ((bytes.zipIdx offset).map
      (fun (b, i) => (int (Int.ofNat i + 1), b))) bytes (2 * offset) := by
  induction bytes generalizing offset with
  | nil => exact .nil
  | cons b bs ih =>
    simp only [List.zipIdx_cons, List.map_cons]
    apply HexOutputSlots.cons
    · have hv : (int 2 * int (Int.ofNat offset + 1)).val = 2 * ((offset : Int) + 1) := by
        simpa only [Int.ofNat_eq_natCast, Int.natCast_add, Int.natCast_one] using hexTwiceValue (offset + 1) (by
          simp only [List.length_cons] at hsmall; omega)
      change wrapInt .i64 ((int 2 * int (Int.ofNat offset + 1)).val - (int 1).val) = _
      rw [hv, hexIntVal 1 (by omega) (by omega)]
      rw [wrapInt_of_inRange .i64 _ (by
        change -9223372036854775808 ≤ 2 * ((offset : Int) + 1) - 1 ∧
          2 * ((offset : Int) + 1) - 1 ≤ 9223372036854775807
        simp only [List.length_cons] at hsmall; omega)]
      simp only [Int.ofNat_eq_natCast, Int.natCast_mul]
      omega
    · have hv := hexTwiceValue (offset + 1) (by simp only [List.length_cons] at hsmall; omega)
      simpa only [Int.ofNat_eq_natCast, Int.natCast_add, Int.natCast_mul, Int.natCast_one, Int.cast_ofNat_Int,
        Int.mul_add, Int.mul_one] using hv
    · have h := ih (offset + 1) (by simp only [List.length_cons] at hsmall; omega)
      have heq : 2 * (offset + 1) = 2 * offset + 2 := by omega
      rw [heq] at h
      exact h

private theorem hexAllocateNonnegative (allocString : Nat → Result Raw) (n : Index)
    (hn : 0 ≤ n.val) :
    allocateHexStorageWith allocString n =
      (allocString n.val.toNat).map (fun str =>
        (str, { byteAt := fun _ => JInt.lit .u8 0, validByte := fun _ => true })) := by
  have hnmax := n.property.2
  have hr : IntTy.u64.min ≤ n.val ∧ n.val ≤ IntTy.u64.max := by
    change n.val ≤ 9223372036854775807 at hnmax
    change 0 ≤ n.val ∧ n.val ≤ 18446744073709551615
    omega
  have hconvert : JInt.convert IntTy.u64.name .u64 n.val = .ok ⟨n.val, hr⟩ := by
    unfold JInt.convert
    exact dif_pos hr
  simp only [allocateHexStorageWith, JuliaLean.base.strings.string.stringN, hconvert,
    bind, Except.bind, pure, Except.pure]
  cases allocString n.val.toNat <;> rfl

private theorem hexAllocateExact (allocString : Nat → Result Raw) (n : Nat)
    (hsmall : n < 2 ^ 62) :
    allocateHexStorageWith allocString (int 2 * int n) =
      (allocString (2 * n)).map (fun str =>
        (str, { byteAt := fun _ => JInt.lit .u8 0, validByte := fun _ => true })) := by
  have hval := hexTwiceValue n hsmall
  have hn : (int 2 * int n).val.toNat = 2 * n := by rw [hval]; omega
  rw [hexAllocateNonnegative allocString _ (by rw [hval]; omega), hn]

private theorem hexAllocateNegative (allocString : Nat → Result Raw) (n : Index) (hn : n.val < 0) :
    allocateHexStorageWith allocString n = .error (.jl (.inexactError IntTy.u64.name)) := by
  have hr : ¬ (IntTy.u64.min ≤ n.val ∧ n.val ≤ IntTy.u64.max) := by
    change ¬ (0 ≤ n.val ∧ n.val ≤ 18446744073709551615)
    omega
  simp only [allocateHexStorageWith, JuliaLean.base.strings.string.stringN, JInt.convert,
    hr, ↓reduceDIte, bind, Except.bind]

private theorem hexLowerHexEq (bytes : List UInt8) : lowerHexBytes bytes = lowerHex bytes := by
  rfl

private theorem hexEncodingSmall (allocString : Nat → Result Raw) (bytes : List UInt8)
    (hsmall : bytes.length < 2 ^ 62) :
    (∀ str, allocString (2 * bytes.length) = .ok str → str.bytes.length = 2 * bytes.length →
      ∃ out, bytes2hex (encodingOpsWith true allocString) bytes = .ok out ∧
        storedBytes out = lowerHex bytes) ∧
    (∀ e, allocString (2 * bytes.length) = .error e →
      bytes2hex (encodingOpsWith true allocString) bytes = .error e) := by
  constructor
  · intro str halloc hlength
    have h := (JuliaLean.Proofs.base.strings.util.bytes2hexEncoding_proven
      (hexUnitOps allocString) storedBytes (hexUnitTable allocString)
      (hexUnitStoreLaw allocString)).2
    let dest : HexStorage := (str,
      { byteAt := fun _ => JInt.lit .u8 0, validByte := fun _ => true })
    have ha : (hexUnitOps allocString).allocate (int 2 * (hexUnitOps allocString).length bytes) =
        .ok dest := by
      change allocateHexStorageWith allocString (int 2 * int bytes.length) = _
      rw [hexAllocateExact allocString _ hsmall, halloc]
      rfl
    have hd : (storedBytes dest).length = 2 * bytes.length := by
      simp only [storedBytes, List.length_map, hexReadLength]
      exact hlength
    obtain ⟨out, ho, hs⟩ := h bytes bytes
      ((bytes.zipIdx).map (fun (b, i) => (int (Int.ofNat i + 1), b))) dest rfl ha hd
      (hexIterTrace _) (hexSlots bytes 0 (by simpa only [Nat.zero_add] using hsmall))
    refine ⟨out, ?_, hs.trans (hexLowerHexEq bytes)⟩
    rw [hexEncodingUnit allocString bytes]
    exact ho
  · intro e he
    rw [hexCallTrue _ bytes rfl]
    change (allocateHexStorageWith allocString (int 2 * int bytes.length)).bind _ = _
    rw [hexAllocateExact allocString _ hsmall, he]
    rfl

private theorem hexMulValue (a b : Index) : (a * b).val = wrapInt .i64 (a.val * b.val) := by
  rfl

private theorem hexWrap64Formula (n : Int) :
    wrapInt .i64 n = (n + 9223372036854775808) % 18446744073709551616 -
      9223372036854775808 := by
  rfl

private theorem hexTwiceNegative (n : Nat) (hlo : 2 ^ 62 ≤ n) (hhi : n < 2 ^ 63) :
    (int 2 * int n).val < 0 := by
  rw [hexMulValue, hexIntVal 2 (by omega) (by omega), hexIntVal n (by omega) (by omega),
    hexWrap64Formula]
  omega

private theorem hexEncodingAllocationError (allocString : Nat → Result Raw) (bytes : List UInt8)
    (e : Error) (he : allocateHexStorageWith allocString (int 2 * int bytes.length) = .error e) :
    bytes2hex (encodingOpsWith true allocString) bytes = .error e := by
  rw [hexCallTrue _ bytes rfl]
  change (allocateHexStorageWith allocString (int 2 * int bytes.length)).bind _ = _
  rw [he]
  rfl

private theorem hexEncodingLarge (allocString : Nat → Result Raw) (bytes : List UInt8) :
    2 ^ 62 ≤ bytes.length → bytes.length < 2 ^ 63 →
    ∃ fn, bytes2hex (encodingOpsWith true allocString) bytes = .error (.jl (.inexactError fn)) := by
  intro hlo hhi
  exact ⟨IntTy.u64.name, hexEncodingAllocationError allocString bytes _
    (hexAllocateNegative allocString _ (hexTwiceNegative bytes.length hlo hhi))⟩

theorem StringutilBytes2hexEncoding_proven : Round6.Bytes2hexEncoding := by
  intro allocString bytes
  exact ⟨hexEncodingSmall allocString bytes, hexEncodingLarge allocString bytes,
    ⟨"eltype of iterator not UInt8", rfl⟩⟩

