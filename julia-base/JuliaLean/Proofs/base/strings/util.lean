theorem suSplitLast {α : Type} {xs : List α} {x : α}
    (h : xs.getLast? = some x) : ∃ before, xs = before ++ [x] := by
  induction xs generalizing x with
  | nil => simp at h
  | cons a rest ih =>
    cases rest with
    | nil =>
