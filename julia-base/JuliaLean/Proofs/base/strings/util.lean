private theorem suWidthBounds (P : Utf8proc)
    (hw : ∀ u, 0 ≤ P.charwidth u ∧ P.charwidth u ≤ 2) (u : UInt32) :
    0 ≤ charWidth P u ∧ charWidth P u ≤ 2 := by
  unfold charWidth JuliaLean.base.strings.unicode.textwidthChar
  dsimp only
  by_cases hb : bswap32 u < 0x7f
  · simp only [if_pos hb]
    split <;> decide
  · simp only [if_neg hb]
    split
    · decide
    · exact hw _

private theorem suWidthSumNonneg (P : Utf8proc)
    (hw : ∀ u, 0 ≤ P.charwidth u ∧ P.charwidth u ≤ 2) (us : List UInt32) :
    0 ≤ (widthsOf P us).sum := by
  induction us with
  | nil => simp [widthsOf]
  | cons u us ih =>
    have h := (suWidthBounds P hw u).1
    simpa [widthsOf] using Int.add_nonneg h ih

private theorem suFitsTrace {S C E : Type} (iterate : S → Index → Except E (Option (C × Index)))
    (cops : UCharOps C) (P : Utf8proc) (liftU : UError → E)
    (s : S) (maxwidth : Int)
    (hw : ∀ u, 0 ≤ P.charwidth u ∧ P.charwidth u ≤ 2)
    {first : Option (C × Index)} {cs : List C} (trace : CharacterTrace (iterate s) first cs) :
    ∀ codes : List UInt32, cs.mapM cops.toChar = .ok codes →
    ∀ acc : Index, 0 ≤ acc.val → acc.val + (widthsOf P codes).sum < 2 ^ 63 →
      acc.val + (widthsOf P codes).sum ≤ maxwidth →
    match first with
    | none => True
    | some (c, i) =>
      WhileTrace (fun (total, c, i) => do
        let cw ← (match JuliaLean.base.strings.unicode.textwidthAbstractChar cops P c with
          | .ok w => .ok (int w)
          | .error e => .error (liftU e))
        let total := total + cw
        if total.val > maxwidth then return .inl false
        else
          match ← iterate s i with
          | none => return .inl true
          | some (c', i') => return .inr (total, c', i')) (acc, c, i) true := by
  induction trace with
  | nil => intros; trivial
  | @cons c i current rest hnext htail ih =>
    intro codes hcodes acc hacc hmax hfits
    cases hc : cops.toChar c with
    | error e => simp [List.mapM_cons, hc, Bind.bind, Except.bind] at hcodes
    | ok u =>
      cases hr : rest.mapM cops.toChar with
      | error e => simp [List.mapM_cons, hc, hr, Bind.bind, Except.bind, Functor.map, Except.map] at hcodes
      | ok us =>
        have heq : codes = u :: us := by
          simpa [List.mapM_cons, hc, hr, Bind.bind, Except.bind, Functor.map, Except.map,
            Pure.pure, Except.pure] using hcodes.symm
        subst codes
        have hu := suWidthBounds P hw u
        have hus := suWidthSumNonneg P hw us
        simp only [widthsOf, List.map_cons, List.sum_cons] at hmax hfits
        have hwidth : (int (charWidth P u)).val = charWidth P u := by
          apply wrapInt_of_inRange .i64
          constructor
          · change -9223372036854775808 ≤ charWidth P u; omega
          · change charWidth P u ≤ 9223372036854775807; omega
        have hadd : (acc + int (charWidth P u)).val = acc.val + charWidth P u := by
          change wrapInt .i64 (acc.val + (int (charWidth P u)).val) = _
          rw [hwidth]
          apply wrapInt_of_inRange .i64
          constructor
          · change -9223372036854775808 ≤ acc.val + charWidth P u; omega
          · change acc.val + charWidth P u ≤ 9223372036854775807
            dsimp [widthsOf] at hus
            omega
        have hnot : ¬ (acc + int (charWidth P u)).val > maxwidth := by
          rw [hadd]
          dsimp [widthsOf] at hus
          omega
        have hle : (acc + int (JuliaLean.base.strings.unicode.textwidthChar P u)).val ≤ maxwidth :=
          Int.le_of_not_gt hnot
        cases current with
        | none =>
          apply WhileTrace.done
          simp [hc, JuliaLean.base.strings.unicode.textwidthAbstractChar,
            JuliaLean.base.strings.unicode.liftChar, hle, hnext, charWidth,
            Bind.bind, Except.bind, Pure.pure, Except.pure]
        | some pair =>
          rcases pair with ⟨c', i'⟩
          apply WhileTrace.next (nextState := (acc + int (charWidth P u), c', i'))
          · simp [hc, JuliaLean.base.strings.unicode.textwidthAbstractChar,
              JuliaLean.base.strings.unicode.liftChar, hle, hnext, charWidth,
              Bind.bind, Except.bind, Pure.pure, Except.pure]
          · apply ih us hr (acc + int (charWidth P u))
            · rw [hadd]; omega
            · rw [hadd]; dsimp [widthsOf] at *; omega
            · rw [hadd]; dsimp [widthsOf] at *; omega

private theorem suWalkTrace {S R C CU CT E : Type}
    (prim : StringOps S R C CU CT E) (s : S) {i : Index}
    {ls : List (Index × C)} (h : Walk prim s i ls) :
    ∃ first, prim.iterateAt s i = .ok first ∧ CharacterTrace (prim.iterateAt s) first (charsIn ls) := by
  induction h with
  | stop _ done => exact ⟨none, done, .nil⟩
  | step _ yield _ _ ih =>
    obtain ⟨first, hfirst, trace⟩ := ih
    exact ⟨_, yield, .cons hfirst trace⟩

theorem truncationFitsIdentityProven : TruncationFitsIdentity := by
  intro S R C CU CT E RS RC prim errs cops P liftU liftJ rcops stringWidth
    stringify stringifyRepl concat s ls codes repl maxwidth preferLeft input
  dsimp only
  let ops := truncOps prim errs cops P liftU liftJ rcops stringWidth stringify stringifyRepl concat
  have hfit : (widthsOf P codes).sum ≤ maxwidth →
      checkTextwidth ops s maxwidth = some (.ok true) := by
    intro hsum
    obtain ⟨first, hfirst, htrace⟩ := suWalkTrace prim s input.lawful.walk
    have hfirst' : prim.iterateFirst s = .ok first := input.lawful.firstIterate.trans hfirst
    cases first with
    | none => simp [checkTextwidth, ops, truncOps, hfirst']
    | some pair =>
      rcases pair with ⟨c, i⟩
      have ht := suFitsTrace prim.iterateAt cops P liftU s maxwidth input.widths htrace
        codes input.converts (int 0) (by decide)
        (by simpa [widthsOf] using input.total) (by simpa using hsum)
      have hloop := whileLoop_trace _ ht
      change (match prim.iterateFirst s with
        | .error e => some (Except.error e)
        | .ok none => some (Except.ok true)
        | .ok (some (c, i)) => checkTextwidthLoop prim.iterateAt ops.textwidthChar s maxwidth c i (int 0)) =
          some (Except.ok true)
      rw [hfirst']
      exact hloop
  constructor
  · intro hnonneg hsum
    have hbound : ∀ {M : Type} (modeOps : TruncModeOps M) (mode : TruncModeVal M) (pl : Bool),
        stringTruncateBoundaries ops modeOps s maxwidth repl mode pl = some (.ok none) := by
      intros
      simp [stringTruncateBoundaries, show ¬ maxwidth < 0 by omega, hfit hsum]
    refine ⟨hbound, ?_⟩
    intro hmax
    have hval : (int maxwidth).val = maxwidth := by
      apply wrapInt_of_inRange .i64
      constructor
      · change -9223372036854775808 ≤ maxwidth; omega
      · change maxwidth ≤ 9223372036854775807; omega
    have hrange : IntTy.i64.min ≤ maxwidth ∧ maxwidth ≤ IntTy.i64.max := by
      constructor
      · change -9223372036854775808 ≤ maxwidth; omega
      · change maxwidth ≤ 9223372036854775807; omega
    have hconv : JInt.convert (IntTy.i64.name) .i64 maxwidth = .ok (int maxwidth) := by
      simp only [JInt.convert, dif_pos hrange]
      congr 1
      apply Subtype.ext
      exact hval.symm
    have hto : ops.toInt maxwidth = .ok (int maxwidth) := by simp [ops, truncOps, hconv]
    change rtruncate ops s maxwidth repl = _ ∧ ltruncate ops s maxwidth repl = _ ∧
      ctruncate ops s maxwidth repl preferLeft = _
    simp only [rtruncate, ltruncate, ctruncate, hto, partialBind, hval, hbound]
    exact ⟨rfl, rfl, rfl⟩
  · intro e he
    simp [rtruncate, ltruncate, ctruncate, ops, truncOps, he, partialBind]

private theorem walkHeadFacts {S R C CU CT E : Type}
    (prim : StringOps S R C CU CT E) (s : S) {start : Index}
    {pairs : List (Index × C)} (walk : Walk prim s start pairs) (hne : pairs ≠ []) :
    ∃ c next rest,
      pairs = (start, c) :: rest ∧
      prim.iterateAt s start = .ok (some (c, next)) ∧
      1 ≤ start.val ∧ start.val ≤ (prim.ncodeunits s).val := by
  cases walk with
  | stop atEnd done => exact False.elim (hne rfl)
  | @step i j c rest bounds yield advances tail =>
    exact ⟨c, j, rest, rfl, yield, bounds.1, bounds.2⟩

private theorem gFromAfterHeadAffix {S R C CU CT E : Type}
    (prim : StringOps S R C CU CT E) (errs : ViewErrors S E) (s : S)
    (head : Index × C) (after : List (Index × C)) (law : Lawful prim s (head :: after))
    (start : Index) (walk : Walk prim s start after) :
    ∃ out, gFrom prim errs s start = .ok out ∧ out.string = s ∧
      ViewIterates prim errs out (charsIn after) := by
  have hmax := walkEndBound prim s law.walk
  obtain ⟨lastPair, hlast⟩ := getLastSome head after
  obtain ⟨beforeLast, hsplitLast⟩ := Affix.splitLastList hlast
  have hpairFacts := walkLastFacts prim s law.walk lastPair hlast
  let nextLast := Classical.choose hpairFacts.1
  have hiterLast : prim.iterateAt s lastPair.1 = .ok (some (lastPair.2, nextLast)) :=
    Classical.choose_spec hpairFacts.1
  have hbound : ∀ q, q ∈ head :: after → q.1.val ≤ lastPair.1.val := hpairFacts.2.1
  have hlo : 1 ≤ lastPair.1.val := hpairFacts.2.2.1
  have hup : lastPair.1.val ≤ (prim.ncodeunits s).val := hpairFacts.2.2.2
  have hlastMem : lastPair ∈ head :: after := getLastMem hlast
  have hvalidLast : prim.isvalid s lastPair.1 = .ok true := by
    rw [law.isvalid lastPair.1 hlo hup]
    have hany : (head :: after).any (fun p => p.1.val == lastPair.1.val) = true :=
      List.any_eq_true.mpr ⟨lastPair, hlastMem, by simp⟩
    simp [hany]
  have hvalidLater :
      ∀ k : Index, lastPair.1.val < k.val ∧ k.val ≤ (prim.ncodeunits s).val →
        prim.isvalid s k = .ok false := by
    intro k ⟨hgt, hle⟩
    rw [law.isvalid k (by omega) hle]
    have hany : (head :: after).any (fun p => p.1.val == k.val) = false := by
      cases hh : (head :: after).any (fun p => p.1.val == k.val) with
      | false => rfl
      | true =>
        obtain ⟨q, hq, hqk⟩ := List.any_eq_true.mp hh
        have hqval : q.1.val = k.val := by simpa using beq_iff_eq.mp hqk
        have hqle := hbound q hq
        omega
    simp [hany]
  have hlastIndex : (gFull prim).lastindex s = .ok lastPair.1 := by
    have h := JuliaLean.Proofs.base.strings.basic.thisindInt_rewind
      prim s (prim.ncodeunits s) lastPair.1 hlo hup (Int.le_refl _) hmax
      (Or.inr hvalidLast) hvalidLater
    simpa [gFull, modelStringOps, JuliaLean.base.strings.basic.lastindexString] using h
  obtain ⟨nextLast', hnextLast, lastTail, _⟩ :=
    Affix.lawfulNextAtAffix prim s (head :: after) law beforeLast
      lastPair.1 lastPair.2 [] hsplitLast
  have hnextLastEq : nextLast' = prim.ncodeunits s + int 1 := by
    cases lastTail with
    | stop atEnd _ =>
      have hadd := JuliaLean.Proofs.base.strings.basic.add_one_val (prim.ncodeunits s) hmax
      apply Subtype.ext
      change nextLast'.val = (prim.ncodeunits s + int 1).val
      rw [hadd]
      exact atEnd
  cases after with
  | nil =>
    cases walk with
    | stop atEnd _ =>
      let out : Sub.SubString S :=
        ⟨s, JuliaLean.base.strings.substring.zero, JuliaLean.base.strings.substring.zero⟩
      have hlt : lastPair.1.val < start.val := by omega
      have hfrom : gFrom prim errs s start = .ok out := by
        simp [gFrom, Sub.subStringIntegerDefault, Sub.subStringInt,
          JuliaLean.base.strings.substring.typedSubString, hlastIndex, hlt, out,
          bind, Except.bind, pure, Except.pure]
      have hview : ViewIterates prim errs out [] := by
        simpa [out] using Affix.emptyViewIteratesAffix prim errs s
      exact ⟨out, hfrom, rfl, hview⟩
  | cons firstAfter restAfter =>
    obtain ⟨firstChar, _firstNext, _afterRest, hafter, _hiterStart, hloStart, hupStart⟩ :=
      walkHeadFacts prim s walk (by simp)
    have hfirstEq : firstAfter = (start, firstChar) := by
      injection hafter with hfirstEq hrestEq
    have hmemLastRest : lastPair ∈ firstAfter :: restAfter := by
      have hlastRest : (firstAfter :: restAfter).getLast? = some lastPair := by
        simpa [getLastCons] using hlast
      exact getLastMem hlastRest
    have hstartLeLast : start.val ≤ lastPair.1.val :=
      walkIndicesAtLeast prim s start (Int.le_refl _) walk lastPair hmemLastRest
    have hmemStart : (start, firstChar) ∈ head :: (firstAfter :: restAfter) := by
      rw [← hfirstEq]
      simp
    have hvalidStart : prim.isvalid s start = .ok true := by
      rw [law.isvalid start hloStart hupStart]
      have hscan : (head :: (firstAfter :: restAfter)).any
          (fun p => p.1.val == start.val) = true :=
        List.any_eq_true.mpr ⟨(start, firstChar), hmemStart, by simp⟩
      simp [hscan]
    have hlastUpper : decide (lastPair.1.val ≤ (prim.ncodeunits s).val) = true := by
      simp only [decide_eq_true_eq]
      exact hup
    have hnotLow : ¬ start.val < 1 := by omega
    have hnotRange : ¬ lastPair.1.val < start.val := by omega
    have hcheck : (gParent prim errs).checkboundsRange s start lastPair.1 = .ok () := by
      simp [gParent, JuliaLean.base.strings.basic.checkbounds,
        JuliaLean.base.strings.basic.checkboundsRange, unitRangeOps, gFull, modelStringOps,
        hnotLow, hnotRange, hlastUpper, bind, Except.bind, pure, Except.pure]
    let out : Sub.SubString S :=
      ⟨s, start - JuliaLean.base.strings.substring.one, nextLast' - start⟩
    have htyped :
        JuliaLean.base.strings.substring.typedSubString (gParent prim errs) s start lastPair.1 =
          .ok out := by
      have hnot : ¬ lastPair.1.val < start.val := by omega
      simp only [JuliaLean.base.strings.substring.typedSubString, if_neg hnot]
      rw [hcheck]
      simp [gParent, hvalidStart, hvalidLast, hnextLast, out,
        bind, Except.bind, pure, Except.pure]
    have hfrom : gFrom prim errs s start = .ok out := by
      simp [gFrom, Sub.subStringIntegerDefault, Sub.subStringInt,
        hlastIndex, htyped, bind, Except.bind, pure, Except.pure]
    have hspan' := typedSubStringViewSpan (gParent prim errs) s start lastPair.1 nextLast' out
      (by omega) (by omega) (by omega) hnextLast htyped
    have hspan :
        out.offset.val + 1 = start.val ∧
          out.offset.val + out.ncodeunits.val + 1 =
            (prim.ncodeunits s + int 1).val := by
      rcases hspan' with ⟨hstart, hend⟩
      rw [hnextLastEq] at hend
      exact ⟨hstart, hend⟩
    have hoff0 : 0 ≤ out.offset.val := by omega
    have hsegment := Affix.walkToSegment prim s walk hmax
    have hview : ViewIterates prim errs out (charsIn (firstAfter :: restAfter)) := by
      simpa [charsIn] using
        Affix.viewIteratesSegment prim errs s out (prim.ncodeunits s + int 1)
          start (firstAfter :: restAfter) hsegment rfl hoff0 hspan.2 hspan.1
    exact ⟨out, hfrom, rfl, hview⟩

theorem chopPrefixCharacterRound6_proven : ChopPrefixCharacter := by
  intro S R C D CU CT E prim errs toC toD lift s c ls us uc hlaw hmap huc
  have hUsEmpty : us.isEmpty = ls.isEmpty := by
    cases ls with
    | nil =>
      have hnil : ([] : List UInt32) = us := by
        simpa [charsIn, List.mapM_nil, pure, Except.pure] using hmap
      simp [hnil]
    | cons first rest =>
      have hmap' : (first.2 :: charsIn rest).mapM toC = .ok us := by
        simpa [charsIn] using hmap
      obtain ⟨u, tail, _, _, hus⟩ := mapM_cons_ok toC first.2 (charsIn rest) hmap'
      simp [hus]
  have hEmptyLayout : isemptyString (gFull prim) s = ls.isEmpty := by
    cases ls with
    | nil =>
      have hn : (prim.ncodeunits s).val = 0 := by
        cases hlaw.walk with
        | stop atEnd done =>
          have hone : (int 1).val = 1 := by decide
          rw [hone] at atEnd
          omega
      change ((prim.ncodeunits s).val == 0) = true
      simp [hn]
    | cons first rest =>
      have hn : (prim.ncodeunits s).val ≠ 0 := by
        cases hlaw.walk with
        | step bounds yield advances tail =>
          have hone : (int 1).val = 1 := by decide
          rw [hone] at bounds
          omega
      change ((prim.ncodeunits s).val == 0) = false
      simp [hn]
  obtain ⟨wholeOut, hWhole, hWholeString, hWholeView⟩ :=
    Affix.wholeViewIteratesAffix prim errs s ls hlaw
  let call : S → D → Except E (Sub.SubString S) :=
    fun text candidate =>
      chopprefixChar
        (fun x => .ok (isemptyString (gFull prim) x))
        (firstString (getindexString (gFull prim)))
        (fun x => .ok (firstindexString x))
        (nextindOne (gFull prim)) (gFrom prim errs) (gWhole prim errs)
        (charEq toC toD lift) text candidate
  cases ls with
  | nil =>
    have hus : us = [] := by
      have heq : ([] : List UInt32) = us := by
        simpa [charsIn, List.mapM_nil, pure, Except.pure] using hmap
      exact heq.symm
    have hEmpty : isemptyString (gFull prim) s = true := by
      simpa [hus] using hEmptyLayout
    have hcall : call s c = .ok wholeOut := by
      simp [call, chopprefixChar, hEmpty, hWhole, bind, Except.bind, pure, Except.pure]
    have hView : ViewIterates prim errs wholeOut
        (if us.head? = some uc then (charsIn []).drop 1 else charsIn []) := by
      simpa [hus, charsIn] using hWholeView
    exact ⟨wholeOut, by simpa [call] using hcall, hWholeString, hView⟩
  | cons first rest =>
    rcases first with ⟨i, headChar⟩
    have hmap' : (headChar :: charsIn rest).mapM toC = .ok us := by
      simpa [charsIn] using hmap
    obtain ⟨u, tailCodes, htoC, hmapTail, hus⟩ :=
      mapM_cons_ok toC headChar (charsIn rest) hmap'
    have hEmpty : isemptyString (gFull prim) s = false := by
      simpa using hEmptyLayout
    have hindex : i = int 1 := by
      cases hlaw.walk with
      | step bounds yield advances tail => rfl
    have hfirstBounds : 1 ≤ i.val ∧ i.val ≤ (prim.ncodeunits s).val := by
      cases hlaw.walk with
      | step bounds yield advances tail => exact bounds
    have hiter : ∃ next, prim.iterateAt s (int 1) = .ok (some (headChar, next)) := by
      cases hlaw.walk with
      | step bounds yield advances tail =>
        exact ⟨_, by simpa [hindex] using yield⟩
    obtain ⟨firstNext, hiter⟩ := hiter
    have hboundsOne : 1 ≤ (int 1).val ∧ (int 1).val ≤ (prim.ncodeunits s).val := by
      have hone : (int 1).val = 1 := by decide
      have hupper := hfirstBounds.2
      rw [hindex, hone] at hupper
      constructor
      · rw [hone]
        omega
      · exact hupper
    have hvalid : prim.isvalid s (int 1) = .ok true := by
      rw [hlaw.isvalid (int 1) hboundsOne.1 hboundsOne.2]
      have hlist : ((i, headChar) :: rest) = ((int 1, headChar) :: rest) := by
        simp [hindex]
      rw [hlist]
      simp
    have hcheck : (gFull prim).checkbounds s (int 1) = .ok () := by
      have hone : (int 1).val = 1 := by decide
      have hupper : decide (1 ≤ (prim.ncodeunits s).val) = true := by
        simpa [hone] using hboundsOne.2
      simp [gFull, modelStringOps, JuliaLean.base.strings.basic.checkbounds,
        JuliaLean.base.strings.basic.checkboundsScalar, hone, hupper,
        bind, Except.bind, pure, Except.pure]
    have hvalidFull : (gFull prim).isvalid s (int 1) = .ok true := by
      change prim.isvalid s (int 1) = .ok true
      exact hvalid
    have hiterFull :
        (gFull prim).iterateAt s (int 1) = .ok (some (headChar, firstNext)) := by
      change prim.iterateAt s (int 1) = .ok (some (headChar, firstNext))
      exact hiter
    have hget : getindexString (gFull prim) s (int 1) = .ok headChar := by
      simp [getindexString, getindexInteger, hcheck, hvalidFull, hiterFull,
        bind, Except.bind, pure, Except.pure]
    have hfirst : firstString (getindexString (gFull prim)) s = .ok headChar := by
      simpa [firstString, firstindexString] using hget
    obtain ⟨next, hnext, htail, _⟩ :=
      Affix.lawfulNextAtAffix prim s ((i, headChar) :: rest) hlaw []
        i headChar rest rfl
    have hnext' :
        nextindOne (gFull prim) s (firstindexString s) = .ok next := by
      simpa [firstindexString, hindex] using hnext
    have hcharEq : charEq toC toD lift headChar c = .ok (u == uc) := by
      simp [charEq, htoC, huc, JuliaLean.base.char.eq_AbstractChar,
        JuliaLean.base.char.eq_Char, bind, Except.bind, pure, Except.pure]
    by_cases hmatch : u = uc
    · have hchar : charEq toC toD lift headChar c = .ok true := by
        simpa [hmatch] using hcharEq
      obtain ⟨out, hfrom, hString, hView⟩ :=
        gFromAfterHeadAffix prim errs s (i, headChar) rest hlaw next htail
      have hcall : call s c = .ok out := by
        simp [call, chopprefixChar, hEmpty, hfirst, hnext', hchar, hfrom,
          bind, Except.bind, pure, Except.pure]
      have hExpected : ViewIterates prim errs out
          (if us.head? = some uc then (charsIn ((i, headChar) :: rest)).drop 1
           else charsIn ((i, headChar) :: rest)) := by
        have hheadMatch : us.head? = some uc := by
          simp [hus, hmatch]
        rw [if_pos hheadMatch]
        simpa [charsIn] using hView
      exact ⟨out, by simpa [call] using hcall, hString, hExpected⟩
    · have hNoHead : us.head? ≠ some uc := by
        rw [hus]
        simp [hmatch]
      have hchar : charEq toC toD lift headChar c = .ok false := by
        rw [hcharEq]
        simp [hmatch]
      have hcall : call s c = .ok wholeOut := by
        simp [call, chopprefixChar, hEmpty, hfirst, hchar, hWhole,
          bind, Except.bind, pure, Except.pure]
      have hExpected : ViewIterates prim errs wholeOut
          (if us.head? = some uc then (charsIn ((i, headChar) :: rest)).drop 1
           else charsIn ((i, headChar) :: rest)) := by
        rw [if_neg hNoHead]
        exact hWholeView
      exact ⟨wholeOut, by simpa [call] using hcall, hWholeString, hExpected⟩
private def suTextwidthStep {S C E : Type}
    (iterateAt : S → Index → Except E (Option (C × Index)))
    (textwidthChar : C → Except E Index) (s : S) (maxwidth : Int) :
    (Index × C × Index) → Except E (Sum Bool (Index × C × Index)) :=
  fun (total, c, i) => do
    let cw ← textwidthChar c
    let total := total + cw
    if total.val > maxwidth then
      return .inl false
    else
      match ← iterateAt s i with
      | none => return .inl true
      | some (c', i') => return .inr (total, c', i')
    
private theorem suTextwidthTraceExact {S C E : Type}
    (iterateAt : S → Index → Except E (Option (C × Index)))
    (textwidthChar : C → Except E Index) (cops : UCharOps C) (P : Utf8proc)
    (s : S) (maxwidth : Int)
    (hw : ∀ u, 0 ≤ P.charwidth u ∧ P.charwidth u ≤ 2)
    (widthLaw : ∀ c u, cops.toChar c = .ok u →
      textwidthChar c = .ok (int (charWidth P u))) :
    ∀ (chars : List C) (c : C) (i : Index),
      CharacterTrace (iterateAt s) (some (c, i)) chars →
      ∀ codes, chars.mapM cops.toChar = .ok codes →
      ∀ acc, 0 ≤ acc.val → acc.val + (widthsOf P codes).sum < 2 ^ 63 →
        ∃ result, WhileTrace (suTextwidthStep iterateAt textwidthChar s maxwidth)
            (acc, c, i) result ∧
          (result = true ↔ acc.val + (widthsOf P codes).sum ≤ maxwidth) := by
  intro chars
  induction chars with
  | nil =>
    intro c i trace
    cases trace
  | cons head rest ih =>
    intro c i trace
    cases trace with
    | @cons _ _ current tail hnext htail =>
      intro codes hcodes acc hacc hbound
      obtain ⟨u, us, hchar, hrest, hcodes⟩ :=
        mapM_cons_ok cops.toChar head rest hcodes
      subst codes
      have hu := suWidthBounds P hw u
      have hus := suWidthSumNonneg P hw us
      have hbound' : acc.val + charWidth P u + (widthsOf P us).sum < 2 ^ 63 := by
        simpa [widthsOf, Int.add_assoc] using hbound
      have hval : (int (charWidth P u)).val = charWidth P u := by
        change wrapInt .i64 (charWidth P u) = _
        apply wrapInt_of_inRange .i64
        constructor
        · change -9223372036854775808 ≤ charWidth P u
          omega
        · change charWidth P u ≤ 9223372036854775807
          omega
      have hadd : (acc + int (charWidth P u)).val = acc.val + charWidth P u := by
        change wrapInt .i64 (acc.val + (int (charWidth P u)).val) = _
        rw [hval]
        apply wrapInt_of_inRange .i64
        constructor
        · change -9223372036854775808 ≤ acc.val + charWidth P u
          omega
        · change acc.val + charWidth P u ≤ 9223372036854775807
          omega
      have htotal :
          acc.val + (widthsOf P (u :: us)).sum =
            (acc + int (charWidth P u)).val + (widthsOf P us).sum := by
        simp [widthsOf, hadd, Int.add_assoc]
      have hacc' : 0 ≤ (acc + int (charWidth P u)).val := by
        rw [hadd]
        omega
      have hboundNext :
          (acc + int (charWidth P u)).val + (widthsOf P us).sum < 2 ^ 63 := by
        rw [hadd]
        omega
      have hcharWidth : textwidthChar head = .ok (int (charWidth P u)) :=
        widthLaw head u hchar
      by_cases hover : (acc + int (charWidth P u)).val > maxwidth
      · have htotalOver :
            acc.val + (widthsOf P (u :: us)).sum > maxwidth := by
          rw [htotal]
          exact Int.lt_of_lt_of_le hover (by omega)
        have hstep :
            suTextwidthStep iterateAt textwidthChar s maxwidth (acc, head, i) =
              .ok (.inl false) := by
          simp [suTextwidthStep, hcharWidth, hover, bind, Except.bind, pure, Except.pure]
        refine ⟨false, .done hstep, ?_⟩
        simp [htotalOver]
      · have hwithin : (acc + int (charWidth P u)).val ≤ maxwidth := by omega
        cases current with
        | none =>
          cases htail
          have husNil : us = [] := by
            have h := hrest
            simp [Pure.pure, Except.pure] at h
            exact h
          subst us
          have hstep :
              suTextwidthStep iterateAt textwidthChar s maxwidth (acc, head, i) =
                .ok (.inl true) := by
            simp [suTextwidthStep, hcharWidth, hwithin, hnext, bind, Except.bind,
              pure, Except.pure]
          refine ⟨true, .done hstep, ?_⟩
          simpa [widthsOf, hval, hadd] using hwithin
        | some pair =>
          rcases pair with ⟨c', i'⟩
          obtain ⟨result, htrace, hresult⟩ :=
            ih c' i' htail us hrest (acc + int (charWidth P u)) hacc' hboundNext
          have hstep :
              suTextwidthStep iterateAt textwidthChar s maxwidth (acc, head, i) =
                .ok (.inr (acc + int (charWidth P u), c', i')) := by
            simp [suTextwidthStep, hcharWidth, hwithin, hnext, bind, Except.bind,
              pure, Except.pure]
          refine ⟨result, .next hstep htrace, ?_⟩
          rw [htotal]
          exact hresult
private theorem suIntListSumNonneg (xs : List Int)
    (h : ∀ x ∈ xs, 0 ≤ x) : 0 ≤ xs.sum := by
  induction xs with
  | nil => simp
  | cons x xs ih =>
    have hx := h x (by simp)
    have htail : ∀ y ∈ xs, 0 ≤ y := by
      intro y hy
      exact h y (by simp [hy])
    have hsum := ih htail
    simp only [List.sum_cons]
    omega

private theorem suPrefixAllTotal (P : Utf8proc)
    (hw : ∀ u, 0 ≤ P.charwidth u ∧ P.charwidth u ≤ 2)
    (codes : List UInt32) (maxwidth : Int) (hne : codes ≠ []) :
    (List.range codes.length).all (fun k =>
      decide (((widthsOf P codes).take (k + 1)).sum ≤ maxwidth)) =
        decide ((widthsOf P codes).sum ≤ maxwidth) := by
  apply Bool.eq_iff_iff.mpr
  constructor
  · intro hall
    cases codes with
    | nil => contradiction
    | cons u rest =>
      have hmem : (u :: rest).length - 1 ∈ List.range (u :: rest).length := by simp
      have hrow := (List.all_eq_true.mp hall) _ hmem
      have hlen : (u :: rest).length - 1 + 1 = (u :: rest).length := by simp
      have hfull : (widthsOf P (u :: rest)).take ((u :: rest).length - 1 + 1) =
          widthsOf P (u :: rest) := by
        rw [hlen]
        exact List.take_of_length_le (by simp [widthsOf])
      rw [hfull] at hrow
      exact hrow
  · intro htotal
    apply List.all_eq_true.mpr
    intro k hk
    have hklt : k < codes.length := List.mem_range.mp hk
    let ws := widthsOf P codes
    have hws : ∀ w ∈ ws, 0 ≤ w := by
      intro w hwmem
      rcases List.mem_map.mp hwmem with ⟨u, hu, rfl⟩
      exact (suWidthBounds P hw u).1
    have hsplit : ws.take (k + 1) ++ ws.drop (k + 1) = ws :=
      List.take_append_drop _ _
    have hsum : (ws.take (k + 1)).sum + (ws.drop (k + 1)).sum = ws.sum := by
      calc
        (ws.take (k + 1)).sum + (ws.drop (k + 1)).sum =
            (ws.take (k + 1) ++ ws.drop (k + 1)).sum := by rw [List.sum_append]
        _ = ws.sum := by rw [hsplit]
    have htail : 0 ≤ (ws.drop (k + 1)).sum :=
      suIntListSumNonneg _ (fun w hw => hws w (List.mem_of_mem_drop hw))
    have htotalProp : ws.sum ≤ maxwidth := by
      have h := of_decide_eq_true htotal
      simpa [ws] using h
    have hsumMax : (ws.take (k + 1)).sum + (ws.drop (k + 1)).sum ≤ maxwidth := by
      rw [hsum]
      exact htotalProp
    have hprefix : (ws.take (k + 1)).sum ≤ maxwidth := by omega
    simpa [ws, decide_eq_true_eq] using hprefix
theorem textwidthPrefixCheckProven : TextwidthPrefixCheck := by
  intro S R C CU CT E RS RC prim errs cops P liftU liftJ rcops stringWidth
    stringify stringifyRepl concat s ls codes maxwidth input
  let ops := truncOps prim errs cops P liftU liftJ rcops stringWidth stringify stringifyRepl concat
  obtain ⟨first, hfirst, htrace⟩ := suWalkTrace prim s input.lawful.walk
  have hfirst' : prim.iterateFirst s = .ok first := input.lawful.firstIterate.trans hfirst
  cases first with
  | none =>
    have hls : ls = [] := by
      cases input.lawful.walk with
      | stop _ _ => rfl
      | step _ yield _ _ =>
        have hAt : prim.iterateAt s (int 1) = .ok none :=
          input.lawful.firstIterate.symm.trans hfirst'
        rw [yield] at hAt
        cases hAt
    have hcodes : codes = [] := by
      have hmap := input.converts
      rw [hls] at hmap
      simp [charsIn, List.mapM_nil, Pure.pure, Except.pure] at hmap
      exact hmap
    simp [checkTextwidth, ops, truncOps, hfirst', hcodes]
  | some pair =>
    rcases pair with ⟨c, i⟩
    have htrace' : CharacterTrace (ops.iterateAt s) (some (c, i)) (charsIn ls) := by
      simpa [ops, truncOps] using htrace
    have hwidthLaw : ∀ c' u, cops.toChar c' = .ok u →
        ops.textwidthChar c' = .ok (int (charWidth P u)) := by
      intro c' u hchar
      simp [ops, truncOps, JuliaLean.base.strings.unicode.textwidthAbstractChar,
        JuliaLean.base.strings.unicode.liftChar, hchar, charWidth]
    have hbound : (int 0).val + (widthsOf P codes).sum < 2 ^ 63 := by
      simpa [widthsOf] using input.total
    obtain ⟨result, hloop, hresult⟩ :=
      suTextwidthTraceExact ops.iterateAt ops.textwidthChar cops P s maxwidth
        input.widths hwidthLaw (charsIn ls) c i htrace' codes input.converts
        (int 0) (by decide) hbound
    have hfirstOps : ops.iterateFirst s = .ok (some (c, i)) := by
      simpa [ops, truncOps] using hfirst'
    have htraceResult := whileLoop_trace
      (suTextwidthStep ops.iterateAt ops.textwidthChar s maxwidth) hloop
    have hcheck : checkTextwidth ops s maxwidth = some (.ok result) := by
      unfold checkTextwidth
      rw [hfirstOps]
      change whileLoop (suTextwidthStep ops.iterateAt ops.textwidthChar s maxwidth)
        (int 0, c, i) = _
      exact htraceResult
    have hlsNe : ls ≠ [] := by
      intro hnil
      cases ls with
      | nil =>
        have hAt : prim.iterateAt s (int 1) = .ok (some (c, i)) :=
          input.lawful.firstIterate.symm.trans hfirst'
        cases input.lawful.walk with
        | stop _ done =>
          rw [done] at hAt
          cases hAt
      | cons pair rest => simp at hnil
    have hcharsNe : charsIn ls ≠ [] := by
      cases ls with
      | nil => exact (hlsNe rfl).elim
      | cons pair rest => simp [charsIn]
    have hcodesNe : codes ≠ [] := by
      intro hnil
      cases hchars : charsIn ls with
      | nil => exact (hcharsNe hchars).elim
      | cons head tail =>
        have hmap : (head :: tail).mapM cops.toChar = .ok [] := by
          have h := input.converts
          rw [hchars, hnil] at h
          simpa using h
        obtain ⟨u, us, _, _, hvalues⟩ :=
          mapM_cons_ok cops.toChar head tail hmap
        simp at hvalues
    have hprefix := suPrefixAllTotal P input.widths codes maxwidth hcodesNe
    have hresult' : result = decide ((widthsOf P codes).sum ≤ maxwidth) := by
      cases result <;> simp_all [hresult]
    rw [hcheck, hresult', ← hprefix]
end Round6
end JuliaLean.Proofs.base.strings.util

namespace JuliaLean.Proofs.base.strings.util.Round6
open JuliaLean JuliaLean.base.strings.basic JuliaLean.base.strings.util


private theorem prefixMismatchSplit (P : Nat → Prop) :
    ∀ m : Nat, (∀ o, o < m → P o) ∨ ∃ idx, idx < m ∧ ¬ P idx ∧ ∀ o, o < idx → P o := by
  intro m
  induction m with
  | zero => exact Or.inl (fun o h => absurd h (Nat.not_lt_zero o))
  | succ m ih =>
    rcases ih with hall | ⟨idx, hidx, hnot, hpre⟩
    · by_cases hm : P m
      · left
        intro o ho
        by_cases hom : o = m
        · subst hom; exact hm
        · exact hall o (by omega)
      · exact Or.inr ⟨m, by omega, hm, hall⟩
    · exact Or.inr ⟨idx, by omega, hnot, hpre⟩

private theorem u8LitVal (x : Nat) (hx : x < 256) : (JInt.lit .u8 (x : Int)).val = x := by
  change wrapInt .u8 (x : Int) = x
  exact wrapInt_of_inRange .u8 _ (by simp [IntTy.min, IntTy.max, IntTy.signed, IntTy.bits]; omega)

private theorem pairHeapLeft (a b : List UInt8) (o : Nat) (ho : o < a.length)
    (hsize : a.length + 1 + b.length < 2 ^ 64) :
    ((pairHeap a b).readByte (0 + o)).val = (a[o]'ho).toNat := by
  have hmod : JuliaLean.base.pointer.addressMod (0 + o) = o := by
    simp [JuliaLean.base.pointer.addressMod]; omega
  simp only [JuliaLean.base.pointer.ByteHeap.readByte, hmod, pairHeap,
    show o < a.length + 1 by omega, if_true]
  rw [show a.getD o 0 = a[o] by first | simp [ho] | simp [List.getD, ho]]
  exact u8LitVal _ (UInt8.toNat_lt _)

private theorem pairHeapRight (a b : List UInt8) (o : Nat) (ho : o < b.length)
    (hsize : a.length + 1 + b.length < 2 ^ 64) :
    ((pairHeap a b).readByte (a.length + 1 + o)).val = (b[o]'ho).toNat := by
  have hmod : JuliaLean.base.pointer.addressMod (a.length + 1 + o) = a.length + 1 + o := by
    simp [JuliaLean.base.pointer.addressMod]; omega
  simp only [JuliaLean.base.pointer.ByteHeap.readByte, hmod, pairHeap,
    show ¬ (a.length + 1 + o < a.length + 1) by omega, if_false,
    show a.length + 1 + o - a.length - 1 = o by omega]
  rw [show b.getD o 0 = b[o] by first | simp [ho] | simp [List.getD, ho]]
  exact u8LitVal _ (UInt8.toNat_lt _)

/-- `_memcmp` on the byte model is zero exactly when the first `m` bytes agree. -/
theorem compareBytes_zero_iff (a b : List UInt8) (n : Index) (m : Nat)
    (hn : n.val = m) (hma : m ≤ a.length) (hmb : m ≤ b.length)
    (hsize : a.length + 1 + b.length < 2 ^ 64) :
    compareBytes a b n = 0 ↔ a.take m = b.take m := by
  have hrem : (JInt.rem .u64 n).val.toNat = m := by
    change (wrapInt .u64 n.val).toNat = m
    rw [hn, wrapInt_of_inRange .u64 _
      (by simp [IntTy.min, IntTy.max, IntTy.signed, IntTy.bits]; omega)]
    simp
  let heap := pairHeap a b
  let P : Nat → Prop := fun o => heap.readByte (0 + o) = heap.readByte (a.length + 1 + o)
  have hP : ∀ o (hoa : o < a.length) (hob : o < b.length), P o ↔ a[o] = b[o] := by
    intro o hoa hob
    constructor
    · intro h
      have hv := congrArg Subtype.val h
      rw [pairHeapLeft a b o hoa hsize, pairHeapRight a b o hob hsize] at hv
      exact UInt8.toNat_inj.mp (by exact_mod_cast hv)
    · intro h
      apply Subtype.ext
      rw [pairHeapLeft a b o hoa hsize, pairHeapRight a b o hob hsize, h]
  have htake : a.take m = b.take m ↔ ∀ o, o < m → P o := by
    constructor
    · intro h o ho
      have h1 := congrArg (fun l => l[o]?) h
      simp only [List.getElem?_take, if_pos ho] at h1
      rw [List.getElem?_eq_getElem (by omega), List.getElem?_eq_getElem (by omega)] at h1
      exact (hP o (by omega) (by omega)).mpr (Option.some.inj h1)
    · intro h
      apply List.ext_getElem?
      intro o
      simp only [List.getElem?_take]
      by_cases ho : o < m
      · rw [if_pos ho, if_pos ho, List.getElem?_eq_getElem (by omega),
          List.getElem?_eq_getElem (by omega), (hP o (by omega) (by omega)).mp (h o ho)]
      · rw [if_neg ho, if_neg ho]
  have hcmp : compareBytes a b n =
      (JuliaLean.base.cmem.StandardC.cMemcmp heap 0 (a.length + 1) m).val := by
    simp [compareBytes, Str.memcmpLength, hrem, heap]
  rw [hcmp, htake]
  obtain ⟨h0, h1⟩ := JuliaLean.base.cmem.StandardC.cMemcmp_scan heap m 0 (a.length + 1)
  constructor
  · intro hz
    rcases prefixMismatchSplit P m with hall | ⟨idx, hidx, hnot, hpre⟩
    · exact hall
    · obtain ⟨e1, e2⟩ := h1 idx hidx hnot hpre
      have hne : (heap.readByte (0 + idx)).val ≠ (heap.readByte (a.length + 1 + idx)).val :=
        fun hc => hnot (Subtype.ext hc)
      exfalso
      rcases Int.lt_or_gt_of_ne hne with hlt | hgt
      · have := e1.mpr hlt; omega
      · have := e2.mpr hgt; omega
  · intro hall
    exact h0 hall


/-- `_thisind_str` (string.jl:233-243) on a byte reader, for an in-bounds index. -/
def thisindPure (rd : Int → UInt8) (i : Int) : Int :=
  if !((rd i &&& 0xc0 == 0x80) && decide (i - 1 > 0)) then i
  else if Str.stringBetweenByte (rd (i - 1)) 0b11000000 0b11110111 then i - 1
  else if !((rd (i - 1) &&& 0xc0 == 0x80) && decide (i - 2 > 0)) then i
  else if Str.stringBetweenByte (rd (i - 2)) 0b11100000 0b11110111 then i - 2
  else if !((rd (i - 2) &&& 0xc0 == 0x80) && decide (i - 3 > 0)) then i
  else if Str.stringBetweenByte (rd (i - 3)) 0b11110000 0b11110111 then i - 3
  else i

def contB (b : UInt8) : Bool := b &&& 0xc0 == 0x80

def leadB : Nat → UInt8 → Bool
  | 1, b => Str.stringBetweenByte b 0b11000000 0b11110111
  | 2, b => Str.stringBetweenByte b 0b11100000 0b11110111
  | _, b => Str.stringBetweenByte b 0b11110000 0b11110111

/-- `i` lies inside a character that starts `m ∈ {1,2,3}` bytes earlier. -/
def joined (rd : Int → UInt8) (i : Int) : Prop :=
  (i - 1 > 0 ∧ contB (rd i) ∧ leadB 1 (rd (i - 1))) ∨
  (i - 2 > 0 ∧ contB (rd i) ∧ contB (rd (i - 1)) ∧ leadB 2 (rd (i - 2))) ∨
  (i - 3 > 0 ∧ contB (rd i) ∧ contB (rd (i - 1)) ∧ contB (rd (i - 2)) ∧ leadB 3 (rd (i - 3)))

theorem thisindPure_eq_iff (rd : Int → UInt8) (i : Int) :
    thisindPure rd i = i ↔ ¬ joined rd i := by
  unfold thisindPure joined
  simp only [contB, leadB]
  generalize (rd i &&& 0xc0 == 0x80) = c0
  generalize (rd (i - 1) &&& 0xc0 == 0x80) = c1
  generalize (rd (i - 2) &&& 0xc0 == 0x80) = c2
  generalize Str.stringBetweenByte (rd (i - 1)) 0b11000000 0b11110111 = l1
  generalize Str.stringBetweenByte (rd (i - 2)) 0b11100000 0b11110111 = l2
  generalize Str.stringBetweenByte (rd (i - 3)) 0b11110000 0b11110111 = l3
  by_cases h1 : i - 1 > 0 <;> by_cases h2 : i - 2 > 0 <;> by_cases h3 : i - 3 > 0 <;>
    cases c0 <;> cases c1 <;> cases c2 <;> cases l1 <;> cases l2 <;> cases l3 <;>
    simp [h1, h2, h3] <;> omega

private theorem leadMono (b : UInt8) : leadB 3 b = true → leadB 2 b = true ∧ leadB 1 b = true := by
  simp only [leadB, Str.stringBetweenByte, JuliaLean.base.strings.string.between,
    Bool.and_eq_true, decide_eq_true_eq, UInt8.le_iff_toNat_le]
  intro h
  simp at h ⊢
  omega

private theorem leadMono2 (b : UInt8) : leadB 2 b = true → leadB 1 b = true := by
  simp only [leadB, Str.stringBetweenByte, JuliaLean.base.strings.string.between,
    Bool.and_eq_true, decide_eq_true_eq, UInt8.le_iff_toNat_le]
  intro h
  simp at h ⊢
  omega

/-- A view's `thisind` agrees with its parent's at a position strictly inside the view,
provided the view starts at a character boundary of the parent. -/
theorem thisindPure_view (P : Int → UInt8) (off i : Int) (hoff : 0 ≤ off) (hi : 2 ≤ i)
    (hstart : off = 0 ∨ thisindPure P (off + 1) = off + 1) :
    (thisindPure (fun x => P (off + x)) i = i) ↔ (thisindPure P (off + i) = off + i) := by
  rw [thisindPure_eq_iff, thisindPure_eq_iff]
  have hs : off = 0 ∨ ¬ joined P (off + 1) := by
    rcases hstart with h | h
    · exact Or.inl h
    · exact Or.inr ((thisindPure_eq_iff P (off + 1)).mp h)
  have e1 : off + (i - 1) = off + i - 1 := by omega
  have e2 : off + (i - 2) = off + i - 2 := by omega
  have e3 : off + (i - 3) = off + i - 3 := by omega
  unfold joined
  simp only [e1, e2, e3]
  constructor
  · intro hv hp
    apply hv
    rcases hp with ⟨p, c0, l⟩ | ⟨p, c0, c1, l⟩ | ⟨p, c0, c1, c2, l⟩
    · by_cases q : i - 1 > 0
      · exact Or.inl ⟨q, c0, l⟩
      · omega
    · by_cases q : i - 2 > 0
      · exact Or.inr (Or.inl ⟨q, c0, c1, l⟩)
      · -- i = 2: the lead byte sits at `off`, before the view start `off + 1`
        have hi2 : i = 2 := by omega
        subst hi2
        rcases hs with h0 | hs
        · omega
        · exfalso; apply hs
          have ep : off + 2 - 2 = off + 1 - 1 := by omega
          have ec : off + 2 - 1 = off + 1 := by omega
          rw [ep] at l; rw [ec] at c1
          exact Or.inl ⟨by omega, c1, leadMono2 _ l⟩
    · by_cases q : i - 3 > 0
      · exact Or.inr (Or.inr ⟨q, c0, c1, c2, l⟩)
      · exfalso
        rcases hs with h0 | hs
        · omega
        · apply hs
          have hcase : i = 2 ∨ i = 3 := by omega
          rcases hcase with rfl | rfl
          · -- lead at `off - 1`, two bytes before the start
            have ep : off + 2 - 3 = off + 1 - 2 := by omega
            have ec1 : off + 2 - 1 = off + 1 := by omega
            have ec2 : off + 2 - 2 = off + 1 - 1 := by omega
            rw [ep] at l; rw [ec1] at c1; rw [ec2] at c2
            exact Or.inr (Or.inl ⟨by omega, c1, c2, (leadMono _ l).1⟩)
          · have ep : off + 3 - 3 = off + 1 - 1 := by omega
            have ec2 : off + 3 - 2 = off + 1 := by omega
            rw [ep] at l; rw [ec2] at c2
            exact Or.inl ⟨by omega, c2, (leadMono _ l).2⟩
  · intro hp hv
    apply hp
    rcases hv with ⟨p, c0, l⟩ | ⟨p, c0, c1, l⟩ | ⟨p, c0, c1, c2, l⟩
    · exact Or.inl ⟨by omega, c0, l⟩
    · exact Or.inr (Or.inl ⟨by omega, c0, c1, l⟩)
    · exact Or.inr (Or.inr ⟨by omega, c0, c1, c2, l⟩)


private theorem ixSubVal (i : Index) (m : Int) (h0 : 0 ≤ m) (hm : m ≤ 3) (hi : 1 ≤ i.val) :
    (i - JuliaLean.Strings.ix m).val = i.val - m := by
  have hb := i.property
  change wrapInt .i64 (i.val - wrapInt .i64 m) = i.val - m
  have hmv : wrapInt .i64 m = m :=
    wrapInt_of_inRange .i64 m (by simp [IntTy.min, IntTy.max, IntTy.signed, IntTy.bits]; omega)
  rw [hmv]
  exact wrapInt_of_inRange .i64 _ (by
    simp [IntTy.min, IntTy.max, IntTy.signed, IntTy.bits] at hb ⊢; omega)

theorem thisindStr_pure {S : Type} (ncu : S → Index)
    (cu : Bool → S → Index → Str.StringResult UInt8) (s : S) (rd : Int → UInt8) (i : Index)
    (hcu : ∀ k : Index, 1 ≤ k.val → k.val ≤ (ncu s).val → cu false s k = .ok (rd k.val))
    (hi1 : 1 ≤ i.val) (hin : i.val ≤ (ncu s).val) (hmax : (ncu s).val < 2 ^ 62) :
    ∃ r, JuliaLean.base.strings.string.thisindStr ncu Str.stringBetweenIndex
      Str.stringBetweenByte cu s i = .ok r ∧ r.val = thisindPure rd i.val := by
  have v1 := ixSubVal i 1 (by decide) (by decide) hi1
  have v2 := ixSubVal i 2 (by decide) (by decide) hi1
  have v3 := ixSubVal i 3 (by decide) (by decide) hi1
  have hn1 : (ncu s + JuliaLean.Strings.ix 1).val = (ncu s).val + 1 := by
    have hb := (ncu s).property
    change wrapInt .i64 ((ncu s).val + wrapInt .i64 1) = _
    have h1 : wrapInt .i64 1 = 1 := by decide
    rw [h1]
    exact wrapInt_of_inRange .i64 _ (by
      simp [IntTy.min, IntTy.max, IntTy.signed, IntTy.bits] at hb ⊢; omega)
  have hb0 := hcu i hi1 hin
  have hbtw : Str.stringBetweenIndex i (JuliaLean.Strings.ix 1) (ncu s) = true := by
    simp [Str.stringBetweenIndex, JuliaLean.base.strings.string.between, hin]
    change 1 ≤ i.val
    exact hi1
  have hr1 : 2 ≤ i.val → cu false s (i - JuliaLean.Strings.ix 1) = .ok (rd (i.val - 1)) := by
    intro h; rw [hcu _ (by omega) (by omega), v1]
  have hr2 : 3 ≤ i.val → cu false s (i - JuliaLean.Strings.ix 2) = .ok (rd (i.val - 2)) := by
    intro h; rw [hcu _ (by omega) (by omega), v2]
  have hr3 : 4 ≤ i.val → cu false s (i - JuliaLean.Strings.ix 3) = .ok (rd (i.val - 3)) := by
    intro h; rw [hcu _ (by omega) (by omega), v3]
  have hne0 : (i.val == 0) = false := by simp; omega
  have hneEnd : (i.val == (ncu s + JuliaLean.Strings.ix 1).val) = false := by
    rw [hn1]; simp; omega
  unfold JuliaLean.base.strings.string.thisindStr thisindPure
  simp only [hne0, hneEnd, hbtw, hb0, v1, v2, v3, Bool.false_eq_true, if_false, Bool.not_true,
    bind, Except.bind, pure, Except.pure]
  by_cases c4 : 4 ≤ i.val
  · simp only [hr1 (by omega), hr2 (by omega), hr3 (by omega)]
    split <;> (try split) <;> (try split) <;> (try split) <;> (try split) <;> (try split) <;>
      simp_all
  · by_cases c3 : i.val = 3
    · simp only [hr1 (by omega), hr2 (by omega)]
      split <;> (try split) <;> (try split) <;> (try split) <;> (try split) <;> (try split) <;>
        simp_all
    · by_cases c2 : i.val = 2
      · simp only [hr1 (by omega)]
        split <;> (try split) <;> (try split) <;> (try split) <;> (try split) <;> (try split) <;>
          simp_all
      · have c1 : i.val = 1 := by omega
        split <;> (try split) <;> (try split) <;> (try split) <;> (try split) <;> (try split) <;>
          simp_all


/-- The parent `String`'s byte at 1-based position `k` (`codeunit(s, k)` without the check). -/
def parentByte (s : Raw) (k : Int) : UInt8 := s.bytes.getD (k - 1).toNat 0

theorem stringNcodeunits_val (s : Raw) : (Str.stringNcodeunits s).val = s.bytes.length := by
  have h := s.small
  change wrapInt .i64 (s.bytes.length : Int) = _
  exact wrapInt_of_inRange .i64 _ (by
    simp [IntTy.min, IntTy.max, IntTy.signed, IntTy.bits]; omega)

theorem stringCodeunitAt_unchecked (s : Raw) (k : Index) :
    JuliaLean.base.strings.string.stringCodeunitAt false s k = .ok (parentByte s k.val) := by
  simp [JuliaLean.base.strings.string.stringCodeunitAt, JuliaLean.base.strings.string.codeunitInt,
    JuliaLean.base.strings.string.pointerAt, JuliaLean.base.strings.string.pointerString,
    JuliaLean.base.strings.string.stringUnsafeConvert,
    JuliaLean.base.strings.string.stringPreserveByte,
    JuliaLean.base.strings.string.stringUnsafeLoad, parentByte, pure, Except.pure]

theorem stringIsvalid_iff_pure (s : Raw) (g : Index) (h1 : 1 ≤ g.val)
    (hg : g.val ≤ s.bytes.length) :
    Str.stringIsvalidIndex s g = true ↔ thisindPure (parentByte s) g.val = g.val := by
  have hsmall := s.small
  obtain ⟨r, hr, hrv⟩ := thisindStr_pure Str.stringNcodeunits
    JuliaLean.base.strings.string.stringCodeunitAt s (parentByte s) g
    (fun k _ _ => stringCodeunitAt_unchecked s k) h1
    (by rw [stringNcodeunits_val]; exact hg)
    (by rw [stringNcodeunits_val]; omega)
  have hcb : JuliaLean.base.strings.string.stringCheckboundsBool s g = true := by
    simp [JuliaLean.base.strings.string.stringCheckboundsBool, h1, hg]
  have hthis : JuliaLean.base.strings.string.thisindString Str.stringNcodeunits
      Str.stringBetweenIndex Str.stringBetweenByte
      JuliaLean.base.strings.string.stringCodeunitAt s g = .ok r := hr
  simp only [Str.stringIsvalidIndex, JuliaLean.base.strings.string.isvalidStringIndex, hcb,
    Bool.true_and, hthis, hrv, beq_iff_eq]

theorem viewCodeunitAt_parent (v : View) (k : Index) (hk1 : 1 ≤ k.val)
    (hkn : k.val ≤ v.ncodeunits.val) (hoff : 0 ≤ v.offset.val)
    (hfit : v.offset.val + v.ncodeunits.val ≤ v.string.bytes.length) :
    viewCodeunitAt false v k = .ok (parentByte v.string (v.offset.val + k.val)) := by
  have hsmall := v.string.small
  have hsum : (v.offset + k).val = v.offset.val + k.val := by
    change wrapInt .i64 (v.offset.val + k.val) = _
    exact wrapInt_of_inRange .i64 _ (by
      simp [IntTy.min, IntTy.max, IntTy.signed, IntTy.bits]; omega)
  have hb : viewBounds v k = .ok () := by
    simp [viewBounds, hk1, hkn]
  have hcb : JuliaLean.base.strings.string.stringCheckbounds v.string (v.offset + k) = .ok () := by
    simp [JuliaLean.base.strings.string.stringCheckbounds, hsum]
    omega
  simp [viewCodeunitAt, viewCodeunit, Sub.codeunitSubStringAt, hb, Str.stringCodeunit,
    JuliaLean.base.strings.string.codeunitInteger, JuliaLean.base.strings.string.codeunitInt,
    hcb, JuliaLean.base.strings.string.pointerAt, JuliaLean.base.strings.string.pointerString,
    JuliaLean.base.strings.string.stringUnsafeConvert,
    JuliaLean.base.strings.string.stringPreserveByte,
    JuliaLean.base.strings.string.stringUnsafeLoad, parentByte, hsum, bind, Except.bind,
    pure, Except.pure]

theorem viewThisind_pure (v : View) (i : Index) (hi1 : 1 ≤ i.val)
    (hin : i.val ≤ v.ncodeunits.val) (hoff : 0 ≤ v.offset.val)
    (hfit : v.offset.val + v.ncodeunits.val ≤ v.string.bytes.length) :
    ∃ r, viewThisind v i = .ok r ∧
      r.val = thisindPure (fun x => parentByte v.string (v.offset.val + x)) i.val := by
  have hsmall := v.string.small
  exact thisindStr_pure (fun v : View => v.ncodeunits) viewCodeunitAt v
    (fun x => parentByte v.string (v.offset.val + x)) i
    (fun k hk1 hkn => viewCodeunitAt_parent v k hk1 hkn hoff hfit) hi1 hin (by omega)

/-- The facts every `DenseArg` view satisfies. -/
structure GoodView (v : View) : Prop where
  off : 0 ≤ v.offset.val
  len : 0 ≤ v.ncodeunits.val
  fit : v.offset.val + v.ncodeunits.val ≤ v.string.bytes.length
  start : v.offset.val = 0 ∨ Str.stringIsvalidIndex v.string (v.offset + int 1) = true

theorem goodView_bytes_length (v : View) (h : GoodView v) :
    ((viewBytes v).length : Int) = v.ncodeunits.val := by
  have := h.fit; have := h.off; have := h.len
  simp [viewBytes]
  omega

/-- `thisind(a, astart) == astart` on a good view is `viewBoundary` at `astart - 1`. -/
theorem viewThisind_boundary (p : Prepared) (hg : GoodView p.view) (i : Index)
    (hi1 : 1 ≤ i.val) (hin : i.val ≤ p.view.ncodeunits.val) :
    ∃ r, viewThisind p.view i = .ok r ∧
      ((r.val == i.val) = viewBoundary p (i.val - 1).toNat) := by
  have hsmall := p.view.string.small
  have hoff := hg.off
  have hfit := hg.fit
  obtain ⟨r, hr, hrv⟩ := viewThisind_pure p.view i hi1 hin hg.off hg.fit
  refine ⟨r, hr, ?_⟩
  have hlen := goodView_bytes_length p.view hg
  have hk : ((i.val - 1).toNat : Int) = i.val - 1 := Int.toNat_of_nonneg (by omega)
  by_cases h1 : i.val = 1
  · have hpure : thisindPure (fun x => parentByte p.view.string (p.view.offset.val + x)) i.val
        = i.val := by
      simp [thisindPure, h1]
    have hz : (i.val - 1).toNat = 0 := by omega
    simp [viewBoundary, hz, hrv, hpure]
  · have hlt : (i.val - 1).toNat ≠ (preparedBytes p).length := by
      intro he
      have := congrArg (fun n : Nat => (n : Int)) he
      simp only [preparedBytes] at this
      omega
    have hnz : (i.val - 1).toNat ≠ 0 := by omega
    have hint : (int (p.view.offset.val + Int.ofNat (i.val - 1).toNat + 1)).val =
        p.view.offset.val + i.val := by
      change wrapInt .i64 _ = _
      rw [show p.view.offset.val + Int.ofNat (i.val - 1).toNat + 1 = p.view.offset.val + i.val by
        simp only [Int.ofNat_eq_coe]; omega]
      exact wrapInt_of_inRange .i64 _ (by
        simp [IntTy.min, IntTy.max, IntTy.signed, IntTy.bits]; omega)
    have hvalid := stringIsvalid_iff_pure p.view.string
      (int (p.view.offset.val + Int.ofNat (i.val - 1).toNat + 1)) (by rw [hint]; omega)
      (by rw [hint]; omega)
    rw [hint] at hvalid
    have hstart : p.view.offset.val = 0 ∨
        thisindPure (parentByte p.view.string) (p.view.offset.val + 1) =
          p.view.offset.val + 1 := by
      rcases hg.start with h | h
      · exact Or.inl h
      · right
        have hone : (p.view.offset + int 1).val = p.view.offset.val + 1 := by
          change wrapInt .i64 (p.view.offset.val + wrapInt .i64 1) = _
          rw [show wrapInt .i64 1 = 1 by decide]
          exact wrapInt_of_inRange .i64 _ (by
            simp [IntTy.min, IntTy.max, IntTy.signed, IntTy.bits]; omega)
        have hv := (stringIsvalid_iff_pure p.view.string (p.view.offset + int 1)
          (by rw [hone]; omega) (by rw [hone]; omega)).mp h
        rwa [hone] at hv
    have hview := thisindPure_view (parentByte p.view.string) p.view.offset.val i.val
      hg.off (by omega) hstart
    have hb0 : ((i.val - 1).toNat == 0) = false := by
      first | exact beq_eq_false_iff_ne.mpr hnz | simp [hnz]
    have hbl : ((i.val - 1).toNat == (preparedBytes p).length) = false := by
      first | exact beq_eq_false_iff_ne.mpr hlt | simp [hlt]
    have hvb : viewBoundary p (i.val - 1).toNat = Str.stringIsvalidIndex p.view.string
        (int (p.view.offset.val + Int.ofNat (i.val - 1).toNat + 1)) := by
      unfold viewBoundary
      rw [hb0, hbl]
      simp
    rw [hvb, hrv]
    by_cases hb : thisindPure (parentByte p.view.string) (p.view.offset.val + i.val) =
        p.view.offset.val + i.val
    · have hvt := hvalid.mpr hb
      rw [hvt]
      simpa using hview.mpr hb
    · have hvf : Str.stringIsvalidIndex p.view.string
          (int (p.view.offset.val + Int.ofNat (i.val - 1).toNat + 1)) = false := by
        cases hh : Str.stringIsvalidIndex p.view.string
          (int (p.view.offset.val + Int.ofNat (i.val - 1).toNat + 1)) with
        | false => rfl
        | true => exact absurd (hvalid.mp hh) hb
      rw [hvf]
      simpa using fun h => hb (hview.mp h)

private theorem ixAddOneVal (x : Index) (h0 : 0 ≤ x.val) (h : x.val ≤ 2 ^ 62 + 8) :
    (x + JuliaLean.Strings.ix 1).val = x.val + 1 := by
  change wrapInt .i64 (x.val + wrapInt .i64 1) = _
  rw [show wrapInt .i64 1 = 1 by decide]
  exact wrapInt_of_inRange .i64 _ (by
    simp [IntTy.min, IntTy.max, IntTy.signed, IntTy.bits]; omega)

theorem stringNextind_valid_range (s : Raw) (j : Index) (h1 : 1 ≤ j.val)
    (hj : j.val ≤ s.bytes.length) (hv : Str.stringIsvalidIndex s j = true) :
    ∃ next, Str.stringNextind s j = .ok next ∧ j.val + 1 ≤ next.val ∧
      next.val ≤ s.bytes.length + 1 := by
  have hsmall := s.small
  obtain ⟨r, hr, hrv⟩ := thisindStr_pure Str.stringNcodeunits
    JuliaLean.base.strings.string.stringCodeunitAt s (parentByte s) j
    (fun k _ _ => stringCodeunitAt_unchecked s k) h1
    (by rw [stringNcodeunits_val]; exact hj) (by rw [stringNcodeunits_val]; omega)
  have hpure := (stringIsvalid_iff_pure s j h1 hj).mp hv
  have hrj : r.val = j.val := by rw [hrv, hpure]
  have hthis : JuliaLean.base.strings.string.thisindString Str.stringNcodeunits
      Str.stringBetweenIndex Str.stringBetweenByte
      JuliaLean.base.strings.string.stringCodeunitAt s j = .ok r := hr
  have hn := stringNcodeunits_val s
  have v1 := ixAddOneVal j (by omega) (by omega)
  have v2 := ixAddOneVal (j + JuliaLean.Strings.ix 1) (by rw [v1]; omega) (by rw [v1]; omega)
  rw [v1] at v2
  have v3 := ixAddOneVal (j + JuliaLean.Strings.ix 1 + JuliaLean.Strings.ix 1) (by rw [v2]; omega)
    (by rw [v2]; omega)
  rw [v2] at v3
  have v4 := ixAddOneVal (j + JuliaLean.Strings.ix 1 + JuliaLean.Strings.ix 1 +
    JuliaLean.Strings.ix 1) (by rw [v3]; omega) (by rw [v3]; omega)
  rw [v3] at v4
  have hne0 : (j.val == 0) = false := by simp; omega
  have hbtw : Str.stringBetweenIndex j (JuliaLean.Strings.ix 1) (Str.stringNcodeunits s) = true := by
    simp [Str.stringBetweenIndex, JuliaLean.base.strings.string.between, hn, hj]
    change 1 ≤ j.val
    exact h1
  have hge : r.val ≥ j.val := by omega
  unfold Str.stringNextind JuliaLean.base.strings.string.nextindString
    JuliaLean.base.strings.string.nextindStr
  simp only [hne0, hbtw, stringCodeunitAt_unchecked, hthis, hge, hn, v1, v2, v3, v4,
    Bool.false_eq_true, if_false, if_true, Bool.not_true, decide_true, bind, Except.bind, pure,
    Except.pure]
  split <;> (try split) <;> (try split) <;> (try split) <;> (try split) <;> (try split) <;>
    (try split) <;> (try split) <;> (try split) <;> simp_all <;> omega

theorem prepareView_view {v : View} {p : Prepared} (h : prepareView v = .ok p) : p.view = v := by
  unfold prepareView at h
  cases hl : Sub.lastindexSubString viewThisind v with
  | error e => simp [hl, bind, Except.bind] at h
  | ok l =>
    simp [hl, bind, Except.bind, pure, Except.pure] at h
    rw [← h]

private theorem indexSubVal (a b : Index) (h0 : 0 ≤ a.val - b.val)
    (h1 : a.val - b.val ≤ 2 ^ 62) : (a - b).val = a.val - b.val := by
  change wrapInt .i64 (a.val - b.val) = _
  exact wrapInt_of_inRange .i64 _ (by
    simp [IntTy.min, IntTy.max, IntTy.signed, IntTy.bits]; omega)

theorem substringOne_val : JuliaLean.base.strings.substring.one.val = 1 := by
  change wrapInt .i64 1 = 1
  exact wrapInt_of_inRange .i64 1 (by simp [IntTy.min, IntTy.max, IntTy.signed, IntTy.bits])

theorem rawView_eq (s : Raw) : rawView s = .ok ⟨s, JuliaLean.base.strings.substring.one -
    JuliaLean.base.strings.substring.one, Str.stringNcodeunits s⟩ := by
  have hsmall := s.small
  have hn := stringNcodeunits_val s
  have hone := substringOne_val
  have hsub : Str.stringNcodeunits s - JuliaLean.base.strings.substring.one +
      JuliaLean.base.strings.substring.one = Str.stringNcodeunits s :=
    JuliaLean.Proofs.base.strings.basic.sub_one_add_one (Str.stringNcodeunits s) (by rw [hn]; omega)
  unfold rawView Sub.subStringWhole JuliaLean.base.strings.substring.rawSubstring
  simp only [parentOps]
  simp only [hsub, hone, hn]
  simp [pure, Except.pure]

theorem oneSubOne_val : (JuliaLean.base.strings.substring.one -
    JuliaLean.base.strings.substring.one).val = 0 := by
  rw [indexSubVal _ _ (by omega) (by omega), substringOne_val]
  decide

theorem goodView_rawView (s : Raw) : GoodView ⟨s, JuliaLean.base.strings.substring.one -
    JuliaLean.base.strings.substring.one, Str.stringNcodeunits s⟩ := by
  have hsmall := s.small
  have hn : (Str.stringNcodeunits s).val = s.bytes.length := stringNcodeunits_val s
  have hoff := oneSubOne_val
  constructor
  · show 0 ≤ (JuliaLean.base.strings.substring.one - JuliaLean.base.strings.substring.one).val
    rw [hoff]; exact Int.le_refl 0
  · show 0 ≤ (Str.stringNcodeunits s).val
    rw [hn]; exact Int.natCast_nonneg _
  · show (JuliaLean.base.strings.substring.one - JuliaLean.base.strings.substring.one).val +
      (Str.stringNcodeunits s).val ≤ s.bytes.length
    rw [hoff, hn]; exact Int.le_of_eq (Int.zero_add _)
  · exact Or.inl hoff

theorem goodView_of_rawView (s : Raw) (v : View) (h : rawView s = .ok v) : GoodView v := by
  rw [rawView_eq s] at h
  injection h with h
  subst h
  exact goodView_rawView s

theorem goodView_ofPrepare (s : Raw) (p : Prepared) (hp : prepare s = .ok p) :
    GoodView p.view := by
  unfold prepare at hp
  cases hr : rawView s with
  | error e =>
    rw [hr] at hp
    cases hp
  | ok v =>
    rw [hr] at hp
    have hp' : prepareView v = .ok p := hp
    rw [prepareView_view hp']
    exact goodView_of_rawView s v hr

theorem goodView_ofStringView (s : Raw) (i j : Index) (v : View)
    (hv : stringView s i j = .ok v) : GoodView v := by
  have hone : JuliaLean.base.strings.substring.one.val = 1 := by
    change wrapInt .i64 1 = 1
    exact wrapInt_of_inRange .i64 1 (by simp [IntTy.min, IntTy.max, IntTy.signed, IntTy.bits])
  have hzero : JuliaLean.base.strings.substring.zero.val = 0 := by
    change wrapInt .i64 0 = 0
    exact wrapInt_of_inRange .i64 0 (by simp [IntTy.min, IntTy.max, IntTy.signed, IntTy.bits])
  have hsmall := s.small
  unfold stringView Sub.subStringInt at hv
  by_cases hji : j.val < i.val
  · simp [JuliaLean.base.strings.substring.typedSubString, hji, bind, Except.bind, pure,
      Except.pure] at hv
    subst hv
    exact ⟨by simp only [hzero]; omega, by simp only [hzero]; omega,
      by simp only [hzero]; omega, Or.inl hzero⟩
  · by_cases hb : 1 ≤ i.val ∧ j.val ≤ (s.bytes.length : Int)
    · cases hvi : Str.stringIsvalidIndex s i with
      | false =>
        simp [JuliaLean.base.strings.substring.typedSubString, hji, parentOps, hb, hb.1, hb.2, hvi,
          bind, Except.bind, pure, Except.pure, throw, throwThe, MonadExceptOf.throw] at hv
      | true =>
        cases hvj : Str.stringIsvalidIndex s j with
        | false =>
          simp [JuliaLean.base.strings.substring.typedSubString, hji, parentOps, hb, hb.1, hb.2, hvi,
            hvj, bind, Except.bind, pure, Except.pure, throw, throwThe,
            MonadExceptOf.throw] at hv
        | true =>
          obtain ⟨next, hnext, hlo, hhi⟩ := stringNextind_valid_range s j (by omega)
            (by exact_mod_cast hb.2) hvj
          simp [JuliaLean.base.strings.substring.typedSubString, hji, parentOps, hb, hb.1, hb.2, hvi,
            hvj, hnext, bind, Except.bind, pure, Except.pure] at hv
          subst hv
          have hoffv : (i - JuliaLean.base.strings.substring.one).val = i.val - 1 := by
            rw [indexSubVal _ _ (by rw [hone]; omega) (by rw [hone]; omega), hone]
          have hlenv : (next - i).val = next.val - i.val :=
            indexSubVal _ _ (by omega) (by omega)
          refine ⟨by simp only [hoffv]; omega, by simp only [hlenv]; omega,
            by simp only [hoffv, hlenv]; omega, Or.inr ?_⟩
          have heq : i - JuliaLean.base.strings.substring.one + int 1 = i := by
            apply Subtype.ext
            have hint1 : (int 1).val = 1 := hone
            change wrapInt .i64 ((i - JuliaLean.base.strings.substring.one).val +
              (int 1).val) = i.val
            rw [hoffv, hint1, show i.val - 1 + 1 = i.val by omega]
            exact wrapInt_of_inRange .i64 _ i.property
          simpa [heq] using hvi
    · simp [JuliaLean.base.strings.substring.typedSubString, hji, parentOps, hb,
        bind, Except.bind, pure, Except.pure, throw, throwThe, MonadExceptOf.throw] at hv


theorem denseArg_good (p : Prepared) (h : DenseArg p) : GoodView p.view := by
  cases h with
  | @string s p hp => exact goodView_ofPrepare s p hp
  | @view s i j v p hv hp =>
    rw [prepareView_view hp]
    exact goodView_ofStringView s i j v hv

private theorem revPrefix_iff (A B : List UInt8) (h : B.length ≤ A.length) :
    B.reverse.isPrefixOf A.reverse = true ↔ A.drop (A.length - B.length) = B := by
  first
    | (simp only [List.isPrefixOf_iff_prefix, List.reverse_prefix]
       rw [List.suffix_iff_eq_drop]
       exact ⟨fun h => h.symm, fun h => h.symm⟩)
    | (simp [List.suffix_iff_eq_drop]; exact ⟨fun h => h.symm, fun h => h.symm⟩)
    | (simp [List.suffix_iff_eq_drop])

private theorem revPrefix_long (A B : List UInt8) (h : A.length < B.length) :
    B.reverse.isPrefixOf A.reverse = false := by
  cases hp : B.reverse.isPrefixOf A.reverse with
  | false => rfl
  | true =>
    have hpre : B.reverse <+: A.reverse := List.isPrefixOf_iff_prefix.mp hp
    have hl := hpre.length_le
    simp at hl
    omega

theorem denseSuffixBytesRound6_proven : DenseSuffixBytes := by
  intro a b ha hb
  have ga := denseArg_good a ha
  have gb := denseArg_good b hb
  have hla := goodView_bytes_length a.view ga
  have hlb := goodView_bytes_length b.view gb
  have hsa := a.view.string.small
  have hsb := b.view.string.small
  have hfa := ga.fit
  have hfb := gb.fit
  have hoa := ga.off
  have hob := gb.off
  have key : endswithDense denseOps a b =
      .ok ((preparedBytes b).reverse.isPrefixOf (preparedBytes a).reverse &&
        viewBoundary a ((preparedBytes a).length - (preparedBytes b).length)) := by
    have hA : ((preparedBytes a).length : Int) = a.view.ncodeunits.val := hla
    have hB : ((preparedBytes b).length : Int) = b.view.ncodeunits.val := hlb
    have hast : (a.view.ncodeunits - b.view.ncodeunits + int 1).val =
        a.view.ncodeunits.val - b.view.ncodeunits.val + 1 := by
      change wrapInt .i64 (wrapInt .i64 (a.view.ncodeunits.val - b.view.ncodeunits.val) +
        (int 1).val) = _
      rw [show (int 1).val = 1 by decide,
        wrapInt_of_inRange .i64 (a.view.ncodeunits.val - b.view.ncodeunits.val) (by
          simp [IntTy.min, IntTy.max, IntTy.signed, IntTy.bits]; omega)]
      exact wrapInt_of_inRange .i64 _ (by
        simp [IntTy.min, IntTy.max, IntTy.signed, IntTy.bits]; omega)
    by_cases hlong : (preparedBytes a).length < (preparedBytes b).length
    · have hlt : (a.view.ncodeunits - b.view.ncodeunits + int 1).val < 1 := by
        rw [hast]; omega
      simp [endswithDense, denseOps, hlt, revPrefix_long _ _ hlong, pure, Except.pure]
    · have hle : (preparedBytes b).length ≤ (preparedBytes a).length := by omega
      have hnlt : ¬ (a.view.ncodeunits - b.view.ncodeunits + int 1).val < 1 := by
        rw [hast]; omega
      have hsize : (sizeofString preparedOps b).val = Int.ofNat (preparedBytes b).length := by
        change wrapInt .i64 (b.view.ncodeunits.val * (int 1).val) = _
        rw [show (int 1).val = 1 by decide, Int.mul_one, hB.symm]
        exact wrapInt_of_inRange .i64 _ (by
          simp [IntTy.min, IntTy.max, IntTy.signed, IntTy.bits]; omega)
      have hdropEq : ((a.view.ncodeunits - b.view.ncodeunits + int 1).val - 1).toNat =
          (preparedBytes a).length - (preparedBytes b).length := by
        rw [hast]; omega
      have hdropEq2 : (a.view.ncodeunits - b.view.ncodeunits + int 1).val.toNat - 1 =
          (preparedBytes a).length - (preparedBytes b).length := by
        rw [hast]; omega
      have hxlen : ((preparedBytes a).drop ((preparedBytes a).length -
          (preparedBytes b).length)).length = (preparedBytes b).length := by
        simp; omega
      have hcmp0 := compareBytes_zero_iff
        ((preparedBytes a).drop ((preparedBytes a).length - (preparedBytes b).length))
        (preparedBytes b) (sizeofString preparedOps b) (preparedBytes b).length hsize
        (by omega) (Nat.le_refl _) (by rw [hxlen]; omega)
      have hcmp : compareBytes ((preparedBytes a).drop ((preparedBytes a).length -
          (preparedBytes b).length)) (preparedBytes b) (sizeofString preparedOps b) = 0 ↔
          (preparedBytes a).drop ((preparedBytes a).length - (preparedBytes b).length) =
            preparedBytes b := by
        rw [hcmp0, List.take_of_length_le (by omega), List.take_of_length_le (Nat.le_refl _)]
      have hrev := revPrefix_iff (preparedBytes a) (preparedBytes b) hle
      by_cases hz : compareBytes ((preparedBytes a).drop
          ((preparedBytes a).length - (preparedBytes b).length)) (preparedBytes b)
          (sizeofString preparedOps b) = 0
      · have hmatch : (preparedBytes b).reverse.isPrefixOf (preparedBytes a).reverse = true :=
          hrev.mpr (hcmp.mp hz)
        by_cases hempty : (preparedBytes b).length = 0
        · have hend : (a.view.ncodeunits - b.view.ncodeunits + int 1).val =
              (a.view.ncodeunits + JuliaLean.Strings.ix 1).val := by
            rw [hast]
            change _ = wrapInt .i64 (a.view.ncodeunits.val + wrapInt .i64 1)
            rw [show wrapInt .i64 1 = 1 from wrapInt_of_inRange .i64 1
              (by simp [IntTy.min, IntTy.max, IntTy.signed, IntTy.bits])]
            rw [wrapInt_of_inRange .i64 _ (by
              simp [IntTy.min, IntTy.max, IntTy.signed, IntTy.bits]; omega)]
            omega
          have hne0 : ((a.view.ncodeunits - b.view.ncodeunits + int 1).val == 0) = false := by
            rw [hast]; simp; omega
          have hne0' : ((a.view.ncodeunits + JuliaLean.Strings.ix 1).val == 0) = false := by
            rw [← hend]; exact hne0
          have hth : viewThisind a.view (a.view.ncodeunits - b.view.ncodeunits + int 1) =
              .ok (a.view.ncodeunits - b.view.ncodeunits + int 1) := by
            simp [viewThisind, Sub.thisindSubString, Str.thisindString,
              JuliaLean.base.strings.string.thisindString,
              JuliaLean.base.strings.string.thisindStr, hne0, hne0', hend, pure, Except.pure]
          have hvb : viewBoundary a ((preparedBytes a).length - (preparedBytes b).length) = true := by
            simp [viewBoundary, hempty]
          simp [endswithDense, denseOps, hnlt, hdropEq, hdropEq2, hz, hth, hmatch, hvb, bind,
            Except.bind, pure, Except.pure]
        · obtain ⟨r, hr, hrb⟩ := viewThisind_boundary a ga
            (a.view.ncodeunits - b.view.ncodeunits + int 1) (by rw [hast]; omega)
            (by rw [hast]; omega)
          rw [hdropEq] at hrb
          simp [endswithDense, denseOps, hnlt, hdropEq, hdropEq2, hz, hr, hmatch, ← hrb, bind,
            Except.bind, pure, Except.pure]
      · have hnomatch : (preparedBytes b).reverse.isPrefixOf (preparedBytes a).reverse = false := by
          cases hm : (preparedBytes b).reverse.isPrefixOf (preparedBytes a).reverse with
          | false => rfl
          | true => exact absurd (hcmp.mpr (hrev.mp hm)) hz
        simp [endswithDense, denseOps, hnlt, hdropEq, hdropEq2, hz, hnomatch, bind, Except.bind,
          pure, Except.pure]
  exact ⟨key, key⟩

end JuliaLean.Proofs.base.strings.util.Round6

