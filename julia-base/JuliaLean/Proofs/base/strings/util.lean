    goodView_bytes_length s.view gs
  have hP : ((preparedBytes p).length : Int) = p.view.ncodeunits.val :=
    goodView_bytes_length p.view gp
  have hsmall := s.view.string.small
  have hoff := gs.off
  have hfit := gs.fit
  have hlen := gs.len
  have hone := substringOne_val
  have hwhole : preparedWhole s = .ok ⟨s.view, s.last⟩ := by
    simp [preparedWhole, Sub.subStringWholeView, prepareView, Sub.lastindexSubString,
      Sub.thisindSubString, hlast, bind, Except.bind, pure, Except.pure]
  unfold chopFastSuffixCall chopsuffixFast
  by_cases hpe : (preparedBytes p).length = 0
  · have hie : isemptyString preparedOps p = true := by
      show (p.view.ncodeunits.val == 0) = true
      simp; omega
    have hpnil : preparedBytes p = [] := List.eq_nil_of_length_eq_zero hpe
    refine ⟨_, by simp only [hie, if_true]; rw [hwhole], rfl, ?_⟩
    show preparedBytes s = _
    rw [hpnil]
    simp [viewBoundary]
  · have hie : isemptyString preparedOps p = false := by
      show (p.view.ncodeunits.val == 0) = false
      simp; omega
    have hends : endswithFast denseOps id s p =
        .ok ((preparedBytes p).reverse.isPrefixOf (preparedBytes s).reverse &&
          viewBoundary s ((preparedBytes s).length - (preparedBytes p).length)) :=
      by have h := denseSuffixBytesRound6_proven s p hs hp; dsimp only at h; exact h.2
    simp only [hie, Bool.false_eq_true, if_false]
    rw [hends, ok_bind']
    cases hc : ((preparedBytes p).reverse.isPrefixOf (preparedBytes s).reverse &&
        viewBoundary s ((preparedBytes s).length - (preparedBytes p).length)) with
    | false =>
      refine ⟨_, by simpa using hwhole, rfl, ?_⟩
