/-- The user-stream character branch, including the EOF exception. -/
theorem startswithUserStreamChar {X E Q : Type}
    (ops : PrefixIOOps X UInt32 E) (eofError : E) (unread : X → List UInt8)
    (marked : X → Option (List UInt8)) (member : UInt32 → Q → Bool) (io : X) (set : Q)
    (laws : Round6.StreamLaws ops eofError unread marked) :
    match Round6.firstCharOf (unread io) with
    | none => startswithIOChars ops (fun c q => pure (truth (member c q))) io set =
        ExceptT.mk (some (.error eofError))
    | some (c, _) => ∃ out, startswithIOChars ops (fun c q => pure (truth (member c q))) io set =
        ExceptT.mk (some (.ok (truth (member c set), out))) ∧
        unread out = unread io ∧ marked out = none := by
  obtain ⟨m, hm, hum, hmm⟩ := laws.mark io
  have hread := laws.readChar m
  rw [hum] at hread
  cases hc : Round6.firstCharOf (unread io) with
  | none =>
    simp only [hc] at hread ⊢
    simp [startswithIOChars, liftIn, hm, hread, Bind.bind, ExceptT.bind,
      ExceptT.bindCont, ExceptT.mk, Option.bind]
  | some ck =>
    rcases ck with ⟨c, k⟩
    simp only [hc] at hread ⊢
    obtain ⟨r, hr, _, hmr⟩ := hread
    obtain ⟨out, ho, huo, hmo⟩ := laws.reset r (unread io) (hmr.trans hmm)
    refine ⟨out, ?_, huo, hmo⟩
    simp [startswithIOChars, liftIn, hm, hr, ho, Bind.bind, ExceptT.bind,
      ExceptT.bindCont, ExceptT.mk, Pure.pure, ExceptT.pure, Option.bind]

/-- A failing annotation query precedes width conversion and both padding algorithms. -/
theorem paddingAnnotationError {S C R O N E FS : Type}
    (ops : PadValueOps S C R O N E) (remOps : PadRemainderOps S C R FS E)
    (s p : PadInput S C) (n : N) (err : E) (h : ops.isAnnotated s = .error err) :
    lpad ops remOps s p n = some (.error err) ∧
    rpad ops remOps s p n = some (.error err) := by
  constructor <;> simp [lpad, rpad, h, partialBind, Bind.bind, Except.bind]

/-- The exact malformed UTF-8 padding proposition has a concrete counterexample. -/
theorem StringutilPadMalformed_refuted : ¬ JuliaLean.Proofs.base.strings.util.LpadWidthSuffix :=
  JuliaLean.Proofs.base.strings.util.lpadWidthSuffix_refuted

open Round6

theorem suGetLastMem {α : Type} {xs : List α} {x : α}
    (h : xs.getLast? = some x) : x ∈ xs := by
  induction xs generalizing x with
  | nil => simp at h
  | cons a xs ih =>
    cases xs with
    | nil =>
      simp at h
      subst x
      simp
    | cons b xs =>
      have h' : (b :: xs).getLast? = some x := by simpa using h
      exact List.mem_cons_of_mem a (ih h')

theorem suWalkIndicesAtLeast {S R C CU CT E : Type}
    (prim : StringOps S R C CU CT E) (s : S) (lower : Index)
    {i : Index} {ls : List (Index × C)} (h : lower.val ≤ i.val)
    (w : Walk prim s i ls) :
    ∀ p ∈ ls, lower.val ≤ p.1.val := by
  induction w with
  | stop atEnd done =>
    intro p hp
    simp at hp
  | @step i j c rest hbounds hyield hadvance tail ih =>
    intro p hp
    rcases List.mem_cons.mp hp with hhead | htail
    · subst p
      exact h
    · exact ih (by omega) p htail

theorem suGetLastCons {α : Type} (a : α) (xs : List α) :
    (a :: xs).getLast? = if xs = [] then some a else xs.getLast? := by
  cases xs <;> rfl
theorem suGetLastMap {α β : Type} (f : α → β) (xs : List α) :
    (xs.map f).getLast? = Option.map f xs.getLast? := by
  induction xs with
  | nil => rfl
  | cons a rest ih =>
    cases rest with
    | nil => rfl
    | cons b tail => simpa [List.getLast?] using ih

theorem suWalkLastFacts {S R C CU CT E : Type}
    (prim : StringOps S R C CU CT E) (s : S) {i : Index} {ls : List (Index × C)}
    (w : Walk prim s i ls) :
    ∀ p, ls.getLast? = some p →
      (∃ next, prim.iterateAt s p.1 = .ok (some (p.2, next))) ∧
      (∀ q ∈ ls, q.1.val ≤ p.1.val) ∧
      1 ≤ p.1.val ∧ p.1.val ≤ (prim.ncodeunits s).val := by
  induction w with
  | stop atEnd done =>
    intro p hp
    simp at hp
  | @step i j c rest hbounds hyield hadvance tail ih =>
    intro p hp
    rw [suGetLastCons] at hp
    by_cases hnil : rest = []
    · simp [hnil] at hp
      subst p
      refine ⟨⟨j, hyield⟩, ?_, hbounds.1, hbounds.2⟩
      intro q hq
      rcases List.mem_cons.mp hq with hhead | htail
      · subst q
        omega
      · simp [hnil] at htail
    · simp [hnil] at hp
      have htail := ih p hp
      let next : Index := Classical.choose htail.1
      have hnext : prim.iterateAt s p.1 = .ok (some (p.2, next)) :=
        Classical.choose_spec htail.1
      have hbound := htail.2.1
      have hlo := htail.2.2.1
      have hup := htail.2.2.2
      refine ⟨⟨next, hnext⟩, ?_, hlo, hup⟩
      intro q hq
      rcases List.mem_cons.mp hq with hhead | hrest
      · subst q
        have hmem : p ∈ rest := suGetLastMem hp
        have hstart := suWalkIndicesAtLeast prim s i (by omega) tail p hmem
        omega
      · exact hbound q hrest



theorem suGetLastNoneEqNil {α : Type} {xs : List α} (h : xs.getLast? = none) : xs = [] := by
  cases xs with
  | nil => rfl
  | cons a rest => simp at h

theorem suGetLastSome {α : Type} (a : α) (xs : List α) :
    ∃ x, (a :: xs).getLast? = some x := by
  cases h : xs.getLast? with
  | none =>
    have hnil := suGetLastNoneEqNil h
    subst xs
    exact ⟨a, rfl⟩
  | some x =>
    have hne : xs ≠ [] := by
      intro he
      subst xs
      simp at h
    exact ⟨x, by simp [suGetLastCons, hne, h]⟩


theorem suWalkEndBound {S R C CU CT E : Type}
    (prim : StringOps S R C CU CT E) (s : S) {i : Index} {ls : List (Index × C)}
    (w : Walk prim s i ls) :
    (prim.ncodeunits s).val + 1 ≤ JuliaLean.IntTy.max .i64 := by
  induction w with
  | @stop i atEnd done =>
    have hi := i.property.2
    omega
  | @step i j c rest hbounds hyield hadvance tail ih =>
    exact ih
theorem suWalkStartBound {S R C CU CT E : Type}
    (prim : StringOps S R C CU CT E) (s : S) {i : Index} {ls : List (Index × C)}
    (w : Walk prim s i ls) : i.val ≤ (prim.ncodeunits s).val + 1 := by
  induction w with
  | @stop i atEnd done => omega
  | @step i j c rest hbounds hyield hadvance tail ih => omega


theorem suLawfulLastIndex {S R C CU CT E : Type}
    (prim : StringOps S R C CU CT E) (s : S) (layout : List (Index × C))
    (law : Lawful prim s layout) :
    ∃ last : Index, (gFull prim).lastindex s = .ok last ∧
      0 ≤ last.val ∧ last.val ≤ (prim.ncodeunits s).val ∧
      (layout = [] → last.val = 0) ∧
      (∀ p ∈ layout, p.1.val ≤ last.val) ∧
      (layout ≠ [] → prim.isvalid s last = .ok true) ∧
      (∀ k : Index, last.val < k.val → k.val ≤ (prim.ncodeunits s).val →
        prim.isvalid s k = .ok false) := by
  cases layout with
  | nil =>
    cases law.walk with
    | stop atEnd done =>
      have hn : (prim.ncodeunits s).val = 0 := by
        have hone : (int 1).val = 1 := by decide
        omega
      have hnIndex : prim.ncodeunits s = int 0 := Subtype.ext hn
      refine ⟨int 0, ?_, by decide, by simpa [hn], by simp, ?_, ?_, ?_⟩
      · have hp : (int 0 + int 1).val = 1 := by decide
        simp [gFull, modelStringOps, lastindexString, thisindInt, thisindLoop, hnIndex, hp]
      · simp
      · simp
      · intro k hlo hhi
        have hz : (int 0).val = 0 := by decide
        omega
  | cons first rest =>
    obtain ⟨last, hlast⟩ := suGetLastSome first rest
    have hf := suWalkLastFacts prim s law.walk last hlast
    have hmem := suGetLastMem hlast
    have hv : prim.isvalid s last.1 = .ok true := by
      have h := law.isvalid last.1 hf.2.2.1 hf.2.2.2
      have ha : ((first :: rest).any (fun p => p.1.val == last.1.val)) = true :=
        List.any_eq_true.mpr ⟨last, hmem, by simp⟩
      simpa [ha] using h
    have hinv : ∀ k : Index, last.1.val < k.val → k.val ≤ (prim.ncodeunits s).val →
        prim.isvalid s k = .ok false := by
      intro k hlo hhi
      have ha : ((first :: rest).any (fun p => p.1.val == k.val)) = false := by
        cases hh : ((first :: rest).any (fun p => p.1.val == k.val)) with
        | false => rfl
        | true =>
          obtain ⟨p, hp, heq⟩ := List.any_eq_true.mp hh
          have hpBound := hf.2.1 p hp
          have heq' : p.1.val = k.val := by simpa using beq_iff_eq.mp heq
          omega
      simpa [ha] using law.isvalid k (by omega) hhi
    refine ⟨last.1, ?_, by omega, hf.2.2.2, by simp, hf.2.1, fun _ => hv, hinv⟩
    have h := JuliaLean.Proofs.base.strings.basic.thisindInt_rewind prim s
      (prim.ncodeunits s) last.1 hf.2.2.1 hf.2.2.2 (Int.le_refl _)
      (suWalkEndBound prim s law.walk) (Or.inr hv) (fun k hk => hinv k hk.1 hk.2)
    simpa [gFull, modelStringOps, lastindexString] using h

theorem suWalkSuffix {S R C CU CT E : Type}
    (prim : StringOps S R C CU CT E) (s : S) {i : Index}
    {pairs : List (Index × C)} (walk : Walk prim s i pairs)
    (before suffix : List (Index × C)) (hsplit : pairs = before ++ suffix) :
    ∃ j, Walk prim s j suffix := by
  induction before generalizing i pairs with
  | nil => exact ⟨i, by simpa [hsplit] using walk⟩
  | cons p before ih =>
    cases walk with
    | stop atEnd done => simp at hsplit
    | @step i j c rest bounds yield advances tail =>
      have ht : rest = before ++ suffix := (List.cons.inj hsplit).2
      exact ih tail ht

theorem suWalkSplitEarlier {S R C CU CT E : Type}
    (prim : StringOps S R C CU CT E) (s : S) {start : Index}
    {layout : List (Index × C)} (walk : Walk prim s start layout)
    (before : List (Index × C)) (i : Index) (c : C) (rest : List (Index × C))
    (hsplit : layout = before ++ (i,c) :: rest) :
    ∀ p ∈ before, p.1.val < i.val := by
  induction before generalizing start layout with
  | nil => simp
  | cons p before ih =>
    cases walk with
    | stop atEnd done => simp at hsplit
    | @step start next d tail bounds yield advances wtail =>
      have hp : (start,d) = p := (List.cons.inj hsplit).1
      have ht : tail = before ++ (i,c) :: rest := (List.cons.inj hsplit).2
      have hmem : (i,c) ∈ tail := by rw [ht]; simp
      have hlo : next.val ≤ i.val := suWalkIndicesAtLeast prim s next (Int.le_refl _) wtail (i,c) hmem
      intro q hq
      rcases List.mem_cons.mp hq with hq | hq
      · subst q
        have hpv : p.1.val = start.val := congrArg (fun p : Index × C => p.1.val) hp.symm
        omega
      · exact ih wtail ht q hq

theorem suLawfulAdjacentPrevAffix {S R C CU CT E : Type}
    (prim : StringOps S R C CU CT E) (s : S) (layout : List (Index × C))
    (law : Lawful prim s layout) (before : List (Index × C))
    (q : Index) (d : C) (p : Index) (c : C) (after : List (Index × C))
    (hsplit : layout = before ++ (q,d) :: (p,c) :: after) :
    previndOne (gFull prim) s p = .ok q := by
  obtain ⟨start,hw⟩ := suWalkSuffix prim s law.walk before ((q,d) :: (p,c) :: after) hsplit
  cases hw with
  | @step q p d rest bq yq aq wtail =>
    cases wtail with
    | @step p next c after bp yp ap wafter =>
      have hvalidQ : prim.isvalid s q = .ok true := by
        have hm : (q,d) ∈ layout := by rw [hsplit]; simp
        have ha : layout.any (fun a => a.1.val == q.val) = true :=
          List.any_eq_true.mpr ⟨(q,d),hm,by simp⟩
        simpa [ha] using law.isvalid q bq.1 bq.2
      have hinv : ∀ k : Index, q.val < k.val ∧ k.val < p.val →
          prim.isvalid s k = .ok false := by
        intro k hk
        have ha : layout.any (fun a => a.1.val == k.val) = false := by
          cases hh : layout.any (fun a => a.1.val == k.val) with
          | false => rfl
          | true =>
