namespace Round13

open JuliaLean.Proofs.base.strings.util
open JuliaLean.Proofs.base.strings.util.Round6

/-- The generic and String/SubString chomp methods return views with equal string content.
The docstring promises a SubString and removal of one trailing newline (`base/strings/util.jl:353-391`). -/
def ChompGeneric : Prop :=
  ∀ s : Prepared, DenseArg s →
    ∃ genericOut fastOut,
      chompCall s = .ok genericOut ∧ chompFastCall s = .ok fastOut ∧
      preparedBytes genericOut = preparedBytes fastOut

/-- The String/SubString specialization removes one trailing LF and a preceding CR when present.
Source: `base/strings/util.jl:353-391`. -/
def ChompFastCharacters : Prop :=
  ∀ s : Prepared, DenseArg s →
    ∃ out, chompFastCall s = .ok out ∧
      preparedBytes out = chompSpec (preparedBytes s)

