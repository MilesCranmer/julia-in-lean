  rw [JuliaLean.Proofs.base.int.wrapInt_sub_left, JuliaLean.Proofs.base.int.wrapInt_sub_right]

theorem iMul (a b : Int) : B.i a * B.i b = B.i (a * b) := by
  apply Subtype.ext
  change wrapInt .i64 (wrapInt .i64 a * wrapInt .i64 b) = wrapInt .i64 (a * b)
  rw [JuliaLean.Proofs.base.int.wrapInt_mul_left, JuliaLean.Proofs.base.int.wrapInt_mul_right]

theorem uVal (n : Nat) (hn : n < 2 ^ 64) : (B.u n).val = (n : Int) := by
  change wrapInt .u64 n = (n : Int)
  apply wrapInt_of_inRange
  change 0 ≤ (n : Int) ∧ (n : Int) ≤ 18446744073709551615
  omega

theorem remUInt (n : Nat) (hn : n < 2 ^ 64) :
    JInt.rem .i64 (B.u n) = B.i n := by
  apply Subtype.ext
  change wrapInt .i64 (B.u n).val = wrapInt .i64 n
  rw [uVal n hn]

theorem convertNat (n : Nat) (hn : n < 2 ^ 63) : B.toI n = .ok (B.i n) := by
  have hr : IntTy.i64.min ≤ (n : Int) ∧ (n : Int) ≤ IntTy.i64.max := by
    change -9223372036854775808 ≤ (n : Int) ∧ (n : Int) ≤ 9223372036854775807
    omega
  unfold B.toI JInt.convert
  rw [dif_pos hr]
  apply congrArg Except.ok
  apply Subtype.ext
  change (n : Int) = (B.i n).val
  exact (iVal (n : Int) (by omega) (by omega)).symm

theorem bitLengthBound (fuel n : Nat) : B.bitLength fuel n ≤ fuel := by
  induction fuel generalizing n with
  | zero => exact Nat.le_refl 0
  | succ fuel ih =>
    simp only [B.bitLength]
    split <;> (have := ih (n / 2); omega)

theorem overallocationBound (n : B.I) (hn : 0 ≤ n.val) :
    n.val ≤ (B.overallocation n).val ∧ (B.overallocation n).val ≤ 2 ^ 63 - 1 := by
  have nmax := n.property.2
  change n.val ≤ 9223372036854775807 at nmax
  unfold B.overallocation
  have hneg : ¬ n.val < 0 := by omega
  simp only [hneg, ↓reduceIte]
  generalize hb : B.bitLength 64 n.val.toNat = bits
  have hb64 : bits ≤ 64 := hb ▸ bitLengthBound 64 _
  have he : bits * 7 / 8 ≤ 56 := by omega
  have hp1 := Nat.pow_le_pow_right (by decide : 2 > 0) he
  have hp0 := Nat.pow_le_pow_right (by decide : 2 > 0) (Nat.zero_le (bits * 7 / 8))
  have hc : ((2 ^ (bits * 7 / 8) : Nat) : Int) = (2 : Int) ^ (bits * 7 / 8) :=
    Int.natCast_pow 2 _
  generalize (2 : Int) ^ (bits * 7 / 8) = x at *
  have hx1 : x ≤ 2 ^ 56 := by omega
  have hx0 : 1 ≤ x := by simp only [Nat.pow_zero] at hp0; omega
  have ht : n.val.tdiv 8 = n.val / 8 := Int.tdiv_eq_ediv_of_nonneg hn
  have hex : (B.i x * B.i 3 + B.i (n.val.tdiv 8)).val = x * 3 + n.val / 8 := by
    rw [iMul, iAdd, ht, iVal _ (by omega) (by omega)]
  have him : B.imaxval.val = 2 ^ 63 - 1 := by decide
  have hsub : (B.imaxval - (B.i x * B.i 3 + B.i (n.val.tdiv 8))).val =
      2 ^ 63 - 1 - (x * 3 + n.val / 8) := by
    change wrapInt .i64 (B.imaxval.val - (B.i x * B.i 3 + B.i (n.val.tdiv 8)).val) = _
    rw [him, hex]
    apply wrapInt_of_inRange
    change -9223372036854775808 ≤ 2 ^ 63 - 1 - (x * 3 + n.val / 8) ∧
      2 ^ 63 - 1 - (x * 3 + n.val / 8) ≤ 9223372036854775807
    omega
  rw [hsub]
  split
  · rw [him]; omega
  · rename_i hroom
    have hsum : (n + (B.i x * B.i 3 + B.i (n.val.tdiv 8))).val =
        n.val + (x * 3 + n.val / 8) := by
      change wrapInt .i64 (n.val + (B.i x * B.i 3 + B.i (n.val.tdiv 8)).val) = _
      rw [hex]
      apply wrapInt_of_inRange
      change -9223372036854775808 ≤ n.val + (x * 3 + n.val / 8) ∧
        n.val + (x * 3 + n.val / 8) ≤ 9223372036854775807
      omega
    rw [hsum]
    omega

abbrev buffer (data : List UInt8) (len : Nat) : B.BufferState where
  data := data
  isMemory := true
  reinit := false
  readable := true
  writable := true
  seekable := true
  append := false
  size := B.i len
  maxsize := B.imaxval
  ptr := B.i ((len : Int) + 1)
  offset := B.i 0
  mark := B.i (-1)

theorem newBuffer : JuliaLean.base.strings.io.newBufferState
    (JuliaLean.base.iobuffer.bitsConversions .i64) none =
    .ok (buffer (List.replicate 32 0) 0) := by
  rfl

theorem bufferOffset (data : List UInt8) (len : Nat) :
    B.getOffset (buffer data len) = B.i 0 := by rfl

theorem bufferSpan (data : List UInt8) (len : Nat) :
    B.getUsedSpan (buffer data len) = .ok (B.i 1, B.i len) := by rfl

theorem ensureForm (data : List UInt8) (len : Nat) (n : B.U) :
    (B.ensureroom n).run (buffer data len) =
      (let existing := B.imin (B.i data.length - (B.i ((len : Int) + 1) - B.i 1))
        (B.imaxval - ((B.i ((len : Int) + 1) - B.i 1) - B.i 0))
       if existing.val < (JInt.rem .i64 n).val then
         (B.ensureroomSlowpath n existing).run (buffer data len)
       else .ok () (buffer data len)) := by
  simp only [B.ensureroom, EStateM.run, Bind.bind, EStateM.bind, get, getThe,
    MonadStateOf.get, EStateM.get, Bool.not_true, Bool.false_or, Bool.false_eq_true,
    ↓reduceIte, bufferOffset, Pure.pure, EStateM.pure]
  split <;> simp_all only [EStateM.pure, ↓reduceIte]

/-- Normalize the slow path before specializing its state or integer arguments. -/
theorem slowResizeGeneral (st : B.BufferState) (n : B.U) (avail count desired last : B.I)
    (hspan : B.getUsedSpan st = .ok (B.i 1, last))
    (hconvert : B.toI n.val = .ok count)
    (hdesired : B.i st.data.length + count - avail = desired)
    (hnot : ¬ desired.val > st.maxsize.val) :
    (B.ensureroomSlowpath n avail).run st = (B.resize desired false).run st := by
  unfold B.ensureroomSlowpath
  generalize B.resize = resizeAction
  simp only [EStateM.run, Bind.bind, EStateM.bind, get, getThe,
    MonadStateOf.get, EStateM.get, hspan, B.lift, iSub, Int.sub_self,
    show (B.i 0).val = 0 from rfl, show ¬ (0 : Int) ≥ 32 by decide,
    false_and, ↓reduceIte, hconvert, hdesired, hnot, Pure.pure, EStateM.pure]

theorem slowResize (data : List UInt8) (len : Nat) (n : B.U) (avail count : B.I)
    (hconvert : B.toI n.val = .ok count)
    (hnot : ¬ (B.i data.length + count - avail).val > B.imaxval.val) :
    (B.ensureroomSlowpath n avail).run (buffer data len) =
      (B.resize (B.i data.length + count - avail) false).run (buffer data len) := by
  exact slowResizeGeneral (buffer data len) n avail count _ (B.i len)
    (bufferSpan data len) hconvert rfl hnot

theorem rangeLengthOne (len : Nat) (hlen : len < 2 ^ 63) :
    B.rangeLength (B.i 1) (B.i len) = B.i len := by
  unfold B.rangeLength
  have hone : (B.i 1).val = 1 := by decide
  rw [iVal _ (by omega) (by omega), hone]
  by_cases hz : len = 0
  · subst len
    rfl
  · rw [if_neg (by omega), iSub, iAdd]
    apply congrArg B.i
    omega

/-- The native resize result with all intermediate values kept abstract. -/
theorem resizeBufferGeneral (st : B.BufferState) (desired cap a b used : B.I)
    (fresh final : List UInt8)
    (hcap : B.imin st.maxsize (B.overallocation desired) = cap)
    (hspan : B.getUsedSpan st = .ok (a, b))
    (halloc : B.similarData st cap = .ok fresh)
    (hnz : cap.val ≠ 0) (hused : B.rangeLength a b = used)
    (hcopy : (if used.val = 0 then Except.ok fresh
      else B.copyto fresh (B.i 1) st.data a used) = .ok final) :
    (B.resize desired false).run st =
      .ok () { st with
        data := final
        offset := -B.getCompacted st - ((a - B.i 1) - B.getOffset st)
        ptr := st.ptr - (a - B.i 1)
        size := used } := by
  unfold B.resize
  generalize B.copyto = copyAction at hcopy ⊢
  generalize B.similarData = allocateData at halloc ⊢
  simp only [EStateM.run, Bind.bind, EStateM.bind, get, getThe,
    MonadStateOf.get, EStateM.get, Bool.false_eq_true, ↓reduceIte,
    hcap, hspan, B.lift, Pure.pure, EStateM.pure, halloc, hnz,
    hused, set, MonadStateOf.set, EStateM.set]
  by_cases hz : used.val = 0
  · simp only [hz, ↓reduceIte] at hcopy ⊢
    cases hcopy
    rfl
  · simp only [hz, ↓reduceIte] at hcopy ⊢
    simp only [hcopy, B.lift, Bind.bind, EStateM.bind, Pure.pure, EStateM.pure,
      set, MonadStateOf.set, EStateM.set]

theorem resizeBuffer (data : List UInt8) (len desired cap : Nat)
    (hlen : len < 2 ^ 63) (hdata : len ≤ data.length)
    (hcap : 0 < cap) (hcapsmall : cap < 2 ^ 63) (hfit : len ≤ cap)
    (hc : B.imin B.imaxval (B.overallocation (B.i desired)) = B.i cap) :
    (B.resize (B.i desired) false).run (buffer data len) =
      .ok () (buffer (data.take len ++ List.replicate (cap - len) 0) len) := by
  have hv : (B.i len).val = (len : Int) := iVal _ (by omega) (by omega)
  have hcv : (B.i cap).val = (cap : Int) := iVal _ (by omega) (by omega)
  have hspan : B.getUsedSpan (buffer data len) = .ok (B.i 1, B.i len) := by rfl
  have hsm : B.similarData (buffer data len) (B.i cap) = .ok (List.replicate cap 0) := by
    simp only [B.similarData, buffer, ↓reduceIte, B.stringMemory, hcv,
      show ¬ (cap : Int) < 0 by omega, ↓reduceIte, Int.toNat_natCast]
  have hcopy : B.copyto (List.replicate cap 0) (B.i 1) data (B.i 1) (B.i len) =
      .ok (data.take len ++ List.replicate (cap - len) 0) := by
    by_cases hz : len = 0
    · subst len
      simp only [B.copyto, hv, Int.natCast_zero, show (B.i 0).val = 0 from rfl, ↓reduceIte,
        List.take_zero, Nat.sub_zero, List.nil_append]
    · have hone : (B.i 1).val = 1 := by decide
      have hbounds : 1 ≤ (B.i 1).val ∧ (B.i 1).val + (B.i len).val - 1 ≤
          (List.replicate cap (0 : UInt8)).length ∧ 1 ≤ (B.i 1).val ∧
          (B.i 1).val + (B.i len).val - 1 ≤ data.length := by
        rw [hone, hv, List.length_replicate]
        omega
      simp only [B.copyto, hv, show (len : Int) ≠ 0 by omega,
        show ¬ (len : Int) < 0 by omega, ↓reduceIte, hone,
        List.length_replicate, show 1 + (len : Int) - 1 = len by omega,
        show (len : Int) ≤ cap by omega, show (len : Int) ≤ data.length by omega,
        Int.reduceLE, and_self, ↓reduceIte, List.take_zero, List.nil_append,
        B.slice, Int.reduceSub, Int.reduceToNat, List.drop_zero,
        Int.zero_add, Int.sub_add_cancel, Int.toNat_natCast, List.drop_replicate]
  have hcopyResult : (if (B.i len).val = 0 then Except.ok (List.replicate cap 0)
      else B.copyto (List.replicate cap 0) (B.i 1) data (B.i 1) (B.i len)) =
      .ok (data.take len ++ List.replicate (cap - len) 0) := by
    by_cases hz : len = 0
    · subst len
      simp only [hv, Int.natCast_zero, show (B.i 0).val = 0 from rfl, ↓reduceIte, List.take_zero,
        Nat.sub_zero, List.nil_append]
    · rw [if_neg (by rw [hv]; omega)]
      exact hcopy
  rw [resizeBufferGeneral (buffer data len) (B.i desired) (B.i cap) (B.i 1) (B.i len)
    (B.i len) (List.replicate cap 0) _ hc hspan hsm (by rw [hcv]; omega)
    (rangeLengthOne len hlen) hcopyResult]
  have hp : (buffer data len).ptr - (B.i 1 - B.i 1) = (buffer data len).ptr := by
    change B.i ((len : Int) + 1) - (B.i 1 - B.i 1) = _
    rw [iSub, iSub]
    apply congrArg B.i
    omega
  rw [hp]
  rfl

theorem takeBuffer (data : List UInt8) (len : Nat) (hlen : len < 2 ^ 63) :
    JuliaLean.base.strings.io.takeStringBufferState (buffer data len) =
      .ok (data.take len) := by
  have hv : (B.i len).val = (len : Int) := iVal _ (by omega) (by omega)
  have hspan : B.getUsedSpan (buffer data len) = .ok (B.i 1, B.i len) := by
    rfl
  have hr : B.rangeLength (B.i 1) (B.i len) = B.i len := by
    unfold B.rangeLength
    have hone : (B.i 1).val = 1 := by decide
    rw [hv, hone]
    by_cases hz : len = 0
    · subst len
      rfl
    · rw [if_neg (by omega), iSub, iAdd]
      apply congrArg B.i
      omega
  have hslice : B.slice data (B.i 1).val (len : Int) = data.take len := by
    change (data.drop 0).take (((len : Int) - 1 + 1).toNat) = _
    simp only [Int.sub_add_cancel, Int.toNat_natCast, List.drop_zero]
  unfold JuliaLean.base.strings.io.takeStringBufferState
  unfold B.takestring
  simp only [buffer, EStateM.run, Bind.bind, EStateM.bind, get, getThe,
    MonadStateOf.get, EStateM.get, Bool.not_true, Bool.false_eq_true, ↓reduceIte,
    ]
  change (match (do
      let (a, b) ← B.lift (B.getUsedSpan (buffer data len))
      let s := if (B.rangeLength a b).val = 0 then [] else B.slice data a.val b.val
      set { JuliaLean.base.iobuffer.resetTaken (buffer data len) with mark := B.i (-1) }
      pure s : B.M (List UInt8)).run (buffer data len) with
    | .ok bytes _ => Except.ok bytes
    | .error err _ => Except.error err) = _
  rw [hspan]
  simp only [B.lift, EStateM.run, Bind.bind, EStateM.bind, Pure.pure, EStateM.pure,
    hr, hv, hslice, set, MonadStateOf.set, EStateM.set]
  by_cases hz : len = 0
  · subst len; rfl
  · simp only [show (len : Int) ≠ 0 by omega, ↓reduceIte]


