private theorem ensureOneRoom (data : List UInt8) (len : Nat)
    (hroom : len < data.length) (hcap : data.length < 2 ^ 63) :
    (B.ensureroom (B.u 1)).run (buffer data len) = .ok () (buffer data len) := by
  obtain ⟨existing, hexisting⟩ : ∃ existing : B.I,
      existing = B.imin (B.i data.length - (B.i ((len : Int) + 1) - B.i 1))
        (B.imaxval - ((B.i ((len : Int) + 1) - B.i 1) - B.i 0)) := ⟨_, rfl⟩
  have hs : B.i ((len : Int) + 1) - B.i 1 = B.i len := by
    rw [iSub]
    apply congrArg B.i
    omega
  have hleft : (B.i data.length - B.i len).val = (data.length : Int) - len := by
    rw [iSub, iVal _ (by omega) (by omega)]
  have hright : (B.imaxval - (B.i len - B.i 0)).val = 2 ^ 63 - 1 - len := by
    change (B.i (2 ^ 63 - 1) - (B.i len - B.i 0)).val = _
    rw [iSub, iSub, iVal _ (by omega) (by omega)]
    omega
  have he : 1 ≤ existing.val := by
    rw [hexisting, hs]
    unfold B.imin
    split <;> simp only [hleft, hright] <;> omega
  rw [ensureForm, ← hexisting]
  rw [show (JInt.rem .i64 (B.u 1)).val = 1 by decide]
  rw [if_neg (Int.not_lt.mpr he)]

private theorem writeByteResult (b : UInt8) (io ready : B.BufferState)
    (newData : List UInt8)
    (hens : (B.ensureroom (B.u 1)).run io = .ok () ready)
    (happend : ready.append = false)
    (hfit : ¬ (ready.ptr - B.getOffset ready).val > ready.maxsize.val)
    (hset : B.setChecked ready.data ready.ptr b = .ok newData) :
    (B.writeByte b).run io =
      .ok (B.i 1) { ready with
        data := newData
        size := B.imax ready.size ready.ptr
        ptr := ready.ptr + B.i 1 } := by
  unfold B.writeByte
  generalize B.ensureroom = ensureAction at hens ⊢
  generalize B.setChecked = writeCell at hset ⊢
  simp only [EStateM.run, Bind.bind, EStateM.bind] at hens ⊢
  rw [hens]
  simp only [get, getThe, MonadStateOf.get, EStateM.get, happend,
    Bool.false_eq_true, ↓reduceIte, hfit, hset, B.lift,
    Bind.bind, EStateM.bind, Pure.pure, EStateM.pure, set, MonadStateOf.set, EStateM.set]

private theorem writeByteAfterEnsure (b : UInt8) (io ready : B.BufferState)
    (hens : (B.ensureroom (B.u 1)).run io = .ok () ready)
    (hready : (B.ensureroom (B.u 1)).run ready = .ok () ready) :
    (B.writeByte b).run io = (B.writeByte b).run ready := by
  unfold B.writeByte
  generalize B.ensureroom = ensureAction at hens hready ⊢
  simp only [EStateM.run, Bind.bind, EStateM.bind] at hens hready ⊢
  rw [hens, hready]

private theorem writeOneRoom (data : List UInt8) (len : Nat) (b : UInt8)
    (hroom : len < data.length) (hcap : data.length < 2 ^ 63) :
    (B.writeByte b).run (buffer data len) =
      .ok (B.i 1) (buffer (data.set len b) (len + 1)) := by
  have hp : (B.i ((len : Int) + 1)).val = (len : Int) + 1 :=
    iVal _ (by omega) (by omega)
  have hl : (B.i len).val = (len : Int) := iVal _ (by omega) (by omega)
  have hsub : (B.i ((len : Int) + 1) - B.i 0).val = (len : Int) + 1 := by
    rw [iSub, iVal _ (by omega) (by omega)]
    omega
  have hset : B.setChecked data (B.i ((len : Int) + 1)) b = .ok (data.set len b) := by
    simp only [B.setChecked, hp, show 1 ≤ (len : Int) + 1 by omega,
      show (len : Int) + 1 ≤ data.length by omega, and_self, ↓reduceIte]
    simp only [Int.add_sub_cancel, Int.toNat_natCast]
  have hmax : B.imax (B.i len) (B.i ((len : Int) + 1)) = B.i ((len : Int) + 1) := by
    simp only [B.imax, hl, hp, show ¬ (len : Int) + 1 < len by omega, ↓reduceIte]
  have hnot : ¬ ((buffer data len).ptr - B.getOffset (buffer data len)).val >
      (buffer data len).maxsize.val := by
    rw [bufferOffset]
    change ¬ (B.i ((len : Int) + 1) - B.i 0).val > 9223372036854775807
    rw [hsub]
    omega
  have hwrite := writeByteResult b (buffer data len) (buffer data len) (data.set len b)
    (ensureOneRoom data len hroom hcap) rfl hnot hset
  have hstate : { buffer data len with
      data := data.set len b
      size := B.imax (buffer data len).size (buffer data len).ptr
      ptr := (buffer data len).ptr + B.i 1 } =
      buffer (data.set len b) (len + 1) := by
    unfold buffer
    rw [hmax, iAdd]
    simp only [Int.natCast_add, Int.natCast_one]
  exact hwrite.trans (congrArg (EStateM.Result.ok (B.i 1)) hstate)

private theorem takeSetNext (data : List UInt8) (len : Nat) (b : UInt8)
    (hroom : len < data.length) :
    (data.set len b).take (len + 1) = data.take len ++ [b] := by
  rw [List.take_succ_eq_append_getElem (by simpa only [List.length_set] using hroom)]
  rw [List.getElem_set_self]
  rw [List.take_set, List.set_eq_of_length_le (by
    simp only [List.length_take]
    exact Nat.min_le_left _ _)]

private theorem ensureOneFull (data : List UInt8) (len : Nat)
    (hfull : data.length = len) (hlen : len + 1 < 2 ^ 63) :
    (B.ensureroom (B.u 1)).run (buffer data len) =
      (B.resize (B.i ((len : Int) + 1)) false).run (buffer data len) := by
  have hv : (B.i ((len : Int) + 1)).val = (len : Int) + 1 :=
    iVal _ (by omega) (by omega)
  have hs : B.i ((len : Int) + 1) - B.i 1 = B.i len := by
    rw [iSub]
    apply congrArg B.i
    omega
  have he : B.imin (B.i data.length - (B.i ((len : Int) + 1) - B.i 1))
      (B.imaxval - ((B.i ((len : Int) + 1) - B.i 1) - B.i 0)) = B.i 0 := by
    rw [hs, hfull]
    simp only [B.imaxval, iSub, Int.sub_self, Int.sub_zero]
    have hr := iVal (2 ^ 63 - 1 - (len : Int)) (by omega) (by omega)
    simp only [B.imin, hr, show (B.i 0).val = 0 from rfl,
      show ¬ 2 ^ 63 - 1 - (len : Int) < 0 by omega, ↓reduceIte]
  have hd : B.i data.length + B.i 1 - B.i 0 = B.i ((len : Int) + 1) := by
    simp only [hfull, iAdd, iSub, Int.sub_zero]
  have hnot : ¬ (B.i data.length + B.i 1 - B.i 0).val > B.imaxval.val := by
    rw [hd, hv]
    change ¬ (len : Int) + 1 > 9223372036854775807
    omega
  rw [ensureForm, he]
  have hz : (B.i 0).val < (JInt.rem .i64 (B.u 1)).val := by decide
  rw [if_pos hz, slowResize data len (B.u 1) (B.i 0) (B.i 1) (by rfl) hnot, hd]

private theorem ensureOne (data : List UInt8) (len : Nat)
    (hfits : len ≤ data.length) (hcap : data.length < 2 ^ 63)
    (hlen : len + 1 < 2 ^ 63) :
    ∃ nextData,
      (B.ensureroom (B.u 1)).run (buffer data len) = .ok () (buffer nextData len) ∧
      len < nextData.length ∧ nextData.length < 2 ^ 63 ∧ nextData.take len = data.take len := by
  by_cases hroom : len < data.length
  · exact ⟨data, ensureOneRoom data len hroom hcap, hroom, hcap, rfl⟩
  · have hfull : data.length = len := by omega
    generalize hresized : B.overallocation (B.i ((len : Int) + 1)) = resized
    have hv : (B.i ((len : Int) + 1)).val = (len : Int) + 1 :=
      iVal _ (by omega) (by omega)
    have hbounds := overallocationBound (B.i ((len : Int) + 1)) (by rw [hv]; omega)
    rw [hresized] at hbounds
    have hc0 : 0 ≤ resized.val := by rw [hv] at hbounds; omega
    let cap := resized.val.toNat
    have hcapval : (cap : Int) = resized.val := Int.toNat_of_nonneg hc0
    have hcsmall : cap < 2 ^ 63 := by omega
    have hcpositive : 0 < cap := by rw [hv] at hbounds; omega
    have hcfit : len < cap := by rw [hv] at hbounds; omega
    have heq : B.imin B.imaxval resized = B.i cap := by
      apply Subtype.ext
      rw [iVal _ (by omega) (by omega), hcapval]
      unfold B.imin
      split
      · rfl
      · have hm : B.imaxval.val = 2 ^ 63 - 1 := by decide
        simp only [hm]
        omega
    let nextData := data.take len ++ List.replicate (cap - len) 0
    have hnlength : nextData.length = cap := by
      simp only [nextData, List.length_append, List.length_take, List.length_replicate,
        Nat.min_eq_left hfits]
      omega
    refine ⟨nextData, ?_, by rw [hnlength]; exact hcfit,
      by rw [hnlength]; exact hcsmall, ?_⟩
    · rw [ensureOneFull data len hfull hlen]
      exact resizeBuffer data len (len + 1) cap (by omega) hfits hcpositive hcsmall
        (by omega) (by simpa only [Int.natCast_add, Int.natCast_one, hresized] using heq)
    · simp only [nextData, List.take_append, List.length_take, Nat.min_eq_left hfits,
        Nat.sub_self, List.take_zero, List.append_nil, List.take_take, Nat.min_self]

private theorem writeOne (data : List UInt8) (len : Nat) (b : UInt8)
    (hfits : len ≤ data.length) (hcap : data.length < 2 ^ 63)
    (hlen : len + 1 < 2 ^ 63) :
    ∃ nextData,
      (B.writeByte b).run (buffer data len) = .ok (B.i 1) (buffer nextData (len + 1)) ∧
      len + 1 ≤ nextData.length ∧ nextData.length < 2 ^ 63 ∧
      nextData.take (len + 1) = data.take len ++ [b] := by
  obtain ⟨ready, hens, hroom, hreadycap, hcontent⟩ := ensureOne data len hfits hcap hlen
  refine ⟨ready.set len b, ?_, by simp only [List.length_set]; omega,
    by simpa only [List.length_set] using hreadycap, ?_⟩
  · rw [writeByteAfterEnsure b (buffer data len) (buffer ready len) hens
      (ensureOneRoom ready len hroom hreadycap)]
    exact writeOneRoom ready len b hroom hreadycap
  · rw [takeSetNext ready len b hroom, hcontent]

private theorem printAscii (charOfByte : UInt8 → UInt32)
    (installed : CharOfByteInstalled charOfByte) (io : B.BufferState)
    (b : UInt8) (hb : b.toNat < 128) :
    JuliaLean.base.strings.io.printCharBufferState io (charOfByte b) =
      match (B.writeByte b).run io with
      | .ok _ next => .ok next
      | .error err _ => .error err := by
  have hc : charOfByte b = JuliaLean.base.char.shl32 b.toUInt32 24 := by
    apply installed
    simp only [JuliaLean.base.char.char_SmallInteger,
      show b.toNat ≤ 0x7f by omega, decide_true, ↓reduceIte]
  have bits : bswap32 (JuliaLean.base.char.shl32 b.toUInt32 24) = b.toUInt32 ∧
      (b.toUInt32 &&& 0xff).toUInt8 = b ∧ b.toUInt32 >>> 8 = 0 := by
    have all : ∀ k : Fin 256, let b := UInt8.ofNat k.val;
        bswap32 (JuliaLean.base.char.shl32 b.toUInt32 24) = b.toUInt32 ∧
        (b.toUInt32 &&& 0xff).toUInt8 = b ∧ b.toUInt32 >>> 8 = 0 := by
      decide +kernel
    simpa only [UInt8.ofNat_toNat] using all ⟨b.toNat, b.toFin.isLt⟩
  rw [hc]
  unfold JuliaLean.base.strings.io.printCharBufferState
    JuliaLean.base.strings.io.writeCharBufferState
  rw [bits.1]
  simp only [JuliaLean.base.strings.io.writeCharBufferStateLoop, bits.2.1, bits.2.2,
    beq_self_eq_true, ↓reduceIte]
  cases hw : (B.writeByte b).run io <;>
    simp only [EStateM.run, Bind.bind, EStateM.bind, Pure.pure, EStateM.pure] at hw ⊢ <;>
    rw [hw] <;> rfl

private theorem ensureInitial (n : Nat) (hn : n < 2 ^ 63) :
    ∃ cap, (B.ensureroom (B.u n)).run (buffer (List.replicate 32 0) 0) =
      .ok () (buffer (List.replicate cap 0) 0) ∧
      n ≤ cap ∧ cap < 2 ^ 63 := by
  have hu : (B.u n).val = (n : Int) := uVal n (by omega)
  have hr : JInt.rem .i64 (B.u n) = B.i n := remUInt n (by omega)
  have hv : (B.i n).val = (n : Int) := iVal _ (by omega) (by omega)
  have hexisting : B.imin
      (B.i (List.replicate 32 (0 : UInt8)).length - (B.i ((0 : Int) + 1) - B.i 1))
      (B.imaxval - ((B.i ((0 : Int) + 1) - B.i 1) - B.i 0)) = B.i 32 := by decide
  rw [ensureForm]
  simp only [Int.natCast_zero]
  rw [hexisting, hr]
  by_cases hsmall : n ≤ 32
  · refine ⟨32, ?_, hsmall, by decide⟩
    have hbranch : ¬ (B.i 32).val < (B.i n).val := by
      rw [hv]
      change ¬ 32 < (n : Int)
      omega
    rw [if_neg hbranch]
  · have hn32 : 32 < n := by omega
    generalize hresized : B.overallocation (B.i n) = resized
    have hbounds := overallocationBound (B.i n) (by rw [hv]; omega)
    rw [hresized] at hbounds
    have hc0 : 0 ≤ resized.val := by rw [hv] at hbounds; omega
    obtain ⟨cap, hcapval⟩ : ∃ cap : Nat, (cap : Int) = resized.val :=
      ⟨resized.val.toNat, Int.toNat_of_nonneg hc0⟩
    have hcsmall : cap < 2 ^ 63 := by omega
    have hcpositive : 0 < cap := by rw [hv] at hbounds; omega
    have hcfit : n ≤ cap := by rw [hv] at hbounds; omega
    have heq : B.imin B.imaxval resized = B.i cap := by
      apply Subtype.ext
      rw [iVal _ (by omega) (by omega), hcapval]
      unfold B.imin
      split
      · rfl
      · have hm : B.imaxval.val = 2 ^ 63 - 1 := by decide
        simp only [hm]
        omega
    have hd : B.i (List.replicate 32 (0 : UInt8)).length + B.i n - B.i 32 = B.i n := by
      simp only [List.length_replicate, iAdd, iSub]
      apply congrArg B.i
      omega
    have hnot : ¬ (B.i (List.replicate 32 (0 : UInt8)).length + B.i n - B.i 32).val > B.imaxval.val := by
      rw [hd, hv]
      change ¬ (n : Int) > 9223372036854775807
      omega
    refine ⟨cap, ?_, hcfit, hcsmall⟩
    have hbranch : (B.i 32).val < (B.i n).val := by
      rw [hv]
      change 32 < (n : Int)
      omega
    rw [if_pos hbranch]
    rw [slowResizeGeneral (buffer (List.replicate 32 0) 0) (B.u n)
      (B.i 32) (B.i n) (B.i n) (B.i 0) (bufferSpan _ 0)
      (by rw [hu]; exact convertNat n hn) hd (by rw [hd] at hnot; exact hnot)]
    have h := resizeBuffer (List.replicate 32 0) 0 n cap (by decide)
      (by simp only [List.length_replicate]; omega) hcpositive hcsmall (by omega)
      (by rw [hresized]; exact heq)
    simpa only [List.take_zero, Nat.sub_zero, List.nil_append] using h

private def rawUnsafeWrite (signed : Int → B.I) (unsigned : Int → B.U)
    (maximum minimum : B.I → B.I → B.I) (minUnsigned : B.U → B.U → B.U)
    (toSigned : B.U → B.I) (toUnsigned : B.I → B.U)
    (offset : B.BufferState → B.I)
    (store : Bool → List UInt8 → B.I → List UInt8 → Except B.IOErr (List UInt8))
    (ensure : B.U → B.M Unit) (src : List UInt8) : B.M B.I := do
  let nb : B.U := unsigned src.length
  ensure nb
  let io ← get
  let size := io.size
  let append := io.append
  let ptr := if append then size + signed 1 else io.ptr
  let start := ptr - signed 1
  let inner := minimum (signed io.data.length - start) (io.maxsize - (start - offset io))
  let toWrite := maximum (signed 0) (toSigned (minUnsigned nb (toUnsigned inner)))
  let data ← B.lift (store io.isMemory io.data ptr (src.take toWrite.val.toNat))
  set { io with data, size := maximum size (start + toWrite),
                ptr := if append then io.ptr else ptr + toWrite }
  return toWrite

private theorem rawUnsafeWriteEq (src : List UInt8) :
    B.unsafeWrite src = rawUnsafeWrite B.i B.u B.imax B.imin B.uminU
      (JInt.rem .i64) (JInt.rem .u64) B.getOffset B.writeAt B.ensureroom src := by
  rfl

private theorem rawUnsafeWriteRun (signed : Int → B.I) (unsigned : Int → B.U)
    (maximum minimum : B.I → B.I → B.I) (minUnsigned : B.U → B.U → B.U)
    (toSigned : B.U → B.I) (toUnsigned : B.I → B.U)
    (offset : B.BufferState → B.I)
    (store : Bool → List UInt8 → B.I → List UInt8 → Except B.IOErr (List UInt8))
    (ensure : B.U → B.M Unit) (src : List UInt8)
    (io ready : B.BufferState) (count : B.I) (newData : List UInt8)
    (hens : (ensure (unsigned src.length)).run io = .ok () ready)
    (happend : ready.append = false)
    (hcount : maximum (signed 0) (toSigned (minUnsigned (unsigned src.length)
      (toUnsigned (minimum (signed ready.data.length - (ready.ptr - signed 1))
        (ready.maxsize - (ready.ptr - signed 1 - offset ready)))))) = count)
    (hwrite : store ready.isMemory ready.data ready.ptr
      (src.take count.val.toNat) = .ok newData) :
    (rawUnsafeWrite signed unsigned maximum minimum minUnsigned toSigned toUnsigned offset store ensure src).run io = .ok count
      { ready with
        data := newData
        size := maximum ready.size (ready.ptr - signed 1 + count)
        ptr := ready.ptr + count } := by
  simp only [rawUnsafeWrite, EStateM.run, Bind.bind, EStateM.bind] at hens ⊢
  rw [hens]
  simp only [get, getThe, MonadStateOf.get, EStateM.get, happend,
    Bool.false_eq_true, ↓reduceIte]
  rw [hcount, hwrite]
  rfl

private theorem unsafeWriteResult (src : List UInt8) (io ready : B.BufferState)
    (count : B.I) (newData : List UInt8)
    (hens : (B.ensureroom (B.u src.length)).run io = .ok () ready)
    (happend : ready.append = false)
    (hcount : B.imax (B.i 0) (JInt.rem .i64 (B.uminU (B.u src.length)
      (JInt.rem .u64 (B.imin (B.i ready.data.length - (ready.ptr - B.i 1))
        (ready.maxsize - (ready.ptr - B.i 1 - B.getOffset ready)))))) = count)
    (hwrite : B.writeAt ready.isMemory ready.data ready.ptr
      (src.take count.val.toNat) = .ok newData) :
    (B.unsafeWrite src).run io = .ok count
      { ready with
        data := newData
        size := B.imax ready.size (ready.ptr - B.i 1 + count)
        ptr := ready.ptr + count } := by
  rw [rawUnsafeWriteEq]
  exact rawUnsafeWriteRun B.i B.u B.imax B.imin B.uminU
    (JInt.rem .i64) (JInt.rem .u64) B.getOffset B.writeAt B.ensureroom src
    io ready count newData hens happend hcount hwrite

private theorem writeBytesResult (src : List UInt8) (io next : B.BufferState) (count : B.I)
    (hw : (B.unsafeWrite src).run io = .ok count next) :
    JuliaLean.base.strings.io.writeBytesBufferState io src = .ok (next, count) := by
  unfold JuliaLean.base.strings.io.writeBytesBufferState
  rw [hw]

private theorem writeInitial (before : List UInt8) (hn : before.length < 2 ^ 63) :
    ∃ data, JuliaLean.base.strings.io.writeBytesBufferState
        (buffer (List.replicate 32 0) 0) before =
      .ok (buffer data before.length, B.i before.length) ∧
      before.length ≤ data.length ∧ data.length < 2 ^ 63 ∧
      data.take before.length = before := by
  obtain ⟨cap, hens, hfits, hcap⟩ := ensureInitial before.length hn
  let data := before ++ List.replicate (cap - before.length) 0
  have hlen : data.length = cap := by
    simp only [data, List.length_append, List.length_replicate]
    omega
  have hv := iVal (before.length : Int) (by omega) (by omega)
  have hcv := iVal (cap : Int) (by omega) (by omega)
  have hinner : B.imin (B.i cap - (B.i 1 - B.i 1))
      (B.imaxval - (B.i 1 - B.i 1 - B.i 0)) = B.i cap := by
    simp only [B.imaxval, iSub, Int.sub_self, Int.sub_zero]
    have hm : (B.i (2 ^ 63 - 1)).val = 9223372036854775807 := by decide
    simp only [B.imin, hcv, hm, show ¬ 9223372036854775807 < (cap : Int) by omega,
      ↓reduceIte]
  have hurem : JInt.rem .u64 (B.i cap) = B.u cap := by
    apply Subtype.ext
    change wrapInt .u64 (B.i cap).val = wrapInt .u64 cap
    rw [hcv]
  have hmin : B.uminU (B.u before.length) (JInt.rem .u64 (B.i cap)) = B.u before.length := by
    rw [hurem]
    unfold B.uminU
    rw [uVal _ (by omega), uVal _ (by omega), if_neg (by omega)]
  have hmax : B.imax (B.i 0) (B.i before.length) = B.i before.length := by
    simp only [B.imax, hv, show (B.i 0).val = 0 from rfl,
      show ¬ (before.length : Int) < 0 by omega, ↓reduceIte]
  have hwrite : B.writeAt true (List.replicate cap 0) (B.i 1) before = .ok data := by
    by_cases hz : before = []
    · subst before
      simp only [B.writeAt, data, List.length_nil, ↓reduceIte, Nat.sub_zero, List.nil_append]
    · have hnz : before.length ≠ 0 := by
        intro hzero
        exact hz (List.eq_nil_of_length_eq_zero hzero)
      simp only [B.writeAt, hnz, ↓reduceIte, show (B.i 1).val = 1 from rfl,
        List.length_replicate, show (1 : Int) ≤ 1 by decide,
        show 1 + (before.length : Int) - 1 ≤ cap by omega, and_self, ↓reduceIte,
        Int.sub_self, Int.toNat_zero, List.take_zero, List.nil_append,
        Int.zero_add, Int.sub_add_cancel, Int.toNat_natCast, List.drop_replicate, data]
  refine ⟨data, ?_, by rw [hlen]; exact hfits, by rw [hlen]; exact hcap, ?_⟩
  · apply writeBytesResult
    have hcount : B.imax (B.i 0) (JInt.rem .i64 (B.uminU (B.u before.length)
        (JInt.rem .u64 (B.imin
          (B.i (buffer (List.replicate cap 0) 0).data.length -
            ((buffer (List.replicate cap 0) 0).ptr - B.i 1))
          ((buffer (List.replicate cap 0) 0).maxsize -
            ((buffer (List.replicate cap 0) 0).ptr - B.i 1 -
              B.getOffset (buffer (List.replicate cap 0) 0))))))) = B.i before.length := by
      rw [bufferOffset (List.replicate cap 0) 0]
      simp only [buffer, List.length_replicate, Int.natCast_zero, Int.zero_add]
      rw [hinner, hmin, remUInt _ (by omega), hmax]
    have hwrite' : B.writeAt (buffer (List.replicate cap 0) 0).isMemory
        (buffer (List.replicate cap 0) 0).data (buffer (List.replicate cap 0) 0).ptr
        (before.take (B.i before.length).val.toNat) = .ok data := by
      simpa only [buffer, Int.natCast_zero, Int.zero_add, hv, Int.toNat_natCast,
        List.take_length] using hwrite
    have h := unsafeWriteResult before (buffer (List.replicate 32 0) 0)
      (buffer (List.replicate cap 0) 0) (B.i before.length) data hens rfl hcount hwrite'
    have hp : (1 : Int) + before.length = (before.length : Int) + 1 := by omega
    simpa only [buffer, Int.natCast_zero, Int.zero_add, iSub, iAdd,
      Int.sub_self, hmax, hp] using h
  · simp only [data, List.take_append, List.take_length, Nat.sub_self,
      List.take_zero, List.append_nil]

private theorem digitFacts (b : UInt8) :
    installedHexChar (hexHighIndex b) = lowerHexDigit (b.toNat / 16) ∧
    installedHexChar (hexLowIndex b) = lowerHexDigit (b.toNat % 16) ∧
    (lowerHexDigit (b.toNat / 16)).toNat < 128 ∧
    (lowerHexDigit (b.toNat % 16)).toNat < 128 := by
  have all : ∀ k : Fin 256, let b := UInt8.ofNat k.val;
      installedHexChar (hexHighIndex b) = lowerHexDigit (b.toNat / 16) ∧
      installedHexChar (hexLowIndex b) = lowerHexDigit (b.toNat % 16) ∧
      (lowerHexDigit (b.toNat / 16)).toNat < 128 ∧
      (lowerHexDigit (b.toNat % 16)).toNat < 128 := by decide +kernel
  simpa only [UInt8.ofNat_toNat] using all ⟨b.toNat, b.toFin.isLt⟩

private theorem printAsciiSuccess (charOfByte : UInt8 → UInt32)
    (installed : CharOfByteInstalled charOfByte) (io next : B.BufferState)
    (b : UInt8) (hb : b.toNat < 128)
    (hw : (B.writeByte b).run io = .ok (B.i 1) next) :
    JuliaLean.base.strings.io.printCharBufferState io (charOfByte b) = .ok next := by
  rw [printAscii charOfByte installed io b hb, hw]

private theorem printTwoSuccess (io mid out : B.BufferState) (first second : UInt32)
    (hf : JuliaLean.base.strings.io.printCharBufferState io first = .ok mid)
    (hs : JuliaLean.base.strings.io.printCharBufferState mid second = .ok out) :
    JuliaLean.base.strings.io.printTwoCharsBufferState io first second = .ok out := by
  unfold JuliaLean.base.strings.io.printTwoCharsBufferState
  generalize JuliaLean.base.strings.io.printCharBufferState = printAction at hf hs ⊢
  simp only [hf, bind, Except.bind, hs]

private theorem ioLoopYieldSuccess {IO C St E : Type}
    (hexChar : Index → UInt8) (charOfByte : UInt8 → C)
    (print : IO → C → C → Except E IO) (b : UInt8) (st : St)
    (next : St → IterSteps UInt8 St E) (io mid : IO)
    (hp : print io (charOfByte (hexChar (hexHighIndex b)))
      (charOfByte (hexChar (hexLowIndex b))) = .ok mid) :
    bytes2hexIOLoop hexChar charOfByte print (.yield b st next) io =
      bytes2hexIOLoop hexChar charOfByte print (next st) mid := by
  simp only [bytes2hexIOLoop, hp, bind, Except.bind]

private theorem printPair (charOfByte : UInt8 → UInt32)
    (installed : CharOfByteInstalled charOfByte) (data : List UInt8) (len : Nat) (b : UInt8)
    (hfits : len ≤ data.length) (hcap : data.length < 2 ^ 63)
    (hlen : len + 2 < 2 ^ 63) :
    ∃ nextData,
      JuliaLean.base.strings.io.printTwoCharsBufferState (buffer data len)
        (charOfByte (installedHexChar (hexHighIndex b)))
        (charOfByte (installedHexChar (hexLowIndex b))) = .ok (buffer nextData (len + 2)) ∧
      len + 2 ≤ nextData.length ∧ nextData.length < 2 ^ 63 ∧
      nextData.take (len + 2) = data.take len ++ lowerHexBytes [b] := by
  have hd := digitFacts b
  obtain ⟨first, hw1, hf1, hc1, hs1⟩ :=
    writeOne data len (lowerHexDigit (b.toNat / 16)) hfits hcap (by omega)
  obtain ⟨second, hw2, hf2, hc2, hs2⟩ :=
    writeOne first (len + 1) (lowerHexDigit (b.toNat % 16)) hf1 hc1 (by omega)
  refine ⟨second, ?_, hf2, hc2, ?_⟩
  · rw [hd.1, hd.2.1]
    exact printTwoSuccess _ _ _ _ _
      (printAsciiSuccess charOfByte installed _ _ _ hd.2.2.1 hw1)
      (printAsciiSuccess charOfByte installed _ _ _ hd.2.2.2 hw2)
  · rw [hs2, hs1]
    simp only [lowerHexBytes, List.flatMap_cons, List.flatMap_nil, List.append_nil,
      List.append_assoc, List.cons_append, List.nil_append]

private theorem ioLoop (charOfByte : UInt8 → UInt32)
    (installed : CharOfByteInstalled charOfByte) {St : Type}
    (steps : IterSteps UInt8 St StreamError) (bytes : List UInt8)
    (hsteps : collectIterSteps steps = .ok bytes)
    (data : List UInt8) (len : Nat)
    (hfits : len ≤ data.length) (hcap : data.length < 2 ^ 63)
    (hlen : len + 2 * bytes.length < 2 ^ 63) :
    ∃ nextData,
      bytes2hexIOLoop installedHexChar charOfByte
        JuliaLean.base.strings.io.printTwoCharsBufferState steps (buffer data len) =
        .ok (buffer nextData (len + 2 * bytes.length)) ∧
      len + 2 * bytes.length ≤ nextData.length ∧ nextData.length < 2 ^ 63 ∧
      nextData.take (len + 2 * bytes.length) = data.take len ++ lowerHexBytes bytes := by
  induction steps generalizing bytes data len with
  | done =>
    cases hsteps
    exact ⟨data, rfl, hfits, hcap, by
      simp only [List.length_nil, Nat.mul_zero, Nat.add_zero, lowerHexBytes,
        List.flatMap_nil, List.append_nil]⟩
  | fail err => cases hsteps
  | yield b st next ih =>
    cases ht : collectIterSteps (next st) with
    | error err => simp only [collectIterSteps, ht, bind, Except.bind, reduceCtorEq] at hsteps
    | ok bs =>
      have heq : bytes = b :: bs := by
        simpa only [collectIterSteps, ht, bind, Except.bind, pure, Except.pure,
          Except.ok.injEq] using hsteps.symm
      subst bytes
      obtain ⟨mid, hp, hmfit, hmcap, hmstr⟩ := printPair charOfByte installed data len b
        hfits hcap (by simp only [List.length_cons] at hlen; omega)
      obtain ⟨out, hout, hofit, hocap, hostr⟩ := ih st bs ht mid (len + 2) hmfit hmcap (by
        simp only [List.length_cons] at hlen; omega)
      have hlenEq : len + 2 + 2 * bs.length = len + 2 * (b :: bs).length := by
        simp only [List.length_cons]; omega
      rw [hlenEq] at hout hofit hostr
      refine ⟨out, ?_, hofit, hocap, ?_⟩
      · rw [ioLoopYieldSuccess _ _ _ _ _ _ _ _ hp]
        exact hout
      · rw [hostr, hmstr]
        simp only [lowerHexBytes, List.flatMap_cons, List.flatMap_nil, List.append_nil,
          List.append_assoc, List.cons_append, List.nil_append]

theorem genericPart :
    ∀ {IO St E : Type} [MonadExceptOf JuliaLean.base.show.ShowError (StateT IO (ExceptT E Id))]
    (ops : JuliaLean.base.strings.io.CharIO (StateT IO (ExceptT E Id)) Unit Unit)
      (emb : JuliaLean.base.iobuffer.IOErr → E) (charOfByte : UInt8 → UInt32)
      (steps : IterSteps UInt8 St E) (io : IO),
    CharOfByteInstalled charOfByte →
    let call := fun (isUInt8 : Bool) =>
      bytes2hexIO (fun _ : Unit => steps) (fun _ => isUInt8) installedHexChar charOfByte
        (printDigitPair ops) (fun m => emb (.jl (.argumentError m))) io ()
    (∀ bytes, collectIterSteps steps = .ok bytes →
      call true = printDigitsOf ops charOfByte bytes io) ∧
    (∀ bytes e, StepsFail steps bytes e →
      call true = (printDigitsOf ops charOfByte bytes io).bind (fun _ => .error e)) ∧
    call false = .error (emb (.jl (.argumentError "eltype of iterator not UInt8"))) := by
  intro IO St E _ ops emb charOfByte steps io hc
  have h := Round6.bytes2hexIO_generic_proven ops
    (fun m => emb (JuliaLean.base.iobuffer.IOErr.jl (.argumentError m))) charOfByte steps io hc
  exact ⟨h.1, h.2.1, rfl⟩

private theorem ioCallTrue {IO C St E : Type}
    (steps : IterSteps UInt8 St E) (hexChar : Index → UInt8)
    (charOfByte : UInt8 → C) (print : IO → C → C → Except E IO)
    (argumentError : String → E) (io : IO) :
    bytes2hexIO (fun _ : Unit => steps) (fun _ => true) hexChar charOfByte print
      argumentError io () = bytes2hexIOLoop hexChar charOfByte print steps io := by
  rfl

private theorem bufferPipeline {IO E : Type}
    (newBuffer : Except E IO) (write : IO → List UInt8 → Except E (IO × Index))
    (call : IO → Except E IO) (take : IO → Except E (List UInt8))
    (before out : List UInt8) (initial written final : IO) (n : Index)
    (hn : newBuffer = .ok initial) (hw : write initial before = .ok (written, n))
    (hc : call written = .ok final) (ht : take final = .ok out) :
    (do let io ← newBuffer
        let (io, _) ← write io before
        let io ← call io
        take io) = .ok out := by
  simp only [hn, hw, hc, ht, bind, Except.bind]

theorem installedBufferPart :
    ∀ {St : Type} (charOfByte : UInt8 → UInt32)
      (steps : IterSteps UInt8 St StreamError) (bytes before : List UInt8),
    CharOfByteInstalled charOfByte →
    collectIterSteps steps = .ok bytes →
    before.length + 2 * bytes.length ≤ JuliaLean.IntTy.i64.max.toNat →
    (do
      let io ← JuliaLean.base.strings.io.newBufferState
        (JuliaLean.base.iobuffer.bitsConversions .i64) none
      let (io, _) ← JuliaLean.base.strings.io.writeBytesBufferState io before
      let io ← bytes2hexIO (fun _ : Unit => steps) (fun _ => true) installedHexChar charOfByte
        JuliaLean.base.strings.io.printTwoCharsBufferState
        (fun m => .jl (.argumentError m)) io ()
      JuliaLean.base.strings.io.takeStringBufferState io) =
        .ok (before ++ lowerHexBytes bytes) := by
  intro St charOfByte steps bytes before installed hsteps hbound
  have hmax : JuliaLean.IntTy.i64.max.toNat = 2 ^ 63 - 1 := by decide
  rw [hmax] at hbound
  obtain ⟨initial, hi, hifit, hicap, histr⟩ := writeInitial before (by omega)
  obtain ⟨out, ho, hofit, hocap, hostr⟩ :=
    ioLoop charOfByte installed steps bytes hsteps initial before.length hifit hicap (by omega)
  rw [histr] at hostr
  apply bufferPipeline _ _ _ _ before _ _ _ _ _ newBuffer hi
  · exact ho
  · rw [takeBuffer out (before.length + 2 * bytes.length) (by omega), hostr]


end HexIO

theorem StringutilBytes2hexIoCharacters_proven : Round6.Bytes2hexIOCharacters :=
  ⟨HexIO.genericPart, HexIO.installedBufferPart⟩

