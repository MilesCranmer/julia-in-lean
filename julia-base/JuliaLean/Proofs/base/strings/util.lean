private theorem firstMinimum (xs : List Index) (hne : xs ≠ []) :
    ∃ (x : Nat) (m : Index), xs[x]? = some m ∧
      ∀ (y : Nat) (v : Index), xs[y]? = some v →
        m.val < v.val ∨ (m.val = v.val ∧ x ≤ y) := by
  induction xs with
  | nil => contradiction
  | cons head tail ih =>
    cases tail with
    | nil =>
      refine ⟨0, head, by simp, ?_⟩
      intro y v hget
      cases y with
      | zero =>
        simp at hget
        cases hget
        exact Or.inr ⟨rfl, by omega⟩
      | succ y => simp at hget
    | cons second rest =>
      obtain ⟨k, m, hgetTail, hminTail⟩ := ih (by simp)
      by_cases hle : head.val ≤ m.val
      · refine ⟨0, head, by simp, ?_⟩
        intro y v hget
        cases y with
        | zero =>
          simp at hget
          cases hget
          exact Or.inr ⟨rfl, by omega⟩
        | succ y =>
          have htail : (second :: rest)[y]? = some v := by simpa using hget
          have hmin := hminTail y v htail
          rcases hmin with hlt | ⟨heq, hleY⟩
          · exact Or.inl (by omega)
          · by_cases heqHead : head.val = m.val
            · exact Or.inr ⟨by omega, by omega⟩
            · exact Or.inl (by omega)
      · refine ⟨k + 1, m, by simpa [Nat.add_comm] using hgetTail, ?_⟩
        intro y v hget
        cases y with
        | zero =>
          simp at hget
          cases hget
          exact Or.inl (by omega)
        | succ y =>
          have htail : (second :: rest)[y]? = some v := by simpa using hget
          have hmin := hminTail y v htail
          rcases hmin with hlt | ⟨heq, hleY⟩
          · exact Or.inl hlt
          · exact Or.inr ⟨heq, by omega⟩

noncomputable def argminForFirst (xs : List Index) : Index :=
  if hnil : xs = [] then int 0
  else if hsingle : xs.length = 1 then int 1
  else int (Classical.choose (firstMinimum xs hnil) + 1)

theorem argminForFirstLaw : ArgminFirst argminForFirst := by
  intro xs x m hget hmin
  cases xs with
  | nil => simp at hget
  | cons head tail =>
    have hne : head :: tail ≠ [] := by simp
    by_cases hsingle : (head :: tail).length = 1
    · have htail : tail = [] := by cases tail with | nil => rfl | cons b rest => simp at hsingle
      subst tail
      have hx : x = 0 := by
        cases x with
        | zero => rfl
        | succ x => simp at hget
      simp [argminForFirst, hne, hsingle, hx]
    · let hcan := firstMinimum (head :: tail) hne
      let k0 := Classical.choose hcan
      let htail := Classical.choose_spec hcan
      let m0 := Classical.choose htail
      have hspec := Classical.choose_spec htail
      have hk0 : (head :: tail)[k0]? = some m0 := by simpa [k0, m0] using hspec.1
      have h1 := hmin k0 m0 hk0
      have h2 : m0.val < m.val ∨ (m0.val = m.val ∧ k0 ≤ x) := by
        simpa [k0, m0] using hspec.2 x m hget
      have hk : k0 = x := by
        rcases h1 with hlt | ⟨heq, hle⟩ <;>
          rcases h2 with hlt' | ⟨heq', hle'⟩ <;> omega
      have hchoose : Classical.choose (firstMinimum (head :: tail) hne) = x := by
        simpa [hcan, k0] using hk
      have htailne : tail ≠ [] := by
        intro h
        subst tail
        simp at hsingle
      simpa [argminForFirst, hne, hsingle, htailne] using
        congrArg (fun k : Nat => int (k + 1)) hchoose

