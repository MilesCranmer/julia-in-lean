namespace JuliaLean.Proofs.base.strings.util.Round11

open JuliaLean JuliaLean.base.strings.basic JuliaLean.base.strings.util JuliaLean.base.iobuffer JuliaLean.Registry
open JuliaLean.Proofs.base.strings.util
open JuliaLean.Proofs.base.strings.util.Round6

/-- The state-shape conditions of `stateInvariant`, omitting only `0 ≤ maxsize`, which is not guaranteed by `IOBuffer(data; truncate=true, maxsize=...)`. Source: base/iobuffer.jl:33-107,120-125,148-151,230-243. -/
def PublicIOBufferStateShape (io : Stream) : Prop :=
  0 ≤ io.size.val ∧ io.size.val ≤ io.data.length ∧
  getOffset io ≤ io.size ∧ io.ptr ≥ getOffset io + i 1 ∧ io.ptr ≤ io.size + i 1 ∧
  io.mark.val ≥ -1 ∧ (io.mark.val ≥ 0 → io.mark.val ≤ (logicalSize io).val) ∧
  0 ≤ (position io).val ∧ (position io).val ≤ (logicalSize io).val ∧
  (io.reinit → io.size = i 0 ∧ io.ptr = i 1 ∧ io.offset = i 0)

/-- Generic print and fallback clauses are unchanged. Buffer writes cover both append modes on every public state-shape, including negative maxsize; the count is the installed position delta. Source: base/strings/util.jl:1013-1022; base/iobuffer.jl:33-107,916-919. -/
def ReplacementShownByteCount : Prop :=
  (∀ {IO R S Pat E : Type} (position : IO → Except E Index) (print : IO → R → Except E IO)
    (repr : R → String) (write : IO → String → Except E (IO × Index))
    (io : IO) (repl : R) (str : S) (range : ReplaceRange) (pattern : Pat),
    (∀ (io' : IO) (p : Index) (w : Nat), position io = .ok p → print io repl = .ok io' →
      position io' = .ok (p + int w) → 0 ≤ p.val → p.val + w < 2 ^ 63 →
      replaceShown (fun _ => true) position print repr write io repl str range pattern =
        .ok (io', int w)) ∧
    (∀ e, position io = .error e →
      replaceShown (fun _ => true) position print repr write io repl str range pattern =
        .error e) ∧
    (∀ p e, position io = .ok p → print io repl = .error e →
      replaceShown (fun _ => true) position print repr write io repl str range pattern =
        .error e) ∧
    (∀ io' p e, position io = .ok p → print io repl = .ok io' → position io' = .error e →
      replaceShown (fun _ => true) position print repr write io repl str range pattern =
        .error e) ∧
    replaceShown (fun _ => false) position print repr write io repl str range pattern =
      write io (repr repl)) ∧
  (∀ {Rp S Pat : Type} (render : Rp → List UInt8) (repr : Rp → String)
    (write : Stream → String → Except StreamError (Stream × Index))
    (io io' : Stream) (n : Index) (repl : Rp) (str : S) (range : ReplaceRange) (pattern : Pat),
    PublicIOBufferStateShape io →
    JuliaLean.base.strings.io.writeBytesBufferState io (render repl) = .ok (io', n) →
    ((io.append = false →
        replaceShown (fun _ => true) JuliaLean.base.strings.io.positionBufferState
          (fun io x => do
            let (io, _) ← JuliaLean.base.strings.io.writeBytesBufferState io (render x)
            pure io)
          repr write io repl str range pattern = .ok (io', n)) ∧
      (io.append = true →
        replaceShown (fun _ => true) JuliaLean.base.strings.io.positionBufferState
          (fun io x => do
            let (io, _) ← JuliaLean.base.strings.io.writeBytesBufferState io (render x)
            pure io)
          repr write io repl str range pattern = .ok (io', int 0))))

/-- A function replacement receives the exact matched view, including the empty view for every empty match position through `e1`. Source: base/strings/util.jl:1023-1026,1035-1050,1074,1139-1142; base/strings/substring.jl:77,108. -/
def ReplaceFunctionApplied : Prop :=
  ∀ {S Rs C CU CT E IO R Pat : Type} (prim : StringOps S Rs C CU CT E) (errs : ViewErrors S E)
    (replace : IO → R → S → ReplaceRange → Pat → Except E (IO × Index))
    (s : S) (ls : List (Index × C)) (io : IO) (pattern : Pat) (a b : Nat)
    (ia ib : Index) (ca cb : C),
    Lawful prim s ls → a ≤ b → ls[a]? = some (ia, ca) → ls[b]? = some (ib, cb) →
    let range : ReplaceRange := ⟨ia, ib⟩
    ((∃ v, v.string = s ∧ gRange prim errs s ia ib = .ok v ∧
      ViewIterates prim errs v (((charsIn ls).drop a).take (b + 1 - a)) ∧
      ∀ repl : Sub.SubString S → Except E R,
        replaceFunction (gRange prim errs) replace repl io s range pattern =
          (do replace io (← repl v) s range pattern)) ∧
     (∀ e1 k, (do
          let last ← (gFull prim).lastindex s
          (gFull prim).nextind s last (int 1)) = .ok e1 →
        ((∃ c, (k, c) ∈ ls) ∨ k = e1) →
        ∃ v, v.string = s ∧ gRange prim errs s k (k - int 1) = .ok v ∧
          ViewIterates prim errs v [] ∧
          ∀ repl : Sub.SubString S → Except E R,
            replaceFunction (gRange prim errs) replace repl io s
              ⟨k, k - int 1⟩ pattern =
              (do replace io (← repl v) s ⟨k, k - int 1⟩ pattern)) ∧
     (∀ repl : C → Except E R,
      replaceCharFunction ReplaceRange.first (getindexString (gFull prim)) replace repl io s range
          pattern =
        (do replace io (← repl ca) s range pattern)))

private theorem listSplitAtIndex {α : Type} (xs : List α) (k : Nat) (x : α)
    (h : xs[k]? = some x) :
    ∃ before after, xs = before ++ x :: after ∧ before.length = k := by
  induction k generalizing xs with
  | zero =>
    cases xs with
    | nil => simp at h
    | cons head tail =>
      have heq : head = x := by simpa using h
      subst head
      exact ⟨[], tail, by simp, by simp⟩
  | succ k ih =>
    cases xs with
    | nil => simp at h
    | cons head tail =>
      have htail : tail[k]? = some x := by simpa using h
      obtain ⟨before, after, hsplit, hlen⟩ := ih tail htail
      refine ⟨head :: before, after, ?_, ?_⟩
      · simp [hsplit, List.append_assoc]
      · simp [hlen]

private theorem listSplitTwoIndices {α : Type} (xs : List α) {a b : Nat} (hab : a < b)
    (x y : α) (ha : xs[a]? = some x) (hb : xs[b]? = some y) :
    ∃ before middle after,
      xs = before ++ (x :: (middle ++ [y])) ++ after ∧
      before.length = a ∧ before.length + middle.length + 1 = b := by
  induction a generalizing xs b with
  | zero =>
    cases xs with
    | nil => simp at ha
    | cons head tail =>
      have hhead : head = x := by simpa using ha
      subst head
      cases b with
      | zero => omega
      | succ b =>
        have htail : tail[b]? = some y := by simpa using hb
        obtain ⟨middle, after, hsplit, hlen⟩ := listSplitAtIndex tail b y htail
        refine ⟨[], middle, after, ?_, ?_, ?_⟩
        · simpa [hsplit, List.append_assoc]
        · simp
        · simpa [hlen]
  | succ a ih =>
    cases xs with
    | nil => simp at ha
    | cons head tail =>
      cases b with
      | zero => omega
      | succ b =>
        have htailA : tail[a]? = some x := by simpa using ha
        have htailB : tail[b]? = some y := by simpa using hb
        have hab' : a < b := by omega
        obtain ⟨before, middle, after, hsplit, hlenA, hlenB⟩ :=
          ih tail hab' htailA htailB
        refine ⟨head :: before, middle, after, ?_, ?_, ?_⟩
        · simpa [hsplit, List.append_assoc]
        · simp [hlenA]
        · simp only [List.length_cons]
          omega

theorem replaceFunctionApplied_proven : ReplaceFunctionApplied := by
  intro S Rs C CU CT E IO R Pat prim errs replace s ls io pattern a b ia ib ca cb
    law hab ha hb
  dsimp only
  let range : ReplaceRange := ⟨ia, ib⟩
  refine ⟨?_, ?_, ?_⟩
  · rcases Nat.eq_or_lt_of_le hab with habEq | habLt
    · subst b
      have hb' : ls[a]? = some (ib, cb) := hb
      have hpair : (ia, ca) = (ib, cb) := Option.some.inj (ha.symm.trans hb')
      have hia : ia = ib := congrArg Prod.fst hpair
      have hca : ca = cb := congrArg Prod.snd hpair
      subst ib
      subst cb
      obtain ⟨before, after, hsplit, hlen⟩ := listSplitAtIndex ls a (ia, ca) ha
      have hsplitRange : ls = before ++ ((ia, ca) :: []) ++ after := by
        simpa using hsplit
      obtain ⟨v, hrange, hparent, hview⟩ :=
        Affix.rangeSlice prim errs s ls law before [] [] after ia ia ca ca
          (by simp) hsplitRange
      have htake : a + 1 - a = 1 := by omega
      have hchars :
          ((charsIn ls).drop a).take (a + 1 - a) = charsIn ((ia, ca) :: []) := by
        rw [htake]
        simp [charsIn, hsplit, hlen]
      refine ⟨v, hparent, hrange, ?_, ?_⟩
      · rw [hchars]
        exact hview
      · intro repl
        simp [replaceFunction, range, hrange, bind, Except.bind, pure, Except.pure]
    · obtain ⟨before, middle, after, hsplit, hbefore, hgap⟩ :=
        listSplitTwoIndices ls habLt (ia, ca) (ib, cb) ha hb
      let selected := (ia, ca) :: (middle ++ [(ib, cb)])
      have hsplitRange : ls = before ++ selected ++ after := by
        simpa [selected, List.append_assoc] using hsplit
      have hseg : selected = ((ia, ca) :: middle) ++ [(ib, cb)] := by
        simp [selected, List.append_assoc]
      obtain ⟨v, hrange, hparent, hview⟩ :=
        Affix.rangeSlice prim errs s ls law before ((ia, ca) :: middle)
          (middle ++ [(ib, cb)]) after ia ib ca cb hseg hsplitRange
      have hbeforeChars : (charsIn before).length = a := by
        simpa [charsIn] using hbefore
      have hselectedLen : (charsIn selected).length = b + 1 - a := by
        simp [selected, charsIn]
        omega
      have hchars :
          charsIn ls = charsIn before ++ charsIn selected ++ charsIn after := by
        rw [hsplitRange]
        simp [selected, charsIn, List.append_assoc]
      have hslice :
          ((charsIn ls).drop a).take (b + 1 - a) = charsIn selected := by
        simp [hchars, hbeforeChars, hselectedLen, List.drop_append, List.take_append]
      refine ⟨v, hparent, hrange, ?_, ?_⟩
      · rw [hslice]
        exact hview
      · intro repl
        simp [replaceFunction, range, hrange, bind, Except.bind, pure, Except.pure]
  · intro e1 k hend hmatch
    have hk : 1 ≤ k.val := by
      rcases hmatch with ⟨c, hmem⟩ | hke
      · exact (lawfulPairIndexBounds prim s ls law (k, c) hmem).1
      · subst k
        exact lawfulEndIndexPositive prim s ls law e1 hend
    obtain ⟨v, hparent, hrange, hview⟩ := emptyRangeAt prim errs s k hk
    refine ⟨v, hparent, hrange, hview, ?_⟩
    intro repl
    simp [replaceFunction, hrange, bind, Except.bind, pure, Except.pure]
  · intro repl
    obtain ⟨before, after, hsplit, _⟩ := listSplitAtIndex ls a (ia, ca) ha
    have hmem : (ia, ca) ∈ ls := by rw [hsplit]; simp
    have hget : getindexString (gFull prim) s ia = .ok ca :=
      lawfulPairGetindex prim s ls law ia ca hmem
    simp [replaceCharFunction, range, hget, bind, Except.bind, pure, Except.pure]
end JuliaLean.Proofs.base.strings.util.Round11

