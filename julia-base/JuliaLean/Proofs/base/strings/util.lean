private theorem hexB_pairLength (a b c : Nat) (hb : a = 2 * b) (hc : a = 2 * c) : b = c := by
  omega

private theorem hexB_natCastZero (n : Nat) (h : (n : Int) = 0) : n = 0 := by
  omega

private theorem hexB_toNatSmall (z : Int) (nonneg : 0 ≤ z) (small : z < 2 ^ 62) :
    z.toNat < 2 ^ 62 := by omega

private theorem hexB_natIntValue (n : Nat) (small : n < 2 ^ 62) :
    (int (n : Int)).val = (n : Int) := by
  exact hexIntVal _ (by omega) (by omega)

private theorem decodePairs_correct :
    ∀ codes : List UInt8, codes.length % 2 = 0 →
      hexadecimalValue codes =
        match decodePairs codes with
        | (bytes, false) => some bytes
        | (_, true) => none
  | [], _ => rfl
  | [_], heven => by simp at heven
  | a :: b :: rest, heven => by
      have hrest : rest.length % 2 = 0 := by simp at heven; omega
      cases ha : hexNibble a with
      | none => simp [hexadecimalValue, decodePairs, ha]
      | some hi =>
        cases hb : hexNibble b with
        | none => simp [hexadecimalValue, decodePairs, ha, hb]
        | some lo =>
          cases hpair : decodePairs rest with
          | mk bytes failed =>
            cases failed <;>
              simp [hexadecimalValue, decodePairs, ha, hb,
                decodePairs_correct rest hrest, hpair, bind, Option.bind]
set_option maxRecDepth 10000 in
private theorem hexLoopFailure {Array I IS Itr A St : Type}
    (arr : ByteArrayOps Array I IS Error) (it : HexIteratorOps Itr A UInt32 St Error)
    (toChar : A → Result UInt32) (itr : Itr) (indices : IS)
    (idxs : List I) (digits : List (HexDigit A UInt32)) (codes : List UInt8)
    (first : Option (HexDigit A UInt32 × St)) (dest : Array)
    (walk : IndexWalk arr indices none idxs)
    (trace : Trace (it.iterateNext itr) first digits)
    (converts : digits.mapM (digitCode toChar) = .ok codes)
    (hlen : codes.length = 2 * idxs.length)
    (invalid : hexadecimalValue codes = none) :
    hex2bytesBang.loop arr it assertHexTuple (.jl ∘ JlError.argumentError) toChar charByte
      itr indices dest first =
      some (match (writesM arr idxs (decodePairs codes).1).run dest with
        | .ok _ d => .error (.jl (.argumentError
            "byte is not an ASCII hexadecimal digit")) d
        | .error e d => .error e d) := by
  let step : (Array × Option IS × Option (HexDigit A UInt32 × St)) →
      Except (Error × Array) (Sum (Array × Array)
        (Array × Option IS × Option (HexDigit A UInt32 × St))) := fun (dest, idxSt, next) => do
    let (stepIdx, dest) ← runHexState (arr.iterateIndex indices idxSt) dest
    match stepIdx with
    | none => return .inl (dest, dest)
    | some (i, idxSt') =>
      let (next', dest') ← runHexState (do
        let (x, state) ← liftHexExcept (assertHexTuple next)
        let step1 ← liftHexExcept (it.iterateNext itr state)
        let (y, state) ← liftHexExcept (assertHexTuple step1)
        let next' ← liftHexExcept (it.iterateNext itr state)
        let high ← liftHexExcept (numberFromHex (.jl ∘ JlError.argumentError) toChar charByte x)
        let shifted := high <<< 4
        let low ← liftHexExcept (numberFromHex (.jl ∘ JlError.argumentError) toChar charByte y)
        arr.set i (shifted + low)
        pure next') dest
      return .inr (dest', some idxSt', next')
  change toHexResult (JuliaLean.base.reduce.whileLoop step (dest, none, first)) = _
  have go : ∀ (idxs : List I) (st : Option IS) (digits : List (HexDigit A UInt32))
      (codes : List UInt8) (first : Option (HexDigit A UInt32 × St)),
      IndexWalk arr indices st idxs →
      Trace (it.iterateNext itr) first digits →
      digits.mapM (digitCode toChar) = .ok codes →
      codes.length = 2 * idxs.length →
      hexadecimalValue codes = none →
      ∀ dest, toHexResult (JuliaLean.base.reduce.whileLoop step (dest, st, first)) =
        some (match (writesM arr idxs (decodePairs codes).1).run dest with
          | .ok _ d => .error (.jl (.argumentError
              "byte is not an ASCII hexadecimal digit")) d
          | .error e d => .error e d) := by
    intro idxs
    induction idxs with
    | nil =>
      intro st digits codes first walk trace converts hlen invalid dest
      have hc : codes = [] := List.eq_nil_of_length_eq_zero (by simpa using hlen)
      subst codes
      simp [hexadecimalValue] at invalid
    | cons i idxs ih =>
      intro st digits codes first walk trace converts hlen invalid dest
      obtain ⟨st', hindex, walk⟩ := walk
      simp only [EStateM.run] at hindex
      cases trace with
      | nil =>
        have hc : codes = [] := Except.ok.inj converts.symm
        subst codes
        simp at hlen
      | @cons high highState second restDigits step1 tail1 =>
        obtain ⟨c1, restCodes, hconv1, hconverts, hcodes⟩ :=
          mapM_cons_inv (digitCode toChar) high restDigits codes converts
        subst codes
        cases tail1 with
        | nil =>
          have hc : restCodes = [] := Except.ok.inj hconverts.symm
          subst restCodes
          simp only [List.length_cons,List.length_nil] at hlen
          omega
        | @cons low lowState current restDigits step2 tail2 =>
          obtain ⟨c2, restCodes', hconv2, hrestconverts, hcodes⟩ :=
            mapM_cons_inv (digitCode toChar) low restDigits restCodes hconverts
          subst restCodes
          simp only [List.length_cons] at hlen
          cases hh : hexNibble c1 with
          | none =>
            have hbad : numberFromHex (.jl ∘ JlError.argumentError) toChar charByte high =
                .error (.jl (.argumentError "byte is not an ASCII hexadecimal digit")) := by
              have hn := digitCodeNumber toChar high c1 hconv1
              rw [hexByteDecoder, hh] at hn
              simpa using hn
            rw [JuliaLean.base.reduce.whileLoop]
            simp [step, runHexState, hindex, assertHexTuple, step1, step2, hbad,
              liftHexExcept, toHexResult, writesM, Bind.bind, Except.bind,
