theorem padRemainderMinimal_proven : PadRemainderMinimal := by
  intro S R C CU CT prim errs cops P liftU p ls codes r law hcodes hw hbound
  obtain ⟨first, hfirst, htrace⟩ := lawfulPairsTrace prim p ls law
  have hwhole := padWholeViewIterates prim errs cops P liftU p ls law
  have hslice : ∀ before i c after, ls = before ++ (i, c) :: after →
      ∃ out, (padRemOps prim errs cops P liftU).viewPrefix p i = .ok out ∧
        out.string = p ∧ ViewIterates prim errs out (charsIn (before ++ [(i, c)])) := by
    intro before i c after hsplit
    exact padPrefixViewIterates prim errs cops P liftU p ls law before i c after hsplit
  have hcodesLen : codes.length = ls.length := by
    calc
      codes.length = (charsIn ls).length :=
        (@suMapMLength C UInt32 JuliaLean.base.char.CharError cops.toChar
          (charsIn ls) codes hcodes).symm
      _ = ls.length := by simp [charsIn]
  have hbefore0 : ∀ k, 0 < k → k ≤ ([] : List (Index × C)).length →
      (widthsOf P (codes.take k)).sum < r.val := by
    intro k hk hk0
    have hkzero : k = 0 := by simpa using hk0
    omega
  obtain ⟨out, n, hloop, hn, hstring, hview, hstop, hbefore⟩ :=
    padRemainderLoopViewSpec prim errs cops P liftU p ls codes r hw hbound hwhole hslice
      (seen := []) (seenCodes := []) (rest := ls) (restCodes := codes)
      (current := first) (total := int 0)
      htrace (by simp) (by simp) (by simp) hcodes (by simp [widthsOf]) hbefore0
  have hfirst' : (padRemOps prim errs cops P liftU).pairsFirst p = .ok first := by
    simpa [padRemOps] using hfirst
  have hcall : padRemainderString (padRemOps prim errs cops P liftU) p r =
      some (.ok out) := by
    unfold padRemainderString
    rw [hfirst']
    exact hloop
  have hnCodes : n ≤ codes.length := by rw [hcodesLen]; exact hn
  have hbeforeShape : ∀ k, 0 < k → k < n →
      (((codes.map (charWidth P)).take k).sum) < r.val := by
    intro k hk hkn
    simpa [widthsOf, List.map_take] using hbefore k hk hkn
  have hstopShape :
      n = codes.length ∨ 0 < n ∧ r.val ≤ ((codes.map (charWidth P)).take n).sum := by
    rcases hstop with hlen | ⟨hpos, hsum⟩
    · exact Or.inl (hlen.trans hcodesLen.symm)
    · exact Or.inr ⟨hpos, by simpa [widthsOf, List.map_take] using hsum⟩
  have hshape :=
    minimalPrefixLength_shape (charWidth P) r.val codes n hnCodes hbeforeShape hstopShape
  rcases hshape with hsome | ⟨hnone, hnlen⟩
  · refine ⟨out, hcall, hstring, ?_⟩
    simpa [hsome, charsIn, List.map_take] using hview
  · refine ⟨out, hcall, hstring, ?_⟩
    have hnls : n = ls.length := hnlen.trans hcodesLen
    simpa [hnone, hnls, charsIn, List.map_take] using hview
