private theorem cpIntVal (z : Int) (lo : -(2 ^ 63) ≤ z) (hi : z < 2 ^ 63) :
    (int z).val = z := by
  change wrapInt .i64 z = z
  exact wrapInt_of_inRange .i64 z (by
    simp [IntTy.min, IntTy.max, IntTy.signed, IntTy.bits]
    omega)

private theorem cpAddVal (a b : Index) (lo : -(2 ^ 63) ≤ a.val + b.val)
    (hi : a.val + b.val < 2 ^ 63) : (a + b).val = a.val + b.val := by
  change wrapInt .i64 (a.val + b.val) = _
  exact wrapInt_of_inRange .i64 _ (by
    simp [IntTy.min, IntTy.max, IntTy.signed, IntTy.bits]
    omega)

private theorem cpSubVal (a b : Index) (lo : -(2 ^ 63) ≤ a.val - b.val)
    (hi : a.val - b.val < 2 ^ 63) : (a - b).val = a.val - b.val := by
  change wrapInt .i64 (a.val - b.val) = _
  exact wrapInt_of_inRange .i64 _ (by
    simp [IntTy.min, IntTy.max, IntTy.signed, IntTy.bits]
    omega)

private theorem cpPrefixNVal (s : Prepared) (gs : GoodView s.view) (n : Nat)
    (hn : n ≤ (preparedBytes s).length) : (int (n : Int)).val = n := by
  have hoff := gs.off
  have hfit := gs.fit
  have hsmall := s.view.string.small
  have hsize := goodView_bytes_length s.view gs
  change ((preparedBytes s).length : Int) = s.view.ncodeunits.val at hsize
  exact cpIntVal _ (by omega) (by omega)

private theorem cpPrefixRaw (s : Prepared) (gs : GoodView s.view) (n : Nat)
    (hn : n ≤ (preparedBytes s).length) :
    Sub.rawSubstringView parentOps s.view (int 1) (int n) = .ok ((⟨s.view.string, s.view.offset, int n⟩ : View)) := by
  have hoff := gs.off
  have hlen := gs.len
  have hfit := gs.fit
  have hsmall := s.view.string.small
  have hsize := goodView_bytes_length s.view gs
  change ((preparedBytes s).length : Int) = s.view.ncodeunits.val at hsize
  have h1 : (int 1).val = 1 := by decide
  have hnval := cpPrefixNVal s gs n hn
  have hone := substringOne_val
  have hsub : (s.view.ncodeunits - int 1).val = s.view.ncodeunits.val - 1 :=
    cpSubVal _ _ (by omega) (by omega)
  have htotal : (s.view.ncodeunits - int 1 + JuliaLean.base.strings.substring.one).val =
      s.view.ncodeunits.val := by
    rw [cpAddVal _ _ (by rw [hsub, hone]; omega) (by rw [hsub, hone]; omega), hsub, hone]
    omega
  have hoadd : (int 1 + s.view.offset).val = 1 + s.view.offset.val :=
    cpAddVal _ _ (by omega) (by omega)
  have houtoff : (int 1 + s.view.offset - JuliaLean.base.strings.substring.one).val =
      s.view.offset.val := by
    rw [cpSubVal _ _ (by rw [hoadd, hone]; omega) (by rw [hoadd, hone]; omega), hoadd, hone]
    omega
  have houtoffEq : int 1 + s.view.offset - JuliaLean.base.strings.substring.one =
      s.view.offset := Subtype.ext houtoff
  have hnb : ¬ (n : Int) > s.view.ncodeunits.val := by omega
  have hn0 : ¬ (n : Int) < 0 := by omega
  simp only [Sub.rawSubstringView, Bool.true_and, hnval, h1, htotal, hn0, hnb,
    Int.lt_irrefl, decide_false, Bool.or_self, Bool.false_eq_true, ite_false,
    houtoffEq, pure, Except.pure]

private theorem cpPrefixPrepare (s : Prepared) (gs : GoodView s.view) (n : Nat)
    (hn : n ≤ (preparedBytes s).length) :
    ∃ out, prepareView ((⟨s.view.string, s.view.offset, int n⟩ : View)) = .ok out ∧ out.view = (⟨s.view.string, s.view.offset, int n⟩ : View) := by
  have hnval := cpPrefixNVal s gs n hn
  have hsize := goodView_bytes_length s.view gs
  change ((preparedBytes s).length : Int) = s.view.ncodeunits.val at hsize
  have hfit := gs.fit
  apply prepareView_ok (⟨s.view.string, s.view.offset, int n⟩ : View) gs.off
  · change 0 ≤ (int (n : Int)).val
    rw [hnval]
    omega
  · change s.view.offset.val + (int (n : Int)).val ≤ (s.view.string.bytes.length : Int)
    rw [hnval]
    omega

private theorem cpPrefixBytes (s : Prepared) (gs : GoodView s.view) (n : Nat)
    (hn : n ≤ (preparedBytes s).length) :
    viewBytes ((⟨s.view.string, s.view.offset, int n⟩ : View)) = (preparedBytes s).take n := by
  have hnval := cpPrefixNVal s gs n hn
  have hsize := goodView_bytes_length s.view gs
  change ((preparedBytes s).length : Int) = s.view.ncodeunits.val at hsize
  simp only [viewBytes, preparedBytes, hnval, Int.toNat_natCast]
