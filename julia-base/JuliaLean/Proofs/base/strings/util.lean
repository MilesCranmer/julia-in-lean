theorem suLastAt {S R C CU CT E : Type} (prim : StringOps S R C CU CT E)
    (s : S) (ls : List (Index × C)) (law : Lawful prim s ls)
    (p : Index × C) (hlast : ls.getLast? = some p) :
    (gFull prim).lastindex s = .ok p.1 := by
  have hf := suWalkLastFacts prim s law.walk p hlast
  have hmem := suGetLastMem hlast
  have hv : prim.isvalid s p.1 = .ok true := by
    rw [law.isvalid p.1 hf.2.2.1 hf.2.2.2]
    have ha : ls.any (fun q => q.1.val == p.1.val) = true :=
      List.any_eq_true.mpr ⟨p, hmem, by simp⟩
    rw [ha]
  have hinv : ∀ k : Index, p.1.val < k.val → k.val ≤ (prim.ncodeunits s).val →
      prim.isvalid s k = .ok false := by
    intro k hlo hhi
    rw [law.isvalid k (by omega) hhi]
    congr 1
    apply Bool.eq_false_iff.mpr
    intro hk
    obtain ⟨q, hq, heq⟩ := List.any_eq_true.mp hk
    have hle := hf.2.1 q hq
    have heq' : q.1.val = k.val := by simpa using beq_iff_eq.mp heq
    omega
  have h := JuliaLean.Proofs.base.strings.basic.thisindInt_rewind prim s
    (prim.ncodeunits s) p.1 hf.2.2.1 hf.2.2.2 (Int.le_refl _)
    (suWalkEndBound prim s law.walk) (Or.inr hv) (fun k hk => hinv k hk.1 hk.2)
  simpa [gFull, modelStringOps, lastindexString] using h

