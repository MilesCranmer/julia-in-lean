theorem truncate_loop_trace {S A E : Type} (step : S → Except E (Sum A S)) :
    ∀ state result, whileLoop step state = some (.ok result) → WhileTrace step state result := by
  apply JuliaLean.base.reduce.whileLoop.fixpoint_induct step
    (fun loop => ∀ state result, loop state = some (.ok result) → WhileTrace step state result)
  · refine Lean.Order.admissible_pi_apply
      (fun (state : S) (output : Option (Except E A)) => ∀ result,
        output = some (.ok result) → WhileTrace step state result) ?_
    intro state
    exact Lean.Order.admissible_pi
      (fun (output : Option (Except E A)) (result : A) =>
        output = some (.ok result) → WhileTrace step state result)
      (fun result => Lean.Order.Option.admissible_eq_some
        (WhileTrace step state result) (Except.ok result : Except E A))
  · intro loop ih state result hrun
    cases hstep : step state with
    | error err => simp only [hstep, Option.some.injEq] at hrun; cases hrun
    | ok outcome =>
      cases outcome with
      | inl value =>
        have heq : value = result := by simpa only [hstep, Option.some.injEq, Except.ok.injEq] using hrun
        subst result
        exact .done hstep
      | inr nextState =>
        exact .next hstep (ih nextState result (by simpa only [hstep] using hrun))

theorem truncate_loop_invariant {S A E : Type} (step : S → Except E (Sum A S))
    (pending : S → Prop) (finished : A → Prop)
    (hs : ∀ state, pending state → ∀ output, step state = .ok output →
      match output with | .inl result => finished result | .inr next => pending next)
    {state : S} {result : A} (hr : whileLoop step state = some (.ok result))
    (hi : pending state) : finished result := by
  have trace := truncate_loop_trace step state result hr
  clear hr
  induction trace with
  | done h => exact hs _ hi _ h
  | next h tail ih => exact ih (hs _ hi _ h)

def truncate_width_sum {C : Type} (cw : C → Index) (chars : List C) : Int :=
  (chars.map (fun c => (cw c).val)).sum

theorem truncate_width_sum_nonneg {C : Type} (cw : C → Index)
    (hn : ∀ c, 0 ≤ (cw c).val) (chars : List C) : 0 ≤ truncate_width_sum cw chars := by
  induction chars with
  | nil => exact Int.le_refl 0
  | cons c cs ih =>
    change 0 ≤ (cw c).val + truncate_width_sum cw cs
    exact Int.add_nonneg (hn c) ih

theorem truncate_charlist_width {S V R C E : Type} (ops : TruncateOps S V R C E)
    (cw : C → Index) (hcw : ∀ c, ops.textwidthChar c = .ok (cw c)) (chars : List C) :
    charListWidth ops chars = .ok (truncate_width_sum cw chars) := by
  have hm : chars.mapM ops.textwidthChar = .ok (chars.map cw) := by
    induction chars with
    | nil => rfl
    | cons c cs ih =>
      simp only [List.mapM_cons, hcw, ih, Bind.bind, Except.bind,
        Pure.pure, Except.pure, List.map_cons]
  simp only [charListWidth, hm, Bind.bind, Except.bind, Pure.pure, Except.pure,
    List.map_map, Function.comp_def, truncate_width_sum]

theorem truncate_add_exact (a b : Index) (ha : 0 ≤ a.val) (_hb : 0 ≤ b.val)
    (hmax : a.val + b.val ≤ JuliaLean.IntTy.i64.max) :
    (a + b).val = a.val + b.val := by
  change JuliaLean.wrapInt .i64 (a.val + b.val) = _
  apply JuliaLean.wrapInt_of_inRange
  refine ⟨?_, hmax⟩
  have hzero : JuliaLean.IntTy.i64.min ≤ 0 := by decide
  omega

/-- The incremental width test agrees with the total whenever its accumulator cannot wrap. -/

theorem truncate_check_trace {S V R C E : Type} (ops : TruncateOps S V R C E)
    (cw : C → Index) (hcw : ∀ c, ops.textwidthChar c = .ok (cw c))
    (hn : ∀ c, 0 ≤ (cw c).val) (str : S) (budget : Int)
    {first : Option (C × Index)} {chars : List C}
    (trace : CharacterTrace (ops.iterateAt str) first chars) :
    ∀ acc : Index, 0 ≤ acc.val → acc.val ≤ budget →
      acc.val + truncate_width_sum cw chars ≤ JuliaLean.IntTy.i64.max →
      (match first with
       | none => some (.ok true)
       | some (c, i) => checkTextwidthLoop ops.iterateAt ops.textwidthChar str budget c i acc) =
      some (.ok (decide (acc.val + truncate_width_sum cw chars ≤ budget))) := by
  induction trace with
  | nil =>
    intro acc hacc hfit hmax
    simp only [truncate_width_sum, List.map_nil, List.sum_nil, Int.add_zero,
      decide_eq_true hfit]
  | @cons c i current rest hnext htail ih =>
    intro acc hacc hfit hmax
    have htailnonneg := truncate_width_sum_nonneg cw hn rest
    have hadd : (acc + cw c).val = acc.val + (cw c).val :=
      truncate_add_exact acc (cw c) hacc (hn c) (by
        change acc.val + ((cw c).val + truncate_width_sum cw rest) ≤ _ at hmax
        omega)
    change checkTextwidthLoop ops.iterateAt ops.textwidthChar str budget c i acc = _
    rw [checkTextwidthLoop, whileLoop]
    simp only [hcw, Bind.bind, Except.bind, Pure.pure, Except.pure]
    by_cases hover : (acc + cw c).val > budget
    · have htotal : ¬ acc.val + truncate_width_sum cw (c :: rest) ≤ budget := by
        change ¬ acc.val + ((cw c).val + truncate_width_sum cw rest) ≤ budget
        rw [hadd] at hover
        omega
      simp only [ite_eq_left hover, decide_eq_false htotal]
    · rw [ite_eq_right hover, hnext]
      dsimp only
      have hih := ih (acc + cw c) (by rw [hadd]; exact Int.add_nonneg hacc (hn c))
        (by omega) (by
          rw [hadd]
          change acc.val + ((cw c).val + truncate_width_sum cw rest) ≤ _ at hmax
          omega)
      have hsum : (acc + cw c).val + truncate_width_sum cw rest =
          acc.val + truncate_width_sum cw (c :: rest) := by
        rw [hadd]
        change acc.val + (cw c).val + truncate_width_sum cw rest =
          acc.val + ((cw c).val + truncate_width_sum cw rest)
        omega
      rw [hsum] at hih
      cases current with
      | none => exact hih
      | some pair =>
        rcases pair with ⟨c', i'⟩
        simpa only [checkTextwidthLoop, hcw, Bind.bind, Except.bind, Pure.pure, Except.pure] using hih

/-- The generic stream width test computes the mathematical total comparison. -/

theorem truncate_check_exact {S V R C E : Type} (ops : TruncateOps S V R C E)
    (cw : C → Index) (hcw : ∀ c, ops.textwidthChar c = .ok (cw c))
    (hn : ∀ c, 0 ≤ (cw c).val) (str : S) (chars : List C) (budget : Int)
    (trace : TruncateTrace ops str chars) (hbudget : 0 ≤ budget)
    (hmax : truncate_width_sum cw chars ≤ JuliaLean.IntTy.i64.max) :
    checkTextwidth ops str budget = some (.ok (decide (truncate_width_sum cw chars ≤ budget))) := by
  obtain ⟨first, hfirst, trace⟩ := trace
  have h := truncate_check_trace ops cw hcw hn str budget trace (int 0)
    (by decide) (by exact hbudget) (by simpa only [show (int 0).val = 0 by decide, Int.zero_add] using hmax)
  cases first with
  | none =>
    simpa only [checkTextwidth, hfirst, show (int 0).val = 0 by decide, Int.zero_add] using h
  | some pair =>
    rcases pair with ⟨c, i⟩
    simpa only [checkTextwidth, hfirst, show (int 0).val = 0 by decide, Int.zero_add] using h

def truncate_columns (prefixWidth suffixWidth : Index → Int) (rw : Index) (budget : Int)
    (left right width : Index) : Prop :=
  0 ≤ prefixWidth left ∧ 0 ≤ suffixWidth right ∧
    width.val = prefixWidth left + rw.val + suffixWidth right ∧ width.val ≤ budget

theorem truncate_columns_finish (prefixWidth suffixWidth : Index → Int) (rw : Index) (budget : Int)
    (left right width : Index)
    (h : truncate_columns prefixWidth suffixWidth rw budget left right width) :
    0 ≤ prefixWidth left ∧ 0 ≤ suffixWidth right ∧
      prefixWidth left + rw.val + suffixWidth right ≤ budget := by
  exact ⟨h.1, h.2.1, by rw [← h.2.2.1]; exact h.2.2.2⟩

theorem truncate_textwidth_at {S V R C E : Type} (ops : TruncateOps S V R C E)
    (hwidths : ∀ c, ∃ cw, ops.textwidthChar c = .ok cw ∧ 0 ≤ cw.val ∧ cw.val ≤ 2)
    (str : S) (i w : Index) (h : textwidthAt ops str i = .ok w) :
    ∃ c, ops.getindex str i = .ok c ∧ ops.textwidthChar c = .ok w ∧ 0 ≤ w.val ∧ w.val ≤ 2 := by
  cases hg : ops.getindex str i with
  | error err => simp only [textwidthAt, hg, Bind.bind, Except.bind] at h; cases h
  | ok c =>
    have hc : ops.textwidthChar c = .ok w := by
      simpa only [textwidthAt, hg, Bind.bind, Except.bind] using h
    obtain ⟨cw, hw, hn, hb⟩ := hwidths c
    rw [hc] at hw
    cases hw
    exact ⟨c, rfl, hc, hn, hb⟩

theorem truncate_columns_left {S V R C E : Type} (ops : TruncateOps S V R C E)
    (str : S) (prefixWidth suffixWidth : Index → Int) (rw : Index) (budget : Int)
    (hwidths : ∀ c, ∃ cw, ops.textwidthChar c = .ok cw ∧ 0 ≤ cw.val ∧ cw.val ≤ 2)
    (hnext : ∀ left c cw nextLeft, ops.getindex str left = .ok c →
      ops.textwidthChar c = .ok cw → ops.nextind str left = .ok nextLeft →
      prefixWidth nextLeft = prefixWidth left + cw.val)
    (hrw : 0 ≤ rw.val) (hmax : budget + 2 ≤ JuliaLean.IntTy.i64.max)
    (left right width removed nextLeft : Index)
    (hcol : truncate_columns prefixWidth suffixWidth rw budget left right width)
    (hremoved : textwidthAt ops str left = .ok removed)
    (hfit : (width + removed).val ≤ budget)
    (hn : ops.nextind str left = .ok nextLeft) :
    truncate_columns prefixWidth suffixWidth rw budget nextLeft right (width + removed) := by
  obtain ⟨c, hg, hc, hlo, hhi⟩ := truncate_textwidth_at ops hwidths str left removed hremoved
  have hp := hnext left c removed nextLeft hg hc hn
  have hadd : (width + removed).val = width.val + removed.val :=
    truncate_add_exact width removed (by rcases hcol with ⟨_, _, heq, _⟩; omega)
      hlo (by have := hcol.2.2.2; omega)
  refine ⟨?_, hcol.2.1, ?_, hfit⟩
  · rw [hp]; exact Int.add_nonneg hcol.1 hlo
  · rw [hadd, hp, hcol.2.2.1]; omega

theorem truncate_columns_right {S V R C E : Type} (ops : TruncateOps S V R C E)
    (str : S) (prefixWidth suffixWidth : Index → Int) (rw : Index) (budget : Int)
    (hwidths : ∀ c, ∃ cw, ops.textwidthChar c = .ok cw ∧ 0 ≤ cw.val ∧ cw.val ≤ 2)
    (hprev : ∀ right c cw prevRight, ops.getindex str right = .ok c →
      ops.textwidthChar c = .ok cw → ops.prevind str right = .ok prevRight →
      suffixWidth prevRight = suffixWidth right + cw.val)
    (hrw : 0 ≤ rw.val) (hmax : budget + 2 ≤ JuliaLean.IntTy.i64.max)
    (left right width removed prevRight : Index)
    (hcol : truncate_columns prefixWidth suffixWidth rw budget left right width)
    (hremoved : textwidthAt ops str right = .ok removed)
    (hfit : (width + removed).val ≤ budget)
    (hp : ops.prevind str right = .ok prevRight) :
    truncate_columns prefixWidth suffixWidth rw budget left prevRight (width + removed) := by
  obtain ⟨c, hg, hc, hlo, hhi⟩ := truncate_textwidth_at ops hwidths str right removed hremoved
  have hs := hprev right c removed prevRight hg hc hp
  have hadd : (width + removed).val = width.val + removed.val :=
    truncate_add_exact width removed (by rcases hcol with ⟨_, _, heq, _⟩; omega)
      hlo (by have := hcol.2.2.2; omega)
  refine ⟨hcol.1, ?_, ?_, hfit⟩
  · rw [hs]; exact Int.add_nonneg hcol.2.1 hlo
  · rw [hadd, hs, hcol.2.2.1]; omega

abbrev truncate_state := Index × Index × Index × Index × Index × Bool

def truncate_result_columns (prefixWidth suffixWidth : Index → Int) (rw : Index)
    (budget : Int) (out : Sum (Index × Index) truncate_state) : Prop :=
  match out with
  | .inl pair => 0 ≤ prefixWidth pair.1 ∧ 0 ≤ suffixWidth pair.2 ∧
      prefixWidth pair.1 + rw.val + suffixWidth pair.2 ≤ budget
  | .inr state => truncate_columns prefixWidth suffixWidth rw budget state.1 state.2.1 state.2.2.1

def truncate_after_right {S V R C E M : Type} (ops : TruncateOps S V R C E)
    (modeOps : TruncModeOps M) (str : S) (budget : Int) (mode : M)
    (left right width removedLeft removedRight : Index) (forceOther : Bool) :
    Except E (Sum (Index × Index) truncate_state) := do
  if modeOps.isRightOrCenter mode then do
    let removed ← textwidthAt ops str left
    if modeOps.isLeft mode || removedLeft.val ≤ removedRight.val || forceOther then
      let again ← textwidthAt ops str left
      if (width + again).val ≤ budget then do
        let left ← ops.nextind str left
        return .inr (left, right, width + again, removedLeft + removed, removedRight, false)
      else return .inl (left, right)
    else return .inr (left, right, width, removedLeft, removedRight, true)
  else return .inr (left, right, width, removedLeft, removedRight, forceOther)

theorem truncate_after_right_safe {S V R C E M : Type} (ops : TruncateOps S V R C E)
    (modeOps : TruncModeOps M) (str : S) (budget : Int) (mode : M)
    (prefixWidth suffixWidth : Index → Int) (rw : Index)
    (hwidths : ∀ c, ∃ cw, ops.textwidthChar c = .ok cw ∧ 0 ≤ cw.val ∧ cw.val ≤ 2)
    (hnext : ∀ left c cw nextLeft, ops.getindex str left = .ok c →
      ops.textwidthChar c = .ok cw → ops.nextind str left = .ok nextLeft →
      prefixWidth nextLeft = prefixWidth left + cw.val)
    (hrw : 0 ≤ rw.val) (hmax : budget + 2 ≤ JuliaLean.IntTy.i64.max)
    (left right width removedLeft removedRight : Index) (forceOther : Bool)
    (hcol : truncate_columns prefixWidth suffixWidth rw budget left right width)
    (out : Sum (Index × Index) truncate_state)
    (hrun : truncate_after_right ops modeOps str budget mode left right width
      removedLeft removedRight forceOther = .ok out) :
    truncate_result_columns prefixWidth suffixWidth rw budget out := by
  unfold truncate_after_right at hrun
  cases hm : modeOps.isRightOrCenter mode with
  | false =>
    simp only [hm, Bool.false_eq_true, ite_false, Pure.pure, Except.pure] at hrun
    cases hrun
    exact hcol
  | true =>
    simp only [hm, ite_true] at hrun
    cases hd : textwidthAt ops str left with
    | error err => simp only [hd, Bind.bind, Except.bind] at hrun; cases hrun
    | ok removed =>
      simp only [hd, Bind.bind, Except.bind, Pure.pure, Except.pure] at hrun
      split at hrun
      · split at hrun
        · rename_i hfit
          cases hn : ops.nextind str left with
          | error err => simp only [hn] at hrun; cases hrun
          | ok nextLeft =>
            simp only [hn] at hrun
            cases hrun
            exact truncate_columns_left ops str prefixWidth suffixWidth rw budget hwidths hnext
              hrw hmax left right width removed nextLeft hcol hd hfit hn
        · cases hrun
          exact truncate_columns_finish prefixWidth suffixWidth rw budget left right width hcol
      · cases hrun
        exact hcol

def truncate_step {S V R C E M : Type} (ops : TruncateOps S V R C E)
    (modeOps : TruncModeOps M) (str : S) (budget : Int) (mode : M) (preferLeft : Bool)
    (left0 : Index) (state : truncate_state) : Except E (Sum (Index × Index) truncate_state) := do
  let (left, right, width, removedLeft, removedRight, forceOther) := state
  let removeRight := modeOps.isLeft mode ||
    (modeOps.isCenter mode && (!preferLeft || left.val > left0.val))
  let firstStep ←
    if removeRight then do
      let removed ← textwidthAt ops str right
      if modeOps.isLeft mode || removedRight.val ≤ removedLeft.val || forceOther then
        if (width + removed).val ≤ budget then do
          let right ← ops.prevind str right
          pure (some (right, width + removed, removedRight + removed, false))
        else pure none
      else pure (some (right, width, removedRight, true))
    else pure (some (right, width, removedRight, forceOther))
  match firstStep with
  | none => return .inl (left, right)
  | some (right, width, removedRight, forceOther) =>
    truncate_after_right ops modeOps str budget mode left right width removedLeft removedRight forceOther

theorem truncate_step_safe {S V R C E M : Type} (ops : TruncateOps S V R C E)
    (modeOps : TruncModeOps M) (str : S) (budget : Int) (mode : M) (preferLeft : Bool)
    (left0 : Index) (prefixWidth suffixWidth : Index → Int) (rw : Index)
    (hwidths : ∀ c, ∃ cw, ops.textwidthChar c = .ok cw ∧ 0 ≤ cw.val ∧ cw.val ≤ 2)
    (hnext : ∀ left c cw nextLeft, ops.getindex str left = .ok c →
      ops.textwidthChar c = .ok cw → ops.nextind str left = .ok nextLeft →
      prefixWidth nextLeft = prefixWidth left + cw.val)
    (hprev : ∀ right c cw prevRight, ops.getindex str right = .ok c →
      ops.textwidthChar c = .ok cw → ops.prevind str right = .ok prevRight →
      suffixWidth prevRight = suffixWidth right + cw.val)
    (hrw : 0 ≤ rw.val) (hmax : budget + 2 ≤ JuliaLean.IntTy.i64.max)
    (left right width removedLeft removedRight : Index) (forceOther : Bool)
    (hcol : truncate_columns prefixWidth suffixWidth rw budget left right width)
    (out : Sum (Index × Index) truncate_state)
    (hrun : truncate_step ops modeOps str budget mode preferLeft left0
      (left, right, width, removedLeft, removedRight, forceOther) = .ok out) :
    truncate_result_columns prefixWidth suffixWidth rw budget out := by
  unfold truncate_step at hrun
  dsimp only at hrun
  split at hrun
  · cases hd : textwidthAt ops str right with
    | error err => simp only [hd, Bind.bind, Except.bind] at hrun; cases hrun
    | ok removed =>
      simp only [hd, Bind.bind, Except.bind, Pure.pure, Except.pure] at hrun
      split at hrun
      · split at hrun
        · rename_i hfit
          cases hp : ops.prevind str right with
          | error err => simp only [hp] at hrun; cases hrun
          | ok nextRight =>
            simp only [hp] at hrun
            have hnew := truncate_columns_right ops str prefixWidth suffixWidth rw budget
              hwidths hprev hrw hmax left right width removed nextRight hcol hd hfit hp
            exact truncate_after_right_safe ops modeOps str budget mode prefixWidth suffixWidth rw
              hwidths hnext hrw hmax left nextRight (width + removed) removedLeft
              (removedRight + removed) false hnew out hrun
        · cases hrun
          exact truncate_columns_finish prefixWidth suffixWidth rw budget left right width hcol
      · exact truncate_after_right_safe ops modeOps str budget mode prefixWidth suffixWidth rw
          hwidths hnext hrw hmax left right width removedLeft removedRight true hcol out hrun
  · simp only [Bind.bind, Except.bind, Pure.pure, Except.pure] at hrun
    exact truncate_after_right_safe ops modeOps str budget mode prefixWidth suffixWidth rw
      hwidths hnext hrw hmax left right width removedLeft removedRight forceOther hcol out hrun

/-- Successful boundary search preserves the exact sum of kept and replacement columns. -/

theorem truncate_loop_columns {S V R C E M : Type} (ops : TruncateOps S V R C E)
    (modeOps : TruncModeOps M) (str : S) (budget : Int) (mode : M) (preferLeft : Bool)
    (left0 : Index) (prefixWidth suffixWidth : Index → Int) (rw : Index)
    (hwidths : ∀ c, ∃ cw, ops.textwidthChar c = .ok cw ∧ 0 ≤ cw.val ∧ cw.val ≤ 2)
    (hnext : ∀ left c cw nextLeft, ops.getindex str left = .ok c →
      ops.textwidthChar c = .ok cw → ops.nextind str left = .ok nextLeft →
      prefixWidth nextLeft = prefixWidth left + cw.val)
    (hprev : ∀ right c cw prevRight, ops.getindex str right = .ok c →
      ops.textwidthChar c = .ok cw → ops.prevind str right = .ok prevRight →
      suffixWidth prevRight = suffixWidth right + cw.val)
    (hrw : 0 ≤ rw.val) (hmax : budget + 2 ≤ JuliaLean.IntTy.i64.max)
    (left right width removedLeft removedRight : Index) (forceOther : Bool)
    (hcol : truncate_columns prefixWidth suffixWidth rw budget left right width)
    (out : Index × Index)
    (hrun : truncateLoop ops modeOps str budget mode preferLeft left0 left right width
      removedLeft removedRight forceOther = some (.ok out)) :
    0 ≤ prefixWidth out.1 ∧ 0 ≤ suffixWidth out.2 ∧
      prefixWidth out.1 + rw.val + suffixWidth out.2 ≤ budget := by
  change whileLoop (truncate_step ops modeOps str budget mode preferLeft left0)
    (left, right, width, removedLeft, removedRight, forceOther) = some (.ok out) at hrun
  apply truncate_loop_invariant (truncate_step ops modeOps str budget mode preferLeft left0)
    (fun (l, r, w, _, _, _) => truncate_columns prefixWidth suffixWidth rw budget l r w)
    (fun pair => 0 ≤ prefixWidth pair.1 ∧ 0 ≤ suffixWidth pair.2 ∧
      prefixWidth pair.1 + rw.val + suffixWidth pair.2 ≤ budget) ?_ hrun hcol
  intro state hstate result hresult
  rcases state with ⟨l, r, w, rl, rr, force⟩
  have h := truncate_step_safe ops modeOps str budget mode preferLeft left0 prefixWidth suffixWidth rw
    hwidths hnext hprev hrw hmax l r w rl rr force hstate result hresult
  cases result with
  | inl pair => exact h
  | inr state =>
    rcases state with ⟨l', r', w', rl', rr', force'⟩
    exact h

theorem truncate_interface_check {S V R C E : Type} (ops : TruncateOps S V R C E)
    (str : S) (repl : R) (chars : List C) (prefixWidth suffixWidth : Index → Int)
    (interface : TruncateInterface ops str repl chars prefixWidth suffixWidth)
    (total budget : Int) (htotal : charListWidth ops chars = .ok total) (hbudget : 0 ≤ budget) :
    checkTextwidth ops str budget = some (.ok (decide (total ≤ budget))) := by
  classical
  let cw : C → Index := fun c => (interface.1 c).choose
  have hcw : ∀ c, ops.textwidthChar c = .ok (cw c) := fun c => (interface.1 c).choose_spec.1
  have hn : ∀ c, 0 ≤ (cw c).val := fun c => (interface.1 c).choose_spec.2.1
  have hsum : truncate_width_sum cw chars = total := by
    rw [truncate_charlist_width ops cw hcw chars] at htotal
    exact Except.ok.inj htotal
  obtain ⟨boundTotal, hboundTotal, hbound⟩ := interface.2.2.1
  have heq : total = boundTotal := by rw [htotal] at hboundTotal; exact Except.ok.inj hboundTotal
  have h := truncate_check_exact ops cw hcw hn str chars budget interface.2.1 hbudget
    (by rw [hsum, heq]; omega)
  simpa only [hsum] using h

def truncate_boundary_result {S V R C E : Type} (ops : TruncateOps S V R C E)
    (str : S) (prefixWidth suffixWidth : Index → Int) (rw : Index) (budget total : Int) :
    Option (Index × Index) → Prop
  | none => total ≤ budget
  | some (left, right) => ∃ left0 right0,
      ops.prevind str left0 = .ok left ∧ ops.nextind str right0 = .ok right ∧
      0 ≤ prefixWidth left0 ∧ 0 ≤ suffixWidth right0 ∧
      prefixWidth left0 + rw.val + suffixWidth right0 ≤ budget

/-- Boundary search either preserves a fitting string or returns fitting kept prefixes and suffixes. -/

theorem truncate_boundaries_spec {S V R C E M : Type} (ops : TruncateOps S V R C E)
    (modeOps : TruncModeOps M) (str : S) (repl : R) (chars : List C)
    (prefixWidth suffixWidth : Index → Int) (rw : Index) (budget total : Int)
    (mode : TruncModeVal M) (preferLeft : Bool)
    (interface : TruncateInterface ops str repl chars prefixWidth suffixWidth)
    (htotal : charListWidth ops chars = .ok total)
    (hrepl : ops.textwidthReplacement repl = some (.ok rw))
    (hrw : 0 ≤ rw.val) (hfit : rw.val ≤ budget)
    (out : Option (Index × Index))
    (hrun : stringTruncateBoundaries ops modeOps str budget repl mode preferLeft = some (.ok out)) :
    truncate_boundary_result ops str prefixWidth suffixWidth rw budget total out := by
  have hbudget : 0 ≤ budget := Int.le_trans hrw hfit
  have hcheck := truncate_interface_check ops str repl chars prefixWidth suffixWidth
    interface total budget htotal hbudget
  rcases interface with ⟨hwidths, htrace, ⟨boundTotal, hboundTotal, hbound⟩,
    hfirstlaw, hlastlaw, hnextlaw, hprevlaw, hstring, hr, hl, hc⟩
  have heq : total = boundTotal := by rw [htotal] at hboundTotal; exact Except.ok.inj hboundTotal
  unfold stringTruncateBoundaries at hrun
  rw [ite_eq_right (by omega), hcheck] at hrun
  by_cases hsourceFits : total ≤ budget
  · simp only [decide_eq_true hsourceFits] at hrun
    cases hrun
    exact hsourceFits
  · simp only [decide_eq_false hsourceFits] at hrun
    have hmax : budget + 2 ≤ JuliaLean.IntTy.i64.max := by omega
    cases hfirst : ops.firstindex str with
    | error err => simp only [hfirst] at hrun; cases hrun
    | ok first =>
      simp only [hfirst] at hrun
      cases hlast : ops.lastindex str with
      | error err => simp only [hlast] at hrun; cases hrun
      | ok last =>
        simp only [hlast, hrepl] at hrun
        cases hloop : truncateLoop ops modeOps str budget mode.value preferLeft first first last rw
            (int 0) (int 0) false with
        | none => simp only [hloop] at hrun; cases hrun
        | some value =>
          cases value with
          | error err => simp only [hloop] at hrun; cases hrun
          | ok pair =>
            rcases pair with ⟨left0, right0⟩
            have initial : truncate_columns prefixWidth suffixWidth rw budget first last rw := by
              simp only [truncate_columns, hfirstlaw first hfirst, hlastlaw last hlast,
                Int.zero_add, Int.add_zero]
              exact ⟨Int.le_refl 0, Int.le_refl 0, True.intro, hfit⟩
            have hcols := truncate_loop_columns ops modeOps str budget mode.value preferLeft first
              prefixWidth suffixWidth rw hwidths hnextlaw hprevlaw hrw hmax first last rw
              (int 0) (int 0) false initial (left0, right0) hloop
            simp only [hloop] at hrun
            cases hp : ops.prevind str left0 with
            | error err => simp only [hp] at hrun; cases hrun
            | ok left =>
              simp only [hp] at hrun
              cases hn : ops.nextind str right0 with
              | error err => simp only [hn] at hrun; cases hrun
              | ok right =>
                simp only [hn] at hrun
                cases hrun
                exact ⟨left0, right0, hp, hn, hcols⟩

theorem truncate_partial_success {A B E : Type} (value : Option (Except E A))
    (next : A → Option (Except E B)) (out : B)
    (h : partialBind value next = some (.ok out)) :
    ∃ x, value = some (.ok x) ∧ next x = some (.ok out) := by
  cases value with
  | none => cases h
  | some value =>
    cases value with
    | error err => cases h
    | ok x => exact ⟨x, rfl, h⟩

theorem truncate_some_success {A E : Type} (value : Except E A) (x : A)
    (h : some value = some (.ok x)) : value = .ok x := Option.some.inj h

theorem truncate_r_output {S V R C E : Type} (ops : TruncateOps S V R C E)
    (str : S) (repl : R) (strChars : List C) (prefixWidth suffixWidth : Index → Int)
    (rw : Index) (budget total : Int)
    (conversion : TruncateIntConversionLaw ops)
    (interface : TruncateInterface ops str repl strChars prefixWidth suffixWidth)
    (htotal : charListWidth ops strChars = .ok total)
    (hrepl : ops.textwidthReplacement repl = some (.ok rw))
    (hrw : 0 ≤ rw.val) (hfit : rw.val ≤ budget)
    (out : S) (chars : List C) (hrun : rtruncate ops str budget repl = some (.ok out))
    (htrace : TruncateTrace ops out chars) :
    ∃ w, charListWidth ops chars = .ok w ∧ w ≤ budget := by
  unfold rtruncate at hrun
  obtain ⟨index, hi, hrun⟩ := truncate_partial_success _ _ out hrun
  have hi' := truncate_some_success _ _ hi
  rw [conversion.1 budget index hi'] at hrun
  obtain ⟨boundaries, hb, hrun⟩ := truncate_partial_success _ _ out hrun
  have hs := truncate_boundaries_spec ops truncModeOps str repl strChars prefixWidth suffixWidth rw
    budget total ⟨.right⟩ true interface htotal hrepl hrw hfit boundaries hb
  rcases interface with ⟨_, _, _, _, _, _, _, hstring, hr, _, _⟩
  cases boundaries with
  | none =>
    have hout := truncate_some_success _ _ hrun
    rw [hstring out chars hout htrace]
    exact ⟨total, htotal, hs⟩
  | some pair =>
    rcases pair with ⟨left, right⟩
    obtain ⟨fi, hfi, hrun⟩ := truncate_partial_success _ _ out hrun
    obtain ⟨view, hv, hrun⟩ := truncate_partial_success _ _ out hrun
    obtain ⟨replStr, hrstr, hrun⟩ := truncate_partial_success _ _ out hrun
    have hfi' := truncate_some_success _ _ hfi
    have hv' := truncate_some_success _ _ hv
    have hrstr' := truncate_some_success _ _ hrstr
    have hconcat := truncate_some_success _ _ hrun
    obtain ⟨left0, right0, hp, hn, hprefix, hsuffix, hwithin⟩ := hs
    have hview : (ops.firstindex str >>= fun first => ops.substring str first left) = .ok view := by
      simpa only [hfi', Bind.bind, Except.bind] using hv'
    have houtput := hr rw left0 left view replStr out chars hrepl hp hview hrstr' hconcat htrace
    exact ⟨prefixWidth left0 + rw.val, houtput, by omega⟩

theorem truncate_l_output {S V R C E : Type} (ops : TruncateOps S V R C E)
    (str : S) (repl : R) (strChars : List C) (prefixWidth suffixWidth : Index → Int)
    (rw : Index) (budget total : Int)
    (conversion : TruncateIntConversionLaw ops)
    (interface : TruncateInterface ops str repl strChars prefixWidth suffixWidth)
    (htotal : charListWidth ops strChars = .ok total)
    (hrepl : ops.textwidthReplacement repl = some (.ok rw))
    (hrw : 0 ≤ rw.val) (hfit : rw.val ≤ budget)
    (out : S) (chars : List C) (hrun : ltruncate ops str budget repl = some (.ok out))
    (htrace : TruncateTrace ops out chars) :
    ∃ w, charListWidth ops chars = .ok w ∧ w ≤ budget := by
  unfold ltruncate at hrun
  obtain ⟨index, hi, hrun⟩ := truncate_partial_success _ _ out hrun
  have hi' := truncate_some_success _ _ hi
  rw [conversion.1 budget index hi'] at hrun
  obtain ⟨boundaries, hb, hrun⟩ := truncate_partial_success _ _ out hrun
  have hs := truncate_boundaries_spec ops truncModeOps str repl strChars prefixWidth suffixWidth rw
    budget total ⟨.left⟩ true interface htotal hrepl hrw hfit boundaries hb
  rcases interface with ⟨_, _, _, _, _, _, _, hstring, _, hl, _⟩
  cases boundaries with
  | none =>
    have hout := truncate_some_success _ _ hrun
    rw [hstring out chars hout htrace]
    exact ⟨total, htotal, hs⟩
  | some pair =>
    rcases pair with ⟨left, right⟩
    obtain ⟨li, hli, hrun⟩ := truncate_partial_success _ _ out hrun
    obtain ⟨view, hv, hrun⟩ := truncate_partial_success _ _ out hrun
    obtain ⟨replStr, hrstr, hrun⟩ := truncate_partial_success _ _ out hrun
    have hli' := truncate_some_success _ _ hli
    have hv' := truncate_some_success _ _ hv
    have hrstr' := truncate_some_success _ _ hrstr
    have hconcat := truncate_some_success _ _ hrun
    obtain ⟨left0, right0, hp, hn, hprefix, hsuffix, hwithin⟩ := hs
    have hview : (ops.lastindex str >>= fun last => ops.substring str right last) = .ok view := by
      simpa only [hli', Bind.bind, Except.bind] using hv'
    have houtput := hl rw right0 right view replStr out chars hrepl hn hview hrstr' hconcat htrace
    exact ⟨rw.val + suffixWidth right0, houtput, by omega⟩

theorem truncate_c_output {S V R C E : Type} (ops : TruncateOps S V R C E)
    (str : S) (repl : R) (strChars : List C) (prefixWidth suffixWidth : Index → Int)
    (rw : Index) (budget total : Int) (preferLeft : Bool)
    (conversion : TruncateIntConversionLaw ops)
    (interface : TruncateInterface ops str repl strChars prefixWidth suffixWidth)
    (htotal : charListWidth ops strChars = .ok total)
    (hrepl : ops.textwidthReplacement repl = some (.ok rw))
    (hrw : 0 ≤ rw.val) (hfit : rw.val ≤ budget)
    (out : S) (chars : List C) (hrun : ctruncate ops str budget repl preferLeft = some (.ok out))
    (htrace : TruncateTrace ops out chars) :
    ∃ w, charListWidth ops chars = .ok w ∧ w ≤ budget := by
  unfold ctruncate at hrun
  obtain ⟨index, hi, hrun⟩ := truncate_partial_success _ _ out hrun
  have hi' := truncate_some_success _ _ hi
  rw [conversion.1 budget index hi'] at hrun
  obtain ⟨boundaries, hb, hrun⟩ := truncate_partial_success _ _ out hrun
  have hs := truncate_boundaries_spec ops truncModeOps str repl strChars prefixWidth suffixWidth rw
    budget total ⟨.center⟩ preferLeft interface htotal hrepl hrw hfit boundaries hb
  rcases interface with ⟨_, _, _, _, _, _, _, hstring, _, _, hc⟩
  cases boundaries with
  | none =>
    have hout := truncate_some_success _ _ hrun
    rw [hstring out chars hout htrace]
    exact ⟨total, htotal, hs⟩
  | some pair =>
    rcases pair with ⟨left, right⟩
    obtain ⟨fi, hfi, hrun⟩ := truncate_partial_success _ _ out hrun
    obtain ⟨viewL, hvL, hrun⟩ := truncate_partial_success _ _ out hrun
    obtain ⟨li, hli, hrun⟩ := truncate_partial_success _ _ out hrun
    obtain ⟨viewR, hvR, hrun⟩ := truncate_partial_success _ _ out hrun
    obtain ⟨replStr, hrstr, hrun⟩ := truncate_partial_success _ _ out hrun
    have hfi' := truncate_some_success _ _ hfi
    have hli' := truncate_some_success _ _ hli
    have hvL' := truncate_some_success _ _ hvL
    have hvR' := truncate_some_success _ _ hvR
    have hrstr' := truncate_some_success _ _ hrstr
    have hconcat := truncate_some_success _ _ hrun
    obtain ⟨left0, right0, hp, hn, hprefix, hsuffix, hwithin⟩ := hs
    have hviewL : (ops.firstindex str >>= fun first => ops.substring str first left) = .ok viewL := by
      simpa only [hfi', Bind.bind, Except.bind] using hvL'
    have hviewR : (ops.lastindex str >>= fun last => ops.substring str right last) = .ok viewR := by
      simpa only [hli', Bind.bind, Except.bind] using hvR'
    have houtput := hc rw left0 right0 left right viewL viewR replStr out chars hrepl hp hn
      hviewL hviewR hrstr' hconcat htrace
    exact ⟨prefixWidth left0 + rw.val + suffixWidth right0, houtput, hwithin⟩

/-- Conversion, negative-width rejection, width testing, and all three truncation bounds. -/

theorem StringutilTruncateWidthBound_proven :
    JuliaLean.Proofs.base.strings.util.TruncateWidthBound := by
  intro S V R C E ops str replacement strChars width total rw preferLeft prefixWidth suffixWidth
    conversion interface htotal
  refine ⟨?_, ?_, ?_⟩
  · intro hneg M modeOps mode
    simp only [stringTruncateBoundaries, ite_eq_left hneg]
  · intro err herr
    simp only [rtruncate, ltruncate, ctruncate, herr, partialBind, and_self]
  · intro index hindex hvalue
    refine ⟨?_, ?_⟩
    · intro hneg
      simp only [rtruncate, ltruncate, ctruncate, hindex, partialBind, hvalue,
        stringTruncateBoundaries, ite_eq_left hneg, and_self]
    · intro hrepl hrw hfit
      refine ⟨truncate_interface_check ops str replacement strChars prefixWidth suffixWidth
        interface total width htotal (Int.le_trans hrw hfit), ?_, ?_, ?_⟩
      · exact truncate_r_output ops str replacement strChars prefixWidth suffixWidth rw width total
          conversion interface htotal hrepl hrw hfit
      · exact truncate_l_output ops str replacement strChars prefixWidth suffixWidth rw width total
          conversion interface htotal hrepl hrw hfit
      · exact truncate_c_output ops str replacement strChars prefixWidth suffixWidth rw width total preferLeft
          conversion interface htotal hrepl hrw hfit

