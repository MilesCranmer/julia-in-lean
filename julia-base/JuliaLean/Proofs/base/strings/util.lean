          · exact h0
      have hvalidP : ∀ q : Int, 1 ≤ q → q ≤ s.view.ncodeunits.val → thisindPure V q = q →
          ∀ g : Index, g.val = s.view.offset.val + q → Str.stringIsvalidIndex s.view.string g = true := by
        intro q hq1 hqn hq g hg
        apply (stringIsvalid_iff_pure s.view.string g (by omega) (by omega)).mpr
        rw [hg]; exact hvp q hq1 hqn hq
      -- the first kept position is a character start of the view
      have hc1 : thisindPure V ((preparedBytes p).length + 1) = (preparedBytes p).length + 1 := by
        by_cases hc0 : (preparedBytes p).length = 0
        · rw [hc0]; simp [thisindPure]
        · obtain ⟨r, hr, hrb⟩ := viewThisind_boundary s gs
            (int 1 + p.view.ncodeunits) (by rw [hcub]; omega) (by rw [hcub]; omega)
          obtain ⟨r2, hr2, hrv2⟩ := viewThisind_pure s.view (int 1 + p.view.ncodeunits)
            (by rw [hcub]; omega) (by rw [hcub]; omega) hoff hfit
          rw [hr] at hr2
          injection hr2 with hr2
          subst hr2
          rw [hcub, show ((preparedBytes p).length + 1 : Int) - 1 = (preparedBytes p).length by omega,
            Int.toNat_natCast, hvb] at hrb
          rw [hcub] at hrv2
          rw [← hrv2]
          simpa using hrb
      have hlastge : (preparedBytes p).length + 1 ≤ s.last.val := by
        rw [hlv]
        exact thisindPure_ge_valid V _ _ ((thisindPure_eq_iff V _).mp hc1) (by omega)
      have hlastvalid : thisindPure V s.last.val = s.last.val := by
        rw [hlv]; exact thisindPure_idem V _
      -- `nextind` of the parent at `last`
      have hgv : ¬ joined P (s.view.offset.val + s.last.val) :=
        (thisindPure_eq_iff P _).mp (hvp s.last.val (by omega) hlastle hlastvalid)
      obtain ⟨m, hm, hmgt, hmle, hmend, hmgap⟩ := stringNextind_next s.view.string
        (s.view.offset + s.last) (by rw [hol]; omega) (by rw [hol]; omega) (by rw [hol]; exact hgv)
      rw [hol] at hmgt hmgap
      have hgapV : ∀ q : Int, s.view.offset.val + s.last.val < q →
          q ≤ s.view.offset.val + s.view.ncodeunits.val → joined P q := by
        intro q h1 h2
        have hj := thisindPure_gap V s.view.ncodeunits.val (q - s.view.offset.val)
          (by rw [← hlv]; omega) (by omega)
        have := joined_view_parent P s.view.offset.val (q - s.view.offset.val) hoff hj
        rwa [show s.view.offset.val + (q - s.view.offset.val) = q by omega] at this
      have hmv : m.val = s.view.offset.val + s.view.ncodeunits.val + 1 := by
        apply Int.le_antisymm
        · apply Int.not_lt.mp
          intro hgt
          have hj := hmgap (s.view.offset.val + s.view.ncodeunits.val + 1) (by omega) hgt
          rcases gend with h | h
          · omega
          · exact h hj
        · apply Int.not_lt.mp
          intro hlt'
          have hj := hgapV m.val (by omega) (by omega)
          rcases hmend with h | h
          · omega
          · exact h hj
      -- the substring constructor
      have hij : (s.view.offset + (int 1 + p.view.ncodeunits)).val ≤ (s.view.offset + s.last).val := by
        rw [hoi, hol]; omega
      have hvi : Str.stringIsvalidIndex s.view.string (s.view.offset + (int 1 + p.view.ncodeunits)) = true :=
        hvalidP _ (by omega) (by omega) hc1 _ (by rw [hoi]; omega)
      have hvj : Str.stringIsvalidIndex s.view.string (s.view.offset + s.last) = true :=
        hvalidP _ (by omega) hlastle hlastvalid _ hol
      have hcheckV : (int 1 + p.view.ncodeunits).val ≤ s.last.val := by rw [hcub]; omega
      have hsub : Sub.subStringNested parentOps s.view (int 1 + p.view.ncodeunits) s.last =
          .ok ⟨s.view.string, s.view.offset + (int 1 + p.view.ncodeunits) -
            JuliaLean.base.strings.substring.one, m - (s.view.offset + (int 1 + p.view.ncodeunits))⟩ := by
        have hnlt : ¬ (s.view.offset + s.last).val < (s.view.offset + (int 1 + p.view.ncodeunits)).val := by
          omega
        have hb1 : 1 ≤ (int 1 + p.view.ncodeunits).val := by rw [hcub]; omega
        have hb2 : 1 ≤ (s.view.offset + (int 1 + p.view.ncodeunits)).val := by rw [hoi]; omega
        have hb3 : (s.view.offset + s.last).val ≤ (s.view.string.bytes.length : Int) := by
          rw [hol]; omega
        simp [Sub.subStringNested, hcheckV, parentOps, hb1, hlastle, Sub.subStringInt,
          JuliaLean.base.strings.substring.typedSubString, hnlt, hb2, hb3, hvi, hvj, hm, bind,
          Except.bind, pure, Except.pure]
      have hoffv : (s.view.offset + (int 1 + p.view.ncodeunits) -
          JuliaLean.base.strings.substring.one).val = s.view.offset.val + (preparedBytes p).length := by
        rw [ixSubV _ _ (by rw [hoi, hone]; omega) (by rw [hoi, hone]; omega), hoi, hone]; omega
      have hlenv : (m - (s.view.offset + (int 1 + p.view.ncodeunits))).val =
          s.view.ncodeunits.val - (preparedBytes p).length := by
        rw [ixSubV _ _ (by rw [hoi]; omega) (by rw [hoi]; omega), hoi, hmv]; omega
      obtain ⟨out, hout, hview⟩ := prepareView_ok ⟨s.view.string,
        s.view.offset + (int 1 + p.view.ncodeunits) - JuliaLean.base.strings.substring.one,
        m - (s.view.offset + (int 1 + p.view.ncodeunits))⟩
        (by show 0 ≤ (s.view.offset + (int 1 + p.view.ncodeunits) -
          JuliaLean.base.strings.substring.one).val; rw [hoffv]; omega)
        (by show 0 ≤ (m - (s.view.offset + (int 1 + p.view.ncodeunits))).val; rw [hlenv]; omega)
        (by
          show (s.view.offset + (int 1 + p.view.ncodeunits) -
            JuliaLean.base.strings.substring.one).val +
            (m - (s.view.offset + (int 1 + p.view.ncodeunits))).val ≤ s.view.string.bytes.length
          rw [hoffv, hlenv]; omega)
      refine ⟨out, by rw [hsub, ok_bind']; exact hout, by rw [hview], ?_⟩
      simp only [preparedBytes, viewBytes, hview]
      rw [hoffv, hlenv]
      have ho : s.view.offset.val.toNat + (preparedBytes p).length =
          (s.view.offset.val + ((preparedBytes p).length : Int)).toNat := by omega
      have hn : (s.view.ncodeunits.val - ((preparedBytes p).length : Int)).toNat =
          s.view.ncodeunits.val.toNat - (preparedBytes p).length := by omega
      rw [← ho, hn]
      exact (drop_take_drop _ _ _ _ (by omega)).symm

end JuliaLean.Proofs.base.strings.util.Round6

namespace JuliaLean.Proofs.base.strings.util.Round6
open JuliaLean JuliaLean.base.strings.basic JuliaLean.base.strings.util

private theorem ixAddW (a b : Index) (h0 : -2 ^ 62 ≤ a.val + b.val) (h1 : a.val + b.val ≤ 2 ^ 62) :
    (a + b).val = a.val + b.val := by
  change wrapInt .i64 (a.val + b.val) = _
  exact wrapInt_of_inRange .i64 _ (by simp [IntTy.min, IntTy.max, IntTy.signed, IntTy.bits]; omega)

private theorem ixSubW (a b : Index) (h0 : -2 ^ 62 ≤ a.val - b.val) (h1 : a.val - b.val ≤ 2 ^ 62) :
    (a - b).val = a.val - b.val := by
  change wrapInt .i64 (a.val - b.val) = _
  exact wrapInt_of_inRange .i64 _ (by simp [IntTy.min, IntTy.max, IntTy.signed, IntTy.bits]; omega)

private theorem zeroValW : JuliaLean.base.strings.substring.zero.val = 0 := by
  change wrapInt .i64 0 = 0
  exact wrapInt_of_inRange .i64 0 (by simp [IntTy.min, IntTy.max, IntTy.signed, IntTy.bits])

private theorem int1Val : (int 1).val = 1 := by decide

private theorem one_sub_true : int 1 - boolInt true = int 0 := by decide
private theorem one_sub_false : int 1 - boolInt false = int 1 := by decide

/-- `prevind(s, i, 1)`'s loop: the last valid index before `i`, or `0`. -/
theorem previndLoop_one {S R C CU CT E : Type} (ops : StringOps S R C CU CT E) (s : S)
    (vq : Int → Bool) :
    ∀ (k : Nat) (i : Index), 1 ≤ i.val → i.val ≤ k + 1 → i.val ≤ 2 ^ 62 →
      (∀ x : Index, 1 ≤ x.val → x.val < i.val → ops.isvalid s x = .ok (vq x.val)) →
      ∃ r, previndLoop ops s k i (int 1) = .ok r ∧ 0 ≤ r.val ∧ r.val < i.val ∧
        (r.val = 0 ∨ vq r.val = true) ∧ ∀ q, r.val < q → q < i.val → vq q = false := by
  intro k
  induction k with
  | zero =>
    intro i h1 hk _ _
    have hi : i.val = 1 := by omega
    refine ⟨i - int 1, rfl, ?_⟩
    have hv : (i - int 1).val = 0 := by rw [ixSubW _ _ (by rw [int1Val]; omega)
      (by rw [int1Val]; omega), int1Val, hi]; rfl
    rw [hv]
    exact ⟨Int.le_refl 0, by omega, Or.inl rfl, fun q h1 h2 => by omega⟩
  | succ k ih =>
    intro i h1 hk hmax hval
    by_cases h2 : 1 < i.val
    · have hcond : (decide (0 < (int 1).val) && decide (1 < i.val)) = true := by
        simp [int1Val, h2]
      have hi1 : (i - int 1).val = i.val - 1 := by
        rw [ixSubW _ _ (by rw [int1Val]; omega) (by rw [int1Val]; omega), int1Val]
      have hv := hval (i - int 1) (by omega) (by omega)
      rw [hi1] at hv
      cases hq : vq (i.val - 1) with
      | true =>
        refine ⟨i - int 1 - int 0, ?_, ?_⟩
        · rw [previndLoop]
          simp only [hcond, if_true, hv, hq, one_sub_true, bind, Except.bind]
          cases k with
          | zero => rfl
          | succ k =>
            rw [previndLoop]
            have h0 : (decide (0 < (int 0).val) && decide (1 < (i - int 1).val)) = false := by
              simp
            simp only [h0, Bool.false_eq_true, if_false]
        · have h00 : (i - int 1 - int 0).val = i.val - 1 := by
            rw [ixSubW _ _ (by rw [show (int 0).val = 0 by decide, hi1]; omega)
              (by rw [show (int 0).val = 0 by decide, hi1]; omega), hi1]
            rw [show (int 0).val = 0 by decide]; omega
          rw [h00]
          exact ⟨by omega, by omega, Or.inr hq, fun q a b => by omega⟩
      | false =>
        obtain ⟨r, hr, h0, hlt, hrv, hgap⟩ := ih (i - int 1) (by omega) (by omega) (by omega)
          (fun x a b => hval x a (by omega))
        refine ⟨r, ?_, h0, by omega, hrv, ?_⟩
        · rw [previndLoop]
          simp only [hcond, if_true, hv, hq, one_sub_false, bind, Except.bind]
          exact hr
        · intro q a b
          by_cases hq' : q = i.val - 1
          · rw [hq']; exact hq
          · exact hgap q a (by omega)
    · refine ⟨i - int 1, ?_, ?_⟩
      · rw [previndLoop]
        have hcond : (decide (0 < (int 1).val) && decide (1 < i.val)) = false := by
          simp [h2]
        simp only [hcond, Bool.false_eq_true, if_false]
      · have hi : i.val = 1 := by omega
        have hv : (i - int 1).val = 0 := by
          rw [ixSubW _ _ (by rw [int1Val]; omega) (by rw [int1Val]; omega), int1Val, hi]; rfl
        rw [hv]
        exact ⟨Int.le_refl 0, by omega, Or.inl rfl, fun q h1 h2 => by omega⟩


private theorem drop_take_take (l : List UInt8) (o n c : Nat) (hc : c ≤ n) :
    ((l.drop o).take n).take c = (l.drop o).take c := by
  rw [List.take_take, Nat.min_eq_left hc]

private theorem joined_view_parentW (P : Int → UInt8) (o x : Int) (ho : 0 ≤ o)
    (h : joined (fun y => P (o + y)) x) : joined P (o + x) := by
  have e1 : o + (x - 1) = o + x - 1 := by omega
  have e2 : o + (x - 2) = o + x - 2 := by omega
  have e3 : o + (x - 3) = o + x - 3 := by omega
  unfold joined at h ⊢
  simp only [e1, e2, e3] at h
  rcases h with ⟨p, a, b⟩ | ⟨p, a, b, c⟩ | ⟨p, a, b, c, d⟩
  · exact Or.inl ⟨by omega, a, b⟩
  · exact Or.inr (Or.inl ⟨by omega, a, b, c⟩)
  · exact Or.inr (Or.inr ⟨by omega, a, b, c, d⟩)

/-- View positions and parent positions agree on character starts. -/
theorem view_valid_parent (s : Prepared) (gs : GoodView s.view) (q : Int) (hq1 : 1 ≤ q)
    (hqn : q ≤ s.view.ncodeunits.val) :
    thisindPure (fun x => parentByte s.view.string (s.view.offset.val + x)) q = q ↔
      thisindPure (parentByte s.view.string) (s.view.offset.val + q) = s.view.offset.val + q := by
  have hsmall := s.view.string.small
  have hoff := gs.off
  have hfit := gs.fit
  have hstartP : s.view.offset.val = 0 ∨ thisindPure (parentByte s.view.string)
      (s.view.offset.val + 1) = s.view.offset.val + 1 := by
    rcases gs.start with h | h
    · exact Or.inl h
    · right
      have hone' : (s.view.offset + int 1).val = s.view.offset.val + 1 := by
        rw [ixAddW _ _ (by rw [int1Val]; omega) (by rw [int1Val]; omega), int1Val]
      have hv := (stringIsvalid_iff_pure s.view.string (s.view.offset + int 1)
        (by rw [hone']; omega) (by rw [hone']; omega)).mp h
      rwa [hone'] at hv
  by_cases hq2 : 2 ≤ q
  · exact thisindPure_view _ _ q hoff hq2 hstartP
  · have h1 : q = 1 := by omega
    subst h1
    constructor
    · intro _
      rcases hstartP with h0 | h0
      · rw [h0]; simp [thisindPure]
      · exact h0
    · intro _
      simp [thisindPure]

theorem previous_spec (s : Prepared) (gs : GoodView s.view) (a : Index) (h1 : 1 ≤ a.val)
    (h2 : a.val ≤ s.view.ncodeunits.val + 1) :
    ∃ r, previous s a = .ok r ∧ (a.val = 1 → r.val = 0) ∧
      (2 ≤ a.val → r.val =
        thisindPure (fun x => parentByte s.view.string (s.view.offset.val + x)) (a.val - 1)) := by
  have hsmall := s.view.string.small
  have hoff := gs.off
  have hfit := gs.fit
  have hval : ∀ x : Index, 1 ≤ x.val → x.val < a.val →
      preparedPrim.isvalid s x = .ok (decide (thisindPure (fun x => parentByte s.view.string (s.view.offset.val + x)) x.val = x.val)) := by
    intro x hx1 hx2
    have hox : (s.view.offset + x).val = s.view.offset.val + x.val :=
      ixAddW _ _ (by omega) (by omega)
    have hb : (decide (1 ≤ x.val) && decide (x.val ≤ s.view.ncodeunits.val)) = true := by
      simp; omega
    have hiv := stringIsvalid_iff_pure s.view.string (s.view.offset + x) (by rw [hox]; omega)
      (by rw [hox]; omega)
    rw [hox] at hiv
    have hvp := view_valid_parent s gs x.val hx1 (by omega)
    have heq : Str.stringIsvalidIndex s.view.string (s.view.offset + x) =
        decide (thisindPure (fun x => parentByte s.view.string (s.view.offset.val + x)) x.val = x.val) := by
      cases hc : Str.stringIsvalidIndex s.view.string (s.view.offset + x) with
      | true => exact (decide_eq_true (hvp.mpr (hiv.mp hc))).symm
      | false =>
        symm
        apply decide_eq_false
        intro h
        have := hiv.mpr (hvp.mp h)
        rw [hc] at this
        exact Bool.false_ne_true this
    simp [preparedPrim, Sub.isvalidSubStringAt, hx1, show x.val ≤ s.view.ncodeunits.val by omega,
      heq, bind, Except.bind, pure, Except.pure]
  obtain ⟨r, hr, hr0, hrlt, hrv, hgap⟩ := previndLoop_one preparedPrim s
    (fun q => decide (thisindPure (fun x => parentByte s.view.string (s.view.offset.val + x)) q = q)) (a.val.toNat - 1) a h1 (by omega) (by omega) hval
  have hrun : previous s a = .ok r := by
    have hz : (s.view.ncodeunits + int 1).val = s.view.ncodeunits.val + 1 := by
      rw [ixAddW _ _ (by rw [int1Val]; omega) (by rw [int1Val]; omega), int1Val]
    have hc1 : ¬ (int 1).val < 0 := by rw [int1Val]; omega
    have hc2 : (decide (0 < a.val) && decide (a.val ≤ (s.view.ncodeunits + int 1).val)) = true := by
      rw [hz]; simp; omega
    have hc3 : ((int 1).val == 0) = false := by rw [int1Val]; decide
    have hc2' : (!(decide (0 < a.val) && decide (a.val ≤ (preparedPrim.ncodeunits s + int 1).val)))
        = false := by
      show (!(decide (0 < a.val) && decide (a.val ≤ (s.view.ncodeunits + int 1).val))) = false
      rw [hc2]; rfl
    unfold previous previndInt
    simp only [hc1, if_false, Bool.false_eq_true, hc3, hc2']
    exact hr
  refine ⟨r, hrun, fun ha => by omega, fun ha => ?_⟩
  have ht1 := thisindPure_ge_one (fun x => parentByte s.view.string (s.view.offset.val + x)) (a.val - 1) (by omega)
  have htle := thisindPure_le (fun x => parentByte s.view.string (s.view.offset.val + x)) (a.val - 1)
  have htv := thisindPure_idem (fun x => parentByte s.view.string (s.view.offset.val + x)) (a.val - 1)
  apply Int.le_antisymm
  · apply Int.not_lt.mp
    intro hgt
    have hj := thisindPure_gap (fun x => parentByte s.view.string (s.view.offset.val + x)) (a.val - 1) r.val hgt (by omega)
    rcases hrv with h | h
    · omega
    · have := (thisindPure_eq_iff (fun x => parentByte s.view.string (s.view.offset.val + x)) r.val).mp (of_decide_eq_true h)
      exact this hj
  · apply Int.not_lt.mp
    intro hlt
    have := hgap _ hlt (by omega)
    simp only [htv, decide_true] at this
    cases this

set_option maxHeartbeats 1000000 in
theorem chopSuffixFastBytesRound6_proven : ChopSuffixFastBytes := by
  intro s p hs hp
  have gs := denseArg_good s hs
  have gp := denseArg_good p hp
  have gend := denseArg_goodEnd s hs
  have hlast := denseArg_last s hs
