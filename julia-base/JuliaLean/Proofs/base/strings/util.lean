/-- A successful encode within the representable input-length range has the exact bytes. -/
theorem g23_hexEncoding_bounded (allocString : Nat → Result Raw) (bytes : List UInt8)
    (out : HexStorage)
    (allocation : ∀ n str, allocString n = .ok str → str.bytes.length = n)
    (bound : bytes.length < 2 ^ 63)
    (run : bytes2hex (encodingOpsWith true allocString) bytes = .ok out) :
    storedBytes out = lowerHex bytes := by
  have encoding := ChatGPTBatch1.Hex.StringutilBytes2hexEncoding_proven allocString bytes
  have small : bytes.length < 2 ^ 62 := by
    by_cases small : bytes.length < 2 ^ 62
    · exact small
    · obtain ⟨fn, failed⟩ := encoding.2.1 (by omega) bound
      rw [run] at failed
      cases failed
  cases allocated : allocString (2 * bytes.length) with
  | error e =>
    have failed := (encoding.1 small).2 e allocated
    rw [run] at failed
    cases failed
  | ok str =>
    obtain ⟨encoded, encodedRun, content⟩ :=
      (encoding.1 small).1 str allocated (allocation _ _ allocated)
    rw [run] at encodedRun
    cases encodedRun
    exact content

/-- A lowercase hexadecimal digit has its advertised small numeric code. -/
theorem g23_lowerHexDigit_nat (n : Nat) (small : n < 16) :
    (lowerHexDigit n).toNat = if n < 10 then 0x30 + n else 0x61 + n - 10 := by
  unfold lowerHexDigit
  change (if n < 10 then 0x30 + n else 0x61 + n - 10) % 256 = _
  apply Nat.mod_eq_of_lt
  split <;> omega

/-- Independent range property for both nibbles. -/
theorem g23_lowerHexDigit_range (n : Nat) (small : n < 16) :
    (0x30 ≤ (lowerHexDigit n).toNat ∧ (lowerHexDigit n).toNat ≤ 0x39) ∨
    (0x61 ≤ (lowerHexDigit n).toNat ∧ (lowerHexDigit n).toNat ≤ 0x66) := by
  rw [g23_lowerHexDigit_nat n small]
  split <;> omega

theorem g23_lowerHex_length (bytes : List UInt8) :
    (lowerHex bytes).length = 2 * bytes.length := by
  induction bytes with
  | nil => rfl
  | cons b bytes ih =>
    simp only [lowerHex, List.flatMap_cons, List.length_append, List.length_cons, List.length_nil]
    change 2 + (lowerHex bytes).length = 2 * (bytes.length + 1)
    rw [ih]
    omega

theorem g23_lowerHex_digits (bytes : List UInt8) :
    ∀ d ∈ lowerHex bytes,
      (0x30 ≤ d.toNat ∧ d.toNat ≤ 0x39) ∨
      (0x61 ≤ d.toNat ∧ d.toNat ≤ 0x66) := by
  intro d member
  change d ∈ lowerHexBytes bytes at member
  obtain ⟨b, _, member⟩ := List.mem_flatMap.mp member
  simp only [List.mem_cons, List.mem_nil_iff, or_false] at member
  have byteBound : b.toNat < 256 := b.toFin.isLt
  rcases member with eq | eq
  · subst d
    exact g23_lowerHexDigit_range _ (by omega)
  · subst d
    exact g23_lowerHexDigit_range _ (Nat.mod_lt _ (by decide))

/-- A bounded version of the lowercase contract; the frozen unbounded target is unchanged. -/
theorem StringutilBytes2hexLowercase_bounded (allocString : Nat → Result Raw)
    (bytes : List UInt8) (out : HexStorage)
    (allocation : ∀ n str, allocString n = .ok str → str.bytes.length = n)
    (bound : bytes.length < 2 ^ 63)
    (run : bytes2hex (encodingOpsWith true allocString) bytes = .ok out) :
    (storedBytes out).length = 2 * bytes.length ∧
    (∀ digit ∈ storedBytes out,
      0x30 ≤ digit.toNat ∧ digit.toNat ≤ 0x39 ∨
      0x61 ≤ digit.toNat ∧ digit.toNat ≤ 0x66) := by
  rw [g23_hexEncoding_bounded allocString bytes out allocation bound run]
  exact ⟨g23_lowerHex_length bytes, g23_lowerHex_digits bytes⟩

/-- Independent hexadecimal decoding recognizes the encoding of each nibble. -/
theorem g23_hexNibble_lower (n : Nat) (small : n < 16) :
    hexNibble (lowerHexDigit n) = some n := by
  have digit := g23_lowerHexDigit_nat n small
  by_cases lt : n < 10
  · rw [ite_eq_left lt] at digit
    have decimal : 0x30 ≤ (lowerHexDigit n).toNat ∧ (lowerHexDigit n).toNat ≤ 0x39 := by omega
    unfold hexNibble
    rw [ite_eq_left decimal]
    exact congrArg some (by omega)
  · rw [ite_eq_right lt] at digit
    have decimal : ¬ (0x30 ≤ (lowerHexDigit n).toNat ∧ (lowerHexDigit n).toNat ≤ 0x39) := by omega
    have upper : ¬ (0x41 ≤ (lowerHexDigit n).toNat ∧ (lowerHexDigit n).toNat ≤ 0x46) := by omega
    have lower : 0x61 ≤ (lowerHexDigit n).toNat ∧ (lowerHexDigit n).toNat ≤ 0x66 := by omega
    unfold hexNibble
    rw [ite_eq_right decimal, ite_eq_right upper, ite_eq_left lower]
    exact congrArg some (by omega)

/-- The mathematical digit-pair specification is inverse to lowercase encoding. -/
theorem g23_hexadecimalValue_lower (bytes : List UInt8) :
    hexadecimalValue (lowerHex bytes) = some bytes := by
  induction bytes with
  | nil => rfl
  | cons b bytes ih =>
    change hexadecimalValue
      (lowerHexDigit (b.toNat / 16) :: lowerHexDigit (b.toNat % 16) :: lowerHex bytes) = _
    have hb : b.toNat < 256 := b.toFin.isLt
    rw [hexadecimalValue, g23_hexNibble_lower (b.toNat / 16) (by omega),
      g23_hexNibble_lower (b.toNat % 16) (Nat.mod_lt _ (by decide)), ih]
    change some (UInt8.ofNat (16 * (b.toNat / 16) + b.toNat % 16) :: bytes) = _
    have hsplit : 16 * (b.toNat / 16) + b.toNat % 16 = b.toNat := by omega
    rw [hsplit, UInt8.ofNat_toNat]

/-- Bounded roundtrip, including exact propagation of the decoder's allocation error. -/
theorem StringutilHexRoundtrip_bounded (allocString : Nat → Result Raw)
    (alloc : Index → Result (List UInt8)) (bytes : List UInt8)
    (out : HexStorage) (str : Raw)
    (allocation : ∀ n s, allocString n = .ok s → s.bytes.length = n)
    (bound : bytes.length < 2 ^ 63)
    (run : bytes2hex (encodingOpsWith true allocString) bytes = .ok out)
    (content : str.bytes = storedBytes out) :
    let n := JuliaLean.base.int.shr_Int (JuliaLean.base.strings.string.stringLength str) (int 1)
    (∀ e, alloc n = .error e → hexStringCallWith alloc str = some (.error e)) ∧
    (∀ d, alloc n = .ok d → d.length = n.val.toNat →
      hexStringCallWith alloc str = some (.ok bytes)) := by
  have encoded := g23_hexEncoding_bounded allocString bytes out allocation bound run
  have decoded : hexadecimalValue str.bytes = some bytes := by
    rw [content, encoded]
    exact g23_hexadecimalValue_lower bytes
  have decoder := (ChatGPTBatch1.Hex.StringutilHex2bytesAscii_proven alloc).2 str
  refine ⟨decoder.1, ?_⟩
  intro d allocated length
  have result := decoder.2 d allocated length
  rw [decoded] at result
  exact result


