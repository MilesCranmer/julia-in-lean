      r.first.val ≤ (xStarString.bytes.length : Int) + 1 ∧
      (r.first.val ≤ r.last.val → r.last.val ≤ (xStarString.bytes.length : Int)) := by
  by_cases h1 : k.val = 1
  · have hv : v = some (.range xStarR1) := by
      exact (show some (.range xStarR1) = v by
        simpa [xStarFindnext, h1] using hfind).symm
    subst v
    have hspec : Round6.occurrenceOf (some (.range xStarR1)) = some xStarR1 := by
      decide
    have hr : r = xStarR1 := (Option.some.inj (hspec.symm.trans hocc)).symm
    subst r
    have hkval : k.val = xStarR1.first.val := by rw [h1]; decide
    exact ⟨hkval, by decide, by decide⟩
  · by_cases h2 : k.val = 2
    · have hv : v = some (.range xStarR2) := by
        exact (show some (.range xStarR2) = v by
          simpa [xStarFindnext, h1, h2] using hfind).symm
