    | true =>
      simp only [if_true]
      rw [Bool.and_eq_true] at hc
      obtain ⟨hpre, hvb⟩ := hc
      have hle : (preparedBytes p).length ≤ (preparedBytes s).length := by
        have := (List.isPrefixOf_iff_prefix.mp hpre).length_le
        simpa using this
      let V : Int → UInt8 := fun x => parentByte s.view.string (s.view.offset.val + x)
      let P : Int → UInt8 := parentByte s.view.string
      have hast : (s.view.ncodeunits - p.view.ncodeunits + int 1).val =
          s.view.ncodeunits.val - p.view.ncodeunits.val + 1 := by
        rw [ixAddW _ _ (by rw [ixSubW _ _ (by omega) (by omega), int1Val]; omega)
          (by rw [ixSubW _ _ (by omega) (by omega), int1Val]; omega),
          ixSubW _ _ (by omega) (by omega), int1Val]
      obtain ⟨stop, hstop, hst1, hst2⟩ := previous_spec s gs
        (s.view.ncodeunits - p.view.ncodeunits + int 1) (by rw [hast]; omega) (by rw [hast]; omega)
      have hrun1 : (do
          let stop ← previous s (s.view.ncodeunits - p.view.ncodeunits + int 1)
          preparedSlice s (int 1) stop) = preparedSlice s (int 1) stop := by
        rw [hstop]; rfl
      rw [hrun1]
      unfold preparedSlice
      have ho1 : (s.view.offset + int 1).val = s.view.offset.val + 1 := by
        rw [ixAddW _ _ (by rw [int1Val]; omega) (by rw [int1Val]; omega), int1Val]
      by_cases hcn : (preparedBytes p).length = (preparedBytes s).length
      · have hs0 : stop.val = 0 := hst1 (by rw [hast]; omega)
        have hos : (s.view.offset + stop).val = s.view.offset.val := by
          rw [ixAddW _ _ (by omega) (by omega), hs0]; omega
        have hsub : Sub.subStringNested parentOps s.view (int 1) stop =
            .ok ⟨s.view.string, JuliaLean.base.strings.substring.zero,
              JuliaLean.base.strings.substring.zero⟩ := by
          have hnle : ¬ (int 1).val ≤ stop.val := by rw [int1Val, hs0]; omega
          have hlt : (s.view.offset + stop).val < (s.view.offset + int 1).val := by
            rw [hos, ho1]; omega
          simp [Sub.subStringNested, hnle, hs0, Sub.subStringInt,
            JuliaLean.base.strings.substring.typedSubString, hlt, bind, Except.bind, pure,
            Except.pure]
        obtain ⟨out, hout, hview⟩ := prepareView_ok ⟨s.view.string,
          JuliaLean.base.strings.substring.zero, JuliaLean.base.strings.substring.zero⟩
          (by simp only [zeroValW]; omega) (by simp only [zeroValW]; omega)
          (by simp only [zeroValW]; omega)
        refine ⟨out, by rw [hsub, ok_bind']; exact hout, by rw [hview], ?_⟩
        rw [show (preparedBytes s).length - (preparedBytes p).length = 0 by omega,
          List.take_zero]
        simp [preparedBytes, viewBytes, hview, zeroValW]
      · have hlt : (preparedBytes p).length < (preparedBytes s).length := by omega
        obtain ⟨k, hk⟩ : ∃ k : Int, k = s.view.ncodeunits.val - p.view.ncodeunits.val := ⟨_, rfl⟩
        have hk1 : 1 ≤ k := by omega
        have hsv : stop.val = thisindPure V k := by
          rw [hst2 (by rw [hast]; omega), hast]; congr 1; omega
        have ht1 := thisindPure_ge_one V k hk1
        have htle := thisindPure_le V k
        have htv := thisindPure_idem V k
        have hos : (s.view.offset + stop).val = s.view.offset.val + stop.val :=
          ixAddW _ _ (by omega) (by omega)
        -- the end of the kept part is a boundary of the parent
        have hvbk : thisindPure V (k + 1) = k + 1 := by
          obtain ⟨r, hr, hrb⟩ := viewThisind_boundary s gs
            (s.view.ncodeunits - p.view.ncodeunits + int 1) (by rw [hast]; omega)
            (by rw [hast]; omega)
          obtain ⟨r2, hr2, hrv2⟩ := viewThisind_pure s.view
            (s.view.ncodeunits - p.view.ncodeunits + int 1) (by rw [hast]; omega)
            (by rw [hast]; omega) hoff hfit
          rw [hr] at hr2
          injection hr2 with hr2
          subst hr2
          have hkk : (s.view.ncodeunits.val - p.view.ncodeunits.val + 1 - 1).toNat =
              (preparedBytes s).length - (preparedBytes p).length := by omega
          rw [hast, hkk, hvb] at hrb
          rw [hast] at hrv2
          have e : s.view.ncodeunits.val - p.view.ncodeunits.val + 1 = k + 1 := by omega
          rw [e] at hrv2 hrb
          rw [← hrv2]
          simpa using hrb
        have hendP : ¬ joined P (s.view.offset.val + k + 1) := by
          have := (view_valid_parent s gs (k + 1) (by omega) (by omega)).mp hvbk
          rw [show s.view.offset.val + (k + 1) = s.view.offset.val + k + 1 by omega] at this
          exact (thisindPure_eq_iff P _).mp this
        have hgv : ¬ joined P (s.view.offset.val + stop.val) := by
          rw [hsv]
          exact (thisindPure_eq_iff P _).mp
            ((view_valid_parent s gs _ ht1 (by omega)).mp htv)
        obtain ⟨m, hm, hmgt, hmle, hmend, hmgap⟩ := stringNextind_next s.view.string
          (s.view.offset + stop) (by rw [hos]; omega) (by rw [hos, hsv]; omega)
          (by rw [hos]; exact hgv)
        rw [hos] at hmgt hmgap
        have hgapV : ∀ q : Int, s.view.offset.val + stop.val < q →
            q ≤ s.view.offset.val + k → joined P q := by
          intro q h1 h2
          have hj := thisindPure_gap V k (q - s.view.offset.val) (by rw [← hsv]; omega)
            (by omega)
          have := joined_view_parentW P s.view.offset.val (q - s.view.offset.val) hoff hj
          rwa [show s.view.offset.val + (q - s.view.offset.val) = q by omega] at this
        have hmv : m.val = s.view.offset.val + k + 1 := by
          apply Int.le_antisymm
          · apply Int.not_lt.mp
            intro hgt
            exact hendP (hmgap _ (by rw [hsv]; omega) hgt)
          · apply Int.not_lt.mp
            intro hlt'
            have hj := hgapV m.val (by omega) (by omega)
            rcases hmend with h | h
            · omega
            · exact h hj
        have hvi : Str.stringIsvalidIndex s.view.string (s.view.offset + int 1) = true := by
          apply (stringIsvalid_iff_pure s.view.string _ (by rw [ho1]; omega)
            (by rw [ho1]; omega)).mpr
          rw [ho1]
          exact (view_valid_parent s gs 1 (Int.le_refl 1) (by omega)).mp (by simp [thisindPure])
        have hvj : Str.stringIsvalidIndex s.view.string (s.view.offset + stop) = true := by
          apply (stringIsvalid_iff_pure s.view.string _ (by rw [hos]; omega)
            (by rw [hos]; omega)).mpr
          rw [hos, hsv]
          exact (view_valid_parent s gs _ ht1 (by omega)).mp htv
        have hsub : Sub.subStringNested parentOps s.view (int 1) stop =
            .ok ⟨s.view.string, s.view.offset + int 1 - JuliaLean.base.strings.substring.one,
              m - (s.view.offset + int 1)⟩ := by
          have hcheck : (int 1).val ≤ stop.val := by rw [int1Val]; omega
          have hb1 : 1 ≤ (int 1).val := by rw [int1Val]; omega
          have hb1' : stop.val ≤ s.view.ncodeunits.val := by omega
          have hnlt : ¬ (s.view.offset + stop).val < (s.view.offset + int 1).val := by
            rw [hos, ho1]; omega
          have hb2 : 1 ≤ (s.view.offset + int 1).val := by rw [ho1]; omega
          have hb3 : (s.view.offset + stop).val ≤ (s.view.string.bytes.length : Int) := by
            rw [hos]; omega
          simp [Sub.subStringNested, hcheck, parentOps, hb1, hb1', Sub.subStringInt,
            JuliaLean.base.strings.substring.typedSubString, hnlt, hb2, hb3, hvi, hvj, hm, bind,
            Except.bind, pure, Except.pure]
        have hoffv : (s.view.offset + int 1 - JuliaLean.base.strings.substring.one).val =
            s.view.offset.val := by
          rw [ixSubW _ _ (by rw [ho1, hone]; omega) (by rw [ho1, hone]; omega), ho1, hone]; omega
        have hlenv : (m - (s.view.offset + int 1)).val = k := by
          rw [ixSubW _ _ (by rw [ho1]; omega) (by rw [ho1]; omega), ho1, hmv]; omega
        obtain ⟨out, hout, hview⟩ := prepareView_ok ⟨s.view.string,
          s.view.offset + int 1 - JuliaLean.base.strings.substring.one,
          m - (s.view.offset + int 1)⟩
          (by show 0 ≤ (s.view.offset + int 1 - JuliaLean.base.strings.substring.one).val
              rw [hoffv]; omega)
          (by show 0 ≤ (m - (s.view.offset + int 1)).val; rw [hlenv]; omega)
          (by
            show (s.view.offset + int 1 - JuliaLean.base.strings.substring.one).val +
              (m - (s.view.offset + int 1)).val ≤ s.view.string.bytes.length
            rw [hoffv, hlenv]; omega)
        refine ⟨out, by rw [hsub, ok_bind']; exact hout, by rw [hview], ?_⟩
        simp only [preparedBytes, viewBytes, hview]
        rw [hoffv, hlenv]
        have hkn : k.toNat = (preparedBytes s).length - (preparedBytes p).length := by
          simp only [preparedBytes] at hS hP ⊢; omega
        rw [hkn]
        exact (drop_take_take _ _ _ _ (by simp only [preparedBytes] at hS ⊢; omega)).symm

