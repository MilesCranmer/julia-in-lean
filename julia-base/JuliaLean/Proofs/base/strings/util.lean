theorem iVal (n : Int) (hlo : -2 ^ 63 ≤ n) (hhi : n < 2 ^ 63) :
    (B.i n).val = n := by
  exact wrapInt_of_inRange .i64 n (by
    change -9223372036854775808 ≤ n ∧ n ≤ 9223372036854775807
    omega)

theorem iAdd (a b : Int) : B.i a + B.i b = B.i (a + b) := by
  apply Subtype.ext
  change wrapInt .i64 (wrapInt .i64 a + wrapInt .i64 b) = wrapInt .i64 (a + b)
  rw [JuliaLean.Proofs.base.int.wrapInt_add_left, JuliaLean.Proofs.base.int.wrapInt_add_right]

theorem iSub (a b : Int) : B.i a - B.i b = B.i (a - b) := by
  apply Subtype.ext
