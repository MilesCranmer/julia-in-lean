      subst x
      exact ⟨[], by simp⟩
    | cons b tail =>
      have htail : (b :: tail).getLast? = some x := by simpa [suGetLastCons] using h
      obtain ⟨before, hbefore⟩ := ih htail
      exact ⟨a :: before, by simp [hbefore]⟩

theorem suPreviousPrefix {S R C CU CT E : Type}
    (prim : StringOps S R C CU CT E) (errs : ViewErrors S E)
    (s : S) (ls before after : List (Index × C)) (law : Lawful prim s ls)
    (p : Index × C) (hsplit : ls = before ++ p :: after) :
    ∃ i out, previndOne (gFull prim) s p.1 = .ok i ∧
