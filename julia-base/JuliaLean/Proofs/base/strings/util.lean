    let first ← preparedOps.iterateFirst s
    return first.map (fun (c, i) => (.abstractChar c, i))
  iterateNext s i := do
    let next ← preparedOps.iterateAt s i
    return next.map (fun (c, i) => (.abstractChar c, i))

def decodeCharacters (dest : List UInt8) (s : Prepared) :
