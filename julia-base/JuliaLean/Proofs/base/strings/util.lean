theorem streamNativeByteEq (a b : UInt8) :
    JuliaLean.base.int.eq_int (JInt.lit .u8 a.toNat) (JInt.lit .u8 b.toNat) =
      decide (a = b) := by
  have val (x : UInt8) : (JInt.lit .u8 x.toNat).val = (x.toNat : Int) := by
    change wrapInt .u8 (x.toNat : Int) = (x.toNat : Int)
    apply wrapInt_of_inRange
    have hx := UInt8.toNat_lt x
    change 0 ≤ (x.toNat : Int) ∧ (x.toNat : Int) ≤ 255
    omega
  rw [JuliaLean.Proofs.base.int.eq_int_eq, val a, val b]
  simp only [Int.natCast_inj, UInt8.toNat_inj]

def streamEqStep (p : UInt8 × UInt8) (st : Option (Option Bool) × Bool) :
    Id (ForInStep (Option (Option Bool) × Bool)) :=
  if !decide (p.1 = p.2) then .done (some (some false), st.2)
  else .yield (none, st.2)

theorem streamEqLoop (a b : List UInt8) (hlen : a.length = b.length) :
    forIn (a.zip b) (none, false) streamEqStep =
      (if a = b then (none, false) else (some (some false), false)) := by
  induction a generalizing b with
  | nil =>
    cases b with
    | nil => rfl
    | cons c cs => simp only [List.length_nil, List.length_cons] at hlen; omega
  | cons c cs ih =>
    cases b with
    | nil => simp only [List.length_nil, List.length_cons] at hlen; omega
    | cons d ds =>
      have ht : cs.length = ds.length := by simp only [List.length_cons] at hlen; omega
      by_cases hcd : c = d
      · subst d
        simpa [List.zip_cons_cons, List.forIn_cons, streamEqStep, bind, pure] using ih ds ht
      · simp [List.zip_cons_cons, List.forIn_cons, streamEqStep, hcd, bind, pure]

theorem streamEqualByteVectors (a b : List UInt8) :
    equalByteVectors a b = decide (a = b) := by
  unfold equalByteVectors JuliaLean.base.abstractarray.arrayEqual
  simp only [bind, pure, streamNativeByteEq, Bool.false_eq_true, ite_false,
    Bool.not_eq_true, decide_eq_false_iff_not]
  by_cases hlen : a.length = b.length
  · simp only [hlen, bne_self_eq_false, Bool.false_eq_true, ite_false]
    have hl := streamEqLoop a b hlen
    unfold streamEqStep at hl
    rw [hl]
    by_cases hab : a = b <;> simp only [hab, ite_true, ite_false, decide_true, decide_false, Bool.false_eq_true]
  · have hab : a ≠ b := fun h => hlen (congrArg List.length h)
    simp only [bne_iff_ne.mpr hlen, ite_true, hab, decide_false]


theorem streamPrefixEq (unread preBytes : List UInt8) :
    equalByteVectors (unread.take preBytes.length) preBytes = preBytes.isPrefixOf unread := by
  rw [streamEqualByteVectors]
  apply Bool.eq_iff_iff.mpr
  simp only [decide_eq_true_eq, List.isPrefixOf_iff_prefix, List.prefix_iff_eq_take]
  exact eq_comm

theorem streamUserPrefix {X E : Type} (ops : PrefixIOOps X UInt32 E) (eofError : E)
    (unread : X → List UInt8) (marked : X → Option (List UInt8)) (io : X) (pre : Prepared)
    (laws : StreamLaws ops eofError unread marked) (hd : DenseArg pre) :
    ∃ out, startswithIOUTF8 ops (fun p => p.view.ncodeunits) preparedBytes equalByteVectors io pre =
      .ok ((preparedBytes pre).isPrefixOf (unread io), out) ∧
      unread out = unread io ∧ marked out = none := by
  have hg := denseArg_good pre hd
  have hlen := goodView_bytes_length pre.view hg
  have hn : pre.view.ncodeunits.val.toNat = (preparedBytes pre).length := by
    change pre.view.ncodeunits.val.toNat = (viewBytes pre.view).length
    omega
  obtain ⟨m, hm, hum, hmm⟩ := laws.mark io
  obtain ⟨r, hr, _, hmr⟩ := laws.readBytes m pre.view.ncodeunits hg.len
  obtain ⟨out, ho, huo, hmo⟩ := laws.reset r (unread io) (hmr.trans hmm)
  refine ⟨out, ?_, huo, hmo⟩
  simp only [startswithIOUTF8, hm, hr, ho, hum, hn, bind, Except.bind, pure, Except.pure,
    streamPrefixEq]

open JuliaLean.Proofs.base.strings.util.ChatGPTBatch1.HexIOCore.HexIO
  (iVal iAdd iSub convertNat uVal remUInt)

/-- Mark saves the initial byte offset without consuming input. -/
theorem streamMark (readChar : Stream → Except StreamError (UInt32 × Stream))
    (before unread : List UInt8) :
    (prefixStreamOps readChar).mark (readableStream before unread) =
      .ok { readableStream before unread with mark := int before.length } := by
  have hp : JuliaLean.base.iobuffer.position (readableStream before unread) =
      int before.length := by
    unfold JuliaLean.base.iobuffer.position readableStream JuliaLean.base.iobuffer.newBuf
    change JuliaLean.base.iobuffer.i ((before.length : Int) + 1) -
      JuliaLean.base.iobuffer.i 0 - JuliaLean.base.iobuffer.i 1 = _
    rw [iSub, iSub]
    congr 1
    omega
  simp only [prefixStreamOps, streamRun, JuliaLean.base.iobuffer.mark, EStateM.run,
    bind, EStateM.bind, get, getThe, MonadStateOf.get, EStateM.get,
    set, MonadStateOf.set, EStateM.set, pure, EStateM.pure, hp, Except.map]


theorem streamResetOp (readChar : Stream → Except StreamError (UInt32 × Stream))
    (io : Stream) : (prefixStreamOps readChar).reset io =
      (streamRun JuliaLean.base.iobuffer.reset io).map (·.2) := rfl

/-- A reset consists of seeking to the saved position and clearing the mark. -/
theorem streamResetRaw (io out : Stream)
    (hm : JuliaLean.base.iobuffer.ismarked io = true)
    (hs : (JuliaLean.base.iobuffer.seek io.mark).run io = .ok () out) :
    streamRun JuliaLean.base.iobuffer.reset io =
      .ok (io.mark, { out with mark := JuliaLean.base.iobuffer.i (-1) }) := by
  have hs' : JuliaLean.base.iobuffer.seek io.mark io = .ok () out := hs
  simp only [streamRun, JuliaLean.base.iobuffer.reset, EStateM.run, bind, EStateM.bind,
    get, getThe, MonadStateOf.get, EStateM.get, hm, Bool.not_true,
    Bool.false_eq_true, ite_false, hs', modify, modifyGet, MonadStateOf.modifyGet,
    EStateM.modifyGet, pure, EStateM.pure]

/-- Seeking a marked readable buffer returns to its original byte pointer. -/
theorem streamReset (readChar : Stream → Except StreamError (UInt32 × Stream))
    (before unread : List UInt8) (ptr : Index) (hsize : before.length + unread.length < 2 ^ 62) :
    (prefixStreamOps readChar).reset
      { readableStream before unread with mark := int before.length, ptr := ptr } =
        .ok (readableStream before unread) := by
  let io := { readableStream before unread with mark := int before.length, ptr := ptr }
  have hv : (int before.length).val = (before.length : Int) :=
    iVal _ (by omega) (by omega)
  have hp : (int ((before.length : Int) + 1)).val = (before.length : Int) + 1 :=
    iVal _ (by omega) (by omega)
  have ht : (int ((before.length + unread.length : Nat) + 1)).val =
      (before.length + unread.length : Nat) + 1 := iVal _ (by omega) (by omega)
  have hmark : JuliaLean.base.iobuffer.ismarked io = true := by
    simp only [JuliaLean.base.iobuffer.ismarked, io, hv, ge_iff_le, Int.natCast_nonneg,
      decide_true]
  have hseek : JuliaLean.base.iobuffer.clampI
      (JuliaLean.base.iobuffer.translateSeekPosition io io.mark)
      (JuliaLean.base.iobuffer.getOffset io + JuliaLean.base.iobuffer.i 1)
      (io.size + JuliaLean.base.iobuffer.i 1) = int ((before.length : Int) + 1) := by
    have htranslate : JuliaLean.base.iobuffer.translateSeekPosition io io.mark =
        int ((before.length : Int) + 1) := by
      simp only [JuliaLean.base.iobuffer.translateSeekPosition, io, readableStream,
        JuliaLean.base.iobuffer.newBuf, hv]
      change JuliaLean.base.iobuffer.clampToI ((before.length : Int) + 0 + 1) = _
      simp only [JuliaLean.base.iobuffer.clampToI, Int.add_zero]
      rw [ite_eq_right (by omega), ite_eq_right (by omega)]
      rfl
    rw [htranslate]
    change JuliaLean.base.iobuffer.clampI (int ((before.length : Int) + 1))
      (JuliaLean.base.iobuffer.i 0 + JuliaLean.base.iobuffer.i 1)
      (JuliaLean.base.iobuffer.i (before ++ unread).length + JuliaLean.base.iobuffer.i 1) = _
    rw [iAdd, iAdd]
    simp only [List.length_append, Int.natCast_add]
    have htot : (JuliaLean.base.iobuffer.i
        ((before.length : Int) + unread.length + 1)).val =
        (before.length : Int) + unread.length + 1 := iVal _ (by omega) (by omega)
    simp only [JuliaLean.base.iobuffer.clampI, htot, hp,
      show ¬ (before.length : Int) + 1 > before.length + unread.length + 1 by omega,
      show (JuliaLean.base.iobuffer.i ((0 : Int) + 1)).val = 1 by decide,
      show ¬ (before.length : Int) + 1 < 1 by omega, ite_false]
  have hseekRun : (JuliaLean.base.iobuffer.seek io.mark).run io =
      .ok () { io with ptr := int ((before.length : Int) + 1) } := by
    have hseekable : io.seekable = true := rfl
    simp only [JuliaLean.base.iobuffer.seek, EStateM.run, bind, EStateM.bind,
      get, getThe, MonadStateOf.get, EStateM.get, hseekable, Bool.not_true,
      Bool.false_eq_true, ite_false, hseek, set, MonadStateOf.set, EStateM.set]
  rw [streamResetOp]
  change (streamRun JuliaLean.base.iobuffer.reset io).map (·.2) = _
  rw [streamResetRaw io _ hmark hseekRun]
  rfl


/-- The pointer read returns exactly the requested initial unread bytes. -/
theorem streamReadAt (before unread : List UInt8) (n : Nat)
    (hn : n ≤ unread.length) (hsize : before.length + unread.length < 2 ^ 62) :
    JuliaLean.base.iobuffer.readAt (before ++ unread)
      (int ((before.length : Int) + 1)) n = .ok (unread.take n) := by
  have hp : (int ((before.length : Int) + 1)).val = (before.length : Int) + 1 :=
    iVal _ (by omega) (by omega)
  by_cases hz : n = 0
  · subst n
    rfl
  · have hb : 1 ≤ (int ((before.length : Int) + 1)).val ∧
        (int ((before.length : Int) + 1)).val + n - 1 ≤ (before ++ unread).length := by
      rw [hp, List.length_append]
      omega
    simp only [JuliaLean.base.iobuffer.readAt, hz, ite_false, hb, ite_true,
      JuliaLean.base.iobuffer.slice, hp]
    have hstart : ((before.length : Int) + 1 - 1).toNat = before.length := by omega
    have hcount : ((before.length : Int) + 1 + n - 1 - ((before.length : Int) + 1) + 1).toNat = n := by omega
    rw [hstart, hcount, List.drop_left]
    simp only [hp] at hb
    rw [ite_eq_left hb]

theorem streamToU (n : Nat) (hn : n < 2 ^ 64) :
    JuliaLean.base.iobuffer.toU n = .ok (JuliaLean.base.iobuffer.u n) := by
  have hr : IntTy.u64.min ≤ (n : Int) ∧ (n : Int) ≤ IntTy.u64.max := by
    change 0 ≤ (n : Int) ∧ (n : Int) ≤ 18446744073709551615
    omega
  unfold JuliaLean.base.iobuffer.toU JInt.convert
  rw [dite_eq_left hr]
  apply congrArg Except.ok
  apply Subtype.ext
  exact (uVal n hn).symm


/-- Reading a bounded vector preserves the backing data and advances only the pointer. -/
theorem streamReadBangRaw (io : Stream) (n : Nat) (nb : JuliaLean.base.iobuffer.U)
    (np : Index) (bytes : List UInt8)
    (hconv : JuliaLean.base.iobuffer.toU n = .ok nb)
    (hreadable : io.readable = true)
    (hmin : JuliaLean.base.iobuffer.uminU
      (JInt.rem .u64 (JuliaLean.base.iobuffer.bytesavailable io)) nb = nb)
    (hread : JuliaLean.base.iobuffer.readAt io.data io.ptr nb.val.toNat = .ok bytes)
    (hptr : JuliaLean.base.iobuffer.toI (JInt.rem .u64 io.ptr + nb).val = .ok np)
    (hle : nb.val ≤ (JInt.rem .u64 (JuliaLean.base.iobuffer.bytesavailable io)).val) :
    streamRun (JuliaLean.base.iobuffer.readBang n) io =
      .ok (bytes, { io with ptr := np }) := by
  simp only [streamRun, JuliaLean.base.iobuffer.readBang, JuliaLean.base.iobuffer.unsafeRead,
    hconv, JuliaLean.base.iobuffer.lift, EStateM.run, bind, EStateM.bind, pure, EStateM.pure,
