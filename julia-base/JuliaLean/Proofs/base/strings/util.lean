private theorem decodedHexDigitSpecFin : ∀ i : Fin 256,
    decodedHexDigit (UInt8.ofNat i.val) =
      (hexNibble (UInt8.ofNat i.val)).map UInt8.ofNat := by
  decide +kernel

private theorem decodedHexDigitSpec (c : UInt8) :
    decodedHexDigit c = (hexNibble c).map UInt8.ofNat := by
  have hc : c.toNat < 256 := c.toFin.isLt
  have h := decodedHexDigitSpecFin ⟨c.toNat, hc⟩
  have hcast : UInt8.ofNat c.toNat = c := by simp
  simpa only [hcast] using h

private theorem numberFromHexByteError (c : UInt8) (e : Strings.SErr)
    (h : numberFromHexByte (Strings.SErr.jl ∘ JlError.argumentError) c = .error e) :
    ∃ msg, e = Strings.SErr.jl (.argumentError msg) := by
  by_cases hd : (0x30 ≤ c && c ≤ 0x39)
  · have hfalse : False := by
      simpa [numberFromHexByte, hd, pure, Except.pure] using h
    exact False.elim hfalse
  · by_cases hl : (0x61 ≤ (c ||| 0x20) && (c ||| 0x20) ≤ 0x66)
    · have hfalse : False := by
        simpa [numberFromHexByte, hd, hl, pure, Except.pure] using h
      exact False.elim hfalse
    · have heq : e = Strings.SErr.jl (.argumentError "byte is not an ASCII hexadecimal digit") := by
        simpa [numberFromHexByte, hd, hl, pure, Except.pure, throw, throwThe,
          MonadExceptOf.throw] using h.symm
      exact ⟨"byte is not an ASCII hexadecimal digit", heq⟩

theorem hexadecimalDigitsProven : HexadecimalDigits := by
  intro c
  have hs := decodedHexDigitSpec c
  cases hn : hexNibble c with
  | none =>
    have hnone : decodedHexDigit c = none := by simpa [hn] using hs
    unfold decodedHexDigit at hnone
    cases hd : numberFromHexByte (Strings.SErr.jl ∘ JlError.argumentError) c with
    | error e =>
      obtain ⟨msg, hmsg⟩ := numberFromHexByteError c e hd
      exact ⟨msg, by simpa [hmsg] using hd⟩
    | ok b => simp [hd] at hnone
  | some n =>
    have hsome : decodedHexDigit c = some (UInt8.ofNat n) := by simpa [hn] using hs
    unfold decodedHexDigit at hsome
    cases hd : numberFromHexByte (Strings.SErr.jl ∘ JlError.argumentError) c with
    | error e => simp [hd] at hsome
    | ok b =>
      have hb : b = UInt8.ofNat n := by simpa [hd] using hsome
      change numberFromHexByte (fun msg => Strings.SErr.jl (.argumentError msg)) c =
        Except.ok (UInt8.ofNat n)
      exact hd.trans (congrArg Except.ok hb)
open JuliaLean.Proofs.base.int

private theorem lpadPositiveFinishError {S C R O N E FS : Type}
    (ops : PadValueOps S C R O N E) (remOps : PadRemainderOps S C R FS E)
    (s p : PadInput S C) (n : N) (converted width padWidth : Index) (err : E)
    (hannot : (do if ← ops.isAnnotated s then pure true else ops.isAnnotated p) = .ok false)
    (hconv : ops.toInt n = .ok converted)
    (hwidth : ops.textwidth s = some (.ok width))
    (hpadwidth : ops.textwidth p = some (.ok padWidth))
    (hpositive : ¬ (ops.signed converted - width).val ≤ 0)
    (hfinish : (do
      if padWidth.val = 0 then
        throw (ops.argumentError (← lpadZeroWidthMessage ops s p))
      let (q, r) ← ops.divrem (ops.signed converted - width) padWidth
      let pq ← ops.repeatPad p q
      if r.val = 0 then
        return Sum.inl (← ops.assemble false [.value pq, .value s])
      return Sum.inr (pq, r)) = .error err) :
    lpad ops remOps s p n = some (.error err) := by
  unfold lpad
  simp only [partialBind, hannot, hconv, hwidth]
  rw [if_neg hpositive]
  simp only [hpadwidth, hfinish, partialBind]

private def cw : List UInt8 → Int := fun _ => 1
private abbrev BPadInput := PadInput (List UInt8) (List UInt8)
private def padSource : BPadInput := .string [0x61]
private def padText : BPadInput := .string [0x20]
private def minWidth : Index := int (-(2 : Int) ^ 63)
private def sourceWidth : Index := int 1
private def witnessOps : PadValueOps (List UInt8) (List UInt8) (List UInt8) (List UInt8) Index String :=
  { bytePadOps cw with
    repeatPad := fun _ _ => .error "OutOfMemoryError" }
private def witnessRemOps : PadRemainderOps (List UInt8) (List UInt8) (List UInt8)
    (List (Index × List UInt8)) String := bytePadRemainderOps cw

private theorem wrappedSubValue :
    (JInt.lit IntTy.i64 (-9223372036854775808) - JInt.lit IntTy.i64 1).val =
      9223372036854775807 := by
  change wrapInt .i64
    (wrapInt .i64 (-9223372036854775808) - wrapInt .i64 1) =
      9223372036854775807
  have hone : wrapInt .i64 1 = 1 := by
    apply wrapInt_of_inRange
    simp [IntTy.min, IntTy.max, IntTy.signed, IntTy.bits]
  rw [hone, wrapInt_sub_left]
  simp only [wrapInt, IntTy.signed, IntTy.bits]
  omega

private theorem witnessPositive : 0 < (minWidth - int 1).val := by
  change 0 < (JInt.lit IntTy.i64 (-9223372036854775808) - JInt.lit IntTy.i64 1).val
  rw [wrappedSubValue]
  omega

private theorem witnessWidth :
    witnessOps.textwidth padSource = some (.ok sourceWidth) ∧
    witnessOps.textwidth padText = some (.ok sourceWidth) := by
  constructor <;> simp [witnessOps, padSource, padText, sourceWidth, cw,
    bytePadOps, byteTextwidth, byteCharacters, int]

private theorem witnessSourceWidthVal : sourceWidth.val = 1 := by
  change wrapInt .i64 1 = 1
  exact wrapInt_of_inRange .i64 1 (by
    simp [IntTy.min, IntTy.max, IntTy.signed, IntTy.bits])

private theorem witnessMinWidthVal : minWidth.val = IntTy.min .i64 := by
  change wrapInt .i64 (IntTy.min .i64) = IntTy.min .i64
  exact wrapInt_of_inRange .i64 (IntTy.min .i64) (by
    simp [IntTy.min, IntTy.max, IntTy.signed, IntTy.bits])

private theorem witnessLte : (witnessOps.signed minWidth).val ≤ sourceWidth.val := by
  change minWidth.val ≤ sourceWidth.val
  rw [witnessMinWidthVal, witnessSourceWidthVal]
  simp [IntTy.min, IntTy.signed, IntTy.bits]

private theorem witnessMPositive :
    0 < (witnessOps.signed minWidth - sourceWidth).val := by
  change 0 < (minWidth - int 1).val
  exact witnessPositive

private theorem witnessMNonpositive :
    ¬ (witnessOps.signed minWidth - sourceWidth).val ≤ 0 := by
  intro h
  have hp := witnessMPositive
  omega

private theorem witnessWidthNonzero : sourceWidth.val ≠ 0 := by
  rw [witnessSourceWidthVal]
  decide

private theorem witnessToInt : witnessOps.toInt minWidth = .ok minWidth := by
  simp [witnessOps, bytePadOps]

private theorem witnessAnnotated : (do
    if ← witnessOps.isAnnotated padSource then pure true else witnessOps.isAnnotated padText) =
      .ok false := by
  simp [witnessOps, bytePadOps]

private theorem witnessFinishError (m l : Index) (hl : l.val ≠ 0) :
    (do
      if l.val = 0 then
        throw (witnessOps.argumentError
          (← lpadZeroWidthMessage witnessOps padSource padText))
      let (q, r) ← witnessOps.divrem m l
      let pq ← witnessOps.repeatPad padText q
      if r.val = 0 then
        return Sum.inl (← witnessOps.assemble false [.value pq, .value padSource])
      return Sum.inr (pq, r)) = .error "OutOfMemoryError" := by
  simp [hl, witnessOps, bytePadOps, bind, Except.bind, pure, Except.pure]

private theorem lpadCallIsError :
    lpad witnessOps witnessRemOps padSource padText minWidth =
      some (.error "OutOfMemoryError") := by
  exact lpadPositiveFinishError witnessOps witnessRemOps padSource padText minWidth
    minWidth sourceWidth sourceWidth "OutOfMemoryError" witnessAnnotated witnessToInt
    witnessWidth.1 witnessWidth.2 witnessMNonpositive
    (witnessFinishError (witnessOps.signed minWidth - sourceWidth) sourceWidth witnessWidthNonzero)

theorem lpadNoPadding_refuted : ¬ LpadNoPadding := by
  intro h
  have hresult := (h witnessOps witnessRemOps padSource padText minWidth minWidth sourceWidth
    witnessToInt witnessWidth.1 witnessLte).1
  have hexpected : some (do
      let stringfn ← if ← witnessOps.isAnnotated padSource then pure true else witnessOps.isAnnotated padText
      witnessOps.assemble stringfn [.value padSource]) = some (.ok [0x61]) := by
    simp [witnessOps, padSource, padText, bytePadOps, bytePadBytes]
  have he : (Except.error "OutOfMemoryError" : Except String (List UInt8)) =
      Except.ok [0x61] := by
    apply Option.some.inj
    simpa only [lpadCallIsError, hexpected] using hresult
  cases he

inductive WalkSegment {S R C CU CT E : Type}
    (prim : StringOps S R C CU CT E) (s : S) (terminal : Index) :
    Index → List (Index × C) → Prop where
  | stop {i : Index} (atEnd : i.val = terminal.val) :
      WalkSegment prim s terminal i []
  | step {i j : Index} {c : C} {rest : List (Index × C)}
      (inBounds : 1 ≤ i.val ∧ i.val ≤ (prim.ncodeunits s).val)
      (yield : prim.iterateAt s i = .ok (some (c, j)))
      (advances : i.val < j.val)
      (tail : WalkSegment prim s terminal j rest) :
      WalkSegment prim s terminal i ((i, c) :: rest)

private theorem indexOfIntVal (z : Int)
    (h : IntTy.min .i64 ≤ z ∧ z ≤ IntTy.max .i64) : (int z).val = z := by
  change wrapInt .i64 z = z
  exact wrapInt_of_inRange .i64 z h

private theorem indexAddOneVal (a : Index) (ha : 0 ≤ a.val)
    (hmax : a.val + 1 ≤ IntTy.max .i64) :
    (a + int 1).val = a.val + 1 := by
  have hone : (int 1).val = 1 := by decide
  change wrapInt .i64 (a.val + (int 1).val) = a.val + 1
  rw [hone]
  have hmin : IntTy.min .i64 ≤ 0 := by
    simp [IntTy.min, IntTy.signed, IntTy.bits]
  exact wrapInt_of_inRange .i64 (a.val + 1) ⟨by omega, hmax⟩

private theorem segmentStartBound {S R C CU CT E : Type}
    (prim : StringOps S R C CU CT E) (s : S) (terminal : Index)
    {i : Index} {pairs : List (Index × C)} (walk : WalkSegment prim s terminal i pairs) :
    i.val ≤ terminal.val := by
  induction walk with
  | stop atEnd => omega
  | step inBounds yield advances tail ih => omega

private def localIndex {S : Type} (v : Sub.SubString S) (i : Index) : Index :=
  int (i.val - v.offset.val)

private theorem localIndexVal {S : Type} (v : Sub.SubString S) (terminal i : Index)
    (hoff0 : 0 ≤ v.offset.val)
    (hspan : v.offset.val + v.ncodeunits.val + 1 = terminal.val)
    (hoff : v.offset.val + 1 ≤ i.val) (hi : i.val ≤ terminal.val) :
    (localIndex v i).val = i.val - v.offset.val := by
  unfold localIndex
  apply indexOfIntVal
  have hterminal := terminal.property.2
  have hmin : IntTy.min .i64 ≤ 0 := by
    simp [IntTy.min, IntTy.signed, IntTy.bits]
  constructor <;> omega

private theorem viewIterateAtSegmentStep {S R C CU CT : Type}
    (prim : StringOps S R C CU CT JlError) (errs : ViewErrors S JlError)
    (s : S) (v : Sub.SubString S) (terminal i j : Index) (c : C)
    (hstring : v.string = s) (hoff0 : 0 ≤ v.offset.val)
    (hspan : v.offset.val + v.ncodeunits.val + 1 = terminal.val)
    (hoff : v.offset.val + 1 ≤ i.val) (hi : i.val < terminal.val)
    (hadvance : i.val < j.val)
    (hin : 1 ≤ i.val ∧ i.val ≤ (prim.ncodeunits s).val)
    (hj : j.val ≤ terminal.val)
    (hiter : prim.iterateAt s i = .ok (some (c, j))) :
    viewIterateAt prim errs v (localIndex v i) =
      .ok (some (c, localIndex v j)) := by
  have hlocal : (localIndex v i).val = i.val - v.offset.val :=
    localIndexVal v terminal i hoff0 hspan hoff (by omega)
  have hlocalLower : 1 ≤ (localIndex v i).val := by rw [hlocal]; omega
  have hlocalUpper : (localIndex v i).val ≤ v.ncodeunits.val := by
    rw [hlocal]; omega
  have hparent : v.offset + localIndex v i = i := by
    apply Subtype.ext
    change wrapInt .i64 (v.offset.val + (localIndex v i).val) = i.val
    rw [hlocal]
    have hsum : v.offset.val + (i.val - v.offset.val) = i.val := by omega
    rw [hsum]
    exact wrapInt_of_inRange .i64 i.val i.property
  have hcheck : viewCheck errs v (localIndex v i) = .ok () := by
    simp [viewCheck, viewInBounds, JuliaLean.base.strings.basic.checkbounds,
      JuliaLean.base.strings.basic.checkboundsScalar, hlocalLower, hlocalUpper,
      bind, Except.bind, pure, Except.pure]
  have hlen : 0 ≤ v.ncodeunits.val := by omega
  have hlenMax : v.ncodeunits.val + 1 ≤ IntTy.max .i64 := by
    have ht := terminal.property.2
    omega
  have hEndVal : (v.ncodeunits + JuliaLean.base.strings.substring.one).val =
      v.ncodeunits.val + 1 := by
    change (v.ncodeunits + int 1).val = v.ncodeunits.val + 1
    exact indexAddOneVal v.ncodeunits hlen hlenMax
  have hnotEnd :
      (localIndex v i).val ≠ (v.ncodeunits + JuliaLean.base.strings.substring.one).val := by
    rw [hlocal, hEndVal]
    omega
  have hend : JuliaLean.base.int.eq_int (localIndex v i)
      (v.ncodeunits + JuliaLean.base.strings.substring.one) = false := by
    rw [JuliaLean.Proofs.base.int.eq_int_eq]
    simp [hnotEnd]
  have hparent' : viewParentIndex (E := JlError) v.offset (localIndex v i) = .ok i := by
    unfold viewParentIndex
    rw [hparent]
  have hjLower : v.offset.val + 1 ≤ j.val := by omega
  have hlocalJ := localIndexVal v terminal j hoff0 hspan hjLower hj
  have hdiff : IntTy.min .i64 ≤ j.val - v.offset.val ∧
      j.val - v.offset.val ≤ IntTy.max .i64 := by
    have ht := terminal.property.2
    have hmin : IntTy.min .i64 ≤ 0 := by
      simp [IntTy.min, IntTy.signed, IntTy.bits]
    omega
  have hnext : j - v.offset = localIndex v j := by
    apply Subtype.ext
    change wrapInt .i64 (j.val - v.offset.val) = (localIndex v j).val
    rw [wrapInt_of_inRange .i64 _ hdiff, hlocalJ]
  rw [viewIterateAt, JuliaLean.base.strings.substring.iterateSubString]
  simp only [hend, hcheck, hparent', hstring, hiter, bind, Except.bind, pure, Except.pure]
  simp
  exact hnext

private theorem viewTraceOfSegment {S R C CU CT : Type}
    (prim : StringOps S R C CU CT JlError) (errs : ViewErrors S JlError)
    (s : S) (v : Sub.SubString S) (terminal : Index)
    {i : Index} {pairs : List (Index × C)}
    (walk : WalkSegment prim s terminal i pairs)
    (hstring : v.string = s) (hoff0 : 0 ≤ v.offset.val)
    (hspan : v.offset.val + v.ncodeunits.val + 1 = terminal.val)
    (hoff : v.offset.val + 1 ≤ i.val) :
    ∃ first, viewIterateAt prim errs v (localIndex v i) = .ok first ∧
      Trace (viewIterateAt prim errs v) first (pairs.map Prod.snd) := by
  revert hoff
  induction walk with
  | @stop i atEnd =>
    intro hoff
    have hiUpper : i.val ≤ terminal.val := by rw [atEnd]; omega
    have hlocal := localIndexVal v terminal i hoff0 hspan hoff hiUpper
    have hlen : 0 ≤ v.ncodeunits.val := by omega
    have hlenMax : v.ncodeunits.val + 1 ≤ IntTy.max .i64 := by
      have ht := terminal.property.2
      omega
    have hEndVal : (v.ncodeunits + JuliaLean.base.strings.substring.one).val =
        v.ncodeunits.val + 1 := by
      change (v.ncodeunits + int 1).val = v.ncodeunits.val + 1
      exact indexAddOneVal v.ncodeunits hlen hlenMax
    have hEndEq : localIndex v i =
        v.ncodeunits + JuliaLean.base.strings.substring.one := by
      apply Subtype.ext
      rw [hlocal, hEndVal, atEnd]
      omega
    refine ⟨none, ?_, Trace.nil⟩
    rw [hEndEq]
    simp [viewIterateAt, JuliaLean.base.strings.substring.iterateSubString,
      JuliaLean.base.strings.substring.one, JuliaLean.Proofs.base.int.eq_int_eq,
      bind, Except.bind, pure, Except.pure]
  | @step i j c rest inBounds yield advances tail ih =>
    intro hoff
    have hj : j.val ≤ terminal.val := segmentStartBound prim s terminal tail
    have hiTerminal : i.val < terminal.val := by omega
    have hstep := viewIterateAtSegmentStep prim errs s v terminal i j c
      hstring hoff0 hspan hoff hiTerminal advances inBounds hj yield
    obtain ⟨first, hfirst, htrace⟩ := ih (by omega)
    refine ⟨some (c, localIndex v j), hstep, ?_⟩
    simpa only [List.map_cons] using Trace.cons hfirst htrace

theorem viewIteratesSegment {S R C CU CT : Type}
    (prim : StringOps S R C CU CT JlError) (errs : ViewErrors S JlError)
    (s : S) (v : Sub.SubString S) (terminal first : Index)
    (pairs : List (Index × C))
    (walk : WalkSegment prim s terminal first pairs)
    (hstring : v.string = s) (hoff0 : 0 ≤ v.offset.val)
    (hspan : v.offset.val + v.ncodeunits.val + 1 = terminal.val)
    (hstart : v.offset.val + 1 = first.val) :
    ViewIterates prim errs v (pairs.map Prod.snd) := by
  have hfirstBound := segmentStartBound prim s terminal walk
  have hlocalStart : localIndex v first = int 1 := by
    apply Subtype.ext
    have hv := localIndexVal v terminal first hoff0 hspan
      (by rw [hstart]; omega) hfirstBound
    rw [hv]
    have hone : (int 1).val = 1 := by decide
    rw [hone]
    omega
  obtain ⟨firstState, hfirstState, htrace⟩ :=
    viewTraceOfSegment prim errs s v terminal walk hstring hoff0 hspan
      (by rw [hstart]; omega)
  unfold ViewIterates Iterates
  refine ⟨firstState, ?_, ?_⟩
  · change viewIterateAt prim errs v (int 1) = .ok firstState
    rw [← hlocalStart]
    exact hfirstState
  · simpa only [gSubPrim] using htrace
private def segmentEnd (ncu : Index) (after : List (Index × C)) : Int :=
  match after with
  | [] => ncu.val + 1
  | p :: _ => p.1.val

theorem walkSegmentFromPrefix {S R C CU CT E : Type}
    (prim : StringOps S R C CU CT E) (s : S) {start : Index} {pairs : List (Index × C)}
    (walk : Walk prim s start pairs) (before after : List (Index × C))
    (hsplit : pairs = before ++ after) :
    ∃ terminal, WalkSegment prim s terminal start before ∧
      terminal.val = segmentEnd (prim.ncodeunits s) after := by
  induction walk generalizing before after with
  | @stop i atEnd done =>
    cases before with
    | nil =>
      cases after with
      | nil =>
        refine ⟨i, WalkSegment.stop rfl, ?_⟩
        simpa [segmentEnd] using atEnd
      | cons p rest => simp at hsplit
    | cons p rest => simp at hsplit
  | @step i j c rest inBounds yield advances tail ih =>
    cases before with
    | nil =>
      have hafter : after = (i, c) :: rest := by simpa using hsplit.symm
      refine ⟨i, WalkSegment.stop rfl, ?_⟩
      simp [segmentEnd, hafter]
    | cons p beforeTail =>
      have hsplit' : (i, c) :: rest = p :: (beforeTail ++ after) := by
        simpa using hsplit
      injection hsplit' with hp hrest
      subst p
      obtain ⟨terminal, hsegment, hterminal⟩ := ih beforeTail after hrest
      exact ⟨terminal, WalkSegment.step inBounds yield advances hsegment, hterminal⟩
private theorem typedSubStringParent {S C CT E : Type}
    (ops : JuliaLean.base.strings.substring.SubStringOps S C CT E)
    (s : S) (i j : Index) (v : Sub.SubString S)
    (h : JuliaLean.base.strings.substring.typedSubString ops s i j = .ok v) :
    v.string = s := by
  unfold JuliaLean.base.strings.substring.typedSubString at h
  split at h
  · simp at h
    cases h
    rfl
  · cases hb : ops.checkboundsRange s i j with
    | error e => simp [hb] at h
    | ok unit =>
      cases hi : ops.isvalid s i with
      | error e => simp [hb, hi] at h
      | ok bi =>
        cases bi with
        | false => simp [hb, hi] at h
        | true =>
          cases hj : ops.isvalid s j with
          | error e => simp [hb, hi, hj] at h
          | ok bj =>
            cases bj with
            | false => simp [hb, hi, hj] at h
            | true =>
              cases hn : ops.nextind s j with
              | error e => simp [hb, hi, hj, hn] at h
              | ok next =>
                simp [hb, hi, hj, hn] at h
                cases h
                rfl

private theorem typedSubStringFields {S C CT E : Type}
    (ops : JuliaLean.base.strings.substring.SubStringOps S C CT E)
    (s : S) (i j : Index) (v : Sub.SubString S)
    (hij : i.val ≤ j.val)
    (h : JuliaLean.base.strings.substring.typedSubString ops s i j = .ok v) :
    v.offset = i - JuliaLean.base.strings.substring.one ∧
      ∃ next, ops.nextind s j = .ok next ∧ v.ncodeunits = next - i := by
  unfold JuliaLean.base.strings.substring.typedSubString at h
  have hnot : ¬ j.val < i.val := by omega
  simp only [if_neg hnot] at h
  cases hb : ops.checkboundsRange s i j with
  | error e => simp [hb] at h
  | ok unit =>
    cases hi : ops.isvalid s i with
    | error e => simp [hb, hi] at h
    | ok bi =>
      cases bi with
      | false => simp [hb, hi] at h
      | true =>
        cases hj : ops.isvalid s j with
        | error e => simp [hb, hi, hj] at h
        | ok bj =>
          cases bj with
          | false => simp [hb, hi, hj] at h
          | true =>
            cases hn : ops.nextind s j with
            | error e => simp [hb, hi, hj, hn] at h
            | ok next =>
              simp only [hb, hi, hj, hn, bind, Except.bind, pure, Except.pure] at h
              cases h
              exact ⟨rfl, next, rfl, rfl⟩

private theorem typedSubStringViewSpan {S C CT E : Type}
    (ops : JuliaLean.base.strings.substring.SubStringOps S C CT E)
    (s : S) (i j next : Index) (v : Sub.SubString S)
    (hij : i.val ≤ j.val) (hi1 : 1 ≤ i.val) (hnextLower : i.val ≤ next.val)
    (hnext : ops.nextind s j = .ok next)
    (h : JuliaLean.base.strings.substring.typedSubString ops s i j = .ok v) :
    v.offset.val + 1 = i.val ∧
      v.offset.val + v.ncodeunits.val + 1 = next.val := by
  obtain ⟨hoff, next', hnext', hlen⟩ := typedSubStringFields ops s i j v hij h
  have hnextEq : next' = next := by
    have hh : Except.ok next' = Except.ok next := hnext'.symm.trans hnext
    injection hh with heq
  subst next'
  have hone : JuliaLean.base.strings.substring.one.val = 1 := by decide
  have hoffSub : (i - JuliaLean.base.strings.substring.one).val = i.val - 1 := by
    change wrapInt .i64 (i.val - JuliaLean.base.strings.substring.one.val) = i.val - 1
    rw [hone]
    have hmin : IntTy.min .i64 ≤ 0 := by
      simp [IntTy.min, IntTy.signed, IntTy.bits]
    exact wrapInt_of_inRange .i64 (i.val - 1) ⟨by omega, by omega⟩
  have hlenSub : (next - i).val = next.val - i.val := by
    change wrapInt .i64 (next.val - i.val) = next.val - i.val
    have hmin : IntTy.min .i64 ≤ 0 := by
      simp [IntTy.min, IntTy.signed, IntTy.bits]
    exact wrapInt_of_inRange .i64 (next.val - i.val) ⟨by omega, by omega⟩
  have hoffVal : v.offset.val = i.val - 1 := by rw [hoff, hoffSub]
  have hlenVal : v.ncodeunits.val = next.val - i.val := by rw [hlen, hlenSub]
  constructor
  · rw [hoffVal]
    omega
  · rw [hoffVal, hlenVal]
    omega


private theorem nextindLoopZero {S R C CU CT E : Type}
    (prim : StringOps S R C CU CT E) (s : S) (z i : Index) :
    ∀ fuel, nextindLoop prim s z fuel i (int 0) = .ok i := by
  have hzero : i + int 0 = i := by
    apply Subtype.ext
    change wrapInt .i64 (i.val + (int 0).val) = i.val
    rw [JuliaLean.Proofs.base.strings.basic.int_zero_val, Int.add_zero]
    exact wrapInt_of_inRange .i64 i.val i.property
  intro fuel
  cases fuel <;> simp [nextindLoop, hzero,
    JuliaLean.Proofs.base.strings.basic.int_zero_val]

private theorem nextindLoopTo {S R C CU CT E : Type}
    (prim : StringOps S R C CU CT E) (s : S) (target : Index)
    (htarget : target.val ≤ (prim.ncodeunits s).val + 1)
    (htargetMax : target.val ≤ IntTy.max .i64)
    (hvalid : target.val ≤ (prim.ncodeunits s).val → prim.isvalid s target = .ok true) :
    ∀ (fuel : Nat) (i : Index), 0 ≤ i.val → i.val < target.val →
      target.val - i.val - 1 ≤ (fuel : Int) →
      (∀ k : Index, i.val < k.val → k.val < target.val →
        prim.isvalid s k = .ok false) →
      nextindLoop prim s (prim.ncodeunits s) fuel i (int 1) = .ok target := by
  intro fuel
  induction fuel with
  | zero =>
    intro i hi hit hf hinvalid
    have heq : i + int 1 = target := by
      apply Subtype.ext
      rw [indexAddOneVal i hi (by omega)]
      omega
    simpa [nextindLoop] using congrArg (Except.ok (ε := E)) heq
  | succ fuel ih =>
    intro i hi hit hf hinvalid
    by_cases hlast : i.val = (prim.ncodeunits s).val
    · have heq : i + int 1 = target := by
        apply Subtype.ext
        rw [indexAddOneVal i hi (by omega)]
        omega
      simpa [nextindLoop, hlast, JuliaLean.Proofs.base.strings.basic.int_one_val] using congrArg (Except.ok (ε := E)) heq
    · have hil : i.val < (prim.ncodeunits s).val := by omega
      have hplus : (i + int 1).val = i.val + 1 := indexAddOneVal i hi (by omega)
      by_cases heq : (i + int 1).val = target.val
      · have hiEq : i + int 1 = target := Subtype.ext heq
        have hv := hvalid (by omega)
        have hsub : int 1 - boolInt true = int 0 := by decide
        simp [nextindLoop, hil, hiEq, hv, nextindLoopZero, hsub,
          JuliaLean.Proofs.base.strings.basic.int_one_val,
          bind, Except.bind, pure, Except.pure]
      · have hlt : (i + int 1).val < target.val := by omega
        have hv := hinvalid (i + int 1) (by omega) hlt
        have hrec := ih (i + int 1) (by omega) hlt (by omega)
          (fun k hk hkt => hinvalid k (by omega) hkt)
        have hsub : int 1 - boolInt false = int 1 := by decide
        simpa [nextindLoop, hil, hv, hsub,
          JuliaLean.Proofs.base.strings.basic.int_one_val,
          bind, Except.bind, pure, Except.pure] using hrec

private theorem nextindOneTo {S R C CU CT E : Type}
    (prim : StringOps S R C CU CT E) (s : S) (i target : Index)
    (hi : 0 ≤ i.val) (hiBound : i.val ≤ (prim.ncodeunits s).val)
    (hit : i.val < target.val) (htarget : target.val ≤ (prim.ncodeunits s).val + 1)
    (hvalid : target.val ≤ (prim.ncodeunits s).val → prim.isvalid s target = .ok true)
    (hinvalid : ∀ k : Index, i.val < k.val → k.val < target.val →
      prim.isvalid s k = .ok false) :
    nextindOne (gFull prim) s i = .ok target := by
  have hloop := nextindLoopTo prim s target htarget target.property.2 hvalid
    ((prim.ncodeunits s).val - i.val).toNat i hi hit (by omega) hinvalid
  simpa [nextindOne, gFull, modelStringOps, nextindInt, hi, hiBound,
    JuliaLean.Proofs.base.strings.basic.int_one_val,
    JuliaLean.Proofs.base.strings.basic.nextindLoop_thisindOps] using hloop


private theorem lawfulLastIndex {S R C CU CT E : Type}
    (prim : StringOps S R C CU CT E) (s : S) (layout : List (Index × C))
    (law : Lawful prim s layout) :
    ∃ last : Index, (gFull prim).lastindex s = .ok last ∧
      0 ≤ last.val ∧ last.val ≤ (prim.ncodeunits s).val ∧
      (layout = [] → last.val = 0) ∧
      (∀ p ∈ layout, p.1.val ≤ last.val) ∧
      (layout ≠ [] → prim.isvalid s last = .ok true) ∧
      (∀ k : Index, last.val < k.val → k.val ≤ (prim.ncodeunits s).val →
        prim.isvalid s k = .ok false) := by
  cases layout with
  | nil =>
    cases law.walk with
    | stop atEnd done =>
      have hn : (prim.ncodeunits s).val = 0 := by
        have hone : (int 1).val = 1 := by decide
        omega
      have hnIndex : prim.ncodeunits s = int 0 := Subtype.ext hn
      refine ⟨int 0, ?_, by decide, by simpa [hn], by simp, ?_, ?_, ?_⟩
      · have hp : (int 0 + int 1).val = 1 := by decide
        simp [gFull, modelStringOps, lastindexString, thisindInt, thisindLoop, hnIndex, hp]
      · simp
      · simp
      · intro k hlo hhi
        have hz : (int 0).val = 0 := by decide
        omega
  | cons first rest =>
    obtain ⟨last, hlast⟩ := getLastSome first rest
    have hf := walkLastFacts prim s law.walk last hlast
    have hmem := getLastMem hlast
    have hv : prim.isvalid s last.1 = .ok true := by
      have h := law.isvalid last.1 hf.2.2.1 hf.2.2.2
      have ha : ((first :: rest).any (fun p => p.1.val == last.1.val)) = true :=
        List.any_eq_true.mpr ⟨last, hmem, by simp⟩
      simpa [ha] using h
    have hinv : ∀ k : Index, last.1.val < k.val → k.val ≤ (prim.ncodeunits s).val →
        prim.isvalid s k = .ok false := by
      intro k hlo hhi
      have ha : ((first :: rest).any (fun p => p.1.val == k.val)) = false := by
        cases hh : ((first :: rest).any (fun p => p.1.val == k.val)) with
        | false => rfl
        | true =>
          obtain ⟨p, hp, heq⟩ := List.any_eq_true.mp hh
          have hpBound := hf.2.1 p hp
          have heq' : p.1.val = k.val := by simpa using beq_iff_eq.mp heq
          omega
      simpa [ha] using law.isvalid k (by omega) hhi
    refine ⟨last.1, ?_, by omega, hf.2.2.2, by simp, hf.2.1, fun _ => hv, hinv⟩
    have h := JuliaLean.Proofs.base.strings.basic.thisindInt_rewind prim s
      (prim.ncodeunits s) last.1 hf.2.2.1 hf.2.2.2 (Int.le_refl _)
      (walkEndBound prim s law.walk) (Or.inr hv) (fun k hk => hinv k hk.1 hk.2)
    simpa [gFull, modelStringOps, lastindexString] using h

private theorem walkSegmentFull {S R C CU CT E : Type}
    (prim : StringOps S R C CU CT E) (s : S) (terminal : Index)
    (hend : terminal.val = (prim.ncodeunits s).val + 1)
    {start : Index} {pairs : List (Index × C)} (walk : Walk prim s start pairs) :
    WalkSegment prim s terminal start pairs := by
  induction walk with
  | stop atEnd done => exact WalkSegment.stop (by omega)
  | step bounds yield advances tail ih => exact WalkSegment.step bounds yield advances ih

private theorem emptyViewIterates {S R C CU CT : Type}
    (prim : StringOps S R C CU CT JlError) (errs : ViewErrors S JlError) (s : S) :
    ViewIterates prim errs (⟨s, int 0, int 0⟩ : Sub.SubString S) [] := by
  refine ⟨none, ?_, Trace.nil⟩
  change viewIterateAt prim errs (⟨s, int 0, int 0⟩ : Sub.SubString S) (int 1) = .ok none
  have hp : (int 0 + JuliaLean.base.strings.substring.one).val = 1 := by decide
  simp [viewIterateAt, Sub.iterateSubString, JuliaLean.Proofs.base.int.eq_int_eq, hp,
    bind, Except.bind, pure, Except.pure]

private theorem rangeSegment {S R C CU CT : Type}
    (prim : StringOps S R C CU CT JlError) (errs : ViewErrors S JlError)
    (s : S) (last terminal i : Index) (c : C) (rest : List (Index × C))
    (walk : WalkSegment prim s terminal i ((i,c) :: rest))
    (hile : i.val ≤ last.val) (hlast : last.val ≤ (prim.ncodeunits s).val)
    (hvalidI : prim.isvalid s i = .ok true)
    (hvalidLast : prim.isvalid s last = .ok true)
    (hnext : nextindOne (gFull prim) s last = .ok terminal) :
    ∃ out, gRange prim errs s i last = .ok out ∧ out.string = s ∧
      ViewIterates prim errs out (charsIn ((i,c) :: rest)) := by
  cases walk with
  | step bounds yield advances tail =>
    let out : Sub.SubString S := ⟨s, i - JuliaLean.base.strings.substring.one, terminal - i⟩
    have hcheck : (gParent prim errs).checkboundsRange s i last = .ok () := by
      simp [gParent, JuliaLean.base.strings.basic.checkbounds,
        JuliaLean.base.strings.basic.checkboundsRange, unitRangeOps, gFull, modelStringOps,
        show ¬ last.val < i.val by omega, show ¬ i.val < 1 by omega, hlast,
        bind, Except.bind, pure, Except.pure]
    have hcon : JuliaLean.base.strings.substring.typedSubString (gParent prim errs) s i last = .ok out := by
      simp [JuliaLean.base.strings.substring.typedSubString, show ¬ last.val < i.val by omega, hcheck,
        show (gParent prim errs).isvalid s i = .ok true from hvalidI,
        show (gParent prim errs).isvalid s last = .ok true from hvalidLast,
        show (gParent prim errs).nextind s last = .ok terminal from hnext,
        out, bind, Except.bind, pure, Except.pure]
    have hspan := typedSubStringViewSpan (gParent prim errs) s i last terminal out
      hile bounds.1 (by have ht := segmentStartBound prim s terminal tail; omega) hnext hcon
    refine ⟨out, ?_, rfl, ?_⟩
    · simpa [gRange, Sub.subStringInt, hcon] using hcon
    · apply viewIteratesSegment prim errs s out terminal i ((i,c) :: rest)
        (WalkSegment.step bounds yield advances tail) rfl
        (by have h := hspan.1; omega) hspan.2 hspan.1


private theorem lstripAnyLoopCorrect {S X R C CU CT FS BS : Type}
    (prim : StringOps S R C CU CT JlError) (errs : ViewErrors S JlError)
    (ops : StripOps X (Sub.SubString S) C FS BS JlError)
    (f : C → Jl Bool) (s : S) (x : X) (last : Index)
    {first : Option ((Index × C) × FS)} {pairs : List (Index × C)}
    (trace : PairTrace (ops.pairsNext x) first pairs)
    (slices : ∀ before suffix, pairs = before ++ suffix →
      StripResult prim errs s (.ok (charsIn suffix))
        (some (ops.substring x
          ((suffix.head?.map Prod.fst).getD (ops.addOne last)) last))) :
    StripResult prim errs s (leadingRun f (charsIn pairs))
      (lstrip.loop ops f x last first) := by
  induction trace with
  | nil =>
    have hloop : lstrip.loop ops f x last none =
        some (ops.substring x (ops.addOne last) last) := by
      rw [lstrip.loop, whileLoop]
      cases hh : ops.substring x (ops.addOne last) last <;>
        simp [hh, bind, Except.bind, pure, Except.pure]
    simpa [charsIn, leadingRun, hloop] using slices [] [] rfl
  | @cons p state current rest hnext tail ih =>
    rcases p with ⟨i,c⟩
    cases hf : f c with
    | error err =>
      simp only [charsIn, List.map_cons, leadingRun, hf, bind, Except.bind]
      change lstrip.loop ops f x last (some ((i,c),state)) = some (.error err)
      rw [lstrip.loop, whileLoop]
      simp [hf, bind, Except.bind, pure, Except.pure]
    | ok b =>
      cases b with
      | false =>
        have hloop : lstrip.loop ops f x last (some ((i,c),state)) =
            some (ops.substring x i last) := by
          rw [lstrip.loop, whileLoop]
          cases hh : ops.substring x i last <;>
            simp [hf, hh, bind, Except.bind, pure, Except.pure]
        simpa [charsIn, leadingRun, hf, hloop, bind, Except.bind, pure, Except.pure]
          using slices [] ((i,c) :: rest) rfl
      | true =>
        have hslices : ∀ before suffix, rest = before ++ suffix →
            StripResult prim errs s (.ok (charsIn suffix))
              (some (ops.substring x
                ((suffix.head?.map Prod.fst).getD (ops.addOne last)) last)) := by
          intro before suffix heq
          exact slices ((i,c) :: before) suffix (by simp [heq])
        have hloop : lstrip.loop ops f x last (some ((i,c),state)) =
            lstrip.loop ops f x last current := by
          rw [lstrip.loop, whileLoop]
          simp [hf, hnext, bind, Except.bind, pure, Except.pure, lstrip.loop]
        simpa [charsIn, leadingRun, hf, hloop, bind, Except.bind, pure, Except.pure]
          using ih hslices

private theorem walkSuffix {S R C CU CT E : Type}
    (prim : StringOps S R C CU CT E) (s : S) {i : Index}
    {pairs : List (Index × C)} (walk : Walk prim s i pairs)
    (before suffix : List (Index × C)) (hsplit : pairs = before ++ suffix) :
    ∃ j, Walk prim s j suffix := by
  induction before generalizing i pairs with
  | nil => exact ⟨i, by simpa [hsplit] using walk⟩
  | cons p before ih =>
    cases walk with
    | stop atEnd done => simp at hsplit
    | @step i j c rest bounds yield advances tail =>
      have ht : rest = before ++ suffix := (List.cons.inj hsplit).2
      exact ih tail ht

private theorem lawfulSuffixSlices {S R C CU CT : Type}
    (prim : StringOps S R C CU CT JlError) (errs : ViewErrors S JlError)
    (s : S) (layout : List (Index × C)) (law : Lawful prim s layout)
    (last : Index) (hlast : (gFull prim).lastindex s = .ok last)
    (hlast0 : 0 ≤ last.val) (hlastBound : last.val ≤ (prim.ncodeunits s).val)
    (hbound : ∀ p ∈ layout, p.1.val ≤ last.val)
    (hvalidLast : layout ≠ [] → prim.isvalid s last = .ok true)
    (hinvalid : ∀ k : Index, last.val < k.val → k.val ≤ (prim.ncodeunits s).val →
      prim.isvalid s k = .ok false) :
    ∀ before suffix, layout = before ++ suffix →
      StripResult prim errs s (.ok (charsIn suffix))
        (some ((stripOps prim errs).substring s
          ((suffix.head?.map Prod.fst).getD ((stripOps prim errs).addOne last)) last)) := by
  intro before suffix hsplit
  cases suffix with
  | nil =>
    have hmax : last.val + 1 ≤ IntTy.max .i64 := by
      have hb := walkEndBound prim s law.walk
      omega
    have hplus := indexAddOneVal last hlast0 hmax
    have hrange : gRange prim errs s (last + int 1) last =
        .ok (⟨s,int 0,int 0⟩ : Sub.SubString S) := by
      simp only [gRange, Sub.subStringInt, JuliaLean.base.strings.substring.typedSubString,
        if_pos (show last.val < (last + int 1).val by omega),
        bind, Except.bind, pure, Except.pure]
      rfl
    refine ⟨⟨s,int 0,int 0⟩, ?_, rfl, emptyViewIterates prim errs s⟩
    simpa [stripOps, stripOpsOf] using congrArg some hrange
  | cons p rest =>
    obtain ⟨i, hw⟩ := walkSuffix prim s law.walk before (p :: rest) hsplit
    cases hw with
    | @step i j c rest bounds yield advances tail =>
      have hmem : (i,c) ∈ layout := by rw [hsplit]; simp
      have hvalidI : prim.isvalid s i = .ok true := by
        have hany : layout.any (fun p => p.1.val == i.val) = true :=
          List.any_eq_true.mpr ⟨(i,c), hmem, by simp⟩
        simpa [hany] using law.isvalid i bounds.1 bounds.2
      have hlayoutNe : layout ≠ [] := by intro hh; simp [hh] at hmem
      let terminal : Index := int ((prim.ncodeunits s).val + 1)
      have hterminal : terminal.val = (prim.ncodeunits s).val + 1 := by
        apply indexOfIntVal
        have hb := walkEndBound prim s law.walk
        have hmin : IntTy.min .i64 ≤ 0 := by decide
        constructor <;> omega
      have hnext : nextindOne (gFull prim) s last = .ok terminal := by
        apply nextindOneTo prim s last terminal hlast0 hlastBound (by omega) (by omega)
        · intro ht
          omega
        · intro k hk hkt
          exact hinvalid k hk (by omega)
      obtain ⟨out, hrange, hparent, hview⟩ := rangeSegment prim errs s last terminal i c rest
        (walkSegmentFull prim s terminal hterminal (Walk.step bounds yield advances tail))
        (hbound (i,c) hmem) hlastBound hvalidI (hvalidLast hlayoutNe) hnext
      exact ⟨out, by simpa [stripOps, stripOpsOf] using congrArg some hrange, hparent, hview⟩

private theorem pairStateWalkTrace {S R C CU CT : Type}
    (prim : StringOps S R C CU CT JlError) (s : S) (i : Index)
    (pairs : List (Index × C)) (walk : Walk prim s i pairs) :
    ∃ first, pairsStep prim s (some i) = .ok first ∧
      PairTrace (fun state => pairsStep prim s (some state)) first pairs := by
  induction walk with
  | stop atEnd done =>
    refine ⟨none, ?_, PairTrace.nil⟩
    simp [pairsStep, JuliaLean.base.iterators.iterateStatePairs,
      JuliaLean.base.iterators.pairsStringModel, done, bind, Except.bind, pure, Except.pure]
  | @step i j c rest inBounds yield advances tail ih =>
    rcases ih with ⟨first, hfirst, htrace⟩
    refine ⟨some ((i, c), j), ?_, PairTrace.cons hfirst htrace⟩
    simp [pairsStep, JuliaLean.base.iterators.iterateStatePairs,
      JuliaLean.base.iterators.pairsStringModel, yield, bind, Except.bind, pure, Except.pure]

private theorem lawfulPairsTrace {S R C CU CT : Type}
    (prim : StringOps S R C CU CT JlError) (s : S)
    (pairs : List (Index × C)) (law : Lawful prim s pairs) :
    ∃ first, pairsStep prim s none = .ok first ∧
      PairTrace (fun state => pairsStep prim s (some state)) first pairs := by
  obtain ⟨first, hfirst, htrace⟩ := pairStateWalkTrace prim s (int 1) pairs law.walk
  refine ⟨first, ?_, htrace⟩
  have hstart : pairsStep prim s none = pairsStep prim s (some (int 1)) := by
    simp [pairsStep, JuliaLean.base.iterators.iterateStatePairs,
      JuliaLean.base.iterators.pairsStringModel, keysString, firstEachStringIndex,
      bind, Except.bind, pure, Except.pure]
  exact hstart.trans hfirst

theorem lstripMaximalRun_proven : LstripMaximalRun := by
  intro S R C CU CT prim errs f s layout law
  obtain ⟨last, hlast, hlast0, hlastBound, hnil, hbound, hvalid, hinvalid⟩ :=
    lawfulLastIndex prim s layout law
  obtain ⟨first,hfirst,htrace⟩ := lawfulPairsTrace prim s layout law
  have hslices := lawfulSuffixSlices prim errs s layout law last hlast hlast0 hlastBound
    hbound hvalid hinvalid
  have htrace' : PairTrace ((stripOps prim errs).pairsNext s) first layout := htrace
  have hh := lstripAnyLoopCorrect prim errs (stripOps prim errs) f s s last htrace' hslices
  simpa [lstrip, stripOps, stripOpsOf, hlast, hfirst] using hh

theorem lstripChars_proven : LstripChars := by
  intro S R C CU CT Q prim errs member set s layout law
  exact lstripMaximalRun_proven prim errs (fun c => member c set) s layout law

private inductive StripReverseSegment {C E : Type}
    (getindex : Index → Except E C) (prevind : Index → Except E Index) :
    Index → List (Index × C) → Index → Prop where
  | nil (i : Index) : StripReverseSegment getindex prevind i [] i
  | cons {i j stop : Index} {c : C} {rest : List (Index × C)}
      (positive : 1 ≤ i.val) (character : getindex i = .ok c)
      (previous : prevind i = .ok j)
      (tail : StripReverseSegment getindex prevind j rest stop) :
      StripReverseSegment getindex prevind i ((i,c) :: rest) stop

private theorem stripReverseSegmentAppend {C E : Type}
    (getindex : Index → Except E C) (prevind : Index → Except E Index)
    {i middle stop : Index} {left right : List (Index × C)}
    (hleft : StripReverseSegment getindex prevind i left middle)
    (hright : StripReverseSegment getindex prevind middle right stop) :
    StripReverseSegment getindex prevind i (left ++ right) stop := by
  induction hleft with
  | nil => simpa using hright
  | cons positive character previous tail ih =>
    simpa using StripReverseSegment.cons positive character previous (ih hright)

private theorem stripWalkReverseSegment {S R C CU CT E : Type}
    (prim : StringOps S R C CU CT E) (s : S) {i : Index} {pairs : List (Index × C)}
    (walk : Walk prim s i pairs) (layout : List (Index × C))
    (isvalid : ∀ k, 1 ≤ k.val ∧ k.val ≤ (prim.ncodeunits s).val →
      prim.isvalid s k = .ok (layout.any (fun p => p.1.val == k.val)))
    (listed : ∀ p, p ∈ pairs → p ∈ layout)
    (earlier : ∀ p, p ∈ layout → p ∈ pairs ∨ p.1.val ≤ i.val)
    (before : Index)
    (hbefore : pairs = [] ∨ previndOne (gFull prim) s i = .ok before) :
    ∃ start, (pairs = [] → start = before) ∧
      (∀ p, pairs.getLast? = some p → start = p.1) ∧
      StripReverseSegment (getindexString (gFull prim) s) (previndOne (gFull prim) s)
        start pairs.reverse before := by
  induction walk generalizing layout before with
  | @stop i atEnd done =>
    exact ⟨before, (fun _ => rfl), (by intro p hp; simp at hp), StripReverseSegment.nil before⟩
  | @step i j c rest hbounds hyield hadvance tail ih =>
    have hbefore' : previndOne (gFull prim) s i = .ok before := by
      rcases hbefore with hnil | hprev
      · simp at hnil
      · exact hprev
    have hvalidHead : prim.isvalid s i = .ok true := by
      have hmem : (i, c) ∈ layout := listed (i, c) (by simp)
      have hany : layout.any (fun p => p.1.val == i.val) = true :=
        List.any_eq_true.mpr ⟨(i, c), hmem, by simp⟩
      have h := isvalid i ⟨hbounds.1, hbounds.2⟩
      rw [hany] at h
      exact h
    have hlistedTail : ∀ p, p ∈ rest → p ∈ layout := by
      intro p hp
      exact listed p (List.mem_cons_of_mem (i, c) hp)
    have hearlierTail : ∀ p, p ∈ layout → p ∈ rest ∨ p.1.val ≤ j.val := by
      intro p hp
      rcases earlier p hp with hcur | hlt
      · rcases List.mem_cons.mp hcur with hhead | hrest
        · have hpIndex : p.1.val = i.val := by cases hhead; rfl
          exact Or.inr (by rw [hpIndex]; omega)
        · exact Or.inl hrest
      · exact Or.inr (by omega)
    have hnextBound : j.val ≤ (prim.ncodeunits s).val + 1 :=
      walkStartBound prim s tail
    have hprevTail : rest = [] ∨ previndOne (gFull prim) s j = .ok i := by
      cases rest with
      | nil => exact Or.inl rfl
      | cons p tailRest =>
        have hnoBetween : ∀ k : Index, i.val < k.val ∧ k.val < j.val →
            prim.isvalid s k = .ok false := by
          intro k ⟨hik, hkj⟩
          have hany : layout.any (fun q => q.1.val == k.val) = false := by
            cases hscan : layout.any (fun q => q.1.val == k.val) with
            | false => rfl
            | true =>
              obtain ⟨q, hq, hqk⟩ := List.any_eq_true.mp hscan
              have hqEq : q.1.val = k.val := by
                simpa using (beq_iff_eq.mp hqk)
              rcases earlier q hq with hcur | hlt
              · rcases List.mem_cons.mp hcur with hhead | hrest
                · have hqIndex : q.1.val = i.val := by cases hhead; rfl
                  rw [hqIndex] at hqEq
                  omega
                · have hqLower := walkIndicesAtLeast prim s j (Int.le_refl _) tail q hrest
                  rw [hqEq] at hqLower
                  omega
              · rw [hqEq] at hlt
                omega
          have h := isvalid k ⟨by omega, by omega⟩
          rw [hany] at h
          exact h
        have hmax := walkEndBound prim s (Walk.step hbounds hyield hadvance tail)
        have hprev := JuliaLean.Proofs.base.strings.basic.prevind_proven.2.2.2.2.1
          S R C CU CT E prim (fun x => toString x.val) s j i hmax
          ⟨hbounds.1, hadvance, hnextBound⟩ hvalidHead hnoBetween
        exact Or.inr hprev.1
    obtain ⟨start, hnil, hlast, htail⟩ :=
      ih layout isvalid hlistedTail hearlierTail i hprevTail
    have hget : getindexString (gFull prim) s i = .ok c := by
      have hcheck : (gFull prim).checkbounds s i = .ok () := by
        simp [gFull, modelStringOps, JuliaLean.base.strings.basic.checkbounds,
          JuliaLean.base.strings.basic.checkboundsScalar, hbounds.1, hbounds.2,
          bind, Except.bind, pure, Except.pure]
      have hvalidFull : (gFull prim).isvalid s i = .ok true := by
        change prim.isvalid s i = .ok true
        exact hvalidHead
      have hiterFull : (gFull prim).iterateAt s i = .ok (some (c, j)) := by
        change prim.iterateAt s i = .ok (some (c, j))
        exact hyield
      simp [getindexString, getindexInteger, hcheck, hvalidFull, hiterFull,
        bind, Except.bind, pure, Except.pure]
    have hone : StripReverseSegment (getindexString (gFull prim) s)
        (previndOne (gFull prim) s) i [(i,c)] before := by
      simpa using StripReverseSegment.cons hbounds.1 hget hbefore' (StripReverseSegment.nil before)
    have hsegment :
        StripReverseSegment (getindexString (gFull prim) s) (previndOne (gFull prim) s)
          start (rest.reverse ++ [(i,c)]) before :=
      stripReverseSegmentAppend _ _ htail hone
    refine ⟨start, ?_, ?_, ?_⟩
    · intro hnil'
      simp at hnil'
    · intro p hp
      rw [getLastCons] at hp
      by_cases hnil' : rest = []
      · simp [hnil'] at hp
        subst p
        exact hnil hnil'
      · simp [hnil'] at hp
        exact hlast p hp
    · simpa [charsIn, List.reverse_cons] using hsegment


private theorem stripReverseSegmentTrace {S R C CU CT : Type}
    (prim : StringOps S R C CU CT JlError) (s : S)
    {start stop : Index} {pairs : List (Index × C)}
    (segment : StripReverseSegment (getindexString (gFull prim) s)
      (previndOne (gFull prim) s) start pairs stop) (hstop : stop.val < 1) :
    ∃ first, revPairsStep prim s (some start) = .ok first ∧
      PairTrace (fun state => revPairsStep prim s (some state)) first pairs := by
  induction segment with
  | nil i =>
    refine ⟨none, ?_, PairTrace.nil⟩
    have hslt : JuliaLean.base.int.slt_int i (firstindexString s) = true := by
      rw [JuliaLean.Proofs.base.int.slt_int_eq rfl]
      simp [firstindexString, hstop]
    simp [revPairsStep, JuliaLean.base.iterators.iterateReverseIterableStatePairs,
      gRevIterate, reverseOf, reverseIterateString, hslt,
      bind, Except.bind, pure, Except.pure]
  | @cons i j stop c rest positive character previous tail ih =>
    obtain ⟨first,hfirst,htrace⟩ := ih hstop
    refine ⟨some ((i,c),j), ?_, PairTrace.cons hfirst htrace⟩
    have hslt : JuliaLean.base.int.slt_int i (firstindexString s) = false := by
      rw [JuliaLean.Proofs.base.int.slt_int_eq rfl]
      have hn : ¬ i.val < 1 := by omega
      simp [firstindexString, hn]
    simp [revPairsStep, JuliaLean.base.iterators.iterateReverseIterableStatePairs,
      gRevIterate, reverseOf, reverseIterateString, hslt, character, previous,
      bind, Except.bind, pure, Except.pure]

private theorem lawfulReversePairsTrace {S R C CU CT : Type}
    (prim : StringOps S R C CU CT JlError) (s : S) (layout : List (Index × C))
    (law : Lawful prim s layout) :
    ∃ first, revPairsStep prim s none = .ok first ∧
      PairTrace (fun state => revPairsStep prim s (some state)) first layout.reverse := by
  obtain ⟨last,hlast,hlast0,hlastBound,hnil,hbound,hvalid,hinvalid⟩ :=
    lawfulLastIndex prim s layout law
  have hncNonneg : 0 ≤ (prim.ncodeunits s).val := by omega
  have hprev : previndOne (gFull prim) s (int 1) = .ok (int 0) := by
    have h := JuliaLean.Proofs.base.strings.basic.prevind_proven.2.2.2.1
      S R C CU CT JlError prim (fun x => toString x.val) s (int 1)
      hncNonneg (walkEndBound prim s law.walk) (by decide)
    simpa [gFull, modelStringOps] using h.2
  have hvalid' : ∀ k, 1 ≤ k.val ∧ k.val ≤ (prim.ncodeunits s).val →
      prim.isvalid s k = .ok (layout.any (fun p => p.1.val == k.val)) := by
    intro k hk
    exact law.isvalid k hk.1 hk.2
  obtain ⟨start,hstartNil,hstartLast,hsegment⟩ := stripWalkReverseSegment prim s law.walk
    layout hvalid' (fun p hp => hp) (fun p hp => Or.inl hp) (int 0) (Or.inr hprev)
  have hstartEq : start = last := by
    cases layout with
    | nil =>
      have h1 := hstartNil rfl
      have h2 := hnil rfl
      apply Subtype.ext
      simp only [h1]
      change (int 0).val = last.val
      simpa using h2.symm
    | cons p rest =>
      obtain ⟨q,hq⟩ := getLastSome p rest
      have hs := hstartLast q hq
      have hv := hvalid (by simp)
      have hlo : 1 ≤ last.val := by
        have hf := walkLastFacts prim s law.walk q hq
        have hmem := getLastMem hq
        have hb := hbound q hmem
        omega
      have ha := law.isvalid last hlo hlastBound
      rw [hv] at ha
      have hany : ((p :: rest).any (fun p => p.1.val == last.val)) = true := by
        exact (Except.ok.inj ha).symm
      obtain ⟨r,hr,hrval⟩ := List.any_eq_true.mp hany
      have hrv : r.1.val = last.val := by simpa using beq_iff_eq.mp hrval
      have hf := walkLastFacts prim s law.walk q hq
      have hlastLe : last.val ≤ q.1.val := by have hh := hf.2.1 r hr; omega
      have hqLe := hbound q (getLastMem hq)
      apply Subtype.ext
      rw [hs]
      omega
  obtain ⟨first,hfirst,htrace⟩ := stripReverseSegmentTrace prim s hsegment (by decide)
  refine ⟨first, ?_, htrace⟩
  have hstartCall : revPairsStep prim s none = revPairsStep prim s (some start) := by
    simp [revPairsStep, JuliaLean.base.iterators.iterateReverseIterableStatePairs,
      lastEachStringIndex, keysString, hlast, hstartEq, bind, Except.bind, pure, Except.pure]
  exact hstartCall.trans hfirst


private theorem walkSplitEarlier {S R C CU CT E : Type}
    (prim : StringOps S R C CU CT E) (s : S) {start : Index}
    {layout : List (Index × C)} (walk : Walk prim s start layout)
    (before : List (Index × C)) (i : Index) (c : C) (rest : List (Index × C))
    (hsplit : layout = before ++ (i,c) :: rest) :
    ∀ p ∈ before, p.1.val < i.val := by
  induction before generalizing start layout with
  | nil => simp
  | cons p before ih =>
    cases walk with
    | stop atEnd done => simp at hsplit
    | @step start next d tail bounds yield advances wtail =>
      have hp : (start,d) = p := (List.cons.inj hsplit).1
      have ht : tail = before ++ (i,c) :: rest := (List.cons.inj hsplit).2
      have hmem : (i,c) ∈ tail := by rw [ht]; simp
      have hlo : next.val ≤ i.val := walkIndicesAtLeast prim s next (Int.le_refl _) wtail (i,c) hmem
      intro q hq
      rcases List.mem_cons.mp hq with hq | hq
      · subst q
        have hpv : p.1.val = start.val := congrArg (fun p : Index × C => p.1.val) hp.symm
        omega
      · exact ih wtail ht q hq

private theorem lawfulNextAt {S R C CU CT : Type}
    (prim : StringOps S R C CU CT JlError) (s : S) (layout : List (Index × C))
    (law : Lawful prim s layout) (before : List (Index × C))
    (i : Index) (c : C) (rest : List (Index × C))
    (hsplit : layout = before ++ (i,c) :: rest) :
    ∃ next, nextindOne (gFull prim) s i = .ok next ∧
      Walk prim s next rest ∧ i.val < next.val := by
  obtain ⟨start,hwalk⟩ := walkSuffix prim s law.walk before ((i,c) :: rest) hsplit
  cases hwalk with
  | @step i next c rest bounds yield advances tail =>
    refine ⟨next, ?_, tail, advances⟩
    have hnextBound := walkStartBound prim s tail
    apply nextindOneTo prim s i next (by omega) bounds.2 advances hnextBound
    · intro hn
      cases tail with
      | stop atEnd done => omega
      | @step next j d tail b y a wt =>
        have hmem : (next,d) ∈ layout := by rw [hsplit]; simp
        have ha : layout.any (fun p => p.1.val == next.val) = true :=
          List.any_eq_true.mpr ⟨(next,d),hmem,by simp⟩
        simpa [ha] using law.isvalid next b.1 b.2
    · intro k hik hkn
      have ha : layout.any (fun p => p.1.val == k.val) = false := by
        cases hh : layout.any (fun p => p.1.val == k.val) with
        | false => rfl
        | true =>
          obtain ⟨q,hq,hqk⟩ := List.any_eq_true.mp hh
          have hqval : q.1.val = k.val := by simpa using beq_iff_eq.mp hqk
          rw [hsplit] at hq
          rcases List.mem_append.mp hq with hbefore | hcur
          · have hlt := walkSplitEarlier prim s law.walk before i c rest hsplit q hbefore
            omega
          · rcases List.mem_cons.mp hcur with hhead | hrest
            · have hidx : q.1.val = i.val := congrArg (fun p : Index × C => p.1.val) hhead
              omega
            · have hge := walkIndicesAtLeast prim s next (Int.le_refl _) tail q hrest
              omega
      simpa [ha] using law.isvalid k (by omega) (by omega)

theorem rangePrefix {S R C CU CT : Type}
    (prim : StringOps S R C CU CT JlError) (errs : ViewErrors S JlError)
    (s : S) (layout : List (Index × C)) (law : Lawful prim s layout)
    (before : List (Index × C)) (i : Index) (c : C) (after : List (Index × C))
    (hsplit : layout = before ++ (i,c) :: after) :
    ∃ out, gRange prim errs s (int 1) i = .ok out ∧ out.string = s ∧
      ViewIterates prim errs out (charsIn (before ++ [(i,c)])) := by
  obtain ⟨next,hnext,htail,hadvance⟩ := lawfulNextAt prim s layout law before i c after hsplit
  have hsplit' : layout = (before ++ [(i,c)]) ++ after := by simpa using hsplit
  obtain ⟨terminal,hsegment,he⟩ := walkSegmentFromPrefix prim s law.walk
    (before ++ [(i,c)]) after hsplit'
  have hterminal : terminal = next := by
    apply Subtype.ext
    cases htail with
    | stop atEnd done => simpa [segmentEnd] using he.trans atEnd.symm
    | step bounds yield advances tail => simpa [segmentEnd] using he
  subst terminal
  have hmem : (i,c) ∈ layout := by rw [hsplit]; simp
  obtain ⟨start,hw⟩ := walkSuffix prim s law.walk before ((i,c) :: after) hsplit
  cases hw with
  | @step i j c after bounds yield advances tail =>
    have hone : (int 1).val = 1 := by decide
    have hv : prim.isvalid s i = .ok true := by
      have ha : layout.any (fun p => p.1.val == i.val) = true :=
        List.any_eq_true.mpr ⟨(i,c),hmem,by simp⟩
      simpa [ha] using law.isvalid i bounds.1 bounds.2
    have hvfirst : prim.isvalid s (int 1) = .ok true := by
      cases law.walk with
      | stop atEnd done => simp at hsplit
      | step b y a wt =>
        simpa using law.isvalid (int 1) b.1 b.2
    let out : Sub.SubString S := ⟨s,int 1 - JuliaLean.base.strings.substring.one,next - int 1⟩
    have hcheck : (gParent prim errs).checkboundsRange s (int 1) i = .ok () := by
      simp [gParent, JuliaLean.base.strings.basic.checkbounds,
        JuliaLean.base.strings.basic.checkboundsRange, unitRangeOps,gFull,modelStringOps,
        hone,show ¬ i.val < 1 by omega,bounds.2,bind,Except.bind,pure,Except.pure]
    have hcon : JuliaLean.base.strings.substring.typedSubString (gParent prim errs)
        s (int 1) i = .ok out := by
      simp only [JuliaLean.base.strings.substring.typedSubString,
        if_neg (show ¬ i.val < (int 1).val by omega)]
      simp [hcheck,
        show (gParent prim errs).isvalid s (int 1) = .ok true from hvfirst,
        show (gParent prim errs).isvalid s i = .ok true from hv,
        show (gParent prim errs).nextind s i = .ok next from hnext,
        out,bind,Except.bind,pure,Except.pure]
    have hspan := typedSubStringViewSpan (gParent prim errs) s (int 1) i next out
      (by omega) (by omega) (by omega) hnext hcon
    refine ⟨out,?_,rfl,?_⟩
    · simpa [gRange,Sub.subStringInt,hcon] using hcon
    · exact viewIteratesSegment prim errs s out next (int 1) (before ++ [(i,c)])
        hsegment rfl (by have hh:=hspan.1; omega) hspan.2 hspan.1


private theorem rstripLoopCorrect {S R C CU CT FS BS : Type}
    (prim : StringOps S R C CU CT JlError) (errs : ViewErrors S JlError)
    (ops : StripOps S (Sub.SubString S) C FS BS JlError)
    (f : C → Jl Bool) (s : S)
    {first : Option ((Index × C) × BS)} {pairs : List (Index × C)}
    (trace : PairTrace (ops.reversePairsNext s) first pairs)
    (slices : ∀ before suffix, pairs = before ++ suffix →
      StripResult prim errs s (.ok (charsIn suffix).reverse)
        (some (ops.substring s (int 1)
          ((suffix.head?.map Prod.fst).getD (int 0))))) :
    StripResult prim errs s (do return (← leadingRun f (charsIn pairs)).reverse)
      (rstrip.loop ops f s first) := by
  induction trace with
  | nil =>
    have hloop : rstrip.loop ops f s none =
        some (ops.substring s (int 1) (int 0)) := by
      rw [rstrip.loop, whileLoop]
      cases hh : ops.substring s (int 1) (int 0) <;>
        simp [hh, bind, Except.bind, pure, Except.pure]
    simpa [charsIn, leadingRun, hloop] using slices [] [] rfl
  | @cons p state current rest hnext tail ih =>
    rcases p with ⟨i,c⟩
    cases hf : f c with
    | error err =>
      simp only [charsIn, List.map_cons, leadingRun, hf, bind, Except.bind]
      change rstrip.loop ops f s (some ((i,c),state)) = some (.error err)
      rw [rstrip.loop, whileLoop]
      simp [hf, bind, Except.bind, pure, Except.pure]
    | ok b =>
      cases b with
      | false =>
        have hloop : rstrip.loop ops f s (some ((i,c),state)) =
            some (ops.substring s (int 1) i) := by
          rw [rstrip.loop, whileLoop]
          cases hh : ops.substring s (int 1) i <;>
            simp [hf, hh, bind, Except.bind, pure, Except.pure]
        simpa [charsIn, leadingRun, hf, hloop, bind, Except.bind, pure, Except.pure]
          using slices [] ((i,c) :: rest) rfl
      | true =>
        have hslices : ∀ before suffix, rest = before ++ suffix →
            StripResult prim errs s (.ok (charsIn suffix).reverse)
              (some (ops.substring s (int 1)
                ((suffix.head?.map Prod.fst).getD (int 0)))) := by
          intro before suffix heq
          exact slices ((i,c) :: before) suffix (by simp [heq])
        have hloop : rstrip.loop ops f s (some ((i,c),state)) =
            rstrip.loop ops f s current := by
          rw [rstrip.loop, whileLoop]
          simp [hf, hnext, bind, Except.bind, pure, Except.pure, rstrip.loop]
        simpa [charsIn, leadingRun, hf, hloop, bind, Except.bind, pure, Except.pure]
          using ih hslices


private theorem lawfulPrefixSlices {S R C CU CT : Type}
    (prim : StringOps S R C CU CT JlError) (errs : ViewErrors S JlError)
    (s : S) (layout : List (Index × C)) (law : Lawful prim s layout) :
    ∀ before suffix, layout.reverse = before ++ suffix →
      StripResult prim errs s (.ok (charsIn suffix).reverse)
        (some ((stripOps prim errs).substring s (int 1)
          ((suffix.head?.map Prod.fst).getD (int 0)))) := by
  intro before suffix hsplit
  cases suffix with
  | nil =>
    have hrange : gRange prim errs s (int 1) (int 0) =
        .ok (⟨s,int 0,int 0⟩ : Sub.SubString S) := by
      simp only [gRange,Sub.subStringInt,JuliaLean.base.strings.substring.typedSubString,
        if_pos (show (int 0).val < (int 1).val by decide),
        bind,Except.bind,pure,Except.pure]
      rfl
    refine ⟨⟨s,int 0,int 0⟩,?_,rfl,emptyViewIterates prim errs s⟩
    simpa [stripOps,stripOpsOf] using congrArg some hrange
  | cons p rest =>
    have hsplit' : layout = rest.reverse ++ p :: before.reverse := by
      simpa [List.reverse_append,List.reverse_cons,List.append_assoc] using
        congrArg List.reverse hsplit
    obtain ⟨out,hrange,hparent,hview⟩ := rangePrefix prim errs s layout law
      rest.reverse p.1 p.2 before.reverse hsplit'
    refine ⟨out,?_,hparent,?_⟩
    · simpa [stripOps,stripOpsOf] using congrArg some hrange
    · simpa [charsIn,List.map_reverse,List.reverse_cons] using hview

theorem rstripMaximalRun_proven : RstripMaximalRun := by
  intro S R C CU CT prim errs f s layout law
  obtain ⟨first,hfirst,htrace⟩ := lawfulReversePairsTrace prim s layout law
  have htrace' : PairTrace ((stripOps prim errs).reversePairsNext s) first layout.reverse := htrace
  have hh := rstripLoopCorrect prim errs (stripOps prim errs) f s htrace'
    (lawfulPrefixSlices prim errs s layout law)
  simpa [rstrip,stripOps,stripOpsOf,hfirst,trailingRun,charsIn,List.map_reverse] using hh

theorem rstripChars_proven : RstripChars := by
  intro S R C CU CT Q prim errs member set s layout law
  exact rstripMaximalRun_proven prim errs (fun c => member c set) s layout law


theorem lawfulAdjacentPrev {S R C CU CT : Type}
    (prim : StringOps S R C CU CT JlError) (s : S) (layout : List (Index × C))
    (law : Lawful prim s layout) (before : List (Index × C))
    (q : Index) (d : C) (p : Index) (c : C) (after : List (Index × C))
    (hsplit : layout = before ++ (q,d) :: (p,c) :: after) :
    previndOne (gFull prim) s p = .ok q := by
  obtain ⟨start,hw⟩ := walkSuffix prim s law.walk before ((q,d) :: (p,c) :: after) hsplit
  cases hw with
  | @step q p d rest bq yq aq wtail =>
    cases wtail with
    | @step p next c after bp yp ap wafter =>
      have hvalidQ : prim.isvalid s q = .ok true := by
        have hm : (q,d) ∈ layout := by rw [hsplit]; simp
        have ha : layout.any (fun a => a.1.val == q.val) = true :=
          List.any_eq_true.mpr ⟨(q,d),hm,by simp⟩
        simpa [ha] using law.isvalid q bq.1 bq.2
      have hinv : ∀ k : Index, q.val < k.val ∧ k.val < p.val →
          prim.isvalid s k = .ok false := by
        intro k hk
        have ha : layout.any (fun a => a.1.val == k.val) = false := by
          cases hh : layout.any (fun a => a.1.val == k.val) with
          | false => rfl
          | true =>
            obtain ⟨a,ha,hak⟩ := List.any_eq_true.mp hh
            have hav : a.1.val = k.val := by simpa using beq_iff_eq.mp hak
            rw [hsplit] at ha
            rcases List.mem_append.mp ha with hbefore | hrest
            · have hlt := walkSplitEarlier prim s law.walk before q d
                ((p,c)::after) hsplit a hbefore
              omega
            · rcases List.mem_cons.mp hrest with hhead | htail
              · have hi : a.1.val = q.val := congrArg (fun a : Index × C => a.1.val) hhead
                omega
              · have hge : p.val ≤ a.1.val := walkIndicesAtLeast prim s p (Int.le_refl _)
                  (Walk.step bp yp ap wafter) a htail
                omega
        simpa [ha] using law.isvalid k (by omega) (by omega)
      have hh := JuliaLean.Proofs.base.strings.basic.prevind_proven.2.2.2.2.1
        S R C CU CT JlError prim (fun x => toString x.val) s p q
        (walkEndBound prim s law.walk) ⟨bq.1,aq,by omega⟩ hvalidQ hinv
      exact hh.1


private theorem zeroOffsetAdd {offset i : Index} (hz : offset.val = 0) : offset + i = i := by
  apply Subtype.ext
  change wrapInt .i64 (offset.val + i.val) = i.val
  rw [hz, Int.zero_add]
  exact wrapInt_of_inRange .i64 i.val i.property

private theorem localIndexZero {S : Type} (v : Sub.SubString S) (i : Index)
    (hz : v.offset.val = 0) : localIndex v i = i := by
  apply Subtype.ext
  change wrapInt .i64 (i.val - v.offset.val) = i.val
  rw [hz,Int.sub_zero]
  exact wrapInt_of_inRange .i64 i.val i.property

private theorem prefixViewWalk {S R C CU CT : Type}
    (prim : StringOps S R C CU CT JlError) (errs : ViewErrors S JlError)
    (s : S) (v : Sub.SubString S) (terminal : Index)
    (hparent : v.string = s) (hzero : v.offset.val = 0)
    (hspan : v.ncodeunits.val + 1 = terminal.val)
    {i : Index} {pairs : List (Index × C)}
    (walk : WalkSegment prim s terminal i pairs) (hi : 1 ≤ i.val) :
    Walk (gSubPrim prim errs) v i pairs := by
  induction walk with
  | @stop i atEnd =>
    apply Walk.stop (by simpa [gSubPrim] using atEnd.trans hspan.symm)
    have hmax : v.ncodeunits.val + 1 ≤ IntTy.max .i64 := by
      have ht := terminal.property.2
      omega
    have hlen : 0 ≤ v.ncodeunits.val := by omega
    have hval : (v.ncodeunits + JuliaLean.base.strings.substring.one).val =
        v.ncodeunits.val + 1 := by
      change (v.ncodeunits + int 1).val = v.ncodeunits.val + 1
      exact indexAddOneVal v.ncodeunits hlen hmax
    have heq : i = v.ncodeunits + JuliaLean.base.strings.substring.one :=
      Subtype.ext (by omega)
    change viewIterateAt prim errs v i = .ok none
    rw [heq]
    simp [viewIterateAt,Sub.iterateSubString,JuliaLean.Proofs.base.int.eq_int_eq]
  | @step i j c rest bounds yield advances tail ih =>
    have hj := segmentStartBound prim s terminal tail
    have hit : i.val < terminal.val := by omega
    have hstep := viewIterateAtSegmentStep prim errs s v terminal i j c
      hparent (by omega) (by omega) (by omega) hit advances bounds hj yield
    rw [localIndexZero v i hzero,localIndexZero v j hzero] at hstep
    exact Walk.step ⟨hi,by change i.val ≤ v.ncodeunits.val; omega⟩ hstep advances (ih (by omega))

private theorem lawfulPrefixView {S R C CU CT : Type}
    (prim : StringOps S R C CU CT JlError) (errs : ViewErrors S JlError)
    (s : S) (layout retained after : List (Index × C)) (law : Lawful prim s layout)
    (terminal : Index) (v : Sub.SubString S)
    (hsplit : layout = retained ++ after)
    (segment : WalkSegment prim s terminal (int 1) retained)
    (tail : Walk prim s terminal after)
    (hparent : v.string = s) (hzero : v.offset.val = 0)
    (hspan : v.ncodeunits.val + 1 = terminal.val) :
    Lawful (gSubPrim prim errs) v retained := by
  refine ⟨Eq.trans rfl rfl, prefixViewWalk prim errs s v terminal hparent hzero hspan
    segment (by decide), ?_⟩
  intro k hk1 hkn
  change k.val ≤ v.ncodeunits.val at hkn
  have hbound := walkStartBound prim s tail
  have hkOrig : k.val ≤ (prim.ncodeunits s).val := by omega
  have hafter : after.any (fun p => p.1.val == k.val) = false := by
    cases ha : after.any (fun p => p.1.val == k.val) with
    | false => rfl
    | true =>
      obtain ⟨p,hp,hpk⟩ := List.any_eq_true.mp ha
      have hpLower := walkIndicesAtLeast prim s terminal (Int.le_refl _) tail p hp
      have hpeq : p.1.val = k.val := by simpa using beq_iff_eq.mp hpk
      omega
  have hvalid : prim.isvalid s k = .ok (retained.any (fun p => p.1.val == k.val)) := by
    simpa [hsplit,List.any_append,hafter] using law.isvalid k hk1 hkOrig
  have hadd : v.offset + k = k := zeroOffsetAdd hzero
  simp [gSubPrim,Sub.isvalidSubStringAt,viewInBounds,
    JuliaLean.base.strings.basic.checkboundsScalar,hk1,hkn,viewParentIndex,hadd,hparent,hvalid,
    bind,Except.bind,pure,Except.pure]

private theorem nestedZeroRange {S R C CU CT : Type}
    (prim : StringOps S R C CU CT JlError) (errs : ViewErrors S JlError)
    (s : S) (v : Sub.SubString S) (i j : Index)
    (hparent : v.string = s) (hzero : v.offset.val = 0)
    (hbounds : i.val ≤ j.val → 1 ≤ i.val ∧ j.val ≤ v.ncodeunits.val) :
    gNested prim errs v i j = gRange prim errs s i j := by
  have hi : v.offset + i = i := zeroOffsetAdd hzero
  have hj : v.offset + j = j := zeroOffsetAdd hzero
  by_cases hij : i.val ≤ j.val
  · have hb := hbounds hij
    have hcheck : (gParent prim errs).checkboundsViewRange v i j = .ok () := by
      simp [gParent,JuliaLean.base.strings.basic.checkbounds,
        JuliaLean.base.strings.basic.checkboundsRange,unitRangeOps,gFull,modelStringOps,gSubPrim,
        show ¬ j.val < i.val by omega,show ¬ i.val < 1 by omega,hb.2,
        bind,Except.bind,pure,Except.pure]
    simp [gNested,Sub.subStringNested,hij,hcheck,hparent,hi,hj,gRange,
      bind,Except.bind,pure,Except.pure]
  · simp [gNested,Sub.subStringNested,hij,hparent,hi,hj,gRange]


private theorem rstripSelectedRange {S R C FS BS E : Type}
    (ops : StripOps S R C FS BS E) (f : C → Except E Bool) (s : S)
    {first : Option ((Index × C) × BS)} {pairs : List (Index × C)}
    (trace : PairTrace (ops.reversePairsNext s) first pairs) :
    ∀ out, rstrip.loop ops f s first = some (.ok out) →
      ∃ before suffix, pairs = before ++ suffix ∧
        ops.substring s (int 1) ((suffix.head?.map Prod.fst).getD (int 0)) = .ok out := by
  induction trace with
  | nil =>
    intro out hrun
    refine ⟨[],[],rfl,?_⟩
    rw [rstrip.loop,whileLoop] at hrun
    cases hh : ops.substring s (int 1) (int 0) <;>
      simp [hh,bind,Except.bind,pure,Except.pure] at hrun
    next value => cases hrun; exact hh
  | @cons p state current rest hnext tail ih =>
    rcases p with ⟨i,c⟩
    intro out hrun
    cases hf : f c with
    | error err =>
      rw [rstrip.loop,whileLoop] at hrun
      simp [hf,bind,Except.bind,pure,Except.pure] at hrun
    | ok b =>
      cases b with
      | false =>
        refine ⟨[],(i,c)::rest,rfl,?_⟩
        rw [rstrip.loop,whileLoop] at hrun
        cases hh : ops.substring s (int 1) i <;>
          simp [hf,hh,bind,Except.bind,pure,Except.pure] at hrun
        next value => cases hrun; exact hh
      | true =>
        have hloop : rstrip.loop ops f s (some ((i,c),state)) =
            rstrip.loop ops f s current := by
          rw [rstrip.loop,whileLoop]
          simp [hf,hnext,bind,Except.bind,pure,Except.pure,rstrip.loop]
        rw [hloop] at hrun
        obtain ⟨before,suffix,heq,hrange⟩ := ih out hrun
        exact ⟨(i,c)::before,suffix,by simp [heq],hrange⟩

private theorem walkStartValue {S R C CU CT E : Type}
    (prim : StringOps S R C CU CT E) (s : S)
    {start : Index} {pairs : List (Index × C)} (walk : Walk prim s start pairs) :
    start.val = segmentEnd (prim.ncodeunits s) pairs := by
  cases walk with
  | stop atEnd done => exact atEnd
  | step bounds yield advances tail => rfl

private theorem walkPairYields {S R C CU CT E : Type} (prim : StringOps S R C CU CT E)
    (s : S) {start : Index} {layout : List (Index × C)}
    (walk : Walk prim s start layout) :
    ∀ pair ∈ layout, ∃ next, prim.iterateAt s pair.1 = .ok (some (pair.2, next)) := by
  induction walk with
  | stop atEnd done => intro pair hmem; simp at hmem
  | @step i j c rest bounds yield advances tail ih =>
    intro pair hmem
    rcases List.mem_cons.mp hmem with hhead | htail
    · have hpair : pair = (i, c) := hhead
      subst pair
      exact ⟨j, yield⟩
    · exact ih pair htail

private theorem walkPairIndexBounds {S R C CU CT E : Type} (prim : StringOps S R C CU CT E)
    (s : S) {start : Index} {layout : List (Index × C)}
    (walk : Walk prim s start layout) :
    ∀ pair ∈ layout, 1 ≤ pair.1.val ∧ pair.1.val ≤ (prim.ncodeunits s).val := by
  induction walk with
  | stop atEnd done => intro pair hmem; simp at hmem
  | @step i j c rest bounds yield advances tail ih =>
    intro pair hmem
    rcases List.mem_cons.mp hmem with hhead | htail
    · have hpair : pair = (i, c) := hhead
      subst pair
      exact bounds
    · exact ih pair htail

theorem lawfulPairIndexBounds {S R C CU CT E : Type}
    (prim : StringOps S R C CU CT E) (s : S) (layout : List (Index × C))
    (law : Lawful prim s layout) (pair : Index × C) (hmem : pair ∈ layout) :
    1 ≤ pair.1.val ∧ pair.1.val ≤ (prim.ncodeunits s).val :=
  walkPairIndexBounds prim s law.walk pair hmem

theorem lawfulPairGetindex {S R C CU CT E : Type}
    (prim : StringOps S R C CU CT E) (s : S) (layout : List (Index × C))
    (law : Lawful prim s layout) (i : Index) (c : C) (hmem : (i, c) ∈ layout) :
    getindexString (gFull prim) s i = .ok c := by
  obtain ⟨next, hiter⟩ := walkPairYields prim s law.walk (i, c) hmem
  have hbounds := lawfulPairIndexBounds prim s layout law (i, c) hmem
  have hany : layout.any (fun p => p.1.val == i.val) = true :=
    List.any_eq_true.mpr ⟨(i, c), hmem, by simp⟩
  have hvalid : prim.isvalid s i = .ok true := by
    have h := law.isvalid i hbounds.1 hbounds.2
    simpa [hany] using h
  have hcheck : (gFull prim).checkbounds s i = .ok () := by
    simp [gFull, modelStringOps, JuliaLean.base.strings.basic.checkbounds,
      JuliaLean.base.strings.basic.checkboundsScalar, hbounds.1, hbounds.2,
      bind, Except.bind, pure, Except.pure]
  have hvalidFull : (gFull prim).isvalid s i = .ok true := by
    simpa [gFull, modelStringOps] using hvalid
  have hiterFull : (gFull prim).iterateAt s i =
      .ok (some (c, next)) := by
    simpa [gFull, modelStringOps] using hiter
  simp [getindexString, getindexInteger, hcheck, hvalidFull, hiterFull,
    bind, Except.bind, pure, Except.pure]

theorem lawfulEndIndexPositive {S R C CU CT E : Type}
    (prim : StringOps S R C CU CT E) (s : S) (layout : List (Index × C))
    (law : Lawful prim s layout) (e1 : Index)
    (hend : (do
      let last ← (gFull prim).lastindex s
      (gFull prim).nextind s last (int 1)) = .ok e1) :
    1 ≤ e1.val := by
  obtain ⟨last, hlast, hlast0, hlastBound, hnil, hbound, hvalid, hinvalid⟩ :=
    lawfulLastIndex prim s layout law
  have hncNonnegative : 0 ≤ (prim.ncodeunits s).val := by
    have hstart := walkStartBound prim s law.walk
    have hone : (int 1).val = 1 := by decide
    omega
  have hncMax : (prim.ncodeunits s).val + 1 ≤ IntTy.max .i64 :=
    walkEndBound prim s law.walk
  let target : Index := prim.ncodeunits s + int 1
  have htargetVal : target.val = (prim.ncodeunits s).val + 1 := by
    change (prim.ncodeunits s + int 1).val = _
    exact indexAddOneVal (prim.ncodeunits s) hncNonnegative hncMax
  have hvalidTarget : target.val ≤ (prim.ncodeunits s).val →
      prim.isvalid s target = .ok true := by
    intro h
    rw [htargetVal] at h
    omega
  have hinvalidTarget : ∀ k : Index, last.val < k.val → k.val < target.val →
      prim.isvalid s k = .ok false := by
    intro k hlo hhi
    apply hinvalid k hlo
    rw [htargetVal] at hhi
    omega
  have hnext := nextindOneTo prim s last target hlast0 hlastBound
    (by rw [htargetVal]; omega)
    (by rw [htargetVal]; omega)
    hvalidTarget hinvalidTarget
  have hend' : nextindOne (gFull prim) s last = .ok e1 := by
    simpa [nextindOne, hlast] using hend
  have heq : target = e1 := Except.ok.inj (hnext.symm.trans hend')
  rw [← heq, htargetVal]
  omega

theorem emptyRangeAt {S R C CU CT E : Type}
    (prim : StringOps S R C CU CT E) (errs : ViewErrors S E) (s : S)
    (k : Index) (hk : 1 ≤ k.val) :
    ∃ v, v.string = s ∧ gRange prim errs s k (k - int 1) = .ok v ∧
      ViewIterates prim errs v [] := by
  let v : Sub.SubString S :=
    ⟨s, JuliaLean.base.strings.substring.zero, JuliaLean.base.strings.substring.zero⟩
  have hone : (int 1).val = 1 := by decide
  have hsub : (k - int 1).val = k.val - 1 := by
    change wrapInt .i64 (k.val - (int 1).val) = _
    rw [hone]
    apply wrapInt_of_inRange .i64 (k.val - 1)
    constructor
    · have hmin : IntTy.min .i64 ≤ 0 := by
        simp [IntTy.min, IntTy.signed, IntTy.bits]
      omega
    · omega
  have hlt : (k - int 1).val < k.val := by rw [hsub]; omega
  refine ⟨v, rfl, ?_, ?_⟩
  · simp [gRange, Sub.subStringInt, JuliaLean.base.strings.substring.typedSubString,
      hlt, v, JuliaLean.base.strings.substring.zero,
      bind, Except.bind, pure, Except.pure]
  · refine ⟨none, ?_, Trace.nil⟩
    change viewIterateAt prim errs v (int 1) = .ok none
    have hp : (int 0 + JuliaLean.base.strings.substring.one).val = 1 := by decide
    simp [viewIterateAt, Sub.iterateSubString, JuliaLean.Proofs.base.int.eq_int_eq, hp,
      v, JuliaLean.base.strings.substring.zero, JuliaLean.base.strings.substring.int,
      bind, Except.bind, pure, Except.pure]
private theorem rstripPrefixWitness {S R C CU CT : Type}
    (prim : StringOps S R C CU CT JlError) (errs : ViewErrors S JlError)
    (f : C → Jl Bool) (s : S) (layout : List (Index × C))
    (law : Lawful prim s layout) (out : Sub.SubString S)
    (hrun : rstrip (stripOps prim errs) f s = some (.ok out)) :
    ∃ retained after terminal,
      layout = retained ++ after ∧
      WalkSegment prim s terminal (int 1) retained ∧ Walk prim s terminal after ∧
      out.string = s ∧ out.offset.val = 0 ∧ out.ncodeunits.val + 1 = terminal.val := by
  obtain ⟨first,hfirst,htrace⟩ := lawfulReversePairsTrace prim s layout law
  have htrace' : PairTrace ((stripOps prim errs).reversePairsNext s) first layout.reverse := htrace
  have hloop : rstrip.loop (stripOps prim errs) f s first = some (.ok out) := by
    simpa [rstrip,stripOps,stripOpsOf,hfirst] using hrun
  obtain ⟨before,suffix,hsplit,hrange⟩ := rstripSelectedRange (stripOps prim errs) f s htrace' out hloop
  cases suffix with
  | nil =>
    have hcon : gRange prim errs s (int 1) (int 0) = .ok out := by
      simpa [stripOps,stripOpsOf] using hrange
    have heq : out = (⟨s,int 0,int 0⟩ : Sub.SubString S) := by
      have hh : gRange prim errs s (int 1) (int 0) = .ok (⟨s,int 0,int 0⟩ : Sub.SubString S) := by
        simp only [gRange,Sub.subStringInt,JuliaLean.base.strings.substring.typedSubString,
          if_pos (show (int 0).val < (int 1).val by decide),bind,Except.bind,pure,Except.pure]
        rfl
      exact Except.ok.inj (hcon.symm.trans hh)
    subst out
    exact ⟨[],layout,int 1,by simp,WalkSegment.stop rfl,law.walk,rfl,
      by change (int 0).val = 0; decide,
      by change (int 0).val + 1 = (int 1).val; decide⟩
  | cons p rest =>
    rcases p with ⟨p,c⟩
    have hsplit' : layout = rest.reverse ++ (p,c) :: before.reverse := by
      simpa [List.reverse_append,List.reverse_cons,List.append_assoc] using congrArg List.reverse hsplit
    obtain ⟨next,hnext,htail,hadvance⟩ := lawfulNextAt prim s layout law
      rest.reverse p c before.reverse hsplit'
    have heq : layout = (rest.reverse ++ [(p,c)]) ++ before.reverse := by simpa using hsplit'
    obtain ⟨terminal,hsegment,hterminal⟩ := walkSegmentFromPrefix prim s law.walk
      (rest.reverse ++ [(p,c)]) before.reverse heq
    have htEq : terminal = next :=
      Subtype.ext (hterminal.trans (walkStartValue prim s htail).symm)
    subst terminal
    have hr : gRange prim errs s (int 1) p = .ok out := by
      simpa [stripOps,stripOpsOf] using hrange
    have htyped : JuliaLean.base.strings.substring.typedSubString (gParent prim errs)
        s (int 1) p = .ok out := by
      unfold gRange Sub.subStringInt at hr
      exact hr
    obtain ⟨start,hw⟩ := walkSuffix prim s law.walk rest.reverse ((p,c)::before.reverse) hsplit'
    cases hw with
    | step bounds yield advances tail =>
      have hone : (int 1).val = 1 := by decide
      have hspan := typedSubStringViewSpan (gParent prim errs) s (int 1) p next out
        (by omega) (by omega) (by omega) hnext htyped
      exact ⟨rest.reverse++[(p,c)],before.reverse,next,heq,hsegment,htail,
        typedSubStringParent (gParent prim errs) s (int 1) p out htyped,
        by omega,by omega⟩

private theorem traceUnique {C E St : Type} (next : St → Except E (Option (C × St)))
    {first : Option (C × St)} {xs ys : List C}
    (hx : Trace next first xs) (hy : Trace next first ys) : xs = ys := by
  induction hx generalizing ys with
  | nil => cases hy; rfl
  | @cons c state current rest hnext tail ih =>
    cases hy with
    | @cons _ _ current' rest' hnext' tail' =>
      have heq := Except.ok.inj (hnext.symm.trans hnext')
      subst current'
      exact congrArg (List.cons c) (ih tail')

private theorem viewIteratesUnique {S R C CU CT E : Type}
    (prim : StringOps S R C CU CT E) (errs : ViewErrors S E)
    (v : Sub.SubString S) (xs ys : List C)
    (hx : ViewIterates prim errs v xs) (hy : ViewIterates prim errs v ys) : xs = ys := by
  obtain ⟨first,hfirst,htrace⟩ := hx
  obtain ⟨first',hfirst',htrace'⟩ := hy
  have heq := Except.ok.inj (hfirst.symm.trans hfirst')
  subst first'
  exact traceUnique _ htrace htrace'

namespace Affix

private inductive WalkSegment {S R C CU CT E : Type}
    (prim : StringOps S R C CU CT E) (s : S) (terminal : Index) :
    Index → List (Index × C) → Prop where
  | stop {i : Index} (atEnd : i.val = terminal.val) :
      WalkSegment prim s terminal i []
  | step {i j : Index} {c : C} {rest : List (Index × C)}
      (inBounds : 1 ≤ i.val ∧ i.val ≤ (prim.ncodeunits s).val)
      (yield : prim.iterateAt s i = .ok (some (c, j)))
      (advances : i.val < j.val)
      (tail : WalkSegment prim s terminal j rest) :
      WalkSegment prim s terminal i ((i, c) :: rest)

private theorem indexOfIntVal (z : Int)
    (h : IntTy.min .i64 ≤ z ∧ z ≤ IntTy.max .i64) : (int z).val = z := by
  change wrapInt .i64 z = z
  exact wrapInt_of_inRange .i64 z h

private theorem indexAddVal (a b : Index)
    (h : IntTy.min .i64 ≤ a.val + b.val ∧ a.val + b.val ≤ IntTy.max .i64) :
    (a + b).val = a.val + b.val := by
  change wrapInt .i64 (a.val + b.val) = a.val + b.val
  exact wrapInt_of_inRange .i64 _ h

private theorem segmentStartBound {S R C CU CT E : Type}
    (prim : StringOps S R C CU CT E) (s : S) (terminal : Index)
    {i : Index} {pairs : List (Index × C)} (walk : WalkSegment prim s terminal i pairs) :
    i.val ≤ terminal.val := by
  induction walk with
  | stop atEnd => omega
  | step inBounds yield advances tail ih => omega

private def localIndex {S : Type} (v : Sub.SubString S) (i : Index) : Index :=
  int (i.val - v.offset.val)

private theorem localIndexVal {S : Type} (v : Sub.SubString S) (terminal i : Index)
    (hoff0 : 0 ≤ v.offset.val)
    (hspan : v.offset.val + v.ncodeunits.val + 1 = terminal.val)
    (hoff : v.offset.val + 1 ≤ i.val) (hi : i.val ≤ terminal.val) :
    (localIndex v i).val = i.val - v.offset.val := by
  unfold localIndex
  apply indexOfIntVal
  constructor
  · have hmin : IntTy.min .i64 ≤ 1 := by decide
    omega
  · have htermHi := terminal.property.2
    have hspanBound : v.ncodeunits.val + 1 ≤ IntTy.max .i64 := by omega
    omega

private theorem viewIterateAtSegmentStep {S R C CU CT E : Type}
    (prim : StringOps S R C CU CT E) (errs : ViewErrors S E)
    (s : S) (v : Sub.SubString S) (terminal i j : Index) (c : C)
    (hstring : v.string = s) (hoff0 : 0 ≤ v.offset.val)
    (hspan : v.offset.val + v.ncodeunits.val + 1 = terminal.val)
    (hoff : v.offset.val + 1 ≤ i.val) (hi : i.val < terminal.val)
    (hin : 1 ≤ i.val ∧ i.val ≤ (prim.ncodeunits s).val)
    (hj : j.val ≤ terminal.val)
    (hiter : prim.iterateAt s i = .ok (some (c, j))) :
    viewIterateAt prim errs v (localIndex v i) =
      .ok (some (c, localIndex v j)) := by
  have hlocal : (localIndex v i).val = i.val - v.offset.val :=
    localIndexVal v terminal i hoff0 hspan hoff (by omega)
  have hlocalLower : 1 ≤ (localIndex v i).val := by rw [hlocal]; omega
  have hlocalUpper : (localIndex v i).val ≤ v.ncodeunits.val := by
    rw [hlocal]
    have hspan' : v.offset.val + v.ncodeunits.val + 1 = terminal.val := hspan
    omega
  have hparent : v.offset + localIndex v i = i := by
    apply Subtype.ext
    change wrapInt .i64 (v.offset.val + (localIndex v i).val) = i.val
    rw [hlocal]
    have hsum : v.offset.val + (i.val - v.offset.val) = i.val := by omega
    rw [hsum]
    exact wrapInt_of_inRange .i64 i.val i.property
  have hcheck : viewCheck errs v (localIndex v i) = .ok () := by
    simp [viewCheck, viewInBounds, JuliaLean.base.strings.basic.checkbounds,
      JuliaLean.base.strings.basic.checkboundsScalar, hlocalLower, hlocalUpper,
      bind, Except.bind, pure, Except.pure]
  have hEndVal : (v.ncodeunits + int 1).val = v.ncodeunits.val + 1 := by
    apply indexAddVal
    constructor
    · have hn := v.ncodeunits.property.1
      have hOne : (int 1).val = 1 := by decide
      have hmin : IntTy.min .i64 ≤ 1 := by decide
      rw [hOne]
      omega
    · have ht := terminal.property.2
      have hOne : (int 1).val = 1 := by decide
      rw [hOne]
      omega
  have hnotEnd : (localIndex v i).val ≠ (v.ncodeunits + int 1).val := by
    rw [hlocal, hEndVal]
    omega
  have hEndOne : (v.ncodeunits + JuliaLean.base.strings.substring.one).val =
      (v.ncodeunits + int 1).val := by
    simp [JuliaLean.base.strings.substring.one, JuliaLean.base.strings.substring.int]
  have hnotEndOne :
      (localIndex v i).val ≠ (v.ncodeunits + JuliaLean.base.strings.substring.one).val := by
    rw [hEndOne]
    exact hnotEnd
  have hend : JuliaLean.base.int.eq_int (localIndex v i)
      (v.ncodeunits + JuliaLean.base.strings.substring.one) = false := by
    rw [JuliaLean.Proofs.base.int.eq_int_eq]
    simp [hnotEndOne]
  have hparent' :
      (viewParentIndex v.offset (localIndex v i) : Except E Index) = .ok i := by
    simp [viewParentIndex, hparent]
  have hnext : j - v.offset = localIndex v j := by
    apply Subtype.ext
    rfl
  simpa [viewIterateAt, JuliaLean.base.strings.substring.iterateSubString,
    hend, hcheck, hparent', hstring, hiter, hnext, bind, Except.bind, pure, Except.pure]

private theorem viewTraceOfSegment {S R C CU CT E : Type}
    (prim : StringOps S R C CU CT E) (errs : ViewErrors S E)
    (s : S) (v : Sub.SubString S) (terminal : Index)
    {i : Index} {pairs : List (Index × C)}
    (walk : WalkSegment prim s terminal i pairs)
    (hstring : v.string = s) (hoff0 : 0 ≤ v.offset.val)
    (hspan : v.offset.val + v.ncodeunits.val + 1 = terminal.val)
    (hoff : v.offset.val + 1 ≤ i.val) :
    ∃ first, viewIterateAt prim errs v (localIndex v i) = .ok first ∧
      Trace (viewIterateAt prim errs v) first (pairs.map Prod.snd) := by
  revert hoff
  induction walk with
  | @stop i atEnd =>
    intro hoff
    have hiUpper : i.val ≤ terminal.val := by omega
    have hlocal := localIndexVal v terminal i hoff0 hspan hoff hiUpper
    have hEndVal : (v.ncodeunits + int 1).val = v.ncodeunits.val + 1 := by
      apply indexAddVal
      constructor
      · have hn := v.ncodeunits.property.1
        have hOne : (int 1).val = 1 := by decide
        have hmin : IntTy.min .i64 ≤ 1 := by decide
        rw [hOne]
        omega
      · have ht := terminal.property.2
        have hOne : (int 1).val = 1 := by decide
        rw [hOne]
        omega
    have hEndEq : localIndex v i = v.ncodeunits + int 1 := by
      apply Subtype.ext
      rw [hlocal, hEndVal, atEnd]
      omega
    have hEndEq' : localIndex v i =
        v.ncodeunits + JuliaLean.base.strings.substring.one := by
      simpa [JuliaLean.base.strings.substring.one, JuliaLean.base.strings.substring.int] using hEndEq
    have hEqEnd :
        JuliaLean.base.int.eq_int (localIndex v i)
          (v.ncodeunits + JuliaLean.base.strings.substring.one) = true := by
      rw [JuliaLean.Proofs.base.int.eq_int_eq]
      simp [hEndEq']
    refine ⟨none, ?_, Trace.nil⟩
    rw [hEndEq']
    simp [viewIterateAt, JuliaLean.base.strings.substring.iterateSubString,
      JuliaLean.Proofs.base.int.eq_int_eq, hEqEnd]
  | @step i j c rest inBounds yield advances tail ih =>
    intro hoff
    have hj : j.val ≤ terminal.val := segmentStartBound prim s terminal tail
    have hstep := viewIterateAtSegmentStep prim errs s v terminal i j c
      hstring hoff0 hspan hoff (by omega) inBounds hj yield
    obtain ⟨first, hfirst, htrace⟩ := ih (by omega)
    refine ⟨some (c, localIndex v j), hstep, ?_⟩
    simpa only [List.map_cons] using Trace.cons hfirst htrace

private theorem viewIteratesSegment {S R C CU CT E : Type}
    (prim : StringOps S R C CU CT E) (errs : ViewErrors S E)
    (s : S) (v : Sub.SubString S) (terminal first : Index)
    (pairs : List (Index × C))
    (walk : WalkSegment prim s terminal first pairs)
    (hstring : v.string = s) (hoff0 : 0 ≤ v.offset.val)
    (hspan : v.offset.val + v.ncodeunits.val + 1 = terminal.val)
    (hstart : v.offset.val + 1 = first.val) :
    ViewIterates prim errs v (pairs.map Prod.snd) := by
  have hfirstBound := segmentStartBound prim s terminal walk
  have hlocalStart : localIndex v first = int 1 := by
    apply Subtype.ext
    have hv := localIndexVal v terminal first hoff0 hspan (by rw [hstart]; omega) hfirstBound
    rw [hv]
    have hone : (int 1).val = 1 := by decide
    rw [hone]
    omega
  obtain ⟨firstState, hfirstState, htrace⟩ :=
    viewTraceOfSegment prim errs s v terminal walk hstring hoff0 hspan
      (by rw [hstart]; omega)
  unfold ViewIterates Iterates
  refine ⟨firstState, ?_, ?_⟩
  · change viewIterateAt prim errs v (int 1) = .ok firstState
    rw [← hlocalStart]
    exact hfirstState
  · simpa only [gSubPrim] using htrace

private theorem walkToSegment {S R C CU CT E : Type}
    (prim : StringOps S R C CU CT E) (s : S)
    {first : Index} {pairs : List (Index × C)} (walk : Walk prim s first pairs)
    (hmax : (prim.ncodeunits s).val + 1 ≤ IntTy.max .i64) :
    WalkSegment prim s (prim.ncodeunits s + int 1) first pairs := by
  induction walk with
  | @stop i atEnd done =>
    have hnext := JuliaLean.Proofs.base.strings.basic.add_one_val
      (prim.ncodeunits s) hmax
    exact WalkSegment.stop (by rw [hnext]; exact atEnd)
  | @step i j c rest inBounds yield advances tail ih =>
    exact WalkSegment.step inBounds yield advances ih

private theorem walkSegmentDropLast {S R C CU CT E : Type}
    (prim : StringOps S R C CU CT E) (s : S) {i : Index} {pairs : List (Index × C)}
    (walk : Walk prim s i pairs) :
    ∀ {before : List (Index × C)} {last : Index × C},
      pairs = before ++ [last] →
      WalkSegment prim s last.1 i before := by
  intro before last h
  induction walk generalizing before last with
  | @stop i atEnd done =>
    simp at h
  | @step i j c rest hbounds hyield hadvance tail ih =>
    cases before with
    | nil =>
      simp at h
      cases rest with
      | nil =>
        obtain ⟨hhead, _⟩ := h
        cases hhead
        exact WalkSegment.stop rfl
      | cons p ps => simp at h
    | cons p ps =>
      simp only [List.cons_append] at h
      injection h with hhead htail
      subst p
      exact WalkSegment.step hbounds hyield hadvance (ih htail)

private theorem splitLastList {α : Type} {xs : List α} {x : α}
    (h : xs.getLast? = some x) : ∃ before, xs = before ++ [x] := by
  induction xs generalizing x with
  | nil => simp at h
  | cons a rest ih =>
    cases rest with
    | nil =>
      simp at h
      subst x
      exact ⟨[], by simp⟩
    | cons b tail =>
      have htail : (b :: tail).getLast? = some x := by
        simpa [getLastCons] using h
      obtain ⟨before, hbefore⟩ := ih htail
      exact ⟨a :: before, by simp [hbefore]⟩


private theorem lawfulNextAtAffix {S R C CU CT E : Type}
    (prim : StringOps S R C CU CT E) (s : S) (layout : List (Index × C))
    (law : Lawful prim s layout) (before : List (Index × C))
    (i : Index) (c : C) (rest : List (Index × C))
    (hsplit : layout = before ++ (i,c) :: rest) :
    ∃ next, nextindOne (gFull prim) s i = .ok next ∧
      Walk prim s next rest ∧ i.val < next.val := by
  obtain ⟨start,hwalk⟩ := walkSuffix prim s law.walk before ((i,c) :: rest) hsplit
  cases hwalk with
  | @step i next c rest bounds yield advances tail =>
    refine ⟨next, ?_, tail, advances⟩
    have hnextBound := walkStartBound prim s tail
    apply nextindOneTo prim s i next (by omega) bounds.2 advances hnextBound
    · intro hn
      cases tail with
      | stop atEnd done => omega
      | @step next j d tail b y a wt =>
        have hmem : (next,d) ∈ layout := by rw [hsplit]; simp
        have ha : layout.any (fun p => p.1.val == next.val) = true :=
          List.any_eq_true.mpr ⟨(next,d),hmem,by simp⟩
        simpa [ha] using law.isvalid next b.1 b.2
    · intro k hik hkn
      have ha : layout.any (fun p => p.1.val == k.val) = false := by
        cases hh : layout.any (fun p => p.1.val == k.val) with
        | false => rfl
        | true =>
          obtain ⟨q,hq,hqk⟩ := List.any_eq_true.mp hh
          have hqval : q.1.val = k.val := by simpa using beq_iff_eq.mp hqk
          rw [hsplit] at hq
          rcases List.mem_append.mp hq with hbefore | hcur
          · have hlt := walkSplitEarlier prim s law.walk before i c rest hsplit q hbefore
            omega
          · rcases List.mem_cons.mp hcur with hhead | hrest
            · have hidx : q.1.val = i.val := congrArg (fun p : Index × C => p.1.val) hhead
              omega
            · have hge := walkIndicesAtLeast prim s next (Int.le_refl _) tail q hrest
              omega
      simpa [ha] using law.isvalid k (by omega) (by omega)

private theorem fromRound6Segment {S R C CU CT E : Type}
    (prim : StringOps S R C CU CT E) (s : S) (terminal : Index)
    {i : Index} {pairs : List (Index × C)}
    (walk : _root_.JuliaLean.Proofs.base.strings.util.Round6.WalkSegment
      prim s terminal i pairs) :
    WalkSegment prim s terminal i pairs := by
  induction walk with
  | stop atEnd => exact WalkSegment.stop atEnd
  | step inBounds yield advances tail ih =>
    exact WalkSegment.step inBounds yield advances ih

private theorem rangePrefixAffix {S R C CU CT E : Type}
    (prim : StringOps S R C CU CT E) (errs : ViewErrors S E)
    (s : S) (layout : List (Index × C)) (law : Lawful prim s layout)
    (before : List (Index × C)) (i : Index) (c : C) (after : List (Index × C))
    (hsplit : layout = before ++ (i,c) :: after) :
    ∃ out, gRange prim errs s (int 1) i = .ok out ∧ out.string = s ∧
      ViewIterates prim errs out (charsIn (before ++ [(i,c)])) := by
  obtain ⟨next,hnext,htail,hadvance⟩ :=
    lawfulNextAtAffix prim s layout law before i c after hsplit
  have hsplit' : layout = (before ++ [(i,c)]) ++ after := by simpa using hsplit
  obtain ⟨terminal,hsegment,he⟩ :=
    walkSegmentFromPrefix prim s law.walk (before ++ [(i,c)]) after hsplit'
  have hterminal : terminal = next := by
    apply Subtype.ext
    cases htail with
    | stop atEnd done => simpa [segmentEnd] using he.trans atEnd.symm
    | step bounds yield advances tail => simpa [segmentEnd] using he
  subst terminal
  have hmem : (i,c) ∈ layout := by rw [hsplit]; simp
  obtain ⟨start,hw⟩ := walkSuffix prim s law.walk before ((i,c) :: after) hsplit
  cases hw with
  | @step i j c after bounds yield advances tail =>
    have hone : (int 1).val = 1 := by decide
    have hv : prim.isvalid s i = .ok true := by
      have ha : layout.any (fun p => p.1.val == i.val) = true :=
        List.any_eq_true.mpr ⟨(i,c),hmem,by simp⟩
      simpa [ha] using law.isvalid i bounds.1 bounds.2
    have hvfirst : prim.isvalid s (int 1) = .ok true := by
      cases law.walk with
      | stop atEnd done => simp at hsplit
      | step b y a wt => simpa using law.isvalid (int 1) b.1 b.2
    let out : Sub.SubString S :=
      ⟨s,int 1 - JuliaLean.base.strings.substring.one,next - int 1⟩
    have hcheck : (gParent prim errs).checkboundsRange s (int 1) i = .ok () := by
      simp [gParent, JuliaLean.base.strings.basic.checkbounds,
        JuliaLean.base.strings.basic.checkboundsRange, unitRangeOps, gFull, modelStringOps,
        hone, show ¬ i.val < 1 by omega, bounds.2, bind, Except.bind, pure, Except.pure]
    have hcon : JuliaLean.base.strings.substring.typedSubString (gParent prim errs)
        s (int 1) i = .ok out := by
      simp only [JuliaLean.base.strings.substring.typedSubString,
        if_neg (show ¬ i.val < (int 1).val by omega)]
      simp [hcheck,
        show (gParent prim errs).isvalid s (int 1) = .ok true from hvfirst,
        show (gParent prim errs).isvalid s i = .ok true from hv,
        show (gParent prim errs).nextind s i = .ok next from hnext,
        out, bind, Except.bind, pure, Except.pure]
    have hspan := typedSubStringViewSpan (gParent prim errs) s (int 1) i next out
      (by omega) (by omega) (by omega) hnext hcon
    refine ⟨out, ?_, rfl, ?_⟩
    · simpa [gRange, Sub.subStringInt, hcon] using hcon
    · exact viewIteratesSegment prim errs s out next (int 1) (before ++ [(i,c)])
        (fromRound6Segment prim s next hsegment) rfl (by have hh := hspan.1; omega)
        hspan.2 hspan.1

private theorem lawfulAdjacentPrevAffix {S R C CU CT E : Type}
    (prim : StringOps S R C CU CT E) (s : S) (layout : List (Index × C))
    (law : Lawful prim s layout) (before : List (Index × C))
    (q : Index) (d : C) (p : Index) (c : C) (after : List (Index × C))
    (hsplit : layout = before ++ (q,d) :: (p,c) :: after) :
    previndOne (gFull prim) s p = .ok q := by
  obtain ⟨start,hw⟩ := walkSuffix prim s law.walk before ((q,d) :: (p,c) :: after) hsplit
  cases hw with
  | @step q p d rest bq yq aq wtail =>
    cases wtail with
    | @step p next c after bp yp ap wafter =>
      have hvalidQ : prim.isvalid s q = .ok true := by
        have hm : (q,d) ∈ layout := by rw [hsplit]; simp
        have ha : layout.any (fun a => a.1.val == q.val) = true :=
          List.any_eq_true.mpr ⟨(q,d),hm,by simp⟩
        simpa [ha] using law.isvalid q bq.1 bq.2
      have hinv : ∀ k : Index, q.val < k.val ∧ k.val < p.val →
          prim.isvalid s k = .ok false := by
        intro k hk
        have ha : layout.any (fun a => a.1.val == k.val) = false := by
          cases hh : layout.any (fun a => a.1.val == k.val) with
          | false => rfl
          | true =>
            obtain ⟨a,ha,hak⟩ := List.any_eq_true.mp hh
            have hav : a.1.val = k.val := by simpa using beq_iff_eq.mp hak
            rw [hsplit] at ha
            rcases List.mem_append.mp ha with hbefore | hrest
            · have hlt := walkSplitEarlier prim s law.walk before q d
                ((p,c)::after) hsplit a hbefore
              omega
            · rcases List.mem_cons.mp hrest with hhead | htail
              · have hi : a.1.val = q.val := congrArg (fun a : Index × C => a.1.val) hhead
                omega
              · have hge : p.val ≤ a.1.val :=
                  walkIndicesAtLeast prim s p (Int.le_refl _) (Walk.step bp yp ap wafter) a htail
                omega
        simpa [ha] using law.isvalid k (by omega) (by omega)
      have hh := JuliaLean.Proofs.base.strings.basic.prevind_proven.2.2.2.2.1
        S R C CU CT E prim (fun x => toString x.val) s p q
        (walkEndBound prim s law.walk) ⟨bq.1,aq,by omega⟩ hvalidQ hinv
      exact hh.1
private theorem gRangeEmptyAffix {S R C CU CT E : Type}
    (prim : StringOps S R C CU CT E) (errs : ViewErrors S E) (s : S) :
    gRange prim errs s (int 1) (int 0) =
      .ok (⟨s,JuliaLean.base.strings.substring.zero,
        JuliaLean.base.strings.substring.zero⟩ : Sub.SubString S) := by
  change Sub.subStringInt (gParent prim errs) s (int 1) (int 0) = _
  simp [Sub.subStringInt, JuliaLean.base.strings.substring.typedSubString,
    JuliaLean.base.strings.substring.zero, JuliaLean.base.strings.substring.int,
    bind, Except.bind, pure, Except.pure]

private theorem emptyViewIteratesAffix {S R C CU CT E : Type}
    (prim : StringOps S R C CU CT E) (errs : ViewErrors S E) (s : S) :
    ViewIterates prim errs
      (⟨s,JuliaLean.base.strings.substring.zero,
        JuliaLean.base.strings.substring.zero⟩ : Sub.SubString S) [] := by
  let v : Sub.SubString S :=
    ⟨s,JuliaLean.base.strings.substring.zero,JuliaLean.base.strings.substring.zero⟩
  have hsegment : WalkSegment prim s (int 1) (int 1) [] := WalkSegment.stop rfl
  have hoff0 : 0 ≤ v.offset.val := by
    simp [v, JuliaLean.base.strings.substring.zero, JuliaLean.base.strings.substring.int]
  have hspan : v.offset.val + v.ncodeunits.val + 1 = (int 1).val := by
    simp [v, JuliaLean.base.strings.substring.zero, JuliaLean.base.strings.substring.int]
  have hstart : v.offset.val + 1 = (int 1).val := by
    simp [v, JuliaLean.base.strings.substring.zero, JuliaLean.base.strings.substring.int]
  exact viewIteratesSegment prim errs s v (int 1) (int 1) [] hsegment rfl
    hoff0 hspan hstart

private theorem wholeViewIteratesAffix {S R C CU CT E : Type}
    (prim : StringOps S R C CU CT E) (errs : ViewErrors S E)
    (s : S) (layout : List (Index × C)) (law : Lawful prim s layout) :
    ∃ out, gWhole prim errs s = .ok out ∧ out.string = s ∧
      ViewIterates prim errs out (charsIn layout) := by
  let out : Sub.SubString S :=
    ⟨s,JuliaLean.base.strings.substring.one - JuliaLean.base.strings.substring.one,
      prim.ncodeunits s⟩
  have hn : 0 ≤ (prim.ncodeunits s).val := by
    cases law.walk with
    | stop atEnd done =>
      have hone : (int 1).val = 1 := by decide
      rw [hone] at atEnd
      omega
    | step bounds yield advances tail =>
      have hone : (int 1).val = 1 := by decide
      rw [hone] at bounds
      omega
  have hmax := walkEndBound prim s law.walk
  have hzero : JuliaLean.base.strings.substring.one -
      JuliaLean.base.strings.substring.one = JuliaLean.base.strings.substring.zero := by
    apply Subtype.ext
    decide
  have hwhole : gWhole prim errs s = .ok out := by
    change JuliaLean.base.strings.substring.rawSubstring
      (gParent prim errs) s JuliaLean.base.strings.substring.one
      (prim.ncodeunits s) false = .ok out
    simp [JuliaLean.base.strings.substring.rawSubstring, gParent,
      hzero, out, JuliaLean.base.strings.substring.one,
      JuliaLean.base.strings.substring.zero, JuliaLean.base.strings.substring.int]
  let terminal := prim.ncodeunits s + int 1
  have hend : terminal.val = (prim.ncodeunits s).val + 1 :=
    JuliaLean.Proofs.base.strings.basic.add_one_val (prim.ncodeunits s) hmax
  have hwalk := walkSegmentFull prim s terminal hend law.walk
  have hoffIndex : out.offset = JuliaLean.base.strings.substring.zero := by
    simpa [out] using hzero
  have hoff0 : 0 ≤ out.offset.val := by
    rw [hoffIndex]
    simp [JuliaLean.base.strings.substring.zero, JuliaLean.base.strings.substring.int]
  have hspan : out.offset.val + out.ncodeunits.val + 1 = terminal.val := by
    rw [hoffIndex]
    simp [out, terminal, hend, JuliaLean.base.strings.substring.zero,
      JuliaLean.base.strings.substring.int]
  have hstart : out.offset.val + 1 = (int 1).val := by
    rw [hoffIndex]
    simp [JuliaLean.base.strings.substring.zero, JuliaLean.base.strings.substring.int]
  have hview : ViewIterates prim errs out (charsIn layout) := by
    exact viewIteratesSegment prim errs s out terminal (int 1) layout
      (fromRound6Segment prim s terminal hwalk) rfl hoff0 hspan hstart
  exact ⟨out,hwhole,rfl,hview⟩
private theorem mapMCharsLast {C : Type}
    (toC : C → CharResult UInt32) (before : List (Index × C))
    (last : Index × C) (values : List UInt32)
    (hmap : (charsIn (before ++ [last])).mapM toC = .ok values) :
    ∃ mapped u, (charsIn before).mapM toC = .ok mapped ∧
      toC last.2 = .ok u ∧ values = mapped ++ [u] := by
  have hmap' : (charsIn before ++ [last.2]).mapM toC = .ok values := by
    simpa [charsIn, List.map_append] using hmap
  cases hprefix : (charsIn before).mapM toC with
  | error e =>
    simp [List.mapM_append, List.mapM_cons, List.mapM_nil, hprefix,
      bind, Except.bind, pure, Except.pure, Functor.map, Except.map] at hmap'
  | ok mapped =>
    cases hlast : toC last.2 with
    | error e =>
      simp [List.mapM_append, List.mapM_cons, List.mapM_nil, hprefix, hlast,
        bind, Except.bind, pure, Except.pure, Functor.map, Except.map] at hmap'
    | ok u =>
      have hvalue : (Except.ok (mapped ++ [u]) : CharResult (List UInt32)) =
          .ok values := by
        simpa [List.mapM_append, List.mapM_cons, List.mapM_nil,
          hprefix, hlast, bind, Except.bind, pure, Except.pure,
          Functor.map, Except.map] using hmap'
      exact ⟨mapped,u,rfl,rfl,(Except.ok.inj hvalue).symm⟩
private theorem getLastAppendSingleton {α : Type} (xs : List α) (x : α) :
    (xs ++ [x]).getLast? = some x := by
  induction xs with
  | nil => rfl
  | cons a rest ih => simp [getLastCons, ih]

private theorem takeAppendSingleton {α : Type} (xs : List α) (x : α) :
    (xs ++ [x]).take xs.length = xs := by
  induction xs with
  | nil => rfl
  | cons a rest ih => simp [ih]

private theorem walkSingletonIndex {S R C CU CT E : Type}
    (prim : StringOps S R C CU CT E) (s : S) {i : Index} {c : C}
    (walk : Walk prim s (int 1) [(i,c)]) : i = int 1 := by
  cases walk with
  | step inBounds yield advances tail => rfl
theorem rangeSlice {S R C CU CT E : Type}
    (prim : StringOps S R C CU CT E) (errs : ViewErrors S E)
    (s : S) (layout : List (Index × C)) (law : Lawful prim s layout)
    (pre beforeLast rest after : List (Index × C))
    (i last : Index) (c d : C)
    (hseg : (i, c) :: rest = beforeLast ++ [(last, d)])
    (hsplit : layout = pre ++ ((i, c) :: rest) ++ after) :
    ∃ out, gRange prim errs s i last = .ok out ∧ out.string = s ∧
      ViewIterates prim errs out (charsIn ((i, c) :: rest)) := by
  have hsplitPre : layout = pre ++ (((i, c) :: rest) ++ after) := by
    simpa [List.append_assoc] using hsplit
  obtain ⟨start, hwalk⟩ :=
    walkSuffix prim s law.walk pre (((i, c) :: rest) ++ after) hsplitPre
  have hstart : start = i := by
    apply Subtype.ext
    simpa [Round6.segmentEnd] using Round6.walkStartValue prim s hwalk
  subst start
  obtain ⟨terminal, hsegment, hterminal⟩ :=
    Round6.walkSegmentFromPrefix prim s hwalk ((i, c) :: rest) after rfl
  have hsplitLast : layout = (pre ++ beforeLast) ++ (last, d) :: after := by
    calc
      layout = pre ++ ((i, c) :: rest) ++ after := hsplit
      _ = pre ++ (beforeLast ++ [(last, d)]) ++ after := by rw [hseg]
      _ = (pre ++ beforeLast) ++ (last, d) :: after := by simp [List.append_assoc]
  obtain ⟨next, hnext, htail, hadvance⟩ :=
    lawfulNextAtAffix prim s layout law (pre ++ beforeLast) last d after hsplitLast
  have hterminalVal : terminal.val = next.val :=
    hterminal.trans (Round6.walkStartValue prim s htail).symm
  have hterminalNext : terminal = next := Subtype.ext hterminalVal
  subst terminal
  have hboundsI : 1 ≤ i.val ∧ i.val ≤ (prim.ncodeunits s).val := by
    cases hwalk with
    | step bounds _ _ _ => exact bounds
  obtain ⟨lastStart, hlastWalk⟩ :=
    Round6.walkSuffix prim s law.walk (pre ++ beforeLast) ((last, d) :: after) hsplitLast
  have hboundsLast : 1 ≤ last.val ∧ last.val ≤ (prim.ncodeunits s).val := by
    cases hlastWalk with
    | step bounds _ _ _ => exact bounds
  have hmemI : (i, c) ∈ layout := by
    rw [hsplit]
    simp
  have hmemLast : (last, d) ∈ layout := by
    rw [hsplitLast]
    simp
  have hanyI : layout.any (fun p => p.1.val == i.val) = true :=
    List.any_eq_true.mpr ⟨(i, c), hmemI, by simp⟩
  have hanyLast : layout.any (fun p => p.1.val == last.val) = true :=
    List.any_eq_true.mpr ⟨(last, d), hmemLast, by simp⟩
  have hvalidI : prim.isvalid s i = .ok true := by
    have h := law.isvalid i hboundsI.1 hboundsI.2
    simpa [hanyI] using h
  have hvalidLast : prim.isvalid s last = .ok true := by
    have h := law.isvalid last hboundsLast.1 hboundsLast.2
    simpa [hanyLast] using h
  have hmemLastSuffix : (last, d) ∈ ((i, c) :: rest) ++ after := by
    rw [hseg]
    simp
  have hile : i.val ≤ last.val :=
    Round6.walkIndicesAtLeast prim s i (Int.le_refl _) hwalk (last, d) hmemLastSuffix
  have hsegment' := fromRound6Segment prim s next hsegment
  cases hsegment' with
  | step bounds yield advances tail =>
    let out : Sub.SubString S :=
      ⟨s, i - JuliaLean.base.strings.substring.one, next - i⟩
    have hone : (int 1).val = 1 := by decide
    have hcheck : (gParent prim errs).checkboundsRange s i last = .ok () := by
      simp [gParent, JuliaLean.base.strings.basic.checkbounds,
        JuliaLean.base.strings.basic.checkboundsRange, unitRangeOps, gFull, modelStringOps,
        show ¬ last.val < i.val by omega, show ¬ i.val < 1 by omega, hboundsLast.2,
        bind, Except.bind, pure, Except.pure]
    have hcon : JuliaLean.base.strings.substring.typedSubString (gParent prim errs)
        s i last = .ok out := by
      simp only [JuliaLean.base.strings.substring.typedSubString,
        if_neg (show ¬ last.val < i.val by omega)]
      simp [hcheck,
        show (gParent prim errs).isvalid s i = .ok true from hvalidI,
        show (gParent prim errs).isvalid s last = .ok true from hvalidLast,
        show (gParent prim errs).nextind s last = .ok next from hnext,
        out, bind, Except.bind, pure, Except.pure]
    have hspan := Round6.typedSubStringViewSpan (gParent prim errs) s i last next out
      hile hboundsI.1 (by omega) hnext hcon
    have hstartView : out.offset.val + 1 = i.val := by
      have hoff := hspan.1
      exact hoff
    have hspanView : out.offset.val + out.ncodeunits.val + 1 = next.val := hspan.2
    refine ⟨out, ?_, rfl, ?_⟩
    · simpa [gRange, Sub.subStringInt, hcon] using hcon
    · exact viewIteratesSegment prim errs s out next i ((i, c) :: rest)
        (WalkSegment.step bounds yield advances tail) rfl
        (by have hh := hspan.1; omega) hspanView hstartView
end Affix
theorem chopSuffixCharacterRound6_proven : ChopSuffixCharacter := by
  intro S R C D CU CT E prim errs toC toD lift s c ls us uc hlaw hmap huc
  have hUsEmpty : us.isEmpty = ls.isEmpty := by
    cases ls with
    | nil =>
      have hnil : ([] : List UInt32) = us := by
        simpa [charsIn, List.mapM_nil, pure, Except.pure] using hmap
      simp [hnil]
    | cons first rest =>
      have hmap' : (first.2 :: charsIn rest).mapM toC = .ok us := by
        simpa [charsIn] using hmap
      obtain ⟨u,tail,_,_,hus⟩ := mapM_cons_ok toC first.2 (charsIn rest) hmap'
      simp [hus]
  have hEmptyLayout : isemptyString (gFull prim) s = ls.isEmpty := by
    cases ls with
    | nil =>
      have hn : (prim.ncodeunits s).val = 0 := by
        cases hlaw.walk with
        | stop atEnd done =>
          have hone : (int 1).val = 1 := by decide
          rw [hone] at atEnd
          omega
      change ((prim.ncodeunits s).val == 0) = true
      simp [hn]
    | cons first rest =>
      have hn : (prim.ncodeunits s).val ≠ 0 := by
        cases hlaw.walk with
        | step bounds yield advances tail =>
          have hone : (int 1).val = 1 := by decide
          rw [hone] at bounds
          omega
      change ((prim.ncodeunits s).val == 0) = false
      simp [hn]
  have hNcu : 0 ≤ (prim.ncodeunits s).val := by
    have hb := walkStartBound prim s hlaw.walk
    have hone : (int 1).val = 1 := by decide
    rw [hone] at hb
    omega
  have hmax := walkEndBound prim s hlaw.walk
  obtain ⟨wholeOut,hWhole,hWholeString,hWholeView⟩ :=
    Affix.wholeViewIteratesAffix prim errs s ls hlaw
  let call : S → D → Except E (Sub.SubString S) :=
    fun text suffix =>
      chopsuffixChar
        (fun x => .ok (isemptyString (gFull prim) x))
        (fun x => do getindexString (gFull prim) x (← (gFull prim).lastindex x))
        (fun x => .ok (firstindexString x))
        (gFull prim).lastindex (previndOne (gFull prim))
        (gRange prim errs) (gWhole prim errs) (charEq toC toD lift) text suffix
  cases ls with
  | nil =>
    have hus : us = [] := by
      have heq : ([] : List UInt32) = us := by
        simpa [charsIn, List.mapM_nil, pure, Except.pure] using hmap
      exact heq.symm
    have hEmpty : isemptyString (gFull prim) s = true := by
      simpa [hus] using hEmptyLayout
    have hcall : call s c = .ok wholeOut := by
      simp [call, chopsuffixChar, hEmpty, hWhole, bind, Except.bind, pure, Except.pure]
    have hView : ViewIterates prim errs wholeOut
        (if us.getLast? = some uc then (charsIn []).take (0 - 1) else charsIn []) := by
      simpa [hus, charsIn] using hWholeView
    exact ⟨wholeOut, by simpa [call] using hcall, hWholeString, hView⟩
  | cons first rest =>
    obtain ⟨pair,hlast⟩ := getLastSome first rest
    obtain ⟨before,hSplit⟩ := Affix.splitLastList hlast
    have hmapLast : (charsIn (before ++ [pair])).mapM toC = .ok us := by
      simpa [hSplit] using hmap
    obtain ⟨mapped,lastChar,hmapped,hlastCode,hus⟩ :=
      Affix.mapMCharsLast toC before pair us hmapLast
    have hLastUs : us.getLast? = some lastChar := by
      rw [hus]
      exact Affix.getLastAppendSingleton mapped lastChar
    have hEmpty : isemptyString (gFull prim) s = false := by
      simpa using hEmptyLayout
    have hpairBound := walkLastFacts prim s hlaw.walk pair hlast
    let next : Index := Classical.choose hpairBound.1
    have hiter : prim.iterateAt s pair.1 = .ok (some (pair.2,next)) :=
      Classical.choose_spec hpairBound.1
    have hbound := hpairBound.2.1
    have hlo := hpairBound.2.2.1
    have hup := hpairBound.2.2.2
    have hpairMem : pair ∈ first :: rest := getLastMem hlast
    have hvalid : prim.isvalid s pair.1 = .ok true := by
      rw [hlaw.isvalid pair.1 hlo hup]
      have hany : (first :: rest).any (fun p => p.1.val == pair.1.val) = true :=
        List.any_eq_true.mpr ⟨pair,hpairMem,by simp⟩
      simp [hany]
    have hvalidLater :
        ∀ k : Index, pair.1.val < k.val ∧ k.val ≤ (prim.ncodeunits s).val →
          prim.isvalid s k = .ok false := by
      intro k ⟨hgt,hle⟩
      rw [hlaw.isvalid k (by omega) hle]
      have hany : (first :: rest).any (fun p => p.1.val == k.val) = false := by
        cases heq : (first :: rest).any (fun p => p.1.val == k.val) with
        | false => rfl
        | true =>
          obtain ⟨p,hp,hpk⟩ := List.any_eq_true.mp heq
          have hple := hbound p hp
          have hpEq : p.1.val = k.val := by simpa using beq_iff_eq.mp hpk
          omega
      simp [hany]
    have hlastIndex : (gFull prim).lastindex s = .ok pair.1 := by
      have h := JuliaLean.Proofs.base.strings.basic.thisindInt_rewind
        prim s (prim.ncodeunits s) pair.1 hlo hup (Int.le_refl _) hmax
        (Or.inr hvalid) hvalidLater
      simpa [gFull, modelStringOps, JuliaLean.base.strings.basic.lastindexString] using h
    have hcheck : (gFull prim).checkbounds s pair.1 = .ok () := by
      simp [gFull, modelStringOps, JuliaLean.base.strings.basic.checkbounds,
        JuliaLean.base.strings.basic.checkboundsScalar, hlo, hup,
        bind, Except.bind, pure, Except.pure]
    have hvalidFull : (gFull prim).isvalid s pair.1 = .ok true := by
      change prim.isvalid s pair.1 = .ok true
      exact hvalid
    have hiterFull :
        (gFull prim).iterateAt s pair.1 = .ok (some (pair.2,next)) := by
      change prim.iterateAt s pair.1 = .ok (some (pair.2,next))
      exact hiter
    have hget : getindexString (gFull prim) s pair.1 = .ok pair.2 := by
      simp [getindexString, getindexInteger, hcheck, hvalidFull, hiterFull,
        bind, Except.bind, pure, Except.pure]
    have hcharEq : charEq toC toD lift pair.2 c = .ok (lastChar == uc) := by
      simp [charEq, hlastCode, huc, JuliaLean.base.char.eq_AbstractChar,
        JuliaLean.base.char.eq_Char, bind, Except.bind, pure, Except.pure]
    by_cases hmatch : lastChar = uc
    · have hSuffix : us.getLast? = some uc := by rw [hLastUs,hmatch]
      have hchar : charEq toC toD lift pair.2 c = .ok true := by
        simpa [hmatch] using hcharEq
      cases before with
      | nil =>
        have hSingle : (first :: rest) = [pair] := by simpa using hSplit
        have hwalkSingle : Walk prim s (int 1) [pair] := by
          rw [← hSingle]
          exact hlaw.walk
        have hPairIndex : pair.1 = int 1 :=
          Affix.walkSingletonIndex prim s hwalkSingle
        have hprevFirst :=
          JuliaLean.Proofs.base.strings.basic.prevind_proven.2.2.2.1
            S R C CU CT E prim (fun i => toString i.val) s (int 1)
            hNcu hmax (by decide)
        have hprev : previndOne (gFull prim) s pair.1 =
            .ok (int 0) := by
          rw [hPairIndex]
          simpa [gFull, modelStringOps] using hprevFirst.2
        let out : Sub.SubString S :=
          ⟨s,JuliaLean.base.strings.substring.zero,
            JuliaLean.base.strings.substring.zero⟩
        have hRange : gRange prim errs s (int 1) (int 0) = .ok out := by
          simpa [out] using Affix.gRangeEmptyAffix prim errs s
        have hView : ViewIterates prim errs out [] := by
          simpa [out] using Affix.emptyViewIteratesAffix prim errs s
        have hcall : call s c = .ok out := by
          simp [call, chopsuffixChar, hEmpty, hlastIndex, hget, hchar,
            firstindexString, hprev, hRange, bind, Except.bind, pure, Except.pure]
        have hExpected : ViewIterates prim errs out
            (if us.getLast? = some uc then
              (charsIn (first :: rest)).take ((first :: rest).length - 1)
              else charsIn (first :: rest)) := by
          simpa [hSuffix, hSingle, charsIn] using hView
        exact ⟨out,by simpa [call] using hcall,rfl,hExpected⟩
      | cons beforeFirst beforeRest =>
        obtain ⟨prevPair,hprevLast⟩ := getLastSome beforeFirst beforeRest
        obtain ⟨beforePrev,hbefore⟩ := Affix.splitLastList hprevLast
        have hSplitAdj : (first :: rest) = beforePrev ++ [prevPair,pair] := by
          rw [hSplit,hbefore]
          simp [List.append_assoc]
        have hprev : previndOne (gFull prim) s pair.1 = .ok prevPair.1 :=
          Affix.lawfulAdjacentPrevAffix prim s (first :: rest) hlaw beforePrev
            prevPair.1 prevPair.2 pair.1 pair.2 [] hSplitAdj
        obtain ⟨out,hRange,hString,hView⟩ :=
          Affix.rangePrefixAffix prim errs s (first :: rest) hlaw beforePrev
            prevPair.1 prevPair.2 [pair] hSplitAdj
        have hViewPrefix : ViewIterates prim errs out
            (charsIn (beforePrev ++ [prevPair])) := by
          simpa using hView
        have hsplitWhole : (first :: rest) = (beforePrev ++ [prevPair]) ++ [pair] := by
          simpa [List.append_assoc] using hSplitAdj
        have hTake : (charsIn (first :: rest)).take ((first :: rest).length - 1) =
            charsIn (beforePrev ++ [prevPair]) := by
          rw [hsplitWhole]
          have hchars : charsIn ((beforePrev ++ [prevPair]) ++ [pair]) =
              charsIn (beforePrev ++ [prevPair]) ++ [pair.2] := by
            simp [charsIn, List.map_append]
          rw [hchars]
          have hlength :
              ((beforePrev ++ [prevPair]) ++ [pair]).length - 1 =
                (charsIn (beforePrev ++ [prevPair])).length := by
            simp [charsIn, List.length_append]
          rw [hlength]
          exact Affix.takeAppendSingleton (charsIn (beforePrev ++ [prevPair])) pair.2
        have hcall : call s c = .ok out := by
          simp [call, chopsuffixChar, hEmpty, hlastIndex, hget, hchar,
            firstindexString, hprev, hRange, bind, Except.bind, pure, Except.pure]
        have hExpected : ViewIterates prim errs out
            (if us.getLast? = some uc then
              (charsIn (first :: rest)).take ((first :: rest).length - 1)
              else charsIn (first :: rest)) := by
          rw [if_pos hSuffix, hTake]
          exact hViewPrefix
        exact ⟨out,by simpa [call] using hcall,hString,hExpected⟩
    · have hNoSuffix : us.getLast? ≠ some uc := by
        rw [hLastUs]
        intro h
        exact hmatch (Option.some.inj h)
      have hchar : charEq toC toD lift pair.2 c = .ok false := by
        rw [hcharEq]
        simp [hmatch, beq_iff_eq]
      have hcall : call s c = .ok wholeOut := by
        simp [call, chopsuffixChar, hEmpty, hlastIndex, hget, hchar,
          hWhole, bind, Except.bind, pure, Except.pure]
      have hExpected : ViewIterates prim errs wholeOut
          (if us.getLast? = some uc then
            (charsIn (first :: rest)).take ((first :: rest).length - 1)
            else charsIn (first :: rest)) := by
        rw [if_neg hNoSuffix]
        exact hWholeView
      exact ⟨wholeOut,by simpa [call] using hcall,hWholeString,hExpected⟩




private theorem segmentSuffix {S R C CU CT E : Type}
    (prim : StringOps S R C CU CT E) (s : S) (terminal : Index) {i : Index}
    {pairs : List (Index × C)} (walk : WalkSegment prim s terminal i pairs)
    (before suffix : List (Index × C)) (hsplit : pairs = before ++ suffix) :
    ∃ j, WalkSegment prim s terminal j suffix := by
  induction before generalizing i pairs with
  | nil => exact ⟨i,by simpa [hsplit] using walk⟩
  | cons p before ih =>
    cases walk with
    | stop atEnd => simp at hsplit
    | @step i j c rest bounds yield advances tail =>
      exact ih tail (List.cons.inj hsplit).2

private theorem viewValidZero {S R C CU CT : Type}
    (prim : StringOps S R C CU CT JlError) (errs : ViewErrors S JlError)
    (s : S) (v : Sub.SubString S) (hparent : v.string = s) (hzero : v.offset.val = 0)
    (k : Index) (hk1 : 1 ≤ k.val) (hkn : k.val ≤ v.ncodeunits.val) :
    (gSubPrim prim errs).isvalid v k = prim.isvalid s k := by
  simp [gSubPrim,Sub.isvalidSubStringAt,viewInBounds,
    JuliaLean.base.strings.basic.checkboundsScalar,hk1,hkn,viewParentIndex,
    zeroOffsetAdd hzero,hparent,bind,Except.bind,pure,Except.pure]

private theorem lstripNestedCorrect {S R C CU CT : Type}
    (prim : StringOps S R C CU CT JlError) (errs : ViewErrors S JlError)
    (f : C → Jl Bool) (s : S) (layout retained after : List (Index × C))
    (law : Lawful prim s layout) (terminal : Index) (v : Sub.SubString S)
    (hsplit : layout = retained ++ after)
    (segment : WalkSegment prim s terminal (int 1) retained)
    (tail : Walk prim s terminal after)
    (hparent : v.string = s) (hzero : v.offset.val = 0)
    (hspan : v.ncodeunits.val + 1 = terminal.val) :
    StripResult prim errs s (leadingRun f (charsIn retained))
      (lstrip (viewStripOps prim errs) f v) := by
  have vlaw := lawfulPrefixView prim errs s layout retained after law terminal v
    hsplit segment tail hparent hzero hspan
  obtain ⟨last,hlast,hlast0,hlastBound,hnil,hbound,hvalid,hinvalid⟩ :=
    lawfulLastIndex (gSubPrim prim errs) v retained vlaw
  change last.val ≤ v.ncodeunits.val at hlastBound
  obtain ⟨first,hfirst,htrace⟩ := lawfulPairsTrace (gSubPrim prim errs) v retained vlaw
  have hvBound : v.ncodeunits.val ≤ (prim.ncodeunits s).val := by
    have hh := walkStartBound prim s tail
    omega
  have hslices : ∀ before suffix, retained = before ++ suffix →
      StripResult prim errs s (.ok (charsIn suffix))
        (some ((viewStripOps prim errs).substring v
          ((suffix.head?.map Prod.fst).getD ((viewStripOps prim errs).addOne last)) last)) := by
    intro before suffix heq
    cases suffix with
    | nil =>
      have hplus : (last + int 1).val = last.val + 1 := by
        apply indexAddOneVal last hlast0
        have hh := walkEndBound (gSubPrim prim errs) v vlaw.walk
        change last.val ≤ v.ncodeunits.val at hlastBound
        change v.ncodeunits.val + 1 ≤ IntTy.max .i64 at hh
        omega
      have hnested := nestedZeroRange prim errs s v (last+int 1) last hparent hzero
        (by intro hh; omega)
      have hrange : gRange prim errs s (last+int 1) last =
          .ok (⟨s,int 0,int 0⟩ : Sub.SubString S) := by
        simp only [gRange,Sub.subStringInt,JuliaLean.base.strings.substring.typedSubString,
          if_pos (show last.val < (last+int 1).val by omega),bind,Except.bind,pure,Except.pure]
        rfl
      refine ⟨⟨s,int 0,int 0⟩,?_,rfl,emptyViewIterates prim errs s⟩
      simpa [viewStripOps,stripOpsOf,hnested] using congrArg some (hnested.trans hrange)
    | cons p rest =>
      rcases p with ⟨i,c⟩
      obtain ⟨start,hw⟩ := segmentSuffix prim s terminal segment before ((i,c)::rest) heq
      obtain ⟨vstart,vw⟩ := walkSuffix (gSubPrim prim errs) v vlaw.walk before ((i,c)::rest) heq
      cases vw with
      | step vb vy va vt =>
        cases hw with
        | step bounds yield advances stail =>
          have hmem : (i,c) ∈ retained := by rw [heq]; simp
          have hne : retained ≠ [] := by intro hh; simp [hh] at hmem
          have hvalidI : prim.isvalid s i = .ok true := by
            have ha : retained.any (fun p => p.1.val == i.val) = true :=
              List.any_eq_true.mpr ⟨(i,c),hmem,by simp⟩
            have hv : (gSubPrim prim errs).isvalid v i = .ok true := by
              simpa [ha] using vlaw.isvalid i vb.1 vb.2
            rw [viewValidZero prim errs s v hparent hzero i vb.1 vb.2] at hv
            exact hv
          have hlastPositive : 1 ≤ last.val := by
            have hh : i.val ≤ last.val := hbound (i,c) hmem
            omega
          have hlastSrc : last.val ≤ (prim.ncodeunits s).val := by
            change last.val ≤ v.ncodeunits.val at hlastBound
            omega
          have hvalidLast : prim.isvalid s last = .ok true := by
            have hv := hvalid hne
            rw [viewValidZero prim errs s v hparent hzero last hlastPositive hlastBound] at hv
            exact hv
          have hnext : nextindOne (gFull prim) s last = .ok terminal := by
            apply nextindOneTo prim s last terminal hlast0 hlastSrc (by omega)
              (walkStartBound prim s tail)
            · intro ht
              cases tail with
              | stop atEnd done => omega
              | @step terminal next d rest bt yt adv wt =>
                have hm : (terminal,d) ∈ layout := by rw [hsplit]; simp
                have ha : layout.any (fun p => p.1.val == terminal.val) = true :=
                  List.any_eq_true.mpr ⟨(terminal,d),hm,by simp⟩
                simpa [ha] using law.isvalid terminal bt.1 bt.2
            · intro k hk hkt
              have hkn : k.val ≤ v.ncodeunits.val := by omega
              have hh := hinvalid k hk hkn
              rw [viewValidZero prim errs s v hparent hzero k (by omega) hkn] at hh
              exact hh
          obtain ⟨out,hrange,hstring,hview⟩ := rangeSegment prim errs s last terminal i c rest
            (WalkSegment.step bounds yield advances stail) (hbound (i,c) hmem)
            hlastSrc hvalidI hvalidLast hnext
          have hnested := nestedZeroRange prim errs s v i last hparent hzero
            (fun _ => ⟨vb.1,hlastBound⟩)
          refine ⟨out,?_,hstring,hview⟩
          simpa [viewStripOps,stripOpsOf] using congrArg some (hnested.trans hrange)
  have htrace' : PairTrace ((viewStripOps prim errs).pairsNext v) first retained := htrace
  have hh := lstripAnyLoopCorrect prim errs (viewStripOps prim errs) f s v last htrace' hslices
  simpa [lstrip,viewStripOps,stripOpsOf,hlast,hfirst] using hh


private theorem stripPredicateCorrect {S R C CU CT : Type}
    (prim : StringOps S R C CU CT JlError) (errs : ViewErrors S JlError)
    (f : C → Jl Bool) (s : S) (layout : List (Index × C))
    (law : Lawful prim s layout) :
    StripResult prim errs s (do leadingRun f (← trailingRun f (charsIn layout)))
      (stripPredicate (stripOps prim errs) (viewStripOps prim errs) f s) := by
  have hright := rstripMaximalRun_proven prim errs f s layout law
  cases hs : trailingRun f (charsIn layout) with
  | error err =>
    have hrun : rstrip (stripOps prim errs) f s = some (.error err) := by
      simpa [StripResult,hs] using hright
    simp [StripResult,hs,stripPredicate,hrun,bind,Except.bind,pure,Except.pure]
  | ok cs =>
    obtain ⟨right,hrun,hparent,hview⟩ :
        ∃ right, rstrip (stripOps prim errs) f s = some (.ok right) ∧
          right.string = s ∧ ViewIterates prim errs right cs := by
      simpa [StripResult,hs] using hright
    obtain ⟨retained,after,terminal,hsplit,hsegment,htail,hparent',hzero,hspan⟩ :=
      rstripPrefixWitness prim errs f s layout law right hrun
    have hretained : ViewIterates prim errs right (charsIn retained) := by
      apply viewIteratesSegment prim errs s right terminal (int 1) retained hsegment hparent
        (by omega) (by omega)
      have hone : (int 1).val = 1 := by decide
      omega
    have hchars : cs = charsIn retained := viewIteratesUnique prim errs right cs
      (charsIn retained) hview hretained
    have hleft := lstripNestedCorrect prim errs f s layout retained after law terminal right
      hsplit hsegment htail hparent' hzero hspan
    simpa [stripPredicate,hrun,hs,hchars,bind,Except.bind,pure,Except.pure] using hleft

theorem stripChars_proven : StripChars := by
  intro S R C CU CT Q prim errs f member set s layout law
  constructor
  · exact stripPredicateCorrect prim errs f s layout law
  · exact stripPredicateCorrect prim errs (fun c => member c set) s layout law


/-! ## Affix removal by character sequence (`chopprefix`, `chopsuffix`) -/

/-- The source side of the `chopprefix`/`chopsuffix` loops: from state `k` with iteration
result `i`, the remaining characters are `cs`, and cutting at `k` gives a result satisfying
`good` for the characters still to come. -/
private inductive AffixSourceTrace {C E R : Type} (iterate : Index → Except E (Option (C × Index)))
    (cut : Index → Except E R) (good : R → List C → Prop) :
    Index → Option (C × Index) → List C → Prop where
  | nil (k : Index) : AffixSourceTrace iterate cut good k none []
  | cons {k next : Index} {c : C} {i : Option (C × Index)} {rest : List C}
      (hcut : ∃ out, cut k = .ok out ∧ good out (c :: rest))
      (hstep : iterate next = .ok i)
      (tail : AffixSourceTrace iterate cut good next i rest) :
      AffixSourceTrace iterate cut good k (some (c, next)) (c :: rest)

private theorem beqFalseOfNe (a b : UInt32) (h : a ≠ b) : (a == b) = false := by
  cases hb : (a == b) with
  | false => rfl
  | true => exact absurd (eq_of_beq hb) h

private theorem chopprefixLoopSpec {S P R C D E : Type}
    (iterateS : S → Index → Except E (Option (C × Index)))
    (iterateP : P → Index → Except E (Option (D × Index)))
    (empty : S → Except E R) (subFrom : S → Index → Except E R) (whole : S → Except E R)
    (equalChar : C → D → Except E Bool)
    (toC : C → CharResult UInt32) (toD : D → CharResult UInt32)
    (heq : ∀ c d uc ud, toC c = .ok uc → toD d = .ok ud → equalChar c d = .ok (uc == ud))
    (s : S) (pre : P) (good : R → List C → Prop) (all : List C)
    (hempty : ∃ out, empty s = .ok out ∧ good out [])
    (hwhole : ∃ out, whole s = .ok out ∧ good out all) :
    ∀ (pcs : List D) (ups : List UInt32) (j : Option (D × Index)) (k : Index)
      (i : Option (C × Index)) (cs : List C) (ucs : List UInt32),
      CharacterTrace (iterateP pre) j pcs → pcs.mapM toD = .ok ups →
      AffixSourceTrace (iterateS s) (subFrom s) good k i cs → cs.mapM toC = .ok ucs →
      ∃ out, WhileTrace (chopprefix.step iterateS iterateP empty subFrom whole equalChar s pre)
        (k, i, j) out ∧ good out (if ups.isPrefixOf ucs then cs.drop pcs.length else all) := by
  intro pcs
  induction pcs with
  | nil =>
    intro ups j k i cs ucs hj hmapP hi hmapS
    have hups : ups = [] := (Except.ok.inj hmapP).symm
    subst hups
    cases hj
    cases hi with
    | nil _ =>
      obtain ⟨out, ho, hg⟩ := hempty
      refine ⟨out, .done ?_, by simpa [List.isPrefixOf] using hg⟩
      simp [chopprefix.step, ho, bind, Except.bind, pure, Except.pure]
    | cons hcut hstep tail =>
      obtain ⟨out, ho, hg⟩ := hcut
      refine ⟨out, .done ?_, by simpa [List.isPrefixOf] using hg⟩
      simp [chopprefix.step, ho, bind, Except.bind, pure, Except.pure]
  | cons d prest ih =>
    intro ups j k i cs ucs hj hmapP hi hmapS
    cases hj with
    | @cons _ nextP j' _ hstepP htailP =>
      obtain ⟨ud, ups', hd, hrestP, hups⟩ := mapM_cons_ok toD d prest hmapP
      subst hups
      cases hi with
      | nil _ =>
        have hucs : ucs = [] := (Except.ok.inj hmapS).symm
        subst hucs
        obtain ⟨out, ho, hg⟩ := hwhole
        refine ⟨out, .done ?_, by simpa [List.isPrefixOf] using hg⟩
        simp [chopprefix.step, ho, bind, Except.bind, pure, Except.pure]
      | @cons _ next c i' rest hcut hstep tail =>
        obtain ⟨uc, ucs', hc, hrestS, hucs⟩ := mapM_cons_ok toC c rest hmapS
        subst hucs
        have hch := heq c d uc ud hc hd
        by_cases hm : ud = uc
        · subst hm
          obtain ⟨out, htrace, hg⟩ := ih ups' j' next i' rest ucs' htailP hrestP tail hrestS
          refine ⟨out, .next ?_ htrace, ?_⟩
          · simp [chopprefix.step, hch, hstep, hstepP, bind, Except.bind, pure, Except.pure]
          · simpa [List.isPrefixOf] using hg
        · have hne1 := beqFalseOfNe uc ud (fun h => hm h.symm)
          have hne2 := beqFalseOfNe ud uc hm
          obtain ⟨out, ho, hg⟩ := hwhole
          refine ⟨out, .done ?_, by simpa [List.isPrefixOf, hne2] using hg⟩
          simp [chopprefix.step, hch, hne1, ho, bind, Except.bind, pure, Except.pure]

private theorem chopsuffixLoopSpec {S RS RP R C D E : Type}
    (iterateS : RS → Index → Except E (Option (C × Index)))
    (iterateP : RP → Index → Except E (Option (D × Index)))
    (empty : S → Except E R) (firstindex : S → Except E Index)
    (through : S → Index → Index → Except E R) (whole : S → Except E R)
    (equalChar : C → D → Except E Bool)
    (toC : C → CharResult UInt32) (toD : D → CharResult UInt32)
    (heq : ∀ c d uc ud, toC c = .ok uc → toD d = .ok ud → equalChar c d = .ok (uc == ud))
    (s : S) (a : RS) (b : RP) (f : Index) (hf : firstindex s = .ok f)
    (good : R → List C → Prop) (all : List C)
    (hempty : ∃ out, empty s = .ok out ∧ good out [])
    (hwhole : ∃ out, whole s = .ok out ∧ good out all) :
    ∀ (pcs : List D) (ups : List UInt32) (j : Option (D × Index)) (k : Index)
      (i : Option (C × Index)) (cs : List C) (ucs : List UInt32),
      CharacterTrace (iterateP b) j pcs → pcs.mapM toD = .ok ups →
      AffixSourceTrace (iterateS a) (fun k => through s f k) good k i cs →
      cs.mapM toC = .ok ucs →
      ∃ out, WhileTrace (chopsuffix.step iterateS iterateP empty firstindex through whole
          equalChar s a b) (k, i, j) out ∧
        good out (if ups.isPrefixOf ucs then cs.drop pcs.length else all) := by
  intro pcs
  induction pcs with
  | nil =>
    intro ups j k i cs ucs hj hmapP hi hmapS
    have hups : ups = [] := (Except.ok.inj hmapP).symm
    subst hups
    cases hj
    cases hi with
    | nil _ =>
      obtain ⟨out, ho, hg⟩ := hempty
      refine ⟨out, .done ?_, by simpa [List.isPrefixOf] using hg⟩
      simp [chopsuffix.step, ho, bind, Except.bind, pure, Except.pure]
    | cons hcut hstep tail =>
      obtain ⟨out, ho, hg⟩ := hcut
      refine ⟨out, .done ?_, by simpa [List.isPrefixOf] using hg⟩
      simp [chopsuffix.step, hf, ho, bind, Except.bind, pure, Except.pure]
  | cons d prest ih =>
    intro ups j k i cs ucs hj hmapP hi hmapS
    cases hj with
    | @cons _ nextP j' _ hstepP htailP =>
      obtain ⟨ud, ups', hd, hrestP, hups⟩ := mapM_cons_ok toD d prest hmapP
      subst hups
      cases hi with
      | nil _ =>
        have hucs : ucs = [] := (Except.ok.inj hmapS).symm
        subst hucs
        obtain ⟨out, ho, hg⟩ := hwhole
        refine ⟨out, .done ?_, by simpa [List.isPrefixOf] using hg⟩
        simp [chopsuffix.step, ho, bind, Except.bind, pure, Except.pure]
      | @cons _ next c i' rest hcut hstep tail =>
        obtain ⟨uc, ucs', hc, hrestS, hucs⟩ := mapM_cons_ok toC c rest hmapS
        subst hucs
        have hch := heq c d uc ud hc hd
        by_cases hm : ud = uc
        · subst hm
          obtain ⟨out, htrace, hg⟩ := ih ups' j' next i' rest ucs' htailP hrestP tail hrestS
          refine ⟨out, .next ?_ htrace, ?_⟩
          · simp [chopsuffix.step, hch, hstep, hstepP, bind, Except.bind, pure, Except.pure]
          · simpa [List.isPrefixOf] using hg
        · have hne1 := beqFalseOfNe uc ud (fun h => hm h.symm)
          have hne2 := beqFalseOfNe ud uc hm
          obtain ⟨out, ho, hg⟩ := hwhole
          refine ⟨out, .done ?_, by simpa [List.isPrefixOf, hne2] using hg⟩
          simp [chopsuffix.step, hch, hne1, ho, bind, Except.bind, pure, Except.pure]

private theorem charEqMapped {C D E : Type} (toC : C → CharResult UInt32)
    (toD : D → CharResult UInt32) (lift : CharError → E) :
    ∀ c d uc ud, toC c = .ok uc → toD d = .ok ud → charEq toC toD lift c d = .ok (uc == ud) := by
  intro c d uc ud hc hd
  simp [charEq, hc, hd, JuliaLean.base.char.eq_AbstractChar,
    JuliaLean.base.char.eq_Char, bind, Except.bind, pure, Except.pure]

private theorem walkIterOk {S R C CU CT E : Type} (prim : StringOps S R C CU CT E) (s : S)
    {k : Index} {l : List (Index × C)} (w : Walk prim s k l) :
    ∃ i, prim.iterateAt s k = .ok i := by
  cases w with
  | stop atEnd done => exact ⟨none, done⟩
  | step bounds yield advances tail => exact ⟨_, yield⟩

private theorem layoutLastFacts {S R C CU CT E : Type} (prim : StringOps S R C CU CT E) (s : S)
    (ls : List (Index × C)) (hlaw : Lawful prim s ls) (pair : Index × C)
    (hlast : ls.getLast? = some pair) :
    (gFull prim).lastindex s = .ok pair.1 ∧ prim.isvalid s pair.1 = .ok true ∧
      (∀ q ∈ ls, q.1.val ≤ pair.1.val) ∧ 1 ≤ pair.1.val ∧
      pair.1.val ≤ (prim.ncodeunits s).val := by
  have hmax := walkEndBound prim s hlaw.walk
  have hFacts := walkLastFacts prim s hlaw.walk pair hlast
  have hbound := hFacts.2.1
  have hlo := hFacts.2.2.1
  have hup := hFacts.2.2.2
  have hpairMem : pair ∈ ls := getLastMem hlast
  have hvalidPair : prim.isvalid s pair.1 = .ok true := by
    have h := hlaw.isvalid pair.1 hlo hup
    have hany : ls.any (fun p => p.1.val == pair.1.val) = true :=
      List.any_eq_true.mpr ⟨pair, hpairMem, by simp⟩
    simpa [hany] using h
  have hvalidLater : ∀ k : Index, pair.1.val < k.val ∧ k.val ≤ (prim.ncodeunits s).val →
      prim.isvalid s k = .ok false := by
    intro k ⟨hgt, hle⟩
    have h := hlaw.isvalid k (by omega) hle
    have hany : ls.any (fun p => p.1.val == k.val) = false := by
      cases hscan : ls.any (fun p => p.1.val == k.val) with
      | false => rfl
      | true =>
        obtain ⟨p, hp, hpk⟩ := List.any_eq_true.mp hscan
        have hple := hbound p hp
        have hpEq : p.1.val = k.val := by simpa using (beq_iff_eq.mp hpk)
        omega
    simpa [hany] using h
  have h := JuliaLean.Proofs.base.strings.basic.thisindInt_rewind
    prim s (prim.ncodeunits s) pair.1 hlo hup (Int.le_refl _) hmax
    (Or.inr hvalidPair) hvalidLater
  refine ⟨?_, hvalidPair, hbound, hlo, hup⟩
  simpa [gFull, JuliaLean.base.strings.basic.modelStringOps,
    JuliaLean.base.strings.basic.lastindexString] using h

/-- `SubString(s, k)` for a character index `k` of a lawful string: a view of `s` whose
characters are those from `k` on. -/
private theorem rangeFromAffix {S R C CU CT E : Type}
    (prim : StringOps S R C CU CT E) (errs : ViewErrors S E)
    (s : S) (layout : List (Index × C)) (law : Lawful prim s layout)
    (before : List (Index × C)) (k : Index) (c : C) (after : List (Index × C))
    (hsplit : layout = before ++ (k, c) :: after) :
    ∃ out, gFrom prim errs s k = .ok out ∧ out.string = s ∧
      ViewIterates prim errs out (charsIn ((k, c) :: after)) := by
  obtain ⟨pair, hlast⟩ : ∃ p, layout.getLast? = some p := by
    cases hl : layout with
    | nil => rw [hl] at hsplit; simp at hsplit
    | cons a t => exact getLastSome a t
  obtain ⟨hlastIndex, hvalidLast, hbound, hlo, hup⟩ :=
    layoutLastFacts prim s layout law pair hlast
  obtain ⟨init, hinit⟩ := Affix.splitLastList hlast
  obtain ⟨next, hnext, htail, hadvance⟩ :=
    Affix.lawfulNextAtAffix prim s layout law init pair.1 pair.2 [] (by simpa using hinit)
  have hnextEnd : next.val = (prim.ncodeunits s).val + 1 := by
    cases htail with
    | stop atEnd done => exact atEnd
  have hmem : (k, c) ∈ layout := by rw [hsplit]; simp
  have hkLast : k.val ≤ pair.1.val := hbound (k, c) hmem
  obtain ⟨start, hw⟩ := walkSuffix prim s law.walk before ((k, c) :: after) hsplit
  cases hw with
  | @step _ j _ _ bounds yield advances wtail =>
    have hvalidK : prim.isvalid s k = .ok true := by
      have ha : layout.any (fun p => p.1.val == k.val) = true :=
        List.any_eq_true.mpr ⟨(k, c), hmem, by simp⟩
      simpa [ha] using law.isvalid k bounds.1 bounds.2
    let out : Sub.SubString S :=
      ⟨s, k - JuliaLean.base.strings.substring.one, next - k⟩
    have hcheck : (gParent prim errs).checkboundsRange s k pair.1 = .ok () := by
      simp [gParent, JuliaLean.base.strings.basic.checkbounds,
        JuliaLean.base.strings.basic.checkboundsRange, unitRangeOps, gFull, modelStringOps,
        show ¬ pair.1.val < k.val by omega, show ¬ k.val < 1 by omega, hup, bind, Except.bind, pure, Except.pure]
    have hcon : JuliaLean.base.strings.substring.typedSubString (gParent prim errs)
        s k pair.1 = .ok out := by
      simp only [JuliaLean.base.strings.substring.typedSubString,
        if_neg (show ¬ pair.1.val < k.val by omega)]
      simp [hcheck,
        show (gParent prim errs).isvalid s k = .ok true from hvalidK,
        show (gParent prim errs).isvalid s pair.1 = .ok true from hvalidLast,
        show (gParent prim errs).nextind s pair.1 = .ok next from hnext,
        out, bind, Except.bind, pure, Except.pure]
    have hspan := typedSubStringViewSpan (gParent prim errs) s k pair.1 next out
      hkLast bounds.1 (by omega) hnext hcon
    have hwalkK : Walk prim s k ((k, c) :: after) := Walk.step bounds yield advances wtail
    refine ⟨out, ?_, rfl, ?_⟩
    · simp [gFrom, Sub.subStringIntegerDefault, hlastIndex, Sub.subStringInt, hcon,
        bind, Except.bind, pure, Except.pure]
    · exact Affix.viewIteratesSegment prim errs s out next k ((k, c) :: after)
        (Affix.fromRound6Segment prim s next (walkSegmentFull prim s next hnextEnd hwalkK))
        rfl (by have hh := hspan.1; omega) hspan.2 hspan.1

private theorem prefixSourceTrace {S R C CU CT E : Type}
    (prim : StringOps S R C CU CT E) (errs : ViewErrors S E) (s : S)
    (ls : List (Index × C)) (hlaw : Lawful prim s ls) :
    ∀ (k : Index) (post : List (Index × C)), Walk prim s k post →
      ∀ (before : List (Index × C)), ls = before ++ post →
      ∃ i, prim.iterateAt s k = .ok i ∧
        AffixSourceTrace (prim.iterateAt s) (gFrom prim errs s)
          (fun out cs => out.string = s ∧ ViewIterates prim errs out cs) k i (charsIn post) := by
  intro k post w
  induction w with
  | @stop k atEnd done =>
    intro _ _
    exact ⟨none, done, AffixSourceTrace.nil k⟩
  | @step k j c rest bounds yield advances tail ih =>
    intro before hsplit
    obtain ⟨i', hi', htr⟩ := ih (before ++ [(k, c)]) (by simp [hsplit])
    obtain ⟨out, ho, hos, hov⟩ := rangeFromAffix prim errs s ls hlaw before k c rest hsplit
    exact ⟨some (c, j), yield, AffixSourceTrace.cons ⟨out, ho, hos, hov⟩ hi' htr⟩

theorem chopPrefixSequence_proven : ChopPrefixSequence := by
  intro S T R1 R2 C D CU1 CU2 CT1 CT2 E prim primP errs toC toD lift s pre ls lp us up
    hlaw hlawP hmapS hmapP
  obtain ⟨j, hj, htraceP⟩ := walkCharacterTrace primP pre hlawP.walk
  have hfirstP : primP.iterateFirst pre = .ok j := hlawP.firstIterate.trans hj
  obtain ⟨i, hi, hsource⟩ :=
    prefixSourceTrace prim errs s ls hlaw (int 1) ls hlaw.walk [] (by simp)
  have hfirstS : prim.iterateFirst s = .ok i := hlaw.firstIterate.trans hi
  obtain ⟨wout, hw, hws, hwv⟩ := Affix.wholeViewIteratesAffix prim errs s ls hlaw
  obtain ⟨out, htrace, hg⟩ := chopprefixLoopSpec prim.iterateAt primP.iterateAt
    (fun s => gRange prim errs s (int 1) (int 0)) (gFrom prim errs) (gWhole prim errs)
    (charEq toC toD lift) toC toD (charEqMapped toC toD lift) s pre
    (fun out cs => out.string = s ∧ ViewIterates prim errs out cs) (charsIn ls)
    ⟨_, Affix.gRangeEmptyAffix prim errs s, rfl, Affix.emptyViewIteratesAffix prim errs s⟩
    ⟨wout, hw, hws, hwv⟩
    (charsIn lp) up j (int 1) i (charsIn ls) us htraceP hmapP hsource hmapS
  have hrun : chopprefix.loop prim.iterateAt primP.iterateAt
      (fun s => gRange prim errs s (int 1) (int 0)) (gFrom prim errs) (gWhole prim errs)
      (charEq toC toD lift) s pre (int 1) i j = some (.ok out) :=
    whileLoop_trace _ htrace
  refine ⟨out, ?_, hg.1, ?_⟩
  · simp only [chopprefix, hfirstS, hfirstP]
    exact hrun
  · have hlen : (charsIn lp).length = lp.length := by simp [charsIn]
    simpa [hlen] using hg.2

/-- The index of the last character of a layout prefix, or `0` for the empty prefix. -/
private def affixLastIndex {C : Type} (pre : List (Index × C)) : Index :=
  match pre.getLast? with
  | some p => p.1
  | none => int 0

private theorem suffixSourceTrace {S R C CU CT E : Type}
    (prim : StringOps S R C CU CT E) (errs : ViewErrors S E) (s : S)
    (ls : List (Index × C)) (hlaw : Lawful prim s ls) :
    ∀ (n : Nat) (pre post : List (Index × C)), ls = pre ++ post → pre.length = n →
      ∃ i, (gRevOps prim).iterateAt (reverseOf s) (affixLastIndex pre) = .ok i ∧
        AffixSourceTrace ((gRevOps prim).iterateAt (reverseOf s))
          (fun k => gRange prim errs s (int 1) k)
          (fun out cs => out.string = s ∧ ViewIterates prim errs out cs.reverse)
          (affixLastIndex pre) i (charsIn pre).reverse := by
  intro n
  induction n with
  | zero =>
    intro pre post _ hlen
    have hpre : pre = [] := List.eq_nil_of_length_eq_zero hlen
    subst hpre
    refine ⟨none, ?_, AffixSourceTrace.nil (int 0)⟩
    have hslt : JuliaLean.base.int.slt_int (int 0) (firstindexString s) = true := by
      rw [JuliaLean.Proofs.base.int.slt_int_eq rfl]
      simp [firstindexString]
    simp [affixLastIndex, gRevOps, gRevIterate, reverseOf, reverseIterateString, hslt]
  | succ n ih =>
    intro pre post hsplit hlen
    obtain ⟨p, hp⟩ : ∃ p, pre.getLast? = some p := by
      cases pre with
      | nil => simp at hlen
      | cons a t => exact getLastSome a t
    obtain ⟨init, hinit⟩ := Affix.splitLastList hp
    subst hinit
    rcases p with ⟨i, c⟩
    have hlenInit : init.length = n := by simp at hlen; omega
    have hsplit' : ls = init ++ (i, c) :: post := by simp [hsplit]
    obtain ⟨i0, hi0, htr⟩ := ih init ((i, c) :: post) hsplit' hlenInit
    have hk : affixLastIndex (init ++ [(i, c)]) = i := by
      simp [affixLastIndex, Affix.getLastAppendSingleton]
    rw [hk]
    have hmem : (i, c) ∈ ls := by rw [hsplit']; simp
    obtain ⟨start, hw⟩ := walkSuffix prim s hlaw.walk init ((i, c) :: post) hsplit'
    cases hw with
    | @step _ j _ _ bounds yield advances wtail =>
      have hncNonneg : 0 ≤ (prim.ncodeunits s).val := by omega
      have hvalidHead : prim.isvalid s i = .ok true := by
        have hany : ls.any (fun p => p.1.val == i.val) = true :=
          List.any_eq_true.mpr ⟨(i, c), hmem, by simp⟩
        simpa [hany] using hlaw.isvalid i bounds.1 bounds.2
      have hget : getindexString (gFull prim) s i = .ok c := by
        have hcheck : (gFull prim).checkbounds s i = .ok () := by
          simp [gFull, modelStringOps, JuliaLean.base.strings.basic.checkbounds,
            JuliaLean.base.strings.basic.checkboundsScalar, bounds.1, bounds.2,
            bind, Except.bind, pure, Except.pure]
        have hvalidFull : (gFull prim).isvalid s i = .ok true := by
          change prim.isvalid s i = .ok true
          exact hvalidHead
        have hiterFull : (gFull prim).iterateAt s i = .ok (some (c, j)) := by
          change prim.iterateAt s i = .ok (some (c, j))
          exact yield
        simp [getindexString, getindexInteger, hcheck, hvalidFull, hiterFull,
          bind, Except.bind, pure, Except.pure]
      have hprev : previndOne (gFull prim) s i = .ok (affixLastIndex init) := by
        cases hlastI : init.getLast? with
        | none =>
          have hnil := getLastNoneEqNil hlastI
          subst hnil
          have hw1 := hlaw.walk
          rw [hsplit'] at hw1
          have hi1 : i = int 1 := by
            cases hw1 with
            | step inBounds yield advances tail => rfl
          have hmax := walkEndBound prim s hlaw.walk
          have hprevFirst :=
            JuliaLean.Proofs.base.strings.basic.prevind_proven.2.2.2.1
              S R C CU CT E prim (fun x => toString x.val) s (int 1)
              hncNonneg hmax (by decide)
          rw [hi1]
          simpa [affixLastIndex, gFull, JuliaLean.base.strings.basic.modelStringOps]
            using hprevFirst.2
        | some q =>
          obtain ⟨init', hinit'⟩ := Affix.splitLastList hlastI
          have hsplit'' : ls = init' ++ (q.1, q.2) :: (i, c) :: post := by
            simp [hsplit', hinit']
          have h := Affix.lawfulAdjacentPrevAffix prim s ls hlaw init' q.1 q.2 i c post hsplit''
          simpa [affixLastIndex, hlastI] using h
      have hslt : JuliaLean.base.int.slt_int i (firstindexString s) = false := by
        rw [JuliaLean.Proofs.base.int.slt_int_eq rfl]
        have hnotlt : ¬ i.val < 1 := by omega
        simp [firstindexString, hnotlt]
      have hstepRev : (gRevOps prim).iterateAt (reverseOf s) i =
          .ok (some (c, affixLastIndex init)) := by
        simp [gRevOps, gRevIterate, reverseOf, reverseIterateString, hslt, hget, hprev]
      obtain ⟨out, ho, hos, hov⟩ :=
        Affix.rangePrefixAffix prim errs s ls hlaw init i c post hsplit'
      have hcs : (charsIn (init ++ [(i, c)])).reverse = c :: (charsIn init).reverse := by
        simp [charsIn]
      rw [hcs]
      exact ⟨some (c, affixLastIndex init), hstepRev,
        AffixSourceTrace.cons ⟨out, ho, hos, by simpa [charsIn] using hov⟩ hi0 htr⟩

private theorem reverseDropReverse {α : Type} (l : List α) (n : Nat) :
    (l.reverse.drop n).reverse = l.take (l.length - n) := by
  first
    | (rw [List.drop_reverse]; simp)
    | (simp [List.reverse_drop])

theorem chopSuffixSequence_proven : ChopSuffixSequence := by
  intro S T R1 R2 C D CU1 CU2 CT1 CT2 E prim primP errs toC toD lift s suf ls lp us up
    hlaw hlawP hmapS hmapP
  obtain ⟨j, hj, htraceP⟩ := reverseLayoutTrace primP suf lp hlawP
  have hmapPR := mapM_reverse_ok toD (charsIn lp) hmapP
  have hmapSR := mapM_reverse_ok toC (charsIn ls) hmapS
  obtain ⟨i, hi, hsource⟩ :=
    suffixSourceTrace prim errs s ls hlaw ls.length ls [] (by simp) rfl
  have hlastK : (gFull prim).lastindex s = .ok (affixLastIndex ls) := by
    cases hp : ls.getLast? with
    | none =>
      have hnil := getLastNoneEqNil hp
      have hw := hlaw.walk
      rw [hnil] at hw
      cases hw with
      | stop atEnd done =>
        have hone : (int 1).val = 1 := by decide
        have hn : (prim.ncodeunits s).val = 0 := by omega
        have hnIndex : prim.ncodeunits s = int 0 := by
          apply Subtype.ext
          simpa using hn
        have hplus : (int 0 + int 1).val = 1 := by decide
        have hlastModel :
            JuliaLean.base.strings.basic.thisindInt prim s (int 0) = .ok (int 0) := by
          simp [JuliaLean.base.strings.basic.thisindInt,
            JuliaLean.base.strings.basic.thisindLoop, hnIndex, hplus]
        have hlast : (gFull prim).lastindex s = .ok (int 0) := by
          simpa [gFull, JuliaLean.base.strings.basic.modelStringOps,
            JuliaLean.base.strings.basic.lastindexString, hnIndex] using hlastModel
        rw [hlast]
        simp [affixLastIndex, hp]
    | some pair =>
      rw [(layoutLastFacts prim s ls hlaw pair hp).1]
      simp [affixLastIndex, hp]
  have hfirstS : (gRevOps prim).iterateFirst (reverseOf s) = .ok i := by
    simpa [gRevOps, gRevIterate, reverseOf, reverseIterateString,
      JuliaLean.base.strings.basic.firstindexString, hlastK] using hi
  obtain ⟨wout, hw, hws, hwv⟩ := Affix.wholeViewIteratesAffix prim errs s ls hlaw
  obtain ⟨out, htrace, hg⟩ := chopsuffixLoopSpec (gRevOps prim).iterateAt
    (gRevOps primP).iterateAt (fun s => gRange prim errs s (int 1) (int 0))
    (fun s => .ok (firstindexString s)) (gRange prim errs) (gWhole prim errs)
    (charEq toC toD lift) toC toD (charEqMapped toC toD lift) s (reverseOf s) (reverseOf suf)
    (int 1) rfl
    (fun out cs => out.string = s ∧ ViewIterates prim errs out cs.reverse) (charsIn ls).reverse
    ⟨_, Affix.gRangeEmptyAffix prim errs s, rfl, Affix.emptyViewIteratesAffix prim errs s⟩
    ⟨wout, hw, hws, by simpa using hwv⟩
    (charsIn lp).reverse up.reverse j (affixLastIndex ls) i (charsIn ls).reverse us.reverse
    htraceP hmapPR hsource hmapSR
  have hrun : chopsuffix.loop (gRevOps prim).iterateAt (gRevOps primP).iterateAt
      (fun s => gRange prim errs s (int 1) (int 0)) (fun s => .ok (firstindexString s))
      (gRange prim errs) (gWhole prim errs) (charEq toC toD lift) s (reverseOf s)
      (reverseOf suf) (affixLastIndex ls) i j = some (.ok out) :=
    whileLoop_trace _ htrace
  refine ⟨out, ?_, hg.1, ?_⟩
  · simp only [chopsuffix, hlastK, hfirstS, hj]
    exact hrun
  · have hview := hg.2
    cases hm : up.reverse.isPrefixOf us.reverse with
    | true =>
      have hlenP : (charsIn lp).reverse.length = lp.length := by simp [charsIn]
      have hlenS : (charsIn ls).length = ls.length := by simp [charsIn]
      rw [hm, if_pos rfl, hlenP, reverseDropReverse, hlenS] at hview
      rw [if_pos rfl]
      exact hview
    | false =>
      rw [hm, if_neg (by decide), List.reverse_reverse] at hview
      rw [if_neg (by decide)]
      exact hview

section SplitSearch
open JuliaLean.base.strings.search (SearchM liftE findnextPredicate findprevPredicate)

theorem sm_bind_ok {E α β : Type} (x : SearchM E α) (f : α → SearchM E β) (a : α)
    (h : x.run = some (.ok a)) : (x >>= f).run = (f a).run := by
  rw [ExceptT.run_bind, h]
  rfl

theorem sm_bind_err {E α β : Type} (x : SearchM E α) (f : α → SearchM E β) (e : E)
    (h : x.run = some (.error e)) : (x >>= f).run = some (.error e) := by
  rw [ExceptT.run_bind, h]
  rfl

theorem liftE_run {E α : Type} (x : Except E α) : (liftE x).run = some x := rfl

/-- The first index of `rest` whose character satisfies `f`, the first exception of `f`, or none. -/
def findSpec {C E : Type} (f : C → Except E Bool) : List (Index × C) → Except E (Option Index)
  | [] => .ok none
  | (i, c) :: rest =>
    match f c with
    | .error e => .error e
    | .ok true => .ok (some i)
    | .ok false => findSpec f rest

theorem walkGetindex {S R C CU CT E : Type} (prim : StringOps S R C CU CT E) (s : S)
    (ls : List (Index × C)) (law : Lawful prim s ls) (before : List (Index × C))
    (i : Index) (c : C) (rest : List (Index × C)) (hsplit : ls = before ++ (i, c) :: rest) :
    getindexString (gFull prim) s i = .ok c ∧ 1 ≤ i.val ∧ i.val ≤ (prim.ncodeunits s).val := by
  obtain ⟨start, hw⟩ := walkSuffix prim s law.walk before ((i, c) :: rest) hsplit
  cases hw with
  | @step _ j _ _ bounds yield advances tail =>
    have hmem : (i, c) ∈ ls := by rw [hsplit]; simp
    have hvalid : prim.isvalid s i = .ok true := by
      have ha : ls.any (fun p => p.1.val == i.val) = true :=
        List.any_eq_true.mpr ⟨(i, c), hmem, by simp⟩
      simpa [ha] using law.isvalid i bounds.1 bounds.2
    refine ⟨?_, bounds.1, bounds.2⟩
    have hcheck : (gFull prim).checkbounds s i = .ok () := by
      simp [gFull, modelStringOps, JuliaLean.base.strings.basic.checkbounds,
        JuliaLean.base.strings.basic.checkboundsScalar, bounds.1, bounds.2,
        bind, Except.bind, pure, Except.pure]
    have hvalidFull : (gFull prim).isvalid s i = .ok true := hvalid
    have hiterFull : (gFull prim).iterateAt s i = .ok (some (c, j)) := yield
    simp [getindexString, getindexInteger, hcheck, hvalidFull, hiterFull,
      bind, Except.bind, pure, Except.pure]

/-- `findnext(f, s, k)`'s scan (search.jl:349-353) over the characters from `k` on. -/
theorem findLoopSpec {S R C CU CT E : Type} (prim : StringOps S R C CU CT E) (s : S)
    (ls : List (Index × C)) (law : Lawful prim s ls) (f : C → Except E Bool) (e : Index)
    (he : ∀ q ∈ ls, q.1.val ≤ e.val) (hen : e.val < (prim.ncodeunits s).val + 1) :
    ∀ (rest : List (Index × C)) (k : Index) (before : List (Index × C)),
      ls = before ++ rest → Walk prim s k rest →
      (JuliaLean.base.strings.search.findnextPredicateLoop (searchOps prim) (fun c => liftE (f c)) s e k).run =
        some (findSpec f rest) := by
  intro rest
  induction rest with
  | nil =>
    intro k before _ hw
    cases hw with
    | stop atEnd done =>
      rw [JuliaLean.base.strings.search.findnextPredicateLoop.eq_1, if_neg (by omega)]
      rfl
  | cons p rest ih =>
    obtain ⟨i, c⟩ := p
    intro k before hsplit hw
    cases hw with
    | @step _ j _ _ bounds yield advances tail =>
      have hmem : (i, c) ∈ ls := by rw [hsplit]; simp
      have hle : i.val ≤ e.val := he (i, c) hmem
      obtain ⟨hget, _, _⟩ := walkGetindex prim s ls law before i c rest hsplit
      rw [JuliaLean.base.strings.search.findnextPredicateLoop.eq_1, if_pos hle]
      rw [sm_bind_ok _ _ c (by rw [liftE_run]; exact congrArg some hget)]
      cases hf : f c with
      | error err =>
        rw [sm_bind_err _ _ err (by rw [liftE_run])]
        simp [findSpec, hf]
      | ok b =>
        rw [sm_bind_ok _ _ b (by rw [liftE_run])]
        cases b with
        | true =>
          simp only [ite_true]
          simp [findSpec, hf]
        | false =>
          simp only [Bool.false_eq_true, ite_false]
          obtain ⟨next, hnext, hwalk, _⟩ :=
            Affix.lawfulNextAtAffix prim s ls law before i c rest hsplit
          rw [sm_bind_ok _ _ next (by rw [liftE_run]; exact congrArg some hnext)]
          rw [ih next (before ++ [(i, c)]) (by simp [hsplit]) hwalk]
          simp [findSpec, hf]

theorem sm_eq_lift {E A : Type} (x : SearchM E A) (r : Except E A)
    (h : x.run = some r) : x = liftE r := h

theorem sm_lift_bind {E A B : Type} (r : Except E A) (f : A → SearchM E B) :
    (liftE r >>= f).run =
      match r with | .ok a => (f a).run | .error e => some (.error e) := by
  cases r <;> rfl

theorem walkLengthBound {S R C CU CT E : Type} (prim : StringOps S R C CU CT E) (s : S)
    {i : Index} {ls : List (Index × C)} (h : Walk prim s i ls) :
    (ls.length : Int) + i.val ≤ (prim.ncodeunits s).val + 1 := by
  induction h with
  | stop atEnd done => simp only [List.length_nil,Int.natCast_zero]; omega
  | step bounds yield advances tail ih => simp only [List.length_cons,Int.natCast_add,Int.natCast_one]; omega

theorem findnextSpec {S R C CU CT E : Type} (prim : StringOps S R C CU CT E) (s : S)
    (ls : List (Index × C)) (law : Lawful prim s ls) (f : C → Except E Bool)
    (rest before : List (Index × C)) (k : Index) (hsplit : ls = before ++ rest)
    (hw : Walk prim s k rest) :
    (findnextPredicate (searchOps prim) indexIntOps (fun c => liftE (f c)) s k).run =
      some (findSpec f rest) := by
  have hlen := walkLengthBound prim s law.walk
  have hone : (int 1).val = 1 := by decide
  have hn : 0 ≤ (prim.ncodeunits s).val := by rw [hone] at hlen; omega
  have hend := walkEndBound prim s law.walk
  have hz : (prim.ncodeunits s + JuliaLean.base.strings.search.int 1).val = (prim.ncodeunits s).val+1 :=
    indexAddOneVal _ hn hend
  have hkb := walkStartBound prim s hw
  obtain ⟨last,hlast,hl0,hlN,_,hbound,_,_⟩ := lawfulLastIndex prim s ls law
  have hloop := findLoopSpec prim s ls law f last hbound (by omega) rest k before hsplit hw
  have hklo : 1 ≤ k.val := by
    cases hw with
    | stop atEnd done => omega
    | step bounds yield advances tail => exact bounds.1
  have hguard : (1 ≤ k.val && k.val ≤ (prim.ncodeunits s+JuliaLean.base.strings.search.int 1).val) = true := by
    simp only [hz,show 1 ≤ k.val from hklo,show k.val ≤ (prim.ncodeunits s).val+1 from hkb,
      decide_true,Bool.true_and]
  unfold findnextPredicate
  rw [sm_bind_ok (liftE (indexIntOps.toInt k)) _ k rfl]
  dsimp only [searchOps]
  rw [if_neg (show ¬(!(decide (1 ≤ k.val) &&
    decide (k.val ≤ (prim.ncodeunits s+JuliaLean.base.strings.search.int 1).val))) = true by
      simp only [hguard,Bool.not_true,Bool.false_eq_true,not_false_eq_true])]
  cases rest with
  | nil =>
    cases hw with
    | stop atEnd done =>
      have hkz : k = prim.ncodeunits s+JuliaLean.base.strings.search.int 1 := Subtype.ext (by rw [hz]; exact atEnd)
      rw [if_neg (show ¬(k != prim.ncodeunits s+JuliaLean.base.strings.search.int 1) = true by simp [hkz])]
      rw [sm_bind_ok (liftE ((gFull prim).lastindex s)) _ last (by rw [liftE_run]; exact congrArg some hlast)]
      exact hloop
  | cons p rest =>
    obtain ⟨i,c⟩ := p
    cases hw with
    | @step _ j _ _ bounds yield advances tail =>
      have hm : (k,c) ∈ ls := by rw [hsplit]; simp
      have hv : prim.isvalid s k = .ok true := by
        have ha : ls.any (fun p => p.1.val == k.val) = true :=
          List.any_eq_true.mpr ⟨(k,c),hm,by simp⟩
        simpa only [ha] using law.isvalid k bounds.1 bounds.2
      have hne : k ≠ prim.ncodeunits s+JuliaLean.base.strings.search.int 1 := by
        intro heq
        have := congrArg Subtype.val heq
        rw [hz] at this
        omega
      rw [if_pos (show (k != prim.ncodeunits s+JuliaLean.base.strings.search.int 1) = true by
        simpa only [bne_iff_ne] using hne)]
      rw [sm_bind_ok (liftE (prim.isvalid s k)) _ true (by rw [liftE_run]; exact congrArg some hv)]
      simp only [Bool.not_true,Bool.false_eq_true,ite_false]
      rw [sm_bind_ok (liftE ((gFull prim).lastindex s)) _ last (by rw [liftE_run]; exact congrArg some hlast)]
      exact hloop

theorem suffixView {S R C CU CT E : Type} (prim : StringOps S R C CU CT E)
    (errs : ViewErrors S E) (s : S) (ls before rest : List (Index × C))
    (law : Lawful prim s ls) (i : Index) (hsplit : ls = before ++ rest)
    (hw : Walk prim s i rest) :
    ∃ out, gFrom prim errs s i = .ok out ∧ out.string = s ∧
      ViewIterates prim errs out (charsIn rest) := by
  cases rest with
  | nil =>
    cases hw with
    | stop atEnd done =>
      obtain ⟨last,hlast,_,hbound,_⟩ := lawfulLastIndex prim s ls law
      let out : Sub.SubString S := ⟨s,JuliaLean.base.strings.substring.zero,JuliaLean.base.strings.substring.zero⟩
      refine ⟨out,?_,rfl,Affix.emptyViewIteratesAffix prim errs s⟩
      simp only [gFrom,Sub.subStringIntegerDefault,hlast,Sub.subStringInt,
        JuliaLean.base.strings.substring.typedSubString,if_pos (show last.val < i.val by omega),
        Bind.bind,Except.bind,Pure.pure,Except.pure,out]
  | cons p rest =>
    obtain ⟨j,c⟩ := p
    cases hw with
    | step bounds yield advances tail =>
      exact rangeFromAffix prim errs s ls law before i c rest hsplit

theorem segmentView {S R C CU CT E : Type} (prim : StringOps S R C CU CT E)
    (errs : ViewErrors S E) (s : S) (ls before part after : List (Index × C))
    (law : Lawful prim s ls) (i q : Index) (c : C)
    (hsplit : ls = before ++ part ++ after) (hw : Walk prim s i (part ++ after))
    (hlast : part.getLast? = some (q,c)) :
    ∃ out, gRange prim errs s i q = .ok out ∧ out.string = s ∧
      ViewIterates prim errs out (charsIn part) := by
  obtain ⟨init,hinit⟩ := Affix.splitLastList hlast
  have hsplitQ : ls = (before ++ init) ++ (q,c) :: after := by
    simp only [hsplit,hinit,List.append_assoc,List.singleton_append]
  obtain ⟨next,hnext,htail,hadvance⟩ := Affix.lawfulNextAtAffix
    prim s ls law (before ++ init) q c after hsplitQ
  obtain ⟨terminal,hsegment,he⟩ := walkSegmentFromPrefix prim s hw part after rfl
  have hterminal : terminal = next :=
    Subtype.ext (he.trans (walkStartValue prim s htail).symm)
  subst terminal
  have hqmem : (q,c) ∈ part ++ after := List.mem_append_left _ (getLastMem hlast)
  have hiq : i.val ≤ q.val := walkIndicesAtLeast prim s i (Int.le_refl _) hw (q,c) hqmem
  have hpart : part ≠ [] := by intro heq; simp [heq] at hlast
  cases part with
  | nil => contradiction
  | cons p rest =>
    obtain ⟨j,d⟩ := p
    cases hw with
    | @step _ j' _ _ bounds yield advances tail =>
      have hmemI : (i,d) ∈ ls := by rw [hsplit]; simp
      have hvI : prim.isvalid s i = .ok true := by
        have ha : ls.any (fun p => p.1.val == i.val) = true :=
          List.any_eq_true.mpr ⟨(i,d),hmemI,by simp⟩
        simpa only [ha] using law.isvalid i bounds.1 bounds.2
      obtain ⟨_,hqlo,hqbound⟩ := walkGetindex prim s ls law (before++init) q c after hsplitQ
      have hvQ : prim.isvalid s q = .ok true := by
        have hmemQ : (q,c) ∈ ls := by rw [hsplitQ]; simp
        have ha : ls.any (fun p => p.1.val == q.val) = true :=
          List.any_eq_true.mpr ⟨(q,c),hmemQ,by simp⟩
        simpa only [ha] using law.isvalid q hqlo hqbound
      let out : Sub.SubString S := ⟨s,i-JuliaLean.base.strings.substring.one,next-i⟩
      have hcheck : (gParent prim errs).checkboundsRange s i q = .ok () := by
        simp [gParent,JuliaLean.base.strings.basic.checkbounds,
          JuliaLean.base.strings.basic.checkboundsRange,unitRangeOps,gFull,modelStringOps,
          show ¬q.val < i.val by omega,show ¬i.val < 1 by omega,hqbound,
          Bind.bind,Except.bind,Pure.pure,Except.pure]
      have hcon : JuliaLean.base.strings.substring.typedSubString (gParent prim errs) s i q = .ok out := by
        simp only [JuliaLean.base.strings.substring.typedSubString,if_neg (show ¬q.val < i.val by omega)]
        simp [hcheck,show (gParent prim errs).isvalid s i = .ok true from hvI,
          show (gParent prim errs).isvalid s q = .ok true from hvQ,
          show (gParent prim errs).nextind s q = .ok next from hnext,
          out,Bind.bind,Except.bind,Pure.pure,Except.pure]
      have hspan := typedSubStringViewSpan (gParent prim errs) s i q next out
        hiq bounds.1 (by omega) hnext hcon
      refine ⟨out,?_,rfl,?_⟩
      · simpa only [gRange,Sub.subStringInt] using hcon
      · exact Affix.viewIteratesSegment prim errs s out next i ((i,d)::rest)
          (Affix.fromRound6Segment prim s next hsegment) rfl
          (by have hh := hspan.1; omega) hspan.2 hspan.1

theorem findSpec_none {C E : Type} (f : C → Except E Bool) (ls : List (Index × C))
    (h : findSpec f ls = .ok none) :
    ∀ p ∈ ls, f p.2 = .ok false := by
  induction ls with
  | nil => simp
  | cons p ps ih =>
    obtain ⟨i,c⟩ := p
    cases hf : f c with
    | error e => simp [findSpec,hf] at h
    | ok b =>
      cases b with
      | true => simp [findSpec,hf] at h
      | false =>
        have ht : findSpec f ps = .ok none := by simpa [findSpec,hf] using h
        intro p hp
        cases hp with
        | head => exact hf
        | tail _ hp => exact ih ht p hp

theorem findSpec_some {C E : Type} (f : C → Except E Bool) (ls : List (Index × C))
    (j : Index) (h : findSpec f ls = .ok (some j)) :
    ∃ before c after, ls = before ++ (j,c) :: after ∧
      (∀ p ∈ before, f p.2 = .ok false) ∧ f c = .ok true := by
  induction ls with
  | nil => simp [findSpec] at h
  | cons p ps ih =>
    obtain ⟨i,c⟩ := p
    cases hf : f c with
    | error e => simp [findSpec,hf] at h
    | ok b =>
      cases b with
      | true =>
        have hij : i = j := by simpa [findSpec,hf] using h
        subst j
        exact ⟨[],c,ps,rfl,by simp,hf⟩
      | false =>
        have ht : findSpec f ps = .ok (some j) := by simpa [findSpec,hf] using h
        obtain ⟨before,d,after,hs,hfalse,htrue⟩ := ih ht
        refine ⟨(i,c)::before,d,after,by rw [hs]; rfl,?_,htrue⟩
        intro p hp
        cases hp with
        | head => exact hf
        | tail _ hp => exact hfalse p hp

theorem findSpec_error {C E : Type} (f : C → Except E Bool) (ls : List (Index × C))
    (e : E) (h : findSpec f ls = .error e) :
    ∃ before i c after, ls = before ++ (i,c) :: after ∧
      (∀ p ∈ before, f p.2 = .ok false) ∧ f c = .error e := by
  induction ls with
  | nil => simp [findSpec] at h
  | cons p ps ih =>
    obtain ⟨i,c⟩ := p
    cases hf : f c with
    | error err =>
      have he : err = e := by simpa [findSpec,hf] using h
      subst err
      exact ⟨[],i,c,ps,rfl,by simp,hf⟩
    | ok b =>
      cases b with
      | true => simp [findSpec,hf] at h
      | false =>
        have ht : findSpec f ps = .error e := by simpa [findSpec,hf] using h
        obtain ⟨before,j,d,after,hs,hfalse,herr⟩ := ih ht
        refine ⟨(i,c)::before,j,d,after,by rw [hs]; rfl,?_,herr⟩
        intro p hp
        cases hp with
        | head => exact hf
        | tail _ hp => exact hfalse p hp

theorem splitSpecE_skip {C E : Type} (f : C → Except E Bool) (keep scan : Bool)
    (k : Nat) (before acc rest : List C) (hscan : scan = true ∨ k ≠ 1)
    (hfalse : ∀ c ∈ before, f c = .ok false) :
    splitSpecE f keep scan k acc (before ++ rest) =
      splitSpecE f keep scan k (before.reverse ++ acc) rest := by
  induction before generalizing acc with
  | nil => rfl
  | cons c cs ih =>
    have hc := hfalse c (by simp)
    have htail : ∀ c ∈ cs, f c = .ok false := by
      intro d hd; exact hfalse d (by simp [hd])
    have hguard : ¬(k = 1 && !scan) = true := by rcases hscan with h | h <;> simp [h]
    simp only [List.cons_append,splitSpecE,if_neg hguard,hc]
    rw [ih (c::acc) htail]
    simp only [List.reverse_cons,List.append_assoc,List.singleton_append]

theorem splitSpecE_noHit {C E : Type} (f : C → Except E Bool) (keep scan : Bool)
    (k : Nat) (acc rest : List C) (hfalse : ∀ c ∈ rest, f c = .ok false) :
    splitSpecE f keep scan k acc rest =
      (if !keep && (acc.reverse ++ rest).isEmpty then [] else [acc.reverse ++ rest],none) := by
  induction rest generalizing acc with
  | nil => simp [splitSpecE]
  | cons c cs ih =>
    have hc := hfalse c (by simp)
    have htail : ∀ c ∈ cs, f c = .ok false := by
      intro d hd; exact hfalse d (by simp [hd])
    rw [splitSpecE]
    split
    · simp
    · rw [hc,ih (c::acc) htail]
      simp [List.reverse_cons,List.append_assoc]

theorem delimiterView {S R C CU CT E : Type} (prim : StringOps S R C CU CT E)
    (errs : ViewErrors S E) (s : S) (ls before part after : List (Index × C))
    (law : Lawful prim s ls) (i j : Index) (c : C)
    (hsplit : ls = before ++ part ++ (j,c) :: after)
    (hw : Walk prim s i (part ++ (j,c) :: after)) :
    ∃ prev out, previndOne (gFull prim) s j = .ok prev ∧
      gRange prim errs s i prev = .ok out ∧ out.string = s ∧
      ViewIterates prim errs out (charsIn part) := by
  cases part with
  | nil =>
    cases hw with
    | step bounds yield advances tail =>
      obtain ⟨prev,hprev,hlt⟩ : ∃ prev,
          previndOne (gFull prim) s i = .ok prev ∧ prev.val < i.val := by
        cases before with
        | nil =>
          have hwalk : Walk prim s (int 1) ((i,c)::after) := by
            simpa only [hsplit,List.nil_append] using law.walk
          have hi : i = int 1 := Subtype.ext (walkStartValue prim s hwalk).symm
          have hlen := walkLengthBound prim s law.walk
          have hone : (int 1).val = 1 := by decide
          have hn : 0 ≤ (prim.ncodeunits s).val := by rw [hone] at hlen; omega
          have hp := JuliaLean.Proofs.base.strings.basic.prevind_proven.2.2.2.1
            S R C CU CT E prim (fun x => toString x.val) s (int 1) hn
            (walkEndBound prim s law.walk) (by rw [hone]; omega)
          refine ⟨int 0,?_,?_⟩
          · simpa only [hi,gFull] using hp.2
          · rw [hi]; decide
        | cons p ps =>
          obtain ⟨last,hlast⟩ := getLastSome p ps
          obtain ⟨init,hinit⟩ := Affix.splitLastList hlast
          have hs : ls = init ++ last :: (i,c)::after := by
            simpa only [List.nil_append,List.append_nil,hinit,List.append_assoc,
              List.singleton_append] using hsplit
          have hp := Affix.lawfulAdjacentPrevAffix prim s ls law init
            last.1 last.2 i c after hs
          have hlt := walkSplitEarlier prim s law.walk (p::ps) i c after
            (by simpa using hsplit) last (getLastMem hlast)
          exact ⟨last.1,hp,hlt⟩
      let out : Sub.SubString S := ⟨s,JuliaLean.base.strings.substring.zero,
        JuliaLean.base.strings.substring.zero⟩
      refine ⟨prev,out,hprev,?_,rfl,Affix.emptyViewIteratesAffix prim errs s⟩
      simp only [gRange,Sub.subStringInt,JuliaLean.base.strings.substring.typedSubString,
        if_pos hlt,Bind.bind,Except.bind,Pure.pure,Except.pure,out]
  | cons p ps =>
    obtain ⟨last,hlast⟩ := getLastSome p ps
    obtain ⟨init,hinit⟩ := Affix.splitLastList hlast
    have hs : ls = (before++init) ++ last :: (j,c)::after := by
      simp only [hsplit,hinit,List.append_assoc,List.singleton_append]
    have hp := Affix.lawfulAdjacentPrevAffix prim s ls law (before++init)
      last.1 last.2 j c after hs
    obtain ⟨out,hr,hparent,hview⟩ := segmentView prim errs s ls before (p::ps)
      ((j,c)::after) law i last.1 last.2 hsplit hw hlast
    exact ⟨last.1,out,hp,hr,hparent,hview⟩

theorem indexSubOneVal (i : Index) (hi : 1 ≤ i.val) :
    (i-int 1).val = i.val-1 := by
  have hb := i.property
  have hone : (int 1).val = 1 := by decide
  change wrapInt .i64 (i.val-(int 1).val) = _
  rw [hone]
  exact wrapInt_of_inRange .i64 (i.val-1) ⟨by
    change -9223372036854775808 ≤ i.val-1
    omega,by omega⟩

theorem splitTailStops (n : Index) (hn : 0 ≤ n.val)
    (hmax : n.val+1 ≤ IntTy.max .i64) :
    n.val < ((n+int 2)-int 1).val := by
  have hone : (int 1).val = 1 := by decide
  have htwo : (int 2).val = 2 := by decide
  change n.val < wrapInt .i64 (wrapInt .i64 (n.val+(int 2).val)-(int 1).val)
  rw [JuliaLean.Proofs.base.int.wrapInt_sub_left,hone,htwo,
    show n.val+2-1 = n.val+1 by omega,
    wrapInt_of_inRange .i64 (n.val+1) ⟨by
      change -9223372036854775808 ≤ n.val+1
      omega,hmax⟩]
  omega

theorem splitCountAtLimit (limit : Index) (n : Int) (k : Nat)
    (hn : 0 ≤ n) (hnmax : n < IntTy.max .i64)
    (hbudget : (limit.val ≤ 0 ∧ k = 0) ∨
      (0 < limit.val ∧ n+(k:Int) = limit.val ∧ 1 ≤ k)) :
    n = (limit-int 1).val ↔ k = 1 := by
  have hb := limit.property
  have hone : (int 1).val = 1 := by decide
  by_cases hmin : limit.val = -9223372036854775808
  · have hv : (limit-int 1).val = 9223372036854775807 := by
      change wrapInt .i64 (limit.val-(int 1).val) = _
      rw [hmin,hone]
      decide
    rw [hv]
    rcases hbudget with ⟨_,rfl⟩ | ⟨hp,_,_⟩ <;>
      change n < 9223372036854775807 at hnmax <;> omega
  · have hv : (limit-int 1).val = limit.val-1 := by
      change wrapInt .i64 (limit.val-(int 1).val) = _
      rw [hone]
      apply wrapInt_of_inRange
      constructor
      · change -9223372036854775808 ≤ limit.val-1
        change -9223372036854775808 ≤ limit.val ∧ limit.val ≤ 9223372036854775807 at hb
        omega
      · omega
    rw [hv]
    rcases hbudget with ⟨_,rfl⟩ | ⟨_,_,_⟩ <;> omega

theorem predFindnextE_lift {S R C CU CT E : Type} (prim : StringOps S R C CU CT E)
    (s : S) (ls before rest : List (Index × C)) (law : Lawful prim s ls)
    (f : C → Except E Bool) (i : Index) (hsplit : ls = before ++ rest)
    (hw : Walk prim s i rest) :
    predFindnextE prim f s i =
      liftE ((findSpec f rest).map (fun r => r.map (fun j => (j,j)))) := by
  unfold predFindnextE
  rw [sm_eq_lift _ _ (findnextSpec prim s ls law f rest before i hsplit hw)]
  cases findSpec f rest <;> rfl

theorem emits_step_eq {R St E : Type}
    (step : Option St → Option (Except E (Option (R × St))))
    (a b : Option St) (pieces : List R) (h : step a = step b) :
    Emits step b pieces → Emits step a pieces := by
  intro ht
  cases ht with
  | done hd => exact .done (h.trans hd)
  | emit he tail => exact .emit (h.trans he) tail

theorem emitsFail_step_eq {R St E : Type}
    (step : Option St → Option (Except E (Option (R × St))))
    (a b : Option St) (pieces : List R) (e : E) (h : step a = step b) :
    EmitsFail step b pieces e → EmitsFail step a pieces e := by
  intro ht
  cases ht with
  | fail hd => exact .fail (h.trans hd)
  | emit he tail => exact .emit (h.trans he) tail

def ViewedOutput {S R C CU CT E St : Type} (prim : StringOps S R C CU CT E)
    (errs : ViewErrors S E)
    (step : Option St → Option (Except E (Option (Sub.SubString S × St))))
    (st : Option St) (value : List (List C) × Option E) : Prop :=
  ∃ pieces, ViewsIterate prim errs pieces value.1 ∧
    match value.2 with
    | none => Emits step st pieces
    | some e => EmitsFail step st pieces e

theorem viewedOutput_done {S R C CU CT E St : Type} (prim : StringOps S R C CU CT E)
    (errs : ViewErrors S E)
    (step : Option St → Option (Except E (Option (Sub.SubString S × St))))
    (st : Option St) (h : step st = some (.ok none)) :
    ViewedOutput prim errs step st ([],none) :=
  ⟨[],.nil,.done h⟩

theorem viewedOutput_error {S R C CU CT E St : Type} (prim : StringOps S R C CU CT E)
    (errs : ViewErrors S E)
    (step : Option St → Option (Except E (Option (Sub.SubString S × St))))
    (st : Option St) (e : E) (h : step st = some (.error e)) :
    ViewedOutput prim errs step st ([],some e) :=
  ⟨[],.nil,.fail h⟩

theorem viewedOutput_emit {S R C CU CT E St : Type} (prim : StringOps S R C CU CT E)
    (errs : ViewErrors S E)
    (step : Option St → Option (Except E (Option (Sub.SubString S × St))))
    (st : Option St) (out : Sub.SubString S) (next : St) (cs : List C)
    (value : List (List C) × Option E)
    (h : step st = some (.ok (some (out,next)))) (hv : ViewIterates prim errs out cs)
    (ht : ViewedOutput prim errs step (some next) value) :
    ViewedOutput prim errs step st (cs::value.1,value.2) := by
  obtain ⟨pieces,hpieces,htrace⟩ := ht
  refine ⟨out::pieces,.cons hv hpieces,?_⟩
  cases he : value.2 with
  | none =>
    simp only [he] at htrace ⊢
    exact .emit h htrace
  | some e =>
    simp only [he] at htrace ⊢
    exact .emit h htrace

theorem viewedOutput_step_eq {S R C CU CT E St : Type} (prim : StringOps S R C CU CT E)
    (errs : ViewErrors S E)
    (step : Option St → Option (Except E (Option (Sub.SubString S × St))))
    (a b : Option St) (value : List (List C) × Option E) (h : step a = step b)
    (ht : ViewedOutput prim errs step b value) :
    ViewedOutput prim errs step a value := by
  obtain ⟨pieces,hpieces,htrace⟩ := ht
  refine ⟨pieces,hpieces,?_⟩
  cases he : value.2 with
  | none =>
    simp only [he] at htrace ⊢
    exact emits_step_eq step a b pieces h htrace
  | some e =>
    simp only [he] at htrace ⊢
    exact emitsFail_step_eq step a b pieces e h htrace

def forwardStep {S R C CU CT E F : Type} (prim : StringOps S R C CU CT E)
    (errs : ViewErrors S E) (s : S)
    (findnext : F → S → Index → JuliaLean.base.strings.search.SearchM E (Option (Index × Index)))
    (splitter : F) (limit : Index) (keep : Bool) (st : Option SplitState) :=
  (iterateSplit (splitOps prim errs) findnext
    (⟨s,splitter,limit,keep⟩ : SplitIteratorModel S F) st).run

theorem splitStepE_start {S R C CU CT E F : Type} (prim : StringOps S R C CU CT E)
    (errs : ViewErrors S E) (s : S) (f : C → Except E Bool)
    (findnext : F → S → Index → JuliaLean.base.strings.search.SearchM E (Option (Index × Index)))
    (splitter : F) (hsearch : ∀ i, findnext splitter s i = predFindnextE prim f s i) (limit : Index) (keep : Bool) :
    forwardStep prim errs s findnext splitter limit keep none =
      forwardStep prim errs s findnext splitter limit keep (some (int 1,int 1,int 0)) := by
  rfl

theorem splitStepE_stop {S R C CU CT E F : Type} (prim : StringOps S R C CU CT E)
    (errs : ViewErrors S E) (s : S) (f : C → Except E Bool)
    (findnext : F → S → Index → JuliaLean.base.strings.search.SearchM E (Option (Index × Index)))
    (splitter : F) (hsearch : ∀ i, findnext splitter s i = predFindnextE prim f s i) (limit : Index) (keep : Bool)
    (i k n : Index) (hstop : (i-int 1).val > (prim.ncodeunits s).val) :
    forwardStep prim errs s findnext splitter limit keep (some (i,k,n)) = some (.ok none) := by
  simp only [forwardStep,iterateSplit,pure_bind,splitOps,sm_lift_bind,if_pos hstop]
  rfl

theorem splitStepE_at {S R C CU CT E F : Type} (prim : StringOps S R C CU CT E)
    (errs : ViewErrors S E) (s : S) (f : C → Except E Bool)
    (findnext : F → S → Index → JuliaLean.base.strings.search.SearchM E (Option (Index × Index)))
    (splitter : F) (hsearch : ∀ i, findnext splitter s i = predFindnextE prim f s i) (limit : Index) (keep : Bool)
    (i n : Index) (hlo : 1 ≤ i.val) (hhi : i.val ≤ (prim.ncodeunits s).val+1) :
    forwardStep prim errs s findnext splitter limit keep (some (i,i,n)) =
      (do
        let r ← findnext splitter s i
        iterateSplitLoop (splitOps prim errs) findnext
          (⟨s,splitter,limit,keep⟩ : SplitIteratorModel S F) i i n r).run := by
  simp only [forwardStep,iterateSplit,pure_bind,splitOps,sm_lift_bind,
    indexSubOneVal i hlo,if_neg (show ¬i.val-1 > (prim.ncodeunits s).val by omega)]

theorem splitStepE_error {S R C CU CT E F : Type} (prim : StringOps S R C CU CT E)
    (errs : ViewErrors S E) (s : S) (ls before rest : List (Index × C))
    (law : Lawful prim s ls) (f : C → Except E Bool)
    (findnext : F → S → Index → JuliaLean.base.strings.search.SearchM E (Option (Index × Index)))
    (splitter : F) (hsearch : ∀ i, findnext splitter s i = predFindnextE prim f s i) (limit : Index) (keep : Bool)
    (i n : Index) (hsplit : ls = before ++ rest) (hw : Walk prim s i rest)
    (hlo : 1 ≤ i.val) (e : E) (hfind : findSpec f rest = .error e) :
    forwardStep prim errs s findnext splitter limit keep (some (i,i,n)) = some (.error e) := by
  rw [splitStepE_at prim errs s f findnext splitter hsearch limit keep i n hlo (walkStartBound prim s hw),hsearch i,
    predFindnextE_lift prim s ls before rest law f i hsplit hw,hfind]
  rfl

theorem splitStepE_hit {S R C CU CT E F : Type} (prim : StringOps S R C CU CT E)
    (errs : ViewErrors S E) (s : S) (ls before rest : List (Index × C))
    (law : Lawful prim s ls) (f : C → Except E Bool)
    (findnext : F → S → Index → JuliaLean.base.strings.search.SearchM E (Option (Index × Index)))
    (splitter : F) (hsearch : ∀ i, findnext splitter s i = predFindnextE prim f s i) (limit : Index) (keep : Bool)
    (i j next prev n : Index) (out : Sub.SubString S)
    (hsplit : ls = before ++ rest) (hw : Walk prim s i rest) (hlo : 1 ≤ i.val)
    (hfind : findSpec f rest = .ok (some j)) (hcount : n.val ≠ (limit-int 1).val)
    (hj : j.val ≤ (prim.ncodeunits s).val)
    (hnext : nextindOne (gFull prim) s j = .ok next) (hadvance : j.val < next.val)
    (hij : i.val ≤ j.val) (hprev : previndOne (gFull prim) s j = .ok prev)
    (hview : gRange prim errs s i prev = .ok out)
    (hkeep : (keep || decide (i.val < j.val)) = true) :
    forwardStep prim errs s findnext splitter limit keep (some (i,i,n)) =
      some (.ok (some (out,(next,next,n+int 1)))) := by
  rw [splitStepE_at prim errs s f findnext splitter hsearch limit keep i n hlo (walkStartBound prim s hw),hsearch i,
    predFindnextE_lift prim s ls before rest law f i hsplit hw,hfind]
  simp only [Except.map,Option.map,sm_lift_bind]
  rw [iterateSplitLoop.eq_def]
  simp only [if_neg hcount,splitOps,sm_lift_bind,
    if_neg (show ¬j.val > (prim.ncodeunits s).val by omega),hnext,
    if_neg (show ¬next.val ≤ j.val by omega),pure_bind,
    if_pos (show i.val < next.val by omega),hprev,hview,hkeep,ite_true]
  rfl

theorem splitLoop_tail {S R F E : Type} (ops : SplitStringOps S R E)
    (findnext : F → S → Index → SearchM E (Option (Index × Index)))
    (iter : SplitIteratorModel S F) (i k n : Index) (r : Option (Index × Index))
    (h : r = none ∨ n.val = (iter.limit-int 1).val) :
    iterateSplitLoop ops findnext iter i k n r = liftE (splitTail ops iter i k n) := by
  rw [iterateSplitLoop.eq_def]
  cases r with
  | none => rfl
  | some p =>
    have hn : n.val = (iter.limit-int 1).val := h.resolve_left (by simp)
    simp only [if_pos hn]

theorem splitStepE_tail {S R C CU CT E F : Type} (prim : StringOps S R C CU CT E)
    (errs : ViewErrors S E) (s : S) (ls before rest : List (Index × C))
    (law : Lawful prim s ls) (f : C → Except E Bool)
    (findnext : F → S → Index → JuliaLean.base.strings.search.SearchM E (Option (Index × Index)))
    (splitter : F) (hsearch : ∀ i, findnext splitter s i = predFindnextE prim f s i) (limit : Index) (keep : Bool)
    (i n : Index) (hsplit : ls = before ++ rest) (hw : Walk prim s i rest)
    (hlo : 1 ≤ i.val) (r : Option Index) (hfind : findSpec f rest = .ok r)
    (htail : r = none ∨ n.val = (limit-int 1).val) :
    forwardStep prim errs s findnext splitter limit keep (some (i,i,n)) =
      some (splitTail (splitOps prim errs)
        (⟨s,splitter,limit,keep⟩ : SplitIteratorModel S F) i i n) := by
  rw [splitStepE_at prim errs s f findnext splitter hsearch limit keep i n hlo (walkStartBound prim s hw),hsearch i,
    predFindnextE_lift prim s ls before rest law f i hsplit hw,hfind]
  simp only [Except.map,sm_lift_bind]
  rw [splitLoop_tail _ _ _ i i n _ (by
    rcases htail with h | h
    · left; simp [h]
    · exact Or.inr h)]
  rfl

theorem splitTailViewed {S R C CU CT E F : Type} (prim : StringOps S R C CU CT E)
    (errs : ViewErrors S E) (s : S) (ls before rest : List (Index × C))
    (law : Lawful prim s ls) (f : C → Except E Bool)
    (findnext : F → S → Index → JuliaLean.base.strings.search.SearchM E (Option (Index × Index)))
    (splitter : F) (hsearch : ∀ i, findnext splitter s i = predFindnextE prim f s i) (limit : Index) (keep : Bool)
    (st : Option SplitState) (i k n : Index)
    (hsplit : ls = before ++ rest) (hw : Walk prim s i rest)
    (hstep : forwardStep prim errs s findnext splitter limit keep st =
      some (splitTail (splitOps prim errs)
        (⟨s,splitter,limit,keep⟩ : SplitIteratorModel S F) i k n)) :
    ViewedOutput prim errs (forwardStep prim errs s findnext splitter limit keep) st
      (if !keep && rest.isEmpty then [] else [charsIn rest],none) := by
  obtain ⟨out,hout,hparent,hview⟩ := suffixView prim errs s ls before rest law i hsplit hw
  have hlen := walkLengthBound prim s law.walk
  have hone : (int 1).val = 1 := by decide
  have hn : 0 ≤ (prim.ncodeunits s).val := by rw [hone] at hlen; omega
  have hdone := viewedOutput_done prim errs (forwardStep prim errs s findnext splitter limit keep)
    (some (prim.ncodeunits s+int 2,k,n+int 1))
    (splitStepE_stop prim errs s f findnext splitter hsearch limit keep _ k _ (splitTailStops _ hn
      (walkEndBound prim s law.walk)))
  have htail : splitTail (splitOps prim errs)
      (⟨s,splitter,limit,keep⟩ : SplitIteratorModel S F) i k n =
      .ok (if !keep && decide (i.val > (prim.ncodeunits s).val) then none
        else some (out,(prim.ncodeunits s+int 2,k,n+int 1))) := by
    simp [splitTail,splitOps,hout,Bind.bind,Except.bind,Pure.pure,Except.pure]
    split <;> rfl
  rw [htail] at hstep
  cases rest with
  | nil =>
    cases hw with
    | stop atEnd done =>
      cases keep with
      | false =>
        simp only [Bool.not_false,Bool.true_and,decide_eq_true (show i.val > (prim.ncodeunits s).val by omega),
          ite_true] at hstep
        exact viewedOutput_done prim errs _ st hstep
      | true =>
        simp only [Bool.not_true,Bool.false_and,ite_false] at hstep
        exact viewedOutput_emit prim errs _ st out _ [] ([],none) hstep hview hdone
  | cons p ps =>
    cases hw with
    | step bounds yield advances tail =>
      have hdrop : decide (i.val > (prim.ncodeunits s).val) = false := by
        simp only [decide_eq_false_iff_not]
        omega
      simp only [hdrop,Bool.and_false,ite_false] at hstep
      simpa only [List.isEmpty_cons,Bool.and_false,Bool.false_eq_true,ite_false] using
        viewedOutput_emit prim errs _ st out _ _ ([],none) hstep hview hdone

theorem splitStepE_skip {S R C CU CT E F : Type} (prim : StringOps S R C CU CT E)
    (errs : ViewErrors S E) (s : S) (ls before rest : List (Index × C))
    (law : Lawful prim s ls) (f : C → Except E Bool)
    (findnext : F → S → Index → JuliaLean.base.strings.search.SearchM E (Option (Index × Index)))
    (splitter : F) (hsearch : ∀ i, findnext splitter s i = predFindnextE prim f s i) (limit : Index)
    (i next prev n : Index) (out : Sub.SubString S)
    (hsplit : ls = before ++ rest) (hw : Walk prim s i rest) (hlo : 1 ≤ i.val)
    (hfind : findSpec f rest = .ok (some i)) (hcount : n.val ≠ (limit-int 1).val)
    (hi : i.val ≤ (prim.ncodeunits s).val)
    (hnext : nextindOne (gFull prim) s i = .ok next) (hadvance : i.val < next.val)
    (hnextBound : next.val ≤ (prim.ncodeunits s).val+1)
    (hprev : previndOne (gFull prim) s i = .ok prev)
    (hview : gRange prim errs s i prev = .ok out) :
    forwardStep prim errs s findnext splitter limit false (some (i,i,n)) =
      forwardStep prim errs s findnext splitter limit false (some (next,next,n)) := by
  rw [splitStepE_at prim errs s f findnext splitter hsearch limit false i n hlo (walkStartBound prim s hw),hsearch i,
    predFindnextE_lift prim s ls before rest law f i hsplit hw,hfind]
  simp only [Except.map,Option.map,sm_lift_bind]
  rw [iterateSplitLoop.eq_def]
  simp only [if_neg hcount,splitOps,sm_lift_bind,if_neg (show ¬i.val > (prim.ncodeunits s).val by omega),
    hnext,if_neg (show ¬next.val ≤ i.val by omega),pure_bind,if_pos hadvance,
    hprev,hview,Int.lt_irrefl,decide_false,Bool.false_or,Bool.false_eq_true,ite_false]
  rw [splitStepE_at prim errs s f findnext splitter hsearch limit false next n (by omega) hnextBound]
  rfl

theorem walkPrefixLengthBound {S R C CU CT E : Type} (prim : StringOps S R C CU CT E)
    (s : S) (before after : List (Index × C)) (i : Index)
    (hw : Walk prim s i (before ++ after)) :
    (before.length : Int)+i.val ≤ segmentEnd (prim.ncodeunits s) after := by
  induction before generalizing i with
  | nil => simpa only [List.nil_append,List.length_nil,Int.natCast_zero,Int.zero_add] using
      (Int.le_of_eq (walkStartValue prim s hw))
  | cons p ps ih =>
    cases hw with
    | step bounds yield advances tail =>
      have ht := ih _ tail
      simp only [List.length_cons,Int.natCast_add,Int.natCast_one]
      omega

theorem charsFalse {C E : Type} (f : C → Except E Bool) (pairs : List (Index × C))
    (hfalse : ∀ p ∈ pairs, f p.2 = .ok false) :
    ∀ c ∈ charsIn pairs, f c = .ok false := by
  intro c hc
  obtain ⟨p,hp,rfl⟩ := List.mem_map.mp hc
  exact hfalse p hp

theorem splitSpecE_hit {C E : Type} (f : C → Except E Bool) (keep : Bool) (k : Nat)
    (before after : List C) (c : C) (hfalse : ∀ d ∈ before, f d = .ok false)
    (hc : f c = .ok true) :
    splitSpecE f keep true k [] (before ++ c::after) =
      if k = 1 then ([before ++ c::after],none)
      else if !keep && before.isEmpty then splitSpecE f keep true k [] after
      else let tail := splitSpecE f keep true (k-1) [] after
        (before::tail.1,tail.2) := by
  rw [splitSpecE_skip f keep true k before [] (c::after) (Or.inl rfl) hfalse]
  simp [splitSpecE,hc]

theorem splitSpecE_error {C E : Type} (f : C → Except E Bool) (keep : Bool) (k : Nat)
    (before after : List C) (c : C) (e : E) (hfalse : ∀ d ∈ before, f d = .ok false)
    (hc : f c = .error e) :
    splitSpecE f keep true k [] (before ++ c::after) = ([],some e) := by
  rw [splitSpecE_skip f keep true k before [] (c::after) (Or.inl rfl) hfalse]
  simp [splitSpecE,hc]

theorem splitForwardAll {S R C CU CT E F : Type} (prim : StringOps S R C CU CT E)
    (errs : ViewErrors S E) (s : S) (ls : List (Index × C)) (law : Lawful prim s ls)
    (f : C → Except E Bool)
    (findnext : F → S → Index → JuliaLean.base.strings.search.SearchM E (Option (Index × Index)))
    (splitter : F) (hsearch : ∀ i, findnext splitter s i = predFindnextE prim f s i) (limit : Index) (keep : Bool) :
    ∀ (m : Nat) (rest before : List (Index × C)) (i n : Index) (k : Nat),
    rest.length = m → ls = before ++ rest → Walk prim s i rest →
    0 ≤ n.val → n.val ≤ (before.length : Int) →
    ((limit.val ≤ 0 ∧ k = 0) ∨ (0 < limit.val ∧ n.val+(k:Int) = limit.val ∧ 1 ≤ k)) →
    ViewedOutput prim errs (forwardStep prim errs s findnext splitter limit keep) (some (i,i,n))
      (splitSpecE f keep true k [] (charsIn rest)) := by
  intro m
  induction m using Nat.strongRecOn with
  | ind m ih =>
    intro rest before i n k hlen hsplit hw hn hnb hbudget
    have hone : (int 1).val = 1 := by decide
    have hlenAll := walkLengthBound prim s law.walk
    rw [hone] at hlenAll
    have hncu : 0 ≤ (prim.ncodeunits s).val := by omega
    have hbound := walkEndBound prim s law.walk
    have hbefore : before.length ≤ ls.length := by rw [hsplit,List.length_append]; omega
    have hnmax : n.val < IntTy.max .i64 := by omega
    have hcount := splitCountAtLimit limit n.val k hn hnmax hbudget
    have hlo : 1 ≤ i.val := by
      cases hw with
      | stop atEnd done => omega
      | step bounds yield advances tail => exact bounds.1
    cases hfind : findSpec f rest with
    | error e =>
      obtain ⟨mid,j,c,after,hrest,hfalse,herr⟩ := findSpec_error f rest e hfind
      have hchars : charsIn rest = charsIn mid ++ c::charsIn after := by
        simp [hrest,charsIn]
      rw [hchars,splitSpecE_error f keep k (charsIn mid) (charsIn after) c e
        (charsFalse f mid hfalse) herr]
      exact viewedOutput_error prim errs _ _ e
        (splitStepE_error prim errs s ls before rest law f findnext splitter hsearch limit keep i n hsplit hw hlo e hfind)
    | ok result =>
      cases result with
      | none =>
        have hfalse := charsFalse f rest (findSpec_none f rest hfind)
        rw [splitSpecE_noHit f keep true k [] (charsIn rest) hfalse]
        have ht := splitTailViewed prim errs s ls before rest law f findnext splitter hsearch limit keep
          (some (i,i,n)) i i n hsplit hw
          (splitStepE_tail prim errs s ls before rest law f findnext splitter hsearch limit keep i n hsplit hw hlo
            none hfind (Or.inl rfl))
        simpa only [List.reverse_nil,List.nil_append,charsIn,List.isEmpty_map] using ht
      | some j =>
        obtain ⟨mid,c,after,hrest,hfalse,htrue⟩ := findSpec_some f rest j hfind
        have hs : ls = (before++mid) ++ (j,c)::after := by
          rw [hsplit,hrest,List.append_assoc]
        have hwp : Walk prim s i (mid++(j,c)::after) := by rw [←hrest]; exact hw
        obtain ⟨next,hnext,hwafter,hadvance⟩ :=
          Affix.lawfulNextAtAffix prim s ls law (before++mid) j c after hs
        obtain ⟨_,hjlo,hjbound⟩ := walkGetindex prim s ls law (before++mid) j c after hs
        obtain ⟨prev,out,hprev,hview,hparent,hv⟩ := delimiterView prim errs s ls before mid after
          law i j c (by simpa only [List.append_assoc] using hs) hwp
        have hij : i.val ≤ j.val := walkIndicesAtLeast prim s i (Int.le_refl _) hw (j,c)
          (by rw [hrest]; simp)
        have hprefix := walkPrefixLengthBound prim s mid ((j,c)::after) i hwp
        change (mid.length : Int)+i.val ≤ j.val at hprefix
        have hchars : charsIn rest = charsIn mid ++ c::charsIn after := by
          simp [hrest,charsIn]
        have hspec := splitSpecE_hit f keep k (charsIn mid) (charsIn after) c
          (charsFalse f mid hfalse) htrue
        by_cases hk : k = 1
        · have hstep := splitStepE_tail prim errs s ls before rest law f findnext splitter hsearch limit keep i n
            hsplit hw hlo (some j) hfind (Or.inr (hcount.mpr hk))
          have ht := splitTailViewed prim errs s ls before rest law f findnext splitter hsearch limit keep
            (some (i,i,n)) i i n hsplit hw hstep
          have hnonempty : rest.isEmpty = false := by simp [hrest]
          rw [hchars,hspec,if_pos hk]
          simpa only [hnonempty,Bool.and_false,Bool.false_eq_true,ite_false,hchars] using ht
        · have hneq : n.val ≠ (limit-int 1).val := fun h => hk (hcount.mp h)
          have hshort : after.length < m := by rw [←hlen,hrest]; simp; omega
          have hsafter : ls = (before++mid++[(j,c)]) ++ after := by
            simpa only [List.append_assoc,List.singleton_append] using hs
          have hmidEmpty : (charsIn mid).isEmpty = mid.isEmpty := by simp [charsIn]
          rw [hchars,hspec,if_neg hk,hmidEmpty]
          by_cases hdrop : keep = false ∧ mid = []
          · obtain ⟨hkeep,hmid⟩ := hdrop
            subst keep
            subst mid
            have hji : j = i := Subtype.ext (walkStartValue prim s hwp).symm
            subst j
            simp only [Bool.not_false,List.isEmpty_nil,Bool.true_and,ite_true]
            have ht := ih after.length hshort after (before++[]++[(i,c)]) next n k rfl
              hsafter hwafter hn (by simp only [List.length_append,List.length_nil,
                List.length_singleton,Int.natCast_add,Int.natCast_zero,Int.natCast_one]; omega) hbudget
            exact viewedOutput_step_eq prim errs (forwardStep prim errs s findnext splitter limit false)
              (some (i,i,n)) (some (next,next,n)) _ (splitStepE_skip prim errs s ls before rest
                law f findnext splitter hsearch limit i next prev n out hsplit hw hlo hfind hneq hjbound
                hnext hadvance (walkStartBound prim s hwafter) hprev hview) ht
          · have hguard : ¬(!keep && mid.isEmpty) = true := by
              cases keep <;> cases mid <;> simp_all
            rw [if_neg hguard]
            have hkeep : (keep || decide (i.val < j.val)) = true := by
              cases keep with
              | true => rfl
              | false =>
                have hmid : mid ≠ [] := fun he => hdrop ⟨rfl,he⟩
                have hp : 0 < mid.length := by cases mid <;> simp_all
                simp only [Bool.false_or,decide_eq_true_eq]
                omega
            have hnv : (n+int 1).val = n.val+1 :=
              indexAddOneVal n hn (by omega)
            have hbudget' : (limit.val ≤ 0 ∧ k-1 = 0) ∨
                (0 < limit.val ∧ (n+int 1).val+((k-1:Nat):Int) = limit.val ∧ 1 ≤ k-1) := by
              rw [hnv]
              rcases hbudget with ⟨hl,rfl⟩ | ⟨hl,he,hkpos⟩
              · exact Or.inl ⟨hl,rfl⟩
              · right
                exact ⟨hl,by omega,by omega⟩
            have ht := ih after.length hshort after (before++mid++[(j,c)]) next (n+int 1)
              (k-1) rfl hsafter hwafter (by rw [hnv]; omega)
              (by rw [hnv]; simp only [List.length_append,List.length_singleton,
                Int.natCast_add,Int.natCast_one]; omega) hbudget'
            exact viewedOutput_emit prim errs _ (some (i,i,n)) out (next,next,n+int 1)
              (charsIn mid) _ (splitStepE_hit prim errs s ls before rest law f findnext splitter hsearch limit keep
                i j next prev n out hsplit hw hlo hfind hneq hjbound hnext hadvance
                hij hprev hview hkeep) hv ht

end SplitSearch

section SplitPure
set_option maxHeartbeats 1000000

theorem splitSpecAux_one {C : Type} (f : C → Bool) (keep : Bool) (acc cs : List C) :
    splitSpecAux f keep 1 acc cs =
      if !keep && (acc.reverse++cs).isEmpty then [] else [acc.reverse++cs] := by
  cases cs <;> simp [splitSpecAux]

theorem splitSpecE_pure {C E : Type} (f : C → Bool) (keep scan : Bool)
    (k : Nat) (acc cs : List C) :
    splitSpecE (fun c => (.ok (f c) : Except E Bool)) keep scan k acc cs =
      (splitSpecAux f keep k acc cs,none) := by
  induction cs generalizing k acc with
  | nil => rfl
  | cons c cs ih =>
    by_cases hk : k = 1
    · subst k
      cases hf : f c <;> cases scan <;>
        simp [splitSpecE,splitSpecAux,hf,ih,splitSpecAux_one,List.reverse_cons,List.append_assoc]
    · cases hf : f c <;> cases scan <;> simp [splitSpecE,splitSpecAux,hk,hf,ih]
      all_goals split <;> rfl


theorem viewedLength {S R C CU CT E : Type} (prim : StringOps S R C CU CT E)
    (errs : ViewErrors S E) (pieces : List (Sub.SubString S)) (css : List (List C))
    (h : ViewsIterate prim errs pieces css) : pieces.length = css.length := by
  induction h with
  | nil => rfl
  | cons head tail ih => simp only [List.length_cons,ih]

theorem splitSpecAux_bound {C : Type} (f : C → Bool) (keep : Bool)
    (k : Nat) (acc cs : List C) (hk : 0 < k) :
    (splitSpecAux f keep k acc cs).length ≤ k := by
  induction cs generalizing k acc with
  | nil =>
    simp only [splitSpecAux]
    split <;> simp_all <;> omega
  | cons c cs ih =>
    by_cases hk1 : k = 1
    · simp [splitSpecAux,hk1]
    · rw [splitSpecAux,if_neg hk1]
      cases hf : f c with
      | false => simpa only [hf,Bool.false_eq_true,ite_false] using ih k (c::acc) hk
      | true =>
        simp only [hf,ite_true]
        split
        · exact ih k [] hk
        · simp only [List.length_cons]
          have ht := ih (k-1) [] (by omega)
          omega

theorem splitPieces_nonempty {C : Type} (f : C → Bool) (cs : List C) :
    splitPieces f cs ≠ [] := by
  induction cs with
  | nil => simp [splitPieces]
  | cons c cs ih =>
    rw [splitPieces]
    split
    · simp
    · cases hp : splitPieces f cs with
      | nil => contradiction
      | cons p ps => simp

theorem splitSpecAux_zero {C : Type} (f : C → Bool) (acc cs : List C) :
    splitSpecAux f true 0 acc cs =
      match splitPieces f cs with
      | [] => [acc.reverse]
      | p::ps => (acc.reverse++p)::ps := by
  induction cs generalizing acc with
  | nil => simp [splitSpecAux,splitPieces]
  | cons c cs ih =>
    have hnonempty := splitPieces_nonempty f cs
    cases hp : splitPieces f cs with
    | nil => contradiction
    | cons p ps =>
      cases hf : f c <;>
        simp [splitSpecAux,splitPieces,hf,ih,hp,List.reverse_cons,List.append_assoc]

theorem splitSpecAux_zero_empty {C : Type} (f : C → Bool) (cs : List C) :
    splitSpecAux f true 0 [] cs = splitPieces f cs := by
  rw [splitSpecAux_zero]
  have hnonempty := splitPieces_nonempty f cs
  cases hp : splitPieces f cs with
  | nil => contradiction
  | cons p ps => simp

theorem splitSpecAux_peel {C : Type} (f : C → Bool) (k : Nat) (acc cs : List C) :
    splitSpecAux f true (k+2) acc cs =
      match cs.findIdx? f with
      | none => [acc.reverse++cs]
      | some i => (acc.reverse++cs.take i) ::
        splitSpecAux f true (k+1) [] (cs.drop (i+1)) := by
  induction cs generalizing acc with
  | nil => simp [splitSpecAux]
  | cons c cs ih =>
    cases hf : f c with
    | true => simp [splitSpecAux,hf,List.findIdx?_cons]
    | false =>
      simp only [splitSpecAux,show k+2 ≠ 1 by omega,ite_false,hf]
      rw [ih (c::acc)]
      simp only [List.findIdx?_cons,hf,ite_false]
      cases hi : cs.findIdx? f <;>
        simp [hi,List.reverse_cons,List.append_assoc]

theorem splitSpecAux_limit {C : Type} (f : C → Bool) (k : Nat) (cs : List C) :
    splitSpecAux f true k [] cs = splitLimitPieces f k cs := by
  induction k generalizing cs with
  | zero => exact splitSpecAux_zero_empty f cs
  | succ k ih =>
    cases k with
    | zero => cases cs <;> simp [splitSpecAux,splitLimitPieces]
    | succ k =>
      rw [show k+1+1 = k+2 by omega,splitSpecAux_peel]
      simp only [List.reverse_nil,List.nil_append,splitLimitPieces]
      cases hi : cs.findIdx? f with
      | none => rfl
      | some i => simp only [ih]

end SplitPure

section ForwardResults

theorem forwardOutput {S R C CU CT E F : Type} (prim : StringOps S R C CU CT E)
    (errs : ViewErrors S E) (s : S) (ls : List (Index × C)) (law : Lawful prim s ls)
    (f : C → Except E Bool)
    (findnext : F → S → Index → JuliaLean.base.strings.search.SearchM E (Option (Index × Index)))
    (splitter : F) (hsearch : ∀ i, findnext splitter s i = predFindnextE prim f s i)
    (limit : Index) (keep : Bool) :
    ViewedOutput prim errs (forwardStep prim errs s findnext splitter limit keep) none
      (splitSpecE f keep true (limitCount limit) [] (charsIn ls)) := by
  have hz : (int 0).val = 0 := by decide
  have hbudget : (limit.val ≤ 0 ∧ limitCount limit = 0) ∨
      (0 < limit.val ∧ (int 0).val+(limitCount limit:Int) = limit.val ∧ 1 ≤ limitCount limit) := by
    by_cases hl : limit.val ≤ 0
    · exact Or.inl ⟨hl,by simp [limitCount,hl]⟩
    · right
      refine ⟨by omega,?_,?_⟩
      · simp [limitCount,hl,hz,Int.toNat_of_nonneg (by omega : 0 ≤ limit.val)]
      · have hv := Int.toNat_of_nonneg (by omega : 0 ≤ limit.val)
        simp only [limitCount,if_neg hl]
        omega
  have ht := splitForwardAll prim errs s ls law f findnext splitter hsearch limit keep
    ls.length ls [] (int 1) (int 0) (limitCount limit) rfl rfl law.walk
    (by rw [hz]; omega) (by rw [hz]; simp) hbudget
  exact viewedOutput_step_eq prim errs (forwardStep prim errs s findnext splitter limit keep)
    none (some (int 1,int 1,int 0)) _
    (splitStepE_start prim errs s f findnext splitter hsearch limit keep) ht

theorem splitRuns_proven : SplitRuns := by
  intro S R C CU CT E prim errs f s ls limit keep input
  have ht := forwardOutput prim errs s ls input.lawful f
    (fun f s k => predFindnextE prim f s k) f (fun _ => rfl) limit keep
  change ViewedOutput prim errs (splitStepE prim errs s f limit keep) none
    (splitSpecE f keep true (limitCount limit) [] (charsIn ls)) at ht
  obtain ⟨pieces,hview,htrace⟩ := ht
  constructor
  · intro hnone
    exact ⟨pieces,by simpa only [hnone] using htrace,hview⟩
  · intro e he
    exact ⟨pieces,by simpa only [he] using htrace,hview⟩

theorem forwardPureOutput {S R C CU CT E : Type} (prim : StringOps S R C CU CT E)
    (errs : ViewErrors S E) (s : S) (ls : List (Index × C)) (law : Lawful prim s ls)
    (f : C → Bool) (limit : Index) (keep : Bool) :
    ∃ pieces, Emits (splitStep prim errs s f limit keep) none pieces ∧
      ViewsIterate prim errs pieces (splitSpecAux f keep (limitCount limit) [] (charsIn ls)) := by
  have ht := forwardOutput prim errs s ls law (fun c => .ok (f c))
    (fun f s k => predFindnext prim f s k) f (fun _ => rfl) limit keep
  change ViewedOutput prim errs (splitStep prim errs s f limit keep) none
    (splitSpecE (fun c => .ok (f c)) keep true (limitCount limit) [] (charsIn ls)) at ht
  rw [splitSpecE_pure] at ht
  obtain ⟨pieces,hview,htrace⟩ := ht
  exact ⟨pieces,htrace,hview⟩

theorem splitJoin_proven : SplitJoin := by
  intro S R C CU CT E prim errs f s ls limit input hlimit
  obtain ⟨pieces,htrace,hview⟩ := forwardPureOutput prim errs s ls input.lawful f limit true
  refine ⟨pieces,htrace,?_⟩
  simpa only [limitCount,if_pos hlimit,splitSpecAux_zero_empty] using hview

theorem splitLimit_proven : SplitLimit := by
  intro S R C CU CT E prim errs f s ls limit keep input hlimit
  have hn : ¬limit.val ≤ 0 := by omega
  have hk : 0 < limit.val.toNat := by
    have hv := Int.toNat_of_nonneg (by omega : 0 ≤ limit.val)
    omega
  obtain ⟨pieces,htrace,hview⟩ := forwardPureOutput prim errs s ls input.lawful f limit keep
  simp only [limitCount,if_neg hn] at hview
  refine ⟨pieces,htrace,?_,?_⟩
  · rw [viewedLength prim errs pieces _ hview]
    exact splitSpecAux_bound f keep limit.val.toNat [] (charsIn ls) hk
  · intro hkeep
    subst keep
    simpa only [splitSpecAux_limit] using hview

end ForwardResults


section SplitReverse
open JuliaLean.base.strings.search (SearchM liftE)

theorem sm_ok_bind {E A B : Type} (a : A) (f : A → SearchM E B) :
    (liftE (.ok a) >>= f) = f a := rfl

theorem sm_error_bind {E A B : Type} (e : E) (f : A → SearchM E B) :
    (liftE (.error e) >>= f) = liftE (.error e) := rfl

def reverseStart {C : Type} : List (Index × C) → Index
  | [] => int 0
  | p::_ => p.1

theorem reversePrevAt {S R C CU CT E : Type} (prim : StringOps S R C CU CT E)
    (s : S) (ls rev after : List (Index × C)) (law : Lawful prim s ls) (i : Index) (c : C)
    (hsplit : ls = rev.reverse ++ (i,c)::after) :
    previndOne (gFull prim) s i = .ok (reverseStart rev) := by
  cases rev with
  | nil =>
    have hwalk : Walk prim s (int 1) ((i,c)::after) := by
      simpa only [hsplit,List.reverse_nil,List.nil_append] using law.walk
    have hi : i = int 1 := Subtype.ext (walkStartValue prim s hwalk).symm
    have hlen := walkLengthBound prim s law.walk
    have hone : (int 1).val = 1 := by decide
    have hn : 0 ≤ (prim.ncodeunits s).val := by rw [hone] at hlen; omega
    have hp := JuliaLean.Proofs.base.strings.basic.prevind_proven.2.2.2.1
      S R C CU CT E prim (fun x => toString x.val) s (int 1) hn
      (walkEndBound prim s law.walk) (by rw [hone]; omega)
    simpa only [hi,gFull,reverseStart] using hp.2
  | cons p ps =>
    apply Affix.lawfulAdjacentPrevAffix prim s ls law ps.reverse p.1 p.2 i c after
    simpa only [List.reverse_cons,List.append_assoc,List.singleton_append] using hsplit

theorem findPrevLoopSpec {S R C CU CT E : Type} (prim : StringOps S R C CU CT E)
    (s : S) (ls : List (Index × C)) (law : Lawful prim s ls) (f : C → Except E Bool)
    (rev after : List (Index × C)) (hsplit : ls = rev.reverse ++ after) :
    (JuliaLean.base.strings.search.findprevPredicateLoop (searchOps prim)
      (fun c => liftE (f c)) s (reverseStart rev)).run = some (findSpec f rev) := by
  induction rev generalizing after with
  | nil =>
    rw [JuliaLean.base.strings.search.findprevPredicateLoop.eq_def]
    rfl
  | cons p ps ih =>
    obtain ⟨i,c⟩ := p
    have hs : ls = ps.reverse ++ (i,c)::after := by
      simpa only [List.reverse_cons,List.append_assoc,List.singleton_append] using hsplit
    obtain ⟨hget,hlo,hhi⟩ := walkGetindex prim s ls law ps.reverse i c after hs
    have hprev := reversePrevAt prim s ls ps after law i c hs
    dsimp only [reverseStart]
    rw [JuliaLean.base.strings.search.findprevPredicateLoop.eq_def,if_pos hlo]
    rw [sm_bind_ok (liftE ((searchOps prim).getindex s i)) _ c
      (by rw [liftE_run]; exact congrArg some hget)]
    cases hf : f c with
    | error e =>
      rw [sm_bind_err (liftE (.error e)) _ e rfl]
      simp only [findSpec,hf]
    | ok b =>
      rw [sm_bind_ok (liftE (.ok b)) _ b rfl]
      cases b with
      | true => simp [findSpec,hf]
      | false =>
        simp only [Bool.false_eq_true,ite_false]
        rw [sm_bind_ok (liftE ((searchOps prim).prevind s i)) _ (reverseStart ps)
          (by rw [liftE_run]; exact congrArg some hprev)]
        simpa only [findSpec,hf] using ih ((i,c)::after) hs

theorem reverseStartFacts {S R C CU CT E : Type} (prim : StringOps S R C CU CT E)
    (s : S) (ls rev after : List (Index × C)) (law : Lawful prim s ls)
    (hsplit : ls = rev.reverse ++ after) :
    0 ≤ (reverseStart rev).val ∧ (reverseStart rev).val ≤ (prim.ncodeunits s).val ∧
      ((reverseStart rev).val ≠ 0 → prim.isvalid s (reverseStart rev) = .ok true) := by
  cases rev with
  | nil =>
    have hlen := walkLengthBound prim s law.walk
    have hone : (int 1).val = 1 := by decide
    rw [hone] at hlen
    have hz : (reverseStart ([] : List (Index × C))).val = 0 := by rfl
    refine ⟨by rw [hz]; omega,by rw [hz]; omega,?_⟩
    intro hne
    exact False.elim (hne hz)
  | cons p ps =>
    obtain ⟨i,c⟩ := p
    have hs : ls = ps.reverse ++ (i,c)::after := by
      simpa only [List.reverse_cons,List.append_assoc,List.singleton_append] using hsplit
    obtain ⟨_,hlo,hhi⟩ := walkGetindex prim s ls law ps.reverse i c after hs
    refine ⟨by dsimp only [reverseStart]; omega,hhi,?_⟩
    intro _
    have hm : (i,c) ∈ ls := by rw [hs]; simp
    have ha : ls.any (fun p => p.1.val == i.val) = true :=
      List.any_eq_true.mpr ⟨(i,c),hm,by simp⟩
    simpa only [ha,reverseStart] using law.isvalid i hlo hhi

theorem findprevSpec {S R C CU CT E : Type} (prim : StringOps S R C CU CT E)
    (s : S) (ls rev after : List (Index × C)) (law : Lawful prim s ls)
    (f : C → Except E Bool) (hsplit : ls = rev.reverse ++ after) :
    (JuliaLean.base.strings.search.findprevPredicate (searchOps prim) indexIntOps
      (fun c => liftE (f c)) s (reverseStart rev)).run = some (findSpec f rev) := by
  obtain ⟨hlo,hhi,hvalid⟩ := reverseStartFacts prim s ls rev after law hsplit
  have hlen := walkLengthBound prim s law.walk
  have hone : (int 1).val = 1 := by decide
  have hn : 0 ≤ (prim.ncodeunits s).val := by rw [hone] at hlen; omega
  have hz : (prim.ncodeunits s+JuliaLean.base.strings.search.int 1).val =
      (prim.ncodeunits s).val+1 := indexAddOneVal _ hn (walkEndBound prim s law.walk)
  have hguard : (decide (0 ≤ (reverseStart rev).val) &&
      decide ((reverseStart rev).val ≤ (prim.ncodeunits s+JuliaLean.base.strings.search.int 1).val)) = true := by
    simp only [hz,show 0 ≤ (reverseStart rev).val from hlo,
      show (reverseStart rev).val ≤ (prim.ncodeunits s).val+1 by omega,
      decide_true,Bool.true_and]
  have hne : reverseStart rev ≠ prim.ncodeunits s+JuliaLean.base.strings.search.int 1 := by
    intro heq
    have hh := congrArg Subtype.val heq
    rw [hz] at hh
    omega
  unfold JuliaLean.base.strings.search.findprevPredicate
  rw [sm_bind_ok (liftE (indexIntOps.toInt (reverseStart rev))) _ (reverseStart rev) rfl]
  dsimp only [searchOps]
  rw [if_neg (show ¬(!(decide (0 ≤ (reverseStart rev).val) &&
    decide ((reverseStart rev).val ≤ (prim.ncodeunits s+JuliaLean.base.strings.search.int 1).val))) = true by
      simp only [hguard,Bool.not_true,Bool.false_eq_true,not_false_eq_true])]
  rw [if_neg (show ¬(reverseStart rev == prim.ncodeunits s+JuliaLean.base.strings.search.int 1) = true by
    simpa only [beq_iff_eq] using hne)]
  by_cases hzero : (reverseStart rev).val = 0
  · rw [if_neg (show ¬((reverseStart rev).val != 0) = true by simp [hzero])]
    exact findPrevLoopSpec prim s ls law f rev after hsplit
  · rw [if_pos (show ((reverseStart rev).val != 0) = true by simpa only [bne_iff_ne] using hzero)]
    rw [sm_bind_ok (liftE (prim.isvalid s (reverseStart rev))) _ true
      (by rw [liftE_run]; exact congrArg some (hvalid hzero))]
    simp only [Bool.not_true,Bool.false_eq_true,ite_false]
    exact findPrevLoopSpec prim s ls law f rev after hsplit

theorem predFindprevE_lift {S R C CU CT E : Type} (prim : StringOps S R C CU CT E)
    (s : S) (ls rev after : List (Index × C)) (law : Lawful prim s ls)
    (f : C → Except E Bool) (hsplit : ls = rev.reverse ++ after) :
    predFindprevE prim f s (reverseStart rev) =
      liftE ((findSpec f rev).map (fun r => r.map (fun j => (j,j)))) := by
  unfold predFindprevE
  rw [sm_eq_lift _ _ (findprevSpec prim s ls rev after law f hsplit)]
  cases findSpec f rev <;> rfl

theorem reverseView {S R C CU CT E : Type} (prim : StringOps S R C CU CT E)
    (errs : ViewErrors S E) (s : S) (ls rev after : List (Index × C)) (law : Lawful prim s ls)
    (hsplit : ls = rev.reverse ++ after) :
    ∃ out, gRange prim errs s (int 1) (reverseStart rev) = .ok out ∧ out.string = s ∧
      ViewIterates prim errs out (charsIn rev).reverse := by
  cases rev with
  | nil =>
    refine ⟨⟨s,JuliaLean.base.strings.substring.zero,JuliaLean.base.strings.substring.zero⟩,
      Affix.gRangeEmptyAffix prim errs s,rfl,Affix.emptyViewIteratesAffix prim errs s⟩
  | cons p ps =>
    have hlast : ((p::ps).reverse).getLast? = some p := by simp
    have hw : Walk prim s (int 1) ((p::ps).reverse++after) := by
      rw [←hsplit]; exact law.walk
    obtain ⟨out,hr,hparent,hview⟩ := segmentView prim errs s ls [] ((p::ps).reverse) after
      law (int 1) p.1 p.2 (by simpa using hsplit) hw hlast
    exact ⟨out,hr,hparent,by simpa only [charsIn,List.map_reverse] using hview⟩

theorem reverseDelimiterView {S R C CU CT E : Type} (prim : StringOps S R C CU CT E)
    (errs : ViewErrors S E) (s : S) (ls rev after mid before : List (Index × C))
    (law : Lawful prim s ls) (j : Index) (c : C)
    (hsplit : ls = rev.reverse ++ after) (hrest : rev = mid++(j,c)::before) :
    ∃ frm out, nextindOne (gFull prim) s j = .ok frm ∧
      previndOne (gFull prim) s j = .ok (reverseStart before) ∧
      gRange prim errs s frm (reverseStart rev) = .ok out ∧ out.string = s ∧
      ViewIterates prim errs out (charsIn mid).reverse ∧
      (mid = [] → (reverseStart rev).val < frm.val) ∧
      (mid ≠ [] → frm.val ≤ (reverseStart rev).val) := by
  have hs : ls = before.reverse ++ (j,c)::(mid.reverse++after) := by
    simpa only [hrest,List.reverse_append,List.reverse_cons,List.append_assoc,
      List.singleton_append,List.cons_append,List.nil_append] using hsplit
  obtain ⟨frm,hfrm,hw,hadvance⟩ :=
    Affix.lawfulNextAtAffix prim s ls law before.reverse j c (mid.reverse++after) hs
  have hprev := reversePrevAt prim s ls before (mid.reverse++after) law j c hs
  cases mid with
  | nil =>
    have hto : reverseStart rev = j := by rw [hrest]; rfl
    let out : Sub.SubString S := ⟨s,JuliaLean.base.strings.substring.zero,
      JuliaLean.base.strings.substring.zero⟩
    refine ⟨frm,out,hfrm,hprev,?_,rfl,Affix.emptyViewIteratesAffix prim errs s,?_,?_⟩
    · simp only [hto,gRange,Sub.subStringInt,JuliaLean.base.strings.substring.typedSubString,
        if_pos hadvance,Bind.bind,Except.bind,Pure.pure,Except.pure,out]
    · intro _; rw [hto]; exact hadvance
    · intro h; exact False.elim (h rfl)
  | cons p ps =>
    have hto : reverseStart rev = p.1 := by rw [hrest]; rfl
    have hlast : ((p::ps).reverse).getLast? = some p := by simp
    have hs' : ls = (before.reverse++[(j,c)]) ++ (p::ps).reverse ++ after := by
      simpa only [List.append_assoc,List.singleton_append,List.cons_append,List.nil_append] using hs
    obtain ⟨out,hr,hparent,hview⟩ := segmentView prim errs s ls (before.reverse++[(j,c)])
      ((p::ps).reverse) after law frm p.1 p.2 hs' hw hlast
    have hle : frm.val ≤ p.1.val :=
      walkIndicesAtLeast prim s frm (Int.le_refl _) hw p
        (List.mem_append_left _ (getLastMem hlast))
    refine ⟨frm,out,hfrm,hprev,?_,hparent,?_,?_,?_⟩
    · simpa only [hto] using hr
    · simpa only [charsIn,List.map_reverse] using hview
    · intro h; cases h
    · intro _; rw [hto]; exact hle

theorem subOneCases (i : Index) :
    (i-int 1).val = if i.val = -9223372036854775808 then 9223372036854775807 else i.val-1 := by
  have hb := i.property
  have hone : (int 1).val = 1 := by decide
  by_cases hmin : i.val = -9223372036854775808
  · rw [if_pos hmin]
    change wrapInt .i64 (i.val-(int 1).val) = _
    rw [hmin,hone]
    decide
  · rw [if_neg hmin]
    change wrapInt .i64 (i.val-(int 1).val) = _
    rw [hone]
    apply wrapInt_of_inRange
    constructor
    · change -9223372036854775808 ≤ i.val-1
      change -9223372036854775808 ≤ i.val ∧ i.val ≤ 9223372036854775807 at hb
      omega
    · omega

def ReverseBudget (remaining : Index) (k len : Nat) : Prop :=
  (k = 0 ∧ (remaining.val < 0 ∨ (len:Int) < remaining.val)) ∨
    (1 ≤ k ∧ remaining.val = (k:Int)-1)

theorem reverseBudget_zero (remaining : Index) (k len : Nat)
    (h : ReverseBudget remaining k len) : remaining.val = 0 ↔ k = 1 := by
  unfold ReverseBudget at h
  rcases h with ⟨rfl,h⟩ | ⟨_,_⟩ <;> omega

theorem reverseBudget_initial (limit : Index) (len : Nat)
    (hlen : (len:Int) < IntTy.max .i64) :
    ReverseBudget (limit-int 1) (limitCount limit) len := by
  unfold ReverseBudget
  rw [subOneCases]
  by_cases hl : limit.val ≤ 0
  · left
    refine ⟨by simp [limitCount,hl],?_⟩
    split
    · right; exact hlen
    · left; omega
  · right
    have hv := Int.toNat_of_nonneg (by omega : 0 ≤ limit.val)
    simp only [limitCount,if_neg hl]
    refine ⟨by omega,?_⟩
    rw [if_neg (by omega)]
    omega

theorem reverseBudget_skip (remaining : Index) (k oldLen newLen : Nat)
    (h : ReverseBudget remaining k oldLen) (hlt : newLen ≤ oldLen) :
    ReverseBudget remaining k newLen := by
  unfold ReverseBudget at h ⊢
  rcases h with ⟨hk,hv⟩ | ⟨_,_⟩
  · left; exact ⟨hk,by rcases hv with hv | hv <;> omega⟩
  · right; omega

theorem reverseBudget_step (remaining : Index) (k oldLen newLen : Nat)
    (h : ReverseBudget remaining k oldLen) (hk : k ≠ 1) (hlt : newLen < oldLen)
    (hmax : (oldLen:Int) < IntTy.max .i64) :
    ReverseBudget (remaining-int 1) (k-1) newLen := by
  change (oldLen:Int) < 9223372036854775807 at hmax
  unfold ReverseBudget at h ⊢
  rw [subOneCases]
  rcases h with ⟨rfl,hv⟩ | ⟨hkpos,hv⟩
  · left
    refine ⟨rfl,?_⟩
    split
    · right; change (newLen:Int) < 9223372036854775807; omega
    · rcases hv with hv | hv
      · left; omega
      · right; omega
  · right
    rw [if_neg (by omega)]
    exact ⟨by omega,by omega⟩

def reverseStep {S R C CU CT E F : Type} (prim : StringOps S R C CU CT E)
    (errs : ViewErrors S E) (s : S)
    (findprev : F → S → Index → SearchM E (Option (Index × Index)))
    (splitter : F) (limit : Index) (keep : Bool) (st : Option RSplitState) :=
  (iterateRSplit (splitOps prim errs) findprev
    (⟨s,splitter,limit,keep⟩ : RSplitIteratorModel S F) st).run

theorem reverseStep_stop {S R C CU CT E F : Type} (prim : StringOps S R C CU CT E)
    (errs : ViewErrors S E) (s : S)
    (findprev : F → S → Index → SearchM E (Option (Index × Index)))
    (splitter : F) (limit : Index) (keep : Bool) (to remaining : Index) (hto : to.val < 0) :
    reverseStep prim errs s findprev splitter limit keep (some (to,remaining)) = some (.ok none) := by
  simp only [reverseStep,iterateRSplit,pure_bind,if_pos hto]
  rfl

theorem reverseStep_at {S R C CU CT E F : Type} (prim : StringOps S R C CU CT E)
    (errs : ViewErrors S E) (s : S)
    (findprev : F → S → Index → SearchM E (Option (Index × Index)))
    (splitter : F) (limit : Index) (keep : Bool) (to remaining : Index) (hto : 0 ≤ to.val) :
    reverseStep prim errs s findprev splitter limit keep (some (to,remaining)) =
      (do
        let (frm,nextTo,last) ← iterateRSplitLoop (splitOps prim errs) findprev
          (⟨s,splitter,limit,keep⟩ : RSplitIteratorModel S F) remaining to (int 1) (int (-1))
        if frm.val > last.val && !keep then pure none
        else
          let out ← liftE (gRange prim errs s frm last)
          pure (some (out,(nextTo,remaining-int 1)))).run := by
  simp only [reverseStep,iterateRSplit,pure_bind,if_neg (show ¬to.val < 0 by omega),splitOps]

theorem reverseLoop_args {S R F E : Type} (ops : SplitStringOps S R E)
    (findprev : F → S → Index → SearchM E (Option (Index × Index)))
    (iter : RSplitIteratorModel S F) (remaining to frm nextTo frm' nextTo' : Index)
    (hn : remaining.val ≠ 0) :
    iterateRSplitLoop ops findprev iter remaining to frm nextTo =
      iterateRSplitLoop ops findprev iter remaining to frm' nextTo' := by
  rw [iterateRSplitLoop.eq_def,iterateRSplitLoop.eq_def]
  simp only [if_neg hn]

theorem reverseLoop_final {S R C CU CT E F : Type} (prim : StringOps S R C CU CT E)
    (errs : ViewErrors S E) (s : S) (ls rev after : List (Index × C)) (law : Lawful prim s ls)
    (f : C → Except E Bool)
    (findprev : F → S → Index → SearchM E (Option (Index × Index)))
    (splitter : F) (hsearch : ∀ i, findprev splitter s i = predFindprevE prim f s i)
    (limit : Index) (keep : Bool) (remaining : Index) (hsplit : ls = rev.reverse++after)
    (hfinal : remaining.val = 0 ∨ findSpec f rev = .ok none) :
    iterateRSplitLoop (splitOps prim errs) findprev
      (⟨s,splitter,limit,keep⟩ : RSplitIteratorModel S F) remaining (reverseStart rev) (int 1) (int (-1)) =
      pure (int 1,int (-1),reverseStart rev) := by
  rw [iterateRSplitLoop.eq_def]
  by_cases hn : remaining.val = 0
  · rw [if_pos hn]
  · rw [if_neg hn,hsearch,predFindprevE_lift prim s ls rev after law f hsplit,
      hfinal.resolve_left hn]
    rfl

theorem reverseStep_final {S R C CU CT E F : Type} (prim : StringOps S R C CU CT E)
    (errs : ViewErrors S E) (s : S) (ls rev after : List (Index × C)) (law : Lawful prim s ls)
    (f : C → Except E Bool)
    (findprev : F → S → Index → SearchM E (Option (Index × Index)))
    (splitter : F) (hsearch : ∀ i, findprev splitter s i = predFindprevE prim f s i)
    (limit : Index) (keep : Bool) (remaining : Index) (out : Sub.SubString S)
    (hsplit : ls = rev.reverse++after)
    (hfinal : remaining.val = 0 ∨ findSpec f rev = .ok none)
    (hout : gRange prim errs s (int 1) (reverseStart rev) = .ok out) :
    reverseStep prim errs s findprev splitter limit keep (some (reverseStart rev,remaining)) =
      if (decide ((int 1).val > (reverseStart rev).val) && !keep) = true then some (.ok none)
      else some (.ok (some (out,(int (-1),remaining-int 1)))) := by
  have hto := (reverseStartFacts prim s ls rev after law hsplit).1
  rw [reverseStep_at prim errs s findprev splitter limit keep _ remaining hto,
    reverseLoop_final prim errs s ls rev after law f findprev splitter hsearch limit keep remaining hsplit hfinal]
  simp only [pure_bind]
  split
  · rfl
  · simp only [sm_lift_bind,hout]
    rfl

theorem reverseStep_error {S R C CU CT E F : Type} (prim : StringOps S R C CU CT E)
    (errs : ViewErrors S E) (s : S) (ls rev after : List (Index × C)) (law : Lawful prim s ls)
    (f : C → Except E Bool)
    (findprev : F → S → Index → SearchM E (Option (Index × Index)))
    (splitter : F) (hsearch : ∀ i, findprev splitter s i = predFindprevE prim f s i)
    (limit : Index) (keep : Bool) (remaining : Index) (e : E)
    (hsplit : ls = rev.reverse++after) (hn : remaining.val ≠ 0)
    (hfind : findSpec f rev = .error e) :
    reverseStep prim errs s findprev splitter limit keep (some (reverseStart rev,remaining)) =
      some (.error e) := by
  have hto := (reverseStartFacts prim s ls rev after law hsplit).1
  rw [reverseStep_at prim errs s findprev splitter limit keep _ remaining hto,
    iterateRSplitLoop.eq_def]
  simp only [if_neg hn,hsearch,predFindprevE_lift prim s ls rev after law f hsplit,hfind,
    Except.map,sm_error_bind]
  rfl

theorem reverseLoop_hit {S R C CU CT E F : Type} (prim : StringOps S R C CU CT E)
    (errs : ViewErrors S E) (s : S) (ls rev after : List (Index × C)) (law : Lawful prim s ls)
    (f : C → Except E Bool)
    (findprev : F → S → Index → SearchM E (Option (Index × Index)))
    (splitter : F) (hsearch : ∀ i, findprev splitter s i = predFindprevE prim f s i)
    (limit : Index) (keep : Bool) (remaining j frm prev : Index)
    (hsplit : ls = rev.reverse++after) (hn : remaining.val ≠ 0)
    (hfind : findSpec f rev = .ok (some j))
    (hfrm : nextindOne (gFull prim) s j = .ok frm)
    (hprev : previndOne (gFull prim) s j = .ok prev)
    (hguard : ¬(decide (frm.val > (reverseStart rev).val) && !keep) = true) :
    iterateRSplitLoop (splitOps prim errs) findprev
      (⟨s,splitter,limit,keep⟩ : RSplitIteratorModel S F) remaining (reverseStart rev) (int 1) (int (-1)) =
      pure (frm,prev,reverseStart rev) := by
  rw [iterateRSplitLoop.eq_def,if_neg hn,hsearch,predFindprevE_lift prim s ls rev after law f hsplit,hfind]
  simp only [Except.map,Option.map,sm_ok_bind,splitOps,hfrm,Int.lt_irrefl,decide_false,
    Bool.false_and,Bool.false_eq_true,ite_false,hprev,if_neg hguard]

theorem reverseStep_hit {S R C CU CT E F : Type} (prim : StringOps S R C CU CT E)
    (errs : ViewErrors S E) (s : S) (ls rev after : List (Index × C)) (law : Lawful prim s ls)
    (f : C → Except E Bool)
    (findprev : F → S → Index → SearchM E (Option (Index × Index)))
    (splitter : F) (hsearch : ∀ i, findprev splitter s i = predFindprevE prim f s i)
    (limit : Index) (keep : Bool) (remaining j frm prev : Index) (out : Sub.SubString S)
    (hsplit : ls = rev.reverse++after) (hn : remaining.val ≠ 0)
    (hfind : findSpec f rev = .ok (some j))
    (hfrm : nextindOne (gFull prim) s j = .ok frm)
    (hprev : previndOne (gFull prim) s j = .ok prev)
    (hguard : ¬(decide (frm.val > (reverseStart rev).val) && !keep) = true)
    (hout : gRange prim errs s frm (reverseStart rev) = .ok out) :
    reverseStep prim errs s findprev splitter limit keep (some (reverseStart rev,remaining)) =
      some (.ok (some (out,(prev,remaining-int 1)))) := by
  have hto := (reverseStartFacts prim s ls rev after law hsplit).1
  rw [reverseStep_at prim errs s findprev splitter limit keep _ remaining hto,
    reverseLoop_hit prim errs s ls rev after law f findprev splitter hsearch limit keep
      remaining j frm prev hsplit hn hfind hfrm hprev hguard]
  simp only [pure_bind,if_neg hguard,hout,sm_lift_bind]
  rfl

theorem reverseLoop_skip {S R C CU CT E F : Type} (prim : StringOps S R C CU CT E)
    (errs : ViewErrors S E) (s : S) (ls rev after : List (Index × C)) (law : Lawful prim s ls)
    (f : C → Except E Bool)
    (findprev : F → S → Index → SearchM E (Option (Index × Index)))
    (splitter : F) (hsearch : ∀ i, findprev splitter s i = predFindprevE prim f s i)
    (limit remaining j frm prev : Index) (hsplit : ls = rev.reverse++after)
    (hn : remaining.val ≠ 0) (hfind : findSpec f rev = .ok (some j))
    (hfrm : nextindOne (gFull prim) s j = .ok frm)
    (hprev : previndOne (gFull prim) s j = .ok prev) (hskip : (reverseStart rev).val < frm.val) :
    iterateRSplitLoop (splitOps prim errs) findprev
      (⟨s,splitter,limit,false⟩ : RSplitIteratorModel S F) remaining (reverseStart rev) (int 1) (int (-1)) =
      iterateRSplitLoop (splitOps prim errs) findprev
        (⟨s,splitter,limit,false⟩ : RSplitIteratorModel S F) remaining prev (int 1) (int (-1)) := by
  rw [iterateRSplitLoop.eq_def,if_neg hn,hsearch,predFindprevE_lift prim s ls rev after law f hsplit,hfind]
  simp only [Except.map,Option.map,sm_ok_bind,splitOps,hfrm,Int.lt_irrefl,decide_false,
    Bool.false_and,Bool.false_eq_true,ite_false,hprev,show decide (frm.val > (reverseStart rev).val) = true from
      decide_eq_true hskip,Bool.not_false,Bool.true_and,ite_true]
  exact reverseLoop_args _ _ _ remaining prev frm prev (int 1) (int (-1)) hn

theorem reverseStep_skip {S R C CU CT E F : Type} (prim : StringOps S R C CU CT E)
    (errs : ViewErrors S E) (s : S) (ls rev after : List (Index × C)) (law : Lawful prim s ls)
    (f : C → Except E Bool)
    (findprev : F → S → Index → SearchM E (Option (Index × Index)))
    (splitter : F) (hsearch : ∀ i, findprev splitter s i = predFindprevE prim f s i)
    (limit remaining j frm prev : Index) (hsplit : ls = rev.reverse++after)
    (hn : remaining.val ≠ 0) (hfind : findSpec f rev = .ok (some j))
    (hfrm : nextindOne (gFull prim) s j = .ok frm)
    (hprev : previndOne (gFull prim) s j = .ok prev) (hskip : (reverseStart rev).val < frm.val)
    (hprevBound : 0 ≤ prev.val) :
    reverseStep prim errs s findprev splitter limit false (some (reverseStart rev,remaining)) =
      reverseStep prim errs s findprev splitter limit false (some (prev,remaining)) := by
  have hto := (reverseStartFacts prim s ls rev after law hsplit).1
  rw [reverseStep_at prim errs s findprev splitter limit false _ remaining hto,
    reverseLoop_skip prim errs s ls rev after law f findprev splitter hsearch limit remaining j frm prev
      hsplit hn hfind hfrm hprev hskip,
    reverseStep_at prim errs s findprev splitter limit false prev remaining hprevBound]

theorem reverseTailViewed {S R C CU CT E F : Type} (prim : StringOps S R C CU CT E)
    (errs : ViewErrors S E) (s : S) (ls rev after : List (Index × C)) (law : Lawful prim s ls)
    (f : C → Except E Bool)
    (findprev : F → S → Index → SearchM E (Option (Index × Index)))
    (splitter : F) (hsearch : ∀ i, findprev splitter s i = predFindprevE prim f s i)
    (limit : Index) (keep : Bool) (remaining : Index) (hsplit : ls = rev.reverse++after)
    (hfinal : remaining.val = 0 ∨ findSpec f rev = .ok none) :
    ViewedOutput prim errs (reverseStep prim errs s findprev splitter limit keep)
      (some (reverseStart rev,remaining))
      (if !keep && rev.isEmpty then [] else [(charsIn rev).reverse],none) := by
  obtain ⟨out,hout,hparent,hview⟩ := reverseView prim errs s ls rev after law hsplit
  have hstep := reverseStep_final prim errs s ls rev after law f findprev splitter hsearch
    limit keep remaining out hsplit hfinal hout
  have hdone := viewedOutput_done prim errs (reverseStep prim errs s findprev splitter limit keep)
    (some (int (-1),remaining-int 1))
    (reverseStep_stop prim errs s findprev splitter limit keep _ _ (by decide))
  cases rev with
  | nil =>
    have hone : (int 1).val = 1 := by decide
    have hzero : (int 0).val = 0 := by decide
    cases keep with
    | false =>
      simp only [reverseStart,hone,hzero,decide_true,Bool.not_false,Bool.true_and,ite_true] at hstep
      exact viewedOutput_done prim errs _ _ hstep
    | true =>
      simp only [Bool.not_true,Bool.and_false,Bool.false_eq_true,ite_false] at hstep
      exact viewedOutput_emit prim errs _ _ out _ [] ([],none) hstep hview hdone
  | cons p ps =>
    have hs : ls = ps.reverse ++ p::after := by
      simpa only [List.reverse_cons,List.append_assoc,List.singleton_append] using hsplit
    have hlo := (walkGetindex prim s ls law ps.reverse p.1 p.2 after hs).2.1
    have hguard : decide ((int 1).val > (reverseStart (p::ps)).val) = false := by
      have hone : (int 1).val = 1 := by decide
      simp only [hone,reverseStart,decide_eq_false_iff_not]
      omega
    simp only [hguard,Bool.false_and,Bool.false_eq_true,ite_false] at hstep
    simpa only [List.isEmpty_cons,Bool.and_false,Bool.false_eq_true,ite_false] using
      viewedOutput_emit prim errs _ _ out _ _ ([],none) hstep hview hdone

theorem splitSpecE_one_noScan {C E : Type} (f : C → Except E Bool) (keep : Bool) (cs : List C) :
    splitSpecE f keep false 1 [] cs = (if !keep && cs.isEmpty then [] else [cs],none) := by
  cases cs <;> simp [splitSpecE]

theorem splitSpecE_hitMore {C E : Type} (f : C → Except E Bool) (keep scan : Bool) (k : Nat)
    (before after : List C) (c : C) (hfalse : ∀ d ∈ before, f d = .ok false)
    (hc : f c = .ok true) (hk : k ≠ 1) :
    splitSpecE f keep scan k [] (before ++ c::after) =
      if !keep && before.isEmpty then splitSpecE f keep scan k [] after
      else let tail := splitSpecE f keep scan (k-1) [] after
        (before::tail.1,tail.2) := by
  rw [splitSpecE_skip f keep scan k before [] (c::after) (Or.inr hk) hfalse]
  simp [splitSpecE,hc,hk]

theorem splitSpecE_errorMore {C E : Type} (f : C → Except E Bool) (keep scan : Bool) (k : Nat)
    (before after : List C) (c : C) (e : E) (hfalse : ∀ d ∈ before, f d = .ok false)
    (hc : f c = .error e) (hk : k ≠ 1) :
    splitSpecE f keep scan k [] (before ++ c::after) = ([],some e) := by
  rw [splitSpecE_skip f keep scan k before [] (c::after) (Or.inr hk) hfalse]
  simp [splitSpecE,hc,hk]

theorem reverseAll {S R C CU CT E F : Type} (prim : StringOps S R C CU CT E)
    (errs : ViewErrors S E) (s : S) (ls : List (Index × C)) (law : Lawful prim s ls)
    (f : C → Except E Bool)
    (findprev : F → S → Index → SearchM E (Option (Index × Index)))
    (splitter : F) (hsearch : ∀ i, findprev splitter s i = predFindprevE prim f s i)
    (limit : Index) (keep : Bool) :
    ∀ (m : Nat) (rev after : List (Index × C)) (remaining : Index) (k : Nat),
    rev.length = m → ls = rev.reverse++after → ReverseBudget remaining k rev.length →
    let spec := splitSpecE f keep false k [] (charsIn rev)
    ViewedOutput prim errs (reverseStep prim errs s findprev splitter limit keep)
      (some (reverseStart rev,remaining)) (spec.1.map List.reverse,spec.2) := by
  intro m
  induction m using Nat.strongRecOn with
  | ind m ih =>
    intro rev after remaining k hlen hsplit hbudget
    dsimp only
    have hone : (int 1).val = 1 := by decide
    have hlenAll := walkLengthBound prim s law.walk
    rw [hone] at hlenAll
    have hbound := walkEndBound prim s law.walk
    have hrevlen : rev.length ≤ ls.length := by
      rw [hsplit,List.length_append,List.length_reverse]; omega
    have hmax : (rev.length:Int) < IntTy.max .i64 := by omega
    by_cases hk : k = 1
    · subst k
      have hzero := (reverseBudget_zero remaining 1 rev.length hbudget).mpr rfl
      have ht := reverseTailViewed prim errs s ls rev after law f findprev splitter hsearch
        limit keep remaining hsplit (Or.inl hzero)
      simp only [splitSpecE_one_noScan]
      cases hd : !keep && rev.isEmpty <;>
        simpa only [charsIn,List.isEmpty_map,hd,Bool.false_eq_true,ite_false,ite_true,
          List.map_nil,List.map_cons] using ht
    · have hn : remaining.val ≠ 0 := fun he => hk ((reverseBudget_zero remaining k rev.length hbudget).mp he)
      cases hfind : findSpec f rev with
      | error e =>
        obtain ⟨mid,j,c,before,hrest,hfalse,herr⟩ := findSpec_error f rev e hfind
        have hchars : charsIn rev = charsIn mid ++ c::charsIn before := by simp [hrest,charsIn]
        simp only [hchars,splitSpecE_errorMore f keep false k (charsIn mid) (charsIn before)
          c e (charsFalse f mid hfalse) herr hk,List.map_nil]
        exact viewedOutput_error prim errs _ _ e (reverseStep_error prim errs s ls rev after law f
          findprev splitter hsearch limit keep remaining e hsplit hn hfind)
      | ok result =>
        cases result with
        | none =>
          have hfalse := charsFalse f rev (findSpec_none f rev hfind)
          have hs := splitSpecE_noHit f keep false k [] (charsIn rev) hfalse
          have ht := reverseTailViewed prim errs s ls rev after law f findprev splitter hsearch
            limit keep remaining hsplit (Or.inr hfind)
          simp only [hs,List.reverse_nil,List.nil_append]
          cases hd : !keep && rev.isEmpty <;>
            simpa only [charsIn,List.isEmpty_map,hd,Bool.false_eq_true,ite_false,ite_true,
              List.map_nil,List.map_cons] using ht
        | some j =>
          obtain ⟨mid,c,before,hrest,hfalse,htrue⟩ := findSpec_some f rev j hfind
          have hs : ls = before.reverse++(j,c)::(mid.reverse++after) := by
            simpa only [hrest,List.reverse_append,List.reverse_cons,List.append_assoc,
              List.singleton_append,List.cons_append,List.nil_append] using hsplit
          have hshort : before.length < m := by
            rw [←hlen,hrest,List.length_append,List.length_cons]; omega
          obtain ⟨frm,out,hfrm,hprev,hout,hparent,hview,hEmpty,hNonempty⟩ :=
            reverseDelimiterView prim errs s ls rev after mid before law j c hsplit hrest
          have hchars : charsIn rev = charsIn mid ++ c::charsIn before := by simp [hrest,charsIn]
          have hspec := splitSpecE_hitMore f keep false k (charsIn mid) (charsIn before) c
            (charsFalse f mid hfalse) htrue hk
          simp only [hchars,hspec]
          have hmidEmpty : (charsIn mid).isEmpty = mid.isEmpty := by simp [charsIn]
          simp only [hmidEmpty]
          by_cases hdrop : keep = false ∧ mid = []
          · obtain ⟨hkeep,hmid⟩ := hdrop
            subst keep
            subst mid
            simp only [Bool.not_false,List.isEmpty_nil,Bool.true_and,ite_true]
            have ht := ih before.length hshort before ((j,c)::([].reverse++after)) remaining k rfl hs
              (reverseBudget_skip remaining k rev.length before.length hbudget (by omega))
            exact viewedOutput_step_eq prim errs (reverseStep prim errs s findprev splitter limit false)
              (some (reverseStart rev,remaining)) (some (reverseStart before,remaining)) _
              (reverseStep_skip prim errs s ls rev after law f findprev splitter hsearch limit remaining j
                frm (reverseStart before) hsplit hn hfind hfrm hprev (hEmpty rfl)
                (reverseStartFacts prim s ls before _ law hs).1) ht
          · have hguard : ¬(!keep && mid.isEmpty) = true := by
              cases keep <;> cases mid <;> simp_all
            simp only [if_neg hguard]
            have hmodel : ¬(decide (frm.val > (reverseStart rev).val) && !keep) = true := by
              cases keep with
              | true => simp
              | false =>
                have hmid : mid ≠ [] := fun he => hdrop ⟨rfl,he⟩
                have hle := hNonempty hmid
                simp only [Bool.not_false,Bool.and_true,decide_eq_true_eq]
                omega
            have ht := ih before.length hshort before ((j,c)::(mid.reverse++after))
              (remaining-int 1) (k-1) rfl hs
              (reverseBudget_step remaining k rev.length before.length hbudget hk (by omega) hmax)
            exact viewedOutput_emit prim errs _ _ out (reverseStart before,remaining-int 1)
              (charsIn mid).reverse _
              (reverseStep_hit prim errs s ls rev after law f findprev splitter hsearch limit keep remaining
                j frm (reverseStart before) out hsplit hn hfind hfrm hprev hmodel hout) hview ht

end SplitReverse

section ReversePure

def snocPiece {C : Type} (c : C) : List (List C) → List (List C)
  | [] => [[c]]
  | [p] => [p++[c]]
  | p::q::ps => p::snocPiece c (q::ps)

theorem snocPiece_appendLast {C : Type} (c : C) (before : List (List C)) (last : List C) :
    snocPiece c (before++[last]) = before++[last++[c]] := by
  induction before with
  | nil => rfl
  | cons p ps ih =>
    cases ps with
    | nil => rfl
    | cons q qs =>
      change p::snocPiece c ((q::qs)++[last]) = p::((q::qs)++[last++[c]])
      rw [ih]

theorem splitPieces_snoc {C : Type} (f : C → Bool) (cs : List C) (c : C) :
    splitPieces f (cs++[c]) =
      if f c then splitPieces f cs++[[]] else snocPiece c (splitPieces f cs) := by
  induction cs with
  | nil => cases hf : f c <;> simp [splitPieces,snocPiece,hf]
  | cons d ds ih =>
    have hnonempty := splitPieces_nonempty f ds
    cases hp : splitPieces f ds with
    | nil => contradiction
    | cons p ps =>
      cases ps <;> cases hd : f d <;> cases hc : f c <;>
        simp [splitPieces,snocPiece,ih,hp,hd,hc,List.cons_append]

theorem splitPieces_reverse {C : Type} (f : C → Bool) (cs : List C) :
    splitPieces f cs.reverse = (splitPieces f cs).reverse.map List.reverse := by
  induction cs with
  | nil => rfl
  | cons c cs ih =>
    rw [List.reverse_cons,splitPieces_snoc,ih]
    have hnonempty := splitPieces_nonempty f cs
    cases hp : splitPieces f cs with
    | nil => contradiction
    | cons p ps =>
      cases hc : f c with
      | true => simp [splitPieces,hc,hp,List.reverse_cons]
      | false =>
        simp only [hc,Bool.false_eq_true,ite_false,splitPieces,hp,List.reverse_cons,
          List.map_append,List.map_cons,List.map_nil]
        rw [snocPiece_appendLast]

theorem splitPieces_reverse_views {C : Type} (f : C → Bool) (cs : List C) :
    (splitPieces f cs.reverse).map List.reverse = (splitPieces f cs).reverse := by
  rw [splitPieces_reverse]
  simp [Function.comp_def]

end ReversePure

section ReverseResults

theorem reverseStartLast {S R C CU CT E : Type} (prim : StringOps S R C CU CT E)
    (s : S) (ls rev : List (Index × C)) (law : Lawful prim s ls) (hsplit : ls = rev.reverse) :
    (gFull prim).lastindex s = .ok (reverseStart rev) := by
  cases rev with
  | nil =>
    obtain ⟨last,hlast,_,_,hempty,_⟩ := lawfulLastIndex prim s ls law
    have hls : ls = [] := by simpa only [List.reverse_nil] using hsplit
    have heq : last = int 0 := Subtype.ext (by rw [hempty hls]; rfl)
    simpa only [reverseStart,heq] using hlast
  | cons p ps =>
    have hlast : ls.getLast? = some p := by rw [hsplit]; simp
    exact (layoutLastFacts prim s ls law p hlast).1

theorem reverseStep_start {S R C CU CT E F : Type} (prim : StringOps S R C CU CT E)
    (errs : ViewErrors S E) (s : S)
    (findprev : F → S → Index → JuliaLean.base.strings.search.SearchM E (Option (Index × Index)))
    (splitter : F) (limit : Index) (keep : Bool) (last : Index)
    (hlast : (gFull prim).lastindex s = .ok last) :
    reverseStep prim errs s findprev splitter limit keep none =
      reverseStep prim errs s findprev splitter limit keep (some (last,limit-int 1)) := by
  unfold reverseStep iterateRSplit
  dsimp only [splitOps]
  rw [hlast]
  rfl

theorem reverseOutput {S R C CU CT E F : Type} (prim : StringOps S R C CU CT E)
    (errs : ViewErrors S E) (s : S) (ls : List (Index × C)) (law : Lawful prim s ls)
    (f : C → Except E Bool)
    (findprev : F → S → Index → JuliaLean.base.strings.search.SearchM E (Option (Index × Index)))
    (splitter : F) (hsearch : ∀ i, findprev splitter s i = predFindprevE prim f s i)
    (limit : Index) (keep : Bool) :
    let spec := splitSpecE f keep false (limitCount limit) [] (charsIn ls).reverse
    ViewedOutput prim errs (reverseStep prim errs s findprev splitter limit keep) none
      (spec.1.map List.reverse,spec.2) := by
  have hlen := walkLengthBound prim s law.walk
  have hone : (int 1).val = 1 := by decide
  rw [hone] at hlen
  have hbound := walkEndBound prim s law.walk
  have hmax : (ls.reverse.length:Int) < IntTy.max .i64 := by simp only [List.length_reverse]; omega
  have hs : ls = ls.reverse.reverse++[] := by simp
  have ht := reverseAll prim errs s ls law f findprev splitter hsearch limit keep
    ls.reverse.length ls.reverse [] (limit-int 1) (limitCount limit) rfl hs
    (reverseBudget_initial limit ls.reverse.length hmax)
  have hlast := reverseStartLast prim s ls ls.reverse law (by simp)
  have hroot := viewedOutput_step_eq prim errs (reverseStep prim errs s findprev splitter limit keep)
    none (some (reverseStart ls.reverse,limit-int 1)) _
    (reverseStep_start prim errs s findprev splitter limit keep _ hlast) ht
  simpa only [charsIn,List.map_reverse] using hroot

theorem rsplitRuns_proven : RsplitRuns := by
  intro S R C CU CT E prim errs f s ls limit keep input
  have ht := reverseOutput prim errs s ls input.lawful f
    (fun f s k => predFindprevE prim f s k) f (fun _ => rfl) limit keep
  change ViewedOutput prim errs (rsplitStepE prim errs s f limit keep) none
    ((splitSpecE f keep false (limitCount limit) [] (charsIn ls).reverse).1.map List.reverse,
      (splitSpecE f keep false (limitCount limit) [] (charsIn ls).reverse).2) at ht
  obtain ⟨pieces,hview,htrace⟩ := ht
  constructor
  · intro hnone
    exact ⟨pieces,by simpa only [hnone] using htrace,hview⟩
  · intro e he
    exact ⟨pieces,by simpa only [he] using htrace,hview⟩

theorem reversePureOutput {S R C CU CT E : Type} (prim : StringOps S R C CU CT E)
    (errs : ViewErrors S E) (s : S) (ls : List (Index × C)) (law : Lawful prim s ls)
    (f : C → Bool) (limit : Index) (keep : Bool) :
    ∃ pieces, Emits (rsplitStep prim errs s f limit keep) none pieces ∧
      ViewsIterate prim errs pieces
        ((splitSpecAux f keep (limitCount limit) [] (charsIn ls).reverse).map List.reverse) := by
  have ht := reverseOutput prim errs s ls law (fun c => .ok (f c))
    (fun f s k => predFindprev prim f s k) f (fun _ => rfl) limit keep
  change ViewedOutput prim errs (rsplitStep prim errs s f limit keep) none
    ((splitSpecE (fun c => .ok (f c)) keep false (limitCount limit) [] (charsIn ls).reverse).1.map List.reverse,
      (splitSpecE (fun c => .ok (f c)) keep false (limitCount limit) [] (charsIn ls).reverse).2) at ht
  simp only [splitSpecE_pure] at ht
  obtain ⟨pieces,hview,htrace⟩ := ht
  exact ⟨pieces,htrace,hview⟩

theorem reverseSplitLimit_proven : ReverseSplitLimit := by
  intro S R C CU CT E prim errs f s ls limit keep input hlimit
  have hn : ¬limit.val ≤ 0 := by omega
  have hk : 0 < limit.val.toNat := by
    have hv := Int.toNat_of_nonneg (by omega : 0 ≤ limit.val)
    omega
  obtain ⟨pieces,htrace,hview⟩ := reversePureOutput prim errs s ls input.lawful f limit keep
  simp only [limitCount,if_neg hn] at hview
  refine ⟨pieces,htrace,?_⟩
  rw [viewedLength prim errs pieces _ hview,List.length_map]
  exact splitSpecAux_bound f keep limit.val.toNat [] (charsIn ls).reverse hk

theorem rsplitJoin_proven : RsplitJoin := by
  intro S R C CU CT E prim errs f s ls limit input hlimit
  obtain ⟨pieces,htrace,hview⟩ := reversePureOutput prim errs s ls input.lawful f limit true
  refine ⟨pieces,htrace,?_⟩
  simpa only [limitCount,if_pos hlimit,splitSpecAux_zero_empty,splitPieces_reverse_views] using hview

end ReverseResults


