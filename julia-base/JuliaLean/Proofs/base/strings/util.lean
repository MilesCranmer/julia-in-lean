namespace ChatGPTBatch1.Navigation
open JuliaLean JuliaLean.base.strings.basic JuliaLean.base.strings.util
open JuliaLean.Proofs.base.strings.util.Round6

private theorem navIntVal (z : Int) (lo : -(2 ^ 63) ≤ z) (hi : z < 2 ^ 63) :
    (int z).val = z := by
  change wrapInt .i64 z = z
  exact wrapInt_of_inRange .i64 z (by
    simp [IntTy.min, IntTy.max, IntTy.signed, IntTy.bits]
    omega)

private theorem navAddVal (a b : Index) (lo : -(2 ^ 63) ≤ a.val + b.val)
    (hi : a.val + b.val < 2 ^ 63) : (a + b).val = a.val + b.val := by
  change wrapInt .i64 (a.val + b.val) = _
  exact wrapInt_of_inRange .i64 _ (by
    simp [IntTy.min, IntTy.max, IntTy.signed, IntTy.bits]
    omega)

private theorem navSubVal (a b : Index) (lo : -(2 ^ 63) ≤ a.val - b.val)
    (hi : a.val - b.val < 2 ^ 63) : (a - b).val = a.val - b.val := by
  change wrapInt .i64 (a.val - b.val) = _
  exact wrapInt_of_inRange .i64 _ (by
    simp [IntTy.min, IntTy.max, IntTy.signed, IntTy.bits]
    omega)

private theorem navWalkEnd {S R C CU CT E : Type}
    (prim : StringOps S R C CU CT E) (s : S) {i : Index} {ls : List (Index × C)}
    (w : Walk prim s i ls) : (prim.ncodeunits s).val + 1 < 2 ^ 63 := by
  induction w with
  | @stop i atEnd done =>
    have hi := i.property.2
    simp [IntTy.max, IntTy.signed, IntTy.bits] at hi
    omega
  | step bounds yield advances tail ih => exact ih

private theorem navWalkStart {S R C CU CT E : Type}
    (prim : StringOps S R C CU CT E) (s : S) {i : Index} {ls : List (Index × C)}
    (w : Walk prim s i ls) : i.val ≤ (prim.ncodeunits s).val + 1 := by
  cases w with
  | stop atEnd done => omega
  | step bounds yield advances tail => omega

private theorem navWalkLower {S R C CU CT E : Type}
    (prim : StringOps S R C CU CT E) (s : S) {i : Index} {ls : List (Index × C)}
    (w : Walk prim s i ls) : ∀ p ∈ ls, i.val ≤ p.1.val := by
  induction w with
  | stop atEnd done => intro p hp; simp at hp
  | @step i j c rest bounds yield advances tail ih =>
    intro p hp
    rcases List.mem_cons.mp hp with he | ht
    · subst p; exact Int.le_refl _
    · have h := ih p ht; omega

private theorem navWalkBefore {S R C CU CT E : Type}
    (prim : StringOps S R C CU CT E) (s : S) {start : Index}
    {layout : List (Index × C)} (walk : Walk prim s start layout)
    (before : List (Index × C)) (i : Index) (c : C) (rest : List (Index × C))
    (hsplit : layout = before ++ (i,c) :: rest) :
    ∀ p ∈ before, p.1.val < i.val := by
  induction before generalizing start layout with
  | nil => simp
  | cons p before ih =>
    cases walk with
    | stop atEnd done => simp at hsplit
    | @step start next d tail bounds yield advances wtail =>
      have hp : (start,d) = p := (List.cons.inj hsplit).1
      have ht : tail = before ++ (i,c) :: rest := (List.cons.inj hsplit).2
      have hm : (i,c) ∈ tail := by rw [ht]; simp
      have hlo : next.val ≤ i.val := navWalkLower prim s wtail (i,c) hm
      intro q hq
      rcases List.mem_cons.mp hq with hq | hq
      · subst q
        have hpv : p.1.val = start.val := congrArg (fun p : Index × C => p.1.val) hp.symm
        omega
      · exact ih wtail ht q hq

private theorem navGap {S R C CU CT E : Type}
    (prim : StringOps S R C CU CT E) (s : S) (layout : List (Index × C))
    (law : Lawful prim s layout) (before rest : List (Index × C))
    (i j : Index) (c : C) (hsplit : layout = before ++ (i,c) :: rest)
    (tail : Walk prim s j rest) (hij : i.val < j.val) :
    ∀ k : Index, i.val < k.val → k.val < j.val →
      prim.isvalid s k = .ok false := by
  intro k hik hkj
  have hb : 1 ≤ i.val ∧ i.val ≤ (prim.ncodeunits s).val :=
    lawfulPairIndexBounds prim s layout law (i,c) (by rw [hsplit]; simp)
  have hj := navWalkStart prim s tail
  have ha : layout.any (fun p => p.1.val == k.val) = false := by
    cases hh : layout.any (fun p => p.1.val == k.val) with
    | false => rfl
    | true =>
      obtain ⟨p,hp,hpk⟩ := List.any_eq_true.mp hh
      have hpv : p.1.val = k.val := by simpa using beq_iff_eq.mp hpk
      rw [hsplit] at hp
      rcases List.mem_append.mp hp with hbefore | hcurrent
      · have hlt := navWalkBefore prim s law.walk before i c rest hsplit p hbefore
        omega
      · rcases List.mem_cons.mp hcurrent with hhead | hrest
        · have hi : p.1.val = i.val := congrArg (fun p : Index × C => p.1.val) hhead
          omega
        · have hge := navWalkLower prim s tail p hrest
          omega
  simpa only [ha] using law.isvalid k (by omega) (by omega)

private theorem navValid {S R C CU CT E : Type}
    (prim : StringOps S R C CU CT E) (s : S) (layout : List (Index × C))
    (law : Lawful prim s layout) (i : Index) (c : C) (hm : (i,c) ∈ layout) :
    prim.isvalid s i = .ok true := by
  have hb := lawfulPairIndexBounds prim s layout law (i,c) hm
  have ha : layout.any (fun p => p.1.val == i.val) = true :=
    List.any_eq_true.mpr ⟨(i,c), hm, by simp⟩
  simpa only [ha] using law.isvalid i hb.1 hb.2

private theorem navNextZero {S R C CU CT E : Type}
    (prim : StringOps S R C CU CT E) (s : S) (z i : Index) :
    ∀ fuel, nextindLoop prim s z fuel i (int 0) = .ok i := by
  have hzero : i + int 0 = i := by
    apply Subtype.ext
    change wrapInt .i64 (i.val + (int 0).val) = i.val
    rw [JuliaLean.Proofs.base.strings.basic.int_zero_val, Int.add_zero]
    exact wrapInt_of_inRange .i64 i.val i.property
  intro fuel
  cases fuel <;> simp [nextindLoop, hzero,
    JuliaLean.Proofs.base.strings.basic.int_zero_val]

private theorem navNextGap {S R C CU CT E : Type}
    (prim : StringOps S R C CU CT E) (s : S) (target n : Index)
    (htarget : target.val ≤ (prim.ncodeunits s).val)
    (hvalid : prim.isvalid s target = .ok true) (hn : 0 < n.val) :
    ∀ (fuel : Nat) (i : Index), 0 ≤ i.val → i.val < target.val →
      (target.val - i.val).toNat ≤ fuel →
      (∀ k : Index, i.val < k.val → k.val < target.val →
        prim.isvalid s k = .ok false) →
      nextindLoop prim s (prim.ncodeunits s) fuel i n =
        nextindLoop prim s (prim.ncodeunits s)
          (fuel - (target.val - i.val).toNat) target (n - int 1) := by
  intro fuel
  induction fuel with
  | zero => intro i hi hit hf hinv; omega
  | succ fuel ih =>
    intro i hi hit hf hinv
    have hi' : (i + int 1).val = i.val + 1 := by
      apply navAddVal
      · have h1 : (int 1).val = 1 := by decide
        omega
      · have hmax := target.property.2
        simp [IntTy.max, IntTy.bits, IntTy.signed] at hmax
        have h1 : (int 1).val = 1 := by decide
        omega
    have hil : i.val < (prim.ncodeunits s).val := by omega
    by_cases he : (i + int 1).val = target.val
    · have heq : i + int 1 = target := Subtype.ext he
      have hdiff : (target.val - i.val).toNat = 1 := by omega
      simp only [nextindLoop, hn, hil, decide_true, Bool.and_self, ↓reduceIte,
        heq, hvalid, bind, Except.bind, boolInt, hdiff, Nat.add_sub_cancel]
    · have hlt : (i + int 1).val < target.val := by omega
      have hv := hinv (i + int 1) (by omega) hlt
      have hsub : n - boolInt false = n := by
        apply Subtype.ext
        change wrapInt .i64 (n.val - 0) = n.val
        simpa only [Int.sub_zero] using wrapInt_of_inRange .i64 n.val n.property
      have hrec := ih (i + int 1) (by omega) hlt (by omega)
        (fun k hk hkt => hinv k (by omega) hkt)
      have hfu : fuel - (target.val - (i + int 1).val).toNat =
          fuel + 1 - (target.val - i.val).toNat := by omega
      rw [hfu] at hrec
      simpa only [nextindLoop, hn, hil, decide_true, Bool.and_self, ↓reduceIte,
        hv, bind, Except.bind, hsub] using hrec

private theorem navNextLast {S R C CU CT E : Type}
    (prim : StringOps S R C CU CT E) (s : S) (n : Index) (hn : 0 < n.val) :
    ∀ (fuel : Nat) (i : Index), 0 ≤ i.val → i.val ≤ (prim.ncodeunits s).val →
      ((prim.ncodeunits s).val - i.val).toNat ≤ fuel →
      (∀ k : Index, i.val < k.val → k.val ≤ (prim.ncodeunits s).val →
        prim.isvalid s k = .ok false) →
      nextindLoop prim s (prim.ncodeunits s) fuel i n = .ok (prim.ncodeunits s + n) := by
  intro fuel
  induction fuel with
  | zero =>
    intro i hi hiz hf hinv
    have heq : i = prim.ncodeunits s := Subtype.ext (by omega)
    subst i
    rfl
  | succ fuel ih =>
    intro i hi hiz hf hinv
    by_cases he : i.val = (prim.ncodeunits s).val
    · have heq : i = prim.ncodeunits s := Subtype.ext he
      subst i
      simp only [nextindLoop, Int.lt_irrefl, decide_false, Bool.and_false, Bool.false_eq_true, ite_false]
    · have hil : i.val < (prim.ncodeunits s).val := by omega
      have hi' : (i + int 1).val = i.val + 1 := by
        apply navAddVal
        · have h1 : (int 1).val = 1 := by decide
          omega
        · have hmax := (prim.ncodeunits s).property.2
          simp [IntTy.max, IntTy.bits, IntTy.signed] at hmax
          have h1 : (int 1).val = 1 := by decide
          omega
      have hv := hinv (i + int 1) (by omega) (by omega)
      have hsub : n - boolInt false = n := by
        apply Subtype.ext
        change wrapInt .i64 (n.val - 0) = n.val
        simpa only [Int.sub_zero] using wrapInt_of_inRange .i64 n.val n.property
      have hrec := ih (i + int 1) (by omega) (by omega) (by omega)
        (fun k hk hkz => hinv k (by omega) hkz)
      simpa only [nextindLoop, hn, hil, decide_true, Bool.and_self, ↓reduceIte,
        hv, bind, Except.bind, hsub] using hrec

private def navNextResult {C : Type} (z : Index) (pairs : List (Index × C)) (n : Nat) : Index :=
  match pairs[n]? with
  | some p => p.1
  | none => int (z.val + n - pairs.length + 1)

private theorem navNextResultCons {C : Type} (z : Index) (i : Index) (c : C)
    (rest : List (Index × C)) (n : Nat) :
    navNextResult z ((i,c) :: rest) (n + 1) = navNextResult z rest n := by
  simp only [navNextResult, List.getElem?_cons_succ]
  split
  · rfl
  · congr 1
    simp only [List.length_cons, Int.natCast_add, Int.natCast_one]
    omega

private theorem navNextByWalk {S R C CU CT E : Type}
    (prim : StringOps S R C CU CT E) (s : S) (layout : List (Index × C))
    (law : Lawful prim s layout) :
    ∀ (n : Nat) before i c rest, n < 2 ^ 63 → layout = before ++ (i,c) :: rest →
      Walk prim s i ((i,c) :: rest) →
      ∀ fuel, ((prim.ncodeunits s).val - i.val).toNat ≤ fuel →
      nextindLoop prim s (prim.ncodeunits s) fuel i (int n) =
        .ok (navNextResult (prim.ncodeunits s) ((i,c) :: rest) n) := by
  intro n
  induction n with
  | zero =>
    intro before i c rest hn hsplit walk fuel hfuel
    exact navNextZero prim s (prim.ncodeunits s) i fuel
  | succ n ih =>
    intro before i c rest hn hsplit walk fuel hfuel
    have hnval : (int ((n + 1 : Nat) : Int)).val = n + 1 := navIntVal _ (by omega) (by omega)
    have hnpos : 0 < (int ((n + 1 : Nat) : Int)).val := by omega
    cases walk with
    | @step i j c rest bounds yield advances tail =>
      have hgap := navGap prim s layout law before rest i j c hsplit tail advances
      cases tail with
      | stop atEnd done =>
        have hrun := navNextLast prim s (int ((n + 1 : Nat) : Int)) hnpos fuel i
          (by omega) bounds.2 hfuel (fun k hk hkz => hgap k hk (by omega))
        rw [hrun]
        apply congrArg (Except.ok (ε := E))
        simp only [navNextResult, List.getElem?_cons_succ, List.getElem?_nil]
        apply Subtype.ext
        change wrapInt .i64 ((prim.ncodeunits s).val + (int ((n + 1 : Nat) : Int)).val) =
          wrapInt .i64 ((prim.ncodeunits s).val + ((n + 1 : Nat) : Int) - 1 + 1)
        rw [hnval]
        apply congrArg (wrapInt .i64)
        omega
      | @step j next d tail boundsj yieldj advancesj wtail =>
        have hmem : (j,d) ∈ layout := by rw [hsplit]; simp
        have hv := navValid prim s layout law j d hmem
        have hg := navNextGap prim s j (int ((n + 1 : Nat) : Int)) boundsj.2 hv hnpos
          fuel i (by omega) advances (by omega) hgap
        have hsub : int ((n + 1 : Nat) : Int) - int 1 = int (n : Int) := by
          apply Subtype.ext
          have h1 : (int 1).val = 1 := by decide
          rw [navSubVal _ _ (by omega) (by omega), hnval, h1,
            navIntVal (n : Int) (by omega) (by omega)]
          omega
        rw [hg, hsub]
        have hsplit' : layout = (before ++ [(i,c)]) ++ (j,d) :: tail := by
          simpa only [List.append_assoc, List.singleton_append] using hsplit
        have hrest := ih (before ++ [(i,c)]) j d tail (by omega) hsplit'
          (Walk.step boundsj yieldj advancesj wtail)
          (fuel - (j.val - i.val).toNat) (by omega)
        rw [hrest, navNextResultCons]


private theorem navNextG {S R C CU CT E : Type}
    (prim : StringOps S R C CU CT E) (s : S) (layout : List (Index × C))
    (law : Lawful prim s layout) (before : List (Index × C)) (i : Index) (c : C)
    (rest : List (Index × C)) (n : Index) (hn : 0 ≤ n.val)
    (hsplit : layout = before ++ (i,c) :: rest) (walk : Walk prim s i ((i,c) :: rest)) :
    (gFull prim).nextind s i n =
      .ok (navNextResult (prim.ncodeunits s) ((i,c) :: rest) n.val.toNat) := by
  have hb : 1 ≤ i.val ∧ i.val ≤ (prim.ncodeunits s).val :=
    lawfulPairIndexBounds prim s layout law (i,c) (by rw [hsplit]; simp)
  have hnmax := n.property.2
  simp [IntTy.max, IntTy.bits, IntTy.signed] at hnmax
  have hnc := navWalkEnd prim s law.walk
  have hnEq : int (n.val.toNat : Int) = n := by
    apply Subtype.ext
    rw [navIntVal _ (by omega) (by omega)]
    omega
  have hloop := navNextByWalk prim s layout law n.val.toNat before i c rest
    (by omega) hsplit walk ((prim.ncodeunits s).val - i.val).toNat (by omega)
  rw [hnEq] at hloop
  have hneg : ¬ n.val < 0 := by omega
  by_cases hn0 : n.val = 0
  · have hnv : n.val.toNat = 0 := by omega
    have hv := navValid prim s layout law i c (by rw [hsplit]; simp)
    have ht := JuliaLean.Proofs.base.strings.basic.thisindInt_rewind prim s i i
      hb.1 (by omega) hb.2 (by omega) (Or.inr hv) (fun k hk => by omega)
    simp [gFull, modelStringOps, nextindInt, hneg, show 0 ≤ i.val by omega, hb.2,
      hn0, ht, hnv, navNextResult, bind, Except.bind, pure, Except.pure]
  · simpa [gFull, modelStringOps, nextindInt, hneg, show 0 ≤ i.val by omega, hb.2,
      hn0, JuliaLean.Proofs.base.strings.basic.nextindLoop_thisindOps] using hloop

private theorem navWalkSuffix {S R C CU CT E : Type}
    (prim : StringOps S R C CU CT E) (s : S) {i : Index}
    {pairs : List (Index × C)} (walk : Walk prim s i pairs)
    (before suffix : List (Index × C)) (hsplit : pairs = before ++ suffix) :
    ∃ j, Walk prim s j suffix := by
  induction before generalizing i pairs with
  | nil => exact ⟨i, by simpa only [List.nil_append, hsplit] using walk⟩
  | cons p before ih =>
    cases walk with
    | stop atEnd done => simp at hsplit
    | @step i j c rest bounds yield advances tail =>
      have ht : rest = before ++ suffix := (List.cons.inj hsplit).2
      exact ih tail ht

private theorem navBeforeLast {S R C CU CT E : Type}
    (prim : StringOps S R C CU CT E) (s : S) (layout : List (Index × C))
    (law : Lawful prim s layout) (p : Index × C) (hlast : layout.getLast? = some p) :
    (gFull prim).lastindex s = .ok p.1 ∧
      (∀ q ∈ layout, q.1.val ≤ p.1.val) := by
  obtain ⟨before, he⟩ := List.getLast?_eq_some_iff.mp hlast
  have hp : p ∈ layout := by rw [he]; simp
  have hb := lawfulPairIndexBounds prim s layout law p hp
  have hv := navValid prim s layout law p.1 p.2 hp
  have hmax := navWalkEnd prim s law.walk
  have he' : layout = before ++ (p.1,p.2) :: [] := by simpa only [Prod.eta] using he
  have hle : ∀ q ∈ layout, q.1.val ≤ p.1.val := by
    intro q hq
    rw [he] at hq
    rcases List.mem_append.mp hq with hpre | hlast
    · have hlt := navWalkBefore prim s law.walk before p.1 p.2 [] he' q hpre
      omega
    · have hqp : q = p := by simpa only [List.mem_singleton] using hlast
      subst q
      omega
  have hinv : ∀ k : Index, p.1.val < k.val ∧ k.val ≤ (prim.ncodeunits s).val →
      prim.isvalid s k = .ok false := by
    intro k hk
    have ha : layout.any (fun q => q.1.val == k.val) = false := by
      cases hh : layout.any (fun q => q.1.val == k.val) with
      | false => rfl
      | true =>
        obtain ⟨q,hq,hqk⟩ := List.any_eq_true.mp hh
        have hqv : q.1.val = k.val := by simpa using beq_iff_eq.mp hqk
        have hql := hle q hq
        omega
    simpa only [ha] using law.isvalid k (by omega) hk.2
  refine ⟨?_, hle⟩
  have ht := JuliaLean.Proofs.base.strings.basic.thisindInt_rewind prim s
    (prim.ncodeunits s) p.1 hb.1 hb.2 (by omega) (by omega) (Or.inr hv) hinv
  simpa only [gFull, modelStringOps, lastindexString] using ht

private theorem navNextOne {S R C CU CT E : Type}
    (prim : StringOps S R C CU CT E) (s : S) (layout : List (Index × C))
    (law : Lawful prim s layout) (before : List (Index × C))
    (i : Index) (c : C) (rest : List (Index × C))
    (hsplit : layout = before ++ (i,c) :: rest) :
    ∃ next, nextindOne (gFull prim) s i = .ok next ∧
      Walk prim s next rest ∧ i.val < next.val := by
  obtain ⟨start, walk⟩ := navWalkSuffix prim s law.walk before ((i,c) :: rest) hsplit
  cases walk with
  | @step i next c rest bounds yield advances tail =>
    refine ⟨next, ?_, tail, advances⟩
    have hrun := navNextG prim s layout law before i c rest (int 1) (by decide)
      hsplit (Walk.step bounds yield advances tail)
    have hres : navNextResult (prim.ncodeunits s) ((i,c) :: rest) (int 1).val.toNat = next := by
      cases tail with
      | stop atEnd done =>
        apply Subtype.ext
        have hmax := navWalkEnd prim s law.walk
        have hb := navWalkStart prim s law.walk
        have h1 : (int 1).val = 1 := by decide
        simp only [navNextResult, h1, Int.toNat_one, List.getElem?_cons_succ,
          List.getElem?_nil, List.length_cons, List.length_nil, Int.natCast_one]
        rw [navIntVal _ (by omega) (by omega)]
        omega
      | step bounds' yield' advances' tail' => rfl
    simpa only [nextindOne, hres] using hrun


private theorem navChunksNil {A : Type} (n : Nat) : chunksOf n ([] : List A) = [] := by
  unfold chunksOf
  have hdiv : (0 + n - 1) / n = 0 := by
    by_cases hn : n = 0
    · simp [hn]
    · exact Nat.div_eq_of_lt (by omega)
  rw [List.length_nil, hdiv]
  rfl

private theorem navChunksCons {A : Type} (n : Nat) (xs : List A) (hn : 0 < n) (hx : xs ≠ []) :
    chunksOf n xs = xs.take n :: chunksOf n (xs.drop n) := by
  have hlen : 0 < xs.length := List.length_pos_iff.mpr hx
  have hdiv : (xs.length + n - 1) / n = ((xs.length - n + n - 1) / n) + 1 := by
    by_cases hsmall : xs.length ≤ n
    · have hleft : (xs.length + n - 1) / n = 1 := by
        apply Nat.div_eq_of_lt_le
        · omega
        · omega
      have hright : (xs.length - n + n - 1) / n = 0 := by
        apply Nat.div_eq_of_lt
        omega
      rw [hleft, hright]
    · have he : xs.length + n - 1 = (xs.length - n + n - 1) + n := by omega
      rw [he, Nat.add_div_right _ hn]
  simp only [chunksOf, List.length_drop, hdiv, List.range_succ_eq_map,
    List.map_cons, Nat.zero_mul, List.drop_zero, List.map_map]
  congr 1
  apply List.map_congr_left
  intro k hk
  simp only [Function.comp_apply, List.drop_drop]
  congr 2
  simp only [Nat.succ_mul, Nat.add_comm]

private theorem navPartitionStep {S R C CU CT E : Type}
    (prim : StringOps S R C CU CT E) (errs : ViewErrors S E) (s : S)
    (layout : List (Index × C)) (law : Lawful prim s layout)
    (n : Index) (hn : 0 < n.val) (hmax : n.val + (prim.ncodeunits s).val + 1 < 2 ^ 63)
    (before : List (Index × C)) (i : Index) (c : C) (rest : List (Index × C))
    (hsplit : layout = before ++ (i,c) :: rest) (walk : Walk prim s i ((i,c) :: rest)) :
    ∃ out next,
      iteratePartition (partOps prim errs) ⟨s,n⟩ (some i) = .ok (some (out,next)) ∧
      ViewIterates prim errs out (charsIn (((i,c) :: rest).take n.val.toNat)) ∧
      Walk prim s next (((i,c) :: rest).drop n.val.toNat) := by
  let pairs := (i,c) :: rest
  let size := n.val.toNat
  have hsize : 0 < size := by dsimp [size]; omega
  let part := pairs.take size
  let after := pairs.drop size
  have hpne : part ≠ [] := by
    dsimp [part]
    rw [List.take_eq_nil_iff]
    simp only [pairs, List.cons_ne_nil, or_false]
    omega
  let last := part.getLast hpne
  have hpartLast : part.getLast? = some last := List.getLast?_eq_some_getLast hpne
  obtain ⟨beforeLast, hpLast⟩ := List.getLast?_eq_some_iff.mp hpartLast
  have hpartFirst : part = (i,c) :: rest.take (size - 1) := by
    have hs : size = (size - 1) + 1 := by omega
    have he : pairs.take ((size - 1) + 1) = (i,c) :: rest.take (size - 1) := rfl
    exact (congrArg (fun k => pairs.take k) hs).trans he
  have hsplitPart : layout = before ++ part ++ after := by
    rw [List.append_assoc]
    change layout = before ++ (pairs.take size ++ pairs.drop size)
    rw [List.take_append_drop]
    exact hsplit
  have hsplitLast : layout = (before ++ beforeLast) ++ (last.1,last.2) :: after := by
    rw [hsplitPart, hpLast]
    simp only [List.append_assoc, List.singleton_append, Prod.eta]
  obtain ⟨out, hout, hsource, hview⟩ := Affix.rangeSlice prim errs s layout law before
    beforeLast (rest.take (size - 1)) after i last.1 c last.2
    (hpartFirst.symm.trans hpLast) (by rw [← hpartFirst]; exact hsplitPart)
  obtain ⟨next, hnext, hwalk, hadv⟩ := navNextOne prim s layout law
    (before ++ beforeLast) last.1 last.2 after hsplitLast
  have hne : layout ≠ [] := by rw [hsplit]; simp
  let global := layout.getLast hne
  have hglobal : layout.getLast? = some global := List.getLast?_eq_some_getLast hne
  obtain ⟨hlast, hle⟩ := navBeforeLast prim s layout law global hglobal
  have hb : 1 ≤ i.val ∧ i.val ≤ (prim.ncodeunits s).val :=
    lawfulPairIndexBounds prim s layout law (i,c) (by rw [hsplit]; simp)
  have h1 : (int 1).val = 1 := by decide
  have hcountval : (n - int 1).val = n.val - 1 := by
    apply navSubVal
    · omega
    · have hnt := n.property.2
      simp [IntTy.max, IntTy.bits, IntTy.signed] at hnt
      omega
  have hcount : (n - int 1).val.toNat = size - 1 := by dsimp [size]; omega
  have hrun := navNextG prim s layout law before i c rest (n - int 1)
    (by omega) hsplit walk
  rw [hcount] at hrun
  let through := navNextResult (prim.ncodeunits s) pairs (size - 1)
  have hthrough : (gFull prim).nextind s i (n - int 1) = .ok through := hrun
  have hmin : (if through.val < global.1.val then through else global.1) = last.1 := by
    cases hsel : pairs[size - 1]? with
    | some chosen =>
      have he : chosen = last := by
        have hg := List.getLast?_take (l := pairs) (i := size)
        rw [if_neg (by omega), hsel] at hg
        have hgot : part.getLast? = some chosen := hg
        rw [hpartLast] at hgot
        exact (Option.some.inj hgot).symm
      subst chosen
      have ht : through = last.1 := by simp only [through, navNextResult, hsel]
      have hm : last ∈ layout := by
        rw [hsplit]
        exact List.mem_append_right before (List.mem_of_getElem? hsel)
      have hlg := hle last hm
      by_cases hlt : last.1.val < global.1.val
      · simp only [ht, hlt, ite_true]
      · have heq : global.1 = last.1 := Subtype.ext (by omega)
        rw [ht, if_neg hlt]
        exact heq
    | none =>
      have hlength : pairs.length ≤ size - 1 := List.getElem?_eq_none_iff.mp hsel
      have hpartEq : part = pairs := List.take_of_length_le (by omega)
      have hglobalEq : global = last := by
        have hpLast' : pairs.getLast? = some last := by rw [← hpartEq]; exact hpartLast
        have he : layout.getLast? = some last := by
          rw [hsplit]
          change (before ++ pairs).getLast? = some last
          rw [List.getLast?_append, hpLast']
          rfl
        rw [hglobal] at he
        exact Option.some.inj he
      have htv : through.val = (prim.ncodeunits s).val + (size : Int) - pairs.length := by
        simp only [through, navNextResult, hsel]
        have hsizeval : (size : Int) = n.val := by dsimp [size]; omega
        rw [navIntVal _ (by omega) (by omega)]
        omega
      have hglobalMem : global ∈ layout := List.getLast_mem hne
      have hgb := lawfulPairIndexBounds prim s layout law global hglobalMem
      have hnot : ¬ through.val < global.1.val := by omega
      rw [if_neg hnot, hglobalEq]
  refine ⟨out, next, ?_, ?_, hwalk⟩
  · simp only [iteratePartition, partOps, bind, Except.bind, pure, Except.pure,
      if_neg (show ¬ i.val > (prim.ncodeunits s).val by omega), hthrough, hlast,
      hmin, hout, hnext]
  · simpa only [← hpartFirst] using hview

private theorem navLengthInduction {A : Type} (P : List A → Prop)
    (h : ∀ xs, (∀ ys, ys.length < xs.length → P ys) → P xs) : ∀ xs, P xs := by
  intro xs
  generalize hn : xs.length = n
  induction n using Nat.strongRecOn generalizing xs with
  | ind n ih =>
    apply h xs
    intro ys hy
    exact ih ys.length (by omega) ys rfl

private theorem navPartitionFrom {S R C CU CT E : Type}
    (prim : StringOps S R C CU CT E) (errs : ViewErrors S E) (s : S)
    (layout : List (Index × C)) (law : Lawful prim s layout)
    (n : Index) (hn : 0 < n.val) (hmax : n.val + (prim.ncodeunits s).val + 1 < 2 ^ 63) :
    ∀ pairs before start, layout = before ++ pairs → Walk prim s start pairs →
    ∃ pieces, Emits (fun st => some (iteratePartition (partOps prim errs) ⟨s,n⟩ st))
        (some start) pieces ∧
      ViewsIterate prim errs pieces (chunksOf n.val.toNat (charsIn pairs)) := by
  intro pairs
  induction pairs using navLengthInduction with
  | h pairs ih =>
    intro before start hsplit walk
    cases walk with
    | stop atEnd done =>
      refine ⟨[], Emits.done ?_, ?_⟩
      · simp only [iteratePartition, partOps, bind, Except.bind, pure, Except.pure,
          if_pos (show start.val > (prim.ncodeunits s).val by omega)]
      · simpa only [charsIn, List.map_nil, navChunksNil] using (ViewsIterate.nil (prim := prim) (errs := errs))
    | @step start next c rest bounds yield advances tail =>
      have w := Walk.step bounds yield advances tail
      obtain ⟨out, next', hstep, hview, hwalk⟩ := navPartitionStep prim errs s layout law n hn hmax
        before start c rest hsplit w
      have hsize : 0 < n.val.toNat := by omega
      have hafter : (((start,c) :: rest).drop n.val.toNat).length < ((start,c) :: rest).length := by
        simp only [List.length_drop, List.length_cons]
        omega
      have hsplit' : layout = (before ++ ((start,c) :: rest).take n.val.toNat) ++
          ((start,c) :: rest).drop n.val.toNat := by
        rw [List.append_assoc, List.take_append_drop]
        exact hsplit
      obtain ⟨pieces, hemit, hviews⟩ := ih _ hafter _ next' hsplit' hwalk
      refine ⟨out :: pieces, Emits.emit (by rw [hstep]) hemit, ?_⟩
      rw [navChunksCons _ _ hsize (by simp [charsIn])]
      simpa only [charsIn, List.map_take, List.map_drop] using ViewsIterate.cons hview hviews

private theorem navEmitsStart {R St E : Type} (step : Option St → Option (Except E (Option (R × St))))
    (a b : Option St) (pieces : List R) (h : step a = step b) (emits : Emits step b pieces) :
    Emits step a pieces := by
  cases emits with
  | done hd => exact Emits.done (h.trans hd)
  | emit he tail => exact Emits.emit (h.trans he) tail

theorem StringutilPartitionCharacterChunks_proven : PartitionCharacters := by
  intro S R C CU CT E prim errs s layout n law hn hmax
  obtain ⟨pieces, emits, views⟩ := navPartitionFrom prim errs s layout law n hn hmax
    layout [] (int 1) (by simp) law.walk
  refine ⟨pieces, ?_, views⟩
  apply navEmitsStart _ none (some (int 1)) pieces _ emits
  simp only [iteratePartition, partOps, firstindexString, bind, Except.bind, pure, Except.pure]


private theorem navPrevZero {S R C CU CT E : Type}
    (prim : StringOps S R C CU CT E) (s : S) (i : Index) :
    ∀ fuel, previndLoop prim s fuel i (int 0) = .ok i := by
  have hzero : i - int 0 = i := by
    apply Subtype.ext
    change wrapInt .i64 (i.val - (int 0).val) = i.val
    rw [JuliaLean.Proofs.base.strings.basic.int_zero_val, Int.sub_zero]
    exact wrapInt_of_inRange .i64 i.val i.property
  intro fuel
  cases fuel <;> simp [previndLoop, hzero,
    JuliaLean.Proofs.base.strings.basic.int_zero_val]

private theorem navPrevGap {S R C CU CT E : Type}
    (prim : StringOps S R C CU CT E) (s : S) (target n : Index)
    (htarget : 1 ≤ target.val) (hvalid : prim.isvalid s target = .ok true)
    (hn : 0 < n.val) :
    ∀ (fuel : Nat) (i : Index), target.val < i.val →
      (i.val - target.val).toNat ≤ fuel →
      (∀ k : Index, target.val < k.val → k.val < i.val →
        prim.isvalid s k = .ok false) →
      previndLoop prim s fuel i n =
        previndLoop prim s (fuel - (i.val - target.val).toNat) target (n - int 1) := by
  intro fuel
  induction fuel with
  | zero => intro i hi hf hinv; omega
  | succ fuel ih =>
    intro i hi hf hinv
    have h1 : (int 1).val = 1 := by decide
    have hi' : (i - int 1).val = i.val - 1 := by
      apply navSubVal
      · omega
      · have hmax := i.property.2
        simp [IntTy.max, IntTy.bits, IntTy.signed] at hmax
        omega
    have hil : 1 < i.val := by omega
    by_cases he : (i - int 1).val = target.val
    · have heq : i - int 1 = target := Subtype.ext he
      have hdiff : (i.val - target.val).toNat = 1 := by omega
      simp only [previndLoop, hn, hil, decide_true, Bool.and_self, ite_true,
        heq, hvalid, bind, Except.bind, boolInt, hdiff, Nat.add_sub_cancel]
    · have hlt : target.val < (i - int 1).val := by omega
      have hv := hinv (i - int 1) hlt (by omega)
      have hsub : n - boolInt false = n := by
        apply Subtype.ext
        change wrapInt .i64 (n.val - 0) = n.val
        simpa only [Int.sub_zero] using wrapInt_of_inRange .i64 n.val n.property
      have hrec := ih (i - int 1) hlt (by omega)
        (fun k hkt hk => hinv k hkt (by omega))
      have hfu : fuel - ((i - int 1).val - target.val).toNat =
          fuel + 1 - (i.val - target.val).toNat := by omega
      rw [hfu] at hrec
      simpa only [previndLoop, hn, hil, decide_true, Bool.and_self, ite_true,
        hv, bind, Except.bind, hsub] using hrec

private def navPrevResult {C : Type} (pairs : List (Index × C)) (n : Nat) : Index :=
  match pairs[n]? with
  | some p => p.1
  | none => int ((pairs.length : Int) - n)

private theorem navPrevResultCons {C : Type} (i : Index) (c : C)
    (rest : List (Index × C)) (n : Nat) :
    navPrevResult ((i,c) :: rest) (n + 1) = navPrevResult rest n := by
  simp only [navPrevResult, List.getElem?_cons_succ]
  split
  · rfl
  · congr 1
    simp only [List.length_cons, Int.natCast_add, Int.natCast_one]
    omega

private theorem navFirstIndex {S R C CU CT E : Type}
    (prim : StringOps S R C CU CT E) (s : S) (i : Index) (c : C)
    (rest : List (Index × C)) (law : Lawful prim s ((i,c) :: rest)) : i = int 1 := by
  cases law.walk
  rfl

private theorem navPrevByWalk {S R C CU CT E : Type}
    (prim : StringOps S R C CU CT E) (s : S) (layout : List (Index × C))
    (law : Lawful prim s layout) :
    ∀ (n : Nat) before i c after, n < 2 ^ 63 → layout = before ++ (i,c) :: after →
      ∀ fuel, i.val.toNat - 1 ≤ fuel →
      previndLoop prim s fuel i (int n) =
        .ok (navPrevResult ((i,c) :: before.reverse) n) := by
  intro n
  induction n with
  | zero =>
    intro before i c after hn hsplit fuel hfuel
    exact navPrevZero prim s i fuel
  | succ n ih =>
    intro before i c after hn hsplit fuel hfuel
    have hnval : (int ((n + 1 : Nat) : Int)).val = n + 1 := navIntVal _ (by omega) (by omega)
    have hnpos : 0 < (int ((n + 1 : Nat) : Int)).val := by omega
    cases hrev : before.reverse with
    | nil =>
      have he : before = [] := by
        have he := congrArg List.reverse hrev
        simpa only [List.reverse_reverse, List.reverse_nil] using he
      subst before
      have hsplit' : layout = (i,c) :: after := by simpa only [List.nil_append] using hsplit
      have hilaw : Lawful prim s ((i,c) :: after) := by rw [← hsplit']; exact law
      have hi := navFirstIndex prim s i c after hilaw
      subst i
      have h1 : (int 1).val = 1 := by decide
      have hres : navPrevResult [(int 1,c)] (n + 1) = int 1 - int ((n + 1 : Nat) : Int) := by
        apply Subtype.ext
        simp only [navPrevResult, List.getElem?_cons_succ, List.getElem?_nil,
          List.length_cons, List.length_nil, Int.natCast_one]
        change wrapInt .i64 (1 - ((n + 1 : Nat) : Int)) =
          wrapInt .i64 ((int 1).val - (int ((n + 1 : Nat) : Int)).val)
        rw [h1, hnval]
        rfl
      rw [hres]
      cases fuel <;> simp only [previndLoop, h1, Int.lt_irrefl, decide_false,
        Bool.and_false, Bool.false_eq_true, ite_false]
    | cons p preRev =>
      let pre := preRev.reverse
      have he : before = pre ++ [p] := by
        have he := congrArg List.reverse hrev
        simpa only [List.reverse_reverse, List.reverse_cons, pre] using he
      have hsplit' : layout = pre ++ (p.1,p.2) :: (i,c) :: after := by
        rw [hsplit, he]
        simp only [List.append_assoc, List.singleton_append, Prod.eta]
      obtain ⟨start, walk⟩ := navWalkSuffix prim s law.walk pre
        ((p.1,p.2) :: (i,c) :: after) hsplit'
      cases walk with
      | @step j q d rest boundsj yieldj advancesj tail =>
        cases tail with
        | @step i next c after boundsi yieldi advancesi taili =>
          have hv := navValid prim s layout law p.1 p.2 (by rw [hsplit']; simp)
          have hgap := navGap prim s layout law pre ((i,c) :: after) p.1 i p.2 hsplit'
            (Walk.step boundsi yieldi advancesi taili) advancesj
          have hg := navPrevGap prim s p.1 (int ((n + 1 : Nat) : Int)) boundsj.1 hv hnpos
            fuel i advancesj (by omega) (fun k hjk hki => hgap k hjk hki)
          have h1 : (int 1).val = 1 := by decide
          have hsub : int ((n + 1 : Nat) : Int) - int 1 = int (n : Int) := by
            apply Subtype.ext
            rw [navSubVal _ _ (by omega) (by omega), hnval, h1,
              navIntVal (n : Int) (by omega) (by omega)]
            omega
          rw [hg, hsub]
          have hrec := ih pre p.1 p.2 ((i,c) :: after) (by omega) hsplit'
            (fuel - (i.val - p.1.val).toNat) (by omega)
          rw [hrec]
          have hpre : preRev = pre.reverse := by simp only [pre, List.reverse_reverse]
          rw [hpre, navPrevResultCons]

private theorem navPrevG {S R C CU CT E : Type}
    (prim : StringOps S R C CU CT E) (s : S) (layout : List (Index × C))
    (law : Lawful prim s layout) (before : List (Index × C)) (i : Index) (c : C)
    (after : List (Index × C)) (n : Index) (hn : 0 ≤ n.val)
    (hsplit : layout = before ++ (i,c) :: after) :
    (gFull prim).prevind s i n =
      .ok (navPrevResult ((i,c) :: before.reverse) n.val.toNat) := by
  have hb : 1 ≤ i.val ∧ i.val ≤ (prim.ncodeunits s).val :=
    lawfulPairIndexBounds prim s layout law (i,c) (by rw [hsplit]; simp)
  have hnmax := n.property.2
  simp [IntTy.max, IntTy.bits, IntTy.signed] at hnmax
  have hnc := navWalkEnd prim s law.walk
  have hnEq : int (n.val.toNat : Int) = n := by
    apply Subtype.ext
    rw [navIntVal _ (by omega) (by omega)]
    omega
  have hloop := navPrevByWalk prim s layout law n.val.toNat before i c after
    (by omega) hsplit (i.val.toNat - 1) (by omega)
  rw [hnEq] at hloop
  have hneg : ¬ n.val < 0 := by omega
  have h1 : (int 1).val = 1 := by decide
  have hncval : (prim.ncodeunits s + int 1).val = (prim.ncodeunits s).val + 1 := by
    apply navAddVal
    · omega
    · omega
  by_cases hn0 : n.val = 0
  · have hnv : n.val.toNat = 0 := by omega
    have hv := navValid prim s layout law i c (by rw [hsplit]; simp)
    have ht := JuliaLean.Proofs.base.strings.basic.thisindInt_rewind prim s i i
      hb.1 (by omega) hb.2 (by omega) (Or.inr hv) (fun k hk => by omega)
    simp [gFull, modelStringOps, previndInt, hneg, show 0 < i.val by omega, hncval,
      show i.val ≤ (prim.ncodeunits s).val + 1 by omega,
      hn0, ht, hnv, navPrevResult, bind, Except.bind, pure, Except.pure]
  · simpa [gFull, modelStringOps, previndInt, hneg, show 0 < i.val by omega, hncval,
      show i.val ≤ (prim.ncodeunits s).val + 1 by omega,
      hn0, JuliaLean.Proofs.base.strings.basic.previndLoop_thisindOps] using hloop


private theorem navGetSplit {A : Type} (xs : List A) (k : Nat) (a : A) (h : xs[k]? = some a) :
    ∃ before after, xs = before ++ a :: after ∧ before.length = k := by
  obtain ⟨hk, he⟩ := List.getElem?_eq_some_iff.mp h
  refine ⟨xs.take k, xs.drop (k + 1), ?_, ?_⟩
  · have hd := List.drop_eq_getElem_cons hk
    rw [he] at hd
    rw [← hd]
    exact (List.take_append_drop k xs).symm
  · simp only [List.length_take, Nat.min_eq_left (Nat.le_of_lt hk)]

private theorem navIndexLower {S R C CU CT E : Type}
    (prim : StringOps S R C CU CT E) (s : S) (layout : List (Index × C))
    (law : Lawful prim s layout) (k : Nat) (p : Index × C)
    (h : layout[k]? = some p) : (k : Int) + 1 ≤ p.1.val := by
  obtain ⟨before, after, he, hl⟩ := navGetSplit layout k p h
  have hw : Walk prim s (int 1) (before ++ p :: after) := by rw [← he]; exact law.walk
  have hb := walkPrefixLengthBound prim s before (p :: after) (int 1) hw
  have h1 : (int 1).val = 1 := by decide
  change (before.length : Int) + (int 1).val ≤ p.1.val at hb
  simpa only [hl, h1] using hb

private theorem navIndexOrder {S R C CU CT E : Type}
    (prim : StringOps S R C CU CT E) (s : S) (layout : List (Index × C))
    (law : Lawful prim s layout) (k l : Nat) (p q : Index × C)
    (hp : layout[k]? = some p) (hq : layout[l]? = some q) (hkl : k < l) :
    p.1.val < q.1.val := by
  obtain ⟨before, after, he, hl⟩ := navGetSplit layout l q hq
  have hp' : before[k]? = some p := by
    rw [he] at hp
    rwa [List.getElem?_append_left (by omega)] at hp
  exact navWalkBefore prim s law.walk before q.1 q.2 after he p (List.mem_of_getElem? hp')

private abbrev navEmptyView {S : Type} (s : S) : Sub.SubString S :=
  ⟨s, JuliaLean.base.strings.substring.zero, JuliaLean.base.strings.substring.zero⟩

private theorem navEmptyIterates {S R C CU CT E : Type}
    (prim : StringOps S R C CU CT E) (errs : ViewErrors S E) (s : S) :
    ViewIterates prim errs (navEmptyView s) [] := by
  have hfirst : viewIterateAt prim errs (navEmptyView s) (int 1) = .ok none := by
    have he : (int 1) = (navEmptyView s).ncodeunits + JuliaLean.base.strings.substring.one := by
      apply Subtype.ext
      change (int 1).val = (JuliaLean.base.strings.substring.zero + JuliaLean.base.strings.substring.one).val
      decide
    simp only [viewIterateAt, Sub.iterateSubString, he,
      JuliaLean.Proofs.base.int.eq_int_eq, decide_true, ite_true, pure, Except.pure]
  refine ⟨none, ?_, ?_⟩
  · exact hfirst
  · exact Trace.nil

private theorem navRangeEmpty {S R C CU CT E : Type}
    (prim : StringOps S R C CU CT E) (errs : ViewErrors S E) (s : S) (i j : Index)
    (h : j.val < i.val) : gRange prim errs s i j = .ok (navEmptyView s) := by
  simp only [gRange, Sub.subStringInt, JuliaLean.base.strings.substring.typedSubString,
    h, ite_true, pure, Except.pure, bind, Except.bind, navEmptyView]

private theorem navRangeBad {S R C CU CT E : Type}
    (prim : StringOps S R C CU CT E) (errs : ViewErrors S E) (s : S) (i j : Index)
    (hij : i.val ≤ j.val) (hi : i.val < 1) :
    gRange prim errs s i j = .error (errs.rangeError s i j) := by
  simp [gRange, Sub.subStringInt, JuliaLean.base.strings.substring.typedSubString,
    show ¬ j.val < i.val by omega, gParent, JuliaLean.base.strings.basic.checkbounds,
    JuliaLean.base.strings.basic.checkboundsRange, unitRangeOps, gFull, modelStringOps,
    hi, show ¬ 1 ≤ i.val by omega, bind, Except.bind, pure, Except.pure]

private theorem navRangeSelected {S R C CU CT E : Type}
    (prim : StringOps S R C CU CT E) (errs : ViewErrors S E) (s : S)
    (layout : List (Index × C)) (law : Lawful prim s layout) (h k : Nat) (p q : Index × C)
    (hp : layout[h]? = some p) (hq : layout[k]? = some q) (hhk : h ≤ k) :
    ∃ out, gRange prim errs s p.1 q.1 = .ok out ∧ out.string = s ∧
      ViewIterates prim errs out (charsIn ((layout.drop h).take (k + 1 - h))) := by
  obtain ⟨before, afterHead, hs, hbl⟩ := navGetSplit layout h p hp
  let rest := afterHead.take (k - h)
  let part := p :: rest
  let after := afterHead.drop (k - h)
  have hpart : (layout.drop h).take (k + 1 - h) = part := by
    rw [hs, ← hbl, List.drop_left, hbl]
    have he : k + 1 - h = (k - h) + 1 := by omega
    rw [he]
    rfl
  have hsplit : layout = before ++ part ++ after := by
    rw [hs]
    simp only [part, rest, after, List.append_assoc, List.cons_append, List.take_append_drop]
  have hpartLast : part.getLast? = some q := by
    rw [← hpart, List.getLast?_take, if_neg (by omega)]
    have hget : (layout.drop h)[k + 1 - h - 1]? = some q := by
      rw [List.getElem?_drop]
      have he : h + (k + 1 - h - 1) = k := by omega
      simpa only [he] using hq
    rw [hget]
    rfl
  obtain ⟨beforeLast, hlast⟩ := List.getLast?_eq_some_iff.mp hpartLast
  obtain ⟨out, hout, hsource, hview⟩ := Affix.rangeSlice prim errs s layout law
    before beforeLast rest after p.1 q.1 p.2 q.2 hlast hsplit
  refine ⟨out, hout, hsource, ?_⟩
  rw [hpart]
  exact hview

private theorem navPrevValueBounds {S R C CU CT E : Type}
    (prim : StringOps S R C CU CT E) (s : S) (layout : List (Index × C))
    (law : Lawful prim s layout) (t : Index) (ht : 0 ≤ t.val) :
    (layout.length : Int) - t.val ≤ (navPrevResult layout.reverse t.val.toNat).val ∧
    (navPrevResult layout.reverse t.val.toNat).val ≤ (prim.ncodeunits s).val := by
  have hlen := walkLengthBound prim s law.walk
  have h1 : (int 1).val = 1 := by decide
  rw [h1] at hlen
  have hmax := navWalkEnd prim s law.walk
  have htmax := t.property.2
  simp [IntTy.max, IntTy.bits, IntTy.signed] at htmax
  cases hs : layout.reverse[t.val.toNat]? with
  | none =>
    have hn : layout.length ≤ t.val.toNat := by
      have he := List.getElem?_eq_none_iff.mp hs
      simpa only [List.length_reverse] using he
    simp only [navPrevResult, hs, List.length_reverse]
    rw [navIntVal _ (by omega) (by omega)]
    omega
  | some p =>
    have hp := List.mem_of_getElem? hs
    have hp' : p ∈ layout := List.mem_reverse.mp hp
    have hb := lawfulPairIndexBounds prim s layout law p hp'
    have hn : t.val.toNat < layout.length := by
      have he := (List.getElem?_eq_some_iff.mp hs).1
      simpa only [List.length_reverse] using he
    have he := List.getElem?_reverse (l := layout) hn
    rw [hs] at he
    have hl := navIndexLower prim s layout law (layout.length - 1 - t.val.toNat) p he.symm
    simp only [navPrevResult, hs]
    constructor
    · omega
    · exact hb.2

private theorem navRangeCountsSafe {S R C CU CT E : Type}
    (prim : StringOps S R C CU CT E) (errs : ViewErrors S E) (s : S)
    (layout : List (Index × C)) (law : Lawful prim s layout) (h t : Index)
    (hh : 0 ≤ h.val) (ht : 0 ≤ t.val)
    (hfits : h.val + (prim.ncodeunits s).val + 1 - layout.length < 2 ^ 63) :
    ∃ out, gRange prim errs s (navNextResult (prim.ncodeunits s) layout h.val.toNat)
        (navPrevResult layout.reverse t.val.toNat) = .ok out ∧ out.string = s ∧
      ViewIterates prim errs out
        (((charsIn layout).drop h.val.toNat).take (layout.length - h.val.toNat - t.val.toNat)) := by
  have hlen := walkLengthBound prim s law.walk
  have h1 : (int 1).val = 1 := by decide
  rw [h1] at hlen
  have hmax := navWalkEnd prim s law.walk
  by_cases hempty : layout.length ≤ h.val.toNat + t.val.toNat
  · have hgt : (navPrevResult layout.reverse t.val.toNat).val <
        (navNextResult (prim.ncodeunits s) layout h.val.toNat).val := by
      have hj := navPrevValueBounds prim s layout law t ht
      cases hget : layout[h.val.toNat]? with
      | none =>
        have hn := List.getElem?_eq_none_iff.mp hget
        simp only [navNextResult, hget]
        rw [navIntVal _ (by omega) (by omega)]
        omega
      | some p =>
        have hp := lawfulPairIndexBounds prim s layout law p (List.mem_of_getElem? hget)
        cases tget : layout.reverse[t.val.toNat]? with
        | none =>
          have hn : layout.length ≤ t.val.toNat := by
            have he := List.getElem?_eq_none_iff.mp tget
            simpa only [List.length_reverse] using he
          have htmax := t.property.2
          simp [IntTy.max, IntTy.bits, IntTy.signed] at htmax
          simp only [navPrevResult, navNextResult, hget, tget, List.length_reverse]
          rw [navIntVal _ (by omega) (by omega)]
          omega
        | some q =>
          have hn : t.val.toNat < layout.length := by
            have he := (List.getElem?_eq_some_iff.mp tget).1
            simpa only [List.length_reverse] using he
          have he := List.getElem?_reverse (l := layout) hn
          rw [tget] at he
          have horder := navIndexOrder prim s layout law
            (layout.length - 1 - t.val.toNat) h.val.toNat q p he.symm hget (by omega)
          simpa only [navPrevResult, navNextResult, hget, tget] using horder
    refine ⟨navEmptyView s, navRangeEmpty prim errs s _ _ hgt, rfl, ?_⟩
    have hzero : layout.length - h.val.toNat - t.val.toNat = 0 := by omega
    rw [hzero, List.take_zero]
    exact navEmptyIterates prim errs s
  · have hhl : h.val.toNat < layout.length := by omega
    have htl : t.val.toNat < layout.length := by omega
    let p := layout[h.val.toNat]
    let k := layout.length - 1 - t.val.toNat
    have hkl : k < layout.length := by dsimp [k]; omega
    let q := layout[k]
    have hp : layout[h.val.toNat]? = some p := List.getElem?_eq_getElem hhl
    have hq : layout[k]? = some q := List.getElem?_eq_getElem hkl
    have htq : layout.reverse[t.val.toNat]? = some q := by
      rw [List.getElem?_reverse htl]
      exact hq
    obtain ⟨out, hout, hs, hv⟩ := navRangeSelected prim errs s layout law h.val.toNat k p q
      hp hq (by dsimp [k]; omega)
    refine ⟨out, ?_, hs, ?_⟩
    · simpa only [navNextResult, navPrevResult, hp, htq] using hout
    · have he : k + 1 - h.val.toNat = layout.length - h.val.toNat - t.val.toNat := by
        dsimp [k]
        omega
      simpa only [he, charsIn, List.map_take, List.map_drop] using hv

private theorem navIntWrapHigh (x : Int) (hlo : 2 ^ 63 ≤ x) (hhi : x < 2 ^ 64) :
    (int x).val = x - 2 ^ 64 := by
  change wrapInt .i64 x = _
  simp only [wrapInt, IntTy.signed, IntTy.bits, ite_true]
  omega


private theorem navNextHigh {S R C CU CT E : Type}
    (prim : StringOps S R C CU CT E) (s : S) (layout : List (Index × C))
    (law : Lawful prim s layout) (h : Index) (hh : 0 ≤ h.val)
    (hover : 2 ^ 63 ≤ h.val + (prim.ncodeunits s).val + 1 - layout.length) :
    (navNextResult (prim.ncodeunits s) layout h.val.toNat).val =
      h.val + (prim.ncodeunits s).val + 1 - layout.length - 2 ^ 64 := by
  have hzmax := navWalkEnd prim s law.walk
  have hhmax := h.property.2
  simp [IntTy.max, IntTy.bits, IntTy.signed] at hhmax
  have hlen := walkLengthBound prim s law.walk
  have h1 : (int 1).val = 1 := by decide
  rw [h1] at hlen
  have hn : layout.length ≤ h.val.toNat := by omega
  simp only [navNextResult, List.getElem?_eq_none hn]
  rw [navIntWrapHigh _ (by omega) (by omega)]
  omega

private theorem navRangeCountsOverflow {S R C CU CT E : Type}
    (prim : StringOps S R C CU CT E) (errs : ViewErrors S E) (s : S)
    (layout : List (Index × C)) (law : Lawful prim s layout) (h t : Index)
    (hh : 0 ≤ h.val) (ht : 0 ≤ t.val)
    (hover : 2 ^ 63 ≤ h.val + (prim.ncodeunits s).val + 1 - layout.length)
    (hbudget : h.val + t.val + (prim.ncodeunits s).val + 1 - 2 * layout.length ≤ 2 ^ 64) :
    ∃ i j, gRange prim errs s (navNextResult (prim.ncodeunits s) layout h.val.toNat)
        (navPrevResult layout.reverse t.val.toNat) = .error (errs.rangeError s i j) := by
  have hi := navNextHigh prim s layout law h hh hover
  have hj := navPrevValueBounds prim s layout law t ht
  have hzmax := navWalkEnd prim s law.walk
  have hhmax := h.property.2
  simp [IntTy.max, IntTy.bits, IntTy.signed] at hhmax
  refine ⟨_, _, navRangeBad prim errs s _ _ ?_ ?_⟩
  · omega
  · omega

private theorem navRangeCountsVeryHigh {S R C CU CT E : Type}
    (prim : StringOps S R C CU CT E) (errs : ViewErrors S E) (s : S)
    (layout : List (Index × C)) (law : Lawful prim s layout) (h t : Index)
    (hh : 0 ≤ h.val) (ht : 0 ≤ t.val)
    (hbudget : 2 ^ 64 < h.val + t.val + (prim.ncodeunits s).val + 1 - 2 * layout.length) :
    ∃ out, gRange prim errs s (navNextResult (prim.ncodeunits s) layout h.val.toNat)
        (navPrevResult layout.reverse t.val.toNat) = .ok out ∧ out.string = s ∧
      ViewIterates prim errs out [] := by
  have hzmax := navWalkEnd prim s law.walk
  have hlen := walkLengthBound prim s law.walk
  have h1 : (int 1).val = 1 := by decide
  rw [h1] at hlen
  have hhmax := h.property.2
  have htmax := t.property.2
  simp [IntTy.max, IntTy.bits, IntTy.signed] at hhmax htmax
  have hover : 2 ^ 63 ≤ h.val + (prim.ncodeunits s).val + 1 - layout.length := by omega
  have hi := navNextHigh prim s layout law h hh hover
  have htl : layout.reverse.length ≤ t.val.toNat := by rw [List.length_reverse]; omega
  have hj : (navPrevResult layout.reverse t.val.toNat).val = (layout.length : Int) - t.val := by
    simp only [navPrevResult, List.getElem?_eq_none htl, List.length_reverse]
    rw [navIntVal _ (by omega) (by omega)]
    omega
  exact ⟨navEmptyView s, navRangeEmpty prim errs s _ _ (by omega), rfl,
    navEmptyIterates prim errs s⟩

private theorem navIsEmpty {S R C CU CT E : Type}
    (prim : StringOps S R C CU CT E) (s : S) (layout : List (Index × C))
    (law : Lawful prim s layout) : isemptyString (gFull prim) s = layout.isEmpty := by
  cases law.walk with
  | stop atEnd done =>
    have h1 : (int 1).val = 1 := by decide
    have hz : (prim.ncodeunits s).val = 0 := by omega
    simp only [isemptyString, gFull, modelStringOps, hz, beq_self_eq_true, List.isEmpty_nil]
  | step bounds yield advances tail =>
    have h1 : (int 1).val = 1 := by decide
    have hz : (prim.ncodeunits s).val ≠ 0 := by omega
    simp only [isemptyString, gFull, modelStringOps, beq_eq_false_iff_ne.mpr hz, List.isEmpty_cons]

private theorem navHead {S R C CU CT E : Type}
    (prim : StringOps S R C CU CT E) (s : S) (layout : List (Index × C))
    (law : Lawful prim s layout) (hne : layout ≠ []) (h : Index) (hh : 0 ≤ h.val) :
    (gFull prim).nextind s (int 1) h = .ok (navNextResult (prim.ncodeunits s) layout h.val.toNat) := by
  cases layout with
  | nil => exact False.elim (hne rfl)
  | cons p rest =>
    have he := navFirstIndex prim s p.1 p.2 rest law
    have hw : Walk prim s p.1 (p :: rest) := by rw [he]; exact law.walk
    have hr := navNextG prim s (p :: rest) law [] p.1 p.2 rest h hh rfl hw
    rw [← he]
    simpa only [Prod.eta] using hr

private theorem navLastPrev {S R C CU CT E : Type}
    (prim : StringOps S R C CU CT E) (s : S) (layout : List (Index × C))
    (law : Lawful prim s layout) (hne : layout ≠ []) :
    ∃ last, (gFull prim).lastindex s = .ok last ∧
      ∀ t : Index, 0 ≤ t.val → (gFull prim).prevind s last t =
        .ok (navPrevResult layout.reverse t.val.toNat) := by
  let p := layout.getLast hne
  have hp : layout.getLast? = some p := List.getLast?_eq_some_getLast hne
  have hlast := (navBeforeLast prim s layout law p hp).1
  obtain ⟨before, hsplit⟩ := List.getLast?_eq_some_iff.mp hp
  refine ⟨p.1, hlast, ?_⟩
  intro t ht
  have hr := navPrevG prim s layout law before p.1 p.2 [] t ht hsplit
  simpa only [hsplit, List.reverse_append, List.reverse_cons, List.reverse_nil,
    List.nil_append, List.singleton_append, Prod.eta] using hr

private theorem navChopConverted {S R C CU CT E N : Type}
    (prim : StringOps S R C CU CT E) (errs : ViewErrors S E) (toInt : N → Except E Index)
    (s : S) (layout : List (Index × C)) (law : Lawful prim s layout) (hne : layout ≠ [])
    (head tail : N) (h t : Index) (hh : 0 ≤ h.val) (ht : 0 ≤ t.val)
    (hhead : toInt head = .ok h) (htail : toInt tail = .ok t) :
    chopCallG prim errs toInt s head tail =
      gRange prim errs s (navNextResult (prim.ncodeunits s) layout h.val.toNat)
        (navPrevResult layout.reverse t.val.toNat) := by
  have hempty : isemptyString (gFull prim) s = false := by rw [navIsEmpty prim s layout law]; simp [hne]
  have hnext := navHead prim s layout law hne h hh
  obtain ⟨last, hlast, hprev⟩ := navLastPrev prim s layout law hne
  simp only [chopCallG, chop, hempty, hhead, htail, hnext, hlast, hprev t ht,
    firstindexString, Bool.false_eq_true, ite_false, bind, Except.bind, pure, Except.pure]

theorem StringutilChopCharacters_proven : ChopCharacters := by
  intro S R C CU CT E N prim errs toInt s layout head tail law
  dsimp only
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_⟩
  · intro hnil
    have he : isemptyString (gFull prim) s = true := by
      rw [navIsEmpty prim s layout law, hnil]
      rfl
    simp only [chopCallG, chop, he, bind, Except.bind, pure, Except.pure, ite_true]
  · intro hne e he
    have hempty : isemptyString (gFull prim) s = false := by rw [navIsEmpty prim s layout law]; simp [hne]
    simp only [chopCallG, chop, hempty, he, firstindexString,
      Bool.false_eq_true, ite_false, bind, Except.bind, pure, Except.pure]
  · intro hne h hh hn
    have hempty : isemptyString (gFull prim) s = false := by rw [navIsEmpty prim s layout law]; simp [hne]
    let msg := "n cannot be negative: " ++ toString h.val
    have hnext : (gFull prim).nextind s (int 1) h = .error (prim.argumentError msg) := by
      simp [gFull, modelStringOps, nextindInt, hn, msg, bind, Except.bind]
    refine ⟨msg, ?_⟩
    simp only [chopCallG, chop, hempty, hh, hnext, firstindexString,
      Bool.false_eq_true, ite_false, bind, Except.bind, pure, Except.pure]
  · intro hne h hh hn e he
    have hempty : isemptyString (gFull prim) s = false := by rw [navIsEmpty prim s layout law]; simp [hne]
    have hnext := navHead prim s layout law hne h hn
    obtain ⟨last, hlast, hprev⟩ := navLastPrev prim s layout law hne
    simp only [chopCallG, chop, hempty, hh, he, hnext, hlast, firstindexString,
      Bool.false_eq_true, ite_false, bind, Except.bind, pure, Except.pure]
  · intro hne h t hh ht hn tn
    have hempty : isemptyString (gFull prim) s = false := by rw [navIsEmpty prim s layout law]; simp [hne]
    have hnext := navHead prim s layout law hne h hn
    obtain ⟨last, hlast, hprev⟩ := navLastPrev prim s layout law hne
    let msg := "n cannot be negative: " ++ toString t.val
    have hp : (gFull prim).prevind s last t = .error (prim.argumentError msg) := by
      simp [gFull, modelStringOps, previndInt, tn, msg, bind, Except.bind]
    refine ⟨msg, ?_⟩
    simp only [chopCallG, chop, hempty, hh, ht, hnext, hlast, hp, firstindexString,
      Bool.false_eq_true, ite_false, bind, Except.bind, pure, Except.pure]
  · intro hne h t hh ht hn tn
    have hc := navChopConverted prim errs toInt s layout law hne head tail h t hn tn hh ht
    rw [hc]
    refine ⟨?_, ?_, ?_⟩
    · intro hfits
      exact navRangeCountsSafe prim errs s layout law h t hn tn hfits
    · intro hover hbudget
      exact navRangeCountsOverflow prim errs s layout law h t hn tn hover hbudget
    · intro hbudget
      exact navRangeCountsVeryHigh prim errs s layout law h t hn tn hbudget

