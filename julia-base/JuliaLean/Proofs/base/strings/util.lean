private def viewValid (v : View) : Prop :=
  0 ≤ v.offset.val ∧ 0 ≤ v.ncodeunits.val ∧
    v.offset.val + v.ncodeunits.val ≤ (parentOps.ncodeunits v.string).val

private theorem chompWrap64Val (x : Int) (h1 : -(2 ^ 63 : Int) ≤ x)
    (h2 : x < 2 ^ 63) : (JInt.wrap .i64 x).val = x := by
  show wrapInt .i64 x = x
  apply wrapInt_of_inRange
  simp only [IntTy.min, IntTy.max, IntTy.signed, IntTy.bits]
  constructor <;> simp <;> omega

private theorem chompIxVal (x : Int) (h1 : -(2 ^ 63 : Int) ≤ x)
    (h2 : x < 2 ^ 63) : (JuliaLean.Strings.ix x).val = x :=
  chompWrap64Val x h1 h2

private theorem chompAddVal (a b : JuliaLean.base.strings.basic.Index)
    (h1 : -(2 ^ 63 : Int) ≤ a.val + b.val)
    (h2 : a.val + b.val < 2 ^ 63) :
    (a + b).val = a.val + b.val :=
  chompWrap64Val _ h1 h2

private theorem chompSubVal (a b : JuliaLean.base.strings.basic.Index)
    (h1 : -(2 ^ 63 : Int) ≤ a.val - b.val)
    (h2 : a.val - b.val < 2 ^ 63) :
    (a - b).val = a.val - b.val :=
  chompWrap64Val _ h1 h2


private theorem rawNcodeunitsVal (s : Raw) :
    (JuliaLean.base.strings.string.stringNcodeunits s).val =
      Int.ofNat s.bytes.length := by
  have hsmall : s.bytes.length < 2 ^ 62 := s.small
  have hlenSmallCast : Int.ofNat s.bytes.length < Int.ofNat (2 ^ 62) :=
    Int.ofNat_lt.mpr hsmall
  have hlenSmall : Int.ofNat s.bytes.length < (2 : Int) ^ 62 := by
    calc
      Int.ofNat s.bytes.length < Int.ofNat (2 ^ 62) := hlenSmallCast
      _ = (2 : Int) ^ 62 := Int.natCast_pow 2 62
  have hlenLower : -(2 ^ 63 : Int) ≤ Int.ofNat s.bytes.length :=
    Int.le_trans (by decide) (Int.natCast_nonneg _)
  have hpowNat : 2 ^ 62 < 2 ^ 63 := by decide
  have hpowCast : Int.ofNat (2 ^ 62) < Int.ofNat (2 ^ 63) :=
    Int.ofNat_lt.mpr hpowNat
  have hlenUpper : Int.ofNat s.bytes.length < 2 ^ 63 := by
    calc
      Int.ofNat s.bytes.length < Int.ofNat (2 ^ 63) :=
        Int.lt_trans hlenSmallCast hpowCast
      _ = 2 ^ 63 := Int.natCast_pow 2 63
  have hix := chompIxVal (Int.ofNat s.bytes.length) hlenLower hlenUpper
  simpa [JuliaLean.base.strings.string.stringNcodeunits,
    JuliaLean.base.strings.string.ncodeunits,
    JuliaLean.base.strings.string.stringCoreSizeof,
    Int.natCast_pow] using hix

private theorem viewLengthSmall (v : View) (hv : viewValid v) :
    v.ncodeunits.val < (2 : Int) ^ 62 := by
  have hoff := hv.1
  have hp := hv.2.2
  change v.offset.val + v.ncodeunits.val ≤ (Str.stringNcodeunits v.string).val at hp
  have hparentSmall : (Str.stringNcodeunits v.string).val < (2 : Int) ^ 62 := by
    rw [rawNcodeunitsVal]
    exact Int.ofNat_lt.mpr v.string.small
  omega

private theorem viewBytesLength (v : View) (hv : viewValid v) :
    (viewBytes v).length = v.ncodeunits.val.toNat := by
  have hoff := hv.1
  have hlen := hv.2.1
  have hp := hv.2.2
  change v.offset.val + v.ncodeunits.val ≤
    (Str.stringNcodeunits v.string).val at hp
  rw [rawNcodeunitsVal] at hp
  have hoffNat : Int.ofNat v.offset.val.toNat = v.offset.val :=
    Int.toNat_of_nonneg hoff
  have hlenNat : Int.ofNat v.ncodeunits.val.toNat = v.ncodeunits.val :=
    Int.toNat_of_nonneg hlen
  have hsum : Int.ofNat (v.offset.val.toNat + v.ncodeunits.val.toNat) =
      v.offset.val + v.ncodeunits.val := by
    calc
      Int.ofNat (v.offset.val.toNat + v.ncodeunits.val.toNat) =
          Int.ofNat v.offset.val.toNat + Int.ofNat v.ncodeunits.val.toNat :=
        Int.natCast_add _ _
      _ = v.offset.val + v.ncodeunits.val := by rw [hoffNat, hlenNat]
  have hbound : v.offset.val.toNat + v.ncodeunits.val.toNat ≤ v.string.bytes.length := by
    have hboundInt : Int.ofNat (v.offset.val.toNat + v.ncodeunits.val.toNat) ≤
        Int.ofNat v.string.bytes.length := by
      rw [hsum]
      exact hp
    exact Int.ofNat_le.mp hboundInt
  have htake : v.ncodeunits.val.toNat ≤
      (v.string.bytes.drop v.offset.val.toNat).length := by
    rw [List.length_drop]
    omega
  unfold viewBytes
  simp only [List.length_take]
  exact Nat.min_eq_left htake

