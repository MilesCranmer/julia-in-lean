  | none =>
    unfold streamCharConclusion
    have hrc : (prefixStreamOps readChar).readChar marked = .error .eofError := by
      rw [streamReadCharOp]
      exact hr
    exact streamCharsError (prefixStreamOps readChar) member io0 marked set .eofError hm hrc
  | some cn =>
    rcases cn with ⟨c, next⟩
    unfold streamCharConclusion
    let after := { io0 with
      mark := int before.length, ptr := int (Int.ofNat before.length + next.val) }
    have hrc : (prefixStreamOps readChar).readChar marked = .ok (c, after) := by
      rw [streamReadCharOp]
      exact hr
    have hs : (prefixStreamOps readChar).reset after = .ok io0 :=
      streamReset readChar before unread (int (Int.ofNat before.length + next.val)) hsize
    exact ⟨io0, streamCharsCore (prefixStreamOps readChar) member io0 marked after io0 c set
      hm hrc hs, rfl, rfl, rfl⟩

