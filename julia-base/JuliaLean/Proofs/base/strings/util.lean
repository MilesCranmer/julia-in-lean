def charWidth (P : Utf8proc) (u : UInt32) : Int := JuliaLean.base.strings.unicode.textwidthChar P u

/-! ## Common observations -/

/-- Successful finite iteration from an `iterate` result, yielding `cs`. -/
inductive Trace {C St E : Type} (next : St → Except E (Option (C × St))) :
    Option (C × St) → List C → Prop where
  | nil : Trace next none []
  | cons {c : C} {k : St} {cur : Option (C × St)} {rest : List C}
      (step : next k = .ok cur) (tail : Trace next cur rest) :
      Trace next (some (c, k)) (c :: rest)

/-- `iterate(x)` and then `iterate(x, state)` succeed and yield exactly `cs`. -/
def Iterates {X C St E : Type} (first : X → Except E (Option (C × St)))
    (next : X → St → Except E (Option (C × St))) (x : X) (cs : List C) : Prop :=
  ∃ i, first x = .ok i ∧ Trace (next x) i cs

/-- Every element emitted by repeatedly calling a (possibly non-terminating) `iterate`
until it returns `nothing`. Termination and success are part of the relation. -/
inductive Emits {R St E : Type} (step : Option St → Option (Except E (Option (R × St)))) :
    Option St → List R → Prop where
  | done {st : Option St} (h : step st = some (.ok none)) : Emits step st []
  | emit {st : Option St} {piece : R} {next : St} {rest : List R}
      (h : step st = some (.ok (some (piece, next)))) (tail : Emits step (some next) rest) :
      Emits step st (piece :: rest)

/-! ## Generic `AbstractString` instances -/

/-- basic.jl derives `thisind`, `nextind`, `prevind`, `lastindex` and `checkbounds` from a
string type's own `ncodeunits`, `isvalid` and `iterate`; this is the installed derivation. -/
def gFull {S R C CU CT E : Type} (prim : StringOps S R C CU CT E) : StringOps S R C CU CT E :=
  modelStringOps prim (fun i => toString i.val)

/-- The documented iteration protocol of one string value (basic.jl:5-38): from a valid
index `i`, `iterate(s, i)` returns the character starting at `i` and the next valid
index, visiting `layout` in increasing index order, and `iterate(s, ncodeunits(s) + 1)`
returns `nothing`. The final index must be an `Int`. -/
inductive Walk {S R C CU CT E : Type} (prim : StringOps S R C CU CT E) (s : S) :
    Index → List (Index × C) → Prop where
  | stop {i : Index} (atEnd : i.val = (prim.ncodeunits s).val + 1)
      (done : prim.iterateAt s i = .ok none) : Walk prim s i []
  | step {i j : Index} {c : C} {rest : List (Index × C)}
      (inBounds : 1 ≤ i.val ∧ i.val ≤ (prim.ncodeunits s).val)
      (yield : prim.iterateAt s i = .ok (some (c, j))) (advances : i.val < j.val)
      (tail : Walk prim s j rest) : Walk prim s i ((i, c) :: rest)

/-- The documented `AbstractString` interface for one value (basic.jl:5-38 and the
`ncodeunits`, `isvalid` and `iterate` docstrings): `iterate(s)` starts at
`firstindex(s) == 1`, iteration follows `Walk`, and an in-bounds index is valid exactly
when a character starts there. These are laws of the user's own methods only. -/
structure Lawful {S R C CU CT E : Type} (prim : StringOps S R C CU CT E) (s : S)
    (layout : List (Index × C)) : Prop where
  firstIterate : prim.iterateFirst s = prim.iterateAt s (int 1)
  walk : Walk prim s (int 1) layout
  isvalid : ∀ i : Index, 1 ≤ i.val → i.val ≤ (prim.ncodeunits s).val →
    prim.isvalid s i = .ok (layout.any (fun p => p.1.val == i.val))

/-- Julia exception values raised by the substring constructors and `SubString`
bounds checks (`BoundsError(s, i:j)`, `BoundsError(v, i)`, `StringIndexError(v, i)`).
These are exception constructors, not callees. -/
structure ViewErrors (S E : Type) where
  rangeError : S → Index → Index → E
  viewRangeError : Sub.SubString S → Index → Index → E
  viewBoundsError : Sub.SubString S → Index → E
  viewIndexError : Sub.SubString S → Index → E

/-- `i:j` as an `AbstractUnitRange{Int}` for `checkbounds(Bool, s, i:j)` (basic.jl:206-207). -/
def unitRangeOps {E : Type} : IntegerRangeOps (Index × Index) Index E where
  isempty r := decide (r.2.val < r.1.val)
  minimum r := .ok r.1
  maximum r := .ok r.2
  atLeastOne i := decide (1 ≤ i.val)
  atMostN i n := decide (i.val ≤ n.val)

/-- `checkbounds(Bool, v, i)` on a `SubString` (basic.jl:202-205). -/
def viewInBounds {S : Type} (v : Sub.SubString S) (i : Index) : Bool :=
  checkboundsScalar (fun v : Sub.SubString S => v.ncodeunits) (fun i : Index => decide (1 ≤ i.val))
    (fun i n => decide (i.val ≤ n.val)) v i

/-- `checkbounds(v, i)` on a `SubString` (basic.jl:212-213). -/
def viewCheck {S E : Type} (errs : ViewErrors S E) (v : Sub.SubString S) (i : Index) :
    Except E Unit :=
  JuliaLean.base.strings.basic.checkbounds (fun v i => .ok (viewInBounds v i))
    errs.viewBoundsError v i

def viewParentIndex {E : Type} (offset i : Index) : Except E Index := .ok (offset + i)

/-- `iterate(s::SubString, i)` (substring.jl:151-158) over the parent's own `iterate`. -/
def viewIterateAt {S R C CU CT E : Type} (prim : StringOps S R C CU CT E)
    (errs : ViewErrors S E) (v : Sub.SubString S) (i : Index) : Except E (Option (C × Index)) :=
  Sub.iterateSubString JuliaLean.base.int.eq_int (viewCheck errs) viewParentIndex
    prim.iterateAt v i

/-- `SubString{S}` as an `AbstractString`: substring.jl's `ncodeunits`, `codeunit`,
`isvalid` and `iterate`. Index arithmetic is supplied by `gFull` (the generic basic.jl
methods apply to `SubString{S}` for every parent `S`); the `thisind`, `prevind`,
`nextind`, `lastindex` and `checkbounds` placeholders below are replaced there. -/
def gSubPrim {S R C CU CT E : Type} (prim : StringOps S R C CU CT E) (errs : ViewErrors S E) :
    StringOps (Sub.SubString S) R C CU CT E where
  ncodeunits v := v.ncodeunits
  codeunitType v := prim.codeunitType v.string
  codeunitSize := prim.codeunitSize
  codeunit v i := Sub.codeunitSubStringAt (viewCheck errs) viewParentIndex prim.codeunit v i
  isvalid v i := Sub.isvalidSubStringAt (fun v i => .ok (viewInBounds v i)) viewParentIndex
    prim.isvalid v i
  iterateFirst v := viewIterateAt prim errs v (int 1)
  iterateAt := viewIterateAt prim errs
  iterationBound v := v.ncodeunits.val.toNat + 1
  thisind _ i := .ok i
  prevind _ i _ := .ok i
  nextind _ i _ := .ok i
  lastindex v := .ok v.ncodeunits
  getindexSlice _ _ _ := .error (prim.methodError "getindex(::SubString, ::UnitRange)")
  checkbounds := viewCheck errs
  checkboundsBool v i := .ok (viewInBounds v i)
  boundsError := errs.viewBoundsError
  stringIndexError := errs.viewIndexError
  methodError := prim.methodError
  argumentError := prim.argumentError
  tupleTypeError := prim.tupleTypeError
  isBoundsError := prim.isBoundsError
  characters v := Sub.collectSubStringLoop (viewIterateAt prim errs) v
    (v.ncodeunits.val.toNat + 1) (int 1)
  sameReference _ _ := false
  equalChar := prim.equalChar
  lessChar := prim.lessChar

/-- The parent operations used by substring.jl's constructors, from the string's own
methods and the installed basic.jl derivations. -/
def gParent {S R C CU CT E : Type} (prim : StringOps S R C CU CT E) (errs : ViewErrors S E) :
    Sub.SubStringOps S C CT E where
  ncodeunits := prim.ncodeunits
  codeunitType := prim.codeunitType
  length := lengthInt (gFull prim)
  checkboundsRange s i j := JuliaLean.base.strings.basic.checkbounds
    (JuliaLean.base.strings.basic.checkboundsRange (gFull prim) unitRangeOps)
    (fun s r => errs.rangeError s r.1 r.2) s (i, j)
  checkboundsViewRange v i j := JuliaLean.base.strings.basic.checkbounds
    (JuliaLean.base.strings.basic.checkboundsRange (gFull (gSubPrim prim errs)) unitRangeOps)
    (fun v r => errs.viewRangeError v r.1 r.2) v (i, j)
  isvalid := prim.isvalid
  stringIndexError := prim.stringIndexError
  boundsError := errs.rangeError
  viewBoundsError := errs.viewRangeError
  nextind := nextindOne (gFull prim)
  firstindex v := firstindexString v
  thisindParent := (gFull prim).thisind
  isasciiCodeunits _ := .error (prim.methodError "isascii")
  sizeof := sizeofString prim

/-- `SubString(s, i::Int, j::Int)` (substring.jl:108). -/
def gRange {S R C CU CT E : Type} (prim : StringOps S R C CU CT E) (errs : ViewErrors S E)
    (s : S) (i j : Index) : Except E (Sub.SubString S) :=
  Sub.subStringInt (gParent prim errs) s i j

/-- `SubString(s, i)` with `j = lastindex(s)` (substring.jl:109). -/
def gFrom {S R C CU CT E : Type} (prim : StringOps S R C CU CT E) (errs : ViewErrors S E)
    (s : S) (i : Index) : Except E (Sub.SubString S) :=
  Sub.subStringIntegerDefault (gParent prim errs) (fun i => .ok i) (gFull prim).lastindex s i

/-- `SubString(s)` (substring.jl:117). -/
def gWhole {S R C CU CT E : Type} (prim : StringOps S R C CU CT E) (errs : ViewErrors S E)
    (s : S) : Except E (Sub.SubString S) :=
  Sub.subStringWhole (gParent prim errs) s

/-- `SubString(v::SubString, i, j)` (substring.jl:112-115). -/
def gNested {S R C CU CT E : Type} (prim : StringOps S R C CU CT E) (errs : ViewErrors S E)
    (v : Sub.SubString S) (i j : Index) : Except E (Sub.SubString S) :=
  Sub.subStringNested (gParent prim errs) v i j

/-- The characters of a returned `SubString`, by its installed iterator. -/
def ViewIterates {S R C CU CT E : Type} (prim : StringOps S R C CU CT E) (errs : ViewErrors S E)
    (v : Sub.SubString S) (cs : List C) : Prop :=
  Iterates (gSubPrim prim errs).iterateFirst (gSubPrim prim errs).iterateAt v cs

inductive ViewsIterate {S R C CU CT E : Type} (prim : StringOps S R C CU CT E)
    (errs : ViewErrors S E) : List (Sub.SubString S) → List (List C) → Prop where
  | nil : ViewsIterate prim errs [] []
  | cons {v : Sub.SubString S} {cs : List C} {vs : List (Sub.SubString S)} {css : List (List C)}
      (head : ViewIterates prim errs v cs) (tail : ViewsIterate prim errs vs css) :
      ViewsIterate prim errs (v :: vs) (cs :: css)

/-- `iterate(r::Iterators.Reverse{<:AbstractString}, i)` (basic.jl:775). -/
def gRevIterate {S R C CU CT E : Type} (prim : StringOps S R C CU CT E)
    (r : ReverseString S) (st : Option Index) : Except E (Option (C × Index)) :=
  reverseIterateString (gFull prim) id (fun i j => .ok (JuliaLean.base.int.slt_int i j))
    (getindexString (gFull prim)) (previndOne (gFull prim)) r st

/-- Operations of `Iterators.Reverse(s)`. `endswith` and `chopsuffix` call only `iterate`
on the reversed value (basic.jl:775); the remaining fields delegate to `s` and are unused. -/
def gRevOps {S R C CU CT E : Type} (prim : StringOps S R C CU CT E) :
    StringOps (ReverseString S) R C CU CT E where
  ncodeunits r := prim.ncodeunits r.itr
  codeunitType r := prim.codeunitType r.itr
  codeunitSize := prim.codeunitSize
  codeunit r := prim.codeunit r.itr
  isvalid r := prim.isvalid r.itr
  iterateFirst r := gRevIterate prim r none
  iterateAt r i := gRevIterate prim r (some i)
  iterationBound r := prim.iterationBound r.itr
  thisind r := prim.thisind r.itr
  prevind r := prim.prevind r.itr
  nextind r := prim.nextind r.itr
  lastindex r := prim.lastindex r.itr
  getindexSlice r := prim.getindexSlice r.itr
  checkbounds r := prim.checkbounds r.itr
  checkboundsBool r := prim.checkboundsBool r.itr
  boundsError r := prim.boundsError r.itr
  stringIndexError r := prim.stringIndexError r.itr
  methodError := prim.methodError
  argumentError := prim.argumentError
  tupleTypeError := prim.tupleTypeError
  isBoundsError := prim.isBoundsError
  characters r := prim.characters r.itr
  sameReference a b := prim.sameReference a.itr b.itr
  equalChar := prim.equalChar
  lessChar := prim.lessChar

/-- `Iterators.Reverse(s)` (iterators.jl struct construction). -/
def reverseOf {S : Type} (s : S) : ReverseString S := ⟨s⟩

/-- `==(x::AbstractChar, y::AbstractChar) = Char(x)::Char == Char(y)::Char` (char.jl:270),
the installed `eq_AbstractChar` applied to both element types; `toC`/`toD` are the element
types' `Char` conversions (`pure` for `Char`, where the result equals char.jl:263). -/
def charEq {C D E : Type} (toC : C → CharResult UInt32) (toD : D → CharResult UInt32)
    (lift : CharError → E) (c : C) (d : D) : Except E Bool :=
  match JuliaLean.base.char.eq_AbstractChar toC toD JuliaLean.base.char.eq_Char c d with
  | .ok b => .ok b
  | .error e => .error (lift e)

/-- `Char(c::Char) = c` (char.jl), for `Char` elements. -/
def charId (c : UInt32) : CharResult UInt32 := .ok (JuliaLean.base.char.constructor_Same_AbstractChar c)

def charsIn {C : Type} (layout : List (Index × C)) : List C := layout.map (·.2)

/-! ## Character-sequence specifications (generic AbstractString) -/

/-- id: stringutil-prefix-sequence. Source: startswith docstring, util.jl:16-39.
For every pair of lawful strings, possibly of different types and element types,
`startswith` returns whether the prefix's characters (compared through `Char`) begin the
source's characters. -/
def PrefixSequence : Prop :=
  ∀ {S T R1 R2 C D CU1 CU2 CT1 CT2 E : Type}
    (primA : StringOps S R1 C CU1 CT1 E) (primB : StringOps T R2 D CU2 CT2 E)
    (toC : C → CharResult UInt32) (toD : D → CharResult UInt32) (lift : CharError → E)
    (a : S) (b : T) (la : List (Index × C)) (lb : List (Index × D)) (ua ub : List UInt32),
    Lawful primA a la → Lawful primB b lb →
    (charsIn la).mapM toC = .ok ua → (charsIn lb).mapM toD = .ok ub →
    startswith (gFull primA) (gFull primB) (charEq toC toD lift) a b =
      some (.ok (ub.isPrefixOf ua))

private theorem walkCharacterTrace {S R C CU CT E : Type}
    (prim : StringOps S R C CU CT E) (s : S) {i : Index}
    {layout : List (Index × C)} (h : Walk prim s i layout) :
    ∃ first, prim.iterateAt s i = .ok first ∧
      CharacterTrace (prim.iterateAt s) first (charsIn layout) := by
  induction h with
  | stop _ done => exact ⟨none, done, .nil⟩
  | step _ yield _ _ ih =>
    obtain ⟨first, hfirst, trace⟩ := ih
    exact ⟨_, yield, .cons hfirst trace⟩

private theorem mapM_cons_ok {C : Type} (f : C → CharResult UInt32) (c : C)
    (rest : List C) {values : List UInt32}
    (h : (c :: rest).mapM f = .ok values) :
    ∃ x xs, f c = .ok x ∧ rest.mapM f = .ok xs ∧ values = x :: xs := by
  cases hc : f c with
  | error e => simp [List.mapM_cons, Bind.bind, Pure.pure, Except.bind, Except.pure,
      Functor.map, Except.map, hc] at h
  | ok x =>
    cases hrest : rest.mapM f with
    | error e => simp [List.mapM_cons, Bind.bind, Pure.pure, Except.bind, Except.pure,
        Functor.map, Except.map, hc, hrest] at h
    | ok xs =>
      simp [List.mapM_cons, Bind.bind, Pure.pure, Except.bind, Except.pure,
        Functor.map, Except.map, hc, hrest] at h
      subst values
      exact ⟨x, xs, rfl, rfl, rfl⟩

private theorem prefixTraceMapped
    {S T RA RB C D CU1 CU2 CT1 CT2 E : Type}
    (opsA : StringOps S RA C CU1 CT1 E) (opsB : StringOps T RB D CU2 CT2 E)
    (toC : C → CharResult UInt32) (toD : D → CharResult UInt32)
    (lift : CharError → E) (a : S) (b : T) :
    ∀ (source : List C) (pre : List D) (ua ub : List UInt32)
      (i : Option (C × Index)) (j : Option (D × Index)),
      CharacterTrace (opsA.iterateAt a) i source →
      CharacterTrace (opsB.iterateAt b) j pre →
      source.mapM toC = .ok ua → pre.mapM toD = .ok ub →
      ∃ result, WhileTrace (startswith.step opsA opsB (charEq toC toD lift) a b) (i, j) result ∧
        result = ub.isPrefixOf ua := by
  intro source pre
  induction pre generalizing source with
  | nil =>
    intro ua ub i j _ hpre _ hmapB
    have hub : ub = [] := Except.ok.inj hmapB.symm
    subst ub
    cases hpre
    refine ⟨true, .done ?_, ?_⟩
    · simp [startswith.step]
    · simp [List.isPrefixOf]
  | cons d rest ih =>
    intro ua ub i j hsource hpre hmapA hmapB
    cases hpre with
    | @cons _ nextB currentB restB hstepB htailB =>
      cases hsource with
      | nil =>
        obtain ⟨d32, d32s, hd, hrest, hub⟩ := mapM_cons_ok toD d rest hmapB
        subst ub
        have hua : ua = [] := Except.ok.inj hmapA.symm
        subst ua
        refine ⟨false, .done ?_, ?_⟩
        · simp [startswith.step]
        · simp [List.isPrefixOf]
      | @cons c nextA currentA restA hstepA htailA =>
        obtain ⟨c32, c32s, hc, hrestA, hua⟩ := mapM_cons_ok toC c restA hmapA
        obtain ⟨d32, d32s, hd, hrestB, hub⟩ := mapM_cons_ok toD d rest hmapB
        subst ua
        subst ub
        have hsym : (c32 == d32) = (d32 == c32) := by
          cases h1 : (c32 == d32) <;> cases h2 : (d32 == c32)
          · rfl
          · have he : d32 = c32 := eq_of_beq h2
            subst c32
            simp at h1
          · have he : c32 = d32 := eq_of_beq h1
            subst d32
            simp at h2
          · rfl
        have hchar : charEq toC toD lift c d = .ok (d32 == c32) := by
          simp [charEq, hc, hd, JuliaLean.base.char.eq_AbstractChar,
            JuliaLean.base.char.eq_Char, hsym, bind, pure, Except.bind, Except.pure,
            Except.map, Except.mapError]
        by_cases heq : d32 == c32
        · obtain ⟨result, trace, hresult⟩ :=
            ih restA c32s d32s currentA currentB htailA htailB hrestA hrestB
          refine ⟨result, .next ?_ trace, ?_⟩
          · simp [startswith.step, hchar, heq, hstepA, hstepB, bind, pure,
              Except.bind, Except.pure]
          · simpa [List.isPrefixOf, heq] using hresult
        · refine ⟨false, .done ?_, ?_⟩
          · simp [startswith.step, hchar, heq, bind, pure, Except.bind, Except.pure]
          · simp [List.isPrefixOf, heq]

theorem prefixSequence_proven : PrefixSequence := by
  intro S T R1 R2 C D CU1 CU2 CT1 CT2 E primA primB toC toD lift a b la lb ua ub
    hlawA hlawB hmapA hmapB
  obtain ⟨i, hi, htraceA⟩ := walkCharacterTrace primA a hlawA.walk
  obtain ⟨j, hj, htraceB⟩ := walkCharacterTrace primB b hlawB.walk
  have hfirstA : (gFull primA).iterateFirst a = .ok i := by
    simpa [gFull, JuliaLean.base.strings.basic.modelStringOps] using
      hlawA.firstIterate.trans hi
  have hfirstB : (gFull primB).iterateFirst b = .ok j := by
    simpa [gFull, JuliaLean.base.strings.basic.modelStringOps] using
      hlawB.firstIterate.trans hj
  have htraceA' : CharacterTrace ((gFull primA).iterateAt a) i (charsIn la) := by
    simpa [gFull, JuliaLean.base.strings.basic.modelStringOps] using htraceA
  have htraceB' : CharacterTrace ((gFull primB).iterateAt b) j (charsIn lb) := by
    simpa [gFull, JuliaLean.base.strings.basic.modelStringOps] using htraceB
  obtain ⟨result, trace, hresult⟩ := prefixTraceMapped
    (gFull primA) (gFull primB) toC toD lift a b
    (charsIn la) (charsIn lb) ua ub i j htraceA' htraceB' hmapA hmapB
  have hrun := whileLoop_trace
    (startswith.step (gFull primA) (gFull primB) (charEq toC toD lift) a b) trace
  simp [startswith, hfirstA, hfirstB, hresult, hrun]
/-- id: stringscova-util-endswith-abstract-rebuilt. Source: endswith docstring,
util.jl:42-66. Reverse iteration is the installed basic.jl:775 method. -/
def SuffixSequence : Prop :=
  ∀ {S T R1 R2 C D CU1 CU2 CT1 CT2 E : Type}
    (primA : StringOps S R1 C CU1 CT1 E) (primB : StringOps T R2 D CU2 CT2 E)
    (toC : C → CharResult UInt32) (toD : D → CharResult UInt32) (lift : CharError → E)
    (a : S) (b : T) (la : List (Index × C)) (lb : List (Index × D)) (ua ub : List UInt32),
    Lawful primA a la → Lawful primB b lb →
    (charsIn la).mapM toC = .ok ua → (charsIn lb).mapM toD = .ok ub →
    endswith reverseOf reverseOf (gRevOps primA) (gRevOps primB) (charEq toC toD lift) a b =
      some (.ok (ub.reverse.isPrefixOf ua.reverse))

/-- id: stringscova-util-chopprefix-abstract-rebuilt. Source: chopprefix docstring,
util.jl:246-279. The result is a view of `s` whose characters are the source with a
matching prefix removed, or the whole source. -/
def ChopPrefixSequence : Prop :=
  ∀ {S T R1 R2 C D CU1 CU2 CT1 CT2 E : Type}
    (prim : StringOps S R1 C CU1 CT1 E) (primP : StringOps T R2 D CU2 CT2 E)
    (errs : ViewErrors S E) (toC : C → CharResult UInt32) (toD : D → CharResult UInt32)
    (lift : CharError → E) (s : S) (pre : T) (ls : List (Index × C)) (lp : List (Index × D))
    (us up : List UInt32),
    Lawful prim s ls → Lawful primP pre lp →
    (charsIn ls).mapM toC = .ok us → (charsIn lp).mapM toD = .ok up →
    ∃ out, chopprefix prim.iterateFirst primP.iterateFirst prim.iterateAt primP.iterateAt
        (fun s => .ok (firstindexString s)) (fun s => gRange prim errs s (int 1) (int 0))
        (gFrom prim errs) (gWhole prim errs) (charEq toC toD lift) s pre = some (.ok out) ∧
      out.string = s ∧
      ViewIterates prim errs out
        (if up.isPrefixOf us then (charsIn ls).drop lp.length else charsIn ls)

/-- id: stringscova-util-chopsuffix-abstract-rebuilt. Source: chopsuffix docstring,
util.jl:300-332. -/
def ChopSuffixSequence : Prop :=
  ∀ {S T R1 R2 C D CU1 CU2 CT1 CT2 E : Type}
    (prim : StringOps S R1 C CU1 CT1 E) (primP : StringOps T R2 D CU2 CT2 E)
    (errs : ViewErrors S E) (toC : C → CharResult UInt32) (toD : D → CharResult UInt32)
    (lift : CharError → E) (s : S) (suf : T) (ls : List (Index × C)) (lp : List (Index × D))
    (us up : List UInt32),
    Lawful prim s ls → Lawful primP suf lp →
    (charsIn ls).mapM toC = .ok us → (charsIn lp).mapM toD = .ok up →
    ∃ out, chopsuffix reverseOf reverseOf (gRevOps prim).iterateFirst (gRevOps primP).iterateFirst
        (gRevOps prim).iterateAt (gRevOps primP).iterateAt (gFull prim).lastindex
        (fun s => .ok (firstindexString s)) (fun s => gRange prim errs s (int 1) (int 0))
        (gRange prim errs) (gWhole prim errs) (charEq toC toD lift) s suf = some (.ok out) ∧
      out.string = s ∧
      ViewIterates prim errs out
        (if up.reverse.isPrefixOf us.reverse then (charsIn ls).take (ls.length - lp.length)
         else charsIn ls)

/-- id: stringscova-util-review-290. Source: chopprefix docstring and the
`AbstractChar` method, util.jl:290-296. Any character type, compared through `Char`. -/
def ChopPrefixCharacter : Prop :=
  ∀ {S R C D CU CT E : Type} (prim : StringOps S R C CU CT E) (errs : ViewErrors S E)
    (toC : C → CharResult UInt32) (toD : D → CharResult UInt32) (lift : CharError → E)
    (s : S) (c : D) (ls : List (Index × C)) (us : List UInt32) (uc : UInt32),
    Lawful prim s ls → (charsIn ls).mapM toC = .ok us → toD c = .ok uc →
    ∃ out, chopprefixChar (fun s => .ok (isemptyString (gFull prim) s))
        (firstString (getindexString (gFull prim))) (fun s => .ok (firstindexString s))
        (nextindOne (gFull prim)) (gFrom prim errs) (gWhole prim errs)
        (charEq toC toD lift) s c = .ok out ∧
      out.string = s ∧
      ViewIterates prim errs out (if us.head? = some uc then (charsIn ls).drop 1 else charsIn ls)

/-- id: stringutil-chopsuffix-character. Source: chopsuffix docstring and the
`AbstractChar` method, util.jl:344-350. `last(s) = s[end]` (abstractarray.jl:632) is
`getindex(s, lastindex(s))` through the installed string methods. -/
def ChopSuffixCharacter : Prop :=
  ∀ {S R C D CU CT E : Type} (prim : StringOps S R C CU CT E) (errs : ViewErrors S E)
    (toC : C → CharResult UInt32) (toD : D → CharResult UInt32) (lift : CharError → E)
    (s : S) (c : D) (ls : List (Index × C)) (us : List UInt32) (uc : UInt32),
    Lawful prim s ls → (charsIn ls).mapM toC = .ok us → toD c = .ok uc →
    ∃ out, chopsuffixChar (fun s => .ok (isemptyString (gFull prim) s))
        (fun s => do getindexString (gFull prim) s (← (gFull prim).lastindex s))
        (fun s => .ok (firstindexString s)) (gFull prim).lastindex (previndOne (gFull prim))
        (gRange prim errs) (gWhole prim errs) (charEq toC toD lift) s c = .ok out ∧
      out.string = s ∧
      ViewIterates prim errs out
        (if us.getLast? = some uc then (charsIn ls).take (ls.length - 1) else charsIn ls)

/-- `Int(n)::Int` for any `BitInteger` `n` (int.jl), with `InexactError` lifted. -/
def toIndex {E : Type} {t : IntTy} (liftJ : JlError → E) (n : JInt t) : Except E Index :=
  match JuliaLean.base.int.convert .i64 n with
  | .ok i => .ok i
  | .error e => .error (liftJ e)

/-- `chop(s; head, tail)` with counts of any `Integer` type `N`: `nextind(s, i, n::Integer)` and
`prevind(s, i, n::Integer)` call `Int(n)` (basic.jl:501,560), then run the installed `Int`
methods. `toInt` is that `Int(n)` for the counts' own type: the installed int.jl `convert`
(`toIndex liftJ`) for every `BitInteger`, the type's own method otherwise; mixed count types are
the instance where `N` is their sum. -/
def chopCallG {S R C CU CT E N : Type} (prim : StringOps S R C CU CT E)
    (errs : ViewErrors S E) (toInt : N → Except E Index) (s : S) (head tail : N) :
    Except E (Sub.SubString S) :=
  chop (fun s => .ok (isemptyString (gFull prim) s)) (gWhole prim errs)
    (fun s => .ok (firstindexString s)) (gFull prim).lastindex
    (fun s i n => do (gFull prim).nextind s i (← toInt n))
    (fun s i n => do (gFull prim).prevind s i (← toInt n))
    (gRange prim errs) s head tail

/-- An integer value representable as `Int` (`Int(n)` succeeds, int.jl `convert`). -/
def fitsInt {t : IntTy} (n : JInt t) : Prop := -(2 ^ 63) ≤ n.val ∧ n.val < 2 ^ 63

/-- id: stringutil-chop-characters. Source: chop docstring, util.jl:214-241, the `Integer`
count conversions of `nextind`/`prevind` (basic.jl:501,560) and the checked
`SubString(s, i, j)` (substring.jl:76-84). For every lawful string and counts of every
`Integer` type (`toInt` is their `Int(n)`, with no assumption on it): an empty string is
returned whole without converting the counts; otherwise a failing conversion propagates, a
negative count throws `ArgumentError`, and otherwise `head` leading and `tail` trailing
characters are removed (all of them when the counts exceed the length) as long as `nextind`'s
final `i + n = ncodeunits(s) + head - length(s) + 1` fits in `Int`. When it wraps, the start
index is negative: `SubString` throws `BoundsError` unless the wrapped start also exceeds the
end index `length(s) - tail`, which gives the empty view (strings-chop-head-overflow refutes the
documented empty result for the `BoundsError` case). -/
def ChopCharacters : Prop :=
  ∀ {S R C CU CT E N : Type} (prim : StringOps S R C CU CT E)
    (errs : ViewErrors S E) (toInt : N → Except E Index) (s : S) (ls : List (Index × C))
    (head tail : N),
    Lawful prim s ls →
    let call := chopCallG prim errs toInt s head tail
    let z := (prim.ncodeunits s).val
    let L : Int := ls.length
    (ls = [] → call = gWhole prim errs s) ∧
    (ls ≠ [] → ∀ e, toInt head = .error e → call = .error e) ∧
    (ls ≠ [] → ∀ h, toInt head = .ok h → h.val < 0 →
      ∃ m, call = .error (prim.argumentError m)) ∧
    (ls ≠ [] → ∀ h, toInt head = .ok h → 0 ≤ h.val → ∀ e, toInt tail = .error e →
      call = .error e) ∧
    (ls ≠ [] → ∀ h t, toInt head = .ok h → toInt tail = .ok t → 0 ≤ h.val → t.val < 0 →
      ∃ m, call = .error (prim.argumentError m)) ∧
    (ls ≠ [] → ∀ h t, toInt head = .ok h → toInt tail = .ok t → 0 ≤ h.val → 0 ≤ t.val →
      (h.val + z + 1 - L < 2 ^ 63 →
        ∃ out, call = .ok out ∧ out.string = s ∧
          ViewIterates prim errs out
            (((charsIn ls).drop h.val.toNat).take (ls.length - h.val.toNat - t.val.toNat))) ∧
      (2 ^ 63 ≤ h.val + z + 1 - L → h.val + t.val + z + 1 - 2 * L ≤ 2 ^ 64 →
        ∃ i j, call = .error (errs.rangeError s i j)) ∧
      (2 ^ 64 < h.val + t.val + z + 1 - 2 * L →
        ∃ out, call = .ok out ∧ out.string = s ∧ ViewIterates prim errs out []))

/-- id: stringutil-startswith-character-set. Source: startswith docstring, util.jl:16-40.
`first(str)::AbstractChar in chars` for any `Chars` collection: membership is the
collection's own `in` and is universally quantified, so single characters, tuples,
vectors and sets are all instances. -/
def StartswithCharacterSet : Prop :=
  ∀ {S R C CU CT E Q : Type} (prim : StringOps S R C CU CT E) (member : C → Q → Except E Bool)
    (s : S) (set : Q) (ls : List (Index × C)),
    Lawful prim s ls →
    startswithChars (fun s => .ok (isemptyString (gFull prim) s))
        (firstString (getindexString (gFull prim))) member s set =
      match charsIn ls with
      | [] => .ok false
      | c :: _ => member c set

/-- id: stringutil-endswith-character-set. Source: endswith docstring, util.jl:42-67. -/
def EndswithCharacterSet : Prop :=
  ∀ {S R C CU CT E Q : Type} (prim : StringOps S R C CU CT E) (member : C → Q → Except E Bool)
    (s : S) (set : Q) (ls : List (Index × C)),
    Lawful prim s ls →
    endswithChars (fun s => .ok (isemptyString (gFull prim) s))
        (fun s => do getindexString (gFull prim) s (← (gFull prim).lastindex s)) member s set =
      match (charsIn ls).getLast? with
      | none => .ok false
      | some c => member c set

private theorem getLastMem {α : Type} {xs : List α} {x : α}
    (h : xs.getLast? = some x) : x ∈ xs := by
  induction xs generalizing x with
  | nil => simp at h
  | cons a xs ih =>
    cases xs with
    | nil =>
      simp at h
      subst x
      simp
    | cons b xs =>
      have h' : (b :: xs).getLast? = some x := by simpa using h
      exact List.mem_cons_of_mem a (ih h')

private theorem walkIndicesAtLeast {S R C CU CT E : Type}
    (prim : StringOps S R C CU CT E) (s : S) (lower : Index)
    {i : Index} {ls : List (Index × C)} (h : lower.val ≤ i.val)
    (w : Walk prim s i ls) :
    ∀ p ∈ ls, lower.val ≤ p.1.val := by
  induction w with
  | stop atEnd done =>
    intro p hp
    simp at hp
  | @step i j c rest hbounds hyield hadvance tail ih =>
    intro p hp
    rcases List.mem_cons.mp hp with hhead | htail
    · subst p
      exact h
    · exact ih (by omega) p htail

private theorem getLastCons {α : Type} (a : α) (xs : List α) :
    (a :: xs).getLast? = if xs = [] then some a else xs.getLast? := by
  cases xs <;> rfl
private theorem getLastMap {α β : Type} (f : α → β) (xs : List α) :
    (xs.map f).getLast? = Option.map f xs.getLast? := by
  induction xs with
  | nil => rfl
  | cons a rest ih =>
    cases rest with
    | nil => rfl
    | cons b tail => simpa [List.getLast?] using ih

private theorem walkLastFacts {S R C CU CT E : Type}
    (prim : StringOps S R C CU CT E) (s : S) {i : Index} {ls : List (Index × C)}
    (w : Walk prim s i ls) :
    ∀ p, ls.getLast? = some p →
      (∃ next, prim.iterateAt s p.1 = .ok (some (p.2, next))) ∧
      (∀ q ∈ ls, q.1.val ≤ p.1.val) ∧
      1 ≤ p.1.val ∧ p.1.val ≤ (prim.ncodeunits s).val := by
  induction w with
  | stop atEnd done =>
    intro p hp
    simp at hp
  | @step i j c rest hbounds hyield hadvance tail ih =>
    intro p hp
    rw [getLastCons] at hp
    by_cases hnil : rest = []
    · simp [hnil] at hp
      subst p
      refine ⟨⟨j, hyield⟩, ?_, hbounds.1, hbounds.2⟩
      intro q hq
      rcases List.mem_cons.mp hq with hhead | htail
      · subst q
        omega
      · simp [hnil] at htail
    · simp [hnil] at hp
      have htail := ih p hp
      let next : Index := Classical.choose htail.1
      have hnext : prim.iterateAt s p.1 = .ok (some (p.2, next)) :=
        Classical.choose_spec htail.1
      have hbound := htail.2.1
      have hlo := htail.2.2.1
      have hup := htail.2.2.2
      refine ⟨⟨next, hnext⟩, ?_, hlo, hup⟩
      intro q hq
      rcases List.mem_cons.mp hq with hhead | hrest
      · subst q
        have hmem : p ∈ rest := getLastMem hp
        have hstart := walkIndicesAtLeast prim s i (by omega) tail p hmem
        omega
      · exact hbound q hrest



private theorem getLastNoneEqNil {α : Type} {xs : List α} (h : xs.getLast? = none) : xs = [] := by
  cases xs with
  | nil => rfl
  | cons a rest => simp at h

private theorem getLastSome {α : Type} (a : α) (xs : List α) :
    ∃ x, (a :: xs).getLast? = some x := by
  cases h : xs.getLast? with
  | none =>
    have hnil := getLastNoneEqNil h
    subst xs
    exact ⟨a, rfl⟩
  | some x =>
    have hne : xs ≠ [] := by
      intro he
      subst xs
      simp at h
    exact ⟨x, by simp [getLastCons, hne, h]⟩


private theorem walkEndBound {S R C CU CT E : Type}
    (prim : StringOps S R C CU CT E) (s : S) {i : Index} {ls : List (Index × C)}
    (w : Walk prim s i ls) :
    (prim.ncodeunits s).val + 1 ≤ JuliaLean.IntTy.max .i64 := by
  induction w with
  | @stop i atEnd done =>
    have hi := i.property.2
    omega
  | @step i j c rest hbounds hyield hadvance tail ih =>
    exact ih
private theorem walkStartBound {S R C CU CT E : Type}
    (prim : StringOps S R C CU CT E) (s : S) {i : Index} {ls : List (Index × C)}
    (w : Walk prim s i ls) : i.val ≤ (prim.ncodeunits s).val + 1 := by
  induction w with
  | @stop i atEnd done => omega
  | @step i j c rest hbounds hyield hadvance tail ih => omega

private inductive ReverseSegment {C E : Type}
    (getindex : Index → Except E C) (prevind : Index → Except E Index) :
    Index → List C → Index → Prop where
  | nil (i : Index) : ReverseSegment getindex prevind i [] i
  | cons {i j stop : Index} {c : C} {rest : List C}
      (positive : 1 ≤ i.val) (character : getindex i = .ok c)
      (previous : prevind i = .ok j)
      (tail : ReverseSegment getindex prevind j rest stop) :
      ReverseSegment getindex prevind i (c :: rest) stop

private theorem reverseSegmentAppend {C E : Type}
    (getindex : Index → Except E C) (prevind : Index → Except E Index)
    {i middle stop : Index} {left right : List C}
    (hleft : ReverseSegment getindex prevind i left middle)
    (hright : ReverseSegment getindex prevind middle right stop) :
    ReverseSegment getindex prevind i (left ++ right) stop := by
  induction hleft with
  | nil => simpa using hright
  | cons positive character previous tail ih =>
    simpa using ReverseSegment.cons positive character previous (ih hright)

private theorem walkReverseSegment {S R C CU CT E : Type}
    (prim : StringOps S R C CU CT E) (s : S) {i : Index} {pairs : List (Index × C)}
    (walk : Walk prim s i pairs) (layout : List (Index × C))
    (isvalid : ∀ k, 1 ≤ k.val ∧ k.val ≤ (prim.ncodeunits s).val →
      prim.isvalid s k = .ok (layout.any (fun p => p.1.val == k.val)))
    (listed : ∀ p, p ∈ pairs → p ∈ layout)
    (earlier : ∀ p, p ∈ layout → p ∈ pairs ∨ p.1.val ≤ i.val)
    (before : Index)
    (hbefore : pairs = [] ∨ previndOne (gFull prim) s i = .ok before) :
    ∃ start, (pairs = [] → start = before) ∧
      (∀ p, pairs.getLast? = some p → start = p.1) ∧
      ReverseSegment (getindexString (gFull prim) s) (previndOne (gFull prim) s)
        start (charsIn pairs).reverse before := by
  induction walk generalizing layout before with
  | @stop i atEnd done =>
    exact ⟨before, (fun _ => rfl), (by intro p hp; simp at hp), ReverseSegment.nil before⟩
  | @step i j c rest hbounds hyield hadvance tail ih =>
    have hbefore' : previndOne (gFull prim) s i = .ok before := by
      rcases hbefore with hnil | hprev
      · simp at hnil
      · exact hprev
    have hvalidHead : prim.isvalid s i = .ok true := by
      have hmem : (i, c) ∈ layout := listed (i, c) (by simp)
      have hany : layout.any (fun p => p.1.val == i.val) = true :=
        List.any_eq_true.mpr ⟨(i, c), hmem, by simp⟩
      have h := isvalid i ⟨hbounds.1, hbounds.2⟩
      rw [hany] at h
      exact h
    have hlistedTail : ∀ p, p ∈ rest → p ∈ layout := by
      intro p hp
      exact listed p (List.mem_cons_of_mem (i, c) hp)
    have hearlierTail : ∀ p, p ∈ layout → p ∈ rest ∨ p.1.val ≤ j.val := by
      intro p hp
      rcases earlier p hp with hcur | hlt
      · rcases List.mem_cons.mp hcur with hhead | hrest
        · have hpIndex : p.1.val = i.val := by cases hhead; rfl
          exact Or.inr (by rw [hpIndex]; omega)
        · exact Or.inl hrest
      · exact Or.inr (by omega)
    have hnextBound : j.val ≤ (prim.ncodeunits s).val + 1 :=
      walkStartBound prim s tail
    have hprevTail : rest = [] ∨ previndOne (gFull prim) s j = .ok i := by
      cases rest with
      | nil => exact Or.inl rfl
      | cons p tailRest =>
        have hnoBetween : ∀ k : Index, i.val < k.val ∧ k.val < j.val →
            prim.isvalid s k = .ok false := by
          intro k ⟨hik, hkj⟩
          have hany : layout.any (fun q => q.1.val == k.val) = false := by
            cases hscan : layout.any (fun q => q.1.val == k.val) with
            | false => rfl
            | true =>
              obtain ⟨q, hq, hqk⟩ := List.any_eq_true.mp hscan
              have hqEq : q.1.val = k.val := by
                simpa using (beq_iff_eq.mp hqk)
              rcases earlier q hq with hcur | hlt
              · rcases List.mem_cons.mp hcur with hhead | hrest
                · have hqIndex : q.1.val = i.val := by cases hhead; rfl
                  rw [hqIndex] at hqEq
                  omega
                · have hqLower := walkIndicesAtLeast prim s j (Int.le_refl _) tail q hrest
                  rw [hqEq] at hqLower
                  omega
              · rw [hqEq] at hlt
                omega
          have h := isvalid k ⟨by omega, by omega⟩
          rw [hany] at h
          exact h
        have hmax := walkEndBound prim s (Walk.step hbounds hyield hadvance tail)
        have hprev := JuliaLean.Proofs.base.strings.basic.prevind_proven.2.2.2.2.1
          S R C CU CT E prim (fun x => toString x.val) s j i hmax
          ⟨hbounds.1, hadvance, hnextBound⟩ hvalidHead hnoBetween
        exact Or.inr hprev.1
    obtain ⟨start, hnil, hlast, htail⟩ :=
      ih layout isvalid hlistedTail hearlierTail i hprevTail
    have hget : getindexString (gFull prim) s i = .ok c := by
      have hcheck : (gFull prim).checkbounds s i = .ok () := by
        simp [gFull, modelStringOps, JuliaLean.base.strings.basic.checkbounds,
          JuliaLean.base.strings.basic.checkboundsScalar, hbounds.1, hbounds.2,
          bind, Except.bind, pure, Except.pure]
      have hvalidFull : (gFull prim).isvalid s i = .ok true := by
        change prim.isvalid s i = .ok true
        exact hvalidHead
      have hiterFull : (gFull prim).iterateAt s i = .ok (some (c, j)) := by
        change prim.iterateAt s i = .ok (some (c, j))
        exact hyield
      simp [getindexString, getindexInteger, hcheck, hvalidFull, hiterFull,
        bind, Except.bind, pure, Except.pure]
    have hone : ReverseSegment (getindexString (gFull prim) s)
        (previndOne (gFull prim) s) i [c] before := by
      simpa using ReverseSegment.cons hbounds.1 hget hbefore' (ReverseSegment.nil before)
    have hsegment :
        ReverseSegment (getindexString (gFull prim) s) (previndOne (gFull prim) s)
          start ((charsIn rest).reverse ++ [c]) before :=
      reverseSegmentAppend _ _ htail hone
    refine ⟨start, ?_, ?_, ?_⟩
    · intro hnil'
      simp at hnil'
    · intro p hp
      rw [getLastCons] at hp
      by_cases hnil' : rest = []
      · simp [hnil'] at hp
        subst p
        exact hnil hnil'
      · simp [hnil'] at hp
        exact hlast p hp
    · simpa [charsIn, List.reverse_cons] using hsegment

private theorem reverseSegmentTrace {S R C CU CT E : Type}
    (prim : StringOps S R C CU CT E) (s : S) {start stop : Index} {chars : List C}
    (segment : ReverseSegment (getindexString (gFull prim) s) (previndOne (gFull prim) s)
      start chars stop) (hstop : stop.val < 1) :
    ∃ first,
      (gRevOps prim).iterateAt (reverseOf s) start = .ok first ∧
      CharacterTrace ((gRevOps prim).iterateAt (reverseOf s)) first chars := by
  induction segment with
  | nil i =>
    refine ⟨none, ?_, CharacterTrace.nil⟩
    have hslt : JuliaLean.base.int.slt_int i (firstindexString s) = true := by
      rw [JuliaLean.Proofs.base.int.slt_int_eq rfl]
      simp [firstindexString, hstop]
    simp [gRevOps, gRevIterate, reverseOf, reverseIterateString, hslt]
  | @cons i j stop c rest positive character previous tail ih =>
    obtain ⟨first, hfirst, trace⟩ := ih hstop
    refine ⟨some (c, j), ?_, ?_⟩
    · have hslt : JuliaLean.base.int.slt_int i (firstindexString s) = false := by
        rw [JuliaLean.Proofs.base.int.slt_int_eq rfl]
        have hnotlt : ¬ i.val < 1 := by omega
        simp [firstindexString, hnotlt]
      simp [gRevOps, gRevIterate, reverseOf, reverseIterateString, hslt,
        character, previous]
    · exact CharacterTrace.cons hfirst trace

private theorem reverseLayoutTrace {S R C CU CT E : Type}
    (prim : StringOps S R C CU CT E) (s : S) (ls : List (Index × C))
    (hlaw : Lawful prim s ls) :
    ∃ first,
      (gRevOps prim).iterateFirst (reverseOf s) = .ok first ∧
      CharacterTrace ((gRevOps prim).iterateAt (reverseOf s)) first (charsIn ls).reverse := by
  cases ls with
  | nil =>
    cases hlaw.walk with
    | stop atEnd done =>
      have hone : (int 1).val = 1 := by decide
      have hn : (prim.ncodeunits s).val = 0 := by omega
      have hnIndex : prim.ncodeunits s = int 0 := by
        apply Subtype.ext
        simpa using hn
      have hplus : (int 0 + int 1).val = 1 := by decide
      have hlastModel :
          JuliaLean.base.strings.basic.thisindInt prim s (int 0) = .ok (int 0) := by
        simp [JuliaLean.base.strings.basic.thisindInt,
          JuliaLean.base.strings.basic.thisindLoop, hnIndex, hplus]
      have hlast : (gFull prim).lastindex s = .ok (int 0) := by
        simpa [gFull, JuliaLean.base.strings.basic.modelStringOps,
          JuliaLean.base.strings.basic.lastindexString, hnIndex] using hlastModel
      have hslt : JuliaLean.base.int.slt_int (int 0) (int 1) = true := by
        rw [JuliaLean.Proofs.base.int.slt_int_eq rfl]
        decide
      refine ⟨none, ?_, CharacterTrace.nil⟩
      simp [gRevOps, gRevIterate, reverseOf, reverseIterateString,
        JuliaLean.base.strings.basic.firstindexString, hlast, hslt]
  | cons first rest =>
    have hncNonneg : 0 ≤ (prim.ncodeunits s).val := by
      have hone : (int 1).val = 1 := by decide
      have hstart := walkStartBound prim s hlaw.walk
      omega
    have hmax := walkEndBound prim s hlaw.walk
    have hprevFirst :
        previndOne (gFull prim) s (int 1) = .ok (int 0) := by
      have h := JuliaLean.Proofs.base.strings.basic.prevind_proven.2.2.2.1
        S R C CU CT E prim (fun x => toString x.val) s (int 1)
        hncNonneg hmax (by decide)
      simpa [gFull, JuliaLean.base.strings.basic.modelStringOps] using h.2
    obtain ⟨pair, hlast⟩ := getLastSome first rest
    have hFacts := walkLastFacts prim s hlaw.walk pair hlast
    have hbound := hFacts.2.1
    have hlo := hFacts.2.2.1
    have hup := hFacts.2.2.2
    have hpairMem : pair ∈ first :: rest := getLastMem hlast
    have hvalidPair : prim.isvalid s pair.1 = .ok true := by
      have h := hlaw.isvalid pair.1 hlo hup
      have hany : (first :: rest).any (fun p => p.1.val == pair.1.val) = true :=
        List.any_eq_true.mpr ⟨pair, hpairMem, by simp⟩
      simpa [hany] using h
    have hvalidLater :
        ∀ k : Index, pair.1.val < k.val ∧ k.val ≤ (prim.ncodeunits s).val →
          prim.isvalid s k = .ok false := by
      intro k ⟨hgt, hle⟩
      have h := hlaw.isvalid k (by omega) hle
      have hany : (first :: rest).any (fun p => p.1.val == k.val) = false := by
        cases hscan : (first :: rest).any (fun p => p.1.val == k.val) with
        | false => rfl
        | true =>
          obtain ⟨p, hp, hpk⟩ := List.any_eq_true.mp hscan
          have hple := hbound p hp
          have hpEq : p.1.val = k.val := by simpa using (beq_iff_eq.mp hpk)
          omega
      simpa [hany] using h
    have hlastIndex : (gFull prim).lastindex s = .ok pair.1 := by
      have h := JuliaLean.Proofs.base.strings.basic.thisindInt_rewind
        prim s (prim.ncodeunits s) pair.1 hlo hup (Int.le_refl _) hmax
        (Or.inr hvalidPair) hvalidLater
      simpa [gFull, JuliaLean.base.strings.basic.modelStringOps,
        JuliaLean.base.strings.basic.lastindexString] using h
    have hvalid :
        ∀ k, 1 ≤ k.val ∧ k.val ≤ (prim.ncodeunits s).val →
          prim.isvalid s k = .ok ((first :: rest).any (fun p => p.1.val == k.val)) := by
      intro k ⟨hlo', hhi'⟩
      simpa using hlaw.isvalid k hlo' hhi'
    obtain ⟨start, hnil, hlastPair, hsegment⟩ :=
      walkReverseSegment prim s hlaw.walk (first :: rest) hvalid
        (fun p hp => hp) (fun p hp => Or.inl hp) (int 0) (Or.inr hprevFirst)
    have hstart : start = pair.1 := hlastPair pair hlast
    have hlastIndexStart : (gFull prim).lastindex s = .ok start := by
      simpa [hstart] using hlastIndex
    obtain ⟨firstResult, hAt, htrace⟩ := reverseSegmentTrace prim s hsegment (by decide)
    have hfirstResult :
        (gRevOps prim).iterateFirst (reverseOf s) = .ok firstResult := by
      simpa [gRevOps, gRevIterate, reverseOf, reverseIterateString,
        JuliaLean.base.strings.basic.firstindexString, hlastIndexStart] using hAt
    exact ⟨firstResult, hfirstResult, htrace⟩

private theorem mapM_reverse_ok {C : Type} (f : C → CharResult UInt32)
    (xs : List C) {ys : List UInt32} (h : xs.mapM f = .ok ys) :
    xs.reverse.mapM f = .ok ys.reverse := by
  induction xs generalizing ys with
  | nil =>
    cases ys with
    | nil => rfl
    | cons y ys => simp [List.mapM, List.mapM.loop, Pure.pure, Except.pure] at h
  | cons a rest ih =>
    obtain ⟨x, tail, ha, htail, hvalues⟩ := mapM_cons_ok f a rest h
    subst ys
    rw [List.reverse_cons]
    simp [List.mapM_append, ih htail, ha, bind, Except.bind, pure, Except.pure]

theorem suffixSequence_proven : SuffixSequence := by
  intro S T R1 R2 C D CU1 CU2 CT1 CT2 E primA primB toC toD lift a b la lb ua ub
    hlawA hlawB hmapA hmapB
  obtain ⟨firstA, hfirstA, htraceA⟩ := reverseLayoutTrace primA a la hlawA
  obtain ⟨firstB, hfirstB, htraceB⟩ := reverseLayoutTrace primB b lb hlawB
  have hmapARev : ((charsIn la).reverse).mapM toC = .ok ua.reverse :=
    mapM_reverse_ok toC (charsIn la) hmapA
  have hmapBRev : ((charsIn lb).reverse).mapM toD = .ok ub.reverse :=
    mapM_reverse_ok toD (charsIn lb) hmapB
  obtain ⟨result, trace, hresult⟩ := prefixTraceMapped
    (gRevOps primA) (gRevOps primB) toC toD lift (reverseOf a) (reverseOf b)
    (charsIn la).reverse (charsIn lb).reverse ua.reverse ub.reverse
    firstA firstB htraceA htraceB hmapARev hmapBRev
  have hrun := whileLoop_trace
    (startswith.step (gRevOps primA) (gRevOps primB) (charEq toC toD lift)
      (reverseOf a) (reverseOf b)) trace
  simp [endswith, hfirstA, hfirstB, hresult, hrun]



theorem endswithCharacterSetProven : EndswithCharacterSet := by
  intro S R C CU CT E Q prim member s set ls hlaw
  cases ls with
  | nil =>
    cases hlaw.walk with
    | stop atEnd done =>
      have hone : (int 1).val = 1 := by decide
      have hn : (prim.ncodeunits s).val = 0 := by omega
      have hEmpty : isemptyString (gFull prim) s = true := by
        change ((prim.ncodeunits s).val == 0) = true
        simp [hn]
      simp [endswithChars, hEmpty, charsIn, bind, Except.bind, pure, Except.pure]
  | cons first rest =>
    have hLastExists := getLastSome first rest
    let pair : Index × C := Classical.choose hLastExists
    have hlast : (first :: rest).getLast? = some pair := Classical.choose_spec hLastExists
    have hFacts := walkLastFacts prim s hlaw.walk pair hlast
    let next : Index := Classical.choose hFacts.1
    have hiter : prim.iterateAt s pair.1 = .ok (some (pair.2, next)) :=
      Classical.choose_spec hFacts.1
    have hbound := hFacts.2.1
    have hlo := hFacts.2.2.1
    have hup := hFacts.2.2.2
    have hpairMem : pair ∈ first :: rest := getLastMem hlast
    have hmax := walkEndBound prim s hlaw.walk
    have hvalid : prim.isvalid s pair.1 = .ok true := by
      rw [hlaw.isvalid pair.1 hlo hup]
      have hany : (first :: rest).any (fun p => p.1.val == pair.1.val) = true :=
        List.any_eq_true.mpr ⟨pair, hpairMem, by simp⟩
      simp [hany]
    have hvalidLater :
        ∀ k : Index, pair.1.val < k.val ∧ k.val ≤ (prim.ncodeunits s).val →
          prim.isvalid s k = .ok false := by
      intro k ⟨hgt, hle⟩
      rw [hlaw.isvalid k (by omega) hle]
      have hany : (first :: rest).any (fun p => p.1.val == k.val) = false := by
        cases heq : (first :: rest).any (fun p => p.1.val == k.val) with
        | false => rfl
        | true =>
          obtain ⟨p, hp, hpk⟩ := List.any_eq_true.mp heq
          have hple := hbound p hp
          have hpEq : p.1.val = k.val := by simpa using (beq_iff_eq.mp hpk)
          omega
      simp [hany]
    have hlastIndex : (gFull prim).lastindex s = .ok pair.1 := by
      have h := JuliaLean.Proofs.base.strings.basic.thisindInt_rewind
        prim s (prim.ncodeunits s) pair.1 hlo hup (Int.le_refl _) hmax
        (Or.inr hvalid) hvalidLater
      simpa [gFull, JuliaLean.base.strings.basic.modelStringOps,
        JuliaLean.base.strings.basic.lastindexString] using h
    have hcheck : (gFull prim).checkbounds s pair.1 = .ok () := by
      simp [gFull, modelStringOps, JuliaLean.base.strings.basic.checkbounds,
        JuliaLean.base.strings.basic.checkboundsScalar, hlo, hup, bind, Except.bind, pure,
        Except.pure]
    have hvalidFull : (gFull prim).isvalid s pair.1 = .ok true := by
      change prim.isvalid s pair.1 = .ok true
      exact hvalid
    have hiterFull :
        (gFull prim).iterateAt s pair.1 = .ok (some (pair.2, next)) := by
      change prim.iterateAt s pair.1 = .ok (some (pair.2, next))
      exact hiter
    have hget : getindexString (gFull prim) s pair.1 = .ok pair.2 := by
      simp [getindexString, getindexInteger, hcheck, hvalidFull, hiterFull,
        bind, Except.bind, pure, Except.pure]
    have hEmpty : isemptyString (gFull prim) s = false := by
      have hfirst : 1 ≤ (prim.ncodeunits s).val := by omega
      have hne : (prim.ncodeunits s).val ≠ 0 := by omega
      change ((prim.ncodeunits s).val == 0) = false
      simp [hne]
    have hchar : (charsIn (first :: rest)).getLast? = some pair.2 := by
      simpa [charsIn, hlast] using getLastMap Prod.snd (first :: rest)
    simp [endswithChars, hEmpty, hlastIndex, hget, hchar, bind, Except.bind, pure,
      Except.pure]
/-- Independent chomp specification on `Char` elements: one final `'\n'`, and a `'\r'`
immediately before it. -/
def chompChars (cs : List UInt32) : List UInt32 :=
  if cs.getLast? = some 0x0a000000 then
    let t := cs.dropLast
    if t.getLast? = some 0x0d000000 then t.dropLast else t
  else cs

/-- id: stringutil-chomp-characters. Source: chomp docstring, util.jl:353-378.
Every lawful string type with `Char` elements; custom element types are blocked by the
model's `newline : C` literal (round3 proposal R3-1). -/
def ChompCharacters : Prop :=
  ∀ {S R CU CT E : Type} (prim : StringOps S R UInt32 CU CT E) (errs : ViewErrors S E)
    (s : S) (ls : List (Index × UInt32)),
    Lawful prim s ls →
    ∃ out, chomp (gFull prim).lastindex (getindexString (gFull prim)) (previndOne (gFull prim))
        (gRange prim errs) (fun a b => .ok (JuliaLean.base.char.eq_Char a b))
        0x0a000000 0x0d000000 s = .ok out ∧
      out.string = s ∧ ViewIterates prim errs out (chompChars (charsIn ls))

/-! ## `String` and `SubString{String}` (installed string.jl / substring.jl methods) -/

abbrev Raw := Str.JString
abbrev View := Sub.SubString Raw
abbrev Error := Str.StringError
abbrev Result := Str.StringResult

def viewBytes (v : View) : List UInt8 :=
  (v.string.bytes.drop v.offset.val.toNat).take v.ncodeunits.val.toNat

def viewBounds (v : View) (i : Index) : Result Unit :=
  if 1 ≤ i.val ∧ i.val ≤ v.ncodeunits.val then .ok ()
  else .error (.jl .boundsError)

def viewCodeunit (v : View) (i : Index) : Result UInt8 :=
  Sub.codeunitSubStringAt viewBounds (fun offset i => .ok (offset + i))
    Str.stringCodeunit v i

def viewCodeunitAt (_checked : Bool) := viewCodeunit

def viewThisind : View → Index → Result Index :=
  Sub.thisindSubString
    (Str.thisindString (·.ncodeunits) Str.stringBetweenIndex Str.stringBetweenByte viewCodeunitAt)

def viewNextind : View → Index → Result Index :=
  Sub.nextindSubString
    (Str.nextindString (·.ncodeunits) Str.stringBetweenIndex Str.stringBetweenByte viewCodeunitAt)

def parentOps : Sub.SubStringOps Raw UInt32 Unit Error where
  ncodeunits := Str.stringNcodeunits
  codeunitType _ := ()
  length := Str.stringLengthRange
  checkboundsRange s i j :=
    if 1 ≤ i.val ∧ j.val ≤ Int.ofNat s.bytes.length then .ok () else .error (.jl .boundsError)
  checkboundsViewRange s i j :=
    if 1 ≤ i.val ∧ j.val ≤ s.ncodeunits.val then .ok () else .error (.jl .boundsError)
  isvalid s i := .ok (Str.stringIsvalidIndex s i)
  stringIndexError _ i := .stringIndexError i.val
  boundsError _ _ _ := .jl .boundsError
  viewBoundsError _ _ _ := .jl .boundsError
  nextind := Str.stringNextind
  firstindex _ := int 1
  thisindParent := Str.stringThisind
  isasciiCodeunits _ := .error (.jl (.methodError "unused ASCII interface"))
  sizeof := Str.stringNcodeunits

def rawView (s : Raw) : Result View := Sub.subStringWhole parentOps s

/-- `SubString(s::String, i::Int, j::Int)` (substring.jl:108), the installed constructor. -/
def stringView (s : Raw) (i j : Index) : Result View := Sub.subStringInt parentOps s i j

def viewIterate : View → Index → Result (Option (UInt32 × Index)) :=
  Sub.iterateSubString JuliaLean.base.int.eq_int viewBounds
    (fun offset i => .ok (offset + i)) (fun s i => .ok (Str.stringIterate s i))

structure Prepared where
  view : View
  last : Index

def prepareView (v : View) : Result Prepared := do
  let last ← Sub.lastindexSubString viewThisind v
  return ⟨v, last⟩

def prepare (s : Raw) : Result Prepared := do prepareView (← rawView s)

def preparedBytes (s : Prepared) := viewBytes s.view

def preparedSlice (s : Prepared) (i j : Index) : Result Prepared := do
  prepareView (← Sub.subStringNested parentOps s.view i j)

def preparedWhole (s : Prepared) : Result Prepared := do
  prepareView (← Sub.subStringWholeView s.view)

def preparedFrom (s : Prepared) (i : Index) : Result Prepared := preparedSlice s i s.last

def preparedPrim : StringOps Prepared Prepared UInt32 UInt8 Unit Error where
  ncodeunits s := s.view.ncodeunits
  codeunitType _ := ()
  codeunitSize _ := int 1
  codeunit s i := viewCodeunit s.view i
  isvalid s i := Sub.isvalidSubStringAt
    (fun v i => .ok (1 ≤ i.val && i.val ≤ v.ncodeunits.val))
    (fun offset i => .ok (offset + i)) (fun raw i => .ok (Str.stringIsvalidIndex raw i)) s.view i
  iterateFirst s := viewIterate s.view (int 1)
  iterateAt s i := viewIterate s.view i
  iterationBound s := s.view.ncodeunits.val.toNat + 1
  thisind s i := viewThisind s.view i
  prevind _ _ _ := .error (.jl (.methodError "prevind"))
  nextind _ _ _ := .error (.jl (.methodError "nextind"))
  lastindex s := Sub.lastindexSubString viewThisind s.view
  getindexSlice := preparedSlice
  checkbounds s i := viewBounds s.view i
  checkboundsBool s i := .ok (1 ≤ i.val && i.val ≤ s.view.ncodeunits.val)
  boundsError _ _ := .jl .boundsError
  stringIndexError _ i := .stringIndexError i.val
  methodError name := .jl (.methodError name)
  argumentError message := .jl (.argumentError message)
  tupleTypeError := .jl (.methodError "tuple assertion")
  isBoundsError
    | .jl .boundsError => true
    | _ => false
  characters s := Sub.collectSubStringLoop viewIterate s.view
    (s.view.ncodeunits.val.toNat + 1) (int 1)
  sameReference a b := a.view == b.view
  equalChar := JuliaLean.base.char.eq_Char
  lessChar := JuliaLean.base.char.isless_Char

def preparedOps : StringOps Prepared Prepared UInt32 UInt8 Unit Error :=
  { modelStringOps preparedPrim (fun i => toString i.val) with
    thisind s i := viewThisind s.view i
    nextind s i n := nextindInt preparedPrim (fun i => toString i.val) s i n }

def previous (s : Prepared) (i : Index) : Result Index :=
  previndInt preparedPrim (fun i => toString i.val) s i (int 1)

def following (s : Prepared) (i : Index) : Result Index := viewNextind s.view i

def getChar (s : Prepared) (i : Index) : Result UInt32 :=
  JuliaLean.base.strings.substring.getindexSubString viewBounds
    (fun offset i => .ok (offset + i)) JuliaLean.base.strings.string.stringGetindex s.view i

def chars (s : Prepared) : Result (List UInt32) := preparedPrim.characters s

def rawChars (s : Raw) : Result (List UInt32) := do chars (← prepare s)

/-- The `String` and `SubString{String}` arguments of the dense methods: a whole `String`,
or any view returned by the installed `SubString(::String, ::Int, ::Int)`, including
proper offsets. (`DenseUTF8String`'s `StringView` members have no Lean model.) -/
inductive DenseArg : Prepared → Prop where
  | string {s : Raw} {p : Prepared} (h : prepare s = .ok p) : DenseArg p
  | view {s : Raw} {i j : Index} {v : View} {p : Prepared}
      (hv : stringView s i j = .ok v) (hp : prepareView v = .ok p) : DenseArg p

/-- A code-unit position `k` (0-based within the view) is a character boundary of the view:
its start, its end, or a valid index of the parent `String`. -/
def viewBoundary (p : Prepared) (k : Nat) : Bool :=
  k == 0 || k == (preparedBytes p).length ||
    Str.stringIsvalidIndex p.view.string (int (p.view.offset.val + Int.ofNat k + 1))

/-- Only the primitive C byte-address space is constructed here. `_memcmp` itself is the
installed string method and its byte comparison is the installed C model. -/
def pairHeap (a b : List UInt8) : Ptr.ByteHeap where
  byteAt i := JInt.lit .u8 (if i < a.length + 1 then (a.getD i 0).toNat
    else (b.getD (i - a.length - 1) 0).toNat)
  validByte _ := true

def compareBytes (a b : List UInt8) (n : Index) : Int :=
  Str.memcmpLength id (fun n => (JInt.rem .u64 n).val.toNat) (fun _ _ f => f ())
    (fun pa pb count => (JuliaLean.base.cmem.StandardC.cMemcmp (pairHeap a b) pa.toNat pb.toNat count).val)
    0 (Int.ofNat a.length + 1) n

def denseOps : DenseStringOps Prepared Error where
  Ptr := Prepared × Index
  pointer s i := .ok (s, i)
  ncodeunits s := s.view.ncodeunits
  sizeof s := sizeofString preparedOps s
  memcmp a b n := .ok (compareBytes (preparedBytes a) (preparedBytes b) n)
  memcmpPointer p b n := .ok (compareBytes
    ((preparedBytes p.1).drop (p.2.val - 1).toNat) (preparedBytes b) n)
  nextind := following
  thisind s i := viewThisind s.view i

/-- id: stringscova-util-startswith-dense-rebuilt. Source: util.jl:69-78 and its
comment that the end of `b` must not split a character of `a`. -/
def DensePrefixBytes : Prop := ∀ a b : Prepared, DenseArg a → DenseArg b →
  startswithDense denseOps a b =
    .ok ((preparedBytes b).isPrefixOf (preparedBytes a) && viewBoundary a (preparedBytes b).length)

/-- id: stringscova-util-startswith-fast-rebuilt. Source: util.jl:83-85, including the
`:nothrow` effect: the specialisation never throws on these arguments. -/
def FastPrefixBytes : Prop := ∀ a b : Prepared, DenseArg a → DenseArg b →
  startswithFast denseOps id a b =
    .ok ((preparedBytes b).isPrefixOf (preparedBytes a) && viewBoundary a (preparedBytes b).length)

/-- id: stringscova-util-endswith-dense-rebuilt. Source: util.jl:107-116 (dense method)
and util.jl:120-122 (`:nothrow` specialisation). -/
def DenseSuffixBytes : Prop := ∀ a b : Prepared, DenseArg a → DenseArg b →
  let expected := (preparedBytes b).reverse.isPrefixOf (preparedBytes a).reverse &&
    viewBoundary a ((preparedBytes a).length - (preparedBytes b).length)
  endswithDense denseOps a b = .ok expected ∧ endswithFast denseOps id a b = .ok expected

def chopFastPrefixCall (s p : Prepared) : Result Prepared :=
  chopprefixFast (startswithFast denseOps id) (fun s => s.view.ncodeunits)
    preparedFrom preparedWhole s p

def chopFastSuffixCall (s p : Prepared) : Result Prepared :=
  chopsuffixFast (isemptyString preparedOps) (endswithFast denseOps id)
    (fun s => s.view.ncodeunits) (fun s => s.view.ncodeunits)
    (fun _ => int 1) previous preparedSlice preparedWhole s p

/-- id: stringscova-util-chopprefix-fast-rebuilt. Source: util.jl:281-288. The result is a
view of the same parent `String`. -/
def ChopPrefixFastBytes : Prop := ∀ s p : Prepared, DenseArg s → DenseArg p →
  ∃ out, chopFastPrefixCall s p = .ok out ∧ out.view.string = s.view.string ∧
    preparedBytes out =
      if (preparedBytes p).isPrefixOf (preparedBytes s) && viewBoundary s (preparedBytes p).length
      then (preparedBytes s).drop (preparedBytes p).length else preparedBytes s

/-- id: stringutil-chopsuffix-fast-bytes. Source: util.jl:334-342. -/
def ChopSuffixFastBytes : Prop := ∀ s p : Prepared, DenseArg s → DenseArg p →
  ∃ out, chopFastSuffixCall s p = .ok out ∧ out.view.string = s.view.string ∧
    preparedBytes out =
      if (preparedBytes p).reverse.isPrefixOf (preparedBytes s).reverse &&
          viewBoundary s ((preparedBytes s).length - (preparedBytes p).length)
      then (preparedBytes s).take ((preparedBytes s).length - (preparedBytes p).length)
      else preparedBytes s

/-- id: stringscova-util-chopsuffix-faithful. All three chopsuffix methods, each over its
full stated domain. -/
def ChopSuffixFaithful : Prop := ChopSuffixSequence ∧ ChopSuffixCharacter ∧ ChopSuffixFastBytes

/-- id: stringscova-util-chop-affixes. All six affix-removal methods. -/
def ChopAffixes : Prop :=
  ChopPrefixSequence ∧ ChopPrefixCharacter ∧ ChopPrefixFastBytes ∧ ChopSuffixFaithful

section CompareBytesLemmas
theorem exists_first (p : Nat → Prop) [DecidablePred p] :
    ∀ N, (∃ k, k < N ∧ ¬ p k) → ∃ k, k < N ∧ ¬ p k ∧ ∀ j, j < k → p j
  | 0, ⟨k, hk, _⟩ => absurd hk (Nat.not_lt_zero _)
  | N + 1, ⟨k, hk, hp⟩ => by
    by_cases h : ∃ k, k < N ∧ ¬ p k
    · obtain ⟨j, hj, hpj, hb⟩ := exists_first p N h
      exact ⟨j, by omega, hpj, hb⟩
    · have hall : ∀ j, j < N → p j := fun j hj =>
        Classical.byContradiction (fun hn => h ⟨j, hj, hn⟩)
      have hkN : k = N := by
        apply Classical.byContradiction
        intro hne
        exact hp (hall k (by omega))
      subst hkN
      exact ⟨k, by omega, hp, hall⟩

theorem lit_u8_toNat_inj (a b : UInt8) :
    JInt.lit .u8 (a.toNat : Int) = JInt.lit .u8 (b.toNat : Int) ↔ a = b := by
  constructor
  · intro h
    have hv := congrArg Subtype.val h
    have ha : wrapInt .u8 (a.toNat : Int) = a.toNat :=
      wrapInt_of_inRange .u8 _ (by
        have := a.toNat_lt; simp [IntTy.min, IntTy.max, IntTy.signed, IntTy.bits]; omega)
    have hb : wrapInt .u8 (b.toNat : Int) = b.toNat :=
      wrapInt_of_inRange .u8 _ (by
        have := b.toNat_lt; simp [IntTy.min, IntTy.max, IntTy.signed, IntTy.bits]; omega)
    change wrapInt .u8 (a.toNat : Int) = wrapInt .u8 (b.toNat : Int) at hv
    rw [ha, hb] at hv
    exact UInt8.toNat_inj.mp (by exact_mod_cast hv)
  · intro h; subst h; rfl

/-- The two byte runs `pairHeap` lays out: `x` from address 0, `y` after one separator byte. -/
theorem pairHeap_left (x y : List UInt8) (k : Nat) (hk : k < x.length) (hsmall : x.length + y.length + 2 < 2 ^ 64) :
    (pairHeap x y).readByte k = JInt.lit .u8 ((x.getD k 0).toNat : Int) := by
  simp only [JuliaLean.base.pointer.ByteHeap.readByte, JuliaLean.base.pointer.addressMod, pairHeap]
  rw [Nat.mod_eq_of_lt (by omega), if_pos (by omega)]

theorem pairHeap_right (x y : List UInt8) (k : Nat) (hk : k < y.length) (hsmall : x.length + y.length + 2 < 2 ^ 64) :
    (pairHeap x y).readByte (x.length + 1 + k) = JInt.lit .u8 ((y.getD k 0).toNat : Int) := by
  simp only [JuliaLean.base.pointer.ByteHeap.readByte, JuliaLean.base.pointer.addressMod, pairHeap]
  rw [Nat.mod_eq_of_lt (by omega), if_neg (by omega)]
  rw [show x.length + 1 + k - x.length - 1 = k by omega]

/-- `_memcmp` over the two byte runs compares the first `length(y)` bytes of `x` with `y`. -/
theorem compareBytes_zero (x y : List UInt8) (n : Index) (hn : n.val = Int.ofNat y.length)
    (hle : y.length ≤ x.length) (hsmall : x.length + y.length + 2 < 2 ^ 63) :
    compareBytes x y n = 0 ↔ x.take y.length = y := by
  have hrem : (JInt.rem .u64 n).val.toNat = y.length := by
    change (wrapInt .u64 n.val).toNat = y.length
    rw [wrapInt_of_inRange .u64 _ (by
      rw [hn]; simp only [IntTy.min, IntTy.max, IntTy.signed, IntTy.bits, Int.ofNat_eq_coe]; omega), hn]
    rfl
  have hval : compareBytes x y n = (JuliaLean.base.cmem.StandardC.cMemcmp (pairHeap x y) 0
      (x.length + 1) y.length).val := by
    simp only [compareBytes, Str.memcmpLength, hrem]
    congr 2
  rw [hval]
  have hbyte : ∀ k, k < y.length → ((pairHeap x y).readByte (0 + k) =
      (pairHeap x y).readByte (x.length + 1 + k) ↔ x[k]? = y[k]?) := by
    intro k hk
    rw [Nat.zero_add, pairHeap_left x y k (by omega) (by omega), pairHeap_right x y k hk (by omega),
      lit_u8_toNat_inj, List.getElem?_eq_getElem (by omega : k < x.length), List.getElem?_eq_getElem hk]
    simp [List.getD_eq_getElem?_getD, List.getElem?_eq_getElem (by omega : k < x.length),
      List.getElem?_eq_getElem hk]
  obtain ⟨hall, hfirst⟩ := JuliaLean.base.cmem.StandardC.cMemcmp_scan (pairHeap x y) y.length 0 (x.length + 1)
  have htake : x.take y.length = y ↔ ∀ k, k < y.length → x[k]? = y[k]? := by
    constructor
    · intro h k hk
      rw [← h, List.getElem?_take, if_pos hk]
    · intro h
      apply List.ext_getElem?
      intro k
      rw [List.getElem?_take]
      split
      · exact h k (by assumption)
      · rw [List.getElem?_eq_none (by omega)]
  rw [htake]
  constructor
  · intro hz
    apply Classical.byContradiction
    intro hne
    have hex : ∃ k, k < y.length ∧ ¬ (x[k]? = y[k]?) :=
      Classical.byContradiction (fun hno => hne (fun k hk =>
        Classical.byContradiction (fun hk' => hno ⟨k, hk, hk'⟩)))
    obtain ⟨k, hk, hdiff, hbefore⟩ := exists_first (fun k => x[k]? = y[k]?) y.length hex
    have hrb : (pairHeap x y).readByte (0 + k) ≠ (pairHeap x y).readByte (x.length + 1 + k) :=
      fun h => hdiff ((hbyte k hk).mp h)
    obtain ⟨hlt, hgt⟩ := hfirst k hk hrb (fun j hj => (hbyte j (by omega)).mpr (hbefore j hj))
    have hvne : ((pairHeap x y).readByte (0 + k)).val ≠
        ((pairHeap x y).readByte (x.length + 1 + k)).val :=
      fun h => hrb (Subtype.ext h)
    rcases Int.lt_or_gt_of_ne hvne with h | h
    · have := hlt.mpr h; omega
    · have := hgt.mpr h; omega
  · intro h
    exact hall (fun k hk => (hbyte k hk).mpr (h k hk))

end CompareBytesLemmas

def chompCall (s : Prepared) : Result Prepared :=
  chomp (fun s => .ok s.last) getChar previous preparedSlice
    (fun a b => .ok (JuliaLean.base.char.eq_Char a b)) 0x0a000000 0x0d000000 s

def chompFastCall (s : Prepared) : Result Prepared :=
  chompFast preparedBytes
    (fun s i n => do prepareView (← Sub.rawSubstringView parentOps s.view i (int n))) s

def chompSpec (bs : List UInt8) : List UInt8 :=
  if bs.getLast? = some 0x0a then
    let withoutLF := bs.take (bs.length - 1)
    if withoutLF.getLast? = some 0x0d then withoutLF.take (withoutLF.length - 1) else withoutLF
  else bs

/-! ## Stripping (generic AbstractString; iterators.jl pairs fix the error type to `JlError`) -/

/-- `iterate(x::IterableStatePairs, state)` over `pairs(s::AbstractString)`
(iterators.jl:1708-1712,1725), with `first(keys(s)) = 1` (basic.jl:580,583). -/
def pairsStep {X R C CU CT : Type} (ops : StringOps X R C CU CT JlError) (x : X)
    (st : Option Index) : Jl (Option ((Index × C) × Index)) :=
  JuliaLean.base.iterators.iterateStatePairs
    (fun x => pure (keysString x))
    (fun keys => pure (firstEachStringIndex keys))
    (fun x st => ops.iterateAt x st)
    (JuliaLean.base.iterators.pairsStringModel x) st

/-- `iterate` over `Iterators.reverse(pairs(s))` = `IterableStatePairs(Reverse(s))`
(iterators.jl:1714,1717-1721): the state starts at `last(keys(s)) = lastindex(s)`
(basic.jl:580,584) and each step is `iterate(::Iterators.Reverse{<:AbstractString}, i)`
(basic.jl:775). -/
def revPairsStep {X R C CU CT : Type} (ops : StringOps X R C CU CT JlError) (x : X)
    (st : Option Index) : Jl (Option ((Index × C) × Index)) :=
  JuliaLean.base.iterators.iterateReverseIterableStatePairs
    (fun x => pure (keysString x))
    (fun ks => lastEachStringIndex (gFull ops) ks)
    (fun r st => gRevIterate ops (reverseOf r.itr) st)
    (⟨⟨x⟩⟩ : JuliaLean.base.iterators.IterableStatePairs (JuliaLean.base.iterators.Reverse X)) st

def stripOpsOf {X Y R C CU CT : Type} (ops : StringOps X R C CU CT JlError)
    (slice : X → Index → Index → Jl (Sub.SubString Y)) :
    StripOps X (Sub.SubString Y) C Index Index JlError where
  lastindex := (gFull ops).lastindex
  firstindex x := .ok (firstindexString x)
  addOne i := i + int 1
  substring := slice
  pairsFirst x := pairsStep ops x none
  pairsNext x st := pairsStep ops x (some st)
  reversePairsFirst x := revPairsStep ops x none
  reversePairsNext x st := revPairsStep ops x (some st)

/-- Stripping a string `s::S` (`SubString(s, i, e)`, substring.jl:108). -/
def stripOps {S R C CU CT : Type} (prim : StringOps S R C CU CT JlError)
    (errs : ViewErrors S JlError) : StripOps S (Sub.SubString S) C Index Index JlError :=
  stripOpsOf prim (gRange prim errs)

/-- Stripping the `SubString{S}` returned by the first pass (`SubString(v::SubString, i, j)`,
substring.jl:112-115). -/
def viewStripOps {S R C CU CT : Type} (prim : StringOps S R C CU CT JlError)
    (errs : ViewErrors S JlError) :
    StripOps (Sub.SubString S) (Sub.SubString S) C Index Index JlError :=
  stripOpsOf (gSubPrim prim errs) (gNested prim errs)

/-- Maximal leading run satisfying a possibly throwing predicate, evaluated left to right. -/
def leadingRun {C E : Type} (f : C → Except E Bool) : List C → Except E (List C)
  | [] => .ok []
  | c :: cs => do if ← f c then leadingRun f cs else pure (c :: cs)

/-- Maximal trailing run, evaluated right to left. -/
def trailingRun {C E : Type} (f : C → Except E Bool) (cs : List C) : Except E (List C) := do
  return (← leadingRun f cs.reverse).reverse

/-- The result of a strip call against a specification: the same exception, or a view of
`s` with exactly the expected characters. -/
def StripResult {S R C CU CT : Type} (prim : StringOps S R C CU CT JlError)
    (errs : ViewErrors S JlError) (s : S) (spec : Jl (List C))
    (call : Option (Jl (Sub.SubString S))) : Prop :=
  match spec with
  | .error e => call = some (.error e)
  | .ok rest => ∃ out, call = some (.ok out) ∧ out.string = s ∧ ViewIterates prim errs out rest

/-- id: stringutil-lstrip-maximal-run. Source: lstrip docstring, util.jl:392-422. -/
def LstripMaximalRun : Prop :=
  ∀ {S R C CU CT : Type} (prim : StringOps S R C CU CT JlError) (errs : ViewErrors S JlError)
    (f : C → Jl Bool) (s : S) (ls : List (Index × C)),
    Lawful prim s ls →
    StripResult prim errs s (leadingRun f (charsIn ls)) (lstrip (stripOps prim errs) f s)

/-- id: stringutil-rstrip-maximal-run. Source: rstrip docstring, util.jl:427-456. -/
def RstripMaximalRun : Prop :=
  ∀ {S R C CU CT : Type} (prim : StringOps S R C CU CT JlError) (errs : ViewErrors S JlError)
    (f : C → Jl Bool) (s : S) (ls : List (Index × C)),
    Lawful prim s ls →
    StripResult prim errs s (trailingRun f (charsIn ls)) (rstrip (stripOps prim errs) f s)

/-- id: stringutil-lstrip-chars. Source: lstrip docstring, util.jl:392-424, for every
`Chars` collection through its own (universally quantified) `in`. The `(AbstractString,
AbstractString)` overload is a constant `ArgumentError` (Nothing-to-promise block). -/
def LstripChars : Prop :=
  ∀ {S R C CU CT Q : Type} (prim : StringOps S R C CU CT JlError) (errs : ViewErrors S JlError)
    (member : C → Q → Jl Bool) (set : Q) (s : S) (ls : List (Index × C)),
    Lawful prim s ls →
    StripResult prim errs s (leadingRun (fun c => member c set) (charsIn ls))
      (lstripChars (stripOps prim errs) member set s)

/-- id: stringutil-rstrip-chars. Source: rstrip docstring, util.jl:427-458. -/
def RstripChars : Prop :=
  ∀ {S R C CU CT Q : Type} (prim : StringOps S R C CU CT JlError) (errs : ViewErrors S JlError)
    (member : C → Q → Jl Bool) (set : Q) (s : S) (ls : List (Index × C)),
    Lawful prim s ls →
    StripResult prim errs s (trailingRun (fun c => member c set) (charsIn ls))
      (rstripChars (stripOps prim errs) member set s)

/-- id: stringutil-strip-chars. Source: strip docstring, util.jl:461-489: trailing then
leading runs, for a predicate and for a `Chars` collection; the second pass runs on the
returned `SubString{S}` with its installed methods. -/
def StripChars : Prop :=
  ∀ {S R C CU CT Q : Type} (prim : StringOps S R C CU CT JlError) (errs : ViewErrors S JlError)
    (f : C → Jl Bool) (member : C → Q → Jl Bool) (set : Q) (s : S) (ls : List (Index × C)),
    Lawful prim s ls →
    StripResult prim errs s (do leadingRun f (← trailingRun f (charsIn ls)))
        (stripPredicate (stripOps prim errs) (viewStripOps prim errs) f s) ∧
    StripResult prim errs s
        (do leadingRun (fun c => member c set) (← trailingRun (fun c => member c set) (charsIn ls)))
        (stripChars (stripOps prim errs) (viewStripOps prim errs) member set s)

/-! ## Padding remainder (generic AbstractString, installed `textwidth(::AbstractChar)`) -/

def padRemOps {S R C CU CT : Type} (prim : StringOps S R C CU CT JlError)
    (errs : ViewErrors S JlError) (cops : UCharOps C) (P : Utf8proc) (liftU : UError → JlError) :
    PadRemainderOps S C (Sub.SubString S) Index JlError where
  textwidthChar c :=
    match JuliaLean.base.strings.unicode.textwidthAbstractChar cops P c with
    | .ok w => .ok (int w)
    | .error e => .error (liftU e)
  pairsFirst p := pairsStep prim p none
  pairsNext p st := pairsStep prim p (some st)
  viewPrefix p i := Sub.viewString (gParent prim errs) ⟨Prod.fst, Prod.snd⟩ (fun i => .ok i) p
    (int 1, i)
  whole := gWhole prim errs

/-- Length of the shortest nonempty prefix whose accumulated width reaches `r`. -/
def minimalPrefixLength {A : Type} (w : A → Int) (r : Int) (xs : List A) : Option Nat :=
  ((List.range xs.length).find? (fun k => decide (r ≤ ((xs.take (k + 1)).map w).sum))).map (· + 1)

/-- id: stringutil-pad-remainder-minimal. Source: `_pad_remainder` and its comment,
util.jl:516-523: the view `p[begin:i]` ending at the first character whose accumulated
width reaches `r`, or the whole padding. Character widths are the installed
`textwidth(::AbstractChar)` with utf8proc's documented 0..2 `charwidth` range. -/
def PadRemainderMinimal : Prop :=
  ∀ {S R C CU CT : Type} (prim : StringOps S R C CU CT JlError) (errs : ViewErrors S JlError)
    (cops : UCharOps C) (P : Utf8proc) (liftU : UError → JlError) (p : S)
    (ls : List (Index × C)) (codes : List UInt32) (r : Index),
    Lawful prim p ls → (charsIn ls).mapM cops.toChar = .ok codes →
    (∀ u, 0 ≤ P.charwidth u ∧ P.charwidth u ≤ 2) → ls.length < 2 ^ 61 →
    ∃ out, padRemainderString (padRemOps prim errs cops P liftU) p r = some (.ok out) ∧
      out.string = p ∧
      ViewIterates prim errs out
        (match minimalPrefixLength (charWidth P) r.val codes with
         | some k => (charsIn ls).take k
         | none => charsIn ls)

/-! ## Padding (any AbstractString or AbstractChar source and padding) -/

/-- Padding callees quantified without any law: the padding string's own `iterate`
(`iterateFirst`/`iterateAt`, which the installed unicode.lean `textwidthAbstractString`,
unicode.jl:295, runs and which may throw or never end). The others have no applicable model:
`_isannotated` (annotated.jl), the zero-width message's `repr` (which may throw, R3-12),
`ncodeunits` and code-unit type, `p^q` (R3-4) and `string`/`annotatedstring`. -/
structure PadCallees (S C O : Type) where
  iterateFirst : S → JuliaLean.base.strings.unicode.UResult (Option (C × Index))
  iterateAt : S → Index → JuliaLean.base.strings.unicode.UResult (Option (C × Index))
  isAnnotated : PadInput S C → Jl Bool
  repr : PadInput S C → Jl String
  ncodeunits : PadInput S C → Jl Nat
  isString : PadInput S C → Bool
  codeunitIsUInt8 : PadInput S C → Bool
  repeatPad : PadInput S C → Index → Jl (PadInput S C)
  assemble : Bool → List (PadPart S C (Sub.SubString S)) → Jl O

/-- `Int(textwidth(x))::Int` on a padding argument: the installed
`textwidth(::AbstractString)` (unicode.lean `textwidthAbstractString`) or
`textwidth(::AbstractChar)` (unicode.jl:283). -/
def padTextwidth {S C O : Type} (cops : UCharOps C) (P : Utf8proc) (liftU : UError → JlError)
    (cal : PadCallees S C O) : PadInput S C → Option (Jl Index)
  | .string x =>
    (JuliaLean.base.strings.unicode.textwidthAbstractString
      cal.iterateFirst cal.iterateAt cops P x).map fun r =>
      match r with
      | .ok w => .ok w
      | .error e => .error (liftU e)
  | .character c =>
    some (match JuliaLean.base.strings.unicode.textwidthAbstractChar cops P c with
      | .ok w => .ok (int w)
      | .error e => .error (liftU e))
/-- `Int(n)::Int` (int.jl `convert`), `signed(::Int)`, the textwidth methods above and
`divrem(::Int, ::Int)` (div.jl, `RoundToZero`). -/
def padOps {S C O : Type} {t : IntTy} (cops : UCharOps C) (P : Utf8proc)
    (liftU : UError → JlError) (cal : PadCallees S C O) :
    PadValueOps S C (Sub.SubString S) O (JInt t) JlError where
  toInt n := JuliaLean.base.int.convert .i64 n
  signed n := n
  textwidth := padTextwidth cops P liftU cal
  isAnnotated := cal.isAnnotated
  repr := cal.repr
  ncodeunits := cal.ncodeunits
  isString := cal.isString
  codeunitIsUInt8 := cal.codeunitIsUInt8
  argumentError m := .argumentError m
  divrem m l := JuliaLean.base.div.divremBitIntegerToZero m l
  repeatPad := cal.repeatPad
  assemble := cal.assemble

/-- A padding argument with its characters and their `Char` codes: a lawful string or one
character. -/
inductive PadArg {S R C CU CT E : Type} (prim : StringOps S R C CU CT E) (cops : UCharOps C) :
    PadInput S C → List C → List UInt32 → Prop where
  | string {x : S} {lx : List (Index × C)} {up : List UInt32} (lawful : Lawful prim x lx)
      (codes : (charsIn lx).mapM cops.toChar = .ok up) (small : lx.length < 2 ^ 61) :
      PadArg prim cops (.string x) (charsIn lx) up
  | character {c : C} {u : UInt32} (code : cops.toChar c = .ok u) :
      PadArg prim cops (.character c) [c] [u]

/-- The `_pad_remainder(p, r)` piece: for a string padding, a view of `p` holding its shortest
prefix whose `textwidth(::AbstractChar)` sum reaches `r` (the whole padding if none does); for
a character padding, the character itself. -/
inductive RemainderPiece {S R C CU CT : Type} (prim : StringOps S R C CU CT JlError)
    (errs : ViewErrors S JlError) (P : Utf8proc) (r : Int) :
    PadInput S C → List C → List UInt32 → PadPart S C (Sub.SubString S) → Prop where
  | string {x : S} {cp : List C} {up : List UInt32} {v : Sub.SubString S} (parent : v.string = x)
      (prefixChars : ViewIterates prim errs v
        (match minimalPrefixLength (charWidth P) r up with
         | some k => cp.take k
         | none => cp)) :
      RemainderPiece prim errs P r (.string x) cp up (.view v)
  | character {c : C} {cp : List C} {up : List UInt32} :
      RemainderPiece prim errs P r (.character c) cp up (.value (.character c))

/-- What `lpad`/`rpad` (util.jl:526-544, 566-584) promise for one call on source `s` and padding
`p`, given the widths `width` reports: `InexactError` when `n` is outside `Int`; the source alone
when it is at least `n` wide; for zero-width padding the exception of `repr(p)` or
`ncodeunits(p)` if one throws, else `ArgumentError`; otherwise `q = m ÷ textwidth(p)` copies of
the padding, then (when `r = m % textwidth(p) > 0`) the shortest padding prefix reaching width
`r`, placed before (`lpad`) or after (`rpad`) the source, where `m = n - textwidth(s)`. Callee
exceptions propagate, and a width computation that never ends (`width = none`) makes the call
never end. The one excluded range, `n - textwidth(s)` below `typemin(Int)` where
`signed(n) - textwidth(s)` wraps, is refuted as strings-lpad-typemin. -/
def PadOutcome {S R C CU CT O : Type} {t : IntTy} (left : Bool)
    (prim : StringOps S R C CU CT JlError) (errs : ViewErrors S JlError) (P : Utf8proc)
    (cal : PadCallees S C O) (width : PadInput S C → Option (Jl Index)) (b : Bool)
    (s p : PadInput S C) (cp : List C) (up : List UInt32) (n : JInt t)
    (call : Option (Except JlError O)) : Prop :=
  let around := fun (pieces : List (PadPart S C (Sub.SubString S))) =>
    if left then pieces ++ [.value s] else .value s :: pieces
  (¬ fitsInt n → ∃ fn, call = some (.error (.inexactError fn))) ∧
  (fitsInt n → width s = none → call = none) ∧
  (fitsInt n → ∀ e, width s = some (.error e) → call = some (.error e)) ∧
  (fitsInt n → ∀ ws : Index, width s = some (.ok ws) →
    -(2 ^ 63) ≤ n.val - ws.val → n.val - ws.val < 2 ^ 63 →
    (n.val - ws.val ≤ 0 → call = some (cal.assemble b [.value s])) ∧
    (0 < n.val - ws.val → width p = none → call = none) ∧
    (0 < n.val - ws.val → ∀ e, width p = some (.error e) → call = some (.error e)) ∧
    (0 < n.val - ws.val → ∀ wp : Index, width p = some (.ok wp) →
      (wp.val = 0 →
        (∀ e, cal.repr p = .error e → call = some (.error e)) ∧
        (∀ text e, cal.repr p = .ok text → cal.ncodeunits p = .error e →
          call = some (.error e)) ∧
        (∀ text k, cal.repr p = .ok text → cal.ncodeunits p = .ok k →
          ∃ msg, call = some (.error (.argumentError msg)))) ∧
      (0 < wp.val → (n.val - ws.val) % wp.val = 0 →
        call = some (do
          let pq ← cal.repeatPad p (int ((n.val - ws.val) / wp.val))
          cal.assemble b (around [.value pq]))) ∧
      (0 < wp.val → 0 < (n.val - ws.val) % wp.val →
        ∃ rem, RemainderPiece prim errs P ((n.val - ws.val) % wp.val) p cp up rem ∧
          call = some (do
            let pq ← cal.repeatPad p (int ((n.val - ws.val) / wp.val))
            cal.assemble b (around [.value pq, rem])))))

/-- Source: lpad and rpad docstrings, util.jl:494-584. For every source and padding (string or
character) and every `BitInteger` target `n`, the call gives `PadOutcome` with the installed
`textwidth` methods. -/
def PadPiecesFor (left : Bool) : Prop :=
  ∀ {S R C CU CT O : Type} {t : IntTy} (prim : StringOps S R C CU CT JlError)
    (errs : ViewErrors S JlError) (cops : UCharOps C) (P : Utf8proc) (liftU : UError → JlError)
    (cal : PadCallees S C O) (ann : PadInput S C → Bool)
    (s p : PadInput S C) (cp : List C) (up : List UInt32) (n : JInt t),
    PadArg prim cops p cp up →
    (∀ u, 0 ≤ P.charwidth u ∧ P.charwidth u ≤ 2) →
    (∀ x, cal.isAnnotated x = .ok (ann x)) →
    PadOutcome left prim errs P cal (padTextwidth cops P liftU cal) (ann s || ann p) s p cp up n
      (if left then lpad (padOps (t := t) cops P liftU cal) (padRemOps prim errs cops P liftU) s p n
       else rpad (padOps (t := t) cops P liftU cal) (padRemOps prim errs cops P liftU) s p n)

/-- Source: the `lpad`/`rpad` docstrings ("Stringify `s` and pad the resulting string") and
their forwarders util.jl:511 and 564, `lpad(string(s)::AbstractString, n, string(p))`. For values
`a`, `b` of any types with their own `string` methods (quantified; a source `string` result that
is not an `AbstractString` is the `TypeError` gap of proposal R6-5), a failing `string` call
propagates (source first), and otherwise the result is `PadOutcome` for `string(a)` padded with
`string(b)`, like `PadPiecesFor`. -/
def PadForwardFor (left : Bool) : Prop :=
  ∀ {A B S R C CU CT O : Type} {t : IntTy} (prim : StringOps S R C CU CT JlError)
    (errs : ViewErrors S JlError) (cops : UCharOps C) (P : Utf8proc) (liftU : UError → JlError)
    (cal : PadCallees S C O) (ann : PadInput S C → Bool) (stringA : A → Jl S)
    (stringB : B → Jl S) (a : A) (b : B) (n : JInt t),
    (∀ u, 0 ≤ P.charwidth u ∧ P.charwidth u ≤ 2) →
    (∀ x, cal.isAnnotated x = .ok (ann x)) →
    let ops := padOps (t := t) cops P liftU cal
    let rem := padRemOps prim errs cops P liftU
    let sb := fun x => (stringB x).map PadInput.string
    let call := if left then lpadWrapper ops rem stringA .ok sb a n b
      else rpadWrapper ops rem stringA .ok sb a n b
    (∀ e, stringA a = .error e → call = some (.error e)) ∧
    (∀ x e, stringA a = .ok x → stringB b = .error e → call = some (.error e)) ∧
    (∀ x y cp up, stringA a = .ok x → stringB b = .ok y → PadArg prim cops (.string y) cp up →
      PadOutcome left prim errs P cal (padTextwidth cops P liftU cal)
        (ann (.string x) || ann (.string y)) (.string x) (.string y) cp up n call)

/-! ## Width-aware truncation (generic AbstractString) -/

/-- `replacement::Union{AbstractString,AbstractChar}` (util.jl:609,642,676,697). -/
inductive TruncRepl (RS RC : Type) where
  | string (r : RS)
  | character (c : RC)

/-- `textwidth(replacement)` (util.jl:701): the installed `textwidth(::AbstractChar)`
(unicode.jl:283) for a character replacement; for a string replacement
`textwidth(::AbstractString)` (unicode.jl:295) has no executable model over a user string
(unicode.lean:693 takes `mapreduce` as an argument and reduce.lean cannot iterate a user
string; round5 proposal R5-3), so it is the parameter `stringWidth`. -/
def replTextwidth {RS RC E : Type} (rcops : UCharOps RC) (P : Utf8proc) (liftU : UError → E)
    (stringWidth : RS → Option (Except E Index)) : TruncRepl RS RC → Option (Except E Index)
  | .string r => stringWidth r
  | .character c =>
    some (match JuliaLean.base.strings.unicode.textwidthAbstractChar rcops P c with
      | .ok w => .ok (int w)
      | .error e => .error (liftU e))

/-- Truncation operations: the string's own `iterate` (installed whileLoop iteration,
R4-2), the installed index, `getindex`, `SubString` and `textwidth(::AbstractChar)` methods,
and `textwidth(replacement)` above. `string(str)`, `string(replacement)` and string
concatenation have no model for user string types and are universally quantified. -/
def truncOps {S R C CU CT E RS RC : Type} (prim : StringOps S R C CU CT E) (errs : ViewErrors S E)
    (cops : UCharOps C) (P : Utf8proc) (liftU : UError → E) (liftJ : JlError → E)
    (rcops : UCharOps RC) (stringWidth : RS → Option (Except E Index)) (stringify : S → Except E S)
    (stringifyRepl : TruncRepl RS RC → Except E S) (concat : List (TruncPiece S (Sub.SubString S)) → Except E S) :
    TruncateOps S (Sub.SubString S) (TruncRepl RS RC) C E where
  iterateFirst := prim.iterateFirst
  iterateAt := prim.iterateAt
  textwidthChar c :=
    match JuliaLean.base.strings.unicode.textwidthAbstractChar cops P c with
    | .ok w => .ok (int w)
    | .error e => .error (liftU e)
  textwidthReplacement := replTextwidth rcops P liftU stringWidth
  getindex := getindexString (gFull prim)
  firstindex s := .ok (firstindexString s)
  lastindex := (gFull prim).lastindex
  prevind := previndOne (gFull prim)
  nextind := nextindOne (gFull prim)
  substring := gRange prim errs
  stringify := stringify
  stringifyReplacement := stringifyRepl
  concat := concat
  argumentError := prim.argumentError
  toInt m := match JInt.convert (IntTy.i64.name) .i64 m with
    | .ok i => .ok i
    | .error e => .error (liftJ e)

/-- Shared hypotheses of the truncation statements: a lawful string whose characters all
convert to `Char` (`textwidth(::AbstractChar)` calls `Char(c)`, unicode.jl:283),
utf8proc's documented width range, and a total width below `2^63`, so the `Int` width
accumulators of util.jl:691,709-729 do not wrap (only strings with more than `2^62`
characters can reach that range). -/
structure TruncInput {S R C CU CT E : Type} (prim : StringOps S R C CU CT E) (cops : UCharOps C)
    (P : Utf8proc) (s : S) (ls : List (Index × C)) (codes : List UInt32) : Prop where
  lawful : Lawful prim s ls
  converts : (charsIn ls).mapM cops.toChar = .ok codes
  widths : ∀ u, 0 ≤ P.charwidth u ∧ P.charwidth u ≤ 2
  total : (codes.map (charWidth P)).sum < 2 ^ 63

def widthsOf (P : Utf8proc) (codes : List UInt32) : List Int := codes.map (charWidth P)

/-- Longest prefix length whose width fits `budget`. -/
def longestPrefix (ws : List Int) (budget : Int) : Nat :=
  ((List.range (ws.length + 1)).filter (fun k => decide ((ws.take k).sum ≤ budget))).foldl max 0

/-- id: stringutil-textwidth-prefix-check. Source: check_textwidth and its comment,
util.jl:687-695, for every width `maxwidth`. -/
def TextwidthPrefixCheck : Prop :=
  ∀ {S R C CU CT E RS RC : Type} (prim : StringOps S R C CU CT E) (errs : ViewErrors S E)
    (cops : UCharOps C) (P : Utf8proc) (liftU : UError → E) (liftJ : JlError → E)
    (rcops : UCharOps RC) (stringWidth : RS → Option (Except E Index)) (stringify : S → Except E S)
    (stringifyRepl : TruncRepl RS RC → Except E S) (concat : List (TruncPiece S (Sub.SubString S)) → Except E S)
    (s : S) (ls : List (Index × C)) (codes : List UInt32) (maxwidth : Int),
    TruncInput prim cops P s ls codes →
    checkTextwidth (truncOps prim errs cops P liftU liftJ rcops stringWidth stringify stringifyRepl concat)
        s maxwidth =
      some (.ok ((List.range codes.length).all
        (fun k => decide (((widthsOf P codes).take (k + 1)).sum ≤ maxwidth))))

/-- id: stringscova-util-review-676. Source: truncation docstrings, util.jl:587-735.
When the source fits, the boundary helper returns `nothing` for every `Val` mode
(including modes other than left/right/center) and every wrapper returns `string(str)`;
a failed `Int(maxwidth)` conversion propagates from every wrapper. -/
def TruncationFitsIdentity : Prop :=
  ∀ {S R C CU CT E RS RC : Type} (prim : StringOps S R C CU CT E) (errs : ViewErrors S E)
    (cops : UCharOps C) (P : Utf8proc) (liftU : UError → E) (liftJ : JlError → E)
    (rcops : UCharOps RC) (stringWidth : RS → Option (Except E Index)) (stringify : S → Except E S)
    (stringifyRepl : TruncRepl RS RC → Except E S) (concat : List (TruncPiece S (Sub.SubString S)) → Except E S)
    (s : S) (ls : List (Index × C)) (codes : List UInt32) (repl : TruncRepl RS RC) (maxwidth : Int)
    (preferLeft : Bool),
    TruncInput prim cops P s ls codes →
    let ops := truncOps prim errs cops P liftU liftJ rcops stringWidth stringify stringifyRepl concat
    ((0 ≤ maxwidth → (widthsOf P codes).sum ≤ maxwidth →
      (∀ {M : Type} (modeOps : TruncModeOps M) (mode : TruncModeVal M) (pl : Bool),
        stringTruncateBoundaries ops modeOps s maxwidth repl mode pl = some (.ok none)) ∧
      (maxwidth < 2 ^ 63 →
        rtruncate ops s maxwidth repl = some (stringify s) ∧
        ltruncate ops s maxwidth repl = some (stringify s) ∧
        ctruncate ops s maxwidth repl preferLeft = some (stringify s))) ∧
    (∀ e, JInt.convert (IntTy.i64.name) .i64 maxwidth = .error e →
      rtruncate ops s maxwidth repl = some (.error (liftJ e)) ∧
      ltruncate ops s maxwidth repl = some (.error (liftJ e)) ∧
      ctruncate ops s maxwidth repl preferLeft = some (.error (liftJ e))))

/-- Refuted id: stringutil-truncate-width. Source: rtruncate docstring, util.jl:589-590:
"Truncate `str` to at most `maxwidth` columns". The claim, about the value `rtruncate`
actually returns: whenever it returns a kept view `v` (iterating the first `k` characters)
followed by `string(replacement)`, those `k` characters and the replacement together are at
most `maxwidth` wide. A replacement wider than `maxwidth` (e.g. the default `'…'` with
`maxwidth = 0`) is returned after an empty view (util.jl:709-716 break at once), so the
returned value is wider than `maxwidth`. -/
def TruncateWidth : Prop :=
  ∀ {S R C CU CT E RS RC : Type} (prim : StringOps S R C CU CT E) (errs : ViewErrors S E)
    (cops : UCharOps C) (P : Utf8proc) (liftU : UError → E) (liftJ : JlError → E)
    (rcops : UCharOps RC) (stringWidth : RS → Option (Except E Index)) (stringify : S → Except E S)
    (stringifyRepl : TruncRepl RS RC → Except E S) (concat : List (TruncPiece S (Sub.SubString S)) → Except E S)
    (s : S) (ls : List (Index × C)) (codes : List UInt32) (repl : TruncRepl RS RC) (maxwidth : Int)
    (wr : Index) (v : Sub.SubString S) (k : Nat),
    TruncInput prim cops P s ls codes →
    let ops := truncOps prim errs cops P liftU liftJ rcops stringWidth stringify stringifyRepl concat
    0 ≤ maxwidth → maxwidth < 2 ^ 63 →
    replTextwidth rcops P liftU stringWidth repl = some (.ok wr) →
    ViewIterates prim errs v ((charsIn ls).take k) →
    rtruncate ops s maxwidth repl =
      some (do let r ← stringifyRepl repl; concat [.view v, .string r]) →
    wr.val + ((widthsOf P codes).take k).sum ≤ maxwidth

/-! ## Splitting and partitioning (generic AbstractString, predicate splitters) -/

def searchOps {S R C CU CT E : Type} (prim : StringOps S R C CU CT E) :
    JuliaLean.base.strings.search.SearchStringOps S C E where
  ncodeunits := prim.ncodeunits
  iterationBound := prim.iterationBound
  lastindex := (gFull prim).lastindex
  nextind := nextindOne (gFull prim)
  prevind := previndOne (gFull prim)
  isvalid := prim.isvalid
  getindex := getindexString (gFull prim)
  iterate := prim.iterateAt
  boundsError s i := prim.boundsError s (int i)
  stringIndexError := prim.stringIndexError
  somethingError := prim.methodError "something"

def indexIntOps {E : Type} : JuliaLean.base.strings.search.IntegerOps Index E :=
  ⟨fun i => i.val, fun i => .ok i⟩

/-- `findnext(f::Function, s, k)` (search.jl:343-354); an `Int` match `r` has
`first(r) == last(r) == r`. -/
def predFindnext {S R C CU CT E : Type} (prim : StringOps S R C CU CT E) (f : C → Bool) (s : S)
    (k : Index) : JuliaLean.base.strings.search.SearchM E (Option (Index × Index)) := do
  let r ← JuliaLean.base.strings.search.findnextPredicate (searchOps prim) indexIntOps
    (fun c => pure (f c)) s k
  return r.map (fun i => (i, i))

/-- `findprev(f::Function, s, k)` (search.jl:668-679). -/
def predFindprev {S R C CU CT E : Type} (prim : StringOps S R C CU CT E) (f : C → Bool) (s : S)
    (k : Index) : JuliaLean.base.strings.search.SearchM E (Option (Index × Index)) := do
  let r ← JuliaLean.base.strings.search.findprevPredicate (searchOps prim) indexIntOps
    (fun c => pure (f c)) s k
  return r.map (fun i => (i, i))

def splitOps {S R C CU CT E : Type} (prim : StringOps S R C CU CT E) (errs : ViewErrors S E) :
    SplitStringOps S (Sub.SubString S) E where
  firstindex s := .ok (firstindexString s)
  lastindex := (gFull prim).lastindex
  ncodeunits s := .ok (prim.ncodeunits s)
  nextind := nextindOne (gFull prim)
  prevind := previndOne (gFull prim)
  substringUnchecked := gRange prim errs
  substringFrom := gFrom prim errs
  substringChecked := gRange prim errs

/-- Forward split emissions of `iterate(::SplitIterator)` for a predicate splitter. -/
def splitStep {S R C CU CT E : Type} (prim : StringOps S R C CU CT E) (errs : ViewErrors S E)
    (s : S) (f : C → Bool) (limit : Index) (keepempty : Bool) (st : Option SplitState) :=
  (iterateSplit (splitOps prim errs) (fun f s k => predFindnext prim f s k)
    (⟨s, f, limit, keepempty⟩ : SplitIteratorModel S (C → Bool)) st).run

/-- Reverse split emissions of `iterate(::RSplitIterator)` for a predicate splitter. -/
def rsplitStep {S R C CU CT E : Type} (prim : StringOps S R C CU CT E) (errs : ViewErrors S E)
    (s : S) (f : C → Bool) (limit : Index) (keepempty : Bool) (st : Option RSplitState) :=
  (iterateRSplit (splitOps prim errs) (fun f s k => predFindprev prim f s k)
    (⟨s, f, limit, keepempty⟩ : RSplitIteratorModel S (C → Bool)) st).run

/-- Independent split specification: maximal runs between characters satisfying `f`. -/
def splitPieces {C : Type} (f : C → Bool) : List C → List (List C)
  | [] => [[]]
  | c :: cs =>
    if f c then [] :: splitPieces f cs
    else match splitPieces f cs with
      | [] => [[c]]
      | p :: ps => (c :: p) :: ps

/-- At most `k` pieces: the first `k - 1` pieces, then the unsplit rest. -/
def splitLimitPieces {C : Type} (f : C → Bool) : Nat → List C → List (List C)
  | 0, cs => splitPieces f cs
  | 1, cs => [cs]
  | k + 2, cs =>
    match cs.findIdx? f with
    | none => [cs]
    | some i => cs.take i :: splitLimitPieces f (k + 1) (cs.drop (i + 1))

/-- Hypotheses shared by the split statements: a lawful string, and the installed search.lean
predicate loops' fuel covering it (`findnextPredicateLoop`/`findprevPredicateLoop`,
search.lean:726-742, return `nothing` when the fuel runs out). Accepted proposal R3-3 removes
that fuel from the model; the `fuel` field goes with it. -/
structure SplitInput {S R C CU CT E : Type} (prim : StringOps S R C CU CT E) (s : S)
    (ls : List (Index × C)) : Prop where
  lawful : Lawful prim s ls
  fuel : ls.length ≤ prim.iterationBound s

/-- id: stringutil-split-join. Source: split docstring and inverse invariant,
util.jl:930-961, eachsplit 738-770: with `keepempty=true` and no limit, the emitted
pieces are exactly the runs between delimiter characters, so joining them with the
delimiters restores the source. Predicate splitters cover `Function`, `AbstractChar`
(`isequal`) and `Chars` (`in`) splitters. -/
def SplitJoin : Prop :=
  ∀ {S R C CU CT E : Type} (prim : StringOps S R C CU CT E) (errs : ViewErrors S E)
    (f : C → Bool) (s : S) (ls : List (Index × C)) (limit : Index),
    SplitInput prim s ls → limit.val ≤ 0 →
    ∃ pieces, Emits (splitStep prim errs s f limit true) none pieces ∧
      ViewsIterate prim errs pieces (splitPieces f (charsIn ls))

/-- id: stringutil-split-limit. Source: split/eachsplit docstrings, util.jl:738-770,
930-956: a positive limit yields at most `limit` pieces for either `keepempty`, and with
`keepempty=true` the first `limit - 1` pieces then the unsplit rest. -/
def SplitLimit : Prop :=
  ∀ {S R C CU CT E : Type} (prim : StringOps S R C CU CT E) (errs : ViewErrors S E)
    (f : C → Bool) (s : S) (ls : List (Index × C)) (limit : Index) (keepempty : Bool),
    SplitInput prim s ls → 0 < limit.val →
    ∃ pieces, Emits (splitStep prim errs s f limit keepempty) none pieces ∧
      pieces.length ≤ limit.val.toNat ∧
      (keepempty = true →
        ViewsIterate prim errs pieces (splitLimitPieces f limit.val.toNat (charsIn ls)))

/-- id: stringutil-split-sentinel-overflow. Source: eachsplit/split limit contract,
util.jl:739-770,930-956, and the SplitIterator (util.jl:791-807): with `limit = 1`, for every
lawful string, every predicate and both `keepempty` values, the first call emits the whole
string as a view of it (except an empty string with `keepempty=false`, which emits nothing,
util.jl:805) and the next call ends the iteration. That holds at the end sentinel too: the
state `ncodeunits(s) + 2` (util.jl:806) wraps to `typemin(Int)` when
`ncodeunits(s) = typemax(Int) - 1`, and the check `i - 1 > ncodeunits(s)` (util.jl:792) wraps
back to `typemax(Int)` and still returns `nothing`. (`ncodeunits(s) = typemax(Int)` is
impossible for a lawful string: the protocol needs `iterate(s, ncodeunits(s) + 1)`.) -/
def SplitIteratorLimitOne : Prop :=
  ∀ {S R C CU CT E : Type} (prim : StringOps S R C CU CT E) (errs : ViewErrors S E)
    (f : C → Bool) (s : S) (ls : List (Index × C)) (keepempty : Bool),
    Lawful prim s ls →
    (ls = [] → keepempty = false →
      splitStep prim errs s f (int 1) keepempty none = some (.ok none)) ∧
    ((ls ≠ [] ∨ keepempty = true) →
      ∃ piece next, splitStep prim errs s f (int 1) keepempty none = some (.ok (some (piece, next))) ∧
        piece.string = s ∧ ViewIterates prim errs piece (charsIn ls) ∧
        splitStep prim errs s f (int 1) keepempty (some next) = some (.ok none))

/-- id: stringutil-rsplit-join. Source: rsplit docstring, util.jl:973-1004: reverse
emission yields the same runs from the right. -/
def RsplitJoin : Prop :=
  ∀ {S R C CU CT E : Type} (prim : StringOps S R C CU CT E) (errs : ViewErrors S E)
    (f : C → Bool) (s : S) (ls : List (Index × C)) (limit : Index),
    SplitInput prim s ls → limit.val ≤ 0 →
    ∃ pieces, Emits (rsplitStep prim errs s f limit true) none pieces ∧
      ViewsIterate prim errs pieces (splitPieces f (charsIn ls)).reverse

/-- id: stringutil-rsplit-emission-limit. Source: rsplit limit keyword, util.jl:973-1004. -/
def ReverseSplitLimit : Prop :=
  ∀ {S R C CU CT E : Type} (prim : StringOps S R C CU CT E) (errs : ViewErrors S E)
    (f : C → Bool) (s : S) (ls : List (Index × C)) (limit : Index) (keepempty : Bool),
    SplitInput prim s ls → 0 < limit.val →
    ∃ pieces, Emits (rsplitStep prim errs s f limit keepempty) none pieces ∧
      pieces.length ≤ limit.val.toNat

/-- Emissions that end with an exception from the step function. -/
inductive EmitsFail {R St E : Type} (step : Option St → Option (Except E (Option (R × St)))) :
    Option St → List R → E → Prop where
  | fail {st : Option St} {e : E} (h : step st = some (.error e)) : EmitsFail step st [] e
  | emit {st : Option St} {piece : R} {next : St} {rest : List R} {e : E}
      (h : step st = some (.ok (some (piece, next)))) (tail : EmitsFail step (some next) rest e) :
      EmitsFail step st (piece :: rest) e

/-- `findnext(f::Function, s, k)` and `findprev(f::Function, s, k)` (search.jl:343-354,
668-679) for a predicate that may throw. -/
def predFindnextE {S R C CU CT E : Type} (prim : StringOps S R C CU CT E) (f : C → Except E Bool)
    (s : S) (k : Index) : JuliaLean.base.strings.search.SearchM E (Option (Index × Index)) := do
  let r ← JuliaLean.base.strings.search.findnextPredicate (searchOps prim) indexIntOps (fun c => JuliaLean.base.strings.search.liftE (f c)) s k
  return r.map (fun i => (i, i))

def predFindprevE {S R C CU CT E : Type} (prim : StringOps S R C CU CT E) (f : C → Except E Bool)
    (s : S) (k : Index) : JuliaLean.base.strings.search.SearchM E (Option (Index × Index)) := do
  let r ← JuliaLean.base.strings.search.findprevPredicate (searchOps prim) indexIntOps (fun c => JuliaLean.base.strings.search.liftE (f c)) s k
  return r.map (fun i => (i, i))

def splitStepE {S R C CU CT E : Type} (prim : StringOps S R C CU CT E) (errs : ViewErrors S E)
    (s : S) (f : C → Except E Bool) (limit : Index) (keepempty : Bool) (st : Option SplitState) :=
  (iterateSplit (splitOps prim errs) (fun f s k => predFindnextE prim f s k)
    (⟨s, f, limit, keepempty⟩ : SplitIteratorModel S (C → Except E Bool)) st).run

def rsplitStepE {S R C CU CT E : Type} (prim : StringOps S R C CU CT E) (errs : ViewErrors S E)
    (s : S) (f : C → Except E Bool) (limit : Index) (keepempty : Bool) (st : Option RSplitState) :=
  (iterateRSplit (splitOps prim errs) (fun f s k => predFindprevE prim f s k)
    (⟨s, f, limit, keepempty⟩ : RSplitIteratorModel S (C → Except E Bool)) st).run

/-- Independent split specification for every `keepempty` and limit (`k = 0`: no limit; `k ≥ 1`:
at most `k` pieces, the last one the unsplit rest). `acc` holds the current run reversed.
Empty runs are dropped when `keepempty` is false and then do not count toward the limit. -/
def splitSpecAux {C : Type} (f : C → Bool) (keep : Bool) : Nat → List C → List C → List (List C)
  | _, acc, [] => if !keep && acc.isEmpty then [] else [acc.reverse]
  | k, acc, c :: cs =>
    if k = 1 then [acc.reverse ++ c :: cs]
    else if f c then
      if !keep && acc.isEmpty then splitSpecAux f keep k [] cs
      else acc.reverse :: splitSpecAux f keep (k - 1) [] cs
    else splitSpecAux f keep k (c :: acc) cs

/-- The same specification for a predicate that may throw: the emitted pieces, and the
exception that ends the emission if the predicate throws on a character the search reaches.
With `scanLast` (forward `split`) the search still runs once the limit is reached
(util.jl:793-794 call `findnext` before testing `n != iter.limit - 1`), so the predicate is
called up to the next delimiter before the unsplit rest is returned; `rsplit` stops searching
at the limit (util.jl:902 tests `remaining_splits` first). -/
def splitSpecE {C E : Type} (f : C → Except E Bool) (keep scanLast : Bool) :
    Nat → List C → List C → List (List C) × Option E
  | _, acc, [] => (if !keep && acc.isEmpty then [] else [acc.reverse], none)
  | k, acc, c :: cs =>
    if k = 1 && !scanLast then ([acc.reverse ++ c :: cs], none)
    else match f c with
      | .error e => ([], some e)
      | .ok false => splitSpecE f keep scanLast k (c :: acc) cs
      | .ok true =>
        if k = 1 then ([acc.reverse ++ c :: cs], none)
        else if !keep && acc.isEmpty then splitSpecE f keep scanLast k [] cs
        else
          let rest := splitSpecE f keep scanLast (k - 1) [] cs
          (acc.reverse :: rest.1, rest.2)

def limitCount (limit : Index) : Nat := if limit.val ≤ 0 then 0 else limit.val.toNat

/-- New id: stringutil-split-runs. Source: split/eachsplit docstrings, util.jl:738-770,930-961,
and the SplitIterator (util.jl:791-807). For every lawful string, every predicate splitter
(which may throw), every limit and both `keepempty` values: the emitted pieces are the runs of
`splitSpecE` (empty runs dropped for `keepempty=false`, at most `limit` pieces with the unsplit
rest last), and when the predicate throws `e` on a character the search reaches, those pieces
are emitted and then `e` propagates. -/
def SplitRuns : Prop :=
  ∀ {S R C CU CT E : Type} (prim : StringOps S R C CU CT E) (errs : ViewErrors S E)
    (f : C → Except E Bool) (s : S) (ls : List (Index × C)) (limit : Index) (keepempty : Bool),
    SplitInput prim s ls →
    let spec := splitSpecE f keepempty true (limitCount limit) [] (charsIn ls)
    (spec.2 = none →
      ∃ pieces, Emits (splitStepE prim errs s f limit keepempty) none pieces ∧
        ViewsIterate prim errs pieces spec.1) ∧
    (∀ e, spec.2 = some e →
      ∃ pieces, EmitsFail (splitStepE prim errs s f limit keepempty) none pieces e ∧
        ViewsIterate prim errs pieces spec.1)

/-- New id: stringutil-rsplit-runs. Source: rsplit docstring, util.jl:973-1004 and the
RSplitIterator (util.jl:898-926): the same runs taken from the right (emitted right to left,
the unsplit rest last), for every predicate (which may throw), limit and `keepempty`; a
predicate exception on a character the search reaches propagates after the runs completed to
its right. -/
def RsplitRuns : Prop :=
  ∀ {S R C CU CT E : Type} (prim : StringOps S R C CU CT E) (errs : ViewErrors S E)
    (f : C → Except E Bool) (s : S) (ls : List (Index × C)) (limit : Index) (keepempty : Bool),
    SplitInput prim s ls →
    let spec := splitSpecE f keepempty false (limitCount limit) [] (charsIn ls).reverse
    (spec.2 = none →
      ∃ pieces, Emits (rsplitStepE prim errs s f limit keepempty) none pieces ∧
        ViewsIterate prim errs pieces (spec.1.map List.reverse)) ∧
    (∀ e, spec.2 = some e →
      ∃ pieces, EmitsFail (rsplitStepE prim errs s f limit keepempty) none pieces e ∧
        ViewsIterate prim errs pieces (spec.1.map List.reverse))

/-- `collect` of a split iterator as documented (array.jl `collect`: every element of the
iteration in order; the first exception propagates). util.lean `splitGeneric`/`rsplitGeneric`
still take `collect` and `reverse` as arguments; proposal R6-8 binds them to array.jl:780-786
(`collectKnownUnknown`, `similar(c, T, 0)`) through a `ForIn` lowering of the split iterators,
and arraymath.jl `reverse!`. Until then this law stands in for them and stringutil-split-collect
stays `blocked-model`. -/
structure CollectsSteps {I R St E : Type} (collect : I → Except E (List R))
    (step : I → Option St → Option (Except E (Option (R × St)))) : Prop where
  done : ∀ it pieces, Emits (step it) none pieces → collect it = .ok pieces
  fails : ∀ it pieces e, EmitsFail (step it) none pieces e → collect it = .error e

def splitIterStep {S R C CU CT E : Type} (prim : StringOps S R C CU CT E) (errs : ViewErrors S E)
    (it : SplitIteratorModel S (C → Except E Bool)) (st : Option SplitState) :=
  (iterateSplit (splitOps prim errs) (fun f s k => predFindnextE prim f s k) it st).run

def rsplitIterStep {S R C CU CT E : Type} (prim : StringOps S R C CU CT E) (errs : ViewErrors S E)
    (it : RSplitIteratorModel S (C → Except E Bool)) (st : Option RSplitState) :=
  (iterateRSplit (splitOps prim errs) (fun f s k => predFindprevE prim f s k) it st).run

def partOps {S R C CU CT E : Type} (prim : StringOps S R C CU CT E) (errs : ViewErrors S E) :
    PartitionOps S (Sub.SubString S) E where
  ncodeunits s := .ok (prim.ncodeunits s)
  firstindex s := .ok (firstindexString s)
  lastindex := (gFull prim).lastindex
  nextindN := (gFull prim).nextind
  nextind := nextindOne (gFull prim)
  substring := gRange prim errs

/-- Chunks of `size` elements (the last possibly shorter). -/
def chunksOf {A : Type} (size : Nat) (xs : List A) : List (List A) :=
  (List.range ((xs.length + size - 1) / size)).map (fun k => (xs.drop (k * size)).take size)

/-- New id: stringutil-partition-character-chunks. Source: Iterators.partition docstring
(equal-size chunks) and util.jl:814-818, for every lawful string. The range where
`nextind`'s `Int` arithmetic wraps is excluded; it is refuted as strings-partition-overflow. -/
def PartitionCharacters : Prop :=
  ∀ {S R C CU CT E : Type} (prim : StringOps S R C CU CT E) (errs : ViewErrors S E)
    (s : S) (ls : List (Index × C)) (n : Index),
    Lawful prim s ls → 0 < n.val → n.val + (prim.ncodeunits s).val + 1 < 2 ^ 63 →
    ∃ pieces, Emits (fun st => some (iteratePartition (partOps prim errs) ⟨s, n⟩ st)) none pieces ∧
      ViewsIterate prim errs pieces (chunksOf n.val.toNat (charsIn ls))

/-! ## Replacement engine -/

/-- The engine's callees outside util.jl on a user `IO` type: `write`, `unsafe_write`,
`IOBuffer`, `takestring!`, `String`, pattern search, `argmin` and tuple indexing. None of
them is assumed to satisfy any law. -/
structure ReplaceCallees (S Q R IO O E : Type) where
  write : IO → R → Except E (IO × Index)
  unsafeWrite : IO → S → Index → Index → Except E IO
  writeRest : IO → S → Index → Except E IO
  writeString : IO → S → Except E IO
  sizeof : S → Except E Index
  newBuffer : Index → Except E IO
  liftJ : JlError → E
  takeString : IO → Except E O
  toString : S → Except E O
  findnext : Q → S → Index → Except E (Option ReplaceSearchResult)
  argmin : List Index → Index
  selectRange : List ReplaceRange → Index → Except E ReplaceRange
  selectPattern : List Q → Index → Except E Q
  selectReplacement : List R → Index → Except E R
  domainError : Index → E

/-- The engine on a stream type whose `write(io, repl)` also counts its calls: an instance
of the generic `io::IO` domain. `_pat_replacer` and the literal `_replace` method are the
installed util.jl definitions; the string's index methods are the installed basic.jl ones. -/
def countedEngine {S R C CU CT E Q Rp IO O : Type} (prim : StringOps S R C CU CT E)
    (ext : ReplaceCallees S Q Rp IO O E) :
    ReplaceEngineOps S Q Q Rp (IO × Nat) (O × Nat) E where
  initOps :=
    { patternReplacer := patReplacer
      firstindex := fun s => .ok (firstindexString s)
      lastindex := (gFull prim).lastindex
      nextind := nextindOne (gFull prim)
      findnext := ext.findnext
      domainError := ext.domainError }
  finishOps :=
    { firstindex := fun s => .ok (firstindexString s)
      first := ReplaceRange.first
      writeRest := fun io s i => do return (← ext.writeRest io.1 s i, io.2) }
  onceOps :=
    { argmin := ext.argmin
      selectRange := ext.selectRange
      selectPattern := ext.selectPattern
      selectReplacement := ext.selectReplacement
      first := ReplaceRange.first
      last := ReplaceRange.last
      unsafeWrite := fun io s i n => do return (← ext.unsafeWrite io.1 s i n, io.2)
      replace := replaceLiteral (fun io r => do
        let (io', k) ← ext.write io.1 r
        return ((io', io.2 + 1), k))
      nextind := nextindOne (gFull prim)
      findnext := ext.findnext }
  writeString io s := do return (← ext.writeString io.1 s, io.2)
  sizeof := ext.sizeof
  newBuffer h := do return (← ext.newBuffer h, 0)
  liftJ := ext.liftJ
  takeString io := do return (← ext.takeString io.1, io.2)
  toString s := do return (← ext.toString s, 0)

/-! ### `replace` on `String(s)`: installed String methods, every stream and pattern type -/

/-- Stream calls of the engine, in order: `write(io, str)` (util.jl:1109,1115),
`unsafe_write(io, pointer(str, i), UInt(n))` (util.jl:1077), `_replace(io, replaces[x], str,
r, patterns[x])` (util.jl:1079) and `write(io, SubString(str, i))` (util.jl:1064). -/
inductive ReplaceEvent (Q R : Type) where
  | whole
  | keep (i n : Index)
  | apply (replacement : R) (range : ReplaceRange) (pattern : Q)
  | rest (i : Index)

/-- The stream methods of the caller's `IO` type, `IOBuffer(sizehint=...)` with `takestring!`
for the `String` result, and `String(str)`: no Lean model is used and nothing is assumed. -/
structure StreamCallees (IO Q R O E : Type) where
  writeString : IO → Raw → Except E IO
  unsafeWrite : IO → Raw → Index → Index → Except E IO
  replace : IO → R → Raw → ReplaceRange → Q → Except E (IO × Index)
  writeRest : IO → Raw → Index → Except E IO
  newBuffer : Index → Except E IO
  takeString : IO → Except E O
  toString : Raw → Except E O

/-- Every stream call returns normally. -/
def StreamTotal {IO Q R O E : Type} (cal : StreamCallees IO Q R O E) : Prop :=
  (∀ io s, ∃ v, cal.writeString io s = .ok v) ∧
  (∀ io s i n, ∃ v, cal.unsafeWrite io s i n = .ok v) ∧
  (∀ io r s range p, ∃ v, cal.replace io r s range p = .ok v) ∧
  (∀ io s i, ∃ v, cal.writeRest io s i = .ok v) ∧
  (∀ h, ∃ v, cal.newBuffer h = .ok v) ∧ (∀ io, ∃ v, cal.takeString io = .ok v) ∧
  (∀ s, ∃ v, cal.toString s = .ok v)

/-- `_replace_init`'s callees on `str = String(s)`: installed `firstindex` (basic.jl),
`lastindex(s) = thisind(s, ncodeunits(s))` with string.jl `thisind`, string.jl `nextind`, the
pattern type's `_pat_replacer` and the searched pattern type's `findnext`. -/
def initOpsString {P Q R E : Type} (liftS : Error → E) (liftJ : JlError → E)
    (patternReplacer : P → Q) (findnext : Q → Raw → Index → Except E (Option ReplaceSearchResult)) :
    ReplaceInitOps Raw P Q R E where
  patternReplacer := patternReplacer
  firstindex := fun s => .ok (firstindexString s)
  lastindex := fun s => (Str.stringThisind s (Str.stringNcodeunits s)).mapError liftS
  nextind := fun s i => (Str.stringNextind s i).mapError liftS
  findnext := findnext
  domainError := fun _ => liftJ (.domainError "`count` must be non-negative.")

/-- The engine of `_replace_` on `str = String(s)`: installed `firstindex` (basic.jl),
`lastindex(s) = thisind(s, ncodeunits(s))` with string.jl `thisind`, string.jl `nextind`,
tuple.jl `getindex(::Tuple, ::Int)` for `rs[x]`, `patterns[x]` and `replaces[x]`, the caller's
pattern search and stream methods, and `argmin` (a pure field until proposal R3-10 is
applied). Each stream call is also recorded, in order, as a `ReplaceEvent`. -/
def stringEngine {Q R IO O E : Type} (liftS : Error → E)
    (liftT : JuliaLean.base.tuple.TupleError → E) (liftJ : JlError → E)
    (findnext : Q → Raw → Index → Except E (Option ReplaceSearchResult))
    (argmin : List Index → Index) (cal : StreamCallees IO Q R O E) :
    ReplaceEngineOps Raw Q Q R (IO × List (ReplaceEvent Q R)) (O × List (ReplaceEvent Q R)) E where
  initOps := initOpsString liftS liftJ patReplacer findnext
  finishOps :=
    { firstindex := fun s => .ok (firstindexString s)
      first := ReplaceRange.first
      writeRest := fun io s i => do return (← cal.writeRest io.1 s i, io.2 ++ [.rest i]) }
  onceOps :=
    { argmin := argmin
      selectRange := fun xs x => (JuliaLean.base.tuple.getindexInt xs x).mapError liftT
      selectPattern := fun xs x => (JuliaLean.base.tuple.getindexInt xs x).mapError liftT
      selectReplacement := fun xs x => (JuliaLean.base.tuple.getindexInt xs x).mapError liftT
      first := ReplaceRange.first
      last := ReplaceRange.last
      unsafeWrite := fun io s i n => do return (← cal.unsafeWrite io.1 s i n, io.2 ++ [.keep i n])
      replace := fun io r s range p => do
        let (h, nb) ← cal.replace io.1 r s range p
        return ((h, io.2 ++ [.apply r range p]), nb)
      nextind := fun s i => (Str.stringNextind s i).mapError liftS
      findnext := findnext }
  writeString io s := do return (← cal.writeString io.1 s, io.2 ++ [.whole])
  sizeof s := .ok (Str.stringNcodeunits s)
  newBuffer h := do return (← cal.newBuffer h, [])
  liftJ := liftJ
  takeString io := do return (← cal.takeString io.1, io.2)
  toString s := do return (← cal.toString s, [])

/-- `argmin(map(first, rs))`: the index of the first minimal element (reduce.jl `argmin`
docstring); proposal R3-10 replaces this by the installed reduce.jl model. -/
def ArgminFirst (argmin : List Index → Index) : Prop :=
  ∀ (xs : List Index) (x : Nat) (m : Index), xs[x]? = some m →
    (∀ (y : Nat) (v : Index), xs[y]? = some v → m.val < v.val ∨ (m.val = v.val ∧ x ≤ y)) →
    argmin xs = int (x + 1)

/-- `argmin(map(first, rs))` (util.jl:1071) through the installed reduce.jl model:
reduce.lean `argmin` (reduce.jl:1063, `findmin`), with `isgreater` on `Int` bound to the
installed operators.jl:295 `isgreater`, operators.jl:309 `isunordered(_) = false` and
`isless(::Real, ::Real)` (`islessReal` with int.jl `slt_int`). The element-type trait and
`pairs` are parameters of the installed reduce model, as in Proofs/base/reduce.lean
`FindExtremaSpec`. -/
def installedArgmin (elementType : {I : Type} → JuliaLean.base.reduce.JIterator I →
      JuliaLean.base.reduce.EltypeStatus)
    (pairs : JuliaLean.base.reduce.JIterator Index →
      JuliaLean.base.reduce.JIterator (Index × Index)) (xs : List Index) : Jl Index :=
  JuliaLean.base.reduce.argmin elementType pairs id
    (JuliaLean.base.operators.isgreater JuliaLean.base.operators.isunordered
      JuliaLean.base.operators.isunordered
      (JuliaLean.base.operators.islessReal JuliaLean.base.int.slt_int)
      (JuliaLean.base.operators.islessReal JuliaLean.base.int.slt_int))
    (.values xs)

/-- The model's pure `argmin` field (util.lean `ReplaceOnceOps.argmin`) returns what the
installed reduce.jl `argmin` returns whenever that returns, for `pairs` of the tuple
`map(first, rs)` giving `i => rs[i]` (iterators.jl `pairs(::Tuple)`). No other property of
`argmin` is assumed. Accepted proposal R3-10 replaces the pure field by the installed model
itself, removing this hypothesis. -/
def ArgminInstalled (argmin : List Index → Index) : Prop :=
  ∀ (elementType : {I : Type} → JuliaLean.base.reduce.JIterator I →
      JuliaLean.base.reduce.EltypeStatus)
    (pairs : JuliaLean.base.reduce.JIterator Index →
      JuliaLean.base.reduce.JIterator (Index × Index)) (xs : List Index) (k : Index),
    pairs (.values xs) = .values ((List.range xs.length).zip xs |>.map
      (fun iv => (int (iv.1 + 1), iv.2))) →
    installedArgmin elementType pairs xs = .ok k → argmin xs = k

/-- A pattern's next occurrence as the engine reads `findnext(p, str, k)` (util.jl:1040-1044,
1100-1104): `nothing` or a first index of `0` is no occurrence; an `Int` match `i` is `i:i`. -/
def occurrenceOf : Option ReplaceSearchResult → Option ReplaceRange
  | none => none
  | some found =>
    if (replaceSearchFirst found).val = 0 then none
    else some (match found with
      | .index i => ⟨i, i⟩
      | .range r => r)

def occOf {Q E : Type} (findnext : Q → Raw → Index → Except E (Option ReplaceSearchResult))
    (s : Raw) (p : Q) (k : Index) : Option ReplaceRange :=
  match findnext p s k with
  | .ok v => occurrenceOf v
  | .error _ => none

/-- The documented `findnext(pattern, string, start)` contract (search.jl docstrings) for one
pattern on `s`: every search from a valid start returns; an occurrence starts at or after the
start and lies in the string; and searching again from a later start that does not pass the
occurrence finds the same one (nothing after nothing). -/
structure FindsForward {Q E : Type}
    (findnext : Q → Raw → Index → Except E (Option ReplaceSearchResult)) (s : Raw) (p : Q) :
    Prop where
  total : ∀ k : Index, 1 ≤ k.val → ∃ v, findnext p s k = .ok v
  inString : ∀ (k : Index) (v : Option ReplaceSearchResult) (r : ReplaceRange), 1 ≤ k.val →
    findnext p s k = .ok v → occurrenceOf v = some r →
    k.val ≤ r.first.val ∧ r.first.val ≤ (s.bytes.length : Int) + 1 ∧
    (r.first.val ≤ r.last.val → r.last.val ≤ (s.bytes.length : Int))
  stable : ∀ (k k' : Index) (v v' : Option ReplaceSearchResult), 1 ≤ k.val → k.val ≤ k'.val →
    findnext p s k = .ok v → findnext p s k' = .ok v' →
    (∀ r, occurrenceOf v = some r → k'.val ≤ r.first.val → occurrenceOf v' = some r) ∧
    (occurrenceOf v = none → occurrenceOf v' = none)

def appliedCount {Q R : Type} (events : List (ReplaceEvent Q R)) : Nat :=
  (events.filter (fun e => match e with
    | .apply _ _ _ => true
    | _ => false)).length

/-- id: stringutil-replace-count-min. Source: replace docstring, util.jl:1137 ("replace at
most `count` occurrences"), for both engines on `String(s)`, every stream type, pattern
search and `argmin`, and every `count` from `0` to `typemax(Int)`: whenever the engine
returns, at most `count` replacements were written. At `count = typemax(Int)` the loop
counter `n` can wrap after `typemax(Int)` steps, so there the claim assumes the documented
`findnext` contract and takes `argmin` from the installed reduce.jl model (`ArgminInstalled`),
under which the scan advances every step. -/
def ReplaceCountMin : Prop :=
  ∀ {Q R IO O E : Type} (liftS : Error → E) (liftT : JuliaLean.base.tuple.TupleError → E)
    (liftJ : JlError → E) (findnext : Q → Raw → Index → Except E (Option ReplaceSearchResult))
    (argmin : List Index → Index) (cal : StreamCallees IO Q R O E) (s : Raw)
    (pairs : List (ReplacePair Q R)) (count : Index),
    0 ≤ count.val →
    (count.val < 2 ^ 63 - 1 ∨
      (ArgminInstalled argmin ∧ ∀ q ∈ pairs, FindsForward findnext s q.pattern)) →
    (∀ (calIO : StreamCallees IO Q R IO E) (io : IO) out,
      replaceIOEngine (stringEngine liftS liftT liftJ findnext argmin calIO)
        (io, []) s pairs count = some (.ok out) → appliedCount out.2 ≤ count.val.toNat) ∧
    (∀ out, replaceStringEngine (stringEngine liftS liftT liftJ findnext argmin cal)
        s pairs count = some (.ok out) → appliedCount out.2 ≤ count.val.toNat)

/-- id: stringutil-replace-count-edge. Source: replace docstring, util.jl:1122-1131,1133-1180,
on `String(s)`: `count = 0` returns `String(str)` with no stream write, a negative count
throws `DomainError`, and every positive count up to `typemax(Int)` writes at most `count`
replacements (under the contracts of stringutil-replace-count-min at `typemax(Int)`). -/
def ReplaceCountEdge : Prop :=
  ∀ {Q R IO O E : Type} (liftS : Error → E) (liftT : JuliaLean.base.tuple.TupleError → E)
    (liftJ : JlError → E) (findnext : Q → Raw → Index → Except E (Option ReplaceSearchResult))
    (argmin : List Index → Index) (cal : StreamCallees IO Q R O E) (s : Raw)
    (pairs : List (ReplacePair Q R)) (count : Index),
    let ops := stringEngine liftS liftT liftJ findnext argmin cal
    (count.val = 0 →
      replaceStringEngine ops s pairs count = some ((cal.toString s).map (fun o => (o, [])))) ∧
    (count.val < 0 → replaceStringEngine ops s pairs count =
      some (.error (liftJ (.domainError "`count` must be non-negative.")))) ∧
    (0 < count.val →
      (count.val < 2 ^ 63 - 1 ∨
        (ArgminInstalled argmin ∧ ∀ q ∈ pairs, FindsForward findnext s q.pattern)) →
      ∀ out, replaceStringEngine ops s pairs count = some (.ok out) →
        appliedCount out.2 ≤ count.val.toNat)
theorem replaceCountEdgeZeroNegative :
    ∀ {Q R IO O E : Type} (liftS : Error → E) (liftT : JuliaLean.base.tuple.TupleError → E)
      (liftJ : JlError → E) (findnext : Q → Raw → Index → Except E (Option ReplaceSearchResult))
      (argmin : List Index → Index) (cal : StreamCallees IO Q R O E) (s : Raw)
      (pairs : List (ReplacePair Q R)) (count : Index),
      let ops := stringEngine liftS liftT liftJ findnext argmin cal
      (count.val = 0 →
        replaceStringEngine ops s pairs count =
          some ((cal.toString s).map (fun o => (o, [])))) ∧
      (count.val < 0 →
        replaceStringEngine ops s pairs count =
          some (.error (liftJ (.domainError "`count` must be non-negative.")))) := by
  intro Q R IO O E liftS liftT liftJ findnext argmin cal s pairs count
  let ops := stringEngine liftS liftT liftJ findnext argmin cal
  constructor
  · intro hzero
    simp only [replaceStringEngine, if_pos hzero]
    rfl
  · intro hnegative
    have hnonzero : count.val ≠ 0 := by omega
    simp [replaceStringEngine, replaceInit, stringEngine, initOpsString, hnegative,
      hnonzero, partialBind]

/-- id: stringutil-stream-replace-count-edge. Source: util.jl:1107-1120: `count = 0`
writes the source unchanged with no replacement write; a negative count throws
`DomainError` before any write. -/
def StreamReplaceCountEdge : Prop :=
  ∀ {S R C CU CT E Q Rp IO : Type} (prim : StringOps S R C CU CT E)
    (ext : ReplaceCallees S Q Rp IO IO E) (io : IO) (str : S) (pairs : List (ReplacePair Q Rp))
    (count : Index),
    (count.val = 0 →
      replaceIOEngine (countedEngine prim ext) (io, 0) str pairs count =
        some ((ext.writeString io str).map (fun io => (io, 0)))) ∧
    (count.val < 0 →
      replaceIOEngine (countedEngine prim ext) (io, 0) str pairs count =
        some (.error (ext.domainError count)))

/-- `_replace_init`'s callees for a `str` of any string type `S` (util.jl:1034 leaves `str`
untyped so packages such as StringViews can call it): the installed basic.jl `firstindex`,
`lastindex` and `nextind` over `S`'s own primitives. -/
def initOpsG {S Rs C CU CT E P Q R : Type} (prim : StringOps S Rs C CU CT E)
    (liftJ : JlError → E) (patternReplacer : P → Q)
    (findnext : Q → S → Index → Except E (Option ReplaceSearchResult)) :
    ReplaceInitOps S P Q R E where
  patternReplacer := patternReplacer
  firstindex := fun s => .ok (firstindexString s)
  lastindex := (gFull prim).lastindex
  nextind := nextindOne (gFull prim)
  findnext := findnext
  domainError := fun _ => liftJ (.domainError "`count` must be non-negative.")

/-- What `_replace_init` (util.jl:1035-1050) returns, given `e1`: a negative count throws
`DomainError`; otherwise the patterns are `_pat_replacer.(first.(pat_repl))`, the first search
of each from `firstindex` runs in argument order and the first exception propagates; when all
return, each range is the pattern's occurrence (or the sentinel `e1+1:0` when there is none),
and `notfound` holds exactly when no occurrence starts at or before `e1`. -/
def InitResult {S P Q R E : Type} (liftJ : JlError → E) (pr : P → Q)
    (findnext : Q → S → Index → Except E (Option ReplaceSearchResult)) (s : S)
    (pairs : List (ReplacePair P R)) (count e1 : Index)
    (init : Except E (Index × List Q × List R × List ReplaceRange × Bool)) : Prop :=
  (count.val < 0 → init = .error (liftJ (.domainError "`count` must be non-negative."))) ∧
  (0 ≤ count.val →
    (∀ results : List (Option ReplaceSearchResult),
      pairs.mapM (fun q => findnext (pr q.pattern) s (int 1)) = .ok results →
      init = .ok (e1, pairs.map (fun q => pr q.pattern), pairs.map (·.replacement),
        results.map (fun v => (occurrenceOf v).getD (replaceSentinel e1)),
        results.all (fun v => match occurrenceOf v with
          | none => true
          | some r => decide (e1.val < r.first.val)))) ∧
    (∀ e, pairs.mapM (fun q => findnext (pr q.pattern) s (int 1)) = .error e → init = .error e))

/-- id: stringscova-util-review-1035. Source: util.jl:1035-1050 (including the comment
`e1 = nextind(str, lastindex(str)) # sizeof(str)+1`). For every pattern type with its
`_pat_replacer` method `pr` (installed `patReplacer`, `patReplacerChar` with `isequal` and
`patReplacerChars` with `in` for the util.jl:1028-1032 methods, a user's otherwise; no
assumption on it) and every search `findnext` of the replaced patterns: (1) on every `String`
with the installed String methods, and (2) on every lawful string of any type with its own
primitives, `_replace_init` gives `InitResult` with `e1 = ncodeunits(str) + 1`. -/
def ReplacementInitContract : Prop :=
  (∀ {P Q R E : Type} (liftS : Error → E) (liftJ : JlError → E) (pr : P → Q)
    (findnext : Q → Raw → Index → Except E (Option ReplaceSearchResult)) (s : Raw)
    (pairs : List (ReplacePair P R)) (count : Index),
    InitResult liftJ pr findnext s pairs count (int ((s.bytes.length : Int) + 1))
      (replaceInit (initOpsString liftS liftJ pr findnext) s pairs count)) ∧
  (∀ {S Rs C CU CT E P Q R : Type} (prim : StringOps S Rs C CU CT E) (liftJ : JlError → E)
    (pr : P → Q) (findnext : Q → S → Index → Except E (Option ReplaceSearchResult)) (s : S)
    (ls : List (Index × C)) (pairs : List (ReplacePair P R)) (count : Index),
    Lawful prim s ls →
    InitResult liftJ pr findnext s pairs count (prim.ncodeunits s + int 1)
      (replaceInit (initOpsG prim liftJ pr findnext : ReplaceInitOps S P Q R E) s pairs count))

abbrev Stream := JuliaLean.base.iobuffer.BufferState
abbrev StreamError := JuliaLean.base.iobuffer.IOErr


/-- The pattern applied at search position `k`: the pattern whose next occurrence starts first,
the earlier argument on ties (util.jl:1152-1157). -/
def Earliest {Q R : Type} (occ : Q → Index → Option ReplaceRange) (pats : List (ReplacePair Q R))
    (k : Index) (x : Nat) (q : ReplacePair Q R) (r : ReplaceRange) : Prop :=
  pats[x]? = some q ∧ occ q.pattern k = some r ∧
  ∀ (y : Nat) (q' : ReplacePair Q R) (r' : ReplaceRange), pats[y]? = some q' →
    occ q'.pattern k = some r' →
    r.first.val < r'.first.val ∨ (r.first.val = r'.first.val ∧ x ≤ y)

/-- The text kept before an applied occurrence and its replacement. An empty occurrence that
starts where the previous occurrence ended (`i > last`, `i ≠ firstindex`) writes nothing
(regexunicode-replace-empty-after-match). -/
def appliedEvents {Q R : Type} (q : ReplacePair Q R) (r : ReplaceRange) (i : Index) :
    List (ReplaceEvent Q R) :=
  if i.val = 1 ∨ i.val ≤ r.last.val then
    [.keep i (r.first - i), .apply q.replacement r q.pattern]
  else []

/-- The documented left-to-right scan (util.jl:1136-1157) of a string with `e1 - 1` code
units, from search position `k` with kept text starting at `i`, at step `n`: the earliest
occurrence is applied and scanning resumes after it (after its first character when it is
empty); every step counts toward `count`; the remaining text is written last. -/
inductive Scan {Q R : Type} (occ : Q → Index → Option ReplaceRange)
    (next : Index → Except Error Index) (pats : List (ReplacePair Q R)) (e1 count : Index) :
    Index → Index → Index → List (ReplaceEvent Q R) → Prop where
  | spent {n i k : Index} : count.val < n.val → Scan occ next pats e1 count n i k [.rest i]
  | exhausted {n i k : Index} : n.val ≤ count.val →
      (∀ q ∈ pats, ∀ r, occ q.pattern k = some r → e1.val < r.first.val) →
      Scan occ next pats e1 count n i k [.rest i]
  | emptyAtEnd {n i k : Index} {x : Nat} {q : ReplacePair Q R} {r : ReplaceRange} :
      n.val ≤ count.val → Earliest occ pats k x q r → r.last.val < r.first.val → r.first = e1 →
      Scan occ next pats e1 count n i k (appliedEvents q r i ++ [.rest r.first])
  | emptyLast {n i k k' : Index} {x : Nat} {q : ReplacePair Q R} {r : ReplaceRange} :
      n = count → Earliest occ pats k x q r → r.last.val < r.first.val →
      r.first.val < e1.val → next r.first = .ok k' →
      Scan occ next pats e1 count n i k (appliedEvents q r i ++ [.rest r.first])
  | emptyMore {n i k k' : Index} {x : Nat} {q : ReplacePair Q R} {r : ReplaceRange}
      {more : List (ReplaceEvent Q R)} :
      n.val < count.val → Earliest occ pats k x q r → r.last.val < r.first.val →
      r.first.val < e1.val → next r.first = .ok k' →
      Scan occ next pats e1 count (n + int 1) r.first k' more →
      Scan occ next pats e1 count n i k (appliedEvents q r i ++ more)
  | matchLast {n i k i' : Index} {x : Nat} {q : ReplacePair Q R} {r : ReplaceRange} :
      n = count → Earliest occ pats k x q r → r.first.val ≤ r.last.val →
      r.first.val < e1.val → next r.last = .ok i' →
      Scan occ next pats e1 count n i k (appliedEvents q r i ++ [.rest i'])
  | matchMore {n i k i' : Index} {x : Nat} {q : ReplacePair Q R} {r : ReplaceRange}
      {more : List (ReplaceEvent Q R)} :
      n.val < count.val → Earliest occ pats k x q r → r.first.val ≤ r.last.val →
      r.first.val < e1.val → next r.last = .ok i' →
      Scan occ next pats e1 count (n + int 1) i' i' more →
      Scan occ next pats e1 count n i k (appliedEvents q r i ++ more)

/-- The stream calls of `_replace_` on `s` for `count ≥ 1` (util.jl:1107-1131): `whole`
(`write(io, str)`, or nothing for the String engine, which returns `String(str)`) when no
occurrence starts by `e1 = ncodeunits + 1`; otherwise the scan from `firstindex`, using the
installed string.jl `nextind`. -/
def ReplaceScanEvents {Q R : Type} (occ : Q → Index → Option ReplaceRange) (s : Raw)
    (pats : List (ReplacePair Q R)) (count : Index) (whole events : List (ReplaceEvent Q R)) :
    Prop :=
  let e1 : Index := int ((s.bytes.length : Int) + 1)
  ((∀ q ∈ pats, ∀ r, occ q.pattern (int 1) = some r → e1.val < r.first.val) ∧
    events = whole) ∨
  ((∃ q ∈ pats, ∃ r, occ q.pattern (int 1) = some r ∧ r.first.val ≤ e1.val) ∧
    Scan occ (Str.stringNextind s) pats e1 count (int 1) (int 1) (int 1) events)
private theorem appliedCount_append {Q R : Type} (xs ys : List (ReplaceEvent Q R)) :
    appliedCount (xs ++ ys) = appliedCount xs + appliedCount ys := by
  simp [appliedCount, List.filter_append]

private theorem appliedEvents_count_le_one {Q R : Type}
    (q : ReplacePair Q R) (r : ReplaceRange) (i : Index) :
    appliedCount (appliedEvents q r i) ≤ 1 := by
  unfold appliedEvents
  split <;> simp [appliedCount]

private theorem scanAppliedCountBudget {Q R : Type}
    {occ : Q → Index → Option ReplaceRange} {next : Index → Except Error Index}
    {pats : List (ReplacePair Q R)} {e1 count : Index}
    (hcount : 0 < count.val) :
    ∀ (n i k : Index) (events : List (ReplaceEvent Q R)),
      Scan occ next pats e1 count n i k events →
      1 ≤ n.val → n.val ≤ count.val + 1 →
      appliedCount events ≤ (count.val - n.val + 1).toNat := by
  intro n i k events trace
  induction trace with
  | spent hspent =>
      intro hn hbound
      simp [appliedCount]
  | exhausted hle _ =>
      intro hn hbound
      simp [appliedCount]
  | @emptyAtEnd n i k x q r hle hearly hempty hfirst =>
      intro hn hbound
      rw [appliedCount_append]
      have hhead := appliedEvents_count_le_one q r i
      have hrest : appliedCount ([.rest r.first] : List (ReplaceEvent Q R)) = 0 := by
        simp [appliedCount]
      rw [hrest]
      omega
  | @emptyLast n i k k' x q r heq hearly hempty hbefore hnext =>
      intro hn hbound
      rw [heq]
      rw [appliedCount_append]
      have hhead := appliedEvents_count_le_one q r i
      have hrest : appliedCount ([.rest r.first] : List (ReplaceEvent Q R)) = 0 := by
        simp [appliedCount]
      rw [hrest]
      simpa using hhead
  | @emptyMore n i k k' x q r more hlt hearly hempty hbefore hnext tail ih =>
      intro hn hbound
      have hmax : n.val + 1 ≤ IntTy.max .i64 := by
        calc
          n.val + 1 ≤ count.val := by omega
          _ ≤ IntTy.max .i64 := count.property.2
      have hnadd := JuliaLean.Proofs.base.strings.basic.add_one_val n hmax
      have hnNext : 1 ≤ (n + int 1).val := by rw [hnadd]; omega
      have hboundNext : (n + int 1).val ≤ count.val + 1 := by rw [hnadd]; omega
      have htail := ih hnNext hboundNext
      rw [hnadd] at htail
      rw [appliedCount_append]
      have hhead := appliedEvents_count_le_one q r i
      omega
  | @matchLast n i k i' x q r heq hearly hmatch hbefore hnext =>
      intro hn hbound
      rw [heq]
      rw [appliedCount_append]
      have hhead := appliedEvents_count_le_one q r i
      have hrest : appliedCount ([.rest i'] : List (ReplaceEvent Q R)) = 0 := by
        simp [appliedCount]
      rw [hrest]
      simpa using hhead
  | @matchMore n i k i' x q r more hlt hearly hmatch hbefore hnext tail ih =>
      intro hn hbound
      have hmax : n.val + 1 ≤ IntTy.max .i64 := by
        calc
          n.val + 1 ≤ count.val := by omega
          _ ≤ IntTy.max .i64 := count.property.2
      have hnadd := JuliaLean.Proofs.base.strings.basic.add_one_val n hmax
      have hnNext : 1 ≤ (n + int 1).val := by rw [hnadd]; omega
      have hboundNext : (n + int 1).val ≤ count.val + 1 := by rw [hnadd]; omega
      have htail := ih hnNext hboundNext
      rw [hnadd] at htail
      rw [appliedCount_append]
      have hhead := appliedEvents_count_le_one q r i
      omega

private theorem replaceScanEventsAppliedCountBudget {Q R : Type}
    {occ : Q → Index → Option ReplaceRange} {s : Raw} {pats : List (ReplacePair Q R)}
    {count : Index} {whole events : List (ReplaceEvent Q R)}
    (hcount : 0 < count.val) (hwhole : appliedCount whole ≤ count.val.toNat)
    (hscan : ReplaceScanEvents occ s pats count whole events) :
    appliedCount events ≤ count.val.toNat := by
  dsimp [ReplaceScanEvents] at hscan
  rcases hscan with ⟨_, rfl⟩ | ⟨_, htrace⟩
  · exact hwhole
  · have hone : (int 1).val = 1 := by decide
    have hstart : 1 ≤ (int 1).val := by omega
    have hbound : (int 1).val ≤ count.val + 1 := by omega
    have h := scanAppliedCountBudget hcount _ _ _ _ htrace hstart hbound
    simpa [hone] using h


/-- New id: stringutil-replace-occurrences. Source: replace docstring, util.jl:1133-1157, with
util.jl:1053-1131 and 1183-1187: for every `AbstractString` (through its `String(s)`), every
stream type (`replace(io, ...)`), every pattern type whose `findnext` keeps its documented
contract, every `count` of any integer type: a count outside `Int` throws `InexactError`;
for `count ≥ 1` (including the default `typemax(Int)`) the stream calls are exactly the
documented scan, for both `replace(io, s, ...)` and `replace(s, ...)` (whose fresh buffer
receives them), and both return when every stream call does. `argmin` is the installed
reduce.jl model (`ArgminInstalled`; proposal R3-10 makes the field that model). -/
def ReplaceOccurrences : Prop :=
  ∀ {A Q R IO O E : Type} {t : IntTy} (liftS : Error → E)
    (liftT : JuliaLean.base.tuple.TupleError → E) (liftJ : JlError → E)
    (findnext : Q → Raw → Index → Except E (Option ReplaceSearchResult))
    (argmin : List Index → Index) (calIO : StreamCallees IO Q R IO E)
    (cal : StreamCallees IO Q R O E) (toStr : A → Except E Raw)
    (a : A) (s : Raw) (pairs : List (ReplacePair Q R)) (count : JInt t),
    ArgminInstalled argmin → (∀ q ∈ pairs, FindsForward findnext s q.pattern) →
    toStr a = .ok s →
    let opsIO := stringEngine liftS liftT liftJ findnext argmin calIO
    let ops := stringEngine liftS liftT liftJ findnext argmin cal
    (¬ fitsInt count → ∃ fn,
      (∀ io : IO, replaceIO toStr (toIndex liftJ) opsIO (io, []) a pairs count =
        some (.error (liftJ (.inexactError fn)))) ∧
      replaceString toStr (toIndex liftJ) ops a pairs count =
        some (.error (liftJ (.inexactError fn)))) ∧
    (1 ≤ count.val → count.val < 2 ^ 63 →
      (∀ (io : IO) out, replaceIO toStr (toIndex liftJ) opsIO (io, []) a pairs count =
          some (.ok out) →
        ReplaceScanEvents (occOf findnext s) s pairs (int count.val) [.whole] out.2) ∧
      (∀ out, replaceString toStr (toIndex liftJ) ops a pairs count = some (.ok out) →
        ReplaceScanEvents (occOf findnext s) s pairs (int count.val) [] out.2) ∧
      (StreamTotal calIO → ∀ io : IO, ∃ out,
        replaceIO toStr (toIndex liftJ) opsIO (io, []) a pairs count = some (.ok out)) ∧
      (StreamTotal cal → ∃ out, replaceString toStr (toIndex liftJ) ops a pairs count =
        some (.ok out)))

/-- Occurrences of one pattern as an `eachmatch`-style iterator reports them: each search
starts after the previous occurrence (after its first character when it was empty). -/
inductive MatchTrace {Q E : Type}
    (findnext : Q → Raw → Index → Except E (Option ReplaceSearchResult)) (p : Q) (s : Raw) :
    Index → List ReplaceRange → Prop where
  | nil {i : Index} : (findnext p s i).map occurrenceOf = .ok none → MatchTrace findnext p s i []
  | cons {i : Index} {r : ReplaceRange} {rest : List ReplaceRange} :
      (findnext p s i).map occurrenceOf = .ok (some r) →
      MatchTrace findnext p s
        (if r.last.val < r.first.val then r.first + int 1 else r.last + int 1) rest →
      MatchTrace findnext p s i (r :: rest)

/-- Every reported occurrence replaced, with the text between them kept. -/
def eachmatchEvents {Q R : Type} (repl : R) (p : Q) :
    Index → List ReplaceRange → List (ReplaceEvent Q R)
  | i, [] => [.rest i]
  | i, r :: rest => .keep i (r.first - i) :: .apply repl r p ::
      eachmatchEvents repl p (if r.last.val < r.first.val then r.first else r.last + int 1) rest

/-- Retained REFUTED id: regexunicode-replace-empty-after-match. Source: replace docstring,
util.jl:1136 ("replace each occurrence"), on an ASCII `String` with the installed String
methods, one pattern with the documented `findnext` contract, every stream type and a count
covering every occurrence: the claim that the stream receives every `eachmatch` occurrence.
An empty occurrence right after a nonempty one is skipped (util.jl:1075 `i <= k`). -/
def ReplaceAssemblesEachmatch : Prop :=
  ∀ {Q R IO E : Type} (liftS : Error → E) (liftT : JuliaLean.base.tuple.TupleError → E)
    (liftJ : JlError → E) (findnext : Q → Raw → Index → Except E (Option ReplaceSearchResult))
    (argmin : List Index → Index) (cal : StreamCallees IO Q R IO E) (s : Raw) (p : Q) (repl : R)
    (ms : List ReplaceRange) (count : Index) (io : IO) out,
    ArgminFirst argmin → FindsForward findnext s p → (∀ b ∈ s.bytes, b.toNat < 128) →
    MatchTrace findnext p s (int 1) ms → ms ≠ [] → Int.ofNat ms.length ≤ count.val →
    count.val < 2 ^ 63 - 1 →
    replaceIOEngine (stringEngine liftS liftT liftJ findnext argmin cal) (io, []) s
      [⟨p, repl⟩] count = some (.ok out) →
    out.2 = eachmatchEvents repl p (int 1) ms

/-! ## Padding refutations (installed statements, unchanged) -/

/-- Retained REFUTED id: strings-lpad-typemin. Source: lpad and rpad docstrings,
util.jl:494-510,547-563. -/
def LpadNoPadding : Prop :=
  ∀ {S C R O N E FS : Type} (ops : PadValueOps S C R O N E)
    (remOps : PadRemainderOps S C R FS E) (s p : PadInput S C) (n : N)
    (converted width : Index),
    ops.toInt n = .ok converted →
    ops.textwidth s = some (.ok width) →
    (ops.signed converted).val ≤ width.val →
    (lpad ops remOps s p n =
      some (do
        let stringfn ← if ← ops.isAnnotated s then pure true else ops.isAnnotated p
        ops.assemble stringfn [.value s]) ∧
    rpad ops remOps s p n =
      some (do
        let stringfn ← if ← ops.isAnnotated s then pure true else ops.isAnnotated p
        ops.assemble stringfn [.value s]))

def byteCharacters : List UInt8 → List (List UInt8)
  | [] => []
  | c :: rest =>
    let count := if 0xc0 ≤ c && c < 0xe0 then 1
      else if 0xe0 ≤ c && c < 0xf0 then 2
      else if 0xf0 ≤ c && c < 0xf8 then 3 else 0
    let continuation := (rest.take count).takeWhile (fun b => b &&& 0xc0 == 0x80)
    (c :: continuation) :: byteCharacters (rest.drop continuation.length)
termination_by bytes => bytes.length
decreasing_by
  simp_wf
  omega

def byteCharacterPairs : Index → List (List UInt8) → List (Index × List UInt8)
  | _, [] => []
  | i, c :: rest => (i, c) :: byteCharacterPairs (i + int c.length) rest

def byteTextwidth (cw : List UInt8 → Int) (s : List UInt8) : Int :=
  ((byteCharacters s).map cw).sum

def bytePadBytes : PadInput (List UInt8) (List UInt8) → List UInt8
  | .string s => s
  | .character c => c

def bytePadOps (cw : List UInt8 → Int) :
    PadValueOps (List UInt8) (List UInt8) (List UInt8) (List UInt8) Index String where
  toInt n := .ok n
  signed n := n
  textwidth
    | .string s => some (.ok (int (byteTextwidth cw s)))
    | .character c => some (.ok (int (cw c)))
  isAnnotated _ := .ok false
  repr p := .ok (toString (bytePadBytes p))
  ncodeunits p := .ok (bytePadBytes p).length
  isString
    | .string _ => true
    | .character _ => false
  codeunitIsUInt8 _ := true
  argumentError message := message
  divrem m n := if n.val = 0 then .error "DivideError"
    else .ok (int (m.val / n.val), int (m.val % n.val))
  repeatPad p n := if n.val < 0 then .error "ArgumentError"
    else .ok (.string ((List.replicate n.val.toNat (bytePadBytes p)).flatten))
  assemble _ parts := .ok (parts.flatMap (fun p => match p with
    | .value p => bytePadBytes p
    | .view v => v))

def bytePadRemainderOps (cw : List UInt8 → Int) :
    PadRemainderOps (List UInt8) (List UInt8) (List UInt8)
      (List (Index × List UInt8)) String where
  textwidthChar c := .ok (int (cw c))
  pairsFirst s := .ok (match byteCharacterPairs (int 1) (byteCharacters s) with
    | [] => none
    | p :: rest => some (p, rest))
  pairsNext _ rest := .ok (match rest with
    | [] => none
    | p :: tail => some (p, tail))
  viewPrefix s i :=
    let c := ((byteCharacterPairs (int 1) (byteCharacters s)).find?
      (fun p => p.1.val == i.val)).map Prod.snd
    .ok (s.take ((i.val - 1).toNat + (c.getD []).length))
  whole s := .ok s

def byteDenseOps : DenseStringOps (List UInt8) String where
  Ptr := List UInt8 × Index
  pointer s i := .ok (s, i)
  ncodeunits s := int s.length
  sizeof s := int s.length
  memcmp a b n := .ok (if a.take n.val.toNat = b.take n.val.toNat then 0 else 1)
  memcmpPointer := fun pointer b n =>
    match pointer with
    | (a, i) =>
      .ok (if (a.drop (i.val - 1).toNat).take n.val.toNat = b.take n.val.toNat then 0 else 1)
  nextind s i :=
    let starts := (byteCharacterPairs (int 1) (byteCharacters s)).map Prod.fst
    .ok ((starts.find? (fun start => i.val < start.val)).getD (int (s.length + 1)))
  thisind s i :=
    let starts := (byteCharacterPairs (int 1) (byteCharacters s)).map Prod.fst
    .ok ((starts.filter (fun start => start.val ≤ i.val)).getLastD (int 0))

/-! ## Hexadecimal conversion -/

/-- Mutable byte-array storage is a primitive heap. Both Julia array assignment
methods execute before the primitive memory-reference update. -/
def setByteCell (bytes : List UInt8) (index : Index) (value : UInt8) : Result (List UInt8) :=
  let bounds : Unit → Index → StateT (List UInt8) Result Unit := fun _ i => do
    let bytes ← get
    if 1 ≤ i.val ∧ i.val ≤ Int.ofNat bytes.length then pure ()
    else throw (.jl .boundsError)
  let reference : Unit → Index → Bool → StateT (List UInt8) Result Index :=
    fun _ i _ => pure i
  let store : Index → UInt8 → Bool → StateT (List UInt8) Result Unit := fun i x _ =>
    modify (fun bytes => bytes.set (i.val.toNat - 1) x)
  let operation := JuliaLean.base.array.setindexScalar (fun _ : UInt8 => true) id
    (fun c => pure c) (JuliaLean.base.array.setindexTyped bounds reference store) () value index
  (operation.run bytes).map (·.2)

/-- `Vector{UInt8}`: `length`, `eachindex` (`OneTo(length)`) and array.jl `setindex!`,
threaded through the destination state. -/
def byteArrayOps : ByteArrayOps (List UInt8) Index (List Index) Error where
  length := do pure (int (← get).length)
  eachindex := do
    let bytes ← get
    pure ((List.range bytes.length).map (fun k => int (Int.ofNat k + 1)))
  iterateIndex is st :=
    match st.getD is with
    | [] => pure none
    | i :: rest => pure (some (i, rest))
  set i v := do
    let dest ← get
    match setByteCell dest i v with
    | .ok bytes => set bytes
    | .error e => throw e

def byteIterator : HexIteratorOps (List UInt8) UInt32 UInt32 (List UInt8) Error where
  length bytes := .ok (int bytes.length)
  iterateFirst bytes := .ok (match bytes with
    | [] => none | b :: rest => some (.byte b, rest))
  iterateNext _ rest := .ok (match rest with
    | [] => none | b :: tail => some (.byte b, tail))
def assertHexTuple {A C State : Type} (p : Option (HexDigit A C × State)) :
    Result (HexDigit A C × State) :=
  match p with
  | some p => .ok p
  | none => .error (.jl (.methodError "tuple assertion"))

def liftChar {A : Type} (bits : UInt32) : JuliaLean.base.char.CharResult A → Result A
  | .ok a => .ok a
  | .error (.invalidChar _) => .error (.invalidChar bits)
  | .error (.codePointError _) => .error (.codePointError bits)
  | .error (.unicodeError _) => .error (.invalidChar bits)
  | .error .boundsError => .error (.jl .boundsError)
  | .error (.foreign e) => .error (.jl e)
  | .error (.showError error) => .error (.showError error)

/-- `UInt8(c::Char)` (char.jl), the installed conversion. -/
def charByte (c : UInt32) : Result UInt8 :=
  liftChar c (JuliaLean.base.char.smallIntegerFromChar
    (fun c => Int32.ofInt (BitVec.ofNat 32 c.toNat).toInt)
    (fun i => i ≥ 0) (fun i => Int32.ofInt (i.toUInt32 >>> 24).toNat)
    (fun i => .ok (UInt8.ofNat i.toUInt32.toNat))
    (fun c =>
      match JuliaLean.base.int.convert .u8 (JInt.lit .u32 c.toNat) with
      | .ok b => .ok (UInt8.ofNat b.val.toNat)
      | .error e => .error (.foreign e))
    JuliaLean.base.char.charBitOps c)

/-- `Char(c::Char) = c`. -/
def sameChar (c : UInt32) : Result UInt32 :=
  .ok (JuliaLean.base.char.constructor_Same_AbstractChar c)

def hexNibble (c : UInt8) : Option Nat :=
  if 0x30 ≤ c.toNat ∧ c.toNat ≤ 0x39 then some (c.toNat - 0x30)
  else if 0x41 ≤ c.toNat ∧ c.toNat ≤ 0x46 then some (c.toNat - 0x37)
  else if 0x61 ≤ c.toNat ∧ c.toNat ≤ 0x66 then some (c.toNat - 0x57)
  else none

/-- Independent base-16 digit-pair specification, including odd and invalid input. -/
def hexadecimalValue : List UInt8 → Option (List UInt8)
  | [] => some []
  | [_] => none
  | a :: b :: rest => do
    let hi ← hexNibble a
    let lo ← hexNibble b
    let tail ← hexadecimalValue rest
    return UInt8.ofNat (16 * hi + lo) :: tail

/-- Decoded bytes of the longest valid prefix of digit pairs, and whether a later pair
(within an even-length input) is invalid. -/
def decodePairs : List UInt8 → List UInt8 × Bool
  | a :: b :: rest =>
    match hexNibble a, hexNibble b with
    | some hi, some lo =>
      let (bs, failed) := decodePairs rest
      (UInt8.ofNat (16 * hi + lo) :: bs, failed)
    | _, _ => ([], true)
  | _ => ([], false)

def argumentFailure {A : Type} (r : Result A) : Prop :=
  ∃ message, r = .error (.jl (.argumentError message))

def argumentFailureOpt {A : Type} (r : Option (Result A)) : Prop :=
  ∃ message, r = some (.error (.jl (.argumentError message)))

/-- An in-place call failed with `ArgumentError`, leaving destination state `d`. -/
def argumentFailureAt {Array : Type} (r : Option (EStateM.Result Error Array Array)) (d : Array) : Prop :=
  ∃ message, r = some (.error (.jl (.argumentError message)) d)

/-- The code unit `number_from_hex` inspects for each element: a `UInt8` element itself, or
`UInt8(Char(c))` of a character element through the installed conversions. -/
def digitCode {A : Type} (toChar : A → Result UInt32) : HexDigit A UInt32 → Result UInt8
  | .byte b => .ok b
  | .abstractChar a => do charByte (← toChar a)

/-- Character elements are ASCII (the non-ASCII case is the refuted
stringutil-hex2bytes-nonascii); byte elements are unrestricted. -/
def AsciiDigits {A : Type} (toChar : A → Result UInt32) (digits : List (HexDigit A UInt32)) : Prop :=
  ∀ d ∈ digits, ∀ a, d = .abstractChar a → ∃ u : UInt32, toChar a = .ok u ∧ u.toNat < 0x80000000

/-- Successive `dest[i] = x` assignments over `zip(eachindex(dest), xs)`, through the
array's own `setindex!`. -/
def writesM {Array I IS E : Type} (arr : ByteArrayOps Array I IS E) (idx : List I) (xs : List UInt8) :
    EStateM E Array Unit :=
  (idx.zip xs).forM (fun (i, x) => arr.set i x)

/-- A generic hex digit iterator: a user iterator over `UInt8` or `AbstractChar` elements. -/
structure HexInput {Itr A St : Type} (it : HexIteratorOps Itr A UInt32 St Error)
    (toChar : A → Result UInt32) (itr : Itr) (digits : List (HexDigit A UInt32))
    (codes : List UInt8) : Prop where
  iterates : Iterates it.iterateFirst it.iterateNext itr digits
  length : it.length itr = .ok (int digits.length)
  converts : digits.mapM (digitCode toChar) = .ok codes
  ascii : AsciiDigits toChar digits
  small : digits.length < 2 ^ 62
/-- id: stringscova-util-hex2bytes-bang-iterator-rebuilt. Source: hex2bytes! docstring
and validation, util.jl:1251-1274, for every user iterator and every `AbstractArray{UInt8}`
destination: length errors leave the destination untouched, digit pairs are written in
order through the array's own `setindex!`, and an invalid pair throws after exactly the
earlier writes. The only array law is the documented `length(dest)` of `eachindex(dest)`, with
`length(dest)` and `eachindex(dest)` keeping the array and the index iteration independent of it
(as for a pure `eachindex`); the odd-length check runs before either is called. -/
def HexDecodeLengths : Prop :=
  ∀ {Array I IS Itr A St : Type} (arr : ByteArrayOps Array I IS Error)
    (it : HexIteratorOps Itr A UInt32 St Error) (toChar : A → Result UInt32) (dest : Array)
    (itr : Itr) (digits : List (HexDigit A UInt32)) (codes : List UInt8)
    (destLen : Index) (idxs : List I),
    HexInput it toChar itr digits codes →
    arr.length.run dest = .ok destLen dest →
    PureIndices arr dest idxs → idxs.length = destLen.val.toNat →
    0 ≤ destLen.val → destLen.val < 2 ^ 62 →
    let r := hex2bytesBang arr it assertHexTuple (.jl ∘ JlError.argumentError) toChar charByte
      true dest itr
    (digits.length % 2 ≠ 0 → argumentFailureAt r dest) ∧
    (digits.length % 2 = 0 → 2 * destLen.val ≠ Int.ofNat digits.length →
      argumentFailureAt r dest) ∧
    (2 * destLen.val = Int.ofNat digits.length →
      match (writesM arr idxs (decodePairs codes).1).run dest with
      | .ok _ d => ((decodePairs codes).2 = false → r = some (.ok d d)) ∧
          ((decodePairs codes).2 = true → argumentFailureAt r d)
      | .error e d => r = some (.error e d))

/-- `hex2bytes(s) = hex2bytes!(Vector{UInt8}(undef, length(s) >> 1), s)` for a user
iterator (util.jl:1237). `Vector{UInt8}(undef, n)` (runtime `jl_alloc_array`, no Lean model)
is the parameter `alloc`; its initial contents are arbitrary. -/
def allocatingDecodeG {Itr A St : Type} (alloc : Index → Result (List UInt8))
    (it : HexIteratorOps Itr A UInt32 St Error)
    (toChar : A → Result UInt32) (itr : Itr) : Option (Result (List UInt8)) :=
  match it.length itr with
  | .error e => some (.error e)
  | .ok len =>
    hex2bytesWrapper (fun _ => len) (fun n => JuliaLean.base.int.shr_Int n (int 1)) alloc
      (fun dest itr => hex2bytesBang byteArrayOps it assertHexTuple (.jl ∘ JlError.argumentError)
        toChar charByte true dest itr) itr
def lowerHex (bytes : List UInt8) : List UInt8 :=
  bytes.flatMap (fun b =>
    [UInt8.ofNat (if b.toNat / 16 < 10 then 0x30 + b.toNat / 16 else 0x61 + b.toNat / 16 - 10),
     UInt8.ofNat (if b.toNat % 16 < 10 then 0x30 + b.toNat % 16 else 0x61 + b.toNat % 16 - 10)])

/-- id: stringutil-hex-decoder-roundtrip. Source: inverse examples, util.jl:1189-1327:
for every user iterator yielding the lowercase digits of `bytes` (as `UInt8` or as `Char`),
`hex2bytes!` into a `Vector{UInt8}` of the right length restores exactly `bytes`. -/
def HexDecodeRoundtrip : Prop :=
  ∀ {Itr A St : Type} (it : HexIteratorOps Itr A UInt32 St Error) (toChar : A → Result UInt32)
    (itr : Itr) (digits : List (HexDigit A UInt32)) (bytes dest : List UInt8),
    HexInput it toChar itr digits (lowerHex bytes) → dest.length = bytes.length →
    hex2bytesBang byteArrayOps it assertHexTuple (.jl ∘ JlError.argumentError) toChar charByte
      true dest itr = some (.ok bytes bytes)

def decodeStringIntoG {Array I IS : Type} (arr : ByteArrayOps Array I IS Error) (dest : Array) (s : Raw) :
    Option (EStateM.Result Error Array Array) :=
  hex2bytesString arr byteIterator assertHexTuple (.jl ∘ JlError.argumentError)
    sameChar charByte Str.stringNcodeunits JuliaLean.base.strings.string.stringLength
    (JuliaLean.base.strings.cstring.transcodeStringCodeUnits (T := UInt8) (fun s => s.bytes))
    true dest s

/-- id: stringutil-hex-string-decoder. Source: util.jl:1240-1244 with 1251-1274, for every
`AbstractArray{UInt8}` destination: a code-unit/character count mismatch throws
`ArgumentError` with the destination untouched; otherwise the bytes are decoded in place
through the array's own `setindex!` (with earlier writes kept on a later invalid digit),
and a `Vector{UInt8}` destination ends equal to the decoded bytes. -/
def HexStringDecode : Prop :=
  (∀ {Array I IS : Type} (arr : ByteArrayOps Array I IS Error) (dest : Array) (s : Raw)
      (destLen : Index) (idxs : List I),
    arr.length.run dest = .ok destLen dest →
    PureIndices arr dest idxs → idxs.length = destLen.val.toNat →
    0 ≤ destLen.val → destLen.val < 2 ^ 62 →
    ((JuliaLean.base.strings.string.stringLength s).val ≠ (Str.stringNcodeunits s).val →
      argumentFailureAt (decodeStringIntoG arr dest s) dest) ∧
    ((JuliaLean.base.strings.string.stringLength s).val = (Str.stringNcodeunits s).val →
      2 * destLen.val = Int.ofNat s.bytes.length →
      match (writesM arr idxs (decodePairs s.bytes).1).run dest with
      | .ok _ d => ((decodePairs s.bytes).2 = false → decodeStringIntoG arr dest s = some (.ok d d)) ∧
          ((decodePairs s.bytes).2 = true → argumentFailureAt (decodeStringIntoG arr dest s) d)
      | .error e d => decodeStringIntoG arr dest s = some (.error e d))) ∧
  (∀ (s : Raw) (dest expected : List UInt8),
    (∀ b ∈ s.bytes, b.toNat < 128) → 2 * dest.length = s.bytes.length →
    hexadecimalValue s.bytes = some expected →
    decodeStringIntoG byteArrayOps dest s = some (.ok expected expected))

/-- `hex2bytes(s::String)`: util.jl:1237, then the `String` method of `hex2bytes!`
(util.jl:1240-1244), with the same allocation parameter. -/
def hexStringCallWith (alloc : Index → Result (List UInt8)) (s : Raw) : Option (Result (List UInt8)) :=
  hex2bytesWrapper JuliaLean.base.strings.string.stringLength
    (fun n => JuliaLean.base.int.shr_Int n (int 1)) alloc (decodeStringIntoG byteArrayOps) s

/-- id: stringutil-hex2bytes-ascii. Source: hex2bytes docstring, util.jl:1194-1202, for every
outcome of `Vector{UInt8}(undef, n)` (`alloc`, runtime `jl_alloc_array_1d`, no Lean model) at
the `n = length(s) >> 1` the method computes: an allocation exception propagates; an array
of `n` elements leads to (1) for every user iterator whose elements are `UInt8` codes or
ASCII `AbstractChar`s (the non-ASCII character case is the refuted
stringutil-hex2bytes-nonascii) the generic path, where each digit pair, in either case,
gives one byte, and odd lengths or invalid digits throw `ArgumentError`; (2) for every
`String` its own `hex2bytes!` method (util.jl:1240), with the same result on its code units. -/
def Hex2bytesAsciiContract : Prop :=
  ∀ (alloc : Index → Result (List UInt8)),
    (∀ {Itr A St : Type} (it : HexIteratorOps Itr A UInt32 St Error)
      (toChar : A → Result UInt32) (itr : Itr) (digits : List (HexDigit A UInt32))
      (codes : List UInt8),
      HexInput it toChar itr digits codes →
      let n := JuliaLean.base.int.shr_Int (int digits.length) (int 1)
      (∀ e, alloc n = .error e → allocatingDecodeG alloc it toChar itr = some (.error e)) ∧
      (∀ d, alloc n = .ok d → d.length = n.val.toNat →
        match hexadecimalValue codes with
        | none => argumentFailureOpt (allocatingDecodeG alloc it toChar itr)
        | some expected => allocatingDecodeG alloc it toChar itr = some (.ok expected))) ∧
    (∀ s : Raw,
      let n := JuliaLean.base.int.shr_Int (JuliaLean.base.strings.string.stringLength s) (int 1)
      (∀ e, alloc n = .error e → hexStringCallWith alloc s = some (.error e)) ∧
      (∀ d, alloc n = .ok d → d.length = n.val.toNat →
        match hexadecimalValue s.bytes with
        | none => argumentFailureOpt (hexStringCallWith alloc s)
        | some expected => hexStringCallWith alloc s = some (.ok expected)))

def byteCodec : JuliaLean.base.pointer.ByteCodec JuliaLean.base.pointer.Byte where
  elementSize := int 1
  size_nonnegative := by decide
  encode b := [b]
  decode bs := bs.getD 0 (JInt.lit .u8 0)
  encode_length _ := rfl
  decode_encode _ := rfl

/-- A String allocation and its mutable construction-time heap. -/
abbrev HexStorage := Raw × JuliaLean.base.pointer.ByteHeap

def allocateString (n : Nat) : Result Raw :=
  if h : n < 2 ^ 62 then
    .ok ⟨List.replicate n 0, by simpa using h⟩
  else .error .outOfMemory

def allocateHexStorage (n : Index) : Result HexStorage := do
  let str ← JuliaLean.base.strings.string.stringN
    (fun n : Index => .ok (JInt.rem .u64 n).val.toNat) allocateString n
  return (str, { byteAt := fun _ => JInt.lit .u8 0, validByte := fun _ => true })

def storedBytes (s : HexStorage) : List UInt8 :=
  (s.2.readBytes 0 s.1.bytes.length).map (fun b => UInt8.ofNat b.val.toNat)

def storeHexDigit (s : HexStorage) (p : JuliaLean.base.pointer.Ptr JuliaLean.base.pointer.Byte)
    (b : UInt8) (i : Index) : Result HexStorage :=
  match h : JuliaLean.base.pointer.unsafeStoreTyped byteCodec
      (fun b : UInt8 => .ok (JInt.lit .u8 b.toNat)) (fun i : Index => .ok i)
      p s.2 b i with
  | .ok (heap, _) => .ok (s.1, heap)
  | .error _ => absurd h (by
      simp [JuliaLean.base.pointer.unsafeStoreTyped, bind, Except.bind, pure, Except.pure])

/-- `bytes2hex(itr)` on a `Vector{UInt8}`, or on another iterator whose `eltype` is not
`UInt8` (`isUInt8`). -/
def encodingOps (isUInt8 : Bool) : Bytes2HexOps (List UInt8) Unit HexStorage
    (JuliaLean.base.pointer.Ptr JuliaLean.base.pointer.Byte) Error where
  isUInt8Iterator _ := isUInt8
  length bytes := int bytes.length
  allocate := allocateHexStorage
  pointer s := ⟨JInt.lit .u64 (JuliaLean.base.strings.string.pointerString
    (fun _ => 0) s.1)⟩
  enumerate bytes := iterStepsOfList () ((bytes.zipIdx).map
    (fun (b, i) => (int (Int.ofNat i + 1), b)))
  hexChar i := JuliaLean.base.char.hex_chars.getD (i.val.toNat - 1) 0
  store := storeHexDigit
  argumentError message := .jl (.argumentError message)

/-- `Base._string_n(n)` (string.jl:184-185, installed `stringN`): `convert(Csize_t, n)`
(`InexactError` for negative `n`), then the runtime `jl_alloc_string` (`allocString`, no
Lean model; its contents are arbitrary). -/
def allocateHexStorageWith (allocString : Nat → Result Raw) (n : Index) : Result HexStorage := do
  let str ← JuliaLean.base.strings.string.stringN
    (fun n : Index => match JInt.convert (IntTy.u64.name) .u64 n.val with
      | .ok m => .ok m.val.toNat
      | .error e => .error (.jl e)) allocString n
  return (str, { byteAt := fun _ => JInt.lit .u8 0, validByte := fun _ => true })

def encodingOpsWith (isUInt8 : Bool) (allocString : Nat → Result Raw) :
    Bytes2HexOps (List UInt8) Unit HexStorage
      (JuliaLean.base.pointer.Ptr JuliaLean.base.pointer.Byte) Error :=
  { encodingOps isUInt8 with allocate := allocateHexStorageWith allocString }

/-- id: stringutil-bytes2hex-encoding. Source: bytes2hex docstring, util.jl:1287-1327, for
every `Vector{UInt8}` and every outcome of `jl_alloc_string` for the `2 * length(itr)` code
units: a String of that size receives every byte's two lowercase digits in order; an
allocation exception propagates unchanged; when `2 * length(itr)` wraps negative,
`convert(Csize_t, ·)` throws `InexactError`; a non-`UInt8` eltype throws `ArgumentError`.
Other iterators need R3-13 (`enumerate` over the iterator's own `iterate`). -/
def Bytes2hexEncoding : Prop :=
  ∀ (allocString : Nat → Result Raw) (bytes : List UInt8),
    let ops := encodingOpsWith true allocString
    (bytes.length < 2 ^ 62 →
      (∀ str, allocString (2 * bytes.length) = .ok str → str.bytes.length = 2 * bytes.length →
        ∃ out, bytes2hex ops bytes = .ok out ∧ storedBytes out = lowerHex bytes) ∧
      (∀ e, allocString (2 * bytes.length) = .error e → bytes2hex ops bytes = .error e)) ∧
    (2 ^ 62 ≤ bytes.length → bytes.length < 2 ^ 63 →
      ∃ fn, bytes2hex ops bytes = .error (.jl (.inexactError fn))) ∧
    argumentFailure (bytes2hex (encodingOpsWith false allocString) bytes)

/-- id: stringutil-bytes2hex-lowercase. Source: bytes2hex docstring, util.jl:1287-1327. For every
`Vector{UInt8}` and every `jl_alloc_string` (`allocString`, arbitrary contents of the requested
size, or an exception): whenever `bytes2hex` returns, its String has two characters per byte,
each a digit `0-9` or a lowercase letter `a-f`. -/
def Bytes2hexLowercase : Prop :=
  ∀ (allocString : Nat → Result Raw) (bytes : List UInt8) (out : HexStorage),
    (∀ n str, allocString n = .ok str → str.bytes.length = n) →
    bytes2hex (encodingOpsWith true allocString) bytes = .ok out →
    (storedBytes out).length = 2 * bytes.length ∧
    (∀ digit ∈ storedBytes out,
      0x30 ≤ digit.toNat ∧ digit.toNat ≤ 0x39 ∨ 0x61 ≤ digit.toNat ∧ digit.toNat ≤ 0x66)

/-- id: stringutil-hex-roundtrip. Source: inverse examples, util.jl:1189-1327. For every
`Vector{UInt8}`, every `jl_alloc_string` outcome in `bytes2hex` and every
`Vector{UInt8}(undef, n)` outcome in `hex2bytes`: when `bytes2hex` returns a String, the
`hex2bytes(::String)` path (util.jl:1237, 1240-1244: validation, `transcode`, `hex2bytes!`)
on it returns the original bytes, unless its allocation throws, which then propagates. -/
def HexRoundtrip : Prop :=
  ∀ (allocString : Nat → Result Raw) (alloc : Index → Result (List UInt8)) (bytes : List UInt8)
    (out : HexStorage) (str : Raw),
    (∀ n s, allocString n = .ok s → s.bytes.length = n) →
    bytes2hex (encodingOpsWith true allocString) bytes = .ok out → str.bytes = storedBytes out →
    let n := JuliaLean.base.int.shr_Int (JuliaLean.base.strings.string.stringLength str) (int 1)
    (∀ e, alloc n = .error e → hexStringCallWith alloc str = some (.error e)) ∧
    (∀ d, alloc n = .ok d → d.length = n.val.toNat → hexStringCallWith alloc str = some (.ok bytes))

/-- `Char(b::UInt8)` (char.jl:229-231) is the installed `char_SmallInteger` with `0 ≤ b ≤ 0x7f`,
`b % UInt32` and `UInt32(b)`. util's `bytes2hex(io, itr)` model takes it as a total field
`UInt8 → UInt32` (accepted proposal R3-6 makes it `CharResult`), so the statements quantify
that field and require only that it returns what the installed method returns whenever that
returns; nothing is assumed where the installed method throws. -/
def CharOfByteInstalled (charOfByte : UInt8 → UInt32) : Prop :=
  ∀ (b : UInt8) (c : UInt32),
    JuliaLean.base.char.char_SmallInteger (fun b : UInt8 => decide (b.toNat ≤ 0x7f))
      (fun b => b.toUInt32) (fun b => .ok b.toUInt32) b = .ok c → charOfByte b = c

/-- `print(io, c1, c2)` (strings/io.jl:42-54, installed `printValues` of two installed
`print(io, ::Char)` calls) on a user `IO` type described by its own stream methods `ops`
(`lock`, `unlock`, `write(io, ::UInt8)`). -/
def printDigitPair {E IO : Type} [MonadExceptOf JuliaLean.base.show.ShowError (StateT IO (ExceptT E Id))]
    (ops : JuliaLean.base.strings.io.CharIO (StateT IO (ExceptT E Id)) Unit Unit) (io : IO)
    (c1 c2 : UInt32) : Except E IO :=
  ((JuliaLean.base.strings.io.printValues ops.prims (.plain ())
    [JuliaLean.base.strings.io.printChar ops (.plain ()) c1,
     JuliaLean.base.strings.io.printChar ops (.plain ()) c2]).run io).run.map Prod.snd

/-- The lowercase digit characters of each byte printed in order, stopping at the first
exception. -/
def printDigitsOf {E IO : Type} [MonadExceptOf JuliaLean.base.show.ShowError (StateT IO (ExceptT E Id))]
    (ops : JuliaLean.base.strings.io.CharIO (StateT IO (ExceptT E Id)) Unit Unit)
    (charOfByte : UInt8 → UInt32) (bytes : List UInt8) (io : IO) : Except E IO :=
  bytes.foldlM (fun io b => match lowerHex [b] with
    | [d1, d2] => printDigitPair ops io (charOfByte d1) (charOfByte d2)
    | _ => .ok io) io

/-- A byte iteration that yields `bytes` and then throws `e`. -/
inductive StepsFail {St E : Type} : IterSteps UInt8 St E → List UInt8 → E → Prop where
  | fail {e : E} : StepsFail (.fail e) [] e
  | yield {b : UInt8} {st : St} {next : St → IterSteps UInt8 St E} {bs : List UInt8} {e : E} :
      StepsFail (next st) bs e → StepsFail (.yield b st next) (b :: bs) e

/-- id: stringutil-bytes2hex-io-characters. Source: bytes2hex docstring, util.jl:1287-1334:
for every `Char(::UInt8)` field agreeing with the installed char.jl method (`CharOfByteInstalled`),
(1) on every `IO` type (its own `lock`, `unlock` and character printing, through the installed
`print(io, xs...)`) and every error type `E` embedding the installed `IOErr` by `emb`,
`bytes2hex(io, itr)` prints the two lowercase digit characters of each byte in order; an
exception from `print` stops it, an exception from the iterator propagates after the earlier
bytes were printed, and a non-`UInt8` eltype throws
`ArgumentError("eltype of iterator not UInt8")`; (2) on an `IOBuffer` (installed
`print(::IOBuffer, ::Char)`) exactly those digits are appended after the existing contents.
Iterators are the model's finite `IterSteps` (R3-13). -/
def installedHexChar (i : Index) : UInt8 :=
  JuliaLean.base.char.hex_chars.getD (i.val.toNat - 1) 0

def Bytes2hexIOCharacters : Prop :=
  (∀ {IO St E : Type} [MonadExceptOf JuliaLean.base.show.ShowError (StateT IO (ExceptT E Id))]
    (ops : JuliaLean.base.strings.io.CharIO (StateT IO (ExceptT E Id)) Unit Unit)
      (emb : JuliaLean.base.iobuffer.IOErr → E) (charOfByte : UInt8 → UInt32)
      (steps : IterSteps UInt8 St E) (io : IO),
    CharOfByteInstalled charOfByte →
    let call := fun (isUInt8 : Bool) =>
      bytes2hexIO (fun _ : Unit => steps) (fun _ => isUInt8) installedHexChar charOfByte
        (printDigitPair ops) (fun m => emb (.jl (.argumentError m))) io ()
    (∀ bytes, collectIterSteps steps = .ok bytes →
      call true = printDigitsOf ops charOfByte bytes io) ∧
    (∀ bytes e, StepsFail steps bytes e →
      call true = (printDigitsOf ops charOfByte bytes io).bind (fun _ => .error e)) ∧
    call false = .error (emb (.jl (.argumentError "eltype of iterator not UInt8")))) ∧
  (∀ {St : Type} (charOfByte : UInt8 → UInt32)
      (steps : IterSteps UInt8 St StreamError) (bytes before : List UInt8),
    CharOfByteInstalled charOfByte →
    collectIterSteps steps = .ok bytes →
    before.length + 2 * bytes.length ≤ JuliaLean.IntTy.i64.max.toNat →
    (do
      let io ← JuliaLean.base.strings.io.newBufferState
        (JuliaLean.base.iobuffer.bitsConversions .i64) none
      let (io, _) ← JuliaLean.base.strings.io.writeBytesBufferState io before
      let io ← bytes2hexIO (fun _ : Unit => steps) (fun _ => true) installedHexChar charOfByte
        JuliaLean.base.strings.io.printTwoCharsBufferState
        (fun m => .jl (.argumentError m)) io ()
      JuliaLean.base.strings.io.takeStringBufferState io) =
        .ok (before ++ lowerHexBytes bytes))

/-! ## Stream prefixes -/

def streamRun {A : Type} (m : JuliaLean.base.iobuffer.M A) (io : Stream) :
    Except StreamError (A × Stream) :=
  match m.run io with
  | .ok a io => .ok (a, io)
  | .error e _ => .error e

/-- `read(io, Char)` has no installed Base model. Only that external callee is
a parameter. Mark, reset, and fixed-length byte reading use their installed models. -/
def prefixStreamOps (readChar : Stream → Except StreamError (UInt32 × Stream)) :
    PrefixIOOps Stream UInt32 StreamError where
  mark io := (streamRun JuliaLean.base.iobuffer.mark io).map (·.2)
  reset io := (streamRun JuliaLean.base.iobuffer.reset io).map (·.2)
  readChar := readChar
  readBytes io n := streamRun
    (JuliaLean.base.iobuffer.source_read_n JuliaLean.base.iobuffer.bufferAccess
      (fun n available => JuliaLean.base.iobuffer.lift (JuliaLean.base.iobuffer.toI (min n available.val)))
      (fun n => JuliaLean.base.iobuffer.lift (JuliaLean.base.iobuffer.stringVectorBytes n.val))
      (fun _ data => JuliaLean.base.iobuffer.readBang data.length) () n.val) io

def readableStream (before unread : List UInt8) : Stream :=
  { JuliaLean.base.iobuffer.newBuf (before ++ unread) true true false true false
      JuliaLean.base.iobuffer.imaxval with ptr := int (Int.ofNat before.length + 1) }

/-- Vector/CodeUnits equality executes the installed generic array-equality loop. -/
def equalByteVectors (a b : List UInt8) : Bool :=
  let comparison : Id (Option Bool) := JuliaLean.base.abstractarray.arrayEqual
    (fun bytes : List UInt8 => pure bytes.length)
    (fun bytes : List UInt8 => pure bytes.length)
    (fun a b : List UInt8 => pure (a.zip b))
    (fun a b : UInt8 => pure (JuliaLean.base.int.eq_int
      (JInt.lit .u8 a.toNat) (JInt.lit .u8 b.toNat)))
    (fun _ => false) (fun eq => pure (!eq)) a b
  match (comparison : Option Bool) with
  | some true => true
  | _ => false

/-- Homogeneous Julia tuples use the installed recursive tuple-membership method. -/
def charTuple : (cs : List UInt32) →
    JuliaLean.base.operators.HTuple (fun _ : Unit => UInt32) (cs.map (fun _ => ()))
  | [] => .nil
  | c :: cs => .cons c (charTuple cs)

def memberChar (c : UInt32) (cs : List UInt32) : Bool :=
  match JuliaLean.base.operators.inTuple
    (fun {t : Unit} (a : UInt32) (b : UInt32) =>
      if JuliaLean.base.char.eq_Char a b then .true else .false) c (charTuple cs) with
  | .true => true
  | _ => false

/-- The first character of a byte sequence by the installed `String` iterator, with the
number of bytes it occupies. -/
def firstCharOf (bytes : List UInt8) : Option (UInt32 × Nat) :=
  if h : bytes.length < 2 ^ 62 then
    match Str.stringIterate (⟨bytes, h⟩ : Raw) (int 1) with
    | none => none
    | some (c, next) => some (c, (next.val - 1).toNat)
  else none

/-- Documented stream interface of a user `IO` type (`mark`, `reset`, `read(io, nb)`,
`read(io, Char)` docstrings): `unread io` observes the bytes after the current position
and `marked io` the bytes after the mark, if any. -/
structure StreamLaws {X E : Type} (ops : PrefixIOOps X UInt32 E) (eofError : E)
    (unread : X → List UInt8) (marked : X → Option (List UInt8)) : Prop where
  mark : ∀ io, ∃ io', ops.mark io = .ok io' ∧ unread io' = unread io ∧
    marked io' = some (unread io)
  readBytes : ∀ io (n : Index), 0 ≤ n.val → ∃ io',
    ops.readBytes io n = .ok ((unread io).take n.val.toNat, io') ∧
    unread io' = (unread io).drop n.val.toNat ∧ marked io' = marked io
  readChar : ∀ io, match firstCharOf (unread io) with
    | none => ops.readChar io = .error eofError
    | some (c, k) => ∃ io', ops.readChar io = .ok (c, io') ∧
        unread io' = (unread io).drop k ∧ marked io' = marked io
  reset : ∀ io u, marked io = some u → ∃ io', ops.reset io = .ok io' ∧ unread io' = u ∧
    marked io' = none

/-- id: stringutil-startswith-io-peek. Source: startswith(io, prefix), util.jl:87-104:
the next unread bytes are compared with the prefix's code units and the position is
restored, for every `String`/`SubString{String}` prefix, on an `IOBuffer` (installed
mark/read/reset) and on every user `IO` type satisfying the documented stream interface. -/
def StartswithIoPeek : Prop :=
  (∀ (readChar : Stream → Except StreamError (UInt32 × Stream))
    (before unread : List UInt8) (pre : Prepared),
    DenseArg pre → before.length + unread.length < 2 ^ 62 →
    ∃ out, startswithIOUTF8 (prefixStreamOps readChar) (fun p => p.view.ncodeunits) preparedBytes
      equalByteVectors (readableStream before unread) pre =
        .ok ((preparedBytes pre).isPrefixOf unread, out) ∧
      out.ptr = (readableStream before unread).ptr ∧ out.data = before ++ unread ∧
      out.mark.val = -1) ∧
  (∀ {X E : Type} (ops : PrefixIOOps X UInt32 E) (eofError : E) (unread : X → List UInt8)
    (marked : X → Option (List UInt8)) (io : X) (pre : Prepared),
    StreamLaws ops eofError unread marked → DenseArg pre →
    ∃ out, startswithIOUTF8 ops (fun p => p.view.ncodeunits) preparedBytes equalByteVectors io pre =
        .ok ((preparedBytes pre).isPrefixOf (unread io), out) ∧
      unread out = unread io ∧ marked out = none)

/-- Only the absent `read(io, Char)` callee receives a law for the `IOBuffer` case. Its
character is identified independently by the installed String iterator on the unread
bytes. The law says nothing about startswith, membership, mark, or reset. -/
def CharacterReadLaw (readChar : Stream → Except StreamError (UInt32 × Stream)) : Prop :=
  ∀ (before unread : List UInt8) (hsize : before.length + unread.length < 2 ^ 62),
    let input := { readableStream before unread with mark := int before.length }
    let raw : Raw := ⟨unread, by omega⟩
    readChar input =
      match Str.stringIterate raw (int 1) with
      | none => .error .eofError
      | some (c, next) =>
        .ok (c, { input with ptr := int (Int.ofNat before.length + next.val) })

/-- id: stringutil-startswith-io-mark. Source: util.jl:87-104: the next character is
tested against any `Chars` collection (its own `in`, universally quantified) and the
position restored, on an `IOBuffer` and on every lawful user `IO` type; plus the prefix
statement. -/
def StartswithIoChecks : Prop :=
  StartswithIoPeek ∧
  (∀ (readChar : Stream → Except StreamError (UInt32 × Stream)) {Q : Type}
    (member : UInt32 → Q → Bool),
    CharacterReadLaw readChar →
    ∀ (before unread : List UInt8) (set : Q) (hsize : before.length + unread.length < 2 ^ 62),
      let raw : Raw := ⟨unread, by omega⟩
      match Str.stringIterate raw (int 1) with
      | none =>
        startswithIOChars (prefixStreamOps readChar)
          (fun c q => pure (truth (member c q))) (readableStream before unread) set =
            ExceptT.mk (some (.error .eofError))
      | some (c, _) =>
        ∃ out, startswithIOChars (prefixStreamOps readChar)
          (fun c q => pure (truth (member c q))) (readableStream before unread) set =
            ExceptT.mk (some (.ok (truth (member c set), out))) ∧
          out.ptr = (readableStream before unread).ptr ∧
          out.data = before ++ unread ∧ out.mark.val = -1) ∧
  (∀ {X E Q : Type} (ops : PrefixIOOps X UInt32 E) (eofError : E) (unread : X → List UInt8)
    (marked : X → Option (List UInt8)) (member : UInt32 → Q → Bool) (io : X) (set : Q),
    StreamLaws ops eofError unread marked →
    match firstCharOf (unread io) with
    | none => startswithIOChars ops (fun c q => pure (truth (member c q))) io set =
        ExceptT.mk (some (.error eofError))
    | some (c, _) => ∃ out, startswithIOChars ops (fun c q => pure (truth (member c q))) io set =
        ExceptT.mk (some (.ok (truth (member c set), out))) ∧
        unread out = unread io ∧ marked out = none)

/-! ## `Base.rest` for generic strings -/

def liftJIO {A : Type} : Jl A → Except StreamError A
  | .ok a => .ok a
  | .error e => .error (.jl e)

/-- `Base.rest(s, st)` for a string whose elements are `Char`: `Iterators.rest(s, st)`
(iterators.jl:697), its `iterate` (iterators.jl:743-746) over the string's own `iterate`,
`IOBuffer()`, `print(::IOBuffer, ::Char)` (char.jl:305) and `takestring!` (installed
strings/io BufferState methods). Other `AbstractChar` element types print through
`print(io, Char(c))` (char.jl:306), whose installed error type `PrintError` lives in `Type 1`
and cannot instantiate util.lean `RestOps` (proposal R6-9). -/
def restOps {S R CU CT : Type} (prim : StringOps S R UInt32 CU CT JlError) :
    RestOps S (JuliaLean.base.iterators.Rest S Index) Index Index UInt32 Stream (List UInt8)
      StreamError where
  restIterator s st := .ok (JuliaLean.base.iterators.restWithState s st)
  iterateFirst r := liftJIO (((JuliaLean.base.iterators.iterateRest
    (fun s st heap => some ((match st with
      | none => prim.iterateFirst s
      | some i => prim.iterateAt s i), heap)) r none ()).get
        (by simp [JuliaLean.base.iterators.iterateRest])).1)
  iterateNext r st := liftJIO (((JuliaLean.base.iterators.iterateRest
    (fun s st heap => some ((match st with
      | none => prim.iterateFirst s
      | some i => prim.iterateAt s i), heap)) r (some st) ()).get
        (by simp [JuliaLean.base.iterators.iterateRest])).1)
  newIOBuffer := JuliaLean.base.strings.io.newBufferState
    (JuliaLean.base.iobuffer.bitsConversions .i64) none
  print := JuliaLean.base.strings.io.printCharBufferState
  takeString := JuliaLean.base.strings.io.takeStringBufferState

/-- `Base.rest(s)` with no state: `Iterators.rest(s) = s` (iterators.jl `rest(itr) = itr`,
installed `restIdentity`), iterated with the string's own `iterate`. -/
def restOpsNoState {S R CU CT : Type} (prim : StringOps S R UInt32 CU CT JlError) :
    RestOps S S Unit Index UInt32 Stream (List UInt8) StreamError where
  restIterator s _ := .ok (JuliaLean.base.iterators.restIdentity s)
  iterateFirst s := liftJIO (prim.iterateFirst s)
  iterateNext s i := liftJIO (prim.iterateAt s i)
  newIOBuffer := JuliaLean.base.strings.io.newBufferState
    (JuliaLean.base.iobuffer.bitsConversions .i64) none
  print := JuliaLean.base.strings.io.printCharBufferState
  takeString := JuliaLean.base.strings.io.takeStringBufferState

/-- id: stringscova-util-rest-generic-rebuilt. Source: util.jl:1367-1373 and the
Iterators.rest contract, for every lawful string with `Char` elements (any code points,
including invalid ones): with no state (`Iterators.rest(s) = s`) the result is the bytes of
all characters (`write(io, c::Char)`, io.jl:973); from any iteration state (the start of its
`k`-th character, or the end) it is the bytes of exactly the remaining characters. -/
def RestCharacters : Prop :=
  (∀ {S R CU CT : Type} (prim : StringOps S R UInt32 CU CT JlError)
    (s : S) (ls : List (Index × UInt32)),
    Lawful prim s ls →
    restGeneric (restOpsNoState prim) s () =
      some (.ok ((charsIn ls).flatMap JuliaLean.base.strings.io.charUtf8Bytes))) ∧
  (∀ {S R CU CT : Type} (prim : StringOps S R UInt32 CU CT JlError)
    (s : S) (ls : List (Index × UInt32)) (k : Nat),
    Lawful prim s ls → k ≤ ls.length →
    let st : Index := match ls[k]? with
      | some p => p.1
      | none => prim.ncodeunits s + int 1
    restGeneric (restOps prim) s st =
      some (.ok (((charsIn ls).drop k).flatMap JuliaLean.base.strings.io.charUtf8Bytes)))

