private theorem cpBindResult {E A B : Type} (f : Except E A) (g : A → Except E B)
    (x : A) (y : B) (hf : f = .ok x) (hg : g x = .ok y) :
    (f >>= g) = .ok y := by
  rw [hf]
  exact hg

private theorem cpRawPrefix (s : Prepared) (gs : GoodView s.view) (n : Nat)
    (hn : n ≤ (preparedBytes s).length) :
    ∃ out, (do prepareView (← Sub.rawSubstringView parentOps s.view (int 1) (int n))) =
      .ok out ∧ preparedBytes out = (preparedBytes s).take n := by
  obtain ⟨out, hp, hview⟩ := cpPrefixPrepare s gs n hn
  refine ⟨out, cpBindResult _ prepareView _ out (cpPrefixRaw s gs n hn) hp, ?_⟩
  exact (congrArg viewBytes hview).trans (cpPrefixBytes s gs n hn)

private theorem cpChompSpec (bs : List UInt8) :
    chompReverseCharacters (0x0a : UInt8) 0x0d bs.reverse = chompSpec bs := by
  cases hr : bs.reverse with
  | nil =>
    have hb : bs = [] := by
      have := congrArg List.reverse hr
      simpa only [List.reverse_reverse, List.reverse_nil] using this
    subst bs
    rfl
  | cons c rest =>
    have hb : bs = rest.reverse ++ [c] := by
      have := congrArg List.reverse hr
      simpa only [List.reverse_reverse, List.reverse_cons] using this
    subst bs
    by_cases hc : c = 0x0a
    · subst c
      cases rest with
      | nil => rfl
      | cons d tail =>
        by_cases hd : d = 0x0d
        · subst d
          simp [chompReverseCharacters, chompSpec, List.take_append, List.take_of_length_le (show tail.reverse.length ≤ tail.length + 1 by simp)]
        · simp [chompReverseCharacters, chompSpec, hd, List.take_append, List.take_of_length_le (show tail.reverse.length ≤ tail.length + 1 by simp)]
    · simp [chompReverseCharacters, chompSpec, hc]

theorem StringutilChompFastCharacters_proven :
    JuliaLean.Proofs.base.strings.util.Round13.ChompFastCharacters := by
