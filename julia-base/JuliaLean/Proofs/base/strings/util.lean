theorem streamBufferCharResult
    (readChar : Stream → Except StreamError (UInt32 × Stream))
    {Q : Type} (member : UInt32 → Q → Bool)
    (before unread : List UInt8) (set : Q) (hsize : before.length + unread.length < 2 ^ 62)
    (result : Option (UInt32 × Index))
    (hr : readChar { readableStream before unread with mark := int before.length } =
      match result with
      | none => .error .eofError
      | some (c, next) => .ok (c, { readableStream before unread with
          mark := int before.length, ptr := int (Int.ofNat before.length + next.val) })) :
    streamCharConclusion readChar member before unread set result := by
