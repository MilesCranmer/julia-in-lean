  have hbt : Str.stringBetweenByte b 0x80 0xf7 = false := by
    simp [Str.stringBetweenByte, JuliaLean.base.strings.string.between,
      UInt8.le_iff_toNat_le, show ¬128 ≤ b.toNat by omega]
  simp only [getChar, JuliaLean.base.strings.substring.getindexSubString, viewBounds,
    hi1, hin, and_self, if_true, bind, Except.bind, pure, Except.pure]
  simp only [JuliaLean.base.strings.string.stringGetindex, JuliaLean.base.strings.string.getindexString,
    hcode, bind, Except.bind, hbt, Bool.not_false, if_true, pure, Except.pure]

private theorem cpThisindAscii (rd : Int → UInt8) (k : Int) (b : UInt8) (hb : b.toNat < 128) :
    rd (thisindPure rd k) = b ↔ rd k = b := by
  rcases thisindPure_cases rd k with hi | ⟨hi, _, _, hl⟩ | ⟨hi, _, _, _, hl⟩ |
      ⟨hi, _, _, _, _, hl⟩
  · rw [hi]
  all_goals
    rw [hi]
    constructor
    · intro h
      rw [h, leadB_iff] at hl
      simp at hl
      omega
    · intro h
      have hc : contB (rd k) = false := (contB_false_iff _).mpr (by rw [h]; omega)
      rcases thisindPure_cases rd k with hj | ⟨_, _, hcont, _⟩ | ⟨_, _, hcont, _, _⟩ |
        ⟨_, _, hcont, _, _, _⟩
      · omega
      all_goals rw [hc] at hcont; cases hcont

private theorem cpPreparedByte (s : Prepared) (gs : GoodView s.view) (k : Int)
    (hk1 : 1 ≤ k) (hkn : k ≤ s.view.ncodeunits.val) :
    (preparedBytes s).getD (k - 1).toNat 0 =
      parentByte s.view.string (s.view.offset.val + k) := by
  have hoff := gs.off
  have hfit := gs.fit
  have hlen := gs.len
  have ho : s.view.offset.val.toNat + (k - 1).toNat =
      (s.view.offset.val + k - 1).toNat := by omega
  have hk : (k - 1).toNat < s.view.ncodeunits.val.toNat := by omega
  simp only [preparedBytes, viewBytes, parentByte, List.getD_eq_getElem?_getD,
    List.getElem?_take, hk, if_true, List.getElem?_drop, ho]

private theorem cpReadEndAscii (s : Prepared) (gs : GoodView s.view) (k : Int)
    (hk1 : 1 ≤ k) (hkn : k ≤ s.view.ncodeunits.val) (i : Index)
    (hi : i.val = thisindPure (fun x => parentByte s.view.string (s.view.offset.val + x)) k) :
    ∃ c, getChar s i = .ok c ∧
      ∀ (b : UInt8), b.toNat < 128 →
        (c = b.toUInt32 <<< 24 ↔ parentByte s.view.string (s.view.offset.val + k) = b) := by
  let rd : Int → UInt8 := fun x => parentByte s.view.string (s.view.offset.val + x)
  have hil : 1 ≤ i.val := by rw [hi]; exact thisindPure_ge_one rd k hk1
  have hin : i.val ≤ s.view.ncodeunits.val := by
    have h := thisindPure_le rd k
    rw [← hi] at h
    omega
  have hiv : thisindPure rd i.val = i.val := by rw [hi]; exact thisindPure_idem rd k
  obtain ⟨c, hc, ht⟩ := cpGetCharTop s gs i hil hin hiv
  refine ⟨c, hc, ?_⟩
  intro b hb
  change (c = b.toUInt32 <<< 24 ↔ rd k = b)
  constructor
  · intro he
    rw [he, cpTopShift] at ht
    have heq : rd i.val = b := by
      apply UInt8.toNat_inj.mp
      have h := congrArg UInt32.toNat ht
      simpa only [UInt8.toNat_toUInt32] using h.symm
    rw [hi] at heq
    exact (cpThisindAscii rd k b hb).mp heq
  · intro he
    have hcont : contB (rd k) = false := (contB_false_iff _).mpr (by rw [he]; omega)
    have hp : thisindPure rd k = k := by
      unfold thisindPure
      rw [cont_beq, hcont]
      rfl
    have hik : i.val = k := hi.trans hp
    have hg := cpGetCharAscii s gs i hil hin b hb (by rw [hik]; exact he)
    rw [hc] at hg
    exact Except.ok.inj hg

private def cpEmpty : Prepared := ⟨⟨⟨[], by decide⟩, int 0, int 0⟩, int 0⟩
private def cpLF : Prepared := ⟨⟨⟨[0x0a], by decide⟩, int 0, int 1⟩, int 1⟩
private def cpCRLF : Prepared := ⟨⟨⟨[0x0d, 0x0a], by decide⟩, int 0, int 2⟩, int 2⟩

private theorem cpEmptyDense : DenseArg cpEmpty := .string (s := cpEmpty.view.string) (by rfl)
private theorem cpLFDense : DenseArg cpLF := .string (s := cpLF.view.string) (by rfl)
private theorem cpCRLFDense : DenseArg cpCRLF := .string (s := cpCRLF.view.string) (by rfl)

private theorem cpSliceWhole (s : Prepared) (hs : DenseArg s) :
    ∃ out, preparedSlice s (int 1) s.last = .ok out ∧ preparedBytes out = preparedBytes s := by
  obtain ⟨out, hcall, _, hout⟩ := chopPrefixFastBytesRound6_proven s cpEmpty hs cpEmptyDense
  have he : preparedBytes cpEmpty = [] := rfl
  have hc : startswithFast denseOps id s cpEmpty = .ok true := by
    have h := fastPrefixBytesRound6_proven s cpEmpty hs cpEmptyDense
    simpa [he, viewBoundary] using h
  have hz : int 1 + cpEmpty.view.ncodeunits = int 1 := by decide
  refine ⟨out, ?_, ?_⟩
  · simpa only [chopFastPrefixCall, chopprefixFast, hc, ok_bind', if_true, hz,
      preparedFrom] using hcall
  · simpa [he, viewBoundary] using hout

private theorem cpAsciiBoundary (s : Prepared) (hs : DenseArg s) (k : Nat)
    (hk : k < (preparedBytes s).length) (b : UInt8) (hb : b.toNat < 128)
    (hbyte : (preparedBytes s).getD k 0 = b) : viewBoundary s k = true := by
  have gs := denseArg_good s hs
  have hoff := gs.off
  have hfit := gs.fit
  have hsmall := s.view.string.small
  have hlen : ((preparedBytes s).length : Int) = s.view.ncodeunits.val := goodView_bytes_length s.view gs
  have hidx : (int (s.view.offset.val + (k : Int) + 1)).val = s.view.offset.val + k + 1 :=
    cpIntVal _ (by omega) (by omega)
  have hraw : parentByte s.view.string (s.view.offset.val + (k : Int) + 1) = b := by
    have h := cpPreparedByte s gs ((k : Int) + 1) (by omega) (by omega)
    have hkval : (((k : Int) + 1) - 1).toNat = k := by omega
    rw [hkval, hbyte] at h
    simpa only [Int.add_assoc] using h.symm
  have hiv : Str.stringIsvalidIndex s.view.string (int (s.view.offset.val + k + 1)) = true := by
    apply (stringIsvalid_iff_pure s.view.string _ (by rw [hidx]; omega)
      (by rw [hidx]; omega)).mpr
    rw [hidx]
    have hc : contB (parentByte s.view.string (s.view.offset.val + k + 1)) = false := by
      apply (contB_false_iff _).mpr
      rw [hraw]
      omega
    unfold thisindPure
    rw [cont_beq, hc]
    rfl
  simpa only [viewBoundary, Int.ofNat_eq_coe, hiv, Bool.or_true]

private theorem cpLast (s : Prepared) (hs : DenseArg s) :
    (s.view.ncodeunits.val = 0 ∧ s.last.val = 0) ∨
    (1 ≤ s.view.ncodeunits.val ∧ s.last.val =
      thisindPure (fun x => parentByte s.view.string (s.view.offset.val + x)) s.view.ncodeunits.val) := by
  have gs := denseArg_good s hs
  have hlast := denseArg_last s hs
  by_cases hz : s.view.ncodeunits.val = 0
  · left
    refine ⟨hz, ?_⟩
    have hz' : (s.view.ncodeunits.val == 0) = true := by simp only [hz]; rfl
    have hth : viewThisind s.view s.view.ncodeunits = .ok (JuliaLean.Strings.ix 0) := by
      simp only [viewThisind, Sub.thisindSubString, Str.thisindString,
        JuliaLean.base.strings.string.thisindString, JuliaLean.base.strings.string.thisindStr,
        hz', if_true, pure, Except.pure]
    rw [hlast] at hth
    have heq := Except.ok.inj hth
    rw [heq]
    decide
  · right
    have hlen := gs.len
    obtain ⟨r, hr, hrv⟩ := viewThisind_pure s.view s.view.ncodeunits (by omega)
      (Int.le_refl _) gs.off gs.fit
    rw [hlast] at hr
    have heq := Except.ok.inj hr
    exact ⟨by omega, (congrArg Subtype.val heq).trans hrv⟩

private theorem cpDropLF (s : Prepared) (hs : DenseArg s) (before : List UInt8)
    (hb : preparedBytes s = before ++ [0x0a]) :
    ∃ out, (do let j ← previous s s.view.ncodeunits; preparedSlice s (int 1) j) = .ok out ∧
      preparedBytes out = before := by
  have gs := denseArg_good s hs
  have hlen : ((preparedBytes s).length : Int) = s.view.ncodeunits.val := goodView_bytes_length s.view gs
  have hsize := s.view.string.small
  have hoff := gs.off
  have hfit := gs.fit
  have hn : 1 ≤ s.view.ncodeunits.val := by rw [hb] at hlen; simp only [List.length_append, List.length_singleton] at hlen; omega
  have hpbytes : preparedBytes cpLF = [0x0a] := rfl
  have hpre : (preparedBytes cpLF).reverse.isPrefixOf (preparedBytes s).reverse = true := by
    rw [hpbytes, hb]
    simp [List.reverse_append, List.isPrefixOf]
  have hbound : viewBoundary s ((preparedBytes s).length - (preparedBytes cpLF).length) = true := by
    have h := cpAsciiBoundary s hs before.length (by rw [hb]; simp) 0x0a (by decide)
      (by rw [hb]; simp)
    simpa only [hb, hpbytes, List.length_append, List.length_singleton, Nat.add_sub_cancel] using h
  have he := (denseSuffixBytesRound6_proven s cpLF hs cpLFDense).2
  rw [hpre, hbound] at he
  have hi : s.view.ncodeunits - cpLF.view.ncodeunits + int 1 = s.view.ncodeunits := by
    apply Subtype.ext
    have h1 : (int 1).val = 1 := by decide
    change (s.view.ncodeunits - int 1 + int 1).val = _
    rw [cpAddVal _ _ (by rw [cpSubVal _ _ (by omega) (by omega)]; omega)
      (by rw [cpSubVal _ _ (by omega) (by omega)]; omega),
      cpSubVal _ _ (by omega) (by omega)]
    omega
  obtain ⟨out, hcall, _, hout⟩ := chopSuffixFastBytesRound6_proven s cpLF hs cpLFDense
  refine ⟨out, ?_, ?_⟩
  · simpa only [chopFastSuffixCall, chopsuffixFast,
      show isemptyString preparedOps cpLF = false from rfl, Bool.false_eq_true, if_false,
      he, Bool.true_and, ok_bind', if_true, hi] using hcall
  · rw [hpre, hbound] at hout
    simpa only [Bool.true_and, if_true, hb, hpbytes, List.length_append, List.length_singleton,
      Nat.add_sub_cancel, List.take_append_length] using hout

private theorem cpDropCRLF (s : Prepared) (hs : DenseArg s) (before : List UInt8)
    (hb : preparedBytes s = before ++ [0x0d, 0x0a]) :
    ∃ out, (do let j ← previous s (s.view.ncodeunits - int 1); preparedSlice s (int 1) j) = .ok out ∧
      preparedBytes out = before := by
  have gs := denseArg_good s hs
  have hlen : ((preparedBytes s).length : Int) = s.view.ncodeunits.val := goodView_bytes_length s.view gs
  have hsize := s.view.string.small
  have hoff := gs.off
  have hfit := gs.fit
  have hn : 2 ≤ s.view.ncodeunits.val := by rw [hb] at hlen; simp only [List.length_append, List.length_cons, List.length_nil] at hlen; omega
  have hpbytes : preparedBytes cpCRLF = [0x0d, 0x0a] := rfl
  have hpre : (preparedBytes cpCRLF).reverse.isPrefixOf (preparedBytes s).reverse = true := by
    rw [hpbytes, hb]
    simp [List.reverse_append, List.isPrefixOf]
  have hbound : viewBoundary s ((preparedBytes s).length - (preparedBytes cpCRLF).length) = true := by
    have h := cpAsciiBoundary s hs before.length (by rw [hb]; simp) 0x0d (by decide)
      (by rw [hb]; simp)
    simpa only [hb, hpbytes, List.length_append, List.length_cons, List.length_nil, Nat.add_sub_cancel] using h
  have he := (denseSuffixBytesRound6_proven s cpCRLF hs cpCRLFDense).2
  rw [hpre, hbound] at he
  have hi : s.view.ncodeunits - cpCRLF.view.ncodeunits + int 1 = s.view.ncodeunits - int 1 := by
    apply Subtype.ext
    have h1 : (int 1).val = 1 := by decide
    have h2 : (int 2).val = 2 := by decide
    change (s.view.ncodeunits - int 2 + int 1).val = (s.view.ncodeunits - int 1).val
    rw [cpAddVal _ _ (by rw [cpSubVal _ _ (by omega) (by omega)]; omega)
      (by rw [cpSubVal _ _ (by omega) (by omega)]; omega),
      cpSubVal _ _ (by omega) (by omega), cpSubVal _ _ (by omega) (by omega)]
    omega
  obtain ⟨out, hcall, _, hout⟩ := chopSuffixFastBytesRound6_proven s cpCRLF hs cpCRLFDense
  refine ⟨out, ?_, ?_⟩
  · simpa only [chopFastSuffixCall, chopsuffixFast,
      show isemptyString preparedOps cpCRLF = false from rfl, Bool.false_eq_true, if_false,
      he, Bool.true_and, ok_bind', if_true, hi] using hcall
  · rw [hpre, hbound] at hout
    simpa only [Bool.true_and, if_true, hb, hpbytes, List.length_append, List.length_cons, List.length_nil,
      Nat.add_sub_cancel, List.take_append_length] using hout

private theorem cpGenericChompBytes (s : Prepared) (hs : DenseArg s) :
    ∃ out, chompCall s = .ok out ∧ preparedBytes out = chompSpec (preparedBytes s) := by
  have gs := denseArg_good s hs
  have hlen : ((preparedBytes s).length : Int) = s.view.ncodeunits.val := goodView_bytes_length s.view gs
  have h1 : (int 1).val = 1 := by decide
  let rd : Int → UInt8 := fun x => parentByte s.view.string (s.view.offset.val + x)
  cases hr : (preparedBytes s).reverse with
  | nil =>
    have hb : preparedBytes s = [] := by
      have h := congrArg List.reverse hr
      simpa only [List.reverse_reverse, List.reverse_nil] using h
    have hn : s.view.ncodeunits.val = 0 := by rw [hb] at hlen; simpa using hlen.symm
    have hl : s.last.val = 0 := by
      rcases cpLast s hs with h | h
      · exact h.2
      · omega
    obtain ⟨out, hout, hbytes⟩ := cpSliceWhole s hs
    refine ⟨out, ?_, ?_⟩
    · simp only [chompCall, chomp, ok_bind', hl, show (0 : Int) < 1 by omega,
        if_true, hout]
    · simpa only [hb, chompSpec, List.getLast?_nil, reduceCtorEq, if_false] using hbytes
  | cons c rest =>
    have hb : preparedBytes s = rest.reverse ++ [c] := by
      have h := congrArg List.reverse hr
      simpa only [List.reverse_reverse, List.reverse_cons] using h
    have hn : 1 ≤ s.view.ncodeunits.val := by
      rw [hb] at hlen
      simp only [List.length_append, List.length_reverse, List.length_singleton] at hlen
      omega
    have hl : s.last.val = thisindPure rd s.view.ncodeunits.val := by
      rcases cpLast s hs with h | h
      · omega
      · exact h.2
    obtain ⟨ch, hch, hchar⟩ := cpReadEndAscii s gs s.view.ncodeunits.val hn
      (Int.le_refl _) s.last hl
    have hlastByte : rd s.view.ncodeunits.val = c := by
      have h := cpPreparedByte s gs s.view.ncodeunits.val hn (Int.le_refl _)
      have hk : (s.view.ncodeunits.val - 1).toNat = rest.reverse.length := by
        rw [hb] at hlen
        simp only [List.length_append, List.length_singleton] at hlen
        omega
      rw [hk, hb] at h
      simpa using h.symm
    have hil : ¬s.last.val < 1 := by
      have h := thisindPure_ge_one rd s.view.ncodeunits.val hn
      rw [← hl] at h
      omega
    by_cases hc : c = 0x0a
    · rw [hc] at hb hr hlastByte
      have hceq : ch = 0x0a000000 := (hchar 0x0a (by decide)).mpr hlastByte
      have hlast : s.last = s.view.ncodeunits := by
        apply Subtype.ext
        rw [hl]
        unfold thisindPure
        rw [show rd s.view.ncodeunits.val = 0x0a from hlastByte]
        rfl
      obtain ⟨j, hp, hj0, hjval⟩ := previous_spec s gs s.view.ncodeunits hn (by omega)
      have hpLast : previous s s.last = .ok j := by rw [hlast]; exact hp
      obtain ⟨out1, ho1, hv1⟩ := cpDropLF s hs rest.reverse hb
      have hslice1 : preparedSlice s (int 1) j = .ok out1 := by
        simpa only [hp, ok_bind'] using ho1
      cases rest with
      | nil =>
        have hz : j.val = 0 := hj0 (by rw [hb] at hlen; simpa using hlen.symm)
        refine ⟨out1, ?_, ?_⟩
        · simp only [chompCall, chomp, ok_bind', hil, if_false, hch, hceq,
            JuliaLean.base.char.eq_Char, beq_self_eq_true, Bool.not_true, Bool.false_eq_true,
            hpLast, hz, show (0 : Int) < 1 by omega, if_true, hslice1]
        · simpa [hb, chompSpec] using hv1
      | cons d tail =>
        have hb2 : preparedBytes s = tail.reverse ++ [d, 0x0a] := by
          simpa only [List.reverse_cons, List.append_assoc, List.singleton_append] using hb
        have hn2 : 2 ≤ s.view.ncodeunits.val := by
          rw [hb2] at hlen
          simp only [List.length_append, List.length_cons, List.length_nil] at hlen
          omega
        have hj : j.val = thisindPure rd (s.view.ncodeunits.val - 1) := hjval hn2
        have hjpos : ¬j.val < 1 := by
          have h := thisindPure_ge_one rd (s.view.ncodeunits.val - 1) (by omega)
          rw [← hj] at h
          omega
        obtain ⟨ch2, hch2, hchar2⟩ := cpReadEndAscii s gs (s.view.ncodeunits.val - 1)
          (by omega) (by omega) j hj
        have hsecond : rd (s.view.ncodeunits.val - 1) = d := by
          have h := cpPreparedByte s gs (s.view.ncodeunits.val - 1) (by omega) (by omega)
          have hk : (s.view.ncodeunits.val - 1 - 1).toNat = tail.reverse.length := by
            rw [hb2] at hlen
            simp only [List.length_append, List.length_cons, List.length_nil] at hlen
            omega
          rw [hk, hb2] at h
          simpa using h.symm
        by_cases hd : d = 0x0d
        · rw [hd] at hb2 hsecond
          have hceq2 : ch2 = 0x0d000000 := (hchar2 0x0d (by decide)).mpr hsecond
          have hjexact : j = s.view.ncodeunits - int 1 := by
            apply Subtype.ext
            rw [cpSubVal _ _ (by have h := s.view.ncodeunits.property; simp [IntTy.min, IntTy.max, IntTy.signed, IntTy.bits] at h; omega)
              (by have h := s.view.ncodeunits.property; simp [IntTy.min, IntTy.max, IntTy.signed, IntTy.bits] at h; omega), h1, hj]
            unfold thisindPure
            rw [show rd (s.view.ncodeunits.val - 1) = 0x0d from hsecond]
            rfl
          obtain ⟨out, hout, hbytes⟩ := cpDropCRLF s hs tail.reverse hb2
          refine ⟨out, ?_, ?_⟩
          · simp only [chompCall, chomp, ok_bind', hil, if_false, hch, hceq,
              JuliaLean.base.char.eq_Char, beq_self_eq_true, Bool.not_true, Bool.false_eq_true,
              hpLast, hjpos, hch2, hceq2]
            simpa only [hjexact] using hout
          · simpa [hb2, chompSpec, List.take_append, List.take_of_length_le (show tail.reverse.length ≤ tail.length + 1 by simp)] using hbytes
        · have hneq2 : ch2 ≠ 0x0d000000 := by
            intro h
            have he := (hchar2 0x0d (by decide)).mp h
            change rd (s.view.ncodeunits.val - 1) = 0x0d at he
            rw [hsecond] at he
            exact hd he
          have hbeq2 : (ch2 == (0x0d000000 : UInt32)) = false := by
            apply beq_eq_false_iff_ne.mpr
            exact hneq2
          refine ⟨out1, ?_, ?_⟩
          · simp only [chompCall, chomp, ok_bind', hil, if_false, hch, hceq,
              JuliaLean.base.char.eq_Char, beq_self_eq_true, Bool.not_true, Bool.false_eq_true,
              hpLast, hjpos, hch2, hbeq2, Bool.not_false, if_true, hslice1]
          · simpa [hb2, chompSpec, hd, List.take_append, List.take_of_length_le (show tail.reverse.length ≤ tail.length + 1 by simp)] using hv1
    · have hneq : ch ≠ 0x0a000000 := by
        intro h
        have he := (hchar 0x0a (by decide)).mp h
        change rd s.view.ncodeunits.val = 0x0a at he
        rw [hlastByte] at he
        exact hc he
      have hbeq : (ch == (0x0a000000 : UInt32)) = false := by
        apply beq_eq_false_iff_ne.mpr
        exact hneq
      obtain ⟨out, hout, hbytes⟩ := cpSliceWhole s hs
      refine ⟨out, ?_, ?_⟩
      · simp only [chompCall, chomp, ok_bind', hil, if_false, hch,
          JuliaLean.base.char.eq_Char, hbeq, Bool.not_false, if_true, hout]
      · simpa [hb, chompSpec, hc] using hbytes

theorem StringutilChompGeneric_proven :
    JuliaLean.Proofs.base.strings.util.Round13.ChompGeneric := by
  intro s hs
  obtain ⟨genericOut, hg, hgb⟩ := cpGenericChompBytes s hs
  obtain ⟨fastOut, hf, hfb⟩ := StringutilChompFastCharacters_proven s hs
  exact ⟨genericOut, fastOut, hg, hf, hgb.trans hfb.symm⟩

