def partitionOps : PartitionOps Prepared Prepared Error where
  ncodeunits s := .ok s.view.ncodeunits
  firstindex _ := .ok (int 1)
  lastindex s := .ok s.last
  nextindN := nextindInt preparedPrim (fun i => toString i.val)
  nextind := following
  substring := preparedSlice

def partitionCall (s : Raw) (n : Index) : Result (Option (Prepared × Index)) := do
