/-- Retained refuted id: strings-partition-overflow.
Source: Iterators.partition documentation and util.jl lines 814-818. -/
def PartitionWhole : Prop := ∀ (s : Raw) (n : Index),
  ∃ cs, rawChars s = .ok cs ∧
    (cs ≠ [] → Int.ofNat cs.length ≤ n.val →
      ∃ out next, partitionCall s n = .ok (some (out, next)) ∧ preparedBytes out = s.bytes)

def preparedLength (s : Prepared) : Index :=
  JuliaLean.base.strings.string.lengthView (fun s => s.view.ncodeunits)
    (fun s i => (preparedBytes s).getD (i.val.toNat - 1) 0) s

def characterIterator : HexIteratorOps Prepared UInt32 UInt32 Index Error where
  length s := .ok (preparedLength s)
