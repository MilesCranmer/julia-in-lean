private theorem hexIntVal (n : Int) (lo : -2^63 ≤ n) (hi : n < 2^63) :
    (int n).val = n := by
  change wrapInt .i64 n = n
  apply wrapInt_of_inRange
  change -9223372036854775808 ≤ n ∧ n ≤ 9223372036854775807
  constructor <;> omega

private theorem utilHexTable (b : UInt8) :
    JuliaLean.base.char.hex_chars.getD ((hexHighIndex b).val.toNat - 1) 0 =
      lowerHexDigit (b.toNat / 16) ∧
    JuliaLean.base.char.hex_chars.getD ((hexLowIndex b).val.toNat - 1) 0 =
      lowerHexDigit (b.toNat % 16) := by
  have hb := b.toFin.isLt
  have hh : (hexHighIndex b).val = 1 + (b >>> 4).toNat := by
    have h : (b >>> 4).toNat < 256 := (b >>> 4).toFin.isLt
    apply hexIntVal <;> omega
  have hl : (hexLowIndex b).val = 1 + (b &&& 0xf).toNat := by
    have h : (b &&& 0xf).toNat < 256 := (b &&& 0xf).toFin.isLt
    apply hexIntVal <;> omega
  rw [hh, hl]
  have all : ∀ n : Fin 256,
      JuliaLean.base.char.hex_chars.getD ((1 + (UInt8.ofNat n.val >>> 4).toNat : Int).toNat - 1) 0 =
        lowerHexDigit ((UInt8.ofNat n.val).toNat / 16) ∧
      JuliaLean.base.char.hex_chars.getD ((1 + (UInt8.ofNat n.val &&& 0xf).toNat : Int).toNat - 1) 0 =
        lowerHexDigit ((UInt8.ofNat n.val).toNat % 16) := by
    decide +kernel
  simpa only [UInt8.ofNat_toNat] using all ⟨b.toNat, hb⟩

private theorem collectTrace {A St E : Type} {steps : IterSteps A St E} {xs : List A}
    (h : collectIterSteps steps = .ok xs) : IterStepTrace steps xs := by
  induction steps generalizing xs with
  | done => simp [collectIterSteps] at h; subst xs; exact .done
  | fail e => simp [collectIterSteps] at h
  | @yield x state next ih =>
    cases hnext : collectIterSteps (next state) with
    | error e => simp [collectIterSteps, hnext, bind, Except.bind] at h
    | ok rest =>
      have hxs : xs = x :: rest := by
        simpa [collectIterSteps, hnext, bind, Except.bind, pure, Except.pure] using h.symm
      subst xs
      exact .yield (ih state hnext)

private theorem hexByteDecoder (b : UInt8) :
    numberFromHexByte (JuliaLean.Strings.SErr.jl ∘ JlError.argumentError) b =
      match hexNibble b with
      | some n => .ok (UInt8.ofNat n)
      | none => .error (JuliaLean.Strings.SErr.jl (.argumentError "byte is not an ASCII hexadecimal digit")) := by
  have all : ∀ n : Fin 256,
      numberFromHexByte (JuliaLean.Strings.SErr.jl ∘ JlError.argumentError) (UInt8.ofNat n.val) =
        match hexNibble (UInt8.ofNat n.val) with
        | some n => .ok (UInt8.ofNat n)
        | none => .error (JuliaLean.Strings.SErr.jl (.argumentError "byte is not an ASCII hexadecimal digit")) := by
    decide +kernel
  simpa only [UInt8.ofNat_toNat] using all ⟨b.toNat, b.toFin.isLt⟩

private theorem lowerHexDecode (bytes : List UInt8) :
    hexadecimalValue (lowerHex bytes) = some bytes ∧
    decodePairs (lowerHex bytes) = (bytes, false) := by
  have digit : ∀ b : UInt8,
      (do
        let hi ← hexNibble (lowerHexDigit (b.toNat / 16))
        let lo ← hexNibble (lowerHexDigit (b.toNat % 16))
        pure (UInt8.ofNat (16 * hi + lo))) = some b := by
    intro b
    have all : ∀ n : Fin 256, let b := UInt8.ofNat n.val;
        (do
          let hi ← hexNibble (lowerHexDigit (b.toNat / 16))
          let lo ← hexNibble (lowerHexDigit (b.toNat % 16))
          pure (UInt8.ofNat (16 * hi + lo))) = some b := by decide +kernel
    simpa only [UInt8.ofNat_toNat] using all ⟨b.toNat, b.toFin.isLt⟩
  induction bytes with
  | nil => exact ⟨rfl, rfl⟩
  | cons b bs ih =>
    have h := digit b
    cases hh : hexNibble (lowerHexDigit (b.toNat / 16)) <;>
      cases hl : hexNibble (lowerHexDigit (b.toNat % 16)) <;>
      simp [hh, hl, bind, Option.bind] at h
    rename_i hi lo
    have hv : UInt8.ofNat (16 * hi + lo) = b := by simpa using h
    change hexadecimalValue
        (lowerHexDigit (b.toNat / 16) :: lowerHexDigit (b.toNat % 16) :: lowerHex bs) =
        some (b :: bs) ∧
      decodePairs (lowerHexDigit (b.toNat / 16) :: lowerHexDigit (b.toNat % 16) :: lowerHex bs) =
        (b :: bs, false)
    simp only [hexadecimalValue, decodePairs, hh, hl, ih.1, ih.2, bind, Option.bind,
      pure, Pure.pure]
    simp only [hv, and_self]

private theorem ioLoopMatches
    {IO St E : Type} [MonadExceptOf JuliaLean.base.show.ShowError (StateT IO (ExceptT E Id))]
    (ops : JuliaLean.base.strings.io.CharIO (StateT IO (ExceptT E Id)) Unit Unit)
    (charOfByte : UInt8 → UInt32) :
    ∀ {steps : IterSteps UInt8 St E} {bytes : List UInt8},
      IterStepTrace steps bytes → ∀ io,
      bytes2hexIOLoop
        (fun i => JuliaLean.base.char.hex_chars.getD (i.val.toNat - 1) 0)
        charOfByte (printDigitPair ops) steps io =
        printDigitsOf ops charOfByte bytes io := by
  intro steps bytes htrace
  induction htrace with
  | done => intro io; rfl
  | @yield b state next bytes tail ih =>
    intro io
    simp only [bytes2hexIOLoop, (utilHexTable b).1, (utilHexTable b).2]
    change (printDigitPair ops io (charOfByte (lowerHexDigit (b.toNat / 16)))
        (charOfByte (lowerHexDigit (b.toNat % 16)))).bind
        (fun io => bytes2hexIOLoop _ charOfByte (printDigitPair ops) (next state) io) = _
    simp only [ih]
    rfl

private theorem ioLoopFailMatches
    {IO St E : Type} [MonadExceptOf JuliaLean.base.show.ShowError (StateT IO (ExceptT E Id))]
    (ops : JuliaLean.base.strings.io.CharIO (StateT IO (ExceptT E Id)) Unit Unit)
    (charOfByte : UInt8 → UInt32) :
    ∀ {steps : IterSteps UInt8 St E} {bytes : List UInt8} {err : E},
      StepsFail steps bytes err → ∀ io,
      bytes2hexIOLoop
        (fun i => JuliaLean.base.char.hex_chars.getD (i.val.toNat - 1) 0)
        charOfByte (printDigitPair ops) steps io =
        (printDigitsOf ops charOfByte bytes io).bind (fun _ => .error err) := by
  intro steps bytes err hfail
  induction hfail with
  | fail => intro io; rfl
  | @yield b state next bytes err tail ih =>
    intro io
    simp only [bytes2hexIOLoop, (utilHexTable b).1, (utilHexTable b).2]
    change (printDigitPair ops io (charOfByte (lowerHexDigit (b.toNat / 16)))
        (charOfByte (lowerHexDigit (b.toNat % 16)))).bind
        (fun io => bytes2hexIOLoop _ charOfByte (printDigitPair ops) (next state) io) = _
    simp only [ih]
    change Except.bind _ _ = Except.bind (Except.bind
      (printDigitPair ops io (charOfByte (lowerHexDigit (b.toNat / 16)))
        (charOfByte (lowerHexDigit (b.toNat % 16))))
      (fun io => printDigitsOf ops charOfByte bytes io)) (fun _ => .error err)
    cases printDigitPair ops io (charOfByte (lowerHexDigit (b.toNat / 16)))
        (charOfByte (lowerHexDigit (b.toNat % 16))) <;> rfl

theorem bytes2hexIO_generic_proven :
    (∀ {IO St E : Type} [MonadExceptOf JuliaLean.base.show.ShowError (StateT IO (ExceptT E Id))]
    (ops : JuliaLean.base.strings.io.CharIO (StateT IO (ExceptT E Id)) Unit Unit)
      (argErr : String → E) (charOfByte : UInt8 → UInt32)
      (steps : IterSteps UInt8 St E) (io : IO),
      CharOfByteInstalled charOfByte →
      let call := fun (isUInt8 : Bool) => bytes2hexIO (fun _ : Unit => steps)
        (fun _ => isUInt8) (fun i => JuliaLean.base.char.hex_chars.getD (i.val.toNat - 1) 0)
        charOfByte (printDigitPair ops) argErr io ()
      (∀ bytes, collectIterSteps steps = .ok bytes → call true = printDigitsOf ops charOfByte bytes io) ∧
      (∀ bytes err, StepsFail steps bytes err →
        call true = (printDigitsOf ops charOfByte bytes io).bind (fun _ => .error err)) ∧
      (∃ message, call false = .error (argErr message))) := by
  intro IO St E _ ops argErr charOfByte steps io _
  refine ⟨?_, ?_, ?_⟩
  · intro bytes hcollect
    simpa [bytes2hexIO] using ioLoopMatches ops charOfByte (collectTrace hcollect) io
  · intro bytes err hfail
    simpa [bytes2hexIO] using ioLoopFailMatches ops charOfByte hfail io
  · exact ⟨"eltype of iterator not UInt8", rfl⟩

private theorem digitCodeNumber {A : Type} (toChar : A → Result UInt32)
    (digit : HexDigit A UInt32) (code : UInt8) (h : digitCode toChar digit = .ok code) :
    numberFromHex (.jl ∘ JlError.argumentError) toChar charByte digit =
      numberFromHexByte (.jl ∘ JlError.argumentError) code := by
  cases digit with
  | byte b => cases h; rfl
  | abstractChar a =>
    simp only [digitCode, bind, Except.bind] at h
    cases hc : toChar a with
    | error e => simp [hc] at h
    | ok c =>
      simp only [hc] at h
      simp [numberFromHex, numberFromHexAbstract, numberFromHexChar, hc, h,
        bind, Except.bind]

private theorem mapM_length {A B E : Type} (f : A → Except E B)
    {xs : List A} {ys : List B} (h : xs.mapM f = .ok ys) : xs.length = ys.length := by
  induction xs generalizing ys with
  | nil => cases h; rfl
  | cons x xs ih =>
    cases hx : f x with
    | error e => simp [List.mapM_cons, hx] at h
    | ok y =>
      cases hxs : xs.mapM f with
      | error e => simp [List.mapM_cons, hx, hxs] at h
      | ok rest =>
        have heq : ys = y :: rest := by simpa [List.mapM_cons, hx, hxs] using h.symm
        subst ys
        simpa using congrArg Nat.succ (ih hxs)

private theorem hexadecimalValue_length {codes bytes : List UInt8}
    (h : hexadecimalValue codes = some bytes) : codes.length = 2 * bytes.length := by
  induction codes using hexadecimalValue.induct generalizing bytes with
  | case1 => cases h; rfl
  | case2 b => simp [hexadecimalValue] at h
  | case3 a b rest ih =>
    cases ha : hexNibble a <;> cases hb : hexNibble b <;>
      cases hr : hexadecimalValue rest <;>
      simp [hexadecimalValue, ha, hb, hr, bind, Option.bind] at h
    rename_i hi lo tail
    subst bytes
    have hlen := ih hr
    simp only [List.length_cons]
    omega

private theorem hexNibble_bound (c : UInt8) (n : Nat) (h : hexNibble c = some n) : n < 16 := by
  have all : ∀ i : Fin 256, ∀ n, hexNibble (UInt8.ofNat i.val) = some n → n < 16 := by
    decide +kernel
  exact all ⟨c.toNat, c.toFin.isLt⟩ n (by simpa using h)

private theorem combineNibbles (hi lo : Nat) (hh : hi < 16) (hl : lo < 16) :
    ((UInt8.ofNat hi <<< 4) + UInt8.ofNat lo) = UInt8.ofNat (16 * hi + lo) := by
  have all : ∀ a b : Fin 16,
      ((UInt8.ofNat a.val <<< 4) + UInt8.ofNat b.val) =
        UInt8.ofNat (16 * a.val + b.val) := by decide +kernel
  exact all ⟨hi, hh⟩ ⟨lo, hl⟩

private theorem mapM_cons_inv {A B E : Type} (f : A → Except E B)
    (x : A) (xs : List A) (ys : List B) (h : (x :: xs).mapM f = .ok ys) :
    ∃ y rest, f x = .ok y ∧ xs.mapM f = .ok rest ∧ ys = y :: rest := by
  cases hx : f x with
  | error e => simp [List.mapM_cons, hx] at h
  | ok y =>
    cases hr : xs.mapM f with
    | error e => simp [List.mapM_cons, hx, hr] at h
    | ok rest =>
      exact ⟨y, rest, rfl, rfl, by simpa [List.mapM_cons, hx, hr] using h.symm⟩

private theorem hexLoopSuccess {Array I IS Itr A St : Type}
    (arr : ByteArrayOps Array I IS Error) (it : HexIteratorOps Itr A UInt32 St Error)
    (toChar : A → Result UInt32) (itr : Itr) (indices : IS)
    (idxs : List I) (digits : List (HexDigit A UInt32)) (codes bytes : List UInt8)
    (first : Option (HexDigit A UInt32 × St)) (dest : Array)
    (walk : IndexWalk arr indices none idxs)
    (trace : Trace (it.iterateNext itr) first digits)
    (converts : digits.mapM (digitCode toChar) = .ok codes)
    (decoded : hexadecimalValue codes = some bytes)
    (hlen : idxs.length = bytes.length) :
    hex2bytesBang.loop arr it assertHexTuple (.jl ∘ JlError.argumentError) toChar charByte
      itr indices dest first =
      some (match (writesM arr idxs bytes).run dest with
        | .ok _ d => .ok d d
        | .error e d => .error e d) := by
  let step : (Array × Option IS × Option (HexDigit A UInt32 × St)) →
      Except (Error × Array) (Sum (Array × Array)
        (Array × Option IS × Option (HexDigit A UInt32 × St))) := fun (dest, idxSt, next) => do
    let (stepIdx, dest) ← runHexState (arr.iterateIndex indices idxSt) dest
    match stepIdx with
    | none => return .inl (dest, dest)
    | some (i, idxSt') =>
      let (next', dest') ← runHexState (do
        let (x, state) ← liftHexExcept (assertHexTuple next)
        let step1 ← liftHexExcept (it.iterateNext itr state)
        let (y, state) ← liftHexExcept (assertHexTuple step1)
        let next' ← liftHexExcept (it.iterateNext itr state)
        let high ← liftHexExcept (numberFromHex (.jl ∘ JlError.argumentError) toChar charByte x)
        let shifted := high <<< 4
        let low ← liftHexExcept (numberFromHex (.jl ∘ JlError.argumentError) toChar charByte y)
        arr.set i (shifted + low)
        pure next') dest
      return .inr (dest', some idxSt', next')
  change toHexResult (JuliaLean.base.reduce.whileLoop step (dest, none, first)) = _
  have go : ∀ (idxs : List I) (st : Option IS) (digits : List (HexDigit A UInt32))
      (codes bytes : List UInt8) (first : Option (HexDigit A UInt32 × St)),
      IndexWalk arr indices st idxs →
      Trace (it.iterateNext itr) first digits →
      digits.mapM (digitCode toChar) = .ok codes →
      hexadecimalValue codes = some bytes →
      idxs.length = bytes.length →
      ∀ dest, toHexResult (JuliaLean.base.reduce.whileLoop step (dest, st, first)) =
        some (match (writesM arr idxs bytes).run dest with
          | .ok _ d => .ok d d
          | .error e d => .error e d) := by
    intro idxs
    induction idxs with
    | nil =>
      intro st digits codes bytes first walk trace converts decoded hlen dest
      have hb : bytes = [] := List.eq_nil_of_length_eq_zero hlen.symm
      subst bytes
      change ∀ d, (arr.iterateIndex indices st).run d = .ok none d at walk
      have hs : step (dest, st, first) = .ok (.inl (dest, dest)) := by
        simp [step, runHexState, walk dest, bind, Except.bind, pure, Except.pure]
      rw [JuliaLean.base.reduce.whileLoop, hs]
      rfl
    | cons i idxs ih =>
      intro st digits codes bytes first walk trace converts decoded hlen dest
      obtain ⟨st', hindex, walk⟩ := walk
      simp only [EStateM.run] at hindex
      cases trace with
      | nil =>
        have hc : codes = [] := Except.ok.inj converts.symm
        subst codes
        cases decoded
        simp at hlen
      | @cons high highState second restDigits step1 tail1 =>
        obtain ⟨c1, restCodes, hconv1, hconverts, hcodes⟩ :=
          mapM_cons_inv (digitCode toChar) high restDigits codes converts
        subst codes
        cases tail1 with
        | nil =>
          have hc : restCodes = [] := Except.ok.inj hconverts.symm
          subst restCodes
          simp [hexadecimalValue] at decoded
        | @cons low lowState current restDigits step2 tail2 =>
          obtain ⟨c2, restCodes', hconv2, hrestconverts, hcodes⟩ :=
            mapM_cons_inv (digitCode toChar) low restDigits restCodes hconverts
          subst restCodes
          cases hh : hexNibble c1 <;> cases hl : hexNibble c2 <;>
            cases hr : hexadecimalValue restCodes' <;>
            simp [hexadecimalValue, hh, hl, hr, bind, Option.bind] at decoded
          rename_i hi lo restBytes
          subst bytes
          have hn1 := digitCodeNumber toChar high c1 hconv1
          have hn2 := digitCodeNumber toChar low c2 hconv2
          rw [hexByteDecoder, hh] at hn1
          rw [hexByteDecoder, hl] at hn2
          have hcombine := combineNibbles hi lo (hexNibble_bound c1 hi hh) (hexNibble_bound c2 lo hl)
          have htail := ih (some st') restDigits restCodes' restBytes current walk tail2
            hrestconverts hr (by simpa using hlen)
          rw [JuliaLean.base.reduce.whileLoop]
          cases hset : (arr.set i (UInt8.ofNat (16 * hi + lo))).run dest with
          | error e d =>
            simp [EStateM.run] at hset
            simp [step, runHexState, hindex, assertHexTuple, step1, step2, hn1, hn2,
              hcombine, hset, liftHexExcept, toHexResult, writesM, Bind.bind, Except.bind,
              Pure.pure, Except.pure, EStateM.bind, EStateM.pure, EStateM.throw, EStateM.run]
          | ok unit d =>
            cases unit
            simp [EStateM.run] at hset
            simp [step, runHexState, hindex, assertHexTuple, step1, step2, hn1, hn2,
              hcombine, hset, liftHexExcept, toHexResult, writesM, Bind.bind, Except.bind,
              Pure.pure, Except.pure, EStateM.bind, EStateM.pure, EStateM.throw, EStateM.run, htail d]
            exact htail d
  exact go idxs none digits codes bytes first walk trace converts decoded hlen dest

private theorem setByteCell_ok (dest : List UInt8) (i : Index) (b : UInt8)
    (h : 1 ≤ i.val ∧ i.val ≤ Int.ofNat dest.length) :
    setByteCell dest i b = .ok (dest.set (i.val.toNat - 1) b) := by
  simp [setByteCell, JuliaLean.base.array.setindexScalar, JuliaLean.base.array.setindexTyped,
    h.1, h.2, Bind.bind, Pure.pure, StateT.bind, StateT.pure, StateT.run, get, set, modify,
    MonadStateOf.get, MonadStateOf.set, getThe, modifyGet, MonadStateOf.modifyGet,
    StateT.get, StateT.modifyGet, Except.bind, Except.pure, Except.map]
  split <;> simp_all [StateT.pure]
  subst_vars
  rfl

private theorem byteArraySet_ok (dest : List UInt8) (i : Index) (b : UInt8)
    (h : 1 ≤ i.val ∧ i.val ≤ Int.ofNat dest.length) :
    (byteArrayOps.set i b).run dest = .ok () (dest.set (i.val.toNat - 1) b) := by
  simp [byteArrayOps, setByteCell_ok dest i b h, Bind.bind, Pure.pure,
    EStateM.bind, EStateM.pure, EStateM.run, get, getThe, set,
    MonadStateOf.get, MonadStateOf.set, EStateM.get, EStateM.set]

private theorem byteIndexWalk (indices xs : List Index) :
    IndexWalk byteArrayOps indices (some xs) xs := by
  induction xs with
  | nil => intro d; rfl
  | cons i xs ih => exact ⟨xs, fun _ => rfl, ih⟩

private theorem bytePureIndices (dest : List UInt8) :
    PureIndices byteArrayOps dest
      ((List.range dest.length).map (fun k => int (Int.ofNat k + 1))) := by
  let indices := (List.range dest.length).map (fun k => int (Int.ofNat k + 1))
  refine ⟨indices, rfl, ?_⟩
  change IndexWalk byteArrayOps indices none indices
  cases hi : indices with
  | nil => intro d; rfl
  | cons i xs => exact ⟨xs, fun _ => rfl, byteIndexWalk (i :: xs) xs⟩

private theorem setAppendHead (before : List UInt8) (old b : UInt8) (after : List UInt8) :
    (before ++ old :: after).set before.length b = before ++ b :: after := by
  induction before with
  | nil => rfl
  | cons x xs ih => simpa using congrArg (List.cons x) ih

private theorem byteWrites_correct :
    ∀ (bytes : List UInt8) (idxs : List Index) (before old : List UInt8),
    idxs.length = bytes.length →
    old.length = bytes.length →
    (∀ k (hk : k < idxs.length), (idxs[k]).val = Int.ofNat before.length + Int.ofNat k + 1) →
    (writesM byteArrayOps idxs bytes).run (before ++ old) = .ok () (before ++ bytes) := by
  intro bytes
  induction bytes with
  | nil =>
    intro idxs before old hi ho slots
    have hidx : idxs = [] := List.eq_nil_of_length_eq_zero hi
    have hold : old = [] := List.eq_nil_of_length_eq_zero ho
    subst idxs; subst old; rfl
  | cons b bs ih =>
    intro idxs before old hi ho slots
    cases idxs with
    | nil => simp at hi
    | cons i idxs =>
      cases old with
      | nil => simp at ho
      | cons oldHead old =>
        have hindex := slots 0 (by simp)
        change i.val = (before.length : Int) + 0 + 1 at hindex
        have hbound : 1 ≤ i.val ∧ i.val ≤ Int.ofNat (before ++ oldHead :: old).length := by
          change 1 ≤ i.val ∧ i.val ≤ ((before ++ oldHead :: old).length : Int)
          simp only [List.length_append, List.length_cons, Int.natCast_add]
          omega
        have hset := byteArraySet_ok (before ++ oldHead :: old) i b hbound
        have hslot : i.val.toNat - 1 = before.length := by omega
        rw [hslot, setAppendHead] at hset
        have htail := ih idxs (before ++ [b]) old (by simpa using hi) (by simpa using ho) (by
          intro k hk
          have hv := slots (k + 1) (by simp only [List.length_cons]; omega)
          change (idxs[k]).val = (before.length : Int) + ((k + 1 : Nat) : Int) + 1 at hv
          change (idxs[k]).val = (((before ++ [b]).length : Nat) : Int) + (k : Int) + 1
          simp only [List.length_append, List.length_singleton, Int.natCast_add]
          omega)
        simp only [writesM, List.zip_cons_cons, List.forM, Bind.bind, EStateM.bind,
          EStateM.run] at hset htail ⊢
        rw [hset]
        simpa only [List.append_assoc, List.singleton_append] using htail

private theorem hexTwiceVal (n : Nat) (hn : n < 2^62) :
    (int 2 * int n).val = 2 * (n : Int) := by
  change wrapInt .i64 ((int 2).val * (int n).val) = _
  rw [hexIntVal 2 (by omega) (by omega), hexIntVal n (by omega) (by omega)]
  apply wrapInt_of_inRange
  change -9223372036854775808 ≤ 2 * (n : Int) ∧ 2 * (n : Int) ≤ 9223372036854775807
  omega

private theorem hexBangEnter {Array I IS Itr A St : Type}
    (arr : ByteArrayOps Array I IS Error) (it : HexIteratorOps Itr A UInt32 St Error)
    (toChar : A → Result UInt32) (itr : Itr) (dest : Array)
    (len destLen : Index) (is : IS) (first : Option (HexDigit A UInt32 × St))
    (hl : it.length itr = .ok len)
    (hd : arr.length.run dest = .ok destLen dest)
    (he : arr.eachindex.run dest = .ok is dest)
    (hf : it.iterateFirst itr = .ok first)
    (ho : len.val % 2 = 0) (hm : (int 2 * destLen).val = len.val) :
    hex2bytesBang arr it assertHexTuple (.jl ∘ JlError.argumentError) toChar charByte true dest itr =
      if len.val = 0 then some (.ok dest dest)
      else hex2bytesBang.loop arr it assertHexTuple (.jl ∘ JlError.argumentError) toChar charByte
        itr is dest first := by
  simp only [EStateM.run] at hd he
  by_cases hz : len.val = 0 <;>
    simp [hex2bytesBang, hl, hd, he, hf, ho, hm, hz, liftHexExcept,
      Bind.bind, Pure.pure, Except.bind, Except.pure, EStateM.bind, EStateM.pure,
      EStateM.run, EStateM.get, get, getThe, MonadStateOf.get]

set_option maxRecDepth 10000 in
private theorem hexBangValid {Array I IS Itr A St : Type}
    (arr : ByteArrayOps Array I IS Error) (it : HexIteratorOps Itr A UInt32 St Error)
    (toChar : A → Result UInt32) (itr : Itr) (dest : Array)
    (digits : List (HexDigit A UInt32)) (codes bytes : List UInt8) (idxs : List I)
    (input : HexInput it toChar itr digits codes)
    (hlength : arr.length.run dest = .ok (int bytes.length) dest)
    (indices : PureIndices arr dest idxs)
    (hidx : idxs.length = bytes.length)
    (decoded : hexadecimalValue codes = some bytes) :
    hex2bytesBang arr it assertHexTuple (.jl ∘ JlError.argumentError) toChar charByte
      true dest itr = some (match (writesM arr idxs bytes).run dest with
        | .ok _ d => .ok d d
        | .error e d => .error e d) := by
  have hcodes := mapM_length (digitCode toChar) input.converts
  have hbytes := hexadecimalValue_length decoded
  have hdlen : digits.length = 2 * bytes.length := hcodes.trans hbytes
  have hv : (int digits.length).val = (digits.length : Int) :=
    hexIntVal _ (by omega) (by have := input.small; omega)
  have hbsmall : bytes.length < 2^62 := by have := input.small; omega
  have hmul : (int 2 * int bytes.length).val = (int digits.length).val := by
    rw [hexTwiceVal _ hbsmall, hv]
    omega
  have hodd : ¬ (int digits.length).val % 2 ≠ 0 := by rw [hv]; omega
  obtain ⟨first, hfirst, htrace⟩ := input.iterates
  obtain ⟨is, heach, hwalk⟩ := indices
  rw [hexBangEnter arr it toChar itr dest _ _ is first input.length hlength heach hfirst
    (by omega) hmul]
  by_cases hz : digits.length = 0
  · have hbnil : bytes = [] := List.eq_nil_of_length_eq_zero (by omega)
    have hinil : idxs = [] := List.eq_nil_of_length_eq_zero (by omega)
    have hzval : (int digits.length).val = 0 := by rw [hv, hz]; rfl
    have hwrites : (writesM arr idxs bytes).run dest = .ok () dest := by
      rw [hinil, hbnil]; rfl
    simp only [hzval, ↓reduceIte, hwrites]
  · have hnz : (int digits.length).val ≠ 0 := by rw [hv]; omega
    have loop := hexLoopSuccess arr it toChar itr is idxs digits codes bytes first dest
      hwalk htrace input.converts decoded hidx
    simpa only [hnz, ↓reduceIte] using loop

set_option maxRecDepth 10000 in
theorem hexDecodeRoundtrip_proven : HexDecodeRoundtrip := by
  intro Itr A St it toChar itr digits bytes dest input hdest
  have hbytes := hexadecimalValue_length (lowerHexDecode bytes).1
  have hcodes := mapM_length (digitCode toChar) input.converts
  have hdlen : digits.length = 2 * bytes.length := hcodes.trans hbytes
  let idxs := (List.range dest.length).map (fun k => int (Int.ofNat k + 1))
  have hidx : idxs.length = bytes.length := by simp [idxs, hdest]
  have hlength : byteArrayOps.length.run dest = .ok (int bytes.length) dest := by
    change EStateM.Result.ok (int dest.length) dest = _
    rw [hdest]
  have hwrites : (writesM byteArrayOps idxs bytes).run dest = .ok () bytes := by
    have slots : ∀ k (hk : k < idxs.length), (idxs[k]).val = Int.ofNat ([] : List UInt8).length + Int.ofNat k + 1 := by
      intro k hk
      have hk' : k < dest.length := by simpa [idxs] using hk
      have hbsmall : bytes.length < 2^62 := by have := input.small; omega
      simp only [idxs, List.getElem_map, List.getElem_range]
      change (int ((k : Int) + 1)).val = 0 + (k : Int) + 1
      rw [hexIntVal _ (by omega) (by
        change (k : Int) + 1 < 2^63
        omega)]
      omega
    simpa using byteWrites_correct bytes idxs [] dest hidx hdest slots
  have correct := hexBangValid byteArrayOps it toChar itr dest digits (lowerHex bytes) bytes
    idxs input hlength (bytePureIndices dest) hidx (lowerHexDecode bytes).1
  simpa only [hwrites] using correct

