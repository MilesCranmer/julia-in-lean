private theorem ixAdd1 (x : Index) (h0 : 0 ≤ x.val) (h : x.val ≤ 2 ^ 62 + 8) :
    (x + JuliaLean.Strings.ix 1).val = x.val + 1 := by
  change wrapInt .i64 (x.val + wrapInt .i64 1) = _
  rw [show wrapInt .i64 1 = 1 by decide]
  exact wrapInt_of_inRange .i64 _ (by
    simp [IntTy.min, IntTy.max, IntTy.signed, IntTy.bits]; omega)

set_option maxRecDepth 100000 in
theorem contB_iff (b : UInt8) : contB b = true ↔ 128 ≤ b.toNat ∧ b.toNat < 192 := by
  have key : ∀ N, N < 256 → (contB (UInt8.ofNat N) = true ↔ 128 ≤ N ∧ N < 192) := by
    decide
  have hb : b.toNat < 256 := by
    first
      | exact b.toNat_lt
      | exact UInt8.toNat_lt b
      | (have := b.toBitVec.isLt; simpa [UInt8.toNat] using this)
  have := key b.toNat hb
  first
    | rwa [UInt8.ofNat_toNat] at this
    | simpa using this

theorem cont_beq (b : UInt8) : (b &&& 0xc0 == 0x80) = contB b := rfl

theorem cont_bne (b : UInt8) : ((b &&& 0xc0) != 0x80) = !(contB b) := rfl

/-- The four outcomes of `thisindPure` at an index `i ≥ 1`. -/
theorem thisindPure_cases (rd : Int → UInt8) (i : Int) :
    thisindPure rd i = i ∨
    (thisindPure rd i = i - 1 ∧ i - 1 > 0 ∧ contB (rd i) ∧ leadB 1 (rd (i - 1))) ∨
    (thisindPure rd i = i - 2 ∧ i - 2 > 0 ∧ contB (rd i) ∧ contB (rd (i - 1)) ∧
      leadB 2 (rd (i - 2))) ∨
    (thisindPure rd i = i - 3 ∧ i - 3 > 0 ∧ contB (rd i) ∧ contB (rd (i - 1)) ∧
      contB (rd (i - 2)) ∧ leadB 3 (rd (i - 3))) := by
  unfold thisindPure
  simp only [contB, leadB]
  generalize (rd i &&& 0xc0 == 0x80) = c0
  generalize (rd (i - 1) &&& 0xc0 == 0x80) = c1
  generalize (rd (i - 2) &&& 0xc0 == 0x80) = c2
  generalize Str.stringBetweenByte (rd (i - 1)) 0b11000000 0b11110111 = l1
  generalize Str.stringBetweenByte (rd (i - 2)) 0b11100000 0b11110111 = l2
  generalize Str.stringBetweenByte (rd (i - 3)) 0b11110000 0b11110111 = l3
  by_cases h1 : i - 1 > 0 <;> by_cases h2 : i - 2 > 0 <;> by_cases h3 : i - 3 > 0 <;>
    cases c0 <;> cases c1 <;> cases c2 <;> cases l1 <;> cases l2 <;> cases l3 <;>
    simp [h1, h2, h3] <;> omega

/-- Byte facts in `Nat` form, for `omega`. -/
theorem leadB_iff (k : Nat) (b : UInt8) :
    leadB k b = true ↔
      (if k = 1 then 192 else if k = 2 then 224 else 240) ≤ b.toNat ∧ b.toNat ≤ 247 := by
  rcases k with _ | _ | _ | k <;>
    simp [leadB, Str.stringBetweenByte, JuliaLean.base.strings.string.between,
      UInt8.le_iff_toNat_le]

theorem btw80_iff (b : UInt8) :
    Str.stringBetweenByte b 0x80 0xf7 = true ↔ 128 ≤ b.toNat ∧ b.toNat ≤ 247 := by
  simp [Str.stringBetweenByte, JuliaLean.base.strings.string.between, UInt8.le_iff_toNat_le]

theorem lt128_iff (b : UInt8) : b < 128 ↔ b.toNat < 128 := by simp [UInt8.lt_iff_toNat_lt]
theorem lt192_iff (b : UInt8) : b < 192 ↔ b.toNat < 192 := by simp [UInt8.lt_iff_toNat_lt]
theorem lt224_iff (b : UInt8) : b < 224 ↔ b.toNat < 224 := by simp [UInt8.lt_iff_toNat_lt]
theorem lt240_iff (b : UInt8) : b < 240 ↔ b.toNat < 240 := by simp [UInt8.lt_iff_toNat_lt]
theorem ge248_iff (b : UInt8) : 248 ≤ b ↔ 248 ≤ b.toNat := by simp [UInt8.le_iff_toNat_le]
theorem ge192_iff (b : UInt8) : b ≥ 192 ↔ 192 ≤ b.toNat := by
  simp [GE.ge, UInt8.le_iff_toNat_le]
theorem lead1_iff (b : UInt8) : leadB 1 b = true ↔ 192 ≤ b.toNat ∧ b.toNat ≤ 247 := leadB_iff 1 b
theorem lead2_iff (b : UInt8) : leadB 2 b = true ↔ 224 ≤ b.toNat ∧ b.toNat ≤ 247 := leadB_iff 2 b
theorem lead3_iff (b : UInt8) : leadB 3 b = true ↔ 240 ≤ b.toNat ∧ b.toNat ≤ 247 := leadB_iff 3 b
theorem contB_false_iff (b : UInt8) : contB b = false ↔ ¬ (128 ≤ b.toNat ∧ b.toNat < 192) := by
  rw [← contB_iff]; simp

theorem btw80_false_iff (b : UInt8) :
    Str.stringBetweenByte b 0x80 0xf7 = false ↔ ¬ (128 ≤ b.toNat ∧ b.toNat ≤ 247) := by
  rw [← btw80_iff]; simp

theorem bind_ite' {ε α β : Type} (c : Prop) [Decidable c] (x y : Except ε α)
    (f : α → Except ε β) : ((if c then x else y) >>= f) = if c then x >>= f else y >>= f := by
  split <;> rfl
theorem ok_bind' {ε α β : Type} (a : α) (f : α → Except ε β) : (Except.ok a >>= f) = f a := rfl
theorem error_bind' {ε α β : Type} (e : ε) (f : α → Except ε β) :
    (Except.error e >>= f) = Except.error e := rfl
theorem pure_bind' {ε α β : Type} (a : α) (f : α → Except ε β) :
    ((pure a : Except ε α) >>= f) = f a := rfl
theorem throw_bind' {ε α β : Type} (e : ε) (f : α → Except ε β) :
    ((throw e : Except ε α) >>= f) = Except.error e := rfl

theorem ex_ite {ε α : Type} {c : Prop} [Decidable c] {x y : Except ε α} {P : α → Prop}
    (hx : c → ∃ r, x = .ok r ∧ P r) (hy : ¬ c → ∃ r, y = .ok r ∧ P r) :
    ∃ r, (if c then x else y) = .ok r ∧ P r := by
  split
  · exact hx ‹_›
  · exact hy ‹_›

set_option maxHeartbeats 4000000 in
/-- `_nextind_str` (string.jl:276-301) on a byte reader `rd` of a string of `n` code units, at
`1 ≤ i ≤ n`: the next index is `i + 1` exactly when `i` is the last code unit or position
`i + 1` does not continue a character. -/
theorem nextindStr_boundary {S : Type} (ncu : S → Index)
    (cu : Bool → S → Index → Str.StringResult UInt8) (s : S) (rd : Int → UInt8) (i : Index)
    (e0 : JuliaLean.Strings.SErr)
    (hcu : ∀ k : Index, cu false s k =
      if 1 ≤ k.val ∧ k.val ≤ (ncu s).val then .ok (rd k.val) else .error e0)
    (hi1 : 1 ≤ i.val) (hin : i.val ≤ (ncu s).val) (hmax : (ncu s).val < 2 ^ 62) :
    ∃ r, JuliaLean.base.strings.string.nextindStr ncu Str.stringBetweenIndex
      Str.stringBetweenByte cu s i = .ok r ∧
      (r.val = i.val + 1 ↔ (i.val = (ncu s).val ∨ ¬ joined rd (i.val + 1))) := by
  have hcuC : ∀ k : Index, 1 ≤ k.val → k.val ≤ (ncu s).val → cu false s k = .ok (rd k.val) := by
    intro k h1 h2; rw [hcu k, if_pos ⟨h1, h2⟩]
  have hne0 : (i.val == 0) = false := by simp; omega
  have hbtw : Str.stringBetweenIndex i (JuliaLean.Strings.ix 1) (ncu s) = true := by
    simp [Str.stringBetweenIndex, JuliaLean.base.strings.string.between, hin]
    change 1 ≤ i.val
    exact hi1
  have r0 : cu false s i = .ok (rd i.val) := hcuC i hi1 hin
  have v1 := ixAdd1 i (by omega) (by omega)
  have v2 := ixAdd1 (i + JuliaLean.Strings.ix 1) (by omega) (by omega)
  rw [v1] at v2
  have v3 := ixAdd1 (i + JuliaLean.Strings.ix 1 + JuliaLean.Strings.ix 1) (by omega) (by omega)
  rw [v2] at v3
  have v4 := ixAdd1 (i + JuliaLean.Strings.ix 1 + JuliaLean.Strings.ix 1 +
    JuliaLean.Strings.ix 1) (by omega) (by omega)
  rw [v3] at v4
  obtain ⟨r, hr, hrv⟩ := thisindStr_pure ncu cu s rd i hcuC hi1 hin hmax
  have hthis : JuliaLean.base.strings.string.thisindString ncu Str.stringBetweenIndex
      Str.stringBetweenByte cu s i = .ok r := hr
  have hcases := thisindPure_cases rd i.val
  rw [← hrv] at hcases
  have hr0 : 0 ≤ r.val := by rcases hcases with h | h | h | h <;> omega
  have hrle : r.val ≤ i.val := by rcases hcases with h | h | h | h <;> omega
  have u1 := ixAdd1 r hr0 (by omega)
  have u2 := ixAdd1 (r + JuliaLean.Strings.ix 1) (by omega) (by omega)
  rw [u1] at u2
  have u3 := ixAdd1 (r + JuliaLean.Strings.ix 1 + JuliaLean.Strings.ix 1) (by omega) (by omega)
  rw [u2] at u3
  have u4 := ixAdd1 (r + JuliaLean.Strings.ix 1 + JuliaLean.Strings.ix 1 +
    JuliaLean.Strings.ix 1) (by omega) (by omega)
  rw [u3] at u4
  have e1 : i.val + 1 - 1 = i.val := by omega
  have e2 : i.val + 1 - 2 = i.val - 1 := by omega
  have e3 : i.val + 1 - 3 = i.val - 2 := by omega
  have hnj : r.val = i.val → ¬ joined rd i.val := by
    intro h; rw [hrv] at h; exact (thisindPure_eq_iff rd i.val).mp h
  clear hr hrv
  unfold JuliaLean.base.strings.string.nextindStr
  simp only [hne0, hbtw, r0, hthis, hcu, v1, v2, v3, v4, u1, u2, u3, u4, Bool.false_eq_true,
    if_false, Bool.not_true, bind_ite', ok_bind', error_bind', pure_bind', throw_bind']
  clear hcu hcuC r0 hthis hne0 hbtw
  have f11 : i.val - 1 + 1 = i.val := by omega
  have f12 : i.val - 1 + 1 + 1 = i.val + 1 := by omega
  have f13 : i.val - 1 + 1 + 1 + 1 = i.val + 1 + 1 := by omega
  have f14 : i.val - 1 + 1 + 1 + 1 + 1 = i.val + 1 + 1 + 1 := by omega
  have f21 : i.val - 2 + 1 = i.val - 1 := by omega
  have f22 : i.val - 2 + 1 + 1 = i.val := by omega
  have f23 : i.val - 2 + 1 + 1 + 1 = i.val + 1 := by omega
  have f24 : i.val - 2 + 1 + 1 + 1 + 1 = i.val + 1 + 1 := by omega
  have f31 : i.val - 3 + 1 = i.val - 2 := by omega
  have f32 : i.val - 3 + 1 + 1 = i.val - 1 := by omega
  have f33 : i.val - 3 + 1 + 1 + 1 = i.val := by omega
  have f34 : i.val - 3 + 1 + 1 + 1 + 1 = i.val + 1 := by omega
  rcases hcases with h | ⟨h, hp, hc0, hl⟩ | ⟨h, hp, hc0, hc1, hl⟩ | ⟨h, hp, hc0, hc1, hc2, hl⟩
  all_goals
    simp only [h, f11, f12, f13, f14, f21, f22, f23, f24, f31, f32, f33, f34] at *
    repeat' (refine ex_ite (fun hh => ?_) (fun hh => ?_))
  all_goals first
    | omega
    | (refine ⟨_, rfl, ?_⟩
       (try split) <;>
       (simp only [joined, e1, e2, e3, v1, v2, v3, v4, u1, u2, u3, u4, contB_iff, contB_false_iff,
         lead1_iff, lead2_iff, lead3_iff,
         btw80_iff, btw80_false_iff, cont_bne, Bool.not_eq_true', Bool.not_eq_true, Bool.not_eq_false',
         Bool.or_eq_true, Bool.or_eq_false_iff, decide_eq_true_eq,
         decide_eq_false_iff_not, lt128_iff, lt192_iff, lt224_iff, lt240_iff, ge248_iff,
         ge192_iff, Bool.not_eq_eq_eq_not, Bool.not_true, Bool.not_false, true_iff, false_iff,
         iff_true, iff_false, true_implies] at *
        omega))
    | (simp only [contB_iff, contB_false_iff, lead1_iff, lead2_iff, lead3_iff,
         btw80_iff, btw80_false_iff, cont_bne, Bool.not_eq_true', Bool.not_eq_true, Bool.not_eq_false',
         Bool.or_eq_true, Bool.or_eq_false_iff, decide_eq_true_eq,
         decide_eq_false_iff_not, lt128_iff, lt192_iff, lt224_iff, lt240_iff, ge248_iff,
         ge192_iff, Bool.not_eq_eq_eq_not, Bool.not_true, Bool.not_false, true_iff, false_iff,
         iff_true, iff_false, true_implies] at *
       omega)


theorem viewCodeunitAt_total (v : View) (hoff : 0 ≤ v.offset.val)
    (hfit : v.offset.val + v.ncodeunits.val ≤ v.string.bytes.length) (k : Index) :
    viewCodeunitAt false v k =
      if 1 ≤ k.val ∧ k.val ≤ v.ncodeunits.val then
        .ok (parentByte v.string (v.offset.val + k.val))
      else .error (.jl .boundsError) := by
  split
  · rename_i h
    exact viewCodeunitAt_parent v k h.1 h.2 hoff hfit
  · rename_i h
    simp [viewCodeunitAt, viewCodeunit, Sub.codeunitSubStringAt, viewBounds, h, bind,
      Except.bind]

/-- `nextind(a, k) == k + 1` on a good view is `viewBoundary` at `k`. -/
theorem viewNextind_boundary (p : Prepared) (hg : GoodView p.view) (k : Index)
    (h0 : 0 ≤ k.val) (hk : k.val ≤ p.view.ncodeunits.val) :
    ∃ r, following p k = .ok r ∧ ((r.val == k.val + 1) = viewBoundary p k.val.toNat) := by
  have hsmall := p.view.string.small
  have hoff := hg.off
  have hfit := hg.fit
  have hlen := goodView_bytes_length p.view hg
  by_cases hz : k.val = 0
  · have hrun : following p k = .ok (JuliaLean.Strings.ix 1) := by
      have hz' : (k.val == 0) = true := by simp [hz]
      simp [following, viewNextind, Sub.nextindSubString, Str.nextindString,
        JuliaLean.base.strings.string.nextindString, JuliaLean.base.strings.string.nextindStr,
        hz', pure, Except.pure]
    refine ⟨_, hrun, ?_⟩
    have h1 : (JuliaLean.Strings.ix 1).val = 1 := by decide
    have hz0 : k.val.toNat = 0 := by omega
    simp [viewBoundary, h1, hz, hz0]
  · have hcu := viewCodeunitAt_total p.view hoff hfit
    obtain ⟨r, hr, hiff⟩ := nextindStr_boundary (fun v : View => v.ncodeunits) viewCodeunitAt
      p.view (fun x => parentByte p.view.string (p.view.offset.val + x)) k
      (.jl .boundsError) hcu (by omega) hk (by omega)
    have hrun : following p k = .ok r := hr
    refine ⟨r, hrun, ?_⟩
    by_cases hend : k.val = p.view.ncodeunits.val
    · have hv : r.val = k.val + 1 := hiff.mpr (Or.inl hend)
      have hkl : k.val.toNat = (preparedBytes p).length := by
        simp only [preparedBytes]; omega
      simp [viewBoundary, hv, hkl]
    · have hiff' : r.val = k.val + 1 ↔
          ¬ joined (fun x => parentByte p.view.string (p.view.offset.val + x)) (k.val + 1) := by
        rw [hiff]; simp [hend]
      have hk1 := ixAdd1 k h0 (by omega)
      obtain ⟨r1, hr1, hb1⟩ := viewThisind_boundary p hg (k + JuliaLean.Strings.ix 1)
        (by omega) (by omega)
      obtain ⟨r2, hr2, hp2⟩ := viewThisind_pure p.view (k + JuliaLean.Strings.ix 1)
        (by omega) (by omega) hoff hfit
      rw [hr1] at hr2
      injection hr2 with hr12
      subst hr12
      rw [hk1, show k.val + 1 - 1 = k.val by omega] at hb1
      rw [hk1] at hp2
      have hvb : viewBoundary p k.val.toNat = true ↔
          ¬ joined (fun x => parentByte p.view.string (p.view.offset.val + x)) (k.val + 1) := by
        rw [← hb1, beq_iff_eq, hp2]
        exact thisindPure_eq_iff _ _
      cases hv : viewBoundary p k.val.toNat with
      | true =>
        have := hiff'.mpr (hvb.mp hv)
        simp [this]
      | false =>
        have hnv : ¬ r.val = k.val + 1 := by
          intro h
          have := hvb.mpr (hiff'.mp h)
          rw [hv] at this
          exact Bool.false_ne_true this
        simp [hnv]

private theorem prefix_long (A B : List UInt8) (h : A.length < B.length) :
    B.isPrefixOf A = false := by
  cases hp : B.isPrefixOf A with
  | false => rfl
  | true =>
    have hpre : B <+: A := List.isPrefixOf_iff_prefix.mp hp
    have hl := hpre.length_le
    omega

private theorem prefix_iff_take (A B : List UInt8) :
    B.isPrefixOf A = true ↔ A.take B.length = B := by
  rw [List.isPrefixOf_iff_prefix, List.prefix_iff_eq_take]
  exact ⟨fun h => h.symm, fun h => h.symm⟩

theorem startswithDense_bytes (a b : Prepared) (ha : DenseArg a) (hb : DenseArg b) :
    startswithDense denseOps a b =
      .ok ((preparedBytes b).isPrefixOf (preparedBytes a) &&
        viewBoundary a (preparedBytes b).length) := by
  have ga := denseArg_good a ha
  have gb := denseArg_good b hb
  have hA : ((preparedBytes a).length : Int) = a.view.ncodeunits.val :=
    goodView_bytes_length a.view ga
  have hB : ((preparedBytes b).length : Int) = b.view.ncodeunits.val :=
    goodView_bytes_length b.view gb
  have hsa := a.view.string.small
  have hsb := b.view.string.small
  have hfa := ga.fit
  have hfb := gb.fit
  have hoa := ga.off
  have hob := gb.off
  by_cases hlt : a.view.ncodeunits.val < b.view.ncodeunits.val
  · have hlong : (preparedBytes a).length < (preparedBytes b).length := by omega
    simp [startswithDense, denseOps, hlt, prefix_long _ _ hlong, pure, Except.pure]
  · have hle : (preparedBytes b).length ≤ (preparedBytes a).length := by omega
    have hsize : (sizeofString preparedOps b).val = Int.ofNat (preparedBytes b).length := by
      change wrapInt .i64 (b.view.ncodeunits.val * (int 1).val) = _
      rw [show (int 1).val = 1 by decide, Int.mul_one, hB.symm]
      exact wrapInt_of_inRange .i64 _ (by
        simp [IntTy.min, IntTy.max, IntTy.signed, IntTy.bits]; omega)
    have hcmp0 := compareBytes_zero_iff (preparedBytes a) (preparedBytes b)
      (sizeofString preparedOps b) (preparedBytes b).length hsize hle (Nat.le_refl _) (by omega)
    have hcmp : compareBytes (preparedBytes a) (preparedBytes b) (sizeofString preparedOps b) = 0 ↔
        (preparedBytes b).isPrefixOf (preparedBytes a) = true := by
      rw [hcmp0, List.take_of_length_le (Nat.le_refl _), prefix_iff_take]
    have hcub : (b.view.ncodeunits + int 1).val = b.view.ncodeunits.val + 1 := by
      change wrapInt .i64 (b.view.ncodeunits.val + (int 1).val) = _
      rw [show (int 1).val = 1 by decide]
      exact wrapInt_of_inRange .i64 _ (by
        simp [IntTy.min, IntTy.max, IntTy.signed, IntTy.bits]; omega)
    by_cases hz : compareBytes (preparedBytes a) (preparedBytes b) (sizeofString preparedOps b) = 0
    · have hmatch := hcmp.mp hz
      obtain ⟨r, hr, hrb⟩ := viewNextind_boundary a ga b.view.ncodeunits (by omega) (by omega)
      have hk : b.view.ncodeunits.val.toNat = (preparedBytes b).length := by omega
      rw [hk] at hrb
      simp [startswithDense, denseOps, hlt, hz, hr, hcub, hmatch, ← hrb, bind, Except.bind,
        pure, Except.pure]
    · have hnomatch : (preparedBytes b).isPrefixOf (preparedBytes a) = false := by
        cases hm : (preparedBytes b).isPrefixOf (preparedBytes a) with
        | false => rfl
        | true => exact absurd (hcmp.mpr hm) hz
      simp [startswithDense, denseOps, hlt, hz, hnomatch, bind, Except.bind, pure, Except.pure]

theorem densePrefixBytesRound6_proven : DensePrefixBytes := by
  intro a b ha hb
  exact startswithDense_bytes a b ha hb

theorem fastPrefixBytesRound6_proven : FastPrefixBytes := by
  intro a b ha hb
  exact startswithDense_bytes a b ha hb

