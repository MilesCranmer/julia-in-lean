selection. Error outcomes have the same independent address/representability requirements. -/
def PublicSelectionOutcome (ranges : Region64) (selectors : List SliceIndex64)
    (outcome : RegionResult RegionSelection64) : Prop :=
  match outcome with
  | .ok (.scalar index) => ranges.length = 0 ∧ selectors.length = 0 ∧ index.length = 0
  | .ok (.region output) =>
    0 < ranges.length ∧ SliceRegionOutcome ranges selectors (.ok output)
  | .error error => SliceRegionOutcome ranges selectors (.error error)

