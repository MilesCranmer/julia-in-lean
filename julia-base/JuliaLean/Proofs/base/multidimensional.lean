inductive PairsShowEvent (E IO TypeObject Rendered Value : Type) where
  | interpolate (initialPart : String) (typeObject : TypeObject) (suffix : String)
      (reply : Except E Rendered)
  | print (io : IO) (rendered : Rendered) (reply : Except E Value)

def observePairsShowOps {E S IO TypeObject Rendered Value : Type}
    (ops : PairsShowOps (DimensionObservationM E S) IO TypeObject Rendered Value) :
    PairsShowOps
      (DimensionObservationM E
        (S × List (S × S × PairsShowEvent E IO TypeObject Rendered Value)))
      IO TypeObject Rendered Value where
  interpolate := fun initialPart typeObject suffix =>
    observeDimensionAction (ops.interpolate initialPart typeObject suffix)
      (.interpolate initialPart typeObject suffix)
  print := fun io rendered => observeDimensionAction (ops.print io rendered) (.print io rendered)

/-- Display provenance, independent of interpolation and IO implementations:
formatting observes the actual static type object between the fixed literal
parts; its actual returned object reaches the original stream exactly once.
The result is the final print result, and the first error retains its mutation
while suppressing later output. -/
def PairsShowTrace {E S IO TypeObject Rendered Value : Type}
    (initialPart : String) (io : IO) (typeObject : TypeObject)
    (initial final : S) (result : Except E Value)
    (records : List (S × S × PairsShowEvent E IO TypeObject Rendered Value)) : Prop :=
  (∃ error, result = .error error ∧
    records = [(initial, final, .interpolate initialPart typeObject ")" (.error error))]) ∨
  (∃ rendered middle, records =
    [(initial, middle, .interpolate initialPart typeObject ")" (.ok rendered)),
     (middle, final, .print io rendered result)])

/-- Both ordinary Pairs showarg overloads retain the same exact static T
binding and stream and never inspect the pair payload or toplevel argument.
The interpolation and print methods may return nonstandard objects, mutate
shared IO state, fail, or diverge. No formatting-correctness or purity premise
is imposed. Source: base/multidimensional.jl:1839-1844. -/
def PairsOrdinaryShowObservations : Prop :=
  ∀ (E S IO TypeObject Pair Top Rendered Value : Type)
    (ops : PairsShowOps (DimensionObservationM E S) IO TypeObject Rendered Value)
    (io : IO) (typeObject : TypeObject) (pair replacement : Pair)
    (toplevel replacementTop : Top) (initial : S),
    let observed := observePairsShowOps ops
    let result := (showPairsOrdinaryOpen observed io typeObject pair toplevel).run (initial, [])
    result = (showPairsOrdinaryOpen observed io typeObject replacement replacementTop).run (initial, []) ∧
    match result with
    | none => True
    | some (reply, (final, records)) =>
        PairsShowTrace "pairs(::" io typeObject initial final reply records

theorem pairsOrdinaryShowObservations_proven :
    Models2Group3.PairsOrdinaryShowObservations := by
  intro E S IO TypeObject Pair Top Rendered Value ops io typeObject pair replacement toplevel replacementTop initial
  refine ⟨rfl, ?_⟩
  unfold Models2Group3.showPairsOrdinaryOpen Models2Group3.observePairsShowOps
  dsimp only
  rw [observeDimensionAction_bind_run]
  cases (ops.interpolate "pairs(::" typeObject ")").run initial with
  | none => trivial
  | some p1 =>
      rcases p1 with ⟨r1, s1⟩
      cases r1 with
      | error e => exact Or.inl ⟨e, rfl, rfl⟩
      | ok rendered =>
          dsimp only
          rw [observeDimensionAction_run]
          cases (ops.print io rendered).run s1 with
          | none => trivial
          | some p2 => exact Or.inr ⟨rendered, s1, rfl⟩

/-- Cartesian-vector Pairs use the literal IndexCartesian marker before the
actual static T binding. All callback choices, arbitrary return values, shared
mutations and errors remain in the domain; changing the unused pair/toplevel
