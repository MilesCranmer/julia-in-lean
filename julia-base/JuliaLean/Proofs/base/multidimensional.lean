    (a2 : A → Models2Group3.DimensionObservationM E W Out) (ev2 : A → Except E Out → Event)
    (hp1 : ∀ r, phase (ev1 r) = 0) (hp2 : ∀ x r, phase (ev2 x r) = 1)
    (he1_ok : ∀ x, error (ev1 (.ok x)) = none)
    (he1_err : ∀ e, error (ev1 (.error e)) = some e)
    (he2_ok : ∀ x v, error (ev2 x (.ok v)) = none)
    (he2_err : ∀ x e, error (ev2 x (.error e)) = some e)
    (hret : ∀ x r, returned (ev2 x r) = some r)
    (hc1 : ∀ e, coherent [ev1 (.error e)])
    (hc2 : ∀ x r, coherent [ev1 (.ok x), ev2 x r])
    (world : W) :
    Models2Group3.EarlySequenceObservation [0, 1] phase error returned coherent world
      ((Bind.bind (Models2Group3.observeDimensionAction a1 ev1)
        (fun x => Models2Group3.observeDimensionAction (a2 x) (ev2 x))).run (world, [])) := by
  rw [observeDimensionAction_bind_run]
  cases a1.run world with
  | none => trivial
  | some p1 =>
      rcases p1 with ⟨r1, s1⟩
      cases r1 with
      | error e1 =>
          refine ⟨dimensionStateThread_one world s1 _, hc1 e1, ⟨[1], by simp [hp1]⟩, ?_, ⟨_, rfl, he1_err e1⟩⟩
          intro k ev hk ex hex
          cases k with
          | zero => injection hk with hk; subst hk; rw [he1_err] at hex; injection hex with hex; subst hex; exact ⟨rfl, rfl⟩
          | succ k => cases hk
      | ok v1 =>
          dsimp only
          rw [observeDimensionAction_run]
          cases (a2 v1).run s1 with
          | none => trivial
          | some p2 =>
              rcases p2 with ⟨r2, s2⟩
              refine ⟨dimensionStateThread_two world s1 s2 _ _, hc2 v1 r2, ⟨[], by simp [hp1, hp2]⟩, ?_, ?_⟩
              · intro k ev hk ex hex
                cases k with
                | zero => injection hk with hk; subst hk; rw [he1_ok] at hex; cases hex
                | succ k =>
                    cases k with
                    | zero =>
                        injection hk with hk; subst hk
                        cases r2 with
                        | ok v2 => rw [he2_ok] at hex; cases hex
                        | error e2 => rw [he2_err] at hex; injection hex with hex; subst hex; exact ⟨rfl, rfl⟩
                    | succ k => cases hk
              · cases r2 with
                | ok v2 => exact ⟨by simp [hp1, hp2], _, rfl, hret v1 (.ok v2)⟩
                | error e2 => exact ⟨_, rfl, he2_err v1 e2⟩

