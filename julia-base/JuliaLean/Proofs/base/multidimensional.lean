      | cartesian coordinates => rfl
      | integer input =>
          cases input with
          | bool value => rfl
          | big reference => rfl
          | custom value => rfl
          | bits type value =>
              cases type <;> try rfl
              simp only [mixedOnlyMachineInts] at h
              cases ht : mixedOnlyMachineInts tail with
              | some rest => simp only [ht, Option.map_some] at h; cases h
              | none =>
                  simp only [List.cons_append, mixedOnlyMachineInts, ih ht, Option.map_none]

private theorem mc_closed_failure
    {State ARef BigRef Ptr Custom Value : Type}
    (runtime : MixedIndexRuntime (Effects State) ARef BigRef Ptr Custom Value)
