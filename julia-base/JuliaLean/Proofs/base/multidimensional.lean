inductive CircshiftEvent (E Dest Src Integer Rank V Output : Type) where
  | sourceAxes (src : Src) (reply : AccessResult E V)
  | destAxes (dest : Dest) (reply : AccessResult E V)
  | equal (left right : V) (reply : AccessResult E (Sum Bool V))
  | empty (src : Src) (reply : AccessResult E (Sum Bool V))
  | val (rank : Rank) (reply : AccessResult E V)
  | fill (shifts : List Integer) (zero : I64) (val : V) (reply : AccessResult E V)
  | shift (dest : Dest) (rdest : List Unit) (src : Src) (rsrc : List Unit)
      (axes padded : V) (reply : AccessResult E Output)
  | format (initialPart : String) (sourceAxes : V) (separator : String) (destAxes : V) (suffix : String)
      (reply : AccessResult E (Sum String V))
  | constructError (value : V) (reply : AccessResult E (Sum Error E))

def circshiftEventPhase {E Dest Src Integer Rank V Output : Type} :
    CircshiftEvent E Dest Src Integer Rank V Output → Nat
  | .sourceAxes _ _ => 0
  | .destAxes _ _ => 1
  | .equal _ _ _ => 2
  | .format _ _ _ _ _ _ => 3
  | .constructError _ _ => 4
  | .empty _ _ => 5
  | .val _ _ => 6
  | .fill _ _ _ _ => 7
  | .shift _ _ _ _ _ _ _ => 8

def circshiftEventError {E Dest Src Integer Rank V Output : Type} :
    CircshiftEvent E Dest Src Integer Rank V Output → Option (Sum Error E)
  | .sourceAxes _ (.error error) | .destAxes _ (.error error)
  | .equal _ _ (.error error) | .empty _ (.error error) | .val _ (.error error)
  | .fill _ _ _ (.error error) | .shift _ _ _ _ _ _ (.error error)
  | .format _ _ _ _ _ (.error error) | .constructError _ (.error error) => some error
  | _ => none

def circshiftControlNonBool {E Dest Src Integer Rank V Output : Type} :
    CircshiftEvent E Dest Src Integer Rank V Output → Prop
  | .equal _ _ (.ok (.inr _)) | .empty _ (.ok (.inr _)) => True
  | _ => False

def observeCircshiftGenericOps {E S Dest Src Integer Rank V Output : Type}
    (ops : CircshiftGenericOps (AccessEffects S E) Dest Src Integer Rank V Output E) :
    CircshiftGenericOps
      (AccessEffects (S × List (S × S × CircshiftEvent E Dest Src Integer Rank V Output)) E)
      Dest Src Integer Rank V Output E where
  same := ops.same
  axesSrc := fun src => observeAccessAction (ops.axesSrc src) (.sourceAxes src)
  axesDest := fun dest => observeAccessAction (ops.axesDest dest) (.destAxes dest)
  equalAxes := fun left right => observeAccessAction (ops.equalAxes left right) (.equal left right)
  isempty := fun src => observeAccessAction (ops.isempty src) (.empty src)
  val := fun rank => observeAccessAction (ops.val rank) (.val rank)
  fill := fun shifts zero val => observeAccessAction (ops.fill shifts zero val) (.fill shifts zero val)
  shift := fun dest rd src rs axes padded =>
    observeAccessAction (ops.shift dest rd src rs axes padded) (.shift dest rd src rs axes padded)
  formatMismatch := fun p source sep dest tail =>
    observeAccessAction (ops.formatMismatch p source sep dest tail) (.format p source sep dest tail)
  argumentError := fun value => observeAccessAction (ops.argumentError value) (.constructError value)

/-- Every event retains exact source argument provenance and the Boolean
branch decision required to reach it. Repeated destination axes are observed
again, not reused from the first call. -/
def CircshiftDataflow {E Dest Src Integer Rank V Output : Type}
    (dest : Dest) (src : Src) (rank : Rank) (shifts : List Integer)
    (events : List (CircshiftEvent E Dest Src Integer Rank V Output)) : Prop :=
  ∀ event ∈ events, match event with
  | .sourceAxes actual _ => actual = src
  | .destAxes actual _ => actual = dest
  | .equal left right _ =>
      .destAxes dest (.ok left) ∈ events ∧ .sourceAxes src (.ok right) ∈ events
  | .format initialPart source separator repeated suffix _ =>
      initialPart = "indices of src and dest must match (got " ∧ separator = " and " ∧ suffix = ")" ∧
      .sourceAxes src (.ok source) ∈ events ∧ events[3]? = some (.destAxes dest (.ok repeated)) ∧
      ∃ original, .equal original source (.ok (.inl false)) ∈ events
  | .constructError value _ =>
      ∃ source repeated, .format "indices of src and dest must match (got " source
        " and " repeated ")" (.ok (.inr value)) ∈ events
  | .empty actual _ =>
      actual = src ∧ ∃ left right, .equal left right (.ok (.inl true)) ∈ events
  | .val actual _ => actual = rank ∧ .empty src (.ok (.inl false)) ∈ events
  | .fill actual zero val _ =>
      actual = shifts ∧ zero.val = 0 ∧ .val rank (.ok val) ∈ events
  | .shift actualDest rd actualSrc rs axes padded _ =>
      actualDest = dest ∧ actualSrc = src ∧ rd = [] ∧ rs = [] ∧
      .sourceAxes src (.ok axes) ∈ events ∧
      ∃ val, .fill shifts (int 0) val (.ok padded) ∈ events

/-- First failures and branch outcomes from actual observations, including
non-Bool control values and constructor returns. -/
def CircshiftOutcome {E Dest Src Integer Rank V Output : Type}
    (dest : Dest) (src : Src)
    (events : List (CircshiftEvent E Dest Src Integer Rank V Output))
    (result : AccessResult E (Sum Dest Output)) : Prop :=
  (∀ (k : Nat) (event : CircshiftEvent E Dest Src Integer Rank V Output),
    events[k]? = some event →
    (∀ error, circshiftEventError event = some error → k + 1 = events.length ∧ result = .error error) ∧
    (circshiftControlNonBool event → k + 1 = events.length ∧ result = .error (.inl .typeError))) ∧
  (match result with
   | .ok (.inl value) => value = dest ∧ events.getLast? = some (.empty src (.ok (.inl true)))
   | .ok (.inr value) =>
       events.length = 7 ∧ ∃ axes padded,
         events.getLast? = some (.shift dest [] src [] axes padded (.ok value))
   | .error error =>
       ∃ event, events.getLast? = some event ∧
         (circshiftEventError event = some error ∨
          (circshiftControlNonBool event ∧ error = .inl .typeError) ∨
          (∃ source repeated message,
            event = .format "indices of src and dest must match (got " source " and " repeated ")"
              (.ok (.inl message)) ∧ error = .inl (.argumentError message)) ∨
          (∃ value, event = .constructError value (.ok error))))

/-- Full selected DimsInteger body: no input is restricted to one-based axes,
native metadata, a nonempty source, nonaliasing or successful dispatch. The
Core identity branch has no effects. Rank and Integer subtype are unfixed;
only actual input tuple arity is bounded. Source:
base/multidimensional.jl:1257-1263. -/
def CircshiftGenericObservations : Prop :=
  ∀ (E S Dest Src Integer Rank V Output : Type)
    (ops : CircshiftGenericOps (AccessEffects S E) Dest Src Integer Rank V Output E)
    (dest : Dest) (src : Src) (rank : Rank) (shifts : List Integer) (initial : S),
    TupleArity shifts →
    let observed := accessRun (circshiftGeneric (observeCircshiftGenericOps ops) dest src rank shifts)
      (initial, [])
    if ops.same dest src then
      observed = some (.error (.inl (.argumentError "dest and src must be separate arrays")), (initial, []))
    else
      match observed with
      | none => True
      | some (result, (final, records)) =>
          let events := records.map (fun record => record.2.2)
          AccessStateThread initial final records ∧
          ((∃ suffix, events.map circshiftEventPhase ++ suffix = [0, 1, 2, 1, 3, 4]) ∨
           (∃ suffix, events.map circshiftEventPhase ++ suffix = [0, 1, 2, 5, 6, 7, 8])) ∧
          CircshiftDataflow dest src rank shifts events ∧ CircshiftOutcome dest src events result

def GenericCircshiftEntries : List Entry := [
