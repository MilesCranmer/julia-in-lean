    rfl

theorem rt_cartesian_first_value (iterator : CartesianFields) :
    cartesianFirstValue iterator = .ok (iterator.ranges.map fun component =>
      (JuliaLean.Proofs.base.multidimensional.Models1Group6.NativeBounds.ComponentEndpoints component).1) := by
