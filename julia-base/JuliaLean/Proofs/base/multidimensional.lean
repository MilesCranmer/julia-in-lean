  | .length _ (.error error) | .notOne _ _ (.error error) | .dimensions _ (.error error)
  | .notDimensions _ _ (.error error) | .linear _ _ (.error error) | .subscripts _ _ (.error error)
  | .scalar _ _ _ (.error error) | .splat _ _ _ (.error error) | .access _ _ (.error error) => some error
  | _ => none

def observeIntegerAssignedOps {Extra S A Integer Value Other : Type}
    (ops : IntegerAssignedOps (ConstructorObservationM Extra S) A Integer Value Other) :
    IntegerAssignedOps
      (ConstructorObservationM Extra
        (S × List (S × S × IntegerAssignedEvent Extra A Integer Value Other)))
      A Integer Value Other where
  toIndices := fun array indices => observeConstructorAction (ops.toIndices array indices) (.convert array indices)
  checkboundsSplat := fun array indices => observeConstructorAction (ops.checkboundsSplat array indices) (.bounds array indices)
