/-- All possible total custom get methods represented by arbitrary return or
exception values and arbitrary final states terminate transparently. Defaults
and result values have independent types, so no result coercion is hidden.
Source: base/multidimensional.jl:108. -/
def GetDefaultRepliesPreserved : Prop :=
  ∀ (S E A D V : Type) (array : A) (index : CI) (default : D)
    (initial final : S) (reply : AccessResult E V), AccessTupleArity index →
    let ops : GetOps (AccessEffects S E) A D V := {
      get := fun _ _ _ => accessReply reply final }
