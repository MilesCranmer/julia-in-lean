theorem tp_length_value {Value : Type} (fields : Fields Value) :
    (int (JuliaLean.base.tuple.lengthTuple fields.items)).val =
      (fields.items.length : Int) := by
  change wrapInt .i64 (fields.items.length : Int) = (fields.items.length : Int)
  exact wrapInt_of_inRange .i64 (fields.items.length : Int)
    ⟨Int.le_trans (by decide) (Int.natCast_nonneg _), fields.lengthFits⟩

theorem tp_successor_value (position : I64) :
    (JuliaLean.base.int.add position (int 1)).val =
      wrapInt .i64 (position.val + 1) := by
  rw [JuliaLean.base.int.add, JuliaLean.Proofs.base.int.add_int_val, int_one]

theorem tp_iterate_eq {Value : Type} (fields : Fields Value) (position : I64) :
    iterateInt fields position =
      .ok (if 1 ≤ position.val then
        fields.items[(position.val - 1).toNat]?.map
          (fun value => (value, JuliaLean.base.int.add position (int 1)))
        else none) := by
  by_cases hlo : 1 ≤ position.val
  · by_cases hhi : position.val ≤ (fields.items.length : Int)
    · have hk : (position.val - 1).toNat < fields.items.length := by omega
      obtain ⟨value, hvalue⟩ : ∃ value,
          fields.items[(position.val - 1).toNat]? = some value :=
        ⟨fields.items[(position.val - 1).toNat], List.getElem?_eq_getElem hk⟩
      have hindex : (position.val - 1).toNat = position.val.toNat - 1 := by omega
      rw [hindex] at hvalue
      simp [iterateInt, JuliaLean.Proofs.base.int.le_eq, int_one, tp_length_value,
        hlo, hhi, JuliaLean.base.tuple.getindexInt, JuliaLean.base.tuple.getfield,
        hvalue, bind, Except.bind, pure, Except.pure]
    · have hk : fields.items.length ≤ (position.val - 1).toNat := by omega
      have hvalue := List.getElem?_eq_none hk
      have hindex : (position.val - 1).toNat = position.val.toNat - 1 := by omega
      rw [hindex] at hvalue
      simp [iterateInt, JuliaLean.Proofs.base.int.le_eq, int_one, tp_length_value,
        hlo, hhi, hvalue, bind, Except.bind, pure, Except.pure]
  · simp [iterateInt, JuliaLean.Proofs.base.int.le_eq, int_one, hlo,
      bind, Except.bind, pure, Except.pure]

theorem Models1G6NativeTupleFirst_proven :
    JuliaLean.Proofs.base.multidimensional.Models1Group6.NativeTupleIteration.FirstIsHead := by
  intro Value fields
  rw [first, tp_iterate_eq]
  cases fields.items <;> rfl

theorem tp_native_position_outcome {Value Other : Type}
    (fields : Fields Value) (position : I64) :
    JuliaLean.Proofs.base.multidimensional.Models1Group6.NativeTupleIteration.PositionOutcome
      fields (State.native (Other := Other) position) (iterateInt fields position) := by
  rw [tp_iterate_eq]
  unfold JuliaLean.Proofs.base.multidimensional.Models1Group6.NativeTupleIteration.PositionOutcome
  refine ⟨⟨_, rfl⟩, ?_, ?_⟩
  · constructor
    · intro hnone entry hentry hposition
      have hlo : 1 ≤ position.val := by omega
      have hk : (position.val - 1).toNat = entry.2 := by omega
      have hget := List.mem_zipIdx_iff_getElem?.mp hentry
      rw [if_pos hlo, hk, hget] at hnone
      cases hnone
    · intro hpositions
      by_cases hlo : 1 ≤ position.val
      · rw [if_pos hlo]
        cases hget : fields.items[(position.val - 1).toNat]? with
        | none => rfl
        | some value =>
          have hmem : (value, (position.val - 1).toNat) ∈ fields.items.zipIdx :=
            List.mk_mem_zipIdx_iff_getElem?.mpr hget
          have hposition : ((position.val - 1).toNat : Int) + 1 = position.val := by omega
          exact False.elim (hpositions (value, (position.val - 1).toNat) hmem hposition)
