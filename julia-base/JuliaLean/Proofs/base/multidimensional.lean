      A Element Pointer Shape Strides Other where
  elementSize := fun array => observeConstructorAction (ops.elementSize array) (.element array)
  pointer := fun array => observeConstructorAction (ops.pointer array) (.pointer array)
  size := fun array => observeConstructorAction (ops.size array) (.size array)
  strides := fun array => observeConstructorAction (ops.strides array) (.strides array)
  equalElementSize := fun left right => observeConstructorAction (ops.equalElementSize left right) (.equalElement left right)
  equalPointer := fun left right => observeConstructorAction (ops.equalPointer left right) (.equalPointer left right)
  equalSize := fun left right => observeConstructorAction (ops.equalSize left right) (.equalSize left right)
  equalStrides := fun left right => observeConstructorAction (ops.equalStrides left right) (.equalStrides left right)

