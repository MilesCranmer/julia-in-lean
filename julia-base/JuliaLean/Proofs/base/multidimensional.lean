abbrev RegionMapped (R V N : Type) := Sum (List (RegionShowField R V)) N

/-- Calls visible at the actual dispatch and existing runtime boundaries. -/
inductive RegionShowEvent (IO R V N Return Error : Type) where
  | print (io : IO) (text : String) (reply : Except Error Return)
  | transform (range : R) (reply : Except Error (RegionShowField R V))
  | map (ranges : List (RegionShowRange R)) (reply : Except Error (RegionMapped R V N))
  | splat (head : RegionShowField R V) (tail : N)
      (reply : Except Error (List (RegionShowField R V)))
  | valueShow (io : IO) (mapped : RegionMapped R V N) (reply : Except Error Return)
  | direct (io : IO) (ranges : List (RegionShowRange R)) (reply : Except Error Return)

abbrev RegionShowPrimitive (World Error : Type) := ExceptT Error (StateT World Option)

/-- Audit data is inaccessible to selected user operations. State outside
Except retains mutation even when an arbitrary Julia object is thrown. -/
structure RegionShowAudit (World IO R V N Return Error : Type) where
  world : World
  events : List (RegionShowEvent IO R V N Return Error) := []
  lastWorld : Option World := none

abbrev RegionShowObserved (World IO R V N Return Error : Type) :=
  ExceptT Error (StateT (RegionShowAudit World IO R V N Return Error) Option)

def regionShowObserve {World IO R V N Return Error A : Type}
    (action : RegionShowPrimitive World Error A)
    (record : Except Error A → RegionShowEvent IO R V N Return Error) :
    RegionShowObserved World IO R V N Return Error A :=
  ExceptT.mk fun audit => do
    let (reply, nextWorld) ← action.run audit.world
    pure (reply,
      { world := nextWorld, events := audit.events ++ [record reply], lastWorld := some nextWorld })

/-- Instrument original callees without laws on their values or effects. -/
def regionShowObserveOps {World IO R V N Return Error : Type}
    (ops : RegionShowOps (RegionShowPrimitive World Error) IO R V N Return) :
    RegionShowOps (RegionShowObserved World IO R V N Return Error) IO R V N Return where
  printString := fun io text => regionShowObserve (ops.printString io text) (.print io text)
  showMapped := fun io mapped => regionShowObserve (ops.showMapped io mapped) (.valueShow io mapped)
  transform := fun range => (ops.transform range).map fun action =>
    regionShowObserve action (.transform range)
  mapSelected := fun _ ranges => (ops.mapSelected (regionShowTransform ops) ranges).map fun action =>
    regionShowObserve action (.map ranges)
  applyIterateOther := fun head tail =>
    regionShowObserve (ops.applyIterateOther head tail) (.splat head tail)
  showSelected := fun io ranges => (ops.showSelected io ranges).map fun action =>
    regionShowObserve action (.direct io ranges)

structure RegionPrintCall (IO Return Error : Type) where
  io : IO
  text : String
  reply : Except Error Return

structure RegionSplatCall (R V N Error : Type) where
  head : RegionShowField R V
  tail : N
  reply : Except Error (List (RegionShowField R V))

structure RegionValueShowCall (IO R V N Return Error : Type) where
  io : IO
  mapped : RegionMapped R V N
  reply : Except Error Return

def regionPrintCalls {IO R V N Return Error : Type}
    (events : List (RegionShowEvent IO R V N Return Error)) :
    List (RegionPrintCall IO Return Error) :=
  events.filterMap fun event => match event with
    | .print io text reply => some ⟨io, text, reply⟩
    | _ => none

def regionTransformCalls {IO R V N Return Error : Type}
    (events : List (RegionShowEvent IO R V N Return Error)) :
    List (R × Except Error (RegionShowField R V)) :=
  events.filterMap fun event => match event with
    | .transform range reply => some (range, reply)
    | _ => none

def regionMapCalls {IO R V N Return Error : Type}
    (events : List (RegionShowEvent IO R V N Return Error)) :
    List (List (RegionShowRange R) × Except Error (RegionMapped R V N)) :=
  events.filterMap fun event => match event with
    | .map ranges reply => some (ranges, reply)
    | _ => none

def regionSplatCalls {IO R V N Return Error : Type}
    (events : List (RegionShowEvent IO R V N Return Error)) :
    List (RegionSplatCall R V N Error) :=
  events.filterMap fun event => match event with
    | .splat head tail reply => some ⟨head, tail, reply⟩
    | _ => none

def regionValueShowCalls {IO R V N Return Error : Type}
    (events : List (RegionShowEvent IO R V N Return Error)) :
    List (RegionValueShowCall IO R V N Return Error) :=
  events.filterMap fun event => match event with
    | .valueShow io mapped reply => some ⟨io, mapped, reply⟩
    | _ => none

def regionReplyError {Error A : Type} : Except Error A → Option Error
  | .ok _ => none
  | .error error => some error

def regionShowEventError {IO R V N Return Error : Type} :
    RegionShowEvent IO R V N Return Error → Option Error
  | .print _ _ reply => regionReplyError reply
  | .transform _ reply => regionReplyError reply
  | .map _ reply => regionReplyError reply
  | .splat _ _ reply => regionReplyError reply
  | .valueShow _ _ reply => regionReplyError reply
  | .direct _ _ reply => regionReplyError reply

/-- Julia's terminal arities give the possible map call depths directly.
The independent search concerns only static selected-method metadata; it
never executes a mapper or duplicates its recursive implementation. -/
def regionMapSelectedDepth {m : Type → Type} [Monad m] {IO R V N Return : Type}
    (ops : RegionShowOps m IO R V N Return) (input : List (RegionShowRange R)) : Option Nat :=
  let lastDepth := if input.length < 32 then input.length - 3 else 0
  (List.range (lastDepth + 1)).find? fun depth =>
    regionShowHasOther (input.drop depth) &&
      (ops.mapSelected (regionShowTransform ops) (input.drop depth)).isSome

/-- Selected element operations in source position order. -/
def regionSelectedTransforms {m : Type → Type} {IO R V N Return : Type}
    (ops : RegionShowOps m IO R V N Return) (input : List (RegionShowRange R)) : List R :=
  input.filterMap fun range => match range with
    | .stored _ => none
    | .other value => if (ops.transform value).isSome then some value else none

/-- Positional projection of expected display fields. OneTo is specified by
its stored stop, not by a model call. Other native tags retain their identity;
custom results come from their observed replies, with no correctness law.
The j-th custom reply is used at the j-th selected original position. -/
def regionExpectedFields {m : Type → Type} {IO R V N Return Error : Type}
    (ops : RegionShowOps m IO R V N Return) (input : List (RegionShowRange R))
    (conversions : List (R × Except Error (RegionShowField R V))) :
    Option (List (RegionShowField R V)) :=
  (List.range input.length).mapM fun position => do
    let range ← input[position]?
    match range with
    | .stored (.oneTo value) => return .integer value.stop
    | .stored value => return .stored value
    | .other value =>
        if (ops.transform value).isSome then
          let reply ← conversions[(regionSelectedTransforms ops (input.take position)).length]?
          match reply.2 with
          | .ok returned => some returned
          | .error _ => none
        else return .range value

/-- Independent concatenation specification. A custom tuple-map result keeps
its complete fields; a non-Tuple at the outermost call remains a non-Tuple.
Only a non-Tuple delegated tail has an actual runtime splat, and the untouched
outer prefix is prepended to that runtime's returned fields. -/
def regionExpectedMapped {m : Type → Type} [Monad m] {IO R V N Return Error : Type}
    (ops : RegionShowOps m IO R V N Return) (input : List (RegionShowRange R))
    (conversions : List (R × Except Error (RegionShowField R V)))
    (maps : List (List (RegionShowRange R) × Except Error (RegionMapped R V N)))
    (splats : List (RegionSplatCall R V N Error)) : Option (RegionMapped R V N) := do
  match regionMapSelectedDepth ops input with
  | none => return .inl (← regionExpectedFields ops input conversions)
  | some depth =>
      let initialPart ← regionExpectedFields ops (input.take depth) conversions
      match maps with
      | [(_, .ok mapped)] =>
          if depth = 0 then return mapped
          match mapped with
          | .inl fields => return .inl (initialPart ++ fields)
          | .inr _ =>
              match splats with
              | [call] =>
                  match call.reply with
                  | .ok fields => return .inl (initialPart.take (depth - 1) ++ fields)
                  | .error _ => none
              | _ => none
      | _ => none

/-- Observable phase, argument, call-count, value-flow, exception, and mutation
invariant. It does not demand any formatting law from an arbitrary IO method.
It does demand the exact fixed delimiter strings and original IO identity,
full ordered transform completion, correct OneTo stops, and exact returned
values before and after any selected custom map method. -/
def RegionShowTerminal {World IO R V N Return Error : Type}
    (ops : RegionShowOps (RegionShowPrimitive World Error) IO R V N Return)
    (io : IO) (input : List (RegionShowRange R)) (initial : World)
    (result : Except Error Return) (audit : RegionShowAudit World IO R V N Return Error) : Prop :=
  let prints := regionPrintCalls audit.events
  let conversions := regionTransformCalls audit.events
  let maps := regionMapCalls audit.events
  let splats := regionSplatCalls audit.events
  let shows := regionValueShowCalls audit.events
  let depth := regionMapSelectedDepth ops input
  let initialPart := match depth with | none => input | some n => input.take n
  1 ≤ prints.length ∧ prints.length ≤ 2 ∧
  (∀ call, prints[0]? = some call → call.io = io ∧ call.text = "CartesianIndices(") ∧
  (∀ call, prints[1]? = some call → call.io = io ∧ call.text = ")") ∧
  maps.length ≤ 1 ∧ splats.length ≤ 1 ∧ shows.length ≤ 1 ∧
  (conversions.map Prod.fst).IsPrefix (regionSelectedTransforms ops initialPart) ∧
  (∀ arguments reply, maps = [(arguments, reply)] →
    ∃ n, depth = some n ∧ arguments = input.drop n ∧
      conversions.map Prod.fst = regionSelectedTransforms ops initialPart) ∧
  (∀ call, splats = [call] →
    ∃ n arguments values,
      depth = some n ∧ 0 < n ∧
      maps = [(arguments, .ok (.inr call.tail))] ∧
      regionExpectedFields ops initialPart conversions = some values ∧
      values[n - 1]? = some call.head) ∧
  (∀ call, shows = [call] →
    call.io = io ∧
    conversions.map Prod.fst = regionSelectedTransforms ops initialPart ∧
    regionExpectedMapped ops input conversions maps splats = some call.mapped ∧
    (match depth with
     | none => maps = [] ∧ splats = []
     | some n => ∃ arguments mapped,
         maps = [(arguments, .ok mapped)] ∧
         (match mapped with
          | .inl _ => splats = []
          | .inr _ => if n = 0 then splats = [] else splats.length = 1))) ∧
  (1 < prints.length → shows.length = 1) ∧
  audit.events =
    ((prints.take 1).map fun call => .print call.io call.text call.reply) ++
    (conversions.map fun call => .transform call.1 call.2) ++
    (maps.map fun call => .map call.1 call.2) ++
    (splats.map fun call => .splat call.head call.tail call.reply) ++
    (shows.map fun call => .valueShow call.io call.mapped call.reply) ++
    ((prints.drop 1).map fun call => .print call.io call.text call.reply) ∧
  (∀ event ∈ audit.events, ∀ error,
    regionShowEventError event = some error →
      audit.events.getLast? = some event ∧ result = .error error) ∧
  (match audit.lastWorld with
   | none => audit.world = initial ∧ audit.events = []
   | some lastWorld => audit.world = lastWorld) ∧
  (match result with
   | .ok returned =>
       prints.length = 2 ∧ shows.length = 1 ∧
       (∀ event ∈ audit.events, regionShowEventError event = none) ∧
       ∃ closing, prints[1]? = some closing ∧ closing.reply = .ok returned
   | .error error =>
       ∃ event, audit.events.getLast? = some event ∧ regionShowEventError event = some error)

/-- Every formed region, including zero-rank, offset/custom ranges, and every
machine-representable tuple arity, obeys the display data-flow invariant.
OneTo's stored stop is distinguished from UnitRange(1,n). All selected calls
are arbitrary: they may mutate shared references, return any value, throw any
object, or diverge. Success/error are examined without imposing a callee law.
The >=32 temporary-array abstraction is the installed tuple-map boundary;
only a selected non-Tuple map tail uses the existing Core splat boundary.
Source: base/multidimensional.jl:315-319,320-321.
Documentation: base/multidimensional.jl:213-293 (CartesianIndices preserves
its component ranges); doc/src/manual/types.md:964-1008 (tuple order/types). -/
def RegionShowRuntime : Prop :=
  ∀ (World IO R V N Return Error : Type)
    (ops : RegionShowOps (RegionShowPrimitive World Error) IO R V N Return)
    (io : IO) (ranges : RegionShowArguments R) (world : World),
    match (showRegion (regionShowObserveOps ops) io ranges).run
      ({ world := world } : RegionShowAudit World IO R V N Return Error) with
    | none => True
    | some (result, audit) => RegionShowTerminal ops io ranges.values world result audit

/-- MIME text/plain selects two-argument show exactly once. A selected method
receives the identical IO and region fields, preserves its arbitrary return
and thrown object, and keeps its final state; the installed fallback obeys
RegionShowRuntime's full delimiter, mapping, tag, and failure invariant.
No assertion that show returns nothing is introduced.
Source: base/multidimensional.jl:322. -/
def RegionPlainShowRuntime : Prop :=
  ∀ (World IO R V N Return Error : Type)
    (ops : RegionShowOps (RegionShowPrimitive World Error) IO R V N Return)
    (io : IO) (ranges : RegionShowArguments R) (world : World),
    match (showRegionPlain (regionShowObserveOps ops) io ranges).run
      ({ world := world } : RegionShowAudit World IO R V N Return Error) with
    | none => True
    | some (result, audit) =>
        match ops.showSelected io ranges.values with
        | none => RegionShowTerminal ops io ranges.values world result audit
        | some _ =>
            audit.events = [.direct io ranges.values result] ∧
            audit.lastWorld = some audit.world

