  cases SpecialAxisFirst axis <;> rfl

theorem Models1G6PrecheckedSpecialFirstFields_proven :
    JuliaLean.Proofs.base.multidimensional.Models1Group6.NativePrechecked.SpecialFirstFields := by
  intro Parameter K axis
  unfold specialFirst
  rw [rt_special_first_value]
  by_cases fits : Fits (.bits .i64) (ValueInteger (SpecialAxisFirst axis))
  · rw [rt_toInt64_of_fit _ fits]
    exact ⟨rfl, rfl, rfl, rfl⟩
  · obtain ⟨name, herror, _⟩ := rt_toInt64_of_not_fit _ fits
    rw [herror]
    exact fits

theorem rt_native_less (left right : IntegerValue) :
    NativeSpecial.less left right = decide (ValueInteger left < ValueInteger right) := by
  cases left with
  | bits leftType left =>
    cases right with
    | bits rightType right => exact JuliaLean.Proofs.base.int.lt_eq left right
    | boolean right =>
      simp only [NativeSpecial.less, JuliaLean.Proofs.base.int.lt_eq, rt_ofBool_val, ValueInteger]
      rfl
  | boolean left =>
    cases right with
    | bits rightType right =>
      simp only [NativeSpecial.less, JuliaLean.Proofs.base.int.lt_eq, rt_ofBool_val, ValueInteger]
      rfl
    | boolean right => cases left <;> cases right <;> decide

def rt_special_pair_spec (K left right : IntegerValue)
    (actual : JuliaLean.base.range.JlX
      (SpecialIndex IntegerValue K × SpecialIndex IntegerValue K)) : Prop :=
  match actual with
  | .ok (value, nextState) =>
      Fits (.bits .i64) (ValueInteger left) ∧
      Fits (.bits .i64) (ValueInteger right) ∧
      value.i.val = ValueInteger left ∧ value.j.val = ValueInteger right ∧
      nextState.i = value.i ∧ nextState.j = value.j
  | .error (.jl (.inexactError name)) =>
      (¬ Fits (.bits .i64) (ValueInteger left) ∧
        JuliaLean.Proofs.base.multidimensional.Models1Group6.NativeSpecial.Int64FailureName
          (ValueType left) = some name) ∨
      (Fits (.bits .i64) (ValueInteger left) ∧
        ¬ Fits (.bits .i64) (ValueInteger right) ∧
        JuliaLean.Proofs.base.multidimensional.Models1Group6.NativeSpecial.Int64FailureName
          (ValueType right) = some name)
  | .error _ => False

theorem rt_construct_pair_spec (K left right : IntegerValue) :
    rt_special_pair_spec K left right (do
      let index ← NativeSpecial.construct K left right
      pure (index, index)) := by
  unfold NativeSpecial.construct
  by_cases hl : Fits (.bits .i64) (ValueInteger left)
  · rw [rt_toInt64_of_fit _ hl]
    by_cases hr : Fits (.bits .i64) (ValueInteger right)
    · rw [rt_toInt64_of_fit _ hr]
      exact ⟨hl, hr, rfl, rfl, rfl, rfl⟩
    · obtain ⟨name, herror, hname⟩ := rt_toInt64_of_not_fit _ hr
      rw [herror]
      exact Or.inr ⟨hl, hr, hname⟩
  · obtain ⟨name, herror, hname⟩ := rt_toInt64_of_not_fit _ hl
    rw [herror]
    exact Or.inl ⟨hl, hname⟩

