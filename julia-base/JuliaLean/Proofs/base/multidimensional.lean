def LogicalInnerTerminal {S E M R B P O : Type} (element : LogicalElementParameter P) (mask : M)
    (initial final : S) (reply : AccessResult E (LogicalObject P M))
    (records : List (S × S × LogicalConstructorEvent M R B P O E)) : Prop :=
  AccessStateThread initial final records ∧
  match (records.map (fun record => record.2.2) : List (LogicalConstructorEvent M R B P O E)) with
  | [.count actual (.error error)] => actual = mask ∧ reply = .error error
  | [.count actual (.ok counted), .conversion converted (.error error)] =>
      actual = mask ∧ converted = counted ∧ reply = .error error
  | [.count actual (.ok counted), .conversion converted (.ok (.inr _))] =>
      actual = mask ∧ converted = counted ∧ reply = .error (.inl .typeError)
  | [.count actual (.ok counted), .conversion converted (.ok (.inl count))] =>
      actual = mask ∧ converted = counted ∧
      ∃ logical, reply = .ok logical ∧ logical.element = element ∧
