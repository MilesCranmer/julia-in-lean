open JuliaLean.Proofs.base.multidimensional.Models1Group6.MaskAxesProtocol

namespace pr_Trace

inductive Step where
  | next (missing : Bool)
  | stop

def leadingMeaning {Other : Type} : MaskTruth Other → Except Error Step
  | .bool true => .ok (.next false)
  | .bool false => .ok .stop
  | .missing | .other _ => .error .typeError

def defaultMissing {Other : Type} : MaskTruth Other → MaskTruth Other
  | .missing => .bool true
  | .bool _ | .other _ => .bool false

def trailingMeaning {Other : Type} (value : MaskTruth Other) :
    MaskTruth Other → Except Error Step
  | .bool true => .ok (.next true)
  | .bool false => leadingMeaning value
  | .missing | .other _ => .error .typeError

def atomicObserved {State Axis TypeTag Other : Type}
    (runtime : MaskAxesRuntime (Effects State) Axis TypeTag Other)
    (left right : MaskAxisOperand Axis TypeTag) (initial : State) :
    Except Error Step × (State × List (Event State Axis TypeTag Other)) :=
  let (result, middle) := observe (runtime.equal left right) initial
  match result with
  | .error error => (.error error, (middle, [.equal left right (.error error) middle]))
  | .ok value =>
      match right with
      | .observed _ =>
          (leadingMeaning value, (middle, [.equal left right (.ok value) middle]))
      | .native _ =>
          match runtime.missingExtension value with
          | none =>
              (trailingMeaning value (defaultMissing value),
                (middle, [.equal left right (.ok value) middle]))
          | some action =>
              let (missing, final) := observe action middle
              (missing.bind (trailingMeaning value),
                (final, [.equal left right (.ok value) middle,
                  .isMissing value missing final]))

inductive Chunk {State Axis TypeTag Other : Type}
    (runtime : MaskAxesRuntime (Effects State) Axis TypeTag Other) :
    (MaskAxisOperand Axis TypeTag × MaskAxisOperand Axis TypeTag) →
    Except Error Step → State → List (Event State Axis TypeTag Other) → Prop where
  | equalityError (left right : MaskAxisOperand Axis TypeTag) (error : Error) (final : State) :
      Chunk runtime (left, right) (.error error) final [.equal left right (.error error) final]
  | paired (left : MaskAxisOperand Axis TypeTag) (right : MaskAxisField Axis TypeTag)
      (value : MaskTruth Other) (final : State) :
      Chunk runtime (left, .observed right) (leadingMeaning value) final
        [.equal left (.observed right) (.ok value) final]
  | fallback (left : MaskAxisOperand Axis TypeTag) (right : JuliaLean.base.indices.BaseRange)
      (value : MaskTruth Other) (final : State)
      (hSelection : runtime.missingExtension value = none) :
      Chunk runtime (left, .native right) (trailingMeaning value (defaultMissing value)) final
        [.equal left (.native right) (.ok value) final]
  | selected (left : MaskAxisOperand Axis TypeTag) (right : JuliaLean.base.indices.BaseRange)
      (value : MaskTruth Other) (middle : State) (action : Effects State (MaskTruth Other))
      (missing : Except Error (MaskTruth Other)) (final : State)
      (hSelection : runtime.missingExtension value = some action) :
      Chunk runtime (left, .native right) (missing.bind (trailingMeaning value)) final
        [.equal left (.native right) (.ok value) middle, .isMissing value missing final]

theorem atomic_chunk {State Axis TypeTag Other : Type}
    (runtime : MaskAxesRuntime (Effects State) Axis TypeTag Other)
    (left right : MaskAxisOperand Axis TypeTag) (initial : State) :
    let actual := atomicObserved runtime left right initial
    Chunk runtime (left, right) actual.1 actual.2.1 actual.2.2 := by
  unfold atomicObserved
  cases h : observe (runtime.equal left right) initial with
  | mk result middle =>
    cases result with
    | error error => exact .equalityError left right error middle
    | ok value =>
      cases right with
      | observed right => exact .paired left right value middle
      | native right =>
        cases hs : runtime.missingExtension value with
        | none => simpa only [hs] using (Chunk.fallback left right value middle hs)
        | some action =>
          cases hm : observe action middle with
          | mk missing final =>
            simpa only [hs, hm] using (Chunk.selected left right value middle action missing final hs)

theorem observed_next_false {State Axis TypeTag Other : Type}
    (runtime : MaskAxesRuntime (Effects State) Axis TypeTag Other)
    (left : MaskAxisOperand Axis TypeTag) (right : MaskAxisField Axis TypeTag)
    (initial final : State) (events : List (Event State Axis TypeTag Other)) (missing : Bool)
    (h : atomicObserved runtime left (.observed right) initial =
      (.ok (.next missing), (final, events))) : missing = false := by
  unfold atomicObserved at h
  cases he : observe (runtime.equal left (.observed right)) initial with
  | mk result middle =>
    simp only [he] at h
    cases result with
    | error error => cases h
    | ok value =>
      cases value with
      | bool value =>
        cases value with
        | false => cases h
        | true => exact (Step.next.inj (Except.ok.inj (Prod.mk.inj h).1)).symm
      | missing => cases h
      | other value => cases h

def finish (result : Except Error Step) : Option (Except Error (Option Bool)) :=
  match result with
  | .error error => some (.error error)
  | .ok .stop => some (.ok (some false))
  | .ok (.next _) => none


inductive TrailingRun {State Axis TypeTag Other : Type}
    (runtime : MaskAxesRuntime (Effects State) Axis TypeTag Other) :
    Bool → List (MaskAxisField Axis TypeTag) → State →
    Except Error (Option Bool) → State → List (Event State Axis TypeTag Other) → Prop where
  | done (missing : Bool) (initial : State) :
      TrailingRun runtime missing [] initial (.ok (maskAllDone missing)) initial []
  | error (missing : Bool) (field : MaskAxisField Axis TypeTag)
      (rest : List (MaskAxisField Axis TypeTag)) (initial final : State)
      (events : List (Event State Axis TypeTag Other)) (error : Error)
      (chunk : Chunk runtime (.observed field, maskOneToOne) (.error error) final events) :
      TrailingRun runtime missing (field :: rest) initial (.error error) final events
  | stop (missing : Bool) (field : MaskAxisField Axis TypeTag)
      (rest : List (MaskAxisField Axis TypeTag)) (initial final : State)
      (events : List (Event State Axis TypeTag Other))
      (chunk : Chunk runtime (.observed field, maskOneToOne) (.ok .stop) final events) :
      TrailingRun runtime missing (field :: rest) initial (.ok (some false)) final events
  | next (missing seen : Bool) (field : MaskAxisField Axis TypeTag)
      (rest : List (MaskAxisField Axis TypeTag)) (initial middle final : State)
      (first events : List (Event State Axis TypeTag Other)) (result : Except Error (Option Bool))
      (chunk : Chunk runtime (.observed field, maskOneToOne) (.ok (.next seen)) middle first)
      (tail : TrailingRun runtime (missing || seen) rest middle result final events) :
      TrailingRun runtime missing (field :: rest) initial result final (first ++ events)

inductive AxesRun {State Axis TypeTag Other : Type}
    (runtime : MaskAxesRuntime (Effects State) Axis TypeTag Other) :
    List (MaskAxisField Axis TypeTag) → List (MaskAxisField Axis TypeTag) → State →
    Except Error (Option Bool) → State → List (Event State Axis TypeTag Other) → Prop where
  | trailing (axes : List (MaskAxisField Axis TypeTag)) (initial final : State)
      (result : Except Error (Option Bool)) (events : List (Event State Axis TypeTag Other))
      (tail : TrailingRun runtime false axes initial result final events) :
      AxesRun runtime [] axes initial result final events
  | exhausted (axis : MaskAxisField Axis TypeTag)
      (rest : List (MaskAxisField Axis TypeTag)) (initial : State) :
      AxesRun runtime (axis :: rest) [] initial (.error .boundsError) initial []
  | error (left right : MaskAxisField Axis TypeTag)
      (inds axes : List (MaskAxisField Axis TypeTag)) (initial final : State)
      (events : List (Event State Axis TypeTag Other)) (error : Error)
      (chunk : Chunk runtime (.observed left, .observed right) (.error error) final events) :
      AxesRun runtime (left :: inds) (right :: axes) initial (.error error) final events
  | stop (left right : MaskAxisField Axis TypeTag)
      (inds axes : List (MaskAxisField Axis TypeTag)) (initial final : State)
      (events : List (Event State Axis TypeTag Other))
      (chunk : Chunk runtime (.observed left, .observed right) (.ok .stop) final events) :
      AxesRun runtime (left :: inds) (right :: axes) initial (.ok (some false)) final events
  | next (left right : MaskAxisField Axis TypeTag)
      (inds axes : List (MaskAxisField Axis TypeTag)) (initial middle final : State)
      (first events : List (Event State Axis TypeTag Other)) (result : Except Error (Option Bool))
      (chunk : Chunk runtime (.observed left, .observed right) (.ok (.next false)) middle first)
      (tail : AxesRun runtime inds axes middle result final events) :
      AxesRun runtime (left :: inds) (right :: axes) initial result final (first ++ events)

def trailingPlan {Axis TypeTag : Type} (axes : List (MaskAxisField Axis TypeTag)) :
    List (MaskAxisOperand Axis TypeTag × MaskAxisOperand Axis TypeTag) :=
  axes.map fun axis => (.observed axis, maskOneToOne)

def axesPlan {Axis TypeTag : Type}
    (inds axes : List (MaskAxisField Axis TypeTag)) :
    List (MaskAxisOperand Axis TypeTag × MaskAxisOperand Axis TypeTag) :=
  (inds.zip axes).map (fun pair => (.observed pair.1, .observed pair.2)) ++
    (axes.drop inds.length).map (fun axis => (.observed axis, maskOneToOne))


def replay {State Axis TypeTag Other : Type}
    (next : Bool → State → List (Event State Axis TypeTag Other) →
      Except Error (Option Bool) × (State × List (Event State Axis TypeTag Other)))
    (actual : Except Error Step × (State × List (Event State Axis TypeTag Other)))
    (history : List (Event State Axis TypeTag Other)) :
    Except Error (Option Bool) × (State × List (Event State Axis TypeTag Other)) :=
  match actual.1 with
  | .error error => (.error error, (actual.2.1, history ++ actual.2.2))
  | .ok .stop => (.ok (some false), (actual.2.1, history ++ actual.2.2))
  | .ok (.next seen) => next seen actual.2.1 (history ++ actual.2.2)

theorem paired_observe {State Axis TypeTag Other : Type}
    (runtime : MaskAxesRuntime (Effects State) Axis TypeTag Other)
    (left right : MaskAxisField Axis TypeTag)
    (inds axes : List (MaskAxisField Axis TypeTag)) (initial : State)
    (history : List (Event State Axis TypeTag Other)) :
    observe (pr_axesRecursive (tracingRuntime runtime) (left :: inds) (right :: axes))
      (initial, history) =
      replay (fun _ state events =>
        observe (pr_axesRecursive (tracingRuntime runtime) inds axes) (state, events))
        (atomicObserved runtime (.observed left) (.observed right) initial) history := by
  cases he : observe (runtime.equal (.observed left) (.observed right)) initial with
  | mk result middle =>
    simp only [observe, ExceptT.run] at he
    cases result with
    | error error =>
      simp [pr_axesRecursive, tracingRuntime, recordEquality, atomicObserved, replay,
        observe, ExceptT.run, ExceptT.mk, Bind.bind, ExceptT.bind, ExceptT.bindCont,
        StateT.bind, Pure.pure, ExceptT.pure, StateT.pure, he]
    | ok value =>
      cases value with
      | bool value =>
        cases value <;>
          simp [pr_axesRecursive, tracingRuntime, recordEquality, atomicObserved, replay,
            observe, ExceptT.run, ExceptT.mk, Bind.bind, ExceptT.bind, ExceptT.bindCont,
            StateT.bind, Pure.pure, ExceptT.pure, StateT.pure, he, leadingMeaning, maskRequireBool]
      | missing =>
        simp [pr_axesRecursive, tracingRuntime, recordEquality, atomicObserved, replay,
          observe, ExceptT.run, ExceptT.mk, Bind.bind, ExceptT.bind, ExceptT.bindCont,
          StateT.bind, Pure.pure, ExceptT.pure, StateT.pure, he, leadingMeaning, maskRequireBool]
        rfl
      | other value =>
        simp [pr_axesRecursive, tracingRuntime, recordEquality, atomicObserved, replay,
          observe, ExceptT.run, ExceptT.mk, Bind.bind, ExceptT.bind, ExceptT.bindCont,
          StateT.bind, Pure.pure, ExceptT.pure, StateT.pure, he, leadingMeaning, maskRequireBool]
        rfl


theorem observe_pure {State Value : Type} (value : Value) (initial : State) :
    observe (pure value : Effects State Value) initial = (.ok value, initial) := rfl

theorem observe_throw {State Value : Type} (error : Error) (initial : State) :
    observe (throw error : Effects State Value) initial = (.error error, initial) := rfl

theorem observe_bind {State Value Result : Type} (action : Effects State Value)
    (next : Value → Effects State Result) (initial : State) :
    observe (action >>= next) initial =
      match observe action initial with
      | (.error error, final) => (.error error, final)
      | (.ok value, final) => observe (next value) final := by
  cases h : observe action initial with
  | mk result final =>
    cases result <;> simp only [observe, ExceptT.run, ExceptT.mk, Bind.bind,
      ExceptT.bind, ExceptT.bindCont, StateT.bind, Pure.pure, StateT.pure] at h ⊢ <;>
      rw [h] <;> rfl

theorem record_equality {State Axis TypeTag Other : Type}
    (left right : MaskAxisOperand Axis TypeTag) (action : Effects State (MaskTruth Other))
    (initial : State) (history : List (Event State Axis TypeTag Other)) :
    observe (recordEquality left right action) (initial, history) =
      let result := observe action initial
      (result.1, (result.2, history ++ [.equal left right result.1 result.2])) := by
  cases h : observe action initial with
  | mk result final =>
    simp only [observe, recordEquality, ExceptT.run, ExceptT.mk] at h ⊢
    rw [h]

theorem record_missing {State Axis TypeTag Other : Type}
    (value : MaskTruth Other) (action : Effects State (MaskTruth Other))
    (initial : State) (history : List (Event State Axis TypeTag Other)) :
    observe (recordIsMissing value action) (initial, history) =
      let result := observe action initial
      (result.1, (result.2, history ++ [.isMissing value result.1 result.2])) := by
  cases h : observe action initial with
  | mk result final =>
    simp only [observe, recordIsMissing, ExceptT.run, ExceptT.mk] at h ⊢
    rw [h]

theorem trailing_observe {State Axis TypeTag Other : Type}
    (runtime : MaskAxesRuntime (Effects State) Axis TypeTag Other)
    (field : MaskAxisField Axis TypeTag) (rest : List (MaskAxisField Axis TypeTag))
    (missing : Bool) (initial : State) (history : List (Event State Axis TypeTag Other)) :
    observe (maskAllTupleRecursive (tracingRuntime runtime)
      (fun axis => (tracingRuntime runtime).equal (.observed axis) maskOneToOne)
      missing (field :: rest)) (initial, history) =
      replay (fun seen state events => observe
        (maskAllTupleRecursive (tracingRuntime runtime)
          (fun axis => (tracingRuntime runtime).equal (.observed axis) maskOneToOne)
          (missing || seen) rest) (state, events))
        (atomicObserved runtime (.observed field) maskOneToOne initial) history := by
  cases he : observe (runtime.equal (.observed field) maskOneToOne) initial with
  | mk result middle =>
    simp only [maskOneToOne] at he
    cases result with
    | error error =>
      simp [maskAllTupleRecursive, tracingRuntime, observe_bind, observe_pure,
        observe_throw, record_equality, atomicObserved, replay, maskOneToOne, he]
    | ok value =>
      cases hs : runtime.missingExtension value with
      | none =>
        cases value with
        | bool value =>
          cases value <;>
            simp [maskAllTupleRecursive, tracingRuntime, observe_bind, observe_pure,
              observe_throw, record_equality, record_missing, atomicObserved, replay,
              he, hs, maskOneToOne, maskIsMissing, maskRequireBool, leadingMeaning,
              trailingMeaning, defaultMissing, Except.bind, List.append_assoc]
        | missing =>
          simp [maskAllTupleRecursive, tracingRuntime, observe_bind, observe_pure,
            observe_throw, record_equality, record_missing, atomicObserved, replay,
            he, hs, maskOneToOne, maskIsMissing, maskRequireBool, leadingMeaning,
            trailingMeaning, defaultMissing, Except.bind, List.append_assoc]
        | other value =>
          simp [maskAllTupleRecursive, tracingRuntime, observe_bind, observe_pure,
            observe_throw, record_equality, record_missing, atomicObserved, replay,
            he, hs, maskOneToOne, maskIsMissing, maskRequireBool, leadingMeaning,
            trailingMeaning, defaultMissing, Except.bind, List.append_assoc]
      | some action =>
        cases hm : observe action middle with
        | mk result final =>
          cases result with
          | error error =>
            simp [maskAllTupleRecursive, tracingRuntime, observe_bind, observe_pure,
              observe_throw, record_equality, record_missing, atomicObserved, replay,
              he, hs, hm, maskOneToOne, maskIsMissing, maskRequireBool, leadingMeaning,
              trailingMeaning, defaultMissing, Except.bind, List.append_assoc]
          | ok observed =>
            cases value with
            | bool value =>
              cases value <;> cases observed with
              | bool observed =>
                cases observed <;>
                  simp [maskAllTupleRecursive, tracingRuntime, observe_bind, observe_pure,
                    observe_throw, record_equality, record_missing, atomicObserved, replay,
                    he, hs, hm, maskOneToOne, maskIsMissing, maskRequireBool, leadingMeaning,
                    trailingMeaning, defaultMissing, Except.bind, List.append_assoc]
              | missing =>
                simp [maskAllTupleRecursive, tracingRuntime, observe_bind, observe_pure,
                  observe_throw, record_equality, record_missing, atomicObserved, replay,
                  he, hs, hm, maskOneToOne, maskIsMissing, maskRequireBool, leadingMeaning,
                  trailingMeaning, defaultMissing, Except.bind, List.append_assoc]
              | other observed =>
                simp [maskAllTupleRecursive, tracingRuntime, observe_bind, observe_pure,
                  observe_throw, record_equality, record_missing, atomicObserved, replay,
                  he, hs, hm, maskOneToOne, maskIsMissing, maskRequireBool, leadingMeaning,
                  trailingMeaning, defaultMissing, Except.bind, List.append_assoc]
            | missing =>
              cases observed with
              | bool observed =>
                cases observed <;>
                  simp [maskAllTupleRecursive, tracingRuntime, observe_bind, observe_pure,
                    observe_throw, record_equality, record_missing, atomicObserved, replay,
                    he, hs, hm, maskOneToOne, maskIsMissing, maskRequireBool, leadingMeaning,
                    trailingMeaning, defaultMissing, Except.bind, List.append_assoc]
              | missing =>
                simp [maskAllTupleRecursive, tracingRuntime, observe_bind, observe_pure,
                  observe_throw, record_equality, record_missing, atomicObserved, replay,
                  he, hs, hm, maskOneToOne, maskIsMissing, maskRequireBool, leadingMeaning,
                  trailingMeaning, defaultMissing, Except.bind, List.append_assoc]
              | other observed =>
                simp [maskAllTupleRecursive, tracingRuntime, observe_bind, observe_pure,
                  observe_throw, record_equality, record_missing, atomicObserved, replay,
                  he, hs, hm, maskOneToOne, maskIsMissing, maskRequireBool, leadingMeaning,
                  trailingMeaning, defaultMissing, Except.bind, List.append_assoc]
            | other value =>
              cases observed with
              | bool observed =>
                cases observed <;>
                  simp [maskAllTupleRecursive, tracingRuntime, observe_bind, observe_pure,
                    observe_throw, record_equality, record_missing, atomicObserved, replay,
                    he, hs, hm, maskOneToOne, maskIsMissing, maskRequireBool, leadingMeaning,
                    trailingMeaning, defaultMissing, Except.bind, List.append_assoc]
              | missing =>
                simp [maskAllTupleRecursive, tracingRuntime, observe_bind, observe_pure,
                  observe_throw, record_equality, record_missing, atomicObserved, replay,
                  he, hs, hm, maskOneToOne, maskIsMissing, maskRequireBool, leadingMeaning,
                  trailingMeaning, defaultMissing, Except.bind, List.append_assoc]
              | other observed =>
                simp [maskAllTupleRecursive, tracingRuntime, observe_bind, observe_pure,
                  observe_throw, record_equality, record_missing, atomicObserved, replay,
                  he, hs, hm, maskOneToOne, maskIsMissing, maskRequireBool, leadingMeaning,
                  trailingMeaning, defaultMissing, Except.bind, List.append_assoc]


def trailingAction {State Axis TypeTag Other : Type}
    (runtime : MaskAxesRuntime (Effects State) Axis TypeTag Other)
    (missing : Bool) (fields : List (MaskAxisField Axis TypeTag)) :
    Effects (State × List (Event State Axis TypeTag Other)) (Option Bool) :=
  maskAllTupleRecursive (tracingRuntime runtime)
    (fun axis => (tracingRuntime runtime).equal (.observed axis) maskOneToOne) missing fields

theorem trailing_run {State Axis TypeTag Other : Type}
    (runtime : MaskAxesRuntime (Effects State) Axis TypeTag Other)
    (fields : List (MaskAxisField Axis TypeTag)) (missing : Bool)
    (initial : State) (history : List (Event State Axis TypeTag Other)) :
    ∃ result final events,
      observe (trailingAction runtime missing fields) (initial, history) =
        (result, (final, history ++ events)) ∧
      TrailingRun runtime missing fields initial result final events := by
  induction fields generalizing missing initial history with
  | nil =>
    exact ⟨.ok (maskAllDone missing), initial, [], by
      simp only [trailingAction, maskAllTupleRecursive, observe_pure, List.append_nil],
      .done missing initial⟩
  | cons field rest ih =>
    cases ha : atomicObserved runtime (.observed field) maskOneToOne initial with
    | mk step ending =>
      rcases ending with ⟨middle, first⟩
      have hc : Chunk runtime (.observed field, maskOneToOne) step middle first := by
        simpa only [ha] using atomic_chunk runtime (.observed field) maskOneToOne initial
      cases step with
      | error error =>
        refine ⟨.error error, middle, first, ?_, .error missing field rest initial middle first error hc⟩
        unfold trailingAction
        rw [trailing_observe, ha]
        rfl
      | ok step =>
        cases step with
        | stop =>
          refine ⟨.ok (some false), middle, first, ?_, .stop missing field rest initial middle first hc⟩
          unfold trailingAction
          rw [trailing_observe, ha]
          rfl
        | next seen =>
          obtain ⟨result, final, events, heq, hrun⟩ := ih (missing || seen) middle (history ++ first)
          refine ⟨result, final, first ++ events, ?_,
            .next missing seen field rest initial middle final first events result hc hrun⟩
          unfold trailingAction
          rw [trailing_observe, ha]
          simpa only [replay, trailingAction, List.append_assoc] using heq

theorem axes_run {State Axis TypeTag Other : Type}
    (runtime : MaskAxesRuntime (Effects State) Axis TypeTag Other)
    (inds axes : List (MaskAxisField Axis TypeTag))
    (initial : State) (history : List (Event State Axis TypeTag Other)) :
    ∃ result final events,
      observe (pr_axesRecursive (tracingRuntime runtime) inds axes) (initial, history) =
        (result, (final, history ++ events)) ∧
      AxesRun runtime inds axes initial result final events := by
  induction inds generalizing axes initial history with
  | nil =>
    obtain ⟨result, final, events, heq, hrun⟩ := trailing_run runtime axes false initial history
    exact ⟨result, final, events, heq, .trailing axes initial final result events hrun⟩
  | cons left inds ih =>
    cases axes with
    | nil =>
      refine ⟨.error .boundsError, initial, [], ?_, .exhausted left inds initial⟩
      simp only [pr_axesRecursive, observe_throw, List.append_nil]
    | cons right axes =>
      cases ha : atomicObserved runtime (.observed left) (.observed right) initial with
      | mk step ending =>
        rcases ending with ⟨middle, first⟩
        have hc : Chunk runtime (.observed left, .observed right) step middle first := by
          simpa only [ha] using atomic_chunk runtime (.observed left) (.observed right) initial
        cases step with
        | error error =>
          refine ⟨.error error, middle, first, ?_, .error left right inds axes initial middle first error hc⟩
          rw [paired_observe, ha]
          rfl
        | ok step =>
          cases step with
          | stop =>
            refine ⟨.ok (some false), middle, first, ?_, .stop left right inds axes initial middle first hc⟩
            rw [paired_observe, ha]
            rfl
          | next seen =>
            have hs := observed_next_false runtime (.observed left) right initial middle first seen ha
            subst seen
            obtain ⟨result, final, events, heq, hrun⟩ := ih axes middle (history ++ first)
            refine ⟨result, final, first ++ events, ?_,
              .next left right inds axes initial middle final first events result hc hrun⟩
            rw [paired_observe, ha]
            simpa only [replay, List.append_assoc] using heq

end pr_Trace

