    IndexMetadataEvent E R A C V T → List (Models1Group6.MetadataValue V)
  | .length _ (.ok value) => [value]
  | .fields _ _ (.ok (.inl values)) | .selected _ _ (.ok (.inl values))
  | .splat _ _ _ (.ok values) => values
  | _ => []

def indexMetadataEventStage {E R A C V T : Type} : IndexMetadataEvent E R A C V T → Nat
  | .length _ _ | .fields _ _ _ => 0
  | .selected _ _ _ => 1
  | .splat _ _ _ _ => 2

