preserves its sequence. The dimension list is mathematical data, never a supplied law. -/
def RegionSequenceReversal (original result : Region64) (dimensions : List Int) : Prop :=
  RegionDomain result ∧ result.length = original.length ∧
  ∀ (k : Nat) (axis : OrdinalRange64), original[k]? = some axis →
    ∃ resultAxis : OrdinalRange64, result[k]? = some resultAxis ∧
      AxisSequenceRelation axis resultAxis (decide ((k : Int) + 1 ∈ dimensions))

def ValidReverseDimensions (rank : Nat) (dimensions : List JuliaLean.base.tuple.Index) : Prop :=
