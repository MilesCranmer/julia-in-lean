/-- Zero-rank Cartesian reference access has no coordinates to inspect. The
actual zero-index getter receives the original shared reference once and its
entire result/error/state transition survives; the setter is never reached.
This includes all Ref subtypes. Source:base/multidimensional.jl:1992. -/
def RefCartesianGetObservations : Prop :=
  ∀ (E S Ref Value Read Write : Type)
    (ops : RefCartesianOps (DimensionObservationM E S) Ref Value Read Write)
    (ref : Ref) (initial : S),
    let observed : RefCartesianOps
        (DimensionObservationM E
          (S × List (S × S × Sum (Ref × Except E Read) (Ref × Value × Except E Write))))
        Ref Value Read Write := {
      get := fun actual => observeDimensionAction (ops.get actual) (fun reply => .inl (actual, reply))
      set := fun actual value => observeDimensionAction (ops.set actual value)
        (fun reply => .inr (actual, value, reply)) }
    match (refGetCartesianZeroOpen observed ref).run (initial, []) with
    | none => True
    | some (reply, (final, records)) => records = [(initial, final, .inl (ref, reply))]

theorem refCartesianGetObservations_proven :
    Models2Group3.RefCartesianGetObservations := by
  intro E S Ref Value Read Write ops ref initial
  unfold Models2Group3.refGetCartesianZeroOpen Models2Group3.observeDimensionAction
  simp only [ExceptT.run_mk, List.nil_append]
  cases (ops.get ref).run initial with
  | none => trivial
  | some _ => rfl

/-- Zero-rank reference assignment retains both reference and untyped value
identities, performs exactly one actual setter call, and returns its raw result.
The getter is never called. Aliases and mutation before arbitrary exceptions
remain in the single state. Source:base/multidimensional.jl:1993. -/
def RefCartesianSetObservations : Prop :=
  ∀ (E S Ref Value Read Write : Type)
    (ops : RefCartesianOps (DimensionObservationM E S) Ref Value Read Write)
    (ref : Ref) (value : Value) (initial : S),
    let observed : RefCartesianOps
        (DimensionObservationM E
          (S × List (S × S × Sum (Ref × Except E Read) (Ref × Value × Except E Write))))
        Ref Value Read Write := {
      get := fun actual => observeDimensionAction (ops.get actual) (fun reply => .inl (actual, reply))
      set := fun actual argument => observeDimensionAction (ops.set actual argument)
        (fun reply => .inr (actual, argument, reply)) }
    match (refSetCartesianZeroOpen observed ref value).run (initial, []) with
    | none => True
    | some (reply, (final, records)) => records = [(initial, final, .inr (ref, value, reply))]

theorem refCartesianSetObservations_proven :
    Models2Group3.RefCartesianSetObservations := by
  intro E S Ref Value Read Write ops ref value initial
  unfold Models2Group3.refSetCartesianZeroOpen Models2Group3.observeDimensionAction
  simp only [ExceptT.run_mk, List.nil_append]
  cases (ops.set ref value).run initial with
  | none => trivial
  | some _ => rfl

/-- Independent word-level description of the hash seed transformation: each
of the 64 output bits is one precisely when the corresponding input bit differs
from the fixed platform seed bit. This does not invoke the model's xor helper. -/
def ArrayHashSeedBits (input forwarded : JInt .u64) : Prop :=
  ∀ bit : Nat, bit < 64 →
    forwarded.val.toNat.testBit bit =
      ((input.val.toNat.testBit bit) != ((0x7e2d6fb6448beb77 : Nat).testBit bit))

/-- The fixed native UInt seed is correct on the pinned 64-bit platform. Every
input UInt, including the extreme values, is transformed bitwise before the
one actual hash_shaped call on the original array; no iteration, extra callback
or return-type assertion is introduced. That selected target may return any
value or throw after any shared mutation. Source:base/multidimensional.jl:2122-2123. -/
def ArrayHashObservations : Prop :=
  arrayHashSeed64.val = (0x7e2d6fb6448beb77 : Int) ∧
  ∀ (E S A Value : Type)
    (ops : ArrayHashOps (DimensionObservationM E S) A Value)
    (array : A) (seed : JInt .u64) (initial : S),
    let observed : ArrayHashOps
        (DimensionObservationM E (S × List (S × S × (A × JInt .u64 × Except E Value))))
        A Value := {
      hashShaped := fun actual forwarded =>
        observeDimensionAction (ops.hashShaped actual forwarded)
          (fun reply => (actual, forwarded, reply)) }
    match (hashArrayOpen observed array seed).run (initial, []) with
    | none => True
    | some (reply, (final, records)) =>
        ∃ forwarded, ArrayHashSeedBits seed forwarded ∧
          records = [(initial, final, (array, forwarded, reply))]

