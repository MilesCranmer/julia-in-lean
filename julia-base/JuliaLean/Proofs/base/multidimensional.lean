def CollectionMemorySafety : Prop :=
  ∀ (method : CollectionMethod) (layout : JuliaLean.base.array.MemoryLayout)
    (ranges : Region64) (heap : CollectionHeap),
    RegionDomain ranges → HeapDomain heap → LayoutForRegion layout ranges →
