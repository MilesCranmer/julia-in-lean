structure EarlySingleCall (A Out E : Type) where
  argument : A
  reply : Except E Out

def EarlySingleObservation {A Out E W : Type} (input : A) (initial : W)
    (outcome : Option (Except E Out × (W × List (W × W × EarlySingleCall A Out E)))) : Prop :=
  match outcome with
  | none => True
  | some (reply, (final, records)) => records = [(initial, final, ⟨input, reply⟩)]

inductive EarlyChainEvent (A B Out E : Type) where
  | first (argument : A) (reply : Except E B)
  | second (argument : B) (reply : Except E Out)

def earlyChainPhase {A B Out E : Type} : EarlyChainEvent A B Out E → Nat
  | .first _ _ => 0
  | .second _ _ => 1

def earlyChainError {A B Out E : Type} : EarlyChainEvent A B Out E → Option E
  | .first _ (.error error) | .second _ (.error error) => some error
  | _ => none

def earlyChainReturn {A B Out E : Type} : EarlyChainEvent A B Out E → Option (Except E Out)
