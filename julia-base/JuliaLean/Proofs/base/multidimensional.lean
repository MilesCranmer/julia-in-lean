/-- Exactly one reached external entry point: a selected custom checkindex
action, or axes on the terminal native Boolean-array receiver. -/
inductive Request (MaskRef : Type) where
  | extension (receiver : BooleanMaskRef MaskRef)
  | axes (reference : MaskRef)

/-- Execute an actual runtime action without changing the request trace. -/
def preserveRequests {State MaskRef Value : Type} (action : Effects State Value) :
    Effects (State × List (Request MaskRef)) Value :=
  ExceptT.mk fun state =>
    let (result, final) := MaskAxesProtocol.observe action state.1
    (result, (final, state.2))

/-- Record the exact reached receiver while preserving the action's raw result,
error and final state. Failing actions still contribute their single request. -/
def recordAction {State MaskRef Value : Type} (request : Request MaskRef)
    (action : Effects State Value) : Effects (State × List (Request MaskRef)) Value :=
  ExceptT.mk fun state =>
    let (result, final) := MaskAxesProtocol.observe action state.1
    (result, (final, state.2 ++ [request]))

/-- Preserve every actual axis equality and selected ismissing action. -/
def tracingAxisRuntime {State MaskRef Axis TypeTag Other : Type}
    (runtime : MaskAxesRuntime (Effects State) Axis TypeTag Other) :
    MaskAxesRuntime (Effects (State × List (Request MaskRef))) Axis TypeTag Other where
  equal := fun left right => preserveRequests (runtime.equal left right)
  missingExtension := fun value => (runtime.missingExtension value).map preserveRequests

/-- Observe the actual selected custom checkindex action or terminal axes call,
without modifying selection, ordinary Base dispatch, results or effects. -/
def tracingRuntime {State MaskRef Axis TypeTag Other NonTuple : Type}
    (runtime : LogicalMaskRuntime (Effects State) MaskRef Axis TypeTag Other NonTuple) :
    LogicalMaskRuntime (Effects (State × List (Request MaskRef)))
      MaskRef Axis TypeTag Other NonTuple where
  axisRuntime := tracingAxisRuntime runtime.axisRuntime
  axes := fun reference => recordAction (.axes reference) (runtime.axes reference)
  extension := fun inds receiver =>
    (runtime.extension inds receiver).map (fun action => recordAction (.extension receiver) action)

/-- Static immutable receiver ancestry, including the final non-LogicalIndex
Boolean array. This mathematical list is an observation of field structure;
no Julia list/array/tuple of this path is constructed by the model. -/
def ReceiverPath {MaskRef : Type} : BooleanMaskRef MaskRef → List (BooleanMaskRef MaskRef)
  | receiver@(.terminal _) => [receiver]
  | receiver@(.logical _ mask _) => receiver :: ReceiverPath mask

/-- Last actual Boolean-array reference in the immutable field chain. -/
def TerminalReference {MaskRef : Type} : BooleanMaskRef MaskRef → MaskRef
  | .terminal reference => reference
  | .logical _ mask _ => TerminalReference mask

/-- Independently select custom methods from a static ancestor list. Filtering
and taking its first entry identifies which actual action is reached; later
actions are not executed by this observation. No correct-result law is supplied.
-/
def SelectedActions {State MaskRef Axis TypeTag Other NonTuple : Type}
    (runtime : LogicalMaskRuntime (Effects State) MaskRef Axis TypeTag Other NonTuple)
    (inds : MaskAxisTuple Axis TypeTag) (mask : BooleanMaskRef MaskRef) :
    List (BooleanMaskRef MaskRef × Effects State (MaskTruth Other)) :=
  (ReceiverPath mask).filterMap fun receiver =>
    (runtime.extension inds receiver).map (fun action => (receiver, action))

/-- Source903 ignores its outer cached count and forwards through the actual
Boolean-mask dispatch chain. The first genuinely selected custom action is
executed once and its exact raw value/error and final state are returned. If
there is no selected extension on the chain, axes is called once on the terminal
non-LogicalIndex mask, and no intermediate logical mask is treated as that
terminal array. An axes error or non-Tuple result has the exact specified
exception and retained final state.

All receiver shapes, nested counts, raw values, errors, mutable states, actual
extension actions and malformed axes results are included. Changing the outer
cache changes neither dispatch nor observations. A selected custom method may
inspect a nested receiver's cache, so no false blanket independence claim is
made about nested counts. The expected receiver is computed from a static path
and first-match selection, not by rerunning the recursive model algorithm.
Source: base/multidimensional.jl:834-837,903,918-920;
base/abstractarray.jl:731-750.
-/
def MaskReferenceAndCacheIndependence : Prop :=
  ∀ (State MaskRef Axis TypeTag Other NonTuple : Type) [DecidableEq TypeTag]
    (runtime : LogicalMaskRuntime (Effects State) MaskRef Axis TypeTag Other NonTuple)
    (inds : MaskAxisTuple Axis TypeTag)
    (logical : LogicalIndex (BooleanMaskRef MaskRef))
    (replacementCount : I64) (initial : State),
    let traced := tracingRuntime runtime
    let actual := MaskAxesProtocol.observe
      (checkindexLogicalTupleValue traced inds logical) (initial, [])
    let replaced : LogicalIndex (BooleanMaskRef MaskRef) := ⟨logical.mask, replacementCount⟩
    actual = MaskAxesProtocol.observe
      (checkindexLogicalTupleValue traced inds replaced) (initial, []) ∧
    match (SelectedActions runtime inds logical.mask).head? with
    | some (receiver, action) =>
        let result := MaskAxesProtocol.observe action initial
        actual = (result.1, (result.2, [.extension receiver]))
    | none =>
        let reference := TerminalReference logical.mask
        actual.2.2 = [.axes reference] ∧
        match MaskAxesProtocol.observe (runtime.axes reference) initial with
        | (.error error, final) => actual = (.error error, (final, [.axes reference]))
        | (.ok (.other _), final) =>
            actual = (.error (.methodError "_check_boolean_axes"), (final, [.axes reference]))
        | (.ok (.tuple _), _) => True

end LogicalMaskProtocol



