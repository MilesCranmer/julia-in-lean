open JuliaLean.Proofs.base.multidimensional.Models1Group5

 theorem step7_srem_zero (x y : I64) (hy : y.val ≠ 0) (hd : y.val ∣ x.val) :
    JuliaLean.base.int.remSame x y = .ok (int 0) := by
  unfold JuliaLean.base.int.remSame JuliaLean.base.int.rem_BitSigned64
    JuliaLean.base.int.checked_srem_int JuliaLean.C.jlCheckedSremInt
    JuliaLean.C.integerDivide
  simp only [↓reduceIte, scalar7_from_signed, beq_iff_eq, hy, Bool.true_and,
    Bool.true_or, bind, Except.bind, pure, Except.pure, JuliaLean.base.int.divideResult]
  by_cases ho : (x.val == -((2 ^ (IntTy.i64.bits - 1) : Nat) : Int) && y.val == -1) = true
  · rw [if_pos ho]
    rfl
  · rw [if_neg ho, Int.tmod_eq_zero_of_dvd hd]
    rfl

 theorem step7_urem_zero (x y : U64) (hy : y.val ≠ 0) (hd : y.val ∣ x.val) :
    JuliaLean.base.int.remSame x y = .ok (JInt.lit .u64 0) := by
  unfold JuliaLean.base.int.remSame JuliaLean.base.int.rem_BitUnsigned64
    JuliaLean.base.int.checked_urem_int JuliaLean.C.jlCheckedUremInt
    JuliaLean.C.integerDivide
  simp only [Bool.false_eq_true, ↓reduceIte, scalar7_from_unsigned, beq_iff_eq, hy, Bool.false_and,
    Bool.false_or, Bool.true_or, bind, Except.bind, pure, Except.pure,
    JuliaLean.base.int.divideResult, Int.tmod_eq_zero_of_dvd hd]
  rfl

 theorem step7_unsignedRemSigned_zero (x : U64) (y : I64)
    (hy : y.val ≠ 0) (hd : y.val ∣ x.val) :
    unsignedRemSigned x y = .ok (JInt.lit .u64 0) := by
  let v : U64 := JuliaLean.base.int.unsigned (JuliaLean.base.int.abs y)
  have hv : v.val ≠ 0 := by
    change (JuliaLean.base.int.unsigned (JuliaLean.base.int.abs y)).val ≠ 0
    rw [scalar7_abs_unsigned_val]
    intro h
    have hn : y.val.natAbs = 0 := by omega
    exact hy (Int.natAbs_eq_zero.mp hn)
  have hdv : v.val ∣ x.val := by
    change (JuliaLean.base.int.unsigned (JuliaLean.base.int.abs y)).val ∣ x.val
    rw [scalar7_abs_unsigned_val]
    exact Int.natAbs_dvd.mpr hd
  unfold unsignedRemSigned JuliaLean.base.int.Generic.rem_Unsigned_BitSigned
  rw [step7_urem_zero x v hv hdv]
  rfl

 theorem step7_neg_ne_zero (x : I64) (hx : x.val ≠ 0) :
    (JuliaLean.base.int.neg_int x).val ≠ 0 := by
  rw [scalar7_neg_val]
  by_cases hm : x.val = -9223372036854775808
  · rw [hm]
    decide
  · have hb := scalar7_i64_bounds x
    have hr : IntTy.min .i64 ≤ -x.val ∧ -x.val ≤ IntTy.max .i64 := by
      change -9223372036854775808 ≤ -x.val ∧ -x.val ≤ 9223372036854775807
      omega
    rw [wrapInt_of_inRange .i64 _ hr]
    omega

 theorem step7_neg_dvd (x : I64) (d : Int) (hd : x.val ∣ d) :
    (JuliaLean.base.int.neg_int x).val ∣ d := by
  rw [scalar7_neg_val]
  by_cases hm : x.val = -9223372036854775808
  · rw [hm]
    change (-9223372036854775808 : Int) ∣ d
    rw [hm] at hd
    exact hd
  · have hb := scalar7_i64_bounds x
    have hr : IntTy.min .i64 ≤ -x.val ∧ -x.val ≤ IntTy.max .i64 := by
      change -9223372036854775808 ≤ -x.val ∧ -x.val ≤ 9223372036854775807
      omega
    rw [wrapInt_of_inRange .i64 _ hr]
    exact Int.neg_dvd.mpr hd

 theorem step7_unsigned_difference (a b : I64) (h : a.val ≤ b.val) :
    (JuliaLean.base.int.unsigned (JuliaLean.base.int.sub b a)).val = b.val - a.val := by
  rw [scalar7_unsigned_val, sub_int_val, scalar7_wrap_mod]
  have ha := scalar7_i64_bounds a
  have hb := scalar7_i64_bounds b
  apply Int.emod_eq_of_lt <;> omega

 theorem step7_add_zero (x : I64) : x + int 0 = x := by
  apply Subtype.ext
  change wrapInt .i64 (x.val + 0) = x.val
  rw [Int.add_zero]
  exact wrapInt_of_inRange .i64 _ x.property

 theorem step7_sub_zero (x : I64) : x - int 0 = x := by
  apply Subtype.ext
  change wrapInt .i64 (x.val - 0) = x.val
  rw [Int.sub_zero]
  exact wrapInt_of_inRange .i64 _ x.property


 theorem step7_nonzero_test (x : I64) (hx : x.val ≠ 0) :
    JuliaLean.base.int.eqSame x (int 0) = false := by
  rw [scalar7_eqSame]
  change decide (x.val = 0) = false
  exact decide_eq_false hx

 theorem step7_stop_same (x s : I64) (hs : s.val ≠ 0) : stepStop x s x = .ok x := by
  have hz := step7_nonzero_test s hs
  have he : JuliaLean.base.int.eqSame x x = true := by
    rw [scalar7_eqSame]
    exact decide_eq_true rfl
  unfold stepStop JuliaLean.base.range.steprange_last
  dsimp only [JuliaLean.base.range.JType.isAbstractFloat,
    JuliaLean.base.range.JType.isInteger, JuliaLean.base.range.JType.isSigned,
    JuliaLean.base.range.JIsinteger.isinteger, JuliaLean.base.range.JZero.zero,
    JuliaLean.base.range.JEq.eq, JuliaLean.base.range.JLt.lt,
    JuliaLean.base.range.JSteprangeLastEmpty.steprangeLastEmpty,
    JuliaLean.base.range.JRangeWrappingSub.rangeWrappingSub, JuliaLean.base.range.JNeg.neg,
    JuliaLean.base.range.JConvert.convert, JuliaLean.base.range.JRem.rem]
  simp only [Bool.false_or, Bool.not_true, Bool.true_and, Bool.false_eq_true, ite_false]
  simp only [hz, he, Bool.false_eq_true, ↓reduceIte] <;> rfl

 theorem step7_empty_stop (r : JuliaLean.base.range.StepRange I64 I64)
    (hr : RangeConstructible (.stepped r)) (he : rangeIsEmpty (.stepped r) = true) :
    emptyStepStop r.start r.step r.stop = .ok r.stop := by
  have hend : r.stop.val = r.start.val - (if 0 < r.step.val then 1 else -1) := by
    simpa only [he, ite_true] using hr.2
  change Except.ok (if JuliaLean.base.int.ltSame (int 0) r.step then
    JuliaLean.base.int.sub_int r.start (int 1)
    else JuliaLean.base.int.add_int r.start (int 1)) = _
  rw [scalar7_ltSame]
  change Except.ok (if decide (0 < r.step.val) then
    JuliaLean.base.int.sub r.start (int 1)
    else JuliaLean.base.int.add r.start (int 1)) = _
  by_cases hp : 0 < r.step.val
  · rw [if_pos (decide_eq_true hp)]
    congr 1
    apply Subtype.ext
    rw [sub_int_val]
    change wrapInt .i64 (r.start.val - 1) = r.stop.val
    have hv : r.start.val - 1 = r.stop.val := by simpa only [hp, ite_true] using hend.symm
    rw [hv]
    exact wrapInt_of_inRange .i64 _ r.stop.property
  · rw [if_neg (by simpa only [decide_eq_true_eq] using hp)]
    congr 1
    apply Subtype.ext
    rw [scalar7_add_val]
    change wrapInt .i64 (r.start.val + 1) = r.stop.val
    have hv : r.start.val + 1 = r.stop.val := by
      simp only [hp, ite_false] at hend
      omega
    rw [hv]
    exact wrapInt_of_inRange .i64 _ r.stop.property

 theorem step7_stop_empty (r : JuliaLean.base.range.StepRange I64 I64)
    (hr : RangeConstructible (.stepped r)) (he : rangeIsEmpty (.stepped r) = true) :
    stepStop r.start r.step r.stop = .ok r.stop := by
  have hz := step7_nonzero_test r.step hr.1
  have he' := he
  change ((!JuliaLean.base.int.eqSame r.start r.stop) &&
    (JuliaLean.base.int.ltSame (int 0) r.step !=
      JuliaLean.base.int.ltSame r.start r.stop)) = true at he'
  have hpair := Bool.and_eq_true_iff.mp he'
  have hne : r.start.val ≠ r.stop.val := by
    intro hv
    have hh : JuliaLean.base.int.eqSame r.start r.stop = true := by
      rw [scalar7_eqSame]
      exact decide_eq_true hv
    rw [hh] at hpair
    cases hpair.1
  have hsame : JuliaLean.base.int.eqSame r.stop r.start = false := by
    rw [scalar7_eqSame]
    exact decide_eq_false (fun h => hne h.symm)
  have hguard := hpair.2
  unfold stepStop JuliaLean.base.range.steprange_last
  dsimp only [JuliaLean.base.range.JType.isAbstractFloat,
    JuliaLean.base.range.JType.isInteger, JuliaLean.base.range.JType.isSigned,
    JuliaLean.base.range.JIsinteger.isinteger, JuliaLean.base.range.JZero.zero,
    JuliaLean.base.range.JEq.eq, JuliaLean.base.range.JLt.lt,
    JuliaLean.base.range.JSteprangeLastEmpty.steprangeLastEmpty,
    JuliaLean.base.range.JRangeWrappingSub.rangeWrappingSub, JuliaLean.base.range.JNeg.neg,
    JuliaLean.base.range.JConvert.convert, JuliaLean.base.range.JRem.rem]
  simp only [Bool.false_or, Bool.not_true, Bool.true_and, Bool.false_eq_true, ite_false]
  simp only [hz, hsame, hguard, step7_empty_stop r hr he, Bool.false_eq_true, ↓reduceIte] <;> rfl

def step7_remainder (diff step : I64) : RegionResult I64 :=
  if JuliaLean.base.int.ltSame diff (int 0) then do
    let remainder ← unsignedRemSigned (JuliaLean.base.int.unsigned diff) step
    liftCore (JInt.convert "Int64" .i64 remainder.val)
  else do
    let remainder ← liftCore (JuliaLean.base.int.remSame diff step)
    pure remainder

 theorem step7_remainder_zero (diff step : I64) (hs : step.val ≠ 0)
    (hd : step.val ∣ (JuliaLean.base.int.unsigned diff).val) :
    step7_remainder diff step = .ok (int 0) := by
  unfold step7_remainder
  cases he : JuliaLean.base.int.ltSame diff (int 0) with
  | true =>
    rw [step7_unsignedRemSigned_zero _ _ hs hd]
    rfl
  | false =>
    have hn : 0 ≤ diff.val := by
      rw [scalar7_ltSame] at he
      change decide (diff.val < 0) = false at he
      have := decide_eq_false_iff_not.mp he
      omega
    have hu : (JuliaLean.base.int.unsigned diff).val = diff.val := by
      rw [scalar7_unsigned_val]
      have hb := scalar7_i64_bounds diff
      apply Int.emod_eq_of_lt <;> omega
    rw [hu] at hd
    rw [step7_srem_zero _ _ hs hd]
    rfl



def step7_overflow (diff : I64) (stride : I64 ⊕ I64) : RegionResult I64 :=
  @JuliaLean.base.range.steprange_last.overflow_case I64 (I64 ⊕ I64) U64 U64
    ⟨JuliaLean.base.int.unsigned⟩
    ⟨fun x y => unsignedRemSigned x (sameSum y)⟩
    ⟨fun x => liftCore (JInt.convert "Int64" .i64 x.val)⟩ diff stride

 theorem step7_overflow_zero (diff : I64) (stride : I64 ⊕ I64)
    (hs : (sameSum stride).val ≠ 0)
    (hd : (sameSum stride).val ∣ (JuliaLean.base.int.unsigned diff).val) :
    step7_overflow diff stride = .ok (int 0) := by
  unfold step7_overflow JuliaLean.base.range.steprange_last.overflow_case
  change (do
    let rem ← unsignedRemSigned (JuliaLean.base.int.unsigned diff) (sameSum stride)
    liftCore (JInt.convert "Int64" .i64 rem.val)) = _
  rw [step7_unsignedRemSigned_zero _ _ hs hd]
  rfl

 theorem step7_signed_zero (diff stride : I64) (hs : stride.val ≠ 0)
    (hd : stride.val ∣ (JuliaLean.base.int.unsigned diff).val)
    (he : JuliaLean.base.int.ltSame diff (int 0) = false) :
    JuliaLean.base.int.remSame diff stride = .ok (int 0) := by
  have hn : 0 ≤ diff.val := by
    rw [scalar7_ltSame] at he
    change decide (diff.val < 0) = false at he
    have := decide_eq_false_iff_not.mp he
    omega
  have hu : (JuliaLean.base.int.unsigned diff).val = diff.val := by
    rw [scalar7_unsigned_val]
    have hb := scalar7_i64_bounds diff
    apply Int.emod_eq_of_lt <;> omega
  rw [hu] at hd
  exact step7_srem_zero diff stride hs hd

 theorem step7_stop_up (r : JuliaLean.base.range.StepRange I64 I64)
    (hz : r.step.val ≠ 0) (hne : r.stop.val ≠ r.start.val)
    (hg : (JuliaLean.base.int.ltSame (int 0) r.step !=
      JuliaLean.base.int.ltSame r.start r.stop) = false)
    (hu : JuliaLean.base.int.ltSame r.start r.stop = true)
    (hd : r.step.val ∣ r.stop.val - r.start.val) :
    stepStop r.start r.step r.stop = .ok r.stop := by
  let diff : I64 := JuliaLean.base.int.sub r.stop r.start
  have hup : r.start.val < r.stop.val := by
    rw [scalar7_ltSame] at hu
    exact of_decide_eq_true hu
  have hdiff : (JuliaLean.base.int.unsigned diff).val = r.stop.val - r.start.val :=
    step7_unsigned_difference r.start r.stop (by omega)
  have hdiv : r.step.val ∣ (JuliaLean.base.int.unsigned diff).val := by
    rw [hdiff]
    exact hd
  have hrem := step7_remainder_zero diff r.step hz hdiv
  have hzero := step7_nonzero_test r.step hz
  have hsame : JuliaLean.base.int.eqSame r.stop r.start = false := by
    rw [scalar7_eqSame]
    exact decide_eq_false hne
  unfold stepStop JuliaLean.base.range.steprange_last
  dsimp only [JuliaLean.base.range.JType.isAbstractFloat,
    JuliaLean.base.range.JType.isInteger, JuliaLean.base.range.JType.isSigned,
    JuliaLean.base.range.JIsinteger.isinteger, JuliaLean.base.range.JZero.zero,
    JuliaLean.base.range.JEq.eq, JuliaLean.base.range.JLt.lt,
    JuliaLean.base.range.JSteprangeLastEmpty.steprangeLastEmpty,
    JuliaLean.base.range.JRangeWrappingSub.rangeWrappingSub, JuliaLean.base.range.JNeg.neg,
    JuliaLean.base.range.JConvert.convert, JuliaLean.base.range.JRem.rem]
  simp only [Bool.false_or, Bool.not_true, Bool.true_and, Bool.false_eq_true, ite_false]
  have hg' := hg
  rw [hu] at hg'
  simp only [hzero, hsame, hu, hg', Bool.false_eq_true, ↓reduceIte]
  change (if JuliaLean.base.int.ltSame diff (int 0) then do
    let remainder ← step7_overflow diff (.inl r.step)
    pure (r.stop - remainder)
    else do
      let remainder ← liftCore (JuliaLean.base.int.remSame diff r.step)
      pure (r.stop - remainder)) = .ok r.stop
  rw [step7_overflow_zero diff (.inl r.step) hz hdiv]
  cases hc : JuliaLean.base.int.ltSame diff (int 0) with
  | true =>
    change Except.ok (r.stop - int 0) = Except.ok r.stop
    rw [step7_sub_zero]
  | false =>
    rw [step7_signed_zero diff r.step hz hdiv hc]
    change Except.ok (r.stop - int 0) = Except.ok r.stop
    rw [step7_sub_zero]

 theorem step7_stop_down (r : JuliaLean.base.range.StepRange I64 I64)
    (hz : r.step.val ≠ 0) (hne : r.stop.val ≠ r.start.val)
    (hg : (JuliaLean.base.int.ltSame (int 0) r.step !=
      JuliaLean.base.int.ltSame r.start r.stop) = false)
    (hu : JuliaLean.base.int.ltSame r.start r.stop = false)
    (hd : r.step.val ∣ r.stop.val - r.start.val) :
    stepStop r.start r.step r.stop = .ok r.stop := by
  let diff : I64 := JuliaLean.base.int.sub r.start r.stop
  let stride : I64 := JuliaLean.base.int.neg_int r.step
  have hdown : r.stop.val ≤ r.start.val := by
    rw [scalar7_ltSame] at hu
    have := decide_eq_false_iff_not.mp hu
    omega
  have hdiff : (JuliaLean.base.int.unsigned diff).val = r.start.val - r.stop.val :=
    step7_unsigned_difference r.stop r.start hdown
  have hdneg : r.step.val ∣ r.start.val - r.stop.val := by
    have hh := Int.dvd_neg.mpr hd
    have heq : -(r.stop.val - r.start.val) = r.start.val - r.stop.val := by omega
    rw [heq] at hh
    exact hh
  have hdiv : stride.val ∣ (JuliaLean.base.int.unsigned diff).val := by
    rw [hdiff]
    exact step7_neg_dvd r.step _ hdneg
  have hstride : stride.val ≠ 0 := step7_neg_ne_zero r.step hz
  have hrem := step7_remainder_zero diff stride hstride hdiv
  have hzero := step7_nonzero_test r.step hz
  have hsame : JuliaLean.base.int.eqSame r.stop r.start = false := by
    rw [scalar7_eqSame]
    exact decide_eq_false hne
  unfold stepStop JuliaLean.base.range.steprange_last
  dsimp only [JuliaLean.base.range.JType.isAbstractFloat,
    JuliaLean.base.range.JType.isInteger, JuliaLean.base.range.JType.isSigned,
    JuliaLean.base.range.JIsinteger.isinteger, JuliaLean.base.range.JZero.zero,
    JuliaLean.base.range.JEq.eq, JuliaLean.base.range.JLt.lt,
    JuliaLean.base.range.JSteprangeLastEmpty.steprangeLastEmpty,
    JuliaLean.base.range.JRangeWrappingSub.rangeWrappingSub, JuliaLean.base.range.JNeg.neg,
    JuliaLean.base.range.JConvert.convert, JuliaLean.base.range.JRem.rem]
  simp only [Bool.false_or, Bool.not_true, Bool.true_and, Bool.false_eq_true, ite_false]
  have hg' := hg
  rw [hu] at hg'
  simp only [hzero, hsame, hu, hg', Bool.false_eq_true, ↓reduceIte]
  change (if JuliaLean.base.int.ltSame diff (int 0) then do
    let remainder ← step7_overflow diff (.inr stride)
    pure (r.stop + remainder)
    else do
      let remainder ← liftCore (JuliaLean.base.int.remSame diff stride)
      pure (r.stop + remainder)) = .ok r.stop
  rw [step7_overflow_zero diff (.inr stride) hstride hdiv]
  cases hc : JuliaLean.base.int.ltSame diff (int 0) with
  | true =>
    change Except.ok (r.stop + int 0) = Except.ok r.stop
    rw [step7_add_zero]
  | false =>
    rw [step7_signed_zero diff stride hstride hdiv hc]
    change Except.ok (r.stop + int 0) = Except.ok r.stop
    rw [step7_add_zero]

 theorem step7_stop_normalized (r : JuliaLean.base.range.StepRange I64 I64)
    (hr : RangeConstructible (.stepped r)) :
    stepStop r.start r.step r.stop = .ok r.stop := by
  by_cases hs : r.start = r.stop
  · rw [hs]
    exact step7_stop_same r.stop r.step hr.1
  · cases he : rangeIsEmpty (.stepped r) with
    | true => exact step7_stop_empty r hr he
    | false =>
      have hne : r.stop.val ≠ r.start.val := by
        intro hv
        exact hs (Subtype.ext hv.symm)
      have hsame : JuliaLean.base.int.eqSame r.start r.stop = false := by
        rw [scalar7_eqSame]
        exact decide_eq_false (fun hv => hne hv.symm)
      have hg := he
      change ((!JuliaLean.base.int.eqSame r.start r.stop) &&
        (JuliaLean.base.int.ltSame (int 0) r.step !=
          JuliaLean.base.int.ltSame r.start r.stop)) = false at hg
      rw [hsame] at hg
      change (JuliaLean.base.int.ltSame (int 0) r.step !=
        JuliaLean.base.int.ltSame r.start r.stop) = false at hg
      have hm : (r.stop.val - r.start.val) % r.step.val = 0 := by
        simpa only [he, Bool.false_eq_true, ite_false] using hr.2
      have hd := Int.dvd_of_emod_eq_zero hm
      cases hu : JuliaLean.base.int.ltSame r.start r.stop with
      | true => exact step7_stop_up r hr.1 hne hg hu hd
      | false => exact step7_stop_down r hr.1 hne hg hu hd

 theorem step7_rangeStepped_normalized (r : JuliaLean.base.range.StepRange I64 I64)
    (hr : RangeConstructible (.stepped r)) :
    rangeStepped r.start r.step r.stop = .ok (.stepped r) := by
  have hm : makeStep r.start r.step r.stop = .ok r := by
    change (do let last ← stepStop r.start r.step r.stop
               pure (JuliaLean.base.range.StepRange.mk r.start r.step last)) = _
    rw [step7_stop_normalized r hr]
    rfl
  unfold rangeStepped
  rw [hm]
  rfl

 theorem Models1G5RegionMixedConstructor_proven :
    JuliaLean.Proofs.base.multidimensional.Models1Group5.RegionMixedConstructorCorrect :=
  mix7_correct_of_step_normalization step7_rangeStepped_normalized

