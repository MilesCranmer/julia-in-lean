  simp only [regionFromRanges, List.map_id]
  refine ⟨h, ⟨rfl, ?_⟩, ?_⟩
  · intro k before after hb ha
    have heq : before = after := Option.some.inj (hb.symm.trans ha)
    subst after
    intro position
    rfl
  · intro k before after hb ha
    have heq : before = after := Option.some.inj (hb.symm.trans ha)
    subst after
    exact ctor7_sameTag_refl before

