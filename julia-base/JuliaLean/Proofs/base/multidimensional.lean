      rfl
  | cons input rest ih =>
      have noFirst : failAt ≠ some previous.length :=
        noFailure previous.length (Nat.le_refl _) (by simp only [List.length_cons]; omega)
      have noRest : ∀ ordinal, (previous ++ [input]).length ≤ ordinal →
          ordinal < (previous ++ [input]).length + rest.length → failAt ≠ some ordinal := by
        intro ordinal lower upper
        apply noFailure ordinal
        · simp only [List.length_append, List.length_singleton] at lower
          omega
        · simp only [List.length_append, List.length_singleton] at upper
          simp only [List.length_cons]
