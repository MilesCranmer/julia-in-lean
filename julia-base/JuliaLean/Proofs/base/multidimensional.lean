theorem permCheckDimsWithDefault {Axis : Type} {rank : Nat}
    (axisEqual : Axis → Axis → Result Bool)
    (destination source : RankedAxes Axis rank) (permutation : ShortIntTuple)
    (default : Axis) :
    checkDimsPermShort axisEqual destination source permutation =
      JuliaLean.Proofs.base.multidimensional.Models1Group6.PermutedAxesReference
        axisEqual destination source permutation := by
  unfold JuliaLean.Proofs.base.multidimensional.Models1Group6.PermutedAxesReference
  by_cases hlen : permutation.val.length = rank
  · simp only [hlen, ne_eq, not_true_eq_false, ite_false]
    have hcheck : (permutation.val.length != source.val.length) = false := by
      simp only [source.property, hlen, bne_self_eq_false]
    by_cases hp : JuliaLean.Proofs.base.multidimensional.Models1Group6.ShortTuplePermutation permutation
    · rw [ite_eq_right (fun hnot => hnot hp)]
      change checkDimsPermShort axisEqual destination source permutation =
        permOutcomeResult ((destination.val.zip permutation.val).map
          (permAxisOutcome axisEqual source.val))
      rw [← permIndexedAxisComparisons axisEqual destination.val source.val permutation default
        (destination.property.trans hlen.symm) (permEntriesPositive permutation hp)]
      rw [checkDimsPermShort]
      simp only [hcheck, Bool.false_eq_true, ite_false]
      rw [permShortTupleCorrect permutation]
      simp only [hp, decide_true]
      rfl
    · rw [ite_eq_left hp, checkDimsPermShort]
      simp only [hcheck, Bool.false_eq_true, ite_false]
      rw [permShortTupleCorrect permutation]
      simp only [hp, decide_false]
      rfl
  · rw [ite_eq_left hlen, checkDimsPermShort]
    have hcheck : (permutation.val.length != source.val.length) = true := by
      rw [source.property]
      exact bne_iff_ne.mpr hlen
    rw [ite_eq_left hcheck]
    change Except.error (Error.argumentError ("expected permutation of size " ++
        toString source.val.length ++ ", but length(perm)=" ++ toString permutation.val.length)) = _
    rw [source.property]

theorem permCheckDimsProtocol {Axis : Type} {rank : Nat}
    (axisEqual : Axis → Axis → Result Bool)
    (destination source : RankedAxes Axis rank) (permutation : ShortIntTuple) :
    checkDimsPermShort axisEqual destination source permutation =
      JuliaLean.Proofs.base.multidimensional.Models1Group6.PermutedAxesReference
        axisEqual destination source permutation := by
  cases hd : destination.val with
  | nil =>
    have hrank : rank = 0 := by
      have h := destination.property
      rw [hd] at h
      exact h.symm
    have hs : source.val = [] := by
      apply List.length_eq_zero_iff.mp
      exact source.property.trans hrank
    by_cases hp : permutation.val = []
    · have hlength : permutation.val.length = rank := by rw [hp, hrank]; rfl
      have hperm : JuliaLean.Proofs.base.multidimensional.Models1Group6.ShortTuplePermutation permutation := by
        simp only [JuliaLean.Proofs.base.multidimensional.Models1Group6.ShortTuplePermutation,
          hp, List.map_nil, List.length_nil, List.range_zero]
        exact List.Perm.refl []
      have hmodel : checkDimsPermShort axisEqual destination source permutation = .ok () := by
        rw [checkDimsPermShort]
        simp only [hs, hp, List.length_nil, bne_self_eq_false, Bool.false_eq_true, ite_false]
        rw [permShortTupleCorrect permutation]
        simp only [hperm, decide_true]
        rfl
      rw [hmodel]
      unfold JuliaLean.Proofs.base.multidimensional.Models1Group6.PermutedAxesReference
      rw [ite_eq_right (fun hne => hne hlength), ite_eq_right (fun hn => hn hperm)]
      rw [hd]
      rfl
    · have hneq : permutation.val.length ≠ rank := by
        rw [hrank]
        intro he
        exact hp (List.length_eq_zero_iff.mp he)
      have hcheck : (permutation.val.length != source.val.length) = true := by
        rw [source.property]
        exact bne_iff_ne.mpr hneq
      rw [checkDimsPermShort, ite_eq_left hcheck]
      change Except.error (Error.argumentError ("expected permutation of size " ++
        toString source.val.length ++ ", but length(perm)=" ++ toString permutation.val.length)) = _
      unfold JuliaLean.Proofs.base.multidimensional.Models1Group6.PermutedAxesReference
      rw [ite_eq_left hneq, source.property]
  | cons default rest => exact permCheckDimsWithDefault axisEqual destination source permutation default

theorem Models1G6CheckdimsPermShortProtocol_proven :
    JuliaLean.Proofs.base.multidimensional.Models1Group6.CheckDimsPermShortProtocol := by
  intro Axis rank axisEqual destinationAxes sourceAxes permutation _
  cases destinationAxes with
  | error error => rfl
  | ok destination =>
    cases sourceAxes with
    | error error => rfl
    | ok source => exact permCheckDimsProtocol axisEqual destination source permutation

