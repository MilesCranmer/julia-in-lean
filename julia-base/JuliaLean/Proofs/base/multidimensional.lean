inductive NativeRangeObservation where
  | first | step | last

/-- Mathematical stored-field observations, including the exact stored stop
of empty ranges. No reconstructed cardinality is substituted for last. -/
def NativeRangeObservedValue (kind : NativeRangeObservation) (range : OrdinalRange64) : Int :=
  match kind, range with
  | .first, .oneTo _ => 1
  | .first, .unit value => value.start.val
  | .first, .stepped value => value.start.val
  | .step, .oneTo _ | .step, .unit _ => 1
  | .step, .stepped value => value.step.val
  | .last, .oneTo value => value.stop.val
  | .last, .unit value => value.stop.val
  | .last, .stepped value => value.stop.val

def NativeMappedCoordinates (kind : NativeRangeObservation) (ranges : Region64)
    (outcome : RegionResult (Sum CI Empty)) : Prop :=
  match outcome with
  | .ok (.inl coordinates) =>
      coordinates.length = ranges.length ∧
      ∀ (k : Nat) (range : OrdinalRange64), ranges[k]? = some range →
        ∃ coordinate : I64, coordinates[k]? = some coordinate ∧
          coordinate.val = NativeRangeObservedValue kind range
  | _ => False

/-- Independent positional native contract for each mapped coordinate
method, including rank zero, all stored endpoint values, and empty ranges.
Source: base/multidimensional.jl:491-494; base/range.jl:735-736,867-868,877. -/
def NativeMappedCoordinatesCorrect : Prop :=
  ∀ ranges : Region64, TupleArity ranges →
    NativeMappedCoordinates .step ranges
      (regionStepGeneric (nativeMappedCoordinateOps rangeStep) ranges) ∧
    NativeMappedCoordinates .first ranges
      (regionFirstGeneric (nativeMappedCoordinateOps rangeFirst) ranges) ∧
    NativeMappedCoordinates .last ranges
      (regionLastGeneric (nativeMappedCoordinateOps rangeLast) ranges)

theorem mapThenConstruct_native (observe : Models1Group5.RangeDependencies.OrdinalRange64 → I64)
    (ranges : Models1Group5.Region64) :
    Models2Group3.mapThenConstruct (Models2Group3.nativeMappedCoordinateOps observe)
      (Sum.inl <$> cartesianTuple (cartesianInner (fun value : I64 => pure value)) []) ranges =
      .ok (.inl (ranges.map observe)) := by
  unfold Models2Group3.mapThenConstruct
  rw [tupleMapDispatch_ok (Models2Group3.nativeMappedCoordinateOps observe).mapping
    observe (fun _ _ => rfl) ranges (fun _ _ => rfl)]
  cases h : ranges.map observe with
  | nil => rfl
  | cons x xs =>
      change (Sum.inl <$> cartesianTuple (cartesianInner (fun value : I64 => pure value)) (x :: xs)) =
        Except.ok (.inl (x :: xs))
      unfold cartesianTuple cartesianInner
      rw [Models1Group5.Batch9.ctor7_mapM_ok (fun value : I64 => (pure value : Models1Group5.RangeDependencies.RangeResult I64)) id (x :: xs) (fun _ _ => rfl)]
      simp [List.map_id]
      rfl

theorem nativeMappedCoordinatesCorrect_proven :
    Models2Group3.NativeMappedCoordinatesCorrect := by
  intro ranges _
  have hstep (r : Models1Group5.RangeDependencies.OrdinalRange64) :
      (Models1Group5.RangeDependencies.rangeStep r).val =
        Models2Group3.NativeRangeObservedValue .step r := by
    cases r with
    | oneTo _ => change (JuliaLean.base.int.sub (int 1) (int 0)).val = 1; decide
    | unit _ => change (JuliaLean.base.int.sub (int 1) (int 0)).val = 1; decide
    | stepped _ => rfl
  have hfirst (r : Models1Group5.RangeDependencies.OrdinalRange64) :
      (Models1Group5.RangeDependencies.rangeFirst r).val =
        Models2Group3.NativeRangeObservedValue .first r := by
    cases r with
    | oneTo _ => change (int 1).val = 1; decide
    | unit _ => rfl
    | stepped _ => rfl
  have hlast (r : Models1Group5.RangeDependencies.OrdinalRange64) :
      (Models1Group5.RangeDependencies.rangeLast r).val =
        Models2Group3.NativeRangeObservedValue .last r := by
    cases r <;> rfl
  refine ⟨?_, ?_, ?_⟩
  · unfold Models2Group3.regionStepGeneric
    rw [mapThenConstruct_native]
    refine ⟨List.length_map .., ?_⟩
    intro k range hk
    exact ⟨_, by simp [List.getElem?_map, hk], hstep range⟩
  · unfold Models2Group3.regionFirstGeneric
    rw [mapThenConstruct_native]
    refine ⟨List.length_map .., ?_⟩
    intro k range hk
    exact ⟨_, by simp [List.getElem?_map, hk], hfirst range⟩
  · unfold Models2Group3.regionLastGeneric
    rw [mapThenConstruct_native]
    refine ⟨List.length_map .., ?_⟩
    intro k range hk
    exact ⟨_, by simp [List.getElem?_map, hk], hlast range⟩

