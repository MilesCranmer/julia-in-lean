  match ops.selected element mask with
  | some _ => records = [(initial, final, .selected element mask reply)]
  | none => match reply with
      | .ok (.inl logical) => LogicalInnerTerminal element mask initial final (.ok logical) records
      | .ok (.inr _) => False
      | .error error => LogicalInnerTerminal element mask initial final (.error error) records

