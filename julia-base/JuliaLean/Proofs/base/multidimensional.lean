    IntegerAssignedEvent Extra A Integer Value Other → Nat
  | .convert .. => 0 | .bounds .. => 1 | .style .. => 2 | .length .. => 3
  | .notOne .. => 4 | .dimensions .. => 5 | .notDimensions .. => 6
  | .linear .. => 7 | .scalar .. => 8 | .subscripts .. => 9 | .splat .. => 10 | .access .. => 11

