/-- Machine-constructible tuple arity, not an arbitrary no-overflow bound on a lazy array. -/
def TupleFits {α : Type} (xs : List α) : Prop :=
  (xs.length : Int) ≤ IntTy.max .i64

/-- Mathematical representability of a stored Julia Int coordinate. -/
def IntFits (z : Int) : Prop :=
  IntTy.min .i64 ≤ z ∧ z ≤ IntTy.max .i64

def MathematicalCoords (xs : CI) : List Int := xs.map (fun x => x.val)
def InputValues (xs : List JuliaLean.base.tuple.Index) : List Int :=
  xs.map JuliaLean.base.tuple.Index.value

/-- A successful constructor preserves the mathematical coordinates. Failure is allowed
exactly when a stored coordinate cannot be represented. This specification does not call
another constructor, tuple conversion, or field-assignment model. -/
def ConstructorOutcome (values : List Int) (outcome : Result CI) : Prop :=
  match outcome with
  | .ok index => MathematicalCoords index = values
  | .error (.inexactError _) => ∃ z ∈ values, ¬IntFits z
  | .error _ => False

/-- Documented integer tuple and vararg constructors preserve all coordinates, or reject
an unrepresentable Int64 field. Bool, all ten BitInteger types, and the existing BigInt-value
interface are quantified without value restrictions. The source family also permits custom
Integer dispatch; that unavailable boundary is recorded separately in NOTES.md.
Source: base/multidimensional.jl:75-82; doc/src/manual/arrays.md:802-820. -/
def IntegerConstructorsCorrect : Prop :=
  ∀ xs : List JuliaLean.base.tuple.Index, TupleFits xs →
    ConstructorOutcome (InputValues xs) (constructIntegers xs) ∧
    ConstructorOutcome (InputValues xs) (constructTuple xs) ∧
    ConstructorOutcome (InputValues xs) (constructVarargs xs) ∧
    ConstructorOutcome (InputValues xs) (constructSizedVarargs xs)

/-- Rank and component conditions characterize padding independently of its implementation. -/
def PaddingOutcome (rank : Int) (values : List Int) (outcome : Result CI) : Prop :=
  if (values.length : Int) > rank then
    ∃ message, outcome = .error (.argumentError message)
  else
    match outcome with
    | .ok index =>
        (index.length : Int) = rank ∧
        (∀ (k : Nat) (z : Int), values[k]? = some z → (MathematicalCoords index)[k]? = some z) ∧
        (∀ k : Nat, values.length ≤ k → k < index.length →
          (MathematicalCoords index)[k]? = some 1)
    | .error (.inexactError _) => ∃ z ∈ values, ¬IntFits z
    | .error _ => False

/-- Fixed-rank construction preserves supplied coordinates, fills missing coordinates with 1,
and rejects an overlong tuple before any coordinate conversion. Nonnegative Int rank is the
CartesianIndex type-arity invariant, not a successful-call assumption.
Source: base/multidimensional.jl:83-86; base/ntuple.jl:74-85. -/
def PaddedConstructorsCorrect : Prop :=
  ∀ (rank : I64) (xs : List JuliaLean.base.tuple.Index),
    0 ≤ rank.val → TupleFits xs →
    PaddingOutcome rank.val (InputValues xs) (constructPadded rank xs) ∧
    PaddingOutcome rank.val (InputValues xs) (constructSizedIntegers rank xs)

/-- The no-coordinate constructor has the requested valid rank and every coordinate is 1.
Source: base/multidimensional.jl:84-86. -/
def DefaultConstructorCorrect : Prop :=
  ∀ rank : I64, 0 ≤ rank.val →
    match constructDefault rank with
    | .ok index => (index.length : Int) = rank.val ∧ ∀ x ∈ index, x.val = 1
    | .error _ => False

/-- The mathematical coordinate sequence represented by a mixed argument. -/
def MixedValues : MixedArg → List Int
  | .scalar x => [x.value]
  | .cartesian index => MathematicalCoords index

/-- The flattened tuple must itself be representable by Julia's finite tuple arity.
No claim is made here for concatenations outside that existing tuple representation boundary. -/
def MixedTuplesFit (xs : List MixedArg) : Prop :=
  TupleFits xs ∧ TupleFits (xs.flatMap MixedValues)

/-- Mixed scalar and CartesianIndex construction preserves each contributed coordinate in
left-to-right order, including empty CartesianIndex arguments, or reports an unrepresentable
Int64 field. Source: base/multidimensional.jl:89-93; manual/arrays.md:802-820. -/
def MixedConstructorsCorrect : Prop :=
  ∀ xs : List MixedArg, MixedTuplesFit xs →
    ConstructorOutcome (xs.flatMap MixedValues) (constructMixed xs) ∧
    ConstructorOutcome (xs.flatMap MixedValues) (constructMixedTuple xs)

/-- Indexing returns the indicated coordinate; Int conversion errors precede tuple bounds
errors. Its expected coordinate is read from the pre-existing input value, independently of
any getindex implementation. Source: base/multidimensional.jl:105; base/tuple.jl:33-34. -/
def CoordinatesCorrect : Prop :=
  ∀ (index : CI) (i : JuliaLean.base.tuple.Index), TupleFits index →
    match coordinates index i with
    | .ok value =>
        ∃ k : Nat, (k : Int) + 1 = i.value ∧ index[k]? = some value
    | .error .boundsError =>
        IntFits i.value ∧ (i.value < 1 ∨ (index.length : Int) < i.value)
    | .error (.inexactError _) => ¬IntFits i.value
    | .error _ => False

/-- First and last coordinate indices delimit exactly the positions where coordinate lookup
succeeds, including the empty rank-zero interval.
Source: base/multidimensional.jl:105-107; base/tuple.jl:29-34. -/
def CoordinateIndexBoundsCorrect : Prop :=
  ∀ index : CI, TupleFits index →
    (firstCoordinateIndex index).val = 1 ∧
    (lastCoordinateIndex index).val = (index.length : Int) ∧
    ∀ i : I64,
      ((firstCoordinateIndex index).val ≤ i.val ∧ i.val ≤ (lastCoordinateIndex index).val) ↔
      ∃ value, coordinates index (.integer .i64 i) = .ok value

/-- A mathematical splice of the replacement coordinates into the original coordinate sequence.
The source instead updates a tuple then dispatches its constructor and flattens nested indices. -/
def ReplacementValues (index : CI) (replacement : MixedArg) (j : Int) : List Int :=
  (MathematicalCoords index).take (j - 1).toNat ++
    MixedValues replacement ++ (MathematicalCoords index).drop j.toNat

/-- Invalid replacement positions fail before converting the replacement, including arbitrarily
large BigInt-value subscripts and replacements whose scalar coordinate is out of Int64 range.
Source: base/multidimensional.jl:114; base/tuple.jl:56-65. -/
def ReplacementBoundsCorrect : Prop :=
  ∀ (index : CI) (replacement : MixedArg) (j : JuliaLean.base.tuple.Index),
    TupleFits index → TupleFits (MixedValues replacement) →
    (j.value < 1 ∨ (index.length : Int) < j.value) →
    setCoordinate index replacement j = .error .boundsError

/-- A valid replacement preserves all surrounding coordinates and splices in the replacement's
coordinates, which can change rank for a CartesianIndex replacement. Unrepresentable scalar
replacement coordinates cause InexactError. Input and resulting flattened tuple arities are
within the represented Julia tuple boundary; arbitrary replacement object dispatch is not
claimed. Source: base/multidimensional.jl:89-93,114; base/tuple.jl:44-65. -/
def ReplacementCoordinatesCorrect : Prop :=
  ∀ (index : CI) (replacement : MixedArg) (j : JuliaLean.base.tuple.Index),
    TupleFits index → TupleFits (MixedValues replacement) →
    1 ≤ j.value → j.value ≤ (index.length : Int) →
    TupleFits (ReplacementValues index replacement j.value) →
    ConstructorOutcome (ReplacementValues index replacement j.value)
      (setCoordinate index replacement j)

/-- Zero and oneunit have the original rank and contain only the corresponding identity
coordinate, including rank zero. Source: base/multidimensional.jl:120-123. -/
def CoordinateIdentitiesCorrect : Prop :=
  ∀ index : CI, TupleFits index →
    (zeroFromValue index).length = index.length ∧
    (∀ z ∈ zeroFromValue index, z.val = 0) ∧
    (oneFromValue index).length = index.length ∧
    (∀ z ∈ oneFromValue index, z.val = 1)

theorem CoordinateIdentitiesCorrect_proven : CoordinateIdentitiesCorrect := by
  intro index _
  simp only [zeroFromValue, cartesianZeroValue, cartesianZeroType,
    oneFromValue, cartesianOneValue, cartesianOneType,
    List.length_map, List.length_range, List.mem_map]
  refine ⟨trivial, ?_, trivial, ?_⟩
  · rintro z ⟨_, _, rfl⟩; decide
  · rintro z ⟨_, _, rfl⟩; decide

/-- CartesianIndex comparison is decided by its largest differing coordinate. This independent
witness characterization avoids copying reverse(tuple) and tuple comparison from the model.
Equal-rank arguments are the source method's dispatch invariant.
Source: base/multidimensional.jl:141-142. -/
def ColexicographicOrderCorrect : Prop :=
  ∀ (a b : CI), TupleFits a → a.length = b.length →
    (less a b = true ↔
      ∃ (k : Nat) (x y : I64), k < a.length ∧
        a[k]? = some x ∧ b[k]? = some y ∧ x.val < y.val ∧
        ∀ j : Nat, k < j → j < a.length → a[j]? = b[j]?)

/-- A CartesianIndex is scalar for iteration; attempting to iterate it raises ErrorException.
Source: base/multidimensional.jl:37-39,174-177. -/
def CartesianIterationRejected : Prop :=
  ∀ index : CI, TupleFits index →
    ∃ message, iterateError index = .error (.errorException message)

theorem CartesianIterationRejected_proven : CartesianIterationRejected := by
  intro index _
  exact ⟨_, rfl⟩

/-- For a fixed coordinate sequence, hashing permutes the UInt64 seed. This is an independent
structural invariant of the seeded integer hash: xor-shifts and odd multiplications are
bijective; it asserts no injectivity of coordinate hashes. No proof is supplied.
Source: base/multidimensional.jl:149-156; base/hashing.jl:53-76. -/
def HashSeedInjective : Prop :=
  ∀ index : CI, TupleFits index → ∀ a b : JInt .u64,
    hashCoordinates index a = hashCoordinates index b ↔ a = b


/-- The mathematical value of a machine product is the unique representative in the promoted
integer range congruent to the exact product modulo 2^width. This relational description does
not use the implementation's promotion casts, binop, multiplication, or wrapping helper. -/
def PromotedProduct (t : IntTy) (a : Int) (x : I64) (p : Int) : Prop :=
  IntTy.min (t.promote .i64) ≤ p ∧ p ≤ IntTy.max (t.promote .i64) ∧
  (p - a * x.val) % ((2 : Int) ^ (t.promote .i64).bits) = 0

/-- On success, every output coordinate is the mathematical promoted machine product.
InexactError requires a promoted product that cannot be stored in an Int64 coordinate. -/
def ScalingOutcome {t : IntTy} (a : JInt t) (index : CI) (outcome : Result CI) : Prop :=
  match outcome with
  | .ok result =>
      result.length = index.length ∧
      ∀ (k : Nat) (x : I64), index[k]? = some x →
        ∃ y : I64, result[k]? = some y ∧ PromotedProduct t a.val x y.val
  | .error (.inexactError _) =>
      ∃ x ∈ index, ∃ p : Int, PromotedProduct t a.val x p ∧ ¬IntFits p
  | .error _ => False

/-- Scaling on either side preserves rank and computes every coordinate modulo the promoted
machine width, then checks that the product is representable as Int64. It covers all ten
BitInteger scalar types without restricting any coordinate or product values, including
unsigned promotion of negative coordinates. Source: base/multidimensional.jl:138-139;
base/int.jl:809-822,1092-1100; manual/integers-and-floating-point-numbers.md:231-249. -/
def BitIntegerScalingCorrect : Prop :=
  ∀ (t : IntTy) (a : JInt t) (index : CI), TupleFits index →
    ScalingOutcome a index (scaleBitsLeft a index) ∧
    ScalingOutcome a index (scaleBitsRight index a)


/-- Bool multiplication preserves the original coordinate sequence at true and annihilates
every coordinate at false, retaining rank and both multiplication orders. This independent
algebraic invariant includes every machine coordinate and the zero-dimensional index.
Source: base/multidimensional.jl:138-139; base/bool.jl:6. -/
def BooleanScalingCorrect : Prop :=
  ∀ (index : CI) (scalar : Bool), TupleFits index →
    ∃ result : CI, scaleBoolLeft scalar index = .ok result ∧
      scaleBoolRight index scalar = .ok result ∧ result.length = index.length ∧
      ∀ (k : Nat) (coordinate : I64), index[k]? = some coordinate →
        ∃ value : I64, result[k]? = some value ∧
          value.val = (if scalar then 1 else 0) * coordinate.val

