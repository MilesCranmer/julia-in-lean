inductive EarlyScaleEvent (A P N Out E : Type) where
  | multiply (scalar : A) (coordinate : I64) (reply : AccessResult E P)
  | map (scalar : A) (coordinates : CI) (reply : AccessResult E (Sum (List P) N))
  | splat (head : P) (tail : N) (reply : AccessResult E (List P))
  | construct (rank : I64) (mapped : Sum (List P) N) (reply : AccessResult E Out)
  | left (scalar : A) (coordinates : CI) (reply : AccessResult E Out)

def earlyScaleMapEvent {A P N Out E : Type} :
    EarlyScaleEvent A P N Out E → Option (MapQueryEvent E I64 P N)
  | .multiply _ coordinate reply => some (.element coordinate reply)
  | .map _ coordinates reply => some (.selected coordinates reply)
  | .splat head tail reply => some (.splat head tail reply)
  | _ => none

def earlyScaleConstructEvent {A P N Out E : Type} :
    EarlyScaleEvent A P N Out E → Option (I64 × Sum (List P) N × AccessResult E Out)
  | .construct rank mapped reply => some (rank, mapped, reply)
  | _ => none

def observeEarlyScaleOps {W E A P N Out : Type}
    (ops : CartesianScaleOps (AccessEffects W E) A P N Out) :
    CartesianScaleOps
      (AccessEffects (W × List (W × W × EarlyScaleEvent A P N Out E)) E) A P N Out where
  multiply := fun scalar coordinate =>
    observeAccessAction (ops.multiply scalar coordinate) (.multiply scalar coordinate)
  selectedMap := fun scalar _ coordinates =>
    (ops.selectedMap scalar (ops.multiply scalar) coordinates).map fun action =>
      observeAccessAction action (.map scalar coordinates)
  applyIterateOther := fun head tail =>
    observeAccessAction (ops.applyIterateOther head tail) (.splat head tail)
  construct := fun rank mapped => observeAccessAction (ops.construct rank mapped) (.construct rank mapped)
  selectedLeft := fun scalar coordinates =>
    (ops.selectedLeft scalar coordinates).map fun action =>
      observeAccessAction action (.left scalar coordinates)

/-- The empty captured-function case may have selected map dispatch; all
nonempty tuple shapes use the independent positional map protocol. -/
def EarlyScaleMapObservation {W E A P N Out : Type}
    (ops : CartesianScaleOps (AccessEffects W E) A P N Out) (scalar : A) (index : CI)
    (initial final : W) (reply : AccessResult E (Sum (List P) N))
    (records : List (W × W × MapQueryEvent E I64 P N)) : Prop :=
  if index.isEmpty then
    match ops.selectedMap scalar (ops.multiply scalar) index with
    | none => records = [] ∧ final = initial ∧ reply = .ok (.inl [])
    | some _ => records = [(initial, final, .selected index reply)]
  else MapQueryTerminal {
    element := ops.multiply scalar
    selected := ops.selectedMap scalar
    applyIterateOther := ops.applyIterateOther } index initial final reply records

/-- Products are left-multiplications with the original scalar. The whole
mapping result, including a selected non-Tuple, reaches the constructor only
after map succeeds. Rank is the original rank; no derived value is coerced.
This invariant observes call data instead of executing multiplication or
construction to synthesize an expected result. -/
def EarlyScaleTerminal {W E A P N Out : Type}
    (ops : CartesianScaleOps (AccessEffects W E) A P N Out) (scalar : A) (index : CI)
    (initial final : W) (reply : AccessResult E Out)
    (records : List (W × W × EarlyScaleEvent A P N Out E)) : Prop :=
  let events := records.map (fun record => record.2.2)
  let mapped := records.filterMap fun record =>
    (earlyScaleMapEvent record.2.2).map fun event => (record.1, record.2.1, event)
  let constructors := records.filterMap fun record =>
    (earlyScaleConstructEvent record.2.2).map fun call => (record.1, record.2.1, call)
  AccessStateThread initial final records ∧
  (∀ event ∈ events, match event with
    | .multiply actual _ _ | .map actual _ _ => actual = scalar
    | .left _ _ _ => False
    | _ => True) ∧
  (events.map (fun event => match event with | .construct _ _ _ => 1 | _ => 0)) =
    List.replicate mapped.length 0 ++ List.replicate constructors.length 1 ∧
  match constructors with
  | [] => ∃ error, reply = .error error ∧
      EarlyScaleMapObservation ops scalar index initial final (.error error) mapped
  | [(before, after, rank, values, result)] =>
      rank.val = (index.length : Int) ∧ after = final ∧ reply = result ∧
      EarlyScaleMapObservation ops scalar index initial before (.ok values) mapped
  | _ => False

/-- Full constructible-rank, arbitrary Integer subtype and open product/map
result domain. Preserves source order, captured scalar/coordinate argument
order, selected suffix dataflow, constructor rank, arbitrary return, first
error and every state update. Source: base/multidimensional.jl:138. -/
def CartesianScaleLeftObservations : Prop :=
  ∀ (W E A P N Out : Type) (ops : CartesianScaleOps (AccessEffects W E) A P N Out)
    (scalar : A) (index : CI) (world : W), TupleArity index →
    match accessRun (scaleCartesianLeftOpen (observeEarlyScaleOps ops) scalar index) (world, []) with
    | none => True
    | some (reply, (final, records)) => EarlyScaleTerminal ops scalar index world final reply records

/-- Right multiplication calls left multiplication with the scalar first.
A selected override is one atomic call retaining its actual arbitrary return
and state; otherwise the complete map/constructor protocol applies.
Source: base/multidimensional.jl:139. -/
def CartesianScaleRightObservations : Prop :=
  ∀ (W E A P N Out : Type) (ops : CartesianScaleOps (AccessEffects W E) A P N Out)
    (scalar : A) (index : CI) (world : W), TupleArity index →
    match accessRun (scaleCartesianRightOpen (observeEarlyScaleOps ops) index scalar) (world, []) with
    | none => True
    | some (reply, (final, records)) =>
        match ops.selectedLeft scalar index with
        | some _ => records = [(world, final, .left scalar index reply)]
        | none => EarlyScaleTerminal ops scalar index world final reply records

def nativeEarlyScaleOps : CartesianScaleOps Result I64 I64 Empty CI where
  multiply := fun scalar coordinate => .ok (JuliaLean.base.int.mul scalar coordinate)
  applyIterateOther := fun _ impossible => nomatch impossible
  construct := fun rank mapped => match mapped with
    | .inl fields => constructSizedIntegers rank (fields.map (.integer .i64))
    | .inr impossible => nomatch impossible

/-- Native scaling conserves rank and multiplies each original coordinate
modulo 2^64 in both operand orders, including overflowing products and rank
zero. The expected congruence is mathematical and independent of the map or
machine multiplication implementation. Source: base/multidimensional.jl:138-139. -/
def NativeCartesianScaleConservation : Prop :=
  ∀ (scalar : I64) (index : CI), TupleArity index →
    ∃ (output : CI),
      scaleCartesianLeftOpen nativeEarlyScaleOps scalar index = .ok output ∧
      scaleCartesianRightOpen nativeEarlyScaleOps index scalar = .ok output ∧
      output.length = index.length ∧
      ∀ (position : Nat) (original : I64), index[position]? = some original →
        ∃ (returned : I64), output[position]? = some returned ∧
          (returned.val - scalar.val * original.val) % (2 ^ 64 : Int) = 0

inductive EarlyMixedEvent (I V O E : Type) where
  | integerTuple (input : I) (reply : AccessResult E (MixedConstructorValue I V))
  | otherTuple (input : V) (reply : AccessResult E (MixedConstructorValue I V))
  | flatten (input : List (MixedConstructorValue I V)) (reply : AccessResult E (MixedConstructorValue I V))
  | splat (iterator : MixedConstructorValue I V) (arguments : List (MixedConstructorValue I V))
      (reply : AccessResult E (MixedConstructorValue I V))
  | construct (input : MixedConstructorValue I V) (reply : AccessResult E (Sum CI O))
  | varargs (input : List (MixedConstructorArgument I)) (reply : AccessResult E (Sum CI O))

def observeEarlyMixedOps {W E I V O : Type}
    (ops : MixedConstructionOps (AccessEffects W E) I V O) :
    MixedConstructionOps
      (AccessEffects (W × List (W × W × EarlyMixedEvent I V O E)) E) I V O where
  integerTuple := fun value => observeAccessAction (ops.integerTuple value) (.integerTuple value)
  otherTuple := fun value => observeAccessAction (ops.otherTuple value) (.otherTuple value)
  selectedFlatten := fun input => (ops.selectedFlatten input).map fun action =>
    observeAccessAction action (.flatten input)
  applyIterate := fun iterator arguments =>
    observeAccessAction (ops.applyIterate iterator arguments) (.splat iterator arguments)
  coreTuple := ops.coreTuple
  baseIterate := ops.baseIterate
  construct := fun input => observeAccessAction (ops.construct input) (.construct input)
  selectedVarargs := fun input => (ops.selectedVarargs input).map fun action =>
    observeAccessAction action (.varargs input)

def earlyMixedIntegers {I : Type} (input : List (MixedConstructorArgument I)) : List I :=
  input.filterMap fun value => match value with | .integer value => some value | _ => none

def earlyMixedTupleCalls {I V O E : Type} (events : List (EarlyMixedEvent I V O E)) :
    List (I × AccessResult E (MixedConstructorValue I V)) :=
  events.filterMap fun event => match event with
    | .integerTuple value reply => some (value, reply)
    | _ => none

def earlyMixedFlattenCalls {I V O E : Type} (events : List (EarlyMixedEvent I V O E)) :
    List (List (MixedConstructorValue I V) × AccessResult E (MixedConstructorValue I V)) :=
  events.filterMap fun event => match event with
    | .flatten input reply => some (input, reply)
    | _ => none

def earlyMixedSplats {I V O E : Type} (events : List (EarlyMixedEvent I V O E)) :
    List (MixedConstructorValue I V × List (MixedConstructorValue I V) × AccessResult E (MixedConstructorValue I V)) :=
  events.filterMap fun event => match event with
    | .splat iterator arguments reply => some (iterator, arguments, reply)
    | _ => none

def earlyMixedConstructors {I V O E : Type} (events : List (EarlyMixedEvent I V O E)) :
    List (MixedConstructorValue I V × AccessResult E (Sum CI O)) :=
  events.filterMap fun event => match event with
    | .construct value reply => some (value, reply)
    | _ => none

def earlyMixedError {I V O E : Type} : EarlyMixedEvent I V O E → Option (Sum Error E)
  | .integerTuple _ (.error error) | .otherTuple _ (.error error) => some error
  | .flatten _ (.error error) | .splat _ _ (.error error) => some error
  | .construct _ (.error error) | .varargs _ (.error error) => some error
  | _ => none

/-- Successful original-field Tuple replies are related by position. Known
CartesianIndex fields are observed through their immutable native tuple;
Integer replies are the actual dispatched returns, without any value law. -/
def earlyMixedTupleAt {I V O E : Type} (input : List (MixedConstructorArgument I))
    (events : List (EarlyMixedEvent I V O E)) (position : Nat) :
    Option (MixedConstructorValue I V) :=
  match input[position]? with
  | none => none
  | some (.cartesian fields) => some (.tuple (fields.map MixedConstructorValue.native))
  | some (.integer _) =>
      match (earlyMixedTupleCalls events)[(earlyMixedIntegers (input.take position)).length]? with
      | some (_, .ok value) => some value
      | _ => none

/-- The complete native-output relation is positional and makes no call to
a constructor, map, conversion or model. It covers zero rank as well. -/
def EarlyMixedNativeOutput {I V : Type} (value : MixedConstructorValue I V) (output : CI) : Prop :=
  match value with
  | .native field => output = [field]
  | .cartesian fields => output = fields
  | .tuple fields => fields.length = output.length ∧
      ∀ (position : Nat) (field : I64), output[position]? = some field → fields[position]? = some (MixedConstructorValue.native field : MixedConstructorValue I V)
  | _ => False

/-- Final construction conserves native fields directly; other actual result
types make one open constructor call with the precise flatten return. -/
def EarlyMixedFinishObservation {I V O E : Type} (value : MixedConstructorValue I V)
    (constructors : List (MixedConstructorValue I V × AccessResult E (Sum CI O)))
    (reply : AccessResult E (Sum CI O)) : Prop :=
  (∃ output, EarlyMixedNativeOutput value output ∧ constructors = [] ∧ reply = .ok (.inl output)) ∨
  (¬ (∃ output, EarlyMixedNativeOutput value output)) ∧ constructors = [(value, reply)]

/-- Right-to-left splats consume the preceding head's actual Tuple result
and the immediately preceding tail result. The initial tail is either the
last original field or an actual selected suffix result. -/
def EarlyMixedSplatArguments {W E I V O : Type}
    (ops : MixedConstructionOps (AccessEffects W E) I V O)
    (input : List (MixedConstructorArgument I)) (events : List (EarlyMixedEvent I V O E)) : Prop :=
  let selected := earlyMixedFlattenCalls events
  let splats := earlyMixedSplats events
  let depth := match selected with | [(suffix, _)] => input.length - suffix.length | _ => input.length
  ∀ position iterator arguments reply, splats[position]? = some (iterator, arguments, reply) →
    ∃ head tail,
      earlyMixedTupleAt input events (if selected.isEmpty then input.length - 2 - position
        else depth - 1 - position) = some head ∧
      iterator = ops.baseIterate ∧ arguments = [ops.coreTuple, head, tail] ∧
      (if position = 0 then
        if selected.isEmpty then earlyMixedTupleAt input events (input.length - 1) = some tail
        else ∃ suffix, selected = [(suffix, .ok tail)]
       else ∃ previousIterator previousArguments,
         splats[position - 1]? = some (previousIterator, previousArguments, .ok tail))

/-- Reconstruct only the last observed return value, with the empty and
singleton known cases handled positionally. No model operation is rerun. -/
def earlyMixedFlattenReturn {I V O E : Type} (input : List (MixedConstructorArgument I))
    (events : List (EarlyMixedEvent I V O E)) : Option (MixedConstructorValue I V) :=
  match (earlyMixedSplats events).getLast? with
  | some (_, _, .ok value) => some value
  | some (_, _, .error _) => none
  | none => match (earlyMixedFlattenCalls events).getLast? with
      | some (_, .ok value) => some value
      | some (_, .error _) => none
      | none => if input.isEmpty then some (.tuple []) else earlyMixedTupleAt input events 0

/-- Full-domain flatten/construction trace invariant. Integer Tuple calls
form the original prefix; a selected flatten receives an exact original
suffix, and recursive splats unwind afterward. Native fields are conserved;
unknown returned types retain the actual constructor return/error. -/
def EarlyMixedTerminal {W E I V O : Type}
    (ops : MixedConstructionOps (AccessEffects W E) I V O)
    (input : List (MixedConstructorArgument I)) (initial final : W)
    (reply : AccessResult E (Sum CI O)) (records : List (W × W × EarlyMixedEvent I V O E)) : Prop :=
  let events := records.map (fun record => record.2.2)
  let tuples := earlyMixedTupleCalls events
  let selected := earlyMixedFlattenCalls events
  let splats := earlyMixedSplats events
  let constructors := earlyMixedConstructors events
  AccessStateThread initial final records ∧
  (tuples.map Prod.fst).IsPrefix (earlyMixedIntegers input) ∧ selected.length ≤ 1 ∧
  constructors.length ≤ 1 ∧ splats.length ≤ input.length - 1 ∧
  events = (tuples.map fun call => .integerTuple call.1 call.2) ++
    (selected.map fun call => .flatten call.1 call.2) ++
    (splats.map fun call => .splat call.1 call.2.1 call.2.2) ++
    (constructors.map fun call => .construct call.1 call.2) ∧
  (∀ suffix result, selected = [(suffix, result)] →
    ∃ depth, depth < input.length ∧
      suffix = (input.map mixedConstructorInputValue).drop depth ∧
      tuples.map Prod.fst = earlyMixedIntegers (input.take depth)) ∧
  EarlyMixedSplatArguments ops input events ∧
  (∀ event ∈ events, ∀ error, earlyMixedError event = some error →
    events.getLast? = some event ∧ reply = .error error) ∧
  (match reply with
   | .error error => ∃ event, events.getLast? = some event ∧ earlyMixedError event = some error
   | .ok _ =>
       (∀ event ∈ events, earlyMixedError event = none) ∧
       (match selected with
        | [] => tuples.map Prod.fst = earlyMixedIntegers input ∧ splats.length = input.length - 1
        | [(suffix, _)] => splats.length = input.length - suffix.length
        | _ => False) ∧
       ∃ flattened, earlyMixedFlattenReturn input events = some flattened ∧
         EarlyMixedFinishObservation flattened constructors reply) ∧
  (∀ value result, constructors = [(value, result)] →
    earlyMixedFlattenReturn input events = some value ∧
    EarlyMixedFinishObservation value constructors reply)

def EarlyMixedInputBounded {I : Type} (input : List (MixedConstructorArgument I)) : Prop :=
  TupleArity input ∧ ∀ value ∈ input, match value with
    | .cartesian fields => TupleArity fields
    | .integer _ => True

/-- All Integer subtypes and already formed CartesianIndex arguments, custom
Tuple and flatten methods, non-Tuple successful returns, state mutation,
arbitrary errors and divergence. Known Tuple(CartesianIndex) and native
constructor paths remain concrete. Source: base/multidimensional.jl:89. -/
def MixedConstructorObservations : Prop :=
  ∀ (W E I V O : Type) (ops : MixedConstructionOps (AccessEffects W E) I V O)
    (input : List (MixedConstructorArgument I)) (world : W), EarlyMixedInputBounded input →
    match accessRun (constructMixedOpen (observeEarlyMixedOps ops) input) (world, []) with
    | none => True
    | some (reply, (final, records)) => EarlyMixedTerminal ops input world final reply records

/-- Tuple forwarding preserves its exact stored arguments. A selected vararg
method is one call. The default mixed path obeys the flatten invariant; the
all-Integer path forwards the original tuple directly without extra Tuple
calls. Rank zero closes to the concrete empty native constructor.
Source: base/multidimensional.jl:93. -/
def MixedTupleConstructorObservations : Prop :=
  ∀ (W E I V O : Type) (ops : MixedConstructionOps (AccessEffects W E) I V O)
    (input : List (MixedConstructorArgument I)) (world : W), EarlyMixedInputBounded input →
    match accessRun (constructMixedTupleOpen (observeEarlyMixedOps ops) input) (world, []) with
    | none => True
    | some (reply, (final, records)) =>
        let values : List (MixedConstructorValue I V) := input.map mixedConstructorInputValue
        match (if mixedConstructorHasOpen values then ops.selectedVarargs input else none) with
        | some _ => records = [(world, final, .varargs input reply)]
        | none =>
            if input.any (fun value => match value with | .cartesian _ => true | _ => false) then
              EarlyMixedTerminal ops input world final reply records
            else if input.isEmpty then records = [] ∧ final = world ∧ reply = .ok (.inl [])
            else records = [(world, final, .construct (.tuple values) reply)]

/-- Native AbstractArray instantiation closes axes, construction and all
inc/dec recursion. Every representable native axis tuple and original index
of the same rank retains its rank, including empty axes and out-of-bounds
coordinates. Neither nextind nor prevind validates the starting coordinate.
Source: base/multidimensional.jl:159-170,459-486. -/
def NativeNavigationRankConservation : Prop :=
  ∀ (array : Region64) (index : CI), TupleArity array → index.length = array.length →
    (∀ axis ∈ array, RangeDependencies.RangeConstructible axis) →
    ∃ next previous,
      nextCartesianOpen nativeEarlyNavigationOps array index = .ok next ∧
      previousCartesianOpen nativeEarlyNavigationOps array index = .ok previous ∧
      next.length = index.length ∧ previous.length = index.length

theorem nativeNavigationRankConservation_proven :
    Models2Group3.NativeNavigationRankConservation := by
  intro array index harity hlen hconst
  have ha : Models1Group5.RegionDomain array := ⟨harity, hconst⟩
  have haxes := Models1Group5.Batch9.ctor7_axes_run
    Models1Group5.Batch9.scalar7_range_count array ha.2
  have hg := Models1Group5.Batch9.ctor7_axes_geometry
    Models1Group5.Batch9.scalar7_range_count array ha.2
  have hlenAxes : (Models1Group5.Batch9.ctor7_machineAxes array).length = index.length := by
    rw [hg.1, hlen.symm]
  obtain ⟨_, nextRes, hinc, hnextGeo⟩ :=
    Models1Group5.Batch9.nav7_increment index (Models1Group5.Batch9.ctor7_machineAxes array) hlenAxes
  obtain ⟨_, prevRes, hdec, hprevGeo⟩ :=
    Models1Group5.Batch9.nav7_decrement index (Models1Group5.Batch9.ctor7_machineAxes array) hlenAxes
  refine ⟨nextRes, prevRes, ?_, ?_, hnextGeo.1, hprevGeo.1⟩
  · unfold Models2Group3.nextCartesianOpen Models2Group3.nativeEarlyNavigationOps
      Models1Group5.regionFromRanges Models1Group5.incrementIndexStored cartesianToTuple
    dsimp only
    rw [haxes]
    simp only [List.map_id_fun, id_eq, Bind.bind, Except.bind, Pure.pure, Except.pure]
    rw [hinc]
  · unfold Models2Group3.previousCartesianOpen Models2Group3.nativeEarlyNavigationOps
      Models1Group5.regionFromRanges Models1Group5.decrementIndexStored cartesianToTuple
    dsimp only
    rw [haxes]
    simp only [List.map_id_fun, id_eq, Bind.bind, Except.bind, Pure.pure, Except.pure]
    rw [hdec]

