    rangeCardinality (.oneTo ⟨stop⟩) = stop.val.toNat := by
  unfold rangeCardinality
  simp only [rangeIsEmpty, scalar7_ltSame, mix7_oneTo_first, mix7_oneTo_step,
    rangeLast, int_one, decide_eq_true_eq, Int.ediv_one]
  split <;> omega

 theorem mix7_size_outcome (size : JuliaLean.base.tuple.Index) :
    match convertPreparedDimension (.size (integerDimension size)) with
    | .ok result =>
        max 0 size.value ≤ IntTy.max .i64 ∧ RangeConstructible result ∧
          MixedDimensionGeometry (.size size) result
    | .error (.jl (.inexactError _)) => ¬max 0 size.value ≤ IntTy.max .i64
    | .error _ => False := by
  simp only [convertPreparedDimension, dimensionToIntRange]
  rw [mix7_integerDimension_value]
  have hnonneg : 0 ≤ max 0 size.value := Int.le_max_left _ _
  have hmin : IntTy.min .i64 ≤ max 0 size.value := by
    change -9223372036854775808 ≤ max 0 size.value
    omega
  by_cases hfit : max 0 size.value ≤ IntTy.max .i64
  · have hbound : IntTy.min .i64 ≤ max 0 size.value ∧
        max 0 size.value ≤ IntTy.max .i64 := ⟨hmin, hfit⟩
    have hc : JInt.convert "Int64" .i64 (max 0 size.value) =
        .ok ⟨max 0 size.value, hbound⟩ := by
      unfold JInt.convert
      rw [dif_pos hbound]
    rw [hc]
    change (match rangeOneTo ⟨max 0 size.value, hbound⟩ with
      | .ok result => max 0 size.value ≤ IntTy.max .i64 ∧ RangeConstructible result ∧
          MixedDimensionGeometry (.size size) result
      | .error (.jl (.inexactError _)) => ¬max 0 size.value ≤ IntTy.max .i64
      | .error _ => False)
    rw [mix7_oneTo_nonneg _ hnonneg]
    refine ⟨hfit, True.intro, ⟨⟨⟨max 0 size.value, hbound⟩, rfl, rfl⟩, ?_⟩⟩
    exact mix7_oneTo_cardinality _ hnonneg
  · have hn : ¬ (IntTy.min .i64 ≤ max 0 size.value ∧
        max 0 size.value ≤ IntTy.max .i64) := by
      intro hb
