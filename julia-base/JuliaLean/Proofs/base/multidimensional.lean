   | .ok value =>
       (∃ event, events.getLast? = some event ∧ parentEarlyReply event = some (.bool false) ∧ value = .bool false) ∨
       (events.length = 9 ∧
         ((∃ left right, events.getLast? = some (.equalSize left right (.ok value))) ∨
          (∃ left right, events.getLast? = some (.equalStrides left right (.ok value)))))
   | .error error =>
       ∃ event, events.getLast? = some event ∧
         (parentEventError event = some error ∨
