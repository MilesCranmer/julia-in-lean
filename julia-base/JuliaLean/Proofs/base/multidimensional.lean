/-- Independent call-stage, argument, return/error and state protocol. This
reads actual observations; it does not execute a model or assume callee laws. -/
def EarlySequenceObservation {E W Event Out : Type}
    (expected : List Nat) (phase : Event → Nat) (error : Event → Option E)
    (returned : Event → Option (Except E Out)) (coherent : List Event → Prop)
    (initial : W) (outcome : Option (Except E Out × (W × List (W × W × Event)))) : Prop :=
  match outcome with
  | none => True
  | some (result, (final, records)) =>
      let events := records.map (fun record => record.2.2)
      DimensionStateThread initial final records ∧ coherent events ∧
      (events.map phase).IsPrefix expected ∧
      (∀ position event, events[position]? = some event → ∀ exception,
        error event = some exception → position + 1 = events.length ∧ result = .error exception) ∧
      match result with
      | .ok value => events.map phase = expected ∧
          ∃ event, events.getLast? = some event ∧ returned event = some (.ok value)
      | .error exception =>
          ∃ event, events.getLast? = some event ∧ error event = some exception


theorem earlySequence_two {E W Event A Out : Type}
    (phase : Event → Nat) (error : Event → Option E)
    (returned : Event → Option (Except E Out)) (coherent : List Event → Prop)
