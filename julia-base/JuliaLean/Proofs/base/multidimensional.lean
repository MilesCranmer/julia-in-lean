def runRegionConversion {m : Type → Type} [Monad m]
    [MonadExceptOf JuliaLean.base.range.Exc m] {C O T : Type}
    (entry : RegionConversionEntry) (ops : RegionConversionOps m C O T)
    (fields : List (RegionConversionField C)) : m (RegionConvertedTuple C O T) :=
  match entry with
  | .generated target => regionConvertGenerated ops target fields
  | .abstractUnit => JuliaLean.base.multidimensional.Models2Group3.regionConvertAbstractUnit ops fields
  | .varargAbstractUnitInt => JuliaLean.base.multidimensional.Models2Group3.regionConvertVarargAbstractUnitInt ops fields
  | .varargAbstractUnit => JuliaLean.base.multidimensional.Models2Group3.regionConvertVarargAbstractUnit ops fields

/-- Mathematical/native subtype specification, independent of tuple map and
of all installed conversion/normalization implementations. Raw stored values,
including unchecked OneTo stops and all machine extrema, are included. -/
def RegionNativeConverted {C O : Type} (target : RegionConversionKind)
    (input : RegionConversionNative) (output : RegionConvertedValue C O) : Prop :=
  match target with
  | .ordinal => output = .inl (.inl input)
  | .abstractUnit =>
      match input with
      | .oneTo _ | .unit _ => output = .inl (.inl input)
      | .stepped _ => False
  | .stepped =>
      ∃ result : JuliaLean.base.range.StepRange I64 I64,
        output = .inl (.inl (.stepped result)) ∧
        match input with
        | .stepped original => result = original
        | .oneTo original =>
            result.start.val = 1 ∧ result.step.val = 1 ∧
              result.stop.val = max 0 original.stop.val
        | .unit original =>
            result.start = original.start ∧ result.step.val = 1 ∧
              result.stop.val = max original.stop.val (original.start.val - 1)

abbrev RegionConversionM (E S : Type) :=
  ExceptT (Sum JuliaLean.base.range.Exc E) (StateT S Option)

local instance regionConversionObservationError {E S : Type} :
    MonadExceptOf JuliaLean.base.range.Exc (RegionConversionM E S) where
  throw error := ExceptT.mk fun state => some (.error (.inl error), state)
  tryCatch action handler := ExceptT.mk fun state =>
    match action.run state with
    | none => none
    | some (.ok value, state') => some (.ok value, state')
    | some (.error (.inl error), state') => (handler error).run state'
    | some (.error (.inr error), state') => some (.error (.inr error), state')

inductive RegionConversionEvent (E C O T : Type) where
  | convert (target : RegionConversionKind) (field : C)
      (result : Except (Sum JuliaLean.base.range.Exc E) (RegionConvertedValue C O))
  | map (target : RegionConversionKind) (fields : List (RegionConversionField C))
      (result : Except (Sum JuliaLean.base.range.Exc E) (RegionConvertedTuple C O T))
  | splat (head : RegionConvertedValue C O) (tail : T)
      (result : Except (Sum JuliaLean.base.range.Exc E) (List (RegionConvertedValue C O)))
  | forward (target : RegionConversionTarget) (fields : List (RegionConversionField C))
      (result : Except (Sum JuliaLean.base.range.Exc E) (RegionConvertedTuple C O T))

abbrev RegionConversionRecord (E S C O T : Type) :=
  S × S × RegionConversionEvent E C O T

def observeRegionConversionAction {E S Event A : Type}
    (action : RegionConversionM E S A)
    (event : Except (Sum JuliaLean.base.range.Exc E) A → Event) :
    RegionConversionM E (S × List (S × S × Event)) A :=
  ExceptT.mk fun (state, events) =>
    match action.run state with
    | none => none
    | some (result, state') =>
        some (result, (state', events ++ [(state, state', event result)]))

/-- A selected map is observed atomically, including its calls to the actual
original conversion function. Projecting its audited function back to that
original function leaves the arbitrary state/effects unchanged. -/
def observeRegionConversionOps {E S C O T : Type}
    (ops : RegionConversionOps (RegionConversionM E S) C O T) :
    RegionConversionOps
      (RegionConversionM E (S × List (RegionConversionRecord E S C O T))) C O T where
  customConvert := fun target field =>
    observeRegionConversionAction (ops.customConvert target field) (.convert target field)
  selectedMap := fun target _ fields =>
    (ops.selectedMap target (regionConvertField ops target) fields).map fun action =>
      observeRegionConversionAction action (.map target fields)
  applyIterateOther := fun head tail =>
    observeRegionConversionAction (ops.applyIterateOther head tail) (.splat head tail)
  selectedConvert := fun target fields => (ops.selectedConvert target fields).map fun action =>
    observeRegionConversionAction action (.forward target fields)

def regionConversionEventError {E C O T : Type} :
    RegionConversionEvent E C O T → Option (Sum JuliaLean.base.range.Exc E)
  | .convert _ _ (.error error) | .map _ _ (.error error)
  | .splat _ _ (.error error) | .forward _ _ (.error error) => some error
  | _ => none

def regionConversionCustomFields {C : Type} (fields : List (RegionConversionField C)) : List C :=
  fields.filterMap fun field => match field with
    | .inl _ => none
    | .inr custom => some custom

def regionConversionCalls {E C O T : Type} (events : List (RegionConversionEvent E C O T)) :=
  events.filterMap fun event => match event with
    | .convert target field result => some (target, field, result)
    | _ => none

def regionConversionMaps {E C O T : Type} (events : List (RegionConversionEvent E C O T)) :=
  events.filterMap fun event => match event with
    | .map target fields result => some (target, fields, result)
    | _ => none

def regionConversionForwards {E C O T : Type} (events : List (RegionConversionEvent E C O T)) :=
  events.filterMap fun event => match event with
    | .forward target fields result => some (target, fields, result)
    | _ => none

def RegionConversionStateThread {S Event : Type} (initial final : S)
    (records : List (S × S × Event)) : Prop :=
  (records = [] → final = initial) ∧
  (∀ record, records[0]? = some record → record.1 = initial) ∧
  (∀ i left right, records[i]? = some left → records[i + 1]? = some right →
    left.2.1 = right.1) ∧
  (∀ record, records.getLast? = some record → record.2.1 = final)

/-- The only legal nested conversion targets, expressed independently from
the forwarding functions and with mathematical tuple arity. -/
def RegionConversionForwardTarget (entry : RegionConversionEntry) (rank : Nat)
    (target : RegionConversionTarget) : Prop :=
  match entry, target with
  | .generated _, _ => False
  | .abstractUnit, .fixed actual .abstractUnit
  | .varargAbstractUnitInt, .fixed actual .abstractUnit
  | .varargAbstractUnit, .fixed actual .abstractUnit => actual.val = (rank : Int)
  | .varargAbstractUnit, .varargAbstractUnitInt => True
  | _, _ => False

/-- Source-order prefix and argument invariants. Selected map/convert are
atomic calls, and no laws or purity assumptions are imposed on them. -/
def RegionConversionCallOrder {E C O T : Type} (entry : RegionConversionEntry)
    (fields : List (RegionConversionField C))
    (events : List (RegionConversionEvent E C O T)) : Prop :=
  (∃ rest, regionConversionCustomFields fields =
    (regionConversionCalls events).map (fun call => call.2.1) ++ rest) ∧
  (regionConversionMaps events).length ≤ 1 ∧
  (regionConversionForwards events).length ≤ 1 ∧
  (∀ (i : Nat) (event : RegionConversionEvent E C O T), events[i]? = some event → match event with
    | .convert target _ _ =>
        target = regionConversionEntryKind entry ∧
        ∀ j earlier, j < i → events[j]? = some earlier →
          ∃ t c r, earlier = .convert t c r
    | .map target actual _ =>
        target = regionConversionEntryKind entry ∧ actual ≠ [] ∧
        regionConversionHasCustom actual = true ∧
        (∃ initialPart, fields = initialPart ++ actual) ∧
        (actual = fields ∨ (fields.length < 32 ∧ 3 ≤ actual.length)) ∧
        ∀ j earlier, j < i → events[j]? = some earlier →
          ∃ t c r, earlier = .convert t c r
    | .splat _ tail _ =>
        i + 1 = events.length ∧
        ∃ target actual, events[i - 1]? = some (.map target actual (.ok (.inr tail))) ∧
          actual ≠ fields
    | .forward target actual _ =>
        actual = fields ∧ regionConversionHasCustom fields = true ∧
        RegionConversionForwardTarget entry fields.length target ∧ events = [event])

/-- Pointwise conservation of a completed ordinary prefix. Native values
satisfy the mathematical target specification; custom values match the
actual call at their original ordinal position among custom fields. -/
def RegionConversionPrefix {E C O T : Type} (target : RegionConversionKind)
    (fields : List (RegionConversionField C))
    (events : List (RegionConversionEvent E C O T))
    (output : List (RegionConvertedValue C O)) : Prop :=
  output.length ≤ fields.length ∧
  ∀ (i : Nat) (input : RegionConversionField C) (value : RegionConvertedValue C O), fields[i]? = some input → output[i]? = some value →
    match input with
    | .inl native => RegionNativeConverted target native value
    | .inr custom =>
        (regionConversionCalls events)[(regionConversionCustomFields (fields.take i)).length]? =
          some (target, custom, .ok value)

/-- A successful map keeps its completed ordinary prefix and every selected
suffix result verbatim. The splat boundary is observed at its real call;
its arbitrary result remains the tail of the final tuple. -/
def RegionConversionReturn {E C O T : Type} (entry : RegionConversionEntry)
    (fields : List (RegionConversionField C))
    (events : List (RegionConversionEvent E C O T))
    (output : RegionConvertedTuple C O T) : Prop :=
  match regionConversionForwards events with
  | [(_, _, result)] => result = .ok output
  | [] =>
      match regionConversionMaps events with
      | [] => ∃ values, output = .inl values ∧ values.length = fields.length ∧
          RegionConversionPrefix (regionConversionEntryKind entry) fields events values
      | [(_, actual, .ok (.inl tail))] =>
          ∃ initialPart, output = .inl (initialPart ++ tail) ∧
            initialPart.length + actual.length = fields.length ∧
            RegionConversionPrefix (regionConversionEntryKind entry) fields events initialPart
      | [(_, actual, .ok (.inr tail))] =>
          (actual = fields → output = .inr tail) ∧
          (actual ≠ fields → ∃ initialPart head splatted,
            .splat head tail (.ok splatted) ∈ events ∧ output = .inl (initialPart ++ splatted) ∧
            initialPart.length + 1 + actual.length = fields.length ∧
            RegionConversionPrefix (regionConversionEntryKind entry) fields events (initialPart ++ [head]))
      | _ => False
  | _ => False

/-- Full-domain observational contract for all four public entries and all
three generated targets. It covers machine-sized arities, every custom
operation, arbitrary thrown values, aliasing and state mutation, arbitrary
non-Tuple or ill-typed returns, short and long tuple paths, and divergence.
The statement conserves independently observed values and input positions;
it does not supply a correctness law or rerun the map algorithm as an oracle.
Source: base/multidimensional.jl:359-364,369-372; base/tuple.jl:358-401. -/
def RegionConversionObservations : Prop :=
  ∀ (E S C O T : Type) (entry : RegionConversionEntry)
    (ops : RegionConversionOps (RegionConversionM E S) C O T)
    (fields : List (RegionConversionField C)) (initial : S),
    (fields.length : Int) ≤ IntTy.max .i64 →
    let observed := (runRegionConversion entry (observeRegionConversionOps ops) fields).run (initial, [])
    (observed.map fun (result, (state, _)) => (result, state)) =
      (runRegionConversion entry ops fields).run initial ∧
    match observed with
    | none => True
    | some (result, (final, records)) =>
        let events := records.map fun record => record.2.2
        RegionConversionStateThread initial final records ∧
        RegionConversionCallOrder entry fields events ∧
        (∀ i event error, events[i]? = some event →
          regionConversionEventError event = some error →
          i + 1 = events.length ∧ result = .error error) ∧
        (match result with
          | .error _ => True
          | .ok output => RegionConversionReturn entry fields events output)

def nativeRegionConversionOps :
    RegionConversionOps JuliaLean.base.range.JlX Empty Empty Empty where
  customConvert := fun _ impossible => nomatch impossible
  applyIterateOther := fun _ impossible => nomatch impossible

def RegionForall2 {α β : Type} (relation : α → β → Prop) (left : List α) (right : List β) : Prop :=
  left.length = right.length ∧ ∀ pair ∈ left.zip right, relation pair.1 pair.2

/-- Native conversions always retain tuple arity and positional values.
Ordinal targets preserve exact fields; AbstractUnitRange targets reject
StepRange even at step 1; StepRange targets preserve existing steps and
normalize unit emptiness mathematically. Every native stored value is
included, without a no-overflow, positive-length, or range-validity premise.
All forwarding methods are covered by this same independent specification.
Source: base/multidimensional.jl:359-364,369-372; base/range.jl:288,1354-1373. -/
def RegionConversionNativeCorrect : Prop :=
  ∀ (entry : RegionConversionEntry) (fields : List RegionConversionNative),
    (fields.length : Int) ≤ IntTy.max .i64 →
    match runRegionConversion entry nativeRegionConversionOps (fields.map Sum.inl) with
    | .ok (.inl output) =>
        RegionForall2 (RegionNativeConverted (regionConversionEntryKind entry)) fields output
    | .ok (.inr impossible) => nomatch impossible
    | .error error =>
        regionConversionEntryKind entry = .abstractUnit ∧
        error = .jl (.methodError "AbstractUnitRange{Int64}") ∧
        ∃ stepped, (.stepped stepped : RegionConversionNative) ∈ fields

/-- Rank zero is closed by the concrete empty tuple method, even when every
supplied selected operation would throw or diverge. No user callee can be
reached and arbitrary state is preserved. Source: base/multidimensional.jl:358-372;
base/tuple.jl:358. -/
def RegionConversionEmptyCorrect : Prop :=
  ∀ (E S C O T : Type) (entry : RegionConversionEntry)
    (ops : RegionConversionOps (RegionConversionM E S) C O T) (state : S),
    (runRegionConversion entry (observeRegionConversionOps ops) []).run (state, []) =
      some (.ok (.inl []), (state, []))

theorem RegionConversionEmptyCorrect_proven : RegionConversionEmptyCorrect := by
  intro E S C O T entry ops state
  cases entry <;>
    simp only [runRegionConversion,
      JuliaLean.base.multidimensional.Models2Group3.regionConvertAbstractUnit,
      JuliaLean.base.multidimensional.Models2Group3.regionConvertVarargAbstractUnitInt,
      JuliaLean.base.multidimensional.Models2Group3.regionConvertVarargAbstractUnit,
      JuliaLean.base.multidimensional.Models2Group3.regionConvertFixedCall,
      JuliaLean.base.multidimensional.Models2Group3.regionConversionHasCustom,
      List.any_nil, Bool.false_eq_true, ↓reduceIte,
      JuliaLean.base.multidimensional.Models2Group3.regionConvertGenerated] <;>
    rw [JuliaLean.base.multidimensional.Models2Group3.tupleMapDispatch] <;>
    rfl

/-- Test instantiation whose selected map invokes its received function on
an arbitrary custom reference, including one absent from the input tuple.
It is a dispatch environment, not an implementation or a correctness law. -/
def probingRegionConversionOps {E S C O T : Type} (probe : C)
    (reply : RegionConversionKind → C → S →
      Option (Except (Sum JuliaLean.base.range.Exc E) (RegionConvertedValue C O) × S)) :
    RegionConversionOps (RegionConversionM E S) C O T where
  customConvert := fun target field => ExceptT.mk (reply target field)
  selectedMap := fun _ f _ => some do
    let value ← f (.inr probe)
    return .inl [value]
  applyIterateOther := fun _ _ => pure []

/-- A selected map receives the actual generated function with its target
captured correctly. The chosen arbitrary reference is converted exactly as
requested; arbitrary results, errors, state changes, and nontermination are
retained. This detects a fake/unrelated function supplied to selected map,
or an invented result range/length assertion. Source: base/multidimensional.jl:359-372. -/
def RegionConversionSelectedFunctionCorrect : Prop :=
  ∀ (E S C O T : Type) (entry : RegionConversionEntry) (probe : C)
    (reply : RegionConversionKind → C → S →
      Option (Except (Sum JuliaLean.base.range.Exc E) (RegionConvertedValue C O) × S))
    (fields : List (RegionConversionField C)) (state : S),
    (fields.length : Int) ≤ IntTy.max .i64 →
    regionConversionHasCustom fields = true →
    (runRegionConversion entry (probingRegionConversionOps (T := T) probe reply) fields).run state =
      (reply (regionConversionEntryKind entry) probe state).map fun (result, final) =>
        (result.map (fun value => Sum.inl [value]), final)

theorem regionConversionSelectedFunctionCorrect_proven :
    Models2Group3.RegionConversionSelectedFunctionCorrect := by
  intro E S C O T entry probe reply fields state _ hcustom
  have hne : fields.isEmpty = false := by
    cases fields with
    | nil => cases hcustom
    | cons _ _ => rfl
  cases entry <;>
    simp only [Models2Group3.runRegionConversion,
      Models2Group3.regionConversionEntryKind,
      JuliaLean.base.multidimensional.Models2Group3.regionConvertAbstractUnit,
      JuliaLean.base.multidimensional.Models2Group3.regionConvertVarargAbstractUnitInt,
      JuliaLean.base.multidimensional.Models2Group3.regionConvertVarargAbstractUnit,
      JuliaLean.base.multidimensional.Models2Group3.regionConvertFixedCall,
      JuliaLean.base.multidimensional.Models2Group3.regionConvertGenerated,
      Models2Group3.probingRegionConversionOps, hcustom, ↓reduceIte] <;>
    rw [JuliaLean.base.multidimensional.Models2Group3.tupleMapDispatch.eq_def] <;>
    simp only [hne, hcustom, Bool.false_eq_true, ↓reduceIte,
      JuliaLean.base.multidimensional.Models2Group3.regionConvertField,
      ExceptT.run, ExceptT.mk, Bind.bind, ExceptT.bind, ExceptT.bindCont,
      StateT.bind, Option.bind, Pure.pure, ExceptT.pure, StateT.pure, Option.map] <;>
    (cases reply _ probe state with
     | none => rfl
     | some p => rcases p with ⟨res, s'⟩; cases res <;> rfl)


inductive RegionUnitEntry where
  | int | unparameterized | varargInt | vararg

def regionUnitEntryTarget : RegionUnitEntry → RegionUnitTarget
  | .unparameterized => .unparameterized
  | _ => .int

def runRegionUnitConversion {m : Type → Type} [Monad m]
    [MonadExceptOf JuliaLean.base.range.Exc m] {C O T BC : Type}
    (entry : RegionUnitEntry) (ops : RegionUnitConversionOps m C O T BC)
    (fields : List (RegionConversionField C)) : m (RegionConvertedTuple C O T) :=
  match entry with
  | .int => JuliaLean.base.multidimensional.Models2Group3.regionConvertUnitInt ops fields
  | .unparameterized => JuliaLean.base.multidimensional.Models2Group3.regionConvertUnit ops fields
  | .varargInt => JuliaLean.base.multidimensional.Models2Group3.regionConvertVarargUnitInt ops fields
  | .vararg => JuliaLean.base.multidimensional.Models2Group3.regionConvertVarargUnit ops fields

inductive RegionUnitEvent (E C O T BC : Type) where
  | base (event : RegionConversionEvent E C O T)
  | broadcasted (target : RegionUnitTarget) (argument : RegionConvertedTuple C O T)
      (result : Except (Sum JuliaLean.base.range.Exc E) (RegionUnitBroadcast BC))
  | materialize (value : BC)
      (result : Except (Sum JuliaLean.base.range.Exc E) (RegionConvertedTuple C O T))

def observeRegionUnitOps {E S C O T BC : Type}
    (ops : RegionUnitConversionOps (RegionConversionM E S) C O T BC) :
    RegionUnitConversionOps
      (RegionConversionM E (S × List (S × S × RegionUnitEvent E C O T BC))) C O T BC where
  customConvert := fun target field =>
    observeRegionConversionAction (ops.customConvert target field) (fun r => .base (.convert target field r))
  selectedMap := fun target _ fields =>
    (ops.selectedMap target (regionConvertField ops.toRegionConversionOps target) fields).map fun action =>
      observeRegionConversionAction action (fun r => .base (.map target fields r))
  applyIterateOther := fun head tail =>
    observeRegionConversionAction (ops.applyIterateOther head tail) (fun r => .base (.splat head tail r))
  selectedConvert := fun target fields => (ops.selectedConvert target fields).map fun action =>
    observeRegionConversionAction action (fun r => .base (.forward target fields r))
  broadcasted := fun target argument =>
    observeRegionConversionAction (ops.broadcasted target argument) (.broadcasted target argument)
  materialize := fun value => observeRegionConversionAction (ops.materialize value) (.materialize value)

def regionUnitEventError {E C O T BC : Type} :
    RegionUnitEvent E C O T BC → Option (Sum JuliaLean.base.range.Exc E)
  | .base event => regionConversionEventError event
  | .broadcasted _ _ (.error error) | .materialize _ (.error error) => some error
  | _ => none

def RegionUnitForwardTarget (entry : RegionUnitEntry) (rank : Nat)
    (target : RegionConversionTarget) : Prop :=
  match target with
  | .fixedAbstractUnit actual | .fixed actual .abstractUnit => actual.val = (rank : Int)
  | .fixedUnitInt actual =>
      (entry = .varargInt ∨ entry = .vararg) ∧ actual.val = (rank : Int)
  | .varargUnitInt => entry = .vararg
  | _ => False

def regionUnitRootForward : RegionConversionTarget → Bool
  | .fixedUnitInt _ | .varargUnitInt => true
  | _ => false

/-- UnitRange's two constructor targets differ on an existing UnitRange:
the Int target preserves the object, while the unparameterized constructor
normalizes empty stops. This is a mathematical endpoint specification. -/
def RegionNativeUnitConverted {C O : Type} (target : RegionUnitTarget)
    (input : RegionConversionNative) (output : RegionConvertedValue C O) : Prop :=
  ∃ result : JuliaLean.base.range.UnitRange I64,
    output = .inl (.inl (.unit result)) ∧
    match input with
    | .stepped _ => False
    | .oneTo original => result.start.val = 1 ∧ result.stop.val = max 0 original.stop.val
    | .unit original =>
        match target with
        | .int => result = original
        | .unparameterized =>
            result.start = original.start ∧
              result.stop.val = max original.stop.val (original.start.val - 1)

/-- All effects before broadcasting are conversion effects; every lowered
materialize receives the exact broadcasted return, and final custom results
are preserved without a tuple or element assertion. Selected root forwarding
returns before broadcasting. Native descriptor outputs obey independent
endpoint mathematics. All callable operations and thrown values are arbitrary.
Source: base/multidimensional.jl:365-368,373-376; base/broadcast.jl:921-922. -/
def RegionUnitConversionObservations : Prop :=
  ∀ (E S C O T BC : Type) (entry : RegionUnitEntry)
    (ops : RegionUnitConversionOps (RegionConversionM E S) C O T BC)
    (fields : List (RegionConversionField C)) (initial : S),
    (fields.length : Int) ≤ IntTy.max .i64 →
    let observed := (runRegionUnitConversion entry (observeRegionUnitOps ops) fields).run (initial, [])
    (observed.map fun (result, (state, _)) => (result, state)) =
      (runRegionUnitConversion entry ops fields).run initial ∧
    match observed with
    | none => True
    | some (result, (final, records)) =>
        let events := records.map fun record => record.2.2
        let ordinary := events.filterMap fun event => match event with
          | .base (.forward _ _ _) => none
          | .base event => some event
          | _ => none
        RegionConversionStateThread initial final records ∧
        RegionConversionCallOrder (.generated .abstractUnit) fields ordinary ∧
        (∀ i event error, events[i]? = some event → regionUnitEventError event = some error →
          i + 1 = events.length ∧ result = .error error) ∧
        (∀ (i : Nat) (event : RegionUnitEvent E C O T BC), events[i]? = some event → match event with
          | .base (.forward target actual reply) =>
              actual = fields ∧ regionConversionHasCustom fields = true ∧
              RegionUnitForwardTarget entry fields.length target ∧
              (regionUnitRootForward target = true → events = [event] ∧ result = reply) ∧
              ∀ j earlier, j < i → events[j]? = some earlier → False
          | .base _ => ∀ j earlier, j < i → events[j]? = some earlier →
              ∃ base, earlier = .base base
          | .broadcasted target argument reply =>
              target = regionUnitEntryTarget entry ∧ regionConvertedNative argument = none ∧
              (∀ j earlier, j < i → events[j]? = some earlier → ∃ base, earlier = .base base) ∧
              (∀ convertedTarget convertedReply,
                .base (.forward convertedTarget fields convertedReply) ∈ events →
                convertedReply = .ok argument) ∧
              (∀ bc, reply = .ok (.other bc) →
                ∀ output, result = .ok output → .materialize bc (.ok output) ∈ events) ∧
              (∀ nativeTarget nativeFields output,
                reply = .ok (.native nativeTarget nativeFields) → result = .ok output →
                ∃ values, output = .inl values ∧
                  RegionForall2 (RegionNativeUnitConverted nativeTarget) nativeFields values)
          | .materialize value reply =>
              i + 1 = events.length ∧ result = reply ∧
              ∃ target argument,
                events[i - 1]? = some (.broadcasted target argument (.ok (.other value))))

def regionNativeValue (value : RegionConvertedValue Empty Empty) : RegionConversionNative :=
  match value with
  | .inl (.inl native) => native
  | .inl (.inr impossible) | .inr impossible => nomatch impossible

def nativeRegionUnitOps :
    RegionUnitConversionOps JuliaLean.base.range.JlX Empty Empty Empty Empty where
  toRegionConversionOps := nativeRegionConversionOps
  broadcasted := fun target argument => match argument with
    | .inl values => pure (.native target (values.map regionNativeValue))
    | .inr impossible => nomatch impossible
  materialize := fun impossible => nomatch impossible

/-- Complete native result/error contract for all four UnitRange entries.
The whole AbstractUnitRange conversion precedes constructors, so any stored
StepRange causes its AbstractUnitRange MethodError even when earlier fields
could have been broadcast. Every machine-sized tuple and raw stored endpoint
is included. Source: base/multidimensional.jl:365-368,373-376. -/
def RegionUnitConversionNativeCorrect : Prop :=
  ∀ (entry : RegionUnitEntry) (fields : List RegionConversionNative),
    (fields.length : Int) ≤ IntTy.max .i64 →
    match runRegionUnitConversion entry nativeRegionUnitOps (fields.map Sum.inl) with
    | .ok (.inl output) =>
        RegionForall2 (RegionNativeUnitConverted (regionUnitEntryTarget entry)) fields output
    | .ok (.inr impossible) => nomatch impossible
    | .error error =>
        error = .jl (.methodError "AbstractUnitRange{Int64}") ∧
        ∃ stepped, (.stepped stepped : RegionConversionNative) ∈ fields

abbrev RegionConcreteM (E S : Type) := ExceptT (Sum Error E) (StateT S Option)

local instance regionConcreteObservationError {E S : Type} :
    MonadExceptOf Error (RegionConcreteM E S) where
  throw error := ExceptT.mk fun state => some (.error (.inl error), state)
  tryCatch action handler := ExceptT.mk fun state =>
    match action.run state with
    | none => none
    | some (.ok value, state') => some (.ok value, state')
    | some (.error (.inl error), state') => (handler error).run state'
    | some (.error (.inr error), state') => some (.error (.inr error), state')

inductive RegionConcreteEvent (E Tag C Converted Value Other : Type) where
  | convert (target : Tag) (fields : List (RegionConversionField C))
      (result : Except (Sum Error E) Converted)
  | construct (converted : Converted)
      (result : Except (Sum Error E) (RegionConstructedValue Tag Value Other))

def observeRegionConcreteAction {E S Event A : Type}
    (action : RegionConcreteM E S A) (event : Except (Sum Error E) A → Event) :
    RegionConcreteM E (S × List (S × S × Event)) A :=
  ExceptT.mk fun (state, events) =>
    match action.run state with
    | none => none
    | some (result, state') =>
        some (result, (state', events ++ [(state, state', event result)]))

def observeRegionConcreteOps {E S Tag C Converted Value Other : Type}
    (ops : RegionConcreteConversionOps (RegionConcreteM E S) Tag C Converted Value Other) :
    RegionConcreteConversionOps
      (RegionConcreteM E (S × List (S × S × RegionConcreteEvent E Tag C Converted Value Other)))
      Tag C Converted Value Other where
  convertTuple := fun target fields =>
    observeRegionConcreteAction (ops.convertTuple target fields) (.convert target fields)
  construct := fun converted =>
    observeRegionConcreteAction (ops.construct converted) (.construct converted)

/-- The final assertion uses exact invariant tuple-type identity and the
mathematical source rank. It runs after conversion and construction, retaining
their mutation even when the constructed value has a wrong type or rank.
Every selected return/error/divergence is quantified, including constructors
returning a non-region. Source: base/multidimensional.jl:378-379;
doc/src/manual/types.md:703-721 (invariance). -/
def RegionConcreteConversionObservations : Prop :=
  ∀ (E S Tag C Converted Value Other : Type) (inst : DecidableEq Tag),
    letI := inst
    ∀ (ops : RegionConcreteConversionOps (RegionConcreteM E S) Tag C Converted Value Other)
      (target : Tag) (fields : List (RegionConversionField C)) (initial : S),
      (fields.length : Int) ≤ IntTy.max .i64 →
      let observed :=
        (JuliaLean.base.multidimensional.Models2Group3.regionConvertConcrete
          (observeRegionConcreteOps ops) target fields).run (initial, [])
      (observed.map fun (result, (state, _)) => (result, state)) =
        (JuliaLean.base.multidimensional.Models2Group3.regionConvertConcrete ops target fields).run initial ∧
      match observed with
      | none => True
      | some (result, (final, records)) =>
          RegionConversionStateThread initial final records ∧
          match (records.map (fun record => record.2.2) : List (RegionConcreteEvent E Tag C Converted Value Other)) with
          | [.convert actual original (.error error)] =>
              actual = target ∧ original = fields ∧ result = .error error
          | [.convert actual original (.ok converted), .construct argument reply] =>
              actual = target ∧ original = fields ∧ argument = converted ∧
              match reply with
              | .error error => result = .error error
              | .ok (.other _) => result = .error (.inl .typeError)
              | .ok (.region rank fieldType value) =>
                  ((rank.val = (fields.length : Int) ∧ fieldType = target) → result = .ok value) ∧
                  ((rank.val ≠ (fields.length : Int) ∨ fieldType ≠ target) →
                    result = .error (.inl .typeError))
          | _ => False

