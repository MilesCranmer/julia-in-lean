/-!
Independent contracts for required native LogicalIndex collection
iteration transitions. Pending is an explicit continuation, never a Julia return;
these are partial dependencies for assigned844/845 through843.
-/

namespace NativeLogicalIteration

abbrev LinearRange :=
  JuliaLean.base.multidimensional.Models1Group6.NativeLogicalIteration.LinearRange
abbrev EntryState :=
  JuliaLean.base.multidimensional.Models1Group6.NativeLogicalIteration.EntryState
abbrev StoredState :=
  JuliaLean.base.multidimensional.Models1Group6.NativeLogicalIteration.StoredState
abbrev Progress :=
  JuliaLean.base.multidimensional.Models1Group6.NativeLogicalIteration.Progress
abbrev ScanResult :=
  JuliaLean.base.multidimensional.Models1Group6.NativeLogicalIteration.ScanResult

/-- The supplied stable storage snapshot belongs to the same actual vector
mask retained by the LogicalIndex value. Its rank metadata agrees with that
receiver. No condition relates cached count to current mask contents: mutation
before the snapshot can make that cache stale. -/
def Coherent {Handle Other : Type} (mask : NativeLogical.Mask Handle 1)
    (logical : NativeLogical.Value Handle Other) : Prop :=
  logical.maskRank = 1 ∧ logical.fields.mask = mask.handle

/-- Independent native range candidate relation. Explicit iterator states
denote the last emitted coordinate; the mathematical successor is reduced
once modulo Int64. Initial iteration starts at one when the stored range is
nonempty. No model iterator, step, getter or arithmetic helper is called.
Source: base/indices.jl:522; range.jl:935-943. -/
def Candidate (range : LinearRange) (cursor : Option I64) (index : I64) : Prop :=
  match cursor with
  | none => 1 ≤ range.axis.stop.val ∧ index.val = 1
  | some previous => previous.val ≠ range.axis.stop.val ∧
      index = JInt.wrap .i64 (previous.val + 1)

/-- Independent stop condition for the represented native iterator.
Source: base/range.jl:935-943. -/
def Exhausted (range : LinearRange) (cursor : Option I64) : Prop :=
  match cursor with
  | none => range.axis.stop.val < 1
  | some previous => previous.val = range.axis.stop.val

/-- Mathematical observation of one initialized storage cell. Both interval
bounds and zero-based position are explicit; this does not call vectorGet.
Source: base/essentials.jl:1073-1077. -/
def Cell {Handle : Type} (mask : NativeLogical.Mask Handle 1) (index : I64)
    (value : Bool) : Prop :=
  1 ≤ index.val ∧ index.val ≤ (mask.storage.elements.length : Int) ∧
    mask.storage.elements[(index.val - 1).toNat]? = some value

/-- A rejected checked read is exactly an index outside the actual current
storage interval, independently of the saved iterator's stop or cached count.
Source: base/essentials.jl:1073-1077. -/
def OutsideStorage {Handle : Type} (mask : NativeLogical.Mask Handle 1) (index : I64) : Prop :=
  index.val < 1 ∨ (mask.storage.elements.length : Int) < index.val

/-- The yielded/pending tuple retains its exact iterator and last emitted
coordinate, while n+1 is one mathematical successor reduced modulo Int64.
Source: base/multidimensional.jl:865,869. -/
def StateMatches (originalOrdinal : I64) (range : LinearRange) (index : I64)
    (state : StoredState) : Prop :=
  state.ordinal = JInt.wrap .i64 (originalOrdinal.val + 1) ∧
    state.range = range ∧ state.cursor = index

/-- Full observational classification of a closed native scan transition.
True cells yield; false cells retain an explicit pending continuation; iterator
exhaustion raises TypeError; an out-of-storage candidate raises the original
BoundsError channel. No other result/error is admitted. Pending preserves the
lexical original n separately from the wrapped tuple counter.

This is a flat candidate/cell/state relation, not a recursive scan or copy of
the model's iterator/getindex algorithm. All native input extrema, negative
unchecked range stops and arbitrary stored counters are retained.
Source: base/multidimensional.jl:864-871. -/
def StepContract {Handle : Type} (mask : NativeLogical.Mask Handle 1)
    (originalOrdinal : I64) (range : LinearRange) (cursor : Option I64)
    (actual : ScanResult Progress) : Prop :=
  (∀ index state,
    actual = .ok (.yielded index state) ↔
      Candidate range cursor index ∧ Cell mask index true ∧
        StateMatches originalOrdinal range index state) ∧
  (∀ retained state,
    actual = .ok (.pending retained state) ↔
      retained = originalOrdinal ∧ Candidate range cursor state.cursor ∧
        Cell mask state.cursor false ∧
        StateMatches originalOrdinal range state.cursor state) ∧
  (actual = .error (.inr .typeError) ↔ Exhausted range cursor) ∧
  (actual = .error (.inr (.array .bounds)) ↔
    ∃ index, Candidate range cursor index ∧ OutsideStorage mask index) ∧
  (actual = .error (.inr .typeError) ∨
    actual = .error (.inr (.array .bounds)) ∨
    (∃ index state, actual = .ok (.yielded index state)) ∨
    (∃ retained state, actual = .ok (.pending retained state)))

/-- The documented cached-count entry gate followed by the independent
candidate/cell/state relation. The cache is an arbitrary stored Int; it is
not required to equal the number of current true cells or iterator length.
Source: base/multidimensional.jl:859-872. -/
def EntryContract {Handle : Type} (mask : NativeLogical.Mask Handle 1)
    (cachedCount : I64) (state : EntryState) (actual : ScanResult Progress) : Prop :=
  if cachedCount.val < state.ordinal.val then actual = .ok .done
  else StepContract mask state.ordinal state.range state.cursor actual

/-- Source859's native entry prefix meets the complete independent contract
over its declared stable initialized vector domain, with every native counter,
native rank-one LinearIndices object and absent/present native iterator state.
Only actual native storage and mask-identity/rank conditions are assumed.
There is no matching-cache, in-bounds, success or no-overflow premise.
Source: base/multidimensional.jl:859-872. -/
def EntryPrefixProtocol : Prop :=
  ∀ (Handle Other : Type) (mask : NativeLogical.Mask Handle 1)
    (logical : NativeLogical.Value Handle Other) (state : EntryState),
    NativeLogical.MaskRepresentation mask → Coherent mask logical →
    EntryContract mask logical.fields.sum state
      (JuliaLean.base.multidimensional.Models1Group6.NativeLogicalIteration.entryPrefix
        mask logical state)

/-- Source851's native setup uses the current vector storage length for its
new index iterator and native one for n. The original cached count remains
arbitrary. The model is checked against the independent prefix contract,
not by comparing it with another wrapper or by assuming count correctness.
Source: base/multidimensional.jl:851-854. -/
def FirstPrefixProtocol : Prop :=
  ∀ (Handle Other : Type) (mask : NativeLogical.Mask Handle 1)
    (logical : NativeLogical.Value Handle Other),
    NativeLogical.MaskRepresentation mask → Coherent mask logical →
    logical.elementType = .machineInt →
    let range : LinearRange := ⟨⟨JInt.wrap .i64 (mask.storage.elements.length : Int)⟩⟩
    EntryContract mask logical.fields.sum ⟨int 1, range, none⟩
      (JuliaLean.base.multidimensional.Models1Group6.NativeLogicalIteration.firstPrefix mask logical)

/-- A pending while iteration always uses the retained original n, regardless
of the n+1 currently stored in its tuple, and never re-enters the cached-count
guard. Exhausted native iterator state raises the tuple-assertion TypeError
before any mask read. This covers every represented continuation, including
counter wraparound and stale iterator stops, without an arbitrary fuel limit.
Source: base/multidimensional.jl:867-871. -/
def ContinuationProtocol : Prop :=
  ∀ (Handle : Type) (mask : NativeLogical.Mask Handle 1)
    (originalOrdinal : I64) (state : StoredState),
    NativeLogical.MaskRepresentation mask →
    StepContract mask originalOrdinal state.range (some state.cursor)
      (JuliaLean.base.multidimensional.Models1Group6.NativeLogicalIteration.resume
        mask originalOrdinal state) ∧
    (state.cursor.val = state.range.axis.stop.val →
      JuliaLean.base.multidimensional.Models1Group6.NativeLogicalIteration.resume
        mask originalOrdinal state = .error (.inr .typeError))

end NativeLogicalIteration


namespace MaskAxesProtocol

open JuliaLean.base.multidimensional.Models1Group6

/-- State remains observable when an operation returns an exception. -/
abbrev Effects (State Value : Type) := ExceptT Error (StateM State) Value

/-- Observe both the exact return/error and the state reached by a computation. -/
def observe {State Value : Type} (action : Effects State Value) (initial : State) :
    Except Error Value × State :=
  ExceptT.run action initial

/-- Lift an actual runtime action while preserving an independent axes-call
counter. This observer executes the action itself, not an assumed law about it.
-/
def preserveCounter {State Value : Type} (action : Effects State Value) :
    Effects (State × Nat) Value :=
  ExceptT.mk fun state =>
    let (result, final) := observe action state.1
    (result, (final, state.2))

/-- Record invocation of the actual axes action, including a failing action. -/
def countAxes {State Value : Type} (action : Effects State Value) :
    Effects (State × Nat) Value :=
  ExceptT.mk fun state =>
    let (result, final) := observe action state.1
    (result, (final, state.2 + 1))

/-- Preserve every underlying equality/custom-missing action and its effects
while leaving the independent axes-call counter unchanged. -/
def counterRuntime {State Axis TypeTag Other : Type}
    (runtime : MaskAxesRuntime (Effects State) Axis TypeTag Other) :
    MaskAxesRuntime (Effects (State × Nat)) Axis TypeTag Other where
  equal := fun left right => preserveCounter (runtime.equal left right)
  missingExtension := fun value => (runtime.missingExtension value).map preserveCounter

/-- Public source918 invokes axes(I) once, even when that call or later equality
fails. If axes itself fails, its exception and final state pass through exactly.
A non-Tuple result raises the helper dispatch MethodError with that same state.
The property covers every tuple and every effectful runtime implementation;
no state-purity or conversion/equality premise is used.
Source: base/multidimensional.jl:918.
-/
def AxesObservedOnce : Prop :=
  ∀ (State Axis TypeTag Other NonTuple : Type) [DecidableEq TypeTag]
    (runtime : MaskAxesRuntime (Effects State) Axis TypeTag Other)
    (inds : MaskAxisTuple Axis TypeTag)
    (axesAction : Effects State (MaskAxesObservation Axis TypeTag NonTuple)) (initial : State),
    let actual := observe
      (checkindexMaskTupleValue (counterRuntime runtime) inds (countAxes axesAction)) (initial, 0)
    actual.2.2 = 1 ∧
    match observe axesAction initial with
    | (.error error, final) => actual = (.error error, (final, 1))
    | (.ok (.other _), final) =>
        actual = (.error (.methodError "_check_boolean_axes"), (final, 1))
    | (.ok (.tuple _), _) => True

/-- A completed runtime call together with its exact outcome and resulting
state. Native Boolean-context checks do not appear as custom calls.
-/
inductive Event (State Axis TypeTag Other : Type) where
  | equal (left right : MaskAxisOperand Axis TypeTag)
      (result : Except Error (MaskTruth Other)) (stateAfter : State)
  | isMissing (value : MaskTruth Other)
      (result : Except Error (MaskTruth Other)) (stateAfter : State)

/-- The state reached immediately after a recorded runtime operation. -/
def stateAfter {State Axis TypeTag Other : Type} : Event State Axis TypeTag Other → State
  | .equal _ _ _ state => state
  | .isMissing _ _ state => state

/-- Record the actual equality result and state, including errors. -/
def recordEquality {State Axis TypeTag Other : Type}
    (left right : MaskAxisOperand Axis TypeTag) (action : Effects State (MaskTruth Other)) :
    Effects (State × List (Event State Axis TypeTag Other)) (MaskTruth Other) :=
  ExceptT.mk fun state =>
    let (result, final) := observe action state.1
    (result, (final, state.2 ++ [.equal left right result final]))

/-- Record an actual selected custom ismissing call, including its error state. -/
def recordIsMissing {State Axis TypeTag Other : Type}
    (value : MaskTruth Other) (action : Effects State (MaskTruth Other)) :
    Effects (State × List (Event State Axis TypeTag Other)) (MaskTruth Other) :=
  ExceptT.mk fun state =>
    let (result, final) := observe action state.1
    (result, (final, state.2 ++ [.isMissing value result final]))

/-- Transparent instrumentation: each actual runtime operation is executed
once, and its actual result/effects are retained. No correctness assumption is
supplied to the checked method.
-/
def tracingRuntime {State Axis TypeTag Other : Type}
    (runtime : MaskAxesRuntime (Effects State) Axis TypeTag Other) :
    MaskAxesRuntime (Effects (State × List (Event State Axis TypeTag Other)))
      Axis TypeTag Other where
  equal := fun left right => recordEquality left right (runtime.equal left right)
  missingExtension := fun value =>
    (runtime.missingExtension value).map (recordIsMissing value)

/-- Expected axis-comparison requests, from tuple pairing followed by trailing
mask axes against the native singleton. If mask axes run out, the pairing ends
and no trailing singleton comparisons are possible. This is a static request
list, with no effect, exception, or recursive implementation.
Source: base/multidimensional.jl:919-920.
-/
def PlannedComparisons {Axis TypeTag : Type}
    (inds axes : MaskAxisTuple Axis TypeTag) :
    List (MaskAxisOperand Axis TypeTag × MaskAxisOperand Axis TypeTag) :=
  (inds.fields.zip axes.fields).map
      (fun pair => (.observed pair.1, .observed pair.2)) ++
    (axes.fields.drop inds.fields.length).map
      (fun field => (.observed field, maskOneToOne))

/-- Equality requests projected from an observed runtime trace. -/
def EqualityCalls {State Axis TypeTag Other : Type}
    (events : List (Event State Axis TypeTag Other)) :
    List (MaskAxisOperand Axis TypeTag × MaskAxisOperand Axis TypeTag) :=
  events.filterMap fun event =>
    match event with
    | .equal left right _ _ => some (left, right)
    | .isMissing _ _ _ => none

/-- Independent truth-context table for an observed call. A result here marks
an irrevocable stop: false, a native TypeError, or the exact external exception.
This is a finite table on completed observations, not a traversal algorithm.
In a trailing context, every raw value first receives its genuinely selected
ismissing call, if any; otherwise the concrete identity default is used.
-/
def TerminalObservation {State Axis TypeTag Other : Type}
    (runtime : MaskAxesRuntime (Effects State) Axis TypeTag Other) :
    Event State Axis TypeTag Other → Option (Except Error (Option Bool))
  | .equal _ _ (.error error) _ => some (.error error)
  | .isMissing _ (.error error) _ => some (.error error)
  | .equal _ (.observed _) (.ok value) _ =>
      match value with
      | .bool true => none
      | .bool false => some (.ok (some false))
      | .missing | .other _ => some (.error .typeError)
  | .equal _ (.native _) (.ok value) _ =>
      match runtime.missingExtension value with
      | some _ => none
      | none =>
          match value with
          | .bool true | .missing => none
          | .bool false => some (.ok (some false))
          | .other _ => some (.error .typeError)
  | .isMissing _ (.ok (.bool true)) _ => none
  | .isMissing value (.ok (.bool false)) _ =>
      match value with
      | .bool true => none
      | .bool false => some (.ok (some false))
      | .missing | .other _ => some (.error .typeError)
  | .isMissing _ (.ok .missing) _ => some (.error .typeError)
  | .isMissing _ (.ok (.other _)) _ => some (.error .typeError)

/-- A true trace contains true equality results and only false missing tests of
those true Bool values. Selected Bool ismissing overloads may have effects. -/
def AllEqualTrue {State Axis TypeTag Other : Type}
    (events : List (Event State Axis TypeTag Other)) : Prop :=
  ∀ event ∈ events,
    match event with
    | .equal _ _ result _ => result = .ok (.bool true)
    | .isMissing value result _ =>
        value = .bool true ∧ result = .ok (.bool false)

/-- A successful Missing result has a concrete missing-identity observation or
a selected custom ismissing result of true. Leading comparisons are true;
trailing comparison results are unrestricted raw successful values. Every
selected ismissing result is Bool. The terminating-observation table separately
rules out false/type-error/error outcomes in this successful trace.
-/
def MissingEvidence {State Axis TypeTag Other : Type}
    (runtime : MaskAxesRuntime (Effects State) Axis TypeTag Other)
    (events : List (Event State Axis TypeTag Other)) : Prop :=
  (∀ event ∈ events,
    match event with
    | .equal _ (.observed _) result _ => result = .ok (.bool true)
    | .equal _ (.native _) result _ => ∃ value, result = .ok value
    | .isMissing _ result _ => ∃ value, result = .ok (.bool value)) ∧
  ∃ event ∈ events,
    match event with
    | .equal _ (.native _) (.ok .missing) _ =>
        match runtime.missingExtension .missing with
        | none => True
        | some _ => False
    | .isMissing _ (.ok (.bool true)) _ => True
    | _ => False

/-- Full raw-result/effect trace contract at the inherited runtime boundary.

Comparison calls form a prefix of the static documented pairing. Every
terminating observation is the last call and fixes both result and final state.
Custom ismissing is invoked exactly after an eligible trailing raw value,
and never for a leading Boolean context. Success, Missing, false, external
errors, native TypeError, and source tuple BoundsError have independent trace
evidence. All mutable state must be the state of the last executed runtime
operation, or the original state when there were no such calls.

The property quantifies over the complete protocol, including arbitrary custom
effects and raw return values, without a correctness law. It is falsified by
the old false-on-exhaustion dispatcher, Bool-only Missing handling, reordered
comparisons, evaluation after false/error, or discarded error-state updates.
Source: base/multidimensional.jl:918-920; anyall.jl:203-220,238-257.
-/
def CompleteTrace : Prop :=
  ∀ (State Axis TypeTag Other : Type) [DecidableEq TypeTag]
    (runtime : MaskAxesRuntime (Effects State) Axis TypeTag Other)
    (inds axes : MaskAxisTuple Axis TypeTag) (initial : State),
    let (result, finalAndEvents) := observe
      (checkBooleanAxesRaw (tracingRuntime runtime) inds axes) (initial, [])
    let final := finalAndEvents.1
    let events := finalAndEvents.2
    let calls := EqualityCalls events
    let planned := PlannedComparisons inds axes
    calls = planned.take calls.length ∧ calls.length ≤ planned.length ∧
    final = (match events.getLast? with | none => initial | some event => stateAfter event) ∧
    (∀ before event after expected,
      events = before ++ event :: after →
      TerminalObservation runtime event = some expected →
      after = [] ∧ result = expected ∧ final = stateAfter event) ∧
    (∀ before left native value after previous,
      events = before ++ Event.equal left (.native native) (.ok value) previous :: after →
      match runtime.missingExtension value with
      | none => True
      | some _ => ∃ observed next rest,
          after = Event.isMissing value observed next :: rest) ∧
    (∀ before value observed next after,
      events = before ++ Event.isMissing value observed next :: after →
      ∃ earlier left native previous,
        before = earlier ++ [Event.equal left (.native native) (.ok value) previous] ∧
        (match runtime.missingExtension value with | none => False | some _ => True)) ∧
    match result with
    | .ok (some true) =>
        inds.fields.length ≤ axes.fields.length ∧ calls = planned ∧ AllEqualTrue events
    | .ok none =>
        inds.fields.length ≤ axes.fields.length ∧ calls = planned ∧ MissingEvidence runtime events
    | .ok (some false) =>
        ∃ event, events.getLast? = some event ∧
          TerminalObservation runtime event = some (.ok (some false))
    | .error error =>
        (∃ event, events.getLast? = some event ∧
          TerminalObservation runtime event = some (.error error)) ∨
        (error = .boundsError ∧ axes.fields.length < inds.fields.length ∧
          calls = planned ∧ AllEqualTrue events)

end MaskAxesProtocol


