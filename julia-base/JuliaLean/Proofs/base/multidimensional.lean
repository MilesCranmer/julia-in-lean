    ParentMatchEvent E A Element Pointer Shape Strides Other → Option (Sum Error E)
  | .element _ (.error error) | .pointer _ (.error error)
  | .size _ (.error error) | .strides _ (.error error)
  | .equalElement _ _ (.error error) | .equalPointer _ _ (.error error)
  | .equalSize _ _ (.error error) | .equalStrides _ _ (.error error) => some error
  | _ => none

def parentEarlyReply {E A Element Pointer Shape Strides Other : Type} :
    ParentMatchEvent E A Element Pointer Shape Strides Other → Option (MaskTruth Other)
  | .equalElement _ _ (.ok value) | .equalPointer _ _ (.ok value) => some value
  | _ => none

def observeParentMatchOps {E S A Element Pointer Shape Strides Other : Type}
