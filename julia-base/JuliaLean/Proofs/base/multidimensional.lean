def SplitOutcome {α : Type} (source : List α) (rank : SplitRank)
    (outcome : Result (List α × List α)) : Prop :=
  match rank with
  | .other => outcome = .error .typeError
  | .machine n =>
      if n.val < 0 then ∃ message, outcome = .error (.argumentError message)
      else
        match outcome with
        | .ok (front, suffix) =>
