  induction indices with
  | nil => rfl
  | cons head tail ih =>
    cases head <;>
      simp only [indexDimsumAux, List.map_cons, OutputContribution,
        lr_rankRun, lr_requirementValue, indexDimsumScalar, indexDimsumColon,
        indexDimsumMask, ih] <;>
      rfl

