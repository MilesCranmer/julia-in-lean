  ∀ (method : CollectionMethod) (layout : JuliaLean.base.array.MemoryLayout)
    (ranges : Region64) (heap : CollectionHeap),
    RegionDomain ranges → HeapDomain heap → LayoutForRegion layout ranges →
    MethodDomain method ranges →
    ((∃ message : String,
      RunCollection method layout ranges heap = some (.error (.inl (.argument message)))) ↔
      ¬ AllocationAdmitted layout (DimensionValues ranges))


end Collection

