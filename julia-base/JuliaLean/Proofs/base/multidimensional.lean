def MembershipTupleArity (index : CI) : Prop :=
  (index.length : Int) ≤ IntTy.max .i64

abbrev MembershipResult (UserError Value : Type) :=
  Except (Sum MembershipBaseError UserError) Value

abbrev MembershipEffects (State UserError : Type) :=
  ExceptT MembershipBaseError (ExceptT UserError (StateT State Option))

def membershipResult {E A : Type} :
    Except E (Except MembershipBaseError A) → MembershipResult E A
  | .ok (.ok value) => .ok value
  | .ok (.error error) => .error (.inl error)
  | .error error => .error (.inr error)

def membershipRun {S E A : Type} (action : MembershipEffects S E A) (state : S) :
    Option (MembershipResult E A × S) :=
  (action.run.run state).map fun (result, final) => (membershipResult result, final)

/-- Record actual argument/result and state observations, without requiring
any selected callee to obey a numerical or purity law. -/
def observeMembershipAction {S E Event A : Type} (action : MembershipEffects S E A)
    (event : MembershipResult E A → Event) :
    MembershipEffects (S × List (S × S × Event)) E A :=
  ExceptT.mk (ExceptT.mk fun (state, events) =>
    match action.run.run state with
    | none => none
    | some (result, state') =>
        some (result, (state', events ++ [(state, state', event (membershipResult result))])))

def membershipReply {S E A : Type} (reply : MembershipResult E A) (final : S) :
    MembershipEffects S E A :=
  ExceptT.mk (ExceptT.mk fun _ =>
    some ((match reply with
      | .ok value => .ok (.ok value)
      | .error (.inl error) => .ok (.error error)
      | .error (.inr error) => .error error), final))

inductive MembershipEvent (E R V S Q K O : Type) where
  | empty (range : R) (result : MembershipResult E (Sum Bool O))
  | first (range : R) (result : MembershipResult E (MembershipValue V))
  | step (range : R) (result : MembershipResult E (MembershipValue V))
  | last (range : R) (result : MembershipResult E (MembershipValue V))
  | component (value : V) (index : I64) (result : MembershipResult E (MembershipScalar S))
  | zero (value : S) (result : MembershipResult E (Sum Bool O))
  | colon (first stride last : MembershipScalar S) (result : MembershipResult E (MembershipRange Q))
  | findfirst (target : I64) (range : Q) (result : MembershipResult E (Option (MembershipIndex K)))
  | nothing (value : K) (result : MembershipResult E (Sum Bool O))
  | element (range : R) (index : MembershipIndex K) (result : MembershipResult E (MembershipValue V))
  | equalLeft (value : V) (index : CI) (result : MembershipResult E (Sum Bool O))
  | equalRight (index : CI) (value : V) (result : MembershipResult E (Sum Bool O))

def observeMembershipOps {W E R V S Q K O : Type}
    (ops : RangeMembershipOps (MembershipEffects W E) R V S Q K O) :
    RangeMembershipOps
      (MembershipEffects (W × List (W × W × MembershipEvent E R V S Q K O)) E)
      R V S Q K O where
  isempty := fun range => observeMembershipAction (ops.isempty range) (.empty range)
  first := fun range => observeMembershipAction (ops.first range) (.first range)
  step := fun range => observeMembershipAction (ops.step range) (.step range)
  last := fun range => observeMembershipAction (ops.last range) (.last range)
  otherGetindex := fun value index =>
    observeMembershipAction (ops.otherGetindex value index) (.component value index)
  otherIszero := fun value => observeMembershipAction (ops.otherIszero value) (.zero value)
  otherColon := fun first stride last =>
    observeMembershipAction (ops.otherColon first stride last) (.colon first stride last)
  otherFindfirst := fun target range =>
    observeMembershipAction (ops.otherFindfirst target range) (.findfirst target range)
  otherIsnothing := fun value =>
    observeMembershipAction (ops.otherIsnothing value) (.nothing value)
  getindex := fun range index =>
    observeMembershipAction (ops.getindex range index) (.element range index)
  otherEqualLeft := fun value index =>
    observeMembershipAction (ops.otherEqualLeft value index) (.equalLeft value index)
  otherEqualRight := fun index value =>
    observeMembershipAction (ops.otherEqualRight index value) (.equalRight index value)

def membershipEventError {E R V S Q K O : Type} :
    MembershipEvent E R V S Q K O → Option (Sum MembershipBaseError E)
  | .empty _ (.error error) => some error
  | .first _ (.error error) => some error
  | .step _ (.error error) => some error
  | .last _ (.error error) => some error
  | .component _ _ (.error error) => some error
  | .zero _ (.error error) => some error
  | .colon _ _ _ (.error error) => some error
  | .findfirst _ _ (.error error) => some error
  | .nothing _ (.error error) => some error
  | .element _ _ (.error error) => some error
  | .equalLeft _ _ (.error error) => some error
  | .equalRight _ _ (.error error) => some error
  | _ => none

def membershipGuardFailure {E R V S Q K O : Type} :
    MembershipEvent E R V S Q K O → Bool
  | .empty _ (.ok (.inr _)) => true
  | .zero _ (.ok (.inr _)) => true
  | .nothing _ (.ok (.inr _)) => true
  | _ => false

inductive MembershipObserver (R : Type) where
  | empty (range : R)
  | first (range : R)
  | step (range : R)
  | last (range : R)

def membershipObserverCalls {E R V S Q K O : Type}
    (events : List (MembershipEvent E R V S Q K O)) : List (MembershipObserver R) :=
  events.filterMap fun event => match event with
    | .empty range _ => some (.empty range)
    | .first range _ => some (.first range)
    | .step range _ => some (.step range)
    | .last range _ => some (.last range)
    | _ => none

def membershipComponentIndices {E R V S Q K O : Type}
    (events : List (MembershipEvent E R V S Q K O)) : List I64 :=
  events.filterMap fun event => match event with
    | .component _ index _ => some index
    | _ => none

def membershipElementCalls {E R V S Q K O : Type}
    (events : List (MembershipEvent E R V S Q K O)) : List (R × MembershipIndex K) :=
  events.filterMap fun event => match event with
    | .element range index _ => some (range, index)
    | _ => none

def MembershipStateThread {W Event : Type} (initial final : W)
    (records : List (W × W × Event)) : Prop :=
  (match records.head? with
   | none => final = initial
   | some record => record.1 = initial) ∧
  (∀ (record : W × W × Event), records.getLast? = some record → final = record.2.1) ∧
  (∀ (k : Nat) (left right : W × W × Event),
    records[k]? = some left → records[k + 1]? = some right → left.2.1 = right.1)

/-- At most one candidate element is fetched. Its comparison uses the
original queried CartesianIndex and preserves arbitrary equality returns.
Native returned indices compare by their stored coordinate sequence. -/
def MembershipFinalComparisons {E R V S Q K O : Type} (x : CI) (range : R)
    (events : List (MembershipEvent E R V S Q K O))
    (answer : MembershipResult E (Sum Bool O)) : Prop :=
  (membershipElementCalls events).length ≤ 1 ∧
  (∀ (k : Nat) (event : MembershipEvent E R V S Q K O), events[k]? = some event →
    match event with
    | .element actual found returned =>
        actual = range ∧
        (match returned with
         | .error _ => True
         | .ok (.cartesian fields) =>
             k + 1 = events.length ∧
             ∃ value : Bool, answer = .ok (.inl value) ∧ (value = true ↔ fields = x)
         | .ok (.other value) =>
             ∃ reply : MembershipResult E (Sum Bool O),
               events[k + 1]? = some (.equalLeft value x reply) ∧
               k + 2 = events.length ∧ answer = reply)
    | .equalLeft value actual returned =>
        actual = x ∧ k + 1 = events.length ∧ answer = returned ∧
        ∃ previous : Nat, previous + 1 = k ∧
          ∃ found : MembershipIndex K,
            events[previous]? = some (.element range found (.ok (.other value)))
    | .equalRight actual value returned =>
        actual = x ∧ k + 1 = events.length ∧ answer = returned ∧
        membershipElementCalls events = [] ∧
        events[1]? = some (.first range (.ok (.other value)))
    | _ => True)

/-- Independent traversal/effect invariants. Observer calls form the ordered
initial prefix. Custom component indices are in range and never decrease;
the pivot's stride may be observed twice, and at most four custom component
reads occur at a single coordinate. Every reached exception or bad control
predicate stops immediately. The first successful candidate comparison is
final, even when it returns a non-Bool value. -/
def MembershipObservation {W E R V S Q K O : Type} (x : CI) (range : R) (initial : W)
    (outcome : Option (MembershipResult E (Sum Bool O) ×
      (W × List (W × W × MembershipEvent E R V S Q K O)))) : Prop :=
  match outcome with
  | none => True
  | some (answer, (final, records)) =>
      let events := records.map (fun record => record.2.2)
      let observers := membershipObserverCalls events
      let components := membershipComponentIndices events
      MembershipStateThread initial final records ∧
      (∃ remainder, observers ++ remainder =
        [.empty range, .first range, .step range, .last range]) ∧
      (match events.head? with | some (.empty actual _) => actual = range | _ => False) ∧
      (∀ (k : Nat) (event : MembershipEvent E R V S Q K O), events[k]? = some event →
        (k ≥ 4 → observers = [.empty range, .first range, .step range, .last range]) ∧
        (∀ error : Sum MembershipBaseError E, membershipEventError event = some error →
          k + 1 = events.length ∧ answer = .error error) ∧
        (membershipGuardFailure event = true →
          k + 1 = events.length ∧ answer = .error (.inl (.inr Error.typeError))) ∧
        (match event with
         | .empty _ (.ok (.inl true)) | .nothing _ (.ok (.inl true)) |
             .findfirst _ _ (.ok none) =>
             k + 1 = events.length ∧ answer = .ok (.inl false)
         | .component _ index _ => 1 ≤ index.val ∧ index.val ≤ (x.length : Int)
         | .findfirst target _ _ =>
             ∃ position : I64,
               (membershipComponentIndices (events.take k)).getLast? = some position ∧
               ∃ offset : Nat, (offset : Int) + 1 = position.val ∧ x[offset]? = some target
         | _ => True)) ∧
      (∀ (k : Nat) (left right : I64), components[k]? = some left →
        components[k + 1]? = some right → left.val ≤ right.val) ∧
      (∀ index : I64, (components.filter (fun value => value.val == index.val)).length ≤ 4) ∧
      MembershipFinalComparisons x range events answer

/-- Full same-rank AbstractRange method domain. All selected callees are
arbitrary stateful actions with arbitrary Base/user exceptions and possible
nontermination; returned values need not match advertised eltypes. Only the
CartesianIndex's actual machine-constructible tuple arity is required.
Source: base/multidimensional.jl:193-208; doc/src/manual/arrays.md:800-820. -/
def RangeMembershipObservations : Prop :=
  ∀ (W E R V S Q K O : Type)
    (ops : RangeMembershipOps (MembershipEffects W E) R V S Q K O)
    (x : CI) (range : R) (initial : W), MembershipTupleArity x →
    MembershipObservation x range initial
      (membershipRun (cartesianRangeMembership (observeMembershipOps ops) x range) (initial, []))

/-- Empty ranges return false after the emptiness call's state changes, and
malformed emptiness values raise TypeError at the same point. Arbitrary later
callees cannot run or replace either result.
Source: base/multidimensional.jl:194. -/
def RangeMembershipEmptyGuard : Prop :=
  ∀ (W E R V S Q K O : Type)
    (ops : RangeMembershipOps (MembershipEffects W E) R V S Q K O)
    (x : CI) (range : R) (initial final : W), MembershipTupleArity x →
    (let emptyOps := { ops with isempty := fun _ => membershipReply (.ok (.inl true)) final }
     membershipRun (cartesianRangeMembership emptyOps x range) initial =
       some (.ok (.inl false), final)) ∧
    (∀ malformed : O,
      let badOps := { ops with isempty := fun _ => membershipReply (.ok (.inr malformed)) final }
      membershipRun (cartesianRangeMembership badOps x range) initial =
        some (.error (.inl (.inr Error.typeError)), final))

theorem RangeMembershipEmptyGuard_proven : RangeMembershipEmptyGuard := by
  intro W E R V S Q K O ops x range initial final _
  exact ⟨rfl, fun _ => rfl⟩

/-- With rank zero, the final x==first comparison preserves every possible
custom value or exception and its state, rather than asserting Bool or
silently replacing it by true/false. This uses concrete total selected callees,
not a correctness hypothesis on an arbitrary callee.
Source: base/multidimensional.jl:195,200-207. -/
def RangeMembershipZeroRankReplies : Prop :=
  ∀ (W E R V S Q K O : Type)
    (ops : RangeMembershipOps (MembershipEffects W E) R V S Q K O)
    (range : R) (first : V) (stride last : MembershipValue V)
    (initial final : W) (reply : MembershipResult E (Sum Bool O)),
    let zeroOps := { ops with
      isempty := fun _ => pure (.inl false)
      first := fun _ => pure (.other first)
      step := fun _ => pure stride
      last := fun _ => pure last
      otherEqualRight := fun _ _ => membershipReply reply final }
    membershipRun (cartesianRangeMembership zeroOps [] range) initial = some (reply, final)

theorem RangeMembershipZeroRankReplies_proven : RangeMembershipZeroRankReplies := by
  intro W E R V S Q K O ops range first stride last initial final reply
  cases reply with
  | ok value => rfl
  | error err => cases err <;> rfl

open JuliaLean.base.multidimensional.Models1Group5

/-- All fields and operations of this concrete StepRangeLen subtype are
installed Base models. The generic model above receives this one closed
instantiation in the independent modular-sequence property below. -/
def concreteMembershipOps :
    RangeMembershipOps (Except MembershipBaseError) CartesianStepRange64 Empty Empty Empty Empty Empty where
  isempty := fun range => do return .inl (← membershipLift (CartesianLine.isEmpty range))
  first := fun range => do return .cartesian (← membershipLift (CartesianLine.first range))
  step := fun range => pure (.cartesian (JuliaLean.base.range.step_StepRangeLen range))
  last := fun range => do return .cartesian (← membershipLift (CartesianLine.last range))
  otherGetindex := fun impossible _ => nomatch impossible
  otherIszero := fun impossible => nomatch impossible
  otherColon := fun first stride last =>
    match first, stride, last with
    | .native first, .native stride, .native last => do
        return .native (← membershipLift (RangeDependencies.makeStep first stride last))
    | .other impossible, _, _ => nomatch impossible
    | _, .other impossible, _ => nomatch impossible
    | _, _, .other impossible => nomatch impossible
  otherFindfirst := fun _ impossible => nomatch impossible
  otherIsnothing := fun impossible => nomatch impossible
  getindex := fun range index =>
    match index with
    | .native index => do return .cartesian (← membershipLift (CartesianLine.indexAt range index))
    | .other impossible => nomatch impossible
  otherEqualLeft := fun impossible _ => nomatch impossible
  otherEqualRight := fun _ impossible => nomatch impossible

/-- Exactly the stored constructor/rank invariants of this concrete subtype;
there is no coordinate-magnitude, monotonicity, or no-overflow precondition. -/
def MembershipLineValid (range : CartesianStepRange64) : Prop :=
  0 ≤ range.len.val ∧ 1 ≤ range.offset.val ∧ range.offset.val ≤ max 1 range.len.val ∧
  range.ref.length = range.step.length ∧ MembershipTupleArity range.ref

def membershipSignedResidue (value : Int) : Int :=
  (value + (2 : Int) ^ 63) % ((2 : Int) ^ 64) - (2 : Int) ^ 63

/-- One mathematical affine expression per coordinate, reduced once modulo
2^64. It invokes no indexing, range-construction, findfirst, or membership model. -/
def MembershipLinePoint (range : CartesianStepRange64) (position : Int) : List Int :=
  List.zipWith (fun (reference stride : I64) => membershipSignedResidue
    (reference.val + (position - range.offset.val) * stride.val)) range.ref range.step

/-- Independent public membership candidate over every constructible concrete
StepRangeLen of CartesianIndex values. It includes empty and rank-zero ranges,
all reference offsets, zero/negative strides, and all coordinate extrema.
Source scalar search/overflow behavior is allowed to refute this unproved
promise; no overflow premise is inserted to hide such a counterexample.
Source: base/multidimensional.jl:193-208; base/range.jl:512-525,986-989;
doc/src/manual/integers-and-floating-point-numbers.md:231-249. -/
def RangeMembershipConcreteGeometry : Prop :=
  ∀ (x : CI) (range : CartesianStepRange64), MembershipLineValid range →
    x.length = range.ref.length →
    match cartesianRangeMembership concreteMembershipOps x range with
    | .ok (.inl answer) =>
        answer = true ↔ ∃ position : Int, 1 ≤ position ∧ position ≤ range.len.val ∧
          x.map (fun coordinate => coordinate.val) = MembershipLinePoint range position
    | .ok (.inr impossible) => nomatch impossible
    | .error _ => False

