  induction indices with
  | nil => rfl
  | cons head tail ih =>
    cases head <;>
      simp only [indexNdimsAux, List.map_cons, InputContribution,
        lr_rankRun, lr_requirementValue, indexNdimsCartesian, indexNdimsEmpty,
        indexNdimsScalar, List.map_const', List.append_nil, ih] <;>
      rfl

theorem lr_dimsum_run (indices : List IndexMetadata) (generated : Bool) :
    indexDimsumAux generated indices =
