abbrev AtomicObservationM (E S : Type) := ExceptT (Sum Error E) (StateT S Option)

local instance atomicObservationError {E S : Type} : MonadExceptOf Error (AtomicObservationM E S) where
  throw error := ExceptT.mk fun state => some (.error (.inl error), state)
  tryCatch action handler := ExceptT.mk fun state =>
    match action.run state with
    | none => none
    | some (.ok value, state') => some (.ok value, state')
    | some (.error (.inl error), state') => (handler error).run state'
    | some (.error error, state') => some (.error error, state')

inductive AtomicPrimitiveArguments (Memory Pointer Element Value Expected Operation : Type) where
  | get (reference : JuliaLean.base.genericmemory.GenericMemoryRef Memory Pointer)
      (order : JuliaLean.base.genericmemory.MemoryOrder) (bounds : Bool)
  | set (reference : JuliaLean.base.genericmemory.GenericMemoryRef Memory Pointer) (value : Element)
      (order : JuliaLean.base.genericmemory.MemoryOrder) (bounds : Bool)
  | once (reference : JuliaLean.base.genericmemory.GenericMemoryRef Memory Pointer) (value : Element)
