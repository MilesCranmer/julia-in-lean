  | .shape => indexShapeMethod ops head tail
  | .sizes => indexSizesMethod ops head tail

def indexMetadataHead {R A C : Type} : Sum R A → Models1Group6.MetadataInput R A C
  | .inl value => .real value
  | .inr reference => .array reference

def indexMetadataArrays {R A C : Type} (inputs : List (Models1Group6.MetadataInput R A C)) : List A :=
  inputs.filterMap fun input => match input with | .array reference => some reference | _ => none

def indexMetadataReadReferences {E R A C V T : Type}
    (events : List (IndexMetadataEvent E R A C V T)) : List A :=
  events.filterMap fun event => match event with
    | .length reference _ | .fields _ reference _ => some reference
    | _ => none

def indexMetadataEventError {E R A C V T : Type} : IndexMetadataEvent E R A C V T → Option (Sum Error E)
  | .length _ (.error error) | .fields _ _ (.error error)
  | .selected _ _ (.error error) | .splat _ _ _ (.error error) => some error
  | _ => none

