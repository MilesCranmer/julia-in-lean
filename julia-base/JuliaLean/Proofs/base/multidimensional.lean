/-- Installed AbstractRange conversion has an actual isa identity branch;
no caller-supplied conversion law or invented unreachable result is used. -/
def nativeUtilityOuterOps : RegionOuterOps UtilityNativeM OrdinalRange64 OrdinalRange64 Empty where
  ordinal := {
    convertRange := fun range => do
      return .inl (← utilityLiftRange
        (JuliaLean.base.range.convert_Type_AbstractRange OrdinalRange64 range))
    selectedMap := fun _ _ => none
    applyIterateOther := fun _ impossible => nomatch impossible
    selectedConstructor := fun _ _ => none }
  selectedConstructor := fun _ => none

