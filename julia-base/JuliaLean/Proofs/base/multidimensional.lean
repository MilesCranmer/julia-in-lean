private theorem mc_aux_axes
    {m : Type → Type} [Monad m] [MonadExceptOf Error m]
    {ARef BigRef Ptr Custom V Axis : Type}
    (runtime : MixedIndexRuntime m ARef BigRef Ptr Custom V)
    (array : MixedArray ARef) (indices : List (MixedIndex BigRef Custom))
    (left right : List Axis) :
    toIndicesMixedAux runtime array left indices =
      toIndicesMixedAux runtime array right indices := by
  induction indices generalizing left right with
  | nil => simp only [toIndicesMixedAux, JuliaLean.base.indices.to_indices_A_inds_Tuple0]
  | cons head tail ih =>
      cases head with
      | integer input =>
          simp only [toIndicesMixedAux]
          rw [ih left.tail right.tail]
      | cartesian coordinates =>
          simp only [toIndicesMixedAux]
          rw [ih]

private theorem mc_aux_flat
    {m : Type → Type} [Monad m] [LawfulMonad m] [MonadExceptOf Error m]
    {ARef BigRef Ptr Custom V Axis : Type}
    (runtime : MixedIndexRuntime m ARef BigRef Ptr Custom V)
    (array : MixedArray ARef) (indices : List (MixedIndex BigRef Custom))
    (axes : List Axis) :
    toIndicesMixedAux runtime array axes indices =
      (ExpandedInputs indices).mapM (toIndexMixedClosed runtime array) := by
  induction indices generalizing axes with
  | nil =>
      simp only [toIndicesMixedAux, JuliaLean.base.indices.to_indices_A_inds_Tuple0,
        ExpandedInputs, List.flatMap_nil, List.mapM_nil]
  | cons head tail ih =>
      cases head with
      | integer input =>
          simp only [toIndicesMixedAux, ExpandedInputs, List.flatMap_cons,
            List.singleton_append, List.mapM_cons, ih]
      | cartesian coordinates =>
          simp only [toIndicesMixedAux, ExpandedInputs, List.flatMap_cons,
            List.mapM_append, List.mapM_map, ih, Function.comp_def]

private theorem mc_observe_pure {State Value : Type} (value : Value) (initial : State) :
    observe (pure value : Effects State Value) initial = (.ok value, initial) := rfl

private theorem mc_observe_bind {State A B : Type}
    (first : Effects State A) (next : A → Effects State B) (initial : State) :
    observe (first >>= next) initial =
      match observe first initial with
      | (.error error, final) => (.error error, final)
      | (.ok value, middle) => observe (next value) middle := by
  cases h : ExceptT.run first initial with
  | mk result final =>
      simp only [ExceptT.run] at h
      cases result <;>
        simp only [observe, ExceptT.run, ExceptT.mk, Bind.bind, ExceptT.bind,
          ExceptT.bindCont, StateT.bind, Pure.pure, StateT.pure, h]

private theorem mc_mapM_length {State A B : Type} (f : A → Effects State B)
    (inputs : List A) (initial final : State) (output : List B)
    (h : observe (inputs.mapM f) initial = (.ok output, final)) :
    output.length = inputs.length := by
  induction inputs generalizing initial final output with
  | nil =>
      have hp : ((Except.ok ([] : List B) : Except Error (List B)), initial) =
        (Except.ok output, final) := h
      cases hp
      rfl
  | cons input inputs ih =>
      rw [List.mapM_cons, mc_observe_bind] at h
      cases hfirst : observe (f input) initial with
      | mk result middle =>
          cases result with
          | error error => simp only [hfirst] at h; cases h
          | ok value =>
              simp only [hfirst, mc_observe_bind] at h
              cases hrest : observe (inputs.mapM f) middle with
              | mk result last =>
                  cases result with
                  | error error => simp only [hrest] at h; cases h
                  | ok rest =>
                      simp only [hrest, mc_observe_pure, Prod.mk.injEq, Except.ok.injEq] at h
                      rw [← h.1, List.length_cons, List.length_cons]
                      exact congrArg Nat.succ (ih middle last rest hrest)

private theorem mc_expanded_length {BigRef Custom : Type}
    (indices : List (MixedIndex BigRef Custom)) :
    (ExpandedInputs indices).length = (indices.map Arity).sum := by
  induction indices with
  | nil => rfl
  | cons head tail ih =>
      cases head with
      | integer input =>
          simp only [ExpandedInputs, List.flatMap_cons, List.singleton_append,
            List.length_cons, List.map_cons, Arity, List.sum_cons, ← ih]
          omega
      | cartesian coordinates =>
          simp only [ExpandedInputs, List.flatMap_cons, List.length_append,
            List.length_map, List.map_cons, Arity, List.sum_cons, ← ih]

private theorem mc_closed_length
    {State ARef BigRef Ptr Custom Value : Type}
    (runtime : MixedIndexRuntime (Effects State) ARef BigRef Ptr Custom Value)
    (array : MixedArray ARef) (indices : List (MixedIndex BigRef Custom))
    (initial final : State) (output : List Value)
    (h : observe (toIndicesMixedClosed runtime array indices) initial = (.ok output, final)) :
    output.length = (indices.map Arity).sum := by
  rw [toIndicesMixedClosed, mc_aux_flat] at h
  exact (mc_mapM_length _ _ _ _ _ h).trans (mc_expanded_length indices)

private theorem mc_machine_inputs {BigRef Custom : Type} (values : CI) :
    mixedOnlyMachineInts
      (values.map (fun value : I64 => (MixedIndex.integer (MixedInteger.bits .i64 value) :
        MixedIndex BigRef Custom))) = some values := by
