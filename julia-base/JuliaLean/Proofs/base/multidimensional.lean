/-- Coordinatewise relation between two finite tuples, expressed without any model call. -/
def Coordinatewise {A B : Type} (relation : A → B → Prop) : List A → List B → Prop
  | [], [] => True
  | x :: xs, y :: ys => relation x y ∧ Coordinatewise relation xs ys
  | _, _ => False

/-- Membership in the signed one-based interval exposed by a component's actual machine
axis length. Negative unchecked OneTo endpoints describe an empty mathematical interval. -/
def DeclaredAxisMember (axis : OrdinalRange64) (i : I64) : Prop :=
  ∃ count : I64, MachineAxisCount axis count ∧ 1 ≤ i.val ∧ i.val ≤ count.val

def DeclaredRegionMember (region : Region64) (indices : CI) : Prop :=
  Coordinatewise DeclaredAxisMember region indices

/-- The unsigned machine offset lies within the machine axis extent. This deliberately
retains wrapped lengths and signed indices instead of imposing a no-overflow condition. -/
def MachineAxisAddress (axis : OrdinalRange64) (i : I64) : Prop :=
  ∃ count : I64, MachineAxisCount axis count ∧
    (i.val - 1) % ((2 : Int) ^ 64) < count.val % ((2 : Int) ^ 64)

def MachineRegionAddress (region : Region64) (indices : CI) : Prop :=
  Coordinatewise MachineAxisAddress region indices

/-- The independently specified affine coordinate at a machine address, interpreted modulo
2^64. Intermediate machine additions and multiplications are not copied into this relation. -/
def AddressedCoordinate (axis : OrdinalRange64) (i coordinate : I64) : Prop :=
  (coordinate.val - ((rangeFirst axis).val + (i.val - 1) * (rangeStep axis).val)) %
    ((2 : Int) ^ 64) = 0

/-- Axes preserve tuple rank and expose OneTo of each exact signed machine length, including
negative unchecked OneTo stops resulting from huge lazy ranges. Constructors are not allowed
to clamp these axis endpoints. Getter observations also preserve those stored endpoints.
Source: base/multidimensional.jl:387; base/abstractarray.jl:100-103,140-141. -/
def RegionAxesCorrect : Prop :=
  ∀ region : Region64, RegionDomain region →
    match regionAxes region with
    | .ok axes =>
        axes.length = region.length ∧
        ∀ (k : Nat) (axis : OrdinalRange64), region[k]? = some axis →
          ∃ count : I64, axes[k]? = some (.oneTo ⟨count⟩) ∧ MachineAxisCount axis count ∧
