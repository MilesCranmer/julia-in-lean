    ParentMatchEvent E A Element Pointer Shape Strides Other → Nat
  | .element _ _ => 0
  | .equalElement _ _ _ => 1
  | .pointer _ _ => 2
  | .equalPointer _ _ _ => 3
  | .size _ _ | .strides _ _ => 4
  | .equalSize _ _ _ | .equalStrides _ _ _ => 5

