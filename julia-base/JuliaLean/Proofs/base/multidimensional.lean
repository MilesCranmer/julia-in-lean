then selects the first non-true equality outcome in aggregate. -/
def PermutedAxesReference {Axis : Type} {rank : Nat}
    (axisEqual : Axis → Axis → Result Bool)
    (destination source : RankedAxes Axis rank) (permutation : ShortIntTuple) :
    Result Unit :=
  if permutation.val.length ≠ rank then
    .error (.argumentError ("expected permutation of size " ++ toString rank ++
      ", but length(perm)=" ++ toString permutation.val.length))
  else if ¬ ShortTuplePermutation permutation then
    .error (.argumentError "input is not a permutation")
  else
    let outcomes : List (Result Bool) := (destination.val.zip permutation.val).map (fun pair =>
      match source.val[(pair.2.val - 1).toNat]? with
      | none => .error .boundsError
      | some sourceAxis => axisEqual pair.1 sourceAxis)
    match outcomes.find? (fun outcome => match outcome with
      | .ok true => false
      | _ => true) with
    | none => .ok ()
    | some (.ok _) => .error (.dimensionMismatch "destination tensor of incorrect size")
    | some (.error error) => .error error

/-- Complete protocol invariant within the explicitly supported short-Int-
tuple permutation domain. Axes observations and equality outcomes are wholly
unconstrained at the inherited runtime interface: errors and nonstandard
ranges are retained, and no equality correctness law is assumed. Effectful
custom equality and non-Bool equality results are outside this pure interface.
Length and
permutation validation precede all axis comparisons. This is a partial closure
of the full Julia signature, whose other permutation containers and Any32
allocation path remain blocked.
Source: base/multidimensional.jl:1678-1686; combinatorics.jl:87-99. -/
def CheckDimsPermShortProtocol : Prop :=
  ∀ (Axis : Type) (rank : Nat)
    (axisEqual : Axis → Axis → Result Bool)
    (destinationAxes sourceAxes : Result (RankedAxes Axis rank))
    (permutation : ShortIntTuple),
    (rank : Int) ≤ IntTy.max .i64 →
    JuliaLean.base.multidimensional.Models1Group6.checkDimsPermArraysShort
      axisEqual destinationAxes sourceAxes permutation =
      match destinationAxes, sourceAxes with
      | .error error, _ => .error error
      | .ok _, .error error => .error error
      | .ok destination, .ok source =>
          PermutedAxesReference axisEqual destination source permutation


namespace RefValueProjection

open JuliaLean.base.multidimensional.Models1Group6.RefValueProjection

/-- Read a computation's exact success/error and final shared field store. -/
def observe {Handle Element Extra UserError Value : Type}
    (action : Effects Handle Element Extra UserError Value)
    (initial : Heap Handle Element Extra) :
    Except (Error ⊕ UserError) Value × Heap Handle Element Extra :=
  ExceptT.run action initial

/-- The zero-dimensional native RefValue getter exposes the value currently in
its actual shared cell, or UndefRefError for an undefined reference slot, and
leaves every field and the rest of the world unchanged. The expected value is
an observation of the input heap, not a rerun of the getter implementation.
Only the declared native typed-field projection is covered; the full Ref
signature remains blocked for other subtypes and custom dispatch.
Source: base/multidimensional.jl:1992; base/refvalue.jl:59; refpointer.jl:6-26. -/
def ReadCorrect : Prop :=
  ∀ (Handle Element Extra UserError : Type) (reference : Handle)
    (initial : Heap Handle Element Extra),
    let actual := observe (getIndexZero (UserError := UserError) reference) initial
    actual.2 = initial ∧
    match initial.fields reference with
    | none => actual.1 = .error (.inl .undefRefError)
    | some value => actual.1 = .ok value

/-- Observe the actual selected conversion once, only for a value outside the
field's declared type. This is not a supplied conversion-correctness law: raw
wrong-type returns, arbitrary user errors and all world changes are retained.
The typed case observes no conversion action.
Source: base/Base_compiler.jl:60-64. -/
def ConversionObservation {Handle Element Extra UserError Other : Type}
    (convert : Other → Effects Handle Element Extra UserError (Input Element Other))
    (input : Input Element Other) (initial : Heap Handle Element Extra) :
    Except (Error ⊕ UserError) (Input Element Other) × Heap Handle Element Extra :=
  match input with
  | .typed _ => (.ok input, initial)
  | .other other => observe (convert other) initial

/-- A native zero-dimensional RefValue assignment returns the same reference
identity and changes exactly its shared field to the converted typed payload.
All other fields and external state are exactly as the actual conversion left
them, so alias mutation during conversion is preserved. A conversion exception
passes through unchanged with its state; a wrong-type conversion result raises
TypeError before the final store, with those same prior effects retained.

The contract quantifies over every raw input and every actual conversion action,
including mutations before failure. It uses pointwise heap obligations instead
of the model's functional store update and assumes neither successful conversion
nor a correctness/alias-separation law. It is a promise of the explicit native
RefValue projection; the full Ref method remains blocked.
Source: base/multidimensional.jl:1993; base/refvalue.jl:60;
base/Base_compiler.jl:60-64. -/
def WriteCorrect : Prop :=
  ∀ (Handle Element Extra UserError Other : Type) [DecidableEq Handle]
    (convert : Other → Effects Handle Element Extra UserError (Input Element Other))
    (reference : Handle) (input : Input Element Other) (initial : Heap Handle Element Extra),
    let converted := ConversionObservation convert input initial
    let actual := observe (setIndexZero convert reference input) initial
    match converted.1 with
    | .error error => actual.1 = .error error ∧ actual.2 = converted.2
    | .ok (.other _) => actual.1 = .error (.inl .typeError) ∧ actual.2 = converted.2
    | .ok (.typed value) =>
        actual.1 = .ok reference ∧
        actual.2.fields reference = some value ∧
        (∀ alias, alias = reference → actual.2.fields alias = some value) ∧
        (∀ other, other ≠ reference → actual.2.fields other = converted.2.fields other) ∧
        actual.2.extra = converted.2.extra

end RefValueProjection


/-- Independent aggregate observation of the ordered Core.isa tests. A false
result allows scanning to continue; a true result or an exception is decisive.
This reference is not a recursive implementation of `union_split` and does
not invoke the caller's function. Since the Core test is a pure primitive,
precomputing its result list in the specification introduces no state effects. -/
def UnionSplitFirstObservation {E X T : Type}
    (isaPrimitive : X → T → Except E Bool) (x : X) (hints : List T) :
    Option (Except E Bool) :=
  (hints.map (isaPrimitive x)).find? (fun observation => match observation with
    | .ok false => false
    | _ => true)

/-- Full effect-polymorphic union-splitting protocol. Across every runtime
exception domain, every caller-supplied function and every constructed hint
and argument tuple, the first decisive Core.isa observation determines whether
the helper propagates that exception or performs exactly the original function
application. A true observation hides later invalid hints; exhaustion calls
with the original x and intact args. No correctness, success or purity law is
assumed for function application, and no type-test correctness law is assumed.

Quantifying over the effect container retains state, IO, custom exceptions and
partial/nonterminating computations represented by that container. The only
input-size premise is the actual machine-size limit on Julia tuple arity.
Source: base/multidimensional.jl:2060-2084. -/
def UnionSplitProtocol : Prop :=
  ∀ (m : Type → Type) [Monad m] (E F X T Args O : Type) [MonadExceptOf E m]
    (isaPrimitive : X → T → Except E Bool)
    (applyFunction : F → X → Args → m O)
    (f : F) (x : X) (hints : List T) (args : Args),
    (hints.length : Int) ≤ IntTy.max .i64 →
    JuliaLean.base.multidimensional.Models1Group6.unionSplitClosed
      isaPrimitive applyFunction f x hints args =
      match UnionSplitFirstObservation isaPrimitive x hints with
      | some (.error error) => (throw error : m O)
      | _ => applyFunction f x args

/-- Explicit state-and-exception specialization of the full protocol. A
reached Core.isa error leaves the incoming state untouched. Otherwise the
result and final state are exactly those of one original function call,
including its final state when the call throws. Arbitrary state can record
heap mutation, IO traces and the number/order/arguments of function calls, so
this statement detects duplicated calls, changed arguments and lost effects.
It includes the assigned empty-tuple method as the empty-hints instance.
Source: base/multidimensional.jl:2077-2084. -/
def UnionSplitStateProtocol : Prop :=
  ∀ (E S F X T Args O : Type)
    (isaPrimitive : X → T → Except E Bool)
    (applyFunction : F → X → Args → EStateM E S O)
    (f : F) (x : X) (hints : List T) (args : Args) (initial : S),
    (hints.length : Int) ≤ IntTy.max .i64 →
    (JuliaLean.base.multidimensional.Models1Group6.unionSplitClosed
      isaPrimitive applyFunction f x hints args) initial =
      match UnionSplitFirstObservation isaPrimitive x hints with
      | some (.error error) => EStateM.Result.error error initial
      | _ => applyFunction f x args initial


end Models1Group6

