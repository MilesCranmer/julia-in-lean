    (h : RangeConstructible (.stepped r)) (hn : rangeIsEmpty (.stepped r) = false) :
    (rangeCardinality (.stepped r) : Int) =
      ((r.stop.val - r.start.val).natAbs : Int) / (r.step.val.natAbs : Int) + 1 := by
  have hs := scalar7_step_sign r hn
  have hz : r.step.val ≠ 0 := h.1
  have hm : (r.stop.val - r.start.val) % r.step.val = 0 := by
    have hh := h.2
    simpa only [hn, Bool.false_eq_true, ↓reduceIte] using hh
  have hdiv : r.step.val ∣ r.stop.val - r.start.val := Int.dvd_of_emod_eq_zero hm
  have hquot : (r.stop.val - r.start.val) / r.step.val =
      ((r.stop.val - r.start.val).natAbs : Int) / (r.step.val.natAbs : Int) := by
    by_cases hneg : r.step.val < 0
    · have hd := hs.1 hneg
      rw [Int.ofNat_natAbs_of_nonpos (by omega), Int.ofNat_natAbs_of_nonpos (by omega),
        Int.ediv_neg, Int.neg_ediv_of_dvd hdiv, Int.neg_neg]
    · have hp : 0 < r.step.val := by omega
      have hd := hs.2 hp
      rw [Int.ofNat_natAbs_of_nonneg (by omega), Int.ofNat_natAbs_of_nonneg (by omega)]
  have hnonneg : 0 ≤ (r.stop.val - r.start.val) / r.step.val := by
    rw [hquot]
    exact Int.ediv_nonneg (Int.natCast_nonneg _) (Int.natCast_nonneg _)
  unfold rangeCardinality
  rw [hn]
  simp only [Bool.false_eq_true, ↓reduceIte, rangeLast, rangeFirst, rangeStep,
    JuliaLean.base.range.step_StepRange, Int.natCast_add, Int.natCast_one,
    Int.toNat_of_nonneg hnonneg]
  rw [hquot]

theorem scalar7_step_length (r : JuliaLean.base.range.StepRange I64 I64)
    (h : RangeConstructible (.stepped r)) :
    ∃ count : I64, rangeLength (.stepped r) = .ok count ∧
      MachineAxisCount (.stepped r) count := by
  cases he : rangeIsEmpty (.stepped r) with
  | true =>
    refine ⟨int 0, ?_, ?_⟩
    · unfold rangeLength JuliaLean.base.range.length_OrdinalRange_bigints
      change (do
        if rangeIsEmpty (.stepped r) then return int 0
        let q ← unsignedDivSigned
          (JuliaLean.base.int.unsigned
            (JuliaLean.base.int.flipsign (JuliaLean.base.int.sub r.stop r.start) r.step)) r.step
        return JuliaLean.base.int.flipsign (JuliaLean.base.int.remT .i64 q) r.step + int 1) = _
      rw [he]
      rfl
    · change ((int 0).val - (rangeCardinality (.stepped r) : Int)) % ((2 : Int)^64) = 0
      unfold rangeCardinality
      rw [he]
      rfl
  | false =>
    let u : U64 := JuliaLean.base.int.unsigned
      (JuliaLean.base.int.flipsign (JuliaLean.base.int.sub r.stop r.start) r.step)
    let v : U64 := JuliaLean.base.int.unsigned (JuliaLean.base.int.abs r.step)
    have hv : v.val ≠ 0 := by
      change (JuliaLean.base.int.unsigned (JuliaLean.base.int.abs r.step)).val ≠ 0
      rw [scalar7_abs_unsigned_val]
      intro hz
      have hn : r.step.val.natAbs = 0 := by omega
      exact h.1 (Int.natAbs_eq_zero.mp hn)
    let q : U64 := JuliaLean.C.toJInt .u64 (BitVec.ofInt 64 (u.val / v.val))
    let z : I64 := JuliaLean.base.int.flipsign
      (JuliaLean.base.int.remT .i64
        (JuliaLean.base.int.unsigned (JuliaLean.base.int.flipsign (JuliaLean.base.int.signed q) r.step))) r.step
    refine ⟨z + int 1, ?_, ?_⟩
    · unfold rangeLength JuliaLean.base.range.length_OrdinalRange_bigints
      change (do
        if rangeIsEmpty (.stepped r) then return int 0
        let p ← unsignedDivSigned u r.step
        return JuliaLean.base.int.flipsign (JuliaLean.base.int.remT .i64 p) r.step + int 1) = _
      rw [he]
      simp only [Bool.false_eq_true, ↓reduceIte]
      unfold unsignedDivSigned JuliaLean.base.int.Generic.div_Unsigned_BitSigned
      rw [scalar7_udiv u v hv]
      rfl
    · have hc : (rangeCardinality (.stepped r) : Int) = u.val / v.val + 1 := by
        rw [scalar7_step_cardinality r h he]
        rw [show u.val = ((r.stop.val - r.start.val).natAbs : Int) from
          scalar7_step_numerator r h.1 he]
        rw [show v.val = (r.step.val.natAbs : Int) from scalar7_abs_unsigned_val r.step]
      have hz : z.val % ((2 : Int)^64) = (u.val / v.val) % ((2 : Int)^64) := by
        rw [scalar7_flip_roundtrip_mod q r.step]
        change (JuliaLean.C.toJInt .u64 (BitVec.ofInt 64 (u.val / v.val))).val % _ = _
        rw [scalar7_toU64_ofInt_val, Int.emod_emod]
      change (wrapInt .i64 (z.val + (int 1).val) -
        (rangeCardinality (.stepped r) : Int)) % ((2 : Int)^64) = 0
      rw [hc, Int.sub_emod, scalar7_wrap_mod]
      change ((z.val + 1) % ((2 : Int)^64) - (u.val / v.val + 1) % ((2 : Int)^64)) % _ = 0
      rw [Int.add_emod z.val 1, hz, ← Int.add_emod, Int.sub_self, Int.zero_emod]

theorem scalar7_range_count (r : OrdinalRange64) (h : RangeConstructible r) :
    ∃ count : I64, rangeLength r = .ok count ∧ MachineAxisCount r count := by
  cases r with
  | oneTo r => exact ⟨r.stop, rfl, rfl⟩
  | unit r => exact scalar7_unit_length r h
  | stepped r => exact scalar7_step_length r h

theorem scalar7_count_unique {axis : OrdinalRange64} {x y : I64}
    (hx : MachineAxisCount axis x) (hy : MachineAxisCount axis y) : x = y := by
  cases axis with
  | oneTo r => exact hx.trans hy.symm
  | unit r =>
    apply Subtype.ext
    have hxb := scalar7_i64_bounds x
    have hyb := scalar7_i64_bounds y
    change (x.val - (rangeCardinality (.unit r) : Int)) % 18446744073709551616 = 0 at hx
    change (y.val - (rangeCardinality (.unit r) : Int)) % 18446744073709551616 = 0 at hy
    omega
  | stepped r =>
    apply Subtype.ext
    have hxb := scalar7_i64_bounds x
    have hyb := scalar7_i64_bounds y
    change (x.val - (rangeCardinality (.stepped r) : Int)) % 18446744073709551616 = 0 at hx
    change (y.val - (rangeCardinality (.stepped r) : Int)) % 18446744073709551616 = 0 at hy
    omega

theorem scalar7_firstindex_eq (axis : OrdinalRange64) (count : I64)
    (hlen : rangeLength axis = .ok count) : regionRangeFirstindex axis = .ok (int 1) := by
  cases axis with
  | oneTo r =>
    unfold regionRangeFirstindex regionRangeAxis
    rw [hlen]
    rfl
  | unit r =>
    unfold regionRangeFirstindex regionRangeAxis
    rw [hlen]
    rfl
  | stepped r => rfl

theorem scalar7_lastindex_eq (axis : OrdinalRange64) (count : I64)
    (hlen : rangeLength axis = .ok count) : regionRangeLastindex axis = .ok count := by
  unfold regionRangeLastindex regionRangeAxis
  rw [hlen]
  rfl

theorem scalar7_axis_assigned (axis : OrdinalRange64) (index : I64)
    (h : RangeConstructible axis) :
    ∃ answer : Bool, regionRangeAssigned axis index = .ok answer ∧
      (answer = true ↔ DeclaredAxisMember axis index) := by
  rcases scalar7_range_count axis h with ⟨count, hlen, hcount⟩
  refine ⟨decide (1 ≤ index.val ∧ index.val ≤ count.val), ?_, ?_⟩
  · unfold regionRangeAssigned JuliaLean.base.range.isassigned_AbstractRange
    change (do
      let lo ← regionRangeFirstindex axis
      if !JuliaLean.base.int.leSame lo index then return false
      return JuliaLean.base.int.leSame index (← regionRangeLastindex axis)) = _
    rw [scalar7_firstindex_eq axis count hlen, scalar7_lastindex_eq axis count hlen]
    simp only [bind, Except.bind, pure, Except.pure]
    rw [scalar7_leSame, scalar7_leSame]
    change (if !decide (1 ≤ index.val) then .ok false
      else .ok (decide (index.val ≤ count.val))) =
        (.ok (decide (1 ≤ index.val ∧ index.val ≤ count.val)) : RegionResult Bool)
    by_cases hlo : 1 ≤ index.val
    · simp only [hlo, decide_true, Bool.not_true, Bool.false_eq_true, ↓reduceIte, true_and]
    · simp only [hlo, decide_false, Bool.not_false, ↓reduceIte, false_and]
  · constructor
    · intro hb
      have hi := of_decide_eq_true hb
      exact ⟨count, hcount, hi.1, hi.2⟩
    · rintro ⟨other, hother, hlo, hhi⟩
      have hc : other = count := scalar7_count_unique hother hcount
      subst other
      exact decide_eq_true ⟨hlo, hhi⟩

theorem scalar7_assigned_core : ∀ (region : Region64) (indices : CI),
    (∀ axis ∈ region, RangeConstructible axis) → region.length = indices.length →
    ∃ answer : Bool, regionAssigned region indices = .ok answer ∧
      (answer = true ↔ DeclaredRegionMember region indices) := by
  intro region
  induction region with
  | nil =>
    intro indices hdomain hlen
    cases indices with
    | nil => exact ⟨true, rfl, by change (true = true ↔ True); exact ⟨fun _ => trivial, fun _ => rfl⟩⟩
    | cons i is => simp only [List.length_nil, List.length_cons] at hlen; omega
  | cons axis axes ih =>
    intro indices hdomain hlen
    cases indices with
    | nil => simp only [List.length_nil, List.length_cons] at hlen; omega
    | cons index rest =>
      have ha : RangeConstructible axis := hdomain axis (by simp only [List.mem_cons, true_or])
      have hrest : ∀ a ∈ axes, RangeConstructible a := fun a h =>
        hdomain a (List.mem_cons_of_mem axis h)
      have hlens : axes.length = rest.length := by
        simp only [List.length_cons] at hlen
        omega
      rcases scalar7_axis_assigned axis index ha with ⟨headAnswer, hhead, hheadSpec⟩
      rcases ih rest hrest hlens with ⟨tailAnswer, htail, htailSpec⟩
      refine ⟨headAnswer && tailAnswer, ?_, ?_⟩
      · simp only [regionAssigned, hhead, bind, Except.bind]
        cases headAnswer with
        | false => rfl
        | true => exact htail
      · change ((headAnswer && tailAnswer) = true ↔
          DeclaredAxisMember axis index ∧ DeclaredRegionMember axes rest)
        simp only [Bool.and_eq_true, hheadSpec, htailSpec]

theorem Models1G5RegionIsassigned_proven :
    JuliaLean.Proofs.base.multidimensional.Models1Group5.RegionAssignedCorrect := by
  intro region indices hdomain hlen
  exact scalar7_assigned_core region indices hdomain.2 hlen

theorem scalar7_add_val (x y : I64) :
    (JuliaLean.base.int.add x y).val = wrapInt .i64 (x.val + y.val) := by
  simp only [JuliaLean.base.int.add, JuliaLean.base.int.add_int,
    JuliaLean.C.jlAddInt, JuliaLean.C.fromJInt]
  rw [← BitVec.ofInt_add]
  exact (toJInt_ofInt_val .i64) _

theorem scalar7_checkindex (count index : I64) :
    JuliaLean.base.abstractarray.checkindexOneTo count index =
      decide ((index.val - 1) % ((2 : Int)^64) < count.val % ((2 : Int)^64)) := by
  change decide (wrapInt .i64 (index.val - (int 1).val) % ((2 : Int)^64) <
    count.val % ((2 : Int)^64)) = _
  have h1 : (int 1).val = 1 := by decide
  simp only [h1, scalar7_wrap_mod]

theorem scalar7_address_iff (axis : OrdinalRange64) (index count : I64)
    (hc : MachineAxisCount axis count) :
    MachineAxisAddress axis index ↔
      (index.val - 1) % ((2 : Int)^64) < count.val % ((2 : Int)^64) := by
  constructor
  · rintro ⟨other, hother, hi⟩
    have he : other = count := scalar7_count_unique hother hc
    subst other
    exact hi
  · intro hi
    exact ⟨count, hc, hi⟩

theorem scalar7_counts_stops (counts : CI) :
    (counts.map (fun count => OrdinalRange64.oneTo ⟨count⟩)).map rangeLast = counts := by
  induction counts with
  | nil => rfl
  | cons count counts ih => simp only [List.map_cons, rangeLast, ih]

theorem scalar7_axes_counts : ∀ region : Region64,
    (∀ axis ∈ region, RangeConstructible axis) →
    ∃ counts : CI, regionSize region = .ok counts ∧
      regionAxes region = .ok (counts.map (fun count => OrdinalRange64.oneTo ⟨count⟩)) ∧
      Coordinatewise MachineAxisCount region counts := by
  intro region
  induction region with
  | nil => intro h; exact ⟨[], rfl, rfl, trivial⟩
  | cons axis axes ih =>
    intro h
    rcases scalar7_range_count axis (h axis (by simp only [List.mem_cons, true_or])) with
      ⟨count, hlen, hc⟩
    rcases ih (fun a ha => h a (List.mem_cons_of_mem axis ha)) with
      ⟨counts, hsize, haxes, hcounts⟩
    have haxis : regionRangeAxis axis = .ok (.oneTo ⟨count⟩) := by
      unfold regionRangeAxis
      rw [hlen]
      rfl
    unfold regionSize at hsize
    unfold regionAxes at haxes
    refine ⟨count :: counts, ?_, ?_, ⟨hc, hcounts⟩⟩
    · simp only [regionSize, List.mapM_cons, hlen, bind, Except.bind,
        hsize, pure, Except.pure]
    · simp only [regionAxes, List.mapM_cons, haxis, bind, Except.bind,
        haxes, pure, Except.pure, List.map_cons]

theorem scalar7_outer_bounds : ∀ (region : Region64) (counts indices : CI),
    Coordinatewise MachineAxisCount region counts → region.length = indices.length →
    (regionOuterIndicesBounds counts indices = true ↔ MachineRegionAddress region indices) := by
  intro region
  induction region with
  | nil =>
    intro counts indices hc hlen
    cases counts with
    | cons count counts => exact False.elim hc
    | nil =>
      cases indices with
      | nil => change (true = true ↔ True); exact ⟨fun _ => trivial, fun _ => rfl⟩
      | cons index rest => simp only [List.length_nil, List.length_cons] at hlen; omega
  | cons axis axes ih =>
    intro counts indices hc hlen
    cases counts with
    | nil => exact False.elim hc
    | cons count counts =>
      cases indices with
      | nil => simp only [List.length_nil, List.length_cons] at hlen; omega
      | cons index indices =>
        have hlen' : axes.length = indices.length := by
          simp only [List.length_cons] at hlen
          omega
        have ht := ih counts indices hc.2 hlen'
        change ((JuliaLean.base.abstractarray.checkindexOneTo count index &&
            regionOuterIndicesBounds counts indices) = true ↔
          MachineAxisAddress axis index ∧ MachineRegionAddress axes indices)
        rw [Bool.and_eq_true, scalar7_checkindex, decide_eq_true_eq, ht,
          scalar7_address_iff axis index count hc.1]

theorem scalar7_bounds_boolean (region : Region64) (indices : CI)
    (h : ∀ axis ∈ region, RangeConstructible axis) (hlen : region.length = indices.length) :
    ∃ answer : Bool, regionBoundsBoolean region indices = .ok answer ∧
      (answer = true ↔ MachineRegionAddress region indices) := by
  rcases scalar7_axes_counts region h with ⟨counts, hsize, haxes, hc⟩
  refine ⟨regionOuterIndicesBounds counts indices, ?_, scalar7_outer_bounds region counts indices hc hlen⟩
  unfold regionBoundsBoolean
  rw [haxes]
  simp only [bind, Except.bind, pure, Except.pure, scalar7_counts_stops]

theorem scalar7_scalar_bounds (region : Region64) (indices : CI) (answer : Bool)
    (hb : regionBoundsBoolean region indices = .ok answer) :
    regionScalarBounds region indices =
      if answer then .ok () else .error (.jl .boundsError) := by
  have he : regionScalarBounds region indices = (do
      let b ← regionBoundsBoolean region indices
      if !b then throw (.jl .boundsError)) := by
    unfold regionScalarBounds regionBoundsBoolean
    cases regionAxes region <;> rfl
  rw [he, hb]
  cases answer <;> rfl

theorem scalar7_inbounds_coordinate (axis : OrdinalRange64) (index : I64) :
    ∃ coordinate : I64, regionRangeInboundsGet axis index = .ok coordinate ∧
      AddressedCoordinate axis index coordinate := by
  cases axis with
  | oneTo r =>
    refine ⟨index, rfl, ?_⟩
    have hs : (rangeStep (.oneTo r)).val = 1 := by
      change (JuliaLean.base.int.sub (int 1) (int 0)).val = 1
      decide
    have hf : (rangeFirst (.oneTo r)).val = 1 := by
      change (int 1).val = 1
      decide
    unfold AddressedCoordinate
    rw [hf, hs, Int.mul_one]
    have he : index.val - (1 + (index.val - 1)) = 0 := by omega
    rw [he, Int.zero_emod]
  | unit r =>
    refine ⟨JuliaLean.base.int.add r.start (JuliaLean.base.int.sub index (int 1)), rfl, ?_⟩
    have hs : (rangeStep (.unit r)).val = 1 := by
      change (JuliaLean.base.int.sub (int 1) (int 0)).val = 1
      decide
    unfold AddressedCoordinate
    rw [hs, Int.mul_one, scalar7_add_val, sub_int_val]
    change (wrapInt .i64 (r.start.val + wrapInt .i64 (index.val - 1)) -
      (r.start.val + (index.val - 1))) % ((2 : Int)^64) = 0
    rw [Int.sub_emod, scalar7_wrap_mod, Int.add_emod,
      scalar7_wrap_mod, ← Int.add_emod, Int.sub_self, Int.zero_emod]
  | stepped r =>
    refine ⟨r.start + (index - int 1) * r.step, rfl, ?_⟩
    change (wrapInt .i64 (r.start.val +
        wrapInt .i64 (wrapInt .i64 (index.val - (int 1).val) * r.step.val)) -
      (r.start.val + (index.val - 1) * r.step.val)) % ((2 : Int)^64) = 0
    have h1 : (int 1).val = 1 := by decide
    rw [h1, Int.sub_emod, scalar7_wrap_mod, Int.add_emod, scalar7_wrap_mod,
      Int.mul_emod, scalar7_wrap_mod, ← Int.mul_emod, ← Int.add_emod,
      Int.sub_self, Int.zero_emod]

def scalar7_AffineCoordinates : Region64 → CI → CI → Prop
  | [], [], [] => True
  | axis :: axes, index :: indices, coordinate :: coordinates =>
      AddressedCoordinate axis index coordinate ∧ scalar7_AffineCoordinates axes indices coordinates
  | _, _, _ => False

theorem scalar7_inbounds_map : ∀ (region : Region64) (indices : CI),
    region.length = indices.length →
    ∃ coordinates : CI,
      (region.zip indices).mapM (fun (r, i) => regionRangeInboundsGet r i) = .ok coordinates ∧
      scalar7_AffineCoordinates region indices coordinates := by
  intro region
  induction region with
  | nil =>
    intro indices hlen
    cases indices with
    | nil => exact ⟨[], rfl, trivial⟩
    | cons i is => simp only [List.length_nil, List.length_cons] at hlen; omega
  | cons axis axes ih =>
    intro indices hlen
    cases indices with
    | nil => simp only [List.length_nil, List.length_cons] at hlen; omega
    | cons index rest =>
      have hlens : axes.length = rest.length := by
        simp only [List.length_cons] at hlen
        omega
      rcases scalar7_inbounds_coordinate axis index with ⟨coordinate, hhead, hc⟩
      rcases ih rest hlens with ⟨coordinates, htail, hcs⟩
      refine ⟨coordinate :: coordinates, ?_, ⟨hc, hcs⟩⟩
      simp only [List.zip_cons_cons, List.mapM_cons, hhead, htail,
        bind, Except.bind, pure, Except.pure]

theorem scalar7_affine_observe : ∀ (region : Region64) (indices coordinates : CI),
    scalar7_AffineCoordinates region indices coordinates →
    coordinates.length = region.length ∧
      ∀ (k : Nat) (axis : OrdinalRange64) (index : I64),
        region[k]? = some axis → indices[k]? = some index →
        ∃ coordinate : I64, coordinates[k]? = some coordinate ∧ AddressedCoordinate axis index coordinate := by
  intro region
  induction region with
  | nil =>
    intro indices coordinates h
    cases indices <;> cases coordinates <;> try exact False.elim h
    refine ⟨rfl, ?_⟩
    intro k axis index ha hi
    simp only [List.getElem?_nil] at ha
    contradiction
  | cons a as ih =>
    intro indices coordinates h
    cases indices with
    | nil => exact False.elim h
    | cons i is =>
      cases coordinates with
      | nil => exact False.elim h
      | cons c cs =>
        rcases ih is cs h.2 with ⟨hl, hnth⟩
        refine ⟨by simp only [List.length_cons, hl], ?_⟩
        intro k axis index ha hi
        cases k with
        | zero =>
          simp only [List.getElem?_cons_zero, Option.some.injEq] at ha hi
          subst axis
          subst index
          exact ⟨c, rfl, h.1⟩
        | succ k =>
          simp only [List.getElem?_cons_succ] at ha hi ⊢
          exact hnth k axis index ha hi

theorem scalar7_tuple_identity (coordinates : CI) :
    cartesianTuple (cartesianInner (fun x : I64 => (.ok x : RegionResult I64))) coordinates =
      .ok coordinates := by
  unfold cartesianTuple cartesianInner
  induction coordinates with
  | nil => rfl
  | cons coordinate coordinates ih =>
    simp only [List.mapM_cons, ih, bind, Except.bind, pure, Except.pure]

theorem scalar7_scalar_result (region : Region64) (indices : CI) (answer : Bool)
    (hb : regionBoundsBoolean region indices = .ok answer)
    (hlen : region.length = indices.length) :
    ∃ coordinates : CI, scalar7_AffineCoordinates region indices coordinates ∧
      regionScalarGet region indices = if answer then .ok coordinates else .error (.jl .boundsError) := by
  rcases scalar7_inbounds_map region indices hlen with ⟨coordinates, hmap, hgeometry⟩
  refine ⟨coordinates, hgeometry, ?_⟩
  unfold regionScalarGet
  rw [scalar7_scalar_bounds region indices answer hb]
  cases answer with
  | false => rfl
  | true =>
    simp only [↓reduceIte, bind, Except.bind]
    rw [hmap]
    simp only [bind, Except.bind, scalar7_tuple_identity]

theorem Models1G5RegionScalarMachineGeometry_proven :
    JuliaLean.Proofs.base.multidimensional.Models1Group5.RegionScalarAccessMachineGeometry := by
  intro region indices hdomain hlen
  rcases scalar7_bounds_boolean region indices hdomain.2 hlen with ⟨answer, hb, hspec⟩
  rcases scalar7_scalar_result region indices answer hb hlen with ⟨coordinates, hc, hget⟩
  cases answer with
  | false =>
    rw [hget]
    change ¬ MachineRegionAddress region indices
    intro hi
    exact Bool.false_ne_true (hspec.mpr hi)
  | true =>
    rw [hget]
    exact ⟨hspec.mp rfl, scalar7_affine_observe region indices coordinates hc⟩

theorem scalar7_get_default_formula {D : Type} (region : Region64) (indices : CI) (default : D) :
    regionGetDefaultSameRank region indices default = (do
      if ← regionBoundsBoolean region indices then
        Sum.inl <$> regionScalarGet region indices
      else return .inr default) := by
  cases indices <;> rfl

theorem Models1G5RegionGetDefault_proven :
    JuliaLean.Proofs.base.multidimensional.Models1Group5.RegionGetDefaultCorrect := by
  intro D region indices default hdomain hlen
  rcases scalar7_bounds_boolean region indices hdomain.2 hlen with ⟨answer, hb, hspec⟩
  rcases scalar7_scalar_result region indices answer hb hlen with ⟨coordinates, hc, hget⟩
  rw [scalar7_get_default_formula, hb]
  cases answer with
  | false =>
    change default = default ∧ ¬ MachineRegionAddress region indices
    exact ⟨rfl, fun hi => Bool.false_ne_true (hspec.mpr hi)⟩
  | true =>
    simp only [↓reduceIte, bind, Except.bind]
    rw [hget]
    exact ⟨hspec.mp rfl, scalar7_affine_observe region indices coordinates hc⟩

