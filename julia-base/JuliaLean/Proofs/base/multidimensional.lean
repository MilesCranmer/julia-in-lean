private theorem regionAllResult_singleton {E S O T : Type}
    (val : RegionTruth O) (s : S) :
    ((regionAllResult
      (singletonRegionAllOps (E := E) (S := S) (O := O) (T := T))
      (.inl [val])).run).run s = some (Except.ok val, s) := by
  cases val with
  | bool b => cases b <;> rfl
  | other o => rfl
  | missing =>
      unfold regionAllResult regionAllTupleTwo
      simp only [regionTruthHasOther, singletonRegionAllOps, List.any_cons, List.any_nil, Bool.or_false,
