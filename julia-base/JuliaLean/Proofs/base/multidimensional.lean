def RegionRangeConstructorCorrect : Prop :=
  ∀ ranges : Region64, RegionDomain ranges →
    match regionFromRanges ranges with
    | .ok result =>
        RegionDomain result ∧ ConversionContracts.SameRegionAxisValues ranges result ∧
        ∀ (k : Nat) (before after : OrdinalRange64),
          ranges[k]? = some before → result[k]? = some after →
          ConversionContracts.SameStoredTag before after
    | .error _ => False

/-- Only the tagged tuple's constructibility and actual input range invariants are required.
The BigInt-value interface is unbounded; inexact field conversion remains in the outcome. -/
def MixedRegionDomain (arguments : List DimensionArg64) : Prop :=
  TupleFits arguments ∧ ∀ argument ∈ arguments,
    match argument with
    | .size _ => True
    | .ordinal range => RangeConstructible range

def MixedDimensionsFit (arguments : List DimensionArg64) : Prop :=
  ∀ argument ∈ arguments,
    match argument with
    | .size size => max 0 size.value ≤ IntTy.max .i64
    | .ordinal _ => True

/-- The expected axis is specified by its sequence, cardinality and public range type.
Integer sizes clip at zero before Int64 conversion; ordinal inputs keep their complete
mathematical sequence, with AbstractUnitRange reconstruction producing a UnitRange. -/
def MixedDimensionGeometry (argument : DimensionArg64) (result : OrdinalRange64) : Prop :=
  match argument with
  | .size size =>
    (∃ stop : I64, result = .oneTo ⟨stop⟩ ∧ stop.val = max 0 size.value) ∧
      rangeCardinality result = (max 0 size.value).toNat
  | .ordinal input =>
    ConversionContracts.SameAxisValues input result ∧
      match input, result with
      | .oneTo _, .unit _ | .unit _, .unit _ | .stepped _, .stepped _ => True
      | _, _ => False

/-- The represented mixed constructor preserves the input coordinate sequences and expected
range families. The only conversion failure in its valid represented domain is InexactError
