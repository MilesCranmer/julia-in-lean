        le_int1_int1, Bool.and_self, Bool.not_true, Bool.false_eq_true, ↓reduceIte,
        add_int1_int1, regionTruthIdentity, JuliaLean.base.operators.identity,
        regionTruthIsMissing, JuliaLean.base.essentials.ismissing,
        JuliaLean.base.multidimensional.Models1Group6.maskRequireBool,
        Bind.bind, ExceptT.bind, ExceptT.mk, Pure.pure, ExceptT.pure]
      rw [regionAllTupleLoop.loop]
      simp only [List.length_singleton, Int.natCast_one,
        le_int2_int1, Bool.and_false, Bool.not_false, ↓reduceIte]
      rfl

