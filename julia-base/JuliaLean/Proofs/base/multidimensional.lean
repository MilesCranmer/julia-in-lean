structure RealEqualityEvent (R V E : Type) where
  value : R
  literal : I64
  reply : AccessResult E V

def observeRealEqualityOps {S E R V : Type} (ops : RealBoolEqualityOps (AccessEffects S E) R V) :
    RealBoolEqualityOps (AccessEffects (S × List (S × S × RealEqualityEvent R V E)) E) R V where
  equal := fun value literal => observeAccessAction (ops.equal value literal) (fun reply => ⟨value, literal, reply⟩)

/-- Exact short-circuit protocol for every Real subtype and arbitrary equality
