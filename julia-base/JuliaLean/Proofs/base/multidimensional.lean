/-- The wrapper's invariant uses mathematical modular addition to identify
its delegated scalar argument. Positive-rank calls must satisfy the independent
full SIMD trace invariant; empty parents have no observed effects. The unused
middle state field has no role in this specification. -/
def PartitionSimdObservation {E S R First Subscript Value Output : Type}
    (check : Bool) (parent : List R) (skip n : I64) (outer : CI) (initial : S)
    (observed : Option (Except (Sum Error E) (Sum CI Output) ×
      (S × List (S × S × SimdIndexEvent E R First Subscript Value Output)))) : Prop :=
  match observed with
  | none => True
  | some (result, (final, records)) =>
      match parent with
      | [] => result = .ok (.inl []) ∧ records = [] ∧ final = initial
      | head :: _ =>
          match result with
          | .ok (.inl _) => False
          | .ok (.inr value) =>
              SimdIndexObservation check head outer (int (n.val + skip.val)) initial
                (some (.ok value, (final, records)))
          | .error error =>
              SimdIndexObservation check head outer (int (n.val + skip.val)) initial
                (some (.error error, (final, records)))

inductive PartitionSimdEvent (E R First Subscript Value Output : Type) where
  | region (event : SimdIndexEvent E R First Subscript Value Output)
  | selected (check : Bool) (parent : List R) (outer : CI) (inner : I64)
      (reply : Except (Sum Error E) Output)

def observePartitionSimdOps {E S R First Subscript Value Output : Type}
    (ops : PartitionSimdOps (ConstructorObservationM E S) R First Subscript Value Output) :
    PartitionSimdOps
      (ConstructorObservationM E
        (S × List (S × S × PartitionSimdEvent E R First Subscript Value Output)))
      R First Subscript Value Output where
  region := {
    firstindex := fun range => observeConstructorAction (ops.region.firstindex range)
      (fun reply => .region (.firstindex range reply))
    add := fun inner first => observeConstructorAction (ops.region.add inner first)
      (fun reply => .region (.add inner first reply))
    getindex := fun check range index => observeConstructorAction (ops.region.getindex check range index)
      (fun reply => .region (.getindex check range index reply))
    construct := fun value outer => observeConstructorAction (ops.region.construct value outer)
      (fun reply => .region (.construct value outer reply)) }
  selected := fun check parent outer inner => (ops.selected check parent outer inner).map fun action =>
    observeConstructorAction action (.selected check parent outer inner)

/-- Selected overrides are observed as exactly one call with all original
arguments and modularly advanced scalar. Without selection, every observation
comes from the actual complete region body and satisfies its independent
four-stage dataflow, bounds, error and state invariant. -/
def PartitionSimdDispatchObservation {E S R First Subscript Value Output : Type}
    (ops : PartitionSimdOps (ConstructorObservationM E S) R First Subscript Value Output)
    (check : Bool) (parent : List R) (skip n : I64) (outer : CI) (initial : S)
    (observed : Option (Except (Sum Error E) (Sum CI Output) ×
      (S × List (S × S × PartitionSimdEvent E R First Subscript Value Output)))) : Prop :=
  match observed with
  | none => True
  | some (result, (final, records)) =>
      match parent with
      | [] => result = .ok (.inl []) ∧ records = [] ∧ final = initial
      | _ :: _ =>
          match ops.selected check parent outer (int (n.val + skip.val)) with
          | some _ => ∃ reply,
              records = [(initial, final, .selected check parent outer (int (n.val + skip.val)) reply)] ∧
              result = reply.map Sum.inr
          | none =>
              let regionRecords := records.filterMap fun record =>
                match record.2.2 with
                | .region event => some (record.1, record.2.1, event)
                | .selected _ _ _ _ _ => none
              records = regionRecords.map (fun record => (record.1, record.2.1, .region record.2.2)) ∧
              PartitionSimdObservation check parent skip n outer initial
                (some (result, (final, regionRecords)))

