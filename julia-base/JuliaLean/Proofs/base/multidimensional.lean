def pr_loopIndex {Axis TypeTag : Type}
    (total remaining : List (MaskAxisField Axis TypeTag)) : I64 :=
  JInt.wrap .i64 (((total.length - remaining.length : Nat) : Int) + 1)

theorem pr_natInt_val (n : Nat) (h : (n : Int) ≤ IntTy.max .i64) :
    (int (n : Int)).val = (n : Int) := by
  change wrapInt .i64 (n : Int) = (n : Int)
  apply wrapInt_of_inRange
  constructor
  · have hmin : IntTy.min .i64 ≤ 0 := by decide
    omega
  · exact h

theorem pr_loop_guard_cons {Axis TypeTag : Type}
    (total : List (MaskAxisField Axis TypeTag)) (field : MaskAxisField Axis TypeTag)
    (rest : List (MaskAxisField Axis TypeTag))
    (ht : (total.length : Int) ≤ IntTy.max .i64)
    (hr : (field :: rest).length ≤ total.length) :
    (JuliaLean.base.int.le (int 1) (pr_loopIndex total (field :: rest)) &&
      JuliaLean.base.int.le (pr_loopIndex total (field :: rest)) (int (total.length : Int))) = true := by
  have hi : (pr_loopIndex total (field :: rest)).val =
      (((total.length - (field :: rest).length : Nat) : Int) + 1) := by
    change wrapInt .i64 (((total.length - (field :: rest).length : Nat) : Int) + 1) = _
    apply wrapInt_of_inRange
    constructor
    · have : IntTy.min .i64 ≤ 0 := by decide
      omega
    · simp only [List.length_cons] at hr ⊢
      omega
  rw [JuliaLean.Proofs.base.int.le_eq, JuliaLean.Proofs.base.int.le_eq, pr_natInt_val _ ht, hi]
  have one : (int 1).val = 1 := by decide
  rw [one]
  have hlow : 1 ≤ (((total.length - (field :: rest).length : Nat) : Int) + 1) := by omega
  have hhigh : (((total.length - (field :: rest).length : Nat) : Int) + 1) ≤
      (total.length : Int) := by simp only [List.length_cons] at hr ⊢; omega
  simp only [hlow, hhigh, decide_true, Bool.and_self]

theorem pr_loop_guard_nil {Axis TypeTag : Type}
    (total : List (MaskAxisField Axis TypeTag))
    (ht : (total.length : Int) ≤ IntTy.max .i64) :
    (JuliaLean.base.int.le (int 1) (pr_loopIndex total []) &&
      JuliaLean.base.int.le (pr_loopIndex total []) (int (total.length : Int))) = false := by
  rw [JuliaLean.Proofs.base.int.le_eq, JuliaLean.Proofs.base.int.le_eq, pr_natInt_val _ ht]
  have one : (int 1).val = 1 := by decide
  rw [one]
  by_cases below : (total.length : Int) < IntTy.max .i64
  · have hi : (pr_loopIndex total []).val = (total.length : Int) + 1 := by
      change wrapInt .i64 _ = _
      simp only [List.length_nil, Nat.sub_zero]
      apply wrapInt_of_inRange
      constructor
      · have : IntTy.min .i64 ≤ 0 := by decide
        omega
      · omega
    rw [hi]
    have hnot : ¬ ((total.length : Int) + 1 ≤ (total.length : Int)) := by omega
    simp only [hnot, decide_false, Bool.and_false]
  · have top : (total.length : Int) = IntTy.max .i64 := by omega
    have hi : (pr_loopIndex total []).val = IntTy.min .i64 := by
      change wrapInt .i64 _ = _
      simp only [List.length_nil, Nat.sub_zero, top]
      decide
    rw [hi]
    have hnot : ¬ (1 ≤ IntTy.min .i64) := by decide
    simp only [hnot, decide_false, Bool.false_and]

theorem pr_loop_next {Axis TypeTag : Type}
    (total : List (MaskAxisField Axis TypeTag)) (field : MaskAxisField Axis TypeTag)
    (rest : List (MaskAxisField Axis TypeTag))
    (hr : (field :: rest).length ≤ total.length) :
    JuliaLean.base.int.add (pr_loopIndex total (field :: rest)) (int 1) =
      pr_loopIndex total rest := by
  apply Subtype.ext
  rw [JuliaLean.base.int.add, JuliaLean.Proofs.base.int.add_int_val]
  have one : (int 1).val = 1 := by decide
  rw [one]
  change wrapInt .i64 (wrapInt .i64 _ + 1) = wrapInt .i64 _
  rw [JuliaLean.Proofs.base.int.wrapInt_add_left]
  congr 1
  simp only [List.length_cons] at hr ⊢
  omega

theorem pr_loop_recursive {m : Type → Type} [Monad m] [MonadExceptOf Error m]
    {Axis TypeTag Other : Type}
    (runtime : MaskAxesRuntime m Axis TypeTag Other)
    (predicate : MaskAxisField Axis TypeTag → m (MaskTruth Other))
    (total remaining : List (MaskAxisField Axis TypeTag)) (anymissing : Bool)
    (ht : (total.length : Int) ≤ IntTy.max .i64)
    (hr : remaining.length ≤ total.length) :
    maskAllTupleLoop.loop runtime predicate total anymissing (pr_loopIndex total remaining) remaining =
      maskAllTupleRecursive runtime predicate anymissing remaining := by
  induction remaining generalizing anymissing with
  | nil =>
    simp only [maskAllTupleLoop.loop, pr_loop_guard_nil total ht,
      Bool.false_eq_true, if_false, maskAllTupleRecursive]
  | cons field rest ih =>
    have ih' : ∀ flag, maskAllTupleLoop.loop runtime predicate total flag
        (pr_loopIndex total rest) rest = maskAllTupleRecursive runtime predicate flag rest :=
      fun flag => ih flag (by simp only [List.length_cons] at hr; omega)
    simp only [maskAllTupleLoop.loop, pr_loop_guard_cons total field rest ht hr,
      Bool.not_true, Bool.false_eq_true, if_false, pr_loop_next total field rest hr,
      ih', maskAllTupleRecursive]

theorem pr_allLoop_recursive {m : Type → Type} [Monad m] [MonadExceptOf Error m]
    {Axis TypeTag Other : Type}
    (runtime : MaskAxesRuntime m Axis TypeTag Other)
    (predicate : MaskAxisField Axis TypeTag → m (MaskTruth Other))
    (fields : List (MaskAxisField Axis TypeTag))
    (ht : (fields.length : Int) ≤ IntTy.max .i64) :
    maskAllTupleLoop runtime predicate fields = maskAllTupleRecursive runtime predicate false fields := by
  have hi : pr_loopIndex fields fields = int 1 := by
    simp only [pr_loopIndex, Nat.sub_self, Int.natCast_zero, Int.zero_add]
    rfl
  have h := pr_loop_recursive runtime predicate fields fields false ht (Nat.le_refl _)
  rw [hi] at h
  exact h

theorem pr_all_recursive {m : Type → Type} [Monad m] [MonadExceptOf Error m]
    {Axis TypeTag Other : Type} [DecidableEq TypeTag]
    (runtime : MaskAxesRuntime m Axis TypeTag Other)
    (predicate : MaskAxisField Axis TypeTag → m (MaskTruth Other))
    (fields : List (MaskAxisField Axis TypeTag))
    (ht : (fields.length : Int) ≤ IntTy.max .i64) :
    maskAllTuple runtime predicate fields = maskAllTupleRecursive runtime predicate false fields := by
  unfold maskAllTuple
  split
  · exact pr_allLoop_recursive runtime predicate fields ht
  · rfl


def pr_axesRecursive {m : Type → Type} [Monad m] [MonadExceptOf Error m]
    {Axis TypeTag Other : Type}
    (runtime : MaskAxesRuntime m Axis TypeTag Other) :
    List (MaskAxisField Axis TypeTag) → List (MaskAxisField Axis TypeTag) → m (Option Bool)
  | [], axes => maskAllTupleRecursive runtime
      (fun axis => runtime.equal (.observed axis) maskOneToOne) false axes
  | _ :: _, [] => throw .boundsError
  | axis :: rest, other :: axes => do
      let equal ← runtime.equal (.observed axis) (.observed other)
      if ← maskRequireBool equal then pr_axesRecursive runtime rest axes
      else return some false

theorem pr_axes_recursive {m : Type → Type} [Monad m] [MonadExceptOf Error m]
    {Axis TypeTag Other : Type} [DecidableEq TypeTag]
    (runtime : MaskAxesRuntime m Axis TypeTag Other)
    (inds axes : List (MaskAxisField Axis TypeTag))
    (ht : (axes.length : Int) ≤ IntTy.max .i64) :
    checkBooleanAxesRawAux runtime inds axes = pr_axesRecursive runtime inds axes := by
  induction inds generalizing axes with
  | nil => exact pr_all_recursive runtime _ axes ht
  | cons axis rest ih =>
    cases axes with
    | nil => rfl
    | cons other axes =>
      have ht' : (axes.length : Int) ≤ IntTy.max .i64 := by
        simp only [List.length_cons] at ht
        omega
      simp only [checkBooleanAxesRawAux, pr_axesRecursive, ih axes ht']

end Models1Group6.Batch9



