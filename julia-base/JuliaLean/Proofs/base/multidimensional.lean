/-- Every coordinate tuple is an actual finite Julia tuple. -/
def ShowTupleArity (index : CI) : Prop :=
  (index.length : Int) ≤ IntTy.max .i64

/-- Arbitrary thrown Julia values can be represented by E. State and partial
output survive errors; none represents genuine nontermination. -/
abbrev ShowObservationM (E S : Type) := ExceptT E (StateT S Option)

/-- Observable display requests, retaining the original IO reference. -/
inductive ShowCall (IORef : Type) where
  | text (io : IORef) (value : String)
  | integer (io : IORef) (value : I64)
  | join (io : IORef) (index : CI) (delimiter : String)

structure ShowEvent (E IORef V : Type) where
  call : ShowCall IORef
  result : Except E V

abbrev ShowRecord (E S IORef V : Type) := S × S × ShowEvent E IORef V

/-- Record an actual operation's result and before/after states. No assumption
is made about what a print writes, returns, mutates, or throws. -/
def observeShowAction {E S IORef V : Type}
    (action : ShowObservationM E S V) (call : ShowCall IORef) :
    ShowObservationM E (S × List (ShowRecord E S IORef V)) V :=
  ExceptT.mk fun (state, events) =>
    match action.run state with
    | none => none
    | some (result, state') =>
        some (result, (state', events ++ [(state, state', ⟨call, result⟩)]))

/-- Instrument the existing dispatch interface; default join still executes
its concrete tuple loop. Custom operations cannot alter the observer's log. -/
def observeShowOps {E S IORef V : Type}
    (ops : ShowOps (ShowObservationM E S) IORef V) :
    ShowOps (ShowObservationM E (S × List (ShowRecord E S IORef V))) IORef V where
  printString := fun io value =>
    observeShowAction (ops.printString io value) (.text io value)
  printInteger := fun io value =>
    observeShowAction (ops.printInteger io value) (.integer io value)
  selectedJoin := fun io index delimiter =>
    (ops.selectedJoin io index delimiter).map fun action =>
      observeShowAction action (.join io index delimiter)

/-- Independent textual-layout specification by mathematical coordinate
position. No first-flag traversal or join model is used in this expectation.
The selected custom-join path has one join request between the delimiters. -/
def expectedShowCalls {IORef : Type} (customJoin : Bool) (io : IORef) (index : CI) :
    List (ShowCall IORef) :=
  if customJoin then
    [.text io "CartesianIndex(", .join io index ", ", .text io ")"]
  else
    [.text io "CartesianIndex("] ++
    index.zipIdx.flatMap (fun (value, position) =>
      if position = 0 then [.integer io value]
      else [.text io ", ", .integer io value]) ++
    [.text io ")"]

/-- Caller state changes consist exactly of the reached dispatch effects,
including partial output immediately before a throw. -/
def ShowStateThread {S Event : Type} (initial final : S)
    (records : List (S × S × Event)) : Prop :=
  (match records.head? with
   | none => final = initial
   | some record => record.1 = initial) ∧
  (∀ (record : S × S × Event), records.getLast? = some record → final = record.2.1) ∧
  (∀ (k : Nat) (left right : S × S × Event),
    records[k]? = some left → records[k + 1]? = some right → left.2.1 = right.1)

/-- Display requests form an ordered prefix of the documented representation
on the original IO object. Success completes the representation and returns
the final closing print's actual value. Failure is exactly a reached call's
exception, with no subsequent call and no rollback of its mutations. -/
def ShowObservation {E S IORef V : Type}
    (expected : List (ShowCall IORef)) (io : IORef) (initial : S)
    (outcome : Option (Except E V × (S × List (ShowRecord E S IORef V)))) : Prop :=
  match outcome with
  | none => True
  | some (result, (final, records)) =>
      let events := records.map (fun record => record.2.2)
      let calls := events.map (fun event => event.call)
      ShowStateThread initial final records ∧
      (∃ remaining, calls ++ remaining = expected) ∧
      (∀ (k : Nat) (event : ShowEvent E IORef V), events[k]? = some event →
        ∀ error : E, event.result = .error error →
          k + 1 = events.length ∧ result = .error error) ∧
      match result with
      | .ok value =>
          calls = expected ∧
          ∃ before, events = before ++ [⟨.text io ")", .ok value⟩]
      | .error error =>
          ∃ before call, events = before ++ [⟨call, .error error⟩]

/-- Full IO-domain display invariant, including arbitrary custom IO dispatch,
arbitrary returned/thrown values, shared-state mutation, and partial output.
On the Base join path the calls describe exactly the ordered comma-separated
coordinate sequence between CartesianIndex delimiters; a selected custom join
is invoked once with the whole stored coordinate tuple. No law about print or
join is assumed, and IO identity never comes from a print's return value.
Source: base/multidimensional.jl:94-98; base/strings/io.jl:308-317,346-354;
doc/src/manual/types.md:1512-1517,1657-1660. -/
def CartesianShowObservationsCorrect : Prop :=
  ∀ (E S IORef V : Type)
    (ops : ShowOps (ShowObservationM E S) IORef V)
    (io : IORef) (index : CI) (state : S), ShowTupleArity index →
    let expected := expectedShowCalls (ops.selectedJoin io index ", ").isSome io index
    let observed := observeShowOps ops
    ShowObservation expected io state ((showCartesianClosed observed io index).run (state, []))

