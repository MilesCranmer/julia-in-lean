  cases axis <;> rfl

theorem ctor7_regionHasOffset (ranges : Region64) :
    regionHasOffsetAxes ranges = .ok false := by
  induction ranges with
  | nil => rfl
  | cons axis axes ih =>
    simp only [regionHasOffsetAxes, ctor7_rangeHasOffset]
    exact ih

theorem Models1G5RegionOffsetAxes_proven : JuliaLean.Proofs.base.multidimensional.Models1Group5.ConversionContracts.BuiltInRegionOffsetAxes := by
  intro ranges h
  exact ctor7_regionHasOffset ranges

theorem Models1G5RegionRangeConstructor_proven : JuliaLean.Proofs.base.multidimensional.Models1Group5.RegionRangeConstructorCorrect := by
