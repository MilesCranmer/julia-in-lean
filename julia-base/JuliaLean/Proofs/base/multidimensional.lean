namespace JuliaLean.Proofs.base.multidimensional.Models2Group3
open JuliaLean JuliaLean.base.multidimensional
open JuliaLean.base.multidimensional.Models1Group6
open JuliaLean.base.multidimensional.Models2Group3

/-- Actual Julia tuple arity, without restricting coordinate magnitudes. -/
def TupleArity {α : Type} (xs : List α) : Prop :=
  (xs.length : Int) ≤ IntTy.max .i64

/-- Nontermination, return, and throw are distinct. State survives exceptions. -/
abbrev ConstructorObservationM (Extra S : Type) :=
  ExceptT (Sum Error Extra) (StateT S Option)

/-- The model's built-in Error exceptions inject into the left alternative;
custom operations may throw arbitrary Extra values through the right one.
Catching a built-in error never intercepts a custom thrown value. -/
local instance constructorObservationError {Extra S : Type} :
    MonadExceptOf Error (ConstructorObservationM Extra S) where
  throw error := ExceptT.mk fun state => some (.error (.inl error), state)
  tryCatch action handler := ExceptT.mk fun state =>
    match action.run state with
    | none => none
    | some (.ok value, state') => some (.ok value, state')
    | some (.error (.inl error), state') => (handler error).run state'
    | some (.error (.inr error), state') => some (.error (.inr error), state')

/-- Specification observations of reached dispatch/memory calls. The original
arguments and actual returns are retained, with no correctness laws. -/
inductive ConstructorEvent (Extra B P C O : Type) where
  | custom (value : C) (result : Except (Sum Error Extra) (Sum I64 O))
  | size (reference : B) (result : Except (Sum Error Extra) (JInt .i32))
  | data (reference : B) (result : Except (Sum Error Extra) P)
  | limb (pointer : P) (result : Except (Sum Error Extra) (JInt .u64))
  | tupleConvert (xs : List (MixedInteger B C))
      (result : Except (Sum Error Extra) (Sum (List (Sum I64 O)) O))
  | innerConstructor (rank : I64) (xs : List (MixedInteger B C)) (result : Except (Sum Error Extra) (Sum CI O))
  | tupleConstructor (xs : List (MixedInteger B C)) (result : Except (Sum Error Extra) (Sum CI O))

/-- Before/after state snapshots and a call event, used only in specifications. -/
abbrev ConstructorRecord (Extra S B P C O : Type) := S × S × ConstructorEvent Extra B P C O

/-- Instrument an arbitrary action without changing its return, exception,
or mutation. Nontermination has no completed call observation. -/
def observeConstructorAction {Extra S Event α : Type}
    (action : ConstructorObservationM Extra S α) (event : Except (Sum Error Extra) α → Event) :
    ConstructorObservationM Extra (S × List (S × S × Event)) α :=
  ExceptT.mk fun (state, events) =>
    match action.run state with
    | none => none
    | some (result, state') =>
        some (result, (state', events ++ [(state, state', event result)]))


theorem observeConstructorAction_run {Extra S Event A : Type}
    (action : Models2Group3.ConstructorObservationM Extra S A)
    (event : Except (Sum Error Extra) A → Event)
    (state : S) (events : List (S × S × Event)) :
    (Models2Group3.observeConstructorAction action event).run (state, events) =
      match action.run state with
      | none => none
      | some (result, state') =>
          some (result, (state', events ++ [(state, state', event result)])) := rfl

theorem observeConstructorAction_bind_run {Extra S Event A B : Type}
    (action : Models2Group3.ConstructorObservationM Extra S A)
    (event : Except (Sum Error Extra) A → Event)
    (next : A → Models2Group3.ConstructorObservationM Extra (S × List (S × S × Event)) B)
    (state : S) (events : List (S × S × Event)) :
    (Bind.bind (Models2Group3.observeConstructorAction action event) next).run (state, events) =
      match action.run state with
      | none => none
      | some (.error err, state') =>
          some (.error err, (state', events ++ [(state, state', event (.error err))]))
      | some (.ok val, state') =>
          (next val).run (state', events ++ [(state, state', event (.ok val))]) := by
  simp only [Models2Group3.observeConstructorAction, ExceptT.run, ExceptT.mk, Bind.bind,
    ExceptT.bind, ExceptT.bindCont, StateT.bind, Option.bind]
  cases action state with
  | none => rfl
  | some p => rcases p with ⟨res, s'⟩; cases res <;> rfl

