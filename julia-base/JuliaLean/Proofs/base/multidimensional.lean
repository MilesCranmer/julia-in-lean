inductive AtomicWrapperEvent (E Memory Pointer Element Value Expected Operation Output B P C O : Type) where
  | length (memory : Memory) (result : Except (Sum Error E) I64)
  | reference (memory : Memory) (index : I64)
      (result : Except (Sum Error E) (JuliaLean.base.genericmemory.GenericMemoryRef Memory Pointer))
  | convert (value : Value) (result : Except (Sum Error E) Element)
  | primitive (arguments : AtomicPrimitiveArguments Memory Pointer Element Value Expected Operation)
      (result : Except (Sum Error E) Output)
  | bigSize (reference : B) (result : Except (Sum Error E) (JInt .i32))
  | bigData (reference : B) (result : Except (Sum Error E) P)
  | bigLimb (pointer : P) (result : Except (Sum Error E) (JInt .u64))
  | mixed (memory : Memory) (indices : List (Models1Group6.MixedIndex B C))
      (result : Except (Sum Error E) (Sum CI O))
  | integers (memory : Memory) (indices : List (Models1Group6.MixedInteger B C))
      (result : Except (Sum Error E) (Sum CI O))
  | construct (argument : O) (result : Except (Sum Error E) (AtomicWrapperIndex O))
  | linearize (memory : Memory) (argument : O) (result : Except (Sum Error E) (AtomicWrapperIndex O))
  | other (bounds : Bool) (memory : Memory) (request : Models1Group6.AtomicRequest Value Expected Operation)
      (argument : O) (result : Except (Sum Error E) Output)

def observeAtomicAction {E S Event A : Type} (action : AtomicObservationM E S A)
    (event : Except (Sum Error E) A → Event) : AtomicObservationM E (S × List (S × S × Event)) A :=
  ExceptT.mk fun (state, events) =>
    match action.run state with
    | none => none
    | some (result, state') => some (result, (state', events ++ [(state, state', event result)]))

def observeAtomicOps {E S Memory Pointer Element Value Expected Operation Output B P C O : Type}
    (ops : AtomicWrapperOps (AtomicObservationM E S) Memory Pointer Element Value Expected Operation Output B P C O) :
    AtomicWrapperOps
      (AtomicObservationM E (S × List (S × S × AtomicWrapperEvent E Memory Pointer Element Value Expected Operation Output B P C O)))
      Memory Pointer Element Value Expected Operation Output B P C O where
  scalar := {
    readLengthField := fun memory => observeAtomicAction (ops.scalar.readLengthField memory) (.length memory)
    memoryrefAt := fun memory index => observeAtomicAction (ops.scalar.memoryrefAt memory index) (.reference memory index)
    castElement := ops.scalar.castElement
    convertElement := fun value => observeAtomicAction (ops.scalar.convertElement value) (.convert value)
    memoryrefGet := fun reference order bounds =>
      observeAtomicAction (ops.scalar.memoryrefGet reference order bounds) (.primitive (.get reference order bounds))
    memoryrefSet := fun reference value order bounds =>
      observeAtomicAction (ops.scalar.memoryrefSet reference value order bounds) (.primitive (.set reference value order bounds))
    memoryrefSetOnce := fun reference value success failure bounds =>
      observeAtomicAction (ops.scalar.memoryrefSetOnce reference value success failure bounds)
        (.primitive (.once reference value success failure bounds))
    memoryrefModify := fun reference operation value order bounds =>
      observeAtomicAction (ops.scalar.memoryrefModify reference operation value order bounds)
        (.primitive (.modify reference operation value order bounds))
    memoryrefSwap := fun reference value order bounds =>
      observeAtomicAction (ops.scalar.memoryrefSwap reference value order bounds)
        (.primitive (.swap reference value order bounds))
    memoryrefReplace := fun reference expected desired success failure bounds =>
      observeAtomicAction (ops.scalar.memoryrefReplace reference expected desired success failure bounds)
        (.primitive (.replace reference expected desired success failure bounds)) }
  bigReads := {
    readSize := fun reference => observeAtomicAction (ops.bigReads.readSize reference) (.bigSize reference)
    readData := fun reference => observeAtomicAction (ops.bigReads.readData reference) (.bigData reference)
    loadLimb := fun pointer => observeAtomicAction (ops.bigReads.loadLimb pointer) (.bigLimb pointer) }
  mixedToIndices := fun memory indices => observeAtomicAction (ops.mixedToIndices memory indices) (.mixed memory indices)
  integerToIndices := fun memory indices => observeAtomicAction (ops.integerToIndices memory indices) (.integers memory indices)
  constructOther := fun argument => observeAtomicAction (ops.constructOther argument) (.construct argument)
  linearizeOther := fun memory argument => observeAtomicAction (ops.linearizeOther memory argument) (.linearize memory argument)
  callOther := fun bounds memory request argument =>
    observeAtomicAction (ops.callOther bounds memory request argument) (.other bounds memory request argument)

inductive AtomicWrapperEntry (B C : Type) where
  | mixed (indices : List (Models1Group6.MixedIndex B C))
  | integers (indices : List (Models1Group6.MixedInteger B C))
  | cartesian (coordinates : CI)

def AtomicWrapperConstructible {B C : Type} : AtomicWrapperEntry B C → Prop
  | .integers indices => (indices.length : Int) ≤ IntTy.max .i64
  | .cartesian coordinates => (coordinates.length : Int) ≤ IntTy.max .i64
  | .mixed indices => (indices.length : Int) ≤ IntTy.max .i64 ∧
      ∀ coordinates, Models1Group6.MixedIndex.cartesian coordinates ∈ indices →
        (coordinates.length : Int) ≤ IntTy.max .i64

def runAtomicWrapper {m : Type → Type} [Monad m] [MonadExceptOf Error m]
    {Memory Pointer Element Value Expected Operation Output B P C O : Type}
    (entry : AtomicWrapperEntry B C)
    (ops : AtomicWrapperOps m Memory Pointer Element Value Expected Operation Output B P C O)
    (memoryType : JuliaLean.base.genericmemory.GenericMemoryType) (bounds : Bool) (memory : Memory)
    (request : Models1Group6.AtomicRequest Value Expected Operation) : m Output :=
  match entry with
  | .mixed indices => JuliaLean.base.multidimensional.Models2Group3.atomicMixed ops memoryType bounds memory request indices
  | .integers indices => atomicIntegers ops memoryType bounds memory request indices
  | .cartesian coordinates => atomicCartesian ops.scalar memoryType bounds memory request coordinates

def atomicWrapperEventError {E M P El V Ex Op Out B BP C O : Type} :
    AtomicWrapperEvent E M P El V Ex Op Out B BP C O → Option (Sum Error E)
  | .length _ (.error error) | .reference _ _ (.error error) | .convert _ (.error error)
  | .primitive _ (.error error) | .bigSize _ (.error error) | .bigData _ (.error error)
  | .bigLimb _ (.error error) | .mixed _ _ (.error error) | .integers _ _ (.error error)
  | .construct _ (.error error) | .linearize _ _ (.error error) | .other _ _ _ _ (.error error) => some error
  | _ => none

def atomicWrapperReturn {E M P El V Ex Op Out B BP C O : Type} :
    AtomicWrapperEvent E M P El V Ex Op Out B BP C O → Option (Except (Sum Error E) Out)
  | .primitive _ result | .other _ _ _ _ result => some result
  | _ => none

def atomicWrapperReferences {E M P El V Ex Op Out B BP C O : Type}
    (events : List (AtomicWrapperEvent E M P El V Ex Op Out B BP C O)) :=
  events.filterMap fun event => match event with
    | .reference memory index result => some (memory, index, result)
    | _ => none

def atomicWrapperConversions {E M P El V Ex Op Out B BP C O : Type}
    (events : List (AtomicWrapperEvent E M P El V Ex Op Out B BP C O)) :=
  events.filterMap fun event => match event with | .convert value result => some (value, result) | _ => none

/-- Each stored element comes from either the primitive isa cast or the
actual completed conversion of the requested value, after memoryref creation. -/
def AtomicElementOrigin {E M P El V Ex Op Out B BP C O : Type}
    (cast : V → Option El) (events : List (AtomicWrapperEvent E M P El V Ex Op Out B BP C O))
    (original : V) (stored : El) : Prop :=
  cast original = some stored ∨
    (cast original = none ∧ .convert original (.ok stored) ∈ events)

/-- Only these scalar requests perform element conversion. -/
def atomicRequestedConversion {V Ex Op : Type} : Models1Group6.AtomicRequest V Ex Op → Option V
  | .set _ value | .setOnce _ _ value | .swap _ value => some value
  | .replace _ _ _ desired => some desired
  | .get _ | .modify _ _ _ => none

/-- Exact request/operand preservation for all six scalar atomic callees.
Replace leaves expected unconverted; modify leaves its value unconverted. -/
def AtomicPrimitiveCoherent {E M P El V Ex Op Out B BP C O : Type}
    (cast : V → Option El) (events : List (AtomicWrapperEvent E M P El V Ex Op Out B BP C O))
    (bounds : Bool) (memory : M) (request : Models1Group6.AtomicRequest V Ex Op)
    (actual : AtomicPrimitiveArguments M P El V Ex Op) : Prop :=
  ∃ index reference,
    .reference memory index (.ok reference) ∈ events ∧
    match request, actual with
    | .get order, .get ref ord check => ref = reference ∧ ord = order ∧ check = bounds ∧ atomicWrapperConversions events = []
    | .set order value, .set ref stored ord check =>
        ref = reference ∧ ord = order ∧ check = bounds ∧ AtomicElementOrigin cast events value stored
    | .setOnce success failure value, .once ref stored succ fail check =>
        ref = reference ∧ succ = success ∧ fail = failure ∧ check = bounds ∧ AtomicElementOrigin cast events value stored
    | .modify order operation value, .modify ref op raw ord check =>
        ref = reference ∧ op = operation ∧ raw = value ∧ ord = order ∧ check = bounds ∧ atomicWrapperConversions events = []
    | .swap order value, .swap ref stored ord check =>
        ref = reference ∧ ord = order ∧ check = bounds ∧ AtomicElementOrigin cast events value stored
    | .replace success failure expected desired, .replace ref exp stored succ fail check =>
        ref = reference ∧ exp = expected ∧ succ = success ∧ fail = failure ∧ check = bounds ∧ AtomicElementOrigin cast events desired stored
    | _, _ => False

/-- Full generated-family observation contract. Every request, memory kind,
address-space/type descriptor, order Symbol, value/operator, index variant,
custom callee, primitive failure, shared state and divergence is quantified.
Only actual tuple constructibility constrains inputs; aggregate output/call
arity is not artificially bounded beyond the inherited tuple abstraction.
Source: base/multidimensional.jl:722-753; base/genericmemory.jl:416-490. -/
def AtomicWrapperObservations : Prop :=
  ∀ (E S M P El V Ex Op Out B BP C O : Type)
    (entry : AtomicWrapperEntry B C)
    (ops : AtomicWrapperOps (AtomicObservationM E S) M P El V Ex Op Out B BP C O)
    (memoryType : JuliaLean.base.genericmemory.GenericMemoryType) (bounds : Bool) (memory : M)
    (request : Models1Group6.AtomicRequest V Ex Op) (initial : S),
    AtomicWrapperConstructible entry →
    let observed := (runAtomicWrapper entry (observeAtomicOps ops) memoryType bounds memory request).run (initial, [])
    (observed.map fun (result, (state, _)) => (result, state)) =
      (runAtomicWrapper entry ops memoryType bounds memory request).run initial ∧
    match observed with
    | none => True
    | some (result, (final, records)) =>
        let events := records.map fun record => record.2.2
        RegionConversionStateThread initial final records ∧
        (atomicWrapperReferences events).length ≤ 1 ∧
        (atomicWrapperConversions events).length ≤ 1 ∧
        (∀ value, result = .ok value → ∃ event ∈ events, atomicWrapperReturn event = some (.ok value)) ∧
        (∀ i event, events[i]? = some event →
          (∀ error, atomicWrapperEventError event = some error → i + 1 = events.length ∧ result = .error error) ∧
          (∀ reply, atomicWrapperReturn event = some reply → i + 1 = events.length ∧ result = reply) ∧
          match event with
          | .length actual _ | .reference actual _ _ => actual = memory
          | .convert value _ =>
              atomicRequestedConversion request = some value ∧ ops.scalar.castElement value = none ∧
              ∃ index reference j, j < i ∧ events[j]? = some (.reference memory index (.ok reference))
          | .primitive args _ => AtomicPrimitiveCoherent ops.scalar.castElement events bounds memory request args
          | .mixed actual indices _ => actual = memory ∧ entry = .mixed indices ∧ i = 0 ∧
              ∃ custom, Models1Group6.MixedIndex.integer (.custom custom) ∈ indices
          | .integers actual indices _ => actual = memory ∧ entry = .integers indices ∧ i = 0 ∧
              ∃ custom, Models1Group6.MixedInteger.custom custom ∈ indices
          | .construct argument _ =>
              ∃ indices, events[i - 1]? = some (.mixed memory indices (.ok (.inr argument)))
          | .linearize actual argument _ => actual = memory ∧
              ∃ indices, events[i - 1]? = some (.integers memory indices (.ok (.inr argument)))
          | .other check actual selected argument _ =>
              check = bounds ∧ actual = memory ∧ selected = request ∧
              (∃ prior, .construct prior (.ok (.other argument)) ∈ events) ∨
              (check = bounds ∧ actual = memory ∧ selected = request ∧
                ∃ prior, .linearize memory prior (.ok (.other argument)) ∈ events)
          | .bigSize _ _ | .bigData _ _ | .bigLimb _ _ => True)

/-- The concrete GenericMemory vector linearization is independent of all
trailing coordinates and their magnitudes: a nonempty CartesianIndex chooses
its first coordinate; rank zero reads the length field and then chooses one.
There are no BigInt/custom-index/constructor effects on this concrete path.
All six scalar operations still satisfy the full observation contract above.
Source: base/multidimensional.jl:739-751; base/abstractarray.jl:1398-1400. -/
def AtomicCartesianLinearizationCorrect : Prop :=
  ∀ (E S M P El V Ex Op Out B BP C O : Type)
    (ops : AtomicWrapperOps (AtomicObservationM E S) M P El V Ex Op Out B BP C O)
    (memoryType : JuliaLean.base.genericmemory.GenericMemoryType) (bounds : Bool) (memory : M)
    (request : Models1Group6.AtomicRequest V Ex Op) (coordinates : CI) (initial : S),
    (coordinates.length : Int) ≤ IntTy.max .i64 →
    match (atomicCartesian (observeAtomicOps ops).scalar memoryType bounds memory request coordinates).run (initial, []) with
    | none => True
    | some (_, (_, records)) =>
        let events := records.map fun record => record.2.2
        (∀ actual index reply, .reference actual index reply ∈ events →
          actual = memory ∧ index.val = (match coordinates with | [] => 1 | first :: _ => first.val)) ∧
        (∀ (i : Nat) (event : AtomicWrapperEvent E M P El V Ex Op Out B BP C O), events[i]? = some event → match event with
          | .length actual _ => coordinates = [] ∧ actual = memory ∧ i = 0
          | .reference _ _ _ =>
              (coordinates = [] → ∃ length, events[0]? = some (.length memory (.ok length)))
          | .convert _ _ | .primitive _ _ => True
          | _ => False)

