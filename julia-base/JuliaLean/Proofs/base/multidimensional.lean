    SliceRegionOutcome ranges (selectors.map SliceIndex64.ordinal) (regionSliceRegion ranges selectors) ∧
    SliceRegionOutcome ranges (selectors.map SliceIndex64.ordinal) (regionViewRegion ranges selectors)

