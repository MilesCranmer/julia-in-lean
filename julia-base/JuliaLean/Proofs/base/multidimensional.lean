abbrev OverlapObservationM (E S : Type) :=
  ExceptT (Sum (Sum Error JuliaLean.base.range.Exc) E) (StateT S Option)

local instance overlapObservationError {E S : Type} : MonadExceptOf Error (OverlapObservationM E S) where
  throw error := ExceptT.mk fun state => some (.error (.inl (.inl error)), state)
  tryCatch action handler := ExceptT.mk fun state =>
    match action.run state with
    | none => none
    | some (.ok value, state') => some (.ok value, state')
    | some (.error (.inl (.inl error)), state') => (handler error).run state'
    | some (.error error, state') => some (.error error, state')

local instance overlapObservationRangeError {E S : Type} :
    MonadExceptOf JuliaLean.base.range.Exc (OverlapObservationM E S) where
  throw error := ExceptT.mk fun state => some (.error (.inl (.inr error)), state)
  tryCatch action handler := ExceptT.mk fun state =>
    match action.run state with
    | none => none
    | some (.ok value, state') => some (.ok value, state')
    | some (.error (.inl (.inr error)), state') => (handler error).run state'
    | some (.error error, state') => some (.error error, state')

abbrev OverlapObservedError (E : Type) := Sum (Sum Error JuliaLean.base.range.Exc) E

inductive OverlapEvent (E V A U R C I O : Type) where
  | equal (left right : OverlapValue V) (result : Except (OverlapObservedError E) (RegionTruth O))
  | contains (value : OverlapValue V) (array : OverlapArray A U R)
      (result : Except (OverlapObservedError E) (RegionTruth O))
  | length (array : OverlapArray A U R) (result : Except (OverlapObservedError E) (OverlapValue V))
  | getindex (array : OverlapArray A U R) (index : I64)
      (result : Except (OverlapObservedError E) (OverlapValue V))
  | first (range : U) (result : Except (OverlapObservedError E) (OverlapValue V))
  | last (range : U) (result : Except (OverlapObservedError E) (OverlapValue V))
  | maximum (left right : OverlapValue V) (result : Except (OverlapObservedError E) (OverlapValue V))
  | minimum (left right : OverlapValue V) (result : Except (OverlapObservedError E) (OverlapValue V))
  | lessEqual (left right : OverlapValue V) (result : Except (OverlapObservedError E) (RegionTruth O))
  | intersect (left right : Sum U R) (result : Except (OverlapObservedError E) I)
  | isempty (intersection : I) (result : Except (OverlapObservedError E) (RegionTruth O))
  | logicalNot (value : O) (result : Except (OverlapObservedError E) (RegionTruth O))
  | selected (left right : List (OverlapIndex V A U R C))
      (result : Except (OverlapObservedError E) (RegionTruth O))

def observeOverlapAction {E S Event X : Type} (action : OverlapObservationM E S X)
    (event : Except (OverlapObservedError E) X → Event) :
    OverlapObservationM E (S × List (S × S × Event)) X :=
  ExceptT.mk fun (state, events) =>
    match action.run state with
    | none => none
    | some (result, state') => some (result, (state', events ++ [(state, state', event result)]))

def observeOverlapOps {E S V A U R C I O : Type}
    (ops : OverlapOps (OverlapObservationM E S) V A U R C I O) :
    OverlapOps (OverlapObservationM E (S × List (S × S × OverlapEvent E V A U R C I O)))
      V A U R C I O where
  equal := fun left right => observeOverlapAction (ops.equal left right) (.equal left right)
  contains := fun value array => observeOverlapAction (ops.contains value array) (.contains value array)
  length := fun array => observeOverlapAction (ops.length array) (.length array)
  getindex := fun array index => observeOverlapAction (ops.getindex array index) (.getindex array index)
  first := fun range => observeOverlapAction (ops.first range) (.first range)
  last := fun range => observeOverlapAction (ops.last range) (.last range)
  maximum := fun left right => observeOverlapAction (ops.maximum left right) (.maximum left right)
  minimum := fun left right => observeOverlapAction (ops.minimum left right) (.minimum left right)
  lessEqual := fun left right => observeOverlapAction (ops.lessEqual left right) (.lessEqual left right)
  intersect := fun left right => observeOverlapAction (ops.intersect left right) (.intersect left right)
  isempty := fun intersection => observeOverlapAction (ops.isempty intersection) (.isempty intersection)
  logicalNot := fun value => observeOverlapAction (ops.logicalNot value) (.logicalNot value)
  selected := fun left right => (ops.selected left right).map fun action =>
    observeOverlapAction action (.selected left right)

def overlapEntryHeads {V A U R C : Type} :
    OverlapEntry V A U R → OverlapIndex V A U R C × OverlapIndex V A U R C
  | .scalars left right => (.scalar left, .scalar right)
  | .scalarArray left right => (.scalar left, .array right)
  | .arrayScalar left right => (.array left, .scalar right)
  | .arrays left right => (.array left, .array right)

def overlapEventError {E V A U R C I O : Type} :
    OverlapEvent E V A U R C I O → Option (OverlapObservedError E)
  | .equal _ _ (.error error) | .contains _ _ (.error error)
  | .length _ (.error error) | .getindex _ _ (.error error)
  | .first _ (.error error) | .last _ (.error error)
  | .maximum _ _ (.error error) | .minimum _ _ (.error error)
  | .lessEqual _ _ (.error error) | .intersect _ _ (.error error)
  | .isempty _ (.error error) | .logicalNot _ (.error error)
  | .selected _ _ (.error error) => some error
  | _ => none

def overlapAssertedTruth {E V A U R C I O : Type} :
    OverlapEvent E V A U R C I O → Option (RegionTruth O)
  | .equal _ _ (.ok value) | .contains _ _ (.ok value)
  | .lessEqual _ _ (.ok value) | .logicalNot _ (.ok value) => some value
  | _ => none

def OverlapTruthIsBool {O : Type} : RegionTruth O → Prop
  | .bool _ => True
  | _ => False

def overlapArrayReceivers {V A U R C : Type} (inputs : List (OverlapIndex V A U R C)) :=
  inputs.filterMap fun input => match input with | .array array => some array | _ => none

def overlapUnitReceivers {V A U R C : Type} (inputs : List (OverlapIndex V A U R C)) :=
  inputs.filterMap fun input => match input with | .array (.unit range) => some range | _ => none

def overlapRangeTag {A U R : Type} : OverlapArray A U R → Option (Sum U R)
  | .unit reference => some (.inl reference)
  | .range reference => some (.inr reference)
  | .array _ => none

/-- Independent terminal-observation rules: source truth contexts reject all
non-Bools; membership/comparison false and an empty intersection stop at that
same event. A selected recursive return remains completely raw, with no final
Bool assertion. No runtime implementation is assumed. -/
def OverlapTerminalObservations {E V A U R C I O : Type}
    (events : List (OverlapEvent E V A U R C I O))
    (actual : Except (OverlapObservedError E) (RegionTruth O)) : Prop :=
  (∀ position event error, events[position]? = some event → overlapEventError event = some error →
    position + 1 = events.length ∧ actual = .error error) ∧
  (∀ position event value, events[position]? = some event → overlapAssertedTruth event = some value →
    ¬ OverlapTruthIsBool value → position + 1 = events.length ∧
      actual = .error (.inl (.inl .typeError))) ∧
  (∀ position value array, events[position]? = some (.contains value array (.ok (.bool false))) →
    position + 1 = events.length ∧ actual = .ok (.bool false)) ∧
  (∀ position left right, events[position]? = some (.lessEqual left right (.ok (.bool false))) →
    position + 1 = events.length ∧ actual = .ok (.bool false)) ∧
  (∀ position intersection, events[position]? = some (.isempty intersection (.ok (.bool true))) →
    position + 1 = events.length ∧ actual = .ok (.bool false)) ∧
  (∀ position intersection, events[position]? = some (.isempty intersection (.ok .missing)) →
    position + 1 = events.length ∧ actual = .error (.inl (.inl .typeError))) ∧
  (∀ position value, events[position]? = some (.logicalNot value (.ok (.bool false))) →
    position + 1 = events.length ∧ actual = .ok (.bool false)) ∧
  (∀ position left right result, events[position]? = some (.selected left right result) →
    position + 1 = events.length ∧ actual = result)

/-- Receiver, argument and data-flow preservation over the whole tuple pair.
All indexed reads use literal native one; intersection is evaluated before
isempty on its exact returned object, and unknown negation sees the exact
observed raw value. A custom recursive call receives equally advanced suffixes
of the original tails and occurs at most once. -/
def OverlapArgumentObservations {E V A U R C I O : Type}
    (entry : OverlapEntry V A U R) (leftTail rightTail : List (OverlapIndex V A U R C))
    (events : List (OverlapEvent E V A U R C I O)) : Prop :=
  let heads : OverlapIndex V A U R C × OverlapIndex V A U R C := overlapEntryHeads entry
  let left := heads.1 :: leftTail
  let right := heads.2 :: rightTail
  let arrays := overlapArrayReceivers (left ++ right)
  let units := overlapUnitReceivers (left ++ right)
  (events.filterMap (fun event => match event with | .selected _ _ _ => some () | _ => none)).length ≤ 1 ∧
  (∀ event ∈ events, match event with
    | .length receiver _ => receiver ∈ arrays
    | .getindex receiver index _ => receiver ∈ arrays ∧ index = int 1
    | .contains _ receiver _ => receiver ∈ arrays
    | .first receiver _ | .last receiver _ => receiver ∈ units
    | .selected a b _ => ∃ position, a = leftTail.drop position ∧ b = rightTail.drop position ∧
        a ≠ [] ∧ b ≠ []
    | _ => True) ∧
  (∀ position a b intersection,
    events[position]? = some (.intersect a b (.ok intersection)) →
    ∃ result, events[position + 1]? = some (.isempty intersection result)) ∧
  (∀ position intersection value,
    events[position]? = some (.isempty intersection (.ok (.other value))) →
    ∃ result, events[position + 1]? = some (.logicalNot value result))

/-- Full-domain observation contract for all four public overlap entries.
Arbitrary AbstractArray/Real/range methods, raw malformed returns, aliases,
nonstandard index one, custom recursive dispatch and all errors/state changes
are quantified with no correctness assumptions. Only actual tuple arities are
bounded. Source: base/multidimensional.jl:1158-1188. -/
def OverlapCompleteProtocol : Prop :=
  ∀ (E S V A U R C I O : Type)
    (ops : OverlapOps (OverlapObservationM E S) V A U R C I O)
    (entry : OverlapEntry V A U R) (leftTail rightTail : List (OverlapIndex V A U R C))
    (initial : S),
    ((leftTail.length + 1 : Nat) : Int) ≤ IntTy.max .i64 →
    ((rightTail.length + 1 : Nat) : Int) ≤ IntTy.max .i64 →
    match (overlapMethod (observeOverlapOps ops) entry leftTail rightTail).run (initial, []) with
    | none => True
    | some (result, (final, records)) =>
        RegionConversionStateThread initial final records ∧
        OverlapTerminalObservations (records.map fun record => record.2.2) result ∧
        OverlapArgumentObservations entry leftTail rightTail (records.map fun record => record.2.2)

/-- Mathematical value of any concrete Bool or BitInteger without invoking
native equality, promotion, wrapping or tuple recursion. -/
def overlapIntegerMathematical : Models1Group6.NativePrechecked.IntegerValue → Int
  | .bits _ value => value.val
  | .boolean value => if value then 1 else 0

/-- Complete native scalar tuple outcome. Any unequal common coordinate makes
the result false before a malformed tail can be reached. If all common values
agree, equal arities return true and unequal arities raise the precise existing
malformed-subarray ErrorException. No runtime operation or selected custom leaf
may be observed on this concrete grammar. All widths, signednesses, Bool and
machine extrema are included. -/
def OverlapNativeScalarsCorrect : Prop :=
  ∀ (E S V A U R C I O : Type)
    (ops : OverlapOps (OverlapObservationM E S) V A U R C I O)
    (leftHead rightHead : Models1Group6.NativePrechecked.IntegerValue)
    (leftTail rightTail : List Models1Group6.NativePrechecked.IntegerValue) (initial : S),
    ((leftTail.length + 1 : Nat) : Int) ≤ IntTy.max .i64 →
    ((rightTail.length + 1 : Nat) : Int) ≤ IntTy.max .i64 →
    let left := leftHead :: leftTail
    let right := rightHead :: rightTail
    let mismatch := (left.zip right).any fun pair =>
      decide (overlapIntegerMathematical pair.1 ≠ overlapIntegerMathematical pair.2)
    let expected : Except (OverlapObservedError E) (RegionTruth O) :=
      if mismatch then .ok (.bool false)
      else if left.length = right.length then .ok (.bool true)
      else .error (.inl (.inl (.errorException "malformed subarray")))
    (overlapMethod (observeOverlapOps ops) (.scalars (.native leftHead) (.native rightHead))
      (leftTail.map fun value => OverlapIndex.scalar (.native value))
      (rightTail.map fun value => OverlapIndex.scalar (.native value))).run (initial, []) =
        some (expected, (initial, []))

/-- The public head determines the first call and native subscript behavior,
independently of arbitrary subsequent tails. Left singleton success cannot read
right length; right length is observed only after the first comparison rejects
singleton status. Getter and membership origins are checked at their actual
adjacent events, retaining arbitrary returned objects and effects. -/
def OverlapEntryPrefix {E V A U R C I O : Type} (entry : OverlapEntry V A U R)
    (events : List (OverlapEvent E V A U R C I O))
    (actual : Except (OverlapObservedError E) (RegionTruth O)) : Prop :=
  match entry with
  | .scalars (.native _) (.native _) => True
  | .scalars left right => ∃ result, events[0]? = some (.equal left right result) ∧
      (result = .ok (.bool false) → events.length = 1 ∧ actual = .ok (.bool false))
  | .scalarArray value array | .arrayScalar array value =>
      ∃ result, events[0]? = some (.contains value array result)
  | .arrays left right =>
      ∃ leftResult, events[0]? = some (.length left leftResult) ∧
        (∀ result, events[1]? = some (.getindex left (int 1) result) →
          ∃ value, leftResult = .ok (.native value) ∧ overlapIntegerMathematical value = 1) ∧
        (∀ position value,
          events[position]? = some (.getindex left (int 1) (.ok value)) →
          (position = 1 ∨ position = 2) →
          ∃ result, events[position + 1]? = some (.contains value right result))

/-- Each public method's own initial branch is observed in full, without
replacing it by a recursive dispatch leaf. Arbitrary array indexing and
membership results remain unconstrained and can mutate shared state. This
covers both scalar/array orientations and the source1177 literal index-one
path on nonstandard arrays. -/
def OverlapOwnHeadProtocol : Prop :=
  ∀ (E S V A U R C I O : Type)
    (ops : OverlapOps (OverlapObservationM E S) V A U R C I O)
    (entry : OverlapEntry V A U R) (leftTail rightTail : List (OverlapIndex V A U R C))
    (initial : S),
    ((leftTail.length + 1 : Nat) : Int) ≤ IntTy.max .i64 →
    ((rightTail.length + 1 : Nat) : Int) ≤ IntTy.max .i64 →
    match (overlapMethod (observeOverlapOps ops) entry leftTail rightTail).run (initial, []) with
    | none => True
    | some (result, (_, records)) =>
        OverlapEntryPrefix entry (records.map fun record => record.2.2) result

/-- Erasing the entire untouched tail preserves the outcome when the initial
arrays both have a non-singleton native length. The observable premise records
only the two exact getter results and their original state transitions; no
purity or callee correctness law is assumed. This is the source's conservative
large-array shortcut, including zero and negative custom lengths. -/
def OverlapNonSingletonIgnoresTails : Prop :=
  ∀ (E S V A U R C I O : Type)
    (ops : OverlapOps (OverlapObservationM E S) V A U R C I O)
    (left right : OverlapArray A U R) (leftTail rightTail : List (OverlapIndex V A U R C))
    (initial middle final : S)
    (leftLength rightLength : Models1Group6.NativePrechecked.IntegerValue),
    ((leftTail.length + 1 : Nat) : Int) ≤ IntTy.max .i64 →
    ((rightTail.length + 1 : Nat) : Int) ≤ IntTy.max .i64 →
    overlapIntegerMathematical leftLength ≠ 1 → overlapIntegerMathematical rightLength ≠ 1 →
    (ops.length left).run initial = some (.ok (.native leftLength), middle) →
    (ops.length right).run middle = some (.ok (.native rightLength), final) →
    (overlapMethod (observeOverlapOps ops) (.arrays left right) leftTail rightTail).run (initial, []) =
      some (.ok (.bool true), (final,
        [(initial, middle, .length left (.ok (.native leftLength))),
         (middle, final, .length right (.ok (.native rightLength)))]))

