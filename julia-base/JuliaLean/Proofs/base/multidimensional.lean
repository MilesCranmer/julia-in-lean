    ranges.length dimensions).run heap).mapError Sum.inl = _ ↔ _
  rw [collect7_heapArrayUndef_run (fun _ : Nat => some layout)
    ranges.length layout rfl dimensions heap]
  unfold collect7_allocOutcome
  cases h : collect7_arrayAllocError layout (dimensions.map (fun d => d.val)) with
  | none =>
    constructor <;> intro hbad <;> cases hbad
