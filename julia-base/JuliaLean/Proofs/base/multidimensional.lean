theorem lr_le_i64 (left right : I64) :
    JuliaLean.base.int.le left right = decide (left.val ≤ right.val) := by
  change decide ((fromJInt (widenTo .i64 left)).toInt ≤
    (fromJInt (widenTo .i64 right)).toInt) = _
  rw [JuliaLean.Proofs.base.int.fromJInt_toInt _ rfl, JuliaLean.Proofs.base.int.fromJInt_toInt _ rfl]
  change decide (wrapInt .i64 left.val ≤ wrapInt .i64 right.val) = _
  rw [JuliaLean.Proofs.base.int.wrapInt_val, JuliaLean.Proofs.base.int.wrapInt_val]

theorem lr_ntuple_machine (value : I64) (generated : Bool) :
    ntupleTrueTypeRank (.machineInt value) generated =
      if value.val < 0 then
        .error (.argumentError ("tuple length should be ≥ 0, got " ++ toString value.val))
      else .ok (List.replicate value.val.toNat true) := by
  have hz : (int 0).val = 0 := rfl
  by_cases hn : value.val < 0
  · have hnon : ¬ 0 ≤ value.val := by omega
    simp only [ntupleTrueTypeRank, assertTypeRank, bind, Except.bind,
      lr_le_i64, hz, hnon, decide_false, Bool.not_false, ite_true, hn]
    rfl
  · have hnon : 0 ≤ value.val := by omega
    cases generated <;>
      simp [ntupleTrueTypeRank, assertTypeRank, lr_le_i64, hz, hn, hnon,
        bind, Except.bind, pure, Except.pure, Functor.map, Except.map,
        List.map_map, List.map_const', List.length_range]

def lr_requirementValue (generated : Bool) : Contribution → Result (List Bool)
  | .fixed count => .ok (List.replicate count true)
  | .checked rank => ntupleTrueTypeRank rank generated

theorem lr_requirement_spec (generated : Bool) (contribution : Contribution) :
    match Fails contribution with
    | some failure => ∃ error, lr_requirementValue generated contribution = .error error ∧
        HasFailureClass error failure
    | none => lr_requirementValue generated contribution =
        .ok (List.replicate (Count contribution) true) := by
  cases contribution with
  | fixed count => rfl
  | checked rank =>
    cases rank with
    | other => exact ⟨.typeError, rfl, trivial⟩
    | machineInt value =>
      rw [Fails]
      by_cases hn : value.val < 0
      · rw [if_pos hn]
        exact ⟨.argumentError ("tuple length should be ≥ 0, got " ++ toString value.val),
          by simpa only [lr_requirementValue, lr_ntuple_machine, if_pos hn], trivial⟩
      · rw [if_neg hn]
        simpa only [lr_requirementValue, Count, lr_ntuple_machine, if_neg hn]

def lr_rankRun (generated : Bool) : List Contribution → Result (List Bool)
  | [] => .ok []
  | contribution :: rest => do
      let first ← lr_requirementValue generated contribution
      let tail ← lr_rankRun generated rest
      return first ++ tail

theorem lr_rankRun_spec (generated : Bool) (requirements : List Contribution) :
    OutcomeCorrect requirements (lr_rankRun generated requirements) := by
  induction requirements with
  | nil => exact ⟨[], rfl, rfl, by intro marker hmem; cases hmem⟩
  | cons contribution rest ih =>
    have hc := lr_requirement_spec generated contribution
    cases hf : Fails contribution with
    | some failure =>
      simp only [hf] at hc
      obtain ⟨error, herror, hclass⟩ := hc
      simp only [OutcomeCorrect, List.filterMap_cons, hf, List.head?_cons]
      refine ⟨error, ?_, hclass⟩
      rw [lr_rankRun, herror]
      rfl
    | none =>
      simp only [hf] at hc
      simp only [OutcomeCorrect, List.filterMap_cons, hf] at ih ⊢
      cases ht : (List.filterMap Fails rest).head? with
      | some failure =>
        simp only [ht] at ih ⊢
        obtain ⟨error, herror, hclass⟩ := ih
        refine ⟨error, ?_, hclass⟩
        rw [lr_rankRun, hc, herror]
        rfl
      | none =>
        simp only [ht] at ih ⊢
        obtain ⟨markers, hmarkers, hlength, htrue⟩ := ih
        refine ⟨List.replicate (Count contribution) true ++ markers, ?_, ?_, ?_⟩
        · rw [lr_rankRun, hc, hmarkers]
          rfl
        · simp only [List.length_append, List.length_replicate, hlength,
            List.map_cons, List.sum_cons]
        · intro marker hmem
          rcases List.mem_append.mp hmem with hmem | hmem
          · exact (List.mem_replicate.mp hmem).2
          · exact htrue marker hmem

