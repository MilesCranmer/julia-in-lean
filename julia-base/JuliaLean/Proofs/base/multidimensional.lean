def pr_preserve {State Extra Value : Type} (action : JuliaLean.Proofs.base.multidimensional.Models1Group6.MaskAxesProtocol.Effects State Value) :
    JuliaLean.Proofs.base.multidimensional.Models1Group6.MaskAxesProtocol.Effects (State × Extra) Value :=
  ExceptT.mk fun state =>
    let (result, final) := ExceptT.run action state.1
    (result, (final, state.2))

theorem pr_preserve_pure {State Extra Value : Type} (value : Value) :
    pr_preserve (Extra := Extra) (pure value : JuliaLean.Proofs.base.multidimensional.Models1Group6.MaskAxesProtocol.Effects State Value) = pure value := by
  rfl

theorem pr_preserve_bind {State Extra Value Result : Type}
    (action : JuliaLean.Proofs.base.multidimensional.Models1Group6.MaskAxesProtocol.Effects State Value) (next : Value → JuliaLean.Proofs.base.multidimensional.Models1Group6.MaskAxesProtocol.Effects State Result) :
    pr_preserve (Extra := Extra) (action >>= next) =
      (pr_preserve action >>= fun value => pr_preserve (next value)) := by
  funext state
  rcases state with ⟨state, extra⟩
  cases h : ExceptT.run action state with
  | mk result final =>
    simp only [ExceptT.run] at h
    cases result <;>
      simp only [pr_preserve, ExceptT.run, ExceptT.mk, Bind.bind, ExceptT.bind,
        ExceptT.bindCont, StateT.bind, Pure.pure, StateT.pure, h]

def pr_preserveRuntime {State Extra Axis TypeTag Other : Type}
    (runtime : MaskAxesRuntime (JuliaLean.Proofs.base.multidimensional.Models1Group6.MaskAxesProtocol.Effects State) Axis TypeTag Other) :
    MaskAxesRuntime (JuliaLean.Proofs.base.multidimensional.Models1Group6.MaskAxesProtocol.Effects (State × Extra)) Axis TypeTag Other where
  equal := fun left right => pr_preserve (runtime.equal left right)
  missingExtension := fun value => (runtime.missingExtension value).map pr_preserve

theorem pr_preserve_requireBool {State Extra Other : Type} (value : MaskTruth Other) :
    maskRequireBool (m := JuliaLean.Proofs.base.multidimensional.Models1Group6.MaskAxesProtocol.Effects (State × Extra)) value =
      pr_preserve (maskRequireBool (m := JuliaLean.Proofs.base.multidimensional.Models1Group6.MaskAxesProtocol.Effects State) value) := by
  cases value <;> rfl

theorem pr_preserve_isMissing {State Extra Axis TypeTag Other : Type}
