              · exact hgeo
          · refine ⟨true, JuliaLean.base.int.add coordinate (rangeStep axis) :: next :: rest, ?_, ?_⟩
            · rw [incrementStored]
              simp only [bne_iff_ne]
              rw [if_pos heq] <;> rfl
            · apply nav7_zero
              · simpa only [↓reduceIte, Int.one_mul, JuliaLean.base.int.addWrap, JuliaLean.base.int.add] using
                  nav7_add_displacement coordinate (rangeStep axis)
