inductive GenericSplitEvent (Extra T Front Rest : Type) where
  | first (value : T) (reference : List Bool) (result : Except (Sum Error Extra) Front)
  | rest (value : T) (reference : List Bool) (result : Except (Sum Error Extra) Rest)

def observeGenericSplitOps {Extra S T Front Rest : Type}
    (ops : GenericSplitOps (ConstructorObservationM Extra S) T Front Rest) :
    GenericSplitOps
      (ConstructorObservationM Extra (S × List (S × S × GenericSplitEvent Extra T Front Rest)))
      T Front Rest where
  splitFirst := fun value reference =>
    observeConstructorAction (ops.splitFirst value reference) (.first value reference)
  splitRest := fun value reference =>
    observeConstructorAction (ops.splitRest value reference) (.rest value reference)

def SplitReferenceShape (rank : I64) (reference : List Bool) : Prop :=
  (reference.length : Int) = rank.val ∧ ∀ value ∈ reference, value = true

/-- Val type/length errors precede both helper calls. Otherwise the same
all-true reference and original object reach first then rest, retaining
independent return types and mutation. Source: base/multidimensional.jl:523-526;
base/ntuple.jl:65-72. -/
def GenericSplitObservation {Extra S T Front Rest : Type}
    (value : T) (rank : SplitRank) (initial : S)
    (outcome : Option (Except (Sum Error Extra) (Front × Rest) ×
      (S × List (S × S × GenericSplitEvent Extra T Front Rest)))) : Prop :=
  match outcome with
  | none => True
  | some (result, (final, records)) =>
      match rank with
      | .other => result = .error (.inl .typeError) ∧ final = initial ∧ records = []
      | .machine count =>
          if count.val < 0 then
            (∃ message, result = .error (.inl (.argumentError message))) ∧
              final = initial ∧ records = []
          else
            ∃ reference : List Bool, SplitReferenceShape count reference ∧
            match result with
            | .ok (front, rest) =>
                ∃ middle,
                  records = [(initial, middle, .first value reference (.ok front)),
                    (middle, final, .rest value reference (.ok rest))]
            | .error error =>
                records = [(initial, final, .first value reference (.error error))] ∨
                ∃ front middle,
                  records = [(initial, middle, .first value reference (.ok front)),
                    (middle, final, .rest value reference (.error error))]

def GenericSplitObservations : Prop :=
  ∀ (Extra S T Front Rest : Type)
    (ops : GenericSplitOps (ConstructorObservationM Extra S) T Front Rest)
    (value : T) (rank : SplitRank) (state : S),
    GenericSplitObservation value rank state
      ((splitGeneric (observeGenericSplitOps ops) value rank).run (state, []))

