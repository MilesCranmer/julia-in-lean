 theorem mix7_unitStop_normalized (r : JuliaLean.base.range.UnitRange I64)
    (hr : r.start.val ≤ r.stop.val ∨ r.stop.val = r.start.val - 1) :
    unitStop r.start r.stop = .ok r.stop := by
  change (if JuliaLean.base.int.leSame r.start r.stop then Except.ok r.stop
    else Except.ok (JuliaLean.base.int.sub_int r.start (int 1))) = _
  rw [scalar7_leSame]
  simp only [decide_eq_true_eq]
  by_cases h : r.start.val ≤ r.stop.val
  · rw [if_pos h]
  · rw [if_neg h]
    congr 1
    apply Subtype.ext
    change (JuliaLean.base.int.sub r.start (int 1)).val = r.stop.val
    rw [sub_int_val]
    change wrapInt .i64 (r.start.val - 1) = r.stop.val
    have heq : r.start.val - 1 = r.stop.val := by
      rcases hr with hr | hr <;> omega
    rw [heq]
    exact wrapInt_of_inRange .i64 r.stop.val r.stop.property

 theorem mix7_rangeUnit_run (start stop last : I64)
    (h : unitStop start stop = .ok last) :
    rangeUnit start stop = .ok (.unit ⟨start, last⟩) := by
  have hm : makeUnit start stop = .ok ⟨start, last⟩ := by
    change (do let last ← unitStop start stop
               pure (JuliaLean.base.range.UnitRange.mk start last)) = _
    rw [h]
    rfl
  unfold rangeUnit
  rw [hm]
  rfl

 theorem mix7_rangeUnit_normalized (r : JuliaLean.base.range.UnitRange I64)
    (hr : r.start.val ≤ r.stop.val ∨ r.stop.val = r.start.val - 1) :
    rangeUnit r.start r.stop = .ok (.unit r) := by
  exact mix7_rangeUnit_run r.start r.stop r.stop (mix7_unitStop_normalized r hr)

 theorem mix7_rangeUnit_oneTo (stop : I64) :
    rangeUnit (int 1) stop =
      .ok (.unit ⟨int 1, if 1 ≤ stop.val then stop else int 0⟩) := by
  by_cases h : 1 ≤ stop.val
  · rw [if_pos h]
    exact mix7_rangeUnit_normalized ⟨int 1, stop⟩ (Or.inl h)
  · rw [if_neg h]
    have hu : unitStop (int 1) stop = .ok (int 0) := by
      change (if JuliaLean.base.int.leSame (int 1) stop then Except.ok stop
        else Except.ok (JuliaLean.base.int.sub_int (int 1) (int 1))) = _
      rw [scalar7_leSame]
      change (if decide (1 ≤ stop.val) then Except.ok stop
        else Except.ok (JuliaLean.base.int.sub_int (int 1) (int 1))) = _
      simp only [h, decide_false, ite_false]
      rfl
    exact mix7_rangeUnit_run (int 1) stop (int 0) hu

 theorem mix7_oneTo_unit_geometry (stop : I64) :
    let output : OrdinalRange64 := .unit ⟨int 1, if 1 ≤ stop.val then stop else int 0⟩
    RangeConstructible output ∧
      MixedDimensionGeometry (.ordinal (.oneTo ⟨stop⟩)) output := by
  dsimp only
  by_cases h : 1 ≤ stop.val
  · rw [if_pos h]
    refine ⟨Or.inl h, ?_, True.intro⟩
    intro position
    rfl
  · rw [if_neg h]
    refine ⟨Or.inr (by decide), ?_, True.intro⟩
    have he : rangeIsEmpty (.oneTo ⟨stop⟩) = true := by
      change JuliaLean.base.int.ltSame stop (int 1) = true
      rw [scalar7_ltSame]
      change decide (stop.val < 1) = true
      apply decide_eq_true
      omega
    have hi : rangeCardinality (.oneTo ⟨stop⟩) = 0 := by
      simp only [rangeCardinality, he, ite_true]
    have ho : rangeCardinality (.unit ⟨int 1, int 0⟩) = 0 := by decide
    intro position
    simp only [ConversionContracts.AxisValueAt, hi, ho, Nat.not_lt_zero, ite_false]

end Models1Group5.Batch9

namespace Models1Group5.Batch9

open JuliaLean JuliaLean.base.multidimensional
open JuliaLean.base.multidimensional.Models1Group5
open JuliaLean.base.multidimensional.Models1Group5.RangeDependencies
open JuliaLean.Proofs.base.multidimensional.Models1Group5

def mix7_valid : DimensionArg64 → Prop
  | .size _ => True
  | .ordinal axis => RangeConstructible axis

def mix7_fits : DimensionArg64 → Prop
  | .size size => max 0 size.value ≤ IntTy.max .i64
  | .ordinal _ => True

def mix7_rebuilt : OrdinalRange64 → OrdinalRange64
  | .oneTo r => .unit ⟨int 1, if 1 ≤ r.stop.val then r.stop else int 0⟩
  | .unit r => .unit r
  | .stepped r => .stepped r

def mix7_prepared : DimensionArg64 → PreparedDimension
  | .size size => .size (integerDimension size)
  | .ordinal axis => .ordinal (mix7_rebuilt axis)

def mix7_error (fits : Prop) : JuliaLean.base.range.Exc → Prop
  | .jl (.inexactError _) => ¬ fits
  | _ => False

def mix7_fieldOutcome (arg : DimensionArg64) : RegionResult OrdinalRange64 → Prop
  | .ok output => mix7_fits arg ∧ RangeConstructible output ∧ MixedDimensionGeometry arg output
  | .error error => mix7_error (mix7_fits arg) error

 theorem mix7_field_outcome (arg : DimensionArg64) (hvalid : mix7_valid arg) :
    mix7_fieldOutcome arg (convertPreparedDimension (mix7_prepared arg)) := by
  cases arg with
  | size size =>
    have hs := mix7_size_outcome size
    change mix7_fieldOutcome (.size size)
      (convertPreparedDimension (.size (integerDimension size)))
    cases hc : convertPreparedDimension (.size (integerDimension size)) with
    | ok output =>
      rw [hc] at hs
      exact hs
    | error error =>
      rw [hc] at hs
      cases error with
      | jl e => cases e <;> exact hs
      | errorException _ => exact hs
      | dimensionMismatch _ => exact hs
      | inboundsViolation => exact hs
      | showError _ => exact hs
  | ordinal axis =>
    cases axis with
    | oneTo r => exact ⟨True.intro, mix7_oneTo_unit_geometry r.stop⟩
    | unit r => exact ⟨True.intro, hvalid, fun _ => rfl, True.intro⟩
    | stepped r => exact ⟨True.intro, hvalid, fun _ => rfl, True.intro⟩

 theorem mix7_error_imp {p q : Prop} (h : q → p) (error : JuliaLean.base.range.Exc) :
    mix7_error p error → mix7_error q error := by
  cases error <;> try { exact id }
  rename_i e
  cases e <;> try { exact id }
  intro hp hq
  exact hp (h hq)

def mix7_listOutcome (args : List DimensionArg64) : RegionResult Region64 → Prop
  | .ok output =>
    MixedDimensionsFit args ∧
      (∀ axis ∈ output, RangeConstructible axis) ∧ output.length = args.length ∧
      ∀ (k : Nat) (arg : DimensionArg64), args[k]? = some arg →
        ∃ axis : OrdinalRange64, output[k]? = some axis ∧ MixedDimensionGeometry arg axis
  | .error error => mix7_error (MixedDimensionsFit args) error

 theorem mix7_list_outcome (args : List DimensionArg64)
    (hvalid : ∀ arg ∈ args, mix7_valid arg) :
    mix7_listOutcome args
      (args.mapM (fun arg => convertPreparedDimension (mix7_prepared arg))) := by
  induction args with
  | nil =>
    refine ⟨?_, ?_, rfl, ?_⟩
    · intro arg h
      cases h
    · intro axis h
      cases h
    · intro k arg h
      cases k <;> cases h
  | cons arg args ih =>
    have hv : mix7_valid arg := hvalid arg List.mem_cons_self
    have hvs : ∀ a ∈ args, mix7_valid a := fun a h =>
      hvalid a (List.mem_cons_of_mem _ h)
    have hh := mix7_field_outcome arg hv
    have hs := ih hvs
    cases hf : convertPreparedDimension (mix7_prepared arg) with
    | error error =>
      rw [hf] at hh
      rw [List.mapM_cons, hf]
      change mix7_error (MixedDimensionsFit (arg :: args)) error
      exact mix7_error_imp (fun (h : MixedDimensionsFit (arg :: args)) =>
        h arg List.mem_cons_self) error hh
    | ok axis =>
      rw [hf] at hh
      obtain ⟨hfit, haxis, hgeometry⟩ := hh
      rw [List.mapM_cons, hf]
      cases ht : args.mapM (fun a => convertPreparedDimension (mix7_prepared a)) with
      | error error =>
        rw [ht] at hs
        change mix7_error (MixedDimensionsFit (arg :: args)) error
        exact mix7_error_imp
          (fun (h : MixedDimensionsFit (arg :: args)) a ha =>
            h a (List.mem_cons_of_mem _ ha)) error hs
      | ok output =>
        rw [ht] at hs
        obtain ⟨hfits, haxes, hlength, hpositions⟩ := hs
        refine ⟨?_, ?_, ?_, ?_⟩
        · intro a ha
          rcases List.mem_cons.mp ha with ha | ha
          · subst a
            exact hfit
          · exact hfits a ha
        · intro a ha
          rcases List.mem_cons.mp ha with ha | ha
          · subst a
            exact haxis
          · exact haxes a ha
        · exact congrArg Nat.succ hlength
        · intro k a ha
          cases k with
          | zero =>
            have heq : arg = a := Option.some.inj ha
            subst a
            exact ⟨axis, rfl, hgeometry⟩
          | succ k =>
            exact hpositions k a ha

 theorem mix7_prepare_one
    (hstep : ∀ r : JuliaLean.base.range.StepRange I64 I64,
      RangeConstructible (.stepped r) → rangeStepped r.start r.step r.stop = .ok (.stepped r))
    (arg : DimensionArg64) (hvalid : mix7_valid arg) :
    convertDimension arg = .ok (mix7_prepared arg) := by
  cases arg with
  | size size => rfl
  | ordinal axis =>
    cases axis with
    | oneTo r =>
      simp only [convertDimension, mix7_prepared, mix7_rebuilt, mix7_rangeUnit_oneTo] <;> rfl
    | unit r =>
      simp only [convertDimension, mix7_prepared, mix7_rebuilt,
        mix7_rangeUnit_normalized r hvalid] <;> rfl
    | stepped r =>
      simp only [convertDimension, mix7_prepared, mix7_rebuilt, hstep r hvalid] <;> rfl

 theorem mix7_prepare_all
    (hstep : ∀ r : JuliaLean.base.range.StepRange I64 I64,
      RangeConstructible (.stepped r) → rangeStepped r.start r.step r.stop = .ok (.stepped r))
    (args : List DimensionArg64) (hvalid : ∀ arg ∈ args, mix7_valid arg) :
    args.mapM convertDimension = .ok (args.map mix7_prepared) := by
  induction args with
  | nil => rfl
  | cons arg args ih =>
    have hh := mix7_prepare_one hstep arg (hvalid arg List.mem_cons_self)
    have ht := ih (fun a h => hvalid a (List.mem_cons_of_mem _ h))
    rw [List.mapM_cons, hh, ht]
    rfl

 theorem mix7_correct_of_step_normalization
    (hstep : ∀ r : JuliaLean.base.range.StepRange I64 I64,
      RangeConstructible (.stepped r) → rangeStepped r.start r.step r.stop = .ok (.stepped r)) :
    JuliaLean.Proofs.base.multidimensional.Models1Group5.RegionMixedConstructorCorrect := by
  intro args hdomain
  have hvalid : ∀ arg ∈ args, mix7_valid arg := hdomain.2
  have hrun : regionMixed args =
      args.mapM (fun arg => convertPreparedDimension (mix7_prepared arg)) := by
    unfold regionMixed
    rw [mix7_prepare_all hstep args hvalid]
    change (args.map mix7_prepared).mapM convertPreparedDimension = _
    exact List.mapM_map
  rw [hrun]
  have hout := mix7_list_outcome args hvalid
  cases he : args.mapM (fun arg => convertPreparedDimension (mix7_prepared arg)) with
  | error error =>
    rw [he] at hout
    cases error with
    | jl e => cases e <;> exact hout
    | errorException _ => exact hout
    | dimensionMismatch _ => exact hout
    | inboundsViolation => exact hout
    | showError _ => exact hout
  | ok output =>
    rw [he] at hout
    obtain ⟨hfit, haxes, hlength, hpositions⟩ := hout
    refine ⟨hfit, ⟨?_, haxes⟩, hlength, hpositions⟩
    unfold TupleFits
    rw [hlength]
    exact hdomain.1

end Models1Group5.Batch9


