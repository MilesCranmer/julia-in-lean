    List.getElem?_cons_zero, List.take_zero, List.map_nil, List.nil_append,
    Nat.zero_add, List.drop_succ_cons, List.drop_zero, List.append_nil]

private theorem mc_reference_no_carry (state state' : I64) (states : CI)
    (range range' : JuliaLean.base.multidimensional.Models1Group6.PartitionRangeFields)
    (ranges : List JuliaLean.base.multidimensional.Models1Group6.PartitionRangeFields)
    (h : (state == range.stop) = false) :
    PartitionCarryReference (state :: state' :: states) (range :: range' :: ranges) =
      Except.ok (JInt.wrap .i64 (state.val + range.step.val) :: state' :: states) := by
  have hl : ¬ min (state' :: states).length (range' :: ranges).length + 1 ≤ 1 := by
    simp only [List.length_cons]
    omega
  simp only [PartitionCarryReference, List.isEmpty_cons, Bool.false_and,
    Bool.false_eq_true, ite_false, List.zip_cons_cons, List.takeWhile_cons, h,
    List.length_nil, Nat.min_zero, Nat.zero_min, ite_self, Nat.zero_add]
  have hd : ¬ min (state :: state' :: states).length
      (range :: range' :: ranges).length ≤ 1 := by
    simp only [List.length_cons]
    omega
  rw [if_neg (by intro hh; exact hd hh.2)]
  rfl

private theorem mc_reference_rank_error (state : CI)
    (ranges : List JuliaLean.base.multidimensional.Models1Group6.PartitionRangeFields)
    (hne : state.length ≠ ranges.length)
    (hshort : min state.length ranges.length ≤ 1) :
    PartitionCarryReference state ranges = Except.error (Error.methodError "__inc") := by
  have hb : (state.length == ranges.length) = false := beq_eq_false_iff_ne.mpr hne
  have hn : (state.isEmpty && ranges.isEmpty) = false := by
    cases state with
    | nil =>
        cases ranges with
        | nil => exact False.elim (hne rfl)
        | cons range ranges => rfl
    | cons coordinate state => rfl
  simp only [PartitionCarryReference, hn, Bool.false_eq_true, ite_false, hb]
  rw [if_pos ⟨True.intro, by omega⟩]

private theorem mc_reference_carry (state : I64) (states : CI)
    (range : JuliaLean.base.multidimensional.Models1Group6.PartitionRangeFields)
    (ranges : List JuliaLean.base.multidimensional.Models1Group6.PartitionRangeFields)
    (hs : states ≠ []) (hr : ranges ≠ [])
    (h : (state == range.stop) = true) :
    PartitionCarryReference (state :: states) (range :: ranges) =
      (PartitionCarryReference states ranges).map (fun tail => range.first :: tail) := by
  have hse : states.isEmpty = false := List.isEmpty_eq_false_iff.mpr hs
  have hn : 0 < states.length := by
    cases states with
    | nil => exact False.elim (hs rfl)
    | cons head tail => exact Nat.succ_pos _
  let k := ((states.zip ranges).takeWhile (fun pair => pair.1 == pair.2.stop)).length
  let p := if states.length == ranges.length then min k (states.length - 1) else k
  have hsame : (states.length + 1 == ranges.length + 1) =
      (states.length == ranges.length) := by
    rw [Bool.eq_iff_iff]
    simp only [beq_iff_eq, Nat.add_right_cancel_iff]
  have hmin : min (states.length + 1) (ranges.length + 1) =
      min states.length ranges.length + 1 := by omega
  have hp : (if states.length == ranges.length then min (k + 1) states.length else k + 1) =
      p + 1 := by
    dsimp only [p]
    split <;> omega
  dsimp only [k, p] at hp
  simp only [PartitionCarryReference, List.isEmpty_cons, hse, Bool.false_and,
    Bool.false_eq_true, ite_false, List.zip_cons_cons, List.takeWhile_cons,
    h, ite_true, List.length_cons, hsame,
    Nat.add_sub_cancel, hmin, hp, Nat.add_le_add_iff_right]
  change (if (states.length == ranges.length) = false ∧
      min states.length ranges.length ≤ p + 1 then
      Except.error (Error.methodError "__inc")
    else match ((state, range) :: states.zip ranges)[p + 1]? with
      | none => Except.error (Error.methodError "__inc")
      | some (coordinate, field) => .ok
          (((range :: ranges).take (p + 1)).map (·.first) ++
            [JInt.wrap .i64 (coordinate.val + field.step.val)] ++
            (state :: states).drop (p + 1 + 1))) =
    (if (states.length == ranges.length) = false ∧
      min states.length ranges.length ≤ p + 1 then
      Except.error (Error.methodError "__inc")
    else match (states.zip ranges)[p]? with
      | none => Except.error (Error.methodError "__inc")
      | some (coordinate, field) => .ok
          ((ranges.take p).map (·.first) ++
            [JInt.wrap .i64 (coordinate.val + field.step.val)] ++
            states.drop (p + 1))).map (fun tail => range.first :: tail)
  by_cases hg : (states.length == ranges.length) = false ∧
      min states.length ranges.length ≤ p + 1
  · rw [if_pos hg, if_pos hg]
    rfl
  · rw [if_neg hg, if_neg hg, List.getElem?_cons_succ]
    cases he : (states.zip ranges)[p]? with
    | none => rfl
    | some pair =>
        cases pair with
        | mk coordinate field =>
            simp only [List.take_succ_cons, List.map_cons, List.cons_append,
              List.drop_succ_cons]
            rfl

private theorem mc_model_carry (state state' : I64) (states : CI)
    (range range' : JuliaLean.base.multidimensional.Models1Group6.PartitionRangeFields)
    (ranges : List JuliaLean.base.multidimensional.Models1Group6.PartitionRangeFields)
    (h : state = range.stop) :
    partitionInc (state :: state' :: states) (range :: range' :: ranges) =
      (partitionInc (state' :: states) (range' :: ranges)).map
        (fun tail => range.first :: tail) := by
  unfold partitionInc
  rw [partitionIncrement]
  simp only [bne_eq_false_iff_eq.mpr h, Bool.false_eq_true, ite_false]
  cases hr : partitionIncrement (state' :: states) (range' :: ranges) with
  | error error => rfl
  | ok pair => cases pair; rfl

private theorem mc_partition_reference (state : CI)
    (ranges : List JuliaLean.base.multidimensional.Models1Group6.PartitionRangeFields) :
    partitionInc state ranges = PartitionCarryReference state ranges := by
  induction state generalizing ranges with
  | nil =>
      cases ranges with
      | nil =>
          rw [partitionInc, partitionIncrement, mc_reference_empty]
          rfl
      | cons range ranges =>
          rw [mc_reference_rank_error [] (range :: ranges)
            (by simp only [List.length_nil, List.length_cons]; omega)
            (by simp only [List.length_nil, Nat.zero_min]; omega)]
          rw [partitionInc, partitionIncrement] <;>
            first | rfl | (intros; simp_all only [List.cons.injEq,
              List.cons_ne_nil, reduceCtorEq, and_false, false_and])
  | cons state states ih =>
      cases states with
      | nil =>
          cases ranges with
          | nil =>
              rw [mc_reference_rank_error [state] []
                (by simp only [List.length_cons, List.length_nil]; omega)
                (by simp only [List.length_nil, Nat.min_zero]; omega)]
              rw [partitionInc, partitionIncrement] <;>
                first | rfl | (intros; simp_all only [List.cons.injEq,
                  List.cons_ne_nil, reduceCtorEq, and_false, false_and])
          | cons range ranges =>
              cases ranges with
              | nil =>
                  rw [mc_reference_single, partitionInc, partitionIncrement]
                  change Except.ok [JuliaLean.base.int.addWrap state range.step] =
                    Except.ok [JInt.wrap .i64 (state.val + range.step.val)]
                  have ha : JuliaLean.base.int.addWrap state range.step =
                      JInt.wrap .i64 (state.val + range.step.val) :=
                    Subtype.ext (JuliaLean.Proofs.base.int.add_int_val state range.step)
                  rw [ha]
              | cons range' ranges =>
                  rw [mc_reference_rank_error [state] (range :: range' :: ranges)
                    (by simp only [List.length_nil, List.length_cons]; omega)
                    (by simp only [List.length_nil, List.length_cons]; omega)]
                  rw [partitionInc, partitionIncrement] <;>
                    first | rfl | (intros; simp_all only [List.cons.injEq,
                      List.cons_ne_nil, reduceCtorEq, and_false, false_and])
      | cons state' states =>
          cases ranges with
          | nil =>
              rw [mc_reference_rank_error (state :: state' :: states) []
                (by simp only [List.length_nil, List.length_cons]; omega)
                (by simp only [List.length_nil, Nat.min_zero]; omega)]
              rw [partitionInc, partitionIncrement] <;>
                first | rfl | (intros; simp_all only [List.cons.injEq,
                  List.cons_ne_nil, reduceCtorEq, and_false, false_and])
          | cons range ranges =>
              cases ranges with
              | nil =>
                  rw [mc_reference_rank_error (state :: state' :: states) [range]
                    (by simp only [List.length_nil, List.length_cons]; omega)
                    (by simp only [List.length_nil, List.length_cons]; omega)]
                  rw [partitionInc, partitionIncrement] <;>
                    first | rfl | (intros; simp_all only [List.cons.injEq,
                      List.cons_ne_nil, reduceCtorEq, and_false, false_and])
              | cons range' ranges =>
                  by_cases h : state = range.stop
                  · rw [mc_model_carry state state' states range range' ranges h,
                      mc_reference_carry state (state' :: states) range (range' :: ranges)
                        (by intro hh; cases hh) (by intro hh; cases hh) (beq_iff_eq.mpr h), ih]
                  · rw [mc_reference_no_carry state state' states range range' ranges
                      (beq_eq_false_iff_ne.mpr h)]
                    unfold partitionInc
                    rw [partitionIncrement, if_pos (bne_iff_ne.mpr h)]
                    change Except.ok (JuliaLean.base.int.add state range.step :: state' :: states) =
                      Except.ok (JInt.wrap .i64 (state.val + range.step.val) :: state' :: states)
                    have ha : JuliaLean.base.int.add state range.step =
                        JInt.wrap .i64 (state.val + range.step.val) :=
                      Subtype.ext (JuliaLean.Proofs.base.int.add_int_val state range.step)
                    rw [ha]

