def RegionMixedConstructorCorrect : Prop :=
  ∀ arguments : List DimensionArg64, MixedRegionDomain arguments →
    match regionMixed arguments with
    | .ok result =>
        MixedDimensionsFit arguments ∧ RegionDomain result ∧
        result.length = arguments.length ∧
        ∀ (k : Nat) (argument : DimensionArg64), arguments[k]? = some argument →
          ∃ axis : OrdinalRange64, result[k]? = some axis ∧ MixedDimensionGeometry argument axis
    | .error (.jl (.inexactError _)) => ¬MixedDimensionsFit arguments
    | .error _ => False

/-- The terminal endpoint and reset endpoint are mathematical coordinate observations.
Forward navigation carries at the last coordinate; backward navigation borrows at the first. -/
def NavigationTerminal (forward : Bool) (axis : OrdinalRange64) : Int :=
  if forward then (rangeLast axis).val else (rangeFirst axis).val

def NavigationReset (forward : Bool) (axis : OrdinalRange64) : Int :=
  if forward then (rangeFirst axis).val else (rangeLast axis).val

/-- Full-domain carry/borrow invariant, including arbitrary out-of-bounds input coordinates.
A pivot is the earliest coordinate that can move, or the final coordinate if all are terminal.
Earlier coordinates reset; later coordinates are unchanged; the pivot changes by the signed
stride modulo 2^64. This relation performs no recursive model call and imposes no validity or
no-overflow condition on the source index. The empty tuple remains empty. -/
def NavigationGeometry (forward : Bool) (ranges : Region64) (before after : CI) : Prop :=
  after.length = before.length ∧
  (if before.isEmpty then after.isEmpty = true else
    ∃ pivot : Nat, pivot < before.length ∧
      (∀ (k : Nat) (axis : OrdinalRange64) (coordinate : I64), k < pivot →
        ranges[k]? = some axis → before[k]? = some coordinate →
        coordinate.val = NavigationTerminal forward axis) ∧
      (pivot + 1 < before.length →
        ∃ (axis : OrdinalRange64) (coordinate : I64),
          ranges[pivot]? = some axis ∧ before[pivot]? = some coordinate ∧
          coordinate.val ≠ NavigationTerminal forward axis) ∧
      ∀ (k : Nat) (axis : OrdinalRange64) (coordinate : I64),
        ranges[k]? = some axis → before[k]? = some coordinate →
        ∃ result : I64, after[k]? = some result ∧
          if k < pivot then result.val = NavigationReset forward axis
          else if k = pivot then
            (result.val - coordinate.val -
              (if forward then 1 else -1) * (rangeStep axis).val) % ((2 : Int)^64) = 0
          else result = coordinate)

/-- The nextind downstream closure satisfies complete carry geometry even for explicit
