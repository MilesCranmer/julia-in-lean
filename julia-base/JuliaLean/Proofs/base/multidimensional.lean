/-- Selector tuples are machine-constructible, with actual range constructor invariants.
No bound is imposed on a lazy selector's mathematical cardinality. -/
def SliceSelectorDomain (selectors : List SliceIndex64) : Prop :=
  TupleFits selectors ∧ ∀ selector ∈ selectors,
    match selector with
    | .colon => True
    | .ordinal r => RangeConstructible r

/-- Mathematical description of the outer machine-address check. Empty selectors are allowed
at arbitrary endpoints; nonempty selectors must have both endpoint addresses in the axis.
This relation calls no slicing, bounds-check, or range-membership implementation. -/
def SliceAxisAddress (axis : OrdinalRange64) (selector : SliceIndex64) : Prop :=
  match selector with
  | .colon => True
  | .ordinal r =>
    rangeCardinality r = 0 ∨
      (MachineAxisAddress axis (rangeFirst r) ∧ MachineAxisAddress axis (rangeLast r))

def SliceAddresses (ranges : Region64) (selectors : List SliceIndex64) : Prop :=
  Coordinatewise SliceAxisAddress ranges selectors

/-- Mathematical stride after composing two affine coordinate maps, reduced only in this
specification to the signed machine residue. -/
def SliceStrideValue (axis : OrdinalRange64) (selector : SliceIndex64) : Int :=
  match selector with
  | .colon => (rangeStep axis).val
  | .ordinal r => lineSignedResidue ((rangeStep axis).val * (rangeStep r).val)

def SliceStartValue (axis : OrdinalRange64) (selector : SliceIndex64) : Int :=
  match selector with
  | .colon => (rangeFirst axis).val
  | .ordinal r => lineSignedResidue
      ((rangeFirst axis).val + ((rangeFirst r).val - 1) * (rangeStep axis).val)

/-- An empty selected progression cannot be stored if its adjacent excluded endpoint would
leave Int64. This independent representability condition explains _empty_stop OverflowError;
it does not invoke that helper or a constructor. -/
def EmptySliceEndpointUnavailable (axis : OrdinalRange64) (selector : SliceIndex64) : Prop :=
  match selector with
  | .colon => False
  | .ordinal r =>
    rangeCardinality r = 0 ∧
      ((0 < SliceStrideValue axis selector ∧ SliceStartValue axis selector = IntTy.min .i64) ∨
       (SliceStrideValue axis selector ≤ 0 ∧ SliceStartValue axis selector = IntTy.max .i64))

/-- Result family constraints of built-in selection, independent of the dispatch code. -/
def SliceResultTag (input : OrdinalRange64) (selector : SliceIndex64)
    (output : OrdinalRange64) : Prop :=
  match selector with
  | .colon => ConversionContracts.SameStoredTag input output
  | .ordinal index =>
    match input, index, output with
    | .oneTo _, .oneTo _, .oneTo _ => True
    | .oneTo _, .unit _, .unit _ | .unit _, .oneTo _, .unit _ | .unit _, .unit _, .unit _ => True
    | .stepped _, _, .stepped _ | _, .stepped _, .stepped _ => True
    | _, _, _ => False

/-- Slicing composes two mathematical coordinate maps. The result cardinality equals the
selector cardinality, and every position agrees modulo Int64 with the selected source point.
Colon preserves the full original sequence. This does not replay start/length/stop construction
and deliberately includes overflow, huge selectors and empty axes. -/
def SliceAxisGeometry (input : OrdinalRange64) (selector : SliceIndex64)
    (output : OrdinalRange64) : Prop :=
  SliceResultTag input selector output ∧
  match selector with
  | .colon => ConversionContracts.SameAxisValues input output
  | .ordinal index =>
    rangeCardinality output = rangeCardinality index ∧
      ∀ n : Nat, n < rangeCardinality index →
        (rangeFirst output).val + (n : Int) * (rangeStep output).val =
          lineSignedResidue ((rangeFirst input).val +
            ((rangeFirst index).val + (n : Int) * (rangeStep index).val - 1) *
              (rangeStep input).val)

def SliceRegionGeometry (ranges : Region64) (selectors : List SliceIndex64)
    (output : Region64) : Prop :=
  RegionDomain output ∧ output.length = ranges.length ∧
    ∀ (k : Nat) (axis : OrdinalRange64) (selector : SliceIndex64),
      ranges[k]? = some axis → selectors[k]? = some selector →
      ∃ result : OrdinalRange64, output[k]? = some result ∧ SliceAxisGeometry axis selector result

/-- Full represented slicing outcome: bounds failures are explained by machine addresses;
empty-endpoint OverflowError and wrapped-zero-stride ArgumentError are justified explicitly.
Successful output must have the independent composed sequence and dispatch type. -/
def SliceRegionOutcome (ranges : Region64) (selectors : List SliceIndex64)
    (outcome : RegionResult Region64) : Prop :=
  match outcome with
  | .ok output => SliceAddresses ranges selectors ∧ SliceRegionGeometry ranges selectors output
  | .error (.jl .boundsError) => ¬SliceAddresses ranges selectors
  | .error (.jl (.overflowError _)) =>
    SliceAddresses ranges selectors ∧
      ∃ (k : Nat) (axis : OrdinalRange64) (selector : SliceIndex64),
        ranges[k]? = some axis ∧ selectors[k]? = some selector ∧
          EmptySliceEndpointUnavailable axis selector
  | .error (.jl (.argumentError _)) =>
    SliceAddresses ranges selectors ∧
      ∃ (k : Nat) (axis : OrdinalRange64) (selector : SliceIndex64),
        ranges[k]? = some axis ∧ selectors[k]? = some selector ∧ SliceStrideValue axis selector = 0
  | .error _ => False

