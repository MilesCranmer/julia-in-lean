def AxisSequenceRelation (original result : OrdinalRange64) (reversed : Bool) : Prop :=
  rangeCardinality result = rangeCardinality original ∧
  ∀ position : Nat, position < rangeCardinality original →
    (rangeFirst result).val + (position : Int) * (rangeStep result).val =
      (rangeFirst original).val +
        ((if reversed then rangeCardinality original - 1 - position else position : Nat) : Int) *
          (rangeStep original).val

