abbrev IndexObservationM (E S : Type) := ExceptT (Sum Error E) (StateT S Option)

local instance indexObservationError {E S : Type} : MonadExceptOf Error (IndexObservationM E S) where
  throw error := ExceptT.mk fun state => some (.error (.inl error), state)
  tryCatch action handler := ExceptT.mk fun state =>
    match action.run state with
    | none => none
    | some (.ok value, state') => some (.ok value, state')
    | some (.error (.inl error), state') => (handler error).run state'
    | some (.error error, state') => some (.error error, state')

def observeIndexAction {E S Event A : Type} (action : IndexObservationM E S A)
    (event : Except (Sum Error E) A → Event) :
    IndexObservationM E (S × List (S × S × Event)) A :=
  ExceptT.mk fun (state, events) =>
    match action.run state with
    | none => none
    | some (result, state') => some (result, (state', events ++ [(state, state', event result)]))

/-- Independent per-type dimension accounting from manual/arrays.md:534-547,
799-824,874-883. A checked rank is retained as metadata, not executed as a tuple
constructor. -/
inductive IndexRankContribution where
  | fixed (count : Nat)
  | checked (rank : Models1Group6.TypeRank)

def indexRankContribution (mode : IndexRankMode) : Models1Group6.IndexMetadata → IndexRankContribution
  | .cartesian coordinates => if mode = .consumed then .fixed coordinates.length else .fixed 0
  | .cartesianArray arrayRank elementRank =>
      .checked (if mode = .consumed then elementRank else arrayRank)
  | .array rank => if mode = .consumed then .fixed 1 else .checked rank
  | .colon | .boolArray _ => .fixed 1
  | .other => if mode = .consumed then .fixed 1 else .fixed 0

def indexRankContributionCount : IndexRankContribution → Nat
  | .fixed count => count
  | .checked (.machineInt value) => value.val.toNat
  | .checked .other => 0

/-- Zero denotes the native Int assertion failure; one denotes negative rank.
The corresponding error message is deliberately not used as an oracle. -/
def indexRankFailure : IndexRankContribution → Option Nat
  | .fixed _ => none
  | .checked .other => some 0
  | .checked (.machineInt value) => if value.val < 0 then some 1 else none

def indexRankFailureClass (failure : Nat) (error : Error) : Prop :=
  (failure = 0 ∧ error = .typeError) ∨
  (failure = 1 ∧ ∃ message, error = .argumentError message)

def indexRankRequirements {C : Type} (mode : IndexRankMode) (inputs : List (IndexRankInput C)) :=
  inputs.map fun input => indexRankContribution mode (indexRankMetadata input)

def indexRankCount {C : Type} (mode : IndexRankMode) (inputs : List (IndexRankInput C)) : Nat :=
  ((indexRankRequirements mode inputs).map indexRankContributionCount).sum

def IndexRankValid {C : Type} (mode : IndexRankMode) (inputs : List (IndexRankInput C)) : Prop :=
  (indexRankRequirements mode inputs).filterMap indexRankFailure = []

def IndexRankConstructible {C : Type} (inputs : List (IndexRankInput C)) : Prop :=
  (inputs.length : Int) ≤ IntTy.max .i64 ∧
  ∀ input ∈ inputs, ∀ coordinates,
    indexRankMetadata input = Models1Group6.IndexMetadata.cartesian coordinates →
      (coordinates.length : Int) ≤ IntTy.max .i64

def IndexRankMathematicalOutcome {C V T E : Type} (mode : IndexRankMode)
    (inputs : List (IndexRankInput C))
    (actual : Except (Sum Error E) (IndexRankResult V T)) : Prop :=
  match ((indexRankRequirements mode inputs).filterMap indexRankFailure).head? with
  | some failure => ∃ error, actual = .error (.inl error) ∧ indexRankFailureClass failure error
  | none => actual = .ok (.inl (List.replicate (indexRankCount mode inputs) (.inl true)))

inductive IndexRankEvent (E C V T : Type) where
  | selected (mode : IndexRankMode) (inputs : List (IndexRankInput C))
      (result : Except (Sum Error E) (IndexRankResult V T))
  | splat (initialPart : List (Sum Bool V)) (iterable : T)
      (result : Except (Sum Error E) (List (Sum Bool V)))

def observeIndexRankOps {E S C V T : Type} (ops : IndexRankOps (IndexObservationM E S) C V T) :
    IndexRankOps (IndexObservationM E (S × List (S × S × IndexRankEvent E C V T))) C V T where
  selected := fun mode inputs => (ops.selected mode inputs).map fun action =>
    observeIndexAction action (.selected mode inputs)
  applyIterateOther := fun initialPart iterable => observeIndexAction
    (ops.applyIterateOther initialPart iterable) (.splat initialPart iterable)

/-- A flat, nonrecursive trace specification. Before a selected recursive
call, the native prefix contributes its independent mathematical dimension
sum. Exactly one custom call is possible. A non-tuple return causes exactly
one later splat at its immediate parent; known tuple ancestors only prepend
their own true-marker counts. Every exception is preserved at its actual event.
No callee behavior is assumed. -/
def IndexRankTraceMeaning {E C V T : Type} (mode : IndexRankMode)
    (inputs : List (IndexRankInput C)) (events : List (IndexRankEvent E C V T))
    (actual : Except (Sum Error E) (IndexRankResult V T)) : Prop :=
  match events with
  | [] => IndexRankMathematicalOutcome mode inputs actual
  | [.selected observedMode selected result] =>
      observedMode = mode ∧ selected ≠ [] ∧ indexRankHasCustom selected = true ∧
      ∃ initialPart, initialPart ≠ [] ∧ inputs = initialPart ++ selected ∧ IndexRankValid mode initialPart ∧
        match result with
        | .error error => actual = .error error
        | .ok (.inl fields) => actual = .ok (.inl
            (List.replicate (indexRankCount mode initialPart) (.inl true) ++ fields))
        | .ok (.inr _) => False
  | [.selected observedMode selected (.ok (.inr iterable)), .splat markers argument result] =>
      observedMode = mode ∧ selected ≠ [] ∧ indexRankHasCustom selected = true ∧ argument = iterable ∧
      ∃ initialPart parent, inputs = initialPart ++ (parent :: selected) ∧
        IndexRankValid mode (initialPart ++ [parent]) ∧
        markers = List.replicate (indexRankCount mode [parent]) (.inl true) ∧
        match result with
        | .error error => actual = .error error
        | .ok fields => actual = .ok (.inl
            (List.replicate (indexRankCount mode initialPart) (.inl true) ++ fields))
  | _ => False

/-- Full-domain rank invariant for the seven source entries, including raw
rank errors, both optional-generated branches, custom recursive returns,
non-tuple iteration, state changes and exceptions. Only actual input/coordinate
tuple arities are bounded; there is no aggregate output bound. The ordinary
tuple representation/allocation abstraction is inherited. Source:
base/multidimensional.jl:792-809; base/ntuple.jl:65-72. -/
def IndexRankCompleteProtocol : Prop :=
  ∀ (E S C V T : Type) (ops : IndexRankOps (IndexObservationM E S) C V T)
    (mode : IndexRankMode) (generated : Bool) (head : IndexRankInput C)
    (tail : List (IndexRankInput C)) (initial : S),
    IndexRankConstructible (head :: tail) →
    match (indexRankMethod (observeIndexRankOps ops) mode generated head tail).run (initial, []) with
    | none => True
    | some (result, (final, records)) =>
        RegionConversionStateThread initial final records ∧
        IndexRankTraceMeaning mode (head :: tail) (records.map fun r => r.2.2) result

/-- Every native rank tuple has the documented sum of per-index contributions,
with first relevant invalid metadata selecting TypeError or ArgumentError.
Custom array payloads and data storage cannot affect this concrete instantiation.
This independently tests both marker computations and the full recursive
implementation. -/
def IndexRankNativeAccounting : Prop :=
  ∀ (mode : IndexRankMode) (generated : Bool) (head : Models1Group6.IndexMetadata)
    (tail : List Models1Group6.IndexMetadata),
    let inputs : List (IndexRankInput Empty) := (head :: tail).map IndexRankInput.native
    IndexRankConstructible inputs →
    let ops : IndexRankOps (IndexObservationM Empty Unit) Empty Empty Empty := {
      applyIterateOther := fun _ impossible => nomatch impossible }
    match (indexRankMethod ops mode generated (.native head) (tail.map IndexRankInput.native)).run () with
    | some (result, ()) => IndexRankMathematicalOutcome mode inputs result
    | none => False

inductive IndexMetadataEvent (E R A C V T : Type) where
  | length (reference : A) (result : Except (Sum Error E) (Models1Group6.MetadataValue V))
  | fields (mode : IndexMetadataMode) (reference : A)
      (result : Except (Sum Error E) (IndexMetadataResult V T))
  | selected (mode : IndexMetadataMode) (inputs : List (Models1Group6.MetadataInput R A C))
      (result : Except (Sum Error E) (IndexMetadataResult V T))
  | splat (mode : IndexMetadataMode) (head tail : IndexMetadataResult V T)
      (result : Except (Sum Error E) (List (Models1Group6.MetadataValue V)))

def observeIndexMetadataOps {E S R A C V T : Type}
    (ops : IndexMetadataOps (IndexObservationM E S) R A C V T) :
    IndexMetadataOps (IndexObservationM E (S × List (S × S × IndexMetadataEvent E R A C V T))) R A C V T where
  length := fun reference => observeIndexAction (ops.length reference) (.length reference)
  axes := fun reference => observeIndexAction (ops.axes reference) (.fields .shape reference)
  size := fun reference => observeIndexAction (ops.size reference) (.fields .sizes reference)
