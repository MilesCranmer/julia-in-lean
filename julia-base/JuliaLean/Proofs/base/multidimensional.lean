abbrev idx7_Input := JuliaLean.base.tuple.Index

def idx7_ScalarOutcome (input : idx7_Input) (outcome : Result I64) : Prop :=
  match outcome with
  | .ok result => ToIndicesArgumentConvertible (.scalar input) ∧ result.val = input.value
  | .error (.argumentError _) => ∃ value : Bool, input = .bool value
  | .error (.inexactError _) => input.value < IntTy.min .i64 ∨ IntTy.max .i64 < input.value
  | .error _ => False

theorem idx7_scalar_spec (array : Region64) (input : idx7_Input) :
    idx7_ScalarOutcome input (IndexNormalization.scalar array input) := by
  cases input with
  | bool value => exact ⟨value, rfl⟩
  | integer t value =>
    by_cases h : IntTy.min .i64 ≤ value.val ∧ value.val ≤ IntTy.max .i64
    · simp only [IndexNormalization.scalar, JuliaLean.base.indices.to_index_A_i,
        IndexNormalization.scalarCore, JuliaLean.base.indices.to_index,
        JuliaLean.base.indices.to_index_Integer, JuliaLean.base.indices.convert_Int_BitInteger,
        JuliaLean.base.int.convert, JInt.convert, h, dite_eq_left,
        Except.mapError, Bind.bind, Except.bind, Pure.pure, Except.pure]
      exact ⟨h, rfl⟩
    · simp only [IndexNormalization.scalar, JuliaLean.base.indices.to_index_A_i,
        IndexNormalization.scalarCore, JuliaLean.base.indices.to_index,
        JuliaLean.base.indices.to_index_Integer, JuliaLean.base.indices.convert_Int_BitInteger,
        JuliaLean.base.int.convert, JInt.convert, h, dite_eq_right,
        Except.mapError, Bind.bind, Except.bind]
      change value.val < IntTy.min .i64 ∨ IntTy.max .i64 < value.val
      omega
  | big value =>
    by_cases h : IntTy.min .i64 ≤ value ∧ value ≤ IntTy.max .i64
    · simp only [IndexNormalization.scalar, JuliaLean.base.indices.to_index_A_i,
        IndexNormalization.scalarCore, JuliaLean.base.indices.to_index_Integer,
        JInt.convert, h, dite_eq_left, Except.mapError, Bind.bind, Except.bind]
      exact ⟨h, rfl⟩
    · simp only [IndexNormalization.scalar, JuliaLean.base.indices.to_index_A_i,
        IndexNormalization.scalarCore, JuliaLean.base.indices.to_index_Integer,
        JInt.convert, h, dite_eq_right, Except.mapError, Bind.bind, Except.bind]
      change value < IntTy.min .i64 ∨ IntTy.max .i64 < value
      omega

theorem idx7_scalar_i64 (array : Region64) (value : I64) :
    IndexNormalization.scalar array (.integer .i64 value) = .ok value := by
  simp only [IndexNormalization.scalar, JuliaLean.base.indices.to_index_A_i,
    IndexNormalization.scalarCore, JuliaLean.base.indices.to_index,
    JuliaLean.base.indices.to_index_Integer, JuliaLean.base.indices.convert_Int_BitInteger,
    JuliaLean.base.int.convert, JInt.convert, value.property, and_self, dite_true, ite_true,
    Except.mapError, Bind.bind, Except.bind, Pure.pure, Except.pure]

theorem idx7_ordinal (array : Region64) (value : OrdinalRange64) :
    IndexNormalization.ordinal array value = .ok (.ordinal value) := rfl

theorem idx7_int_nat (n : Nat) (hn : (n : Int) ≤ IntTy.max .i64) :
    (int n).val = n := by
  exact wrapInt_of_inRange .i64 (n : Int)
    ⟨by change (-9223372036854775808 : Int) ≤ (n : Int); omega, hn⟩

theorem idx7_split_nat {A : Type} (axes : List A) (n : Nat)
    (hn : (n : Int) ≤ IntTy.max .i64) :
    splitTupleChecked axes (.machine (int n)) = .ok (axes.take n, axes.drop n) := by
  have hv := idx7_int_nat n hn
  have hnot : ¬ (int n).val < 0 := by omega
  simp only [splitTupleChecked, referenceTuple, hnot, ite_false]
  simp only [hv, Int.toNat_natCast]
  have h := split1_and_rest_eq axes (List.replicate n true)
  simp only [List.length_replicate] at h
  change Except.ok (split1Dispatch axes (List.replicate n true),
    splitrestDispatch axes (List.replicate n true)) = _
  rw [h.1, h.2]


def idx7_head (array : Region64) (axes : IndexAxes64) :
    IndexArgument64 → Result (List NormalizedIndex64)
  | .scalar value => do
    let value ← IndexNormalization.scalar array value
    return [.scalar value]
  | .cartesian values => .ok (values.map NormalizedIndex64.scalar)
  | .region [] => .ok [.region []]
  | .region values => .ok (values.map NormalizedIndex64.ordinal)
  | .ordinal value => .ok [.ordinal value]
  | .colon => .ok [IndexNormalization.colon axes]

def idx7_run (array : Region64) (axes : IndexAxes64) :
    List IndexArgument64 → Result (List NormalizedIndex64)
  | [] => .ok []
  | input :: inputs => do
    let first ← idx7_head array axes input
    let rest ← idx7_run array (axes.drop (ToIndicesAxisConsumption input)) inputs
    return first ++ rest

theorem idx7_map_ordinals (array : Region64) (values : Region64) :
    values.mapM (IndexNormalization.ordinal array) =
      .ok (values.map NormalizedIndex64.ordinal) := by
  induction values with
  | nil => rfl
  | cons x xs ih =>
    simp only [List.mapM_cons, idx7_ordinal, List.map_cons, ih,
      Bind.bind, Except.bind, Pure.pure, Except.pure]

theorem idx7_map_cartesian (array : Region64) (values : CI) :
    values.mapM (fun coordinate => NormalizedIndex64.scalar <$>
      IndexNormalization.scalar array (.integer .i64 coordinate)) =
      .ok (values.map NormalizedIndex64.scalar) := by
  induction values with
  | nil => rfl
  | cons x xs ih =>
    simp only [List.mapM_cons, idx7_scalar_i64, List.map_cons, ih,
      Functor.map, Except.map, Bind.bind, Except.bind, Pure.pure, Except.pure] at ih ⊢
    rw [ih]

section

theorem idx7_model_step (array : Region64) (input : IndexArgument64)
    (inputs : List IndexArgument64) (valid : ToIndicesArgumentValid input)
    (ih : ∀ axes, toIndicesOnRegion array axes inputs = idx7_run array axes inputs)
    (axes : IndexAxes64) :
    toIndicesOnRegion array axes (input :: inputs) = idx7_run array axes (input :: inputs) := by
  cases input with
  | scalar value =>
    rw [toIndicesOnRegion.eq_def]
    change (do
      let head ← IndexNormalization.scalar array value
      let remaining ← toIndicesOnRegion array axes.tail inputs
      return NormalizedIndex64.scalar head :: remaining) = _
    rw [ih axes.tail]
    change (do
      let head ← IndexNormalization.scalar array value
      let remaining ← idx7_run array axes.tail inputs
      return NormalizedIndex64.scalar head :: remaining) = (do
        let front ← idx7_head array axes (.scalar value)
        let rest ← idx7_run array (axes.drop 1) inputs
        return front ++ rest)
    rw [List.drop_one]
    simp only [idx7_head]
    cases IndexNormalization.scalar array value <;> rfl
  | ordinal value =>
    rw [toIndicesOnRegion.eq_def]
    change (do
      let head ← IndexNormalization.ordinal array value
      let remaining ← toIndicesOnRegion array axes.tail inputs
      return head :: remaining) = _
    rw [idx7_ordinal, ih axes.tail]
    change (do
      let remaining ← idx7_run array axes.tail inputs
      return NormalizedIndex64.ordinal value :: remaining) = (do
        let remaining ← idx7_run array (axes.drop 1) inputs
        return NormalizedIndex64.ordinal value :: remaining)
    rw [List.drop_one]
  | colon =>
    rw [toIndicesOnRegion.eq_def]
    change (do
      let remaining ← toIndicesOnRegion array axes.tail inputs
      return IndexNormalization.colon axes :: remaining) = _
    rw [ih axes.tail]
    change (do
      let remaining ← idx7_run array axes.tail inputs
      return IndexNormalization.colon axes :: remaining) = (do
        let remaining ← idx7_run array (axes.drop 1) inputs
        return IndexNormalization.colon axes :: remaining)
    rw [List.drop_one]
  | cartesian values =>
    rw [toIndicesOnRegion.eq_def]
    change (do
      let (_, tailaxes) ← splitTupleChecked axes (.machine (int values.length))
      let converted ← values.mapM (fun coordinate => NormalizedIndex64.scalar <$>
        IndexNormalization.scalar array (.integer .i64 coordinate))
      let remaining ← toIndicesOnRegion array tailaxes inputs
      return converted ++ remaining) = _
    rw [idx7_split_nat axes values.length valid]
    change (do
      let converted ← values.mapM (fun coordinate => NormalizedIndex64.scalar <$>
        IndexNormalization.scalar array (.integer .i64 coordinate))
      let remaining ← toIndicesOnRegion array (axes.drop values.length) inputs
      return converted ++ remaining) = _
    rw [idx7_map_cartesian, ih (axes.drop values.length)]
    rfl
  | region values =>
    cases values with
    | nil =>
      rw [toIndicesOnRegion.eq_def]
      change (do
        let remaining ← toIndicesOnRegion array axes inputs
        return NormalizedIndex64.region [] :: remaining) = _
      rw [ih axes]
      rfl
    | cons axis values =>
      rw [toIndicesOnRegion.eq_def]
      change (do
        let (_, tailaxes) ← splitTupleChecked axes (.machine (int (axis :: values).length))
        let converted ← (axis :: values).mapM (IndexNormalization.ordinal array)
        let remaining ← toIndicesOnRegion array tailaxes inputs
        return converted ++ remaining) = _
      rw [idx7_split_nat axes (axis :: values).length valid.1]
      change (do
        let converted ← (axis :: values).mapM (IndexNormalization.ordinal array)
        let remaining ← toIndicesOnRegion array (axes.drop (axis :: values).length) inputs
        return converted ++ remaining) = _
      rw [idx7_map_ordinals, ih (axes.drop (axis :: values).length)]
      rfl

theorem idx7_model (array : Region64) (inputs : List IndexArgument64)
    (valid : ∀ input ∈ inputs, ToIndicesArgumentValid input) :
    ∀ axes, toIndicesOnRegion array axes inputs = idx7_run array axes inputs := by
  induction inputs with
  | nil => intro axes; rw [toIndicesOnRegion.eq_def]; rfl
  | cons input inputs ih =>
    have hv := valid input (List.mem_cons_self ..)
    have ht : ∀ item ∈ inputs, ToIndicesArgumentValid item :=
      fun item hm => valid item (List.mem_cons_of_mem _ hm)
    exact idx7_model_step array input inputs hv (ih ht)

end

theorem idx7_get_map_prefix {A B : Type} (f : A → B) (xs : List A) (ys : List B)
    (k : Nat) (x : A) (h : xs[k]? = some x) :
    (xs.map f ++ ys)[k]? = some (f x) := by
  induction xs generalizing k with
  | nil => simp only [List.getElem?_nil] at h; cases h
  | cons a xs ih =>
    cases k with
    | zero =>
      simp only [List.getElem?_cons_zero] at h
      cases h
      rfl
    | succ k =>
      simp only [List.getElem?_cons_succ] at h
      simp only [List.map_cons, List.cons_append, List.getElem?_cons_succ]
      exact ih k h


def idx7_HeadOutcome (axes : IndexAxes64) (input : IndexArgument64)
    (outcome : Result (List NormalizedIndex64)) : Prop :=
  match outcome with
  | .ok fields =>
    ToIndicesArgumentConvertible input ∧ fields.length = ToIndicesOutputWidth input ∧
      ∀ tail, ToIndicesOutputPosition axes [input] (fields ++ tail) 0 input
  | .error (.argumentError _) => ∃ value : Bool, input = .scalar (.bool value)
  | .error (.inexactError _) => ∃ value : idx7_Input, input = .scalar value ∧
      (value.value < IntTy.min .i64 ∨ IntTy.max .i64 < value.value)
  | .error _ => False

theorem idx7_head_spec (array : Region64) (axes : IndexAxes64) (input : IndexArgument64) :
    idx7_HeadOutcome axes input (idx7_head array axes input) := by
  cases input with
  | scalar value =>
    have spec := idx7_scalar_spec array value
    cases hs : IndexNormalization.scalar array value with
    | ok converted =>
      rw [hs] at spec
      simp only [idx7_head, hs, Bind.bind, Except.bind, Pure.pure, Except.pure]
      refine ⟨spec.1, rfl, ?_⟩
      intro tail
      exact ⟨converted, rfl, spec.2⟩
    | error error =>
      rw [hs] at spec
      simp only [idx7_head, hs, Bind.bind, Except.bind]
      cases error <;> try exact False.elim spec
      · obtain ⟨b, hb⟩ := spec
        exact ⟨b, congrArg IndexArgument64.scalar hb⟩
      · exact ⟨value, rfl, spec⟩
  | ordinal value => exact ⟨True.intro, rfl, fun _ => rfl⟩
  | cartesian values =>
    refine ⟨True.intro, List.length_map _, ?_⟩
    intro tail component coordinate h
    simpa only [List.take_zero, List.map_nil, List.sum_nil, Nat.zero_add] using
      idx7_get_map_prefix NormalizedIndex64.scalar values tail component coordinate h
  | region values =>
    cases values with
    | nil => exact ⟨True.intro, rfl, fun _ => rfl⟩
    | cons axis axes' =>
      refine ⟨True.intro, List.length_map _, ?_⟩
      intro tail component coordinate h
      simpa only [List.take_zero, List.map_nil, List.sum_nil, Nat.zero_add] using
        idx7_get_map_prefix NormalizedIndex64.ordinal (axis :: axes') tail component coordinate h
  | colon =>
    refine ⟨True.intro, rfl, ?_⟩
    intro tail
    cases axes with
    | nil =>
      refine ⟨⟨.oneTo (JInt.lit .i64 1)⟩, ?_, rfl⟩
      change some (IndexNormalization.colon []) =
        some (.slice ⟨.oneTo (JInt.lit .i64 1)⟩)
      decide
    | cons axis axes => exact ⟨⟨axis⟩, rfl, rfl⟩


theorem idx7_get_suffix {A : Type} (front rest : List A) (k : Nat) :
    (front ++ rest)[front.length + k]? = rest[k]? := by
  rw [List.getElem?_append_right (by omega)]
  congr 1
  omega

theorem idx7_shift_position (axes : IndexAxes64) (head : IndexArgument64)
    (inputs : List IndexArgument64) (front output : List NormalizedIndex64)
    (hlen : front.length = ToIndicesOutputWidth head)
    (position : Nat) (input : IndexArgument64)
    (h : ToIndicesOutputPosition (axes.drop (ToIndicesAxisConsumption head))
      inputs output position input) :
    ToIndicesOutputPosition axes (head :: inputs) (front ++ output) (position + 1) input := by
  have hget (k : Nat) :
      (front ++ output)[ToIndicesOutputWidth head + k]? = output[k]? := by
    rw [← hlen, idx7_get_suffix]
  simpa only [ToIndicesOutputPosition, List.take_succ_cons, List.map_cons,
    List.sum_cons, Nat.add_assoc, hget, List.getElem?_drop] using h

theorem idx7_earlier_cons (head : IndexArgument64) (inputs : List IndexArgument64)
    (position : Nat) (hhead : ToIndicesArgumentConvertible head)
    (hprior : ToIndicesEarlierValid inputs position) :
    ToIndicesEarlierValid (head :: inputs) (position + 1) := by
  intro earlier input hlt hget
  cases earlier with
  | zero =>
    simp only [List.getElem?_cons_zero] at hget
    cases hget
    exact hhead
  | succ earlier =>
    exact hprior earlier input (by omega) hget

theorem idx7_run_spec (array : Region64) (inputs : List IndexArgument64) :
    ∀ axes, ToIndicesOutcome axes inputs (idx7_run array axes inputs) := by
  induction inputs with
  | nil =>
    intro axes
    refine ⟨?_, rfl, ?_⟩
    · intro input hm
      cases hm
    · intro position input hget
