def NativeBoolConversionConservation : Prop :=
  ∀ (type : IntTy) (value : JInt type),
    let checked : RealBoolEqualityOps Result (JInt type) (Sum Bool Empty) := {
      equal := fun actual literal => .ok (.inl (JuliaLean.base.int.eq actual literal)) }
