    .axisFirst axis (.ok origin) ∈ events ∧
    .subtract left origin (.ok answer.1) ∈ events ∧
    .subtract right left (.ok width) ∈ events ∧
    .add width (int 1) (.ok answer.2.1) ∈ events ∧
    (answer.1.val + origin.val - left.val) % (2^64 : Int) = 0 ∧
    (answer.2.1.val - 1 - right.val + left.val) % (2^64 : Int) = 0

