inductive SingletonIncrementEvent (E R StepValue LastValue Coordinate Valid : Type) where
  | step (range : R) (result : Except E StepValue)
  | add (state : I64) (stride : StepValue) (result : Except E Coordinate)
  | last (range : R) (result : Except E LastValue)
  | notEqual (state : I64) (last : LastValue) (result : Except E Valid)

def singletonIncrementPhase {E R StepValue LastValue Coordinate Valid : Type} :
    SingletonIncrementEvent E R StepValue LastValue Coordinate Valid → Nat
  | .step _ _ => 0
  | .add _ _ _ => 1
  | .last _ _ => 2
  | .notEqual _ _ _ => 3

def singletonIncrementError {E R StepValue LastValue Coordinate Valid : Type} :
    SingletonIncrementEvent E R StepValue LastValue Coordinate Valid → Option E
  | .step _ (.error error) => some error
  | .add _ _ (.error error) => some error
  | .last _ (.error error) => some error
  | .notEqual _ _ (.error error) => some error
  | _ => none

def observeSingletonIncrementOps {E S R StepValue LastValue Coordinate Valid : Type}
    (ops : SingletonIncrementOps (DimensionObservationM E S)
      R StepValue LastValue Coordinate Valid) :
    SingletonIncrementOps
      (DimensionObservationM E
        (S × List (S × S × SingletonIncrementEvent E R StepValue LastValue Coordinate Valid)))
      R StepValue LastValue Coordinate Valid where
  step := fun range => observeDimensionAction (ops.step range) (.step range)
  wrappingAdd := fun state stride =>
    observeDimensionAction (ops.wrappingAdd state stride) (.add state stride)
  last := fun range => observeDimensionAction (ops.last range) (.last range)
  notEqual := fun state last =>
    observeDimensionAction (ops.notEqual state last) (.notEqual state last)

/-- Argument identity and actual data dependencies, without any arithmetic
or observation law for the selected methods. -/
def SingletonIncrementArguments {E R StepValue LastValue Coordinate Valid : Type}
    (state : I64) (range : R)
    (events : List (SingletonIncrementEvent E R StepValue LastValue Coordinate Valid)) : Prop :=
  ∀ event ∈ events, match event with
    | .step actual _ | .last actual _ => actual = range
    | .add actual stride _ =>
        actual = state ∧ .step range (.ok stride) ∈ events
    | .notEqual actual last _ =>
        actual = state ∧ .last range (.ok last) ∈ events

/-- A singleton output is preserved even when validity is false or has a
custom type. Completed operations form the exact source-order prefix; errors
are the last operation's exact error and all state changes remain visible. -/
def SingletonIncrementObservation {E S R StepValue LastValue Coordinate Valid : Type}
    (state : I64) (range : R) (initial : S)
    (outcome : Option (Except E (Valid × List Coordinate) ×
      (S × List (S × S × SingletonIncrementEvent E R StepValue LastValue Coordinate Valid)))) : Prop :=
  match outcome with
  | none => True
  | some (result, (final, records)) =>
      let events := records.map (fun record => record.2.2)
      let phases := events.map singletonIncrementPhase
      DimensionStateThread initial final records ∧
      SingletonIncrementArguments state range events ∧
      (∃ remaining, phases ++ remaining = [0, 1, 2, 3]) ∧
      (∀ (k : Nat) (event : SingletonIncrementEvent E R StepValue LastValue Coordinate Valid),
        events[k]? = some event → ∀ error, singletonIncrementError event = some error →
          k + 1 = events.length ∧ result = .error error) ∧
      match result with
      | .ok (valid, coordinates) =>
          phases = [0, 1, 2, 3] ∧
          ∃ stride last coordinate,
            coordinates = [coordinate] ∧
            .add state stride (.ok coordinate) ∈ events ∧
            .notEqual state last (.ok valid) ∈ events
      | .error error =>
          ∃ event, events.getLast? = some event ∧ singletonIncrementError event = some error

/-- Narrow internal invariant over every native state coordinate, arbitrary
range subtype, all selected callees, all independent intermediate result
types, errors and shared mutations. It imposes no iterator-state membership
or truth-valued-return premise.
Source: base/multidimensional.jl:469-474. -/
def SingletonIncrementObservations : Prop :=
  ∀ (E S R StepValue LastValue Coordinate Valid : Type)
    (ops : SingletonIncrementOps (DimensionObservationM E S)
      R StepValue LastValue Coordinate Valid)
    (state : I64) (range : R) (world : S),
    SingletonIncrementObservation state range world
      ((incrementSingleton (observeSingletonIncrementOps ops) state range).run (world, []))

/-- Installed native range observations and exact native +% primitive. -/
def nativeSingletonIncrementOps :
    SingletonIncrementOps RangeResult OrdinalRange64 I64 I64 I64 Bool where
  step := fun range => .ok (rangeStep range)
  wrappingAdd := fun state stride => .ok (JuliaLean.base.int.addWrap state stride)
  last := fun range => .ok (rangeLast range)
  notEqual := fun state last => .ok (state != last)

/-- The advanced coordinate is congruent to state+stride modulo 2^64.
Validity depends only on equality to the stored stop, so even invalid or
out-of-range continuation coordinates are advanced without an added bounds
test. Includes overflow, empty ranges and every native coordinate.
Source: base/multidimensional.jl:469-474; base/int.jl:93. -/
def NativeSingletonIncrementCorrect : Prop :=
  ∀ (state : I64) (range : OrdinalRange64),
    match incrementSingleton nativeSingletonIncrementOps state range with
    | .ok (valid, [coordinate]) =>
        (valid = true ↔ state.val ≠ (rangeLast range).val) ∧
        (coordinate.val - state.val - (rangeStep range).val) % ((2 : Int) ^ 64) = 0
    | _ => False

