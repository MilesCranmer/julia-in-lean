abbrev DimensionObservationM (E S : Type) := ExceptT E (StateT S Option)

inductive DimensionStage where
  | oneto | first | step | last | unitColon | ordinalColon

inductive DimensionEvent (E Input First StepValue Last V : Type) where
  | oneto (input : Input) (result : Except E V)
  | first (input : Input) (result : Except E First)
  | step (input : Input) (result : Except E StepValue)
  | last (input : Input) (result : Except E Last)
  | unitColon (first : First) (last : Last) (result : Except E V)
  | ordinalColon (first : First) (step : StepValue) (last : Last) (result : Except E V)

abbrev DimensionRecord (E S Input First StepValue Last V : Type) :=
  S × S × DimensionEvent E Input First StepValue Last V

def observeDimensionAction {E S Event A : Type}
    (action : DimensionObservationM E S A) (event : Except E A → Event) :
    DimensionObservationM E (S × List (S × S × Event)) A :=
  ExceptT.mk fun (state, events) =>
    match action.run state with
    | none => none
    | some (result, state') =>
        some (result, (state', events ++ [(state, state', event result)]))


theorem observeDimensionAction_run {E S Event A : Type}
    (action : Models2Group3.DimensionObservationM E S A) (event : Except E A → Event)
    (state : S) (events : List (S × S × Event)) :
    (Models2Group3.observeDimensionAction action event).run (state, events) =
      match action.run state with
      | none => none
      | some (result, state') =>
          some (result, (state', events ++ [(state, state', event result)])) := rfl

theorem observeDimensionAction_bind_run {E S Event A B : Type}
    (action : Models2Group3.DimensionObservationM E S A) (event : Except E A → Event)
    (next : A → Models2Group3.DimensionObservationM E (S × List (S × S × Event)) B)
    (state : S) (events : List (S × S × Event)) :
    (Bind.bind (Models2Group3.observeDimensionAction action event) next).run (state, events) =
      match action.run state with
      | none => none
      | some (.error err, state') =>
          some (.error err, (state', events ++ [(state, state', event (.error err))]))
      | some (.ok val, state') =>
          (next val).run (state', events ++ [(state, state', event (.ok val))]) := by
  simp only [Models2Group3.observeDimensionAction, ExceptT.run, ExceptT.mk, Bind.bind,
    ExceptT.bind, ExceptT.bindCont, StateT.bind, Option.bind]
  cases action state with
  | none => rfl
  | some p => rcases p with ⟨res, s'⟩; cases res <;> rfl

def observeIntegerDimensionOps {E S I V : Type}
    (ops : IntegerDimensionOps (DimensionObservationM E S) I V) :
    IntegerDimensionOps
      (DimensionObservationM E (S × List (DimensionRecord E S I Unit Unit Unit V))) I V where
  oneto := fun input => observeDimensionAction (ops.oneto input) (.oneto input)

def observeUnitDimensionOps {E S R First Last V : Type}
    (ops : UnitDimensionOps (DimensionObservationM E S) R First Last V) :
    UnitDimensionOps
      (DimensionObservationM E (S × List (DimensionRecord E S R First Unit Last V)))
      R First Last V where
  first := fun range => observeDimensionAction (ops.first range) (.first range)
  last := fun range => observeDimensionAction (ops.last range) (.last range)
  colon := fun first last => observeDimensionAction (ops.colon first last) (.unitColon first last)

def observeOrdinalDimensionOps {E S R First StepValue Last V : Type}
    (ops : OrdinalDimensionOps (DimensionObservationM E S) R First StepValue Last V) :
    OrdinalDimensionOps
      (DimensionObservationM E (S × List (DimensionRecord E S R First StepValue Last V)))
      R First StepValue Last V where
  first := fun range => observeDimensionAction (ops.first range) (.first range)
  step := fun range => observeDimensionAction (ops.step range) (.step range)
  last := fun range => observeDimensionAction (ops.last range) (.last range)
  colon := fun first step last =>
    observeDimensionAction (ops.colon first step last) (.ordinalColon first step last)

def dimensionStage {E Input First StepValue Last V : Type} :
    DimensionEvent E Input First StepValue Last V → DimensionStage
  | .oneto _ _ => .oneto
  | .first _ _ => .first
  | .step _ _ => .step
  | .last _ _ => .last
  | .unitColon _ _ _ => .unitColon
  | .ordinalColon _ _ _ _ => .ordinalColon

def dimensionError {E Input First StepValue Last V : Type} :
    DimensionEvent E Input First StepValue Last V → Option E
  | .oneto _ (.error error) => some error
  | .first _ (.error error) => some error
  | .step _ (.error error) => some error
  | .last _ (.error error) => some error
  | .unitColon _ _ (.error error) => some error
  | .ordinalColon _ _ _ (.error error) => some error
  | _ => none

def dimensionReturn {E Input First StepValue Last V : Type} :
    DimensionEvent E Input First StepValue Last V → Option (Except E V)
  | .oneto _ result => some result
  | .unitColon _ _ result => some result
  | .ordinalColon _ _ _ result => some result
  | _ => none

/-- All range observations use the original object. Colon receives precisely
the independently observed endpoint/stride results, with no conversion. -/
def DimensionArgumentCoherence {E Input First StepValue Last V : Type}
    (input : Input) (events : List (DimensionEvent E Input First StepValue Last V)) : Prop :=
  ∀ event ∈ events, match event with
    | .oneto actual _ | .first actual _ | .step actual _ | .last actual _ => actual = input
    | .unitColon first last _ =>
        .first input (.ok first) ∈ events ∧ .last input (.ok last) ∈ events
    | .ordinalColon first step last _ =>
        .first input (.ok first) ∈ events ∧ .step input (.ok step) ∈ events ∧
          .last input (.ok last) ∈ events

def DimensionStateThread {S Event : Type} (initial final : S)
    (records : List (S × S × Event)) : Prop :=
  (match records.head? with
   | none => final = initial
   | some record => record.1 = initial) ∧
  (∀ (record : S × S × Event), records.getLast? = some record → final = record.2.1) ∧
  (∀ (k : Nat) (left right : S × S × Event),
    records[k]? = some left → records[k + 1]? = some right → left.2.1 = right.1)


theorem dimensionStateThread_one {S Event : Type} (s0 s1 : S) (e1 : Event) :
    Models2Group3.DimensionStateThread s0 s1 [(s0, s1, e1)] := by
  refine ⟨rfl, ?_, ?_⟩
  · intro r hr; injection hr with hr; subst hr; rfl
  · intro k l r hl hr; cases k with | zero => cases hr | succ k => cases hl

theorem dimensionStateThread_two {S Event : Type} (s0 s1 s2 : S) (e1 e2 : Event) :
    Models2Group3.DimensionStateThread s0 s2 [(s0, s1, e1), (s1, s2, e2)] := by
  refine ⟨rfl, ?_, ?_⟩
  · intro r hr; injection hr with hr; subst hr; rfl
  · intro k l r hl hr
    cases k with
    | zero => injection hl with hl; injection hr with hr; subst hl hr; rfl
    | succ k => cases k with | zero => cases hr | succ k => cases hl

theorem dimensionStateThread_three {S Event : Type} (s0 s1 s2 s3 : S) (e1 e2 e3 : Event) :
    Models2Group3.DimensionStateThread s0 s3 [(s0, s1, e1), (s1, s2, e2), (s2, s3, e3)] := by
  refine ⟨rfl, ?_, ?_⟩
  · intro r hr; injection hr with hr; subst hr; rfl
  · intro k l r hl hr
    cases k with
    | zero => injection hl with hl; injection hr with hr; subst hl hr; rfl
    | succ k =>
        cases k with
        | zero => injection hl with hl; injection hr with hr; subst hl hr; rfl
        | succ k => cases k with | zero => cases hr | succ k => cases hl

theorem dimensionStateThread_four {S Event : Type} (s0 s1 s2 s3 s4 : S) (e1 e2 e3 e4 : Event) :
    Models2Group3.DimensionStateThread s0 s4 [(s0, s1, e1), (s1, s2, e2), (s2, s3, e3), (s3, s4, e4)] := by
  refine ⟨rfl, ?_, ?_⟩
  · intro r hr; injection hr with hr; subst hr; rfl
  · intro k l r hl hr
    cases k with
    | zero => injection hl with hl; injection hr with hr; subst hl hr; rfl
    | succ k =>
        cases k with
        | zero => injection hl with hl; injection hr with hr; subst hl hr; rfl
        | succ k =>
            cases k with
            | zero => injection hl with hl; injection hr with hr; subst hl hr; rfl
            | succ k => cases k with | zero => cases hr | succ k => cases hl

/-- Independent call-order, argument, and mutation invariant. A failure is
the exact last reached interface failure; success completes every stage and
returns the final oneto/colon result unchanged. -/
def DimensionObservation {E S Input First StepValue Last V : Type}
    (expected : List DimensionStage) (input : Input) (initial : S)
    (outcome : Option (Except E V ×
      (S × List (DimensionRecord E S Input First StepValue Last V)))) : Prop :=
  match outcome with
  | none => True
  | some (result, (final, records)) =>
      let events := records.map (fun record => record.2.2)
      let stages := events.map dimensionStage
      DimensionStateThread initial final records ∧
      DimensionArgumentCoherence input events ∧
      (∃ remaining, stages ++ remaining = expected) ∧
      (∀ (k : Nat) (event : DimensionEvent E Input First StepValue Last V),
        events[k]? = some event → ∀ error : E, dimensionError event = some error →
          k + 1 = events.length ∧ result = .error error) ∧
      match result with
      | .ok value =>
          stages = expected ∧
          ∃ event, events.getLast? = some event ∧ dimensionReturn event = some (.ok value)
      | .error error =>
          ∃ event, events.getLast? = some event ∧ dimensionError event = some error

/-- The three _convert2ind bodies preserve original arguments, source-order
observations, arbitrary intermediate return types, mutations, and exceptions.
No oneto/endpoint/colon correctness law is assumed. These are narrow internal
composition invariants, not an invented geometric contract for custom ranges.
Source: base/multidimensional.jl:311-313. -/
def DimensionNormalizationObservations : Prop :=
  (∀ (E S I V : Type) (ops : IntegerDimensionOps (DimensionObservationM E S) I V)
    (input : I) (state : S),
    DimensionObservation [.oneto] input state
      ((normalizeIntegerDimension (observeIntegerDimensionOps ops) input).run (state, []))) ∧
  (∀ (E S R First Last V : Type)
    (ops : UnitDimensionOps (DimensionObservationM E S) R First Last V)
    (input : R) (state : S),
    DimensionObservation [.first, .last, .unitColon] input state
      ((normalizeUnitDimension (observeUnitDimensionOps ops) input).run (state, []))) ∧
  (∀ (E S R First StepValue Last V : Type)
    (ops : OrdinalDimensionOps (DimensionObservationM E S) R First StepValue Last V)
    (input : R) (state : S),
    DimensionObservation [.first, .step, .last, .ordinalColon] input state
      ((normalizeOrdinalDimension (observeOrdinalDimensionOps ops) input).run (state, [])))

open JuliaLean.base.multidimensional.Models1Group5.RangeDependencies

/-- Both installed native AbstractUnitRange variants, including unchecked
OneTo values whose stored stop may be negative. -/
abbrev NativeUnitInput :=
  Sum (JuliaLean.base.range.OneTo I64) (JuliaLean.base.range.UnitRange I64)

def nativeUnitRange : NativeUnitInput → OrdinalRange64
  | .inl value => .oneTo value
  | .inr value => .unit value

local instance : JuliaLean.base.range.JOneTo1 I64 OrdinalRange64 := ⟨rangeOneTo⟩
local instance : JuliaLean.base.range.JUnitRangeT I64 I64 I64 := ⟨makeUnit⟩

/-- Native instantiations call the installed OneTo/UnitRange/StepRange
constructors and native range observations. The generic models retain their
open dispatch domain; these definitions only provide closed test instances. -/
def nativeIntegerDimensionOps : IntegerDimensionOps RangeResult I64 OrdinalRange64 where
  oneto := JuliaLean.base.range.oneto

def nativeUnitDimensionOps :
    UnitDimensionOps RangeResult NativeUnitInput I64 I64 OrdinalRange64 where
  first := fun range => .ok (rangeFirst (nativeUnitRange range))
  last := fun range => .ok (rangeLast (nativeUnitRange range))
  colon := fun first last =>
    (JuliaLean.base.range.colon_T_T_Real first last).map OrdinalRange64.unit

def nativeOrdinalDimensionOps :
    OrdinalDimensionOps RangeResult OrdinalRange64 I64 I64 I64 OrdinalRange64 where
  first := fun range => .ok (rangeFirst range)
  step := fun range => .ok (rangeStep range)
  last := fun range => .ok (rangeLast range)
  colon := rangeStepped

/-- Mathematical membership in an integer progression, with no machine
length calculation and no copied stop-normalization algorithm. -/
def NativeRangeLattice (first stride last point : Int) : Prop :=
  ∃ k : Nat, point = first + (k : Int) * stride ∧
    ((0 < stride ∧ point ≤ last) ∨ (stride < 0 ∧ last ≤ point))

/-- Independent native consequences: Integer dimensions clamp their length
at zero; unit and stepped normalization preserve the whole mathematical
point set and the starting point/stride, while retaining the constructor's
actual result type. RangeConstructible is the installed representation
invariant, including empty and full-width lazy ranges; no cardinality or
coordinate-value restriction is added.
Source: base/multidimensional.jl:311-313; base/range.jl:41-55,344-349,428,487-491. -/
def NativeDimensionNormalizationCorrect : Prop :=
  (∀ size : I64,
    match normalizeIntegerDimension nativeIntegerDimensionOps size with
    | .ok (.oneTo range) => range.stop.val = max 0 size.val
    | _ => False) ∧
  (∀ input : NativeUnitInput,
    let original := nativeUnitRange input
    match normalizeUnitDimension nativeUnitDimensionOps input with
    | .ok (.unit range) =>
        range.start = rangeFirst original ∧
        ∀ point : Int,
          (range.start.val ≤ point ∧ point ≤ range.stop.val) ↔
            ((rangeFirst original).val ≤ point ∧ point ≤ (rangeLast original).val)
    | _ => False) ∧
  (∀ original : OrdinalRange64, RangeConstructible original →
    match normalizeOrdinalDimension nativeOrdinalDimensionOps original with
    | .ok (.stepped range) =>
        range.start = rangeFirst original ∧ range.step = rangeStep original ∧
        ∀ point : Int,
          NativeRangeLattice range.start.val range.step.val range.stop.val point ↔
            NativeRangeLattice (rangeFirst original).val (rangeStep original).val
              (rangeLast original).val point
    | _ => False)

/-- Reopen the specification-only injection for the constructor's type-bound
failure while allowing arbitrary additional values to be thrown by callees. -/
local instance regionObservationError {Extra S : Type} :
    MonadExceptOf Error (ConstructorObservationM Extra S) :=
  constructorObservationError

inductive RegionEvent (Extra R Native Other : Type) where
  | convert (range : R) (result : Except (Sum Error Extra) (Sum Native Other))
  | selectedMap (ranges : List R)
      (result : Except (Sum Error Extra) (Sum (List (Sum Native Other)) Other))
  | splat (head : Sum Native Other) (tail : Other)
      (result : Except (Sum Error Extra) (List (Sum Native Other)))
  | construct (rank : I64) (fields : List Native)
      (result : Except (Sum Error Extra) (Sum (List Native) Other))

abbrev RegionRecord (Extra S R Native Other : Type) :=
  S × S × RegionEvent Extra R Native Other

def observeOrdinalRegionOps {Extra S R Native Other : Type}
    (ops : OrdinalRegionOps (ConstructorObservationM Extra S) R Native Other) :
    OrdinalRegionOps
      (ConstructorObservationM Extra (S × List (RegionRecord Extra S R Native Other)))
      R Native Other where
  convertRange := fun range =>
    observeConstructorAction (ops.convertRange range) (.convert range)
  selectedMap := fun _ ranges => (ops.selectedMap ops.convertRange ranges).map fun action =>
    observeConstructorAction action (.selectedMap ranges)
  applyIterateOther := fun head tail =>
    observeConstructorAction (ops.applyIterateOther head tail) (.splat head tail)
  selectedConstructor := fun rank fields => (ops.selectedConstructor rank fields).map fun action =>
    observeConstructorAction action (.construct rank fields)

def regionEventError {Extra R Native Other : Type} :
    RegionEvent Extra R Native Other → Option (Sum Error Extra)
  | .convert _ (.error error) => some error
  | .selectedMap _ (.error error) => some error
  | .splat _ _ (.error error) => some error
  | .construct _ _ (.error error) => some error
  | _ => none

def regionMapError {Extra R Native Other : Type} :
    RegionEvent Extra R Native Other → Option (Sum Error Extra)
  | .construct _ _ _ => none
  | event => regionEventError event

def regionConversionValues {Extra R Native Other : Type}
    (events : List (RegionEvent Extra R Native Other)) : List (Sum Native Other) :=
  events.filterMap fun event => match event with
    | .convert _ (.ok value) => some value
    | _ => none

def regionMapEvents {Extra R Native Other : Type}
    (events : List (RegionEvent Extra R Native Other)) :
    List (List R × Except (Sum Error Extra) (Sum (List (Sum Native Other)) Other)) :=
  events.filterMap fun event => match event with
    | .selectedMap ranges result => some (ranges, result)
    | _ => none

def regionSplatEvents {Extra R Native Other : Type}
    (events : List (RegionEvent Extra R Native Other)) :
    List (Sum Native Other × Other × Except (Sum Error Extra) (List (Sum Native Other))) :=
  events.filterMap fun event => match event with
    | .splat head tail result => some (head, tail, result)
    | _ => none

def regionConstructorEvents {Extra R Native Other : Type}
    (events : List (RegionEvent Extra R Native Other)) :
    List (I64 × List Native × Except (Sum Error Extra) (Sum (List Native) Other)) :=
  events.filterMap fun event => match event with
    | .construct rank fields result => some (rank, fields, result)
    | _ => none

/-- Call order as a flat prefix invariant. Each conversion uses the same
original positional reference. A selected map can replace only its actual
whole tuple or recursive suffix; an opaque non-tuple tail is splatted once,
using the immediately preceding converted head. Construction is last. -/
def RegionEventOrder {Extra R Native Other : Type} (ranges : List R)
    (events : List (RegionEvent Extra R Native Other)) : Prop :=
  ∀ (k : Nat) (event : RegionEvent Extra R Native Other), events[k]? = some event →
    match event with
    | .convert range _ =>
        ranges[k]? = some range ∧
        ∀ (j : Nat) (earlier : RegionEvent Extra R Native Other),
          j < k → events[j]? = some earlier →
          ∃ input result, earlier = .convert input result
    | .selectedMap actual _ =>
        actual = ranges.drop k ∧ actual ≠ [] ∧
        (k = 0 ∨ (ranges.length < 32 ∧ 3 ≤ actual.length)) ∧
        ∀ (j : Nat) (earlier : RegionEvent Extra R Native Other),
          j < k → events[j]? = some earlier →
          ∃ input result, earlier = .convert input result
    | .splat head tail _ =>
        ∃ initialPart input rest,
          k = initialPart + 2 ∧
          events[initialPart]? = some (.convert input (.ok head)) ∧
          events[initialPart + 1]? = some (.selectedMap rest (.ok (.inr tail)))
    | .construct rank _ _ =>
        ranges ≠ [] ∧ rank.val = (ranges.length : Int) ∧ k + 1 = events.length

/-- Conservation of mapped fields, expressed by a completed conversion
prefix and at most one substituted suffix. It does not rerun tuple-map
recursion or invoke any model helper. Selected non-tuples at the root remain
non-tuples; a recursive non-tuple tail contributes the actual splat result.
-/
def RegionCompletedMapping {Extra R Native Other : Type} (ranges : List R)
    (events : List (RegionEvent Extra R Native Other))
    (mapped : Sum (List (Sum Native Other)) Other) : Prop :=
  let converted := regionConversionValues events
  match regionMapEvents events with
  | [] =>
      converted.length = ranges.length ∧ regionSplatEvents events = [] ∧
        mapped = .inl converted
  | [(actual, .ok (.inl tail))] =>
      actual = ranges.drop converted.length ∧ regionSplatEvents events = [] ∧
        mapped = .inl (converted ++ tail)
  | [(actual, .ok (.inr other))] =>
      actual = ranges.drop converted.length ∧
      ((converted = [] ∧ regionSplatEvents events = [] ∧ mapped = .inr other) ∨
       ∃ initialPart head fields,
         converted = initialPart ++ [head] ∧
         regionSplatEvents events = [(head, other, .ok fields)] ∧
         mapped = .inl (initialPart ++ fields))
  | _ => False

/-- The field type bound is stated positionally, independently of the
model's native-field projection. -/
def RegionNativeTuple {Native Other : Type}
    (fields : List (Sum Native Other)) (native : List Native) : Prop :=
  fields.length = native.length ∧
  ∀ (k : Nat) (value : Sum Native Other), fields[k]? = some value →
    ∃ stored : Native, native[k]? = some stored ∧ value = .inl stored

/-- Type application precedes constructor dispatch and follows every map
effect. A valid bound stores the exact fields or preserves the selected
constructor return; invalid kinds, arities, or field types raise TypeError
without calling a constructor. -/
def RegionFinalBound {Extra R Native Other : Type} (ranges : List R)
    (events : List (RegionEvent Extra R Native Other))
    (mapped : Sum (List (Sum Native Other)) Other)
    (result : Except (Sum Error Extra) (Sum (List Native) Other)) : Prop :=
  match mapped with
  | .inr _ => result = .error (.inl .typeError) ∧ regionConstructorEvents events = []
  | .inl fields =>
      (∃ native : List Native, fields.length = ranges.length ∧ RegionNativeTuple fields native ∧
        (regionConstructorEvents events = [] ∧ result = .ok (.inl native) ∨
         ∃ rank : I64, rank.val = (ranges.length : Int) ∧
           regionConstructorEvents events = [(rank, native, result)])) ∨
      (result = .error (.inl .typeError) ∧ regionConstructorEvents events = [] ∧
        (fields.length ≠ ranges.length ∨
         ∃ (k : Nat) (other : Other), fields[k]? = some (.inr other)))

def RegionObservation {Extra S R Native Other : Type} (ranges : List R) (initial : S)
    (outcome : Option (Except (Sum Error Extra) (Sum (List Native) Other) ×
      (S × List (RegionRecord Extra S R Native Other)))) : Prop :=
  match outcome with
  | none => True
  | some (result, (final, records)) =>
      let events := records.map (fun record => record.2.2)
      ConstructorStateThread initial final records ∧ RegionEventOrder ranges events ∧
      (∀ (k : Nat) (event : RegionEvent Extra R Native Other), events[k]? = some event →
        ∀ error, regionEventError event = some error →
          k + 1 = events.length ∧ result = .error error) ∧
      ((∀ event ∈ events, regionMapError event = none) →
        ∃ mapped, RegionCompletedMapping ranges events mapped ∧
          RegionFinalBound ranges events mapped result)

/-- The full source domain, including custom OrdinalRange conversion,
selected whole/tail maps, non-tuple splatting, selected constructors, aliasing,
arbitrary thrown values, and mutation before a final type-bound error. Wrong
conversion types cannot terminate the conversion prefix early. The only
input premise is constructible Julia tuple arity.
Source: base/multidimensional.jl:294-302; base/tuple.jl:358-401. -/
def OrdinalRegionObservations : Prop :=
  ∀ (Extra S R Native Other : Type)
    (ops : OrdinalRegionOps (ConstructorObservationM Extra S) R Native Other)
    (ranges : List R) (state : S), TupleArity ranges →
    RegionObservation ranges state
      ((regionFromOrdinalRanges (observeOrdinalRegionOps ops) ranges).run (state, []))

