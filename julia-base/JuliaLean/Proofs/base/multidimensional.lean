  obtain ⟨k, hk, he⟩ := List.mem_map.mp hm
  rw [← he]
  simp only [Int.ofNat_eq_natCast, Int.natCast_add, Int.natCast_one]
  omega

theorem permMapRangeZip {α β : Type} (xs : List α) (ys : List β)
    (defaultA : α) (defaultB : β) (hlen : xs.length = ys.length) :
    (List.range ys.length).map (fun k => (xs[k]?.getD defaultA, ys[k]?.getD defaultB)) =
      xs.zip ys := by
  rw [← List.zip_map']
  rw [permMapRangeGet]
  have hx : (List.range ys.length).map (fun k => xs[k]?.getD defaultA) = xs := by
    rw [← hlen]
    exact permMapRangeGet xs defaultA
  rw [hx]

theorem permSourceLookup {α : Type} (xs : List α) (i : I64) (hi : 1 ≤ i.val) :
    tupleGet xs i =
      match xs[(i.val - 1).toNat]? with
      | none => .error .boundsError
      | some x => .ok x := by
  have he : i.val.toNat - 1 = (i.val - 1).toNat := by omega
  simp only [tupleGet, hi, ite_true, he]
  cases xs[(i.val - 1).toNat]? <;> rfl

theorem permForInCongr {α β : Type} (xs : List α)
    (f g : α → β → Result (ForInStep β))
    (h : ∀ x, x ∈ xs → ∀ b, f x b = g x b) (initial : β) :
    forIn xs initial f = forIn xs initial g := by
  induction xs generalizing initial with
  | nil => rfl
  | cons x xs ih =>
    simp only [List.forIn_cons]
    rw [h x (by simp only [List.mem_cons, true_or]) initial]
    cases hg : g x initial with
    | error error => rfl
    | ok step =>
      cases step with
      | done b => rfl
      | yield b =>
        apply ih
        intro y hy b
        exact h y (List.mem_cons_of_mem _ hy) b

def permOutcomeResult (outcomes : List (Result Bool)) : Result Unit :=
  match outcomes.find? (fun outcome => match outcome with
    | .ok true => false
    | _ => true) with
  | none => .ok ()
  | some (.ok _) => .error (.dimensionMismatch "destination tensor of incorrect size")
  | some (.error error) => .error error

theorem permOutcomeForIn (outcomes : List (Result Bool)) :
    (do
      for outcome in outcomes do
        if !(← outcome) then
          throw (.dimensionMismatch "destination tensor of incorrect size")
      return () : Result Unit) = permOutcomeResult outcomes := by
  induction outcomes with
  | nil => rfl
  | cons outcome outcomes ih =>
    cases outcome with
    | error error => rfl
    | ok b =>
      cases b with
      | false => rfl
      | true =>
        simpa only [List.forIn_cons, bind, Except.bind, pure, Except.pure,
          Bool.not_true, Bool.false_eq_true, ite_false, permOutcomeResult,
          List.find?_cons] using ih

def permAxisOutcome {Axis : Type} (axisEqual : Axis → Axis → Result Bool)
    (source : List Axis) (pair : Axis × I64) : Result Bool :=
  match source[(pair.2.val - 1).toNat]? with
  | none => .error .boundsError
  | some sourceAxis => axisEqual pair.1 sourceAxis

theorem permIndexedAxisComparisons {Axis : Type} (axisEqual : Axis → Axis → Result Bool)
    (destination source : List Axis) (permutation : ShortIntTuple) (default : Axis)
    (hlen : destination.length = permutation.val.length)
    (hpositive : ∀ i ∈ permutation.val, 1 ≤ i.val) :
    (do
      for dimension in JuliaLean.base.tuple.keysTuple permutation.val do
        let i := int dimension
        let destinationAxis ← tupleGet destination i
        let sourceDimension ← tupleGet permutation.val i
        let sourceAxis ← tupleGet source sourceDimension
        if !(← axisEqual destinationAxis sourceAxis) then
          throw (.dimensionMismatch "destination tensor of incorrect size")
      return () : Result Unit) =
      permOutcomeResult ((destination.zip permutation.val).map (permAxisOutcome axisEqual source)) := by
  rw [← permOutcomeForIn]
  rw [← permMapRangeZip destination permutation.val default (int 0) hlen]
  simp only [JuliaLean.base.tuple.keysTuple, JuliaLean.base.tuple.oneTo,
    JuliaLean.base.tuple.lengthTuple, List.forIn_map]
  apply congrArg (fun (action : Result PUnit) => action >>= fun _ => pure ())
  apply permForInCongr
  intro k hk state
  have hk' : k < permutation.val.length := List.mem_range.mp hk
  rw [permTupleGetAt destination default k (by omega) (by simpa only [hlen] using permutation.property),
    permTupleGetAt permutation.val (int 0) k hk' permutation.property]
  change (do
      let sourceAxis ← tupleGet source (permutation.val[k]?.getD (int 0))
      let equal ← axisEqual (destination[k]?.getD default) sourceAxis
      if !equal then throw (.dimensionMismatch "destination tensor of incorrect size")
      pure (ForInStep.yield PUnit.unit) : Result (ForInStep PUnit)) = _
  have hm : permutation.val[k]?.getD (int 0) ∈ permutation.val := by
    simp only [List.getElem?_eq_getElem hk', Option.getD_some]
    exact List.getElem_mem hk'
  rw [permSourceLookup source _ (hpositive _ hm)]
  unfold permAxisOutcome
  cases source[((permutation.val[k]?.getD (int 0)).val - 1).toNat]? <;> rfl

