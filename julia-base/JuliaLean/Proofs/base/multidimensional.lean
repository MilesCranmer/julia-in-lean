local instance partitionObservationError {E S : Type} :
    MonadExceptOf Error (ConstructorObservationM E S) := constructorObservationError

inductive PartitionSkipEvent (E Axis Outer Value Difference Count Endpoint Other : Type) where
  | axisFirst (axis : Axis) (reply : Except (Sum Error E) Value)
  | axisLast (axis : Axis) (reply : Except (Sum Error E) Value)
  | outerLength (outer : Outer) (reply : Except (Sum Error E) Endpoint)
  | outerFirst (outer : Outer) (reply : Except (Sum Error E) Endpoint)
  | outerLast (outer : Outer) (reply : Except (Sum Error E) Endpoint)
  | equalIndex (index : I64) (endpoint : Endpoint) (reply : Except (Sum Error E) (Sum Bool Other))
  | equalCartesian (index : CI) (endpoint : Endpoint) (reply : Except (Sum Error E) (Sum Bool Other))
  | subtract (left right : Value) (reply : Except (Sum Error E) Difference)
  | add (difference : Difference) (one : I64) (reply : Except (Sum Error E) Count)

def partitionSkipEventError {E A O V D C H X : Type} :
    PartitionSkipEvent E A O V D C H X → Option (Sum Error E)
  | .axisFirst _ (.error error) | .axisLast _ (.error error)
  | .outerLength _ (.error error) | .outerFirst _ (.error error) | .outerLast _ (.error error)
  | .equalIndex _ _ (.error error) | .equalCartesian _ _ (.error error)
  | .subtract _ _ (.error error) | .add _ _ (.error error) => some error
  | _ => none

def partitionSkipNonBool {E A O V D C H X : Type} :
    PartitionSkipEvent E A O V D C H X → Prop
  | .equalIndex _ _ (.ok (.inr _)) | .equalCartesian _ _ (.ok (.inr _)) => True
  | _ => False

def observePartitionArithmetic {E S A O V D C H X : Type}
    (ops : PartitionSkipArithmeticOps (ConstructorObservationM E S) A V D C) :
    PartitionSkipArithmeticOps
      (ConstructorObservationM E (S × List (S × S × PartitionSkipEvent E A O V D C H X)))
      A V D C where
  first := fun axis => observeConstructorAction (ops.first axis) (.axisFirst axis)
  last := fun axis => observeConstructorAction (ops.last axis) (.axisLast axis)
  subtract := fun left right => observeConstructorAction (ops.subtract left right) (.subtract left right)
  add := fun difference one => observeConstructorAction (ops.add difference one) (.add difference one)

def observePartitionIndexed {E S A O V D C H X : Type}
    (ops : PartitionSkipIndexedOps (ConstructorObservationM E S) A O V D C H X) :
    PartitionSkipIndexedOps
      (ConstructorObservationM E (S × List (S × S × PartitionSkipEvent E A O V D C H X)))
      A O V D C H X where
  arithmetic := observePartitionArithmetic ops.arithmetic
  length := fun outer => observeConstructorAction (ops.length outer) (.outerLength outer)
  equal := fun index endpoint => observeConstructorAction (ops.equal index endpoint) (.equalIndex index endpoint)

def observePartitionCartesian {E S A O V D C H X : Type}
    (ops : PartitionSkipCartesianOps (ConstructorObservationM E S) A O V D C H X) :
    PartitionSkipCartesianOps
      (ConstructorObservationM E (S × List (S × S × PartitionSkipEvent E A O V D C H X)))
      A O V D C H X where
  arithmetic := observePartitionArithmetic ops.arithmetic
  first := fun outer => observeConstructorAction (ops.first outer) (.outerFirst outer)
  last := fun outer => observeConstructorAction (ops.last outer) (.outerLast outer)
  equal := fun index endpoint => observeConstructorAction (ops.equal index endpoint) (.equalCartesian index endpoint)

/-- The observable order is a finite language of successful dispatch records.
It is stated independently of either implementation and contains actual input
references, captured endpoints and intermediate arithmetic values. -/
def PartitionIndexedSuccess {E A O V D C H X : Type}
    (axis : A) (outer : O) (fl fr : V) (i : I64) (index : CI)
    (events : List (PartitionSkipEvent E A O V D C H X))
    (answer : D × C × CI) : Prop :=
  answer.2.2 = index ∧
  ∃ (left right origin : V) (length : H) (ending : Bool) (width : D),
    (i.val = 1 → left = fl) ∧ (ending = true → right = fr) ∧
    events =
      (if i.val = 1 then [] else [.axisFirst axis (.ok left)]) ++
      [.outerLength outer (.ok length), .equalIndex i length (.ok (.inl ending))] ++
      (if ending then [] else [.axisLast axis (.ok right)]) ++
      [.axisFirst axis (.ok origin), .subtract left origin (.ok answer.1),
       .subtract right left (.ok width), .add width (int 1) (.ok answer.2.1)]

/-- Every successful rank-one local call preserves the original index and
its chosen endpoint references, including repeated reads. No equality or
arithmetic correctness premise is imposed on dispatched methods. -/
def PartitionCartesianSuccess {E A O V D C H X : Type}
    (axis : A) (outer : O) (fl fr : V) (coordinate : I64)
    (events : List (PartitionSkipEvent E A O V D C H X))
    (answer : D × C × CI) : Prop :=
  answer.2.2 = [coordinate] ∧
  ∃ (left right origin : V) (first last : H) (starting ending : Bool) (width : D),
    (starting = true → left = fl) ∧ (ending = true → right = fr) ∧
    events =
      [.outerFirst outer (.ok first), .equalCartesian [coordinate] first (.ok (.inl starting))] ++
      (if starting then [] else [.axisFirst axis (.ok left)]) ++
      [.outerLast outer (.ok last), .equalCartesian [coordinate] last (.ok (.inl ending))] ++
      (if ending then [] else [.axisLast axis (.ok right)]) ++
      [.axisFirst axis (.ok origin), .subtract left origin (.ok answer.1),
       .subtract right left (.ok width), .add width (int 1) (.ok answer.2.1)]

/-- Actual object identity, finite-call bounds, state continuity and precise
first-failure behavior. Boolean-context failure is separate from a callee's
arbitrary thrown value and retains the callee's mutations. -/
def PartitionSkipCommon {E S A O V D C H X : Type}
    (axis : A) (outer : O) (initial final : S) (bound : Nat)
    (records : List (S × S × PartitionSkipEvent E A O V D C H X))
