open JuliaLean.Proofs.base.multidimensional.Models1Group6.MaskAxesProtocol

theorem split_append_event {α : Type} (left right before : List α)
    (event : α) (after : List α)
    (h : left ++ right = before ++ event :: after) :
    (∃ leftBefore leftAfter,
      left = leftBefore ++ event :: leftAfter ∧ before = leftBefore ∧
        after = leftAfter ++ right) ∨
    (∃ rightBefore, before = left ++ rightBefore ∧
      right = rightBefore ++ event :: after) := by
  induction left generalizing before with
  | nil => exact .inr ⟨before, rfl, h⟩
  | cons head left ih =>
    cases before with
    | nil =>
      have hc := List.cons.inj h
      exact .inl ⟨[], left, congrArg (fun value => value :: left) hc.1,
        rfl, hc.2.symm⟩
    | cons first before =>
      have hc := List.cons.inj h
      rcases ih before hc.2 with hleft | hright
      · obtain ⟨leftBefore, leftAfter, hleft, hbefore, hafter⟩ := hleft
        exact .inl ⟨head :: leftBefore, leftAfter,
          congrArg (List.cons head) hleft,
          (congrArg (fun value => value :: before) hc.1.symm).trans
            (congrArg (List.cons head) hbefore), hafter⟩
      · obtain ⟨rightBefore, hbefore, hright⟩ := hright
        exact .inr ⟨rightBefore,
          (congrArg (fun value => value :: before) hc.1.symm).trans
            (congrArg (List.cons head) hbefore), hright⟩

def Custom {State Axis TypeTag Other : Type}
    (runtime : MaskAxesRuntime (Effects State) Axis TypeTag Other)
    (events : List (Event State Axis TypeTag Other)) : Prop :=
  (∀ before left native value after previous,
    events = before ++ Event.equal left (.native native) (.ok value) previous :: after →
    match runtime.missingExtension value with
    | none => True
    | some _ => ∃ observed next rest,
        after = Event.isMissing value observed next :: rest) ∧
  (∀ before value observed next after,
    events = before ++ Event.isMissing value observed next :: after →
    ∃ earlier left native previous,
      before = earlier ++ [Event.equal left (.native native) (.ok value) previous] ∧
      (match runtime.missingExtension value with | none => False | some _ => True))

def Nonterminal {State Axis TypeTag Other : Type}
    (runtime : MaskAxesRuntime (Effects State) Axis TypeTag Other)
    (events : List (Event State Axis TypeTag Other)) : Prop :=
  ∀ event ∈ events, TerminalObservation runtime event = none

def Stops {State Axis TypeTag Other : Type}
    (runtime : MaskAxesRuntime (Effects State) Axis TypeTag Other)
    (events : List (Event State Axis TypeTag Other))
    (result : Except Error (Option Bool)) (final : State) : Prop :=
  ∀ before event after expected,
    events = before ++ event :: after →
    TerminalObservation runtime event = some expected →
    after = [] ∧ result = expected ∧ final = stateAfter event

theorem Custom_nil {State Axis TypeTag Other : Type}
    (runtime : MaskAxesRuntime (Effects State) Axis TypeTag Other) : Custom runtime [] := by
  constructor
  · intro before left native value after previous h
    have hn := congrArg List.length h
    simp only [List.length_nil, List.length_append, List.length_cons] at hn
    omega
  · intro before value observed next after h
    have hn := congrArg List.length h
    simp only [List.length_nil, List.length_append, List.length_cons] at hn
    omega

theorem Custom_append {State Axis TypeTag Other : Type}
    (runtime : MaskAxesRuntime (Effects State) Axis TypeTag Other)
    (left right : List (Event State Axis TypeTag Other))
    (hleft : Custom runtime left) (hright : Custom runtime right) :
    Custom runtime (left ++ right) := by
  constructor
  · intro before operand native value after previous h
    rcases split_append_event left right before
        (.equal operand (.native native) (.ok value) previous) after h with hl | hr
    · obtain ⟨leftBefore, leftAfter, hparts, _, hafter⟩ := hl
      have hstep := hleft.1 leftBefore operand native value leftAfter previous hparts
      cases hext : runtime.missingExtension value with
      | none => simp only [hext]
      | some action =>
        simp only [hext] at hstep ⊢
        obtain ⟨observed, next, rest, hrest⟩ := hstep
        refine ⟨observed, next, rest ++ right, ?_⟩
        rw [hafter, hrest]
        rfl
    · obtain ⟨rightBefore, _, hparts⟩ := hr
      exact hright.1 rightBefore operand native value after previous hparts
  · intro before value observed next after h
    rcases split_append_event left right before
        (.isMissing value observed next) after h with hl | hr
    · obtain ⟨leftBefore, leftAfter, hparts, hbefore, _⟩ := hl
      obtain ⟨earlier, operand, native, previous, hprevious, hext⟩ :=
        hleft.2 leftBefore value observed next leftAfter hparts
      exact ⟨earlier, operand, native, previous, hbefore.trans hprevious, hext⟩
    · obtain ⟨rightBefore, hbefore, hparts⟩ := hr
      obtain ⟨earlier, operand, native, previous, hprevious, hext⟩ :=
        hright.2 rightBefore value observed next after hparts
      refine ⟨left ++ earlier, operand, native, previous, ?_, hext⟩
      rw [hbefore, hprevious, List.append_assoc]

theorem Nonterminal_nil {State Axis TypeTag Other : Type}
    (runtime : MaskAxesRuntime (Effects State) Axis TypeTag Other) :
    Nonterminal runtime [] := by
  intro event hmem
  cases hmem

theorem Nonterminal_append {State Axis TypeTag Other : Type}
    (runtime : MaskAxesRuntime (Effects State) Axis TypeTag Other)
    (left right : List (Event State Axis TypeTag Other)) :
    Nonterminal runtime (left ++ right) ↔
      Nonterminal runtime left ∧ Nonterminal runtime right := by
  constructor
  · intro h
    constructor
    · intro event hmem
      exact h event (List.mem_append.mpr (.inl hmem))
    · intro event hmem
      exact h event (List.mem_append.mpr (.inr hmem))
  · rintro ⟨hl, hr⟩ event hmem
    rcases List.mem_append.mp hmem with hmem | hmem
    · exact hl event hmem
    · exact hr event hmem

theorem Stops_nil {State Axis TypeTag Other : Type}
    (runtime : MaskAxesRuntime (Effects State) Axis TypeTag Other)
    (result : Except Error (Option Bool)) (final : State) :
    Stops runtime [] result final := by
  intro before event after expected h _
  have hn := congrArg List.length h
  simp only [List.length_nil, List.length_append, List.length_cons] at hn
  omega

theorem Stops_append {State Axis TypeTag Other : Type}
    (runtime : MaskAxesRuntime (Effects State) Axis TypeTag Other)
    (left right : List (Event State Axis TypeTag Other))
    (result : Except Error (Option Bool)) (final : State)
    (hleft : Nonterminal runtime left) (hright : Stops runtime right result final) :
    Stops runtime (left ++ right) result final := by
  intro before event after expected h hterminal
  rcases split_append_event left right before event after h with hl | hr
  · obtain ⟨leftBefore, leftAfter, hparts, _, _⟩ := hl
    have hmem : event ∈ left := by simp [hparts]
    have hnon := hleft event hmem
    rw [hnon] at hterminal
    cases hterminal
  · obtain ⟨rightBefore, _, hparts⟩ := hr
    exact hright rightBefore event after expected hparts hterminal

theorem EqualityCalls_append {State Axis TypeTag Other : Type}
    (left right : List (Event State Axis TypeTag Other)) :
    EqualityCalls (left ++ right) = EqualityCalls left ++ EqualityCalls right := by
  simp only [EqualityCalls, List.filterMap_append]

theorem AllEqualTrue_nil {State Axis TypeTag Other : Type} :
    AllEqualTrue ([] : List (Event State Axis TypeTag Other)) := by
  intro event hmem
  cases hmem

theorem AllEqualTrue_append {State Axis TypeTag Other : Type}
    (left right : List (Event State Axis TypeTag Other)) :
    AllEqualTrue (left ++ right) ↔ AllEqualTrue left ∧ AllEqualTrue right := by
  constructor
  · intro h
    constructor
    · intro event hmem
      exact h event (List.mem_append.mpr (.inl hmem))
    · intro event hmem
      exact h event (List.mem_append.mpr (.inr hmem))
  · rintro ⟨hl, hr⟩ event hmem
    rcases List.mem_append.mp hmem with hmem | hmem
    · exact hl event hmem
    · exact hr event hmem

def MissingValid {State Axis TypeTag Other : Type}
    (events : List (Event State Axis TypeTag Other)) : Prop :=
  ∀ event ∈ events,
    match event with
    | .equal _ (.observed _) result _ => result = .ok (.bool true)
    | .equal _ (.native _) result _ => ∃ value, result = .ok value
    | .isMissing _ result _ => ∃ value, result = .ok (.bool value)

def MissingWitness {State Axis TypeTag Other : Type}
    (runtime : MaskAxesRuntime (Effects State) Axis TypeTag Other)
    (events : List (Event State Axis TypeTag Other)) : Prop :=
  ∃ event ∈ events,
    match event with
    | .equal _ (.native _) (.ok .missing) _ =>
        match runtime.missingExtension .missing with
        | none => True
        | some _ => False
    | .isMissing _ (.ok (.bool true)) _ => True
    | _ => False

theorem MissingEvidence_iff {State Axis TypeTag Other : Type}
    (runtime : MaskAxesRuntime (Effects State) Axis TypeTag Other)
    (events : List (Event State Axis TypeTag Other)) :
    MissingEvidence runtime events ↔ MissingValid events ∧ MissingWitness runtime events :=
  Iff.rfl

theorem MissingValid_nil {State Axis TypeTag Other : Type} :
    MissingValid ([] : List (Event State Axis TypeTag Other)) := by
  intro event hmem
  cases hmem

theorem MissingValid_append {State Axis TypeTag Other : Type}
    (left right : List (Event State Axis TypeTag Other)) :
    MissingValid (left ++ right) ↔ MissingValid left ∧ MissingValid right := by
  constructor
  · intro h
    constructor
    · intro event hmem
      exact h event (List.mem_append.mpr (.inl hmem))
    · intro event hmem
      exact h event (List.mem_append.mpr (.inr hmem))
  · rintro ⟨hl, hr⟩ event hmem
    rcases List.mem_append.mp hmem with hmem | hmem
    · exact hl event hmem
    · exact hr event hmem

theorem MissingWitness_append {State Axis TypeTag Other : Type}
    (runtime : MaskAxesRuntime (Effects State) Axis TypeTag Other)
    (left right : List (Event State Axis TypeTag Other)) :
    MissingWitness runtime (left ++ right) ↔
      MissingWitness runtime left ∨ MissingWitness runtime right := by
  constructor
  · rintro ⟨event, hmem, hw⟩
    rcases List.mem_append.mp hmem with hmem | hmem
    · exact .inl ⟨event, hmem, hw⟩
    · exact .inr ⟨event, hmem, hw⟩
  · rintro (⟨event, hmem, hw⟩ | ⟨event, hmem, hw⟩)
    · exact ⟨event, List.mem_append.mpr (.inl hmem), hw⟩
    · exact ⟨event, List.mem_append.mpr (.inr hmem), hw⟩

theorem MissingEvidence_append {State Axis TypeTag Other : Type}
    (runtime : MaskAxesRuntime (Effects State) Axis TypeTag Other)
    (left right : List (Event State Axis TypeTag Other)) :
    MissingEvidence runtime (left ++ right) ↔
      MissingValid left ∧ MissingValid right ∧
        (MissingWitness runtime left ∨ MissingWitness runtime right) := by
  rw [MissingEvidence_iff, MissingValid_append, MissingWitness_append]
  exact and_assoc

theorem MissingEvidence_append_right {State Axis TypeTag Other : Type}
    (runtime : MaskAxesRuntime (Effects State) Axis TypeTag Other)
    (left right : List (Event State Axis TypeTag Other))
    (hl : MissingValid left) (hr : MissingEvidence runtime right) :
    MissingEvidence runtime (left ++ right) := by
  rw [MissingEvidence_iff] at hr
  exact (MissingEvidence_append runtime left right).mpr ⟨hl, hr.1, .inr hr.2⟩

end Models1Group6.Batch9.pr_TraceLists



