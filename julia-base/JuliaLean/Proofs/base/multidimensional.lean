inductive SimdIndexEvent (Extra R First Subscript Value Output : Type) where
  | firstindex (range : R) (result : Except (Sum Error Extra) First)
  | add (inner : I64) (first : First) (result : Except (Sum Error Extra) Subscript)
  | getindex (checkBounds : Bool) (range : R) (index : Subscript)
      (result : Except (Sum Error Extra) Value)
  | construct (coordinate : Value) (outer : CI) (result : Except (Sum Error Extra) Output)

def simdIndexPhase {Extra R First Subscript Value Output : Type} :
    SimdIndexEvent Extra R First Subscript Value Output → Nat
  | .firstindex _ _ => 0
  | .add _ _ _ => 1
  | .getindex _ _ _ _ => 2
  | .construct _ _ _ => 3

def simdIndexError {Extra R First Subscript Value Output : Type} :
    SimdIndexEvent Extra R First Subscript Value Output → Option (Sum Error Extra)
  | .firstindex _ (.error error) => some error
  | .add _ _ (.error error) => some error
  | .getindex _ _ _ (.error error) => some error
  | .construct _ _ (.error error) => some error
  | _ => none

def observeRegionSimdOps {Extra S R First Subscript Value Output : Type}
    (ops : RegionSimdIndexOps (ConstructorObservationM Extra S) R First Subscript Value Output) :
    RegionSimdIndexOps
      (ConstructorObservationM Extra
        (S × List (S × S × SimdIndexEvent Extra R First Subscript Value Output)))
      R First Subscript Value Output where
  firstindex := fun range => observeConstructorAction (ops.firstindex range) (.firstindex range)
  add := fun inner first => observeConstructorAction (ops.add inner first) (.add inner first)
  getindex := fun check range index =>
    observeConstructorAction (ops.getindex check range index) (.getindex check range index)
  construct := fun value outer =>
    observeConstructorAction (ops.construct value outer) (.construct value outer)

def SimdIndexArguments {Extra R First Subscript Value Output : Type}
    (checkBounds : Bool) (head : R) (outer : CI) (inner : I64)
    (events : List (SimdIndexEvent Extra R First Subscript Value Output)) : Prop :=
  ∀ event ∈ events, match event with
    | .firstindex actual _ => actual = head
    | .add actual first _ =>
        actual = inner ∧ .firstindex head (.ok first) ∈ events
    | .getindex actualCheck actualRange index _ =>
        actualCheck = checkBounds ∧ actualRange = head ∧
        ∃ first, .add inner first (.ok index) ∈ events
    | .construct value actualOuter _ =>
        actualOuter = outer ∧
        ∃ index, .getindex checkBounds head index (.ok value) ∈ events

/-- Complete source-order prefix, actual dataflow and state continuity.
Bounds context reaches indexing unchanged; success returns the constructor
result and errors stop later calls. Source: base/multidimensional.jl:519-520. -/
def SimdIndexObservation {Extra S R First Subscript Value Output : Type}
    (checkBounds : Bool) (head : R) (outer : CI) (inner : I64) (initial : S)
    (outcome : Option (Except (Sum Error Extra) Output ×
      (S × List (S × S × SimdIndexEvent Extra R First Subscript Value Output)))) : Prop :=
  match outcome with
  | none => True
  | some (result, (final, records)) =>
      let events := records.map (fun record => record.2.2)
      let phases := events.map simdIndexPhase
      ConstructorStateThread initial final records ∧
      SimdIndexArguments checkBounds head outer inner events ∧
      (∃ remaining, phases ++ remaining = [0, 1, 2, 3]) ∧
      (∀ (k : Nat) (event : SimdIndexEvent Extra R First Subscript Value Output),
        events[k]? = some event → ∀ error, simdIndexError event = some error →
          k + 1 = events.length ∧ result = .error error) ∧
      match result with
      | .ok value =>
          phases = [0, 1, 2, 3] ∧
          ∃ coordinate, events.getLast? = some (.construct coordinate outer (.ok value))
      | .error error =>
          ∃ event, events.getLast? = some event ∧ simdIndexError event = some error

