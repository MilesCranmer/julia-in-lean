  refine ⟨fun x => ⟨rfl, rfl⟩, ?_, ?_, ?_, ?_⟩
  · intro C A getidx setbit Bc src pos_s readC writeC bAnd bOr bNot shl
    have hle : ¬ (int 1 ≤ int 1 + int 0 - int 1) := by decide
