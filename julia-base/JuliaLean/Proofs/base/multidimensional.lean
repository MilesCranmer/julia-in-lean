private theorem mc_machine_arity {BigRef Custom : Type}
    (indices : List (MixedIndex BigRef Custom)) (values : CI)
    (h : mixedOnlyMachineInts indices = some values) :
    values.length = (indices.map Arity).sum := by
  induction indices generalizing values with
  | nil =>
      have hv : ([] : CI) = values := Option.some.inj h
      rw [← hv]
      rfl
  | cons head tail ih =>
      cases head with
      | cartesian coordinates => cases h
      | integer input =>
          cases input with
          | bool value => cases h
          | big reference => cases h
          | custom value => cases h
          | bits type value =>
              cases type with
              | i64 =>
                  simp only [mixedOnlyMachineInts] at h
                  cases ht : mixedOnlyMachineInts tail with
                  | none => simp only [ht, Option.map_none] at h; cases h
                  | some rest =>
                      simp only [ht, Option.map_some, Option.some.injEq] at h
                      rw [← h]
                      simp only [List.length_cons, List.map_cons, Arity, List.sum_cons]
                      have hr := ih rest ht
                      omega
              | i8 | i16 | i32 | i128 | u8 | u16 | u32 | u64 | u128 => cases h

private theorem mc_machine_none_append {BigRef Custom : Type}
    (earlier suffix : List (MixedIndex BigRef Custom))
