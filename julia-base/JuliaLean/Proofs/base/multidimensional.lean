def observeLogicalConstructorOps {S E M R B P O : Type}
    (ops : LogicalConstructorOps (AccessEffects S E) M R B P O) :
    LogicalConstructorOps
      (AccessEffects (S × List (S × S × LogicalConstructorEvent M R B P O E)) E) M R B P O where
  inner := {
    count := fun mask => observeAccessAction (ops.inner.count mask) (.count mask)
    toInt := fun value => observeAccessAction (ops.inner.toInt value) (.conversion value) }
  selected := fun element mask => (ops.selected element mask).map fun action =>
