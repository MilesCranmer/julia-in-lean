  by_cases h : logical.fields.sum.val < state.ordinal.val
  · simp only [h, decide_true, if_true]
    rfl
  · simp only [h, decide_false, Bool.false_eq_true, if_false]
    exact step_contract mask state.ordinal state.range state.cursor

