-/

/-- Removing the native one-based offsets from the two returned coordinates
and reconstructing with the stored divisor recovers the original zero-based
linear position modulo Int64. This is an algebraic conservation invariant,
not an assertion that arbitrary magic reciprocal fields calculate ordinary
mathematical division. It remains meaningful for every raw field observation,
including all native integer extrema and unchecked negative OneTo stops.

The expected equation is one mathematical expression reduced once; it does
not call the model's reciprocal division, division algorithm, remainder,
getter or addition helpers. No valid-inverse, successful-result, in-bounds,
nonzero-divisor or no-overflow premise is assumed. The actual result must be
successful, so an unexpected error also falsifies this native-projection law.
Source: base/multidimensional.jl:677-680; multinverses.jl:151-154.
-/
def NativeSplitReconstruction : Prop :=
  ∀ (axis : JuliaLean.base.multidimensional.Models1Group6.NativeSimd.Axis)
    (i : I64) (inverse : JuliaLean.base.multidimensional.Models1Group6.SignedInverse64),
    ∃ outer inner : I64,
      JuliaLean.base.multidimensional.Models1Group6.partitionSplitdim1NativeAxis
        axis i inverse = .ok (outer, inner) ∧
      JInt.wrap .i64 ((outer.val - 1) * inverse.divisor.val + inner.val - 1) =
        JInt.wrap .i64 (i.val - 1)


/-!
Independent, unproved native CartesianIndices array-bounds contracts. Every
list is a tuple or a mathematical sequence of dimensional obligations; none
represents ordinary Julia array storage.
-/

namespace NativeRegionBounds

abbrev Axis := NativeBounds.Axis
abbrev Component := NativeBounds.Component
abbrev Input := NativeBounds.Input
abbrev Region := JuliaLean.base.multidimensional.Models1Group6.NativeRegionBounds.Region

/-- An independent dimensional obligation: either one coordinate or the two
endpoints of one native range component, unless that component is empty.
The source may group such dimensions inside CartesianIndex or CartesianIndices
objects, but those grouping boundaries do not alter the dimensional contract.
-/
inductive Slot where
  | coordinate (value : I64)
  | component (range : Component)

/-- Independent per-axis acceptance. Emptiness applies separately to each
component, rather than to the Cartesian product as a whole. This is essential
for source786, which delegates to tuple bounds recursion. -/
def SlotAccepted (axis : Axis) : Slot → Prop
  | .coordinate value => NativeBounds.AxisAccepted axis value
  | .component range =>
      NativeBounds.ComponentEmpty range ∨
        (NativeBounds.AxisAccepted axis (NativeBounds.ComponentEndpoints range).1 ∧
         NativeBounds.AxisAccepted axis (NativeBounds.ComponentEndpoints range).2)

/-- A dimension beyond the target's tuple uses OneTo(1). An empty component
is accepted; a nonempty component must have both stored endpoints equal one.
-/
def ExtraSlotAccepted : Slot → Prop
  | .coordinate value => value.val = 1
  | .component range =>
      NativeBounds.ComponentEmpty range ∨
        ((NativeBounds.ComponentEndpoints range).1.val = 1 ∧
         (NativeBounds.ComponentEndpoints range).2.val = 1)

/-- Parallel dimensional contract using one zip and two suffixes. This does
not call the source split, component checker, mixed checker, or a recursive
copy of their control flow. Signed raw OneTo semantics are inherited from the
independent AxisAccepted predicate, and unused axes must be singleton.
-/
def SlotsAccepted (axes : List Axis) (slots : List Slot) : Prop :=
  (∀ pair ∈ axes.zip slots, SlotAccepted pair.1 pair.2) ∧
  (∀ slot ∈ slots.drop axes.length, ExtraSlotAccepted slot) ∧
  (∀ axis ∈ axes.drop slots.length, NativeBounds.SingletonAxis axis)

/-- Independent mathematical expansion only. The source never constructs
this concatenated sequence, so no aggregate machine-arity bound is imposed.
Each actual input tuple retains its own representation invariant below.
-/
def Obligations (region : Region) (tail : List Input) : List Slot :=
  region.map Slot.component ++
    (NativeBounds.ExpandedCoordinates tail).map Slot.coordinate

/-- Source782's native region-head closure satisfies the per-dimension contract
for every native axes tuple, stored component tuple and supported tail tuple.
Only actual tuple-field arities are assumed: the full head-plus-tail argument
tuple, each CartesianIndex coordinate tuple, axes tuple and CartesianIndices
component tuple must fit machine Int. No product-size, nonempty-region, in-bounds,
successful-execution, no-overflow, or aggregate expansion premise is used.

Both Bool outcomes are constrained, so an unexpected exception violates the
contract. Rank-zero regions contribute zero obligations and consume no axes;
other components still receive their own endpoint checks if one is empty.
Source: base/multidimensional.jl:782-787; abstractarray.jl:722-728,756-757.
-/
def HeadRegionProtocol : Prop :=
  ∀ (axes : List Axis) (region : Region) (tail : List Input),
    NativeBounds.TupleArity axes → NativeBounds.TupleArity region →
    NativeBounds.InputArities tail →
    (tail.length : Int) + 1 ≤ IntTy.max .i64 →
    let actual := JuliaLean.base.multidimensional.Models1Group6.NativeRegionBounds.checkHeadRegion
      axes region tail
    (actual = .ok true ↔ SlotsAccepted axes (Obligations region tail)) ∧
    (actual = .ok false ↔ ¬ SlotsAccepted axes (Obligations region tail))

/-- Source779's native CartesianIndices specialization agrees with the
independent component-wise bounds contract. Empty products are not treated as
universally valid: each nonempty component must fit its assigned axis. Actual
component/axis tuple arities are the only premises. This property concerns the
declared native field projection and does not assert that arbitrary target
axes metadata or arbitrary index-array storage has been implemented.
Source: base/multidimensional.jl:779-787.
-/
def OuterRegionProtocol : Prop :=
  ∀ (axes : List Axis) (region : Region),
    NativeBounds.TupleArity axes → NativeBounds.TupleArity region →
    let actual := JuliaLean.base.multidimensional.Models1Group6.NativeRegionBounds.checkboundsRegion
      axes region
    (actual = .ok true ↔ NativeBounds.ComponentsAccepted axes region) ∧
    (actual = .ok false ↔ ¬ NativeBounds.ComponentsAccepted axes region)

end NativeRegionBounds


/-!
Independent, unproved native prechecked-iterator contracts. These concern
concrete native partial domains without in-bounds or no-overflow assumptions.
-/

namespace NativePrechecked

open JuliaLean.base.multidimensional.Models1Group6.NativePrechecked

/-- Static native runtime type observation. -/
def ValueType : IntegerValue → IntegerType
  | .bits type _ => .bits type
  | .boolean _ => .boolean

/-- Mathematical integer denoted by a native value, including Bool's 0/1. -/
def ValueInteger : IntegerValue → Int
  | .bits _ value => value.val
  | .boolean value => if value then 1 else 0

/-- Independent declared-type contribution of each concrete range family.
Wrapper eltype is Int regardless of the wrapped endpoint type. -/
def DeclaredElement : UnitRangeFields → IntegerType
  | .oneToBits type _ | .unitBits type _ => .bits type
  | .oneToBool _ | .unitBool _ => .boolean
  | .slice _ | .identity _ => .bits .i64

/-- Static promoted addition type. Same-width signed/unsigned ties choose the
unsigned type; Bool does not widen another numeric type, while Bool+Bool is Int.
This is a type relation, not a simulation of arithmetic or conversion. -/
def AdditionType : IntegerType → IntegerType → IntTy
  | .bits left, .bits right => left.promote right
  | .bits type, .boolean | .boolean, .bits type => type
  | .boolean, .boolean => .i64

/-- Mathematical representability in the range's declared element type. -/
def Fits : IntegerType → Int → Prop
  | .bits type, value => type.min ≤ value ∧ value ≤ type.max
  | .boolean, value => value = 0 ∨ value = 1

/-- A converted native result has the requested runtime type and the same
mathematical value; successful conversion is not a wrapping operation. -/
def Represents (target : IntegerType) (number : Int) (value : IntegerValue) : Prop :=
  ValueType value = target ∧ ValueInteger value = number

/-- Complete success/InexactError interpretation of a checked native successor.
All other exception classes fail this specification. -/
def CheckedPairOutcome (target : IntegerType) (number : Int)
    (actual : JuliaLean.base.range.JlX (IntegerValue × IntegerValue)) : Prop :=
  match actual with
  | .ok (value, state) =>
      value = state ∧ Fits target number ∧ Represents target number value
  | .error (.jl (.inexactError _)) => ¬ Fits target number
  | .error _ => False

/-- For every supported native range and every BitInteger/Bool state, source968
adds one in the promoted Julia type, wraps there, then either returns that same
number in the declared range eltype or raises InexactError. The arithmetic
reference performs one mathematical successor and one explicit modulus; it
does not call the model's step, add or convert operations. Empty ranges, all
signed/unsigned extrema, Bool ranges and wider wrapper endpoints are included.
Source: multidimensional968-971; range736-737; int809-822,1092-1100; bool145,170.
-/
def UnitSuccessorArithmetic : Prop :=
  ∀ (range : UnitRangeFields) (state : IntegerValue),
    let target := DeclaredElement range
    let promoted := AdditionType (ValueType state) target
    let number := (JInt.wrap promoted (ValueInteger state + 1)).val
    CheckedPairOutcome target number
      (JuliaLean.base.multidimensional.Models1Group6.NativePrechecked.unitNext range state)

/-- Source973 adds native Int one and preserves the resulting promoted type;
it performs no conversion back to LinearIndices' Int eltype. The two outputs
are identical. This includes Bool, all widths, unsigned ties and wraparound.
Source: multidimensional973-976; int809-822,1092-1100; bool6.
-/
def LinearSuccessorArithmetic : Prop :=
  ∀ (Iterator : Type) (iterator : Iterator) (state : IntegerValue),
    let promoted := AdditionType (ValueType state) (.bits .i64)
    let expected := IntegerValue.bits promoted (JInt.wrap promoted (ValueInteger state + 1))
    JuliaLean.base.multidimensional.Models1Group6.NativePrechecked.linearNext iterator state =
      (expected, expected)

/-- Independent endpoint interpretation from actual stored native fields.
Wrapper constructors do not change the first endpoint's runtime type. -/
def FirstFieldValue : UnitRangeFields → IntegerValue
  | .oneToBits type _ => .bits type (JInt.lit type 1)
  | .unitBits type range => .bits type range.start
  | .oneToBool _ => .boolean true
  | .unitBool range => .boolean range.start
  | .slice indices | .identity indices => FirstFieldValue indices

/-- Prechecked native UnitRange initialization returns the first endpoint as
both item and state, including empty stored ranges. It must not convert a
wrapper's raw wider/Bool first result to its declared Int eltype at this stage.
Source: multidimensional967; range867-868; indices347,374.
-/
def UnitFirstFields : Prop :=
  ∀ (range : UnitRangeFields),
    JuliaLean.base.multidimensional.Models1Group6.NativePrechecked.unitFirst range =
      .ok (FirstFieldValue range, FirstFieldValue range)

/-- Independent rank-one LinearIndices first value. Plain native ranges have
OneTo axes with origin one. Offset wrappers expose the wrapped endpoint and its
actual runtime type. This differs from first(axis) for a plain UnitRange. -/
def LinearAxisFirst : LinearAxis → IntegerValue
  | .oneTo _ | .unitRange _ => .bits .i64 (int 1)
  | .slice indices | .identity indices => FirstFieldValue indices

/-- LinearIndices rank metadata chooses the rank-one endpoint rule only for
one stored axis; all other ranks have native first one. -/
def LinearFirstReference (iterator : LinearFields) : IntegerValue :=
  match iterator.axes with
  | [axis] => LinearAxisFirst axis
  | _ => .bits .i64 (int 1)

/-- Prechecked native LinearIndices initialization preserves the actual origin,
rank dispatch and wider/Bool offset-wrapper first value. It does not treat
emptiness as completed iteration. The carrier imposes only actual tuple arity.
Source: multidimensional972; indices524-527,344-345,371-372.
-/
def LinearFirstFields : Prop :=
  ∀ (iterator : LinearFields),
    JuliaLean.base.multidimensional.Models1Group6.NativePrechecked.linearFirst iterator =
      .ok (LinearFirstReference iterator, LinearFirstReference iterator)

/-- Native Cartesian first coordinates are each component's stored/native
endpoint, independently of whether the product region is empty. Actual tuple
arity is retained by the carrier, and no aggregate-size bound is invented.
Source: multidimensional493,977.
-/
def CartesianFirstFields : Prop :=
  ∀ (iterator : CartesianFields),
    let expected := iterator.ranges.map fun range =>
      (JuliaLean.Proofs.base.multidimensional.Models1Group6.NativeBounds.ComponentEndpoints range).1
    JuliaLean.base.multidimensional.Models1Group6.NativePrechecked.cartesianFirst iterator =
      .ok (expected, expected)

/-- First of the underlying native AbstractUnitRange itself, without LinearIndices'
axes transformation. Source: reinterpretarray301. -/
def SpecialAxisFirst : LinearAxis → IntegerValue
  | .oneTo _ => .bits .i64 (int 1)
  | .unitRange range => .bits .i64 range.start
  | .slice indices | .identity indices => FirstFieldValue indices

/-- Native SCartesianIndices2 first retains arbitrary K metadata, sets the first
coordinate to one, and checks representability of the actual wrapped-range first
in Int64. A wider first value may cause InexactError even though the axis declares
Int; it is never silently truncated. Both source first calls produce identical
native values. No K positivity/type premise is introduced because this method
does not invoke the separate public iterator constructor.
Source: multidimensional982; reinterpretarray275-278,301.
-/
def SpecialFirstFields : Prop :=
  ∀ (Parameter : Type) (K : Parameter) (indices2 : LinearAxis),
    let number := ValueInteger (SpecialAxisFirst indices2)
    match JuliaLean.base.multidimensional.Models1Group6.NativePrechecked.specialFirst K indices2 with
    | .ok (value, state) =>
        value.i = int 1 ∧ value.j.val = number ∧
        state.i = value.i ∧ state.j = value.j
    | .error (.jl (.inexactError _)) => ¬ Fits (.bits .i64) number
    | .error _ => False

end NativePrechecked


namespace NativeTupleIteration

open JuliaLean.base.multidimensional.Models1Group6.NativeTupleIteration

/-- The default native tuple iteration returns exactly its first stored payload
with the second one-based position, or ends on an empty tuple. This independent
sequence contract calls neither the iterator nor its tuple-indexing callee to
manufacture the expected result. Actual tuple arity is carried by Fields.
Source: base/multidimensional.jl:964; base/tuple.jl:69-73. -/
def FirstIsHead : Prop :=
  ∀ (Value : Type) (fields : Fields Value),
    JuliaLean.base.multidimensional.Models1Group6.NativeTupleIteration.first fields =
      .ok (fields.items.head?.map (fun value => (value, int 2)))

/-- Independent positional contract. Native state p denotes one-based field
position p, rather than an unbounded array index. The mathematical positions
of stored fields characterize termination; a successful pair retains that
exact payload and advances modulo Int64. All other state types require the
pinned dispatch MethodError, without an implicit integer conversion. -/
def PositionOutcome {Value Other : Type} (fields : Fields Value)
    (state : State Other) (actual : Outcome Value) : Prop :=
  match state with
  | .nonInt _ => actual = .error (.julia (.methodError "iterate"))
  | .native position =>
      (∃ result, actual = .ok result) ∧
      (actual = .ok none ↔
        ∀ entry ∈ fields.items.zipIdx, (entry.2 : Int) + 1 ≠ position.val) ∧
      (∀ (value : Value) (cursor : I64),
        actual = .ok (some (value, cursor)) ↔
          ∃ index : Nat, fields.items[index]? = some value ∧
            position.val = (index : Int) + 1 ∧
            cursor.val = wrapInt .i64 ((index : Int) + 2))

/-- Complete native Tuple fallback invariant, including every machine-Int
state, every other runtime state tag, empty tuples and wrapped final successors.
There is no in-bounds, success, no-overflow or artificially smaller tuple bound.
A callee error on native Int states violates the property; non-Int dispatch
must return its exact MethodError. The complete generic965 remains blocked for
other iterators and selected user-defined Tuple overloads.
Source: base/multidimensional.jl:965; base/tuple.jl:28,33,69-73. -/
def NextMatchesPositions : Prop :=
  ∀ (Value Other : Type) (fields : Fields Value) (state : State Other),
    PositionOutcome fields state
      (JuliaLean.base.multidimensional.Models1Group6.NativeTupleIteration.next fields state)

end NativeTupleIteration


/-!
Independent native overlap invariant for assigned1170/1172/1174
and their required1166 recursive dependency.
-/

namespace NativeOverlap

open JuliaLean.base.multidimensional.Models1Group6.NativePrechecked
open JuliaLean.base.multidimensional.Models1Group6.NativeOverlap
open JuliaLean.Proofs.base.multidimensional.Models1Group6.NativePrechecked

/-- Last endpoint read directly from actual stored native fields. In contrast
to the model, this mathematical reference performs no getter dispatch or
conversion; Slice/Identity preserve the endpoint's actual raw type. -/
def LastFieldValue : UnitRangeFields → IntegerValue
  | .oneToBits type range => .bits type range.stop
  | .unitBits type range => .bits type range.stop
  | .oneToBool range => .boolean range.stop
  | .unitBool range => .boolean range.stop
  | .slice indices | .identity indices => LastFieldValue indices

/-- Mathematical inclusive interval support of the native field observation.
This includes empty stored unit ranges and unchecked negative OneTo stops. -/
def Endpoints (range : UnitRangeFields) : Int × Int :=
  (ValueInteger (FirstFieldValue range), ValueInteger (LastFieldValue range))

/-- Independent local terminal decision. Compatible native coordinate supports
contribute no terminal decision; disjoint supports contribute false; an actual
non-Real/non-array fallback contributes true. The closed-interval comparisons
use mathematical values and do not invoke the model's native min/max/equality,
membership, range getters or recursive overlap implementation. -/
def CoordinateDecision {Other : Type} : Index Other → Index Other → Option Bool
  | .scalar left, .scalar right =>
      if ValueInteger left = ValueInteger right then none else some false
  | .unitRange left, .unitRange right =>
      if max (Endpoints left).1 (Endpoints right).1 ≤
          min (Endpoints left).2 (Endpoints right).2 then none else some false
  | .scalar value, .unitRange range =>
      if (Endpoints range).1 ≤ ValueInteger value ∧
          ValueInteger value ≤ (Endpoints range).2 then none else some false
  | .unitRange range, .scalar value =>
      if (Endpoints range).1 ≤ ValueInteger value ∧
          ValueInteger value ≤ (Endpoints range).2 then none else some false
  | _, _ => some true

/-- Complete native decision and malformed-tail contract. The first terminal
coordinate event controls the result, independently computed by filtering the
zipped input supports. Only if there is no terminal event is unequal tuple
arity an ErrorException; otherwise equal arity yields true. Thus early false
or an opaque fallback can suppress a later malformed tail. Every native width,
Bool value, empty range, wrapper endpoint and machine-arity tuple is included.
No assumed callee law, no-overflow premise or successful-result premise is used.
The property also rejects any unexpected native range exception.
Source: multidimensional1158-1188; range1489; int573-598; promotion676-677.
-/
def TupleDecisionAndMalformedTail : Prop :=
  ∀ (Other : Type) (left right : IndexTuple Other),
    let terminal := ((List.zip left.items right.items).filterMap
      (fun pair => CoordinateDecision pair.1 pair.2)).head?
    JuliaLean.base.multidimensional.Models1Group6.NativeOverlap.overlap left right =
      match terminal with
      | some value => .ok value
      | none =>
          if left.items.length = right.items.length then .ok true
          else .error (.inr (.errorException "malformed subarray"))

end NativeOverlap


/-!
Independent native983 invariant.
-/

namespace NativeSpecial

open JuliaLean.base.multidimensional.Models1Group6.NativePrechecked
open JuliaLean.base.multidimensional.Models1Group6.NativeSpecial
open JuliaLean.Proofs.base.multidimensional.Models1Group6.NativePrechecked

/-- Native integer successor described by a mathematical increment followed by
the single modulus of the independently determined Julia result type. -/
def SuccessorCoordinate (value : IntegerValue) : IntegerType × Int :=
  let type := AdditionType (ValueType value) (.bits .i64)
  (.bits type, (JInt.wrap type (ValueInteger value + 1)).val)

/-- Independent two-coordinate destination selected by mathematical integer
order. The unselected field is either retained exactly or replaced by one;
the reference never invokes the model's comparison, addition or constructor.
-/
def Destination (K : IntegerValue) (state : StateFields) :
    (IntegerType × Int) × (IntegerType × Int) :=
  if ValueInteger state.i < ValueInteger K then
    (SuccessorCoordinate state.i, (ValueType state.j, ValueInteger state.j))
  else
    ((.bits .i64, 1), SuccessorCoordinate state.j)

/-- Exact existing Int64 conversion error payload selected from source type
metadata. Bool conversion cannot fail, so it contributes no possible error name.
-/
def Int64FailureName : IntegerType → Option String
  | .bits type => some (if type.bits = 64 then "convert" else "trunc")
  | .boolean => none

/-- Every native source983 state reaches the mathematically selected coordinate
pair, with the actual promoted modulus applied to only the incremented field.
Success returns equal item/state fields; failed field construction raises the
existing InexactError for the first nonrepresentable coordinate, preserving the
source type's convert/trunc name. This exposes constructor order when the two
fields would fail with different names. All native K types, Bool values,
signed/unsigned extrema, inconsistent caller-state coordinates and branch
overflow are quantified without a success, range or positivity premise.
Source: multidimensional983-986; reinterpretarray275-278; int84,573-589,
809-822,1092-1100; bool6,135; boot1071-1195.
-/
def SuccessorCoordinatesAndFirstFailure : Prop :=
  ∀ (K : IntegerValue) (state : StateFields),
    let destination := Destination K state
    let firstFits := Fits (.bits .i64) destination.1.2
    let secondFits := Fits (.bits .i64) destination.2.2
    match JuliaLean.base.multidimensional.Models1Group6.NativeSpecial.next K state with
    | .ok (value, nextState) =>
        firstFits ∧ secondFits ∧
        value.i.val = destination.1.2 ∧ value.j.val = destination.2.2 ∧
        nextState.i = value.i ∧ nextState.j = value.j
    | .error (.jl (.inexactError name)) =>
        (¬ firstFits ∧ Int64FailureName destination.1.1 = some name) ∨
        (firstFits ∧ ¬ secondFits ∧ Int64FailureName destination.2.1 = some name)
    | .error _ => False

end NativeSpecial


/-!
Independent value-level invariant of the rank/traversal partial. Missing
bounded Core tuple/splat construction can fail before a later rank check, so
this does not guarantee Julia success or first exception for oversized output.
-/

namespace RankProtocol

open JuliaLean.base.multidimensional.Models1Group6

/-- Independent dimensional contribution: a fixed number of tuple slots, or a
raw rank that the source must validate. This is metadata, not executable tuple
construction or a copied recursive rank algorithm.
-/
inductive Contribution where
  | fixed (count : Nat)
  | checked (rank : TypeRank)

/-- Input dimensions consumed by a source index's type. Cartesian element rank
and array rank are deliberately different. Ordinary and Bool arrays contribute
one regardless of their own raw rank metadata.
Source: base/multidimensional.jl:792-799; manual/arrays.md:739-741,803-824.
-/
def InputContribution : IndexMetadata → Contribution
  | .cartesian coordinates => .fixed coordinates.length
  | .cartesianArray _ rank => .checked rank
  | _ => .fixed 1

/-- Result dimensions retained by a source index's type. Bool mask rank remains
ignored; Cartesian scalar indices contribute no result dimension.
Source: base/multidimensional.jl:803-809; manual/arrays.md:534-547,880-883.
-/
def OutputContribution : IndexMetadata → Contribution
  | .colon | .boolArray _ => .fixed 1
  | .array rank | .cartesianArray rank _ => .checked rank
  | _ => .fixed 0

/-- The two independently observable source rank-validation failure classes. -/
inductive Failure where
  | nonInt
  | negative

/-- Whether a metadata requirement is the source's first failure candidate.
The test uses mathematical sign on an already typed machine value; it performs
neither tuple construction nor recursive source execution.
Source: base/ntuple.jl:66.
-/
def Fails : Contribution → Option Failure
  | .fixed _ => none
  | .checked .other => some .nonInt
  | .checked (.machineInt value) =>
      if value.val < 0 then some .negative else none

/-- Mathematical number of promised output markers for a valid requirement.
Invalid requirements have no promised count; this helper's zero extension is
never used by the successful-case contract when a failure candidate exists.
-/
def Count : Contribution → Nat
  | .fixed count => count
  | .checked (.machineInt value) => value.val.toNat
  | .checked .other => 0

/-- Match the actual error's class, without assuming its cause or message text. -/
def HasFailureClass : Error → Failure → Prop
  | .typeError, .nonInt => True
  | .argumentError _, .negative => True
  | _, _ => False

/-- Independent aggregate contract. The first failing metadata requirement in
source order determines the exception class. With none, every output marker
is true and the marker count is the sum of the static per-type contributions.
No recursive source body, marker list, or assumed callee law is used as the
expected result. Invalid rank tags ignored by dispatch contribute no failure.
-/
def OutcomeCorrect (requirements : List Contribution) (actual : Result (List Bool)) : Prop :=
  match (requirements.filterMap Fails).head? with
  | some failure =>
      ∃ error, actual = .error error ∧ HasFailureClass error failure
  | none =>
      ∃ markers, actual = .ok markers ∧
        markers.length = (requirements.map Count).sum ∧
        ∀ marker ∈ markers, marker = true

end RankProtocol

/-- Value-level partial rank-metadata contract, including every raw type-parameter tag,
negative native rank, non-Int rank, zero rank, zero-dimensional CartesianIndex,
and distinction between array rank and Cartesian element rank. Only the actual
argument/coordinate tuple representation is required to be constructible;
there is no successful-rank premise. Both optional-generated source paths are
quantified. Within this partial model the first relevant rank error wins before
tail recursion. Bounded Core tuple/splat construction is missing, so this does
not claim Julia must construct an oversized marker tuple or reach a later error.
Source: base/multidimensional.jl:792-809; base/ntuple.jl:65-72.
-/
def IndexRankAccountingCorrect : Prop :=
  ∀ (indices : JuliaLean.base.multidimensional.Models1Group6.IndexMetadataTuple)
    (generated : Bool),
    RankProtocol.OutcomeCorrect (indices.items.map RankProtocol.InputContribution)
      (JuliaLean.base.multidimensional.Models1Group6.indexNdims indices generated) ∧
    RankProtocol.OutcomeCorrect (indices.items.map RankProtocol.OutputContribution)
      (JuliaLean.base.multidimensional.Models1Group6.indexDimsum indices generated)


/-!
Independent, unproved Boolean-mask protocol properties. The trace contract
quantifies over every constructible tuple, raw axis/equality value, custom action,
error and represented mutable state. No equality, ismissing, purity or success
law is assumed. It constrains observable request order, truth-context behavior
and state/error accounting without copying the recursive implementation.
