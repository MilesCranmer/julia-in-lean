  rw [JuliaLean.Proofs.base.int.add_int_val, JuliaLean.Proofs.base.int.sub_int_val]
  have h1 : (int 1).val = 1 := by decide
  rw [h1, JuliaLean.Proofs.base.int.wrapInt_add_right]
