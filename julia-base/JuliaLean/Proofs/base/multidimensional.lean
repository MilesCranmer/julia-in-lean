theorem rt_toInt64_of_fit (value : IntegerValue)
    (fits : Fits (.bits .i64) (ValueInteger value)) :
    NativeSpecial.toInt64 value = .ok ⟨ValueInteger value, fits⟩ := by
  cases value with
  | bits type value =>
    change IntTy.i64.min ≤ value.val ∧ value.val ≤ IntTy.i64.max at fits
    change JuliaLean.base.range.liftJl (JInt.convert _ .i64 value.val) = _
    rw [JInt.convert, dif_pos fits]
    rfl
  | boolean value =>
    change Except.ok (JuliaLean.base.int.ofBool .i64 value) = _
    congr 1
    apply Subtype.ext
    exact rt_ofBool_val .i64 value

theorem rt_toInt64_of_not_fit (value : IntegerValue)
    (fits : ¬ Fits (.bits .i64) (ValueInteger value)) :
    ∃ name, NativeSpecial.toInt64 value = .error (.jl (.inexactError name)) ∧
      JuliaLean.Proofs.base.multidimensional.Models1Group6.NativeSpecial.Int64FailureName
        (ValueType value) = some name := by
  cases value with
  | bits type value =>
    change ¬ (IntTy.i64.min ≤ value.val ∧ value.val ≤ IntTy.i64.max) at fits
    refine ⟨if IntTy.i64.bits = type.bits then "convert" else "trunc", ?_, ?_⟩
    · change JuliaLean.base.range.liftJl (JInt.convert _ .i64 value.val) = _
      rw [JInt.convert, dif_neg fits]
      rfl
    · cases type <;> rfl
  | boolean value =>
    exact False.elim (fits (by cases value <;> simp only [Fits, ValueInteger] <;> decide))

theorem rt_special_axis_first (axis : LinearAxis) :
    FirstFieldValue (axisRange axis) = SpecialAxisFirst axis := by
