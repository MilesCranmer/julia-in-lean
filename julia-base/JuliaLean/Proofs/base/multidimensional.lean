/-- Reopen the existing specification-only exception injection instance. -/
local instance conversionObservationError {Extra S : Type} :
    MonadExceptOf Error (ConstructorObservationM Extra S) :=
  constructorObservationError

/-- Actual conversion target, raw argument, and arbitrary returned/thrown value. -/
structure ConversionEvent (Extra T A V : Type) where
  target : T
  argument : A
  result : Except (Sum Error Extra) V

abbrev ConversionRecord (Extra S T A V : Type) :=
  S × S × ConversionEvent Extra T A V

/-- Observe one selected call while retaining its before/after shared state.
Neither its return nor its possible arbitrary exception is constrained. -/
def observeConversionAction {Extra S T A V : Type}
    (action : ConstructorObservationM Extra S V) (target : T) (argument : A) :
    ConstructorObservationM Extra (S × List (ConversionRecord Extra S T A V)) V :=
  ExceptT.mk fun (state, events) =>
    match action.run state with
    | none => none
    | some (result, state') =>
        some (result, (state', events ++ [(state, state', ⟨target, argument, result⟩)]))

def observeNumberConversionOps {Extra S T V : Type}
    (ops : NumberConversionOps (ConstructorObservationM Extra S) T V) :
    NumberConversionOps
      (ConstructorObservationM Extra (S × List (ConversionRecord Extra S T I64 V))) T V where
  convert := fun target argument =>
    observeConversionAction (ops.convert target argument) target argument

def observeTupleConversionOps {Extra S T V : Type}
    (ops : TupleConversionOps (ConstructorObservationM Extra S) T V) :
    TupleConversionOps
      (ConstructorObservationM Extra (S × List (ConversionRecord Extra S T CI V))) T V where
  convert := fun target argument =>
    observeConversionAction (ops.convert target argument) target argument

/-- One target-selected conversion occurs on the original target and raw
stored value. There is no additional call, result coercion, invented failure,
or mutation outside that call, including when it throws. -/
def ConversionObservation {Extra S T A V : Type}
    (target : T) (argument : A) (initial : S)
    (outcome : Option (Except (Sum Error Extra) V ×
      (S × List (ConversionRecord Extra S T A V)))) : Prop :=
  match outcome with
  | none => True
  | some (result, (final, events)) =>
      events = [(initial, final, ⟨target, argument, result⟩)]

/-- Complete target-dispatch domain for numeric and tuple conversions. The
rank-one representation ranges over every stored native Int; general tuple
conversion ranges over every constructible CartesianIndex. Type objects,
conversion results, shared mutation, and arbitrary thrown values remain open.
No target conversion law or success assumption is supplied.
Source: base/multidimensional.jl:145-146;
doc/src/manual/conversion-and-promotion.md:45-56,102-110. -/
def CartesianConversionObservations : Prop :=
  (∀ (Extra S T V : Type)
    (ops : NumberConversionOps (ConstructorObservationM Extra S) T V)
    (target : T) (coordinate : I64) (state : S),
    let observed := observeNumberConversionOps ops
    ConversionObservation target coordinate state
      ((convertCartesianNumber observed target coordinate).run (state, []))) ∧
  (∀ (Extra S T V : Type)
    (ops : TupleConversionOps (ConstructorObservationM Extra S) T V)
    (target : T) (index : CI) (state : S), TupleArity index →
    let observed := observeTupleConversionOps ops
    ConversionObservation target index state
      ((convertCartesianTuple observed target index).run (state, [])))

/-- Concrete Number target metadata used only to instantiate the generic
method for an independent mathematical contract. -/
inductive PrimitiveNumberTarget where
  | bits (target : IntTy)
  | boolean

/-- Installed Base conversions, preserving the output's actual integer type. -/
def primitiveNumberConversionOps :
    NumberConversionOps Result PrimitiveNumberTarget JuliaLean.base.tuple.Index where
  convert := fun target coordinate => match target with
    | .bits ty =>
        ((Models1Group5.CartesianConversion.bitsFromInt64 ty coordinate).mapError
          fromCoreError).map (fun value => .integer ty value)
    | .boolean =>
        ((Models1Group5.CartesianConversion.boolFromInt64 coordinate).mapError
          fromCoreError).map JuliaLean.base.tuple.Index.bool

/-- Exact mathematical representability, independent of conversion code. -/
def PrimitiveNumberFits (target : PrimitiveNumberTarget) (value : Int) : Prop :=
  match target with
  | .bits ty => IntTy.min ty ≤ value ∧ value ≤ IntTy.max ty
  | .boolean => value = 0 ∨ value = 1

/-- Observable target type, including Bool's distinction from BitIntegers. -/
def PrimitiveNumberHasType (target : PrimitiveNumberTarget)
    (value : JuliaLean.base.tuple.Index) : Prop :=
  match target, value with
  | .bits requested, .integer actual _ => actual = requested
  | .boolean, .bool _ => True
  | _, _ => False

/-- Successful numeric conversion has exactly the requested type and the
original mathematical coordinate. InexactError is equivalent to failure of
representability; no other outcome is permitted in this concrete instance. -/
def PrimitiveNumberOutcome (target : PrimitiveNumberTarget) (coordinate : I64)
    (outcome : Result JuliaLean.base.tuple.Index) : Prop :=
  (match outcome with
   | .ok value => PrimitiveNumberHasType target value ∧ value.value = coordinate.val
   | .error (.inexactError _) => ¬PrimitiveNumberFits target coordinate.val
   | .error _ => False) ∧
  ((∃ fn, outcome = .error (.inexactError fn)) ↔
    ¬PrimitiveNumberFits target coordinate.val)

/-- Every rank-one native coordinate converted to Bool or any BitInteger
preserves its value exactly when representable, and otherwise raises
InexactError. The domain includes all target widths, signs, and Int64 extrema.
Source: base/multidimensional.jl:145; base/number.jl:6-7;
base/bool.jl:170; doc/src/manual/conversion-and-promotion.md:45-56,119-125. -/
def CartesianPrimitiveNumberConversionCorrect : Prop :=
  ∀ (target : PrimitiveNumberTarget) (coordinate : I64),
    PrimitiveNumberOutcome target coordinate
      (convertCartesianNumber primitiveNumberConversionOps target coordinate)

/-- A concrete Base tuple-target instantiation of the open conversion leaf. -/
def primitiveTupleConversionOps :
    TupleConversionOps Result TupleTarget64 (List JuliaLean.base.tuple.Index) where
  convert := Models1Group5.CartesianConversion.tupleDispatch

/-- Type metadata, like input tuples, has constructible Julia arity. -/
def PrimitiveTupleTargetArity : TupleTarget64 → Prop
  | .tuple => True
  | .fixed fields => TupleArity fields

def PrimitiveTupleFieldFits (target : TupleScalarTarget) (value : Int) : Prop :=
  match target with
  | .bits ty => IntTy.min ty ≤ value ∧ value ≤ IntTy.max ty
  | .boolean => value = 0 ∨ value = 1
  | .any => True

/-- Any retains a native Int's runtime type; other fields use their exact
requested BitInteger or Bool type. This is an observation, not a converter. -/
def PrimitiveTupleFieldHasType (target : TupleScalarTarget)
    (value : JuliaLean.base.tuple.Index) : Prop :=
  match target, value with
  | .bits requested, .integer actual _ => actual = requested
  | .boolean, .bool _ => True
  | .any, .integer actual _ => actual = .i64
  | _, _ => False

/-- An input coordinate and its corresponding requested type are incompatible
mathematically; no field conversion implementation is consulted. -/
def PrimitiveTupleBadField (fields : List TupleScalarTarget) (index : CI) : Prop :=
  ∃ (position : Nat) (field : TupleScalarTarget) (coordinate : I64),
    fields[position]? = some field ∧ index[position]? = some coordinate ∧
      ¬PrimitiveTupleFieldFits field coordinate.val

/-- Position-based expected values and runtime types, independent of the
implementation's isa checks, zip, map, and conversion calls. -/
def PrimitiveTuplePositions (fields : List TupleScalarTarget) (index : CI)
    (values : List JuliaLean.base.tuple.Index) : Prop :=
  values.length = index.length ∧
  ∀ (position : Nat) (field : TupleScalarTarget) (coordinate : I64),
    fields[position]? = some field → index[position]? = some coordinate →
    ∃ value : JuliaLean.base.tuple.Index,
      values[position]? = some value ∧
      PrimitiveTupleFieldHasType field value ∧ value.value = coordinate.val

/-- Incompatible target arity takes MethodError priority even when a supplied
coordinate also fails a requested field conversion. At equal arity,
InexactError occurs iff some paired field is unrepresentable; otherwise all
positions preserve values and exact requested runtime types. -/
def PrimitiveTupleOutcome (target : TupleTarget64) (index : CI)
    (outcome : Result (List JuliaLean.base.tuple.Index)) : Prop :=
  match target with
  | .tuple =>
      match outcome with
      | .ok values =>
          values.length = index.length ∧
          ∀ (position : Nat) (coordinate : I64), index[position]? = some coordinate →
            values[position]? = some (.integer .i64 coordinate)
      | .error _ => False
  | .fixed fields =>
      if fields.length ≠ index.length then
        outcome = .error (.methodError "convert")
      else
        (match outcome with
         | .ok values => PrimitiveTuplePositions fields index values
         | .error (.inexactError _) => PrimitiveTupleBadField fields index
         | .error _ => False) ∧
        ((∃ fn, outcome = .error (.inexactError fn)) ↔ PrimitiveTupleBadField fields index)

/-- Full-domain concrete Base check for Tuple and fixed heterogeneous tuples
of Any, Bool, and all BitInteger types. Includes rank zero, mismatching arities,
all Int64 coordinates, and all constructible type-metadata sizes, with no
success assumptions or numerical-value preconditions.
Source: base/multidimensional.jl:146; base/essentials.jl:650-667;
doc/src/manual/conversion-and-promotion.md:45-56,102-110,119-125. -/
def CartesianPrimitiveTupleConversionCorrect : Prop :=
  ∀ (target : TupleTarget64) (index : CI),
    PrimitiveTupleTargetArity target → TupleArity index →
    PrimitiveTupleOutcome target index
      (convertCartesianTuple primitiveTupleConversionOps target index)

