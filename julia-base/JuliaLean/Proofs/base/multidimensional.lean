theorem chunk_split_singleton {α : Type} (only : α)
    (before : List α) (event : α) (after : List α)
    (h : [only] = before ++ event :: after) :
    before = [] ∧ event = only ∧ after = [] := by
  have hn := congrArg List.length h
  simp only [List.length_append, List.length_cons, List.length_nil] at hn
  have hb : before = [] := List.length_eq_zero_iff.mp (by omega)
  have ha : after = [] := List.length_eq_zero_iff.mp (by omega)
  subst before
  subst after
  exact ⟨rfl, (List.cons.inj h).1.symm, rfl⟩

theorem chunk_split_pair {α : Type} (first last : α)
    (before : List α) (event : α) (after : List α)
    (h : [first, last] = before ++ event :: after) :
    (before = [] ∧ event = first ∧ after = [last]) ∨
    (before = [first] ∧ event = last ∧ after = []) := by
  cases before with
  | nil =>
    have hc := List.cons.inj h
    exact .inl ⟨rfl, hc.1.symm, hc.2.symm⟩
  | cons head before =>
    have hc := List.cons.inj h
    obtain ⟨hb, he, ha⟩ := chunk_split_singleton last before event after hc.2
    subst before
    exact .inr ⟨congrArg (fun value => [value]) hc.1.symm, he, ha⟩

theorem chunk_stops_single (event : Event State Axis TypeTag Other)
    (result : Except Error (Option Bool)) (final : State)
    (hterminal : TerminalObservation runtime event = some result)
    (hstate : stateAfter event = final) :
    pr_TraceLists.Stops runtime [event] result final := by
  intro before observed after expected hsplit hterm
  obtain ⟨hb, he, ha⟩ := chunk_split_singleton event before observed after hsplit
  subst observed
  exact ⟨ha, Option.some.inj (hterminal.symm.trans hterm), hstate.symm⟩

theorem chunk_leading_meaning (left : MaskAxisOperand Axis TypeTag)
    (right : MaskAxisField Axis TypeTag) (value : MaskTruth Other) (final : State) :
    TerminalObservation runtime (.equal left (.observed right) (.ok value) final) =
      finish (leadingMeaning value) := by
  cases value with
  | bool value => cases value <;> rfl
  | missing => rfl
  | other value => rfl

theorem chunk_fallback_meaning (left : MaskAxisOperand Axis TypeTag)
    (right : JuliaLean.base.indices.BaseRange) (value : MaskTruth Other) (final : State)
    (hselection : runtime.missingExtension value = none) :
    TerminalObservation runtime (.equal left (.native right) (.ok value) final) =
      finish (trailingMeaning value (defaultMissing value)) := by
  cases value with
  | bool value => cases value <;> simp only [TerminalObservation, hselection,
      trailingMeaning, defaultMissing, leadingMeaning, finish]
  | missing => simp only [TerminalObservation, hselection,
      trailingMeaning, defaultMissing, leadingMeaning, finish]
  | other value => simp only [TerminalObservation, hselection,
      trailingMeaning, defaultMissing, leadingMeaning, finish]

theorem chunk_selected_meaning (value : MaskTruth Other)
    (missing : Except Error (MaskTruth Other)) (final : State) :
    TerminalObservation runtime (.isMissing value missing final) =
      finish (missing.bind (trailingMeaning value)) := by
  cases missing with
  | error error => rfl
  | ok observed =>
    cases observed with
    | bool observed =>
      cases observed with
      | true => rfl
      | false =>
        cases value with
        | bool value => cases value <;> rfl
        | missing => rfl
        | other value => rfl
    | missing => rfl
    | other observed => rfl

theorem chunk_calls (h : Chunk runtime request status final events) :
    EqualityCalls events = [request] := by
  cases h <;> rfl

theorem chunk_last (h : Chunk runtime request status final events) :
    ∃ event, events.getLast? = some event ∧ stateAfter event = final := by
  cases h <;> exact ⟨_, rfl, rfl⟩

theorem chunk_certificate (h : Chunk runtime request status final events) :
    ∃ front last, events = front ++ [last] ∧ stateAfter last = final ∧
      pr_TraceLists.Nonterminal runtime front ∧
      TerminalObservation runtime last = finish status := by
  cases h with
  | equalityError left right error final =>
    exact ⟨[], .equal left right (.error error) final, rfl, rfl,
      pr_TraceLists.Nonterminal_nil runtime, rfl⟩
  | paired left right value final =>
    exact ⟨[], .equal left (.observed right) (.ok value) final, rfl, rfl,
      pr_TraceLists.Nonterminal_nil runtime, chunk_leading_meaning left right value final⟩
  | fallback left right value final hselection =>
    exact ⟨[], .equal left (.native right) (.ok value) final, rfl, rfl,
      pr_TraceLists.Nonterminal_nil runtime,
      chunk_fallback_meaning left right value final hselection⟩
  | selected left right value middle action missing final hselection =>
    refine ⟨[.equal left (.native right) (.ok value) middle],
      .isMissing value missing final, rfl, rfl, ?_, chunk_selected_meaning value missing final⟩
    intro event hmem
    have he := List.mem_singleton.mp hmem
    subst event
    cases value with
    | bool value => cases value <;> simp only [TerminalObservation, hselection]
    | missing => simp only [TerminalObservation, hselection]
    | other value => simp only [TerminalObservation, hselection]

theorem chunk_custom_single (left right : MaskAxisOperand Axis TypeTag)
    (result : Except Error (MaskTruth Other)) (final : State)
    (hselection : ∀ native value, right = .native native → result = .ok value →
      runtime.missingExtension value = none) :
    pr_TraceLists.Custom runtime [.equal left right result final] := by
  constructor
  · intro before operand native value after previous h
    obtain ⟨hb, he, ha⟩ := chunk_split_singleton
      (Event.equal left right result final) before
      (.equal operand (.native native) (.ok value) previous) after h
    cases he
    rw [hselection native value rfl rfl]
    trivial
  · intro before value observed next after h
    obtain ⟨hb, he, ha⟩ := chunk_split_singleton
      (Event.equal left right result final) before (.isMissing value observed next) after h
    cases he

theorem chunk_custom_selected (left : MaskAxisOperand Axis TypeTag)
    (right : JuliaLean.base.indices.BaseRange) (value : MaskTruth Other)
    (middle : State) (action : Effects State (MaskTruth Other))
    (missing : Except Error (MaskTruth Other)) (final : State)
    (hselection : runtime.missingExtension value = some action) :
    pr_TraceLists.Custom runtime
      [.equal left (.native right) (.ok value) middle, .isMissing value missing final] := by
  constructor
  · intro before operand native selected after previous h
    rcases chunk_split_pair
        (Event.equal left (.native right) (.ok value) middle)
        (.isMissing value missing final) before
        (.equal operand (.native native) (.ok selected) previous) after h with hf | hl
    · obtain ⟨hb, he, ha⟩ := hf
      cases he
      rw [hselection]
      exact ⟨missing, final, [], ha⟩
    · obtain ⟨hb, he, ha⟩ := hl
      cases he
  · intro before selected observed next after h
    rcases chunk_split_pair
        (Event.equal left (.native right) (.ok value) middle)
        (.isMissing value missing final) before (.isMissing selected observed next) after h with hf | hl
    · obtain ⟨hb, he, ha⟩ := hf
      cases he
    · obtain ⟨hb, he, ha⟩ := hl
      cases he
      refine ⟨[], left, right, middle, hb, ?_⟩
      simp only [hselection]

theorem chunk_custom (h : Chunk runtime request status final events) :
    pr_TraceLists.Custom runtime events := by
  cases h with
  | equalityError left right error final =>
    apply chunk_custom_single
    intro native value hright hresult
    cases hresult
  | paired left right value final =>
    apply chunk_custom_single
    intro native selected hright hresult
    cases hright
  | fallback left right value final hselection =>
    apply chunk_custom_single
    intro native selected hright hresult
    cases hright
    cases hresult
    exact hselection
  | selected left right value middle action missing final hselection =>
    exact chunk_custom_selected left right value middle action missing final hselection

theorem chunk_next_evidence (h : Chunk runtime request status final events)
    (seen : Bool) (hstatus : status = .ok (.next seen)) :
    pr_TraceLists.MissingValid events ∧
      (seen = false → AllEqualTrue events) ∧
      (seen = true → pr_TraceLists.MissingWitness runtime events) := by
  cases h with
  | equalityError left right error final => cases hstatus
  | paired left right value final =>
    cases value with
    | bool value =>
      cases value with
      | false => cases hstatus
      | true =>
        have hs := Step.next.inj (Except.ok.inj hstatus)
        subst seen
        simp [pr_TraceLists.MissingValid, AllEqualTrue, pr_TraceLists.MissingWitness]
    | missing => cases hstatus
    | other value => cases hstatus
  | fallback left right value final hselection =>
    cases value with
    | bool value =>
      cases value with
      | false => cases hstatus
      | true =>
        have hs := Step.next.inj (Except.ok.inj hstatus)
        subst seen
        simp [pr_TraceLists.MissingValid, AllEqualTrue, pr_TraceLists.MissingWitness, hselection]
    | missing =>
      have hs := Step.next.inj (Except.ok.inj hstatus)
      subst seen
      simp [pr_TraceLists.MissingValid, AllEqualTrue, pr_TraceLists.MissingWitness, hselection]
    | other value => cases hstatus
  | selected left right value middle action missing final hselection =>
    cases missing with
    | error error => cases hstatus
    | ok observed =>
      cases observed with
      | bool observed =>
        cases observed with
        | true =>
          have hs := Step.next.inj (Except.ok.inj hstatus)
          subst seen
          refine ⟨?_, ?_, ?_⟩
          · intro event hmem
            rcases List.mem_cons.mp hmem with he | hmem
            · subst event
              exact ⟨value, rfl⟩
            · have he := List.mem_singleton.mp hmem
              subst event
              exact ⟨true, rfl⟩
          · intro hfalse
            cases hfalse
          · intro _
            exact ⟨.isMissing value (.ok (.bool true)) final, by simp, trivial⟩
        | false =>
          cases value with
          | bool value =>
            cases value with
            | false => cases hstatus
            | true =>
              have hs := Step.next.inj (Except.ok.inj hstatus)
              subst seen
              simp [pr_TraceLists.MissingValid, AllEqualTrue, pr_TraceLists.MissingWitness]
          | missing => cases hstatus
          | other value => cases hstatus
      | missing => cases hstatus
      | other observed => cases hstatus

theorem chunk_next {seen : Bool}
    (h : Chunk runtime request (.ok (.next seen)) final events) :
    pr_TraceLists.Nonterminal runtime events ∧ pr_TraceLists.MissingValid events ∧
      (seen = false → AllEqualTrue events) ∧
      (seen = true → pr_TraceLists.MissingWitness runtime events) := by
  refine ⟨?_, chunk_next_evidence h seen rfl⟩
  obtain ⟨front, last, hevents, hstate, hprefix, hmeaning⟩ := chunk_certificate h
  rw [hevents]
  apply (pr_TraceLists.Nonterminal_append runtime front [last]).mpr
  refine ⟨hprefix, ?_⟩
  intro event hmem
  have he := List.mem_singleton.mp hmem
  subst event
  exact hmeaning

theorem chunk_terminal {expected : Except Error (Option Bool)}
    (h : Chunk runtime request status final events)
    (hfinish : finish status = some expected) :
    (∃ event, events.getLast? = some event ∧
      TerminalObservation runtime event = some expected ∧ stateAfter event = final) ∧
    pr_TraceLists.Stops runtime events expected final := by
  obtain ⟨front, last, hevents, hstate, hprefix, hmeaning⟩ := chunk_certificate h
  have hterminal := hmeaning.trans hfinish
  constructor
  · refine ⟨last, ?_, hterminal, hstate⟩
    rw [hevents]
    exact List.getLast?_concat
  · rw [hevents]
    exact pr_TraceLists.Stops_append runtime front [last] expected final hprefix
      (chunk_stops_single last expected final hterminal hstate)

end Models1Group6.Batch9.pr_Trace



namespace Models1Group6.Batch9

open JuliaLean JuliaLean.base.multidimensional
open JuliaLean.base.multidimensional.Models1Group6
open JuliaLean.Proofs.base.multidimensional.Models1Group6.MaskAxesProtocol

namespace pr_Trace

open pr_TraceLists

def Common {State Axis TypeTag Other : Type}
    (runtime : MaskAxesRuntime (Effects State) Axis TypeTag Other)
    (plan : List (MaskAxisOperand Axis TypeTag × MaskAxisOperand Axis TypeTag))
    (initial : State) (result : Except Error (Option Bool)) (final : State)
    (events : List (Event State Axis TypeTag Other)) : Prop :=
  EqualityCalls events = plan.take (EqualityCalls events).length ∧
  (EqualityCalls events).length ≤ plan.length ∧
  final = (match events.getLast? with | none => initial | some event => stateAfter event) ∧
  Stops runtime events result final ∧ Custom runtime events

theorem common_nil {State Axis TypeTag Other : Type}
    (runtime : MaskAxesRuntime (Effects State) Axis TypeTag Other)
    (initial : State) (result : Except Error (Option Bool)) :
    Common runtime [] initial result initial [] := by
  exact ⟨rfl, Nat.le_refl 0, rfl, Stops_nil runtime result initial, Custom_nil runtime⟩

theorem common_terminal {State Axis TypeTag Other : Type}
    {runtime : MaskAxesRuntime (Effects State) Axis TypeTag Other}
    {request : MaskAxisOperand Axis TypeTag × MaskAxisOperand Axis TypeTag}
    {status : Except Error Step} {initial final : State}
    {events : List (Event State Axis TypeTag Other)}
    {rest : List (MaskAxisOperand Axis TypeTag × MaskAxisOperand Axis TypeTag)}
    {result : Except Error (Option Bool)}
    (hc : Chunk runtime request status final events) (hf : finish status = some result) :
    Common runtime (request :: rest) initial result final events := by
  obtain ⟨⟨event, hlast, _, hfinal⟩, hstops⟩ := chunk_terminal hc hf
  refine ⟨?_, ?_, ?_, hstops, chunk_custom hc⟩
  · rw [chunk_calls hc]
    rfl
  · rw [chunk_calls hc]
    simp only [List.length_singleton, List.length_cons, List.length_nil]
    omega
  · rw [hlast]
    exact hfinal.symm

theorem common_next {State Axis TypeTag Other : Type}
    {runtime : MaskAxesRuntime (Effects State) Axis TypeTag Other}
    {request : MaskAxisOperand Axis TypeTag × MaskAxisOperand Axis TypeTag}
    {seen : Bool} {initial middle final : State}
    {first events : List (Event State Axis TypeTag Other)}
    {rest : List (MaskAxisOperand Axis TypeTag × MaskAxisOperand Axis TypeTag)}
    {result : Except Error (Option Bool)}
    (hc : Chunk runtime request (.ok (.next seen)) middle first)
    (ht : Common runtime rest middle result final events) :
    Common runtime (request :: rest) initial result final (first ++ events) := by
  rcases ht with ⟨hprefix, hlength, hstate, hstops, hcustom⟩
  have hcalls : EqualityCalls (first ++ events) = request :: EqualityCalls events := by
    rw [EqualityCalls_append, chunk_calls hc]
    rfl
  refine ⟨?_, ?_, ?_, Stops_append runtime first events result final (chunk_next hc).1 hstops,
    Custom_append runtime first events (chunk_custom hc) hcustom⟩
  · rw [hcalls]
    change request :: EqualityCalls events = request :: rest.take (EqualityCalls events).length
    exact congrArg (List.cons request) hprefix
  · rw [hcalls]
    simp only [List.length_cons]
    omega
  · rw [List.getLast?_append]
    cases hlast : events.getLast? with
    | none =>
      have hfinal : final = middle := by simpa only [hlast] using hstate
      obtain ⟨event, hevent, hmiddle⟩ := chunk_last hc
      change final = match first.getLast? with | none => initial | some event => stateAfter event
      rw [hevent]
      exact hfinal.trans hmiddle.symm
    | some event =>
      change final = stateAfter event
      simpa only [hlast] using hstate

theorem axesPlan_cons {Axis TypeTag : Type}
    (left right : MaskAxisField Axis TypeTag)
    (inds axes : List (MaskAxisField Axis TypeTag)) :
    axesPlan (left :: inds) (right :: axes) =
      (.observed left, .observed right) :: axesPlan inds axes := rfl

theorem trailing_common {State Axis TypeTag Other : Type}
    {runtime : MaskAxesRuntime (Effects State) Axis TypeTag Other}
    {missing : Bool} {fields : List (MaskAxisField Axis TypeTag)}
    {initial final : State} {result : Except Error (Option Bool)}
    {events : List (Event State Axis TypeTag Other)}
    (run : TrailingRun runtime missing fields initial result final events) :
    Common runtime (trailingPlan fields) initial result final events := by
  induction run with
  | done missing initial => exact common_nil _ _ _
  | error missing field rest initial final events error hc => exact common_terminal hc rfl
  | stop missing field rest initial final events hc => exact common_terminal hc rfl
  | next missing seen field rest initial middle final first events result hc tail ih =>
    exact common_next hc ih

theorem axes_common {State Axis TypeTag Other : Type}
    {runtime : MaskAxesRuntime (Effects State) Axis TypeTag Other}
    {inds axes : List (MaskAxisField Axis TypeTag)} {initial final : State}
    {result : Except Error (Option Bool)} {events : List (Event State Axis TypeTag Other)}
    (run : AxesRun runtime inds axes initial result final events) :
    Common runtime (axesPlan inds axes) initial result final events := by
  induction run with
  | trailing axes initial final result events tail => exact trailing_common tail
  | exhausted axis rest initial => exact common_nil _ _ _
  | error left right inds axes initial final events error hc =>
    rw [axesPlan_cons]
    exact common_terminal hc rfl
  | stop left right inds axes initial final events hc =>
    rw [axesPlan_cons]
    exact common_terminal hc rfl
  | next left right inds axes initial middle final first events result hc tail ih =>
    rw [axesPlan_cons]
    exact common_next hc ih


def LastTerminal {State Axis TypeTag Other : Type}
    (runtime : MaskAxesRuntime (Effects State) Axis TypeTag Other)
    (events : List (Event State Axis TypeTag Other)) (result : Except Error (Option Bool)) : Prop :=
  ∃ event, events.getLast? = some event ∧ TerminalObservation runtime event = some result

theorem last_from_chunk {State Axis TypeTag Other : Type}
    {runtime : MaskAxesRuntime (Effects State) Axis TypeTag Other}
    {request : MaskAxisOperand Axis TypeTag × MaskAxisOperand Axis TypeTag}
    {status : Except Error Step} {final : State} {events : List (Event State Axis TypeTag Other)}
    {result : Except Error (Option Bool)}
    (hc : Chunk runtime request status final events) (hf : finish status = some result) :
    LastTerminal runtime events result := by
  obtain ⟨⟨event, hlast, hterminal, _⟩, _⟩ := chunk_terminal hc hf
  exact ⟨event, hlast, hterminal⟩

theorem last_append {State Axis TypeTag Other : Type}
    {runtime : MaskAxesRuntime (Effects State) Axis TypeTag Other}
    (first : List (Event State Axis TypeTag Other))
    {events : List (Event State Axis TypeTag Other)} {result : Except Error (Option Bool)}
    (ht : LastTerminal runtime events result) : LastTerminal runtime (first ++ events) result := by
  obtain ⟨event, hlast, hterminal⟩ := ht
  refine ⟨event, ?_, hterminal⟩
  rw [List.getLast?_append, hlast]
  rfl

def TrailingResult {State Axis TypeTag Other : Type}
    (runtime : MaskAxesRuntime (Effects State) Axis TypeTag Other)
    (missing : Bool) (fields : List (MaskAxisField Axis TypeTag))
    (result : Except Error (Option Bool)) (events : List (Event State Axis TypeTag Other)) : Prop :=
  match result with
  | .ok (some true) =>
      missing = false ∧ EqualityCalls events = trailingPlan fields ∧ AllEqualTrue events
  | .ok none =>
      EqualityCalls events = trailingPlan fields ∧ MissingValid events ∧
        (missing = true ∨ MissingWitness runtime events)
  | .ok (some false) => LastTerminal runtime events (.ok (some false))
  | .error error => LastTerminal runtime events (.error error)

theorem trailing_result {State Axis TypeTag Other : Type}
    {runtime : MaskAxesRuntime (Effects State) Axis TypeTag Other}
    {missing : Bool} {fields : List (MaskAxisField Axis TypeTag)}
    {initial final : State} {result : Except Error (Option Bool)}
    {events : List (Event State Axis TypeTag Other)}
    (run : TrailingRun runtime missing fields initial result final events) :
    TrailingResult runtime missing fields result events := by
  induction run with
  | done missing initial =>
    cases missing with
    | false => exact ⟨rfl, rfl, AllEqualTrue_nil⟩
    | true => exact ⟨rfl, MissingValid_nil, .inl rfl⟩
  | error missing field rest initial final events error hc => exact last_from_chunk hc rfl
  | stop missing field rest initial final events hc => exact last_from_chunk hc rfl
  | next missing seen field rest initial middle final first events result hc tail ih =>
    have hcalls : EqualityCalls (first ++ events) =
        (.observed field, maskOneToOne) :: EqualityCalls events := by
      rw [EqualityCalls_append, chunk_calls hc]
      rfl
    cases result with
    | error error => exact last_append first ih
    | ok value =>
      cases value with
      | none =>
        rcases ih with ⟨htcalls, htvalid, hmissing⟩
        refine ⟨?_, (MissingValid_append first events).mpr ⟨(chunk_next hc).2.1, htvalid⟩, ?_⟩
        · rw [hcalls, htcalls]
          rfl
        · rcases hmissing with hmissing | hwitness
          · have hflags : missing = true ∨ seen = true := by
              cases missing with
              | true => exact .inl rfl
              | false =>
                cases seen with
                | true => exact .inr rfl
                | false => cases hmissing
            rcases hflags with hfirst | hseen
            · exact .inl hfirst
            · exact .inr ((MissingWitness_append runtime first events).mpr
                (.inl ((chunk_next hc).2.2.2 hseen)))
          · exact .inr ((MissingWitness_append runtime first events).mpr (.inr hwitness))
      | some value =>
        cases value with
        | false => exact last_append first ih
        | true =>
          rcases ih with ⟨hflags, htcalls, httrue⟩
          have hs : missing = false ∧ seen = false := by
            cases missing with
            | true => cases hflags
            | false =>
              cases seen with
              | true => cases hflags
              | false => exact ⟨rfl, rfl⟩
          refine ⟨hs.1, ?_, (AllEqualTrue_append first events).mpr
            ⟨(chunk_next hc).2.2.1 hs.2, httrue⟩⟩
          rw [hcalls, htcalls]
          rfl


def AxesResult {State Axis TypeTag Other : Type}
    (runtime : MaskAxesRuntime (Effects State) Axis TypeTag Other)
    (inds axes : List (MaskAxisField Axis TypeTag))
    (result : Except Error (Option Bool)) (events : List (Event State Axis TypeTag Other)) : Prop :=
  match result with
  | .ok (some true) =>
      inds.length ≤ axes.length ∧ EqualityCalls events = axesPlan inds axes ∧ AllEqualTrue events
  | .ok none =>
      inds.length ≤ axes.length ∧ EqualityCalls events = axesPlan inds axes ∧ MissingEvidence runtime events
  | .ok (some false) => LastTerminal runtime events (.ok (some false))
  | .error error =>
      LastTerminal runtime events (.error error) ∨
        (error = .boundsError ∧ axes.length < inds.length ∧
          EqualityCalls events = axesPlan inds axes ∧ AllEqualTrue events)

theorem axes_result {State Axis TypeTag Other : Type}
    {runtime : MaskAxesRuntime (Effects State) Axis TypeTag Other}
    {inds axes : List (MaskAxisField Axis TypeTag)} {initial final : State}
    {result : Except Error (Option Bool)} {events : List (Event State Axis TypeTag Other)}
    (run : AxesRun runtime inds axes initial result final events) :
    AxesResult runtime inds axes result events := by
  induction run with
  | trailing axes initial final result events tail =>
    have ht := trailing_result tail
    cases result with
    | error error => exact .inl ht
    | ok value =>
      cases value with
      | none =>
        rcases ht with ⟨hcalls, hvalid, hwitness⟩
        have hw : MissingWitness runtime events := by
          rcases hwitness with impossible | hw
          · cases impossible
          · exact hw
        exact ⟨Nat.zero_le _, hcalls, ⟨hvalid, hw⟩⟩
      | some value =>
        cases value with
        | false => exact ht
        | true => exact ⟨Nat.zero_le _, ht.2.1, ht.2.2⟩
  | exhausted axis rest initial =>
    refine .inr ⟨rfl, ?_, rfl, AllEqualTrue_nil⟩
    simp only [List.length_nil, List.length_cons]
    omega
  | error left right inds axes initial final events error hc => exact .inl (last_from_chunk hc rfl)
  | stop left right inds axes initial final events hc => exact last_from_chunk hc rfl
  | next left right inds axes initial middle final first events result hc tail ih =>
    have hcalls : EqualityCalls (first ++ events) =
        (.observed left, .observed right) :: EqualityCalls events := by
      rw [EqualityCalls_append, chunk_calls hc]
      rfl
    have hfirst : AllEqualTrue first := (chunk_next hc).2.2.1 rfl
    cases result with
    | error error =>
      rcases ih with hlast | ⟨herr, hshort, htcalls, httrue⟩
      · exact .inl (last_append first hlast)
      · refine .inr ⟨herr, ?_, ?_, (AllEqualTrue_append first events).mpr ⟨hfirst, httrue⟩⟩
        · simp only [List.length_cons]
          omega
        · rw [hcalls, htcalls, axesPlan_cons]
    | ok value =>
      cases value with
      | none =>
        rcases ih with ⟨hbound, htcalls, hmissing⟩
        refine ⟨?_, ?_, MissingEvidence_append_right runtime first events (chunk_next hc).2.1 hmissing⟩
        · simp only [List.length_cons]
          omega
        · rw [hcalls, htcalls, axesPlan_cons]
      | some value =>
        cases value with
        | false => exact last_append first ih
        | true =>
          rcases ih with ⟨hbound, htcalls, httrue⟩
          refine ⟨?_, ?_, (AllEqualTrue_append first events).mpr ⟨hfirst, httrue⟩⟩
          · simp only [List.length_cons]
            omega
          · rw [hcalls, htcalls, axesPlan_cons]

end pr_Trace

theorem Models1G6MaskAxesProtocol_proven :
    JuliaLean.Proofs.base.multidimensional.Models1Group6.MaskAxesProtocol.CompleteTrace := by
  intro State Axis TypeTag Other inst runtime inds axes initial
  obtain ⟨result, final, events, heq, hrun⟩ :=
    pr_Trace.axes_run runtime inds.fields axes.fields initial []
  have hactual : observe (checkBooleanAxesRaw (tracingRuntime runtime) inds axes) (initial, []) =
      (result, (final, events)) := by
    unfold checkBooleanAxesRaw
    rw [pr_axes_recursive (tracingRuntime runtime) inds.fields axes.fields axes.lengthFits]
    simpa only [List.nil_append] using heq
  dsimp only
  rw [hactual]
