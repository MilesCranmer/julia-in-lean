    let actual := JuliaLean.Proofs.base.multidimensional.Models1Group6.MaskAxesProtocol.observe
      (do
        let result ← checkindexMaskTupleValue (tracingAxisRuntime runtime.axisRuntime) inds
          (recordAction (.axes reference) (runtime.axes reference))
        pure (logicalMaskBaseResult (Other := Other) result)) (initial, [])
    actual.2.2 = [.axes reference] ∧
    match JuliaLean.Proofs.base.multidimensional.Models1Group6.MaskAxesProtocol.observe
        (runtime.axes reference) initial with
    | (.error error, final) => actual = (.error error, (final, [.axes reference]))
    | (.ok (.other _), final) =>
        actual = (.error (.methodError "_check_boolean_axes"), (final, [.axes reference]))
    | (.ok (.tuple _), _) => True := by
  have hRuntime : tracingAxisRuntime (MaskRef := MaskRef) runtime.axisRuntime =
      pr_preserveRuntime runtime.axisRuntime := rfl
  rw [hRuntime]
  unfold checkindexMaskTupleValue
  have hAxes : ∀ axes, checkBooleanAxesRaw
      (pr_preserveRuntime (Extra := List (Request MaskRef)) runtime.axisRuntime) inds axes =
