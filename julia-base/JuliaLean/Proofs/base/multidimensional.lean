    result = (showPairsCartesianVectorOpen observed io typeObject replacement replacementTop).run (initial, []) ∧
    match result with
    | none => True
    | some (reply, (final, records)) =>
        PairsShowTrace "pairs(IndexCartesian(), ::" io typeObject initial final reply records

theorem pairsCartesianVectorShowObservations_proven :
    Models2Group3.PairsCartesianVectorShowObservations := by
  intro E S IO TypeObject Pair Top Rendered Value ops io typeObject pair replacement toplevel replacementTop initial
  refine ⟨rfl, ?_⟩
  unfold Models2Group3.showPairsCartesianVectorOpen Models2Group3.observePairsShowOps
  dsimp only
  rw [observeDimensionAction_bind_run]
  cases (ops.interpolate "pairs(IndexCartesian(), ::" typeObject ")").run initial with
  | none => trivial
  | some p1 =>
      rcases p1 with ⟨r1, s1⟩
      cases r1 with
      | error e => exact Or.inl ⟨e, rfl, rfl⟩
      | ok rendered =>
          dsimp only
