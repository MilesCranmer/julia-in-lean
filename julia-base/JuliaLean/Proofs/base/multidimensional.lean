theorem dispatch {State MaskRef Axis TypeTag Other NonTuple : Type} [DecidableEq TypeTag]
    (runtime : LogicalMaskRuntime (Effects State) MaskRef Axis TypeTag Other NonTuple)
    (inds : MaskAxisTuple Axis TypeTag) (mask : BooleanMaskRef MaskRef) :
    checkindexBooleanMaskValue (tracingRuntime runtime) inds mask =
      match (SelectedActions runtime inds mask).head? with
      | some (receiver, action) => recordAction (.extension receiver) action
      | none => do
          let result ← checkindexMaskTupleValue (tracingAxisRuntime runtime.axisRuntime) inds
            (recordAction (.axes (TerminalReference mask)) (runtime.axes (TerminalReference mask)))
          return logicalMaskBaseResult result := by
  induction mask with
  | terminal reference =>
    cases h : runtime.extension inds (.terminal reference) with
    | none =>
      simp only [checkindexBooleanMaskValue, tracingRuntime, h, Option.map_none,
        SelectedActions, ReceiverPath, List.filterMap_cons, List.filterMap_nil,
        List.head?_nil, TerminalReference]
    | some action =>
      simp only [checkindexBooleanMaskValue, tracingRuntime, h, Option.map_some,
        SelectedActions, ReceiverPath, List.filterMap_cons, List.filterMap_nil,
        List.head?_cons]
  | logical reference child count ih =>
    cases h : runtime.extension inds (.logical reference child count) with
    | none =>
      simpa only [checkindexBooleanMaskValue, tracingRuntime, h, Option.map_none,
        SelectedActions, ReceiverPath, List.filterMap_cons, TerminalReference] using ih
    | some action =>
      simp only [checkindexBooleanMaskValue, tracingRuntime, h, Option.map_some,
