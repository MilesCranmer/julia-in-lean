def ConversionValueFits (target : IntTy) (value : Int) : Prop :=
  IntTy.min target ≤ value ∧ value ≤ IntTy.max target

/-- Numeric conversions preserve the sole coordinate exactly when the target can represent it, otherwise throwing InexactError. Bool succeeds only at 0 or 1 and returns the corresponding truth value. The rank-one source dispatch domain is represented by every singleton coordinate tuple; all ten BitInteger targets and every Int64 value are included without narrowing the domain.
Julia source: base/multidimensional.jl:145-145 @ f755f49a9e41380d7da126b3c1db9fe7f83dd027. -/
-- Source: base/multidimensional.jl:145-145 @ f755f49a9e41380d7da126b3c1db9fe7f83dd027
--     convert(::Type{T}, index::CartesianIndex{1}) where {T<:Number} = convert(T, index[1])
-- /Source
def CartesianNumericConversionsCorrect : Prop :=
  (∀ (target : IntTy) (coordinate : I64),
    match convertIndexBits target [coordinate] with
    | .ok value => value.val = coordinate.val
    | .error (.inexactError _) => ¬ ConversionValueFits target coordinate.val
    | .error _ => False) ∧
  (∀ coordinate : I64,
    match convertIndexBool [coordinate] with
    | .ok value => coordinate.val = if value then 1 else 0
    | .error (.inexactError _) => coordinate.val ≠ 0 ∧ coordinate.val ≠ 1
