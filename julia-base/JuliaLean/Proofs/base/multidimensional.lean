def NativeTupleSplitCorrect : Prop :=
  ∀ (A : Type) (values : List A) (rank : SplitRank), TupleArity values →
    let result := splitGeneric nativeTupleSplitOps values rank
    match rank with
    | .other => result = .error .typeError
    | .machine count =>
        if count.val < 0 then ∃ message, result = .error (.argumentError message)
        else match result with
          | .ok (front, rest) =>
              front ++ rest = values ∧ front.length = min count.val.toNat values.length
          | .error _ => False

theorem nativeTupleSplitCorrect_proven :
    Models2Group3.NativeTupleSplitCorrect := by
  intro A values rank _
  cases rank with
  | other => rfl
  | machine count =>
      by_cases hneg : count.val < 0
      · simp only [hneg, ↓reduceIte, Models2Group3.splitGeneric, Models1Group5.referenceTuple]
        exact ⟨_, rfl⟩
      · simp only [hneg, ↓reduceIte, Models2Group3.splitGeneric, Models1Group5.referenceTuple,
          Models2Group3.nativeTupleSplitOps, Bind.bind, Except.bind, Pure.pure, Except.pure,
          Models2Group3.liftResult]
