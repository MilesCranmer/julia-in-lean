          initial[array.header.ref.mem.handle]? = some object ∧
          object.slots.length ≤ Slot array index)
  | .undefinedBehaviour what =>
      what = "dangling memory handle" ∧ HeaderAllows boundsChecks array index ∧
        initial[array.header.ref.mem.handle]? = none
  | .concurrency text =>
      text = message ∧ HeaderAllows boundsChecks array index ∧ ∃ object,
