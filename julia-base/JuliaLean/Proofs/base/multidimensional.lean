inductive MapConstructionEvent (Extra R Field Other Out : Type) where
  | mapping (event : RegionEvent Extra R Field Other)
  | tupleConstructor (fields : List Field) (result : Except (Sum Error Extra) Out)
  | otherConstructor (value : Other) (result : Except (Sum Error Extra) Out)

def mapConstructionError {Extra R Field Other Out : Type} :
    MapConstructionEvent Extra R Field Other Out → Option (Sum Error Extra)
  | .mapping event => regionEventError event
  | .tupleConstructor _ (.error error) => some error
  | .otherConstructor _ (.error error) => some error
  | _ => none

def observeMappedConstructorOps {Extra S R Field Other Out : Type}
    (ops : MappedConstructorOps (ConstructorObservationM Extra S) R Field Other Out) :
    MappedConstructorOps
      (ConstructorObservationM Extra
        (S × List (S × S × MapConstructionEvent Extra R Field Other Out)))
      R Field Other Out where
  mapping := {
    element := fun range =>
      observeConstructorAction (ops.mapping.element range) fun result =>
        .mapping (.convert range (result.map (Sum.inl : Field → Sum Field Other)))
    selected := fun _ ranges =>
      (ops.mapping.selected ops.mapping.element ranges).map fun action =>
        observeConstructorAction action fun result =>
          .mapping (.selectedMap ranges (result.map sizeMappingTag))
    applyIterateOther := fun head tail =>
      observeConstructorAction (ops.mapping.applyIterateOther head tail) fun result =>
        .mapping (.splat (.inl head) tail
          (result.map (fun fields => fields.map (Sum.inl : Field → Sum Field Other)))) }
  tupleConstructor := fun fields =>
    observeConstructorAction (ops.tupleConstructor fields) (.tupleConstructor fields)
  otherConstructor := fun value =>
    observeConstructorAction (ops.otherConstructor value) (.otherConstructor value)

/-- Flat tuple-map conservation plus a final argument/result observation.
The constructor sees the exact completed map output; its own dispatch body
is not repeated or constrained. The only closed output case is the actual
empty tuple, which uses the installed concrete empty constructor. -/
def MapConstructionObservation {Extra S R Field Other Out : Type}
    (ranges : List R) (empty : Out) (initial : S)
    (outcome : Option (Except (Sum Error Extra) Out ×
      (S × List (S × S × MapConstructionEvent Extra R Field Other Out)))) : Prop :=
  match outcome with
  | none => True
  | some (result, (final, records)) =>
      let events := records.map (fun record => record.2.2)
      let mappedEvents := events.filterMap fun event => match event with
        | .mapping mapped => some mapped
        | _ => none
      let constructorEvents := events.filterMap fun event => match event with
        | .mapping _ => none
        | other => some other
      ConstructorStateThread initial final records ∧
      RegionEventOrder ranges mappedEvents ∧ regionConstructorEvents mappedEvents = [] ∧
      events = mappedEvents.map MapConstructionEvent.mapping ++ constructorEvents ∧
      (∀ (k : Nat) (event : MapConstructionEvent Extra R Field Other Out),
        events[k]? = some event → ∀ error, mapConstructionError event = some error →
          k + 1 = events.length ∧ result = .error error) ∧
      ((∀ event ∈ mappedEvents, regionEventError event = none) →
        ∃ mapped : Sum (List Field) Other,
          RegionCompletedMapping ranges mappedEvents (sizeMappingTag mapped) ∧
          match mapped with
          | .inl [] => constructorEvents = [] ∧ result = .ok empty
          | .inl fields => constructorEvents = [.tupleConstructor fields result]
          | .inr value => constructorEvents = [.otherConstructor value result])

/-- Complete mixed-dimension and mapped step/first/last domains. The argument
types of downstream constructors remain genuinely unfixed. All mapping and
constructor callees are quantified without correctness laws; tuple arity is
the only premise. Includes custom non-tuple map returns, exceptions, mutation
and delayed constructor effects.
Source: base/multidimensional.jl:305-306,491-494. -/
def MappedConstructorObservations : Prop :=
  (∀ (Extra S R Field Other Value : Type)
    (ops : MappedConstructorOps (ConstructorObservationM Extra S)
      R Field Other (Sum CIs Value)) (ranges : List R) (state : S), TupleArity ranges →
    MapConstructionObservation ranges (.inl cartesianIndicesEmpty) state
      ((regionFromMixedGeneric (observeMappedConstructorOps ops) ranges).run (state, []))) ∧
  (∀ (Extra S R Field Other Value : Type)
    (ops : MappedConstructorOps (ConstructorObservationM Extra S)
      R Field Other (Sum CI Value)) (ranges : List R) (state : S), TupleArity ranges →
    let observed := observeMappedConstructorOps ops
    MapConstructionObservation ranges (.inl []) state
      ((regionStepGeneric observed ranges).run (state, [])) ∧
    MapConstructionObservation ranges (.inl []) state
      ((regionFirstGeneric observed ranges).run (state, [])) ∧
    MapConstructionObservation ranges (.inl []) state
      ((regionLastGeneric observed ranges).run (state, [])))

inductive ArrayRegionEvent (E A Axes Out : Type) where
  | axes (array : A) (result : Except E Axes)
  | construct (axes : Axes) (result : Except E Out)

def observeArrayRegionOps {E S A Axes Out : Type}
    (ops : ArrayRegionOps (DimensionObservationM E S) A Axes Out) :
    ArrayRegionOps
      (DimensionObservationM E (S × List (S × S × ArrayRegionEvent E A Axes Out)))
      A Axes Out where
  axes := fun array => observeDimensionAction (ops.axes array) (.axes array)
  construct := fun axes => observeDimensionAction (ops.construct axes) (.construct axes)

/-- Exactly one axes observation precedes constructor dispatch; its exact
returned identity is retained. The state at a constructor call includes all
axes mutations, and either error is propagated without later calls. -/
def ArrayRegionObservation {E S A Axes Out : Type} (array : A) (initial : S)
    (outcome : Option (Except E Out ×
      (S × List (S × S × ArrayRegionEvent E A Axes Out)))) : Prop :=
  match outcome with
  | none => True
  | some (result, (final, records)) =>
      match result with
      | .ok value =>
          ∃ axes middle,
            records = [(initial, middle, .axes array (.ok axes)),
              (middle, final, .construct axes (.ok value))]
      | .error error =>
          records = [(initial, final, .axes array (.error error))] ∨
          ∃ axes middle,
            records = [(initial, middle, .axes array (.ok axes)),
              (middle, final, .construct axes (.error error))]

/-- Both abstract-array methods retain arbitrary axes types, constructor
results, effects and thrown values. Neither demands a tuple-valued axes
method nor a CartesianIndices-valued custom constructor.
Source: base/multidimensional.jl:308,435. -/
def ArrayRegionObservations : Prop :=
  ∀ (E S A Axes Out : Type) (ops : ArrayRegionOps (DimensionObservationM E S) A Axes Out)
    (array : A) (state : S),
    let observed := observeArrayRegionOps ops
    ArrayRegionObservation array state ((regionFromArrayGeneric observed array).run (state, [])) ∧
    ArrayRegionObservation array state ((eachindexArrayGeneric observed array).run (state, []))

/-- Concrete native dimension normalization and installed native-range
construction. No supplied callee law is used by the mathematical property. -/
def nativeMixedRegionOps :
    MappedConstructorOps RangeResult I64 OrdinalRange64 Empty (Sum CIs Region64) where
  mapping := {
    element := normalizeIntegerDimension nativeIntegerDimensionOps
    selected := fun _ _ => none
    applyIterateOther := fun _ impossible => nomatch impossible }
  tupleConstructor := fun fields => Sum.inr <$> regionFromRanges fields
  otherConstructor := fun impossible => nomatch impossible

/-- The known empty constructor keeps rank zero. Every other native size
becomes a OneTo whose point count is max(0,size), in its original position.
All Int64 sizes, including negative and extreme values, are admitted.
Source: base/multidimensional.jl:305-306,311; base/range.jl:487-491. -/
def NativeMixedRegionCorrect : Prop :=
  ∀ sizes : CI, TupleArity sizes →
    match regionFromMixedGeneric nativeMixedRegionOps sizes with
    | .ok (.inl empty) => sizes = [] ∧ empty = []
    | .ok (.inr ranges) =>
        sizes ≠ [] ∧ ranges.length = sizes.length ∧
        ∀ (k : Nat) (size : I64), sizes[k]? = some size →
          ∃ value : JuliaLean.base.range.OneTo I64,
            ranges[k]? = some (.oneTo value) ∧ value.stop.val = max 0 size.val
    | .error _ => False

theorem nativeMixedRegionCorrect_proven :
    Models2Group3.NativeMixedRegionCorrect := by
  intro sizes _
  let clamp (s : I64) : I64 := if JuliaLean.base.int.ltSame (int 0) s then s else int 0
  have honeto (s : I64) :
      Models2Group3.normalizeIntegerDimension Models2Group3.nativeIntegerDimensionOps s =
        .ok (.oneTo ⟨clamp s⟩) := rfl
  have hclamp_val (s : I64) : (clamp s).val = max 0 s.val := by
    have h0 : (int 0).val = 0 := by decide
    change (if JuliaLean.base.int.ltSame (int 0) s then s else int 0).val = max 0 s.val
    rw [Models1Group5.Batch9.scalar7_ltSame, h0]
    by_cases hp : 0 < s.val
    · simp only [hp, decide_true, ↓reduceIte]; omega
    · simp only [hp, decide_false, Bool.false_eq_true, ↓reduceIte, h0]; omega
  unfold Models2Group3.regionFromMixedGeneric Models2Group3.mapThenConstruct
  rw [tupleMapDispatch_ok Models2Group3.nativeMixedRegionOps.mapping
    (fun s => .oneTo ⟨clamp s⟩) (fun _ _ => rfl) sizes (fun s _ => honeto s)]
  cases sizes with
  | nil => exact ⟨rfl, rfl⟩
  | cons s ss =>
      simp only [List.map_cons, Bind.bind, Except.bind,
        Models2Group3.nativeMixedRegionOps, Models1Group5.regionFromRanges,
        Functor.map, Except.map, List.map_id_fun, id_eq]
      refine ⟨List.cons_ne_nil s ss, by simp [List.length_map], ?_⟩
      intro k size hk
      refine ⟨⟨clamp size⟩, ?_, hclamp_val size⟩
      cases k with
      | zero => injection hk with hk; subst hk; rfl
      | succ k => simp only [List.getElem?_cons_succ] at hk ⊢; simp [List.getElem?_map, hk]

def nativeArrayRegionOps : ArrayRegionOps RegionResult Region64 Region64 Region64 where
  axes := regionAxes
  construct := regionFromRanges

def NativeArrayRegionShape (original result : Region64) : Prop :=
  result.length = original.length ∧
  ∀ (k : Nat) (range : OrdinalRange64), original[k]? = some range →
    ∃ value : JuliaLean.base.range.OneTo I64,
      result[k]? = some (.oneTo value) ∧ SizeMachineAxisCount range value.stop

/-- On installed native CartesianIndices arrays, both wrappers return the
actual unchecked OneTo axes. Signed overflow and negative unchecked OneTo
stops are preserved instead of being clamped by a new constructor.
Source: base/multidimensional.jl:308,387,435; base/range.jl:503,794-830. -/
def NativeArrayRegionCorrect : Prop :=
  ∀ original : Region64, TupleArity original →
    (∀ range ∈ original, RangeConstructible range) →
    (match regionFromArrayGeneric nativeArrayRegionOps original with
     | .ok result => NativeArrayRegionShape original result
     | .error _ => False) ∧
    (match eachindexArrayGeneric nativeArrayRegionOps original with
     | .ok result => NativeArrayRegionShape original result
     | .error _ => False)

theorem nativeArrayRegionCorrect_proven :
    Models2Group3.NativeArrayRegionCorrect := by
  intro original harity hconst
  have ha : Models1Group5.RegionDomain original := ⟨harity, hconst⟩
  have h := Models1Group5.Batch9.ctor7_array_indices_from_counts
    Models1Group5.Batch9.scalar7_range_count original ha
  refine ⟨?_, ?_⟩
  · have h1 := h.1
    change match Models1Group5.regionFromArray original with
      | .ok result => Models2Group3.NativeArrayRegionShape original result
      | .error _ => False
    cases hr : Models1Group5.regionFromArray original with
    | error _ => rw [hr] at h1; exact h1
    | ok res =>
        rw [hr] at h1
        refine ⟨h1.2.1, fun k range hk => ?_⟩
        obtain ⟨count, hax, hc⟩ := h1.2.2 k range hk
        exact ⟨⟨count⟩, hax, hc⟩
  · have h2 := h.2
    change match Models1Group5.eachindexRegion original with
      | .ok result => Models2Group3.NativeArrayRegionShape original result
      | .error _ => False
    cases hr : Models1Group5.eachindexRegion original with
    | error _ => rw [hr] at h2; exact h2
    | ok res =>
        rw [hr] at h2
        refine ⟨h2.2.1, fun k range hk => ?_⟩
        obtain ⟨count, hax, hc⟩ := h2.2.2 k range hk
        exact ⟨⟨count⟩, hax, hc⟩

def nativeMappedCoordinateOps (observe : OrdinalRange64 → I64) :
    MappedConstructorOps RegionResult OrdinalRange64 I64 Empty (Sum CI Empty) where
  mapping := {
