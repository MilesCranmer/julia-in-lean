def BitAssignedBoundsCorrect : Prop :=
  ∀ (rank : Nat) (B : BitArrayFields rank) (I0 : I64) (I : CI),
    BitConstructorMetadata B → (I.length : Int) ≤ IntTy.max .i64 →
