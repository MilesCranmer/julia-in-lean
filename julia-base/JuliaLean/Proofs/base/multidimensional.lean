abbrev RegionPredicateException (E : Type) := Sum (Sum Error JuliaLean.base.range.Exc) E
abbrev RegionPredicateM (E S : Type) := ExceptT (RegionPredicateException E) (StateT S Option)

local instance regionPredicateError {E S : Type} : MonadExceptOf Error (RegionPredicateM E S) where
  throw error := ExceptT.mk fun state => some (.error (.inl (.inl error)), state)
  tryCatch action handler := ExceptT.mk fun state =>
    match action.run state with
    | none => none
    | some (.ok value, state') => some (.ok value, state')
    | some (.error (.inl (.inl error)), state') => (handler error).run state'
    | some (.error error, state') => some (.error error, state')

local instance regionPredicateRangeError {E S : Type} :
    MonadExceptOf JuliaLean.base.range.Exc (RegionPredicateM E S) where
  throw error := ExceptT.mk fun state => some (.error (.inl (.inr error)), state)
  tryCatch action handler := ExceptT.mk fun state =>
    match action.run state with
    | none => none
    | some (.ok value, state') => some (.ok value, state')
    | some (.error (.inl (.inr error)), state') => (handler error).run state'
    | some (.error error, state') => some (.error error, state')

def observeRegionPredicateAction {E S Event A : Type}
    (action : RegionPredicateM E S A) (event : Except (RegionPredicateException E) A → Event) :
    RegionPredicateM E (S × List (S × S × Event)) A :=
  ExceptT.mk fun (state, events) =>
    match action.run state with
    | none => none
    | some (result, state') =>
        some (result, (state', events ++ [(state, state', event result)]))

inductive RegionAllEvent (E O T : Type) where
  | identity (value : O) (result : Except (RegionPredicateException E) (RegionTruth O))
  | ismissing (value : O) (result : Except (RegionPredicateException E) (RegionTruth O))
  | one (fields : List (RegionTruth O)) (result : Except (RegionPredicateException E) (RegionTruth O))
  | two (fields : List (RegionTruth O)) (result : Except (RegionPredicateException E) (RegionTruth O))
  | loop (fields : List (RegionTruth O)) (result : Except (RegionPredicateException E) (RegionTruth O))
  | recursive (missing : Bool) (fields : List (RegionTruth O))
      (result : Except (RegionPredicateException E) (RegionTruth O))
  | other (value : T) (result : Except (RegionPredicateException E) (RegionTruth O))

/-- Selected overloads are observed atomically, including any calls they
make through the original identity function received as an argument. -/
def observeRegionAllOps {E S Event Tag O T : Type}
    (inject : RegionAllEvent E O T → Event) (ops : RegionAllOps (RegionPredicateM E S) Tag O T) :
    RegionAllOps (RegionPredicateM E (S × List (S × S × Event))) Tag O T where
  otherType := ops.otherType
  identity := fun value => observeRegionPredicateAction (ops.identity value) (fun r => inject (.identity value r))
  ismissing := fun value => observeRegionPredicateAction (ops.ismissing value) (fun r => inject (.ismissing value r))
  selectedOne := fun fields => (ops.selectedOne fields).map fun action =>
    observeRegionPredicateAction action (fun r => inject (.one fields r))
  selectedTwo := fun _ fields => (ops.selectedTwo (regionTruthIdentity ops) fields).map fun action =>
    observeRegionPredicateAction action (fun r => inject (.two fields r))
  selectedLoop := fun _ fields => (ops.selectedLoop (regionTruthIdentity ops) fields).map fun action =>
    observeRegionPredicateAction action (fun r => inject (.loop fields r))
  selectedRecursive := fun _ missing fields =>
    (ops.selectedRecursive (regionTruthIdentity ops) missing fields).map fun action =>
      observeRegionPredicateAction action (fun r => inject (.recursive missing fields r))
  otherAll := fun value => observeRegionPredicateAction (ops.otherAll value) (fun r => inject (.other value r))

def regionAllEventResult {E O T : Type} : RegionAllEvent E O T →
    Except (RegionPredicateException E) (RegionTruth O)
  | .identity _ result | .ismissing _ result | .one _ result | .two _ result
  | .loop _ result | .recursive _ _ result | .other _ result => result

def regionAllDirectResult {E O T : Type} : RegionAllEvent E O T →
    Option (Except (RegionPredicateException E) (RegionTruth O))
  | .one _ result | .two _ result | .loop _ result | .recursive _ _ result | .other _ result => some result
  | _ => none

def regionTruthOthers {O : Type} (fields : List (RegionTruth O)) : List O :=
  fields.filterMap fun field => match field with | .other other => some other | _ => none

def regionAllIdentityCalls {E O T : Type} (events : List (RegionAllEvent E O T)) : List O :=
  events.filterMap fun event => match event with | .identity other _ => some other | _ => none

/-- Input identity references form a prefix; custom ismissing sees exactly
the value just returned by identity. Selected root all methods get the whole
tuple; selected recursion gets an actual suffix. Any selected result is the
final result, including arbitrary non-Bool values. -/
def RegionAllCallOrder {E O T : Type} (fields : List (RegionTruth O))
    (events : List (RegionAllEvent E O T))
    (result : Except (RegionPredicateException E) (RegionTruth O)) : Prop :=
  (∃ rest, regionTruthOthers fields = regionAllIdentityCalls events ++ rest) ∧
  (∀ i event, events[i]? = some event →
    (∀ error, regionAllEventResult event = .error error →
      i + 1 = events.length ∧ result = .error error) ∧
    (∀ reply, regionAllDirectResult event = some reply →
      i + 1 = events.length ∧ result = reply) ∧
    match event with
    | .identity _ (.ok (.bool false)) => i + 1 = events.length ∧ result = .ok (.bool false)
    | .identity _ _ => True
    | .ismissing value reply =>
        (∃ original, events[i - 1]? = some (.identity original (.ok (.other value)))) ∧
        (∀ answer, reply = .ok answer →
          (match answer with | .bool true => False | _ => True) →
          i + 1 = events.length ∧ result = .error (.inl (.inl .typeError)))
    | .one actual _ | .two actual _ | .loop actual _ =>
        actual = fields ∧ regionTruthHasOther actual = true ∧ i = 0
    | .recursive _ actual _ =>
        regionTruthHasOther actual = true ∧ ∃ initialPart, fields = initialPart ++ actual
    | .other _ _ => False)

def regionTruthNativeAnswer {O : Type} (fields : List (RegionTruth O)) : RegionTruth O :=
  if fields.any (fun field => match field with | .bool false => true | _ => false) then .bool false
  else if fields.any (fun field => match field with | .missing => true | _ => false) then .missing
  else .bool true

/-- Full effects/dispatch invariant of the required all helper. It includes
arbitrary selected all/identity/ismissing calls, errors and state, raw non-Bool
results, both tuple traversal branches, and non-Tuple input. Native Bool and
Missing tuples have an independent three-valued truth specification and do
not invoke any open operation. Source: base/anyall.jl:80,203-257. -/
def RegionAllObservations : Prop :=
  ∀ (E S Tag O T : Type) (inst : DecidableEq Tag),
    letI := inst
    ∀ (ops : RegionAllOps (RegionPredicateM E S) Tag O T)
      (argument : Sum (List (RegionTruth O)) T) (initial : S),
      (match argument with | .inl fields => (fields.length : Int) ≤ IntTy.max .i64 | .inr _ => True) →
      let observed := (regionAllResult (observeRegionAllOps id ops) argument).run (initial, [])
      (observed.map fun (result, (state, _)) => (result, state)) =
        (regionAllResult ops argument).run initial ∧
      (match argument with
        | .inl fields => regionTruthHasOther fields = false →
            observed = some (.ok (regionTruthNativeAnswer fields), (initial, []))
        | .inr _ => True) ∧
      match observed with
      | none => True
      | some (result, (final, records)) =>
          RegionConversionStateThread initial final records ∧
          let events := records.map fun record => record.2.2
          match argument with
          | .inl fields => RegionAllCallOrder fields events result
          | .inr other => events = [.other other result]

/-- A concrete default dispatch environment for arbitrary non-Bool values:
identity preserves them and generic ismissing is false. It is not a law
assumed of any public custom operation. -/
def defaultRegionAllOps {E S Tag O : Type} (tag : O → Tag) :
    RegionAllOps (RegionPredicateM E S) Tag O Empty where
  otherType := tag
  identity := fun other => pure (.other other)
  ismissing := fun _ => pure (.bool false)
  otherAll := fun impossible => nomatch impossible

/-- Declarative first-decisive-position semantics: true and Missing may
precede the decisive false/non-Bool; a false wins only when reached first.
There is no recursion or model call in this independent result relation. -/
def RegionDefaultAllResult {E O : Type} (fields : List (RegionTruth O))
    (result : Except (RegionPredicateException E) (RegionTruth O)) : Prop :=
  let harmless := fun value : RegionTruth O => value = .bool true ∨ value = .missing
  (result = .ok (.bool false) ∧
    ∃ initialPart rest, fields = initialPart ++ (.bool false :: rest) ∧ ∀ value ∈ initialPart, harmless value) ∨
  (result = .error (.inl (.inl .typeError)) ∧
    ∃ initialPart other rest, fields = initialPart ++ (.other other :: rest) ∧ ∀ value ∈ initialPart, harmless value) ∨
  (result = .ok .missing ∧ (∀ value ∈ fields, harmless value) ∧ .missing ∈ fields) ∨
  (result = .ok (.bool true) ∧ ∀ value ∈ fields, value = .bool true)

/-- Arbitrary tuple length, Bool/Missing positions, and other payloads are
covered, including TypeError at the first reached non-Bool and no mutation.
Source: base/anyall.jl:203-257; base/essentials.jl:1542. -/
def RegionAllDefaultTruthCorrect : Prop :=
  ∀ (E S Tag O : Type) (inst : DecidableEq Tag),
    letI := inst
    ∀ (tag : O → Tag) (fields : List (RegionTruth O)) (state : S),
      (fields.length : Int) ≤ IntTy.max .i64 →
      match (regionAllResult (defaultRegionAllOps (E := E) tag) (.inl fields)).run state with
      | some (result, final) => final = state ∧ RegionDefaultAllResult fields result
      | none => False

inductive RegionBinaryEvent (E A B O T : Type) where
  | element (left : A) (right : B)
      (result : Except (RegionPredicateException E) (RegionTruth O))
  | map (left : List A) (right : List B)
      (result : Except (RegionPredicateException E) (Sum (List (RegionTruth O)) T))
  | splat (head : RegionTruth O) (tail : T)
      (result : Except (RegionPredicateException E) (List (RegionTruth O)))
  | all (event : RegionAllEvent E O T)

def observeRegionEqualityOps {E S C Tag O T : Type}
    (ops : RegionEqualityOps (RegionPredicateM E S) C Tag O T) :
    RegionEqualityOps
      (RegionPredicateM E (S × List (S × S ×
        RegionBinaryEvent E (RegionConversionField C) (RegionConversionField C) O T)))
      C Tag O T where
  customEqual := fun left right =>
    observeRegionPredicateAction (ops.customEqual left right) (.element left right)
  selectedMap := fun _ left right =>
    (ops.selectedMap (regionEqualField ops) left right).map fun action =>
      observeRegionPredicateAction action (.map left right)
  applyIterateOther := fun head tail =>
    observeRegionPredicateAction (ops.applyIterateOther head tail) (.splat head tail)
  allOps := observeRegionAllOps RegionBinaryEvent.all ops.allOps

def observeRegionMembershipOps {E S C Tag O T : Type}
    (ops : RegionMembershipOps (RegionPredicateM E S) C Tag O T) :
    RegionMembershipOps
      (RegionPredicateM E (S × List (S × S ×
        RegionBinaryEvent E I64 (RegionConversionField C) O T))) C Tag O T where
  customContains := fun index field =>
    observeRegionPredicateAction (ops.customContains index field) (.element index (.inr field))
  selectedMap := fun _ index fields =>
    (ops.selectedMap (regionContainsField ops) index fields).map fun action =>
      observeRegionPredicateAction action (.map index fields)
  applyIterateOther := fun head tail =>
    observeRegionPredicateAction (ops.applyIterateOther head tail) (.splat head tail)
  allOps := observeRegionAllOps RegionBinaryEvent.all ops.allOps

def regionBinaryError {E A B O T : Type} : RegionBinaryEvent E A B O T → Option (RegionPredicateException E)
  | .element _ _ (.error error) | .map _ _ (.error error) | .splat _ _ (.error error) => some error
  | .all event => match regionAllEventResult event with | .error error => some error | _ => none
  | _ => none

def regionBinaryElements {E A B O T : Type} (events : List (RegionBinaryEvent E A B O T)) : List (A × B) :=
  events.filterMap fun event => match event with | .element a b _ => some (a, b) | _ => none

def regionBinaryMaps {E A B O T : Type} (events : List (RegionBinaryEvent E A B O T)) :=
  events.filterMap fun event => match event with | .map a b result => some (a, b, result) | _ => none

def regionBinaryAll {E A B O T : Type} (events : List (RegionBinaryEvent E A B O T)) : List (RegionAllEvent E O T) :=
  events.filterMap fun event => match event with | .all event => some event | _ => none

/-- The observable custom element pairs form an ordered prefix of original
arguments; once all begins, every required map call has already completed.
False and Missing element replies do not short-circuit mapping. Selected maps
can replace only the actual whole tuple or matching recursive suffixes, and
an arbitrary root non-Tuple result is passed unchanged to all. -/
def RegionBinaryObservationContract {E A B O T : Type}
    (left : List A) (right : List B) (openPairs : List (A × B))
    (events : List (RegionBinaryEvent E A B O T))
    (result : Except (RegionPredicateException E) (RegionTruth O)) : Prop :=
  (∃ rest, openPairs = regionBinaryElements events ++ rest) ∧
  (regionBinaryMaps events).length ≤ 1 ∧
  ((regionBinaryMaps events = [] ∧
      ((∃ value, result = .ok value) ∨ regionBinaryAll events ≠ [])) →
    regionBinaryElements events = openPairs) ∧
  (∀ i event, events[i]? = some event →
    (∀ error, regionBinaryError event = some error →
      i + 1 = events.length ∧ result = .error error) ∧
    match event with
    | .element _ _ _ => ∀ j earlier, j < i → events[j]? = some earlier →
        ∃ a b reply, earlier = .element a b reply
    | .map a b reply =>
        a ≠ [] ∧ b ≠ [] ∧
        (∃ prefixA prefixB, left = prefixA ++ a ∧ right = prefixB ++ b ∧ prefixA.length = prefixB.length) ∧
        ((a = left ∧ b = right) ∨ (left.length < 32 ∧ 2 ≤ a.length)) ∧
        (∀ j earlier, j < i → events[j]? = some earlier → ∃ x y r, earlier = .element x y r) ∧
        (∀ other, a = left → b = right → reply = .ok (.inr other) →
          events.getLast? = some (.all (.other other result))) ∧
        (∀ values, a = left → b = right → reply = .ok (.inl values) →
          RegionAllCallOrder values (regionBinaryAll events) result)
    | .splat _ tail _ => ∃ a b, events[i - 1]? = some (.map a b (.ok (.inr tail)))
    | .all event =>
        (∀ j later, i < j → events[j]? = some later → ∃ all, later = .all all) ∧
        (∀ reply, regionAllDirectResult event = some reply →
          i + 1 = events.length ∧ result = reply))

/-- Complete generic equality observation domain: matching machine-sized
ranks; all native or custom range fields; every user-selected map, comparison,
all, identity and ismissing; arbitrary exceptions, mutation, and divergence.
No callee law or Bool-return premise is assumed. Source: base/multidimensional.jl:382-383. -/
def RegionEqualityObservations : Prop :=
  ∀ (E S C Tag O T : Type) (inst : DecidableEq Tag),
    letI := inst
    ∀ (ops : RegionEqualityOps (RegionPredicateM E S) C Tag O T)
      (left right : List (RegionConversionField C)) (initial : S),
      left.length = right.length → (left.length : Int) ≤ IntTy.max .i64 →
      let observed :=
        (JuliaLean.base.multidimensional.Models2Group3.regionEqual
          (observeRegionEqualityOps ops) left right).run (initial, [])
      (observed.map fun (result, (state, _)) => (result, state)) =
        (JuliaLean.base.multidimensional.Models2Group3.regionEqual ops left right).run initial ∧
      match observed with
      | none => True
      | some (result, (final, records)) =>
          RegionConversionStateThread initial final records ∧
          RegionBinaryObservationContract left right
            ((left.zip right).filter fun pair => match pair with
              | (.inl _, .inl _) => false | _ => true)
            (records.map fun record => record.2.2) result

/-- Complete generic same-rank membership observation domain, preserving
original machine coordinates and custom range handles. The eager map phase
cannot stop at an earlier false result. Source: base/multidimensional.jl:506. -/
def RegionMembershipObservations : Prop :=
  ∀ (E S C Tag O T : Type) (inst : DecidableEq Tag),
    letI := inst
    ∀ (ops : RegionMembershipOps (RegionPredicateM E S) C Tag O T)
      (index : CI) (fields : List (RegionConversionField C)) (initial : S),
      index.length = fields.length → (index.length : Int) ≤ IntTy.max .i64 →
      let observed :=
        (JuliaLean.base.multidimensional.Models2Group3.regionContains
          (observeRegionMembershipOps ops) index fields).run (initial, [])
      (observed.map fun (result, (state, _)) => (result, state)) =
        (JuliaLean.base.multidimensional.Models2Group3.regionContains ops index fields).run initial ∧
      match observed with
      | none => True
      | some (result, (final, records)) =>
          RegionConversionStateThread initial final records ∧
          RegionBinaryObservationContract index fields
            ((index.zip fields).filter fun pair => match pair.2 with | .inl _ => false | .inr _ => true)
            (records.map fun record => record.2.2) result

abbrev RegionPredicateNative := Models1Group5.RangeDependencies.OrdinalRange64

def nativeRegionAllOps : RegionAllOps (RegionPredicateM Empty Unit) Unit Empty Empty where
  otherType := fun impossible => nomatch impossible
  identity := fun impossible => nomatch impossible
  ismissing := fun impossible => nomatch impossible
  otherAll := fun impossible => nomatch impossible

def nativeRegionEqualityOps : RegionEqualityOps (RegionPredicateM Empty Unit) Empty Unit Empty Empty where
  customEqual := fun left right => match left, right with
    | .inl a, .inl b => do return .bool (← regionConversionLift (Models1Group5.rangeEqual64 a b))
    | .inr impossible, _ => nomatch impossible
    | _, .inr impossible => nomatch impossible
  applyIterateOther := fun _ impossible => nomatch impossible
  allOps := nativeRegionAllOps

def nativeRegionMembershipOps : RegionMembershipOps (RegionPredicateM Empty Unit) Empty Unit Empty Empty where
  customContains := fun _ impossible => nomatch impossible
  applyIterateOther := fun _ impossible => nomatch impossible
  allOps := nativeRegionAllOps

/-- Independent sequence equality on unbounded mathematical coordinates.
The spec-only cardinality counts full-width lazy ranges without computing a
machine Int length; ordering is preserved, including negative steps. -/
def RegionNativeSequenceEqual (left right : RegionPredicateNative) : Prop :=
  Models1Group5.RangeDependencies.rangeCardinality left =
    Models1Group5.RangeDependencies.rangeCardinality right ∧
  ∀ k : Nat, k < Models1Group5.RangeDependencies.rangeCardinality left →
    (Models1Group5.RangeDependencies.rangeFirst left).val +
        (k : Int) * (Models1Group5.RangeDependencies.rangeStep left).val =
      (Models1Group5.RangeDependencies.rangeFirst right).val +
        (k : Int) * (Models1Group5.RangeDependencies.rangeStep right).val

/-- OneTo's documented installed equality specialization observes its stop
exactly, including unchecked negative stops. Every other built-in pair has
ordinary ordered sequence equality. -/
def RegionNativeEqualPromise (left right : RegionPredicateNative) : Prop :=
  match left, right with
  | .oneTo a, .oneTo b => a.stop.val = b.stop.val
  | _, _ => RegionNativeSequenceEqual left right

/-- Native equal-rank equality returns a Bool and agrees pointwise with
ordered range sequences and the OneTo stop specialization. The sole range
premise is the installed constructor invariant; cardinalities may be 2^64,
empty ranges and all signed extrema are included. Source: base/multidimensional.jl:382-383;
base/range.jl:289-303,1151-1167. -/
def RegionEqualityNativeCorrect : Prop :=
  ∀ (left right : List RegionPredicateNative),
    left.length = right.length → (left.length : Int) ≤ IntTy.max .i64 →
    (∀ range ∈ left, Models1Group5.RangeDependencies.RangeConstructible range) →
    (∀ range ∈ right, Models1Group5.RangeDependencies.RangeConstructible range) →
    match (JuliaLean.base.multidimensional.Models2Group3.regionEqual nativeRegionEqualityOps
        (left.map Sum.inl) (right.map Sum.inl)).run () with
    | some (.ok (.bool answer), ()) =>
        answer = true ↔ RegionForall2 RegionNativeEqualPromise left right
    | _ => False

/-- Independent mathematical coordinate membership, without native range
membership, remainder, or min/max models as an oracle. -/
def RegionNativePointMember (coordinate : I64) (range : RegionPredicateNative) : Prop :=
  ∃ k : Nat, k < Models1Group5.RangeDependencies.rangeCardinality range ∧
    coordinate.val = (Models1Group5.RangeDependencies.rangeFirst range).val +
      (k : Int) * (Models1Group5.RangeDependencies.rangeStep range).val

/-- Native membership is coordinatewise mathematical progression membership
on every constructible range, including full-width cardinalities and signed
extrema. No positivity, small-cardinality, or no-overflow premise is added.
This remains an unproved public contract candidate. Source: base/multidimensional.jl:506;
base/range.jl:289-303,1489-1494; doc/src/manual/arrays.md:943-961. -/
def RegionMembershipNativeCorrect : Prop :=
  ∀ (index : CI) (fields : List RegionPredicateNative),
    index.length = fields.length → (index.length : Int) ≤ IntTy.max .i64 →
    (∀ range ∈ fields, Models1Group5.RangeDependencies.RangeConstructible range) →
    match (JuliaLean.base.multidimensional.Models2Group3.regionContains nativeRegionMembershipOps
        index (fields.map Sum.inl)).run () with
    | some (.ok (.bool answer), ()) =>
        answer = true ↔ RegionForall2 RegionNativePointMember index fields
    | _ => False

/-- A selected one-argument all method on an Other singleton returns that
actual value. Native singleton Bool/Missing behavior remains closed. -/
def singletonRegionAllOps {E S O T : Type} : RegionAllOps (RegionPredicateM E S) Unit O T where
  otherType := fun _ => ()
  identity := fun value => pure (.other value)
  ismissing := fun _ => pure (.bool false)
  selectedOne := fun values => match values with
    | [value] => some (pure value)
    | _ => none
  otherAll := fun _ => pure (.bool true)

def probingRegionEqualityOps {E S C O T : Type} (probeLeft probeRight : C)
    (reply : RegionConversionField C → RegionConversionField C → S →
      Option (Except (RegionPredicateException E) (RegionTruth O) × S)) :
    RegionEqualityOps (RegionPredicateM E S) C Unit O T where
  customEqual := fun left right => ExceptT.mk (reply left right)
  selectedMap := fun f _ _ => some do
    let result ← f (.inr probeLeft) (.inr probeRight)
    return .inl [result]
  applyIterateOther := fun _ _ => pure []
  allOps := singletonRegionAllOps

def probingRegionMembershipOps {E S C O T : Type} (probeIndex : I64) (probeRange : C)
    (reply : I64 → C → S → Option (Except (RegionPredicateException E) (RegionTruth O) × S)) :
    RegionMembershipOps (RegionPredicateM E S) C Unit O T where
  customContains := fun index range => ExceptT.mk (reply index range)
  selectedMap := fun f _ _ => some do
    let result ← f probeIndex (.inr probeRange)
    return .inl [result]
  applyIterateOther := fun _ _ => pure []
  allOps := singletonRegionAllOps

/-- The selected map receives the actual == or in function, can invoke it
on arbitrary probe arguments absent from the input, and retains every raw
