  cases h : JuliaLean.Proofs.base.multidimensional.Models1Group6.MaskAxesProtocol.observe
      (runtime.axes reference) initial with
  | mk result final =>
    cases result with
    | error error =>
      simp only [JuliaLean.Proofs.base.multidimensional.Models1Group6.MaskAxesProtocol.observe,
        recordAction, pr_preserve, ExceptT.run, ExceptT.mk,
        Bind.bind, ExceptT.bind, ExceptT.bindCont, StateT.bind, Pure.pure,
        ExceptT.pure, StateT.pure] at h ⊢
      rw [h]
      exact ⟨rfl, rfl⟩
    | ok value =>
      cases value with
      | other value =>
        simp only [JuliaLean.Proofs.base.multidimensional.Models1Group6.MaskAxesProtocol.observe,
          recordAction, pr_preserve, ExceptT.run, ExceptT.mk,
          Bind.bind, ExceptT.bind, ExceptT.bindCont, StateT.bind, Pure.pure,
          ExceptT.pure, StateT.pure] at h ⊢
        rw [h]
        exact ⟨rfl, rfl⟩
      | tuple axes =>
        simp only [JuliaLean.Proofs.base.multidimensional.Models1Group6.MaskAxesProtocol.observe,
          recordAction, pr_preserve, ExceptT.run, ExceptT.mk,
          Bind.bind, ExceptT.bind, ExceptT.bindCont, StateT.bind, Pure.pure,
