def nativeUtilityIndexOps :
    RegionSimdIndexOps UtilityNativeM OrdinalRange64 I64 I64 I64 CI where
  firstindex := fun range => utilityLiftRange (regionRangeFirstindex range)
  add := fun inner first => pure (JuliaLean.base.int.add inner first)
  getindex := fun check range index =>
    utilityLiftRange (if check then rangeGetindex range index else regionRangeInboundsGet range index)
  construct := fun coordinate outer =>
    liftResult (constructMixed [.scalar (.integer .i64 coordinate), .cartesian outer])

def utilitySignedResidue (value : Int) : Int :=
  (value + (2 : Int) ^ 63) % ((2 : Int) ^ 64) - (2 : Int) ^ 63

/-- Independent native indexing admission. UnitRange tests the wrapped
candidate against stored endpoints, whereas StepRange uses the widened
candidate. The I1+1 subscript itself remains a signed machine integer. -/
def UtilityNativeIndexAdmitted (range : OrdinalRange64) (inner : I64) : Prop :=
  let position := utilitySignedResidue (inner.val + 1)
  match range with
  | .oneTo value => 0 < position ∧ position ≤ value.stop.val
  | .unit value =>
      let candidate := utilitySignedResidue (value.start.val + inner.val)
      0 < position ∧ value.start.val ≤ candidate ∧ candidate ≤ value.stop.val
  | .stepped value =>
      let candidate := value.start.val + inner.val * value.step.val
      0 < position ∧
      (if 0 < value.step.val then candidate ≤ value.stop.val else value.stop.val ≤ candidate)

def NativeSimdIndexValue (range : OrdinalRange64) (outer : CI) (inner : I64)
    (result : RangeResult (Except Error CI)) : Prop :=
  ∃ coordinate : I64, result = .ok (.ok (coordinate :: outer)) ∧
    (coordinate.val - (rangeFirst range).val - inner.val * (rangeStep range).val) %
      ((2 : Int) ^ 64) = 0

/-- Native SIMD indexing preserves all outer coordinates and uses modular
first+I1*step for the new leading coordinate. Checked failures are exactly
the native range's actual admission failure; unchecked indexing preserves
the installed arithmetic without inventing a bounds test. The concrete
constructor reuses the installed native mixed CartesianIndex closure.
Source: base/multidimensional.jl:519-520; base/range.jl:952-985. -/
def NativeSimdIndexCorrect : Prop :=
  ∀ (checkBounds : Bool) (head : OrdinalRange64) (tail : Region64)
    (outer : CI) (inner : I64),
    TupleArity (head :: tail) → TupleArity outer → RangeConstructible head →
    let result := (simdIndexGeneric nativeUtilityIndexOps checkBounds head tail outer inner).run
    match checkBounds with
    | false => NativeSimdIndexValue head outer inner result
    | true =>
        (UtilityNativeIndexAdmitted head inner → NativeSimdIndexValue head outer inner result) ∧
        (¬UtilityNativeIndexAdmitted head inner → result = .error (.jl .boundsError))

