/-- Reached calls of actual tuple mapping; selected maps are atomic calls
whose internal use of their function retains the original state. -/
inductive MapQueryEvent (E R A N : Type) where
  | element (range : R) (reply : AccessResult E A)
  | selected (ranges : List R) (reply : AccessResult E (Sum (List A) N))
  | splat (head : A) (tail : N) (reply : AccessResult E (List A))

def observeMapQueryOps {S E R A N : Type}
    (ops : TupleMapOps (AccessEffects S E) R A N) :
    TupleMapOps (AccessEffects (S × List (S × S × MapQueryEvent E R A N)) E) R A N where
  element := fun range => observeAccessAction (ops.element range) (.element range)
  selected := fun _ ranges => (ops.selected ops.element ranges).map fun action =>
    observeAccessAction action (.selected ranges)
  applyIterateOther := fun head tail =>
    observeAccessAction (ops.applyIterateOther head tail) (.splat head tail)

/-- Search immutable dispatch metadata at the source's possible tail arities;
no callee or map implementation is executed. -/
def mapQuerySelectedDepth {S E R A N : Type}
    (ops : TupleMapOps (AccessEffects S E) R A N) (ranges : List R) : Option Nat :=
  if ranges.isEmpty then none else
    let lastDepth := if ranges.length < 32 then ranges.length - 3 else 0
    (List.range (lastDepth + 1)).find? fun position =>
      (ops.selected ops.element (ranges.drop position)).isSome

def mapQueryElements {E R A N : Type} (events : List (MapQueryEvent E R A N)) :
    List (R × AccessResult E A) :=
  events.filterMap fun event => match event with
    | .element range reply => some (range, reply)
    | _ => none

def mapQueryMaps {E R A N : Type} (events : List (MapQueryEvent E R A N)) :
    List (List R × AccessResult E (Sum (List A) N)) :=
  events.filterMap fun event => match event with
    | .selected ranges reply => some (ranges, reply)
    | _ => none

def mapQuerySplats {E R A N : Type} (events : List (MapQueryEvent E R A N)) :
    List (A × N × AccessResult E (List A)) :=
  events.filterMap fun event => match event with
    | .splat head tail reply => some (head, tail, reply)
    | _ => none

def mapQueryError {E R A N : Type} : MapQueryEvent E R A N → Option (Sum Error E)
  | .element _ (.error error) => some error
  | .selected _ (.error error) => some error
  | .splat _ _ (.error error) => some error
  | _ => none

/-- Extract actual successful replies without calling any model. -/
def mapQueryReturned {E R A : Type} (calls : List (R × AccessResult E A)) : Option (List A) :=
  calls.mapM fun call => match call.2 with
    | .ok value => some value
    | .error _ => none

/-- Ordered data-flow and exception invariant for axes. The output retains
actual axis replies positionally. Selected map results remain observable, and
a delegated non-tuple tail is splatted once with its actual preceding head. -/
def MapQueryTerminal {S E R A N : Type}
    (ops : TupleMapOps (AccessEffects S E) R A N) (ranges : List R)
    (initial final : S) (reply : AccessResult E (Sum (List A) N))
    (records : List (S × S × MapQueryEvent E R A N)) : Prop :=
  let events := records.map (fun record => record.2.2)
  let elements := mapQueryElements events
  let maps := mapQueryMaps events
  let splats := mapQuerySplats events
  let depth := mapQuerySelectedDepth ops ranges
  let initialPart := match depth with | none => ranges | some n => ranges.take n
  AccessStateThread initial final records ∧
  (elements.map Prod.fst).IsPrefix initialPart ∧ maps.length ≤ 1 ∧ splats.length ≤ 1 ∧
  events = (elements.map fun call => .element call.1 call.2) ++
    (maps.map fun call => .selected call.1 call.2) ++
    (splats.map fun call => .splat call.1 call.2.1 call.2.2) ∧
  (∀ input result, maps = [(input, result)] →
    ∃ n, depth = some n ∧ input = ranges.drop n ∧ elements.map Prod.fst = initialPart) ∧
  (∀ head tail result, splats = [(head, tail, result)] →
    ∃ n input values,
      depth = some n ∧ 0 < n ∧ maps = [(input, .ok (.inr tail))] ∧
      mapQueryReturned elements = some values ∧ values.getLast? = some head) ∧
  (∀ event ∈ events, ∀ error, mapQueryError event = some error →
    events.getLast? = some event ∧ reply = .error error) ∧
  (match reply with
   | .error error => ∃ event, events.getLast? = some event ∧ mapQueryError event = some error
   | .ok returned =>
       elements.map Prod.fst = initialPart ∧
       (∀ event ∈ events, mapQueryError event = none) ∧
       ∃ values, mapQueryReturned elements = some values ∧
         match depth with
         | none => maps = [] ∧ splats = [] ∧ returned = .inl values
         | some n =>
             ∃ input mapped, maps = [(input, .ok mapped)] ∧
               if n = 0 then splats = [] ∧ returned = mapped else
                 match mapped with
                 | .inl fields => splats = [] ∧ returned = .inl (values ++ fields)
                 | .inr tail =>
                     ∃ head fields, values.getLast? = some head ∧
                       splats = [(head, tail, .ok fields)] ∧
                       returned = .inl (values.take (n - 1) ++ fields))

/-- Every constructible stored-range tuple, including offset axes, arbitrary
axis result types, custom maps, user exceptions, mutation and divergence.
No callee law is assumed. Source: base/multidimensional.jl:387;
doc/src/manual/interfaces.md:231. -/
def RegionAxesObservations : Prop :=
  ∀ (S E R A N : Type) (ops : TupleMapOps (AccessEffects S E) R A N)
    (ranges : List R) (initial : S), TupleArity ranges →
    match accessRun (regionAxesGeneric (observeMapQueryOps ops) ranges) (initial, []) with
    | none => True
    | some (reply, (final, records)) => MapQueryTerminal ops ranges initial final reply records

inductive OffsetQueryEvent (E R Other : Type) where
  | single (range : R) (reply : AccessResult E (Sum Bool Other))
  | multiple (ranges : List R) (reply : AccessResult E (Sum Bool Other))

def observeOffsetQueryOps {S E R Other : Type}
    (ops : RegionOffsetOps (AccessEffects S E) R Other) :
    RegionOffsetOps
      (AccessEffects (S × List (S × S × OffsetQueryEvent E R Other)) E) R Other where
  single := fun range => observeAccessAction (ops.single range) (.single range)
  selectedMultiple := fun ranges => (ops.selectedMultiple ranges).map fun action =>
    observeAccessAction action (.multiple ranges)

/-- Calls form one left-to-right prefix; prior scalar answers are false.
A selected variadic method receives precisely the remaining suffix and ends
traversal. Only a nonterminal scalar predicate requires a Bool result. -/
def OffsetQueryTerminal {S E R Other : Type} (ranges : List R) (initial final : S)
    (reply : AccessResult E (Sum Bool Other))
    (records : List (S × S × OffsetQueryEvent E R Other)) : Prop :=
  let events := records.map (fun record => record.2.2)
  AccessStateThread initial final records ∧ events.length ≤ ranges.length ∧
  (ranges = [] → events = [] ∧ reply = .ok (.inl false)) ∧
  (ranges ≠ [] → events ≠ []) ∧
  (∀ position event, events[position]? = some event →
    (match event with
     | .single range _ => ranges[position]? = some range
     | .multiple suffix _ =>
         suffix = ranges.drop position ∧ 2 ≤ suffix.length ∧
         events.getLast? = some event) ∧
    (position + 1 < events.length →
      ∃ range, event = .single range (.ok (.inl false)))) ∧
  (∀ event, events.getLast? = some event →
    match event with
    | .multiple _ result => reply = result
    | .single _ result =>
        match result with
        | .error error => reply = .error error
        | .ok (.inl true) => reply = .ok (.inl true)
        | .ok (.inl false) => events.length = ranges.length ∧ reply = .ok (.inl false)
        | .ok (.inr value) =>
            if events.length = ranges.length then reply = .ok (.inr value)
            else reply = .error (.inl .typeError))

/-- Full-domain short-circuit, argument, mutation and first-error invariant,
including arbitrary values from terminal operands. No custom range law is
assumed. Source: base/multidimensional.jl:388; base/abstractarray.jl:105-122. -/
def RegionOffsetObservations : Prop :=
  ∀ (S E R Other : Type) (ops : RegionOffsetOps (AccessEffects S E) R Other)
    (ranges : List R) (initial : S), TupleArity ranges →
    match accessRun (regionHasOffsetGeneric (observeOffsetQueryOps ops) ranges) (initial, []) with
    | none => True
    | some (reply, (final, records)) => OffsetQueryTerminal ranges initial final reply records

structure AssignedQueryEvent (E R Other : Type) where
  range : R
  index : I64
  reply : AccessResult E (Sum Bool Other)

def observeAssignedQueryOps {S E R Other : Type}
    (ops : RegionAssignedOps (AccessEffects S E) R Other) :
    RegionAssignedOps
      (AccessEffects (S × List (S × S × AssignedQueryEvent E R Other)) E) R Other where
  isassigned := fun range index =>
    observeAccessAction (ops.isassigned range index) (fun reply => ⟨range, index, reply⟩)

/-- Original range handles and indices are visited in order. The first false,
exception or non-Bool predicate stops all later calls. Rank zero returns true
without calling any range. -/
def AssignedQueryTerminal {S E R Other : Type} (arguments : RegionScalarArguments R)
    (initial final : S) (reply : AccessResult E Bool)
    (records : List (S × S × AssignedQueryEvent E R Other)) : Prop :=
  let events := records.map (fun record => record.2.2)
  AccessStateThread initial final records ∧
  (events.map (fun event => (event.range, event.index))).IsPrefix
    (arguments.ranges.zip arguments.indices) ∧
  (∀ position event, events[position]? = some event →
    position + 1 < events.length → event.reply = .ok (.inl true)) ∧
  (match reply with
   | .ok true => events.length = arguments.ranges.length ∧
       ∀ event ∈ events, event.reply = .ok (.inl true)
   | .ok false => ∃ event, events.getLast? = some event ∧ event.reply = .ok (.inl false)
   | .error error =>
       ∃ event, events.getLast? = some event ∧
         (event.reply = .error error ∨
           (error = .inl .typeError ∧ ∃ value, event.reply = .ok (.inr value))))

/-- Every same-rank constructible argument tuple, with arbitrary isassigned
callees, offsets, effects, exceptions, non-Bool returns and divergence. No
callee correctness assumption is supplied. Source:
base/multidimensional.jl:389-394; base/range.jl:946-950. -/
def RegionAssignedObservations : Prop :=
  ∀ (S E R Other : Type) (ops : RegionAssignedOps (AccessEffects S E) R Other)
    (arguments : RegionScalarArguments R) (initial : S),
    match accessRun (regionAssignedGeneric (observeAssignedQueryOps ops) arguments) (initial, []) with
    | none => True
    | some (reply, (final, records)) => AssignedQueryTerminal arguments initial final reply records

