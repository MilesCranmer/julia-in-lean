theorem rt_convert_self {t : IntTy} (value : JInt t) :
    JuliaLean.base.int.convert t value = .ok value := by
  simp only [JuliaLean.base.int.convert, JInt.convert, dif_pos value.property]

theorem rt_native_first (range : UnitRangeFields) :
    NativePrechecked.first range = .ok (FirstFieldValue range) := by
  induction range with
  | oneToBits type range => rfl
  | unitBits type range =>
    change (do
      let value ← JuliaLean.base.range.liftJl (JuliaLean.base.int.convert type range.start)
      pure (IntegerValue.bits type value)) = .ok (.bits type range.start)
    rw [rt_convert_self]
    rfl
  | oneToBool range => rfl
  | unitBool range => rfl
  | slice indices ih =>
    simpa only [NativePrechecked.first, JuliaLean.base.indices.first_Slice,
      FirstFieldValue] using ih
  | identity indices ih =>
    simpa only [NativePrechecked.first, JuliaLean.base.indices.first_IdentityUnitRange,
      FirstFieldValue] using ih

theorem Models1G6PrecheckedUnitFirstFields_proven :
    JuliaLean.Proofs.base.multidimensional.Models1Group6.NativePrechecked.UnitFirstFields := by
  intro range
  simp only [NativePrechecked.unitFirst, rt_native_first]
  rfl

theorem rt_native_unit_length_ok (range : NativePartitionUnitRange) :
    ∃ value, nativePartitionUnitLength range = .ok value := by
  unfold nativePartitionUnitLength JuliaLean.base.range.length_AbstractUnitRange
  change ∃ value, (do
    let start ← JuliaLean.base.range.liftJl (JuliaLean.base.int.convert .i64 range.start)
    let stop ← JuliaLean.base.range.liftJl (JuliaLean.base.int.convert .i64 range.stop)
    if true || JuliaLean.base.int.le start stop then
      pure (JuliaLean.base.int.add (int 1) (JuliaLean.base.int.sub stop start))
    else pure (JuliaLean.base.int.zero (int 0))) = .ok value
  rw [rt_convert_self, rt_convert_self]
  exact ⟨_, rfl⟩

theorem rt_identity_first (range : UnitRangeFields) :
    FirstFieldValue (identityRange range) = FirstFieldValue range := by
  cases range <;> rfl

theorem rt_linear_axis_first (axis : LinearAxis) :
    (do NativePrechecked.first (← axes1 axis)) = .ok (LinearAxisFirst axis) := by
  cases axis with
  | oneTo range => rfl
  | unitRange range =>
    obtain ⟨value, hvalue⟩ := rt_native_unit_length_ok range
    simp only [axes1, hvalue]
    rfl
  | slice indices =>
    by_cases h : isOneTo indices = true
    · simp only [axes1, h, ite_true]
      change NativePrechecked.first indices = .ok (FirstFieldValue indices)
      exact rt_native_first indices
    · simp only [axes1, h, ite_false]
      change NativePrechecked.first (identityRange indices) = .ok (FirstFieldValue indices)
      rw [rt_native_first, rt_identity_first]
  | identity indices =>
    by_cases h : isOneTo indices = true
    · simp only [axes1, h, ite_true]
      change NativePrechecked.first indices = .ok (FirstFieldValue indices)
      exact rt_native_first indices
    · simp only [axes1, h, ite_false, Bool.false_eq_true]
      change NativePrechecked.first (.identity indices) = .ok (FirstFieldValue indices)
      simpa only [FirstFieldValue] using rt_native_first (.identity indices)

theorem rt_linear_first_value (iterator : LinearFields) :
    linearFirstValue iterator = .ok (LinearFirstReference iterator) := by
  rcases iterator with ⟨axes, arity⟩
  cases axes with
  | nil => rfl
  | cons axis tail =>
    cases tail with
    | nil => exact rt_linear_axis_first axis
    | cons axis' tail => rfl

