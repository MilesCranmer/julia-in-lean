namespace Models1Group5.Batch9
open JuliaLean JuliaLean.base.multidimensional
open JuliaLean.base.multidimensional.Models1Group5
open JuliaLean.base.multidimensional.Models1Group5.RangeDependencies
open JuliaLean.Proofs.base.multidimensional.Models1Group5
open ConversionContracts

theorem ctor7_int_zero : (int 0).val = 0 := by decide

theorem ctor7_unit_step (r : JuliaLean.base.range.UnitRange I64) :
    rangeStep (.unit r) = int 1 := by rfl

theorem ctor7_oneTo_step (r : JuliaLean.base.range.OneTo I64) :
    rangeStep (.oneTo r) = int 1 := by rfl

theorem ctor7_empty_iff (a : OrdinalRange64) :
    rangeIsEmpty a = true ↔ rangeCardinality a = 0 := by
  unfold rangeCardinality
  cases h : rangeIsEmpty a <;> simp only [Bool.false_eq_true, ↓reduceIte,
    Nat.add_eq_zero_iff, Nat.one_ne_zero, and_false, iff_self]

theorem ctor7_stride_ne (a : OrdinalRange64) (ha : RangeConstructible a) :
    (rangeStep a).val ≠ 0 := by
  cases a with
  | oneTo r => rw [ctor7_oneTo_step, int_one]; decide
  | unit r => rw [ctor7_unit_step, int_one]; decide
  | stepped r => exact ha.1

theorem ctor7_empty_fields (a : OrdinalRange64) (ha : RangeConstructible a) :
    rangeIsEmpty a = decide ((0 < (rangeStep a).val ∧ (rangeLast a).val < (rangeFirst a).val) ∨
      ((rangeStep a).val < 0 ∧ (rangeFirst a).val < (rangeLast a).val)) := by
  cases a with
  | oneTo r =>
    rw [ctor7_oneTo_step, int_one]
    change JuliaLean.base.int.ltSame r.stop (int 1) = _
    rw [scalar7_ltSame, int_one]
    change decide (r.stop.val < 1) = decide ((0 < (1 : Int) ∧ r.stop.val < 1) ∨
      ((1 : Int) < 0 ∧ 1 < r.stop.val))
    simp only [Int.lt_irrefl, show (0 : Int) < 1 from by decide,
      show ¬((1 : Int) < 0) from by decide, true_and, false_and, or_false]
  | unit r =>
    rw [ctor7_unit_step, int_one]
    change JuliaLean.base.int.ltSame r.stop r.start = _
    rw [scalar7_ltSame]
    change decide (r.stop.val < r.start.val) = decide ((0 < (1 : Int) ∧ r.stop.val < r.start.val) ∨
      ((1 : Int) < 0 ∧ r.start.val < r.stop.val))
    simp only [show (0 : Int) < 1 from by decide,
      show ¬((1 : Int) < 0) from by decide, true_and, false_and, or_false]
  | stepped r =>
    have hn := ha.1
    change ((!JuliaLean.base.int.eqSame r.start r.stop) &&
      (JuliaLean.base.int.ltSame (int 0) r.step != JuliaLean.base.int.ltSame r.start r.stop)) = _
    rw [scalar7_eqSame, scalar7_ltSame, scalar7_ltSame, ctor7_int_zero]
    change ((!decide (r.start.val = r.stop.val)) &&
      (decide (0 < r.step.val) != decide (r.start.val < r.stop.val))) =
      decide ((0 < r.step.val ∧ r.stop.val < r.start.val) ∨
        (r.step.val < 0 ∧ r.start.val < r.stop.val))
    by_cases hp : 0 < r.step.val
    · by_cases he : r.start.val = r.stop.val
      · simp only [hp, he, decide_true, Bool.not_true, Bool.false_and, Int.lt_irrefl,
          and_false, or_self, decide_false]
      · by_cases hlt : r.start.val < r.stop.val
        · have hle : ¬r.stop.val < r.start.val := by omega
          have hs : ¬r.step.val < 0 := by omega
          simp only [he, hp, hlt, hle, hs, decide_false, decide_true, Bool.not_false,
            bne_self_eq_false, Bool.true_and, true_and, false_and, or_self]
        · have hle : r.stop.val < r.start.val := by omega
          simp only [he, hp, hlt, hle, decide_false, decide_true, Bool.not_false,
            Bool.true_and, true_and, false_and, and_false, or_false, true_or]
          decide
    · have hs : r.step.val < 0 := by omega
      by_cases he : r.start.val = r.stop.val
      · simp only [hp, he, decide_false, Bool.not_true, decide_true, Bool.false_and,
          Int.lt_irrefl, and_false, or_self]
      · by_cases hlt : r.start.val < r.stop.val
        · simp only [he, hp, hs, hlt, decide_false, decide_true, Bool.not_false,
            Bool.true_and, false_and, true_and, false_or]
          decide
        · simp only [he, hp, hs, hlt, decide_false, decide_true, Bool.not_false,
            Bool.true_and, false_and, true_and, false_or, bne_self_eq_false]

theorem ctor7_nonempty_flag (a : OrdinalRange64) (ha : 0 < rangeCardinality a) :
    rangeIsEmpty a = false := by
  have h := ctor7_empty_iff a
  cases he : rangeIsEmpty a with
  | false => rfl
  | true =>
    have hz := h.mp he
    omega

theorem ctor7_nonempty_last (a : OrdinalRange64) (ha : RangeConstructible a)
    (hn : 0 < rangeCardinality a) :
    (rangeLast a).val = (rangeFirst a).val +
      ((rangeCardinality a - 1 : Nat) : Int) * (rangeStep a).val := by
  have he := ctor7_nonempty_flag a hn
  have hd := ctor7_empty_fields a ha
  have hs := ctor7_stride_ne a ha
  rw [he] at hd
  have hdir : ¬ ((0 < (rangeStep a).val ∧ (rangeLast a).val < (rangeFirst a).val) ∨
      ((rangeStep a).val < 0 ∧ (rangeFirst a).val < (rangeLast a).val)) := by
    exact of_decide_eq_false hd.symm
  have hq : 0 ≤ ((rangeLast a).val - (rangeFirst a).val) / (rangeStep a).val := by
    by_cases hp : 0 < (rangeStep a).val
    · apply Int.ediv_nonneg <;> omega
    · apply Int.ediv_nonneg_of_nonpos_of_nonpos <;> omega
  have hm : ((rangeLast a).val - (rangeFirst a).val) % (rangeStep a).val = 0 := by
    cases a with
    | oneTo r => simp only [ctor7_oneTo_step, int_one, Int.emod_one]
    | unit r => simp only [ctor7_unit_step, int_one, Int.emod_one]
    | stepped r =>
      have hc := ha.2
      change (r.stop.val - r.start.val) % r.step.val = 0
      simpa only [he, Bool.false_eq_true, ↓reduceIte] using hc
  unfold rangeCardinality
  rw [he]
  simp only [Bool.false_eq_true, ↓reduceIte, Nat.add_sub_cancel, Int.toNat_of_nonneg hq]
  have hdiv := Int.ediv_mul_cancel_of_emod_eq_zero hm
  omega

theorem ctor7_card_one_iff (a : OrdinalRange64) (ha : RangeConstructible a)
    (hn : 0 < rangeCardinality a) :
    rangeCardinality a = 1 ↔ (rangeFirst a).val = (rangeLast a).val := by
  constructor
  · intro hc
    have hl := ctor7_nonempty_last a ha hn
    rw [hc] at hl
    simp only [Nat.sub_self, Int.natCast_zero, Int.zero_mul, Int.add_zero] at hl
    exact hl.symm
  · intro hl
    have he := ctor7_nonempty_flag a hn
    unfold rangeCardinality
    rw [he]
    simp only [Bool.false_eq_true, ↓reduceIte, hl, Int.sub_self, Int.zero_ediv,
      Int.toNat_zero, Nat.zero_add]

theorem ctor7_values_card {a b : OrdinalRange64} (h : SameAxisValues a b) :
    rangeCardinality a = rangeCardinality b := by
  have h1 := h (rangeCardinality a)
  have h2 := h (rangeCardinality b)
  unfold AxisValueAt at h1 h2
  by_cases hlt : rangeCardinality a < rangeCardinality b
  · simp only [Nat.lt_irrefl, hlt, ↓reduceIte] at h1
    contradiction
  · by_cases hgt : rangeCardinality b < rangeCardinality a
    · simp only [Nat.lt_irrefl, hgt, ↓reduceIte] at h2
      contradiction
    · omega

theorem ctor7_values_first {a b : OrdinalRange64} (h : SameAxisValues a b)
    (ha : 0 < rangeCardinality a) : (rangeFirst a).val = (rangeFirst b).val := by
  have hb : 0 < rangeCardinality b := by rw [← ctor7_values_card h]; exact ha
  have h0 := h 0
  simp only [AxisValueAt, ha, hb, ↓reduceIte, Int.natCast_zero,
    Int.zero_mul, Int.add_zero] at h0
  exact Option.some.inj h0

theorem ctor7_values_step {a b : OrdinalRange64} (h : SameAxisValues a b)
    (ha : 1 < rangeCardinality a) : (rangeStep a).val = (rangeStep b).val := by
  have hb : 1 < rangeCardinality b := by rw [← ctor7_values_card h]; exact ha
  have h1 := h 1
  have h0 := ctor7_values_first h (by omega)
  simp only [AxisValueAt, ha, hb, ↓reduceIte, Int.natCast_one,
    Int.one_mul] at h1
  have he := Option.some.inj h1
  omega

theorem ctor7_values_of_fields {a b : OrdinalRange64}
    (hc : rangeCardinality a = rangeCardinality b)
    (hf : 0 < rangeCardinality a → (rangeFirst a).val = (rangeFirst b).val)
    (hs : 1 < rangeCardinality a → (rangeStep a).val = (rangeStep b).val) :
    SameAxisValues a b := by
  intro k
  unfold AxisValueAt
  rw [← hc]
  by_cases hk : k < rangeCardinality a
  · simp only [hk, ↓reduceIte]
    by_cases hz : k = 0
    · subst k
      simp only [Int.natCast_zero, Int.zero_mul, Int.add_zero, hf hk]
    · rw [hf (by omega), hs (by omega)]
  · simp only [hk, ↓reduceIte]

theorem ctor7_values_last {a b : OrdinalRange64} (ha : RangeConstructible a)
    (hb : RangeConstructible b) (h : SameAxisValues a b) (hn : 0 < rangeCardinality a) :
    (rangeLast a).val = (rangeLast b).val := by
  have hc := ctor7_values_card h
  have hf := ctor7_values_first h hn
  have hbpos : 0 < rangeCardinality b := by omega
  have hla := ctor7_nonempty_last a ha hn
  have hlb := ctor7_nonempty_last b hb hbpos
  by_cases h1 : rangeCardinality a = 1
  · have h2 : rangeCardinality b = 1 := by omega
    rw [h1] at hla
    rw [h2] at hlb
    simp only [Nat.sub_self, Int.natCast_zero, Int.zero_mul, Int.add_zero] at hla hlb
    omega
  · have hs := ctor7_values_step h (by omega)
    rw [hc, hf, hs] at hla
    exact hla.trans hlb.symm

theorem ctor7_equal_fields_values {a b : OrdinalRange64}
    (ha : RangeConstructible a) (hb : RangeConstructible b)
    (hf : (rangeFirst a).val = (rangeFirst b).val)
    (hs : (rangeStep a).val = (rangeStep b).val)
    (hl : (rangeLast a).val = (rangeLast b).val) : SameAxisValues a b := by
  have he : rangeIsEmpty a = rangeIsEmpty b := by
    rw [ctor7_empty_fields a ha, ctor7_empty_fields b hb, hf, hs, hl]
  have hc : rangeCardinality a = rangeCardinality b := by
    unfold rangeCardinality
    rw [he, hf, hs, hl]
  exact ctor7_values_of_fields hc (fun _ => hf) (fun _ => hs)

theorem ctor7_empty_values {a b : OrdinalRange64}
    (ha : rangeIsEmpty a = true) (hb : rangeIsEmpty b = true) : SameAxisValues a b := by
  have hca := (ctor7_empty_iff a).mp ha
  have hcb := (ctor7_empty_iff b).mp hb
  apply ctor7_values_of_fields (hca.trans hcb.symm) <;> intro hh <;> omega

theorem ctor7_endpoints_card_one (a : OrdinalRange64) (ha : RangeConstructible a)
    (he : (rangeFirst a).val = (rangeLast a).val) : rangeCardinality a = 1 := by
  have hf : rangeIsEmpty a = false := by
    rw [ctor7_empty_fields a ha, he]
    simp only [Int.lt_irrefl, and_false, or_self, decide_false]
  unfold rangeCardinality
  rw [hf, he]
  simp only [Bool.false_eq_true, ↓reduceIte, Int.sub_self, Int.zero_ediv,
    Int.toNat_zero, Nat.zero_add]

def ctor7_genericBool (a b : OrdinalRange64) : Bool :=
  if rangeIsEmpty a then rangeIsEmpty b
  else if decide ((rangeFirst a).val = (rangeLast a).val) then
    decide ((rangeFirst b).val = (rangeLast b).val) &&
      decide ((rangeFirst a).val = (rangeFirst b).val)
  else decide ((rangeFirst a).val = (rangeFirst b).val) &&
    decide ((rangeStep a).val = (rangeStep b).val) &&
    decide ((rangeLast a).val = (rangeLast b).val)

theorem ctor7_generic_sound {a b : OrdinalRange64}
    (ha : RangeConstructible a) (hb : RangeConstructible b)
    (h : ctor7_genericBool a b = true) : SameAxisValues a b := by
  unfold ctor7_genericBool at h
  split at h
  · rename_i he
    exact ctor7_empty_values he h
  · split at h
    · rename_i he
      have hea : (rangeFirst a).val = (rangeLast a).val := of_decide_eq_true he
      have heb : (rangeFirst b).val = (rangeLast b).val :=
        of_decide_eq_true (Bool.and_eq_true_iff.mp h).1
      have hf : (rangeFirst a).val = (rangeFirst b).val :=
        of_decide_eq_true (Bool.and_eq_true_iff.mp h).2
      have hca := ctor7_endpoints_card_one a ha hea
      have hcb := ctor7_endpoints_card_one b hb heb
      apply ctor7_values_of_fields (hca.trans hcb.symm)
      · exact fun _ => hf
      · intro hh
        omega
    · have ht := Bool.and_eq_true_iff.mp h
      have hf := of_decide_eq_true (Bool.and_eq_true_iff.mp ht.1).1
      have hs := of_decide_eq_true (Bool.and_eq_true_iff.mp ht.1).2
      have hl := of_decide_eq_true ht.2
      exact ctor7_equal_fields_values ha hb hf hs hl

theorem ctor7_generic_complete {a b : OrdinalRange64}
    (ha : RangeConstructible a) (hb : RangeConstructible b)
    (hn : 0 < rangeCardinality a) (h : SameAxisValues a b) :
    ctor7_genericBool a b = true := by
  have he := ctor7_nonempty_flag a hn
  have hc := ctor7_values_card h
  have hf := ctor7_values_first h hn
  have hl := ctor7_values_last ha hb h hn
  unfold ctor7_genericBool
  rw [he]
  simp only [Bool.false_eq_true, ↓reduceIte]
  by_cases hs : (rangeFirst a).val = (rangeLast a).val
  · have hbend : (rangeFirst b).val = (rangeLast b).val := by omega
    rw [decide_eq_true hs]
    apply Bool.and_eq_true_iff.mpr
    exact ⟨decide_eq_true hbend, decide_eq_true hf⟩
  · have hcard : 1 < rangeCardinality a := by
      have hone := ctor7_card_one_iff a ha hn
      omega
    have hstep := ctor7_values_step h hcard
    rw [decide_eq_false hs]
    apply Bool.and_eq_true_iff.mpr
    exact ⟨Bool.and_eq_true_iff.mpr ⟨decide_eq_true hf, decide_eq_true hstep⟩,
      decide_eq_true hl⟩

theorem ctor7_values_symm {a b : OrdinalRange64} (h : SameAxisValues a b) :
    SameAxisValues b a := fun k => (h k).symm

theorem ctor7_generic_true_swap {a b : OrdinalRange64}
    (ha : RangeConstructible a) (hb : RangeConstructible b)
    (h : ctor7_genericBool a b = true) : ctor7_genericBool b a = true := by
  have hv := ctor7_generic_sound ha hb h
  have hc := ctor7_values_card hv
  by_cases hn : 0 < rangeCardinality b
  · exact ctor7_generic_complete hb ha hn (ctor7_values_symm hv)
  · have hb0 : rangeCardinality b = 0 := by omega
    have ha0 : rangeCardinality a = 0 := by omega
    have hea := (ctor7_empty_iff a).mpr ha0
    have heb := (ctor7_empty_iff b).mpr hb0
    simp only [ctor7_genericBool, heb, hea, ↓reduceIte]

theorem ctor7_generic_symm {a b : OrdinalRange64}
    (ha : RangeConstructible a) (hb : RangeConstructible b) :
    ctor7_genericBool a b = ctor7_genericBool b a := by
  apply Bool.eq_iff_iff.mpr
  exact ⟨ctor7_generic_true_swap ha hb, ctor7_generic_true_swap hb ha⟩

def ctor7_unitBool (a b : OrdinalRange64) : Bool :=
  (rangeIsEmpty a && rangeIsEmpty b) ||
    (decide ((rangeFirst a).val = (rangeFirst b).val) &&
      decide ((rangeLast a).val = (rangeLast b).val))

theorem ctor7_unit_sound {a b : OrdinalRange64}
    (ha : RangeConstructible a) (hb : RangeConstructible b)
    (hs : (rangeStep a).val = (rangeStep b).val)
    (h : ctor7_unitBool a b = true) : SameAxisValues a b := by
  rcases Bool.or_eq_true_iff.mp h with he | hf
  · exact ctor7_empty_values (Bool.and_eq_true_iff.mp he).1 (Bool.and_eq_true_iff.mp he).2
  · exact ctor7_equal_fields_values ha hb
      (of_decide_eq_true (Bool.and_eq_true_iff.mp hf).1) hs
      (of_decide_eq_true (Bool.and_eq_true_iff.mp hf).2)

theorem ctor7_unit_complete {a b : OrdinalRange64}
    (ha : RangeConstructible a) (hb : RangeConstructible b)
    (hn : 0 < rangeCardinality a) (h : SameAxisValues a b) :
    ctor7_unitBool a b = true := by
  have hf := ctor7_values_first h hn
  have hl := ctor7_values_last ha hb h hn
  apply Bool.or_eq_true_iff.mpr
  exact Or.inr (Bool.and_eq_true_iff.mpr ⟨decide_eq_true hf, decide_eq_true hl⟩)

theorem ctor7_unit_symm (a b : OrdinalRange64) :
    ctor7_unitBool a b = ctor7_unitBool b a := by
  apply Bool.eq_iff_iff.mpr
  simp only [ctor7_unitBool, Bool.or_eq_true_iff, Bool.and_eq_true_iff, decide_eq_true_eq]
  constructor
  · intro h
    rcases h with ⟨ha, hb⟩ | ⟨hf, hl⟩
    · exact Or.inl ⟨hb, ha⟩
    · exact Or.inr ⟨hf.symm, hl.symm⟩
  · intro h
    rcases h with ⟨ha, hb⟩ | ⟨hf, hl⟩
    · exact Or.inl ⟨hb, ha⟩
    · exact Or.inr ⟨hf.symm, hl.symm⟩

def ctor7_axisBool (a b : OrdinalRange64) : Bool :=
  match a, b with
  | .oneTo x, .oneTo y => decide (x.stop.val = y.stop.val)
  | .oneTo _, .unit _ | .unit _, .oneTo _ | .unit _, .unit _ => ctor7_unitBool a b
  | _, _ => ctor7_genericBool a b

theorem ctor7_axis_sound {a b : OrdinalRange64}
    (ha : RangeConstructible a) (hb : RangeConstructible b)
    (h : ctor7_axisBool a b = true) : SameAxisValues a b := by
  cases a with
  | oneTo x =>
    cases b with
    | oneTo y =>
      have he : x.stop = y.stop := Subtype.ext (of_decide_eq_true h)
      cases x
      cases y
      cases he
      exact fun _ => rfl
    | unit y => exact ctor7_unit_sound ha hb rfl h
    | stepped y => exact ctor7_generic_sound ha hb h
  | unit x =>
    cases b with
    | oneTo y => exact ctor7_unit_sound ha hb rfl h
    | unit y => exact ctor7_unit_sound ha hb rfl h
    | stepped y => exact ctor7_generic_sound ha hb h
  | stepped x =>
    cases b <;> exact ctor7_generic_sound ha hb h

theorem ctor7_axis_complete {a b : OrdinalRange64}
    (ha : RangeConstructible a) (hb : RangeConstructible b)
    (hn : 0 < rangeCardinality a) (h : SameAxisValues a b) :
    ctor7_axisBool a b = true := by
  cases a with
  | oneTo x =>
    cases b with
    | oneTo y =>
      have hl := ctor7_values_last ha hb h hn
      exact decide_eq_true hl
    | unit y => exact ctor7_unit_complete ha hb hn h
    | stepped y => exact ctor7_generic_complete ha hb hn h
  | unit x =>
    cases b with
    | oneTo y => exact ctor7_unit_complete ha hb hn h
    | unit y => exact ctor7_unit_complete ha hb hn h
    | stepped y => exact ctor7_generic_complete ha hb hn h
  | stepped x =>
    cases b <;> exact ctor7_generic_complete ha hb hn h

theorem ctor7_axis_symm {a b : OrdinalRange64}
    (ha : RangeConstructible a) (hb : RangeConstructible b) :
    ctor7_axisBool a b = ctor7_axisBool b a := by
  cases a with
  | oneTo x =>
    cases b with
    | oneTo y => simp only [ctor7_axisBool, eq_comm]
    | unit y => exact ctor7_unit_symm _ _
    | stepped y => exact ctor7_generic_symm ha hb
  | unit x =>
    cases b with
    | oneTo y => exact ctor7_unit_symm _ _
    | unit y => exact ctor7_unit_symm _ _
    | stepped y => exact ctor7_generic_symm ha hb
  | stepped x =>
    cases b <;> exact ctor7_generic_symm ha hb


theorem ctor7_generic_refl (a : OrdinalRange64) : ctor7_genericBool a a = true := by
  unfold ctor7_genericBool
  by_cases he : rangeIsEmpty a = true
  · simp only [he, ↓reduceIte]
  · simp only [he, ↓reduceIte]
    by_cases h : (rangeFirst a).val = (rangeLast a).val
    · simp only [h, decide_true, ↓reduceIte, Bool.true_and, Bool.false_eq_true]
    · simp only [h, decide_false, Bool.false_eq_true, ↓reduceIte, decide_true, Bool.true_and]

theorem ctor7_axis_refl (a : OrdinalRange64) : ctor7_axisBool a a = true := by
  cases a with
  | oneTo r => simp only [ctor7_axisBool, decide_true]
  | unit r => simp only [ctor7_axisBool, ctor7_unitBool, decide_true, Bool.true_and, Bool.or_true]
  | stepped r => exact ctor7_generic_refl _

theorem ctor7_rangeEqual_eq (a b : OrdinalRange64) :
    rangeEqual64 a b = .ok (ctor7_axisBool a b) := by
  cases a <;> cases b <;>
    simp only [rangeEqual64, JuliaLean.base.range.eq_OneTo_OneTo,
      JuliaLean.base.range.eq_AbstractUnitRange_AbstractUnitRange,
      JuliaLean.base.range.eq_T_T_AbstractRange,
      JuliaLean.base.range.eq_OrdinalRange_OrdinalRange,
      JuliaLean.base.range._has_length_one_OrdinalRange,
      JuliaLean.base.range.JFirst.first, JuliaLean.base.range.JLast.last,
      JuliaLean.base.range.JStep.step, JuliaLean.base.range.JIsempty.isempty,
      JuliaLean.base.range.JEq.eq, JuliaLean.base.range.JHasLengthOne.hasLengthOne,
      Bind.bind, Except.bind, Pure.pure, Except.pure,
      ctor7_axisBool, ctor7_unitBool, ctor7_genericBool, scalar7_eqSame]
  all_goals try rfl
  all_goals split <;> try rfl
  all_goals split <;> rfl

def ctor7_regionBool (a b : Region64) : Bool :=
  (a.zip b).all (fun pair => ctor7_axisBool pair.1 pair.2)

theorem ctor7_mapM_pairs (pairs : List (OrdinalRange64 × OrdinalRange64)) :
    pairs.mapM (fun pair => rangeEqual64 pair.1 pair.2) =
      .ok (pairs.map (fun pair => ctor7_axisBool pair.1 pair.2)) := by
  induction pairs with
  | nil => rfl
  | cons pair pairs ih =>
    simp only [List.mapM_cons, List.map_cons]
    rw [ctor7_rangeEqual_eq, ih]
    rfl

theorem ctor7_regionEqual_eq (a b : Region64) :
    regionEqual a b = .ok (ctor7_regionBool a b) := by
  unfold regionEqual
  rw [ctor7_mapM_pairs]
  change (Except.ok (((a.zip b).map (fun pair => ctor7_axisBool pair.1 pair.2)).all id) : RegionResult Bool) = _
  simp only [List.all_map, Function.comp_def, id_eq, ctor7_regionBool]

theorem ctor7_region_values_nil : SameRegionAxisValues [] [] := by
  refine ⟨rfl, ?_⟩
  intro k a b ha hb
  simp only [List.getElem?_nil] at ha
  cases ha

theorem ctor7_region_values_cons (a b : OrdinalRange64) (as bs : Region64) :
    SameRegionAxisValues (a :: as) (b :: bs) ↔
      SameAxisValues a b ∧ SameRegionAxisValues as bs := by
  constructor
  · intro h
    refine ⟨h.2 0 a b rfl rfl, ⟨Nat.succ.inj h.1, ?_⟩⟩
    intro k x y hx hy
    exact h.2 (k + 1) x y hx hy
  · intro h
    refine ⟨congrArg Nat.succ h.2.1, ?_⟩
    intro k x y hx hy
    cases k with
    | zero =>
      change some a = some x at hx
      change some b = some y at hy
      cases Option.some.inj hx
      cases Option.some.inj hy
      exact h.1
    | succ k => exact h.2.2 k x y hx hy

theorem ctor7_regionBool_refl (a : Region64) : ctor7_regionBool a a = true := by
  induction a with
  | nil => rfl
  | cons a as ih =>
    change (ctor7_axisBool a a && ctor7_regionBool as as) = true
    rw [ctor7_axis_refl, ih]
    rfl

theorem ctor7_regionBool_symm (a b : Region64)
    (ha : ∀ axis ∈ a, RangeConstructible axis)
    (hb : ∀ axis ∈ b, RangeConstructible axis) (hlen : a.length = b.length) :
    ctor7_regionBool a b = ctor7_regionBool b a := by
  induction a generalizing b with
  | nil =>
    cases b with
    | nil => rfl
    | cons b bs => simp only [List.length_nil, List.length_cons] at hlen; omega
  | cons a as ih =>
    cases b with
    | nil => simp only [List.length_nil, List.length_cons] at hlen; omega
    | cons b bs =>
      change (ctor7_axisBool a b && ctor7_regionBool as bs) =
        (ctor7_axisBool b a && ctor7_regionBool bs as)
      rw [ctor7_axis_symm (ha a List.mem_cons_self) (hb b List.mem_cons_self)]
      rw [ih bs (fun x hx => ha x (List.mem_cons_of_mem a hx))
        (fun x hx => hb x (List.mem_cons_of_mem b hx)) (Nat.succ.inj hlen)]

theorem ctor7_regionBool_sound (a b : Region64)
    (ha : ∀ axis ∈ a, RangeConstructible axis)
    (hb : ∀ axis ∈ b, RangeConstructible axis) (hlen : a.length = b.length)
    (h : ctor7_regionBool a b = true) : SameRegionAxisValues a b := by
  induction a generalizing b with
  | nil =>
    cases b with
    | nil => exact ctor7_region_values_nil
    | cons b bs => simp only [List.length_nil, List.length_cons] at hlen; omega
  | cons a as ih =>
    cases b with
    | nil => simp only [List.length_nil, List.length_cons] at hlen; omega
    | cons b bs =>
      change (ctor7_axisBool a b && ctor7_regionBool as bs) = true at h
      have hh := Bool.and_eq_true_iff.mp h
      apply (ctor7_region_values_cons a b as bs).mpr
      exact ⟨ctor7_axis_sound (ha a List.mem_cons_self) (hb b List.mem_cons_self) hh.1,
        ih bs (fun x hx => ha x (List.mem_cons_of_mem a hx))
          (fun x hx => hb x (List.mem_cons_of_mem b hx)) (Nat.succ.inj hlen) hh.2⟩

theorem ctor7_regionBool_complete (a b : Region64)
    (ha : ∀ axis ∈ a, RangeConstructible axis)
    (hb : ∀ axis ∈ b, RangeConstructible axis)
    (hn : ∀ axis ∈ a, 0 < rangeCardinality axis)
    (h : SameRegionAxisValues a b) : ctor7_regionBool a b = true := by
  induction a generalizing b with
  | nil =>
    cases b with
    | nil => rfl
    | cons b bs => have hl := h.1; simp only [List.length_nil, List.length_cons] at hl; omega
  | cons a as ih =>
    cases b with
    | nil => have hl := h.1; simp only [List.length_nil, List.length_cons] at hl; omega
    | cons b bs =>
      have hv := (ctor7_region_values_cons a b as bs).mp h
      change (ctor7_axisBool a b && ctor7_regionBool as bs) = true
      apply Bool.and_eq_true_iff.mpr
      exact ⟨ctor7_axis_complete (ha a List.mem_cons_self) (hb b List.mem_cons_self)
        (hn a List.mem_cons_self) hv.1,
        ih bs (fun x hx => ha x (List.mem_cons_of_mem a hx))
          (fun x hx => hb x (List.mem_cons_of_mem b hx))
          (fun x hx => hn x (List.mem_cons_of_mem a hx)) hv.2⟩

theorem Models1G5RegionEqualityGeometry_proven :
    JuliaLean.Proofs.base.multidimensional.Models1Group5.ConversionContracts.RegionEqualityGeometry := by
  constructor
  · intro a ha
    rw [ctor7_regionEqual_eq, ctor7_regionBool_refl]
  · intro a b ha hb hlen
    refine ⟨ctor7_regionBool a b, ctor7_regionEqual_eq a b, ?_, ?_, ?_⟩
    · rw [ctor7_regionEqual_eq, ← ctor7_regionBool_symm a b ha.2 hb.2 hlen]
    · exact ctor7_regionBool_sound a b ha.2 hb.2 hlen
    · intro hna hnb
      exact ⟨ctor7_regionBool_sound a b ha.2 hb.2 hlen,
        ctor7_regionBool_complete a b ha.2 hb.2 hna⟩

end Models1Group5.Batch9


