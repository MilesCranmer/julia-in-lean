inductive LogicalForwardEvent (E Left Mask Value : Type) where
  | terminal (left : Left) (mask : Mask) (result : Except E Value)
  | selected (left : Left) (receiver : BooleanMaskRef Mask) (result : Except E Value)

/-- Static immutable logical ancestry excludes the terminal non-LogicalIndex
array. It does not run the forwarding algorithm or any selected action. -/
def logicalForwardAncestry {Mask : Type} : BooleanMaskRef Mask → List (BooleanMaskRef Mask)
  | .terminal _ => []
  | receiver@(.logical _ child _) => receiver :: logicalForwardAncestry child

def logicalForwardTerminal {Mask : Type} : BooleanMaskRef Mask → Mask
  | .terminal mask => mask
  | .logical _ child _ => logicalForwardTerminal child

def observeLogicalForwardOps {E S Left Mask Value : Type}
    (ops : LogicalForwardOps (DimensionObservationM E S) Left Mask Value) :
    LogicalForwardOps
      (DimensionObservationM E (S × List (S × S × LogicalForwardEvent E Left Mask Value)))
      Left Mask Value where
  terminal := fun left mask => observeDimensionAction (ops.terminal left mask) (.terminal left mask)
  selected := fun left receiver => (ops.selected left receiver).map fun action =>
    observeDimensionAction action (.selected left receiver)

/-- Exactly one actual leaf is reached: the earliest selected method in the
immutable logical ancestry, or the terminal mask. Original left-hand identity,
raw returns/throws and the complete state transition are retained. -/
def LogicalForwardObservation {E S Left Mask Value : Type}
    (ops : LogicalForwardOps (DimensionObservationM E S) Left Mask Value)
    (left : Left) (mask : BooleanMaskRef Mask) (initial : S)
    (outcome : Option (Except E Value ×
      (S × List (S × S × LogicalForwardEvent E Left Mask Value)))) : Prop :=
  match outcome with
  | none => True
  | some (result, (final, records)) =>
      match ((logicalForwardAncestry mask).filter fun receiver =>
          (ops.selected left receiver).isSome).head? with
      | some receiver => records = [(initial, final, .selected left receiver result)]
      | none => records = [(initial, final, .terminal left (logicalForwardTerminal mask) result)]

/-- Full finite LogicalIndex nesting, arbitrary cached native counts,
terminal mask references, left-hand subtypes, selected methods, exceptions,
mutations and raw result types. Only the outer cache can be replaced without
changing behavior: selected nested methods may inspect their own caches.
This covers the real recursive helper through both assigned public wrappers.
Source: base/multidimensional.jl:834-837,900,902. -/
def LogicalForwardObservations : Prop :=
  ∀ (E S Left Mask Value : Type)
    (ops : LogicalForwardOps (DimensionObservationM E S) Left Mask Value)
    (left : Left) (logical : LogicalIndex (BooleanMaskRef Mask))
    (replacement : I64) (state : S),
    let observed := observeLogicalForwardOps ops
    let replacementLogical : LogicalIndex (BooleanMaskRef Mask) := ⟨logical.mask, replacement⟩
    let bounds := (checkboundsLogicalOpen observed left logical).run (state, [])
    let index := (checkindexLogicalAxisOpen observed left logical).run (state, [])
    LogicalForwardObservation ops left logical.mask state bounds ∧
    LogicalForwardObservation ops left logical.mask state index ∧
    bounds = (checkboundsLogicalOpen observed left replacementLogical).run (state, []) ∧
    index = (checkindexLogicalAxisOpen observed left replacementLogical).run (state, [])

