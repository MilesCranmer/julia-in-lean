        match records.map (fun record => record.2.2) with
        | [first] => first.value = value ∧ first.literal.val = 0 ∧
            match first.reply with
            | .error error => reply = .error error
            | .ok (.inl true) => reply = .ok true
            | .ok (.inl false) => False
            | .ok (.inr _) => reply = .error (.inl .typeError)
        | [first, second] =>
            first.value = value ∧ first.literal.val = 0 ∧ first.reply = .ok (.inl false) ∧
            second.value = value ∧ second.literal.val = 1 ∧
            match second.reply with
            | .error error => reply = .error error
            | .ok (.inl true) => reply = .ok true
            | .ok (.inl false) => reply = .error (.inl (.inexactError "try_bool_conversion"))
            | .ok (.inr _) => reply = .error (.inl .typeError)
        | _ => False

