abbrev PartitionView := JuliaLean.base.multidimensional.Models1Group6.PartitionView
abbrev PartitionRangeFields :=
  JuliaLean.base.multidimensional.Models1Group6.PartitionRangeFields

/-- Independent normal form for column-major increment over stored signed-Int
range fields. The pivot is the first coordinate not at its final value; when
all are final, the last coordinate still advances, because `inc` intentionally
discards `__inc`'s validity flag. Earlier coordinates reset to their stored first
values and later coordinates are unchanged. This uses a zipped prefix and one
list splice, not the recursive increment model.

For unequal ranks, a differing coordinate can return only while both remaining
tuples have at least two entries. Otherwise source dispatch reaches an absent
`__inc` overload. This describes the complete native-field input domain,
including unusual caller-supplied states, empty ranges, overflow and rank
mismatch; no constructibility or successful-execution premise is imposed. -/
def PartitionCarryReference (state : CI) (ranges : List PartitionRangeFields) :
    Result CI :=
  if state.isEmpty && ranges.isEmpty then .ok []
  else
    let pairs := state.zip ranges
    let equalPrefix := (pairs.takeWhile (fun pair => pair.1 == pair.2.stop)).length
    let sameRank := state.length == ranges.length
    let pivot := if sameRank then min equalPrefix (state.length - 1) else equalPrefix
    if sameRank = false ∧ min state.length ranges.length ≤ pivot + 1 then
      .error (.methodError "__inc")
    else
      match pairs[pivot]? with
      | none => .error (.methodError "__inc")
      | some (coordinate, range) =>
          .ok ((ranges.take pivot).map (·.first) ++
            [JInt.wrap .i64 (coordinate.val + range.step.val)] ++
            state.drop (pivot + 1))

/-- At the explicitly declared array-length/native-range field boundary, the
assigned iterator preserves every length error, terminates before inspecting
coordinates when its counter reaches the observed length, and otherwise
performs the independent column-major carry transformation. Returned value and
state coordinates agree and the counter increments modulo 2^64.

This is a full-domain protocol invariant of the partial closure, not a claim
that generic `length` or arbitrary custom-range methods have been implemented.
It quantifies over all field observations, negative and wrapped lengths,
Int64 counters and coordinate tuples. Source: base/multidimensional.jl:664-668,
459-483; Cartesian iteration order documented at 216-225. -/
def PartitionIterationCorrect : Prop :=
  ∀ (p : PartitionView) (state : CI) (n : I64),
    JuliaLean.base.multidimensional.Models1Group6.iteratePartition p state n =
      match p.lengthObservation with
      | .error error => .error error
      | .ok length =>
          if length.val ≤ n.val then .ok none
          else
            (PartitionCarryReference state p.parentIndices).map (fun next =>
              some (next, (next, JInt.wrap .i64 (n.val + 1))))


abbrev NativePartitionView :=
  JuliaLean.base.multidimensional.Models1Group6.NativePartitionView
abbrev NativePartitionUnitRange :=
  JuliaLean.base.multidimensional.Models1Group6.NativePartitionUnitRange

/-- Exact stored-field invariant of a native UnitRange{Int} constructor,
`base/range.jl:425-441`. A nonempty range retains its endpoints; an empty one
has stop = start-1. The empty case cannot start at typemin(Int), since no Int
input stop lies below that start. This asserts only range normalization, not
that arbitrary projected parent fields construct a Julia view or reshape. -/
def NativeUnitRangeNormalized (r : NativePartitionUnitRange) : Prop :=
  r.start.val ≤ r.stop.val ∨
    (IntTy.min .i64 < r.start.val ∧ r.stop.val = r.start.val - 1)

/-- Mathematical endpoint count reduced once modulo the native Int width.
This is an independent cardinality/address expression; it does not call the
model's length, size, axes, OneTo, product or native range helpers. Empty
normalized ranges have count zero; huge nonempty ranges may wrap negative or
to zero exactly as Julia's signed length method permits. -/
def NativePartitionLengthValue (view : NativePartitionView) : Int :=
  wrapInt .i64 (view.viewIndex.stop.val - view.viewIndex.start.val + 1)

/-- The closed native view-length chain returns the mathematical endpoint
count modulo Int64, without clamping a negative OneTo stop. The only range
precondition is its actual constructor normalization; no nonnegative-length,
no-overflow or parent-size assumption is made.
Source: base/multidimensional.jl:664-668; subarray.jl:70,525-532;
range.jl:706,794-804,817; abstractarray.jl:100-103; essentials.jl:13. -/
def NativePartitionLengthCorrect : Prop :=
  ∀ view : NativePartitionView,
    NativeUnitRangeNormalized view.viewIndex →
    JuliaLean.base.multidimensional.Models1Group6.nativePartitionLength view =
      .ok (JInt.wrap .i64 (view.viewIndex.stop.val - view.viewIndex.start.val + 1))

theorem nativePartitionUnitLength_eq (range : Models1Group6.NativePartitionUnitRange) :
    JuliaLean.base.multidimensional.Models1Group6.nativePartitionUnitLength range =
      .ok (JuliaLean.base.int.add (int 1) (JuliaLean.base.int.sub range.stop range.start)) := by
  have hconv (x : I64) : JuliaLean.base.int.convert .i64 x = .ok x := by
    simp only [JuliaLean.base.int.convert, JInt.convert, x.property, and_self, ↓reduceDIte]
  unfold JuliaLean.base.multidimensional.Models1Group6.nativePartitionUnitLength
    JuliaLean.base.range.length_AbstractUnitRange
  change (do
    let start ← JuliaLean.base.range.liftJl (JuliaLean.base.int.convert .i64 range.start)
    let stop ← JuliaLean.base.range.liftJl (JuliaLean.base.int.convert .i64 range.stop)
    if true || JuliaLean.base.int.le start stop then
      pure (JuliaLean.base.int.add (int 1) (JuliaLean.base.int.sub stop start))
    else pure (JuliaLean.base.int.zero (int 0))) = _
  rw [hconv, hconv]
  rfl

theorem nativePartitionLengthCorrect_proven :
    Models1Group6.NativePartitionLengthCorrect := by
  intro view _
  unfold JuliaLean.base.multidimensional.Models1Group6.nativePartitionLength
    JuliaLean.base.multidimensional.Models1Group6.nativePartitionSize
    JuliaLean.base.multidimensional.Models1Group6.nativePartitionAxes
    JuliaLean.base.multidimensional.Models1Group6.nativePartitionIndexAxes
    JuliaLean.base.multidimensional.Models1Group6.nativePartitionIndexSize
    JuliaLean.base.range.size_AbstractRange
    JuliaLean.base.range.JLength.length
