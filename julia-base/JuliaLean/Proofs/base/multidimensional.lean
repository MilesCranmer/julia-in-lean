/-- Embed the installed Array-heap action in the observation world. A closed
collection exception retains its exact existing error-family tag. The source
uses this lift only for the concrete rank-zero collection, whose valid layout
cannot fail after allocation; the inherited CollectM error representation has
no final heap on an error. All open calls use the outer exception/state
interface directly and retain every mutation before arbitrary throws. -/
local instance unitCollectObservedLift {Extra S Log : Type} :
    MonadLift CollectM
      (ConstructorObservationM (Sum CollectionFailure Extra) ((CollectionHeap × S) × Log)) where
  monadLift action := ExceptT.mk fun ((heap, state), log) =>
    match (action heap).run with
    | none => none
    | some (.error error) => some (.error (.inr (.inl error)), ((heap, state), log))
    | some (.ok (value, heap')) => some (.ok value, ((heap', state), log))

inductive UnitCollectEvent (Extra R Axis NotTuple Output : Type) where
  | axis (event : RegionEvent (Sum CollectionFailure Extra) R Axis NotTuple)
  | collect (axes : Sum (List Axis) NotTuple) (ranges : List R)
      (result : Except (Sum Error (Sum CollectionFailure Extra)) Output)

abbrev UnitCollectRecord (Extra S R Axis NotTuple Output : Type) :=
  (CollectionHeap × S) × (CollectionHeap × S) ×
    UnitCollectEvent Extra R Axis NotTuple Output

/-- Only the record tag changes; original state, effects, return and error
are preserved while the actual shared tuple traversal remains in the model. -/
def liftUnitCollectAxes {Extra S R Axis NotTuple Output A : Type}
    (action : ConstructorObservationM (Sum CollectionFailure Extra)
      ((CollectionHeap × S) ×
        List (RegionRecord (Sum CollectionFailure Extra) (CollectionHeap × S) R Axis NotTuple)) A) :
    ConstructorObservationM (Sum CollectionFailure Extra)
      ((CollectionHeap × S) × List (UnitCollectRecord Extra S R Axis NotTuple Output)) A :=
  ExceptT.mk fun (state, records) =>
    match action.run (state, []) with
    | none => none
    | some (result, (final, nested)) =>
        some (result, (final, records ++ nested.map fun record =>
          (record.1, record.2.1, UnitCollectEvent.axis record.2.2)))

def observeUnitCollectOps {Extra S R Axis NotTuple Output : Type}
    (ops : UnitRegionCollectOps
      (ConstructorObservationM (Sum CollectionFailure Extra) (CollectionHeap × S))
      R Axis NotTuple Output) :
    UnitRegionCollectOps
      (ConstructorObservationM (Sum CollectionFailure Extra)
        ((CollectionHeap × S) × List (UnitCollectRecord Extra S R Axis NotTuple Output)))
      R Axis NotTuple Output where
  axes :=
    let observed := observeRegionSizeOps ops.axes
    { element := fun range => liftUnitCollectAxes (observed.element range)
      selected := fun _ ranges =>
        (observed.selected observed.element ranges).map liftUnitCollectAxes
      applyIterateOther := fun head tail =>
        liftUnitCollectAxes (observed.applyIterateOther head tail) }
  collect := fun axes ranges =>
    observeConstructorAction (ops.collect axes ranges) (.collect axes ranges)

/-- The result is the exact final collector reply after a completed axes
map, or the actual failing axes operation with no collector call. This
trace relation uses the independent map prefix/suffix invariant and does
not rerun any selected method or tuple algorithm. -/
def UnitCollectNonemptyObservation {Extra S R Axis NotTuple Output : Type}
    (ranges : List R) (initial final : CollectionHeap × S)
    (result : Except (Sum Error (Sum CollectionFailure Extra)) (Sum CollectionArray Output))
    (records : List (UnitCollectRecord Extra S R Axis NotTuple Output)) : Prop :=
  (∃ (axes : Sum (List Axis) NotTuple)
      (middle : CollectionHeap × S)
      (nested : List (RegionRecord (Sum CollectionFailure Extra) (CollectionHeap × S) R Axis NotTuple))
      (reply : Except (Sum Error (Sum CollectionFailure Extra)) Output),
    records = (nested.map (fun record =>
      (record.1, record.2.1, UnitCollectEvent.axis record.2.2))) ++
      [(middle, final, .collect axes ranges reply)] ∧
    RegionSizeObservation ranges initial (some (.ok axes, (middle, nested))) ∧
    result = reply.map (Sum.inr : Output → Sum CollectionArray Output)) ∨
  (∃ (error : Sum Error (Sum CollectionFailure Extra))
      (nested : List (RegionRecord (Sum CollectionFailure Extra) (CollectionHeap × S) R Axis NotTuple)),
    records = nested.map (fun record =>
      (record.1, record.2.1, UnitCollectEvent.axis record.2.2)) ∧
    RegionSizeObservation ranges initial (some (.error error, (final, nested))) ∧
    result = .error error)

/-- Complete input domain: every machine-arity tuple of arbitrary
AbstractUnitRange{Int} subtypes, arbitrary axis and collection result types,
selected whole/tail maps, offset axes, all custom errors and shared mutations.
Only actual heap/tuple representation and zero-rank datatype layout
invariants are assumed. The concrete rank-zero branch specifies allocation
and contents directly; other branches retain exact dataflow and effects.
Source: base/multidimensional.jl:631-633; base/array.jl:788-797. -/
def UnitRegionCollectObservations : Prop :=
  ∀ (Extra S R Axis NotTuple Output : Type)
    (ops : UnitRegionCollectOps
      (ConstructorObservationM (Sum CollectionFailure Extra) (CollectionHeap × S))
      R Axis NotTuple Output)
    (layout : JuliaLean.base.array.MemoryLayout) (ranges : List R)
    (heap : CollectionHeap) (state : S),
    TupleArity ranges →
    (∀ slots ∈ heap, (slots.length : Int) ≤ IntTy.max .i64) →
    (ranges = [] → layout.size = 0 ∧ layout.isboxed = false ∧ layout.isunion = false) →
    match (collectUnitRegionGeneric (observeUnitCollectOps ops) layout ranges).run ((heap, state), []) with
    | none => ranges ≠ []
    | some (result, (final, records)) =>
        if ranges = [] then
          records = [] ∧ final.2 = state ∧
          ∃ array : CollectionArray,
            result = .ok (.inl array) ∧
            array.elementType = 0 ∧ array.dimensions = [] ∧ array.axes = [] ∧
            array.handle = heap.length ∧ final.1 = heap ++ [[some ([] : CI)]]
        else UnitCollectNonemptyObservation ranges (heap, state) final result records

