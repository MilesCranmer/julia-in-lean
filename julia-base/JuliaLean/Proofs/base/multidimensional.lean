  refine ⟨by simp only [List.length_cons, hlen], ?_⟩
  change ∃ pivot : Nat, pivot < (coordinate :: next :: tail).length ∧ _
  refine ⟨p + 1, by simp only [List.length_cons] at hp ⊢; omega, ?_, ?_, ?_⟩
  · intro k a c hk ha hc
