Source: base/multidimensional.jl:159-164,459-483. -/
def NextFromAxesCorrect : Prop :=
  ∀ (ranges : Region64) (index : CI), RegionDomain ranges → ranges.length = index.length →
    match nextFromAxes ranges index with
    | .ok result => NavigationGeometry true ranges index result
    | .error _ => False

/-- The prevind downstream closure satisfies complete borrow geometry, including empty ranges,
all extreme coordinates and explicit out-of-bounds states. The all-first endpoint borrow is
allowed to leave the rectangle, as documented for prevind. Source:
base/multidimensional.jl:165-170,586-607; base/tuple.jl:77-108. -/
def PreviousFromAxesCorrect : Prop :=
  ∀ (ranges : Region64) (index : CI), RegionDomain ranges → ranges.length = index.length →
    match previousFromAxes ranges index with
    | .ok result => NavigationGeometry false ranges index result
    | .error _ => False

