private theorem mc_overlap_le (left right : IntegerValue) :
    NativeOverlap.lessEqual left right = decide (ValueInteger left ≤ ValueInteger right) := by
  cases left with
  | bits type value =>
      cases right with
      | bits rightType right => exact JuliaLean.Proofs.base.int.le_eq value right
      | boolean right =>
          simp only [NativeOverlap.lessEqual, ValueInteger, JuliaLean.Proofs.base.int.le_eq, rt_ofBool_val]
          rfl
  | boolean left =>
      cases right with
      | bits type right =>
          simp only [NativeOverlap.lessEqual, ValueInteger, JuliaLean.Proofs.base.int.le_eq, rt_ofBool_val]
          rfl
      | boolean right => cases left <;> cases right <;> decide

private theorem mc_overlap_eq (left right : IntegerValue) :
    NativeOverlap.equal left right = decide (ValueInteger left = ValueInteger right) := by
  cases left with
  | bits type value =>
      cases right with
      | bits rightType right => exact JuliaLean.Proofs.base.int.eq_eq value right
      | boolean right =>
          simp only [NativeOverlap.equal, ValueInteger, JuliaLean.Proofs.base.int.eq_eq, rt_ofBool_val]
          rfl
  | boolean left =>
      cases right with
      | bits type right =>
          simp only [NativeOverlap.equal, ValueInteger, JuliaLean.Proofs.base.int.eq_eq, rt_ofBool_val]
          rfl
      | boolean right => cases left <;> cases right <;> decide

private theorem mc_overlap_last (range : UnitRangeFields) :
    NativeOverlap.last range = .ok (LastFieldValue range) := by
  induction range with
  | oneToBits type range =>
      change (do
        let value ← JuliaLean.base.range.liftJl (JuliaLean.base.int.convert type range.stop)
        pure (IntegerValue.bits type value)) = .ok (.bits type range.stop)
      rw [rt_convert_self]
      rfl
  | unitBits type range =>
      change (do
        let value ← JuliaLean.base.range.liftJl (JuliaLean.base.int.convert type range.stop)
        pure (IntegerValue.bits type value)) = .ok (.bits type range.stop)
      rw [rt_convert_self]
      rfl
  | oneToBool range => rfl
  | unitBool range => rfl
  | slice indices ih =>
      simpa only [NativeOverlap.last, JuliaLean.base.indices.last_Slice,
        LastFieldValue] using ih
  | identity indices ih =>
      simpa only [NativeOverlap.last, JuliaLean.base.indices.last_IdentityUnitRange,
        LastFieldValue] using ih

private theorem mc_overlap_maximum (left right : IntegerValue) :
    ∃ value, NativeOverlap.maximum left right = .ok value ∧
      ValueInteger value = max (ValueInteger left) (ValueInteger right) := by
  cases left with
  | bits leftType left =>
      cases right with
      | bits rightType right =>
          exact ⟨.bits (leftType.promote rightType) (JuliaLean.base.int.jmax left right),
            rfl, JuliaLean.Proofs.base.int.jmax_val left right⟩
      | boolean right =>
          refine ⟨.bits (leftType.promote leftType)
            (JuliaLean.base.int.jmax left (JuliaLean.base.int.ofBool leftType right)), rfl, ?_⟩
          simp only [ValueInteger, JuliaLean.Proofs.base.int.jmax_val, rt_ofBool_val]
  | boolean left =>
      cases right with
      | bits rightType right =>
          refine ⟨.bits (rightType.promote rightType)
            (JuliaLean.base.int.jmax (JuliaLean.base.int.ofBool rightType left) right), rfl, ?_⟩
          simp only [ValueInteger, JuliaLean.Proofs.base.int.jmax_val, rt_ofBool_val]
      | boolean right =>
          refine ⟨.boolean (left || right), ?_, ?_⟩ <;>
            cases left <;> cases right <;> rfl

private theorem mc_overlap_minimum (left right : IntegerValue) :
    ∃ value, NativeOverlap.minimum left right = .ok value ∧
      ValueInteger value = min (ValueInteger left) (ValueInteger right) := by
  cases left with
  | bits leftType left =>
      cases right with
      | bits rightType right =>
          exact ⟨.bits (JuliaLean.base.int.minType leftType rightType)
            (JuliaLean.base.int.jmin left right), rfl, JuliaLean.Proofs.base.int.jmin_val left right⟩
      | boolean right =>
          refine ⟨.bits (JuliaLean.base.int.minType leftType leftType)
            (JuliaLean.base.int.jmin left (JuliaLean.base.int.ofBool leftType right)), rfl, ?_⟩
          simp only [ValueInteger, JuliaLean.Proofs.base.int.jmin_val, rt_ofBool_val]
  | boolean left =>
      cases right with
      | bits rightType right =>
          refine ⟨.bits (JuliaLean.base.int.minType rightType rightType)
            (JuliaLean.base.int.jmin (JuliaLean.base.int.ofBool rightType left) right), rfl, ?_⟩
          simp only [ValueInteger, JuliaLean.Proofs.base.int.jmin_val, rt_ofBool_val]
      | boolean right =>
          refine ⟨.boolean (left && right), ?_, ?_⟩ <;>
            cases left <;> cases right <;> rfl

private theorem mc_overlap_contains (value : IntegerValue) (range : UnitRangeFields) :
    NativeOverlap.contains value range =
      .ok (decide ((Endpoints range).1 ≤ ValueInteger value ∧
        ValueInteger value ≤ (Endpoints range).2)) := by
  change (do
    let first ← NativePrechecked.first range
    let last ← NativeOverlap.last range
    pure (NativeOverlap.lessEqual first value && NativeOverlap.lessEqual value last)) = _
  rw [rt_native_first, mc_overlap_last]
  simp only [bind, Except.bind, pure, Except.pure, mc_overlap_le,
    Endpoints]
  apply congrArg (fun answer : Bool =>
    (Except.ok answer : JuliaLean.base.range.JlX Bool))
  exact (Bool.decide_and
    (ValueInteger (FirstFieldValue range) ≤ ValueInteger value)
    (ValueInteger value ≤ ValueInteger (LastFieldValue range))).symm

private theorem mc_overlap_range_step {Other : Type}
    (left right : UnitRangeFields) (leftTail rightTail : List (NativeOverlap.Index Other)) :
    NativeOverlap.overlapFields (.unitRange left :: leftTail) (.unitRange right :: rightTail) =
      if max (Endpoints left).1 (Endpoints right).1 ≤
          min (Endpoints left).2 (Endpoints right).2 then
        NativeOverlap.overlapFields leftTail rightTail
      else .ok false := by
  obtain ⟨lower, hlower, hlowerValue⟩ :=
    mc_overlap_maximum (FirstFieldValue left) (FirstFieldValue right)
  obtain ⟨upper, hupper, hupperValue⟩ :=
    mc_overlap_minimum (LastFieldValue left) (LastFieldValue right)
  rw [NativeOverlap.overlapFields]
  simp only [rt_native_first, mc_overlap_last, hlower, hupper,
    NativeOverlap.liftRange, bind, Except.bind, pure, Except.pure,
    mc_overlap_le, hlowerValue, hupperValue, Endpoints, decide_eq_true_eq]
  rfl

private theorem mc_overlap_cons {Other : Type}
    (left right : NativeOverlap.Index Other)
    (leftTail rightTail : List (NativeOverlap.Index Other)) :
    NativeOverlap.overlapFields (left :: leftTail) (right :: rightTail) =
      match CoordinateDecision left right with
      | none => NativeOverlap.overlapFields leftTail rightTail
      | some value => .ok value := by
  cases left with
  | scalar left =>
      cases right with
      | scalar right =>
          rw [NativeOverlap.overlapFields, mc_overlap_eq]
          simp only [CoordinateDecision, decide_eq_true_eq]
          by_cases h : ValueInteger left = ValueInteger right <;>
            simp only [h, ite_true, ite_false, pure, Except.pure]
      | unitRange right =>
          rw [NativeOverlap.overlapFields, mc_overlap_contains]
          simp only [NativeOverlap.liftRange, bind, Except.bind, CoordinateDecision,
            decide_eq_true_eq]
          by_cases h : (Endpoints right).1 ≤ ValueInteger left ∧
              ValueInteger left ≤ (Endpoints right).2 <;>
            simp only [h, true_and, ite_true, ite_false, pure, Except.pure]
      | other right =>
          rw [NativeOverlap.overlapFields] <;>
            first | rfl | (intros; simp_all only [List.cons.injEq,
              reduceCtorEq, and_false, false_and])
  | unitRange left =>
      cases right with
      | scalar right =>
          rw [NativeOverlap.overlapFields, mc_overlap_contains]
          simp only [NativeOverlap.liftRange, bind, Except.bind, CoordinateDecision,
            decide_eq_true_eq]
          by_cases h : (Endpoints left).1 ≤ ValueInteger right ∧
              ValueInteger right ≤ (Endpoints left).2 <;>
            simp only [h, true_and, ite_true, ite_false, pure, Except.pure]
      | unitRange right =>
          rw [mc_overlap_range_step]
          simp only [CoordinateDecision]
          by_cases h : max (Endpoints left).1 (Endpoints right).1 ≤
              min (Endpoints left).2 (Endpoints right).2 <;>
            simp only [h, ite_true, ite_false]
      | other right =>
          rw [NativeOverlap.overlapFields] <;>
            first | rfl | (intros; simp_all only [List.cons.injEq,
              reduceCtorEq, and_false, false_and])
  | other left =>
      cases right <;> rw [NativeOverlap.overlapFields] <;>
        first | rfl | (intros; simp_all only [List.cons.injEq,
          reduceCtorEq, and_false, false_and])

private theorem mc_overlap_fields {Other : Type}
    (left right : List (NativeOverlap.Index Other)) :
    NativeOverlap.overlapFields left right =
      match ((List.zip left right).filterMap
          (fun pair => CoordinateDecision pair.1 pair.2)).head? with
      | some value => .ok value
      | none =>
          if left.length = right.length then .ok true
          else .error (.inr (.errorException "malformed subarray")) := by
  induction left generalizing right with
  | nil =>
      cases right with
      | nil =>
          rw [NativeOverlap.overlapFields]
          rfl
      | cons head tail =>
          rw [NativeOverlap.overlapFields]
          simp only [List.zip_nil_left, List.filterMap_nil, List.head?_nil,
            List.length_nil, List.length_cons, Nat.zero_ne_add_one, ite_false]
          rfl
  | cons head tail ih =>
      cases right with
      | nil =>
          rw [NativeOverlap.overlapFields]
          simp only [List.zip_nil_right, List.filterMap_nil, List.head?_nil,
            List.length_nil, List.length_cons, Nat.add_one_ne_zero, ite_false]
          rfl
      | cons rightHead rightTail =>
          rw [mc_overlap_cons]
          simp only [List.zip_cons_cons, List.filterMap_cons, List.length_cons,
            Nat.add_right_cancel_iff]
          cases hc : CoordinateDecision head rightHead with
          | none => exact ih rightTail
          | some value => rfl

