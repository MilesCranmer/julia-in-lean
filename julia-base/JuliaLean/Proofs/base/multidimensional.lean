theorem rt_ofBool_val (type : IntTy) (value : Bool) :
    (JuliaLean.base.int.ofBool type value).val = if value then 1 else 0 := by
  cases type <;> cases value <;> decide

theorem rt_remBool_val (type : IntTy) (value : Bool) :
    (JuliaLean.base.int.rem_Bool_Type type value).val = if value then 1 else 0 := by
  cases type <;> cases value <;> decide

theorem rt_binop_eq (op : {r : IntTy} → JInt r → JInt r → JInt r)
    {s t : IntTy} (x : JInt s) (y : JInt t) :
    JuliaLean.base.int.binop op x y =
      op (JuliaLean.base.int.remT (s.promote t) x)
        (JuliaLean.base.int.remT (s.promote t) y) := by
  unfold JuliaLean.base.int.binop JuliaLean.base.int.op_Integer
  split <;> rfl

theorem rt_native_successor (state : IntegerValue) :
    NativePrechecked.add state (.bits .i64 (int 1)) =
      .bits (AdditionType (ValueType state) (.bits .i64))
        (JInt.wrap (AdditionType (ValueType state) (.bits .i64))
          (ValueInteger state + 1)) := by
  cases state with
  | bits type value =>
    simp only [NativePrechecked.add, ValueType, ValueInteger, AdditionType]
    congr 1
    apply Subtype.ext
    rw [rt_binop_eq]
    change (JuliaLean.base.int.add_int _ _).val = _
    rw [JuliaLean.Proofs.base.int.add_int_val, JuliaLean.Proofs.base.int.remT_val, JuliaLean.Proofs.base.int.remT_val, int_one,
      JuliaLean.Proofs.base.int.wrapInt_add_left, JuliaLean.Proofs.base.int.wrapInt_add_right]
    rfl
  | boolean value =>
    simp only [NativePrechecked.add, ValueType, ValueInteger, AdditionType,
      JuliaLean.base.int.op_Integer]
    congr 1
    apply Subtype.ext
    change (JuliaLean.base.int.add_int _ _).val = _
    rw [JuliaLean.Proofs.base.int.add_int_val, rt_remBool_val, JuliaLean.Proofs.base.int.remT_val, int_one,
      JuliaLean.Proofs.base.int.wrapInt_add_right]
    rfl

