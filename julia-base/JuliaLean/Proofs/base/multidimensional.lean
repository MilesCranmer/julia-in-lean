theorem permFoldCongr {α β : Type} (xs : List α) (f g : β → α → Result β)
    (h : ∀ b x, x ∈ xs → f b x = g b x) (initial : β) :
    xs.foldlM f initial = xs.foldlM g initial := by
  induction xs generalizing initial with
  | nil => rfl
  | cons x xs ih =>
    simp only [List.foldlM_cons]
