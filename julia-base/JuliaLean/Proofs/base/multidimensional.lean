    exact h b x (List.mem_cons_of_mem _ hx)

theorem permFoldMap {α β γ : Type} (xs : List α) (f : α → β)
    (g : γ → β → Result γ) (initial : γ) :
    (xs.map f).foldlM g initial = xs.foldlM (fun b x => g b (f x)) initial := by
  induction xs generalizing initial with
  | nil => rfl
  | cons x xs ih =>
    simp only [List.map_cons, List.foldlM_cons]
    congr 1
    funext b
    exact ih b

theorem permFoldOr {α : Type} (xs : List α) (p : α → Bool) (initial : Bool) :
    xs.foldl (fun b x => b || p x) initial = (initial || xs.any p) := by
  induction xs generalizing initial with
  | nil => cases initial <;> rfl
  | cons x xs ih =>
    simp only [List.foldl_cons, List.any_cons, ih, Bool.or_assoc]

theorem permFoldAnd {α : Type} (xs : List α) (p : α → Bool) (initial : Bool) :
    xs.foldl (fun b x => b && p x) initial = (initial && xs.all p) := by
  induction xs generalizing initial with
  | nil => cases initial <;> rfl
  | cons x xs ih =>
    simp only [List.foldl_cons, List.all_cons, ih, Bool.and_assoc]

theorem permNodupSubset {α : Type} [DecidableEq α] (xs ys : List α)
    (hnd : xs.Nodup) (hsub : xs ⊆ ys) (hlen : xs.length = ys.length) : xs.Perm ys := by
  induction xs generalizing ys with
  | nil =>
    have hy : ys = [] := List.length_eq_zero_iff.mp hlen.symm
    subst ys
    exact List.Perm.refl []
  | cons x xs ih =>
    have hm : x ∈ ys := hsub (by simp only [List.mem_cons, true_or])
    have hnd' := List.nodup_cons.mp hnd
    have hsub' : xs ⊆ ys.erase x := by
      intro y hy
      apply (List.mem_erase_of_ne (by intro he; subst y; exact hnd'.1 hy)).mpr
      exact hsub (List.mem_cons_of_mem _ hy)
    have hlen' : xs.length = (ys.erase x).length := by
      rw [List.length_erase_of_mem hm]
      simp only [List.length_cons] at hlen
      omega
    exact (List.Perm.cons x (ih (ys.erase x) hnd'.2 hsub' hlen')).trans
      (List.perm_cons_erase hm).symm

theorem permExpectedNodup (n : Nat) :
    ((List.range n).map (fun k => Int.ofNat (k + 1))).Nodup := by
  apply List.pairwise_map.mpr
  apply (List.nodup_range).imp
  intro a b hne he
  apply hne
  exact Nat.add_right_cancel (Int.ofNat.inj he)

def permInnerStep (xs : CI) (i : I64) (seen : Bool) (k : Nat) : Result Bool := do
  if seen then return true
  let value ← tupleGet xs (int ((k : Int) + 1))
  return JuliaLean.base.int.eq value i

theorem permInnerStepCorrect (xs : CI) (i : I64) (seen : Bool) (k : Nat)
    (hk : k < xs.length) (hlen : xs.length < 32) :
    permInnerStep xs i seen k =
      .ok (seen || decide ((xs[k]?.getD (int 0)).val = i.val)) := by
  cases seen with
  | false =>
    change (tupleGet xs (int ((k : Int) + 1)) >>= fun value =>
      Except.ok (JuliaLean.base.int.eq value i)) =
        Except.ok (decide ((xs[k]?.getD (int 0)).val = i.val))
    rw [permTupleGetAtIndex xs (int 0) k hk hlen]
    exact congrArg Except.ok (nb_eq (xs[k]?.getD (int 0)) i)
  | true => rfl

theorem permInnerRangeFold (xs : CI) (hlen : xs.length < 32) (i : I64) (initial : Bool) :
    (List.range xs.length).foldlM (permInnerStep xs i) initial =
      .ok (initial || xs.any (fun value => decide (value.val = i.val))) := by
  have hc := permFoldCongr (List.range xs.length) (permInnerStep xs i)
    (fun seen k => .ok (seen || decide ((xs[k]?.getD (int 0)).val = i.val)))
    (fun seen k hk => permInnerStepCorrect xs i seen k (List.mem_range.mp hk) hlen) initial
  rw [hc, ← permFoldMap (List.range xs.length) (fun k => xs[k]?.getD (int 0))
      (fun seen value => .ok (seen || decide (value.val = i.val))) initial,
    permMapRangeGet]
  change xs.foldlM (fun seen value => pure (seen || decide (value.val = i.val))) initial = _
  rw [List.foldlM_pure, permFoldOr]
  rfl

theorem permInnerFold (xs : CI) (hn : 0 < xs.length) (hlen : xs.length < 32)
    (i : I64) (initial : Bool) :
    tupleFoldOneTo (fun seen j => do
      if seen then return true
      let value ← tupleGet xs j
      return JuliaLean.base.int.eq value i) initial xs.length =
      .ok (initial || xs.any (fun value => decide (value.val = i.val))) := by
  have hn0 : xs.length ≠ 0 := by omega
  simp only [tupleFoldOneTo, hn0, ite_false]
  exact permInnerRangeFold xs hlen i initial

theorem permExpectedMembership (xs : CI) :
    (List.range xs.length).all (fun k =>
      xs.any (fun value => decide (value.val = Int.ofNat (k + 1)))) =
        decide ((xs.map (·.val)).Perm
          ((List.range xs.length).map (fun k => Int.ofNat (k + 1)))) := by
  apply Bool.eq_iff_iff.mpr
  simp only [decide_eq_true_eq]
  constructor
  · intro h
    apply List.Perm.symm
    apply permNodupSubset _ _ (permExpectedNodup _)
    · intro value hv
      obtain ⟨k, hk, rfl⟩ := List.mem_map.mp hv
      obtain ⟨x, hx, he⟩ := List.any_eq_true.mp (List.all_eq_true.mp h k hk)
      exact List.mem_map.mpr ⟨x, hx, of_decide_eq_true he⟩
    · simp only [List.length_map, List.length_range]
  · intro h
    apply List.all_eq_true.mpr
    intro k hk
    have hm : Int.ofNat (k + 1) ∈ xs.map (·.val) :=
      h.symm.subset (List.mem_map.mpr ⟨k, hk, rfl⟩)
    obtain ⟨x, hx, he⟩ := List.mem_map.mp hm
    exact List.any_eq_true.mpr ⟨x, hx, decide_eq_true he⟩

theorem permGeneralFold (xs : CI) (hn : 0 < xs.length) (hlen : xs.length < 32) :
    tupleFoldOneTo (fun all i => do
      let found ← tupleFoldOneTo (fun seen j => do
        if seen then return true
        let value ← tupleGet xs j
        return JuliaLean.base.int.eq value i) false xs.length
      return Bool.and all found) true xs.length =
        .ok (decide ((xs.map (·.val)).Perm
          ((List.range xs.length).map (fun k => Int.ofNat (k + 1))))) := by
  have hn0 : xs.length ≠ 0 := by omega
  rw [tupleFoldOneTo]
  simp only [hn0, ite_false]
  rw [permFoldCongr (List.range xs.length) _
    (fun all k => .ok (all && xs.any (fun value => decide (value.val = Int.ofNat (k + 1))))) ?_ true]
  · change (List.range xs.length).foldlM
      (fun all k => pure (all && xs.any (fun value => decide (value.val = Int.ofNat (k + 1))))) true = _
    rw [List.foldlM_pure, permFoldAnd]
    simp only [Bool.true_and, permExpectedMembership]
    rfl
  · intro all k hk
    rw [permInnerFold xs hn hlen (int ((k : Int) + 1)) false]
    simp only [Bool.false_or, bind, Except.bind, pure, Except.pure]
    rw [permIntSuccessor k (by have := List.mem_range.mp hk; omega)]

theorem permShortTupleCorrect :
    JuliaLean.Proofs.base.multidimensional.Models1Group6.ShortTuplePermutationCorrect := by
  intro permutation
  rcases permutation with ⟨xs, hlen⟩
  change ispermShortTuple ⟨xs, hlen⟩ = .ok (decide ((xs.map (·.val)).Perm
    ((List.range xs.length).map (fun k => Int.ofNat (k + 1)))))
  cases xs with
  | nil => rfl
  | cons a xs =>
    cases xs with
    | nil =>
      rw [← permExpectedMembership [a]]
      simp only [ispermShortTuple, nb_eq]
      change (Except.ok (decide (a.val = 1)) : Result Bool) =
        Except.ok ((decide (a.val = 1) || false) && true)
      simp only [Bool.or_false, Bool.and_true]
    | cons b xs =>
      cases xs with
      | nil =>
        rw [← permExpectedMembership [a, b]]
        simp only [ispermShortTuple, nb_eq]
        change (Except.ok ((decide (a.val = 1) && decide (b.val = 2)) ||
            (decide (a.val = 2) && decide (b.val = 1))) : Result Bool) =
          Except.ok (((decide (a.val = 1) || (decide (b.val = 1) || false))) &&
            ((decide (a.val = 2) || (decide (b.val = 2) || false)) && true))
        by_cases ha1 : a.val = 1 <;> by_cases ha2 : a.val = 2 <;>
          by_cases hb1 : b.val = 1 <;> by_cases hb2 : b.val = 2
        all_goals first | omega | simp only [ha1, ha2, hb1, hb2, decide_true, decide_false,
          Bool.or_false, Bool.false_or, Bool.and_true, Bool.true_and, Bool.false_and,
          Bool.and_false, Bool.or_true, Bool.true_or]
        all_goals rfl
      | cons c xs =>
        exact permGeneralFold (a :: b :: c :: xs) (by simp only [List.length_cons]; omega) hlen

theorem permEntriesPositive (permutation : ShortIntTuple)
    (hp : JuliaLean.Proofs.base.multidimensional.Models1Group6.ShortTuplePermutation permutation)
    (i : I64) (hi : i ∈ permutation.val) : 1 ≤ i.val := by
