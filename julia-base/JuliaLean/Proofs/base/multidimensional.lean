  | strides (array : A) (reply : Except (Sum Error E) Strides)
  | equalElement (left right : Element) (reply : Except (Sum Error E) (MaskTruth Other))
  | equalPointer (left right : Pointer) (reply : Except (Sum Error E) (MaskTruth Other))
  | equalSize (left right : Shape) (reply : Except (Sum Error E) (MaskTruth Other))
  | equalStrides (left right : Strides) (reply : Except (Sum Error E) (MaskTruth Other))

