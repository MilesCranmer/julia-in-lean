def ParentMatchDataflow {E A Element Pointer Shape Strides Other : Type}
    (strided : Bool) (left right : A)
    (events : List (ParentMatchEvent E A Element Pointer Shape Strides Other)) : Prop :=
  ∀ (k : Nat) (event : ParentMatchEvent E A Element Pointer Shape Strides Other),
    events[k]? = some event → match event with
    | .element actual _ => (k = 0 ∧ actual = left) ∨ (k = 1 ∧ actual = right)
    | .equalElement first second _ =>
        k = 2 ∧ events[0]? = some (.element left (.ok first)) ∧
          events[1]? = some (.element right (.ok second))
    | .pointer actual _ => (k = 3 ∧ actual = left) ∨ (k = 4 ∧ actual = right)
    | .equalPointer first second _ =>
        k = 5 ∧ events[3]? = some (.pointer left (.ok first)) ∧
          events[4]? = some (.pointer right (.ok second))
    | .size actual _ => strided = false ∧ ((k = 6 ∧ actual = left) ∨ (k = 7 ∧ actual = right))
    | .strides actual _ => strided = true ∧ ((k = 6 ∧ actual = left) ∨ (k = 7 ∧ actual = right))
    | .equalSize first second _ =>
        strided = false ∧ k = 8 ∧ events[6]? = some (.size left (.ok first)) ∧
          events[7]? = some (.size right (.ok second))
    | .equalStrides first second _ =>
        strided = true ∧ k = 8 ∧ events[6]? = some (.strides left (.ok first)) ∧
          events[7]? = some (.strides right (.ok second))

