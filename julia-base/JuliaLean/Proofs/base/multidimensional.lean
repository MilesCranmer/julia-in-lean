      have hc' : coordinate = c := Option.some.inj hc
      subst a
      subst c
      exact hterminal
    | succ k =>
      apply hbefore k a c (by omega) ha hc
  · intro h
    have hp' : p + 1 < (next :: tail).length := by
      simp only [List.length_cons] at h ⊢
      omega
    obtain ⟨a, c, ha, hc, hne⟩ := hpivot hp'
    exact ⟨a, c, ha, hc, hne⟩
  · intro k a c ha hc
    cases k with
    | zero =>
      have ha' : axis = a := Option.some.inj ha
      have hc' : coordinate = c := Option.some.inj hc
      subst a
      subst c
