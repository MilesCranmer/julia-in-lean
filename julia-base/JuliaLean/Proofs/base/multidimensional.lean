/-- Retain both the constructor/tuple error channel and the installed range
error channel in concrete instances, without collapsing either class. -/
abbrev UtilityNativeM := ExceptT Error RangeResult

def utilityLiftRange {A : Type} (action : RangeResult A) : UtilityNativeM A :=
  ExceptT.mk (action.map Except.ok)

/-- The actual OrdinalRangeInt constructor on these three native tags uses
the installed same-type AbstractUnitRange/StepRange identities. -/
def utilityNativeOrdinalConstructor : OrdinalRange64 → RangeResult OrdinalRange64
  | .oneTo value => .ok (.oneTo
      (JuliaLean.base.range.AbstractUnitRange_T_AbstractUnitRange_T value))
  | .unit value => .ok (.unit
      (JuliaLean.base.range.AbstractUnitRange_T_AbstractUnitRange_T value))
  | .stepped value => .ok (.stepped (JuliaLean.base.range.StepRange_TS_StepRange_TS value))

local instance : JuliaLean.base.range.JIsa OrdinalRange64 OrdinalRange64 := ⟨some⟩
