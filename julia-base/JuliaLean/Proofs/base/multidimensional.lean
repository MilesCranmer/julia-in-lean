pairs never call the dynamic primitive. Returned elements retain their origin;
raw non-tuple final results arise only by scalar forwarding. -/
def IndexMetadataTraceMeaning {E R A C V T : Type} (mode : IndexMetadataMode)
    (inputs : List (Models1Group6.MetadataInput R A C))
    (events : List (IndexMetadataEvent E R A C V T))
    (actual : Except (Sum Error E) (IndexMetadataResult V T)) : Prop :=
  (∃ rest, indexMetadataArrays inputs = indexMetadataReadReferences events ++ rest) ∧
  (events.filterMap (fun event => match event with | .selected _ _ _ => some () | _ => none)).length ≤ 1 ∧
  (∀ (i j : Nat) (left right : IndexMetadataEvent E R A C V T), i < j → events[i]? = some left → events[j]? = some right →
