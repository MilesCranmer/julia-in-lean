/-- Machine-constructible tuple arity; coordinates themselves are unrestricted. -/
def AccessTupleArity {α : Type} (fields : List α) : Prop :=
  (fields.length : Int) ≤ IntTy.max .i64

def AccessIntFits (value : Int) : Prop :=
  IntTy.min .i64 ≤ value ∧ value ≤ IntTy.max .i64

/-- Base exceptions and arbitrary user exception values remain distinguishable. -/
abbrev AccessResult (UserError Value : Type) := Except (Sum Error UserError) Value

/-- Effects can mutate shared state, throw Base or arbitrary custom exceptions,
or fail to terminate. State survives both exception channels. -/
abbrev AccessEffects (State UserError : Type) :=
  ExceptT Error (ExceptT UserError (StateT State Option))

def accessResult {UserError Value : Type} :
    Except UserError (Except Error Value) → AccessResult UserError Value
  | .ok (.ok value) => .ok value
  | .ok (.error error) => .error (.inl error)
  | .error error => .error (.inr error)

def accessRun {State UserError Value : Type}
    (action : AccessEffects State UserError Value) (initial : State) :
    Option (AccessResult UserError Value × State) :=
  (action.run.run initial).map fun (result, final) => (accessResult result, final)

/-- Observations record actual arguments, return/error, and before/after state.
No law is assumed about the observed action. -/
def observeAccessAction {S E Event Value : Type}
    (action : AccessEffects S E Value) (event : AccessResult E Value → Event) :
    AccessEffects (S × List (S × S × Event)) E Value :=
  ExceptT.mk (ExceptT.mk fun (state, events) =>
    match action.run.run state with
    | none => none
    | some (result, state') =>
        some (result, (state', events ++ [(state, state', event (accessResult result))])))

/-- A test interpretation with arbitrary actual return, error, and final state.
This is a concrete callee, not a correctness hypothesis on an unknown callee. -/
def accessReply {S E Value : Type} (reply : AccessResult E Value) (final : S) :
    AccessEffects S E Value :=
  ExceptT.mk (ExceptT.mk fun _ =>
    some ((match reply with
      | .ok value => .ok (.ok value)
      | .error (.inl error) => .ok (.error error)
      | .error (.inr error) => .error error), final))

/-- State can change only through reached calls, including when a call throws. -/
def AccessStateThread {S Event : Type} (initial final : S)
    (records : List (S × S × Event)) : Prop :=
  (match records.head? with
   | none => final = initial
   | some record => record.1 = initial) ∧
  (∀ (record : S × S × Event), records.getLast? = some record → final = record.2.1) ∧
  (∀ (k : Nat) (left right : S × S × Event),
    records[k]? = some left → records[k + 1]? = some right → left.2.1 = right.1)

/-- Independent coordinate/error contract: success names a one-based input
position, bounds failure means a representable position outside that interval,
and InexactError means conversion to native Int is impossible. -/
def NumericalCoordinateOutcome {E Other : Type} (fields : CI) (subscript : Int)
    (answer : AccessResult E (Sum I64 Other)) : Prop :=
  match answer with
  | .ok (.inl value) =>
      ∃ position : Nat, (position : Int) + 1 = subscript ∧ fields[position]? = some value
  | .ok (.inr _) => False
  | .error (.inl .boundsError) =>
      AccessIntFits subscript ∧ (subscript < 1 ∨ (fields.length : Int) < subscript)
  | .error (.inl (.inexactError name)) => name = "Int64" ∧ ¬AccessIntFits subscript
  | .error _ => False

inductive CoordinateEvent (E B P C O : Type) where
  | custom (fields : CI) (index : C) (result : AccessResult E (Sum I64 O))
  | size (reference : B) (result : AccessResult E (JInt .i32))
  | data (reference : B) (result : AccessResult E P)
  | limb (pointer : P) (result : AccessResult E (JInt .u64))

def coordinateEventError {E B P C O : Type} : CoordinateEvent E B P C O → Option (Sum Error E)
  | .custom _ _ (.error error) => some error
  | .size _ (.error error) => some error
  | .data _ (.error error) => some error
  | .limb _ (.error error) => some error
  | _ => none

def observeAccessOps {S E B P C O : Type}
    (ops : AccessOps (AccessEffects S E) B P C O) :
    AccessOps (AccessEffects (S × List (S × S × CoordinateEvent E B P C O)) E)
      B P C O where
  bigReads := {
    readSize := fun reference => observeAccessAction (ops.bigReads.readSize reference) (.size reference)
    readData := fun reference => observeAccessAction (ops.bigReads.readData reference) (.data reference)
    loadLimb := fun pointer => observeAccessAction (ops.bigReads.loadLimb pointer) (.limb pointer) }
  customGetindex := fun fields index =>
    observeAccessAction (ops.customGetindex fields index) (.custom fields index)

/-- BigInt accesses keep the original reference and use only a pointer just
read from that reference. No custom-index method is reached on this Base path.
At most six primitive reads occur; conversion and bounds errors are separate. -/
def BigCoordinateObservation {E B P C O : Type} (reference : B) (fields : CI)
    (events : List (CoordinateEvent E B P C O))
    (answer : AccessResult E (Sum I64 O)) : Prop :=
  events.length ≤ 6 ∧
  (∀ (k : Nat) (event : CoordinateEvent E B P C O), events[k]? = some event →
    match event with
    | .custom _ _ _ => False
    | .size actual _ => actual = reference
    | .data actual _ => actual = reference
    | .limb pointer _ =>
        ∃ previous : Nat, previous + 1 = k ∧
          events[previous]? = some (.data reference (.ok pointer))) ∧
  (match answer with
   | .ok (.inl value) => value ∈ fields
   | .ok (.inr _) => False
   | .error (.inl .boundsError) => True
   | .error (.inl (.inexactError name)) =>
       name = "Int64" ∨ ∃ event ∈ events,
         coordinateEventError event = some (.inl (.inexactError name))
   | .error error => ∃ event ∈ events, coordinateEventError event = some error)

/-- Every Integer subtype is included. Native branches have no interface
effects and satisfy the numerical position/error invariant. BigInt preserves
primitive-read provenance, first failure, and state. A custom tuple-index
method is called exactly once with the original tuple/subscript and preserves
its arbitrary value, exception, and mutation. No callee laws are assumed.
Source: base/multidimensional.jl:105; base/tuple.jl:33-34;
base/gmp.jl:369-370,396-407; doc/src/manual/arrays.md:800-820. -/
def CoordinateAccessObservations : Prop :=
  ∀ (S E B P C O : Type) (ops : AccessOps (AccessEffects S E) B P C O)
    (fields : CI) (index : IntegerArgument B C) (initial : S),
    AccessTupleArity fields →
    match accessRun (coordinateGet (observeAccessOps ops) fields index) (initial, []) with
    | none => True
    | some (answer, (final, records)) =>
        let events := records.map (fun record => record.2.2)
        AccessStateThread initial final records ∧
        (∀ (k : Nat) (event : CoordinateEvent E B P C O), events[k]? = some event →
          ∀ error : Sum Error E, coordinateEventError event = some error →
            k + 1 = events.length ∧ answer = .error error) ∧
        (match index with
         | .bits _ value => records = [] ∧ NumericalCoordinateOutcome fields value.val answer
         | .bool value => records = [] ∧
             NumericalCoordinateOutcome fields (if value then 1 else 0) answer
         | .big reference => BigCoordinateObservation reference fields events answer
         | .custom value => events = [.custom fields value answer])

def primitiveAccessOps : AccessOps Result Empty Empty Empty Empty where
  bigReads := { readSize := Empty.elim, readData := Empty.elim, loadLimb := Empty.elim }
  customGetindex := fun _ impossible => nomatch impossible

def primitiveSubscriptValue : IntegerArgument Empty Empty → Int
  | .bits _ value => value.val
  | .bool value => if value then 1 else 0
  | .big impossible => nomatch impossible
  | .custom impossible => nomatch impossible

/-- All Bool and BitInteger subscripts, including every extremum and the
rank-zero tuple, terminate with the exact coordinate or the required error.
InexactError takes precedence over BoundsError for an unrepresentable index.
Source: base/multidimensional.jl:105; base/tuple.jl:33-34. -/
def PrimitiveCoordinateAccessCorrect : Prop :=
  ∀ (fields : CI) (index : IntegerArgument Empty Empty), AccessTupleArity fields →
    NumericalCoordinateOutcome (E := Empty) fields (primitiveSubscriptValue index)
      ((coordinateGet primitiveAccessOps fields index).mapError Sum.inl)

/-- A normalized concrete GMP value for a numerical specification. Allocated
capacity can exceed the used limbs; only the used limbs matter here. The
signed size is a real Cint and the count is bounded by positive Cint capacity. -/
structure CoordinateBigCell where
  size : JInt .i32
  limbs : List (JInt .u64)

def CoordinateBigCell.Valid (cell : CoordinateBigCell) : Prop :=
  cell.size.val.natAbs = cell.limbs.length ∧
  (cell.limbs.length : Int) ≤ IntTy.max .i32 ∧
  ∀ limb : JInt .u64, cell.limbs.getLast? = some limb → 0 < limb.val

/-- Positional base-2^64 interpretation, independent of conversion code. -/
def coordinateMagnitude : List (JInt .u64) → Int
  | [] => 0
  | limb :: rest => limb.val + (2 : Int) ^ 64 * coordinateMagnitude rest

def CoordinateBigCell.value (cell : CoordinateBigCell) : Int :=
  (if cell.size.val < 0 then -1 else 1) * coordinateMagnitude cell.limbs

/-- Concrete immutable memory snapshot for the numerical property. General
mutable and aliased BigInt references remain covered by the observation property.
The otherwise invalid empty load has an explicit exception, never a zero limb. -/
def concreteBigAccessOps : AccessOps Result CoordinateBigCell CoordinateBigCell Empty Empty where
  bigReads := {
    readSize := fun cell => .ok cell.size
    readData := fun cell => .ok cell
    loadLimb := fun cell =>
      match cell.limbs.head? with
      | some limb => .ok limb
      | none => .error .undefRefError }
  customGetindex := fun _ impossible => nomatch impossible

/-- Every constructible normalized BigInt subscript, including multiple limbs,
is interpreted by its mathematical value. Huge values fail conversion before
tuple bounds; no native-size restriction is imposed on the BigInt value.
Source: base/multidimensional.jl:105; base/tuple.jl:34;
base/gmp.jl:68-71,369-370,396-407. -/
def BigIntegerCoordinateAccessCorrect : Prop :=
  ∀ (fields : CI) (index : CoordinateBigCell), AccessTupleArity fields → index.Valid →
    NumericalCoordinateOutcome (E := Empty) fields index.value
      ((coordinateGet concreteBigAccessOps fields (.big index)).mapError Sum.inl)

/-- Any returning custom-index method remains returning, for all possible
return types, exception values, and state mutations. This supplements the
arbitrary-action trace invariant with termination on a concrete total callee.
Source: base/multidimensional.jl:105. -/
def CustomCoordinateRepliesPreserved : Prop :=
  ∀ (S E C O : Type) (fields : CI) (index : C) (initial final : S)
    (reply : AccessResult E (Sum I64 O)), AccessTupleArity fields →
    let ops : AccessOps (AccessEffects S E) Empty Empty C O := {
      bigReads := { readSize := Empty.elim, readData := Empty.elim, loadLimb := Empty.elim }
      customGetindex := fun _ _ => accessReply reply final }
    accessRun (coordinateGet ops fields (.custom index)) initial = some (reply, final)

theorem CustomCoordinateRepliesPreserved_proven : CustomCoordinateRepliesPreserved := by
  intro S E C O fields index initial final reply _
  cases reply with
  | ok value => rfl
  | error err => cases err <;> rfl

inductive GetDefaultEvent (E A D V : Type) where
  | call (array : A) (index : CI) (default : D) (result : AccessResult E V)

def observeGetOps {S E A D V : Type} (ops : GetOps (AccessEffects S E) A D V) :
    GetOps (AccessEffects (S × List (S × S × GetDefaultEvent E A D V)) E) A D V where
  get := fun array index default =>
    observeAccessAction (ops.get array index default) (.call array index default)

/-- Full AbstractArray domain, with no rank, indexing-origin, return-type, or
callee-correctness restriction. The single observed call has the original
array handle, field tuple, and default. Its result, either exception channel,
and mutations survive without extra wrapper actions.
Source: base/multidimensional.jl:108; doc/src/manual/arrays.md:800-820;
doc/src/manual/interfaces.md:214-223. -/
def GetDefaultDispatchObservations : Prop :=
  ∀ (S E A D V : Type) (ops : GetOps (AccessEffects S E) A D V)
    (array : A) (index : CI) (default : D) (initial : S), AccessTupleArity index →
    match accessRun (cartesianGetDefault (observeGetOps ops) array index default) (initial, []) with
    | none => True
    | some (answer, (final, records)) =>
        AccessStateThread initial final records ∧
        records.map (fun record => record.2.2) = [.call array index default answer]

theorem GetDefaultDispatchObservations_proven : GetDefaultDispatchObservations := by
