/-- Independent event provenance, including the two explicit inbounds calls.
The dependency relations use observed actual return values, with no callee laws. -/
def IntegerAssignedDataflow {Extra A Integer Value Other : Type}
    (array : A) (indices : List Integer)
    (events : List (IntegerAssignedEvent Extra A Integer Value Other)) : Prop :=
  ∀ event ∈ events, match event with
  | .convert actual arguments _ => actual = array ∧ arguments = indices
  | .bounds actual argument _ | .linear actual argument _ | .subscripts actual argument _
  | .access actual argument _ =>
      actual = array ∧ .convert array indices (.ok argument) ∈ events
  | .style actual _ | .dimensions actual _ => actual = array
  | .length argument _ => .convert array indices (.ok argument) ∈ events
  | .notOne count one _ => one.val = 1 ∧ ∃ converted,
      .convert array indices (.ok converted) ∈ events ∧ .length converted (.ok count) ∈ events
  | .notDimensions count dimensions _ => ∃ converted,
      .convert array indices (.ok converted) ∈ events ∧ .length converted (.ok count) ∈ events ∧
      .dimensions array (.ok dimensions) ∈ events
  | .scalar bounds actual argument _ => bounds = false ∧ actual = array ∧ ∃ converted,
      .convert array indices (.ok converted) ∈ events ∧ .linear array converted (.ok argument) ∈ events
  | .splat bounds actual argument _ => bounds = false ∧ actual = array ∧ ∃ converted,
      .convert array indices (.ok converted) ∈ events ∧ .subscripts array converted (.ok argument) ∈ events

/-- Built-in errors can enter through either the direct multidimensional tag or
an installed array/show error carrier; these tags denote the same Julia classes. -/
def AssignedCaughtClass (error : Error) : Prop :=
  error = .boundsError ∨ error = .undefRefError ∨ error = .array .bounds ∨
  error = .array .undefinedReference ∨ error = .array (.showError .undefRefError) ∨
  error = .array (.showError (.dict .undefRef))

def IntegerAssignedOrder {Extra A Integer Value Other : Type} (check : Bool)
    (events : List (IntegerAssignedEvent Extra A Integer Value Other)) : Prop :=
  let phases := events.map integerAssignedPhase
  let start := if check then [0, 1, 2, 3] else [0, 2, 3]
  (∃ tail, phases ++ tail = start ++ [4, 7, 8] ∨ phases ++ tail = start ++ [4, 11] ∨
    phases ++ tail = start ++ [5, 6, 9, 10] ∨ phases ++ tail = start ++ [5, 6, 11]) ∧
  (∀ array reply, .style array reply ∈ events →
    match reply with
    | .ok (.inl _) => 5 ∉ phases ∧ 6 ∉ phases ∧ 9 ∉ phases ∧ 10 ∉ phases
    | .ok (.inr _) => 4 ∉ phases ∧ 7 ∉ phases ∧ 8 ∉ phases
    | .error _ => True) ∧
  (∀ array indices reply, .bounds array indices reply ∈ events →
    match reply with
    | .ok (.inl true) => True
    | _ => phases = [0, 1]) ∧
  (∀ count one reply, .notOne count one reply ∈ events →
    match reply with
    | .ok (.inl true) => 11 ∉ phases
    | .ok (.inl false) => 7 ∉ phases ∧ 8 ∉ phases
    | _ => phases = start ++ [4]) ∧
  (∀ count dimensions reply, .notDimensions count dimensions reply ∈ events →
    match reply with
    | .ok (.inl true) => 11 ∉ phases
    | .ok (.inl false) => 9 ∉ phases ∧ 10 ∉ phases
    | _ => phases = start ++ [5, 6])

/-- The terminal classification separates raw forwarded outcomes, ignored
successful access values, caught access errors, uncaught errors elsewhere, and
non-Bool control values. It does not assume successful or Boolean callees. -/
def IntegerAssignedTerminal {Extra A Integer Value Other : Type}
    (result : Except (Sum Error Extra) (Sum Bool Value))
    (events : List (IntegerAssignedEvent Extra A Integer Value Other)) : Prop :=
  (∀ before event after error,
    events = before ++ event :: after → integerAssignedError event = some error →
    after = [] ∧
      ((∃ array indices builtin, event = .access array indices (.error (.inl builtin)) ∧
          AssignedCaughtClass builtin ∧ result = .ok (.inl false)) ∨
       result = .error error)) ∧
  (match events.getLast? with
   | some (.scalar _ _ _ reply) | some (.splat _ _ _ reply) => result = reply
   | some (.access _ _ (.ok _)) => result = .ok (.inl true)
   | some (.access _ _ (.error (.inl error))) =>
       (AssignedCaughtClass error ∧ result = .ok (.inl false)) ∨
       (¬ AssignedCaughtClass error ∧ result = .error (.inl error))
   | some (.bounds _ _ (.ok (.inl false))) => result = .ok (.inl false)
   | some (.bounds _ _ (.ok (.inr _))) | some (.notOne _ _ (.ok (.inr _)))
   | some (.notDimensions _ _ (.ok (.inr _))) => result = .error (.inl .typeError)
   | some event => ∃ error, integerAssignedError event = some error ∧ result = .error error
   | none => False)

/-- Full-domain assignedness control contract: conversion precedes every
query, each raw result reaches the correct next operation, bounds elision
removes only the marked check, and only access-time BoundsError/UndefRefError
become false. Other exceptions and every mutation remain observable. A true
access result does not require the ignored accessed value to be Boolean or
different from the array. Source1641-1663; documented behavior is
base/essentials.jl:1124-1128. -/
def IntegerAssignedObservations : Prop :=
  ∀ (Extra S A Integer Value Other : Type)
    (ops : IntegerAssignedOps (ConstructorObservationM Extra S) A Integer Value Other)
    (check : Bool) (array : A) (indices : List Integer) (initial : S),
    TupleArity indices →
    match (isassignedIntegersOpen (Extra := Extra) (observeIntegerAssignedOps ops) check array indices).run (initial, []) with
    | none => True
    | some (result, (final, records)) =>
        ConstructorStateThread initial final records ∧
        IntegerAssignedOrder check (records.map (fun record => record.2.2)) ∧
        IntegerAssignedDataflow array indices (records.map (fun record => record.2.2)) ∧
        IntegerAssignedTerminal result (records.map (fun record => record.2.2))

/-- The catch scope is narrower than the complete method: arbitrary failures
from access retain the state reached by that action; precisely the two caught
Julia classes yield false, every successful raw value yields true, and all
other built-in/user thrown objects survive unchanged. This helper is also used
by the registered full public-method invariant above. -/
def AssignedCatchObservations : Prop :=
  ∀ (Extra S A Integer Value Other : Type)
    (ops : IntegerAssignedOps (ConstructorObservationM Extra S) A Integer Value Other)
    (array : A) (indices : Value) (initial : S),
    match (ops.getindexSplat array indices).run initial with
    | none => (assignedAccessCatch (Extra := Extra) ops array indices).run initial = none
    | some (.ok _, final) =>
        (assignedAccessCatch (Extra := Extra) ops array indices).run initial = some (.ok (.inl true), final)
    | some (.error (.inl error), final) =>
        (AssignedCaughtClass error ∧
          (assignedAccessCatch (Extra := Extra) ops array indices).run initial = some (.ok (.inl false), final)) ∨
        (¬ AssignedCaughtClass error ∧
          (assignedAccessCatch (Extra := Extra) ops array indices).run initial = some (.error (.inl error), final))
    | some (.error (.inr error), final) =>
        (assignedAccessCatch (Extra := Extra) ops array indices).run initial = some (.error (.inr error), final)

theorem assignedCatchObservations_proven :
