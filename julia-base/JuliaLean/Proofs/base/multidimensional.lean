theorem lt_i64 (x y : I64) : JuliaLean.base.int.lt x y = decide (x.val < y.val) :=
  JuliaLean.Proofs.base.int.lt_eq x y

theorem eq_i64 (x y : I64) : JuliaLean.base.int.eq x y = decide (x.val = y.val) :=
  JuliaLean.Proofs.base.int.eq_eq x y

theorem add_i64 (x y : I64) :
    JuliaLean.base.int.add x y = JInt.wrap .i64 (x.val + y.val) := by
  apply Subtype.ext
  exact JuliaLean.Proofs.base.int.add_int_val x y

theorem one_val : (int 1).val = 1 := by decide

theorem add_one (x : I64) :
    JuliaLean.base.int.add x (int 1) = JInt.wrap .i64 (x.val + 1) := by
  rw [add_i64, one_val]

theorem convert_i64 (x : I64) : JuliaLean.base.int.convert .i64 x = .ok x := by
  unfold JuliaLean.base.int.convert JInt.convert
  simp only [x.property, and_self, dite_true]

theorem range_convert_i64 (x : I64) :
    JuliaLean.base.range.JConvert.convert (T := I64) x = .ok x := by
  change JuliaLean.base.range.liftJl (JuliaLean.base.int.convert .i64 x) = .ok x
  rw [convert_i64]
  rfl

def nextIndex : Option I64 → I64
  | none => int 1
  | some previous => JInt.wrap .i64 (previous.val + 1)

theorem candidate_iff (range : LinearRange) (cursor : Option I64) (index : I64) :
    Candidate range cursor index ↔ ¬ Exhausted range cursor ∧ index = nextIndex cursor := by
  cases cursor with
  | none =>
    simp only [Candidate, Exhausted, nextIndex]
    constructor
    · intro h
      exact ⟨by omega, Subtype.ext (h.2.trans one_val.symm)⟩
    · intro h
      exact ⟨by omega, (congrArg Subtype.val h.2).trans one_val⟩
  | some previous => rfl

theorem stateMatches_iff (originalOrdinal : I64) (range : LinearRange) (index : I64)
    (state : StoredState) :
    StateMatches originalOrdinal range index state ↔
      state = ⟨JInt.wrap .i64 (originalOrdinal.val + 1), range, index⟩ := by
  cases state
  simp only [StateMatches, NativeLogicalIteration.StoredState.mk.injEq]


theorem iterate_none (range : LinearRange) :
    NativeLogicalIteration.iterateLinear range none =
      if range.axis.stop.val < 1 then .ok none else .ok (some (int 1, int 1)) := by
  simp only [NativeLogicalIteration.iterateLinear, NativeLogicalIteration.linearFields,
    List.headD_cons, JuliaLean.base.range.length_OneTo_bigints,
    JuliaLean.base.range.unchecked_oneto, JuliaLean.base.range.iterate_OrdinalRange,
    JuliaLean.base.range.isempty_AbstractUnitRange, JuliaLean.base.range.first_OneTo,
    NativeSimd.axisLast, JuliaLean.base.range.last_OrdinalRange,
    range_convert_i64, lt_i64, one_val, Pure.pure, Except.pure, Bind.bind,
    Except.bind, decide_eq_true_eq]

theorem step_one : JuliaLean.base.int.sub (int 1) (int 0) = int 1 := by decide

theorem iterate_some (range : LinearRange) (previous : I64) :
    NativeLogicalIteration.iterateLinear range (some previous) =
      if previous.val = range.axis.stop.val then .ok none
      else .ok (some (nextIndex (some previous), nextIndex (some previous))) := by
  simp only [NativeLogicalIteration.iterateLinear, NativeLogicalIteration.linearFields,
    List.headD_cons, JuliaLean.base.range.length_OneTo_bigints,
    JuliaLean.base.range.unchecked_oneto, JuliaLean.base.range.iterate_OrdinalRange_state,
    NativeSimd.axisLast, JuliaLean.base.range.last_OrdinalRange,
    JuliaLean.base.range.step_AbstractUnitRange, step_one,
    range_convert_i64, eq_i64, add_one, nextIndex, Pure.pure, Except.pure, Bind.bind,
    Except.bind, decide_eq_true_eq]

theorem exhausted_iterate (range : LinearRange) (cursor : Option I64)
    (h : Exhausted range cursor) :
    NativeLogicalIteration.iterateLinear range cursor = .ok none := by
  cases cursor with
  | none =>
    change range.axis.stop.val < 1 at h
    rw [iterate_none, if_pos h]
  | some previous =>
    change previous.val = range.axis.stop.val at h
    rw [iterate_some, if_pos h]

theorem candidate_iterate (range : LinearRange) (cursor : Option I64)
    (h : ¬ Exhausted range cursor) :
    NativeLogicalIteration.iterateLinear range cursor =
      .ok (some (nextIndex cursor, nextIndex cursor)) := by
  cases cursor with
  | none =>
    change ¬ range.axis.stop.val < 1 at h
    rw [iterate_none, if_neg h]
    rfl
  | some previous =>
    change previous.val ≠ range.axis.stop.val at h
    rw [iterate_some, if_neg h]

theorem read_cell {Handle : Type} (mask : NativeLogical.Mask Handle 1) (index : I64)
    (value : Bool) (h : Cell mask index value) :
    NativeLogicalIteration.readMask mask index = .ok value := by
  unfold NativeLogicalIteration.readMask vectorRead JuliaLean.base.array.vectorGet
  rw [if_pos ⟨h.1, h.2.1⟩, h.2.2]
  rfl

theorem read_outside {Handle : Type} (mask : NativeLogical.Mask Handle 1) (index : I64)
    (h : OutsideStorage mask index) :
    NativeLogicalIteration.readMask mask index = .error (.inr (.array .bounds)) := by
  unfold NativeLogicalIteration.readMask vectorRead JuliaLean.base.array.vectorGet
  rw [if_neg (show ¬ (1 ≤ index.val ∧ index.val ≤ (mask.storage.elements.length : Int)) by
    unfold OutsideStorage at h
    omega)]
  rfl

theorem get_exists {Value : Type} (values : List Value) (index : Nat)
    (h : index < values.length) : ∃ value, values[index]? = some value := by
  induction values generalizing index with
  | nil => simp only [List.length_nil] at h; omega
  | cons first rest ih =>
    cases index with
    | zero => exact ⟨first, rfl⟩
    | succ index =>
      obtain ⟨value, hv⟩ := ih index (by simpa only [List.length_cons, Nat.succ_lt_succ_iff] using h)
      exact ⟨value, hv⟩

theorem read_cases {Handle : Type} (mask : NativeLogical.Mask Handle 1) (index : I64) :
    OutsideStorage mask index ∨ Cell mask index true ∨ Cell mask index false := by
  by_cases h : 1 ≤ index.val ∧ index.val ≤ (mask.storage.elements.length : Int)
  · obtain ⟨value, hv⟩ := get_exists mask.storage.elements (index.val - 1).toNat (by omega)
    cases value with
    | false => exact .inr (.inr ⟨h.1, h.2, hv⟩)
    | true => exact .inr (.inl ⟨h.1, h.2, hv⟩)
  · exact .inl (by unfold OutsideStorage; omega)

theorem cell_not_outside {Handle : Type} {mask : NativeLogical.Mask Handle 1}
    {index : I64} {value : Bool} (h : Cell mask index value) : ¬ OutsideStorage mask index := by
  unfold Cell OutsideStorage at *
  omega

theorem cell_unique {Handle : Type} {mask : NativeLogical.Mask Handle 1}
    {index : I64} {left right : Bool} (hl : Cell mask index left) (hr : Cell mask index right) :
    left = right := by
  exact Option.some.inj (hl.2.2.symm.trans hr.2.2)

theorem scan_exhausted {Handle : Type} (mask : NativeLogical.Mask Handle 1)
    (ordinal : I64) (range : LinearRange) (cursor : Option I64)
    (h : Exhausted range cursor) :
    NativeLogicalIteration.scanStep mask ordinal range cursor = .error (.inr .typeError) := by
  rw [NativeLogicalIteration.scanStep, exhausted_iterate range cursor h]
  rfl

theorem scan_cell {Handle : Type} (mask : NativeLogical.Mask Handle 1)
    (ordinal : I64) (range : LinearRange) (cursor : Option I64) (value : Bool)
    (hc : ¬ Exhausted range cursor) (hv : Cell mask (nextIndex cursor) value) :
    NativeLogicalIteration.scanStep mask ordinal range cursor =
      .ok (if value then .yielded (nextIndex cursor)
        ⟨JInt.wrap .i64 (ordinal.val + 1), range, nextIndex cursor⟩
      else .pending ordinal ⟨JInt.wrap .i64 (ordinal.val + 1), range, nextIndex cursor⟩) := by
  rw [NativeLogicalIteration.scanStep, candidate_iterate range cursor hc]
  simp only [Except.mapError, Bind.bind, Except.bind, Pure.pure, Except.pure]
  rw [read_cell mask _ value hv, add_one]
  cases value <;> rfl

theorem scan_outside {Handle : Type} (mask : NativeLogical.Mask Handle 1)
    (ordinal : I64) (range : LinearRange) (cursor : Option I64)
    (hc : ¬ Exhausted range cursor) (hv : OutsideStorage mask (nextIndex cursor)) :
    NativeLogicalIteration.scanStep mask ordinal range cursor = .error (.inr (.array .bounds)) := by
  rw [NativeLogicalIteration.scanStep, candidate_iterate range cursor hc]
  simp only [Except.mapError, Bind.bind, Except.bind, Pure.pure, Except.pure]
  rw [read_outside mask _ hv]


theorem step_contract {Handle : Type} (mask : NativeLogical.Mask Handle 1)
    (ordinal : I64) (range : LinearRange) (cursor : Option I64) :
    StepContract mask ordinal range cursor
      (NativeLogicalIteration.scanStep mask ordinal range cursor) := by
  by_cases exhausted : Exhausted range cursor
  · rw [scan_exhausted mask ordinal range cursor exhausted]
    refine ⟨?_, ?_, ?_, ?_, ?_⟩
    · intro index state
      constructor
      · intro h; cases h
      · intro h
        exact False.elim (((candidate_iff range cursor index).mp h.1).1 exhausted)
    · intro retained state
      constructor
      · intro h; cases h
      · intro h
        exact False.elim (((candidate_iff range cursor state.cursor).mp h.2.1).1 exhausted)
    · exact ⟨fun _ => exhausted, fun _ => rfl⟩
    · constructor
      · intro h; cases h
      · rintro ⟨index, hc, _⟩
        exact False.elim (((candidate_iff range cursor index).mp hc).1 exhausted)
    · exact .inl rfl
  · have candidate : ∀ index, Candidate range cursor index ↔ index = nextIndex cursor := by
      intro index
      rw [candidate_iff]
      exact ⟨fun h => h.2, fun h => ⟨exhausted, h⟩⟩
    rcases read_cases mask (nextIndex cursor) with outside | positive | negative
    · rw [scan_outside mask ordinal range cursor exhausted outside]
      refine ⟨?_, ?_, ?_, ?_, ?_⟩
      · intro index state
        constructor
        · intro h; cases h
        · intro h
          have hi := (candidate index).mp h.1
          subst index
          exact False.elim (cell_not_outside h.2.1 outside)
      · intro retained state
        constructor
        · intro h; cases h
        · intro h
          have hi := (candidate state.cursor).mp h.2.1
          have hc := h.2.2.1
          rw [hi] at hc
          exact False.elim (cell_not_outside hc outside)
      · constructor
        · intro h; cases h
        · intro h; exact False.elim (exhausted h)
      · exact ⟨fun _ => ⟨nextIndex cursor, (candidate _).mpr rfl, outside⟩, fun _ => rfl⟩
      · exact .inr (.inl rfl)
    · rw [scan_cell mask ordinal range cursor true exhausted positive]
      change StepContract mask ordinal range cursor (.ok (.yielded (nextIndex cursor)
        ⟨JInt.wrap .i64 (ordinal.val + 1), range, nextIndex cursor⟩))
      refine ⟨?_, ?_, ?_, ?_, ?_⟩
      · intro index state
        constructor
        · intro h
          have hp := NativeLogicalIteration.Progress.yielded.inj (Except.ok.inj h)
          rcases hp with ⟨rfl, rfl⟩
          exact ⟨(candidate _).mpr rfl, positive, (stateMatches_iff _ _ _ _).mpr rfl⟩
        · intro h
          have hi := (candidate index).mp h.1
          subst index
          have hs := (stateMatches_iff _ _ _ _).mp h.2.2
          subst state
          rfl
      · intro retained state
        constructor
        · intro h; cases h
        · intro h
          have hi := (candidate state.cursor).mp h.2.1
          have hc := h.2.2.1
          rw [hi] at hc
          have he := cell_unique positive hc
          cases he
      · constructor
        · intro h; cases h
        · intro h; exact False.elim (exhausted h)
      · constructor
        · intro h; cases h
        · rintro ⟨index, hc, ho⟩
          have hi := (candidate index).mp hc
          subst index
          exact False.elim (cell_not_outside positive ho)
      · exact .inr (.inr (.inl ⟨_, _, rfl⟩))
    · rw [scan_cell mask ordinal range cursor false exhausted negative]
      change StepContract mask ordinal range cursor (.ok (.pending ordinal
        ⟨JInt.wrap .i64 (ordinal.val + 1), range, nextIndex cursor⟩))
      refine ⟨?_, ?_, ?_, ?_, ?_⟩
      · intro index state
        constructor
        · intro h; cases h
        · intro h
          have hi := (candidate index).mp h.1
          subst index
          have he := cell_unique h.2.1 negative
          cases he
      · intro retained state
        constructor
        · intro h
          have hp := NativeLogicalIteration.Progress.pending.inj (Except.ok.inj h)
          rcases hp with ⟨rfl, rfl⟩
          exact ⟨rfl, (candidate _).mpr rfl, negative, (stateMatches_iff _ _ _ _).mpr rfl⟩
        · intro h
          have hr := h.1
          subst retained
          have hi := (candidate state.cursor).mp h.2.1
          have hs := (stateMatches_iff _ _ _ _).mp h.2.2.2
          rw [hi] at hs
          subst state
          rfl
      · constructor
        · intro h; cases h
        · intro h; exact False.elim (exhausted h)
      · constructor
        · intro h; cases h
        · rintro ⟨index, hc, ho⟩
          have hi := (candidate index).mp hc
          subst index
          exact False.elim (cell_not_outside negative ho)
