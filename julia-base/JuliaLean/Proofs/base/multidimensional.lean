           (check = true ∧ ∃ ignored, initialPart = [(initial, afterCheck, .bounds array indices (.ok ignored))])) ∧
          ((∃ error, result = .error error ∧
              records = initialPart ++ [(afterCheck, final, .reshape style array indices (.error error))]) ∨
