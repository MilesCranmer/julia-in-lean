theorem product7_fold_mul_val (dims : CI) (acc : I64) :
    (dims.foldl JuliaLean.base.int.mul acc).val =
      wrapInt .i64 (acc.val * (dims.map (fun x => x.val)).prod) := by
  induction dims generalizing acc with
  | nil =>
    simp only [List.foldl_nil, List.map_nil, List.prod_nil, Int.mul_one]
    exact (wrapInt_of_inRange .i64 acc.val acc.property).symm
  | cons d ds ih =>
    rw [List.foldl_cons, ih, mul_int_val, (wrapInt_mul_left .i64)]
    simp only [List.map_cons, List.prod_cons, Int.mul_assoc]

theorem product7_sigma_fold (dims : CI) (acc : I64) :
    ((dims.map (fun d => (⟨(), d⟩ : Sigma (fun _ : Unit => I64)))).foldl
      (fun (x y : Sigma (fun _ : Unit => I64)) => ⟨(), JuliaLean.base.int.mul x.2 y.2⟩)
      ⟨(), acc⟩) = ⟨(), dims.foldl JuliaLean.base.int.mul acc⟩ := by
  induction dims generalizing acc with
  | nil => rfl
  | cons d ds ih =>
    simpa only [List.map_cons, List.foldl_cons] using ih (JuliaLean.base.int.mul acc d)

theorem product7_nonempty_val (first : I64) (rest : CI) :
    (multiplyNonemptyTuple64 first rest).val =
      wrapInt .i64 (first.val * (rest.map (fun x => x.val)).prod) := by
  cases rest with
  | nil =>
    change first.val = wrapInt .i64 (first.val * 1)
    rw [Int.mul_one, wrapInt_of_inRange .i64 first.val first.property]
  | cons second rest =>
    cases rest with
    | nil =>
      change (JuliaLean.base.int.mul first second).val =
        wrapInt .i64 (first.val * (second.val * 1))
      rw [mul_int_val, Int.mul_one]
    | cons third tail =>
      simp only [multiplyNonemptyTuple64, naryOperator, JuliaLean.Proofs.base.operators.afoldlMany_eq_foldl,
        product7_sigma_fold, product7_fold_mul_val, mul_int_val,
        (wrapInt_mul_left .i64), List.map_cons, List.prod_cons, Int.mul_assoc]

theorem product7_tuple_val (dims : CI) :
    (tupleProduct64 dims).val = wrapInt .i64 (dims.map (fun x => x.val)).prod := by
  cases dims with
  | nil => rfl
  | cons first rest => exact product7_nonempty_val first rest

theorem product7_mod_eq_of_sub {a b : Int}
    (h : (a - b) % ((2 : Int)^64) = 0) :
    a % ((2 : Int)^64) = b % ((2 : Int)^64) := by
  change (a - b) % 18446744073709551616 = 0 at h
  change a % 18446744073709551616 = b % 18446744073709551616
  omega

theorem product7_sub_mod_of_eq {a b : Int}
    (h : a % ((2 : Int)^64) = b % ((2 : Int)^64)) :
    (a - b) % ((2 : Int)^64) = 0 := by
  change a % 18446744073709551616 = b % 18446744073709551616 at h
  change (a - b) % 18446744073709551616 = 0
