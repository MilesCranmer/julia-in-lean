  (∀ event ∈ records.map (fun record => record.2.2), match event with
    | .axisFirst actual _ | .axisLast actual _ => actual = axis
    | .outerLength actual _ | .outerFirst actual _ | .outerLast actual _ => actual = outer
    | .add _ one _ => one.val = 1
    | _ => True) ∧
  (∀ (k : Nat) (event : PartitionSkipEvent E A O V D C H X),
    (records.map (fun record => record.2.2))[k]? = some event →
    (∀ error, partitionSkipEventError event = some error →
      k + 1 = records.length ∧ result = .error error) ∧
    (partitionSkipNonBool event → k + 1 = records.length ∧ result = .error (.inl .typeError))) ∧
  (∀ error, result = .error error →
    ∃ event, (records.map (fun record => record.2.2)).getLast? = some event ∧
      (partitionSkipEventError event = some error ∨
