identify all empty stored OneTo values: their source equality compares stops.
Source: base/multidimensional.jl:382-383; base/range.jl:1151-1177. -/
def RegionEqualityGeometry : Prop :=
  (∀ a : Region64, RegionDomain a → regionEqual a a = .ok true) ∧
  ∀ (a b : Region64), RegionDomain a → RegionDomain b → a.length = b.length →
    ∃ equal : Bool,
      regionEqual a b = .ok equal ∧ regionEqual b a = .ok equal ∧
      (equal = true → SameRegionAxisValues a b) ∧
      ((∀ axis ∈ a, 0 < rangeCardinality axis) →
       (∀ axis ∈ b, 0 < rangeCardinality axis) →
       (equal = true ↔ SameRegionAxisValues a b))

