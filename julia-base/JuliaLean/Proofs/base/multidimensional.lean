counts are congruent to their mathematical cardinality, including overflow. -/
def GetAxisExtent (axis : OrdinalRange64) (extent : I64) : Prop :=
  match axis with
  | .oneTo value => extent = value.stop
  | .unit _ | .stepped _ =>
      (extent.val - (rangeCardinality axis : Int)) % ((2 : Int) ^ 64) = 0

def GetRegionAddress (array : Region64) (index : CI) : Prop :=
  array.length = index.length ∧
  ∀ (position : Nat) (axis : OrdinalRange64) (subscript : I64),
    array[position]? = some axis → index[position]? = some subscript →
    ∃ extent : I64, GetAxisExtent axis extent ∧
      (subscript.val - 1) % ((2 : Int) ^ 64) < extent.val % ((2 : Int) ^ 64)

/-- A concrete Base instantiation of the open array call, using the installed
tagged CartesianIndices tuple-get implementation. Rank agreement is the actual
domain of this concrete specialization; the generic companion property covers
