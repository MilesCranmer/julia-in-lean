inductive CircularCopyEvent (D S AS AD R L Z F H HS B M E O : Type) where
  | axesSrc (source : S) (reply : Except (Sum Error E) AS)
  | axesDest (destination : D) (reply : Except (Sum Error E) AD)
  | sizeSrc (axes : AS) (reply : Except (Sum Error E) Z)
  | sizeDest (axes : AD) (reply : Except (Sum Error E) Z)
  | different (source destination : Z) (reply : Except (Sum Error E) (Sum Bool B))
  | format (opening : String) (source : Z) (middle : String) (destination : Z) (closing : String)
      (reply : Except (Sum Error E) M)
  | exception (message : M) (reply : Except (Sum Error E) (Sum Error E))
  | shifts (source : AS) (destination : AD) (reply : Except (Sum Error E) HS)
  | all (shifts : HS) (reply : Except (Sum Error E) (Sum Bool B))
  | copy (destination : D) (source : S) (reply : Except (Sum Error E) O)
  | recursive (destination : D) (destinationEmpty : Unit) (destinationAxes : AD)
      (source : S) (sourceEmpty : Unit) (sourceAxes : AS) (reply : Except (Sum Error E) O)
  | first (range : R) (reply : Except (Sum Error E) F)
  | subtract (source destination : F) (reply : Except (Sum Error E) H)
  | zero (shift : H) (literal : I64) (reply : Except (Sum Error E) (Sum Bool B))
  | length (range : R) (reply : Except (Sum Error E) L)

def observeCircularCopyOps {W D S AS AD R L Z F H HS B M E O : Type}
    (ops : CircularCopyOps (ConstructorObservationM E W) D S AS AD R L Z F H HS B M E O) :
    CircularCopyOps
      (ConstructorObservationM E (W × List (W × W × CircularCopyEvent D S AS AD R L Z F H HS B M E O)))
      D S AS AD R L Z F H HS B M E O where
  same := ops.same
  axesSrc := fun source => observeConstructorAction (ops.axesSrc source) (.axesSrc source)
  axesDest := fun destination => observeConstructorAction (ops.axesDest destination) (.axesDest destination)
  length := fun range => observeConstructorAction (ops.length range) (.length range)
  mapLengthSrc := fun _ axes => observeConstructorAction (ops.mapLengthSrc ops.length axes) (.sizeSrc axes)
  mapLengthDest := fun _ axes => observeConstructorAction (ops.mapLengthDest ops.length axes) (.sizeDest axes)
  different := fun source destination =>
    observeConstructorAction (ops.different source destination) (.different source destination)
  formatMismatch := fun opening source middle destination closing => observeConstructorAction
    (ops.formatMismatch opening source middle destination closing) (.format opening source middle destination closing)
  dimensionMismatch := fun message => observeConstructorAction (ops.dimensionMismatch message) (.exception message)
  first := fun range => observeConstructorAction (ops.first range) (.first range)
  subtract := fun source destination => observeConstructorAction (ops.subtract source destination) (.subtract source destination)
  mapShift := fun _ source destination =>
    observeConstructorAction (ops.mapShift (circularCopyShift ops) source destination) (.shifts source destination)
  equalZero := fun shift literal => observeConstructorAction (ops.equalZero shift literal) (.zero shift literal)
  all := fun _ shifts => observeConstructorAction (ops.all (circularCopyZero ops) shifts) (.all shifts)
  copy := fun destination source => observeConstructorAction (ops.copy destination source) (.copy destination source)
  recursive := fun destination destinationEmpty destinationAxes source sourceEmpty sourceAxes =>
    observeConstructorAction (ops.recursive destination destinationEmpty destinationAxes source sourceEmpty sourceAxes)
      (.recursive destination destinationEmpty destinationAxes source sourceEmpty sourceAxes)

def circularCopyPhase {D S AS AD R L Z F H HS B M E O : Type} :
    CircularCopyEvent D S AS AD R L Z F H HS B M E O → Nat
  | .axesSrc _ _ => 0 | .axesDest _ _ => 1 | .sizeSrc _ _ => 2 | .sizeDest _ _ => 3
  | .different _ _ _ => 4 | .format _ _ _ _ _ _ => 5 | .exception _ _ => 6
  | .shifts _ _ _ => 7 | .all _ _ => 8 | .copy _ _ _ => 9 | .recursive _ _ _ _ _ _ _ => 10
  | .first _ _ => 11 | .subtract _ _ _ => 12 | .zero _ _ _ => 13 | .length _ _ => 14

def circularCopyEventError {D S AS AD R L Z F H HS B M E O : Type} :
    CircularCopyEvent D S AS AD R L Z F H HS B M E O → Option (Sum Error E)
  | .axesSrc _ (.error error) | .axesDest _ (.error error)
  | .sizeSrc _ (.error error) | .sizeDest _ (.error error)
  | .different _ _ (.error error) | .format _ _ _ _ _ (.error error)
  | .exception _ (.error error) | .shifts _ _ (.error error) | .all _ (.error error)
  | .copy _ _ (.error error) | .recursive _ _ _ _ _ _ (.error error)
  | .first _ (.error error) | .subtract _ _ (.error error) | .zero _ _ (.error error)
  | .length _ (.error error) => some error
  | _ => none

def CircularCopyArguments {D S AS AD R L Z F H HS B M E O : Type}
    (destination : D) (source : S) (events : List (CircularCopyEvent D S AS AD R L Z F H HS B M E O)) : Prop :=
  ∀ event ∈ events, match event with
    | .axesSrc actual _ => actual = source
    | .axesDest actual _ => actual = destination
    | .sizeSrc axes _ => .axesSrc source (.ok axes) ∈ events
    | .sizeDest axes _ => .axesDest destination (.ok axes) ∈ events
    | .different sourceSize destinationSize _ =>
        (∃ axes, .sizeSrc axes (.ok sourceSize) ∈ events) ∧
        (∃ axes, .sizeDest axes (.ok destinationSize) ∈ events)
    | .format opening sourceSize middle destinationSize closing _ =>
        opening = "src and dest must have the same sizes (got " ∧ middle = " and " ∧ closing = ")" ∧
        .different sourceSize destinationSize (.ok (.inl true)) ∈ events
    | .exception message _ => ∃ a b c d e, .format a b c d e (.ok message) ∈ events
    | .shifts sourceAxes destinationAxes _ =>
        .axesSrc source (.ok sourceAxes) ∈ events ∧ .axesDest destination (.ok destinationAxes) ∈ events ∧
        ∃ a b, .different a b (.ok (.inl false)) ∈ events
    | .all shifts _ => ∃ a b, .shifts a b (.ok shifts) ∈ events
    | .copy actualDestination actualSource _ => actualDestination = destination ∧ actualSource = source ∧
        ∃ shifts, .all shifts (.ok (.inl true)) ∈ events
    | .recursive actualDestination _ destinationAxes actualSource _ sourceAxes _ =>
        actualDestination = destination ∧ actualSource = source ∧
        .axesSrc source (.ok sourceAxes) ∈ events ∧ .axesDest destination (.ok destinationAxes) ∈ events ∧
        ∃ shifts, .all shifts (.ok (.inl false)) ∈ events
    | _ => False

def CircularCopyFinalError {D S AS AD R L Z F H HS B M E O : Type}
    (event : CircularCopyEvent D S AS AD R L Z F H HS B M E O) (error : Sum Error E) : Prop :=
  circularCopyEventError event = some error ∨
  (match event with
   | .different _ _ (.ok (.inr _)) | .all _ (.ok (.inr _)) => error = .inl .typeError
   | .exception _ (.ok actual) => error = actual
   | _ => False)

/-- Independently enumerated branch language and actual-value dataflow. A
mismatch constructs its exception only after interpolation; a no-shift answer
selects direct copy, and a shifted answer retains both original references
and actual axes in the recursive call. No leaf purity or correctness law is
assumed, and all prior mutations survive the first failure. -/
def CircularCopyTerminal {W D S AS AD R L Z F H HS B M E O : Type}
    (ops : CircularCopyOps (ConstructorObservationM E W) D S AS AD R L Z F H HS B M E O)
    (destination : D) (source : S) (initial final : W) (reply : Except (Sum Error E) O)
    (records : List (W × W × CircularCopyEvent D S AS AD R L Z F H HS B M E O)) : Prop :=
  if ops.same destination source then
    records = [] ∧ final = initial ∧ reply = .error (.inl (.argumentError "dest and src must be separate arrays"))
  else
    let events := records.map (fun record => record.2.2)
    let phases := events.map circularCopyPhase
    ConstructorStateThread initial final records ∧ CircularCopyArguments destination source events ∧
    (phases.IsPrefix [0, 1, 2, 3, 4, 5, 6] ∨ phases.IsPrefix [0, 1, 2, 3, 4, 7, 8, 9] ∨
      phases.IsPrefix [0, 1, 2, 3, 4, 7, 8, 10]) ∧
    (∀ event ∈ events, ∀ error, CircularCopyFinalError event error →
      events.getLast? = some event ∧ reply = .error error) ∧
    match reply with
    | .ok value =>
        (events.getLast? = some (.copy destination source (.ok value))) ∨
        ∃ destinationAxes sourceAxes,
          events.getLast? = some (.recursive destination () destinationAxes source () sourceAxes (.ok value))
    | .error error => ∃ event, events.getLast? = some event ∧ CircularCopyFinalError event error

/-- Full Any source/destination domain, nonstandard or malformed axes and map
returns, arbitrary custom predicates, shared aliases, first errors and state.
Core identity rejection runs before axes, and both size maps finish before the
inequality branch. The message constructor may itself return any thrown value.
Source: base/multidimensional.jl:1337-1346. -/
def CircularCopyObservations : Prop :=
  ∀ (W D S AS AD R L Z F H HS B M E O : Type)
    (ops : CircularCopyOps (ConstructorObservationM E W) D S AS AD R L Z F H HS B M E O)
    (destination : D) (source : S) (initial : W),
    match (circularCopyGeneric (observeCircularCopyOps ops) destination source).run (initial, []) with
    | none => True
    | some (reply, (final, records)) => CircularCopyTerminal ops destination source initial final reply records

/-- Actual shift-closure order and intermediate values are checked separately
from selected map implementations. The two reads may observe different state,
even when both range arguments alias the same object. -/
def CircularShiftObservations : Prop :=
  ∀ (W D S AS AD R L Z F H HS B M E O : Type)
    (ops : CircularCopyOps (ConstructorObservationM E W) D S AS AD R L Z F H HS B M E O)
    (source destination : R) (initial : W),
    match (circularCopyShift (observeCircularCopyOps ops) source destination).run (initial, []) with
    | none => True
    | some (reply, (final, records)) =>
        ConstructorStateThread initial final records ∧
        match (records.map (fun record => record.2.2) : List (CircularCopyEvent D S AS AD R L Z F H HS B M E O)) with
        | [.first actual (.error error)] => actual = source ∧ reply = .error error
        | [.first actualSource (.ok left), .first actualDestination (.error error)] =>
            actualSource = source ∧ actualDestination = destination ∧ reply = .error error
        | [.first actualSource (.ok left), .first actualDestination (.ok right),
            .subtract actualLeft actualRight result] =>
            actualSource = source ∧ actualDestination = destination ∧
            actualLeft = left ∧ actualRight = right ∧ reply = result
        | _ => False

theorem circularShiftObservations_proven :
    Models2Group3.CircularShiftObservations := by
  intro W D S AS AD R L Z F H HS B M E O ops source destination initial
  unfold Models2Group3.circularCopyShift Models2Group3.observeCircularCopyOps
  dsimp only
  rw [observeConstructorAction_bind_run]
  cases (ops.first source).run initial with
  | none => trivial
  | some p1 =>
      rcases p1 with ⟨r1, s1⟩
      cases r1 with
      | error e =>
          refine ⟨⟨rfl, ?_, ?_⟩, rfl, rfl⟩
          · intro r hr; injection hr with hr; subst hr; rfl
          · intro k l r hl hr; cases k with | zero => cases hr | succ k => cases hl
      | ok left =>
          dsimp only
          rw [observeConstructorAction_bind_run]
          cases (ops.first destination).run s1 with
          | none => trivial
          | some p2 =>
              rcases p2 with ⟨r2, s2⟩
              cases r2 with
              | error e =>
                  refine ⟨⟨rfl, ?_, ?_⟩, rfl, rfl, rfl⟩
                  · intro r hr; injection hr with hr; subst hr; rfl
                  · intro k l r hl hr
                    cases k with
                    | zero => injection hl with hl; injection hr with hr; subst hl hr; rfl
                    | succ k => cases k with | zero => cases hr | succ k => cases hl
              | ok right =>
                  dsimp only
                  rw [observeConstructorAction_run]
                  cases (ops.subtract left right).run s2 with
                  | none => trivial
                  | some p3 =>
                      rcases p3 with ⟨r3, s3⟩
                      refine ⟨⟨rfl, ?_, ?_⟩, rfl, rfl, rfl, rfl, rfl⟩
                      · intro r hr; injection hr with hr; subst hr; rfl
                      · intro k l r hl hr
                        cases k with
                        | zero => injection hl with hl; injection hr with hr; subst hl hr; rfl
                        | succ k =>
                            cases k with
                            | zero => injection hl with hl; injection hr with hr; subst hl hr; rfl
                            | succ k => cases k with | zero => cases hr | succ k => cases hl

/-- The all predicate always compares the actual shift to native Int zero,
retaining raw equality returns, exceptions and mutation without assertion.
Source: base/multidimensional.jl:1344. -/
def CircularZeroPredicateObservations : Prop :=
  ∀ (W D S AS AD R L Z F H HS B M E O : Type)
    (ops : CircularCopyOps (ConstructorObservationM E W) D S AS AD R L Z F H HS B M E O)
    (shift : H) (initial : W),
    match (circularCopyZero (observeCircularCopyOps ops) shift).run (initial, []) with
    | none => True
