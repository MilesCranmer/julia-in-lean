def Arity {BigRef Custom : Type} : MixedIndex BigRef Custom → Nat
  | .integer _ => 1
  | .cartesian coordinates => coordinates.length

/-- Every successful selected Base mixed conversion has the documented number
of output tuple slots. This includes array-valued custom conversion results:
each occupies one slot. The whole protocol input domain is quantified, with no
assumed conversion law; the next property supplies a nonvacuous failure/effect
contract. Both the source928 body and complete inherited Base dispatch satisfy
the invariant. Source: base/indices.jl:274-278; multidimensional.jl:928,932-935.
-/
def SuccessArity : Prop :=
  ∀ (State ARef BigRef Ptr Custom Value : Type)
    (runtime : MixedIndexRuntime (Effects State) ARef BigRef Ptr Custom Value)
    (array : MixedArray ARef) (indices : List (MixedIndex BigRef Custom))
    (initial final : State) (output : List Value),
    (observe (toIndicesMixedClosed runtime array indices) initial = (.ok output, final) ∨
     observe (toIndicesMixedDispatch runtime array indices) initial = (.ok output, final)) →
    output.length = (indices.map Arity).sum

/-- Appending more indices after an already failing prefix cannot change the
exception or the state reached at failure. This quantifies over all custom
effects and mutable BigInt read behaviors, rather than assuming purity or a
conversion law. It detects evaluating any later suffix after the first error.
Both source928's selected body and its outer Base dispatch obey the law.
Source: base/indices.jl:322-323; base/multidimensional.jl:928,932-935.
-/
def FailurePrefix : Prop :=
  ∀ (State ARef BigRef Ptr Custom Value : Type)
    (runtime : MixedIndexRuntime (Effects State) ARef BigRef Ptr Custom Value)
    (array : MixedArray ARef) (earlier suffix : List (MixedIndex BigRef Custom))
    (initial final : State) (error : Error),
    (observe (toIndicesMixedClosed runtime array earlier) initial = (.error error, final) →
      observe (toIndicesMixedClosed runtime array (earlier ++ suffix)) initial =
        (.error error, final)) ∧
    (observe (toIndicesMixedDispatch runtime array earlier) initial = (.error error, final) →
      observe (toIndicesMixedDispatch runtime array (earlier ++ suffix)) initial =
        (.error error, final))

/-- The original all-machine-Int tuple is unchanged by the more-specific outer
method and causes no runtime effect. `encodeInt` is used only as the supplied
representation embedding; no decoding/injectivity property is assumed.
Arbitrary custom array/index operations and BigInt state are quantified but
must never be invoked in this dispatch case. Source: base/indices.jl:319.
-/
def MachineIntBypass : Prop :=
  ∀ (State ARef BigRef Ptr Custom Value : Type)
    (runtime : MixedIndexRuntime (Effects State) ARef BigRef Ptr Custom Value)
    (array : MixedArray ARef) (values : CI) (initial : State),
    observe (toIndicesMixedDispatch runtime array
      (values.map (fun value => MixedIndex.integer (MixedInteger.bits .i64 value)))) initial =
      (.ok (values.map runtime.encodeInt), initial)

/-- Mixed Integer/Cartesian conversion has no bounds or shape dependence:
replacing the dimensional-indices tuple changes neither result/error nor final
state, for every possible custom runtime protocol. This is a relational
invariance statement, not an equality to a copy of the implementation body.
Source: base/indices.jl:297,306,321-323; multidimensional.jl:928,932-935.
-/
def AxesIrrelevance : Prop :=
  ∀ (State ARef BigRef Ptr Custom Value Axis : Type)
    (runtime : MixedIndexRuntime (Effects State) ARef BigRef Ptr Custom Value)
    (array : MixedArray ARef) (indices : List (MixedIndex BigRef Custom))
    (leftAxes rightAxes : List Axis) (initial : State),
    observe (toIndicesMixedAux runtime array leftAxes indices) initial =
      observe (toIndicesMixedAux runtime array rightAxes indices) initial

/-- The independent tuple expansion described by the CartesianIndex indexing
example in base/indices.jl:300-301. It names expected runtime conversion inputs;
it performs no conversion and has no effect/error implementation.
-/
def ExpandedInputs {BigRef Custom : Type} (indices : List (MixedIndex BigRef Custom)) :
    List (MixedInteger BigRef Custom) :=
  indices.flatMap fun input =>
    match input with
    | .integer value => [value]
    | .cartesian coordinates => coordinates.map (MixedInteger.bits .i64)

/-- Concrete documented custom-array extension for observing sequencing. Each
conversion records its original tagged input, then optionally fails at a chosen
zero-based call ordinal; otherwise it returns the valid machine-Int index zero.
The state is retained even when that custom conversion throws. Ordinary BigInt
or custom-one-argument fallbacks deliberately fail if the model incorrectly
invokes them despite the selected custom-array overload. This is an executable
test protocol, not a supplied correctness law.
Source extension boundary: base/indices.jl:232-243,274-282.
-/
def RecordingRuntime {BigRef Custom : Type} (failAt : Option Nat) (failure : Error) :
    MixedIndexRuntime (Effects (List (MixedInteger BigRef Custom)))
      Unit BigRef Unit Custom I64 where
  encodeInt := id
  bigInteger := {
    readSize := fun _ => throw (.methodError "unexpected BigInt size read")
    readData := fun _ => throw (.methodError "unexpected BigInt pointer read")
    loadLimb := fun _ => throw (.methodError "unexpected BigInt limb load") }
  customInteger := fun _ => throw (.methodError "unexpected one-argument fallback")
  extension := fun _ input => some do
    let previous ← get
    set (previous ++ [input])
    if failAt = some previous.length then throw failure
    return int 0

/-- Every input in a mixed tuple reaches custom scalar conversion in its
documented expanded order, including original machine Int values and coordinates
after a zero-dimensional CartesianIndex. A chosen failing call is the final
observed call, with its recorded state retained. Success returns one index zero
per observed conversion. This checks arbitrary input tuples, all integer tags,
every possible failure ordinal and every exception class, using a concrete
allowed custom extension instead of a correctness assumption.
Source: base/indices.jl:274-282,300-301; multidimensional.jl:928,932-935.
-/
def ConversionOrderAndFailure : Prop :=
  ∀ (BigRef Custom : Type) (indices : List (MixedIndex BigRef Custom))
    (failAt : Option Nat) (failure : Error),
    let expected := ExpandedInputs indices
    let actual := observe
      (toIndicesMixedClosed (RecordingRuntime failAt failure) (.other ()) indices) []
    match failAt with
    | some ordinal =>
        if ordinal < expected.length then
          actual = (.error failure, expected.take (ordinal + 1))
        else
          actual = (.ok (List.replicate expected.length (int 0)), expected)
    | none => actual = (.ok (List.replicate expected.length (int 0)), expected)

end MixedIndices


abbrev BitArrayFields := JuliaLean.base.multidimensional.Models1Group6.BitArrayFields

/-- Mathematical dimension observations, independently projected from the
rank and stored fields. Dimension numbers here are zero-based specification
indices, not Julia machine-integer arithmetic. -/
def BitDimensionValue {rank : Nat} (B : BitArrayFields rank) (dimension : Nat) : Int :=
  if rank = 1 then
    if dimension = 0 then B.len.val else 1
  else
    match B.storedDims.val[dimension]? with
    | some value => value.val
    | none => 1

/-- Closed-form column-major address before reducing modulo the Int64 modulus.
The specification uses products and a sum of mathematical integers, rather
than the model's sequential wrapped stride/index updates. -/
def BitExactLinearIndex {rank : Nat} (B : BitArrayFields rank) (I0 : I64) (I : CI) : Int :=
  I0.val + (I.zipIdx.map (fun (coordinate, dimension) =>
    (coordinate.val - 1) *
      ((List.range (dimension + 1)).map (BitDimensionValue B)).prod)).sum

/-- The generated loop checks every index except the final supplied index
against the corresponding dimension. The final scalar query tests only the
wrapped linear address. This aggregate condition is independent of the loop. -/
def BitLeadingCoordinatesWithin {rank : Nat} (B : BitArrayFields rank)
    (I0 : I64) (I : CI) : Bool :=
  (((I0 :: I).take I.length).zipIdx).all (fun (coordinate, dimension) =>
    decide (1 ≤ coordinate.val ∧ coordinate.val ≤ BitDimensionValue B dimension))

/-- Exact full-field-domain protocol invariant, including mutable BitArray
metadata with negative or inconsistent stored lengths/dimensions. Only the
actual machine-size invariant on Julia tuple arity is imposed. Size lookup
must succeed for every generated positive dimension; the address agrees
with the mathematical column-major sum modulo 2^64.
Source: base/multidimensional.jl:1621-1635; base/bitarray.jl:102-106. -/
def BitAssignedModularProtocol : Prop :=
  ∀ (rank : Nat) (B : BitArrayFields rank) (I0 : I64) (I : CI),
    (rank : Int) ≤ IntTy.max .i64 → (I.length : Int) ≤ IntTy.max .i64 →
    JuliaLean.base.multidimensional.Models1Group6.bitArrayIsassigned B I0 I =
      .ok (BitLeadingCoordinatesWithin B I0 I &&
        decide (1 ≤ wrapInt .i64 (BitExactLinearIndex B I0 I) ∧
          wrapInt .i64 (BitExactLinearIndex B I0 I) ≤ B.len.val))

/-- The same aggregate native-field invariant in both compiler contexts.
Erasing @boundscheck removes the leading-coordinate predicate alone; it does
not remove size reads, wrapped stride/address calculations or the final scalar
isassigned comparison, which is not a boundscheck annotation.
Source: base/multidimensional.jl:1621-1635; base/bitarray.jl:106. -/
def BitAssignedCompilerContextProtocol : Prop :=
  ∀ (rank : Nat) (B : BitArrayFields rank) (I0 : I64) (I : CI)
    (boundsChecks : Bool),
    (rank : Int) ≤ IntTy.max .i64 → (I.length : Int) ≤ IntTy.max .i64 →
    JuliaLean.base.multidimensional.Models1Group6.bitArrayIsassigned B I0 I boundsChecks =
      .ok ((!boundsChecks || BitLeadingCoordinatesWithin B I0 I) &&
        decide (1 ≤ wrapInt .i64 (BitExactLinearIndex B I0 I) ∧
          wrapInt .i64 (BitExactLinearIndex B I0 I) ≤ B.len.val))

/-- Mathematical shape of the bit array. Rank-one size is tied to `len`,
including the constructor's intentionally unused stored dimension tuple. -/
def BitShapeValues {rank : Nat} (B : BitArrayFields rank) : List Int :=
  if rank = 1 then [B.len.val] else B.storedDims.val.map (·.val)

