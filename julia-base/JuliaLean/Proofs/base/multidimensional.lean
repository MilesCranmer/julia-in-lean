 theorem mix7_oneTo_nonneg (stop : I64) (h : 0 ≤ stop.val) :
    rangeOneTo stop = .ok (.oneTo ⟨stop⟩) := by
  change Except.ok (OrdinalRange64.oneTo ⟨if JuliaLean.base.int.ltSame (int 0) stop then stop else int 0⟩) = _
  rw [scalar7_ltSame]
  change Except.ok (OrdinalRange64.oneTo ⟨if decide (0 < stop.val) then stop else int 0⟩) = _
  by_cases hp : 0 < stop.val
  · simp only [hp, decide_true, ite_true]
  · have hz : stop = int 0 := by
      apply Subtype.ext
      change stop.val = 0
