def ctor7_machineCount (axis : OrdinalRange64) : I64 :=
  match rangeLength axis with
  | .ok count => count
  | .error _ => int 0

def ctor7_machineAxes (array : Region64) : Region64 :=
  array.map (fun axis => .oneTo ⟨ctor7_machineCount axis⟩)

def ctor7_CountSpec : Prop :=
  ∀ axis : OrdinalRange64, RangeConstructible axis →
    ∃ count : I64, rangeLength axis = .ok count ∧ MachineAxisCount axis count

theorem ctor7_count_correct (hcount : ctor7_CountSpec) (axis : OrdinalRange64)
    (ha : RangeConstructible axis) :
    rangeLength axis = .ok (ctor7_machineCount axis) ∧ MachineAxisCount axis (ctor7_machineCount axis) := by
  obtain ⟨count, hrun, hspec⟩ := hcount axis ha
  have hc : ctor7_machineCount axis = count := by simp only [ctor7_machineCount, hrun]
  rw [hc]
  exact ⟨hrun, hspec⟩

theorem ctor7_mapM_ok {α β ε : Type} (f : α → Except ε β) (g : α → β)
    (xs : List α) (h : ∀ x ∈ xs, f x = .ok (g x)) : xs.mapM f = .ok (xs.map g) := by
  induction xs with
  | nil => rfl
  | cons x xs ih =>
    simp only [List.mapM_cons, h x List.mem_cons_self,
      ih (fun y hy => h y (List.mem_cons_of_mem x hy)), List.map_cons]
    rfl

theorem ctor7_axes_run (hcount : ctor7_CountSpec) (array : Region64)
    (ha : ∀ axis ∈ array, RangeConstructible axis) :
    regionAxes array = .ok (ctor7_machineAxes array) := by
  apply ctor7_mapM_ok
  intro axis haxis
  unfold regionRangeAxis
  rw [(ctor7_count_correct hcount axis (ha axis haxis)).1]
  rfl

theorem ctor7_axes_domain (array : Region64) (ha : RegionDomain array) :
    RegionDomain (ctor7_machineAxes array) := by
  constructor
  · simpa only [TupleFits, ctor7_machineAxes, List.length_map] using ha.1
  · intro axis haxis
    obtain ⟨original, _, rfl⟩ := List.mem_map.mp haxis
    trivial

theorem ctor7_axes_geometry (hcount : ctor7_CountSpec) (array : Region64)
    (ha : ∀ axis ∈ array, RangeConstructible axis) :
    ArrayAxisGeometry array (ctor7_machineAxes array) := by
  refine ⟨by simp only [ctor7_machineAxes, List.length_map], ?_⟩
  intro k axis hk
  refine ⟨ctor7_machineCount axis, ?_, ?_⟩
  · simp only [ctor7_machineAxes, List.getElem?_map, hk, Option.map_some]
  · exact (ctor7_count_correct hcount axis (ha axis (List.mem_of_getElem? hk))).2

theorem ctor7_array_indices_from_counts (hcount : ctor7_CountSpec) :
    RegionArrayIndicesCorrect := by
  intro array ha
  have haxes := ctor7_axes_run hcount array ha.2
  have hd := ctor7_axes_domain array ha
  have hg := ctor7_axes_geometry hcount array ha.2
  constructor
  · unfold regionFromArray
    rw [haxes]
    simpa only [regionFromRanges, List.map_id, Bind.bind, Except.bind] using And.intro hd hg
  · unfold eachindexRegion
    rw [haxes]
    simpa only [regionFromRanges, List.map_id, Bind.bind, Except.bind] using And.intro hd hg


def ctor7_counts (array : Region64) : CI := array.map ctor7_machineCount

theorem ctor7_shape_cons (a b : OrdinalRange64) (as bs : Region64) :
    MatchingArrayShapes (a :: as) (b :: bs) ↔
      (∃ count, MachineAxisCount a count ∧ MachineAxisCount b count) ∧
      MatchingArrayShapes as bs := by
  constructor
  · intro h
    refine ⟨h.2 0 a b rfl rfl, ⟨Nat.succ.inj h.1, ?_⟩⟩
    intro k x y hx hy
    exact h.2 (k + 1) x y hx hy
  · intro h
    refine ⟨congrArg Nat.succ h.2.1, ?_⟩
    intro k x y hx hy
    cases k with
    | zero =>
      change some a = some x at hx
      change some b = some y at hy
      cases Option.some.inj hx
      cases Option.some.inj hy
      exact h.1
    | succ k => exact h.2.2 k x y hx hy

theorem ctor7_matching_counts (hcount : ctor7_CountSpec) (a b : Region64)
    (ha : ∀ axis ∈ a, RangeConstructible axis)
    (hb : ∀ axis ∈ b, RangeConstructible axis) :
    MatchingArrayShapes a b ↔ ctor7_counts a = ctor7_counts b := by
  induction a generalizing b with
  | nil =>
    cases b with
    | nil =>
      constructor
      · intro h; rfl
      · intro h
        refine ⟨rfl, ?_⟩
        intro k x y hx hy
        simp only [List.getElem?_nil] at hx
        cases hx
    | cons b bs =>
      constructor
      · intro h
        have hl := h.1
        simp only [List.length_nil, List.length_cons] at hl
        omega
      · intro h
        cases h
  | cons a as ih =>
    cases b with
    | nil =>
      constructor
      · intro h
        have hl := h.1
        simp only [List.length_nil, List.length_cons] at hl
        omega
      · intro h
        cases h
    | cons b bs =>
      rw [ctor7_shape_cons]
      change ((∃ count, MachineAxisCount a count ∧ MachineAxisCount b count) ∧
          MatchingArrayShapes as bs) ↔
        ctor7_machineCount a :: ctor7_counts as = ctor7_machineCount b :: ctor7_counts bs
      have has := fun x hx => ha x (List.mem_cons_of_mem a hx)
      have hbs := fun x hx => hb x (List.mem_cons_of_mem b hx)
      have hca := (ctor7_count_correct hcount a (ha a List.mem_cons_self)).2
      have hcb := (ctor7_count_correct hcount b (hb b List.mem_cons_self)).2
      constructor
      · intro h
        obtain ⟨count, hleft, hright⟩ := h.1
        have hma := scalar7_count_unique (axis := a) hca hleft
        have hmb := scalar7_count_unique (axis := b) hcb hright
        have ht := (ih bs has hbs).mp h.2
        rw [hma, hmb, ht]
      · intro h
        have he := List.cons.inj h
        refine ⟨⟨ctor7_machineCount a, hca, ?_⟩, (ih bs has hbs).mpr he.2⟩
        rw [he.1]
        exact hcb


def ctor7_EqualSpec : Prop :=
  ∀ x y : I64, JuliaLean.base.int.eqSame x y = decide (x.val = y.val)

theorem ctor7_oneToRangeEq (heq : ctor7_EqualSpec) (x y : I64) :
    rangeEqual64 (.oneTo ⟨x⟩) (.oneTo ⟨y⟩) = .ok (decide (x = y)) := by
  change (Except.ok (JuliaLean.base.int.eqSame x y) : RegionResult Bool) = _
  rw [heq]
  simp only [Subtype.ext_iff]

theorem ctor7_regionEqual_cons (a b : OrdinalRange64) (as bs : Region64) :
    regionEqual (a :: as) (b :: bs) =
      (do let equalHead ← rangeEqual64 a b
          let equalTail ← regionEqual as bs
          pure (equalHead && equalTail)) := by
  unfold regionEqual
  simp only [List.zip_cons_cons, List.mapM_cons]
  cases hh : rangeEqual64 a b <;>
    cases ht : (as.zip bs).mapM (fun (x, y) => rangeEqual64 x y) <;> rfl

theorem ctor7_onetoRegionEq (heq : ctor7_EqualSpec) (xs ys : CI)
    (hlen : xs.length = ys.length) :
    regionEqual (xs.map (fun x => .oneTo ⟨x⟩)) (ys.map (fun y => .oneTo ⟨y⟩)) =
      .ok (decide (xs = ys)) := by
  induction xs generalizing ys with
  | nil =>
    cases ys with
    | nil => rfl
    | cons y ys => simp only [List.length_nil, List.length_cons] at hlen; omega
  | cons x xs ih =>
    cases ys with
    | nil => simp only [List.length_nil, List.length_cons] at hlen; omega
    | cons y ys =>
      simp only [List.map_cons]
      rw [ctor7_regionEqual_cons, ctor7_oneToRangeEq heq, ih ys (Nat.succ.inj hlen)]
      change (Except.ok (decide (x = y) && decide (xs = ys)) : RegionResult Bool) = _
      simp only [List.cons.injEq, Bool.decide_and]

theorem ctor7_machineAxes_counts (array : Region64) :
    ctor7_machineAxes array = (ctor7_counts array).map (fun count => .oneTo ⟨count⟩) := by
  simp only [ctor7_machineAxes, ctor7_counts, List.map_map]
  rfl

theorem ctor7_compare_axes (heq : ctor7_EqualSpec) (array other : Region64) :
    (if (ctor7_machineAxes other).length != (ctor7_machineAxes array).length then
      (.ok false : RegionResult Bool)
     else regionEqual (ctor7_machineAxes other) (ctor7_machineAxes array)) =
      .ok (decide (ctor7_counts array = ctor7_counts other)) := by
  rw [ctor7_machineAxes_counts other, ctor7_machineAxes_counts array]
  simp only [List.length_map]
  by_cases hlen : (ctor7_counts other).length = (ctor7_counts array).length
  · rw [bne_eq_false_iff_eq.mpr hlen]
    simpa only [Bool.false_eq_true, ↓reduceIte, eq_comm] using
      ctor7_onetoRegionEq heq (ctor7_counts other) (ctor7_counts array) hlen
  · have hbne : ((ctor7_counts other).length != (ctor7_counts array).length) = true :=
      bne_iff_ne.mpr hlen
    have hne : ctor7_counts array ≠ ctor7_counts other := by
      intro h
      exact hlen (congrArg List.length h.symm)
    simp only [hbne, ↓reduceIte, hne, decide_false]

theorem ctor7_allM_map_ok {α β ε : Type} (xs : List α) (g : α → β)
    (f : β → Except ε Bool) (p : α → Bool)
    (h : ∀ x ∈ xs, f (g x) = .ok (p x)) :
    (xs.map g).allM f = .ok (xs.all p) := by
  induction xs with
  | nil => rfl
  | cons x xs ih =>
    simp only [List.map_cons, List.allM_cons, List.all_cons]
    rw [h x List.mem_cons_self]
    have ht := ih (fun y hy => h y (List.mem_cons_of_mem x hy))
    cases hp : p x with
    | false => simp only [hp, Bool.false_and]; rfl
    | true => simp only [hp, Bool.true_and]; exact ht

theorem ctor7_arrays_eachindex_from_counts (hcount : ctor7_CountSpec)
    (heq : ctor7_EqualSpec) : RegionArraysEachindexCorrect := by
  intro array others ha _ hothers
  have haxes := ctor7_axes_run hcount array ha.2
  have hmore : others.mapM regionAxes = .ok (others.map ctor7_machineAxes) := by
    apply ctor7_mapM_ok
    intro other ho
    exact ctor7_axes_run hcount other (hothers other ho).2
  have hall :
      (others.map ctor7_machineAxes).allM (fun (axsB : Region64) =>
        if axsB.length != (ctor7_machineAxes array).length then (.ok false : RegionResult Bool)
        else regionEqual axsB (ctor7_machineAxes array)) =
      .ok (others.all (fun other => decide (ctor7_counts array = ctor7_counts other))) := by
    apply ctor7_allM_map_ok
    intro other ho
    exact ctor7_compare_axes heq array other
  have hmatching :
      others.all (fun other => decide (ctor7_counts array = ctor7_counts other)) = true ↔
        ∀ other ∈ others, MatchingArrayShapes array other := by
    rw [List.all_eq_true]
    constructor
    · intro h other ho
      exact (ctor7_matching_counts hcount array other ha.2 (hothers other ho).2).mpr
        (of_decide_eq_true (h other ho))
    · intro h other ho
      exact decide_eq_true
        ((ctor7_matching_counts hcount array other ha.2 (hothers other ho).2).mp (h other ho))
  unfold eachindexRegions
  rw [haxes, hmore]
  change (match (do
    let equal ← (others.map ctor7_machineAxes).allM (fun (axsB : Region64) =>
      if axsB.length != (ctor7_machineAxes array).length then (.ok false : RegionResult Bool)
      else regionEqual axsB (ctor7_machineAxes array))
    if !equal then throw (JuliaLean.base.range.Exc.dimensionMismatch "all inputs to eachindex must have the same axes")
    regionFromRanges (ctor7_machineAxes array) : RegionResult Region64) with
    | .ok axes => (∀ other ∈ others, MatchingArrayShapes array other) ∧
        RegionDomain axes ∧ ArrayAxisGeometry array axes
    | .error (.dimensionMismatch _) => ¬ (∀ other ∈ others, MatchingArrayShapes array other)
    | .error _ => False)
  rw [hall]
  cases hsame : others.all (fun other => decide (ctor7_counts array = ctor7_counts other)) with
  | false =>
    change ¬ (∀ other ∈ others, MatchingArrayShapes array other)
    intro h
    have ht := hmatching.mpr h
    rw [hsame] at ht
    cases ht
  | true =>
    simp only [regionFromRanges, List.map_id]
    exact ⟨hmatching.mp hsame, ctor7_axes_domain array ha, ctor7_axes_geometry hcount array ha.2⟩

end Models1Group5.Batch9

