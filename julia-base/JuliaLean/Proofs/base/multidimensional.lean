contents and allocation outcomes are absent because assignment queries never
read or allocate chunks. -/
def BitConstructorMetadata {rank : Nat} (B : BitArrayFields rank) : Prop :=
  (rank : Int) ≤ IntTy.max .i64 ∧
  (∀ size ∈ BitShapeValues B, 0 ≤ size) ∧
  JuliaLean.base.array.checkedDims (m := Except JuliaLean.base.array.Error)
    ((BitShapeValues B).map (JInt.wrap .i64)) = .ok B.len

/-- Independent documented indexing domain: a sole index is linear; multiple
indices address their corresponding axes, may omit only trailing singleton
axes, and may add only coordinates one beyond the array rank. -/
def BitDocumentedBounds {rank : Nat} (B : BitArrayFields rank) (I0 : I64) (I : CI) : Bool :=
  if I.isEmpty then decide (1 ≤ I0.val ∧ I0.val ≤ B.len.val)
  else
    let shape := BitShapeValues B
    let coordinates := I0 :: I
    (shape.zip coordinates).all (fun pair =>
      decide (1 ≤ pair.2.val ∧ pair.2.val ≤ pair.1)) &&
    (coordinates.drop shape.length).all (fun coordinate => decide (coordinate.val = 1)) &&
    (shape.drop coordinates.length).all (fun size => decide (size = 1))

