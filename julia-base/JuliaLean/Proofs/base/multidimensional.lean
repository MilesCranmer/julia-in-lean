/-- Actual runtime calls and their replies. Values can be arbitrary Julia
objects, including mutable references and arbitrary thrown objects. -/
inductive FlattenEvent (Value : Type) where
  | constructor (argument : Value) (reply : Except Value Value)
  | customTail (arguments : List Value) (reply : Except Value Value)
  | splat (iterator : Value) (arguments : List Value) (reply : Except Value Value)

/-- User/runtime operations see only their world. State remains outside the
exception layer, so mutations before a throw remain observable. Option also
allows actual nontermination of a selected call or splat. -/
abbrev FlattenPrimitive (World Value : Type) := ExceptT Value (StateT World Option)

/-- Audit fields are inaccessible to runtime operations. The separate copy of
the last primitive world detects discarded state even on exceptional returns. -/
structure FlattenAudit (World Value : Type) where
  world : World
  events : List (FlattenEvent Value) := []
  lastWorld : Option World := none

abbrev FlattenObserved (World Value : Type) :=
  ExceptT Value (StateT (FlattenAudit World Value) Option)

/-- Instrument one original operation without changing its input, outcome,
or world effects. No property of the operation is assumed. -/
def flattenObserve {World Value A : Type}
    (primitive : FlattenPrimitive World Value A)
    (record : Except Value A → FlattenEvent Value) : FlattenObserved World Value A :=
  ExceptT.mk fun audit => do
    let (reply, nextWorld) ← primitive.run audit.world
    pure (reply,
      { world := nextWorld, events := audit.events ++ [record reply], lastWorld := some nextWorld })

/-- The genuine constructor dispatch and existing Core primitive are observed;
this wrapper supplies neither a flatten algorithm nor a callee correctness law. -/
def flattenObserveOps {World Value : Type}
    (ops : FlattenOps (FlattenPrimitive World Value) Value) :
    FlattenOps (FlattenObserved World Value) Value where
  tupleConstructor := fun value =>
    flattenObserve (ops.tupleConstructor value) (.constructor value)
  recursiveExtension := fun arguments =>
    (ops.recursiveExtension arguments).map fun action =>
      flattenObserve action (.customTail arguments)
  applyIterate := fun iterator arguments =>
    flattenObserve (ops.applyIterate iterator arguments) (.splat iterator arguments)
  coreTuple := ops.coreTuple
  baseIterate := ops.baseIterate
  emptyTuple := ops.emptyTuple

/-- One observed Core splat call. -/
structure FlattenSplatObservation (Value : Type) where
  iterator : Value
  arguments : List Value
  reply : Except Value Value

def flattenConstructorObservations {Value : Type} (events : List (FlattenEvent Value)) :
    List (Value × Except Value Value) :=
  events.filterMap fun event => match event with
    | .constructor argument reply => some (argument, reply)
    | .customTail _ _ => none
    | .splat _ _ _ => none

def flattenTailObservations {Value : Type} (events : List (FlattenEvent Value)) :
    List (List Value × Except Value Value) :=
  events.filterMap fun event => match event with
    | .customTail arguments reply => some (arguments, reply)
    | .constructor _ _ => none
    | .splat _ _ _ => none

def flattenSplatObservations {Value : Type} (events : List (FlattenEvent Value)) :
    List (FlattenSplatObservation Value) :=
  events.filterMap fun event => match event with
    | .constructor _ _ => none
    | .customTail _ _ => none
    | .splat iterator arguments reply => some ⟨iterator, arguments, reply⟩

def flattenEventReply {Value : Type} : FlattenEvent Value → Except Value Value
  | .constructor _ reply => reply
  | .customTail _ reply => reply
  | .splat _ _ reply => reply

/-- Independent indexed data-flow condition for splats. Without a custom tail
call, the last constructor result is the innermost tail; otherwise the actual
custom result is that tail. The remaining original constructor results become
heads in reverse order. Subsequent tails are the immediately preceding splat's
returned value. This tests positional assembly without recomputing flatten or
assuming that any constructor or custom-tail result is a tuple. -/
def FlattenSplatArguments {Value : Type} (tupleFunction iterateFunction : Value)
    (conversions : List (Value × Except Value Value))
    (customTails : List (List Value × Except Value Value))
    (splats : List (FlattenSplatObservation Value)) : Prop :=
  let headCount := match customTails with
    | [] => conversions.length - 1
    | _ :: _ => conversions.length
  ∀ (k : Nat) (call : FlattenSplatObservation Value), splats[k]? = some call →
    call.iterator = iterateFunction ∧
    ∃ (head tail original : Value),
      call.arguments = [tupleFunction, head, tail] ∧
      conversions[headCount - (k + 1)]? = some (original, .ok head) ∧
      (if k = 0 then
         match customTails with
         | [] => ∃ last, conversions.getLast? = some (last, .ok tail)
         | [call] => call.2 = .ok tail
         | _ => False
       else ∃ previous, splats[k - 1]? = some previous ∧ previous.reply = .ok tail)

/-- A terminal observation must retain the source's phase ordering, original
arguments, right-associated data flow, call counts and final mutation. The
failure alternative identifies an actually observed primitive failure rather
than permitting an invented exception or assuming successful callees. -/
def FlattenTerminalObservation {World Value : Type}
    (ops : FlattenOps (FlattenPrimitive World Value) Value)
    (input : List Value) (initial : World) (result : Except Value Value)
    (audit : FlattenAudit World Value) : Prop :=
  let conversions := flattenConstructorObservations audit.events
  let customTails := flattenTailObservations audit.events
  let splats := flattenSplatObservations audit.events
  (conversions.map Prod.fst).IsPrefix input ∧
  customTails.length ≤ 1 ∧
  (∀ arguments reply, customTails = [(arguments, reply)] →
    arguments = input.drop conversions.length ∧
    0 < conversions.length ∧ conversions.length < input.length) ∧
  audit.events =
    (conversions.map fun call => .constructor call.1 call.2) ++
    (customTails.map fun call => .customTail call.1 call.2) ++
    (splats.map fun call => .splat call.iterator call.arguments call.reply) ∧
  splats.length ≤ input.length - 1 ∧
  (splats ≠ [] → customTails = [] → conversions.map Prod.fst = input) ∧
  FlattenSplatArguments ops.coreTuple ops.baseIterate conversions customTails splats ∧
  (∀ event ∈ audit.events, ∀ error,
    flattenEventReply event = .error error →
      audit.events.getLast? = some event ∧ result = .error error) ∧
  (match audit.lastWorld with
   | none => audit.world = initial ∧ audit.events = []
   | some lastWorld => audit.world = lastWorld) ∧
  match result with
  | .ok returned =>
      (∀ event ∈ audit.events, ∃ value, flattenEventReply event = .ok value) ∧
      match customTails with
      | [] =>
          conversions.map Prod.fst = input ∧
          splats.length = input.length - 1 ∧
          match input with
          | [] => returned = ops.emptyTuple ∧ audit.events = []
          | _ :: _ =>
              match splats with
              | [] => ∃ original, conversions.getLast? = some (original, .ok returned)
              | _ :: _ => ∃ call, splats.getLast? = some call ∧ call.reply = .ok returned
      | [_] =>
          splats.length = conversions.length ∧
          ∃ call, splats.getLast? = some call ∧ call.reply = .ok returned
      | _ => False
  | .error error =>
      ∃ event, audit.events.getLast? = some event ∧ flattenEventReply event = .error error

/-- Singleton flatten performs precisely one Tuple dispatch and no splat. It
preserves any successful custom result, including a non-Tuple result, and any
thrown Julia value together with all mutation before that throw. Quantification
includes arbitrary value carriers, worlds, selected callees and their results;
no law of a callee or successful-call hypothesis is assumed. Divergence has no
terminal observation and is allowed by the existing Option boundary.
Source: base/multidimensional.jl:91.
Documentation: doc/src/manual/functions.md:666-715 (splatting arbitrary
iterables); base/multidimensional.jl:87-93 (flattening constructor context). -/
def FlattenSingletonRuntime : Prop :=
  ∀ (World Value : Type) (ops : FlattenOps (FlattenPrimitive World Value) Value)
    (value : Value) (world : World),
    match (flattenSingleton (flattenObserveOps ops) value).run
      ({ world := world } : FlattenAudit World Value) with
    | none => True
    | some (result, audit) =>
        FlattenTerminalObservation ops [value] world result audit

/-- Flatten preserves the original left-to-right Tuple-call sequence, completes
those calls before starting splat iteration, and assembles results from right
to left. A selected custom recursive method receives exactly the unprocessed
tail, between those two phases. Without such a method, success uses every
original field once and makes n-1 splats; with a delegated tail, its c processed
prefix fields cause exactly c splats. Any thrown value is the final observed
operation's error, with its world retained. Splat arguments are related to
observed intermediate values by their original positions, independently of
the model's recursive implementation.

The domain is every constructible Julia input Tuple and all arbitrary Any
field payloads. Custom Tuple results may be non-Tuples, may mutate shared
objects, may throw arbitrary values, or may diverge. The actual Core splat
primitive retains nonstandard iteration and tuple-construction errors; there
is no bound on the flattened output imposed as a caller precondition. No
callee correctness law is assumed. The empty method is a necessary concrete
dependency covered by the zero-arity case of this invariant.
Source: base/multidimensional.jl:90-92.
Documentation: doc/src/manual/functions.md:666-715. -/
def FlattenRecursiveRuntime : Prop :=
  ∀ (World Value : Type) (ops : FlattenOps (FlattenPrimitive World Value) Value)
    (input : FlattenArguments Value) (world : World),
    match (flattenTuple (flattenObserveOps ops) input).run
      ({ world := world } : FlattenAudit World Value) with
    | none => True
    | some (result, audit) =>
        FlattenTerminalObservation ops input.values world result audit

