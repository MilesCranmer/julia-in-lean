/-- Complete signed-counter and native-field protocol of this usable partial
closure. Stopping compares the caller's Int64 counter with the independently
specified wrapped native view length. Otherwise the independent Cartesian
carry reference determines coordinates/errors and the counter advances modulo
Int64. Caller-supplied states need not be reachable, valid or rank-matching.

Tuple arities fit Julia Int, and the native view index has its real constructor
invariant. There is no successful-execution, index-in-bounds, positive-length,
parent-product or no-overflow premise. This does not claim that raw parent
field records construct a complete Julia parent/view; custom/unrepresented
parts of the full source signature remain explicitly blocked.
Source: base/multidimensional.jl:664-668,459-483. -/
def NativePartitionIterationCorrect : Prop :=
  ∀ (view : NativePartitionView) (state : CI) (n : I64),
    NativeUnitRangeNormalized view.viewIndex →
    (view.parentIndices.length : Int) ≤ IntTy.max .i64 →
    (state.length : Int) ≤ IntTy.max .i64 →
    JuliaLean.base.multidimensional.Models1Group6.iterateNativePartition view state n =
      if NativePartitionLengthValue view ≤ n.val then .ok none
      else
        ((PartitionCarryReference state view.parentIndices).map (fun next =>
          some (next, (next, JInt.wrap .i64 (n.val + 1))))).mapError Sum.inr


/-!
Independent, unproved invariants for the atomic ordinary-callee partial.
They constrain raw values/errors and reached state at primitive actions, without
asserting that omitted bounded Core call-splat construction always succeeds.
No runtime correctness or successful-conversion premise is imposed.
-/

namespace AtomicProtocol

open JuliaLean.base.multidimensional.Models1Group6

/-- Errors retain the state reached before the exception. -/
abbrev Effects (State Value : Type) := ExceptT Error (StateM State) Value

/-- Observe exact success/error and final state together. -/
def observe {State Value : Type} (action : Effects State Value) (initial : State) :
    Except Error Value × State :=
  ExceptT.run action initial

/-- Replacing any trailing coordinate sequence preserves every represented
observable result and effect, provided the first-coordinate option is unchanged.
The comparison includes zero coordinates, arbitrary raw primitive results,
conversions which mutate before failing, and atomic failures. This source
invariant is not a bounds-validity promise: AbstractVector linearization ignores
all trailing integers. Source: base/abstractarray.jl:1399-1400;
base/multidimensional.jl:739-751.
-/
def CoordinateTailIrrelevance : Prop :=
  ∀ (State Memory Pointer Element Value Expected Operation Output : Type)
    (runtime : AtomicRuntime (Effects State)
      Memory Pointer Element Value Expected Operation Output)
    (memoryType : JuliaLean.base.genericmemory.GenericMemoryType)
    (boundsChecking : Bool) (memory : Memory)
    (request : AtomicRequest Value Expected Operation)
    (left right : AtomicIndexTuple) (initial : State),
    left.coordinates.head? = right.coordinates.head? →
    observe (atomicCartesianClosed runtime memoryType boundsChecking memory request left) initial =
      observe (atomicCartesianClosed runtime memoryType boundsChecking memory request right) initial ∧
    observe (atomicNativeIntegers runtime memoryType boundsChecking memory request left) initial =
      observe (atomicNativeIntegers runtime memoryType boundsChecking memory request right) initial

/-- Execute an actual action while preserving the independent read counter. -/
def preserveCounter {State Value : Type} (action : Effects State Value) :
    Effects (State × Nat) Value :=
  ExceptT.mk fun state =>
    let (result, final) := observe action state.1
    (result, (final, state.2))

/-- Count the actual length-field read, including a read which throws. -/
def countLengthRead {State Value : Type} (action : Effects State Value) :
    Effects (State × Nat) Value :=
  ExceptT.mk fun state =>
    let (result, final) := observe action state.1
    (result, (final, state.2 + 1))

/-- Transparent instrumentation of each actual inherited runtime action. -/
def counterRuntime {State Memory Pointer Element Value Expected Operation Output : Type}
    (runtime : AtomicRuntime (Effects State)
      Memory Pointer Element Value Expected Operation Output) :
    AtomicRuntime (Effects (State × Nat))
      Memory Pointer Element Value Expected Operation Output where
  readLengthField := fun memory => countLengthRead (runtime.readLengthField memory)
  memoryrefAt := fun memory index => preserveCounter (runtime.memoryrefAt memory index)
  castElement := runtime.castElement
  convertElement := fun value => preserveCounter (runtime.convertElement value)
  memoryrefGet := fun ref order checked =>
    preserveCounter (runtime.memoryrefGet ref order checked)
  memoryrefSet := fun ref value order checked =>
    preserveCounter (runtime.memoryrefSet ref value order checked)
  memoryrefSetOnce := fun ref value success failure checked =>
    preserveCounter (runtime.memoryrefSetOnce ref value success failure checked)
  memoryrefModify := fun ref operation value order checked =>
    preserveCounter (runtime.memoryrefModify ref operation value order checked)
  memoryrefSwap := fun ref value order checked =>
    preserveCounter (runtime.memoryrefSwap ref value order checked)
  memoryrefReplace := fun ref expected desired success failure checked =>
    preserveCounter (runtime.memoryrefReplace ref expected desired success failure checked)

/-- Only an empty coordinate tuple reads GenericMemory's length field, exactly
once. This is a whole-protocol state/error observation, with no premise about
the runtime's return values, purity, error behavior, or atomic success.
Source: base/multidimensional.jl:739-751; base/abstractarray.jl:1399-1400;
base/essentials.jl:14.
-/
def LengthReadAccounting : Prop :=
  ∀ (State Memory Pointer Element Value Expected Operation Output : Type)
    (runtime : AtomicRuntime (Effects State)
      Memory Pointer Element Value Expected Operation Output)
    (memoryType : JuliaLean.base.genericmemory.GenericMemoryType)
    (boundsChecking : Bool) (memory : Memory)
    (request : AtomicRequest Value Expected Operation)
    (indices : AtomicIndexTuple) (initial : State),
    let expectedCount := if indices.coordinates.isEmpty then 1 else 0
    let cartesian := observe
      (atomicCartesianClosed runtime memoryType boundsChecking memory request indices) initial
    let native := observe
      (atomicNativeIntegers runtime memoryType boundsChecking memory request indices) initial
    observe (atomicCartesianClosed (counterRuntime runtime)
        memoryType boundsChecking memory request indices) (initial, 0) =
      (cartesian.1, (cartesian.2, expectedCount)) ∧
    observe (atomicNativeIntegers (counterRuntime runtime)
        memoryType boundsChecking memory request indices) (initial, 0) =
      (native.1, (native.2, expectedCount))

/-- A failed empty-path length-field read passes through its exact exception
and final state, before memoryref construction or any conversion/atomic action.
Source: base/abstractarray.jl:1400; base/essentials.jl:14.
-/
def EmptyReadFailurePropagation : Prop :=
  ∀ (State Memory Pointer Element Value Expected Operation Output : Type)
    (runtime : AtomicRuntime (Effects State)
      Memory Pointer Element Value Expected Operation Output)
    (memoryType : JuliaLean.base.genericmemory.GenericMemoryType)
    (boundsChecking : Bool) (memory : Memory)
    (request : AtomicRequest Value Expected Operation)
    (indices : AtomicIndexTuple) (initial final : State) (error : Error),
    indices.coordinates = [] →
    observe (runtime.readLengthField memory) initial = (.error error, final) →
    observe (atomicCartesianClosed runtime memoryType boundsChecking memory request indices) initial =
      (.error error, final) ∧
    observe (atomicNativeIntegers runtime memoryType boundsChecking memory request indices) initial =
      (.error error, final)

/-- Observable primitive requests in a concrete fault-injection interpreter.
The event includes every order, value and bounds flag supplied to the atomic
primitive, not just an uninformative successful return value.
-/
inductive Event where
  | length
  | reference (index : I64)
  | converted (value : I64)
  | get (index : I64) (order : JuliaLean.base.genericmemory.MemoryOrder) (checked : Bool)
  | set (index value : I64) (order : JuliaLean.base.genericmemory.MemoryOrder) (checked : Bool)
  | setOnce (index value : I64)
      (success failure : JuliaLean.base.genericmemory.MemoryOrder) (checked : Bool)
  | modify (index operation value : I64)
      (order : JuliaLean.base.genericmemory.MemoryOrder) (checked : Bool)
  | swap (index value : I64) (order : JuliaLean.base.genericmemory.MemoryOrder) (checked : Bool)
  | replace (index expected desired : I64)
      (success failure : JuliaLean.base.genericmemory.MemoryOrder) (checked : Bool)

/-- The fixed exception thrown by the concrete recording runtime. -/
def probeError : Error := .errorException "atomic probe failure"

/-- Append the actual requested event, then fail at the selected zero-based
call ordinal. The append precedes failure, so an error exposes its last effect.
-/
def record {Value : Type} (failureAt : Option Nat) (event : Event) (value : Value) :
    Effects (List Event) Value :=
  ExceptT.mk fun events =>
    let result := if failureAt = some events.length then .error probeError else .ok value
    (result, events ++ [event])

/-- A concrete allowed primitive implementation. A failed cast requests one
conversion, whose returned value is the wrapped successor of the original.
Each atomic primitive returns the referenced index after recording all actual
arguments. Any represented primitive call can fail after its recorded effect.
No supplied correctness law is invoked.
-/
def recordingRuntime (headerLength : I64) (castSucceeds : Bool) (failureAt : Option Nat) :
    AtomicRuntime (Effects (List Event)) Unit I64 I64 I64 I64 I64 I64 where
  readLengthField := fun _ => record failureAt .length headerLength
  memoryrefAt := fun _ index => record failureAt (.reference index) ⟨(), index⟩
  castElement := fun value => if castSucceeds then some value else none
  convertElement := fun value =>
    record failureAt (.converted value) (JuliaLean.base.int.add value (int 1))
  memoryrefGet := fun ref order checked =>
    record failureAt (.get ref.ptr_or_offset order checked) ref.ptr_or_offset
  memoryrefSet := fun ref value order checked =>
    record failureAt (.set ref.ptr_or_offset value order checked) ref.ptr_or_offset
  memoryrefSetOnce := fun ref value success failure checked =>
    record failureAt (.setOnce ref.ptr_or_offset value success failure checked) ref.ptr_or_offset
  memoryrefModify := fun ref operation value order checked =>
    record failureAt (.modify ref.ptr_or_offset operation value order checked) ref.ptr_or_offset
  memoryrefSwap := fun ref value order checked =>
    record failureAt (.swap ref.ptr_or_offset value order checked) ref.ptr_or_offset
  memoryrefReplace := fun ref expected desired success failure checked =>
    record failureAt (.replace ref.ptr_or_offset expected desired success failure checked)
      ref.ptr_or_offset

/-- Static operation-argument contribution to the concrete trace. Only setters,
set-once, swap and the desired argument of replace require an element cast.
This table describes the operation interface, independently of tuple dispatch.
Source: base/genericmemory.jl:416-490.
-/
def ConversionArgument : AtomicRequest I64 I64 I64 → Option I64
  | .get _ => none
  | .set _ value => some value
  | .setOnce _ _ value => some value
  | .modify _ _ _ => none
  | .swap _ value => some value
  | .replace _ _ _ desired => some desired

/-- Independent argument-level observation of the requested atomic operation.
The converted payload is fixed by the concrete interpreter above; expected and
modify operands remain their original values. Source: genericmemory.jl:416-490.
-/
def AtomicEvent (index : I64) (castSucceeds boundsChecking : Bool) :
    AtomicRequest I64 I64 I64 → Event
  | .get order => .get index order boundsChecking
  | .set order value =>
      .set index (if castSucceeds then value else JuliaLean.base.int.add value (int 1))
        order boundsChecking
  | .setOnce success failure value =>
      .setOnce index (if castSucceeds then value else JuliaLean.base.int.add value (int 1))
        success failure boundsChecking
  | .modify order operation value => .modify index operation value order boundsChecking
  | .swap order value =>
      .swap index (if castSucceeds then value else JuliaLean.base.int.add value (int 1))
        order boundsChecking
  | .replace success failure expected desired =>
      .replace index expected
        (if castSucceeds then desired else JuliaLean.base.int.add desired (int 1))
        success failure boundsChecking

/-- A static flat request schedule: optional header read, one memory reference,
optional element conversion, and exactly one requested atomic primitive. The
selected index is the first coordinate or native one for the empty tuple.
There is no recursive simulation of either wrapper in this expected result.
-/
def PlannedEvents (indices : AtomicIndexTuple) (castSucceeds boundsChecking : Bool)
    (request : AtomicRequest I64 I64 I64) : List Event :=
  let index := indices.coordinates.head?.getD (int 1)
  let header := if indices.coordinates.isEmpty then [Event.length] else []
  let conversion := match ConversionArgument request with
    | none => []
    | some value => if castSucceeds then [] else [Event.converted value]
  header ++ [Event.reference index] ++ conversion ++
    [AtomicEvent index castSucceeds boundsChecking request]

/-- Exact failure prefix or complete successful observation, computed from a
static event schedule and one selected failure ordinal. -/
def ExpectedProbeResult (indices : AtomicIndexTuple) (castSucceeds boundsChecking : Bool)
    (request : AtomicRequest I64 I64 I64) (failureAt : Option Nat) :
    Except Error I64 × List Event :=
  let events := PlannedEvents indices castSucceeds boundsChecking request
  match failureAt with
  | some position =>
      if position < events.length then
        (.error probeError, events.take (position + 1))
      else (.ok (indices.coordinates.head?.getD (int 1)), events)
  | none => (.ok (indices.coordinates.head?.getD (int 1)), events)

/-- Every native and Cartesian tuple, every operation request, every order and
bounds flag, every header value, both cast branches, and failure after any
primitive effect obey the independent flat schedule. This detects use of the
wrong coordinate, extra trailing-coordinate work, a premature conversion,
wrong atomic operands/orders, missed size observation, or work after failure.
Source: base/multidimensional.jl:739-751; genericmemory.jl:416-490.
-/
def PrimitiveOrderAndFailure : Prop :=
  ∀ (memoryType : JuliaLean.base.genericmemory.GenericMemoryType)
    (indices : AtomicIndexTuple) (request : AtomicRequest I64 I64 I64)
    (headerLength : I64) (castSucceeds boundsChecking : Bool) (failureAt : Option Nat),
    let runtime := recordingRuntime headerLength castSucceeds failureAt
    let expected := ExpectedProbeResult indices castSucceeds boundsChecking request failureAt
    observe (atomicCartesianClosed runtime memoryType boundsChecking () request indices) [] = expected ∧
    observe (atomicNativeIntegers runtime memoryType boundsChecking () request indices) [] = expected

end AtomicProtocol


/-!
Independent, unproved statements for the native-field bounds partials.
Their limitations and separate todo registry entries are listed in NOTES.md.
-/

namespace NativeBounds

abbrev Axis := JuliaLean.base.multidimensional.Models1Group6.NativeBounds.Axis
abbrev Input := JuliaLean.base.multidimensional.Models1Group6.NativeBounds.Input
abbrev Component := JuliaLean.base.multidimensional.Models1Group6.NativeBounds.Component
abbrev CartesianStepRange :=
  JuliaLean.base.multidimensional.Models1Group6.NativeBounds.CartesianStepRange

/-- A Julia tuple has a machine Int field count (`tuple.jl:28`, nfields).
This is an actual arity invariant on the tuple representation, not an array
size/product, successful-execution, or arithmetic no-overflow assumption. -/
def TupleArity {Value : Type} (values : List Value) : Prop :=
  (values.length : Int) ≤ IntTy.max .i64

/-- Every actual mixed argument tuple, and every CartesianIndex's stored
