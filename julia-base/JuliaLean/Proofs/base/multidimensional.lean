local instance utilityObservationError {Extra S : Type} :
    MonadExceptOf Error (ConstructorObservationM Extra S) := constructorObservationError

inductive ZeroRegionEvent (Extra A Axes Selector Value : Type) where
  | tail (array : A) (axes : Axes) (selectors : List Selector)
      (result : Except (Sum Error Extra) Value)
  | apply (iterate : Value) (arguments : List Value)
      (result : Except (Sum Error Extra) Value)

def observeZeroRegionOps {Extra S A Axes Selector Value : Type}
    (ops : ZeroRegionIndicesOps (ConstructorObservationM Extra S) A Axes Selector Value) :
    ZeroRegionIndicesOps
      (ConstructorObservationM Extra
        (S × List (S × S × ZeroRegionEvent Extra A Axes Selector Value)))
      A Axes Selector Value where
  toIndices := fun array axes selectors =>
    observeConstructorAction (ops.toIndices array axes selectors) (.tail array axes selectors)
  applyIterate := fun iterate arguments =>
    observeConstructorAction (ops.applyIterate iterate arguments) (.apply iterate arguments)
  baseIterate := ops.baseIterate
  coreTuple := ops.coreTuple
  singletonZeroRegion := ops.singletonZeroRegion

/-- The rank-zero selector consumes no axes and remains one selector. Its
singleton tuple precedes the actual tail return in the fixed Core tuple
application. Tail failure prevents the splat; both state transitions and the
final returned/thrown value remain exact.
Source: base/multidimensional.jl:502-503. -/
def ZeroRegionIndicesObservations : Prop :=
  ∀ (Extra S A Axes Selector Value : Type)
    (ops : ZeroRegionIndicesOps (ConstructorObservationM Extra S) A Axes Selector Value)
    (array : A) (axes : Axes) (tail : List Selector) (state : S),
    (tail.length + 1 : Nat) ≤ (IntTy.max .i64).toNat →
    match (toIndicesZeroRegionGeneric (observeZeroRegionOps ops) array axes tail).run (state, []) with
    | none => True
    | some (result, (final, records)) =>
        (∃ remaining middle,
          records = [(state, middle, .tail array axes tail (.ok remaining)),
            (middle, final, .apply ops.baseIterate
              [ops.coreTuple, ops.singletonZeroRegion, remaining] result)]) ∨
        (∃ error,
          result = .error error ∧
          records = [(state, final, .tail array axes tail (.error error))])

inductive OuterRegionEvent (Extra R Native Other : Type) where
  | ordinal (event : RegionEvent Extra R Native Other)
  | selected (ranges : List R)
      (result : Except (Sum Error Extra) (Sum (List Native) Other))

abbrev OuterRegionRecord (Extra S R Native Other : Type) :=
  S × S × OuterRegionEvent Extra R Native Other

/-- Embed actual ordinal-constructor records, without assuming its property.
The original returned value, thrown value, and state are preserved. -/
def liftOrdinalOuterObservation {Extra S R Native Other A : Type}
    (action : ConstructorObservationM Extra (S × List (RegionRecord Extra S R Native Other)) A) :
    ConstructorObservationM Extra (S × List (OuterRegionRecord Extra S R Native Other)) A :=
  ExceptT.mk fun (state, events) =>
    match action.run (state, []) with
    | none => none
    | some (result, (final, records)) =>
        some (result, (final, events ++ records.map fun record =>
          (record.1, record.2.1, OuterRegionEvent.ordinal record.2.2)))

def observeRegionOuterOps {Extra S R Native Other : Type}
    (ops : RegionOuterOps (ConstructorObservationM Extra S) R Native Other) :
    RegionOuterOps
      (ConstructorObservationM Extra (S × List (OuterRegionRecord Extra S R Native Other)))
      R Native Other where
  ordinal :=
    let observed := observeOrdinalRegionOps ops.ordinal
    { convertRange := fun range => liftOrdinalOuterObservation (observed.convertRange range)
      selectedMap := fun _ ranges =>
        (observed.selectedMap observed.convertRange ranges).map liftOrdinalOuterObservation
      applyIterateOther := fun head tail =>
        liftOrdinalOuterObservation (observed.applyIterateOther head tail)
      selectedConstructor := fun rank fields =>
        (observed.selectedConstructor rank fields).map liftOrdinalOuterObservation }
  selectedConstructor := fun ranges => (ops.selectedConstructor ranges).map fun action =>
    observeConstructorAction action (.selected ranges)

/-- Every constructor argument belongs to the original suffix. The default
branch satisfies the independent ordinal-construction trace and delayed-bound
invariant on that suffix; a selected constructor is one atomic suffix call.
No head operation is introduced. Source: base/multidimensional.jl:511-513. -/
def SimdOuterObservations : Prop :=
  ∀ (Extra S R Native Other : Type)
    (ops : RegionOuterOps (ConstructorObservationM Extra S) R Native Other)
    (head : R) (tail : List R) (state : S), TupleArity (head :: tail) →
    match (simdOuterGeneric (observeRegionOuterOps ops) head tail).run (state, []) with
    | none => True
    | some (result, (final, records)) =>
        (∃ ordinalRecords : List (RegionRecord Extra S R Native Other),
          records = ordinalRecords.map (fun record =>
            (record.1, record.2.1, OuterRegionEvent.ordinal record.2.2)) ∧
          RegionObservation tail state (some (result, (final, ordinalRecords)))) ∨
        (tail ≠ [] ∧ records = [(state, final, .selected tail result)])

structure InnerLengthEvent (Extra R Value : Type) where
  range : R
  result : Except (Sum Error Extra) Value

def observeRegionInnerOps {Extra S R Value : Type}
    (ops : RegionInnerLengthOps (ConstructorObservationM Extra S) R Value) :
    RegionInnerLengthOps
      (ConstructorObservationM Extra (S × List (S × S × InnerLengthEvent Extra R Value)))
      R Value where
  length := fun range =>
    observeConstructorAction (ops.length range) (fun result => ⟨range, result⟩)

/-- Only the original first stored range is observed, once. Remaining ranges
and the outer index cannot affect the chosen length argument; arbitrary
returns, errors and mutation survive. Source: base/multidimensional.jl:516. -/
def SimdInnerLengthObservations : Prop :=
  ∀ (Extra S R Value : Type)
    (ops : RegionInnerLengthOps (ConstructorObservationM Extra S) R Value)
    (head : R) (tail : List R) (outer : CI) (state : S),
    TupleArity (head :: tail) → TupleArity outer →
    match (simdInnerLengthGeneric (observeRegionInnerOps ops) head tail outer).run (state, []) with
    | none => True
    | some (result, (final, records)) => records = [(state, final, ⟨head, result⟩)]

