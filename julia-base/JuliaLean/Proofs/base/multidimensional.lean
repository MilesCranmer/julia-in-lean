namespace ConversionContracts

open JuliaLean.base.multidimensional.Models1Group5.RangeDependencies

/-- The mathematical sequence of one stored integer progression, observed without
calling a constructor, conversion, indexing, or equality model. -/
def AxisValueAt (axis : OrdinalRange64) (position : Nat) : Option Int :=
  if position < rangeCardinality axis then
    some ((rangeFirst axis).val + (position : Int) * (rangeStep axis).val)
  else none

/-- Per-axis sequence agreement also distinguishes coordinate order. Empty axes
have the empty sequence irrespective of their normalized stored endpoints. -/
def SameAxisValues (a b : OrdinalRange64) : Prop :=
  ∀ position : Nat, AxisValueAt a position = AxisValueAt b position

def SameRegionAxisValues (a b : Region64) : Prop :=
  a.length = b.length ∧
  ∀ (position : Nat) (left right : OrdinalRange64),
    a[position]? = some left → b[position]? = some right → SameAxisValues left right

def SameStoredTag (a b : OrdinalRange64) : Prop :=
  match a, b with
  | .oneTo _, .oneTo _ | .unit _, .unit _ | .stepped _, .stepped _ => True
  | _, _ => False

def IsUnitTag : OrdinalRange64 → Prop
  | .unit _ => True
  | _ => False

def IsStepTag : OrdinalRange64 → Prop
  | .stepped _ => True
  | _ => False

/-- A target type requirement, independent of the conversion implementation. -/
inductive ConversionGoal where
  | ordinal
  | stepped
  | abstractUnit
  | unit

def TargetAccepts (target : ConversionGoal) (input : Region64) : Prop :=
  match target with
  | .ordinal | .stepped => True
  | .abstractUnit | .unit => ∀ axis ∈ input, ¬IsStepTag axis

def TargetTags (target : ConversionGoal) (input output : Region64) : Prop :=
  match target with
  | .ordinal | .abstractUnit =>
    ∀ (position : Nat) (a b : OrdinalRange64),
      input[position]? = some a → output[position]? = some b → SameStoredTag a b
  | .stepped => ∀ axis ∈ output, IsStepTag axis
  | .unit => ∀ axis ∈ output, IsUnitTag axis

/-- Conversion preserves every mathematical axis sequence and the requested
target's subtype constraints. A failed AbstractUnitRange or UnitRange conversion
must be explained by an actual StepRange input tag, even when its stride is 1. -/
def ConversionOutcome (target : ConversionGoal) (input : Region64)
    (outcome : RegionResult Region64) : Prop :=
  match outcome with
  | .ok output =>
    TargetAccepts target input ∧ RegionDomain output ∧
    SameRegionAxisValues input output ∧ TargetTags target input output
  | .error (.jl (.methodError _)) => ¬TargetAccepts target input
  | .error _ => False

/-- All represented tuple-conversion overloads preserve their axis sequences and
requested target tags, or reject exactly a StepRange-to-unit-range conversion.
The complete represented domain includes negative unchecked OneTo stops and
machine-wrapped lengths; no cardinality or coordinate bounds are added.
Source: base/multidimensional.jl:359-375; base/range.jl:288,1338-1373. -/
def RegionConversionsPreserveCoordinates : Prop :=
  ∀ input : Region64, RegionDomain input →
    ConversionOutcome .ordinal input (regionConvertOrdinal input) ∧
    ConversionOutcome .stepped input (regionConvertStepped input) ∧
    ConversionOutcome .abstractUnit input (regionConvertAbstractUnitInt input) ∧
    ConversionOutcome .abstractUnit input (regionConvertAbstractUnit input) ∧
    ConversionOutcome .unit input (regionConvertUnitInt input) ∧
    ConversionOutcome .unit input (regionConvertUnit input) ∧
    ConversionOutcome .abstractUnit input (regionConvertVarargAbstractUnitInt input) ∧
    ConversionOutcome .abstractUnit input (regionConvertVarargAbstractUnit input) ∧
    ConversionOutcome .unit input (regionConvertVarargUnitInt input) ∧
    ConversionOutcome .unit input (regionConvertVarargUnit input)

/-- The two closed concrete tuple-type targets preserve their axis sequences and
the requested concrete field type. The unrestricted Julia target R and its final
