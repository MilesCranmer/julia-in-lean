inductive SingletonDecrementEvent (E R StepValue FirstValue Coordinate Valid : Type) where
  | step (range : R) (result : Except E StepValue)
  | subtract (state : I64) (stride : StepValue) (result : Except E Coordinate)
  | first (range : R) (result : Except E FirstValue)
  | notEqual (state : I64) (first : FirstValue) (result : Except E Valid)

def singletonDecrementPhase {E R StepValue FirstValue Coordinate Valid : Type} :
    SingletonDecrementEvent E R StepValue FirstValue Coordinate Valid → Nat
  | .step _ _ => 0
  | .subtract _ _ _ => 1
  | .first _ _ => 2
  | .notEqual _ _ _ => 3

def singletonDecrementError {E R StepValue FirstValue Coordinate Valid : Type} :
    SingletonDecrementEvent E R StepValue FirstValue Coordinate Valid → Option E
  | .step _ (.error error) => some error
  | .subtract _ _ (.error error) => some error
  | .first _ (.error error) => some error
  | .notEqual _ _ (.error error) => some error
  | _ => none

def observeSingletonDecrementOps {E S R StepValue FirstValue Coordinate Valid : Type}
    (ops : SingletonDecrementOps (DimensionObservationM E S)
      R StepValue FirstValue Coordinate Valid) :
    SingletonDecrementOps
      (DimensionObservationM E
        (S × List (S × S × SingletonDecrementEvent E R StepValue FirstValue Coordinate Valid)))
      R StepValue FirstValue Coordinate Valid where
  step := fun range => observeDimensionAction (ops.step range) (.step range)
  wrappingSub := fun state stride =>
    observeDimensionAction (ops.wrappingSub state stride) (.subtract state stride)
  first := fun range => observeDimensionAction (ops.first range) (.first range)
  notEqual := fun state first =>
    observeDimensionAction (ops.notEqual state first) (.notEqual state first)

/-- Argument identity and actual data dependencies, without any arithmetic
or observation law for the selected methods. -/
def SingletonDecrementArguments {E R StepValue FirstValue Coordinate Valid : Type}
    (state : I64) (range : R)
    (events : List (SingletonDecrementEvent E R StepValue FirstValue Coordinate Valid)) : Prop :=
  ∀ event ∈ events, match event with
    | .step actual _ | .first actual _ => actual = range
    | .subtract actual stride _ =>
        actual = state ∧ .step range (.ok stride) ∈ events
    | .notEqual actual first _ =>
        actual = state ∧ .first range (.ok first) ∈ events

/-- A singleton output is preserved even when validity is false or has a
custom type. Completed operations form the exact source-order prefix; errors
are the final reached operation's exact error and all state changes remain visible. -/
def SingletonDecrementObservation {E S R StepValue FirstValue Coordinate Valid : Type}
    (state : I64) (range : R) (initial : S)
    (outcome : Option (Except E (Valid × List Coordinate) ×
      (S × List (S × S × SingletonDecrementEvent E R StepValue FirstValue Coordinate Valid)))) : Prop :=
  match outcome with
  | none => True
  | some (result, (final, records)) =>
      let events := records.map (fun record => record.2.2)
      let phases := events.map singletonDecrementPhase
      DimensionStateThread initial final records ∧
      SingletonDecrementArguments state range events ∧
      (∃ remaining, phases ++ remaining = [0, 1, 2, 3]) ∧
      (∀ (k : Nat) (event : SingletonDecrementEvent E R StepValue FirstValue Coordinate Valid),
        events[k]? = some event → ∀ error, singletonDecrementError event = some error →
          k + 1 = events.length ∧ result = .error error) ∧
      match result with
      | .ok (valid, coordinates) =>
          phases = [0, 1, 2, 3] ∧
          ∃ stride first coordinate,
            coordinates = [coordinate] ∧
            .subtract state stride (.ok coordinate) ∈ events ∧
            .notEqual state first (.ok valid) ∈ events
      | .error error =>
          ∃ event, events.getLast? = some event ∧ singletonDecrementError event = some error

