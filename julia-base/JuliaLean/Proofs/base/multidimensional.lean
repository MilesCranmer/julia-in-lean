/-- Instrument only genuinely selected calls; default Base paths stay closed.
All calls share one arbitrary state, preserving custom/BigInt aliasing. -/
def observeConstructorOps {Extra S B P C O : Type}
    (ops : ConstructorOps (ConstructorObservationM Extra S) B P C O) :
    ConstructorOps (ConstructorObservationM Extra (S × List (ConstructorRecord Extra S B P C O)))
      B P C O where
  bigReads := {
    readSize := fun ref => observeConstructorAction (ops.bigReads.readSize ref) (.size ref)
    readData := fun ref => observeConstructorAction (ops.bigReads.readData ref) (.data ref)
    loadLimb := fun ptr => observeConstructorAction (ops.bigReads.loadLimb ptr) (.limb ptr) }
  customConvert := fun value =>
    observeConstructorAction (ops.customConvert value) (.custom value)
  tupleConvert := fun xs => (ops.tupleConvert xs).map fun action =>
    observeConstructorAction action (.tupleConvert xs)
  innerConstructor := fun rank xs => (ops.innerConstructor rank xs).map fun action =>
    observeConstructorAction action (.innerConstructor rank xs)
  tupleConstructor := fun xs => (ops.tupleConstructor xs).map fun action =>
    observeConstructorAction action (.tupleConstructor xs)

def constructorCustomInputs {B C : Type} (xs : List (MixedInteger B C)) : List C :=
  xs.filterMap fun x => match x with
    | .custom value => some value
    | _ => none

def constructorCustomCalls {Extra B P C O : Type}
    (events : List (ConstructorEvent Extra B P C O)) : List C :=
  events.filterMap fun event => match event with
    | .custom value _ => some value
    | _ => none

def constructorCustomResults {Extra B P C O : Type}
    (events : List (ConstructorEvent Extra B P C O)) : List (Except (Sum Error Extra) (Sum I64 O)) :=
  events.filterMap fun event => match event with
    | .custom _ result => some result
    | _ => none

def constructorEventError {Extra B P C O : Type} : ConstructorEvent Extra B P C O → Option (Sum Error Extra)
  | .custom _ (.error error) => some error
  | .size _ (.error error) => some error
  | .data _ (.error error) => some error
  | .limb _ (.error error) => some error
  | .tupleConvert _ (.error error) => some error
  | .innerConstructor _ _ (.error error) => some error
  | .tupleConstructor _ (.error error) => some error
  | _ => none

def constructorWrongReturn {Extra B P C O : Type} : ConstructorEvent Extra B P C O → Prop
  | .custom _ (.ok (.inr _)) => True
  | _ => False

def constructorExtension {Extra B P C O : Type} : ConstructorEvent Extra B P C O → Bool
  | .innerConstructor _ _ _ => true
  | .tupleConstructor _ _ => true
  | _ => false

def tupleConversionExtension {Extra B P C O : Type} : ConstructorEvent Extra B P C O → Bool
  | .tupleConvert _ _ => true
  | _ => false

/-- Independent state discipline: no caller mutation surrounds the reached
interface calls, including when the final result is an exception. -/
def ConstructorStateThread {S Event : Type} (initial final : S)
    (records : List (S × S × Event)) : Prop :=
  (match records.head? with
   | none => final = initial
   | some record => record.1 = initial) ∧
  (∀ (record : S × S × Event), records.getLast? = some record → final = record.2.1) ∧
  (∀ (k : Nat) (left right : S × S × Event),
    records[k]? = some left → records[k + 1]? = some right →
    left.2.1 = right.1)

/-- Coordinate preservation by the closed Base constructor path, expressed
positionally rather than by reproducing a conversion algorithm. -/
def ConstructorCoordinates {Extra B P C O : Type} (xs : List (MixedInteger B C))
    (events : List (ConstructorEvent Extra B P C O)) (index : CI) : Prop :=
  index.length = xs.length ∧
  (∀ (k : Nat) (ty : IntTy) (value : JInt ty), xs[k]? = some (.bits ty value) →
    ∃ stored : I64, index[k]? = some stored ∧ stored.val = value.val) ∧
  (∀ (k : Nat) (value : Bool), xs[k]? = some (.bool value) →
    ∃ stored : I64, index[k]? = some stored ∧ stored.val = (if value then 1 else 0)) ∧
  (∀ (k : Nat) (value : C), xs[k]? = some (.custom value) →
    ∃ stored : I64, index[k]? = some stored ∧
      (constructorCustomResults events)[(constructorCustomInputs (xs.take k)).length]? =
        some (.ok (.inl stored)))

/-- Selected constructors receive the original tuple and inferred rank once.
Their possibly non-Cartesian returns are preserved. -/
def ConstructorExtensionObservation {Extra B P C O : Type}
    (xs : List (MixedInteger B C)) (result : Except (Sum Error Extra) (Sum CI O))
    (events : List (ConstructorEvent Extra B P C O)) : Prop :=
  ∀ event ∈ events, match event with
    | .innerConstructor rank actual returned =>
        rank.val = (xs.length : Int) ∧ actual = xs ∧ events = [event] ∧ result = returned
    | .tupleConstructor actual returned =>
        actual = xs ∧ events = [event] ∧ result = returned
    | _ => True

/-- Stored-field type invariant after selected whole-tuple conversion.
Correct native tuples of the required rank are retained exactly. -/
def TupleConversionObservation {Extra B P C O : Type}
    (xs : List (MixedInteger B C)) (result : Except (Sum Error Extra) (Sum CI O))
    (events : List (ConstructorEvent Extra B P C O)) : Prop :=
  ∀ event ∈ events, match event with
    | .tupleConvert actual returned =>
        actual = xs ∧ events = [event] ∧
        match returned with
        | .error error => result = .error error
        | .ok (.inr _) => result = .error (.inl .typeError)
        | .ok (.inl fields) =>
          match result with
          | .ok (.inl index) =>
              index.length = xs.length ∧ fields.length = index.length ∧
              ∀ (k : Nat) (value : I64),
                fields[k]? = some (.inl value) ↔ index[k]? = some value
          | .error (.inl .typeError) =>
              fields.length ≠ xs.length ∨ ∃ value : O, Sum.inr value ∈ fields
          | _ => False
    | _ => True

/-- Native coordinate representability, stated mathematically. -/
def NativeCoordinateFits (value : Int) : Prop :=
  IntTy.min .i64 ≤ value ∧ value ≤ IntTy.max .i64

/-- Full-domain observation invariant. User scalar conversions form a
source-order prefix, and every reached interface exception remains the final
exception. State is threaded across effects, including failure. The closed
Base path preserves rank and positions and rejects wrong-type fields only
after conversions. Selected constructor and tuple-conversion paths retain
their separate invariants. No callee-correctness law is assumed. -/
def ConstructorObservation {Extra S B P C O : Type}
    (xs : List (MixedInteger B C)) (initial : S)
    (outcome : Option (Except (Sum Error Extra) (Sum CI O) × (S × List (ConstructorRecord Extra S B P C O)))) : Prop :=
  match outcome with
  | none => True
  | some (result, (final, records)) =>
      let events := records.map (fun record => record.2.2)
      ConstructorStateThread initial final records ∧
      (∃ remaining, constructorCustomCalls events ++ remaining = constructorCustomInputs xs) ∧
      (∀ (k : Nat) (event : ConstructorEvent Extra B P C O), events[k]? = some event →
        ∀ error : Sum Error Extra, constructorEventError event = some error →
          k + 1 = events.length ∧ result = .error error) ∧
      ConstructorExtensionObservation xs result events ∧
      TupleConversionObservation xs result events ∧
      ((∀ event ∈ events, constructorExtension event = false) →
        (match result with
         | .ok (.inl index) => index.length = xs.length
         | .ok (.inr _) => False
         | .error _ => True) ∧
        ((∀ event ∈ events, tupleConversionExtension event = false) →
          (match result with
           | .ok (.inl index) =>
               ConstructorCoordinates xs events index ∧
               constructorCustomCalls events = constructorCustomInputs xs ∧
               (∀ event ∈ events,
                 constructorEventError event = none ∧ ¬constructorWrongReturn event)
           | .ok (.inr _) => False
           | .error _ => True) ∧
          (result = .error (.inl .typeError) →
            (∀ event ∈ events, constructorEventError event = none) →
            constructorCustomCalls events = constructorCustomInputs xs ∧
            (∃ event ∈ events, constructorWrongReturn event) ∧
            (∀ (ty : IntTy) (value : JInt ty), MixedInteger.bits ty value ∈ xs →
              NativeCoordinateFits value.val))))

/-- All four integer constructors: arbitrary user scalar/tuple conversion,
selected constructor dispatch, mutable BigInt aliases, arbitrary thrown values, and
nontermination are admitted without callee laws. Only actual tuple arity is
a precondition. Observations specify positions, mutation, failure, and type
invariants independently of the model's traversal.
Source: base/multidimensional.jl:75-82; base/essentials.jl:653-667;
doc/src/manual/arrays.md:800-820;
doc/src/manual/conversion-and-promotion.md:102-110,147-155. -/
def IntegerConstructorObservations : Prop :=
  ∀ (Extra S B P C O : Type)
    (ops : ConstructorOps (ConstructorObservationM Extra S) B P C O)
    (xs : List (MixedInteger B C)) (state : S), TupleArity xs →
    let observed := observeConstructorOps ops
    let inner : ConstructorObservationM Extra
        (S × List (ConstructorRecord Extra S B P C O)) (Sum CI O) := do
      return .inl (← constructorInner observed xs)
    ConstructorObservation xs state (inner.run (state, [])) ∧
    ConstructorObservation xs state ((constructorTuple observed xs).run (state, [])) ∧
    ConstructorObservation xs state ((constructorVarargs observed xs).run (state, [])) ∧
    ConstructorObservation xs state ((constructorSizedVarargs observed xs).run (state, []))

/-- Closed concrete Base instantiation: Bool and all ten BitInteger types,
without custom dispatch, BigInt references, or non-Cartesian returns. -/
def primitiveConstructorOps : ConstructorOps Result Empty Empty Empty Empty where
  bigReads := { readSize := Empty.elim, readData := Empty.elim, loadLimb := Empty.elim }
  customConvert := Empty.elim
  tupleConvert := fun _ => none
  innerConstructor := fun _ _ => none
  tupleConstructor := fun _ => none

/-- Mathematical input coordinate; no conversion implementation is consulted. -/
def primitiveIntegerValue : MixedInteger Empty Empty → Int
  | .bits _ value => value.val
  | .bool value => if value then 1 else 0
  | .big impossible => nomatch impossible
  | .custom impossible => nomatch impossible

/-- Exact coordinates or InexactError for an unrepresentable native Int;
other errors, wrapping, and non-Cartesian returns are forbidden. -/
def PrimitiveConstructorOutcome (values : List Int) (outcome : Result (Sum CI Empty)) : Prop :=
  match outcome with
  | .ok (.inl index) => index.map (fun value => value.val) = values
  | .ok (.inr impossible) => nomatch impossible
  | .error (.inexactError _) => ∃ value ∈ values, ¬NativeCoordinateFits value
  | .error _ => False

/-- Coordinate preservation on every Bool and BitInteger input, including
all extrema and values outside native Int. This is a concrete Base
instantiation, not an assumption on a dispatch target.
Source: base/multidimensional.jl:21-39,75-82;
doc/src/manual/arrays.md:800-820;
doc/src/manual/conversion-and-promotion.md:102-110. -/
def PrimitiveIntegerConstructorsCorrect : Prop :=
  ∀ xs : List (MixedInteger Empty Empty), TupleArity xs →
    let values := xs.map primitiveIntegerValue
    PrimitiveConstructorOutcome values
      ((constructorInner primitiveConstructorOps xs).map
        (fun index : CI => (Sum.inl index : Sum CI Empty))) ∧
    PrimitiveConstructorOutcome values (constructorTuple primitiveConstructorOps xs) ∧
    PrimitiveConstructorOutcome values (constructorVarargs primitiveConstructorOps xs) ∧
    PrimitiveConstructorOutcome values (constructorSizedVarargs primitiveConstructorOps xs)

