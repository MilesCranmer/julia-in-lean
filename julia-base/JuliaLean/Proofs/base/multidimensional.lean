no replacement model is added. Source: base/multidimensional.jl:1154-1155. -/
def ParentMatchProtocol (strided : Bool) : Prop :=
  ∀ (E S A Element Pointer Shape Strides Other : Type)
    (ops : ParentMatchRuntime (ConstructorObservationM E S) A Element Pointer Shape Strides Other)
    (left right : A) (initial : S),
    let observed := observeParentMatchOps ops
    let outcome :=
      (if strided then parentsMatchStridedRaw observed left right
       else parentsMatchDenseRaw observed left right).run (initial, [])
    match outcome with
    | none => True
    | some (result, (final, records)) =>
        let events := records.map (fun record => record.2.2)
        ConstructorStateThread initial final records ∧
        (∃ suffix, events.map parentEventPhase ++ suffix = [0, 0, 1, 2, 2, 3, 4, 4, 5]) ∧
        ParentMatchDataflow strided left right events ∧ ParentMatchResult events result

def ParentMatchDenseObservations : Prop := ParentMatchProtocol false

def ParentMatchStridedObservations : Prop := ParentMatchProtocol true

