      cases res with
      | inr val =>
          exact ⟨h.1, fun haddr => h.2 ((getRegionAddress_iff array index).mp haddr)⟩
      | inl coords =>
          exact ⟨(getRegionAddress_iff array index).mpr h.1, h.2⟩

