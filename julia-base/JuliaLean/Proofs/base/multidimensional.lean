            (Models2Group3.GenericSplitEvent.first value ref))
            (fun front => Bind.bind (Models2Group3.observeConstructorAction (ops.splitRest value ref)
              (Models2Group3.GenericSplitEvent.rest value ref))
              (fun rest => pure (front, rest)))).run (state, []) with
          | none => True
          | some (result, (final, records)) => _
        rw [observeConstructorAction_bind_run]
