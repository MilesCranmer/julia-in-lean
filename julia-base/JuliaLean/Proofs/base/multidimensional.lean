          ∃ coordinate : I64, result[position]? = some coordinate ∧
            (coordinate.val - ((rangeFirst axis).val +
              (subscript.val - 1) * (rangeStep axis).val)) % ((2 : Int) ^ 64) = 0
    | .error _ => False

theorem coordinatewise_iff_forall {A B : Type} (R : A → B → Prop) (xs : List A) (ys : List B) :
    Models1Group5.Coordinatewise R xs ys ↔
      xs.length = ys.length ∧ ∀ (k : Nat) a b, xs[k]? = some a → ys[k]? = some b → R a b := by
  induction xs generalizing ys with
  | nil =>
      cases ys with
      | nil =>
          simp only [Models1Group5.Coordinatewise, List.length_nil, true_and]
          constructor
          · intro _ k _ _ hk _
            cases hk
          · intro _
            trivial
      | cons y ys =>
          simp only [Models1Group5.Coordinatewise, List.length_nil, List.length_cons]
          exact ⟨False.elim, fun h => by omega⟩
  | cons x xs ih =>
      cases ys with
      | nil =>
          simp only [Models1Group5.Coordinatewise, List.length_cons, List.length_nil]
          exact ⟨False.elim, fun h => by omega⟩
      | cons y ys =>
          simp only [Models1Group5.Coordinatewise, List.length_cons, ih]
          constructor
          · rintro ⟨hxy, hlen, hrest⟩
            refine ⟨by omega, ?_⟩
            intro k a b ha hb
            cases k with
            | zero => injection ha with ha; injection hb with hb; subst ha hb; exact hxy
            | succ k => exact hrest k a b ha hb
          · rintro ⟨hlen, hall⟩
            refine ⟨hall 0 x y rfl rfl, by omega, ?_⟩
            intro k a b ha hb
            exact hall (k + 1) a b ha hb

