required before later observations. The terminal shape/stride equality is
returned raw and may be Missing or another value. No symmetry, purity or
metadata correctness law is assumed. -/
def ParentMatchResult {E A Element Pointer Shape Strides Other : Type}
    (events : List (ParentMatchEvent E A Element Pointer Shape Strides Other))
    (result : Except (Sum Error E) (MaskTruth Other)) : Prop :=
  (∀ (k : Nat) (event : ParentMatchEvent E A Element Pointer Shape Strides Other),
    events[k]? = some event →
    (∀ error, parentEventError event = some error → k + 1 = events.length ∧ result = .error error) ∧
    (∀ value, parentEarlyReply event = some value → match value with
      | .bool true => True
      | .bool false => k + 1 = events.length ∧ result = .ok (.bool false)
      | .missing | .other _ => k + 1 = events.length ∧ result = .error (.inl .typeError))) ∧
