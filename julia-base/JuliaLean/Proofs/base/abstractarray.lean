inductive TrailingCall (Axis Length Product : Type) where
  | length (axis : Axis) (outcome : Except ArrayError Length)
  | product (lengths : List Length) (outcome : Except ArrayError Product)

/-- Observation-only correspondence of successful axis/length pairs; this
function performs no length call or product computation. -/
def trailingMappedCalls {Axis Length Product : Type}
    (axes : List Axis) (lengths : List Length) : List (TrailingCall Axis Length Product) :=
  (axes.zip lengths).map (fun (axis, length) => .length axis (.ok length))

/-- Either a length failure ends the original-axis prefix immediately, or
every axis is mapped before exactly one product call. That product receives
the actual mapped payloads without conversion and supplies the final outcome.
The second alternative includes the empty tuple and its empty product input.
-/
def TrailingMapOutcome {Axis Length Product : Type} (axes : List Axis)
    (outcome : Except ArrayError Product) (calls : List (TrailingCall Axis Length Product)) : Prop :=
  (∃ preceding axis suffix lengths error,
    axes = preceding ++ axis :: suffix ∧ lengths.length = preceding.length ∧
    calls = trailingMappedCalls preceding lengths ++ [.length axis (.error error)] ∧
    outcome = .error error) ∨
  (∃ lengths, lengths.length = axes.length ∧
    calls = trailingMappedCalls axes lengths ++ [.product lengths outcome])

/-- The internal whole-tuple trailing-size method preserves every original
axis and actual length payload in order, maps all lengths before prod, and
retains the selected product's independently typed result/error and state.
Every tuple has a native-representable arity. The property includes empty
tuples and the first length failure at any position.

