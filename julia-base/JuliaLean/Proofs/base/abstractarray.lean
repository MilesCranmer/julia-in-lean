theorem cat7_frontend_evaluate {World OtherError E Ty A : Type}
    (frontend : ConcatFrontend)
    (promote : Tuple E → ConcatAction World OtherError Ty)
    (concatenate : Ty → Tuple E → ConcatAction World OtherError A)
    (args : Tuple E) (world : World) :
    observeConcatFrontend frontend promote concatenate args world =
      match args.values with
      | [] => some (.error (.inl (.errorException "")), (world, []))
      | _ :: _ =>
          match promote args world with
          | none => none
          | some (.error error, middle) =>
              some (.error error, (middle,
                [⟨world, middle, .promotion args (.error error)⟩]))
          | some (.ok promoted, middle) =>
              (concatenate promoted args middle).map fun (outcome, final) =>
                (outcome, (final,
                  [⟨world, middle, .promotion args (.ok promoted)⟩,
                   ⟨middle, final, .concatenation promoted args outcome⟩])) := by
  cases frontend <;>
    simp only [observeConcatFrontend,
      JuliaLean.base.abstractarray.Models2Group6.vcatVectorsSelected,
      JuliaLean.base.abstractarray.Models2Group6.hcatArraysSelected,
      JuliaLean.base.abstractarray.Models2Group6.vcatArraysSelected,
      vcatVectors, hcatArrays, vcatArrays]
  all_goals
    cases hvalues : args.values with
    | nil =>
        simp only [JuliaLean.base.abstractarray.Models2Group6.concatPromoteEltype,
          hvalues, promoteEltypeEmpty]
        rfl
    | cons value rest =>
        simp only [JuliaLean.base.abstractarray.Models2Group6.concatPromoteEltype,
          hvalues, recordConcatCall, bind, ExceptT.bind, ExceptT.run,
          ExceptT.mk, StateT.bind, StateT.run, StateT.mk]
        cases hp : promote args world with
        | none => rfl
        | some first =>
            cases first with
            | mk outcome middle =>
                cases outcome <;> rfl

theorem cat7_frontend_provenance (frontend : ConcatFrontend) :
    ConcatFrontendProvenance frontend := by
  intro World OtherError E Ty A promote concatenate args world
  dsimp only
  rw [cat7_frontend_evaluate]
  cases hvalues : args.values with
  | nil =>
      simp only [ConcatCallsCanReturn, hvalues, true_or, iff_true,
        implies_true, and_true, ne_eq, not_true_eq_false,
        false_implies]
      exact ⟨_, rfl⟩
  | cons value rest =>
      have hne : args.values ≠ [] := by rw [hvalues]; intro h; cases h
      cases hp : promote args world with
      | none =>
          constructor
          · constructor
            · intro h; rcases h with ⟨returned, h⟩; cases h
            · intro h
              rcases h with h | ⟨first, next, hfirst, _⟩
              · exact False.elim (hne h)
              · rw [hp] at hfirst
                cases hfirst
          constructor
          · intro h; cases h
          · intro outcome final calls hobs; cases hobs
      | some first =>
          rcases first with ⟨first, middle⟩
          cases first with
          | error error =>
              constructor
              · constructor
                · intro _
                  exact Or.inr ⟨.error error, middle, hp, True.intro⟩
                · intro _
                  exact ⟨_, rfl⟩
              constructor
              · intro h; cases h
              intro outcome final calls hobs _
              cases hobs
              refine ⟨Or.inl ⟨error, rfl, rfl⟩, ?_, ?_⟩
              · intro before after values result hmem
                simp only [List.mem_singleton, StrideObservationStep.mk.injEq,
                  ConcatEvent.promotion.injEq] at hmem
                rcases hmem with ⟨rfl, rfl, rfl, rfl⟩
                exact hp
              · intro before after promoted values result hmem
                simp only [List.mem_singleton, StrideObservationStep.mk.injEq,
                  ] at hmem
                rcases hmem with ⟨_, _, h⟩
                cases h
          | ok promoted =>
              dsimp only
              cases hc : concatenate promoted args middle with
              | none =>
                  constructor
                  · constructor
                    · intro h; rcases h with ⟨returned, h⟩; cases h
                    · intro h
                      rcases h with h | ⟨first, next, hfirst, hret⟩
                      · exact False.elim (hne h)
                      · rw [hp] at hfirst
                        cases hfirst
                        rcases hret with ⟨result, after, hret⟩
                        rw [hc] at hret
                        cases hret
                  constructor
                  · intro h; cases h
                  · intro outcome final calls hobs; cases hobs
              | some second =>
                  rcases second with ⟨outcome, final⟩
                  constructor
                  · constructor
                    · intro _
                      exact Or.inr ⟨.ok promoted, middle, hp,
                        outcome, final, hc⟩
                    · intro _
                      exact ⟨_, rfl⟩
                  constructor
                  · intro h; cases h
                  intro result after calls hobs _
                  cases hobs
                  refine ⟨Or.inr ⟨promoted, middle, rfl⟩, ?_, ?_⟩
                  · intro before after values result hmem
                    simp only [List.mem_cons, List.not_mem_nil, or_false,
                      StrideObservationStep.mk.injEq,
                      ConcatEvent.promotion.injEq] at hmem
                    rcases hmem with hmem | hmem
                    · rcases hmem with ⟨rfl, rfl, rfl, rfl⟩
                      exact hp
                    · rcases hmem with ⟨_, _, h⟩
                      cases h
                  · intro before after selected values result hmem
                    simp only [List.mem_cons, List.not_mem_nil, or_false,
                      StrideObservationStep.mk.injEq,
                      ConcatEvent.concatenation.injEq] at hmem
                    rcases hmem with hmem | hmem
                    · rcases hmem with ⟨_, _, h⟩
                      cases h
                    · rcases hmem with ⟨rfl, rfl, rfl, rfl, rfl⟩
                      exact hc

