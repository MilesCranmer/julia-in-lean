theorem g1_run_bind {S A B : Type} (action : InterfaceM S A)
    (next : A → InterfaceM S B) (state : S) :
    (action >>= next).run state =
      match action.run state with
      | (.error error, after) => (.error error, after)
      | (.ok value, after) => (next value).run after := by
  change ExceptT.bindCont next (action.run state).1 (action.run state).2 = _
  rcases action.run state with ⟨outcome, after⟩
  cases outcome <;> rfl

theorem g1_run_pure {S A : Type} (value : A) (state : S) :
    (pure value : InterfaceM S A).run state = (.ok value, state) := rfl

theorem g1_run_throw {S A : Type} (error : ArrayError) (state : S) :
    (throw error : InterfaceM S A).run state = (.error error, state) := rfl

theorem g1_run_record {S E A : Type} (event : Except ArrayError A → E)
    (action : InterfaceM S A) (state : S) (log : List (InterfaceStep S E)) :
    (recordInterfaceCall event action).run (state, log) =
      let observed := action.run state
      (observed.1, (observed.2, log ++ [⟨state, observed.2, event observed.1⟩])) := rfl


