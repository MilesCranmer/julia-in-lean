inductive G11THStore (E : Type) where
  | linear (index : I64) (value : E)
  | cartesian (row column : I64) (value : E)

def g11thEvent {Ty Ref E : Type} (a : NativeMatrix Ty Ref)
    (request : G11THStore E) (result : Result Unit) : TypedHvcatEvent Ty Ref E :=
  match request with
  | .linear index value => .set a index value result
  | .cartesian row column value => .set2 a row column value result

def g11thPlacement {Ty Ref E : Type} (a : NativeMatrix Ty Ref) :
    G11THStore E → NativeMatrix Ty Ref × Int × E
  | .linear index value => (a, index.val, value)
  | .cartesian row column value => (a, row.val + (column.val - 1) * a.rows.val, value)

def G11THBound {Ty Ref E : Type} (a : NativeMatrix Ty Ref) : G11THStore E → Prop
  | .linear index _ => 1 ≤ index.val ∧ index.val ≤ a.rows.val * a.columns.val
  | .cartesian row column _ =>
      1 ≤ row.val ∧ row.val ≤ a.rows.val ∧ 1 ≤ column.val ∧ column.val ≤ a.columns.val

inductive G11THRun {Ty Ref E : Type} (a : NativeMatrix Ty Ref) :
    List (G11THStore E) → Result (NativeMatrix Ty Ref) →
      List (TypedHvcatEvent Ty Ref E) → Prop where
  | done : G11THRun a [] (.ok a) []
  | failure (request : G11THStore E) (rest : List (G11THStore E)) (error : ArrayError) :
      G11THRun a (request :: rest) (.error error) [g11thEvent a request (.error error)]
  | step (request : G11THStore E) (rest : List (G11THStore E))
      (result : Result (NativeMatrix Ty Ref)) (events : List (TypedHvcatEvent Ty Ref E)) :
      G11THRun a rest result events →
      G11THRun a (request :: rest) result (g11thEvent a request (.ok ()) :: events)

def G11THOutcome {Ty Ref E : Type} (a : NativeMatrix Ty Ref)
    (expected : List (NativeMatrix Ty Ref × Int × E))
    (result : Result (NativeMatrix Ty Ref)) (events : List (TypedHvcatEvent Ty Ref E)) : Prop :=
  TypedHvcatFailuresStop result events ∧ TypedHvcatTargetsAndBounds a events ∧
  (typedHvcatStorePlacements events).IsPrefix expected ∧
  match result with
  | .ok returned => returned = a ∧ typedHvcatStorePlacements events = expected ∧
      ∀ event ∈ events, typedHvcatRecordedError event = none
  | .error error =>
      ∃ event, events.getLast? = some event ∧ typedHvcatRecordedError event = some error

theorem g11th_event_error {Ty Ref E : Type} (a : NativeMatrix Ty Ref)
    (request : G11THStore E) (result : Result Unit) :
    typedHvcatRecordedError (g11thEvent a request result) =
      match result with | .ok _ => none | .error error => some error := by
  cases request <;> rfl

theorem g11th_event_placement {Ty Ref E : Type} (a : NativeMatrix Ty Ref)
    (request : G11THStore E) (result : Result Unit) (events : List (TypedHvcatEvent Ty Ref E)) :
    typedHvcatStorePlacements (g11thEvent a request result :: events) =
      g11thPlacement a request :: typedHvcatStorePlacements events := by
  cases request <;> rfl

theorem g11th_event_bound {Ty Ref E : Type} (a : NativeMatrix Ty Ref)
    (request : G11THStore E) (result : Result Unit) (bound : G11THBound a request) :
    TypedHvcatTargetsAndBounds a [g11thEvent a request result] := by
  intro event hevent
  have heq := List.mem_singleton.mp hevent
  subst event
  cases request <;> exact ⟨rfl, bound⟩

theorem g11th_failures_nil {Ty Ref E : Type} (result : Result (NativeMatrix Ty Ref)) :
    TypedHvcatFailuresStop result ([] : List (TypedHvcatEvent Ty Ref E)) := by
  intro before event after error he _
  have hl := congrArg List.length he
  simp only [List.length_nil, List.length_append, List.length_cons] at hl
  omega

theorem g11th_failures_singleton {Ty Ref E : Type} (event : TypedHvcatEvent Ty Ref E)
    (error : ArrayError) (herror : typedHvcatRecordedError event = some error) :
    TypedHvcatFailuresStop (.error error) [event] := by
  intro before selected after err he hs
  cases before with
  | nil =>
      change [event] = selected :: after at he
      cases he
      rw [herror] at hs
      have hh := Option.some.inj hs
      subst err
      exact ⟨rfl, rfl⟩
  | cons first rest =>
      have hl := congrArg List.length he
      simp only [List.length_nil, List.length_append, List.length_cons] at hl
      omega

theorem g11th_failures_cons {Ty Ref E : Type} (event : TypedHvcatEvent Ty Ref E)
    (events : List (TypedHvcatEvent Ty Ref E)) (result : Result (NativeMatrix Ty Ref))
    (herror : typedHvcatRecordedError event = none)
    (hrest : TypedHvcatFailuresStop result events) :
    TypedHvcatFailuresStop result (event :: events) := by
  intro before selected after error he hs
  cases before with
  | nil =>
      change event :: events = selected :: after at he
      cases he
      rw [herror] at hs
      cases hs
  | cons first before =>
      change event :: events = first :: (before ++ selected :: after) at he
      have eqs := List.cons.inj he
      exact hrest before selected after error eqs.2 hs

theorem g11th_run_outcome {Ty Ref E : Type} (a : NativeMatrix Ty Ref)
    (requests : List (G11THStore E)) (result : Result (NativeMatrix Ty Ref))
    (events : List (TypedHvcatEvent Ty Ref E)) (run : G11THRun a requests result events)
    (bounds : ∀ request ∈ requests, G11THBound a request) :
    G11THOutcome a (requests.map (g11thPlacement a)) result events := by
  induction run with
  | done =>
      refine ⟨g11th_failures_nil _, ?_, ⟨[], rfl⟩, rfl, rfl, ?_⟩
      · intro event hevent
        cases hevent
      · intro event hevent
        cases hevent
  | failure request rest error =>
      refine ⟨g11th_failures_singleton _ error (g11th_event_error ..),
        g11th_event_bound a request _ (bounds request (List.mem_cons_self ..)), ?_, ?_⟩
      · refine ⟨rest.map (g11thPlacement a), ?_⟩
        rw [g11th_event_placement]
        rfl
      · exact ⟨_, rfl, g11th_event_error ..⟩
  | step request rest result events run ih =>
      obtain ⟨hstop, htarget, hpref, hresult⟩ :=
        ih (fun request hrequest => bounds request (List.mem_cons_of_mem _ hrequest))
      refine ⟨g11th_failures_cons _ _ _ (g11th_event_error ..) hstop, ?_, ?_, ?_⟩
      · intro event hevent
        rcases List.mem_cons.mp hevent with rfl | hrest
        · exact g11th_event_bound a request _ (bounds request (List.mem_cons_self ..))
            _ (List.mem_singleton_self ..)
        · exact htarget event hrest
      · obtain ⟨suffix, hsuffix⟩ := hpref
        refine ⟨suffix, ?_⟩
        rw [g11th_event_placement, List.cons_append, hsuffix]
        rfl
      · cases result with
        | ok returned =>
            obtain ⟨hreturned, hstores, hsucceeded⟩ := hresult
            refine ⟨hreturned, ?_, ?_⟩
            · rw [g11th_event_placement, hstores]
              rfl
            · intro event hevent
              rcases List.mem_cons.mp hevent with rfl | hevent
              · exact g11th_event_error ..
              · exact hsucceeded event hevent
        | error error =>
            obtain ⟨last, hlast, herror⟩ := hresult
            refine ⟨last, ?_, herror⟩
            cases events with
            | nil => cases hlast
            | cons first tail => exact hlast

def g11thStore {m : Type → Type} {Ty Ref E : Type}
    (runtime : TypedHvcatArrayRuntime m Ty Ref E) (a : NativeMatrix Ty Ref) :
    G11THStore E → m Unit
  | .linear index value => runtime.set a index value
  | .cartesian row column value => runtime.set2 a row column value

def g11thStores {m : Type → Type} [Monad m] {Ty Ref E : Type}
    (runtime : TypedHvcatArrayRuntime m Ty Ref E) (a : NativeMatrix Ty Ref) :
    List (G11THStore E) → m (NativeMatrix Ty Ref)
  | [] => pure a
  | request :: rest => do
      g11thStore runtime a request
      g11thStores runtime a rest

theorem g11th_store_observe {World Ty Ref E : Type}
    (runtime : TypedHvcatArrayRuntime (HvcatPrimitive World) Ty Ref E)
    (a : NativeMatrix Ty Ref) (request : G11THStore E) (world : World)
    (events : List (TypedHvcatEvent Ty Ref E)) (audit : Option World) :
    (g11thStore (typedHvcatObserveRuntime runtime) a request).run (world, events, audit) =
      let observed := g11thStore runtime a request world
      (observed.1, (observed.2, events ++ [g11thEvent a request observed.1], some observed.2)) := by
  cases request <;> rfl

theorem g11th_stores_run {World Ty Ref E : Type}
    (runtime : TypedHvcatArrayRuntime (HvcatPrimitive World) Ty Ref E)
    (a : NativeMatrix Ty Ref) (requests : List (G11THStore E)) (world : World)
    (initialEvents : List (TypedHvcatEvent Ty Ref E)) :
    let observed := (g11thStores (typedHvcatObserveRuntime runtime) a requests).run
      (world, initialEvents, some world)
    ∃ events, observed.2.2.1 = initialEvents ++ events ∧
      observed.2.2.2 = some observed.2.1 ∧ G11THRun a requests observed.1 events := by
  induction requests generalizing world initialEvents with
  | nil =>
      refine ⟨[], ?_, rfl, G11THRun.done⟩
      exact (List.append_nil initialEvents).symm
  | cons request rest ih =>
      simp only [g11thStores, g1hv_state_run_bind, g11th_store_observe]
      cases hp : g11thStore runtime a request world with
      | mk result nextWorld =>
          cases result with
          | error error =>
              exact ⟨[g11thEvent a request (.error error)], rfl, rfl,
                G11THRun.failure request rest error⟩
          | ok ignored =>
              cases ignored
              obtain ⟨events, hevents, haudit, hrun⟩ :=
                ih nextWorld (initialEvents ++ [g11thEvent a request (.ok ())])
              refine ⟨g11thEvent a request (.ok ()) :: events, ?_, haudit, ?_⟩
              · simpa only [List.append_assoc, List.singleton_append] using hevents
              · exact G11THRun.step request rest _ events hrun


end JuliaLean.ChatGPT.Batch9.Group11

