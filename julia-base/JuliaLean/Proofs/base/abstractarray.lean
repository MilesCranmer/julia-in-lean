  ∀ (C E : Type) (elements : C → List E) (prepend : C → E → Result C),
    (∀ a x, ∃ out, prepend a x = .ok out ∧ elements out = x :: elements a) →
    ∀ a x y, ∃ out, pushfirstTwo prepend prepend a x y = .ok out ∧
      elements out = [x, y] ++ elements a

