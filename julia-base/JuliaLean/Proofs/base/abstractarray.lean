theorem g2ArgumentFold_post {W Acc Value : Type} (post : Acc → Prop)
    (op : Acc → Value → Boundary W Acc)
    (valid : ∀ a value, g2AllSuccess post (op a value))
    (a : Acc) (initial : post a) (bs : PromotionArgs Value) :
    g2AllSuccess post (argumentFold op a bs) := by
  unfold argumentFold
  cases bs.values with
  | nil => exact g2AllSuccess_pure post a initial
  | cons value rest => exact g2ArgumentFoldMany_post post op valid a initial bs

theorem g2Boundary_fst {W X : Type} (action : Boundary W X) (w : W) (x : X)
    (h : (action w).1 = .ok x) : action w = (.ok x, (action w).2) := by
  exact Prod.ext h rfl

theorem g2AllSuccess_mono {W X : Type} (pre post : X → Prop)
    (action : Boundary W X) (valid : g2AllSuccess pre action)
    (implication : ∀ x, pre x → post x) : g2AllSuccess post action := by
  intro w x h
  exact implication x (valid w x h)

theorem g2Eltypeof_leaf {W Scalar Arr Ty : Type}
    (typeof : Scalar → Ty) (eltype : Arr → Boundary W Ty)
    (promote : Ty → Ty → Boundary W Ty)
    (inputs : List (EltypeofArg Scalar Arr)) (a : EltypeofArg Scalar Arr)
    (member : a ∈ inputs) :
    g2AllSuccess (EltypeofTypeOrigin typeof eltype promote inputs)
      (eltypeofSelected typeof eltype a) := by
  cases a with
  | scalar value =>
      apply g2AllSuccess_pure
      exact Or.inl ⟨value, member, rfl⟩
  | array value =>
      intro world answer h
      exact Or.inr (Or.inl ⟨value, world, (eltype value world).2, member,
        g2Boundary_fst (eltype value) world answer h⟩)

theorem g2Eltypeof_promoted {W Scalar Arr Ty : Type}
    (typeof : Scalar → Ty) (eltype : Arr → Boundary W Ty)
    (promote : Ty → Ty → Boundary W Ty)
    (inputs : List (EltypeofArg Scalar Arr)) (left right : Ty) :
    g2AllSuccess (EltypeofTypeOrigin typeof eltype promote inputs)
      (promote left right) := by
  intro world answer h
  exact Or.inr (Or.inr ⟨left, right, world, (promote left right world).2,
    g2Boundary_fst (promote left right) world answer h⟩)

theorem g2Eltypeof_two {W Scalar Arr Ty : Type}
    (typeof : Scalar → Ty) (eltype : Arr → Boundary W Ty)
    (promote : Ty → Ty → Boundary W Ty)
    (inputs : List (EltypeofArg Scalar Arr)) (a b : EltypeofArg Scalar Arr) :
    g2AllSuccess (EltypeofTypeOrigin typeof eltype promote inputs)
      (promoteEltypeofTwoSelected typeof eltype promote a b) := by
  unfold promoteEltypeofTwoSelected promoteEltypeofTwo
  apply g2AllSuccess_bind
  intro left
  apply g2AllSuccess_bind
  intro right
  exact g2Eltypeof_promoted typeof eltype promote inputs left right

theorem g2Eltypeof_pair {W Scalar Arr Ty : Type}
    (typeof : Scalar → Ty) (eltype : Arr → Boundary W Ty)
    (promote : Ty → Ty → Boundary W Ty) (method : PromotionPairMethod Ty)
    (inputs : List (EltypeofArg Scalar Arr)) (a b : EltypeofArg Scalar Arr)
    (member : a ∈ inputs) :
    g2AllSuccess (fun answer =>
      EltypeofTypeOrigin typeof eltype promote inputs answer ∨ PairParameterOrigin method answer)
      (promoteEltypeofPairSelected typeof eltype promote method a b) := by
  cases method with
  | ordinary =>
      exact g2AllSuccess_mono _ _ _
        (g2Eltypeof_two typeof eltype promote inputs a b) (fun _ h => Or.inl h)
  | sameConcrete token =>
      exact g2AllSuccess_mono _ _ _
        (g2Eltypeof_leaf typeof eltype promote inputs a member) (fun _ h => Or.inl h)
  | arrayElement elementType =>
      apply g2AllSuccess_pure
      exact Or.inr rfl

theorem g2Eltypeof_many {W Scalar Arr Ty : Type}
    (typeof : Scalar → Ty) (eltype : Arr → Boundary W Ty)
    (promote : Ty → Ty → Boundary W Ty) (method : PromotionPairMethod Ty)
    (a b : EltypeofArg Scalar Arr) (vs : PromotionArgs (EltypeofArg Scalar Arr)) :
    g2AllSuccess (fun answer =>
      EltypeofTypeOrigin typeof eltype promote (a :: b :: vs.values) answer ∨
      PairParameterOrigin method answer)
      (promoteEltypeofManyClosed typeof eltype promote method a b vs) := by
  unfold promoteEltypeofManyClosed promoteEltypeofMany
  apply g2AllSuccess_bind_keep
    (pre := fun answer =>
      EltypeofTypeOrigin typeof eltype promote (a :: b :: vs.values) answer ∨
      PairParameterOrigin method answer)
  · exact g2Eltypeof_pair typeof eltype promote method _ a b (by simp)
  · intro initial initialValid
    apply g2ArgumentFold_post
    · intro left value
      apply g2AllSuccess_bind
      intro right
      exact g2AllSuccess_mono _ _ _
        (g2Eltypeof_promoted typeof eltype promote _ left right) (fun _ h => Or.inl h)
    · exact initialValid

theorem Models1G2EltypeofPromotionProvenance_proven : JuliaLean.Proofs.base.abstractarray.Models1Group2.EltypeofPromotionProvenance := by
  intro World Scalar Arr Ty Rest typeof eltype promote method a b vs rest world answer
  refine ⟨?_, ?_, ?_, ?_⟩
  · exact g2Eltypeof_leaf typeof eltype promote [a] a (by simp) world answer
  · exact g2Eltypeof_leaf typeof eltype promote [a] a (by simp) world answer
  · exact g2Eltypeof_two typeof eltype promote [a, b] a b world answer
  · exact g2Eltypeof_many typeof eltype promote method a b vs world answer

theorem Models1G2EltypePromotionProvenance_proven : JuliaLean.Proofs.base.abstractarray.Models1Group2.EltypePromotionProvenance := by
  intro World A B Value Ty Rest eltypeA eltypeB eltype eltypeType promote method typeToken a b vs rest world answer
  constructor
  · intro h
    exact ⟨(eltypeType typeToken world).2,
      g2Boundary_fst (eltypeType typeToken) world answer h⟩
  · let post := fun output =>
      (∃ queryWorld finalWorld, eltypeA a queryWorld = (.ok output, finalWorld)) ∨
      (∃ queryWorld finalWorld, eltypeB b queryWorld = (.ok output, finalWorld)) ∨
      (∃ input queryWorld finalWorld, input ∈ vs.values ∧
        eltype input queryWorld = (.ok output, finalWorld)) ∨
      (∃ token queryWorld finalWorld, eltypeType token queryWorld = (.ok output, finalWorld)) ∨
      (∃ left right queryWorld finalWorld, promote left right queryWorld = (.ok output, finalWorld)) ∨
      PairParameterOrigin method output
    have promoted (left right : Ty) : g2AllSuccess post (promote left right) := by
      intro queryWorld output h
      exact Or.inr (Or.inr (Or.inr (Or.inr (Or.inl
        ⟨left, right, queryWorld, (promote left right queryWorld).2,
          g2Boundary_fst (promote left right) queryWorld output h⟩))))
    have pairValid : g2AllSuccess post
        (promoteEltypePairSelected eltypeA eltypeB eltypeType promote method a b) := by
      cases method with
      | ordinary =>
          unfold promoteEltypePairSelected promoteEltypeTwo
          apply g2AllSuccess_bind
          intro left
          apply g2AllSuccess_bind
          intro right
          exact promoted left right
      | sameConcrete token =>
          intro queryWorld output h
          exact Or.inr (Or.inr (Or.inr (Or.inl
            ⟨token, queryWorld, (eltypeType token queryWorld).2,
              g2Boundary_fst (eltypeType token) queryWorld output h⟩)))
      | arrayElement elementType =>
          apply g2AllSuccess_pure
          exact Or.inr (Or.inr (Or.inr (Or.inr (Or.inr rfl))))
    have manyValid : g2AllSuccess post
        (promoteEltypeManyClosed eltypeA eltypeB eltype eltypeType promote method a b vs) := by
      unfold promoteEltypeManyClosed promoteEltypeMany
      apply g2AllSuccess_bind_keep (pre := post)
      · exact pairValid
      · intro initial initialValid
        apply g2ArgumentFold_post
        · intro left value
          apply g2AllSuccess_bind
          intro right
          exact promoted left right
        · exact initialValid
    exact manyValid world answer

theorem g2UIntAux_eq (needle : JInt .u64) (xs : List (JInt .u64)) (acc : Bool) :
    uintInTupleAux needle xs acc = (decide (needle ∈ xs) || acc) := by
  induction xs generalizing acc with
  | nil => simp [uintInTupleAux]
  | cons x xs ih =>
      by_cases equal : x = needle
      · subst x
        simp [uintInTupleAux]
      · have unequal : x.val ≠ needle.val := fun h => equal (Subtype.ext h)
        have reverseUnequal : needle ≠ x := Ne.symm equal
        simp [uintInTupleAux, unequal, reverseUnequal, ih]

theorem g2UIntAny_eq (needle : JInt .u64) (xs : List (JInt .u64)) :
    uintAnyTuple needle xs = decide (needle ∈ xs) := by
  induction xs with
  | nil => rfl
  | cons x xs ih =>
      by_cases equal : x = needle
      · subst x
        simp [uintAnyTuple, List.forIn_cons]
      · have unequal : x.val ≠ needle.val := fun h => equal (Subtype.ext h)
        have reverseUnequal : needle ≠ x := Ne.symm equal
        simpa [uintAnyTuple, List.forIn_cons, unequal, reverseUnequal] using ih

theorem g2UIntContains_eq (needle : JInt .u64) (xs : List (JInt .u64)) :
    uintTupleContains needle xs = decide (needle ∈ xs) := by
  unfold uintTupleContains
  split
  · exact g2UIntAny_eq needle xs
  · simpa only [Bool.or_false] using g2UIntAux_eq needle xs false

theorem g2Disjoint_eq (as bs : List (JInt .u64)) :
    uintDataIdsDisjoint as bs = JuliaLean.Proofs.base.abstractarray.disjointCalls as bs := by
  induction as generalizing bs with
  | nil =>
      cases bs with
      | nil => rfl
      | cons b bs => cases bs <;> rfl
  | cons a as ih =>
      cases as with
      | nil =>
          cases bs with
          | nil => rfl
          | cons b bs =>
              cases bs with
              | nil => rfl
              | cons b' bs =>
                  simp only [uintDataIdsDisjoint,
                    JuliaLean.Proofs.base.abstractarray.disjointCalls,
                    isdisjointOneMany, g2UIntContains_eq]
      | cons a' as =>
          cases bs with
          | nil => rfl
          | cons b bs =>
              cases bs with
              | nil =>
                  simp only [uintDataIdsDisjoint,
                    JuliaLean.Proofs.base.abstractarray.disjointCalls,
                    isdisjointManyOne, g2UIntContains_eq]
              | cons b' bs =>
                  simp only [uintDataIdsDisjoint,
                    JuliaLean.Proofs.base.abstractarray.disjointCalls,
                    isdisjointMany, g2UIntContains_eq, ih]

theorem g2Disjoint_true (as bs : List (JInt .u64)) :
    uintDataIdsDisjoint as bs = true ↔ ¬ ∃ id, id ∈ as ∧ id ∈ bs := by
  rw [g2Disjoint_eq, JuliaLean.Proofs.base.abstractarray.disjointCalls_correct]
  constructor
  · intro h ⟨id, ha, hb⟩
    exact h id ha hb
  · intro h id ha hb
    exact h ⟨id, ha, hb⟩

theorem g2Disjoint_false (as bs : List (JInt .u64)) :
    uintDataIdsDisjoint as bs = false ↔ ∃ id, id ∈ as ∧ id ∈ bs := by
  constructor
  · intro falseResult
    apply Classical.byContradiction
    intro absent
    have trueResult := (g2Disjoint_true as bs).2 absent
    rw [falseResult] at trueResult
    cases trueResult
  · intro common
    cases result : uintDataIdsDisjoint as bs with
    | false => rfl
    | true => exact False.elim (((g2Disjoint_true as bs).1 result) common)

theorem g2AliasObserve_run {X : Type} (event : AliasEvent) (reply : Result X)
    (initial : List AliasEvent) :
    aliasObserve event reply initial = (reply, initial ++ [event]) := by
  cases reply <;> rfl


