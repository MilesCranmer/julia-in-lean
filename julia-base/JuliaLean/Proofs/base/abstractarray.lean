theorem observationRunBind {S X Y : Type}
    (action : ExceptT ArrayError (StateM S) X)
    (next : X → ExceptT ArrayError (StateM S) Y) (s : S) :
    ((do let x ← action; next x).run s) =
      match action.run s with
      | (.error error, after) => (.error error, after)
      | (.ok value, after) => (next value).run after := by
  change (ExceptT.bindCont next (action.run s).1) (action.run s).2 = _
  cases h : action.run s with
  | mk result after => cases result <;> rfl

theorem observationRecordRun {World Event Value : Type}
    (event : Except ArrayError Value → Event) (operation : InterfaceM World Value)
    (world : World) (log : List (InterfaceStep World Event)) :
    (recordInterfaceCall event operation).run (world, log) =
      ((operation.run world).1,
        ((operation.run world).2,
         log ++ [⟨world, (operation.run world).2, event (operation.run world).1⟩])) := by
  rfl

theorem observationLengthAxisEq {World A Length Axis : Type} (style : Bool)
    (length : A → InterfaceM World Length) (oneto : Length → InterfaceM World Axis)
    (argument : A) :
    observeLengthAxis style length oneto argument =
      (do
        let len ← recordInterfaceCall (.length argument) (length argument)
        recordInterfaceCall (.oneto len) (oneto len)) := by
  cases style <;> rfl

theorem observationLengthAxisAccounting (style : Bool) : LengthAxisAccounting style := by
  intro World A Length Axis length oneto argument world
  rw [observationLengthAxisEq]
  cases hl : (length argument).run world with
  | mk outcome middle =>
    cases outcome with
    | error error =>
      simp only [observationRunBind, observationRecordRun, hl]
      exact ⟨⟨rfl, rfl⟩, Or.inl ⟨error, rfl, rfl⟩⟩
    | ok len =>
      cases ho : (oneto len).run middle with
      | mk outcome final =>
        simp only [observationRunBind, observationRecordRun, hl, ho]
        exact ⟨⟨rfl, rfl, rfl⟩, Or.inr ⟨len, rfl⟩⟩

