/-- A zero-dimensional array has no subscript coordinates. -/
def ZeroSubscriptsArity : Prop := ∀ (A : Type) (a : A),
  toSubscriptsZero a = ()

/-- A scalar linear index does not introduce dimensions into a zero-dimensional array. -/
def ZeroScalarSubscriptsArity : Prop := ∀ (A I : Type) (a : A) (i : I),
  toSubscriptsZeroScalar a i = ()

/-- Any integer argument tuple leaves zero-dimensional coordinate arity zero. -/
def ZeroManySubscriptsArity : Prop := ∀ (A I : Type) (a : A) (indices : Tuple I),
  toSubscriptsZeroMany a indices = ()

/-- Canonical coordinates retain each original component in its original position. -/
def ExactSubscriptsComponents : Prop := ∀ (A : Type) (n : Nat) (a : A)
