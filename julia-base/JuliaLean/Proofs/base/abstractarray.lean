theorem observationRunPure {S X : Type} (value : X) (state : S) :
    ((pure value : ExceptT ArrayError (StateM S) X).run state) = (.ok value, state) := by
  rfl

theorem observationRunThrow {S X : Type} (error : ArrayError) (state : S) :
    ((throw error : ExceptT ArrayError (StateM S) X).run state) = (.error error, state) := by
  rfl

theorem observationOffsetPrefixNil {S X : Type} (visit : X → S → S → Prop) (s : S) :
    offsetPrefix visit [] s s := by
  refine ⟨[s], rfl, rfl, rfl, ?_⟩
  intro k x a b hx
  simp only [List.getElem?_nil] at hx
  cases hx

theorem observationOffsetPrefixCons {S X : Type} (visit : X → S → S → Prop)
    (x : X) (xs : List X) (before middle after : S)
    (head : visit x before middle) (tail : offsetPrefix visit xs middle after) :
    offsetPrefix visit (x :: xs) before after := by
  rcases tail with ⟨states, hlen, hhead, hlast, hstep⟩
  cases states with
  | nil =>
    simp only [List.length_nil] at hlen
    omega
  | cons first rest =>
    have heq : first = middle := Option.some.inj hhead
    subst first
    refine ⟨before :: middle :: rest, ?_, rfl, ?_, ?_⟩
    · simp only [List.length_cons] at hlen ⊢
      omega
    · exact hlast
    · intro k y s t hx hs ht
      cases k with
      | zero =>
        have hxy : x = y := Option.some.inj hx
        have hbs : before = s := Option.some.inj hs
        have hmt : middle = t := Option.some.inj ht
        subst y
        subst s
        subst t
        exact head
      | succ k =>
        exact hstep k y s t hx hs ht


def observationAxisListOutcome {S A V C R I N : Type}
    (ops : OffsetOps (OffsetState S) A V C R I N)
    (axes : List R) (before : S) (outcome : Except ArrayError Bool × S) : Prop :=
  match outcome with
  | (.ok false, after) => offsetPrefix (offsetAxisOne ops) axes before after
  | (.ok true, after) =>
      ∃ (visited suffix : List R) (axis : R) (decisive : S),
        axes = visited ++ axis :: suffix ∧
        offsetPrefix (offsetAxisOne ops) visited before decisive ∧
        offsetAxisAway ops axis decisive after
  | (.error error, after) =>
      ∃ (visited suffix : List R) (axis : R) (decisive : S),
        axes = visited ++ axis :: suffix ∧
        offsetPrefix (offsetAxisOne ops) visited before decisive ∧
        offsetAxisError ops axis decisive after error

theorem observationAxisListPrepend {S A V C R I N : Type}
    (ops : OffsetOps (OffsetState S) A V C R I N)
    (axis : R) (rest : List R) (before middle : S)
    (head : offsetAxisOne ops axis before middle)
    (outcome : Except ArrayError Bool × S)
    (tail : observationAxisListOutcome ops rest middle outcome) :
    observationAxisListOutcome ops (axis :: rest) before outcome := by
  rcases outcome with ⟨result, after⟩
  cases result with
  | error error =>
    rcases tail with ⟨visited, suffix, decisiveAxis, decisive, shape, priorVisits, last⟩
    refine ⟨axis :: visited, suffix, decisiveAxis, decisive, ?_, ?_, last⟩
    · rw [shape]
      rfl
    · exact observationOffsetPrefixCons _ _ _ _ _ _ head priorVisits
  | ok value =>
    cases value with
    | false => exact observationOffsetPrefixCons _ _ _ _ _ _ head tail
    | true =>
      rcases tail with ⟨visited, suffix, decisiveAxis, decisive, shape, priorVisits, last⟩
      refine ⟨axis :: visited, suffix, decisiveAxis, decisive, ?_, ?_, last⟩
      · rw [shape]
        rfl
      · exact observationOffsetPrefixCons _ _ _ _ _ _ head priorVisits

theorem observationAnyOffsetCons {S A V C R I N : Type}
    (ops : OffsetOps (OffsetState S) A V C R I N)
    (axis : R) (rest : List R) (before : S) :
    offsetObserve (anyOffsetAxis ops (axis :: rest)) before =
      match offsetObserve (ops.first axis) before with
      | (.error error, middle) => (.error error, middle)
      | (.ok index, middle) =>
        match offsetObserve (ops.toInt index) middle with
        | (.error error, after) => (.error error, after)
        | (.ok (.rejected _), after) => (.error (.showError .typeError), after)
        | (.ok (.accepted native), after) =>
          if native.val != 1 then (.ok true, after)
          else offsetObserve (anyOffsetAxis ops rest) after := by
  simp only [offsetObserve, anyOffsetAxis, observationRunBind]
  cases hf : (ops.first axis).run before with
  | mk result middle =>
    cases result with
    | error error => rfl
    | ok index =>
      dsimp only
      cases hc : (ops.toInt index).run middle with
      | mk result after =>
        cases result with
        | error error => rfl
        | ok tag =>
          cases tag with
          | rejected outside => rfl
          | accepted native =>
            change (if (native.val != 1) = true then pure true
              else anyOffsetAxis ops rest).run after = _
            by_cases h : (native.val != 1) = true
            · simp only [h, ite_true, observationRunPure]
            · simp only [h, Bool.false_eq_true, ite_false]

theorem observationAnyOffsetAxis {S A V C R I N : Type}
    (ops : OffsetOps (OffsetState S) A V C R I N)
    (axes : List R) (before : S) :
    observationAxisListOutcome ops axes before
      (offsetObserve (anyOffsetAxis ops axes) before) := by
  induction axes generalizing before with
  | nil => exact observationOffsetPrefixNil _ before
  | cons axis rest ih =>
    rw [observationAnyOffsetCons]
    cases hf : offsetObserve (ops.first axis) before with
    | mk result middle =>
      cases result with
      | error error =>
        exact ⟨[], rest, axis, before, rfl, observationOffsetPrefixNil _ _, Or.inl hf⟩
      | ok index =>
        dsimp only
        cases hc : offsetObserve (ops.toInt index) middle with
        | mk converted after =>
          cases converted with
          | error error =>
            exact ⟨[], rest, axis, before, rfl, observationOffsetPrefixNil _ _,
              Or.inr ⟨index, middle, hf, Or.inl hc⟩⟩
          | ok tag =>
            cases tag with
            | rejected outside =>
              exact ⟨[], rest, axis, before, rfl, observationOffsetPrefixNil _ _,
                Or.inr ⟨index, middle, hf, Or.inr ⟨outside, hc, rfl⟩⟩⟩
            | accepted native =>
              by_cases hone : native.val = 1
              · simp only [bne_iff_ne, hone, ne_eq, not_true_eq_false, ite_false]
                exact observationAxisListPrepend ops axis rest before after
                  ⟨index, native, middle, hf, hc, hone⟩ _ (ih after)
              · simp only [bne_iff_ne, ne_eq, hone, not_false_eq_true, ite_true]
                exact ⟨[], rest, axis, before, rfl, observationOffsetPrefixNil _ _,
                  index, native, middle, hf, hc, hone⟩

theorem Models1G1OffsetGenericObservation_proven :
    JuliaLean.Proofs.base.abstractarray.Models1Group1.OffsetGenericEarliestObservation := by
  intro S A V C R I N ops a before
  change offsetArrayObservation ops a before ((hasOffset ops a).run before)
  rw [hasOffset, observationRunBind]
  cases ha : (ops.axes a).run before with
  | mk result start =>
    cases result with
    | error error => exact Or.inl ha
    | ok axes =>
      dsimp only
      have observed := observationAnyOffsetAxis ops axes.values start
      simp only [offsetObserve] at observed
      cases hr : (anyOffsetAxis ops axes.values).run start with
      | mk result after =>
        rw [hr] at observed
        cases result with
        | error error =>
          rcases observed with ⟨visited, suffix, axis, decisive, shape, priorVisits, last⟩
          exact Or.inr ⟨axes, start, visited, suffix, axis, decisive, ha, shape, priorVisits, last⟩
        | ok value =>
          cases value with
          | false => exact ⟨axes, start, ha, observed⟩
          | true =>
            rcases observed with ⟨visited, suffix, axis, decisive, shape, priorVisits, last⟩
            exact ⟨axes, start, visited, suffix, axis, decisive, ha, shape, priorVisits, last⟩


