/-- Inspect a returned observation, without invoking a selected call. -/
def trailingSelectedFailure {Value : Type} : Except Error Value → Option Error
  | .error error => some error
  | .ok _ => none

def trailingEventFailure : Event → Option Error
  | .ndims _ outcome => trailingSelectedFailure outcome
  | .colonArray _ _ outcome => trailingSelectedFailure outcome
  | .colonIndices _ _ outcome => trailingSelectedFailure outcome
  | .size _ _ outcome => trailingSelectedFailure outcome
  | .getindex _ _ outcome => trailingSelectedFailure outcome
  | .length _ outcome => trailingSelectedFailure outcome
  | .multiply _ _ outcome => trailingSelectedFailure outcome
  | .iterate _ _ outcome => trailingSelectedFailure outcome

/-- Every first selected failure ends observation immediately and supplies the
same output error. Conversely no source error is invented by the wrapper. -/
def TrailingExceptionProvenance
    (outcome : Except (TrailingObservationError Error) (RuntimeValue Other))
    (calls : List Event) : Prop :=
  (∀ before event after error,
    calls = before ++ event :: after → trailingEventFailure event = some error →
      after = [] ∧ outcome = .error (.runtime error)) ∧
  (∀ error, outcome = .error (.runtime error) →
    ∃ before event, calls = before ++ [event] ∧ trailingEventFailure event = some error)

