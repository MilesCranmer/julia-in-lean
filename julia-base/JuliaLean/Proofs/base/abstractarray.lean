        (log ++ [(o, i, c)]) = _
      have step := ih (preO ++ [o]) cs (preC ++ [c]) (log ++ [(o, i, c)])
        (by rw [hO]; simp) (by rw [hC]; simp) (by simp [hpre]) lenEq
      rw [show 1 + ((preO ++ [o]).length : Int) = 1 + (preO.length : Int) + 1 by
        simp only [List.length_append, List.length_cons, List.length_nil]; omega] at step
      rw [step]
      simp [List.append_assoc]

