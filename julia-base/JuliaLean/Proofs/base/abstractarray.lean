    ∀ (os : List Out) (preO : List Out) (cs preC : List Coordinate) log,
      outs = preO ++ os → s = preC ++ cs → preO.length = preC.length → os.length = cs.length →
      (forIn (nativePositions (1 + preO.length) os.length) () body).run log =
        pure ((), log ++ (os.zip cs).map (fun oc => (oc.1, i, oc.2))) := by
  intro os
  induction os with
  | nil => intro preO cs preC log _ _ _ _; simp [nativePositions, StateT.run, StateT.pure]
  | cons o os ih =>
    intro preO cs preC log hO hC hpre hlen
    cases cs with
    | nil => simp at hlen
    | cons c cs =>
      have lenEq : os.length = cs.length := by simpa using hlen
      have getO : tupleGet outs (int (1 + preO.length)) = .ok o :=
        tupleGet_at outs preO os o _ hO rfl (by omega)
      have getC : tupleGet s (int (1 + preO.length)) = .ok c :=
        tupleGet_at s preC cs c _ hC (by omega) (by
          have : s.length = outs.length := by
            rw [hO, hC]; simp only [List.length_append, List.length_cons]; omega
