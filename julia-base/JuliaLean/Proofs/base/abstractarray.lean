inductive VectorSliceCall (A Requested Index Length Count Range Out NotBool : Type) where
  | negative (requested : Requested) (outcome : Except ArrayError (TypeAssertion Bool NotBool))
  | endpoint (array : A) (outcome : Except ArrayError Index)
  | length (array : A) (outcome : Except ArrayError Length)
  | minimum (requested : Requested) (length : Length) (outcome : Except ArrayError Count)
  | range (endpoint : Index) (count : Count) (outcome : Except ArrayError Range)
  | get (array : A) (range : Range) (outcome : Except ArrayError Out)

/-- Relational accounting for all possible termination points. Call events
carry their actual returned payloads; every later call must use those same
payloads and the original requested integer. An error ends the log immediately,
and direct source errors have the required exception class. This is a finite
observation invariant, not a second executable implementation of the calls.
-/
def VectorSliceOutcome {A Requested Index Length Count Range Out NotBool : Type}
    (array : A) (requested : Requested) (outcome : Except ArrayError Out)
    (calls : List (VectorSliceCall A Requested Index Length Count Range Out NotBool)) : Prop :=
  (∃ error, calls = [.negative requested (.error error)] ∧ outcome = .error error) ∨
  (∃ outside, calls = [.negative requested (.ok (.rejected outside))] ∧
    outcome = .error (.showError .typeError)) ∨
  (calls = [.negative requested (.ok (.accepted true))] ∧
    ∃ message, outcome = .error (.julia (.argumentError message))) ∨
  (∃ error, calls = [.negative requested (.ok (.accepted false)),
      .endpoint array (.error error)] ∧ outcome = .error error) ∨
  (∃ endpoint error, calls = [.negative requested (.ok (.accepted false)),
      .endpoint array (.ok endpoint), .length array (.error error)] ∧
    outcome = .error error) ∨
  (∃ endpoint length error, calls = [.negative requested (.ok (.accepted false)),
      .endpoint array (.ok endpoint), .length array (.ok length),
      .minimum requested length (.error error)] ∧ outcome = .error error) ∨
  (∃ endpoint length count error, calls = [.negative requested (.ok (.accepted false)),
      .endpoint array (.ok endpoint), .length array (.ok length),
      .minimum requested length (.ok count), .range endpoint count (.error error)] ∧
    outcome = .error error) ∨
  (∃ endpoint length count range, calls = [.negative requested (.ok (.accepted false)),
      .endpoint array (.ok endpoint), .length array (.ok length),
      .minimum requested length (.ok count), .range endpoint count (.ok range),
      .get array range outcome])

def observeVectorSlice {World A Requested Index Length Count Range Out NotBool : Type}
    (suffix : Bool) (negative : Requested → InterfaceM World (TypeAssertion Bool NotBool))
    (endpoint : A → InterfaceM World Index) (length : A → InterfaceM World Length)
    (minimum : Requested → Length → InterfaceM World Count)
    (range : Index → Count → InterfaceM World Range)
    (get : A → Range → InterfaceM World Out) (array : A) (requested : Requested) :
    InterfaceM (World × List (InterfaceStep World
      (VectorSliceCall A Requested Index Length Count Range Out NotBool))) Out :=
  let negative' := fun n => recordInterfaceCall (.negative n) (negative n)
  let endpoint' := fun a => recordInterfaceCall (.endpoint a) (endpoint a)
  let length' := fun a => recordInterfaceCall (.length a) (length a)
  let minimum' := fun n len => recordInterfaceCall (.minimum n len) (minimum n len)
  let range' := fun endpoint count => recordInterfaceCall (.range endpoint count) (range endpoint count)
  let get' := fun a r => recordInterfaceCall (.get a r) (get a r)
  if suffix then
    JuliaLean.base.abstractarray.Models1Group1.lastVectorN negative' endpoint' length'
      minimum' range' get' array requested
  else
    JuliaLean.base.abstractarray.Models1Group1.firstVectorN negative' endpoint' length'
      minimum' range' get' array requested

def VectorSliceAccounting (suffix : Bool) : Prop :=
  ∀ (World A Requested Index Length Count Range Out NotBool : Type)
    (negative : Requested → InterfaceM World (TypeAssertion Bool NotBool))
    (endpoint : A → InterfaceM World Index) (length : A → InterfaceM World Length)
    (minimum : Requested → Length → InterfaceM World Count)
    (range : Index → Count → InterfaceM World Range)
    (get : A → Range → InterfaceM World Out) (array : A) (requested : Requested) (world : World),
    let observed := (observeVectorSlice suffix negative endpoint length minimum range get
      array requested).run (world, [])
    InterfaceStateContinuity world observed.2.1 observed.2.2 ∧
      VectorSliceOutcome array requested observed.1 (observed.2.2.map (·.event))

/-- first(v,n) checks the selected n<0 result before any array observation:
true raises ArgumentError; a non-Bool raises TypeError; a comparison exception
propagates. Otherwise the first index precedes checked length, minimum, range
construction and indexing. All original integer and intermediate payloads are
conserved without narrowing, as are every selected exception and state effect.

