/-- Copying a sized iterable into a nonempty destination at `dstart`
(`copyto!(dest, dstart, src)`) returns the destination untouched for an empty
source, propagates the destination's bounds-check failure at `dstart`, and
raises `BoundsError` when fewer than `length(src)` positions remain from
`dstart` to `lastindex(dest)`, before any element is written. -/
def IterableCopyAtRejections : Prop :=
  ∀ (D E Start Range End Difference Span : Type)
    (cast : Start → Result I64) (length : D → Result I64) (sourceCount : I64)
    (axes : D → Result (List Range)) (last : Range → Result End)
    (checked : D → I64 → Result Unit)
    (sub : End → I64 → Result Difference) (addOne : Difference → Result Span)
    (le : I64 → Span → Result Bool)
    (write : Bool → D → I64 → E → StateT (Heap I64 E) Result Unit)
    (dest : D) (rawStart : Start) (values : List E) (start : Int)
    (destCount : I64) (heap : Heap I64 E),
    cast rawStart = .ok (int start) → length dest = .ok destCount →
    0 < destCount.val →
    let run := (sourceIterableCopyAt true cast length sourceCount axes last checked sub
      addOne le write dest rawStart values).run heap
    (sourceCount.val = 0 → run = .ok (dest, heap)) ∧
    (∀ error, sourceCount.val ≠ 0 → checked dest (int start) = .error error →
      run = .error error) ∧
    (∀ (range : Range) (endIndex : End) (difference : Difference) (span : Span),
      sourceCount.val ≠ 0 → checked dest (int start) = .ok () →
      axes dest = .ok [range] → last range = .ok endIndex →
      sub endIndex (int start) = .ok difference → addOne difference = .ok span →
      le sourceCount span = .ok false → run = .error (.julia .boundsError))

theorem iterableCopyAtRejections_proven : IterableCopyAtRejections := by
  intro D E Start Range End Difference Span cast length sourceCount axes last checked sub
    addOne le write dest rawStart values start destCount heap converted sized positive
  have one : (int 1).val = 1 := rfl
  refine ⟨?_, ?_, ?_⟩
  · intro empty
    simp [sourceIterableCopyAt, copytoIterableAt, converted, sized, positive, empty,
      StateT.run, StateT.bind, StateT.pure, StateT.lift]
  · intro error nonzero failed
    simp [sourceIterableCopyAt, copytoIterableAt, converted, sized, positive, nonzero,
      failed, StateT.run, StateT.bind, StateT.pure, StateT.lift]
  · intro range endIndex difference span nonzero boundsLaw axesLaw lastLaw subLaw addLaw short
    simp [sourceIterableCopyAt, copytoIterableAt, converted, sized, positive, nonzero,
      axesLaw, lastLaw, boundsLaw, subLaw, addLaw, short, lastindexArray,
      eachindexLinearVector, axes1, tupleGet, one, StateT.run, StateT.bind, StateT.pure,
      StateT.lift]
    rfl


/-- The elements `start, start + step, ...` of a native `Int` range of the given
length, with native wrapping addition. -/
def nativeProgression (start step : I64) : Nat → List I64
  | 0 => []
  | n + 1 => start :: nativeProgression (start + step) step n

/-- Block copying with ranges represented by their elements, foreign bounds
checks and unaliasing, a source read function, and a write log recording each
`(row, column)` assignment of the destination in order. -/
def blockCopyTrace {D S E : Type}
    (checkDest : D → List I64 → List I64 → Result Unit)
    (checkSrc : S → List I64 → List I64 → Result Unit)
    (unalias : D → S → Result S) (first step : List I64 → I64)
    (read : S → I64 → I64 → E)
    (dest : D) (irDest jrDest : List I64) (src : S) (irSrc jrSrc : List I64) :
    StateT (List ((I64 × I64) × E)) Result D :=
  copytoBlock (fun axis => pure (int axis.length))
    (fun d rows cols => StateT.lift (checkDest d rows cols))
    (fun a rows cols => StateT.lift (checkSrc a rows cols))
    (fun d a => StateT.lift (unalias d a))
    (fun range => pure (first range)) (fun range => pure (step range))
    (fun a i j => pure (read a i j))
    (fun _ i j value => modify (fun log => log ++ [((i, j), value)]))
    dest irDest jrDest src irSrc jrSrc

/-- The value of a native `Int` counter after `n` native additions of `step`. -/
def nativeAfter (start step : I64) : Nat → I64
  | 0 => start
  | n + 1 => nativeAfter (start + step) step n

theorem nativeProgression_length (start step : I64) (n : Nat) :
    (nativeProgression start step n).length = n := by
  induction n generalizing start with
  | zero => rfl
  | succ n ih => simp [nativeProgression, ih]

theorem blockRowTrace {E : Type} (xs : List I64) (value : I64 → E) (jdest s : I64) :
    ∀ (idest : I64) (log : List ((I64 × I64) × E)),
    (forIn xs idest (fun isrc i => do
        modify fun log => log ++ [((i, jdest), value isrc)]
        pure (ForInStep.yield (i + s))) :
          StateT (List ((I64 × I64) × E)) Result I64).run log =
      .ok (nativeAfter idest s xs.length,
        log ++ (xs.zip (nativeProgression idest s xs.length)).map
          (fun p => ((p.2, jdest), value p.1))) := by
  induction xs with
  | nil =>
    intro idest log
    simp [List.forIn_nil, nativeAfter, nativeProgression, StateT.run, StateT.pure]
  | cons x xs ih =>
    intro idest log
    have tail := ih (idest + s) (log ++ [((idest, jdest), value x)])
    simp only [List.forIn_cons, StateT.run, StateT.bind, StateT.pure, bind, pure,
      modify, modifyGet, MonadStateOf.modifyGet, StateT.modifyGet] at tail ⊢
    simp only [Except.bind, Except.pure, List.length_cons, nativeAfter,
      nativeProgression, List.zip_cons_cons, List.map_cons, List.append_assoc,
      List.singleton_append] at tail ⊢
    exact tail

theorem blockColumnsTrace {E : Type} (ys xs : List I64) (value : I64 → I64 → E)
    (i0 si s : I64) :
    ∀ (jdest : I64) (log : List ((I64 × I64) × E)),
    (forIn ys jdest (fun jsrc j => do
        let _ ← forIn xs i0 (fun isrc i => do
          modify fun log => log ++ [((i, j), value isrc jsrc)]
          pure (ForInStep.yield (i + si)))
        pure (ForInStep.yield (j + s))) :
          StateT (List ((I64 × I64) × E)) Result I64).run log =
      .ok (nativeAfter jdest s ys.length,
        log ++ (ys.zip (nativeProgression jdest s ys.length)).flatMap
          (fun q => (xs.zip (nativeProgression i0 si xs.length)).map
            (fun p => ((p.2, q.2), value p.1 q.1)))) := by
  induction ys with
  | nil =>
    intro jdest log
    simp [List.forIn_nil, nativeAfter, nativeProgression, StateT.run, StateT.pure]
  | cons y ys ih =>
    intro jdest log
    have row := blockRowTrace xs (fun isrc => value isrc y) jdest si i0 log
    have tail := ih (jdest + s) (log ++ (xs.zip (nativeProgression i0 si xs.length)).map
      (fun p => ((p.2, jdest), value p.1 y)))
    simp only [List.forIn_cons, StateT.run, StateT.bind, StateT.pure, bind, pure] at row tail ⊢
    rw [row]
    simp only [Except.bind, Except.pure, List.length_cons, nativeAfter,
      nativeProgression, List.zip_cons_cons, List.flatMap_cons, List.append_assoc] at tail ⊢
    exact tail

/-- Block copying `copyto!(B, ir_dest, jr_dest, A, ir_src, jr_src)` with equal
range lengths and destination ranges that are native arithmetic progressions
propagates a failed destination or source bounds check, and otherwise assigns
`B[ir_dest[p], jr_dest[q]] = A[ir_src[p], jr_src[q]]` for every pair, columns
outer and rows inner, reading the unaliased source, and performs no other
assignment. -/
def BlockCopyContents : Prop :=
  ∀ (D S E : Type)
    (checkDest : D → List I64 → List I64 → Result Unit)
    (checkSrc : S → List I64 → List I64 → Result Unit)
    (unalias : D → S → Result S) (first step : List I64 → I64)
    (read : S → I64 → I64 → E)
    (dest : D) (irDest jrDest : List I64) (src : S) (irSrc jrSrc : List I64)
    (log : List ((I64 × I64) × E)),
    nativeProgression (first irDest) (step irDest) irSrc.length = irDest →
    nativeProgression (first jrDest) (step jrDest) jrSrc.length = jrDest →
    let run := (blockCopyTrace checkDest checkSrc unalias first step read dest
      irDest jrDest src irSrc jrSrc).run log
    (∀ error, checkDest dest irDest jrDest = .error error → run = .error error) ∧
    (∀ error, checkDest dest irDest jrDest = .ok () →
      checkSrc src irSrc jrSrc = .error error → run = .error error) ∧
    (∀ src', checkDest dest irDest jrDest = .ok () → checkSrc src irSrc jrSrc = .ok () →
      unalias dest src = .ok src' → read src' = read src →
      run = .ok (dest, log ++ (jrSrc.zip jrDest).flatMap
        (fun q => (irSrc.zip irDest).map (fun p => ((p.2, q.2), read src p.1 q.1)))))

theorem blockCopyContents_proven : BlockCopyContents := by
  intro D S E checkDest checkSrc unalias first step read dest irDest jrDest src irSrc jrSrc
    log rowsProgression colsProgression
  have rows : irDest.length = irSrc.length := by
    rw [← rowsProgression, nativeProgression_length]
  have cols : jrDest.length = jrSrc.length := by
    rw [← colsProgression, nativeProgression_length]
  refine ⟨?_, ?_, ?_⟩
  · intro error destFail
    simp only [blockCopyTrace, copytoBlock, rows, cols, bne_self_eq_false,
      Bool.false_eq_true, ↓reduceIte, destFail, pure_bind]
    rfl
  · intro error destOk srcFail
    simp only [blockCopyTrace, copytoBlock, rows, cols, bne_self_eq_false,
      Bool.false_eq_true, ↓reduceIte, destOk, srcFail, pure_bind]
    rfl
  · intro src' destOk srcOk aliasOk sameRead
    simp only [blockCopyTrace, copytoBlock, rows, cols, bne_self_eq_false,
      Bool.false_eq_true, ↓reduceIte, destOk, srcOk, aliasOk, pure_bind]
    simp only [StateT.run_bind, StateT.run_lift, blockColumnsTrace, sameRead]
    rw [rowsProgression, colsProgression]
    simp only [bind, Except.bind, pure, Except.pure, StateT.run, StateT.pure, sameRead]

/-- Array copying from a valid source offset forwards the destination, its
start, the source, the offset and the remaining source count
`last(LinearIndices(src)) - sstart + 1` (native arithmetic) to counted copying. -/
def ArrayCopyFromForwards : Prop :=
  ∀ (D S : Type) (indices : CopyLinearIndices)
    (copy : D → I64 → S → I64 → I64 → Result D)
    (dest : D) (dstart : I64) (src : S) (sstart : I64),
    indices.first.val ≤ sstart.val → sstart.val ≤ indices.last.val →
    copytoArrayFrom (fun _ => pure indices) copyLinearBounds
      (fun indices => pure indices.last) (fun stop start => pure (stop - start))
      (fun difference => pure (difference + int 1)) copy dest dstart src sstart =
      copy dest dstart src sstart (indices.last - sstart + int 1)

theorem arrayCopyFromForwards_proven : ArrayCopyFromForwards := by
  intro D S indices copy dest dstart src sstart low high
  simp [copytoArrayFrom, copyLinearBounds_formula, low, high]

/-- `copyto!(dest, src)` and `copyto!(deststyle, dest, srcstyle, src)`: every
source element lands in order in the destination prefix for all style pairs,
and the unaliased copy rejects a destination too short for the source before
any write. -/
def ArrayCopyContract : Prop :=
  ArrayCopyPreservesElements ∧ UnaliasedCopySpecification

theorem arrayCopyContract_proven : ArrayCopyContract :=
  ⟨arrayCopyPreservesElements_proven, unaliasedCopySpecification_proven⟩

/-- `copyto!(dest, dstart, src, sstart, n)`: positive counts copy exactly `n`
elements in order; zero counts, negative counts and out-of-range starts or
counts take the source's early exits. -/
def CountedArrayCopyContract : Prop :=
  CountedArrayCopyContents ∧ CountedArrayCopyEarlyExits

theorem countedArrayCopyContract_proven : CountedArrayCopyContract :=
  ⟨countedArrayCopyContents_proven, countedArrayCopyEarlyExits_proven⟩

/-- `copyto!(dest, dstart, src)` for an iterable: sized and unknown-length
sources write consecutive positions from `dstart`, and the sized path's empty
source, bounds-check failure and short-destination error behave as in the
source. -/
def IterableCopyAtContract : Prop :=
  IterableCopyAtContents ∧ IterableCopyAtUnknownLength ∧ IterableCopyAtRejections

theorem iterableCopyAtContract_proven : IterableCopyAtContract :=
  ⟨iterableCopyAtContents_proven, iterableCopyAtUnknownLength_proven,
    iterableCopyAtRejections_proven⟩

/-- `copyto!(dest, dstart, src, sstart)`: an offset outside the source's linear
axis raises `BoundsError`; a valid one copies the rest of the source through
counted copying. -/
def ArrayCopyFromContract : Prop :=
  ArrayCopyFromRejectsInvalidStart ∧ ArrayCopyFromForwards

theorem arrayCopyFromContract_proven : ArrayCopyFromContract :=
  ⟨arrayCopyFromRejectsInvalidStart_proven, arrayCopyFromForwards_proven⟩

/-- Block `copyto!`: unequal range lengths raise `ArgumentError`, failed bounds
checks propagate, and otherwise each `B[ir_dest[p], jr_dest[q]]` receives
`A[ir_src[p], jr_src[q]]` in column order. -/
def BlockCopyContract : Prop :=
  BlockCopyRejectsSizeMismatch ∧ BlockCopyContents

theorem blockCopyContract_proven : BlockCopyContract :=
  ⟨blockCopyRejectsSizeMismatch_proven, blockCopyContents_proven⟩

/-- Array iteration: linear iteration visits each axis position from the first
index and stops outside the axis; Cartesian iteration yields the elements at its
index sequence in order. -/
def ArrayIterationContract : Prop :=
  LinearIterationPositions ∧ CartesianIterationOrder

theorem arrayIterationContract_proven : ArrayIterationContract :=
  ⟨linearIterationPositions_proven, cartesianIterationOrder_proven⟩

/-- Bounds checking: one scalar index is valid exactly within the linear axis,
Cartesian indices are checked axis by axis with singleton omitted dimensions
and extra indices equal to one, and no indices require every axis to be a
singleton. -/
def CheckboundsContract : Prop :=
  LinearBoundsCoordinates ∧ CartesianCoordinateBounds ∧ OmittedSingletonBounds

theorem checkboundsContract_proven : CheckboundsContract :=
  ⟨linearBoundsCoordinates_proven, cartesianCoordinateBounds_proven,
    omittedSingletonBounds_proven⟩

/-- Zero-index access on an `IndexCartesian` array: with no indices, bounds
checking accepts exactly when every axis has length one, failed checks stop
reads and writes before conversion or element access, and the fallback converts
the empty index list to each axis's first index in order. -/
def ZeroIndexCartesianContract : Prop :=
  OmittedSingletonBounds ∧ IndexingChecks ∧ SourceWriteChecks ∧ AxisStartCoordinates

theorem zeroIndexCartesianContract_proven : ZeroIndexCartesianContract :=
  ⟨omittedSingletonBounds_proven, indexingChecks_proven, sourceWriteChecks_proven,
    axisStartCoordinates_proven⟩

/-- Linear indexing with one index: the index is valid exactly within the
vector axis or `1:length(A)`, failed checks stop reads before conversion or
access, and an `IndexCartesian` array converts a valid linear index to the
column-major subscripts that map back to it. -/
def LinearIndexingContract : Prop :=
  LinearBoundsCoordinates ∧ IndexingChecks ∧ LinearCartesianDimsRoundTrip ∧
    LinearCartesianRoundTrip

theorem linearIndexingContract_proven : LinearIndexingContract :=
  ⟨linearBoundsCoordinates_proven, indexingChecks_proven,
    linearCartesianDimsRoundTrip_proven, linearCartesianRoundTrip_proven⟩

/-- Cartesian indexing with several indices: each index is checked against its
axis with singleton omitted dimensions and extra indices equal to one, failed
checks stop reads and writes before conversion or access, and an
`IndexLinear` array reads the value at the converted linear position. -/
def CartesianIndexingContract : Prop :=
  CartesianCoordinateBounds ∧ IndexingChecks ∧ SourceWriteChecks ∧ LinearReadValues

theorem cartesianIndexingContract_proven : CartesianIndexingContract :=
  ⟨cartesianCoordinateBounds_proven, indexingChecks_proven, sourceWriteChecks_proven,
    linearReadValues_proven⟩

/-- The linear `eachindex` axis: exactly its indices pass the scalar bounds
check (the vector's own axis, otherwise `1:length(A)`), and iteration visits
each of its positions once from the first index. -/
def EachindexLinearContract : Prop :=
  LinearBoundsCoordinates ∧ LinearIterationPositions

theorem eachindexLinearContract_proven : EachindexLinearContract :=
  ⟨linearBoundsCoordinates_proven, linearIterationPositions_proven⟩

/-! ## hvncat shape-argument front ends -/

/-- The one-level shape method of `_typed_hvncat` rejects an empty first level
with `ArgumentError` and otherwise forwards the first entry of that level, the
row-first flag and the operands to one-dimensional concatenation. -/
def HvncatOneLevelShape : Prop :=
  ∀ (Ty X A : Type) (typed : Ty → I64 → Bool → X → Result A) (t : Ty)
    (level : List I64) (rest : List (List I64)) (rowFirst : Bool) (xs : X),
    (level = [] →
      typedHvncatOneLevel tupleGet tupleGet typed t (level :: rest) rowFirst xs =
        .error (.julia (.argumentError
          "each level of `shape` argument must have at least one value"))) ∧
    (∀ n ns, level = n :: ns →
      typedHvncatOneLevel tupleGet tupleGet typed t (level :: rest) rowFirst xs =
        typed t n rowFirst xs)

theorem hvncatOneLevelShape_proven : HvncatOneLevelShape := by
  intro Ty X A typed t level rest rowFirst xs
  have one : (int 1).val = 1 := rfl
  refine ⟨?_, ?_⟩
  · intro empty
    subst empty
    simp [typedHvncatOneLevel, tupleGet, one]
    rfl
  · intro n ns nonempty
    subst nonempty
    simp [typedHvncatOneLevel, tupleGet, one]

/-- `_typed_hvncat(T, dims, row_first, as...)` pads `dims` with ones up to the
larger of the operands' maximum concatenation rank and `length(dims)`, and
forwards the padded dimensions unchanged otherwise. -/
def HvncatDimsPadding : Prop :=
  ∀ (Ty X A : Type) (typed : Ty → List I64 → Bool → List X → Result A)
    (catNdims : X → Result I64) (maximum : (X → Result I64) → List X → Result I64)
    (t : Ty) (dims : List I64) (rowFirst : Bool) (as : List X) (rank : I64),
    dims.length < 2 ^ 63 →
    maximum catNdims as = .ok rank →
    typedHvncatMixedDims catNdims maximum
      (fun count => pure (List.replicate count.val.toNat (int 1))) typed t dims rowFirst as =
      typed t (dims ++ List.replicate (max rank.val dims.length - dims.length).toNat (int 1))
        rowFirst as

theorem hvncatDimsPadding_proven : HvncatDimsPadding := by
  intro Ty X A typed catNdims maximum t dims rowFirst as rank small maxLaw
  have range := rank.property
  simp [IntTy.min, IntTy.max, IntTy.signed, IntTy.bits] at range
  have count : (int (max rank.val (dims.length : Int)) - int (dims.length : Int)).val =
      max rank.val dims.length - dims.length := by
    rw [vcatNativeSub]
    apply native_val_int <;> (rw [Int.max_def]; split <;> omega)
  simp only [typedHvncatMixedDims, maxLaw, bind, Except.bind, pure, Except.pure]
  rw [count]

/-- `_typed_hvncat(T, shape, row_first, as...)` for a shape of several levels
pads `shape` with copies of its last level up to the larger of the operands'
maximum concatenation rank and `length(shape)`. -/
def HvncatShapePadding : Prop :=
  ∀ (Ty X A : Type) (typed : Ty → List (List I64) → Bool → List X → Result A)
    (catNdims : X → Result I64) (maximum : (X → Result I64) → List X → Result I64)
    (last : List (List I64) → Result (List I64))
    (t : Ty) (shape : List (List I64)) (rowFirst : Bool) (as : List X) (rank : I64)
    (lastLevel : List I64),
    shape.length < 2 ^ 63 →
    maximum catNdims as = .ok rank → last shape = .ok lastLevel →
    typedHvncatMixedShape catNdims maximum last
      (fun level count => pure (List.replicate count.val.toNat level)) typed t shape
      rowFirst as =
      typed t (shape ++ List.replicate (max rank.val shape.length - shape.length).toNat
        lastLevel) rowFirst as

theorem hvncatShapePadding_proven : HvncatShapePadding := by
  intro Ty X A typed catNdims maximum last t shape rowFirst as rank lastLevel small
    maxLaw lastLaw
  have range := rank.property
  simp [IntTy.min, IntTy.max, IntTy.signed, IntTy.bits] at range
  have count : (int (max rank.val (shape.length : Int)) - int (shape.length : Int)).val =
      max rank.val shape.length - shape.length := by
    rw [vcatNativeSub]
    apply native_val_int <;> (rw [Int.max_def]; split <;> omega)
  simp only [typedHvncatMixedShape, maxLaw, lastLaw, bind, Except.bind, pure, Except.pure]
  rw [count]

/-! ## Vectorized subscript conversion -/

/-- `_sub2ind!(Iout, inds, Iinds, I)` assigns, for each index `i` of `Iinds` in
order, the linear index converted from the `i`-th entries of the subscript
vectors, and returns the same output; a failed conversion stops the fill. -/
def Sub2indFillAssignments : Prop :=
  ∀ (Out Ax V I E : Type) (convert : Ax → I → List V → Result E)
    (out : Out) (axes : Ax) (indices : List I) (vectors : List V)
    (log : List (I × E)) (values : I → E),
    (∀ i ∈ indices, convert axes i vectors = .ok (values i)) →
    (sub2indFill (m := StateT (List (I × E)) Result)
      (fun axes i vectors => StateT.lift (convert axes i vectors))
      (fun _ i value => modify (fun log => log ++ [(i, value)]))
      out axes indices vectors).run log =
      .ok (out, log ++ indices.map (fun i => (i, values i)))

theorem sub2indFillAssignments_proven : Sub2indFillAssignments := by
  intro Out Ax V I E convert out axes indices vectors log values law
  induction indices generalizing log with
  | nil => simp [sub2indFill, List.forIn_nil, StateT.run, StateT.bind, StateT.pure]
  | cons i rest ih =>
    have tail := ih (log ++ [(i, values i)]) (fun j hj => law j (by simp [hj]))
    have here := law i (by simp)
    simp only [sub2indFill, List.forIn_cons, StateT.run, StateT.bind, StateT.pure,
      StateT.lift, bind, pure, modify, modifyGet, MonadStateOf.modifyGet,
      StateT.modifyGet, here] at tail ⊢
    simpa [Except.bind, Except.pure, List.append_assoc] using tail

/-! Nothing to promise:
_typed_stack@3041: dispatches on whether dims equals N+1: that case forwards to the colon stack with the vectorized iterator axis, every other dims forwards to _dim_stack; the stacking behaviour belongs to those methods.
sub2ind_vec@3262: collects the i-th entry of every subscript vector and forwards them unchanged to _sub2ind.
-/

/-- The reference result shape of two equal-rank shapes: native sums on the
concatenated dimensions and the first shape's size elsewhere. -/
def sameRankCatShape : List Bool → List I64 → List I64 → List I64
  | d :: ds, a :: as, b :: bs => (if d then a + b else a) :: sameRankCatShape ds as bs
  | _, _, _ => []

/-- For a dimension mask and two shapes of the same length, `_cshp` succeeds
exactly with the native sum of the sizes on concatenated dimensions and the
common size elsewhere when the shapes agree off the mask. -/
def ConcatShapeSameRank : Prop :=
  ∀ (ndim : I64) (dims : List Bool) (shape nshape : List I64),
    dims.length = shape.length → shape.length = nshape.length →
    (∀ (i : Nat) (h : i < dims.length) (ha : i < shape.length) (hb : i < nshape.length),
      dims[i] = false → shape[i] = nshape[i]) →
    cshpCalls ndim dims shape nshape = .ok (sameRankCatShape dims shape nshape)

theorem concatShapeSameRank_proven : ConcatShapeSameRank := by
  intro ndim dims
  induction dims generalizing ndim with
  | nil =>
    intro shape nshape hs hn _
    cases shape with
    | nil =>
      cases nshape with
      | nil => simp [cshpCalls, cshpEmpty, sameRankCatShape]
      | cons b bs => simp at hn
    | cons a as => simp at hs
  | cons d ds ih =>
    intro shape nshape hs hn agree
    cases shape with
    | nil => simp at hs
    | cons a as =>
      cases nshape with
      | nil => simp at hn
      | cons b bs =>
        simp only [List.length_cons, Nat.add_right_cancel_iff] at hs hn
        have tail := ih (ndim + int 1) as bs hs hn (fun i h ha hb hd =>
          agree (i + 1) (by simp; omega) (by simp; omega) (by simp; omega) (by simpa using hd))
        cases d with
        | true =>
          simp [cshpCalls, cshpMerge, tail, sameRankCatShape]
        | false =>
          have same : a = b := agree 0 (by simp) (by simp) (by simp) rfl
          subst same
          simp [cshpCalls, cshpMerge, catCheckDim, tail, sameRankCatShape]

/-- Any disagreement between the two shapes on a dimension excluded from
concatenation makes `_cshp` raise `DimensionMismatch`. -/
def ConcatShapeMismatchAnywhere : Prop :=
  ∀ (ndim : I64) (dims : List Bool) (shape nshape : List I64) (i : Nat)
    (h : i < dims.length) (ha : i < shape.length) (hb : i < nshape.length),
    dims[i] = false → shape[i] ≠ nshape[i] →
    ∃ message, cshpCalls ndim dims shape nshape = .error (.dimensionMismatch message)

theorem concatShapeMismatchAnywhere_proven : ConcatShapeMismatchAnywhere := by
  intro ndim dims
  induction dims generalizing ndim with
  | nil => intro shape nshape i h; simp at h
  | cons d ds ih =>
    intro shape nshape i h ha hb hd hne
    cases shape with
    | nil => simp at ha
    | cons a as =>
      cases nshape with
      | nil => simp at hb
      | cons b bs =>
        cases i with
        | zero =>
          simp only [List.getElem_cons_zero] at hd hne
          subst hd
          have ne : a.val ≠ b.val := fun e => hne (Subtype.ext e)
          exact ⟨_, by simp [cshpCalls, cshpMerge, catCheckDim, ne]; rfl⟩
        | succ i =>
          simp only [List.getElem_cons_succ, List.length_cons] at hd hne h ha hb
          obtain ⟨message, tail⟩ := ih (ndim + int 1) as bs i (by omega) (by omega)
            (by omega) hd hne
          cases d with
          | true => exact ⟨message, by simp [cshpCalls, cshpMerge, tail]⟩
          | false =>
            by_cases same : a.val = b.val
            · exact ⟨message, by simp [cshpCalls, cshpMerge, catCheckDim, same, tail]⟩
            · exact ⟨_, by simp [cshpCalls, cshpMerge, catCheckDim, same]; rfl⟩

/-- The pairwise concatenation shape `_cshp`: a successful shape has the
maximum rank of its inputs; equal-rank shapes that agree off the mask give the
native sum on concatenated dimensions and the common size elsewhere; any
disagreement off the mask raises `DimensionMismatch`. -/
def CatShapeContract : Prop :=
  ConcatShapeRank ∧ ConcatShapeSameRank ∧ ConcatShapeMismatchAnywhere

theorem catShapeContract_proven : CatShapeContract :=
  ⟨concatShapeRank_proven, concatShapeSameRank_proven, concatShapeMismatchAnywhere_proven⟩

/-- Horizontal concatenation of vectors through the source `_typed_hcat`:
`size(a, 1)` and `length(a)` are the vector's row count, the allocation returns
the requested shape, and the dense copy and the column assignment record where
each operand is placed. -/
def hcatVectorsTrace {A Ty : Type} (rows : A → I64) (isArray : A → Bool)
    (t : Ty) (as : List A) :
    StateT (List (Sum I64 (I64 × I64) × A)) Result (I64 × I64) :=
  typedHcat (fun as => pure (int as.length)) (fun as j => StateT.lift (tupleGet as j))
    (fun a d => pure (if d.val = 1 then rows a else int 1)) (fun _ => pure (int 1))
    isArray (fun _ => false) (fun lo hi => pure (concatRange lo hi)) (fun _ => pure "")
    (fun _ _ r c => pure (r, c)) (fun a => pure (rows a))
    (fun b pos a _ _ => do modify (fun log => log ++ [(.inl pos, a)]); pure b)
    (fun lo hi => pure (lo, hi))
    (fun _ cols a => modify (fun log => log ++ [(.inr cols, a)])) t as

/-- The native `Int` positions `start, start + 1, ...`. -/
def nativePositions (start : Int) (count : Nat) : List I64 :=
  (List.range count).map (fun k : Nat => int (start + k))

theorem nativePositions_succ (start : Int) (count : Nat) :
    nativePositions start (count + 1) = int start :: nativePositions (start + 1) count := by
  unfold nativePositions
  rw [List.range_succ_eq_map]
  simp only [List.map_cons, List.map_map]
  congr 1
  · simp
  · apply List.map_congr_left
    intro k _
    simp only [Function.comp]
    congr 1
    omega

theorem concatRange_one_native (n : Nat) (small : n < 2 ^ 63) :
    concatRange (int 1) (int n) = nativePositions 1 n := by
  have value : (int (n : Int)).val = n := native_val_int _ (by omega) (by omega)
  have one : (int 1).val = 1 := rfl
  unfold concatRange nativePositions
  rw [value, one]
  have count : ((n : Int) - 1 + 1).toNat = n := by omega
  rw [count]

theorem tupleGet_at {A : Type} (xs pre rest : List A) (x : A) (start : Int)
    (split : xs = pre ++ x :: rest) (position : start = 1 + pre.length)
    (small : xs.length < 2 ^ 63) : tupleGet xs (int start) = .ok x := by
  subst split
  simp only [List.length_append, List.length_cons] at small
  have value : (int start).val = start := native_val_int _ (by omega) (by omega)
  have index : (start - 1).toNat = pre.length := by omega
  simp only [tupleGet, value, index]
  rw [if_neg (by omega)]
  simp

theorem nativeAfter_one (start : Int) (n : Nat) :
    nativeAfter (int start) (int 1) n = int (start + n) := by
  induction n generalizing start with
  | zero => simp [nativeAfter]
  | succ n ih =>
    simp only [nativeAfter, vcatNativeAdd, ih]
    congr 1
    omega

theorem hcatCheckLoop {A : Type} (rows : A → I64) (isArray : A → Bool) (r : I64)
    (message : String) (xs : List A) :
    ∀ (pre suf : List A) (start : Int) (state : I64 × Bool)
      (log : List (Sum I64 (I64 × I64) × A)),
    xs = pre ++ suf → start = 1 + pre.length → xs.length < 2 ^ 63 →
    (∀ x ∈ suf, rows x = r) →
    (forIn (nativePositions start suf.length) state fun j __s => do
        let aj ← StateT.lift (tupleGet xs j)
        if ((rows aj).val != r.val) = true then do
            throw (ArrayError.dimensionMismatch message)
            pure (ForInStep.yield (__s.fst + int 1, __s.snd && isArray aj))
          else pure (ForInStep.yield (__s.fst + int 1, __s.snd && isArray aj)) :
        StateT (List (Sum I64 (I64 × I64) × A)) Result (I64 × Bool)).run log =
      .ok ((nativeAfter state.1 (int 1) suf.length, state.2 && suf.all isArray), log) := by
  intro pre suf
  induction suf generalizing pre with
  | nil =>
    intro start state log _ _ _ _
    simp [nativePositions, List.forIn_nil, nativeAfter, StateT.run, StateT.pure]
  | cons x rest ih =>
    intro start state log split position small sizes
    have get := tupleGet_at xs pre rest x start split position small
    have rowx : rows x = r := sizes x (by simp)
    have tail := ih (pre ++ [x]) (start + 1) (state.1 + int 1, state.2 && isArray x) log
      (by simp [split]) (by simp [position]; omega) small
      (fun y hy => sizes y (by simp [hy]))
    rw [List.length_cons, nativePositions_succ, List.forIn_cons]
    simp only [StateT.run, StateT.bind, StateT.lift, StateT.pure, bind, pure, get,
      Except.bind, Except.pure, rowx, bne_self_eq_false, Bool.false_eq_true, ↓reduceIte,
      nativeAfter, List.all_cons, Bool.and_assoc] at tail ⊢
    exact tail

theorem hcatDenseLoop {A : Type} (rows : A → I64) (r : I64) (b : I64 × I64) (xs : List A) :
    ∀ (pre suf : List A) (start : Int) (pos : I64)
      (log : List (Sum I64 (I64 × I64) × A)),
    xs = pre ++ suf → start = 1 + pre.length → xs.length < 2 ^ 63 →
    (∀ x ∈ suf, rows x = r) →
    (forIn (nativePositions start suf.length) pos (fun k __s =>
        StateT.lift (tupleGet xs k) >>= fun ak =>
          ((modify fun log => log ++ [(Sum.inl __s, ak)]) >>= fun _ => pure b) >>= fun _ =>
            pure (ForInStep.yield (__s + rows ak))) :
        StateT (List (Sum I64 (I64 × I64) × A)) Result I64).run log =
      .ok (nativeAfter pos r suf.length,
        log ++ (suf.zip (nativeProgression pos r suf.length)).map
          (fun p => (Sum.inl p.2, p.1))) := by
  intro pre suf
  induction suf generalizing pre with
  | nil =>
    intro start pos log _ _ _ _
    simp [nativePositions, List.forIn_nil, nativeAfter, nativeProgression, StateT.run,
      StateT.pure]
  | cons x rest ih =>
    intro start pos log split position small sizes
    have get := tupleGet_at xs pre rest x start split position small
    have rowx : rows x = r := sizes x (by simp)
    have tail := ih (pre ++ [x]) (start + 1) (pos + r) (log ++ [(Sum.inl pos, x)])
      (by simp [split]) (by simp [position]; omega) small
      (fun y hy => sizes y (by simp [hy]))
    rw [List.length_cons, nativePositions_succ, List.forIn_cons]
    simp only [StateT.run, StateT.bind, StateT.lift, StateT.pure, bind, pure, get, rowx,
      modify, modifyGet, MonadStateOf.modifyGet, StateT.modifyGet, Except.bind, Except.pure,
      nativeAfter, nativeProgression, List.zip_cons_cons, List.map_cons, List.append_assoc,
      List.singleton_append] at tail ⊢
    exact tail

theorem hcatColumnLoop {A : Type} (xs : List A) :
    ∀ (pre suf : List A) (start : Int) (pos : I64)
      (log : List (Sum I64 (I64 × I64) × A)),
    xs = pre ++ suf → start = 1 + pre.length → xs.length < 2 ^ 63 →
    (forIn (nativePositions start suf.length) pos fun k __s => do
        let ak ← StateT.lift (tupleGet xs k)
        modify fun log => log ++ [(Sum.inr (__s, __s + int 1 - int 1), ak)]
        pure (ForInStep.yield (__s + int 1 - int 1 + int 1)) :
        StateT (List (Sum I64 (I64 × I64) × A)) Result I64).run log =
      .ok (nativeAfter pos (int 1) suf.length,
        log ++ (suf.zip (nativeProgression pos (int 1) suf.length)).map
          (fun p => (Sum.inr (p.2, p.2), p.1))) := by
  intro pre suf
  induction suf generalizing pre with
  | nil =>
    intro start pos log _ _ _
    simp [nativePositions, List.forIn_nil, nativeAfter, nativeProgression, StateT.run,
      StateT.pure]
  | cons x rest ih =>
    intro start pos log split position small
    have get := tupleGet_at xs pre rest x start split position small
    have tail := ih (pre ++ [x]) (start + 1) (pos + int 1) (log ++ [(Sum.inr (pos, pos), x)])
      (by simp [split]) (by simp [position]; omega) small
    rw [List.length_cons, nativePositions_succ, List.forIn_cons]
    simp only [StateT.run, StateT.bind, StateT.lift, StateT.pure, bind, pure, get,
      nativeAddSubCancel, modify, modifyGet, MonadStateOf.modifyGet,
      StateT.modifyGet] at tail ⊢
    simp only [Except.bind, Except.pure, nativeAfter, nativeProgression, List.zip_cons_cons,
      List.map_cons, List.append_assoc, List.singleton_append] at tail ⊢
    exact tail

/-- Horizontal concatenation of equal-length vectors (`reduce(hcat, vs)` and
`hcat` of vectors through `_typed_hcat`) allocates `length(vs[1])` rows and one
column per vector, and places the `k`-th vector in column `k`: by one dense copy
starting at linear position `1 + (k - 1) * nrows` when every operand is an
`Array`, and by the assignment `B[:, k:k] = vs[k]` otherwise. -/
def HcatVectorColumns : Prop :=
  ∀ (A Ty : Type) (rows : A → I64) (isArray : A → Bool) (t : Ty) (a : A) (as : List A)
    (log : List (Sum I64 (I64 × I64) × A)),
    (a :: as).length < 2 ^ 63 → (∀ x ∈ a :: as, rows x = rows a) →
    (hcatVectorsTrace rows isArray t (a :: as)).run log =
      .ok ((rows a, int (a :: as).length),
        log ++ if (a :: as).all isArray then
          ((a :: as).zip (nativeProgression (int 1) (rows a) (a :: as).length)).map
            (fun p => (Sum.inl p.2, p.1))
        else
          ((a :: as).zip (nativeProgression (int 1) (int 1) (a :: as).length)).map
            (fun p => (Sum.inr (p.2, p.2), p.1)))

theorem hcatVectorColumns_proven : HcatVectorColumns := by
  intro A Ty rows isArray t a as log small sizes
  have one : (int 1).val = 1 := rfl
  have two : (int 2).val = 2 := rfl
  have first : tupleGet (a :: as) (int 1) = .ok a :=
    tupleGet_at (a :: as) [] as a 1 rfl (by simp) small
  have range := concatRange_one_native (a :: as).length small
  have okBind : ∀ {α β : Type} (x : α) (f : α → Result β), (Except.ok x >>= f) = f x :=
    fun _ _ => rfl
  simp only [hcatVectorsTrace, typedHcat, pure_bind, one, two, Int.reduceBEq, Int.reduceEq,
    Bool.false_eq_true, ↓reduceIte, StateT.run_bind, StateT.run_lift, StateT.run_pure,
    first, range, okBind]
  rw [hcatCheckLoop rows isArray (rows a) _ (a :: as) [] (a :: as) 1 (int 0, true) log
    rfl (by simp) small sizes]
  simp only [okBind, Bool.true_and, nativeAfter_one]
  cases dense : (a :: as).all isArray with
  | true =>
    simp only [↓reduceIte, StateT.run_bind, StateT.run_pure, okBind]
    rw [hcatDenseLoop rows (rows a) _ (a :: as) [] (a :: as) 1 (int 1) log
      rfl (by simp) small sizes]
    simp only [okBind, Int.zero_add]
    rfl
  | false =>
    simp only [Bool.false_eq_true, ↓reduceIte, StateT.run_bind, StateT.run_pure, okBind]
    rw [hcatColumnLoop (a :: as) [] (a :: as) 1 (int 1) log rfl (by simp) small]
    simp only [okBind, Int.zero_add]
    rfl

/-- `reduce(vcat, vs)` and `reduce(hcat, vs)` for vectors, through the source
`_typed_vcat` and `_typed_hcat`: vertical concatenation allocates the native sum
of the lengths and fills consecutive slices in order; horizontal concatenation
of equal-length vectors puts the `k`-th vector in column `k`; a second operand
with a different row count is rejected before allocation. -/
def ReduceCatContract : Prop :=
  TypedVcatVectorAllocation ∧ TypedVcatVectorBlocks ∧ ConcatMismatchRejected ∧
    HcatVectorColumns

theorem reduceCatContract_proven : ReduceCatContract :=
  ⟨typedVcatVectorAllocation_proven, typedVcatVectorBlocks_proven,
    concatMismatchRejected_proven, hcatVectorColumns_proven⟩

/-- `_dim_stack!` with foreign colon tuples, rank and first index, a view that
selects slice `i` along the stacking dimension, a copy that records which slice
receives which operand, and foreign iterator axes and uniformity check. -/
def dimStackTrace {A X Col Ax : Type}
    (colons : I64 → Result (List Col)) (ndims : A → Result I64)
    (firstindex : A → I64 → Result I64) (axesOf : X → Result Ax)
    (check : X → Ax → Result Unit)
    (dims : I64) (b : A) (x1 : X) (rest : List X) :
    StateT (List (I64 × X)) Result Unit :=
  dimStackFill (fun count => StateT.lift (colons count)) (fun b => StateT.lift (ndims b))
    (fun b d => StateT.lift (firstindex b d)) (fun _ _ i _ => pure i)
    (fun i x => modify (fun log => log ++ [(i, x)])) (fun x => StateT.lift (axesOf x))
    (fun x ax => StateT.lift (check x ax)) dims b x1 rest

theorem dimStackLoop {X Ax : Type} (axesOf : X → Result Ax) (check : X → Ax → Result Unit)
    (x1 : X) (ax : Ax) (axesLaw : axesOf x1 = .ok ax) :
    ∀ (rest : List X) (i : I64), (∀ x ∈ rest, check x ax = .ok ()) →
    ∀ (log : List (I64 × X)),
    (forIn rest i (fun x __s => do
        let __do_lift ← StateT.lift (axesOf x1)
        StateT.lift (check x __do_lift)
        modify fun log => log ++ [(__s + int 1, x)]
        pure (ForInStep.yield (__s + int 1))) :
        StateT (List (I64 × X)) Result I64).run log =
      .ok (nativeAfter i (int 1) rest.length,
        log ++ (rest.zip (nativeProgression (i + int 1) (int 1) rest.length)).map
          (fun p => (p.2, p.1))) := by
  intro rest
  induction rest with
  | nil =>
    intro i _ log
    simp [List.forIn_nil, nativeAfter, nativeProgression, StateT.run, StateT.pure]
  | cons x rest ih =>
    intro i checks log
    have here : check x ax = .ok () := checks x (by simp)
    have tail := ih (i + int 1) (fun y hy => checks y (by simp [hy]))
      (log ++ [(i + int 1, x)])
    simp only [List.forIn_cons, StateT.run, StateT.bind, StateT.lift, StateT.pure, bind, pure,
      axesLaw, here, modify, modifyGet, MonadStateOf.modifyGet, StateT.modifyGet, Except.bind,
      Except.pure, nativeAfter, nativeProgression, List.zip_cons_cons, List.map_cons,
      List.length_cons, List.append_assoc, List.singleton_append] at tail ⊢
    exact tail

theorem dimStackLoopError {X Ax : Type} (axesOf : X → Result Ax)
    (check : X → Ax → Result Unit) (x1 : X) (ax : Ax) (axesLaw : axesOf x1 = .ok ax)
    (x : X) (post : List X) (error : ArrayError) (failed : check x ax = .error error) :
    ∀ (pre : List X) (i : I64), (∀ y ∈ pre, check y ax = .ok ()) → ∀ (log : List (I64 × X)),
    (forIn (pre ++ x :: post) i (fun x __s => do
        let __do_lift ← StateT.lift (axesOf x1)
        StateT.lift (check x __do_lift)
        modify fun log => log ++ [(__s + int 1, x)]
        pure (ForInStep.yield (__s + int 1))) :
        StateT (List (I64 × X)) Result I64).run log = .error error := by
  intro pre
  induction pre with
  | nil =>
    intro i _ log
    simp only [List.nil_append, List.forIn_cons, StateT.run, StateT.bind, StateT.lift, bind,
      pure, Except.pure, axesLaw, failed, Except.bind]
  | cons y pre ih =>
    intro i checks log
    have here : check y ax = .ok () := checks y (by simp)
    have tail := ih (i + int 1) (fun z hz => checks z (by simp [hz])) (log ++ [(i + int 1, y)])
    simp only [List.cons_append, List.forIn_cons, StateT.run, StateT.bind, StateT.lift,
      StateT.pure, bind, pure, axesLaw, here, modify, modifyGet, MonadStateOf.modifyGet,
      StateT.modifyGet, Except.bind, Except.pure] at tail ⊢
    exact tail

/-- `_dim_stack!(Val(dims), B, x1, xrest)` copies the first slice into index
`firstindex(B, dims)` along the stacking dimension and each later slice into
the next index, in order, when every later slice has the first slice's axes;
the first non-uniform slice stops the fill with the uniformity check's error. -/
def DimStackSlicePositions : Prop :=
  ∀ (A X Col Ax : Type)
    (colons : I64 → Result (List Col)) (ndims : A → Result I64)
    (firstindex : A → I64 → Result I64) (axesOf : X → Result Ax)
    (check : X → Ax → Result Unit)
    (dims : I64) (b : A) (x1 : X) (rest : List X) (log : List (I64 × X))
    (before after : List Col) (rank f : I64) (ax : Ax),
    colons (dims - int 1) = .ok before → ndims b = .ok rank →
    colons (rank - dims) = .ok after → firstindex b dims = .ok f → axesOf x1 = .ok ax →
    let run := (dimStackTrace colons ndims firstindex axesOf check dims b x1 rest).run log
    ((∀ x ∈ rest, check x ax = .ok ()) →
      run = .ok ((), log ++ ((x1 :: rest).zip
        (nativeProgression f (int 1) (rest.length + 1))).map (fun p => (p.2, p.1)))) ∧
    (∀ (pre post : List X) (x : X) (error : ArrayError), rest = pre ++ x :: post →
      (∀ y ∈ pre, check y ax = .ok ()) → check x ax = .error error → run = .error error)

theorem dimStackSlicePositions_proven : DimStackSlicePositions := by
  intro A X Col Ax colons ndims firstindex axesOf check dims b x1 rest log before after rank f
    ax beforeLaw rankLaw afterLaw firstLaw axesLaw
  have okBind : ∀ {α β : Type} (x : α) (g : α → Result β), (Except.ok x >>= g) = g x :=
    fun _ _ => rfl
  refine ⟨?_, ?_⟩
  · intro checks
    simp only [dimStackTrace, dimStackFill, pure_bind, StateT.run_bind, StateT.run_lift,
      StateT.run_pure, beforeLaw, rankLaw, afterLaw, firstLaw, okBind,
      dimStackLoop axesOf check x1 ax axesLaw rest f checks]
    simp [StateT.run, modify, modifyGet, MonadStateOf.modifyGet, StateT.modifyGet,
      nativeProgression, List.append_assoc]
  · intro pre post x error split prefixOk failed
    subst split
    simp only [dimStackTrace, dimStackFill, pure_bind, StateT.run_bind, StateT.run_lift,
      StateT.run_pure, beforeLaw, rankLaw, afterLaw, firstLaw, okBind,
      dimStackLoopError axesOf check x1 ax axesLaw x post error failed pre f prefixOk]
    rfl

/-- Iteration-indexed writes: stacking writes the `k`-th slice at index
`firstindex(B, dims) + k - 1` along the stacking dimension, `map!` with one,
two or several sources stores each result at the position its operands were
read from, and `keepat!` leaves exactly the kept elements in order at the front
of the vector with its first index unchanged. -/
def IterationIndexContract : Prop :=
  DimStackSlicePositions ∧ MapOneContents ∧ MapTwoContents ∧ MapNStoresElementwise ∧
    KeepAtSortedSelects ∧ KeepAtMaskSelects

theorem iterationIndexContract_proven : IterationIndexContract :=
  ⟨dimStackSlicePositions_proven, mapOneContents_proven, mapTwoContents_proven,
    mapNStoresElementwise_proven, keepAtSortedSelects_proven, keepAtMaskSelects_proven⟩

/-- `_typed_hvncat(T, dims, row_first, xs::Number...)` rejects any nonpositive
dimension with `ArgumentError` before allocating; after allocating an array of
those dimensions it rejects an argument count different from the array length
with `ArgumentError`, and otherwise fills and returns that array. -/
def HvncatNumbersDimsChecks : Prop :=
  ∀ (Ty X A : Type) (array : Ty → Nat → List I64 → Result A)
    (lengthArray : A → Result I64) (lengthArgs : X → Result I64)
    (fill : A → Bool → X → Result Unit)
    (t : Ty) (dims : List I64) (rowFirst : Bool) (xs : X),
    let run := typedHvncatNumbersDims array lengthArray lengthArgs fill t dims rowFirst xs
    ((∃ d ∈ dims, d.val ≤ 0) →
      run = .error (.julia (.argumentError "`dims` argument must contain positive integers"))) ∧
    (∀ (a : A) (lengtha lengthx : I64), (∀ d ∈ dims, 0 < d.val) →
      array t dims.length dims = .ok a → lengthArray a = .ok lengtha →
      lengthArgs xs = .ok lengthx →
      (lengtha.val ≠ lengthx.val → ∃ message, run = .error (.julia (.argumentError message))) ∧
      (lengtha.val = lengthx.val → run = (fill a rowFirst xs).map (fun _ => a)))

theorem hvncatNumbersDimsChecks_proven : HvncatNumbersDimsChecks := by
  intro Ty X A array lengthArray lengthArgs fill t dims rowFirst xs
  refine ⟨?_, ?_⟩
  · intro bad
    have notAll : dims.all (fun d => decide (0 < d.val)) = false := by
      rcases bad with ⟨d, hd, nonpos⟩
      apply Bool.eq_false_iff.mpr
      intro h
      have := List.all_eq_true.mp h d hd
      simp at this
      omega
    simp [typedHvncatNumbersDims, notAll]
    rfl
  · intro a lengtha lengthx positive arrayLaw lengthaLaw lengthxLaw
    have all : dims.all (fun d => decide (0 < d.val)) = true :=
      List.all_eq_true.mpr (fun d hd => by simpa using positive d hd)
    refine ⟨?_, ?_⟩
    · intro differ
      exact ⟨_, by simp [typedHvncatNumbersDims, all, arrayLaw, lengthaLaw, lengthxLaw, differ]; rfl⟩
    · intro same
      cases hfill : fill a rowFirst xs <;>
        simp [typedHvncatNumbersDims, all, arrayLaw, lengthaLaw, lengthxLaw, same, hfill,
          Except.map]

/-- `_stack(dims, ::Union{HasShape, HasLength}, iter)` takes the element type of
the default element type (`Any` for `Union{}`); a concrete element type goes to
`_typed_stack` with the iterator itself, never collecting it; otherwise the
iterator is reused when it is a tuple or array and collected once otherwise, an
empty collection gives the empty stack, and a nonempty one goes to `_typed_stack`
with the promoted element type of its elements. -/
def StackKnownSizeDispatch : Prop :=
  ∀ (D It C Ty A : Type) (anyType : Ty) (defaultEltype : It → Result Ty)
    (isBottom : Ty → Bool) (eltype : Ty → Result Ty) (isConcrete : Ty → Result Bool)
    (typed : D → Ty → Ty → It → Result A) (isTupleOrArray : It → Bool) (reuse : It → C)
    (collect : It → Result C) (isempty : C → Result Bool)
    (empty : D → Ty → Ty → It → Result A) (promoteEltypes : C → Result Ty)
    (collectionEltype : C → Result Ty) (typedCollection : D → Ty → Ty → C → Result A)
    (dims : D) (iter : It) (s t : Ty),
    defaultEltype iter = .ok s →
    (isBottom s = true → t = anyType) → (isBottom s = false → eltype s = .ok t) →
    let run := stackKnownSize anyType defaultEltype isBottom eltype isConcrete typed
      isTupleOrArray reuse collect isempty empty promoteEltypes collectionEltype
      typedCollection dims iter
    (isConcrete t = .ok true → run = typed dims t s iter) ∧
    (∀ c, isConcrete t = .ok false →
      (isTupleOrArray iter = true → c = reuse iter) →
      (isTupleOrArray iter = false → collect iter = .ok c) →
      (isempty c = .ok true → run = empty dims t s iter) ∧
      (∀ t2 e, isempty c = .ok false → promoteEltypes c = .ok t2 →
        collectionEltype c = .ok e → run = typedCollection dims t2 e c))

theorem stackKnownSizeDispatch_proven : StackKnownSizeDispatch := by
  intro D It C Ty A anyType defaultEltype isBottom eltype isConcrete typed isTupleOrArray
    reuse collect isempty empty promoteEltypes collectionEltype typedCollection dims iter s t
    sLaw bottomLaw eltypeStep
  have tStep : (isBottom s = false ∧ eltype s = .ok t) ∨ (isBottom s = true ∧ t = anyType) := by
    cases hb : isBottom s
    · exact Or.inl ⟨rfl, eltypeStep hb⟩
    · exact Or.inr ⟨rfl, bottomLaw hb⟩
  refine ⟨?_, ?_⟩
  · intro concrete
    rcases tStep with ⟨hb, et⟩ | ⟨hb, rfl⟩
    · simp [stackKnownSize, sLaw, hb, et, concrete]
    · simp [stackKnownSize, sLaw, hb, concrete]
  · intro c notConcrete reuseLaw collectLaw
    have arrayStep : (isTupleOrArray iter = false ∧ collect iter = .ok c) ∨
        (isTupleOrArray iter = true ∧ c = reuse iter) := by
      cases h : isTupleOrArray iter
      · exact Or.inl ⟨rfl, collectLaw h⟩
      · exact Or.inr ⟨rfl, reuseLaw h⟩
    refine ⟨?_, ?_⟩
    · intro emptyLaw
      rcases tStep with ⟨hb, et⟩ | ⟨hb, rfl⟩ <;>
        rcases arrayStep with ⟨hi, cl⟩ | ⟨hi, rfl⟩ <;>
        simp_all [stackKnownSize]
    · intro t2 e nonempty promoteLaw eltypeLaw
      rcases tStep with ⟨hb, et⟩ | ⟨hb, rfl⟩ <;>
        rcases arrayStep with ⟨hi, cl⟩ | ⟨hi, rfl⟩ <;>
        simp_all [stackKnownSize]

theorem mapM_ok_of_forall {α β : Type} (f : α → Result β) (g : α → β) :
    ∀ (xs : List α), (∀ x ∈ xs, f x = .ok (g x)) → xs.mapM f = .ok (xs.map g)
  | [], _ => rfl
  | x :: xs, h => by
    have rest := mapM_ok_of_forall f g xs (fun y hy => h y (by simp [hy]))
    rw [List.mapM_cons, h x (by simp), rest]
    rfl

/-- `_dim_stack` with a peeled iterator, `ntuple` over `1:N1`, native `Int`
comparisons of `dims`, and an allocation that returns the requested axes: an
empty iterator gives the empty stack; `dims` outside `1:N1` (with `N1` one more
than the first slice's rank) raises `ArgumentError`; otherwise the result axes
are the first slice's axes with the iterator's vector axis inserted at position
`dims`, and the fill for `dims` runs on that allocation. -/
def DimStackAxes : Prop :=
  ∀ (Ty It X Rest Storage Ax : Type)
    (peel : It → Result (Option (X × Rest))) (empty : I64 → Ty → Ty → It → Result (List Ax))
    (iteratorAxes : X → Result (List Ax)) (showDim : I64 → String)
    (vecAxis : It → Result Ax) (getAxis : List Ax → Nat → Result Ax)
    (ensureArray : X → Result Storage)
    (fillOne fillTwo : List Ax → X → Rest → Result Unit)
    (fillOther : I64 → List Ax → X → Rest → Result Unit)
    (dims : I64) (t s : Ty) (a : It),
    let run := dimStack peel empty iteratorAxes
      (fun dims n => pure (decide (1 ≤ dims.val ∧ dims.val ≤ n))) showDim
      (fun dims d => decide (dims.val = d)) (fun d dims => decide (dims.val < d))
      vecAxis getAxis (fun f n => (List.range n).mapM (fun d => f (d + 1)))
      ensureArray (fun _ _ axes => pure axes) fillOne fillTwo fillOther dims t s a
    (peel a = .ok none → run = empty dims t s a) ∧
    (∀ x1 rest ax1, peel a = .ok (some (x1, rest)) → iteratorAxes x1 = .ok ax1 →
      (¬ (1 ≤ dims.val ∧ dims.val ≤ ax1.length + 1) →
        ∃ message, run = .error (.julia (.argumentError message))) ∧
      (∀ newaxis storage, 1 ≤ dims.val → dims.val ≤ ax1.length + 1 →
        vecAxis a = .ok newaxis → ensureArray x1 = .ok storage →
        (∀ k (hk : 0 < k) (hk' : k ≤ ax1.length), getAxis ax1 k = .ok ax1[k - 1]) →
        (∀ b, fillOne b x1 rest = .ok () ∧ fillTwo b x1 rest = .ok () ∧
          fillOther dims b x1 rest = .ok ()) →
        run = .ok (ax1.take (dims.val.toNat - 1) ++ newaxis :: ax1.drop (dims.val.toNat - 1))))

theorem dimStackAxes_proven : DimStackAxes := by
  intro Ty It X Rest Storage Ax peel empty iteratorAxes showDim vecAxis getAxis ensureArray
    fillOne fillTwo fillOther dims t s a
  refine ⟨?_, ?_⟩
  · intro none
    simp [dimStack, none]
  · intro x1 rest ax1 peeled axesLaw
    refine ⟨?_, ?_⟩
    · intro outside
      exact ⟨_, by simp [dimStack, peeled, axesLaw, outside]; rfl⟩
    · intro newaxis storage low high vecLaw ensureLaw getLaw fills
      obtain ⟨k, hk⟩ : ∃ k : Nat, dims.val = (k : Int) + 1 := ⟨(dims.val - 1).toNat, by omega⟩
      have position : dims.val.toNat - 1 = k := by omega
      have kHigh : k ≤ ax1.length := by omega
      rw [position]
      obtain ⟨g, gEq⟩ : ∃ g : Nat → Ax, ∀ d, g d =
          if d = k then newaxis else if k < d then (ax1[d - 1]?).getD newaxis
          else (ax1[d]?).getD newaxis := ⟨_, fun _ => rfl⟩
      have axesOut : (List.range (ax1.length + 1)).map g =
          ax1.take k ++ newaxis :: ax1.drop k := by
        apply List.ext_getElem?
        intro i
        rw [List.getElem?_map]
        by_cases inRange : i < ax1.length + 1
        · rw [List.getElem?_range inRange]
          show some (g i) = _
          rw [gEq]
          by_cases same : i = k
          · subst same
            rw [if_pos rfl, List.getElem?_append_right (by rw [List.length_take]; omega),
              List.length_take, Nat.min_eq_left kHigh, Nat.sub_self, List.getElem?_cons_zero]
          · rw [if_neg same]
            by_cases after : k < i
            · rw [if_pos after, List.getElem?_append_right (by rw [List.length_take]; omega),
                List.length_take, Nat.min_eq_left kHigh,
                show i - k = (i - k - 1) + 1 by omega, List.getElem?_cons_succ,
                List.getElem?_drop, show k + (i - k - 1) = i - 1 by omega,
                List.getElem?_eq_getElem (by omega : i - 1 < ax1.length)]
              rfl
            · rw [if_neg after, List.getElem?_append_left (by rw [List.length_take]; omega),
                List.getElem?_take, if_pos (by omega : i < k),
                List.getElem?_eq_getElem (by omega : i < ax1.length)]
              rfl
        · rw [List.getElem?_eq_none (by rw [List.length_range]; omega),
            List.getElem?_eq_none (by rw [List.length_append, List.length_cons,
              List.length_take, List.length_drop]; omega)]
          rfl
      have within : 1 ≤ dims.val ∧ dims.val ≤ ((ax1.length + 1 : Nat) : Int) := ⟨low, by omega⟩
      obtain ⟨one, two, other⟩ := fills (ax1.take k ++ newaxis :: ax1.drop k)
      simp only [dimStack, peeled, axesLaw, low, high, within, vecLaw, ensureLaw, bind,
        Except.bind, pure, Except.pure, decide_true, Bool.not_true, Bool.false_eq_true,
        ↓reduceIte, and_self]
      rw [mapM_ok_of_forall _ g (List.range (ax1.length + 1)) ?entries, axesOut]
      · by_cases d1 : dims.val = 1
        · simp [d1, one]
        · by_cases d2 : dims.val = 2
          · simp [d1, d2, two]
          · simp [d1, d2, other]
      case entries =>
        intro d hd
        have dlt : d < ax1.length + 1 := List.mem_range.mp hd
        split
        · rename_i h
          have hd' : dims.val = (d : Int) + 1 := by simpa using h
          rw [gEq, if_pos (by omega : d = k)]
        · rename_i h
          have hd' : ¬ dims.val = (d : Int) + 1 := by simpa using h
          have ne : d ≠ k := by omega
          split
          · rename_i h2
            have lt : dims.val < (d : Int) + 1 := by simpa using h2
            have after : k < d := by omega
            rw [show d + 1 - 1 = d by omega, getLaw d (by omega) (by omega), gEq, if_neg ne,
              if_pos after, List.getElem?_eq_getElem (by omega : d - 1 < ax1.length)]
            rfl
          · rename_i h2
            have nlt : ¬ dims.val < (d : Int) + 1 := by simpa using h2
            have notAfter : ¬ k < d := by omega
            rw [show d + 1 - 0 = d + 1 by omega, getLaw (d + 1) (by omega) (by omega), gEq,
              if_neg ne, if_neg notAfter, List.getElem?_eq_getElem (by omega : d < ax1.length)]
            simp

/-- `hvncat_fill!` validates its arguments before touching the destination: a
destination of rank at most one, scratch vectors whose lengths are not both the
rank, or a `(d1, d2)` pair other than `(1, 2)` and `(2, 1)` each raise their
`ArgumentError`, whatever the array operations do. -/
def HvncatFillChecks : Prop :=
  ∀ (A X V C E : Type) (length : V → Result I64) (size : A → Result (List I64))
    (cumprod : List I64 → Result (List I64)) (get : V → I64 → Result I64)
    (set : V → I64 → I64 → Result Unit) (range : I64 → I64 → Result (List I64))
    (ntuple : (I64 → Result I64) → Nat → Result (List I64))
    (cartesian : List I64 → Result C) (isArray : X → Bool) (isempty : X → Result Bool)
    (lengthArg : X → Result I64) (catSizeArg : X → I64 → Result I64)
    (catSizeDest : A → I64 → Result I64)
    (calcIndex : V → V → List I64 → I64 → Result I64) (values : X → Result (List E))
    (setBlock : A → C → C → X → Result Unit) (setElement : A → I64 → E → Result Unit)
    (setScalar : A → C → X → Result Unit)
    (rank : Nat) (a : A) (scratch1 scratch2 : V) (d1 d2 : I64) (as : List X),
    let run := hvncatFillArrays length size cumprod get set range ntuple cartesian isArray
      isempty lengthArg catSizeArg catSizeDest calcIndex values setBlock setElement setScalar
      rank a scratch1 scratch2 d1 d2 as
    (rank ≤ 1 → run = .error (.julia (.argumentError
      "dimensions of the destination array must be at least 2"))) ∧
    (∀ l1 l2, 2 ≤ rank → length scratch1 = .ok l1 → length scratch2 = .ok l2 →
      ¬ (l1.val = l2.val ∧ l2.val = rank) → run = .error (.julia (.argumentError
        "scratch vectors must have as many elements as the destination array has dimensions"))) ∧
    (∀ l1 l2, 2 ≤ rank → length scratch1 = .ok l1 → length scratch2 = .ok l2 →
      l1.val = rank → l2.val = rank →
      ¬ (0 < d1.val ∧ d1.val < 3 ∧ 0 < d2.val ∧ d2.val < 3 ∧ d1.val ≠ d2.val) →
      run = .error (.julia (.argumentError "d1 and d2 must be either 1 or 2, exclusive.")))

theorem hvncatFillChecks_proven : HvncatFillChecks := by
  intro A X V C E length size cumprod get set range ntuple cartesian isArray isempty lengthArg
    catSizeArg catSizeDest calcIndex values setBlock setElement setScalar rank a scratch1
    scratch2 d1 d2 as
  refine ⟨?_, ?_, ?_⟩
  · intro small
    simp [hvncatFillArrays, small] <;> rfl
  · intro l1 l2 big len1 len2 bad
    have notSmall : ¬ rank ≤ 1 := by omega
    have notOk : decide (l1.val = l2.val ∧ l2.val = (rank : Int)) = false := decide_eq_false bad
    simp only [hvncatFillArrays, notSmall, len1, len2, notOk, bind, Except.bind, pure,
      Except.pure, decide_false, Bool.not_false, ↓reduceIte, throw, throwThe,
      MonadExceptOf.throw]
  · intro l1 l2 big len1 len2 eq1 eq2 bad
    have notSmall : ¬ rank ≤ 1 := by omega
    have ok : decide (l1.val = l2.val ∧ l2.val = (rank : Int)) = true :=
      decide_eq_true ⟨by omega, eq2⟩
    have notD : decide (0 < d1.val ∧ d1.val < 3 ∧ 0 < d2.val ∧ d2.val < 3 ∧ d1.val ≠ d2.val) =
      false := decide_eq_false bad
    simp only [hvncatFillArrays, notSmall, len1, len2, ok, notD, bind, Except.bind, pure,
      Except.pure, decide_false, Bool.not_false, Bool.not_true, Bool.false_eq_true, ↓reduceIte,
      throw, throwThe, MonadExceptOf.throw]

/-- Cumulative products of `sizes` as native `Int`s: entry `j` (zero-based) is
the product of the first `j + 1` sizes, as `cumprod(size(A))` returns them. -/
def nativeCumprods (sizes : List Int) : List I64 :=
  (List.range sizes.length).map (fun j => int (sizes.take (j + 1)).prod)

/-- The one-based column-major linear index of the zero-based coordinates
`coord 0, coord 1, ...` in an array with the given sizes. -/
def columnMajorIndex (sizes : List Int) (coord : Nat → Int) : Int :=
  1 + ((List.range sizes.length).map (fun j => coord j * (sizes.take j).prod)).sum

/-- `hvncat_calcindex` linearizes column-major and stays inside the
destination: with `outdimsprod` the cumulative products of positive sizes whose
total product fits `Int`, and every coordinate `inneroffsets[j] + offsets[j]`
in `0:size[j]-1`, the result is the one-based column-major linear index
`1 + Σ_j coord[j] * prod(size[1:j-1])`, which lies in `1:prod(size)` (so the
native result is exact). -/
def HvncatCalcIndexInBounds : Prop :=
  ∀ (sizes : List Int) (offsets inner : List I64),
    0 < sizes.length → (sizes.length : Int) ≤ 9223372036854775807 →
    offsets.length = sizes.length → inner.length = sizes.length →
    (∀ s ∈ sizes, 0 < s) → sizes.prod ≤ 9223372036854775807 →
    (∀ j < sizes.length, 0 ≤ (inner.getD j (int 0)).val + (offsets.getD j (int 0)).val ∧
      (inner.getD j (int 0)).val + (offsets.getD j (int 0)).val < sizes.getD j 1) →
    let coord := fun j => (inner.getD j (int 0)).val + (offsets.getD j (int 0)).val
    hvncatCalcIndex tupleGet tupleGet (fun lo hi => pure (concatRange lo hi)) offsets inner
        (nativeCumprods sizes) (int sizes.length) = .ok (int (columnMajorIndex sizes coord)) ∧
      1 ≤ columnMajorIndex sizes coord ∧ columnMajorIndex sizes coord ≤ sizes.prod

theorem prefixProd_pos (sizes : List Int) (positive : ∀ s ∈ sizes, 0 < s) :
    ∀ t, 0 < (sizes.take t).prod := by
  induction sizes with
  | nil => intro t; simp
  | cons s ss ih =>
    intro t
    cases t with
    | zero => simp
    | succ t =>
      simp only [List.take_succ_cons, List.prod_cons]
      exact Int.mul_pos (positive s (by simp)) (ih (fun x hx => positive x (by simp [hx])) t)

theorem prefixProd_le (sizes : List Int) (positive : ∀ s ∈ sizes, 0 < s) :
    ∀ t, (sizes.take t).prod ≤ sizes.prod := by
  induction sizes with
  | nil => intro t; simp
  | cons s ss ih =>
    intro t
    have rest : ∀ x ∈ ss, 0 < x := fun x hx => positive x (by simp [hx])
    have sPos : 0 < s := positive s (by simp)
    cases t with
    | zero =>
      have := prefixProd_pos ss rest ss.length
      simp only [List.take_zero, List.prod_nil, List.prod_cons, List.take_length] at this ⊢
      have : 1 * 1 ≤ s * ss.prod := Int.mul_le_mul (by omega) (by omega) (by omega) (by omega)
      omega
    | succ t =>
      simp only [List.take_succ_cons, List.prod_cons]
      exact Int.mul_le_mul_of_nonneg_left (ih rest t) (by omega)

theorem prefixProd_succ (sizes : List Int) (t : Nat) (small : t < sizes.length) :
    (sizes.take (t + 1)).prod = (sizes.take t).prod * sizes.getD t 1 := by
  rw [List.take_succ, List.getElem?_eq_getElem small, List.prod_append_int]
  simp [List.getD_eq_getElem?_getD, List.getElem?_eq_getElem small]

theorem sum_range_succ_shift (f : Nat → Int) (n : Nat) :
    ((List.range (n + 1)).map f).sum = f 0 + ((List.range n).map (fun k => f (k + 1))).sum := by
  rw [List.range_succ_eq_map]
  simp [List.map_map, Function.comp_def]

theorem columnMajorPartial (sizes : List Int) (coord : Nat → Int)
    (positive : ∀ s ∈ sizes, 0 < s)
    (bounds : ∀ j < sizes.length, 0 ≤ coord j ∧ coord j < sizes.getD j 1) :
    ∀ t ≤ sizes.length,
      0 ≤ ((List.range t).map (fun j => coord j * (sizes.take j).prod)).sum ∧
      ((List.range t).map (fun j => coord j * (sizes.take j).prod)).sum ≤
        (sizes.take t).prod - 1 := by
  intro t
  induction t with
  | zero => intro _; simp
  | succ t ih =>
    intro small
    obtain ⟨low, high⟩ := ih (by omega)
    have pPos := prefixProd_pos sizes positive t
    obtain ⟨cLow, cHigh⟩ := bounds t (by omega)
    rw [List.range_succ, List.map_append, List.sum_append, prefixProd_succ sizes t (by omega)]
    simp only [List.map_cons, List.map_nil, List.sum_cons, List.sum_nil, Int.add_zero]
    have termLow : 0 ≤ coord t * (sizes.take t).prod :=
      Int.mul_nonneg cLow (by omega)
    have termHigh : coord t * (sizes.take t).prod ≤ (sizes.getD t 1 - 1) * (sizes.take t).prod :=
      Int.mul_le_mul_of_nonneg_right (by omega) (by omega)
    have expand : (sizes.getD t 1 - 1) * (sizes.take t).prod =
        (sizes.take t).prod * sizes.getD t 1 - (sizes.take t).prod := by
      rw [Int.sub_mul, Int.one_mul, Int.mul_comm]
    omega

theorem calcIndexLoop (w : Int → Int) (body : I64 → I64 → Result (ForInStep I64)) :
    ∀ (count : Nat) (start a : Int),
    (∀ (k : Nat) (b : Int), k < count →
      body (int (start + k)) (int b) = .ok (.yield (int (b + w (start + k))))) →
    forIn (nativePositions start count) (int a) body =
      .ok (int (a + ((List.range count).map (fun k : Nat => w (start + k))).sum))
  | 0, start, a, _ => by simp [nativePositions]
  | count + 1, start, a, h => by
    have first := h 0 a (by omega)
    rw [show start + ((0 : Nat) : Int) = start by omega] at first
    have rest := calcIndexLoop w body count (start + 1) (a + w start) (fun k b hk => by
      have step := h (k + 1) b (by omega)
      rw [show start + ((k + 1 : Nat) : Int) = start + 1 + (k : Int) by omega] at step
      exact step)
    rw [nativePositions_succ, List.forIn_cons, first]
    simp only [bind, Except.bind]
    rw [rest, sum_range_succ_shift]
    have shift : (List.range count).map (fun k : Nat => w (start + ((k + 1 : Nat) : Int))) =
        (List.range count).map (fun k : Nat => w (start + 1 + k)) :=
      List.map_congr_left (fun k _ => by congr 1; omega)
    rw [shift, show start + ((0 : Nat) : Int) = start by omega]
    congr 2
    omega

theorem nativeCalcStep (b : Int) (x y p : I64) :
    int b + (x + y) * p = int (b + (x.val + y.val) * p.val) := by
  rw [show int b + (x + y) * p = int b + (int x.val + int y.val) * int p.val by
    rw [native_int_val, native_int_val, native_int_val]]
  rw [vcatNativeAdd, nativeStrideMul, vcatNativeAdd]

theorem hvncatCalcIndex_eq {V : Type} (get : V → I64 → Result I64)
    (getProduct : List I64 → I64 → Result I64) (range : I64 → I64 → Result (List I64))
    (offsets inner : V) (prods : List I64) (nd x y : I64) (js : List I64)
    (hx : get inner (int 1) = pure x) (hy : get offsets (int 1) = pure y)
    (hr : range (int 2) nd = pure js) :
    ∃ body : I64 → I64 → Result (ForInStep I64),
      hvncatCalcIndex get getProduct range offsets inner prods nd =
        forIn js (x + y + int 1) body ∧
      ∀ j r a b p, get inner j = pure a → get offsets j = pure b →
        getProduct prods (j - int 1) = pure p → body j r = pure (.yield (r + (a + b) * p)) := by
  refine ⟨?body, ?eq, ?law⟩
  case eq =>
    unfold hvncatCalcIndex
    simp only [hx, hy, hr, pure_bind, bind_pure]
    rfl
  case law =>
    intro j r a b p ha hb hp
    simp only [ha, hb, hp, pure_bind]

set_option maxRecDepth 100000 in
theorem hvncatCalcIndexInBounds_proven : HvncatCalcIndexInBounds := by
  intro sizes offsets inner nonempty lengthFits offLen innerLen positive fits bounds coord
  obtain ⟨n, hn⟩ : ∃ n, sizes.length = n + 1 := ⟨sizes.length - 1, by omega⟩
  have coordAt : ∀ t (h : t < sizes.length),
      coord t = (inner[t]'(by omega)).val + (offsets[t]'(by omega)).val := by
    intro t h
    simp [coord, List.getD_eq_getElem?_getD, List.getElem?_eq_getElem (by omega : t < inner.length),
      List.getElem?_eq_getElem (by omega : t < offsets.length)]
  have coordBounds : ∀ j < sizes.length, 0 ≤ coord j ∧ coord j < sizes.getD j 1 := bounds
  -- the partial sums and their bounds
  obtain ⟨sumLow, sumHigh⟩ := columnMajorPartial sizes coord positive coordBounds sizes.length
    (by omega)
  rw [List.take_length] at sumHigh
  have indexLow : 1 ≤ columnMajorIndex sizes coord := by
    unfold columnMajorIndex; omega
  have indexHigh : columnMajorIndex sizes coord ≤ sizes.prod := by
    unfold columnMajorIndex; omega
  refine ⟨?_, indexLow, indexHigh⟩
  -- reads of the first coordinate
  have inner1 := tupleGet_succ inner 0 (by omega) (by omega)
  have offsets1 := tupleGet_succ offsets 0 (by omega) (by omega)
  rw [show ((0 : Nat) : Int) + 1 = 1 by omega] at inner1 offsets1
  have init : inner[0]'(by omega) + offsets[0]'(by omega) + int 1 =
      int (coord 0 + 1) := by
    rw [coordAt 0 (by omega)]
    rw [show inner[0]'(by omega) + offsets[0]'(by omega) + int 1 =
        int (inner[0]'(by omega)).val + int (offsets[0]'(by omega)).val + int 1 by
      rw [native_int_val, native_int_val]]
    rw [vcatNativeAdd, vcatNativeAdd]
  -- the loop range `2:nd`
  have lengthVal : (int (sizes.length : Int)).val = sizes.length :=
    native_val_int _ (by omega) lengthFits
  have range : concatRange (int 2) (int (sizes.length : Int)) = nativePositions 2 n := by
    unfold concatRange nativePositions
    rw [lengthVal, show (int 2).val = 2 from rfl,
      show ((sizes.length : Int) - 2 + 1).toNat = n by omega]
  obtain ⟨body, unfolded, bodyLaw⟩ := hvncatCalcIndex_eq tupleGet tupleGet
    (fun lo hi => pure (concatRange lo hi)) offsets inner (nativeCumprods sizes)
    (int (sizes.length : Int)) _ _ (nativePositions 2 n) inner1 offsets1
    (by show pure (concatRange (int 2) (int (sizes.length : Int))) = _; rw [range])
  let w : Int → Int := fun j => coord (j - 1).toNat * (sizes.take (j - 1).toNat).prod
  rw [unfolded, init, calcIndexLoop w body n 2 (coord 0 + 1) ?steps]
  · have shift : (List.range n).map (fun k : Nat => w (2 + k)) =
        (List.range n).map (fun k : Nat => coord (k + 1) * (sizes.take (k + 1)).prod) :=
      List.map_congr_left (fun k _ => by
        simp only [w, show ((2 : Int) + k - 1).toNat = k + 1 by omega])
    have total : coord 0 + 1 + ((List.range n).map (fun k : Nat => w (2 + k))).sum =
        columnMajorIndex sizes coord := by
      unfold columnMajorIndex
      rw [hn, sum_range_succ_shift, shift]
      simp only [List.take_zero, List.prod_nil, Int.mul_one]
      omega
    rw [total]
  case steps =>
    intro k b hk
    have innerK := tupleGet_succ inner (k + 1) (by omega) (by omega)
    have offsetsK := tupleGet_succ offsets (k + 1) (by omega) (by omega)
    rw [show ((k + 1 : Nat) : Int) + 1 = 2 + (k : Int) by omega] at innerK offsetsK
    have prodLength : (nativeCumprods sizes).length = sizes.length := by
      simp [nativeCumprods]
    have prodK := tupleGet_succ (nativeCumprods sizes) k (by omega) (by omega)
    have prodValue : (nativeCumprods sizes)[k]'(by omega) =
        int (sizes.take (k + 1)).prod := by
      simp [nativeCumprods]
    have sub : int (2 + (k : Int)) - int 1 = int ((k : Int) + 1) := by
      rw [vcatNativeSub]
      rw [show (2 : Int) + k - 1 = (k : Int) + 1 by omega]
    rw [bodyLaw _ _ _ _ _ innerK offsetsK (by rw [sub]; exact prodK), nativeCalcStep, prodValue]
    have pLow := prefixProd_pos sizes positive (k + 1)
    have pHigh := prefixProd_le sizes positive (k + 1)
    have pVal : (int (sizes.take (k + 1)).prod).val = (sizes.take (k + 1)).prod :=
      native_val_int _ (by omega) (by omega)
    rw [pVal, ← coordAt (k + 1) (by omega)]
    simp only [w, show ((2 : Int) + k - 1).toNat = k + 1 by omega]
    all_goals rfl

/-- `_typed_hvncat(T, Val(N), as::AbstractArray...)` rejects an empty argument
list and then a negative concatenation dimension, each with its `ArgumentError`
and before inspecting any array; when the first array has more than `N`
dimensions and some size above `N` differs from one, it forwards every array to
the shape-tuple method with shape `(1, ..., 1, length(as), 1)` (`N - 1` ones)
and `row_first = false`. -/
def HvncatArraysValChecks : Prop :=
  ∀ (Ty N P A B I E : Type) (negative : N → Result Bool) (le : I64 → N → Result Bool)
    (addOne subOne : N → Result P) (sub : Sum N P → N → Result P)
    (maxRank : Sum N P → I64 → Result P) (showDim : P → String)
    (rangeAfter : P → I64 → Result (List P)) (rangeBefore : I64 → P → Result (List P))
    (all : (P → Result Bool) → List P → Result Bool) (ndims catNdims : A → Result I64)
    (sizeOther catSizeOther : A → P → Result I64) (size : A → I64 → Result I64)
    (catSize : A → N → Result I64) (ones : P → Result (List I64))
