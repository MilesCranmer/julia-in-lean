theorem lower_lift {Error World Log Value : Type}
    (action : Action Error World Value) :
    lowerAction (liftAction (Log := Log) action) = action := by
  funext before
  simp only [lowerAction, liftAction, ExceptT.run, ExceptT.mk, StateT.run, StateT.mk]
  cases h : action before with
  | none => rfl
  | some result => cases result; rfl

theorem evaluate {Error World Container Element Ty Output : Type}
    (eltype : Element → Action Error World Ty)
    (promote : Ty → Ty → Action Error World Ty)
    (mapreduce : (Element → Action Error World Ty) →
      (Ty → Ty → Action Error World Ty) → Container → Action Error World Ty)
    (typedCat : Ty → Container → Action Error World Output)
    (container : Container) (before : World) :
    observeReduceVcat eltype promote mapreduce typedCat container before =
      match mapreduce eltype promote container before with
      | none => none
      | some (.error error, middle) =>
          some (.error error, (middle,
            [⟨before, middle, .mapreduce eltype promote container (.error error)⟩]))
      | some (.ok promoted, middle) =>
          (typedCat promoted container middle).map fun (outcome, after) =>
            (outcome, (after,
              [⟨before, middle, .mapreduce eltype promote container (.ok promoted)⟩,
               ⟨middle, after, .typedCat promoted container outcome⟩])) := by
  simp only [observeReduceVcat, reduceVcat, observeMapreduce, lower_lift,
    observeTypedCat, observeCall, bind, ExceptT.bind, ExceptT.run, ExceptT.mk,
    StateT.bind, StateT.run, StateT.mk]
  cases h : mapreduce eltype promote container before with
  | none => rfl
  | some first =>
      rcases first with ⟨result, middle⟩
      cases result <;> rfl

theorem provenance : ReduceVcatCallProvenance := by
  intro Error World Container Element Ty Output eltype promote mapreduce typedCat container before
  dsimp only
  rw [evaluate]
  cases hm : mapreduce eltype promote container before with
  | none =>
      constructor
      · constructor
        · intro _; exact Or.inl hm
        · intro _; rfl
      · exact True.intro
  | some first =>
      rcases first with ⟨first, middle⟩
      cases first with
      | error error =>
          constructor
          · constructor
            · intro h; cases h
            · intro h
              rcases h with h | ⟨promoted, next, hfirst, _⟩
              · rw [hm] at h; cases h
              · rw [hm] at hfirst; cases hfirst
          · constructor
            · refine ⟨eltype, promote, ⟨?_, ?_⟩, Or.inl ⟨error, rfl, rfl⟩⟩
              · intro element world; rfl
              · intro left right world; rfl
            · exact ⟨rfl, rfl⟩
      | ok promoted =>
          dsimp only
          cases hc : typedCat promoted container middle with
          | none =>
              constructor
              · constructor
                · intro _; exact Or.inr ⟨promoted, middle, hm, hc⟩
                · intro _; rfl
              · exact True.intro
          | some second =>
              rcases second with ⟨outcome, after⟩
              constructor
              · constructor
                · intro h; cases h
                · intro h
                  rcases h with h | ⟨value, next, hfirst, hnext⟩
                  · rw [hm] at h; cases h
                  · rw [hm] at hfirst
                    cases hfirst
                    rw [hc] at hnext
                    cases hnext
              · constructor
                · refine ⟨eltype, promote, ⟨?_, ?_⟩,
                    Or.inr ⟨promoted, outcome, rfl, rfl⟩⟩
                  · intro element world; rfl
                  · intro left right world; rfl
                · exact ⟨rfl, rfl, rfl⟩

