  OneCall (R := R) a (fun selected => copyArray selected a)

/-- Mutable copying preserves allocation failure before any copy operation. -/
def CopyMutableAllocationFailure : Prop := ∀ (A B World : Type)
    (similar : A → ExceptT ArrayError (StateM World) B)
    (copyto : B → A → ExceptT ArrayError (StateM World) B)
    (a : A) (before after : World) (error : ArrayError),
  (similar a).run before = (.error error, after) →
  (copyMutableArray similar copyto a).run before = (.error error, after)

/-- Mutable copying of an iterator retains the iterator and selected collection outcome. -/
def CopyMutableIteratorSelected : Prop := ∀ (A R : Type) (a : A),
  OneCall (R := R) a (fun selected => copyMutableIterator selected a)

/-- Empty-array testing preserves a failing length query and its post-state. -/
def IsEmptyLengthFailure : Prop := ∀ (A Length R World : Type)
    (length : A → ExceptT ArrayError (StateM World) Length)
