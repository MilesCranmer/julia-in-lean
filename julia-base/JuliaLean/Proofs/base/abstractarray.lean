/-- A runtime operation acts on an arbitrary private world and can return an
ArrayError after changing that world. This includes failed conversions and
mutation before failure. It has no access to the independent observation log. -/
abbrev NumericPrimitive (World : Type) (E : Type) := World → Result E × World

/-- Observations record the primitive operation actually attempted and its
actual result. These are specifications' observations, not model callbacks. -/
inductive NumericEvent (Ty A E : Type) where
  | vector (t : Ty) (length : I64) (result : Result A)
  | matrix (t : Ty) (rows columns : I64) (result : Result A)
  | size (a : A) (dim : I64) (result : Result I64)
  | shape (a : A)
      (result : Result (JuliaLean.base.abstractarray.Models1Group3.MachineTuple I64))
  | set (a : A) (index : I64) (value : E) (result : Result Unit)
  | set2 (a : A) (row column : I64) (value : E) (result : Result Unit)

/-- State is outside ExceptT so both mutations and observations survive a
thrown Julia error. Runtime primitives can modify only World, never events or the separate
audit copy of the last primitive's output World. -/
abbrev NumericTraceM (World Ty A E : Type) :=
  ExceptT ArrayError (StateM (World × List (NumericEvent Ty A E) × Option World))

/-- Run one actual boundary primitive and append its observation. -/
def numericObservePrimitive {World Ty A E B : Type}
    (primitive : NumericPrimitive World B)
    (record : Result B → NumericEvent Ty A E) : NumericTraceM World Ty A E B :=
  ExceptT.mk fun (world, events, _lastWorld) =>
    let (result, nextWorld) := primitive world
    (result, (nextWorld, events ++ [record result], some nextWorld))

/-- The six original Array runtime operations are instrumented uniformly.
Nothing here implements a concatenation, selects its indices, or supplies an
assumption about a callee. -/
def numericObserveRuntime {World Ty A E : Type}
    (runtime : JuliaLean.base.abstractarray.Models1Group3.NumericArrayRuntime
      (NumericPrimitive World) Ty A E) :
    JuliaLean.base.abstractarray.Models1Group3.NumericArrayRuntime
      (NumericTraceM World Ty A E) Ty A E where
  vector := fun t n => numericObservePrimitive (runtime.vector t n) (.vector t n)
  matrix := fun t nr nc => numericObservePrimitive (runtime.matrix t nr nc) (.matrix t nr nc)
  size := fun a d => numericObservePrimitive (runtime.size a d) (.size a d)
  shape := fun a => numericObservePrimitive (runtime.shape a) (.shape a)
  set := fun a i x => numericObservePrimitive (runtime.set a i x) (.set a i x)
  set2 := fun a i j x => numericObservePrimitive (runtime.set2 a i j x) (.set2 a i j x)

/-- A primitive's recorded error, if any. -/
def numericRecordedError {Ty A E : Type} : NumericEvent Ty A E → Option ArrayError
  | .vector _ _ result => match result with
      | .ok _ => none
      | .error err => some err
  | .matrix _ _ _ result => match result with
      | .ok _ => none
      | .error err => some err
  | .size _ _ result => match result with
      | .ok _ => none
      | .error err => some err
  | .shape _ result => match result with
      | .ok _ => none
      | .error err => some err
  | .set _ _ _ result => match result with
      | .ok _ => none
      | .error err => some err
  | .set2 _ _ _ _ result => match result with
      | .ok _ => none
      | .error err => some err

/-- Read only the observed linear store attempts; mathematical Int positions
are used in the expected relation rather than the model's wrapping loop. -/
def numericStoreAttempts {Ty A E : Type} (events : List (NumericEvent Ty A E)) :
    List (A × Int × E) :=
  events.filterMap fun event => match event with
    | .set a index value _ => some (a, index.val, value)
    | _ => none

/-- The independent required ordering is the argument list's mathematical
one-based enumeration. This observes input values, never a fill-model body. -/
def numericExpectedStores {A E : Type} (a : A)
    (xs : JuliaLean.base.abstractarray.Models1Group3.MachineTuple E) : List (A × Int × E) :=
  xs.values.zipIdx.map fun (value, index) => (a, (index : Int) + 1, value)

/-- After allocation every primitive concerns that handle. There is no
second allocation and no Cartesian store in scalar column-order filling. -/
