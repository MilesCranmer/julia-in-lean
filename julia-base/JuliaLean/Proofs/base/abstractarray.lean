    intro pre x post split
    obtain ⟨small, rfl⟩ := range_map_split _ _ pre post x split
    have smallAll : ∀ a ∈ as, pre.length < a.values.length := fun a ha => by
      rw [lengths a ha]; exact small
    have reads : ∀ a (ha : a ∈ as),
        offsetVectorRead a (int (dest.first.val + (pre.length : Int))) =
          .ok (a.values[pre.length]'(smallAll a ha)) := by
      intro a ha
      rw [← firsts a ha (by omega)]
      exact offsetVectorRead_at a (sourcesValid a ha) pre.length (smallAll a ha)
    have args := ithAllReads (Out := Out) (int (dest.first.val + (pre.length : Int)))
      pre.length (mapNTarget f dest as pre.length).2 as smallAll reads
    simp only [List.length_append, List.length_singleton]
    rw [vrun_bind args, vrun_pure_bind,
      vrun_bind (mapNTarget_write f dest valid as pre.length small), vrun_pure]
  · rw [if_neg same]
    have each : ((fun v => (sourceVectorEachindex v).map (·, v)) :
