def g11thDisplay {Ty Ref : Type} (a : NativeMatrix Ty Ref) : String :=
  let sizes := nativeMatrixShape a
  let body := String.intercalate ", " (sizes.values.map fun size => toString size.val)
  "(" ++ body ++ (if sizes.values.length = 1 then "," else "") ++ ")"

theorem g11th_tail_product {m : Type → Type} [Monad m] [LawfulMonad m]
    [MonadExceptOf ArrayError m] {Ty Ref E : Type}
    (runtime : TypedHvcatArrayRuntime m Ty Ref E) (a : NativeMatrix Ty Ref) :
    numericTailProduct (g11thFillRuntime runtime) a = pure (int 1) := by
  simp only [numericTailProduct, g11thFillRuntime, pure_bind]
  rfl

theorem g11th_show_shape {m : Type → Type} [Monad m] [LawfulMonad m]
    [MonadExceptOf ArrayError m] {Ty Ref E : Type}
    (runtime : TypedHvcatArrayRuntime m Ty Ref E) (a : NativeMatrix Ty Ref) :
    numericShowShape (g11thFillRuntime runtime) a = pure (g11thDisplay a) := by
  simp only [numericShowShape, g11thFillRuntime, pure_bind]
  rfl

theorem g11th_fill_mismatch {S Ty Ref E : Type}
    (runtime : TypedHvcatArrayRuntime (ExceptT ArrayError (StateM S)) Ty Ref E)
    (generated : Bool) (a : NativeMatrix Ty Ref) (xs : MachineTuple E) (state : S)
    (mismatch : (a.rows * a.columns).val ≠ (xs.values.length : Int)) :
    ∃ message,
      (do
        numericFill (g11thFillRuntime runtime) generated 2 a true xs
        pure a).run state =
        (.error (.julia (.argumentError message)), state) := by
  have size1 : (g11thFillRuntime runtime).size a (int 1) = pure a.rows := rfl
  have size2 : (g11thFillRuntime runtime).size a (int 2) = pure a.columns := rfl
  have bad : ((a.rows * a.columns).val != (xs.values.length : Int)) = true := by
    simp only [bne_iff_ne]
    exact mismatch
  cases generated with
  | false =>
      simp only [JuliaLean.base.abstractarray.Models1Group3.numericFill,
        hvncatFill, Bool.not_false, ite_true, hvncatFillLoop,
        size1, size2, g11th_tail_product, pure_bind, g11th_mul_one,
        xs.count_eq, bad, ite_true, g11th_show_shape]
      exact ⟨_, rfl⟩
  | true =>
      by_cases large : xs.values.length > 32
      · simp only [JuliaLean.base.abstractarray.Models1Group3.numericFill,
          hvncatFill, Bool.not_true, Bool.false_eq_true, ite_false, large, ite_true,
          hvncatFillLoop, size1, size2, g11th_tail_product, pure_bind, g11th_mul_one,
          xs.count_eq, bad, ite_true, g11th_show_shape]
        exact ⟨_, rfl⟩
      · simp only [JuliaLean.base.abstractarray.Models1Group3.numericFill,
          hvncatFill, Bool.not_true, Bool.false_eq_true, ite_false, large,
          size1, size2, pure_bind, show (2 : Nat) ≤ 2 from Nat.le_refl _,
