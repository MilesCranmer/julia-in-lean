theorem ind2subInnerLoop {Out I Coordinate : Type} (outs : List Out) (s : List Coordinate)
    (i : I) (fits : (outs.length : Int) < 9223372036854775807)
    (body : I64 → Unit → StateT (List (Out × I × Coordinate)) Result (ForInStep Unit))
