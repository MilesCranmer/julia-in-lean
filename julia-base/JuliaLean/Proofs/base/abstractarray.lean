    (valid : dest.Valid) (sourcesValid : ∀ a ∈ as, a.Valid)
    (tupleFits : (as.length : Int) ≤ 9223372036854775807) :
    (sourceMapN equal f as).run dest =
      .ok ((), { dest with values := mapNValues f dest.values (as.map (·.values)) }) := by
  have destIndices := vectorIndices_eq dest valid
