inductive LastIterableCall (A Requested ReverseIterator Taken Collected Out : Type) where
  | reverseIterator (iterator : A) (outcome : Except ArrayError ReverseIterator)
  | take (iterator : ReverseIterator) (requested : Requested) (outcome : Except ArrayError Taken)
  | collect (taken : Taken) (outcome : Except ArrayError Collected)
  | reverseBang (collected : Collected) (outcome : Except ArrayError Out)

/-- All selected outcomes are legal, including the last reverse! throwing
after mutation or returning a value of a different Julia type from collected
storage. Later calls receive the actual earlier result, not a replacement.
-/
def LastIterableOutcome {A Requested ReverseIterator Taken Collected Out : Type}
    (iterator : A) (requested : Requested) (outcome : Except ArrayError Out)
    (calls : List (LastIterableCall A Requested ReverseIterator Taken Collected Out)) : Prop :=
  (∃ error, calls = [.reverseIterator iterator (.error error)] ∧ outcome = .error error) ∨
  (∃ reverse error, calls = [.reverseIterator iterator (.ok reverse),
      .take reverse requested (.error error)] ∧ outcome = .error error) ∨
  (∃ reverse taken error, calls = [.reverseIterator iterator (.ok reverse),
      .take reverse requested (.ok taken), .collect taken (.error error)] ∧
    outcome = .error error) ∨
  (∃ reverse taken collected, calls = [.reverseIterator iterator (.ok reverse),
      .take reverse requested (.ok taken), .collect taken (.ok collected),
      .reverseBang collected outcome])

def observeLastIterable {World A Requested ReverseIterator Taken Collected Out : Type}
    (reverseIterator : A → InterfaceM World ReverseIterator)
    (take : ReverseIterator → Requested → InterfaceM World Taken)
    (collect : Taken → InterfaceM World Collected)
    (reverseBang : Collected → InterfaceM World Out) (iterator : A) (requested : Requested) :
    InterfaceM (World × List (InterfaceStep World
      (LastIterableCall A Requested ReverseIterator Taken Collected Out))) Out :=
  JuliaLean.base.abstractarray.Models1Group1.lastN
    (fun a => recordInterfaceCall (.reverseIterator a) (reverseIterator a))
    (fun reverse n => recordInterfaceCall (.take reverse n) (take reverse n))
    (fun taken => recordInterfaceCall (.collect taken) (collect taken))
    (fun collected => recordInterfaceCall (.reverseBang collected) (reverseBang collected))
    iterator requested

/-- The iterable last(itr,n) pipeline conserves the requested integer and
each selected result through reverse iterator, take, collect, and reverse!.
It returns reverse!'s actual result, with no implicit same-type assertion, and
preserves the first selected exception together with all earlier state effects.
The log is an independent outcome/provenance relation, not an expected bind
program or an assumed reverse/take/collect correctness law.

