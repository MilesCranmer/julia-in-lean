  match input with
  | .tuple values => ∃ element, item = .inl element ∧ 1 ≤ index.val ∧
      values.values[(index.val - 1).toNat]? = some element
  | .vector value => ∃ earlier,
      prior = earlier ++ [.getVector value index (.ok item)]

/-- Selected arguments and call counts are tied to previously observed
values. Native Int length results never invoke the nonnative constructor.
This predicate examines data provenance; it does not evaluate a callee or
run a second concatenation algorithm. -/
def VcatFillArgumentProvenance (input : Input) (target : Target)
    (events : List Event) : Prop :=
  ∀ prior event suffix, events = prior ++ event :: suffix →
    match event with
    | .lengthVector value _ => input = .vector value ∧ prior = []
    | .getVector value index _ =>
        input = .vector value ∧
        VcatFillGetCount prior = VcatFillStoreCount prior ∧
        ∃ count, VcatFillCountRecorded input prior count ∧
          index.val = (VcatFillStoreCount prior : Int) + 1 ∧
          1 ≤ index.val ∧ index.val ≤ count.val
    | .lengthItem item _ =>
        VcatFillLengthCount prior = VcatFillStoreCount prior ∧
        ∃ count index, VcatFillCountRecorded input prior count ∧
          index.val = (VcatFillStoreCount prior : Int) + 1 ∧
          1 ≤ index.val ∧ index.val ≤ count.val ∧
          VcatFillItemRecorded input index item prior
    | .toInt value _ =>
        (∃ earlier container,
          prior = earlier ++ [.lengthVector container (.ok (.inr value))]) ∨
        (∃ earlier item,
          prior = earlier ++ [.lengthItem item (.ok (.inr value))])
