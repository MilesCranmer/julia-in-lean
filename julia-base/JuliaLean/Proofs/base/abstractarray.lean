/-- Interface observations retain the state reached by success or exception. -/
abbrev ShapeState (S α : Type) := ExceptT ArrayError (StateM S) α

/-- The actual result/state pair of a selected leaf to_shape method. -/
def shapeObserve {S α : Type} (action : ShapeState S α) (before : S) :
    Except ArrayError α × S := action.run before

/-- A flat relation between input positions, observed output positions, and
state boundaries. Every listed conversion must succeed at its corresponding
position. This is independent of mapM and contains no recursive implementation
