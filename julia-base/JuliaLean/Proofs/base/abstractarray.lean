/-- Known intrinsic errors and arbitrary selected user exception payloads. -/
abbrev VcatFillError (OtherError : Type) := Sum ArrayError OtherError

/-- Selected calls can mutate World before either returning or raising an
exception. The observation property imposes no correctness law on them. -/
abbrev VcatFillEffect (World OtherError : Type) :=
  ExceptT (VcatFillError OtherError) (StateM World)

structure VcatFillObservationStep (World Event : Type) where
  before : World
  after : World
  event : Event

abbrev VcatFillObserve (World OtherError Event : Type) :=
  ExceptT (VcatFillError OtherError)
    (StateM (World × List (VcatFillObservationStep World Event)))

instance {World OtherError Event : Type} :
    MonadExceptOf ArrayError (VcatFillObserve World OtherError Event) where
  throw error := fun state => (.error (.inl error), state)
  tryCatch action handler := fun state =>
    let (result, next) := action.run state
