/-- Known Julia array errors and arbitrary selected user exceptions share one
observation channel. The right branch has no class or payload restriction. -/
abbrev StrideError (OtherError : Type) := Sum ArrayError OtherError

/-- Arbitrary selected-call observations; state is retained when a call fails. -/
abbrev StrideEffect (World OtherError : Type) :=
  ExceptT (StrideError OtherError) (StateM World)

/-- A harness cutoff is separate from every Julia exception. It bounds only
observed loop progress, never the source model, its inputs, or its arithmetic. -/
inductive StrideObservationError (OtherError : Type) where
  | runtime (error : StrideError OtherError)
  | cutoff

structure StrideObservationStep (World Event : Type) where
  before : World
  after : World
  event : Event

abbrev StrideObserve (World OtherError Event : Type) :=
  ExceptT (StrideObservationError OtherError)
    (StateM (World × List (StrideObservationStep World Event)))

instance {World OtherError Event : Type} :
    MonadExceptOf ArrayError (StrideObserve World OtherError Event) where
  throw error := fun state => (.error (.runtime (.inl error)), state)
  tryCatch action handler := fun state =>
    let (outcome, next) := action.run state
    match outcome with
    | .ok value => (.ok value, next)
    | .error (.runtime (.inl error)) => (handler error).run next
    | .error (.runtime (.inr error)) => (.error (.runtime (.inr error)), next)
    | .error .cutoff => (.error .cutoff, next)

/-- An observation wrapper records the actual selected result and both worlds.
Selected user code sees World only, so it cannot fabricate or erase this log. -/
def recordStrideCall {World OtherError Event Value : Type}
    (event : Except (StrideError OtherError) Value → Event)
    (action : StrideEffect World OtherError Value) : StrideObserve World OtherError Event Value :=
  fun state =>
    let actual := action.run state.1
    (actual.1.mapError StrideObservationError.runtime,
      (actual.2, state.2 ++ [⟨state.1, actual.2, event actual.1⟩]))

/-- The log alone specifies state continuity; no selected call is evaluated. -/
def StrideWorldContinuity {World Event : Type} (initial final : World) :
    List (StrideObservationStep World Event) → Prop
  | [] => final = initial
  | event :: rest => event.before = initial ∧
      StrideWorldContinuity event.after final rest

inductive StrideEvent
    (OtherError A K Rank Strides Sizes Range Index Other NotBool IteratorState : Type) where
  | strides (array : A) (outcome : Except (StrideError OtherError) Strides)
  | ndims (array : A) (outcome : Except (StrideError OtherError) Rank)
  | lessEqual (requested : K) (rank : Rank)
      (outcome : Except (StrideError OtherError) (TypeAssertion Bool NotBool))
  | getRequested (strides : Strides) (requested : K)
      (outcome : Except (StrideError OtherError) (RuntimeValue Other))
  | equalZero (rank : Rank) (zero : I64)
      (outcome : Except (StrideError OtherError) (TypeAssertion Bool NotBool))
  | size (array : A) (outcome : Except (StrideError OtherError) Sizes)
  | getStride (strides : Strides) (index : RuntimeValue Index)
      (outcome : Except (StrideError OtherError) (RuntimeValue Other))
  | getSize (sizes : Sizes) (index : RuntimeValue Index)
      (outcome : Except (StrideError OtherError) (RuntimeValue Other))
  | multiply (left right : RuntimeValue Other)
      (outcome : Except (StrideError OtherError) (RuntimeValue Other))
  | add (left right : RuntimeValue Other)
      (outcome : Except (StrideError OtherError) (RuntimeValue Other))
  | colon (first : I64) (rank : Rank) (outcome : Except (StrideError OtherError) Range)
  | iterate (range : Range) (state : Option IteratorState)
      (outcome : Except (StrideError OtherError) (Option (RuntimeValue Index × IteratorState)))

/-- Arbitrary selected iterate/destructuring observations at the existing
language-loop protocol boundary. None is termination; no law about indices,
state, effects, errors, or how many iterations occur is supplied. -/
structure StrideIterationOps (World OtherError Range Index IteratorState : Type) where
  first : Range → StrideEffect World OtherError (Option (RuntimeValue Index × IteratorState))
  next : Range → IteratorState → StrideEffect World OtherError (Option (RuntimeValue Index × IteratorState))

/-- This envelope belongs only to the observation harness. The source model
receives the actual range through its ordinary ForIn adapter. Every natural
observation budget is quantified, so no finite bound is a source precondition. -/
structure StrideObservedRange (World OtherError Range Index IteratorState : Type) where
  value : Range
  budget : Nat
  iteration : StrideIterationOps World OtherError Range Index IteratorState

section StrideObservation

variable {World OtherError A K Rank Strides Sizes Range Index Other NotBool IteratorState : Type}

local notation "Event" =>
  StrideEvent OtherError A K Rank Strides Sizes Range Index Other NotBool IteratorState
local notation "Observed" => StrideObserve World OtherError Event

/-- Run a finite observation of Julia's for protocol. The iterator calls remain
arbitrary and are logged like all other dispatch leaves. A cutoff reports that
observation ended; it is never confused with a source return or Julia error.
The recursion here is structural observation bookkeeping, outside the model.
-/
def observeStrideFor {Value : Type}
    (range : StrideObservedRange World OtherError Range Index IteratorState)
    (body : RuntimeValue Index → Value → Observed (ForInStep Value)) :
    Nat → Option IteratorState → Value → Observed Value
  | 0, _, _ => fun state => (.error .cutoff, state)
  | remaining + 1, iteratorState, value => do
      let item ← recordStrideCall (.iterate range.value iteratorState)
        (match iteratorState with
          | none => range.iteration.first range.value
          | some state => range.iteration.next range.value state)
      match item with
      | none => pure value
      | some (index, nextState) =>
          match ← body index value with
          | .done result => pure result
          | .yield result => observeStrideFor range body remaining (some nextState) result

instance strideObservedForIn :
    ForIn Observed (StrideObservedRange World OtherError Range Index IteratorState) (RuntimeValue Index) where
  forIn range initial body := observeStrideFor range body range.budget none initial

/-- Instrument the original selected operations without replacing their values,
exceptions, or state effects. Only colon's observation envelope and ForIn's
finite observation budget are harness data. The production model is unchanged.
-/
def observedStrideOps
    (ops : StrideOps (StrideEffect World OtherError)
      A K Rank Strides Sizes Range Index Other NotBool)
    (iteration : StrideIterationOps World OtherError Range Index IteratorState) (budget : Nat) :
    StrideOps Observed A K Rank Strides Sizes
      (StrideObservedRange World OtherError Range Index IteratorState) Index Other NotBool where
  strides array := recordStrideCall (.strides array) (ops.strides array)
  ndims array := recordStrideCall (.ndims array) (ops.ndims array)
  lessEqual requested rank :=
    recordStrideCall (.lessEqual requested rank) (ops.lessEqual requested rank)
  getRequested strides requested :=
    recordStrideCall (.getRequested strides requested) (ops.getRequested strides requested)
  equalZero rank zero := recordStrideCall (.equalZero rank zero) (ops.equalZero rank zero)
  size array := recordStrideCall (.size array) (ops.size array)
  getStride strides index := recordStrideCall (.getStride strides index) (ops.getStride strides index)
  getSize sizes index := recordStrideCall (.getSize sizes index) (ops.getSize sizes index)
  multiply left right := recordStrideCall (.multiply left right) (ops.multiply left right)
  add left right := recordStrideCall (.add left right) (ops.add left right)
  colon first rank := do
    let range ← recordStrideCall (.colon first rank) (ops.colon first rank)
    pure ⟨range, budget, iteration⟩

/-- Read an observed exception, without invoking the operation again. -/
def strideSelectedFailure {Value : Type} : Except (StrideError OtherError) Value → Option (StrideError OtherError)
  | .error error => some error
  | .ok _ => none

/-- A non-Bool condition produces the source TypeError after the selected
comparison returns. That assertion has no separate user-code or state event. -/
def strideConditionFailure :
    Except (StrideError OtherError) (TypeAssertion Bool NotBool) → Option (StrideError OtherError)
  | .error error => some error
  | .ok (.rejected _) => some (.inl (.showError .typeError))
  | .ok (.accepted _) => none

def strideEventFailure : Event → Option (StrideError OtherError)
  | .strides _ result => strideSelectedFailure result
  | .ndims _ result => strideSelectedFailure result
  | .lessEqual _ _ result => strideConditionFailure result
  | .getRequested _ _ result => strideSelectedFailure result
  | .equalZero _ _ result => strideConditionFailure result
  | .size _ result => strideSelectedFailure result
  | .getStride _ _ result => strideSelectedFailure result
  | .getSize _ _ result => strideSelectedFailure result
  | .multiply _ _ result => strideSelectedFailure result
  | .add _ _ result => strideSelectedFailure result
  | .colon _ _ result => strideSelectedFailure result
  | .iterate _ _ result => strideSelectedFailure result

/-- No callback follows the first observed exception or rejected condition,
and the output exception is precisely that observation. Conversely every
source exception is justified by the final event, never by a fabricated error.
-/
def StrideExceptionProvenance
    (outcome : Except (StrideObservationError OtherError) (RuntimeValue Other))
    (calls : List Event) : Prop :=
  (∀ before event after error,
    calls = before ++ event :: after → strideEventFailure event = some error →
      after = [] ∧ outcome = .error (.runtime error)) ∧
  (∀ error, outcome = .error (.runtime error) →
    ∃ before event, calls = before ++ [event] ∧ strideEventFailure event = some error)

/-- Observe only the provenance of the current accumulator. No arithmetic is
performed: the first actual product initializes it, and actual additions
replace it. Later products are never silently treated as the new accumulator.
-/
def strideRecordedAccumulator (calls : List Event) : Option (RuntimeValue Other) :=
  calls.foldl (fun current event =>
    match event with
    | .multiply _ _ (.ok product) =>
        match current with
        | none => some product
        | some _ => current
    | .add _ _ (.ok result) => some result
    | _ => current) none

/-- The next iterator state is the state actually returned by the last
successful iterate call, rather than a fabricated, converted or stale state. -/
def strideRecordedIteratorState (calls : List Event) : Option IteratorState :=
  calls.foldl (fun current event =>
    match event with
    | .iterate _ _ (.ok (some (_, state))) => some state
    | _ => current) none

/-- Input identity, literal types and dataflow conservation for every observed
prefix, including errors and cutoffs. The assertions concern the independently
recorded actual arguments, never assumed correctness laws for selected code.
-/
def StrideArgumentConservation (array : A) (requested : K) (calls : List Event) : Prop :=
  ∀ before event after, calls = before ++ event :: after →
    match event with
    | .strides argument _ => before = [] ∧ argument = array
    | .ndims argument _ => argument = array
    | .lessEqual argument rank _ => argument = requested ∧
        ∃ preceding, before = preceding ++ [.ndims array (.ok rank)]
    | .getRequested strides argument _ => argument = requested ∧
        .strides array (.ok strides) ∈ before ∧
        ∃ preceding rank,
          before = preceding ++ [.lessEqual requested rank (.ok (.accepted true))]
    | .equalZero rank zero _ => zero = int 0 ∧
        ∃ preceding, before = preceding ++ [.ndims array (.ok rank)]
    | .size argument _ => argument = array ∧
        ∃ preceding rank,
          before = preceding ++ [.equalZero rank (int 0) (.ok (.accepted false))]
    | .getStride strides index _ => .strides array (.ok strides) ∈ before ∧
        ((index = .inl (int 1) ∧
          ∃ preceding sizes, before = preceding ++ [.size array (.ok sizes)]) ∨
        (∃ preceding range state nextState,
          before = preceding ++ [.iterate range state (.ok (some (index, nextState)))]))
    | .getSize sizes index _ => .size array (.ok sizes) ∈ before ∧
        ∃ preceding strides value,
          before = preceding ++ [.getStride strides index (.ok value)]
    | .multiply left right _ =>
        ∃ preceding strides sizes index,
          before = preceding ++ [.getStride strides index (.ok left),
            .getSize sizes index (.ok right)]
    | .add left right _ => strideRecordedAccumulator before = some left ∧
        ∃ preceding x y, before = preceding ++ [.multiply x y (.ok right)]
    | .colon first rank _ => first = int 2 ∧
        ∃ preceding, before = preceding ++ [.ndims array (.ok rank)]
    | .iterate range state _ => state = strideRecordedIteratorState before ∧
        ∃ rank, .colon (int 2) rank (.ok range) ∈ before

/-- A relational success trace for the language loop: each observed iterator
result identifies the next index and state; both indexing calls use that exact
index, and each sum consumes the previous accumulator and the observed product.
This relation executes no callee, computes no arithmetic, and calls no model.
-/
inductive StrideLoopSuccess (strides : Strides) (sizes : Sizes) (range : Range) :
    Option IteratorState → RuntimeValue Other → RuntimeValue Other → List Event → Prop where
  | stop (state : Option IteratorState) (value : RuntimeValue Other) :
      StrideLoopSuccess strides sizes range state value value
        [.iterate range state (.ok none)]
  | step (state : Option IteratorState) (current final : RuntimeValue Other)
      (index : RuntimeValue Index) (nextState : IteratorState)
      (left right product next : RuntimeValue Other) (rest : List Event)
      (following : StrideLoopSuccess strides sizes range (some nextState) next final rest) :
      StrideLoopSuccess strides sizes range state current final
        ([.iterate range state (.ok (some (index, nextState))),
          .getStride strides index (.ok left),
          .getSize sizes index (.ok right),
          .multiply left right (.ok product), .add current product (.ok next)] ++ rest)

/-- Complete successful-result provenance. Direct indexing returns its actual
selected value; the zero-rank path is the only literal-one return; otherwise
an empty loop returns the initial product and a nonempty loop returns its last
actual addition. Distinct rank observations and captured metadata are retained.
-/
def StrideSuccessfulOutcome (array : A) (requested : K)
    (value : RuntimeValue Other) (calls : List Event) : Prop :=
  (∃ strides rank,
    calls = [.strides array (.ok strides), .ndims array (.ok rank),
      .lessEqual requested rank (.ok (.accepted true)),
      .getRequested strides requested (.ok value)]) ∨
  (∃ strides firstRank secondRank,
    value = .inl (int 1) ∧
    calls = [.strides array (.ok strides), .ndims array (.ok firstRank),
      .lessEqual requested firstRank (.ok (.accepted false)),
      .ndims array (.ok secondRank),
      .equalZero secondRank (int 0) (.ok (.accepted true))]) ∨
  (∃ strides firstRank secondRank sizes firstStride firstSize initial thirdRank range suffix,
    calls = [.strides array (.ok strides), .ndims array (.ok firstRank),
      .lessEqual requested firstRank (.ok (.accepted false)),
      .ndims array (.ok secondRank),
      .equalZero secondRank (int 0) (.ok (.accepted false)),
      .size array (.ok sizes), .getStride strides (.inl (int 1)) (.ok firstStride),
      .getSize sizes (.inl (int 1)) (.ok firstSize),
      .multiply firstStride firstSize (.ok initial), .ndims array (.ok thirdRank),
      .colon (int 2) thirdRank (.ok range)] ++ suffix ∧
    StrideLoopSuccess strides sizes range none initial value suffix)

end StrideObservation

/-- For every admitted Integer index, array/interface carrier and arbitrary
stateful/erroring dispatch implementation, stride preserves original argument
identities, native literal types, every observed state transition, the first
selected exception, and actual accumulator provenance. Known ArrayError values
and every arbitrary OtherError exception are included. No rank, size, numeric,
indexing, colon, iteration or callback-correctness law is assumed.

The model remains polymorphic in its monad and ForIn adapter. This observer
implements the source loop protocol with arbitrary initial/resumed iterator
calls. Every finite observation budget is quantified. Cutoff is a distinct
harness outcome, not a Julia error or a claimed return; all terminating
selected-call observations and arbitrary finite iterator prefixes are covered. A complete loop observation is available when its iterator-call
count fits the budget. No claim is made about the internal execution of a
selected callee that does not return.
No array is represented by an unrestricted list; lists here are finite logs.

