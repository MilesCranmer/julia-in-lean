results here: the enclosing assertion has not yet executed. -/
def shapeMappedPositions {S D Shape Other : Type}
    (convert : D → ShapeState S (TypeAssertion Shape Other))
    (inputs : List D) (before : S)
    (mapped : List (TypeAssertion Shape Other)) (after : S) : Prop :=
  mapped.length = inputs.length ∧
  ∃ states : List S,
    states.length = inputs.length + 1 ∧
    states.head? = some before ∧ states.getLast? = some after ∧
    ∀ (k : Nat) (d : D) (value : TypeAssertion Shape Other) (s t : S),
      inputs[k]? = some d → mapped[k]? = some value →
      states[k]? = some s → states[k + 1]? = some t →
      shapeObserve (convert d) s = (.ok value, t)

/-- Independent outcome accounting for the tuple assertion after conversion.
Successful output preserves every accepted payload and its position. An error
is either the first failing leaf after a successful prefix (even when that
prefix contains rejected tags), or TypeError after all leaves succeed and at
least one output lies outside DimsOrInds. The assertion has no state effects. -/
def shapeTupleObservation {S D Shape Other : Type}
    (convert : D → ShapeState S (TypeAssertion Shape Other))
    (inputs : List D) (before : S)
    (outcome : Except ArrayError (List Shape) × S) : Prop :=
  match outcome with
  | (.ok values, after) =>
      shapeMappedPositions convert inputs before
        (values.map (TypeAssertion.accepted (Other := Other))) after
  | (.error error, after) =>
      (∃ (visited suffix : List D) (d : D)
          (mapped : List (TypeAssertion Shape Other)) (failureState : S),
        inputs = visited ++ d :: suffix ∧
        shapeMappedPositions convert visited before mapped failureState ∧
        shapeObserve (convert d) failureState = (.error error, after)) ∨
      (∃ mapped : List (TypeAssertion Shape Other),
        shapeMappedPositions convert inputs before mapped after ∧
        (∃ rejected : Other, TypeAssertion.rejected rejected ∈ mapped) ∧
        error = .showError .typeError)

