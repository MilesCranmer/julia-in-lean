namespace JuliaLean.ChatGPT.Batch11.Group7
open JuliaLean JuliaLean.base.abstractarray
open JuliaLean.base.abstractarray.Models1Group1 (TypeAssertion)
open JuliaLean.base.abstractarray.Models2Group6
open JuliaLean.Proofs.base.abstractarray.Models2Group6

theorem g7_snoc_split {α : Type} (pre : List α) (last : α)
    (before : List α) (event : α) (after : List α)
    (h : pre ++ [last] = before ++ event :: after) :
    (∃ tail, pre = before ++ event :: tail ∧ after = tail ++ [last]) ∨
      (before = pre ∧ event = last ∧ after = []) := by
  induction before generalizing pre with
  | nil =>
      cases pre with
      | nil =>
          simp only [List.nil_append, List.cons.injEq] at h
          exact .inr ⟨rfl, h.1.symm, h.2.symm⟩
      | cons first rest =>
          simp only [List.cons_append, List.nil_append, List.cons.injEq] at h
          exact .inl ⟨rest, by rw [h.1]; rfl, h.2.symm⟩
  | cons first rest ih =>
      cases pre with
      | nil =>
          have hlength := congrArg List.length h
          simp only [List.length_append, List.length_cons, List.length_nil] at hlength
          omega
      | cons head tail =>
          simp only [List.cons_append, List.cons.injEq] at h
          cases h.1
          rcases ih tail h.2 with ⟨remaining, hp, ha⟩ | ⟨hb, he, ha⟩
          · exact .inl ⟨remaining, by rw [hp]; rfl, ha⟩
          · exact .inr ⟨by rw [hb], he, ha⟩

def g7PrefixAll {α : Type} (condition : List α → α → Prop) (events : List α) : Prop :=
  ∀ before event after, events = before ++ event :: after → condition before event

theorem g7PrefixAll_nil {α : Type} (condition : List α → α → Prop) :
    g7PrefixAll condition [] := by
  intro before event after h
  have hl := congrArg List.length h
  simp only [List.length_append, List.length_cons, List.length_nil] at hl
  omega

theorem g7PrefixAll_snoc {α : Type} {condition : List α → α → Prop}
    {events : List α} {event : α} (previous : g7PrefixAll condition events)
    (last : condition events event) : g7PrefixAll condition (events ++ [event]) := by
  intro before current after h
  rcases g7_snoc_split events event before current after h with
    ⟨tail, hp, _⟩ | ⟨hb, he, _⟩
  · exact previous before current tail hp
  · subst before
    subst current
    exact last

theorem g7Continuity_append {World Event : Type} {initial middle final : World}
    {before after : List (StrideObservationStep World Event)}
    (first : StrideWorldContinuity initial middle before)
    (next : StrideWorldContinuity middle final after) :
    StrideWorldContinuity initial final (before ++ after) := by
  induction before generalizing initial with
  | nil =>
      change middle = initial at first
      subst initial
      exact next
  | cons event rest ih =>
      exact ⟨first.1, ih first.2⟩

theorem g7Continuity_snoc {World Event : Type} {initial middle final : World}
    {before : List (StrideObservationStep World Event)} (event : Event)
    (first : StrideWorldContinuity initial middle before) :
    StrideWorldContinuity initial final (before ++ [⟨middle, final, event⟩]) :=
  g7Continuity_append first ⟨rfl, rfl⟩

def g7ExceptionContract {Event Error Outcome : Type}
    (failure : Event → Option Error) (runtime : Error → Outcome)
    (outcome : Outcome) (calls : List Event) : Prop :=
  (∀ before event after error,
    calls = before ++ event :: after → failure event = some error →
      after = [] ∧ outcome = runtime error) ∧
  (∀ error, outcome = runtime error →
    ∃ before event, calls = before ++ [event] ∧ failure event = some error)

theorem g7Exception_clean {Event Error Outcome : Type}
    {failure : Event → Option Error} {runtime : Error → Outcome}
    {outcome : Outcome} {calls : List Event}
    (clean : g7PrefixAll (fun _ event => failure event = none) calls)
    (notError : ∀ error, outcome ≠ runtime error) :
    g7ExceptionContract failure runtime outcome calls := by
  constructor
  · intro before event after error h hf
    have hc := clean before event after h
    rw [hc] at hf
    cases hf
  · intro error h
    exact False.elim (notError error h)

theorem g7Exception_last {Event Error Outcome : Type}
    {failure : Event → Option Error} {runtime : Error → Outcome}
    (runtimeInjective : Function.Injective runtime)
    {calls : List Event} {event : Event} {error : Error}
    (clean : g7PrefixAll (fun _ entry => failure entry = none) calls)
    (last : failure event = some error) :
    g7ExceptionContract failure runtime (runtime error) (calls ++ [event]) := by
  constructor
  · intro before entry after observed h hf
    rcases g7_snoc_split calls event before entry after h with
      ⟨tail, hp, _⟩ | ⟨hb, he, ha⟩
    · have hc := clean before entry tail hp
      rw [hc] at hf
      cases hf
    · subst entry
      rw [last] at hf
      cases hf
      exact ⟨ha, rfl⟩
  · intro observed h
    have he := runtimeInjective h
    subst observed
    exact ⟨calls, event, rfl, last⟩

theorem g7ExceptState_bind {Error World Value Result : Type}
    (action : ExceptT Error (StateM World) Value)
    (next : Value → ExceptT Error (StateM World) Result) (state : World) :
    (action >>= next).run state =
      match action.run state with
      | (.error error, after) => (.error error, after)
      | (.ok value, after) => (next value).run after := by
  dsimp only [ExceptT.run]
  change (ExceptT.bindCont next (action state).1) (action state).2 = _
  cases h : action state with
  | mk result after => cases result <;> rfl

theorem g7ExceptState_pure {Error World Value : Type} (value : Value) (state : World) :
    (pure value : ExceptT Error (StateM World) Value).run state = (.ok value, state) := rfl

section StrideProof
variable {World OtherError A K Rank Strides Sizes Range Index Other NotBool IteratorState : Type}
local notation "SE" => StrideEvent OtherError A K Rank Strides Sizes Range Index Other NotBool IteratorState
local notation "SO" => StrideObserve World OtherError SE

def g7StrideAt (array : A) (requested : K) (before : List SE) (event : SE) : Prop :=
  match event with
  | .strides argument _ => before = [] ∧ argument = array
  | .ndims argument _ => argument = array
  | .lessEqual argument rank _ => argument = requested ∧
      ∃ preceding, before = preceding ++ [.ndims array (.ok rank)]
  | .getRequested strides argument _ => argument = requested ∧
      .strides array (.ok strides) ∈ before ∧
      ∃ preceding rank,
        before = preceding ++ [.lessEqual requested rank (.ok (.accepted true))]
  | .equalZero rank zero _ => zero = int 0 ∧
      ∃ preceding, before = preceding ++ [.ndims array (.ok rank)]
  | .size argument _ => argument = array ∧
      ∃ preceding rank,
        before = preceding ++ [.equalZero rank (int 0) (.ok (.accepted false))]
  | .getStride strides index _ => .strides array (.ok strides) ∈ before ∧
      ((index = .inl (int 1) ∧
        ∃ preceding sizes, before = preceding ++ [.size array (.ok sizes)]) ∨
      (∃ preceding range state nextState,
        before = preceding ++ [.iterate range state (.ok (some (index, nextState)))]))
  | .getSize sizes index _ => .size array (.ok sizes) ∈ before ∧
      ∃ preceding strides value,
        before = preceding ++ [.getStride strides index (.ok value)]
  | .multiply left right _ =>
      ∃ preceding strides sizes index,
        before = preceding ++ [.getStride strides index (.ok left),
          .getSize sizes index (.ok right)]
  | .add left right _ => strideRecordedAccumulator before = some left ∧
      ∃ preceding x y, before = preceding ++ [.multiply x y (.ok right)]
  | .colon first rank _ => first = int 2 ∧
      ∃ preceding, before = preceding ++ [.ndims array (.ok rank)]
  | .iterate range state _ => state = strideRecordedIteratorState before ∧
      ∃ rank, .colon (int 2) rank (.ok range) ∈ before

theorem g7StrideArgs_nil (array : A) (requested : K) :
    StrideArgumentConservation array requested ([] : List SE) :=
  g7PrefixAll_nil (g7StrideAt array requested)

theorem g7StrideArgs_snoc {array : A} {requested : K} {calls : List SE} {event : SE}
    (previous : StrideArgumentConservation array requested calls)
    (last : g7StrideAt array requested calls event) :
    StrideArgumentConservation array requested (calls ++ [event]) :=
  g7PrefixAll_snoc previous last

def g7StrideClean (calls : List SE) : Prop :=
  g7PrefixAll (fun _ event => strideEventFailure event = none) calls

theorem g7StrideClean_snoc {calls : List SE} {event : SE}
    (previous : g7StrideClean calls) (last : strideEventFailure event = none) :
    g7StrideClean (calls ++ [event]) := g7PrefixAll_snoc previous last

theorem g7StrideError_last {calls : List SE} {event : SE} {error : StrideError OtherError}
    (clean : g7StrideClean calls) (last : strideEventFailure event = some error) :
    StrideExceptionProvenance (Other := Other) (.error (.runtime error)) (calls ++ [event]) := by
  apply g7Exception_last ?_ clean last
  intro x y h
  cases h
  rfl

theorem g7StrideSuccess_clean {calls : List SE} (value : RuntimeValue Other)
    (clean : g7StrideClean calls) : StrideExceptionProvenance (.ok value) calls := by
  apply g7Exception_clean clean
  intro error h
  cases h

theorem g7StrideCutoff_clean {calls : List SE} (clean : g7StrideClean calls) :
    StrideExceptionProvenance (Other := Other) (.error .cutoff) calls := by
  apply g7Exception_clean clean
  intro error h
  cases h


structure g7StrideChecked (initial : World) (array : A) (requested : K)
    (observed : Except (StrideObservationError OtherError) (RuntimeValue Other) ×
      (World × List (StrideObservationStep World SE))) : Prop where
  continuity : StrideWorldContinuity initial observed.2.1 observed.2.2
  arguments : StrideArgumentConservation array requested (observed.2.2.map (·.event))
  exceptions : StrideExceptionProvenance observed.1 (observed.2.2.map (·.event))

theorem g7StrideChecked_error {initial current after : World} {array : A} {requested : K}
    {log : List (StrideObservationStep World SE)} {event : SE} {error : StrideError OtherError}
    (continuity : StrideWorldContinuity initial current log)
    (arguments : StrideArgumentConservation array requested (log.map (·.event)))
    (clean : g7StrideClean (log.map (·.event)))
    (atEvent : g7StrideAt array requested (log.map (·.event)) event)
    (failure : strideEventFailure event = some error) :
    g7StrideChecked initial array requested
      (.error (.runtime error), (after, log ++ [⟨current, after, event⟩])) := by
  constructor
  · exact g7Continuity_snoc event continuity
  · simpa only [List.map_append, List.map_cons, List.map_nil] using
      g7StrideArgs_snoc arguments atEvent
  · simpa only [List.map_append, List.map_cons, List.map_nil] using
      g7StrideError_last clean failure

theorem g7StrideChecked_ok {initial current : World} {array : A} {requested : K}
    {log : List (StrideObservationStep World SE)} (value : RuntimeValue Other)
    (continuity : StrideWorldContinuity initial current log)
    (arguments : StrideArgumentConservation array requested (log.map (·.event)))
    (clean : g7StrideClean (log.map (·.event))) :
    g7StrideChecked initial array requested (.ok value, (current, log)) :=
  ⟨continuity, arguments, g7StrideSuccess_clean value clean⟩

theorem g7StrideChecked_cutoff {initial current : World} {array : A} {requested : K}
    {log : List (StrideObservationStep World SE)}
    (continuity : StrideWorldContinuity initial current log)
    (arguments : StrideArgumentConservation array requested (log.map (·.event)))
    (clean : g7StrideClean (log.map (·.event))) :
    g7StrideChecked initial array requested (.error .cutoff, (current, log)) :=
  ⟨continuity, arguments, g7StrideCutoff_clean clean⟩

theorem g7Stride_record_bind {Value Result : Type}
    (event : Except (StrideError OtherError) Value → SE)
    (action : StrideEffect World OtherError Value) (next : Value → SO Result)
    (world : World) (log : List (StrideObservationStep World SE)) :
    (recordStrideCall event action >>= next).run (world, log) =
      match action.run world with
      | (.error error, after) =>
          (.error (.runtime error), (after, log ++ [⟨world, after, event (.error error)⟩]))
      | (.ok value, after) =>
          (next value).run (after, log ++ [⟨world, after, event (.ok value)⟩]) := by
  rw [g7ExceptState_bind]
  unfold recordStrideCall
  dsimp only [ExceptT.run]
  cases h : action world with
  | mk result after => cases result <;> rfl

structure g7StrideReady (initial current : World) (array : A) (requested : K)
    (log : List (StrideObservationStep World SE)) : Prop where
  continuity : StrideWorldContinuity initial current log
  arguments : StrideArgumentConservation array requested (log.map (·.event))
  clean : g7StrideClean (log.map (·.event))

theorem g7StrideReady_snoc {initial current after : World} {array : A} {requested : K}
    {log : List (StrideObservationStep World SE)} {event : SE}
    (ready : g7StrideReady initial current array requested log)
    (atEvent : g7StrideAt array requested (log.map (·.event)) event)
    (clean : strideEventFailure event = none) :
    g7StrideReady initial after array requested (log ++ [⟨current, after, event⟩]) := by
  constructor
  · exact g7Continuity_snoc event ready.continuity
  · simpa only [List.map_append, List.map_cons, List.map_nil] using
      g7StrideArgs_snoc ready.arguments atEvent
  · simpa only [List.map_append, List.map_cons, List.map_nil] using
      g7StrideClean_snoc ready.clean clean

def g7StrideResult (initial : World) (array : A) (requested : K) (calls : List SE)
    (success : RuntimeValue Other → List SE → Prop)
    (observed : Except (StrideObservationError OtherError) (RuntimeValue Other) ×
      (World × List (StrideObservationStep World SE))) : Prop :=
  g7StrideChecked initial array requested observed ∧
    ∃ suffix, observed.2.2.map (·.event) = calls ++ suffix ∧
      ∀ value, observed.1 = .ok value → success value suffix

theorem g7StrideResult_error {initial current after : World} {array : A} {requested : K}
    {log : List (StrideObservationStep World SE)} {event : SE} {error : StrideError OtherError}
    {calls piece : List SE} {success : RuntimeValue Other → List SE → Prop}
    (ready : g7StrideReady initial current array requested log)
    (atEvent : g7StrideAt array requested (log.map (·.event)) event)
    (failure : strideEventFailure event = some error)
    (start : log.map (·.event) = calls ++ piece) :
    g7StrideResult initial array requested calls success
      (.error (.runtime error), (after, log ++ [⟨current, after, event⟩])) := by
  refine ⟨g7StrideChecked_error ready.continuity ready.arguments ready.clean atEvent failure,
    piece ++ [event], ?_, ?_⟩
  · simp only [List.map_append, List.map_cons, List.map_nil, start, List.append_assoc]
  · intro value h
    cases h

theorem g7StrideResult_ok {initial current : World} {array : A} {requested : K}
    {log : List (StrideObservationStep World SE)} {value : RuntimeValue Other}
    {calls suffix : List SE} {success : RuntimeValue Other → List SE → Prop}
    (ready : g7StrideReady initial current array requested log)
    (start : log.map (·.event) = calls ++ suffix) (result : success value suffix) :
    g7StrideResult initial array requested calls success (.ok value, (current, log)) := by
  refine ⟨g7StrideChecked_ok value ready.continuity ready.arguments ready.clean,
    suffix, start, ?_⟩
  intro value' h
  cases h
  exact result

theorem g7StrideResult_prepend {initial : World} {array : A} {requested : K}
    {calls middle piece : List SE}
    {first next : RuntimeValue Other → List SE → Prop}
    {observed : Except (StrideObservationError OtherError) (RuntimeValue Other) ×
      (World × List (StrideObservationStep World SE))}
    (result : g7StrideResult initial array requested middle next observed)
    (start : middle = calls ++ piece)
    (success : ∀ value suffix, next value suffix → first value (piece ++ suffix)) :
    g7StrideResult initial array requested calls first observed := by
  rcases result with ⟨checked, suffix, hs, hv⟩
  refine ⟨checked, piece ++ suffix, ?_, ?_⟩
  · rw [hs, start, List.append_assoc]
  · intro value h
    exact success value suffix (hv value h)

theorem g7Stride_acc_snoc (calls : List SE) (event : SE) :
    strideRecordedAccumulator (calls ++ [event]) =
      match event with
      | .multiply _ _ (.ok product) =>
          match strideRecordedAccumulator calls with
          | none => some product
          | some _ => strideRecordedAccumulator calls
      | .add _ _ (.ok result) => some result
      | _ => strideRecordedAccumulator calls := by
  unfold strideRecordedAccumulator
  rw [List.foldl_append]
  rfl

theorem g7Stride_iterator_snoc (calls : List SE) (event : SE) :
    strideRecordedIteratorState (calls ++ [event]) =
      match event with
      | .iterate _ _ (.ok (some (_, state))) => some state
      | _ => strideRecordedIteratorState calls := by
  unfold strideRecordedIteratorState
  rw [List.foldl_append]
  rfl

theorem g7Log_mem_snoc {log : List (StrideObservationStep World SE)}
    {event : SE} (step : StrideObservationStep World SE)
    (h : event ∈ log.map (·.event)) : event ∈ (log ++ [step]).map (·.event) := by
  simpa only [List.map_append, List.map_cons, List.map_nil] using
    List.mem_append_left [step.event] h

theorem g7Stride_record {Value : Type}
    (event : Except (StrideError OtherError) Value → SE)
    (action : StrideEffect World OtherError Value)
    (world : World) (log : List (StrideObservationStep World SE)) :
    (recordStrideCall event action).run (world, log) =
      match action.run world with
      | (.error error, after) =>
          (.error (.runtime error), (after, log ++ [⟨world, after, event (.error error)⟩]))
      | (.ok value, after) =>
          (.ok value, (after, log ++ [⟨world, after, event (.ok value)⟩])) := by
  unfold recordStrideCall
  dsimp only [ExceptT.run]
  cases h : action world with
  | mk result after => cases result <;> rfl

end StrideProof
