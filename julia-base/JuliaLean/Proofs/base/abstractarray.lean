private def copytoObservedError
    {D Start Offset Count PrefixOffset ShortCount Other : Type} :
    JuliaLean.base.abstractarray.Completion20261105.CopytoIterableError
      D Start Offset Count PrefixOffset ShortCount Other → ArrayError
  | .argument message =>
      match message.parts with
      | .text first :: _ =>
          if first == "tried to copy n=" then
            .julia (.argumentError "n should be non-negative")
          else if first == "source start offset (" then
            .julia (.argumentError "source start offset is < 1")
          else .julia (.argumentError "source has fewer elements than required")
      | _ => .julia (.argumentError "source has fewer elements than required")
  | .boundsOriginal _ _ | .boundsFinal _ _ => .julia .boundsError
  | .typeError _ _ _ _ => .showError .typeError

