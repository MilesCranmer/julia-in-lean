/-- A failed selected action keeps its error and final state through a bind. -/
theorem tailBindError {World A B : Type}
    (action : ExceptT ArrayError (StateM World) A)
    (next : A → ExceptT ArrayError (StateM World) B)
    (before after : World) (error : ArrayError)
    (failed : action.run before = (.error error, after)) :
    (action >>= next).run before = (.error error, after) := by
  change ExceptT.bindCont next (action.run before).1 (action.run before).2 = _
  rw [failed]
  rfl

/-- A successful action followed by a constant return yields that constant. -/
theorem tailReturnAfterSuccess {A B : Type} (action : Result A) (out returned : B)
    (success : (action >>= fun _ => pure out) = .ok returned) : returned = out := by
  cases action with
  | error error => cases success
  | ok value =>
      cases success
      rfl

