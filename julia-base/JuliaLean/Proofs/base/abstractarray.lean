    | .ok value => (.ok value, next)
    | .error (.inl error) => (handler error).run next
    | .error (.inr error) => (.error (.inr error), next)

/-- The selected action has access only to World. The wrapper separately
records its actual arguments/result and before/after states. -/
def recordVcatFillCall {World OtherError Event Value : Type}
    (event : Except (VcatFillError OtherError) Value → Event)
    (action : VcatFillEffect World OtherError Value) :
    VcatFillObserve World OtherError Event Value :=
  fun state =>
    let actual := action.run state.1
    (actual.1, (actual.2, state.2 ++ [⟨state.1, actual.2, event actual.1⟩]))

inductive VcatFillEvent
    (OtherError Container Element OtherItem OtherLength NotInt Target SetResult : Type) where
  | lengthVector (container : Container)
      (outcome : Except (VcatFillError OtherError) (RuntimeValue OtherLength))
  | getVector (container : Container) (index : I64)
      (outcome : Except (VcatFillError OtherError) (VcatFillItem Element OtherItem))
  | lengthItem (item : VcatFillItem Element OtherItem)
      (outcome : Except (VcatFillError OtherError) (RuntimeValue OtherLength))
  | toInt (value : OtherLength)
      (outcome : Except (VcatFillError OtherError) (TypeAssertion I64 NotInt))
  | setindex (array : Target) (item : VcatFillItem Element OtherItem)
      (range : NativeIntUnitRange) (outcome : Except (VcatFillError OtherError) SetResult)

section VcatFillObservation

variable {World OtherError Container Element OtherItem OtherLength NotInt Target SetResult : Type}

local notation "Event" =>
  VcatFillEvent OtherError Container Element OtherItem OtherLength NotInt Target SetResult
local notation "Observed" => VcatFillObserve World OtherError Event
local notation "Input" => VcatFillInput Container Element
local notation "Item" => VcatFillItem Element OtherItem

/-- Uniform instrumentation retains each selected leaf and does not supply
the loop, tuple operations, native identity conversion, or range construction. -/
def observedVcatFillOps
    (ops : VcatFillOps (VcatFillEffect World OtherError)
      Container Element OtherItem OtherLength NotInt Target SetResult) :
    VcatFillOps Observed Container Element OtherItem OtherLength NotInt Target SetResult where
  lengthVector value := recordVcatFillCall (.lengthVector value) (ops.lengthVector value)
  getVector value index := recordVcatFillCall (.getVector value index) (ops.getVector value index)
  lengthItem item := recordVcatFillCall (.lengthItem item) (ops.lengthItem item)
  toInt value := recordVcatFillCall (.toInt value) (ops.toInt value)
  setindex array item range :=
    recordVcatFillCall (.setindex array item range) (ops.setindex array item range)

/-- Independent state-chain invariant, including terminal exceptional calls. -/
def VcatFillWorldContinuity (initial final : World) :
    List (VcatFillObservationStep World Event) → Prop
  | [] => final = initial
  | event :: rest => event.before = initial ∧
      VcatFillWorldContinuity event.after final rest

/-- A fully successful leaf also passes its following native assertion. -/
def VcatFillEventSuccess : Event → Prop
  | .lengthVector _ (.ok _) => True
  | .getVector _ _ (.ok _) => True
  | .lengthItem _ (.ok _) => True
  | .toInt _ (.ok (.accepted _)) => True
  | .setindex _ _ _ (.ok _) => True
  | _ => False

/-- An exception can be the actual last selected exception, or the source
TypeError after an actual conversion result rejected by the Int assertion. -/
def VcatFillEventFailure (error : VcatFillError OtherError) : Event → Prop
  | .lengthVector _ (.error actual) => error = actual
  | .getVector _ _ (.error actual) => error = actual
  | .lengthItem _ (.error actual) => error = actual
  | .toInt _ (.error actual) => error = actual
  | .setindex _ _ _ (.error actual) => error = actual
  | .toInt _ (.ok (.rejected _)) => error = .inl (.showError .typeError)
  | _ => False

def VcatFillErrorTrace (error : VcatFillError OtherError) (events : List Event) : Prop :=
  ∃ prior last, events = prior ++ [last] ∧
    (∀ event ∈ prior, VcatFillEventSuccess event) ∧ VcatFillEventFailure error last

/-- Counts concern the observation log, never Julia arithmetic or loop fuel. -/
def VcatFillStoreCount : List Event → Nat
  | [] => 0
  | .setindex _ _ _ _ :: rest => VcatFillStoreCount rest + 1
  | _ :: rest => VcatFillStoreCount rest

def VcatFillGetCount : List Event → Nat
  | [] => 0
  | .getVector _ _ _ :: rest => VcatFillGetCount rest + 1
  | _ :: rest => VcatFillGetCount rest

def VcatFillLengthCount : List Event → Nat
  | [] => 0
  | .lengthItem _ _ :: rest => VcatFillLengthCount rest + 1
  | _ :: rest => VcatFillLengthCount rest

/-- A count is justified by the actual native tuple arity or by the initial
selected length/conversion observations. The tuple case specifies the
mathematical field count independently of tupleFieldCount. -/
def VcatFillCountRecorded (input : Input) (events : List Event) (count : I64) : Prop :=
  match input with
  | .tuple values => count.val = (values.values.length : Int)
  | .vector value =>
      (∃ rest, events = .lengthVector value (.ok (.inl count)) :: rest) ∨
      (∃ other rest, events = .lengthVector value (.ok (.inr other)) ::
        .toInt other (.ok (.accepted count)) :: rest)

