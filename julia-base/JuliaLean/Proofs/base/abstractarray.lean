/-- A selected dispatch action may return a value, throw any represented Julia
exception, or have no final observation. Its world state survives exceptions.
The carrier of an AbstractVector remains opaque and may represent nonstandard
indexing, aliases and arbitrary user-defined state. -/
abbrev Action (Error World Value : Type) :=
  World → Option (Except Error Value × World)

/-- The observer state is separate from the selected Julia world. No law is
imposed on any selected mapreduce, eltype, promotion, or concatenation action. -/
abbrev Observe (Error World : Type) := ExceptT Error (StateT World Option)

/-- A completed source call. A mapreduce event records the actual functions
received by that call after lowering their observer state, as well as the
actual container and result. It does not replace those functions with the
original inputs when recording the event. -/
inductive Call (Error World Container Element Ty Output : Type) where
  | mapreduce (mapFn : Element → Action Error World Ty)
      (foldFn : Ty → Ty → Action Error World Ty) (container : Container)
      (result : Except Error Ty)
  | typedCat (promoted : Ty) (container : Container) (result : Except Error Output)

/-- States at both ends of a completed call, including a throwing call. The
event list is mathematical evidence, not a Julia storage allocation. -/
structure Event (Error World Container Element Ty Output : Type) where
  before : World
  after : World
  call : Call Error World Container Element Ty Output

/-- Lift a supplied callback while preserving the observation log. No call
event is added: the callback remains an argument of the selected mapreduce. -/
def liftAction {Error World Log Value : Type} (action : Action Error World Value) :
    Observe Error (World × List Log) Value :=
  ExceptT.mk <| StateT.mk fun (before, log) =>
    (action before).map fun (result, after) => (result, (after, log))

/-- Recover the actual world action of a callback received by mapreduce. Each
invocation starts with an empty observer log, retains its result and world,
and drops only that auxiliary log. Thus higher-order instrumentation does not
silently substitute a different mapping or reduction function. -/
def lowerAction {Error World Log Value : Type}
    (action : Observe Error (World × List Log) Value) : Action Error World Value :=
  fun before => ((action.run).run (before, [])).map fun (result, (after, _)) =>
    (result, after)

/-- Record one selected source call without altering its result, exception,
world effects, or lack of a final observation. -/
def observeCall {Error World Container Element Ty Output Value : Type}
    (tag : Except Error Value → Call Error World Container Element Ty Output)
    (action : Action Error World Value) :
    Observe Error (World × List (Event Error World Container Element Ty Output)) Value :=
  ExceptT.mk <| StateT.mk fun (before, log) =>
    (action before).map fun (result, after) =>
      (result, (after, log ++ [{ before := before, after := after, call := tag result }]))

/-- Instrument the selected higher-order mapreduce itself. Both callbacks in
the event and in the underlying call are obtained from the functions actually
passed by the model under observation. -/
def observeMapreduce {Error World Container Element Ty Output : Type}
    (selected : (Element → Action Error World Ty) →
      (Ty → Ty → Action Error World Ty) → Container → Action Error World Ty)
    (mapFn : Element →
      Observe Error (World × List (Event Error World Container Element Ty Output)) Ty)
    (foldFn : Ty → Ty →
      Observe Error (World × List (Event Error World Container Element Ty Output)) Ty)
    (container : Container) :
    Observe Error (World × List (Event Error World Container Element Ty Output)) Ty :=
  let actualMap := fun element => lowerAction (mapFn element)
  let actualFold := fun left right => lowerAction (foldFn left right)
  observeCall (.mapreduce actualMap actualFold container)
    (selected actualMap actualFold container)

/-- Instrument the selected typed concatenation with the actual promoted
value and original container received at that call. -/
