  | error error => exact Or.inl hresult

theorem g3_fill_argument {Ty A E : Type} (a : A)
    (expected : List (A × Int × E)) (message : String) :
    G3FillOutcome (Ty := Ty) a expected (.error (.julia (.argumentError message))) [] := by
  refine ⟨?_, ?_, g3_failures_nil _, Or.inr ⟨message, rfl, rfl⟩⟩
  · intro event h
    cases h
  · exact ⟨expected, rfl⟩

theorem g3_fill_metadata_failure {Ty A E : Type} (a : A)
    (expected : List (A × Int × E)) (event : NumericEvent Ty A E)
    (error : ArrayError) (htarget : NumericOnlyAllocatedTarget a [event])
    (hstores : numericStoreAttempts [event] = [])
    (herror : numericRecordedError event = some error) :
    G3FillOutcome a expected (.error error) [event] := by
  refine ⟨htarget, ?_, g3_failures_singleton event error herror, Or.inl ⟨event, rfl, herror⟩⟩
  rw [hstores]
  exact ⟨expected, rfl⟩

theorem g3_fill_metadata_success {Ty A E : Type} (a : A)
    (expected : List (A × Int × E)) (event : NumericEvent Ty A E)
    (result : Result A) (events : List (NumericEvent Ty A E))
    (htarget : NumericOnlyAllocatedTarget a [event])
    (hstores : numericStoreAttempts (event :: events) = numericStoreAttempts events)
    (herror : numericRecordedError event = none)
    (hrest : G3FillOutcome a expected result events) :
    G3FillOutcome a expected result (event :: events) := by
  obtain ⟨htargetRest, hinitialEvents, hstop, hresult⟩ := hrest
  refine ⟨?_, ?_, g3_failures_cons event events result herror hstop, ?_⟩
  · intro selected he
    rcases List.mem_cons.mp he with rfl | he
    · exact htarget _ (List.mem_cons_self ..)
    · exact htargetRest selected he
  · rw [hstores]
    exact hinitialEvents
  · cases result with
    | ok returned =>
        obtain ⟨hreturned, hcomplete, hsucceeded⟩ := hresult
        refine ⟨hreturned, hstores.trans hcomplete, ?_⟩
        intro selected he
        rcases List.mem_cons.mp he with rfl | he
        · exact herror
        · exact hsucceeded selected he
    | error error =>
        rcases hresult with hlast | ⟨message, herr, hempty⟩
        · obtain ⟨last, hlast, hfailed⟩ := hlast
          refine Or.inl ⟨last, ?_, hfailed⟩
          cases events with
          | nil => cases hlast
          | cons first rest => exact hlast
        · exact Or.inr ⟨message, herr, hstores.trans hempty⟩

def G3FillCorrect {World Ty A E : Type} (a : A)
    (expected : List (A × Int × E)) (program : NumericTraceM World Ty A E A) : Prop :=
  ∀ (world : World) (initialEvents : List (NumericEvent Ty A E)),
    let observed := program.run (world, initialEvents, some world)
    ∃ events, observed.2.2.1 = initialEvents ++ events ∧
      observed.2.2.2 = some observed.2.1 ∧
      G3FillOutcome a expected observed.1 events

def g3_storeActions {World Ty A E : Type}
    (runtime : NumericArrayRuntime (NumericTraceM World Ty A E) Ty A E)
    (a : A) : List (I64 × E) → NumericTraceM World Ty A E A
  | [] => pure a
  | (index, value) :: rest => do
      runtime.set a index value
      g3_storeActions runtime a rest

theorem g3_trace_bind {World Ty A E B C : Type}
    (program : NumericTraceM World Ty A E B)
    (next : B → NumericTraceM World Ty A E C)
    (state : World × List (NumericEvent Ty A E) × Option World) :
    (program >>= next).run state =
      match program.run state with
      | (.error error, after) => (.error error, after)
      | (.ok value, after) => (next value).run after := by
  change ExceptT.bindCont next (program.run state).1 (program.run state).2 = _
  rcases program.run state with ⟨result, after⟩
  cases result <;> rfl

theorem g3_trace_throw {World Ty A E B : Type} (error : ArrayError)
    (state : World × List (NumericEvent Ty A E) × Option World) :
    (throw error : NumericTraceM World Ty A E B).run state = (.error error, state) := by
  rfl

theorem g3_trace_observe {World Ty A E B : Type}
    (primitive : NumericPrimitive World B) (record : Result B → NumericEvent Ty A E)
    (world : World) (initialEvents : List (NumericEvent Ty A E)) (audit : Option World) :
    (numericObservePrimitive primitive record).run (world, initialEvents, audit) =
      let observed := primitive world
      (observed.1, (observed.2, initialEvents ++ [record observed.1], some observed.2)) := by
  rfl

theorem g3_trace_set {World Ty A E : Type}
    (runtime : NumericArrayRuntime (NumericPrimitive World) Ty A E)
    (a : A) (index : I64) (value : E) (world : World)
    (events : List (NumericEvent Ty A E)) (audit : Option World) :
    ((numericObserveRuntime runtime).set a index value).run (world, events, audit) =
      let observed := runtime.set a index value world
      (observed.1, (observed.2, events ++ [.set a index value observed.1], some observed.2)) := by
  rfl

theorem g3_storeActions_run {World Ty A E : Type}
    (runtime : NumericArrayRuntime (NumericPrimitive World) Ty A E)
    (a : A) (pairs : List (I64 × E)) (world : World)
    (initialEvents : List (NumericEvent Ty A E)) :
    let observed := (g3_storeActions (numericObserveRuntime runtime) a pairs).run
      (world, initialEvents, some world)
    ∃ events, observed.2.2.1 = initialEvents ++ events ∧
      observed.2.2.2 = some observed.2.1 ∧
      G3StoreRun a pairs observed.1 events := by
  induction pairs generalizing world initialEvents with
  | nil =>
      refine ⟨[], ?_, rfl, G3StoreRun.done⟩
      exact (List.append_nil initialEvents).symm
  | cons pair rest ih =>
      rcases pair with ⟨index, value⟩
      simp only [g3_storeActions, g3_trace_bind, g3_trace_set]
      cases hp : runtime.set a index value world with
      | mk result nextWorld =>
          cases result with
          | error error =>
              exact ⟨[.set a index value (.error error)], rfl, rfl,
                G3StoreRun.failure index value rest error⟩
          | ok ignored =>
              cases ignored
              obtain ⟨events, hevents, haudit, hrun⟩ :=
                ih nextWorld (initialEvents ++ [.set a index value (.ok ())])
              refine ⟨.set a index value (.ok ()) :: events, ?_, haudit, ?_⟩
              · simpa only [List.append_assoc, List.singleton_append] using hevents
              · exact G3StoreRun.step index value rest _ events hrun

theorem g3_storeActions_correct {World Ty A E : Type}
    (runtime : NumericArrayRuntime (NumericPrimitive World) Ty A E)
    (a : A) (pairs : List (I64 × E)) :
    G3FillCorrect a (g3_pairStores a pairs)
      (g3_storeActions (numericObserveRuntime runtime) a pairs) := by
  intro world initialEvents
  obtain ⟨events, hevents, haudit, hrun⟩ := g3_storeActions_run runtime a pairs world initialEvents
  exact ⟨events, hevents, haudit,
    g3_storeOutcome_fillOutcome a _ _ events (g3_storeRun_outcome a pairs _ events hrun)⟩

theorem g3_query_correct {World Ty A E B : Type}
    (a : A) (expected : List (A × Int × E))
    (primitive : NumericPrimitive World B)
    (record : Result B → NumericEvent Ty A E)
    (next : B → NumericTraceM World Ty A E A)
    (htarget : ∀ result, NumericOnlyAllocatedTarget a [record result])
    (hstores : ∀ result events,
      numericStoreAttempts (record result :: events) = numericStoreAttempts events)
    (hok : ∀ value, numericRecordedError (record (.ok value)) = none)
    (herror : ∀ error, numericRecordedError (record (.error error)) = some error)
    (hnext : ∀ value, G3FillCorrect a expected (next value)) :
    G3FillCorrect a expected (numericObservePrimitive primitive record >>= next) := by
  intro world initialEvents
  simp only [g3_trace_bind, g3_trace_observe]
  cases hp : primitive world with
  | mk result nextWorld =>
      cases result with
      | error error =>
          refine ⟨[record (.error error)], rfl, rfl, ?_⟩
          exact g3_fill_metadata_failure a expected _ error (htarget _)
            (hstores _ []) (herror error)
      | ok value =>
          obtain ⟨events, hevents, haudit, houtcome⟩ :=
            hnext value nextWorld (initialEvents ++ [record (.ok value)])
          refine ⟨record (.ok value) :: events, ?_, haudit, ?_⟩
          · simpa only [List.append_assoc, List.singleton_append] using hevents
          · exact g3_fill_metadata_success a expected _ _ events
              (htarget _) (hstores _ events) (hok value) houtcome

theorem g3_size_correct {World Ty A E : Type}
    (runtime : NumericArrayRuntime (NumericPrimitive World) Ty A E)
    (a : A) (expected : List (A × Int × E)) (dim : I64)
    (next : I64 → NumericTraceM World Ty A E A)
    (hnext : ∀ value, G3FillCorrect a expected (next value)) :
    G3FillCorrect a expected ((numericObserveRuntime runtime).size a dim >>= next) := by
  apply g3_query_correct a expected (runtime.size a dim) (NumericEvent.size a dim) next
  · intro result event he
    rcases List.mem_cons.mp he with rfl | he
    · rfl
    · cases he
  · intro result events
    rfl
  · intro value
    rfl
  · intro error
    rfl
  · exact hnext

theorem g3_shape_correct {World Ty A E : Type}
    (runtime : NumericArrayRuntime (NumericPrimitive World) Ty A E)
    (a : A) (expected : List (A × Int × E))
    (next : MachineTuple I64 → NumericTraceM World Ty A E A)
    (hnext : ∀ value, G3FillCorrect a expected (next value)) :
    G3FillCorrect a expected ((numericObserveRuntime runtime).shape a >>= next) := by
  apply g3_query_correct a expected (runtime.shape a) (NumericEvent.shape a) next
  · intro result event he
    rcases List.mem_cons.mp he with rfl | he
    · rfl
    · cases he
  · intro result events
    rfl
  · intro value
    rfl
  · intro error
    rfl
  · exact hnext

theorem g3_read_store_loop {World Ty A E K : Type}
    (runtime : NumericArrayRuntime (NumericTraceM World Ty A E) Ty A E)
    (a : A) (keys : List K) (index : K → I64) (value : K → E)
    (read : K → NumericTraceM World Ty A E E)
    (hread : ∀ key ∈ keys, read key = pure (value key)) :
    (do
      for key in keys do
        runtime.set a (index key) (← read key)
      pure a) = g3_storeActions runtime a (keys.map fun key => (index key, value key)) := by
  induction keys with
  | nil => simp only [List.forIn_nil, pure_bind, List.map_nil, g3_storeActions]
  | cons key keys ih =>
      have hfirst := hread key (List.mem_cons_self ..)
      have hrest := ih (fun key hk => hread key (List.mem_cons_of_mem _ hk))
      simp only [List.forIn_cons, List.map_cons, g3_storeActions, hfirst,
        pure_bind, bind_assoc]
      rw [hrest]

theorem g3_range_getD_zipIdx {E : Type} (xs : List E) (fallback : E) :
    (List.range xs.length).map (fun k => (xs[k]?.getD fallback, k)) = xs.zipIdx := by
  apply List.ext_getElem?
  intro k
  rw [List.getElem?_map, List.getElem?_zipIdx]
  by_cases hk : k < xs.length
  · rw [List.getElem?_range hk, List.getElem?_eq_getElem hk]
    change some ((xs[k]?).getD fallback, k) = some (xs[k], 0 + k)
    rw [List.getElem?_eq_getElem hk, Nat.zero_add]
    rfl
  · rw [List.getElem?_eq_none (by simpa only [List.length_range] using Nat.le_of_not_lt hk),
      List.getElem?_eq_none (Nat.le_of_not_lt hk)]
    rfl

theorem g3_int_key_value {E : Type} (xs : MachineTuple E)
    (k : Nat) (hk : k < xs.values.length) :
    (int ((k : Int) + 1)).val = (k : Int) + 1 := by
  simpa only [g3_native_add] using g3_tuple_key_value xs k hk

theorem g3_key_stores {A E : Type} (a : A) (xs : MachineTuple E) (fallback : E) :
    g3_pairStores a ((List.range xs.values.length).map
      (fun (k : Nat) => (int ((k : Int) + 1), (xs.values[k]?).getD fallback))) =
      numericExpectedStores a xs := by
  unfold g3_pairStores numericExpectedStores
  rw [← g3_range_getD_zipIdx xs.values fallback]
  simp only [List.map_map, Function.comp_def]
  apply List.map_congr_left
  intro k hk
  rw [g3_int_key_value xs k (List.mem_range.mp hk)]

theorem g3_generated_stores_correct {World Ty A E : Type}
    (runtime : NumericArrayRuntime (NumericPrimitive World) Ty A E)
    (a : A) (xs : MachineTuple E) :
    G3FillCorrect a (numericExpectedStores a xs) (do
      for k in List.range xs.values.length do
        (numericObserveRuntime runtime).set a (int ((k : Int) + 1))
          (← numericFromResult (tupleGet xs.values (int ((k : Int) + 1))))
      pure a) := by
  cases hv : xs.values with
  | nil =>
      simpa only [numericExpectedStores, hv, List.length_nil, List.range_zero,
        List.forIn_nil, pure_bind, List.zipIdx_nil, List.map_nil,
        g3_pairStores, g3_storeActions] using g3_storeActions_correct runtime a []
  | cons first rest =>
      rw [← hv]
      let value : Nat → E := fun k => (xs.values[k]?).getD first
      have hread : ∀ k ∈ List.range xs.values.length,
          (numericFromResult (tupleGet xs.values (int ((k : Int) + 1))) :
            NumericTraceM World Ty A E E) = pure (value k) := by
        intro k hk
        have hlt := List.mem_range.mp hk
        rw [← g3_native_add, g3_tuple_get_key xs k hlt]
        dsimp only [numericFromResult, value]
        rw [List.getElem?_eq_getElem hlt]
        rfl
      rw [g3_read_store_loop (numericObserveRuntime runtime) a
        (List.range xs.values.length) (fun k => int ((k : Int) + 1)) value _ hread]
      rw [← g3_key_stores a xs first]
      exact g3_storeActions_correct runtime a _

theorem g3_loop_stores_correct {World Ty A E : Type}
    (runtime : NumericArrayRuntime (NumericPrimitive World) Ty A E)
    (a : A) (xs : MachineTuple E) :
    G3FillCorrect a (numericExpectedStores a xs) (do
      for index in ((List.range xs.values.length).map (fun (k : Nat) => int k + int 1)) do
        (numericObserveRuntime runtime).set a index
          (← numericFromResult (tupleGet xs.values index))
      pure a) := by
  simpa only [List.forIn_map, g3_native_add] using g3_generated_stores_correct runtime a xs

def g3_generatedProgram {m : Type → Type} [Monad m] [MonadExceptOf ArrayError m]
    {Ty A E : Type} (runtime : NumericArrayRuntime m Ty A E)
    (a : A) (xs : MachineTuple E) : m A := do
  let nr ← runtime.size a (int 1)
  let nc ← runtime.size a (int 2)
  if (nr * nc).val != (xs.values.length : Int) then
    throw (.julia (.argumentError ("argument count " ++ toString xs.values.length ++
      " does not match specified shape " ++ (← numericShowShape runtime a))))
  for k in List.range xs.values.length do
    runtime.set a (int ((k : Int) + 1))
      (← numericFromResult (tupleGet xs.values (int ((k : Int) + 1))))
  return a

def g3_loopProgram {m : Type → Type} [Monad m] [MonadExceptOf ArrayError m]
    {Ty A E : Type} (runtime : NumericArrayRuntime m Ty A E)
    (a : A) (xs : MachineTuple E) : m A := do
  let nr ← runtime.size a (int 1)
  let nc ← runtime.size a (int 2)
  let na ← numericTailProduct runtime a
  if ((nr * nc) * na).val != xs.count.val then
    throw (.julia (.argumentError ("argument count " ++ toString xs.count.val ++
      " does not match specified shape " ++ (← numericShowShape runtime a))))
  for index in (List.range xs.values.length).map (fun (k : Nat) => int k + int 1) do
    runtime.set a index (← numericFromResult (tupleGet xs.values index))
  return a

theorem g3_ite_bind {m : Type → Type} [Monad m] {B C : Type}
    (condition : Prop) [Decidable condition] (yes no : m B) (next : B → m C) :
    ((if condition then yes else no) >>= next) =
      if condition then yes >>= next else no >>= next := by
  split <;> rfl

theorem g3_numericFill_program {m : Type → Type} [Monad m] [LawfulMonad m]
    [MonadExceptOf ArrayError m] {Ty A E : Type}
    (runtime : NumericArrayRuntime m Ty A E) (generated : Bool)
    (rank : Nat) (hrank : rank ≤ 2) (a : A) (xs : MachineTuple E) :
    (do JuliaLean.base.abstractarray.Models1Group3.numericFill runtime generated rank a false xs; pure a) =
      if generated then
        if xs.values.length > 32 then g3_loopProgram runtime a xs
        else g3_generatedProgram runtime a xs
      else g3_loopProgram runtime a xs := by
  have keys : (numericFromResult (tupleEachindex xs) : m (List I64)) = pure
      ((List.range xs.values.length).map (fun (k : Nat) => int k + int 1)) := rfl
  cases generated with
  | false =>
      simp only [JuliaLean.base.abstractarray.Models1Group3.numericFill, hvncatFill, Bool.not_false, ite_true]
      change (hvncatFillLoop _ _ _ _ _ _ _ _ a false xs >>= fun _ => pure a) = _
      simp only [hvncatFillLoop, Bool.false_eq_true, ite_false, pure_bind,
        keys, bind_assoc, g3_ite_bind, g3_loopProgram]
  | true =>
      simp only [JuliaLean.base.abstractarray.Models1Group3.numericFill, hvncatFill, Bool.not_true, Bool.false_eq_true, ite_false]
      split
      · simp only [hvncatFillLoop, Bool.false_eq_true, ite_false, pure_bind,
          keys, bind_assoc, g3_ite_bind, g3_loopProgram, ite_true, *]
      · simp only [hrank, Bool.false_eq_true, ite_true, ite_false,
          bind_assoc, g3_ite_bind, pure_bind, g3_generatedProgram, *]


theorem g3_throw_argument_bind_correct {World Ty A E B : Type} (a : A)
    (expected : List (A × Int × E)) (message : String)
    (next : B → NumericTraceM World Ty A E A) :
    G3FillCorrect a expected
      ((throw (.julia (.argumentError message)) : NumericTraceM World Ty A E B) >>= next) := by
  intro world initialEvents
  simp only [g3_trace_bind, g3_trace_throw]
  exact ⟨[], (List.append_nil initialEvents).symm, trivial, g3_fill_argument a expected message⟩

theorem g3_generatedProgram_correct {World Ty A E : Type}
    (runtime : NumericArrayRuntime (NumericPrimitive World) Ty A E)
    (a : A) (xs : MachineTuple E) :
    G3FillCorrect a (numericExpectedStores a xs)
      (g3_generatedProgram (numericObserveRuntime runtime) a xs) := by
  unfold g3_generatedProgram
  apply g3_size_correct
  intro nr
  apply g3_size_correct
  intro nc
  split
  · simp only [numericShowShape, bind_assoc, pure_bind]
    apply g3_shape_correct
    intro shape
    apply g3_throw_argument_bind_correct
  · simpa only [pure_bind] using g3_generated_stores_correct runtime a xs

theorem g3_loopProgram_correct {World Ty A E : Type}
    (runtime : NumericArrayRuntime (NumericPrimitive World) Ty A E)
    (a : A) (xs : MachineTuple E) :
    G3FillCorrect a (numericExpectedStores a xs)
      (g3_loopProgram (numericObserveRuntime runtime) a xs) := by
  unfold g3_loopProgram
  apply g3_size_correct
  intro nr
  apply g3_size_correct
  intro nc
  simp only [numericTailProduct, bind_assoc, pure_bind]
  apply g3_shape_correct
  intro dimensions
  split
  · simp only [numericShowShape, bind_assoc, pure_bind]
    apply g3_shape_correct
    intro shape
    apply g3_throw_argument_bind_correct
  · simpa only [pure_bind] using g3_loop_stores_correct runtime a xs

theorem g3_numericFill_correct {World Ty A E : Type}
    (runtime : NumericArrayRuntime (NumericPrimitive World) Ty A E)
    (generated : Bool) (rank : Nat) (hrank : rank ≤ 2)
    (a : A) (xs : MachineTuple E) :
    G3FillCorrect a (numericExpectedStores a xs)
      (do JuliaLean.base.abstractarray.Models1Group3.numericFill (numericObserveRuntime runtime) generated rank a false xs; pure a) := by
  rw [g3_numericFill_program _ generated rank hrank]
  cases generated <;> by_cases hlong : xs.values.length > 32 <;>
    simp only [Bool.false_eq_true, ite_true, ite_false, hlong]
  · exact g3_loopProgram_correct runtime a xs
  · exact g3_loopProgram_correct runtime a xs
  · exact g3_loopProgram_correct runtime a xs
  · exact g3_generatedProgram_correct runtime a xs

theorem g3_trace_vector {World Ty A E : Type}
    (runtime : NumericArrayRuntime (NumericPrimitive World) Ty A E)
    (t : Ty) (count : I64) (world : World)
    (events : List (NumericEvent Ty A E)) (audit : Option World) :
    ((numericObserveRuntime runtime).vector t count).run (world, events, audit) =
      let observed := runtime.vector t count world
      (observed.1, (observed.2, events ++ [.vector t count observed.1], some observed.2)) := by
  rfl

theorem g3_trace_matrix {World Ty A E : Type}
    (runtime : NumericArrayRuntime (NumericPrimitive World) Ty A E)
    (t : Ty) (rows columns : I64) (world : World)
    (events : List (NumericEvent Ty A E)) (audit : Option World) :
    ((numericObserveRuntime runtime).matrix t rows columns).run (world, events, audit) =
      let observed := runtime.matrix t rows columns world
      (observed.1, (observed.2,
        events ++ [.matrix t rows columns observed.1], some observed.2)) := by
  rfl

theorem Models1G3TypedNumericVcatOrder_proven :
    JuliaLean.Proofs.base.abstractarray.Models1Group3.TypedNumericVcatOrder := by
  intro World Ty A E runtime generated t xs world
  simp only [typedNumericVcat, typedVcatNumbers, pure_bind]
  rw [g3_trace_bind, g3_trace_vector]
  cases hp : runtime.vector t xs.count world with
  | mk result nextWorld =>
      cases result with
      | error error => exact ⟨⟨rfl, xs.count_eq, rfl, rfl⟩, rfl⟩
      | ok a =>
          obtain ⟨events, hevents, haudit, houtcome⟩ :=
            g3_numericFill_correct runtime generated 1 (by decide) a xs
              nextWorld [.vector t xs.count (.ok a)]
          refine ⟨?_, haudit⟩
          change NumericVcatTrace t xs _
            ((do JuliaLean.base.abstractarray.Models1Group3.numericFill (numericObserveRuntime runtime) generated 1 a false xs; pure a).run
              (nextWorld, [.vector t xs.count (.ok a)], some nextWorld)).2.2.1
          rw [hevents]
          exact ⟨rfl, xs.count_eq, houtcome⟩

theorem Models1G3TypedNumericHcatOrder_proven :
    JuliaLean.Proofs.base.abstractarray.Models1Group3.TypedNumericHcatOrder := by
  intro World Ty A E runtime generated t xs world
  simp only [typedNumericHcat, typedHcatNumbers, pure_bind]
  rw [g3_trace_bind, g3_trace_matrix]
  cases hp : runtime.matrix t (int 1) xs.count world with
  | mk result nextWorld =>
      cases result with
      | error error => exact ⟨⟨rfl, rfl, xs.count_eq, rfl, rfl⟩, rfl⟩
      | ok a =>
          obtain ⟨events, hevents, haudit, houtcome⟩ :=
            g3_numericFill_correct runtime generated 2 (by decide) a xs
              nextWorld [.matrix t (int 1) xs.count (.ok a)]
          refine ⟨?_, haudit⟩
          change NumericHcatTrace t xs _
            ((do JuliaLean.base.abstractarray.Models1Group3.numericFill (numericObserveRuntime runtime) generated 2 a false xs; pure a).run
              (nextWorld, [.matrix t (int 1) xs.count (.ok a)], some nextWorld)).2.2.1
          rw [hevents]
          exact ⟨rfl, rfl, xs.count_eq, houtcome⟩


