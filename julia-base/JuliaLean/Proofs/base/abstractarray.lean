theorem g11th_ragged_run {World Ty Ref E : Type}
    (runtime : TypedHvcatArrayRuntime (HvcatPrimitive World) Ty Ref E)
    (generated : Bool) (t : Ty) (rows : MachineTuple I64) (xs : MachineTuple E)
    (world : World) (width : I64) (tail : List I64)
