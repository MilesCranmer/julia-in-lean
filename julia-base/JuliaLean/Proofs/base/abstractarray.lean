  apply g2AllSuccess_bind
  intro same
  cases same with
  | false =>
      apply g2AllSuccess_bind
      intro shownLeft
      apply g2AllSuccess_bind
      intro shownRight
      exact g2AllSuccess_throw _ _
  | true => exact g2AllSuccess_pure _ _ rfl

