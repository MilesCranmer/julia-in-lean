    StateT (WriteTrace E) Result (I64 × I64) :=
  hvcatColumns (fun xs => pure (int xs.length))
    (fun n d => StateT.lift (liftJulia (JInt.mod n d)))
    (fun n d => StateT.lift (liftJulia (JInt.div n d)))
