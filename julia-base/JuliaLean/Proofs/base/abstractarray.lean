inductive AxesCall (D : Type) where
  | comparison (reply : Result Bool)
  | copied (reply : Result D)

abbrev AxesObservation (World D : Type) :=
  ExceptT ArrayError (StateM (World × List (AxesCall D)))

def observeAxesAction {World D X : Type} (action : Boundary World X)
    (event : Result X → Option (AxesCall D)) : AxesObservation World D X :=
  fun (world, calls) =>
    let (reply, finalWorld) := action world
    (reply, (finalWorld, match event reply with
      | none => calls
      | some call => calls ++ [call]))

/-- Successful axes guards return true. Successful guarded copies come from
one successful copy after a successful equality observation. A false or failing
comparison prevents the copy. Arbitrary primitive errors and world changes are
included. Sources: base/abstractarray.jl:1184-1189. -/
def AxesGuardCopyProvenance : Prop :=
  ∀ (World D S Ax : Type)
    (axesDest : D → Boundary World Ax) (axesSrc : S → Boundary World Ax)
    (eq : Ax → Ax → Boundary World Bool) (showAxes : Ax → Boundary World String)
    (copy : D → S → Boundary World D) (dest : D) (src : S)
    (left right : Ax) (world : World),
    (∀ value, (checkAxesEffectful eq showAxes left right world).1 = .ok value →
      value = true) ∧
    (let observed := copytoAxesCheckLinked
      (fun d => observeAxesAction (axesDest d) (fun _ => none))
      (fun s => observeAxesAction (axesSrc s) (fun _ => none))
      (fun a b => observeAxesAction (eq a b) (fun r => some (.comparison r)))
      (fun ax => observeAxesAction (showAxes ax) (fun _ => none))
      (fun d s => observeAxesAction (copy d s) (fun r => some (.copied r)))
      dest src (world, [])
     (∀ value, observed.1 = .ok value →
       observed.2.2 = [.comparison (.ok true), .copied (.ok value)]) ∧
     (∀ reply, AxesCall.comparison reply ∈ observed.2.2 → reply ≠ .ok true →
       ∀ copied, AxesCall.copied copied ∉ observed.2.2))

/-- Unsupported scalar dispatch never produces an element or mutation result,
including when type rendering itself fails or changes shared state.
Sources: base/abstractarray.jl:1386-1387,1482-1483. -/
def UnsupportedIndexNeverSucceeds : Prop :=
  ∀ (World Style A V I E Ty : Type)
    (typeofA : A → Ty) (typeofI : I → Ty)
    (render : Ty → Boundary World String) (style : Style) (a : A)
    (value : V) (indices : I) (world : World) (answer : E),
    (getindexUnsupportedEffectful typeofA typeofI render style a indices world).1 ≠ .ok answer ∧
    (setindexUnsupportedEffectful typeofA typeofI render style a value indices world).1 ≠ .ok answer

/-- Scalar and vector linear-index projections preserve the supplied first
Integer value without narrowing or inspecting trailing indices.
Sources: base/abstractarray.jl:1398-1399. -/
def IntegerProjectionPreservesInput : Prop :=
  ∀ (A I Rest : Type) (a : A) (index : I) (rest : Rest),
    toLinearScalarInteger a index = index ∧
    toLinearVectorInteger a index rest = index

/-- Successful padding preserves the entire supplied coordinate prefix, and
remaining-size selection only removes an initial axis prefix. Tuple arities
are represented by constructible machine-sized argument tuples. Exceptions and
shared-world changes of both axes queries and first observations are unrestricted.
Sources: base/abstractarray.jl:1419-1434. -/
def SubscriptPrefixPreservation : Prop :=
  ∀ (World A Axis I : Type)
    (axes : A → Boundary World (PromotionArgs Axis))
    (first : Axis → Boundary World I) (a : A) (j : PromotionArgs I)
    (dispatchAxes : Axis × List Axis) (rank : Nat) (world : World),
    let observeAxes := fun a => do return (← axes a).values
    (∀ output, (toSubscriptsFillClosed observeAxes first a dispatchAxes j.values world).1 = .ok output →
      j.values.IsPrefix output) ∧
    (∀ output, (toSubscriptsNoRemainderClosed observeAxes first a j.values world).1 = .ok output →
      j.values.IsPrefix output) ∧
    (∀ output, (toSubscriptsSplitClosed observeAxes first rank a j.values world).1 = .ok output →
      (j.values.take rank).IsPrefix output) ∧
    (∀ axisTuple : PromotionArgs Axis, ∀ output,
      remainingSize j.values axisTuple.values = .ok output →
      output.IsSuffix axisTuple.values)

/-- A type result comes from a queried input or a selected numeric promotion.
This relation describes primitive output provenance, without assuming any
correctness rule for those primitives. -/
def EltypeofTypeOrigin {World Scalar Array Ty : Type}
    (typeof : Scalar → Ty) (eltype : Array → Boundary World Ty)
    (promote : Ty → Ty → Boundary World Ty)
    (inputs : List (EltypeofArg Scalar Array)) (answer : Ty) : Prop :=
  (∃ scalar, EltypeofArg.scalar scalar ∈ inputs ∧ answer = typeof scalar) ∨
  (∃ array world finalWorld, EltypeofArg.array array ∈ inputs ∧
    eltype array world = (.ok answer, finalWorld)) ∨
  (∃ left right world finalWorld, promote left right world = (.ok answer, finalWorld))

/-- A selected shared-array-element method may return its dispatch parameter.
The parameter is supplied by actual runtime method selection. -/
def PairParameterOrigin {Ty : Type} (method : PromotionPairMethod Ty) (answer : Ty) : Prop :=
  match method with
  | .arrayElement elementType => answer = elementType
  | .ordinary | .sameConcrete _ => False

/-- Internal element-type promotion never manufactures a type. Every successful
result is an input's reflected/query result, a numeric promotion result, or the
shared element-type dispatch parameter. This states an output provenance
invariant rather than repeating the source fold. Arbitrary failures, stateful
eltype overrides, type carriers, dispatch cases and machine-sized tuples are
included. Sources: base/abstractarray.jl:1683-1686. -/
def EltypeofPromotionProvenance : Prop :=
  ∀ (World Scalar Array Ty Rest : Type)
    (typeof : Scalar → Ty) (eltype : Array → Boundary World Ty)
    (promote : Ty → Ty → Boundary World Ty)
    (method : PromotionPairMethod Ty) (a b : EltypeofArg Scalar Array)
    (vs : PromotionArgs (EltypeofArg Scalar Array)) (rest : Rest)
    (world : World) (answer : Ty),
    ((promoteEltypeofOneSelected typeof eltype a world).1 = .ok answer →
      EltypeofTypeOrigin typeof eltype promote [a] answer) ∧
    ((promoteEltypeofSameSelected typeof eltype a rest world).1 = .ok answer →
      EltypeofTypeOrigin typeof eltype promote [a] answer) ∧
    ((promoteEltypeofTwoSelected typeof eltype promote a b world).1 = .ok answer →
      EltypeofTypeOrigin typeof eltype promote [a, b] answer) ∧
    ((promoteEltypeofManyClosed typeof eltype promote method a b vs world).1 = .ok answer →
      EltypeofTypeOrigin typeof eltype promote (a :: b :: vs.values) answer ∨
      PairParameterOrigin method answer)

/-- Value-level and type-level eltype results are separate primitive sources.
A successful same-type call returns an actual type-level query result; a
successful varargs call returns a value/type query result, numeric promotion
result, or the selected shared element-type parameter. No law of eltype or
promote_type is assumed. Sources: base/abstractarray.jl:1692-1693. -/
def EltypePromotionProvenance : Prop :=
  ∀ (World A B Value Ty Rest : Type)
    (eltypeA : A → Boundary World Ty) (eltypeB : B → Boundary World Ty)
    (eltype : Value → Boundary World Ty) (eltypeType : Ty → Boundary World Ty)
    (promote : Ty → Ty → Boundary World Ty)
    (method : PromotionPairMethod Ty) (typeToken : Ty) (a : A) (b : B)
    (vs : PromotionArgs Value) (rest : Rest) (world : World) (answer : Ty),
    ((promoteEltypeSameEffectful eltypeType typeToken a rest world).1 = .ok answer →
      ∃ finalWorld, eltypeType typeToken world = (.ok answer, finalWorld)) ∧
    ((promoteEltypeManyClosed eltypeA eltypeB eltype eltypeType promote method a b vs world).1 = .ok answer →
      (∃ queryWorld finalWorld, eltypeA a queryWorld = (.ok answer, finalWorld)) ∨
      (∃ queryWorld finalWorld, eltypeB b queryWorld = (.ok answer, finalWorld)) ∨
      (∃ input queryWorld finalWorld, input ∈ vs.values ∧
        eltype input queryWorld = (.ok answer, finalWorld)) ∨
      (∃ token queryWorld finalWorld, eltypeType token queryWorld = (.ok answer, finalWorld)) ∨
      (∃ left right queryWorld finalWorld, promote left right queryWorld = (.ok answer, finalWorld)) ∨
      PairParameterOrigin method answer)

