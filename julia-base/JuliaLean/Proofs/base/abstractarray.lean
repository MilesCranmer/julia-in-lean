            ⟨rfl, "Number of elements must be non-negative", rfl⟩))⟩
        | false =>
          cases he : (endpoint array).run firstWorld with
          | mk endpointResult endpointWorld =>
            cases endpointResult with
            | error error =>
              simp only [observationRunBind, observationRecordRun, hn, he, assertType,
                observationRunPure, Bool.false_eq_true, ite_false]
              exact ⟨⟨rfl, rfl, rfl⟩, Or.inr (Or.inr (Or.inr (Or.inl
                ⟨error, rfl, rfl⟩)))⟩
            | ok index =>
              cases hl : (length array).run endpointWorld with
              | mk lengthResult lengthWorld =>
                cases lengthResult with
                | error error =>
                  simp only [observationRunBind, observationRecordRun, hn, he, hl,
                    assertType, observationRunPure, Bool.false_eq_true, ite_false]
                  exact ⟨⟨rfl, rfl, rfl, rfl⟩, Or.inr (Or.inr (Or.inr (Or.inr (Or.inl
                    ⟨index, error, rfl, rfl⟩))))⟩
                | ok len =>
                  cases hm : (minimum requested len).run lengthWorld with
                  | mk minimumResult minimumWorld =>
                    cases minimumResult with
                    | error error =>
                      simp only [observationRunBind, observationRecordRun, hn, he, hl, hm,
                        assertType, observationRunPure, Bool.false_eq_true, ite_false]
                      exact ⟨⟨rfl, rfl, rfl, rfl, rfl⟩,
                        Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inl
                          ⟨index, len, error, rfl, rfl⟩)))))⟩
                    | ok count =>
                      cases hr : (range index count).run minimumWorld with
                      | mk rangeResult rangeWorld =>
                        cases rangeResult with
                        | error error =>
                          simp only [observationRunBind, observationRecordRun, hn, he, hl, hm, hr,
                            assertType, observationRunPure, Bool.false_eq_true, ite_false]
                          exact ⟨⟨rfl, rfl, rfl, rfl, rfl, rfl⟩,
                            Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inl
                              ⟨index, len, count, error, rfl, rfl⟩))))))⟩
                        | ok selectedRange =>
