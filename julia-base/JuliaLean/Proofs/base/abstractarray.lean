theorem g11hZeroMul (x : I64) : int 0 * x = int 0 := by
  apply Subtype.ext
  change wrapInt .i64 (0 * x.val) = _
  simp only [Int.zero_mul]
  rfl

theorem g11hRunBind {S A B : Type} (action : ExceptT ArrayError (StateM S) A)
    (next : A → ExceptT ArrayError (StateM S) B) (state : S) :
    (action >>= next).run state =
      match action.run state with
      | (.error error, after) => (.error error, after)
      | (.ok value, after) => (next value).run after := by
  change ExceptT.bindCont next (action.run state).1 (action.run state).2 = _
  rcases action.run state with ⟨outcome, after⟩
  cases outcome <;> rfl

theorem g11hRunPure {S A : Type} (value : A) (state : S) :
    (pure value : ExceptT ArrayError (StateM S) A).run state = (.ok value, state) := rfl

theorem g11hRunThrow {S A : Type} (error : ArrayError) (state : S) :
    (throw error : ExceptT ArrayError (StateM S) A).run state = (.error error, state) := rfl

theorem g11hInvalidNonneg (dimension : I64) (nonnegative : 0 ≤ dimension.val) :
    emptyHvncatInvalidDimension dimension = decide ((2 : Int)^63 - 1 ≤ dimension.val) := by
  have bounded := dimension.property
  have cast : (JInt.rem .u64 dimension).val = dimension.val := by
    change wrapInt .u64 dimension.val = dimension.val
    apply wrapInt_of_inRange
    change 0 ≤ dimension.val ∧ dimension.val ≤ 18446744073709551615
    change -9223372036854775808 ≤ dimension.val ∧ dimension.val ≤ 9223372036854775807 at bounded
    omega
  unfold emptyHvncatInvalidDimension
  rw [cast]
  rfl

theorem g11hMulVal (a b : I64) (lower : 0 ≤ a.val * b.val)
    (upper : a.val * b.val ≤ (2 : Int)^63 - 1) :
    (a * b).val = a.val * b.val := by
  change wrapInt .i64 (a.val * b.val) = a.val * b.val
  apply wrapInt_of_inRange
  change -9223372036854775808 ≤ a.val * b.val ∧ a.val * b.val ≤ 9223372036854775807
  constructor <;> omega

theorem g11hLoopZero (n : Nat) (index : I64) (zero : Bool) :
    let out := emptyHvncatCheckedDimensionsLoop (int 0) index false false zero
      (List.replicate n (int 0))
    out.1 = int 0 ∧ out.2.1 = false ∧ out.2.2.1 = false := by
  induction n generalizing index zero with
  | zero => exact ⟨rfl, rfl, rfl⟩
  | succ n ih =>
      simpa only [List.replicate_succ, emptyHvncatCheckedDimensionsLoop,
        emptyHvncatCheckedMultiply, g11hZeroMul,
        show (int 0).val = 0 from rfl, Int.zero_mul,
        show decide ((0 : Int) < IntTy.i64.min ∨ IntTy.i64.max < 0) = false from rfl,
        show emptyHvncatInvalidDimension (int 0) = false from rfl,
        Bool.false_or] using ih (index + int 1) (zero || (0 : Int) == 0)

theorem g11hCheckedZero (dimensions : MachineTuple I64) (n : Nat)
    (shape : dimensions.values = List.replicate (n + 1) (int 0)) :
    emptyHvncatCheckedDimensions dimensions = .ok (int 0) := by
  cases n with
  | zero =>
      simp only [emptyHvncatCheckedDimensions, shape, List.replicate_succ, List.replicate_zero]
      rfl
  | succ n =>
      cases n with
      | zero =>
          simp only [emptyHvncatCheckedDimensions, emptyHvncatCheckedDimensionsFlags,
            shape, List.replicate_succ, List.replicate_zero]
          rfl
      | succ n =>
          have h := g11hLoopZero (n + 2) (int 1) false
          simp only [List.replicate_succ] at h
          simp only [emptyHvncatCheckedDimensions, emptyHvncatCheckedDimensionsFlags,
            shape, List.replicate_succ,
            show emptyHvncatInvalidDimension (int 0) = false from rfl]
          simp only [h.1, h.2.1, h.2.2, Bool.false_and, Bool.false_or,
            Bool.false_eq_true, ↓reduceIte]
          rfl


theorem g11hLoopFlags (dimensions : List I64) (a index : I64)
    (overflow negative zero : Bool) :
    let out := emptyHvncatCheckedDimensionsLoop a index overflow negative zero dimensions
    (out.2.1 = false → overflow = false) ∧
    (out.2.2.1 = false → negative = false) := by
  induction dimensions generalizing a index overflow negative zero with
  | nil => exact ⟨fun h => h, fun h => h⟩
  | cons d ds ih =>
      let product := emptyHvncatCheckedMultiply a d
      have tail := ih product.1 (index + int 1) (overflow || product.2)
        (negative || emptyHvncatInvalidDimension d) (zero || d.val == 0)
      exact ⟨fun h => (Bool.or_eq_false_iff.mp (tail.1 h)).1,
        fun h => (Bool.or_eq_false_iff.mp (tail.2 h)).1⟩

theorem g11hLoopZeroFlag (dimensions : List I64) (a index : I64)
    (overflow negative : Bool) (positive : ∀ d ∈ dimensions, 0 < d.val) :
    (emptyHvncatCheckedDimensionsLoop a index overflow negative false dimensions).2.2.2 = false := by
  induction dimensions generalizing a index overflow negative with
  | nil => rfl
  | cons d ds ih =>
      have head := positive d (by simp only [List.mem_cons, true_or])
      have rest : ∀ x ∈ ds, 0 < x.val := fun x hx => positive x (List.mem_cons_of_mem d hx)
      have nz : (d.val == 0) = false := by simp only [beq_eq_false_iff_ne]; omega
      simp only [emptyHvncatCheckedDimensionsLoop, nz, Bool.false_or]
      exact ih _ _ _ _ rest

theorem g11hLoopSound (dimensions : List I64) (a index : I64)
    (overflow negative zero : Bool) (positiveA : 0 < a.val)
    (positive : ∀ d ∈ dimensions, 0 < d.val)
    (noOverflow : (emptyHvncatCheckedDimensionsLoop a index overflow negative zero dimensions).2.1 = false)
    (noNegative : (emptyHvncatCheckedDimensionsLoop a index overflow negative zero dimensions).2.2.1 = false) :
    (emptyHvncatCheckedDimensionsLoop a index overflow negative zero dimensions).1.val =
      dimensions.foldl (fun value d => value * d.val) a.val ∧
    0 < (emptyHvncatCheckedDimensionsLoop a index overflow negative zero dimensions).1.val ∧
    ∀ d ∈ dimensions, d.val < (2 : Int)^63 - 1 := by
  induction dimensions generalizing a index overflow negative zero with
  | nil => exact ⟨rfl, positiveA, fun _ h => False.elim (List.not_mem_nil h)⟩
  | cons d ds ih =>
      have head := positive d (by simp only [List.mem_cons, true_or])
      have rest : ∀ x ∈ ds, 0 < x.val := fun x hx => positive x (List.mem_cons_of_mem d hx)
      let product := emptyHvncatCheckedMultiply a d
      have flags := g11hLoopFlags ds product.1 (index + int 1) (overflow || product.2)
        (negative || emptyHvncatInvalidDimension d) (zero || d.val == 0)
      have hm := (Bool.or_eq_false_iff.mp (flags.1 noOverflow)).2
      have hn := (Bool.or_eq_false_iff.mp (flags.2 noNegative)).2
      have bounds : ¬ (a.val * d.val < IntTy.i64.min ∨ IntTy.i64.max < a.val * d.val) :=
        of_decide_eq_false hm
      have prodPos : 0 < a.val * d.val := Int.mul_pos positiveA head
      have prodVal : product.1.val = a.val * d.val := by
        apply g11hMulVal a d (by omega)
        change a.val * d.val ≤ 9223372036854775807
        change ¬ (a.val * d.val < -9223372036854775808 ∨
          9223372036854775807 < a.val * d.val) at bounds
        omega
      have dSmall : d.val < (2 : Int)^63 - 1 := by
        rw [g11hInvalidNonneg d (by omega)] at hn
        have := of_decide_eq_false hn
        omega
      obtain ⟨exactValue, outputPositive, small⟩ := ih product.1 (index + int 1)
        (overflow || product.2) (negative || emptyHvncatInvalidDimension d)
        (zero || d.val == 0) (by rw [prodVal]; exact prodPos) rest noOverflow noNegative
      refine ⟨?_, outputPositive, ?_⟩
      · simpa only [emptyHvncatCheckedDimensionsLoop, List.foldl_cons, prodVal] using exactValue
      · intro x hx
        rcases List.mem_cons.mp hx with rfl | hx
        · exact dSmall
        · exact small x hx


theorem g11hFoldLower (dimensions : List I64) (a : Int) (nonnegative : 0 ≤ a)
    (positive : ∀ d ∈ dimensions, 0 < d.val) :
    a ≤ dimensions.foldl (fun value d => value * d.val) a := by
  induction dimensions generalizing a with
  | nil => exact Int.le_refl a
  | cons d ds ih =>
      have head := positive d (by simp only [List.mem_cons, true_or])
      have rest : ∀ x ∈ ds, 0 < x.val := fun x hx => positive x (List.mem_cons_of_mem d hx)
      have multiply : a ≤ a * d.val := by
        calc
          a = a * 1 := (Int.mul_one a).symm
          _ ≤ a * d.val := Int.mul_le_mul_of_nonneg_left (by omega) nonnegative
      exact Int.le_trans multiply (ih (a * d.val) (by omega) rest)

theorem g11hLoopComplete (dimensions : List I64) (a index : I64)
    (positiveA : 0 < a.val)
    (positive : ∀ d ∈ dimensions, 0 < d.val)
    (small : ∀ d ∈ dimensions, d.val < (2 : Int)^63 - 1)
    (bound : dimensions.foldl (fun value d => value * d.val) a.val ≤ (2 : Int)^63 - 1) :
    let out := emptyHvncatCheckedDimensionsLoop a index false false false dimensions
    out.2.1 = false ∧ out.2.2.1 = false ∧ out.2.2.2 = false := by
  induction dimensions generalizing a index with
  | nil => exact ⟨rfl, rfl, rfl⟩
  | cons d ds ih =>
      have head := positive d (by simp only [List.mem_cons, true_or])
      have headSmall := small d (by simp only [List.mem_cons, true_or])
      have rest : ∀ x ∈ ds, 0 < x.val := fun x hx => positive x (List.mem_cons_of_mem d hx)
      have restSmall : ∀ x ∈ ds, x.val < (2 : Int)^63 - 1 :=
        fun x hx => small x (List.mem_cons_of_mem d hx)
      have prodPos : 0 < a.val * d.val := Int.mul_pos positiveA head
      have prodBound : a.val * d.val ≤ (2 : Int)^63 - 1 :=
        Int.le_trans (g11hFoldLower ds _ (by omega) rest) bound
      have prodVal := g11hMulVal a d (by omega) prodBound
      have noOverflow : (emptyHvncatCheckedMultiply a d).2 = false := by
        apply decide_eq_false
        change ¬ (a.val * d.val < -9223372036854775808 ∨
          9223372036854775807 < a.val * d.val)
        omega
      have noNegative : emptyHvncatInvalidDimension d = false := by
        rw [g11hInvalidNonneg d (by omega)]
        exact decide_eq_false (by omega)
      have noZero : (d.val == 0) = false := by simp only [beq_eq_false_iff_ne]; omega
      simp only [emptyHvncatCheckedDimensionsLoop, noOverflow, noNegative, noZero, Bool.false_or]
      apply ih (a * d) (index + int 1) (by rw [prodVal]; exact prodPos) rest restSmall
      simpa only [List.foldl_cons, prodVal] using bound

theorem g11hLoopProduct (dimensions : List I64) (a index : I64)
    (overflow negative zero : Bool) :
    (emptyHvncatCheckedDimensionsLoop a index overflow negative zero dimensions).1 =
      dimensions.foldl (fun value d => value * d) a := by
  induction dimensions generalizing a index overflow negative zero with
  | nil => rfl
  | cons d ds ih =>
      exact ih (a * d) (index + int 1)
        (overflow || (emptyHvncatCheckedMultiply a d).2)
        (negative || emptyHvncatInvalidDimension d) (zero || d.val == 0)

theorem g11hFlagsUniform (dimensions : MachineTuple I64) (first : I64) (rest : List I64)
    (shape : dimensions.values = first :: rest) (nonempty : rest ≠ [])
    (positive : ∀ d ∈ dimensions.values, 0 < d.val) :
    emptyHvncatCheckedDimensionsFlags dimensions =
      let out := emptyHvncatCheckedDimensionsLoop first (int 1) false
        (emptyHvncatInvalidDimension first) false rest
      (out.1, out.2.2.1 || (out.2.1 && !out.2.2.2)) := by
  cases rest with
  | nil => exact False.elim (nonempty rfl)
  | cons d ds =>
      cases ds with
      | nil =>
          have dp := positive d (by rw [shape]; simp only [List.mem_cons, List.mem_singleton, true_or, or_true])
          have nz : (d.val == 0) = false := by simp only [beq_eq_false_iff_ne]; omega
          simp only [emptyHvncatCheckedDimensionsFlags, shape,
            emptyHvncatCheckedDimensionsLoop, emptyHvncatCheckedMultiply,
            matrixCheckedMulDimensions, emptyHvncatInvalidDimension,
            nz, Bool.false_or, Bool.not_false, Bool.and_true,
            Bool.or_assoc, Bool.or_comm, Bool.or_left_comm]
      | cons e es => simp only [emptyHvncatCheckedDimensionsFlags, shape]

theorem g11hMathematicalCons (first : I64) (rest : List I64) :
    emptyHvncatMathematicalProduct (first :: rest) =
      rest.foldl (fun value d => value * d.val) first.val := by
  simp only [emptyHvncatMathematicalProduct, List.map_cons, List.foldl_cons,
    Int.one_mul, List.foldl_map]


theorem g11hCheckedNontrivial (dimensions : MachineTuple I64)
    (rank : 2 ≤ dimensions.values.length) :
    emptyHvncatCheckedDimensions dimensions =
      if (emptyHvncatCheckedDimensionsFlags dimensions).2 then
        .error (.julia (.argumentError "invalid Array dimensions"))
      else .ok (emptyHvncatCheckedDimensionsFlags dimensions).1 := by
  cases shape : dimensions.values with
  | nil => simp only [shape, List.length_nil] at rank; omega
  | cons first rest =>
      cases rest with
      | nil => simp only [shape, List.length_cons, List.length_nil] at rank; omega
      | cons second tail =>
          simp only [emptyHvncatCheckedDimensions, shape]
          cases (emptyHvncatCheckedDimensionsFlags dimensions).2 <;> rfl

theorem g11hCheckedValid (dimensions : MachineTuple I64)
    (rank : 2 ≤ dimensions.values.length)
    (positive : ∀ d ∈ dimensions.values, 0 < d.val)
    (small : ∀ d ∈ dimensions.values, d.val < (2 : Int)^63 - 1)
    (bound : emptyHvncatMathematicalProduct dimensions.values ≤ (2 : Int)^63 - 1) :
    ∃ count, emptyHvncatCheckedDimensions dimensions = .ok count ∧
      count.val = emptyHvncatMathematicalProduct dimensions.values ∧ 0 < count.val := by
  cases shape : dimensions.values with
  | nil => simp only [shape, List.length_nil] at rank; omega
  | cons first rest =>
      have nonempty : rest ≠ [] := by
        intro h; simp only [shape, h, List.length_cons, List.length_nil] at rank; omega
      have hp : 0 < first.val := positive first (by rw [shape]; exact List.mem_cons_self)
      have hs : first.val < (2 : Int)^63 - 1 := small first (by rw [shape]; exact List.mem_cons_self)
      have tailPos : ∀ d ∈ rest, 0 < d.val := fun d hd => positive d (by rw [shape]; exact List.mem_cons_of_mem first hd)
      have tailSmall : ∀ d ∈ rest, d.val < (2 : Int)^63 - 1 :=
        fun d hd => small d (by rw [shape]; exact List.mem_cons_of_mem first hd)
      have initialFlag : emptyHvncatInvalidDimension first = false := by
        rw [g11hInvalidNonneg first (by omega)]
        exact decide_eq_false (by omega)
      have bound' : rest.foldl (fun v d => v * d.val) first.val ≤ (2 : Int)^63 - 1 := by
        simpa only [shape, g11hMathematicalCons] using bound
      let out := emptyHvncatCheckedDimensionsLoop first (int 1) false false false rest
      have completed := g11hLoopComplete rest first (int 1) hp tailPos tailSmall bound'
      have uniform : emptyHvncatCheckedDimensionsFlags dimensions = (out.1, false) := by
        rw [g11hFlagsUniform dimensions first rest shape nonempty positive, initialFlag]
        simp only [completed.1, completed.2.1, completed.2.2, Bool.false_or,
          Bool.false_and]
        rfl
      have counted := g11hLoopSound rest first (int 1) false false false hp tailPos
        completed.1 completed.2.1
      refine ⟨out.1, ?_, ?_, counted.2.1⟩
      · rw [g11hCheckedNontrivial dimensions rank, uniform]
        rfl
      · simpa only [shape, g11hMathematicalCons] using counted.1

theorem g11hCheckedSuccess (dimensions : MachineTuple I64) (count : I64)
    (rank : 2 ≤ dimensions.values.length)
    (positive : ∀ d ∈ dimensions.values, 0 < d.val)
    (run : emptyHvncatCheckedDimensions dimensions = .ok count) :
    (∀ d ∈ dimensions.values, d.val < (2 : Int)^63 - 1) ∧
      count.val = emptyHvncatMathematicalProduct dimensions.values ∧ 0 < count.val := by
  rw [g11hCheckedNontrivial dimensions rank] at run
  have flagFalse : (emptyHvncatCheckedDimensionsFlags dimensions).2 = false := by
    cases h : (emptyHvncatCheckedDimensionsFlags dimensions).2
    · rfl
    · simp only [h, ↓reduceIte, reduceCtorEq] at run
  have countEq : (emptyHvncatCheckedDimensionsFlags dimensions).1 = count := by
    simpa only [flagFalse, Bool.false_eq_true, ↓reduceIte, Except.ok.injEq] using run
  cases shape : dimensions.values with
  | nil => simp only [shape, List.length_nil] at rank; omega
  | cons first rest =>
      have nonempty : rest ≠ [] := by
        intro h; simp only [shape, h, List.length_cons, List.length_nil] at rank; omega
      have hp : 0 < first.val := positive first (by rw [shape]; exact List.mem_cons_self)
      have tailPos : ∀ d ∈ rest, 0 < d.val := fun d hd => positive d (by rw [shape]; exact List.mem_cons_of_mem first hd)
      have uniform := g11hFlagsUniform dimensions first rest shape nonempty positive
      have zeroFlag := g11hLoopZeroFlag rest first (int 1) false (emptyHvncatInvalidDimension first) tailPos
      rw [uniform] at flagFalse countEq
      simp only [zeroFlag, Bool.not_false, Bool.and_true] at flagFalse
      obtain ⟨hn, ho⟩ := Bool.or_eq_false_iff.mp flagFalse
      have initialFlag := (g11hLoopFlags rest first (int 1) false
        (emptyHvncatInvalidDimension first) false).2 hn
      have firstSmall : first.val < (2 : Int)^63 - 1 := by
        rw [g11hInvalidNonneg first (by omega)] at initialFlag
        have := of_decide_eq_false initialFlag
        omega
      have counted := g11hLoopSound rest first (int 1) false
        (emptyHvncatInvalidDimension first) false hp tailPos ho hn
      refine ⟨?_, ?_, ?_⟩
      · intro d hd
        rcases List.mem_cons.mp hd with rfl | hd
        · exact firstSmall
        · exact counted.2.2 d hd
      · rw [← countEq, g11hMathematicalCons]
        exact counted.1
      · rw [← countEq]
        exact counted.2.1


theorem g11hCheckedError (dimensions : MachineTuple I64) (error : ArrayError)
    (rank : 2 ≤ dimensions.values.length)
    (positive : ∀ d ∈ dimensions.values, 0 < d.val)
    (run : emptyHvncatCheckedDimensions dimensions = .error error) :
    error = .julia (.argumentError "invalid Array dimensions") ∧
      ((∃ d ∈ dimensions.values, (2 : Int)^63 - 1 ≤ d.val) ∨
        (2 : Int)^63 - 1 < emptyHvncatMathematicalProduct dimensions.values) := by
  constructor
  · rw [g11hCheckedNontrivial dimensions rank] at run
    cases flag : (emptyHvncatCheckedDimensionsFlags dimensions).2 with
    | false => simp only [flag, Bool.false_eq_true, ↓reduceIte, reduceCtorEq] at run
    | true =>
        have e : ArrayError.julia (.argumentError "invalid Array dimensions") = error := by
          simpa only [flag, ↓reduceIte, Except.error.injEq] using run
        exact e.symm
  · by_cases small : ∀ d ∈ dimensions.values, d.val < (2 : Int)^63 - 1
    · right
      apply Classical.byContradiction
      intro unbounded
      have bound : emptyHvncatMathematicalProduct dimensions.values ≤ (2 : Int)^63 - 1 := by omega
      obtain ⟨count, ok, _, _⟩ := g11hCheckedValid dimensions rank positive small bound
      rw [run] at ok
      cases ok
    · left
      apply Classical.byContradiction
      intro absent
      apply small
      intro d hd
      have notLarge : ¬ (2 : Int)^63 - 1 ≤ d.val := fun large => absent ⟨d, hd, large⟩
      omega

theorem g11hCheckedOkFlags (dimensions : MachineTuple I64) (count : I64)
    (rank : 2 ≤ dimensions.values.length)
    (run : emptyHvncatCheckedDimensions dimensions = .ok count) :
    emptyHvncatCheckedDimensionsFlags dimensions = (count, false) := by
  rw [g11hCheckedNontrivial dimensions rank] at run
  rcases flags : emptyHvncatCheckedDimensionsFlags dimensions with ⟨value, flag⟩
  cases flag with
  | false =>
      have equal : value = count := by
        simpa only [flags, Bool.false_eq_true, ↓reduceIte, Except.ok.injEq] using run
      exact Prod.ext equal rfl
  | true => simp only [flags, ↓reduceIte, reduceCtorEq] at run

theorem g11hArrayLengthFromChecked {Ty Ref : Type} (array : EmptyHvncatArray Ty Ref) (count : I64)
    (rank : 2 ≤ array.dimensions.values.length)
    (positive : ∀ d ∈ array.dimensions.values, 0 < d.val)
    (run : emptyHvncatCheckedDimensions array.dimensions = .ok count) :
    emptyHvncatArrayLength array = count := by
  have countEq := congrArg Prod.fst (g11hCheckedOkFlags array.dimensions count rank run)
  cases shape : array.dimensions.values with
  | nil => simp only [shape, List.length_nil] at rank; omega
  | cons first rest =>
      have nonempty : rest ≠ [] := by
        intro h; simp only [shape, h, List.length_cons, List.length_nil] at rank; omega
      rw [g11hFlagsUniform array.dimensions first rest shape nonempty positive] at countEq
      simp only [emptyHvncatArrayLength, shape]
      exact (g11hLoopProduct rest first (int 1) false
        (emptyHvncatInvalidDimension first) false).symm.trans countEq

theorem g11hOneDimensionRun {World Ty Ref : Type}
    (runtime : EmptyHvncatRuntime (EmptyHvncatTraceM World Ty Ref) Ty Ref)
    (elementType : Ty) (dimension : I64) (rowFirst : Bool)
    (state : World × List (EmptyHvncatEvent Ty Ref) × Option World) :
    (emptyHvncatOneDimension runtime elementType dimension rowFirst).run state =
      if dimension.val ≤ 0 then
        (.error (.julia (.argumentError "`dimsshape` argument must consist of positive integers")), state)
      else (.error (.julia (.argumentError
        ("number of elements does not match `dimshape` argument; expected " ++
          toString dimension.val ++ ", got 0"))), state) := by
  unfold emptyHvncatOneDimension typedHvncatOneDim
  simp only [emptyHvncatArguments, pure_bind]
  by_cases h : dimension.val ≤ 0
  · simp only [h, ↓reduceIte, ExceptT.bind_throw, g11hRunThrow]
  · have unequal : ((int 0).val != dimension.val) = true := by
      simp only [bne_iff_ne]
      change (0 : Int) ≠ dimension.val
      omega
    simp only [h, ↓reduceIte, unequal, ExceptT.bind_throw, g11hRunThrow,
      String.append_assoc,
      show (", got " ++ toString (int 0).val) = ", got 0" from by decide]


theorem g11hNativeOutcome {World Ty Ref : Type}
    (runtime : EmptyHvncatRuntime (EmptyHvncatPrimitive World) Ty Ref)
    (elementType : Ty) (rank : I64) (world : World) :
    let observed := (emptyHvncatVal (emptyHvncatObserveRuntime runtime) elementType rank).run
      (world, [], none)
    EmptyHvncatObservedOutcome (.nativeInt rank) elementType world observed.1 observed.2 := by
  by_cases isZero : rank.val = 0
  · have test : (rank.val == 0) = true := beq_iff_eq.mpr isZero
    simp only [emptyHvncatVal, test, ↓reduceIte, numericFromResult,
      typedHvncatZeroOnlyOne, g11hRunThrow, EmptyHvncatObservedOutcome,
      EmptyHvncatNoAllocationError]
    exact ⟨by constructor, by constructor, _, rfl, Or.inl ⟨isZero, rfl⟩⟩
  · have test : (rank.val == 0) = false := beq_eq_false_iff_ne.mpr isZero
    by_cases isNegative : rank.val < 0
    · have negative : decide (rank.val < 0) = true := decide_eq_true isNegative
      simp only [emptyHvncatVal, test, Bool.false_eq_true, ↓reduceIte,
        typedHvncatEmptyVal, pure_bind, negative, ExceptT.bind_throw,
        g11hRunThrow, EmptyHvncatObservedOutcome, EmptyHvncatNoAllocationError]
      exact ⟨by constructor, by constructor, _, rfl, Or.inr ⟨isNegative, rfl⟩⟩
    · have positive : 0 < rank.val := by omega
      let dimensions : MachineTuple I64 := ⟨List.replicate rank.val.toNat (int 0), rank, by
        simp only [List.length_replicate]
        omega⟩
      have zeros : emptyHvncatZeroDimensions rank = .ok dimensions := by
        simp only [emptyHvncatZeroDimensions, dif_neg isNegative]
        rfl
      obtain ⟨n, hn⟩ : ∃ n : Nat, rank.val.toNat = n + 1 := by
        have : 0 < rank.val.toNat := by omega
        exact ⟨rank.val.toNat - 1, by omega⟩
      have checked : emptyHvncatCheckedDimensions dimensions = .ok (int 0) :=
        g11hCheckedZero dimensions n (by simp only [dimensions, hn])
      have negative : decide (rank.val < 0) = false := decide_eq_false isNegative
      have mapped : dimensions.values.map (fun d => d.val) = List.replicate rank.val.toNat 0 := by
        simp only [dimensions, List.map_replicate]
        rfl
      simp only [emptyHvncatVal, test, Bool.false_eq_true, ↓reduceIte,
        typedHvncatEmptyVal, pure_bind, negative, zeros, numericFromResult,
        emptyHvncatAllocate, checked]
      rcases run : runtime.allocateRef elementType dimensions (int 0) world with ⟨reply, after⟩
      cases reply with
      | error error =>
          simp only [g11hRunBind, emptyHvncatObserveRuntime, ExceptT.run_mk, run,
            List.nil_append, EmptyHvncatObservedOutcome, EmptyHvncatAllocationOutcome]
          exact ⟨by constructor, by constructor, positive, rfl, rfl, mapped, by constructor⟩
      | ok reference =>
          simp only [g11hRunBind, emptyHvncatObserveRuntime, ExceptT.run_mk, run,
            List.nil_append, g11hRunPure, EmptyHvncatObservedOutcome,
            EmptyHvncatAllocationOutcome]
          exact ⟨by constructor, by constructor, positive, rfl, rfl, mapped,
            ⟨⟨elementType, reference, dimensions⟩, rfl, rfl, rfl, rfl, mapped⟩⟩


def g11hCountError (count : Int) : ArrayError :=
  .julia (.argumentError ("argument count does not match specified shape (expected " ++
    toString count ++ ", got 0)"))

theorem g11hNativeNonpositiveRun {World Ty Ref : Type}
    (runtime : EmptyHvncatRuntime (EmptyHvncatTraceM World Ty Ref) Ty Ref)
    (generated : Bool) (elementType : Ty) (dimensions : MachineTuple I64)
    (rowFirst : Bool) (state : World × List (EmptyHvncatEvent Ty Ref) × Option World)
    (guard : dimensions.values.all (fun d => decide (0 < d.val)) = false) :
    (emptyHvncatNativeDimensions runtime generated elementType dimensions rowFirst).run state =
      (.error (.julia (.argumentError "`dims` argument must contain positive integers")), state) := by
  simp only [emptyHvncatNativeDimensions, typedHvncatNumbersDims, guard, Bool.not_false,
    ↓reduceIte, ExceptT.bind_throw, g11hRunThrow]

theorem g11hNativeCheckErrorRun {World Ty Ref : Type}
    (runtime : EmptyHvncatRuntime (EmptyHvncatTraceM World Ty Ref) Ty Ref)
    (generated : Bool) (elementType : Ty) (dimensions : MachineTuple I64)
    (rowFirst : Bool) (state : World × List (EmptyHvncatEvent Ty Ref) × Option World)
    (guard : dimensions.values.all (fun d => decide (0 < d.val)) = true)
    (error : ArrayError) (checked : emptyHvncatCheckedDimensions dimensions = .error error) :
    (emptyHvncatNativeDimensions runtime generated elementType dimensions rowFirst).run state =
      (.error error, state) := by
  simp only [emptyHvncatNativeDimensions, typedHvncatNumbersDims, guard, Bool.not_true,
    Bool.false_eq_true, ↓reduceIte, pure_bind, emptyHvncatAllocate, checked,
    numericFromResult, ExceptT.bind_throw, g11hRunThrow]

theorem g11hNativeCheckOkRun {World Ty Ref : Type}
    (runtime : EmptyHvncatRuntime (EmptyHvncatPrimitive World) Ty Ref)
    (generated : Bool) (elementType : Ty) (dimensions : MachineTuple I64)
    (rowFirst : Bool) (world : World) (count : I64)
    (rank : 2 ≤ dimensions.values.length)
    (positive : ∀ d ∈ dimensions.values, 0 < d.val)
    (checked : emptyHvncatCheckedDimensions dimensions = .ok count) :
    (emptyHvncatNativeDimensions (emptyHvncatObserveRuntime runtime)
      generated elementType dimensions rowFirst).run (world, [], none) =
      let out := runtime.allocateRef elementType dimensions count world
      (match out.1 with
        | .error error => .error error
        | .ok _ => .error (g11hCountError count.val),
       (out.2, [.allocateRef elementType dimensions count out.1], some out.2)) := by
  have guard : dimensions.values.all (fun d => decide (0 < d.val)) = true := by
    simp only [List.all_eq_true, decide_eq_true_eq]
    exact positive
  have countPositive := (g11hCheckedSuccess dimensions count rank positive checked).2.2
  have nonzero : (count.val != (int 0).val) = true := by
    simp only [bne_iff_ne]
    change count.val ≠ 0
    omega
  have lengthCorrect (reference : Ref) :
      emptyHvncatArrayLength (⟨elementType, reference, dimensions⟩ : EmptyHvncatArray Ty Ref) = count :=
    g11hArrayLengthFromChecked _ count rank positive checked
  simp only [emptyHvncatNativeDimensions, typedHvncatNumbersDims, guard, Bool.not_true,
    Bool.false_eq_true, ↓reduceIte, pure_bind, emptyHvncatAllocate, checked,
    numericFromResult, g11hRunBind]
  rcases allocation : runtime.allocateRef elementType dimensions count world with ⟨reply, after⟩
  cases reply with
  | error error =>
      simp only [emptyHvncatObserveRuntime, ExceptT.run_mk, allocation, List.nil_append]
  | ok reference =>
      simp only [emptyHvncatObserveRuntime, ExceptT.run_mk, allocation, List.nil_append,
        g11hRunPure, lengthCorrect, emptyHvncatArguments, nonzero, ↓reduceIte,
        ExceptT.bind_throw, g11hRunThrow, g11hCountError, String.append_assoc,
        show (", got " ++ toString (int 0).val ++ ")") = ", got 0)" from by decide]


theorem g11hNoAllocationNative (fields : MachineTuple EmptyHvncatMember)
    (dimensions : List I64) (mapped : fields.values = dimensions.map EmptyHvncatMember.nativeInt)
    (rank : 2 ≤ dimensions.length) (error : ArrayError)
    (reason : ((∃ dimension ∈ dimensions, dimension.val ≤ 0) ∧
        error = .julia (.argumentError "`dims` argument must contain positive integers")) ∨
      ((∀ dimension ∈ dimensions, 0 < dimension.val) ∧
        ((∃ dimension ∈ dimensions, (2 : Int)^63 - 1 ≤ dimension.val) ∨
          (2 : Int)^63 - 1 < emptyHvncatMathematicalProduct dimensions) ∧
        error = .julia (.argumentError "invalid Array dimensions"))) :
    EmptyHvncatNoAllocationError (.tuple fields) error := by
  cases dimensions with
  | nil => simp only [List.length_nil] at rank; omega
  | cons first rest =>
      cases rest with
      | nil => simp only [List.length_cons, List.length_nil] at rank; omega
      | cons second rest =>
          simp only [EmptyHvncatNoAllocationError, mapped, List.map_cons]
          exact Or.inl ⟨first :: second :: rest, rfl, reason⟩

theorem g11hNativeDimensionsOutcome {World Ty Ref : Type}
    (runtime : EmptyHvncatRuntime (EmptyHvncatPrimitive World) Ty Ref)
    (generated : Bool) (elementType : Ty) (fields : MachineTuple EmptyHvncatMember)
    (dimensions : MachineTuple I64) (rowFirst : Bool) (world : World)
    (mapped : fields.values = dimensions.values.map EmptyHvncatMember.nativeInt)
    (rank : 2 ≤ dimensions.values.length) :
    let observed := (emptyHvncatNativeDimensions (emptyHvncatObserveRuntime runtime)
      generated elementType dimensions rowFirst).run (world, [], none)
    EmptyHvncatObservedOutcome (.tuple fields) elementType world observed.1 observed.2 ∧
      observed = (emptyHvncatNativeDimensions (emptyHvncatObserveRuntime runtime)
        generated elementType dimensions (!rowFirst)).run (world, [], none) := by
  dsimp only
  cases guard : dimensions.values.all (fun d => decide (0 < d.val)) with
  | false =>
      rw [g11hNativeNonpositiveRun _ _ _ _ rowFirst _ guard,
        g11hNativeNonpositiveRun _ _ _ _ (!rowFirst) _ guard]
      refine ⟨⟨rfl, rfl, _, rfl, ?_⟩, rfl⟩
      apply g11hNoAllocationNative fields dimensions.values mapped rank
      left
      refine ⟨?_, rfl⟩
      apply Classical.byContradiction
      intro noBad
      have allPositive : dimensions.values.all (fun d => decide (0 < d.val)) = true := by
        simp only [List.all_eq_true, decide_eq_true_eq]
        intro d hd
        have : ¬ d.val ≤ 0 := fun bad => noBad ⟨d, hd, bad⟩
        omega
      rw [guard] at allPositive
      cases allPositive
  | true =>
      have positive : ∀ d ∈ dimensions.values, 0 < d.val := by
        simpa only [List.all_eq_true, decide_eq_true_eq] using guard
      cases checked : emptyHvncatCheckedDimensions dimensions with
      | error error =>
          rw [g11hNativeCheckErrorRun _ _ _ _ rowFirst _ guard error checked,
            g11hNativeCheckErrorRun _ _ _ _ (!rowFirst) _ guard error checked]
          refine ⟨⟨rfl, rfl, error, rfl, ?_⟩, rfl⟩
          have bad := g11hCheckedError dimensions error rank positive checked
          exact g11hNoAllocationNative fields dimensions.values mapped rank error
            (Or.inr ⟨positive, bad.2, bad.1⟩)
      | ok count =>
          rw [g11hNativeCheckOkRun runtime generated elementType dimensions rowFirst world count rank positive checked,
            g11hNativeCheckOkRun runtime generated elementType dimensions (!rowFirst) world count rank positive checked]
          refine ⟨?_, rfl⟩
          obtain ⟨small, countEq, countPositive⟩ :=
            g11hCheckedSuccess dimensions count rank positive checked
          have productBound : emptyHvncatMathematicalProduct dimensions.values ≤ (2 : Int)^63 - 1 := by
            rw [← countEq]
            exact count.property.2
          have balanced : EmptyHvncatBalancedAllocation dimensions.values :=
            ⟨rank, fun d hd => ⟨positive d hd, small d hd⟩, productBound⟩
          rcases allocation : runtime.allocateRef elementType dimensions count world with ⟨reply, after⟩
          cases reply with
          | error error =>
              exact ⟨rfl, rfl, dimensions.values, mapped, balanced, rfl, countEq, countPositive, rfl⟩
          | ok reference =>
              refine ⟨rfl, rfl, dimensions.values, mapped, balanced, rfl, countEq, countPositive, ?_⟩
              unfold g11hCountError
              rw [countEq]

theorem g11hTupleGetHead {A : Type} (first : A) (rest : List A) :
    tupleGet (first :: rest) (int 1) = .ok first := by
  rfl

theorem g11hOneLevelRun {World Ty Ref : Type}
    (runtime : EmptyHvncatRuntime (EmptyHvncatTraceM World Ty Ref) Ty Ref)
    (elementType : Ty) (inner : MachineTuple EmptyHvncatInnerValue) (rowFirst : Bool)
    (state : World × List (EmptyHvncatEvent Ty Ref) × Option World) :
    (emptyHvncatOneLevel runtime elementType inner rowFirst).run state =
      match inner.values with
      | [] => (.error (.julia (.argumentError "each level of `shape` argument must have at least one value")), state)
      | .nativeInt dimension :: _ => (emptyHvncatOneDimension runtime elementType dimension rowFirst).run state
      | .other :: _ => (.error (.julia (.methodError "_typed_hvncat_1d")), state) := by
  unfold emptyHvncatOneLevel
  simp only [g11hTupleGetHead, numericFromResult, pure_bind]
  cases shape : inner.values with
  | nil =>
      have empty : inner.count.val ≤ 0 := by rw [inner.count_eq, shape]; decide
      simp only [empty, ↓reduceIte, ExceptT.bind_throw, g11hRunThrow]
  | cons first rest =>
      have nonempty : ¬ inner.count.val ≤ 0 := by
        rw [inner.count_eq, shape, List.length_cons]
        omega
      simp only [nonempty, ↓reduceIte, shape, g11hTupleGetHead, numericFromResult, pure_bind]
      cases first <;> rfl


theorem g11hNativeFieldsSound (fields : List EmptyHvncatMember) :
    ∀ native, emptyHvncatNativeFields fields = some native →
      fields = native.val.map EmptyHvncatMember.nativeInt := by
  induction fields with
  | nil =>
      intro native run
      change some ⟨[], rfl⟩ = some native at run
      cases Option.some.inj run
      rfl
  | cons first rest ih =>
      intro native run
      cases first with
      | nativeInt dimension =>
          cases tailRun : emptyHvncatNativeFields rest with
          | none =>
              simp only [emptyHvncatNativeFields, tailRun] at run
              cases run
          | some tail =>
              simp only [emptyHvncatNativeFields, tailRun] at run
              have eq : dimension :: tail.val = native.val :=
                congrArg Subtype.val (Option.some.inj run)
              rw [← eq, List.map_cons, ← ih tail tailRun]
      | tuple inner => cases run
      | other => cases run

theorem g11hNativeFieldsPresent (dimensions : List I64) :
    ∃ native, emptyHvncatNativeFields (dimensions.map EmptyHvncatMember.nativeInt) = some native := by
  induction dimensions with
  | nil => exact ⟨⟨[], rfl⟩, rfl⟩
  | cons first rest ih =>
      obtain ⟨tail, run⟩ := ih
      refine ⟨⟨first :: tail.val, ?_⟩, ?_⟩
      · simp only [List.length_cons, List.length_map, tail.property]
      · change (emptyHvncatNativeFields (rest.map EmptyHvncatMember.nativeInt)).bind
          (fun x => (some ⟨first :: x.val, by
            simp only [List.length_cons, List.length_map, x.property]⟩ :
              Option { ds : List I64 // ds.length = ((first :: rest).map EmptyHvncatMember.nativeInt).length })) = _
        rw [run]
        rfl

theorem g11hNativeFieldsAbsent (fields : List EmptyHvncatMember)
    (run : emptyHvncatNativeFields fields = none) :
    ¬ ∃ dimensions : List I64, fields = dimensions.map EmptyHvncatMember.nativeInt := by
  rintro ⟨dimensions, mapped⟩
  subst fields
  obtain ⟨native, present⟩ := g11hNativeFieldsPresent dimensions
  rw [run] at present
  cases present

theorem g11hAllTuples (fields : List EmptyHvncatMember) :
    (fields.all (fun field => match field with | .tuple _ => true | _ => false) = true) ↔
      ∀ field ∈ fields, ∃ inner, field = EmptyHvncatMember.tuple inner := by
  rw [List.all_eq_true]
  constructor
  · intro all field mem
    have h := all field mem
    cases field with
    | nativeInt dimension => cases h
    | other => cases h
    | tuple inner => exact ⟨inner, rfl⟩
  · intro all field mem
    obtain ⟨inner, rfl⟩ := all field mem
    rfl


theorem g11hPureError {World Ty Ref : Type} (input : EmptyHvncatDimensions)
    (elementType : Ty) (world : World) (error : ArrayError)
    (reason : EmptyHvncatNoAllocationError input error) :
    EmptyHvncatObservedOutcome (Ref := Ref) input elementType world (.error error) (world, [], none) :=
  ⟨rfl, rfl, error, rfl, reason⟩

theorem g11hTypedMultiple {m : Type → Type} [Monad m] [MonadExceptOf ArrayError m]
    {Ty Ref : Type} (runtime : EmptyHvncatRuntime m Ty Ref) (generated : Bool)
    (elementType : Ty) (fields : MachineTuple EmptyHvncatMember) (rowFirst : Bool)
    (rank : 2 ≤ fields.values.length) :
    emptyHvncatTyped runtime generated elementType (.tuple fields) rowFirst =
      match emptyHvncatNativeFields fields.values with
      | some native =>
          emptyHvncatNativeDimensions runtime generated elementType
            ⟨native.val, fields.count, by rw [native.property]; exact fields.count_eq⟩ rowFirst
      | none =>
          if fields.values.all (fun field => match field with | .tuple _ => true | _ => false)
          then emptyHvncatManyLevels
          else throw (.julia (.methodError "_typed_hvncat")) := by
  rcases fields with ⟨values, count, countEq⟩
  cases values with
  | nil => change 2 ≤ 0 at rank; omega
  | cons first rest =>
      cases rest with
      | nil => change 2 ≤ 1 at rank; omega
      | cons second rest => cases first <;> rfl


theorem g11hNoAllocationOtherFields (fields : MachineTuple EmptyHvncatMember)
    (rank : 2 ≤ fields.values.length) (error : ArrayError)
    (reason : ((∀ field ∈ fields.values, ∃ inner, field = EmptyHvncatMember.tuple inner) ∧
        error = .julia (.argumentError
          "reducing over an empty collection is not allowed; consider supplying `init` to the reducer")) ∨
      ((¬ ∃ dimensions : List I64, fields.values = dimensions.map EmptyHvncatMember.nativeInt) ∧
        (¬ ∀ field ∈ fields.values, ∃ inner, field = EmptyHvncatMember.tuple inner) ∧
        error = .julia (.methodError "_typed_hvncat"))) :
    EmptyHvncatNoAllocationError (.tuple fields) error := by
  cases shape : fields.values with
  | nil => simp only [shape, List.length_nil] at rank; omega
  | cons first rest =>
      cases rest with
      | nil => simp only [shape, List.length_cons, List.length_nil] at rank; omega
      | cons second rest =>
          simp only [EmptyHvncatNoAllocationError, shape]
          apply Or.inr
          simpa only [shape] using reason

theorem g11hMultipleOutcome {World Ty Ref : Type}
    (runtime : EmptyHvncatRuntime (EmptyHvncatPrimitive World) Ty Ref)
    (generated : Bool) (elementType : Ty) (fields : MachineTuple EmptyHvncatMember)
    (rowFirst : Bool) (world : World) (rank : 2 ≤ fields.values.length) :
    let observed := (emptyHvncatTyped (emptyHvncatObserveRuntime runtime)
      generated elementType (.tuple fields) rowFirst).run (world, [], none)
    EmptyHvncatObservedOutcome (.tuple fields) elementType world observed.1 observed.2 ∧
      observed = (emptyHvncatTyped (emptyHvncatObserveRuntime runtime)
        generated elementType (.tuple fields) (!rowFirst)).run (world, [], none) := by
  dsimp only
  rw [g11hTypedMultiple _ _ _ _ rowFirst rank, g11hTypedMultiple _ _ _ _ (!rowFirst) rank]
  cases extracted : emptyHvncatNativeFields fields.values with
  | some native =>
      have mapped := g11hNativeFieldsSound fields.values native extracted
      let dimensions : MachineTuple I64 := ⟨native.val, fields.count, by rw [native.property]; exact fields.count_eq⟩
      have dimensionsRank : 2 ≤ dimensions.values.length := by
        change 2 ≤ native.val.length
        rw [native.property]
        exact rank
      exact g11hNativeDimensionsOutcome runtime generated elementType fields dimensions rowFirst world mapped dimensionsRank
  | none =>
      cases allTuples : fields.values.all (fun field => match field with | .tuple _ => true | _ => false) with
      | false =>
          simp only [Bool.false_eq_true, ↓reduceIte, g11hRunThrow]
          refine ⟨g11hPureError _ _ _ _ ?_, by constructor⟩
          apply g11hNoAllocationOtherFields fields rank
          right
          refine ⟨g11hNativeFieldsAbsent fields.values extracted, ?_, rfl⟩
          intro all
          have contradiction := (g11hAllTuples fields.values).mpr all
          rw [allTuples] at contradiction
          cases contradiction
      | true =>
          simp only [↓reduceIte, emptyHvncatManyLevels, emptyHvncatMaximum,
            numericFromResult, ExceptT.bind_throw, g11hRunThrow]
          refine ⟨g11hPureError _ _ _ _ ?_, by constructor⟩
          exact g11hNoAllocationOtherFields fields rank _
            (Or.inl ⟨(g11hAllTuples fields.values).mp allTuples, rfl⟩)


theorem g11hOneDimensionObservation {World Ty Ref : Type}
    (runtime : EmptyHvncatRuntime (EmptyHvncatTraceM World Ty Ref) Ty Ref)
    (input : EmptyHvncatDimensions) (elementType : Ty) (dimension : I64)
    (rowFirst : Bool) (world : World)
    (reason : ∀ error, EmptyHvncatOneDimensionError dimension error →
      EmptyHvncatNoAllocationError input error) :
    let observed := (emptyHvncatOneDimension runtime elementType dimension rowFirst).run (world, [], none)
    EmptyHvncatObservedOutcome input elementType world observed.1 observed.2 := by
  dsimp only
  rw [g11hOneDimensionRun]
  by_cases nonpositive : dimension.val ≤ 0
  · rw [if_pos nonpositive]
    exact g11hPureError _ _ _ _ (reason _ (Or.inl ⟨nonpositive, rfl⟩))
  · rw [if_neg nonpositive]
    exact g11hPureError _ _ _ _ (reason _ (Or.inr ⟨by omega, rfl⟩))

theorem g11hOneLevelOutcome {World Ty Ref : Type}
    (runtime : EmptyHvncatRuntime (EmptyHvncatPrimitive World) Ty Ref)
    (generated : Bool) (elementType : Ty) (fields : MachineTuple EmptyHvncatMember)
    (inner : MachineTuple EmptyHvncatInnerValue) (rowFirst : Bool) (world : World)
    (shape : fields.values = [.tuple inner]) :
    let observed := (emptyHvncatTyped (emptyHvncatObserveRuntime runtime)
      generated elementType (.tuple fields) rowFirst).run (world, [], none)
    EmptyHvncatObservedOutcome (.tuple fields) elementType world observed.1 observed.2 ∧
      observed = (emptyHvncatTyped (emptyHvncatObserveRuntime runtime)
        generated elementType (.tuple fields) (!rowFirst)).run (world, [], none) := by
  dsimp only
  simp only [emptyHvncatTyped, shape, g11hOneLevelRun]
  cases innerShape : inner.values with
  | nil =>
      refine ⟨g11hPureError _ _ _ _ ?_, by constructor⟩
      simp only [EmptyHvncatNoAllocationError, shape, innerShape]
  | cons first rest =>
      cases first with
      | other =>
          refine ⟨g11hPureError _ _ _ _ ?_, by constructor⟩
          simp only [EmptyHvncatNoAllocationError, shape, innerShape]
      | nativeInt dimension =>
          constructor
          · apply g11hOneDimensionObservation
            intro error reason
            simpa only [EmptyHvncatNoAllocationError, shape, innerShape] using reason
          · dsimp only
            rw [g11hOneDimensionRun, g11hOneDimensionRun]

theorem Models1G3EmptyHvncatAllocationErrors_proven :
    JuliaLean.Proofs.base.abstractarray.Models1Group3.EmptyHvncatAllocationAndErrors := by
  intro World Ty Ref runtime generated elementType input rowFirst world
  dsimp only [emptyHvncat, hvncatEmpty]
  cases input with
  | nativeInt rank =>
      exact ⟨g11hNativeOutcome runtime elementType rank world, rfl⟩
  | tuple fields =>
      cases shape : fields.values with
      | nil =>
          have run (row : Bool) :
              (emptyHvncatTyped (emptyHvncatObserveRuntime runtime) generated elementType (.tuple fields) row).run (world, [], none) =
                (.error (.julia (.argumentError "a 0-dimensional array may only contain exactly one element")), (world, [], none)) := by
            simp only [emptyHvncatTyped, shape, typedHvncatEmptyShapeNumbers,
              emptyHvncatVal, show ((int 0).val == 0) = true from rfl, ↓reduceIte,
              typedHvncatZeroOnlyOne, numericFromResult, g11hRunThrow]
            rfl
          rw [run rowFirst, run (!rowFirst)]
          refine ⟨g11hPureError _ _ _ _ ?_, by constructor⟩
          simp only [EmptyHvncatNoAllocationError, shape]
      | cons first rest =>
          cases rest with
          | cons second rest =>
              exact g11hMultipleOutcome runtime generated elementType fields rowFirst world
                (by simp only [shape, List.length_cons]; omega)
          | nil =>
              cases first with
              | tuple inner =>
                  exact g11hOneLevelOutcome runtime generated elementType fields inner rowFirst world shape
              | nativeInt dimension =>
                  simp only [emptyHvncatTyped, shape, typedHvncatOneShapeNumbers,
                    g11hTupleGetHead, numericFromResult, pure_bind]
                  refine ⟨?_, by constructor⟩
                  apply g11hOneDimensionObservation
                  intro error reason
                  simpa only [EmptyHvncatNoAllocationError, shape] using reason
              | other =>
                  have extracted : emptyHvncatNativeFields fields.values = none := by rw [shape]; rfl
                  have absent : ¬ ∃ dimensions : List I64,
                      fields.values = dimensions.map EmptyHvncatMember.nativeInt :=
                    g11hNativeFieldsAbsent fields.values (by rw [shape]; rfl)
                  have notTuples : ¬ ∀ field ∈ fields.values, ∃ inner, field = EmptyHvncatMember.tuple inner := by
                    intro all
                    obtain ⟨inner, impossible⟩ := all .other (by rw [shape]; exact List.mem_cons_self)
                    cases impossible
                  simp only [emptyHvncatTyped, shape, extracted, emptyHvncatNativeFields, List.all_cons,
                    Bool.false_and, Bool.false_eq_true, ↓reduceIte, g11hRunThrow]
                  refine ⟨g11hPureError _ _ _ _ ?_, by constructor⟩
                  simp only [EmptyHvncatNoAllocationError, shape]
                  rw [shape] at absent notTuples
                  exact Or.inr (Or.inr ⟨absent, notTuples, by constructor⟩)


