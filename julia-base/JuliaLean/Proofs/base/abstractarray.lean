theorem worldRunBind {Error World A B : Type}
    (action : WorldM Error World A) (next : A → WorldM Error World B) (before : World) :
    (action >>= next).run.run before =
      match action.run.run before with
      | none => none
      | some (.error error, after) => some (.error error, after)
      | some (.ok value, after) => (next value).run.run after := by
  change (action.run.run before).bind
    (fun observation => ExceptT.bindCont next observation.1 observation.2) = _
  cases observed : action.run.run before with
  | none => rfl
  | some observation =>
    rcases observation with ⟨result, after⟩
    cases result <;> rfl

theorem returnsOriginalBind {Error World A B : Type} (original : A)
    (action : WorldM Error World B) (next : B → WorldM Error World A)
    (h : ∀ value, ReturnsOriginal original (next value)) :
    ReturnsOriginal original (action >>= next) := by
  intro before
  rw [worldRunBind]
  cases observed : action.run.run before with
  | none => trivial
  | some observation =>
    rcases observation with ⟨result, after⟩
    cases result with
    | error error => trivial
    | ok value => exact h value after

theorem worldBindFailure {Error World A B : Type}
    (action : WorldM Error World A) (next : A → WorldM Error World B)
    (before after : World) (error : Error)
    (h : action.run.run before = some (.error error, after)) :
    (action >>= next).run.run before = some (.error error, after) := by
  rw [worldRunBind, h]

