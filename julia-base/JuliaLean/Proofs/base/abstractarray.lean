/-! ## map! over several arrays: map_n! and map!(f, dest, As...) -/

/-- The foreign checked scalar `getindex` of a read-only source vector. -/
def offsetVectorRead {E : Type} (a : OffsetVector E) (i : I64) : Result E :=
  if a.first.val ≤ i.val then
    match a.values[(i.val - a.first.val).toNat]? with
    | some x => .ok x
    | none => .error (.julia .boundsError)
  else .error (.julia .boundsError)

/-- Source `eachindex(A)` for an `IndexLinear` vector, through `IndexStyle`,
`eachindex(::IndexLinear, A::AbstractVector)` and `axes1`, as the iterated range. -/
def sourceVectorEachindex {E : Type} (a : OffsetVector E) : Result (List I64) :=
  (eachindexArray (fun _ : OffsetVector E => (pure () : Result Unit))
    (fun _ a => eachindexLinearVector
      (axes1 (fun a : OffsetVector E => pure [offsetVectorAxis a])) a) a).map
    fun r => concatRange r.1 r.2

/-- The linear indices of a vector, in order (the foreign `LinearIndices`). -/
def vectorIndices {E : Type} (a : OffsetVector E) : List I64 :=
  concatRange (offsetVectorAxis a).1 (offsetVectorAxis a).2

/-- The foreign `zip` of index iterators stops at the shortest one. -/
def lockstep (d : List I64) (ss : List (List I64)) : List (I64 × List I64) :=
  (List.range (ss.foldl (fun m s => min m s.length) d.length)).map
    fun k => (d.getD k (int 0), ss.map fun s => s.getD k (int 0))

/-- `map!` over `As` with the source `map_n!`, `ith_all` and `eachindex`; the
foreign `LinearIndices ==` is any sound comparison. -/
def sourceMapN {In Out : Type} (equal : List I64 → List I64 → Bool) (f : List In → Out)
    (as : List (OffsetVector In)) : VectorRun Out Unit :=
  mapNInplace (fun _ => fun v => .ok (vectorIndices v, v))
    (fun a => pure (vectorIndices a)) (fun l k => pure (equal l k))
    (fun p as => as.allM p)
    (fun i as => sourceIthAll (fun a i => StateT.lift (offsetVectorRead a i)) i as)
    offsetVectorSet
    (fun _ => fun v => (sourceVectorEachindex v).map (·, v))
    (fun a => StateT.lift (sourceVectorEachindex a))
    (fun g as => as.mapM g) (fun d ss => pure (lockstep d ss))
    (fun as j => StateT.lift (tupleGet as j)) (fun is j => StateT.lift (tupleGet is j))
    (fun a j => StateT.lift (offsetVectorRead a j))
    (fun g n => (List.range n).mapM fun (t : Nat) => g (int ((t : Int) + 1)))
    offsetVectorSet (fun args => pure (f args)) () as

def sourceMapMany {In Out : Type} (equal : List I64 → List I64 → Bool) (f : List In → Out)
    (as : List (OffsetVector In)) : VectorRun Out Unit :=
  mapInplaceMany (fun _ _ as => sourceMapN equal f as) (fun args => pure (f args)) () as

/-- The common length of the destination and every source. -/
def minLength {E : Type} (n : Nat) (srcs : List (List E)) : Nat :=
  srcs.foldl (fun m s => min m s.length) n

/-- Positions present in the destination and every source get `f` of the sources'
elements at that position; the rest of the destination is unchanged. -/
def mapNValues {In Out : Type} (f : List In → Out) (dest : List Out)
    (srcs : List (List In)) : List Out :=
  (List.range (minLength dest.length srcs)).map (fun k => f (srcs.filterMap (·[k]?))) ++
    dest.drop (minLength dest.length srcs)

/-- A vector whose linear indices and last index are native Ints. -/
def OffsetVector.Valid {E : Type} (v : OffsetVector E) : Prop :=
  v.Room 1 ∧ -9223372036854775808 ≤ v.first.val + v.values.length - 1

/-- `map_n!(f, dest, As)` and `map!(f, dest, As...)` store `f` of the k-th elements of
the sources in position k of `dest` for every k that `dest` and all sources have and
leave the rest unchanged, whether or not the sources' linear indices equal the
destination's, for any first indices; `map!` with no source arrays is rejected by
its assertion. -/
def MapNStoresElementwise : Prop :=
  ∀ (In Out : Type) (equal : List I64 → List I64 → Bool),
    (∀ l k, equal l k = true → l = k) →
    ∀ (f : List In → Out) (dest : OffsetVector Out) (as : List (OffsetVector In)),
      dest.Valid → (∀ a ∈ as, a.Valid) → (as.length : Int) ≤ 9223372036854775807 →
      (sourceMapN equal f as).run dest =
          .ok ((), { dest with values := mapNValues f dest.values (as.map (·.values)) }) ∧
      (sourceMapMany equal f as).run dest =
        (if as.isEmpty then .error (.assertionError "should dispatch to map!(f, A)")
        else .ok ((), { dest with values := mapNValues f dest.values (as.map (·.values)) }))

theorem vectorIndices_eq {E : Type} (a : OffsetVector E) (valid : a.Valid) :
    vectorIndices a = (List.range a.values.length).map fun (k : Nat) => int (a.first.val + k) := by
  obtain ⟨⟨lenFits, lastFits⟩, lastLow⟩ := valid
  have firstRange := a.first.property
  simp [IntTy.min, IntTy.max, IntTy.signed, IntTy.bits] at firstRange
  have lastValue : (int (a.first.val + a.values.length - 1)).val =
      a.first.val + a.values.length - 1 := native_val_int _ lastLow (by omega)
  unfold vectorIndices
  rw [offsetVectorAxis_eq a]
  unfold concatRange
  rw [lastValue, show a.first.val + (a.values.length : Int) - 1 - a.first.val + 1 =
    (a.values.length : Int) by omega, Int.toNat_natCast]

theorem sourceVectorEachindex_eq {E : Type} (a : OffsetVector E) :
    sourceVectorEachindex a = .ok (vectorIndices a) := by
  have one : (int 1).val = 1 := rfl
  simp [sourceVectorEachindex, eachindexArray, eachindexLinearVector, axes1, tupleGet, one,
    vectorIndices, Except.map]

theorem offsetVectorRead_at {E : Type} (a : OffsetVector E) (valid : a.Valid) (k : Nat)
    (small : k < a.values.length) :
    offsetVectorRead a (int (a.first.val + k)) = .ok a.values[k] := by
  obtain ⟨⟨lenFits, lastFits⟩, lastLow⟩ := valid
  have firstRange := a.first.property
  simp [IntTy.min, IntTy.max, IntTy.signed, IntTy.bits] at firstRange
  have value : (int (a.first.val + k)).val = a.first.val + k :=
    native_val_int _ (by omega) (by omega)
  have le : a.first.val ≤ (int (a.first.val + k)).val := by rw [value]; omega
  have pos : ((int (a.first.val + k)).val - a.first.val).toNat = k := by rw [value]; omega
  simp only [offsetVectorRead, le, ↓reduceIte, pos, List.getElem?_eq_getElem small]

theorem minLength_le_start {E : Type} : ∀ (n : Nat) (srcs : List (List E)),
    minLength n srcs ≤ n
  | n, [] => Nat.le_refl n
  | n, s :: ss => by
    have := minLength_le_start (min n s.length) ss
    simp only [minLength, List.foldl_cons] at this ⊢
    omega

theorem minLength_le {E : Type} : ∀ (n : Nat) (srcs : List (List E)) (s : List E),
    s ∈ srcs → minLength n srcs ≤ s.length
  | _, [], _, h => by simp at h
  | n, t :: ts, s, h => by
    simp only [minLength, List.foldl_cons]
    rcases List.mem_cons.mp h with rfl | h
    · have := minLength_le_start (min n s.length) ts
      simp only [minLength] at this
      omega
    · exact minLength_le (min n t.length) ts s h

theorem minLength_all {E : Type} : ∀ (n : Nat) (srcs : List (List E)),
    (∀ s ∈ srcs, s.length = n) → minLength n srcs = n
  | n, [], _ => rfl
  | n, s :: ss, h => by
    simp only [minLength, List.foldl_cons]
    rw [h s (by simp), Nat.min_self]
    exact minLength_all n ss (fun t ht => h t (by simp [ht]))

theorem filterMap_at {In : Type} (as : List (OffsetVector In)) (k : Nat)
    (small : ∀ a ∈ as, k < a.values.length) :
    (as.map (·.values)).filterMap (·[k]?) =
      as.attach.map fun a => a.1.values[k]'(small a.1 a.2) := by
  induction as with
  | nil => rfl
  | cons a as ih =>
    simp only [List.map_cons, List.filterMap_cons, List.attach_cons,
      List.getElem?_eq_getElem (small a (by simp))]
    rw [ih (fun b hb => small b (by simp [hb]))]
    simp [List.map_map]

theorem getD_range_map {α : Type} (n k : Nat) (g : Nat → α) (d : α) (small : k < n) :
    ((List.range n).map g).getD k d = g k := by
  simp [List.getD_eq_getElem?_getD, small]

theorem tupleGet_succ {α : Type} (xs : List α) (t : Nat) (small : t < xs.length)
    (fits : (xs.length : Int) ≤ 9223372036854775807) :
    tupleGet xs (int ((t : Int) + 1)) = .ok xs[t] := by
  have value : (int ((t : Int) + 1)).val = t + 1 := native_val_int _ (by omega) (by omega)
  have positive : ¬ ((t : Int) + 1 < 1) := by omega
  have offset : ((t : Int) + 1).toNat - 1 = t := by omega
  simp [tupleGet, value, positive, offset, List.getElem?_eq_getElem small]

/-- Loop state of `map_n!` after `p` positions. -/
def mapNTarget {In Out : Type} (f : List In → Out) (dest : OffsetVector Out)
    (as : List (OffsetVector In)) (p : Nat) : PUnit × OffsetVector Out :=
  (PUnit.unit, { dest with values := (List.range p).map (fun k =>
    f ((as.map (·.values)).filterMap (·[k]?))) ++ dest.values.drop p })

theorem mapNTarget_zero {In Out : Type} (f : List In → Out) (dest : OffsetVector Out)
    (as : List (OffsetVector In)) : mapNTarget f dest as 0 = (PUnit.unit, dest) := by
  simp [mapNTarget]

theorem mapNTarget_write {In Out : Type} (f : List In → Out) (dest : OffsetVector Out)
    (valid : dest.Valid) (as : List (OffsetVector In)) (p : Nat)
    (small : p < dest.values.length) :
