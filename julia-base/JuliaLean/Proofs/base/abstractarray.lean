def VcatFillRangeAgreement (position length : I64) (range : NativeIntUnitRange) : Prop :=
  let rawEnd := int (position.val + length.val - 1)
  range.start = position ∧
    range.stop = (if position.val ≤ rawEnd.val then rawEnd else int (position.val - 1))

