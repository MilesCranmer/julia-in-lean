/-- Counted array copying (`copyto!(dest, dstart, src, sstart, n)`) returns
without writing when `n == 0`, raises `ArgumentError` for a negative count, and
raises `BoundsError` when the destination or source start is outside its linear
axis or fewer than `n` positions remain after it (native extent arithmetic, as
in the source), before any element is read or written. -/
def CountedArrayCopyEarlyExits : Prop :=
  ∀ (E : Type) (destIndices srcIndices : CopyLinearIndices)
    (read : List E → I64 → E)
    (destinationId : JInt .u64) (sourcePointer : List E → JInt .u64)
    (copy : List E → StateT (List (Sum I64 Unit × E)) Result (List E))
    (dstart sstart n : I64) (values : List E) (log : List (Sum I64 Unit × E)),
    let run := (countedArrayCopyTrace destIndices srcIndices read destinationId
      sourcePointer copy dstart sstart n values).run log
    (n.val = 0 → run = .ok ((), log)) ∧
    (n.val < 0 → run = .error (.julia (.argumentError "n should be non-negative"))) ∧
    (0 < n.val →
      ¬ (destIndices.first.val ≤ dstart.val ∧ dstart.val ≤ destIndices.last.val ∧
        n.val ≤ (destIndices.last - dstart + int 1).val) →
      run = .error (.julia .boundsError)) ∧
    (0 < n.val →
      destIndices.first.val ≤ dstart.val → dstart.val ≤ destIndices.last.val →
      n.val ≤ (destIndices.last - dstart + int 1).val →
      ¬ (srcIndices.first.val ≤ sstart.val ∧ sstart.val ≤ srcIndices.last.val ∧
        n.val ≤ (srcIndices.last - sstart + int 1).val) →
      run = .error (.julia .boundsError))

