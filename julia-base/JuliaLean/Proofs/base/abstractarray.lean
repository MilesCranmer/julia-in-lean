    (filled : I64 → I64 → Result V) (zeros ones : I64 → Result V)
    (get : V → I64 → Result I64) (set : V → I64 → I64 → Result Unit)
    (checkedAdd : I64 → I64 → Result I64) (abs : I64 → Result I64)
    (ntuple : (I64 → Result I64) → Nat → Result (List I64))
    (checkedDims : List I64 → Result I64) (anyZero : V → Result Bool)
    (similar : X → Ty → List I64 → Result A)
    (fill : A → V → V → I64 → I64 → List X → Result Unit)
    (t : Ty) (shape : List (List I64)) (rowFirst : Bool) (as : List X),
    let run := typedHvncatShape collect last getShape getDim range tupleIndices tupleGet catNdims
      catSize catLength filled zeros ones get set checkedAdd abs ntuple checkedDims anyZero
