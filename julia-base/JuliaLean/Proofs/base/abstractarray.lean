        v.values.drop (maskKept v.values mask.values).length } : OffsetVector E)
    simp only [StateT.run, stateLen] at last
    rw [vrun_bind last, vrun_pure_bind]
    have lowValue : (int (v.first.val + (maskKept v.values mask.values).length)).val =
        v.first.val + (maskKept v.values mask.values).length :=
      native_val_int _ (by omega) (by omega)
    simp only [offsetVectorDeleteRange, lowValue, lastValue, stateLen]
    by_cases full : (maskKept v.values mask.values).length = v.values.length
    · have skip : v.first.val + v.values.length - 1 <
          v.first.val + (maskKept v.values mask.values).length := by omega
      have empty : v.values.drop (maskKept v.values mask.values).length = [] := by
