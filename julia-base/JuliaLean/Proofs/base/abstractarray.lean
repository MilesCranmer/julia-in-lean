      rcases hHead : (operation input).run world with ⟨headOutcome, world1⟩
      cases headOutcome with
      | error error =>
          refine ⟨.error error, world1, [⟨world, world1, event input (.error error)⟩],
            ?_, ⟨rfl, rfl⟩, [], input, inputs, [], rfl, rfl, rfl⟩
          simp only [List.mapM_cons, g1_run_bind, g1_run_record, hHead]
      | ok value =>
          let step : InterfaceStep World E := ⟨world, world1, event input (.ok value)⟩
          rcases ih world1 (priorLog ++ [step]) with
            ⟨tailOutcome, after, trace, hTail, continuity, outcomeLaw⟩
