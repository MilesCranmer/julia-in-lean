def g11thLinearExpected {Ty Ref E : Type} (a : NativeMatrix Ty Ref) (xs : MachineTuple E) :
    List (G11THStore E) :=
  xs.values.zipIdx.map fun (value, position) =>
    .linear (int (((position / a.columns.val.toNat : Nat) : Int) + 1 +
      ((position % a.columns.val.toNat : Nat) : Int) * a.rows.val)) value

def g11thCartesianExpected {Ty Ref E : Type} (a : NativeMatrix Ty Ref) (xs : MachineTuple E) :
    List (G11THStore E) :=
  xs.values.zipIdx.map fun (value, position) =>
    .cartesian (int (((position / a.columns.val.toNat : Nat) : Int) + 1))
      (int (((position % a.columns.val.toNat : Nat) : Int) + 1)) value

theorem g11thIntValue (value : Int) (nonnegative : 0 ≤ value)
    (bounded : value ≤ (2 : Int)^63 - 1) : (int value).val = value := by
  change wrapInt .i64 value = value
  apply wrapInt_of_inRange
  change -9223372036854775808 ≤ value ∧ value ≤ 9223372036854775807
  constructor <;> omega

theorem g11thPositionBounds {Ty Ref E : Type} (a : NativeMatrix Ty Ref) (xs : MachineTuple E)
    (valid : HvcatDimensionsValid a.rows.val a.columns.val)
    (count : (xs.values.length : Int) = a.rows.val * a.columns.val)
    (p : Nat) (position : p < xs.values.length) :
    let row : Int := (p / a.columns.val.toNat : Nat)
    let column : Int := (p % a.columns.val.toNat : Nat)
    1 ≤ row + 1 ∧ row + 1 ≤ a.rows.val ∧
      1 ≤ column + 1 ∧ column + 1 ≤ a.columns.val ∧
      1 ≤ row + 1 + column * a.rows.val ∧
      row + 1 + column * a.rows.val ≤ a.rows.val * a.columns.val := by
  obtain ⟨rowsNonnegative, rowsMax, columnsNonnegative, columnsMax, productMax⟩ := valid
  have rowsEq : (a.rows.val.toNat : Int) = a.rows.val := Int.toNat_of_nonneg rowsNonnegative
  have columnsEq : (a.columns.val.toNat : Int) = a.columns.val := Int.toNat_of_nonneg columnsNonnegative
  have lengthEq : xs.values.length = a.rows.val.toNat * a.columns.val.toNat := by
    apply Int.ofNat_inj.mp
    rw [Int.natCast_mul, rowsEq, columnsEq]
    exact count
  have pbound : p < a.rows.val.toNat * a.columns.val.toNat := by rw [← lengthEq]; exact position
  have columnsPositive : 0 < a.columns.val.toNat := by
    by_cases zero : a.columns.val.toNat = 0
    · rw [zero, Nat.mul_zero] at pbound
      omega
    · omega
  have rowBound := (Nat.div_lt_iff_lt_mul columnsPositive).mpr pbound
  have columnBound := Nat.mod_lt p columnsPositive
  have rowUpper : ((p / a.columns.val.toNat : Nat) : Int) + 1 ≤ a.rows.val := by omega
  have columnUpper : ((p % a.columns.val.toNat : Nat) : Int) + 1 ≤ a.columns.val := by omega
  have multiplied := Int.mul_le_mul_of_nonneg_right columnUpper rowsNonnegative
  rw [Int.add_mul, Int.one_mul, Int.mul_comm a.columns.val a.rows.val] at multiplied
  have rowNonnegative := Int.natCast_nonneg (p / a.columns.val.toNat)
  have productNonnegative := Int.mul_nonneg (Int.natCast_nonneg (p % a.columns.val.toNat)) rowsNonnegative
  exact ⟨by omega, rowUpper, by omega, columnUpper, by omega, by omega⟩

theorem g11thZipPosition {E : Type} (xs : MachineTuple E) (value : E) (p : Nat)
    (member : (value, p) ∈ xs.values.zipIdx) : p < xs.values.length := by
  obtain ⟨i, bound, equal⟩ := List.mem_iff_getElem.mp member
  simp only [List.getElem_zipIdx, Nat.zero_add, Prod.mk.injEq] at equal
  have : i = p := equal.2
  subst p
  simpa only [List.length_zipIdx] using bound

theorem g11thLinearExpectedBounds {Ty Ref E : Type} (a : NativeMatrix Ty Ref) (xs : MachineTuple E)
    (valid : HvcatDimensionsValid a.rows.val a.columns.val)
    (count : (xs.values.length : Int) = a.rows.val * a.columns.val) :
    ∀ request ∈ g11thLinearExpected a xs, G11THBound a request := by
  intro request member
  obtain ⟨⟨value, p⟩, zipped, rfl⟩ := List.mem_map.mp member
  have bounds := g11thPositionBounds a xs valid count p (g11thZipPosition xs value p zipped)
  change 1 ≤ (int _).val ∧ (int _).val ≤ _
  rw [g11thIntValue _ (by omega) (by have h := valid.2.2.2.2; omega)]
  exact ⟨bounds.2.2.2.2.1, bounds.2.2.2.2.2⟩

theorem g11thCartesianExpectedBounds {Ty Ref E : Type} (a : NativeMatrix Ty Ref) (xs : MachineTuple E)
    (valid : HvcatDimensionsValid a.rows.val a.columns.val)
    (count : (xs.values.length : Int) = a.rows.val * a.columns.val) :
    ∀ request ∈ g11thCartesianExpected a xs, G11THBound a request := by
  intro request member
  obtain ⟨⟨value, p⟩, zipped, rfl⟩ := List.mem_map.mp member
  have bounds := g11thPositionBounds a xs valid count p (g11thZipPosition xs value p zipped)
  change 1 ≤ (int _).val ∧ (int _).val ≤ a.rows.val ∧
    1 ≤ (int _).val ∧ (int _).val ≤ a.columns.val
  have rowValue := g11thIntValue (((p / a.columns.val.toNat : Nat) : Int) + 1)
    (by omega) (by have h := valid.2.1; omega)
  have columnValue := g11thIntValue (((p % a.columns.val.toNat : Nat) : Int) + 1)
    (by omega) (by have h := valid.2.2.2.1; omega)
  rw [rowValue, columnValue]
  exact ⟨bounds.1, bounds.2.1, bounds.2.2.1, bounds.2.2.2.1⟩

theorem g11thLinearExpectedPlacements {Ty Ref E : Type} (a : NativeMatrix Ty Ref) (xs : MachineTuple E)
    (valid : HvcatDimensionsValid a.rows.val a.columns.val)
    (count : (xs.values.length : Int) = a.rows.val * a.columns.val) :
    (g11thLinearExpected a xs).map (g11thPlacement a) = typedHvcatExpectedPlacements a xs := by
  unfold g11thLinearExpected typedHvcatExpectedPlacements
  rw [List.map_map]
  apply List.map_congr_left
  intro item member
  rcases item with ⟨value, p⟩
  have bounds := g11thPositionBounds a xs valid count p (g11thZipPosition xs value p member)
  simp only [Function.comp_def, g11thPlacement]
  rw [g11thIntValue _ (by omega) (by have h := valid.2.2.2.2; omega)]

theorem g11thCartesianExpectedPlacements {Ty Ref E : Type} (a : NativeMatrix Ty Ref) (xs : MachineTuple E)
    (valid : HvcatDimensionsValid a.rows.val a.columns.val)
    (count : (xs.values.length : Int) = a.rows.val * a.columns.val) :
    (g11thCartesianExpected a xs).map (g11thPlacement a) = typedHvcatExpectedPlacements a xs := by
  unfold g11thCartesianExpected typedHvcatExpectedPlacements
  rw [List.map_map]
  apply List.map_congr_left
  intro item member
  rcases item with ⟨value, p⟩
  have bounds := g11thPositionBounds a xs valid count p (g11thZipPosition xs value p member)
  simp only [Function.comp_def, g11thPlacement]
  rw [g11thIntValue _ (by omega) (by have h := valid.2.1; omega),
    g11thIntValue _ (by omega) (by have h := valid.2.2.2.1; omega)]
  simp only [Int.add_sub_cancel]


