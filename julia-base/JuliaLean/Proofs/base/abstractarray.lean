    Nat → (List I × List I) → Result (List E)
  | 0, _ => pure []
  | fuel + 1, state => do
    match ← sourceCartesianNext read a state with
    | none => pure []
    | some (value, next) =>
      return value :: (← collectCartesianSteps read a fuel next)

