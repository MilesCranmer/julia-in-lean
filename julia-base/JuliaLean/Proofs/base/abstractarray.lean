open JuliaLean JuliaLean.base.abstractarray
open JuliaLean.base.abstractarray.Models1Group2
open JuliaLean.Proofs.base.abstractarray.Models1Group2

theorem g2OneDecompose {X : Type} (xs : List X) (last target : X)
    (before after : List X) (h : xs ++ [last] = before ++ target :: after) :
    (∃ tail, xs = before ++ target :: tail ∧ after = tail ++ [last]) ∨
    (before = xs ∧ target = last ∧ after = []) := by
  induction xs generalizing before with
  | nil =>
      cases before with
      | nil =>
          simp only [List.nil_append, List.cons.injEq] at h
          exact Or.inr ⟨rfl, h.1.symm, h.2.symm⟩
      | cons b bs =>
          have lengths := congrArg List.length h
          simp only [List.length_append, List.length_cons, List.length_nil] at lengths
          omega
  | cons x xs ih =>
      cases before with
      | nil =>
          simp only [List.nil_append, List.cons_append, List.cons.injEq] at h
          exact Or.inl ⟨xs, by simp only [List.nil_append, h.1], h.2.symm⟩
      | cons b bs =>
          simp only [List.cons_append, List.cons.injEq] at h
          rcases h with ⟨rfl, h⟩
          rcases ih bs h with ⟨tail, old, suffix⟩ | ⟨frontEq, equal, empty⟩
          · exact Or.inl ⟨tail, by simp only [List.cons_append, old], suffix⟩
          · exact Or.inr ⟨by simp only [frontEq], equal, empty⟩

def g2OneActive {B E I : Type} (events : List (OneEvent B E I)) : Prop :=
  (∀ before after, events = before ++ .allocationRequested :: after →
    ∃ value, OneEvent.zeroValue value ∈ before) ∧
  (∀ before after handle row column value,
    events = before ++ .write handle row column value :: after →
    row = column ∧ OneEvent.unitValue value ∈ before ∧
      OneEvent.allocated handle ∈ before ∧
      ∃ zeroValue, OneEvent.fill handle zeroValue ∈ before) ∧
  OneEvent.wrongZero ∉ events ∧
  ∀ error, OneEvent.failure error ∉ events

theorem g2OneActive_nil {B E I : Type} :
    g2OneActive ([] : List (OneEvent B E I)) := by
  constructor
  · intro before after h
    have lengths := congrArg List.length h
    simp only [List.length_nil, List.length_append, List.length_cons] at lengths
    omega
  constructor
  · intro before after handle row column value h
    have lengths := congrArg List.length h
    simp only [List.length_nil, List.length_append, List.length_cons] at lengths
    omega
  constructor
  · simp
  · intro error
    simp

theorem g2OneActive_append {B E I : Type} (events : List (OneEvent B E I))
    (event : OneEvent B E I) (active : g2OneActive events)
    (allocation : event = .allocationRequested →
      ∃ value, OneEvent.zeroValue value ∈ events)
    (write : ∀ handle row column value, event = .write handle row column value →
      row = column ∧ OneEvent.unitValue value ∈ events ∧
      OneEvent.allocated handle ∈ events ∧
      ∃ zeroValue, OneEvent.fill handle zeroValue ∈ events)
    (noWrong : event ≠ .wrongZero) (noFailure : ∀ error, event ≠ .failure error) :
    g2OneActive (events ++ [event]) := by
  constructor
  · intro before after h
    rcases g2OneDecompose events event .allocationRequested before after h with
      ⟨tail, old, suffix⟩ | ⟨frontEq, equal, empty⟩
    · exact active.1 before tail old
    · rw [frontEq]
      exact allocation equal.symm
  constructor
  · intro before after handle row column value h
    rcases g2OneDecompose events event (.write handle row column value) before after h with
      ⟨tail, old, suffix⟩ | ⟨frontEq, equal, empty⟩
    · exact active.2.1 before tail handle row column value old
    · rw [frontEq]
      exact write handle row column value equal.symm
  constructor
  · intro h
    simp only [List.mem_append, List.mem_singleton] at h
    exact h.elim active.2.2.1 (fun equal => noWrong equal.symm)
  · intro error h
    simp only [List.mem_append, List.mem_singleton] at h
    exact h.elim (active.2.2.2 error) (fun equal => noFailure error equal.symm)

theorem g2One_error {W B E I : Type} (world : W) (events : List (OneEvent B E I))
    (error : ArrayError) (active : g2OneActive events) :
    OneObservationCorrect (⟨.error error, world, events⟩ : OneObservation W B E I B) := by
  dsimp only [OneObservationCorrect]
  refine ⟨active.1, ?_, active.2.1, ?_, ?_⟩
  · intro before after h
    have member : OneEvent.wrongZero ∈ events := by rw [h]; simp
    exact False.elim (active.2.2.1 member)
  · intro handle h
    cases h
  · intro before after e h
    have member : OneEvent.failure e ∈ events := by rw [h]; simp
    exact False.elim (active.2.2.2 e member)

theorem g2One_ok {W B E I : Type} (world : W) (events : List (OneEvent B E I))
    (handle : B) (active : g2OneActive events)
    (allocation : oneAllocationResults events = [handle]) :
    OneObservationCorrect (⟨.ok handle, world, events⟩ : OneObservation W B E I B) := by
  dsimp only [OneObservationCorrect]
  refine ⟨active.1, ?_, active.2.1, ?_, ?_⟩
  · intro before after h
    have member : OneEvent.wrongZero ∈ events := by rw [h]; simp
    exact False.elim (active.2.2.1 member)
  · intro returned h
    cases h
    exact allocation
  · intro before after e h
    have member : OneEvent.failure e ∈ events := by rw [h]; simp
    exact False.elim (active.2.2.2 e member)

theorem g2One_failure {W B E I : Type} (world : W) (events : List (OneEvent B E I))
    (error : ArrayError) (active : g2OneActive events) :
    OneObservationCorrect
      (⟨.error error, world, events ++ [.failure error]⟩ : OneObservation W B E I B) := by
  dsimp only [OneObservationCorrect]
  constructor
  · intro before after h
    rcases g2OneDecompose events (.failure error) .allocationRequested before after h with
      ⟨tail, old, suffix⟩ | ⟨frontEq, equal, empty⟩
    · exact active.1 before tail old
    · cases equal
  constructor
  · intro before after h
    have member : OneEvent.wrongZero ∈ events ++ [.failure error] := by rw [h]; simp
    have absent : OneEvent.wrongZero ∉ events ++ [.failure error] := by
      simpa [List.mem_append] using active.2.2.1
    exact False.elim (absent member)
  constructor
  · intro before after handle row column value h
    rcases g2OneDecompose events (.failure error) (.write handle row column value) before after h with
      ⟨tail, old, suffix⟩ | ⟨frontEq, equal, empty⟩
    · exact active.2.1 before tail handle row column value old
    · cases equal
  constructor
  · intro handle h
    cases h
  · intro before after e h
    rcases g2OneDecompose events (.failure error) (.failure e) before after h with
      ⟨tail, old, suffix⟩ | ⟨frontEq, equal, empty⟩
    · have member : OneEvent.failure e ∈ events := by rw [old]; simp
      exact False.elim (active.2.2.2 e member)
    · cases equal
      exact ⟨empty, rfl⟩

theorem g2One_wrongZero {W B E I : Type} (world : W) (events : List (OneEvent B E I))
    (active : g2OneActive events) (noAllocation : OneEvent.allocationRequested ∉ events) :
    OneObservationCorrect
      (⟨.error (.showError .typeError), world, events ++ [.wrongZero]⟩ : OneObservation W B E I B) := by
  dsimp only [OneObservationCorrect]
  constructor
  · intro before after h
    rcases g2OneDecompose events .wrongZero .allocationRequested before after h with
      ⟨tail, old, suffix⟩ | ⟨frontEq, equal, empty⟩
    · exact active.1 before tail old
    · cases equal
  constructor
  · intro before after h
    rcases g2OneDecompose events .wrongZero .wrongZero before after h with
      ⟨tail, old, suffix⟩ | ⟨frontEq, equal, empty⟩
    · have member : OneEvent.wrongZero ∈ events := by rw [old]; simp
      exact False.elim (active.2.2.1 member)
    · exact ⟨empty, rfl, by simpa only [frontEq] using noAllocation⟩
  constructor
  · intro before after handle row column value h
    rcases g2OneDecompose events .wrongZero (.write handle row column value) before after h with
      ⟨tail, old, suffix⟩ | ⟨frontEq, equal, empty⟩
    · exact active.2.1 before tail handle row column value old
    · cases equal
  constructor
  · intro handle h
    cases h
  · intro before after e h
    have member : OneEvent.failure e ∈ events ++ [.wrongZero] := by rw [h]; simp
    have absent : OneEvent.failure e ∉ events ++ [.wrongZero] := by
      simpa [List.mem_append] using active.2.2.2 e
    exact False.elim (absent member)


theorem g2OneBind_run {W B E I X Y : Type}
    (action : OneObserver W B E I X) (next : X → OneObserver W B E I Y)
    (world : W) (events : List (OneEvent B E I)) :
    ((action >>= next) world events) =
      (let observed := action world events
       match observed.result with
       | .error error => ⟨.error error, observed.world, observed.events⟩
       | .ok value => next value observed.world observed.events) := rfl

theorem g2OneThrow_run {W B E I X : Type} (error : ArrayError) (world : W)
    (events : List (OneEvent B E I)) :
    (throw error : OneObserver W B E I X) world events = ⟨.error error, world, events⟩ := rfl

theorem g2OnePure_bind {W B E I X Y : Type} (value : X)
    (next : X → OneObserver W B E I Y) :
    (pure value >>= next) = next value := rfl

theorem g2OneThrow_bind {W B E I X Y : Type} (error : ArrayError)
    (next : X → OneObserver W B E I Y) :
    ((throw error : OneObserver W B E I X) >>= next) = throw error := rfl

theorem g2One_bind_assoc {W B E I X Y Z : Type}
    (action : OneObserver W B E I X) (next : X → OneObserver W B E I Y)
    (last : Y → OneObserver W B E I Z) :
    ((action >>= next) >>= last) = (action >>= fun x => next x >>= last) := by
  funext world events
  simp only [g2OneBind_run]
  rcases h : action world events with ⟨reply, after, trace⟩
  cases reply <;> rfl

def g2OneQuiet {W B E I X : Type} (action : OneObserver W B E I X) : Prop :=
  ∀ world events, g2OneActive events →
    let observed := action world events
    match observed.result with
    | .error error => OneObservationCorrect
        (⟨.error error, observed.world, observed.events⟩ : OneObservation W B E I B)
    | .ok _ => observed.events = events

theorem g2OneQuiet_pure {W B E I X : Type} (value : X) :
    g2OneQuiet (pure value : OneObserver W B E I X) := by
  intro world events active
  rfl

theorem g2OneQuiet_throw {W B E I X : Type} (error : ArrayError) :
    g2OneQuiet (throw error : OneObserver W B E I X) := by
  intro world events active
  exact g2One_error world events error active

theorem g2OneQuiet_observe {W B E I X : Type} (action : OneBoundaryAction W X) :
    g2OneQuiet (oneObserveAction (B := B) (E := E) (I := I) action) := by
  intro world events active
  unfold oneObserveAction
  rcases h : action world with ⟨reply, after⟩
  cases reply with
  | error error => exact g2One_failure after events error active
  | ok value => rfl

theorem g2OneQuiet_bind {W B E I X Y : Type}
    (action : OneObserver W B E I X) (next : X → OneObserver W B E I Y)
    (first : g2OneQuiet action) (rest : ∀ x, g2OneQuiet (next x)) :
    g2OneQuiet (action >>= next) := by
  intro world events active
  simp only [g2OneBind_run]
  have firstGood := first world events active
  rcases h : action world events with ⟨reply, after, trace⟩
  cases reply with
  | error error =>
      simpa only [h] using firstGood
  | ok value =>
      have unchanged : trace = events := by simpa only [h] using firstGood
      subst trace
      exact rest value after events active

theorem g2OneQuiet_continue {W B E I X : Type}
    (action : OneObserver W B E I X) (next : X → OneObserver W B E I B)
    (quiet : g2OneQuiet action) (world : W) (events : List (OneEvent B E I))
    (active : g2OneActive events)
    (rest : ∀ x after, OneObservationCorrect (next x after events)) :
    OneObservationCorrect ((action >>= next) world events) := by
  simp only [g2OneBind_run]
  have firstGood := quiet world events active
  rcases h : action world events with ⟨reply, after, trace⟩
  cases reply with
  | error error => simpa only [h] using firstGood
  | ok value =>
      have unchanged : trace = events := by simpa only [h] using firstGood
      subst trace
      exact rest value after

theorem g2OneObserve_continue {W B E I X : Type}
    (action : OneBoundaryAction W X) (mark : X → Option (OneEvent B E I))
    (next : X → OneObserver W B E I B) (world : W) (events : List (OneEvent B E I))
    (active : g2OneActive events)
    (rest : ∀ x after, OneObservationCorrect
      (next x after (match mark x with | none => events | some event => events ++ [event]))) :
    OneObservationCorrect ((oneObserveAction action mark >>= next) world events) := by
  simp only [g2OneBind_run, oneObserveAction]
  rcases h : action world with ⟨reply, after⟩
  cases reply with
  | error error => exact g2One_failure after events error active
  | ok value => exact rest value after

theorem g2OneQuiet_any {W B E I A : Type} (predicate : A → OneObserver W B E I Bool)
    (quiet : ∀ a, g2OneQuiet (predicate a)) (values : List A) :
    g2OneQuiet (anyTupleBool predicate values) := by
  induction values with
  | nil => exact g2OneQuiet_pure false
  | cons a values ih =>
      unfold anyTupleBool
      apply g2OneQuiet_bind
      · exact quiet a
      · intro answer
        cases answer with
        | false => exact ih
        | true => exact g2OneQuiet_pure true

theorem g2OneAllocation_append {B E I : Type} (left right : List (OneEvent B E I)) :
    oneAllocationResults (left ++ right) =
      oneAllocationResults left ++ oneAllocationResults right := by
  induction left with
  | nil => rfl
  | cons event left ih =>
      cases event <;> simp only [List.cons_append, oneAllocationResults, ih, List.cons_append]


theorem g2OneQuiet_map {W B E I X Y : Type} (f : X → Y)
    (action : OneObserver W B E I X) (quiet : g2OneQuiet action) :
    g2OneQuiet (f <$> action) := by
  change g2OneQuiet (action >>= fun x => pure (f x))
  exact g2OneQuiet_bind action _ quiet (fun x => g2OneQuiet_pure (f x))

theorem g2OneQuiet_hasOffset {W B E I A Ax : Type}
    (axes : A → OneObserver W B E I (List Ax))
    (first : Ax → OneObserver W B E I I)
    (toInt : I → OneObserver W B E I I64)
    (axesQuiet : ∀ a, g2OneQuiet (axes a))
    (firstQuiet : ∀ ax, g2OneQuiet (first ax))
    (intQuiet : ∀ i, g2OneQuiet (toInt i)) (a : A) :
    g2OneQuiet (hasOffsetAxesEffectful axes first toInt a) := by
  unfold hasOffsetAxesEffectful
  apply g2OneQuiet_bind
  · exact axesQuiet a
  · intro values
    apply g2OneQuiet_any
    intro axis
    apply g2OneQuiet_bind
    · exact firstQuiet axis
    · intro i
      exact g2OneQuiet_map _ _ (intQuiet i)

theorem g2OneQuiet_require {W B E I A : Type}
    (offset : A → OneObserver W B E I Bool)
    (quiet : ∀ a, g2OneQuiet (offset a)) (a : A) :
    g2OneQuiet (JuliaLean.base.abstractarray.requireOneBased offset a) := by
  unfold JuliaLean.base.abstractarray.requireOneBased
  apply g2OneQuiet_bind
  · exact quiet a
  · intro hasOffset
    cases hasOffset with
    | false => exact g2OneQuiet_pure true
    | true => exact g2OneQuiet_throw _

theorem g2OneActive_unit {B E I : Type} (events : List (OneEvent B E I))
    (active : g2OneActive events) (value : E) :
    g2OneActive (events ++ [.unitValue value]) := by
  apply g2OneActive_append _ _ active <;> simp

theorem g2OneActive_zero {B E I : Type} (events : List (OneEvent B E I))
    (active : g2OneActive events) (value : E) :
    g2OneActive (events ++ [.zeroValue value]) := by
  apply g2OneActive_append _ _ active <;> simp

theorem g2OneActive_requested {B E I : Type} (events : List (OneEvent B E I))
    (active : g2OneActive events) (zero : E) (present : OneEvent.zeroValue zero ∈ events) :
    g2OneActive (events ++ [.allocationRequested]) := by
  apply g2OneActive_append _ _ active
  · intro h
    exact ⟨zero, present⟩
  all_goals simp

theorem g2OneActive_allocated {B E I : Type} (events : List (OneEvent B E I))
    (active : g2OneActive events) (handle : B) :
    g2OneActive (events ++ [.allocated handle]) := by
  apply g2OneActive_append _ _ active <;> simp

theorem g2OneActive_filled {B E I : Type} (events : List (OneEvent B E I))
    (active : g2OneActive events) (handle : B) (zero : E) :
    g2OneActive (events ++ [.fill handle zero]) := by
  apply g2OneActive_append _ _ active <;> simp

theorem g2OneActive_write {B E I : Type} (events : List (OneEvent B E I))
    (active : g2OneActive events) (handle : B) (index : I) (value : E)
    (unitPresent : OneEvent.unitValue value ∈ events)
    (allocationPresent : OneEvent.allocated handle ∈ events)
    (fillPresent : ∃ zero, OneEvent.fill handle zero ∈ events) :
    g2OneActive (events ++ [.write handle index index value]) := by
  apply g2OneActive_append _ _ active
  · intro h
    cases h
  · intro b row column v h
    cases h
    exact ⟨rfl, unitPresent, allocationPresent, fillPresent⟩
  all_goals simp


def g2OnePreserves {W B E I X : Type} (invariant : List (OneEvent B E I) → Prop)
    (action : OneObserver W B E I X) : Prop :=
  ∀ world events, invariant events →
    let observed := action world events
    match observed.result with
    | .error error => OneObservationCorrect
        (⟨.error error, observed.world, observed.events⟩ : OneObservation W B E I B)
    | .ok _ => invariant observed.events

theorem g2OnePreserves_pure {W B E I X : Type}
    (invariant : List (OneEvent B E I) → Prop) (value : X) :
    g2OnePreserves invariant (pure value : OneObserver W B E I X) := by
  intro world events valid
  exact valid

theorem g2OnePreserves_bind {W B E I X Y : Type}
    (invariant : List (OneEvent B E I) → Prop)
    (action : OneObserver W B E I X) (next : X → OneObserver W B E I Y)
    (first : g2OnePreserves invariant action)
    (rest : ∀ x, g2OnePreserves invariant (next x)) :
    g2OnePreserves invariant (action >>= next) := by
  intro world events valid
  simp only [g2OneBind_run]
  have firstGood := first world events valid
  rcases h : action world events with ⟨reply, after, trace⟩
  cases reply with
  | error error => simpa only [h] using firstGood
  | ok value => exact rest value after trace (by simpa only [h] using firstGood)

theorem g2OnePreserves_observe {W B E I X : Type}
    (invariant : List (OneEvent B E I) → Prop)
    (active : ∀ events, invariant events → g2OneActive events)
    (action : OneBoundaryAction W X) :
    g2OnePreserves invariant (oneObserveAction action : OneObserver W B E I X) := by
  intro world events valid
  unfold oneObserveAction
  rcases h : action world with ⟨reply, after⟩
  cases reply with
  | error error => exact g2One_failure after events error (active events valid)
  | ok value => exact valid

theorem g2OnePreserves_record {W B E I : Type}
    (invariant : List (OneEvent B E I) → Prop) (event : OneEvent B E I)
    (preserves : ∀ events, invariant events → invariant (events ++ [event])) :
    g2OnePreserves invariant (oneRecord event : OneObserver W B E I Unit) := by
  intro world events valid
  exact preserves events valid

theorem g2OnePreserves_axis {W B E I State : Type}
    (invariant : List (OneEvent B E I) → Prop)
    (active : ∀ events, invariant events → g2OneActive events)
    (program : OneAxisProgram W I)
    (body : I → State → OneObserver W B E I (ForInStep State))
    (bodyValid : ∀ i u, g2OnePreserves invariant (body i u)) (initial : State) :
    g2OnePreserves invariant (oneAxisForIn program initial body) := by
  induction program generalizing initial with
  | done => exact g2OnePreserves_pure invariant initial
  | yield index rest ih =>
      unfold oneAxisForIn
      apply g2OnePreserves_bind
      · exact bodyValid index initial
      · intro step
        cases step with
        | done final => exact g2OnePreserves_pure invariant final
        | yield next => exact ih next
  | effect action rest ih =>
      unfold oneAxisForIn
      apply g2OnePreserves_bind
      · exact g2OnePreserves_observe invariant active action
      · intro ignored
        exact ih initial
  | inspect next ih =>
      intro world events valid
      exact ih world initial world events valid

def g2OneLoopInvariant {B E I : Type} (handle : B) (unit : E)
    (events : List (OneEvent B E I)) : Prop :=
  g2OneActive events ∧ OneEvent.unitValue unit ∈ events ∧
    OneEvent.allocated handle ∈ events ∧
    (∃ zero, OneEvent.fill handle zero ∈ events) ∧
    oneAllocationResults events = [handle]

theorem g2OneLoopInvariant_write {B E I : Type} (handle : B) (unit : E) (index : I)
    (events : List (OneEvent B E I)) (valid : g2OneLoopInvariant handle unit events) :
    g2OneLoopInvariant handle unit (events ++ [.write handle index index unit]) := by
  refine ⟨g2OneActive_write events valid.1 handle index unit
