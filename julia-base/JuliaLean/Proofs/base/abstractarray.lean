namespace JuliaLean.ChatGPT.Batch11.Group7
open JuliaLean JuliaLean.base.abstractarray
open JuliaLean.base.abstractarray.Models1Group3
open JuliaLean.Proofs.base.abstractarray.Models1Group3
open JuliaLean.ChatGPT.Batch9.Group11
set_option maxHeartbeats 2000000
set_option maxRecDepth 10000

abbrev G7HStore (E : Type) := I64 × I64 × E

def g7hEvent {Ty Ref E : Type} (a : NativeMatrix Ty Ref)
    (request : G7HStore E) (result : Result Unit) : HvcatEvent Ty Ref E :=
  .set2 a request.1 request.2.1 request.2.2 result

def g7hPlacement {Ty Ref E : Type} (a : NativeMatrix Ty Ref)
    (request : G7HStore E) : NativeMatrix Ty Ref × Int × Int × E :=
  (a, request.1.val, request.2.1.val, request.2.2)

inductive G7HRun {Ty Ref E : Type} (a : NativeMatrix Ty Ref) :
    List (G7HStore E) → Result (NativeMatrix Ty Ref) → List (HvcatEvent Ty Ref E) → Prop where
  | done : G7HRun a [] (.ok a) []
  | failure (request : G7HStore E) (rest : List (G7HStore E)) (error : ArrayError) :
      G7HRun a (request :: rest) (.error error) [g7hEvent a request (.error error)]
  | step (request : G7HStore E) (rest : List (G7HStore E))
      (result : Result (NativeMatrix Ty Ref)) (events : List (HvcatEvent Ty Ref E)) :
      G7HRun a rest result events →
      G7HRun a (request :: rest) result (g7hEvent a request (.ok ()) :: events)

def G7HOutcome {Ty Ref E : Type} (a : NativeMatrix Ty Ref)
    (expected : List (NativeMatrix Ty Ref × Int × Int × E))
    (result : Result (NativeMatrix Ty Ref)) (events : List (HvcatEvent Ty Ref E)) : Prop :=
  HvcatFailuresStop result events ∧ HvcatOnlyStores a events ∧
  (hvcatStoreAttempts events).IsPrefix expected ∧
  match result with
  | .ok returned => returned = a ∧ hvcatStoreAttempts events = expected ∧
      HvcatStoresSucceeded events
  | .error error =>
      ∃ event, events.getLast? = some event ∧ hvcatRecordedError event = some error

theorem g7h_event_error {Ty Ref E : Type} (a : NativeMatrix Ty Ref)
    (request : G7HStore E) (result : Result Unit) :
    hvcatRecordedError (g7hEvent a request result) =
      match result with | .ok _ => none | .error error => some error := by
  cases result <;> rfl

theorem g7h_event_placement {Ty Ref E : Type} (a : NativeMatrix Ty Ref)
    (request : G7HStore E) (result : Result Unit) (events : List (HvcatEvent Ty Ref E)) :
    hvcatStoreAttempts (g7hEvent a request result :: events) =
      g7hPlacement a request :: hvcatStoreAttempts events := rfl

theorem g7h_failures_nil {Ty Ref E : Type} (result : Result (NativeMatrix Ty Ref)) :
    HvcatFailuresStop result ([] : List (HvcatEvent Ty Ref E)) := by
  intro before event after error he _
  have hl := congrArg List.length he
  simp only [List.length_nil, List.length_append, List.length_cons] at hl
  omega

theorem g7h_failures_singleton {Ty Ref E : Type} (event : HvcatEvent Ty Ref E)
    (error : ArrayError) (herror : hvcatRecordedError event = some error) :
    HvcatFailuresStop (.error error) [event] := by
  intro before selected after err he hs
  cases before with
  | nil =>
      change [event] = selected :: after at he
      cases he
      rw [herror] at hs
      have hh := Option.some.inj hs
      subst err
      exact ⟨rfl, rfl⟩
  | cons first rest =>
      have hl := congrArg List.length he
      simp only [List.length_nil, List.length_append, List.length_cons] at hl
      omega

theorem g7h_failures_cons {Ty Ref E : Type} (event : HvcatEvent Ty Ref E)
    (events : List (HvcatEvent Ty Ref E)) (result : Result (NativeMatrix Ty Ref))
    (herror : hvcatRecordedError event = none)
    (hrest : HvcatFailuresStop result events) :
    HvcatFailuresStop result (event :: events) := by
  intro before selected after error he hs
  cases before with
  | nil =>
      change event :: events = selected :: after at he
      cases he
      rw [herror] at hs
      cases hs
  | cons first before =>
      change event :: events = first :: (before ++ selected :: after) at he
      have eqs := List.cons.inj he
      exact hrest before selected after error eqs.2 hs

theorem g7h_failures_succeeded {Ty Ref E : Type}
    (events : List (HvcatEvent Ty Ref E)) (result : Result (NativeMatrix Ty Ref))
    (hs : HvcatStoresSucceeded events) : HvcatFailuresStop result events := by
  intro before event after error he herr
  have hm : event ∈ events := by
    rw [he]
    exact List.mem_append_right before (List.mem_cons_self ..)
  rw [hs event hm] at herr
  cases herr

theorem g7h_run_outcome {Ty Ref E : Type} (a : NativeMatrix Ty Ref)
    (requests : List (G7HStore E)) (result : Result (NativeMatrix Ty Ref))
    (events : List (HvcatEvent Ty Ref E)) (run : G7HRun a requests result events) :
    G7HOutcome a (requests.map (g7hPlacement a)) result events := by
  induction run with
  | done =>
      refine ⟨g7h_failures_nil _, ?_, ⟨[], rfl⟩, rfl, rfl, ?_⟩
      · intro event hevent
        cases hevent
      · intro event hevent
        cases hevent
  | failure request rest error =>
      refine ⟨g7h_failures_singleton _ error (g7h_event_error ..), ?_, ?_, ?_⟩
      · intro event hevent
        have heq := List.mem_singleton.mp hevent
        subst event
        rfl
      · refine ⟨rest.map (g7hPlacement a), ?_⟩
        rw [g7h_event_placement]
        rfl
      · exact ⟨_, rfl, g7h_event_error ..⟩
  | step request rest result events run ih =>
      obtain ⟨hstop, htarget, hpref, hresult⟩ := ih
      refine ⟨g7h_failures_cons _ _ _ (g7h_event_error ..) hstop, ?_, ?_, ?_⟩
      · intro event hevent
        rcases List.mem_cons.mp hevent with rfl | hrest
        · rfl
        · exact htarget event hrest
      · obtain ⟨suffix, hsuffix⟩ := hpref
        refine ⟨suffix, ?_⟩
        rw [g7h_event_placement, List.cons_append, hsuffix]
        rfl
      · cases result with
        | ok returned =>
            obtain ⟨hreturned, hstores, hsucceeded⟩ := hresult
            refine ⟨hreturned, ?_, ?_⟩
            · rw [g7h_event_placement, hstores]
              rfl
            · intro event hevent
              rcases List.mem_cons.mp hevent with rfl | hevent
              · exact g7h_event_error ..
              · exact hsucceeded event hevent
        | error error =>
            obtain ⟨last, hlast, herror⟩ := hresult
            refine ⟨last, ?_, herror⟩
            cases events with
            | nil => cases hlast
            | cons first tail => exact hlast

def g7hStores {m : Type → Type} [Monad m] {Ty Ref E : Type}
    (runtime : HvcatArrayRuntime m Ty Ref E) (a : NativeMatrix Ty Ref) :
    List (G7HStore E) → m (NativeMatrix Ty Ref)
  | [] => pure a
  | request :: rest => do
      runtime.set2 a request.1 request.2.1 request.2.2
      g7hStores runtime a rest

theorem g7h_stores_append {m : Type → Type} [Monad m] [LawfulMonad m]
    {Ty Ref E : Type} (runtime : HvcatArrayRuntime m Ty Ref E)
    (a : NativeMatrix Ty Ref) (first rest : List (G7HStore E)) :
    g7hStores runtime a (first ++ rest) =
      (do let _ ← g7hStores runtime a first; g7hStores runtime a rest) := by
  induction first with
  | nil => simp only [List.nil_append, g7hStores, pure_bind]
  | cons request first ih =>
      simp only [List.cons_append, g7hStores, bind_assoc, ih]

theorem g7h_stores_return {m : Type → Type} [Monad m] [LawfulMonad m]
    {Ty Ref E : Type} (runtime : HvcatArrayRuntime m Ty Ref E)
    (a : NativeMatrix Ty Ref) (requests : List (G7HStore E)) :
    (do let _ ← g7hStores runtime a requests; pure a) = g7hStores runtime a requests := by
  have h := g7h_stores_append runtime a requests []
  simpa only [List.append_nil, g7hStores] using h.symm

theorem g7h_store_observe {World Ty Ref E : Type}
    (runtime : HvcatArrayRuntime (HvcatPrimitive World) Ty Ref E)
    (a : NativeMatrix Ty Ref) (request : G7HStore E) (world : World)
    (events : List (HvcatEvent Ty Ref E)) (audit : Option World) :
    ((hvcatObserveRuntime runtime).set2 a request.1 request.2.1 request.2.2).run
        (world, events, audit) =
      let observed := runtime.set2 a request.1 request.2.1 request.2.2 world
      (observed.1, (observed.2, events ++ [g7hEvent a request observed.1], some observed.2)) := rfl

theorem g7h_stores_run {World Ty Ref E : Type}
    (runtime : HvcatArrayRuntime (HvcatPrimitive World) Ty Ref E)
    (a : NativeMatrix Ty Ref) (requests : List (G7HStore E)) (world : World)
    (initialEvents : List (HvcatEvent Ty Ref E)) :
    let observed := (g7hStores (hvcatObserveRuntime runtime) a requests).run
      (world, initialEvents, some world)
    ∃ events, observed.2.2.1 = initialEvents ++ events ∧
      observed.2.2.2 = some observed.2.1 ∧ G7HRun a requests observed.1 events := by
  induction requests generalizing world initialEvents with
  | nil =>
      refine ⟨[], ?_, rfl, G7HRun.done⟩
      exact (List.append_nil initialEvents).symm
  | cons request rest ih =>
      simp only [g7hStores, g1hv_state_run_bind, g7h_store_observe]
      cases hp : runtime.set2 a request.1 request.2.1 request.2.2 world with
      | mk result nextWorld =>
          cases result with
          | error error =>
              exact ⟨[g7hEvent a request (.error error)], rfl, rfl,
                G7HRun.failure request rest error⟩
          | ok ignored =>
              cases ignored
              obtain ⟨events, hevents, haudit, hrun⟩ :=
                ih nextWorld (initialEvents ++ [g7hEvent a request (.ok ())])
              refine ⟨g7hEvent a request (.ok ()) :: events, ?_, haudit, ?_⟩
              · simpa only [List.append_assoc, List.singleton_append] using hevents
              · exact G7HRun.step request rest _ events hrun

