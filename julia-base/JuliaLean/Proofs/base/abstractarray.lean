  | .nativeInt rank =>
      (rank.val = 0 ∧ error = .julia (.argumentError
        "a 0-dimensional array may only contain exactly one element")) ∨
      (rank.val < 0 ∧ error = .julia (.argumentError
        "concatenation dimension must be non-negative"))
  | .tuple fields =>
      match fields.values with
      | [] => error = .julia (.argumentError
          "a 0-dimensional array may only contain exactly one element")
      | [.nativeInt dimension] => EmptyHvncatOneDimensionError dimension error
      | [.tuple inner] =>
