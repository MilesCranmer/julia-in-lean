theorem g2Boundary_bind {W X Y : Type} (action : Boundary W X)
    (next : X → Boundary W Y) (w : W) :
    ((action >>= next) w) =
      (match action w with
       | (.error e, w') => (.error e, w')
       | (.ok x, w') => next x w') := by
  change (action >>= next).run.run w = _
  rw [ExceptT.run_bind, StateT.run_bind]
  rcases h : action.run.run w with ⟨reply, after⟩
  change action w = (reply, after) at h
  rw [h]
  cases reply <;> rfl

theorem g2Boundary_pure {W X : Type} (x : X) (w : W) :
    (pure x : Boundary W X) w = (.ok x, w) := rfl

theorem g2Boundary_throw {W X : Type} (e : ArrayError) (w : W) :
    (throw e : Boundary W X) w = (.error e, w) := rfl


theorem g2Result_throw {X : Type} (e : ArrayError) :
    (throw e : Result X) = .error e := rfl

theorem g2Boundary_map {W X Y : Type} (f : X → Y) (action : Boundary W X) (w : W) :
    (f <$> action) w = ((action w).1.map f, (action w).2) := by
  rw [map_eq_pure_bind, g2Boundary_bind]
  rcases h : action w with ⟨reply, after⟩
  cases reply <;> rfl

