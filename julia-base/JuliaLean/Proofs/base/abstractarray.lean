    (firstB : B → ExceptT ArrayError (StateM σ) (Option (F × SB)))
    (nextB : B → SB → ExceptT ArrayError (StateM σ) (Option (F × SB)))
    (compare : E → F → ExceptT ArrayError (StateM σ) Bool)
    (a : A) (b : B) (state : σ),
    let observed := ((arrayIslessZeroDimLinked
      (fun a => islessZeroObserve (firstA a))
      (fun a s => islessZeroObserve (nextA a s))
      (fun b => islessZeroObserve (firstB b))
