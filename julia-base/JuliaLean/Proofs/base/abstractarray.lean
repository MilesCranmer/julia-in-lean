def g1hv_gridNat {E : Type} (columns row : Nat) : Nat → List E → List (Nat × Nat × E)
  | 0, _ => []
  | n + 1, values =>
      ((List.range columns).zip values).map (fun (c, v) => (row, c, v)) ++
        g1hv_gridNat columns (row + 1) n (values.drop columns)

theorem g1hv_gridRow {E : Type} (columns row : Nat) (values : List E) :
    ((List.range columns).zip values).map (fun (c, v) => (row, c, v)) =
      (values.take columns).mapIdx (fun p v => (row, p, v)) := by
  apply List.ext_getElem
  · simp only [List.length_map, List.length_zip, List.length_range,
      List.length_mapIdx, List.length_take]
  · intro i h₁ h₂
    simp only [List.getElem_map, List.getElem_zip, List.getElem_range,
      List.getElem_mapIdx, List.getElem_take]

theorem g1hv_grid_mapIdx {E : Type} (columns row nrows : Nat) (values : List E)
    (lengthEq : values.length = nrows * columns) :
    g1hv_gridNat columns row nrows values =
      values.mapIdx (fun p v => (row + p / columns, p % columns, v)) := by
  induction nrows generalizing row values with
  | zero =>
      have empty : values = [] := List.length_eq_zero_iff.mp (by simpa only [Nat.zero_mul] using lengthEq)
      subst values
      rfl
  | succ n ih =>
      have enough : columns ≤ values.length := by rw [lengthEq, Nat.succ_mul]; omega
      have dropLength : (values.drop columns).length = n * columns := by
        rw [List.length_drop, lengthEq, Nat.succ_mul]
        omega
      have takeLength : (values.take columns).length = columns := by
        rw [List.length_take, Nat.min_eq_left enough]
      rw [g1hv_gridNat, g1hv_gridRow, ih (row + 1) (values.drop columns) dropLength]
      conv =>
        rhs
        rw [← List.take_append_drop columns values, List.mapIdx_append]
