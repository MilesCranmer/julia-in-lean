        else .ok (xs.take n.val.toNat)) ∧
    (lastVectorN (fun n : JInt t => decide (n.val < 0))
      (fun xs => vectorLastIndex last xs.length) length
      (fun n len => pure (min n.val.toNat len.val.toNat))
      (fun last count => pure (last, count, true))
