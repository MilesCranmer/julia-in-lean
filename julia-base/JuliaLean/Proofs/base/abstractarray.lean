/-- An exception channel outside state retains the world at the throw. This
observation model includes arbitrary constructor and array-interface effects;
the assertions impose no correctness law on those external operations. -/
abbrev Observed (World : Type) := ExceptT ArrayError (StateM World)

/-- A type assertion conserves the evaluated value and the world. Successful
outputs are exactly the accepted input payloads; every nonmember is rejected;
and a pre-existing exception is preserved. This relation does not evaluate a
constructor, perform a type assertion, or choose a source-code branch. -/
def AssertionConservation {Expected Other World : Type}
    (before : Except ArrayError (TypeAssertion Expected Other) × World)
    (after : Except ArrayError Expected × World) : Prop :=
  after.2 = before.2 ∧
  (∀ value, after.1 = .ok value ↔ before.1 = .ok (.accepted value)) ∧
  (∀ outside, before.1 = .ok (.rejected outside) →
    after.1 = .error (.showError .typeError)) ∧
  (∀ error, before.1 = .error error → after.1 = .error error)

/-- Conversion returns exactly the constructor's object when that object
belongs to AbstractArray{T}, rejects every other result with TypeError, and
