def g2AllSuccess {W X : Type} (post : X → Prop) (action : Boundary W X) : Prop :=
  ∀ w x, (action w).1 = .ok x → post x

theorem g2AllSuccess_bind {W X Y : Type} (post : Y → Prop)
    (action : Boundary W X) (next : X → Boundary W Y)
    (valid : ∀ x, g2AllSuccess post (next x)) :
    g2AllSuccess post (action >>= next) := by
  intro w y h
  rcases ha : action w with ⟨reply, w'⟩
  cases reply with
  | error e =>
      simp only [g2Boundary_bind, ha] at h
      cases h
  | ok x =>
      simp only [g2Boundary_bind, ha] at h
      exact valid x w' y h

theorem g2AllSuccess_pure {W X : Type} (post : X → Prop) (x : X)
    (valid : post x) : g2AllSuccess post (pure x : Boundary W X) := by
  intro w y h
  simp only [g2Boundary_pure, Except.ok.injEq] at h
  cases h
  exact valid

theorem g2AllSuccess_throw {W X : Type} (post : X → Prop) (e : ArrayError) :
    g2AllSuccess post (throw e : Boundary W X) := by
  intro w y h
  simp only [g2Boundary_throw] at h
  cases h

theorem g2Fill_prefix {World A Axis I : Type}
    (axes : A → Boundary World (List Axis)) (first : Axis → Boundary World I)
    (a : A) (dispatchAxes : Axis × List Axis) (j : List I) :
    g2AllSuccess (fun out => j.IsPrefix out)
      (toSubscriptsFillClosed axes first a dispatchAxes j) := by
  unfold toSubscriptsFillClosed
  apply g2AllSuccess_bind
  intro observed
  cases remainingSize j observed with
  | error e =>
      intro world output h
      simp only [g2Boundary_bind, g2Boundary_throw] at h
      cases h
  | ok remaining =>
      simp only [pure_bind]
      cases tupleTail remaining with
      | error e =>
          intro world output h
          simp only [g2Boundary_bind, g2Boundary_throw] at h
          cases h
      | ok tail =>
          simp only [pure_bind]
          apply g2AllSuccess_bind
          intro trailing
          apply g2AllSuccess_pure
          exact ⟨trailing, rfl⟩

theorem g2NoRemainder_prefix {World A Axis I : Type}
    (axes : A → Boundary World (List Axis)) (first : Axis → Boundary World I)
    (a : A) (j : List I) :
    g2AllSuccess (fun out => j.IsPrefix out)
      (toSubscriptsNoRemainderClosed axes first a j) := by
  unfold toSubscriptsNoRemainderClosed
  apply g2AllSuccess_bind
  intro observed
  cases observed with
  | nil => exact g2AllSuccess_throw _ _
  | cons axis rest => exact g2Fill_prefix axes first a (axis, rest) j

theorem g2SplitHead_take {I : Type} (is : List I) (n : Nat) :
    splitHead is (List.replicate n true) = is.take n := by
  induction n generalizing is with
  | zero => cases is <;> rfl
  | succ n ih =>
      cases is with
      | nil => rfl
      | cons i is => simpa only [List.replicate_succ, splitHead, List.take_succ_cons] using congrArg (List.cons i) (ih is)

theorem g2Split_prefix {World A Axis I : Type}
    (axes : A → Boundary World (List Axis)) (first : Axis → Boundary World I)
    (a : A) (j : List I) (rank : Nat) :
    g2AllSuccess (fun out => (j.take rank).IsPrefix out)
      (toSubscriptsSplitClosed axes first rank a j) := by
  unfold toSubscriptsSplitClosed splitTuple
  simp only []
  rw [g2SplitHead_take]
  unfold toSubscriptsRemainderClosed
  cases splitRest j (List.replicate rank true) with
  | nil => exact g2NoRemainder_prefix axes first a (j.take rank)
  | cons head tail =>
      apply g2AllSuccess_pure
      exact ⟨[], by simp only [List.append_nil, toSubscriptsDropRemainder]⟩

theorem g2Remaining_suffix {I Axis : Type} (indices : List I) (axes : List Axis)
    (out : List Axis) (h : remainingSize indices axes = .ok out) :
    out.IsSuffix axes := by
  induction indices generalizing axes with
  | nil => simp only [remainingSize] at h; cases h
  | cons i is ih =>
      cases is with
      | nil =>
          simp only [remainingSize, remainingSizeSingle, Except.ok.injEq] at h
          cases h
          exact ⟨[], rfl⟩
      | cons j js =>
          cases axes with
          | nil =>
              simp [remainingSize, remainingSizeMany, tupleTail, tupleArgtail,
                bind, Except.bind, pure, Except.pure] at h
          | cons axis rest =>
              simp only [remainingSize, remainingSizeMany, tupleTail, tupleArgtail,
                bind, Except.bind, pure, Except.pure] at h
              rcases ih rest h with ⟨before, hb⟩
              exact ⟨axis :: before, by simpa only [List.cons_append] using congrArg (List.cons axis) hb⟩

