/-- The `_typed_stack(:, ...)` copy loop over a cursor of slices: each step
records the slice at the current offset and advances the offset by `len`, so
the slices land in order at `off, off + len, ...`. -/
theorem stackColonLoop {X : Type} (ok : X → Prop) (len : I64)
    (whileLoop : (β : Type) → β → (β → StateT (List (I64 × X)) Result (ForInStep β)) →
      StateT (List (I64 × X)) Result β)
    (equation : WhileEquation whileLoop)
    (body : I64 × Option (X × List X) →
      StateT (List (I64 × X)) Result (ForInStep (I64 × Option (X × List X))))
    (doneLaw : ∀ off log, (body (off, none)).run log = pure (.done (off, none), log))
    (stepLaw : ∀ off x xs log, ok x →
      (body (off, some (x, xs))).run log = pure (.yield (off + len, cursor xs), log ++ [(off, x)])) :
    ∀ (xs : List X) (off : I64) (log : List (I64 × X)) (state : Option (X × List X)),
      state = cursor xs → (∀ x ∈ xs, ok x) →
      (whileLoop _ (off, state) body).run log =
        .ok ((nativeAfter off len xs.length, none),
          log ++ (nativeProgression off len xs.length).zip xs) := by
  intro xs
  induction xs with
  | nil =>
    intro off log state hs _
    subst hs
    rw [equation]
    simp only [show cursor ([] : List X) = none from rfl, StateT.run_bind, doneLaw, pure_bind,
      StateT.run_pure]
    simp [nativeAfter, nativeProgression]
  | cons x xs ih =>
    intro off log state hs oks
    subst hs
    rw [equation]
    simp only [show cursor (x :: xs) = some (x, xs) from rfl, StateT.run_bind,
      stepLaw off x xs log (oks x (by simp)), pure_bind]
    rw [ih (off + len) (log ++ [(off, x)]) (cursor xs) rfl (fun y hy => oks y (by simp [hy]))]
    simp [nativeAfter, nativeProgression, List.append_assoc]

/-- `_typed_stack(:, T, S, A)` over the slices of an iterator: an empty
iterator gives the empty stack; otherwise the result is allocated once with the
first slice's axes followed by the iterator's axes, every slice passes the
uniform-size check, and the slices are copied in iteration order at the linear
offsets `firstindex(B)`, `firstindex(B) + length(x1)`, ..., one slice length
apart, before that allocation is returned. -/
def StackColonSlices : Prop :=
  ∀ (X Storage Ty Ax B D : Type) (colon : D)
    (empty : D → Ty → Ty → List X → Result B) (iteratorAxes : X → Result (List Ax))
    (ensureArray : X → Result Storage) (similar : Storage → Ty → List Ax → Result B)
    (firstindex : B → Result I64) (length : X → Result I64)
    (sizeCheck : X → List Ax → Result Unit)
    (whileLoop : (β : Type) → β → (β → StateT (List (I64 × X)) Result (ForInStep β)) →
      StateT (List (I64 × X)) Result β),
    WhileEquation whileLoop →
    ∀ (t s : Ty) (aax : List Ax) (slices : List X) (log : List (I64 × X)),
    let run := typedStackColon colon (fun xs => pure (cursor xs))
      (fun _ rest => pure (cursor rest)) (fun c t s a => StateT.lift (empty c t s a))
      (fun x => StateT.lift (iteratorAxes x)) (fun x => StateT.lift (ensureArray x))
      (fun st t ax => StateT.lift (similar st t ax)) (fun b => StateT.lift (firstindex b))
      (fun x => StateT.lift (length x)) (fun x ax => StateT.lift (sizeCheck x ax))
      (fun b off x => do modify (· ++ [(off, x)]); pure b) (fun {β} => whileLoop β)
      t s slices aax
    (slices = [] → run.run log = (do let b ← empty colon t s []; pure (b, log))) ∧
    (∀ x1 rest ax1 storage b first len, slices = x1 :: rest → iteratorAxes x1 = .ok ax1 →
      ensureArray x1 = .ok storage → similar storage t (ax1 ++ aax) = .ok b →
      firstindex b = .ok first → length x1 = .ok len →
      (∀ x ∈ slices, sizeCheck x ax1 = .ok ()) →
      run.run log = .ok (b, log ++ (nativeProgression first len slices.length).zip slices))

theorem stackColonSlices_proven : StackColonSlices := by
  intro X Storage Ty Ax B D colon empty iteratorAxes ensureArray similar firstindex length
    sizeCheck whileLoop equation t s aax slices log
  refine ⟨?_, ?_⟩
  · intro none
    subst none
    simp only [typedStackColon, show cursor ([] : List X) = none from rfl, StateT.run_bind,
      StateT.run_pure, pure_bind, StateT.run_lift]
  · intro x1 rest ax1 storage b first len split axesLaw ensureLaw similarLaw firstLaw lenLaw
      checks
    subst split
    have axesLaw' : iteratorAxes x1 = pure ax1 := axesLaw
    have ensureLaw' : ensureArray x1 = pure storage := ensureLaw
    have similarLaw' : similar storage t (ax1 ++ aax) = pure b := similarLaw
    have firstLaw' : firstindex b = pure first := firstLaw
    have lenLaw' : length x1 = pure len := lenLaw
    simp only [typedStackColon, show cursor (x1 :: rest) = some (x1, rest) from rfl,
      StateT.run_bind, StateT.run_pure, pure_bind, StateT.run_lift, axesLaw', ensureLaw',
      similarLaw', firstLaw', lenLaw']
    rw [stackColonLoop (fun x => x ∈ x1 :: rest) len whileLoop equation _ ?done ?step
      (x1 :: rest) first log (some (x1, rest)) rfl (fun x hx => hx)]
    · simp
    case done =>
      intro off log
      simp [StateT.run, StateT.pure]
    case step =>
      intro off x xs log member
      simp [checks x member, StateT.run, StateT.pure, StateT.bind, StateT.lift, modify,
        modifyGet, StateT.modifyGet, MonadStateOf.modifyGet]

theorem forInUnitOk {α : Type} (body : α → Unit → Result (ForInStep Unit)) :
    ∀ xs : List α, (∀ x ∈ xs, body x () = pure (.yield ())) → forIn xs () body = pure ()
  | [], _ => rfl
  | x :: xs, h => by
    rw [List.forIn_cons, h x (by simp), pure_bind]
    exact forInUnitOk body xs (fun y hy => h y (by simp [hy]))

theorem forInUnitError {α : Type} (body : α → Unit → Result (ForInStep Unit)) (e : ArrayError) :
    ∀ (pre : List α) (x : α) (post : List α), (∀ y ∈ pre, body y () = pure (.yield ())) →
      body x () = .error e → forIn (pre ++ x :: post) () body = .error e
  | [], x, post, _, hx => by rw [List.nil_append, List.forIn_cons, hx]; rfl
  | y :: pre, x, post, h, hx => by
    rw [List.cons_append, List.forIn_cons, h y (by simp), pure_bind]
    exact forInUnitError body e pre x post (fun z hz => h z (by simp [hz])) hx

theorem nativePositions_split (start : Int) (a b : Nat) :
    nativePositions start (a + 1 + b) =
      nativePositions start a ++ int (start + a) :: nativePositions (start + a + 1) b := by
  induction a generalizing start with
  | zero =>
    rw [show 0 + 1 + b = b + 1 by omega, nativePositions_succ]
    simp [nativePositions]
  | succ a ih =>
    rw [show a + 1 + 1 + b = (a + 1 + b) + 1 by omega, nativePositions_succ, ih (start + 1),
      nativePositions_succ]
    simp only [List.cons_append]
    rw [show start + 1 + (a : Int) = start + ((a + 1 : Nat) : Int) by omega]

theorem sub2indVecs_eq {Ax V Axis Out : Type} [DecidableEq Axis]
    (get : List V → I64 → Result V) (axes1 : V → Result Axis) (showAxis : Axis → String)
    (range : I64 → I64 → Result (List I64)) (similar : V → Result Out)
    (fill : Out → Ax → Axis → List V → Result Out) (axes : Ax) (vectors : List V)
    (first : V) (inds : Axis) (js : List I64)
    (hf : get vectors (int 1) = pure first) (ha : axes1 first = pure inds)
    (hr : range (int 2) (int vectors.length) = pure js) :
    ∃ body : I64 → Unit → Result (ForInStep Unit),
      sub2indVecs get axes1 showAxis range similar fill axes vectors =
        (do let _ ← forIn js () body; let out ← similar first
            let _ ← fill out axes inds vectors; pure out) ∧
      (∀ j v, get vectors j = pure v → axes1 v = pure inds → body j () = pure (.yield ())) ∧
      (∀ j v other, get vectors j = pure v → axes1 v = pure other → other ≠ inds →
        ∃ message, body j () = .error (.dimensionMismatch message)) := by
  refine ⟨?body, ?eq, ?ok, ?bad⟩
  case eq =>
    unfold sub2indVecs
    simp only [hf, ha, hr, pure_bind]
    rfl
  case ok =>
    intro j v hv hax
    simp only [hv, hax, pure_bind, bne_self_eq_false, Bool.false_eq_true, ↓reduceIte]
  case bad =>
    intro j v other hv hax differ
    exact ⟨_, by
      simp only [hv, hax, pure_bind, bne_iff_ne.mpr differ, ↓reduceIte]
      rfl⟩

/-- `_sub2ind_vecs(inds, I...)` checks that every index vector has the axes of
the first one before allocating: when they all agree it allocates
`similar(I[1])`, runs `_sub2ind!` into it once and returns it; the first vector
with different axes raises `DimensionMismatch` instead. -/
def Sub2indVecsChecks : Prop :=
  ∀ (Ax V Axis Out : Type) [DecidableEq Axis] (axes1 : V → Result Axis)
    (showAxis : Axis → String) (similar : V → Result Out)
    (fill : Out → Ax → Axis → List V → Result Out)
    (axes : Ax) (first : V) (rest : List V) (inds : Axis),
    (rest.length : Int) + 1 ≤ 9223372036854775807 → axes1 first = .ok inds →
    let run := sub2indVecs tupleGet axes1 showAxis (fun lo hi => pure (concatRange lo hi))
      similar fill axes (first :: rest)
    ((∀ v ∈ rest, axes1 v = .ok inds) → ∀ out filled, similar first = .ok out →
      fill out axes inds (first :: rest) = .ok filled → run = .ok out) ∧
    (∀ (pre : List V) (v : V) (post : List V) (other : Axis), rest = pre ++ v :: post → (∀ u ∈ pre, axes1 u = .ok inds) →
      axes1 v = .ok other → other ≠ inds →
      ∃ message, run = .error (.dimensionMismatch message))

theorem sub2indVecsChecks_proven : Sub2indVecsChecks := by
  intro Ax V Axis Out _ axes1 showAxis similar fill axes first rest inds fits firstAxes
  have firstGet : tupleGet (first :: rest) (int 1) = pure first := by
    have := tupleGet_succ (first :: rest) 0 (by simp) (by simp; omega)
    simpa using this
  have lengthVal : (int ((first :: rest).length : Int)).val = (first :: rest).length :=
    native_val_int _ (by omega) (by simp; omega)
  have range : concatRange (int 2) (int ((first :: rest).length : Int)) =
      nativePositions 2 rest.length := by
    unfold concatRange nativePositions
    rw [lengthVal, show (int 2).val = 2 from rfl,
      show ((((first :: rest).length : Nat) : Int) - 2 + 1).toNat = rest.length by
        simp only [List.length_cons]; omega]
  obtain ⟨body, unfolded, okLaw, badLaw⟩ := sub2indVecs_eq tupleGet axes1 showAxis
    (fun lo hi => pure (concatRange lo hi)) similar fill axes (first :: rest) first inds
    (nativePositions 2 rest.length) firstGet firstAxes
    (by show pure (concatRange (int 2) (int ((first :: rest).length : Int))) = _; rw [range])
  have getAt : ∀ k (h : k < rest.length),
      tupleGet (first :: rest) (int (2 + (k : Int))) = pure rest[k] := by
    intro k h
    have := tupleGet_succ (first :: rest) (k + 1) (by simp; omega) (by simp; omega)
    rw [show ((k + 1 : Nat) : Int) + 1 = 2 + (k : Int) by omega] at this
    simpa using this
  refine ⟨?_, ?_⟩
  · intro same out filled similarLaw fillLaw
    rw [unfolded, forInUnitOk body _ ?each, pure_bind]
    · simp [similarLaw, fillLaw]
    case each =>
      intro x hx
      simp only [nativePositions, List.mem_map, List.mem_range] at hx
      obtain ⟨k, hk, rfl⟩ := hx
      exact okLaw _ _ (getAt k hk) (same _ (by simp))
  · intro pre v post other split preSame vAxes differ
    subst split
    have lengths : (pre ++ v :: post).length = pre.length + 1 + post.length := by
      simp only [List.length_append, List.length_cons]; omega
    have vGet : tupleGet (first :: (pre ++ v :: post)) (int (2 + (pre.length : Int))) =
        pure v := by
      have := getAt pre.length (by rw [lengths]; omega)
      rw [this, List.getElem_append_right (Nat.le_refl _)]
      simp
    obtain ⟨message, bad⟩ := badLaw _ v other vGet vAxes differ
    refine ⟨message, ?_⟩
    rw [unfolded, lengths, nativePositions_split,
      forInUnitError body _ _ _ _ ?front bad]
    · rfl
