theorem observationArgumentsPrepend {S A V D C R I N : Type}
    (ops : OffsetOps (OffsetState S) A V C R I N)
    (arg : OffsetArgument A V D C) (rest : List (OffsetArgument A V D C))
    (before middle : S)
