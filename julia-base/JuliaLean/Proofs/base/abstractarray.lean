theorem g3tg_divmod_next (position columns : Nat) (positive : 0 < columns) :
    (position + 1) / columns =
        (if position % columns + 1 = columns then position / columns + 1
          else position / columns) ∧
    (position + 1) % columns =
        (if position % columns + 1 = columns then 0 else position % columns + 1) := by
  have decomposition : position + 1 =
      (position % columns + 1) + columns * (position / columns) := by
    have h := Nat.mod_add_div position columns
    omega
  have quotient : (position + 1) / columns =
      (position % columns + 1) / columns + position / columns := by
    rw [decomposition, Nat.add_mul_div_left _ _ positive]
  have remainder : (position + 1) % columns = (position % columns + 1) % columns := by
    rw [decomposition, Nat.add_mul_mod_self_left]
  by_cases carry : position % columns + 1 = columns
  · simp only [carry, ite_true]
    rw [carry, Nat.div_self positive] at quotient
    rw [carry, Nat.mod_self] at remainder
    exact ⟨by omega, remainder⟩
  · have small : position % columns + 1 < columns := by
      have h := Nat.mod_lt position positive
      omega
    simp only [carry, ite_false]
    rw [Nat.div_eq_of_lt small] at quotient
    rw [Nat.mod_eq_of_lt small] at remainder
    exact ⟨by omega, remainder⟩

def g3tg_next (columns row column : I64) : I64 × I64 :=
  let nextColumn := column + int 1
  if nextColumn.val > columns.val then (row + int 1, int 1)
  else (row, nextColumn)

def g3tg_coordinates (columns position : Nat) : I64 × I64 :=
  (int (((position / columns : Nat) : Int) + (1 : Int)),
    int (((position % columns : Nat) : Int) + (1 : Int)))

theorem g3tg_next_coordinates (columns : I64) (position : Nat)
    (positive : 0 < columns.val) (small : position ≤ 32) :
    g3tg_next columns (g3tg_coordinates columns.val.toNat position).1
        (g3tg_coordinates columns.val.toNat position).2 =
      g3tg_coordinates columns.val.toNat (position + 1) := by
  let count := columns.val.toNat
  have countPositive : 0 < count := by dsimp only [count]; omega
  have countValue : (count : Int) = columns.val := by dsimp only [count]; omega
  have boundedQuotient : position / count ≤ 32 :=
    Nat.le_trans (Nat.div_le_self position count) small
  have boundedRemainder : position % count ≤ 32 :=
    Nat.le_trans (Nat.mod_le position count) small
  have nextColumnValue :
      (int (((position % count : Nat) : Int) + (1 : Int)) + int 1).val =
        ((position % count : Nat) : Int) + (2 : Int) := by
    rw [g3_native_add, g3_native_val_int _ (by omega) (by omega)]
    omega
  obtain ⟨quotient, remainder⟩ := g3tg_divmod_next position count countPositive
  by_cases carry : position % count + 1 = count
  · simp only [carry, ite_true] at quotient remainder
    have branch : (int (((position % count : Nat) : Int) + (1 : Int)) + int 1).val > columns.val := by
      rw [nextColumnValue]
      omega
    change g3tg_next columns (int (((position / count : Nat) : Int) + (1 : Int)))
        (int (((position % count : Nat) : Int) + (1 : Int))) =
        g3tg_coordinates count (position + 1)
    simp only [g3tg_next]
    rw [if_pos branch]
    simp only [g3tg_coordinates,
      quotient, remainder, Int.natCast_add, Int.natCast_one, Int.natCast_zero, Int.zero_add, g3_native_add]
  · simp only [carry, ite_false] at quotient remainder
    have remSmall : position % count + 1 < count := by
      have h := Nat.mod_lt position countPositive
      omega
    have branch : ¬ (int (((position % count : Nat) : Int) + (1 : Int)) + int 1).val > columns.val := by
      rw [nextColumnValue]
      omega
    change g3tg_next columns (int (((position / count : Nat) : Int) + (1 : Int)))
        (int (((position % count : Nat) : Int) + (1 : Int))) =
        g3tg_coordinates count (position + 1)
    simp only [g3tg_next]
    rw [if_neg branch]
    simp only [g3tg_coordinates,
      quotient, remainder, Int.natCast_add, Int.natCast_one, g3_native_add]

def g3tg_counterLoop {m : Type → Type} [Monad m] {E : Type}
    (set : I64 → I64 → E → m Unit) (read : Nat → m E) (columns : I64)
    (keys : List Nat) (row column : I64) : m Unit := do
  let mut i := row
  let mut j := column
  for key in keys do
    set i j (← read key)
    j := j + int 1
    if j.val > columns.val then
      i := i + int 1
      j := int 1

theorem g3tg_counterLoop_nil {m : Type → Type} [Monad m] [LawfulMonad m] {E : Type}
    (set : I64 → I64 → E → m Unit) (read : Nat → m E) (columns row column : I64) :
    g3tg_counterLoop set read columns [] row column = pure () := by
  simp only [g3tg_counterLoop, List.forIn_nil, pure_bind]

theorem g3tg_counterLoop_cons {m : Type → Type} [Monad m] [LawfulMonad m] {E : Type}
    (set : I64 → I64 → E → m Unit) (read : Nat → m E) (columns row column : I64)
    (key : Nat) (keys : List Nat) :
    g3tg_counterLoop set read columns (key :: keys) row column = (do
      set row column (← read key)
      let next := g3tg_next columns row column
      g3tg_counterLoop set read columns keys next.1 next.2) := by
  simp only [g3tg_counterLoop, List.forIn_cons, bind_assoc, pure_bind, g3tg_next,
    g3_ite_bind]
  by_cases branch : (column + int 1).val > columns.val
  · simp only [branch, ite_true]
  · simp only [branch, ite_false]


theorem g3tg_counter_requests {m : Type → Type} [Monad m] [LawfulMonad m]
    {Ty Ref E : Type} (runtime : TypedHvcatArrayRuntime m Ty Ref E)
    (a : NativeMatrix Ty Ref) (read : Nat → m E) (value : Nat → E)
    (positive : 0 < a.columns.val) (position count : Nat)
    (small : position + count ≤ 32)
    (reads : ∀ key ∈ List.range' position count, read key = pure (value key)) :
    (do
      g3tg_counterLoop (runtime.set2 a) read a.columns (List.range' position count)
        (g3tg_coordinates a.columns.val.toNat position).1
        (g3tg_coordinates a.columns.val.toNat position).2
      pure a) =
    g11thStores runtime a ((List.range' position count).map fun key =>
      G11THStore.cartesian (g3tg_coordinates a.columns.val.toNat key).1
        (g3tg_coordinates a.columns.val.toNat key).2 (value key)) := by
  induction count generalizing position with
  | zero =>
      simp only [List.range'_zero, List.map_nil, g3tg_counterLoop_nil,
        pure_bind, g11thStores]
  | succ count ih =>
      have first := reads position (by
        rw [List.range'_succ]
        exact List.mem_cons_self ..)
      have rest : ∀ key ∈ List.range' (position + 1) count, read key = pure (value key) := by
        intro key hkey
        apply reads key
        rw [List.range'_succ]
        exact List.mem_cons_of_mem _ hkey
      have next := g3tg_next_coordinates a.columns position positive (by omega)
      have tail := ih (position + 1) (by omega) rest
      rw [List.range'_succ, g3tg_counterLoop_cons, next]
      simp only [first, pure_bind, bind_assoc, List.map_cons, g11thStores, g11thStore]
      rw [tail]

theorem g3tg_generated_source {m : Type → Type} [Monad m] [LawfulMonad m]
    [MonadExceptOf ArrayError m] {Ty Ref E : Type}
    (runtime : TypedHvcatArrayRuntime m Ty Ref E) (a : NativeMatrix Ty Ref)
    (xs : MachineTuple E) (small : xs.values.length ≤ 32)
    (count : (a.rows * a.columns).val = (xs.values.length : Int)) :
    (do numericFill (g11thFillRuntime runtime) true 2 a true xs; pure a) =
      (do
        g3tg_counterLoop (runtime.set2 a)
          (fun key => numericFromResult (tupleGet xs.values (int ((key : Int) + 1))))
          a.columns (List.range xs.values.length) (int 1) (int 1)
        pure a) := by
  have sizeOne : (g11thFillRuntime runtime).size a (int 1) = pure a.rows := rfl
  have sizeTwo : (g11thFillRuntime runtime).size a (int 2) = pure a.columns := rfl
  have short : ¬ xs.values.length > 32 := by omega
  simp only [numericFill, hvncatFill, Bool.not_true, Bool.false_eq_true,
    ite_false, short, sizeOne, sizeTwo, pure_bind, count, bne_self_eq_false,
    show (2 : Nat) ≤ 2 from Nat.le_refl _, ite_true, g3tg_counterLoop]
  rfl


theorem g3tg_generated_eq {m : Type → Type} [Monad m] [LawfulMonad m]
    [MonadExceptOf ArrayError m] {Ty Ref E : Type}
    (runtime : TypedHvcatArrayRuntime m Ty Ref E) (a : NativeMatrix Ty Ref)
    (xs : MachineTuple E) (small : xs.values.length ≤ 32)
    (valid : HvcatDimensionsValid a.rows.val a.columns.val)
    (count : a.rows.val * a.columns.val = (xs.values.length : Int)) :
    (do numericFill (g11thFillRuntime runtime) true 2 a true xs; pure a) =
      g11thStores runtime a (xs.values.zipIdx.map fun (value, position) =>
        G11THStore.cartesian
          (int (((position / a.columns.val.toNat : Nat) : Int) + 1))
          (int (((position % a.columns.val.toNat : Nat) : Int) + 1)) value) := by
  have nativeCount : (a.rows * a.columns).val = (xs.values.length : Int) :=
    (g1hv_matrix_product_value a.rows a.columns valid).trans count
  rw [g3tg_generated_source runtime a xs small nativeCount]
  cases values : xs.values with
  | nil =>
      simp only [List.length_nil, List.range_zero, g3tg_counterLoop_nil,
        pure_bind, List.zipIdx_nil, List.map_nil, g11thStores]
  | cons first rest =>
      rw [← values]
      have nonempty : 0 < xs.values.length := by
        rw [values]
        exact Nat.zero_lt_succ _
      have positive : 0 < a.columns.val := by
        have nonnegative := valid.2.2.1
        by_cases positive : 0 < a.columns.val
        · exact positive
        · have zero : a.columns.val = 0 := by omega
          rw [zero, Int.mul_zero] at count
          omega
      let value : Nat → E := fun key => (xs.values[key]?).getD first
      have reads : ∀ key ∈ List.range' 0 xs.values.length,
          (numericFromResult (tupleGet xs.values (int ((key : Int) + 1))) : m E) =
            pure (value key) := by
        intro key hkey
        have hlt : key < xs.values.length := by
          apply List.mem_range.mp
          simpa only [List.range_eq_range'] using hkey
        rw [← g3_native_add, g3_tuple_get_key xs key hlt]
        dsimp only [numericFromResult, value]
        rw [List.getElem?_eq_getElem hlt]
        rfl
      have walk := g3tg_counter_requests runtime a
        (fun key => numericFromResult (tupleGet xs.values (int ((key : Int) + 1))))
        value positive 0 xs.values.length (by omega) reads
      simp only [← List.range_eq_range', g3tg_coordinates, Nat.zero_div,
        Nat.zero_mod, Int.natCast_zero, Int.zero_add] at walk
      have requests : (List.range xs.values.length).map
          (fun key => G11THStore.cartesian
            (int (((key / a.columns.val.toNat : Nat) : Int) + 1))
            (int (((key % a.columns.val.toNat : Nat) : Int) + 1)) (value key)) =
          xs.values.zipIdx.map (fun (selected, position) => G11THStore.cartesian
            (int (((position / a.columns.val.toNat : Nat) : Int) + 1))
            (int (((position % a.columns.val.toNat : Nat) : Int) + 1)) selected) := by
        rw [← g3_range_getD_zipIdx xs.values first]
        simp only [List.map_map, Function.comp_def, value]
      rw [requests] at walk
      exact walk


