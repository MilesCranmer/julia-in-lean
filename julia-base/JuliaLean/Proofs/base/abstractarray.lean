def EmptyHvncatBalancedAllocation (dimensions : List I64) : Prop :=
  2 ≤ dimensions.length ∧
  (∀ dimension ∈ dimensions, 0 < dimension.val ∧ dimension.val < (2 : Int)^63 - 1) ∧
  emptyHvncatMathematicalProduct dimensions ≤ (2 : Int)^63 - 1

