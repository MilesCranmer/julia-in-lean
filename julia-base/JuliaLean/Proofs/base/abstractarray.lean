/-- An arbitrary raw allocator may change its World before success or error. -/
abbrev EmptyHvncatPrimitive (World Value : Type) := World → Result Value × World

/-- Only the actual raw allocation attempt and its returned result are logged. -/
inductive EmptyHvncatEvent (Ty Ref : Type) where
  | allocateRef (elementType : Ty) (dimensions : MachineTuple I64)
      (count : I64) (result : Result Ref)

/-- The World and allocation log survive errors. The final field separately
records the World returned by the last actual primitive. -/
abbrev EmptyHvncatTraceM (World Ty Ref : Type) :=
  ExceptT ArrayError (StateM (World × List (EmptyHvncatEvent Ty Ref) × Option World))

/-- Observe the permitted primitive without giving it access to the log or
audit state, and without assuming any allocator correctness law. -/
def emptyHvncatObserveRuntime {World Ty Ref : Type}
    (runtime : EmptyHvncatRuntime (EmptyHvncatPrimitive World) Ty Ref) :
    EmptyHvncatRuntime (EmptyHvncatTraceM World Ty Ref) Ty Ref where
  allocateRef := fun elementType dimensions count =>
    ExceptT.mk fun (world, events, _lastWorld) =>
      let (result, nextWorld) := runtime.allocateRef elementType dimensions count world
      (result, (nextWorld,
        events ++ [.allocateRef elementType dimensions count result], some nextWorld))

