  simp only [observeVectorSlice, Bool.false_eq_true, ite_false, firstVectorN]
  cases hn : (negative requested).run world with
  | mk result firstWorld =>
    cases result with
    | error error =>
      simp only [observationRunBind, observationRecordRun, hn]
      exact ⟨⟨rfl, rfl⟩, Or.inl ⟨error, rfl, rfl⟩⟩
    | ok tag =>
      cases tag with
      | rejected outside =>
        simp only [observationRunBind, observationRecordRun, hn, assertType,
          observationRunThrow]
        exact ⟨⟨rfl, rfl⟩, Or.inr (Or.inl ⟨outside, rfl, rfl⟩)⟩
      | accepted condition =>
        cases condition with
        | true =>
          simp only [observationRunBind, observationRecordRun, hn, assertType,
