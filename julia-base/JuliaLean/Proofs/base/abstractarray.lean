  intro E destIndices srcIndices read destinationId sourcePointer copy
    dstart sstart n values log
  have zero : (int 0).val = 0 := rfl
  refine ⟨?_, ?_, ?_, ?_⟩
  · intro hzero
    simp [countedArrayCopyTrace, copytoArrayN,
      JuliaLean.Proofs.base.int.eqSame_eq, zero, hzero, StateT.run, StateT.pure]
  · intro hneg
    have nonzero : n.val ≠ 0 := by omega
    simp [countedArrayCopyTrace, copytoArrayN,
      JuliaLean.Proofs.base.int.eqSame_eq, JuliaLean.Proofs.base.int.ltSame_eq,
      zero, nonzero, hneg, StateT.run, StateT.bind, StateT.lift, throwThe,
      MonadExceptOf.throw, StateT.instMonadExceptOf]
  · intro hpos bad
    have nonzero : n.val ≠ 0 := by omega
    have nonneg : ¬ n.val < 0 := by omega
    by_cases inside : destIndices.first.val ≤ dstart.val ∧ dstart.val ≤ destIndices.last.val
    · have short : ¬ n.val ≤ wrapInt .i64 (wrapInt .i64
          (destIndices.last.val - dstart.val) + (int 1).val) := fun h =>
        bad ⟨inside.1, inside.2, h⟩
      have dlt : ¬ destIndices.last.val < dstart.val := by omega
      have dflt : ¬ dstart.val < destIndices.first.val := by omega
      have shortLt : wrapInt .i64 (wrapInt .i64
          (destIndices.last.val - dstart.val) + (int 1).val) < n.val := by omega
      simp [countedArrayCopyTrace, copytoArrayN,
        JuliaLean.Proofs.base.int.eqSame_eq, JuliaLean.Proofs.base.int.ltSame_eq,
        JuliaLean.Proofs.base.int.leSame_eq, copyLinearBounds_formula,
        zero, nonzero, nonneg, inside, short, dlt, dflt, shortLt, StateT.run,
        StateT.bind, StateT.lift, StateT.pure]
