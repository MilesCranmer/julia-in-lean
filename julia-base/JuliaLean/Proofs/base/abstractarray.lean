theorem g2AllSuccess_bind_keep {W X Y : Type} (pre : X → Prop) (post : Y → Prop)
    (action : Boundary W X) (next : X → Boundary W Y)
    (valid : g2AllSuccess pre action)
    (nextValid : ∀ x, pre x → g2AllSuccess post (next x)) :
    g2AllSuccess post (action >>= next) := by
  intro w y h
  rcases ha : action w with ⟨reply, w'⟩
  cases reply with
  | error e =>
      simp only [g2Boundary_bind, ha] at h
      cases h
  | ok x =>
      simp only [g2Boundary_bind, ha] at h
      exact nextValid x (valid w x (by simp only [ha])) w' y h

theorem g2ArgumentFoldAt_post {W Acc Value : Type} (post : Acc → Prop)
    (op : Acc → Value → Boundary W Acc)
    (valid : ∀ a value, g2AllSuccess post (op a value))
    (a : Acc) (bs : PromotionArgs Value) (i : I64) :
    g2AllSuccess post (argumentFoldAt op a bs i) := by
  unfold argumentFoldAt
  cases tupleGet bs.values i with
  | error e =>
      intro world output h
      simp only [g2Boundary_bind, g2Boundary_throw] at h
      cases h
  | ok value =>
      simp only [pure_bind]
      exact valid a value

theorem g2ArgumentFoldTail_post {W Acc Value : Type} (post : Acc → Prop)
    (op : Acc → Value → Boundary W Acc)
    (valid : ∀ a value, g2AllSuccess post (op a value))
    (bs : PromotionArgs Value) (stop : I64) (fuel : Nat) (i : I64)
    (nonnegative : 0 ≤ i.val) (exactFuel : fuel = (stop.val - i.val + 1).toNat)
    (a : Acc) (initial : post a) :
    g2AllSuccess post (argumentFoldTail op bs stop fuel i nonnegative exactFuel a) := by
  induction fuel generalizing i a with
  | zero => exact g2AllSuccess_pure post a initial
  | succ fuel ih =>
      unfold argumentFoldTail
      apply g2AllSuccess_bind_keep (pre := post)
      · exact g2ArgumentFoldAt_post post op valid a bs i
      · intro next nextValid
        split
        · exact g2AllSuccess_pure post next nextValid
        · exact ih _ _ _ _ nextValid

theorem g2AllSuccess_ite {W X : Type} (post : X → Prop)
    (condition : Prop) [Decidable condition] (yes no : Boundary W X)
    (yesValid : g2AllSuccess post yes) (noValid : g2AllSuccess post no) :
    g2AllSuccess post (if condition then yes else no) := by
  by_cases h : condition
  · rw [if_pos h]
    exact yesValid
  · rw [if_neg h]
    exact noValid

