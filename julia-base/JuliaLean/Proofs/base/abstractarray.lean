/-! ## Linear to Cartesian conversion: _ind2sub and _ind2sub_recurse -/

/-- Source `_ind2sub_recurse` over native unit-range axes `(first, length)`:
`_ind2sub_recurse(())`, the one-axis method and the general method, with
`_indexlength`, `_lookup` and the foreign Int `divrem`. -/
def sourceInd2subRanges (divrem : I64 → I64 → Result (I64 × I64)) :
    List (I64 × I64) → I64 → Result (List I64)
  | [], ind => ind2subRecurseEmpty (fun i => pure (i + int 1)) ind
  | [r], ind => ind2subRecurseLast (fun xs => tupleGet xs (int 1))
      (lookupRange (fun r : I64 × I64 => pure r.1) (fun i o => pure (i + o))) [r] ind
  | r :: s :: rs, ind => ind2subRecurse (fun xs => tupleGet xs (int 1))
      (indexLengthRange (fun r : I64 × I64 => pure r.2)) divrem
      (lookupRange (fun r : I64 × I64 => pure r.1) (fun i o => pure (i + o)))
      (fun xs => pure xs.tail) (fun _ i => sourceInd2subRanges divrem (s :: rs) i)
      (r :: s :: rs) ind
termination_by axes _ => axes.length

/-- Source `_ind2sub_recurse` over integer dimensions, with `_indexlength(d) = d`
and `_lookup(ind, d) = ind + 1`. -/
def sourceInd2subDims (divrem : I64 → I64 → Result (I64 × I64)) :
    List I64 → I64 → Result (List I64)
  | [], ind => ind2subRecurseEmpty (fun i => pure (i + int 1)) ind
  | [d], ind => ind2subRecurseLast (fun xs => tupleGet xs (int 1))
      (lookupInteger (fun i => pure (i + int 1))) [d] ind
  | d :: e :: ds, ind => ind2subRecurse (fun xs => tupleGet xs (int 1))
      (fun d => pure (indexLengthInteger d)) divrem
      (lookupInteger (fun i => pure (i + int 1)))
      (fun xs => pure xs.tail) (fun _ i => sourceInd2subDims divrem (e :: ds) i)
      (d :: e :: ds) ind
termination_by dims _ => dims.length

/-- Source `_sub2ind_recurse` over integer dimensions, with `nextL(L, l) = L*l`
and `offsetin(i, l) = i - 1`. -/
def sourceSubscriptDims (dims : List I64) (stride index : I64)
    (is : List I64) : Result I64 :=
  match dims, is with
  | _, [] => pure (sub2indRecurseDone dims stride index)
  | [], i :: is =>
      sub2indRecurseEmpty (fun a b : I64 => pure (a - b))
        (fun a b : I64 => pure (a * b)) (fun a b : I64 => pure (a + b))
        (fun _ l j _ => sourceSubscriptDims [] l j is) stride index i is
  | d :: ds, i :: is =>
      sub2indRecurse (fun xs => tupleGet xs (int 1)) (fun xs => pure xs.tail)
        (nextLInteger (fun a b : I64 => pure (a * b)))
        (offsetinInteger (fun a b : I64 => pure (a - b)))
        (fun a b : I64 => pure (a * b)) (fun a b : I64 => pure (a + b))
        (fun ds l j _ => sourceSubscriptDims ds l j is) (d :: ds) stride index i is
termination_by is.length

/-- The documented `divrem` of two Ints, for a nonnegative dividend and a
positive divisor. -/
def DivremLaw (divrem : I64 → I64 → Result (I64 × I64)) : Prop :=
  ∀ x y : I64, 0 ≤ x.val → 0 < y.val →
    divrem x y = .ok (int (x.val / y.val), int (x.val % y.val))

/-- The number of elements of an array with these axes. -/
def axesCount : List (I64 × I64) → Int
  | [] => 1
  | r :: rs => r.2.val * axesCount rs

theorem column_major_split (A L O n : Int) :
    A + O % n * L + O / n * (L * n) = A + O * L := by
  have split := congrArg (· * L) (Int.emod_add_ediv_mul O n)
  simp only [Int.add_mul] at split
  have swap : O / n * n * L = O / n * (L * n) := by
    rw [Int.mul_assoc, Int.mul_comm n L]
  omega

/-- Each subscript lies in its axis. -/
def coordsWithin : List I64 → List (I64 × I64) → Prop
  | [], [] => True
  | c :: cs, r :: rs => (r.1.val ≤ c.val ∧ c.val ≤ r.1.val + r.2.val - 1) ∧ coordsWithin cs rs
  | _, _ => False

/-- Each subscript lies between one and its dimension. -/
def dimsWithin : List I64 → List I64 → Prop
  | [], [] => True
  | c :: cs, d :: ds => (1 ≤ c.val ∧ c.val ≤ d.val) ∧ dimsWithin cs ds
  | _, _ => False

theorem dimsWithin_of_axes : ∀ (cs ds : List I64),
    coordsWithin cs (ds.map fun d => (int 1, d)) → dimsWithin cs ds
  | [], [], _ => trivial
  | [], _ :: _, h => by simp [coordsWithin] at h
  | _ :: _, [], h => by simp [coordsWithin] at h
  | c :: cs, d :: ds, h => by
    have one : (int 1).val = 1 := rfl
    simp only [List.map_cons, coordsWithin, one] at h
    exact ⟨⟨h.1.1, by omega⟩, dimsWithin_of_axes cs ds h.2⟩

theorem ind2subRanges_inverse (divrem : I64 → I64 → Result (I64 × I64))
    (law : DivremLaw divrem) : ∀ (axes : List (I64 × I64)),
    (∀ r ∈ axes, 0 < r.2.val) → ∀ (O : Int), 0 ≤ O → O ≤ 9223372036854775807 →
    ∀ (A L : Int), ∃ coords, sourceInd2subRanges divrem axes (int O) = .ok coords ∧
      sourceSubscriptRanges axes (int L) (int A) coords = .ok (int (A + O * L)) ∧
      (axes ≠ [] → O < axesCount axes →
        (∀ r ∈ axes, r.1.val + r.2.val - 1 ≤ 9223372036854775807) →
        coordsWithin coords axes)
  | [], _, O, low, high, A, L => by
    refine ⟨[int O + int 1], by simp [sourceInd2subRanges, ind2subRecurseEmpty], ?_,
      fun nonempty => absurd rfl nonempty⟩
    simp only [sourceSubscriptRanges, sub2indRecurseEmpty, sub2indRecurseDone]
    simp [nativeAddSubCancel, nativeStrideMul, vcatNativeAdd, vcatNativeSub]
  | [r], positive, O, low, high, A, L => by
    have one : (int 1).val = 1 := rfl
    have oValue : (int O).val = O := native_val_int _ (by omega) high
    refine ⟨[int O + r.1], by
      simp [sourceInd2subRanges, ind2subRecurseLast, tupleGet, one, lookupRange], ?_, ?_⟩
    · simp only [sourceSubscriptRanges, sub2indRecurse, sub2indRecurseDone]
      simp [tupleGet, one, nextLRange, offsetinRange, nativeAddSubCancel, nativeStrideMul,
        vcatNativeAdd]
    · intro _ inside fits
      have rRange := r.1.property
      simp [IntTy.min, IntTy.max, IntTy.signed, IntTy.bits] at rRange
      have fit := fits r (by simp)
      simp only [axesCount, Int.mul_one] at inside
      have value : (int O + r.1).val = O + r.1.val := by
        rw [← native_int_val r.1, vcatNativeAdd, native_val_int _ (by omega) (by omega),
          native_int_val]
      exact ⟨⟨by rw [value]; omega, by rw [value]; omega⟩, trivial⟩
  | r :: s :: rs, positive, O, low, high, A, L => by
    have one : (int 1).val = 1 := rfl
    have oValue : (int O).val = O := native_val_int _ (by omega) high
    have n := positive r (by simp)
    have quotLow : 0 ≤ O / r.2.val := Int.ediv_nonneg low (by omega)
    have quotHigh : O / r.2.val ≤ 9223372036854775807 :=
      Int.le_trans (Int.ediv_le_self _ low) high
    obtain ⟨coords, run, back, bounds⟩ := ind2subRanges_inverse divrem law (s :: rs)
      (fun x hx => positive x (by simp [hx])) (O / r.2.val) quotLow quotHigh
      (A + O % r.2.val * L) (L * r.2.val)
    have split : divrem (int O) r.2 = .ok (int (O / r.2.val), int (O % r.2.val)) := by
      rw [law _ _ (by rw [oValue]; exact low) n, oValue]
    refine ⟨(int (O % r.2.val) + r.1) :: coords, ?_, ?_, ?_⟩
    · simp only [sourceInd2subRanges, ind2subRecurse]
      simp [tupleGet, one, indexLengthRange, lookupRange, split, run]
    · have strideEq : int L * r.2 = int (L * r.2.val) := by
        rw [← nativeStrideMul, native_int_val]
      have indexEq : int A + (int (O % r.2.val) + r.1 - r.1) * int L =
          int (A + O % r.2.val * L) := by
        rw [nativeAddSubCancel, nativeStrideMul, vcatNativeAdd]
      simp only [sourceSubscriptRanges, sub2indRecurse]
      simp [tupleGet, one, nextLRange, offsetinRange, strideEq, indexEq, back,
        column_major_split]
    · intro _ inside fits
      have rRange := r.1.property
      simp [IntTy.min, IntTy.max, IntTy.signed, IntTy.bits] at rRange
      have fit := fits r (by simp)
      have remLow : 0 ≤ O % r.2.val := Int.emod_nonneg _ (by omega)
      have remHigh : O % r.2.val < r.2.val := Int.emod_lt_of_pos _ n
      have value : (int (O % r.2.val) + r.1).val = O % r.2.val + r.1.val := by
        rw [← native_int_val r.1, vcatNativeAdd, native_val_int _ (by omega) (by omega),
          native_int_val]
      have restCount : O / r.2.val < axesCount (s :: rs) := by
        simp only [axesCount] at inside
        exact Int.ediv_lt_of_lt_mul n (by rw [Int.mul_comm]; exact inside)
      exact ⟨⟨by rw [value]; omega, by rw [value]; omega⟩,
        bounds (by simp) restCount (fun x hx => fits x (by simp [hx]))⟩

/-- `_ind2sub(inds, ind)` and `_sub2ind(inds, I...)` are inverse column-major
conversions: for unit-range axes of positive length, every positive linear index
converts to Cartesian subscripts that convert back to it, and an in-bounds linear
index (at most the element count) yields subscripts inside every axis. -/
def LinearCartesianRoundTrip : Prop :=
  ∀ (divrem : I64 → I64 → Result (I64 × I64)), DivremLaw divrem →
  ∀ (axes : List (I64 × I64)) (ind : I64), (∀ r ∈ axes, 0 < r.2.val) → 1 ≤ ind.val →
    ∃ coords, ind2subAxes (fun i => pure (i - int 1)) (sourceInd2subRanges divrem) axes ind =
        .ok coords ∧
      sub2indAxes sourceSubscriptRanges axes coords = .ok ind ∧
      (axes ≠ [] → ind.val ≤ axesCount axes →
        (∀ r ∈ axes, r.1.val + r.2.val - 1 ≤ 9223372036854775807) →
        coordsWithin coords axes)

theorem linearCartesianRoundTrip_proven : LinearCartesianRoundTrip := by
  intro divrem law axes ind positive low
  have indRange := ind.property
  simp [IntTy.min, IntTy.max, IntTy.signed, IntTy.bits] at indRange
  obtain ⟨coords, run, back, bounds⟩ := ind2subRanges_inverse divrem law axes positive
    (ind.val - 1) (by omega) (by omega) 1 1
  have offset : ind - int 1 = int (ind.val - 1) := by
    rw [← vcatNativeSub, native_int_val]
  refine ⟨coords, ?_, ?_, fun nonempty inside fits => bounds nonempty (by omega) fits⟩
  · simp [ind2subAxes, offset, run]
  · have total : int (1 + (ind.val - 1) * 1) = ind := by
      rw [show 1 + (ind.val - 1) * 1 = ind.val by omega, native_int_val]
    simp only [sub2indAxes]
    rw [back, total]

theorem sourceInd2subDims_ranges (divrem : I64 → I64 → Result (I64 × I64)) :
    ∀ (dims : List I64) (ind : I64),
      sourceInd2subDims divrem dims ind =
        sourceInd2subRanges divrem (dims.map fun d => (int 1, d)) ind
  | [], ind => by simp [sourceInd2subDims, sourceInd2subRanges]
  | [d], ind => by
    have one : (int 1).val = 1 := rfl
    simp [sourceInd2subDims, sourceInd2subRanges, ind2subRecurseLast, tupleGet, one,
      lookupInteger, lookupRange]
  | d :: e :: ds, ind => by
    have one : (int 1).val = 1 := rfl
    have rest := fun i => sourceInd2subDims_ranges divrem (e :: ds) i
    simp only [sourceInd2subDims, sourceInd2subRanges, List.map_cons]
    simp only [List.map_cons] at rest
    simp [ind2subRecurse, tupleGet, one, indexLengthInteger, indexLengthRange, lookupInteger,
      lookupRange, rest]

theorem sourceSubscriptDims_ranges : ∀ (is dims : List I64) (stride index : I64),
    sourceSubscriptDims dims stride index is =
      sourceSubscriptRanges (dims.map fun d => (int 1, d)) stride index is
  | [], dims, stride, index => by
    cases dims <;> simp [sourceSubscriptDims, sourceSubscriptRanges, sub2indRecurseDone]
  | i :: is, [], stride, index => by
    have rest := sourceSubscriptDims_ranges is [] 
    simp only [sourceSubscriptDims, sourceSubscriptRanges, List.map_nil]
    simp [sub2indRecurseEmpty, rest]
  | i :: is, d :: ds, stride, index => by
    have one : (int 1).val = 1 := rfl
    have rest := fun ds => sourceSubscriptDims_ranges is ds
    simp only [sourceSubscriptDims, sourceSubscriptRanges, List.map_cons]
    simp [sub2indRecurse, tupleGet, one, nextLInteger, nextLRange, offsetinInteger,
      offsetinRange, rest]

def dimsCount : List I64 → Int
  | [] => 1
  | d :: ds => d.val * dimsCount ds

theorem dimsCount_axes : ∀ dims : List I64,
    axesCount (dims.map fun d => (int 1, d)) = dimsCount dims
  | [] => rfl
  | d :: ds => by simp [axesCount, dimsCount, dimsCount_axes ds]

/-- `_ind2sub(dims, ind)` and `_sub2ind(dims, I...)` for integer dimensions are
inverse column-major conversions with one-based subscripts: every positive linear
index round-trips, and an in-bounds one gives subscripts `1 ≤ c ≤ d`. -/
def LinearCartesianDimsRoundTrip : Prop :=
  ∀ (divrem : I64 → I64 → Result (I64 × I64)), DivremLaw divrem →
  ∀ (dims : List I64) (ind : I64), (∀ d ∈ dims, 0 < d.val) → 1 ≤ ind.val →
    ∃ coords, ind2subDims (fun i => pure (i - int 1)) (sourceInd2subDims divrem) dims ind =
        .ok coords ∧
      sub2indDims (fun ds l j is => sourceSubscriptDims ds l j is) dims coords = .ok ind ∧
      (dims ≠ [] → ind.val ≤ dimsCount dims →
        dimsWithin coords dims)

theorem linearCartesianDimsRoundTrip_proven : LinearCartesianDimsRoundTrip := by
  intro divrem law dims ind positive low
  obtain ⟨coords, run, back, bounds⟩ := linearCartesianRoundTrip_proven divrem law
    (dims.map fun d => (int 1, d)) ind (fun r hr => by
      simp only [List.mem_map] at hr
      obtain ⟨d, hd, rfl⟩ := hr
      exact positive d hd) low
  have one : (int 1).val = 1 := rfl
  refine ⟨coords, ?_, ?_, ?_⟩
  · simpa [ind2subDims, ind2subAxes, sourceInd2subDims_ranges] using run
  · simpa [sub2indDims, sub2indAxes, sourceSubscriptDims_ranges] using back
  · intro nonempty inside
    have fits : ∀ r ∈ dims.map (fun d => (int 1, d)),
        r.1.val + r.2.val - 1 ≤ 9223372036854775807 := by
      intro r hr
      simp only [List.mem_map] at hr
      obtain ⟨d, _, rfl⟩ := hr
      have dRange := d.property
      simp [IntTy.min, IntTy.max, IntTy.signed, IntTy.bits] at dRange
      show (int 1).val + d.val - 1 ≤ 9223372036854775807
      rw [one]; omega
    have inner := bounds (by simpa using nonempty) (by rw [dimsCount_axes]; exact inside) fits
    exact dimsWithin_of_axes coords dims inner


/-! ## keepat! with a Boolean mask -/

/-- Julia `==` on unit ranges (base/range.jl): two empty ranges are equal, and
nonempty ranges are equal when their endpoints agree. -/
def unitRangeEq (r s : I64 × I64) : Bool :=
  (decide (r.2.val < r.1.val) && decide (s.2.val < s.1.val)) ||
    (decide (r.1 = s.1) && decide (r.2 = s.2))

/-- The foreign scalar `getindex` of a Boolean mask vector. -/
def maskGet (m : OffsetVector Bool) (i : I64) : Result Bool :=
  if m.first.val ≤ i.val then
    match m.values[(i.val - m.first.val).toNat]? with
    | some b => .ok b
    | none => .error (.julia .boundsError)
  else .error (.julia .boundsError)

/-- Source `eachindex(a, m)`: `eachindex(IndexStyle(a, m), a, m)` for two
`IndexLinear` vectors, through `eachindex(::IndexLinear, A, B...)` over the source
`axes1`; the resulting unit range is iterated in order. -/
def sourceEachindexMask {E : Type} (join : String → List String → String)
    (showRange : I64 × I64 → String) (a : Unit) (mask : OffsetVector Bool) :
    VectorRun E (List I64) := fun v =>
  (eachindexTwo (fun (_ : Unit) (_ : OffsetVector Bool) => (pure () : Result Unit))
    (fun (_ : Unit) (a : Unit) (m : OffsetVector Bool) =>
      eachindexLinearMany (B := fun _ : Fin 1 => OffsetVector Bool)
        (eachindexLinearVector (axes1 (fun _ : Unit => pure [offsetVectorAxis v])))
        (fun _ m => eachindexLinearVector
          (axes1 (fun m : OffsetVector Bool => pure [offsetVectorAxis m])) m)
        unitRangeEq
        (fun r rs => throwEachindexMismatch join "indices" (showRange r) (rs.map showRange))
        a (fun _ => m))
    a mask).map fun r => (concatRange r.1 r.2, v)

def sourceKeepAtMask {E : Type} (join : String → List String → String)
    (showRange : I64 × I64 → String) (mask : OffsetVector Bool) : VectorRun E Unit :=
  keepAtMask (fun m => (pure (int (m.values.length : Int)) : VectorRun E I64))
    offsetVectorLength offsetVectorFirstindex offsetVectorLastindex
    (sourceEachindexMask join showRange) (fun m i => StateT.lift (maskGet m i))
    offsetVectorGet offsetVectorSet offsetVectorNextind
    (fun lo hi => pure (lo, hi)) offsetVectorDeleteRange () mask

/-- The elements of `xs` whose mask entry is `true`, in order. -/
def maskKept {E : Type} (xs : List E) (bs : List Bool) : List E :=
  (xs.zip bs).filterMap fun p => if p.2 then some p.1 else none

/-- `keepat!(a, m)` with a Boolean mask is in-place logical indexing `a = a[m]`:
for a mask of equal length and equal axis it keeps exactly the elements where the
mask is `true`, in order, and keeps the first index. A mask of different length
throws `BoundsError`; a mask of equal length on a different axis throws the
`eachindex` `DimensionMismatch`. -/
def KeepAtMaskSelects : Prop :=
  ∀ (E : Type) (join : String → List String → String) (showRange : I64 × I64 → String)
    (v : OffsetVector E) (mask : OffsetVector Bool), v.Room 1 →
    -9223372036854775808 ≤ v.first.val + v.values.length - 1 →
    -9223372036854775808 ≤ mask.first.val + mask.values.length - 1 →
    (mask.values.length : Int) ≤ 9223372036854775807 →
    (sourceKeepAtMask join showRange mask).run v =
      if mask.values.length ≠ v.values.length then .error (.julia .boundsError)
      else if v.values.length ≠ 0 ∧ mask.first ≠ v.first then
        .error (.dimensionMismatch ("all inputs to eachindex must have the same " ++
          "indices" ++ ", got " ++
          join (showRange (offsetVectorAxis v)) [showRange (offsetVectorAxis mask)]))
      else .ok ((), { v with values := maskKept v.values mask.values })

theorem offsetVectorAxis_eq {E : Type} (v : OffsetVector E) :
    offsetVectorAxis v = (v.first, int (v.first.val + v.values.length - 1)) :=
  Prod.ext rfl (offsetVectorAxis_last v)

theorem vrun_bind_error {σ α β : Type} {x : StateT σ Result α} {f : α → StateT σ Result β}
    {s : σ} {e : ArrayError} (h : x s = .error e) : (x >>= f) s = .error e := by
  show StateT.bind x f s = _
  unfold StateT.bind
  rw [h]
  rfl

theorem unitRangeEq_axes {E : Type} (v : OffsetVector E) (mask : OffsetVector Bool)
    (len : mask.values.length = v.values.length) (room : v.Room 1)
    (lastLow : -9223372036854775808 ≤ v.first.val + v.values.length - 1)
    (maskLow : -9223372036854775808 ≤ mask.first.val + mask.values.length - 1) :
    unitRangeEq (offsetVectorAxis v) (offsetVectorAxis mask) =
      !(decide (v.values.length ≠ 0 ∧ mask.first ≠ v.first)) := by
  obtain ⟨lenFits, lastFits⟩ := room
  have firstRange := v.first.property
  have maskRange := mask.first.property
  simp [IntTy.min, IntTy.max, IntTy.signed, IntTy.bits] at firstRange maskRange
  have vLast : (int (v.first.val + v.values.length - 1)).val =
      v.first.val + v.values.length - 1 := native_val_int _ lastLow (by omega)
  rw [offsetVectorAxis_eq v, offsetVectorAxis_eq mask]
  by_cases empty : v.values.length = 0
  · have m0 : (int (mask.first.val + mask.values.length - 1)).val =
        mask.first.val + mask.values.length - 1 :=
      native_val_int _ maskLow (by omega)
    have e1 : v.first.val + v.values.length - 1 < v.first.val := by omega
    have e2 : mask.first.val + mask.values.length - 1 < mask.first.val := by omega
    have e3 : ¬ (v.values.length ≠ 0 ∧ mask.first ≠ v.first) := fun h => h.1 empty
    simp only [unitRangeEq, vLast, m0]
    simp [e1, e2, e3]
    all_goals exact Or.inl (List.eq_nil_of_length_eq_zero empty)
  · by_cases same : mask.first = v.first
    · simp only [unitRangeEq, same]
      simp
      all_goals (right; rw [len])
    · have nonempty : ¬ (v.first.val + v.values.length - 1 < v.first.val) := by omega
      simp only [unitRangeEq, vLast, nonempty, same]
      simp [empty, same, Ne.symm same]

theorem sourceEachindexMask_run {E : Type} (join : String → List String → String)
    (showRange : I64 × I64 → String) (v : OffsetVector E) (mask : OffsetVector Bool)
    (len : mask.values.length = v.values.length) (room : v.Room 1)
    (lastLow : -9223372036854775808 ≤ v.first.val + v.values.length - 1)
    (maskLow : -9223372036854775808 ≤ mask.first.val + mask.values.length - 1) :
    (sourceEachindexMask join showRange () mask : VectorRun E (List I64)) v =
      if v.values.length ≠ 0 ∧ mask.first ≠ v.first then
        .error (.dimensionMismatch ("all inputs to eachindex must have the same " ++
          "indices" ++ ", got " ++
          join (showRange (offsetVectorAxis v)) [showRange (offsetVectorAxis mask)]))
      else .ok (concatRange (offsetVectorAxis v).1 (offsetVectorAxis v).2, v) := by
  have finRange : List.finRange 1 = [0] := by decide
  have one : (int 1).val = 1 := rfl
  have equal := unitRangeEq_axes v mask len room lastLow maskLow
  by_cases bad : v.values.length ≠ 0 ∧ mask.first ≠ v.first
  · have eqFalse : unitRangeEq (offsetVectorAxis v) (offsetVectorAxis mask) = false := by
      rw [equal]; simp [bad]
    rw [if_pos bad]
    simp [sourceEachindexMask, eachindexTwo, eachindexLinearMany, eachindexLinearVector,
      axes1, tupleGet, one, finRange, eqFalse, throwEachindexMismatch, Except.map,
      MonadExceptOf.throw]
  · have eqTrue : unitRangeEq (offsetVectorAxis v) (offsetVectorAxis mask) = true := by
      rw [equal, decide_eq_false bad]; rfl
    rw [if_neg bad]
    simp [sourceEachindexMask, eachindexTwo, eachindexLinearMany, eachindexLinearVector,
      axes1, tupleGet, one, finRange, eqTrue, Except.map]

theorem zip_take_both {E F : Type} : ∀ (xs : List E) (bs : List F) (n : Nat),
    (xs.take n).zip (bs.take n) = (xs.zip bs).take n
  | [], _, n => by simp
  | _ :: _, [], n => by simp
  | _ :: _, _ :: _, 0 => by simp
  | x :: xs, b :: bs, n + 1 => by simp [zip_take_both xs bs n]

theorem maskKept_take_succ {E : Type} (xs : List E) (bs : List Bool) (p : Nat)
    (small : p < xs.length) (smallMask : p < bs.length) :
    maskKept (xs.take (p + 1)) (bs.take (p + 1)) =
      maskKept (xs.take p) (bs.take p) ++ (if bs[p] then [xs[p]] else []) := by
  simp only [maskKept]
  rw [zip_take_both xs bs (p + 1), zip_take_both xs bs p, List.take_succ,
    List.filterMap_append]
  have entry : (xs.zip bs)[p]? = some (xs[p], bs[p]) := by
    rw [List.getElem?_zip_eq_some]
    exact ⟨List.getElem?_eq_getElem small, List.getElem?_eq_getElem smallMask⟩
  rw [entry]
  by_cases bit : bs[p] = true <;> simp [bit]

theorem maskKept_length_le {E : Type} (xs : List E) (bs : List Bool) (p : Nat) :
    (maskKept (xs.take p) (bs.take p)).length ≤ p := by
  simp only [maskKept]
  calc _ ≤ ((xs.take p).zip (bs.take p)).length := List.length_filterMap_le _ _
    _ ≤ p := by simp [List.length_zip]; omega

/-- Loop state of the masked `keepat!` after `p` positions: the next write index
and the kept prefix followed by the untouched suffix. -/
def maskTarget {E : Type} (v : OffsetVector E) (mask : OffsetVector Bool) (p : Nat) :
    I64 × OffsetVector E :=
  (int (v.first.val + (maskKept (v.values.take p) (mask.values.take p)).length),
    { v with values := maskKept (v.values.take p) (mask.values.take p) ++
      v.values.drop (maskKept (v.values.take p) (mask.values.take p)).length })

theorem maskTarget_zero {E : Type} (v : OffsetVector E) (mask : OffsetVector Bool) :
    maskTarget v mask 0 = (v.first, v) := by
  simp [maskTarget, maskKept, native_int_val]

theorem maskTarget_true {E : Type} (v : OffsetVector E) (mask : OffsetVector Bool) (p : Nat)
    (small : p < v.values.length) (smallMask : p < mask.values.length)
    (bit : mask.values[p] = true) :
    maskTarget v mask (p + 1) =
      ((maskTarget v mask p).1 + int 1,
        { v with values := (maskKept (v.values.take p) (mask.values.take p) ++
          v.values[p] :: v.values.drop
            ((maskKept (v.values.take p) (mask.values.take p)).length + 1)) }) := by
  have succ := maskKept_take_succ v.values mask.values p small smallMask
  rw [bit] at succ
  simp only [↓reduceIte] at succ
  simp only [maskTarget, succ, List.length_append, List.length_singleton, vcatNativeAdd,
    List.append_assoc, List.singleton_append]
  congr 2
  push_cast
  omega

theorem maskTarget_false {E : Type} (v : OffsetVector E) (mask : OffsetVector Bool) (p : Nat)
    (small : p < v.values.length) (smallMask : p < mask.values.length)
    (bit : mask.values[p] = false) :
    maskTarget v mask (p + 1) = maskTarget v mask p := by
  have succ := maskKept_take_succ v.values mask.values p small smallMask
  rw [bit] at succ
  simp only [Bool.false_eq_true, ↓reduceIte, List.append_nil] at succ
  simp only [maskTarget, succ]

set_option maxRecDepth 4096 in
theorem keepAtMaskSelects_proven : KeepAtMaskSelects := by
  intro E join showRange v mask room lastLow maskLow maskFits
  have room' := room
  obtain ⟨lenFits, lastFits⟩ := room'
  have firstRange := v.first.property
  simp [IntTy.min, IntTy.max, IntTy.signed, IntTy.bits] at firstRange
  have maskLenValue : (int (mask.values.length : Int)).val = mask.values.length :=
