push boundaries use list contents; the selected rest iterator may have any
array and continuation-state representation. -/
def RestContents : Prop :=
  ∀ (A State E : Type) (remaining : A → State → List E)
    (length : A → I64) (a : A) (state : State),
    restArray (m := Result)
      (fun (_ : Unit) (_ : I64) => pure ([] : List E))
      (fun a => pure (length a)) (fun (_ : List E) (_ : I64) => pure ())
