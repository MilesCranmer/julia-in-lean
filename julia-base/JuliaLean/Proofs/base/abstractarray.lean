    two axes exchanged in the traversal when row-first filling is requested. -/
def GeneratedFillContents : Prop :=
  ∀ (shape values : List Nat) (rowFirst : Bool),
    shape.prod = values.length →
    (∀ n ∈ shape, n ≤ 9223372036854775807) →
    values.length ≤ 9223372036854775807 →
    let rows := shape.getD 0 1
    let columns := shape.getD 1 1
    let block := rows * columns
    let size := fun (_ : Unit) (d : I64) => int (shape.getD (d.val.toNat - 1) 1)
    let count := int values.length
    let valueAt := fun i : I64 => values.getD (i.val.toNat - 1) 0
    let writes := (List.range values.length).map fun k =>
      let address := if rowFirst then
        k / block * block + k % block / columns + k % columns * rows + 1
        else k + 1
      (int address, values.getD k 0)
    (sourceTraceFill true values.length shape.length size (fun _ => int (shape.drop 2).prod)
      count (concatRange (int 1) count) valueAt () rowFirst ()).run [] = .ok ((), writes)

