def g11thValidate {m : Type → Type} [Monad m] [MonadExceptOf ArrayError m]
    (rows : MachineTuple I64) (width : I64) (keys : List I64) : m Unit := do
  for key in keys do
    let actual ← numericFromResult (tupleGet rows.values key)
    if width.val != actual.val then
      throw (.dimensionMismatch ("row " ++ toString key.val ++
        " has mismatched number of columns (expected " ++ toString width.val ++
        ", got " ++ toString (← numericFromResult (tupleGet rows.values key)).val ++ ")"))

theorem g11th_source {m : Type → Type} [Monad m] [LawfulMonad m]
    [MonadExceptOf ArrayError m] {Ty Ref E : Type}
    (runtime : TypedHvcatArrayRuntime m Ty Ref E) (generated : Bool) (t : Ty)
    (rows : MachineTuple I64) (xs : MachineTuple E) :
    typedNumericHvcat runtime generated t rows xs = (do
      let width ← numericFromResult (tupleGet rows.values (int 1))
      g11thValidate rows width ((numericOneTo rows.count).drop 1)
      let a ← g11thMatrix runtime t rows.count width
      JuliaLean.base.abstractarray.Models1Group3.numericFill
        (g11thFillRuntime runtime) generated 2 a true xs
      pure a) := by
  simp only [typedNumericHvcat, typedHvcatNumbers, g11thValidate, pure_bind,
    bind_assoc]
  rfl

theorem g11th_validate_ok {m : Type → Type} [Monad m] [LawfulMonad m]
    [MonadExceptOf ArrayError m] (rows : MachineTuple I64) (width : I64)
    (keys : List I64)
    (reads : ∀ key ∈ keys, ∃ row, tupleGet rows.values key = .ok row ∧ row.val = width.val) :
    (g11thValidate rows width keys : m Unit) = pure () := by
  induction keys with
  | nil => simp only [g11thValidate, List.forIn_nil, pure_bind]
  | cons key keys ih =>
      obtain ⟨row, hread, hequal⟩ := reads key (List.mem_cons_self ..)
      have rest := ih (fun key hkey => reads key (List.mem_cons_of_mem _ hkey))
      simpa only [g11thValidate, List.forIn_cons, hread, numericFromResult,
        pure_bind, hequal, bne_self_eq_false, Bool.false_eq_true, ite_false] using rest

theorem g11th_validate_error {S : Type} (rows : MachineTuple I64) (width : I64)
    (keys : List I64)
    (reads : ∀ key ∈ keys, ∃ row, tupleGet rows.values key = .ok row)
    (bad : ∃ key ∈ keys, ∃ row,
      tupleGet rows.values key = .ok row ∧ row.val ≠ width.val) :
    ∃ message, ∀ state : S,
      (g11thValidate rows width keys : ExceptT ArrayError (StateM S) Unit).run state =
        (.error (.dimensionMismatch message), state) := by
  induction keys with
  | nil =>
      obtain ⟨key, hkey, _⟩ := bad
      cases hkey
  | cons key keys ih =>
      obtain ⟨row, hread⟩ := reads key (List.mem_cons_self ..)
      by_cases hequal : row.val = width.val
      · have restbad : ∃ key ∈ keys, ∃ row,
            tupleGet rows.values key = .ok row ∧ row.val ≠ width.val := by
          obtain ⟨selected, hselected, actual, hactual, hbad⟩ := bad
          rcases List.mem_cons.mp hselected with hsame | hrest
          · subst selected
            rw [hread] at hactual
            cases hactual
            exact False.elim (hbad hequal)
          · exact ⟨selected, hrest, actual, hactual, hbad⟩
        obtain ⟨message, rest⟩ := ih
          (fun key hkey => reads key (List.mem_cons_of_mem _ hkey)) restbad
        refine ⟨message, ?_⟩
        intro state
        simpa only [g11thValidate, List.forIn_cons, hread, numericFromResult,
          pure_bind, hequal, bne_self_eq_false, Bool.false_eq_true, ite_false] using rest state
      · have hne : (width.val != row.val) = true := by
          simp only [bne_iff_ne]
          exact Ne.symm hequal
        refine ⟨"row " ++ toString key.val ++
          " has mismatched number of columns (expected " ++ toString width.val ++
          ", got " ++ toString row.val ++ ")", ?_⟩
        intro state
        simp only [g11thValidate, List.forIn_cons, hread, numericFromResult,
          pure_bind, hne, ite_true]
        rfl

theorem g11th_row_keys (rows : MachineTuple I64) :
    (numericOneTo rows.count).drop 1 =
