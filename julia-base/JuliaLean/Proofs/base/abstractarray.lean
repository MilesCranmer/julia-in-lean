  simp only [numericOneTo, rows.count_eq, Int.toNat_natCast, List.map_drop]

theorem g11th_all_rows_validate {m : Type → Type} [Monad m] [LawfulMonad m]
    [MonadExceptOf ArrayError m] (rows : MachineTuple I64) (width : I64)
    (equal : ∀ row ∈ rows.values, row.val = width.val) :
    (g11thValidate rows width ((numericOneTo rows.count).drop 1) : m Unit) = pure () := by
  apply g11th_validate_ok
  intro key hkey
  rw [g11th_row_keys] at hkey
  obtain ⟨k, hk, rfl⟩ := List.mem_map.mp hkey
  have hlt := List.mem_range.mp (List.mem_of_mem_drop hk)
  exact ⟨rows.values[k], g1hv_tuple_get_key rows k hlt,
    equal _ (List.getElem_mem ..)⟩

theorem g11th_ragged_validate {S : Type} (rows : MachineTuple I64)
    (width : I64) (tail : List I64) (hrows : rows.values = width :: tail)
    (bad : ∃ row ∈ rows.values, row.val ≠ width.val) :
    ∃ message, ∀ state : S,
      (g11thValidate rows width ((numericOneTo rows.count).drop 1) :
        ExceptT ArrayError (StateM S) Unit).run state =
        (.error (.dimensionMismatch message), state) := by
  apply g11th_validate_error
  · intro key hkey
    rw [g11th_row_keys] at hkey
    obtain ⟨k, hk, rfl⟩ := List.mem_map.mp hkey
    have hlt := List.mem_range.mp (List.mem_of_mem_drop hk)
    exact ⟨_, g1hv_tuple_get_key rows k hlt⟩
  · obtain ⟨row, hrow, hbad⟩ := bad
    obtain ⟨k, hk, helem⟩ := List.mem_iff_getElem.mp hrow
    have positive : 0 < k := by
      by_cases hzero : k = 0
      · subst k
        have hsame : width = row := by
          simpa only [hrows, List.getElem_cons_zero] using helem
        exact False.elim (hbad (congrArg Subtype.val hsame).symm)
      · omega
    have hlen : 0 < rows.values.length := by rw [hrows]; simp only [List.length_cons]; omega
    have hmem : k ∈ (List.range rows.values.length).drop 1 := by
      simp only [List.range_eq_range', List.drop_range', Nat.zero_add,
        Nat.mul_one, List.mem_range'_1]
      omega
    refine ⟨int k + int 1, ?_, row, ?_, hbad⟩
    · rw [g11th_row_keys]
      exact List.mem_map.mpr ⟨k, hmem, rfl⟩
    · rw [g1hv_tuple_get_key rows k hk, helem]

theorem g11th_empty_run {World Ty Ref E : Type}
    (runtime : TypedHvcatArrayRuntime (HvcatPrimitive World) Ty Ref E)
