theorem forInLogLoop {α W : Type} (body : α → Unit → StateT (List W) Result (ForInStep Unit))
    (out : α → List W) :
    ∀ xs : List α, (∀ x ∈ xs, ∀ log, (body x ()).run log = pure (.yield (), log ++ out x)) →
      ∀ log, (forIn xs () body).run log = pure ((), log ++ xs.flatMap out)
  | [], _, log => by simp [StateT.run, StateT.pure]
  | x :: xs, h, log => by
    rw [List.forIn_cons, StateT.run_bind, h x (by simp) log, pure_bind]
    show (forIn xs () body).run (log ++ out x) = _
    rw [forInLogLoop body out xs (fun y hy => h y (by simp [hy])) (log ++ out x)]
    simp [List.append_assoc]

