    have tailSplit : v.values.drop (maskKept (v.values.take pre.length)
        (mask.values.take pre.length)).length =
        v.values[(maskKept (v.values.take pre.length)
          (mask.values.take pre.length)).length]'(by omega) ::
        v.values.drop ((maskKept (v.values.take pre.length)
