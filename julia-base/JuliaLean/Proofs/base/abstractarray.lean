  NumericOnlyAllocatedTarget a events ∧
  (numericStoreAttempts events).IsPrefix expected ∧
  NumericFailuresStop result events ∧
  match result with
  | .ok returned => returned = a ∧ numericStoreAttempts events = expected ∧
      ∀ event ∈ events, numericRecordedError event = none
  | .error error =>
      ∃ event, events.getLast? = some event ∧ numericRecordedError event = some error

def G3FillOutcome {Ty A E : Type} (a : A) (expected : List (A × Int × E))
    (result : Result A) (events : List (NumericEvent Ty A E)) : Prop :=
  NumericOnlyAllocatedTarget a events ∧
  (numericStoreAttempts events).IsPrefix expected ∧
  NumericFailuresStop result events ∧
  match result with
  | .ok returned => returned = a ∧ numericStoreAttempts events = expected ∧
      ∀ event ∈ events, numericRecordedError event = none
  | .error error =>
      (∃ event, events.getLast? = some event ∧ numericRecordedError event = some error) ∨
      (∃ message, error = .julia (.argumentError message) ∧ numericStoreAttempts events = [])

theorem g3_failures_nil {Ty A E : Type} (result : Result A) :
    NumericFailuresStop result ([] : List (NumericEvent Ty A E)) := by
  intro before event after error he _
  have hl := congrArg List.length he
  simp only [List.length_nil, List.length_append, List.length_cons] at hl
  omega

theorem g3_failures_singleton {Ty A E : Type} (event : NumericEvent Ty A E)
    (error : ArrayError) (herror : numericRecordedError event = some error) :
    NumericFailuresStop (.error error) [event] := by
  intro before selected after err he hs
  cases before with
  | nil =>
      change [event] = selected :: after at he
      cases he
      rw [herror] at hs
      have hh := Option.some.inj hs
      subst err
      exact ⟨rfl, rfl⟩
  | cons first rest =>
      have hl := congrArg List.length he
      simp only [List.length_nil, List.length_append, List.length_cons] at hl
      omega

theorem g3_failures_cons {Ty A E : Type} (event : NumericEvent Ty A E)
    (events : List (NumericEvent Ty A E)) (result : Result A)
    (herror : numericRecordedError event = none)
    (hrest : NumericFailuresStop result events) :
    NumericFailuresStop result (event :: events) := by
  intro before selected after error he hs
  cases before with
  | nil =>
      change event :: events = selected :: after at he
      cases he
      rw [herror] at hs
      cases hs
  | cons first rest =>
      change event :: events = first :: (rest ++ selected :: after) at he
      exact hrest rest selected after error (List.cons.inj he).2 hs

theorem g3_storeRun_outcome {Ty A E : Type} (a : A) (pairs : List (I64 × E))
    (result : Result A) (events : List (NumericEvent Ty A E))
    (run : G3StoreRun a pairs result events) :
    G3StoreOutcome a (g3_pairStores a pairs) result events := by
  induction run with
  | done =>
      refine ⟨?_, ?_, g3_failures_nil _, rfl, rfl, ?_⟩
      · intro event h
        cases h
      · exact ⟨[], rfl⟩
      · intro event h
        cases h
  | failure index value rest error =>
      refine ⟨?_, ?_, g3_failures_singleton _ error rfl, ?_⟩
      · intro event he
        rcases List.mem_cons.mp he with rfl | he
        · rfl
        · cases he
      · exact ⟨g3_pairStores a rest, rfl⟩
      · exact ⟨_, rfl, rfl⟩
  | step index value rest result events run ih =>
      obtain ⟨htarget, hinitialEvents, hstop, hresult⟩ := ih
      refine ⟨?_, ?_, g3_failures_cons _ _ _ rfl hstop, ?_⟩
      · intro event he
        rcases List.mem_cons.mp he with rfl | he
        · rfl
        · exact htarget event he
      · obtain ⟨suffix, hsuffix⟩ := hinitialEvents
        refine ⟨suffix, ?_⟩
        change (a, index.val, value) :: (numericStoreAttempts events ++ suffix) =
