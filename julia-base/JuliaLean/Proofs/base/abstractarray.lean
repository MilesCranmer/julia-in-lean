theorem g11th_int_val (x : I64) : int x.val = x := by
  apply Subtype.ext
  exact wrapInt_of_inRange .i64 x.val x.property

theorem g11th_stride_next (row stride : I64) (column : Nat) :
    int (row.val + (column : Int) * stride.val) + stride =
      int (row.val + ((column + 1 : Nat) : Int) * stride.val) := by
  calc
    _ = int (row.val + (column : Int) * stride.val) + int stride.val :=
      congrArg (fun value : I64 => int (row.val + (column : Int) * stride.val) + value)
        (g11th_int_val stride).symm
    _ = _ := by
      rw [g1hv_native_add]
      congr 1
      rw [Int.natCast_add, Int.natCast_one, Int.add_mul, Int.one_mul]
      omega

def g11thLinearColumns {m : Type → Type} [Monad m] [MonadExceptOf ArrayError m]
    {Ty Ref E : Type} (runtime : TypedHvcatArrayRuntime m Ty Ref E)
    (a : NativeMatrix Ty Ref) (xs : MachineTuple E) (row : I64) :
    Nat → Nat → Nat → m Nat
  | _, 0, position => pure position
  | column, count + 1, position => do
      let value ← numericFromResult (tupleGet xs.values (int position + int 1))
      runtime.set a (int (row.val + (column : Int) * a.rows.val)) value
      g11thLinearColumns runtime a xs row (column + 1) count (position + 1)

theorem g11th_native_columns {m : Type → Type} [Monad m] [LawfulMonad m]
    [MonadExceptOf ArrayError m] {Ty Ref E : Type}
    (runtime : TypedHvcatArrayRuntime m Ty Ref E) (a : NativeMatrix Ty Ref)
    (xs : MachineTuple E) (row : I64) (iterations : List I64)
    (column position : Nat) :
    (forIn iterations (int position + int 1,
      int (row.val + (column : Int) * a.rows.val))
      (fun _ state => do
        runtime.set a state.2 (← numericFromResult (tupleGet xs.values state.1))
        pure (ForInStep.yield (state.1 + int 1, state.2 + a.rows)))) =
      (do
        let finalPosition ← g11thLinearColumns runtime a xs row column iterations.length position
        pure (int finalPosition + int 1,
          int (row.val + ((column + iterations.length : Nat) : Int) * a.rows.val))) := by
  induction iterations generalizing column position with
  | nil =>
      simp only [List.forIn_nil, List.length_nil, g11thLinearColumns, pure_bind,
        Nat.add_zero]
  | cons ignored iterations ih =>
      simp only [List.forIn_cons, List.length_cons, g11thLinearColumns, bind_assoc,
        pure_bind]
      rw [g1hv_native_successor, g11th_stride_next, ih]
      have hindex : column + 1 + iterations.length = column + (iterations.length + 1) := by omega
      rw [hindex]

def g11thLinearRows {m : Type → Type} [Monad m] [MonadExceptOf ArrayError m]
    {Ty Ref E : Type} (runtime : TypedHvcatArrayRuntime m Ty Ref E)
    (a : NativeMatrix Ty Ref) (xs : MachineTuple E) : List Nat → Nat → m Nat
  | [], position => pure position
  | row :: rows, position => do
      let position ← g11thLinearColumns runtime a xs (int row + int 1)
        0 a.columns.val.toNat position
      g11thLinearRows runtime a xs rows position

theorem g11th_native_rows {m : Type → Type} [Monad m] [LawfulMonad m]
    [MonadExceptOf ArrayError m] {Ty Ref E : Type}
    (runtime : TypedHvcatArrayRuntime m Ty Ref E) (a : NativeMatrix Ty Ref)
    (xs : MachineTuple E) (rows : List Nat) (position : Nat) :
    (forIn (rows.map (fun (row : Nat) => int row + int 1)) (int position + int 1)
      (fun row index => do
        let state ← forIn (numericOneTo a.columns) (index, row)
          (fun _ state => do
            runtime.set a state.2 (← numericFromResult (tupleGet xs.values state.1))
            pure (ForInStep.yield (state.1 + int 1, state.2 + a.rows)))
        pure (ForInStep.yield state.1))) =
      (do
        let finalPosition ← g11thLinearRows runtime a xs rows position
        pure (int finalPosition + int 1)) := by
  induction rows generalizing position with
  | nil =>
      simp only [List.map_nil, List.forIn_nil, g11thLinearRows, pure_bind]
  | cons row rows ih =>
      have hcolumns := g11th_native_columns runtime a xs (int row + int 1)
        (numericOneTo a.columns) 0 position
      have hlength : (numericOneTo a.columns).length = a.columns.val.toNat := by
        simp only [numericOneTo, List.length_map, List.length_range]
      simp only [Nat.zero_add, Int.natCast_zero, Int.zero_mul, Int.add_zero,
        g11th_int_val, hlength] at hcolumns
      simp only [List.map_cons, List.forIn_cons, g11thLinearRows, bind_assoc, pure_bind]
      rw [hcolumns]
      simp only [bind_assoc, pure_bind]
      simp only [ih]

theorem g11th_stores_append {m : Type → Type} [Monad m] [LawfulMonad m]
    {Ty Ref E : Type} (runtime : TypedHvcatArrayRuntime m Ty Ref E)
    (a : NativeMatrix Ty Ref) (first rest : List (G11THStore E)) :
    g11thStores runtime a (first ++ rest) =
      (do let _ ← g11thStores runtime a first; g11thStores runtime a rest) := by
  induction first with
  | nil => simp only [List.nil_append, g11thStores, pure_bind]
  | cons request first ih =>
      simp only [List.cons_append, g11thStores, bind_assoc, ih]

def g11thRowRequests {Ty Ref E : Type} (a : NativeMatrix Ty Ref) (row : I64)
    (column count : Nat) (values : List E) : List (G11THStore E) :=
  ((List.range' column count).zip values).map fun (column, value) =>
    .linear (int (row.val + (column : Int) * a.rows.val)) value

theorem g11th_columns_values {m : Type → Type} [Monad m] [LawfulMonad m]
    [MonadExceptOf ArrayError m] {Ty Ref E : Type}
    (runtime : TypedHvcatArrayRuntime m Ty Ref E) (a : NativeMatrix Ty Ref)
    (xs : MachineTuple E) (row : I64) (column count position : Nat)
    (enough : position + count ≤ xs.values.length) :
    g11thLinearColumns runtime a xs row column count position =
      (do
        let _ ← g11thStores runtime a (g11thRowRequests a row column count (xs.values.drop position))
        pure (position + count)) := by
  induction count generalizing column position with
  | zero =>
      have empty : g11thRowRequests a row column 0 (xs.values.drop position) = [] := rfl
      simp only [g11thLinearColumns, empty, g11thStores, pure_bind, Nat.add_zero]
  | succ count ih =>
      have within : position < xs.values.length := by omega
      have hread := g1hv_tuple_get_key xs position within
      have hdrop := List.drop_eq_getElem_cons within
      have enoughNext : position + 1 + count ≤ xs.values.length := by omega
      have hnext := ih (column + 1) (position + 1) enoughNext
      have countNext : position + 1 + count = position + (count + 1) := by omega
      have requests : g11thRowRequests a row column (count + 1) (xs.values.drop position) =
          G11THStore.linear (int (row.val + (column : Int) * a.rows.val)) xs.values[position] ::
            g11thRowRequests a row (column + 1) count (xs.values.drop (position + 1)) := by
        unfold g11thRowRequests
        rw [List.range'_succ, hdrop]
        rfl
      rw [g11thLinearColumns, hread]
      simp only [numericFromResult, pure_bind]
      rw [hnext, requests, g11thStores]
      simp only [g11thStore, bind_assoc, countNext]


theorem g11th_mul_one (x : I64) : x * int 1 = x := by
  apply Subtype.ext
  change wrapInt .i64 (x.val * 1) = x.val
  rw [Int.mul_one]
  exact wrapInt_of_inRange .i64 x.val x.property

theorem g11th_mul_zero (x : I64) : x * int 0 = int 0 := by
  apply Subtype.ext
  change wrapInt .i64 (x.val * 0) = 0
  rw [Int.mul_zero]
  rfl

theorem g11th_zero_add (x : I64) : int 0 + x = x := by
  apply Subtype.ext
  change wrapInt .i64 (0 + x.val) = x.val
  rw [Int.zero_add]
  exact wrapInt_of_inRange .i64 x.val x.property

def g11thSourceLoop {m : Type → Type} [Monad m] [MonadExceptOf ArrayError m]
    {Ty Ref E : Type} (runtime : TypedHvcatArrayRuntime m Ty Ref E)
    (a : NativeMatrix Ty Ref) (xs : MachineTuple E) : m Unit :=
  hvncatFillLoop (g11thFillRuntime runtime).size
    (numericTailProduct (g11thFillRuntime runtime))
    (fun values => pure values.count) (numericShowShape (g11thFillRuntime runtime))
    (fun _ last => pure (numericOneTo last))
    (fun values => numericFromResult (tupleEachindex values))
    (fun values index => numericFromResult (tupleGet values.values index)) runtime.set a true xs

def g11thLoop {m : Type → Type} [Monad m] [MonadExceptOf ArrayError m]
    {Ty Ref E : Type} (runtime : TypedHvcatArrayRuntime m Ty Ref E)
    (a : NativeMatrix Ty Ref) (xs : MachineTuple E) : m (NativeMatrix Ty Ref) := do
  let _ ← forIn (numericOneTo a.rows) (int 1) (fun row index => do
    let state ← forIn (numericOneTo a.columns) (index, row) (fun _ state => do
      runtime.set a state.2 (← numericFromResult (tupleGet xs.values state.1))
      pure (ForInStep.yield (state.1 + int 1, state.2 + a.rows)))
    pure (ForInStep.yield state.1))
  pure a

theorem g11th_fill_uses_loop {m : Type → Type} [Monad m] [LawfulMonad m]
    [MonadExceptOf ArrayError m] {Ty Ref E : Type}
    (runtime : TypedHvcatArrayRuntime m Ty Ref E) (generated : Bool)
    (a : NativeMatrix Ty Ref) (xs : MachineTuple E)
    (loop : generated = false ∨ xs.values.length > 32) :
    (do
      JuliaLean.base.abstractarray.Models1Group3.numericFill
        (g11thFillRuntime runtime) generated 2 a true xs
      pure a) =
      (do g11thSourceLoop runtime a xs; pure a) := by
  cases generated with
  | false =>
      simp only [JuliaLean.base.abstractarray.Models1Group3.numericFill,
        hvncatFill, Bool.not_false, ite_true, g11thSourceLoop]
      rfl
  | true =>
      have large : xs.values.length > 32 := by
        rcases loop with impossible | large
        · cases impossible
        · exact large
      simp only [JuliaLean.base.abstractarray.Models1Group3.numericFill,
        hvncatFill, Bool.not_true, Bool.false_eq_true, ite_false, large, ite_true,
        g11thSourceLoop]
      rfl

theorem g11th_source_loop {m : Type → Type} [Monad m] [LawfulMonad m]
    [MonadExceptOf ArrayError m] {Ty Ref E : Type}
    (runtime : TypedHvcatArrayRuntime m Ty Ref E) (a : NativeMatrix Ty Ref)
    (xs : MachineTuple E) (count : (a.rows * a.columns).val = xs.count.val) :
    (do g11thSourceLoop runtime a xs; pure a) = g11thLoop runtime a xs := by
  have size1 : (g11thFillRuntime runtime).size a (int 1) = pure a.rows := rfl
  have size2 : (g11thFillRuntime runtime).size a (int 2) = pure a.columns := rfl
  have tailProduct : numericTailProduct (g11thFillRuntime runtime) a = pure (int 1) := by
    simp only [numericTailProduct, g11thFillRuntime, pure_bind]
    rfl
  have range1 : numericOneTo (int 1) = [int 1] := rfl
  have subtract1 : int 1 - int 1 = int 0 := rfl
  simp only [g11thSourceLoop, hvncatFillLoop, size1, size2, tailProduct,
    pure_bind, g11th_mul_one, count, bne_self_eq_false, Bool.false_eq_true,
    ite_false, ite_true, range1, List.forIn_cons, List.forIn_nil, bind_assoc,
    subtract1, g11th_mul_zero, g11th_zero_add, g11thLoop]

theorem g11th_loop_rows {m : Type → Type} [Monad m] [LawfulMonad m]
    [MonadExceptOf ArrayError m] {Ty Ref E : Type}
    (runtime : TypedHvcatArrayRuntime m Ty Ref E) (a : NativeMatrix Ty Ref)
    (xs : MachineTuple E) :
    g11thLoop runtime a xs =
      (do
        let _ ← g11thLinearRows runtime a xs (List.range a.rows.val.toNat) 0
        pure a) := by
  have native := g11th_native_rows runtime a xs (List.range a.rows.val.toNat) 0
  have initial : int (0 : Nat) + int 1 = int 1 := rfl
  simp only [initial] at native
  unfold g11thLoop
  rw [show numericOneTo a.rows =
    (List.range a.rows.val.toNat).map (fun (row : Nat) => int row + int 1) from rfl]
  rw [native]
  simp only [bind_assoc, pure_bind]


def g11thGridRequests {Ty Ref E : Type} (a : NativeMatrix Ty Ref)
    (row count : Nat) (values : List E) : List (G11THStore E) :=
  (g1hv_gridNat a.columns.val.toNat row count values).map fun (row, column, value) =>
    .linear (int ((int row + int 1).val + (column : Int) * a.rows.val)) value

theorem g11th_grid_zero {Ty Ref E : Type} (a : NativeMatrix Ty Ref)
    (row : Nat) (values : List E) : g11thGridRequests a row 0 values = [] := rfl

theorem g11th_grid_cons {Ty Ref E : Type} (a : NativeMatrix Ty Ref)
    (row count : Nat) (values : List E) :
    g11thGridRequests a row (count + 1) values =
      g11thRowRequests a (int row + int 1) 0 a.columns.val.toNat values ++
        g11thGridRequests a (row + 1) count (values.drop a.columns.val.toNat) := by
  simp only [g11thGridRequests, g1hv_gridNat, List.map_append, List.map_map,
    g11thRowRequests, List.range_eq_range', Function.comp_def]

theorem g11th_rows_values {m : Type → Type} [Monad m] [LawfulMonad m]
    [MonadExceptOf ArrayError m] {Ty Ref E : Type}
    (runtime : TypedHvcatArrayRuntime m Ty Ref E) (a : NativeMatrix Ty Ref)
    (xs : MachineTuple E) (row count position : Nat)
    (enough : position + count * a.columns.val.toNat ≤ xs.values.length) :
    g11thLinearRows runtime a xs (List.range' row count) position =
      (do
        let _ ← g11thStores runtime a (g11thGridRequests a row count (xs.values.drop position))
        pure (position + count * a.columns.val.toNat)) := by
  induction count generalizing row position with
  | zero =>
      simp only [List.range'_zero, g11thLinearRows, g11th_grid_zero, g11thStores,
        pure_bind, Nat.zero_mul, Nat.add_zero]
  | succ count ih =>
      have enoughColumns : position + a.columns.val.toNat ≤ xs.values.length := by
        rw [Nat.succ_mul] at enough
        omega
      have enoughNext : position + a.columns.val.toNat + count * a.columns.val.toNat ≤
          xs.values.length := by
        rw [Nat.succ_mul] at enough
        omega
      have hcolumns := g11th_columns_values runtime a xs (int row + int 1)
        0 a.columns.val.toNat position enoughColumns
      have hrows := ih (row + 1) (position + a.columns.val.toNat) enoughNext
      have totals : position + a.columns.val.toNat + count * a.columns.val.toNat =
          position + (count + 1) * a.columns.val.toNat := by
        rw [Nat.succ_mul]
        omega
      simp only [List.range'_succ, g11thLinearRows, hcolumns, bind_assoc, pure_bind,
        hrows, g11th_grid_cons, g11th_stores_append, List.drop_drop, totals]

theorem g11th_grid_expected {Ty Ref E : Type} (a : NativeMatrix Ty Ref)
    (xs : MachineTuple E) (valid : HvcatDimensionsValid a.rows.val a.columns.val)
    (count : (xs.values.length : Int) = a.rows.val * a.columns.val) :
    g11thGridRequests a 0 a.rows.val.toNat xs.values = g11thLinearExpected a xs := by
  have rowsEq : (a.rows.val.toNat : Int) = a.rows.val := Int.toNat_of_nonneg valid.1
  have columnsEq : (a.columns.val.toNat : Int) = a.columns.val :=
    Int.toNat_of_nonneg valid.2.2.1
  have lengthEq : xs.values.length = a.rows.val.toNat * a.columns.val.toNat := by
    apply Int.ofNat_inj.mp
    rw [Int.natCast_mul, rowsEq, columnsEq]
    exact count
  have normalized :
      (g1hv_gridNat a.columns.val.toNat 0 a.rows.val.toNat xs.values).map
        (fun (r, c, value) => G11THStore.linear
          (int ((int r + int 1).val + (c : Int) * a.rows.val)) value) =
      (g1hv_gridNat a.columns.val.toNat 0 a.rows.val.toNat xs.values).map
        (fun (r, c, value) => G11THStore.linear
          (int ((r : Int) + 1 + (c : Int) * a.rows.val)) value) := by
    apply List.map_congr_left
    intro item member
    rcases item with ⟨r, c, value⟩
    have bounds := g1hv_gridNat_bounds a.columns.val.toNat 0 a.rows.val.toNat
      xs.values r c value member
    have rowBound : (r : Int) + 1 ≤ (2 : Int)^63 - 1 := by
      have maximum := a.rows.property.2
      change a.rows.val ≤ 9223372036854775807 at maximum
      omega
    dsimp only
    rw [g1hv_gridIntInc r rowBound]
  unfold g11thGridRequests
  rw [normalized, g1hv_gridNat_layout _ _ _ _ lengthEq, List.map_map]
  unfold g11thLinearExpected
  apply List.map_congr_left
  intro item member
  rcases item with ⟨value, position⟩
  simp only [Function.comp_def, Nat.zero_add]

theorem g11th_loop_expected {m : Type → Type} [Monad m] [LawfulMonad m]
    [MonadExceptOf ArrayError m] {Ty Ref E : Type}
    (runtime : TypedHvcatArrayRuntime m Ty Ref E) (a : NativeMatrix Ty Ref)
    (xs : MachineTuple E) (valid : HvcatDimensionsValid a.rows.val a.columns.val)
    (count : (xs.values.length : Int) = a.rows.val * a.columns.val) :
    g11thLoop runtime a xs = g11thStores runtime a (g11thLinearExpected a xs) := by
  have rowsEq : (a.rows.val.toNat : Int) = a.rows.val := Int.toNat_of_nonneg valid.1
  have columnsEq : (a.columns.val.toNat : Int) = a.columns.val :=
    Int.toNat_of_nonneg valid.2.2.1
  have lengthEq : xs.values.length = a.rows.val.toNat * a.columns.val.toNat := by
    apply Int.ofNat_inj.mp
    rw [Int.natCast_mul, rowsEq, columnsEq]
    exact count
  have enough : 0 + a.rows.val.toNat * a.columns.val.toNat ≤ xs.values.length := by
    rw [← lengthEq]
    omega
  rw [g11th_loop_rows, List.range_eq_range',
    g11th_rows_values runtime a xs 0 a.rows.val.toNat 0 enough]
  simp only [bind_assoc, pure_bind, List.drop_zero,
    g11th_grid_expected a xs valid count]
  induction g11thLinearExpected a xs with
  | nil => simp only [g11thStores, pure_bind]
  | cons request rest ih => simp only [g11thStores, bind_assoc, ih]

theorem g11th_loop_fill {m : Type → Type} [Monad m] [LawfulMonad m]
    [MonadExceptOf ArrayError m] {Ty Ref E : Type}
    (runtime : TypedHvcatArrayRuntime m Ty Ref E) (generated : Bool)
    (a : NativeMatrix Ty Ref) (xs : MachineTuple E)
    (valid : HvcatDimensionsValid a.rows.val a.columns.val)
    (count : (xs.values.length : Int) = a.rows.val * a.columns.val)
    (loop : generated = false ∨ xs.values.length > 32) :
    (do
      JuliaLean.base.abstractarray.Models1Group3.numericFill
        (g11thFillRuntime runtime) generated 2 a true xs
      pure a) =
      g11thStores runtime a (g11thLinearExpected a xs) := by
  have countNative : (a.rows * a.columns).val = xs.count.val := by
    rw [g1hv_matrix_product_value a.rows a.columns valid, xs.count_eq]
    exact count.symm
  rw [g11th_fill_uses_loop runtime generated a xs loop,
    g11th_source_loop runtime a xs countNative, g11th_loop_expected runtime a xs valid count]


