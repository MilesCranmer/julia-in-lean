def g1_map_outcome {A B E : Type}
    (event : A → Except ArrayError B → E) (inputs : List A)
    (outcome : Except ArrayError (List B)) (calls : List E) : Prop :=
  match outcome with
  | .ok values =>
      values.length = inputs.length ∧
        calls = (inputs.zip values).map (fun (a, b) => event a (.ok b))
  | .error error =>
      ∃ preceding input suffix values,
        inputs = preceding ++ input :: suffix ∧ values.length = preceding.length ∧
        calls = (preceding.zip values).map (fun (a, b) => event a (.ok b)) ++
          [event input (.error error)]

theorem g1_record_map {World A B E : Type}
