  (RuntimeValue TrailingSizeOps TrailingIndicesOps)

/-- Every selected exception is admitted, with state retained on failure. -/
abbrev TrailingEffect (World Error : Type) := ExceptT Error (StateM World)

/-- Observation cutoff is distinct from every selected Julia exception. -/
inductive TrailingObservationError (Error : Type) where
  | runtime (error : Error)
  | cutoff

abbrev TrailingObserve (World Error Event : Type) :=
  ExceptT (TrailingObservationError Error)
    (StateM (World × List (StrideObservationStep World Event)))

/-- Record the actual selected result and its state transition. Only the
observation wrapper sees the log, so selected callees cannot edit it. -/
def recordTrailingCall {World Error Event Value : Type}
    (event : Except Error Value → Event) (action : TrailingEffect World Error Value) :
    TrailingObserve World Error Event Value :=
  fun state =>
    let actual := action.run state.1
    (actual.1.mapError TrailingObservationError.runtime,
      (actual.2, state.2 ++ [⟨state.1, actual.2, event actual.1⟩]))

inductive TrailingEvent
    (Error A Start Rank Axis Range Index Got Other IteratorState : Type) where
  | ndims (array : A) (outcome : Except Error Rank)
  | colonArray (start : Start) (rank : Rank) (outcome : Except Error Range)
  | colonIndices (start : Start) (count : I64) (outcome : Except Error Range)
  | size (array : A) (index : RuntimeValue Index)
      (outcome : Except Error (RuntimeValue Other))
  | getindex (indices : Tuple Axis) (index : RuntimeValue Index) (outcome : Except Error Got)
  | length (item : Got) (outcome : Except Error (RuntimeValue Other))
  | multiply (left right : RuntimeValue Other) (outcome : Except Error (RuntimeValue Other))
  | iterate (range : Range) (state : Option IteratorState)
      (outcome : Except Error (Option (RuntimeValue Index × IteratorState)))

/-- Arbitrary initial/resumed iterate observations at the existing ForIn
language boundary. Index values, states, effects and exceptions have no
correctness assumptions. No termination law is imposed. -/
structure TrailingIterationOps (World Error Range Index IteratorState : Type) where
  first : Range → TrailingEffect World Error (Option (RuntimeValue Index × IteratorState))
  next : Range → IteratorState →
    TrailingEffect World Error (Option (RuntimeValue Index × IteratorState))

/-- The budget belongs to observation only and is absent from both models. -/
structure TrailingObservedRange (World Error Range Index IteratorState : Type) where
  value : Range
  budget : Nat
  iteration : TrailingIterationOps World Error Range Index IteratorState

section TrailingObservation

variable {World Error A Start Rank Axis Range Index Got Other IteratorState : Type}

local notation "Event" =>
  TrailingEvent Error A Start Rank Axis Range Index Got Other IteratorState
local notation "Observed" => TrailingObserve World Error Event

/-- Structural observation of the source for protocol. Every finite budget is
quantified by the properties. A cutoff preserves the observed prefix and is
never interpreted as a source return or an exception thrown by Julia.
-/
def observeTrailingFor {Value : Type}
    (range : TrailingObservedRange World Error Range Index IteratorState)
    (body : RuntimeValue Index → Value → Observed (ForInStep Value)) :
    Nat → Option IteratorState → Value → Observed Value
  | 0, _, _ => fun state => (.error .cutoff, state)
  | remaining + 1, iteratorState, value => do
      let item ← recordTrailingCall (.iterate range.value iteratorState)
        (match iteratorState with
          | none => range.iteration.first range.value
          | some state => range.iteration.next range.value state)
      match item with
      | none => pure value
      | some (index, nextState) =>
          match ← body index value with
          | .done result => pure result
          | .yield result => observeTrailingFor range body remaining (some nextState) result

instance trailingObservedForIn :
    ForIn Observed (TrailingObservedRange World Error Range Index IteratorState)
      (RuntimeValue Index) where
  forIn range initial body := observeTrailingFor range body range.budget none initial

/-- Instrument each array-overload dispatch leaf, without changing its result,
exception or World effect. The range envelope is solely observation metadata. -/
def observedTrailingSizeOps
    (ops : TrailingSizeOps (TrailingEffect World Error) A Start Rank Range Index Other)
    (iteration : TrailingIterationOps World Error Range Index IteratorState) (budget : Nat) :
    TrailingSizeOps Observed A Start Rank
      (TrailingObservedRange World Error Range Index IteratorState) Index Other where
  ndims array := recordTrailingCall (.ndims array) (ops.ndims array)
  colon start rank := do
    let range ← recordTrailingCall (.colonArray start rank) (ops.colon start rank)
    pure ⟨range, budget, iteration⟩
  size array index := recordTrailingCall (.size array index) (ops.size array index)
  multiply left right := recordTrailingCall (.multiply left right) (ops.multiply left right)

/-- Instrument the Indices overload while retaining the original machine-sized
tuple, actual yielded index and unrestricted Got value supplied to length. -/
def observedTrailingIndicesOps
    (ops : TrailingIndicesOps (TrailingEffect World Error) Axis Start Range Index Got Other)
    (iteration : TrailingIterationOps World Error Range Index IteratorState) (budget : Nat) :
    TrailingIndicesOps Observed Axis Start
      (TrailingObservedRange World Error Range Index IteratorState) Index Got Other where
