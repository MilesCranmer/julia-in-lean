  ∃ earlier,
    VcatFillItemRecorded input index item earlier ∧
    ((prior = earlier ++ [.lengthItem item (.ok (.inl length))]) ∨
      (∃ other, prior = earlier ++ [.lengthItem item (.ok (.inr other)),
