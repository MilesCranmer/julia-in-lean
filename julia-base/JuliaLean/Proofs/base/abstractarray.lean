/-- Record the actual argument and outcome, including a throwing call's state. -/
def record {Error World Arg R : Type} (selected : Arg → Action Error World R)
    (argument : Arg) : Observe Error World Arg R R :=
  ExceptT.mk <| StateT.mk fun (before, events) =>
    (selected argument before).map fun (result, after) =>
      (result, (after, events ++ [(argument, result)]))

/-- One selected call receives the original argument and conserves its complete outcome and world. -/
def OneCall {Arg R : Type}
    (expected : Arg)
    (execute : {Error World : Type} → (Arg → Observe Error World Arg R R) →
      Observe Error World Arg R R) : Prop :=
  ∀ (Error World : Type) (selected : Arg → Action Error World R) (before : World),
    match ((execute (record selected)).run).run (before, []) with
    | none => selected expected before = none
    | some (result, (after, events)) =>
        events = [(expected, result)] ∧ selected expected before = some (result, after)

/-- Arbitrary selected exceptions, state changes and nonreturning computations. -/
abbrev WorldM (Error World : Type) := ExceptT Error (StateT World Option)

/-- Julia exceptions and arbitrary selected-call failures share the same state. -/
abbrev JuliaWorldM (Error World : Type) := WorldM (ArrayError ⊕ Error) World

def juliaWorldExceptions {Error World : Type} :
    MonadExceptOf ArrayError (JuliaWorldM Error World) where
  throw error := ExceptT.mk (pure (.error (.inl error)))
  tryCatch action handler := ExceptT.mk do
    match ← action.run with
    | .ok value => pure (.ok value)
    | .error (.inl error) => (handler error).run
    | .error (.inr error) => pure (.error (.inr error))

theorem juliaWorldThrow {Error World Value : Type} (error : ArrayError) :
    @MonadExceptOf.throw ArrayError (JuliaWorldM Error World)
      juliaWorldExceptions Value error =
      (fun world => some (.error (.inl error), world)) := rfl

