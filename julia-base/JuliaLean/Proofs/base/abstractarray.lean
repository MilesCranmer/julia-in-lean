    (ptr : Memory → JInt .u64) (a b : A) (world : World),
    let resultA := (dataidsDenseLinked (m := StateM World) ref mem ptr a).run world
    let resultB := (dataidsDenseLinked (m := StateM World) ref mem ptr b).run world
    resultA.2 = world ∧ resultB.2 = world ∧
    resultA.1.length = 1 ∧ resultB.1.length = 1 ∧
    ((∃ identity, identity ∈ resultA.1 ∧ identity ∈ resultB.1) ↔
      ptr (mem (ref a)) = ptr (mem (ref b)))

