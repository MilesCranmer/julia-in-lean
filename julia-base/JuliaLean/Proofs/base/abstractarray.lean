theorem oneCallExact {Arg R : Type} (expected : Arg) :
    OneCall (R := R) expected (fun selected => selected expected) := by
  intro Error World selected before
  cases h : selected expected before with
  | none =>
    simp only [record, ExceptT.run, StateT.run, ExceptT.mk, StateT.mk, h, Option.map_none]
  | some observation =>
    rcases observation with ⟨result, after⟩
    simp only [record, ExceptT.run, StateT.run, ExceptT.mk, StateT.mk, h, Option.map_some, List.nil_append]
    constructor <;> trivial

theorem stateBindFailure {Error World A B : Type}
    (action : ExceptT Error (StateM World) A)
    (next : A → ExceptT Error (StateM World) B)
    (before after : World) (error : Error)
    (h : action.run before = (.error error, after)) :
    (action >>= next).run before = (.error error, after) := by
  change ExceptT.bindCont next (action.run before).1 (action.run before).2 = _
  rw [h]
  rfl

theorem returnsOriginalPure {Error World A : Type} (original : A) :
    ReturnsOriginal (Error := Error) (World := World) original (pure original) := by
