    (rank : Int) < 9223372036854775807 → outs.length = rank →
    (∀ log, (ntuple (fun _ => StateT.lift (similar ind)) rank).run log = .ok (outs, log)) →
    (∀ p ∈ pairs, ind2sub axes p.2 = .ok (sub p.2) ∧ (sub p.2).length = rank) →
