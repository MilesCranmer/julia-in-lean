  | nil => simp [checkboundsIndicesNil, allTupleM]
  | cons a axes ih =>
    by_cases h : (length a).val = 1
    · simpa [checkboundsIndicesNil, allTupleM, h] using ih
    · simp [checkboundsIndicesNil, allTupleM, h]

