        | ok returned =>
            obtain ⟨hreturned, hstores, hsucceeded⟩ := hresult
            refine ⟨hreturned, ?_, ?_⟩
            · change (a, index.val, value) :: numericStoreAttempts events =
                (a, index.val, value) :: g3_pairStores a rest
              rw [hstores]
            · intro event he
              rcases List.mem_cons.mp he with rfl | he
              · rfl
              · exact hsucceeded event he
        | error error =>
            obtain ⟨last, hlast, herror⟩ := hresult
