      | (.error error, after) => (.error error, after)
      | (.ok true, after) => (.ok true, after)
      | (.ok false, after) => offsetObserve (hasOffsetArguments ops rest) after := by
  cases rest with
  | nil =>
    change offsetObserve (hasOffsetArgument ops arg) before = _
    cases h : offsetObserve (hasOffsetArgument ops arg) before with
    | mk result after =>
