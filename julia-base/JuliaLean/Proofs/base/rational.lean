theorem numberPowerCycle_proven : numberPowerCycle := by
  intro T X R x y fallback
  have hno : ∀ (x' : X) (y' : Rational T) (out : R),
      powNumberRationalFull (m := Option) (fun _ _ => some y)
        (fun _ _ => some fallback) (fun base exponent => .inherited (base, exponent)) x' y' = some out → False := by
    refine powNumberRationalFull.fixpoint_induct
      (fun _ _ => some y) (fun _ _ => some fallback)
      (fun base exponent => .inherited (base, exponent))
      (fun f => ∀ x' y' out, f x' y' = some out → False) ?_ ?_
    · exact Lean.Order.admissible_pi_apply
        (P := fun (x' : X) (g : Rational T → Option R) => ∀ y' out, g y' = some out → False)
        (fun _ => Lean.Order.admissible_pi_apply
          (P := fun (y' : Rational T) (o : Option R) => ∀ out, o = some out → False)
          (fun _ => Lean.Order.admissible_pi
            (P := fun o out => o = some out → False)
            (fun out => Lean.Order.Option.admissible_eq_some False out)))
    · intro f ih x' y' out h
      exact ih x' y out h
  cases h : powNumberRationalFull (m := Option) (fun _ _ => some y)
      (fun _ _ => some fallback) (fun base exponent => .inherited (base, exponent)) x y with
  | none => rfl
  | some out => exact False.elim (hno x y out h)

theorem complexPowerCycle_proven : complexPowerCycle := by
  intro T Target One P TypeRep Z R target z p unit onePower typeRep fallback
  have hno : ∀ (t' : Target) (z' : Z) (p' : Rational T) (out : R),
      powComplexRationalFull (m := Option) (fun _ => some unit) (fun _ _ => some onePower)
        (fun _ => typeRep) (fun _ value => some value) (fun _ _ => some fallback)
        { classify := fun _ => .selectedOther, embedReturn := fun _ => onePower }
        (fun base exponent => .inherited (target, base, exponent)) t' z' p' = some out → False := by
    refine powComplexRationalFull.fixpoint_induct
      (fun _ => some unit) (fun _ _ => some onePower)
      (fun _ => typeRep) (fun _ value => some value) (fun _ _ => some fallback)
      { classify := fun _ => .selectedOther, embedReturn := fun _ => onePower }
      (fun base exponent => .inherited (target, base, exponent))
      (fun f => ∀ t' z' p' out, f t' z' p' = some out → False) ?_ ?_
    · exact Lean.Order.admissible_pi_apply
        (P := fun (t' : Target) (g : Z → Rational T → Option R) => ∀ z' p' out, g z' p' = some out → False)
        (fun _ => Lean.Order.admissible_pi_apply
          (P := fun (z' : Z) (h : Rational T → Option R) => ∀ p' out, h p' = some out → False)
          (fun _ => Lean.Order.admissible_pi_apply
            (P := fun (p' : Rational T) (o : Option R) => ∀ out, o = some out → False)
            (fun _ => Lean.Order.admissible_pi
              (P := fun o out => o = some out → False)
              (fun out => Lean.Order.Option.admissible_eq_some False out))))
    · intro f ih t' z' p' out h
      exact ih target z' p' out h
  cases h : powComplexRationalFull (m := Option) (fun _ => some unit) (fun _ _ => some onePower)
      (fun _ => typeRep) (fun _ value => some value) (fun _ _ => some fallback)
      { classify := fun _ => .selectedOther, embedReturn := fun _ => onePower }
      (fun base exponent => .inherited (target, base, exponent)) target z p with
  | none => rfl
  | some out => exact False.elim (hno target z p out h)

end JuliaLean.Proofs.base.rational.MethodContracts

