  | up => exact g2RoundedCeilUnique n d p q hd hp.2 hq.2
  | fromZero =>
      by_cases hn : n < 0
      · simp only [ite_eq_left hn] at hp hq
        exact g2RoundedFloorUnique n d p q hd hp.2 hq.2
      · simp only [ite_eq_right hn] at hp hq
        exact g2RoundedCeilUnique n d p q hd hp.2 hq.2
  | nearest => exact g2RoundedNearestEvenUnique n d p q hd hp.2 hq.2
  | nearestAway => exact g2RoundedNearestAwayUnique n d p q hd hp.2 hq.2
  | nearestUp => exact g2RoundedNearestUpUnique n d p q hd hp.2 hq.2


theorem g2RoundedFloorBounds (n d : Int) (hd : 0 < d) :
    n.fdiv d * d ≤ n ∧ n < (n.fdiv d + 1) * d := by
  rw [Int.fdiv_eq_ediv_of_nonneg n (show 0 ≤ d by omega)]
  exact ⟨Int.ediv_mul_le n (by omega), Int.lt_ediv_add_one_mul_self n hd⟩

theorem g2RoundedCeilBounds (n d : Int) (hd : 0 < d) :
    (-((-n).fdiv d) - 1) * d < n ∧ n ≤ -((-n).fdiv d) * d := by
  have hf := g2RoundedFloorBounds (-n) d hd
  simp only [Int.add_mul, Int.one_mul] at hf
  simp only [Int.sub_mul, Int.neg_mul, Int.one_mul]
  omega

theorem g2RoundedPositiveSign (n d : Int) (hd : 0 < d) :
    ((n < 0) ≠ (d < 0)) ↔ n < 0 := by
  constructor
  · intro h
    by_cases hn : n < 0
    · exact hn
    · have heq : (n < 0) = (d < 0) := propext
        ⟨fun h => False.elim (hn h), fun h => False.elim (by omega)⟩
      exact False.elim (h heq)
  · intro hn heq
    have hdneg : d < 0 := Eq.mp heq hn
    omega

theorem g2RoundedCandidateFacts (n d : Int) (hd : 0 < d) :
    let q := n.tdiv d
    let r := n.tmod d
    let away := q + (if n < 0 then -1 else 1)
    Int.ofNat (q * d - n).natAbs = Int.ofNat r.natAbs ∧
    Int.ofNat (away * d - n).natAbs = d - Int.ofNat r.natAbs ∧
    n.natAbs ≤ (away * d).natAbs ∧
    (n < 0 → n ≤ q * d) ∧ (¬ n < 0 → n ≤ away * d) := by
  intro q r away
  have hqr : q * d + r = n := Int.tdiv_mul_add_tmod n d
  have hdiff : q * d - n = -r := by omega
  have hdist : Int.ofNat (q * d - n).natAbs = Int.ofNat r.natAbs := by
    rw [hdiff, Int.natAbs_neg]
  by_cases hn : n < 0
  · have hrn : r ≤ 0 := by
      have hr := Int.tmod_nonneg d (show 0 ≤ -n by omega)
      rw [Int.neg_tmod] at hr
      change 0 ≤ -r at hr
      omega
    have hrl : -d < r := Int.lt_tmod_of_pos n hd
    have har : Int.ofNat r.natAbs = -r := Int.ofNat_natAbs_of_nonpos hrn
    have haprod : away * d = q * d - d := by
      dsimp only [away]
      rw [ite_eq_left hn, Int.add_mul, Int.neg_mul, Int.one_mul]
      omega
    have haprodneg : away * d ≤ 0 := by omega
    have han : Int.ofNat n.natAbs = -n := Int.ofNat_natAbs_of_nonpos (by omega)
    have haa : Int.ofNat (away * d).natAbs = -(away * d) :=
      Int.ofNat_natAbs_of_nonpos haprodneg
    have hadist : Int.ofNat (away * d - n).natAbs = -(away * d - n) :=
      Int.ofNat_natAbs_of_nonpos (by omega)
    refine ⟨hdist, by omega, ?_, ?_, ?_⟩
    · apply Int.ofNat_le.mp
      change Int.ofNat n.natAbs ≤ Int.ofNat (away * d).natAbs
      omega
    · intro _
      omega
    · intro hnonneg
      exact False.elim (hnonneg hn)
  · have hrn : 0 ≤ r := Int.tmod_nonneg d (by omega)
    have hrl : r < d := Int.tmod_lt_of_pos n hd
    have har : Int.ofNat r.natAbs = r := Int.natAbs_of_nonneg hrn
    have haprod : away * d = q * d + d := by
      dsimp only [away]
      rw [ite_eq_right hn, Int.add_mul, Int.one_mul]
    have haprodpos : 0 ≤ away * d := by omega
    have han : Int.ofNat n.natAbs = n := Int.natAbs_of_nonneg (by omega)
    have haa : Int.ofNat (away * d).natAbs = away * d :=
      Int.natAbs_of_nonneg haprodpos
    have hadist : Int.ofNat (away * d - n).natAbs = away * d - n :=
      Int.natAbs_of_nonneg (by omega)
    refine ⟨hdist, by omega, ?_, ?_, ?_⟩
    · apply Int.ofNat_le.mp
      change Int.ofNat n.natAbs ≤ Int.ofNat (away * d).natAbs
      omega
    · intro hneg
      exact False.elim (hn hneg)
    · intro _
      omega

theorem g2RoundedNearestSelect (n d q away tie : Int) (r b : Nat)
    (hb : Int.ofNat b = d)
    (hq : Int.ofNat (q * d - n).natAbs = Int.ofNat r)
    (ha : Int.ofNat (away * d - n).natAbs = d - Int.ofNat r)
    (P : Int → Prop)
    (htie : 2 * r = b →
      2 * Int.ofNat (tie * d - n).natAbs ≤ d ∧
        (2 * Int.ofNat (tie * d - n).natAbs = d → P tie)) :
    let out := if 2 * r < b then q else if 2 * r > b then away else tie
    2 * Int.ofNat (out * d - n).natAbs ≤ d ∧
      (2 * Int.ofNat (out * d - n).natAbs = d → P out) := by
  dsimp only
  simp only [Int.ofNat_eq_natCast] at hb hq ha htie ⊢
  by_cases hlt : 2 * r < b
  · rw [ite_eq_left hlt, hq]
    exact ⟨by omega, fun heq => False.elim (by omega)⟩
  · rw [ite_eq_right hlt]
    by_cases hgt : 2 * r > b
    · rw [ite_eq_left hgt, ha]
      exact ⟨by omega, fun heq => False.elim (by omega)⟩
    · rw [ite_eq_right hgt]
      exact htie (by omega)

theorem g2RoundedValueExistsPos (n d : Int) (mode : Rounding) (hd : 0 < d) :
    RoundedValue n d mode (ComparisonAndRoundingLemmas.rounded n d mode) := by
  let q := n.tdiv d
  let r := n.tmod d
  let away := q + (if n < 0 then -1 else 1)
  have hqr : q * d + r = n := Int.tdiv_mul_add_tmod n d
  have hrl : -d < r := Int.lt_tmod_of_pos n hd
  have hru : r < d := Int.tmod_lt_of_pos n hd
  have hrpos : 0 ≤ n → 0 ≤ r := fun hn => Int.tmod_nonneg d hn
  have hrneg : n < 0 → r ≤ 0 := by
    intro hn
    have hr := Int.tmod_nonneg d (show 0 ≤ -n by omega)
    rw [Int.neg_tmod] at hr
    change 0 ≤ -r at hr
    omega
  have hf := g2RoundedCandidateFacts n d hd
  change Int.ofNat (q * d - n).natAbs = Int.ofNat r.natAbs ∧
    Int.ofNat (away * d - n).natAbs = d - Int.ofNat r.natAbs ∧
    n.natAbs ≤ (away * d).natAbs ∧
    (n < 0 → n ≤ q * d) ∧ (¬ n < 0 → n ≤ away * d) at hf
  have hdne : d ≠ 0 := by omega
  have hdn : ¬ d < 0 := by omega
  have hdabs : Int.ofNat d.natAbs = d := Int.natAbs_of_nonneg (by omega)
  have hstep := g2RoundedPositiveSign n d hd
  unfold RoundedValue
  simp only [ite_eq_right hdn, hdabs]
  refine ⟨hdne, ?_⟩
  simp only [Int.ofNat_eq_natCast] at hf hdabs ⊢
  cases mode with
  | down => exact g2RoundedFloorBounds n d hd
  | up => exact g2RoundedCeilBounds n d hd
  | toZero =>
      change if n < 0 then (q - 1) * d < n ∧ n ≤ q * d
        else q * d ≤ n ∧ n < (q + 1) * d
      by_cases hn : n < 0
      · rw [ite_eq_left hn]
        have hr := hrneg hn
        simp only [Int.sub_mul, Int.one_mul]
        omega
      · rw [ite_eq_right hn]
        have hr := hrpos (by omega)
        simp only [Int.add_mul, Int.one_mul]
        omega
  | fromZero =>
      simp only [ComparisonAndRoundingLemmas.rounded, hstep]
      change if n < 0 then
          (if r = 0 then q else away) * d ≤ n ∧ n < ((if r = 0 then q else away) + 1) * d
        else ((if r = 0 then q else away) - 1) * d < n ∧ n ≤ (if r = 0 then q else away) * d
      by_cases hn : n < 0
      · rw [ite_eq_left hn]
        have hr := hrneg hn
        by_cases hz : r = 0
        · rw [ite_eq_left hz]
          simp only [Int.add_mul, Int.one_mul]
          omega
        · rw [ite_eq_right hz]
          have ha : away = q - 1 := by dsimp only [away]; rw [ite_eq_left hn]; omega
          rw [ha]
          simp only [Int.sub_mul, Int.add_mul, Int.one_mul]
          omega
      · rw [ite_eq_right hn]
        have hr := hrpos (by omega)
        by_cases hz : r = 0
        · rw [ite_eq_left hz]
          simp only [Int.sub_mul, Int.one_mul]
          omega
        · rw [ite_eq_right hz]
          have ha : away = q + 1 := by dsimp only [away]; rw [ite_eq_right hn]
          rw [ha]
          simp only [Int.sub_mul, Int.add_mul, Int.one_mul]
          omega
  | nearest =>
      simp only [ComparisonAndRoundingLemmas.rounded, hstep, reduceCtorEq, ite_false]
      change let out := if 2 * r.natAbs < d.natAbs then q
        else if 2 * r.natAbs > d.natAbs then away else if q % 2 = 0 then q else away
        ; 2 * Int.ofNat (out * d - n).natAbs ≤ d ∧
          (2 * Int.ofNat (out * d - n).natAbs = d → out % 2 = 0)
      apply g2RoundedNearestSelect n d q away (if q % 2 = 0 then q else away)
        r.natAbs d.natAbs hdabs hf.1 hf.2.1 (fun out => out % 2 = 0)
      intro ht
      by_cases heven : q % 2 = 0
      · simp only [ite_eq_left heven, Int.ofNat_eq_natCast, hf.1]
        exact ⟨by omega, fun _ => heven⟩
      · simp only [ite_eq_right heven, Int.ofNat_eq_natCast, hf.2.1]
        refine ⟨by omega, fun _ => ?_⟩
        dsimp only [away]
        by_cases hn : n < 0
        · rw [ite_eq_left hn]
          omega
        · rw [ite_eq_right hn]
          omega
  | nearestAway =>
      simp only [ComparisonAndRoundingLemmas.rounded, hstep, ite_true]
      change let out := if 2 * r.natAbs < d.natAbs then q
        else if 2 * r.natAbs > d.natAbs then away else away
        ; 2 * Int.ofNat (out * d - n).natAbs ≤ d ∧
          (2 * Int.ofNat (out * d - n).natAbs = d → n.natAbs ≤ (out * d).natAbs)
      apply g2RoundedNearestSelect n d q away away
        r.natAbs d.natAbs hdabs hf.1 hf.2.1 (fun out => n.natAbs ≤ (out * d).natAbs)
      intro ht
      simp only [Int.ofNat_eq_natCast, hf.2.1]
      exact ⟨by omega, fun _ => hf.2.2.1⟩
  | nearestUp =>
      simp only [ComparisonAndRoundingLemmas.rounded, hstep, reduceCtorEq, ite_false, ite_true]
      change let out := if 2 * r.natAbs < d.natAbs then q
        else if 2 * r.natAbs > d.natAbs then away
        else if (if n < 0 then (-1 : Int) else 1) < 0 then q else away
        ; 2 * Int.ofNat (out * d - n).natAbs ≤ d ∧
          (2 * Int.ofNat (out * d - n).natAbs = d → n ≤ out * d)
      apply g2RoundedNearestSelect n d q away
        (if (if n < 0 then (-1 : Int) else 1) < 0 then q else away)
        r.natAbs d.natAbs hdabs hf.1 hf.2.1 (fun out => n ≤ out * d)
      intro ht
      by_cases hn : n < 0
      · rw [ite_eq_left hn]
        change 2 * Int.ofNat (q * d - n).natAbs ≤ d ∧
          (2 * Int.ofNat (q * d - n).natAbs = d → n ≤ q * d)
        simp only [Int.ofNat_eq_natCast, hf.1]
        exact ⟨by omega, fun _ => hf.2.2.2.1 hn⟩
      · rw [ite_eq_right hn]
        change 2 * Int.ofNat (away * d - n).natAbs ≤ d ∧
          (2 * Int.ofNat (away * d - n).natAbs = d → n ≤ away * d)
        simp only [Int.ofNat_eq_natCast, hf.2.1]
        exact ⟨by omega, fun _ => hf.2.2.2.2 hn⟩


theorem g2RoundedValueNegDenominator (a b q : Int) (mode : Rounding) (hb : b < 0) :
    RoundedValue a b mode q ↔ RoundedValue (-a) (-b) mode q := by
  have hnb : ¬ -b < 0 := by omega
  unfold RoundedValue
  simp only [ite_eq_left hb, ite_eq_right hnb, Int.natAbs_neg]
  constructor
  · intro h
    exact ⟨by omega, h.2⟩
  · intro h
    exact ⟨by omega, h.2⟩

theorem g2RoundedFormulaNegBoth (a b : Int) (mode : Rounding) (hb : b ≠ 0) :
    ComparisonAndRoundingLemmas.rounded (-a) (-b) mode =
      ComparisonAndRoundingLemmas.rounded a b mode := by
  by_cases ha : a = 0
  · have habs : 0 < b.natAbs := Int.natAbs_pos.mpr hb
    cases mode <;> simp only [ComparisonAndRoundingLemmas.rounded, ha,
      Int.neg_zero, Int.zero_tdiv, Int.zero_tmod, Int.zero_fdiv,
      Int.natAbs_zero, Int.natAbs_neg, Nat.mul_zero, habs, ite_true]
  · have hna : (-a < 0) ↔ ¬ a < 0 := by omega
    have hnb : (-b < 0) ↔ ¬ b < 0 := by omega
    have hs : ((-a < 0) ≠ (-b < 0)) ↔ ((a < 0) ≠ (b < 0)) := by
      simp only [ne_eq, eq_iff_iff, hna, hnb, Decidable.not_iff_not]
    have hq : (-a).tdiv (-b) = a.tdiv b := Int.neg_tdiv_neg a b
    have hr : (-a).tmod (-b) = -(a.tmod b) := by
      rw [Int.tmod_neg, Int.neg_tmod]
    have hf : (-a).fdiv (-b) = a.fdiv b := Int.neg_fdiv_neg a b
    have hc : (-(-a)).fdiv (-b) = (-a).fdiv b := Int.neg_fdiv_neg (-a) b
    cases mode <;> simp only [ComparisonAndRoundingLemmas.rounded, hq, hr,
      Int.natAbs_neg, hf, hc, hs, Int.neg_eq_zero]

theorem g2RoundedValue_unique (a b p q : Int) (mode : Rounding)
    (hp : RoundedValue a b mode p) (hq : RoundedValue a b mode q) : p = q := by
  have hb : b ≠ 0 := hp.1
  by_cases hbn : b < 0
  · exact g2RoundedValueUniquePos (-a) (-b) p q mode (by omega)
      ((g2RoundedValueNegDenominator a b p mode hbn).mp hp)
      ((g2RoundedValueNegDenominator a b q mode hbn).mp hq)
  · exact g2RoundedValueUniquePos a b p q mode (by omega) hp hq

theorem g2RoundedValue_exists (a b : Int) (mode : Rounding) (hb : b ≠ 0) :
    RoundedValue a b mode (ComparisonAndRoundingLemmas.rounded a b mode) := by
  by_cases hbn : b < 0
  · have hp := g2RoundedValueExistsPos (-a) (-b) mode (by omega)
    rw [g2RoundedFormulaNegBoth a b mode hb] at hp
    exact (g2RoundedValueNegDenominator a b
      (ComparisonAndRoundingLemmas.rounded a b mode) mode hbn).mpr hp
  · exact g2RoundedValueExistsPos a b mode (by omega)

theorem g2RoundedValue_iff (a b q : Int) (mode : Rounding) (hb : b ≠ 0) :
    RoundedValue a b mode q ↔ q = ComparisonAndRoundingLemmas.rounded a b mode := by
  constructor
  · intro hq
    exact g2RoundedValue_unique a b q (ComparisonAndRoundingLemmas.rounded a b mode)
      mode hq (g2RoundedValue_exists a b mode hb)
  · intro hq
    rw [hq]
    exact g2RoundedValue_exists a b mode hb


