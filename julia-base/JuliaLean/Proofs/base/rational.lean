def sourceMode : Rounding → JuliaLean.base.float.RoundingMode
  | .toZero => .ToZero | .down => .Down | .up => .Up | .fromZero => .FromZero
  | .nearest => .Nearest | .nearestAway => .NearestTiesAway | .nearestUp => .NearestTiesUp
def rounded (a b : Int) (mode : Rounding) : Int :=
  let q := a.tdiv b
  let r := a.tmod b
  let step := if (a < 0) ≠ (b < 0) then -1 else 1
  let away := q + step
  match mode with
  | .toZero => q
  | .down => a.fdiv b
  | .up => -((-a).fdiv b)
  | .fromZero => if r = 0 then q else away
  | .nearest | .nearestAway | .nearestUp =>
    if 2 * r.natAbs < b.natAbs then q
    else if 2 * r.natAbs > b.natAbs then away
    else if mode = .nearestAway then away
    else if mode = .nearestUp then if step < 0 then q else away
    else if q % 2 = 0 then q else away
def IsOverflow {T : Type} (run : Jl T) : Prop :=
  ∃ message, run = .error (.overflowError message)
def IsInexact {T : Type} (run : Jl T) : Prop :=
  ∃ message, run = .error (.inexactError message)
def IsArgument {T : Type} (run : Jl T) : Prop :=
  ∃ message, run = .error (.argumentError message)
inductive IntegerParameters : Type → Type where
  | bits (t : IntTy) : IntegerParameters (JInt t)
namespace IntegerParameters
def ops {T : Type} : IntegerParameters T → RatIntOps T
  | .bits t => { jintOps t with
      divToZero := JuliaLean.base.div.divBitIntegerToZero
      fld := JuliaLean.base.div.divBitIntegerDown
      cld := JuliaLean.base.div.divBitIntegerUp
      divRound := fun a b r => JuliaLean.base.div.divBitIntegerMode a b (sourceMode r)
      rem := JuliaLean.base.int.remSame
      mod := if t.signed then JuliaLean.base.int.mod_BitSigned JuliaLean.base.div.fldBitInteger else JuliaLean.base.int.mod_Unsigned }
def fits {T : Type} : IntegerParameters T → Int → Prop
  | .bits t => fun n => t.min ≤ n ∧ n ≤ t.max
end IntegerParameters
abbrev unsignedDivide : JuliaLean.base.int.BinOpJl := fun x y =>
  let (a,b) := JuliaLean.base.int.promoteSameSign x y
  JuliaLean.base.int.divSame a b
def divideByUnsigned {t u : IntTy} (x : JInt t) (g : Jl (JInt u)) : Jl (JInt t) := do
  let g ← g
  if t.signed then
    let q ← JuliaLean.base.int.div_BitSigned_Unsigned unsignedDivide x g
    JInt.convert (t.name) t q.val
  else
    let q ← unsignedDivide x g
    JInt.convert (t.name) t q.val
abbrev val {T : Type} (i : IntegerParameters T) := i.ops.toInt
abbrev rn {T : Type} (i : IntegerParameters T) (q : Rational T) := val i q.num
abbrev rd {T : Type} (i : IntegerParameters T) (q : Rational T) := val i q.den
def Canonical {T : Type} (i : IntegerParameters T) (q : Rational T) : Prop :=
  0 ≤ rd i q ∧ Nat.gcd (rn i q).natAbs (rd i q).natAbs = 1
def Represents {T : Type} (i : IntegerParameters T) (q : Rational T) (n d : Int) : Prop :=
  Canonical i q ∧ rn i q * d = n * rd i q ∧
  (d ≠ 0 → rd i q > 0) ∧ (d = 0 → rd i q = 0 ∧ intSign (rn i q) = intSign n)
def dg {T U : Type} (i : IntegerParameters T) (j : IntegerParameters U) : T → U → Jl (T × U) :=
  match i,j with
  | .bits t,.bits s => divgcdSource JuliaLean.base.float.uabs JuliaLean.base.float.uabs
      (fun a b => let (a,b) := JuliaLean.base.int.promoteSameSign a b
                  JuliaLean.base.intfuncs.gcd_BitInteger a b)
      divideByUnsigned divideByUnsigned
def rational {T : Type} (i : IntegerParameters T) : T → T → Jl (Rational T) :=
  match i with
  | .bits t => rationalSameSource (jintOps t) JuliaLean.base.float.uabs
      (dg (.bits t.toUnsigned) (.bits t.toUnsigned)) (fun x => JInt.convert (t.name) t x.val)
      (dg (.bits t) (.bits t)) Prod.mk
def ExactResult {T : Type} (i : IntegerParameters T) (run : Jl (Rational T))
    (n d : Int) : Prop := ∃ q, run = .ok q ∧ Represents i q n d
def FitsPair {T : Type} (i : IntegerParameters T) (n d : Int) : Prop :=
  i.fits n ∧ i.fits d
def reduced (n d : Int) : Int × Int :=
  let g : Int := Nat.gcd n.natAbs d.natAbs
  (n.tdiv g, d.tdiv g)
def ConstructorContract {T : Type} (i : IntegerParameters T)
    (run : Jl (Rational T)) (n d : Int) : Prop :=
  let g := Nat.gcd n.natAbs d.natAbs
  let a := if i.ops.isUnsignedOrBool then ((reduced n d).1.natAbs : Int) else (reduced n d).1
  let b := if i.ops.isUnsignedOrBool then ((reduced n d).2.natAbs : Int) else (reduced n d).2
  let negativeUnsigned := i.ops.isUnsignedOrBool = true ∧ n ≠ 0 ∧ ((n < 0) ≠ (d < 0))
  let converted := FitsPair i a b
  let normalized := b < 0 → FitsPair i (-a) (-b)
  (g = 0 → IsArgument run) ∧
  (g ≠ 0 → negativeUnsigned → IsInexact run) ∧
  (g ≠ 0 → ¬ negativeUnsigned → ¬ converted → IsInexact run) ∧
  (g ≠ 0 → ¬ negativeUnsigned → converted →
    (normalized → ExactResult i run n d) ∧ (¬ normalized → IsOverflow run))
def promote_absorption : Prop :=
  ∀ (t s : IntTy),
    t.promote (t.promote s) = t.promote s ∧
    s.promote (t.promote s) = t.promote s ∧
    (t.promote s).promote t = t.promote s ∧
    (t.promote s).promote s = t.promote s
theorem promote_absorption_proven (t s : IntTy) :
    t.promote (t.promote s) = t.promote s ∧
    s.promote (t.promote s) = t.promote s ∧
    (t.promote s).promote t = t.promote s ∧
    (t.promote s).promote s = t.promote s := by
  cases t <;> cases s <;> decide
def nativeOps (t : IntTy) : RatIntOps (JInt t) :=
  { IntegerParameters.ops (.bits t) with
    checkedMul := JuliaLean.base.checked.checkedMulBits
    checkedAdd := JuliaLean.base.checked.checkedAddBits
    checkedSub := JuliaLean.base.checked.checkedSubBits
    checkedNeg := JuliaLean.base.checked.checkedNegBits
    checkedAbs := JuliaLean.base.checked.checkedAbsBits }
def castInteger {t p : IntTy} (h : t = p) (run : Jl (JInt t)) : Jl (JInt p) :=
  run.map (fun x => h ▸ x)
def nativePromotion (t s : IntTy) : RatPromoteOps (JInt t) (JInt s) (JInt (t.promote s)) :=
  { jintPromoteOps t s with
    opsX := nativeOps t
    opsY := nativeOps s
    opsP := nativeOps (t.promote s)
    checkedMulXP := fun x y => castInteger (promote_absorption_proven t s).1
      (JuliaLean.base.checked.checkedMulMixedBits x y)
    checkedMulYP := fun x y => castInteger (promote_absorption_proven t s).2.1
      (JuliaLean.base.checked.checkedMulMixedBits x y)
    checkedMulPX := fun x y => castInteger (promote_absorption_proven t s).2.2.1
      (JuliaLean.base.checked.checkedMulMixedBits x y)
    checkedMulPY := fun x y => castInteger (promote_absorption_proven t s).2.2.2
      (JuliaLean.base.checked.checkedMulMixedBits x y)
    checkedMulXY := JuliaLean.base.checked.checkedMulMixedBits }
def MixedRemainderOutcome (t s : IntTy) (x : Rat t) (y : Rat s)
    (run : Jl (Rat (t.promote s))) (floorMode : Bool) : Prop :=
  let p := IntegerParameters.bits (t.promote s)
  let g : Int := Nat.gcd x.den.val.natAbs y.den.val.natAbs
  let a := x.num.val*y.den.val.tdiv g
  let b := y.num.val*x.den.val.tdiv g
  let d := x.den.val*y.den.val.tdiv g
  let r := if floorMode then a.fmod b else a.tmod b
  (g = 0 → run = .error .divideError) ∧
  (g ≠ 0 →
    (¬ p.fits x.num.val → IsInexact run) ∧
    (p.fits x.num.val → ¬ p.fits a → IsOverflow run) ∧
    (p.fits x.num.val → p.fits a → ¬ p.fits y.num.val → IsInexact run) ∧
    (p.fits x.num.val → p.fits a → p.fits y.num.val → ¬ p.fits b → IsOverflow run) ∧
    (p.fits x.num.val → p.fits a → p.fits y.num.val → p.fits b →
      (b = 0 → run = .error .divideError) ∧
      (b ≠ 0 → ¬ p.fits d → IsOverflow run) ∧
      (b ≠ 0 → p.fits d → ConstructorContract p run r d)))
def mixed_remainders : Prop :=
  ∀ (t s : IntTy) (x : Rat t) (y : Rat s)
    (hx : Normalized x) (hy : Normalized y),
    let p := IntegerParameters.bits (t.promote s)
    MixedRemainderOutcome t s x y
      (remRatSource (nativePromotion t s) (dg p p) (rational p) x y) false ∧
    MixedRemainderOutcome t s x y
      (modRatSource (nativePromotion t s) (dg p p) (rational p) x y) true
def TargetInteger (f : JuliaLean.base.float.FTy) (x : JuliaLean.base.float.FV f) : Prop :=
  x.isinf = true ∨ (x.isfinite = true ∧ ((Fl.toRat x).2 : Int) ∣ (Fl.toRat x).1)
def targetPair {f : JuliaLean.base.float.FTy} (x : JuliaLean.base.float.FV f) : Int × Int :=
  if x.isinf then (if x.signbit then -1 else 1,0)
  else ((Fl.toRat x).1,(Fl.toRat x).2)
def nearestCoordinate {f : JuliaLean.base.float.FTy} (x : JuliaLean.base.float.FV f) : Int :=
  if x.isinf then (if x.signbit then -1 else 1)*(2 : Int)^(f.fmt.bias+1)
  else (Fl.toRat x).1.tdiv (Fl.toRat x).2
def evenTarget {f : JuliaLean.base.float.FTy} (x : JuliaLean.base.float.FV f) : Prop :=
  if (nearestCoordinate x).natAbs < 2^(f.fmt.sb+1) then nearestCoordinate x % 2 = 0
  else x.toBits % 2 = 0
def compareExtended (n d m e : Int) : Int :=
  if d = 0 then if e = 0 then intCmp (intSign n) (intSign m) else intSign n
  else if e = 0 then -intSign m else intCmp (n*e) (m*d)
def TargetRounding (f : JuliaLean.base.float.FTy) (out : JuliaLean.base.float.FV f)
    (n d : Int) (mode : Rounding) : Prop :=
  let order := fun z : JuliaLean.base.float.FV f =>
    compareExtended (targetPair z).1 (targetPair z).2 n d
  let down := order out ≤ 0 ∧ ∀ z, TargetInteger f z → order z ≤ 0 →
    compareExtended (targetPair z).1 (targetPair z).2 (targetPair out).1 (targetPair out).2 ≤ 0
  let up := 0 ≤ order out ∧ ∀ z, TargetInteger f z → 0 ≤ order z →
    compareExtended (targetPair out).1 (targetPair out).2 (targetPair z).1 (targetPair z).2 ≤ 0
  let distance := fun z : JuliaLean.base.float.FV f => (nearestCoordinate z*d-n).natAbs
  TargetInteger f out ∧ match mode with
  | .down => down
  | .up => up
  | .toZero => if n < 0 then up else down
  | .fromZero => if n < 0 then down else up
  | .nearest | .nearestAway | .nearestUp =>
    (∀ z, TargetInteger f z → distance out ≤ distance z) ∧
    (∀ z, TargetInteger f z → distance out = distance z →
      nearestCoordinate out ≠ nearestCoordinate z →
      match mode with
      | .nearest => evenTarget out
      | .nearestAway => (nearestCoordinate z).natAbs ≤ (nearestCoordinate out).natAbs
      | .nearestUp => nearestCoordinate z ≤ nearestCoordinate out
      | _ => True)
def finite_noninteger_rounding : Prop :=
  ∀ (t s : IntTy) (f : JuliaLean.base.float.FTy)
    (x : Rat s) (hx : Normalized x) (hd : 0 < x.den.val) (mode : Rounding),
    ∀ (copySign : Rat s → JInt s → Jl (Rat s)) rationalInf floatInf,
    let answer := rounded x.num.val x.den.val mode
    let rr := roundRatTypedSource (Rat t) (jintOps s).iszero false
      (JInt.lit s 1) (JInt.lit s 0) copySign rationalInf
      (fun a b r => JuliaLean.base.div.divBitIntegerMode a b (sourceMode r))
      (rationalIntAsSource (JInt t) (JuliaLean.base.int.convert t) (fun _ => JInt.lit s 1)) x mode
    let fr := roundRatTypedSource (JuliaLean.base.float.FV f) (jintOps s).iszero false
      (JInt.lit s 1) (JInt.lit s 0) copySign floatInf
      (fun a b r => JuliaLean.base.div.divBitIntegerMode a b (sourceMode r))
      (fun n => .ok (JuliaLean.base.float.floatOfInt f n)) x mode
    ((t.min ≤ answer ∧ answer ≤ t.max) → ExactResult (.bits t) rr answer 1) ∧
    (¬ (t.min ≤ answer ∧ answer ≤ t.max) → IsInexact rr) ∧
    (∃ out, fr = .ok out ∧ TargetRounding f out x.num.val x.den.val mode)
