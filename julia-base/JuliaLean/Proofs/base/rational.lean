theorem checked_overflow_aux {T U P : Type} (i : IntegerParameters T) (j : IntegerParameters U)
    (p : IntegerParameters P) (m : PromotionParameters i j p) (x : Rational T) (y : Rational U)
    (_hx : Canonical i x) (hy : Canonical j y) :
    (¬ Converts i j p x y → IsInexact (add m x y) ∧ IsInexact (sub m x y)) ∧
    (Converts i j p x y → rd i x > 0 → rd j y > 0 →
      (¬ AddSafe i j p x y false → IsOverflow (add m x y)) ∧
      (¬ AddSafe i j p x y true → IsOverflow (sub m x y))) ∧
    (Converts i j p x y → rd i x = 0 → ¬ j.fits (-rn j y) → IsOverflow (sub m x y)) := by
  have hpr := promoteR_spec i j p m x y
  refine ⟨fun hnc => ?_, fun hcv hdx_pos hdy_pos => ?_, fun hcv hdx0 hnot_neg => ?_⟩
  · obtain ⟨msg, herr⟩ := hpr.2 hnc
    unfold add sub addRatSource subRatSource
    simp [herr, Bind.bind, Except.bind, IsInexact]
  · have hdx_nz : decide (rd i x = 0) = false := decide_eq_false (by omega)
    let gNat := Nat.gcd (rd i x).natAbs (rd j y).natAbs
    let g : Int := gNat
    have hg_pos : 0 < gNat := Nat.gcd_pos_of_pos_left _ (Int.natAbs_pos.mpr (by omega))
    have hg_nz : g ≠ 0 := by omega
    let a := rn i x * (rd j y).tdiv g
    let b := rn j y * (rd i x).tdiv g
    let d := rd i x * (rd j y).tdiv g
    obtain ⟨xp, yp, hpr_ok, _, _, _, _⟩ := hpr.1 hcv
    obtain ⟨xdp, ydp, hp_ok, hxdp_v, hydp_v⟩ := (prom_promote_spec m x.den y.den).1 ⟨hcv.2.1, hcv.2.2.2⟩
    refine ⟨fun hnot_safe => ?_, fun hnot_safe => ?_⟩
    · unfold add addRatSource
      simp only [hpr_ok, hdx_nz, hp_ok, Bool.false_and, Bool.false_eq_true, ↓reduceIte,
        Bind.bind, Except.bind]
      cases p with | bits pt =>
      change xdp.val = rd i x at hxdp_v
      change ydp.val = rd j y at hydp_v
      have hg_eq : (Nat.gcd xdp.val.natAbs ydp.val.natAbs : Int) = g := by
        dsimp [g, gNat]; rw [hxdp_v, hydp_v]
      obtain ⟨xd, yd, hdg_ok, hxd_v, hyd_v, _, _, _, _, _, _, _, _⟩ :=
        (dgBits_spec xdp ydp).2 (by dsimp; rw [hg_eq]; exact hg_nz)
      rw [hg_eq, hxdp_v] at hxd_v
      rw [hg_eq, hydp_v] at hyd_v
      have hdg_eq : dg (.bits pt) (.bits pt) = dgBits := rfl
      rw [hdg_eq, hdg_ok]; dsimp only [Bind.bind, Except.bind]
      by_cases hfa : (IntegerParameters.bits pt).fits a
      · obtain ⟨aJ, haJ_ok, haJ_v⟩ := (prom_checkedMulXP_spec m x.num yd hcv.1).1 (by
          change (IntegerParameters.bits pt).fits (rn i x * yd.val); rw [hyd_v]; exact hfa)
        rw [haJ_ok]; dsimp only
        by_cases hfb : (IntegerParameters.bits pt).fits b
        · obtain ⟨bJ, hbJ_ok, hbJ_v⟩ := (prom_checkedMulYP_spec m y.num xd hcv.2.2.1).1 (by
            change (IntegerParameters.bits pt).fits (rn j y * xd.val); rw [hxd_v]; exact hfb)
          rw [hbJ_ok]; dsimp only
          by_cases hfn : (IntegerParameters.bits pt).fits (a + b)
          · obtain ⟨nJ, hnJ_ok, _⟩ := (opsP_checkedAdd_spec m aJ bJ).1 (by
              rw [haJ_v, hbJ_v]; change (IntegerParameters.bits pt).fits (rn i x * yd.val + rn j y * xd.val)
              rw [hyd_v, hxd_v]; exact hfn)
            rw [hnJ_ok]; dsimp only
            have hnot_fd : ¬ (IntegerParameters.bits pt).fits d := fun hfd =>
              hnot_safe ⟨hcv.1, hcv.2.1, hcv.2.2.1, hcv.2.2.2, hfa, hfb, hfn, hfd⟩
            obtain ⟨msg, herr⟩ := (prom_checkedMulXP_spec m x.den yd hcv.2.1).2 (by
              change ¬ (IntegerParameters.bits pt).fits (rd i x * yd.val); rw [hyd_v]; exact hnot_fd)
            rw [herr]; exact ⟨msg, rfl⟩
          · obtain ⟨msg, herr⟩ := (opsP_checkedAdd_spec m aJ bJ).2 (by
              rw [haJ_v, hbJ_v]; change ¬ (IntegerParameters.bits pt).fits (rn i x * yd.val + rn j y * xd.val)
              rw [hyd_v, hxd_v]; exact hfn)
            rw [herr]; exact ⟨msg, rfl⟩
        · obtain ⟨msg, herr⟩ := (prom_checkedMulYP_spec m y.num xd hcv.2.2.1).2 (by
            change ¬ (IntegerParameters.bits pt).fits (rn j y * xd.val); rw [hxd_v]; exact hfb)
          rw [herr]; exact ⟨msg, rfl⟩
      · obtain ⟨msg, herr⟩ := (prom_checkedMulXP_spec m x.num yd hcv.1).2 (by
          change ¬ (IntegerParameters.bits pt).fits (rn i x * yd.val); rw [hyd_v]; exact hfa)
        rw [herr]; exact ⟨msg, rfl⟩
    · unfold sub subRatSource
      simp only [hpr_ok, hdx_nz, hp_ok, Bool.false_eq_true, ↓reduceIte,
        Bind.bind, Except.bind, Pure.pure, Except.pure]
      cases p with | bits pt =>
      change xdp.val = rd i x at hxdp_v
      change ydp.val = rd j y at hydp_v
      have hg_eq : (Nat.gcd xdp.val.natAbs ydp.val.natAbs : Int) = g := by
        dsimp [g, gNat]; rw [hxdp_v, hydp_v]
      obtain ⟨xd, yd, hdg_ok, hxd_v, hyd_v, _, _, _, _, _, _, _, _⟩ :=
        (dgBits_spec xdp ydp).2 (by dsimp; rw [hg_eq]; exact hg_nz)
      rw [hg_eq, hxdp_v] at hxd_v
      rw [hg_eq, hydp_v] at hyd_v
      have hdg_eq : dg (.bits pt) (.bits pt) = dgBits := rfl
      rw [hdg_eq, hdg_ok]; dsimp only [Bind.bind, Except.bind]
      by_cases hfa : (IntegerParameters.bits pt).fits a
      · obtain ⟨aJ, haJ_ok, haJ_v⟩ := (prom_checkedMulXP_spec m x.num yd hcv.1).1 (by
          change (IntegerParameters.bits pt).fits (rn i x * yd.val); rw [hyd_v]; exact hfa)
        rw [haJ_ok]; dsimp only
        by_cases hfb : (IntegerParameters.bits pt).fits b
        · obtain ⟨bJ, hbJ_ok, hbJ_v⟩ := (prom_checkedMulYP_spec m y.num xd hcv.2.2.1).1 (by
            change (IntegerParameters.bits pt).fits (rn j y * xd.val); rw [hxd_v]; exact hfb)
          rw [hbJ_ok]; dsimp only
          by_cases hfn : (IntegerParameters.bits pt).fits (a - b)
          · obtain ⟨nJ, hnJ_ok, _⟩ := (opsP_checkedSub_spec m aJ bJ).1 (by
              rw [haJ_v, hbJ_v]; change (IntegerParameters.bits pt).fits (rn i x * yd.val - rn j y * xd.val)
              rw [hyd_v, hxd_v]; exact hfn)
            rw [hnJ_ok]; dsimp only
            have hnot_fd : ¬ (IntegerParameters.bits pt).fits d := fun hfd =>
              hnot_safe ⟨hcv.1, hcv.2.1, hcv.2.2.1, hcv.2.2.2, hfa, hfb, hfn, hfd⟩
            obtain ⟨msg, herr⟩ := (prom_checkedMulXP_spec m x.den yd hcv.2.1).2 (by
              change ¬ (IntegerParameters.bits pt).fits (rd i x * yd.val); rw [hyd_v]; exact hnot_fd)
            rw [herr]; exact ⟨msg, rfl⟩
          · obtain ⟨msg, herr⟩ := (opsP_checkedSub_spec m aJ bJ).2 (by
              rw [haJ_v, hbJ_v]; change ¬ (IntegerParameters.bits pt).fits (rn i x * yd.val - rn j y * xd.val)
              rw [hyd_v, hxd_v]; exact hfn)
            rw [herr]; exact ⟨msg, rfl⟩
        · obtain ⟨msg, herr⟩ := (prom_checkedMulYP_spec m y.num xd hcv.2.2.1).2 (by
            change ¬ (IntegerParameters.bits pt).fits (rn j y * xd.val); rw [hxd_v]; exact hfb)
          rw [herr]; exact ⟨msg, rfl⟩
      · obtain ⟨msg, herr⟩ := (prom_checkedMulXP_spec m x.num yd hcv.1).2 (by
          change ¬ (IntegerParameters.bits pt).fits (rn i x * yd.val); rw [hyd_v]; exact hfa)
        rw [herr]; exact ⟨msg, rfl⟩
  · obtain ⟨xp, yp, hpr_ok, _, _, _, _⟩ := hpr.1 hcv
    obtain ⟨msg, hneg_err⟩ := (unary_spec_aux j y hy).2.1 hnot_neg
    unfold sub subRatSource
    have hinf_x : decide (rd i x = 0) = true := decide_eq_true hdx0
    simp [hpr_ok, hinf_x, hneg_err, Bind.bind, Except.bind, IsOverflow]

theorem checked_overflow_proven : checked_overflow := @checked_overflow_aux

