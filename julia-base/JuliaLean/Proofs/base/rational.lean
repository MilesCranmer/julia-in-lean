/-- A mathematical fraction represented by a normalized native rational.
Finite values use the ordinary cross-product identity and a positive denominator.
Infinite values have zero denominator and numerator equal to the sign of the
nonzero original numerator. Zero over zero has no representation here.
Documentation: doc/src/manual/complex-and-rational-numbers.md:184-210,283-305;
base/rational.jl:64-91. This definition invokes no construction model. -/
def ComplexScalarFractionValue {p : IntTy} (q : Rat p) (n d : Int) : Prop :=
  (n ≠ 0 ∨ d ≠ 0) ∧ Normalized q ∧
    (d ≠ 0 → 0 < q.den.val ∧ q.num.val * d = n * q.den.val) ∧
    (d = 0 → q.den.val = 0 ∧ q.num.val = (if n < 0 then -1 else 1))

/-- Whether the exact normalized fraction has any representation in the result
component type. This independent mathematical existence condition includes the
positive-denominator convention; it detects both denominator and numerator
overflow during normalization without running gcd or the constructor. -/
def ComplexScalarFractionRepresentable (p : IntTy) (n d : Int) : Prop :=
  ∃ q : Rat p, ComplexScalarFractionValue q n d

/-- Both input integers must survive the source's promotion before reduction.
This requirement concerns the original input values, not just their ratio.
Source: base/rational.jl:49,91,116; base/promotion.jl:397-401. -/
def ComplexScalarInputsFit (p : IntTy) (n d : Int) : Prop :=
  p.min ≤ n ∧ n ≤ p.max ∧ p.min ≤ d ∧ d ≤ p.max

/-- The complete mathematical success condition for either component quotient. -/
def ComplexScalarComponentReady (p : IntTy) (n d : Int) : Prop :=
  ComplexScalarInputsFit p n d ∧ ComplexScalarFractionRepresentable p n d

/-- Ordered error classes for one component: failed input conversion first,
then invalid zero/zero, then failure to represent the normalized exact ratio.
The final condition is an independent representability assertion and does not
call the model. Source: base/rational.jl:20-47,49,91,116. Message rendering is
not strengthened beyond the existing shared error representation. -/
def ComplexScalarComponentErrors {A : Type} (p : IntTy) (n d : Int)
    (run : Jl A) : Prop :=
  (¬ ComplexScalarInputsFit p n d →
    ∃ message, run = .error (.inexactError message)) ∧
  (ComplexScalarInputsFit p n d →
    (n = 0 → d = 0 → ∃ message, run = .error (.argumentError message)) ∧
    ((n ≠ 0 ∨ d ≠ 0) → ¬ ComplexScalarFractionRepresentable p n d →
      ∃ message, run = .error (.overflowError message)))

/-- Exact division of every native complex-integer value by every native
integer scalar. Real-component failures precede all imaginary-component work.
When the real component is representable, imaginary failures propagate; when
both are representable the result has both exact normalized values, including
signed rational infinities. There is no successful-run, normalization or range
precondition on the inputs.
Sources: base/rational.jl:20-49,64-91,116;
doc/src/manual/complex-and-rational-numbers.md:184-210,283-305. -/
def ComplexIntegerScalarDivisionCorrect : Prop :=
  ∀ (t s : IntTy) (x : JuliaLean.base.complex.Complex (JInt t)) (y : JInt s),
    let p := t.promote s
    let run := complexIntegerScalarQuotient x y
    ComplexScalarComponentErrors p x.re.val y.val run ∧
    (ComplexScalarComponentReady p x.re.val y.val →
      ComplexScalarComponentErrors p x.im.val y.val run) ∧
    (ComplexScalarComponentReady p x.re.val y.val →
      ComplexScalarComponentReady p x.im.val y.val →
      ∃ q, run = .ok q ∧
        ComplexScalarFractionValue q.re x.re.val y.val ∧
        ComplexScalarFractionValue q.im x.im.val y.val)

end JuliaLean.Proofs.base.rational.Models1Group20


