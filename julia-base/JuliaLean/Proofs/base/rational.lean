    IntTy.i128.min ≤ x.val * y.val ∧ x.val * y.val ≤ IntTy.i128.max := by
  have hx : x.val.natAbs ≤ 18446744073709551615 := by
    have h := x.property
    cases t <;> simp [IntTy.min, IntTy.max, IntTy.bits, IntTy.signed] at h
