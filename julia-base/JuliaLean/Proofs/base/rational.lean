  JuliaLean.base.rational.mulIntRatSource
    (JuliaLean.Proofs.base.rational.Round6.nativePromotion t s)
    JuliaLean.base.rational.promoteIntegerPairYX (dg p p) k x

def publicExactDivideIR {s t : IntTy} (k : JInt s) (y : Rat t) : Jl (Rat (s.promote t)) :=
  let p := IntegerParameters.bits (s.promote t)
  JuliaLean.base.rational.divIntRatSource
    (JuliaLean.Proofs.base.rational.Round6.nativePromotion s t) (dg p p) k y

def publicDivideIR {s t : IntTy} (k : JInt s) (y : Rat t) : Jl (Rat (s.promote t)) :=
  publicExactDivideIR k y

def public_scalar_arithmetic : Prop :=
  ∀ (t s : IntTy) (x : Rat t) (k : JInt s) (hx : Canonical (IntegerParameters.bits t) x),
    let i := IntegerParameters.bits t
    let j := IntegerParameters.bits s
    let p := IntegerParameters.bits (t.promote s)
    let cv := p.fits (rn i x) ∧ p.fits (rd i x) ∧ p.fits (val j k)
    let prod := rd i x * val j k
    let ga : Int := Nat.gcd (rd i x).natAbs (val j k).natAbs
    let gn : Int := Nat.gcd (rn i x).natAbs (val j k).natAbs
    let mn := rn i x * (val j k).tdiv ga
    let md := (rd i x).tdiv ga
    let dn := (rn i x).tdiv gn
    let dd := rd i x * (val j k).tdiv gn
    let divNum := if decide (rd i x = 0 ∧ val j k < 0) then -rn i x else rn i x
    let addRun := publicPlusRI x k
    let subRun := publicMinusRI x k
    let mulRun := publicTimesRI x k
    let divRun := publicExactDivideRI x k
    let slashRun := publicDivideRI x k
    (ScalarOutcome p addRun (rn i x) (rd i x) (val j k) prod (rn i x + prod) ∧
      ScalarOutcome p subRun (rn i x) (rd i x) (val j k) prod (rn i x - prod)) ∧
    (¬ cv → HasError mulRun ∧ HasError divRun ∧ HasError slashRun) ∧
    (cv → ga = 0 → HasError mulRun) ∧
    (cv → ga ≠ 0 → FiniteOutcome p mulRun
      (rn i x * val j k) (rd i x) True (FitsPair p mn md)) ∧
    (cv → gn = 0 → HasError divRun ∧ HasError slashRun) ∧
    (cv → gn ≠ 0 →
      ((p.fits dd ∧ (dd < 0 → FitsPair p (-dn) (-dd)) ∧
          (rd i x = 0 ∧ val j k < 0 → p.fits (-dn))) →
        ExactResult p divRun divNum (rd i x * val j k) ∧
        ExactResult p slashRun divNum (rd i x * val j k)) ∧
      (¬ (p.fits dd ∧ (dd < 0 → FitsPair p (-dn) (-dd)) ∧
          (rd i x = 0 ∧ val j k < 0 → p.fits (-dn))) →
        HasError divRun ∧ HasError slashRun))

def public_integer_left : Prop :=
  ∀ (t s : IntTy) (x : Rat t) (k : JInt s) (hx : Normalized x),
    let p := IntegerParameters.bits (t.promote s)
    let addRun := publicPlusIR k x
    let subRun := publicMinusIR k x
    let mulRun := publicTimesIR k x
    let prod := x.den.val * k.val
    let g : Int := Nat.gcd k.val.natAbs x.den.val.natAbs
    (ScalarOutcome p addRun x.num.val x.den.val k.val prod (prod + x.num.val) ∧
      ScalarOutcome p subRun x.num.val x.den.val k.val prod (prod - x.num.val)) ∧
    (¬ (p.fits k.val ∧ p.fits x.den.val) → HasError mulRun) ∧
    (p.fits k.val → p.fits x.den.val →
      (g = 0 → HasError mulRun) ∧
      (g ≠ 0 →
        (¬ p.fits x.num.val → HasError mulRun) ∧
        (p.fits x.num.val →
          (p.fits (k.val.tdiv g * x.num.val) →
            ExactResult p mulRun (k.val * x.num.val) x.den.val) ∧
          (¬ p.fits (k.val.tdiv g * x.num.val) → HasError mulRun))))

def public_integer_left_quotient : Prop :=
  ∀ (s t : IntTy) (k : JInt s) (y : Rat t) (hy : Normalized y),
    let p := IntegerParameters.bits (s.promote t)
    let run := publicExactDivideIR k y
    let slashRun := publicDivideIR k y
    let cv := p.fits k.val ∧ p.fits y.num.val ∧ p.fits y.den.val
    let g : Int := Nat.gcd k.val.natAbs y.num.val.natAbs
    let dn := k.val.tdiv g * y.den.val
    let dd := y.num.val.tdiv g
    let safe := p.fits dn ∧ (dd < 0 → FitsPair p (-dn) (-dd))
    (¬ cv → HasError run ∧ HasError slashRun) ∧
    (cv → g = 0 → HasError run ∧ HasError slashRun) ∧
    (cv → g ≠ 0 →
      (safe → ExactResult p run (k.val * y.den.val) y.num.val ∧
        ExactResult p slashRun (k.val * y.den.val) y.num.val) ∧
      (¬ safe → HasError run ∧ HasError slashRun))

def mixed_arithmetic : Prop :=
  public_scalar_arithmetic ∧ public_integer_left ∧ public_integer_left_quotient

