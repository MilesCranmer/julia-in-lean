/-- Any exception from selected Rational construction remains the exact
division error together with the world at its throw. This quantifies all
represented Integer/result types, inputs, mutable worlds and constructor
implementations, without a numerical or purity law. The premise is an
observed call outcome, not a correctness assumption.
Source: base/rational.jl:91. -/
def ExactIntegersFailure : Prop :=
  ∀ (World A B R : Type)
    (ops : ExactIntegerOps (EStateM ArrayError World) A B R)
    (num : A) (den : B) (initial after : World) (error : ArrayError),
    ops.rational num den initial = .error error after →
    exactDivideIntegers ops num den initial = .error error after

/-- Integer exact division performs exactly one selected Rational
constructor call, on both success and failure. Mathematical counters are
private specification observations; the arbitrary constructor implementation
receives only the original world and cannot alter them. No callee law is
assumed and no model execution is replayed as an expected output.
Source: base/rational.jl:91. -/
def ExactIntegersSingleCall : Prop :=
  ∀ (World A B R : Type)
    (ops : ExactIntegerOps (EStateM ArrayError World) A B R)
    (num : A) (den : B) (initial : World),
    let observed : ExactIntegerOps
        (EStateM ArrayError (World × Nat × Nat)) A B R := {
      rational := fun n d => observeRationalCall true (ops.rational n d) }
    match exactDivideIntegers observed num den (initial, 0, 0) with
    | .ok _ (_, constructorCalls, otherCalls) => constructorCalls = 1 ∧ otherCalls = 0
    | .error _ (_, constructorCalls, otherCalls) => constructorCalls = 1 ∧ otherCalls = 0

/-- Arbitrary selected constructor failure/world preservation and exact
single-call invariants. The separate native property supplies the numerical
division contract. Source: base/rational.jl:91. -/
def ExactIntegersEffects : Prop := ExactIntegersFailure ∧ ExactIntegersSingleCall

end JuliaLean.Proofs.base.rational.Models2Group10

