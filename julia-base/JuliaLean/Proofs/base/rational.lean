Source: base/rational.jl:20-27. -/
def CheckedDenEffects : Prop :=
  CheckedDenSignbitFailure ∧ CheckedDenSignbitTypeError ∧
  CheckedDenDenominatorFailure ∧ CheckedDenNumeratorFailure ∧
  CheckedDenOriginalConstructorFailure ∧ CheckedDenNegatedConstructorFailure ∧
  CheckedDenNoPrematureStorage ∧ CheckedDenSameDispatchEffects

