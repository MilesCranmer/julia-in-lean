private theorem r81BitsOpsShiftRightVal (t : IntTy) (p : JInt t) (n : Nat)
    (h : n ≤ 128) :
    ((JuliaLean.base.intfuncs.bitsOps t).shiftRight p n).val =
      p.val / (2 : Int) ^ n := by
  have hsh := (JuliaLean.Proofs.base.int.shiftIntCount_proven t p
    (JuliaLean.base.int.lit .i64 (n : Int))).1
  have hlit := r81LitI64ValOfBounds (n : Int) (by omega) (by omega)
  have hpos : (0 : Int) ≤ (JuliaLean.base.int.lit .i64 (n : Int)).val := by
    rw [hlit]
    exact Int.natCast_nonneg n
  rw [if_pos hpos, hlit, Int.toNat_natCast] at hsh
  exact (congrArg Subtype.val (r81BitsOpsShiftRightEq t p n)).trans hsh

private theorem r81BitsLe128 (t : IntTy) : t.bits ≤ 128 := by
  cases t <;> decide

private theorem r81ToNatPosOfPos {z : Int} (h : 0 < z) : 0 < z.toNat := by
  omega

private theorem r81BitsOpsTrailingShift (t : IntTy) (p : JInt t)
    (hp : 0 < (JuliaLean.base.intfuncs.bitsOps t).value p) :
    let tz := (JuliaLean.base.intfuncs.bitsOps t).trailingZeros p
    let q := (JuliaLean.base.intfuncs.bitsOps t).shiftRight p (tz + 1)
    0 ≤ (JuliaLean.base.intfuncs.bitsOps t).value q ∧
      ((JuliaLean.base.intfuncs.bitsOps t).value p).toNat =
        2 ^ tz * (1 + 2 * ((JuliaLean.base.intfuncs.bitsOps t).value q).toNat) := by
  dsimp only
  rw [r81BitsOpsValueEq] at hp ⊢
  have hnonneg : 0 ≤ p.val := Int.le_of_lt hp
  have hpat := JuliaLean.Proofs.base.int.pattern_of_nonneg p hnonneg
  have hlt := JuliaLean.Proofs.base.int.pattern_lt p
  have hpat_pos : 0 < JuliaLean.Proofs.base.int.pattern p := by
    rw [hpat]
    exact r81ToNatPosOfPos hp
  obtain ⟨tz, htz_lt, hfind, heq⟩ :=
    r81FindRangeTestBit t.bits (JuliaLean.Proofs.base.int.pattern p) hpat_pos hlt
  have htz_eq : (JuliaLean.base.intfuncs.bitsOps t).trailingZeros p = tz := by
    rw [r81BitsOpsTrailingZerosEq, r81CttzIntVal p,
      JuliaLean.Proofs.base.int.trailing_zeros_val p, hfind,
      Option.getD_some, Int.toNat_natCast]
  rw [htz_eq, r81BitsOpsShiftRightVal t p (tz + 1)
    (Nat.le_trans htz_lt (r81BitsLe128 t))]
  have hpow_pos : (0 : Int) < (2 : Int) ^ (tz + 1) := Int.pow_pos (by decide)
  have hq0 : 0 ≤ p.val / (2 : Int) ^ (tz + 1) :=
    Int.ediv_nonneg hnonneg (Int.le_of_lt hpow_pos)
  refine ⟨hq0, ?_⟩
  have hdiv_nat :
      (p.val / (2 : Int) ^ (tz + 1)).toNat =
        (JuliaLean.Proofs.base.int.pattern p) / 2 ^ (tz + 1) := by
    have h1 :
        (((JuliaLean.Proofs.base.int.pattern p) / 2 ^ (tz + 1) : Nat) : Int) =
          p.val / (2 : Int) ^ (tz + 1) := by
      rw [Int.natCast_ediv, hpat, Int.toNat_of_nonneg hnonneg, Int.natCast_pow]
      rfl
    rw [← h1, Int.toNat_natCast]
  rw [r81BitsOpsValueEq, ← hpat, hdiv_nat]
  exact heq

private def r81One (t : IntTy) : Rat t :=
  ⟨JInt.lit t 1, JInt.lit t 1⟩

private def r81MulOp {t : IntTy} (a b : Rat t) : Rat t :=
  ⟨JuliaLean.base.int.mul a.num b.num, JuliaLean.base.int.mul a.den b.den⟩

private def r81PowerRat (t : IntTy) (x : Rat t) (k : Nat) : Rat t :=
  ⟨JInt.wrap t (x.num.val ^ k), JInt.wrap t (x.den.val ^ k)⟩

private theorem r81JIntMulAssoc (t : IntTy) (a b c : JInt t) :
    JuliaLean.base.int.mul (JuliaLean.base.int.mul a b) c =
      JuliaLean.base.int.mul a (JuliaLean.base.int.mul b c) := by
  apply Subtype.ext
  simp only [JuliaLean.base.int.mul, JuliaLean.Proofs.base.int.mul_int_val]
  rw [JuliaLean.Proofs.base.int.wrapInt_mul_left,
    JuliaLean.Proofs.base.int.wrapInt_mul_right, Int.mul_assoc]

private theorem r81JIntMulOneLeft (t : IntTy) (a : JInt t) :
    JuliaLean.base.int.mul (JInt.lit t 1) a = a := by
  apply Subtype.ext
  have h1 : (JInt.lit t 1).val = 1 := by cases t <;> decide
  rw [JuliaLean.base.int.mul, JuliaLean.Proofs.base.int.mul_int_val,
    h1, Int.one_mul, wrapInt_of_inRange t a.val a.property]

private theorem r81JIntMulOneRight (t : IntTy) (a : JInt t) :
    JuliaLean.base.int.mul a (JInt.lit t 1) = a := by
  apply Subtype.ext
  have h1 : (JInt.lit t 1).val = 1 := by cases t <;> decide
  rw [JuliaLean.base.int.mul, JuliaLean.Proofs.base.int.mul_int_val,
    h1, Int.mul_one, wrapInt_of_inRange t a.val a.property]

private theorem r81MulOpAssoc (t : IntTy) (a b c : Rat t) :
    r81MulOp (r81MulOp a b) c = r81MulOp a (r81MulOp b c) := by
  ext
  · simpa [r81MulOp] using congrArg Subtype.val (r81JIntMulAssoc t a.num b.num c.num)
  · simpa [r81MulOp] using congrArg Subtype.val (r81JIntMulAssoc t a.den b.den c.den)

private theorem r81MulOpOneLeft (t : IntTy) (a : Rat t) :
    r81MulOp (r81One t) a = a := by
  ext
  · simpa [r81MulOp, r81One] using congrArg Subtype.val (r81JIntMulOneLeft t a.num)
  · simpa [r81MulOp, r81One] using congrArg Subtype.val (r81JIntMulOneLeft t a.den)

private theorem r81MulOpOneRight (t : IntTy) (a : Rat t) :
    r81MulOp a (r81One t) = a := by
  ext
  · simpa [r81MulOp, r81One] using congrArg Subtype.val (r81JIntMulOneRight t a.num)
  · simpa [r81MulOp, r81One] using congrArg Subtype.val (r81JIntMulOneRight t a.den)

private theorem r81MonoidPowPowerRat (t : IntTy) (x : Rat t) :
    ∀ k : Nat, r81MonoidPow (r81MulOp (t := t)) (r81One t) x k =
      r81PowerRat t x k
  | 0 => by
      change r81One t = r81PowerRat t x 0
      apply Rational.ext
      · apply Subtype.ext
        simp [r81One, r81PowerRat, JInt.lit, JInt.wrap]
      · apply Subtype.ext
        simp [r81One, r81PowerRat, JInt.lit, JInt.wrap]
  | k + 1 => by
      rw [r81MonoidPow, r81MonoidPowPowerRat t x k]
      apply Rational.ext
      · apply Subtype.ext
        simp only [r81MulOp, r81PowerRat, JInt.wrap,
          JuliaLean.base.int.mul, JuliaLean.Proofs.base.int.mul_int_val]
        rw [JuliaLean.Proofs.base.int.wrapInt_mul_left, Int.pow_succ]
      · apply Subtype.ext
        simp only [r81MulOp, r81PowerRat, JInt.wrap,
          JuliaLean.base.int.mul, JuliaLean.Proofs.base.int.mul_int_val]
        rw [JuliaLean.Proofs.base.int.wrapInt_mul_left, Int.pow_succ]

private theorem r81IntNatAbsPow (x : Int) :
    ∀ k : Nat, (x ^ k).natAbs = x.natAbs ^ k
  | 0 => by simp
  | k + 1 => by
    rw [Int.pow_succ, Int.natAbs_mul, r81IntNatAbsPow x k, Nat.pow_succ]

private theorem r81PowerRatValues (t : IntTy) (x : Rat t) (k : Nat)
    (hnum : IntegerParameters.fits (.bits t) (x.num.val ^ k))
    (hden : IntegerParameters.fits (.bits t) (x.den.val ^ k)) :
    (r81PowerRat t x k).num.val = x.num.val ^ k ∧
      (r81PowerRat t x k).den.val = x.den.val ^ k := by
  have hnum' : t.min ≤ x.num.val ^ k ∧ x.num.val ^ k ≤ t.max := by
    simpa [IntegerParameters.fits] using hnum
  have hden' : t.min ≤ x.den.val ^ k ∧ x.den.val ^ k ≤ t.max := by
    simpa [IntegerParameters.fits] using hden
  constructor
  · change wrapInt t (x.num.val ^ k) = x.num.val ^ k
    exact wrapInt_of_inRange t _ hnum'
  · change wrapInt t (x.den.val ^ k) = x.den.val ^ k
    exact wrapInt_of_inRange t _ hden'

private theorem r81DgBitsCoprime {t s : IntTy} (u : JInt t) (v : JInt s)
    (hcop : Nat.Coprime u.val.natAbs v.val.natAbs) :
    JuliaLean.Proofs.base.rational.DivGcdCtorLemmas.dgBits u v = .ok (u, v) := by
  change JuliaLean.Proofs.base.rational.DivGcdCtorLemmas.dgBits u v = .ok (u, v)
  have hcop' : Nat.gcd u.val.natAbs v.val.natAbs = 1 := hcop
  have hG : (Nat.gcd u.val.natAbs v.val.natAbs : Int) = 1 := by
    exact_mod_cast hcop'
  have hg : (Nat.gcd u.val.natAbs v.val.natAbs : Int) ≠ 0 := by
    rw [hG]
    decide
  obtain ⟨a, b, hrun, hau, hbv, _, _, _, _, _, _⟩ :=
    JuliaLean.Proofs.base.rational.DivGcdCtorLemmas.dgBits_spec u v |>.2 hg
  have ha : a.val = u.val := by
    simpa [hG] using hau
  have hb : b.val = v.val := by
    simpa [hG] using hbv
  have ha' : a = u := Subtype.ext ha
  have hb' : b = v := Subtype.ext hb
  rw [ha', hb'] at hrun
  exact hrun

private theorem r81CheckedMulFits (t : IntTy) (a b : JInt t)
    (hfit : t.min ≤ a.val * b.val ∧ a.val * b.val ≤ t.max) :
    JuliaLean.base.checked.checkedMulBits a b =
      .ok (JInt.wrap t (a.val * b.val)) := by
  have h := JuliaLean.Proofs.base.checked.mulExact t a b
  unfold JuliaLean.Proofs.base.checked.ExactOrOverflow at h
  rw [if_pos hfit] at h
  obtain ⟨z, hcall, hval⟩ := h
  have hz : z = JInt.wrap t (a.val * b.val) := by
    apply Subtype.ext
    change z.val = wrapInt t (a.val * b.val)
    rw [hval, wrapInt_of_inRange t _ hfit]
  rw [hcall, hz]

private theorem r81MulPowerExact (t : IntTy) (x : Rat t) (cap : Nat)
    (hfit : ∀ k : Nat, k ≤ cap →
      IntegerParameters.fits (.bits t) (x.num.val ^ k) ∧
      IntegerParameters.fits (.bits t) (x.den.val ^ k))
    (hnorm : Normalized x) (m n : Nat) (hmn : m + n ≤ cap) :
    mulRatRatSource (samePromoteOps (nativeOps t)) (dg (.bits t) (.bits t))
      (r81PowerRat t x m) (r81PowerRat t x n) =
        .ok (r81PowerRat t x (m + n)) := by
  let a := r81PowerRat t x m
  let b := r81PowerRat t x n
  have hm : m ≤ cap := by omega
  have hn : n ≤ cap := by omega
  have hma := r81PowerRatValues t x m (hfit m hm).1 (hfit m hm).2
  have hnb := r81PowerRatValues t x n (hfit n hn).1 (hfit n hn).2
  have hsum := r81PowerRatValues t x (m + n) (hfit (m + n) hmn).1
    (hfit (m + n) hmn).2
  have hcopBase : Nat.Coprime x.num.val.natAbs x.den.val.natAbs := hnorm.2
  have hcop1 : Nat.Coprime (x.num.val.natAbs ^ m) (x.den.val.natAbs ^ n) := by
    exact Nat.Coprime.pow_right n (Nat.Coprime.pow_left m hcopBase)
  have hcop2 : Nat.Coprime (x.den.val.natAbs ^ m) (x.num.val.natAbs ^ n) := by
    exact Nat.Coprime.pow_right n
      (Nat.Coprime.pow_left m hcopBase.symm)
  have hnumAbsA : (x.num.val ^ m).natAbs = x.num.val.natAbs ^ m :=
    r81IntNatAbsPow x.num.val m
  have hdenAbsB : (x.den.val ^ n).natAbs = x.den.val.natAbs ^ n :=
    r81IntNatAbsPow x.den.val n
  have hdenAbsA : (x.den.val ^ m).natAbs = x.den.val.natAbs ^ m :=
    r81IntNatAbsPow x.den.val m
  have hnumAbsB : (x.num.val ^ n).natAbs = x.num.val.natAbs ^ n :=
    r81IntNatAbsPow x.num.val n
  have hcross1 : Nat.Coprime a.num.val.natAbs b.den.val.natAbs := by
    rw [hma.1, hnb.2, hnumAbsA, hdenAbsB]
    exact hcop1
  have hcross2 : Nat.Coprime a.den.val.natAbs b.num.val.natAbs := by
    rw [hma.2, hnb.1, hdenAbsA, hnumAbsB]
    exact hcop2
  have hdg1 : dg (.bits t) (.bits t) a.num b.den = .ok (a.num, b.den) := by
    change JuliaLean.Proofs.base.rational.DivGcdCtorLemmas.dgBits a.num b.den =
      .ok (a.num, b.den)
    exact r81DgBitsCoprime a.num b.den hcross1
  have hdg2 : dg (.bits t) (.bits t) a.den b.num = .ok (a.den, b.num) := by
    change JuliaLean.Proofs.base.rational.DivGcdCtorLemmas.dgBits a.den b.num =
      .ok (a.den, b.num)
    exact r81DgBitsCoprime a.den b.num hcross2
  have hnumProduct : a.num.val * b.num.val = x.num.val ^ (m + n) := by
    rw [hma.1, hnb.1, ← Int.pow_add]
  have hdenProduct : a.den.val * b.den.val = x.den.val ^ (m + n) := by
    rw [hma.2, hnb.2, ← Int.pow_add]
  have hnumFit : t.min ≤ a.num.val * b.num.val ∧
      a.num.val * b.num.val ≤ t.max := by
    rw [hnumProduct]
    simpa [IntegerParameters.fits] using (hfit (m + n) hmn).1
  have hdenFit : t.min ≤ a.den.val * b.den.val ∧
      a.den.val * b.den.val ≤ t.max := by
    rw [hdenProduct]
    simpa [IntegerParameters.fits] using (hfit (m + n) hmn).2
  have hcheckedNum :
      (nativeOps t).checkedMul a.num b.num =
        .ok (r81PowerRat t x (m + n)).num := by
    change JuliaLean.base.checked.checkedMulBits a.num b.num =
      .ok (r81PowerRat t x (m + n)).num
    rw [r81CheckedMulFits t a.num b.num hnumFit]
    congr 1
    apply Subtype.ext
    change wrapInt t (a.num.val * b.num.val) =
      wrapInt t (x.num.val ^ (m + n))
    rw [hnumProduct]
  have hcheckedDen :
      (nativeOps t).checkedMul a.den b.den =
        .ok (r81PowerRat t x (m + n)).den := by
    change JuliaLean.base.checked.checkedMulBits a.den b.den =
      .ok (r81PowerRat t x (m + n)).den
    rw [r81CheckedMulFits t a.den b.den hdenFit]
    congr 1
    apply Subtype.ext
    change wrapInt t (a.den.val * b.den.val) =
      wrapInt t (x.den.val ^ (m + n))
    rw [hdenProduct]
  change mulRatRatSource (samePromoteOps (nativeOps t)) (dg (.bits t) (.bits t))
    a b = .ok (r81PowerRat t x (m + n))
  simp [mulRatRatSource, samePromoteOps, hdg1, hdg2, hcheckedNum, hcheckedDen,
    Bind.bind, Except.bind, Functor.map, Pure.pure, Except.pure]

private theorem r81PowerSquares_checked {T : Type} (mulOp : T → T → T) (one x : T)
    (mul : T → T → Jl T) (cap : Nat)
    (hmul : ∀ a b : Nat, a + b ≤ cap →
      mul (r81MonoidPow mulOp one x a) (r81MonoidPow mulOp one x b) =
        .ok (r81MonoidPow mulOp one x (a + b))) :
    ∀ (k m : Nat), m * 2 ^ k ≤ cap →
      JuliaLean.base.intfuncs.powerSquares mul k
        (r81MonoidPow mulOp one x m) =
          .ok (r81MonoidPow mulOp one x (m * 2 ^ k)) := by
  intro k
  induction k with
  | zero =>
    intro m hm
    simp [JuliaLean.base.intfuncs.powerSquares,
      JuliaLean.base.intfuncs.repeatM, r81MonoidPow, Pure.pure, Except.pure]
  | succ k ih =>
    intro m hm
    have hpowSucc : 2 ≤ 2 ^ (k + 1) := by
      have hpow : 1 ≤ 2 ^ k := Nat.one_le_pow _ _ (by decide)
      rw [Nat.pow_succ]
      omega
    have hmulBound : m + m ≤ cap := by
      calc
        m + m = m * 2 := by omega
        _ ≤ m * 2 ^ (k + 1) := Nat.mul_le_mul_left m hpowSucc
        _ ≤ cap := hm
    have hsq : mul (r81MonoidPow mulOp one x m) (r81MonoidPow mulOp one x m) =
        .ok (r81MonoidPow mulOp one x (m * 2)) := by
      have hs := hmul m m hmulBound
      rw [show m + m = m * 2 by omega] at hs
      exact hs
    have hpow : m * 2 ^ (k + 1) = (m * 2) * 2 ^ k := by
      rw [Nat.pow_succ]
      calc
        m * (2 ^ k * 2) = m * (2 * 2 ^ k) := by rw [Nat.mul_comm (2 ^ k) 2]
        _ = (m * 2) * 2 ^ k := by rw [← Nat.mul_assoc]
    have hrestBound : (m * 2) * 2 ^ k ≤ cap := by
      rw [← hpow]
      exact hm
    rw [JuliaLean.base.intfuncs.powerSquares, r81RepeatM_succ]
    simp only [Bind.bind, Except.bind, Pure.pure, Except.pure, hsq]
    change JuliaLean.base.intfuncs.powerSquares mul k
      (r81MonoidPow mulOp one x (m * 2)) =
        .ok (r81MonoidPow mulOp one x (m * 2 ^ (k + 1)))
    rw [ih (m * 2) hrestBound]
    rw [← hpow]

private theorem r81PowerLoop_checked {T E : Type} (eo : JuliaLean.base.intfuncs.IntegerOps E)
    (mulOp : T → T → T) (one x : T) (mul : T → T → Jl T) (cap : Nat)
    (hmul : ∀ a b : Nat, a + b ≤ cap →
      mul (r81MonoidPow mulOp one x a) (r81MonoidPow mulOp one x b) =
        .ok (r81MonoidPow mulOp one x (a + b)))
    (hdecomp : ∀ p : E, 0 < eo.value p →
      let tz := eo.trailingZeros p
      let q := eo.shiftRight p (tz + 1)
      0 ≤ eo.value q ∧ (eo.value p).toNat = 2 ^ tz * (1 + 2 * (eo.value q).toNat)) :
    ∀ (fuel m y : Nat) (p : E), 0 ≤ eo.value p →
      (eo.value p).toNat ≤ fuel →
      y + m * 2 * (eo.value p).toNat ≤ cap →
      JuliaLean.base.intfuncs.powerLoop eo mul fuel
        (r81MonoidPow mulOp one x m) (r81MonoidPow mulOp one x y) p =
          .ok (r81MonoidPow mulOp one x
            (y + m * 2 * (eo.value p).toNat)) := by
  intro fuel
  induction fuel with
  | zero =>
    intro m y p hp hfuel hbound
    have hp0 : (eo.value p).toNat = 0 := by omega
    simp [JuliaLean.base.intfuncs.powerLoop, hp0, Pure.pure, Except.pure]
  | succ fuel ih =>
    intro m y p hp hfuel hbound
    unfold JuliaLean.base.intfuncs.powerLoop
    by_cases hle0 : eo.value p ≤ 0
    · simp only [if_pos hle0]
      have hp0 : (eo.value p).toNat = 0 := by omega
      simp [hp0, Pure.pure, Except.pure]
    · simp only [if_neg hle0]
      have hpos : 0 < eo.value p := by omega
      obtain ⟨hq0, hpexp⟩ := hdecomp p hpos
      let tz := eo.trailingZeros p
      let q := eo.shiftRight p (tz + 1)
      have hq_lt : (eo.value q).toNat < (eo.value p).toNat := by
        have hpow : 0 < 2 ^ tz := Nat.two_pow_pos _
        have honele : 1 ≤ 2 ^ tz := by omega
        have hqsmall : (eo.value q).toNat < 1 + 2 * (eo.value q).toNat := by omega
        have hfactor :
            1 + 2 * (eo.value q).toNat ≤
              2 ^ tz * (1 + 2 * (eo.value q).toNat) := by
          calc
            1 + 2 * (eo.value q).toNat =
                1 * (1 + 2 * (eo.value q).toNat) := by simp
            _ ≤ 2 ^ tz * (1 + 2 * (eo.value q).toNat) :=
              Nat.mul_le_mul_right _ honele
        change (eo.value p).toNat =
          2 ^ tz * (1 + 2 * (eo.value q).toNat) at hpexp
        rw [hpexp]
        omega
      have hpow : 2 ^ (tz + 1) = 2 ^ tz * 2 := by rw [Nat.pow_succ]
      have hfactor : 2 ^ tz ≤ 2 ^ tz * (1 + 2 * (eo.value q).toNat) := by
        calc
          2 ^ tz = 2 ^ tz * 1 := by simp
          _ ≤ 2 ^ tz * (1 + 2 * (eo.value q).toNat) :=
            Nat.mul_le_mul_left _ (by omega)
      have hbase : m * 2 * 2 ^ tz ≤ m * 2 * (eo.value p).toNat := by
        rw [hpexp]
        exact Nat.mul_le_mul_left _ hfactor
      have hpowmul : m * 2 ^ (tz + 1) = m * 2 * 2 ^ tz := by
        rw [Nat.pow_succ]
        calc
          m * (2 ^ tz * 2) = m * (2 * 2 ^ tz) := by
            rw [Nat.mul_comm (2 ^ tz) 2]
          _ = m * 2 * 2 ^ tz := by rw [Nat.mul_assoc]
      have hsqBound : m * 2 ^ (tz + 1) ≤ cap := by
        rw [hpowmul]
        omega
      have hsq := r81PowerSquares_checked mulOp one x mul cap hmul
        (tz + 1) m hsqBound
      have hmulYBound : y + m * 2 ^ (tz + 1) ≤ cap := by
        have hsquare : m * 2 ^ (tz + 1) ≤ m * 2 * (eo.value p).toNat := by
          rw [hpowmul, hpexp]
          exact Nat.mul_le_mul_left _ hfactor
        omega
      have hmulY := hmul y (m * 2 ^ (tz + 1)) hmulYBound
      have hnewY :
          y + m * 2 ^ (tz + 1) +
              (m * 2 ^ (tz + 1)) * 2 * (eo.value q).toNat =
            y + m * 2 * (eo.value p).toNat := by
        have hdist :
            m * 2 * (2 ^ tz * (1 + 2 * (eo.value q).toNat)) =
              m * 2 * 2 ^ tz + m * 2 * (2 ^ tz * (2 * (eo.value q).toNat)) := by
          rw [Nat.mul_add, Nat.mul_one, Nat.mul_add]
        rw [hpowmul, hpexp, hdist]
        simp only [Nat.mul_assoc]
        omega
      have hqbound : y + m * 2 ^ (tz + 1) +
          (m * 2 ^ (tz + 1)) * 2 * (eo.value q).toNat ≤ cap := by
        rw [hnewY]
        exact hbound
      have hqfuel : (eo.value q).toNat ≤ fuel := by omega
      change (do
        let xx ← JuliaLean.base.intfuncs.powerSquares mul (tz + 1)
          (r81MonoidPow mulOp one x m)
        let yy ← mul (r81MonoidPow mulOp one x y) xx
        JuliaLean.base.intfuncs.powerLoop eo mul fuel xx yy q) =
          .ok (r81MonoidPow mulOp one x (y + m * 2 * (eo.value p).toNat))
      simp only [Bind.bind, Except.bind.eq_def, hsq, hmulY]
      rw [ih (m * 2 ^ (tz + 1))
        (y + m * 2 ^ (tz + 1)) q hq0 hqfuel hqbound]
      rw [hnewY]

private theorem r81PowerBySquaring_checked {T E : Type}
    (eo : JuliaLean.base.intfuncs.IntegerOps E) (mulOp : T → T → T)
    (one x : T) (mul : T → T → Jl T) (cap : Nat) (hcap2 : 2 ≤ cap)
    (hmul : ∀ a b : Nat, a + b ≤ cap →
      mul (r81MonoidPow mulOp one x a) (r81MonoidPow mulOp one x b) =
        .ok (r81MonoidPow mulOp one x (a + b)))
    (honeL : ∀ a : T, mulOp one a = a)
    (honeR : ∀ a : T, mulOp a one = a)
    (oneFn : T → T) (hone : oneFn x = one)
    (convertOther : T → Jl T) (neg : T → Jl T) (isone : T → Bool)
    (throwDomerr : T → E → Jl T)
    (hdecomp : ∀ p : E, 0 < eo.value p →
      let tz := eo.trailingZeros p
      let q := eo.shiftRight p (tz + 1)
      0 ≤ eo.value q ∧ (eo.value p).toNat = 2 ^ tz * (1 + 2 * (eo.value q).toNat))
    (p : E) (hp : 0 ≤ eo.value p) (hpNat : (eo.value p).toNat ≤ cap) :
    JuliaLean.base.intfuncs.powerBySquaring eo mul true (fun z => .ok z)
      convertOther (fun z => .ok z) id oneFn neg isone mul true x p throwDomerr =
      .ok (r81MonoidPow mulOp one x (eo.value p).toNat) := by
  have hsq : mul x x = .ok (r81MonoidPow mulOp one x 2) := by
    have h := hmul 1 1 (by omega)
    simpa [r81MonoidPow, honeL] using h
  unfold JuliaLean.base.intfuncs.powerBySquaring
  rw [hsq]
  simp only [Bind.bind, Except.bind.eq_def, if_true]
  by_cases hp1 : eo.value p = 1
  · simp [hp1, r81MonoidPow, honeL, Pure.pure, Except.pure]
  · rw [if_neg hp1]
    by_cases hp0 : eo.value p = 0
    · simp [hp0, r81MonoidPow, hone, Pure.pure, Except.pure]
    · rw [if_neg hp0]
      by_cases hp2 : eo.value p = 2
      · simp [hp2, r81MonoidPow, honeL, Pure.pure, Except.pure]
      · rw [if_neg hp2, if_neg (by omega : ¬ eo.value p < 0)]
        have hpos : 0 < eo.value p := by omega
        obtain ⟨hq0, hpexp⟩ := hdecomp p hpos
        let tz := eo.trailingZeros p
        let q := eo.shiftRight p (tz + 1)
        change (eo.value p).toNat =
          2 ^ tz * (1 + 2 * (eo.value q).toNat) at hpexp
        change 0 ≤ eo.value q at hq0
        have hqNat : (eo.value q).natAbs = (eo.value q).toNat := by omega
        have honeFactor : 1 ≤ 1 + 2 * (eo.value q).toNat := by omega
        have hpowerBase : 2 ^ tz ≤
            2 ^ tz * (1 + 2 * (eo.value q).toNat) := by
          calc
            2 ^ tz = 2 ^ tz * 1 := by simp
            _ ≤ 2 ^ tz * (1 + 2 * (eo.value q).toNat) :=
              Nat.mul_le_mul_left _ honeFactor
        have hsum :
            2 ^ tz + 2 ^ tz * 2 * (eo.value q).toNat =
              2 ^ tz * (1 + 2 * (eo.value q).toNat) := by
          calc
            2 ^ tz + 2 ^ tz * 2 * (eo.value q).toNat =
                2 ^ tz + 2 ^ tz * (2 * (eo.value q).toNat) := by
                  rw [Nat.mul_assoc]
            _ = 2 ^ tz * (1 + 2 * (eo.value q).toNat) := by
                  rw [Nat.mul_add, Nat.mul_one]
        have hfinal := hsum.trans hpexp.symm
        have hloopBound :
            2 ^ tz + 2 ^ tz * 2 * (eo.value q).toNat ≤ (eo.value p).toNat := by
          rw [hfinal]
          exact Nat.le_refl _
        have hloopBoundCap := Nat.le_trans hloopBound hpNat
        have hloop := r81PowerLoop_checked eo mulOp one x mul cap hmul hdecomp
          (eo.value q).toNat (2 ^ tz) (2 ^ tz) q hq0
          (Nat.le_refl _) hloopBoundCap
        have hloop' :
            JuliaLean.base.intfuncs.powerLoop eo mul
              (eo.value (eo.shiftRight p (eo.trailingZeros p + 1))).natAbs
              (r81MonoidPow mulOp one x (2 ^ eo.trailingZeros p))
              (r81MonoidPow mulOp one x (2 ^ eo.trailingZeros p))
              (eo.shiftRight p (eo.trailingZeros p + 1)) =
                .ok (r81MonoidPow mulOp one x (eo.value p).toNat) := by
          simpa [q, tz, hqNat, hfinal] using hloop
        by_cases htz : tz + 1 > 1
        · rw [if_pos htz]
          simp only [Pure.pure, Except.pure]
          have htzPos : 0 < tz := by omega
          have htzPow : 2 * 2 ^ (tz - 1) = 2 ^ tz := by
            cases htzCase : tz with
            | zero =>
              have : False := by simpa [htzCase] using htzPos
              exact False.elim this
            | succ k => simp [htzCase, Nat.pow_succ, Nat.mul_comm]
          have hpowerBound : 2 * 2 ^ (tz - 1) ≤ (eo.value p).toNat := by
            rw [htzPow, hpexp]
            exact hpowerBase
          have hpowerBoundCap := Nat.le_trans hpowerBound hpNat
          have hps := r81PowerSquares_checked mulOp one x mul cap hmul
            (tz - 1) 2 hpowerBoundCap
          have htzEq : eo.trailingZeros p = tz := rfl
          have hstep :
              eo.trailingZeros p + 1 - 1 - 1 = tz - 1 := by
            rw [htzEq]
            omega
          rw [hstep]
          simp only [hps, htzPow, Bind.bind, Except.bind.eq_def]
          rw [hloop']
        · rw [if_neg htz]
          simp only [Pure.pure, Except.pure]
          have htz0 : tz = 0 := by omega
          have hstep : eo.trailingZeros p + 1 - 1 - 1 = 0 := by omega
          rw [hstep]
          have hps0 :
              JuliaLean.base.intfuncs.powerSquares mul 0 x =
                .ok (r81MonoidPow mulOp one x (2 ^ tz)) := by
            rw [htz0]
            simp [JuliaLean.base.intfuncs.powerSquares,
              JuliaLean.base.intfuncs.repeatM, r81MonoidPow, honeL,
              Pure.pure, Except.pure]
          simp only [hps0, Bind.bind, Except.bind.eq_def]
          simpa [tz, htz0, r81MonoidPow, honeL] using hloop'

private theorem r81PowerRatCanonical (t : IntTy) (x : Rat t) (k : Nat)
    (hnorm : Normalized x)
    (hnum : IntegerParameters.fits (.bits t) (x.num.val ^ k))
    (hden : IntegerParameters.fits (.bits t) (x.den.val ^ k)) :
    Canonical (.bits t) (r81PowerRat t x k) := by
  have hvalues := r81PowerRatValues t x k hnum hden
  have hcopBase : Nat.Coprime x.num.val.natAbs x.den.val.natAbs := hnorm.2
  have hcopPow : Nat.Coprime (x.num.val.natAbs ^ k) (x.den.val.natAbs ^ k) := by
    exact Nat.Coprime.pow_right k (Nat.Coprime.pow_left k hcopBase)
  change 0 ≤ (r81PowerRat t x k).den.val ∧
    Nat.gcd (r81PowerRat t x k).num.val.natAbs
      (r81PowerRat t x k).den.val.natAbs = 1
  constructor
  · rw [hvalues.2]
    exact Int.pow_nonneg hnorm.1
  · rw [hvalues.1, hvalues.2, r81IntNatAbsPow x.num.val k,
      r81IntNatAbsPow x.den.val k]
    exact hcopPow

private theorem r81PowerRatRepresents (t : IntTy) (x : Rat t) (k : Nat)
    (hnorm : Normalized x)
    (hnum : IntegerParameters.fits (.bits t) (x.num.val ^ k))
    (hden : IntegerParameters.fits (.bits t) (x.den.val ^ k)) :
    Represents (.bits t) (r81PowerRat t x k) (x.num.val ^ k) (x.den.val ^ k) := by
  have hvalues := r81PowerRatValues t x k hnum hden
  refine ⟨r81PowerRatCanonical t x k hnorm hnum hden, ?_, ?_, ?_⟩
  · change (r81PowerRat t x k).num.val * x.den.val ^ k =
      x.num.val ^ k * (r81PowerRat t x k).den.val
    rw [hvalues.1, hvalues.2]
  · intro hd
    cases k with
    | zero =>
        change 0 < (r81PowerRat t x 0).den.val
        rw [hvalues.2]
        simp
    | succ k =>
        have hbase : 0 < x.den.val := by
          by_cases hz : x.den.val = 0
          · have hzero : x.den.val ^ (k + 1) = 0 := by
              rw [hz, Int.pow_succ]
              simp
            exact False.elim (hd hzero)
          · have hnonneg : 0 ≤ x.den.val := hnorm.1
            omega
        change 0 < (r81PowerRat t x (k + 1)).den.val
        rw [hvalues.2]
        exact Int.pow_pos hbase
  · intro hd
    constructor
    · change (r81PowerRat t x k).den.val = 0
      rw [hvalues.2, hd]
    · change intSign (r81PowerRat t x k).num.val =
        intSign (x.num.val ^ k)
      rw [hvalues.1]

private theorem r81OneRat_eq (t : IntTy) (x : Rat t) :
    oneRat t x = r81One t := by
  have hconvert (t : IntTy) :
      JuliaLean.base.int.convert t (JInt.lit .i64 1) = .ok (JInt.lit t 1) := by
    cases t <;>
      simp [JuliaLean.base.int.convert, JInt.convert, JInt.lit, JInt.wrap,
        wrapInt, IntTy.min, IntTy.max, IntTy.signed, IntTy.bits] <;> omega
  have hrun : oneRatRun t x = .ok (r81One t) := by
    simp [oneRatRun, r81One, JuliaLean.base.number.oneValue,
      JuliaLean.base.number.oneType, JuliaLean.base.rational.rationalIntAsSource,
      hconvert, Bind.bind, Except.bind, Functor.map, Except.map,
      Pure.pure, Except.pure]
  unfold oneRat
  exact JuliaLean.Proofs.base.int.okOf_eq hrun

end Round6

namespace Round9

open JuliaLean JuliaLean.Promotion JuliaLean.base.rational
set_option maxRecDepth 4096

open JuliaLean.Proofs.base.rational.Round4 in
def float_roundtrip : Prop :=
  ∀ {T : Type} (i : IntegerParameters T)
    (o : JuliaLean.base.math.IEEEOps .f32 × JuliaLean.base.math.IEEEOps .f64)
    (showF : JuliaLean.base.float.FV .f64 → String) (x : JuliaLean.base.float.FV .f64)
    (q : Rational T),
    let f := FloatParameters.ieee .f64 o
    exactFromFloat i f showF x = some (.ok q) →
      Canonical i q ∧
      (rn i q = 0 → rd i q = 1) ∧
      (rd i q = 0 → (rn i q).natAbs = 1) ∧
      f.eq x (toFloat i f q) = true

open JuliaLean.Proofs.base.rational.Round4 in
def hash_value : Prop :=
  ∀ (t : IntTy) (ht : t ≠ .i128 ∧ t ≠ .u128)
    (o : JuliaLean.base.math.IEEEOps .f64) (q : Rat t) (seed : JInt .u64)
    (hq : Normalized q) (hhalf : q.den.val = 2)
    (x : JuliaLean.base.float.FV .f64)
    (hx : JuliaLean.base.float.isfinite_IEEEFloat x = true)
    (hval : (Fl.toRat x).1 * q.den.val = q.num.val * (Fl.toRat x).2),
    hashRat ht o q seed = JuliaLean.base.hashing.hashFloat64Canonical x seed

open JuliaLean.Proofs.base.rational.Round5 in
def float_equality : Prop :=
  ∀ (t : IntTy) (f : JuliaLean.base.float.FTy)
    (o : JuliaLean.base.math.IEEEOps .f32 × JuliaLean.base.math.IEEEOps .f64)
    (eqFF : JuliaLean.base.float.FV f → JuliaLean.base.float.FV .f64 → Bool)
    (q : Rat t) (x : JuliaLean.base.float.FV f) (hq : Normalized q)
    (hx : JuliaLean.base.float.isfinite_IEEEFloat x = true),
    let fp := FloatParameters.ieee f o
    let subOne := fun n : JInt t => JuliaLean.base.int.binop JuliaLean.base.int.sub n (JInt.lit .i64 1)
    let div := JuliaLean.base.int.fdiv_BitInteger JuliaLean.base.float.float_BitInteger
      JuliaLean.base.float.float_BitInteger JuliaLean.base.float.div_IEEEFloat
    let left := eqFloatRatSource JuliaLean.base.float.isfinite_IEEEFloat
      JuliaLean.base.int.count_ones (fun n => JuliaLean.base.int.eq n (JInt.lit .i64 1))
      subOne JuliaLean.base.int.top_set_bit (fun x e => fp.ldexp x e.val)
      JuliaLean.base.float.eq_FI div eqFF x q
    let right := eqRatFloatSource JuliaLean.base.float.isfinite_IEEEFloat
      JuliaLean.base.int.count_ones (fun n => JuliaLean.base.int.eq n (JInt.lit .i64 1))
      subOne JuliaLean.base.int.top_set_bit (fun x e => fp.ldexp x e.val)
      JuliaLean.base.float.eq_FI div eqFF q x
    (q.den.val > 0 → (¬ ∃ k : Nat, q.den.val = 2^k) → left = false ∧ right = false) ∧
    (q.den.val = 1 →
      left = decide ((Fl.toRat x).1 = q.num.val * (Fl.toRat x).2) ∧
      right = decide ((Fl.toRat x).1 = q.num.val * (Fl.toRat x).2))

end Round9

namespace Round10

open JuliaLean JuliaLean.Promotion JuliaLean.base.rational
set_option maxRecDepth 4096

def boolEqInt (b : Bool) (n : JInt .i64) : Bool :=
  JuliaLean.base.int.eq (JuliaLean.base.int.ofBool .i64 b) n

def bool_rounding_bool_target : Prop :=
  ∀ (x : Rational Bool) (mode : Rounding) (hvalid : x.num = true ∨ x.den = true),
    let eqLit := fun (q : Rational Bool) (n : Int) =>
      eqRatIntSource (fun b => boolEqInt b (JInt.lit .i64 1)) boolEqInt q (JInt.lit .i64 n)
    let run := roundBoolRationalSource Bool true
      (fun q => boolOfRatSource (fun q => eqLit q 0) (fun q => eqLit q 1) q inexactErrorCore) x mode
    (x.den = false → run = .error .divideError) ∧
    (x.den = true → run = .ok x.num)

def bool_rounding_noninteger : Prop :=
  ∀ (t : IntTy) (f : JuliaLean.base.float.FTy)
    (x : Rational Bool) (mode : Rounding) (hvalid : x.num = true ∨ x.den = true),
    let ir := roundBoolRationalSource (Rat t) false
      (convertRatSource (JInt t) (fun b => .ok (JuliaLean.base.int.ofBool t b))) x mode
    let fr := roundBoolRationalSource (JuliaLean.base.float.FV f) false
      (fun q => .ok (floatConvertRatSource (JuliaLean.base.float.FV f)
        (JuliaLean.base.float.float_Bool f)
        JuliaLean.base.float.div_IEEEFloat (JuliaLean.base.float.convertFloat f) q)) x mode
    (∃ q, ir = .ok q ∧ Normalized q ∧ q.num.val = (if x.num then 1 else 0) ∧
      q.den.val = (if x.den then 1 else 0)) ∧
    (x.den = true → ∃ out, fr = .ok out ∧
      JuliaLean.base.float.isfinite_IEEEFloat out = true ∧
      (Fl.toRat out).1 = (if x.num then 1 else 0) * ((Fl.toRat out).2 : Int)) ∧
    (x.den = false → ∃ out, fr = .ok out ∧ JuliaLean.base.float.isinf_IEEEFloat out = true ∧
      JuliaLean.base.float.signbit_float out = false)

def prop_rational_bool_rounding : Prop :=
  Round5.bool_rounding ∧ bool_rounding_bool_target ∧ bool_rounding_noninteger

open JuliaLean.Proofs.base.rational.Round4 in
def manual_float_identity : Prop :=
  ∀ (s t : IntTy) (a : JInt s) (b : JInt t) (hab : a.val ≠ 0 ∨ b.val > 0)
    (q : Rat (s.promote t)),
    let p := IntegerParameters.bits (s.promote t)
    exactDivideIntsSource (rationalPromoteSource (jintPromoteOps s t).promote (rational p)) a b
        = .ok q →
      JuliaLean.base.float.isequal_IEEEFloat (abstractFloat p q)
        (JuliaLean.base.int.fdiv_BitInteger
          JuliaLean.base.float.float_BitInteger
          JuliaLean.base.float.float_BitInteger
          JuliaLean.base.float.div_IEEEFloat a b) = true

abbrev lerpiNative (tj td ta tb : IntTy) (j : JInt tj) (d : JInt td) (a : Rat ta) (b : Rat tb) :=
  let u := td.promote tj
  let p1 := ta.promote u
  let p2 := p1.promote td
  let p3 := tb.promote tj
  let p4 := p3.promote td
  lerpiSource (fun d j => JuliaLean.base.int.binop JuliaLean.base.int.sub d j)
    (mulIntRatSource (Round6.nativePromotion ta u) promoteIntegerPairYX
      (Round5.dg (.bits p1) (.bits p1)))
    (divRatIntSource (Round6.nativePromotion p1 td) (Round5.dg (.bits p2) (.bits p2)))
    (mulIntRatSource (Round6.nativePromotion tb tj) promoteIntegerPairYX
      (Round5.dg (.bits p3) (.bits p3)))
    (divRatIntSource (Round6.nativePromotion p3 td) (Round5.dg (.bits p4) (.bits p4)))
    (Round5.add (Round5.PromotionParameters.bits p2 p4)) j d a b

open JuliaLean.Proofs.base.rational.Round5 in
def mixed_interpolation : Prop :=
  ∀ (tj td ta tb : IntTy) (j : JInt tj) (d : JInt td) (a : Rat ta) (b : Rat tb)
    (ha : Normalized a) (hb : Normalized b) (hd : 0 < d.val)
    (hj : 0 ≤ j.val ∧ j.val ≤ d.val)
    (q : Rat (IntTy.promote ((ta.promote (td.promote tj)).promote td) ((tb.promote tj).promote td))),
    let finite := a.den.val > 0 ∧ b.den.val > 0
    let n : Int :=
      if finite then (d.val-j.val)*a.num.val*b.den.val+j.val*b.num.val*a.den.val
      else (if a.den.val = 0 ∧ j.val < d.val then intSign a.num.val else 0) +
        (if b.den.val = 0 ∧ 0 < j.val then intSign b.num.val else 0)
    let den : Int := if finite then d.val*a.den.val*b.den.val else 0
    lerpiNative tj td ta tb j d a b = .ok q →
      Represents (.bits (IntTy.promote ((ta.promote (td.promote tj)).promote td)
        ((tb.promote tj).promote td))) q n den

open JuliaLean.Proofs.base.rational.Round4 in
def ScalarOutcome {P : Type} (p : IntegerParameters P) (run : Jl (Rational P))
    (num den k prod result : Int) : Prop :=
  (¬ (p.fits den ∧ p.fits k) → IsInexact run) ∧
  (p.fits den → p.fits k → ¬ p.fits prod → IsOverflow run) ∧
  (p.fits den → p.fits k → p.fits prod → ¬ p.fits num → IsInexact run) ∧
  (p.fits den → p.fits k → p.fits prod → p.fits num → ¬ p.fits result → IsOverflow run) ∧
  (p.fits den → p.fits k → p.fits prod → p.fits num → p.fits result →
    ExactResult p run result den)

open JuliaLean.Proofs.base.rational.Round4 in
def scalar_arithmetic : Prop :=
  ∀ {T U P : Type} (i : IntegerParameters T) (j : IntegerParameters U)
    (p : IntegerParameters P) (m : PromotionParameters i j p) (x : Rational T) (k : U)
    (hx : Canonical i x),
    let cv := p.fits (rn i x) ∧ p.fits (rd i x) ∧ p.fits (val j k)
    let prod := rd i x * val j k
    let ga : Int := Nat.gcd (rd i x).natAbs (val j k).natAbs
    let gn : Int := Nat.gcd (rn i x).natAbs (val j k).natAbs
    let mn := rn i x * (val j k).tdiv ga
    let md := (rd i x).tdiv ga
    let dn := (rn i x).tdiv gn
    let dd := rd i x * (val j k).tdiv gn
    ScalarOutcome p (scalarAdd m x k) (rn i x) (rd i x) (val j k) prod (rn i x + prod) ∧
    ScalarOutcome p (scalarSub m x k) (rn i x) (rd i x) (val j k) prod (rn i x - prod) ∧
    (cv → ga = 0 → mulRatIntSource m.prom (dg p p) x k = .error .divideError) ∧
    (cv → ga ≠ 0 → FiniteArithmetic p (mulRatIntSource m.prom (dg p p) x k)
      (rn i x*val j k) (rd i x) True (FitsPair p mn md)) ∧
    (cv → gn = 0 → divRatIntSource m.prom (dg p p) x k = .error .divideError) ∧
    (cv → gn ≠ 0 →
      ((p.fits dd ∧ (dd < 0 → FitsPair p (-dn) (-dd)) ∧
          (rd i x = 0 ∧ val j k < 0 → p.fits (-dn))) →
        ExactResult p (divRatIntSource m.prom (dg p p) x k) (rn i x) (rd i x*val j k)))

open JuliaLean.Proofs.base.rational.Round4 in
def integer_left : Prop :=
  ∀ (t s : IntTy) (x : Rat t) (k : JInt s) (hx : Normalized x),
    let p := IntegerParameters.bits (t.promote s)
    let prom := Round6.nativePromotion t s
    let addL := integerRationalOpSource prom
      (fun a b => Round6.castInteger (Round6.promote_absorption_proven t s).2.2.1
        (JuliaLean.base.checked.checkedAddMixedBits a b)) k x
    let subL := integerRationalOpSource prom
      (fun a b => Round6.castInteger (Round6.promote_absorption_proven t s).2.2.1
        (JuliaLean.base.checked.checkedSubMixedBits a b)) k x
    let mulL := mulIntRatSource prom promoteIntegerPairYX (dg p p) k x
    let prod := x.den.val * k.val
    let g : Int := Nat.gcd k.val.natAbs x.den.val.natAbs
    ScalarOutcome p addL x.num.val x.den.val k.val prod (prod + x.num.val) ∧
    ScalarOutcome p subL x.num.val x.den.val k.val prod (prod - x.num.val) ∧
    (¬ (p.fits k.val ∧ p.fits x.den.val) → IsInexact mulL) ∧
    (p.fits k.val → p.fits x.den.val →
      (g = 0 → mulL = .error .divideError) ∧
      (g ≠ 0 → ¬ p.fits x.num.val → IsInexact mulL) ∧
      (g ≠ 0 → p.fits x.num.val → ¬ p.fits (k.val.tdiv g * x.num.val) → IsOverflow mulL) ∧
      (g ≠ 0 → p.fits x.num.val → p.fits (k.val.tdiv g * x.num.val) →
        ExactResult p mulL (k.val * x.num.val) x.den.val))

open JuliaLean.Proofs.base.rational.Round4 in
def integer_left_quotient : Prop :=
  ∀ (s t : IntTy) (k : JInt s) (y : Rat t) (hy : Normalized y),
    let p := IntegerParameters.bits (s.promote t)
    let run := divIntRatSource (Round6.nativePromotion s t) (dg p p) k y
    let g : Int := Nat.gcd k.val.natAbs y.num.val.natAbs
    let dn := k.val.tdiv g * y.den.val
    let dd := y.num.val.tdiv g
    (¬ (p.fits k.val ∧ p.fits y.num.val) → IsInexact run) ∧
    (p.fits k.val → p.fits y.num.val →
      (g = 0 → run = .error .divideError) ∧
      (g ≠ 0 → ¬ p.fits y.den.val → IsInexact run) ∧
      (g ≠ 0 → p.fits y.den.val → ¬ p.fits dn → IsOverflow run) ∧
      (g ≠ 0 → p.fits y.den.val → p.fits dn → dd < 0 → ¬ FitsPair p (-dn) (-dd) →
        IsOverflow run) ∧
      (g ≠ 0 → p.fits y.den.val → p.fits dn → (dd < 0 → FitsPair p (-dn) (-dd)) →
        ExactResult p run (k.val * y.den.val) y.num.val))

def prop_rational_arithmetic_exact : Prop :=
  Round4.add_sub_exact ∧
  scalar_arithmetic ∧
  Round4.extended_add_sub ∧
  Round4.finite_products_and_quotients ∧
  integer_left ∧
  integer_left_quotient

set_option maxHeartbeats 2000000 in
theorem prop_rational_bool_rounding_proven : prop_rational_bool_rounding := by
  refine ⟨Round5.bool_rounding_proven, ?_, ?_⟩
  · intro x mode hvalid
    rcases x with ⟨num, den⟩
    cases num <;> cases den <;> cases mode <;>
      simp_all [bool_rounding_bool_target, boolEqInt, roundBoolRationalSource,
        boolOfRatSource, eqRatIntSource, eqRatIntMethod, Bind.bind, Pure.pure] <;> decide +kernel
  · intro t f x mode hvalid
    rcases x with ⟨num, den⟩
    cases t <;> cases f <;> cases num <;> cases den <;>
      simp_all [bool_rounding_noninteger, roundBoolRationalSource, boolOfRatSource,
        intOfRatSource, convertRatSource, floatConvertRatSource, Bind.bind,
        Except.bind, Pure.pure, Except.pure, Normalized, JuliaLean.base.int.ofBool,
        JInt.lit, JInt.wrap, wrapInt, IntTy.min, IntTy.max, IntTy.bits, IntTy.signed,
        JuliaLean.base.float.isfinite_IEEEFloat, JuliaLean.base.float.isinf_IEEEFloat,
        JuliaLean.base.float.signbit_float, JuliaLean.base.float.convertFloat,
        JuliaLean.base.float.div_IEEEFloat, JuliaLean.base.float.float_Bool,
        JuliaLean.Promotion.Fl.toRat] <;> decide +kernel
end Round10
end JuliaLean.Proofs.base.rational

namespace JuliaLean.Statements.rational.Round11

open JuliaLean JuliaLean.Promotion JuliaLean.base.rational
open JuliaLean.Proofs.base.rational.Round4
set_option maxRecDepth 4096

/-- A failed call is an error, without prescribing its exception type. -/
def HasError {T : Type} (run : Jl T) : Prop :=
  ∃ e, run = .error e

/-- Checked arithmetic has an exact reduced result precisely on its declared safe range;
conversion and range failures need only be errors. -/
def FiniteOutcome {T : Type} (i : IntegerParameters T) (run : Jl (Rational T))
    (n d : Int) (converted safe : Prop) : Prop :=
  (¬ converted → HasError run) ∧
  (converted → safe → ExactResult i run n d) ∧
  (converted → ¬ safe → HasError run)

/-- The source-ordered conversions and checked operations of rational-plus/minus-rational. -/
def add_sub_exact : Prop :=
  ∀ {T U P : Type} (i : IntegerParameters T) (j : IntegerParameters U)
    (p : IntegerParameters P) (m : PromotionParameters i j p) (x : Rational T) (y : Rational U)
    (hx : Canonical i x) (hy : Canonical j y),
    let cv := Converts i j p x y
    (rd i x > 0 → rd j y > 0 →
      FiniteOutcome p (add m x y)
        (rn i x*rd j y+rn j y*rd i x) (rd i x*rd j y)
        cv (AddSafe i j p x y false) ∧
      FiniteOutcome p (sub m x y)
        (rn i x*rd j y-rn j y*rd i x) (rd i x*rd j y)
        cv (AddSafe i j p x y true)) ∧
    (cv → rd i x = 0 → rd j y = 0 → rn i x = rn j y →
      ExactResult p (add m x y) (rn i x) 0) ∧
    (cv → rd i x = 0 → rd j y = 0 → rn i x ≠ rn j y →
      HasError (add m x y)) ∧
    (¬ cv → HasError (add m x y) ∧ HasError (sub m x y))

/-- Infinite operands retain their documented extended-rational values; every other failure
is stated only as an error. -/
def extended_add_sub : Prop :=
  ∀ {T U P : Type} (i : IntegerParameters T) (j : IntegerParameters U)
    (p : IntegerParameters P) (m : PromotionParameters i j p) (x : Rational T) (y : Rational U)
    (hx : Canonical i x) (hy : Canonical j y),
    let cv := Converts i j p x y
    let addRun := add m x y
    let subRun := sub m x y
    (¬ cv → HasError addRun ∧ HasError subRun) ∧
    (cv →
      (rd i x = 0 → rd j y > 0 →
        ExactResult p addRun (rn i x) 0 ∧
        (j.fits (-rn j y) → ExactResult p subRun (rn i x) 0) ∧
        (¬ j.fits (-rn j y) → HasError subRun)) ∧
      (rd i x > 0 → rd j y = 0 →
        (p.fits (rn j y*rd i x) → ExactResult p addRun (rn j y) 0) ∧
        (¬ p.fits (rn j y*rd i x) → HasError addRun) ∧
        (p.fits (-rn j y*rd i x) → ExactResult p subRun (-rn j y) 0) ∧
        (¬ p.fits (-rn j y*rd i x) → HasError subRun)) ∧
      (rd i x = 0 → rd j y = 0 →
        (j.fits (-rn j y) →
          (rn i x = -rn j y → ExactResult p subRun (rn i x) 0) ∧
          (rn i x ≠ -rn j y → HasError subRun)) ∧
        (¬ j.fits (-rn j y) → HasError subRun)))

/-- Finite rational products and quotients succeed on fitting reduced intermediates. -/
def finite_products_and_quotients : Prop :=
  ∀ {T U P : Type} (i : IntegerParameters T)
    (j : IntegerParameters U) (p : IntegerParameters P) (m : PromotionParameters i j p)
    (x : Rational T) (y : Rational U) (hx : Canonical i x) (hy : Canonical j y),
    let cv := Converts i j p x y
    let g1 : Int := Nat.gcd (rn i x).natAbs (rd j y).natAbs
    let g2 : Int := Nat.gcd (rd i x).natAbs (rn j y).natAbs
    let mn := (rn i x).tdiv g1*(rn j y).tdiv g2
    let md := (rd i x).tdiv g2*(rd j y).tdiv g1
    let gn : Int := Nat.gcd (rn i x).natAbs (rn j y).natAbs
    let gd : Int := Nat.gcd (rd i x).natAbs (rd j y).natAbs
    let dn := (rn i x).tdiv gn*(rd j y).tdiv gd
    let dd := (rd i x).tdiv gd*(rn j y).tdiv gn
    let mulRun := mulRatRatSource m.prom (dg p p) x y
    let divRun := divRatRatSource m.prom (dg p p) x y
    (¬ cv → HasError mulRun ∧ HasError divRun) ∧
    (cv → rd i x > 0 → rd j y > 0 →
      ((g1 = 0 ∨ g2 = 0) → HasError mulRun) ∧
      (g1 ≠ 0 → g2 ≠ 0 →
        (FitsPair p mn md → ExactResult p mulRun (rn i x*rn j y) (rd i x*rd j y)) ∧
        (¬ FitsPair p mn md → HasError mulRun)) ∧
      (gn = 0 → HasError divRun) ∧
      (gn ≠ 0 →
        (FitsPair p dn dd → (dd < 0 → FitsPair p (-dn) (-dd)) →
          ExactResult p divRun (rn i x*rd j y) (rd i x*rn j y)) ∧
        (¬ (FitsPair p dn dd ∧ (dd < 0 → FitsPair p (-dn) (-dd))) → HasError divRun)))

/-- Mixed rational/integer arithmetic uses the actual promoted source operations. -/
def ScalarOutcome {P : Type} (p : IntegerParameters P) (run : Jl (Rational P))
    (num den k prod result : Int) : Prop :=
  (¬ (p.fits den ∧ p.fits k) → HasError run) ∧
  (p.fits den → p.fits k → ¬ p.fits prod → HasError run) ∧
  (p.fits den → p.fits k → p.fits prod → ¬ p.fits num → HasError run) ∧
  (p.fits den → p.fits k → p.fits prod → p.fits num → ¬ p.fits result → HasError run) ∧
  (p.fits den → p.fits k → p.fits prod → p.fits num → p.fits result →
    ExactResult p run result den)

abbrev scalarAdd {T U P : Type} {i : IntegerParameters T} {j : IntegerParameters U}
    {p : IntegerParameters P} (m : PromotionParameters i j p) :=
  rationalIntegerOpSource m.prom (fun a b => do p.ops.checkedAdd (← m.prom.convertXP a) b)

abbrev scalarSub {T U P : Type} {i : IntegerParameters T} {j : IntegerParameters U}
    {p : IntegerParameters P} (m : PromotionParameters i j p) :=
  rationalIntegerOpSource m.prom (fun a b => do p.ops.checkedSub (← m.prom.convertXP a) b)

def scalar_arithmetic : Prop :=
  ∀ {T U P : Type} (i : IntegerParameters T) (j : IntegerParameters U)
    (p : IntegerParameters P) (m : PromotionParameters i j p) (x : Rational T) (k : U)
    (hx : Canonical i x),
    let cv := p.fits (rn i x) ∧ p.fits (rd i x) ∧ p.fits (val j k)
    let prod := rd i x * val j k
    let ga : Int := Nat.gcd (rd i x).natAbs (val j k).natAbs
    let gn : Int := Nat.gcd (rn i x).natAbs (val j k).natAbs
    let mn := rn i x * (val j k).tdiv ga
    let md := (rd i x).tdiv ga
    let dn := (rn i x).tdiv gn
    let dd := rd i x * (val j k).tdiv gn
    (ScalarOutcome p (scalarAdd m x k) (rn i x) (rd i x) (val j k) prod
      (rn i x + prod) ∧
     ScalarOutcome p (scalarSub m x k) (rn i x) (rd i x) (val j k) prod
      (rn i x - prod)) ∧
    (¬ cv → HasError (mulRatIntSource m.prom (dg p p) x k) ∧
      HasError (divRatIntSource m.prom (dg p p) x k)) ∧
    (cv → ga = 0 → HasError (mulRatIntSource m.prom (dg p p) x k)) ∧
    (cv → ga ≠ 0 → FiniteOutcome p (mulRatIntSource m.prom (dg p p) x k)
      (rn i x*val j k) (rd i x) True (FitsPair p mn md)) ∧
    (cv → gn = 0 → HasError (divRatIntSource m.prom (dg p p) x k)) ∧
    (cv → gn ≠ 0 →
      ((p.fits dd ∧ (dd < 0 → FitsPair p (-dn) (-dd)) ∧
          (rd i x = 0 ∧ val j k < 0 → p.fits (-dn))) →
        ExactResult p (divRatIntSource m.prom (dg p p) x k)
          (if decide (rd i x = 0 ∧ val j k < 0) then -rn i x else rn i x)
          (rd i x*val j k)) ∧
      (¬ (p.fits dd ∧ (dd < 0 → FitsPair p (-dn) (-dd)) ∧
          (rd i x = 0 ∧ val j k < 0 → p.fits (-dn))) →
        HasError (divRatIntSource m.prom (dg p p) x k)))

/-- Multiplication is exact on success, including infinite values and mixed integer types. -/
def multiplication_exact : Prop :=
  ∀ {T U P : Type} (i : IntegerParameters T) (j : IntegerParameters U)
    (p : IntegerParameters P) (m : PromotionParameters i j p) (x : Rational T) (y : Rational U)
    (hx : Canonical i x) (hy : Canonical j y),
    let cv := Converts i j p x y
    let g1 : Int := Nat.gcd (rn i x).natAbs (rd j y).natAbs
    let g2 : Int := Nat.gcd (rd i x).natAbs (rn j y).natAbs
    let n := (rn i x).tdiv g1 * (rn j y).tdiv g2
    let d := (rd i x).tdiv g2 * (rd j y).tdiv g1
    let run := mulRatRatSource m.prom (dg p p) x y
    (¬ cv → HasError run) ∧
    (cv → (g1 = 0 ∨ g2 = 0 → HasError run) ∧
      (g1 ≠ 0 → g2 ≠ 0 →
        (FitsPair p n d → ExactResult p run (rn i x*rn j y) (rd i x*rd j y)) ∧
        (¬ FitsPair p n d → HasError run)))

/-- Integer-left addition, subtraction, multiplication and quotient preserve their exact
mathematical ratios on success and return no specified error type on failed conversion. -/
def integer_left : Prop :=
  ∀ (t s : IntTy) (x : Rat t) (k : JInt s) (hx : Normalized x),
    let p := IntegerParameters.bits (t.promote s)
    let prom := JuliaLean.Proofs.base.rational.Round6.nativePromotion t s
    let addL := integerRationalOpSource prom
      (fun a b => JuliaLean.Proofs.base.rational.Round6.castInteger
        (JuliaLean.Proofs.base.rational.Round6.promote_absorption_proven t s).2.2.1
        (JuliaLean.base.checked.checkedAddMixedBits a b)) k x
    let subL := integerRationalOpSource prom
      (fun a b => JuliaLean.Proofs.base.rational.Round6.castInteger
        (JuliaLean.Proofs.base.rational.Round6.promote_absorption_proven t s).2.2.1
        (JuliaLean.base.checked.checkedSubMixedBits a b)) k x
    let mulL := mulIntRatSource prom promoteIntegerPairYX (dg p p) k x
    let prod := x.den.val * k.val
    let g : Int := Nat.gcd k.val.natAbs x.den.val.natAbs
    (ScalarOutcome p addL x.num.val x.den.val k.val prod (prod + x.num.val) ∧
      ScalarOutcome p subL x.num.val x.den.val k.val prod (prod - x.num.val)) ∧
    (¬ (p.fits k.val ∧ p.fits x.den.val) → HasError mulL) ∧
    (p.fits k.val → p.fits x.den.val →
      (g = 0 → HasError mulL) ∧
      (g ≠ 0 →
        (¬ p.fits x.num.val → HasError mulL) ∧
        (p.fits x.num.val →
          (p.fits (k.val.tdiv g * x.num.val) →
            ExactResult p mulL (k.val * x.num.val) x.den.val) ∧
          (¬ p.fits (k.val.tdiv g * x.num.val) → HasError mulL))))

/-- Integer-left exact division follows promotion, cancellation, checked multiplication and
sign normalization in Julia's source order. -/
def integer_left_quotient : Prop :=
  ∀ (s t : IntTy) (k : JInt s) (y : Rat t) (hy : Normalized y),
    let p := IntegerParameters.bits (s.promote t)
    let run := divIntRatSource (JuliaLean.Proofs.base.rational.Round6.nativePromotion s t)
      (dg p p) k y
    let cv := p.fits k.val ∧ p.fits y.num.val ∧ p.fits y.den.val
    let g : Int := Nat.gcd k.val.natAbs y.num.val.natAbs
    let dn := k.val.tdiv g * y.den.val
    let dd := y.num.val.tdiv g
    let safe := p.fits dn ∧ (dd < 0 → FitsPair p (-dn) (-dd))
    (¬ cv → HasError run) ∧
    (cv → g = 0 → HasError run) ∧
    (cv → g ≠ 0 →
      (safe → ExactResult p run (k.val * y.den.val) y.num.val) ∧
      (¬ safe → HasError run))

def prop_rational_arithmetic_exact : Prop :=
  add_sub_exact ∧ scalar_arithmetic ∧ extended_add_sub ∧
    finite_products_and_quotients ∧ multiplication_exact ∧ integer_left ∧ integer_left_quotient


def mixed_arithmetic : Prop := scalar_arithmetic ∧ integer_left

/-- Rational gcd and lcm use the mixed native integer gcd/lcm dispatch on their components. -/
def GcdLcmOutcome {T U P : Type} (i : IntegerParameters T) (j : IntegerParameters U)
    (p : IntegerParameters P) (x : Rational T) (y : Rational U)
    (gRun lRun : Jl (Rational P)) : Prop :=
  let gn : Int := Nat.gcd (rn i x).natAbs (rn j y).natAbs
  let gd : Int := Nat.gcd (rd i x).natAbs (rd j y).natAbs
  let ln : Int := Nat.lcm (rn i x).natAbs (rn j y).natAbs
  let ld : Int := Nat.lcm (rd i x).natAbs (rd j y).natAbs
  ((rd i x = 0) ≠ (rd j y = 0) → HasError gRun ∧ HasError lRun) ∧
  ((rd i x = 0) = (rd j y = 0) →
    (FitsPair p gn ld → ExactResult p gRun gn ld) ∧
    (FitsPair p ln gd → ExactResult p lRun ln gd) ∧
    (¬ p.fits gn ∨ ¬ p.fits ld → HasError gRun) ∧
    (¬ p.fits ln ∨ ¬ p.fits gd → HasError lRun))

def mixed_gcd_lcm : Prop :=
  ∀ {T U P : Type} (i : IntegerParameters T) (j : IntegerParameters U)
    (p : IntegerParameters P) (m : PromotionParameters i j p) (x : Rational T) (y : Rational U)
    (hx : Canonical i x) (hy : Canonical j y),
    GcdLcmOutcome i j p x y
      (gcdRationalSource (fun q => i.ops.iszero q.den) (fun q => j.ops.iszero q.den)
        (mixedGcd m) (mixedLcm m) x y)
      (lcmRationalSource (fun q => i.ops.iszero q.den) (fun q => j.ops.iszero q.den)
        (mixedLcm m) (mixedGcd m) x y)


end JuliaLean.Statements.rational.Round11

namespace JuliaLean.Statements.rational.Round11

open JuliaLean JuliaLean.Promotion JuliaLean.base.rational
open JuliaLean.Proofs.base.rational.Round4

/-- Successful Float64 rationalization returns a canonical value, canonical zero/infinity,
and an IEEE-equal Float64 round trip. -/
def float_roundtrip : Prop :=
  ∀ {T : Type} (i : IntegerParameters T)
    (o : JuliaLean.base.math.IEEEOps .f32 × JuliaLean.base.math.IEEEOps .f64)
    (showF : JuliaLean.base.float.FV .f64 → String) (x : JuliaLean.base.float.FV .f64)
    (q : Rational T),
    let f := FloatParameters.ieee .f64 o
    exactFromFloat i f showF x = some (.ok q) →
      Canonical i q ∧
      (rn i q = 0 → rd i q = 1) ∧
      (rd i q = 0 → (rn i q).natAbs = 1) ∧
      f.eq x (toFloat i f q) = true

/-- The manual's Float64 identity applies to any two native integer types, apart from
`a == 0 && b <= 0`. -/
def manual_float_identity : Prop :=
  ∀ (s t : IntTy) (a : JInt s) (b : JInt t) (hab : a.val ≠ 0 ∨ b.val > 0)
    (q : Rat (s.promote t)),
    let p := IntegerParameters.bits (s.promote t)
    exactDivideIntsSource
        (rationalPromoteSource (jintPromoteOps s t).promote (rational p)) a b = .ok q →
      JuliaLean.base.float.isequal_IEEEFloat (abstractFloat p q)
        (JuliaLean.base.int.fdiv_BitInteger
          JuliaLean.base.float.float_BitInteger
          JuliaLean.base.float.float_BitInteger
          JuliaLean.base.float.div_IEEEFloat a b) = true

/-- Every finite half-integer rational with the same exact Float64 value hashes identically. -/
def hash_value : Prop :=
  ∀ (t : IntTy) (ht : t ≠ .i128 ∧ t ≠ .u128)
    (o : JuliaLean.base.math.IEEEOps .f64) (q : Rat t) (seed : JInt .u64)
    (hq : Normalized q) (hhalf : q.den.val = 2)
    (x : JuliaLean.base.float.FV .f64)
    (hx : JuliaLean.base.float.isfinite_IEEEFloat x = true)
    (hval : (Fl.toRat x).1 * q.den.val = q.num.val * (Fl.toRat x).2),
    hashRat ht o q seed = JuliaLean.base.hashing.hashFloat64Canonical x seed

end JuliaLean.Statements.rational.Round11

namespace JuliaLean.Statements.rational.Round11

open JuliaLean JuliaLean.Promotion JuliaLean.base.rational
open JuliaLean.Proofs.base.rational.Round4
open JuliaLean.Proofs.base.rational.Round5

/-- All IEEE formats reject finite comparisons with non-dyadic rational denominators and agree
with exact float/integer equality when the denominator is one. -/
def float_equality : Prop :=
  ∀ (t : IntTy) (f : JuliaLean.base.float.FTy)
    (o : JuliaLean.base.math.IEEEOps .f32 × JuliaLean.base.math.IEEEOps .f64)
    (q : Rat t) (x : JuliaLean.base.float.FV f) (hq : Normalized q)
    (hx : JuliaLean.base.float.isfinite_IEEEFloat x = true),
    let fp := JuliaLean.Proofs.base.rational.Round5.FloatParameters.ieee f o
    let subOne := fun n : JInt t => JuliaLean.base.int.binop JuliaLean.base.int.sub n (JInt.lit .i64 1)
    let div := JuliaLean.base.int.fdiv_BitInteger JuliaLean.base.float.float_BitInteger
      JuliaLean.base.float.float_BitInteger JuliaLean.base.float.div_IEEEFloat
    let eqFF := fun a : JuliaLean.base.float.FV f =>
      fun b : JuliaLean.base.float.FV .f64 =>
        JuliaLean.base.float.eq_IEEEFloat (JuliaLean.base.float.convertFloat .f64 a) b
    let left := eqFloatRatSource JuliaLean.base.float.isfinite_IEEEFloat
      JuliaLean.base.int.count_ones (fun n => JuliaLean.base.int.eq n (JInt.lit .i64 1))
      subOne JuliaLean.base.int.top_set_bit (fun a e => fp.ldexp a e.val)
      JuliaLean.base.float.eq_FI div eqFF x q
    let right := eqRatFloatSource JuliaLean.base.float.isfinite_IEEEFloat
      JuliaLean.base.int.count_ones (fun n => JuliaLean.base.int.eq n (JInt.lit .i64 1))
      subOne JuliaLean.base.int.top_set_bit (fun a e => fp.ldexp a e.val)
      JuliaLean.base.float.eq_FI div eqFF q x
    (q.den.val > 0 → (¬ ∃ k : Nat, q.den.val = 2^k) → left = false ∧ right = false) ∧
    (q.den.val = 1 →
      left = JuliaLean.base.float.eq_FI x q.num ∧
      right = JuliaLean.base.float.eq_FI x q.num)

/-- Four independent native input types implement the exact in-range barycentric value. -/
abbrev lerpiNative := JuliaLean.Proofs.base.rational.Round10.lerpiNative

def mixed_interpolation : Prop :=
  JuliaLean.Proofs.base.rational.Round10.mixed_interpolation

end JuliaLean.Statements.rational.Round11
namespace JuliaLean.Statements.rational.Round17

open JuliaLean JuliaLean.Promotion JuliaLean.base.rational
open JuliaLean.Proofs.base.rational.Round4
set_option maxRecDepth 4096

def HasError {T : Type} (run : Jl T) : Prop :=
  ∃ e, run = .error e

def ScalarOutcome {P : Type} (p : IntegerParameters P) (run : Jl (Rational P))
    (num den k prod result : Int) : Prop :=
  (¬ (p.fits den ∧ p.fits k) → HasError run) ∧
  (p.fits den → p.fits k → ¬ p.fits prod → HasError run) ∧
  (p.fits den → p.fits k → p.fits prod → ¬ p.fits num → HasError run) ∧
  (p.fits den → p.fits k → p.fits prod → p.fits num → ¬ p.fits result → HasError run) ∧
  (p.fits den → p.fits k → p.fits prod → p.fits num → p.fits result →
    ExactResult p run result den)

def integer_left : Prop :=
  ∀ (t s : IntTy) (x : Rat t) (k : JInt s) (hx : Normalized x),
    let p := IntegerParameters.bits (t.promote s)
    let prom := JuliaLean.Proofs.base.rational.Round6.nativePromotion t s
    let addL := integerRationalOpSource prom
      (fun a b => JuliaLean.Proofs.base.rational.Round6.castInteger
        (JuliaLean.Proofs.base.rational.Round6.promote_absorption_proven t s).2.2.1
        (JuliaLean.base.checked.checkedAddMixedBits a b)) k x
    let subL := integerRationalOpSource prom
      (fun a b => JuliaLean.Proofs.base.rational.Round6.castInteger
        (JuliaLean.Proofs.base.rational.Round6.promote_absorption_proven t s).2.2.1
        (JuliaLean.base.checked.checkedSubMixedBits a b)) k x
    let mulL := mulIntRatSource prom promoteIntegerPairYX (dg p p) k x
    let prod := x.den.val * k.val
    let g : Int := Nat.gcd k.val.natAbs x.den.val.natAbs
    (ScalarOutcome p addL x.num.val x.den.val k.val prod (prod + x.num.val) ∧
      ScalarOutcome p subL x.num.val x.den.val k.val prod (prod - x.num.val)) ∧
    (¬ (p.fits k.val ∧ p.fits x.den.val) → HasError mulL) ∧
    (p.fits k.val → p.fits x.den.val →
      (g = 0 → HasError mulL) ∧
      (g ≠ 0 →
        (¬ p.fits x.num.val → HasError mulL) ∧
        (p.fits x.num.val →
          (p.fits (k.val.tdiv g * x.num.val) →
            ExactResult p mulL (k.val * x.num.val) x.den.val) ∧
          (¬ p.fits (k.val.tdiv g * x.num.val) → HasError mulL))))

def mixed_left_value : Prop := integer_left

end JuliaLean.Statements.rational.Round17
namespace JuliaLean.Statements.rational.Round21

open JuliaLean JuliaLean.Promotion JuliaLean.base.rational
open JuliaLean.Proofs.base.rational.Round4
set_option maxRecDepth 4096

def HasError {T : Type} (run : Jl T) : Prop :=
  ∃ e, run = .error e

def FiniteOutcome {T : Type} (i : IntegerParameters T) (run : Jl (Rational T))
    (n d : Int) (converted safe : Prop) : Prop :=
  (¬ converted → HasError run) ∧
  (converted → safe → ExactResult i run n d) ∧
  (converted → ¬ safe → HasError run)

def ScalarOutcome {P : Type} (p : IntegerParameters P) (run : Jl (Rational P))
    (num den k prod result : Int) : Prop :=
  (¬ (p.fits den ∧ p.fits k) → HasError run) ∧
  (p.fits den → p.fits k → ¬ p.fits prod → HasError run) ∧
  (p.fits den → p.fits k → p.fits prod → ¬ p.fits num → HasError run) ∧
  (p.fits den → p.fits k → p.fits prod → p.fits num → ¬ p.fits result → HasError run) ∧
  (p.fits den → p.fits k → p.fits prod → p.fits num → p.fits result →
    ExactResult p run result den)

def scalarAddNative {t s : IntTy} (x : Rat t) (k : JInt s) : Jl (Rat (t.promote s)) :=
  JuliaLean.base.rational.rationalIntegerOpSource
    (JuliaLean.Proofs.base.rational.Round6.nativePromotion t s)
    (fun a b => JuliaLean.Proofs.base.rational.Round6.castInteger
      (JuliaLean.Proofs.base.rational.Round6.promote_absorption_proven t s).1
      (JuliaLean.base.checked.checkedAddMixedBits a b)) x k

def scalarSubNative {t s : IntTy} (x : Rat t) (k : JInt s) : Jl (Rat (t.promote s)) :=
  JuliaLean.base.rational.rationalIntegerOpSource
    (JuliaLean.Proofs.base.rational.Round6.nativePromotion t s)
    (fun a b => JuliaLean.Proofs.base.rational.Round6.castInteger
      (JuliaLean.Proofs.base.rational.Round6.promote_absorption_proven t s).1
      (JuliaLean.base.checked.checkedSubMixedBits a b)) x k

def publicPlusRI {t s : IntTy} (x : Rat t) (k : JInt s) : Jl (Rat (t.promote s)) :=
  scalarAddNative x k

def publicMinusRI {t s : IntTy} (x : Rat t) (k : JInt s) : Jl (Rat (t.promote s)) :=
  scalarSubNative x k

def publicTimesRI {t s : IntTy} (x : Rat t) (k : JInt s) : Jl (Rat (t.promote s)) :=
  let p := IntegerParameters.bits (t.promote s)
  JuliaLean.base.rational.mulRatIntSource
    (JuliaLean.Proofs.base.rational.Round6.nativePromotion t s) (dg p p) x k

def publicExactDivideRI {t s : IntTy} (x : Rat t) (k : JInt s) : Jl (Rat (t.promote s)) :=
  let p := IntegerParameters.bits (t.promote s)
  JuliaLean.base.rational.divRatIntSource
    (JuliaLean.Proofs.base.rational.Round6.nativePromotion t s) (dg p p) x k

def publicDivideRI {t s : IntTy} (x : Rat t) (k : JInt s) : Jl (Rat (t.promote s)) :=
  publicExactDivideRI x k

def publicPlusIR {t s : IntTy} (k : JInt s) (x : Rat t) : Jl (Rat (t.promote s)) :=
  JuliaLean.base.rational.integerRationalOpSource
    (JuliaLean.Proofs.base.rational.Round6.nativePromotion t s)
    (fun a b => JuliaLean.Proofs.base.rational.Round6.castInteger
      (JuliaLean.Proofs.base.rational.Round6.promote_absorption_proven t s).2.2.1
      (JuliaLean.base.checked.checkedAddMixedBits a b)) k x

def publicMinusIR {t s : IntTy} (k : JInt s) (x : Rat t) : Jl (Rat (t.promote s)) :=
  JuliaLean.base.rational.integerRationalOpSource
    (JuliaLean.Proofs.base.rational.Round6.nativePromotion t s)
    (fun a b => JuliaLean.Proofs.base.rational.Round6.castInteger
      (JuliaLean.Proofs.base.rational.Round6.promote_absorption_proven t s).2.2.1
      (JuliaLean.base.checked.checkedSubMixedBits a b)) k x

def publicTimesIR {t s : IntTy} (k : JInt s) (x : Rat t) : Jl (Rat (t.promote s)) :=
