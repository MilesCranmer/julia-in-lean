theorem rationalWidenExists (t : IntTy) (h : t ≠ .i128 ∧ t ≠ .u128) :
    ∃ w, widenType t = some w := by
  cases t <;> simp only [widenType]
  all_goals first | exact ⟨_, rfl⟩ | exact False.elim (h.1 rfl) | exact False.elim (h.2 rfl)

