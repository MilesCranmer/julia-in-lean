theorem mixed_gcd_lcm_refuted :
    ¬ JuliaLean.Statements.rational.Round11.mixed_gcd_lcm := by
  intro h
  let i : IntegerParameters (JInt .i8) := .bits .i8
  let j : IntegerParameters (JInt .u8) := .bits .u8
  let p : IntegerParameters (JInt .u8) := .bits .u8
  let m : PromotionParameters i j p := .bits .i8 .u8
  let x : Rat .i8 := ⟨JInt.lit .i8 (-128), JInt.lit .i8 1⟩
  let y : Rat .u8 := ⟨JInt.lit .u8 2, JInt.lit .u8 1⟩
  have hx : Canonical i x := by
    change 0 ≤ (1 : Int) ∧ Nat.gcd (Int.natAbs (-128)) (Int.natAbs 1) = 1
    decide
  have hy : Canonical j y := by
    change 0 ≤ (1 : Int) ∧ Nat.gcd (Int.natAbs 2) (Int.natAbs 1) = 1
    decide
  have hfinite : (rd i x = 0) = (rd j y = 0) := by
    change ((1 : Int) = 0) = ((1 : Int) = 0)
    rfl
  have hgn : (Nat.gcd (rn i x).natAbs (rn j y).natAbs : Int) = 2 := by
    decide
  have hld : (Nat.lcm (rd i x).natAbs (rd j y).natAbs : Int) = 1 := by
    decide
  have hfit : FitsPair p
      (Nat.gcd (rn i x).natAbs (rn j y).natAbs : Int)
      (Nat.lcm (rd i x).natAbs (rd j y).natAbs : Int) := by
    rw [hgn, hld]
    unfold FitsPair IntegerParameters.fits
    decide
  let gRun := JuliaLean.base.rational.gcdRationalSource
    (fun q => i.ops.iszero q.den) (fun q => j.ops.iszero q.den)
    (mixedGcd m) (mixedLcm m) x y
  have hsuccess : ExactResult p gRun 2 1 := by
    have hresult := ((h i j p m x y hx hy).2 hfinite).1 hfit
    simpa [JuliaLean.Statements.rational.Round11.GcdLcmOutcome, rn, rd,
      val, gRun, i, j, p, x, y, IntegerParameters.ops, jintOps,
      JInt.lit, JInt.wrap, wrapInt, IntTy.signed, IntTy.bits,
      IntTy.promote] using hresult
  have hbad :
      (JuliaLean.base.intfuncs.gcdMixedBits
        (JInt.lit .i8 (-128)) (JInt.lit .u8 2)).isOk = false := by
    decide
  cases hcall : JuliaLean.base.intfuncs.gcdMixedBits
      (JInt.lit .i8 (-128)) (JInt.lit .u8 2) with
  | error e =>
    have hmixed : mixedGcd m x.num y.num = .error e := by
      simpa [Round4.mixedGcd, m, i, j, p, x, y,
        IntTy.promote, IntTy.bits, IntTy.signed] using hcall
    have hfiniteBool : (i.ops.iszero x.den != j.ops.iszero y.den) = false := by
      decide
    have hrun : gRun = .error e := by
      change JuliaLean.base.rational.gcdRationalSource
        (fun q => i.ops.iszero q.den) (fun q => j.ops.iszero q.den)
        (mixedGcd m) (mixedLcm m) x y = .error e
      simp [JuliaLean.base.rational.gcdRationalSource, hfiniteBool, hmixed]
    obtain ⟨q, hq, _⟩ := hsuccess
    rw [hrun] at hq
    cases hq
  | ok g =>
    rw [hcall] at hbad
    cases hbad

theorem manual_float_identity_refuted :
    ¬ JuliaLean.Statements.rational.Round11.manual_float_identity := by
  intro h
  let a : JInt .i64 := JInt.lit .i64 9007199254740993
  let b : JInt .i64 := JInt.lit .i64 9007199254740996
