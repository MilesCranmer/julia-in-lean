        fun _ => hn_pos, fun h => absurd h hnz⟩⟩
      change Nat.gcd x.den.val.natAbs x.num.val.natAbs = 1
      rw [Nat.gcd_comm]; exact hx.2
  · exact hcd.2.2 hn_lt hnot

