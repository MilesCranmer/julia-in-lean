def rounded (a b : Int) (mode : Rounding) : Int :=
  let q := a.tdiv b
  let r := a.tmod b
  let step := if (a < 0) ≠ (b < 0) then -1 else 1
  let away := q + step
  match mode with
  | .toZero => q
  | .down => a.fdiv b
  | .up => -((-a).fdiv b)
  | .fromZero => if r = 0 then q else away
  | .nearest | .nearestAway | .nearestUp =>
    if 2 * r.natAbs < b.natAbs then q
    else if 2 * r.natAbs > b.natAbs then away
    else if mode = .nearestAway then away
    else if mode = .nearestUp then if step < 0 then q else away
    else if q % 2 = 0 then q else away
def IsOverflow {T : Type} (run : Jl T) : Prop :=
  ∃ message, run = .error (.overflowError message)
def IsInexact {T : Type} (run : Jl T) : Prop :=
  ∃ message, run = .error (.inexactError message)
inductive IntegerParameters : Type → Type where
  | bits (t : IntTy) : IntegerParameters (JInt t)
namespace IntegerParameters
def ops {T : Type} : IntegerParameters T → RatIntOps T
  | .bits t => jintOps t
def fits {T : Type} : IntegerParameters T → Int → Prop
  | .bits t => fun n => t.min ≤ n ∧ n ≤ t.max
def wrap {T : Type} : IntegerParameters T → Int → Int
  | .bits t => wrapInt t
def alg {T : Type} : IntegerParameters T → JuliaLean.base.intfuncs.IntegerOps T
  | .bits t => JuliaLean.base.intfuncs.bitOps t
      (fun x y => do pure (← JuliaLean.base.int.divSame x y, ← JuliaLean.base.int.remSame x y))
end IntegerParameters
abbrev unsignedDivide : JuliaLean.base.int.BinOpJl := fun x y =>
  let (a,b) := JuliaLean.base.int.promoteSameSign x y
  JuliaLean.base.int.divSame a b
def divideByUnsigned {t u : IntTy} (x : JInt t) (g : Jl (JInt u)) : Jl (JInt t) := do
  let g ← g
  if t.signed then
    let q ← JuliaLean.base.int.div_BitSigned_Unsigned unsignedDivide x g
    JInt.convert (t.name) t q.val
  else
    let q ← unsignedDivide x g
    JInt.convert (t.name) t q.val
def IntegerParameters.divNat {T : Type} : IntegerParameters T → T → Nat → Jl T
  | .bits t, x, g => divideByUnsigned x (JInt.convert (t.toUnsigned.name) t.toUnsigned g)
abbrev val {T : Type} (i : IntegerParameters T) := i.ops.toInt
abbrev rn {T : Type} (i : IntegerParameters T) (q : Rational T) := val i q.num
abbrev rd {T : Type} (i : IntegerParameters T) (q : Rational T) := val i q.den
def Canonical {T : Type} (i : IntegerParameters T) (q : Rational T) : Prop :=
  0 ≤ rd i q ∧ Nat.gcd (rn i q).natAbs (rd i q).natAbs = 1
def Represents {T : Type} (i : IntegerParameters T) (q : Rational T) (n d : Int) : Prop :=
  Canonical i q ∧ rn i q * d = n * rd i q ∧
  (d ≠ 0 → rd i q > 0) ∧ (d = 0 → rd i q = 0 ∧ intSign (rn i q) = intSign n)
def dg {T U : Type} (i : IntegerParameters T) (j : IntegerParameters U) : T → U → Jl (T × U) :=
  match i,j with
  | .bits t,.bits s => divgcdSource JuliaLean.base.float.uabs JuliaLean.base.float.uabs
      (fun a b => let (a,b) := JuliaLean.base.int.promoteSameSign a b
                  JuliaLean.base.intfuncs.gcd_BitInteger a b)
      divideByUnsigned divideByUnsigned
def ctor {T N D : Type} (i : IntegerParameters T) (ni : IntegerParameters N)
    (di : IntegerParameters D) : N → D → (Type → (N × D) → JlError) → Jl (Rational T) :=
  match i,ni,di with
  | .bits t,.bits n,.bits d => constructSource (JInt t) (jintOps t)
      (jintOps n).iszero (jintOps d).iszero (jintOps n).signbit (jintOps d).signbit
      JuliaLean.base.float.uabs JuliaLean.base.float.uabs
      (dg (.bits n.toUnsigned) (.bits d.toUnsigned))
      (fun x => JInt.convert (t.name) t x.val) (fun x => JInt.convert (t.name) t x.val)
      (dg (.bits n) (.bits d))
      (fun x => JInt.convert (t.name) t x.val) (fun x => JInt.convert (t.name) t x.val) Prod.mk
def rational {T : Type} (i : IntegerParameters T) : T → T → Jl (Rational T) :=
  match i with
  | .bits t => rationalSameSource (jintOps t) JuliaLean.base.float.uabs
      (dg (.bits t.toUnsigned) (.bits t.toUnsigned)) (fun x => JInt.convert (t.name) t x.val)
      (dg (.bits t) (.bits t)) Prod.mk
abbrev intRat {T U : Type} (i : IntegerParameters T) (j : IntegerParameters U) :=
  rationalIntAsSource T (fun x => i.ops.fromInt (val j x)) (fun _ => j.ops.one)
abbrev neg {T : Type} (i : IntegerParameters T) :=
  negRatSource i.ops.checkedNeg
inductive WideInteger where
  | bits (t : IntTy) (x : JInt t)
  | big (x : Int)
def WideInteger.value : WideInteger → Int | .bits _ x => x.val | .big x => x
def widenInteger {t : IntTy} (x : JInt t) : WideInteger :=
  match JuliaLean.base.int.widenType t with
  | some w => .bits w (JuliaLean.base.int.widenTo w x)
  | none => .big x.val
def signedWide : WideInteger → WideInteger
  | .bits _ x => .bits _ (JuliaLean.base.int.signed x)
  | .big x => .big x
def multiplyWide : WideInteger → WideInteger → WideInteger
  | .bits _ x,.bits _ y => .bits _ (JuliaLean.base.int.binop JuliaLean.base.int.mulSame x y)
  | x,y => .big (bigIntOps.mulWrap x.value y.value)
def widenMultiply {t s : IntTy} (x : JInt t) (y : JInt s) : WideInteger :=
  if t.signed && !s.signed then
    JuliaLean.base.int.Generic.widemul_Signed_Unsigned widenInteger widenInteger signedWide multiplyWide x y
  else if !t.signed && s.signed then
    JuliaLean.base.int.Generic.widemul_Unsigned_Signed widenInteger widenInteger signedWide multiplyWide x y
  else
    JuliaLean.base.int.okOf
      (JuliaLean.base.number.widemul (fun a => .ok (widenInteger a))
        (fun b => .ok (widenInteger b)) (fun a b => .ok (multiplyWide a b)) x y)
      (fun _ h => nomatch h)
def wide {T U : Type} (i : IntegerParameters T) (j : IntegerParameters U) : T → U → WideInteger :=
  match i,j with | .bits _,.bits _ => widenMultiply
def lessWide : WideInteger → WideInteger → Bool
  | .bits _ x,.bits _ y => JuliaLean.base.int.lt x y
  | x,y => bigIntOps.lt x.value y.value
def leWide : WideInteger → WideInteger → Bool
  | .bits _ x,.bits _ y => JuliaLean.base.int.le x y
  | x,y => bigIntOps.le x.value y.value
def componentWide {T : Type} (i : IntegerParameters T) : T → WideInteger :=
  match i with | .bits t => fun x => .bits t x
def integerLess {T U : Type} (i : IntegerParameters T) (j : IntegerParameters U) : T → U → Bool :=
  match i,j with | .bits _,.bits _ => JuliaLean.base.int.lt
def integerLe {T U : Type} (i : IntegerParameters T) (j : IntegerParameters U) : T → U → Bool :=
  match i,j with | .bits _,.bits _ => JuliaLean.base.int.le
def integerEq {T U : Type} (i : IntegerParameters T) (j : IntegerParameters U) : T → U → Bool :=
  match i,j with | .bits _,.bits _ => JuliaLean.base.int.eq
abbrev eqR {T U : Type} (i : IntegerParameters T) (j : IntegerParameters U) :=
  eqRatSource (integerEq i j) (integerEq i j)
inductive PromotionParameters : {T U P : Type} → IntegerParameters T → IntegerParameters U → IntegerParameters P → Type 1 where
  | same {T : Type} (i : IntegerParameters T) : PromotionParameters i i i
  | bits (t s : IntTy) : PromotionParameters (.bits t) (.bits s) (.bits (t.promote s))
def PromotionParameters.prom {T U P : Type} {i : IntegerParameters T} {j : IntegerParameters U}
    {p : IntegerParameters P} : PromotionParameters i j p → RatPromoteOps T U P
  | .same i => samePromoteOps i.ops
  | .bits t s => jintPromoteOps t s
abbrev convertRat {T U : Type} (i : IntegerParameters T) (j : IntegerParameters U) :=
  convertRatSource T (fun x => i.ops.fromInt (val j x))
abbrev promoteR {T U P : Type} {i : IntegerParameters T} {j : IntegerParameters U}
    {p : IntegerParameters P} (_m : PromotionParameters i j p)
    (x : Rational T) (y : Rational U) : Jl (Rational P × Rational P) := do
  let xp ← convertRat p i x
  let yp ← convertRat p j y
  pure (xp,yp)
abbrev add {T U P : Type} {i : IntegerParameters T} {j : IntegerParameters U}
    {p : IntegerParameters P} (m : PromotionParameters i j p) :=
  addRatSource m.prom (promoteR m) (fun x => decide (rd i x = 0)) (eqR i j)
    (dg p p) (rational p)
abbrev sub {T U P : Type} {i : IntegerParameters T} {j : IntegerParameters U}
    {p : IntegerParameters P} (m : PromotionParameters i j p) :=
  subRatSource m.prom (promoteR m) (fun x => decide (rd i x = 0)) (neg j) (eqR i j)
    (dg p p) (rational p)
def divgcd_spec : Prop :=
  ∀ {T U : Type} (i : IntegerParameters T) (j : IntegerParameters U)
    (x : T) (y : U) (h : val i x ≠ 0 ∨ val j y ≠ 0),
    ∃ a b, dg i j x y = .ok (a,b) ∧
      Nat.gcd (val i a).natAbs (val j b).natAbs = 1 ∧
      val i a * val j y = val i x * val j b ∧
      intSign (val i a) = intSign (val i x) ∧ intSign (val j b) = intSign (val j y)
def normalize_before_convert : Prop :=
  ∀ {T N D : Type} (i : IntegerParameters T)
    (ni : IntegerParameters N) (di : IntegerParameters D) (n : N) (d : D)
    (q : Rational T) (hq : Represents i q (val ni n) (val di d))
    (hd : val di d ≠ 0),
    ctor i ni di n d (inexactErrorCore "Rational") = .ok q
def checked_den_spec : Prop :=
  ∀ {T : Type} (i : IntegerParameters T) (n d : T),
    (0 ≤ val i d → ∃ q, checkedDenTypeSource T i.ops n d = .ok q ∧
      rn i q = val i n ∧ rd i q = val i d) ∧
    (val i d < 0 → i.fits (-val i d) → i.fits (-val i n) →
      ∃ q, checkedDenTypeSource T i.ops n d = .ok q ∧
        rd i q > 0 ∧ rn i q = -val i n ∧ rd i q = -val i d) ∧
    (val i d < 0 → (¬ i.fits (-val i d) ∨ ¬ i.fits (-val i n)) →
      IsOverflow (checkedDenTypeSource T i.ops n d))
def integer_construction : Prop :=
  ∀ {T U : Type} (i : IntegerParameters T) (j : IntegerParameters U)
    (n : U) (h : i.fits (val j n)),
    ∃ q, intRat i j n = .ok q ∧ Represents i q (val j n) 1
def exact_division : Prop :=
  ∀ (t s : IntTy) (x : Rat t) (y : Rat s)
    (hx : Normalized x) (hy : Normalized y),
    let p := t.promote s
    let run := divRatRatSource (jintPromoteOps t s) (dg (.bits p) (.bits p)) x y
    let convertFits := p.min ≤ x.num.val ∧ x.num.val ≤ p.max ∧
      p.min ≤ y.num.val ∧ y.num.val ≤ p.max
    let gn : Int := Nat.gcd x.num.val.natAbs y.num.val.natAbs
    let gd : Int := Nat.gcd x.den.val.natAbs y.den.val.natAbs
    let a := x.num.val.tdiv gn
    let b := y.num.val.tdiv gn
    let c := x.den.val.tdiv gd
    let e := y.den.val.tdiv gd
    let flip := c = 0 ∧ b < 0
    let an := if flip then -a else a
    let n := an * e
    let d := c * b
    let fits := fun n : Int => p.min ≤ n ∧ n ≤ p.max
    let safe := (flip → fits (-a)) ∧ fits n ∧ fits d ∧ (d < 0 → fits (-n) ∧ fits (-d))
    (¬ convertFits → IsInexact run) ∧
    (convertFits → (gn = 0 ∨ gd = 0) → run = .error .divideError) ∧
    (convertFits → gn ≠ 0 → gd ≠ 0 →
      (safe → ∃ q, run = .ok q ∧ Normalized q ∧
        q.num.val * d = n * q.den.val ∧
        (d ≠ 0 → q.den.val > 0) ∧
        (d = 0 → q.den.val = 0 ∧ intSign q.num.val = intSign n)) ∧
      (¬ safe → IsOverflow run)) ∧
    (convertFits → x.den.val > 0 → y.den.val = 0 →
      run = .ok (unsafeRationalSameSource (JInt.lit p 0) (JInt.lit p 1)))
def inverse_spec : Prop :=
  ∀ {T : Type} (i : IntegerParameters T) (x : Rational T)
    (hx : Canonical i x),
    (rn i x = 0 → ∃ q, invRatSource i.ops x = .ok q ∧ rn i q = 1 ∧ rd i q = 0) ∧
    (rn i x ≠ 0 → i.fits (if rn i x < 0 then -rd i x else rd i x) →
      i.fits (rn i x).natAbs → ∃ q, invRatSource i.ops x = .ok q ∧
        Represents i q (rd i x) (rn i x)) ∧
    (rn i x < 0 → (¬ i.fits (-rn i x) ∨ ¬ i.fits (-rd i x)) →
      IsOverflow (invRatSource i.ops x))
def signed_negation_involution : Prop :=
  ∀ (t : IntTy) (hs : t.signed = true) (x : Rat t)
    (hx : Normalized x),
    (x.num.val = t.min → IsOverflow (negBitSignedSource hs x)) ∧
    (x.num.val ≠ t.min → (do let y ← negBitSignedSource hs x; negBitSignedSource hs y) = .ok x)
def bool_conversion : Prop :=
  ∀ {T : Type} (i : IntegerParameters T) (x : Rational T)
    (hx : Canonical i x),
    let run := boolOfRatSource
      (fun q => eqRatIntSource i.ops.isone i.ops.eq q i.ops.zero)
      (fun q => eqRatIntSource i.ops.isone i.ops.eq q i.ops.one)
      x inexactErrorCore
    (rn i x = 0 → run = .ok false) ∧
    (rn i x = rd i x → run = .ok true) ∧
    (rn i x ≠ 0 → rn i x ≠ rd i x → IsInexact run)
def integer_conversion : Prop :=
  ∀ {T U : Type} (i : IntegerParameters T) (j : IntegerParameters U)
    (x : Rational U) (hx : Canonical j x),
    let run := intOfRatSource T i.ops.typeName (isIntegerRatSource j.ops.isone)
      (fun n => i.ops.fromInt (val j n)) x inexactErrorCore
    (rd j x = 1 → i.fits (rn j x) → ∃ n, run = .ok n ∧ val i n = rn j x) ∧
    (rd j x ≠ 1 ∨ ¬ i.fits (rn j x) → IsInexact run)
def compareExtended (n d m e : Int) : Int :=
  if d = 0 then
    if e = 0 then intCmp (intSign n) (intSign m) else intSign n
  else if e = 0 then -intSign m
  else intCmp (n*e) (m*d)
def rational_comparisons : Prop :=
  ∀ {T U : Type} (i : IntegerParameters T) (j : IntegerParameters U)
    (x : Rational T) (y : Rational U) (hx : Canonical i x) (hy : Canonical j y),
    let cmp := compareExtended (rn i x) (rd i x) (rn j y) (rd j y)
    let less := ltRatSource (integerEq i j)
      (integerLess i j)
      (wide i j) (wide i j) lessWide
    let le := leRatSource (integerEq i j)
      (integerLe i j)
      (wide i j) (wide i j) leWide
    eqR i j x y = decide (cmp = 0) ∧
    less x y = decide (cmp < 0) ∧ le x y = decide (cmp ≤ 0) ∧
    (rd i x = 0 → rd j y = 0 →
      eqR i j x y = decide (intSign (rn i x) = intSign (rn j y))) ∧
    (rd i x > 0 → rd j y = 0 →
      less x y = decide (rn j y > 0) ∧ le x y = decide (rn j y > 0)) ∧
    (rd i x = 0 → rd j y > 0 →
      less x y = decide (rn i x < 0) ∧ le x y = decide (rn i x < 0))
def integer_comparisons : Prop :=
  ∀ {T U : Type} (i : IntegerParameters T) (j : IntegerParameters U)
    (x : Rational T) (y : U) (hx : Canonical i x) (hd : rd i x > 0),
    eqRatIntSource i.ops.isone (integerEq i j) x y =
      decide (rn i x % rd i x = 0 ∧ rounded (rn i x) (rd i x) .down = val j y) ∧
    ltRatIntSource (wide i j) (fun a b => lessWide (componentWide i a) b) x y =
      decide (rounded (rn i x) (rd i x) .down < val j y) ∧
    ltIntRatSource (wide j i) (fun a b => lessWide a (componentWide i b)) y x =
      decide (val j y < rounded (rn i x) (rd i x) .up) ∧
    leRatIntSource (wide i j) (fun a b => leWide (componentWide i a) b) x y =
      decide (rounded (rn i x) (rd i x) .up ≤ val j y) ∧
    leIntRatSource (wide j i) (fun a b => leWide a (componentWide i b)) y x =
      decide (val j y ≤ rounded (rn i x) (rd i x) .down)
