namespace JuliaLean.Proofs.base.rational.MethodContracts
open JuliaLean JuliaLean.base.rational

/-- Construction from an existing rational preserves canonical finite values. -/
def identityValue : Prop :=
  ∀ (t : IntTy) (q : Rat t), Normalized q →
    Normalized (rationalIdentitySource q) ∧
    (rationalIdentitySource q).num.val * q.den.val = q.num.val * (rationalIdentitySource q).den.val

/-- Integer and Gaussian-integer numerators preserve both integer coordinates. -/
def integerNumeratorValue : Prop :=
  (∀ (t : IntTy) (x : JInt t), (numeratorIntegerOrComplex x).val = x.val) ∧
  (∀ (t : IntTy) (z : ComplexValue (JInt t)),
    (numeratorIntegerOrComplex z).re.val = z.re.val ∧
    (numeratorIntegerOrComplex z).im.val = z.im.val)

/-- Equality retains first-call exceptions and prior effects, as well as its numeric contract. -/
def integerEquality : Prop := RationalIntegerComparisonsExact ∧
  ∀ (E S T I A B R : Type) (equalDen : T → JInt .i64 → EStateM E S A)
    (equalNum : T → I → EStateM E S B) (bitAnd : A → B → EStateM E S R)
    (x : Rational T) (y : I) (initial after : S) (error : E),
    equalDen x.den (JInt.lit .i64 1) initial = .error error after →
    eqRatIntMethod equalDen equalNum bitAnd x y initial = .error error after

def integerEqualityReverse : Prop := RationalIntegerComparisonsExact ∧
  ∀ (E S T I R : Type) (equal : Rational T → I → EStateM E S R)
    (x : I) (y : Rational T) (initial after : S) (error : E),
    equal y x initial = .error error after →
    eqIntRatMethod equal x y initial = .error error after

/-- Widened comparisons preserve multiplication failures without evaluating the relation. -/
def lessInteger : Prop := RationalIntegerComparisonsExact ∧
  ∀ (E S T I W R : Type) (mul : T → I → EStateM E S W)
    (less : T → W → EStateM E S R) (x : Rational T) (y : I)
    (initial after : S) (error : E),
    mul x.den y initial = .error error after →
    ltRatIntMethod mul less x y initial = .error error after

def integerLess : Prop := RationalIntegerComparisonsExact ∧
  ∀ (E S T I W R : Type) (mul : I → T → EStateM E S W)
    (less : W → T → EStateM E S R) (x : I) (y : Rational T)
    (initial after : S) (error : E),
    mul x y.den initial = .error error after →
    ltIntRatMethod mul less x y initial = .error error after

def lessEqualInteger : Prop := RationalIntegerComparisonsExact ∧
  ∀ (E S T I W R : Type) (mul : T → I → EStateM E S W)
    (less : T → W → EStateM E S R) (x : Rational T) (y : I)
    (initial after : S) (error : E),
    mul x.den y initial = .error error after →
    leRatIntMethod mul less x y initial = .error error after

def integerLessEqual : Prop := RationalIntegerComparisonsExact ∧
  ∀ (E S T I W R : Type) (mul : I → T → EStateM E S W)
    (less : W → T → EStateM E S R) (x : I) (y : Rational T)
    (initial after : S) (error : E),
    mul x y.den initial = .error error after →
    leIntRatMethod mul less x y initial = .error error after

def floatEqualityReverse : Prop := FiniteFloatEquality ∧
  ∀ (E S T F R : Type) (equal : F → Rational T → EStateM E S R)
    (q : Rational T) (x : F) (initial after : S) (error : E),
    equal x q initial = .error error after →
    eqRatFloatMethod equal q x initial = .error error after

/-- Eager complex comparison preserves a failure from its real-component getter. -/
def complexEquality : Prop := ComplexRationalEqualityValue ∧
  ∀ (E S C P Q A B R : Type) (isreal : C → EStateM E S A)
    (real : C → EStateM E S P) (equal : P → Q → EStateM E S B)
    (bitAnd : A → B → EStateM E S R) (z : C) (x : Q)
    (initial middle after : S) (test : A) (error : E),
    isreal z initial = .ok test middle → real z middle = .error error after →
    eqComplexRatMethod isreal real equal bitAnd z x initial = .error error after

def complexEqualityReverse : Prop := ComplexRationalEqualityValue ∧
  ∀ (E S C P Q A B R : Type) (isreal : C → EStateM E S A)
    (real : C → EStateM E S P) (equal : P → Q → EStateM E S B)
    (bitAnd : A → B → EStateM E S R) (z : C) (x : Q)
    (initial middle after : S) (test : A) (error : E),
    isreal z initial = .ok test middle → real z middle = .error error after →
    eqRatComplexMethod isreal real equal bitAnd x z initial = .error error after

/-- A failed exponent preparation prevents exponentiation and retains completed effects. -/
def numberPower : Prop :=
  ∀ (E S T X D R : Type) (divide : T → T → EStateM E S D)
    (power : X → D → EStateM E S R) (x : X) (y : Rational T)
    (initial after : S) (error : E),
    divide y.num y.den initial = .error error after →
    powNumberRationalMethod divide power x y initial = .error error after

def floatPower : Prop :=
  ∀ (E S T X D R : Type) (convert : Rational T → EStateM E S D)
    (power : X → D → EStateM E S R) (x : X) (y : Rational T)
    (initial after : S) (error : E),
    convert y initial = .error error after →
    powFloatRationalMethod convert power x y initial = .error error after

def complexPower : Prop :=
  ∀ (E S T Target One P TypeRep D Z R : Type)
    (one : Target → EStateM E S One) (powerOne : One → Rational T → EStateM E S P)
    (typeOf : P → TypeRep) (convert : TypeRep → Rational T → EStateM E S D)
    (power : Z → D → EStateM E S R) (target : Target) (z : Z) (p : Rational T)
    (initial after : S) (error : E),
    one target initial = .error error after →
    powComplexRationalMethod one powerOne typeOf convert power target z p initial = .error error after

/-- A rational zero test is independent of its denominator and exact on native integers. -/
def zeroValue : Prop :=
  (∀ (T : Type) (iszero : T → Bool) (n d e : T),
    isZeroRationalSource iszero (⟨n,d⟩ : Rational T) =
      isZeroRationalSource iszero (⟨n,e⟩ : Rational T)) ∧
  (∀ (t : IntTy) (q : Rat t),
    isZeroRationalSource (jintOps t).iszero q = true ↔ q.num.val = 0)

/-- A false first predicate does not suppress the second predicate's exception. -/
def oneEffects : Prop :=
  ∀ (E S T A R : Type) (isone : T → EStateM E S A)
    (bitAnd : A → A → EStateM E S R) (x : Rational T)
    (initial middle after : S) (first : A) (error : E),
    isone x.num initial = .ok first middle → isone x.den middle = .error error after →
    isOneRationalMethod isone bitAnd x initial = .error error after

/-- Interpolation keeps a left-quotient failure ahead of every right-operand operation. -/
def interpolation : Prop :=
  ∀ (E S J D TA TB DS L QL R QR Out : Type)
    (sub : D → J → EStateM E S DS) (mulLeft : DS → Rational TA → EStateM E S L)
    (divLeft : L → D → EStateM E S QL) (mulRight : J → Rational TB → EStateM E S R)
    (divRight : R → D → EStateM E S QR) (add : QL → QR → EStateM E S Out)
    (j : J) (d : D) (a : Rational TA) (b : Rational TB)
    (initial s1 s2 after : S) (difference : DS) (product : L) (error : E),
    sub d j initial = .ok difference s1 → mulLeft difference a s1 = .ok product s2 →
    divLeft product d s2 = .error error after →
    lerpiMethod sub mulLeft divLeft mulRight divRight add j d a b initial = .error error after

/-- Generated division rounds toward zero and retains selected failures and their state. -/
def defaultDivision : Prop := Models1Group20.DefaultDivCorrect ∧
  ∀ (E S X Y R : Type) (divide : X → Y → Rounding → EStateM E S R)
    (x : X) (y : Y) (initial after : S) (error : E),
    divide x y .toZero initial = .error error after →
    divDefaultSource divide x y initial = .error error after

def defaultFloor : Prop := Models1Group20.DefaultFldCorrect ∧
  ∀ (E S X Y R : Type) (divide : X → Y → Rounding → EStateM E S R)
    (x : X) (y : Y) (initial after : S) (error : E),
    divide x y .down initial = .error error after →
    fldDefaultSource divide x y initial = .error error after

def defaultCeiling : Prop := Models1Group20.DefaultCldCorrect ∧
  ∀ (E S X Y R : Type) (divide : X → Y → Rounding → EStateM E S R)
    (x : X) (y : Y) (initial after : S) (error : E),
    divide x y .up initial = .error error after →
    cldDefaultSource divide x y initial = .error error after

def defaultRounding : Prop := Models1Group20.RoundNativeDefaultCorrect ∧
  ∀ (E S T Target R : Type) (typeOf : Rational T → Target)
    (round : Target → Rational T → Rounding → EStateM E S R)
    (x : Rational T) (mode : Rounding) (initial after : S) (error : E),
    round (typeOf x) x mode initial = .error error after →
    roundRatDefaultSource typeOf round x mode initial = .error error after

/-- Explicit invoke preserves the selected invocation failure, including prior state changes. -/
def compatibilityDivision : Prop := Models1Group20.RoundedSameRatCorrect ∧
  ∀ (E S T R : Type)
    (divide : Rational T → Rational T → Rounding → EStateM E S R)
    (invoke : (Rational T → Rational T → Rounding → EStateM E S R) →
      RationalInvokeTarget → Rational T → Rational T → Rounding → EStateM E S R)
    (x y : Rational T) (mode : Rounding) (initial after : S) (error : E),
    invoke divide .tupleRationalRationalRoundingMode x y mode initial = .error error after →
    divCompatibilitySource divide invoke x y mode initial = .error error after

/-- Floating type selection agrees with native conversion and preserves selected errors. -/
def floatingType : Prop := Models1Group20.FloatNativeRationalTypeCorrect ∧
  ∀ (E S Target R : Type) (float : Target → EStateM E S R)
    (target : Target) (initial after : S) (error : E),
    float target initial = .error error after →
    floatTypeSource float target initial = .error error after

end JuliaLean.Proofs.base.rational.MethodContracts

namespace JuliaLean.Proofs.base.rational.MethodContracts
open JuliaLean JuliaLean.base.rational

/-- A custom real getter can return the original Complex and reselect the
same equality method forever. No finite result may be manufactured. -/
def complexEqualityCycle : Prop :=
  ∀ (C Q A R : Type) (z : C) (q : Q) (test : A) (fallback : R),
    eqComplexRatFull (m := Option) (fun _ => some test) (fun value => some value)
      (fun _ _ => some fallback) (fun _ _ => some fallback)
      { classify := fun args => .inherited args, embedReturn := id } z q = none

/-- A component quotient returned as the same Rational can reselect the
Number/Rational power method without terminating. -/
def numberPowerCycle : Prop :=
  ∀ (T X R : Type) (x : X) (y : Rational T) (fallback : R),
    powNumberRationalFull (m := Option) (fun _ _ => some y)
      (fun _ _ => some fallback) (fun base exponent => .inherited (base, exponent)) x y = none

/-- A malformed custom conversion can return its original Rational and
reselect the AbstractFloat/Rational power method without terminating. -/
def floatPowerCycle : Prop :=
  ∀ (T X R : Type) (x : X) (y : Rational T) (fallback : R),
    powFloatRationalFull (m := Option) (fun value => some value)
      (fun _ _ => some fallback) (fun base exponent => .inherited (base, exponent)) x y = none

/-- The final complex power call may reselect this method after conversion
returns the unchanged Rational exponent. -/
def complexPowerCycle : Prop :=
  ∀ (T Target One P TypeRep Z R : Type) (target : Target) (z : Z) (p : Rational T)
    (unit : One) (onePower : P) (typeRep : TypeRep) (fallback : R),
    powComplexRationalFull (m := Option) (fun _ => some unit) (fun _ _ => some onePower)
      (fun _ => typeRep) (fun _ value => some value) (fun _ _ => some fallback)
      { classify := fun _ => .selectedOther, embedReturn := fun _ => onePower }
      (fun base exponent => .inherited (target, base, exponent)) target z p = none

end JuliaLean.Proofs.base.rational.MethodContracts

