def CheckedDenNoPrematureStorage : Prop :=
  ∀ (World T Neg NotBool R : Type)
    (ops : CheckedDenOps (EStateM ArrayError World) T Neg NotBool R)
    (num den : T) (initial : World),
    match checkedDenTyped (observeCheckedDenCalls ops) num den (initial, []) with
    | .ok _ (_, calls) =>
        CheckedDenTraceInvariant calls ∧
        calls.count .originalConstructor + calls.count .negatedConstructor = 1
    | .error _ (_, calls) => CheckedDenTraceInvariant calls

