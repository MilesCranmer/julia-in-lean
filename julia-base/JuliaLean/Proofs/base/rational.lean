private theorem mul_scalar_contract (t s : IntTy) (x : Rat t) (k : JInt s)
    (hx : Normalized x) :
    let p := IntegerParameters.bits (t.promote s)
    let cv := p.fits x.num.val ∧ p.fits x.den.val ∧ p.fits k.val
    let g : Int := Nat.gcd x.den.val.natAbs k.val.natAbs
    let n := x.num.val*k.val.tdiv g
    let d := x.den.val.tdiv g
    let run := mulRatIntSource (Round6.nativePromotion t s) (dg p p) x k
    (¬ cv → JuliaLean.Statements.rational.Round21.HasError run) ∧
    (cv → g = 0 → JuliaLean.Statements.rational.Round21.HasError run) ∧
    (cv → g ≠ 0 →
      (FitsPair p n d → ExactResult p run (x.num.val*k.val) x.den.val) ∧
      (¬ FitsPair p n d → JuliaLean.Statements.rational.Round21.HasError run)) := by
  intro p cv g n d run
  let m : PromotionParameters (.bits t) (.bits s) p := .bits t s
  have hprom := prom_promote_spec m x.den k
  refine ⟨?_,?_,?_⟩
  · intro hnot
    by_cases hpair : FitsPair p x.den.val k.val
    · obtain ⟨a,b,hp,_,_⟩ := hprom.1 hpair
      cases hgcall : dg p p a b with
      | error e => exact ⟨e,by simp [run,mulRatIntSource,show
          (Round6.nativePromotion t s).promote x.den k = .ok (a,b) from hp,hgcall]⟩
      | ok ab =>
        have hn : ¬ p.fits x.num.val := fun h => hnot ⟨h,hpair.1,hpair.2⟩
        exact ⟨.inexactError (t.promote s).name,by
          simp [run,mulRatIntSource,show (Round6.nativePromotion t s).promote x.den k = .ok (a,b) from hp,
            hgcall,native_mulXP_num_error t s x.num ab.2 hn]⟩
    · obtain ⟨msg,he⟩ := hprom.2 hpair
      exact ⟨.inexactError msg,by simp [run,mulRatIntSource,show
        (Round6.nativePromotion t s).promote x.den k = .error (.inexactError msg) from he]⟩
  · intro hc hg0
    obtain ⟨a,b,hp,ha,hb⟩ := hprom.1 ⟨hc.2.1,hc.2.2⟩
    change a.val = x.den.val at ha
    change b.val = k.val at hb
    have hg : (Nat.gcd a.val.natAbs b.val.natAbs : Int) = 0 := by rw [ha,hb]; exact hg0
    exact ⟨.divideError,by simp [run,mulRatIntSource,show
      (Round6.nativePromotion t s).promote x.den k = .ok (a,b) from hp,
      show dg p p = dgBits from rfl,(dgBits_spec a b).1 hg]⟩
  · intro hc hgnz
    obtain ⟨a,b,hp,ha,hb⟩ := hprom.1 ⟨hc.2.1,hc.2.2⟩
    change a.val = x.den.val at ha
    change b.val = k.val at hb
    have hg : (Nat.gcd a.val.natAbs b.val.natAbs : Int) = g := by dsimp [g]; rw [ha,hb]
    obtain ⟨ad,bn,hdg,had,hbn,hadabs,hbnabs,hcop,ham,hbm,_,_,_⟩ :=
      (dgBits_spec a b).2 (by rw [hg]; exact hgnz)
    rw [hg,ha] at had ham
    rw [hg,hb] at hbn hbm
    have hbase : run = (do
        let num ← m.prom.checkedMulXP x.num bn
        pure (unsafeRationalSameSource num ad)) := by
      simp [run,mulRatIntSource,show (Round6.nativePromotion t s).promote x.den k = .ok (a,b) from hp,
        show dg p p = dgBits from rfl,hdg,native_mulXP_eq t s x.num bn hc.1,m]
    have hm := prom_checkedMulXP_spec m x.num bn hc.1
    change (p.fits (x.num.val*bn.val) → ∃ r,
      m.prom.checkedMulXP x.num bn = .ok r ∧ r.val = x.num.val*bn.val) ∧
      (¬ p.fits (x.num.val*bn.val) → _) at hm
    rw [hbn] at hm
    have hgpos : 0 < g := by dsimp [g]; omega
    have hadd : p.fits d := by
      change (t.promote s).min ≤ x.den.val.tdiv g ∧ x.den.val.tdiv g ≤ (t.promote s).max
      rw [← had]; exact ad.property
    constructor
    · intro hfit
      obtain ⟨num,hnum,hnval⟩ := hm.1 hfit.1
      refine ⟨⟨num,ad⟩,by simp [hbase,hnum,unsafeRationalSameSource_pair],?_⟩
      have hdnn : 0 ≤ ad.val := by rw [had]; exact ((tdiv_between x.den.val g hgpos).1 hx.1).1
      have hnorm : Canonical p (⟨num,ad⟩ : Rat (t.promote s)) := by
        change 0 ≤ ad.val ∧ Nat.gcd num.val.natAbs ad.val.natAbs = 1
        refine ⟨hdnn,?_⟩
        rw [hnval,← hbn,Int.natAbs_mul]
        exact Nat.Coprime.mul_left
          (Nat.Coprime.coprime_dvd_right (by
            rw [hadabs,ha]; exact Nat.div_dvd_of_dvd (Nat.gcd_dvd_left _ _)) hx.2)
          (Nat.Coprime.symm hcop)
      have hrep : Represents p (⟨num,ad⟩ : Rat (t.promote s)) num.val ad.val :=
        ⟨hnorm,rfl,fun hn => by change 0 < ad.val; omega,fun hz => ⟨hz,rfl⟩⟩
      have hs := represents_scale_pos hgpos hrep
      have hnscale : num.val*g = x.num.val*k.val := by rw [hnval,← hbn,Int.mul_assoc,hbm]
      simpa only [hnscale,ham] using hs
    · intro hnot
      have hn : ¬ p.fits n := fun h => hnot ⟨h,hadd⟩
      obtain ⟨msg,he⟩ := hm.2 hn
      exact ⟨.overflowError msg,by simp [hbase,he]⟩

private theorem checkedDen_exact (t : IntTy) (ops : RatIntOps (JInt t))
    (hsign : ops.signbit = (jintOps t).signbit)
    (hneg : ops.checkedNeg = (jintOps t).checkedNeg) (n d : JInt t)
    (hcop : Nat.gcd n.val.natAbs d.val.natAbs = 1) :
    let safe := d.val < 0 → FitsPair (.bits t) (-n.val) (-d.val)
    (safe → ExactResult (.bits t) (checkedDenSameSource ops n d) n.val d.val) ∧
    (¬ safe → JuliaLean.Statements.rational.Round21.HasError (checkedDenSameSource ops n d)) := by
  intro safe
  have h := checkedDenBits_spec ops hsign hneg n d
  by_cases hd : d.val < 0
  · refine ⟨fun hs => ?_,fun hn => ?_⟩
    · obtain ⟨q,hq,hqd,hqn,hqdv⟩ := h.2.1 hd (hs hd).2 (hs hd).1
      refine ⟨q,hq,?_,?_,fun _ => hqd,fun hz => by omega⟩
      · change 0 ≤ q.den.val ∧ Nat.gcd q.num.val.natAbs q.den.val.natAbs = 1
        refine ⟨by omega,?_⟩
        rw [hqn,hqdv,Int.natAbs_neg,Int.natAbs_neg]; exact hcop
      · change q.num.val*d.val = n.val*q.den.val
        rw [hqn,hqdv,Int.neg_mul,Int.mul_neg]
    · have hn' : ¬ FitsPair (.bits t) (-n.val) (-d.val) := fun hh => hn (fun _ => hh)
      have hb : (¬ (t.min ≤ -d.val ∧ -d.val ≤ t.max)) ∨ ¬ (t.min ≤ -n.val ∧ -n.val ≤ t.max) := by
        by_cases hd : t.min ≤ -d.val ∧ -d.val ≤ t.max
        · exact Or.inr (fun h => hn' ⟨h,hd⟩)
        · exact Or.inl hd
      obtain ⟨msg,he⟩ := h.2.2 hd hb
      exact ⟨.overflowError msg,he⟩
  · refine ⟨fun _ => ?_,fun hn => False.elim (hn (fun hh => False.elim (hd hh)))⟩
    have hnn : 0 ≤ d.val := by omega
    exact ⟨⟨n,d⟩,h.1 hnn,⟨hnn,hcop⟩,rfl,fun hz => by change d.val > 0; omega,
      fun hz => ⟨hz,rfl⟩⟩

private theorem div_scalar_contract (t s : IntTy) (x : Rat t) (k : JInt s) (hx : Normalized x) :
    let p := IntegerParameters.bits (t.promote s)
    let cv := p.fits x.num.val ∧ p.fits x.den.val ∧ p.fits k.val
    let g : Int := Nat.gcd x.num.val.natAbs k.val.natAbs
    let dn := x.num.val.tdiv g
    let dd := x.den.val*k.val.tdiv g
    let safe := p.fits dd ∧ (dd < 0 → FitsPair p (-dn) (-dd)) ∧
      (x.den.val = 0 ∧ k.val < 0 → p.fits (-dn))
    let num := if decide (x.den.val = 0 ∧ k.val < 0) then -x.num.val else x.num.val
    let run := divRatIntSource (Round6.nativePromotion t s) (dg p p) x k
    (¬ cv → JuliaLean.Statements.rational.Round21.HasError run) ∧
    (cv → g = 0 → JuliaLean.Statements.rational.Round21.HasError run) ∧
    (cv → g ≠ 0 →
      (safe → ExactResult p run num (x.den.val*k.val)) ∧
      (¬ safe → JuliaLean.Statements.rational.Round21.HasError run)) := by
  intro p cv g dn dd safe num run
  let m : PromotionParameters (.bits t) (.bits s) p := .bits t s
  have hd : p.fits x.den.val :=
    ⟨Int.le_trans (min_le_zero _) hx.1,Int.le_trans x.den.property.2 (max_le_promote_left t s)⟩
  have hp := prom_promote_spec m x.num k
  have hpr (a : JInt (t.promote s)) (b : JInt (t.promote s))
      (hh : m.prom.promote x.num k = .ok (a,b)) :
      (Round6.nativePromotion t s).promote x.num k = .ok (a,b) := hh
  refine ⟨?_,?_,?_⟩
  · intro hn
    have hn' : ¬ FitsPair p x.num.val k.val := fun h => hn ⟨h.1,hd,h.2⟩
    obtain ⟨msg,he⟩ := hp.2 hn'
    exact ⟨.inexactError msg,by simp [run,divRatIntSource,show
      (Round6.nativePromotion t s).promote x.num k = .error (.inexactError msg) from he]⟩
  · intro hc hg0
    obtain ⟨a,b,hp,ha,hb⟩ := hp.1 ⟨hc.1,hc.2.2⟩
    change a.val = x.num.val at ha
    change b.val = k.val at hb
    have hg : (Nat.gcd a.val.natAbs b.val.natAbs : Int) = 0 := by rw [ha,hb]; exact hg0
    exact ⟨.divideError,by simp [run,divRatIntSource,hpr a b hp,
      show dg p p = dgBits from rfl,(dgBits_spec a b).1 hg]⟩
  · intro hc hgnz
    obtain ⟨a,b,hp,ha,hb⟩ := hp.1 ⟨hc.1,hc.2.2⟩
    change a.val = x.num.val at ha
    change b.val = k.val at hb
    have hg : (Nat.gcd a.val.natAbs b.val.natAbs : Int) = g := by dsimp [g]; rw [ha,hb]
    obtain ⟨xn,yn,hdg,hxn,hyn,hxnabs,hynabs,hcop,hxm,hym,_,_,hsyn⟩ :=
      (dgBits_spec a b).2 (by rw [hg]; exact hgnz)
    rw [hg,ha] at hxn hxm
    rw [hg,hb] at hyn hym
    have hgpos : 0 < g := by dsimp [g]; omega
    have hneg : yn.val < 0 ↔ k.val < 0 := by
      rw [hb] at hsyn
      unfold intSign at hsyn
      split at hsyn <;> split at hsyn <;> omega
    let flip := x.den.val = 0 ∧ k.val < 0
    have hflip : ((Round6.nativePromotion t s).opsX.iszero x.den &&
        (Round6.nativePromotion t s).opsP.signbit yn) = decide flip := by
      change (decide (x.den.val = 0) && decide (yn.val < 0)) = decide flip
      simp only [Bool.and_eq_decide,hneg,decide_eq_true_eq]; rfl
    have hbase : run = (do
        let n ← (if decide flip then (jintOps (t.promote s)).checkedNeg xn else pure xn)
        let d ← m.prom.checkedMulXP x.den yn
        checkedDenSameSource (Round6.nativePromotion t s).opsP n d) := by
      simp only [run,divRatIntSource,hpr a b hp,Bind.bind,Except.bind,
        show dg p p = dgBits from rfl,hdg,hflip]
      by_cases hf : flip <;> simp only [hf,decide_true,decide_false,
        ite_true,ite_false,native_mulXP_eq t s x.den yn hd]
      all_goals rfl
    have hdd := prom_checkedMulXP_spec m x.den yn hd
    change (p.fits (x.den.val*yn.val) → ∃ r, m.prom.checkedMulXP x.den yn = .ok r ∧ r.val = x.den.val*yn.val) ∧
      (¬ p.fits (x.den.val*yn.val) → _) at hdd
    rw [hyn] at hdd
    have hnstep : (flip → p.fits (-dn)) →
        ∃ n, (if decide flip then (jintOps (t.promote s)).checkedNeg xn else pure xn) = .ok n ∧
          n.val = if flip then -dn else dn := by
      intro hs
      by_cases hf : flip
      · have hh := JuliaLean.Proofs.base.checked.negExact (t.promote s) xn
        unfold JuliaLean.Proofs.base.checked.ExactOrOverflow at hh
        have hfit : (t.promote s).min ≤ -x.num.val.tdiv g ∧ -x.num.val.tdiv g ≤ (t.promote s).max := hs hf
        rw [hxn,if_pos hfit] at hh
        obtain ⟨n,hn,hnv⟩ := hh
        exact ⟨n,by simpa [hf,jintOps,JuliaLean.base.rational.checkedNeg] using hn,by simpa [hf] using hnv⟩
      · exact ⟨xn,by simp [hf],by simpa [hf] using hxn⟩
    have hfinish (n d : JInt (t.promote s)) (hnv : n.val = if flip then -dn else dn)
        (hdv : d.val = dd) :
        let norm := dd < 0 → FitsPair p (-dn) (-dd)
        (norm → ExactResult p (checkedDenSameSource (Round6.nativePromotion t s).opsP n d) num (x.den.val*k.val)) ∧
        (¬ norm → JuliaLean.Statements.rational.Round21.HasError
          (checkedDenSameSource (Round6.nativePromotion t s).opsP n d)) := by
      intro norm
      have hflipdd : flip → dd = 0 := by intro hf; dsimp [dd]; rw [hf.1,Int.zero_mul]
      have hcop' : Nat.gcd n.val.natAbs d.val.natAbs = 1 := by
        rw [hnv,hdv]
        have hna : (if flip then -dn else dn).natAbs = dn.natAbs := by split <;> simp [Int.natAbs_neg]
        rw [hna]
        change Nat.gcd (x.num.val.tdiv g).natAbs (x.den.val*k.val.tdiv g).natAbs = 1
        rw [← hxn,← hyn,Int.natAbs_mul]
        exact Nat.Coprime.mul_right
          (Nat.Coprime.coprime_dvd_left (by rw [hxnabs,ha]; exact Nat.div_dvd_of_dvd (Nat.gcd_dvd_left _ _)) hx.2)
          hcop
      have hncond : (d.val < 0 → FitsPair p (-n.val) (-d.val)) ↔ norm := by
        rw [hdv]
        constructor <;> intro hh hlt
        · have hf : ¬ flip := fun hf => by have := hflipdd hf; omega
          simpa only [hnv,if_neg hf] using hh hlt
        · have hf : ¬ flip := fun hf => by have := hflipdd hf; omega
          simpa only [hnv,if_neg hf] using hh hlt
      have hcd := checkedDen_exact (t.promote s) (Round6.nativePromotion t s).opsP rfl rfl n d hcop'
      refine ⟨fun hs => ?_,fun hn => hcd.2 (fun hh => hn (hncond.mp hh))⟩
      obtain ⟨q,hq,hr⟩ := hcd.1 (hncond.mpr hs)
      refine ⟨q,hq,?_⟩
      have hscaled := represents_scale_pos hgpos hr
      have hnscale : n.val*g = num := by
        change n.val*g = (if decide flip then -x.num.val else x.num.val)
        simp only [decide_eq_true_eq]
        have hdnmul : dn*g = x.num.val := by dsimp [dn]; rw [← hxn]; exact hxm
        rw [hnv]
        split <;> simp only [Int.neg_mul,hdnmul]
      have hdscale : d.val*g = x.den.val*k.val := by rw [hdv]; dsimp [dd]; rw [Int.mul_assoc,← hyn,hym]
      simpa only [hnscale,hdscale] using hscaled
    constructor
    · intro hs
      obtain ⟨n,hn,hnv⟩ := hnstep hs.2.2
      obtain ⟨d,hdcall,hdv⟩ := hdd.1 hs.1
      obtain ⟨q,hq,hr⟩ := (hfinish n d hnv hdv).1 hs.2.1
      exact ⟨q,by rw [hbase,hn]; simp [hdcall,hq],hr⟩
    · intro hnot
      by_cases hfirst : flip → p.fits (-dn)
      · obtain ⟨n,hn,hnv⟩ := hnstep hfirst
        by_cases hden : p.fits dd
        · obtain ⟨d,hdcall,hdv⟩ := hdd.1 hden
          have hnorm : ¬ (dd < 0 → FitsPair p (-dn) (-dd)) := fun h => hnot ⟨hden,h,hfirst⟩
          obtain ⟨e,he⟩ := (hfinish n d hnv hdv).2 hnorm
          exact ⟨e,by rw [hbase,hn]; simp [hdcall,he]⟩
        · obtain ⟨msg,he⟩ := hdd.2 hden
          exact ⟨.overflowError msg,by rw [hbase,hn]; simp [he]⟩
      · have hf : flip := Classical.byContradiction (fun hf => hfirst (fun h => False.elim (hf h)))
        have hn : ¬ p.fits (-dn) := fun h => hfirst (fun _ => h)
        have hh := JuliaLean.Proofs.base.checked.negExact (t.promote s) xn
        unfold JuliaLean.Proofs.base.checked.ExactOrOverflow at hh
        have hn' : ¬ ((t.promote s).min ≤ -x.num.val.tdiv g ∧ -x.num.val.tdiv g ≤ (t.promote s).max) := hn
        rw [hxn,if_neg hn'] at hh
        cases hncall : JuliaLean.base.checked.checkedNegBits xn with
        | error e => exact ⟨e,by simp [hbase,hf,jintOps,JuliaLean.base.rational.checkedNeg,hncall]⟩
        | ok z => rw [hncall] at hh; contradiction

theorem public_scalar_arithmetic_proven : JuliaLean.Statements.rational.Round21.public_scalar_arithmetic := by
  intro t s x k hx i j p cv prod ga gn mn md dn dd divNum addRun subRun mulRun divRun slashRun
  have ha := scalar_outcome false t s x k hx
  have hs := scalar_outcome true t s x k hx
  have hm := mul_scalar_contract t s x k hx
  have hd := div_scalar_contract t s x k hx
  refine ⟨⟨ha,hs⟩,?_,?_,?_,?_,?_⟩
  · intro hn
    exact ⟨hm.1 hn,(hd.1 hn),(hd.1 hn)⟩
  · exact hm.2.1
  · intro hc hg
    exact ⟨fun hn => False.elim (hn trivial),fun _ hf => ((hm.2.2 hc hg).1 hf),
      fun _ hn => ((hm.2.2 hc hg).2 hn)⟩
  · intro hc hg
    exact ⟨hd.2.1 hc hg,hd.2.1 hc hg⟩
  · intro hc hg
    exact ⟨fun hh => ⟨(hd.2.2 hc hg).1 hh,(hd.2.2 hc hg).1 hh⟩,
      fun hh => ⟨(hd.2.2 hc hg).2 hh,(hd.2.2 hc hg).2 hh⟩⟩

theorem mixed_arithmetic_proven : JuliaLean.Statements.rational.Round21.mixed_arithmetic :=
  ⟨public_scalar_arithmetic_proven,public_integer_left_proven,public_integer_left_quotient_proven⟩

end JuliaLean.Proofs.base.rational.MixedProof

namespace JuliaLean.Proofs.base.rational.Round3
open JuliaLean JuliaLean.Promotion JuliaLean.base.rational

/-- `Rational{Int8}(Int16(128), Int16(-1))`: the reduced value `-128//1` fits `Int8`, but the
constructor converts the numerator `128` to `Int8` before moving the sign, and throws. -/
theorem normalize_before_convert_refuted : ¬ normalize_before_convert := by
  intro h
  let q : Rational (JInt .i8) := ⟨JInt.lit .i8 (-128), JInt.lit .i8 1⟩
  have hq : Represents (.bits .i8) q (val (.bits .i16) (JInt.lit .i16 128))
      (val (.bits .i16) (JInt.lit .i16 (-1))) := by
    unfold Represents Canonical rn rd val IntegerParameters.ops q
    decide
  have bad := h (.bits .i8) (.bits .i16) (.bits .i16) (JInt.lit .i16 128) (JInt.lit .i16 (-1)) q hq
    (by decide)
  have actual : ctor (.bits .i8) (.bits .i16) (.bits .i16) (JInt.lit .i16 128)
      (JInt.lit .i16 (-1)) (inexactErrorCore "Rational") = .error (.inexactError "Int8") := by
    decide
  rw [actual] at bad
  cases bad

end JuliaLean.Proofs.base.rational.Round3

namespace JuliaLean.Proofs.base.rational.Round6
open JuliaLean JuliaLean.Promotion JuliaLean.base.rational
open JuliaLean.Proofs.base.int

set_option maxRecDepth 4096

private theorem rdEstateBindOk {ε σ α β : Type} {m : EStateM ε σ α} (f : α → EStateM ε σ β)
    {s s' : σ} {a : α} (h : m.run s = .ok a s') :
    (Bind.bind m f).run s = (f a).run s' := by
  simp only [EStateM.run, Bind.bind, EStateM.bind] at h ⊢
  rw [h]

private theorem rdPureBind {ε σ α β : Type} (a : α) (f : α → EStateM ε σ β) (s : σ) :
    (Bind.bind (Pure.pure a) f).run s = (f a).run s := rfl

private theorem rdLiftOkBind {α β : Type} (a : α) (f : α → JuliaLean.base.iobuffer.M β)
    (s : JuliaLean.base.iobuffer.BufferState) :
    (Bind.bind (JuliaLean.base.iobuffer.lift (.ok a)) f).run s = (f a).run s := rfl

private theorem rdLiftNativeOkBind {α β : Type} (a : α) (f : α → JuliaLean.base.iobuffer.M β)
    (s : JuliaLean.base.iobuffer.BufferState) :
    (Bind.bind (JuliaLean.base.iobuffer.liftNative (.ok a)) f).run s = (f a).run s := rfl

private theorem rdBindAssoc {ε σ α β γ : Type} (m : EStateM ε σ α)
    (f : α → EStateM ε σ β) (g : β → EStateM ε σ γ) (s : σ) :
    (Bind.bind (Bind.bind m f) g).run s = (Bind.bind m (fun a => Bind.bind (f a) g)).run s := by
  simp only [EStateM.run, Bind.bind, EStateM.bind]
  cases m s <;> rfl

private theorem rdBind2NotDone {ε σ α₁ α₂ β : Type}
    (m1 : EStateM ε σ α₁) (m2 : α₁ → EStateM ε σ α₂) (g : α₁ → α₂ → β)
    (st : σ) (w1 : β) (st1 : σ) :
    (Bind.bind m1 (fun a1 => Bind.bind (m2 a1) (fun a2 => Pure.pure (ForInStep.yield (g a1 a2))))).run st ≠
      .ok (ForInStep.done w1) st1 := by
  simp only [EStateM.run, Bind.bind, EStateM.bind, Pure.pure, EStateM.pure]
  cases m1 st with
  | error e s1 => intro h; cases h
  | ok a1 s1 =>
    dsimp only
    cases m2 a1 s1 with
    | error e s2 => intro h; cases h
    | ok a2 s2 => intro h; cases h

private theorem rdForInAppend {ε σ α β : Type}
    (xs ys : List α) (w : β) (f : α → β → EStateM ε σ (ForInStep β))
    (hyield : ∀ k w st w1 st1, (f k w).run st ≠ .ok (ForInStep.done w1) st1) :
    forIn (m := EStateM ε σ) (xs ++ ys) w f =
      Bind.bind (forIn (m := EStateM ε σ) xs w f)
        (fun w' => forIn (m := EStateM ε σ) ys w' f) := by
  induction xs generalizing w with
  | nil => rfl
  | cons k xs ih =>
    funext st
    simp only [List.cons_append, List.forIn_cons, Bind.bind, EStateM.bind]
    cases h : f k w st with
    | error e st1 => rfl
    | ok step st1 =>
      cases step with
      | done w1 => exact False.elim (hyield k w st w1 st1 h)
      | yield w1 => exact congrFun (ih w1) st1

private theorem rdGetRun (s : JuliaLean.base.iobuffer.BufferState) :
    (JuliaLean.base.iobuffer.bufferAccess.get ()).run s =
      .ok (JuliaLean.base.iobuffer.bufferFields s) s := rfl

private theorem rdSetRun (s : JuliaLean.base.iobuffer.BufferState)
    (f : JuliaLean.base.iobuffer.Fields (List UInt8)) :
    (JuliaLean.base.iobuffer.bufferAccess.set () f).run s =
      .ok () (JuliaLean.base.iobuffer.updateBufferFields s f) := rfl

private theorem rdLorDisjoint (x y k : Nat)
    (hx : x % 2 ^ k = 0) (hy : y < 2 ^ k) : Nat.lor x y = x + y := by
  have ex : x = 2 ^ k * (x / 2 ^ k) := by
    have h := Nat.div_add_mod x (2 ^ k)
    rw [hx, Nat.add_zero] at h
    exact h.symm
  apply Nat.eq_of_testBit_eq
  intro idx
  change (Nat.bitwise (· || ·) x y).testBit idx = (x + y).testBit idx
  rw [Nat.testBit_bitwise (by rfl)]
  have hb : 0 < 2 ^ k := Nat.two_pow_pos k
  have hxb := Nat.testBit_two_pow_mul_add (x / 2 ^ k) (b := 0) hb idx
  simp only [Nat.add_zero, Nat.zero_testBit] at hxb
  have hyb := Nat.testBit_two_pow_mul_add 0 hy idx
  simp only [Nat.mul_zero, Nat.zero_add, Nat.zero_testBit] at hyb
  have hsum := Nat.testBit_two_pow_mul_add (x / 2 ^ k) hy idx
  rw [← ex] at hsum hxb
  rw [hxb, hsum]
  by_cases hlt : idx < k
  · simp [hlt]
  · have hey : y.testBit idx = false := by simpa [hlt] using hyb
    simp [hlt, hey]

private theorem rdLorComm (a b : Nat) : Nat.lor a b = Nat.lor b a := by
  apply Nat.eq_of_testBit_eq
  intro idx
  change (Nat.bitwise (· || ·) a b).testBit idx = (Nat.bitwise (· || ·) b a).testBit idx
  rw [Nat.testBit_bitwise (by rfl), Nat.testBit_bitwise (by rfl)]
  cases a.testBit idx <;> cases b.testBit idx <;> rfl

private theorem rdAddVal {t : IntTy} (a b : JInt t) :
    (JuliaLean.base.int.add a b).val = wrapInt t (a.val + b.val) :=
  JuliaLean.Proofs.base.int.add_int_val a b
private theorem rdSubVal {t : IntTy} (a b : JInt t) :
    (JuliaLean.base.int.sub a b).val = wrapInt t (a.val - b.val) :=
  JuliaLean.Proofs.base.int.sub_int_val a b
private theorem rdMulVal {t : IntTy} (a b : JInt t) :
    (JuliaLean.base.int.mul a b).val = wrapInt t (a.val * b.val) :=
  JuliaLean.Proofs.base.int.mul_int_val a b

/-- Unsigned word facts, for `t` with `t.bits = 8 * c`. -/
private theorem rdWrapVal {t : IntTy} (hu : t.signed = false) {n : Nat} (hn : n < 2 ^ t.bits) :
    (JInt.wrap t (n : Int)).val = (n : Int) := by
  change wrapInt t (n : Int) = (n : Int)
  have h1 : ((2 ^ t.bits : Nat) : Int) = (2 : Int) ^ t.bits := by simp
  exact wrapInt_of_inRange t (n : Int)
    ⟨by simp [IntTy.min, hu], by simp only [IntTy.max, hu, Bool.false_eq_true, if_false]; omega⟩

private theorem rdLitI64 {k : Nat} (hk : k ≤ 256) :
    (JuliaLean.base.int.lit .i64 k).val = (k : Int) := by
  change wrapInt .i64 (k : Int) = (k : Int)
  exact wrapInt_of_inRange .i64 _ ⟨by simp [IntTy.min, IntTy.signed, IntTy.bits],
    by simp [IntTy.max, IntTy.signed, IntTy.bits]; omega⟩

private theorem rdLitU8 {b : Nat} (hb : b < 256) :
    (JuliaLean.base.int.lit .u8 b).val = (b : Int) := by
  change wrapInt .u8 (b : Int) = (b : Int)
  exact wrapInt_of_inRange .u8 _ ⟨by simp [IntTy.min, IntTy.signed],
    by simp [IntTy.max, IntTy.signed, IntTy.bits]; omega⟩

private theorem rdConvertByte {t : IntTy} (hu : t.signed = false) (h8 : 8 ≤ t.bits)
    {b : Nat} (hb : b < 256) :
    JuliaLean.base.int.convert t (JuliaLean.base.int.lit .u8 b) = .ok (JInt.wrap t (b : Int)) := by
  unfold JuliaLean.base.int.convert
  have h256 : 256 ≤ 2 ^ t.bits := by
    calc 256 = 2 ^ 8 := by decide
      _ ≤ 2 ^ t.bits := Nat.pow_le_pow_right (by decide) h8
  have hcast : ((2 ^ t.bits : Nat) : Int) = (2 : Int) ^ t.bits := by simp
  have hfit : t.min ≤ (b : Int) ∧ (b : Int) ≤ t.max :=
    ⟨by simp [IntTy.min, hu], by simp only [IntTy.max, hu, Bool.false_eq_true, if_false]; omega⟩
  rw [rdLitU8 hb, JuliaLean.Proofs.base.rational.CoreLemmas.convert_of_fits hfit]
  congr 1
  apply Subtype.ext
  exact (rdWrapVal hu (by omega)).symm

private theorem rdAddPtr (ptr : JuliaLean.base.iobuffer.I) {k : Nat}
    (hk : k < 16) (hwrap : ptr.val + k ≤ IntTy.i64.max) :
    (JuliaLean.base.int.add ptr (JuliaLean.base.int.lit .i64 k)).val = ptr.val + (k : Int) := by
  have hptr_prop := ptr.property
  have hk_val := rdLitI64 (by omega : k ≤ 256)
  rw [rdAddVal, hk_val]
  exact wrapInt_of_inRange .i64 _ ⟨by simp [IntTy.min, IntTy.signed, IntTy.bits] at hptr_prop ⊢; omega,
    by simp [IntTy.max, IntTy.signed, IntTy.bits] at hwrap ⊢; omega⟩

private theorem rdMul8 {k : Nat} (hk : k < 16) :
    (JuliaLean.base.int.mul (JuliaLean.base.int.lit .i64 8) (JuliaLean.base.int.lit .i64 k)).val =
      (8 * k : Nat) := by
  have hk_val := rdLitI64 (by omega : k ≤ 256)
  rw [rdMulVal, hk_val, show (JuliaLean.base.int.lit .i64 8).val = 8 from rfl]
  exact wrapInt_of_inRange .i64 _ ⟨by simp [IntTy.min, IntTy.signed, IntTy.bits]; omega,
    by simp [IntTy.max, IntTy.signed, IntTy.bits]; omega⟩

private theorem rdPatternBor {t : IntTy} (x y : JInt t) :
    pattern (JuliaLean.base.int.bor x y) = Nat.lor (pattern x) (pattern y) := by
  simp only [JuliaLean.base.int.bor, JuliaLean.base.int.or_int, JuliaLean.C.jlOrInt,
    pattern_toJInt, BitVec.toNat_or, ← pattern_fromJInt]
  rfl

private theorem rdBorEq {t : IntTy} (hu : t.signed = false) (x y : JInt t) :
    JuliaLean.base.int.bor x y = JInt.wrap t (Nat.lor (pattern x) (pattern y) : Int) := by
  apply Subtype.ext
  have hlt : Nat.lor (pattern x) (pattern y) < 2 ^ t.bits := by
    rw [← rdPatternBor]
    exact pattern_lt (JuliaLean.base.int.bor x y)
  rw [← val_of_unsigned_pattern hu (JuliaLean.base.int.bor x y), rdPatternBor, rdWrapVal hu hlt]

private abbrev loadBodyT (t : IntTy) (s : JuliaLean.base.iobuffer.BufferState)
    (k : Nat) (word : JInt t) :
    JuliaLean.base.iobuffer.M (ForInStep (JInt t)) := do
  let index := JuliaLean.base.int.lit .i64 k
  let b ← (do
    let b ← JuliaLean.base.iobuffer.lift
      (JuliaLean.base.iobuffer.getChecked s.data (JuliaLean.base.int.add s.ptr index))
    pure (JuliaLean.base.int.lit .u8 b.toNat))
  let converted ← JuliaLean.base.iobuffer.liftNative (JuliaLean.base.int.convert t b)
  pure (ForInStep.yield (JuliaLean.base.int.bor word
    (JuliaLean.base.int.shl_Int converted (JuliaLean.base.int.mul (JuliaLean.base.int.lit .i64 8) index))))

private theorem loadBodyT_ok (t : IntTy) (s : JuliaLean.base.iobuffer.BufferState)
    (k : Nat) (w : JInt t) (b8 : UInt8) (u_b : JInt t)
    (hget : JuliaLean.base.iobuffer.getChecked s.data
      (JuliaLean.base.int.add s.ptr (JuliaLean.base.int.lit .i64 k)) = .ok b8)
    (hconv : JuliaLean.base.int.convert t (JuliaLean.base.int.lit .u8 b8.toNat) = .ok u_b) :
    (loadBodyT t s k w).run s = EStateM.Result.ok
      (ForInStep.yield (JuliaLean.base.int.bor w
        (JuliaLean.base.int.shl_Int u_b
          (JuliaLean.base.int.mul (JuliaLean.base.int.lit .i64 8) (JuliaLean.base.int.lit .i64 k))))) s := by
  unfold loadBodyT
  simp only [hget, rdBindAssoc, rdLiftOkBind, rdPureBind, hconv, rdLiftNativeOkBind]
  rfl

private theorem loadT_forIn_eq (t : IntTy) (hu : t.signed = false) (c : Nat)
    (hc : t.bits = 8 * c) (hc16 : c ≤ 16) (h8 : 8 ≤ t.bits)
    (s : JuliaLean.base.iobuffer.BufferState)
    (hptr : 1 ≤ s.ptr.val) (hlen : s.ptr.val + c - 1 ≤ s.data.length)
    (hwrap : s.ptr.val + c ≤ IntTy.i64.max) :
    ∀ (k : Nat), k ≤ c →
      let sumNat := (List.range k).foldl
        (fun n j => n + (s.data.getD ((s.ptr.val - 1).toNat + j) 0).toNat * 256 ^ j) 0
      sumNat < 256 ^ k ∧
      (forIn (m := JuliaLean.base.iobuffer.M) (List.range k)
        (JInt.wrap t 0) (loadBodyT t s)).run s =
      EStateM.Result.ok (JInt.wrap t (sumNat : Int)) s := by
  intro k hk
  induction k with
  | zero => exact ⟨by dsimp; decide, rfl⟩
  | succ k ih =>
    have hptr_k_val := rdAddPtr s.ptr (k := k) (by omega) (by omega)
    have hidx : ((JuliaLean.base.int.add s.ptr (JuliaLean.base.int.lit .i64 k)).val - 1).toNat =
        (s.ptr.val - 1).toNat + k := by
      rw [hptr_k_val]; omega
    let b8 := s.data.getD ((s.ptr.val - 1).toNat + k) 0
    have hget : JuliaLean.base.iobuffer.getChecked s.data
        (JuliaLean.base.int.add s.ptr (JuliaLean.base.int.lit .i64 k)) = .ok b8 := by
      unfold JuliaLean.base.iobuffer.getChecked
      rw [if_pos ⟨by rw [hptr_k_val]; omega, by rw [hptr_k_val]; omega⟩, hidx]
    obtain ⟨ih_lt, ih_eq⟩ := ih (by omega)
    generalize hprev : (List.range k).foldl
      (fun n j => n + (s.data.getD ((s.ptr.val - 1).toNat + j) 0).toNat * 256 ^ j) 0 = prevNat at ih_lt ih_eq
    generalize hb : b8.toNat = bNat
    have hb_lt : bNat < 256 := by rw [← hb]; exact b8.toFin.isLt
    have hpow_eq : 2 ^ (8 * k) = 256 ^ k := by
      rw [Nat.pow_mul, show 2 ^ 8 = 256 by decide]
    have hpow_le : 256 ^ (k + 1) ≤ 2 ^ t.bits := by
      rw [hc, Nat.pow_mul, show 2 ^ 8 = 256 by decide]
      exact Nat.pow_le_pow_right (by decide) hk
    have hprev_lt : prevNat < 2 ^ t.bits := by
      have : 256 ^ k < 256 ^ (k + 1) := Nat.pow_lt_pow_right (by decide) (by omega)
      omega
    have hsum_lt : prevNat + bNat * 256 ^ k < 256 ^ (k + 1) := by
      rw [Nat.pow_succ]
      have hb_le : bNat ≤ 255 := by omega
      have : bNat * 256 ^ k ≤ 255 * 256 ^ k := Nat.mul_le_mul_right _ hb_le
      omega
    have hconv : JuliaLean.base.int.convert t (JuliaLean.base.int.lit .u8 b8.toNat) =
        .ok (JInt.wrap t (bNat : Int)) := by
      rw [hb]
      exact rdConvertByte hu h8 hb_lt
    let shiftCnt := JuliaLean.base.int.mul (JuliaLean.base.int.lit .i64 8) (JuliaLean.base.int.lit .i64 k)
    have hshift_cnt_val : shiftCnt.val = (8 * k : Nat) := rdMul8 (by omega)
    have hshift_cnt_nn : 0 ≤ shiftCnt.val := by rw [hshift_cnt_val]; exact Int.natCast_nonneg _
    have hpat_prev : pattern (JInt.wrap t (prevNat : Int)) = prevNat := by
      rw [pattern_of_nonneg _ (by rw [rdWrapVal hu hprev_lt]; exact Int.natCast_nonneg _),
        rdWrapVal hu hprev_lt, Int.toNat_natCast]
    have hb_lt2 : bNat < 2 ^ t.bits := by
      have : 256 ≤ 2 ^ t.bits := by
        calc 256 = 2 ^ 8 := by decide
          _ ≤ 2 ^ t.bits := Nat.pow_le_pow_right (by decide) h8
      omega
    have hpat_b : pattern (JInt.wrap t (bNat : Int)) = bNat := by
      rw [pattern_of_nonneg _ (by rw [rdWrapVal hu hb_lt2]; exact Int.natCast_nonneg _),
        rdWrapVal hu hb_lt2, Int.toNat_natCast]
    have hpat_shl : pattern (JuliaLean.base.int.shl_Int (JInt.wrap t (bNat : Int)) shiftCnt) =
        bNat * 2 ^ (8 * k) := by
      rw [pattern_shl_Int _ shiftCnt hshift_cnt_nn, hpat_b, hshift_cnt_val, Int.toNat_natCast]
      exact Nat.mod_eq_of_lt (by rw [hpow_eq]; omega)
    have hlor : Nat.lor prevNat (bNat * 2 ^ (8 * k)) = prevNat + bNat * 256 ^ k := by
      rw [rdLorComm, rdLorDisjoint (bNat * 2 ^ (8 * k)) prevNat (8 * k)
        (by simp) (by rw [hpow_eq]; exact ih_lt), hpow_eq, Nat.add_comm]
    have hbor_step : JuliaLean.base.int.bor (JInt.wrap t (prevNat : Int))
        (JuliaLean.base.int.shl_Int (JInt.wrap t (bNat : Int)) shiftCnt) =
        JInt.wrap t ((prevNat + bNat * 256 ^ k : Nat) : Int) := by
      rw [rdBorEq hu, hpat_prev, hpat_shl, hlor]
    rw [List.range_succ, List.foldl_append, List.foldl_cons, List.foldl_nil, hprev, hb]
    refine ⟨hsum_lt, ?_⟩
    rw [rdForInAppend _ _ _ _ (fun k w st w1 st1 => rdBind2NotDone _ _ _ st w1 st1)]
    rw [rdEstateBindOk _ ih_eq]
    rw [List.forIn_cons]
    rw [rdEstateBindOk _ (loadBodyT_ok t s k (JInt.wrap t (prevNat : Int)) b8
        (JInt.wrap t (bNat : Int)) hget hconv)]
    dsimp only [List.forIn_nil]
    rw [hbor_step]
    rfl

private theorem rdBitcastId {t : IntTy} (word : JInt t) (h : t.bits = t.bits) :
    JuliaLean.base.int.bitcast t word h = word := by
  apply Subtype.ext
  rw [JuliaLean.Proofs.base.int.bitcast_val, wrapInt_of_inRange _ word.val word.property]

private theorem readWord_u16_ok (ltoh : JInt .u16 → JInt .u16) (hlittle : ∀ x, ltoh x = x)
    (s : JuliaLean.base.iobuffer.BufferState)
    (hr : s.readable = true) (hp : 1 ≤ s.ptr.val)
    (hs : s.ptr.val + 2 ≤ s.size.val + 1)
    (hdata : s.size.val ≤ s.data.length)
    (hwrap : s.ptr.val + 2 ≤ IntTy.i64.max) :
    ∃ (w : JInt .u16) (s' : JuliaLean.base.iobuffer.BufferState),
      (readUnsignedWord .u16 ltoh).run s = .ok w s' ∧
      w.val = wordAt s.data (s.ptr.val - 1).toNat 2 ∧
      s'.ptr.val = s.ptr.val + 2 ∧ s'.readable = true ∧ s'.size = s.size ∧ s'.data = s.data := by
  have hsize_prop := s.size.property
  have hptr_prop := s.ptr.property
  have hi1_val : (JuliaLean.base.iobuffer.one).val = 1 := rfl
  have hsub_val : (JuliaLean.base.int.sub s.size s.ptr).val = s.size.val - s.ptr.val := by
    rw [rdSubVal]
    exact wrapInt_of_inRange .i64 _ ⟨by simp [IntTy.min, IntTy.max, IntTy.signed, IntTy.bits] at hsize_prop hptr_prop ⊢; omega,
      by simp [IntTy.min, IntTy.max, IntTy.signed, IntTy.bits] at hsize_prop hptr_prop ⊢; omega⟩
  have havail_val : (JuliaLean.base.iobuffer.fieldsBytesavailable (JuliaLean.base.iobuffer.bufferFields s)).val =
      s.size.val - s.ptr.val + 1 := by
    unfold JuliaLean.base.iobuffer.fieldsBytesavailable JuliaLean.base.iobuffer.bufferFields
    dsimp only
    rw [rdAddVal, hsub_val, hi1_val]
    exact wrapInt_of_inRange .i64 _ ⟨by simp [IntTy.min, IntTy.max, IntTy.signed, IntTy.bits] at hsize_prop hptr_prop ⊢; omega,
      by simp [IntTy.min, IntTy.max, IntTy.signed, IntTy.bits] at hsize_prop hptr_prop ⊢; omega⟩
  have hlt_eof : JuliaLean.base.int.lt
      (JuliaLean.base.iobuffer.fieldsBytesavailable (JuliaLean.base.iobuffer.bufferFields s))
      (JuliaLean.base.int.sizeof (JuliaLean.base.iobuffer.initialWord .u16)) = false := by
    have hsz : (JuliaLean.base.int.sizeof (JuliaLean.base.iobuffer.initialWord .u16)).val = 2 := rfl
    simp only [JuliaLean.base.int.lt, if_pos (rfl : IntTy.i64.signed = IntTy.i64.signed),
      JuliaLean.Proofs.base.int.ltPromote_eq rfl, havail_val, hsz]
    exact decide_eq_false (by omega)
  obtain ⟨hw_lt, hfor⟩ := loadT_forIn_eq .u16 rfl 2 rfl (by decide) (by decide) s hp (by omega) hwrap 2
    (Nat.le_refl _)
  generalize hwNat : (List.range 2).foldl
    (fun n j => n + (s.data.getD ((s.ptr.val - 1).toNat + j) 0).toNat * 256 ^ j) 0 = wNat at hw_lt hfor
  let w : JInt .u16 := JInt.wrap .u16 (wNat : Int)
  let s' : JuliaLean.base.iobuffer.BufferState := { s with ptr := s.ptr + JuliaLean.base.iobuffer.i 2 }
  have hptr_next : s'.ptr.val = s.ptr.val + 2 := by
    change wrapInt .i64 (s.ptr.val + (JuliaLean.base.iobuffer.i 2).val) = _
    rw [show (JuliaLean.base.iobuffer.i 2).val = 2 from rfl]
    exact wrapInt_of_inRange .i64 _ ⟨by simp [IntTy.min, IntTy.max, IntTy.signed, IntTy.bits] at hptr_prop ⊢; omega,
      by simp [IntTy.max, IntTy.signed, IntTy.bits] at hwrap ⊢; omega⟩
  have hptr_add_eq : JuliaLean.base.int.add s.ptr
      (JuliaLean.base.int.sizeof (JuliaLean.base.iobuffer.initialWord .u16)) =
      s.ptr + JuliaLean.base.iobuffer.i 2 := by
    apply Subtype.ext
    rw [rdAddVal]
    rfl
  have hw_val : w.val = wordAt s.data (s.ptr.val - 1).toNat 2 := by
    unfold wordAt
    rw [hwNat]
    exact rdWrapVal rfl (by
      have h : (256 : Nat) ^ 2 = 2 ^ IntTy.u16.bits := by decide
      omega)
  have hread_field : (JuliaLean.base.iobuffer.bufferFields s).readable = true := hr
  have hdata_field : (JuliaLean.base.iobuffer.bufferFields s).data = s.data := rfl
  have hptr_field : (JuliaLean.base.iobuffer.bufferFields s).ptr = s.ptr := rfl
  have hload : (JuliaLean.base.iobuffer.source_load_from_array rationalGetByte
      (fun | .u16, w => pure (ltoh w) | _, w => pure w)
      (fun k w => pure (JuliaLean.base.iobuffer.bitcastWord k w))
      .u16 s.data s.ptr).run s = .ok w s := by
    change (do
      let __s ← forIn (m := JuliaLean.base.iobuffer.M) (List.range 2)
        (JInt.wrap .u16 0) (loadBodyT .u16 s)
      let __do_lift ← (pure (ltoh __s) : JuliaLean.base.iobuffer.M (JInt .u16))
      JuliaLean.base.iobuffer.reinterpretWord
        (fun k w => pure (JuliaLean.base.iobuffer.bitcastWord k w)) .u16 __do_lift).run s = .ok w s
    rw [rdEstateBindOk _ hfor, rdPureBind, hlittle]
    change (if (true && true) = true then
        (Pure.pure (JuliaLean.base.int.bitcast .u16 w rfl) : JuliaLean.base.iobuffer.M (JInt .u16))
      else (Pure.pure (JuliaLean.base.int.bitcast .u16 w rfl) : JuliaLean.base.iobuffer.M (JInt .u16))).run s = .ok w s
    simp only [Bool.and_self, ↓reduceIte, rdBitcastId]
    rfl
  have hpeek : (JuliaLean.base.iobuffer.source_peek_multibyte
      JuliaLean.base.iobuffer.bufferAccess rationalGetByte
      (fun | .u16, w => pure (ltoh w) | _, w => pure w)
      (fun k w => pure (JuliaLean.base.iobuffer.bitcastWord k w)) () .u16).run s = .ok w s := by
    unfold JuliaLean.base.iobuffer.source_peek_multibyte
    rw [rdEstateBindOk _ (rdGetRun s)]
    simp only [hread_field, hdata_field, hptr_field, hlt_eof,
      Bool.not_true, Bool.false_eq_true, ↓reduceIte]
    exact hload
  have hrun : (readUnsignedWord .u16 ltoh).run s = .ok w s' := by
    change (JuliaLean.base.iobuffer.source_read_multibyte
      JuliaLean.base.iobuffer.bufferAccess rationalGetByte
      (fun | .u16, w => pure (ltoh w) | _, w => pure w)
      (fun k w => pure (JuliaLean.base.iobuffer.bitcastWord k w)) () .u16).run s = .ok w s'
    unfold JuliaLean.base.iobuffer.source_read_multibyte
    rw [rdEstateBindOk _ hpeek]
    rw [rdEstateBindOk _ (rdGetRun s)]
    rw [rdEstateBindOk _ (rdSetRun s _)]
    simp only [EStateM.run, Pure.pure, EStateM.pure,
      JuliaLean.base.iobuffer.bufferFields, JuliaLean.base.iobuffer.updateBufferFields, hptr_add_eq]
    rfl
  exact ⟨w, s', hrun, hw_val, hptr_next, hr, rfl, rfl⟩

