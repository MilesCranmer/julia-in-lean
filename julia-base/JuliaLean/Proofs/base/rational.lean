private theorem ldexpZeroSubnormal {T : FTy} (o : IEEEOps T) (x : FV T)
    (hx : x.isfinite = true) (hz : x.magnitude ≠ 0) (hB : x.expField = 0) :
    ldexp o x 0 = x := by
  have hfb := mfFmtBounds T
  have hemax := (good_fty T).emax_eq
  obtain ⟨hc1,hc2,_,_,hsub⟩ := mfNormSigFacts x hx hz
  obtain ⟨hlog,_,hloglt⟩ := hsub hB
  obtain ⟨hm,hclear⟩ := mfSubnormalShift x hx hz hB
  let m := T.fmt.sb-x.frac.log2
  change leadingZeros T.fmt.width x.magnitude-T.fmt.eb = m at hm
  rw [hm] at hclear
  have hmpos : 0 < m := by dsimp [m]; omega
  have hmle : m ≤ T.fmt.sb := Nat.sub_le _ _
  have hr : mfNormSig x-2^T.fmt.sb < 2^T.fmt.sb := by
    have hp : 2^(T.fmt.sb+1) = 2*2^T.fmt.sb := by rw [Nat.pow_succ,Nat.mul_comm]
    omega
  let y := NextProofs.encode T x.signbit (1*2^T.fmt.sb+(mfNormSig x-2^T.fmt.sb))
  obtain ⟨hys,hyE,hyF,_,hyfin,_⟩ := mfEncodeParts T x.signbit 1 _ (by omega) hr
  have he : (1 : Int)+(-(m : Int)) = ((magKey T.fmt x.magnitude).log2 : Int)-T.fmt.sb+1 := by
    rw [hlog]; dsimp [m]; omega
  have hround := mfLdexpRoundTrip o x hx hz 1 (by decide) (by omega) (-(m : Int)) he
  change ldexp o y (-(m : Int)) = x at hround
  have hynormal : y.expField ≠ 0 := by change (NextProofs.encode _ _ _).expField ≠ 0; rw [hyE]; decide
  have hnormal := mfLdexpNormal o y (-(m : Int)) hyfin hynormal (by omega) (by omega)
  change y.signbit = x.signbit at hys
  change y.expField = 1 at hyE
  change y.frac = mfNormSig x-2^T.fmt.sb at hyF
  rw [hyE,hyF,hys] at hnormal
  have hn1 : ¬ ((1 : Int)+(-(m : Int)) ≥ T.fmt.emax) := by omega
  have hn2 : ¬ ((1 : Int)+(-(m : Int)) > 0) := by omega
  have hn3 : ¬ ((1 : Int)+(-(m : Int)) ≤ -(T.fmt.sb : Int)-1) := by omega
  simp only [Int.natCast_one,hn1,hn2,hn3,↓reduceIte] at hnormal
  rw [hnormal] at hround
  rw [mfLdexpUnfold]
  have hxs : withoutBits x.toBits (signMask T) T.fmt.width = x.magnitude := withoutSignBitMagnitude x
  have hmag := (TruncProofs.isfinite_iff_mag x).1 hx
  have hnm : ¬ (x.magnitude ≥ exponentMask T) := by unfold exponentMask; omega
  have hdiv : x.magnitude / 2^T.fmt.sb = x.expField := (Fl.expField_eq x).symm
  have hwrap : wrapInt .i64 (1-(m : Int)) = 1-(m : Int) := mfWrap64 _ (by omega) (by omega)
  have hk1 : ¬ ((1 : Int)-(m : Int) ≥ T.fmt.emax) := by omega
  have hk2 : ¬ ((1 : Int)-(m : Int) > 0) := by omega
  have hk3 : ¬ ((1 : Int)-(m : Int) ≤ -(T.fmt.sb : Int)-1) := by omega
  simp only [Id.run,hxs,hnm,hdiv,hB,Int.natCast_zero,beq_self_eq_true,↓reduceIte,
    show (x.magnitude == 0) = false from by simp [hz],hm,
    show ¬ (0 : Int) < -50000 by decide,show ¬ (0 : Int) > IntTy.max .i64 by decide,
    show ¬ (0 : Int) < IntTy.min .i64 by decide,
    show wrapInt .i64 0 = 0 by decide,Int.add_zero,hwrap,hk1,hk2,hk3]
  rw [hclear, if_neg (by decide)]
  have hbits : (if x.signbit = true then 2 ^ (T.fmt.eb + T.fmt.sb) else 0) + (mfNormSig x - 2 ^ T.fmt.sb) +
      (1 - (m : Int) + T.fmt.sb + 1).toNat * 2 ^ T.fmt.sb =
      (if x.signbit = true then signMask T else 0) +
        ((1 + -(m : Int) + T.fmt.sb + 1).toNat * 2 ^ T.fmt.sb + (mfNormSig x - 2 ^ T.fmt.sb)) := by
    rw [show signMask T = 2 ^ (T.fmt.eb + T.fmt.sb) from rfl,
      show (1 - (m : Int) + T.fmt.sb + 1) = (1 + -(m : Int) + T.fmt.sb + 1) by omega]
    split <;> omega
  show mul _ (Fl.ofBits _) = x
  rw [hbits]
  exact hround

private theorem ldexpZeroFinite {T : FTy} (o : IEEEOps T) (x : FV T) (hx : x.isfinite = true) :
    ldexp o x 0 = x := by
  by_cases hz : x.magnitude = 0
  · exact mfLdexpZero o x 0 hz
  · by_cases hB : x.expField = 0
    · exact ldexpZeroSubnormal o x hx hz hB
    · exact ldexpZeroFiniteNormal o x hx hz hB

private def faithfulOps32 (o : IEEEOps .f32) : IEEEOps .f32 :=
  { o with
    eps := eps_float .f32
    floatmin := floatmin_float .f32
    floatmax := floatmax_float .f32
    invFloatmin := div_float (fone .f32) (floatmin_float .f32)
    pi := fone .f32
    sqrtLlvm := JuliaLean.C.jlSqrtLlvm
    trunc := JuliaLean.C.jlTruncLlvm
    oneunit := fun _ => fone .f32
    inverse := fun x => div_float (fone .f32) x
    abs2 := fun x => mul_float x x
    greater := fun x y => flt y x
    addFast := add_float
    fma := JuliaLean.C.jlFmaFloat
    muladd := JuliaLean.C.jlMuladdFloat
    rem := rem_IEEEFloat
    flipsign := fun x y => if y.signbit then Fl.neg x else x
    minFloat := JuliaLean.C.jlMinFloat
    maxFloat := JuliaLean.C.jlMaxFloat }

private theorem faithfulOps32_spec (o : IEEEOps .f32) : IEEEFloatOpsFaithful (faithfulOps32 o) := by
  exact ⟨rfl,rfl,rfl,rfl,by change fisfinite (fone .f32) = true; decide,
    by change flt (fzero .f32) (fone .f32) = true; decide,
    fun _ => rfl,fun _ => rfl,fun _ => rfl,fun _ => rfl,fun _ => rfl,
    fun _ _ => rfl,fun _ _ => rfl,fun _ _ _ => rfl,fun _ _ _ => rfl,
    fun _ _ => rfl,fun _ _ => rfl,fun _ _ => rfl,fun _ _ => rfl⟩

private theorem ldexp16ZeroFinite (o : IEEEOps .f32) (x : FV .f16) (hx : x.isfinite = true) :
    ldexp16 o x 0 = x := by
  have hxapi : fisfinite x = true := (show fisfinite x = x.isfinite from isfinite_IEEEFloat_eq x).trans hx
  have hbits := ldexp16ExactScaling_proven (faithfulOps32 o) x 0 x
    (faithfulOps32_spec o) hxapi hxapi (by simp [QEQ,QMul,QPowTwo]) rfl
  have hexact : ldexp16 (faithfulOps32 o) x 0 = x :=
    Fl.ext_toBits (congrArg Fin.val hbits)
  obtain ⟨_,_,hfin,_,_⟩ := Fl.convert_widen_key (good_fty .f16) (good_fty .f32)
    (by decide) (by decide) (by decide) x
  have hyfin : (Fl.convert x : FV .f32).isfinite = true := hfin.trans hx
  unfold ldexp16 ldexp16Source at hexact ⊢
  dsimp only [pure, bind, Id.instMonad] at hexact ⊢
  rw [ldexpZeroFinite (faithfulOps32 o) _ hyfin] at hexact
  rw [ldexpZeroFinite o _ hyfin]
  exact hexact

private theorem floatParameter_ldexp_zero (f : FTy)
    (o : IEEEOps .f32 × IEEEOps .f64) (x : FV f)
    (hx : isfinite_IEEEFloat x = true) :
    (Round5.FloatParameters.ieee f o).ldexp x 0 = x := by
  have hxf : x.isfinite = true := by rw [← isfinite_IEEEFloat_eq]; exact hx
  cases f
  · show ldexp16 {o.1 with flipsign := JuliaLean.base.floatfuncs.flipsign_Float32} x 0 = x
    exact ldexp16ZeroFinite _ x hxf
  · show ldexp {o.1 with flipsign := JuliaLean.base.floatfuncs.flipsign_Float32} x 0 = x
    exact ldexpZeroFinite _ x hxf
  · show ldexp {o.2 with flipsign := JuliaLean.base.floatfuncs.flipsign_Float64} x 0 = x
    exact ldexpZeroFinite _ x hxf

theorem float_equality_proven : JuliaLean.Statements.rational.Round11.float_equality := by
  intro t f o q x hq hx fp subOne div eqFF left right
  refine ⟨floatEquality_nonDyadic t f o q x hx,?_⟩
  intro hd1
  have hlit : (JInt.lit t 1).val = 1 := by cases t <;> decide
  have hd : q.den = JInt.lit t 1 := Subtype.ext (hd1.trans hlit.symm)
  have hcount : JuliaLean.base.int.eq (JuliaLean.base.int.count_ones q.den) (JInt.lit .i64 1) = true := by
    rw [hd]; cases t <;> decide
  have htop : (JuliaLean.base.int.top_set_bit
      (JuliaLean.base.int.binop JuliaLean.base.int.sub q.den (JInt.lit .i64 1))).val = 0 := by
    rw [hd]; cases t <;> decide
  have hld := floatParameter_ldexp_zero f o x hx
  simp [left,right,eqFloatRatSource,eqRatFloatSource,hx,hcount,subOne,htop,fp,hld, eqRatFloatMethod, Bind.bind, Pure.pure, Id.instMonad]

end JuliaLean.Proofs.base.rational.FloatEqualityProof

