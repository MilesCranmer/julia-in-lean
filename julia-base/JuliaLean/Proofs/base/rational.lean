theorem g2TmodBoundsStrict (a b : Int) (hb : b ≠ 0) :
    a.tdiv b * b + a.tmod b = a ∧
    (0 ≤ a → 0 ≤ a.tmod b ∧ a.tmod b < b.natAbs) ∧
    (a < 0 → -(b.natAbs : Int) < a.tmod b ∧ a.tmod b ≤ 0) := by
  have hqr := Int.tdiv_mul_add_tmod a b
  have hlt : (a.tmod b).natAbs < b.natAbs := by
    rw [Int.natAbs_tmod]
    exact Nat.mod_lt _ (Int.natAbs_pos.mpr hb)
  have htb := tmod_between a b
  refine ⟨hqr, fun ha => ⟨(htb.1 ha).1, by omega⟩,
    fun ha => ⟨by omega, (htb.2 ha).2⟩⟩

theorem g2NearestQuadrantRaw (a b q r : Int)
    (hy0 : b ≠ 0) (hr_val : r = a.tmod b)
    (fPP fPN fNP fNN : Bool) (tieChoice : Int)
    (hodd_f : b.tmod 2 ≠ 0 → fPP = true ∧ fPN = true ∧ fNP = true ∧ fNN = true)
    (heven_f : b.tmod 2 = 0 →
      (a ≥ 0 → b ≥ 0 → (if fPP then q else q + 1) = tieChoice) ∧
      (a ≥ 0 → b < 0 → (if fPN then q else q - 1) = tieChoice) ∧
      (a < 0 → b ≥ 0 → (if fNP then q else q - 1) = tieChoice) ∧
      (a < 0 → b < 0 → (if fNN then q else q + 1) = tieChoice)) :
    (if a ≥ 0 then
      if b ≥ 0 then
        if r ≥ b.tdiv 2 + JuliaLean.base.div.boolInt fPP then q + 1 else q
      else
        if r ≥ -(b.tdiv 2) + JuliaLean.base.div.boolInt fPN then q - 1 else q
    else if b ≥ 0 then
      if r ≤ -(b.tdiv 2) - JuliaLean.base.div.boolInt fNP then q - 1 else q
    else if r ≤ b.tdiv 2 - JuliaLean.base.div.boolInt fNN then q + 1 else q) =
      (if 2 * (a.tmod b).natAbs < b.natAbs then q
       else if 2 * (a.tmod b).natAbs > b.natAbs then
         q + (if (a < 0) ≠ (b < 0) then -1 else 1)
       else tieChoice) := by
  have hy2 := Int.tdiv_mul_add_tmod b 2
  have hy2_b := g2TmodBoundsStrict b 2 (by decide)
  obtain ⟨_, hr_pos, hr_neg⟩ := g2TmodBoundsStrict a b hy0
  rw [hr_val]
  by_cases hx_nn : a ≥ 0 <;> by_cases hy_nn : b ≥ 0
  · have hy_pos : 0 < b := by omega
    have hr_b := hr_pos hx_nn
    have hy2_pos := hy2_b.2.1 hy_nn
    clear hy2_b hr_pos hr_neg
    have hsame : ¬ ((a < 0) ≠ (b < 0)) := by
      simp [show ¬ a < 0 by omega, show ¬ b < 0 by omega]
    simp only [hx_nn, hy_nn, hsame, ↓reduceIte]
    by_cases hcond : a.tmod b ≥ b.tdiv 2 + JuliaLean.base.div.boolInt fPP
    · simp only [ite_eq_left hcond]
      by_cases hm2 : b.tmod 2 = 0
      · have hev := (heven_f hm2).1 hx_nn hy_nn
        clear hodd_f heven_f
        cases fPP <;> simp [JuliaLean.base.div.boolInt] at hcond hev <;>
          split <;> (try split) <;> omega
      · have hf := (hodd_f hm2).1
        clear hodd_f heven_f
        simp [hf, JuliaLean.base.div.boolInt] at hcond
        split <;> (try split) <;> omega
    · simp only [ite_eq_right hcond]
      by_cases hm2 : b.tmod 2 = 0
      · have hev := (heven_f hm2).1 hx_nn hy_nn
        clear hodd_f heven_f
        cases fPP <;> simp [JuliaLean.base.div.boolInt] at hcond hev <;>
