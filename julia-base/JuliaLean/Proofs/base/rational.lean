  let numeratorConverts := RoundedFits p xn ∧ RoundedFits p yd
  let denominatorConverts := RoundedFits p xd ∧ RoundedFits p yn
  let numeratorFits := RoundedFits p (xn * yd)
  let denominatorFits := RoundedFits p (xd * yn)
