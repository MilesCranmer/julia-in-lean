def compareExtended (n d m e : Int) : Int :=
  if d = 0 then
    if e = 0 then intCmp (intSign n) (intSign m) else intSign n
  else if e = 0 then -intSign m
  else intCmp (n*e) (m*d)
def conversion_and_unary : Prop :=
  ∀ {T U : Type} (i : IntegerParameters T) (j : IntegerParameters U)
    (x : Rational U),
    let run := convertRat i j x
    (FitsPair i (rn j x) (rd j x) → ∃ y, run = .ok y ∧ Components i j y x) ∧
    (¬ FitsPair i (rn j x) (rd j x) → IsInexact run) ∧
    (FitsPair i (rn j x) (rd j x) → i.fits (-rn j x) →
      ∃ y z, run = .ok y ∧ neg i y = .ok z ∧ rn i z = -rn j x ∧ rd i z = rd j x) ∧
    (FitsPair i (rn j x) (rd j x) → ¬ i.fits (-rn j x) →
      ∃ y, run = .ok y ∧ IsOverflow (neg i y)) ∧
    (FitsPair i (rn j x) (rd j x) → ∃ y,
      unsafeRationalTypeSource T (fun n => i.ops.fromInt (val j n))
        (fun n => i.ops.fromInt (val j n)) x.num x.den = .ok y ∧ Components i j y x)
abbrev wrapAdd {T U P : Type} {i : IntegerParameters T} {j : IntegerParameters U}
    {p : IntegerParameters P} (m : PromotionParameters i j p) :=
  addWrapRatSource m.prom (promoteR m) (fun q => i.ops.iszero q.den)
    (eqR i j) (dg p p) (rational p)
abbrev wrapSub {T U P : Type} {i : IntegerParameters T} {j : IntegerParameters U}
    {p : IntegerParameters P} (m : PromotionParameters i j p) :=
  subWrapRatSource m.prom (promoteR m) (fun q => i.ops.iszero q.den)
    (neg j) (eqR i j) (dg p p) (rational p)
def wrapping : Prop :=
  ∀ {T U P : Type} (i : IntegerParameters T) (j : IntegerParameters U)
    (p : IntegerParameters P) (m : PromotionParameters i j p) (x : Rational T) (y : Rational U)
    (hx : Canonical i x) (hy : Canonical j y),
    let cv := Converts i j p x y
    let g : Int := Nat.gcd (rd i x).natAbs (rd j y).natAbs
    let a := p.wrap (rn i x * (rd j y).tdiv g)
    let b := p.wrap (rn j y * (rd i x).tdiv g)
    let d := p.wrap (rd i x * (rd j y).tdiv g)
    (¬ cv → IsInexact (wrapAdd m x y) ∧ IsInexact (wrapSub m x y)) ∧
    (cv → g ≠ 0 → ConstructorContract p (wrapAdd m x y) (p.wrap (a+b)) d) ∧
    (cv → g ≠ 0 → (rd i x = 0 → j.fits (-rn j y)) →
      ConstructorContract p (wrapSub m x y) (p.wrap (a-b)) d) ∧
    (cv → g = 0 →
      (rn i x = rn j y → ExactResult p (wrapAdd m x y) (rn i x) 0) ∧
      (rn i x ≠ rn j y → wrapAdd m x y = .error .divideError)) ∧
    (cv → rd i x = 0 → ¬ j.fits (-rn j y) → IsOverflow (wrapSub m x y)) ∧
    (cv → g = 0 → j.fits (-rn j y) →
      (rn i x = -rn j y → ExactResult p (wrapSub m x y) (rn i x) 0) ∧
      (rn i x ≠ -rn j y → wrapSub m x y = .error .divideError)) ∧
    rn i (negWrapRatSource i.ops.negWrap x) = i.wrap (-rn i x) ∧
    rd i (negWrapRatSource i.ops.negWrap x) = rd i x ∧
    (i.fits (-rn i x) → Represents i (negWrapRatSource i.ops.negWrap x) (-rn i x) (rd i x))
def AddOutcome {T U P : Type} (i : IntegerParameters T) (j : IntegerParameters U)
    (p : IntegerParameters P) (x : Rational T) (y : Rational U) (run : Jl (Rational P)) : Prop :=
  let g : Int := Nat.gcd (rd i x).natAbs (rd j y).natAbs
  let a := rn i x * (rd j y).tdiv g
  let b := rn j y * (rd i x).tdiv g
  let d := rd i x * (rd j y).tdiv g
  (¬ Converts i j p x y → IsInexact run) ∧
  (Converts i j p x y → g = 0 →
    (rn i x = rn j y → ExactResult p run (rn i x) 0) ∧
    (rn i x ≠ rn j y → run = .error .divideError)) ∧
  (Converts i j p x y → g ≠ 0 →
    ((p.fits a ∧ p.fits b ∧ p.fits (a+b) ∧ p.fits d) → ConstructorContract p run (a+b) d) ∧
    (¬ (p.fits a ∧ p.fits b ∧ p.fits (a+b) ∧ p.fits d) → IsOverflow run))
def fma_exact : Prop :=
  ∀ {T U P V W : Type} (i : IntegerParameters T) (j : IntegerParameters U)
    (p : IntegerParameters P) (v : IntegerParameters V) (w : IntegerParameters W)
    (mp : PromotionParameters i j p) (ma : PromotionParameters p v w)
    (x : Rational T) (y : Rational U) (z : Rational V)
    (hx : Canonical i x) (hy : Canonical j y) (hz : Canonical v z),
    let g1 : Int := Nat.gcd (rn i x).natAbs (rd j y).natAbs
    let g2 : Int := Nat.gcd (rd i x).natAbs (rn j y).natAbs
    let n := (rn i x).tdiv g1 * (rn j y).tdiv g2
    let d := (rd i x).tdiv g2 * (rd j y).tdiv g1
    let run := fmaRatSource (mulRatRatSource mp.prom (dg p p)) (add ma) x y z
    (¬ Converts i j p x y → IsInexact run) ∧
    (Converts i j p x y → (g1 = 0 ∨ g2 = 0) → run = .error .divideError) ∧
    (Converts i j p x y → g1 ≠ 0 → g2 ≠ 0 → ¬ FitsPair p n d → IsOverflow run) ∧
    (Converts i j p x y → g1 ≠ 0 → g2 ≠ 0 → FitsPair p n d →
      ∃ product, Represents p product (rn i x*rn j y) (rd i x*rd j y) ∧
        AddOutcome p v w product z run)
def QuotientOutcome {Q : Type} (q : IntegerParameters Q) (run : Jl Q)
    (n d : Int) (mode : Rounding) : Prop :=
  (d = 0 → run = .error .divideError) ∧
  (d ≠ 0 → q.fits (rounded n d mode) → ∃ out, run = .ok out ∧ val q out = rounded n d mode) ∧
  (d ≠ 0 → ¬ q.fits (rounded n d mode) → run = .error .divideError)
def rounded_quotients : Prop :=
  ∀ {T : Type} (i : IntegerParameters T)
    (x y : Rational T) (k : T) (mode : Rounding)
    (hx : Canonical i x) (hy : Canonical i y),
    let gn : Int := Nat.gcd (rn i x).natAbs (rn i y).natAbs
    let gd : Int := Nat.gcd (rd i x).natAbs (rd i y).natAbs
    let n := (rn i x).tdiv gn * (rd i y).tdiv gd
    let d := (rd i x).tdiv gd * (rn i y).tdiv gn
    let gk : Int := Nat.gcd (rn i x).natAbs (val i k).natAbs
    let nk := (rn i x).tdiv gk
    let dk := rd i x*(val i k).tdiv gk
    let gr : Int := Nat.gcd (val i k).natAbs (rn i x).natAbs
    let nr := (val i k).tdiv gr*rd i x
    let dr := (rn i x).tdiv gr
    let rr := divRationalRationalRoundedSource (dg i i) (dg i i)
      i.ops.checkedMul i.ops.checkedMul i.ops.divRound x y mode
    let ri := divRationalIntegerRoundedSource (dg i i) i.ops.checkedMul i.ops.divRound x k mode
    let ir := divIntegerRationalRoundedSource (dg i i) i.ops.checkedMul i.ops.divRound k x mode
    ((gn = 0 ∨ gd = 0) → rr = .error .divideError) ∧
    (gn ≠ 0 → gd ≠ 0 → ¬ FitsPair i n d → IsOverflow rr) ∧
    (gn ≠ 0 → gd ≠ 0 → FitsPair i n d → QuotientOutcome i rr n d mode) ∧
    (gk = 0 → ri = .error .divideError) ∧
    (gk ≠ 0 → ¬ i.fits dk → IsOverflow ri) ∧
    (gk ≠ 0 → i.fits dk → QuotientOutcome i ri nk dk mode) ∧
    (gr = 0 → ir = .error .divideError) ∧
    (gr ≠ 0 → ¬ i.fits nr → IsOverflow ir) ∧
    (gr ≠ 0 → i.fits nr → QuotientOutcome i ir nr dr mode)
def mixed_rounded_rationals : Prop :=
  ∀ (t s : IntTy) (x : Rat t) (y : Rat s) (mode : Rounding)
    (hx : Normalized x) (hy : Normalized y),
    let p := IntegerParameters.bits (t.promote s)
    let gn : Int := Nat.gcd x.num.val.natAbs y.num.val.natAbs
    let gd : Int := Nat.gcd x.den.val.natAbs y.den.val.natAbs
    let xn := x.num.val.tdiv gn
    let yn := y.num.val.tdiv gn
    let xd := x.den.val.tdiv gd
    let yd := y.den.val.tdiv gd
    let n := xn*yd
    let d := xd*yn
    let cn := p.fits xn ∧ p.fits yd
    let cd := p.fits xd ∧ p.fits yn
    let run := divRationalRationalRoundedSource (dg (.bits t) (.bits s)) (dg (.bits t) (.bits s))
      (JuliaLean.base.checked.checkedMulMixedBits) (JuliaLean.base.checked.checkedMulMixedBits)
      (fun a b r => JuliaLean.base.div.divBitIntegerMode a b (sourceMode r)) x y mode
    ((gn = 0 ∨ gd = 0) → run = .error .divideError) ∧
    (gn ≠ 0 → gd ≠ 0 → ¬ cn → IsInexact run) ∧
    (gn ≠ 0 → gd ≠ 0 → cn → ¬ p.fits n → IsOverflow run) ∧
    (gn ≠ 0 → gd ≠ 0 → cn → p.fits n → ¬ cd → IsInexact run) ∧
    (gn ≠ 0 → gd ≠ 0 → cn → p.fits n → cd → ¬ p.fits d → IsOverflow run) ∧
    (gn ≠ 0 → gd ≠ 0 → cn → cd → FitsPair p n d → QuotientOutcome p run n d mode)
def integerRound (t s : IntTy) (copySign : Rat s → JInt s → Rat s)
    (convertInf : Rat s → Jl (JInt t)) (x : Rat s) (mode : Rounding) : Jl (JInt t) :=
  roundRatTypedSource (JInt t) (jintOps s).iszero true (JInt.lit s 1) (JInt.lit s 0)
    (fun q y => .ok (copySign q y)) convertInf
    (fun a b r => JuliaLean.base.div.divBitIntegerMode a b (sourceMode r))
    (JuliaLean.base.int.convert t) x mode
def typed_integer_rounding : Prop :=
  ∀ (t s : IntTy) (x : Rat s) (hx : Normalized x) (mode : Rounding),
    ∀ copySign convertInf,
    let run := integerRound t s copySign convertInf x mode
    let answer := rounded x.num.val x.den.val mode
    (x.den.val = 0 → run = .error .divideError) ∧
    (x.den.val > 0 → (s.min ≤ answer ∧ answer ≤ s.max) →
      ((t.min ≤ answer ∧ answer ≤ t.max) → ∃ out, run = .ok out ∧ out.val = answer) ∧
      (¬ (t.min ≤ answer ∧ answer ≤ t.max) → IsInexact run)) ∧
    (x.den.val > 0 → ¬ (s.min ≤ answer ∧ answer ≤ s.max) → run = .error .divideError)
def documented_infinite_truncation : Prop :=
  ∀ (t s : IntTy) (x : Rat s)
