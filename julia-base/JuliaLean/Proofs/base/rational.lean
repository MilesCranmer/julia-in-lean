def ConstructorOutcomeAny {T : Type} (i : IntegerParameters T)
    (run : Jl (Rational T)) (n d : Int) : Prop :=
  let g := Nat.gcd n.natAbs d.natAbs
  let a := if i.ops.isUnsignedOrBool then ((reduced n d).1.natAbs : Int) else (reduced n d).1
  let b := if i.ops.isUnsignedOrBool then ((reduced n d).2.natAbs : Int) else (reduced n d).2
  let negativeUnsigned := i.ops.isUnsignedOrBool = true ∧ n ≠ 0 ∧ ((n < 0) ≠ (d < 0))
  let converted := FitsPair i a b
  let normalized := b < 0 → FitsPair i (-a) (-b)
  (g = 0 → JuliaLean.Statements.rational.Round12.HasError run) ∧
  (g ≠ 0 → negativeUnsigned → JuliaLean.Statements.rational.Round12.HasError run) ∧
  (g ≠ 0 → ¬ negativeUnsigned → ¬ converted →
    JuliaLean.Statements.rational.Round12.HasError run) ∧
  (g ≠ 0 → ¬ negativeUnsigned → converted →
    (normalized → ExactResult i run n d) ∧
    (¬ normalized → JuliaLean.Statements.rational.Round12.HasError run))

def AddOutcomeAny {T U P : Type} (i : IntegerParameters T) (j : IntegerParameters U)
    (p : IntegerParameters P) (x : Rational T) (y : Rational U)
    (run : Jl (Rational P)) : Prop :=
  let g : Int := Nat.gcd (rd i x).natAbs (rd j y).natAbs
  let a := rn i x * (rd j y).tdiv g
  let b := rn j y * (rd i x).tdiv g
  let d := rd i x * (rd j y).tdiv g
  let cv := Converts i j p x y
  (¬ cv → JuliaLean.Statements.rational.Round12.HasError run) ∧
  (cv → g = 0 →
    (rn i x = rn j y → ExactResult p run (rn i x) 0) ∧
    (rn i x ≠ rn j y → JuliaLean.Statements.rational.Round12.HasError run)) ∧
  (cv → g ≠ 0 →
    ((p.fits a ∧ p.fits b ∧ p.fits (a+b) ∧ p.fits d) →
      ConstructorOutcomeAny p run (a+b) d) ∧
    (¬ (p.fits a ∧ p.fits b ∧ p.fits (a+b) ∧ p.fits d) →
      JuliaLean.Statements.rational.Round12.HasError run))

def fma_exact : Prop :=
  ∀ {T U P V W : Type} (i : IntegerParameters T) (j : IntegerParameters U)
    (p : IntegerParameters P) (v : IntegerParameters V) (w : IntegerParameters W)
    (mp : PromotionParameters i j p) (ma : PromotionParameters p v w)
    (x : Rational T) (y : Rational U) (z : Rational V)
    (hx : Canonical i x) (hy : Canonical j y) (hz : Canonical v z),
    let cv := Converts i j p x y
    let g1 : Int := Nat.gcd (rn i x).natAbs (rd j y).natAbs
    let g2 : Int := Nat.gcd (rd i x).natAbs (rn j y).natAbs
    let n := (rn i x).tdiv g1 * (rn j y).tdiv g2
    let d := (rd i x).tdiv g2 * (rd j y).tdiv g1
    let mulRun := mulRatRatSource mp.prom (dg p p) x y
    let addRun := fmaRatSource (mulRatRatSource mp.prom (dg p p)) (add ma) x y z
    (¬ cv → JuliaLean.Statements.rational.Round12.HasError addRun) ∧
    (cv → (g1 = 0 ∨ g2 = 0 →
        JuliaLean.Statements.rational.Round12.HasError addRun) ∧
      (g1 ≠ 0 → g2 ≠ 0 →
        (FitsPair p n d →
          ∃ product, mulRun = .ok product ∧
            Represents p product (rn i x*rn j y) (rd i x*rd j y) ∧
            AddOutcomeAny p v w product z (add ma product z)) ∧
        (¬ FitsPair p n d → JuliaLean.Statements.rational.Round12.HasError addRun))) ∧
    (rd i x > 0 → rd j y > 0 → rd v z > 0 →
      ∀ q, addRun = .ok q →
        Represents w q
          (rn i x*rn j y*rd v z + rn v z*rd i x*rd j y)
          (rd i x*rd j y*rd v z))

end JuliaLean.Statements.rational.Round12.Fma

