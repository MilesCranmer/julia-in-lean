theorem mixed_remainders_aux : mixed_remainders := by
  unfold mixed_remainders
  intro t s x y hx hy
  exact ⟨by simpa using mixed_remainder_outcome_aux t s x y hx hy false,
    by simpa using mixed_remainder_outcome_aux t s x y hx hy true⟩

theorem mixed_remainders_proven : mixed_remainders := @mixed_remainders_aux
private theorem nonnegativePowerRun_eq_powerBySquaring
    (t s : IntTy) (negDead : Rat t → Jl (Rat t))
    (convertOther : Rat t → Jl (Rat t)) (throwDead : Rat t → JInt s → Jl (Rat t))
    (x : Rat t) (n : JInt s) (hn : 0 ≤ n.val) :
    nonnegativePowerRun t s negDead convertOther throwDead x n =
      (let mul := mulRatRatSource (samePromoteOps (nativeOps t)) (dg (.bits t) (.bits t))
       JuliaLean.base.intfuncs.powerBySquaring (JuliaLean.base.intfuncs.bitsOps s)
        mul true (fun q => .ok (JuliaLean.base.number.convertSame q)) convertOther
        (fun q => .ok (JuliaLean.base.number.convertSame q)) JuliaLean.base.number.copy
        (oneRat t) negDead (isOneRationalSource (nativeOps t).isone) mul true x n throwDead) := by
  unfold nonnegativePowerRun powRationalIntegerGeneric
  have hge : JuliaLean.base.int.le (JInt.lit .i64 0) n = true := by
    rw [JuliaLean.Proofs.base.int.le_eq]
    have hzero : (JInt.lit .i64 0).val = 0 := by decide
    rw [hzero]
    simp [hn]
  simp [hge, Bind.bind, Except.bind, Pure.pure, Except.pure]

private def r81MonoidPow {T : Type} (mulOp : T → T → T) (one x : T) : Nat → T
  | 0 => one
  | k + 1 => mulOp (r81MonoidPow mulOp one x k) x

private theorem r81MonoidPow_add {T : Type} (mulOp : T → T → T) (one : T)
    (hassoc : ∀ a b c, mulOp (mulOp a b) c = mulOp a (mulOp b c))
    (honeR : ∀ a, mulOp a one = a) (x : T) (m : Nat) :
    ∀ n : Nat, r81MonoidPow mulOp one x (m + n) =
      mulOp (r81MonoidPow mulOp one x m) (r81MonoidPow mulOp one x n)
  | 0 => by simp [r81MonoidPow, honeR]
  | n + 1 => by
    rw [Nat.add_succ, r81MonoidPow, r81MonoidPow,
      r81MonoidPow_add mulOp one hassoc honeR x m n, hassoc]

private theorem r81FoldlM_const_step {S A B : Type} (step : S → Jl S) :
    ∀ (xs : List A) (ys : List B) (s : S), xs.length = ys.length →
      xs.foldlM (fun s _ => step s) s = ys.foldlM (fun s _ => step s) s
  | [], [], _, _ => rfl
  | _ :: xs, _ :: ys, s, h => by
    simp only [List.length_cons, Nat.succ.injEq] at h
    simp only [List.foldlM_cons]
    cases step s with
    | error _ => rfl
    | ok s' => exact r81FoldlM_const_step step xs ys s' h

private theorem r81RepeatM_succ {S : Type} (n : Nat) (step : S → Jl S) (s : S) :
    JuliaLean.base.intfuncs.repeatM (n + 1) step s =
      (step s).bind (JuliaLean.base.intfuncs.repeatM n step) := by
  unfold JuliaLean.base.intfuncs.repeatM
  rw [r81FoldlM_const_step step (List.range (n + 1)) (0 :: List.range n) s (by simp)]
  rfl

private theorem r81FindMapSucc (l : List Nat) (p : Nat) :
    (l.map Nat.succ).find? (fun i => p.testBit i) =
      (l.find? (fun i => (p / 2).testBit i)).map Nat.succ := by
  induction l with
  | nil => rfl
  | cons a l ih =>
    simp only [List.map_cons, List.find?_cons, Nat.testBit_succ]
    cases (p / 2).testBit a <;> simp [ih]

private theorem r81FindRangeTestBit : ∀ (w p : Nat), 0 < p → p < 2 ^ w →
    ∃ tz < w, (List.range w).find? (fun i => p.testBit i) = some tz ∧
      p = 2 ^ tz * (1 + 2 * (p / 2 ^ (tz + 1)))
  | 0, p, hp0, hpw => by simp at hpw; omega
  | w + 1, p, hp0, hpw => by
    rw [List.range_succ_eq_map, List.find?_cons, Nat.testBit_zero]
    rcases Nat.mod_two_eq_zero_or_one p with h | h
    · simp only [h, Nat.zero_ne_one, decide_false, r81FindMapSucc]
      have hp2_pos : 0 < p / 2 := by omega
      have hp2_lt : p / 2 < 2 ^ w := by rw [Nat.pow_succ] at hpw; omega
      obtain ⟨tz, htz_lt, hfind, heq⟩ := r81FindRangeTestBit w (p / 2) hp2_pos hp2_lt
      rw [hfind]
      refine ⟨tz + 1, by omega, rfl, ?_⟩
      have hdiv : (p / 2) / 2 ^ (tz + 1) = p / 2 ^ (tz + 2) := by
        rw [Nat.div_div_eq_div_mul, Nat.mul_comm 2, ← Nat.pow_succ]
      rw [hdiv] at heq
      have hp_eq : p = 2 * (p / 2) := by omega
      have hpow_mul : 2 * (2 ^ tz * (1 + 2 * (p / 2 ^ (tz + 2)))) =
          2 ^ (tz + 1) * (1 + 2 * (p / 2 ^ (tz + 2))) := by
        rw [← Nat.mul_assoc, Nat.mul_comm 2 (2 ^ tz), ← Nat.pow_succ]
      conv => lhs; rw [hp_eq, heq, hpow_mul]
    · simp only [h, decide_true]
      refine ⟨0, by omega, rfl, ?_⟩
      simp only [Nat.pow_zero, Nat.zero_add, Nat.pow_one, Nat.one_mul]
      omega

