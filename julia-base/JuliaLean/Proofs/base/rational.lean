/-- 8. Registry id: `rational-bool-conversion`. -/
theorem bool_conversion_aux {T : Type} (i : IntegerParameters T) (x : Rational T)
    (hx : Canonical i x) :
    let run := boolOfRatSource
      (fun q => eqRatIntSource i.ops.isone i.ops.eq q i.ops.zero)
      (fun q => eqRatIntSource i.ops.isone i.ops.eq q i.ops.one)
      x inexactErrorCore
    (rn i x = 0 → run = .ok false) ∧
    (rn i x = rd i x → run = .ok true) ∧
    (rn i x ≠ 0 → rn i x ≠ rd i x → IsInexact run) := by
