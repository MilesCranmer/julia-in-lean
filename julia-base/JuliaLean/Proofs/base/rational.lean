private theorem native_mulXP_eq (t s : IntTy) (a : JInt t) (b : JInt (t.promote s))
    (ha : (t.promote s).min ≤ a.val ∧ a.val ≤ (t.promote s).max) :
    (Round6.nativePromotion t s).checkedMulXP a b =
      (PromotionParameters.bits t s).prom.checkedMulXP a b := by
  have hAbs := (Round6.promote_absorption_proven t s).1
  have hb := b.property
  have hwa : JInt.wrap (t.promote s) a.val = ⟨a.val,ha⟩ :=
    Subtype.ext (wrapInt_of_inRange _ _ ha)
  simp [Round6.nativePromotion,Round6.castInteger,
    JuliaLean.base.checked.checkedMulMixedBits,JuliaLean.base.checked.checkedMulPromoted,
    JuliaLean.base.checked.promoteBits,PromotionParameters.prom,jintPromoteOps,
    JInt.convert,hAbs,ha,hb,hwa,JuliaLean.base.rational.checkedMul]
  have map_id {α : Type} (e : Except JlError α) : Except.map id e = e := by cases e <;> rfl
  cases t <;> cases s <;> change Except.map id _ = _
  all_goals exact map_id _
private theorem native_mulPY_eq (t s : IntTy) (a : JInt (t.promote s)) (b : JInt s)
    (hb : (t.promote s).min ≤ b.val ∧ b.val ≤ (t.promote s).max) :
    (Round6.nativePromotion t s).checkedMulPY a b =
      (PromotionParameters.bits t s).prom.checkedMulPY a b := by
  have hAbs := (Round6.promote_absorption_proven t s).2.2.2
  have ha := a.property
  have hwb : JInt.wrap (t.promote s) b.val = ⟨b.val,hb⟩ :=
    Subtype.ext (wrapInt_of_inRange _ _ hb)
  simp [Round6.nativePromotion,Round6.castInteger,
    JuliaLean.base.checked.checkedMulMixedBits,JuliaLean.base.checked.checkedMulPromoted,
    JuliaLean.base.checked.promoteBits,PromotionParameters.prom,jintPromoteOps,
    JInt.convert,hAbs,ha,hb,hwb,JuliaLean.base.rational.checkedMul]
  have map_id {α : Type} (e : Except JlError α) : Except.map id e = e := by cases e <;> rfl
  cases t <;> cases s <;> change Except.map id _ = _
  all_goals exact map_id _
private theorem native_divInt_eq (t s : IntTy) (k : JInt t) (y : Rat s)
    (hy : Normalized y) :
    divIntRatSource (Round6.nativePromotion t s) (dg (.bits (t.promote s)) (.bits (t.promote s))) k y =
    divIntRatSource (PromotionParameters.bits t s).prom (dg (.bits (t.promote s)) (.bits (t.promote s))) k y := by
  have hd : (t.promote s).min ≤ y.den.val ∧ y.den.val ≤ (t.promote s).max :=
    ⟨Int.le_trans (min_le_zero _) hy.1,Int.le_trans y.den.property.2 (max_le_promote_right t s)⟩
  have heq := native_mulPY_eq t s
  unfold divIntRatSource
  simp only [heq _ y.den hd]
  rfl

theorem public_integer_left_proven : JuliaLean.Statements.rational.Round21.public_integer_left := by
  exact Round17.mixed_left_value_proven

theorem public_integer_left_quotient_proven : JuliaLean.Statements.rational.Round21.public_integer_left_quotient := by
  intro s t k y hy p run slashRun cv g dn dd safe
  have heq := native_divInt_eq s t k y hy
  have h := integer_rational_exact_aux (.bits s) (.bits t) (.bits (s.promote t)) (.bits s t) k y hy
  change (¬ cv → _) ∧ (cv → g = 0 → _) ∧ (cv → g ≠ 0 → _) ∧ (cv → g ≠ 0 → _) at h
  have hrun : run = divIntRatSource (PromotionParameters.bits s t).prom (dg p p) k y := heq
  have hslash : slashRun = run := rfl
  rw [hslash]
  refine ⟨?_,?_,?_⟩
  · intro hn
    obtain ⟨msg,he⟩ := h.1 hn
    exact ⟨⟨.inexactError msg,hrun.trans he⟩,⟨.inexactError msg,hrun.trans he⟩⟩
  · intro hc hg
    have he := h.2.1 hc hg
    exact ⟨⟨.divideError,hrun.trans he⟩,⟨.divideError,hrun.trans he⟩⟩
  · intro hc hg
    refine ⟨fun hs => ?_,fun hn => ?_⟩
    · have hh := h.2.2.1 hc hg hs
      rw [← hrun] at hh
      exact ⟨hh,hh⟩
    · obtain ⟨msg,he⟩ := h.2.2.2 hc hg hn
      exact ⟨⟨.overflowError msg,hrun.trans he⟩,⟨.overflowError msg,hrun.trans he⟩⟩

private theorem chopX_eq (sub : Bool) (t s : IntTy)
    (a : JInt t) (b : JInt (t.promote s))
    (ha : (t.promote s).min ≤ a.val ∧ a.val ≤ (t.promote s).max) :
    Round6.castInteger (Round6.promote_absorption_proven t s).1
      (if sub then JuliaLean.base.checked.checkedSubMixedBits a b
      else JuliaLean.base.checked.checkedAddMixedBits a b) =
    (if sub then JuliaLean.base.checked.checkedSubBits ⟨a.val,ha⟩ b
      else JuliaLean.base.checked.checkedAddBits ⟨a.val,ha⟩ b) := by
  have hAbs := (Round6.promote_absorption_proven t s).1
  have hb := b.property
  cases sub <;> simp [JuliaLean.base.checked.checkedAddMixedBits,
    JuliaLean.base.checked.checkedSubMixedBits,JuliaLean.base.checked.checkedAddPromoted,
    JuliaLean.base.checked.checkedSubPromoted,JuliaLean.base.checked.promoteBits,
    JInt.convert,hAbs,ha,hb,Round6.castInteger]
  all_goals
    have map_id {α : Type} (e : Except JlError α) : Except.map id e = e := by cases e <;> rfl
    cases t <;> cases s <;> change Except.map id _ = _
    all_goals exact map_id _

private theorem scalar_outcome (sub : Bool) (t s : IntTy) (x : Rat t) (k : JInt s)
    (hx : Normalized x) :
    let p := IntegerParameters.bits (t.promote s)
    let run := rationalIntegerOpSource (Round6.nativePromotion t s)
      (fun a b => Round6.castInteger (Round6.promote_absorption_proven t s).1
        (if sub then JuliaLean.base.checked.checkedSubMixedBits a b
          else JuliaLean.base.checked.checkedAddMixedBits a b)) x k
    JuliaLean.Statements.rational.Round21.ScalarOutcome p run x.num.val x.den.val k.val
      (x.den.val*k.val) (if sub then x.num.val-x.den.val*k.val else x.num.val+x.den.val*k.val) := by
  intro p run
  let m : PromotionParameters (.bits t) (.bits s) p := .bits t s
  have hm := prom_checkedMulXY_spec m x.den k
  unfold JuliaLean.Statements.rational.Round21.ScalarOutcome
  refine ⟨?_,?_,?_,?_,?_⟩
  · intro hn
    obtain ⟨msg,he⟩ := hm.1 hn
    have he' : (Round6.nativePromotion t s).checkedMulXY x.den k = .error (.inexactError msg) := he
    exact ⟨.inexactError msg,by simp [run,rationalIntegerOpSource,he']⟩
  · intro hd hk hn
    obtain ⟨msg,he⟩ := (hm.2 ⟨hd,hk⟩).2 hn
    have he' : (Round6.nativePromotion t s).checkedMulXY x.den k = .error (.overflowError msg) := he
    exact ⟨.overflowError msg,by simp [run,rationalIntegerOpSource,he']⟩
  · intro hd hk hp hn
    obtain ⟨a,ha,hav⟩ := (hm.2 ⟨hd,hk⟩).1 hp
    have ha' : (Round6.nativePromotion t s).checkedMulXY x.den k = .ok a := ha
    have hAbs := (Round6.promote_absorption_proven t s).1
    have haFit := a.property
    change ¬ ((t.promote s).min ≤ x.num.val ∧ x.num.val ≤ (t.promote s).max) at hn
    refine ⟨.inexactError (t.promote s).name,?_⟩
    cases sub <;> simp [run,rationalIntegerOpSource,ha',Round6.castInteger,
      JuliaLean.base.checked.checkedAddMixedBits,JuliaLean.base.checked.checkedSubMixedBits,
      JuliaLean.base.checked.checkedAddPromoted,JuliaLean.base.checked.checkedSubPromoted,
      JuliaLean.base.checked.promoteBits,JInt.convert,hAbs,haFit,hn]
  all_goals
    intro hd hk hp hn hr
    obtain ⟨a,ha,hav⟩ := (hm.2 ⟨hd,hk⟩).1 hp
    have ha' : (Round6.nativePromotion t s).checkedMulXY x.den k = .ok a := ha
    change a.val = x.den.val*k.val at hav
    have hc := chopX_eq sub t s x.num a hn
    let num : JInt (t.promote s) := ⟨x.num.val,hn⟩
    have hop : JuliaLean.Proofs.base.checked.ExactOrOverflow
        (if sub then JuliaLean.base.checked.checkedSubBits num a
        else JuliaLean.base.checked.checkedAddBits num a)
        (if sub then x.num.val-x.den.val*k.val else x.num.val+x.den.val*k.val) := by
      cases sub
      · simpa only [Bool.false_eq_true,↓reduceIte,hav] using JuliaLean.Proofs.base.checked.addExact _ num a
      · simpa only [↓reduceIte,hav] using JuliaLean.Proofs.base.checked.subExact _ num a
    unfold JuliaLean.Proofs.base.checked.ExactOrOverflow at hop
  · change ¬ ((t.promote s).min ≤ _ ∧ _ ≤ (t.promote s).max) at hr
    rw [if_neg hr] at hop
    cases he : (if sub then JuliaLean.base.checked.checkedSubBits num a
        else JuliaLean.base.checked.checkedAddBits num a) with
    | error e => exact ⟨e,by simp [run,rationalIntegerOpSource,ha',hc,show
        (if sub then JuliaLean.base.checked.checkedSubBits ⟨x.num.val,hn⟩ a
        else JuliaLean.base.checked.checkedAddBits ⟨x.num.val,hn⟩ a) = .error e from he]⟩
    | ok n => rw [he] at hop; contradiction
  · change (t.promote s).min ≤ _ ∧ _ ≤ (t.promote s).max at hr
    rw [if_pos hr] at hop
    obtain ⟨n,hncall,hnval⟩ := hop
    obtain ⟨d,hdcall,hdval⟩ := prom_promotePX_spec m n x.den hd
    have hdcall' : (Round6.nativePromotion t s).promotePX n x.den = .ok (n,d) := hdcall
    have hrun : run = .ok ⟨n,d⟩ := by
      simp [run,rationalIntegerOpSource,ha',hc,show
        (if sub then JuliaLean.base.checked.checkedSubBits ⟨x.num.val,hn⟩ a
        else JuliaLean.base.checked.checkedAddBits ⟨x.num.val,hn⟩ a) = .ok n from hncall,
        unsafeRationalPromoteSource,hdcall',unsafeRationalSameSource_pair]
    change d.val = x.den.val at hdval
    refine ⟨⟨n,d⟩,hrun,?_,?_,?_,?_⟩
    · change 0 ≤ d.val ∧ Nat.gcd n.val.natAbs d.val.natAbs = 1
      rw [hnval,hdval]
      refine ⟨hx.1,?_⟩
      cases sub
      · simpa [Int.mul_neg,Int.sub_neg] using gcd_sub_mul_coprime x.num.val x.den.val (-k.val) hx.2
      · exact gcd_sub_mul_coprime x.num.val x.den.val k.val hx.2
    · change n.val*x.den.val = _*d.val
      rw [hnval,hdval]
    · change x.den.val ≠ 0 → d.val > 0
      rw [hdval]; have := hx.1; omega
    · intro hd0
      change d.val = 0 ∧ intSign n.val = intSign _
      exact ⟨hdval.trans hd0,congrArg intSign hnval⟩

private theorem native_mulXP_num_error (t s : IntTy) (n : JInt t) (v : JInt (t.promote s))
    (hn : ¬ (IntegerParameters.bits (t.promote s)).fits n.val) :
