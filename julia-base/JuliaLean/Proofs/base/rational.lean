/-- Actual native iszero dispatch, including the installed Number fallback,
native zero and native equality. The accepted tag records that these
concrete Base calls return Bool. Source: base/number.jl:44;
base/rational.jl:97,110. -/
def nativeExactIszero {t : IntTy} (value : JInt t) :
    Except ArrayError (TypeAssertion Bool Empty) := do
  let result ← liftJulia (JuliaLean.base.number.iszero
    (fun x => pure (JuliaLean.base.int.zero x))
    (fun x y => pure (JuliaLean.base.int.eq x y)) value)
  pure (.accepted result)

/-- Independent canonical fraction outcome for exact rational division.
The coordinates are mathematical products of the original components;
they are not the source's cross-cancelled intermediate products. A zero
coordinate pair is indeterminate and gives DivideError. Otherwise the
unique reduced pair has nonnegative denominator, with infinity retaining
the numerator sign. Both the reduced coordinates before sign normalization
and the final canonical coordinates must fit: a positive product can
overflow before a later sign change would make it representable. Success
stores the canonical pair exactly when both range conditions hold; other
nonzero-pair outcomes are OverflowError. The Sigma result exposes, rather
than assumes, its actual component type. Int and Nat specify mathematics.
Source: base/rational.jl:93-114;
doc/src/manual/complex-and-rational-numbers.md:184-210,283-305. -/
def NativeExactRationalCanonicalOutcome (target : IntTy) (num den : Int)
    (run : Except ArrayError (Sigma Rat)) : Prop :=
  if num = 0 ∧ den = 0 then
    run = .error (.julia .divideError)
  else
    let divisor : Int := Nat.gcd num.natAbs den.natAbs
    let reducedNum := num / divisor
    let reducedDen := den / divisor
    let canonicalNum := if den < 0 then -reducedNum else reducedNum
    let canonicalDen := if den < 0 then -reducedDen else reducedDen
    let productsFit : Prop :=
      (target.min ≤ reducedNum ∧ reducedNum ≤ target.max) ∧
      (target.min ≤ reducedDen ∧ reducedDen ≤ target.max)
    let canonicalFits : Prop :=
      (target.min ≤ canonicalNum ∧ canonicalNum ≤ target.max) ∧
      (target.min ≤ canonicalDen ∧ canonicalDen ≤ target.max)
    match run with
    | .ok result =>
        result.1 = target ∧ productsFit ∧ canonicalFits ∧
        result.2.num.val = canonicalNum ∧ result.2.den.val = canonicalDen
    | .error error =>
        ¬ (productsFit ∧ canonicalFits) ∧
        ∃ message : String, error = .julia (.overflowError message)

end JuliaLean.Proofs.base.rational.Models2Group10

namespace JuliaLean.Proofs.base.rational.Models2Group10

open JuliaLean JuliaLean.base.rational
open JuliaLean.base.rational.Models2Group10
open JuliaLean.base.abstractarray (ArrayError)
open JuliaLean.base.abstractarray.Models1Group1 (TypeAssertion)

/-- Specification-only categories of selected dispatch calls in exact
rational division. These observations are not Julia runtime values.
Source: base/rational.jl:93-114. -/
inductive ExactCallKind where
  | promotion | reduction | zeroTest | signTest | negation | product | finish
  deriving DecidableEq

/-- A private call observation records whether dispatch threw, a returned
Boolean when applicable, and whether product/final dispatch used a negated
numerator carrier. No numerical behavior is assumed.
Source: base/rational.jl:93-114. -/
structure ExactCallEvent where
  kind : ExactCallKind
  failed : Bool
  boolean : Option Bool
  negated : Bool

/-- The specification records actual callback outcomes and worlds. The
selected implementations receive only World, so they cannot modify these
observations. The list is mathematical ghost data, not a Julia array.
Source: base/rational.jl:93-114. -/
structure ExactCallLog (World R : Type) where
  events : List ExactCallEvent := []
  lastError : Option ArrayError := none
  lastWorld : Option World := none
  lastResult : Option R := none

/-- Observe one actual selected call without changing its world, result
or error. Boolean observations and final-result provenance are extracted
from that call's returned value, not from an assumed correctness law.
Source: base/rational.jl:93-114. -/
def observeExactCall {World R Value : Type}
    (kind : ExactCallKind) (negated : Bool)
    (boolean : Value → Option Bool) (returned : Value → Option R)
    (action : EStateM ArrayError World Value) :
    EStateM ArrayError (World × ExactCallLog World R) Value :=
  fun (world, log) =>
    match action world with
    | .ok value after =>
        .ok value (after, {
          events := log.events ++ [{ kind := kind, failed := false, boolean := boolean value, negated := negated }]
          lastError := none
          lastWorld := some after
          lastResult := returned value })
    | .error error after =>
        .error error (after, {
          events := log.events ++ [{ kind := kind, failed := true, boolean := none, negated := negated }]
          lastError := some error
          lastWorld := some after
          lastResult := none })

/-- Observe a non-predicate intermediate call; its numeric result is
unrestricted and is not interpreted by the specification.
Source: base/rational.jl:93-114. -/
def observeExactPlain {World R Value : Type}
    (kind : ExactCallKind) (negated : Bool)
    (action : EStateM ArrayError World Value) :
    EStateM ArrayError (World × ExactCallLog World R) Value :=
  observeExactCall kind negated (fun _ => none) (fun _ => none) action

/-- A returned non-Bool value is observed as none and remains subject to
the method's real runtime assertion. No Bool-returning callee law is assumed.
Source: base/rational.jl:97,110. -/
def observeExactPredicate {World R Other : Type} (kind : ExactCallKind)
    (action : EStateM ArrayError World (TypeAssertion Bool Other)) :
    EStateM ArrayError (World × ExactCallLog World R) (TypeAssertion Bool Other) :=
  observeExactCall kind false
    (fun value => match value with | .accepted b => some b | .rejected _ => none)
    (fun _ => none) action

/-- The final selected checked_den result is recorded without interpreting
or constraining its type or value. Source: base/rational.jl:100,104,113. -/
def observeExactFinish {World R : Type} (negated : Bool)
    (action : EStateM ArrayError World R) :
    EStateM ArrayError (World × ExactCallLog World R) R :=
  observeExactCall .finish negated (fun _ => none) some action

/-- A mathematical call count in the private observation list.
Source: base/rational.jl:93-114. -/
def exactCallCount (kind : ExactCallKind) (events : List ExactCallEvent) : Nat :=
  (events.filter (fun event => decide (event.kind = kind))).length

/-- Whether selected signbit returned true in the observed prefix.
Source: base/rational.jl:97,110. -/
def exactSignWasTrue (events : List ExactCallEvent) : Bool :=
  events.any (fun event => decide
    (event.kind = .signTest ∧ event.boolean = some true))

/-- Products may start only once the Boolean guard is resolved and any
required numerator negation has returned successfully. This is a safety
invariant over observed outcomes, not an expected execution of the method.
Source: base/rational.jl:97-100,110-113. -/
def ExactGuardCompleted (events : List ExactCallEvent) : Prop :=
  (∃ event ∈ events, event.kind = .zeroTest ∧ event.boolean = some false) ∨
  (∃ event ∈ events, event.kind = .signTest ∧ event.boolean = some false) ∨
  ((∃ event ∈ events, event.kind = .signTest ∧ event.boolean = some true) ∧
   (∃ event ∈ events, event.kind = .negation ∧ event.failed = false))

/-- Independent partial-order and bounded-call invariants. Reduction
requires its promotion; no product precedes the required reductions or sign
adjustment; signbit is skipped when the zero test is false; negation requires
a true sign test. Callback errors and non-Bool predicates end dispatch.
Products finish before final construction, whose selected branch agrees with
the observed guard. This constrains observations without replaying a complete
expected trace or assuming any numerical law.
Source: base/rational.jl:93-114. -/
def ExactCallsOrdered (pairs products : Nat) (guarded : Bool)
    (events : List ExactCallEvent) : Prop :=
  1 ≤ exactCallCount .promotion events ∧
  exactCallCount .promotion events ≤ pairs ∧
  exactCallCount .reduction events ≤ pairs ∧
  exactCallCount .zeroTest events ≤ 1 ∧
  exactCallCount .signTest events ≤ 1 ∧
  exactCallCount .negation events ≤ 1 ∧
  exactCallCount .product events ≤ products ∧
  exactCallCount .finish events ≤ 1 ∧
  (guarded = false → exactCallCount .zeroTest events = 0 ∧
    exactCallCount .signTest events = 0 ∧ exactCallCount .negation events = 0) ∧
  ∀ (before after : List ExactCallEvent) (event : ExactCallEvent),
    events = before ++ (event :: after) →
    (event.failed = true → after = []) ∧
    ((event.kind = .zeroTest ∨ event.kind = .signTest) →
      event.boolean = none → after = []) ∧
    (match event.kind with
    | .promotion =>
        exactCallCount .promotion before = exactCallCount .reduction before ∧
        exactCallCount .product before = 0
    | .reduction =>
        exactCallCount .promotion before = exactCallCount .reduction before + 1 ∧
        exactCallCount .product before = 0
    | .zeroTest =>
        exactCallCount .reduction before = pairs ∧
        exactCallCount .product before = 0
    | .signTest =>
        (∃ zero ∈ before, zero.kind = .zeroTest ∧ zero.boolean = some true) ∧
        exactCallCount .product before = 0
    | .negation =>
        exactSignWasTrue before = true ∧ exactCallCount .product before = 0
    | .product =>
        exactCallCount .reduction before = pairs ∧
        (guarded = true → ExactGuardCompleted before) ∧
        exactCallCount .finish before = 0 ∧
        (if guarded = true ∧ products = 2 ∧ exactCallCount .product before = 0
          then event.negated = exactSignWasTrue before
          else event.negated = false)
    | .finish =>
        exactCallCount .product before = products ∧
        event.negated = (if guarded then exactSignWasTrue before else false))

/-- A successful division has completed every mandatory cancellation and
product and exactly one final constructor dispatch. Conditional sign and
negation calls remain governed by the observed predicates above.
Source: base/rational.jl:93-114. -/
def ExactCallsCompleted (pairs products : Nat) (guarded : Bool)
    (events : List ExactCallEvent) : Prop :=
  exactCallCount .promotion events = pairs ∧
  exactCallCount .reduction events = pairs ∧
  exactCallCount .product events = products ∧
  exactCallCount .finish events = 1 ∧
  exactCallCount .zeroTest events = (if guarded then 1 else 0)

/-- An error is the unchanged last selected-call error, or the actual
TypeError caused by the last predicate's successful non-Bool result.
No invented error or default value is admitted. Source: base/rational.jl:93-114. -/
def ExactErrorOrigin {World R : Type} (error : ArrayError)
    (log : ExactCallLog World R) : Prop :=
  (∃ reported : ArrayError, log.lastError = some reported ∧ error = reported) ∨
  (∃ (before : List ExactCallEvent) (last : ExactCallEvent),
    log.events = before ++ [last] ∧
    (last.kind = .zeroTest ∨ last.kind = .signTest) ∧
    last.failed = false ∧ last.boolean = none ∧
    error = .showError .typeError)

end JuliaLean.Proofs.base.rational.Models2Group10

