theorem opsP_checkedAdd_spec {T U P : Type} {i : IntegerParameters T} {j : IntegerParameters U}
    {p : IntegerParameters P} (m : PromotionParameters i j p) (a b : P) :
    (p.fits (val p a + val p b) →
      ∃ r, m.prom.opsP.checkedAdd a b = .ok r ∧ val p r = val p a + val p b) ∧
    (¬ p.fits (val p a + val p b) → IsOverflow (m.prom.opsP.checkedAdd a b)) := by
  cases m with
  | same i =>
    cases i with | bits t =>
    have h := JuliaLean.Proofs.base.checked.addExact t a b
    unfold JuliaLean.Proofs.base.checked.ExactOrOverflow at h
    by_cases hf : t.min ≤ a.val + b.val ∧ a.val + b.val ≤ t.max
    · simp only [if_pos hf] at h; exact ⟨fun _ => h, fun hn => absurd hf hn⟩
    · simp only [if_neg hf] at h
      refine ⟨fun hc => absurd hc hf, fun _ => ?_⟩
      unfold PromotionParameters.prom samePromoteOps
      dsimp only [IntegerParameters.ops, jintOps, JuliaLean.base.rational.checkedAdd]
      cases hcall : JuliaLean.base.checked.checkedAddBits a b with
      | ok _ => rw [hcall] at h; contradiction
      | error err => rw [hcall] at h; cases err <;> first | contradiction | exact ⟨_, rfl⟩
  | bits t s =>
    let pt := t.promote s
    have h := JuliaLean.Proofs.base.checked.addExact pt a b
    unfold JuliaLean.Proofs.base.checked.ExactOrOverflow at h
    by_cases hf : pt.min ≤ a.val + b.val ∧ a.val + b.val ≤ pt.max
    · simp only [if_pos hf] at h; exact ⟨fun _ => h, fun hn => absurd hf hn⟩
    · simp only [if_neg hf] at h
      refine ⟨fun hc => absurd hc hf, fun _ => ?_⟩
      unfold PromotionParameters.prom jintPromoteOps
      dsimp only [jintOps, JuliaLean.base.rational.checkedAdd]
      cases hcall : JuliaLean.base.checked.checkedAddBits a b with
      | ok _ => rw [hcall] at h; contradiction
      | error err => rw [hcall] at h; cases err <;> first | contradiction | exact ⟨_, rfl⟩

