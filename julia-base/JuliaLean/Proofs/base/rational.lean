base/div.jl:326-373,391-417,448-474. -/
def RoundedNativeFinalOutcome {result : IntTy} (left right : IntTy)
    (run : Jl (JInt result)) (a b : Int) (mode : Rounding) : Prop :=
  let signedOverflow := RoundedSignedQuotientOverflow left right result a b
  RoundedFits left a ∧ RoundedFits right b ∧
  ((b = 0 ∨ signedOverflow) → run = .error .divideError) ∧
  (b ≠ 0 → ¬signedOverflow →
    ∃ (q : Int) (out : JInt result),
      RoundedValue a b mode q ∧ run = .ok out ∧ out.val = wrapInt result q)

/-- Full outcome contract for the source at base/rational.jl:586-589.
The expected rounded value uses the original exact ratio x.num/(x.den*y),
