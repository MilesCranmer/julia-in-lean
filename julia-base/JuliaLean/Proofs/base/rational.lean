  have hx := x.property
  change -9223372036854775808 ≤ x.val ∧ x.val ≤ 9223372036854775807 at hx
  change -170141183460469231731687303715884105728 ≤ x.val ∧
    x.val ≤ 170141183460469231731687303715884105727
  omega

