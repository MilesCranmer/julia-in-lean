def NativeRationalCanonicalOutcome (target : IntTy) (num den : Int)
    (run : Except ArrayError (Rat target)) : Prop :=
  if num = 0 ∧ den = 0 then
    ∃ message : String, run = .error (.julia (.argumentError message))
  else
    let divisor : Int := Nat.gcd num.natAbs den.natAbs
    let reducedNum := num / divisor
    let reducedDen := den / divisor
    let canonicalNum := if den < 0 then -reducedNum else reducedNum
    let canonicalDen := if den < 0 then -reducedDen else reducedDen
    let fits : Prop :=
      (target.min ≤ canonicalNum ∧ canonicalNum ≤ target.max) ∧
      (target.min ≤ canonicalDen ∧ canonicalDen ≤ target.max)
    match run with
    | .ok result =>
        fits ∧ result.num.val = canonicalNum ∧ result.den.val = canonicalDen
    | .error error =>
        ¬ fits ∧ ∃ message : String, error = .julia (.overflowError message)

