open JuliaLean JuliaLean.base.rational
private theorem promoteIntegerPairYX_zero (t s : IntTy) :
    promoteIntegerPairYX (JInt.lit s 0) (JInt.lit t 0) =
      .ok (JInt.lit (t.promote s) 0, JInt.lit (t.promote s) 0) := by
  cases t <;> cases s <;>
    simp [promoteIntegerPairYX, JInt.convert, JInt.lit, JInt.wrap, wrapInt,
      IntTy.promote, IntTy.min, IntTy.max, IntTy.signed, IntTy.bits,
      Bind.bind, Except.bind, Pure.pure, Except.pure]

private theorem round4_dg_zero_error (t : IntTy) :
    JuliaLean.Proofs.base.rational.Round4.dg (.bits t) (.bits t)
      (JInt.lit t 0) (JInt.lit t 0) = .error .divideError := by
  cases t <;> decide

private theorem integer_left_mul_zero_gcd_error (t s : IntTy) (x : Rat t)
    (k : JInt s) (hk : k.val = 0) (hd : x.den.val = 0) :
    mulIntRatSource (JuliaLean.Proofs.base.rational.Round6.nativePromotion t s)
      promoteIntegerPairYX
      (JuliaLean.Proofs.base.rational.Round4.dg (.bits (t.promote s)) (.bits (t.promote s)))
      k x = .error .divideError := by
  rcases x with ⟨n, d⟩
  have hk0 : k = JInt.lit s 0 := by
    apply Subtype.ext
    have hzero : (JInt.lit s 0).val = 0 := by cases s <;> decide
    rw [hzero]
    exact hk
  have hd0 : d = JInt.lit t 0 := by
    apply Subtype.ext
    have hzero : (JInt.lit t 0).val = 0 := by cases t <;> decide
    rw [hzero]
    exact hd
  subst k
  subst d
  unfold mulIntRatSource
  simp [promoteIntegerPairYX_zero, round4_dg_zero_error,
    Bind.bind, Except.bind, Pure.pure, Except.pure]

private theorem integerRationalOpSource_mul_input_error
    (t s : IntTy)
    (chop : JInt (t.promote s) → JInt t → Jl (JInt (t.promote s)))
    (x : Rat t) (k : JInt s)
    (hnot : ¬ ((Round4.IntegerParameters.bits (t.promote s)).fits x.den.val ∧
      (Round4.IntegerParameters.bits (t.promote s)).fits k.val)) :
    JuliaLean.Statements.rational.Round17.HasError
      (JuliaLean.base.rational.integerRationalOpSource
        (JuliaLean.Proofs.base.rational.Round6.nativePromotion t s) chop k x) := by
  let m : Round4.PromotionParameters (.bits t) (.bits s) (.bits (t.promote s)) := .bits t s
  have hnot' : ¬ Round4.FitsPair (.bits (t.promote s)) x.den.val k.val := by
    change ¬ ((Round4.IntegerParameters.bits (t.promote s)).fits x.den.val ∧
      (Round4.IntegerParameters.bits (t.promote s)).fits k.val)
    exact hnot
  obtain ⟨msg, herr⟩ := (Round4.prom_checkedMulXY_spec m x.den k).1 hnot'
  have hmul :
      (JuliaLean.Proofs.base.rational.Round6.nativePromotion t s).checkedMulXY
        x.den k = .error (.inexactError msg) := by
    change m.prom.checkedMulXY x.den k = .error (.inexactError msg)
    exact herr
  refine ⟨.inexactError msg, ?_⟩
  simp [JuliaLean.base.rational.integerRationalOpSource, hmul]

private theorem integerRationalOpSource_mul_overflow_error
    (t s : IntTy)
    (chop : JInt (t.promote s) → JInt t → Jl (JInt (t.promote s)))
    (x : Rat t) (k : JInt s)
    (hfits : (Round4.IntegerParameters.bits (t.promote s)).fits x.den.val ∧
      (Round4.IntegerParameters.bits (t.promote s)).fits k.val)
    (hoverflow : ¬ (Round4.IntegerParameters.bits (t.promote s)).fits
      (x.den.val * k.val)) :
    JuliaLean.Statements.rational.Round17.HasError
      (JuliaLean.base.rational.integerRationalOpSource
        (JuliaLean.Proofs.base.rational.Round6.nativePromotion t s) chop k x) := by
  let m : Round4.PromotionParameters (.bits t) (.bits s) (.bits (t.promote s)) := .bits t s
  have hfits' : Round4.FitsPair (.bits (t.promote s)) x.den.val k.val := by
    change (Round4.IntegerParameters.bits (t.promote s)).fits x.den.val ∧
      (Round4.IntegerParameters.bits (t.promote s)).fits k.val
    exact hfits
  obtain ⟨_, hmul_overflow⟩ := (Round4.prom_checkedMulXY_spec m x.den k).2 hfits'
  obtain ⟨msg, herr⟩ := hmul_overflow hoverflow
  have hmul :
      (JuliaLean.Proofs.base.rational.Round6.nativePromotion t s).checkedMulXY
        x.den k = .error (.overflowError msg) := by
    change m.prom.checkedMulXY x.den k = .error (.overflowError msg)
    exact herr
  refine ⟨.overflowError msg, ?_⟩
  simp [JuliaLean.base.rational.integerRationalOpSource, hmul]

private theorem integer_left_mul_gcd_zero_error (t s : IntTy) (x : Rat t)
    (k : JInt s)
    (hg : (Nat.gcd k.val.natAbs x.den.val.natAbs : Int) = 0) :
    JuliaLean.Statements.rational.Round17.HasError
      (mulIntRatSource (Round6.nativePromotion t s) promoteIntegerPairYX
        (Round4.dg (.bits (t.promote s)) (.bits (t.promote s))) k x) := by
  have hgNat : Nat.gcd k.val.natAbs x.den.val.natAbs = 0 := by omega
  have ⟨hkAbs, hdAbs⟩ := Nat.gcd_eq_zero_iff.mp hgNat
  have hk : k.val = 0 := by omega
  have hd : x.den.val = 0 := by omega
  exact ⟨.divideError, integer_left_mul_zero_gcd_error t s x k hk hd⟩

private theorem integer_left_mul_promotion_error (t s : IntTy) (x : Rat t)
    (k : JInt s)
    (hnot : ¬ ((Round4.IntegerParameters.bits (t.promote s)).fits k.val ∧
      (Round4.IntegerParameters.bits (t.promote s)).fits x.den.val)) :
    JuliaLean.Statements.rational.Round17.HasError
      (mulIntRatSource (Round6.nativePromotion t s) promoteIntegerPairYX
        (Round4.dg (.bits (t.promote s)) (.bits (t.promote s))) k x) := by
  by_cases hk : (t.promote s).min ≤ k.val ∧ k.val ≤ (t.promote s).max
  · have hden : ¬ ((t.promote s).min ≤ x.den.val ∧ x.den.val ≤ (t.promote s).max) := by
      intro hd
      apply hnot
      exact ⟨by simpa [Round4.IntegerParameters.fits] using hk,
        by simpa [Round4.IntegerParameters.fits] using hd⟩
    refine ⟨.inexactError (t.promote s).name, ?_⟩
    simp [JuliaLean.base.rational.mulIntRatSource,
      JuliaLean.base.rational.promoteIntegerPairYX, JInt.convert, hk, hden]
  · refine ⟨.inexactError (t.promote s).name, ?_⟩
    simp [JuliaLean.base.rational.mulIntRatSource,
      JuliaLean.base.rational.promoteIntegerPairYX, JInt.convert, hk]

private theorem integer_left_scalar_num_error (sub : Bool) (t s : IntTy)
    (x : Rat t) (k : JInt s)
    (hden : (Round4.IntegerParameters.bits (t.promote s)).fits x.den.val)
    (hk : (Round4.IntegerParameters.bits (t.promote s)).fits k.val)
    (hprod : (Round4.IntegerParameters.bits (t.promote s)).fits (x.den.val * k.val))
    (hnum : ¬ (Round4.IntegerParameters.bits (t.promote s)).fits x.num.val) :
    JuliaLean.Statements.rational.Round17.HasError
      (JuliaLean.base.rational.integerRationalOpSource
        (Round6.nativePromotion t s)
        (fun a b => Round6.castInteger (Round6.promote_absorption_proven t s).2.2.1
          (if sub then JuliaLean.base.checked.checkedSubMixedBits a b
          else JuliaLean.base.checked.checkedAddMixedBits a b)) k x) := by
  let m : Round4.PromotionParameters (.bits t) (.bits s) (.bits (t.promote s)) := .bits t s
  have hfit : Round4.FitsPair (.bits (t.promote s)) x.den.val k.val := by
    change (Round4.IntegerParameters.bits (t.promote s)).fits x.den.val ∧
      (Round4.IntegerParameters.bits (t.promote s)).fits k.val
    exact ⟨hden, hk⟩
  obtain ⟨a, hmul, haVal⟩ := ((Round4.prom_checkedMulXY_spec m x.den k).2 hfit).1 hprod
  have haVal' : a.val = x.den.val * k.val := by
    change a.val = x.den.val * k.val at haVal
    exact haVal
  have hfitA : (Round4.IntegerParameters.bits (t.promote s)).fits a.val := by
    change (t.promote s).min ≤ a.val ∧ a.val ≤ (t.promote s).max
    rw [haVal']
    exact hprod
  change (t.promote s).min ≤ a.val ∧ a.val ≤ (t.promote s).max at hfitA
  have hnum' : ¬ ((t.promote s).min ≤ x.num.val ∧ x.num.val ≤ (t.promote s).max) := by
    change ¬ ((t.promote s).min ≤ x.num.val ∧ x.num.val ≤ (t.promote s).max) at hnum
    exact hnum
  have hAbs := (Round6.promote_absorption_proven t s).2.2.1
  have hprom :
      JuliaLean.base.checked.promoteBits a x.num =
        .error (.inexactError (t.promote s).name) := by
    simp [JuliaLean.base.checked.promoteBits, JInt.convert, hAbs, hfitA, hnum']
  have hmul' : (Round6.nativePromotion t s).checkedMulXY x.den k = .ok a := by
    change m.prom.checkedMulXY x.den k = .ok a
    exact hmul
  refine ⟨.inexactError (t.promote s).name, ?_⟩
  cases sub <;>
    simp [JuliaLean.base.rational.integerRationalOpSource, Round6.castInteger,
      JuliaLean.base.checked.checkedAddMixedBits, JuliaLean.base.checked.checkedSubMixedBits,
      JuliaLean.base.checked.checkedAddPromoted, JuliaLean.base.checked.checkedSubPromoted,
      hmul', hprom]

private theorem integer_left_add_sub_num_errors (t s : IntTy)
    (x : Rat t) (k : JInt s) :
    ((Round4.IntegerParameters.bits (t.promote s)).fits x.den.val →
      (Round4.IntegerParameters.bits (t.promote s)).fits k.val →
      (Round4.IntegerParameters.bits (t.promote s)).fits (x.den.val * k.val) →
      ¬ (Round4.IntegerParameters.bits (t.promote s)).fits x.num.val →
      JuliaLean.Statements.rational.Round17.HasError
        (JuliaLean.base.rational.integerRationalOpSource
          (Round6.nativePromotion t s)
          (fun a b => Round6.castInteger (Round6.promote_absorption_proven t s).2.2.1
            (JuliaLean.base.checked.checkedAddMixedBits a b)) k x)) ∧
    ((Round4.IntegerParameters.bits (t.promote s)).fits x.den.val →
      (Round4.IntegerParameters.bits (t.promote s)).fits k.val →
      (Round4.IntegerParameters.bits (t.promote s)).fits (x.den.val * k.val) →
      ¬ (Round4.IntegerParameters.bits (t.promote s)).fits x.num.val →
      JuliaLean.Statements.rational.Round17.HasError
        (JuliaLean.base.rational.integerRationalOpSource
          (Round6.nativePromotion t s)
          (fun a b => Round6.castInteger (Round6.promote_absorption_proven t s).2.2.1
            (JuliaLean.base.checked.checkedSubMixedBits a b)) k x)) := by
  constructor
  · intro hden hk hprod hnum
    simpa using integer_left_scalar_num_error false t s x k hden hk hprod hnum
  · intro hden hk hprod hnum
    simpa using integer_left_scalar_num_error true t s x k hden hk hprod hnum

private theorem integer_left_add_sub_early_errors (t s : IntTy)
    (x : Rat t) (k : JInt s) :
    ((¬ ((Round4.IntegerParameters.bits (t.promote s)).fits x.den.val ∧
        (Round4.IntegerParameters.bits (t.promote s)).fits k.val) →
        JuliaLean.Statements.rational.Round17.HasError
          (JuliaLean.base.rational.integerRationalOpSource
            (Round6.nativePromotion t s)
            (fun a b => Round6.castInteger (Round6.promote_absorption_proven t s).2.2.1
              (JuliaLean.base.checked.checkedAddMixedBits a b)) k x)) ∧
      ((Round4.IntegerParameters.bits (t.promote s)).fits x.den.val →
        (Round4.IntegerParameters.bits (t.promote s)).fits k.val →
        ¬ (Round4.IntegerParameters.bits (t.promote s)).fits (x.den.val * k.val) →
        JuliaLean.Statements.rational.Round17.HasError
          (JuliaLean.base.rational.integerRationalOpSource
            (Round6.nativePromotion t s)
            (fun a b => Round6.castInteger (Round6.promote_absorption_proven t s).2.2.1
              (JuliaLean.base.checked.checkedAddMixedBits a b)) k x))) ∧
    ((¬ ((Round4.IntegerParameters.bits (t.promote s)).fits x.den.val ∧
        (Round4.IntegerParameters.bits (t.promote s)).fits k.val) →
        JuliaLean.Statements.rational.Round17.HasError
          (JuliaLean.base.rational.integerRationalOpSource
            (Round6.nativePromotion t s)
            (fun a b => Round6.castInteger (Round6.promote_absorption_proven t s).2.2.1
              (JuliaLean.base.checked.checkedSubMixedBits a b)) k x)) ∧
      ((Round4.IntegerParameters.bits (t.promote s)).fits x.den.val →
        (Round4.IntegerParameters.bits (t.promote s)).fits k.val →
        ¬ (Round4.IntegerParameters.bits (t.promote s)).fits (x.den.val * k.val) →
        JuliaLean.Statements.rational.Round17.HasError
          (JuliaLean.base.rational.integerRationalOpSource
            (Round6.nativePromotion t s)
            (fun a b => Round6.castInteger (Round6.promote_absorption_proven t s).2.2.1
              (JuliaLean.base.checked.checkedSubMixedBits a b)) k x))) := by
  refine ⟨⟨?_, ?_⟩, ⟨?_, ?_⟩⟩
  · intro hnot
    exact integerRationalOpSource_mul_input_error t s
      (fun a b => Round6.castInteger (Round6.promote_absorption_proven t s).2.2.1
        (JuliaLean.base.checked.checkedAddMixedBits a b)) x k hnot
  · intro hden hk hprod
    exact integerRationalOpSource_mul_overflow_error t s
      (fun a b => Round6.castInteger (Round6.promote_absorption_proven t s).2.2.1
        (JuliaLean.base.checked.checkedAddMixedBits a b)) x k ⟨hden, hk⟩ hprod
  · intro hnot
    exact integerRationalOpSource_mul_input_error t s
      (fun a b => Round6.castInteger (Round6.promote_absorption_proven t s).2.2.1
        (JuliaLean.base.checked.checkedSubMixedBits a b)) x k hnot
  · intro hden hk hprod
    exact integerRationalOpSource_mul_overflow_error t s
      (fun a b => Round6.castInteger (Round6.promote_absorption_proven t s).2.2.1
        (JuliaLean.base.checked.checkedSubMixedBits a b)) x k ⟨hden, hk⟩ hprod

end JuliaLean.Proofs.base.rational.Round17

namespace JuliaLean.Proofs.base.rational.Round17
open JuliaLean JuliaLean.base.rational Round4
open JuliaLean.Proofs.base.rational.ComparisonAndRoundingLemmas
open JuliaLean.Proofs.base.rational.DivGcdCtorLemmas
private theorem mixed_chop_eq (sub : Bool) (t s : IntTy)
    (a : JInt (t.promote s)) (b : JInt t)
    (hb : (t.promote s).min ≤ b.val ∧ b.val ≤ (t.promote s).max) :
    Round6.castInteger (Round6.promote_absorption_proven t s).2.2.1
      (if sub then JuliaLean.base.checked.checkedSubMixedBits a b
      else JuliaLean.base.checked.checkedAddMixedBits a b) =
    (if sub then JuliaLean.base.checked.checkedSubBits a ⟨b.val, hb⟩
      else JuliaLean.base.checked.checkedAddBits a ⟨b.val, hb⟩) := by
  have hAbs := (Round6.promote_absorption_proven t s).2.2.1
  have ha := a.property
  cases sub <;>
    simp [JuliaLean.base.checked.checkedAddMixedBits, JuliaLean.base.checked.checkedSubMixedBits,
      JuliaLean.base.checked.checkedAddPromoted, JuliaLean.base.checked.checkedSubPromoted,
      JuliaLean.base.checked.promoteBits, JInt.convert, hAbs, ha, hb, Round6.castInteger]
  all_goals
    have map_id {α : Type} (e : Except JlError α) : Except.map id e = e := by cases e <;> rfl
    cases t <;> cases s <;> change Except.map id _ = _
    all_goals exact map_id _

private theorem scalar_late_outcomes (sub : Bool) (t s : IntTy)
    (x : Rat t) (k : JInt s) (hx : Normalized x)
    (hd : (IntegerParameters.bits (t.promote s)).fits x.den.val)
    (hk : (IntegerParameters.bits (t.promote s)).fits k.val)
    (hp : (IntegerParameters.bits (t.promote s)).fits (x.den.val*k.val))
    (hn : (IntegerParameters.bits (t.promote s)).fits x.num.val) :
    let p := IntegerParameters.bits (t.promote s)
    let result := if sub then x.den.val*k.val-x.num.val else x.den.val*k.val+x.num.val
    let run := integerRationalOpSource (Round6.nativePromotion t s)
      (fun a b => Round6.castInteger (Round6.promote_absorption_proven t s).2.2.1
        (if sub then JuliaLean.base.checked.checkedSubMixedBits a b
        else JuliaLean.base.checked.checkedAddMixedBits a b)) k x
    (¬ p.fits result → JuliaLean.Statements.rational.Round17.HasError run) ∧
    (p.fits result → ExactResult p run result x.den.val) := by
  intro p result run
  let m : PromotionParameters (.bits t) (.bits s) (.bits (t.promote s)) := .bits t s
  obtain ⟨a, ha, hav⟩ := ((prom_checkedMulXY_spec m x.den k).2 ⟨hd,hk⟩).1 hp
  change a.val = x.den.val*k.val at hav
  have ha' : (Round6.nativePromotion t s).checkedMulXY x.den k = .ok a := ha
  have hchop := mixed_chop_eq sub t s a x.num hn
  let b : JInt (t.promote s) := ⟨x.num.val,hn⟩
  have hop : JuliaLean.Proofs.base.checked.ExactOrOverflow
      (if sub then JuliaLean.base.checked.checkedSubBits a b
        else JuliaLean.base.checked.checkedAddBits a b) result := by
    cases sub
    · simpa only [Bool.false_eq_true, ↓reduceIte, result, hav] using
        JuliaLean.Proofs.base.checked.addExact (t.promote s) a b
    · simpa only [↓reduceIte, result, hav] using
        JuliaLean.Proofs.base.checked.subExact (t.promote s) a b
  unfold JuliaLean.Proofs.base.checked.ExactOrOverflow at hop
  constructor
  · intro hnot
    change ¬ ((t.promote s).min ≤ result ∧ result ≤ (t.promote s).max) at hnot
    rw [if_neg hnot] at hop
    cases hc : (if sub then JuliaLean.base.checked.checkedSubBits a b
        else JuliaLean.base.checked.checkedAddBits a b) with
    | error e =>
      refine ⟨e, ?_⟩
      simp [run, integerRationalOpSource, ha', hchop, show
        (if sub then JuliaLean.base.checked.checkedSubBits a ⟨x.num.val, hn⟩
        else JuliaLean.base.checked.checkedAddBits a ⟨x.num.val, hn⟩) = .error e from hc]
    | ok z => rw [hc] at hop; contradiction
  · intro hfit
    change (t.promote s).min ≤ result ∧ result ≤ (t.promote s).max at hfit
    rw [if_pos hfit] at hop
    obtain ⟨n,hcall,hnval⟩ := hop
    obtain ⟨d,hdcall,hdval⟩ := prom_promotePX_spec m n x.den hd
    have hdcall' : (Round6.nativePromotion t s).promotePX n x.den = .ok (n,d) := hdcall
    have hrun : run = .ok ⟨n,d⟩ := by
      simp [run, integerRationalOpSource, ha', hchop, show
        (if sub then JuliaLean.base.checked.checkedSubBits a ⟨x.num.val, hn⟩
        else JuliaLean.base.checked.checkedAddBits a ⟨x.num.val, hn⟩) = .ok n from hcall,
        unsafeRationalPromoteSource, hdcall', unsafeRationalSameSource_pair]
    change d.val = x.den.val at hdval
    refine ⟨⟨n,d⟩,hrun,?_,?_,?_,?_⟩
    · change 0 ≤ d.val ∧ Nat.gcd n.val.natAbs d.val.natAbs = 1
      rw [hnval,hdval]
      refine ⟨hx.1,?_⟩
      cases sub
      · have hg := gcd_sub_mul_coprime x.num.val x.den.val (-k.val) hx.2
        simpa [result, Int.mul_neg, Int.sub_neg, Int.add_comm] using hg
      · have hg := gcd_sub_mul_coprime x.num.val x.den.val k.val hx.2
        have heq : x.den.val*k.val-x.num.val = -(x.num.val-x.den.val*k.val) := by omega
        simpa [result,heq,Int.natAbs_neg] using hg
    · change n.val*x.den.val = result*d.val
      rw [hnval,hdval]
    · change x.den.val ≠ 0 → d.val > 0
      rw [hdval]; have := hx.1; omega
    · intro hd0
      change d.val = 0 ∧ intSign n.val = intSign result
      exact ⟨hdval.trans hd0,congrArg intSign hnval⟩

private theorem mixed_mul_eq (t s : IntTy)
    (a : JInt (t.promote s)) (b : JInt t)
    (hb : (t.promote s).min ≤ b.val ∧ b.val ≤ (t.promote s).max) :
    (Round6.nativePromotion t s).checkedMulPX a b =
      JuliaLean.base.checked.checkedMulBits a ⟨b.val,hb⟩ := by
  have hAbs := (Round6.promote_absorption_proven t s).2.2.1
  have ha := a.property
  simp [Round6.nativePromotion, Round6.castInteger,
    JuliaLean.base.checked.checkedMulMixedBits, JuliaLean.base.checked.checkedMulPromoted,
    JuliaLean.base.checked.promoteBits, JInt.convert, hAbs, ha, hb]
  have map_id {α : Type} (e : Except JlError α) : Except.map id e = e := by cases e <;> rfl
  cases t <;> cases s <;> change Except.map id _ = _
  all_goals exact map_id _

private theorem mul_left_nonzero (t s : IntTy) (x : Rat t) (k : JInt s)
    (hx : Normalized x)
    (hk : (IntegerParameters.bits (t.promote s)).fits k.val)
    (hd : (IntegerParameters.bits (t.promote s)).fits x.den.val)
    (hg : (Nat.gcd k.val.natAbs x.den.val.natAbs : Int) ≠ 0) :
    let p := IntegerParameters.bits (t.promote s)
    let g : Int := Nat.gcd k.val.natAbs x.den.val.natAbs
    let run := mulIntRatSource (Round6.nativePromotion t s) promoteIntegerPairYX (dg p p) k x
    (¬ p.fits x.num.val → JuliaLean.Statements.rational.Round17.HasError run) ∧
    (p.fits x.num.val →
      (p.fits (k.val.tdiv g*x.num.val) → ExactResult p run (k.val*x.num.val) x.den.val) ∧
      (¬ p.fits (k.val.tdiv g*x.num.val) → JuliaLean.Statements.rational.Round17.HasError run)) := by
  intro p g run
  let kp : JInt (t.promote s) := ⟨k.val,hk⟩
  let dp : JInt (t.promote s) := ⟨x.den.val,hd⟩
  have hprom : promoteIntegerPairYX k x.den = .ok (kp,dp) := by
    simp [promoteIntegerPairYX, JuliaLean.Proofs.base.rational.CoreLemmas.convert_of_fits hk,
      JuliaLean.Proofs.base.rational.CoreLemmas.convert_of_fits hd, kp, dp]
  obtain ⟨a,b,hdg,hav,hbv,haabs,hbabs,hcop,hamul,hbmul,_,_,_⟩ :=
    (JuliaLean.Proofs.base.rational.DivGcdCtorLemmas.dgBits_spec kp dp).2 hg
  have hbase : run = (do
      let n ← (Round6.nativePromotion t s).checkedMulPX a x.num
      pure (unsafeRationalSameSource n b)) := by
    simp [run,mulIntRatSource,hprom,show dg p p = JuliaLean.Proofs.base.rational.DivGcdCtorLemmas.dgBits from rfl,hdg]
  change a.val = k.val.tdiv g at hav
  change b.val = x.den.val.tdiv g at hbv
  change a.val*g = k.val at hamul
  change b.val*g = x.den.val at hbmul
  have hgpos : 0 < g := by dsimp [g]; omega
  constructor
  · intro hn
    have hAbs := (Round6.promote_absorption_proven t s).2.2.1
    have ha := a.property
    have hnot : ¬ ((t.promote s).min ≤ x.num.val ∧ x.num.val ≤ (t.promote s).max) := hn
    refine ⟨.inexactError (t.promote s).name,?_⟩
    simp [hbase,Round6.nativePromotion,Round6.castInteger,
      JuliaLean.base.checked.checkedMulMixedBits,JuliaLean.base.checked.checkedMulPromoted,
      JuliaLean.base.checked.promoteBits,JInt.convert,hAbs,ha,hnot]
  · intro hn
    have hm := JuliaLean.Proofs.base.checked.mulExact (t.promote s) a ⟨x.num.val,hn⟩
    unfold JuliaLean.Proofs.base.checked.ExactOrOverflow at hm
    rw [hav] at hm
    rw [hbase,mixed_mul_eq t s a x.num hn]
    constructor
    · intro hfit
      change (t.promote s).min ≤ k.val.tdiv g*x.num.val ∧ k.val.tdiv g*x.num.val ≤ (t.promote s).max at hfit
      rw [if_pos hfit] at hm
      obtain ⟨n,hncall,hnval⟩ := hm
      refine ⟨⟨n,b⟩,by simp [hncall,unsafeRationalSameSource_pair],?_⟩
      have hbnn : 0 ≤ b.val := by
        have h := (JuliaLean.Proofs.base.int.tdiv_between x.den.val g hgpos).1 hx.1
        rw [hbv]; exact h.1
      have hnorm : Canonical p (⟨n,b⟩ : Rational (JInt (t.promote s))) := by
        change 0 ≤ b.val ∧ Nat.gcd n.val.natAbs b.val.natAbs = 1
        refine ⟨hbnn,?_⟩
        rw [hnval,← hav,Int.natAbs_mul]
        exact Nat.Coprime.mul_left hcop
          (Nat.Coprime.coprime_dvd_right (by
            rw [hbabs]; exact Nat.div_dvd_of_dvd (Nat.gcd_dvd_right _ _)) hx.2)
      have hrep : Represents p (⟨n,b⟩ : Rational (JInt (t.promote s))) n.val b.val :=
        ⟨hnorm,rfl,fun hz => by change 0 < b.val; omega,fun hz => ⟨hz,rfl⟩⟩
      have hscaled := represents_scale_pos hgpos hrep
      have hnscale : n.val*g = k.val*x.num.val := by
        rw [hnval,← hav,Int.mul_right_comm a.val x.num.val g,hamul]
      simpa only [hnscale,hbmul] using hscaled
    · intro hnot
      change ¬ ((t.promote s).min ≤ k.val.tdiv g*x.num.val ∧ k.val.tdiv g*x.num.val ≤ (t.promote s).max) at hnot
      rw [if_neg hnot] at hm
      cases hc : JuliaLean.base.checked.checkedMulBits a ⟨x.num.val,hn⟩ with
      | error e => exact ⟨e,by simp [hc]⟩
      | ok z => rw [hc] at hm; contradiction

theorem mixed_left_value_proven : JuliaLean.Statements.rational.Round17.mixed_left_value := by
  intro t s x k hx p prom addL subL mulL prod g
  have hearly := integer_left_add_sub_early_errors t s x k
  have hnum := integer_left_add_sub_num_errors t s x k
  refine ⟨⟨?_,?_⟩,integer_left_mul_promotion_error t s x k,?_⟩
  · refine ⟨hearly.1.1,hearly.1.2,hnum.1,?_,?_⟩
    · intro hd hk hp hn hr
      exact (scalar_late_outcomes false t s x k hx hd hk hp hn).1 hr
    · intro hd hk hp hn hr
      exact (scalar_late_outcomes false t s x k hx hd hk hp hn).2 hr
  · refine ⟨hearly.2.1,hearly.2.2,hnum.2,?_,?_⟩
    · intro hd hk hp hn hr
      exact (scalar_late_outcomes true t s x k hx hd hk hp hn).1 hr
    · intro hd hk hp hn hr
      exact (scalar_late_outcomes true t s x k hx hd hk hp hn).2 hr
  · intro hk hd
    exact ⟨integer_left_mul_gcd_zero_error t s x k,
      fun hg => mul_left_nonzero t s x k hx hk hd hg⟩

end JuliaLean.Proofs.base.rational.Round17

namespace JuliaLean.Proofs.base.rational.Round11
open JuliaLean JuliaLean.base.rational Round4
open JuliaLean.Proofs.base.rational.DivGcdCtorLemmas
open JuliaLean.Proofs.base.int
private theorem opsP_mul_eq {T U P : Type} {i : IntegerParameters T} {j : IntegerParameters U}
    {p : IntegerParameters P} (m : PromotionParameters i j p) :
    m.prom.opsP.checkedMul = p.ops.checkedMul := by cases m <;> rfl
set_option maxHeartbeats 2000000 in
 theorem multiplication_exact_proven : JuliaLean.Statements.rational.Round11.multiplication_exact := by
  intro T U P i j p m x y hx hy cv g1 g2 n d run
  have hden := den_fits_of_canonical i j p m x y hx hy
  have hp1 := prom_promote_spec m x.num y.den
  have hp2 := prom_promote_spec m x.den y.num
  constructor
  · intro hnot
    by_cases hpair : FitsPair p (rn i x) (rd j y)
    · obtain ⟨a,b,hp,ha,hb⟩ := hp1.1 hpair
      have hpair2 : ¬ FitsPair p (rd i x) (rn j y) := by
        intro h; exact hnot ⟨hpair.1,h.1,h.2,hpair.2⟩
      obtain ⟨msg,herr⟩ := hp2.2 hpair2
      cases hdg : dg p p a b with
      | error e => exact ⟨e,by simp [run,mulRatRatSource,hp,hdg]⟩
      | ok ab => exact ⟨.inexactError msg,by simp [run,mulRatRatSource,hp,hdg,herr]⟩
    · obtain ⟨msg,herr⟩ := hp1.2 hpair
      exact ⟨.inexactError msg,by simp [run,mulRatRatSource,herr]⟩
  · intro hcv
    obtain ⟨a,b,hp,ha,hb⟩ := hp1.1 ⟨hcv.1,hcv.2.2.2⟩
    obtain ⟨c,e,hp',hc,he⟩ := hp2.1 ⟨hcv.2.1,hcv.2.2.1⟩
    cases p with | bits pt =>
    change a.val = rn i x at ha
    change b.val = rd j y at hb
    change c.val = rd i x at hc
    change e.val = rn j y at he
    have hg1 : (Nat.gcd a.val.natAbs b.val.natAbs : Int) = g1 := by dsimp [g1]; rw [ha,hb]
    have hg2 : (Nat.gcd c.val.natAbs e.val.natAbs : Int) = g2 := by dsimp [g2]; rw [hc,he]
    have hdgeq : dg (.bits pt) (.bits pt) = dgBits := rfl
    constructor
    · intro hzero
      rcases hzero with h1 | h2
      · exact ⟨.divideError,by simp [run,mulRatRatSource,hp,hdgeq,(dgBits_spec a b).1 (hg1.trans h1)]⟩
      · by_cases h1 : g1 = 0
        · exact ⟨.divideError,by simp [run,mulRatRatSource,hp,hdgeq,(dgBits_spec a b).1 (hg1.trans h1)]⟩
        · obtain ⟨an,bd,hcall,_,_,_,_,_,_,_,_,_,_⟩ := (dgBits_spec a b).2 (by rw [hg1]; exact h1)
          exact ⟨.divideError,by simp [run,mulRatRatSource,hp,hp',hdgeq,hcall,(dgBits_spec c e).1 (hg2.trans h2)]⟩
    · intro h1 h2
      obtain ⟨an,bd,hcall,han,hbd,hana,hbda,hcop1,ham,hbm,_,_,_⟩ := (dgBits_spec a b).2 (by rw [hg1]; exact h1)
      obtain ⟨cd,en,hcall',hcd,hen,hcda,hena,hcop2,hcm,hem,_,_,_⟩ := (dgBits_spec c e).2 (by rw [hg2]; exact h2)
      rw [hg1,ha] at han ham
      rw [hg1,hb] at hbd hbm
      rw [hg2,hc] at hcd hcm
      rw [hg2,he] at hen hem
      have hn : an.val*en.val = n := by dsimp [n]; rw [han,hen]
      have hd : cd.val*bd.val = d := by dsimp [d]; rw [hcd,hbd]
      have hbase : run = (do
          let num ← JuliaLean.base.checked.checkedMulBits an en
          let den ← JuliaLean.base.checked.checkedMulBits cd bd
          pure (unsafeRationalSameSource num den)) := by
        simp [run,mulRatRatSource,hp,hp',hdgeq,hcall,hcall',opsP_mul_eq m,
          IntegerParameters.ops,jintOps,JuliaLean.base.rational.checkedMul]
      have hmn := JuliaLean.Proofs.base.checked.mulExact pt an en
      have hmd := JuliaLean.Proofs.base.checked.mulExact pt cd bd
      unfold JuliaLean.Proofs.base.checked.ExactOrOverflow at hmn hmd
      rw [hn] at hmn
      rw [hd] at hmd
      constructor
      · intro hfit
        change (pt.min ≤ n ∧ n ≤ pt.max) ∧ (pt.min ≤ d ∧ d ≤ pt.max) at hfit
        rw [if_pos hfit.1] at hmn
        rw [if_pos hfit.2] at hmd
        obtain ⟨num,hnum,hnumval⟩ := hmn
        obtain ⟨den,hden,hdenval⟩ := hmd
        refine ⟨⟨num,den⟩,by simp [hbase,hnum,hden,unsafeRationalSameSource_pair],?_⟩
        have hg1pos : 0 < g1 := by dsimp [g1]; omega
        have hg2pos : 0 < g2 := by dsimp [g2]; omega
        have hcdnn : 0 ≤ cd.val := by
          rw [hcd]; exact ((tdiv_between (rd i x) g2 hg2pos).1 hx.1).1
        have hbdnn : 0 ≤ bd.val := by
          rw [hbd]; exact ((tdiv_between (rd j y) g1 hg1pos).1 hy.1).1
        have hdn : 0 ≤ den.val := by rw [hdenval,← hd]; exact Int.mul_nonneg hcdnn hbdnn
        have hcopx : Nat.Coprime an.val.natAbs cd.val.natAbs :=
          (Nat.Coprime.coprime_dvd_left (by rw [hana,ha]; exact Nat.div_dvd_of_dvd (Nat.gcd_dvd_left _ _)) hx.2).coprime_dvd_right
            (by rw [hcda,hc]; exact Nat.div_dvd_of_dvd (Nat.gcd_dvd_left _ _))
        have hcopy : Nat.Coprime en.val.natAbs bd.val.natAbs :=
          (Nat.Coprime.coprime_dvd_left (by rw [hena,he]; exact Nat.div_dvd_of_dvd (Nat.gcd_dvd_right _ _)) hy.2).coprime_dvd_right
            (by rw [hbda,hb]; exact Nat.div_dvd_of_dvd (Nat.gcd_dvd_right _ _))
        have hnorm : Canonical (.bits pt) (⟨num,den⟩ : Rat pt) := by
          change 0 ≤ den.val ∧ Nat.gcd num.val.natAbs den.val.natAbs = 1
          refine ⟨hdn,?_⟩
          rw [hnumval,hdenval,← hn,← hd,Int.natAbs_mul,Int.natAbs_mul]
          exact Nat.Coprime.mul_left (Nat.Coprime.mul_right hcopx hcop1)
            (Nat.Coprime.mul_right (Nat.Coprime.symm hcop2) hcopy)
        have hrep : Represents (.bits pt) (⟨num,den⟩ : Rat pt) num.val den.val :=
          ⟨hnorm,rfl,fun hz => by change 0 < den.val; omega,fun hz => ⟨hz,rfl⟩⟩
        have hs := represents_scale_pos (Int.mul_pos hg1pos hg2pos) hrep
        have hnscale : num.val*(g1*g2) = rn i x*rn j y := by
          rw [hnumval,← hn,← ham,← hem]; ac_rfl
        have hdscale : den.val*(g1*g2) = rd i x*rd j y := by
          rw [hdenval,← hd,← hcm,← hbm]; ac_rfl
        simpa only [hnscale,hdscale] using hs
      · intro hnot
        by_cases hfn : pt.min ≤ n ∧ n ≤ pt.max
        · rw [if_pos hfn] at hmn
          obtain ⟨num,hnum,_⟩ := hmn
          have hfd : ¬ (IntegerParameters.bits pt).fits d := fun h => hnot ⟨hfn,h⟩
          change ¬ (pt.min ≤ d ∧ d ≤ pt.max) at hfd
          rw [if_neg hfd] at hmd
          cases hden : JuliaLean.base.checked.checkedMulBits cd bd with
          | error e => exact ⟨e,by simp [hbase,hnum,hden]⟩
          | ok den => rw [hden] at hmd; contradiction
        · rw [if_neg hfn] at hmn
          cases hnum : JuliaLean.base.checked.checkedMulBits an en with
          | error e => exact ⟨e,by simp [hbase,hnum]⟩
          | ok num => rw [hnum] at hmn; contradiction
end JuliaLean.Proofs.base.rational.Round11

namespace JuliaLean.Proofs.base.rational.FmaProof
open JuliaLean JuliaLean.base.rational Round5
open JuliaLean.Proofs.base.rational.DivGcdCtorLemmas
open JuliaLean.Proofs.base.int
open JuliaLean.Statements.rational.Round12.Fma
private theorem promoteR_spec {T U P : Type} (i : IntegerParameters T) (j : IntegerParameters U)
    (p : IntegerParameters P) (m : PromotionParameters i j p) (x : Rational T) (y : Rational U) :
    (Converts i j p x y → ∃ xp yp, promoteR m x y = .ok (xp,yp) ∧
      rn p xp = rn i x ∧ rd p xp = rd i x ∧ rn p yp = rn j y ∧ rd p yp = rd j y) ∧
    (¬ Converts i j p x y → IsInexact (promoteR m x y)) := by
  cases m with
  | same i => cases i with | bits t => exact Round4.promoteR_spec (.bits t) (.bits t) (.bits t) (.same _) x y
  | bits t s => exact Round4.promoteR_spec (.bits t) (.bits s) (.bits (t.promote s)) (.bits t s) x y

private theorem prom_promote_spec {T U P : Type} {i : IntegerParameters T} {j : IntegerParameters U}
    {p : IntegerParameters P} (m : PromotionParameters i j p) (a : T) (b : U) :
    (FitsPair p (val i a) (val j b) →
      ∃ pa pb, m.prom.promote a b = .ok (pa,pb) ∧ val p pa = val i a ∧ val p pb = val j b) ∧
    (¬ FitsPair p (val i a) (val j b) → IsInexact (m.prom.promote a b)) := by
  cases m with
  | same i => cases i with | bits t => exact Round4.prom_promote_spec (.same (.bits t)) a b
  | bits t s => exact Round4.prom_promote_spec (.bits t s) a b

private theorem prom_checkedMulXP_spec {T U P : Type} {i : IntegerParameters T} {j : IntegerParameters U}
    {p : IntegerParameters P} (m : PromotionParameters i j p) (a : T) (v : P)
    (ha : p.fits (val i a)) :
    (p.fits (val i a*val p v) →
      ∃ r, m.prom.checkedMulXP a v = .ok r ∧ val p r = val i a*val p v) ∧
    (¬ p.fits (val i a*val p v) → IsOverflow (m.prom.checkedMulXP a v)) := by
  cases m with
  | same i => cases i with | bits t => exact Round4.prom_checkedMulXP_spec (.same (.bits t)) a v ha
  | bits t s => exact Round4.prom_checkedMulXP_spec (.bits t s) a v ha

private theorem prom_checkedMulYP_spec {T U P : Type} {i : IntegerParameters T} {j : IntegerParameters U}
    {p : IntegerParameters P} (m : PromotionParameters i j p) (b : U) (v : P)
    (hb : p.fits (val j b)) :
    (p.fits (val j b*val p v) →
      ∃ r, m.prom.checkedMulYP b v = .ok r ∧ val p r = val j b*val p v) ∧
    (¬ p.fits (val j b*val p v) → IsOverflow (m.prom.checkedMulYP b v)) := by
  cases m with
  | same i => cases i with | bits t => exact Round4.prom_checkedMulYP_spec (.same (.bits t)) b v hb
  | bits t s => exact Round4.prom_checkedMulYP_spec (.bits t s) b v hb

private theorem opsP_checkedAdd_spec {T U P : Type} {i : IntegerParameters T} {j : IntegerParameters U}
    {p : IntegerParameters P} (m : PromotionParameters i j p) (a b : P) :
    (p.fits (val p a+val p b) →
      ∃ r, m.prom.opsP.checkedAdd a b = .ok r ∧ val p r = val p a+val p b) ∧
    (¬ p.fits (val p a+val p b) → IsOverflow (m.prom.opsP.checkedAdd a b)) := by
  cases m with
  | same i => cases i with | bits t => exact Round4.opsP_checkedAdd_spec (.same (.bits t)) a b
  | bits t s => exact Round4.opsP_checkedAdd_spec (.bits t s) a b

private theorem rational_pos_den_exact {T : Type} (p : IntegerParameters T) (n d : T)
    (hd : val p d > 0) : ExactResult p (rational p n d) (val p n) (val p d) := by
  cases p with | bits t => exact Round4.rational_pos_den_exact (.bits t) n d hd

private theorem represents_scale_pos {T : Type} {p : IntegerParameters T} {q : Rational T}
    {n d g : Int} (hg : 0 < g) (hrep : Represents p q n d) :
    Represents p q (n*g) (d*g) := by
  cases p with | bits t => exact Round4.represents_scale_pos (p := .bits t) (q := q) hg hrep

private theorem eqR_true {T U : Type} (i : IntegerParameters T) (j : IntegerParameters U)
    (x : Rational T) (y : Rational U) :
    eqR i j x y = true ↔ rd i x = rd j y ∧ rn i x = rn j y := by
  cases i with | bits t =>
  cases j with | bits s =>
  have hd : integerEq (.bits t) (.bits s) x.den y.den = decide (x.den.val = y.den.val) :=
    JuliaLean.Proofs.base.int.eq_eq x.den y.den
  have hn : integerEq (.bits t) (.bits s) x.num y.num = decide (x.num.val = y.num.val) :=
    JuliaLean.Proofs.base.int.eq_eq x.num y.num
  simp only [eqR,eqRatSource,hd,hn]
  change bwand (decide (x.den.val = y.den.val)) (decide (x.num.val = y.num.val)) = true ↔
    x.den.val = y.den.val ∧ x.num.val = y.num.val
  by_cases hd : x.den.val = y.den.val <;> by_cases hn : x.num.val = y.num.val <;> simp [hd,hn,bwand]
private theorem constructor_any {T : Type} (p : IntegerParameters T) (n d : T) :
    ConstructorOutcomeAny p (rational p n d) (val p n) (val p d) := by
  cases p with | bits pt =>
  have h : ConstructorContract (.bits pt) (rational (.bits pt) n d) n.val d.val :=
    Round4.native_constructor_aux pt n d
  unfold ConstructorContract at h
  unfold ConstructorOutcomeAny
  refine ⟨?_,?_,?_,?_⟩
  · intro hg; obtain ⟨msg,he⟩ := h.1 hg; exact ⟨_,he⟩
  · intro hg hn; obtain ⟨msg,he⟩ := h.2.1 hg hn; exact ⟨_,he⟩
  · intro hg hn hc; obtain ⟨msg,he⟩ := h.2.2.1 hg hn hc; exact ⟨_,he⟩
  · intro hg hn hc
    refine ⟨(h.2.2.2 hg hn hc).1,?_⟩
    intro hh; obtain ⟨msg,he⟩ := (h.2.2.2 hg hn hc).2 hh; exact ⟨_,he⟩

set_option maxHeartbeats 2000000 in
private theorem add_execution {T U P : Type} (i : IntegerParameters T) (j : IntegerParameters U)
    (p : IntegerParameters P) (m : PromotionParameters i j p) (x : Rational T) (y : Rational U)
    (hcv : Converts i j p x y)
    (hg : (Nat.gcd (rd i x).natAbs (rd j y).natAbs : Int) ≠ 0) :
    let g : Int := Nat.gcd (rd i x).natAbs (rd j y).natAbs
    let a := rn i x*(rd j y).tdiv g
    let b := rn j y*(rd i x).tdiv g
    let d := rd i x*(rd j y).tdiv g
    let safe := p.fits a ∧ p.fits b ∧ p.fits (a+b) ∧ p.fits d
    (safe → ∃ n den, add m x y = rational p n den ∧ val p n = a+b ∧ val p den = d) ∧
    (¬ safe → JuliaLean.Statements.rational.Round12.HasError (add m x y)) := by
  intro g a b d safe
  obtain ⟨xp,yp,hpr,_,_,_,_⟩ := (promoteR_spec i j p m x y).1 hcv
  obtain ⟨xdP,ydP,hp,hxdp,hydp⟩ := (prom_promote_spec m x.den y.den).1 ⟨hcv.2.1,hcv.2.2.2⟩
  have hshortcut : (decide (rd i x = 0) && eqR i j x y) = false := by
    apply Bool.eq_false_iff.mpr
    intro hh
    have hh' : rd i x = 0 ∧ eqR i j x y = true := by simpa only [Bool.and_eq_true,decide_eq_true_eq] using hh
    obtain ⟨hx0,he⟩ := hh'
    have hy0 := (eqR_true i j x y).mp he |>.1
    apply hg
    simp [hx0,← hy0]
  cases p with | bits pt =>
  change xdP.val = rd i x at hxdp
  change ydP.val = rd j y at hydp
  have hgeq : (Nat.gcd xdP.val.natAbs ydP.val.natAbs : Int) = g := by dsimp [g]; rw [hxdp,hydp]
  obtain ⟨xd,yd,hdg,hxd,hyd,_,_,_,_,_,_,_,_⟩ := (dgBits_spec xdP ydP).2 (by rw [hgeq]; exact hg)
  rw [hgeq,hxdp] at hxd
  rw [hgeq,hydp] at hyd
  have hbase : add m x y = (do
      let av ← m.prom.checkedMulXP x.num yd
      let bv ← m.prom.checkedMulYP y.num xd
      let nv ← m.prom.opsP.checkedAdd av bv
      let dv ← m.prom.checkedMulXP x.den yd
      rational (.bits pt) nv dv) := by
    simp [add,addRatSource,hpr,hshortcut,hp,show dg (.bits pt) (.bits pt) = dgBits from rfl,hdg]
  have hma := prom_checkedMulXP_spec m x.num yd hcv.1
  have hmb := prom_checkedMulYP_spec m y.num xd hcv.2.2.1
  have hmd := prom_checkedMulXP_spec m x.den yd hcv.2.1
  change (((IntegerParameters.bits pt).fits (rn i x*yd.val) →
    ∃ r, m.prom.checkedMulXP x.num yd = .ok r ∧ val (.bits pt) r = rn i x*yd.val) ∧
    (¬ (IntegerParameters.bits pt).fits (rn i x*yd.val) → _)) at hma
  change (((IntegerParameters.bits pt).fits (rn j y*xd.val) →
    ∃ r, m.prom.checkedMulYP y.num xd = .ok r ∧ val (.bits pt) r = rn j y*xd.val) ∧
    (¬ (IntegerParameters.bits pt).fits (rn j y*xd.val) → _)) at hmb
  change (((IntegerParameters.bits pt).fits (rd i x*yd.val) →
    ∃ r, m.prom.checkedMulXP x.den yd = .ok r ∧ val (.bits pt) r = rd i x*yd.val) ∧
    (¬ (IntegerParameters.bits pt).fits (rd i x*yd.val) → _)) at hmd
  rw [hyd] at hma hmd
  rw [hxd] at hmb
  constructor
  · intro hs
    obtain ⟨av,ha,hav⟩ := hma.1 hs.1
    obtain ⟨bv,hb,hbv⟩ := hmb.1 hs.2.1
    have hsum := opsP_checkedAdd_spec m av bv
    rw [hav,hbv] at hsum
    obtain ⟨nv,hn,hnv⟩ := hsum.1 hs.2.2.1
    obtain ⟨dv,hd,hdv⟩ := hmd.1 hs.2.2.2
    exact ⟨nv,dv,by simp [hbase,ha,hb,hn,hd],hnv,hdv⟩
  · intro hnot
    by_cases hfa : (IntegerParameters.bits pt).fits a
    · obtain ⟨av,ha,hav⟩ := hma.1 hfa
      by_cases hfb : (IntegerParameters.bits pt).fits b
      · obtain ⟨bv,hb,hbv⟩ := hmb.1 hfb
        have hsum := opsP_checkedAdd_spec m av bv
        rw [hav,hbv] at hsum
        by_cases hfn : (IntegerParameters.bits pt).fits (a+b)
        · obtain ⟨nv,hn,_⟩ := hsum.1 hfn
          have hfd : ¬ (IntegerParameters.bits pt).fits d := fun h => hnot ⟨hfa,hfb,hfn,h⟩
          obtain ⟨msg,he⟩ := hmd.2 hfd
          exact ⟨.overflowError msg,by simp [hbase,ha,hb,hn,he]⟩
        · obtain ⟨msg,he⟩ := hsum.2 hfn
          exact ⟨.overflowError msg,by simp [hbase,ha,hb,he]⟩
      · obtain ⟨msg,he⟩ := hmb.2 hfb
        exact ⟨.overflowError msg,by simp [hbase,ha,he]⟩
    · obtain ⟨msg,he⟩ := hma.2 hfa
      exact ⟨.overflowError msg,by simp [hbase,he]⟩

private theorem add_outcome {T U P : Type} (i : IntegerParameters T) (j : IntegerParameters U)
    (p : IntegerParameters P) (m : PromotionParameters i j p) (x : Rational T) (y : Rational U)
    (hx : Canonical i x) (_hy : Canonical j y) :
    AddOutcomeAny i j p x y (add m x y) := by
  unfold AddOutcomeAny
  dsimp only
  constructor
  · intro hnot
    obtain ⟨msg,he⟩ := (promoteR_spec i j p m x y).2 hnot
    exact ⟨.inexactError msg,by simp [add,addRatSource,he]⟩
  constructor
  · intro hcv hg
    have hgNat : Nat.gcd (rd i x).natAbs (rd j y).natAbs = 0 := by omega
    have hzero := Nat.gcd_eq_zero_iff.mp hgNat
    have hx0 : rd i x = 0 := by have := hzero.1; omega
    have hy0 : rd j y = 0 := by have := hzero.2; omega
    obtain ⟨xp,yp,hpr,hxn,hxd,_,_⟩ := (promoteR_spec i j p m x y).1 hcv
    constructor
    · intro heq
      have heqb := (eqR_true i j x y).mpr ⟨hx0.trans hy0.symm,heq⟩
      refine ⟨xp,by simp [add,addRatSource,hpr,hx0,heqb],?_,?_,?_,?_⟩
      · unfold Canonical; rw [hxn,hxd]; exact hx
      · rw [hxd,hx0]; simp
      · intro hh; contradiction
      · intro _
        exact ⟨hxd.trans hx0,congrArg intSign hxn⟩
    · intro hne
      have heqb : eqR i j x y = false := Bool.eq_false_iff.mpr (fun h => hne ((eqR_true i j x y).mp h).2)
      obtain ⟨a,b,hp,ha,hb⟩ := (prom_promote_spec m x.den y.den).1 ⟨hcv.2.1,hcv.2.2.2⟩
      cases p with | bits pt =>
      have hga : (Nat.gcd a.val.natAbs b.val.natAbs : Int) = 0 := by
        change a.val = rd i x at ha
        change b.val = rd j y at hb
        rw [ha,hb,hx0,hy0]; decide
      exact ⟨.divideError,by simp [add,addRatSource,hpr,heqb,hp,
        show dg (.bits pt) (.bits pt) = dgBits from rfl,(dgBits_spec a b).1 hga]⟩
  · intro hcv hg
    have he := add_execution i j p m x y hcv hg
    constructor
    · intro hs
      obtain ⟨n,d,hr,hn,hd⟩ := he.1 hs
      rw [hr,← hn,← hd]
      exact constructor_any p n d
    · exact he.2

private theorem add_finite_success {T U P : Type} (i : IntegerParameters T) (j : IntegerParameters U)
    (p : IntegerParameters P) (m : PromotionParameters i j p) (x : Rational T) (y : Rational U)
    (hx : Canonical i x) (hy : Canonical j y)
    (hxp : rd i x > 0) (hyp : rd j y > 0)
    (q : Rational P) (hrun : add m x y = .ok q) :
    Represents p q (rn i x*rd j y+rn j y*rd i x) (rd i x*rd j y) := by
  have hcv : Converts i j p x y := by
    apply Classical.byContradiction; intro hn
    obtain ⟨e,he⟩ := (add_outcome i j p m x y hx hy).1 hn
    rw [hrun] at he; contradiction
  let gN := Nat.gcd (rd i x).natAbs (rd j y).natAbs
  let g : Int := gN
  have hgpos : 0 < g := by
    exact Int.natCast_pos.mpr (Nat.gcd_pos_of_pos_left _ (Int.natAbs_pos.mpr (by omega)))
  have hg : g ≠ 0 := by omega
  have he := add_execution i j p m x y hcv hg
  have hs : p.fits (rn i x*(rd j y).tdiv g) ∧
      p.fits (rn j y*(rd i x).tdiv g) ∧
      p.fits (rn i x*(rd j y).tdiv g + rn j y*(rd i x).tdiv g) ∧
      p.fits (rd i x*(rd j y).tdiv g) := by
    apply Classical.byContradiction; intro hn
    obtain ⟨e,herr⟩ := he.2 hn
    rw [hrun] at herr; contradiction
  obtain ⟨n,d,hcall,hn,hd⟩ := he.1 hs
  have hxmul : (rd i x).tdiv g*g = rd i x := tdiv_mul_cancel_of_dvd _ _ (Nat.gcd_dvd_left _ _)
  have hymul : (rd j y).tdiv g*g = rd j y := tdiv_mul_cancel_of_dvd _ _ (Nat.gcd_dvd_right _ _)
  have hydiv : 0 < (rd j y).tdiv g := by
    have hnn := ((tdiv_between (rd j y) g hgpos).1 (by omega)).1
    have hnz : (rd j y).tdiv g ≠ 0 := by intro hz; rw [hz,Int.zero_mul] at hymul; omega
    omega
  have hdp : val p d > 0 := by rw [hd]; exact Int.mul_pos hxp hydiv
  obtain ⟨r,hr,hrep⟩ := rational_pos_den_exact p n d hdp
  have hrq : r = q := by rw [hcall,hr] at hrun; exact Except.ok.inj hrun
  subst r
  have hscaled := represents_scale_pos hgpos hrep
  have hnscale : val p n*g = rn i x*rd j y+rn j y*rd i x := by
    rw [hn,Int.add_mul,Int.mul_assoc,Int.mul_assoc,hymul,hxmul]
  have hdscale : val p d*g = rd i x*rd j y := by rw [hd,Int.mul_assoc,hymul]
  simpa only [hnscale,hdscale] using hscaled

private theorem multiplication_contract {T U P : Type} (i : IntegerParameters T) (j : IntegerParameters U)
    (p : IntegerParameters P) (m : PromotionParameters i j p) (x : Rational T) (y : Rational U)
    (hx : Canonical i x) (hy : Canonical j y) :
    let cv := Converts i j p x y
    let g1 : Int := Nat.gcd (rn i x).natAbs (rd j y).natAbs
    let g2 : Int := Nat.gcd (rd i x).natAbs (rn j y).natAbs
    let n := (rn i x).tdiv g1*(rn j y).tdiv g2
    let d := (rd i x).tdiv g2*(rd j y).tdiv g1
    let run := mulRatRatSource m.prom (dg p p) x y
    (¬ cv → JuliaLean.Statements.rational.Round12.HasError run) ∧
    (cv → (g1 = 0 ∨ g2 = 0 → JuliaLean.Statements.rational.Round12.HasError run) ∧
      (g1 ≠ 0 → g2 ≠ 0 →
        (FitsPair p n d → ExactResult p run (rn i x*rn j y) (rd i x*rd j y)) ∧
        (¬ FitsPair p n d → JuliaLean.Statements.rational.Round12.HasError run))) := by
  cases m with
  | same i => cases i with | bits t =>
    exact Round11.multiplication_exact_proven (.bits t) (.bits t) (.bits t) (.same _) x y hx hy
  | bits t s =>
    exact Round11.multiplication_exact_proven (.bits t) (.bits s) (.bits (t.promote s)) (.bits t s) x y hx hy

private theorem multiplication_success {T U P : Type} (i : IntegerParameters T) (j : IntegerParameters U)
    (p : IntegerParameters P) (m : PromotionParameters i j p) (x : Rational T) (y : Rational U)
    (hx : Canonical i x) (hy : Canonical j y) (q : Rational P)
    (hrun : mulRatRatSource m.prom (dg p p) x y = .ok q) :
    Represents p q (rn i x*rn j y) (rd i x*rd j y) := by
  have h := multiplication_contract i j p m x y hx hy
  have cv : Converts i j p x y := by
    apply Classical.byContradiction; intro hn
    obtain ⟨e,he⟩ := h.1 hn
    rw [hrun] at he; contradiction
  have hg : (Nat.gcd (rn i x).natAbs (rd j y).natAbs : Int) ≠ 0 ∧
      (Nat.gcd (rd i x).natAbs (rn j y).natAbs : Int) ≠ 0 := by
    constructor
    · intro hn
      obtain ⟨e,he⟩ := (h.2 cv).1 (Or.inl hn)
      rw [hrun] at he; contradiction
    · intro hn
      obtain ⟨e,he⟩ := (h.2 cv).1 (Or.inr hn)
      rw [hrun] at he; contradiction
  have hfit : FitsPair p
      ((rn i x).tdiv (Nat.gcd (rn i x).natAbs (rd j y).natAbs : Int) *
       (rn j y).tdiv (Nat.gcd (rd i x).natAbs (rn j y).natAbs : Int))
      ((rd i x).tdiv (Nat.gcd (rd i x).natAbs (rn j y).natAbs : Int) *
       (rd j y).tdiv (Nat.gcd (rn i x).natAbs (rd j y).natAbs : Int)) := by
    apply Classical.byContradiction; intro hn
    obtain ⟨e,he⟩ := ((h.2 cv).2 hg.1 hg.2).2 hn
    rw [hrun] at he; contradiction
  obtain ⟨r,hr,hrep⟩ := ((h.2 cv).2 hg.1 hg.2).1 hfit
  rw [hrun] at hr
  cases Except.ok.inj hr
  exact hrep

private theorem fma_cross (an ad pn pd zn zd qn qd : Int) (hpd : pd ≠ 0)
    (hp : pn*ad = an*pd) (hq : qn*(pd*zd) = (pn*zd+zn*pd)*qd) :
    qn*(ad*zd) = (an*zd+zn*ad)*qd := by
  apply Int.eq_of_mul_eq_mul_right hpd
  calc
    qn*(ad*zd)*pd = (qn*(pd*zd))*ad := by ac_rfl
    _ = ((pn*zd+zn*pd)*qd)*ad := by rw [hq]
    _ = ((pn*ad)*zd+zn*ad*pd)*qd := by
      simp only [Int.add_mul,Int.mul_add]; ac_rfl
    _ = ((an*pd)*zd+zn*ad*pd)*qd := by rw [hp]
    _ = ((an*zd+zn*ad)*qd)*pd := by
      simp only [Int.add_mul,Int.mul_add]; ac_rfl

theorem rational_fma_value_proven : JuliaLean.Statements.rational.Round12.rational_fma_value := by
  intro T U P V W i j p v w mp ma x y z hx hy hz cv g1 g2 n d mulRun addRun
  have hm := multiplication_contract i j p mp x y hx hy
  have herr : JuliaLean.Statements.rational.Round12.HasError mulRun →
      JuliaLean.Statements.rational.Round12.HasError addRun := by
    rintro ⟨e,he⟩
    exact ⟨e,by simp [addRun,fmaRatSource,show mulRatRatSource mp.prom (dg p p) x y = .error e from he]⟩
  refine ⟨fun hn => herr (hm.1 hn),?_,?_⟩
  · intro hcv
    refine ⟨fun hg => herr ((hm.2 hcv).1 hg),?_⟩
    intro h1 h2
    refine ⟨?_,fun hn => herr (((hm.2 hcv).2 h1 h2).2 hn)⟩
    intro hfit
    obtain ⟨product,hprod,hrep⟩ := ((hm.2 hcv).2 h1 h2).1 hfit
    exact ⟨product,hprod,hrep,add_outcome p v w ma product z hrep.1 hz⟩
  · intro hxp hyp hzp q hrun
    cases hprod : mulRun with
    | error e =>
      have he : addRun = .error e := by
        simp [addRun,fmaRatSource,show mulRatRatSource mp.prom (dg p p) x y = .error e from hprod]
      rw [he] at hrun; contradiction
    | ok product =>
      have hrep := multiplication_success i j p mp x y hx hy product hprod
      have hpd : rd p product > 0 := hrep.2.2.1 (by have := Int.mul_pos hxp hyp; omega)
      have hadd : add ma product z = .ok q := by
        simpa [addRun,fmaRatSource,show mulRatRatSource mp.prom (dg p p) x y = .ok product from hprod] using hrun
      have hsum := add_finite_success p v w ma product z hrep.1 hz hpd hzp q hadd
      refine ⟨hsum.1,?_,fun _ => hsum.2.2.1 (by have := Int.mul_pos hpd hzp; omega),?_⟩
      · simpa only [Int.mul_assoc] using fma_cross _ _ _ _ _ _ _ _ (by omega) hrep.2.1 hsum.2.1
      · intro he
        have := Int.mul_pos (Int.mul_pos hxp hyp) hzp
        omega

end JuliaLean.Proofs.base.rational.FmaProof

