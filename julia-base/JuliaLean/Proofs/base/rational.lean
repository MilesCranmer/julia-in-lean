  have hx := g20MixedWidenLeft hs x y
  have hy := g20MixedWidenRight hs x y
  unfold g20MixedTrunc DivGcdCtorLemmas.unsignedDivide
  dsimp only [JuliaLean.base.int.promoteSameSign] at hx hy ⊢
