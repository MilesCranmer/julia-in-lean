def divideByUnsigned {t u : IntTy} (x : JInt t) (g : Jl (JInt u)) : Jl (JInt t) := do
  let g ← g
  if t.signed then
    let q ← JuliaLean.base.int.div_BitSigned_Unsigned unsignedDivide x g
    JInt.convert (t.name) t q.val
  else
    let q ← unsignedDivide x g
    JInt.convert (t.name) t q.val
def IntegerParameters.divNat {T : Type} : IntegerParameters T → T → Nat → Jl T
  | .bits t, x, g => divideByUnsigned x (JInt.convert (t.toUnsigned.name) t.toUnsigned g)
abbrev val {T : Type} (i : IntegerParameters T) := i.ops.toInt
abbrev rn {T : Type} (i : IntegerParameters T) (q : Rational T) := val i q.num
abbrev rd {T : Type} (i : IntegerParameters T) (q : Rational T) := val i q.den
def Canonical {T : Type} (i : IntegerParameters T) (q : Rational T) : Prop :=
  0 ≤ rd i q ∧ Nat.gcd (rn i q).natAbs (rd i q).natAbs = 1
def Represents {T : Type} (i : IntegerParameters T) (q : Rational T) (n d : Int) : Prop :=
  Canonical i q ∧ rn i q * d = n * rd i q ∧
  (d ≠ 0 → rd i q > 0) ∧ (d = 0 → rd i q = 0 ∧ intSign (rn i q) = intSign n)
def dg {T U : Type} (i : IntegerParameters T) (j : IntegerParameters U) : T → U → Jl (T × U) :=
  match i,j with
