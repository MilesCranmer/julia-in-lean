  calls.count .signbit = 1 ∧
  calls.count .negation ≤ 2 ∧
  calls.count .originalConstructor + calls.count .negatedConstructor ≤ 1 ∧
  (.originalConstructor ∈ calls →
    .negation ∉ calls ∧ .negatedConstructor ∉ calls) ∧
  ∀ (before after : List CheckedDenEvent),
    calls = before ++ (.negatedConstructor :: after) →
      before.count .negation = 2

/-- Every selected-callee run obeys the independent call bounds and partial
