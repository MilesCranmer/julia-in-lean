      widen_UInt8, widen_UInt16, widen_UInt32, widen_UInt64,
      Option.some.injEq, reduceCtorEq] at hs hw
  all_goals try contradiction
  all_goals subst w; decide

/-- The signed branch of rational widening returns the exact mathematical product. -/
theorem rationalWideSigned {t w : IntTy} (ht : t ≠ .i128 ∧ t ≠ .u128)
