      | error err => rw [hcall] at hm1; cases err <;> first | contradiction | exact ⟨_, rfl⟩



/-! ## 16 & 17. `remainders` and `scalar_remainders` -/

theorem ops_rem_mod_spec {t : IntTy} (a b : JInt t) (floorMode : Bool) :
    (if floorMode then (IntegerParameters.ops (.bits t)).mod a b
     else (IntegerParameters.ops (.bits t)).rem a b) =
      if b.val = 0 then .error .divideError
      else .ok (JuliaLean.base.int.lit t (if floorMode then a.val.fmod b.val else a.val.tmod b.val)) := by
  cases floorMode
  · dsimp only [if_false, IntegerParameters.ops]
    exact remSame_eq a b
  · dsimp only [if_true, IntegerParameters.ops]
    by_cases hs : t.signed = true
    · simp only [hs, ↓reduceIte]
      have hfld : FldSpec (t := t) JuliaLean.base.div.fldBitInteger := by
        intro u v hv_ne
        unfold JuliaLean.base.div.fldBitInteger JuliaLean.base.div.fld_same_numeric
        have hspec := divBitIntegerMode_spec u v .down
        dsimp only [sourceRoundingMode] at hspec
        by_cases hv0 : v.val = 0
        · rw [if_pos hv0]; exact hspec.1 hv0
        · have hnot_min : ¬ (t.signed = true ∧ u.val = t.min ∧ v.val = -1) :=
            fun ⟨_, _, h⟩ => hv_ne h
          have hf : t.min ≤ JuliaLean.Proofs.base.rational.ComparisonAndRoundingLemmas.rounded u.val v.val .down ∧
              JuliaLean.Proofs.base.rational.ComparisonAndRoundingLemmas.rounded u.val v.val .down ≤ t.max :=
            (rounded_fits_iff u v hv0 .down).mpr hnot_min
          obtain ⟨q, hq_ok, hq_v⟩ := hspec.2.1 hv0 hf
          rw [if_neg hv0, hq_ok]
          congr 1
          apply Subtype.ext
          dsimp only [JuliaLean.Proofs.base.rational.ComparisonAndRoundingLemmas.rounded] at hf hq_v
          rw [hq_v, lit_of_fits hf]
      have hmod_s := modSigned_proven.1 t hs JuliaLean.base.div.fldBitInteger hfld a b
      by_cases hb0 : b.val = 0
      · rw [if_pos hb0]; exact hmod_s.1.mpr hb0
      · have hfm_fit := fmod_fits a b hb0
        have hok := (hmod_s.2 (JuliaLean.base.int.lit t (a.val.fmod b.val))).mpr
          ⟨hb0, lit_of_fits hfm_fit⟩
        rw [if_neg hb0, hok]
    · have hu : t.signed = false := Bool.eq_false_iff.mpr hs
      simp only [hu, Bool.false_eq_true, ↓reduceIte]
      have hmod_u := modUnsigned_proven t hu a b
      by_cases hb0 : b.val = 0
      · simp [hb0, hmod_u.1.mpr hb0]
      · have hfm_fit := fmod_fits a b hb0
        have hok := (hmod_u.2 (JuliaLean.base.int.lit t (a.val.fmod b.val))).mpr
          ⟨hb0, lit_of_fits hfm_fit⟩
        rw [if_neg hb0, hok]

theorem remainders_aux {T : Type} (i : IntegerParameters T) (x y : Rational T)
    (hx : Canonical i x) (hy : Canonical i y) :
    RemainderContract i i i x y (remRatSource (samePromoteOps i.ops) (dg i i) (rational i) x y) false ∧
    RemainderContract i i i x y (modRatSource (samePromoteOps i.ops) (dg i i) (rational i) x y) true := by
  cases i with | bits t =>
  have hcv_true : Converts (.bits t) (.bits t) (.bits t) x y :=
    ⟨x.num.property, x.den.property, y.num.property, y.den.property⟩
  have hpart : ∀ (floorMode : Bool),
      RemainderContract (.bits t) (.bits t) (.bits t) x y
        (if floorMode then modRatSource (samePromoteOps (IntegerParameters.ops (.bits t))) (dg (.bits t) (.bits t)) (rational (.bits t)) x y
         else remRatSource (samePromoteOps (IntegerParameters.ops (.bits t))) (dg (.bits t) (.bits t)) (rational (.bits t)) x y)
        floorMode := by
    intro floorMode
    unfold RemainderContract
    dsimp only [rn, rd, val, IntegerParameters.fits, IntegerParameters.ops, jintOps]
    let g : Int := Nat.gcd x.den.val.natAbs y.den.val.natAbs
    let a := x.num.val * y.den.val.tdiv g
    let b := y.num.val * x.den.val.tdiv g
    let d := x.den.val * y.den.val.tdiv g
    have hdg_eq : dg (.bits t) (.bits t) = dgBits := rfl
    have hdg := dgBits_spec x.den y.den
    refine ⟨fun hnot => absurd hcv_true hnot,
      fun _ hg0 => ?_,
      fun _ hg_nz hnot_ab => ?_,
      fun _ hg_nz hfa hfb => ?_⟩
    · cases floorMode <;>
        simp [remRatSource, modRatSource, samePromoteOps, hdg_eq, hdg.1 hg0, Bind.bind, Except.bind]
    · obtain ⟨xd, yd, hok_dg, hxd_v, hyd_v, _, _, _, _, _, _, _, _⟩ := hdg.2 hg_nz
      have hma := JuliaLean.Proofs.base.checked.mulExact t x.num yd
      have hmb := JuliaLean.Proofs.base.checked.mulExact t y.num xd
      unfold JuliaLean.Proofs.base.checked.ExactOrOverflow at hma hmb
      have hyd_a : x.num.val * yd.val = a := by rw [hyd_v]
      have hxd_b : y.num.val * xd.val = b := by rw [hxd_v]
      rw [hyd_a] at hma
      rw [hxd_b] at hmb
      by_cases hfa : t.min ≤ a ∧ a ≤ t.max
      · simp only [if_pos hfa] at hma
        obtain ⟨aJ, haJ_ok, _⟩ := hma
        have hnot_fb : ¬ (t.min ≤ b ∧ b ≤ t.max) := fun hfb => hnot_ab ⟨hfa, hfb⟩
        simp only [if_neg hnot_fb] at hmb
        cases hcall : JuliaLean.base.checked.checkedMulBits y.num xd with
        | ok _ => rw [hcall] at hmb; contradiction
        | error err =>
          rw [hcall] at hmb
          cases err <;> first | contradiction |
            (cases floorMode <;> simp [remRatSource, modRatSource, samePromoteOps,
              IntegerParameters.ops, jintOps, JuliaLean.base.rational.checkedMul,
              hdg_eq, hok_dg, haJ_ok, hcall, Bind.bind, Except.bind, IsOverflow])
      · simp only [if_neg hfa] at hma
        cases hcall : JuliaLean.base.checked.checkedMulBits x.num yd with
        | ok _ => rw [hcall] at hma; contradiction
        | error err =>
          rw [hcall] at hma
          cases err <;> first | contradiction |
            (cases floorMode <;> simp [remRatSource, modRatSource, samePromoteOps,
              IntegerParameters.ops, jintOps, JuliaLean.base.rational.checkedMul,
              hdg_eq, hok_dg, hcall, Bind.bind, Except.bind, IsOverflow])
    · obtain ⟨xd, yd, hok_dg, hxd_v, hyd_v, _, _, _, _, _, _, _, _⟩ := hdg.2 hg_nz
      have hma := JuliaLean.Proofs.base.checked.mulExact t x.num yd
      have hmb := JuliaLean.Proofs.base.checked.mulExact t y.num xd
      unfold JuliaLean.Proofs.base.checked.ExactOrOverflow at hma hmb
      rw [hyd_v] at hma
      rw [hxd_v] at hmb
      simp only [if_pos hfa] at hma; obtain ⟨aJ, haJ_ok, haJ_v⟩ := hma
      simp only [if_pos hfb] at hmb; obtain ⟨bJ, hbJ_ok, hbJ_v⟩ := hmb
      have hrem_op := ops_rem_mod_spec aJ bJ floorMode
      rw [haJ_v, hbJ_v] at hrem_op
      refine ⟨fun hb0 => ?_, fun hb_nz hnot_fd => ?_, fun hb_nz hfd => ?_⟩
      · cases floorMode
        · have h := hrem_op
          simp only [Bool.false_eq_true, ↓reduceIte, hb0] at h
          dsimp only [IntegerParameters.ops, jintOps] at h
          simp [remRatSource, samePromoteOps, JuliaLean.base.rational.checkedMul,
            hdg_eq, hok_dg, haJ_ok, hbJ_ok, Bind.bind, Except.bind, h]
        · have h := hrem_op
          simp only [↓reduceIte, hb0] at h
          dsimp only [IntegerParameters.ops, jintOps] at h
          simp [modRatSource, samePromoteOps, JuliaLean.base.rational.checkedMul,
            hdg_eq, hok_dg, haJ_ok, hbJ_ok, Bind.bind, Except.bind, h]
      · have hbJ_nz : bJ.val ≠ 0 := by rw [hbJ_v]; exact hb_nz
        have hmd := JuliaLean.Proofs.base.checked.mulExact t x.den yd
        unfold JuliaLean.Proofs.base.checked.ExactOrOverflow at hmd
        have hyd_d : x.den.val * yd.val = d := by rw [hyd_v]
        rw [hyd_d, if_neg hnot_fd] at hmd
        cases hcall : JuliaLean.base.checked.checkedMulBits x.den yd with
        | ok _ => rw [hcall] at hmd; contradiction
        | error err =>
          rw [hcall] at hmd
          cases err <;> first | contradiction |
            (cases floorMode
             · have h := hrem_op
               simp only [Bool.false_eq_true, ↓reduceIte, if_neg hb_nz] at h
               dsimp only [IntegerParameters.ops, jintOps] at h
               simp [remRatSource, samePromoteOps, JuliaLean.base.rational.checkedMul,
                 hdg_eq, hok_dg, haJ_ok, hbJ_ok, h, hcall, Bind.bind, Except.bind, IsOverflow]
             · have h := hrem_op
               simp only [↓reduceIte, if_neg hb_nz] at h
               dsimp only [IntegerParameters.ops, jintOps] at h
               simp [modRatSource, samePromoteOps, JuliaLean.base.rational.checkedMul,
                 hdg_eq, hok_dg, haJ_ok, hbJ_ok, h, hcall, Bind.bind, Except.bind, IsOverflow])
      · have hbJ_nz : bJ.val ≠ 0 := by rw [hbJ_v]; exact hb_nz
        have hmd := JuliaLean.Proofs.base.checked.mulExact t x.den yd
        unfold JuliaLean.Proofs.base.checked.ExactOrOverflow at hmd
        have hyd_d : x.den.val * yd.val = d := by rw [hyd_v]
        rw [hyd_d, if_pos hfd] at hmd
        obtain ⟨dJ, hdJ_ok, hdJ_v⟩ := hmd
        let rJ := JuliaLean.base.int.lit t (if floorMode then a.fmod b else a.tmod b)
        have hrJ_v : rJ.val = if floorMode then a.fmod b else a.tmod b := by
          dsimp [rJ, a, b, g]
          rw [← haJ_v, ← hbJ_v]
          cases floorMode
          · exact lit_of_fits (tmod_fits aJ bJ)
          · exact lit_of_fits (fmod_fits aJ bJ hbJ_nz)
        have hnc := native_constructor_aux t rJ dJ
        rw [hrJ_v, hdJ_v] at hnc
        cases floorMode
        · simp only [Bool.false_eq_true, ↓reduceIte] at hnc ⊢
          have h := hrem_op
          simp only [Bool.false_eq_true, ↓reduceIte, if_neg hb_nz] at h
          dsimp only [IntegerParameters.ops, jintOps] at h
          unfold remRatSource samePromoteOps
          dsimp only [JuliaLean.base.rational.checkedMul, Bind.bind, Except.bind, Pure.pure, Except.pure]
          rw [hdg_eq, hok_dg]; dsimp only [Bind.bind, Except.bind]
          rw [haJ_ok, hbJ_ok]; dsimp only
          rw [h]; dsimp only
          rw [hdJ_ok]; dsimp only
          exact hnc
        · simp only [↓reduceIte] at hnc ⊢
          have h := hrem_op
          simp only [↓reduceIte, if_neg hb_nz] at h
          dsimp only [IntegerParameters.ops, jintOps] at h
          unfold modRatSource samePromoteOps
          dsimp only [JuliaLean.base.rational.checkedMul, Bind.bind, Except.bind, Pure.pure, Except.pure]
          rw [hdg_eq, hok_dg]; dsimp only [Bind.bind, Except.bind]
          rw [haJ_ok, hbJ_ok]; dsimp only
          rw [h]; dsimp only
          rw [hdJ_ok]; dsimp only
          exact hnc
  exact ⟨hpart false, hpart true⟩

theorem gcd_sub_mul_coprime (n d q : Int) (hcop : Nat.gcd n.natAbs d.natAbs = 1) :
    Nat.gcd (n - d * q).natAbs d.natAbs = 1 := by
  let c := Nat.gcd (n - d * q).natAbs d.natAbs
  have hc_sub : (c : Int) ∣ (n - d * q) := Int.ofNat_dvd_left.mpr (Nat.gcd_dvd_left _ _)
  have hc_d : (c : Int) ∣ d := Int.ofNat_dvd_left.mpr (Nat.gcd_dvd_right _ _)
  have hc_n : (c : Int) ∣ n := by
    have hsum := Int.dvd_add hc_sub (Int.dvd_mul_of_dvd_left (c := q) hc_d)
    rwa [Int.sub_add_cancel] at hsum
  have hc_gcd : c ∣ Nat.gcd n.natAbs d.natAbs :=
    Nat.dvd_gcd (Int.ofNat_dvd_left.mp hc_n) (Nat.gcd_dvd_right _ _)
  rw [hcop] at hc_gcd
  exact Nat.eq_one_of_dvd_one hc_gcd

theorem prom_convertXP_spec {T U P : Type} {i : IntegerParameters T} {j : IntegerParameters U}
    {p : IntegerParameters P} (m : PromotionParameters i j p) (a : T) :
    (p.fits (val i a) → ∃ pa, m.prom.convertXP a = .ok pa ∧ val p pa = val i a) ∧
    (¬ p.fits (val i a) → IsInexact (m.prom.convertXP a)) := by
  cases m with
  | same i =>
    cases i with | bits t =>
    exact ⟨fun _ => ⟨a, rfl, rfl⟩, fun hn => absurd a.property hn⟩
  | bits t s =>
    unfold PromotionParameters.prom jintPromoteOps IntegerParameters.fits
      IntegerParameters.ops jintOps val
    dsimp only
    exact ⟨fun hf => ⟨⟨a.val, hf⟩, convert_of_fits hf, rfl⟩,
      fun hnf => ⟨(t.promote s).name, convert_of_not_fits hnf⟩⟩

theorem prom_promotePX_spec {T U P : Type} {i : IntegerParameters T} {j : IntegerParameters U}
    {p : IntegerParameters P} (m : PromotionParameters i j p) (n : P) (d : T)
    (hd : p.fits (val i d)) :
    ∃ dp, m.prom.promotePX n d = .ok (n, dp) ∧ val p dp = val i d := by
  cases m with
  | same i =>
    cases i with | bits t =>
    exact ⟨d, rfl, rfl⟩
  | bits t s =>
    unfold PromotionParameters.prom jintPromoteOps
    dsimp only [val, IntegerParameters.fits, IntegerParameters.ops, jintOps,
      Bind.bind, Except.bind, Pure.pure, Except.pure] at hd ⊢
    rw [convert_of_fits hd]
    exact ⟨⟨d.val, hd⟩, rfl, rfl⟩

theorem scalar_remainders_aux {T U P : Type} (i : IntegerParameters T) (j : IntegerParameters U)
    (p : IntegerParameters P) (m : PromotionParameters i j p) (x : Rational T) (k : U)
    (hx : Canonical i x) :
    let cv := p.fits (rn i x) ∧ p.fits (rd i x) ∧ p.fits (val j k)
    let prod := rd i x * val j k
    let rr := rationalIntegerOpSource m.prom (fun a b => do p.ops.rem (← m.prom.convertXP a) b) x k
    let rm := rationalIntegerOpSource m.prom (fun a b => do p.ops.mod (← m.prom.convertXP a) b) x k
    let lr := integerRationalRemainderSource m.prom
      (fun a b => do p.ops.rem a (← m.prom.convertXP b))
      (fun n d => ctor p p i n d (inexactErrorCore "Rational")) k x
    let lm := integerRationalRemainderSource m.prom
      (fun a b => do p.ops.mod a (← m.prom.convertXP b))
      (fun n d => ctor p p i n d (inexactErrorCore "Rational")) k x
    (cv → p.fits prod → prod ≠ 0 →
      ExactResult p rr ((rn i x).tmod prod) (rd i x) ∧
      ExactResult p rm ((rn i x).fmod prod) (rd i x)) ∧
    (cv → p.fits prod → rn i x ≠ 0 →
      ConstructorContract p lr (prod.tmod (rn i x)) (rd i x) ∧
      ConstructorContract p lm (prod.fmod (rn i x)) (rd i x)) ∧
    (cv → p.fits prod → prod = 0 → rr = .error .divideError ∧ rm = .error .divideError) ∧
    (cv → p.fits prod → rn i x = 0 → lr = .error .divideError ∧ lm = .error .divideError) ∧
    (cv → ¬ p.fits prod → IsOverflow rr ∧ IsOverflow rm ∧ IsOverflow lr ∧ IsOverflow lm) := by
  intro cv prod rr rm lr lm
  have hmxy := prom_checkedMulXY_spec m x.den k
  refine ⟨fun hcv hfp hp_nz => ?_, fun hcv hfp hxn_nz => ?_,
    fun hcv hfp hp0 => ?_, fun hcv hfp hxn0 => ?_, fun hcv hnot_fp => ?_⟩
  · obtain ⟨prodJ, hprod_ok, hprod_v⟩ := (hmxy.2 ⟨hcv.2.1, hcv.2.2⟩).1 hfp
    obtain ⟨xnP, hxnP_ok, hxnP_v⟩ := (prom_convertXP_spec m x.num).1 hcv.1
    cases p with | bits pt =>
    obtain ⟨xdP, hpx_ok, hxdP_v⟩ := prom_promotePX_spec m
      (JuliaLean.base.int.lit pt ((rn i x).tmod prod)) x.den hcv.2.1
    obtain ⟨xdP_m, hpx_m_ok, hxdP_m_v⟩ := prom_promotePX_spec m
      (JuliaLean.base.int.lit pt ((rn i x).fmod prod)) x.den hcv.2.1
    have hrem := ops_rem_mod_spec xnP prodJ false
    have hmod := ops_rem_mod_spec xnP prodJ true
    have hxnP_eq : xnP.val = rn i x := hxnP_v
    have hprodJ_eq : prodJ.val = prod := hprod_v
    rw [hxnP_eq, hprodJ_eq, if_neg hp_nz] at hrem hmod
    simp only [Bool.false_eq_true, ↓reduceIte] at hrem hmod
    have htmod_fit : pt.min ≤ (rn i x).tmod prod ∧ (rn i x).tmod prod ≤ pt.max := by
      rw [← hxnP_eq, ← hprodJ_eq]; exact tmod_fits xnP prodJ
    have hfmod_fit : pt.min ≤ (rn i x).fmod prod ∧ (rn i x).fmod prod ≤ pt.max := by
      rw [← hxnP_eq, ← hprodJ_eq]; exact fmod_fits xnP prodJ (by rw [hprodJ_eq]; exact hp_nz)
    have hxd_pos : 0 < rd i x := by
      have := hx.1
      have hne0 : rd i x ≠ 0 := fun hd0 => hp_nz (by dsimp [prod]; rw [hd0, Int.zero_mul])
      omega
    have hcop_tmod : Nat.gcd ((rn i x).tmod prod).natAbs (rd i x).natAbs = 1 := by
      have hqr := Int.tdiv_mul_add_tmod (rn i x) prod
      have heq : (rn i x).tmod prod = rn i x - rd i x * (val j k * ((rn i x).tdiv prod)) := by
        dsimp [prod] at hqr
        calc (rn i x).tmod (rd i x * val j k) = rn i x - (rn i x).tdiv (rd i x * val j k) * (rd i x * val j k) := by omega
          _ = rn i x - rd i x * (val j k * ((rn i x).tdiv (rd i x * val j k))) := by
              rw [Int.mul_comm ((rn i x).tdiv _) (rd i x * val j k), Int.mul_assoc]
      rw [heq]
      exact gcd_sub_mul_coprime _ _ _ hx.2
    have hcop_fmod : Nat.gcd ((rn i x).fmod prod).natAbs (rd i x).natAbs = 1 := by
      have hfm : (rn i x).fdiv prod * prod + (rn i x).fmod prod = rn i x := by
        have h1 := Int.ediv_mul_add_emod (rn i x) prod
        rw [Int.fdiv_eq_ediv, Int.fmod_eq_emod]
        by_cases hcond : 0 ≤ prod ∨ prod ∣ rn i x
        · simp only [if_pos hcond, Int.sub_zero, Int.add_zero]; exact h1
        · simp only [if_neg hcond]; rw [Int.sub_mul, Int.one_mul]; omega
      have heq : (rn i x).fmod prod = rn i x - rd i x * (val j k * ((rn i x).fdiv prod)) := by
        dsimp [prod] at hfm
        calc (rn i x).fmod (rd i x * val j k) = rn i x - (rn i x).fdiv (rd i x * val j k) * (rd i x * val j k) := by omega
          _ = rn i x - rd i x * (val j k * ((rn i x).fdiv (rd i x * val j k))) := by
              rw [Int.mul_comm ((rn i x).fdiv _) (rd i x * val j k), Int.mul_assoc]
      rw [heq]
      exact gcd_sub_mul_coprime _ _ _ hx.2
    refine ⟨?_, ?_⟩
    · unfold rr rationalIntegerOpSource unsafeRationalPromoteSource ExactResult Represents Canonical
      simp only [hprod_ok, hxnP_ok, hrem, hpx_ok, Bind.bind, Except.bind, Pure.pure, Except.pure,
        unsafeRationalSameSource_pair]
      refine ⟨⟨_, xdP⟩, rfl, ?_⟩
      dsimp only [rn, rd]
      change ((0 ≤ xdP.val ∧ Nat.gcd (JuliaLean.base.int.lit pt ((rn i x).tmod prod)).val.natAbs xdP.val.natAbs = 1) ∧
        (JuliaLean.base.int.lit pt ((rn i x).tmod prod)).val * rd i x = (rn i x).tmod prod * xdP.val ∧
        (rd i x ≠ 0 → xdP.val > 0) ∧
        (rd i x = 0 → xdP.val = 0 ∧ intSign (JuliaLean.base.int.lit pt ((rn i x).tmod prod)).val = intSign ((rn i x).tmod prod)))
      refine ⟨⟨by rw [show xdP.val = rd i x from hxdP_v]; exact hx.1, ?_⟩,
        by rw [lit_of_fits htmod_fit, show xdP.val = rd i x from hxdP_v],
        fun _ => by rw [show xdP.val = rd i x from hxdP_v]; exact hxd_pos,
        fun hd0 => absurd hd0 (by omega)⟩
      rw [lit_of_fits htmod_fit, show xdP.val = rd i x from hxdP_v]
      exact hcop_tmod
    · unfold rm rationalIntegerOpSource unsafeRationalPromoteSource ExactResult Represents Canonical
      simp only [hprod_ok, hxnP_ok, hmod, hpx_m_ok, Bind.bind, Except.bind, Pure.pure, Except.pure,
        unsafeRationalSameSource_pair]
      refine ⟨⟨_, xdP_m⟩, rfl, ?_⟩
      dsimp only [rn, rd]
      change ((0 ≤ xdP_m.val ∧ Nat.gcd (JuliaLean.base.int.lit pt ((rn i x).fmod prod)).val.natAbs xdP_m.val.natAbs = 1) ∧
        (JuliaLean.base.int.lit pt ((rn i x).fmod prod)).val * rd i x = (rn i x).fmod prod * xdP_m.val ∧
        (rd i x ≠ 0 → xdP_m.val > 0) ∧
        (rd i x = 0 → xdP_m.val = 0 ∧ intSign (JuliaLean.base.int.lit pt ((rn i x).fmod prod)).val = intSign ((rn i x).fmod prod)))
      refine ⟨⟨by rw [show xdP_m.val = rd i x from hxdP_m_v]; exact hx.1, ?_⟩,
        by rw [lit_of_fits hfmod_fit, show xdP_m.val = rd i x from hxdP_m_v],
        fun _ => by rw [show xdP_m.val = rd i x from hxdP_m_v]; exact hxd_pos,
        fun hd0 => absurd hd0 (by omega)⟩
      rw [lit_of_fits hfmod_fit, show xdP_m.val = rd i x from hxdP_m_v]
      exact hcop_fmod
  · obtain ⟨prodJ, hprod_ok, hprod_v⟩ := (hmxy.2 ⟨hcv.2.1, hcv.2.2⟩).1 hfp
    obtain ⟨xnP, hxnP_ok, hxnP_v⟩ := (prom_convertXP_spec m x.num).1 hcv.1
    cases p with | bits pt =>
    have hrem := ops_rem_mod_spec prodJ xnP false
    have hmod := ops_rem_mod_spec prodJ xnP true
    have hxnP_eq : xnP.val = rn i x := hxnP_v
    have hprodJ_eq : prodJ.val = prod := hprod_v
    rw [hxnP_eq, hprodJ_eq, if_neg hxn_nz] at hrem hmod
    simp only [Bool.false_eq_true, ↓reduceIte] at hrem hmod
    have htmod_fit : pt.min ≤ prod.tmod (rn i x) ∧ prod.tmod (rn i x) ≤ pt.max := by
      rw [← hxnP_eq, ← hprodJ_eq]; exact tmod_fits prodJ xnP
    have hfmod_fit : pt.min ≤ prod.fmod (rn i x) ∧ prod.fmod (rn i x) ≤ pt.max := by
      rw [← hxnP_eq, ← hprodJ_eq]; exact fmod_fits prodJ xnP (by rw [hxnP_eq]; exact hxn_nz)
    let rT := JuliaLean.base.int.lit pt (prod.tmod (rn i x))
    let rF := JuliaLean.base.int.lit pt (prod.fmod (rn i x))
    have hcT := constructor_outcomes_aux (.bits pt) (.bits pt) i rT x.den
    have hcF := constructor_outcomes_aux (.bits pt) (.bits pt) i rF x.den
    have hrT_v : val (.bits pt) rT = prod.tmod (rn i x) := lit_of_fits htmod_fit
    have hrF_v : val (.bits pt) rF = prod.fmod (rn i x) := lit_of_fits hfmod_fit
    rw [hrT_v] at hcT
    rw [hrF_v] at hcF
    unfold lr lm integerRationalRemainderSource
    simp only [hprod_ok, hxnP_ok, hrem, hmod, Bind.bind, Except.bind]
    exact ⟨hcT, hcF⟩
  · obtain ⟨prodJ, hprod_ok, hprod_v⟩ := (hmxy.2 ⟨hcv.2.1, hcv.2.2⟩).1 hfp
    obtain ⟨xnP, hxnP_ok, hxnP_v⟩ := (prom_convertXP_spec m x.num).1 hcv.1
    cases p with | bits pt =>
    have hrem := ops_rem_mod_spec xnP prodJ false
    have hmod := ops_rem_mod_spec xnP prodJ true
    have hprodJ_eq : prodJ.val = 0 := hprod_v.trans hp0
    rw [hprodJ_eq, if_pos rfl] at hrem hmod
    simp only [Bool.false_eq_true, ↓reduceIte] at hrem hmod
    unfold rr rm rationalIntegerOpSource
    simp [hprod_ok, hxnP_ok, hrem, hmod, Bind.bind, Except.bind]
  · obtain ⟨prodJ, hprod_ok, hprod_v⟩ := (hmxy.2 ⟨hcv.2.1, hcv.2.2⟩).1 hfp
    obtain ⟨xnP, hxnP_ok, hxnP_v⟩ := (prom_convertXP_spec m x.num).1 hcv.1
    cases p with | bits pt =>
    have hrem := ops_rem_mod_spec prodJ xnP false
    have hmod := ops_rem_mod_spec prodJ xnP true
    have hxnP_eq : xnP.val = 0 := hxnP_v.trans hxn0
    rw [hxnP_eq, if_pos rfl] at hrem hmod
    simp only [Bool.false_eq_true, ↓reduceIte] at hrem hmod
    unfold lr lm integerRationalRemainderSource
    simp [hprod_ok, hxnP_ok, hrem, hmod, Bind.bind, Except.bind]
  · obtain ⟨msg, herr⟩ := (hmxy.2 ⟨hcv.2.1, hcv.2.2⟩).2 hnot_fp
    unfold rr rm lr lm rationalIntegerOpSource integerRationalRemainderSource
    simp [herr, Bind.bind, Except.bind, IsOverflow]

