def CheckedDenSignbitTypeError : Prop :=
  ∀ (World T Neg NotBool R : Type)
    (ops : CheckedDenOps (EStateM ArrayError World) T Neg NotBool R)
    (num den : T) (initial after : World) (invalid : NotBool),
    ops.signbit den initial = .ok (.rejected invalid) after →
    checkedDenTyped ops num den initial = .error (.showError .typeError) after

