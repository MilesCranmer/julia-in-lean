theorem g20CheckedMulMixed_spec {t s : IntTy} (a : JInt t) (b : JInt s) :
    (¬ (RoundedFits (t.promote s) a.val ∧ RoundedFits (t.promote s) b.val) →
      RoundedInexact (JuliaLean.base.checked.checkedMulMixedBits a b)) ∧
    ((RoundedFits (t.promote s) a.val ∧ RoundedFits (t.promote s) b.val) →
      (RoundedFits (t.promote s) (a.val * b.val) →
        ∃ out, JuliaLean.base.checked.checkedMulMixedBits a b = .ok out ∧
          out.val = a.val * b.val) ∧
      (¬ RoundedFits (t.promote s) (a.val * b.val) →
        RoundedOverflow (JuliaLean.base.checked.checkedMulMixedBits a b))) := by
  exact Round4.prom_checkedMulXY_spec (Round4.PromotionParameters.bits t s) a b

def g20NativeRoundedLaw : Prop :=
  ∀ {t s : IntTy} (a : JInt t) (b : JInt s) (r : Rounding),
    RoundedOutcome (JuliaLean.base.div.divBitIntegerMixedMode a b (sourceRoundingMode r))
      a.val b.val r ∧
    RoundedNativeFinalOutcome t s
      (JuliaLean.base.div.divBitIntegerMixedMode a b (sourceRoundingMode r)) a.val b.val r

def g20ScaleRoundedLaw : Prop :=
  ∀ {t : IntTy} (run : Jl (JInt t)) (a b g : Int) (r : Rounding),
    0 < g → RoundedOutcome run a b r → RoundedOutcome run (a * g) (b * g) r

theorem g20ScaleRoundedLaw_proven : g20ScaleRoundedLaw := by
  intro t run a b g r hg h
  exact g2RoundedOutcomeScale run a b g hg r h

theorem g20RoundedRatInteger_of_native
    (hNative : g20NativeRoundedLaw) (hScale : g20ScaleRoundedLaw) :
    RoundedRatIntegerCorrect := by
  intro t s x y r _hx
  unfold RoundedRatIntegerOutcome
  dsimp only
  simp only [Int.ofNat_eq_natCast]
  have hgcd := dgBits_spec x.num y
  refine ⟨?_, ?_⟩
  · intro hg0
    unfold roundedRatInteger
    rw [g20DivgcdMixed_eq_dgBits, hgcd.1 hg0]
    rfl
  · intro hg
    obtain ⟨xn, yn, hxy, hxn, hyn, _, _, _, hxscale, hyscale, _⟩ := hgcd.2 hg
    have hrun : roundedRatInteger x y r = (do
        let d ← JuliaLean.base.checked.checkedMulMixedBits x.den yn
        JuliaLean.base.div.divBitIntegerMixedMode xn d (sourceRoundingMode r)) := by
      unfold roundedRatInteger
      rw [g20DivgcdMixed_eq_dgBits, hxy]
      rfl
    have hmul := g20CheckedMulMixed_spec x.den yn
    refine ⟨?_, ?_⟩
    · intro hnot
      obtain ⟨message, herr⟩ := hmul.1 (by simpa only [hyn] using hnot)
      exact ⟨message, by rw [hrun, herr]; rfl⟩
    · intro hconv
      have hconv' : RoundedFits (t.promote s) x.den.val ∧
          RoundedFits (t.promote s) yn.val := by simpa only [hyn] using hconv
      refine ⟨?_, ?_⟩
      · intro hnot
        obtain ⟨message, herr⟩ := (hmul.2 hconv').2 (by simpa only [hyn] using hnot)
        exact ⟨message, by rw [hrun, herr]; rfl⟩
      · intro hfit
        obtain ⟨d, hd, hdval⟩ := (hmul.2 hconv').1 (by simpa only [hyn] using hfit)
        have hfinal : roundedRatInteger x y r =
            JuliaLean.base.div.divBitIntegerMixedMode xn d (sourceRoundingMode r) := by
          rw [hrun, hd]
          rfl
        have hnative := hNative xn d r
        have hgpos : (0 : Int) < (Nat.gcd x.num.val.natAbs y.val.natAbs : Int) := by
          exact Int.lt_iff_le_and_ne.mpr ⟨Int.natCast_nonneg _, Ne.symm hg⟩
        have hdscale : d.val * (Nat.gcd x.num.val.natAbs y.val.natAbs : Int) =
            x.den.val * y.val := by
          rw [hdval, Int.mul_assoc, hyscale]
        rw [hfinal]
        refine ⟨?_, ?_⟩
        · have hs := hScale _ xn.val d.val _ r hgpos hnative.1
          simpa only [hxscale, hdscale] using hs
        · simpa only [hxn, hdval, hyn] using hnative.2

