    {p : IntegerParameters P} : PromotionParameters i j p → RatPromoteOps T U P
  | .same i => samePromoteOps i.ops
  | .bits t s => jintPromoteOps t s
abbrev promoteR {T U P : Type} {i : IntegerParameters T} {j : IntegerParameters U}
    {p : IntegerParameters P} (_m : PromotionParameters i j p)
    (x : Rational T) (y : Rational U) : Jl (Rational P × Rational P) := do
  let xp ← convertRat p i x
  let yp ← convertRat p j y
  pure (xp,yp)
abbrev add {T U P : Type} {i : IntegerParameters T} {j : IntegerParameters U}
