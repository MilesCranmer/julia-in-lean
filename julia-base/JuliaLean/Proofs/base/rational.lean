    ((t.min ≤ x.val ∧ x.val ≤ t.max) → ∃ q, run = .ok q ∧
      Normalized q ∧ q.num.val = x.val ∧ q.den.val = 1)
def extended_exact_division : Prop :=
  ∀ (t s : IntTy) (x : Rat t) (y : Rat s)
    (hx : Normalized x) (hy : Normalized y),
    let p := IntegerParameters.bits (t.promote s)
    let run := divRatRatSource (PromotionParameters.prom (.bits t s)) (dg p p) x y
    let gn : Int := Nat.gcd x.num.val.natAbs y.num.val.natAbs
    let gd : Int := Nat.gcd x.den.val.natAbs y.den.val.natAbs
    let a := x.num.val.tdiv gn
    let b := y.num.val.tdiv gn
    let c := x.den.val.tdiv gd
    let e := y.den.val.tdiv gd
    let flip := c = 0 ∧ b < 0
    let n := (if flip then -a else a)*e
    let d := c*b
    let safe := (flip → p.fits (-a)) ∧ FitsPair p n d ∧ (d < 0 → FitsPair p (-n) (-d))
    (¬ Converts (.bits t) (.bits s) p x y → IsInexact run) ∧
    (Converts (.bits t) (.bits s) p x y →
      ((gn = 0 ∨ gd = 0) → run = .error .divideError) ∧
      (gn ≠ 0 → gd ≠ 0 →
        (safe → ExactResult p run n d) ∧ (¬ safe → IsOverflow run)))
inductive Widening : IntTy → IntTy → Type → Type where
  | same (t s wt ws : IntTy) (hs : t.signed = s.signed)
      (ht : JuliaLean.base.int.widenType t = some wt)
      (hu : JuliaLean.base.int.widenType s = some ws) : Widening t s (JInt (wt.promote ws))
  | signedUnsigned (t s wt ws : IntTy) (hs : t.signed = true) (hu : s.signed = false)
      (ht : JuliaLean.base.int.widenType t = some wt)
      (hw : JuliaLean.base.int.widenType s = some ws) : Widening t s (JInt (wt.promote ws.toSigned))
  | unsignedSigned (t s wt ws : IntTy) (hs : t.signed = false) (hu : s.signed = true)
      (ht : JuliaLean.base.int.widenType t = some wt)
      (hw : JuliaLean.base.int.widenType s = some ws) : Widening t s (JInt (wt.toSigned.promote ws))
