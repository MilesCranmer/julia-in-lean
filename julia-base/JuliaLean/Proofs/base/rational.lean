  have hed := Int.ediv_mul_add_emod a b
  have hmod_nn := Int.emod_nonneg a hb
  have hmod_lt : a % b < (b.natAbs : Int) := by
    by_cases hb_pos : 0 < b
    · have := Int.emod_lt_of_pos a hb_pos; omega
    · have := Int.emod_lt a hb; omega
  obtain ⟨_, hr_pos, hr_neg⟩ := g2TmodBoundsStrict a b hb
  have hdvd_iff : b ∣ a ↔ a.tmod b = 0 := Int.dvd_iff_tmod_eq_zero
  by_cases ha : a < 0 <;> by_cases hbn : b < 0 <;> by_cases hr0 : a.tmod b = 0
  · have hdvd : b ∣ a := hdvd_iff.mpr hr0
    have hb_ge : ¬ (0 ≤ b) := by omega
    simp only [ha, hbn, hr0, hdvd, hb_ge, ne_eq, not_true_eq_false, false_and, or_true, ↓reduceIte, Int.sub_zero]
    have hrem0 : a % b = 0 := Int.emod_eq_zero_of_dvd hdvd
    have h2 : (a / b - a.tdiv b) * (-b) = 0 := by
      rw [Int.mul_neg, Int.sub_mul]; omega
    exact g2EqOfMulSubLT (by omega) h2 ⟨by omega, by omega⟩
  · have hndvd : ¬ (b ∣ a) := fun h => hr0 (hdvd_iff.mp h)
    have hb_ge : ¬ (0 ≤ b) := by omega
    simp only [ha, hbn, hr0, hndvd, hb_ge, ne_eq, not_true_eq_false, not_false_eq_true, false_and, or_false, ↓reduceIte, Int.sub_zero]
    have hr := hr_neg ha
    have hrem_pos : 0 < a % b := Decidable.byContradiction fun hle =>
      hndvd (Int.dvd_of_emod_eq_zero (by omega))
    have h2 : ((a / b - 1) - a.tdiv b) * (-b) = a % b + b - a.tmod b := by
      rw [Int.mul_neg, Int.sub_mul, Int.sub_mul, Int.one_mul]; omega
    exact g2EqOfMulSubLT (by omega) h2 ⟨by omega, by omega⟩
  · have hdvd : b ∣ a := hdvd_iff.mpr hr0
    have hb_ge : 0 ≤ b := by omega
    simp only [ha, hbn, hr0, hdvd, hb_ge, ne_eq, not_true_eq_false, and_false, true_or, ↓reduceIte, Int.sub_zero]
    have hrem0 : a % b = 0 := Int.emod_eq_zero_of_dvd hdvd
