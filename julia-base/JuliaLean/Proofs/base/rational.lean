/-- Independent result-type specification for native integer promotion.
The manual says larger widths win and unsigned wins equal-width ties
(`doc/src/manual/conversion-and-promotion.md:238-242`). The Bool cases preserve
its built-in neutral promotion rule. No promotion model is called by this specification. -/
def IntegerPromotionComponent (t s : Option IntTy) (component : PType) : Prop :=
  match t, s with
  | none, none => component = primitivePType .bool
  | none, some s => component = primitivePType (.int s)
  | some t, none => component = primitivePType (.int t)
  | some t, some s => ∃ r : IntTy,
      component = primitivePType (.int r) ∧
      r.bits = max t.bits s.bits ∧
      (r.signed = true ↔
        (t.signed = true ∧ s.signed = true) ∨
        (t.signed = true ∧ s.bits < t.bits) ∨
        (s.signed = true ∧ t.bits < s.bits))

/-- Every built-in Bool/native-integer pair terminates with a Base.Rational type
whose component obeys the independently stated width and signedness rules.
No successful-run premise is imposed. Julia source: base/rational.jl:230.
Documentation: doc/src/manual/conversion-and-promotion.md:238-242,338-355. -/
def RationalIntegerPromotion : Prop :=
  ∀ (t s : Option IntTy), ∃ component : PType,
    promoteRuleRationalInteger t s =
      some (.data ⟨"Base", "Rational"⟩ "Rational" [component] (some pPromotionReal)) ∧
    IntegerPromotionComponent t s component

/-- Both rational component domains range over Bool and all ten machine integer types.
The required result is a Rational type with the manual's width/signedness component.
Julia source: base/rational.jl:231.
Documentation: doc/src/manual/conversion-and-promotion.md:238-242,338-355. -/
def RationalRationalPromotion : Prop :=
  ∀ (t s : Option IntTy), ∃ component : PType,
    promoteRuleRationalRational t s =
      some (.data ⟨"Base", "Rational"⟩ "Rational" [component] (some pPromotionReal)) ∧
    IntegerPromotionComponent t s component

/-- Every IEEE floating target wins native rational/float promotion, including
128-bit integer rational components and Bool. The result must be the concrete
IEEE type, not Rational or an abstract supertype. Julia source: base/rational.jl:232;
base/float.jl:247-264. Documentation: doc/src/manual/conversion-and-promotion.md:351-355. -/
def RationalFloatPromotion : Prop :=
  ∀ (t : Option IntTy) (f : JuliaLean.base.float.FTy),
    promoteRuleRationalFloat t f = some (primitivePType (.float f))

/-- Native rational widening doubles component width below 128 bits, preserves
signedness and all original component values, and reaches BigInt at either 128-bit
boundary. The complete Bool branch throws MethodError, as its component has no
widen method. Julia source: base/rational.jl:234; base/int.jl:911-918;
base/gmp.jl:298-299; base/operators.jl:976.
Documentation: base/operators.jl:955-964. This is a type/representation contract;
it makes no unsupported claim about rational addition avoiding all overflow. -/
def RationalWidening : Prop :=
  ∀ (t : Option IntTy),
    match t with
    | none => widenRational t = .error (.methodError "widen")
    | some s =>
        if s.bits < 128 then
          ∃ w : IntTy,
            widenRational t = .ok
              (.data ⟨"Base", "Rational"⟩ "Rational"
                [primitivePType (.int w)] (some pPromotionReal)) ∧
            w.bits = 2 * s.bits ∧ w.signed = s.signed ∧
            (∀ n : Int, s.min ≤ n → n ≤ s.max → w.min ≤ n ∧ n ≤ w.max)
        else
          widenRational t = .ok
            (.data ⟨"Base", "Rational"⟩ "Rational"
              [.data ⟨"Base.GMP", "BigInt"⟩ "BigInt" [] (some pPromotionSigned)]
              (some pPromotionReal))

end JuliaLean.Proofs.base.rational.Models1Group20


