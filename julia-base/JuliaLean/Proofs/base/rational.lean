    exact rationalConvertWrap _ _ _ hprod
  · simp only [widemulI64BitInt, hw, hs, Bool.false_eq_true, ite_false, hp.1]
    exact rationalConvertWrap _ _ _ (by rw [Int.mul_comm]; exact hprod)

/-- Every supported bounded component type has successful exact cross multiplication. -/
theorem rationalWideExact {t : IntTy} (ht : t ≠ .i128 ∧ t ≠ .u128)
