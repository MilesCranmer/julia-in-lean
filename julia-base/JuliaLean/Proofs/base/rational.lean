theorem prom_checkedMulXY_spec {T U P : Type} {i : IntegerParameters T} {j : IntegerParameters U}
    {p : IntegerParameters P} (m : PromotionParameters i j p) (a : T) (b : U) :
    (¬ FitsPair p (val i a) (val j b) → IsInexact (m.prom.checkedMulXY a b)) ∧
