theorem typed_integer_rounding_aux (t s : IntTy) (x : Rat s) (_hx : Normalized x) (mode : Rounding) :
    ∀ copySign convertInf,
    let run := integerRound t s copySign convertInf x mode
    let answer := rounded x.num.val x.den.val mode
    (x.den.val = 0 → run = .error .divideError) ∧
    (x.den.val > 0 → (s.min ≤ answer ∧ answer ≤ s.max) →
      ((t.min ≤ answer ∧ answer ≤ t.max) → ∃ out, run = .ok out ∧ out.val = answer) ∧
      (¬ (t.min ≤ answer ∧ answer ≤ t.max) → IsInexact run)) ∧
    (x.den.val > 0 → ¬ (s.min ≤ answer ∧ answer ≤ s.max) → run = .error .divideError) := by
  intro copySign convertInf run answer
  have hdiv := divBitIntegerMode_spec x.num x.den mode
  have hmode : sourceMode mode = sourceRoundingMode mode := by cases mode <;> rfl
  have hrun_eq : run = (do
      let q ← JuliaLean.base.div.divBitIntegerMode x.num x.den (sourceRoundingMode mode)
      JuliaLean.base.int.convert t q) := by
    unfold run integerRound roundRatTypedSource
    simp only [Bool.not_true, Bool.and_false, Bool.false_eq_true, ↓reduceIte,
      numeratorRationalSource, denominatorRationalSource, hmode]
  refine ⟨fun hd0 => ?_, fun hd_pos hs_fit => ⟨fun ht_fit => ?_, fun hnot_t => ?_⟩,
    fun hd_pos hnot_s => ?_⟩
  · rw [hrun_eq, hdiv.1 hd0]; rfl
  · obtain ⟨q, hq_ok, hq_v⟩ := hdiv.2.1 (by omega) hs_fit
    change q.val = answer at hq_v
    rw [hrun_eq, hq_ok]; dsimp only [Bind.bind, Except.bind]
    unfold JuliaLean.base.int.convert
    rw [convert_of_fits (by rw [hq_v]; exact ht_fit)]
    exact ⟨_, rfl, hq_v⟩
  · obtain ⟨q, hq_ok, hq_v⟩ := hdiv.2.1 (by omega) hs_fit
    change q.val = answer at hq_v
    rw [hrun_eq, hq_ok]; dsimp only [Bind.bind, Except.bind]
    unfold JuliaLean.base.int.convert
    rw [convert_of_not_fits (by rw [hq_v]; exact hnot_t)]
    exact ⟨_, rfl⟩
  · rw [hrun_eq, hdiv.2.2 (by omega) hnot_s]; rfl

