def g20NearestRawAnswer (a b : Int) (mode : JuliaLean.base.div.NearestMode) : Int :=
  let q := a.tdiv b
  let r := a.tmod b
  let tie := if mode = .Nearest then decide (b.tmod 2 ≠ 0) || decide (q % 2 = 0)
    else decide (b.tmod 2 ≠ 0)
  let tieNeg := if mode = .NearestTiesUp then true else tie
  if 0 ≤ a then
    if 0 ≤ b then
      if b.tdiv 2 + JuliaLean.base.div.boolInt tie ≤ r then q + 1 else q
    else if -(b.tdiv 2) + JuliaLean.base.div.boolInt tieNeg ≤ r then q - 1 else q
  else if 0 ≤ b then
    if r ≤ -(b.tdiv 2) - JuliaLean.base.div.boolInt tieNeg then q - 1 else q
  else if r ≤ b.tdiv 2 - JuliaLean.base.div.boolInt tie then q + 1 else q

