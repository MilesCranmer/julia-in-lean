  ∃ e, run = .error e

def BezoutIdentity {T : Type} (i : IntegerParameters T) (lhs rhs : Int) : Prop :=
  match i with
  | .bits t =>
      if t.signed then lhs = rhs
      else (lhs - rhs) % (2 : Int) ^ t.bits = 0

/-- Every returned finite gcdx result satisfies the documented Bezout relation; with fitting
integer idiv inputs, the finite call succeeds. -/
def gcdx_bezout : Prop :=
  ∀ {T : Type} (i : IntegerParameters T) (x y : Rational T)
    (hx : Canonical i x) (hy : Canonical i y),
    let gn : Int := Nat.gcd (rn i x).natAbs (rn i y).natAbs
    let ld : Int := Nat.lcm (rd i x).natAbs (rd i y).natAbs
    let run := JuliaLean.Proofs.base.rational.Round4.rgcdx i x y
    ((rd i x = 0) ≠ (rd i y = 0) → HasError run) ∧
    (rd i x = 0 → rd i y = 0 →
      ∃ q a b, run = .ok (q, a, b) ∧ Represents i q gn ld ∧
        rn i q = 1 ∧ rd i q = 0 ∧ val i a = 1 ∧ val i b = 1) ∧
    (rn i x = 0 → rn i y = 0 → rd i x > 0 → rd i y > 0 →
      ∃ q a b, run = .ok (q, a, b) ∧ Represents i q 0 1 ∧
        rn i q = 0 ∧ rd i q = 1 ∧ val i a = 0 ∧ val i b = 0) ∧
    (rd i x > 0 → rd i y > 0 → gn ≠ 0 → FitsPair i gn ld →
      i.fits ((rn i x).tdiv gn * ld.tdiv (rd i x)) →
      i.fits ((rn i y).tdiv gn * ld.tdiv (rd i y)) →
      ∃ q a b, run = .ok (q, a, b)) ∧
    (rd i x > 0 → rd i y > 0 → gn ≠ 0 → FitsPair i gn ld →
      ∀ q a b, run = .ok (q, a, b) →
        Represents i q gn ld ∧
        BezoutIdentity i
          (rn i q * rd i x * rd i y)
          ((val i a * rn i x * rd i y + val i b * rn i y * rd i x) * rd i q))

end JuliaLean.Statements.rational.Round14
