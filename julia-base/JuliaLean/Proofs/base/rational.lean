    have hle_yx : leRatSource (fun a b => decide (a.val = b.val)) (fun a b => decide (a.val ≤ b.val))
        (fun a b => a.val * b.val) (fun a b => a.val * b.val) (fun a b => decide (a ≤ b)) y x =
