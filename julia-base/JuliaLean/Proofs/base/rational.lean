def roundDownCounterexample : Rat .i64 :=
  ⟨JInt.lit .i64 2051, JInt.lit .i64 1⟩

theorem finite_noninteger_rounding_refuted : ¬ finite_noninteger_rounding := by
  intro h
  have hx : Normalized roundDownCounterexample := by
    unfold Normalized roundDownCounterexample
    decide
  have hd : 0 < roundDownCounterexample.den.val := by decide
  have hzero : (jintOps .i64).iszero (JInt.lit .i64 1) = false := by decide
  have hdiv : JuliaLean.base.div.divBitIntegerMode
      (⟨2051, by decide⟩ : JInt .i64) (⟨1, by decide⟩ : JInt .i64) .Down =
        .ok (⟨2051, by decide⟩ : JInt .i64) := by
    decide
  let badCopy : Rat .i64 → JInt .i64 → Jl (Rat .i64) := fun _ _ => .error .divideError
  let badRatInf : Rat .i64 → Jl (Rat .i8) := fun _ => .error .divideError
  let badFloatInf : Rat .i64 → Jl (JuliaLean.base.float.FV .f16) := fun _ => .error .divideError
  have hresult := h .i8 .i64 .f16 roundDownCounterexample hx hd .down
    badCopy badRatInf badFloatInf
  rcases hresult.2.2 with ⟨out, hrun, hround⟩
  have hout : out = JuliaLean.base.float.floatOfInt .f16 (JInt.lit .i64 2051) := by
    simp [roundRatTypedSource, roundDownCounterexample, badCopy, badFloatInf,
      numeratorRationalSource, denominatorRationalSource, sourceMode, hzero,
      jintOps, JInt.lit, JInt.wrap, wrapInt, IntTy.signed, IntTy.bits,
      hdiv, Bind.bind, Except.bind] at hrun
    simpa [JInt.lit, JInt.wrap, wrapInt, IntTy.signed, IntTy.bits] using hrun.symm
  have hvalue : Fl.toRat (JuliaLean.base.float.floatOfInt .f16 (JInt.lit .i64 2051)) =
      ((2052 : Int), 1) := by decide
  have hnotinf : Fl.isinf (JuliaLean.base.float.floatOfInt .f16 (JInt.lit .i64 2051)) = false := by
    decide
  have hpair : targetPair (JuliaLean.base.float.floatOfInt .f16 (JInt.lit .i64 2051)) =
      ((2052 : Int), 1) := by
    simp [targetPair, hvalue, hnotinf]
  have hn : roundDownCounterexample.num.val = 2051 := by decide
  have hden : roundDownCounterexample.den.val = 1 := by decide
  have horder : compareExtended (targetPair out).1 (targetPair out).2
      roundDownCounterexample.num.val roundDownCounterexample.den.val ≤ 0 := hround.2.1
  rw [hout, hpair, hn, hden] at horder
  have hcmp : compareExtended 2052 1 2051 1 = 1 := by decide
  rw [hcmp] at horder
  exact (by decide : ¬ (1 : Int) ≤ 0) horder

private theorem checkedMulMixedBits_spec6 {t s : IntTy} (a : JInt t) (b : JInt s) :
    let pp := Round4.IntegerParameters.bits (t.promote s)
    (¬ (pp.fits a.val ∧ pp.fits b.val) →
      IsInexact (JuliaLean.base.checked.checkedMulMixedBits a b)) ∧
    ((pp.fits a.val ∧ pp.fits b.val) →
      (pp.fits (a.val * b.val) →
        ∃ out, JuliaLean.base.checked.checkedMulMixedBits a b = .ok out ∧
          out.val = a.val * b.val) ∧
      (¬ pp.fits (a.val * b.val) →
        IsOverflow (JuliaLean.base.checked.checkedMulMixedBits a b))) := by
  intro pp
  let i4 : Round4.IntegerParameters (JInt t) := .bits t
  let j4 : Round4.IntegerParameters (JInt s) := .bits s
  let m4 : Round4.PromotionParameters i4 j4 pp := .bits t s
  have hs := Round4.prom_checkedMulXY_spec m4 a b
  have heq : m4.prom.checkedMulXY a b = JuliaLean.base.checked.checkedMulMixedBits a b := rfl
  constructor

  · intro hnot
    have hnot4 : ¬ Round4.FitsPair pp a.val b.val := by
      change ¬ (pp.fits a.val ∧ pp.fits b.val)
      exact hnot
    rcases hs.1 hnot4 with ⟨msg, herr⟩
    exact ⟨msg, by simpa [heq] using herr⟩
  · intro hf
    have hf4 : Round4.FitsPair pp a.val b.val := by
      change pp.fits a.val ∧ pp.fits b.val
      exact hf
    obtain ⟨hfit, hov⟩ := hs.2 hf4
    refine ⟨?_, ?_⟩
    · intro hfitProd
      obtain ⟨out, hout, houtVal⟩ := hfit hfitProd
      have houtVal' : out.val = a.val * b.val := by
        change out.val = a.val * b.val at houtVal
        exact houtVal
      exact ⟨out, by simpa [heq] using hout, houtVal'⟩
    · intro hnotProd
      rcases hov hnotProd with ⟨msg, herr⟩
      exact ⟨msg, by simpa [heq] using herr⟩

private theorem castInteger_val6 {t s : IntTy} (h : t = s) (x : JInt t) :
    (h ▸ x).val = x.val := by
  cases h
  rfl
private theorem mixed_remainder_outcome_aux
    (t s : IntTy) (x : Rat t) (y : Rat s)
    (hx : Normalized x) (hy : Normalized y) (floorMode : Bool) :
    MixedRemainderOutcome t s x y
      (if floorMode then
        modRatSource (nativePromotion t s)
          (dg (IntegerParameters.bits (t.promote s)) (IntegerParameters.bits (t.promote s)))
          (rational (IntegerParameters.bits (t.promote s))) x y
      else
        remRatSource (nativePromotion t s)
          (dg (IntegerParameters.bits (t.promote s)) (IntegerParameters.bits (t.promote s)))
          (rational (IntegerParameters.bits (t.promote s))) x y)
      floorMode := by
  let q := t.promote s
  let p : IntegerParameters (JInt q) := .bits q
  let g : Int := Nat.gcd x.den.val.natAbs y.den.val.natAbs
  let a := x.num.val * y.den.val.tdiv g
  let b := y.num.val * x.den.val.tdiv g
  let d := x.den.val * y.den.val.tdiv g
  let r := if floorMode then a.fmod b else a.tmod b
  let run := if floorMode then
      modRatSource (nativePromotion t s) (dg p p) (rational p) x y
    else remRatSource (nativePromotion t s) (dg p p) (rational p) x y
  change (g = 0 → run = .error .divideError) ∧
    (g ≠ 0 →
      (¬ p.fits x.num.val → IsInexact run) ∧
      (p.fits x.num.val → ¬ p.fits a → IsOverflow run) ∧
      (p.fits x.num.val → p.fits a → ¬ p.fits y.num.val → IsInexact run) ∧
      (p.fits x.num.val → p.fits a → p.fits y.num.val → ¬ p.fits b → IsOverflow run) ∧
      (p.fits x.num.val → p.fits a → p.fits y.num.val → p.fits b →
        (b = 0 → run = .error .divideError) ∧
        (b ≠ 0 → ¬ p.fits d → IsOverflow run) ∧
        (b ≠ 0 → p.fits d → ConstructorContract p run r d)))
  have hdenX : q.min ≤ x.den.val ∧ x.den.val ≤ q.max :=
    ⟨Int.le_trans (CoreLemmas.min_le_zero q) hx.1,
      Int.le_trans x.den.property.2 (CoreLemmas.max_le_promote_left t s)⟩
  have hdenY : q.min ≤ y.den.val ∧ y.den.val ≤ q.max :=
    ⟨Int.le_trans (CoreLemmas.min_le_zero q) hy.1,
      Int.le_trans y.den.property.2 (CoreLemmas.max_le_promote_right t s)⟩
  have hdenXFit : p.fits x.den.val := by
    change q.min ≤ x.den.val ∧ x.den.val ≤ q.max
    exact hdenX
  have hdenYFit : p.fits y.den.val := by
    change q.min ≤ y.den.val ∧ y.den.val ≤ q.max
    exact hdenY
  let xdenP : JInt q := ⟨x.den.val, hdenX⟩
  let ydenP : JInt q := ⟨y.den.val, hdenY⟩
  have hpromDen :
      (nativePromotion t s).promote x.den y.den =
        (do
          let xp ← JInt.convert (q.name) q x.den.val
          let yp ← JInt.convert (q.name) q y.den.val
          pure (xp, yp)) := rfl
  have hpromDenOk :
      (nativePromotion t s).promote x.den y.den = .ok (xdenP, ydenP) := by
    rw [hpromDen, CoreLemmas.convert_of_fits hdenX, CoreLemmas.convert_of_fits hdenY]
    rfl
  have hdgEq : dg p p = DivGcdCtorLemmas.dgBits := rfl
  have hAbsX : t.promote q = q := (promote_absorption_proven t s).1
  have hAbsY : s.promote q = q := (promote_absorption_proven t s).2.1
  have hFitsX (z : Int) :
