    IntTy.i128.min ≤ x.val ∧ x.val ≤ IntTy.i128.max := by
  have hx := x.property
  cases t <;> simp [IntTy.min, IntTy.max, IntTy.bits, IntTy.signed] at hx ⊢
  all_goals first | omega | exact False.elim (ht.1 rfl) | exact False.elim (ht.2 rfl)

