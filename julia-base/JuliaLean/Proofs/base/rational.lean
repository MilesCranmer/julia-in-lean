      (JuliaLean.base.complex.isreal_Complex (isZeroRationalSource (jintOps t).iszero))
      cre (eqRatSource JuliaLean.base.int.eq JuliaLean.base.int.eq) z x = decide expected ∧
    eqRatComplexSource
      (JuliaLean.base.complex.isreal_Complex (isZeroRationalSource (jintOps t).iszero))
      cre (eqRatSource JuliaLean.base.int.eq JuliaLean.base.int.eq) x z = decide expected := by
  intro expected
  unfold eqComplexRatSource eqComplexRatMethod eqRatComplexSource eqRatComplexMethod bwand Bind.bind Id.instMonad
    JuliaLean.base.complex.isreal_Complex cre JuliaLean.base.complex.real_Complex
    JuliaLean.base.complex.imag_Complex isZeroRationalSource numeratorRationalSource jintOps
  dsimp only
  rw [eqRat_normalized_iff z.re x hr hx]
  have hbwand : (match (z.im.num.val == 0),
        decide (ComparisonAndRoundingLemmas.compareExtended z.re.num.val z.re.den.val x.num.val x.den.val = 0) with
      | true, true => true | _, _ => false) = decide expected := by
    unfold expected compareExtended ComparisonAndRoundingLemmas.compareExtended
    by_cases h1 : z.im.num.val = 0 <;>
      by_cases h2 : (if z.re.den.val = 0 then if x.den.val = 0 then intCmp (intSign z.re.num.val) (intSign x.num.val) else intSign z.re.num.val else if x.den.val = 0 then -intSign x.num.val else intCmp (z.re.num.val * x.den.val) (x.num.val * z.re.den.val)) = 0 <;>
      simp [h1, h2]
  exact ⟨hbwand, hbwand⟩



theorem quotientOutcome_of_divBitIntegerMode (t : IntTy) (a b : JInt t) (mode : Rounding) :
    QuotientOutcome (.bits t) (JuliaLean.base.div.divBitIntegerMode a b (sourceMode mode))
      a.val b.val mode := by
  have hmode : sourceMode mode = sourceRoundingMode mode := by cases mode <;> rfl
  have h := divBitIntegerMode_spec a b mode
  rw [hmode]
  exact ⟨h.1, h.2.1, h.2.2⟩

private theorem checkedMulBits_spec {t : IntTy} (a b : JInt t) :
    ((IntegerParameters.bits t).fits (a.val * b.val) →
      ∃ r, JuliaLean.base.checked.checkedMulBits a b = .ok r ∧ r.val = a.val * b.val) ∧
    (¬ (IntegerParameters.bits t).fits (a.val * b.val) →
      IsOverflow (JuliaLean.base.checked.checkedMulBits a b)) := by
  have h := JuliaLean.Proofs.base.checked.mulExact t a b
  unfold JuliaLean.Proofs.base.checked.ExactOrOverflow at h
  by_cases hf : t.min ≤ a.val * b.val ∧ a.val * b.val ≤ t.max
  · simp only [if_pos hf] at h; exact ⟨fun _ => h, fun hn => absurd hf hn⟩
  · simp only [if_neg hf] at h
    refine ⟨fun hc => absurd hc hf, fun _ => ?_⟩
    cases hcall : JuliaLean.base.checked.checkedMulBits a b with
    | ok _ => rw [hcall] at h; contradiction
    | error err => rw [hcall] at h; cases err <;> first | contradiction | exact ⟨_, rfl⟩

private theorem checkedMulMixedBits_spec {t s : IntTy} (a : JInt t) (b : JInt s) :
    let pp := Round4.IntegerParameters.bits (t.promote s)
    (¬ (pp.fits a.val ∧ pp.fits b.val) →
      IsInexact (JuliaLean.base.checked.checkedMulMixedBits a b)) ∧
    ((pp.fits a.val ∧ pp.fits b.val) →
      (pp.fits (a.val * b.val) →
        ∃ out, JuliaLean.base.checked.checkedMulMixedBits a b = .ok out ∧
          out.val = a.val * b.val) ∧
      (¬ pp.fits (a.val * b.val) →
        IsOverflow (JuliaLean.base.checked.checkedMulMixedBits a b))) := by
  intro pp
  let i4 : Round4.IntegerParameters (JInt t) := .bits t
  let j4 : Round4.IntegerParameters (JInt s) := .bits s
  let m4 : Round4.PromotionParameters i4 j4 pp := .bits t s
  have hs := Round4.prom_checkedMulXY_spec m4 a b
  have heq : m4.prom.checkedMulXY a b = JuliaLean.base.checked.checkedMulMixedBits a b := rfl
  constructor
  · intro hnot
    have hnot4 : ¬ Round4.FitsPair pp a.val b.val := by
      change ¬ (pp.fits a.val ∧ pp.fits b.val)
      exact hnot
    rcases hs.1 hnot4 with ⟨msg, herr⟩
    exact ⟨msg, by simpa [heq] using herr⟩
  · intro hf
    have hf4 : Round4.FitsPair pp a.val b.val := by
      change pp.fits a.val ∧ pp.fits b.val
      exact hf
    obtain ⟨hfit, hov⟩ := hs.2 hf4
    refine ⟨?_, ?_⟩
    · intro hfitProd
      obtain ⟨out, hout, houtVal⟩ := hfit hfitProd
      have houtVal' : out.val = a.val * b.val := by
        change out.val = a.val * b.val at houtVal
        exact houtVal
      exact ⟨out, by simpa [heq] using hout, houtVal'⟩
    · intro hnotProd
      rcases hov hnotProd with ⟨msg, herr⟩
      exact ⟨msg, by simpa [heq] using herr⟩

theorem mixed_rounded_rationals_aux : mixed_rounded_rationals := by
  intro t s x y mode hx hy p gn gd xn yn xd yd n d cn cd run
  have hdg_eq : dg (.bits t) (.bits s) = dgBits := rfl
  have hdg_n := dgBits_spec x.num y.num
  have hdg_d := dgBits_spec x.den y.den
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_⟩
  · intro hzero
    unfold run divRationalRationalRoundedSource
    rw [hdg_eq]
    rcases hzero with hgn0 | hgd0
    · rw [hdg_n.1 hgn0]; rfl
    · by_cases hgn0 : gn = 0
      · rw [hdg_n.1 hgn0]; rfl
      · obtain ⟨xnJ, ynJ, hnum, _, _, _, _, _, _, _, _, _, _⟩ := hdg_n.2 hgn0
        rw [hnum, hdg_d.1 hgd0]
        rfl
  · intro hgn hgd hnotCn
    obtain ⟨xnJ, ynJ, hnum, hxnVal, hynVal, _, _, _, _, _, _, _, _⟩ := hdg_n.2 hgn
    obtain ⟨xdJ, ydJ, hden, hxdVal, hydVal, _, _, _, _, _, _, _, _⟩ := hdg_d.2 hgd
    unfold run divRationalRationalRoundedSource
    rw [hdg_eq, hnum, hden]
    dsimp only [Bind.bind, Except.bind]
    have hnotMul : ¬
        ((Round4.IntegerParameters.bits (t.promote s)).fits xnJ.val ∧
          (Round4.IntegerParameters.bits (t.promote s)).fits ydJ.val) := by
      intro hfit
      apply hnotCn
      change p.fits xn ∧ p.fits yd
      constructor
      · simpa [p, IntegerParameters.fits, Round4.IntegerParameters.fits, hxnVal] using hfit.1
      · simpa [p, IntegerParameters.fits, Round4.IntegerParameters.fits, hydVal] using hfit.2
    obtain ⟨msg, herr⟩ := (checkedMulMixedBits_spec xnJ ydJ).1 hnotMul
    rw [herr]
    exact ⟨msg, rfl⟩
  · intro hgn hgd hcn hnotN
    obtain ⟨xnJ, ynJ, hnum, hxnVal, hynVal, _, _, _, _, _, _, _, _⟩ := hdg_n.2 hgn
    obtain ⟨xdJ, ydJ, hden, hxdVal, hydVal, _, _, _, _, _, _, _, _⟩ := hdg_d.2 hgd
    unfold run divRationalRationalRoundedSource
    rw [hdg_eq, hnum, hden]
    dsimp only [Bind.bind, Except.bind]
    have hfitMul1 :
        (Round4.IntegerParameters.bits (t.promote s)).fits xnJ.val ∧
        (Round4.IntegerParameters.bits (t.promote s)).fits ydJ.val := by
      simpa [p, cn, IntegerParameters.fits, Round4.IntegerParameters.fits, hxnVal, hydVal] using hcn
    have hnotProd : ¬ (Round4.IntegerParameters.bits (t.promote s)).fits (xnJ.val * ydJ.val) := by
      intro hfit
      apply hnotN
      simpa [p, n, IntegerParameters.fits, Round4.IntegerParameters.fits, hxnVal, hydVal] using hfit
    obtain ⟨_, hoverflow⟩ := (checkedMulMixedBits_spec xnJ ydJ).2 hfitMul1
    rcases hoverflow hnotProd with ⟨msg, herr⟩
    rw [herr]
    exact ⟨msg, rfl⟩
  · intro hgn hgd hcn hpn hnotCd
    obtain ⟨xnJ, ynJ, hnum, hxnVal, hynVal, _, _, _, _, _, _, _, _⟩ := hdg_n.2 hgn
    obtain ⟨xdJ, ydJ, hden, hxdVal, hydVal, _, _, _, _, _, _, _, _⟩ := hdg_d.2 hgd
    unfold run divRationalRationalRoundedSource
    rw [hdg_eq, hnum, hden]
    dsimp only [Bind.bind, Except.bind]
    have hfitMul1 :
        (Round4.IntegerParameters.bits (t.promote s)).fits xnJ.val ∧
        (Round4.IntegerParameters.bits (t.promote s)).fits ydJ.val := by
      simpa [p, cn, IntegerParameters.fits, Round4.IntegerParameters.fits, hxnVal, hydVal] using hcn
    have hfitN : (Round4.IntegerParameters.bits (t.promote s)).fits (xnJ.val * ydJ.val) := by
      simpa [p, n, IntegerParameters.fits, Round4.IntegerParameters.fits, hxnVal, hydVal] using hpn
    obtain ⟨_, ha_ok, _⟩ := ((checkedMulMixedBits_spec xnJ ydJ).2 hfitMul1).1 hfitN
    rw [ha_ok]
    dsimp only [Bind.bind, Except.bind]
    have hnotMul2 :
        ¬ ((Round4.IntegerParameters.bits (t.promote s)).fits xdJ.val ∧
          (Round4.IntegerParameters.bits (t.promote s)).fits ynJ.val) := by
      intro hfit
      apply hnotCd
      change p.fits xd ∧ p.fits yn
      constructor
      · simpa [p, IntegerParameters.fits, Round4.IntegerParameters.fits, hxdVal] using hfit.1
      · simpa [p, IntegerParameters.fits, Round4.IntegerParameters.fits, hynVal] using hfit.2
    obtain ⟨msg, herr⟩ := (checkedMulMixedBits_spec xdJ ynJ).1 hnotMul2
    rw [herr]
    exact ⟨msg, rfl⟩
  · intro hgn hgd hcn hpn hcd hnotD
    obtain ⟨xnJ, ynJ, hnum, hxnVal, hynVal, _, _, _, _, _, _, _, _⟩ := hdg_n.2 hgn
    obtain ⟨xdJ, ydJ, hden, hxdVal, hydVal, _, _, _, _, _, _, _, _⟩ := hdg_d.2 hgd
    unfold run divRationalRationalRoundedSource
    rw [hdg_eq, hnum, hden]
    dsimp only [Bind.bind, Except.bind]
    have hfitMul1 :
        (Round4.IntegerParameters.bits (t.promote s)).fits xnJ.val ∧
        (Round4.IntegerParameters.bits (t.promote s)).fits ydJ.val := by
      simpa [p, cn, IntegerParameters.fits, Round4.IntegerParameters.fits, hxnVal, hydVal] using hcn
    have hfitMul2 :
        (Round4.IntegerParameters.bits (t.promote s)).fits xdJ.val ∧
        (Round4.IntegerParameters.bits (t.promote s)).fits ynJ.val := by
      simpa [p, cd, IntegerParameters.fits, Round4.IntegerParameters.fits, hxdVal, hynVal] using hcd
    have hfitN : (Round4.IntegerParameters.bits (t.promote s)).fits (xnJ.val * ydJ.val) := by
      simpa [p, n, IntegerParameters.fits, Round4.IntegerParameters.fits, hxnVal, hydVal] using hpn
    have hnotProd : ¬ (Round4.IntegerParameters.bits (t.promote s)).fits (xdJ.val * ynJ.val) := by
      intro hfit
      apply hnotD
      simpa [p, d, IntegerParameters.fits, Round4.IntegerParameters.fits, hxdVal, hynVal] using hfit
    obtain ⟨_, ha_ok, _⟩ := ((checkedMulMixedBits_spec xnJ ydJ).2 hfitMul1).1 hfitN
    rw [ha_ok]
    dsimp only [Bind.bind, Except.bind]
    obtain ⟨_, hoverflow⟩ := (checkedMulMixedBits_spec xdJ ynJ).2 hfitMul2
    rcases hoverflow hnotProd with ⟨msg, herr⟩
    rw [herr]
    exact ⟨msg, rfl⟩
  · intro hgn hgd hcn hcd hpair
    obtain ⟨xnJ, ynJ, hnum, hxnVal, hynVal, _, _, _, _, _, _, _, _⟩ := hdg_n.2 hgn
    obtain ⟨xdJ, ydJ, hden, hxdVal, hydVal, _, _, _, _, _, _, _, _⟩ := hdg_d.2 hgd
    unfold run divRationalRationalRoundedSource
    rw [hdg_eq, hnum, hden]
    dsimp only [Bind.bind, Except.bind]
    rcases hpair with ⟨hpn, hpd⟩
    have hfitMul1 :
        (Round4.IntegerParameters.bits (t.promote s)).fits xnJ.val ∧
        (Round4.IntegerParameters.bits (t.promote s)).fits ydJ.val := by
      simpa [p, cn, IntegerParameters.fits, Round4.IntegerParameters.fits, hxnVal, hydVal] using hcn
    have hfitMul2 :
        (Round4.IntegerParameters.bits (t.promote s)).fits xdJ.val ∧
        (Round4.IntegerParameters.bits (t.promote s)).fits ynJ.val := by
      simpa [p, cd, IntegerParameters.fits, Round4.IntegerParameters.fits, hxdVal, hynVal] using hcd
    have hfitN : (Round4.IntegerParameters.bits (t.promote s)).fits (xnJ.val * ydJ.val) := by
      simpa [p, n, IntegerParameters.fits, Round4.IntegerParameters.fits, hxnVal, hydVal] using hpn
    have hfitD : (Round4.IntegerParameters.bits (t.promote s)).fits (xdJ.val * ynJ.val) := by
      simpa [p, d, IntegerParameters.fits, Round4.IntegerParameters.fits, hxdVal, hynVal] using hpd
    obtain ⟨a, ha_ok, haVal⟩ := ((checkedMulMixedBits_spec xnJ ydJ).2 hfitMul1).1 hfitN
    obtain ⟨b, hb_ok, hbVal⟩ := ((checkedMulMixedBits_spec xdJ ynJ).2 hfitMul2).1 hfitD
    rw [ha_ok, hb_ok]
    dsimp only [Bind.bind, Except.bind]
    have hq := quotientOutcome_of_divBitIntegerMode (t.promote s) a b mode
    have haVal' : a.val = n := by simpa [n, hxnVal, hydVal] using haVal
    have hbVal' : b.val = d := by simpa [d, hxdVal, hynVal] using hbVal
    rw [haVal', hbVal'] at hq
    exact hq


private theorem promote_same_sign_signed {t s : IntTy}
    (hs : t.signed = s.signed) : (t.promote s).signed = t.signed := by
  cases ht : t.signed with
  | false =>
    have hs' : s.signed = false := by rw [← hs, ht]
    have hp := JuliaLean.Proofs.base.rational.CoreLemmas.promote_unsigned ht hs'
    exact hp
  | true =>
    have hs' : s.signed = true := by rw [← hs, ht]
    have hp := JuliaLean.Proofs.base.int.promote_signed ht hs'
    exact hp

private theorem sameSignMode_quotientOutcome {t s : IntTy}
    (hs : t.signed = s.signed) (a : JInt t) (b : JInt s) (mode : Rounding) :
    QuotientOutcome (.bits (t.promote s)) (sameSignMode a b mode) a.val b.val mode := by
  have hdiv := quotientOutcome_of_divBitIntegerMode (t.promote s)
    (JuliaLean.base.int.promoteSameSign a b).1
    (JuliaLean.base.int.promoteSameSign a b).2 mode
  have ha : (JuliaLean.base.int.promoteSameSign a b).1.val = a.val := by
    change (JuliaLean.base.int.widenTo (t.promote s) a).val = a.val
    rw [JuliaLean.Proofs.base.int.widenTo_val,
      JuliaLean.Proofs.base.int.widen_promote_left hs]
  have hb : (JuliaLean.base.int.promoteSameSign a b).2.val = b.val := by
    change (JuliaLean.base.int.widenTo (t.promote s) b).val = b.val
    rw [JuliaLean.Proofs.base.int.widenTo_val,
      JuliaLean.Proofs.base.int.widen_promote_right hs]
  simpa [sameSignMode, ha, hb] using hdiv

theorem mixed_rounded_scalars_aux : mixed_rounded_scalars := by
  intro t s signedness x k mode hx p qr ql g n y d a ri ir
  have hsTP : t.signed = (t.promote s).signed :=
    (promote_same_sign_signed signedness).symm
  have hsST : (s.promote t).signed = t.signed :=
    (promote_same_sign_signed signedness.symm).trans signedness.symm
  have hdg_ri : dg (.bits t) (.bits s) = dgBits := rfl
  have hdg_ir : dg (.bits s) (.bits t) = dgBits := rfl
  have hg_ri := dgBits_spec x.num k
  have hg_ir := dgBits_spec k x.num

  have hgsym : (Nat.gcd k.val.natAbs x.num.val.natAbs : Int) = g := by
    dsimp [g]
    rw [Nat.gcd_comm]
  refine ⟨?_, ?_, ?_⟩
  · intro hg0
    unfold ri ir divRationalIntegerRoundedSource divIntegerRationalRoundedSource
    rw [hdg_ri, hdg_ir, hg_ri.1 hg0, hg_ir.1 (hgsym.trans hg0)]
    exact ⟨rfl, rfl⟩
  · intro hg hfits
    obtain ⟨xnJ, yJ, hrun, hnVal, hyVal, _, _, _, _, _, _, _, _⟩ := hg_ri.2 hg
    unfold ri divRationalIntegerRoundedSource
    rw [hdg_ri, hrun]
    dsimp only [Bind.bind, Except.bind]
    have hfitMul :
        (Round4.IntegerParameters.bits (t.promote s)).fits x.den.val ∧
        (Round4.IntegerParameters.bits (t.promote s)).fits yJ.val := by
      simpa [p, y, IntegerParameters.fits, Round4.IntegerParameters.fits, hyVal] using hfits
    refine ⟨?_, ?_⟩
    · intro hfitD
      have hfitProd : (Round4.IntegerParameters.bits (t.promote s)).fits
          (x.den.val * yJ.val) := by
        simpa [p, d, y, IntegerParameters.fits, Round4.IntegerParameters.fits, hyVal] using hfitD
      obtain ⟨dJ, hd_ok, hdVal⟩ :=
        ((checkedMulMixedBits_spec x.den yJ).2 hfitMul).1 hfitProd
      rw [hd_ok]
      dsimp only [Bind.bind, Except.bind]
      have hq := sameSignMode_quotientOutcome hsTP xnJ dJ mode
      have hnVal' : xnJ.val = n := by simpa [n] using hnVal
      have hdVal' : dJ.val = d := by simpa [d, y, hyVal] using hdVal
      rw [hnVal', hdVal'] at hq
      exact hq
    · intro hnotD
      have hnotProd : ¬ (Round4.IntegerParameters.bits (t.promote s)).fits
          (x.den.val * yJ.val) := by
        intro hfit
        apply hnotD
        simpa [p, d, y, IntegerParameters.fits, Round4.IntegerParameters.fits, hyVal] using hfit
      obtain ⟨_, hoverflow⟩ := (checkedMulMixedBits_spec x.den yJ).2 hfitMul
      rcases hoverflow hnotProd with ⟨msg, herr⟩
      rw [herr]
      exact ⟨msg, rfl⟩
  · intro hg hfits
    have hgInvNZ : (Nat.gcd k.val.natAbs x.num.val.natAbs : Int) ≠ 0 := by
      intro hg0'
      apply hg
      calc
        g = (Nat.gcd k.val.natAbs x.num.val.natAbs : Int) := hgsym.symm
        _ = 0 := hg0'
    obtain ⟨yJ, xnJ, hrun, hyVal, hnVal, _, _, _, _, _, _, _, _⟩ := hg_ir.2 hgInvNZ
    have hyValG : yJ.val = y := by
      rw [hyVal, hgsym]
    have hnValG : xnJ.val = n := by
      rw [hnVal, hgsym]
    unfold ir divIntegerRationalRoundedSource
    rw [hdg_ir, hrun]
    dsimp only [Bind.bind, Except.bind]
    have hfitMul :
        (Round4.IntegerParameters.bits (s.promote t)).fits yJ.val ∧
        (Round4.IntegerParameters.bits (s.promote t)).fits x.den.val := by
      simpa [y, IntegerParameters.fits, Round4.IntegerParameters.fits, hyValG] using hfits
    refine ⟨?_, ?_⟩
    · intro hfitA
      have hfitProd : (Round4.IntegerParameters.bits (s.promote t)).fits
          (yJ.val * x.den.val) := by
        simpa [a, y, IntegerParameters.fits, Round4.IntegerParameters.fits, hyValG] using hfitA
      obtain ⟨aJ, ha_ok, haVal⟩ :=
        ((checkedMulMixedBits_spec yJ x.den).2 hfitMul).1 hfitProd
      rw [ha_ok]
      dsimp only [Bind.bind, Except.bind]
      have hq := sameSignMode_quotientOutcome hsST aJ xnJ mode
      have haVal' : aJ.val = a := by simpa [a, y, hyValG] using haVal
      have hnVal' : xnJ.val = n := hnValG
      rw [haVal', hnVal'] at hq
      exact hq
    · intro hnotA
      have hnotProd : ¬ (Round4.IntegerParameters.bits (s.promote t)).fits
          (yJ.val * x.den.val) := by
        intro hfit
        apply hnotA
        simpa [a, y, IntegerParameters.fits, Round4.IntegerParameters.fits, hyValG] using hfit
      obtain ⟨_, hoverflow⟩ := (checkedMulMixedBits_spec yJ x.den).2 hfitMul
      rcases hoverflow hnotProd with ⟨msg, herr⟩
      rw [herr]
      exact ⟨msg, rfl⟩
theorem rounded_quotients_aux {T : Type} (i : IntegerParameters T)
    (x y : Rational T) (k : T) (mode : Rounding)
    (_hx : Canonical i x) (_hy : Canonical i y) :
    let gn : Int := Nat.gcd (rn i x).natAbs (rn i y).natAbs
    let gd : Int := Nat.gcd (rd i x).natAbs (rd i y).natAbs
    let n := (rn i x).tdiv gn * (rd i y).tdiv gd
    let d := (rd i x).tdiv gd * (rn i y).tdiv gn
    let gk : Int := Nat.gcd (rn i x).natAbs (val i k).natAbs
    let nk := (rn i x).tdiv gk
    let dk := rd i x*(val i k).tdiv gk
    let gr : Int := Nat.gcd (val i k).natAbs (rn i x).natAbs
    let nr := (val i k).tdiv gr*rd i x
    let dr := (rn i x).tdiv gr
    let rr := divRationalRationalRoundedSource (dg i i) (dg i i)
      i.ops.checkedMul i.ops.checkedMul i.ops.divRound x y mode
    let ri := divRationalIntegerRoundedSource (dg i i) i.ops.checkedMul i.ops.divRound x k mode
    let ir := divIntegerRationalRoundedSource (dg i i) i.ops.checkedMul i.ops.divRound k x mode
    ((gn = 0 ∨ gd = 0) → rr = .error .divideError) ∧
    (gn ≠ 0 → gd ≠ 0 → ¬ FitsPair i n d → IsOverflow rr) ∧
    (gn ≠ 0 → gd ≠ 0 → FitsPair i n d → QuotientOutcome i rr n d mode) ∧
    (gk = 0 → ri = .error .divideError) ∧
    (gk ≠ 0 → ¬ i.fits dk → IsOverflow ri) ∧
    (gk ≠ 0 → i.fits dk → QuotientOutcome i ri nk dk mode) ∧
    (gr = 0 → ir = .error .divideError) ∧
    (gr ≠ 0 → ¬ i.fits nr → IsOverflow ir) ∧
    (gr ≠ 0 → i.fits nr → QuotientOutcome i ir nr dr mode) := by
  intro gn gd n d gk nk dk gr nr dr rr ri ir
  cases i with | bits t =>
  have hdg_eq : dg (.bits t) (.bits t) = dgBits := rfl
  have hdg_n := dgBits_spec x.num y.num
  have hdg_d := dgBits_spec x.den y.den
  have hdg_k := dgBits_spec x.num k
  have hdg_r := dgBits_spec k x.num
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · intro h0
    unfold rr divRationalRationalRoundedSource; rw [hdg_eq]
    rcases h0 with hgn0 | hgd0
    · rw [hdg_n.1 hgn0]; rfl
    · by_cases hgn0 : gn = 0
      · rw [hdg_n.1 hgn0]; rfl
      · obtain ⟨xn, yn, h1, _, _, _, _, _, _, _, _, _, _⟩ := hdg_n.2 hgn0
        rw [h1, hdg_d.1 hgd0]; rfl
  · intro hgn hgd hnot_fp
    obtain ⟨xn, yn, h1, hxn_v, hyn_v, _, _, _, _, _, _, _, _⟩ := hdg_n.2 hgn
    obtain ⟨xd, yd, h2, hxd_v, hyd_v, _, _, _, _, _, _, _, _⟩ := hdg_d.2 hgd
