  unfold invRatSource checkedDenSameSource
  have hcd := checkedDenBits_spec (jintOps t) rfl rfl x.den x.num
  have hnorm : Normalized x := hx
  refine ⟨fun hn0 => ?_, fun hnz hfit_d hfit_n => ?_, fun hn_lt hnot => ?_⟩
  · change x.num.val = 0 at hn0
    have hd1 : x.den.val = 1 := (normalized_extremes_full hnorm).1 hn0
    have hok := hcd.1 (by omega)
    exact ⟨⟨x.den, x.num⟩, hok, hd1, hn0⟩
  · by_cases hn_lt : x.num.val < 0
    · change (IntegerParameters.bits t).fits (if x.num.val < 0 then -x.den.val else x.den.val) at hfit_d
      rw [if_pos hn_lt] at hfit_d
      have hfit_neg_n : t.min ≤ -x.num.val ∧ -x.num.val ≤ t.max := by
        have habs : (x.num.val.natAbs : Int) = -x.num.val := Int.ofNat_natAbs_of_nonpos (by omega)
        rw [← habs]; exact hfit_n
      obtain ⟨q, hq_ok, hq_den_pos, hq_num, hq_den⟩ := hcd.2.1 hn_lt hfit_neg_n hfit_d
      refine ⟨q, hq_ok, ⟨⟨Int.le_of_lt hq_den_pos, ?_⟩,
        by change q.num.val * x.num.val = x.den.val * q.den.val; rw [hq_num, hq_den, Int.neg_mul, Int.mul_neg],
        fun _ => hq_den_pos, fun h => absurd h hnz⟩⟩
      change Nat.gcd q.num.val.natAbs q.den.val.natAbs = 1
      rw [hq_num, hq_den, Int.natAbs_neg, Int.natAbs_neg, Nat.gcd_comm]
      exact hx.2
