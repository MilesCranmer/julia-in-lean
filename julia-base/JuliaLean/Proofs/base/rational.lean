private theorem halfHashReduce (t : IntTy) (h64 : t ≠ .i128 ∧ t ≠ .u128) (n : JInt t)
    (seed : JInt .u64) (hashInt : JInt t → JInt .u64 → JInt .u64)
    (hashFloat : JuliaLean.base.float.FV .f64 → JInt .u64 → JInt .u64)
    (hashInteger : {u : IntTy} → JInt u → JInt .u64 → JInt .u64)
    (ldexp : JuliaLean.base.float.FV .f64 → JInt .i64 → JuliaLean.base.float.FV .f64)
    (maxintfloat : JuliaLean.base.float.FV .f64 → JInt .u64)
    (hbound : JuliaLean.base.int.lt_BitUnsigned
      (JuliaLean.base.int.widenTo .u64 (JuliaLean.base.float.uabs n))
      (maxintfloat (JuliaLean.base.float.one_float .f64)) = true) :
    hashRational64Source h64 hashInt hashFloat hashInteger ldexp maxintfloat (jintOps t).isodd
      JuliaLean.base.int.trailing_zeros JuliaLean.base.int.shr_Int JuliaLean.base.int.shl_Int
      ⟨n, JInt.lit t 2⟩ seed =
      hashFloat (ldexp (JuliaLean.base.float.floatOfInt .f64 n) (JInt.lit .i64 (-1))) seed := by
  have htwo : (JInt.lit t 2).val = 2 := by cases t <;> decide
  have hodd : (jintOps t).isodd (JInt.lit t 2) = false := by cases t <;> decide
  have htrail : JuliaLean.base.int.trailing_zeros (JInt.lit t 2) = JInt.lit .i64 1 := by
    cases t <;> decide
  have hshift : (JuliaLean.base.int.shr_Int (JInt.lit t 2) (JInt.lit .i64 1)).val = 1 := by
    cases t <;> decide
  have hneg : -(JInt.lit .i64 1) = JInt.lit .i64 (-1) := by decide
  simp [hashRational64Source, numeratorRationalSource, denominatorRationalSource, htwo, hodd,
    htrail, hshift, hneg, hbound]

/-- Two floats with the same nonzero order key are the same bit pattern. -/
private theorem flEqOfKey {f : Fmt} (a b : Fl f) (hk : a.key = b.key) (h0 : a.key ≠ 0) :
    a = b := by
  have hsplitA := (Fl.bits_split a).1
  have hsplitB := (Fl.bits_split b).1
  unfold Fl.key at hk h0
  have hm : JuliaLean.Proofs.base.float.magKey f a.magnitude =
      JuliaLean.Proofs.base.float.magKey f b.magnitude ∧ a.signbit = b.signbit := by
    cases ha : a.signbit <;> cases hb : b.signbit <;>
      simp only [ha, hb, Bool.false_eq_true, ↓reduceIte] at hk h0 <;>
      first | exact ⟨by omega, rfl⟩ | (exfalso; omega)
  have hmag : a.magnitude = b.magnitude := by
    rcases Nat.lt_trichotomy a.magnitude b.magnitude with h | h | h
    · have := JuliaLean.Proofs.base.float.magKey_strictMono f h; omega
    · exact h
    · have := JuliaLean.Proofs.base.float.magKey_strictMono f h; omega
  have hbits : a.toBits = b.toBits := by rw [hsplitA, hsplitB, hm.2, hmag]
  show Fl.mk a.bits = Fl.mk b.bits
  exact congrArg Fl.mk (Fin.ext hbits)


private abbrev f64den : Nat := (JuliaLean.base.float.FTy.f64).fmt.den

private theorem f64den_split : f64den = 2 ^ 52 * 2 ^ 1022 := by
  rw [← Nat.pow_add]
  rfl

/-- An odd `n` below `2^53`: `ldexp(Float64(n), -1)` is finite with half the key of `Float64(n)`. -/
private theorem ldexpHalfKey (o : JuliaLean.base.math.IEEEOps .f64) (n : Int)
    (hn : n.natAbs < 2 ^ 53) (hn0 : n ≠ 0) :
    (JuliaLean.base.math.ldexp o (Fl.ofInt n : JuliaLean.base.float.FV .f64) (-1)).isfinite = true ∧
    (JuliaLean.base.math.ldexp o (Fl.ofInt n : JuliaLean.base.float.FV .f64) (-1)).key * 2 =
      n * (f64den : Int) := by
  have hf := JuliaLean.Proofs.base.float.good_fty .f64
  obtain ⟨hyfin, hykey⟩ := Fl.ofInt_key hf n (by show n.natAbs < 2 ^ 53; exact hn)
  change (Fl.ofInt n : JuliaLean.base.float.FV .f64).key = n * (f64den : Int) at hykey
  generalize hy : (Fl.ofInt n : JuliaLean.base.float.FV .f64) = y at hyfin hykey ⊢
  have hemax : (JuliaLean.base.float.FTy.f64).fmt.emax = 2047 := rfl
  have hsb : (JuliaLean.base.float.FTy.f64).fmt.sb = 52 := rfl
  have hEne : y.expField ≠ 2047 := by
    have := hyfin
    simp only [Fl.isfinite, bne_iff_ne, ne_eq] at this
    rw [hemax] at this
    exact this
  have hElt : y.expField < 2048 := by
    unfold Fl.expField
    exact Nat.mod_lt _ (Nat.two_pow_pos _)
  have hmagKey : JuliaLean.Proofs.base.float.magKey (JuliaLean.base.float.FTy.f64).fmt y.magnitude =
      n.natAbs * f64den := by
    rw [← JuliaLean.Proofs.base.float.RemainderProofs.key_natAbs y, hykey, Int.natAbs_mul]
    rfl
  have hE : 1023 ≤ y.expField := by
    have hlt := JuliaLean.Proofs.base.float.magKey_lt (JuliaLean.base.float.FTy.f64).fmt y.magnitude
    rw [hmagKey, ← Fl.expField_eq, hsb] at hlt
    apply Classical.byContradiction
    intro hle
    have hp : 2 ^ y.expField ≤ 2 ^ 1022 := Nat.pow_le_pow_right (by decide) (by omega)
    have hle2 : 2 ^ 52 * 2 ^ y.expField ≤ f64den := by
      rw [f64den_split]; exact Nat.mul_le_mul_left _ hp
    have hle3 : f64den ≤ n.natAbs * f64den := Nat.le_mul_of_pos_left _ (by omega)
    exact Nat.lt_irrefl _ (Nat.lt_of_lt_of_le hlt (Nat.le_trans hle2 hle3))
  have hEint : (y.expField : Int) + -1 > 0 := by omega
  rw [JuliaLean.Proofs.base.math.mfLdexpNormal o y (-1) hyfin (by omega) (by omega) (by omega),
    if_neg (by rw [hemax]; omega), if_pos hEint]
  have htoNat : ((y.expField : Int) + -1).toNat = y.expField - 1 := by omega
  rw [htoNat]
  have hfr : y.frac < 2 ^ (JuliaLean.base.float.FTy.f64).fmt.sb := by
    unfold Fl.frac
    exact Nat.mod_lt _ (Nat.two_pow_pos _)
  obtain ⟨hs, hEx, hF, -, hfin, -⟩ :=
    JuliaLean.Proofs.base.math.mfEncodeParts .f64 y.signbit (y.expField - 1) y.frac
      (by rw [hemax]; omega) hfr
  refine ⟨hfin, ?_⟩
  generalize hL : JuliaLean.Proofs.base.float.NextProofs.encode JuliaLean.base.float.FTy.f64 y.signbit
    ((y.expField - 1) * 2 ^ (JuliaLean.base.float.FTy.f64).fmt.sb + y.frac) = L at hs hEx hF
  have hLkey : L.key = if y.signbit
      then -((((y.frac + 2 ^ (JuliaLean.base.float.FTy.f64).fmt.sb) * 2 ^ (y.expField - 1 - 1)) : Nat) : Int)
      else ((((y.frac + 2 ^ (JuliaLean.base.float.FTy.f64).fmt.sb) * 2 ^ (y.expField - 1 - 1)) : Nat) : Int) := by
    rw [JuliaLean.Proofs.base.float.EpsilonProofs.key_fields L, hs, hEx, hF,
      if_neg (show y.expField - 1 ≠ 0 by omega)]
  have hpow : 2 ^ (y.expField - 1) = 2 ^ (y.expField - 1 - 1) * 2 := by
    rw [← Nat.pow_succ]
    congr 1
    omega
  have hYkey : y.key = if y.signbit
      then -((((y.frac + 2 ^ (JuliaLean.base.float.FTy.f64).fmt.sb) * 2 ^ (y.expField - 1 - 1)) * 2 : Nat) : Int)
      else ((((y.frac + 2 ^ (JuliaLean.base.float.FTy.f64).fmt.sb) * 2 ^ (y.expField - 1 - 1)) * 2 : Nat) : Int) := by
    rw [JuliaLean.Proofs.base.float.EpsilonProofs.key_fields y,
      if_neg (show y.expField ≠ 0 by omega), hpow, Nat.mul_assoc]
  rw [← hykey, hLkey, hYkey]
  generalize (y.frac + 2 ^ (JuliaLean.base.float.FTy.f64).fmt.sb) * 2 ^ (y.expField - 1 - 1) = A
  split <;> push_cast <;> omega

theorem hash_value_proven : JuliaLean.Statements.rational.Round11.hash_value := by
  intro t ht o q seed hq hhalf x hx hval
  obtain ⟨num, den⟩ := q
  have htwo : (JInt.lit t 2).val = 2 := by cases t <;> decide
  have hden : den = JInt.lit t 2 := by
    apply Subtype.ext
    rw [htwo]
    exact hhalf
  subst hden
  have hbits : t.bits ≤ 64 := by
    rcases ht with ⟨h1, h2⟩
    cases t <;> simp_all [IntTy.bits]
  -- the numerator is odd
  have hodd : num.val.natAbs % 2 = 1 := by
    have hg := hq.2
    simp only [htwo] at hg
    apply Classical.byContradiction
    intro hne
    have h2 : 2 ∣ num.val.natAbs := Nat.dvd_of_mod_eq_zero (by omega)
    have : Nat.gcd num.val.natAbs (2 : Int).natAbs = 2 := Nat.gcd_eq_right h2
    omega
  have hf := JuliaLean.Proofs.base.float.good_fty .f64
  have hxf : x.isfinite = true := by
    rw [← JuliaLean.Proofs.base.float.isfinite_IEEEFloat_eq]; exact hx
  obtain ⟨hr2, hkey⟩ := Fl.toRat_key hf x hxf
  change (Fl.toRat x).1 * (f64den : Int) = x.key * ((Fl.toRat x).2 : Int) at hkey
  have hval' : (Fl.toRat x).1 * 2 = num.val * ((Fl.toRat x).2 : Int) := by
    have h := hval
    dsimp only at h
    rw [htwo] at h
    exact h
  have hk2 : x.key * 2 = num.val * (f64den : Int) := by
    have h1 : (x.key * 2) * ((Fl.toRat x).2 : Int) =
        (num.val * (f64den : Int)) * ((Fl.toRat x).2 : Int) := by
      calc (x.key * 2) * ((Fl.toRat x).2 : Int) = (x.key * ((Fl.toRat x).2 : Int)) * 2 :=
            Int.mul_right_comm _ _ _
        _ = (Fl.toRat x).1 * (f64den : Int) * 2 := by rw [hkey]
        _ = (Fl.toRat x).1 * 2 * (f64den : Int) := Int.mul_right_comm _ _ _
        _ = num.val * ((Fl.toRat x).2 : Int) * (f64den : Int) := by rw [hval']
        _ = (num.val * (f64den : Int)) * ((Fl.toRat x).2 : Int) := Int.mul_right_comm _ _ _
    exact Int.eq_of_mul_eq_mul_right (by omega) h1
  -- a Float64 equal to an odd half-integer lies below 2^52
  have hsmall : num.val.natAbs < 2 ^ 53 := by
    rcases Nat.lt_or_ge num.val.natAbs (2 ^ 53) with h | h
    · exact h
    · exfalso
      have hK : JuliaLean.Proofs.base.float.magKey (JuliaLean.base.float.FTy.f64).fmt x.magnitude * 2 =
          num.val.natAbs * f64den := by
        rw [← JuliaLean.Proofs.base.float.RemainderProofs.key_natAbs x]
        have := congrArg Int.natAbs hk2
        rw [Int.natAbs_mul, Int.natAbs_mul] at this
        exact this
      have hP : f64den = 2 ^ ((JuliaLean.base.float.FTy.f64).fmt.bias +
          (JuliaLean.base.float.FTy.f64).fmt.sb - 1) := rfl
      have hge : 2 ^ (JuliaLean.base.float.FTy.f64).fmt.sb * 2 ^ ((JuliaLean.base.float.FTy.f64).fmt.bias +
          (JuliaLean.base.float.FTy.f64).fmt.sb - 1) ≤
          JuliaLean.Proofs.base.float.magKey (JuliaLean.base.float.FTy.f64).fmt x.magnitude := by
        rw [← hP, show (JuliaLean.base.float.FTy.f64).fmt.sb = 52 from rfl]
        have h1 : 2 ^ 53 * f64den ≤ num.val.natAbs * f64den := Nat.mul_le_mul_right _ h
        have h2 : 2 ^ 53 * f64den = 2 * (2 ^ 52 * f64den) := by
          rw [← Nat.mul_assoc]
        generalize 2 ^ 52 * f64den = X at h2
        omega
      obtain ⟨a, ha⟩ := JuliaLean.Proofs.base.float.magKey_grid_of_ge _ _ _ hge
      rw [ha, ← hP] at hK
      have hpos : 0 < f64den := Fmt.den_pos _
      have h3 : (a * 2) * f64den = num.val.natAbs * f64den := by
        rw [← hK, Nat.mul_right_comm]
      have h4 := Nat.eq_of_mul_eq_mul_right hpos h3
      omega
  have hn0 : num.val ≠ 0 := by intro h; rw [h] at hodd; simp at hodd
  -- the source's ldexp result is `x`
  have hL : ∀ o' : JuliaLean.base.math.IEEEOps .f64,
      JuliaLean.base.math.ldexp o' (Fl.ofInt num.val : JuliaLean.base.float.FV .f64) (-1) = x := by
    intro o'
    obtain ⟨_, hLk⟩ := ldexpHalfKey o' num.val hsmall hn0
    apply flEqOfKey
    · exact Int.eq_of_mul_eq_mul_right (by decide) (hLk.trans hk2.symm)
    · intro h0
      have hz : num.val * (f64den : Int) = 0 := by rw [← hLk, h0]; rfl
      rcases Int.mul_eq_zero.mp hz with h | h
      · exact hn0 h
      · have hpos : (0 : Int) < (f64den : Int) := by exact_mod_cast Fmt.den_pos _
        omega
  have hbound : JuliaLean.base.int.lt_BitUnsigned
      (JuliaLean.base.int.widenTo .u64 (JuliaLean.base.float.uabs num))
      (JuliaLean.Proofs.base.rational.Round4.maxintfloatUInt64
        (JuliaLean.base.float.one_float .f64)) = true := by
    unfold JuliaLean.base.int.lt_BitUnsigned
    rw [JuliaLean.Proofs.base.int.ult_int_eq rfl]
    apply decide_eq_true
    have hu := (JuliaLean.Proofs.base.float.uabsExact_proven t num).1
    have hw : (JuliaLean.base.int.widenTo .u64 (JuliaLean.base.float.uabs num)).val =
        (num.val.natAbs : Int) := by
      rw [JuliaLean.Proofs.base.int.widenTo_val, hu]
      exact wrapInt_of_inRange .u64 _ ⟨by simp [IntTy.min, IntTy.signed],
        by simp [IntTy.max, IntTy.signed, IntTy.bits]; omega⟩
    rw [hw]
    show (num.val.natAbs : Int) < (JInt.lit .u64 9007199254740992).val
    have : (JInt.lit .u64 9007199254740992).val = 9007199254740992 := by decide
    rw [this]
    omega
  unfold JuliaLean.Proofs.base.rational.Round4.hashRat
  refine (halfHashReduce t ht num seed _ _ _ _ _ hbound).trans ?_
  rw [show (JInt.lit .i64 (-1)).val = -1 from rfl,
    JuliaLean.Proofs.base.float.floatOfInt_eq_ofInt hbits, hL]

end JuliaLean.Proofs.base.rational.HashHalfProof

namespace JuliaLean.Proofs.base.rational.IOParseProof
open JuliaLean JuliaLean.Promotion JuliaLean.base.rational
open JuliaLean.Statements.rational.Round16

/-- A successful native constructor call represents the exact input ratio. -/
private theorem ctorOkRepresents (t : IntTy) (n d : JInt t) (r : Rat t)
    (h : exactDivideIntsSource (JuliaLean.Proofs.base.rational.Round4.rational (.bits t)) n d = .ok r) :
    JuliaLean.Proofs.base.rational.Round4.Represents (.bits t) r n.val d.val := by
  unfold exactDivideIntsSource at h
  obtain ⟨h1, h2, h3, h4⟩ := JuliaLean.Proofs.base.rational.Round4.native_constructor_aux t n d
  have hg : Nat.gcd n.val.natAbs d.val.natAbs ≠ 0 := fun hg =>
    (h1 hg).elim (fun _ hm => by rw [h] at hm; cases hm)
  have hneg : ¬ _ := fun hn => (h2 hg hn).elim (fun _ hm => by rw [h] at hm; cases hm)
  have hconv : _ := Classical.byContradiction fun hc =>
    (h3 hg hneg hc).elim (fun _ hm => by rw [h] at hm; cases hm)
  have hnorm : _ := Classical.byContradiction fun hc =>
    ((h4 hg hneg hconv).2 hc).elim (fun _ hm => by rw [h] at hm; cases hm)
  obtain ⟨q, hq, hrep⟩ := (h4 hg hneg hconv).1 hnorm
  rw [h] at hq
  cases hq
  exact hrep

private theorem sbind {S α β : Type} {x : JuliaLean.base.strings.util.SplitM S JlError α}
    {f : α → JuliaLean.base.strings.util.SplitM S JlError β}
    {s s' : JuliaLean.base.array.MutableMemory (JuliaLean.base.strings.substring.SubString S)} {a : α}
    (h : x.run s = some (.ok a, s')) : (x >>= f).run s = (f a).run s' := by
  have h' : StateT.run (ExceptT.run x) s = some (.ok a, s') := h
  show StateT.run (ExceptT.run (x >>= f)) s = StateT.run (ExceptT.run (f a)) s'
  rw [ExceptT.run_bind, StateT.run_bind, h']
  rfl

private theorem liftOk {S α : Type} (v : α)
    (s : JuliaLean.base.array.MutableMemory (JuliaLean.base.strings.substring.SubString S)) :
    (liftRationalParse (S := S) (.ok v)).run s = some (.ok v, s) := rfl

theorem io_read_parse_proven : io_read_parse := by
  refine ⟨?_, ?_⟩
  · intro t ltoh io
    dsimp only
    refine ⟨fun e out h => ?_, fun n after e out h1 h2 => ?_⟩
    · simp only [JuliaLean.Proofs.base.rational.Round6.readUnsignedRational, readRationalSource,
        Bind.bind, EStateM.bind, h]
    · simp only [JuliaLean.Proofs.base.rational.Round6.readUnsignedRational, readRationalSource,
        Bind.bind, EStateM.bind, h1, h2]
  · intro t S R CU CT prim errs layout liftA parseOriginal parseFragment parseChopped str initial
    dsimp only
    have hch : UInt32.ofNat ('/' : Char).toNat = UInt32.ofNat 47 := rfl
    refine ⟨fun ns denText splitState n denParsed chopped constructorResult hsplit hns hden hdiv => ?_,
      fun only splitState n constructorResult hsplit horig hsingle => ?_⟩
    · refine ⟨splitState, ?_, ctorOkRepresents t n denParsed constructorResult hdiv⟩
      unfold rationalParseActual parseRationalSource
      dsimp only
      rw [hch, sbind hsplit]
      have hi1 : (JInt.lit IntTy.i64 1).val = 1 := by decide
      have hi2 : (JInt.lit IntTy.i64 2).val = 2 := by decide
      rcases hden with ⟨hsw, hpf⟩ | ⟨hsw, hchop, hpc⟩
      · have hsw' : startsWithRationalChar prim errs denText 47 = .ok false := hsw
        simp [liftRationalParse, hsw', hns, hpf, hdiv, hi1, hi2, ExceptT.bind, ExceptT.pure, ExceptT.mk, ExceptT.bindCont, ExceptT.run, StateT.bind, StateT.pure,
          StateT.run, Bind.bind, Pure.pure, Option.bind, throw, throwThe, MonadExceptOf.throw]
      · have hsw' : startsWithRationalChar prim errs denText 47 = .ok true := hsw
        have hchop' : chopRationalField prim errs denText 1 0 = .ok chopped := hchop
        simp [liftRationalParse, hsw', hns, hchop', hpc, hdiv, hi1, hi2, ExceptT.bind, ExceptT.pure, ExceptT.mk, ExceptT.bindCont, ExceptT.run, StateT.bind, StateT.pure,
          StateT.run, Bind.bind, Pure.pure, Option.bind, throw, throwThe, MonadExceptOf.throw]
    · have hc : constructorResult = ⟨n, JInt.lit t 1⟩ := by
        simp [rationalIntAsSource, unsafeRationalTypeSource, Bind.bind, Except.bind, Pure.pure,
          Except.pure] at hsingle
        exact hsingle.symm
      subst hc
      refine ⟨splitState, ?_, ?_⟩
      · unfold rationalParseActual parseRationalSource
        dsimp only
        rw [hch, sbind hsplit]
        simp [liftRationalParse, horig, hsingle, ExceptT.bind, ExceptT.pure, ExceptT.mk, ExceptT.bindCont, ExceptT.run, StateT.bind, StateT.pure,
          StateT.run, Bind.bind, Pure.pure, Option.bind, throw, throwThe, MonadExceptOf.throw]
      · have hone : (JInt.lit t 1).val = 1 := by cases t <;> decide
