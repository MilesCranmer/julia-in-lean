      decide_false, Bool.false_eq_true, ↓reduceIte, hidx1, hidx2, hg1, hg2, Bind.bind, Except.bind, Pure.pure, Except.pure] at h
    cases hslash : starts ds '/' <;> simp only [hslash, Bool.false_eq_true, ↓reduceIte, Bind.bind, Except.bind, Pure.pure, Except.pure] at hd h
