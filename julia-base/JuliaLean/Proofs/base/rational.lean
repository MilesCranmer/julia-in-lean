    (num den : T) (initial afterSign afterNegation : World)
    (error : ArrayError),
    ops.signbit den initial = .ok (.accepted true) afterSign →
    ops.checkedNeg den afterSign = .error error afterNegation →
    checkedDenTyped ops num den initial = .error error afterNegation

