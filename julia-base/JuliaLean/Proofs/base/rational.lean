/-- The comparison control flow parameterized by all native arithmetic callbacks. -/
def rationalCoreProgram {X E R : Type}
    (sign : X → Jl X) (digits : X → Jl E) (promote : X → X → Jl (X × X))
    (different : X → X → Bool) (zero : X → Bool) (add : E → E → E)
    (same : E → E → Bool) (greater : E → E → Bool) (subtract : E → E → E)
    (shift : X → E → X) (positive : X → Bool)
    (relX : X → X → R) (relE : E → E → R) (zeroResult : Jl R)
    (a b : X) (xp yp : E) : Jl R := do
  let sa ← sign a
  let sb ← sign b
  if different sa sb then pure (relX sa sb)
  else if zero sa then zeroResult
  else
    let xb := add (← digits a) xp
    let yb := add (← digits b) yp
    if same xb yb then
      let pair ← promote a b
      if greater xp yp then pure (relX (shift pair.1 (subtract xp yp)) pair.2)
      else pure (relX pair.1 (shift pair.2 (subtract yp xp)))
    else if positive a then pure (relE xb yb)
    else pure (relE yb xb)

/-- The pure branches after successful abstract sign, digit, and promotion calls. -/
def rationalCoreProgramPure {X E R : Type}
    (different : X → X → Bool) (zero : X → Bool) (add : E → E → E)
    (same : E → E → Bool) (greater : E → E → Bool) (subtract : E → E → E)
    (shift : X → E → X) (positive : X → Bool)
    (relX : X → X → R) (relE : E → E → R) (zeroResult : Jl R)
    (a b sa sb : X) (xp yp ca cb : E) : Jl R :=
  if different sa sb then .ok (relX sa sb)
  else if zero sa then zeroResult
  else
    let xb := add ca xp
    let yb := add cb yp
    if same xb yb then
      if greater xp yp then .ok (relX (shift a (subtract xp yp)) b)
      else .ok (relX a (shift b (subtract yp xp)))
    else if positive a then .ok (relE xb yb)
    else .ok (relE yb xb)

/-- All monadic calls are discharged from their supplied exact results. -/
theorem rationalCoreProgramExpand {X E R : Type}
    (sign : X → Jl X) (digits : X → Jl E) (promote : X → X → Jl (X × X))
    (different : X → X → Bool) (zero : X → Bool) (add : E → E → E)
    (same : E → E → Bool) (greater : E → E → Bool) (subtract : E → E → E)
    (shift : X → E → X) (positive : X → Bool)
    (relX : X → X → R) (relE : E → E → R) (zeroResult : Jl R)
    (a b sa sb : X) (xp yp ca cb : E)
    (hsa : sign a = .ok sa) (hsb : sign b = .ok sb)
    (hca : digits a = .ok ca) (hcb : digits b = .ok cb)
    (hp : promote a b = .ok (a, b)) :
    rationalCoreProgram sign digits promote different zero add same greater subtract shift positive
      relX relE zeroResult a b xp yp =
    rationalCoreProgramPure different zero add same greater subtract shift positive
      relX relE zeroResult a b sa sb xp yp ca cb := by
  simp only [rationalCoreProgram, rationalCoreProgramPure, hsa, hsb, hca, hcb, hp,
    bind, Except.bind, pure, Except.pure]

end JuliaLean.ChatGPT.Batch3.Group3


