theorem gcdx_bezout_refuted : ¬ JuliaLean.Statements.rational.Round14.gcdx_bezout := by
  intro h
  let i : IntegerParameters (JInt .i8) := .bits .i8
  let x : Rational (JInt .i8) := ⟨JInt.lit .i8 100, JInt.lit .i8 1⟩
  let y : Rational (JInt .i8) := ⟨JInt.lit .i8 7, JInt.lit .i8 3⟩
  let q : Rational (JInt .i8) := ⟨JInt.lit .i8 1, JInt.lit .i8 3⟩
  let a : JInt .i8 := JInt.lit .i8 (-3)
  let b : JInt .i8 := JInt.lit .i8 19
  have hx : Canonical i x := by
    change 0 ≤ (1 : Int) ∧ Nat.gcd (100 : Int).natAbs (1 : Int).natAbs = 1
    decide
  have hy : Canonical i y := by
    change 0 ≤ (3 : Int) ∧ Nat.gcd (7 : Int).natAbs (3 : Int).natAbs = 1
    decide
  have hrun : JuliaLean.Proofs.base.rational.Round4.rgcdx i x y = .ok (q, a, b) := by
    decide
  have hfinal := (h i x y hx hy).2.2.2.2
  have hbad := hfinal
    (by change 0 < (1 : Int); omega)
    (by change 0 < (3 : Int); omega)
    (by
      simp [rn, val, IntegerParameters.ops, jintOps, JInt.lit, JInt.wrap, wrapInt,
        IntTy.signed, IntTy.bits, i, x, y]
      all_goals decide)
    (by
      simp [FitsPair, IntegerParameters.fits, rn, rd, val, IntegerParameters.ops,
        jintOps, JInt.lit, JInt.wrap, wrapInt, IntTy.min, IntTy.max,
        IntTy.signed, IntTy.bits, i, x, y]
      all_goals decide)
    q a b hrun
  rcases hbad with ⟨_, hbez⟩
  have hbez' : (3 : Int) = -2301 := by
    simpa [JuliaLean.Statements.rational.Round14.BezoutIdentity, rn, rd,
      val, IntegerParameters.ops, jintOps, JInt.lit, JInt.wrap, wrapInt,
      IntTy.signed, IntTy.bits, IntTy.min, IntTy.max, i, x, y, q, a, b] using hbez
  omega

end Round14

