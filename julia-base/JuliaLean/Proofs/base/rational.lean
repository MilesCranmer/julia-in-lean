def ComplexPowerOne {t : IntTy}
    (out : JuliaLean.base.complex.Complex (Rat t)) : Prop :=
  out.re.num.val = 1 ∧ out.re.den.val = 1 ∧
  out.im.num.val = 0 ∧ out.im.den.val = 1

