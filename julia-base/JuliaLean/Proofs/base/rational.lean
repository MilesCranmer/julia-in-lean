  ∀ (World T Neg NotBool R : Type)
    (ops : CheckedDenOps (EStateM ArrayError World) T Neg NotBool R)
    (num den : T) (negativeDen : Neg)
    (initial afterSign afterDen afterNum : World) (error : ArrayError),
    ops.signbit den initial = .ok (.accepted true) afterSign →
    ops.checkedNeg den afterSign = .ok negativeDen afterDen →
    ops.checkedNeg num afterDen = .error error afterNum →
    checkedDenTyped ops num den initial = .error error afterNum

