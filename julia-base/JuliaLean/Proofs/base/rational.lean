def native_rational_equality : Prop :=
  ∀ (t s : IntTy) (x : Rat t) (y : Rat s)
    (hx : Normalized x) (hy : Normalized y),
    eqRatSource JuliaLean.base.int.eq JuliaLean.base.int.eq x y =
      decide (compareExtended x.num.val x.den.val y.num.val y.den.val = 0)
def native_rational_order : Prop :=
  ∀ (t s : IntTy) {W : Type} (wide : Widening t s W)
    (x : Rat t) (y : Rat s) (hx : Normalized x) (hy : Normalized y),
    let c := compareExtended x.num.val x.den.val y.num.val y.den.val
    ltRatSource JuliaLean.base.int.eq JuliaLean.base.int.lt wide.product wide.product wide.less x y = decide (c < 0) ∧
    leRatSource JuliaLean.base.int.eq JuliaLean.base.int.le wide.product wide.product wide.le x y = decide (c ≤ 0)
def native_integer_equality : Prop :=
  ∀ (t s : IntTy) (x : Rat t) (n : JInt s) (hx : Normalized x),
    eqRatIntSource (fun d => JuliaLean.base.int.eq d (JInt.lit .i64 1))
      JuliaLean.base.int.eq x n = decide (x.den.val > 0 ∧ x.num.val = n.val*x.den.val)
def native_integer_order : Prop :=
  ∀ (t s : IntTy) {W V : Type}
    (wide : Widening t s W) (reverse : Widening s t V)
    (x : Rat t) (n : JInt s) (hx : Normalized x),
    let c := compareExtended x.num.val x.den.val n.val 1
    ltRatIntSource wide.product wide.lessLeft x n = decide (c < 0) ∧
    leRatIntSource wide.product wide.leLeft x n = decide (c ≤ 0) ∧
    ltIntRatSource reverse.product reverse.lessRight n x = decide (0 < c) ∧
    leIntRatSource reverse.product reverse.leRight n x = decide (0 ≤ c)
def complex_equality : Prop :=
  ∀ (t : IntTy) (z : C (Rat t)) (x : Rat t)
    (hr : Normalized z.re) (hi : Normalized z.im) (hx : Normalized x),
    let expected := z.im.num.val = 0 ∧
      compareExtended z.re.num.val z.re.den.val x.num.val x.den.val = 0
    eqComplexRatSource
      (JuliaLean.base.complex.isreal_Complex (isZeroRationalSource (jintOps t).iszero))
      cre (eqRatSource JuliaLean.base.int.eq JuliaLean.base.int.eq) z x = decide expected ∧
    eqRatComplexSource
      (JuliaLean.base.complex.isreal_Complex (isZeroRationalSource (jintOps t).iszero))
      cre (eqRatSource JuliaLean.base.int.eq JuliaLean.base.int.eq) x z = decide expected
abbrev toleranceRun (t s : IntTy) {W : Type} (wide : Widening s .i64 W)
    (o : JuliaLean.base.math.IEEEOps .f32 × JuliaLean.base.math.IEEEOps .f64)
    (showTol : JuliaLean.base.float.FV .f64 → String) (x : Rat s)
    (tol : JuliaLean.base.float.FV .f64) :=
  let f := FloatParameters.ieee .f64 o
  rationalizeRatToleranceGeneric (m := ExceptT JlError Option) (!t.signed) true
    (fun q => ltRatIntSource wide.product wide.lessLeft q (JInt.lit .i64 0))
    (fun n => JuliaLean.base.int.le (JInt.typemin t) n && JuliaLean.base.int.le n (JInt.typemax t))
    (fun d => JuliaLean.base.int.le d (JInt.typemax t))
    (fun q => some (convertRat (.bits t) (.bits s) q))
    (abstractFloat (.bits s)) JuliaLean.base.float.isfinite_IEEEFloat
    (epsilonHalf f) (fun a b => JuliaLean.base.float.le_IEEEFloat b a)
    (approx (.bits t) f f showTol) x tol inexactErrorCore
def rational_input_tolerance : Prop :=
  ∀ (t s : IntTy) {W : Type} (wide : Widening s .i64 W)
    (o : JuliaLean.base.math.IEEEOps .f32 × JuliaLean.base.math.IEEEOps .f64)
    (showTol : JuliaLean.base.float.FV .f64 → String)
    (x : Rat s) (tol : JuliaLean.base.float.FV .f64) (hx : Normalized x),
    let i := IntegerParameters.bits t
    let f := FloatParameters.ieee .f64 o
    let run := toleranceRun t s wide o showTol x tol
    (t.signed = false → x.num.val < 0 → run = some (.error (.overflowError "cannot negate unsigned number"))) ∧
    ((t.signed = false → 0 ≤ x.num.val) →
      (FitsPair i x.num.val x.den.val → ∃ q, run = some (.ok q) ∧
        Normalized q ∧ q.num.val = x.num.val ∧ q.den.val = x.den.val) ∧
      (¬ FitsPair i x.num.val x.den.val →
        ((f.isnan tol = false ∧ f.isinf tol = false ∧
          JuliaLean.base.float.le_IEEEFloat (epsilonHalf f (abstractFloat (.bits s) x)) tol = true ∧
          JuliaLean.base.float.isfinite_IEEEFloat (abstractFloat (.bits s) x) = true) →
          ∃ q, run = some (.ok q) ∧ Canonical i q ∧ rd i q > 0 ∧
            (rn i q*x.den.val-x.num.val*rd i q).natAbs*(f.ratio tol).2 ≤
              (f.ratio tol).1.toNat*(rd i q).toNat*x.den.val.toNat) ∧
        ((JuliaLean.base.float.isfinite_IEEEFloat (abstractFloat (.bits s) x) = false ∨
          JuliaLean.base.float.le_IEEEFloat (epsilonHalf f (abstractFloat (.bits s) x)) tol = false) →
          ∃ message, run = some (.error (.inexactError message)))))
abbrev FourTypes (t s : IntTy) : JuliaLean.base.promotion.JlPartial JuliaLean.base.promotion.PType :=
  JuliaLean.base.promotion.promoteTypeofRest
    (fun x : Sigma JInt => JuliaLean.base.promotion.primitivePType (.int x.1))
    JuliaLean.base.promotion.primitivePromoteTypeValue
    (⟨t,JInt.lit t 0⟩ : Sigma JInt) ⟨t,JInt.lit t 0⟩
    [⟨s,JInt.lit s 0⟩,⟨s,JInt.lit s 0⟩]
def four_type_termination : Prop :=
  ∀ (t s : IntTy),
    ∃ R, FourTypes t s = some (.ok R) ∧
      R = JuliaLean.base.promotion.primitivePType (.int (t.promote s))
def sameSignMode {t s : IntTy} (a : JInt t) (b : JInt s) (r : Rounding) :
    Jl (JInt (t.promote s)) :=
  let (a,b) := JuliaLean.base.int.promoteSameSign a b
  JuliaLean.base.div.divBitIntegerMode a b (sourceMode r)
def mixed_rounded_scalars : Prop :=
  ∀ (t s : IntTy) (signedness : t.signed = s.signed)
    (x : Rat t) (k : JInt s) (mode : Rounding) (hx : Normalized x),
    let p := IntegerParameters.bits (t.promote s)
    let qr := IntegerParameters.bits (t.promote (t.promote s))
    let ql := IntegerParameters.bits ((s.promote t).promote t)
    let g : Int := Nat.gcd x.num.val.natAbs k.val.natAbs
    let n := x.num.val.tdiv g
    let y := k.val.tdiv g
    let d := x.den.val*y
    let a := y*x.den.val
    let ri := divRationalIntegerRoundedSource (dg (.bits t) (.bits s))
      JuliaLean.base.checked.checkedMulMixedBits sameSignMode x k mode
    let ir := divIntegerRationalRoundedSource (dg (.bits s) (.bits t))
      JuliaLean.base.checked.checkedMulMixedBits sameSignMode k x mode
    (g = 0 → ri = .error .divideError ∧ ir = .error .divideError) ∧
    (g ≠ 0 → (p.fits x.den.val ∧ p.fits y) →
      (p.fits d → QuotientOutcome qr ri n d mode) ∧
      (¬ p.fits d → IsOverflow ri)) ∧
    (g ≠ 0 →
      (IntegerParameters.fits (.bits (s.promote t)) y ∧
        IntegerParameters.fits (.bits (s.promote t)) x.den.val) →
      (IntegerParameters.fits (.bits (s.promote t)) a → QuotientOutcome ql ir a n mode) ∧
      (¬ IntegerParameters.fits (.bits (s.promote t)) a → IsOverflow ir))
def homogeneous_interpolation_infinite : Prop :=
  ∀ (t : IntTy) (j d : JInt t) (a b : Rat t)
    (ha : Normalized a) (hb : Normalized b) (hd : 0 < d.val)
    (hj : 0 ≤ j.val ∧ j.val ≤ d.val),
    let i := IntegerParameters.bits t
    let m := PromotionParameters.same i
    let run := lerpiSource JuliaLean.base.int.sub
      (mulIntRatSource m.prom m.prom.promote (dg i i)) (divRatIntSource m.prom (dg i i))
      (mulIntRatSource m.prom m.prom.promote (dg i i)) (divRatIntSource m.prom (dg i i)) (add m) j d a b
    (a.den.val = 0 → j.val = d.val → run = .error .divideError) ∧
    (a.den.val = 0 → b.den.val = 0 →
      (j.val = 0 → run = .error .divideError) ∧
      (0 < j.val → j.val < d.val →
        (a.num.val = b.num.val → ExactResult i run a.num.val 0) ∧
        (a.num.val ≠ b.num.val → run = .error .divideError))) ∧
    (a.den.val = 0 → b.den.val > 0 → j.val < d.val →
      i.fits (j.val*b.num.val) → i.fits (d.val*b.den.val) →
      ExactResult i run a.num.val 0) ∧
    (a.den.val > 0 → b.den.val = 0 →
      i.fits ((d.val-j.val)*a.num.val) → i.fits (d.val*a.den.val) →
      (j.val = 0 → run = .error .divideError) ∧
      (0 < j.val → ExactResult i run b.num.val 0))
