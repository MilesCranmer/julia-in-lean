def CheckedDenNegatedConstructorFailure : Prop :=
  ∀ (World T Neg NotBool R : Type)
    (ops : CheckedDenOps (EStateM ArrayError World) T Neg NotBool R)
    (num den : T) (negativeNum negativeDen : Neg)
    (initial afterSign afterDen afterNum afterConstruct : World)
    (error : ArrayError),
    ops.signbit den initial = .ok (.accepted true) afterSign →
    ops.checkedNeg den afterSign = .ok negativeDen afterDen →
    ops.checkedNeg num afterDen = .ok negativeNum afterNum →
    ops.unsafeNegated negativeNum negativeDen afterNum =
