theorem g19RatPowDgBitsCoprime {t s : IntTy} (u : JInt t) (v : JInt s)
    (hcop : Nat.Coprime u.val.natAbs v.val.natAbs) :
    JuliaLean.Proofs.base.rational.DivGcdCtorLemmas.dgBits u v = .ok (u, v) := by
  change JuliaLean.Proofs.base.rational.DivGcdCtorLemmas.dgBits u v = .ok (u, v)
  have hcop' : Nat.gcd u.val.natAbs v.val.natAbs = 1 := hcop
  have hG : (Nat.gcd u.val.natAbs v.val.natAbs : Int) = 1 := by
    exact_mod_cast hcop'
  have hg : (Nat.gcd u.val.natAbs v.val.natAbs : Int) ≠ 0 := by
    rw [hG]
    decide
  obtain ⟨a, b, hrun, hau, hbv, _, _, _, _, _, _⟩ :=
    JuliaLean.Proofs.base.rational.DivGcdCtorLemmas.dgBits_spec u v |>.2 hg
  have ha : a.val = u.val := by
    simpa [hG] using hau
  have hb : b.val = v.val := by
    simpa [hG] using hbv
  have ha' : a = u := Subtype.ext ha
  have hb' : b = v := Subtype.ext hb
  rw [ha', hb'] at hrun
  exact hrun

theorem g19RatPowCheckedMulFits (t : IntTy) (a b : JInt t)
    (hfit : t.min ≤ a.val * b.val ∧ a.val * b.val ≤ t.max) :
