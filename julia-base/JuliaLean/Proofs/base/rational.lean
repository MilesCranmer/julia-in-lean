/-! ## 34. `power_of_two` (`rational-power-of-two`) -/

theorem power_of_two_aux (t : IntTy) (q : Rat t) (hq : Normalized q) :
    isPow2RatSource JuliaLean.base.intfuncs.ispow2Bits q = true ↔
      (∃ k : Nat, q.num.val = (2 : Int)^k ∧ q.den.val = 1) ∨
      (∃ k : Nat, q.den.val = (2 : Int)^k ∧ q.num.val = 1) := by
  unfold isPow2RatSource
  have hn := JuliaLean.Proofs.base.intfuncs.isPowerTwoExact_proven.1 t q.num
  have hd := JuliaLean.Proofs.base.intfuncs.isPowerTwoExact_proven.1 t q.den
  have hbwand : bwand (JuliaLean.base.intfuncs.ispow2Bits q.num) (JuliaLean.base.intfuncs.ispow2Bits q.den) = true ↔
      JuliaLean.base.intfuncs.ispow2Bits q.num = true ∧ JuliaLean.base.intfuncs.ispow2Bits q.den = true := by
    unfold bwand
    cases JuliaLean.base.intfuncs.ispow2Bits q.num <;> cases JuliaLean.base.intfuncs.ispow2Bits q.den <;> decide
  rw [hbwand, hn, hd]
  constructor
  · rintro ⟨⟨k1, hk1⟩, ⟨k2, hk2⟩⟩
    by_cases h2 : k2 = 0
    · left; refine ⟨k1, hk1, ?_⟩; rw [hk2, h2]; rfl
    · right; refine ⟨k2, hk2, ?_⟩
      have h1 : k1 = 0 := Decidable.byContradiction fun h1 => by
        obtain ⟨m1, rfl⟩ : ∃ m1, k1 = m1 + 1 := ⟨k1 - 1, by omega⟩
        obtain ⟨m2, rfl⟩ : ∃ m2, k2 = m2 + 1 := ⟨k2 - 1, by omega⟩
        have hpow2_abs : ∀ k : Nat, ((2 : Int) ^ k).natAbs = 2 ^ k := fun k => by
          induction k with
          | zero => rfl
          | succ k ih => rw [Int.pow_succ, Nat.pow_succ, Int.natAbs_mul, ih]; rfl
        have hn_abs : q.num.val.natAbs = 2 ^ (m1 + 1) := by rw [hk1, hpow2_abs]
        have hd_abs : q.den.val.natAbs = 2 ^ (m2 + 1) := by rw [hk2, hpow2_abs]
        have hdvd1 : 2 ∣ q.num.val.natAbs := by rw [hn_abs, Nat.pow_succ]; exact ⟨2 ^ m1, Nat.mul_comm _ _⟩
        have hdvd2 : 2 ∣ q.den.val.natAbs := by rw [hd_abs, Nat.pow_succ]; exact ⟨2 ^ m2, Nat.mul_comm _ _⟩
        have hdvd_g : 2 ∣ Nat.gcd q.num.val.natAbs q.den.val.natAbs := Nat.dvd_gcd hdvd1 hdvd2
        rw [hq.2] at hdvd_g
        omega
      rw [hk1, h1]; rfl
  · rintro (⟨k, hk, hd1⟩ | ⟨k, hk, hn1⟩)
    · exact ⟨⟨k, hk⟩, ⟨0, hd1⟩⟩
    · exact ⟨⟨0, hn1⟩, ⟨k, hk⟩⟩

/-! ## 36. `extrema_bounds` (`rational-sign-and-extrema`) -/

theorem extrema_bounds_aux (t : IntTy) (q : Rat t) (hq : Normalized q) :
    let lo := if t.signed then typeminSignedRatSource (JInt t) (JInt.lit t 1) (JInt.lit t 0)
        JuliaLean.base.int.neg else typeminOtherRatSource (JInt t) (JInt.lit t 0) (JInt.lit t 1)
    let hi := typemaxRatSource (JInt t) (JInt.lit t 1) (JInt.lit t 0)
    Normalized lo ∧ Normalized hi ∧
    compareExtended lo.num.val lo.den.val q.num.val q.den.val ≤ 0 ∧
    compareExtended q.num.val q.den.val hi.num.val hi.den.val ≤ 0 := by
  intro lo hi
  have h0 : (JInt.lit t 0).val = 0 := by cases t <;> decide
  have h1 : (JInt.lit t 1).val = 1 := by cases t <;> decide
  have hhi_norm : Normalized hi := by
    unfold hi typemaxRatSource Normalized
    dsimp only [unsafeRationalTypeSource_id]
    rw [h0, h1]; decide
  have hhi_cmp : compareExtended q.num.val q.den.val hi.num.val hi.den.val ≤ 0 := by
    unfold hi typemaxRatSource compareExtended intCmp intSign
    simp only [unsafeRationalTypeSource_id, h0, h1]
    by_cases hqd0 : q.den.val = 0
    · have hqn := (normalized_extremes_full hq).2 hqd0
      rcases hqn.2 with hqn1 | hqn1 <;> simp [hqd0, hqn1]
    · simp [hqd0]
  by_cases hs : t.signed = true
  · have hneg1 : (JuliaLean.base.int.neg (JInt.lit t 1)).val = -1 := by
      cases t <;> simp_all [IntTy.signed] <;> decide
    have hlo_norm : Normalized lo := by
      unfold lo typeminSignedRatSource Normalized
      simp only [hs, ↓reduceIte, unsafeRationalTypeSource_id, h0, hneg1]
      decide
    have hlo_cmp : compareExtended lo.num.val lo.den.val q.num.val q.den.val ≤ 0 := by
      unfold lo typeminSignedRatSource compareExtended intCmp intSign
      simp only [hs, ↓reduceIte, unsafeRationalTypeSource_id, h0, hneg1]
      by_cases hqd0 : q.den.val = 0
      · have hqn := (normalized_extremes_full hq).2 hqd0
        rcases hqn.2 with hqn1 | hqn1 <;> simp [hqd0, hqn1]
      · simp [hqd0]
    exact ⟨hlo_norm, hhi_norm, hlo_cmp, hhi_cmp⟩
  · have hu : t.signed = false := Bool.eq_false_iff.mpr hs
    have hlo_norm : Normalized lo := by
      unfold lo typeminOtherRatSource Normalized
      simp only [hu, Bool.false_eq_true, ↓reduceIte, unsafeRationalTypeSource_id, h0, h1]
      decide
    have hlo_cmp : compareExtended lo.num.val lo.den.val q.num.val q.den.val ≤ 0 := by
      unfold lo typeminOtherRatSource compareExtended intCmp intSign
      simp only [hu, Bool.false_eq_true, ↓reduceIte, unsafeRationalTypeSource_id, h0, h1]
      have hqn_nn : 0 ≤ q.num.val := nonneg_of_unsigned hu q.num
      by_cases hqd0 : q.den.val = 0
      · have hqn := (normalized_extremes_full hq).2 hqd0
        rcases hqn.2 with hqn1 | hqn1
        · simp [hqd0, hqn1]
        · omega
      · have h1_nz : (1 : Int) ≠ 0 := by decide
        rw [if_neg h1_nz, if_neg hqd0]
        by_cases hpos : 0 < q.num.val <;> simp [hpos, show ¬ q.num.val < 0 by omega]
    exact ⟨hlo_norm, hhi_norm, hlo_cmp, hhi_cmp⟩

/-! ## 37. `integer_rational_exact` (`rational-mixed-integer-division`) -/

private theorem prom_opsP_sign_neg {T U P : Type} {i : IntegerParameters T} {j : IntegerParameters U}
    (p : IntegerParameters P) (m : PromotionParameters i j p) :
    m.prom.opsP.signbit = p.ops.signbit ∧ m.prom.opsP.checkedNeg = p.ops.checkedNeg := by
  cases m with
  | same i => cases i <;> exact ⟨rfl, rfl⟩
  | bits _ _ => exact ⟨rfl, rfl⟩

theorem integer_rational_exact_aux {T U P : Type} (i : IntegerParameters T) (j : IntegerParameters U)
    (p : IntegerParameters P) (m : PromotionParameters i j p) (k : T) (y : Rational U)
    (hy : Canonical j y) :
    let gn : Int := Nat.gcd (val i k).natAbs (rn j y).natAbs
    let a := (val i k).tdiv gn * rd j y
    let b := (rn j y).tdiv gn
    let cv := p.fits (val i k) ∧ p.fits (rn j y) ∧ p.fits (rd j y)
    let safe := p.fits a ∧ (b < 0 → FitsPair p (-a) (-b))
    let run := divIntRatSource m.prom (dg p p) k y
    (¬ cv → IsInexact run) ∧
    (cv → gn = 0 → run = .error .divideError) ∧
    (cv → gn ≠ 0 → safe → ExactResult p run (val i k*rd j y) (rn j y)) ∧
    (cv → gn ≠ 0 → ¬ safe → IsOverflow run) := by
  intro gn a b cv safe run
  have hyd_fit : p.fits (rd j y) := by
    cases m with
    | same i => cases i with | bits t => exact y.den.property
    | bits t s =>
      exact ⟨Int.le_trans (min_le_zero (t.promote s)) hy.1,
             Int.le_trans y.den.property.2 (max_le_promote_right t s)⟩
  have hprom := prom_promote_spec m k y.num
  unfold run divIntRatSource
  refine ⟨fun hnot_cv => ?_, fun hcv hgn0 => ?_, fun hcv hgn_nz hsafe => ?_, fun hcv hgn_nz hnot_safe => ?_⟩
  · have hnot_fp : ¬ FitsPair p (val i k) (rn j y) := fun ⟨h1, h2⟩ => hnot_cv ⟨h1, h2, hyd_fit⟩
    obtain ⟨msg, herr⟩ := hprom.2 hnot_fp
    simp [herr, Bind.bind, Except.bind, IsInexact]
  · obtain ⟨kp, ynp, hok_p, hkp_v, hynp_v⟩ := hprom.1 ⟨hcv.1, hcv.2.1⟩
    simp only [hok_p, Bind.bind, Except.bind]
    cases p with | bits pt =>
    change kp.val = val i k at hkp_v
    change ynp.val = rn j y at hynp_v
    have hg_eq : (Nat.gcd kp.val.natAbs ynp.val.natAbs : Int) = gn := by
      dsimp [gn]; rw [hkp_v, hynp_v]
    have hdg_eq : dg (.bits pt) (.bits pt) = dgBits := rfl
    rw [hdg_eq, (dgBits_spec kp ynp).1 (hg_eq.trans hgn0)]
  · obtain ⟨kp, ynp, hok_p, hkp_v, hynp_v⟩ := hprom.1 ⟨hcv.1, hcv.2.1⟩
    simp only [hok_p, Bind.bind, Except.bind]
    cases p with | bits pt =>
    change kp.val = val i k at hkp_v
    change ynp.val = rn j y at hynp_v
    have hg_eq : (Nat.gcd kp.val.natAbs ynp.val.natAbs : Int) = gn := by
      dsimp [gn]; rw [hkp_v, hynp_v]
    obtain ⟨xn, yn, hok_dg, hxn_v, hyn_v, hxn_abs, hyn_abs, hcop, hmul_xn, hmul_yn, _, hsign_xn, _⟩ :=
      (dgBits_spec kp ynp).2 (by dsimp; rw [hg_eq]; exact hgn_nz)
    rw [hg_eq] at hxn_v hyn_v hmul_xn hmul_yn
    rw [hkp_v] at hxn_v hmul_xn
    rw [hynp_v] at hyn_v hmul_yn
    have hdg_eq : dg (.bits pt) (.bits pt) = dgBits := rfl
    rw [hdg_eq, hok_dg]
    dsimp only [Bind.bind, Except.bind]
    have hmul_py := (prom_checkedMulPY_spec m xn y.den hyd_fit).1 (by
      change (IntegerParameters.bits pt).fits (xn.val * val j y.den)
      rw [hxn_v]; exact hsafe.1)
    obtain ⟨numP, hnumP_ok, hnumP_val⟩ := hmul_py
    rw [hnumP_ok]
    dsimp only [checkedDenSameSource]
    have hops_sign : m.prom.opsP.signbit = (jintOps pt).signbit := (prom_opsP_sign_neg (.bits pt) m).1
    have hops_neg : m.prom.opsP.checkedNeg = (jintOps pt).checkedNeg := (prom_opsP_sign_neg (.bits pt) m).2
    have hcd := checkedDenBits_spec m.prom.opsP hops_sign hops_neg numP yn
    have hnum_a : numP.val = a := by
      change val (.bits pt) numP = a; rw [hnumP_val]; change xn.val * rd j y = a; rw [hxn_v]
    have hyn_b : yn.val = b := hyn_v
    have hcop_ab : Nat.gcd a.natAbs b.natAbs = 1 := by
      dsimp [a, b]
      rw [Int.natAbs_mul, ← hxn_v, ← hyn_v]
      have hcop_yd_yn : Nat.Coprime (rd j y).natAbs yn.val.natAbs :=
        Nat.Coprime.coprime_dvd_right
          (by rw [hyn_abs, show ynp.val.natAbs = (rn j y).natAbs by rw [← hynp_v]]
              exact Nat.div_dvd_of_dvd (Nat.gcd_dvd_right _ _))
          (Nat.Coprime.symm hy.2)
      exact Nat.Coprime.mul_left hcop hcop_yd_yn
    have hcross_ab : a * rn j y = (val i k * rd j y) * b := by
      dsimp [a, b]
      rw [← hxn_v, ← hyn_v]
      calc (xn.val * rd j y) * rn j y = xn.val * rd j y * (yn.val * gn) := by rw [hmul_yn]
        _ = (xn.val * gn) * rd j y * yn.val := by
            rw [← Int.mul_assoc, Int.mul_right_comm (xn.val * rd j y) yn.val gn,
                Int.mul_right_comm xn.val (rd j y) gn]
        _ = (val i k * rd j y) * yn.val := by rw [hmul_xn]
    by_cases hb_lt : b < 0
    · obtain ⟨hfa_neg, hfb_neg⟩ := hsafe.2 hb_lt
      rw [hnum_a, hyn_b] at hcd
      obtain ⟨q, hq_ok, hq_den_pos, hq_num, hq_den⟩ := hcd.2.1 hb_lt hfb_neg hfa_neg
      refine ⟨q, hq_ok, ⟨⟨Int.le_of_lt hq_den_pos, ?_⟩, ?_, fun _ => hq_den_pos, fun h => ?_⟩⟩
      · change Nat.gcd q.num.val.natAbs q.den.val.natAbs = 1
        rw [hq_num, hq_den, Int.natAbs_neg, Int.natAbs_neg]; exact hcop_ab
      · change q.num.val * rn j y = (val i k * rd j y) * q.den.val
        rw [hq_num, hq_den, Int.neg_mul, Int.mul_neg, hcross_ab]
      · have : b = 0 := by dsimp [b]; rw [h, Int.zero_tdiv]
        omega
    · have hb_nn : 0 ≤ yn.val := by rw [hyn_b]; omega
      have hq_ok := hcd.1 hb_nn
      refine ⟨⟨numP, yn⟩, hq_ok, ⟨⟨hb_nn, ?_⟩, ?_, fun hyn_nz => ?_, fun hyn0 => ?_⟩⟩
      · change Nat.gcd numP.val.natAbs yn.val.natAbs = 1
        rw [hnum_a, hyn_b]; exact hcop_ab
      · change numP.val * rn j y = (val i k * rd j y) * yn.val
        rw [hnum_a, hyn_b]; exact hcross_ab
      · change 0 < yn.val
        have : yn.val ≠ 0 := fun h0 => by rw [h0, Int.zero_mul] at hmul_yn; exact hyn_nz hmul_yn.symm
        omega
      · have hb0 : yn.val = 0 := by rw [hyn_b]; dsimp [b]; rw [hyn0, Int.zero_tdiv]
        refine ⟨hb0, ?_⟩
        rw [hxn_v, hkp_v] at hsign_xn
        have hyd_pos : 0 < rd j y := by
          cases j with | bits s =>
          change y.num.val = 0 at hyn0
          change 0 < y.den.val
          have hnorm_y : Normalized y := hy
          have := hnorm_y.1
          have hne0 : y.den.val ≠ 0 := fun hd0 => by
            have hyn_ext := (normalized_extremes_full hnorm_y).2 hd0
            rw [hyn0] at hyn_ext; omega
          omega
        change intSign numP.val = intSign (val i k * rd j y)
        rw [hnum_a]
        dsimp [a]
        unfold intSign at hsign_xn ⊢
        by_cases h1 : (val i k).tdiv gn < 0
        · have hk_lt : val i k < 0 := by split at hsign_xn <;> split at hsign_xn <;> omega
          have hp1 : (val i k).tdiv gn * rd j y < 0 := Int.mul_neg_of_neg_of_pos h1 hyd_pos
          have hp2 : val i k * rd j y < 0 := Int.mul_neg_of_neg_of_pos hk_lt hyd_pos
          simp [hp1, hp2]
        · by_cases h2 : (val i k).tdiv gn > 0
          · have hk_gt : val i k > 0 := by split at hsign_xn <;> split at hsign_xn <;> omega
            have hp1 : (val i k).tdiv gn * rd j y > 0 := Int.mul_pos h2 hyd_pos
            have hp2 : val i k * rd j y > 0 := Int.mul_pos hk_gt hyd_pos
            simp [hp1, hp2, show ¬ (val i k).tdiv gn * rd j y < 0 by omega,
              show ¬ val i k * rd j y < 0 by omega]
          · have hq0 : (val i k).tdiv gn = 0 := by omega
            have hk0 : val i k = 0 := by split at hsign_xn <;> split at hsign_xn <;> omega
            simp [hk0]
  · obtain ⟨kp, ynp, hok_p, hkp_v, hynp_v⟩ := hprom.1 ⟨hcv.1, hcv.2.1⟩
    simp only [hok_p, Bind.bind, Except.bind]
    cases p with | bits pt =>
    change kp.val = val i k at hkp_v
    change ynp.val = rn j y at hynp_v
    have hg_eq : (Nat.gcd kp.val.natAbs ynp.val.natAbs : Int) = gn := by
      dsimp [gn]; rw [hkp_v, hynp_v]
    obtain ⟨xn, yn, hok_dg, hxn_v, hyn_v, _, _, _, _, _, _, _, _⟩ :=
      (dgBits_spec kp ynp).2 (by dsimp; rw [hg_eq]; exact hgn_nz)
    rw [hg_eq, hkp_v] at hxn_v
    rw [hg_eq, hynp_v] at hyn_v
    have hdg_eq : dg (.bits pt) (.bits pt) = dgBits := rfl
    rw [hdg_eq, hok_dg]
    dsimp only [Bind.bind, Except.bind]
    by_cases hfa : (IntegerParameters.bits pt).fits a
    · obtain ⟨numP, hnumP_ok, hnumP_val⟩ := (prom_checkedMulPY_spec m xn y.den hyd_fit).1 (by
        change (IntegerParameters.bits pt).fits (xn.val * val j y.den)
        rw [hxn_v]; exact hfa)
      rw [hnumP_ok]
      dsimp only [checkedDenSameSource]
      have hops_sign : m.prom.opsP.signbit = (jintOps pt).signbit := (prom_opsP_sign_neg (.bits pt) m).1
      have hops_neg : m.prom.opsP.checkedNeg = (jintOps pt).checkedNeg := (prom_opsP_sign_neg (.bits pt) m).2
      have hcd := checkedDenBits_spec m.prom.opsP hops_sign hops_neg numP yn
      have hnum_a : numP.val = a := by
        change val (.bits pt) numP = a; rw [hnumP_val]; change xn.val * rd j y = a; rw [hxn_v]
      rw [hnum_a, hyn_v] at hcd
      have hb_lt : b < 0 := Decidable.byContradiction fun hge =>
        hnot_safe ⟨hfa, fun hlt => absurd hlt hge⟩
      apply hcd.2.2 hb_lt
      by_cases hfb_neg : pt.min ≤ -b ∧ -b ≤ pt.max
      · exact Or.inr fun hfa_neg => hnot_safe ⟨hfa, fun _ => ⟨hfa_neg, hfb_neg⟩⟩
      · exact Or.inl hfb_neg
    · obtain ⟨msg, herr_mul⟩ := (prom_checkedMulPY_spec m xn y.den hyd_fit).2 (by
        change ¬ (IntegerParameters.bits pt).fits (xn.val * val j y.den)
        rw [hxn_v]; exact hfa)
      rw [herr_mul]
      exact ⟨msg, rfl⟩

/-! ## 18 & 19. `gcd_lcm` and `gcd_lcm_infinite` -/

private theorem coprime_gcd_lcm {an ad bn bd : Nat}
    (ha : Nat.gcd an ad = 1) (hb : Nat.gcd bn bd = 1) :
    Nat.gcd (Nat.gcd an bn) (Nat.lcm ad bd) = 1 ∧
    Nat.gcd (Nat.lcm an bn) (Nat.gcd ad bd) = 1 := by
  have hg_ad : Nat.Coprime (Nat.gcd an bn) ad :=
    Nat.Coprime.coprime_dvd_left (Nat.gcd_dvd_left an bn) ha
  have hg_bd : Nat.Coprime (Nat.gcd an bn) bd :=
    Nat.Coprime.coprime_dvd_left (Nat.gcd_dvd_right an bn) hb
  have h1 : Nat.Coprime (Nat.gcd an bn) (Nat.lcm ad bd) :=
    Nat.Coprime.coprime_dvd_right (Nat.lcm_dvd_mul ad bd) (Nat.Coprime.mul_right hg_ad hg_bd)
  have hg_an : Nat.Coprime an (Nat.gcd ad bd) :=
    Nat.Coprime.coprime_dvd_right (Nat.gcd_dvd_left ad bd) ha
  have hg_bn : Nat.Coprime bn (Nat.gcd ad bd) :=
    Nat.Coprime.coprime_dvd_right (Nat.gcd_dvd_right ad bd) hb
  have h2 : Nat.Coprime (Nat.lcm an bn) (Nat.gcd ad bd) :=
    Nat.Coprime.coprime_dvd_left (Nat.lcm_dvd_mul an bn) (Nat.Coprime.mul_left hg_an hg_bn)
  exact ⟨h1, h2⟩

theorem gcd_lcm_aux {T : Type} (i : IntegerParameters T) (x y : Rational T)
    (hx : Canonical i x) (hy : Canonical i y) :
    GcdLcmContract i i i x y (rgcd i x y) (rlcm i x y) := by
  cases i with | bits t =>
  have hnorm_x : Normalized x := hx
  have hnorm_y : Normalized y := hy
  unfold GcdLcmContract rgcd rlcm gcdRationalSource lcmRationalSource
    igcd ilcm FitsPair ExactResult Represents Canonical
  have hinf_iff : (((fun q : Rat t => (IntegerParameters.bits t).ops.iszero q.den) x !=
      (fun q : Rat t => (IntegerParameters.bits t).ops.iszero q.den) y) = true) ↔
      ((x.den.val = 0) ≠ (y.den.val = 0)) := by
    dsimp only [IntegerParameters.ops, jintOps]
    by_cases hdx : x.den.val = 0 <;> by_cases hdy : y.den.val = 0
    · simp [hdx, hdy]
    · simp [hdx, hdy, beq_eq_false_iff_ne.mpr hdy]
    · simp [hdx, hdy, beq_eq_false_iff_ne.mpr hdx]
    · simp [hdx, hdy, beq_eq_false_iff_ne.mpr hdx, beq_eq_false_iff_ne.mpr hdy]
  refine ⟨fun hne => ?_, fun heq_inf => ?_⟩
  · rw [if_pos (hinf_iff.mpr hne), if_pos (hinf_iff.mpr hne)]
    exact ⟨⟨_, rfl⟩, ⟨_, rfl⟩⟩
  · have hnot_ne : ¬ ((x.den.val = 0) ≠ (y.den.val = 0)) := fun h => h heq_inf
    rw [if_neg (mt hinf_iff.mp hnot_ne), if_neg (mt hinf_iff.mp hnot_ne)]
    dsimp only [rn, rd, val, IntegerParameters.fits, IntegerParameters.ops, jintOps]
    let gnNat := Nat.gcd x.num.val.natAbs y.num.val.natAbs
    let gdNat := Nat.gcd x.den.val.natAbs y.den.val.natAbs
    let lnNat := Nat.lcm x.num.val.natAbs y.num.val.natAbs
    let ldNat := Nat.lcm x.den.val.natAbs y.den.val.natAbs
    have hgn_spec := gcd_BitInteger_exact x.num y.num
    have hgd_spec := gcd_BitInteger_exact x.den y.den
    have hln_spec := lcmBits_exact x.num y.num
    have hld_spec := lcmBits_exact x.den y.den
    have ⟨hcop1, hcop2⟩ := coprime_gcd_lcm hnorm_x.2 hnorm_y.2
    refine ⟨fun ⟨hf_gn, hf_ld⟩ => ?_, fun ⟨hf_ln, hf_gd⟩ => ?_, fun hnot_g => ?_, fun hnot_l => ?_⟩
    · obtain ⟨n', hn'_ok, hn'_val⟩ := hgn_spec.1 hf_gn
      obtain ⟨d', hd'_ok, hd'_val⟩ := hld_spec.1 hf_ld
      simp only [hn'_ok, hd'_ok, Bind.bind, Except.bind, Pure.pure, Except.pure, unsafeRationalSameSource_pair]
      refine ⟨⟨n', d'⟩, rfl, ⟨⟨by rw [hd'_val]; exact Int.natCast_nonneg _, ?_⟩,
        by rw [hn'_val, hd'_val, Int.mul_comm], fun hld_nz => ?_, fun hld0 => ?_⟩⟩
      · rw [hn'_val, hd'_val, Int.natAbs_natCast, Int.natAbs_natCast]; exact hcop1
      · rw [hd'_val]; omega
      · refine ⟨hd'_val.trans hld0, ?_⟩
        have hld_nat0 : ldNat = 0 := by omega
        have hdx0 : x.den.val = 0 := by
          by_cases hx0 : x.den.val = 0
          · exact hx0
          · have hy0 : y.den.val ≠ 0 := fun hy0 => hx0 (heq_inf.mpr hy0)
            have hpos := Nat.lcm_pos (Int.natAbs_pos.mpr hx0) (Int.natAbs_pos.mpr hy0)
            exact absurd hld_nat0 (Nat.ne_of_gt hpos)
        have hdy0 : y.den.val = 0 := heq_inf.mp hdx0
        have hxn := (normalized_extremes_full hnorm_x).2 hdx0
        have hyn := (normalized_extremes_full hnorm_y).2 hdy0
        have hgn1 : (gnNat : Int) = 1 := by
          dsimp [gnNat]; rw [hxn.1, hyn.1]; rfl
        rw [hn'_val, hgn1]
    · obtain ⟨n', hn'_ok, hn'_val⟩ := hln_spec.1 hf_ln
      obtain ⟨d', hd'_ok, hd'_val⟩ := hgd_spec.1 hf_gd
      simp only [hn'_ok, hd'_ok, Bind.bind, Except.bind, Pure.pure, Except.pure, unsafeRationalSameSource_pair]
      refine ⟨⟨n', d'⟩, rfl, ⟨⟨by rw [hd'_val]; exact Int.natCast_nonneg _, ?_⟩,
        by rw [hn'_val, hd'_val, Int.mul_comm], fun hgd_nz => ?_, fun hgd0 => ?_⟩⟩
      · rw [hn'_val, hd'_val, Int.natAbs_natCast, Int.natAbs_natCast]; exact hcop2
      · rw [hd'_val]; omega
      · refine ⟨hd'_val.trans hgd0, ?_⟩
        have hgd_nat0 : gdNat = 0 := by omega
        have ⟨hdx_abs, hdy_abs⟩ := Nat.gcd_eq_zero_iff.mp hgd_nat0
        have hdx0 : x.den.val = 0 := by omega
        have hdy0 : y.den.val = 0 := by omega
        have hxn := (normalized_extremes_full hnorm_x).2 hdx0
        have hyn := (normalized_extremes_full hnorm_y).2 hdy0
        have hln1 : (lnNat : Int) = 1 := by
          dsimp [lnNat]; rw [hxn.1, hyn.1]; rfl
        rw [hn'_val, hln1]
    · by_cases hf_gn : t.min ≤ (gnNat : Int) ∧ (gnNat : Int) ≤ t.max
      · obtain ⟨n', hn'_ok, _⟩ := hgn_spec.1 hf_gn
        have hnot_ld : ¬ (t.min ≤ (ldNat : Int) ∧ (ldNat : Int) ≤ t.max) :=
          hnot_g.resolve_left (fun h => h hf_gn)
        obtain ⟨msg, hd'_err⟩ := hld_spec.2 hnot_ld
        simp [hn'_ok, hd'_err, Bind.bind, Except.bind, IsOverflow]
      · obtain ⟨msg, hn'_err⟩ := hgn_spec.2 hf_gn
        simp [hn'_err, Bind.bind, Except.bind, IsOverflow]
    · by_cases hf_ln : t.min ≤ (lnNat : Int) ∧ (lnNat : Int) ≤ t.max
      · obtain ⟨n', hn'_ok, _⟩ := hln_spec.1 hf_ln
        have hnot_gd : ¬ (t.min ≤ (gdNat : Int) ∧ (gdNat : Int) ≤ t.max) :=
          hnot_l.resolve_left (fun h => h hf_ln)
        obtain ⟨msg, hd'_err⟩ := hgd_spec.2 hnot_gd
        simp [hn'_ok, hd'_err, Bind.bind, Except.bind, IsOverflow]
      · obtain ⟨msg, hn'_err⟩ := hln_spec.2 hf_ln
        simp [hn'_err, Bind.bind, Except.bind, IsOverflow]

theorem gcd_lcm_infinite_aux {T : Type} (i : IntegerParameters T) (x y : Rational T)
    (hx : Canonical i x) (hy : Canonical i y) :
    GcdLcmContract i i i x y (rgcd i x y) (rlcm i x y) ∧
    ((rd i x = 0) ≠ (rd i y = 0) → IsArgument (rgcd i x y) ∧ IsArgument (rlcm i x y)) := by
  have h := gcd_lcm_aux i x y hx hy
  exact ⟨h, h.1⟩

/-! ## 32, 33, 35. Complex Rational Operations -/



theorem complex_integer_inverse_aux {T : Type} (i : IntegerParameters T) (z : C T) :
    let g : Int := Nat.gcd (val i z.re).natAbs (val i z.im).natAbs
    let c := (val i z.re).tdiv g
    let d := (val i z.im).tdiv g
    let den := val i z.re*c+val i z.im*d
    let safe := i.fits (val i z.re*c) ∧ i.fits (val i z.im*d) ∧ i.fits den ∧ i.fits (-d)
    let run := complexExactInvIntegerSource cri (dg i i) i.ops.checkedMul i.ops.checkedAdd i.ops.checkedNeg cmk z
    (g = 0 → run = .error .divideError) ∧
    (g ≠ 0 → safe → ∃ n den, run = .ok (n,den) ∧
      val i z.re*val i n.re-val i z.im*val i n.im = val i den ∧
      val i z.re*val i n.im+val i z.im*val i n.re = 0 ∧ 0 < val i den) ∧
    (g ≠ 0 → ¬ safe → IsOverflow run) := by
  cases i with | bits t =>
  intro g c d den safe run
  unfold run complexExactInvIntegerSource cri cmk cre cim
    JuliaLean.base.complex.reim JuliaLean.base.complex.real_Complex
    JuliaLean.base.complex.imag_Complex JuliaLean.base.complex.complexOfPromoted
    IntegerParameters.ops jintOps
    JuliaLean.base.rational.checkedMul JuliaLean.base.rational.checkedAdd JuliaLean.base.rational.checkedNeg
  have hdg_eq : dg (.bits t) (.bits t) = dgBits := rfl
  rw [hdg_eq]
  dsimp only [Bind.bind, Except.bind, Pure.pure, Except.pure]
  have hdg := dgBits_spec z.re z.im
  refine ⟨fun hg0 => by rw [hdg.1 hg0], fun hg_nz hsafe => ?_, fun hg_nz hnot_safe => ?_⟩
  · dsimp only [safe, den, val, IntegerParameters.fits, IntegerParameters.ops, jintOps] at hsafe
    obtain ⟨cR, dR, hok_dg, hcR_v, hdR_v, _, _, _, hmul_c, hmul_d, hcross, _, _⟩ := hdg.2 hg_nz
    rw [hok_dg]
    dsimp only [Bind.bind, Except.bind]
    have hmc := JuliaLean.Proofs.base.checked.mulExact t z.re cR
    have hmd := JuliaLean.Proofs.base.checked.mulExact t z.im dR
    unfold JuliaLean.Proofs.base.checked.ExactOrOverflow at hmc hmd
    have hcR_c : cR.val = c := hcR_v
    have hdR_d : dR.val = d := hdR_v
    rw [hcR_c] at hmc
    rw [hdR_d] at hmd
    simp only [if_pos hsafe.1] at hmc
    simp only [if_pos hsafe.2.1] at hmd
    obtain ⟨c2, hc2_ok, hc2_val⟩ := hmc
    obtain ⟨d2, hd2_ok, hd2_val⟩ := hmd
    rw [hc2_ok, hd2_ok]
    dsimp only
    have hadd := JuliaLean.Proofs.base.checked.addExact t c2 d2
    unfold JuliaLean.Proofs.base.checked.ExactOrOverflow at hadd
    rw [hc2_val, hd2_val] at hadd
    simp only [if_pos hsafe.2.2.1] at hadd
    obtain ⟨denJ, hdenJ_ok, hdenJ_val⟩ := hadd
    rw [hdenJ_ok]
    dsimp only
    have hneg := JuliaLean.Proofs.base.checked.negExact t dR
    unfold JuliaLean.Proofs.base.checked.ExactOrOverflow at hneg
    rw [hdR_d] at hneg
    simp only [if_pos hsafe.2.2.2] at hneg
    obtain ⟨negD, hnegD_ok, hnegD_val⟩ := hneg
    rw [hnegD_ok]
    dsimp only [Pure.pure, Except.pure, val, IntegerParameters.ops, jintOps]
    have hden_pos : 0 < den := by
      have hg_pos : 0 < g := Decidable.byContradiction fun h => hg_nz (by
        dsimp [g, val, IntegerParameters.ops, jintOps] at *; omega)
      have hsq_pos : 0 < z.re.val * z.re.val + z.im.val * z.im.val := by
        have h1 : 0 ≤ z.re.val * z.re.val := by
          by_cases h : z.re.val < 0
          · exact Int.le_of_lt (Int.mul_pos_of_neg_of_neg h h)
          · exact Int.mul_nonneg (by omega) (by omega)
        have h2 : 0 ≤ z.im.val * z.im.val := by
          by_cases h : z.im.val < 0
          · exact Int.le_of_lt (Int.mul_pos_of_neg_of_neg h h)
          · exact Int.mul_nonneg (by omega) (by omega)
        have hnz : z.re.val ≠ 0 ∨ z.im.val ≠ 0 := by
          by_cases hre0 : z.re.val = 0
          · right; intro him0; apply hg_nz
            dsimp [g, val, IntegerParameters.ops, jintOps]; rw [hre0, him0]; rfl
          · exact Or.inl hre0
        rcases hnz with hre | him
        · have : 0 < z.re.val * z.re.val := by
            by_cases hlt : z.re.val < 0
            · exact Int.mul_pos_of_neg_of_neg hlt hlt
            · exact Int.mul_pos (by omega) (by omega)
          omega
        · have : 0 < z.im.val * z.im.val := by
            by_cases hlt : z.im.val < 0
            · exact Int.mul_pos_of_neg_of_neg hlt hlt
            · exact Int.mul_pos (by omega) (by omega)
          omega
      have hden_g : den * g = z.re.val * z.re.val + z.im.val * z.im.val := by
        dsimp [den, c, d, g, val, IntegerParameters.ops, jintOps]
        rw [← hcR_v, ← hdR_v, Int.add_mul, Int.mul_assoc, hmul_c, Int.mul_assoc, hmul_d]
      exact Decidable.byContradiction fun hle =>
        absurd hsq_pos (Int.not_lt.mpr (by rw [← hden_g]; exact Int.mul_nonpos_of_nonpos_of_nonneg (by omega) (by omega)))
    refine ⟨⟨cR, negD⟩, denJ, rfl, ?_, ?_, by rw [hdenJ_val]; exact hden_pos⟩
    · rw [hcR_c, hnegD_val, hdenJ_val, Int.mul_neg]
      dsimp [c, d, g, val, IntegerParameters.ops, jintOps]; omega
    · rw [hcR_c, hnegD_val, Int.mul_neg, ← hcR_c, ← hdR_d]
      have : z.re.val * dR.val = z.im.val * cR.val := by
        rw [← hcross, Int.mul_comm]
      omega
  · dsimp only [safe, val, IntegerParameters.fits, IntegerParameters.ops, jintOps] at hnot_safe
    obtain ⟨cR, dR, hok_dg, hcR_v, hdR_v, _, _, _, _, _, _, _, _⟩ := hdg.2 hg_nz
    rw [hok_dg]
    dsimp only [Bind.bind, Except.bind]
    have hmc := JuliaLean.Proofs.base.checked.mulExact t z.re cR
    unfold JuliaLean.Proofs.base.checked.ExactOrOverflow at hmc
    have hcR_c : cR.val = c := hcR_v
    have hdR_d : dR.val = d := hdR_v
    rw [hcR_c] at hmc
    by_cases hf1 : t.min ≤ z.re.val * c ∧ z.re.val * c ≤ t.max
    · simp only [if_pos hf1] at hmc
      obtain ⟨c2, hc2_ok, hc2_val⟩ := hmc
      rw [hc2_ok]; dsimp only
      have hmd := JuliaLean.Proofs.base.checked.mulExact t z.im dR
      unfold JuliaLean.Proofs.base.checked.ExactOrOverflow at hmd
      rw [hdR_d] at hmd
      by_cases hf2 : t.min ≤ z.im.val * d ∧ z.im.val * d ≤ t.max
      · simp only [if_pos hf2] at hmd
        obtain ⟨d2, hd2_ok, hd2_val⟩ := hmd
        rw [hd2_ok]; dsimp only
        have hadd := JuliaLean.Proofs.base.checked.addExact t c2 d2
        unfold JuliaLean.Proofs.base.checked.ExactOrOverflow at hadd
        rw [hc2_val, hd2_val, show z.re.val * c + z.im.val * d = den from rfl] at hadd
        by_cases hf3 : t.min ≤ den ∧ den ≤ t.max
        · simp only [if_pos hf3] at hadd
          obtain ⟨denJ, hdenJ_ok, _⟩ := hadd
          rw [hdenJ_ok]; dsimp only
          have hf4 : ¬ (t.min ≤ -d ∧ -d ≤ t.max) := fun h => hnot_safe ⟨hf1, hf2, hf3, h⟩
          have hneg := JuliaLean.Proofs.base.checked.negExact t dR
          unfold JuliaLean.Proofs.base.checked.ExactOrOverflow at hneg
          rw [hdR_d, if_neg hf4] at hneg
          cases hcall : JuliaLean.base.checked.checkedNegBits dR with
          | ok _ => rw [hcall] at hneg; contradiction
          | error err => rw [hcall] at hneg; cases err <;> first | contradiction | exact ⟨_, rfl⟩
        · simp only [if_neg hf3] at hadd
          cases hcall : JuliaLean.base.checked.checkedAddBits c2 d2 with
          | ok _ => rw [hcall] at hadd; contradiction
          | error err => rw [hcall] at hadd; cases err <;> first | contradiction | exact ⟨_, rfl⟩
      · simp only [if_neg hf2] at hmd
        cases hcall : JuliaLean.base.checked.checkedMulBits z.im dR with
        | ok _ => rw [hcall] at hmd; contradiction
        | error err => rw [hcall] at hmd; cases err <;> first | contradiction | exact ⟨_, rfl⟩
    · simp only [if_neg hf1] at hmc
      cases hcall : JuliaLean.base.checked.checkedMulBits z.re cR with
      | ok _ => rw [hcall] at hmc; contradiction
      | error err => rw [hcall] at hmc; cases err <;> first | contradiction | exact ⟨_, rfl⟩

theorem complex_numerator_aux {T : Type} (i : IntegerParameters T) (z : C (Rational T))
    (hr : Canonical i z.re) (hi : Canonical i z.im) :
    let d : Int := Nat.lcm (rd i z.re).natAbs (rd i z.im).natAbs
    let nr := rn i z.re * d.tdiv (rd i z.re)
    let ni := rn i z.im * d.tdiv (rd i z.im)
    let nRun := numeratorComplexSource cre cim (ilcm i) i.ops.divToZero i.ops.checkedMul cmk z
    let dRun := denominatorComplexSource cre cim (ilcm i) z
    (rd i z.re > 0 → rd i z.im > 0 → i.fits d → i.fits nr → i.fits ni →
      ∃ n den, nRun = .ok n ∧ dRun = .ok den ∧ val i den = d ∧
        val i n.re*rd i z.re = rn i z.re*val i den ∧
        val i n.im*rd i z.im = rn i z.im*val i den) ∧
    (¬ i.fits d → IsOverflow nRun ∧ IsOverflow dRun) ∧
    (rd i z.re = 0 ∨ rd i z.im = 0 → nRun = .error .divideError) := by
  cases i with | bits t =>
  intro d nr ni nRun dRun
  unfold nRun dRun numeratorComplexSource denominatorComplexSource
    cre cim cmk ilcm IntegerParameters.ops jintOps
    JuliaLean.base.complex.real_Complex JuliaLean.base.complex.imag_Complex
    JuliaLean.base.complex.complexOfPromoted
    numeratorRationalSource denominatorRationalSource
    JuliaLean.base.div.divBitIntegerToZero JuliaLean.base.div.div_BitInteger_ToZero
    JuliaLean.base.rational.checkedMul
  dsimp only [Bind.bind, Except.bind, Pure.pure, Except.pure]
  have hlcm := lcmBits_exact z.re.den z.im.den
  refine ⟨fun hre_pos him_pos hfd hfnr hfni => ?_, fun hnot_fd => ?_, fun hzero => ?_⟩
  · dsimp only [d, nr, ni, rn, rd, val, IntegerParameters.fits, IntegerParameters.ops, jintOps] at hre_pos him_pos hfd hfnr hfni ⊢
    obtain ⟨den, hden_ok, hden_val⟩ := hlcm.1 hfd
    simp only [hden_ok]
    have hd_pos : 0 < den.val := by
      rw [hden_val]
      exact Int.natCast_pos.mpr (Nat.lcm_pos (Int.natAbs_pos.mpr (by omega)) (Int.natAbs_pos.mpr (by omega)))
    have hdiv_re_ok : JuliaLean.base.int.divSame den z.re.den = .ok (JuliaLean.base.int.lit t (den.val.tdiv z.re.den.val)) := by
      rw [divSame_eq, if_neg (by omega)]
    have hdiv_im_ok : JuliaLean.base.int.divSame den z.im.den = .ok (JuliaLean.base.int.lit t (den.val.tdiv z.im.den.val)) := by
      rw [divSame_eq, if_neg (by omega)]
    let qRe := JuliaLean.base.int.lit t (den.val.tdiv z.re.den.val)
    let qIm := JuliaLean.base.int.lit t (den.val.tdiv z.im.den.val)
    have hqRe_val : qRe.val = (Nat.lcm z.re.den.val.natAbs z.im.den.val.natAbs : Int).tdiv z.re.den.val := by
      dsimp [qRe]; rw [lit_of_fits (tdiv_fits den z.re.den (by omega) (by omega)), hden_val]
    have hqIm_val : qIm.val = (Nat.lcm z.re.den.val.natAbs z.im.den.val.natAbs : Int).tdiv z.im.den.val := by
      dsimp [qIm]; rw [lit_of_fits (tdiv_fits den z.im.den (by omega) (by omega)), hden_val]
    simp only [hdiv_re_ok, hdiv_im_ok]
    have hmul_re := JuliaLean.Proofs.base.checked.mulExact t z.re.num qRe
    have hmul_im := JuliaLean.Proofs.base.checked.mulExact t z.im.num qIm
    unfold JuliaLean.Proofs.base.checked.ExactOrOverflow at hmul_re hmul_im
    rw [hqRe_val] at hmul_re
    rw [hqIm_val] at hmul_im
    simp only [if_pos hfnr] at hmul_re
    simp only [if_pos hfni] at hmul_im
    obtain ⟨nRe, hnRe_ok, hnRe_val⟩ := hmul_re
    obtain ⟨nIm, hnIm_ok, hnIm_val⟩ := hmul_im
    dsimp only [qRe, qIm] at hnRe_ok hnIm_ok
    rw [hnRe_ok, hnIm_ok]
    dsimp only [Bind.bind, Except.bind, Pure.pure, Except.pure, val, IntegerParameters.ops, jintOps]
    have hdvd_re : z.re.den.val.natAbs ∣ Nat.lcm z.re.den.val.natAbs z.im.den.val.natAbs :=
      Nat.dvd_lcm_left _ _
    have hdvd_im : z.im.den.val.natAbs ∣ Nat.lcm z.re.den.val.natAbs z.im.den.val.natAbs :=
      Nat.dvd_lcm_right _ _
    have hmul_cancel_re : (Nat.lcm z.re.den.val.natAbs z.im.den.val.natAbs : Int).tdiv z.re.den.val * z.re.den.val =
        (Nat.lcm z.re.den.val.natAbs z.im.den.val.natAbs : Int) := by
      have hd_abs : z.re.den.val = (z.re.den.val.natAbs : Int) := (Int.natAbs_of_nonneg (by omega)).symm
      rw [hd_abs]
      exact tdiv_mul_cancel_of_dvd _ z.re.den.val.natAbs (by rw [Int.natAbs_natCast]; exact hdvd_re)
    have hmul_cancel_im : (Nat.lcm z.re.den.val.natAbs z.im.den.val.natAbs : Int).tdiv z.im.den.val * z.im.den.val =
        (Nat.lcm z.re.den.val.natAbs z.im.den.val.natAbs : Int) := by
      have hd_abs : z.im.den.val = (z.im.den.val.natAbs : Int) := (Int.natAbs_of_nonneg (by omega)).symm
      rw [hd_abs]
      exact tdiv_mul_cancel_of_dvd _ z.im.den.val.natAbs (by rw [Int.natAbs_natCast]; exact hdvd_im)
    refine ⟨⟨nRe, nIm⟩, den, rfl, rfl, hden_val, ?_, ?_⟩
    · rw [hnRe_val, hden_val, Int.mul_assoc, hmul_cancel_re]
    · rw [hnIm_val, hden_val, Int.mul_assoc, hmul_cancel_im]
  · dsimp only [d, rd, val, IntegerParameters.fits, IntegerParameters.ops, jintOps] at hnot_fd
    obtain ⟨msg, herr⟩ := hlcm.2 hnot_fd
    simp [herr, IsOverflow]
  · dsimp only [d, nr, ni, rn, rd, val, IntegerParameters.fits, IntegerParameters.ops, jintOps] at hzero ⊢
    have hd0 : (Nat.lcm z.re.den.val.natAbs z.im.den.val.natAbs : Int) = 0 := by
      rcases hzero with hre0 | him0
      · rw [hre0, Int.natAbs_zero, Nat.lcm_zero_left]; rfl
      · rw [him0, Int.natAbs_zero, Nat.lcm_zero_right]; rfl
    have hfd0 : t.min ≤ (Nat.lcm z.re.den.val.natAbs z.im.den.val.natAbs : Int) ∧
        (Nat.lcm z.re.den.val.natAbs z.im.den.val.natAbs : Int) ≤ t.max := by
      rw [hd0]; exact ⟨min_le_zero t, zero_le_max t⟩
    obtain ⟨den, hden_ok, hden_val⟩ := hlcm.1 hfd0
    rw [hd0] at hden_val
    simp only [hden_ok]
    by_cases hre0 : z.re.den.val = 0
    · have hdiv_err : JuliaLean.base.int.divSame den z.re.den = .error .divideError := by
        rw [divSame_eq, if_pos (Or.inl hre0)]
      rw [hdiv_err]
    · have him0 : z.im.den.val = 0 := hzero.resolve_left hre0
      have hdiv_re_ok : JuliaLean.base.int.divSame den z.re.den = .ok (JuliaLean.base.int.lit t 0) := by
        rw [divSame_eq, if_neg (by have h := hr.1; change 0 ≤ z.re.den.val at h; omega), hden_val, Int.zero_tdiv]
      have h0_val : (JuliaLean.base.int.lit t 0).val = 0 := by cases t <;> decide
      have hmul0 := JuliaLean.Proofs.base.checked.mulExact t z.re.num (JuliaLean.base.int.lit t 0)
      unfold JuliaLean.Proofs.base.checked.ExactOrOverflow at hmul0
      rw [h0_val, Int.mul_zero, if_pos ⟨min_le_zero t, zero_le_max t⟩] at hmul0
      obtain ⟨nRe, hnRe_ok, _⟩ := hmul0
      have hdiv_im_err : JuliaLean.base.int.divSame den z.im.den = .error .divideError := by
        rw [divSame_eq, if_pos (Or.inl him0)]
      rw [hdiv_re_ok]; dsimp only
      rw [hnRe_ok]; dsimp only
      rw [hdiv_im_err]



theorem complex_quotient_aux (t : IntTy) (x y : C (JInt t)) :
    let i := IntegerParameters.bits t
    let g : Int := Nat.gcd y.re.val.natAbs y.im.val.natAbs
    let c := y.re.val.tdiv g
    let d := y.im.val.tdiv g
    let den := y.re.val*c+y.im.val*d
    let nr := x.re.val*c+x.im.val*d
    let ni := x.im.val*c-x.re.val*d
    let safe := i.fits (y.re.val*c) ∧ i.fits (y.im.val*d) ∧ i.fits den ∧
      i.fits (x.re.val*c) ∧ i.fits (x.im.val*d) ∧ i.fits nr ∧
      i.fits (x.im.val*c) ∧ i.fits (x.re.val*d) ∧ i.fits (-x.re.val*d) ∧ i.fits ni
    (g = 0 → cq t x y = .error .divideError) ∧
    (g ≠ 0 → safe → ∃ q, cq t x y = .ok q ∧
      Represents i q.re (x.re.val*y.re.val+x.im.val*y.im.val) (y.re.val^2+y.im.val^2) ∧
      Represents i q.im (x.im.val*y.re.val-x.re.val*y.im.val) (y.re.val^2+y.im.val^2)) ∧
    (g ≠ 0 → ¬ safe → IsOverflow (cq t x y)) := by
  intro i g c d den nr ni safe
  have hprom4 : promoteFourSame t x.re x.im y.re y.im = .ok (x.re, x.im, y.re, y.im) := rfl
  unfold cq divideComplexIntegersSource cdiv exactDivideComplexReal cri cmk cre cim
    JuliaLean.base.complex.reim JuliaLean.base.complex.real_Complex
    JuliaLean.base.complex.imag_Complex JuliaLean.base.complex.complexOfPromoted
    jintOps JuliaLean.base.rational.checkedMul JuliaLean.base.rational.checkedAdd
    JuliaLean.base.rational.checkedNeg
  have hdg_eq : dg (.bits t) (.bits t) = dgBits := rfl
  dsimp only [Bind.bind, Except.bind, Pure.pure, Except.pure]
  rw [hprom4, hdg_eq]
  dsimp only
  have hdg := dgBits_spec y.re y.im
  refine ⟨fun hg0 => by rw [hdg.1 hg0], fun hg_nz hsafe => ?_, fun hg_nz hnot_safe => ?_⟩
  · dsimp only [safe, i, den, nr, IntegerParameters.fits] at hsafe
    obtain ⟨cR, dR, hok_dg, hcR_v, hdR_v, _, _, _, hmul_c, hmul_d, _, _, _⟩ := hdg.2 hg_nz
    rw [hok_dg]
    dsimp only [Bind.bind, Except.bind]
    rcases hsafe with ⟨hf1, hf2, hf3, hf4, hf5, hf6, hf7, hf8, hf9, hf10⟩
    have hm1 := JuliaLean.Proofs.base.checked.mulExact t y.re cR
    have hm2 := JuliaLean.Proofs.base.checked.mulExact t y.im dR
    have hm4 := JuliaLean.Proofs.base.checked.mulExact t x.re cR
    have hm5 := JuliaLean.Proofs.base.checked.mulExact t x.im dR
    have hm7 := JuliaLean.Proofs.base.checked.mulExact t x.im cR
    have hm8 := JuliaLean.Proofs.base.checked.mulExact t x.re dR
    unfold JuliaLean.Proofs.base.checked.ExactOrOverflow at hm1 hm2 hm4 hm5 hm7 hm8
    have hcR_c : cR.val = c := hcR_v
    have hdR_d : dR.val = d := hdR_v
    rw [hcR_c] at hm1 hm4 hm7
    rw [hdR_d] at hm2 hm5 hm8
    simp only [if_pos hf1] at hm1; obtain ⟨c2, hc2_ok, hc2_v⟩ := hm1
    simp only [if_pos hf2] at hm2; obtain ⟨d2, hd2_ok, hd2_v⟩ := hm2
    simp only [if_pos hf4] at hm4; obtain ⟨ac, hac_ok, hac_v⟩ := hm4
    simp only [if_pos hf5] at hm5; obtain ⟨bd, hbd_ok, hbd_v⟩ := hm5
    simp only [if_pos hf7] at hm7; obtain ⟨bc, hbc_ok, hbc_v⟩ := hm7
    simp only [if_pos hf8] at hm8; obtain ⟨ad, had_ok, had_v⟩ := hm8
    rw [hc2_ok, hd2_ok, hac_ok, hbd_ok, hbc_ok, had_ok]
    dsimp only
    have ha3 := JuliaLean.Proofs.base.checked.addExact t c2 d2
    have ha6 := JuliaLean.Proofs.base.checked.addExact t ac bd
    have hn9 := JuliaLean.Proofs.base.checked.negExact t ad
    unfold JuliaLean.Proofs.base.checked.ExactOrOverflow at ha3 ha6 hn9
    rw [hc2_v, hd2_v] at ha3
    rw [hac_v, hbd_v] at ha6
    rw [had_v, show -(x.re.val * d) = -x.re.val * d by rw [Int.neg_mul]] at hn9
    simp only [if_pos hf3] at ha3; obtain ⟨denJ, hdenJ_ok, hdenJ_v⟩ := ha3
    simp only [if_pos hf6] at ha6; obtain ⟨reJ, hreJ_ok, hreJ_v⟩ := ha6
    simp only [if_pos hf9] at hn9; obtain ⟨negAD, hnegAD_ok, hnegAD_v⟩ := hn9
    rw [hdenJ_ok, hreJ_ok, hnegAD_ok]
    dsimp only
    have ha10 := JuliaLean.Proofs.base.checked.addExact t bc negAD
    unfold JuliaLean.Proofs.base.checked.ExactOrOverflow at ha10
    rw [hbc_v, hnegAD_v, show x.im.val * c + -x.re.val * d = ni by
      dsimp [ni]; rw [Int.neg_mul, ← Int.sub_eq_add_neg]] at ha10
    simp only [if_pos hf10] at ha10; obtain ⟨imJ, himJ_ok, himJ_v⟩ := ha10
    rw [himJ_ok]
    dsimp only
    have hg_pos : 0 < g := Decidable.byContradiction fun h => hg_nz (by dsimp [g] at *; omega)
    have hden_g : den * g = y.re.val ^ 2 + y.im.val ^ 2 := by
      dsimp [den, c, d, g]
      rw [← hcR_v, ← hdR_v, Int.add_mul, Int.mul_assoc, hmul_c, Int.mul_assoc, hmul_d,
        Int.pow_succ, Int.pow_one, Int.pow_succ, Int.pow_one]
    have hnr_g : nr * g = x.re.val * y.re.val + x.im.val * y.im.val := by
      dsimp [nr, c, d, g]
      rw [← hcR_v, ← hdR_v, Int.add_mul, Int.mul_assoc, hmul_c, Int.mul_assoc, hmul_d]
    have hni_g : ni * g = x.im.val * y.re.val - x.re.val * y.im.val := by
      dsimp [ni, c, d, g]
      rw [← hcR_v, ← hdR_v, Int.sub_mul, Int.mul_assoc, hmul_c, Int.mul_assoc, hmul_d]
    have hden_pos : 0 < val i denJ := by
      change 0 < denJ.val
      rw [hdenJ_v]
      have hsq_pos : 0 < y.re.val ^ 2 + y.im.val ^ 2 := by
        rw [Int.pow_succ, Int.pow_one, Int.pow_succ, Int.pow_one]
        have h1 : 0 ≤ y.re.val * y.re.val := by
          by_cases h : y.re.val < 0
          · exact Int.le_of_lt (Int.mul_pos_of_neg_of_neg h h)
          · exact Int.mul_nonneg (by omega) (by omega)
        have h2 : 0 ≤ y.im.val * y.im.val := by
          by_cases h : y.im.val < 0
          · exact Int.le_of_lt (Int.mul_pos_of_neg_of_neg h h)
          · exact Int.mul_nonneg (by omega) (by omega)
        by_cases hre0 : y.re.val = 0
        · have him0 : y.im.val ≠ 0 := fun h => hg_nz (by dsimp [g]; rw [hre0, h]; rfl)
          have : 0 < y.im.val * y.im.val := by
            by_cases hlt : y.im.val < 0
            · exact Int.mul_pos_of_neg_of_neg hlt hlt
            · exact Int.mul_pos (by omega) (by omega)
          omega
        · have : 0 < y.re.val * y.re.val := by
            by_cases hlt : y.re.val < 0
            · exact Int.mul_pos_of_neg_of_neg hlt hlt
            · exact Int.mul_pos (by omega) (by omega)
          omega
      exact Decidable.byContradiction fun hle =>
        absurd hsq_pos (Int.not_lt.mpr (by rw [← hden_g]; exact Int.mul_nonpos_of_nonpos_of_nonneg (by omega) (by omega)))
    obtain ⟨qre, hqre_ok, hqre_rep⟩ := rational_pos_den_exact i reJ denJ hden_pos
    obtain ⟨qim, hqim_ok, hqim_rep⟩ := rational_pos_den_exact i imJ denJ hden_pos
    dsimp only [exactDivideIntsSource, i] at hqre_ok hqim_ok ⊢
    rw [hqre_ok, hqim_ok]
    dsimp only [Bind.bind, Except.bind, Pure.pure, Except.pure]
    have hre_v : val i reJ = nr := hreJ_v
    have him_v : val i imJ = ni := himJ_v
    have hden_v : val i denJ = den := hdenJ_v
    rw [hre_v, hden_v] at hqre_rep
    rw [him_v, hden_v] at hqim_rep
    have hqre_scaled := represents_scale_pos hg_pos hqre_rep
    have hqim_scaled := represents_scale_pos hg_pos hqim_rep
    rw [hnr_g, hden_g] at hqre_scaled
    rw [hni_g, hden_g] at hqim_scaled
    exact ⟨⟨qre, qim⟩, rfl, hqre_scaled, hqim_scaled⟩
  · dsimp only [safe, i, IntegerParameters.fits] at hnot_safe
    obtain ⟨cR, dR, hok_dg, hcR_v, hdR_v, _, _, _, _, _, _, _, _⟩ := hdg.2 hg_nz
    have hcR_c : cR.val = c := hcR_v
    have hdR_d : dR.val = d := hdR_v
    rw [hok_dg]
    dsimp only [Bind.bind, Except.bind]
    have hm1 := JuliaLean.Proofs.base.checked.mulExact t y.re cR
    unfold JuliaLean.Proofs.base.checked.ExactOrOverflow at hm1; rw [hcR_c] at hm1
    by_cases hf1 : t.min ≤ y.re.val * c ∧ y.re.val * c ≤ t.max
    · simp only [if_pos hf1] at hm1; obtain ⟨c2, hc2_ok, hc2_v⟩ := hm1; rw [hc2_ok]; dsimp only
      have hm2 := JuliaLean.Proofs.base.checked.mulExact t y.im dR
      unfold JuliaLean.Proofs.base.checked.ExactOrOverflow at hm2; rw [hdR_d] at hm2
      by_cases hf2 : t.min ≤ y.im.val * d ∧ y.im.val * d ≤ t.max
      · simp only [if_pos hf2] at hm2; obtain ⟨d2, hd2_ok, hd2_v⟩ := hm2; rw [hd2_ok]; dsimp only
        have ha3 := JuliaLean.Proofs.base.checked.addExact t c2 d2
        unfold JuliaLean.Proofs.base.checked.ExactOrOverflow at ha3
        rw [hc2_v, hd2_v, show y.re.val * c + y.im.val * d = den from rfl] at ha3
        by_cases hf3 : t.min ≤ den ∧ den ≤ t.max
        · simp only [if_pos hf3] at ha3; obtain ⟨denJ, hdenJ_ok, _⟩ := ha3; rw [hdenJ_ok]; dsimp only
          have hm4 := JuliaLean.Proofs.base.checked.mulExact t x.re cR
          unfold JuliaLean.Proofs.base.checked.ExactOrOverflow at hm4; rw [hcR_c] at hm4
          by_cases hf4 : t.min ≤ x.re.val * c ∧ x.re.val * c ≤ t.max
          · simp only [if_pos hf4] at hm4; obtain ⟨ac, hac_ok, hac_v⟩ := hm4; rw [hac_ok]; dsimp only
            have hm5 := JuliaLean.Proofs.base.checked.mulExact t x.im dR
            unfold JuliaLean.Proofs.base.checked.ExactOrOverflow at hm5; rw [hdR_d] at hm5
            by_cases hf5 : t.min ≤ x.im.val * d ∧ x.im.val * d ≤ t.max
            · simp only [if_pos hf5] at hm5; obtain ⟨bd, hbd_ok, hbd_v⟩ := hm5; rw [hbd_ok]; dsimp only
              have ha6 := JuliaLean.Proofs.base.checked.addExact t ac bd
              unfold JuliaLean.Proofs.base.checked.ExactOrOverflow at ha6
              rw [hac_v, hbd_v, show x.re.val * c + x.im.val * d = nr from rfl] at ha6
              by_cases hf6 : t.min ≤ nr ∧ nr ≤ t.max
              · simp only [if_pos hf6] at ha6; obtain ⟨reJ, hreJ_ok, _⟩ := ha6; rw [hreJ_ok]; dsimp only
                have hm7 := JuliaLean.Proofs.base.checked.mulExact t x.im cR
                unfold JuliaLean.Proofs.base.checked.ExactOrOverflow at hm7; rw [hcR_c] at hm7
                by_cases hf7 : t.min ≤ x.im.val * c ∧ x.im.val * c ≤ t.max
                · simp only [if_pos hf7] at hm7; obtain ⟨bc, hbc_ok, hbc_v⟩ := hm7; rw [hbc_ok]; dsimp only
                  have hm8 := JuliaLean.Proofs.base.checked.mulExact t x.re dR
                  unfold JuliaLean.Proofs.base.checked.ExactOrOverflow at hm8; rw [hdR_d] at hm8
                  by_cases hf8 : t.min ≤ x.re.val * d ∧ x.re.val * d ≤ t.max
                  · simp only [if_pos hf8] at hm8; obtain ⟨ad, had_ok, had_v⟩ := hm8; rw [had_ok]; dsimp only
                    have hn9 := JuliaLean.Proofs.base.checked.negExact t ad
                    unfold JuliaLean.Proofs.base.checked.ExactOrOverflow at hn9
                    rw [had_v, show -(x.re.val * d) = -x.re.val * d by rw [Int.neg_mul]] at hn9
                    by_cases hf9 : t.min ≤ -x.re.val * d ∧ -x.re.val * d ≤ t.max
                    · simp only [if_pos hf9] at hn9; obtain ⟨negAD, hnegAD_ok, hnegAD_v⟩ := hn9; rw [hnegAD_ok]; dsimp only
                      have hf10 : ¬ (t.min ≤ ni ∧ ni ≤ t.max) := fun h => hnot_safe ⟨hf1, hf2, hf3, hf4, hf5, hf6, hf7, hf8, hf9, h⟩
                      have ha10 := JuliaLean.Proofs.base.checked.addExact t bc negAD
                      unfold JuliaLean.Proofs.base.checked.ExactOrOverflow at ha10
                      rw [hbc_v, hnegAD_v, show x.im.val * c + -x.re.val * d = ni by
                        dsimp [ni]; rw [Int.neg_mul, ← Int.sub_eq_add_neg], if_neg hf10] at ha10
                      cases hcall : JuliaLean.base.checked.checkedAddBits bc negAD with
                      | ok _ => rw [hcall] at ha10; contradiction
                      | error err => rw [hcall] at ha10; cases err <;> first | contradiction | exact ⟨_, rfl⟩
                    · simp only [if_neg hf9] at hn9
                      cases hcall : JuliaLean.base.checked.checkedNegBits ad with
                      | ok _ => rw [hcall] at hn9; contradiction
                      | error err => rw [hcall] at hn9; cases err <;> first | contradiction | exact ⟨_, rfl⟩
                  · simp only [if_neg hf8] at hm8
                    cases hcall : JuliaLean.base.checked.checkedMulBits x.re dR with
                    | ok _ => rw [hcall] at hm8; contradiction
                    | error err => rw [hcall] at hm8; cases err <;> first | contradiction | exact ⟨_, rfl⟩
                · simp only [if_neg hf7] at hm7
                  cases hcall : JuliaLean.base.checked.checkedMulBits x.im cR with
                  | ok _ => rw [hcall] at hm7; contradiction
                  | error err => rw [hcall] at hm7; cases err <;> first | contradiction | exact ⟨_, rfl⟩
              · simp only [if_neg hf6] at ha6
                cases hcall : JuliaLean.base.checked.checkedAddBits ac bd with
                | ok _ => rw [hcall] at ha6; contradiction
                | error err => rw [hcall] at ha6; cases err <;> first | contradiction | exact ⟨_, rfl⟩
            · simp only [if_neg hf5] at hm5
              cases hcall : JuliaLean.base.checked.checkedMulBits x.im dR with
              | ok _ => rw [hcall] at hm5; contradiction
              | error err => rw [hcall] at hm5; cases err <;> first | contradiction | exact ⟨_, rfl⟩
          · simp only [if_neg hf4] at hm4
            cases hcall : JuliaLean.base.checked.checkedMulBits x.re cR with
            | ok _ => rw [hcall] at hm4; contradiction
            | error err => rw [hcall] at hm4; cases err <;> first | contradiction | exact ⟨_, rfl⟩
        · simp only [if_neg hf3] at ha3
          cases hcall : JuliaLean.base.checked.checkedAddBits c2 d2 with
          | ok _ => rw [hcall] at ha3; contradiction
          | error err => rw [hcall] at ha3; cases err <;> first | contradiction | exact ⟨_, rfl⟩
      · simp only [if_neg hf2] at hm2
        cases hcall : JuliaLean.base.checked.checkedMulBits y.im dR with
        | ok _ => rw [hcall] at hm2; contradiction
        | error err => rw [hcall] at hm2; cases err <;> first | contradiction | exact ⟨_, rfl⟩
    · simp only [if_neg hf1] at hm1
      cases hcall : JuliaLean.base.checked.checkedMulBits y.re cR with
