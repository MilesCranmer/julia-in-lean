theorem rationalIntCmpMinusOne (a b : Int) : intCmp a b = -1 ↔ a < b := by
  by_cases hl : a < b <;> by_cases hg : b < a <;>
    simp [intCmp, hl, hg] <;> omega

theorem rationalIntCmpZero (a b : Int) : intCmp a b = 0 ↔ a = b := by
  by_cases hl : a < b <;> by_cases hg : b < a <;>
    simp [intCmp, hl, hg] <;> omega

theorem rationalIntCmpOne (a b : Int) : intCmp a b = 1 ↔ b < a := by
  by_cases hl : a < b <;> by_cases hg : b < a <;>
    simp [intCmp, hl, hg] <;> omega

theorem rationalIntCmpLtZero (a b : Int) : intCmp a b < 0 ↔ a < b := by
  by_cases hl : a < b <;> by_cases hg : b < a <;>
    simp [intCmp, hl, hg] <;> omega

theorem rationalIntCmpLeZero (a b : Int) : intCmp a b ≤ 0 ↔ a ≤ b := by
  by_cases hl : a < b <;> by_cases hg : b < a <;>
    simp [intCmp, hl, hg] <;> omega

theorem rationalIntCmpSwap (a b : Int) : intCmp b a = -intCmp a b := by
  by_cases hl : a < b <;> by_cases hg : b < a <;>
    simp [intCmp, hl, hg] <;> omega

/-- A single comparison identity supplies every ordered relation used by rational comparisons. -/
theorem rationalIntCmpTransport (a b c d : Int) (h : intCmp a b = intCmp c d) :
    (a < b ↔ c < d) ∧ (a ≤ b ↔ c ≤ d) ∧ (a = b ↔ c = d) ∧
      (b < a ↔ d < c) ∧ (b ≤ a ↔ d ≤ c) := by
  have hl : a < b ↔ c < d := by
    rw [← rationalIntCmpLtZero a b, h, rationalIntCmpLtZero c d]
  have he : a = b ↔ c = d := by
    rw [← rationalIntCmpZero a b, h, rationalIntCmpZero c d]
  have hg : b < a ↔ d < c := by
    rw [← rationalIntCmpOne a b, h, rationalIntCmpOne c d]
  exact ⟨hl, by omega, he, hg, by omega⟩

theorem rationalIntCmpTransportBool (a b c d : Int) (h : intCmp a b = intCmp c d) :
    decide (a < b) = decide (c < d) ∧ decide (a ≤ b) = decide (c ≤ d) ∧
    decide (a = b) = decide (c = d) ∧ decide (b < a) = decide (d < c) ∧
    decide (b ≤ a) = decide (d ≤ c) := by
  obtain ⟨hl, hle, he, hg, hge⟩ := rationalIntCmpTransport a b c d h
  simp only [hl, hle, he, hg, hge, and_self]

theorem rationalIntCmpTransportReverse (a b c d : Int) (h : intCmp a b = intCmp c d) :
    intCmp b a = intCmp d c := by
  rw [rationalIntCmpSwap a b, h, rationalIntCmpSwap c d]

/-- Multiplication by one positive common factor preserves the three-way comparison. -/
theorem rationalIntCmpScaleRight (a b scale : Int) (hs : 0 < scale) :
    intCmp (a * scale) (b * scale) = intCmp a b := by
  by_cases hl : a < b
  · have hm := Int.mul_lt_mul_of_pos_right hl hs
    simp only [intCmp, hl, hm, ite_true]
  · by_cases hg : b < a
    · have hm := Int.mul_lt_mul_of_pos_right hg hs
