        · show (0 : Int) ≤ (JInt.lit t 1).val
          rw [hone]; decide
        · show Nat.gcd n.val.natAbs (JInt.lit t 1).val.natAbs = 1
          rw [hone]; simp
        · show n.val * 1 = n.val * (JInt.lit t 1).val
          rw [hone]
        · intro _
          show (JInt.lit t 1).val > 0
          rw [hone]; decide
        · intro h; exact absurd h (by decide)

