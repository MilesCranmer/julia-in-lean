remaining nonzero-divisor cases. -/
def RoundedRatIntegerOutcome {t s : IntTy} (x : Rat t) (y : JInt s)
    (r : Rounding)
    (run : Jl (JInt (JuliaLean.base.div.divMixedResultTy t (t.promote s)))) : Prop :=
