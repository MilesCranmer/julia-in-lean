  (gn ≠ 0 → gd ≠ 0 →
    (¬ numeratorConverts → RoundedInexact run) ∧
    (numeratorConverts →
      (¬ numeratorFits → RoundedOverflow run) ∧
      (numeratorFits →
        (¬ denominatorConverts → RoundedInexact run) ∧
        (denominatorConverts →
          (¬ denominatorFits → RoundedOverflow run) ∧
          (denominatorFits →
            RoundedOutcome run (x.num.val * y.den.val) (x.den.val * y.num.val) r ∧
            RoundedNativeFinalOutcome p p run (xn * yd) (xd * yn) r)))))

