  let g : Int := Int.ofNat (Nat.gcd n.natAbs d.natAbs)
  0 < d ∧ g ≠ 0 ∧ RoundedFits t (n.tdiv g) ∧ RoundedFits t (d.tdiv g)

/-- Exact finite complex value, with positive result denominators preventing
vacuous cross-product comparisons with rational infinity. -/
def ComplexPowerFiniteValue {t : IntTy}
    (out : JuliaLean.base.complex.Complex (Rat t)) (nr ni d : Int) : Prop :=
  Normalized out.re ∧ Normalized out.im ∧
    0 < out.re.den.val ∧ 0 < out.im.den.val ∧
    out.re.num.val * d = nr * out.re.den.val ∧
    out.im.num.val * d = ni * out.im.den.val

