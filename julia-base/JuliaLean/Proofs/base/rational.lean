theorem promoteR_spec {T U P : Type} (i : IntegerParameters T) (j : IntegerParameters U)
    (p : IntegerParameters P) (m : PromotionParameters i j p)
    (x : Rational T) (y : Rational U) :
    (Converts i j p x y → ∃ xp yp, promoteR m x y = .ok (xp, yp) ∧
      rn p xp = rn i x ∧ rd p xp = rd i x ∧ rn p yp = rn j y ∧ rd p yp = rd j y) ∧
    (¬ Converts i j p x y → IsInexact (promoteR m x y)) := by
  cases i with | bits t =>
  cases j with | bits s =>
  cases p with | bits pt =>
  unfold promoteR convertRat convertRatSource unsafeRationalTypeSource Converts
  dsimp only [rn, rd, val, IntegerParameters.fits, IntegerParameters.ops, jintOps,
    Bind.bind, Except.bind, Pure.pure, Except.pure]
  refine ⟨fun ⟨h1, h2, h3, h4⟩ => ?_, fun hnot => ?_⟩
  · rw [convert_of_fits h1, convert_of_fits h2, convert_of_fits h3, convert_of_fits h4]
    exact ⟨⟨⟨x.num.val, h1⟩, ⟨x.den.val, h2⟩⟩, ⟨⟨y.num.val, h3⟩, ⟨y.den.val, h4⟩⟩,
      rfl, rfl, rfl, rfl, rfl⟩
  · by_cases h1 : pt.min ≤ x.num.val ∧ x.num.val ≤ pt.max
    · by_cases h2 : pt.min ≤ x.den.val ∧ x.den.val ≤ pt.max
      · by_cases h3 : pt.min ≤ y.num.val ∧ y.num.val ≤ pt.max
        · have h4 : ¬ (pt.min ≤ y.den.val ∧ y.den.val ≤ pt.max) :=
            fun h4 => hnot ⟨h1, h2, h3, h4⟩
          rw [convert_of_fits h1, convert_of_fits h2, convert_of_fits h3, convert_of_not_fits h4]
          exact ⟨pt.name, rfl⟩
        · rw [convert_of_fits h1, convert_of_fits h2, convert_of_not_fits h3]
          exact ⟨pt.name, rfl⟩
      · rw [convert_of_fits h1, convert_of_not_fits h2]
        exact ⟨pt.name, rfl⟩
    · rw [convert_of_not_fits h1]
      exact ⟨pt.name, rfl⟩

theorem prom_promote_spec {T U P : Type} {i : IntegerParameters T} {j : IntegerParameters U}
    {p : IntegerParameters P} (m : PromotionParameters i j p) (a : T) (b : U) :
    (FitsPair p (val i a) (val j b) →
      ∃ pa pb, m.prom.promote a b = .ok (pa, pb) ∧ val p pa = val i a ∧ val p pb = val j b) ∧
    (¬ FitsPair p (val i a) (val j b) → IsInexact (m.prom.promote a b)) := by
  cases m with
  | same i =>
    cases i with | bits t =>
    have hp_eq : (PromotionParameters.same (.bits t)).prom.promote a b = .ok (a, b) := rfl
    rw [hp_eq]
    refine ⟨fun _ => ⟨a, b, rfl, rfl, rfl⟩, fun hnot => absurd ⟨a.property, b.property⟩ hnot⟩
  | bits t s =>
    let pt := t.promote s
    have hp_eq : (PromotionParameters.bits t s).prom.promote a b = (do
      let xp ← JInt.convert (pt.name) pt a.val
      let yp ← JInt.convert (pt.name) pt b.val
      pure (xp, yp)) := rfl
    rw [hp_eq]
    unfold FitsPair
    dsimp only [val, IntegerParameters.fits, IntegerParameters.ops, jintOps,
      Bind.bind, Except.bind, Pure.pure, Except.pure]
    refine ⟨fun ⟨hfa, hfb⟩ => ?_, fun hnot => ?_⟩
    · rw [convert_of_fits hfa, convert_of_fits hfb]
      exact ⟨⟨a.val, hfa⟩, ⟨b.val, hfb⟩, rfl, rfl, rfl⟩
    · by_cases hfa : pt.min ≤ a.val ∧ a.val ≤ pt.max
      · have hfb : ¬ (pt.min ≤ b.val ∧ b.val ≤ pt.max) := fun hfb => hnot ⟨hfa, hfb⟩
        rw [convert_of_fits hfa, convert_of_not_fits hfb]
        exact ⟨pt.name, rfl⟩
      · rw [convert_of_not_fits hfa]
        exact ⟨pt.name, rfl⟩

theorem prom_mulWrapXP_val {T U P : Type} {i : IntegerParameters T} {j : IntegerParameters U}
    {p : IntegerParameters P} (m : PromotionParameters i j p) (a : T) (v : P)
    (ha : p.fits (val i a)) :
    val p (m.prom.mulWrapXP a v) = p.wrap (val i a * val p v) := by
  cases m with
  | same i =>
    cases i with | bits t => rfl
  | bits t s =>
    let pt := t.promote s
    have hw : (JInt.wrap pt a.val).val = a.val := wrapInt_of_inRange pt a.val ha
    change wrapInt pt ((JInt.wrap pt a.val).val * v.val) = wrapInt pt (a.val * v.val)
    rw [hw]

theorem prom_mulWrapYP_val {T U P : Type} {i : IntegerParameters T} {j : IntegerParameters U}
    {p : IntegerParameters P} (m : PromotionParameters i j p) (b : U) (v : P)
    (hb : p.fits (val j b)) :
    val p (m.prom.mulWrapYP b v) = p.wrap (val j b * val p v) := by
  cases m with
  | same i =>
    cases i with | bits t => rfl
  | bits t s =>
    let pt := t.promote s
    have hw : (JInt.wrap pt b.val).val = b.val := wrapInt_of_inRange pt b.val hb
    change wrapInt pt ((JInt.wrap pt b.val).val * v.val) = wrapInt pt (b.val * v.val)
    rw [hw]

private theorem opsP_addWrap_val {T U P : Type} {i : IntegerParameters T} {j : IntegerParameters U}
    {p : IntegerParameters P} (m : PromotionParameters i j p) (u v : P) :
    val p (m.prom.opsP.addWrap u v) = p.wrap (val p u + val p v) := by
  cases m with
  | same i => cases i with | bits t => rfl
  | bits t s => rfl

private theorem opsP_subWrap_val {T U P : Type} {i : IntegerParameters T} {j : IntegerParameters U}
    {p : IntegerParameters P} (m : PromotionParameters i j p) (u v : P) :
    val p (m.prom.opsP.subWrap u v) = p.wrap (val p u - val p v) := by
  cases m with
  | same i => cases i with | bits t => rfl
  | bits t s => rfl

private theorem neg_spec {T : Type} (i : IntegerParameters T) (y : Rational T) :
    (i.fits (-rn i y) → ∃ z, neg i y = .ok z ∧ rn i z = -rn i y ∧ rd i z = rd i y) ∧
    (¬ i.fits (-rn i y) → IsOverflow (neg i y)) := by
  cases i with | bits s =>
  unfold neg
  dsimp only [rn, rd, val, IntegerParameters.fits, IntegerParameters.ops, jintOps]
  by_cases hs : s.signed = true
  · simp only [hs, ↓reduceDIte, negBitSignedSource]
    have hmin_val : (JInt.typemin s).val = s.min := by cases s <;> decide
    have hmin_eq := max_lt_neg_min_of_signed hs
    have hy_prop := y.num.property
    refine ⟨fun hf => ?_, fun hnf => ?_⟩
    · have hne : (y.num == JInt.typemin s) = false := by
        rw [beq_eq_false_iff_ne]; intro h; have : y.num.val = s.min := by rw [h, hmin_val]
        omega
      simp only [hne, Bool.false_eq_true, ↓reduceIte, Pure.pure, Except.pure, unsafeRationalSameSource_pair]
      exact ⟨⟨-y.num, y.den⟩, rfl, wrapInt_of_inRange s (-y.num.val) hf, rfl⟩
    · have hxmin : y.num.val = s.min := by omega
      have heq : (y.num == JInt.typemin s) = true := by
        rw [beq_iff_eq]; exact Subtype.ext (hxmin.trans hmin_val.symm)
      simp only [heq, ↓reduceIte, throwNumeratorTypeminSource]; exact ⟨_, rfl⟩
  · simp only [hs, negUnsignedSource, eq_eq y.num (JInt.lit s 0)]
    have hu : s.signed = false := Bool.eq_false_iff.mpr hs
    have hmin0 := min_eq_zero_of_unsigned hu
    have hmax0 := zero_le_max s
    have hy0 := nonneg_of_unsigned hu y.num
    have h0_val : (JInt.lit s 0).val = 0 := by cases s <;> decide
    refine ⟨fun hf => ?_, fun hnf => ?_⟩
    · have hyn0 : y.num.val = 0 := by omega
      simp only [h0_val, hyn0, decide_true, Bool.not_true, Bool.false_eq_true, ↓reduceIte, Pure.pure, Except.pure]
      exact ⟨y, rfl, by omega, rfl⟩
    · have hyn_nz : y.num.val ≠ 0 := by omega
      simp only [h0_val, decide_eq_false hyn_nz, Bool.not_false, ↓reduceIte]
      exact ⟨"cannot negate unsigned number", rfl⟩

theorem wrapping_aux {T U P : Type} (i : IntegerParameters T) (j : IntegerParameters U)
    (p : IntegerParameters P) (m : PromotionParameters i j p) (x : Rational T) (y : Rational U)
    (hx : Canonical i x) (hy : Canonical j y) :
    let cv := Converts i j p x y
    let g : Int := Nat.gcd (rd i x).natAbs (rd j y).natAbs
    let a := p.wrap (rn i x * (rd j y).tdiv g)
    let b := p.wrap (rn j y * (rd i x).tdiv g)
    let d := p.wrap (rd i x * (rd j y).tdiv g)
    (¬ cv → IsInexact (wrapAdd m x y) ∧ IsInexact (wrapSub m x y)) ∧
    (cv → g ≠ 0 → ConstructorContract p (wrapAdd m x y) (p.wrap (a+b)) d) ∧
    (cv → g ≠ 0 → (rd i x = 0 → j.fits (-rn j y)) →
      ConstructorContract p (wrapSub m x y) (p.wrap (a-b)) d) ∧
    (cv → g = 0 →
      (rn i x = rn j y → ExactResult p (wrapAdd m x y) (rn i x) 0) ∧
      (rn i x ≠ rn j y → wrapAdd m x y = .error .divideError)) ∧
    (cv → rd i x = 0 → ¬ j.fits (-rn j y) → IsOverflow (wrapSub m x y)) ∧
    (cv → g = 0 → j.fits (-rn j y) →
      (rn i x = -rn j y → ExactResult p (wrapSub m x y) (rn i x) 0) ∧
      (rn i x ≠ -rn j y → wrapSub m x y = .error .divideError)) ∧
    rn i (negWrapRatSource i.ops.negWrap x) = i.wrap (-rn i x) ∧
    rd i (negWrapRatSource i.ops.negWrap x) = rd i x ∧
    (i.fits (-rn i x) → Represents i (negWrapRatSource i.ops.negWrap x) (-rn i x) (rd i x)) := by
  intro cv g a b d
  have hpr := promoteR_spec i j p m x y
  refine ⟨fun hnot_cv => ?_,
    fun hcv hg_nz => ?_,
    fun hcv hg_nz hny_fit => ?_,
    fun hcv hg0 => ?_,
    fun hcv hdx0 hnot_ny => ?_,
    fun hcv hg0 hf_ny => ?_,
    ?_, ?_, ?_⟩
  · obtain ⟨msg, herr⟩ := hpr.2 hnot_cv
    unfold wrapAdd wrapSub addWrapRatSource subWrapRatSource
    simp [herr, Bind.bind, Except.bind, IsInexact]
  · obtain ⟨xp, yp, hpr_ok, _, _, _, _⟩ := hpr.1 hcv
    obtain ⟨xdp, ydp, hp_ok, hxdp_v, hydp_v⟩ :=
      (prom_promote_spec m x.den y.den).1 ⟨hcv.2.1, hcv.2.2.2⟩
    unfold wrapAdd addWrapRatSource
    cases i with | bits t =>
    cases j with | bits s =>
    cases p with | bits pt =>
    have hcond_f : ((IntegerParameters.ops (.bits t)).iszero x.den &&
        eqR (.bits t) (.bits s) x y) = false := by
      unfold IntegerParameters.ops jintOps eqR eqRatSource bwand integerEq
      dsimp only
      rw [eq_eq x.den y.den, eq_eq x.num y.num]
      by_cases hdx0 : x.den.val = 0
      · have hdy_nz : y.den.val ≠ 0 := fun hdy0 => hg_nz (by
          dsimp [g, rd, val, IntegerParameters.ops, jintOps]; rw [hdx0, hdy0]; rfl)
        simp [hdx0, show (0 : Int) ≠ y.den.val by omega]
      · simp [hdx0]
    rw [hpr_ok]; dsimp only [Bind.bind, Except.bind]
    rw [hcond_f, if_neg Bool.false_ne_true, hp_ok]; dsimp only [Bind.bind, Except.bind]
    change xdp.val = rd (.bits t) x at hxdp_v
