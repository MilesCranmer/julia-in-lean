  have hgnpos : 0 < gn :=
    Int.lt_iff_le_and_ne.mpr ⟨Int.natCast_nonneg _, Ne.symm hgn⟩
  have hgdpos : 0 < gd :=
    Int.lt_iff_le_and_ne.mpr ⟨Int.natCast_nonneg _, Ne.symm hgd⟩
  have hxn : xn * gn = x.num.val :=
    DivGcdCtorLemmas.tdiv_mul_cancel_of_dvd x.num.val _
      (Nat.gcd_dvd_left x.num.val.natAbs y.num.val.natAbs)
  have hyn : yn * gn = y.num.val :=
    DivGcdCtorLemmas.tdiv_mul_cancel_of_dvd y.num.val _
      (Nat.gcd_dvd_right x.num.val.natAbs y.num.val.natAbs)
  have hxd : xd * gd = x.den.val :=
    DivGcdCtorLemmas.tdiv_mul_cancel_of_dvd x.den.val _
      (Nat.gcd_dvd_left x.den.val.natAbs y.den.val.natAbs)
  have hyd : yd * gd = y.den.val :=
    DivGcdCtorLemmas.tdiv_mul_cancel_of_dvd y.den.val _
      (Nat.gcd_dvd_right x.den.val.natAbs y.den.val.natAbs)
  have hnum : (xn*yd) * (gn*gd) = x.num.val*y.den.val := by
    calc
      (xn*yd) * (gn*gd) = (xn*gn) * (yd*gd) := by
        simp only [Int.mul_assoc, Int.mul_left_comm, Int.mul_comm]
      _ = x.num.val*y.den.val := by rw [hxn, hyd]
  have hden : (xd*yn) * (gn*gd) = x.den.val*y.num.val := by
    calc
      (xd*yn) * (gn*gd) = (xd*gd) * (yn*gn) := by
        simp only [Int.mul_assoc, Int.mul_left_comm, Int.mul_comm]
      _ = x.den.val*y.num.val := by rw [hxd, hyn]
