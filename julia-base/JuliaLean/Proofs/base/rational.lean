/- Source120 is an internal helper and receives no invented public contract.
The following statements concern public source137. Every arithmetic expression
below uses unbounded mathematics solely to describe values and machine-range
obligations; none implements a callee or assumes a successful model execution. -/

/-- Mathematical representability in a native component type. -/
def ComplexRationalFits (t : IntTy) (z : Int) : Prop := t.min ≤ z ∧ z ≤ t.max

/-- Canonical mathematical coordinates when the denominator is nonnegative.
Zero/zero remains zero/zero; the stage criterion below excludes each source
division by zero independently. This is specification arithmetic only. -/
def ComplexRationalReduced (n d : Int) : Int × Int :=
  let g : Int := Int.ofNat (Nat.gcd n.natAbs d.natAbs)
  (n.tdiv g, d.tdiv g)

/-- The mathematical squared magnitude, expressed using ordinary fraction
cross products. Any infinite component has positive infinite magnitude. -/
def ComplexRationalMagnitude (c d : Int × Int) : Int × Int :=
  if c.2 = 0 ∨ d.2 = 0 then (1, 0)
  else ComplexRationalReduced
    (c.1 ^ 2 * d.2 ^ 2 + d.1 ^ 2 * c.2 ^ 2) (c.2 ^ 2 * d.2 ^ 2)

/-- The independent range obligations of the checked squared-magnitude
calculation on normalized input components. The direct infinity-plus-infinity
case does not require the denominator-gcd arithmetic. Source:
base/complex.jl:282; base/rational.jl:415-422,482-486. -/
def ComplexRationalMagnitudeFits (s : IntTy) (c d : Int × Int) : Prop :=
  let cn := c.1 ^ 2
  let cd := c.2 ^ 2
  let dn := d.1 ^ 2
  let dd := d.2 ^ 2
  let g : Int := Int.ofNat (Nat.gcd cd.natAbs dd.natAbs)
  let a := cn * dd.tdiv g
  let b := dn * cd.tdiv g
  ComplexRationalFits s cn ∧ ComplexRationalFits s cd ∧
    ComplexRationalFits s dn ∧ ComplexRationalFits s dd ∧
    ((c.2 = 0 ∧ d.2 = 0) ∨
      (g ≠ 0 ∧ ComplexRationalFits s a ∧ ComplexRationalFits s b ∧
        ComplexRationalFits s (a + b) ∧ ComplexRationalFits s (cd * dd.tdiv g)))

/-- Original operands must be representable before the two nonzero
cross-cancellation gcds and checked products. This includes zero/infinity
indeterminacy as a failure condition. Source: base/rational.jl:482-486. -/
def ComplexRationalProductFits (p : IntTy) (a b : Int × Int) : Prop :=
  let g : Int := Int.ofNat (Nat.gcd a.1.natAbs b.2.natAbs)
  let h : Int := Int.ofNat (Nat.gcd a.2.natAbs b.1.natAbs)
  ComplexRationalFits p a.1 ∧ ComplexRationalFits p b.2 ∧ g ≠ 0 ∧
    ComplexRationalFits p a.2 ∧ ComplexRationalFits p b.1 ∧ h ≠ 0 ∧
    ComplexRationalFits p (a.1.tdiv g * b.1.tdiv h) ∧
    ComplexRationalFits p (a.2.tdiv h * b.2.tdiv g)

/-- Range and nonzero-gcd conditions for exact division by a nonnegative
normalized magnitude. Its nonnegative numerator and denominator make the
checked-denominator sign-normalization branch inactive. Source:
base/rational.jl:106-114. -/
def ComplexRationalMagnitudeDivisionFits (p : IntTy) (a b : Int × Int) : Prop :=
  let g : Int := Int.ofNat (Nat.gcd a.1.natAbs b.1.natAbs)
  let h : Int := Int.ofNat (Nat.gcd a.2.natAbs b.2.natAbs)
  0 ≤ b.1 ∧ 0 ≤ b.2 ∧
    ComplexRationalFits p a.1 ∧ ComplexRationalFits p b.1 ∧ g ≠ 0 ∧
    ComplexRationalFits p a.2 ∧ ComplexRationalFits p b.2 ∧ h ≠ 0 ∧
    ComplexRationalFits p (a.1.tdiv g * b.2.tdiv h) ∧
    ComplexRationalFits p (a.2.tdiv h * b.1.tdiv g)

/-- All checked stages of source137, described independently as mathematical
range and definedness obligations. These are conclusion-side conditions, never
input hypotheses. Mathematical multiplication and squared magnitude supply
the intermediate exact values; no model result appears in this definition. -/
def ComplexRationalDivisionStagesFit {t s : IntTy} (x : Rat t)
    (y : JuliaLean.base.complex.Complex (Rat s)) : Prop :=
  let a := (x.num.val, x.den.val)
  let c := (y.re.num.val, y.re.den.val)
  let d := (y.im.num.val, y.im.den.val)
  let infinite := c.2 = 0 ∨ d.2 = 0
  let cr := if infinite then (0, 1) else c
  let ci := if infinite then (0, 1) else (-d.1, d.2)
  let mag := ComplexRationalMagnitude c d
  let pr := ComplexRationalReduced (a.1 * cr.1) (a.2 * cr.2)
  let pi := ComplexRationalReduced (a.1 * ci.1) (a.2 * ci.2)
  let p := t.promote s
  let r := p.promote s
  (infinite ∨ ComplexRationalFits s (-d.1)) ∧
    ComplexRationalMagnitudeFits s c d ∧
    ComplexRationalProductFits p a cr ∧ ComplexRationalProductFits p a ci ∧
    ComplexRationalMagnitudeDivisionFits r pr mag ∧
    ComplexRationalMagnitudeDivisionFits r pi mag

/-- The ordinary complex quotient identity, using original unbounded fraction
coordinates. Division of a finite real rational by an infinite complex value
is zero in both components. Otherwise the finite complex divisor is nonzero,
and the two components have the exact algebraic ratios, permitting signed
infinite results for an infinite real numerator. Source: base/rational.jl:64-91,
137-140; doc/src/manual/complex-and-rational-numbers.md:184-305. -/
def ComplexRationalQuotientValue {t s r : IntTy} (x : Rat t)
    (y : JuliaLean.base.complex.Complex (Rat s))
    (q : JuliaLean.base.complex.Complex (Rat r)) : Prop :=
  Normalized q.re ∧ Normalized q.im ∧
    if y.re.den.val = 0 ∨ y.im.den.val = 0 then
      x.den.val ≠ 0 ∧ q.re.num.val = 0 ∧ q.re.den.val = 1 ∧
        q.im.num.val = 0 ∧ q.im.den.val = 1
