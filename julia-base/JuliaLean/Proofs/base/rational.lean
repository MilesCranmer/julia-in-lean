def sub {F : Type} : FloatParameters F → F → F → F | .ieee _ _,x,y => JuliaLean.base.float.sub_IEEEFloat x y
def add {F : Type} : FloatParameters F → F → F → F | .ieee _ _,x,y => JuliaLean.base.float.add_IEEEFloat x y
def mul {F : Type} : FloatParameters F → F → F → F | .ieee _ _,x,y => JuliaLean.base.float.mul_IEEEFloat x y
def div {F : Type} : FloatParameters F → F → F → F | .ieee _ _,x,y => JuliaLean.base.float.div_IEEEFloat x y
def truncDiv {F : Type} : FloatParameters F → F → F → F
  | .ieee _ _,x,y => JuliaLean.base.div.div_AbstractFloat JuliaLean.base.float.div_IEEEFloat
      (fun a b _ => JuliaLean.base.float.rem_IEEEFloat a b) JuliaLean.base.float.sub_IEEEFloat
      JuliaLean.base.float.round_Nearest_llvm x y .ToZero
def cld {F : Type} : FloatParameters F → F → F → F
  | .ieee _ _,x,y => JuliaLean.base.div.div_AbstractFloat JuliaLean.base.float.div_IEEEFloat
      (fun a b _ => JuliaLean.base.float.mod_AbstractFloat a (JuliaLean.base.float.neg_IEEEFloat b))
      JuliaLean.base.float.sub_IEEEFloat JuliaLean.base.float.round_Nearest_llvm x y .Up
def divrem {F : Type} : FloatParameters F → F → F → F × F
  | .ieee ft o,x,y => (truncDiv (.ieee ft o) x y, JuliaLean.base.float.rem_IEEEFloat x y)
def gt {F : Type} : FloatParameters F → F → F → Bool | .ieee _ _,x,y => JuliaLean.base.float.lt_IEEEFloat y x
def eq {F : Type} : FloatParameters F → F → F → Bool | .ieee _ _,x,y => JuliaLean.base.float.eq_IEEEFloat x y
def ofInt {F : Type} : FloatParameters F → Int → F | .ieee ft _,n => JuliaLean.base.float.floatOfInt ft (JInt.wrap .i64 n)
def decompose {F : Type} : FloatParameters F → F → Int × Int × Int
  | .ieee _ _,x => let (n,e,d) := JuliaLean.base.float.decompose x; (n.val,e.val,d.val)
def ldexp {F : Type} : FloatParameters F → F → Int → F
  | .ieee .f16 o,x,e => JuliaLean.base.math.ldexp16
      {o.1 with flipsign := JuliaLean.base.floatfuncs.flipsign_Float32} x e
  | .ieee .f32 o,x,e => JuliaLean.base.math.ldexp
      {o.1 with flipsign := JuliaLean.base.floatfuncs.flipsign_Float32} x e
  | .ieee .f64 o,x,e => JuliaLean.base.math.ldexp
      {o.2 with flipsign := JuliaLean.base.floatfuncs.flipsign_Float64} x e
def roundFormat {F : Type} : FloatParameters F → Int → Nat → F
  | .ieee _ _,n,d => Fl.roundRat n d false
end FloatParameters
def FloatParameters.signbit {F : Type} : FloatParameters F → F → Bool
  | .ieee _ _,x => JuliaLean.base.float.signbit_float x
def small_float_conversion : Prop :=
  ∀ (t : IntTy) (q : Rat t)
    (hn : Normalized q) (hd : q.den.val > 0),
    (∀ h : isSmallFloat16RatComponent t = true,
      float16OfRationalSmallSource h q =
        Fl.roundRat (f := JuliaLean.base.float.FTy.f16.fmt) q.num.val q.den.val.toNat false) ∧
    (∀ h : is128RatComponent t = true,
      float16OfRational128Source h q =
        Fl.roundRat (f := JuliaLean.base.float.FTy.f16.fmt) q.num.val q.den.val.toNat false ∧
      float32OfRational128Source h q =
        Fl.roundRat (f := JuliaLean.base.float.FTy.f32.fmt) q.num.val q.den.val.toNat false)
def rationalize_integer : Prop :=
  ∀ {T U : Type} (i : IntegerParameters T) (j : IntegerParameters U)
    (x : U)
    (hmin : i.ops.hasTypeMax = true → val i i.ops.typemin ≤ val i i.ops.typemax)
    (hminus : i.ops.isUnsignedOrBool = false → val i i.ops.minusOne = -1),
    let run := rationalizeIntegerTypedSource T i.ops (fun n => decide (val j n < 0))
      (fun n => decide (val j n < val i i.ops.typemin))
      (fun n => decide (val i i.ops.typemax < val j n))
      (fun n => i.ops.fromInt (val j n)) (fun _ => j.ops.one) x ()
    (i.ops.isUnsignedOrBool = true → val j x < 0 → IsOverflow run) ∧
    (i.ops.isUnsignedOrBool = false → i.ops.hasTypeMax = true →
      val j x < val i i.ops.typemin → ∃ q, run = .ok q ∧ rn i q = -1 ∧ rd i q = 0) ∧
    (i.ops.hasTypeMax = true → val i i.ops.typemax < val j x →
      ∃ q, run = .ok q ∧ rn i q = 1 ∧ rd i q = 0) ∧
    (i.fits (val j x) → (i.ops.hasTypeMax = false ∨
      val i i.ops.typemin ≤ val j x ∧ val j x ≤ val i i.ops.typemax) →
      ∃ q, run = .ok q ∧ Represents i q (val j x) 1)
open JuliaLean.Proofs.base.int
open JuliaLean.Proofs.base.rational.CoreLemmas
open JuliaLean.Proofs.base.rational.DivGcdCtorLemmas
open JuliaLean.Proofs.base.rational.ComparisonAndRoundingLemmas

/-- 1. Registry id: `rational-divgcd-coprime`. -/
theorem divgcd_spec_aux {T U : Type} (i : IntegerParameters T) (j : IntegerParameters U)
    (x : T) (y : U) (h : val i x ≠ 0 ∨ val j y ≠ 0) :
    ∃ a b, dg i j x y = .ok (a,b) ∧
      Nat.gcd (val i a).natAbs (val j b).natAbs = 1 ∧
      val i a * val j y = val i x * val j b ∧
      intSign (val i a) = intSign (val i x) ∧ intSign (val j b) = intSign (val j y) := by
  cases i with | bits t =>
  cases j with | bits s =>
  have hgnz : (Nat.gcd x.val.natAbs y.val.natAbs : Int) ≠ 0 := by
    intro hg0
    have hgNat0 : Nat.gcd x.val.natAbs y.val.natAbs = 0 := by omega
    have ⟨hx0, hy0⟩ := Nat.gcd_eq_zero_iff.mp hgNat0
    rcases h with hx | hy
    · exact hx (Int.natAbs_eq_zero.mp hx0)
    · exact hy (Int.natAbs_eq_zero.mp hy0)
  obtain ⟨a, b, hok, _, _, _, _, hcop, _, _, hcross, hsx, hsy⟩ := (dgBits_spec x y).2 hgnz
  exact ⟨a, b, hok, hcop, hcross, hsx, hsy⟩


/-- 3. Registry id: `rational-checked-den-positive`. -/
theorem checked_den_spec_aux {T : Type} (i : IntegerParameters T) (n d : T) :
    (0 ≤ val i d → ∃ q, checkedDenTypeSource T i.ops n d = .ok q ∧
      rn i q = val i n ∧ rd i q = val i d) ∧
    (val i d < 0 → i.fits (-val i d) → i.fits (-val i n) →
      ∃ q, checkedDenTypeSource T i.ops n d = .ok q ∧
        rd i q > 0 ∧ rn i q = -val i n ∧ rd i q = -val i d) ∧
    (val i d < 0 → (¬ i.fits (-val i d) ∨ ¬ i.fits (-val i n)) →
      IsOverflow (checkedDenTypeSource T i.ops n d)) := by
  cases i with | bits t =>
  have hspec := checkedDenBits_spec (jintOps t) rfl rfl n d
  refine ⟨fun hd0 => ⟨⟨n, d⟩, hspec.1 hd0, rfl, rfl⟩,
    fun hdn hfd hfn => hspec.2.1 hdn hfd hfn,
    fun hdn hnot => hspec.2.2 hdn hnot⟩

/-- 4a. Registry id: `rational-integer-rationalize-range` (`integer_construction`). -/
theorem integer_construction_aux {T U : Type} (i : IntegerParameters T) (j : IntegerParameters U)
    (n : U) (h : i.fits (val j n)) :
    ∃ q, intRat i j n = .ok q ∧ Represents i q (val j n) 1 := by
  cases i with | bits t =>
  cases j with | bits s =>
  change t.min ≤ n.val ∧ n.val ≤ t.max at h
  have hone_val : (JInt.lit s 1).val = 1 := by cases s <;> decide
  have hone_fit : t.min ≤ 1 ∧ 1 ≤ t.max := ⟨Int.le_trans (min_le_zero t) (by decide), one_le_max t⟩
  unfold intRat rationalIntAsSource
  simp only [IntegerParameters.ops, jintOps, val, hone_val, convert_of_fits h, convert_of_fits hone_fit,
    Bind.bind, Except.bind, Pure.pure, Except.pure]
  refine ⟨⟨⟨n.val, h⟩, ⟨1, hone_fit⟩⟩, rfl, ?_⟩
  unfold Represents Canonical
  dsimp only [rn, rd, val, IntegerParameters.ops, jintOps]
  exact ⟨⟨by decide, Nat.gcd_one_right _⟩, by omega, fun _ => by decide, fun h0 => absurd h0 (by decide)⟩

/-- 4b. Registry id: `rational-integer-rationalize-range` (`rationalize_integer`). -/
theorem rationalize_integer_aux {T U : Type} (i : IntegerParameters T) (j : IntegerParameters U)
    (x : U)
    (hmin : i.ops.hasTypeMax = true → val i i.ops.typemin ≤ val i i.ops.typemax)
    (hminus : i.ops.isUnsignedOrBool = false → val i i.ops.minusOne = -1) :
    let run := rationalizeIntegerTypedSource T i.ops (fun n => decide (val j n < 0))
      (fun n => decide (val j n < val i i.ops.typemin))
      (fun n => decide (val i i.ops.typemax < val j n))
      (fun n => i.ops.fromInt (val j n)) (fun _ => j.ops.one) x ()
    (i.ops.isUnsignedOrBool = true → val j x < 0 → IsOverflow run) ∧
    (i.ops.isUnsignedOrBool = false → i.ops.hasTypeMax = true →
      val j x < val i i.ops.typemin → ∃ q, run = .ok q ∧ rn i q = -1 ∧ rd i q = 0) ∧
    (i.ops.hasTypeMax = true → val i i.ops.typemax < val j x →
      ∃ q, run = .ok q ∧ rn i q = 1 ∧ rd i q = 0) ∧
    (i.fits (val j x) → (i.ops.hasTypeMax = false ∨
      val i i.ops.typemin ≤ val j x ∧ val j x ≤ val i i.ops.typemax) →
      ∃ q, run = .ok q ∧ Represents i q (val j x) 1) := by
  cases i with | bits t =>
  cases j with | bits s =>
  intro run
  have hmin_val : (JInt.typemin t).val = t.min := by cases t <;> decide
  have hmax_val : (JInt.typemax t).val = t.max := by cases t <;> decide
  have hzero_val : (JInt.lit t 0).val = 0 := by cases t <;> decide
  have hone_val : (JInt.lit t 1).val = 1 := by cases t <;> decide
  have hone_s : (JInt.lit s 1).val = 1 := by cases s <;> decide
  refine ⟨fun hu hx_neg => ?_, fun hs _ hx_lt_min => ?_, fun _ hx_gt_max => ?_, fun hfit _ => ?_⟩
  · unfold run rationalizeIntegerTypedSource throwNegateUnsignedSource
    have hlt0 : decide (val (.bits s) x < 0) = true := decide_eq_true hx_neg
    simp only [hu, hlt0, Bool.and_self, ↓reduceIte]
    exact ⟨"cannot negate unsigned number", rfl⟩
  · unfold run rationalizeIntegerTypedSource
    have hlt_min : decide (val (.bits s) x < val (.bits t) (IntegerParameters.ops (.bits t)).typemin) = true :=
      decide_eq_true hx_lt_min
    have hhas : (IntegerParameters.ops (.bits t)).hasTypeMax = true := rfl
    simp only [hs, Bool.false_and, Bool.false_eq_true, ↓reduceIte, hhas, hlt_min]
    exact ⟨_, rfl, hminus hs, hzero_val⟩
  · unfold run rationalizeIntegerTypedSource
    have hmin_le_max : val (.bits t) (IntegerParameters.ops (.bits t)).typemin ≤
        val (.bits t) (IntegerParameters.ops (.bits t)).typemax := hmin rfl
    have hnot_neg : ¬ (val (.bits s) x < 0) := by
      have : 0 ≤ val (.bits t) (IntegerParameters.ops (.bits t)).typemax := by
        change 0 ≤ (JInt.typemax t).val; rw [hmax_val]; exact zero_le_max t
      omega
    have hnot_lt_min : decide (val (.bits s) x < val (.bits t) (IntegerParameters.ops (.bits t)).typemin) = false :=
      decide_eq_false (by omega)
    have hgt_max : decide (val (.bits t) (IntegerParameters.ops (.bits t)).typemax < val (.bits s) x) = true :=
      decide_eq_true hx_gt_max
    have hlt0 : decide (val (.bits s) x < 0) = false := decide_eq_false hnot_neg
    have hhas : (IntegerParameters.ops (.bits t)).hasTypeMax = true := rfl
    simp only [hlt0, Bool.and_false, Bool.false_eq_true, ↓reduceIte, hhas, hnot_lt_min, hgt_max]
    exact ⟨_, rfl, hone_val, hzero_val⟩
  · unfold run rationalizeIntegerTypedSource
    have hnot_lt_min : decide (val (.bits s) x < val (.bits t) (IntegerParameters.ops (.bits t)).typemin) = false := by
      apply decide_eq_false
      change ¬ (x.val < (JInt.typemin t).val)
      rw [hmin_val]; exact Int.not_lt.mpr hfit.1
    have hnot_gt_max : decide (val (.bits t) (IntegerParameters.ops (.bits t)).typemax < val (.bits s) x) = false := by
      apply decide_eq_false
      change ¬ ((JInt.typemax t).val < x.val)
      rw [hmax_val]; exact Int.not_lt.mpr hfit.2
    have hnot_u_neg : ((IntegerParameters.ops (.bits t)).isUnsignedOrBool && decide (val (.bits s) x < 0)) = false := by
      by_cases hu : t.signed = false
      · have hmin0 := min_eq_zero_of_unsigned hu
        have hfit' : t.min ≤ x.val ∧ x.val ≤ t.max := hfit
        have hnn : ¬ (x.val < 0) := by omega
        have hdec : decide (val (.bits s) x < 0) = false := decide_eq_false hnn
        rw [hdec, Bool.and_false]
      · have hs : t.signed = true := Decidable.byContradiction fun h => hu (Bool.eq_false_iff.mpr h)
        simp [IntegerParameters.ops, jintOps, hs]
    have hhas : (IntegerParameters.ops (.bits t)).hasTypeMax = true := rfl
    simp only [hnot_u_neg, Bool.false_eq_true, ↓reduceIte, hhas, hnot_lt_min, hnot_gt_max]
    exact integer_construction_aux (.bits t) (.bits s) x hfit

/-- 5. Registry id: `rational-exact-division`. -/
private theorem coprime_mul_cross {a b c e : Nat}
    (hab : Nat.gcd a b = 1) (hce : Nat.gcd c e = 1)
    (hac : Nat.gcd a c = 1) (heb : Nat.gcd e b = 1) :
    Nat.gcd (a * e) (c * b) = 1 := by
  have ha_cb : Nat.Coprime a (c * b) := Nat.Coprime.mul_right hac hab
  have he_cb : Nat.Coprime e (c * b) := Nat.Coprime.mul_right (Nat.Coprime.symm hce) heb
  exact Nat.Coprime.mul_left ha_cb he_cb

theorem exact_division_aux (t s : IntTy) (x : Rat t) (y : Rat s)
    (hx : Normalized x) (hy : Normalized y) :
    let p := t.promote s
    let run := divRatRatSource (jintPromoteOps t s) (dg (.bits p) (.bits p)) x y
    let convertFits := p.min ≤ x.num.val ∧ x.num.val ≤ p.max ∧
      p.min ≤ y.num.val ∧ y.num.val ≤ p.max
    let gn : Int := Nat.gcd x.num.val.natAbs y.num.val.natAbs
    let gd : Int := Nat.gcd x.den.val.natAbs y.den.val.natAbs
    let a := x.num.val.tdiv gn
    let b := y.num.val.tdiv gn
    let c := x.den.val.tdiv gd
    let e := y.den.val.tdiv gd
    let flip := c = 0 ∧ b < 0
    let an := if flip then -a else a
    let n := an * e
    let d := c * b
    let fits := fun n : Int => p.min ≤ n ∧ n ≤ p.max
    let safe := (flip → fits (-a)) ∧ fits n ∧ fits d ∧ (d < 0 → fits (-n) ∧ fits (-d))
    (¬ convertFits → IsInexact run) ∧
    (convertFits → (gn = 0 ∨ gd = 0) → run = .error .divideError) ∧
    (convertFits → gn ≠ 0 → gd ≠ 0 →
      (safe → ∃ q, run = .ok q ∧ Normalized q ∧
        q.num.val * d = n * q.den.val ∧
        (d ≠ 0 → q.den.val > 0) ∧
        (d = 0 → q.den.val = 0 ∧ intSign q.num.val = intSign n)) ∧
      (¬ safe → IsOverflow run)) ∧
    (convertFits → x.den.val > 0 → y.den.val = 0 →
      run = .ok (unsafeRationalSameSource (JInt.lit p 0) (JInt.lit p 1))) := by
  intro p run convertFits gn gd a b c e flip an n d fits safe
  have hxd_fit : fits x.den.val :=
    ⟨Int.le_trans (min_le_zero p) hx.1, Int.le_trans x.den.property.2 (max_le_promote_left t s)⟩
  have hyd_fit : fits y.den.val :=
    ⟨Int.le_trans (min_le_zero p) hy.1, Int.le_trans y.den.property.2 (max_le_promote_right t s)⟩
  have hprom_num : (jintPromoteOps t s).promote x.num y.num = (do
      let xp ← JInt.convert (p.name) p x.num.val
      let yp ← JInt.convert (p.name) p y.num.val
      pure (xp, yp)) := rfl
  have hprom_den : (jintPromoteOps t s).promote x.den y.den = (do
      let xp ← JInt.convert (p.name) p x.den.val
      let yp ← JInt.convert (p.name) p y.den.val
      pure (xp, yp)) := rfl
  have hdg_eq : dg (.bits p) (.bits p) = dgBits := rfl
  have hpart3 : convertFits → gn ≠ 0 → gd ≠ 0 →
      (safe → ∃ q, run = .ok q ∧ Normalized q ∧
        q.num.val * d = n * q.den.val ∧
        (d ≠ 0 → q.den.val > 0) ∧
        (d = 0 → q.den.val = 0 ∧ intSign q.num.val = intSign n)) ∧
      (¬ safe → IsOverflow run) := by
    intro ⟨hxn1, hxn2, hyn1, hyn2⟩ hgn hgd
    have hxn_fit : fits x.num.val := ⟨hxn1, hxn2⟩
    have hyn_fit : fits y.num.val := ⟨hyn1, hyn2⟩
    let xnumP : JInt p := ⟨x.num.val, hxn_fit⟩
    let ynumP : JInt p := ⟨y.num.val, hyn_fit⟩
    let xdenP : JInt p := ⟨x.den.val, hxd_fit⟩
    let ydenP : JInt p := ⟨y.den.val, hyd_fit⟩
    obtain ⟨xn, yn, hokN, hxn_v, hyn_v, hxn_abs, hyn_abs, hcopN, hmul_xn, hmul_yn, _, hsign_xn, _⟩ :=
      (dgBits_spec xnumP ynumP).2 hgn
    obtain ⟨xd, yd, hokD, hxd_v, hyd_v, hxd_abs, hyd_abs, hcopD, hmul_xd, hmul_yd, _, _, _⟩ :=
      (dgBits_spec xdenP ydenP).2 hgd
    have hxn_a : xn.val = a := hxn_v
    have hyn_b : yn.val = b := hyn_v
    have hxd_c : xd.val = c := hxd_v
    have hyd_e : yd.val = e := hyd_v
    have hc_nn : 0 ≤ c := by
      have h1 := tdiv_between x.den.val gd (Decidable.byContradiction fun h => hgd (by dsimp [gd]; omega))
      exact (h1.1 hx.1).1
    have he_nn : 0 ≤ e := by
      have h1 := tdiv_between y.den.val gd (Decidable.byContradiction fun h => hgd (by dsimp [gd]; omega))
      exact (h1.1 hy.1).1
    have hflip_bool : ((jintOps p).iszero xd && (jintOps p).signbit yn) = decide flip := by
      simp only [jintOps, hxd_c, hyn_b, flip, Bool.and_eq_decide, beq_iff_eq, decide_eq_true_eq]
    unfold run divRatRatSource
    rw [hprom_num, hprom_den, hdg_eq, convert_of_fits hxn_fit, convert_of_fits hyn_fit,
        convert_of_fits hxd_fit, convert_of_fits hyd_fit]
    dsimp only [Bind.bind, Except.bind, Pure.pure, Except.pure]
    rw [hokN, hokD]
    dsimp only
    have hjoin :
        (if ((jintPromoteOps t s).opsP.iszero xd && (jintPromoteOps t s).opsP.signbit yn) = true then
          Except.bind ((jintPromoteOps t s).opsP.checkedNeg xn) fun v =>
            Except.bind ((jintPromoteOps t s).opsP.checkedMul v yd) fun v_1 =>
              Except.bind ((jintPromoteOps t s).opsP.checkedMul xd yn) fun v_2 =>
                checkedDenSameSource (jintPromoteOps t s).opsP v_1 v_2
        else
          Except.bind ((jintPromoteOps t s).opsP.checkedMul xn yd) fun v_1 =>
            Except.bind ((jintPromoteOps t s).opsP.checkedMul xd yn) fun v_2 =>
              checkedDenSameSource (jintPromoteOps t s).opsP v_1 v_2) =
        Except.bind (if decide flip then (jintOps p).checkedNeg xn else Except.ok xn) (fun v =>
          Except.bind (JuliaLean.base.checked.checkedMulBits v yd) fun v_1 =>
            Except.bind (JuliaLean.base.checked.checkedMulBits xd yn) fun v_2 =>
              checkedDenSameSource (jintOps p) v_1 v_2) := by
      by_cases hf : flip
      · have htrue : ((jintPromoteOps t s).opsP.iszero xd && (jintPromoteOps t s).opsP.signbit yn) = true := by
          dsimp only [jintPromoteOps]; rw [hflip_bool, decide_eq_true hf]
        rw [htrue, if_pos rfl, decide_eq_true hf, if_pos rfl]; rfl
      · have hfalse : ((jintPromoteOps t s).opsP.iszero xd && (jintPromoteOps t s).opsP.signbit yn) = false := by
          dsimp only [jintPromoteOps]; rw [hflip_bool, decide_eq_false hf]
        rw [hfalse, if_neg Bool.false_ne_true, decide_eq_false hf, if_neg Bool.false_ne_true]; rfl
    dsimp only [Except.bind] at hjoin
    rw [hjoin]
    have hneg_xn := JuliaLean.Proofs.base.checked.negExact p xn
    unfold JuliaLean.Proofs.base.checked.ExactOrOverflow at hneg_xn
    rw [hxn_a] at hneg_xn
    have hstep1 : (if flip → fits (-a) then
        ∃ xn' : JInt p, (if decide flip then (jintOps p).checkedNeg xn else .ok xn) = .ok xn' ∧ xn'.val = an
      else IsOverflow (if decide flip then (jintOps p).checkedNeg xn else .ok xn)) := by
      by_cases hf : flip
      · by_cases hfa : fits (-a)
        · have himp : flip → fits (-a) := fun _ => hfa
          rw [if_pos himp, decide_eq_true hf, if_pos rfl]
          have hfa' : p.min ≤ -a ∧ -a ≤ p.max := hfa
          rw [if_pos hfa'] at hneg_xn
          obtain ⟨z, hz_ok, hz_val⟩ := hneg_xn
          exact ⟨z, hz_ok, by dsimp [an]; rw [if_pos hf]; exact hz_val⟩
        · have himp : ¬ (flip → fits (-a)) := fun h => hfa (h hf)
          rw [if_neg himp, decide_eq_true hf, if_pos rfl]
          have hfa' : ¬ (p.min ≤ -a ∧ -a ≤ p.max) := hfa
          rw [if_neg hfa'] at hneg_xn
          cases hcall : (jintOps p).checkedNeg xn with
          | ok _ =>
            change JuliaLean.base.checked.checkedNegBits xn = _ at hcall
            rw [hcall] at hneg_xn; contradiction
          | error err =>
            change JuliaLean.base.checked.checkedNegBits xn = _ at hcall
            rw [hcall] at hneg_xn
            cases err <;> first | contradiction | exact ⟨_, rfl⟩
      · have himp : flip → fits (-a) := fun h => absurd h hf
        rw [if_pos himp, decide_eq_false hf, if_neg Bool.false_ne_true]
        exact ⟨xn, rfl, by dsimp [an]; rw [if_neg hf]; exact hxn_a⟩
    by_cases hfa : flip → fits (-a)
    · rw [if_pos hfa] at hstep1
      obtain ⟨xn', hxn'_ok, hxn'_val⟩ := hstep1
      rw [hxn'_ok]
      dsimp only
