        let (xp, yp) ← (do
          let xp ← JInt.convert (pt.name) pt a.val
          let yp ← JInt.convert (pt.name) pt b.val
          pure (xp, yp))
        JuliaLean.base.checked.checkedMulBits xp yp) := rfl
    rw [hmul_eq]
    unfold FitsPair
    dsimp only [val, IntegerParameters.fits, IntegerParameters.ops, jintOps,
      Bind.bind, Except.bind, Pure.pure, Except.pure]
    refine ⟨fun hnot => ?_, fun ⟨hfa, hfb⟩ => ?_⟩
