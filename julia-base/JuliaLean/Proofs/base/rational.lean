theorem g2RoundedRatRat_of_specs
    (hGcd : ∀ {t s : IntTy} (x : JInt t) (y : JInt s),
      divgcdMixed x y = DivGcdCtorLemmas.dgBits x y)
    (hRel : ∀ (a b q : Int) (mode : Rounding), b ≠ 0 →
      (RoundedValue a b mode q ↔ q = rounded a b mode)) :
    RoundedRatRatCorrect := by
  intro t s x y mode hx hy
  unfold RoundedRatRatOutcome
  intro gn gd xn yn xd yd p cn cd fn fd
  let oldRun : Jl (JInt p) := divRationalRationalRoundedSource
    (Round5.dg (.bits t) (.bits s)) (Round5.dg (.bits t) (.bits s))
    JuliaLean.base.checked.checkedMulMixedBits
    JuliaLean.base.checked.checkedMulMixedBits
    (fun a b r => JuliaLean.base.div.divBitIntegerMode a b (Round5.sourceMode r))
    x y mode
  have hrun : roundedRatRat x y mode = oldRun := by
    have hdg : @divgcdMixed t s = Round5.dg (.bits t) (.bits s) := by
      funext a b
      exact hGcd a b
    unfold roundedRatRat oldRun
    rw [hdg]
    rfl
  have old :
      ((gn = 0 ∨ gd = 0) → oldRun = .error .divideError) ∧
      (gn ≠ 0 → gd ≠ 0 → ¬ cn → Round5.IsInexact oldRun) ∧
      (gn ≠ 0 → gd ≠ 0 → cn → ¬ fn → Round5.IsOverflow oldRun) ∧
      (gn ≠ 0 → gd ≠ 0 → cn → fn → ¬ cd → Round5.IsInexact oldRun) ∧
      (gn ≠ 0 → gd ≠ 0 → cn → fn → cd → ¬ fd → Round5.IsOverflow oldRun) ∧
      (gn ≠ 0 → gd ≠ 0 → cn → cd → fn ∧ fd →
        Round5.QuotientOutcome (.bits p) oldRun (xn*yd) (xd*yn) mode) := by
    exact Round5.mixed_rounded_rationals_proven t s x y mode hx hy
  rw [← hrun] at old
  refine ⟨old.1, ?_⟩
  intro hgn hgd
  refine ⟨old.2.1 hgn hgd, ?_⟩
  intro hcn
  refine ⟨old.2.2.1 hgn hgd hcn, ?_⟩
  intro hfn
  refine ⟨old.2.2.2.1 hgn hgd hcn hfn, ?_⟩
  intro hcd
  refine ⟨old.2.2.2.2.1 hgn hgd hcn hfn hcd, ?_⟩
  intro hfd
  let a : JInt p := ⟨xn*yd, hfn⟩
  let b : JInt p := ⟨xd*yn, hfd⟩
