/-- 18. `native_integer_order` (`rational-native-integer-order`). -/
theorem native_integer_order_aux (t s : IntTy) {W V : Type}
    (wide : Widening t s W) (reverse : Widening s t V)
    (x : Rat t) (n : JInt s) (hx : Normalized x) :
    let c := compareExtended x.num.val x.den.val n.val 1
    ltRatIntSource wide.product wide.lessLeft x n = decide (c < 0) ∧
    leRatIntSource wide.product wide.leLeft x n = decide (c ≤ 0) ∧
    ltIntRatSource reverse.product reverse.lessRight n x = decide (0 < c) ∧
    leIntRatSource reverse.product reverse.leRight n x = decide (0 ≤ c) := by
  intro c
  unfold ltRatIntSource ltRatIntMethod leRatIntSource leRatIntMethod ltIntRatSource ltIntRatMethod leIntRatSource leIntRatMethod Bind.bind Id.instMonad Monad.toBind
  dsimp only
  have hltL : ∀ (a : JInt t) (w : W),
      wide.lessLeft a w = decide (a.val < wide.val w) := by intro a w; cases wide <;> exact lt_eq a w
  have hleL : ∀ (a : JInt t) (w : W),
      wide.leLeft a w = decide (a.val ≤ wide.val w) := by intro a w; cases wide <;> exact le_eq a w
  have hltR : ∀ (v : V) (b : JInt t),
      reverse.lessRight v b = decide (reverse.val v < b.val) := by intro v b; cases reverse <;> exact lt_eq v b
  have hleR : ∀ (v : V) (b : JInt t),
      reverse.leRight v b = decide (reverse.val v ≤ b.val) := by intro v b; cases reverse <;> exact le_eq v b
  rw [hltL, hleL, hltR, hleR, widening_product_val, widening_product_val]
  dsimp only [c, compareExtended, intCmp, intSign]
  by_cases hdx : x.den.val = 0
  · have hxn := (normalized_extremes_full hx).2 hdx
    simp only [hdx, show (1 : Int) ≠ 0 by decide, ↓reduceIte, Int.zero_mul, Int.mul_zero]
    rcases hxn.2 with h1 | h1 <;> simp [h1]
  · simp only [hdx, show (1 : Int) ≠ 0 by decide, ↓reduceIte, Int.mul_one, Int.mul_comm x.den.val n.val]
    by_cases hlt : x.num.val < n.val * x.den.val
    · simp [hlt, show x.num.val ≤ n.val * x.den.val by omega,
        show ¬ n.val * x.den.val < x.num.val by omega,
        show ¬ n.val * x.den.val ≤ x.num.val by omega]
    · by_cases hgt : n.val * x.den.val < x.num.val
      · simp [hlt, hgt, show ¬ x.num.val ≤ n.val * x.den.val by omega,
          show n.val * x.den.val ≤ x.num.val by omega]
      · have heq : x.num.val = n.val * x.den.val := by omega
        simp [heq]

/-- 19. `complex_equality` (`rational-complex-equality-value`). -/
theorem complex_equality_aux (t : IntTy) (z : C (Rat t)) (x : Rat t)
    (hr : Normalized z.re) (hi : Normalized z.im) (hx : Normalized x) :
    let expected := z.im.num.val = 0 ∧
