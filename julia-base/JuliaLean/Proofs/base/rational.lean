def RationalSameSingleCall : Prop :=
  ∀ (World T R : Type)
    (ops : RationalSameOps (EStateM ArrayError World) T R)
    (num den : T) (initial : World),
    let observed : RationalSameOps
        (EStateM ArrayError (World × Nat × Nat)) T R := {
      constructTyped := fun n d => observeRationalCall true (ops.constructTyped n d) }
    match rationalSameInteger observed num den (initial, 0, 0) with
    | .ok _ (_, firstCalls, secondCalls) => firstCalls = 1 ∧ secondCalls = 0
    | .error _ (_, firstCalls, secondCalls) => firstCalls = 1 ∧ secondCalls = 0

