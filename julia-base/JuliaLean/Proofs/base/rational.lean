/-- Mathematical native range; used only in specifications. -/
abbrev GcdxFits (t : IntTy) (n : Int) : Prop := t.min ≤ n ∧ n ≤ t.max

def GcdxArgument {A : Type} (run : Jl A) : Prop :=
  ∃ message, run = .error (.argumentError message)

def GcdxInexact {A : Type} (run : Jl A) : Prop :=
  ∃ message, run = .error (.inexactError message)

def GcdxOverflow {A : Type} (run : Jl A) : Prop :=
  ∃ message, run = .error (.overflowError message)

def GcdxDomain {A : Type} (run : Jl A) : Prop :=
  ∃ message, run = .error (.domainError message)

/-- The mixed signed/unsigned magnitude conversion fails exactly at the signed
minimum when the result has unsigned signedness at the same width. Negating
that minimum still leaves a negative signed integer, which cannot be converted
to the unsigned promotion type. Wider result types avoid this boundary.
This condition is expressed using type bounds and original mathematical values;
it does not invoke the mixed-promotion or gcd models.
Source: base/intfuncs.jl:146-150,155-160,276-285. -/
abbrev GcdxMixedMagnitudeInexact (t s : IntTy) (a b : Int) : Prop :=
  t.signed ≠ s.signed ∧ (t.promote s).signed = false ∧
    ((t.signed = true ∧ a = (t.promote s).toSigned.min) ∨
     (s.signed = true ∧ b = (t.promote s).toSigned.min))

/-- The finite integer gcdx coefficients satisfy Bezout modulo their native
width for the actual wrapped local-idiv inputs. This remains meaningful for
signed component arithmetic whose unchecked idiv products have overflowed.
The rational gcd numerator/denominator are specified independently elsewhere;
no unsupported Bezout identity for the unwrapped original rationals is assumed.
Documentation: base/intfuncs.jl:194-234; source: base/rational.jl:670-671. -/
def GcdxWrappedBezout (r : IntTy) (a b x y : Int) : Prop :=
  let g : Int := Int.ofNat (Nat.gcd x.natAbs y.natAbs)
  (a * x + b * y - g) % (2 : Int) ^ r.bits = 0

/-- Complete native rational gcdx outcome, including all source-ordered error
classes. Mixed finite/infinite inputs fail first. The mixed magnitude boundary
can reject the numerator gcd before any denominator work; an unrepresentable
numerator gcd or denominator lcm raises OverflowError. Zero and infinity use
the direct coefficient branch. In the finite branch the two exact scaled
integer arguments are reduced modulo their actual local-idiv result widths;
integer gcdx can then fail with InexactError during mixed promotion or with
DomainError when its own nonnegative gcd cannot fit. Every remaining case must
return a normalized rational gcd and computed modular Bezout coefficients.

The whole normalized domain is covered: none of the error or success conditions
is a premise on a public property. This specification uses only mathematical
gcd/lcm, integer bounds, integer quotients and modular arithmetic.
Sources: base/rational.jl:650-655,662-674;
base/intfuncs.jl:54-66,136-160,194-260,276-285. -/
def NativeRationalGcdxOutcome {t s : IntTy} (x : Rat t) (y : Rat s)
    (run : Jl (NativeRationalGcdxResult t s)) : Prop :=
  let p := t.promote s
  let gn : Int := Int.ofNat (Nat.gcd x.num.val.natAbs y.num.val.natAbs)
  let ld : Int := Int.ofNat (Nat.lcm x.den.val.natAbs y.den.val.natAbs)
  if (x.den.val = 0 ∧ y.den.val ≠ 0) ∨ (x.den.val ≠ 0 ∧ y.den.val = 0) then
    GcdxArgument run
  else if GcdxMixedMagnitudeInexact t s x.num.val y.num.val then
    GcdxInexact run
  else if ¬ GcdxFits p gn then
    GcdxOverflow run
  else if ¬ GcdxFits p ld then
    GcdxOverflow run
  else if gn = 0 then
    ∃ (c : Rat p) (a b : JInt p),
      run = .ok (c, .direct a b) ∧ Normalized c ∧
      c.num.val = 0 ∧ c.den.val = 1 ∧ a.val = 0 ∧ b.val = 0
  else if ld = 0 then
    ∃ (c : Rat p) (a b : JInt p),
      run = .ok (c, .direct a b) ∧ Normalized c ∧
      c.num.val = 1 ∧ c.den.val = 0 ∧ a.val = 1 ∧ b.val = 1
  else
    let tx := gcdxIdivResultTy t p
    let ty := gcdxIdivResultTy s p
    let r := gcdxComputedCoefficientTy t s
    let ix := x.num.val.tdiv gn * ld.tdiv x.den.val
    let iy := y.num.val.tdiv gn * ld.tdiv y.den.val
    let wx := wrapInt tx ix
    let wy := wrapInt ty iy
    let integerGcd : Int := Int.ofNat (Nat.gcd wx.natAbs wy.natAbs)
    if GcdxMixedMagnitudeInexact tx ty wx wy then
      GcdxInexact run
    else if ¬ GcdxFits r integerGcd then
      GcdxDomain run
    else
      ∃ (c : Rat p) (a b : JInt r),
        run = .ok (c, .computed a b) ∧ Normalized c ∧
        c.num.val = gn ∧ c.den.val = ld ∧
        GcdxWrappedBezout r a.val b.val wx wy

/-- Every ordered pair of native integer component types, every finite or
infinite normalized rational pair, and every source error branch. Computed
coefficients retain their actual type even when it differs from the rational
gcd component. No successful-run or representability premise is imposed.
Sources: base/rational.jl:662-674; base/intfuncs.jl:194-234. -/
def NativeRationalGcdxCorrect : Prop :=
  ∀ (t s : IntTy) (x : Rat t) (y : Rat s),
    Normalized x → Normalized y →
      NativeRationalGcdxOutcome x y (gcdxRationalNative x y)

/-- Complete independent local-idiv outcome on normalized native rationals.
The numerator division fails before the denominator division when its divisor
is zero or its two signed operands form typemin / -1. Otherwise a zero original
rational denominator fails the second division. All other cases succeed with
the product of the mathematical truncating quotients, wrapped once to the
actual product type. Wrapping earlier mixed signedness quotients gives the
same residue because both quotient types and the product have the maximum
input width. Source: base/rational.jl:670; base/int.jl:275-276,353-358,1092-1100. -/
def NativeGcdxIdivOutcome {t p : IntTy} (x : Rat t) (c : Rat p)
    (run : Jl (JInt (gcdxIdivResultTy t p))) : Prop :=
  let numeratorType := JuliaLean.base.div.divMixedResultTy t p
  let firstFailure := c.num.val = 0 ∨
    (t.signed = true ∧ p.signed = true ∧
      x.num.val = numeratorType.min ∧ c.num.val = -1)
  if firstFailure then
    run = .error .divideError
  else if x.den.val = 0 then
    run = .error .divideError
  else
    ∃ out, run = .ok out ∧ out.val =
      wrapInt (gcdxIdivResultTy t p)
        (x.num.val.tdiv c.num.val * c.den.val.tdiv x.den.val)

/-- The standalone source670 binding covers all native type pairs, finite and
infinite normalized inputs, zero numerator divisors, signed division overflow
and unchecked multiplication overflow without narrowing its input domain.
Source: base/rational.jl:662-674, local idiv at 670. -/
def NativeGcdxIdivCorrect : Prop :=
  ∀ (t p : IntTy) (x : Rat t) (c : Rat p),
    Normalized x → Normalized c → NativeGcdxIdivOutcome x c (gcdxIdivNative x c)

