def ComplexPowerFiniteOutcome {t : IntTy}
    (run : Jl (JuliaLean.base.complex.Complex (Rat t))) (nr ni d : Int) : Prop :=
  (∀ out, run = .ok out → ComplexPowerFiniteValue out nr ni d) ∧
  ((ComplexPowerFractionFits t nr d ∧ ComplexPowerFractionFits t ni d) →
    ∃ out, run = .ok out ∧ ComplexPowerFiniteValue out nr ni d)

/-- The documented mathematical integer-power promise, over the full
concrete native component/exponent family. Finite exact values are specified
through Gaussian powers and gcd-reduced representability. Negative powers
of complex zero report DivideError. For nonfinite inputs, a negative power
returns canonical zero, exponent zero returns one, exponent one preserves
the input, and other successful powers remain nonfinite. Every returned
component is normalized, and every error is explicitly classified.

This statement is intentionally unproved and falsifiable: the source eagerly
squares even for exponent zero/one, can overflow in a representable-result
calculation, and wraps negation of the minimum native exponent. None of those
cases is discarded with a success or safe-range assumption. -/
def PowerNativeComplexIntegerCorrect : Prop :=
  ∀ (t s : IntTy) (z : JuliaLean.base.complex.Complex (Rat t)) (n : JInt s),
    Normalized z.re → Normalized z.im →
    let run := powerNativeComplexInteger z n
    (∀ out, run = .ok out → Normalized out.re ∧ Normalized out.im) ∧
    (∀ e, run = .error e → ComplexPowerAllowedError e) ∧
    (if 0 < z.re.den.val ∧ 0 < z.im.den.val then
      let a := z.re.num.val * z.im.den.val
      let b := z.im.num.val * z.re.den.val
      let d := z.re.den.val * z.im.den.val
      let norm := a * a + b * b
      if n.val < 0 ∧ norm = 0 then run = .error .divideError
      else if n.val < 0 then
        let p := complexPowerGaussian a (-b) n.val.natAbs
        let scale := d ^ n.val.natAbs
        ComplexPowerFiniteOutcome run (scale * p.1) (scale * p.2)
          (norm ^ n.val.natAbs)
      else
        let p := complexPowerGaussian a b n.val.natAbs
        ComplexPowerFiniteOutcome run p.1 p.2 (d ^ n.val.natAbs)
    else if n.val < 0 then
      ∃ out, run = .ok out ∧ ComplexPowerZero out
    else if n.val = 0 then
      ∃ out, run = .ok out ∧ ComplexPowerOne out
    else if n.val = 1 then run = .ok z
    else
      ∀ out, run = .ok out → out.re.den.val = 0 ∨ out.im.den.val = 0)

