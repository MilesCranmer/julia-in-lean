/-- Value-oriented specification for the existing typed Integer rationalization
callee at base/rational.jl:335-342. Finite representable inputs are exact; inputs
below or above the finite target range land at the corresponding canonical infinity.
The specification neither invokes the constructor nor assumes any callee law. -/
def IntegerRationalizeImage (t : IntTy) (n : Int) (q : Rat t) : Prop :=
  Normalized q ∧
  (t.min ≤ n ∧ n ≤ t.max → q.den.val = 1 ∧ q.num.val = n) ∧
  (n < t.min → q.den.val = 0 ∧ q.num.val < 0) ∧
  (t.max < n → q.den.val = 0 ∧ 0 < q.num.val)

/-- Complete native-component contract for source322, with no input-range or
successful-run premise. Unsigned targets reject a negative component with
OverflowError. Otherwise each output component has the independently specified
extended integer image, even when an input component does not fit the target.
Julia source: base/rational.jl:322,335-342; documentation: base/rational.jl:239-255. -/
def ComplexIntegerRationalizeTyped : Prop :=
  ∀ (t s : IntTy) {K : Type}
      (z : JuliaLean.base.complex.Complex (JInt s)) (kwargs : K),
    if t.signed = false ∧ (z.re.val < 0 ∨ z.im.val < 0) then
      rationalizeComplexIntegersTyped t z kwargs =
        .error (.overflowError "cannot negate unsigned number")
    else
      ∃ q : JuliaLean.base.complex.Complex (Rat t),
        rationalizeComplexIntegersTyped t z kwargs = .ok q ∧
        IntegerRationalizeImage t z.re.val q.re ∧
        IntegerRationalizeImage t z.im.val q.im

/-- The default complex overload uses Int64 for both output components on the
bundled 64-bit platform, covers every native input width, and ignores the keyword
payload exactly as the selected integer callees do. Oversized integer components
are included, rather than excluded by a fitting-input premise.
Julia source: base/rational.jl:323,335-342; documentation: base/rational.jl:239-255. -/
def ComplexIntegerRationalizeDefault : Prop :=
  ∀ (s : IntTy) {K : Type}
      (z : JuliaLean.base.complex.Complex (JInt s)) (kwargs : K),
    ∃ q : JuliaLean.base.complex.Complex (Rat .i64),
      rationalizeComplexIntegersDefault z kwargs = .ok q ∧
      IntegerRationalizeImage .i64 z.re.val q.re ∧
      IntegerRationalizeImage .i64 z.im.val q.im

/-- All machine integers retain their original width and signedness and embed
exactly as canonical finite rationals, for every keyword payload including
irrelevant or negative tolerance values. Julia source: base/rational.jl:334,50.
Documentation: base/rational.jl:239-255;
doc/src/manual/complex-and-rational-numbers.md:182-220. -/
def IntegerRationalizeKeywords : Prop :=
  ∀ (t : IntTy) {K : Type} (x : JInt t) (kwargs : K),
    ∃ q : Rat t,
      rationalizeIntegerKeywords x kwargs = .ok q ∧
      Normalized q ∧ q.den.val = 1 ∧ q.num.val = x.val

/-- Both Boolean integers embed exactly with a true denominator and preserve the
Boolean component type, independently of every ignored keyword payload.
Julia source: base/rational.jl:334,50; base/number.jl:405-406; base/bool.jl:170. -/
def BooleanRationalizeKeywords : Prop :=
  ∀ {K : Type} (x : Bool) (kwargs : K), ∃ q : Rational Bool,
    rationalizeBooleanKeywords x kwargs = .ok q ∧ q.den = true ∧
    (if q.num then (1 : Int) else 0) = (if x then (1 : Int) else 0)

