  change wrapInt t (x.val - wrapInt t (wrapInt t (x.val.tdiv y.val) * y.val)) = _
  rw [wrapInt_mul_left, wrapInt_sub_right]
  have hqr := Int.tdiv_mul_add_tmod x.val y.val
