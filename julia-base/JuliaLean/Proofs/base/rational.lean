  let reducedY := y.val.tdiv g
  let p := t.promote s
  let converts := RoundedFits p x.den.val ∧ RoundedFits p reducedY
  let productFits := RoundedFits p (x.den.val * reducedY)
  (g = 0 → run = .error .divideError) ∧
  (g ≠ 0 →
    (¬ converts → RoundedInexact run) ∧
    (converts →
      (¬ productFits → RoundedOverflow run) ∧
      (productFits →
        RoundedOutcome run x.num.val (x.den.val * y.val) r ∧
        RoundedNativeFinalOutcome t p run reducedX (x.den.val * reducedY) r)))

/-- Full outcome contract for base/rational.jl:590-593, with the original
exact value (x*y.den)/y.num and native source-ordered checked-product failures.
Its exact final operands determine both signed quotient overflow and mandatory
successful wrapping in the remaining nonzero-divisor cases. -/
def RoundedIntegerRatOutcome {t s : IntTy} (x : JInt t) (y : Rat s)
    (r : Rounding)
    (run : Jl (JInt (JuliaLean.base.div.divMixedResultTy (t.promote s) s))) : Prop :=
  let g : Int := Int.ofNat (Nat.gcd x.val.natAbs y.num.val.natAbs)
  let reducedX := x.val.tdiv g
  let reducedY := y.num.val.tdiv g
  let p := t.promote s
  let converts := RoundedFits p reducedX ∧ RoundedFits p y.den.val
  let productFits := RoundedFits p (reducedX * y.den.val)
  (g = 0 → run = .error .divideError) ∧
  (g ≠ 0 →
    (¬ converts → RoundedInexact run) ∧
    (converts →
      (¬ productFits → RoundedOverflow run) ∧
      (productFits →
        RoundedOutcome run (x.val * y.den.val) y.num.val r ∧
        RoundedNativeFinalOutcome p s run (reducedX * y.den.val) reducedY r)))

/-- Full outcome contract for base/rational.jl:594-598. The expected quotient
is the original exact cross-product ratio. Both-zero gcd inputs, promotion
