def RoundedRatRatOutcome {t s : IntTy} (x : Rat t) (y : Rat s)
    (r : Rounding) (run : Jl (JInt (t.promote s))) : Prop :=
  let gn : Int := Int.ofNat (Nat.gcd x.num.val.natAbs y.num.val.natAbs)
  let gd : Int := Int.ofNat (Nat.gcd x.den.val.natAbs y.den.val.natAbs)
  let xn := x.num.val.tdiv gn
  let yn := y.num.val.tdiv gn
  let xd := x.den.val.tdiv gd
  let yd := y.den.val.tdiv gd
