namespace JuliaLean.Proofs.base.rational.Models1Group20

open JuliaLean JuliaLean.Promotion JuliaLean.base.rational
open JuliaLean.base.rational.Models1Group20

/-!
Independent full-domain native contracts for source 612 onward. The earlier
`RoundedValue` and `RoundedFits` specifications in this group's division
section are mathematical inequalities and target representability, not
models used as expected answers. Here all rounding modes, zeros, infinities,
negative exponents and arithmetic failures stay in the quantified domain.
No statement assumes any supplied callee-correctness law.
-/

/-- Only the exception class is part of the conversion contract. -/
def RemainingInexact {α : Type} (run : Jl α) : Prop :=
  ∃ message, run = .error (.inexactError message)

/-- Rational-target rounding's mathematical result and conversion errors.
The infinity branch requires sign preservation for a target that can hold
the signed infinity; a negative infinity cannot be stored by an unsigned
rational component. These are requested outcomes, not facts assumed about
`copysign` or conversion. -/
def RemainingRationalRounding {s target : IntTy} (x : Rat s)
    (mode : Rounding) (run : Jl (Rat target)) : Prop :=
  if x.den.val = 0 then
    if x.num.val < 0 ∧ target.signed = false then RemainingInexact run
    else ∃ q, run = .ok q ∧ Normalized q ∧ q.den.val = 0 ∧
      q.num.val = (if x.num.val < 0 then -1 else 1)
  else ∃ a : Int, RoundedValue x.num.val x.den.val mode a ∧
    (if RoundedFits target a then
      ∃ q, run = .ok q ∧ Normalized q ∧ q.num.val = a ∧ q.den.val = 1
    else RemainingInexact run)

/-- The return type and numeric rounding promised by `round(x,r)` at
base/rounding.jl:333-352, including the default nearest/ties-even mode. -/
def RoundNativeDefaultCorrect : Prop :=
  ∀ (t : IntTy) (x : Rat t), Normalized x → ∀ mode,
    RemainingRationalRounding x mode (roundNativeDefault x mode)

/-- Rational target conversion, for all source and target native widths,
all seven rounding modes, finite values, and both representable infinities. -/
def RoundNativeRationalCorrect : Prop :=
  ∀ (s target : IntTy) (x : Rat s), Normalized x → ∀ mode,
    RemainingRationalRounding x mode (roundNativeRational target x mode)

/-- Floating target integers include the two infinities, as documented by
base/rounding.jl:350-352. Finite nonintegral floating values and NaNs are not
members of this mathematical rounding target set. -/
def RemainingFloatInteger (f : JuliaLean.base.float.FTy)
    (x : JuliaLean.base.float.FV f) : Prop :=
  x.isinf = true ∨
    (x.isfinite = true ∧ ((Fl.toRat x).2 : Int) ∣ (Fl.toRat x).1)

/-- Exact extended-real pair, used only in a specification. -/
def remainingFloatPair {f : JuliaLean.base.float.FTy}
    (x : JuliaLean.base.float.FV f) : Int × Int :=
  if x.isinf then (if x.signbit then -1 else 1, 0)
  else ((Fl.toRat x).1, (Fl.toRat x).2)

/-- The documented distance coordinate puts infinity one ulp above
floatmax; it does not use any floating operation from the model. -/
def remainingFloatCoordinate {f : JuliaLean.base.float.FTy}
    (x : JuliaLean.base.float.FV f) : Int :=
  if x.isinf then (if x.signbit then -1 else 1) * (2 : Int) ^ (f.fmt.bias + 1)
  else (Fl.toRat x).1.tdiv (Fl.toRat x).2

/-- Parity for nearest/ties-even rounding, using integer parity where
adjacent integral values are representable, and significand parity after
adjacent representable integers are farther apart. -/
def RemainingFloatEven {f : JuliaLean.base.float.FTy}
    (x : JuliaLean.base.float.FV f) : Prop :=
  if (remainingFloatCoordinate x).natAbs < 2 ^ (f.fmt.sb + 1) then
    remainingFloatCoordinate x % 2 = 0
  else x.toBits % 2 = 0

/-- Mathematical ordering of canonical finite pairs and signed infinities. -/
def remainingExtendedCompare (n d m e : Int) : Int :=
  if d = 0 then
    if e = 0 then intCmp (intSign n) (intSign m) else intSign n
  else if e = 0 then -intSign m else intCmp (n * e) (m * d)

/-- Independent rounding directly to integers representable by the
requested IEEE type. This does not substitute a two-stage integer rounding
and floating conversion for the documented target-type rounding promise. -/
def RemainingFloatRounding (f : JuliaLean.base.float.FTy)
    (out : JuliaLean.base.float.FV f) (n d : Int) (mode : Rounding) : Prop :=
  let order := fun z : JuliaLean.base.float.FV f =>
    remainingExtendedCompare (remainingFloatPair z).1 (remainingFloatPair z).2 n d
  let down := order out ≤ 0 ∧
    ∀ z, RemainingFloatInteger f z → order z ≤ 0 →
      remainingExtendedCompare (remainingFloatPair z).1 (remainingFloatPair z).2
        (remainingFloatPair out).1 (remainingFloatPair out).2 ≤ 0
  let up := 0 ≤ order out ∧
    ∀ z, RemainingFloatInteger f z → 0 ≤ order z →
      remainingExtendedCompare (remainingFloatPair out).1 (remainingFloatPair out).2
        (remainingFloatPair z).1 (remainingFloatPair z).2 ≤ 0
  let distance := fun z : JuliaLean.base.float.FV f =>
    (remainingFloatCoordinate z * d - n).natAbs
  RemainingFloatInteger f out ∧ match mode with
  | .down => down
  | .up => up
  | .toZero => if n < 0 then up else down
  | .fromZero => if n < 0 then down else up
  | .nearest | .nearestAway | .nearestUp =>
      (∀ z, RemainingFloatInteger f z → distance out ≤ distance z) ∧
      (∀ z, RemainingFloatInteger f z → distance out = distance z →
        remainingFloatCoordinate out ≠ remainingFloatCoordinate z →
        match mode with
        | .nearest => RemainingFloatEven out
        | .nearestAway =>
            (remainingFloatCoordinate z).natAbs ≤ (remainingFloatCoordinate out).natAbs
        | .nearestUp => remainingFloatCoordinate z ≤ remainingFloatCoordinate out
        | _ => True)

