def bool_rounding_integer_target : Prop :=
  ∀ (t : IntTy) (x : Rational Bool) (mode : Rounding)
    (hvalid : x.num = true ∨ x.den = true),
    let run := roundBoolRationalSource (JInt t) true
      (JuliaLean.Proofs.base.rational.Round5.boolInteger t) x mode
    (x.den = false → HasError run) ∧
    (x.den = true → ∃ out, run = .ok out ∧
      out.val = (if x.num then 1 else 0) ∧
      out.val * (if x.den then 1 else 0) = (if x.num then 1 else 0))

def boolEqInt (b : Bool) (n : JInt .i64) : Bool :=
  JuliaLean.base.int.eq (JuliaLean.base.int.ofBool .i64 b) n

def bool_rounding_bool_target : Prop :=
  ∀ (x : Rational Bool) (mode : Rounding)
    (hvalid : x.num = true ∨ x.den = true),
    let eqLit := fun (q : Rational Bool) (n : Int) =>
      eqRatIntSource
        (fun b => boolEqInt b (JInt.lit .i64 1))
        boolEqInt q (JInt.lit .i64 n)
    let run := roundBoolRationalSource Bool true
      (fun q => boolOfRatSource (fun q => eqLit q 0) (fun q => eqLit q 1)
        q inexactErrorCore) x mode
    (x.den = false → HasError run) ∧
    (x.den = true → run = .ok x.num)

def prop_rational_bool_rounding : Prop :=
  bool_rounding_integer_target ∧ bool_rounding_bool_target ∧
    JuliaLean.Proofs.base.rational.Round10.bool_rounding_noninteger

