/-- Mathematical machine-range predicate used only by specifications. -/
def RemainderFits (t : IntTy) (n : Int) : Prop := t.min ≤ n ∧ n ≤ t.max

/-- Only exception class is promised; text payload is not part of the public contract. -/
def RemainderInexact {α : Type} (run : Jl α) : Prop :=
  ∃ message, run = .error (.inexactError message)

def RemainderOverflow {α : Type} (run : Jl α) : Prop :=
  ∃ message, run = .error (.overflowError message)

def RemainderArgument {α : Type} (run : Jl α) : Prop :=
  ∃ message, run = .error (.argumentError message)

/-- Mathematical scaled remainder: exact truncation and floor are mathematical
integer operations in this specification, not machine operations in a model. -/
def RemainderMathematical (floorMode : Bool) (dividend divisor : Int) : Int :=
  if floorMode then dividend - divisor * dividend.fdiv divisor
  else dividend - divisor * dividend.tdiv divisor

/-- Independent total outcome for a normalized rational dividend and a native
integer divisor. Conversion and checked-product overflow are obligations of
the public checked arithmetic. Once these succeed, zero product means a zero
divisor (or rational infinity) and must raise DivideError; every other case
must return the exact remainder, retain the original denominator and remain
normalized. There is no successful-run or range precondition.

The output type pOut is supplied by the model's typed result, not assumed to be
the type of the checked product. The expected value does not invoke any model.
Source: base/rational.jl:460-466; base/int.jl:292-299; base/div.jl:80-96. -/
def RationalIntegerRemainderOutcome {t s pOut : IntTy}
    (floorMode : Bool) (x : Rat t) (y : JInt s) (run : Jl (Rat pOut)) : Prop :=
  let p := t.promote s
  let d := x.den.val
  let n := x.num.val
  let k := y.val
  let converted := RemainderFits p d ∧ RemainderFits p k
  let productFits := RemainderFits p (d * k)
  (¬converted → RemainderInexact run) ∧
  (converted → ¬productFits → RemainderOverflow run) ∧
  (converted → productFits →
    (d * k = 0 → run = .error .divideError) ∧
    (d * k ≠ 0 → ∃ q, run = .ok q ∧ Normalized q ∧
      q.den.val = d ∧ q.num.val = RemainderMathematical floorMode n (d * k)))

/-- Every native Rational/Integer rem call is accounted for, including negative
numerators against unsigned divisors, zero integer divisors, infinite rationals,
failed checked promotion and product overflow. The only premise is the genuine
normalized-rational representation invariant. Source: base/rational.jl:460-466;
base/int.jl:278-279; base/div.jl:80-96. -/
def RationalRemIntegerNativeCorrect : Prop :=
  ∀ (t s : IntTy) (x : Rat t) (y : JInt s), Normalized x →
    RationalIntegerRemainderOutcome false x y (rationalRemIntegerNative x y)

/-- The corresponding complete native mod contract uses floor rather than
truncation. It also detects spurious conversion of a negative numerator into
an unsigned intermediate. Source: base/rational.jl:460-466;
base/int.jl:292-299,335-351. -/
def RationalModIntegerNativeCorrect : Prop :=
  ∀ (t s : IntTy) (x : Rat t) (y : JInt s), Normalized x →
    RationalIntegerRemainderOutcome true x y (rationalModIntegerNative x y)

/-- Complete normalized-domain outcome for Integer/Rational remainder.
The expected exact ratio is derived from the original rational divisor.
Every finite nonzero divisor requires successful normalization once the checked
product fits. A zero rational divisor raises DivideError. An infinite rational
reaches the Rational(0,0) rejection after its nonzero numerator divides zero;
it therefore raises ArgumentError, rather than returning an invented value.
Earlier checked conversion/overflow errors retain their source priority.
Source: base/rational.jl:474-480,30-46; base/int.jl:278-279,342-351. -/
def IntegerRationalRemainderOutcome {t s pOut : IntTy}
    (floorMode : Bool) (y : JInt s) (x : Rat t) (run : Jl (Rat pOut)) : Prop :=
  let p := t.promote s
  let d := x.den.val
  let n := x.num.val
  let k := y.val
  let converted := RemainderFits p d ∧ RemainderFits p k
  let productFits := RemainderFits p (d * k)
  (¬converted → RemainderInexact run) ∧
  (converted → ¬productFits → RemainderOverflow run) ∧
  (converted → productFits →
    (n = 0 → run = .error .divideError) ∧
    (n ≠ 0 → d = 0 → RemainderArgument run) ∧
    (n ≠ 0 → 0 < d → ∃ q, run = .ok q ∧ Normalized q ∧ 0 < q.den.val ∧
      q.num.val * d = RemainderMathematical floorMode (d * k) n * q.den.val))

/-- Integer/Rational rem preserves the exact truncating remainder ratio across
all native signedness and width pairs, normalizes its output, and has the full
exception classification above. Source: base/rational.jl:474-480. -/
def IntegerRemRationalNativeCorrect : Prop :=
  ∀ (t s : IntTy) (y : JInt s) (x : Rat t), Normalized x →
    IntegerRationalRemainderOutcome false y x (integerRemRationalNative y x)

/-- Integer/Rational mod preserves the exact floor remainder ratio, including
negative rational divisors of unsigned integers. Source: base/rational.jl:474-480. -/
def IntegerModRationalNativeCorrect : Prop :=
  ∀ (t s : IntTy) (y : JInt s) (x : Rat t), Normalized x →
    IntegerRationalRemainderOutcome true y x (integerModRationalNative y x)

