/-! ## Basic `IntTy`, `JInt`, and `uabs` Lemmas -/

theorem min_le_zero (t : IntTy) : t.min ≤ 0 := by
  cases t <;> decide

theorem zero_le_max (t : IntTy) : 0 ≤ t.max := by
  cases t <;> decide

theorem one_le_max (t : IntTy) : 1 ≤ t.max := by
  cases t <;> decide

theorem min_eq_zero_of_unsigned {t : IntTy} (hu : t.signed = false) : t.min = 0 := by
  cases t <;> simp_all [IntTy.signed, IntTy.min]

theorem neg_one_ge_min_of_signed {t : IntTy} (hs : t.signed = true) : t.min ≤ -1 := by
  cases t <;> simp_all [IntTy.signed, IntTy.min, IntTy.bits] <;> decide

theorem max_lt_neg_min_of_signed {t : IntTy} (hs : t.signed = true) : t.min = -(t.max + 1) := by
  cases t <;> simp_all [IntTy.signed, IntTy.min, IntTy.max, IntTy.bits]

theorem toUnsigned_signed (t : IntTy) : t.toUnsigned.signed = false := by
  cases t <;> rfl

theorem toUnsigned_min (t : IntTy) : t.toUnsigned.min = 0 := by
  cases t <;> decide

theorem natAbs_le_toUnsigned_max {t : IntTy} (x : JInt t) :
    (x.val.natAbs : Int) ≤ t.toUnsigned.max := by
  have hx := x.property
  cases t <;> simp_all [IntTy.min, IntTy.max, IntTy.toUnsigned, IntTy.bits, IntTy.signed] <;> omega

theorem promote_unsigned {t s : IntTy} (ht : t.signed = false) (hs : s.signed = false) :
    (t.promote s).signed = false := by
  cases t <;> cases s <;> simp_all [IntTy.signed, IntTy.promote, IntTy.bits]

theorem max_le_promote_left (t s : IntTy) : t.max ≤ (t.promote s).max := by
  cases t <;> cases s <;> decide

theorem max_le_promote_right (t s : IntTy) : s.max ≤ (t.promote s).max := by
  cases t <;> cases s <;> decide

theorem min_ge_promote_same_sign {t s : IntTy} (h : t.signed = s.signed) :
    (t.promote s).min ≤ t.min ∧ (t.promote s).min ≤ s.min := by
  cases t <;> cases s <;> simp_all [IntTy.signed, IntTy.promote, IntTy.min, IntTy.bits] <;> decide

theorem uabs_val {t : IntTy} (x : JInt t) :
    (JuliaLean.base.float.uabs x).val = (x.val.natAbs : Int) := by
  unfold JuliaLean.base.float.uabs
  by_cases hs : t.signed = true
  · simp only [hs, ↓reduceIte, JuliaLean.base.float.uabs_BitSigned]
    exact unsigned_abs_val hs x
  · have hu : t.signed = false := Bool.eq_false_iff.mpr hs
    simp only [hu, Bool.false_eq_true, ↓reduceIte, JuliaLean.base.float.uabs_Integer]
    rw [remT_val, abs_val]
    have hx0 : 0 ≤ x.val := nonneg_of_unsigned hu x
    have hnot : ¬ (t.signed = true ∧ x.val = t.min) := by simp [hu]
    simp only [hnot, ↓reduceIte]
    have hrange : t.toUnsigned.min ≤ (x.val.natAbs : Int) ∧ (x.val.natAbs : Int) ≤ t.toUnsigned.max :=
      ⟨by rw [toUnsigned_min]; exact Int.natCast_nonneg _, natAbs_le_toUnsigned_max x⟩
    exact wrapInt_of_inRange t.toUnsigned (x.val.natAbs : Int) hrange

theorem convert_eq_ok_iff {t : IntTy} (n : Int) (z : JInt t) :
    JInt.convert (t.name) t n = .ok z ↔ (t.min ≤ n ∧ n ≤ t.max) ∧ z.val = n := by
  unfold JInt.convert
  by_cases h : t.min ≤ n ∧ n ≤ t.max
  · simp only [dif_pos h, Except.ok.injEq]
    constructor
    · intro hz; subst hz; exact ⟨h, rfl⟩
    · rintro ⟨_, rfl⟩; exact Subtype.ext rfl
  · simp only [dif_neg h, reduceCtorEq, false_iff]
    exact fun ⟨hc, _⟩ => h hc

theorem convert_of_fits {functionName : String} {t : IntTy} {n : Int} (h : t.min ≤ n ∧ n ≤ t.max) :
    JInt.convert functionName t n = .ok ⟨n, h⟩ := by
  simp [JInt.convert, dif_pos h]

theorem convert_of_not_fits {functionName : String} {t : IntTy} {n : Int} (h : ¬ (t.min ≤ n ∧ n ≤ t.max)) :
    JInt.convert functionName t n = .error (.inexactError functionName) := by
  simp [JInt.convert, dif_neg h]

theorem convert_val_self {t : IntTy} (x : JInt t) :
    JInt.convert (t.name) t x.val = .ok x := by
  simp [JInt.convert, dif_pos x.property]

/-! ## 2-adic Valuation (`cttz_int`) and `binaryGcd` / `gcd_BitInteger` / `lcmBits` -/

private theorem find?_map_succ_testBit (l : List Nat) (p : Nat) :
    (l.map Nat.succ).find? (fun i => p.testBit i) =
      (l.find? (fun i => (p / 2).testBit i)).map Nat.succ := by
  induction l with
  | nil => rfl
  | cons a l ih =>
    simp only [List.map_cons, List.find?_cons, Nat.testBit_succ]
    cases (p / 2).testBit a <;> simp [ih]

private theorem find?_range_testBit (w : Nat) : ∀ (p : Nat), 0 < p → p < 2 ^ w →
    ∃ tz < w, (List.range w).find? (fun i => p.testBit i) = some tz ∧
      p = 2 ^ tz * (1 + 2 * (p / 2 ^ (tz + 1))) := by
  induction w with
  | zero => intro p hp0 hpw; simp at hpw; omega
  | succ w ih =>
    intro p hp0 hpw
    rw [List.range_succ_eq_map, List.find?_cons, Nat.testBit_zero]
    rcases Nat.mod_two_eq_zero_or_one p with h | h
    · simp only [h, Nat.zero_ne_one, decide_false, find?_map_succ_testBit]
      have hp2_pos : 0 < p / 2 := by omega
      have hp2_lt : p / 2 < 2 ^ w := by rw [Nat.pow_succ] at hpw; omega
      obtain ⟨tz, htz_lt, hfind, heq⟩ := ih (p / 2) hp2_pos hp2_lt
      rw [hfind]
      refine ⟨tz + 1, by omega, rfl, ?_⟩
      have hdiv : (p / 2) / 2 ^ (tz + 1) = p / 2 ^ (tz + 2) := by
        rw [Nat.div_div_eq_div_mul, Nat.mul_comm 2, ← Nat.pow_succ]
      rw [hdiv] at heq
      have hp_eq : p = 2 * (p / 2) := by omega
      have hpow_mul : 2 * (2 ^ tz * (1 + 2 * (p / 2 ^ (tz + 2)))) =
          2 ^ (tz + 1) * (1 + 2 * (p / 2 ^ (tz + 2))) := by
        rw [← Nat.mul_assoc, Nat.mul_comm 2 (2 ^ tz), ← Nat.pow_succ]
      conv => lhs; rw [hp_eq, heq, hpow_mul]
    · simp only [h, decide_true]
      refine ⟨0, by omega, rfl, ?_⟩
      simp only [Nat.pow_zero, Nat.zero_add, Nat.pow_one, Nat.one_mul]
      omega
private theorem cttz_int_eq_trailing_zeros {t : IntTy} (x : JInt t) :
    (JuliaLean.base.int.cttz_int x).val = (JuliaLean.base.int.trailing_zeros x).val := by
  have hval := trailing_zeros_val x
  have hle : ((List.range t.bits).find? (fun i => (pattern x).testBit i)).getD t.bits ≤ t.bits :=
    (trailing_spec x).1
  have hc : (JuliaLean.base.int.cttz_int x).val =
      (((List.range t.bits).find? (fun i => (pattern x).testBit i)).getD t.bits : Nat) := by
    unfold JuliaLean.base.int.cttz_int JuliaLean.C.jlCttzInt
    rw [← pattern_fromJInt]
    have hf : (fun i => pattern x / 2 ^ i % 2 == 1) = (fun i => (pattern x).testBit i) := by
      funext i
      rw [Nat.testBit_eq_decide_div_mod_eq]
      cases h : (pattern x / 2 ^ i % 2 == 1) <;> simp_all
    rw [hf, toJInt_ofNat_val]
    cases t <;> simp only [IntTy.bits] at hle <;> simp [wrapInt, IntTy.signed, IntTy.bits] <;> omega
  rw [hc, hval]

theorem cttz_factorization {t : IntTy} (x : JInt t) (hx : x.val ≠ 0) :
    let tz := (JuliaLean.base.int.cttz_int x).val.toNat
    tz < t.bits ∧
    ∃ q : Nat, x.val.natAbs = 2 ^ tz * q ∧ 0 < q ∧ q % 2 = 1 ∧
      (JuliaLean.base.int.shr_Int x (JuliaLean.base.int.lit .i64 tz)).val =
        if x.val < 0 then -(q : Int) else (q : Int) := by
  have hp_pos : 0 < pattern x := Decidable.byContradiction fun hle => by
    have hp0 : pattern x = 0 := by omega
    have hval := val_eq_wrap_pattern x
    rw [hp0] at hval
    have hw0 : wrapInt t 0 = 0 := by cases t <;> decide
    exact hx (hval.trans hw0)
  obtain ⟨tz, htz_lt, hfind, hpeq⟩ := find?_range_testBit t.bits (pattern x) hp_pos (pattern_lt x)
  have htz_eq : (JuliaLean.base.int.cttz_int x).val.toNat = tz := by
    rw [cttz_int_eq_trailing_zeros, trailing_zeros_val, hfind]
    rfl
  dsimp only
  rw [htz_eq]
  have hbits128 : t.bits ≤ 128 := by cases t <;> decide
  have hlit_tz : (JuliaLean.base.int.lit .i64 (tz : Int)).val = (tz : Int) := by
    rw [lit_val]
    exact wrapInt_of_inRange .i64 (tz : Int) (by simp [IntTy.min, IntTy.max, IntTy.signed, IntTy.bits]; omega)
  have hshr_val : (JuliaLean.base.int.shr_Int x (JuliaLean.base.int.lit .i64 (tz : Int))).val =
      x.val / ((2 ^ tz : Nat) : Int) := by
    have hsh := (shiftIntCount_proven t x (JuliaLean.base.int.lit .i64 (tz : Int))).1
    simp only [hlit_tz, Int.natCast_nonneg, ↓reduceIte, Int.toNat_natCast, Int.natCast_pow] at hsh ⊢
    exact hsh
  refine ⟨htz_lt, ?_⟩
  let m := pattern x / 2 ^ (tz + 1)
  have hpeq' : pattern x = 2 ^ tz * (1 + 2 * m) := hpeq
  by_cases hneg : x.val < 0
  · have hpat_int : (pattern x : Int) = x.val + ((2 ^ t.bits : Nat) : Int) := by
      have hc := pattern_cast x
      have hbounds := val_bounds x
      cases t <;> simp only [IntTy.bits, IntTy.min, IntTy.max, IntTy.signed] at hc hbounds ⊢ <;> omega
    have hnatAbs_eq : x.val.natAbs + pattern x = 2 ^ t.bits := by omega
    have hpow_split : 2 ^ t.bits = 2 ^ tz * 2 ^ (t.bits - tz) := by
      rw [← Nat.pow_add, Nat.add_sub_of_le (Nat.le_of_lt htz_lt)]
    have hlt_rem : 1 + 2 * m < 2 ^ (t.bits - tz) := by
      have hlt := pattern_lt x
      rw [hpeq', hpow_split] at hlt
      exact Nat.lt_of_mul_lt_mul_left hlt
    let q := 2 ^ (t.bits - tz) - (1 + 2 * m)
    have hq_pos : 0 < q := by omega
    have h2_even : 2 ^ (t.bits - tz) % 2 = 0 := by
      obtain ⟨k, hk⟩ : ∃ k, t.bits - tz = k + 1 := ⟨t.bits - tz - 1, by omega⟩
      rw [hk, Nat.pow_succ]
      omega
    have hq_odd : q % 2 = 1 := by omega
    have hx_abs : x.val.natAbs = 2 ^ tz * q := by
      dsimp only [q]
      rw [Nat.mul_sub_left_distrib, ← hpow_split, ← hpeq']
      omega
    refine ⟨q, hx_abs, hq_pos, hq_odd, ?_⟩
    rw [hshr_val, if_pos hneg]
    have hx_val : x.val = ((2 ^ tz : Nat) : Int) * (-(q : Int)) := by
      have h1 : (x.val.natAbs : Int) = -x.val := Int.ofNat_natAbs_of_nonpos (by omega)
      have h2 : (x.val.natAbs : Int) = ((2 ^ tz : Nat) : Int) * (q : Int) := by
        exact_mod_cast hx_abs
      rw [Int.mul_neg]
      omega
    rw [hx_val, Int.mul_ediv_cancel_left _ (by have := Nat.two_pow_pos tz; omega)]
  · have hx_nonneg : 0 ≤ x.val := by omega
    have hpat : pattern x = x.val.natAbs := by
      rw [pattern_of_nonneg x hx_nonneg]
      omega
    let q := 1 + 2 * m
    have hx_abs : x.val.natAbs = 2 ^ tz * q := by rw [← hpat, hpeq']
    refine ⟨q, hx_abs, by omega, by omega, ?_⟩
    rw [hshr_val, if_neg hneg]
    have hx_val : x.val = ((2 ^ tz : Nat) : Int) * (q : Int) := by
      have h1 : (x.val.natAbs : Int) = x.val := Int.natAbs_of_nonneg hx_nonneg
      have h2 : (x.val.natAbs : Int) = ((2 ^ tz : Nat) : Int) * (q : Int) := by
        exact_mod_cast hx_abs
      omega
    rw [hx_val, Int.mul_ediv_cancel_left _ (by have := Nat.two_pow_pos tz; omega)]

private theorem min_natAbs_even {t : IntTy} (hs : t.signed = true) :
    t.min.natAbs % 2 = 0 := by
  cases t <;> simp_all [IntTy.signed, IntTy.min, IntTy.bits] <;> decide

private theorem minBits_val {t : IntTy} (a b : JInt t) :
    (JuliaLean.base.intfuncs.minBits a b).val = min a.val b.val := by
  unfold JuliaLean.base.intfuncs.minBits JuliaLean.base.operators.min JuliaLean.base.int.ifelse
  rw [ltSame_eq]
  by_cases h : b.val < a.val <;> simp [h] <;> omega

private theorem coprime_two_pow_of_odd {q : Nat} (hq : q % 2 = 1) (k : Nat) :
    Nat.Coprime (2 ^ k) q := by
  apply Nat.Coprime.pow_left
  change Nat.gcd 2 q = 1
  rw [Nat.gcd_rec 2 q, hq, Nat.gcd_one_left]

private theorem gcd_two_pow_mul_odd (k a b : Nat) (hb : b % 2 = 1) :
    Nat.gcd (2 ^ k * a) b = Nat.gcd a b := by
  rw [Nat.gcd_comm, (coprime_two_pow_of_odd hb k).gcd_mul_left_cancel_right, Nat.gcd_comm]

private theorem gcd_odd_two_pow_mul (a k b : Nat) (ha : a % 2 = 1) :
    Nat.gcd a (2 ^ k * b) = Nat.gcd a b :=
  (coprime_two_pow_of_odd ha k).gcd_mul_left_cancel_right b

private theorem gcd_add_self_right (k m : Nat) : Nat.gcd (k + m) m = Nat.gcd k m := by
  rw [Nat.gcd_comm (k + m) m, Nat.gcd_rec m (k + m), Nat.add_mod_right, ← Nat.gcd_rec m k, Nat.gcd_comm]

private theorem gcd_absdiff_min (a b : Nat) :
    Nat.gcd (if a ≥ b then a - b else b - a) (min a b) = Nat.gcd a b := by
  by_cases h : a ≥ b
  · have hmin : min a b = b := Nat.min_eq_right h
    rw [if_pos h, hmin]
    have ha : a = (a - b) + b := (Nat.sub_add_cancel h).symm
    conv => rhs; rw [ha]
    exact (gcd_add_self_right (a - b) b).symm
  · have hle : a ≤ b := by omega
    have hmin : min a b = a := Nat.min_eq_left hle
    rw [if_neg h, hmin]
    have hb : b = (b - a) + a := (Nat.sub_add_cancel hle).symm
    rw [Nat.gcd_comm a b]
    conv => rhs; rw [hb]
    exact (gcd_add_self_right (b - a) a).symm

private theorem natAbs_sub_of_pos (x y : Int) (hx : 0 ≤ x) (hy : 0 ≤ y) :
    (x - y).natAbs = if x.natAbs ≥ y.natAbs then x.natAbs - y.natAbs else y.natAbs - x.natAbs := by
  split <;> omega

private theorem min_natAbs_of_nonneg (x y : Int) (hx : 0 ≤ x) (hy : 0 ≤ y) :
    (min x y).natAbs = min x.natAbs y.natAbs := by
  rw [Int.min_def, Nat.min_def]; split <;> split <;> omega

private theorem absdiff_plus_min_lt (x y : Nat) (hx : 0 < x) (hy : 0 < y) :
    (if x ≥ y then x - y else y - x) + min x y < x + y := by
  rw [Nat.min_def]; split <;> split <;> omega
private theorem absdiff_branch_spec {t : IntTy} (a' b : JInt t)
    (ha'_pos : 0 < a'.val) (hb_pos : 0 < b.val) :
    let pair := if t.signed then
        JuliaLean.base.intfuncs.absdiff_Signed JuliaLean.base.int.sub JuliaLean.base.int.abs a' b
      else
        JuliaLean.base.intfuncs.absdiff_Unsigned JuliaLean.base.intfuncs.maxBits
          JuliaLean.base.intfuncs.minBits JuliaLean.base.int.sub a' b
    pair.1.val = ((a'.val - b.val).natAbs : Int) ∧
      (pair.1.val ≠ 0 → pair.2.val ≠ 0 ∧ pair.2.val.natAbs = pair.1.val.natAbs) := by
  dsimp only
  by_cases hs : t.signed = true
  · simp only [hs, ↓reduceIte]
    have ha'_prop := a'.property
    have hb_prop := b.property
    have hmin0 := min_le_zero t
    have hsub_fits : JuliaLean.Proofs.base.intfuncs.fits t (a'.val - b.val) :=
      ⟨by have := max_lt_neg_min_of_signed hs; omega, by omega⟩
    have habs_fits : JuliaLean.Proofs.base.intfuncs.fits t ((a'.val - b.val).natAbs : Int) :=
      ⟨by omega, by omega⟩
    obtain ⟨h1, h2⟩ := (JuliaLean.Proofs.base.intfuncs.absDifferenceExact_proven).2.1
      t a' b hs hsub_fits habs_fits
    refine ⟨h1, fun hnz => ?_⟩
    rw [h1, h2] at *
    exact ⟨by omega, rfl⟩
  · have hu : t.signed = false := Bool.eq_false_iff.mpr hs
    simp only [hu, Bool.false_eq_true, ↓reduceIte]
    obtain ⟨h1, h2⟩ := (JuliaLean.Proofs.base.intfuncs.absDifferenceExact_proven).1 t a' b hu
    refine ⟨h1, fun hnz => ?_⟩
    rw [h1, h2] at *
    exact ⟨hnz, rfl⟩

private theorem shr_cttz_of_nonneg {t : IntTy} (absd d : JInt t)
    (habsd_nonneg : 0 ≤ absd.val) (habsd_nz : absd.val ≠ 0)
    (hd_nz : d.val ≠ 0) (hd_abs : d.val.natAbs = absd.val.natAbs) :
    let za' := (JuliaLean.base.int.cttz_int d).val.toNat
    za' < t.bits ∧ ∃ qa' : Nat, absd.val.natAbs = 2 ^ za' * qa' ∧
      0 < qa' ∧ qa' % 2 = 1 ∧
      (JuliaLean.base.int.shr_Int absd (JuliaLean.base.int.lit .i64 za')).val = (qa' : Int) := by
  dsimp only
  let za' := (JuliaLean.base.int.cttz_int d).val.toNat
  obtain ⟨htz_lt, qd, hqd_abs, hqd_pos, hqd_odd, _⟩ := cttz_factorization d hd_nz
  have habsd_fact : absd.val.natAbs = 2 ^ za' * qd := by rw [← hd_abs]; exact hqd_abs
  refine ⟨htz_lt, qd, habsd_fact, hqd_pos, hqd_odd, ?_⟩
  have hbits128 : t.bits ≤ 128 := by cases t <;> decide
  have hlit_za' : (JuliaLean.base.int.lit .i64 (za' : Int)).val = (za' : Int) := by
    rw [lit_val]
    exact wrapInt_of_inRange .i64 (za' : Int)
      (by simp [IntTy.min, IntTy.max, IntTy.signed, IntTy.bits]; omega)
  have hshr_val : (JuliaLean.base.int.shr_Int absd (JuliaLean.base.int.lit .i64 (za' : Int))).val =
      absd.val / ((2 ^ za' : Nat) : Int) := by
    have hsh := (shiftIntCount_proven t absd (JuliaLean.base.int.lit .i64 (za' : Int))).1
    simp only [hlit_za', Int.natCast_nonneg, ↓reduceIte, Int.toNat_natCast, Int.natCast_pow] at hsh ⊢
    exact hsh
  rw [hshr_val]
  have habsd_val : absd.val = ((2 ^ za' : Nat) : Int) * (qd : Int) := by
    rw [← Int.natAbs_of_nonneg habsd_nonneg]
    exact_mod_cast habsd_fact
  rw [habsd_val, Int.mul_ediv_cancel_left _ (by have := Nat.two_pow_pos za'; omega)]
private theorem binaryGcdLoop_spec {t : IntTy} (fuel : Nat) :
    ∀ (a b : JInt t) (za : Nat),
      0 ≤ a.val →
      0 < b.val →
      b.val.natAbs % 2 = 1 →
      a.val.natAbs + b.val.natAbs < fuel →
      (a.val ≠ 0 → za < t.bits ∧ ∃ qa : Nat, a.val.natAbs = 2 ^ za * qa ∧ 0 < qa ∧ qa % 2 = 1 ∧
        (JuliaLean.base.int.shr_Int a (JuliaLean.base.int.lit .i64 za)).val = (qa : Int)) →
      (JuliaLean.base.intfuncs.binaryGcdLoop fuel a b za).val =
        (Nat.gcd a.val.natAbs b.val.natAbs : Int) := by
  induction fuel with
  | zero =>
    intro _ _ _ _ _ _ hfuel _
    exact absurd hfuel (Nat.not_lt_zero _)
  | succ fuel ih =>
    intro a b za ha0 hb0 hodd_b hfuel hza
    unfold JuliaLean.base.intfuncs.binaryGcdLoop
    by_cases haz : a.val = 0
    · clear hza
      simp only [haz, ↓reduceIte, Int.natAbs_zero, Nat.gcd_zero_left]
      exact (Int.natAbs_of_nonneg (by omega)).symm
    · simp only [haz, ↓reduceIte]
      obtain ⟨hza_lt, qa, ha_abs, hqa_pos, hqa_odd, hshr⟩ := hza haz
      clear hza
      generalize ha'_eq : JuliaLean.base.int.shr_Int a (JuliaLean.base.int.lit .i64 za) = a'
      rw [ha'_eq] at hshr
      have ha'_pos : 0 < a'.val := by omega
      have ha'_abs : a'.val.natAbs = qa := by omega
      have ha'_le : a'.val.natAbs ≤ a.val.natAbs := by
        rw [ha_abs, ha'_abs]
        exact Nat.le_mul_of_pos_left _ (Nat.two_pow_pos za)
      have hpair := absdiff_branch_spec a' b ha'_pos hb0
      generalize hpair_eq : (if t.signed then
          JuliaLean.base.intfuncs.absdiff_Signed JuliaLean.base.int.sub JuliaLean.base.int.abs a' b
        else
          JuliaLean.base.intfuncs.absdiff_Unsigned JuliaLean.base.intfuncs.maxBits
            JuliaLean.base.intfuncs.minBits JuliaLean.base.int.sub a' b) = pair at hpair ⊢
      rcases pair with ⟨absd, d⟩
      dsimp only at hpair ⊢
      generalize hb'_eq : JuliaLean.base.intfuncs.minBits a' b = b'
      have hb'_val : b'.val = min a'.val b.val := by rw [← hb'_eq]; exact minBits_val a' b
      have hb'_pos : 0 < b'.val := by rw [hb'_val]; omega
      have hb'_odd : b'.val.natAbs % 2 = 1 := by
        rw [hb'_val, Int.min_def]
        by_cases hle : a'.val ≤ b.val
        · simp only [if_pos hle, ha'_abs]; exact hqa_odd
        · simp only [if_neg hle]; exact hodd_b
      have habsd_nonneg : 0 ≤ absd.val := by rw [hpair.1]; exact Int.natCast_nonneg _
      have habsd_abs : absd.val.natAbs =
          if a'.val.natAbs ≥ b.val.natAbs then a'.val.natAbs - b.val.natAbs
          else b.val.natAbs - a'.val.natAbs := by
        have h1 : absd.val.natAbs = (a'.val - b.val).natAbs := by
          have := hpair.1; omega
        rw [h1]
        exact natAbs_sub_of_pos a'.val b.val (by omega) (by omega)
      have hb'_abs : b'.val.natAbs = min a'.val.natAbs b.val.natAbs := by
        rw [hb'_val]
        exact min_natAbs_of_nonneg a'.val b.val (by omega) (by omega)
      have hsum_lt : absd.val.natAbs + b'.val.natAbs < a.val.natAbs + b.val.natAbs := by
        rw [habsd_abs, hb'_abs]
        have hlt1 := absdiff_plus_min_lt a'.val.natAbs b.val.natAbs (by omega) (by omega)
        omega
      have hgcd_eq : Nat.gcd absd.val.natAbs b'.val.natAbs = Nat.gcd a.val.natAbs b.val.natAbs := by
        rw [habsd_abs, hb'_abs, gcd_absdiff_min, ha_abs, ← ha'_abs,
          gcd_two_pow_mul_odd za a'.val.natAbs b.val.natAbs hodd_b]
      have hza' : absd.val ≠ 0 → (JuliaLean.base.int.cttz_int d).val.toNat < t.bits ∧
          ∃ qa' : Nat, absd.val.natAbs = 2 ^ (JuliaLean.base.int.cttz_int d).val.toNat * qa' ∧
          0 < qa' ∧ qa' % 2 = 1 ∧
          (JuliaLean.base.int.shr_Int absd
            (JuliaLean.base.int.lit .i64 (JuliaLean.base.int.cttz_int d).val.toNat)).val = (qa' : Int) :=
        fun habsd_nz => shr_cttz_of_nonneg absd d habsd_nonneg habsd_nz
          (hpair.2 habsd_nz).1 (hpair.2 habsd_nz).2
      rw [ih absd b' (JuliaLean.base.int.cttz_int d).val.toNat habsd_nonneg hb'_pos hb'_odd
        (by omega) hza', hgcd_eq]

theorem binaryGcd_val {t : IntTy} (ain bin : JInt t)
    (ha0 : ain.val ≠ 0) (hb0 : bin.val ≠ 0)
    (hmin : t.signed = true → ain.val ≠ t.min) :
    (JuliaLean.base.intfuncs.binaryGcd ain bin hb0 hmin).val =
      (Nat.gcd ain.val.natAbs bin.val.natAbs : Int) := by
  unfold JuliaLean.base.intfuncs.binaryGcd
  dsimp only
  obtain ⟨hza_lt, qa, hqa_abs, hqa_pos, hqa_odd, _⟩ := cttz_factorization ain ha0
  obtain ⟨hzb_lt, qb, hqb_abs, hqb_pos, hqb_odd, hshr_b⟩ := cttz_factorization bin hb0
  generalize hza_eq : (JuliaLean.base.int.cttz_int ain).val.toNat = za at hza_lt hqa_abs ⊢
  generalize hzb_eq : (JuliaLean.base.int.cttz_int bin).val.toNat = zb at hzb_lt hqb_abs hshr_b ⊢
  generalize ha_eq : JuliaLean.base.int.abs ain = a
  generalize hs_eq : JuliaLean.base.int.shr_Int bin (JuliaLean.base.int.lit .i64 zb) = s at hshr_b ⊢
  generalize hb_eq : JuliaLean.base.int.abs s = b
  have ha_val : a.val = (ain.val.natAbs : Int) := by
    rw [← ha_eq, abs_val, if_neg (fun ⟨hs, hm⟩ => hmin hs hm)]
  have ha_pos : 0 < a.val := by
    rw [ha_val]
    exact Int.natCast_pos.mpr (Int.natAbs_pos.mpr ha0)
  have ha_abs : a.val.natAbs = ain.val.natAbs := by omega
  have hs_abs : s.val.natAbs = qb := by
    by_cases hbn : bin.val < 0 <;> simp [hbn] at hshr_b <;> omega
  have hs_not_min : ¬ (t.signed = true ∧ s.val = t.min) := by
    rintro ⟨hs, hsm⟩
    have heven := min_natAbs_even hs
    rw [← hsm, hs_abs] at heven
    omega
  have hb_val : b.val = (qb : Int) := by
    rw [← hb_eq, abs_val, if_neg hs_not_min, hs_abs]
  have hb_pos : 0 < b.val := by omega
  have hb_abs : b.val.natAbs = qb := by omega
  have hb_odd : b.val.natAbs % 2 = 1 := by rw [hb_abs]; exact hqb_odd
  have hb_le : b.val.natAbs ≤ bin.val.natAbs := by
    rw [hb_abs, hqb_abs]
    exact Nat.le_mul_of_pos_left _ (Nat.two_pow_pos zb)
  have hza_a : a.val ≠ 0 → za < t.bits ∧ ∃ qa' : Nat, a.val.natAbs = 2 ^ za * qa' ∧
      0 < qa' ∧ qa' % 2 = 1 ∧
      (JuliaLean.base.int.shr_Int a (JuliaLean.base.int.lit .i64 za)).val = (qa' : Int) := by
    intro _
    refine ⟨hza_lt, qa, by rw [ha_abs]; exact hqa_abs, hqa_pos, hqa_odd, ?_⟩
    have hbits128 : t.bits ≤ 128 := by cases t <;> decide
    have hlit_za : (JuliaLean.base.int.lit .i64 (za : Int)).val = (za : Int) := by
      rw [lit_val]
      exact wrapInt_of_inRange .i64 (za : Int)
        (by simp [IntTy.min, IntTy.max, IntTy.signed, IntTy.bits]; omega)
    have hshr_val : (JuliaLean.base.int.shr_Int a (JuliaLean.base.int.lit .i64 (za : Int))).val =
        a.val / ((2 ^ za : Nat) : Int) := by
      have hsh := (shiftIntCount_proven t a (JuliaLean.base.int.lit .i64 (za : Int))).1
      simp only [hlit_za, Int.natCast_nonneg, ↓reduceIte, Int.toNat_natCast, Int.natCast_pow] at hsh ⊢
      exact hsh
    rw [hshr_val]
    have ha_eq2 : a.val = ((2 ^ za : Nat) : Int) * (qa : Int) := by
      rw [ha_val]
      exact_mod_cast hqa_abs
    rw [ha_eq2, Int.mul_ediv_cancel_left _ (by have := Nat.two_pow_pos za; omega)]
  have hloop := binaryGcdLoop_spec (ain.val.natAbs + bin.val.natAbs + 1) a b za
    (by omega) hb_pos hb_odd (by omega) hza_a
  have hgcd_loop : Nat.gcd a.val.natAbs b.val.natAbs = Nat.gcd qa qb := by
    rw [ha_abs, hqa_abs, hb_abs, gcd_two_pow_mul_odd za qa qb hqb_odd]
  generalize hk_eq : min za zb = k
  generalize hbout_eq : JuliaLean.base.intfuncs.binaryGcdLoop (ain.val.natAbs + bin.val.natAbs + 1) a b za = b_out at hloop ⊢
  have hb_out_val : b_out.val = (Nat.gcd qa qb : Int) := by
    rw [hloop, hgcd_loop]
  have hk_lt : k < t.bits := by rw [← hk_eq]; exact Nat.lt_of_le_of_lt (Nat.min_le_left za zb) hza_lt
  have hpat_k : pattern (JuliaLean.base.int.lit .i64 (k : Int)) = k := by
    have hbits128 : t.bits ≤ 128 := by cases t <;> decide
    have hlit_k : (JuliaLean.base.int.lit .i64 (k : Int)).val = (k : Int) := by
      rw [lit_val]
      exact wrapInt_of_inRange .i64 (k : Int)
        (by simp [IntTy.min, IntTy.max, IntTy.signed, IntTy.bits]; omega)
    rw [pattern_of_nonneg _ (by rw [hlit_k]; exact Int.natCast_nonneg _), hlit_k, Int.toNat_natCast]
  have hgcd_total : 2 ^ k * Nat.gcd qa qb = Nat.gcd ain.val.natAbs bin.val.natAbs := by
    rw [hqa_abs, hqb_abs]
    by_cases hle : za ≤ zb
    · have hk : k = za := by rw [← hk_eq]; exact Nat.min_eq_left hle
      have hzb_split : 2 ^ zb * qb = 2 ^ za * (2 ^ (zb - za) * qb) := by
        rw [← Nat.mul_assoc, ← Nat.pow_add, Nat.add_sub_of_le hle]
      rw [hk, hzb_split, Nat.gcd_mul_left, gcd_odd_two_pow_mul qa (zb - za) qb hqa_odd]
    · have hle' : zb ≤ za := by omega
      have hk : k = zb := by rw [← hk_eq]; exact Nat.min_eq_right hle'
      have hza_split : 2 ^ za * qa = 2 ^ zb * (2 ^ (za - zb) * qa) := by
        rw [← Nat.mul_assoc, ← Nat.pow_add, Nat.add_sub_of_le hle']
      rw [hk, hza_split, Nat.gcd_mul_left, gcd_two_pow_mul_odd (za - zb) qa qb hqb_odd]
  have hgcd_le_max : (Nat.gcd ain.val.natAbs bin.val.natAbs : Int) ≤ t.max := by
    have hdvd : Nat.gcd ain.val.natAbs bin.val.natAbs ≤ ain.val.natAbs :=
      Nat.gcd_le_left bin.val.natAbs (Int.natAbs_pos.mpr ha0)
    have hain_prop := ain.property
    by_cases hs : t.signed = true
    · have hne_min := hmin hs
      have hmax_eq := max_lt_neg_min_of_signed hs
      omega
    · have hu : t.signed = false := Bool.eq_false_iff.mpr hs
      have := nonneg_of_unsigned hu ain
      omega
  change (JuliaLean.base.int.remT t (JuliaLean.base.int.shl_int b_out (JuliaLean.base.int.lit .i64 k))).val = _
  rw [remT_val, shl_int_val, wrapInt_wrapInt, hpat_k, hb_out_val]
  have hprod_eq : (Nat.gcd qa qb : Int) * (2 : Int) ^ k =
      (Nat.gcd ain.val.natAbs bin.val.natAbs : Int) := by
    rw [Int.mul_comm]
    exact_mod_cast hgcd_total
  rw [hprod_eq]
  exact wrapInt_of_inRange t _ ⟨Int.le_trans (min_le_zero t) (Int.natCast_nonneg _), hgcd_le_max⟩

theorem gcd_BitInteger_exact {t : IntTy} (a b : JInt t) :
    let g : Int := Nat.gcd a.val.natAbs b.val.natAbs
    (t.min ≤ g ∧ g ≤ t.max →
      ∃ r, JuliaLean.base.intfuncs.gcd_BitInteger a b = .ok r ∧ r.val = g) ∧
    (¬ (t.min ≤ g ∧ g ≤ t.max) →
      ∃ msg, JuliaLean.base.intfuncs.gcd_BitInteger a b = .error (.overflowError msg)) := by
  intro g
  unfold JuliaLean.base.intfuncs.gcd_BitInteger
  by_cases ha : a.val = 0
  · rw [dif_pos ha]
    have hg : g = if b.val < 0 then -b.val else b.val := by
      dsimp only [g]
      rw [ha, Int.natAbs_zero, Nat.gcd_zero_left]
      omega
    have habs := JuliaLean.Proofs.base.checked.absExact t b
    unfold JuliaLean.Proofs.base.checked.ExactOrOverflow at habs
    rw [← hg] at habs
    by_cases hfit : t.min ≤ g ∧ g ≤ t.max
    · simp only [if_pos hfit] at habs
      exact ⟨fun _ => habs, fun h => absurd hfit h⟩
    · simp only [if_neg hfit] at habs
      refine ⟨fun h => absurd h hfit, fun _ => ?_⟩
      cases hcall : JuliaLean.base.checked.checkedAbsBits b with
      | ok _ => rw [hcall] at habs; contradiction
      | error e =>
        rw [hcall] at habs
        cases e <;> first | contradiction | exact ⟨_, rfl⟩
  · rw [dif_neg ha]
    by_cases hb : b.val = 0
    · rw [dif_pos hb]
      have hg : g = if a.val < 0 then -a.val else a.val := by
        dsimp only [g]
        rw [hb, Int.natAbs_zero, Nat.gcd_zero_right]
        omega
      have habs := JuliaLean.Proofs.base.checked.absExact t a
      unfold JuliaLean.Proofs.base.checked.ExactOrOverflow at habs
      rw [← hg] at habs
      by_cases hfit : t.min ≤ g ∧ g ≤ t.max
      · simp only [if_pos hfit] at habs
        exact ⟨fun _ => habs, fun h => absurd hfit h⟩
      · simp only [if_neg hfit] at habs
        refine ⟨fun h => absurd h hfit, fun _ => ?_⟩
        cases hcall : JuliaLean.base.checked.checkedAbsBits a with
        | ok _ => rw [hcall] at habs; contradiction
        | error e =>
          rw [hcall] at habs
          cases e <;> first | contradiction | exact ⟨_, rfl⟩
    · rw [dif_neg hb]
      by_cases hm : t.signed = true ∧ a.val = t.min
      · rw [dif_pos hm]
        by_cases he : a.val = b.val
        · rw [dif_pos he]
          have hnot_fit : ¬ (t.min ≤ g ∧ g ≤ t.max) := by
            dsimp only [g]
            rw [← he, Nat.gcd_self, hm.2]
            have := max_lt_neg_min_of_signed hm.1
            have := min_le_zero t
            omega
          exact ⟨fun h => absurd h hnot_fit, fun _ => ⟨"", rfl⟩⟩
        · rw [dif_neg he]
          have hb_not_min : t.signed = true → b.val ≠ t.min :=
            fun _ h => he (hm.2.trans h.symm)
          have hval := binaryGcd_val b a hb ha hb_not_min
          rw [Nat.gcd_comm] at hval
          let r := JuliaLean.base.intfuncs.binaryGcd b a ha hb_not_min
          have hfit : t.min ≤ g ∧ g ≤ t.max := by
            dsimp only [g]
            rw [← hval]
            exact r.property
          exact ⟨fun _ => ⟨r, rfl, hval⟩, fun h => absurd hfit h⟩
      · rw [dif_neg hm]
        have ha_not_min : t.signed = true → a.val ≠ t.min :=
          fun hs h => hm ⟨hs, h⟩
        have hval := binaryGcd_val a b ha hb ha_not_min
        let r := JuliaLean.base.intfuncs.binaryGcd a b hb ha_not_min
        have hfit : t.min ≤ g ∧ g ≤ t.max := by
          dsimp only [g]
          rw [← hval]
          exact r.property
        exact ⟨fun _ => ⟨r, rfl, hval⟩, fun h => absurd hfit h⟩

theorem lcmBits_exact {t : IntTy} (a b : JInt t) :
    let l : Int := Nat.lcm a.val.natAbs b.val.natAbs
    (t.min ≤ l ∧ l ≤ t.max →
      ∃ r, JuliaLean.base.intfuncs.lcmBits a b = .ok r ∧ r.val = l) ∧
    (¬ (t.min ≤ l ∧ l ≤ t.max) →
      ∃ msg, JuliaLean.base.intfuncs.lcmBits a b = .error (.overflowError msg)) := by
  intro l
  unfold JuliaLean.base.intfuncs.lcmBits JuliaLean.base.intfuncs.lcm_Integer
    JuliaLean.base.intfuncs.bitsOps JuliaLean.base.intfuncs.bitOps
  dsimp only
  by_cases h0 : a.val = 0 ∨ b.val = 0
  · simp only [h0, ↓reduceIte]
    have hl0 : l = 0 := by
      dsimp only [l]
      rcases h0 with ha | hb
      · rw [ha, Int.natAbs_zero, Nat.lcm_zero_left]; rfl
      · rw [hb, Int.natAbs_zero, Nat.lcm_zero_right]; rfl
    have hfit0 : t.min ≤ l ∧ l ≤ t.max := by
      rw [hl0]; exact ⟨min_le_zero t, zero_le_max t⟩
    have hlit0 : (JuliaLean.base.int.lit t 0).val = 0 := by
      rw [lit_val]; exact wrapInt_of_inRange t 0 ⟨min_le_zero t, zero_le_max t⟩
    exact ⟨fun _ => ⟨JuliaLean.base.int.lit t 0, rfl, hlit0.trans hl0.symm⟩,
      fun h => absurd hfit0 h⟩
  · simp only [h0, ↓reduceIte]
    have ha0 : a.val ≠ 0 := fun h => h0 (Or.inl h)
    have hb0 : b.val ≠ 0 := fun h => h0 (Or.inr h)
    have hgcd := gcd_BitInteger_exact b a
    let gNat := Nat.gcd b.val.natAbs a.val.natAbs
    have hg_pos : 0 < gNat := Nat.gcd_pos_of_pos_left _ (Int.natAbs_pos.mpr hb0)
    by_cases hg_fit : t.min ≤ (gNat : Int) ∧ (gNat : Int) ≤ t.max
    · obtain ⟨d, hd_ok, hd_val⟩ := hgcd.1 hg_fit
      simp only [hd_ok, Bind.bind, Except.bind]
      have hd_pos : 0 < d.val := by rw [hd_val]; exact Int.natCast_pos.mpr hg_pos
      have hdiv_no_err : ¬ (d.val = 0 ∨ (t.signed = true ∧ b.val = t.min ∧ d.val = -1)) := by omega
      have hdiv_eq := divSame_eq b d
      rw [if_neg hdiv_no_err] at hdiv_eq
      simp only [hdiv_eq, Bind.bind, Except.bind]
      generalize hq_eq : JuliaLean.base.int.lit t (b.val.tdiv d.val) = q
      have hq_val : q.val = b.val.tdiv (gNat : Int) := by
        rw [← hq_eq, lit_of_fits (tdiv_fits b d (by omega) (by omega)), hd_val]
      have hq_abs : q.val.natAbs = b.val.natAbs / gNat := by
        rw [hq_val, Int.natAbs_tdiv, Int.natAbs_natCast]
        rfl
      have hl_abs : (a.val * q.val).natAbs = Nat.lcm a.val.natAbs b.val.natAbs := by
        rw [Int.natAbs_mul, hq_abs, Nat.lcm]
        have hdvd : gNat ∣ b.val.natAbs := Nat.gcd_dvd_left b.val.natAbs a.val.natAbs
        have hmul_div : a.val.natAbs * (b.val.natAbs / gNat) =
            (a.val.natAbs * b.val.natAbs) / gNat :=
          (Nat.mul_div_assoc a.val.natAbs hdvd).symm
        rw [hmul_div]
        congr 1
        exact Nat.gcd_comm b.val.natAbs a.val.natAbs
      have hmul := JuliaLean.Proofs.base.checked.mulExact t a q
      unfold JuliaLean.Proofs.base.checked.ExactOrOverflow at hmul
      by_cases hmul_fit : t.min ≤ a.val * q.val ∧ a.val * q.val ≤ t.max
      · simp only [if_pos hmul_fit] at hmul
        obtain ⟨prod, hprod_ok, hprod_val⟩ := hmul
        rw [hprod_ok]; dsimp only
        have habs := JuliaLean.Proofs.base.checked.absExact t prod
        unfold JuliaLean.Proofs.base.checked.ExactOrOverflow at habs
        have habs_eq : (if prod.val < 0 then -prod.val else prod.val) = l := by
          dsimp only [l]
          rw [← hl_abs, ← hprod_val]
          omega
        rw [habs_eq] at habs
        by_cases hl_fit : t.min ≤ l ∧ l ≤ t.max
        · simp only [if_pos hl_fit] at habs
          exact ⟨fun _ => habs, fun h => absurd hl_fit h⟩
        · simp only [if_neg hl_fit] at habs
          refine ⟨fun h => absurd h hl_fit, fun _ => ?_⟩
          cases hcall : JuliaLean.base.checked.checkedAbsBits prod with
          | ok _ => rw [hcall] at habs; contradiction
          | error e =>
            rw [hcall] at habs
            cases e <;> first | contradiction | exact ⟨_, rfl⟩
      · simp only [if_neg hmul_fit] at hmul
        have hnot_l_fit : ¬ (t.min ≤ l ∧ l ≤ t.max) := by
          intro ⟨_, hl_max⟩
          apply hmul_fit
          have hl_eq : l = ((a.val * q.val).natAbs : Int) := by
            dsimp only [l]; rw [← hl_abs]
          by_cases hs : t.signed = true
          · have hmin_eq := max_lt_neg_min_of_signed hs
            omega
          · have hu : t.signed = false := Bool.eq_false_iff.mpr hs
            have hmin0 := min_eq_zero_of_unsigned hu
            have ha_nn := nonneg_of_unsigned hu a
            have hq_nn := nonneg_of_unsigned hu q
            have hprod_nn : 0 ≤ a.val * q.val := Int.mul_nonneg ha_nn hq_nn
            omega
        refine ⟨fun h => absurd h hnot_l_fit, fun _ => ?_⟩
        cases hcall : JuliaLean.base.checked.checkedMulBits a q with
        | ok _ => rw [hcall] at hmul; contradiction
        | error e =>
          rw [hcall] at hmul
          cases e <;> first | contradiction | exact ⟨_, rfl⟩
    · obtain ⟨msg, hd_err⟩ := hgcd.2 hg_fit
      simp only [hd_err, Bind.bind, Except.bind]
      have hnot_l_fit : ¬ (t.min ≤ l ∧ l ≤ t.max) := by
        intro ⟨_, hl_max⟩
        apply hg_fit
        refine ⟨Int.le_trans (min_le_zero t) (Int.natCast_nonneg _), ?_⟩
        have hdvd_lcm : gNat ∣ Nat.lcm a.val.natAbs b.val.natAbs :=
          Nat.dvd_trans (Nat.gcd_dvd_right b.val.natAbs a.val.natAbs)
            (Nat.dvd_lcm_left a.val.natAbs b.val.natAbs)
        have hpos_lcm : 0 < Nat.lcm a.val.natAbs b.val.natAbs :=
          Nat.lcm_pos (Int.natAbs_pos.mpr ha0) (Int.natAbs_pos.mpr hb0)
        have hle_lcm : gNat ≤ Nat.lcm a.val.natAbs b.val.natAbs :=
          Nat.le_of_dvd hpos_lcm hdvd_lcm
        dsimp only [l] at hl_max
        omega
      exact ⟨fun h => absurd h hnot_l_fit, fun _ => ⟨msg, rfl⟩⟩

end CoreLemmas

namespace DivGcdCtorLemmas

open JuliaLean JuliaLean.Promotion JuliaLean.base.rational
open JuliaLean.Proofs.base.int
open JuliaLean.Proofs.base.rational.CoreLemmas

set_option maxRecDepth 4096

/-! ## `unsignedDivide`, `divideByUnsigned`, and `dg` (`divgcdSource`) -/

@[simp] theorem unsafeRationalTypeSource_id {T : Type} (n d : T) :
    unsafeRationalTypeSource T (m := Id) id id n d = ⟨n, d⟩ := rfl

@[simp] theorem unsafeRationalSameSource_pair {T : Type} (n d : T) :
    unsafeRationalSameSource n d = ⟨n, d⟩ := rfl

def unsignedDivide : JuliaLean.base.int.BinOpJl := fun x y =>
  let (a, b) := JuliaLean.base.int.promoteSameSign x y
  JuliaLean.base.int.divSame a b
def divideByUnsigned {t u : IntTy} (x : JInt t) (g : Jl (JInt u)) : Jl (JInt t) := do
  let g ← g
  if t.signed then
    let q ← JuliaLean.base.int.div_BitSigned_Unsigned unsignedDivide x g
    JInt.convert (t.name) t q.val
  else
    let q ← unsignedDivide x g
    JInt.convert (t.name) t q.val

theorem unsignedDivide_spec : UnsignedDivSpec unsignedDivide := by
  intro a b ha hb x y
  unfold unsignedDivide
  dsimp only [JuliaLean.base.int.promoteSameSign]
  have hp_u : (a.promote b).signed = false := promote_unsigned ha hb
  have hx_val : (JuliaLean.base.int.widenTo (a.promote b) x).val = x.val := by
    rw [widenTo_val, widen_promote_left (ha.trans hb.symm)]
  have hy_val : (JuliaLean.base.int.widenTo (a.promote b) y).val = y.val := by
    rw [widenTo_val, widen_promote_right (ha.trans hb.symm)]
  rw [divSame_eq, hx_val, hy_val]
  have hnot_signed : ¬ ((a.promote b).signed = true ∧ x.val = (a.promote b).min ∧ y.val = -1) := by
    simp [hp_u]
  have hx0 : 0 ≤ x.val := nonneg_of_unsigned ha x
  rw [Int.tdiv_eq_ediv_of_nonneg hx0]
  by_cases hy0 : y.val = 0 <;> simp [hy0, hnot_signed]

theorem divideByUnsigned_ok_spec {t u : IntTy} (hu : u.signed = false)
    (x : JInt t) (g : JInt u) :
    (g.val = 0 → divideByUnsigned x (.ok g) = .error .divideError) ∧
    (g.val ≠ 0 → ∃ q : JInt t, divideByUnsigned x (.ok g) = .ok q ∧
      q.val = x.val.tdiv g.val) := by
  unfold divideByUnsigned
  dsimp only [Bind.bind, Except.bind]
  have hg_nonneg : 0 ≤ g.val := nonneg_of_unsigned hu g
  by_cases hs : t.signed = true
  · simp only [hs, ↓reduceIte]
    obtain ⟨z, hform, hz_val⟩ := div_BitSigned_Unsigned_form unsignedDivide unsignedDivide_spec hs hu x g
    rw [hform]
    refine ⟨fun hg0 => by simp [hg0], fun hg0 => ?_⟩
    simp only [if_neg hg0]
    have hzv : z.val = x.val.tdiv g.val := hz_val hg0
    have hg_pos : 0 < g.val := by omega
    have hfit : t.min ≤ x.val.tdiv g.val ∧ x.val.tdiv g.val ≤ t.max :=
      fits_between x (tdiv_between x.val g.val hg_pos)
    rw [hzv, convert_of_fits hfit]
    exact ⟨⟨x.val.tdiv g.val, hfit⟩, rfl, rfl⟩
  · have ht_u : t.signed = false := Bool.eq_false_iff.mpr hs
    simp only [ht_u, Bool.false_eq_true, ↓reduceIte]
    have hud : unsignedDivide x g = _ := unsignedDivide_spec t u ht_u hu x g
    rw [hud]
    refine ⟨fun hg0 => by simp [hg0], fun hg0 => ?_⟩
    simp only [if_neg hg0]
    have hg_pos : 0 < g.val := by omega
    have hx0 : 0 ≤ x.val := nonneg_of_unsigned ht_u x
    have hfit_p : fits (t.promote u) (x.val / g.val) := by
      have hp_u : (t.promote u).signed = false := promote_unsigned ht_u hu
      have hmin0 : (t.promote u).min = 0 := min_eq_zero_of_unsigned hp_u
      have hmax_le : t.max ≤ (t.promote u).max := max_le_promote_left t u
      have hx_prop := x.property
      have hdiv_le : x.val / g.val ≤ x.val := Int.ediv_le_self g.val hx0
      have hdiv_nn : 0 ≤ x.val / g.val := Int.ediv_nonneg hx0 hg_nonneg
      exact ⟨by omega, by omega⟩
    have hlit_val : (JuliaLean.base.int.lit (t.promote u) (x.val / g.val)).val = x.val.tdiv g.val := by
      rw [lit_of_fits hfit_p, Int.tdiv_eq_ediv_of_nonneg hx0]
    have hfit_t : t.min ≤ x.val.tdiv g.val ∧ x.val.tdiv g.val ≤ t.max :=
      fits_between x (tdiv_between x.val g.val hg_pos)
    rw [hlit_val, convert_of_fits hfit_t]
    exact ⟨⟨x.val.tdiv g.val, hfit_t⟩, rfl, rfl⟩

def dgBits {t s : IntTy} : JInt t → JInt s → Jl (JInt t × JInt s) :=
  divgcdSource JuliaLean.base.float.uabs JuliaLean.base.float.uabs
    (fun a b => let (a, b) := JuliaLean.base.int.promoteSameSign a b
                JuliaLean.base.intfuncs.gcd_BitInteger a b)
    divideByUnsigned divideByUnsigned

private theorem tdiv_natAbs_of_dvd (x : Int) (g : Nat) (_hdvd : g ∣ x.natAbs) :
    (x.tdiv (g : Int)).natAbs = x.natAbs / g := by
  rw [Int.natAbs_tdiv, Int.natAbs_natCast]
  rfl

theorem tdiv_mul_cancel_of_dvd (x : Int) (g : Nat) (hdvd : g ∣ x.natAbs) :
    x.tdiv (g : Int) * (g : Int) = x := by
  have hmod_abs : (x.tmod (g : Int)).natAbs = 0 := by
    rw [Int.natAbs_tmod, Int.natAbs_natCast]
    exact Nat.mod_eq_zero_of_dvd hdvd
  have hmod0 : x.tmod (g : Int) = 0 := Int.natAbs_eq_zero.mp hmod_abs
  have h := Int.mul_tdiv_add_tmod x (g : Int)
  rw [Int.mul_comm, hmod0, Int.add_zero] at h
  exact h
theorem intSign_tdiv_pos (x : Int) (g : Nat) (hg : 0 < g) (hdvd : g ∣ x.natAbs) :
    intSign (x.tdiv (g : Int)) = intSign x := by
  have hmul := tdiv_mul_cancel_of_dvd x g hdvd
  have hg_int : (0 : Int) < (g : Int) := Int.natCast_pos.mpr hg
  unfold intSign
  by_cases h1 : x.tdiv (g : Int) < 0
  · have hx_neg : x < 0 := by
      rw [← hmul]
      exact Int.mul_neg_of_neg_of_pos h1 hg_int
    simp [h1, hx_neg]
  · by_cases h2 : x.tdiv (g : Int) > 0
    · have hx_pos : x > 0 := by
        rw [← hmul]
        exact Int.mul_pos h2 hg_int
      simp [h1, h2, hx_pos, show ¬ x < 0 by omega]
    · have hq0 : x.tdiv (g : Int) = 0 := by omega
      have hx0 : x = 0 := by rw [← hmul, hq0, Int.zero_mul]
      simp [hx0]
theorem dgBits_spec {t s : IntTy} (x : JInt t) (y : JInt s) :
    let gNat := Nat.gcd x.val.natAbs y.val.natAbs
    let g : Int := gNat
    (g = 0 → dgBits x y = .error .divideError) ∧
    (g ≠ 0 → ∃ a b, dgBits x y = .ok (a, b) ∧
      a.val = x.val.tdiv g ∧
      b.val = y.val.tdiv g ∧
      a.val.natAbs = x.val.natAbs / gNat ∧
      b.val.natAbs = y.val.natAbs / gNat ∧
      Nat.gcd a.val.natAbs b.val.natAbs = 1 ∧
      a.val * g = x.val ∧
      b.val * g = y.val ∧
      a.val * y.val = x.val * b.val ∧
      intSign a.val = intSign x.val ∧
      intSign b.val = intSign y.val) := by
  intro gNat g
  unfold dgBits divgcdSource
  dsimp only [JuliaLean.base.int.promoteSameSign]
  let u := t.toUnsigned.promote s.toUnsigned
  have htu : t.toUnsigned.signed = false := toUnsigned_signed t
  have hsu : s.toUnsigned.signed = false := toUnsigned_signed s
  have hu : u.signed = false := promote_unsigned htu hsu
  generalize hax_eq : JuliaLean.base.int.widenTo u (JuliaLean.base.float.uabs x) = ax
  generalize hby_eq : JuliaLean.base.int.widenTo u (JuliaLean.base.float.uabs y) = by_
  have hax_val : ax.val = (x.val.natAbs : Int) := by
    rw [← hax_eq, widenTo_val, widen_promote_left (htu.trans hsu.symm), uabs_val]
  have hby_val : by_.val = (y.val.natAbs : Int) := by
    rw [← hby_eq, widenTo_val, widen_promote_right (htu.trans hsu.symm), uabs_val]
  have hax_abs : ax.val.natAbs = x.val.natAbs := by omega
  have hby_abs : by_.val.natAbs = y.val.natAbs := by omega
  have hgcd_eq : Nat.gcd ax.val.natAbs by_.val.natAbs = gNat := by
    rw [hax_abs, hby_abs]
  have hg_fit : u.min ≤ g ∧ g ≤ u.max := by
    refine ⟨Int.le_trans (min_le_zero u) (Int.natCast_nonneg _), ?_⟩
    by_cases hx0 : x.val.natAbs = 0
    · have hg_eq : gNat = y.val.natAbs := by dsimp [gNat]; rw [hx0, Nat.gcd_zero_left]
      have hy_prop := by_.property.2
      dsimp [g]
      omega
    · have hdvd : gNat ≤ x.val.natAbs := Nat.gcd_le_left y.val.natAbs (Nat.pos_of_ne_zero hx0)
      have hx_prop := ax.property.2
      dsimp [g]
      omega
  have hgcd_spec := (gcd_BitInteger_exact ax by_).1 (by rw [hgcd_eq]; exact hg_fit)
  obtain ⟨gJ, hgJ_ok, hgJ_val⟩ := hgcd_spec
  rw [hgcd_eq] at hgJ_val
  have hdiv_x := divideByUnsigned_ok_spec hu x gJ
  have hdiv_y := divideByUnsigned_ok_spec hu y gJ
  rw [hgJ_ok]
  refine ⟨fun hg0 => ?_, fun hg0 => ?_⟩
  · have hgJ0 : gJ.val = 0 := hgJ_val.trans hg0
    simp only [hdiv_x.1 hgJ0, Bind.bind, Except.bind]
  · have hgJ_nz : gJ.val ≠ 0 := by rw [hgJ_val]; exact hg0
    obtain ⟨qx, hqx_ok, hqx_val⟩ := hdiv_x.2 hgJ_nz
    obtain ⟨qy, hqy_ok, hqy_val⟩ := hdiv_y.2 hgJ_nz
    clear hdiv_x hdiv_y
    rw [hgJ_val] at hqx_val hqy_val
    simp only [hqx_ok, hqy_ok, Bind.bind, Except.bind, Pure.pure, Except.pure]
    have hgNat_pos : 0 < gNat := Decidable.byContradiction fun hle => by
      apply hg0
      dsimp [g]
      omega
    have hdvd_x : gNat ∣ x.val.natAbs := Nat.gcd_dvd_left x.val.natAbs y.val.natAbs
    have hdvd_y : gNat ∣ y.val.natAbs := Nat.gcd_dvd_right x.val.natAbs y.val.natAbs
    have hqx_abs : qx.val.natAbs = x.val.natAbs / gNat := by
      rw [hqx_val]; exact tdiv_natAbs_of_dvd x.val gNat hdvd_x
    have hqy_abs : qy.val.natAbs = y.val.natAbs / gNat := by
      rw [hqy_val]; exact tdiv_natAbs_of_dvd y.val gNat hdvd_y
    have hcoprime : Nat.gcd qx.val.natAbs qy.val.natAbs = 1 := by
      rw [hqx_abs, hqy_abs]
      by_cases hx_pos : 0 < x.val.natAbs
      · exact Nat.gcd_div_gcd_div_gcd_of_pos_left hx_pos
      · have hx0 : x.val.natAbs = 0 := by omega
        have hy_pos : 0 < y.val.natAbs := Decidable.byContradiction fun hy0 => by
          have hy0' : y.val.natAbs = 0 := by omega
          have : gNat = 0 := by dsimp [gNat]; rw [hx0, hy0']; rfl
          omega
        exact Nat.gcd_div_gcd_div_gcd_of_pos_right hy_pos
    have hmul_x : qx.val * g = x.val := by
      rw [hqx_val]; exact tdiv_mul_cancel_of_dvd x.val gNat hdvd_x
    have hmul_y : qy.val * g = y.val := by
      rw [hqy_val]; exact tdiv_mul_cancel_of_dvd y.val gNat hdvd_y
    have hcross : qx.val * y.val = x.val * qy.val := by
      calc qx.val * y.val = qx.val * (qy.val * g) := by rw [hmul_y]
        _ = (qx.val * g) * qy.val := by rw [← Int.mul_assoc, Int.mul_right_comm qx.val qy.val g]
        _ = x.val * qy.val := by rw [hmul_x]
    have hsign_x : intSign qx.val = intSign x.val := by
      rw [hqx_val]; exact intSign_tdiv_pos x.val gNat hgNat_pos hdvd_x
    have hsign_y : intSign qy.val = intSign y.val := by
      rw [hqy_val]; exact intSign_tdiv_pos y.val gNat hgNat_pos hdvd_y
    exact ⟨qx, qy, rfl, hqx_val, hqy_val, hqx_abs, hqy_abs, hcoprime,
      hmul_x, hmul_y, hcross, hsign_x, hsign_y⟩

/-! ## `checkedDenTypeSource` Specification -/

theorem checkedDenBits_spec {t : IntTy} (ops : RatIntOps (JInt t))
    (hsign : ops.signbit = (jintOps t).signbit)
    (hneg : ops.checkedNeg = (jintOps t).checkedNeg)
    (n d : JInt t) :
    (0 ≤ d.val →
      checkedDenTypeSource (JInt t) ops n d = .ok ⟨n, d⟩) ∧
    (d.val < 0 → (t.min ≤ -d.val ∧ -d.val ≤ t.max) → (t.min ≤ -n.val ∧ -n.val ≤ t.max) →
      ∃ q, checkedDenTypeSource (JInt t) ops n d = .ok q ∧
        0 < q.den.val ∧ q.num.val = -n.val ∧ q.den.val = -d.val) ∧
    (d.val < 0 → (¬ (t.min ≤ -d.val ∧ -d.val ≤ t.max) ∨ ¬ (t.min ≤ -n.val ∧ -n.val ≤ t.max)) →
      ∃ msg, checkedDenTypeSource (JInt t) ops n d = .error (.overflowError msg)) := by
  unfold checkedDenTypeSource
  rw [hsign, hneg]
  dsimp only [jintOps, JuliaLean.base.rational.checkedNeg]
  refine ⟨fun hd0 => ?_, fun hdn hfit_d hfit_n => ?_, fun hdn hnot_fit => ?_⟩
  · have hsb : decide (d.val < 0) = false := decide_eq_false (by omega)
    simp [hsb, Pure.pure, Except.pure]
  · have hsb : decide (d.val < 0) = true := decide_eq_true hdn
    simp only [hsb, ↓reduceIte]
    have hneg_d := JuliaLean.Proofs.base.checked.negExact t d
    have hneg_n := JuliaLean.Proofs.base.checked.negExact t n
    unfold JuliaLean.Proofs.base.checked.ExactOrOverflow at hneg_d hneg_n
    simp only [if_pos hfit_d] at hneg_d
    simp only [if_pos hfit_n] at hneg_n
    obtain ⟨d', hd'_ok, hd'_val⟩ := hneg_d
    obtain ⟨n', hn'_ok, hn'_val⟩ := hneg_n
    simp only [hd'_ok, hn'_ok, Bind.bind, Except.bind, Pure.pure, Except.pure,
      unsafeRationalTypeSource_id]
    exact ⟨⟨n', d'⟩, rfl, by dsimp; omega, hn'_val, hd'_val⟩
  · have hsb : decide (d.val < 0) = true := decide_eq_true hdn
    simp only [hsb, ↓reduceIte]
    have hneg_d := JuliaLean.Proofs.base.checked.negExact t d
    unfold JuliaLean.Proofs.base.checked.ExactOrOverflow at hneg_d
    by_cases hfit_d : t.min ≤ -d.val ∧ -d.val ≤ t.max
    · simp only [if_pos hfit_d] at hneg_d
      obtain ⟨d', hd'_ok, _⟩ := hneg_d
      simp only [hd'_ok, Bind.bind, Except.bind]
      have hnot_n : ¬ (t.min ≤ -n.val ∧ -n.val ≤ t.max) := by
        rcases hnot_fit with hd_bad | hn_bad
        · exact absurd hfit_d hd_bad
        · exact hn_bad
      have hneg_n := JuliaLean.Proofs.base.checked.negExact t n
      unfold JuliaLean.Proofs.base.checked.ExactOrOverflow at hneg_n
      simp only [if_neg hnot_n] at hneg_n
      cases hcall : JuliaLean.base.checked.checkedNegBits n with
      | ok _ => rw [hcall] at hneg_n; contradiction
      | error e =>
        rw [hcall] at hneg_n
        cases e <;> first | contradiction | exact ⟨_, rfl⟩
    · simp only [if_neg hfit_d] at hneg_d
      cases hcall : JuliaLean.base.checked.checkedNegBits d with
      | ok _ => rw [hcall] at hneg_d; contradiction
      | error e =>
        rw [hcall] at hneg_d
        cases e <;> first | contradiction | exact ⟨_, rfl⟩

/-! ## `constructSource` and `rationalSameSource` Specifications -/

def ctorBits (t n d : IntTy) : JInt n → JInt d → (Type → (JInt n × JInt d) → JlError) → Jl (Rat t) :=
  constructSource (JInt t) (jintOps t)
    (jintOps n).iszero (jintOps d).iszero (jintOps n).signbit (jintOps d).signbit
    JuliaLean.base.float.uabs JuliaLean.base.float.uabs
    dgBits
    (fun x => JInt.convert (t.name) t x.val) (fun x => JInt.convert (t.name) t x.val)
    dgBits
    (fun x => JInt.convert (t.name) t x.val) (fun x => JInt.convert (t.name) t x.val) Prod.mk

def rationalBits (t : IntTy) : JInt t → JInt t → Jl (Rat t) :=
  rationalSameSource (jintOps t) JuliaLean.base.float.uabs
    dgBits (fun x => JInt.convert (t.name) t x.val) dgBits Prod.mk

theorem rationalBits_eq_ctorBits (t : IntTy) (num den : JInt t) :
    rationalBits t num den = ctorBits t t t num den (inexactErrorCore "Rational") := by
  unfold rationalBits rationalSameSource ctorBits
  have hconv : (fun x : JInt t => (Except.ok x : Jl (JInt t))) = (fun x => JInt.convert (t.name) t x.val) := by
    funext x
    exact (convert_val_self x).symm
  rw [hconv]

theorem ctorBits_zero_zero (t n d : IntTy) (num : JInt n) (den : JInt d)
    (hn : num.val = 0) (hd : den.val = 0)
    (inexactErr : Type → (JInt n × JInt d) → JlError) :
    ctorBits t n d num den inexactErr =
      .error (.argumentError ("invalid rational: zero(" ++ t.name ++ ")//zero(" ++ t.name ++ ")")) := by
  unfold ctorBits constructSource
  have hdz : (jintOps d).iszero den = true := by simp [jintOps, hd]
  have hnz : (jintOps n).iszero num = true := by simp [jintOps, hn]
  rw [hdz, hnz]
  rfl
theorem ctorBits_spec (t n d : IntTy) (num : JInt n) (den : JInt d) :
    let run := ctorBits t n d num den (inexactErrorCore "Rational")
    let gNat := Nat.gcd num.val.natAbs den.val.natAbs
    let g : Int := gNat
    let r1 := num.val.tdiv g
    let r2 := den.val.tdiv g
    let a := if !t.signed then (r1.natAbs : Int) else r1
    let b := if !t.signed then (r2.natAbs : Int) else r2
    let negativeUnsigned := (!t.signed) = true ∧ num.val ≠ 0 ∧ ((num.val < 0) ≠ (den.val < 0))
    let converted := (t.min ≤ a ∧ a ≤ t.max) ∧ (t.min ≤ b ∧ b ≤ t.max)
    let normalized := b < 0 → (t.min ≤ -a ∧ -a ≤ t.max) ∧ (t.min ≤ -b ∧ -b ≤ t.max)
    (g = 0 → run = .error (.argumentError ("invalid rational: zero(" ++ t.name ++ ")//zero(" ++ t.name ++ ")"))) ∧
    (g ≠ 0 → negativeUnsigned → run = .error (.inexactError "Rational")) ∧
    (g ≠ 0 → ¬ negativeUnsigned → ¬ converted → run = .error (.inexactError t.name)) ∧
    (g ≠ 0 → ¬ negativeUnsigned → converted →
      (normalized → ∃ q, run = .ok q ∧ Normalized q ∧
        q.num.val = (if b < 0 then -a else a) ∧
        q.den.val = (if b < 0 then -b else b) ∧
        q.num.val * den.val = num.val * q.den.val ∧
        (den.val ≠ 0 → 0 < q.den.val) ∧
        (den.val = 0 → q.den.val = 0 ∧ intSign q.num.val = intSign num.val)) ∧
      (¬ normalized → ∃ msg, run = .error (.overflowError msg))) := by
  intro run gNat g r1 r2 a b negativeUnsigned converted normalized
  have hzero_iff : ((jintOps d).iszero den && (jintOps n).iszero num) = true ↔ g = 0 := by
    simp only [jintOps, Bool.and_eq_true, beq_iff_eq]
    constructor
    · rintro ⟨hd0, hn0⟩
      dsimp [g, gNat]
      rw [hn0, hd0, Int.natAbs_zero, Nat.gcd_zero_left]
      rfl
    · intro hg0
      have hgNat0 : gNat = 0 := by dsimp [g] at hg0; omega
      have ⟨hn_abs, hd_abs⟩ := Nat.gcd_eq_zero_iff.mp hgNat0
      exact ⟨by omega, by omega⟩
  refine ⟨fun hg0 => ?_, fun hg0 hnegU => ?_, fun hg0 hnot_negU hnot_conv => ?_,
    fun hg0 hnot_negU hconv => ?_⟩
  · have ⟨hd0, hn0⟩ : den.val = 0 ∧ num.val = 0 := by
      have hgNat0 : gNat = 0 := by dsimp [g] at hg0; omega
      have ⟨hn_abs, hd_abs⟩ := Nat.gcd_eq_zero_iff.mp hgNat0
      exact ⟨by omega, by omega⟩
    exact ctorBits_zero_zero t n d num den hn0 hd0 (inexactErrorCore "Rational")
  · have hnot_zero : ((jintOps d).iszero den && (jintOps n).iszero num) = false :=
      Bool.eq_false_iff.mpr (fun h => hg0 (hzero_iff.mp h))
    rcases hnegU with ⟨hu, hnum_nz, hsign_ne⟩
    unfold run ctorBits constructSource
    have hu_ops : (jintOps t).isUnsignedOrBool = true := hu
    have hxor : (!((jintOps n).iszero num) && xor ((jintOps d).signbit den) ((jintOps n).signbit num)) = true := by
      simp only [jintOps, Bool.and_eq_true, Bool.not_eq_true', beq_eq_false_iff_ne, ne_eq]
      refine ⟨hnum_nz, ?_⟩
      by_cases h1 : den.val < 0 <;> by_cases h2 : num.val < 0 <;> simp_all
    rw [hnot_zero, if_neg Bool.false_ne_true, hu_ops, if_pos rfl, hxor, if_pos rfl]
    rfl
  · have hnot_zero : ((jintOps d).iszero den && (jintOps n).iszero num) = false :=
      Bool.eq_false_iff.mpr (fun h => hg0 (hzero_iff.mp h))
    unfold run ctorBits constructSource
    simp only [hnot_zero, Bool.false_eq_true, ↓reduceIte]
    by_cases hu : (jintOps t).isUnsignedOrBool = true
    · have hts : (!t.signed) = true := hu
      simp only [hu, ↓reduceIte]
      have hxor : (!((jintOps n).iszero num) && xor ((jintOps d).signbit den) ((jintOps n).signbit num)) = false := by
        apply Bool.eq_false_iff.mpr
        intro h
        apply hnot_negU
        simp only [jintOps, Bool.and_eq_true, Bool.not_eq_true', beq_eq_false_iff_ne, ne_eq] at h
        refine ⟨hts, h.1, ?_⟩
        rcases h with ⟨_, h2⟩
        by_cases hd_lt : den.val < 0 <;> by_cases hn_lt : num.val < 0 <;> simp_all
      simp only [hxor, Bool.false_eq_true, ↓reduceIte]
      generalize hunum_eq : JuliaLean.base.float.uabs num = unum
      generalize huden_eq : JuliaLean.base.float.uabs den = uden
      have hunum_val : unum.val = (num.val.natAbs : Int) := by rw [← hunum_eq, uabs_val]
      have huden_val : uden.val = (den.val.natAbs : Int) := by rw [← huden_eq, uabs_val]
      have hunum_abs : unum.val.natAbs = num.val.natAbs := by rw [hunum_val, Int.natAbs_natCast]
      have huden_abs : uden.val.natAbs = den.val.natAbs := by rw [huden_val, Int.natAbs_natCast]
      have hdgU := dgBits_spec unum uden
      have hgU_eq : (Nat.gcd unum.val.natAbs uden.val.natAbs : Int) = g := by
        dsimp [g, gNat]; rw [hunum_abs, huden_abs]
      obtain ⟨rUnum, rUden, hdgu_ok, hrUnum_val, hrUden_val, _, _, _, _, _, _, _, _⟩ :=
        hdgU.2 (by dsimp; rw [hgU_eq]; exact hg0)
      rw [hgU_eq] at hrUnum_val hrUden_val
      have ha_eq : rUnum.val = a := by
        dsimp [a, r1]
        rw [if_pos hts, hrUnum_val, hunum_val]
        have hnn : 0 ≤ (num.val.natAbs : Int) := Int.natCast_nonneg _
        have hg_nn : 0 ≤ g := Int.natCast_nonneg _
        have hq_nn : 0 ≤ (num.val.natAbs : Int).tdiv g := Int.tdiv_nonneg hnn hg_nn
        rw [← Int.natAbs_of_nonneg hq_nn, Int.natAbs_tdiv, Int.natAbs_natCast,
          Int.natAbs_tdiv, Int.natAbs_natCast]
      have hb_eq : rUden.val = b := by
        dsimp [b, r2]
        rw [if_pos hts, hrUden_val, huden_val]
        have hnn : 0 ≤ (den.val.natAbs : Int) := Int.natCast_nonneg _
        have hg_nn : 0 ≤ g := Int.natCast_nonneg _
        have hq_nn : 0 ≤ (den.val.natAbs : Int).tdiv g := Int.tdiv_nonneg hnn hg_nn
        rw [← Int.natAbs_of_nonneg hq_nn, Int.natAbs_tdiv, Int.natAbs_natCast,
          Int.natAbs_tdiv, Int.natAbs_natCast]
      rw [hdgu_ok]; dsimp only [Bind.bind, Except.bind, Functor.map, Except.map]
      rw [ha_eq, hb_eq]
      by_cases hfit_a : t.min ≤ a ∧ a ≤ t.max
      · have hnot_fit_b : ¬ (t.min ≤ b ∧ b ≤ t.max) := fun hfit_b => hnot_conv ⟨hfit_a, hfit_b⟩
        rw [convert_of_fits hfit_a, convert_of_not_fits hnot_fit_b]
      · rw [convert_of_not_fits hfit_a]
    · have hts_false : (!t.signed) = false := Bool.eq_false_iff.mpr hu
      simp only [hu, Bool.false_eq_true, ↓reduceIte]
      have hdgS := dgBits_spec num den
      obtain ⟨rNum, rDen, hdgs_ok, hrNum_val, hrDen_val, _, _, _, _, _, _, _, _⟩ := hdgS.2 hg0
      have ha_eq : rNum.val = a := by dsimp [a, r1]; rw [if_neg (by simp [hts_false]), hrNum_val]
      have hb_eq : rDen.val = b := by dsimp [b, r2]; rw [if_neg (by simp [hts_false]), hrDen_val]
      rw [hdgs_ok]; dsimp only [Bind.bind, Except.bind]
      rw [ha_eq, hb_eq]
      by_cases hfit_a : t.min ≤ a ∧ a ≤ t.max
      · have hnot_fit_b : ¬ (t.min ≤ b ∧ b ≤ t.max) := fun hfit_b => hnot_conv ⟨hfit_a, hfit_b⟩
        rw [convert_of_fits hfit_a, convert_of_not_fits hnot_fit_b]
      · rw [convert_of_not_fits hfit_a]
  · have hnot_zero : ((jintOps d).iszero den && (jintOps n).iszero num) = false :=
      Bool.eq_false_iff.mpr (fun h => hg0 (hzero_iff.mp h))
    rcases hconv with ⟨hfit_a, hfit_b⟩
    unfold run ctorBits constructSource
    simp only [hnot_zero, Bool.false_eq_true, ↓reduceIte]
    by_cases hu : (jintOps t).isUnsignedOrBool = true
    · have hts : (!t.signed) = true := hu
      simp only [hu, ↓reduceIte]
      have hxor : (!((jintOps n).iszero num) && xor ((jintOps d).signbit den) ((jintOps n).signbit num)) = false := by
        apply Bool.eq_false_iff.mpr
        intro h
        apply hnot_negU
        simp only [jintOps, Bool.and_eq_true, Bool.not_eq_true', beq_eq_false_iff_ne, ne_eq] at h
        refine ⟨hts, h.1, ?_⟩
        rcases h with ⟨_, h2⟩
        by_cases hd_lt : den.val < 0 <;> by_cases hn_lt : num.val < 0 <;> simp_all
      simp only [hxor, Bool.false_eq_true, ↓reduceIte]
      generalize hunum_eq : JuliaLean.base.float.uabs num = unum
      generalize huden_eq : JuliaLean.base.float.uabs den = uden
      have hunum_val : unum.val = (num.val.natAbs : Int) := by rw [← hunum_eq, uabs_val]
      have huden_val : uden.val = (den.val.natAbs : Int) := by rw [← huden_eq, uabs_val]
      have hunum_abs : unum.val.natAbs = num.val.natAbs := by rw [hunum_val, Int.natAbs_natCast]
      have huden_abs : uden.val.natAbs = den.val.natAbs := by rw [huden_val, Int.natAbs_natCast]
      have hdgU := dgBits_spec unum uden
      have hgU_eq : (Nat.gcd unum.val.natAbs uden.val.natAbs : Int) = g := by
        dsimp [g, gNat]; rw [hunum_abs, huden_abs]
      obtain ⟨rUnum, rUden, hdgu_ok, hrUnum_val, hrUden_val, hrUnum_abs, hrUden_abs, hcop,
        hmul_u, hmul_d, _, _, _⟩ := hdgU.2 (by dsimp; rw [hgU_eq]; exact hg0)
      rw [hgU_eq] at hrUnum_val hrUden_val hmul_u hmul_d
      have ha_eq : rUnum.val = a := by
        dsimp [a, r1]
        rw [if_pos hts, hrUnum_val, hunum_val]
        have hnn : 0 ≤ (num.val.natAbs : Int) := Int.natCast_nonneg _
        have hg_nn : 0 ≤ g := Int.natCast_nonneg _
        have hq_nn : 0 ≤ (num.val.natAbs : Int).tdiv g := Int.tdiv_nonneg hnn hg_nn
        rw [← Int.natAbs_of_nonneg hq_nn, Int.natAbs_tdiv, Int.natAbs_natCast,
          Int.natAbs_tdiv, Int.natAbs_natCast]
      have hb_eq : rUden.val = b := by
        dsimp [b, r2]
        rw [if_pos hts, hrUden_val, huden_val]
        have hnn : 0 ≤ (den.val.natAbs : Int) := Int.natCast_nonneg _
        have hg_nn : 0 ≤ g := Int.natCast_nonneg _
        have hq_nn : 0 ≤ (den.val.natAbs : Int).tdiv g := Int.tdiv_nonneg hnn hg_nn
        rw [← Int.natAbs_of_nonneg hq_nn, Int.natAbs_tdiv, Int.natAbs_natCast,
          Int.natAbs_tdiv, Int.natAbs_natCast]
      have hb_nn : 0 ≤ b := by
        dsimp [b]; rw [if_pos hts]; exact Int.natCast_nonneg _
      have hnorm_true : normalized := fun hlt => absurd hlt (by omega)
      rw [hdgu_ok]; dsimp only [Bind.bind, Except.bind, Functor.map, Except.map]
      rw [ha_eq, hb_eq, convert_of_fits hfit_a, convert_of_fits hfit_b]
      dsimp only [unsafeRationalTypeSource_id]
      refine ⟨fun _ => ?_, fun h => absurd hnorm_true h⟩
      let q : Rat t := ⟨⟨a, hfit_a⟩, ⟨b, hfit_b⟩⟩
      have hq_norm : Normalized q := by
        refine ⟨hb_nn, ?_⟩
        change Nat.gcd a.natAbs b.natAbs = 1
        rw [← ha_eq, ← hb_eq]
        exact hcop
      have hsame_sign : num.val = 0 ∨ ((num.val < 0) = (den.val < 0)) := by
        by_cases hnz : num.val = 0
        · exact Or.inl hnz
        · right
          exact Decidable.byContradiction fun hne => hnot_negU ⟨hts, hnz, hne⟩
      have hcross : a * den.val = num.val * b := by
        have ha_abs : a = (r1.natAbs : Int) := by dsimp [a]; rw [if_pos hts]
        have hb_abs : b = (r2.natAbs : Int) := by dsimp [b]; rw [if_pos hts]
        have hdvd_n : gNat ∣ num.val.natAbs := Nat.gcd_dvd_left num.val.natAbs den.val.natAbs
        have hdvd_d : gNat ∣ den.val.natAbs := Nat.gcd_dvd_right num.val.natAbs den.val.natAbs
        have hr1_mul : r1 * g = num.val := tdiv_mul_cancel_of_dvd num.val gNat hdvd_n
        have hr2_mul : r2 * g = den.val := tdiv_mul_cancel_of_dvd den.val gNat hdvd_d
        have hr1_sign : intSign r1 = intSign num.val :=
          intSign_tdiv_pos num.val gNat (Decidable.byContradiction fun h => hg0 (by dsimp [g]; omega)) hdvd_n
        have hr2_sign : intSign r2 = intSign den.val :=
          intSign_tdiv_pos den.val gNat (Decidable.byContradiction fun h => hg0 (by dsimp [g]; omega)) hdvd_d
        have hab_r : a * r2 = r1 * b := by
          rw [ha_abs, hb_abs]
          rcases hsame_sign with hnz | hss
          · have hr10 : r1 = 0 := by dsimp [r1]; rw [hnz, Int.zero_tdiv]
            simp [hr10]
          · by_cases hn_lt : num.val < 0
            · have hd_lt : den.val < 0 := by rw [← hss]; exact hn_lt
              have hr1_le : r1 ≤ 0 := by
                by_cases hr1_pos : 0 < r1
                · have : intSign r1 = 1 := by unfold intSign; simp [hr1_pos, show ¬ r1 < 0 by omega]
                  have : intSign num.val = -1 := by unfold intSign; simp [hn_lt]
                  omega
                · omega
              have hr2_le : r2 ≤ 0 := by
                by_cases hr2_pos : 0 < r2
                · have : intSign r2 = 1 := by unfold intSign; simp [hr2_pos, show ¬ r2 < 0 by omega]
                  have : intSign den.val = -1 := by unfold intSign; simp [hd_lt]
                  omega
                · omega
              rw [Int.ofNat_natAbs_of_nonpos hr1_le, Int.ofNat_natAbs_of_nonpos hr2_le,
                Int.neg_mul, Int.mul_neg]
            · have hd_ge : 0 ≤ den.val := by
                by_cases hd_lt : den.val < 0
                · rw [← hss] at hd_lt; exact absurd hd_lt hn_lt
                · omega
              have hg_nn : 0 ≤ g := Int.natCast_nonneg _
              have hr1_ge : 0 ≤ r1 := Int.tdiv_nonneg (by omega) hg_nn
              have hr2_ge : 0 ≤ r2 := Int.tdiv_nonneg hd_ge hg_nn
              rw [Int.natAbs_of_nonneg hr1_ge, Int.natAbs_of_nonneg hr2_ge]
        calc a * den.val = a * (r2 * g) := by rw [hr2_mul]
          _ = (a * r2) * g := by rw [← Int.mul_assoc]
          _ = (r1 * b) * g := by rw [hab_r]
          _ = (r1 * g) * b := by rw [Int.mul_right_comm r1 b g]
          _ = num.val * b := by rw [hr1_mul]
      refine ⟨q, rfl, hq_norm, by simp [q, show ¬ b < 0 by omega],
        by simp [q, show ¬ b < 0 by omega], hcross, fun hden_nz => ?_, fun hden0 => ?_⟩
      · change 0 < b
        have hr2_nz : r2 ≠ 0 := by
          intro hr20
          have hdvd_d : gNat ∣ den.val.natAbs := Nat.gcd_dvd_right num.val.natAbs den.val.natAbs
          have hr2_mul : r2 * g = den.val := tdiv_mul_cancel_of_dvd den.val gNat hdvd_d
          rw [hr20, Int.zero_mul] at hr2_mul
          exact hden_nz hr2_mul.symm
        dsimp [b]
        rw [if_pos hts]
        exact Int.natCast_pos.mpr (Int.natAbs_pos.mpr hr2_nz)
      · have hr20 : r2 = 0 := by dsimp [r2]; rw [hden0, Int.zero_tdiv]
        have hb0 : b = 0 := by dsimp [b]; rw [if_pos hts, hr20]; rfl
        refine ⟨hb0, ?_⟩
        change intSign a = intSign num.val
        have hnum_pos : 0 < num.val := by
          have hnum_nz : num.val ≠ 0 := by
            intro hn0
            apply hg0
            dsimp [g, gNat]; rw [hn0, hden0]; rfl
          have hnot_neg : ¬ num.val < 0 := fun hn_lt =>
            hnot_negU ⟨hts, hnum_nz, by simp [hn_lt, hden0]⟩
          omega
        have hr1_pos : 0 < r1 := by
          have hdvd_n : gNat ∣ num.val.natAbs := Nat.gcd_dvd_left num.val.natAbs den.val.natAbs
          have hr1_sign := intSign_tdiv_pos num.val gNat
            (Decidable.byContradiction fun h => hg0 (by dsimp [g]; omega)) hdvd_n
          unfold intSign at hr1_sign
          split at hr1_sign <;> split at hr1_sign <;> omega
        have ha_pos : 0 < a := by dsimp [a]; rw [if_pos hts]; omega
        unfold intSign
        simp [ha_pos, hnum_pos, show ¬ a < 0 by omega, show ¬ num.val < 0 by omega]
    · have hts_false : (!t.signed) = false := Bool.eq_false_iff.mpr hu
      simp only [hu, Bool.false_eq_true, ↓reduceIte]
      have hdgS := dgBits_spec num den
      obtain ⟨rNum, rDen, hdgs_ok, hrNum_val, hrDen_val, _, _, hcop,
        hmul_n, hmul_d, hcross, hsign_n, _⟩ := hdgS.2 hg0
      have ha_eq : a = rNum.val := by dsimp [a, r1]; rw [if_neg (by simp [hts_false]), hrNum_val]
      have hb_eq : b = rDen.val := by dsimp [b, r2]; rw [if_neg (by simp [hts_false]), hrDen_val]
      have hconv_a : JInt.convert (t.name) t rNum.val = .ok ⟨a, hfit_a⟩ := by
        rw [← ha_eq]; exact convert_of_fits hfit_a
      have hconv_b : JInt.convert (t.name) t rDen.val = .ok ⟨b, hfit_b⟩ := by
        rw [← hb_eq]; exact convert_of_fits hfit_b
      simp only [hdgs_ok, Bind.bind, Except.bind, hconv_a, hconv_b]
      have hcd := checkedDenBits_spec (jintOps t) rfl rfl ⟨a, hfit_a⟩ ⟨b, hfit_b⟩
      by_cases hb_lt : b < 0
      · refine ⟨fun hnorm => ?_, fun hnot_norm => ?_⟩
        · obtain ⟨hfit_na, hfit_nb⟩ := hnorm hb_lt
          obtain ⟨q, hq_ok, hq_den_pos, hq_num, hq_den⟩ := hcd.2.1 hb_lt hfit_nb hfit_na
          dsimp only at hq_num hq_den
          refine ⟨q, hq_ok, ?_, by simp [hb_lt, hq_num], by simp [hb_lt, hq_den], ?_,
            fun _ => hq_den_pos, fun hden0 => ?_⟩
          · refine ⟨by omega, ?_⟩
            have h1 : q.num.val.natAbs = rNum.val.natAbs := by rw [hq_num, ha_eq, Int.natAbs_neg]
            have h2 : q.den.val.natAbs = rDen.val.natAbs := by rw [hq_den, hb_eq, Int.natAbs_neg]
            rw [h1, h2]
            exact hcop
          · rw [hq_num, hq_den, ha_eq, hb_eq]
            calc (-rNum.val) * den.val = -(rNum.val * den.val) := by rw [Int.neg_mul]
              _ = -(num.val * rDen.val) := by rw [hcross]
              _ = num.val * (-rDen.val) := by rw [Int.mul_neg]
          · have hb0 : b = 0 := by rw [hb_eq, hrDen_val, hden0, Int.zero_tdiv]
            omega
        · apply hcd.2.2 hb_lt
          by_cases hna : t.min ≤ -a ∧ -a ≤ t.max
          · exact Or.inl (fun hnb => hnot_norm fun _ => ⟨hna, hnb⟩)
          · exact Or.inr hna
      · have hb_nn : 0 ≤ b := by omega
        have hnorm_true : normalized := fun hlt => absurd hlt hb_lt
        have hq_ok := hcd.1 hb_nn
        refine ⟨fun _ => ?_, fun h => absurd hnorm_true h⟩
        let q : Rat t := ⟨⟨a, hfit_a⟩, ⟨b, hfit_b⟩⟩
        have hq_norm : Normalized q := by
          refine ⟨hb_nn, ?_⟩
          change Nat.gcd a.natAbs b.natAbs = 1
          rw [ha_eq, hb_eq]
          exact hcop
        refine ⟨q, hq_ok, hq_norm, by simp [q, hb_lt], by simp [q, hb_lt], ?_,
          fun hden_nz => ?_, fun hden0 => ?_⟩
        · change a * den.val = num.val * b
          rw [ha_eq, hb_eq]
          exact hcross
        · change 0 < b
          have hrDen_nz : rDen.val ≠ 0 := by
            intro hr0
            rw [hr0, Int.zero_mul] at hmul_d
            exact hden_nz hmul_d.symm
          omega
        · have hb0 : b = 0 := by rw [hb_eq, hrDen_val, hden0, Int.zero_tdiv]
          refine ⟨hb0, ?_⟩
          change intSign a = intSign num.val
          rw [ha_eq]
          exact hsign_n

end DivGcdCtorLemmas

namespace ComparisonAndRoundingLemmas

open JuliaLean JuliaLean.Promotion JuliaLean.base.rational
open JuliaLean.Proofs.base.int
open JuliaLean.Proofs.base.rational.CoreLemmas
open JuliaLean.Proofs.base.rational.DivGcdCtorLemmas

set_option maxRecDepth 4096

/-! ## Canonical Fraction & Extended Order Lemmas -/

def compareExtended (n d m e : Int) : Int :=
  if d = 0 then
    if e = 0 then intCmp (intSign n) (intSign m) else intSign n
  else if e = 0 then -intSign m
  else intCmp (n * e) (m * d)

theorem normalized_extremes_full {t : IntTy} {q : Rat t} (hq : Normalized q) :
    (q.num.val = 0 → q.den.val = 1) ∧
    (q.den.val = 0 → q.num.val.natAbs = 1 ∧ (q.num.val = 1 ∨ q.num.val = -1)) := by
  rcases hq with ⟨hd0, hgcd⟩
  refine ⟨fun hn0 => ?_, fun hd_zero => ?_⟩
  · rw [hn0, Int.natAbs_zero, Nat.gcd_zero_left] at hgcd
    omega
  · rw [hd_zero, Int.natAbs_zero, Nat.gcd_zero_right] at hgcd
    exact ⟨hgcd, by omega⟩

theorem canonical_unique_components {n1 d1 n2 d2 : Int}
    (hd1 : 0 < d1) (hd2 : 0 < d2)
    (hg1 : Nat.gcd n1.natAbs d1.natAbs = 1)
    (hg2 : Nat.gcd n2.natAbs d2.natAbs = 1)
    (hcross : n1 * d2 = n2 * d1) :
    n1 = n2 ∧ d1 = d2 := by
  have habs_eq : n1.natAbs * d2.natAbs = n2.natAbs * d1.natAbs := by
    have := congrArg Int.natAbs hcross
    simpa [Int.natAbs_mul] using this
  have hd1_dvd : d1.natAbs ∣ d2.natAbs := by
    have hdvd_prod : d1.natAbs ∣ d2.natAbs * n1.natAbs := by
      rw [Nat.mul_comm, habs_eq]
      exact ⟨n2.natAbs, (Nat.mul_comm _ _).symm⟩
    exact (Nat.Coprime.symm hg1).dvd_of_dvd_mul_right hdvd_prod
  have hd2_dvd : d2.natAbs ∣ d1.natAbs := by
    have hdvd_prod : d2.natAbs ∣ d1.natAbs * n2.natAbs := by
      rw [Nat.mul_comm, ← habs_eq]
      exact ⟨n1.natAbs, (Nat.mul_comm _ _).symm⟩
    exact (Nat.Coprime.symm hg2).dvd_of_dvd_mul_right hdvd_prod
  have hd_abs : d1.natAbs = d2.natAbs := Nat.dvd_antisymm hd1_dvd hd2_dvd
  have hd_eq : d1 = d2 := by omega
  subst hd_eq
  exact ⟨Int.eq_of_mul_eq_mul_right (by omega) hcross, rfl⟩

theorem eqRat_normalized_iff {t s : IntTy} (x : Rat t) (y : Rat s)
    (hx : Normalized x) (hy : Normalized y) :
    eqRatSource JuliaLean.base.int.eq JuliaLean.base.int.eq x y =
      decide (compareExtended x.num.val x.den.val y.num.val y.den.val = 0) := by
  unfold eqRatSource bwand compareExtended
  rw [eq_eq x.den y.den, eq_eq x.num y.num]
  rcases hx with ⟨hxd0, hxg⟩
  rcases hy with ⟨hyd0, hyg⟩
  by_cases hdx : x.den.val = 0
  · by_cases hdy : y.den.val = 0
    · have hxn := (normalized_extremes_full ⟨hxd0, hxg⟩).2 hdx
      have hyn := (normalized_extremes_full ⟨hyd0, hyg⟩).2 hdy
      simp only [hdx, hdy, ↓reduceIte, decide_true, intCmp, intSign]
      rcases hxn.2 with hxn1 | hxn1 <;> rcases hyn.2 with hyn1 | hyn1 <;>
        simp [hxn1, hyn1]
    · have hxn := (normalized_extremes_full ⟨hxd0, hxg⟩).2 hdx
      have hne_d : x.den.val ≠ y.den.val := by omega
      rw [decide_eq_false hne_d]
      simp only [hdx, hdy, ↓reduceIte, intSign]
      rcases hxn.2 with hxn1 | hxn1 <;> simp [hxn1]
  · by_cases hdy : y.den.val = 0
    · have hyn := (normalized_extremes_full ⟨hyd0, hyg⟩).2 hdy
      have hne_d : x.den.val ≠ y.den.val := by omega
      rw [decide_eq_false hne_d]
      simp only [hdx, hdy, ↓reduceIte, intSign]
      rcases hyn.2 with hyn1 | hyn1 <;> simp [hyn1]
    · simp only [hdx, hdy, ↓reduceIte, intCmp]
      have hxd_pos : 0 < x.den.val := by omega
      have hyd_pos : 0 < y.den.val := by omega
      by_cases hcross : x.num.val * y.den.val = y.num.val * x.den.val
      · have ⟨hn_eq, hd_eq⟩ := canonical_unique_components hxd_pos hyd_pos hxg hyg hcross
        have hlt1 : ¬ (x.num.val * y.den.val < y.num.val * x.den.val) := by omega
        have hlt2 : ¬ (y.num.val * x.den.val < x.num.val * y.den.val) := by omega
        simp [hn_eq, hd_eq, hlt1, hlt2]
      · have hnot_both : ¬ (x.den.val = y.den.val ∧ x.num.val = y.num.val) := by
          rintro ⟨hd_eq, hn_eq⟩
          apply hcross
          rw [hd_eq, hn_eq]
        have hcmp_nz : (if x.num.val * y.den.val < y.num.val * x.den.val then (-1 : Int)
            else if y.num.val * x.den.val < x.num.val * y.den.val then 1 else 0) ≠ 0 := by
          by_cases hlt : x.num.val * y.den.val < y.num.val * x.den.val
          · simp [hlt]
          · have hgt : y.num.val * x.den.val < x.num.val * y.den.val := by omega
            simp [hlt, hgt]
        rw [decide_eq_false hcmp_nz]
        by_cases hd_eq : x.den.val = y.den.val
        · have hn_ne : x.num.val ≠ y.num.val := fun hn_eq => hnot_both ⟨hd_eq, hn_eq⟩
          simp [hd_eq, hn_ne]
        · simp [hd_eq]
theorem lt_le_Rat_normalized_iff {t s : IntTy} {WX WY : Type}
    (wXY : JInt t → JInt s → WX) (wYX : JInt t → JInt s → WY)
    (vX : WX → Int) (vY : WY → Int)
    (ltW : WX → WY → Bool) (leW : WX → WY → Bool)
    (hwXY : ∀ a b, vX (wXY a b) = a.val * b.val)
    (hwYX : ∀ a b, vY (wYX a b) = a.val * b.val)
    (hltW : ∀ u v, ltW u v = decide (vX u < vY v))
    (hleW : ∀ u v, leW u v = decide (vX u ≤ vY v))
    (x : Rat t) (y : Rat s) (hx : Normalized x) (hy : Normalized y) :
    let c := compareExtended x.num.val x.den.val y.num.val y.den.val
    ltRatSource JuliaLean.base.int.eq JuliaLean.base.int.lt wXY wYX ltW x y = decide (c < 0) ∧
    leRatSource JuliaLean.base.int.eq JuliaLean.base.int.le wXY wYX leW x y = decide (c ≤ 0) := by
  intro c
  unfold ltRatSource leRatSource
  rw [eq_eq x.den y.den, lt_eq x.num y.num, le_eq x.num y.num, hltW, hleW, hwXY, hwYX]
  rcases hx with ⟨hxd0, hxg⟩
  rcases hy with ⟨hyd0, hyg⟩
  dsimp only [c, compareExtended, intCmp, intSign]
  by_cases hdx : x.den.val = 0
  · by_cases hdy : y.den.val = 0
    · have hxn := (normalized_extremes_full ⟨hxd0, hxg⟩).2 hdx
      have hyn := (normalized_extremes_full ⟨hyd0, hyg⟩).2 hdy
      simp only [hdx, hdy, ↓reduceIte]
      rcases hxn.2 with hxn1 | hxn1 <;> rcases hyn.2 with hyn1 | hyn1 <;>
        simp [hxn1, hyn1]
    · have hxn := (normalized_extremes_full ⟨hxd0, hxg⟩).2 hdx
      have hyd_pos : 0 < y.den.val := by omega
      have hne_d : x.den.val ≠ y.den.val := by omega
      rw [decide_eq_false hne_d]
      simp only [hdx, hdy, Bool.false_eq_true, ↓reduceIte, Int.zero_mul]
      rcases hxn.2 with hxn1 | hxn1
      · simp [hxn1, show ¬ (1 : Int) < 0 by decide, show (1 : Int) > 0 by decide,
          show ¬ y.den.val < 0 by omega, show ¬ y.den.val ≤ 0 by omega]
      · simp [hxn1, hyd_pos, show -y.den.val ≤ 0 by omega]
  · by_cases hdy : y.den.val = 0
    · have hyn := (normalized_extremes_full ⟨hyd0, hyg⟩).2 hdy
      have hxd_pos : 0 < x.den.val := by omega
      have hne_d : x.den.val ≠ y.den.val := by omega
      rw [decide_eq_false hne_d]
      simp only [hdx, hdy, Bool.false_eq_true, ↓reduceIte, Int.mul_zero]
      rcases hyn.2 with hyn1 | hyn1
      · simp [hyn1, hxd_pos, show 0 ≤ x.den.val by omega,
          show ¬ (1 : Int) < 0 by decide, show (1 : Int) > 0 by decide]
      · simp [hyn1, show (-1 : Int) < 0 by decide,
          show ¬ x.den.val < 0 by omega, show ¬ x.den.val ≤ 0 by omega]
    · have hxd_pos : 0 < x.den.val := by omega
      have hyd_pos : 0 < y.den.val := by omega
      simp only [hdx, hdy, ↓reduceIte]
      by_cases hd_eq : x.den.val = y.den.val
      · simp only [hd_eq, ↓reduceIte]
        have hlt_iff : x.num.val < y.num.val ↔ x.num.val * y.den.val < y.num.val * y.den.val :=
          ⟨fun h => Int.mul_lt_mul_of_pos_right h hyd_pos,
           fun h => Decidable.byContradiction fun hge =>
             absurd h (Int.not_lt.mpr (Int.mul_le_mul_of_nonneg_right (by omega) (by omega)))⟩
        by_cases hlt : x.num.val < y.num.val
        · have hlt_m : x.num.val * y.den.val < y.num.val * y.den.val := hlt_iff.mp hlt
          simp [hlt, hlt_m, show x.num.val ≤ y.num.val by omega]
        · have hnot_lt_m : ¬ (x.num.val * y.den.val < y.num.val * y.den.val) :=
            fun hm => hlt (hlt_iff.mpr hm)
          by_cases hgt : y.num.val < x.num.val
          · have hgt_m : y.num.val * y.den.val < x.num.val * y.den.val :=
              Int.mul_lt_mul_of_pos_right hgt hyd_pos
            simp [hlt, hnot_lt_m, hgt_m, show ¬ x.num.val ≤ y.num.val by omega]
          · have heq : x.num.val = y.num.val := by omega
            simp [heq]
      · simp only [hd_eq, ↓reduceIte, Int.mul_comm x.den.val y.num.val]
        by_cases hlt : x.num.val * y.den.val < y.num.val * x.den.val
        · simp [hlt, show x.num.val * y.den.val ≤ y.num.val * x.den.val by omega]
        · by_cases hgt : y.num.val * x.den.val < x.num.val * y.den.val
          · simp [hlt, hgt, show ¬ x.num.val * y.den.val ≤ y.num.val * x.den.val by omega]
          · have heq : x.num.val * y.den.val = y.num.val * x.den.val := by omega
            simp [heq]

/-! ## Widening Lemmas (Round 3 `widenMultiply` and Round 5 `Widening`) -/

inductive Widening : IntTy → IntTy → Type → Type where
  | same (t s wt ws : IntTy) (hs : t.signed = s.signed)
      (ht : JuliaLean.base.int.widenType t = some wt)
      (hu : JuliaLean.base.int.widenType s = some ws) : Widening t s (JInt (wt.promote ws))
  | signedUnsigned (t s wt ws : IntTy) (hs : t.signed = true) (hu : s.signed = false)
      (ht : JuliaLean.base.int.widenType t = some wt)
      (hw : JuliaLean.base.int.widenType s = some ws) : Widening t s (JInt (wt.promote ws.toSigned))
  | unsignedSigned (t s wt ws : IntTy) (hs : t.signed = false) (hu : s.signed = true)
      (ht : JuliaLean.base.int.widenType t = some wt)
      (hw : JuliaLean.base.int.widenType s = some ws) : Widening t s (JInt (wt.toSigned.promote ws))

namespace Widening
def product {t s : IntTy} {W : Type} : Widening t s W → JInt t → JInt s → W
  | .same _ _ wt ws _ _ _, a, b => JuliaLean.base.int.okOf
      (JuliaLean.base.number.widemul
        (fun x => .ok (JuliaLean.base.int.widenTo wt x))
        (fun x => .ok (JuliaLean.base.int.widenTo ws x))
        (fun x y => .ok (JuliaLean.base.int.binop JuliaLean.base.int.mulSame x y)) a b)
      (by intro e h; cases h)
  | .signedUnsigned _ _ wt ws _ _ _ _, a, b =>
      JuliaLean.base.int.widemul_Signed_Unsigned
        (JuliaLean.base.int.widenTo wt) (JuliaLean.base.int.widenTo ws) a b
  | .unsignedSigned _ _ wt ws _ _ _ _, a, b =>
      JuliaLean.base.int.widemul_Unsigned_Signed
        (JuliaLean.base.int.widenTo wt) (JuliaLean.base.int.widenTo ws) a b

def val {t s : IntTy} {W : Type} : Widening t s W → W → Int
  | .same .., w => w.val
  | .signedUnsigned .., w => w.val
  | .unsignedSigned .., w => w.val
end Widening

private theorem widen_same_product_fits {t s wt ws : IntTy}
    (hs : t.signed = s.signed)
    (ht : JuliaLean.base.int.widenType t = some wt)
    (hu : JuliaLean.base.int.widenType s = some ws)
    (a : JInt t) (b : JInt s) :
    let P := wt.promote ws
    (wt.min ≤ a.val ∧ a.val ≤ wt.max) ∧
    (ws.min ≤ b.val ∧ b.val ≤ ws.max) ∧
    (P.min ≤ a.val ∧ a.val ≤ P.max) ∧
    (P.min ≤ b.val ∧ b.val ≤ P.max) ∧
    (P.min ≤ a.val * b.val ∧ a.val * b.val ≤ P.max) := by
  have ha := a.property
  have hb := b.property
  have hK : ∀ {u : IntTy} (x : JInt u), x.val.natAbs ≤ max u.min.natAbs u.max.natAbs := fun {u} x => by
    have := x.property
    cases u <;> simp_all [IntTy.signed, IntTy.min, IntTy.max, IntTy.bits] <;> omega
  have hbound := mul_natAbs_le (hK a) (hK b)
  have hnn : 0 ≤ a.val → 0 ≤ b.val → 0 ≤ a.val * b.val := Int.mul_nonneg
  cases t <;> cases s <;>
    simp only [JuliaLean.base.int.widenType, JuliaLean.base.int.widen_Int8,
      JuliaLean.base.int.widen_Int16, JuliaLean.base.int.widen_Int32,
      JuliaLean.base.int.widen_Int64, JuliaLean.base.int.widen_UInt8,
      JuliaLean.base.int.widen_UInt16, JuliaLean.base.int.widen_UInt32,
      JuliaLean.base.int.widen_UInt64, Option.some.injEq, reduceCtorEq] at ht hu
  all_goals (try contradiction)
  all_goals
    subst ht; subst hu
    try (simp [IntTy.signed] at hs)
    simp only [IntTy.promote, IntTy.min, IntTy.max, IntTy.signed, IntTy.bits] at ha hb hbound ⊢
    simp at ha hb hbound ⊢
    omega
theorem widening_product_val {t s : IntTy} {W : Type} (w : Widening t s W)
    (a : JInt t) (b : JInt s) :
    w.val (w.product a b) = a.val * b.val := by
  cases w with
  | same wt ws hs ht hu =>
    dsimp only [Widening.product, Widening.val]
    have hok : JuliaLean.base.number.widemul
        (fun x => .ok (JuliaLean.base.int.widenTo wt x))
        (fun x => .ok (JuliaLean.base.int.widenTo ws x))
        (fun x y => .ok (JuliaLean.base.int.binop JuliaLean.base.int.mulSame x y)) a b =
      .ok (JuliaLean.base.int.binop JuliaLean.base.int.mulSame
        (JuliaLean.base.int.widenTo wt a) (JuliaLean.base.int.widenTo ws b)) := rfl
    rw [okOf_eq hok, binop_eq, mulSame_val, remT_val, remT_val, widenTo_val, widenTo_val]
    obtain ⟨hwt_a, hws_b, hP_a, hP_b, hP_prod⟩ := widen_same_product_fits hs ht hu a b
    rw [wrapInt_of_inRange wt a.val hwt_a,
        wrapInt_of_inRange ws b.val hws_b,
        wrapInt_of_inRange (wt.promote ws) a.val hP_a,
        wrapInt_of_inRange (wt.promote ws) b.val hP_b,
        wrapInt_of_inRange (wt.promote ws) (a.val * b.val) hP_prod]
  | signedUnsigned wt ws hs hu ht hw =>
    dsimp only [Widening.product, Widening.val]
    have hwt : ∀ x : JInt t, (JuliaLean.base.int.widenTo wt x).val = x.val := fun x => by
      have hx := x.property
      rw [widenTo_val]
      cases t <;>
        simp only [JuliaLean.base.int.widenType, JuliaLean.base.int.widen_Int8,
          JuliaLean.base.int.widen_Int16, JuliaLean.base.int.widen_Int32,
          JuliaLean.base.int.widen_Int64, Option.some.injEq, reduceCtorEq] at ht
      all_goals (try contradiction)
      all_goals (subst ht; exact wrapInt_of_inRange _ _ (by simp [IntTy.min, IntTy.max, IntTy.signed, IntTy.bits] at hx ⊢; omega))
    have hws : ∀ y : JInt s, (JuliaLean.base.int.widenTo ws y).val = y.val := fun y => by
      have hy := y.property
      rw [widenTo_val]
      cases s <;>
        simp only [JuliaLean.base.int.widenType, JuliaLean.base.int.widen_UInt8,
          JuliaLean.base.int.widen_UInt16, JuliaLean.base.int.widen_UInt32,
          JuliaLean.base.int.widen_UInt64, Option.some.injEq, reduceCtorEq] at hw
      all_goals (try contradiction)
      all_goals (subst hw; exact wrapInt_of_inRange _ _ (by simp [IntTy.min, IntTy.max, IntTy.signed, IntTy.bits] at hy ⊢; omega))
    exact (widemulExact_proven.1 t s wt ws hs hu ht hw
      (JuliaLean.base.int.widenTo wt) (JuliaLean.base.int.widenTo ws) hwt hws a b).1
  | unsignedSigned wt ws hs hu ht hw =>
    dsimp only [Widening.product, Widening.val]
    have hwt : ∀ x : JInt t, (JuliaLean.base.int.widenTo wt x).val = x.val := fun x => by
      have hx := x.property
      rw [widenTo_val]
      cases t <;>
        simp only [JuliaLean.base.int.widenType, JuliaLean.base.int.widen_UInt8,
          JuliaLean.base.int.widen_UInt16, JuliaLean.base.int.widen_UInt32,
          JuliaLean.base.int.widen_UInt64, Option.some.injEq, reduceCtorEq] at ht
      all_goals (try contradiction)
      all_goals (subst ht; exact wrapInt_of_inRange _ _ (by simp [IntTy.min, IntTy.max, IntTy.signed, IntTy.bits] at hx ⊢; omega))
    have hws : ∀ y : JInt s, (JuliaLean.base.int.widenTo ws y).val = y.val := fun y => by
      have hy := y.property
      rw [widenTo_val]
      cases s <;>
        simp only [JuliaLean.base.int.widenType, JuliaLean.base.int.widen_Int8,
          JuliaLean.base.int.widen_Int16, JuliaLean.base.int.widen_Int32,
          JuliaLean.base.int.widen_Int64, Option.some.injEq, reduceCtorEq] at hw
      all_goals (try contradiction)
      all_goals (subst hw; exact wrapInt_of_inRange _ _ (by simp [IntTy.min, IntTy.max, IntTy.signed, IntTy.bits] at hy ⊢; omega))
    have h := (widemulExact_proven.1 s t ws wt hu hs hw ht
      (JuliaLean.base.int.widenTo ws) (JuliaLean.base.int.widenTo wt) hws hwt b a).2
    simpa [JuliaLean.base.int.widemul_Unsigned_Signed] using h
/-! ## Integer Rounded Division (`divBitIntegerMode`) and `rounded` -/

def rounded (a b : Int) (mode : Rounding) : Int :=
  let q := a.tdiv b
  let r := a.tmod b
  let step := if (a < 0) ≠ (b < 0) then -1 else 1
  let away := q + step
  match mode with
  | .toZero => q
  | .down => a.fdiv b
  | .up => -((-a).fdiv b)
  | .fromZero => if r = 0 then q else away
  | .nearest | .nearestAway | .nearestUp =>
    if 2 * r.natAbs < b.natAbs then q
    else if 2 * r.natAbs > b.natAbs then away
    else if mode = .nearestAway then away
    else if mode = .nearestUp then if step < 0 then q else away
    else if q % 2 = 0 then q else away

private theorem eq_of_mul_sub_lt {q1 q2 d diff : Int} (hd : 0 < d)
    (h : (q1 - q2) * d = diff) (hdiff : -d < diff ∧ diff < d) :
    q1 = q2 := by
  by_cases hlt : q1 < q2
  · have : (q1 - q2) * d ≤ (-1) * d := Int.mul_le_mul_of_nonneg_right (by omega) (by omega)
    omega
  · by_cases hgt : q2 < q1
    · have : 1 * d ≤ (q1 - q2) * d := Int.mul_le_mul_of_nonneg_right (by omega) (by omega)
      omega
    · omega

private theorem natAbs_tmod_lt (a b : Int) (hb : b ≠ 0) :
    (a.tmod b).natAbs < b.natAbs := by
  rw [Int.natAbs_tmod]
  exact Nat.mod_lt _ (Int.natAbs_pos.mpr hb)

private theorem tmod_bounds_strict (a b : Int) (hb : b ≠ 0) :
    a.tdiv b * b + a.tmod b = a ∧
    (0 ≤ a → 0 ≤ a.tmod b ∧ a.tmod b < b.natAbs) ∧
    (a < 0 → -(b.natAbs : Int) < a.tmod b ∧ a.tmod b ≤ 0) := by
  have hqr := Int.tdiv_mul_add_tmod a b
  have hlt : (a.tmod b).natAbs < b.natAbs := natAbs_tmod_lt a b hb
  have htb := tmod_between a b
  refine ⟨hqr, fun ha => ⟨(htb.1 ha).1, by omega⟩, fun ha => ⟨by omega, (htb.2 ha).2⟩⟩

private theorem fdiv_eq_tdiv_sub (a b : Int) (hb : b ≠ 0) :
    a.fdiv b = a.tdiv b - (if ((a < 0) ≠ (b < 0)) ∧ a.tmod b ≠ 0 then 1 else 0) := by
  rw [Int.fdiv_eq_ediv]
  have hqr := Int.tdiv_mul_add_tmod a b
  have hed := Int.ediv_mul_add_emod a b
  have hmod_nn := Int.emod_nonneg a hb
  have hmod_lt : a % b < (b.natAbs : Int) := by
    by_cases hb_pos : 0 < b
    · have := Int.emod_lt_of_pos a hb_pos; omega
    · have := Int.emod_lt a hb; omega
  obtain ⟨_, hr_pos, hr_neg⟩ := tmod_bounds_strict a b hb
  have hdvd_iff : b ∣ a ↔ a.tmod b = 0 := Int.dvd_iff_tmod_eq_zero
  by_cases ha : a < 0 <;> by_cases hbn : b < 0 <;> by_cases hr0 : a.tmod b = 0
  · have hdvd : b ∣ a := hdvd_iff.mpr hr0
    have hb_ge : ¬ (0 ≤ b) := by omega
    simp only [ha, hbn, hr0, hdvd, hb_ge, ne_eq, not_true_eq_false, false_and, or_true, ↓reduceIte, Int.sub_zero]
    have hrem0 : a % b = 0 := Int.emod_eq_zero_of_dvd hdvd
    have h2 : (a / b - a.tdiv b) * (-b) = 0 := by
      rw [Int.mul_neg, Int.sub_mul]; omega
    exact eq_of_mul_sub_lt (by omega) h2 ⟨by omega, by omega⟩
  · have hndvd : ¬ (b ∣ a) := fun h => hr0 (hdvd_iff.mp h)
    have hb_ge : ¬ (0 ≤ b) := by omega
    simp only [ha, hbn, hr0, hndvd, hb_ge, ne_eq, not_true_eq_false, not_false_eq_true, false_and, or_false, ↓reduceIte, Int.sub_zero]
    have hr := hr_neg ha
    have hrem_pos : 0 < a % b := Decidable.byContradiction fun hle =>
      hndvd (Int.dvd_of_emod_eq_zero (by omega))
    have h2 : ((a / b - 1) - a.tdiv b) * (-b) = a % b + b - a.tmod b := by
      rw [Int.mul_neg, Int.sub_mul, Int.sub_mul, Int.one_mul]; omega
    exact eq_of_mul_sub_lt (by omega) h2 ⟨by omega, by omega⟩
  · have hdvd : b ∣ a := hdvd_iff.mpr hr0
    have hb_ge : 0 ≤ b := by omega
    simp only [ha, hbn, hr0, hdvd, hb_ge, ne_eq, not_true_eq_false, and_false, true_or, ↓reduceIte, Int.sub_zero]
    have hrem0 : a % b = 0 := Int.emod_eq_zero_of_dvd hdvd
    have h2 : (a / b - a.tdiv b) * b = 0 := by rw [Int.sub_mul]; omega
    exact eq_of_mul_sub_lt (by omega) h2 ⟨by omega, by omega⟩
  · have hndvd : ¬ (b ∣ a) := fun h => hr0 (hdvd_iff.mp h)
    have hb_ge : 0 ≤ b := by omega
    simp only [ha, hbn, hr0, hndvd, hb_ge, ne_eq, not_false_eq_true, and_true, true_or, ↓reduceIte, Int.sub_zero]
    have hr := hr_neg ha
    have h2 : (a / b - (a.tdiv b - 1)) * b = (a.tmod b + b) - a % b := by
      rw [Int.sub_mul, Int.sub_mul]; omega
    exact eq_of_mul_sub_lt (by omega) h2 ⟨by omega, by omega⟩
  · have hdvd : b ∣ a := hdvd_iff.mpr hr0
    have hb_ge : ¬ (0 ≤ b) := by omega
    simp only [ha, hbn, hr0, hdvd, hb_ge, ne_eq, not_true_eq_false, and_false, or_true, ↓reduceIte, Int.sub_zero]
    have hrem0 : a % b = 0 := Int.emod_eq_zero_of_dvd hdvd
    have h2 : (a / b - a.tdiv b) * (-b) = 0 := by
      rw [Int.mul_neg, Int.sub_mul]; omega
    exact eq_of_mul_sub_lt (by omega) h2 ⟨by omega, by omega⟩
  · have hndvd : ¬ (b ∣ a) := fun h => hr0 (hdvd_iff.mp h)
    have hb_ge : ¬ (0 ≤ b) := by omega
    simp only [ha, hbn, hr0, hndvd, hb_ge, ne_eq, not_false_eq_true, and_true, or_false, ↓reduceIte]
    have hr := hr_pos (by omega)
    have h2 : ((a / b - 1) - (a.tdiv b - 1)) * (-b) = a % b - a.tmod b := by
      rw [Int.mul_neg, Int.sub_mul, Int.sub_mul, Int.sub_mul]; omega
    exact eq_of_mul_sub_lt (by omega) h2 ⟨by omega, by omega⟩
  · have hdvd : b ∣ a := hdvd_iff.mpr hr0
    have hb_ge : 0 ≤ b := by omega
    simp only [ha, hbn, hr0, hdvd, hb_ge, ne_eq, not_true_eq_false, false_and, true_or, ↓reduceIte, Int.sub_zero]
    have hrem0 : a % b = 0 := Int.emod_eq_zero_of_dvd hdvd
    have h2 : (a / b - a.tdiv b) * b = 0 := by rw [Int.sub_mul]; omega
    exact eq_of_mul_sub_lt (by omega) h2 ⟨by omega, by omega⟩
  · have hndvd : ¬ (b ∣ a) := fun h => hr0 (hdvd_iff.mp h)
    have hb_ge : 0 ≤ b := by omega
    simp only [ha, hbn, hr0, hndvd, hb_ge, ne_eq, not_true_eq_false, false_and, true_or, ↓reduceIte, Int.sub_zero]
    have hr := hr_pos (by omega)
    have h2 : (a / b - a.tdiv b) * b = a.tmod b - a % b := by rw [Int.sub_mul]; omega
    exact eq_of_mul_sub_lt (by omega) h2 ⟨by omega, by omega⟩
private theorem cdiv_eq_tdiv_add (a b : Int) (hb : b ≠ 0) :
    -((-a).fdiv b) = a.tdiv b + (if ((a < 0) = (b < 0)) ∧ a.tmod b ≠ 0 then 1 else 0) := by
  rw [fdiv_eq_tdiv_sub (-a) b hb, Int.neg_tdiv, Int.neg_tmod]
  by_cases ha0 : a = 0
  · subst ha0; simp
  · by_cases ha : a < 0 <;> by_cases hbn : b < 0 <;> by_cases hr : a.tmod b = 0 <;>
      simp [ha, hbn, hr, show (-a < 0) ↔ 0 < a by omega, show 0 < a ↔ ¬ a < 0 by omega,
        show -a.tmod b = 0 ↔ a.tmod b = 0 by omega] <;> omega

theorem away_fits_of_rem_ne_zero {t : IntTy} (x y : JInt t)
    (hy0 : y.val ≠ 0) (hr0 : x.val.tmod y.val ≠ 0) :
    let q := x.val.tdiv y.val
    let step := if (x.val < 0) ≠ (y.val < 0) then (-1 : Int) else 1
    t.min ≤ q + step ∧ q + step ≤ t.max := by
  intro q step
  have hx := x.property
  have hy := y.property
  have hmin0 := min_le_zero t
  have hmax127 : 127 ≤ t.max := by cases t <;> decide
  obtain ⟨hqr, hr_pos, hr_neg⟩ := tmod_bounds_strict x.val y.val hy0
  change q * y.val + x.val.tmod y.val = x.val at hqr
  have hy_abs2 : 2 ≤ y.val.natAbs := by
    have hlt := natAbs_tmod_lt x.val y.val hy0
    have hpos := Int.natAbs_pos.mpr hr0
    omega
  have hq_bounds : (0 ≤ x.val → (0 < y.val → 0 ≤ q ∧ q < x.val) ∧ (y.val < 0 → -x.val < q ∧ q ≤ 0)) ∧
      (x.val < 0 → (0 < y.val → x.val < q ∧ q ≤ 0) ∧ (y.val < 0 → 0 ≤ q ∧ q < -x.val)) := by
    refine ⟨fun hx0 => ⟨fun hy_pos => ?_, fun hy_neg => ?_⟩,
            fun hx_neg => ⟨fun hy_pos => ?_, fun hy_neg => ?_⟩⟩
    · have hr := hr_pos hx0
      have hq_nn : 0 ≤ q := (tdiv_between x.val y.val hy_pos).1 hx0 |>.1
      have hmul : q * 2 ≤ q * y.val := Int.mul_le_mul_of_nonneg_left (by omega) hq_nn
      omega
    · have hr := hr_pos hx0
      have hq_np : q ≤ 0 := by
        have := (tdiv_between x.val (-y.val) (by omega)).1 hx0 |>.1
        dsimp [q] at *; rw [Int.tdiv_neg] at this; omega
      have hmul : (-q) * 2 ≤ (-q) * (-y.val) := Int.mul_le_mul_of_nonneg_left (by omega) (by omega)
      have hprod : (-q) * (-y.val) = q * y.val := by rw [Int.neg_mul_neg]
      omega
    · have hr := hr_neg hx_neg
      have hq_np : q ≤ 0 := (tdiv_between x.val y.val hy_pos).2 hx_neg |>.2
      have hmul : (-q) * 2 ≤ (-q) * y.val := Int.mul_le_mul_of_nonneg_left (by omega) (by omega)
      have hprod : (-q) * y.val = -(q * y.val) := by rw [Int.neg_mul]
      omega
    · have hr := hr_neg hx_neg
      have hq_nn : 0 ≤ q := by
        have := (tdiv_between x.val (-y.val) (by omega)).2 hx_neg |>.2
        dsimp [q] at *; rw [Int.tdiv_neg] at this; omega
      have hmul : q * 2 ≤ q * (-y.val) := Int.mul_le_mul_of_nonneg_left (by omega) hq_nn
      have hprod : q * (-y.val) = -(q * y.val) := by rw [Int.mul_neg]
      omega
  by_cases hs : t.signed = true
  · have hmin_eq := max_lt_neg_min_of_signed hs
    have hmin_neg1 := neg_one_ge_min_of_signed hs
    dsimp only [step]
    by_cases hx_lt : x.val < 0 <;> by_cases hy_lt : y.val < 0
    · have hb := (hq_bounds.2 hx_lt).2 hy_lt
      have hq_le_max : q < t.max := by
        have hr := hr_neg hx_lt
        have hmul : q * 2 ≤ q * (-y.val) := Int.mul_le_mul_of_nonneg_left (by omega) hb.1
        have hprod : q * (-y.val) = -(q * y.val) := by rw [Int.mul_neg]
        omega
      have hsame : ¬ ((x.val < 0) ≠ (y.val < 0)) := by simp [hx_lt, hy_lt]
      rw [if_neg hsame]; omega
    · have hb := (hq_bounds.2 hx_lt).1 (by omega)
      have hdiff : (x.val < 0) ≠ (y.val < 0) := by simp [hx_lt, hy_lt]
      rw [if_pos hdiff]; omega
    · have hb := (hq_bounds.1 (by omega)).2 hy_lt
      have hdiff : (x.val < 0) ≠ (y.val < 0) := by simp [hx_lt, hy_lt]
      rw [if_pos hdiff]; omega
    · have hb := (hq_bounds.1 (by omega)).1 (by omega)
      have hsame : ¬ ((x.val < 0) ≠ (y.val < 0)) := by simp [hx_lt, hy_lt]
      rw [if_neg hsame]; omega
  · have hu : t.signed = false := Bool.eq_false_iff.mpr hs
    have hx0 : 0 ≤ x.val := nonneg_of_unsigned hu x
    have hy_pos : 0 < y.val := by have := nonneg_of_unsigned hu y; omega
    have hmin0' : t.min = 0 := min_eq_zero_of_unsigned hu
    have hb := (hq_bounds.1 hx0).1 hy_pos
    dsimp only [step]
    have hsame : ¬ ((x.val < 0) ≠ (y.val < 0)) := by
      have h1 : ¬ (x.val < 0) := by omega
      have h2 : ¬ (y.val < 0) := by omega
      simp [h1, h2]
    rw [if_neg hsame]; omega

theorem rounded_fits_iff {t : IntTy} (x y : JInt t) (hy0 : y.val ≠ 0) (mode : Rounding) :
    (t.min ≤ rounded x.val y.val mode ∧ rounded x.val y.val mode ≤ t.max) ↔
      ¬ (t.signed = true ∧ x.val = t.min ∧ y.val = -1) := by
  constructor
  · rintro ⟨hmin, hmax⟩ ⟨hs, hxmin, hy_neg1⟩
    have hmin_eq := max_lt_neg_min_of_signed hs
    have hmin_lt0 : t.min < 0 := by have := neg_one_ge_min_of_signed hs; omega
    have hq : x.val.tdiv y.val = -t.min := by
      rw [hxmin, hy_neg1, Int.tdiv_neg, Int.tdiv_one]
    have hr : x.val.tmod y.val = 0 := by
      rw [hxmin, hy_neg1, Int.tmod_neg, Int.tmod_one]
    have hf : x.val.fdiv y.val = -t.min := by
      rw [fdiv_eq_tdiv_sub x.val y.val hy0, hq, hr]; simp
    have hc : -((-x.val).fdiv y.val) = -t.min := by
      rw [cdiv_eq_tdiv_add x.val y.val hy0, hq, hr]; simp
    have hlt_abs : 2 * (x.val.tmod y.val).natAbs < y.val.natAbs := by
      rw [hr, hy_neg1]; decide
    unfold rounded at hmax
    dsimp only at hmax
    cases mode <;> simp only [hq, hr, hf, hc, hlt_abs, ↓reduceIte] at hmax <;> omega
  · intro hnot_min
    have hq_fits : t.min ≤ x.val.tdiv y.val ∧ x.val.tdiv y.val ≤ t.max :=
      tdiv_fits x y hy0 hnot_min
    by_cases hr0 : x.val.tmod y.val = 0
    · have hf : x.val.fdiv y.val = x.val.tdiv y.val := by
        rw [fdiv_eq_tdiv_sub x.val y.val hy0, hr0]; simp
      have hc : -((-x.val).fdiv y.val) = x.val.tdiv y.val := by
        rw [cdiv_eq_tdiv_add x.val y.val hy0, hr0]; simp
      have hpos_y : 0 < y.val.natAbs := Int.natAbs_pos.mpr hy0
      cases mode <;> (unfold rounded; dsimp only; (try simp only [hr0, Int.natAbs_zero, Nat.mul_zero, hpos_y, hf, hc, ↓reduceIte]); exact hq_fits)
    · have haway_fits : t.min ≤ x.val.tdiv y.val + (if (x.val < 0) ≠ (y.val < 0) then -1 else 1) ∧
          x.val.tdiv y.val + (if (x.val < 0) ≠ (y.val < 0) then -1 else 1) ≤ t.max :=
        away_fits_of_rem_ne_zero x y hy0 hr0
      have hf : x.val.fdiv y.val =
          if (x.val < 0) ≠ (y.val < 0) then x.val.tdiv y.val - 1 else x.val.tdiv y.val := by
        rw [fdiv_eq_tdiv_sub x.val y.val hy0]
        by_cases hs : (x.val < 0) ≠ (y.val < 0) <;> simp [hs, hr0]
      have hc : -((-x.val).fdiv y.val) =
          if (x.val < 0) = (y.val < 0) then x.val.tdiv y.val + 1 else x.val.tdiv y.val := by
        rw [cdiv_eq_tdiv_add x.val y.val hy0]
        by_cases hs : (x.val < 0) = (y.val < 0) <;> simp [hs, hr0]
      cases mode <;> dsimp [rounded]
      · exact hq_fits
      · rw [hf]
        by_cases hs : (x.val < 0) ≠ (y.val < 0)
        · rw [if_pos hs] at haway_fits ⊢; omega
        · rw [if_neg hs]; exact hq_fits
      · rw [hc]
        by_cases hs : (x.val < 0) = (y.val < 0)
        · have hnot_ne : ¬ ((x.val < 0) ≠ (y.val < 0)) := fun h => h hs
          rw [if_neg hnot_ne] at haway_fits
          rw [if_pos hs]
          exact haway_fits
        · rw [if_neg hs]; exact hq_fits
      all_goals
        have haway_fits' : t.min ≤ x.val.tdiv y.val + (if ¬ (x.val < 0) = (y.val < 0) then -1 else 1) ∧
            x.val.tdiv y.val + (if ¬ (x.val < 0) = (y.val < 0) then -1 else 1) ≤ t.max := haway_fits
        by_cases hs : ¬ (x.val < 0) = (y.val < 0)
        · rw [if_pos hs] at haway_fits'
          simp only [hs, ↓reduceIte]
          repeat (first | exact hq_fits | exact haway_fits' | split)
        · rw [if_neg hs] at haway_fits'
          simp only [hs, ↓reduceIte]
          repeat (first | exact hq_fits | exact haway_fits' | split)
private theorem bitSignbit_eq {t : IntTy} (x : JInt t) :
    JuliaLean.base.div.bitSignbit x = decide (x.val < 0) := by
  unfold JuliaLean.base.div.bitSignbit JuliaLean.base.int.signbit
  by_cases hs : t.signed = true
  · simp only [hs, ↓reduceIte]
    exact (signPredicates_proven t x).1
  · have hu : t.signed = false := Bool.eq_false_iff.mpr hs
    simp only [hu, Bool.false_eq_true, ↓reduceIte]
    exact ((signPredicates_proven t x).2 hu).1

private theorem bitAddBool_val {t : IntTy} (x : JInt t) (b : Bool) :
    (JuliaLean.base.div.bitAddBool x b).val = wrapInt t (x.val + if b then 1 else 0) := by
  unfold JuliaLean.base.div.bitAddBool
  change wrapInt t (x.val + (JuliaLean.base.int.ofBool t b).val) = _
  have hob : (JuliaLean.base.int.ofBool t b).val = if b then 1 else 0 := by
    cases t <;> cases b <;> decide
  rw [hob]

private theorem bitSubBool_val {t : IntTy} (x : JInt t) (b : Bool) :
    (JuliaLean.base.div.bitSubBool x b).val = wrapInt t (x.val - if b then 1 else 0) := by
  unfold JuliaLean.base.div.bitSubBool
  change wrapInt t (x.val - (JuliaLean.base.int.ofBool t b).val) = _
  have hob : (JuliaLean.base.int.ofBool t b).val = if b then 1 else 0 := by
    cases t <;> cases b <;> decide
  rw [hob]
private theorem divSame_mul_eq {t : IntTy} (x y d : JInt t)
    (_hy0 : y.val ≠ 0) (_hnot_min : ¬ (t.signed = true ∧ x.val = t.min ∧ y.val = -1))
    (hd : d.val = x.val.tdiv y.val) :
    (JuliaLean.base.div.bitMul d y).val = x.val - x.val.tmod y.val ∧
    (JuliaLean.base.div.bitSub x (JuliaLean.base.div.bitMul d y)).val = x.val.tmod y.val ∧
    JuliaLean.base.div.bitNeq (JuliaLean.base.div.bitMul d y) x = decide (x.val.tmod y.val ≠ 0) := by
  have hqr := Int.tdiv_mul_add_tmod x.val y.val
  have hr_fits := tmod_fits x y
  have hx_prop := x.property
  have hmin0 := min_le_zero t
  have hmax0 := zero_le_max t
  have hprod_eq : d.val * y.val = x.val - x.val.tmod y.val := by rw [hd]; omega
  have hprod_fits : t.min ≤ d.val * y.val ∧ d.val * y.val ≤ t.max := by
    rw [hprod_eq]
    have htb := tmod_between x.val y.val
    by_cases hx0 : 0 ≤ x.val
    · have := htb.1 hx0; omega
    · have := htb.2 (by omega); omega
  have hmul_val : (JuliaLean.base.div.bitMul d y).val = x.val - x.val.tmod y.val := by
    unfold JuliaLean.base.div.bitMul
    rw [mulSame_val, wrapInt_of_inRange t _ hprod_fits, hprod_eq]
  have hsub_val : (JuliaLean.base.div.bitSub x (JuliaLean.base.div.bitMul d y)).val = x.val.tmod y.val := by
    unfold JuliaLean.base.div.bitSub
    change wrapInt t (x.val - (JuliaLean.base.div.bitMul d y).val) = _
    rw [hmul_val, show x.val - (x.val - x.val.tmod y.val) = x.val.tmod y.val by omega,
      wrapInt_of_inRange t _ hr_fits]
  have hneq : JuliaLean.base.div.bitNeq (JuliaLean.base.div.bitMul d y) x = decide (x.val.tmod y.val ≠ 0) := by
    unfold JuliaLean.base.div.bitNeq
    rw [hmul_val]
    apply decide_eq_decide.mpr
    omega
  exact ⟨hmul_val, hsub_val, hneq⟩

private theorem nearest_quadrant_val {t : IntTy} (x y d rJ : JInt t)
    (hy0 : y.val ≠ 0) (hd_val : d.val = x.val.tdiv y.val) (hrJ_val : rJ.val = x.val.tmod y.val)
    (fPP fPN fNP fNN : Bool) (tieChoice : Int)
    (hodd_f : y.val.tmod 2 ≠ 0 → fPP = true ∧ fPN = true ∧ fNP = true ∧ fNN = true)
    (heven_f : y.val.tmod 2 = 0 →
      (x.val ≥ 0 → y.val ≥ 0 → (if fPP then d.val else d.val + 1) = tieChoice) ∧
      (x.val ≥ 0 → y.val < 0 → (if fPN then d.val else d.val - 1) = tieChoice) ∧
      (x.val < 0 → y.val ≥ 0 → (if fNP then d.val else d.val - 1) = tieChoice) ∧
      (x.val < 0 → y.val < 0 → (if fNN then d.val else d.val + 1) = tieChoice)) :
    (if x.val ≥ 0 then
      if y.val ≥ 0 then
        if rJ.val ≥ y.val.tdiv 2 + JuliaLean.base.div.boolInt fPP
        then (JuliaLean.base.div.bitAddBool d true, JuliaLean.base.div.bitSub rJ y) else (d, rJ)
      else
        if rJ.val ≥ -(y.val.tdiv 2) + JuliaLean.base.div.boolInt fPN
        then (JuliaLean.base.div.bitSubBool d true, JuliaLean.base.div.bitAdd rJ y) else (d, rJ)
    else if y.val ≥ 0 then
      if rJ.val ≤ -(y.val.tdiv 2) - JuliaLean.base.div.boolInt fNP
      then (JuliaLean.base.div.bitSubBool d true, JuliaLean.base.div.bitAdd rJ y) else (d, rJ)
    else if rJ.val ≤ y.val.tdiv 2 - JuliaLean.base.div.boolInt fNN
    then (JuliaLean.base.div.bitAddBool d true, JuliaLean.base.div.bitSub rJ y)
    else (d, rJ)).1.val =
      (if 2 * (x.val.tmod y.val).natAbs < y.val.natAbs then d.val
       else if 2 * (x.val.tmod y.val).natAbs > y.val.natAbs then
         d.val + (if (x.val < 0) ≠ (y.val < 0) then -1 else 1)
       else tieChoice) := by
  have hy2 := Int.tdiv_mul_add_tmod y.val 2
  have hy2_b := tmod_bounds_strict y.val 2 (by decide)
  obtain ⟨_, hr_pos, hr_neg⟩ := tmod_bounds_strict x.val y.val hy0
  rw [hrJ_val]
  by_cases hx_nn : x.val ≥ 0 <;> by_cases hy_nn : y.val ≥ 0
  · have hy_pos : 0 < y.val := by omega
    have hr_b := hr_pos hx_nn
    have hy2_pos := hy2_b.2.1 hy_nn
    clear hy2_b hr_pos hr_neg
    have hsame : ¬ ((x.val < 0) ≠ (y.val < 0)) := by
      simp [show ¬ x.val < 0 by omega, show ¬ y.val < 0 by omega]
    simp only [hx_nn, hy_nn, hsame, ↓reduceIte]
    by_cases hcond : x.val.tmod y.val ≥ y.val.tdiv 2 + JuliaLean.base.div.boolInt fPP
    · have hr_nz : x.val.tmod y.val ≠ 0 := by
        intro hr0
        by_cases hm2 : y.val.tmod 2 = 0
        · clear hodd_f heven_f
          unfold JuliaLean.base.div.boolInt at hcond; split at hcond <;> omega
        · have hf := (hodd_f hm2).1
          clear hodd_f heven_f
          unfold JuliaLean.base.div.boolInt at hcond; simp [hf] at hcond; omega
      have haway : t.min ≤ d.val + 1 ∧ d.val + 1 ≤ t.max := by
        have h := away_fits_of_rem_ne_zero x y hy0 hr_nz
        dsimp only at h
        rw [if_neg hsame, ← hd_val] at h
        exact h
      have hadd : (JuliaLean.base.div.bitAddBool d true).val = d.val + 1 := by
        rw [bitAddBool_val, if_pos rfl, wrapInt_of_inRange t _ haway]
      simp only [if_pos hcond, hadd]
      by_cases hm2 : y.val.tmod 2 = 0
      · have hev := (heven_f hm2).1 hx_nn hy_nn
        clear hodd_f heven_f
        cases fPP <;> simp [JuliaLean.base.div.boolInt] at hcond hev <;>
          split <;> (try split) <;> omega
      · have hf := (hodd_f hm2).1
        clear hodd_f heven_f
        simp [hf, JuliaLean.base.div.boolInt] at hcond
        split <;> (try split) <;> omega
    · simp only [if_neg hcond]
      by_cases hm2 : y.val.tmod 2 = 0
      · have hev := (heven_f hm2).1 hx_nn hy_nn
        clear hodd_f heven_f
        cases fPP <;> simp [JuliaLean.base.div.boolInt] at hcond hev <;>
          split <;> (try split) <;> omega
      · have hf := (hodd_f hm2).1
        clear hodd_f heven_f
        simp [hf, JuliaLean.base.div.boolInt] at hcond
        split <;> (try split) <;> omega
  · have hy_neg : y.val < 0 := by omega
    have hr_b := hr_pos hx_nn
    have hy2_neg := hy2_b.2.2 hy_neg
    clear hy2_b hr_pos hr_neg
    have hdiff : (x.val < 0) ≠ (y.val < 0) := by
      simp [show ¬ x.val < 0 by omega, hy_neg]
    simp only [hx_nn, hy_nn, hdiff, ↓reduceIte]
    by_cases hcond : x.val.tmod y.val ≥ -(y.val.tdiv 2) + JuliaLean.base.div.boolInt fPN
    · have hr_nz : x.val.tmod y.val ≠ 0 := by
        intro hr0
        by_cases hm2 : y.val.tmod 2 = 0
        · clear hodd_f heven_f
          unfold JuliaLean.base.div.boolInt at hcond; split at hcond <;> omega
        · have hf := (hodd_f hm2).2.1
          clear hodd_f heven_f
          unfold JuliaLean.base.div.boolInt at hcond; simp [hf] at hcond; omega
      have haway : t.min ≤ d.val - 1 ∧ d.val - 1 ≤ t.max := by
        have h := away_fits_of_rem_ne_zero x y hy0 hr_nz
        dsimp only at h
        rw [if_pos hdiff, ← hd_val] at h
        omega
      have hsub : (JuliaLean.base.div.bitSubBool d true).val = d.val - 1 := by
        rw [bitSubBool_val, if_pos rfl, wrapInt_of_inRange t _ haway]
      simp only [if_pos hcond, hsub]
      by_cases hm2 : y.val.tmod 2 = 0
      · have hev := (heven_f hm2).2.1 hx_nn hy_neg
        clear hodd_f heven_f
        cases fPN <;> simp [JuliaLean.base.div.boolInt] at hcond hev <;>
          split <;> (try split) <;> omega
      · have hf := (hodd_f hm2).2.1
        clear hodd_f heven_f
        simp [hf, JuliaLean.base.div.boolInt] at hcond
        split <;> (try split) <;> omega
    · simp only [if_neg hcond]
      by_cases hm2 : y.val.tmod 2 = 0
      · have hev := (heven_f hm2).2.1 hx_nn hy_neg
        clear hodd_f heven_f
        cases fPN <;> simp [JuliaLean.base.div.boolInt] at hcond hev <;>
          split <;> (try split) <;> omega
      · have hf := (hodd_f hm2).2.1
        clear hodd_f heven_f
        simp [hf, JuliaLean.base.div.boolInt] at hcond
        split <;> (try split) <;> omega
  · have hx_neg : x.val < 0 := by omega
    have hy_pos : 0 < y.val := by omega
    have hr_b := hr_neg hx_neg
    have hy2_pos := hy2_b.2.1 hy_nn
    clear hy2_b hr_pos hr_neg
    have hdiff : (x.val < 0) ≠ (y.val < 0) := by
      simp [hx_neg, show ¬ y.val < 0 by omega]
    simp only [hx_nn, hy_nn, hdiff, ↓reduceIte]
    by_cases hcond : x.val.tmod y.val ≤ -(y.val.tdiv 2) - JuliaLean.base.div.boolInt fNP
    · have hr_nz : x.val.tmod y.val ≠ 0 := by
        intro hr0
        by_cases hm2 : y.val.tmod 2 = 0
        · clear hodd_f heven_f
          unfold JuliaLean.base.div.boolInt at hcond; split at hcond <;> omega
        · have hf := (hodd_f hm2).2.2.1
          clear hodd_f heven_f
          unfold JuliaLean.base.div.boolInt at hcond; simp [hf] at hcond; omega
      have haway : t.min ≤ d.val - 1 ∧ d.val - 1 ≤ t.max := by
        have h := away_fits_of_rem_ne_zero x y hy0 hr_nz
        dsimp only at h
        rw [if_pos hdiff, ← hd_val] at h
        omega
      have hsub : (JuliaLean.base.div.bitSubBool d true).val = d.val - 1 := by
        rw [bitSubBool_val, if_pos rfl, wrapInt_of_inRange t _ haway]
      simp only [if_pos hcond, hsub]
      by_cases hm2 : y.val.tmod 2 = 0
      · have hev := (heven_f hm2).2.2.1 hx_neg hy_nn
        clear hodd_f heven_f
        cases fNP <;> simp [JuliaLean.base.div.boolInt] at hcond hev <;>
          split <;> (try split) <;> omega
      · have hf := (hodd_f hm2).2.2.1
        clear hodd_f heven_f
        simp [hf, JuliaLean.base.div.boolInt] at hcond
        split <;> (try split) <;> omega
    · simp only [if_neg hcond]
      by_cases hm2 : y.val.tmod 2 = 0
      · have hev := (heven_f hm2).2.2.1 hx_neg hy_nn
        clear hodd_f heven_f
        cases fNP <;> simp [JuliaLean.base.div.boolInt] at hcond hev <;>
          split <;> (try split) <;> omega
      · have hf := (hodd_f hm2).2.2.1
        clear hodd_f heven_f
        simp [hf, JuliaLean.base.div.boolInt] at hcond
        split <;> (try split) <;> omega
  · have hx_neg : x.val < 0 := by omega
    have hy_neg : y.val < 0 := by omega
    have hr_b := hr_neg hx_neg
    have hy2_neg := hy2_b.2.2 hy_neg
    clear hy2_b hr_pos hr_neg
    have hsame : ¬ ((x.val < 0) ≠ (y.val < 0)) := by
      simp [hx_neg, hy_neg]
    simp only [hx_nn, hy_nn, hsame, ↓reduceIte]
    by_cases hcond : x.val.tmod y.val ≤ y.val.tdiv 2 - JuliaLean.base.div.boolInt fNN
    · have hr_nz : x.val.tmod y.val ≠ 0 := by
        intro hr0
        by_cases hm2 : y.val.tmod 2 = 0
        · clear hodd_f heven_f
          unfold JuliaLean.base.div.boolInt at hcond; split at hcond <;> omega
        · have hf := (hodd_f hm2).2.2.2
          clear hodd_f heven_f
          unfold JuliaLean.base.div.boolInt at hcond; simp [hf] at hcond; omega
      have haway : t.min ≤ d.val + 1 ∧ d.val + 1 ≤ t.max := by
        have h := away_fits_of_rem_ne_zero x y hy0 hr_nz
        dsimp only at h
        rw [if_neg hsame, ← hd_val] at h
        exact h
      have hadd : (JuliaLean.base.div.bitAddBool d true).val = d.val + 1 := by
        rw [bitAddBool_val, if_pos rfl, wrapInt_of_inRange t _ haway]
      simp only [if_pos hcond, hadd]
      by_cases hm2 : y.val.tmod 2 = 0
      · have hev := (heven_f hm2).2.2.2 hx_neg hy_neg
        clear hodd_f heven_f
        cases fNN <;> simp [JuliaLean.base.div.boolInt] at hcond hev <;>
          split <;> (try split) <;> omega
      · have hf := (hodd_f hm2).2.2.2
        clear hodd_f heven_f
        simp [hf, JuliaLean.base.div.boolInt] at hcond
        split <;> (try split) <;> omega
    · simp only [if_neg hcond]
      by_cases hm2 : y.val.tmod 2 = 0
      · have hev := (heven_f hm2).2.2.2 hx_neg hy_neg
        clear hodd_f heven_f
        cases fNN <;> simp [JuliaLean.base.div.boolInt] at hcond hev <;>
          split <;> (try split) <;> omega
      · have hf := (hodd_f hm2).2.2.2
        clear hodd_f heven_f
        simp [hf, JuliaLean.base.div.boolInt] at hcond
        split <;> (try split) <;> omega

private theorem nearest_quadrant_ok {t : IntTy} (x y d rJ : JInt t) (fPP fPN fNP fNN : Bool) :
    Except.bind
      (if x.val ≥ 0 then
        if y.val ≥ 0 then
          if rJ.val ≥ y.val.tdiv 2 + JuliaLean.base.div.boolInt fPP
          then (Except.ok (JuliaLean.base.div.bitAddBool d true, JuliaLean.base.div.bitSub rJ y) : Except JlError (JInt t × JInt t))
          else Except.ok (d, rJ)
        else
          if rJ.val ≥ -(y.val.tdiv 2) + JuliaLean.base.div.boolInt fPN
          then Except.ok (JuliaLean.base.div.bitSubBool d true, JuliaLean.base.div.bitAdd rJ y)
          else Except.ok (d, rJ)
      else if y.val ≥ 0 then
        if rJ.val ≤ -(y.val.tdiv 2) - JuliaLean.base.div.boolInt fNP
        then Except.ok (JuliaLean.base.div.bitSubBool d true, JuliaLean.base.div.bitAdd rJ y)
        else Except.ok (d, rJ)
      else if rJ.val ≤ y.val.tdiv 2 - JuliaLean.base.div.boolInt fNN
      then Except.ok (JuliaLean.base.div.bitAddBool d true, JuliaLean.base.div.bitSub rJ y)
      else Except.ok (d, rJ))
      (fun v => Except.ok v.1) =
    Except.ok (if x.val ≥ 0 then
      if y.val ≥ 0 then
        if rJ.val ≥ y.val.tdiv 2 + JuliaLean.base.div.boolInt fPP
        then (JuliaLean.base.div.bitAddBool d true, JuliaLean.base.div.bitSub rJ y) else (d, rJ)
      else
        if rJ.val ≥ -(y.val.tdiv 2) + JuliaLean.base.div.boolInt fPN
        then (JuliaLean.base.div.bitSubBool d true, JuliaLean.base.div.bitAdd rJ y) else (d, rJ)
    else if y.val ≥ 0 then
      if rJ.val ≤ -(y.val.tdiv 2) - JuliaLean.base.div.boolInt fNP
      then (JuliaLean.base.div.bitSubBool d true, JuliaLean.base.div.bitAdd rJ y) else (d, rJ)
    else if rJ.val ≤ y.val.tdiv 2 - JuliaLean.base.div.boolInt fNN
    then (JuliaLean.base.div.bitAddBool d true, JuliaLean.base.div.bitSub rJ y)
    else (d, rJ)).1 := by
  by_cases h1 : x.val ≥ 0 <;> by_cases h2 : y.val ≥ 0 <;> simp only [h1, h2, ↓reduceIte]
  · by_cases h3 : rJ.val ≥ y.val.tdiv 2 + JuliaLean.base.div.boolInt fPP <;> simp [h3, Except.bind]
  · by_cases h4 : rJ.val ≥ -(y.val.tdiv 2) + JuliaLean.base.div.boolInt fPN <;> simp [h4, Except.bind]
  · by_cases h5 : rJ.val ≤ -(y.val.tdiv 2) - JuliaLean.base.div.boolInt fNP <;> simp [h5, Except.bind]
  · by_cases h6 : rJ.val ≤ y.val.tdiv 2 - JuliaLean.base.div.boolInt fNN <;> simp [h6, Except.bind]
theorem divBitIntegerMode_spec {t : IntTy} (x y : JInt t) (mode : Rounding) :
    let ans := rounded x.val y.val mode
    (y.val = 0 →
      JuliaLean.base.div.divBitIntegerMode x y (sourceRoundingMode mode) = .error .divideError) ∧
    (y.val ≠ 0 → (t.min ≤ ans ∧ ans ≤ t.max) →
      ∃ q : JInt t,
        JuliaLean.base.div.divBitIntegerMode x y (sourceRoundingMode mode) = .ok q ∧
        q.val = ans) ∧
    (y.val ≠ 0 → ¬ (t.min ≤ ans ∧ ans ≤ t.max) →
      JuliaLean.base.div.divBitIntegerMode x y (sourceRoundingMode mode) = .error .divideError) := by
  intro ans
  have herr : (y.val = 0 ∨ (t.signed = true ∧ x.val = t.min ∧ y.val = -1)) →
      JuliaLean.base.div.divBitIntegerMode x y (sourceRoundingMode mode) = .error .divideError := by
    intro hbad
    have hdiv_err : JuliaLean.base.int.divSame x y = .error .divideError := by
      rw [divSame_eq, if_pos hbad]
    have htoZero_err : JuliaLean.base.div.divBitIntegerToZero x y = .error .divideError := hdiv_err
    have hdown_err : JuliaLean.base.div.divBitIntegerDown x y = .error .divideError := by
      unfold JuliaLean.base.div.divBitIntegerDown
      split <;> simp [JuliaLean.base.div.div_Integer_Down, JuliaLean.base.div.div_Unsigned_Down,
        htoZero_err, hdiv_err, Bind.bind, Except.bind]
    have hup_err : JuliaLean.base.div.divBitIntegerUp x y = .error .divideError := by
      unfold JuliaLean.base.div.divBitIntegerUp
      split <;> simp [JuliaLean.base.div.div_Integer_Up, JuliaLean.base.div.div_Unsigned_Up,
        htoZero_err, Bind.bind, Except.bind]
    have hdr_err : JuliaLean.base.div.divremBitIntegerToZero x y = .error .divideError := by
      unfold JuliaLean.base.div.divremBitIntegerToZero
      split <;> simp [JuliaLean.base.div.divrem_BitSigned_Directed,
        JuliaLean.base.div.divrem_Integer_Directed, htoZero_err, Bind.bind, Except.bind]
    cases mode <;> simp [JuliaLean.base.div.divBitIntegerMode, sourceRoundingMode,
      htoZero_err, hdown_err, hup_err, JuliaLean.base.div.div_Integer_FromZero,
      JuliaLean.base.div.divBitIntegerUpDown, JuliaLean.base.div.div_Integer_Nearest,
      JuliaLean.base.div.divremBitIntegerNearestModes,
      JuliaLean.base.div.divremBitIntegerNearest, JuliaLean.base.div.divrem_Integer_Nearest,
      JuliaLean.base.div.divremBitIntegerTiesAway, JuliaLean.base.div.divrem_Integer_NearestTiesAway,
      JuliaLean.base.div.divremBitIntegerTiesUp, JuliaLean.base.div.divrem_Integer_NearestTiesUp,
      hdr_err, Bind.bind, Except.bind]
  refine ⟨fun hy0 => herr (Or.inl hy0), fun hy0 hfit => ?_, fun hy0 hnot_fit => ?_⟩
  · have hnot_min : ¬ (t.signed = true ∧ x.val = t.min ∧ y.val = -1) :=
      (rounded_fits_iff x y hy0 mode).mp hfit
    have hnot_bad : ¬ (y.val = 0 ∨ (t.signed = true ∧ x.val = t.min ∧ y.val = -1)) :=
      fun h => h.elim hy0 hnot_min
    have hq_fits := tdiv_fits x y hy0 hnot_min
    let d := JuliaLean.base.int.lit t (x.val.tdiv y.val)
    have hd_val : d.val = x.val.tdiv y.val := lit_of_fits hq_fits
    have hdiv_ok : JuliaLean.base.int.divSame x y = .ok d := by
      rw [divSame_eq, if_neg hnot_bad]
    have htoZero_ok : JuliaLean.base.div.divBitIntegerToZero x y = .ok d := hdiv_ok
    obtain ⟨hmul_val, hsub_val, hneq⟩ := divSame_mul_eq x y d hy0 hnot_min hd_val
    let rJ := JuliaLean.base.div.bitSub x (JuliaLean.base.div.bitMul d y)
    have hdr_ok : JuliaLean.base.div.divremBitIntegerToZero x y = .ok (d, rJ) := by
      unfold JuliaLean.base.div.divremBitIntegerToZero
      split <;> simp [JuliaLean.base.div.divrem_BitSigned_Directed,
        JuliaLean.base.div.divrem_Integer_Directed, htoZero_ok, Bind.bind, Except.bind,
        Pure.pure, Except.pure, rJ]
    have hdown_ok : ∃ qd : JInt t,
        JuliaLean.base.div.divBitIntegerDown x y = .ok qd ∧ qd.val = x.val.fdiv y.val := by
      unfold JuliaLean.base.div.divBitIntegerDown
      have hf_eq := fdiv_eq_tdiv_sub x.val y.val hy0
      have hf_fits : t.min ≤ x.val.fdiv y.val ∧ x.val.fdiv y.val ≤ t.max :=
        (rounded_fits_iff x y hy0 .down).mpr hnot_min
      by_cases hs : t.signed = true
      · simp only [hs, ↓reduceIte, JuliaLean.base.div.div_Integer_Down, htoZero_ok,
          Bind.bind, Except.bind, Pure.pure, Except.pure]
        refine ⟨_, rfl, ?_⟩
        rw [bitSubBool_val, bitSignbit_eq, hneq, hd_val]
        have hxor_neg : ((JuliaLean.base.div.bitXor x y).val < 0) ↔ ((x.val < 0) ≠ (y.val < 0)) := by
          have hbx := bxor_neg_iff hs x y
          unfold JuliaLean.base.div.bitXor
          change (JuliaLean.base.int.bxor x y).val < 0 ↔ _
          rw [hbx]
          by_cases h1 : x.val < 0 <;> by_cases h2 : y.val < 0 <;> simp [h1, h2]
        have hcond : (decide ((JuliaLean.base.div.bitXor x y).val < 0) && decide (x.val.tmod y.val ≠ 0)) =
            decide (((x.val < 0) ≠ (y.val < 0)) ∧ x.val.tmod y.val ≠ 0) := by
          rw [← Bool.decide_and]
          exact decide_eq_decide.mpr (and_congr_left' hxor_neg)
        rw [hcond]
        have hval_eq : x.val.tdiv y.val -
            (if decide (((x.val < 0) ≠ (y.val < 0)) ∧ x.val.tmod y.val ≠ 0) = true then 1 else 0) =
            x.val.fdiv y.val := by
          rw [hf_eq]
          by_cases hc : ((x.val < 0) ≠ (y.val < 0)) ∧ x.val.tmod y.val ≠ 0 <;> simp [hc]
        rw [hval_eq, wrapInt_of_inRange t _ hf_fits]
      · have hu : t.signed = false := Bool.eq_false_iff.mpr hs
        simp only [hu, Bool.false_eq_true, ↓reduceIte, JuliaLean.base.div.div_Unsigned_Down, hdiv_ok]
        have hx0 : 0 ≤ x.val := nonneg_of_unsigned hu x
        have hy_nn : 0 ≤ y.val := nonneg_of_unsigned hu y
        refine ⟨d, rfl, ?_⟩
        have hsame : ¬ (((x.val < 0) ≠ (y.val < 0)) ∧ x.val.tmod y.val ≠ 0) := by
          have h1 : ¬ (x.val < 0) := by omega
          have h2 : ¬ (y.val < 0) := by omega
          simp [h1, h2]
        rw [hd_val, hf_eq, if_neg hsame, Int.sub_zero]
    have hup_ok : ∃ qu : JInt t,
        JuliaLean.base.div.divBitIntegerUp x y = .ok qu ∧ qu.val = -((-x.val).fdiv y.val) := by
      unfold JuliaLean.base.div.divBitIntegerUp
      have hc_eq := cdiv_eq_tdiv_add x.val y.val hy0
      have hc_fits : t.min ≤ -((-x.val).fdiv y.val) ∧ -((-x.val).fdiv y.val) ≤ t.max :=
        (rounded_fits_iff x y hy0 .up).mpr hnot_min
      by_cases hs : t.signed = true
      · simp only [hs, ↓reduceIte, JuliaLean.base.div.div_Integer_Up, htoZero_ok,
          Bind.bind, Except.bind, Pure.pure, Except.pure]
        refine ⟨_, rfl, ?_⟩
        rw [bitAddBool_val, hneq, hd_val]
        have hcond : (decide (JuliaLean.base.div.bitGtZero x = JuliaLean.base.div.bitGtZero y) &&
            decide (x.val.tmod y.val ≠ 0)) =
            decide (((x.val < 0) = (y.val < 0)) ∧ x.val.tmod y.val ≠ 0) := by
          unfold JuliaLean.base.div.bitGtZero
          rw [← Bool.decide_and]
          apply decide_eq_decide.mpr
          by_cases hr0 : x.val.tmod y.val = 0
          · simp [hr0]
          · have hx0 : x.val ≠ 0 := fun h => hr0 (by rw [h, Int.zero_tmod])
            by_cases h1 : x.val < 0 <;> by_cases h2 : y.val < 0 <;>
              simp [hr0, h1, h2, show (x.val > 0) ↔ ¬ (x.val < 0) by omega,
                show (y.val > 0) ↔ ¬ (y.val < 0) by omega]
        rw [hcond]
        have hval_eq : x.val.tdiv y.val +
            (if decide (((x.val < 0) = (y.val < 0)) ∧ x.val.tmod y.val ≠ 0) = true then 1 else 0) =
            -((-x.val).fdiv y.val) := by
          rw [hc_eq]
          by_cases hc : ((x.val < 0) = (y.val < 0)) ∧ x.val.tmod y.val ≠ 0 <;> simp [hc]
        rw [hval_eq, wrapInt_of_inRange t _ hc_fits]
      · have hu : t.signed = false := Bool.eq_false_iff.mpr hs
        simp only [hu, Bool.false_eq_true, ↓reduceIte, JuliaLean.base.div.div_Unsigned_Up,
          htoZero_ok, Bind.bind, Except.bind, Pure.pure, Except.pure]
        have hx0 : 0 ≤ x.val := nonneg_of_unsigned hu x
        have hy_nn : 0 ≤ y.val := nonneg_of_unsigned hu y
        refine ⟨_, rfl, ?_⟩
        rw [bitAddBool_val, hneq, hd_val]
        have hval_eq : x.val.tdiv y.val + (if decide (x.val.tmod y.val ≠ 0) = true then 1 else 0) =
            -((-x.val).fdiv y.val) := by
          rw [hc_eq]
          have hsame : (x.val < 0) = (y.val < 0) := by
            apply propext; exact ⟨fun h => absurd h (by omega), fun h => absurd h (by omega)⟩
          by_cases hr0 : x.val.tmod y.val = 0 <;> simp [hsame, hr0]
        rw [hval_eq, wrapInt_of_inRange t _ hc_fits]
    have hquad := nearest_quadrant_val x y d rJ hy0 hd_val hsub_val
    cases mode
    · simp only [JuliaLean.base.div.divBitIntegerMode, sourceRoundingMode, ↓reduceIte]
      exact ⟨d, htoZero_ok, hd_val⟩
    · simp only [JuliaLean.base.div.divBitIntegerMode, sourceRoundingMode, reduceCtorEq, ↓reduceIte]
      exact hdown_ok
    · simp only [JuliaLean.base.div.divBitIntegerMode, sourceRoundingMode, reduceCtorEq, ↓reduceIte]
      exact hup_ok
    · -- .nearest
      simp only [JuliaLean.base.div.divBitIntegerMode, sourceRoundingMode, reduceCtorEq, ↓reduceIte,
        JuliaLean.base.div.div_Integer_Nearest, JuliaLean.base.div.divremBitIntegerNearestModes,
        JuliaLean.base.div.divremBitIntegerNearest, JuliaLean.base.div.divrem_Integer_Nearest,
        hdr_ok, Bind.bind, Except.bind, Pure.pure, Except.pure]
      unfold JuliaLean.base.div.bitVal JuliaLean.base.div.bitHalf
      let tie := JuliaLean.base.div.bitIsOdd y || JuliaLean.base.div.bitIsEven d
      have hd2_iff : (d.val.tmod 2 = 0) ↔ (d.val % 2 = 0) := by
        rw [← Int.dvd_iff_tmod_eq_zero, Int.dvd_iff_emod_eq_zero]
      refine ⟨_, nearest_quadrant_ok x y d rJ tie tie tie tie, ?_⟩
      have hq_step := hquad tie tie tie tie
        (if d.val % 2 = 0 then d.val else d.val + if (x.val < 0) ≠ (y.val < 0) then -1 else 1)
        (fun hm2 => by
          have : JuliaLean.base.div.bitIsOdd y = true := decide_eq_true hm2
          simp [tie, this])
        (fun hm2 => by
          have : JuliaLean.base.div.bitIsOdd y = false := decide_eq_false (not_not_intro hm2)
          have hev : JuliaLean.base.div.bitIsEven d = decide (d.val % 2 = 0) :=
            decide_eq_decide.mpr hd2_iff
          simp only [tie, this, Bool.false_or, hev]
          by_cases hd_ev : d.val % 2 = 0 <;>
            by_cases hx_lt : x.val < 0 <;> by_cases hy_lt : y.val < 0 <;>
            simp [hd_ev, hx_lt, hy_lt] <;> omega)
      unfold ans rounded
      simp only [reduceCtorEq, ↓reduceIte, ← hd_val]
      exact hq_step
    · -- .nearestAway
      simp only [JuliaLean.base.div.divBitIntegerMode, sourceRoundingMode, reduceCtorEq, ↓reduceIte,
        JuliaLean.base.div.div_Integer_Nearest, JuliaLean.base.div.divremBitIntegerNearestModes,
        JuliaLean.base.div.divremBitIntegerTiesAway, JuliaLean.base.div.divrem_Integer_NearestTiesAway,
        hdr_ok, Bind.bind, Except.bind, Pure.pure, Except.pure]
      unfold JuliaLean.base.div.bitVal JuliaLean.base.div.bitHalf
      let oddY := JuliaLean.base.div.bitIsOdd y
      refine ⟨_, nearest_quadrant_ok x y d rJ oddY oddY oddY oddY, ?_⟩
      have hq_step := hquad oddY oddY oddY oddY
        (d.val + if (x.val < 0) ≠ (y.val < 0) then -1 else 1)
        (fun hm2 => by
          have : oddY = true := decide_eq_true hm2
          simp [this])
        (fun hm2 => by
          have : oddY = false := decide_eq_false (not_not_intro hm2)
          by_cases hx_lt : x.val < 0 <;> by_cases hy_lt : y.val < 0 <;>
            simp [this, hx_lt, hy_lt] <;> omega)
      unfold ans rounded
      simp only [↓reduceIte, ← hd_val]
      exact hq_step
    · -- .nearestUp
      simp only [JuliaLean.base.div.divBitIntegerMode, sourceRoundingMode, reduceCtorEq, ↓reduceIte,
        JuliaLean.base.div.div_Integer_Nearest, JuliaLean.base.div.divremBitIntegerNearestModes,
        JuliaLean.base.div.divremBitIntegerTiesUp, JuliaLean.base.div.divrem_Integer_NearestTiesUp,
        hdr_ok, Bind.bind, Except.bind, Pure.pure, Except.pure]
      unfold JuliaLean.base.div.bitVal JuliaLean.base.div.bitHalf
      let oddY := JuliaLean.base.div.bitIsOdd y
      refine ⟨_, nearest_quadrant_ok x y d rJ oddY true true oddY, ?_⟩
      have hq_step := hquad oddY true true oddY
        (if (if (x.val < 0) ≠ (y.val < 0) then (-1 : Int) else 1) < 0 then d.val
         else d.val + if (x.val < 0) ≠ (y.val < 0) then -1 else 1)
        (fun hm2 => by
          have : oddY = true := decide_eq_true hm2
          simp [this])
        (fun hm2 => by
          have : oddY = false := decide_eq_false (not_not_intro hm2)
          by_cases hx_lt : x.val < 0 <;> by_cases hy_lt : y.val < 0 <;>
            simp [this, hx_lt, hy_lt] <;> omega)
      unfold ans rounded
      simp only [reduceCtorEq, ↓reduceIte, ← hd_val]
      exact hq_step
    · -- .fromZero
      simp only [JuliaLean.base.div.divBitIntegerMode, sourceRoundingMode, reduceCtorEq, ↓reduceIte,
        JuliaLean.base.div.div_Integer_FromZero, JuliaLean.base.div.divBitIntegerUpDown]
      rw [bitSignbit_eq x, bitSignbit_eq y]
      unfold ans rounded
      have hf_eq := fdiv_eq_tdiv_sub x.val y.val hy0
      have hc_eq := cdiv_eq_tdiv_add x.val y.val hy0
      by_cases hs : decide (x.val < 0) = decide (y.val < 0)
      · simp only [hs, ↓reduceIte]
        obtain ⟨qu, hqu_ok, hqu_val⟩ := hup_ok
        refine ⟨qu, hqu_ok, ?_⟩
        have hsame : (x.val < 0) = (y.val < 0) := by
          apply propext; exact decide_eq_decide.mp hs
        rw [hqu_val, hc_eq]
        by_cases hr0 : x.val.tmod y.val = 0 <;> simp [hsame, hr0]
      · simp only [hs, ↓reduceIte]
        obtain ⟨qd, hqd_ok, hqd_val⟩ := hdown_ok
        refine ⟨qd, hqd_ok, ?_⟩
        have hdiff : (x.val < 0) ≠ (y.val < 0) := fun heq => hs (decide_eq_decide.mpr (Eq.to_iff heq))
        rw [hqd_val, hf_eq]
        by_cases hr0 : x.val.tmod y.val = 0 <;> simp [hdiff, hr0] <;> omega
  · have hbad : y.val = 0 ∨ (t.signed = true ∧ x.val = t.min ∧ y.val = -1) :=
      Or.inr (Decidable.byContradiction fun hnot => hnot_fit ((rounded_fits_iff x y hy0 mode).mpr hnot))
    exact herr hbad

end ComparisonAndRoundingLemmas

