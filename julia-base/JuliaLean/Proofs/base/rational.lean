namespace JuliaLean.Proofs.base.rational.FloatRoundTripProof
open JuliaLean JuliaLean.Promotion JuliaLean.base.rational
open JuliaLean.Proofs.base.rational.Round4

/-- Every successful `rationalize` result comes from the constructor or from the infinite
branch, so a property of both holds for the result. -/
private theorem rationalizeOk_preserves {F Tol : Type} (t : IntTy) (ops : RatIntOps (JInt t))
    (P : Rat t → Prop)
    (ltZeroTol : Tol → Bool) (ltZeroF isnanF isinfF : F → Bool) (absF truncF zeroF oneF : F → F)
    (oftypeF : F → Tol → F) (gtF : F → F → Bool) (subF addF mulF cldF : F → F → F)
    (divremF : F → F → F × F) (convertTF : F → Jl (JInt t)) (leTwo : F → Bool)
    (gtHalf : JInt t → F → Bool) (exactDivide : JInt t → JInt t → Jl (Rat t))
    (x : F) (tol : Tol) (showTol : Tol → String) (q : Rat t)
    (hex : ∀ u v r, exactDivide u v = .ok r → P r)
    (hinfNeg : ops.isUnsignedOrBool = false → P (unsafeRationalSameSource ops.minusOne ops.zero))
    (hinfPos : P (unsafeRationalSameSource ops.one ops.zero))
    (h : rationalizeAbstractFloatSource (JInt t) ops ltZeroTol ltZeroF isnanF isinfF absF truncF
      zeroF oneF oftypeF gtF subF addF mulF cldF divremF convertTF leTwo gtHalf exactDivide
      x tol showTol = some (.ok q)) : P q := by
  unfold rationalizeAbstractFloatSource at h
  by_cases h1 : ltZeroTol tol = true
  · simp [h1, throw, throwThe, MonadExceptOf.throw, Bind.bind, ExceptT.bind, ExceptT.pure,
      ExceptT.mk, ExceptT.bindCont, Option.bind, Except.bind] at h <;> cases Option.some.inj h
  · by_cases h2 : (ops.isUnsignedOrBool && ltZeroF x) = true
    · simp [h1, h2, throwNegateUnsignedSource, throw, throwThe, MonadExceptOf.throw, ExceptT.mk,
        ExceptT.bind, ExceptT.bindCont, Option.bind, Bind.bind, ExceptT.pure, Except.bind] at h <;>
        cases Option.some.inj h
    · simp only [h1, h2, Bool.false_eq_true, ↓reduceIte, Bind.bind, ExceptT.mk, ExceptT.bindCont,
        ExceptT.bind, ExceptT.pure, Option.bind, Except.bind, Pure.pure, Except.pure] at h
      split at h
      · cases htx : convertTF x with
        | error e =>
          simp only [htx, ExceptT.bind, ExceptT.bindCont, ExceptT.mk, Pure.pure, Option.bind,
            Option.some.injEq] at h
          cases h
        | ok tx =>
          simp only [htx, ExceptT.bind, ExceptT.bindCont, ExceptT.mk, Pure.pure, Option.bind,
            Option.some.injEq] at h
          exact hex tx ops.one q (Option.some.inj h)
      · split at h
        · have hq : unsafeRationalSameSource (if ltZeroF x = true then ops.minusOne else ops.one)
              ops.zero = q := Except.ok.inj (Option.some.inj h)
          subst hq
          split
          · rename_i hneg
            apply hinfNeg
            cases hu : ops.isUnsignedOrBool
            · rfl
            · simp [hu, hneg] at h2
          · exact hinfPos
        · exact JuliaLean.Proofs.base.rational.genericRationalizeWhile_preserves ops _ _ _ _ _ _ _
            _ _ exactDivide hex _ q h

/-- A successful native constructor call is canonical. -/
private theorem ctorOkCanonical (t : IntTy) (n d : JInt t) (r : Rat t)
    (h : exactDivideIntsSource (rational (.bits t)) n d = .ok r) : Canonical (.bits t) r := by
  unfold exactDivideIntsSource at h
  obtain ⟨h1, h2, h3, h4⟩ := native_constructor_aux t n d
  have hg : Nat.gcd n.val.natAbs d.val.natAbs ≠ 0 := fun hg =>
    (h1 hg).elim (fun _ hm => by rw [h] at hm; cases hm)
  have hneg : ¬ _ := fun hn => (h2 hg hn).elim (fun _ hm => by rw [h] at hm; cases hm)
  have hconv : _ := Classical.byContradiction fun hc =>
    (h3 hg hneg hc).elim (fun _ hm => by rw [h] at hm; cases hm)
  have hnorm : _ := Classical.byContradiction fun hc =>
    ((h4 hg hneg hconv).2 hc).elim (fun _ hm => by rw [h] at hm; cases hm)
  obtain ⟨q, hq, hrep⟩ := (h4 hg hneg hconv).1 hnorm
  rw [h] at hq
  cases hq
  exact hrep.1

theorem float_roundtrip_proven : JuliaLean.Statements.rational.Round11.float_roundtrip := by
  intro T i o showF x q
  cases i with | bits t =>
  dsimp only
  intro h
  have hcanon : ∀ r, approx (.bits t) (.ieee .f64 o) (.ieee .f64 o) showF x
      ((FloatParameters.ieee .f64 o).zero x) = some (.ok r) → Canonical (.bits t) r := by
    intro r hr
    refine rationalizeOk_preserves t _ (Canonical (.bits t)) _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _
      _ x _ _ r (fun u v w hw => ctorOkCanonical t u v w hw) ?_ ?_ hr
    · intro hu
      cases t <;> first | (exfalso; revert hu; decide) |
        (simp only [Canonical]; decide)
    · cases t <;> (simp only [Canonical]; decide)
  unfold exactFromFloat rationalOfFloatSource at h
  cases hr : approx (.bits t) (.ieee .f64 o) (.ieee .f64 o) showF x
      ((FloatParameters.ieee .f64 o).zero x) with
  | none => simp [hr, Bind.bind, ExceptT.bind, ExceptT.mk, Option.bind] at h
  | some result =>
    cases result with
    | error e =>
      simp [hr, Bind.bind, ExceptT.bind, ExceptT.pure, ExceptT.mk, ExceptT.bindCont, Option.bind,
        Except.bind] at h <;> cases Option.some.inj h
    | ok r =>
      have hc := hcanon r hr
      cases he : (FloatParameters.ieee .f64 o).eq x (toFloat (.bits t) (.ieee .f64 o) r) with
      | false =>
        simp [hr, he, Bind.bind, ExceptT.bind, ExceptT.pure, ExceptT.mk, ExceptT.bindCont,
          Option.bind, Except.bind, throw, throwThe, MonadExceptOf.throw] at h <;>
          cases Option.some.inj h
      | true =>
        have hqr : r = q := by
          apply Except.ok.inj
          apply Option.some.inj
          simp only [hr, he, Bind.bind, ExceptT.bind, ExceptT.pure, ExceptT.mk, ExceptT.bindCont,
            Option.bind, ↓reduceIte, Pure.pure] at h
          exact h
        subst hqr
        obtain ⟨hd, hg⟩ := hc
        refine ⟨⟨hd, hg⟩, fun h0 => ?_, fun h0 => ?_, he⟩
        · rw [h0, Int.natAbs_zero, Nat.gcd_zero_left] at hg
          omega
        · rw [h0, Int.natAbs_zero, Nat.gcd_zero_right] at hg
          exact hg

end JuliaLean.Proofs.base.rational.FloatRoundTripProof

