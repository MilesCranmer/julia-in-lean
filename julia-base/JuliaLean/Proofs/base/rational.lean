Source: base/rational.jl:27. -/
def CheckedDenSameDispatchEffects : Prop :=
  ∀ (World T R : Type)
    (ops : CheckedDenSameOps (EStateM ArrayError World) T R)
    (num den : T) (initial : World),
    match checkedDenSame (observeCheckedDenSameCall ops)
        num den (initial, 0, none, none) with
    | .ok result (finalWorld, calls, outcome, observedWorld) =>
        calls = 1 ∧ outcome = some (.ok result) ∧ observedWorld = some finalWorld
    | .error error (finalWorld, calls, outcome, observedWorld) =>
        calls = 1 ∧ outcome = some (.error error) ∧ observedWorld = some finalWorld

/-- Typed checked_den preserves condition checking, selected errors and
