def binary_unsigned_read : Prop :=
  ∀ (t : IntTy) (hu : t.signed = false)
    (ltoh : JInt t → JInt t) (hlittle : ∀ x, ltoh x = x)
    (io : JuliaLean.base.iobuffer.BufferState) (hr : io.readable = true)
    (hp : 1 ≤ io.ptr.val) (hdata : io.size.val ≤ io.data.length)
    (hs : io.ptr.val+2*JuliaLean.base.int.sizeofT t ≤ io.size.val+1)
    (hwrap : io.ptr.val+2*JuliaLean.base.int.sizeofT t ≤ IntTy.i64.max),
    let count := JuliaLean.base.int.sizeofT t
    let n := wordAt io.data (io.ptr.val-1).toNat count
    let d := wordAt io.data (io.ptr.val-1+count).toNat count
    let run := readUnsignedRational t ltoh io
    (n ≠ 0 ∨ d ≠ 0 → ∃ q out, run = .ok q out ∧ Normalized q ∧
      q.num.val*d = n*q.den.val ∧ (d ≠ 0 → 0 < q.den.val) ∧
      out.ptr.val = io.ptr.val+2*count ∧ out.data = io.data) ∧
    (n = 0 → d = 0 → ∃ out message, run = .error (.jl (.argumentError message)) out ∧
      out.ptr.val = io.ptr.val+2*count)
abbrev oneRatRun (t : IntTy) (x : Rat t) : Jl (Rat t) :=
  JuliaLean.base.number.oneValue (fun _ : Rat t => ())
    (fun _ => JuliaLean.base.number.oneType
      (fun (_ : Unit) n => rationalIntAsSource (JInt t) (JuliaLean.base.int.convert t)
        (fun _ => JInt.lit .i64 1) (JInt.lit .i64 n)) ()) x
def one_rat_returns : Prop :=
  ∀ (t : IntTy) (x : Rat t),
    ∀ e, oneRatRun t x ≠ .error e
theorem one_rat_returns_proven (t : IntTy) (x : Rat t) :
    ∀ e, oneRatRun t x ≠ .error e := by
  intro e
  have hconvert (t : IntTy) :
      JuliaLean.base.int.convert t (JInt.lit .i64 1) = .ok (JInt.lit t 1) := by
    cases t <;>
      simp [JuliaLean.base.int.convert, JInt.convert, JInt.lit, JInt.wrap, wrapInt,
        IntTy.min, IntTy.max, IntTy.signed, IntTy.bits] <;> omega
  simp [oneRatRun, JuliaLean.base.number.oneValue, JuliaLean.base.number.oneType,
    JuliaLean.base.rational.rationalIntAsSource, hconvert, Bind.bind, Except.bind,
    Functor.map, Except.map, Pure.pure, Except.pure]
def oneRat (t : IntTy) (x : Rat t) : Rat t :=
  JuliaLean.base.int.okOf (oneRatRun t x) (one_rat_returns_proven t x)
def nonnegativePowerRun (t s : IntTy) (negDead : Rat t → Jl (Rat t))
    (convertOther : Rat t → Jl (Rat t)) (throwDead : Rat t → JInt s → Jl (Rat t))
    (x : Rat t) (n : JInt s) : Jl (Rat t) :=
  let mul := mulRatRatSource (samePromoteOps (nativeOps t)) (dg (.bits t) (.bits t))
  powRationalIntegerGeneric
    (fun k => JuliaLean.base.int.le (JInt.lit .i64 0) k)
    JuliaLean.base.int.neg (invRatSource (nativeOps t))
    (fun q k => JuliaLean.base.intfuncs.powerBySquaring (JuliaLean.base.intfuncs.bitsOps s)
      mul true (fun q => .ok (JuliaLean.base.number.convertSame q)) convertOther
      (fun q => .ok (JuliaLean.base.number.convertSame q)) JuliaLean.base.number.copy
      (oneRat t) negDead (isOneRationalSource (nativeOps t).isone) mul true q k throwDead) x n
def nonnegative_integer_power : Prop :=
  ∀ (t s : IntTy) (x : Rat t) (n : JInt s)
    (hx : Normalized x) (hn : 0 ≤ n.val)
    (hsafe : ∀ k : Nat, k ≤ max 2 n.val.toNat →
      IntegerParameters.fits (.bits t) (x.num.val^k) ∧
      IntegerParameters.fits (.bits t) (x.den.val^k)),
    ∀ negDead convertOther throwDead,
    ExactResult (.bits t) (nonnegativePowerRun t s negDead convertOther throwDead x n)
