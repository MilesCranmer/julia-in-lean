  subRatSource m.prom (promoteR m) (fun x => decide (rd i x = 0)) (neg j) (eqR i j)
    (dg p p) (rational p)
def AddSafe {T U P : Type} (i : IntegerParameters T) (j : IntegerParameters U)
    (p : IntegerParameters P) (x : Rational T) (y : Rational U) (subtract : Bool) : Prop :=
  let g : Int := Nat.gcd (rd i x).natAbs (rd j y).natAbs
  let a := rn i x * ((rd j y).tdiv g)
  let b := rn j y * ((rd i x).tdiv g)
  p.fits (rn i x) ∧ p.fits (rd i x) ∧ p.fits (rn j y) ∧ p.fits (rd j y) ∧
  p.fits a ∧ p.fits b ∧ p.fits (if subtract then a-b else a+b) ∧
  p.fits (rd i x * ((rd j y).tdiv g))
def Converts {T U P : Type} (i : IntegerParameters T) (j : IntegerParameters U)
    (p : IntegerParameters P) (x : Rational T) (y : Rational U) : Prop :=
  p.fits (rn i x) ∧ p.fits (rd i x) ∧ p.fits (rn j y) ∧ p.fits (rd j y)
def ExactResult {T : Type} (i : IntegerParameters T) (run : Jl (Rational T))
    (n d : Int) : Prop := ∃ q, run = .ok q ∧ Represents i q n d
def FitsPair {T : Type} (i : IntegerParameters T) (n d : Int) : Prop :=
  i.fits n ∧ i.fits d
def reduced (n d : Int) : Int × Int :=
  let g : Int := Nat.gcd n.natAbs d.natAbs
  (n.tdiv g, d.tdiv g)
def ConstructorContract {T : Type} (i : IntegerParameters T)
    (run : Jl (Rational T)) (n d : Int) : Prop :=
  let g := Nat.gcd n.natAbs d.natAbs
  let a := if i.ops.isUnsignedOrBool then ((reduced n d).1.natAbs : Int) else (reduced n d).1
  let b := if i.ops.isUnsignedOrBool then ((reduced n d).2.natAbs : Int) else (reduced n d).2
  let negativeUnsigned := i.ops.isUnsignedOrBool = true ∧ n ≠ 0 ∧ ((n < 0) ≠ (d < 0))
  let converted := FitsPair i a b
  let normalized := b < 0 → FitsPair i (-a) (-b)
  (g = 0 → IsArgument run) ∧
  (g ≠ 0 → negativeUnsigned → IsInexact run) ∧
  (g ≠ 0 → ¬ negativeUnsigned → ¬ converted → IsInexact run) ∧
  (g ≠ 0 → ¬ negativeUnsigned → converted →
    (normalized → ExactResult i run n d) ∧ (¬ normalized → IsOverflow run))
def constructor_nonfinite : Prop :=
  ∀ (t : IntTy) (n d : JInt t),
    (n.val = 0 → d.val = 0 → IsArgument (rational (.bits t) n d)) ∧
    (n.val ≠ 0 → d.val = 0 → ∃ q, rational (.bits t) n d = .ok q ∧
      q.den.val = 0 ∧ q.num.val = (if n.val < 0 then -1 else 1) ∧ Normalized q)
def constructor_outcomes : Prop :=
  ∀ {T N D : Type} (i : IntegerParameters T)
    (ni : IntegerParameters N) (di : IntegerParameters D) (n : N) (d : D),
    ConstructorContract i (ctor i ni di n d (inexactErrorCore "Rational")) (val ni n) (val di d)
def components_reconstruct : Prop :=
  ∀ {T : Type} (i : IntegerParameters T) (x : Rational T)
    (hx : Canonical i x),
    exactDivideIntsSource (rational i) (numeratorRationalSource x) (denominatorRationalSource x) = .ok x ∧
    let (n,e,d) := decomposeSource x
    n = x.num ∧ d = x.den ∧ e.val = 0 ∧
    ConstructorContract i (rational i n d) (rn i x) (rd i x)
def integer_generic : Prop :=
  ∀ {T : Type} (i : IntegerParameters T) (n : T),
    let q := rationalFromIntegerGeneric unsafeRationalSameSource (fun _ => i.ops.one) n
    Canonical i q ∧ Represents i q (val i n) 1
def unsafe_values : Prop :=
  ∀ {T U : Type} (i : IntegerParameters T) (j : IntegerParameters U) (n d : U),
    let run := unsafeRationalTypeSource T (fun n => i.ops.fromInt (val j n))
      (fun n => i.ops.fromInt (val j n)) n d
    (FitsPair i (val j n) (val j d) → ∃ q, run = .ok q ∧ rn i q = val j n ∧ rd i q = val j d) ∧
    (¬ FitsPair i (val j n) (val j d) → IsInexact run)
def promoted_components : Prop :=
  ∀ {T U P : Type} (i : IntegerParameters T) (j : IntegerParameters U)
    (p : IntegerParameters P) (m : PromotionParameters i j p) (n : T) (d : U),
    (FitsPair p (val i n) (val j d) → ∃ q, unsafeRationalPromoteSource m.prom.promote n d = .ok q ∧
      rn p q = val i n ∧ rd p q = val j d) ∧
    (¬ FitsPair p (val i n) (val j d) → IsInexact (unsafeRationalPromoteSource m.prom.promote n d)) ∧
    (val i n = 0 → val j d = 0 → ctor p i j n d (inexactErrorCore "Rational") =
      .error (.argumentError ("invalid rational: zero(" ++ p.ops.typeName ++ ")//zero(" ++ p.ops.typeName ++ ")")))
def native_constructor : Prop :=
  ∀ (t : IntTy) (n d : JInt t),
    ConstructorContract (.bits t) (rational (.bits t) n d) n.val d.val
def FiniteArithmetic {T : Type} (i : IntegerParameters T) (run : Jl (Rational T))
    (n d : Int) (converted safe : Prop) : Prop :=
  (¬ converted → IsInexact run) ∧
  (converted → safe → ExactResult i run n d) ∧
  (converted → ¬ safe → IsOverflow run)
def add_sub_exact : Prop :=
  ∀ {T U P : Type} (i : IntegerParameters T) (j : IntegerParameters U)
    (p : IntegerParameters P) (m : PromotionParameters i j p) (x : Rational T) (y : Rational U)
    (hx : Canonical i x) (hy : Canonical j y),
    let cv := Converts i j p x y
    (rd i x > 0 → rd j y > 0 →
      FiniteArithmetic p (add m x y) (rn i x*rd j y+rn j y*rd i x) (rd i x*rd j y)
        cv (AddSafe i j p x y false) ∧
      FiniteArithmetic p (sub m x y) (rn i x*rd j y-rn j y*rd i x) (rd i x*rd j y)
        cv (AddSafe i j p x y true)) ∧
    (cv → rd i x = 0 → rd j y = 0 → rn i x = rn j y → ExactResult p (add m x y) (rn i x) 0) ∧
    (cv → rd i x = 0 → rd j y = 0 → rn i x ≠ rn j y → (add m x y) = .error .divideError) ∧
    (¬ cv → IsInexact (add m x y) ∧ IsInexact (sub m x y))
def checked_overflow : Prop :=
  ∀ {T U P : Type} (i : IntegerParameters T) (j : IntegerParameters U)
    (p : IntegerParameters P) (m : PromotionParameters i j p) (x : Rational T) (y : Rational U)
    (hx : Canonical i x) (hy : Canonical j y),
    (¬ Converts i j p x y → IsInexact (add m x y) ∧ IsInexact (sub m x y)) ∧
    (Converts i j p x y → rd i x > 0 → rd j y > 0 →
      (¬ AddSafe i j p x y false → IsOverflow (add m x y)) ∧
      (¬ AddSafe i j p x y true → IsOverflow (sub m x y))) ∧
    (Converts i j p x y → rd i x = 0 → ¬ j.fits (-rn j y) → IsOverflow (sub m x y))
def infinity_sub : Prop :=
  ∀ {T U P : Type} (i : IntegerParameters T) (j : IntegerParameters U)
    (p : IntegerParameters P) (m : PromotionParameters i j p) (x : Rational T) (y : Rational U)
    (hx : Canonical i x) (hy : Canonical j y) (hi : rd i x = 0) (hp : rn i x > 0)
    (hf : rd j y > 0) (hfit : Converts i j p x y),
    ExactResult p (sub m x y) 1 0
def unary_spec : Prop :=
  ∀ {T : Type} (i : IntegerParameters T) (x : Rational T) (hx : Canonical i x),
    (i.fits (-rn i x) → ∃ q, neg i x = .ok q ∧ rn i q = -rn i x ∧ rd i q = rd i x) ∧
    (¬ i.fits (-rn i x) → IsOverflow (neg i x)) ∧
    (i.fits (rn i x).natAbs → ExactResult i (absRatSource i.ops.checkedAbs x) (rn i x).natAbs (rd i x)) ∧
    (¬ i.fits (rn i x).natAbs → IsOverflow (absRatSource i.ops.checkedAbs x)) ∧
    Represents i (unaryPlusRatSource i.ops.uplus x) (rn i x) (rd i x) ∧
    signbitRatSource i.ops.signbit x = decide (rn i x < 0) ∧
    isIntegerRatSource i.ops.isone x = decide (rd i x > 0 ∧ rd i x ∣ rn i x) ∧
    isZeroRationalSource i.ops.iszero x = decide (rn i x = 0) ∧
    isOneRationalSource i.ops.isone x = decide (rn i x = rd i x)
def unsigned_negation : Prop :=
  ∀ (t : IntTy) (hu : t.signed = false) (x : Rat t) (hx : Normalized x),
    (x.num.val ≠ 0 → IsOverflow (neg (.bits t) x)) ∧
    (x.num.val = 0 → (do let y ← neg (.bits t) x; neg (.bits t) y) = .ok x ∧ x.den.val = 1)
def multiplication_exact : Prop :=
  ∀ {T U P : Type} (i : IntegerParameters T) (j : IntegerParameters U)
    (p : IntegerParameters P) (m : PromotionParameters i j p) (x : Rational T) (y : Rational U)
    (hx : Canonical i x) (hy : Canonical j y),
    let cv := Converts i j p x y
    let g1 : Int := Nat.gcd (rn i x).natAbs (rd j y).natAbs
    let g2 : Int := Nat.gcd (rd i x).natAbs (rn j y).natAbs
    let n := (rn i x).tdiv g1 * (rn j y).tdiv g2
    let d := (rd i x).tdiv g2 * (rd j y).tdiv g1
    (¬ cv → IsInexact (mulRatRatSource m.prom (dg p p) x y)) ∧
    (cv → (g1 = 0 ∨ g2 = 0) → mulRatRatSource m.prom (dg p p) x y = .error .divideError) ∧
    (cv → g1 ≠ 0 → g2 ≠ 0 →
      (FitsPair p n d → ExactResult p (mulRatRatSource m.prom (dg p p) x y)
        (rn i x*rn j y) (rd i x*rd j y)) ∧
      (¬ FitsPair p n d → IsOverflow (mulRatRatSource m.prom (dg p p) x y)))
abbrev scalarAdd {T U P : Type} {i : IntegerParameters T} {j : IntegerParameters U}
    {p : IntegerParameters P} (m : PromotionParameters i j p) :=
  rationalIntegerOpSource m.prom (fun a b => do p.ops.checkedAdd (← m.prom.convertXP a) b)
abbrev scalarSub {T U P : Type} {i : IntegerParameters T} {j : IntegerParameters U}
    {p : IntegerParameters P} (m : PromotionParameters i j p) :=
  rationalIntegerOpSource m.prom (fun a b => do p.ops.checkedSub (← m.prom.convertXP a) b)
def scalar_arithmetic : Prop :=
  ∀ {T U P : Type} (i : IntegerParameters T) (j : IntegerParameters U)
    (p : IntegerParameters P) (m : PromotionParameters i j p) (x : Rational T) (k : U)
    (hx : Canonical i x),
    let cv := p.fits (rn i x) ∧ p.fits (rd i x) ∧ p.fits (val j k)
    let prod := rd i x * val j k
    let ga : Int := Nat.gcd (rd i x).natAbs (val j k).natAbs
    let gn : Int := Nat.gcd (rn i x).natAbs (val j k).natAbs
    let mn := rn i x * (val j k).tdiv ga
    let md := (rd i x).tdiv ga
    let dn := (rn i x).tdiv gn
    let dd := rd i x * (val j k).tdiv gn
    FiniteArithmetic p (scalarAdd m x k) (rn i x + prod) (rd i x) cv
      (p.fits prod ∧ p.fits (rn i x+prod)) ∧
    FiniteArithmetic p (scalarSub m x k) (rn i x - prod) (rd i x) cv
      (p.fits prod ∧ p.fits (rn i x-prod)) ∧
    (cv → ga = 0 → mulRatIntSource m.prom (dg p p) x k = .error .divideError) ∧
    (cv → ga ≠ 0 → FiniteArithmetic p (mulRatIntSource m.prom (dg p p) x k)
      (rn i x*val j k) (rd i x) True (FitsPair p mn md)) ∧
    (cv → gn = 0 → divRatIntSource m.prom (dg p p) x k = .error .divideError) ∧
    (cv → gn ≠ 0 →
      ((p.fits dd ∧ (dd < 0 → FitsPair p (-dn) (-dd)) ∧
          (rd i x = 0 ∧ val j k < 0 → p.fits (-dn))) →
        ExactResult p (divRatIntSource m.prom (dg p p) x k) (rn i x) (rd i x*val j k)))
def mixed_left : Prop :=
  ∀ {T U P : Type} (i : IntegerParameters T) (j : IntegerParameters U)
    (p : IntegerParameters P) (m : PromotionParameters i j p) (x : Rational T) (k : U)
    (hx : Canonical i x),
    let cv := p.fits (rn i x) ∧ p.fits (rd i x) ∧ p.fits (val j k)
    let prod := val j k * rd i x
    FiniteArithmetic p (integerRationalOpSource m.prom
      (fun a b => do p.ops.checkedAdd a (← m.prom.convertXP b)) k x)
      (prod+rn i x) (rd i x) cv (p.fits prod ∧ p.fits (prod+rn i x)) ∧
    FiniteArithmetic p (integerRationalOpSource m.prom
      (fun a b => do p.ops.checkedSub a (← m.prom.convertXP b)) k x)
      (prod-rn i x) (rd i x) cv (p.fits prod ∧ p.fits (prod-rn i x))
def RemainderContract {T U P : Type} (i : IntegerParameters T) (j : IntegerParameters U)
    (p : IntegerParameters P) (x : Rational T) (y : Rational U)
    (run : Jl (Rational P)) (floorMode : Bool) : Prop :=
  let g : Int := Nat.gcd (rd i x).natAbs (rd j y).natAbs
  let a := rn i x * (rd j y).tdiv g
  let b := rn j y * (rd i x).tdiv g
  let d := rd i x * (rd j y).tdiv g
  let r := if floorMode then a.fmod b else a.tmod b
  let cv := Converts i j p x y
  (¬ cv → IsInexact run) ∧
  (cv → g = 0 → run = .error .divideError) ∧
  (cv → g ≠ 0 → ¬ (p.fits a ∧ p.fits b) → IsOverflow run) ∧
  (cv → g ≠ 0 → p.fits a → p.fits b →
    (b = 0 → run = .error .divideError) ∧
    (b ≠ 0 → ¬ p.fits d → IsOverflow run) ∧
    (b ≠ 0 → p.fits d → ConstructorContract p run r d))
def remainders : Prop :=
  ∀ {T : Type} (i : IntegerParameters T) (x y : Rational T)
    (hx : Canonical i x) (hy : Canonical i y),
    RemainderContract i i i x y (remRatSource (samePromoteOps i.ops) (dg i i) (rational i) x y) false ∧
    RemainderContract i i i x y (modRatSource (samePromoteOps i.ops) (dg i i) (rational i) x y) true
def scalar_remainders : Prop :=
  ∀ {T U P : Type} (i : IntegerParameters T) (j : IntegerParameters U)
    (p : IntegerParameters P) (m : PromotionParameters i j p) (x : Rational T) (k : U)
    (hx : Canonical i x),
    let cv := p.fits (rn i x) ∧ p.fits (rd i x) ∧ p.fits (val j k)
    let prod := rd i x * val j k
    let rr := rationalIntegerOpSource m.prom (fun a b => do p.ops.rem (← m.prom.convertXP a) b) x k
    let rm := rationalIntegerOpSource m.prom (fun a b => do p.ops.mod (← m.prom.convertXP a) b) x k
    let lr := integerRationalRemainderSource m.prom
      (fun a b => do p.ops.rem a (← m.prom.convertXP b))
      (fun n d => ctor p p i n d (inexactErrorCore "Rational")) k x
    let lm := integerRationalRemainderSource m.prom
      (fun a b => do p.ops.mod a (← m.prom.convertXP b))
      (fun n d => ctor p p i n d (inexactErrorCore "Rational")) k x
    (cv → p.fits prod → prod ≠ 0 →
      ExactResult p rr ((rn i x).tmod prod) (rd i x) ∧
      ExactResult p rm ((rn i x).fmod prod) (rd i x)) ∧
    (cv → p.fits prod → rn i x ≠ 0 →
      ConstructorContract p lr (prod.tmod (rn i x)) (rd i x) ∧
      ConstructorContract p lm (prod.fmod (rn i x)) (rd i x)) ∧
    (cv → p.fits prod → prod = 0 → rr = .error .divideError ∧ rm = .error .divideError) ∧
    (cv → p.fits prod → rn i x = 0 → lr = .error .divideError ∧ lm = .error .divideError) ∧
    (cv → ¬ p.fits prod → IsOverflow rr ∧ IsOverflow rm ∧ IsOverflow lr ∧ IsOverflow lm)
def igcd {T : Type} : IntegerParameters T → T → T → Jl T
  | .bits _,a,b => JuliaLean.base.intfuncs.gcd_BitInteger a b
def ilcm {T : Type} : IntegerParameters T → T → T → Jl T
  | .bits _,a,b => JuliaLean.base.intfuncs.lcmBits a b
def mixedGcd {T U P : Type} {i : IntegerParameters T} {j : IntegerParameters U}
    {p : IntegerParameters P} : PromotionParameters i j p → T → U → Jl P
  | .same i,a,b => igcd i a b
  | .bits _ _,a,b => JuliaLean.base.intfuncs.gcdMixedBits a b
def mixedLcm {T U P : Type} {i : IntegerParameters T} {j : IntegerParameters U}
    {p : IntegerParameters P} : PromotionParameters i j p → T → U → Jl P
  | .same i,a,b => ilcm i a b
  | .bits _ _,a,b => JuliaLean.base.intfuncs.lcmMixedBits a b
abbrev rgcd {T : Type} (i : IntegerParameters T) :=
  gcdRationalSource (fun q => i.ops.iszero q.den) (fun q => i.ops.iszero q.den) (igcd i) (ilcm i)
abbrev rlcm {T : Type} (i : IntegerParameters T) :=
  lcmRationalSource (fun q => i.ops.iszero q.den) (fun q => i.ops.iszero q.den) (ilcm i) (igcd i)
def igcdx {T : Type} : IntegerParameters T → T → T → Jl (T × T × T)
  | .bits _,a,b => JuliaLean.base.intfuncs.gcdxBits a b
abbrev rgcdx {T : Type} (i : IntegerParameters T) (x y : Rational T) : Jl (Rational T × T × T) := do
  let (c, coeffs) ← gcdxRationalSource (fun q => i.ops.iszero q.den) (fun q => i.ops.iszero q.den)
    (igcd i) (ilcm i) i.ops.iszero (fun _ => i.ops.zero) (fun _ => i.ops.one)
    i.ops.iszero i.ops.iszero (fun c a b => if c then a else b)
    i.ops.divToZero i.ops.divToZero i.ops.divToZero i.ops.divToZero
    (fun a b => .ok (i.ops.mulWrap a b)) (fun a b => .ok (i.ops.mulWrap a b)) (igcdx i) x y
  match coeffs with
  | .direct a b => pure (c, a, b)
  | .computed a b => pure (c, a, b)
def GcdLcmContract {T U P : Type} (i : IntegerParameters T) (j : IntegerParameters U)
    (p : IntegerParameters P) (x : Rational T) (y : Rational U)
    (gRun lRun : Jl (Rational P)) : Prop :=
  let gn : Int := Nat.gcd (rn i x).natAbs (rn j y).natAbs
  let gd : Int := Nat.gcd (rd i x).natAbs (rd j y).natAbs
  let ln : Int := Nat.lcm (rn i x).natAbs (rn j y).natAbs
  let ld : Int := Nat.lcm (rd i x).natAbs (rd j y).natAbs
  ((rd i x = 0) ≠ (rd j y = 0) → IsArgument gRun ∧ IsArgument lRun) ∧
  ((rd i x = 0) = (rd j y = 0) →
    (FitsPair p gn ld → ExactResult p gRun gn ld) ∧
    (FitsPair p ln gd → ExactResult p lRun ln gd) ∧
    (¬ p.fits gn ∨ ¬ p.fits ld → IsOverflow gRun) ∧
    (¬ p.fits ln ∨ ¬ p.fits gd → IsOverflow lRun))
def gcd_lcm : Prop :=
  ∀ {T : Type} (i : IntegerParameters T) (x y : Rational T)
    (hx : Canonical i x) (hy : Canonical i y),
    GcdLcmContract i i i x y (rgcd i x y) (rlcm i x y)
def gcd_lcm_infinite : Prop :=
  ∀ {T : Type} (i : IntegerParameters T) (x y : Rational T)
    (hx : Canonical i x) (hy : Canonical i y),
    GcdLcmContract i i i x y (rgcd i x y) (rlcm i x y) ∧
    ((rd i x = 0) ≠ (rd i y = 0) → IsArgument (rgcd i x y) ∧ IsArgument (rlcm i x y))
def mixed_gcd_lcm : Prop :=
  ∀ {T U P : Type} (i : IntegerParameters T) (j : IntegerParameters U)
    (p : IntegerParameters P) (m : PromotionParameters i j p) (x : Rational T) (y : Rational U)
    (hx : Canonical i x) (hy : Canonical j y),
    GcdLcmContract i j p x y
      (gcdRationalSource (fun q => i.ops.iszero q.den) (fun q => j.ops.iszero q.den)
        (mixedGcd m) (mixedLcm m) x y)
      (lcmRationalSource (fun q => i.ops.iszero q.den) (fun q => j.ops.iszero q.den)
        (mixedLcm m) (mixedGcd m) x y)
inductive FloatParameters : Type → Type where
  | ieee (f : JuliaLean.base.float.FTy) (o : JuliaLean.base.math.IEEEOps .f32 × JuliaLean.base.math.IEEEOps .f64) :
      FloatParameters (JuliaLean.base.float.FV f)
namespace FloatParameters
def ratio {F : Type} : FloatParameters F → F → Int × Nat | .ieee _ _,x => Fl.toRat x
def isnan {F : Type} : FloatParameters F → F → Bool | .ieee _ _,x => JuliaLean.base.float.isnan_IEEEFloat x
def isinf {F : Type} : FloatParameters F → F → Bool | .ieee _ _,x => JuliaLean.base.float.isinf_IEEEFloat x
def negative {F : Type} : FloatParameters F → F → Bool | .ieee f _,x => JuliaLean.base.float.lt_IEEEFloat x (JuliaLean.base.float.zero_float f)
def zero {F : Type} : FloatParameters F → F → F | .ieee f _,_ => JuliaLean.base.float.zero_float f
def one {F : Type} : FloatParameters F → F → F | .ieee f _,_ => JuliaLean.base.float.one_float f
def abs {F : Type} : FloatParameters F → F → F | .ieee _ _,x => JuliaLean.base.float.abs_IEEEFloat x
def trunc {F : Type} : FloatParameters F → F → F | .ieee _ _,x => JuliaLean.base.float.trunc_llvm x
def sub {F : Type} : FloatParameters F → F → F → F | .ieee _ _,x,y => JuliaLean.base.float.sub_IEEEFloat x y
def add {F : Type} : FloatParameters F → F → F → F | .ieee _ _,x,y => JuliaLean.base.float.add_IEEEFloat x y
def mul {F : Type} : FloatParameters F → F → F → F | .ieee _ _,x,y => JuliaLean.base.float.mul_IEEEFloat x y
def div {F : Type} : FloatParameters F → F → F → F | .ieee _ _,x,y => JuliaLean.base.float.div_IEEEFloat x y
def truncDiv {F : Type} : FloatParameters F → F → F → F
  | .ieee _ _,x,y => JuliaLean.base.div.div_AbstractFloat JuliaLean.base.float.div_IEEEFloat
      (fun a b _ => JuliaLean.base.float.rem_IEEEFloat a b) JuliaLean.base.float.sub_IEEEFloat
      JuliaLean.base.float.round_Nearest_llvm x y .ToZero
def cld {F : Type} : FloatParameters F → F → F → F
  | .ieee _ _,x,y => JuliaLean.base.div.div_AbstractFloat JuliaLean.base.float.div_IEEEFloat
      (fun a b _ => JuliaLean.base.float.mod_AbstractFloat a (JuliaLean.base.float.neg_IEEEFloat b))
      JuliaLean.base.float.sub_IEEEFloat JuliaLean.base.float.round_Nearest_llvm x y .Up
def divrem {F : Type} : FloatParameters F → F → F → F × F
  | .ieee ft o,x,y => (truncDiv (.ieee ft o) x y, JuliaLean.base.float.rem_IEEEFloat x y)
def gt {F : Type} : FloatParameters F → F → F → Bool | .ieee _ _,x,y => JuliaLean.base.float.lt_IEEEFloat y x
def eq {F : Type} : FloatParameters F → F → F → Bool | .ieee _ _,x,y => JuliaLean.base.float.eq_IEEEFloat x y
def ofInt {F : Type} : FloatParameters F → Int → F | .ieee ft _,n => JuliaLean.base.float.floatOfInt ft (JInt.wrap .i64 n)
def decompose {F : Type} : FloatParameters F → F → Int × Int × Int
  | .ieee _ _,x => let (n,e,d) := JuliaLean.base.float.decompose x; (n.val,e.val,d.val)
def ldexp {F : Type} : FloatParameters F → F → Int → F
  | .ieee .f16 o,x,e => JuliaLean.base.math.ldexp16
      {o.1 with flipsign := JuliaLean.base.floatfuncs.flipsign_Float32} x e
  | .ieee .f32 o,x,e => JuliaLean.base.math.ldexp
      {o.1 with flipsign := JuliaLean.base.floatfuncs.flipsign_Float32} x e
  | .ieee .f64 o,x,e => JuliaLean.base.math.ldexp
      {o.2 with flipsign := JuliaLean.base.floatfuncs.flipsign_Float64} x e
def roundFormat {F : Type} : FloatParameters F → Int → Nat → F
  | .ieee _ _,n,d => Fl.roundRat n d false
end FloatParameters
def floatToInteger {T F : Type} (i : IntegerParameters T) (f : FloatParameters F) : F → Jl T :=
  match i,f with | .bits t,.ieee _ _ => JuliaLean.base.float.intOfFloat t
def convertNativeFloat {F G : Type} (f : FloatParameters F) (g : FloatParameters G) : F → G :=
  match f,g with | .ieee _ _,.ieee gt _ => JuliaLean.base.float.convertFloat gt
def FloatParameters.signbit {F : Type} : FloatParameters F → F → Bool
  | .ieee _ _,x => JuliaLean.base.float.signbit_float x
def greaterHalf {T F : Type} (i : IntegerParameters T) (f : FloatParameters F) : T → F → Bool :=
  match i,f with
  | .bits _,.ieee ft _ => fun n a => JuliaLean.base.float.lt_FI
      (JuliaLean.base.float.div_IEEEFloat a (JuliaLean.base.float.floatOfInt ft (JInt.lit .i64 2))) n
abbrev approx {T F Tol : Type} (i : IntegerParameters T) (f : FloatParameters F)
    (tf : FloatParameters Tol) (showTol : Tol → String) (x : F) (tol : Tol) :=
  rationalizeAbstractFloatSource T i.ops tf.negative f.negative f.isnan f.isinf
    f.abs f.trunc f.zero f.one (fun _ t => convertNativeFloat tf f t)
    f.gt f.sub f.add f.mul f.cld f.divrem (floatToInteger i f)
    (fun a => !(f.gt a (f.ofInt 2))) (greaterHalf i f)
    (exactDivideIntsSource (rational i)) x tol showTol
def Within {T F Tol : Type} (i : IntegerParameters T) (f : FloatParameters F)
    (tf : FloatParameters Tol) (q : Rational T) (x : F) (tol : Tol) : Prop :=
  rd i q > 0 ∧
  (rn i q * (f.ratio x).2 - (f.ratio x).1 * rd i q).natAbs * (tf.ratio tol).2 ≤
    (tf.ratio tol).1.toNat * (rd i q).toNat * (f.ratio x).2
def rationalize_tolerance : Prop :=
  ∀ {T F Tol : Type} (i : IntegerParameters T)
    (f : FloatParameters F) (tf : FloatParameters Tol)
    (showTol : Tol → String) (x : F) (tol : Tol)
    (hfinite : f.isnan x = false ∧ f.isinf x = false)
    (htol : 0 ≤ (tf.ratio tol).1 ∧ 0 < (tf.ratio tol).2)
    (hunsigned : i.ops.isUnsignedOrBool = true → f.negative x = false),
    ∃ q, approx i f tf showTol x tol = some (.ok q) ∧
      Canonical i q ∧ Within i f tf q x tol
def rationalize_negative_tolerance : Prop :=
  ∀ {T F Tol : Type} (i : IntegerParameters T)
    (f : FloatParameters F) (tf : FloatParameters Tol)
    (showTol : Tol → String) (x : F) (tol : Tol) (ht : (tf.ratio tol).1 < 0 ∨ (tf.isinf tol = true ∧ tf.signbit tol = true)),
    approx i f tf showTol x tol =
      some (.error (.argumentError ("Tolerance can not be negative. tol=" ++ showTol tol)))
def rationalize_unsigned_negative : Prop :=
  ∀ {T F Tol : Type} (i : IntegerParameters T)
    (f : FloatParameters F) (tf : FloatParameters Tol)
    (showTol : Tol → String) (x : F) (tol : Tol)
    (ht : 0 ≤ (tf.ratio tol).1 ∧ ¬ (tf.isinf tol = true ∧ tf.signbit tol = true)) (hu : i.ops.isUnsignedOrBool = true) (hx : (f.ratio x).1 < 0 ∨ (f.isinf x = true ∧ f.signbit x = true)),
    approx i f tf showTol x tol = some (.error (.overflowError "cannot negate unsigned number"))
def rationalize_infinity : Prop :=
  ∀ {T F Tol : Type} (i : IntegerParameters T)
    (f : FloatParameters F) (tf : FloatParameters Tol)
    (showTol : Tol → String) (x : F) (tol : Tol)
    (ht : 0 ≤ (tf.ratio tol).1 ∧ ¬ (tf.isinf tol = true ∧ tf.signbit tol = true)) (hn : f.isnan x = false) (hx : f.isinf x = true)
    (hu : i.ops.isUnsignedOrBool = true → f.negative x = false)
    (hm : f.negative x = true → val i i.ops.minusOne = -1),
    ∃ q, approx i f tf showTol x tol = some (.ok q) ∧ Canonical i q ∧
      rd i q = 0 ∧ rn i q = (if f.negative x then -1 else 1)
def rationalize_nan : Prop :=
  ∀ {T F Tol : Type} (i : IntegerParameters T)
    (f : FloatParameters F) (tf : FloatParameters Tol)
    (showTol : Tol → String) (x : F) (tol : Tol)
    (ht : 0 ≤ (tf.ratio tol).1 ∧ ¬ (tf.isinf tol = true ∧ tf.signbit tol = true)) (hn : f.isnan x = true) (hs : f.negative x = false),
    approx i f tf showTol x tol = some (.error (.inexactError i.ops.typeName))
def toFloatNative {t : IntTy} : (f : JuliaLean.base.float.FTy) → Rat t → JuliaLean.base.float.FV f
  | .f16,q => if h : isSmallFloat16RatComponent t = true then float16OfRationalSmallSource h q
      else if h : is128RatComponent t = true then float16OfRational128Source h q
      else floatConvertRatSource _ (JuliaLean.base.float.floatOfInt .f16)
        JuliaLean.base.float.div_IEEEFloat (JuliaLean.base.float.convertFloat .f16) q
  | .f32,q => if h : is128RatComponent t = true then float32OfRational128Source h q
      else floatConvertRatSource _ (JuliaLean.base.float.floatOfInt .f32)
        JuliaLean.base.float.div_IEEEFloat (JuliaLean.base.float.convertFloat .f32) q
  | .f64,q => floatConvertRatSource _ (JuliaLean.base.float.floatOfInt .f64)
      JuliaLean.base.float.div_IEEEFloat (JuliaLean.base.float.convertFloat .f64) q
def toFloat {T F : Type} : IntegerParameters T → FloatParameters F → Rational T → F
  | .bits _,.ieee ft _,q => toFloatNative ft q
def abstractFloat {T : Type} : IntegerParameters T → Rational T → JuliaLean.base.float.FV .f64
  | .bits _,q => abstractFloatRatSource JuliaLean.base.float.float_BitInteger
      JuliaLean.base.float.div_IEEEFloat q
abbrev exactFromFloat {T F : Type} (i : IntegerParameters T) (f : FloatParameters F)
    (showF : F → String) (x : F) :=
  rationalOfFloatSource (m := ExceptT JlError Option) T
    (fun y => approx i f f showF y (f.zero y)) (toFloat i f) f.eq x inexactErrorCore
def from_float_exact : Prop :=
  ∀ {T F : Type} (i : IntegerParameters T) (f : FloatParameters F)
    (showF : F → String) (x : F),
    ∃ result, exactFromFloat i f showF x = some result ∧
      match result with
      | .ok q => Canonical i q ∧
          (f.isinf x = true → rd i q = 0 ∧ intSign (rn i q) = (if f.negative x then -1 else 1)) ∧
          (f.isinf x = false → f.isnan x = false ∧ Represents i q (f.ratio x).1 (f.ratio x).2)
      | .error e => (∃ s, e = .inexactError s) ∨ (∃ s, e = .overflowError s)
def from_float_representable : Prop :=
  ∀ {T F : Type} (i : IntegerParameters T) (f : FloatParameters F)
    (showF : F → String) (x : F) (q : Rational T)
    (hx : f.isnan x = false ∧ f.isinf x = false)
    (hq : Represents i q (f.ratio x).1 (f.ratio x).2),
    exactFromFloat i f showF x = some (.ok q)
def to_float_nearest : Prop :=
  ∀ {T F : Type} (i : IntegerParameters T) (f : FloatParameters F)
    (q : Rational T) (hq : Canonical i q),
    (rd i q > 0 → toFloat i f q = f.roundFormat (rn i q) (rd i q).toNat) ∧
    (rd i q = 0 → f.isinf (toFloat i f q) = true ∧
      f.negative (toFloat i f q) = decide (rn i q < 0))
abbrev C := JuliaLean.base.complex.Complex
abbrev cre {T : Type} := @JuliaLean.base.complex.real_Complex T
abbrev cim {T : Type} := @JuliaLean.base.complex.imag_Complex T
abbrev cri {T : Type} := JuliaLean.base.complex.reim (cre (T := T)) (cim (T := T))
abbrev cmk {T : Type} := JuliaLean.base.complex.complexOfPromoted (fun a b : T => (a,b))
def complex_integer_inverse : Prop :=
  ∀ {T : Type} (i : IntegerParameters T) (z : C T),
    let g : Int := Nat.gcd (val i z.re).natAbs (val i z.im).natAbs
    let c := (val i z.re).tdiv g
    let d := (val i z.im).tdiv g
    let den := val i z.re*c+val i z.im*d
    let safe := i.fits (val i z.re*c) ∧ i.fits (val i z.im*d) ∧ i.fits den ∧ i.fits (-d)
    let run := complexExactInvIntegerSource cri (dg i i) i.ops.checkedMul i.ops.checkedAdd i.ops.checkedNeg cmk z
    (g = 0 → run = .error .divideError) ∧
    (g ≠ 0 → safe → ∃ n den, run = .ok (n,den) ∧
      val i z.re*val i n.re-val i z.im*val i n.im = val i den ∧
      val i z.re*val i n.im+val i z.im*val i n.re = 0 ∧ 0 < val i den) ∧
    (g ≠ 0 → ¬ safe → IsOverflow run)
def complex_numerator : Prop :=
  ∀ {T : Type} (i : IntegerParameters T) (z : C (Rational T))
    (hr : Canonical i z.re) (hi : Canonical i z.im),
    let d : Int := Nat.lcm (rd i z.re).natAbs (rd i z.im).natAbs
    let nr := rn i z.re * d.tdiv (rd i z.re)
    let ni := rn i z.im * d.tdiv (rd i z.im)
    let nRun := numeratorComplexSource cre cim (ilcm i) i.ops.divToZero i.ops.checkedMul cmk z
    let dRun := denominatorComplexSource cre cim (ilcm i) z
    (rd i z.re > 0 → rd i z.im > 0 → i.fits d → i.fits nr → i.fits ni →
      ∃ n den, nRun = .ok n ∧ dRun = .ok den ∧ val i den = d ∧
        val i n.re*rd i z.re = rn i z.re*val i den ∧
        val i n.im*rd i z.im = rn i z.im*val i den) ∧
    (¬ i.fits d → IsOverflow nRun ∧ IsOverflow dRun) ∧
    (rd i z.re = 0 ∨ rd i z.im = 0 → nRun = .error .divideError)
def power_of_two : Prop :=
  ∀ (t : IntTy) (q : Rat t) (hq : Normalized q),
    isPow2RatSource JuliaLean.base.intfuncs.ispow2Bits q = true ↔
      (∃ k : Nat, q.num.val = (2 : Int)^k ∧ q.den.val = 1) ∨
      (∃ k : Nat, q.den.val = (2 : Int)^k ∧ q.num.val = 1)
def promoteFourSame (t : IntTy) (a b c d : JInt t) : Jl (JInt t × JInt t × JInt t × JInt t) :=
  let xs := JuliaLean.base.promotion.promoteSameType a b [c,d]
  pure (xs[0]'(by simp [xs, JuliaLean.base.promotion.promoteSameType]),
    xs[1]'(by simp [xs, JuliaLean.base.promotion.promoteSameType]),
    xs[2]'(by simp [xs, JuliaLean.base.promotion.promoteSameType]),
    xs[3]'(by simp [xs, JuliaLean.base.promotion.promoteSameType]))
abbrev cdiv {T : Type} (i : IntegerParameters T) :=
  exactDivideComplexReal (exactDivideIntsSource (rational i)) cmk cre cim
abbrev cq (t : IntTy) :=
  divideComplexIntegersSource cri cri (promoteFourSame t) (dg (.bits t) (.bits t))
    (jintOps t).checkedMul (jintOps t).checkedAdd (jintOps t).checkedNeg cmk (cdiv (.bits t))
def complex_quotient : Prop :=
  ∀ (t : IntTy) (x y : C (JInt t)),
    let i := IntegerParameters.bits t
    let g : Int := Nat.gcd y.re.val.natAbs y.im.val.natAbs
    let c := y.re.val.tdiv g
    let d := y.im.val.tdiv g
    let den := y.re.val*c+y.im.val*d
    let nr := x.re.val*c+x.im.val*d
    let ni := x.im.val*c-x.re.val*d
    let safe := i.fits (y.re.val*c) ∧ i.fits (y.im.val*d) ∧ i.fits den ∧
      i.fits (x.re.val*c) ∧ i.fits (x.im.val*d) ∧ i.fits nr ∧
      i.fits (x.im.val*c) ∧ i.fits (x.re.val*d) ∧ i.fits (-x.re.val*d) ∧ i.fits ni
    (g = 0 → cq t x y = .error .divideError) ∧
    (g ≠ 0 → safe → ∃ q, cq t x y = .ok q ∧
      Represents i q.re (x.re.val*y.re.val+x.im.val*y.im.val) (y.re.val^2+y.im.val^2) ∧
      Represents i q.im (x.im.val*y.re.val-x.re.val*y.im.val) (y.re.val^2+y.im.val^2)) ∧
    (g ≠ 0 → ¬ safe → IsOverflow (cq t x y))
def compareExtended (n d m e : Int) : Int :=
  if d = 0 then
    if e = 0 then intCmp (intSign n) (intSign m) else intSign n
  else if e = 0 then -intSign m
  else intCmp (n*e) (m*d)
def extrema_bounds : Prop :=
  ∀ (t : IntTy) (q : Rat t) (hq : Normalized q),
    let lo := if t.signed then typeminSignedRatSource (JInt t) (JInt.lit t 1) (JInt.lit t 0)
        JuliaLean.base.int.neg else typeminOtherRatSource (JInt t) (JInt.lit t 0) (JInt.lit t 1)
    let hi := typemaxRatSource (JInt t) (JInt.lit t 1) (JInt.lit t 0)
    Normalized lo ∧ Normalized hi ∧
    compareExtended lo.num.val lo.den.val q.num.val q.den.val ≤ 0 ∧
    compareExtended q.num.val q.den.val hi.num.val hi.den.val ≤ 0
def integer_rational_exact : Prop :=
  ∀ {T U P : Type} (i : IntegerParameters T) (j : IntegerParameters U)
    (p : IntegerParameters P) (m : PromotionParameters i j p) (k : T) (y : Rational U)
    (hy : Canonical j y),
    let gn : Int := Nat.gcd (val i k).natAbs (rn j y).natAbs
    let a := (val i k).tdiv gn * rd j y
    let b := (rn j y).tdiv gn
    let cv := p.fits (val i k) ∧ p.fits (rn j y) ∧ p.fits (rd j y)
    let safe := p.fits a ∧ (b < 0 → FitsPair p (-a) (-b))
    let run := divIntRatSource m.prom (dg p p) k y
    (¬ cv → IsInexact run) ∧
    (cv → gn = 0 → run = .error .divideError) ∧
    (cv → gn ≠ 0 → safe → ExactResult p run (val i k*rd j y) (rn j y)) ∧
    (cv → gn ≠ 0 → ¬ safe → IsOverflow run)
/-- A byte stream: `write` appends its bytes; `lock`/`unlock` are the `base/io.jl` fallbacks. -/
abbrev ByteStreamM (E : Type) := StateT (List UInt8) (Except E)
def byteStream {E : Type} : JuliaLean.base.show.IOPrims (ByteStreamM E) Unit Unit where
  write _ bytes := modify (· ++ bytes)
  lock _ := pure ()
  unlock _ := pure ()
  get _ _ := none
  displaysize _ := pure (JInt.wrap .i64 24, JInt.wrap .i64 80)
/-- `show(io, x::Rational)` on a byte stream, with the integer type's own `show` method `showT`
and the installed `print(io, "//")`. -/
def displayRun {T E : Type} (i : IntegerParameters T)
    (showT : T → ByteStreamM E Unit) (typed : Bool)
    (x : Rational T) (initial : List UInt8) : Except E (Unit × List UInt8) :=
  (showRationalSource (fun (_ : Unit) n => showT n)
    (fun (_ : Unit) s => JuliaLean.base.show.printStr byteStream (.plain ()) s)
    i.ops.isone (fun _ => typed) () x).run initial
def display_bytes : Prop :=
  ∀ {T E : Type} (i : IntegerParameters T) (showT : T → ByteStreamM E Unit)
    (showBytes : T → List UInt8) (typed : Bool) (x : Rational T) (initial : List UInt8),
    ((∀ n before, showT n before = .ok ((), before ++ showBytes n)) →
      displayRun i showT typed x initial = .ok ((), initial ++ showBytes x.num ++
        (if rd i x = 1 ∧ typed = true then []
         else "//".toUTF8.toList ++ showBytes x.den))) ∧
    (∀ e, showT x.num initial = .error e → displayRun i showT typed x initial = .error e)
def wordAt (bytes : List UInt8) (start : Nat) : Int :=
  ((List.range 8).foldl (fun n j => n + (bytes.getD (start+j) 0).toNat * 256^j) 0 : Nat)
def readUIntRational : JuliaLean.base.iobuffer.M (Rat .u64) :=
  readRationalSource (fun (_ : Unit) (_ : Unit) => JuliaLean.base.iobuffer.readUIntModel)
    (fun n d => JuliaLean.base.iobuffer.lift
      ((exactDivideIntsSource (rational (.bits .u64)) n d).mapError JuliaLean.base.iobuffer.IOErr.jl)) () ()
def binary_read : Prop :=
  ∀ (io : JuliaLean.base.iobuffer.BufferState)
    (hr : io.readable = true) (hp : 1 ≤ io.ptr.val)
    (hs : io.ptr.val+16 ≤ io.size.val+1) (hdata : io.size.val ≤ io.data.length)
    (hwrap : io.ptr.val+16 ≤ IntTy.i64.max),
    let n := wordAt io.data (io.ptr.val-1).toNat
    let d := wordAt io.data (io.ptr.val+7).toNat
    (n ≠ 0 ∨ d ≠ 0 → ∃ q out, readUIntRational io = .ok q out ∧ Normalized q ∧
      q.num.val*d = n*q.den.val ∧ (d ≠ 0 → q.den.val > 0) ∧
      out.ptr.val = io.ptr.val+16 ∧ out.data = io.data) ∧
    (n = 0 → d = 0 → ∃ out msg, readUIntRational io = .error (.jl (.argumentError msg)) out ∧
      out.ptr.val = io.ptr.val+16)
def extended_add_sub : Prop :=
  ∀ {T U P : Type} (i : IntegerParameters T) (j : IntegerParameters U)
    (p : IntegerParameters P) (m : PromotionParameters i j p) (x : Rational T) (y : Rational U)
    (hx : Canonical i x) (hy : Canonical j y) (hcv : Converts i j p x y),
    (rd i x = 0 → rd j y > 0 →
      ExactResult p (add m x y) (rn i x) 0 ∧
      (j.fits (-rn j y) → ExactResult p (sub m x y) (rn i x) 0) ∧
      (¬ j.fits (-rn j y) → IsOverflow (sub m x y))) ∧
    (rd i x > 0 → rd j y = 0 →
      (p.fits (rn j y*rd i x) → ExactResult p (add m x y) (rn j y) 0) ∧
      (¬ p.fits (rn j y*rd i x) → IsOverflow (add m x y)) ∧
      (p.fits (-rn j y*rd i x) → ExactResult p (sub m x y) (-rn j y) 0) ∧
      (¬ p.fits (-rn j y*rd i x) → IsOverflow (sub m x y))) ∧
    (rd i x = 0 → rd j y = 0 →
      (j.fits (-rn j y) →
        (rn i x = -rn j y → ExactResult p (sub m x y) (rn i x) 0) ∧
        (rn i x ≠ -rn j y → sub m x y = .error .divideError)) ∧
      (¬ j.fits (-rn j y) → IsOverflow (sub m x y)))
def finite_products_and_quotients : Prop :=
  ∀ {T U P : Type} (i : IntegerParameters T)
    (j : IntegerParameters U) (p : IntegerParameters P) (m : PromotionParameters i j p)
    (x : Rational T) (y : Rational U) (hx : Canonical i x) (hy : Canonical j y)
    (hxd : rd i x > 0) (hyd : rd j y > 0) (hcv : Converts i j p x y),
    let g1 : Int := Nat.gcd (rn i x).natAbs (rd j y).natAbs
    let g2 : Int := Nat.gcd (rd i x).natAbs (rn j y).natAbs
    let mn := (rn i x).tdiv g1*(rn j y).tdiv g2
    let md := (rd i x).tdiv g2*(rd j y).tdiv g1
    let gn : Int := Nat.gcd (rn i x).natAbs (rn j y).natAbs
    let gd : Int := Nat.gcd (rd i x).natAbs (rd j y).natAbs
    let dn := (rn i x).tdiv gn*(rd j y).tdiv gd
    let dd := (rd i x).tdiv gd*(rn j y).tdiv gn
    (FitsPair p mn md → ExactResult p (mulRatRatSource m.prom (dg p p) x y)
      (rn i x*rn j y) (rd i x*rd j y)) ∧
    (gn ≠ 0 → FitsPair p dn dd → (dd < 0 → FitsPair p (-dn) (-dd)) →
      ExactResult p (divRatRatSource m.prom (dg p p) x y)
        (rn i x*rd j y) (rd i x*rn j y))
def maxintfloatUInt64 (_x : JuliaLean.base.float.FV .f64) : JInt .u64 :=
  JInt.lit .u64 9007199254740992
abbrev hashRat {t : IntTy} (h64 : t ≠ .i128 ∧ t ≠ .u128)
    (o : JuliaLean.base.math.IEEEOps .f64) :=
  hashRational64Source h64
    (fun n => JuliaLean.base.hashing.hashInt64 (JInt.wrap .i64 n.val))
    JuliaLean.base.hashing.hashFloat64Canonical
    (fun n => JuliaLean.base.hashing.hashIntegerInt n.val)
    (fun x e => JuliaLean.base.math.ldexp
      {o with flipsign := JuliaLean.base.floatfuncs.flipsign_Float64} x e.val)
    maxintfloatUInt64 (jintOps t).isodd
    JuliaLean.base.int.trailing_zeros JuliaLean.base.int.shr_Int JuliaLean.base.int.shl_Int
open JuliaLean.Proofs.base.int
open JuliaLean.Proofs.base.rational.CoreLemmas
open JuliaLean.Proofs.base.rational.DivGcdCtorLemmas
open JuliaLean.Proofs.base.rational.ComparisonAndRoundingLemmas

/-- 2. `constructor_outcomes` (`rational-constructor-normalized-positive`). -/
theorem constructor_outcomes_aux {T N D : Type} (i : IntegerParameters T)
    (ni : IntegerParameters N) (di : IntegerParameters D) (n : N) (d : D) :
    ConstructorContract i (ctor i ni di n d (inexactErrorCore "Rational")) (val ni n) (val di d) := by
  cases i with | bits t =>
  cases ni with | bits nt =>
  cases di with | bits dt =>
  have hspec := ctorBits_spec t nt dt n d
  unfold ConstructorContract FitsPair ExactResult Represents Canonical reduced ctor
  dsimp only [rn, rd, val, IntegerParameters.fits, IntegerParameters.ops, jintOps]
  refine ⟨fun hg0 => ⟨_, hspec.1 (by exact_mod_cast hg0)⟩,
    fun hg0 hnegU => ⟨_, hspec.2.1 (by exact_mod_cast hg0) hnegU⟩,
    fun hg0 hnot_negU hnot_cv => ⟨_, hspec.2.2.1 (by exact_mod_cast hg0) hnot_negU hnot_cv⟩,
    fun hg0 hnot_negU hcv => ?_⟩
  have h4 := hspec.2.2.2 (by exact_mod_cast hg0) hnot_negU hcv
  refine ⟨fun hnorm => ?_, fun hnot_norm => h4.2 hnot_norm⟩
  obtain ⟨q, hq_ok, hq_norm, _, _, hcross, hd_pos, hd0⟩ := h4.1 hnorm
  exact ⟨q, hq_ok, hq_norm, hcross, hd_pos, hd0⟩

/-- 7. `native_constructor` (`rational-bit-constructor-total`). -/
theorem native_constructor_aux (t : IntTy) (n d : JInt t) :
    ConstructorContract (.bits t) (rational (.bits t) n d) n.val d.val := by
  change ConstructorContract (.bits t) (rationalBits t n d) (val (.bits t) n) (val (.bits t) d)
  rw [rationalBits_eq_ctorBits]
  exact constructor_outcomes_aux (.bits t) (.bits t) (.bits t) n d

/-- 1. `constructor_nonfinite` (`rational-zero-over-zero-rejected`). -/
theorem constructor_nonfinite_aux (t : IntTy) (n d : JInt t) :
    (n.val = 0 → d.val = 0 → IsArgument (rational (.bits t) n d)) ∧
    (n.val ≠ 0 → d.val = 0 → ∃ q, rational (.bits t) n d = .ok q ∧
      q.den.val = 0 ∧ q.num.val = (if n.val < 0 then -1 else 1) ∧ Normalized q) := by
  have hc := native_constructor_aux t n d
  unfold ConstructorContract FitsPair ExactResult Represents Canonical reduced at hc
  dsimp only [rn, rd, val, IntegerParameters.fits, IntegerParameters.ops, jintOps] at hc
  refine ⟨fun hn0 hd0 => ?_, fun hnz hd0 => ?_⟩
  · have hg0 : Nat.gcd n.val.natAbs d.val.natAbs = 0 := by
      rw [hn0, hd0, Int.natAbs_zero, Nat.gcd_zero_left]
    exact hc.1 hg0
  · have hg_eq : (Nat.gcd n.val.natAbs d.val.natAbs : Int) = (n.val.natAbs : Int) := by
      rw [hd0, Int.natAbs_zero, Nat.gcd_zero_right]
    have hg_nz : Nat.gcd n.val.natAbs d.val.natAbs ≠ 0 := by
      rw [hd0, Int.natAbs_zero, Nat.gcd_zero_right]
      exact Int.natAbs_ne_zero.mpr hnz
    have htself : n.val.tdiv n.val = 1 := by
      by_cases h : 0 ≤ n.val
      · rw [Int.tdiv_eq_ediv_of_nonneg h]; exact Int.ediv_self hnz
      · have h1 : 0 ≤ -n.val := by omega
        rw [← Int.neg_neg n.val, Int.tdiv_neg, Int.neg_tdiv, Int.neg_neg, Int.tdiv_eq_ediv_of_nonneg h1]
        exact Int.ediv_self (Int.neg_ne_zero.mpr hnz)
    have hr1 : n.val.tdiv (Nat.gcd n.val.natAbs d.val.natAbs : Int) =
        if n.val < 0 then -1 else 1 := by
      rw [hg_eq]
      by_cases hlt : n.val < 0
      · have habs : (n.val.natAbs : Int) = -n.val := Int.ofNat_natAbs_of_nonpos (by omega)
        rw [if_pos hlt, habs, Int.tdiv_neg, htself]
      · have habs : (n.val.natAbs : Int) = n.val := Int.natAbs_of_nonneg (by omega)
        rw [if_neg hlt, habs, htself]
    have hr2 : d.val.tdiv (Nat.gcd n.val.natAbs d.val.natAbs : Int) = 0 := by
      rw [hd0, Int.zero_tdiv]
    have hnot_negU : ¬ ((!t.signed) = true ∧ n.val ≠ 0 ∧ ((n.val < 0) ≠ (d.val < 0))) := by
      rintro ⟨hu, _, hne⟩
      have hu' : t.signed = false := by cases h : t.signed <;> simp_all
      have hn_nn := nonneg_of_unsigned hu' n
      simp [hd0, show ¬ n.val < 0 by omega] at hne
    have hfit0 : t.min ≤ 0 ∧ 0 ≤ t.max := ⟨min_le_zero t, zero_le_max t⟩
    have hfit1 : t.min ≤ 1 ∧ 1 ≤ t.max := ⟨Int.le_trans (min_le_zero t) (by decide), one_le_max t⟩
    have hconv : (t.min ≤ (if !t.signed then ((n.val.tdiv (Nat.gcd n.val.natAbs d.val.natAbs : Int)).natAbs : Int)
        else n.val.tdiv (Nat.gcd n.val.natAbs d.val.natAbs : Int)) ∧
        (if !t.signed then ((n.val.tdiv (Nat.gcd n.val.natAbs d.val.natAbs : Int)).natAbs : Int)
        else n.val.tdiv (Nat.gcd n.val.natAbs d.val.natAbs : Int)) ≤ t.max) ∧
        (t.min ≤ (if !t.signed then ((d.val.tdiv (Nat.gcd n.val.natAbs d.val.natAbs : Int)).natAbs : Int)
        else d.val.tdiv (Nat.gcd n.val.natAbs d.val.natAbs : Int)) ∧
        (if !t.signed then ((d.val.tdiv (Nat.gcd n.val.natAbs d.val.natAbs : Int)).natAbs : Int)
        else d.val.tdiv (Nat.gcd n.val.natAbs d.val.natAbs : Int)) ≤ t.max) := by
      rw [hr1, hr2]
      refine ⟨?_, by split <;> exact hfit0⟩
      by_cases hu : (!t.signed) = true
      · rw [if_pos hu]
        by_cases hlt : n.val < 0 <;> simp [hlt, hfit1]
      · have hs : t.signed = true := by cases h : t.signed <;> simp_all
        rw [if_neg hu]
        by_cases hlt : n.val < 0
        · rw [if_pos hlt]
          exact ⟨neg_one_ge_min_of_signed hs, Int.le_trans (by decide) (zero_le_max t)⟩
        · rw [if_neg hlt]; exact hfit1
    obtain ⟨q, hq_ok, hq_norm, _, _, hq_inf⟩ :=
      (hc.2.2.2 hg_nz hnot_negU hconv).1 (fun hlt => by rw [hr2] at hlt; by_cases hu : (!t.signed) = true <;> simp [hu] at hlt)
    obtain ⟨hqd0, hq_sign⟩ := hq_inf hd0
    have hqn_abs := (normalized_extremes_full hq_norm).2 hqd0
    have hqn_val : q.num.val = if n.val < 0 then -1 else 1 := by
      unfold intSign at hq_sign
      by_cases hlt : n.val < 0
      · have hgt : ¬ (n.val > 0) := by omega
        rcases hqn_abs.2 with h1 | h1 <;> simp [h1, hlt, hgt] at hq_sign ⊢
      · have hgt : n.val > 0 := by omega
        rcases hqn_abs.2 with h1 | h1 <;> simp [h1, hlt, hgt] at hq_sign ⊢
    exact ⟨q, hq_ok, hqd0, hqn_val, hq_norm⟩

/-- 3. `components_reconstruct` (`rational-components-roundtrip`). -/
theorem components_reconstruct_aux {T : Type} (i : IntegerParameters T) (x : Rational T)
    (hx : Canonical i x) :
    exactDivideIntsSource (rational i) (numeratorRationalSource x) (denominatorRationalSource x) = .ok x ∧
    let (n,e,d) := decomposeSource x
    n = x.num ∧ d = x.den ∧ e.val = 0 ∧
    ConstructorContract i (rational i n d) (rn i x) (rd i x) := by
  cases i with | bits t =>
  have hnorm : Normalized x := hx
  have hc := native_constructor_aux t x.num x.den
  have hok : rational (.bits t) x.num x.den = .ok x := by
    have hspec := ctorBits_spec t t t x.num x.den
    rw [← rationalBits_eq_ctorBits] at hspec
    have hg1 : Nat.gcd x.num.val.natAbs x.den.val.natAbs = 1 := hnorm.2
    have hg_nz : (Nat.gcd x.num.val.natAbs x.den.val.natAbs : Int) ≠ 0 := by rw [hg1]; decide
    have hr1 : x.num.val.tdiv (Nat.gcd x.num.val.natAbs x.den.val.natAbs : Int) = x.num.val := by
      rw [hg1]; exact Int.tdiv_one _
    have hr2 : x.den.val.tdiv (Nat.gcd x.num.val.natAbs x.den.val.natAbs : Int) = x.den.val := by
      rw [hg1]; exact Int.tdiv_one _
    have hnot_negU : ¬ ((!t.signed) = true ∧ x.num.val ≠ 0 ∧ ((x.num.val < 0) ≠ (x.den.val < 0))) := by
      rintro ⟨hu, _, hne⟩
      have hu' : t.signed = false := by cases h : t.signed <;> simp_all
      have hn_nn := nonneg_of_unsigned hu' x.num
      have hd_nn := nonneg_of_unsigned hu' x.den
      exact hne (propext ⟨fun h => absurd h (Int.not_lt.mpr hn_nn), fun h => absurd h (Int.not_lt.mpr hd_nn)⟩)
    have ha_eq : (if !t.signed then ((x.num.val.tdiv (Nat.gcd x.num.val.natAbs x.den.val.natAbs : Int)).natAbs : Int)
        else x.num.val.tdiv (Nat.gcd x.num.val.natAbs x.den.val.natAbs : Int)) = x.num.val := by
      rw [hr1]
      by_cases hu : (!t.signed) = true
      · have hu' : t.signed = false := by cases h : t.signed <;> simp_all
        rw [if_pos hu, Int.natAbs_of_nonneg (nonneg_of_unsigned hu' x.num)]
      · rw [if_neg hu]
    have hb_eq : (if !t.signed then ((x.den.val.tdiv (Nat.gcd x.num.val.natAbs x.den.val.natAbs : Int)).natAbs : Int)
        else x.den.val.tdiv (Nat.gcd x.num.val.natAbs x.den.val.natAbs : Int)) = x.den.val := by
      rw [hr2]
      by_cases hu : (!t.signed) = true
      · rw [if_pos hu, Int.natAbs_of_nonneg hnorm.1]
      · rw [if_neg hu]
    have hconv : (t.min ≤ (if !t.signed then ((x.num.val.tdiv (Nat.gcd x.num.val.natAbs x.den.val.natAbs : Int)).natAbs : Int)
        else x.num.val.tdiv (Nat.gcd x.num.val.natAbs x.den.val.natAbs : Int)) ∧
        (if !t.signed then ((x.num.val.tdiv (Nat.gcd x.num.val.natAbs x.den.val.natAbs : Int)).natAbs : Int)
        else x.num.val.tdiv (Nat.gcd x.num.val.natAbs x.den.val.natAbs : Int)) ≤ t.max) ∧
        (t.min ≤ (if !t.signed then ((x.den.val.tdiv (Nat.gcd x.num.val.natAbs x.den.val.natAbs : Int)).natAbs : Int)
        else x.den.val.tdiv (Nat.gcd x.num.val.natAbs x.den.val.natAbs : Int)) ∧
        (if !t.signed then ((x.den.val.tdiv (Nat.gcd x.num.val.natAbs x.den.val.natAbs : Int)).natAbs : Int)
        else x.den.val.tdiv (Nat.gcd x.num.val.natAbs x.den.val.natAbs : Int)) ≤ t.max) := by
      rw [ha_eq, hb_eq]; exact ⟨x.num.property, x.den.property⟩
    obtain ⟨q, hq_ok, _, hq_num, hq_den, _, _, _⟩ :=
      (hspec.2.2.2 hg_nz hnot_negU hconv).1 (fun hlt => by rw [hb_eq] at hlt; exact absurd hlt (Int.not_lt.mpr hnorm.1))
    rw [hb_eq, if_neg (Int.not_lt.mpr hnorm.1), ha_eq] at hq_num
    rw [hb_eq, if_neg (Int.not_lt.mpr hnorm.1)] at hq_den
    change rationalBits t x.num x.den = .ok x; rw [hq_ok]
    congr 1
    ext
    · exact hq_num
    · exact hq_den
  exact ⟨hok, rfl, rfl, rfl, hc⟩

/-- 4. `integer_generic` (`rational-from-integer-generic`). -/
theorem integer_generic_aux {T : Type} (i : IntegerParameters T) (n : T) :
    let q := rationalFromIntegerGeneric unsafeRationalSameSource (fun _ => i.ops.one) n
    Canonical i q ∧ Represents i q (val i n) 1 := by
  cases i with | bits t =>
  unfold rationalFromIntegerGeneric Canonical Represents
  dsimp only [unsafeRationalSameSource_pair, rn, rd, val, IntegerParameters.ops, jintOps]
  have hone : (JInt.lit t 1).val = 1 := by cases t <;> decide
  have hcanon : 0 ≤ (JInt.lit t 1).val ∧ Nat.gcd n.val.natAbs (JInt.lit t 1).val.natAbs = 1 := by
    rw [hone]; exact ⟨by decide, Nat.gcd_one_right _⟩
  exact ⟨hcanon, hcanon, by rw [hone], fun _ => by rw [hone]; decide,
    fun h => absurd h (by decide)⟩

/-- 5. `unsafe_values` (`rational-unsafe-value-preservation`). -/
theorem unsafe_values_aux {T U : Type} (i : IntegerParameters T) (j : IntegerParameters U) (n d : U) :
    let run := unsafeRationalTypeSource T (fun n => i.ops.fromInt (val j n))
      (fun n => i.ops.fromInt (val j n)) n d
    (FitsPair i (val j n) (val j d) → ∃ q, run = .ok q ∧ rn i q = val j n ∧ rd i q = val j d) ∧
    (¬ FitsPair i (val j n) (val j d) → IsInexact run) := by
  cases i with | bits t =>
  cases j with | bits s =>
  unfold unsafeRationalTypeSource FitsPair
  dsimp only [rn, rd, val, IntegerParameters.fits, IntegerParameters.ops, jintOps,
    Bind.bind, Except.bind, Pure.pure, Except.pure]
  refine ⟨fun ⟨hfn, hfd⟩ => ?_, fun hnot => ?_⟩
  · rw [convert_of_fits hfn, convert_of_fits hfd]
    exact ⟨⟨⟨n.val, hfn⟩, ⟨d.val, hfd⟩⟩, rfl, rfl, rfl⟩
  · by_cases hfn : t.min ≤ n.val ∧ n.val ≤ t.max
    · have hfd : ¬ (t.min ≤ d.val ∧ d.val ≤ t.max) := fun h => hnot ⟨hfn, h⟩
      rw [convert_of_fits hfn, convert_of_not_fits hfd]
      exact ⟨t.name, rfl⟩
    · rw [convert_of_not_fits hfn]
      exact ⟨t.name, rfl⟩

/-- 6. `promoted_components` (`rational-promotion-and-zero-error`). -/
theorem promoted_components_aux {T U P : Type} (i : IntegerParameters T) (j : IntegerParameters U)
    (p : IntegerParameters P) (m : PromotionParameters i j p) (n : T) (d : U) :
    (FitsPair p (val i n) (val j d) → ∃ q, unsafeRationalPromoteSource m.prom.promote n d = .ok q ∧
      rn p q = val i n ∧ rd p q = val j d) ∧
    (¬ FitsPair p (val i n) (val j d) → IsInexact (unsafeRationalPromoteSource m.prom.promote n d)) ∧
    (val i n = 0 → val j d = 0 → ctor p i j n d (inexactErrorCore "Rational") =
      .error (.argumentError ("invalid rational: zero(" ++ p.ops.typeName ++ ")//zero(" ++ p.ops.typeName ++ ")"))) := by
  cases m with
  | same i =>
    cases i with | bits t =>
    have hfit : FitsPair (.bits t) (val (.bits t) n) (val (.bits t) d) :=
      ⟨n.property, d.property⟩
    refine ⟨fun _ => ⟨⟨n, d⟩, rfl, rfl, rfl⟩,
      fun hnot => absurd hfit hnot,
      fun hn0 hd0 => ctorBits_zero_zero t t t n d hn0 hd0 _⟩
  | bits t s =>
    have hprom_eq : unsafeRationalPromoteSource (PromotionParameters.prom (.bits t s)).promote n d = (do
        let (n', d') ← (do
          let xp ← JInt.convert ((t.promote s).name) (t.promote s) n.val
          let yp ← JInt.convert ((t.promote s).name) (t.promote s) d.val
          pure (xp, yp))
        pure (unsafeRationalSameSource n' d')) := rfl
    rw [hprom_eq]
    unfold FitsPair
    dsimp only [rn, rd, val, IntegerParameters.fits, IntegerParameters.ops, jintOps,
      Bind.bind, Except.bind, Pure.pure, Except.pure]
    refine ⟨fun ⟨hfn, hfd⟩ => ?_, fun hnot => ?_,
      fun hn0 hd0 => ctorBits_zero_zero (t.promote s) t s n d hn0 hd0 _⟩
    · rw [convert_of_fits hfn, convert_of_fits hfd]
      exact ⟨⟨⟨n.val, hfn⟩, ⟨d.val, hfd⟩⟩, rfl, rfl, rfl⟩
    · by_cases hfn : (t.promote s).min ≤ n.val ∧ n.val ≤ (t.promote s).max
      · have hfd : ¬ ((t.promote s).min ≤ d.val ∧ d.val ≤ (t.promote s).max) := fun h => hnot ⟨hfn, h⟩
        rw [convert_of_fits hfn, convert_of_not_fits hfd]
        exact ⟨(t.promote s).name, rfl⟩
      · rw [convert_of_not_fits hfn]
        exact ⟨(t.promote s).name, rfl⟩


/-- 11. `unary_spec` (`rational-unary-predicates-exact`). -/
theorem unary_spec_aux {T : Type} (i : IntegerParameters T) (x : Rational T) (hx : Canonical i x) :
    (i.fits (-rn i x) → ∃ q, neg i x = .ok q ∧ rn i q = -rn i x ∧ rd i q = rd i x) ∧
    (¬ i.fits (-rn i x) → IsOverflow (neg i x)) ∧
    (i.fits (rn i x).natAbs → ExactResult i (absRatSource i.ops.checkedAbs x) (rn i x).natAbs (rd i x)) ∧
    (¬ i.fits (rn i x).natAbs → IsOverflow (absRatSource i.ops.checkedAbs x)) ∧
    Represents i (unaryPlusRatSource i.ops.uplus x) (rn i x) (rd i x) ∧
    signbitRatSource i.ops.signbit x = decide (rn i x < 0) ∧
    isIntegerRatSource i.ops.isone x = decide (rd i x > 0 ∧ rd i x ∣ rn i x) ∧
    isZeroRationalSource i.ops.iszero x = decide (rn i x = 0) ∧
    isOneRationalSource i.ops.isone x = decide (rn i x = rd i x) := by
  cases i with | bits t =>
  have hnorm : Normalized x := hx
  have hneg_parts : (IntegerParameters.fits (.bits t) (-rn (.bits t) x) →
      ∃ q, neg (.bits t) x = .ok q ∧ rn (.bits t) q = -rn (.bits t) x ∧ rd (.bits t) q = rd (.bits t) x) ∧
      (¬ IntegerParameters.fits (.bits t) (-rn (.bits t) x) → IsOverflow (neg (.bits t) x)) := by
    unfold neg
    dsimp only [rn, rd, val, IntegerParameters.fits, IntegerParameters.ops, jintOps]
    by_cases hs : t.signed = true
    · simp only [hs, ↓reduceDIte]
      have hmin_val : (JInt.typemin t).val = t.min := by cases t <;> decide
      have hmin_eq := max_lt_neg_min_of_signed hs
      have hx_prop := x.num.property
      by_cases hxmin : x.num.val = t.min
      · have hnot_fit : ¬ (t.min ≤ -x.num.val ∧ -x.num.val ≤ t.max) := by omega
        have heq : (x.num == JInt.typemin t) = true := by
          rw [beq_iff_eq]; exact Subtype.ext (hxmin.trans hmin_val.symm)
        refine ⟨fun hf => absurd hf hnot_fit, fun _ => ?_⟩
        unfold negBitSignedSource
        simp [heq, throwNumeratorTypeminSource, IsOverflow]
      · have hfit : t.min ≤ -x.num.val ∧ -x.num.val ≤ t.max := by omega
        have heq : (x.num == JInt.typemin t) = false := by
          rw [beq_eq_false_iff_ne]; intro h; apply hxmin; rw [h, hmin_val]
        refine ⟨fun _ => ?_, fun hn => absurd hfit hn⟩
        unfold negBitSignedSource
        simp only [heq, Bool.false_eq_true, ↓reduceIte, Pure.pure, Except.pure, unsafeRationalSameSource_pair]
        refine ⟨⟨-x.num, x.den⟩, rfl, ?_, rfl⟩
        change wrapInt t (-x.num.val) = -x.num.val
        exact wrapInt_of_inRange t _ hfit
    · simp only [hs, ↓reduceDIte]
      have hu : t.signed = false := Bool.eq_false_iff.mpr hs
      have hmin0 := min_eq_zero_of_unsigned hu
      have hx0 := nonneg_of_unsigned hu x.num
      have h0_val : (JInt.lit t 0).val = 0 := by cases t <;> decide
      simp only [negUnsignedSource, eq_eq x.num (JInt.lit t 0), h0_val]
      by_cases hnz : x.num.val = 0
      · have hfit : t.min ≤ -x.num.val ∧ -x.num.val ≤ t.max := by
          rw [hnz, Int.neg_zero]; exact ⟨min_le_zero t, zero_le_max t⟩
        rw [hnz] at hfit
        simp only [hnz, decide_true, Bool.not_true, Bool.false_eq_true, ↓reduceIte, Pure.pure, Except.pure]
        exact ⟨fun _ => ⟨x, rfl, by omega, rfl⟩, fun hn => absurd hfit hn⟩
      · have hnot_fit : ¬ (t.min ≤ -x.num.val ∧ -x.num.val ≤ t.max) := by omega
        simp only [hnz, decide_false, Bool.not_false, ↓reduceIte, throwNegateUnsignedSource]
        exact ⟨fun hf => absurd hf hnot_fit, fun _ => ⟨_, rfl⟩⟩
  have habs_parts : (IntegerParameters.fits (.bits t) (rn (.bits t) x).natAbs →
      ExactResult (.bits t) (absRatSource (IntegerParameters.ops (.bits t)).checkedAbs x) (rn (.bits t) x).natAbs (rd (.bits t) x)) ∧
      (¬ IntegerParameters.fits (.bits t) (rn (.bits t) x).natAbs →
      IsOverflow (absRatSource (IntegerParameters.ops (.bits t)).checkedAbs x)) := by
    unfold absRatSource
    dsimp only [rn, rd, val, IntegerParameters.fits, IntegerParameters.ops, jintOps,
      JuliaLean.base.rational.checkedAbs]
    have habs := JuliaLean.Proofs.base.checked.absExact t x.num
    unfold JuliaLean.Proofs.base.checked.ExactOrOverflow at habs
    have habs_eq : (if x.num.val < 0 then -x.num.val else x.num.val) = (x.num.val.natAbs : Int) := by omega
    rw [habs_eq] at habs
    by_cases hfit : t.min ≤ (x.num.val.natAbs : Int) ∧ (x.num.val.natAbs : Int) ≤ t.max
    · simp only [if_pos hfit] at habs
      obtain ⟨n', hn'_ok, hn'_val⟩ := habs
      simp only [hn'_ok, Bind.bind, Except.bind, Pure.pure, Except.pure, unsafeRationalSameSource_pair]
      refine ⟨fun _ => ⟨⟨n', x.den⟩, rfl, ?_⟩, fun hn => absurd hfit hn⟩
      unfold Represents Canonical
      dsimp only [rn, rd, val, IntegerParameters.ops, jintOps]
      have hcop : Nat.gcd n'.val.natAbs x.den.val.natAbs = 1 := by
        have : n'.val.natAbs = x.num.val.natAbs := by omega
        rw [this]; exact hnorm.2
      refine ⟨⟨hnorm.1, hcop⟩, by rw [hn'_val], fun hd_nz => by have := hnorm.1; omega, fun hd0 => ⟨hd0, ?_⟩⟩
      have hxn := (normalized_extremes_full hnorm).2 hd0
      rw [hn'_val, hxn.1]
    · simp only [if_neg hfit] at habs
      refine ⟨fun hf => absurd hf hfit, fun _ => ?_⟩
      cases hcall : JuliaLean.base.checked.checkedAbsBits x.num with
      | ok _ => rw [hcall] at habs; contradiction
      | error err =>
        rw [hcall] at habs
        cases err <;> first | contradiction | exact ⟨_, rfl⟩
  refine ⟨hneg_parts.1, hneg_parts.2, habs_parts.1, habs_parts.2, ?_, rfl, ?_, ?_, ?_⟩
  · unfold unaryPlusRatSource Represents Canonical
    dsimp only [rn, rd, val, IntegerParameters.ops, jintOps, unsafeRationalSameSource_pair]
    exact ⟨hnorm, rfl, fun hd_nz => by have := hnorm.1; omega, fun hd0 => ⟨hd0, rfl⟩⟩
  · unfold isIntegerRatSource
    dsimp only [IntegerParameters.ops, jintOps]
    rw [show (x.den.val == 1) = decide (x.den.val = 1) from rfl]
    apply decide_eq_decide.mpr
    dsimp only [rn, rd, val, IntegerParameters.ops, jintOps]
    constructor
    · intro hd1
      rw [hd1]
      exact ⟨by decide, Int.one_dvd _⟩
    · rintro ⟨hd_pos, hdvd⟩
      have hdvd_nat : x.den.val.natAbs ∣ x.num.val.natAbs := Int.natAbs_dvd_natAbs.mpr hdvd
      have hd_gcd : x.den.val.natAbs ∣ Nat.gcd x.num.val.natAbs x.den.val.natAbs :=
        Nat.dvd_gcd hdvd_nat (Nat.dvd_refl _)
      rw [hnorm.2] at hd_gcd
      have : x.den.val.natAbs = 1 := Nat.eq_one_of_dvd_one hd_gcd
      omega
  · unfold isZeroRationalSource numeratorRationalSource
    dsimp only [IntegerParameters.ops, jintOps]
    rw [show (x.num.val == 0) = decide (x.num.val = 0) from rfl]
    apply decide_eq_decide.mpr
    dsimp only [rn, val, IntegerParameters.ops, jintOps]
    exact Iff.rfl
  · unfold isOneRationalSource isOneRationalMethod numeratorRationalSource denominatorRationalSource bwand Bind.bind Id.instMonad
    dsimp only [rn, rd, val, IntegerParameters.ops, jintOps]
    by_cases hnd : x.num.val = x.den.val
    · have hd1 : x.den.val = 1 := by
        have hg := hnorm.2
        rw [hnd, Nat.gcd_self] at hg
        have := hnorm.1
        omega
      simp [hnd, hd1]
    · by_cases hd1 : x.den.val = 1
      · have hn1 : x.num.val ≠ 1 := by omega
        simp [hd1, hn1, hnd]
      · simp [hd1, hnd]

/-- 12. `unsigned_negation` (`rational-unsigned-negation-overflow`). -/
theorem unsigned_negation_aux (t : IntTy) (hu : t.signed = false) (x : Rat t) (hx : Normalized x) :
    (x.num.val ≠ 0 → IsOverflow (neg (.bits t) x)) ∧
    (x.num.val = 0 → (do let y ← neg (.bits t) x; neg (.bits t) y) = .ok x ∧ x.den.val = 1) := by
  have h0_val : (JInt.lit t 0).val = 0 := by cases t <;> decide
  unfold neg
  simp only [hu, Bool.false_eq_true, ↓reduceDIte, negUnsignedSource, eq_eq x.num (JInt.lit t 0), h0_val]
  refine ⟨fun hnz => ?_, fun hz => ?_⟩
  · exact ⟨"cannot negate unsigned number", by simp [hnz, throwNegateUnsignedSource]⟩
  · have hd1 : x.den.val = 1 := (normalized_extremes_full hx).1 hz
    simp [hz, hd1, Bind.bind, Except.bind, Pure.pure, Except.pure, eq_eq, h0_val]



/-! ## Helper Lemmas for Arithmetic, Remainders, GCD/LCM, Power-of-Two, Extrema, Complex, and I/O -/

theorem den_fits_of_canonical {T U P : Type} (i : IntegerParameters T) (j : IntegerParameters U)
    (p : IntegerParameters P) (m : PromotionParameters i j p)
    (x : Rational T) (y : Rational U) (hx : Canonical i x) (hy : Canonical j y) :
    p.fits (rd i x) ∧ p.fits (rd j y) := by
  cases m with
  | same i =>
    cases i with | bits t =>
    exact ⟨x.den.property, y.den.property⟩
  | bits t s =>
    exact ⟨⟨Int.le_trans (min_le_zero (t.promote s)) hx.1,
            Int.le_trans x.den.property.2 (max_le_promote_left t s)⟩,
           ⟨Int.le_trans (min_le_zero (t.promote s)) hy.1,
            Int.le_trans y.den.property.2 (max_le_promote_right t s)⟩⟩

theorem promoteR_spec {T U P : Type} (i : IntegerParameters T) (j : IntegerParameters U)
    (p : IntegerParameters P) (m : PromotionParameters i j p)
    (x : Rational T) (y : Rational U) :
    (Converts i j p x y → ∃ xp yp, promoteR m x y = .ok (xp, yp) ∧
      rn p xp = rn i x ∧ rd p xp = rd i x ∧ rn p yp = rn j y ∧ rd p yp = rd j y) ∧
    (¬ Converts i j p x y → IsInexact (promoteR m x y)) := by
  cases i with | bits t =>
  cases j with | bits s =>
  cases p with | bits pt =>
  unfold promoteR convertRat convertRatSource Converts
  dsimp only [rn, rd, val, IntegerParameters.fits, IntegerParameters.ops, jintOps,
    Bind.bind, Except.bind, Pure.pure, Except.pure]
  refine ⟨fun ⟨h1, h2, h3, h4⟩ => ?_, fun hnot => ?_⟩
  · rw [convert_of_fits h1, convert_of_fits h2, convert_of_fits h3, convert_of_fits h4]
    exact ⟨⟨⟨x.num.val, h1⟩, ⟨x.den.val, h2⟩⟩, ⟨⟨y.num.val, h3⟩, ⟨y.den.val, h4⟩⟩,
      rfl, rfl, rfl, rfl, rfl⟩
  · by_cases h1 : pt.min ≤ x.num.val ∧ x.num.val ≤ pt.max
    · by_cases h2 : pt.min ≤ x.den.val ∧ x.den.val ≤ pt.max
      · by_cases h3 : pt.min ≤ y.num.val ∧ y.num.val ≤ pt.max
        · have h4 : ¬ (pt.min ≤ y.den.val ∧ y.den.val ≤ pt.max) := fun h => hnot ⟨h1, h2, h3, h⟩
          rw [convert_of_fits h1, convert_of_fits h2, convert_of_fits h3, convert_of_not_fits h4]
          exact ⟨pt.name, rfl⟩
        · rw [convert_of_fits h1, convert_of_fits h2, convert_of_not_fits h3]
          exact ⟨pt.name, rfl⟩
      · rw [convert_of_fits h1, convert_of_not_fits h2]
        exact ⟨pt.name, rfl⟩
    · rw [convert_of_not_fits h1]
      exact ⟨pt.name, rfl⟩

theorem rational_pos_den_exact {T : Type} (p : IntegerParameters T) (n d : T)
    (hd : val p d > 0) :
    ExactResult p (rational p n d) (val p n) (val p d) := by
  cases p with | bits t =>
  change d.val > 0 at hd
  have hc := native_constructor_aux t n d
  unfold ConstructorContract FitsPair reduced at hc
  dsimp only [rn, rd, val, IntegerParameters.fits, IntegerParameters.ops, jintOps] at hc
  have hg_pos : 0 < Nat.gcd n.val.natAbs d.val.natAbs :=
    Nat.gcd_pos_of_pos_right _ (Int.natAbs_pos.mpr (by omega))
  have hg_nz : Nat.gcd n.val.natAbs d.val.natAbs ≠ 0 := Nat.ne_of_gt hg_pos
  let g : Int := Nat.gcd n.val.natAbs d.val.natAbs
  have hg_int_pos : 0 < g := Int.natCast_pos.mpr hg_pos
  have hr1_fit : t.min ≤ n.val.tdiv g ∧ n.val.tdiv g ≤ t.max :=
    fits_between n (tdiv_between n.val g hg_int_pos)
  have hr2_fit : t.min ≤ d.val.tdiv g ∧ d.val.tdiv g ≤ t.max :=
    fits_between d (tdiv_between d.val g hg_int_pos)
  have hr2_pos : 0 < d.val.tdiv g := by
    have hdvd : Nat.gcd n.val.natAbs d.val.natAbs ∣ d.val.natAbs := Nat.gcd_dvd_right _ _
    have hpos_nat : 0 < d.val.natAbs / Nat.gcd n.val.natAbs d.val.natAbs :=
      Nat.div_gcd_pos_of_pos_right _ (Int.natAbs_pos.mpr (by omega))
    have hnn : 0 ≤ d.val := by omega
    rw [Int.tdiv_eq_ediv_of_nonneg hnn]
    have hd_eq : d.val = (d.val.natAbs : Int) := (Int.natAbs_of_nonneg hnn).symm
    have hg_eq : g = (Nat.gcd n.val.natAbs d.val.natAbs : Int) := rfl
    rw [hd_eq, hg_eq, ← Int.natCast_ediv]
    exact Int.natCast_pos.mpr hpos_nat
  have hnot_negU : ¬ ((!t.signed) = true ∧ n.val ≠ 0 ∧ ((n.val < 0) ≠ (d.val < 0))) := by
    rintro ⟨hu, _, hne⟩
    have hu' : t.signed = false := by cases h : t.signed <;> simp_all
    have hn_nn := nonneg_of_unsigned hu' n
    have hd_nn : 0 ≤ d.val := by omega
    exact hne (propext ⟨fun h => absurd h (Int.not_lt.mpr hn_nn), fun h => absurd h (Int.not_lt.mpr hd_nn)⟩)
  have hconv : (t.min ≤ (if !t.signed then ((n.val.tdiv g).natAbs : Int) else n.val.tdiv g) ∧
      (if !t.signed then ((n.val.tdiv g).natAbs : Int) else n.val.tdiv g) ≤ t.max) ∧
      (t.min ≤ (if !t.signed then ((d.val.tdiv g).natAbs : Int) else d.val.tdiv g) ∧
      (if !t.signed then ((d.val.tdiv g).natAbs : Int) else d.val.tdiv g) ≤ t.max) := by
    by_cases hu : (!t.signed) = true
    · have hu' : t.signed = false := by cases h : t.signed <;> simp_all
      have hn_nn : 0 ≤ n.val.tdiv g := (tdiv_between n.val g hg_int_pos).1 (nonneg_of_unsigned hu' n) |>.1
      rw [if_pos hu, if_pos hu, Int.natAbs_of_nonneg hn_nn, Int.natAbs_of_nonneg (by omega)]
      exact ⟨hr1_fit, hr2_fit⟩
    · rw [if_neg hu, if_neg hu]
      exact ⟨hr1_fit, hr2_fit⟩
  exact (hc.2.2.2 hg_nz hnot_negU hconv).1 (fun hlt => by
    dsimp only [g] at hr2_pos; by_cases hu : (!t.signed) = true <;> simp [hu] at hlt <;> omega)

theorem represents_scale_pos {T : Type} {p : IntegerParameters T} {q : Rational T}
    {n d g : Int} (hg : 0 < g) (hrep : Represents p q n d) :
    Represents p q (n * g) (d * g) := by
  rcases hrep with ⟨hcan, hcross, hd_pos, hd0⟩
  refine ⟨hcan, ?_, fun hdg_nz => hd_pos fun hd_z => hdg_nz (by rw [hd_z, Int.zero_mul]),
    fun hdg0 => ?_⟩
  · calc rn p q * (d * g) = (rn p q * d) * g := by rw [← Int.mul_assoc]
      _ = (n * rd p q) * g := by rw [hcross]
      _ = (n * g) * rd p q := by rw [Int.mul_right_comm n (rd p q) g]
  · have hd_z : d = 0 := (Int.mul_eq_zero.mp hdg0).resolve_right (by omega)
    obtain ⟨hqd0, hsign⟩ := hd0 hd_z
    refine ⟨hqd0, ?_⟩
    rw [hsign]
    unfold intSign
    by_cases hn_lt : n < 0
    · have hng_lt : n * g < 0 := Int.mul_neg_of_neg_of_pos hn_lt hg
      simp [hn_lt, hng_lt]
    · by_cases hn_gt : n > 0
      · have hng_gt : n * g > 0 := Int.mul_pos hn_gt hg
        simp [hn_lt, hn_gt, hng_gt, show ¬ n * g < 0 by omega]
      · have hn0 : n = 0 := by omega
        simp [hn0]

theorem prom_promote_spec {T U P : Type} {i : IntegerParameters T} {j : IntegerParameters U}
    {p : IntegerParameters P} (m : PromotionParameters i j p) (a : T) (b : U) :
    (FitsPair p (val i a) (val j b) →
      ∃ pa pb, m.prom.promote a b = .ok (pa, pb) ∧ val p pa = val i a ∧ val p pb = val j b) ∧
    (¬ FitsPair p (val i a) (val j b) → IsInexact (m.prom.promote a b)) := by
  cases m with
  | same i =>
    cases i with | bits t =>
    have hf : FitsPair (.bits t) (val (.bits t) a) (val (.bits t) b) := ⟨a.property, b.property⟩
    exact ⟨fun _ => ⟨a, b, rfl, rfl, rfl⟩, fun hn => absurd hf hn⟩
  | bits t s =>
    have hprom_eq : (PromotionParameters.prom (.bits t s)).promote a b = (do
        let xp ← JInt.convert ((t.promote s).name) (t.promote s) a.val
        let yp ← JInt.convert ((t.promote s).name) (t.promote s) b.val
        pure (xp, yp)) := rfl
    rw [hprom_eq]
    unfold FitsPair
    dsimp only [val, IntegerParameters.fits, IntegerParameters.ops, jintOps,
      Bind.bind, Except.bind, Pure.pure, Except.pure]
    refine ⟨fun ⟨hfa, hfb⟩ => ?_, fun hnot => ?_⟩
    · rw [convert_of_fits hfa, convert_of_fits hfb]
      exact ⟨⟨a.val, hfa⟩, ⟨b.val, hfb⟩, rfl, rfl, rfl⟩
    · by_cases hfa : (t.promote s).min ≤ a.val ∧ a.val ≤ (t.promote s).max
      · have hfb : ¬ ((t.promote s).min ≤ b.val ∧ b.val ≤ (t.promote s).max) := fun h => hnot ⟨hfa, h⟩
        rw [convert_of_fits hfa, convert_of_not_fits hfb]
        exact ⟨(t.promote s).name, rfl⟩
      · rw [convert_of_not_fits hfa]
        exact ⟨(t.promote s).name, rfl⟩

theorem prom_checkedMulXP_spec {T U P : Type} {i : IntegerParameters T} {j : IntegerParameters U}
    {p : IntegerParameters P} (m : PromotionParameters i j p) (a : T) (v : P)
    (ha : p.fits (val i a)) :
    (p.fits (val i a * val p v) →
      ∃ r, m.prom.checkedMulXP a v = .ok r ∧ val p r = val i a * val p v) ∧
    (¬ p.fits (val i a * val p v) → IsOverflow (m.prom.checkedMulXP a v)) := by
  cases m with
  | same i =>
    cases i with | bits t =>
    have hmul := JuliaLean.Proofs.base.checked.mulExact t a v
    unfold JuliaLean.Proofs.base.checked.ExactOrOverflow at hmul
    by_cases hf : t.min ≤ a.val * v.val ∧ a.val * v.val ≤ t.max
    · simp only [if_pos hf] at hmul
      exact ⟨fun _ => hmul, fun hn => absurd hf hn⟩
    · simp only [if_neg hf] at hmul
      refine ⟨fun h => absurd h hf, fun _ => ?_⟩
      unfold PromotionParameters.prom samePromoteOps
      dsimp only [IntegerParameters.ops, jintOps, JuliaLean.base.rational.checkedMul]
      cases hcall : JuliaLean.base.checked.checkedMulBits a v with
      | ok _ => rw [hcall] at hmul; contradiction
      | error err =>
        rw [hcall] at hmul; cases err <;> first | contradiction | exact ⟨_, rfl⟩
  | bits t s =>
    let pt := t.promote s
    have hw : (JInt.wrap pt a.val) = ⟨a.val, ha⟩ :=
      Subtype.ext (wrapInt_of_inRange pt a.val ha)
    have hmul := JuliaLean.Proofs.base.checked.mulExact pt ⟨a.val, ha⟩ v
    unfold JuliaLean.Proofs.base.checked.ExactOrOverflow at hmul
    unfold PromotionParameters.prom jintPromoteOps JuliaLean.base.rational.checkedMul
    dsimp only [val, IntegerParameters.fits, IntegerParameters.ops, jintOps]
    rw [hw]
    by_cases hf : pt.min ≤ a.val * v.val ∧ a.val * v.val ≤ pt.max
    · simp only [if_pos hf] at hmul
      exact ⟨fun _ => hmul, fun hn => absurd hf hn⟩
    · simp only [if_neg hf] at hmul
      refine ⟨fun h => absurd h hf, fun _ => ?_⟩
      cases hcall : JuliaLean.base.checked.checkedMulBits ⟨a.val, ha⟩ v with
      | ok _ => rw [hcall] at hmul; contradiction
      | error err =>
        rw [hcall] at hmul; cases err <;> first | contradiction | exact ⟨_, rfl⟩

