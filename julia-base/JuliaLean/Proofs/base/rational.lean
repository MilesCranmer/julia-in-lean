/-- 11. `native_bool_value` (`rational-native-bool-value`). -/
theorem native_bool_value_aux (t : IntTy) (x : Rat t) (hx : Normalized x) :
    let run := boolOfRatSource
      (fun q => eqRatIntSource (fun n => JuliaLean.base.int.eq n (JInt.lit .i64 1))
        JuliaLean.base.int.eq q (JInt.lit .i64 0))
      (fun q => eqRatIntSource (fun n => JuliaLean.base.int.eq n (JInt.lit .i64 1))
        JuliaLean.base.int.eq q (JInt.lit .i64 1)) x inexactErrorCore
    (run = .ok false ↔ x.num.val = 0) ∧
    (run = .ok true ↔ x.den.val > 0 ∧ x.num.val = x.den.val) ∧
    (x.num.val ≠ 0 → (x.den.val = 0 ∨ x.num.val ≠ x.den.val) → IsInexact run) := by
  intro run
  have h0 : (JInt.lit .i64 0).val = 0 := rfl
  have h1 : (JInt.lit .i64 1).val = 1 := rfl
  have heq0 : eqRatIntSource (fun n => JuliaLean.base.int.eq n (JInt.lit .i64 1))
      JuliaLean.base.int.eq x (JInt.lit .i64 0) = decide (x.num.val = 0) := by
    unfold eqRatIntSource eqRatIntMethod bwand Bind.bind Id.instMonad; dsimp only
    rw [eq_eq x.den (JInt.lit .i64 1), eq_eq x.num (JInt.lit .i64 0), h0, h1]
    by_cases hn0 : x.num.val = 0
    · have hd1 : x.den.val = 1 := (normalized_extremes_full hx).1 hn0
      simp [hn0, hd1]
    · simp [hn0]
  have heq1 : eqRatIntSource (fun n => JuliaLean.base.int.eq n (JInt.lit .i64 1))
      JuliaLean.base.int.eq x (JInt.lit .i64 1) = decide (x.den.val > 0 ∧ x.num.val = x.den.val) := by
    unfold eqRatIntSource eqRatIntMethod bwand Bind.bind Id.instMonad; dsimp only
    rw [eq_eq x.den (JInt.lit .i64 1), eq_eq x.num (JInt.lit .i64 1), h1]
    by_cases hd1 : x.den.val = 1
    · by_cases hn1 : x.num.val = 1 <;> simp [hd1, hn1]
    · have hnot : ¬ (x.den.val > 0 ∧ x.num.val = x.den.val) := by
        rintro ⟨hd_pos, hnd⟩
        apply hd1
        have hg := hx.2
        rw [hnd, Nat.gcd_self] at hg
        omega
      simp [hd1, hnot]
  unfold run boolOfRatSource
  simp only [heq0, heq1]
  refine ⟨?_, ?_, fun hn0 hnot1 => ?_⟩
  · by_cases hn0 : x.num.val = 0
    · simp [hn0]
    · by_cases h1_cond : x.den.val > 0 ∧ x.num.val = x.den.val <;> simp [hn0, h1_cond]
  · by_cases h1_cond : x.den.val > 0 ∧ x.num.val = x.den.val
    · simp [h1_cond.1, h1_cond.2, show x.den.val ≠ 0 by omega]
    · by_cases hn0 : x.num.val = 0
      · simp [hn0, show ¬ (0 < x.den.val ∧ (0 : Int) = x.den.val) by omega]
      · simp [hn0, h1_cond]
  · have hnot_c1 : ¬ (x.den.val > 0 ∧ x.num.val = x.den.val) := by
      rcases hnot1 with hd0 | hne <;> omega
    simp [hn0, hnot_c1, IsInexact]

/-- 12. `native_integer_value` (`rational-native-integer-value`). -/
theorem native_integer_value_aux (t s : IntTy) (x : Rat s) (hx : Normalized x) :
    let run := intOfRatSource (JInt t) t.name
      (isIntegerRatSource (fun n => JuliaLean.base.int.eq n (JInt.lit .i64 1)))
      (JuliaLean.base.int.convert t) x inexactErrorCore
    (x.den.val > 0 → x.den.val ∣ x.num.val →
      (t.min ≤ x.num.val.tdiv x.den.val ∧ x.num.val.tdiv x.den.val ≤ t.max) →
      ∃ out, run = .ok out ∧ out.val*x.den.val = x.num.val) ∧
    ((x.den.val = 0 ∨ ¬ x.den.val ∣ x.num.val ∨
      ¬ (t.min ≤ x.num.val.tdiv x.den.val ∧ x.num.val.tdiv x.den.val ≤ t.max)) → IsInexact run) := by
  intro run
  have h1 : (JInt.lit .i64 1).val = 1 := rfl
  have hisint : isIntegerRatSource (fun n => JuliaLean.base.int.eq n (JInt.lit .i64 1)) x =
      decide (x.den.val = 1) := by
    unfold isIntegerRatSource; dsimp only; rw [eq_eq x.den (JInt.lit .i64 1), h1]
  have hd1_iff : x.den.val = 1 ↔ (x.den.val > 0 ∧ x.den.val ∣ x.num.val) := by
    constructor
    · intro hd1; rw [hd1]; exact ⟨by decide, Int.one_dvd _⟩
    · rintro ⟨hd_pos, hdvd⟩
      have hdvd_nat : x.den.val.natAbs ∣ x.num.val.natAbs := Int.natAbs_dvd_natAbs.mpr hdvd
      have hd_gcd : x.den.val.natAbs ∣ Nat.gcd x.num.val.natAbs x.den.val.natAbs :=
        Nat.dvd_gcd hdvd_nat (Nat.dvd_refl _)
      rw [hx.2] at hd_gcd
      have : x.den.val.natAbs = 1 := Nat.eq_one_of_dvd_one hd_gcd
      omega
  unfold run intOfRatSource JuliaLean.base.int.convert
  rw [hisint]
  refine ⟨fun hd_pos hdvd hfit => ?_, fun hbad => ?_⟩
  · have hd1 : x.den.val = 1 := hd1_iff.mpr ⟨hd_pos, hdvd⟩
    rw [hd1, Int.tdiv_one] at hfit
    simp [hd1, convert_of_fits hfit]
  · by_cases hd1 : x.den.val = 1
    · have ⟨hd_pos, hdvd⟩ := hd1_iff.mp hd1
      have hnot_fit : ¬ (t.min ≤ x.num.val ∧ x.num.val ≤ t.max) := by
        rcases hbad with hd0 | hndvd | hnf
        · omega
        · exact absurd hdvd hndvd
        · rwa [hd1, Int.tdiv_one] at hnf
      simp [hd1, convert_of_not_fits hnot_fit, IsInexact]
    · simp [hd1, IsInexact]

/-- 13. `native_integer_rationalize` (`rational-native-integer-rationalize`). -/
theorem native_integer_rationalize_aux (t s : IntTy) (x : JInt s) :
    let run := rationalizeIntegerTypedSource (JInt t) (IntegerParameters.ops (.bits t))
      (fun n => JuliaLean.base.int.lt n (JInt.lit .i64 0))
      (fun n => JuliaLean.base.int.lt n (JInt.typemin t))
      (fun n => JuliaLean.base.int.lt (JInt.typemax t) n)
      (JuliaLean.base.int.convert t) (fun _ => JInt.lit s 1) x ()
    (t.signed = false → x.val < 0 → IsOverflow run) ∧
    (t.signed = true → x.val < t.min → ∃ q, run = .ok q ∧ Normalized q ∧ q.num.val = -1 ∧ q.den.val = 0) ∧
    (t.max < x.val → ∃ q, run = .ok q ∧ Normalized q ∧ q.num.val = 1 ∧ q.den.val = 0) ∧
    ((t.min ≤ x.val ∧ x.val ≤ t.max) → ∃ q, run = .ok q ∧
      Normalized q ∧ q.num.val = x.val ∧ q.den.val = 1) := by
  intro run
  have h0_i64 : (JInt.lit .i64 0).val = 0 := rfl
  have hmin_val : (JInt.typemin t).val = t.min := by cases t <;> decide
  have hmax_val : (JInt.typemax t).val = t.max := by cases t <;> decide
  have h0_t : (JInt.lit t 0).val = 0 := by cases t <;> decide
  have h1_t : (JInt.lit t 1).val = 1 := by cases t <;> decide
  unfold run rationalizeIntegerTypedSource
  simp only [IntegerParameters.ops, jintOps, lt_eq x (JInt.lit .i64 0),
    lt_eq x (JInt.typemin t), lt_eq (JInt.typemax t) x, h0_i64, hmin_val, hmax_val]
  refine ⟨fun hu hx_lt => ?_, fun hs hx_lt_min => ?_, fun hx_gt_max => ?_, fun hfit => ?_⟩
  · simp only [hu, Bool.not_false, decide_eq_true hx_lt, Bool.true_and, ↓reduceIte]
    exact ⟨"cannot negate unsigned number", rfl⟩
  · have hm1_t : (JInt.lit t (-1)).val = -1 := by
      cases t <;> simp_all [IntTy.signed] <;> decide
    simp only [hs, Bool.not_true, Bool.false_and, Bool.false_eq_true, ↓reduceIte,
      decide_eq_true hx_lt_min, Pure.pure, Except.pure, unsafeRationalSameSource_pair]
    refine ⟨_, rfl, ⟨by rw [h0_t]; decide, by rw [hm1_t, h0_t]; decide⟩, hm1_t, h0_t⟩
  · have hnot_lt0 : decide (x.val < 0) = false := by
      have := zero_le_max t; exact decide_eq_false (by omega)
    have hnot_lt_min : decide (x.val < t.min) = false := by
      have := min_le_zero t; have := zero_le_max t; exact decide_eq_false (by omega)
    simp only [hnot_lt0, Bool.and_false, Bool.false_eq_true, ↓reduceIte,
      hnot_lt_min, decide_eq_true hx_gt_max, Pure.pure, Except.pure, unsafeRationalSameSource_pair]
    refine ⟨_, rfl, ⟨by rw [h0_t]; decide, by rw [h1_t, h0_t]; decide⟩, h1_t, h0_t⟩
  · have hnot_u_neg : (!t.signed && decide (x.val < 0)) = false := by
      by_cases hu : t.signed = false
      · have hmin0 := min_eq_zero_of_unsigned hu
        simp [hu, show ¬ x.val < 0 by omega]
      · have hs : t.signed = true := Decidable.byContradiction fun h => hu (Bool.eq_false_iff.mpr h)
        simp [hs]
    have hnot_lt_min : decide (x.val < t.min) = false := decide_eq_false (by omega)
    have hnot_gt_max : decide (t.max < x.val) = false := decide_eq_false (by omega)
    simp only [hnot_u_neg, Bool.false_eq_true, ↓reduceIte, hnot_lt_min, hnot_gt_max]
    exact (typed_integer_construction_aux t s x).1 hfit

/-- 14. `extended_exact_division` (`rational-native-extended-division`). -/
theorem extended_exact_division_aux (t s : IntTy) (x : Rat t) (y : Rat s)
    (hx : Normalized x) (hy : Normalized y) :
    let p := IntegerParameters.bits (t.promote s)
    let run := divRatRatSource (PromotionParameters.prom (.bits t s)) (dg p p) x y
    let gn : Int := Nat.gcd x.num.val.natAbs y.num.val.natAbs
    let gd : Int := Nat.gcd x.den.val.natAbs y.den.val.natAbs
    let a := x.num.val.tdiv gn
    let b := y.num.val.tdiv gn
    let c := x.den.val.tdiv gd
    let e := y.den.val.tdiv gd
    let flip := c = 0 ∧ b < 0
    let n := (if flip then -a else a)*e
    let d := c*b
    let safe := (flip → p.fits (-a)) ∧ FitsPair p n d ∧ (d < 0 → FitsPair p (-n) (-d))
    (¬ Converts (.bits t) (.bits s) p x y → IsInexact run) ∧
    (Converts (.bits t) (.bits s) p x y →
      ((gn = 0 ∨ gd = 0) → run = .error .divideError) ∧
      (gn ≠ 0 → gd ≠ 0 →
        (safe → ExactResult p run n d) ∧ (¬ safe → IsOverflow run))) := by
  intro p run gn gd a b c e flip n d safe
  have hed := Round3.exact_division_aux t s x y hx hy
  have hrun_eq : run = divRatRatSource (jintPromoteOps t s) (Round3.dg (.bits (t.promote s)) (.bits (t.promote s))) x y := rfl
  have hxd_fit : p.fits x.den.val :=
    ⟨Int.le_trans (min_le_zero (t.promote s)) hx.1, Int.le_trans x.den.property.2 (max_le_promote_left t s)⟩
  have hyd_fit : p.fits y.den.val :=
    ⟨Int.le_trans (min_le_zero (t.promote s)) hy.1, Int.le_trans y.den.property.2 (max_le_promote_right t s)⟩
  refine ⟨fun hnot_cv => ?_, fun hcv => ?_⟩
  · apply hed.1
    intro ⟨h1, h2, h3, h4⟩
    exact hnot_cv ⟨⟨h1, h2⟩, hxd_fit, ⟨h3, h4⟩, hyd_fit⟩
  · have hcf : (t.promote s).min ≤ x.num.val ∧ x.num.val ≤ (t.promote s).max ∧
        (t.promote s).min ≤ y.num.val ∧ y.num.val ≤ (t.promote s).max :=
      ⟨hcv.1.1, hcv.1.2, hcv.2.2.1.1, hcv.2.2.1.2⟩
    refine ⟨hed.2.1 hcf, fun hgn hgd => ?_⟩
    have hmain := hed.2.2.1 hcf hgn hgd
    refine ⟨fun ⟨hs1, ⟨hs2, hs3⟩, hs4⟩ => hmain.1 ⟨hs1, hs2, hs3, hs4⟩,
      fun hnot_s => hmain.2 fun ⟨hs1, hs2, hs3, hs4⟩ => hnot_s ⟨hs1, ⟨hs2, hs3⟩, hs4⟩⟩

