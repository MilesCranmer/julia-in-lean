/-- The first magnitude call has first refusal: an exception from uabs(x)
is the final exception with exactly its final world. No later magnitude,
gcd, division or conversion effect can replace it. This quantifies all
selected implementations without a correctness or purity law.
Source: base/rational.jl:59-62. -/
def DivgcdFirstMagnitudeFailure : Prop :=
  ∀ (World X Y UX UY G OtherX OtherY OtherTuple : Type)
    (ops : DivgcdOps (EStateM ArrayError World)
      X Y UX UY G OtherX OtherY OtherTuple)
    (x : X) (y : Y) (initial after : World) (error : ArrayError),
    ops.uabsX x initial = .error error after →
    divgcd ops x y initial = .error error after

/-- Second-division failure wins over all return-conversion and
return-type errors, even when the first quotient has the wrong target
type. The premises observe actual selected-call outcomes; they impose no
numerical law or globally correct-callee assumption.
Source: base/rational.jl:59-62; base/essentials.jl:652-667. -/
def DivgcdSecondDivisionFailure : Prop :=
  ∀ (World X Y UX UY G OtherX OtherY OtherTuple : Type)
    (ops : DivgcdOps (EStateM ArrayError World)
      X Y UX UY G OtherX OtherY OtherTuple)
    (x : X) (y : Y) (ux : UX) (uy : UY) (g : G)
    (qx : TypeAssertion X OtherX)
    (initial afterX afterY afterG afterDivX afterDivY : World)
    (error : ArrayError),
    ops.uabsX x initial = .ok ux afterX →
    ops.uabsY y afterX = .ok uy afterY →
    ops.gcd ux uy afterY = .ok g afterG →
    ops.divX x g afterG = .ok qx afterDivX →
    ops.divY y g afterDivX = .error error afterDivY →
    divgcd ops x y initial = .error error afterDivY

/-- In the known Base tuple conversion, an invalid value returned by the
first element conversion must not hide a later conversion exception. The
second conversion's exact exception and world win. Original X/Y witnesses
express the inhabited target-tuple invariant of this internal helper.
No conversion law, successful-return premise or first-result validity is
assumed. Source: base/essentials.jl:659-667; base/rational.jl:59. -/
def TupleReturnLaterConversionFailure : Prop :=
  ∀ (World X Y OtherX OtherY : Type)
    (_originalX : X) (_originalY : Y)
    (ops : TupleElementOps (EStateM ArrayError World) X Y OtherX OtherY)
    (rawX invalidX : OtherX) (rawY : OtherY)
    (initial afterX afterY : World) (error : ArrayError),
    ops.convertX rawX initial = .ok (.rejected invalidX) afterX →
    ops.convertY rawY afterX = .error error afterY →
    convertReturnTupleBase ops (.rejected rawX) (.rejected rawY) initial =
      .error error afterY

/-- If the first converted value still has the wrong type and the second
conversion succeeds, the final TypeError retains the second conversion's
world. Thus a malformed earlier result cannot erase later conversion
effects. The second result may itself have either target membership tag.
Source: base/essentials.jl:659-667; base/rational.jl:59. -/
def TupleReturnDelayedTypeError : Prop :=
  ∀ (World X Y OtherX OtherY : Type)
    (_originalX : X) (_originalY : Y)
    (ops : TupleElementOps (EStateM ArrayError World) X Y OtherX OtherY)
    (rawX invalidX : OtherX) (rawY : OtherY)
    (convertedY : TypeAssertion Y OtherY)
    (initial afterX afterY : World),
    ops.convertX rawX initial = .ok (.rejected invalidX) afterX →
    ops.convertY rawY afterX = .ok convertedY afterY →
    convertReturnTupleBase ops (.rejected rawX) (.rejected rawY) initial =
      .error (.showError .typeError) afterY

/-- Every selected custom tuple conversion is checked against the actual
annotated return type, with its returned world retained on TypeError.
The original quotient tags are unrestricted, including the both-accepted
case: a Base identity shortcut cannot suppress selected custom dispatch.
Source: base/rational.jl:59; base/essentials.jl:652-667;
doc/src/manual/conversion-and-promotion.md:101-109. -/
def TupleReturnCustomTypeError : Prop :=
  ∀ (World X Y OtherX OtherY OtherTuple : Type)
    (_originalX : X) (_originalY : Y)
    (ops : TupleReturnOps (EStateM ArrayError World)
      X Y OtherX OtherY OtherTuple)
    (qx : TypeAssertion X OtherX) (qy : TypeAssertion Y OtherY)
    (invalid : OtherTuple) (initial after : World),
    ops.selected qx qy = .custom →
    ops.custom qx qy initial = .ok (.rejected invalid) after →
    convertReturnTuple ops qx qy initial =
      .error (.showError .typeError) after

/-- Observed calls in divgcd's own body and known tuple-return helper.
Selected callee internals remain opaque. Source: base/rational.jl:59-62;
base/essentials.jl:652-667. -/
inductive DivgcdEvent where
  | uabsX | uabsY | gcd | divX | divY | convertX | convertY | customConversion
  deriving DecidableEq, BEq

/-- Record one selected call while leaving its world separate from the
ghost trace. Its result, exception and final world are retained unchanged.
This is specification instrumentation, not an arithmetic or conversion
implementation. Source: base/rational.jl:59-62. -/
def recordDivgcdCall {World A : Type} (event : DivgcdEvent)
    (action : EStateM ArrayError World A) :
    EStateM ArrayError (World × List DivgcdEvent) A :=
  fun (world, calls) =>
    match action world with
    | .ok result after => .ok result (after, calls ++ [event])
    | .error error after => .error error (after, calls ++ [event])

/-- Instrument every open call without exposing or replaying the trace to
any selected implementation. The selection metadata remains unchanged;
known tuple traversal and final assertions stay in the actual model.
Source: base/rational.jl:59-62; base/essentials.jl:652-667. -/
def observeDivgcdCalls
    {World X Y UX UY G OtherX OtherY OtherTuple : Type}
    (ops : DivgcdOps (EStateM ArrayError World)
      X Y UX UY G OtherX OtherY OtherTuple) :
    DivgcdOps (EStateM ArrayError (World × List DivgcdEvent))
      X Y UX UY G OtherX OtherY OtherTuple where
  uabsX x := recordDivgcdCall .uabsX (ops.uabsX x)
  uabsY y := recordDivgcdCall .uabsY (ops.uabsY y)
  gcd ux uy := recordDivgcdCall .gcd (ops.gcd ux uy)
  divX x g := recordDivgcdCall .divX (ops.divX x g)
  divY y g := recordDivgcdCall .divY (ops.divY y g)
  returnOps := {
    elements := {
      convertX := fun raw =>
        recordDivgcdCall .convertX (ops.returnOps.elements.convertX raw)
      convertY := fun raw =>
        recordDivgcdCall .convertY (ops.returnOps.elements.convertY raw) }
    selected := ops.returnOps.selected
    custom := fun qx qy =>
      recordDivgcdCall .customConversion (ops.returnOps.custom qx qy) }

/-- A partial-order constraint: every occurrence of a later call has
exactly one earlier prerequisite in its prefix. This does not enumerate
or replay a complete execution trace.
Source: base/rational.jl:59-62; base/essentials.jl:659-667. -/
def DivgcdCallPrecedes (calls : List DivgcdEvent)
    (earlier later : DivgcdEvent) : Prop :=
  ∀ (before after : List DivgcdEvent),
    calls = before ++ (later :: after) → before.count earlier = 1

/-- Independent call-count and partial-order bounds. Each own-body call
occurs at most once. Magnitudes precede gcd and divisions, and no return
conversion occurs before the second division. Base element conversion
keeps left-to-right order when both are needed; selected custom conversion
excludes Base element conversions entirely. No full trace or conversion
result is supplied as an expected execution.
Source: base/rational.jl:59-62; base/essentials.jl:652-667. -/
def DivgcdTraceInvariant (calls : List DivgcdEvent) : Prop :=
  calls.head? = some .uabsX ∧
  (∀ event : DivgcdEvent, calls.count event ≤ 1) ∧
  DivgcdCallPrecedes calls .uabsX .uabsY ∧
  DivgcdCallPrecedes calls .uabsY .gcd ∧
  DivgcdCallPrecedes calls .gcd .divX ∧
  DivgcdCallPrecedes calls .divX .divY ∧
  DivgcdCallPrecedes calls .divY .convertX ∧
  DivgcdCallPrecedes calls .divY .convertY ∧
  DivgcdCallPrecedes calls .divY .customConversion ∧
  (∀ (before after : List DivgcdEvent),
    calls = before ++ (.convertX :: after) → .convertY ∉ before) ∧
  (.customConversion ∈ calls → .convertX ∉ calls ∧ .convertY ∉ calls)

/-- All inputs, intermediate carriers, worlds and selected implementations
obey these partial-order and call-count restrictions. A successful result
requires both magnitude calls, gcd and both divisions to have occurred.
Failure runs obey the same ordering bounds without a success precondition.
No purity, arithmetic or conversion correctness law is assumed.
Source: base/rational.jl:59-62; base/essentials.jl:652-667. -/
def DivgcdNoPrematureReturnConversion : Prop :=
  ∀ (World X Y UX UY G OtherX OtherY OtherTuple : Type)
    (ops : DivgcdOps (EStateM ArrayError World)
      X Y UX UY G OtherX OtherY OtherTuple)
    (x : X) (y : Y) (initial : World),
    match divgcd (observeDivgcdCalls ops) x y (initial, []) with
    | .ok _ (_, calls) =>
        DivgcdTraceInvariant calls ∧
        calls.count .uabsX = 1 ∧ calls.count .uabsY = 1 ∧
        calls.count .gcd = 1 ∧ calls.count .divX = 1 ∧ calls.count .divY = 1
    | .error _ (_, calls) => DivgcdTraceInvariant calls

/-- Full selected-callee effects and exception priorities for divgcd,
including the concrete tuple-conversion helper on which it depends.
These independent invariants include malformed custom conversion results
and arbitrary state effects, without any callee-correctness premises.
Source: base/rational.jl:59-62; base/essentials.jl:652-667;
base/ntuple.jl:65-73. -/
def DivgcdEffects : Prop :=
  DivgcdFirstMagnitudeFailure ∧ DivgcdSecondDivisionFailure ∧
  TupleReturnLaterConversionFailure ∧ TupleReturnDelayedTypeError ∧
  TupleReturnCustomTypeError ∧ DivgcdNoPrematureReturnConversion

end JuliaLean.Proofs.base.rational.Models2Group10

