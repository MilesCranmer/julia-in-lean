def integerEq {T U : Type} (i : IntegerParameters T) (j : IntegerParameters U) : T → U → Bool :=
  match i,j with | .bits _,.bits _ => JuliaLean.base.int.eq
abbrev eqR {T U : Type} (i : IntegerParameters T) (j : IntegerParameters U) :=
