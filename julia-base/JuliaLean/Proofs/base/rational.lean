/-- 17. `native_integer_equality` (`rational-native-integer-equality`). -/
theorem native_integer_equality_aux (t s : IntTy) (x : Rat t) (n : JInt s) (hx : Normalized x) :
    eqRatIntSource (fun d => JuliaLean.base.int.eq d (JInt.lit .i64 1))
      JuliaLean.base.int.eq x n = decide (x.den.val > 0 ∧ x.num.val = n.val*x.den.val) := by
