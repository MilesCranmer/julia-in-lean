private theorem readWord_ok (t : IntTy) (hu : t.signed = false) (ltoh : JInt t → JInt t)
    (hlittle : ∀ x, ltoh x = x)
    (s : JuliaLean.base.iobuffer.BufferState)
    (hr : s.readable = true) (hp : 1 ≤ s.ptr.val)
    (hs : s.ptr.val + JuliaLean.base.int.sizeofT t ≤ s.size.val + 1)
    (hdata : s.size.val ≤ s.data.length)
    (hwrap : s.ptr.val + JuliaLean.base.int.sizeofT t ≤ IntTy.i64.max) :
    ∃ (w : JInt t) (s' : JuliaLean.base.iobuffer.BufferState),
      (readUnsignedWord t ltoh).run s = .ok w s' ∧
      w.val = wordAt s.data (s.ptr.val - 1).toNat (JuliaLean.base.int.sizeofT t) ∧
      s'.ptr.val = s.ptr.val + JuliaLean.base.int.sizeofT t ∧ s'.readable = true ∧
      s'.size = s.size ∧ s'.data = s.data := by
  cases t with
  | u8 => exact readWord_u8_ok ltoh s hr hp hs hdata hwrap
  | u16 => exact readWord_u16_ok ltoh hlittle s hr hp hs hdata hwrap
  | u32 => exact readWord_u32_ok ltoh hlittle s hr hp hs hdata hwrap
  | u64 => exact readWord_u64_ok ltoh hlittle s hr hp hs hdata hwrap
  | u128 => exact readWord_u128_ok ltoh hlittle s hr hp hs hdata hwrap
  | _ => exact absurd hu (by decide)

theorem binary_unsigned_read_proven : binary_unsigned_read := by
  intro t hu ltoh hlittle io hr hp hdata hs hwrap
  dsimp only
  obtain ⟨nJ, io1, hread1, hnJ_v, hptr1, hr1, hsize1, hdata1⟩ :=
    readWord_ok t hu ltoh hlittle io hr hp (by omega) hdata (by omega)
  obtain ⟨dJ, io2, hread2, hdJ_v, hptr2, _, _, hdata2⟩ :=
    readWord_ok t hu ltoh hlittle io1 hr1 (by rw [hptr1]; omega) (by rw [hptr1, hsize1]; omega)
      (by rw [hsize1, hdata1]; exact hdata) (by rw [hptr1]; omega)
  have hptr2_eq : io2.ptr.val = io.ptr.val + 2 * (JuliaLean.base.int.sizeofT t : Int) := by
    rw [hptr2, hptr1]; omega
  have hdata2_eq : io2.data = io.data := hdata2.trans hdata1
  have hstart2 : (io1.ptr.val - 1).toNat =
      (io.ptr.val - 1 + (JuliaLean.base.int.sizeofT t : Int)).toNat := by rw [hptr1]; omega
  rw [hdata1, hstart2] at hdJ_v
  generalize hn : wordAt io.data (io.ptr.val - 1).toNat (JuliaLean.base.int.sizeofT t) = n at hnJ_v ⊢
  generalize hd : wordAt io.data (io.ptr.val - 1 + (JuliaLean.base.int.sizeofT t : Int)).toNat
    (JuliaLean.base.int.sizeofT t) = d at hdJ_v ⊢
  simp only [EStateM.run] at hread1 hread2
  have hstep : readUnsignedRational t ltoh io =
      match (exactDivideIntsSource (rational (.bits t)) nJ dJ).mapError JuliaLean.base.iobuffer.IOErr.jl with
      | .ok val => EStateM.Result.ok val io2
      | .error err => EStateM.Result.error err io2 := by
    unfold readUnsignedRational readRationalSource JuliaLean.base.iobuffer.lift
    simp only [Bind.bind, EStateM.bind, Pure.pure, EStateM.pure, throw, throwThe,
      MonadExceptOf.throw, EStateM.throw, hread1, hread2]
    cases (exactDivideIntsSource (rational (.bits t)) nJ dJ).mapError JuliaLean.base.iobuffer.IOErr.jl <;> rfl
  rw [hstep]
  have hrat : rational (.bits t) nJ dJ =
      JuliaLean.Proofs.base.rational.Round4.rational (.bits t) nJ dJ := rfl
  have hc := JuliaLean.Proofs.base.rational.Round4.native_constructor_aux t nJ dJ
  unfold JuliaLean.Proofs.base.rational.Round4.ConstructorContract
    JuliaLean.Proofs.base.rational.Round4.FitsPair JuliaLean.Proofs.base.rational.Round4.ExactResult
    JuliaLean.Proofs.base.rational.Round4.Represents JuliaLean.Proofs.base.rational.Round4.Canonical
    JuliaLean.Proofs.base.rational.Round4.IntegerParameters.fits
    JuliaLean.Proofs.base.rational.Round4.IntegerParameters.ops
    JuliaLean.base.rational.jintOps JuliaLean.Proofs.base.rational.Round4.reduced at hc
  dsimp only [JuliaLean.Proofs.base.rational.Round4.val, JuliaLean.Proofs.base.rational.Round4.rn,
    JuliaLean.Proofs.base.rational.Round4.rd] at hc
  rw [hnJ_v, hdJ_v] at hc
  refine ⟨fun hnz => ?_, fun hn0 hd0 => ?_⟩
  · have hg_nz : Nat.gcd n.natAbs d.natAbs ≠ 0 := by
      intro hg0
      have ⟨h1, h2⟩ := Nat.gcd_eq_zero_iff.mp hg0
      rcases hnz with hn | hd
      · exact hn (by omega)
      · exact hd (by omega)
    let g : Int := Nat.gcd n.natAbs d.natAbs
    have hg_pos : 0 < g := Int.natCast_pos.mpr (Nat.pos_of_ne_zero hg_nz)
    have hn_nn : 0 ≤ n := by rw [← hnJ_v]; exact nonneg_of_unsigned hu nJ
    have hd_nn : 0 ≤ d := by rw [← hdJ_v]; exact nonneg_of_unsigned hu dJ
    have hnot_negU : ¬ ((!t.signed) = true ∧ n ≠ 0 ∧ ((n < 0) ≠ (d < 0))) := by
      rintro ⟨_, _, hne⟩
      exact hne (propext ⟨fun h => absurd h (Int.not_lt.mpr hn_nn), fun h => absurd h (Int.not_lt.mpr hd_nn)⟩)
    have hr1_fit : t.min ≤ ((n.tdiv g).natAbs : Int) ∧ ((n.tdiv g).natAbs : Int) ≤ t.max := by
      have h1 := fits_between nJ (tdiv_between nJ.val g hg_pos)
      have h2 : 0 ≤ n.tdiv g := (tdiv_between n g hg_pos).1 hn_nn |>.1
      rw [hnJ_v] at h1
      rw [Int.natAbs_of_nonneg h2]
      exact h1
    have hr2_fit : t.min ≤ ((d.tdiv g).natAbs : Int) ∧ ((d.tdiv g).natAbs : Int) ≤ t.max := by
      have h1 := fits_between dJ (tdiv_between dJ.val g hg_pos)
      have h2 : 0 ≤ d.tdiv g := (tdiv_between d g hg_pos).1 hd_nn |>.1
      rw [hdJ_v] at h1
      rw [Int.natAbs_of_nonneg h2]
      exact h1
    have hconv : (t.min ≤ (if !t.signed then ((n.tdiv g).natAbs : Int) else n.tdiv g) ∧
        (if !t.signed then ((n.tdiv g).natAbs : Int) else n.tdiv g) ≤ t.max) ∧
        (t.min ≤ (if !t.signed then ((d.tdiv g).natAbs : Int) else d.tdiv g) ∧
        (if !t.signed then ((d.tdiv g).natAbs : Int) else d.tdiv g) ≤ t.max) := by
      simp only [hu, Bool.not_false, ↓reduceIte]
      exact ⟨hr1_fit, hr2_fit⟩
    obtain ⟨q, hq_ok, hq_norm, hq_cross, hq_den_pos, _⟩ :=
      (hc.2.2.2 hg_nz hnot_negU hconv).1 (fun hlt => absurd hlt (Int.not_lt.mpr (by
        rw [if_pos (by simp [hu])]; exact Int.natCast_nonneg _)))
    unfold exactDivideIntsSource
    rw [hrat, hq_ok]
    exact ⟨q, io2, rfl, hq_norm, hq_cross, hq_den_pos, hptr2_eq, hdata2_eq⟩
  · have hg0 : Nat.gcd n.natAbs d.natAbs = 0 := by
      rw [hn0, hd0, Int.natAbs_zero, Nat.gcd_zero_left]
    obtain ⟨msg, herr⟩ := hc.1 hg0
    unfold exactDivideIntsSource
    rw [hrat, herr]
    exact ⟨io2, msg, rfl, hptr2_eq⟩

end JuliaLean.Proofs.base.rational.Round6

