private theorem floatLtZero_of_ratio_lt_zero {F : JuliaLean.base.float.FTy}
    (x : JuliaLean.base.float.FV F) (h : x.toRat.1 < 0) :
    JuliaLean.base.float.lt_IEEEFloat x (JuliaLean.base.float.zero_float F) = true := by
  by_cases hfinite : x.isfinite = true
  · have hnan : x.isnan = false := Fl.isnan_of_finite hfinite
    have hz := Fl.zero_spec (good_fty F) false
    have hnanZero : (Fl.zero false : JuliaLean.base.float.FV F).isnan = false := Fl.isnan_of_finite hz.1
    have hdNat := (Fl.toRat_key (good_fty F) x hfinite).1
    have hd : (0 : Int) < (x.toRat.2 : Int) := by exact_mod_cast hdNat
    have hDen : (0 : Int) < F.fmt.den := by exact_mod_cast F.fmt.den_pos
    have hscale := (Fl.toRat_key (good_fty F) x hfinite).2
    have hnum : x.toRat.1 * (F.fmt.den : Int) < 0 := Int.mul_neg_of_neg_of_pos h hDen
    have hkey : x.key < 0 := by
      by_cases hkeyNeg : x.key < 0
      · exact hkeyNeg
      · have hkeyNonneg : 0 ≤ x.key := by omega
        have hprod : 0 ≤ x.key * (x.toRat.2 : Int) := Int.mul_nonneg hkeyNonneg (by omega)
        rw [← hscale] at hprod
        omega
    unfold JuliaLean.base.float.zero_float
    rw [lt_IEEEFloat_eq, Fl.lt_key hnan hnanZero, hz.2]
    exact decide_eq_true hkey
  · have hnotfinite : x.isfinite = false := Bool.eq_false_iff.mpr hfinite
    simp [Fl.toRat, hnotfinite] at h

private theorem floatLtZero_of_negative_infinity {F : JuliaLean.base.float.FTy}
    (x : JuliaLean.base.float.FV F) (hinf : x.isinf = true) (hsign : x.signbit = true) :
    JuliaLean.base.float.lt_IEEEFloat x (JuliaLean.base.float.zero_float F) = true := by
  have hnan : x.isnan = false := by
    unfold Fl.isinf at hinf
    simp only [Bool.and_eq_true, beq_iff_eq] at hinf
    simp [Fl.isnan, hinf.1, hinf.2]
  have hz := Fl.zero_spec (good_fty F) false
  have hnanZero : (Fl.zero false : JuliaLean.base.float.FV F).isnan = false := Fl.isnan_of_finite hz.1
  have hkey := Fl.inf_key_eq (good_fty F) x hinf
  have hpos : (0 : Int) <
      ((2 ^ F.fmt.sb * 2 ^ (F.fmt.emax - 1) : Nat) : Int) := by
    exact_mod_cast Nat.mul_pos (Nat.two_pow_pos _) (Nat.two_pow_pos _)
  have hkeyNeg : x.key < 0 := by
    rw [hkey, if_pos hsign]
    omega
  unfold JuliaLean.base.float.zero_float
  rw [lt_IEEEFloat_eq, Fl.lt_key hnan hnanZero, hz.2]
  exact decide_eq_true hkeyNeg

private theorem floatLtZero_of_ratio_nonnegative {F : JuliaLean.base.float.FTy}
    (x : JuliaLean.base.float.FV F) (hnum : 0 ≤ x.toRat.1)
    (hnotNegInf : ¬ (x.isinf = true ∧ x.signbit = true)) :
    JuliaLean.base.float.lt_IEEEFloat x (JuliaLean.base.float.zero_float F) = false := by
  have hz := Fl.zero_spec (good_fty F) false
  have hnanZero : (Fl.zero false : JuliaLean.base.float.FV F).isnan = false := Fl.isnan_of_finite hz.1
  by_cases hnanTrue : x.isnan = true
  · rw [lt_IEEEFloat_eq]
    simp [Fl.lt, hnanTrue]
  · have hnan : x.isnan = false := Bool.eq_false_iff.mpr hnanTrue
    by_cases hfinite : x.isfinite = true
    · have hdNat := (Fl.toRat_key (good_fty F) x hfinite).1
      have hd : (0 : Int) < (x.toRat.2 : Int) := by exact_mod_cast hdNat
      have hDen : (0 : Int) < F.fmt.den := by exact_mod_cast F.fmt.den_pos
