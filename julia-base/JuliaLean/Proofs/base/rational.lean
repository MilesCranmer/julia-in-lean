def g2SignedUnsignedRoundedFormula : Prop :=
  ∀ (s u : IntTy), s.signed = true → u.signed = false →
    ∀ (x : JInt s) (y : JInt u) (mode : Rounding),
      JuliaLean.base.div.mixedDivSignedUnsigned x y (sourceRoundingMode mode) =
        if y.val = 0 then .error .divideError
        else .ok (JInt.wrap (s.toUnsigned.promote u).toSigned
          (rounded x.val y.val mode))

def g2UnsignedSignedRoundedFormula : Prop :=
  ∀ (u s : IntTy), u.signed = false → s.signed = true →
    ∀ (x : JInt u) (y : JInt s) (mode : Rounding),
      JuliaLean.base.div.mixedDivUnsignedSigned x y (sourceRoundingMode mode) =
        if y.val = 0 then .error .divideError
        else .ok (JInt.wrap (u.promote s.toUnsigned).toSigned.toUnsigned
          (rounded x.val y.val mode))

theorem g2MixedOutcomesOfFormula {s u result : IntTy}
    (x : JInt s) (y : JInt u) (mode : Rounding)
    (run : Jl (JInt result)) (hdiff : s.signed ≠ u.signed)
    (hrun : run = if y.val = 0 then .error .divideError
      else .ok (JInt.wrap result (rounded x.val y.val mode)))
    (hrel : ∀ q, y.val ≠ 0 →
      (RoundedValue x.val y.val mode q ↔ q = rounded x.val y.val mode)) :
    RoundedOutcome run x.val y.val mode ∧
    RoundedNativeFinalOutcome s u run x.val y.val mode := by
  have hover : ¬ RoundedSignedQuotientOverflow s u result x.val y.val := by
    intro h
    exact hdiff (h.1.trans h.2.1.symm)
  constructor
  · constructor
    · intro hy
      rw [hrun, ite_eq_left hy]
    · intro hy
      have hsuccess : run = .ok (JInt.wrap result (rounded x.val y.val mode)) := by
        rw [hrun, ite_eq_right hy]
      refine ⟨?_, ?_, ?_⟩
      · intro q hq hfit
        have hqeq := (hrel q hy).mp hq
        refine ⟨JInt.wrap result (rounded x.val y.val mode), hsuccess, ?_⟩
        change wrapInt result (rounded x.val y.val mode) = q
        rw [← hqeq]
        exact wrapInt_of_inRange result q hfit
      · intro out hout
        have heq : out = JInt.wrap result (rounded x.val y.val mode) :=
          Except.ok.inj (hout.symm.trans hsuccess)
        exact ⟨rounded x.val y.val mode, (hrel _ hy).mpr rfl,
          congrArg (fun z : JInt result => z.val) heq⟩
      · intro e he
        rw [hsuccess] at he
        cases he
  · refine ⟨x.property, y.property, ?_, ?_⟩
    · intro hbad
      rcases hbad with hy | hbad
      · rw [hrun, ite_eq_left hy]
      · exact False.elim (hover hbad)
    · intro hy _
      refine ⟨rounded x.val y.val mode,
        JInt.wrap result (rounded x.val y.val mode), (hrel _ hy).mpr rfl, ?_, rfl⟩
      rw [hrun, ite_eq_right hy]

theorem g2PromoteSameSign {t s : IntTy} (hs : t.signed = s.signed) :
    (t.promote s).signed = t.signed := by
  cases t <;> cases s <;> first | rfl | contradiction

theorem g2MixedSameSignOutcomes {t s : IntTy} (x : JInt t) (y : JInt s)
    (mode : Rounding) (hs : t.signed = s.signed)
    (hRel : ∀ (a b q : Int) (mode : Rounding), b ≠ 0 →
      (RoundedValue a b mode q ↔ q = rounded a b mode)) :
    RoundedOutcome (JuliaLean.base.div.mixedDivRoundSameSign x y (sourceRoundingMode mode))
      x.val y.val mode ∧
    RoundedNativeFinalOutcome t s
      (JuliaLean.base.div.mixedDivRoundSameSign x y (sourceRoundingMode mode))
      x.val y.val mode := by
  let a := JuliaLean.base.int.widenTo (t.promote s) x
  let b := JuliaLean.base.int.widenTo (t.promote s) y
  have ha : a.val = x.val := by
    rw [show a.val = wrapInt (t.promote s) x.val from rfl,
      widen_promote_left hs]
  have hb : b.val = y.val := by
    rw [show b.val = wrapInt (t.promote s) y.val from rfl,
      widen_promote_right hs]
  have hout := g2SameTypeOutcomes a b mode (fun q hnonzero => hRel _ _ q mode hnonzero)
  change RoundedOutcome (JuliaLean.base.div.mixedDivRoundSameSign x y (sourceRoundingMode mode))
      a.val b.val mode ∧
    RoundedNativeFinalOutcome (t.promote s) (t.promote s)
      (JuliaLean.base.div.mixedDivRoundSameSign x y (sourceRoundingMode mode))
      a.val b.val mode at hout
