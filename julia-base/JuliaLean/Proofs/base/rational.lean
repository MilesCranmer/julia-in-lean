Its result may have any type R. Source: base/rational.jl:27. -/
def observeCheckedDenSameCall {World T R : Type}
    (ops : CheckedDenSameOps (EStateM ArrayError World) T R) :
    CheckedDenSameOps
      (EStateM ArrayError
        (World × Nat × Option (Except ArrayError R) × Option World)) T R where
  checkedTyped num den := fun (world, calls, _, _) =>
    match ops.checkedTyped num den world with
    | .ok result after =>
        .ok result (after, calls + 1, some (.ok result), some after)
    | .error error after =>
        .error error (after, calls + 1, some (.error error), some after)

/-- The same-type wrapper invokes its selected typed overload once, and
its outcome and final world are precisely the recorded selected-call
