/-- Binary reads propagate either word-read failure unchanged, and successful rational parsing
preserves the parsed exact ratio. -/
def rationalSplitActual {S R CU CT : Type}
    (prim : JuliaLean.base.strings.basic.StringOps S R UInt32 CU CT JlError)
    (errs : JuliaLean.Proofs.base.strings.util.Round6.ViewErrors S JlError)
    (layout : JuliaLean.base.array.MemoryLayoutMetadata)
    (liftA : JuliaLean.base.array.Error → JlError)
    (str : S) (separator : UInt32) (limit : Nat) :
    JuliaLean.base.strings.util.SplitM S JlError
      (List (JuliaLean.base.strings.substring.SubString S)) := do
  let splitter := JuliaLean.base.operators.fixIsequal
    (fun (a b : UInt32) => Except.ok (prim.equalChar a b)) separator
  let handle ← JuliaLean.base.strings.util.splitGeneric
    (fun (_ : Nat) => true) (fun (n : Nat) => Except.ok (JInt.lit .i64 (n : Int)))
    prim.methodError layout liftA
    (JuliaLean.Proofs.base.strings.util.Round6.splitOps prim errs)
    (fun (splitter : JuliaLean.base.operators.Fix 2
      (UInt32 → UInt32 → Unit → Except JlError Bool) UInt32
      JuliaLean.base.operators.Fix2OpTag.isequal separator) (s : S)
      (k : JuliaLean.base.strings.basic.Index) =>
      JuliaLean.Proofs.base.strings.util.Round6.predFindnextE prim
        (fun c => splitter.f c splitter.x ()) s k)
    str splitter limit false
  let mem ← get
  pure (JuliaLean.base.array.MutableMemory.contents mem handle |>.filterMap id)

def startsWithRationalChar {S R CU CT : Type}
    (prim : JuliaLean.base.strings.basic.StringOps S R UInt32 CU CT JlError)
    (errs : JuliaLean.Proofs.base.strings.util.Round6.ViewErrors S JlError)
    (text : JuliaLean.base.strings.substring.SubString S) (ch : UInt32) :
    Except JlError Bool :=
  let subPrim := JuliaLean.Proofs.base.strings.util.Round6.gSubPrim prim errs
  let fullSub := JuliaLean.Proofs.base.strings.util.Round6.gFull subPrim
  JuliaLean.base.strings.util.startswithChars
    (fun s => .ok (JuliaLean.base.strings.basic.isemptyString fullSub s))
    (JuliaLean.base.strings.basic.firstString
      (JuliaLean.base.strings.basic.getindexString fullSub))
    (fun c (_ : Unit) => .ok (prim.equalChar c ch)) text ()

def nestedViewErrors {S : Type}
    (errs : JuliaLean.Proofs.base.strings.util.Round6.ViewErrors S JlError) :
    JuliaLean.Proofs.base.strings.util.Round6.ViewErrors
      (JuliaLean.base.strings.substring.SubString S) JlError where
  rangeError := errs.viewRangeError
  viewRangeError v i j := errs.viewRangeError v.string i j
  viewBoundsError v i := errs.viewBoundsError v.string i
  viewIndexError v i := errs.viewIndexError v.string i

def chopRationalField {S R CU CT : Type}
    (prim : JuliaLean.base.strings.basic.StringOps S R UInt32 CU CT JlError)
    (errs : JuliaLean.Proofs.base.strings.util.Round6.ViewErrors S JlError)
    (text : JuliaLean.base.strings.substring.SubString S) (head tail : Nat) :
    Except JlError (JuliaLean.base.strings.substring.SubString
      (JuliaLean.base.strings.substring.SubString S)) :=
  let subPrim := JuliaLean.Proofs.base.strings.util.Round6.gSubPrim prim errs
  let fullSub := JuliaLean.Proofs.base.strings.util.Round6.gFull subPrim
  let parentOps := JuliaLean.Proofs.base.strings.util.Round6.gParent subPrim (nestedViewErrors errs)
  JuliaLean.base.strings.util.chop
    (fun s => .ok (JuliaLean.base.strings.basic.isemptyString fullSub s))
    (JuliaLean.base.strings.substring.subStringWhole parentOps)
    (fun s => .ok (JuliaLean.base.strings.basic.firstindexString s))
    fullSub.lastindex
    (fun s i n => fullSub.nextind s i (JInt.lit .i64 (n : Int)))
    (fun s i n => fullSub.prevind s i (JInt.lit .i64 (n : Int)))
    (JuliaLean.base.strings.substring.subStringInt parentOps)
    text head tail

def liftRationalParse {S α : Type}
    (result : Except JlError α) : JuliaLean.base.strings.util.SplitM S JlError α :=
  match result with
  | .ok value => pure value
  | .error err => throw err

def rationalParseActual {S R CU CT : Type} (t : IntTy)
    (prim : JuliaLean.base.strings.basic.StringOps S R UInt32 CU CT JlError)
    (errs : JuliaLean.Proofs.base.strings.util.Round6.ViewErrors S JlError)
    (layout : JuliaLean.base.array.MemoryLayoutMetadata)
    (liftA : JuliaLean.base.array.Error → JlError)
    (parseOriginal : IntTy → S → Except JlError (JInt t))
    (parseFragment : IntTy → JuliaLean.base.strings.substring.SubString S →
      Except JlError (JInt t))
    (parseChopped : IntTy → JuliaLean.base.strings.substring.SubString
      (JuliaLean.base.strings.substring.SubString S) → Except JlError (JInt t))
    (str : S) : JuliaLean.base.strings.util.SplitM S JlError (Rat t) :=
  let split := fun s ch limit =>
    rationalSplitActual prim errs layout liftA s (UInt32.ofNat ch.toNat) limit
  let length := fun xs => pure xs.length
  let isone := fun n => pure (decide (n = 1))
  let getOneBased := fun xs idx =>
    match xs[(idx.val - 1).toNat]? with
    | some x => pure x
    | none => throw (liftA .bounds)
  let startswith := fun text ch =>
    liftRationalParse (startsWithRationalChar prim errs text (UInt32.ofNat ch.toNat))
  let chop := fun text head tail => liftRationalParse (chopRationalField prim errs text head tail)
  let parseOriginal := fun target text => liftRationalParse (parseOriginal target text)
  let parseFragment := fun target text => liftRationalParse (parseFragment target text)
  let parseChopped := fun target text => liftRationalParse (parseChopped target text)
  let rationalSingle := fun n =>
    liftRationalParse (JuliaLean.base.rational.rationalIntAsSource (JInt t) (fun x => .ok x)
      (fun _ => JInt.lit t 1) n)
  let exactDivide := fun n d =>
    liftRationalParse (JuliaLean.base.rational.exactDivideIntsSource
      (JuliaLean.Proofs.base.rational.Round4.rational (.bits t)) n d)
  JuliaLean.base.rational.parseRationalSource split length isone getOneBased
    startswith chop parseOriginal parseFragment parseChopped rationalSingle exactDivide t str

def io_read_parse : Prop :=
  (∀ (t : IntTy) (ltoh : JInt t → JInt t) (io : JuliaLean.base.iobuffer.BufferState),
    let first := JuliaLean.Proofs.base.rational.Round6.readUnsignedWord t ltoh io
    let run := JuliaLean.Proofs.base.rational.Round6.readUnsignedRational t ltoh io
    (∀ e out, first = .error e out → run = .error e out) ∧
    (∀ n after e out,
      first = .ok n after →
      JuliaLean.Proofs.base.rational.Round6.readUnsignedWord t ltoh after = .error e out →
      run = .error e out)) ∧
  (∀ (t : IntTy) {S R CU CT : Type}
      (prim : JuliaLean.base.strings.basic.StringOps S R UInt32 CU CT JlError)
      (errs : JuliaLean.Proofs.base.strings.util.Round6.ViewErrors S JlError)
      (layout : JuliaLean.base.array.MemoryLayoutMetadata)
      (liftA : JuliaLean.base.array.Error → JlError)
      (parseOriginal : IntTy → S → Except JlError (JInt t))
      (parseFragment : IntTy → JuliaLean.base.strings.substring.SubString S →
        Except JlError (JInt t))
      (parseChopped : IntTy → JuliaLean.base.strings.substring.SubString
        (JuliaLean.base.strings.substring.SubString S) → Except JlError (JInt t))
      (str : S) (initial : JuliaLean.base.array.MutableMemory
        (JuliaLean.base.strings.substring.SubString S)),
    let split := rationalSplitActual prim errs layout liftA str (UInt32.ofNat 47) 2
    let run := rationalParseActual t prim errs layout liftA
      parseOriginal parseFragment parseChopped str
    (∀ ns denText splitState n denParsed chopped constructorResult,
      split.run initial = some (.ok [ns, denText], splitState) →
      parseFragment t ns = .ok n →
      ((startsWithRationalChar prim errs denText (UInt32.ofNat 47) = .ok false ∧
          parseFragment t denText = .ok denParsed) ∨
       (startsWithRationalChar prim errs denText (UInt32.ofNat 47) = .ok true ∧
          chopRationalField prim errs denText 1 0 = .ok chopped ∧
          parseChopped t chopped = .ok denParsed)) →
      JuliaLean.base.rational.exactDivideIntsSource
        (JuliaLean.Proofs.base.rational.Round4.rational (.bits t)) n denParsed = .ok constructorResult →
      ∃ out, run.run initial = some (.ok constructorResult, out) ∧
        JuliaLean.Proofs.base.rational.Round4.Represents
          (IntegerParameters.bits t) constructorResult n.val denParsed.val) ∧
    (∀ only splitState n constructorResult,
      split.run initial = some (.ok [only], splitState) →
      parseOriginal t str = .ok n →
      JuliaLean.base.rational.rationalIntAsSource (JInt t) (fun x => .ok x)
        (fun _ => JInt.lit t 1) n = .ok constructorResult →
      ∃ out, run.run initial = some (.ok constructorResult, out) ∧
        JuliaLean.Proofs.base.rational.Round4.Represents
          (IntegerParameters.bits t) constructorResult n.val 1))

end JuliaLean.Statements.rational.Round16
namespace JuliaLean.Statements.rational.Round20

open JuliaLean JuliaLean.Promotion JuliaLean.base.rational
open JuliaLean.Proofs.base.rational.Round4
set_option maxRecDepth 4096

def HasError {T : Type} (run : Jl T) : Prop :=
  ∃ e, run = .error e

def FiniteOutcome {T : Type} (i : IntegerParameters T) (run : Jl (Rational T))
    (n d : Int) (converted safe : Prop) : Prop :=
  (¬ converted → HasError run) ∧
  (converted → safe → ExactResult i run n d) ∧
  (converted → ¬ safe → HasError run)

def ScalarOutcome {P : Type} (p : IntegerParameters P) (run : Jl (Rational P))
    (num den k prod result : Int) : Prop :=
  (¬ (p.fits den ∧ p.fits k) → HasError run) ∧
  (p.fits den → p.fits k → ¬ p.fits prod → HasError run) ∧
  (p.fits den → p.fits k → p.fits prod → ¬ p.fits num → HasError run) ∧
  (p.fits den → p.fits k → p.fits prod → p.fits num → ¬ p.fits result → HasError run) ∧
  (p.fits den → p.fits k → p.fits prod → p.fits num → p.fits result →
    ExactResult p run result den)

def scalarAddNative {t s : IntTy} (x : Rat t) (k : JInt s) : Jl (Rat (t.promote s)) :=
  JuliaLean.base.rational.rationalIntegerOpSource
    (JuliaLean.Proofs.base.rational.Round6.nativePromotion t s)
    (fun a b => JuliaLean.Proofs.base.rational.Round6.castInteger
      (JuliaLean.Proofs.base.rational.Round6.promote_absorption_proven t s).1
      (JuliaLean.base.checked.checkedAddMixedBits a b)) x k

def scalarSubNative {t s : IntTy} (x : Rat t) (k : JInt s) : Jl (Rat (t.promote s)) :=
  JuliaLean.base.rational.rationalIntegerOpSource
    (JuliaLean.Proofs.base.rational.Round6.nativePromotion t s)
    (fun a b => JuliaLean.Proofs.base.rational.Round6.castInteger
      (JuliaLean.Proofs.base.rational.Round6.promote_absorption_proven t s).1
      (JuliaLean.base.checked.checkedSubMixedBits a b)) x k

/-- A negative divisor negates the numerator when the rational denominator is zero. -/
def scalar_arithmetic : Prop :=
  ∀ (t s : IntTy) (x : Rat t) (k : JInt s) (hx : Canonical (IntegerParameters.bits t) x),
    let i := IntegerParameters.bits t
    let j := IntegerParameters.bits s
    let p := IntegerParameters.bits (t.promote s)
    let prom := JuliaLean.Proofs.base.rational.Round6.nativePromotion t s
    let cv := p.fits (rn i x) ∧ p.fits (rd i x) ∧ p.fits (val j k)
    let prod := rd i x * val j k
    let ga : Int := Nat.gcd (rd i x).natAbs (val j k).natAbs
    let gn : Int := Nat.gcd (rn i x).natAbs (val j k).natAbs
    let mn := rn i x * (val j k).tdiv ga
    let md := (rd i x).tdiv ga
    let dn := (rn i x).tdiv gn
    let dd := rd i x * (val j k).tdiv gn
    let divNum := if decide (rd i x = 0 ∧ val j k < 0) then -rn i x else rn i x
    (ScalarOutcome p (scalarAddNative (t := t) (s := s) x k) (rn i x) (rd i x) (val j k) prod
      (rn i x + prod) ∧
     ScalarOutcome p (scalarSubNative (t := t) (s := s) x k) (rn i x) (rd i x) (val j k) prod
      (rn i x - prod)) ∧
    (¬ cv → HasError (mulRatIntSource prom (dg p p) x k) ∧
      HasError (divRatIntSource prom (dg p p) x k)) ∧
    (cv → ga = 0 → HasError (mulRatIntSource prom (dg p p) x k)) ∧
    (cv → ga ≠ 0 → FiniteOutcome p (mulRatIntSource prom (dg p p) x k)
      (rn i x * val j k) (rd i x) True (FitsPair p mn md)) ∧
    (cv → gn = 0 → HasError (divRatIntSource prom (dg p p) x k)) ∧
    (cv → gn ≠ 0 →
      ((p.fits dd ∧ (dd < 0 → FitsPair p (-dn) (-dd)) ∧
          (rd i x = 0 ∧ val j k < 0 → p.fits (-dn))) →
        ExactResult p (divRatIntSource prom (dg p p) x k)
          divNum (rd i x * val j k)) ∧
      (¬ (p.fits dd ∧ (dd < 0 → FitsPair p (-dn) (-dd)) ∧
          (rd i x = 0 ∧ val j k < 0 → p.fits (-dn))) →
        HasError (divRatIntSource prom (dg p p) x k)))

def mixed_arithmetic : Prop :=
  scalar_arithmetic ∧ JuliaLean.Statements.rational.Round11.integer_left

end JuliaLean.Statements.rational.Round20

