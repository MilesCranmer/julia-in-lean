    widemulBitIntI64 x y = .ok (JInt.wrap .i128 (x.val * y.val)) ∧
    widemulI64BitInt y x = .ok (JInt.wrap .i128 (y.val * x.val)) := by
  have hwx := rationalWidenFits hw x
  have hix := rationalFits128 ht x
  have hiy := rationalI64Fits128 y
  have hprod := rationalProductFits128 ht x y
  have hp := rationalSignedPromote128 hs hw
  have hcX : JInt.convert w.name w x.val = .ok (widenTo w x) := rationalConvertWrap _ _ _ hwx
  have hcY : JInt.convert IntTy.i128.name .i128 y.val = .ok (widenTo .i128 y) :=
    rationalConvertWrap _ _ _ hiy
  have hleft : (binop mulSame (widenTo w x) (widenTo .i128 y)).val = x.val * y.val := by
    rw [binop_eq, mulSame_val, remT_val, remT_val, widenTo_val, widenTo_val, hp.1,
      wrapInt_of_inRange w x.val hwx, wrapInt_of_inRange .i128 y.val hiy,
      wrapInt_of_inRange .i128 x.val hix, wrapInt_of_inRange .i128 y.val hiy,
