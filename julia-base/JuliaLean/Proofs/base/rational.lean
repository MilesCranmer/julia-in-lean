  intro run
  have hnorm : Normalized x := hx
  have h0_val : (JInt.lit t 0).val = 0 := by cases t <;> decide
  have h1_val : (JInt.lit t 1).val = 1 := by cases t <;> decide
  have heq0 : eqRatIntSource (jintOps t).isone (jintOps t).eq x (jintOps t).zero =
      decide (x.num.val = 0) := by
    unfold eqRatIntSource eqRatIntMethod bwand jintOps Bind.bind Id.instMonad
    dsimp only
    rw [h0_val]
    by_cases hn0 : x.num.val = 0
    · have hd1 : x.den.val = 1 := (normalized_extremes_full hnorm).1 hn0
      simp [hn0, hd1]
    · simp [hn0]
  have heq1 : eqRatIntSource (jintOps t).isone (jintOps t).eq x (jintOps t).one =
      decide (x.num.val = x.den.val) := by
    unfold eqRatIntSource eqRatIntMethod bwand jintOps Bind.bind Id.instMonad
    dsimp only
    rw [h1_val]
    by_cases hnd : x.num.val = x.den.val
    · have hd1 : x.den.val = 1 := by
        have hg := hnorm.2
        rw [hnd, Nat.gcd_self] at hg
        have := hnorm.1
        omega
      simp [hnd, hd1]
    · by_cases hd1 : x.den.val = 1
      · have hn1 : x.num.val ≠ 1 := by omega
        simp [hd1, hn1, hnd]
      · simp [hd1, hnd]
