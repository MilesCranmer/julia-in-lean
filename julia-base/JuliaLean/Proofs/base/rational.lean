  have hpo := g2PromoteSameSign hs
  have hov : RoundedSignedQuotientOverflow t s (t.promote s) x.val y.val ↔
      RoundedSignedQuotientOverflow (t.promote s) (t.promote s) (t.promote s)
        x.val y.val := by
    simp only [RoundedSignedQuotientOverflow, hpo, hs]
  refine ⟨hout.1, x.property, y.property, ?_, ?_⟩
  · intro hbad
    exact hout.2.2.2.1 (hbad.imp_right hov.mp)
  · intro hy hbad
    exact hout.2.2.2.2 hy (fun h => hbad (hov.mpr h))


theorem g2SameSignDispatchOutcomes
    (hRel : ∀ (a b q : Int) (mode : Rounding), b ≠ 0 →
