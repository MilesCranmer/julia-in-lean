theorem rationalize_infinity_proven : rationalize_infinity := by
  intro T F Tol i f tf showTol x tol ht hn hx hu hm
  cases i with
  | bits t =>
    cases f with
    | ieee ft ops =>
      cases tf with
      | ieee tfmt tops =>
        have htol : 0 ≤ tol.toRat.1 ∧ ¬ (tol.isinf = true ∧ tol.signbit = true) := by
          simpa [FloatParameters.ratio, FloatParameters.isinf, FloatParameters.signbit,
            isinf_IEEEFloat_eq, signbit_float_eq] using ht
        have htolNegative : FloatParameters.negative (.ieee tfmt tops) tol = false := by
          simpa [FloatParameters.negative] using
            floatLtZero_of_ratio_nonnegative tol htol.1 htol.2
        have hnan : x.isnan = false := by
          simpa [FloatParameters.isnan, isnan_IEEEFloat_eq] using hn
        have hinf : x.isinf = true := by
          simpa [FloatParameters.isinf, isinf_IEEEFloat_eq] using hx
        have htolLess : JuliaLean.base.float.lt_IEEEFloat tol
            (JuliaLean.base.float.zero_float tfmt) = false := by
          simpa [FloatParameters.negative] using htolNegative
        by_cases hnegative : FloatParameters.negative (.ieee ft ops) x = true
        · have hnegativeLess : JuliaLean.base.float.lt_IEEEFloat x
              (JuliaLean.base.float.zero_float ft) = true := by
            simpa [FloatParameters.negative] using hnegative
          let q : Rat t := unsafeRationalSameSource (jintOps t).minusOne (jintOps t).zero
          have hzero : val (.bits t) (jintOps t).zero = 0 := by
            change wrapInt t 0 = 0
            apply wrapInt_of_inRange
            cases t <;> decide
          have hminus : val (.bits t) (jintOps t).minusOne = -1 := by
            simpa [val, IntegerParameters.ops] using hm hnegative
          have hunsignedFalseJ : (jintOps t).isUnsignedOrBool = false := by
            cases hunsigned : (jintOps t).isUnsignedOrBool with
            | false => rfl
            | true =>
              have hnegativeFalse : FloatParameters.negative (.ieee ft ops) x = false :=
                hu (by simpa [IntegerParameters.ops] using hunsigned)
              rw [hnegative] at hnegativeFalse
              cases hnegativeFalse
          have htSigned : t.signed = true := by
            cases ht : t.signed with
            | false =>
              have hunsigned : (jintOps t).isUnsignedOrBool = true := by
                simp [jintOps, ht]
              rw [hunsigned] at hunsignedFalseJ
              cases hunsignedFalseJ
            | true => rfl
          have hrun : approx (.bits t) (.ieee ft ops) (.ieee tfmt tops) showTol x tol =
              some (.ok q) := by
            unfold approx
            dsimp only [IntegerParameters.ops]
            simp [rationalizeAbstractFloatSource, htolLess, htSigned,
              hnegativeLess, hnan, hinf, q, FloatParameters.negative,
              FloatParameters.isnan, FloatParameters.isinf, isinf_IEEEFloat_eq,
              isnan_IEEEFloat_eq, jintOps, Bind.bind, ExceptT.bind, ExceptT.pure,
              ExceptT.mk, ExceptT.bindCont, Option.bind, Pure.pure, Except.pure,
              Except.bind]
          have hrd : rd (.bits t) q = 0 := by
            change val (.bits t) (jintOps t).zero = 0
            exact hzero
          have hrn : rn (.bits t) q = -1 := by
            change val (.bits t) (jintOps t).minusOne = -1
            exact hminus
          have hcan : Canonical (.bits t) q := by
            unfold Canonical
            rw [hrd, hrn]
            simp
          refine ⟨q, hrun, hcan, hrd, ?_⟩
          simpa [hnegative] using hrn
        · have hnegativeFalse : FloatParameters.negative (.ieee ft ops) x = false :=
            Bool.eq_false_iff.mpr hnegative
          have hnegativeLess : JuliaLean.base.float.lt_IEEEFloat x
              (JuliaLean.base.float.zero_float ft) = false := by
            simpa [FloatParameters.negative] using hnegativeFalse
          let q : Rat t := unsafeRationalSameSource (jintOps t).one (jintOps t).zero
          have hzero : val (.bits t) (jintOps t).zero = 0 := by
            change wrapInt t 0 = 0
            apply wrapInt_of_inRange
            cases t <;> decide
          have hone : val (.bits t) (jintOps t).one = 1 := by
            change wrapInt t 1 = 1
            apply wrapInt_of_inRange
            cases t <;> decide
          have hrun : approx (.bits t) (.ieee ft ops) (.ieee tfmt tops) showTol x tol =
              some (.ok q) := by
            unfold approx
            dsimp only [IntegerParameters.ops]
            simp [rationalizeAbstractFloatSource, htolLess, hnegativeLess,
              hnan, hinf, q, FloatParameters.negative, FloatParameters.isnan,
              FloatParameters.isinf, isinf_IEEEFloat_eq, isnan_IEEEFloat_eq,
              jintOps, Bind.bind, ExceptT.bind, ExceptT.pure, ExceptT.mk,
              ExceptT.bindCont, Option.bind, Pure.pure, Except.pure, Except.bind]
          have hrd : rd (.bits t) q = 0 := by
            change val (.bits t) (jintOps t).zero = 0
            exact hzero
          have hrn : rn (.bits t) q = 1 := by
            change val (.bits t) (jintOps t).one = 1
            exact hone
          have hcan : Canonical (.bits t) q := by
            unfold Canonical
            rw [hrd, hrn]
            simp
          refine ⟨q, hrun, hcan, hrd, ?_⟩
          simpa [hnegativeFalse] using hrn

