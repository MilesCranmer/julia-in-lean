def CheckedDenOriginalConstructorFailure : Prop :=
  ∀ (World T Neg NotBool R : Type)
    (ops : CheckedDenOps (EStateM ArrayError World) T Neg NotBool R)
    (num den : T) (initial afterSign afterConstruct : World)
    (error : ArrayError),
    ops.signbit den initial = .ok (.accepted false) afterSign →
    ops.unsafeOriginal num den afterSign = .error error afterConstruct →
    checkedDenTyped ops num den initial = .error error afterConstruct

