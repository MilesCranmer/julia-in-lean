def observeCheckedDenCalls {World T Neg NotBool R : Type}
    (ops : CheckedDenOps (EStateM ArrayError World) T Neg NotBool R) :
    CheckedDenOps (EStateM ArrayError (World × List CheckedDenEvent))
      T Neg NotBool R where
  signbit value := fun (world, calls) =>
    match ops.signbit value world with
    | .ok result after => .ok result (after, calls ++ [.signbit])
    | .error error after => .error error (after, calls ++ [.signbit])
  checkedNeg value := fun (world, calls) =>
    match ops.checkedNeg value world with
    | .ok result after => .ok result (after, calls ++ [.negation])
    | .error error after => .error error (after, calls ++ [.negation])
  unsafeOriginal num den := fun (world, calls) =>
    match ops.unsafeOriginal num den world with
    | .ok result after => .ok result (after, calls ++ [.originalConstructor])
    | .error error after => .error error (after, calls ++ [.originalConstructor])
