  · have hx_neg : a < 0 := by omega
    have hy_pos : 0 < b := by omega
    have hr_b := hr_neg hx_neg
    have hy2_pos := hy2_b.2.1 hy_nn
    clear hy2_b hr_pos hr_neg
    have hdiff : (a < 0) ≠ (b < 0) := by
      simp [hx_neg, show ¬ b < 0 by omega]
    simp only [hx_nn, hy_nn, ↓reduceIte]
    by_cases hcond : a.tmod b ≤ -(b.tdiv 2) - JuliaLean.base.div.boolInt fNP
    · simp only [ite_eq_left hcond]
      by_cases hm2 : b.tmod 2 = 0
      · have hev := (heven_f hm2).2.2.1 hx_neg hy_nn
        clear hodd_f heven_f
