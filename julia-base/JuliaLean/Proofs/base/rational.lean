      pure (.accepted (← liftJulia (JuliaLean.base.int.convert ty raw.2))) }
  let returns : TupleReturnOps (Except ArrayError)
      (JInt tx) (JInt ty) (Sigma JInt) (Sigma JInt) Empty := {
    elements := elements
    selected := fun _ _ => .base
    custom := fun qx qy => do
      pure (.accepted (← convertReturnTupleBase elements qx qy)) }
  { uabsX := fun value => pure (JuliaLean.base.float.uabs value)
    uabsY := fun value => pure (JuliaLean.base.float.uabs value)
    gcd := fun ux uy => liftJulia (JuliaLean.base.intfuncs.gcdMixedBits ux uy)
    divX := fun value g => do
      let quotient ← liftJulia
        (JuliaLean.base.div.divBitIntegerMixedMode value g .ToZero)
      pure (nativeDivgcdMembership tx
        (JuliaLean.base.div.divMixedResultTy tx
          (tx.toUnsigned.promote ty.toUnsigned)) quotient)
    divY := fun value g => do
      let quotient ← liftJulia
        (JuliaLean.base.div.divBitIntegerMixedMode value g .ToZero)
      pure (nativeDivgcdMembership ty
        (JuliaLean.base.div.divMixedResultTy ty
          (tx.toUnsigned.promote ty.toUnsigned)) quotient)
    returnOps := returns }

/-- Over every ordered native type pair and all native values, divgcd
returns components of the original respective types whose magnitudes are
coprime, whose signs match the original components, and whose cross-product
ratio is unchanged. Neither magnitude grows. These independent conditions
specify the reduced pair without recomputing either input's gcd quotient.
The sole failing input is the zero pair, with DivideError; there is no
nonzero, fit, normalized-value or successful-run premise. Signed minimums,
unsigned maximums, mixed widths, and either single zero are included.

The native adapter calls the full generic model and its actual tuple
return-conversion helper with installed numerical callees. Mathematical
Int/Nat operations below belong only to the specification.
Documentation: base/rational.jl:53-62;
doc/src/manual/mathematical-operations.md:624. -/
def DivgcdNativeReduction : Prop :=
  ∀ (tx ty : IntTy) (x : JInt tx) (y : JInt ty),
    match divgcd (nativeDivgcdOps tx ty) x y with
    | .ok result =>
        (x.val ≠ 0 ∨ y.val ≠ 0) ∧
        Nat.gcd result.1.val.natAbs result.2.val.natAbs = 1 ∧
        Int.sign result.1.val = Int.sign x.val ∧
        Int.sign result.2.val = Int.sign y.val ∧
        result.1.val * y.val = x.val * result.2.val ∧
        result.1.val.natAbs ≤ x.val.natAbs ∧
        result.2.val.natAbs ≤ y.val.natAbs
    | .error error =>
        x.val = 0 ∧ y.val = 0 ∧ error = .julia .divideError

end JuliaLean.Proofs.base.rational.Models2Group10

