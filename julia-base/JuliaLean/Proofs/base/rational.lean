  wrapInt_of_inRange .i64 z ⟨h1, h2⟩

private theorem r81CttzIntVal {t : IntTy} (x : JInt t) :
    (JuliaLean.base.int.cttz_int x).val =
      (JuliaLean.base.int.trailing_zeros x).val := by
  unfold JuliaLean.base.int.trailing_zeros
  rw [JuliaLean.Proofs.base.int.remT_val]
  unfold JuliaLean.base.int.cttz_int JuliaLean.C.jlCttzInt
  have hle :
      ((List.range t.bits).find?
        (fun i => (JuliaLean.C.fromJInt x).toNat / 2 ^ i % 2 == 1)).getD t.bits ≤ t.bits := by
    cases hc : (List.range t.bits).find?
        (fun i => (JuliaLean.C.fromJInt x).toNat / 2 ^ i % 2 == 1) with
    | none => simp
    | some i =>
      simp only [Option.getD_some]
      exact Nat.le_of_lt (List.mem_range.mp (List.mem_of_find?_eq_some hc))
  rw [r81SmallToJIntVal _ hle]
  have hbits : t.bits ≤ 128 := by cases t <;> decide
  exact (r81LitI64ValOfBounds _ (by omega) (by omega)).symm

