/-- The documented quotient pair after cancellation by the positive gcd.
Both zero arguments raise DivideError. No success or fit premise is imposed.
Julia documentation: base/rational.jl:52-62. -/
def DivgcdNativeCorrect : Prop :=
  ∀ (t s : IntTy) (x : JInt t) (y : JInt s),
    let g : Int := Nat.gcd x.val.natAbs y.val.natAbs
    if g = 0 then divgcdMixed x y = .error .divideError
    else ∃ a b, divgcdMixed x y = .ok (a, b) ∧
      a.val * g = x.val ∧ b.val * g = y.val ∧
      Nat.gcd a.val.natAbs b.val.natAbs = 1

/-- Mathematical representability in a component type; this helper is used
only by specifications and does not implement machine arithmetic. -/
def Fits (t : IntTy) (n : Int) : Prop := t.min ≤ n ∧ n ≤ t.max

/-- An exact finite rational result is normalized and has the expected value.
The expected numerator/denominator are unreduced mathematical coordinates. -/
def RepresentsFinite {t : IntTy} (q : Rat t) (n d : Int) : Prop :=
  Normalized q ∧ 0 < q.den.val ∧ q.num.val * d = n * q.den.val

/-- These are machine-range obligations of the documented checked complex
operation, not an execution of its implementation. The final value below is
specified separately by the ordinary complex quotient identity. -/
def ComplexQuotientFits (p : IntTy) (a b c d : Int) : Prop :=
  let g : Int := Nat.gcd c.natAbs d.natAbs
  let cr := c.tdiv g
  let dr := d.tdiv g
  Fits p (c * cr) ∧ Fits p (d * dr) ∧ Fits p (c * cr + d * dr) ∧
  Fits p (a * cr) ∧ Fits p (b * dr) ∧ Fits p (a * cr + b * dr) ∧
  Fits p (b * cr) ∧ Fits p (a * dr) ∧ Fits p (-(a * dr)) ∧
  Fits p (b * cr - a * dr)

/-- Exact complex division for every native type pair, including promotion
failures, zero divisors and checked overflow. Source: base/rational.jl:64-91,
144-152; doc/src/manual/complex-and-rational-numbers.md:184-245.
No case is excluded by a successful-call or range precondition. -/
def ComplexIntegerDivisionCorrect : Prop :=
  ∀ (t s : IntTy) (x : JuliaLean.base.complex.Complex (JInt t))
    (y : JuliaLean.base.complex.Complex (JInt s)),
    let p := ((t.promote t).promote s).promote s
    let converted := Fits p x.re.val ∧ Fits p x.im.val ∧
      Fits p y.re.val ∧ Fits p y.im.val
    let zeroDivisor := y.re.val = 0 ∧ y.im.val = 0
    let safe := ComplexQuotientFits p x.re.val x.im.val y.re.val y.im.val
    let run := complexIntegerQuotient x y
    (¬converted → ∃ msg, run = .error (.inexactError msg)) ∧
    (converted → zeroDivisor → run = .error .divideError) ∧
    (converted → ¬zeroDivisor → safe →
      ∃ q, run = .ok q ∧
        RepresentsFinite q.re (x.re.val * y.re.val + x.im.val * y.im.val)
          (y.re.val ^ 2 + y.im.val ^ 2) ∧
        RepresentsFinite q.im (x.im.val * y.re.val - x.re.val * y.im.val)
          (y.re.val ^ 2 + y.im.val ^ 2)) ∧
    (converted → ¬zeroDivisor → ¬safe → ∃ msg, run = .error (.overflowError msg))

/-- Integer divided by a native complex value has the ordinary complex
quotient, with all failures included. Source: base/rational.jl:64-91,141-143.
This expected value does not call either complex division model. -/
def IntegerComplexDivisionCorrect : Prop :=
  ∀ (t s : IntTy) (x : JInt t) (y : JuliaLean.base.complex.Complex (JInt s)),
    let p := ((t.promote t).promote s).promote s
    let converted := Fits p x.val ∧ Fits p y.re.val ∧ Fits p y.im.val
    let zeroDivisor := y.re.val = 0 ∧ y.im.val = 0
    let safe := ComplexQuotientFits p x.val 0 y.re.val y.im.val
    let run := integerComplexQuotient x y
    (¬converted → ∃ msg, run = .error (.inexactError msg)) ∧
    (converted → zeroDivisor → run = .error .divideError) ∧
    (converted → ¬zeroDivisor → safe →
      ∃ q, run = .ok q ∧
        RepresentsFinite q.re (x.val * y.re.val) (y.re.val ^ 2 + y.im.val ^ 2) ∧
        RepresentsFinite q.im (-(x.val * y.im.val)) (y.re.val ^ 2 + y.im.val ^ 2)) ∧
    (converted → ¬zeroDivisor → ¬safe → ∃ msg, run = .error (.overflowError msg))

