private theorem positiveCountOnesOne_power (t : IntTy) (x : JInt t)
    (hx : x.val > 0)
    (hc : JuliaLean.base.int.count_ones x = JInt.lit .i64 1) :
    ∃ k : Nat, x.val = (2 : Int)^k := by
  have hct : (JuliaLean.base.int.ctpop_int x).val.toNat =
      JuliaLean.Proofs.base.int.onesCount x := by
    unfold JuliaLean.base.int.ctpop_int JuliaLean.C.jlCtpopInt
    rw [← JuliaLean.Proofs.base.int.pattern_fromJInt,
      JuliaLean.Proofs.base.int.foldl_count, Nat.zero_add]
    unfold JuliaLean.Proofs.base.int.onesCount
    have hbit :
        (fun k => JuliaLean.Proofs.base.int.bitOf x k) =
          (fun i => (JuliaLean.Proofs.base.int.pattern x).testBit i) := by
      funext i
      exact JuliaLean.Proofs.base.int.bitOf_eq x i
    rw [hbit, JuliaLean.Proofs.base.int.toJInt_ofNat_val]
    have hle : (List.range t.bits).countP
        (fun i => (JuliaLean.Proofs.base.int.pattern x).testBit i) ≤ t.bits :=
      Nat.le_trans List.countP_le_length (by simp)
    cases t <;> simp only [IntTy.bits] at hle ⊢ <;>
      simp [wrapInt, IntTy.min, IntTy.max, IntTy.signed, IntTy.bits] at * <;> omega
  have hcount : (JuliaLean.base.int.count_ones x).val = 1 := by
    have hv := congrArg (fun y : JInt .i64 => y.val) hc
    have h1 : (JInt.lit .i64 1).val = 1 := by decide
    rw [h1] at hv
    exact hv
  have honesInt : (JuliaLean.Proofs.base.int.onesCount x : Int) = 1 := by
    rw [← JuliaLean.Proofs.base.int.count_ones_val x]
    exact hcount
  have hones : JuliaLean.Proofs.base.int.onesCount x = 1 := by
    exact_mod_cast honesInt
  have hpop : (JuliaLean.base.int.ctpop_int x).val.toNat = 1 := by
    rw [hct, hones]
  have hpow : JuliaLean.base.intfuncs.ispow2Bits x = true := by
    unfold JuliaLean.base.intfuncs.ispow2Bits
      JuliaLean.base.intfuncs.ispow2_Integer
    simp [hx, hpop]
  exact (JuliaLean.Proofs.base.intfuncs.isPowerTwoExact_proven.1 t x).mp hpow

private theorem ldexpZeroFiniteNormal {T : JuliaLean.base.float.FTy}
    (o : JuliaLean.base.math.IEEEOps T) (x : JuliaLean.base.float.FV T)
    (hx : x.isfinite = true) (hz : x.magnitude ≠ 0) (hB : x.expField ≠ 0) :
    JuliaLean.base.math.ldexp o x 0 = x := by
  obtain ⟨_, _, _, hnorm, _⟩ :=
    JuliaLean.Proofs.base.math.mfNormSigFacts x hx hz
  obtain ⟨hlog, hsig⟩ := hnorm hB
  have hmag := (JuliaLean.Proofs.base.float.TruncProofs.mag_decomp x).1
  have hfrac : JuliaLean.Proofs.base.math.mfNormSig x - 2 ^ T.fmt.sb = x.frac := by
    omega
  have he : (x.expField : Int) + 0 =
      ((JuliaLean.Proofs.base.float.magKey T.fmt x.magnitude).log2 : Int) -
        T.fmt.sb + 1 := by
    omega
  have hmagLim := (JuliaLean.Proofs.base.float.TruncProofs.isfinite_iff_mag x).1 hx
  have hdiv : x.magnitude / 2 ^ T.fmt.sb = x.expField :=
    (JuliaLean.Promotion.Fl.expField_eq x).symm
  have hB0 : 1 ≤ x.expField := by omega
  have hB0' : x.expField < T.fmt.emax := by
    rw [← hdiv]
    exact Nat.div_lt_of_lt_mul (by rw [Nat.mul_comm]; exact hmagLim)
  have hround := JuliaLean.Proofs.base.math.mfLdexpRoundTrip
    o x hx hz x.expField hB0 hB0' 0 he
  have hencode :
      JuliaLean.Proofs.base.float.NextProofs.encode T x.signbit
        (x.expField * 2 ^ T.fmt.sb +
          (JuliaLean.Proofs.base.math.mfNormSig x - 2 ^ T.fmt.sb)) = x := by
    rw [hfrac, ← hmag]
    exact JuliaLean.Proofs.base.float.NextProofs.encode_input x
  rw [hencode] at hround
  exact hround

private theorem floatEquality_nonDyadic
    (t : IntTy) (f : JuliaLean.base.float.FTy)
    (o : JuliaLean.base.math.IEEEOps .f32 × JuliaLean.base.math.IEEEOps .f64)
    (q : Rat t) (x : JuliaLean.base.float.FV f)
    (hx : JuliaLean.base.float.isfinite_IEEEFloat x = true) :
    let fp := JuliaLean.Proofs.base.rational.Round5.FloatParameters.ieee f o
    let subOne := fun n : JInt t =>
      JuliaLean.base.int.binop JuliaLean.base.int.sub n (JInt.lit .i64 1)
    let div := JuliaLean.base.int.fdiv_BitInteger JuliaLean.base.float.float_BitInteger
      JuliaLean.base.float.float_BitInteger JuliaLean.base.float.div_IEEEFloat
    let eqFF := fun a : JuliaLean.base.float.FV f =>
      fun b : JuliaLean.base.float.FV .f64 =>
        JuliaLean.base.float.eq_IEEEFloat (JuliaLean.base.float.convertFloat .f64 a) b
    let left := JuliaLean.base.rational.eqFloatRatSource
      JuliaLean.base.float.isfinite_IEEEFloat JuliaLean.base.int.count_ones
      (fun n => JuliaLean.base.int.eq n (JInt.lit .i64 1))
      subOne JuliaLean.base.int.top_set_bit (fun a e => fp.ldexp a e.val)
      JuliaLean.base.float.eq_FI div eqFF x q
    let right := JuliaLean.base.rational.eqRatFloatSource
      JuliaLean.base.float.isfinite_IEEEFloat JuliaLean.base.int.count_ones
      (fun n => JuliaLean.base.int.eq n (JInt.lit .i64 1))
      subOne JuliaLean.base.int.top_set_bit (fun a e => fp.ldexp a e.val)
      JuliaLean.base.float.eq_FI div eqFF q x
    q.den.val > 0 → (¬ ∃ k : Nat, q.den.val = 2 ^ k) →
      left = false ∧ right = false := by
  dsimp only
  intro hpos hnd
  have hcountVal :
      (JuliaLean.base.int.count_ones q.den).val ≠ (JInt.lit .i64 1).val := by
    intro h
    have hc : JuliaLean.base.int.count_ones q.den = JInt.lit .i64 1 :=
      Subtype.ext h
    obtain ⟨k, hk⟩ := positiveCountOnesOne_power t q.den (by omega) hc
    exact hnd ⟨k, hk⟩
  have hEq :
      JuliaLean.base.int.eq (JuliaLean.base.int.count_ones q.den) (JInt.lit .i64 1) = false := by
    have hEq' :
        JuliaLean.base.int.eq (JuliaLean.base.int.count_ones q.den) (JInt.lit .i64 1) =
          decide ((JuliaLean.base.int.count_ones q.den).val = (JInt.lit .i64 1).val) := by
      unfold JuliaLean.base.int.eq
      rw [if_pos (show IntTy.i64.signed = IntTy.i64.signed from rfl)]
      exact JuliaLean.Proofs.base.int.eqPromote_eq rfl _ _
    rw [hEq']
    exact decide_eq_false hcountVal
  simp [JuliaLean.base.rational.eqFloatRatSource,
    JuliaLean.base.rational.eqRatFloatSource, hx, hEq, eqRatFloatMethod, Bind.bind, Pure.pure]

