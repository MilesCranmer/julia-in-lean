theorem g2IntScaledLT {c : Int} (hc : 0 < c) (a b : Int) :
    a * c < b * c ↔ a < b := by
  constructor
  · intro h
    exact Int.lt_of_mul_lt_mul_right h (Int.le_of_lt hc)
  · intro h
    exact Int.mul_lt_mul_of_pos_right h hc

theorem g2IntScaledNeg {c : Int} (hc : 0 < c) (a : Int) :
    a * c < 0 ↔ a < 0 := by
  simpa only [Int.zero_mul] using g2IntScaledLT hc a 0

theorem g2IntScaledLE {c : Int} (hc : 0 < c) (a b : Int) :
    a * c ≤ b * c ↔ a ≤ b := by
  constructor
  · intro h
    exact Int.le_of_mul_le_mul_right h hc
  · intro h
    exact Int.mul_le_mul_of_nonneg_right h (Int.le_of_lt hc)

theorem g2IntScaledEq {c : Int} (hc : 0 < c) (a b : Int) :
    a * c = b * c ↔ a = b := by
  constructor
  · intro h
    have hab := (g2IntScaledLE hc a b).mp (Int.le_of_eq h)
    have hba := (g2IntScaledLE hc b a).mp (Int.le_of_eq h.symm)
    omega
  · intro h
    rw [h]

def g2RoundingCondition (n d : Int) (mode : Rounding) (q : Int) : Prop :=
  let twiceDistance : Int := 2 * Int.ofNat (q * d - n).natAbs
  match mode with
  | .toZero =>
      if n < 0 then (q - 1) * d < n ∧ n ≤ q * d
      else q * d ≤ n ∧ n < (q + 1) * d
  | .down => q * d ≤ n ∧ n < (q + 1) * d
  | .up => (q - 1) * d < n ∧ n ≤ q * d
  | .fromZero =>
      if n < 0 then q * d ≤ n ∧ n < (q + 1) * d
      else (q - 1) * d < n ∧ n ≤ q * d
  | .nearest =>
      twiceDistance ≤ d ∧ (twiceDistance = d → q % 2 = 0)
  | .nearestAway =>
      twiceDistance ≤ d ∧ (twiceDistance = d → n.natAbs ≤ (q * d).natAbs)
  | .nearestUp =>
      twiceDistance ≤ d ∧ (twiceDistance = d → n ≤ q * d)

theorem g2RoundingCondition_scale (n d c q : Int) (mode : Rounding) (hc : 0 < c) :
    g2RoundingCondition (n*c) (d*c) mode q ↔ g2RoundingCondition n d mode q := by
  have hcabs : 0 < c.natAbs := Int.natAbs_pos.mpr (by omega)
  have hprod (k : Int) : k * (d*c) = (k*d)*c := (Int.mul_assoc k d c).symm
  have hdist : 2 * Int.ofNat (q*d*c - n*c).natAbs =
      (2 * Int.ofNat (q*d - n).natAbs) * c := by
    rw [← Int.sub_mul, Int.natAbs_mul]
    change 2 * (Int.ofNat (q*d - n).natAbs * Int.ofNat c.natAbs) = _
    rw [show Int.ofNat c.natAbs = c from Int.natAbs_of_nonneg (Int.le_of_lt hc),
      Int.mul_assoc]
  cases mode <;>
    simp only [g2RoundingCondition, hdist, hprod, g2IntScaledNeg hc,
      g2IntScaledLT hc, g2IntScaledLE hc, g2IntScaledEq hc,
      Int.natAbs_mul, Nat.mul_le_mul_right_iff hcabs]

theorem g2RoundedValue_scale (a b c q : Int) (mode : Rounding) (hc : 0 < c) :
    RoundedValue (a*c) (b*c) mode q ↔ RoundedValue a b mode q := by
  have hd : Int.ofNat (b*c).natAbs = (Int.ofNat b.natAbs) * c := by
    rw [Int.natAbs_mul]
    change Int.ofNat b.natAbs * Int.ofNat c.natAbs = _
    rw [show Int.ofNat c.natAbs = c from Int.natAbs_of_nonneg (Int.le_of_lt hc)]
  have hn : (if b*c < 0 then -(a*c) else a*c) =
      (if b < 0 then -a else a)*c := by
    by_cases h : b < 0 <;>
      simp only [g2IntScaledNeg hc, h, ite_true, ite_false, Int.neg_mul]
  have hz : b*c ≠ 0 ↔ b ≠ 0 := by
    constructor
    · intro h hzero
      apply h
      rw [hzero, Int.zero_mul]
    · intro h hzero
      apply h
      exact (g2IntScaledEq hc b 0).mp (by simpa only [Int.zero_mul] using hzero)
  change ((b*c ≠ 0) ∧
    g2RoundingCondition (if b*c < 0 then -(a*c) else a*c)
      (Int.ofNat (b*c).natAbs) mode q) ↔
      (b ≠ 0 ∧ g2RoundingCondition (if b < 0 then -a else a)
        (Int.ofNat b.natAbs) mode q)
  rw [hz, hn, hd, g2RoundingCondition_scale _ _ _ _ _ hc]

theorem g2RoundedOutcomeScale {t : IntTy} (run : Jl (JInt t))
    (a b c : Int) (hc : 0 < c) (mode : Rounding)
    (h : RoundedOutcome run a b mode) :
    RoundedOutcome run (a*c) (b*c) mode := by
  have hz : b*c = 0 ↔ b = 0 := by
    simp only [Int.mul_eq_zero, Int.ne_of_gt hc, or_false]
  constructor
  · intro hzero
    exact h.1 (hz.mp hzero)
  · intro hnonzero
    have hb : b ≠ 0 := fun hzero => hnonzero (hz.mpr hzero)
    have hs := h.2 hb
    refine ⟨?_, ?_, hs.2.2⟩
    · intro q hq hfit
      exact hs.1 q ((g2RoundedValue_scale a b c q mode hc).mp hq) hfit
    · intro out hout
      obtain ⟨q, hq, hval⟩ := hs.2.1 out hout
      exact ⟨q, (g2RoundedValue_scale a b c q mode hc).mpr hq, hval⟩


theorem g2OutcomesOfQuotient {t : IntTy} (x y : JInt t) (mode : Rounding)
    (run : Jl (JInt t))
    (hs : Round5.QuotientOutcome (.bits t) run x.val y.val mode)
    (hrel : ∀ q, y.val ≠ 0 →
      (RoundedValue x.val y.val mode q ↔ q = rounded x.val y.val mode)) :
    RoundedOutcome run x.val y.val mode ∧
    RoundedNativeFinalOutcome t t run x.val y.val mode := by
  constructor
  · refine ⟨hs.1, ?_⟩
    intro hy
    refine ⟨?_, ?_, ?_⟩
    · intro q hq hf
      have hqeq := (hrel q hy).mp hq
      have hfit : t.min ≤ rounded x.val y.val mode ∧
          rounded x.val y.val mode ≤ t.max := by
        rw [← hqeq]
        exact hf
      obtain ⟨out, hout, hval⟩ := hs.2.1 hy hfit
      exact ⟨out, hout, hval.trans hqeq.symm⟩
    · intro out hout
      by_cases hf : t.min ≤ rounded x.val y.val mode ∧
          rounded x.val y.val mode ≤ t.max
      · obtain ⟨expected, hexpected, hval⟩ := hs.2.1 hy hf
        have heq : out = expected := Except.ok.inj (hout.symm.trans hexpected)
        rw [heq]
        exact ⟨rounded x.val y.val mode, (hrel _ hy).mpr rfl,
          hval.trans (wrapInt_of_inRange t _ hf).symm⟩
      · rw [hs.2.2 hy hf] at hout
        cases hout
    · intro e he
      by_cases hf : t.min ≤ rounded x.val y.val mode ∧
          rounded x.val y.val mode ≤ t.max
      · obtain ⟨out, hout, _⟩ := hs.2.1 hy hf
