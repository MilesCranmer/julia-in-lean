/-- Representation invariant for the existing stored UnitRange type.
All endpoints are normalized native rationals. For finite endpoints, the
source constructor at base/range.jl:443-445 makes their difference an integer,
keeps a common denominator, and canonicalizes an empty range to one step
below its start. This condition does not exclude infinite endpoints, and
never replaces a native-sized endpoint by an unrestricted Lean list. -/
def RemainingUnitRangeRepresentation {t : IntTy}
    (r : JuliaLean.base.range.UnitRange (Rat t)) : Prop :=
  Normalized r.start ∧ Normalized r.stop ∧
    (0 < r.start.den.val → 0 < r.stop.den.val →
      r.start.den.val = r.stop.den.val ∧
      ∃ k : Int, -1 ≤ k ∧ r.stop.num.val - r.start.num.val = k * r.start.den.val)

/-- Mathematical cardinality of the inclusive finite unit-step interval.
The expression uses exact endpoint values, independently of the source's
same-denominator wrapping-numerator optimization. -/
def remainingUnitRangeCardinality {t : IntTy}
    (r : JuliaLean.base.range.UnitRange (Rat t)) : Int :=
  max 0 ((r.stop.num.val * r.start.den.val - r.start.num.val * r.stop.den.val) /
    (r.start.den.val * r.stop.den.val) + 1)

/-- Wrapped native range length is the cardinality modulo the native
result width for finite stored ranges. Infinity in the first endpoint
makes the source's divisor zero; otherwise native integer division must
produce a value. Infinite last endpoints stay in the input domain, but no
finite cardinality is claimed for them. This can expose premature numerator
overflow even when the actual element count is representable. -/
def LengthNativeRationalRangeCorrect : Prop :=
  ∀ (t : IntTy) (r : JuliaLean.base.range.UnitRange (Rat t)),
    RemainingUnitRangeRepresentation r →
    let run := lengthNativeRationalRange r
    if r.start.den.val = 0 then run = .error (.jl .divideError)
    else ∃ out, run = .ok out ∧
      (0 < r.stop.den.val → out.val = wrapInt t (remainingUnitRangeCardinality r))

/-- The observable checked-arithmetic error class in the range monad. -/
def RemainingRangeOverflow {t : IntTy}
    (run : JuliaLean.base.range.JlX (JInt t)) : Prop :=
  ∃ message, run = .error (.jl (.overflowError message))

/-- Checked length includes empty ranges, infinite endpoints, and every
checked intermediate overflow. Arithmetic safety is a conclusion-side case
split, not a precondition discarding difficult ranges. A successful checked
length is nonnegative, and for finite intervals equals the exact cardinality. -/
def CheckedLengthNativeRationalRangeCorrect : Prop :=
  ∀ (t w : IntTy) (wide : JuliaLean.base.int.widenType t = some w)
    (r : JuliaLean.base.range.UnitRange (Rat t)),
    RemainingUnitRangeRepresentation r →
    let run := checkedLengthNativeRationalRange wide r
    let empty := remainingExtendedCompare r.stop.num.val r.stop.den.val
      r.start.num.val r.start.den.val < 0
    let delta := r.stop.num.val - r.start.num.val
    let scaledCount := delta + r.start.den.val
    if empty then ∃ out, run = .ok out ∧ out.val = 0
    else if ¬ RoundedFits t delta then RemainingRangeOverflow run
    else if ¬ RoundedFits t scaledCount then RemainingRangeOverflow run
    else if r.start.den.val = 0 then run = .error (.jl .divideError)
    else ∃ out, run = .ok out ∧ 0 ≤ out.val ∧
      (0 < r.stop.den.val → out.val = remainingUnitRangeCardinality r)

