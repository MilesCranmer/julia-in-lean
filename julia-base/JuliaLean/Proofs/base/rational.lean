private theorem estate_bind_run_ok {ε σ α β : Type} {m : EStateM ε σ α} (f : α → EStateM ε σ β)
    {s s' : σ} {a : α} (h : m.run s = .ok a s') :
    (Bind.bind m f).run s = (f a).run s' := by
  simp only [EStateM.run, Bind.bind, EStateM.bind] at h ⊢
  rw [h]

private theorem pure_bind_run {ε σ α β : Type} (a : α) (f : α → EStateM ε σ β) (s : σ) :
    (Bind.bind (Pure.pure a) f).run s = (f a).run s := rfl

private theorem lift_ok_bind_run {α β : Type} (a : α) (f : α → JuliaLean.base.iobuffer.M β)
    (s : JuliaLean.base.iobuffer.BufferState) :
    (Bind.bind (JuliaLean.base.iobuffer.lift (.ok a)) f).run s = (f a).run s := rfl

private theorem liftNative_ok_bind_run {α β : Type} (a : α) (f : α → JuliaLean.base.iobuffer.M β)
    (s : JuliaLean.base.iobuffer.BufferState) :
    (Bind.bind (JuliaLean.base.iobuffer.liftNative (.ok a)) f).run s = (f a).run s := rfl

private theorem bind_assoc_run {ε σ α β γ : Type} (m : EStateM ε σ α)
    (f : α → EStateM ε σ β) (g : β → EStateM ε σ γ) (s : σ) :
    (Bind.bind (Bind.bind m f) g).run s = (Bind.bind m (fun a => Bind.bind (f a) g)).run s := by
  simp only [EStateM.run, Bind.bind, EStateM.bind]
  cases m s <;> rfl

private theorem bind2_yield_not_done {ε σ α₁ α₂ β : Type}
    (m1 : EStateM ε σ α₁) (m2 : α₁ → EStateM ε σ α₂) (g : α₁ → α₂ → β)
    (st : σ) (w1 : β) (st1 : σ) :
    (Bind.bind m1 (fun a1 => Bind.bind (m2 a1) (fun a2 => Pure.pure (ForInStep.yield (g a1 a2))))).run st ≠
      .ok (ForInStep.done w1) st1 := by
  simp only [EStateM.run, Bind.bind, EStateM.bind, Pure.pure, EStateM.pure]
  cases m1 st with
  | error e s1 => intro h; cases h
  | ok a1 s1 =>
    dsimp only
    cases m2 a1 s1 with
    | error e s2 => intro h; cases h
    | ok a2 s2 => intro h; cases h

private theorem forIn_append_estate {ε σ α β : Type}
    (xs ys : List α) (w : β) (f : α → β → EStateM ε σ (ForInStep β))
    (hyield : ∀ k w st w1 st1, (f k w).run st ≠ .ok (ForInStep.done w1) st1) :
    forIn (m := EStateM ε σ) (xs ++ ys) w f =
      Bind.bind (forIn (m := EStateM ε σ) xs w f)
        (fun w' => forIn (m := EStateM ε σ) ys w' f) := by
  induction xs generalizing w with
  | nil => rfl
  | cons k xs ih =>
    funext st
    simp only [List.cons_append, List.forIn_cons, Bind.bind, EStateM.bind]
    cases h : f k w st with
    | error e st1 => rfl
    | ok step st1 =>
      cases step with
      | done w1 => exact False.elim (hyield k w st w1 st1 h)
      | yield w1 => exact congrFun (ih w1) st1

private theorem bufferAccess_get_run (s : JuliaLean.base.iobuffer.BufferState) :
    (JuliaLean.base.iobuffer.bufferAccess.get ()).run s =
      .ok (JuliaLean.base.iobuffer.bufferFields s) s := rfl

private theorem bufferAccess_set_run (s : JuliaLean.base.iobuffer.BufferState)
    (f : JuliaLean.base.iobuffer.Fields (List UInt8)) :
    (JuliaLean.base.iobuffer.bufferAccess.set () f).run s =
      .ok () (JuliaLean.base.iobuffer.updateBufferFields s f) := rfl

private theorem lor_add_disjoint_nat (x y k : Nat)
    (hx : x % 2 ^ k = 0) (hy : y < 2 ^ k) : Nat.lor x y = x + y := by
  have ex : x = 2 ^ k * (x / 2 ^ k) := by
    have h := Nat.div_add_mod x (2 ^ k)
    rw [hx, Nat.add_zero] at h
    exact h.symm
  apply Nat.eq_of_testBit_eq
  intro idx
  change (Nat.bitwise (· || ·) x y).testBit idx = (x + y).testBit idx
  rw [Nat.testBit_bitwise (by rfl)]
  have hb : 0 < 2 ^ k := Nat.two_pow_pos k
  have hxb := Nat.testBit_two_pow_mul_add (x / 2 ^ k) (b := 0) hb idx
  simp only [Nat.add_zero, Nat.zero_testBit] at hxb
  have hyb := Nat.testBit_two_pow_mul_add 0 hy idx
  simp only [Nat.mul_zero, Nat.zero_add, Nat.zero_testBit] at hyb
  have hsum := Nat.testBit_two_pow_mul_add (x / 2 ^ k) hy idx
  rw [← ex] at hsum hxb
  rw [hxb, hsum]
  by_cases hlt : idx < k
  · simp [hlt]
  · have hey : y.testBit idx = false := by simpa [hlt] using hyb
    simp [hlt, hey]

private theorem nat_lor_comm_eq (a b : Nat) : Nat.lor a b = Nat.lor b a := by
  apply Nat.eq_of_testBit_eq
  intro idx
  change (Nat.bitwise (· || ·) a b).testBit idx = (Nat.bitwise (· || ·) b a).testBit idx
  rw [Nat.testBit_bitwise (by rfl), Nat.testBit_bitwise (by rfl)]
  cases a.testBit idx <;> cases b.testBit idx <;> rfl

private theorem u64_val_of_lt {n : Nat} (hn : n < 2 ^ 64) :
    (JuliaLean.base.iobuffer.u (n : Int)).val = (n : Int) := by
  unfold JuliaLean.base.iobuffer.u
  exact wrapInt_of_inRange .u64 (n : Int)
    ⟨by simp [IntTy.min, IntTy.signed], by simp [IntTy.max, IntTy.signed, IntTy.bits]; omega⟩

private theorem u64_toNat_of_lt {n : Nat} (hn : n < 2 ^ 64) :
    (JuliaLean.base.iobuffer.u (n : Int)).val.toNat = n := by
  rw [u64_val_of_lt hn, Int.toNat_natCast]

private theorem lit_i64_of_le_64 {k : Nat} (hk : k ≤ 64) :
    (JuliaLean.base.int.lit .i64 k).val = (k : Int) := by
  change wrapInt .i64 (k : Int) = (k : Int)
  exact wrapInt_of_inRange .i64 _ ⟨by simp [IntTy.min, IntTy.signed, IntTy.bits],
    by simp [IntTy.max, IntTy.signed, IntTy.bits]; omega⟩

private theorem lit_u8_of_lt_256 {b : Nat} (hb : b < 256) :
    (JuliaLean.base.int.lit .u8 b).val = (b : Int) := by
  change wrapInt .u8 (b : Int) = (b : Int)
  exact wrapInt_of_inRange .u8 _ ⟨by simp [IntTy.min, IntTy.signed],
    by simp [IntTy.max, IntTy.signed, IntTy.bits]; omega⟩

private theorem convert_u64_of_lt_256 {b : Nat} (hb : b < 256) :
    JuliaLean.base.int.convert .u64 (JuliaLean.base.int.lit .u8 b) =
      .ok (JuliaLean.base.iobuffer.u (b : Int)) := by
  unfold JuliaLean.base.int.convert
  have hval := lit_u8_of_lt_256 hb
  have hfit : IntTy.u64.min ≤ (b : Int) ∧ (b : Int) ≤ IntTy.u64.max :=
    ⟨by simp [IntTy.min, IntTy.signed], by simp [IntTy.max, IntTy.signed, IntTy.bits]; omega⟩
  rw [hval, convert_of_fits hfit]
  congr 1
  apply Subtype.ext
  exact (u64_val_of_lt (by omega)).symm

private theorem int_add_i64_val (a b : JuliaLean.base.iobuffer.I) :
    (JuliaLean.base.int.add a b).val = wrapInt .i64 (a.val + b.val) :=
  add_int_val a b

private theorem int_sub_i64_val (a b : JuliaLean.base.iobuffer.I) :
    (JuliaLean.base.int.sub a b).val = wrapInt .i64 (a.val - b.val) :=
  sub_int_val a b

private theorem int_mul_i64_val (a b : JuliaLean.base.iobuffer.I) :
    (JuliaLean.base.int.mul a b).val = wrapInt .i64 (a.val * b.val) :=
  mul_int_val a b

private theorem add_i64_of_bounds (ptr : JuliaLean.base.iobuffer.I) {k : Nat}
    (hk : k < 8) (hwrap : ptr.val + 8 ≤ IntTy.i64.max) :
    (JuliaLean.base.int.add ptr (JuliaLean.base.int.lit .i64 k)).val = ptr.val + (k : Int) := by
  have hptr_prop := ptr.property
  have hk_val := lit_i64_of_le_64 (by omega : k ≤ 64)
  rw [int_add_i64_val, hk_val]
  exact wrapInt_of_inRange .i64 _ ⟨by simp [IntTy.min, IntTy.signed, IntTy.bits] at hptr_prop ⊢; omega,
    by simp [IntTy.max, IntTy.signed, IntTy.bits] at hwrap ⊢; omega⟩

private theorem mul_8_i64_val {k : Nat} (hk : k < 8) :
    (JuliaLean.base.int.mul (JuliaLean.base.int.lit .i64 8) (JuliaLean.base.int.lit .i64 k)).val =
      (8 * k : Nat) := by
  have hk_val := lit_i64_of_le_64 (by omega : k ≤ 64)
  rw [int_mul_i64_val, hk_val, show (JuliaLean.base.int.lit .i64 8).val = 8 from rfl]
  exact wrapInt_of_inRange .i64 _ ⟨by simp [IntTy.min, IntTy.signed, IntTy.bits]; omega,
    by simp [IntTy.max, IntTy.signed, IntTy.bits]; omega⟩

private theorem pattern_bor {t : IntTy} (x y : JInt t) :
    pattern (JuliaLean.base.int.bor x y) = Nat.lor (pattern x) (pattern y) := by
  simp only [JuliaLean.base.int.bor, JuliaLean.base.int.or_int, JuliaLean.C.jlOrInt,
    pattern_toJInt, BitVec.toNat_or, ← pattern_fromJInt]
  rfl

private theorem bor_u64_eq (x y : JInt .u64) :
    JuliaLean.base.int.bor x y =
      JuliaLean.base.iobuffer.u (Nat.lor (pattern x) (pattern y) : Int) := by
  apply Subtype.ext
  have hlt : Nat.lor (pattern x) (pattern y) < 2 ^ 64 := by
    rw [← pattern_bor]
    exact pattern_lt (JuliaLean.base.int.bor x y)
  rw [← val_of_unsigned_pattern rfl (JuliaLean.base.int.bor x y),
      pattern_bor, u64_val_of_lt hlt]

private abbrev loadForInBody (s : JuliaLean.base.iobuffer.BufferState)
    (k : Nat) (word : JInt .u64) :
    JuliaLean.base.iobuffer.M (ForInStep (JInt .u64)) := do
  let index := JuliaLean.base.int.lit .i64 k
  let b ← (do
    let b ← JuliaLean.base.iobuffer.lift
      (JuliaLean.base.iobuffer.getChecked s.data (JuliaLean.base.int.add s.ptr index))
    pure (JuliaLean.base.int.lit .u8 b.toNat))
  let converted ← JuliaLean.base.iobuffer.liftNative
    (JuliaLean.base.int.convert .u64 b)
  pure (ForInStep.yield (JuliaLean.base.int.bor word
    (JuliaLean.base.int.shl_Int converted (JuliaLean.base.int.mul (JuliaLean.base.int.lit .i64 8) index))))

private theorem loadForInBody_not_done (s : JuliaLean.base.iobuffer.BufferState)
    (k : Nat) (w : JInt .u64) (st : JuliaLean.base.iobuffer.BufferState)
    (w1 : JInt .u64) (st1 : JuliaLean.base.iobuffer.BufferState) :
    (loadForInBody s k w).run st ≠ .ok (ForInStep.done w1) st1 :=
  bind2_yield_not_done _ _ _ st w1 st1

private theorem loadForInBody_ok (s : JuliaLean.base.iobuffer.BufferState)
    (k : Nat) (w : JInt .u64) (b8 : UInt8) (u_b : JInt .u64)
    (hget : JuliaLean.base.iobuffer.getChecked s.data
      (JuliaLean.base.int.add s.ptr (JuliaLean.base.int.lit .i64 k)) = .ok b8)
    (hconv : JuliaLean.base.int.convert .u64
      (JuliaLean.base.int.lit .u8 b8.toNat) = .ok u_b) :
    (loadForInBody s k w).run s = EStateM.Result.ok
      (ForInStep.yield (JuliaLean.base.int.bor w
        (JuliaLean.base.int.shl_Int u_b
          (JuliaLean.base.int.mul (JuliaLean.base.int.lit .i64 8) (JuliaLean.base.int.lit .i64 k))))) s := by
  unfold loadForInBody
  simp only [hget, bind_assoc_run, lift_ok_bind_run, pure_bind_run, hconv, liftNative_ok_bind_run]
  rfl

private theorem bitcast_u64_id (word : JInt .u64) (h : IntTy.u64.bits = IntTy.u64.bits) :
    JuliaLean.base.int.bitcast .u64 word h = word := by
  apply Subtype.ext
  rw [JuliaLean.Proofs.base.int.bitcast_val, wrapInt_of_inRange _ word.val word.property]

private theorem reinterpretWord_u64_run
    (full : (kind : JuliaLean.base.iobuffer.Multibyte) → JInt (JuliaLean.base.iobuffer.wordType kind) →
      JuliaLean.base.iobuffer.M (JuliaLean.base.iobuffer.valueType kind))
    (word : JInt .u64) (s : JuliaLean.base.iobuffer.BufferState) :
    (JuliaLean.base.iobuffer.reinterpretWord full .u64 word).run s =
      .ok (word : JuliaLean.base.iobuffer.valueType .u64) s := by
  change (if (true && true) = true then
      (Pure.pure (JuliaLean.base.int.bitcast .u64 word rfl) : JuliaLean.base.iobuffer.M (JInt .u64))
    else full .u64 word).run s = .ok word s
  simp only [Bool.and_self, ↓reduceIte, bitcast_u64_id]
  rfl

private theorem loadUInt_forIn_eq (s : JuliaLean.base.iobuffer.BufferState)
    (hptr : 1 ≤ s.ptr.val) (hlen : s.ptr.val + 7 ≤ s.data.length)
    (hwrap : s.ptr.val + 8 ≤ IntTy.i64.max) :
    ∀ (k : Nat), k ≤ 8 →
      let sumNat := (List.range k).foldl
        (fun n j => n + (s.data.getD ((s.ptr.val - 1).toNat + j) 0).toNat * 256 ^ j) 0
      sumNat < 256 ^ k ∧
      (forIn (m := JuliaLean.base.iobuffer.M) (List.range k)
        (JuliaLean.base.iobuffer.u 0) (loadForInBody s)).run s =
      EStateM.Result.ok (JuliaLean.base.iobuffer.u (sumNat : Int)) s := by
  intro k hk
  induction k with
  | zero => exact ⟨by dsimp; decide, rfl⟩
  | succ k ih =>
    have hptr_k_val := add_i64_of_bounds s.ptr hk hwrap
    have hidx : ((JuliaLean.base.int.add s.ptr (JuliaLean.base.int.lit .i64 k)).val - 1).toNat =
        (s.ptr.val - 1).toNat + k := by
      rw [hptr_k_val]; omega
    let b8 := s.data.getD ((s.ptr.val - 1).toNat + k) 0
    have hget : JuliaLean.base.iobuffer.getChecked s.data
        (JuliaLean.base.int.add s.ptr (JuliaLean.base.int.lit .i64 k)) =
        .ok b8 := by
      unfold JuliaLean.base.iobuffer.getChecked
      rw [if_pos ⟨by rw [hptr_k_val]; omega, by rw [hptr_k_val]; omega⟩, hidx]
    obtain ⟨ih_lt, ih_eq⟩ := ih (by omega)
    generalize hprev : (List.range k).foldl
      (fun n j => n + (s.data.getD ((s.ptr.val - 1).toNat + j) 0).toNat * 256 ^ j) 0 = prevNat at ih_lt ih_eq
    generalize hb : b8.toNat = bNat
    have hb_lt : bNat < 256 := by rw [← hb]; exact b8.toFin.isLt
    have hpow_eq : 2 ^ (8 * k) = 256 ^ k := by
      rw [Nat.pow_mul, show 2 ^ 8 = 256 by decide]
    have hpow_le : 256 ^ (k + 1) ≤ 2 ^ 64 := by
      have h1 : 256 ^ (k + 1) ≤ 256 ^ 8 := Nat.pow_le_pow_right (by decide) hk
      have h2 : (256 : Nat) ^ 8 = 2 ^ 64 := by decide
      omega
    have hprev_u64 : prevNat < 2 ^ 64 := by
      have : 256 ^ k < 256 ^ (k + 1) := Nat.pow_lt_pow_right (by decide) (by omega)
      omega
    have hsum_lt : prevNat + bNat * 256 ^ k < 256 ^ (k + 1) := by
      rw [Nat.pow_succ]
      have hb_le : bNat ≤ 255 := by omega
      have : bNat * 256 ^ k ≤ 255 * 256 ^ k := Nat.mul_le_mul_right _ hb_le
      omega
    have hconv_u64 : JuliaLean.base.int.convert .u64
        (JuliaLean.base.int.lit .u8 b8.toNat) =
        .ok (JuliaLean.base.iobuffer.u (bNat : Int)) := by
      rw [hb]
      exact convert_u64_of_lt_256 hb_lt
    let shiftCnt := JuliaLean.base.int.mul (JuliaLean.base.int.lit .i64 8) (JuliaLean.base.int.lit .i64 k)
    have hshift_cnt_val : shiftCnt.val = (8 * k : Nat) := mul_8_i64_val hk
    have hshift_cnt_nn : 0 ≤ shiftCnt.val := by rw [hshift_cnt_val]; exact Int.natCast_nonneg _
    have hpat_prev : pattern (JuliaLean.base.iobuffer.u (prevNat : Int)) = prevNat := by
      rw [pattern_of_nonneg _ (nonneg_of_unsigned rfl _), u64_toNat_of_lt hprev_u64]
    have hpat_b : pattern (JuliaLean.base.iobuffer.u (bNat : Int)) = bNat := by
      rw [pattern_of_nonneg _ (nonneg_of_unsigned rfl _), u64_toNat_of_lt (by omega)]
    have hpat_shl : pattern (JuliaLean.base.int.shl_Int (JuliaLean.base.iobuffer.u (bNat : Int)) shiftCnt) =
        bNat * 2 ^ (8 * k) := by
      rw [pattern_shl_Int _ shiftCnt hshift_cnt_nn, hpat_b, hshift_cnt_val, Int.toNat_natCast]
      exact Nat.mod_eq_of_lt (by change bNat * 2 ^ (8 * k) < 2 ^ 64; rw [hpow_eq]; omega)
    have hlor : Nat.lor prevNat (bNat * 2 ^ (8 * k)) = prevNat + bNat * 256 ^ k := by
      rw [nat_lor_comm_eq, lor_add_disjoint_nat (bNat * 2 ^ (8 * k)) prevNat (8 * k)
        (by simp) (by rw [hpow_eq]; exact ih_lt), hpow_eq, Nat.add_comm]
    have hbor_step : JuliaLean.base.int.bor (JuliaLean.base.iobuffer.u (prevNat : Int))
        (JuliaLean.base.int.shl_Int (JuliaLean.base.iobuffer.u (bNat : Int)) shiftCnt) =
        JuliaLean.base.iobuffer.u ((prevNat + bNat * 256 ^ k : Nat) : Int) := by
      rw [bor_u64_eq, hpat_prev, hpat_shl, hlor]
    rw [List.range_succ, List.foldl_append, List.foldl_cons, List.foldl_nil, hprev, hb]
    refine ⟨hsum_lt, ?_⟩
    rw [forIn_append_estate _ _ _ _ (loadForInBody_not_done s)]
    rw [estate_bind_run_ok _ ih_eq]
    rw [List.forIn_cons]
    rw [estate_bind_run_ok _
      (loadForInBody_ok s k (JuliaLean.base.iobuffer.u (prevNat : Int)) b8
        (JuliaLean.base.iobuffer.u (bNat : Int)) hget hconv_u64)]
    dsimp only [List.forIn_nil]
    rw [hbor_step]
    rfl

private theorem readUIntModel_ok (s : JuliaLean.base.iobuffer.BufferState)
    (hr : s.readable = true) (hp : 1 ≤ s.ptr.val)
    (hs : s.ptr.val + 8 ≤ s.size.val + 1)
    (hdata : s.size.val ≤ s.data.length)
    (hwrap : s.ptr.val + 8 ≤ IntTy.i64.max) :
    let s' : JuliaLean.base.iobuffer.BufferState :=
      { s with ptr := s.ptr + JuliaLean.base.iobuffer.i 8 }
    ∃ w : JuliaLean.base.iobuffer.U,
      JuliaLean.base.iobuffer.readUIntModel s = .ok w s' ∧
      w.val = wordAt s.data (s.ptr.val - 1).toNat ∧
      s'.ptr.val = s.ptr.val + 8 ∧
      s'.readable = true ∧
      s'.size = s.size ∧
      s'.data = s.data := by
  intro s'
  have hsize_prop := s.size.property
  have hptr_prop := s.ptr.property
  have hi1_val : (JuliaLean.base.iobuffer.one).val = 1 := rfl
  have hi8_val : (JuliaLean.base.iobuffer.i 8).val = 8 := rfl
  have hsub_val : (JuliaLean.base.int.sub s.size s.ptr).val = s.size.val - s.ptr.val := by
    rw [int_sub_i64_val]
    exact wrapInt_of_inRange .i64 _ ⟨by simp [IntTy.min, IntTy.max, IntTy.signed, IntTy.bits] at hsize_prop hptr_prop ⊢; omega,
      by simp [IntTy.min, IntTy.max, IntTy.signed, IntTy.bits] at hsize_prop hptr_prop ⊢; omega⟩
  have havail_val : (JuliaLean.base.iobuffer.fieldsBytesavailable (JuliaLean.base.iobuffer.bufferFields s)).val =
      s.size.val - s.ptr.val + 1 := by
    unfold JuliaLean.base.iobuffer.fieldsBytesavailable JuliaLean.base.iobuffer.bufferFields
    dsimp only
    rw [int_add_i64_val, hsub_val, hi1_val]
    exact wrapInt_of_inRange .i64 _ ⟨by simp [IntTy.min, IntTy.max, IntTy.signed, IntTy.bits] at hsize_prop hptr_prop ⊢; omega,
      by simp [IntTy.min, IntTy.max, IntTy.signed, IntTy.bits] at hsize_prop hptr_prop ⊢; omega⟩
  have hlt_eof : JuliaLean.base.int.lt
      (JuliaLean.base.iobuffer.fieldsBytesavailable (JuliaLean.base.iobuffer.bufferFields s))
      (JuliaLean.base.int.sizeof (JuliaLean.base.iobuffer.initialWord .u64)) = false := by
    rw [lt_eq, havail_val]
    have hsz : (JuliaLean.base.int.sizeof (JuliaLean.base.iobuffer.initialWord .u64)).val = 8 := rfl
    rw [hsz]
    exact decide_eq_false (by omega)
  obtain ⟨hw_lt, hfor⟩ := loadUInt_forIn_eq s hp (by omega) hwrap 8 (by decide)
  generalize hwNat : (List.range 8).foldl
    (fun n j => n + (s.data.getD ((s.ptr.val - 1).toNat + j) 0).toNat * 256 ^ j) 0 = wNat at hw_lt hfor
  let w : JuliaLean.base.iobuffer.valueType .u64 := JuliaLean.base.iobuffer.u (wNat : Int)
  have hptr_next : s'.ptr.val = s.ptr.val + 8 := by
    change wrapInt .i64 (s.ptr.val + (JuliaLean.base.iobuffer.i 8).val) = _
    rw [hi8_val]
    exact wrapInt_of_inRange .i64 _ ⟨by simp [IntTy.min, IntTy.max, IntTy.signed, IntTy.bits] at hptr_prop ⊢; omega, hwrap⟩
  have hptr_add_eq : JuliaLean.base.int.add s.ptr
      (JuliaLean.base.int.sizeof (JuliaLean.base.iobuffer.initialWord .u64)) =
      s.ptr + JuliaLean.base.iobuffer.i 8 := by
    apply Subtype.ext
    rw [int_add_i64_val]
    rfl
  have hw_val : (w : JuliaLean.base.iobuffer.U).val = wordAt s.data (s.ptr.val - 1).toNat := by
    unfold wordAt
    rw [hwNat]
    have h256 : (256 : Nat) ^ 8 = 2 ^ 64 := by decide
    exact u64_val_of_lt (by omega)
  have hread_field : (JuliaLean.base.iobuffer.bufferFields s).readable = true := hr
  have hdata_field : (JuliaLean.base.iobuffer.bufferFields s).data = s.data := rfl
  have hptr_field : (JuliaLean.base.iobuffer.bufferFields s).ptr = s.ptr := rfl
  have hload : (JuliaLean.base.iobuffer.source_load_from_array
      (fun bytes index => do
        let b ← JuliaLean.base.iobuffer.lift (JuliaLean.base.iobuffer.getChecked bytes index)
        pure (JuliaLean.base.int.lit .u8 b.toNat))
      (fun _ word => pure word)
      (JuliaLean.base.iobuffer.reinterpretWord (fun _ value => pure (JuliaLean.base.iobuffer.bitcastWord _ value)))
      .u64 s.data s.ptr).run s =
      .ok (w : JuliaLean.base.iobuffer.valueType .u64) s := by
    change (do
      let __s ← forIn (m := JuliaLean.base.iobuffer.M) (List.range 8)
        (JuliaLean.base.iobuffer.u 0) (loadForInBody s)
      let __do_lift ← pure __s
      JuliaLean.base.iobuffer.reinterpretWord
        (fun _ value => pure (JuliaLean.base.iobuffer.bitcastWord _ value))
        .u64 __do_lift).run s =
      .ok (w : JuliaLean.base.iobuffer.valueType .u64) s
    rw [estate_bind_run_ok _ hfor, pure_bind_run]
    exact reinterpretWord_u64_run _ w s
  have hpeek : (JuliaLean.base.iobuffer.source_peek_multibyte
      JuliaLean.base.iobuffer.bufferAccess
      (fun bytes index => do
        let b ← JuliaLean.base.iobuffer.lift (JuliaLean.base.iobuffer.getChecked bytes index)
        pure (JuliaLean.base.int.lit .u8 b.toNat))
      (fun _ word => pure word)
      (JuliaLean.base.iobuffer.reinterpretWord (fun _ value => pure (JuliaLean.base.iobuffer.bitcastWord _ value)))
      () .u64).run s =
      .ok (w : JuliaLean.base.iobuffer.valueType .u64) s := by
    unfold JuliaLean.base.iobuffer.source_peek_multibyte
    rw [estate_bind_run_ok _ (bufferAccess_get_run s)]
    simp only [hread_field, hdata_field, hptr_field, hlt_eof,
      Bool.not_true, Bool.false_eq_true, ↓reduceIte]
    exact hload
  have hrun : (JuliaLean.base.iobuffer.readUIntModel).run s = .ok w s' := by
    change (JuliaLean.base.iobuffer.source_read_multibyte
      JuliaLean.base.iobuffer.bufferAccess
      (fun bytes idx => do
        let b ← JuliaLean.base.iobuffer.lift (JuliaLean.base.iobuffer.getChecked bytes idx)
        pure (JuliaLean.base.int.lit .u8 b.toNat))
      (fun _ w => pure w)
      (JuliaLean.base.iobuffer.reinterpretWord (fun _ v => pure (JuliaLean.base.iobuffer.bitcastWord _ v)))
      () .u64).run s =
      .ok (w : JuliaLean.base.iobuffer.valueType .u64) s'
    unfold JuliaLean.base.iobuffer.source_read_multibyte
    rw [estate_bind_run_ok _ hpeek]
    rw [estate_bind_run_ok _ (bufferAccess_get_run s)]
    rw [estate_bind_run_ok _ (bufferAccess_set_run s _)]
    simp only [EStateM.run, Pure.pure, EStateM.pure,
      JuliaLean.base.iobuffer.bufferFields, JuliaLean.base.iobuffer.updateBufferFields, hptr_add_eq]
    rfl
  exact ⟨w, hrun, hw_val, hptr_next, hr, rfl, rfl⟩

theorem binary_read_aux (io : JuliaLean.base.iobuffer.BufferState)
    (hr : io.readable = true) (hp : 1 ≤ io.ptr.val)
    (hs : io.ptr.val+16 ≤ io.size.val+1) (hdata : io.size.val ≤ io.data.length)
    (hwrap : io.ptr.val+16 ≤ IntTy.i64.max) :
    let n := wordAt io.data (io.ptr.val-1).toNat
    let d := wordAt io.data (io.ptr.val+7).toNat
    (n ≠ 0 ∨ d ≠ 0 → ∃ q out, readUIntRational io = .ok q out ∧ Normalized q ∧
      q.num.val*d = n*q.den.val ∧ (d ≠ 0 → q.den.val > 0) ∧
      out.ptr.val = io.ptr.val+16 ∧ out.data = io.data) ∧
    (n = 0 → d = 0 → ∃ out msg, readUIntRational io = .error (.jl (.argumentError msg)) out ∧
      out.ptr.val = io.ptr.val+16) := by
  intro n d
  obtain ⟨nJ, hread1, hnJ_v, hptr1, hr1, hsize1, hdata1⟩ :=
    readUIntModel_ok io hr hp (by omega) hdata (by omega)
  let io1 : JuliaLean.base.iobuffer.BufferState :=
    { io with ptr := io.ptr + JuliaLean.base.iobuffer.i 8 }
  obtain ⟨dJ, hread2, hdJ_v, hptr2, _, _, hdata2⟩ :=
    readUIntModel_ok io1 hr1 (by rw [hptr1]; omega) (by rw [hptr1, hsize1]; omega)
      (by rw [hsize1, hdata1]; exact hdata) (by rw [hptr1]; omega)
  let io2 : JuliaLean.base.iobuffer.BufferState :=
    { io1 with ptr := io1.ptr + JuliaLean.base.iobuffer.i 8 }
  have hptr2_eq : io2.ptr.val = io.ptr.val + 16 := by rw [hptr2, hptr1]; omega
  have hdata2_eq : io2.data = io.data := hdata2.trans hdata1
  have hstart2 : (io1.ptr.val - 1).toNat = (io.ptr.val + 7).toNat := by rw [hptr1]; omega
  rw [hdata1, hstart2] at hdJ_v
  change nJ.val = n at hnJ_v
  change dJ.val = d at hdJ_v
  have hstep : readUIntRational io =
      match (exactDivideIntsSource (rational (.bits .u64)) nJ dJ).mapError JuliaLean.base.iobuffer.IOErr.jl with
      | .ok val => EStateM.Result.ok val io2
      | .error err => EStateM.Result.error err io2 := by
    unfold readUIntRational readRationalSource JuliaLean.base.iobuffer.lift
    dsimp only [io1] at hread2
    simp only [Bind.bind, EStateM.bind, Pure.pure, EStateM.pure, throw, throwThe, MonadExceptOf.throw, EStateM.throw, hread1, hread2]
    cases (exactDivideIntsSource (rational (.bits .u64)) nJ dJ).mapError JuliaLean.base.iobuffer.IOErr.jl <;> rfl
  rw [hstep]
  have hc := native_constructor_aux .u64 nJ dJ
  unfold ConstructorContract FitsPair ExactResult Represents Canonical
    IntegerParameters.fits IntegerParameters.ops jintOps reduced at hc
  dsimp only [val, rn, rd] at hc
  rw [hnJ_v, hdJ_v] at hc
  refine ⟨fun hnz => ?_, fun hn0 hd0 => ?_⟩
  · have hg_nz : Nat.gcd n.natAbs d.natAbs ≠ 0 := by
      intro hg0
      have ⟨h1, h2⟩ := Nat.gcd_eq_zero_iff.mp hg0
      rcases hnz with hn | hd
      · exact hn (by omega)
      · exact hd (by omega)
    let g : Int := Nat.gcd n.natAbs d.natAbs
    have hg_pos : 0 < g := Int.natCast_pos.mpr (Nat.pos_of_ne_zero hg_nz)
    have hn_nn : 0 ≤ n := by rw [← hnJ_v]; exact nonneg_of_unsigned rfl nJ
    have hd_nn : 0 ≤ d := by rw [← hdJ_v]; exact nonneg_of_unsigned rfl dJ
    have hnot_negU : ¬ (!IntTy.u64.signed = true ∧ n ≠ 0 ∧ ((n < 0) ≠ (d < 0))) := by
      rintro ⟨_, _, hne⟩
      exact hne (propext ⟨fun h => absurd h (Int.not_lt.mpr hn_nn), fun h => absurd h (Int.not_lt.mpr hd_nn)⟩)
    have hr1_fit : IntTy.u64.min ≤ ((n.tdiv g).natAbs : Int) ∧ ((n.tdiv g).natAbs : Int) ≤ IntTy.u64.max := by
      have h1 := fits_between nJ (tdiv_between nJ.val g hg_pos)
      have h2 : 0 ≤ n.tdiv g := (tdiv_between n g hg_pos).1 hn_nn |>.1
      rw [hnJ_v] at h1
      rw [Int.natAbs_of_nonneg h2]
      exact h1
    have hr2_fit : IntTy.u64.min ≤ ((d.tdiv g).natAbs : Int) ∧ ((d.tdiv g).natAbs : Int) ≤ IntTy.u64.max := by
      have h1 := fits_between dJ (tdiv_between dJ.val g hg_pos)
      have h2 : 0 ≤ d.tdiv g := (tdiv_between d g hg_pos).1 hd_nn |>.1
      rw [hdJ_v] at h1
      rw [Int.natAbs_of_nonneg h2]
      exact h1
    have hconv : (IntTy.u64.min ≤ (if !IntTy.u64.signed then ((n.tdiv g).natAbs : Int) else n.tdiv g) ∧
        (if !IntTy.u64.signed then ((n.tdiv g).natAbs : Int) else n.tdiv g) ≤ IntTy.u64.max) ∧
        (IntTy.u64.min ≤ (if !IntTy.u64.signed then ((d.tdiv g).natAbs : Int) else d.tdiv g) ∧
        (if !IntTy.u64.signed then ((d.tdiv g).natAbs : Int) else d.tdiv g) ≤ IntTy.u64.max) :=
      ⟨hr1_fit, hr2_fit⟩
    obtain ⟨q, hq_ok, hq_norm, hq_cross, hq_den_pos, _⟩ :=
      (hc.2.2.2 hg_nz hnot_negU hconv).1 (fun hlt => absurd hlt (Int.not_lt.mpr (Int.natCast_nonneg _)))
    unfold exactDivideIntsSource
    rw [hq_ok]
    exact ⟨q, io2, rfl, hq_norm, hq_cross, hq_den_pos, hptr2_eq, hdata2_eq⟩
  · have hg0 : Nat.gcd n.natAbs d.natAbs = 0 := by
      rw [hn0, hd0, Int.natAbs_zero, Nat.gcd_zero_left]
    obtain ⟨msg, herr⟩ := hc.1 hg0
    unfold exactDivideIntsSource
    rw [herr]
    exact ⟨io2, msg, rfl, hptr2_eq⟩

theorem binary_read_proven : binary_read := @binary_read_aux

end Round4


namespace Round5
open JuliaLean JuliaLean.Promotion JuliaLean.base.rational
set_option maxRecDepth 4096
open JuliaLean JuliaLean.Promotion JuliaLean.base.rational
set_option maxRecDepth 4096
def sourceMode : Rounding → JuliaLean.base.float.RoundingMode
  | .toZero => .ToZero | .down => .Down | .up => .Up | .fromZero => .FromZero
  | .nearest => .Nearest | .nearestAway => .NearestTiesAway | .nearestUp => .NearestTiesUp
def rounded (a b : Int) (mode : Rounding) : Int :=
  let q := a.tdiv b
  let r := a.tmod b
  let step := if (a < 0) ≠ (b < 0) then -1 else 1
  let away := q + step
  match mode with
  | .toZero => q
  | .down => a.fdiv b
  | .up => -((-a).fdiv b)
  | .fromZero => if r = 0 then q else away
  | .nearest | .nearestAway | .nearestUp =>
    if 2 * r.natAbs < b.natAbs then q
    else if 2 * r.natAbs > b.natAbs then away
    else if mode = .nearestAway then away
    else if mode = .nearestUp then if step < 0 then q else away
    else if q % 2 = 0 then q else away
def IsOverflow {T : Type} (run : Jl T) : Prop :=
  ∃ message, run = .error (.overflowError message)
def IsInexact {T : Type} (run : Jl T) : Prop :=
  ∃ message, run = .error (.inexactError message)
def IsArgument {T : Type} (run : Jl T) : Prop :=
  ∃ message, run = .error (.argumentError message)
inductive IntegerParameters : Type → Type where
  | bits (t : IntTy) : IntegerParameters (JInt t)
namespace IntegerParameters
def ops {T : Type} : IntegerParameters T → RatIntOps T
  | .bits t => { jintOps t with
      divToZero := JuliaLean.base.div.divBitIntegerToZero
      fld := JuliaLean.base.div.divBitIntegerDown
      cld := JuliaLean.base.div.divBitIntegerUp
      divRound := fun a b r => JuliaLean.base.div.divBitIntegerMode a b (sourceMode r)
      rem := JuliaLean.base.int.remSame
      mod := if t.signed then JuliaLean.base.int.mod_BitSigned JuliaLean.base.div.fldBitInteger else JuliaLean.base.int.mod_Unsigned }
def fits {T : Type} : IntegerParameters T → Int → Prop
  | .bits t => fun n => t.min ≤ n ∧ n ≤ t.max
def wrap {T : Type} : IntegerParameters T → Int → Int
  | .bits t => wrapInt t
end IntegerParameters
abbrev unsignedDivide : JuliaLean.base.int.BinOpJl := fun x y =>
  let (a,b) := JuliaLean.base.int.promoteSameSign x y
  JuliaLean.base.int.divSame a b
def divideByUnsigned {t u : IntTy} (x : JInt t) (g : Jl (JInt u)) : Jl (JInt t) := do
  let g ← g
  if t.signed then
    let q ← JuliaLean.base.int.div_BitSigned_Unsigned unsignedDivide x g
    JInt.convert (t.name) t q.val
  else
    let q ← unsignedDivide x g
    JInt.convert (t.name) t q.val
abbrev val {T : Type} (i : IntegerParameters T) := i.ops.toInt
abbrev rn {T : Type} (i : IntegerParameters T) (q : Rational T) := val i q.num
abbrev rd {T : Type} (i : IntegerParameters T) (q : Rational T) := val i q.den
def Canonical {T : Type} (i : IntegerParameters T) (q : Rational T) : Prop :=
  0 ≤ rd i q ∧ Nat.gcd (rn i q).natAbs (rd i q).natAbs = 1
def Represents {T : Type} (i : IntegerParameters T) (q : Rational T) (n d : Int) : Prop :=
  Canonical i q ∧ rn i q * d = n * rd i q ∧
  (d ≠ 0 → rd i q > 0) ∧ (d = 0 → rd i q = 0 ∧ intSign (rn i q) = intSign n)
def dg {T U : Type} (i : IntegerParameters T) (j : IntegerParameters U) : T → U → Jl (T × U) :=
  match i,j with
  | .bits t,.bits s => divgcdSource JuliaLean.base.float.uabs JuliaLean.base.float.uabs
      (fun a b => let (a,b) := JuliaLean.base.int.promoteSameSign a b
                  JuliaLean.base.intfuncs.gcd_BitInteger a b)
      divideByUnsigned divideByUnsigned
def rational {T : Type} (i : IntegerParameters T) : T → T → Jl (Rational T) :=
  match i with
  | .bits t => rationalSameSource (jintOps t) JuliaLean.base.float.uabs
      (dg (.bits t.toUnsigned) (.bits t.toUnsigned)) (fun x => JInt.convert (t.name) t x.val)
      (dg (.bits t) (.bits t)) Prod.mk
abbrev convertRat {T U : Type} (i : IntegerParameters T) (j : IntegerParameters U) :=
  convertRatSource T (fun x => i.ops.fromInt (val j x))
def neg {T : Type} : (i : IntegerParameters T) → Rational T → Jl (Rational T)
  | .bits t, q => if h : t.signed = true then negBitSignedSource h q
      else negUnsignedSource (JInt.lit t 0) (fun a b => !(JuliaLean.base.int.eq a b)) q
def integerEq {T U : Type} (i : IntegerParameters T) (j : IntegerParameters U) : T → U → Bool :=
  match i,j with | .bits _,.bits _ => JuliaLean.base.int.eq
abbrev eqR {T U : Type} (i : IntegerParameters T) (j : IntegerParameters U) :=
  eqRatSource (integerEq i j) (integerEq i j)
inductive PromotionParameters : {T U P : Type} → IntegerParameters T → IntegerParameters U → IntegerParameters P → Type 1 where
  | same {T : Type} (i : IntegerParameters T) : PromotionParameters i i i
  | bits (t s : IntTy) : PromotionParameters (.bits t) (.bits s) (.bits (t.promote s))
def PromotionParameters.prom {T U P : Type} {i : IntegerParameters T} {j : IntegerParameters U}
    {p : IntegerParameters P} : PromotionParameters i j p → RatPromoteOps T U P
  | .same i => samePromoteOps i.ops
  | .bits t s => { jintPromoteOps t s with
      opsX := IntegerParameters.ops (.bits t)
      opsY := IntegerParameters.ops (.bits s)
      opsP := IntegerParameters.ops (.bits (t.promote s)) }
abbrev promoteR {T U P : Type} {i : IntegerParameters T} {j : IntegerParameters U}
    {p : IntegerParameters P} (_m : PromotionParameters i j p)
    (x : Rational T) (y : Rational U) : Jl (Rational P × Rational P) := do
  let xp ← convertRat p i x
  let yp ← convertRat p j y
  pure (xp,yp)
abbrev add {T U P : Type} {i : IntegerParameters T} {j : IntegerParameters U}
    {p : IntegerParameters P} (m : PromotionParameters i j p) :=
  addRatSource m.prom (promoteR m) (fun x => decide (rd i x = 0)) (eqR i j)
    (dg p p) (rational p)
abbrev sub {T U P : Type} {i : IntegerParameters T} {j : IntegerParameters U}
    {p : IntegerParameters P} (m : PromotionParameters i j p) :=
  subRatSource m.prom (promoteR m) (fun x => decide (rd i x = 0)) (neg j) (eqR i j)
    (dg p p) (rational p)
def Converts {T U P : Type} (i : IntegerParameters T) (j : IntegerParameters U)
    (p : IntegerParameters P) (x : Rational T) (y : Rational U) : Prop :=
  p.fits (rn i x) ∧ p.fits (rd i x) ∧ p.fits (rn j y) ∧ p.fits (rd j y)
def ExactResult {T : Type} (i : IntegerParameters T) (run : Jl (Rational T))
    (n d : Int) : Prop := ∃ q, run = .ok q ∧ Represents i q n d
def FitsPair {T : Type} (i : IntegerParameters T) (n d : Int) : Prop :=
  i.fits n ∧ i.fits d
def reduced (n d : Int) : Int × Int :=
  let g : Int := Nat.gcd n.natAbs d.natAbs
  (n.tdiv g, d.tdiv g)
def ConstructorContract {T : Type} (i : IntegerParameters T)
    (run : Jl (Rational T)) (n d : Int) : Prop :=
  let g := Nat.gcd n.natAbs d.natAbs
  let a := if i.ops.isUnsignedOrBool then ((reduced n d).1.natAbs : Int) else (reduced n d).1
  let b := if i.ops.isUnsignedOrBool then ((reduced n d).2.natAbs : Int) else (reduced n d).2
  let negativeUnsigned := i.ops.isUnsignedOrBool = true ∧ n ≠ 0 ∧ ((n < 0) ≠ (d < 0))
  let converted := FitsPair i a b
  let normalized := b < 0 → FitsPair i (-a) (-b)
  (g = 0 → IsArgument run) ∧
  (g ≠ 0 → negativeUnsigned → IsInexact run) ∧
  (g ≠ 0 → ¬ negativeUnsigned → ¬ converted → IsInexact run) ∧
  (g ≠ 0 → ¬ negativeUnsigned → converted →
    (normalized → ExactResult i run n d) ∧ (¬ normalized → IsOverflow run))
