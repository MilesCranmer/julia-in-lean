/-- All permitted exception classes on normalized native rational inputs. -/
def ComplexRationalDivisionError {A : Type} (run : Jl A) : Prop :=
  run = .error .divideError ∨
    (∃ message, run = .error (.inexactError message)) ∨
    (∃ message, run = .error (.overflowError message))

/-- Full normalized native input-domain contract for public source137.
Every checked-stage-safe input must succeed with the independent exact complex
value. Every failure of a stage condition must return an actual arithmetic
exception. Every successful result satisfies the value contract. Conjugation
and magnitude overflow are additionally required to occur before any later
mixed-type promotion errors. Inputs are never restricted to successful or
representable intermediate calculations.

The contract deliberately permits overflow despite a representable final
quotient: Int8 1//(12+0im) checks 12*12 before division. This is preserved
intermediate behavior, not a claimed Julia bug.
Sources: base/rational.jl:106-140,402-422,482-486; base/complex.jl:280-282,345. -/
def RationalComplexDivisionCorrect : Prop :=
  ∀ (t s : IntTy) (x : Rat t) (y : JuliaLean.base.complex.Complex (Rat s)),
    Normalized x → Normalized y.re → Normalized y.im →
      let run := rationalComplexQuotient x y
      let fits := ComplexRationalDivisionStagesFit x y
      (fits → ∃ q, run = .ok q ∧ ComplexRationalQuotientValue x y q) ∧
      (¬ fits → ComplexRationalDivisionError run) ∧
      (∀ q, run = .ok q → ComplexRationalQuotientValue x y q) ∧
      (((y.re.den.val ≠ 0 ∧ y.im.den.val ≠ 0 ∧
          ¬ ComplexRationalFits s (-y.im.num.val)) ∨
        ¬ ComplexRationalMagnitudeFits s
          (y.re.num.val, y.re.den.val) (y.im.num.val, y.im.den.val)) →
        ∃ message, run = .error (.overflowError message))

