import JuliaLean.base.abstractarray

namespace JuliaLean.AbstractArraySpecs

/-- Well-formed axis: a `OneTo` starts at 1, lengths are nonnegative (Julia's
`UnitRange` constructor normalises `stop`) and representable as `Int`. -/
def Ax.WF (r : Ax) : Prop :=
  (r.kind = .oneTo → r.lo.val = 1) ∧ 0 ≤ r.len ∧ r.len ≤ tmax

/-- Well-formed array: axes are well formed, the element count is the product of
the axis lengths, and that count is an `Int` (as `length` returns). -/
def Arr.WF {α : Type} (A : Arr α) : Prop :=
  (∀ r ∈ A.axes, r.WF) ∧ (A.data.length : Int) = totalLen A.axes ∧ totalLen A.axes ≤ tmax

instance (r : Ax) : Decidable r.WF := by unfold Ax.WF; infer_instance
instance {α : Type} [DecidableEq α] (A : Arr α) : Decidable A.WF := by unfold Arr.WF; infer_instance

instance {ε α : Type} [DecidableEq ε] [DecidableEq α] : DecidableEq (Except ε α)
  | .ok a, .ok b => if h : a = b then isTrue (h ▸ rfl) else isFalse (fun e => by cases e; exact h rfl)
  | .error a, .error b => if h : a = b then isTrue (h ▸ rfl) else isFalse (fun e => by cases e; exact h rfl)
  | .ok _, .error _ => isFalse (fun e => by cases e)
  | .error _, .ok _ => isFalse (fun e => by cases e)

end JuliaLean.AbstractArraySpecs

namespace JuliaLean.MemSafety.G3

open JuliaLean

/-- Membership in an axis of `len` elements beginning at `first`. -/
def inAxis (first : Int) (len : Nat) (i : Int) : Prop :=
  first ≤ i ∧ i < first + len

/-- Membership in a one-based array of length `len`. -/
def inOneBased (len i : Nat) : Prop := 1 ≤ i ∧ i ≤ len

/-- The indices generated by Julia's `for i = 1:n` loops. -/
def oneBasedLoop (n : Nat) : List Nat :=
  (List.range n).map Nat.succ

/-- An `IndexLinear` array with its representable `Int` axis invariant. -/
structure LinearArray (α : Type) where
  first : Int
  values : List α
  firstFits : IntTy.min .i64 ≤ first
  lastFits : first + values.length - 1 ≤ IntTy.max .i64

def linearArrayIndices (a : LinearArray α) : List Int :=
  (List.range a.values.length).map fun (k : Nat) => a.first + (k : Int)

/-- Pointer widths supported by Julia platforms. -/
inductive SupportedPointerWidth where
  | bits32
  | bits64
  deriving DecidableEq

def pointerBytes : SupportedPointerWidth → Nat
  | .bits32 => 4
  | .bits64 => 8

end JuliaLean.MemSafety.G3
