  have hh : h.isfinite = true ∧ h.signbit = false := by
    by_cases hz : s.iszero = true
    · simpa only [h, early_sqrt_zero s hz] using And.intro hs hss
    · have hp := early_sqrt_finite_positive s hs (Bool.eq_false_iff.mpr hz) hss
      exact ⟨hp.1, hp.2.1⟩
  have hu : h.key ≤ H.key := root_sqrt64_maximum s hs hss
  have hsq : H.key * H.key ≤ M.key * FTy.f64.fmt.den := by decide
  have hsqh := Int.le_trans (early_square_le_square h.key H.key
    ((JuliaLean.Proofs.base.math.mfKeySign h).2 hh.2) hu) hsq
  exact early_square_upper_with_round M h hh.1 hsqh (fun n j hn hk =>
    generic_round64_le_normal n j M hn (by decide) (by decide) (by decide) hk)

