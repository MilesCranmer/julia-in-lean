    have hzn : fisnan z = true := by
      rw [hypot_fisnan_eq, JuliaLean.Proofs.base.float.TruncProofs.isnan_iff_mag]
      rw [hypot_fisnan_eq, JuliaLean.Proofs.base.float.TruncProofs.isnan_iff_mag] at hwn
      simp only [Bool.false_eq_true, ↓reduceIte] at hwle
      omega
    refine ⟨m, hypot_native_max_reduction T x xs, ?_⟩
