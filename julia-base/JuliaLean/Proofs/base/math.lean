theorem generic_native_flip_metadata {T : JuliaLean.base.float.FTy} (v x : JuliaLean.base.float.FV T)
    (hv : v.isfinite = true) :
    (nativeNearestFlipSign T v x).isfinite = true ∧
    (nativeNearestFlipSign T v x).key = (if x.signbit then -v.key else v.key) ∧
    (nativeNearestFlipSign T v x).iszero = v.iszero ∧
    (nativeNearestFlipSign T v x).signbit = (v.signbit ^^ x.signbit) := by
  rw [generic_native_flipsign v x hv]
  cases hs : x.signbit
  · simp only [Bool.false_eq_true, ↓reduceIte, Bool.xor_false, hv, and_self]
  · simp only [↓reduceIte, Bool.xor_true]
    obtain ⟨hm, hsg⟩ := fl_neg_parts v
    refine ⟨?_, ?_, ?_, hsg⟩
    · rw [TruncProofs.isfinite_iff_mag, hm]
      exact (TruncProofs.isfinite_iff_mag v).mp hv
    · simp only [Fl.key, hm, hsg]
      cases v.signbit <;> simp only [Bool.not_false, Bool.not_true, Bool.false_eq_true, ↓reduceIte, Int.neg_neg]
    · simp only [Fl.iszero, hm]

theorem generic_abs_sign_all {T : JuliaLean.base.float.FTy} (x : JuliaLean.base.float.FV T) :
    (fabs x).signbit = false := by
