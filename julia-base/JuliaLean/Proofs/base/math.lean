    (by decide) (by decide) (by decide)
    (by rw [hd.2, h2s.2]; omega) (by rw [hd.2, h2s.2]; omega)
  have c2lo : 5 * Amax.key ≤ 4 * C2.key := by decide
  have c2hi : Amax.key ≤ 2 * C2.key := by decide
  have hc2 := generic_sub64_abs_bound (mul (Fl.ofInt 2) delta) a C2 h2δ.1 ha.1
    (by decide) (by decide) (by decide)
    (by rw [h2δ.2, hd.2]; omega) (by rw [h2δ.2, hd.2]; omega)
  have haabs : (a.key.natAbs : Int) ≤ Amax.key := by rw [Int.natAbs_of_nonneg a0]; exact haB
