/-- Midpoint-square containment and bounded neighbor gaps control the
square of a rounded root by an exact symmetric error interval. -/
theorem generic_sqrt_cell_error_algebra (r b a q M G E : Int)
    (hr0 : 0 ≤ r) (hb0 : 0 ≤ b) (hrM : r ≤ M) (hG : 0 ≤ G)
    (hbgap : 0 ≤ r - b ∧ r - b ≤ G) (hagap : 0 ≤ a - r ∧ a - r ≤ G)
    (hlo : (r + b) ^ 2 ≤ 4 * q) (hhi : 4 * q ≤ (r + a) ^ 2)
    (hcap : G * (4 * M + G) ≤ 4 * E) :
    ((r * r - q).natAbs : Int) ≤ E := by
  have hlow : (r - b) * (3 * r + b) ≤ 4 * E := by
    calc
      _ ≤ G * (3 * r + b) := Int.mul_le_mul_of_nonneg_right hbgap.2 (by omega)
      _ ≤ G * (4 * M + G) := Int.mul_le_mul_of_nonneg_left (by omega) hG
      _ ≤ _ := hcap
  have hupp : (a - r) * (a + 3 * r) ≤ 4 * E := by
    calc
      _ ≤ G * (a + 3 * r) := Int.mul_le_mul_of_nonneg_right hagap.2 (by omega)
      _ ≤ G * (4 * M + G) := Int.mul_le_mul_of_nonneg_left (by omega) hG
      _ ≤ _ := hcap
  have hlf := generic_sqrt_lower_difference_factor r b
  have huf := generic_sqrt_upper_difference_factor r a
  simp only [Int.pow_succ, Int.pow_zero, Int.one_mul] at hlf huf hlo hhi
