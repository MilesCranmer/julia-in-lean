    (early_bound2 511).key C3.key Z2.key hb.1 hc3.1 hz2.1 hbabs hc3.2 hz2.2
    (by decide) (by decide) (by decide) (by decide)
  exact (early_fma_abs_upper delta delta
    (JuliaLean.base.float.muladd_IEEEFloat b (sub (mul (Fl.ofInt 4) delta) b)
      (mul (mul (Fl.ofInt 2) delta) (sub a (mul (Fl.ofInt 2) b)))) N
    D2.key D2.key I.key hd.1 hd.1 hi.1 hδabs hδabs hi.2
    (by decide) (by decide) (by decide) (by decide)).1


