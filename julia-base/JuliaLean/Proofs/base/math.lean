namespace JuliaLean.ChatGPT.Batch4.Group9
open JuliaLean JuliaLean.C JuliaLean.base.float JuliaLean.base.math
open JuliaLean.Promotion (Fl)
open JuliaLean.Proofs.base.float
set_option maxRecDepth 8192
set_option exponentiation.threshold 8192
set_option maxHeartbeats 2000000

theorem early_box_from_positive (e : Nat) (x : FV .f64) (hx : x.isfinite = true)
    (hs : x.signbit = false) (hk : x.key ≤ (early_bound2 e).key) : early_box e x := by
  refine ⟨hx, ?_⟩
  rw [Int.natAbs_of_nonneg ((JuliaLean.Proofs.base.math.mfKeySign x).2 hs)]
  exact hk

theorem early_box_from_mag (e : Nat) (x : FV .f64) (hx : x.isfinite = true)
    (hs : x.signbit = false) (he : e ≤ 1023) (hm : x.magnitude ≤ (early_bound2 e).magnitude) :
    early_box e x :=
  early_box_from_positive e x hx hs
    (generic_positive_key_mono x _ hs (early_bound2_fields e he).2.1 hm)

theorem early_bound2_square (e : Nat) (he : e ≤ 1023) (h2e : 2 * e ≤ 1023) :
    (early_bound2 e).key ^ 2 = (early_bound2 (2 * e)).key * FTy.f64.fmt.den := by
  rw [(early_bound2_fields e he).2.2.2, (early_bound2_fields (2 * e) h2e).2.2.2]
  simp only [Int.pow_succ, Int.pow_zero, Int.one_mul]
  change ((2 ^ (e + 1074) : Nat) : Int) * ((2 ^ (e + 1074) : Nat) : Int) =
    ((2 ^ (2 * e + 1074) : Nat) : Int) * ((2 ^ 1074 : Nat) : Int)
  rw [← Int.natCast_mul, ← Int.natCast_mul, ← Nat.pow_add, ← Nat.pow_add]
  congr 2
  omega

/-- Two nonnegative operands bounded by2^E have a finite initial root bounded
by2^(E+1), provided the coarse square-sum bound remains normal and finite. -/
theorem early_hypot_root_box (E : Nat) (a b : FV .f64)
    (ha : early_box E a) (hb : early_box E b)
    (_hsa : a.signbit = false) (_hsb : b.signbit = false)
    (hE : 2 * E + 2 ≤ 1023) :
    early_box (E + 1) (jlSqrtLlvm (JuliaLean.base.float.muladd_IEEEFloat a a (mul b b))) := by
  have hbsq := early_box_mul E E (2 * E) b b hb hb (by omega)
    (by apply early_bound2_mul_cap <;> omega)
  have hsum := early_box_muladd E E (2 * E) (2 * E + 1) a a (mul b b) ha ha hbsq
    (by omega) (by apply early_bound2_fma_cap <;> omega)
  let s := JuliaLean.base.float.muladd_IEEEFloat a a (mul b b)
  have hss : s.signbit = false := by
    have hn := early_hypot_muladd_squares_nonnegnan (by decide : 32 ≤ FTy.f64.fmt.width) a b
    rcases hn with hn | hn
    · exact hn
    · have hnot := Fl.isnan_of_finite hsum.1
      rw [hn] at hnot
      cases hnot
  have hroot : (jlSqrtLlvm s).isfinite = true ∧ (jlSqrtLlvm s).signbit = false := by
    by_cases hz : s.iszero = true
    · simpa only [early_sqrt_zero s hz] using And.intro hsum.1 hss
    · have hh := early_sqrt_finite_positive s hsum.1 (Bool.eq_false_iff.mpr hz) hss
      exact ⟨hh.1, hh.2.1⟩
  have hu := early_bound2_fields (E + 1) (by omega)
  have hsk := (early_abs_interval s.key _ hsum.2).2
  have hbnd : s.key * FTy.f64.fmt.den ≤ (early_bound2 (E + 1)).key ^ 2 := by
    rw [early_bound2_square (E + 1) (by omega) (by omega)]
    apply Int.mul_le_mul_of_nonneg_right _ (Int.natCast_nonneg _)
    exact Int.le_trans hsk (early_bound2_mono (2 * E + 1) (2 * (E + 1)) (by omega) (by omega) (by omega))
  have hupper := root_sqrt_upper_bound s (early_bound2 (E + 1)) hsum.1 hss hu.1
    ((JuliaLean.Proofs.base.math.mfKeySign _).2 hu.2.1) hbnd
  exact early_box_from_positive (E + 1) _ hroot.1 hroot.2 hupper

/-- A representable positive lower bound whose square is normal also bounds
the initial root whenever it bounds the first operand. -/
theorem early_hypot_root_lower_from_operand (a z R L : FV .f64)
    (ha : a.isfinite = true) (hz : z.isfinite = true) (hzs : z.signbit = false)
    (hR : R.isfinite = true) (hR0 : 0 ≤ R.key)
    (hL : L.isfinite = true) (hLs : L.signbit = false) (hLE : 1 ≤ L.expField)
    (hRa : R.key ≤ a.key) (hsquare : R.key ^ 2 = L.key * FTy.f64.fmt.den)
    (hs : (JuliaLean.base.float.muladd_IEEEFloat a a z).isfinite = true)
    (hss : (JuliaLean.base.float.muladd_IEEEFloat a a z).signbit = false) :
    R.key ≤ (jlSqrtLlvm (JuliaLean.base.float.muladd_IEEEFloat a a z)).key := by
  have hsq := early_square_le_square R.key a.key hR0 hRa
  have hRsq : R.key * R.key = L.key * FTy.f64.fmt.den := by
    simpa only [Int.pow_succ, Int.pow_zero, Int.one_mul] using hsquare
  rw [hRsq] at hsq
  have hz0 := (JuliaLean.Proofs.base.math.mfKeySign z).2 hzs
  have hzd := Int.mul_nonneg hz0 (Int.natCast_nonneg FTy.f64.fmt.den)
  have hslow := early_fused_square_lower_bound L a z hL hLs hLE ha hz hzs (by omega)
  apply root_sqrt_lower_bound _ R hs hss hR hR0
  rw [hsquare]
  exact Int.mul_le_mul_of_nonneg_right hslow (Int.natCast_nonneg _)

/-- The large-input branch actually keeps its first scaled operand above
2^-52, a much stronger lower bound than the uniform2^-511 bound. -/
theorem early_hypot_scale_down_lower_strong (a : FV .f64) (ha : a.isfinite = true)
    (hs : a.signbit = false)
    (hlarge : flt (Fl.ofBits 0x5fe6a09e667f3bcc) a = true) :
    (Fl.ofBits 0x3cb0000000000000 : FV .f64).key ≤ (mul a (Fl.ofBits 0x1cc0000000000000)).key := by
  have hBf : (Fl.ofBits 0x5fe6a09e667f3bcc : FV .f64).isfinite = true := by decide
  have hBs : (Fl.ofBits 0x5fe6a09e667f3bcc : FV .f64).signbit = false := by decide
  have hlt : (Fl.ofBits 0x5fe6a09e667f3bcc : FV .f64).key < a.key := by
    change Fl.lt _ _ = true at hlarge
    rw [Fl.lt_key (Fl.isnan_of_finite hBf) (Fl.isnan_of_finite ha)] at hlarge
    exact of_decide_eq_true hlarge
  have hm : (Fl.ofBits 0x5fe6a09e667f3bcc : FV .f64).magnitude < a.magnitude := by
    apply Classical.byContradiction
    intro h
    have hk := generic_positive_key_mono a _ hs hBs (by omega)
    omega
  have hE : 1534 ≤ a.expField := by
    have hmag := (TruncProofs.mag_decomp a).1
    have hfr := (TruncProofs.mag_decomp a).2
    change 0x5fe6a09e667f3bcc < a.magnitude at hm
    change a.magnitude = a.expField * 2 ^ 52 + a.frac at hmag
    change a.frac < 2 ^ 52 at hfr
    omega
  have hfr := (TruncProofs.mag_decomp a).2
  have hEmax := RemainderProofs.finite_exp_lt a ha
  have hp := Fl.pack_parts (f := FTy.f64.fmt) a.signbit (a.expField - 563) a.frac
    (by change _ < 2048; change a.expField < 2047 at hEmax; omega) hfr
  change _ ≤ (mul a hypot_scale_down).key
  rw [hypot_scale_down_normal a ha (by omega)]
  apply generic_positive_key_mono _ _ (by decide) (by simpa only [hs] using hp.1)
  rw [hp.2.2.2]
