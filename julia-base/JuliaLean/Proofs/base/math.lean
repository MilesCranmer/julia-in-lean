        (hypotDispatchFloat64 JuliaLean.base.reduce.mapreduce JuliaLean.base.reduce.maximum_f (JuliaLean.Bindings.base.math.ieeeOps machine .f64)
          (JuliaLean.Bindings.base.math.reduceOps .f64)) x y := by
  unfold MathHypotPair hypotTwo
  simp only [JuliaLean.Bindings.base.math.promotePair_eq, hypot_mathFloat_identity,
    bind, Except.bind, JuliaLean.Bindings.base.math.hypotDispatch, id]

/-- Native binary64 sign equality.  The full native target additionally
requires successful return and the Float16/Float32 dispatches. -/
theorem hypot_native64_sign_equal
    (machine : JuliaLean.Bindings.base.math.Machine)
    (x y : JuliaLean.base.float.FV .f64)
    (hx : fisfinite x = true) (hy : fisfinite y = true) :
    MathHypotPair machine .f64 x y = MathHypotPair machine .f64 (fneg x) y ∧
    MathHypotPair machine .f64 x y = MathHypotPair machine .f64 x (fneg y) := by
  rw [hypot_native_pair64_eq, hypot_native_pair64_eq, hypot_native_pair64_eq]
  exact JuliaLean.Proofs.base.math.hypotSignInvariant64_proven
    (JuliaLean.Bindings.base.math.ieeeOps machine .f64)
    (JuliaLean.Bindings.base.math.reduceOps .f64) (fun a b => (a, b)) id
    (by intro a b; rfl) (by intro a; rfl) x y hx hy

/-- Native operations on a machine with hardware FMA agree with the concrete
operations of the subnormal counterexample in every field used by `hypot`. -/
theorem hypot_native_ops_hardware
    (machine : JuliaLean.Bindings.base.math.Machine)
    (hf : JuliaLean.Bindings.base.math.haveFma machine .f64 = true) :
    hypotOpsOfIEEE (JuliaLean.Bindings.base.math.ieeeOps machine .f64) =
      hypotOpsOfIEEE hypot_counterexample_ops := by
  have hfma : (JuliaLean.Bindings.base.math.fmaIEEE machine :
      JuliaLean.base.float.FV .f64 → JuliaLean.base.float.FV .f64 →
      JuliaLean.base.float.FV .f64 → JuliaLean.base.float.FV .f64) =
        JuliaLean.C.jlFmaFloat := by
    funext x y z
    simp only [JuliaLean.Bindings.base.math.fmaIEEE,
      JuliaLean.base.floatfuncs.fma_IEEEFloat,
      JuliaLean.Bindings.base.math.floatFmaOps, hf, ↓reduceIte]
  simp only [hypotOpsOfIEEE, JuliaLean.Bindings.base.math.ieeeOps,
    JuliaLean.Bindings.base.math.ieeeOpsWith, hypot_counterexample_ops, hfma, hf]
  rfl

theorem hypot_native_pair_hardware
    (machine : JuliaLean.Bindings.base.math.Machine)
    (hf : JuliaLean.Bindings.base.math.haveFma machine .f64 = true)
    (x y : JuliaLean.base.float.FV .f64) :
    MathHypotPair machine .f64 x y =
      hypotGeneric (hypotOpsOfIEEE hypot_counterexample_ops)
        (hypotOpsOfIEEE hypot_counterexample_ops).abs x y := by
  unfold MathHypotPair hypotTwo
  simp only [JuliaLean.Bindings.base.math.promotePair_eq, hypot_mathFloat_identity,
    bind, Except.bind, JuliaLean.Bindings.base.math.hypotDispatch, hypotDispatchFloat64,
    hypot_native_ops_hardware machine hf]

theorem hypot_native_rounding_run
    (machine : JuliaLean.Bindings.base.math.Machine)
    (hf : JuliaLean.Bindings.base.math.haveFma machine .f64 = true) :
    MathHypotPair machine .f64 hypot_counterexample_x hypot_counterexample_y =
      .ok hypot_counterexample_result := by
  rw [hypot_native_pair_hardware machine hf]
  exact hypot_counterexample_run

set_option maxRecDepth 4096 in
set_option exponentiation.threshold 1200 in
set_option maxHeartbeats 10000000 in
theorem hypot_native_counterexample_below_overflow :
    QLT (HypotSquared64 hypot_counterexample_x hypot_counterexample_y)
      (QMul MathHypotOverflowMidpoint64 MathHypotOverflowMidpoint64) = true := by
  decide

set_option maxRecDepth 4096 in
/-- A usable obstruction with the actual hardware premise.  Instantiating a
complete `Machine` still requires an independent certified pi primitive. -/
theorem hypot_native_rounding_obstruction
    (machine : JuliaLean.Bindings.base.math.Machine)
    (hf : JuliaLean.Bindings.base.math.haveFma machine .f64 = true) :
    ¬ JuliaLean.Proofs.base.math.Archive20261102Round7.HypotCorrectlyRoundedNative64 := by
  intro h
  obtain ⟨result, hrun, hnearest⟩ :=
    h machine hypot_counterexample_x hypot_counterexample_y hf
      hypot_counterexample_x_finite hypot_counterexample_y_finite
  have heq : result = hypot_counterexample_result := by
    have hr := hypot_native_rounding_run machine hf
    rw [hr] at hrun
    exact Except.ok.inj hrun.symm
  rw [heq, hypot_native_counterexample_below_overflow] at hnearest
  exact hypot_counterexample_not_nearest hnearest.2


abbrev hypot_NanTy := JuliaLean.base.float.FTy
abbrev hypot_NanVal (T : hypot_NanTy) := JuliaLean.base.float.FV T

theorem hypot_fisnan_eq {T : hypot_NanTy} (x : hypot_NanVal T) :
    fisnan x = x.isnan := JuliaLean.Proofs.base.float.isnan_callee_eq x

theorem hypot_nan_notinf {T : hypot_NanTy} (x : hypot_NanVal T)
    (hx : fisnan x = true) : fisinf x = false := by
  rw [hypot_fisnan_eq] at hx
  change isinf_callee x = false
  have he : isinf_callee x = x.isinf := JuliaLean.Proofs.base.float.isinf_IEEEFloat_eq x
  rw [he]
  simp only [Fl.isnan, Bool.and_eq_true, beq_iff_eq, bne_iff_ne] at hx
  simp only [Fl.isinf, hx.1, beq_self_eq_true, beq_eq_false_iff_ne.mpr hx.2,
    Bool.true_and]

theorem hypot_abs_nan {T : hypot_NanTy} (x : hypot_NanVal T)
    (hx : fisnan x = true) : fisnan (fabs x) = true := by
  rw [hypot_fisnan_eq] at hx ⊢
  exact JuliaLean.Proofs.base.float.abs_preserves_nan x hx

theorem hypot_lt_nan_left {T : hypot_NanTy} (x y : hypot_NanVal T)
    (hx : fisnan x = true) : flt x y = false := by
  rw [hypot_fisnan_eq] at hx
  simp only [flt, lt_float, JuliaLean.C.jlLtFloat, Fl.lt, hx,
    Bool.true_or, ↓reduceIte]

theorem hypot_lt_nan_right {T : hypot_NanTy} (x y : hypot_NanVal T)
    (hy : fisnan y = true) : flt x y = false := by
  rw [hypot_fisnan_eq] at hy
  simp only [flt, lt_float, JuliaLean.C.jlLtFloat, Fl.lt, hy,
    Bool.or_true, Bool.true_or, ↓reduceIte]

theorem hypot_eq_inf_bits {T : hypot_NanTy} (x : hypot_NanVal T) :
    feq x (finf T) = (x.toBits == (finf T).toBits) := by
  have hn : (finf T).isnan = false := by cases T <;> decide
  have hz : (finf T).iszero = false := by cases T <;> decide
  by_cases hb : x.toBits = (finf T).toBits
  · have he : x = finf T := by
      rw [← Fl.ofBits_toBits x, hb, Fl.ofBits_toBits]
    subst x
    cases T <;> decide
  · simp only [feq, eq_float, JuliaLean.C.jlEqFloat, Fl.eq, hn, hz,
      beq_eq_false_iff_ne.mpr hb, Bool.and_false, Bool.or_false]

theorem hypot_abs_eq_inf_test {T : hypot_NanTy} (x : hypot_NanVal T) :
    feq (fabs x) (finf T) = fisinf x := by
  exact hypot_eq_inf_bits (fabs x)

theorem hypot_tuple_nan_of_reduction {T : hypot_NanTy} (o : IEEEOps T)
    (r : HypotFloatReductionOps T) (xs : List (hypot_NanVal T))
    (hr : HypotReductionExceptional r) (hn : xs.any fisnan = true)
    (hi : xs.any fisinf = false) :
    ∃ h, hypotTupleIEEE JuliaLean.base.reduce.mapreduce JuliaLean.base.reduce.maximum_f o r xs = .ok h ∧ fisnan h = true := by
  have htest : (xs.map fabs).any (fun x => feq x (finf T)) = xs.any fisinf := by
    simp only [List.any_map, Function.comp_def, hypot_abs_eq_inf_test]
  have hhas := hr.1 (fun x => feq x (finf T)) (xs.map fabs)
  rw [htest, hi] at hhas
  have hnabs : (xs.map fabs).any fisnan = true := by
    rcases List.any_eq_true.mp hn with ⟨x, hxmem, hxnan⟩
    exact List.any_eq_true.mpr ⟨fabs x, List.mem_map.mpr ⟨x, hxmem, rfl⟩,
      hypot_abs_nan x hxnan⟩
  obtain ⟨m, hmax, hmaxnan⟩ := hr.2 (xs.map fabs) hnabs
  have hlt := hypot_lt_nan_right (fzero T) (r.reinterpretFloat m) hmaxnan
  refine ⟨r.reinterpretFloat m, ?_, hmaxnan⟩
  simp only [hypotTupleIEEE, hhas, hmax, bind, Except.bind, hlt,
    Bool.false_eq_true, Bool.not_false, ↓reduceIte, pure, Except.pure]

theorem hypot_nan_mul {T : hypot_NanTy} (x y : hypot_NanVal T)
    (hn : fisnan x = true ∨ fisnan y = true) : fisnan (mul x y) = true := by
  simp only [hypot_fisnan_eq] at hn ⊢
  exact ((JuliaLean.Proofs.base.float.floatArithmeticAndNanPropagation_proven T x y x).2.1 hn).2.2.1

theorem hypot_nan_muladd {T : hypot_NanTy} (x y z : hypot_NanVal T)
    (hn : fisnan x = true ∨ fisnan y = true ∨ fisnan z = true) :
    fisnan (JuliaLean.base.float.muladd_IEEEFloat x y z) = true := by
  simp only [hypot_fisnan_eq] at hn ⊢
  exact (JuliaLean.Proofs.base.float.floatArithmeticAndNanPropagation_proven T x y z).2.2.1 hn

theorem hypot_convert_nan {S : hypot_NanTy} (T : hypot_NanTy)
    (x : hypot_NanVal S) (hx : fisnan x = true) :
    fisnan (Fl.convert x : hypot_NanVal T) = true := by
  rw [hypot_fisnan_eq] at hx ⊢
  exact JuliaLean.Proofs.base.float.FloatRoundDirections.convert_nan
    (JuliaLean.Proofs.base.float.good_fty T) x hx

theorem hypot_sqrtLlvm_nan {T : hypot_NanTy} (x : hypot_NanVal T)
    (hx : fisnan x = true) : fisnan (JuliaLean.C.jlSqrtLlvm x) = true := by
  rw [hypot_fisnan_eq] at hx ⊢
  let y := if T.fmt == half && x.isnan then JuliaLean.C.quietFloat x else x
  have hy : y.isnan = true := by
    dsimp only [y]
    split
    · exact JuliaLean.Proofs.base.float.quietFloat_isnan x hx
    · exact hx
  change (JuliaLean.C.finishFloat (JuliaLean.C.sqrtFloat y)).isnan = true
  rw [JuliaLean.Proofs.base.float.finishFloat_eq]
  simp only [JuliaLean.C.sqrtFloat, hy, ↓reduceIte]
  exact JuliaLean.Proofs.base.float.quietFloat_isnan y hy

theorem hypot_sqrt_nan {T : hypot_NanTy} (o : IEEEOps T)
    (hsqrt : ∀ x, o.sqrtLlvm x = JuliaLean.C.jlSqrtLlvm x)
    (x : hypot_NanVal T) (hx : fisnan x = true) :
    ∃ h, sqrtIEEE o x = .ok h ∧ fisnan h = true := by
  refine ⟨JuliaLean.C.jlSqrtLlvm x, ?_, hypot_sqrtLlvm_nan x hx⟩
  simp only [sqrtIEEE, hypot_lt_nan_left x (fzero T) hx, Bool.false_eq_true,
    ↓reduceIte, hsqrt]

theorem hypot16_nan (o : IEEEOps .f32)
    (hsqrt : ∀ x, o.sqrtLlvm x = JuliaLean.C.jlSqrtLlvm x)
    (x y : hypot_NanVal .f16) (hn : fisnan x = true ∨ fisnan y = true)
    (hxinf : fisinf x = false) (hyinf : fisinf y = false) :
    ∃ h, hypot16 o x y = .ok h ∧ fisnan h = true := by
  let x32 : hypot_NanVal .f32 := Fl.convert x
  let y32 : hypot_NanVal .f32 := Fl.convert y
  let sum := JuliaLean.base.float.muladd_IEEEFloat x32 x32 (mul y32 y32)
  have hsum : fisnan sum = true := by
    apply hypot_nan_muladd
    rcases hn with hx | hy
    · exact Or.inl (hypot_convert_nan .f32 x hx)
    · exact Or.inr (Or.inr (hypot_nan_mul y32 y32 (Or.inl (hypot_convert_nan .f32 y hy))))
  obtain ⟨r, hrun, hrnan⟩ := hypot_sqrt_nan o hsqrt sum hsum
  refine ⟨Fl.convert r, ?_, hypot_convert_nan .f16 r hrnan⟩
  simp only [hypot16, hxinf, hyinf, Bool.or_self, Bool.false_eq_true, ↓reduceIte]
  change (sqrtIEEE o sum >>= fun r => pure (Fl.convert r)) = .ok (Fl.convert r)
  rw [hrun]
  rfl

theorem hypot32_nan (o : IEEEOps .f64)
    (hsqrt : ∀ x, o.sqrtLlvm x = JuliaLean.C.jlSqrtLlvm x)
    (x y : hypot_NanVal .f32) (hn : fisnan x = true ∨ fisnan y = true)
    (hxinf : fisinf x = false) (hyinf : fisinf y = false) :
    ∃ h, hypot32 o x y = .ok h ∧ fisnan h = true := by
  let x64 : hypot_NanVal .f64 := Fl.convert x
  let y64 : hypot_NanVal .f64 := Fl.convert y
  let sum := JuliaLean.base.float.muladd_IEEEFloat x64 x64 (mul y64 y64)
  have hsum : fisnan sum = true := by
    apply hypot_nan_muladd
    rcases hn with hx | hy
    · exact Or.inl (hypot_convert_nan .f64 x hx)
    · exact Or.inr (Or.inr (hypot_nan_mul y64 y64 (Or.inl (hypot_convert_nan .f64 y hy))))
  obtain ⟨r, hrun, hrnan⟩ := hypot_sqrt_nan o hsqrt sum hsum
  refine ⟨Fl.convert r, ?_, hypot_convert_nan .f32 r hrnan⟩
  simp only [hypot32, hxinf, hyinf, Bool.or_self, Bool.false_eq_true, ↓reduceIte]
  change (sqrtIEEE o sum >>= fun r => pure (Fl.convert r)) = .ok (Fl.convert r)
  rw [hrun]
  rfl

theorem hypot_nan_sub {T : hypot_NanTy} (x y : hypot_NanVal T)
    (hn : fisnan x = true ∨ fisnan y = true) : fisnan (sub x y) = true := by
  simp only [hypot_fisnan_eq] at hn ⊢
  exact ((JuliaLean.Proofs.base.float.floatArithmeticAndNanPropagation_proven T x y x).2.1 hn).2.1

theorem hypot_nan_div {T : hypot_NanTy} (x y : hypot_NanVal T)
    (hn : fisnan x = true ∨ fisnan y = true) : fisnan (div x y) = true := by
  simp only [hypot_fisnan_eq] at hn ⊢
  exact ((JuliaLean.Proofs.base.float.floatArithmeticAndNanPropagation_proven T x y x).2.1 hn).2.2.2.1

theorem hypot_le_nan {T : hypot_NanTy} (x y : hypot_NanVal T)
    (hn : fisnan x = true ∨ fisnan y = true) : fle x y = false := by
  simp only [hypot_fisnan_eq] at hn
  rcases hn with hx | hy <;>
    simp only [fle, le_float, JuliaLean.C.jlLeFloat, Fl.le, Fl.lt, Fl.eq, *,
      Bool.true_or, Bool.or_true, Bool.false_and, Bool.and_false, Bool.not_true,
      ↓reduceIte, Bool.or_false]

theorem hypot_abs_finite {T : hypot_NanTy} (x : hypot_NanVal T)
    (hx : x.isfinite = true) : (fabs x).isfinite = true := by
  have hn := Fl.isnan_of_finite hx
  have hm := (JuliaLean.Proofs.base.float.floatArithmeticAndNanPropagation_proven T x x x).1 hn
  have hmag : (fabs x).magnitude = x.magnitude := hm.2.2.2.2.1
  rw [JuliaLean.Proofs.base.float.TruncProofs.isfinite_iff_mag] at hx ⊢
  rw [hmag]
  exact hx

theorem hypot_no_classes_finite {T : hypot_NanTy} (x : hypot_NanVal T)
    (hn : fisnan x = false) (hi : fisinf x = false) : x.isfinite = true := by
  rw [hypot_fisnan_eq] at hn
  have hief : fisinf x = x.isinf := JuliaLean.Proofs.base.float.isinf_IEEEFloat_eq x
  rw [hief] at hi
  simp only [Fl.isnan, Fl.isinf, Fl.isfinite] at hn hi ⊢
  cases he : x.expField == T.fmt.emax <;> simp only [he, Bool.false_and, Bool.true_and] at hn hi ⊢
  · exact bne_iff_ne.mpr (beq_eq_false_iff_ne.mp he)
  · have hfrac : x.frac = 0 := by simpa using hn
    simp only [hfrac, beq_self_eq_true] at hi
    cases hi

set_option maxRecDepth 4096 in
set_option exponentiation.threshold 2048 in
theorem hypot_div_one_finite {T : hypot_NanTy} (x : hypot_NanVal T)
    (hx : x.isfinite = true) : (div x (fone T)).isfinite = true := by
  have ho : (fone T).isfinite = true := by cases T <;> decide
  have hz : (fone T).iszero = false := by cases T <;> decide
  have hn : (fone T).toRat.1 = (2 ^ T.fmt.sb : Nat) := by cases T <;> decide
  have hd : (fone T).toRat.2 = 2 ^ T.fmt.sb := by cases T <;> decide
  have hp : ¬ ((2 ^ T.fmt.sb : Nat) : Int) < 0 := by omega
  obtain ⟨j, hj⟩ := mfToRatPow2 x hx
  have hscale := (Fl.toRat_key (JuliaLean.Proofs.base.float.good_fty T) x hx).2
  have hkey :
      (x.toRat.1 * ((2 ^ T.fmt.sb : Nat) : Int)) * (T.fmt.den : Int) =
        x.key * ((2 ^ (j + T.fmt.sb) : Nat) : Int) := by
    rw [Nat.pow_add, Int.natCast_mul]
    calc
      _ = (x.toRat.1 * (T.fmt.den : Int)) * ((2 ^ T.fmt.sb : Nat) : Int) := by
        simp only [Int.mul_assoc, Int.mul_comm]
      _ = _ := by rw [hscale, hj]; simp only [Int.mul_assoc]
  change (JuliaLean.base.float.div_float x (fone T)).isfinite = true
  rw [mfDivRat x (fone T) hx ho hz, hn, hd]
  simp only [hp, ↓reduceIte, Int.natAbs_natCast, hj, ← Nat.pow_add]
  exact (mfRoundKey T _ (j + T.fmt.sb) _ x.key hkey (mfValueRepr x hx)).1

theorem hypot_normalized_notinf {T : hypot_NanTy} (x : hypot_NanVal T)
    (hi : fisinf x = false) : fisinf (div (fabs x) (fone T)) = false := by
  by_cases hn : fisnan x = true
  · exact hypot_nan_notinf _ (hypot_nan_div _ _ (Or.inl (hypot_abs_nan x hn)))
  · have hnf : fisnan x = false := Bool.eq_false_iff.mpr hn
    have hfin := hypot_div_one_finite (fabs x)
      (hypot_abs_finite x (hypot_no_classes_finite x hnf hi))
    have he : fisinf (div (fabs x) (fone T)) = (div (fabs x) (fone T)).isinf :=
      JuliaLean.Proofs.base.float.isinf_IEEEFloat_eq _
    rw [he]
    exact Fl.isinf_of_finite hfin

/-- The correction-and-rescaling suffix of the frozen pair algorithm. -/
def hypot_finish {T : hypot_NanTy} (o : IEEEOps T)
    (ax ay scale h0 axu : hypot_NanVal T) : hypot_NanVal T :=
  let two : hypot_NanVal T := Fl.ofInt 2
  let four : hypot_NanVal T := Fl.ofInt 4
  let h :=
    if o.haveFma then
      let hsquared := mul h0 h0
      let axsquared := mul ax ax
      let correction := sub
        (add (o.fma (fneg ay) ay (sub hsquared axsquared))
          (o.fma h0 h0 (fneg hsquared)))
        (o.fma ax ax (fneg axsquared))
      sub h0 (div correction (mul two h0))
    else if fle h0 (mul two ay) then
      let delta := sub h0 ay
      sub h0 (div
        (o.muladd delta (sub delta (mul two (sub ax ay)))
          (mul ax (sub (mul two delta) ax)))
        (mul two h0))
    else
      let delta := sub h0 ax
      let inner := o.muladd ay
        (sub (mul four delta) ay)
        (mul (mul two delta) (sub ax (mul two ay)))
      sub h0 (div (o.muladd delta delta inner) (mul two h0))
  mul (mul h scale) (o.oneunit axu)

theorem hypot_finish_nan {T : hypot_NanTy} (o : IEEEOps T)
    (ax ay scale root axu : hypot_NanVal T) (hn : fisnan root = true) :
    fisnan (hypot_finish o ax ay scale root axu) = true := by
  unfold hypot_finish
  apply hypot_nan_mul
  left
  apply hypot_nan_mul
  left
  split
  · exact hypot_nan_sub _ _ (Or.inl hn)
  · split <;> exact hypot_nan_sub _ _ (Or.inl hn)

set_option maxRecDepth 4096 in
set_option exponentiation.threshold 2048 in
set_option maxHeartbeats 1000000 in
theorem hypot_constants_sqrt64 (o : IEEEOps .f64)
    (heps : o.eps = eps_float .f64)
    (hmin : o.floatmin = floatmin_float .f64)
    (hmax : o.floatmax = floatmax_float .f64) :
    ∃ cutoff minRoot bigRoot,
      sqrtIEEE o (div o.eps (Fl.ofInt 2)) = .ok cutoff ∧
      sqrtIEEE o o.floatmin = .ok minRoot ∧
      sqrtIEEE o (div o.floatmax (Fl.ofInt 2)) = .ok bigRoot := by
  have hc : flt (div (eps_float .f64) (Fl.ofInt 2)) (fzero .f64) = false := by decide
  have hm : flt (floatmin_float .f64) (fzero .f64) = false := by decide
  have hb : flt (div (floatmax_float .f64) (Fl.ofInt 2)) (fzero .f64) = false := by decide
  refine ⟨o.sqrtLlvm (div o.eps (Fl.ofInt 2)), o.sqrtLlvm o.floatmin,
    o.sqrtLlvm (div o.floatmax (Fl.ofInt 2)), ?_, ?_, ?_⟩ <;>
    simp only [sqrtIEEE, heps, hmin, hmax, hc, hm, hb, Bool.false_eq_true, ↓reduceIte]

theorem hypot64_nan_core (o : IEEEOps .f64)
    (heps : o.eps = eps_float .f64)
    (hmin : o.floatmin = floatmin_float .f64)
    (hmax : o.floatmax = floatmax_float .f64)
    (hsqrt : ∀ x, o.sqrtLlvm x = JuliaLean.C.jlSqrtLlvm x)
    (hone : ∀ x, o.oneunit x = fone .f64)
    (hgreater : ∀ x y, o.greater x y = flt y x)
    (hmuladd : ∀ x y z, o.muladd x y z = JuliaLean.base.float.muladd_IEEEFloat x y z)
    (x y : hypot_NanVal .f64) (hn : fisnan x = true ∨ fisnan y = true)
    (hxinf : fisinf x = false) (hyinf : fisinf y = false) :
    ∃ h, hypotGeneric (hypotOpsOfIEEE o) (hypotOpsOfIEEE o).abs x y = .ok h ∧
      fisnan h = true := by
  let a := div (fabs x) (fone .f64)
  let b := div (fabs y) (fone .f64)
  have haInf : fisinf a = false := hypot_normalized_notinf x hxinf
  have hbInf : fisinf b = false := hypot_normalized_notinf y hyinf
  have habNan : fisnan a = true ∨ fisnan b = true := by
    rcases hn with hx | hy
    · exact Or.inl (hypot_nan_div _ _ (Or.inl (hypot_abs_nan x hx)))
    · exact Or.inr (hypot_nan_div _ _ (Or.inl (hypot_abs_nan y hy)))
  have horder : o.greater b a = false := by
    rw [hgreater]
    rcases habNan with ha | hb
    · exact hypot_lt_nan_left a b ha
    · exact hypot_lt_nan_right a b hb
  obtain ⟨cutoff, minRoot, bigRoot, hcut, hminRoot, hbigRoot⟩ :=
    hypot_constants_sqrt64 o heps hmin hmax
  have hwide : fle b (mul a cutoff) = false := by
    apply hypot_le_nan
    rcases habNan with ha | hb
    · exact Or.inr (hypot_nan_mul a cutoff (Or.inl ha))
    · exact Or.inl hb
  let scale0 := mul o.eps minRoot
  let scaled :=
    if o.greater a bigRoot then (mul a scale0, mul b scale0, o.inverse scale0)
