theorem early_coeff_square (c x : Int) : (c * x) * (c * x) = (c * c) * (x * x) := by ac_rfl

/-- A coarse square error smaller than one-sixteenth of the first square
already gives the loose root ratios needed for finite correction arithmetic. -/
theorem early_coarse_root_ratios (A B H K : Int)
    (hA : 0 ≤ A) (hB : 0 ≤ B) (hH : 0 ≤ H) (hBA : B ≤ A)
    (_hK : 0 ≤ K) (hsmall : 16 * K ≤ A * A)
    (herr : ((H * H - A * A - B * B).natAbs : Int) ≤ K) :
    7 * A ≤ 8 * H ∧ 2 * H ≤ 3 * A ∧ (2 * B < H → 4 * H ≤ 5 * A) := by
  have hE := early_abs_interval (H * H - A * A - B * B) K herr
  have hAsq := early_hypot_square_nonnegative A
  have hBsq := early_hypot_square_nonnegative B
  have hBAsq := early_square_le_square B A hB hBA
  have hlow : 15 * (A * A) ≤ 16 * (H * H) := by omega
  have hhigh : 16 * (H * H) ≤ 33 * (A * A) := by omega
  constructor
  · apply Classical.byContradiction
    intro hh
    have hs := Int.mul_self_lt_mul_self (by omega : 0 ≤ 8 * H) (by omega : 8 * H < 7 * A)
    rw [early_coeff_square, early_coeff_square] at hs
    change 64 * (H * H) < 49 * (A * A) at hs
    omega
  constructor
  · apply Classical.byContradiction
    intro hh
    have hs := Int.mul_self_lt_mul_self (by omega : 0 ≤ 3 * A) (by omega : 3 * A < 2 * H)
    rw [early_coeff_square, early_coeff_square] at hs
    change 9 * (A * A) < 4 * (H * H) at hs
    omega
  · intro hbranch
    have hbs := Int.mul_self_lt_mul_self (by omega : 0 ≤ 2 * B) hbranch
    rw [early_coeff_square] at hbs
    change 4 * (B * B) < H * H at hbs
    have hbound : 12 * (H * H) < 17 * (A * A) := by omega
    apply Classical.byContradiction
    intro hh
    have hs := Int.mul_self_lt_mul_self (by omega : 0 ≤ 5 * A) (by omega : 5 * A < 4 * H)
    rw [early_coeff_square, early_coeff_square] at hs
    change 25 * (A * A) < 16 * (H * H) at hs
    omega

/-- The initial root's squared common key differs from the true sum of
squared operand keys by at most2^973 times the squared common denominator. -/
theorem early_hypot_initial_square_error (a b : FV .f64)
    (ha : a.isfinite = true) (hb : b.isfinite = true)
    (hsa : a.signbit = false) (hsb : b.signbit = false)
    (haB : a.key ≤ (Fl.ofBits 0x5fe6a09e667f3bcc : FV .f64).key)
    (hbB : b.key ≤ (Fl.ofBits 0x5fe6a09e667f3bcc : FV .f64).key) :
    let h := jlSqrtLlvm (JuliaLean.base.float.muladd_IEEEFloat a a (mul b b))
    ((h.key ^ 2 - a.key ^ 2 - b.key ^ 2).natAbs : Int) ≤
      ((2 ^ 973 : Nat) : Int) * ((FTy.f64.fmt.den : Int) * FTy.f64.fmt.den) := by
  let B : FV .f64 := Fl.ofBits 0x5fe6a09e667f3bcc
  let U : FV .f64 := Fl.ofBits 0x7fdfffffffffffff
  let M : FV .f64 := Fl.floatmax
  let D : Int := FTy.f64.fmt.den
  let y := mul b b
  let s := JuliaLean.base.float.muladd_IEEEFloat a a y
  let h := jlSqrtLlvm s
  have hD0 : (0 : Int) ≤ D := Int.natCast_nonneg _
  obtain ⟨_, _, hUf, hUs, hUE, _, _, _, hBsq, hUM⟩ := early_hypot_bigroot_square_bound
  have hasq := early_square_le_square a.key B.key ((JuliaLean.Proofs.base.math.mfKeySign a).2 hsa) haB
  have hbsq := early_square_le_square b.key B.key ((JuliaLean.Proofs.base.math.mfKeySign b).2 hsb) hbB
  have hy := early_square_upper_with_round U b hb (Int.le_trans hbsq hBsq)
    (fun n j hn hk => generic_round64_le_normal n j U hn hUf hUs hUE hk)
  have hsumInput : a.key * a.key + y.key * D ≤ M.key * D := by
    have hay := Int.le_trans hasq hBsq
    have hyy := Int.mul_le_mul_of_nonneg_right hy.2.2 hD0
    have hrewrite : U.key * D + U.key * D = M.key * D := by
      calc
        _ = (2 * U.key) * D := by rw [Int.mul_assoc]; omega
        _ = _ := by rw [hUM]
    exact Int.le_trans (Int.add_le_add hay hyy) (Int.le_of_eq hrewrite)
  have hsumCap : a.key * a.key + y.key * D < ((2 ^ 1024 : Nat) : Int) * (D * D) :=
    Int.lt_of_le_of_lt hsumInput (by decide)
  have hbCap : b.key * b.key < ((2 ^ 1023 : Nat) : Int) * (D * D) :=
    Int.lt_of_le_of_lt hbsq (by decide)
  have eB := root_square64_round_error b hb 1023 (by decide) (by decide) hbCap
  have eS := root_fused_square64_round_error a y ha hy.1 hy.2.1 1024 (by decide) (by decide) hsumCap
  have hs := early_hypot_balanced_sum_bound a b ha hb hsa hsb haB hbB
  have eH := generic_sqrt64_square_error s hs.2.2.1 hs.2.2.2.1
  change ((y.key * D - b.key * b.key).natAbs : Int) ≤ ((2 ^ 969 : Nat) : Int) * (D * D) at eB
  change ((s.key * D - (a.key * a.key + y.key * D)).natAbs : Int) ≤ ((2 ^ 970 : Nat) : Int) * (D * D) at eS
  change ((h.key * h.key - s.key * D).natAbs : Int) ≤ ((2 ^ 972 : Nat) : Int) * (D * D) at eH
  have hBerr := early_abs_interval _ _ eB
  have hSerr := early_abs_interval _ _ eS
  have hHerr := early_abs_interval _ _ eH
  have hconstant : ((2 ^ 969 : Nat) : Int) * (D * D) + ((2 ^ 970 : Nat) : Int) * (D * D) +
      ((2 ^ 972 : Nat) : Int) * (D * D) ≤ ((2 ^ 973 : Nat) : Int) * (D * D) := by decide
  change ((h.key ^ 2 - a.key ^ 2 - b.key ^ 2).natAbs : Int) ≤ ((2 ^ 973 : Nat) : Int) * (D * D)
  simp only [Int.pow_succ, Int.pow_zero, Int.one_mul] at hHerr ⊢
  omega

/-- For high unscaled inputs, the checked source sum and root errors give
7a/8≤h≤3a/2, and the second software branch improves this to h≤5a/4. -/
theorem early_hypot_high_root_ratios (a b : FV .f64)
    (ha : a.isfinite = true) (hb : b.isfinite = true)
    (hsa : a.signbit = false) (hsb : b.signbit = false) (hba : b.key ≤ a.key)
    (haB : a.key ≤ (Fl.ofBits 0x5fe6a09e667f3bcc : FV .f64).key)
