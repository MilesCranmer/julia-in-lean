/-- Exact lower and upper powers bracketing an arbitrary positive rational.
The split powers allow negative exponents without introducing a real-number
model or a different rounding operation. -/
theorem early_floor_ratio_bounds (n d : Nat) (hn : n ≠ 0) (hd : d ≠ 0) :
    let e := Fl.floorLog2Rat n d
    d * 2 ^ e.toNat ≤ n * 2 ^ (-e).toNat ∧
    n * 2 ^ (-e).toNat < 2 * (d * 2 ^ e.toNat) := by
  let e₀ : Int := (n.log2 : Int) - d.log2
  have hnlo := Nat.log2_self_le hn
  have hnhi : n < 2 ^ (n.log2 + 1) := Nat.lt_log2_self
  have hdlo := Nat.log2_self_le hd
  have hdhi : d < 2 ^ (d.log2 + 1) := Nat.lt_log2_self
  have he : n.log2 + (-e₀).toNat = d.log2 + e₀.toNat := by dsimp [e₀]; omega
  have hlo : d * 2 ^ e₀.toNat < 2 * (n * 2 ^ (-e₀).toNat) := by
    calc
      _ < 2 ^ (d.log2 + 1) * 2 ^ e₀.toNat :=
        Nat.mul_lt_mul_of_pos_right hdhi (Nat.two_pow_pos _)
      _ = 2 * (2 ^ n.log2 * 2 ^ (-e₀).toNat) := by
        rw [← Nat.pow_add, ← Nat.pow_add, ← Nat.pow_succ']
        congr 1
        omega
      _ ≤ _ := Nat.mul_le_mul_left _ (Nat.mul_le_mul_right _ hnlo)
  have hhi : n * 2 ^ (-e₀).toNat < 2 * (d * 2 ^ e₀.toNat) := by
    calc
      _ < 2 ^ (n.log2 + 1) * 2 ^ (-e₀).toNat :=
        Nat.mul_lt_mul_of_pos_right hnhi (Nat.two_pow_pos _)
      _ = 2 * (2 ^ d.log2 * 2 ^ e₀.toNat) := by
        rw [← Nat.pow_add, ← Nat.pow_add, ← Nat.pow_succ']
        congr 1
        omega
      _ ≤ _ := Nat.mul_le_mul_left _ (Nat.mul_le_mul_right _ hdlo)
  have htest : (if e₀ ≥ 0 then n < d * 2 ^ e₀.toNat else n * 2 ^ (-e₀).toNat < d) ↔
      n * 2 ^ (-e₀).toNat < d * 2 ^ e₀.toNat := by
    by_cases he0 : e₀ ≥ 0
    · have hz : (-e₀).toNat = 0 := by omega
      simp only [he0, ↓reduceIte, hz, Nat.pow_zero, Nat.mul_one]
    · have hz : e₀.toNat = 0 := by omega
      simp only [he0, ↓reduceIte, hz, Nat.pow_zero, Nat.mul_one]
  change let e := if (if e₀ ≥ 0 then n < d * 2 ^ e₀.toNat else n * 2 ^ (-e₀).toNat < d)
      then e₀ - 1 else e₀;
    d * 2 ^ e.toNat ≤ n * 2 ^ (-e).toNat ∧ n * 2 ^ (-e).toNat < 2 * (d * 2 ^ e.toNat)
  simp only [htest]
  by_cases hb : n * 2 ^ (-e₀).toNat < d * 2 ^ e₀.toNat
  · rw [ite_eq_left hb]
    by_cases hep : 1 ≤ e₀
    · have he0 : (-e₀).toNat = 0 := by omega
      have he1 : (-(e₀ - 1)).toNat = 0 := by omega
      have he' : e₀.toNat = (e₀ - 1).toNat + 1 := by omega
      have hshift : d * 2 ^ e₀.toNat = 2 * (d * 2 ^ (e₀ - 1).toNat) := by
        rw [he', Nat.pow_succ]; ac_rfl
      simp only [he0, he1, Nat.pow_zero, Nat.mul_one, hshift] at hlo hb ⊢
      omega
    · have he0 : e₀.toNat = 0 := by omega
      have he1 : (e₀ - 1).toNat = 0 := by omega
      have he' : (-(e₀ - 1)).toNat = (-e₀).toNat + 1 := by omega
      have hshift : n * 2 ^ (-(e₀ - 1)).toNat = 2 * (n * 2 ^ (-e₀).toNat) := by
        rw [he', Nat.pow_succ]; ac_rfl
      simp only [he0, he1, Nat.pow_zero, Nat.mul_one, hshift] at hlo hb ⊢
      omega
  · rw [ite_eq_right hb]
    exact ⟨by omega, hhi⟩

/-- Normalization of an arbitrary positive rational puts its exact
significand between2^sb and2^(sb+1). -/
theorem early_rational_normal_scale (n d sb : Nat) (hn : n ≠ 0) (hd : d ≠ 0) :
    let k := Fl.floorLog2Rat n d - sb
    let scaled := if k ≥ 0 then (n, d * 2 ^ k.toNat)
      else (n * 2 ^ (-k).toNat, d)
    0 < scaled.2 ∧ 2 ^ sb * scaled.2 ≤ scaled.1 ∧
      scaled.1 < 2 ^ (sb + 1) * scaled.2 := by
  let e := Fl.floorLog2Rat n d
  let k := e - sb
  have hb := early_floor_ratio_bounds n d hn hd
  change d * 2 ^ e.toNat ≤ n * 2 ^ (-e).toNat ∧ _ at hb
  have he : e.toNat + (-k).toNat = sb + k.toNat + (-e).toNat := by dsimp [k]; omega
  have hscale : (2 ^ sb * (d * 2 ^ k.toNat)) * 2 ^ (-e).toNat =
      (d * 2 ^ e.toNat) * 2 ^ (-k).toNat := by
    calc
      _ = d * 2 ^ (sb + k.toNat + (-e).toNat) := by simp only [Nat.pow_add]; ac_rfl
      _ = d * 2 ^ (e.toNat + (-k).toNat) := by rw [he]
      _ = _ := by rw [Nat.pow_add]; ac_rfl
  have hlo : 2 ^ sb * (d * 2 ^ k.toNat) ≤ n * 2 ^ (-k).toNat := by
    apply Nat.le_of_mul_le_mul_right (c := 2 ^ (-e).toNat) _ (Nat.two_pow_pos _)
    rw [hscale]
    simpa only [Nat.mul_assoc, Nat.mul_comm (2 ^ (-e).toNat) (2 ^ (-k).toNat)] using
      Nat.mul_le_mul_right (2 ^ (-k).toNat) hb.1
  have hhi : n * 2 ^ (-k).toNat < 2 ^ (sb + 1) * (d * 2 ^ k.toNat) := by
    apply (Nat.mul_lt_mul_right (Nat.two_pow_pos (-e).toNat)).mp
    have h := Nat.mul_lt_mul_of_pos_right hb.2 (Nat.two_pow_pos (-k).toNat)
    calc
      _ = (n * 2 ^ (-e).toNat) * 2 ^ (-k).toNat := by ac_rfl
      _ < (2 * (d * 2 ^ e.toNat)) * 2 ^ (-k).toNat := h
      _ = 2 * ((d * 2 ^ e.toNat) * 2 ^ (-k).toNat) := by ac_rfl
      _ = 2 * ((2 ^ sb * (d * 2 ^ k.toNat)) * 2 ^ (-e).toNat) := by rw [hscale]
      _ = _ := by rw [Nat.pow_succ]; ac_rfl
  change let scaled := if k ≥ 0 then (n, d * 2 ^ k.toNat)
    else (n * 2 ^ (-k).toNat, d); _
  dsimp only
  split
  · rename_i hk
    have hk0 : (-k).toNat = 0 := by omega
    simp only [hk0, Nat.pow_zero, Nat.mul_one] at hlo hhi
    exact ⟨Nat.mul_pos (Nat.pos_of_ne_zero hd) (Nat.two_pow_pos _), hlo, hhi⟩
  · rename_i hk
    have hk0 : k.toNat = 0 := by omega
    simp only [hk0, Nat.pow_zero, Nat.mul_one] at hlo hhi
    exact ⟨Nat.pos_of_ne_zero hd, hlo, hhi⟩

/-- An arbitrary positive rational below a normal Float64 has no larger
binary exponent. -/
theorem early_rational_upper_exponent (n d : Nat) (u : FV .f64)
    (hn : n ≠ 0) (hd : d ≠ 0) (hE : 1 ≤ u.expField)
    (hbound : n * 2 ^ 1074 ≤ (u.frac + 2 ^ 52) * 2 ^ (u.expField - 1) * d) :
    Fl.floorLog2Rat n d ≤ (u.expField : Int) - 1023 := by
  let e := Fl.floorLog2Rat n d
  have hb := (early_floor_ratio_bounds n d hn hd).1
  have hfrac : u.frac < 2 ^ 52 := (TruncProofs.mag_decomp u).2
  have hsig : u.frac + 2 ^ 52 < 2 ^ 53 := by omega
  have hp : d * 2 ^ (e.toNat + 1074) < d * 2 ^ (53 + (u.expField - 1) + (-e).toNat) := by
    calc
      _ = (d * 2 ^ e.toNat) * 2 ^ 1074 := by rw [Nat.pow_add]; ac_rfl
      _ ≤ (n * 2 ^ (-e).toNat) * 2 ^ 1074 := Nat.mul_le_mul_right _ hb
      _ = (n * 2 ^ 1074) * 2 ^ (-e).toNat := by ac_rfl
      _ ≤ ((u.frac + 2 ^ 52) * 2 ^ (u.expField - 1) * d) * 2 ^ (-e).toNat :=
        Nat.mul_le_mul_right _ hbound
      _ < (2 ^ 53 * 2 ^ (u.expField - 1) * d) * 2 ^ (-e).toNat :=
        Nat.mul_lt_mul_of_pos_right
          (Nat.mul_lt_mul_of_pos_right
            (Nat.mul_lt_mul_of_pos_right hsig (Nat.two_pow_pos _)) (Nat.pos_of_ne_zero hd))
          (Nat.two_pow_pos _)
      _ = _ := by simp only [Nat.pow_add]; ac_rfl
  have hp' := (Nat.mul_lt_mul_left (Nat.pos_of_ne_zero hd)).mp hp
  have he := (Nat.pow_lt_pow_iff_right (by decide : 1 < 2)).mp hp'
  change e ≤ _
  omega

/-- A same-binade representable bound is an integer upper bound for the
rounded significand, for any positive denominator. -/
theorem early_rational_upper_scaled (n d B U : Nat) (hB : 1 ≤ B)
    (hbound : n * 2 ^ 1074 ≤ U * 2 ^ (B - 1) * d) :
    let k : Int := (B : Int) - 1075
    let scaled := if k ≥ 0 then (n, d * 2 ^ k.toNat)
      else (n * 2 ^ (-k).toNat, d)
    scaled.1 ≤ U * scaled.2 := by
  let k : Int := (B : Int) - 1075
  change let scaled := if k ≥ 0 then (n, d * 2 ^ k.toNat)
    else (n * 2 ^ (-k).toNat, d); _
  dsimp only
  split
  · rename_i hk
    dsimp only
    have he : B - 1 = k.toNat + 1074 := by dsimp [k] at hk ⊢; omega
    have hh : n * 2 ^ 1074 ≤ (U * (d * 2 ^ k.toNat)) * 2 ^ 1074 := by
      rw [he, Nat.pow_add] at hbound
      have hr : U * (2 ^ k.toNat * 2 ^ 1074) * d =
          (U * (d * 2 ^ k.toNat)) * 2 ^ 1074 := by ac_rfl
      rwa [hr] at hbound
    exact Nat.le_of_mul_le_mul_right hh (Nat.two_pow_pos _)
  · rename_i hk
    dsimp only
    have he : 1074 = (B - 1) + (-k).toNat := by dsimp [k] at hk ⊢; omega
    have hh : (n * 2 ^ (-k).toNat) * 2 ^ (B - 1) ≤
        (U * d) * 2 ^ (B - 1) := by
      rw [he, Nat.pow_add] at hbound
      have hl : n * (2 ^ (B - 1) * 2 ^ (-k).toNat) =
          (n * 2 ^ (-k).toNat) * 2 ^ (B - 1) := by ac_rfl
      have hr : U * 2 ^ (B - 1) * d =
          (U * d) * 2 ^ (B - 1) := by ac_rfl
      rwa [hl, hr] at hbound
    exact Nat.le_of_mul_le_mul_right hh (Nat.two_pow_pos _)


/-- A rational below the least normal binade rounds no higher than the least
normal Float64, including gradual underflow. -/
theorem early_rational_subnormal_bound (n d : Nat) (hn : n ≠ 0) (hd : d ≠ 0)
    (hsmall : Fl.floorLog2Rat n d ≤ -1023) :
    (Fl.roundRat n d false : FV .f64).isfinite = true ∧
    (Fl.roundRat n d false : FV .f64).magnitude ≤ 2 ^ 52 := by
  let e := Fl.floorLog2Rat n d
  have hb := (early_floor_ratio_bounds n d hn hd).2
  have hep : e.toNat = 0 := by change e ≤ -1023 at hsmall; omega
  have hem : 1023 ≤ (-e).toNat := by change e ≤ -1023 at hsmall; omega
  change n * 2 ^ (-e).toNat < 2 * (d * 2 ^ e.toNat) at hb
  simp only [hep, Nat.pow_zero, Nat.mul_one] at hb
  have hnum : n * 2 ^ 1074 ≤ 2 ^ 52 * d := by
    calc
      _ ≤ n * 2 ^ ((-e).toNat + 51) :=
        Nat.mul_le_mul_left n (Nat.pow_le_pow_right (by decide) (by omega))
      _ = (n * 2 ^ (-e).toNat) * 2 ^ 51 := by rw [Nat.pow_add]; ac_rfl
      _ ≤ (2 * d) * 2 ^ 51 := Nat.le_of_lt (Nat.mul_lt_mul_of_pos_right hb (Nat.two_pow_pos _))
      _ = 2 ^ 52 * d := by change (2 * d) * 2 ^ 51 = (2 * 2 ^ 51) * d; ac_rfl
  have hq := generic_round_quotient_le (n * 2 ^ 1074) d (2 ^ 52) (Nat.pos_of_ne_zero hd) hnum
  have hn' : ¬ ((n : Int) = 0) := by omega
  have hnot : ¬ e ≥ 1024 := by change e ≤ -1023 at hsmall; omega
  let k := max (e - 52) (-1074)
  let scaled := if k ≥ 0 then (n, d * 2 ^ k.toNat) else (n * 2 ^ (-k).toNat, d)
  have hrun : (Fl.roundRat n d false : FV .f64) =
      if e < -1076 then Fl.zero false else Fl.packRounded false (Fl.roundQuotient scaled.1 scaled.2) k := by
    simp only [Fl.roundRat, beq_eq_false_iff_ne.mpr hd, beq_eq_false_iff_ne.mpr hn',
      Int.natAbs_natCast, show ¬ (n : Int) < 0 by omega, Bool.false_eq_true, ↓reduceIte]
    change (if e ≥ 1024 then Fl.inf false else if e < -1076 then Fl.zero false
      else Fl.packRounded false (Fl.roundQuotient scaled.1 scaled.2) k) = _
    rw [ite_eq_right hnot]
  rw [hrun]
  by_cases htiny : e < -1076
  · rw [ite_eq_left htiny]
    exact ⟨(Fl.zero_spec (good_fty .f64) false).1,
      by rw [JuliaLean.Proofs.base.math.mfZeroMag]; omega⟩
  · rw [ite_eq_right htiny]
    have hk : k = -1074 := by dsimp [k]; change e ≤ -1023 at hsmall; omega
    dsimp only [scaled]
    rw [hk]
    exact hypot_scale_subnormal_pack false _ hq

/-- Normal-range rational rounding remains between the adjacent powers of
two in its magnitude encoding, for arbitrary positive denominators. -/
theorem early_rational_normal_magnitude_bounds (T : FTy) (n d : Nat) (hn : n ≠ 0) (hd : d ≠ 0)
    (hlo : 1 - (T.fmt.bias : Int) ≤ Fl.floorLog2Rat n d)
    (hhi : Fl.floorLog2Rat n d < (T.fmt.emax : Int) - T.fmt.bias) :
    let B := (Fl.floorLog2Rat n d + T.fmt.bias).toNat
    let r : FV T := Fl.roundRat n (d) false
    B * 2 ^ T.fmt.sb ≤ r.magnitude ∧ r.magnitude ≤ (B + 1) * 2 ^ T.fmt.sb ∧
      r.signbit = false ∧ r.isnan = false := by
  let e := Fl.floorLog2Rat n d
  let k := e - T.fmt.sb
  let B := (e + T.fmt.bias).toNat
  let scaled := if k ≥ 0 then (n, d * 2 ^ k.toNat)
      else (n * 2 ^ (-k).toNat, d)
  let q := Fl.roundQuotient scaled.1 scaled.2
  have hB : 1 ≤ B := by dsimp [B, e]; omega
  have hBhi : B < T.fmt.emax := by dsimp [B, e]; omega
  have hsc := early_rational_normal_scale n d T.fmt.sb hn hd
  change 0 < scaled.2 ∧ _ at hsc
  have hq := early_round_normal_quotient scaled.1 scaled.2 T.fmt.sb hsc.1 hsc.2.1 hsc.2.2
  change 2 ^ T.fmt.sb ≤ q ∧ q ≤ 2 ^ (T.fmt.sb + 1) at hq
  have hnorm : (Fl.roundRat n (d) false : FV T) = Fl.packRounded false q k := by
    have hn' : ¬((n : Int) = 0) := by omega
    have hmax : max (e - T.fmt.sb) (1 - (T.fmt.bias : Int) - T.fmt.sb) = e - T.fmt.sb := by
      dsimp [e]
      omega
    have hlower : ¬ e < -((T.fmt.bias : Int) + T.fmt.sb) - 1 := by dsimp [e]; omega
    simp only [Fl.roundRat, show (d == 0) = false from beq_eq_false_iff_ne.mpr hd,
      beq_eq_false_iff_ne.mpr hn', Int.natAbs_natCast, Bool.false_eq_true, ↓reduceIte,
      show ¬(n : Int) < 0 by omega]
    change (if e ≥ (T.fmt.emax : Int) - T.fmt.bias then _ else if e < -((T.fmt.bias : Int) + T.fmt.sb) - 1 then _ else _) = _
    rw [ite_eq_right (by exact Int.not_le.mpr hhi), ite_eq_right hlower, hmax]
    rfl
  have hkrepr : k = (B : Int) - T.fmt.bias - T.fmt.sb := by dsimp [B, k, e]; omega
  rw [hkrepr, early_round_pack_normal T q B hq.1 hq.2 hB hBhi] at hnorm
  have hcap : 2 ^ (T.fmt.sb + 1) = 2 * 2 ^ T.fmt.sb := by rw [Nat.pow_succ, Nat.mul_comm]
  have hmagHi : B * 2 ^ T.fmt.sb + (q - 2 ^ T.fmt.sb) ≤ NextProofs.infMag T := by
    have hstep := Nat.mul_le_mul_right (2 ^ T.fmt.sb) (show B + 1 ≤ T.fmt.emax by omega)
    rw [Nat.add_mul, Nat.one_mul] at hstep
    change _ ≤ T.fmt.emax * 2 ^ T.fmt.sb
    rw [hcap] at hq
    omega
  have hmagSign : B * 2 ^ T.fmt.sb + (q - 2 ^ T.fmt.sb) < NextProofs.signMask T :=
    Nat.lt_of_le_of_lt hmagHi (NextProofs.infMag_lt_signMask T)
  change B * 2 ^ T.fmt.sb ≤ (Fl.roundRat n (d) false : FV T).magnitude ∧ _
