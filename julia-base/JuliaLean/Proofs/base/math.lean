theorem ldexp_scaled_zero (T : JuliaLean.base.float.FTy) (s : Bool) (e : Int) :
    ScaledFloatBits (Fl.zero s : JuliaLean.base.float.FV T) e = (Fl.zero s : JuliaLean.base.float.FV T).toBits := by
  have hz : (Fl.zero s : JuliaLean.base.float.FV T).toRat.1 = 0 :=
    mfToRatZero _ (by cases T <;> cases s <;> decide) (mfZeroMag (T := T) s)
  have hd := (Fl.toRat_key (good_fty T) (Fl.zero s)
    (by cases T <;> cases s <;> decide)).1
  unfold ScaledFloatBits QMul QPowTwo
  rw [hz, Int.zero_mul, mfZeroSignbit]
  split <;> dsimp only
  · rw [mfRoundRatZero _ (by omega)]
  · rw [mfRoundRatZero _ (Nat.mul_ne_zero (by omega) (Nat.ne_of_gt (Nat.two_pow_pos _)))]

theorem ldexp_floor_log_scale (a d j : Nat) (ha : a ≠ 0) (hd : d ≠ 0) :
    Fl.floorLog2Rat (a * 2 ^ j) (d * 2 ^ j) = Fl.floorLog2Rat a d := by
  unfold Fl.floorLog2Rat
  rw [Fl.log2_mul_pow a j ha, Fl.log2_mul_pow d j hd]
  have hex : ((a.log2 + j : Nat) : Int) - ((d.log2 + j : Nat) : Int) =
      (a.log2 : Int) - d.log2 := by omega
  rw [hex]
  by_cases he : (a.log2 : Int) - d.log2 ≥ 0
  · simp only [he, ↓reduceIte]
    rw [Nat.mul_right_comm d (2 ^ j)]
    simp only [Nat.mul_lt_mul_right (Nat.two_pow_pos j)]
  · simp only [he, ↓reduceIte]
    rw [Nat.mul_right_comm a (2 ^ j)]
    simp only [Nat.mul_lt_mul_right (Nat.two_pow_pos j)]

theorem ldexp_roundRat_scale {f : Fmt} (n : Int) (d j : Nat) (z : Bool)
    (hd : d ≠ 0) :
    (Fl.roundRat (n * ((2 ^ j : Nat) : Int)) (d * 2 ^ j) z : Fl f) =
      Fl.roundRat n d z := by
  have hp := Nat.two_pow_pos j
  have hpi : (0 : Int) < ((2 ^ j : Nat) : Int) := Int.natCast_pos.mpr hp
  have hdp : d * 2 ^ j ≠ 0 := Nat.mul_ne_zero hd (Nat.ne_of_gt hp)
  by_cases hn : n = 0
  · subst n
    simp only [Int.zero_mul, Fl.roundRat, beq_iff_eq, hd, hdp, ↓reduceIte]
  · have hnp : n * ((2 ^ j : Nat) : Int) ≠ 0 := Int.mul_ne_zero hn (Int.ne_of_gt hpi)
    have habs : (n * ((2 ^ j : Nat) : Int)).natAbs = n.natAbs * 2 ^ j := by
      rw [Int.natAbs_mul, Int.natAbs_natCast]
    have hsign : decide (n * ((2 ^ j : Nat) : Int) < 0) = decide (n < 0) := by
      by_cases hneg : n < 0
      · rw [decide_eq_true hneg, decide_eq_true (Int.mul_neg_of_neg_of_pos hneg hpi)]
      · have hpos : 0 ≤ n * ((2 ^ j : Nat) : Int) :=
          Int.mul_nonneg (by omega) (by omega)
        rw [decide_eq_false hneg, decide_eq_false (by omega : ¬ n * ((2 ^ j : Nat) : Int) < 0)]
    simp only [Fl.roundRat, beq_iff_eq, hd, hdp, hn, hnp, ↓reduceIte, habs, hsign]
    rw [ldexp_floor_log_scale n.natAbs d j (by omega) hd]
    split
    · rfl
    · split
      · rfl
      · generalize max (Fl.floorLog2Rat n.natAbs d - f.sb) (1 - (f.bias : Int) - f.sb) = k
        by_cases hk : k ≥ 0
        · simp only [hk, ↓reduceIte]
          rw [Nat.mul_right_comm d (2 ^ j), roundQuotient_scale _ _ _ hp]
        · simp only [hk, ↓reduceIte]
          rw [Nat.mul_right_comm n.natAbs (2 ^ j), roundQuotient_scale _ _ _ hp]

theorem ldexp_roundRat_dyadic_equal {f : Fmt} (n₁ n₂ : Int) (j₁ j₂ : Nat) (z : Bool)
    (h : n₁ * ((2 ^ j₂ : Nat) : Int) = n₂ * ((2 ^ j₁ : Nat) : Int)) :
    (Fl.roundRat n₁ (2 ^ j₁) z : Fl f) = Fl.roundRat n₂ (2 ^ j₂) z := by
  rw [← ldexp_roundRat_scale n₁ (2 ^ j₁) j₂ z (Nat.ne_of_gt (Nat.two_pow_pos _)), h]
  rw [Nat.mul_comm (2 ^ j₁) (2 ^ j₂), ldexp_roundRat_scale n₂ (2 ^ j₂) j₁ z
    (Nat.ne_of_gt (Nat.two_pow_pos _))]

def ldexp_normalized_kernel (T : JuliaLean.base.float.FTy) (s : Bool) (c : Nat) (k : Int) :
    JuliaLean.base.float.FV T :=
  if k ≥ T.fmt.emax then Fl.inf s
  else if k > 0 then NextProofs.encode T s (k.toNat * 2 ^ T.fmt.sb + (c - 2 ^ T.fmt.sb))
  else if k ≤ -(T.fmt.sb : Int) - 1 then Fl.zero s
  else mul (Fl.ofBits ((T.fmt.bias - T.fmt.sb - 1) * 2 ^ T.fmt.sb))
    (NextProofs.encode T s ((k + T.fmt.sb + 1).toNat * 2 ^ T.fmt.sb + (c - 2 ^ T.fmt.sb)))

theorem ldexp_normal_shift {T : JuliaLean.base.float.FTy} (o : IEEEOps T)
    (x : JuliaLean.base.float.FV T) (e : Int) (hx : x.isfinite = true)
    (hB : x.expField ≠ 0) (he₁ : -(2 ^ 62) ≤ e) (he₂ : e ≤ 2 ^ 62)
    (hflip : ∀ a, a = fzero T ∨ a = finf T → o.flipsign a x =
      if a = fzero T then Fl.zero x.signbit else Fl.inf x.signbit) :
    ldexp o x e = ldexp_normalized_kernel T x.signbit (mfNormSig x) ((x.expField : Int) + e) := by
  rw [mfLdexpNormal o x e hx hB he₁ he₂]
  have hzero : fzero T ≠ finf T := by cases T <;> decide
  have hfz := hflip (fzero T) (Or.inl rfl)
  have hfi := hflip (finf T) (Or.inr rfl)
  simp only [↓reduceIte] at hfz
  simp only [Ne.symm hzero, ↓reduceIte] at hfi
  have hc : mfNormSig x - 2 ^ T.fmt.sb = x.frac := by
    simp only [mfNormSig, hB, ↓reduceIte, Nat.add_sub_cancel]
  unfold ldexp_normalized_kernel
  rw [hc, hfz, hfi]
  split
  · rfl
  · split
    · rfl
    · split
      · rename_i h₁ h₂ h₃
        have hsmall : ¬ e > 50000 := by omega
        simp only [hsmall, ↓reduceIte]
      · rfl

def ldexp_signed_pow (s : Bool) (c i : Nat) : Int :=
  if s then -((c * 2 ^ i : Nat) : Int) else ((c * 2 ^ i : Nat) : Int)

theorem ldexp_signed_pow_abs (s : Bool) (c i : Nat) :
    (ldexp_signed_pow s c i).natAbs = c * 2 ^ i := by
  cases s <;> simp only [ldexp_signed_pow, Bool.false_eq_true, ↓reduceIte,
    Int.natAbs_neg, Int.natAbs_natCast]

theorem ldexp_signed_pow_ne (s : Bool) (c i : Nat) (hc : c ≠ 0) :
    ldexp_signed_pow s c i ≠ 0 := by
  have hn := Nat.mul_ne_zero hc (Nat.ne_of_gt (Nat.two_pow_pos i))
  have ha := ldexp_signed_pow_abs s c i
  intro h
  rw [h, Int.natAbs_zero] at ha
  exact hn ha.symm

theorem ldexp_signed_pow_sign (s : Bool) (c i : Nat) (hc : c ≠ 0) :
    decide (ldexp_signed_pow s c i < 0) = s := by
  have hn := Nat.mul_pos (Nat.pos_of_ne_zero hc) (Nat.two_pow_pos i)
  cases s <;> simp only [ldexp_signed_pow, Bool.false_eq_true, ↓reduceIte]
  · exact decide_eq_false (by omega)
  · exact decide_eq_true (by omega)

theorem ldexp_round_normal (T : JuliaLean.base.float.FTy) (s : Bool) (c i j : Nat) (k : Int)
    (hc₁ : 2 ^ T.fmt.sb ≤ c) (hc₂ : c < 2 ^ (T.fmt.sb + 1))
    (hk : k = (T.fmt.sb : Int) + i - j + T.fmt.bias) (hk₁ : 0 < k) (hk₂ : k < T.fmt.emax) :
    (Fl.roundRat (ldexp_signed_pow s c i) (2 ^ j) s : JuliaLean.base.float.FV T) =
      NextProofs.encode T s (k.toNat * 2 ^ T.fmt.sb + (c - 2 ^ T.fmt.sb)) := by
  have hc : c ≠ 0 := by have := Nat.two_pow_pos T.fmt.sb; omega
  have hlog := mfLog2Eq c T.fmt.sb hc₁ hc₂
  rw [Fl.roundRat_normal (good_fty T) _ c i j s (ldexp_signed_pow_abs s c i)
    (by omega) hc₂ (by omega) (by omega), hlog, ldexp_signed_pow_sign s c i hc]
  simp only [Nat.sub_self, Nat.pow_zero, Nat.mul_one]
  have hB : T.fmt.sb + i + T.fmt.bias - j = k.toNat := by omega
  rw [hB]
  rfl

theorem ldexp_round_overflow (T : JuliaLean.base.float.FTy) (s : Bool) (c i j : Nat) (k : Int)
    (hc₁ : 2 ^ T.fmt.sb ≤ c) (hc₂ : c < 2 ^ (T.fmt.sb + 1))
    (hk : k = (T.fmt.sb : Int) + i - j + T.fmt.bias) (hk₁ : T.fmt.emax ≤ k) :
    (Fl.roundRat (ldexp_signed_pow s c i) (2 ^ j) s : JuliaLean.base.float.FV T) = Fl.inf s := by
  have hc : c ≠ 0 := by have := Nat.two_pow_pos T.fmt.sb; omega
  have hn := ldexp_signed_pow_ne s c i hc
  have hlog := mfLog2Eq c T.fmt.sb hc₁ hc₂
  have hcp := Nat.mul_ne_zero hc (Nat.ne_of_gt (Nat.two_pow_pos i))
  have he : Fl.floorLog2Rat (c * 2 ^ i) (2 ^ j) = (T.fmt.sb : Int) + i - j := by
    rw [Fl.floorLog2Rat_pow _ _ hcp, Fl.log2_mul_pow c i hc, hlog, Int.natCast_add]
  have hover : (T.fmt.sb : Int) + i - j ≥ (T.fmt.emax : Int) - T.fmt.bias := by omega
  simp only [Fl.roundRat, beq_iff_eq, Nat.ne_of_gt (Nat.two_pow_pos j), hn, ↓reduceIte,
    ldexp_signed_pow_abs, ldexp_signed_pow_sign s c i hc, he, hover]

theorem ldexp_roundQuotient_small (n d : Nat) (h : 2 * n < d) :
    Fl.roundQuotient n d = 0 := by
  have hnd : n < d := by omega
  have htwo : ¬ 2 * n > d := by omega
