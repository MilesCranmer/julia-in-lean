      exact_mod_cast (by simpa using hmul)
  · by_cases he : 0 ≤ ((n.log2 : Int) - j) + 1
    · simp only [QPowTwo, if_pos he, QRatLt, decide_eq_true_eq]
      have heNat : (((n.log2 : Int) - j) + 1).toNat + j = n.log2 + 1 := by omega
      have hp : 2 ^ (((n.log2 : Int) - j) + 1).toNat * 2 ^ j = 2 ^ (n.log2 + 1) := by
        rw [← Nat.pow_add, heNat]
      exact_mod_cast (by rw [hp]; simpa using hhi)
    · simp only [QPowTwo, if_neg he, QRatLt, decide_eq_true_eq]
      have heNat : (-( ((n.log2 : Int) - j) + 1)).toNat + (n.log2 + 1) = j := by omega
      have hp : 2 ^ (n.log2 + 1) * 2 ^ (-( ((n.log2 : Int) - j) + 1)).toNat = 2 ^ j := by
        rw [← Nat.pow_add,
          Nat.add_comm (n.log2 + 1) (-( ((n.log2 : Int) - j) + 1)).toNat, heNat]
