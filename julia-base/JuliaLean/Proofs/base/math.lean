/-- The initial root in the large-input branch has neighbor gaps at most 2^408. -/
theorem root_scaled_sqrt64_neighbor_bounds (h : JuliaLean.base.float.FV .f64)
    (hf : h.isfinite = true) (hs : h.signbit = false) (hm : 0 < h.magnitude)
    (hu : h.key ≤ (Fl.ofBits 0x5cbfffffffffffff : JuliaLean.base.float.FV .f64).key) :
    (prevfloat h).isfinite = true ∧ (nextfloat h).isfinite = true ∧
    0 ≤ (prevfloat h).key ∧
    (0 ≤ h.key - (prevfloat h).key ∧ h.key - (prevfloat h).key ≤ ((2 ^ 1482 : Nat) : Int)) ∧
    (0 ≤ (nextfloat h).key - h.key ∧ (nextfloat h).key - h.key ≤ ((2 ^ 1482 : Nat) : Int)) := by
  let H : JuliaLean.base.float.FV .f64 := Fl.ofBits 0x5cbfffffffffffff
  have hH : H.signbit = false ∧ H.magnitude = 0x5cbfffffffffffff := by decide
  have hmag : h.magnitude ≤ 0x5cbfffffffffffff := by
    apply Classical.byContradiction
    intro hn
    have he := magKey_strictMono JuliaLean.base.float.FTy.f64.fmt (by omega : 0x5cbfffffffffffff < h.magnitude)
    change h.key ≤ H.key at hu
    simp only [Fl.key, hs, hH.1, hH.2, Bool.false_eq_true, ↓reduceIte] at hu
    omega
  have hnextmag : h.magnitude + 1 < NextProofs.infMag .f64 := by
    change h.magnitude + 1 < 0x7ff0000000000000
    omega
  have hprevmag : h.magnitude - 1 < NextProofs.infMag .f64 := by omega
  have hns := Nat.lt_trans hnextmag (NextProofs.infMag_lt_signMask .f64)
  have hps := Nat.lt_trans hprevmag (NextProofs.infMag_lt_signMask .f64)
  have hnei := EpsilonNeighborProofs.finite_neighbors h hf hm
  simp only [hs, Bool.false_eq_true, ↓reduceIte] at hnei
  have hnf : (nextfloat h).isfinite = true := by
    rw [hnei.1]
    exact EpsilonNeighborProofs.encode_finite .f64 false _ hnextmag
  have hpf : (prevfloat h).isfinite = true := by
    rw [hnei.2]
    exact EpsilonNeighborProofs.encode_finite .f64 false _ hprevmag
  have hk : h.key = ((magKey JuliaLean.base.float.FTy.f64.fmt h.magnitude : Nat) : Int) := by
    simp only [Fl.key, hs, Bool.false_eq_true, ↓reduceIte]
  have hnk : (nextfloat h).key = ((magKey JuliaLean.base.float.FTy.f64.fmt (h.magnitude + 1) : Nat) : Int) := by
    rw [hnei.1, EpsilonNeighborProofs.encode_key .f64 false _ hns]
    rfl
  have hpk : (prevfloat h).key = ((magKey JuliaLean.base.float.FTy.f64.fmt (h.magnitude - 1) : Nat) : Int) := by
    rw [hnei.2, EpsilonNeighborProofs.encode_key .f64 false _ hps]
    rfl
  have hngap : (nextfloat h).key - h.key = ((2 ^ (h.magnitude / 2 ^ 52 - 1) : Nat) : Int) := by
    rw [hnk, hk]
    exact EpsilonNeighborProofs.magKey_next JuliaLean.base.float.FTy.f64.fmt h.magnitude
  have hpgap : h.key - (prevfloat h).key = ((2 ^ ((h.magnitude - 1) / 2 ^ 52 - 1) : Nat) : Int) := by
    rw [hk, hpk]
    have he := EpsilonNeighborProofs.magKey_next JuliaLean.base.float.FTy.f64.fmt (h.magnitude - 1)
    rw [Nat.sub_add_cancel (by omega : 1 ≤ h.magnitude)] at he
    exact he
  have hB : h.magnitude / 2 ^ 52 ≤ 1483 := by
    change h.magnitude / 4503599627370496 ≤ 1483
    omega
  have hP : (h.magnitude - 1) / 2 ^ 52 ≤ h.magnitude / 2 ^ 52 :=
    Nat.div_le_div_right (Nat.sub_le _ _)
  refine ⟨hpf, hnf, ?_, ?_, ?_⟩
  · rw [hpk]
    exact Int.natCast_nonneg _
  · rw [hpgap]
    exact ⟨Int.natCast_nonneg _, Int.ofNat_le.mpr (Nat.pow_le_pow_right (by decide) (by omega))⟩
  · rw [hngap]
    exact ⟨Int.natCast_nonneg _, Int.ofNat_le.mpr (Nat.pow_le_pow_right (by decide) (by omega))⟩

