def hypot_critical_square_prev : hypot_BoundaryVal := Fl.ofBits 0x798ffffffffffffd

/-- The predecessor of RN(H²) is below the lower square-root midpoint at H. -/
theorem hypot_critical_lower_midpoint_certificate :
    hypot_critical_square_prev.signbit = false ∧
    hypot_critical_boundary_prev.isfinite = true ∧
    (nextfloat hypot_critical_boundary_prev).isfinite = true ∧
    0 ≤ hypot_critical_boundary_prev.key ∧
    hypot_critical_boundary_prev.key < hypot_rescale_boundary.key ∧
    4 * hypot_critical_square_prev.key * JuliaLean.base.float.FTy.f64.fmt.den <
      (hypot_critical_boundary_prev.key + (nextfloat hypot_critical_boundary_prev).key) ^ 2 := by decide

/-- Any finite nonnegative input whose rounded square root is H is at least RN(H²). -/
theorem hypot_critical_square_lower_of_sqrt (t : hypot_BoundaryVal)
    (ht : t.isfinite = true) (hst : t.signbit = false)
    (hcritical : (jlSqrtLlvm t).key = hypot_rescale_boundary.key) :
    (mul hypot_rescale_boundary hypot_rescale_boundary).key ≤ t.key := by
  let X := mul hypot_rescale_boundary hypot_rescale_boundary
  have hXsign : X.signbit = false := by decide
  have hc := hypot_critical_lower_midpoint_certificate
  apply Classical.byContradiction
  intro hnot
  have hless : t.key < X.key := by change ¬ X.key ≤ t.key at hnot; omega
  have hmag : t.magnitude < X.magnitude := by
    apply Nat.lt_of_not_ge
    intro h
    have hk := generic_positive_key_mono X t hXsign hst h
    omega
  have hprev : t.magnitude ≤ hypot_critical_square_prev.magnitude := by
    change t.magnitude < 0x798ffffffffffffe at hmag
    change t.magnitude ≤ 0x798ffffffffffffd
    omega
  have htk := generic_positive_key_mono t hypot_critical_square_prev hst hc.1 hprev
  have hscaled := Int.mul_le_mul_of_nonneg_right
    (Int.mul_le_mul_of_nonneg_left htk (by decide : (0 : Int) ≤ 4))
    (Int.natCast_nonneg JuliaLean.base.float.FTy.f64.fmt.den)
  have hroot := root_sqrt_upper_midpoint t hypot_critical_boundary_prev ht hst
    hc.2.1 hc.2.2.1 hc.2.2.2.1 (Int.lt_of_le_of_lt hscaled hc.2.2.2.2.2)
  rw [hcritical] at hroot
  have hlt := hc.2.2.2.2.1
  omega


/-- A convenient signed-integer form of nonnegative nearest-rounding monotonicity. -/
theorem hypot_integer_round_monotone (N M : Int) (hN : 0 ≤ N) (hNM : N ≤ M)
    (hcap : M.natAbs.log2 + 1023 < 2047) :
    (Fl.roundRat N 1 false : hypot_BoundaryVal).key ≤
      (Fl.roundRat M 1 false : hypot_BoundaryVal).key := by
  have hNc : (N.natAbs : Int) = N := by omega
  have hMc : (M.natAbs : Int) = M := by omega
  have h := root_round_integer_monotone .f64 N.natAbs M.natAbs (by omega) hcap
  rw [hNc, hMc] at h
  exact h

theorem hypot_boundary_integer_nonnegative (x : hypot_BoundaryVal) (X : Int)
    (hx : hypot_boundary_integer x X) (hkey : 0 ≤ x.key) : 0 ≤ X := by
