theorem early_bound2_mono (a b : Nat) (ha : a ≤ 1023) (hb : b ≤ 1023) (hab : a ≤ b) :
    (early_bound2 a).key ≤ (early_bound2 b).key := by
  rw [(early_bound2_fields a ha).2.2.2, (early_bound2_fields b hb).2.2.2]
  exact Int.ofNat_le.mpr (Nat.pow_le_pow_right (by decide) (by omega))

theorem early_bound2_add_cap (a b r : Nat)
    (ha : a ≤ 1023) (hb : b ≤ 1023) (hr : r ≤ 1023) (har : a < r) (hbr : b < r) :
    (early_bound2 a).key + (early_bound2 b).key ≤ (early_bound2 r).key := by
  rw [(early_bound2_fields a ha).2.2.2, (early_bound2_fields b hb).2.2.2,
    (early_bound2_fields r hr).2.2.2]
  have hpa : 2 ^ (a + 1074) ≤ 2 ^ (r + 1073) := Nat.pow_le_pow_right (by decide) (by omega)
  have hpb : 2 ^ (b + 1074) ≤ 2 ^ (r + 1073) := Nat.pow_le_pow_right (by decide) (by omega)
  have he : 2 ^ (r + 1074) = 2 ^ (r + 1073) * 2 := Nat.pow_succ 2 (r + 1073)
  have hp : 2 ^ (a + 1074) + 2 ^ (b + 1074) ≤ 2 ^ (r + 1074) := by
    rw [he]
    omega
  exact_mod_cast hp

theorem early_bound2_mul_cap (a b r : Nat)
    (ha : a ≤ 1023) (hb : b ≤ 1023) (hr : r ≤ 1023) (hab : a + b ≤ r) :
    (early_bound2 a).key * (early_bound2 b).key ≤ (early_bound2 r).key * FTy.f64.fmt.den := by
  rw [(early_bound2_fields a ha).2.2.2, (early_bound2_fields b hb).2.2.2,
    (early_bound2_fields r hr).2.2.2]
  have hp : 2 ^ (a + 1074) * 2 ^ (b + 1074) ≤ 2 ^ (r + 1074) * 2 ^ 1074 := by
    rw [← Nat.pow_add, ← Nat.pow_add]
    exact Nat.pow_le_pow_right (by decide) (by omega)
  change ((2 ^ (a + 1074) : Nat) : Int) * ((2 ^ (b + 1074) : Nat) : Int) ≤
    ((2 ^ (r + 1074) : Nat) : Int) * ((2 ^ 1074 : Nat) : Int)
  exact_mod_cast hp

theorem early_bound2_fma_cap (a b c r : Nat)
    (ha : a ≤ 1023) (hb : b ≤ 1023) (hc : c ≤ 1023) (hr : r ≤ 1023)
    (hab : a + b < r) (hcr : c < r) :
    (early_bound2 a).key * (early_bound2 b).key + (early_bound2 c).key * FTy.f64.fmt.den ≤
      (early_bound2 r).key * FTy.f64.fmt.den := by
  have hp := early_bound2_mul_cap a b (a + b) ha hb (by omega) (by omega)
  have hs := Int.mul_le_mul_of_nonneg_right
    (early_bound2_add_cap (a + b) c r (by omega) hc hr hab hcr) (Int.natCast_nonneg FTy.f64.fmt.den)
  rw [Int.add_mul] at hs
  omega

theorem early_box_weaken (a b : Nat) (x : FV .f64) (hx : early_box a x)
    (ha : a ≤ 1023) (hb : b ≤ 1023) (hab : a ≤ b) : early_box b x :=
  ⟨hx.1, Int.le_trans hx.2 (early_bound2_mono a b ha hb hab)⟩

theorem early_box_zero (e : Nat) (he : e ≤ 1023) : early_box e (fzero .f64) := by
  refine ⟨by decide, ?_⟩
  change (0 : Int) ≤ (early_bound2 e).key
  exact (JuliaLean.Proofs.base.math.mfKeySign _).2 (early_bound2_fields e he).2.1

/-- A coarse absolute numerator bound and a strict lower bound on the first
root suffice for finite division by the correction denominator2h. -/
theorem early_box_div_twice (N E Q : Nat) (n h : FV .f64) (R : Int)
    (hn : early_box N n) (hh : early_box E h) (hE : E ≤ 1022) (hQ : Q ≤ 1023)
    (hR : 0 < R) (hRh : R ≤ h.key)
    (hcap : (early_bound2 N).key * FTy.f64.fmt.den ≤ (early_bound2 Q).key * (2 * R)) :
    early_box Q (div n (mul (Fl.ofInt 2) h)) := by
  have hb := hh.2
  rw [(early_bound2_fields E (by omega)).2.2.2] at hb
  have hbNat : h.key.natAbs ≤ 2 ^ (E + 1074) := Int.ofNat_le.mp hb
  have htwo : 2 * h.key.natAbs < 2 ^ FTy.f64.fmt.sb * 2 ^ (FTy.f64.fmt.emax - 1) := by
    change 2 * h.key.natAbs < 2 ^ 52 * 2 ^ 2046
    calc
      _ ≤ 2 * 2 ^ (E + 1074) := Nat.mul_le_mul_left _ hbNat
      _ = 2 ^ (E + 1074 + 1) := (show 2 ^ (E + 1074 + 1) = 2 * 2 ^ (E + 1074) from Nat.pow_succ').symm
      _ < 2 ^ (52 + 2046) := Nat.pow_lt_pow_right (by decide) (by omega)
      _ = _ := Nat.pow_add 2 52 2046
  have hd := JuliaLean.Proofs.base.math.mfMulTwoKey h hh.1 htwo
  have hdkpos : 0 < (mul (Fl.ofInt 2) h).key := by rw [hd.2]; omega
  have hdz : (mul (Fl.ofInt 2) h).iszero = false := by
    apply Bool.eq_false_iff.mpr
    intro hz
    have hk := FloatRoundDirections.finite_zero_key (mul (Fl.ofInt 2) h) hz
    omega
  have hdabs := Int.natAbs_of_nonneg (Int.le_of_lt hdkpos)
  have hu := early_bound2_fields Q hQ
  have hu0 := (JuliaLean.Proofs.base.math.mfKeySign (early_bound2 Q)).2 hu.2.1
  have hk : (n.key.natAbs : Int) * FTy.f64.fmt.den ≤
      (early_bound2 Q).key * ((mul (Fl.ofInt 2) h).key.natAbs : Int) := by
    rw [hdabs, hd.2]
    calc
      _ ≤ (early_bound2 N).key * FTy.f64.fmt.den :=
        Int.mul_le_mul_of_nonneg_right hn.2 (Int.natCast_nonneg _)
      _ ≤ (early_bound2 Q).key * (2 * R) := hcap
      _ ≤ _ := Int.mul_le_mul_of_nonneg_left (by omega) hu0
  exact early_div64_abs_bound n (mul (Fl.ofInt 2) h) (early_bound2 Q)
    hn.1 hd.1 hdz hu.1 hu.2.1 hu.2.2.1 hk

/-- Both source correction formulas are finite under coarse absolute operand
bounds and a positive lower bound for the initial root. No rounding-error or
correct-rounding claim is needed for this range result. -/
theorem early_box_fneg (E : Nat) (x : FV .f64) (hx : early_box E x) :
    early_box E (fneg x) := by
  have hn := generic_source_neg_finite x hx.1
  refine ⟨hn.1, ?_⟩
  rw [hn.2, Int.natAbs_neg]
  exact hx.2

theorem early_hypot_correction_box (E Q : Nat) (hardware : Bool) (a b h : FV .f64) (R : Int)
    (ha : early_box E a) (hb : early_box E b) (hh : early_box E h)
    (hsa : a.signbit = false) (hsb : b.signbit = false) (hsh : h.signbit = false)
    (hE : 2 * E + 5 ≤ 1023) (hQ : Q + 1 ≤ 1023) (hEQ : E ≤ Q)
    (hR : 0 < R) (hRh : R ≤ h.key)
    (hcap : (early_bound2 (2 * E + 5)).key * FTy.f64.fmt.den ≤
      (early_bound2 Q).key * (2 * R)) :
    early_box (Q + 1) (early_hypot64_correct hardware a b h) := by
  have htwo : early_box 1 (Fl.ofInt 2) := by unfold early_box; decide
  have hfour : early_box 2 (Fl.ofInt 4) := by unfold early_box; decide
  have finish (n : FV .f64) (hn : early_box (2 * E + 5) n) :
      early_box (Q + 1) (sub h (div n (mul (Fl.ofInt 2) h))) := by
    have hquot := early_box_div_twice (2 * E + 5) E Q n h R hn hh (by omega) (by omega) hR hRh hcap
    exact early_box_sub E Q (Q + 1) h _ hh hquot (by omega)
      (by apply early_bound2_add_cap <;> omega)
  cases hardware
  · simp only [early_hypot64_correct, Bool.false_eq_true, ↓reduceIte]
    split
    · have hd := early_box_nonnegative_sub E h b hh hb hsh hsb (by omega)
      have hab := early_box_nonnegative_sub E a b ha hb hsa hsb (by omega)
      have htwoab := early_box_mul 1 E (E + 1) (Fl.ofInt 2) (sub a b) htwo hab (by omega)
        (by apply early_bound2_mul_cap <;> omega)
      have hleft := early_box_sub E (E + 1) (E + 2) (sub h b) (mul (Fl.ofInt 2) (sub a b)) hd htwoab
        (by omega) (by apply early_bound2_add_cap <;> omega)
      have htwod := early_box_mul 1 E (E + 1) (Fl.ofInt 2) (sub h b) htwo hd (by omega)
        (by apply early_bound2_mul_cap <;> omega)
      have hright := early_box_sub (E + 1) E (E + 2) (mul (Fl.ofInt 2) (sub h b)) a htwod ha
        (by omega) (by apply early_bound2_add_cap <;> omega)
      have hterm := early_box_mul E (E + 2) (2 * E + 2) a (sub (mul (Fl.ofInt 2) (sub h b)) a)
        ha hright (by omega) (by apply early_bound2_mul_cap <;> omega)
      have hnum := early_box_muladd E (E + 2) (2 * E + 2) (2 * E + 3)
        (sub h b) (sub (sub h b) (mul (Fl.ofInt 2) (sub a b)))
        (mul a (sub (mul (Fl.ofInt 2) (sub h b)) a)) hd hleft hterm
        (by omega) (by apply early_bound2_fma_cap <;> omega)
      exact finish _ (early_box_weaken (2 * E + 3) (2 * E + 5) _ hnum (by omega) hE (by omega))
    · have hd := early_box_nonnegative_sub E h a hh ha hsh hsa (by omega)
      have hfourδ := early_box_mul 2 E (E + 2) (Fl.ofInt 4) (sub h a) hfour hd (by omega)
        (by apply early_bound2_mul_cap <;> omega)
      have hleft := early_box_sub (E + 2) E (E + 3) (mul (Fl.ofInt 4) (sub h a)) b hfourδ hb
        (by omega) (by apply early_bound2_add_cap <;> omega)
      have htwob := early_box_mul 1 E (E + 1) (Fl.ofInt 2) b htwo hb (by omega)
        (by apply early_bound2_mul_cap <;> omega)
      have hright := early_box_sub E (E + 1) (E + 2) a (mul (Fl.ofInt 2) b) ha htwob
        (by omega) (by apply early_bound2_add_cap <;> omega)
      have htwoδ := early_box_mul 1 E (E + 1) (Fl.ofInt 2) (sub h a) htwo hd (by omega)
        (by apply early_bound2_mul_cap <;> omega)
      have hterm2 := early_box_mul (E + 1) (E + 2) (2 * E + 3)
        (mul (Fl.ofInt 2) (sub h a)) (sub a (mul (Fl.ofInt 2) b)) htwoδ hright
        (by omega) (by apply early_bound2_mul_cap <;> omega)
      have hinner := early_box_muladd E (E + 3) (2 * E + 3) (2 * E + 4)
        b (sub (mul (Fl.ofInt 4) (sub h a)) b)
        (mul (mul (Fl.ofInt 2) (sub h a)) (sub a (mul (Fl.ofInt 2) b))) hb hleft hterm2
        (by omega) (by apply early_bound2_fma_cap <;> omega)
      have hnum := early_box_muladd E E (2 * E + 4) (2 * E + 5)
        (sub h a) (sub h a)
        (JuliaLean.base.float.muladd_IEEEFloat b (sub (mul (Fl.ofInt 4) (sub h a)) b)
          (mul (mul (Fl.ofInt 2) (sub h a)) (sub a (mul (Fl.ofInt 2) b)))) hd hd hinner
        (by omega) (by apply early_bound2_fma_cap <;> omega)
      exact finish _ hnum
  · simp only [early_hypot64_correct, ↓reduceIte]
    have hhsq := early_box_mul E E (2 * E) h h hh hh (by omega)
      (by apply early_bound2_mul_cap <;> omega)
    have hasq := early_box_mul E E (2 * E) a a ha ha (by omega)
      (by apply early_bound2_mul_cap <;> omega)
    have hhsgn := early_nonnegative_mul_sign h h hh.1 hh.1 hsh hsh
    have hasgn := early_nonnegative_mul_sign a a ha.1 ha.1 hsa hsa
    have hnegB := early_box_fneg E b hb
    have hdiff := early_box_nonnegative_sub (2 * E) (mul h h) (mul a a) hhsq hasq hhsgn hasgn (by omega)
    have hnegH := early_box_fneg (2 * E) (mul h h) hhsq
    have hnegA := early_box_fneg (2 * E) (mul a a) hasq
    have hterm1 := early_box_fma E E (2 * E) (2 * E + 1)
      (fneg b) b (sub (mul h h) (mul a a)) hnegB hb hdiff
      (by omega) (by apply early_bound2_fma_cap <;> omega)
    have hterm2 := early_box_fma E E (2 * E) (2 * E + 1)
      h h (fneg (mul h h)) hh hh hnegH
