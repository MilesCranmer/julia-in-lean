theorem ldexp_nonfinite_identity {T : JuliaLean.base.float.FTy} (o : IEEEOps T) (x : JuliaLean.base.float.FV T)
    (e : Int) (hx : x.isfinite = false) : ldexp o x e = x := by
  rw [mfLdexpUnfold]
  have hm : exponentMask T ≤ x.magnitude := by
    apply Classical.byContradiction
    intro h
    have hf := (TruncProofs.isfinite_iff_mag x).mpr (by
      change x.magnitude < T.fmt.emax * 2 ^ T.fmt.sb
      change ¬ T.fmt.emax * 2 ^ T.fmt.sb ≤ x.magnitude at h
      omega)
    rw [hx] at hf
    contradiction
  have hbits : withoutBits x.toBits (signMask T) T.fmt.width = x.magnitude :=
    withoutSignBitMagnitude x
  simp only [Id.run, hbits, hm, ↓reduceIte, pure]

theorem ldexp_nan_nonfinite {T : JuliaLean.base.float.FTy} (x : JuliaLean.base.float.FV T) (hx : x.isnan = true) :
    x.isfinite = false := by
  simp only [Fl.isnan, Bool.and_eq_true, beq_iff_eq, bne_iff_ne] at hx
  simp only [Fl.isfinite, hx.1, bne_self_eq_false]

theorem ldexp_native_nan (machine : JuliaLean.Bindings.base.math.Machine)
    (T : JuliaLean.base.float.FTy) (x : JuliaLean.base.float.FV T) (e : Int) (hx : x.isnan = true) :
    (ldexpNative machine T x e).isnan = true := by
  cases T with
  | f16 =>
    have hwide := FloatRoundDirections.convert_nan (good_fty .f32) x hx
    change (Fl.convert (ldexp _ (Fl.convert x : JuliaLean.base.float.FV .f32) e) : JuliaLean.base.float.FV .f16).isnan = true
    rw [ldexp_nonfinite_identity _ _ e (ldexp_nan_nonfinite _ hwide)]
    exact FloatRoundDirections.convert_nan (good_fty .f16) _ hwide
  | f32 =>
    change (ldexp _ x e).isnan = true
    rw [ldexp_nonfinite_identity _ _ e (ldexp_nan_nonfinite x hx)]
    exact hx
  | f64 =>
    change (ldexp _ x e).isnan = true
    rw [ldexp_nonfinite_identity _ _ e (ldexp_nan_nonfinite x hx)]
    exact hx

theorem ldexp_convert_inf (S T : JuliaLean.base.float.FTy) (s : Bool) :
    (Fl.convert (Fl.inf s : JuliaLean.base.float.FV S) : JuliaLean.base.float.FV T) = Fl.inf s := by
  cases S <;> cases T <;> cases s <;> decide

theorem ldexp_native_inf (machine : JuliaLean.Bindings.base.math.Machine)
    (T : JuliaLean.base.float.FTy) (s : Bool) (e : Int) :
    ldexpNative machine T (Fl.inf s) e = Fl.inf s := by
  have hf : (Fl.inf s : JuliaLean.base.float.FV T).isfinite = false := by cases T <;> cases s <;> decide
  cases T with
  | f16 =>
    change (Fl.convert (ldexp _ (Fl.convert (Fl.inf s : JuliaLean.base.float.FV .f16) : JuliaLean.base.float.FV .f32) e) : JuliaLean.base.float.FV .f16) = _
    rw [ldexp_convert_inf]
    rw [ldexp_nonfinite_identity _ _ e (by cases s <;> decide)]
    exact ldexp_convert_inf .f32 .f16 s
  | f32 => exact ldexp_nonfinite_identity _ _ e hf
  | f64 => exact ldexp_nonfinite_identity _ _ e hf

theorem ldexp_native_nonfinite (machine : JuliaLean.Bindings.base.math.Machine)
    (T : JuliaLean.base.float.FTy) (x : JuliaLean.base.float.FV T) (e : Int) (hx : x.isfinite = false) :
    (ldexpNative machine T x e).isnan = x.isnan ∧
    (ldexpNative machine T x e).isinf = x.isinf ∧
    (x.isinf = true → (ldexpNative machine T x e).signbit = x.signbit) := by
  by_cases hn : x.isnan = true
  · have hres := ldexp_native_nan machine T x e hn
    have hix : x.isinf = false := by
      simp only [Fl.isnan, Bool.and_eq_true, beq_iff_eq, bne_iff_ne] at hn
      simp only [Fl.isinf, hn.1, beq_self_eq_true, Bool.true_and, beq_eq_false_iff_ne.mpr hn.2]
    have hir : (ldexpNative machine T x e).isinf = false := by
      simp only [Fl.isnan, Bool.and_eq_true, beq_iff_eq, bne_iff_ne] at hres
      simp only [Fl.isinf, hres.1, beq_self_eq_true, Bool.true_and, beq_eq_false_iff_ne.mpr hres.2]
    exact ⟨hres.trans hn.symm, hir.trans hix.symm, fun h => by rw [hix] at h; contradiction⟩
  · have hn' := Bool.eq_false_iff.mpr hn
    have heq := nonfinite_notnan_eq_inf x hx hn'
    have hres : ldexpNative machine T x e = x := by rw [heq, ldexp_native_inf]
    rw [hres]
    exact ⟨rfl, rfl, fun _ => rfl⟩

