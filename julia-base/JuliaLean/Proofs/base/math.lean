  have hn : a.toRat.1 * (b.toRat.2 : Int) + (-1) * (b.toRat.1 * (a.toRat.2 : Int)) = 0 := by
    rw [show a.key + (-1) * b.key = 0 by rw [hkey]; omega, Int.zero_mul] at hscale
    exact (Int.mul_eq_zero.mp hscale).resolve_right (by
      have := Int.natCast_pos.mpr (Fmt.den_pos T.fmt); omega)
  change (sub_float a b).signbit = false
  rw [mfSubRat a b ha hb, hn, hj, mfRoundRatZero _ (by have := Nat.two_pow_pos j; omega),
    has, Bool.false_and, mfZeroSignbit]

