      U.key * JuliaLean.base.float.FTy.f64.fmt.den := by decide
  have hU0 : 0 ≤ U.key := (mfKeySign U).2 hu.2.1
  have hD0 : (0 : Int) ≤ JuliaLean.base.float.FTy.f64.fmt.den := Int.natCast_nonneg _
  exact (generic_mul64_abs_bound a a U ha ha hu.1 hu.2.1 hu.2.2
    (by have := Int.mul_nonneg hU0 hD0; have := Int.mul_nonneg ha0 ha0; omega)
    (Int.le_trans ha2 hclosed)).1

/-- The common positive format key scale cancels from an exact integer norm bound. -/
theorem hypot_critical_integer_norm (a b : hypot_BoundaryVal) (an bn : Int)
    (ha : hypot_boundary_integer a an) (hb : hypot_boundary_integer b bn)
    (hnorm : a.key * a.key + b.key * b.key ≤ hypot_rescale_boundary.key * hypot_rescale_boundary.key) :
