/-- An input below exponent field564 scales into the subnormal/minimum-normal interval. -/
theorem hypot_scale_down_small (a : hypot_ScaleVal) (ha : a.isfinite = true)
    (hB : a.expField < 564) :
    (mul a hypot_scale_down).isfinite = true ∧
