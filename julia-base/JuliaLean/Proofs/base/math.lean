/-- Source subtraction is exact for finite nonnegative operands within a factor of two. -/
theorem generic_sterbenz_sub_exact {T : JuliaLean.base.float.FTy}
    (x y : JuliaLean.base.float.FV T) (hx : x.isfinite = true) (hy : y.isfinite = true)
    (hxn : 0 ≤ x.key) (hyn : 0 ≤ y.key)
    (hxy : x.key ≤ 2 * y.key) (hyx : y.key ≤ 2 * x.key) :
    (sub x y).isfinite = true ∧ (sub x y).key = x.key - y.key := by
  apply mfSubKey x y hx hy
  have h := mfSterbenz T x.key.natAbs y.key.natAbs
    (mfValueRepr x hx) (mfValueRepr y hy) (by omega) (by omega)
  rw [Int.natAbs_of_nonneg hxn, Int.natAbs_of_nonneg hyn] at h
  exact h

/-- The ordered half-to-one interval needed by the critical hypot boundary. -/
theorem generic_sterbenz_sub_ordered {T : JuliaLean.base.float.FTy}
    (x y : JuliaLean.base.float.FV T) (hx : x.isfinite = true) (hy : y.isfinite = true)
    (hsx : x.signbit = false) (hsy : y.signbit = false)
    (hhalf : x.key ≤ 2 * y.key) (horder : y.key ≤ x.key) :
    (sub x y).isfinite = true ∧ (sub x y).key = x.key - y.key := by
  have hxn := (mfKeySign x).2 hsx
  have hyn := (mfKeySign y).2 hsy
  exact generic_sterbenz_sub_exact x y hx hy hxn hyn hhalf (by omega)

/-- Integer-valued operands retain their exact integer difference after the
