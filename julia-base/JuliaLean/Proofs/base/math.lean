/-- Mathematical observation of a strictly negative IEEE value, including
negative infinity and excluding signed zero and every NaN. -/
def MathNegativeIEEE {T : FTy} (x : FV T) : Prop :=
  x.isnan = false ∧ x.signbit = true ∧ x.iszero = false

/-- The exact square-root rounding cell of a positive finite result. The lower
and upper endpoints are squares of the arithmetic midpoints to its adjacent
representable values, computed with unbounded integers. Endpoint ties belong
to the value whose stored least significant bit is even. This does not call
the implementation's square-root, division, or rounding algorithms. -/
def MathNearestSqrtCell {T : FTy} (x r : FV T) : Prop :=
  let before := JuliaLean.base.float.prevfloat r
  let after := JuliaLean.base.float.nextfloat r
  let xn := x.toRat.1
  let xd : Int := x.toRat.2
  let rn := r.toRat.1
  let rd : Int := r.toRat.2
  let bn := before.toRat.1
  let bd : Int := before.toRat.2
  let an := after.toRat.1
  let ad : Int := after.toRat.2
  let lowerNumerator := rn * bd + bn * rd
  let lowerDenominator := 2 * rd * bd
  let upperNumerator := rn * ad + an * rd
  let upperDenominator := 2 * rd * ad
  before.isfinite = true ∧ after.isfinite = true ∧
    0 ≤ bn ∧ 0 < lowerDenominator ∧ 0 < upperDenominator ∧
    lowerNumerator ^ 2 * xd ≤ xn * lowerDenominator ^ 2 ∧
    xn * upperDenominator ^ 2 ≤ upperNumerator ^ 2 * xd ∧
    ((lowerNumerator ^ 2 * xd = xn * lowerDenominator ^ 2 ∨
      xn * upperDenominator ^ 2 = upperNumerator ^ 2 * xd) →
      r.toBits % 2 = 0)

