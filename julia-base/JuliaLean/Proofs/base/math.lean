/-- Squaring the initial square-root result cannot overflow. The exact
predecessor-of2^512 bound is essential at this endpoint. -/
theorem early_sqrt64_square_finite (s : FV .f64)
    (hs : s.isfinite = true) (hss : s.signbit = false) :
    (mul (jlSqrtLlvm s) (jlSqrtLlvm s)).isfinite = true ∧
    (mul (jlSqrtLlvm s) (jlSqrtLlvm s)).signbit = false ∧
    (mul (jlSqrtLlvm s) (jlSqrtLlvm s)).key ≤ (Fl.floatmax : FV .f64).key := by
