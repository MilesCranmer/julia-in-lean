    · have hc : ¬ q ≥ 2 ^ (JuliaLean.base.float.FTy.f64.fmt.sb + 1) := by change ¬ q ≥ 2 ^ 53; omega
      have hx : ¬ (-1074 : Int) + JuliaLean.base.float.FTy.f64.fmt.bias + JuliaLean.base.float.FTy.f64.fmt.sb ≥
          JuliaLean.base.float.FTy.f64.fmt.emax := by decide
      simp only [Fl.packRounded, beq_eq_false_iff_ne.mpr hq0, Bool.false_eq_true,
        ↓reduceIte, hc, hx]
      by_cases hsmall : q < 2 ^ JuliaLean.base.float.FTy.f64.fmt.sb
      · simp only [hsmall, ↓reduceIte, NextProofs.encode, NextProofs.signMask]
      · have heq : q = 2 ^ 52 := by change ¬ q < 2 ^ 52 at hsmall; omega
        subst q
        cases s <;> rfl
