theorem ldexp_round_underflow (T : JuliaLean.base.float.FTy) (s : Bool) (c i j : Nat) (k : Int)
    (hc₁ : 2 ^ T.fmt.sb ≤ c) (hc₂ : c < 2 ^ (T.fmt.sb + 1))
    (hk : k = (T.fmt.sb : Int) + i - j + T.fmt.bias) (hk₁ : k ≤ -(T.fmt.sb : Int) - 1) :
    (Fl.roundRat (ldexp_signed_pow s c i) (2 ^ j) s : JuliaLean.base.float.FV T) = Fl.zero s := by
  have hc : c ≠ 0 := by have := Nat.two_pow_pos T.fmt.sb; omega
  have hn := ldexp_signed_pow_ne s c i hc
  have hlog := mfLog2Eq c T.fmt.sb hc₁ hc₂
  have hcp := Nat.mul_ne_zero hc (Nat.ne_of_gt (Nat.two_pow_pos i))
  have he : Fl.floorLog2Rat (c * 2 ^ i) (2 ^ j) = (T.fmt.sb : Int) + i - j := by
    rw [Fl.floorLog2Rat_pow _ _ hcp, Fl.log2_mul_pow c i hc, hlog, Int.natCast_add]
  have hfmt := mfFmtBounds T
  have hgood := good_fty T
  have hover : ¬ (T.fmt.sb : Int) + i - j ≥ (T.fmt.emax : Int) - T.fmt.bias := by
    have := hgood.emax_eq
    have := hgood.bias_pos
    omega
  simp only [Fl.roundRat, beq_iff_eq, Nat.ne_of_gt (Nat.two_pow_pos j), hn, ↓reduceIte,
    ldexp_signed_pow_abs, ldexp_signed_pow_sign s c i hc, he, hover]
  split
  · rfl
  · rename_i htiny
    have heq : k = -(T.fmt.sb : Int) - 1 := by omega
    have hmax : max ((T.fmt.sb : Int) + i - j - T.fmt.sb) (1 - (T.fmt.bias : Int) - T.fmt.sb) =
        1 - (T.fmt.bias : Int) - T.fmt.sb := by omega
    have hnegative : ¬ (1 - (T.fmt.bias : Int) - T.fmt.sb ≥ 0) := by omega
    have hnat : (-(1 - (T.fmt.bias : Int) - T.fmt.sb)).toNat = T.fmt.bias + T.fmt.sb - 1 := by omega
    rw [hmax]
    simp only [hnegative, ↓reduceIte, hnat]
    have hj : j = T.fmt.sb + 2 + (i + (T.fmt.bias + T.fmt.sb - 1)) := by omega
    have hnum : c * 2 ^ i * 2 ^ (T.fmt.bias + T.fmt.sb - 1) =
        c * 2 ^ (i + (T.fmt.bias + T.fmt.sb - 1)) := by rw [Nat.mul_assoc, ← Nat.pow_add]
    rw [hnum, hj, Nat.pow_add 2 (T.fmt.sb + 2) (i + (T.fmt.bias + T.fmt.sb - 1)),
      roundQuotient_scale _ _ _ (Nat.two_pow_pos _)]
    have hsmall : 2 * c < 2 ^ (T.fmt.sb + 2) := by
      have hp : 2 ^ (T.fmt.sb + 2) = 2 * 2 ^ (T.fmt.sb + 1) := by
        rw [show T.fmt.sb + 2 = T.fmt.sb + 1 + 1 by omega, Nat.pow_succ, Nat.mul_comm]
      rw [hp]
      exact Nat.mul_lt_mul_of_pos_left hc₂ (by decide)
    rw [ldexp_roundQuotient_small _ _ hsmall]
    simp only [Fl.packRounded, beq_self_eq_true, ↓reduceIte]

theorem ldexp_round_gradual (T : JuliaLean.base.float.FTy) (s : Bool) (c i j : Nat) (k : Int)
    (hc₁ : 2 ^ T.fmt.sb ≤ c) (hc₂ : c < 2 ^ (T.fmt.sb + 1))
    (hk : k = (T.fmt.sb : Int) + i - j + T.fmt.bias)
    (hk₁ : -(T.fmt.sb : Int) ≤ k) (hk₂ : k ≤ 0) :
    mul (Fl.ofBits ((T.fmt.bias - T.fmt.sb - 1) * 2 ^ T.fmt.sb) : JuliaLean.base.float.FV T)
      (NextProofs.encode T s ((k + T.fmt.sb + 1).toNat * 2 ^ T.fmt.sb + (c - 2 ^ T.fmt.sb))) =
      Fl.roundRat (ldexp_signed_pow s c i) (2 ^ j) s := by
  let Bz := T.fmt.bias - T.fmt.sb - 1
  let Bw := (k + T.fmt.sb + 1).toNat
  let z : JuliaLean.base.float.FV T := NextProofs.encode T false (Bz * 2 ^ T.fmt.sb + 0)
  let w : JuliaLean.base.float.FV T := NextProofs.encode T s (Bw * 2 ^ T.fmt.sb + (c - 2 ^ T.fmt.sb))
  have hfmt := mfFmtBounds T
  have hgood := good_fty T
  have hE := hgood.emax_eq
  have hP := Nat.two_pow_pos T.fmt.sb
  have hpow : 2 ^ (T.fmt.sb + 1) = 2 * 2 ^ T.fmt.sb := by rw [Nat.pow_succ, Nat.mul_comm]
  have hBz₁ : 1 ≤ Bz := by dsimp [Bz]; omega
  have hBz₂ : Bz < T.fmt.emax := by dsimp [Bz]; omega
  have hBw₁ : 1 ≤ Bw := by dsimp [Bw]; omega
  have hBw₂ : Bw < T.fmt.emax := by dsimp [Bw]; omega
  have hfrac : c - 2 ^ T.fmt.sb < 2 ^ T.fmt.sb := by omega
  obtain ⟨hsz, _, _, _, hzf, hzk⟩ := mfEncodeParts T false Bz 0 hBz₂ hP
  obtain ⟨hsw, _, _, _, hwf, hwk⟩ := mfEncodeParts T s Bw (c - 2 ^ T.fmt.sb) hBw₂ hfrac
  change z.signbit = false at hsz
  change w.signbit = s at hsw
  change z.isfinite = true at hzf
  change w.isfinite = true at hwf
  change z.key = _ at hzk
  change w.key = _ at hwk
  simp only [Bool.false_eq_true, ↓reduceIte] at hzk
  rw [mfMagKeyNormal T Bz 0 (by omega) hP, Nat.zero_add] at hzk
  rw [mfMagKeyNormal T Bw (c - 2 ^ T.fmt.sb) (by omega) hfrac,
    Nat.sub_add_cancel hc₁] at hwk
  have hnat : (2 ^ T.fmt.sb * 2 ^ (Bz - 1)) * (c * 2 ^ (Bw - 1)) * 2 ^ j =
      c * 2 ^ i * T.fmt.den * T.fmt.den := by
    calc
      _ = c * 2 ^ (T.fmt.sb + (Bz - 1) + (Bw - 1) + j) := by
        simp only [Nat.pow_add]
        ac_rfl
      _ = c * 2 ^ (i + (T.fmt.bias + T.fmt.sb - 1) + (T.fmt.bias + T.fmt.sb - 1)) := by
        have he : T.fmt.sb + (Bz - 1) + (Bw - 1) + j =
            i + (T.fmt.bias + T.fmt.sb - 1) + (T.fmt.bias + T.fmt.sb - 1) := by
          dsimp [Bz, Bw]
          omega
        rw [he]
      _ = _ := by simp only [Fmt.den, Nat.pow_add, Nat.mul_assoc]
  have hkey : z.key * w.key * ((2 ^ j : Nat) : Int) =
      ldexp_signed_pow s c i * ((T.fmt.den : Int) * (T.fmt.den : Int)) := by
    rw [hzk, hwk]
    cases s <;> simp only [ldexp_signed_pow, Bool.false_eq_true, ↓reduceIte,
      Int.mul_neg, Int.neg_mul, ← Int.natCast_mul]
    · simpa only [Nat.mul_assoc] using congrArg (fun n : Nat => (n : Int)) hnat
    · simpa only [Nat.mul_assoc] using congrArg (fun n : Nat => -(n : Int)) hnat
  obtain ⟨jz, hjz⟩ := mfToRatPow2 z hzf
  obtain ⟨jw, hjw⟩ := mfToRatPow2 w hwf
  have hrz := (Fl.toRat_key (good_fty T) z hzf).2
  have hrw := (Fl.toRat_key (good_fty T) w hwf).2
  have hprod : (z.toRat.1 * w.toRat.1) * ((T.fmt.den : Int) * (T.fmt.den : Int)) =
      (z.key * w.key) * ((2 ^ (jz + jw) : Nat) : Int) := by
    calc
      _ = (z.toRat.1 * T.fmt.den) * (w.toRat.1 * T.fmt.den) := by ac_rfl
      _ = (z.key * z.toRat.2) * (w.key * w.toRat.2) := by rw [hrz, hrw]
      _ = _ := by rw [hjz, hjw, Nat.pow_add, Int.natCast_mul]; ac_rfl
  have hcross : (z.toRat.1 * w.toRat.1) * ((2 ^ j : Nat) : Int) =
      ldexp_signed_pow s c i * ((2 ^ (jz + jw) : Nat) : Int) := by
    have hden : (0 : Int) < T.fmt.den := Int.natCast_pos.mpr T.fmt.den_pos
    apply Int.eq_of_mul_eq_mul_right (Int.ne_of_gt (Int.mul_pos hden hden))
    calc
      _ = ((z.toRat.1 * w.toRat.1) * ((T.fmt.den : Int) * (T.fmt.den : Int))) *
          ((2 ^ j : Nat) : Int) := by ac_rfl
      _ = ((z.key * w.key) * ((2 ^ j : Nat) : Int)) * ((2 ^ (jz + jw) : Nat) : Int) := by
        rw [hprod]
        ac_rfl
      _ = _ := by rw [hkey]; ac_rfl
  have hzeq : (Fl.ofBits ((T.fmt.bias - T.fmt.sb - 1) * 2 ^ T.fmt.sb) : JuliaLean.base.float.FV T) = z := by
    simp only [z, Bz, NextProofs.encode, Bool.false_eq_true, ↓reduceIte, Nat.zero_add, Nat.add_zero]
  rw [hzeq]
  change mul_float z w = _
  rw [mfMulRat z w hzf hwf, hsz, hsw]
  have hsign : (false != s) = s := by cases s <;> rfl
  rw [hsign, hjz, hjw, ← Nat.pow_add]
  exact ldexp_roundRat_dyadic_equal _ _ (jz + jw) j s hcross

theorem ldexp_round_kernel (T : JuliaLean.base.float.FTy) (s : Bool) (c i j : Nat) (k : Int)
    (hc₁ : 2 ^ T.fmt.sb ≤ c) (hc₂ : c < 2 ^ (T.fmt.sb + 1))
    (hk : k = (T.fmt.sb : Int) + i - j + T.fmt.bias) :
    (Fl.roundRat (ldexp_signed_pow s c i) (2 ^ j) s : JuliaLean.base.float.FV T) =
      ldexp_normalized_kernel T s c k := by
  unfold ldexp_normalized_kernel
  split
  · rename_i h
    exact ldexp_round_overflow T s c i j k hc₁ hc₂ hk h
  · rename_i h
    split
    · rename_i hpos
      exact ldexp_round_normal T s c i j k hc₁ hc₂ hk hpos (by omega)
    · rename_i hnonpos
      split
      · rename_i hsmall
        exact ldexp_round_underflow T s c i j k hc₁ hc₂ hk hsmall
      · rename_i hgrad
        exact (ldexp_round_gradual T s c i j k hc₁ hc₂ hk (by omega) (by omega)).symm

theorem ldexp_signed_pow_add (s : Bool) (c i j : Nat) :
    ldexp_signed_pow s c (i + j) = ldexp_signed_pow s c i * ((2 ^ j : Nat) : Int) := by
  cases s <;> simp only [ldexp_signed_pow, Bool.false_eq_true, ↓reduceIte,
    Nat.pow_add, ← Nat.mul_assoc, Int.natCast_mul, Int.neg_mul]

theorem ldexp_qpowtwo (e : Int) :
    QPowTwo e = (((2 ^ e.toNat : Nat) : Int), 2 ^ (-e).toNat) := by
  unfold QPowTwo
  by_cases h : 0 ≤ e
  · have hz : (-e).toNat = 0 := by omega
    simp only [h, ↓reduceIte, hz, Nat.pow_zero, Int.natCast_pow]
    rfl
  · have hz : e.toNat = 0 := by omega
    simp only [h, ↓reduceIte, hz, Nat.pow_zero, Int.natCast_one]

theorem ldexp_input_normalization {T : JuliaLean.base.float.FTy} (x : JuliaLean.base.float.FV T)
    (hx : x.isfinite = true) (hz : x.magnitude ≠ 0) :
    x.toRat.1 * ((2 ^ (T.fmt.bias + 2 * T.fmt.sb - 1) : Nat) : Int) =
      ldexp_signed_pow x.signbit (mfNormSig x) (magKey T.fmt x.magnitude).log2 * (x.toRat.2 : Int) := by
  obtain ⟨_, _, hrel, _, _⟩ := mfNormSigFacts x hx hz
  have hk := (Fl.toRat_key (good_fty T) x hx).2
  have hscale : x.key * ((2 ^ T.fmt.sb : Nat) : Int) =
      ldexp_signed_pow x.signbit (mfNormSig x) (magKey T.fmt x.magnitude).log2 := by
    unfold Fl.key
    cases x.signbit <;> simp only [ldexp_signed_pow, Bool.false_eq_true, ↓reduceIte,
      Int.neg_mul, ← Int.natCast_mul, hrel]
  have hb := (good_fty T).bias_pos
  have hd : 2 ^ (T.fmt.bias + 2 * T.fmt.sb - 1) = T.fmt.den * 2 ^ T.fmt.sb := by
    unfold Fmt.den
    rw [← Nat.pow_add]
    congr 1
    omega
  rw [hd, Int.natCast_mul]
  calc
    _ = (x.toRat.1 * (T.fmt.den : Int)) * ((2 ^ T.fmt.sb : Nat) : Int) := by ac_rfl
    _ = (x.key * ((2 ^ T.fmt.sb : Nat) : Int)) * (x.toRat.2 : Int) := by rw [hk]; ac_rfl
    _ = _ := by rw [hscale]

theorem ldexp_scaled_kernel {T : JuliaLean.base.float.FTy} (x : JuliaLean.base.float.FV T)
    (e : Int) (hx : x.isfinite = true) (hz : x.magnitude ≠ 0) :
    (Fl.roundRat (QMul x.toRat (QPowTwo e)).1 (QMul x.toRat (QPowTwo e)).2 x.signbit : JuliaLean.base.float.FV T) =
      ldexp_normalized_kernel T x.signbit (mfNormSig x)
        (((magKey T.fmt x.magnitude).log2 : Int) - T.fmt.sb + 1 + e) := by
  let L := (magKey T.fmt x.magnitude).log2
  let b := T.fmt.bias + 2 * T.fmt.sb - 1
  let i := L + e.toNat
  let j := b + (-e).toNat
  obtain ⟨jx, hjx⟩ := mfToRatPow2 x hx
  have hnorm := ldexp_input_normalization x hx hz
  change x.toRat.1 * ((2 ^ b : Nat) : Int) =
    ldexp_signed_pow x.signbit (mfNormSig x) L * (x.toRat.2 : Int) at hnorm
  rw [hjx] at hnorm
  have hcross : (x.toRat.1 * ((2 ^ e.toNat : Nat) : Int)) * ((2 ^ j : Nat) : Int) =
      ldexp_signed_pow x.signbit (mfNormSig x) i * ((2 ^ (jx + (-e).toNat) : Nat) : Int) := by
    dsimp only [i, j]
    rw [ldexp_signed_pow_add, Nat.pow_add 2 b (-e).toNat, Nat.pow_add 2 jx (-e).toNat]
    simp only [Int.natCast_mul]
    calc
      _ = (x.toRat.1 * ((2 ^ b : Nat) : Int)) * ((2 ^ e.toNat : Nat) : Int) *
          ((2 ^ (-e).toNat : Nat) : Int) := by ac_rfl
      _ = _ := by rw [hnorm]; ac_rfl
  rw [ldexp_qpowtwo]
  dsimp only [QMul]
  rw [hjx, ← Nat.pow_add]
  rw [ldexp_roundRat_dyadic_equal _ _ (jx + (-e).toNat) j x.signbit hcross]
  obtain ⟨hc₁, hc₂, _, _, _⟩ := mfNormSigFacts x hx hz
  apply ldexp_round_kernel T x.signbit (mfNormSig x) i j _ hc₁ hc₂
  have hb := (good_fty T).bias_pos
  dsimp only [i, j, b, L]
  omega

end JuliaLean.ChatGPT.Batch4.Group9



namespace JuliaLean.ChatGPT.Batch4.Group9
open JuliaLean JuliaLean.C JuliaLean.base.float JuliaLean.base.math
open JuliaLean.Promotion (Fl)
open JuliaLean.Proofs.base.float JuliaLean.Proofs.base.math

/-- Exact half-unit error of nearest-even integer quotient rounding. -/
theorem root_round_quotient_error (n d : Nat) (hd : 0 < d) :
    -(d : Int) ≤ 2 * ((Fl.roundQuotient n d : Int) * d - n) ∧
    2 * ((Fl.roundQuotient n d : Int) * d - n) ≤ (d : Int) := by
  have hm := Nat.mod_lt n hd
  have hdiv : (n / d) * d + n % d = n := by
    simpa only [Nat.mul_comm, Nat.add_comm] using Nat.mod_add_div n d
  have hdivI : ((n / d : Nat) : Int) * d + ((n % d : Nat) : Int) = n := by
    exact_mod_cast hdiv
  unfold Fl.roundQuotient
  dsimp only
  split
  · rename_i hc
    have hnear : d ≤ 2 * (n % d) := by
      simp only [Bool.or_eq_true, decide_eq_true_eq, Bool.and_eq_true, beq_iff_eq] at hc
      omega
    simp only [Int.natCast_add, Int.natCast_one, Int.add_mul, Int.one_mul]
    omega
  · rename_i hc
    have hnear : 2 * (n % d) ≤ d := by
      simp only [Bool.or_eq_true, decide_eq_true_eq, Bool.and_eq_true, beq_iff_eq] at hc
      omega
    omega

/-- Large integer inputs have at most half one rounding-grid step of error.
Keys retain exact dyadic values even at a carry to the infinity encoding. -/
theorem root_round_integer_error (T : JuliaLean.base.float.FTy) (n : Int) (z : Bool) (hn : n ≠ 0)
    (hb : n.natAbs.log2 + T.fmt.bias < T.fmt.emax)
    (hl : T.fmt.sb ≤ n.natAbs.log2) :
    let d := 2 ^ (n.natAbs.log2 - T.fmt.sb);
    let err := (Fl.roundRat n 1 z : JuliaLean.base.float.FV T).key - n * (T.fmt.den : Int);
    -((d * T.fmt.den : Nat) : Int) ≤ 2 * err ∧
      2 * err ≤ ((d * T.fmt.den : Nat) : Int) := by
  let d := 2 ^ (n.natAbs.log2 - T.fmt.sb)
  let q := Fl.roundQuotient n.natAbs d
  have hq := root_round_quotient_error n.natAbs d (Nat.two_pow_pos _)
  change -(d : Int) ≤ 2 * ((q : Int) * d - n.natAbs) ∧
    2 * ((q : Int) * d - n.natAbs) ≤ (d : Int) at hq
  have hlow := Int.mul_le_mul_of_nonneg_right hq.1 (Int.natCast_nonneg T.fmt.den)
  have hhigh := Int.mul_le_mul_of_nonneg_right hq.2 (Int.natCast_nonneg T.fmt.den)
  let A : Int := ((q * d * T.fmt.den : Nat) : Int)
  let B : Int := (n.natAbs : Int) * T.fmt.den
  let G : Int := ((d * T.fmt.den : Nat) : Int)
  have hnorm : (2 * ((q : Int) * d - n.natAbs)) * T.fmt.den = 2 * (A - B) := by
    dsimp only [A, B]
    simp only [Int.natCast_mul, Int.mul_sub, Int.sub_mul]
    ac_rfl
  rw [hnorm, ← Int.natCast_mul] at hhigh
  rw [hnorm, Int.neg_mul, ← Int.natCast_mul] at hlow
  change -G ≤ 2 * (A - B) at hlow
  change 2 * (A - B) ≤ G at hhigh
  have hk := FloatRoundDirections.roundRat_integer_key T n z hn hb hl
  change (Fl.roundRat n 1 z : JuliaLean.base.float.FV T).key = if n < 0 then -A else A at hk
  change -G ≤ 2 * ((Fl.roundRat n 1 z : JuliaLean.base.float.FV T).key - n * T.fmt.den) ∧
    2 * ((Fl.roundRat n 1 z : JuliaLean.base.float.FV T).key - n * T.fmt.den) ≤ G
  by_cases hs : n < 0
  · have hnval : n = -(n.natAbs : Int) := by omega
    have hnD : n * (T.fmt.den : Int) = -B := by rw [hnval, Int.neg_mul]
    rw [hk, ite_eq_left hs, hnD]
    omega
  · have hnval : n = (n.natAbs : Int) := by omega
    have hnD : n * (T.fmt.den : Int) = B := by rw [hnval]
    rw [hk, ite_eq_right hs, hnD]
    exact ⟨hlow, hhigh⟩

set_option maxRecDepth 4096 in
set_option exponentiation.threshold 2048 in
/-- A uniform half-step error bound below any binary64 integer binade cap. -/
theorem root_round64_integer_error_bound (n : Int) (z : Bool) (L : Nat)
    (hL : 54 ≤ L) (hLmax : L ≤ 1024) (hn : n.natAbs < 2 ^ L) :
    ((((Fl.roundRat n 1 z : JuliaLean.base.float.FV .f64).key -
        n * (JuliaLean.base.float.FTy.f64.fmt.den : Int)).natAbs : Nat) : Int) ≤
      ((2 ^ (L - 54) * JuliaLean.base.float.FTy.f64.fmt.den : Nat) : Int) := by
  by_cases hsmall : n.natAbs < 2 ^ 53
  · have hk := (FloatRoundDirections.roundRat_smallKey (good_fty .f64) n z hsmall).2
    rw [hk, Int.sub_self, Int.natAbs_zero, Int.natCast_zero]
    exact Int.natCast_nonneg _
  have hnzero : n ≠ 0 := by intro hz; simp only [hz, Int.natAbs_zero] at hsmall; omega
  have hnabs : n.natAbs ≠ 0 := by omega
  have hlogHi : n.natAbs.log2 < L := (Nat.log2_lt hnabs).mpr hn
  have hlogLo : 53 ≤ n.natAbs.log2 := (Nat.le_log2 hnabs).mpr (by omega)
  have hb : n.natAbs.log2 + JuliaLean.base.float.FTy.f64.fmt.bias < JuliaLean.base.float.FTy.f64.fmt.emax := by
    change n.natAbs.log2 + 1023 < 2047
    omega
  have hl : JuliaLean.base.float.FTy.f64.fmt.sb ≤ n.natAbs.log2 := by change 52 ≤ _; omega
  have hh := root_round_integer_error .f64 n z hnzero hb hl
  let d : Nat := 2 ^ (n.natAbs.log2 - 52)
  let G : Int := ((d * JuliaLean.base.float.FTy.f64.fmt.den : Nat) : Int)
  let E : Int := ((2 ^ (L - 54) * JuliaLean.base.float.FTy.f64.fmt.den : Nat) : Int)
  let err := (Fl.roundRat n 1 z : JuliaLean.base.float.FV .f64).key - n * (JuliaLean.base.float.FTy.f64.fmt.den : Int)
  change -G ≤ 2 * err ∧ 2 * err ≤ G at hh
  have hpow : d * JuliaLean.base.float.FTy.f64.fmt.den ≤ 2 * (2 ^ (L - 54) * JuliaLean.base.float.FTy.f64.fmt.den) := by
    calc
      d * JuliaLean.base.float.FTy.f64.fmt.den ≤ 2 ^ (L - 53) * JuliaLean.base.float.FTy.f64.fmt.den := by
        apply Nat.mul_le_mul_right
        exact Nat.pow_le_pow_right (by decide) (by omega)
      _ = 2 * (2 ^ (L - 54) * JuliaLean.base.float.FTy.f64.fmt.den) := by
        rw [show L - 53 = (L - 54) + 1 by omega, Nat.pow_succ]
        ac_rfl
  have hGE : G ≤ 2 * E := by
    dsimp only [G, E]
    exact_mod_cast hpow
  have herr : -E ≤ err ∧ err ≤ E := by omega
  change (err.natAbs : Int) ≤ E
  omega

/-- The same bound after canceling the exact integer-value key scale. -/
theorem root_round64_integer_value_error (n r : Int) (z : Bool) (L : Nat)
    (hL : 54 ≤ L) (hLmax : L ≤ 1024) (hn : n.natAbs < 2 ^ L)
    (hr : (Fl.roundRat n 1 z : JuliaLean.base.float.FV .f64).key = r * (JuliaLean.base.float.FTy.f64.fmt.den : Int)) :
    (r - n).natAbs ≤ 2 ^ (L - 54) := by
  have hh := root_round64_integer_error_bound n z L hL hLmax hn
  rw [hr, ← Int.sub_mul, Int.natAbs_mul, Int.natAbs_natCast] at hh
  exact Nat.le_of_mul_le_mul_right (Int.ofNat_le.mp hh) JuliaLean.base.float.FTy.f64.fmt.den_pos

end JuliaLean.ChatGPT.Batch4.Group9



namespace JuliaLean.ChatGPT.Batch4.Group9
open JuliaLean JuliaLean.C JuliaLean.base.float JuliaLean.base.math
open JuliaLean.Promotion (Fl)
