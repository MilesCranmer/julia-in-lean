/-- The rational midpoint specification expressed in common integer keys. -/
theorem generic_sqrt_cell_key_interval {T : JuliaLean.base.float.FTy}
    (x r : JuliaLean.base.float.FV T) (hx : x.isfinite = true) (hr : r.isfinite = true)
    (hc : MathNearestSqrtCell x r) :
