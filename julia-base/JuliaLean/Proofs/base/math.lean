  apply Classical.byContradiction
  intro h
  have hsq := Int.mul_self_lt_mul_self hH0 (show hypot_rescale_boundary.key < a.key by omega)
  omega


/-- Reaching H forces the leading operand above the lower endpoint of binade460. -/
theorem hypot_critical_leading_lower (a b : hypot_BoundaryVal)
    (ha : a.isfinite = true) (hb : b.isfinite = true)
    (hsa : a.signbit = false) (hsb : b.signbit = false) (hba : b.key ≤ a.key)
    (hst : (jlFmaFloat a a (mul b b)).signbit = false)
    (hcritical : (jlSqrtLlvm (jlFmaFloat a a (mul b b))).key = hypot_rescale_boundary.key) :
    hypot_critical_input_lower.key ≤ a.key := by
  apply Classical.byContradiction
  intro h
  have hh := hypot_critical_small_leading_root a b ha hb hsa hsb hba (by omega) hst
  rw [hcritical] at hh
  omega

/-- Reaching H forces the leading operand into binade460. -/
theorem hypot_critical_leading_binade (a b : hypot_BoundaryVal)
    (ha : a.isfinite = true) (hb : b.isfinite = true)
    (hsa : a.signbit = false) (hsb : b.signbit = false) (hba : b.key ≤ a.key)
    (hst : (jlFmaFloat a a (mul b b)).signbit = false)
    (hcritical : (jlSqrtLlvm (jlFmaFloat a a (mul b b))).key = hypot_rescale_boundary.key)
    (hnorm : a.key * a.key + b.key * b.key ≤ hypot_rescale_boundary.key * hypot_rescale_boundary.key) :
    a.expField = 1483 := by
  have hlow := hypot_critical_leading_lower a b ha hb hsa hsb hba hst hcritical
  have hhigh := hypot_critical_leading_upper a b hsa hnorm
  have hmaglo := hypot_positive_key_le_magnitude hypot_critical_input_lower a (by decide) hsa hlow
  have hmaghi := hypot_positive_key_le_magnitude a hypot_rescale_boundary hsa (by decide) hhigh
  have hlo : 1483 * 2 ^ 52 ≤ a.magnitude := hmaglo
  have hhi : a.magnitude < 1484 * 2 ^ 52 := by
    change a.magnitude ≤ 0x5cbfffffffffffff at hmaghi
    omega
  rw [Fl.expField_eq]
  change a.magnitude / 2 ^ 52 = 1483
  omega

/-- Discreteness below H makes the rounded operand square no larger than RN(H²). -/
theorem hypot_critical_square_order (a : hypot_BoundaryVal)
