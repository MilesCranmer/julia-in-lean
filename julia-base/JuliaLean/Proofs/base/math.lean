/-- Absolute rational numerators obey the same exact common-key scaling. -/
theorem early_toRat_abs_key {T : FTy} (x : FV T) (hx : x.isfinite = true) :
    (x.toRat.1.natAbs : Int) * (T.fmt.den : Int) =
      (x.key.natAbs : Int) * (x.toRat.2 : Int) := by
  have h := congrArg Int.natAbs (Fl.toRat_key (good_fty T) x hx).2
  have h' : x.toRat.1.natAbs * T.fmt.den = x.key.natAbs * x.toRat.2 := by
    simpa only [Int.natAbs_mul, Int.natAbs_natCast] using h
  exact_mod_cast h'

/-- A finite nonzero value has a nonzero exact rational numerator. -/
theorem early_toRat_numerator_nonzero {T : FTy} (x : FV T)
    (hx : x.isfinite = true) (hz : x.iszero = false) : x.toRat.1 ≠ 0 := by
  intro hn
  have hr := Fl.toRat_key (good_fty T) x hx
  have hprod : x.key * (x.toRat.2 : Int) = 0 := by simpa only [hn, Int.zero_mul] using hr.2.symm
  have hden : (x.toRat.2 : Int) ≠ 0 := by exact_mod_cast Nat.ne_of_gt hr.1
  have hk : x.key = 0 := (Int.mul_eq_zero.mp hprod).resolve_right hden
  have hm := JuliaLean.Proofs.base.math.mfMagZeroOfKey x hk
  have hzero : x.iszero = true := by simpa only [Fl.iszero, beq_iff_eq] using hm
  rw [hzero] at hz
  cases hz

/-- A quotient bound in common keys transfers exactly to its signed rational
numerator and its generally non-power-of-two denominator. -/
theorem early_div_rational_abs_bound {T : FTy} (x y : FV T) (U : Int)
    (hx : x.isfinite = true) (hy : y.isfinite = true)
    (hbound : (x.key.natAbs : Int) * (T.fmt.den : Int) ≤ U * (y.key.natAbs : Int)) :
    ((if y.toRat.1 < 0 then -(x.toRat.1 * (y.toRat.2 : Int))
       else x.toRat.1 * (y.toRat.2 : Int)).natAbs : Int) * (T.fmt.den : Int) ≤
      U * ((x.toRat.2 * y.toRat.1.natAbs : Nat) : Int) := by
  have hD : (0 : Int) < T.fmt.den := Int.natCast_pos.mpr T.fmt.den_pos
  have hkx := early_toRat_abs_key x hx
  have hky := early_toRat_abs_key y hy
  have hN : (if y.toRat.1 < 0 then -(x.toRat.1 * (y.toRat.2 : Int))
      else x.toRat.1 * (y.toRat.2 : Int)).natAbs = x.toRat.1.natAbs * y.toRat.2 := by
    split <;> simp only [Int.natAbs_neg, Int.natAbs_mul, Int.natAbs_natCast]
  rw [hN, Int.natCast_mul, Int.natCast_mul]
  apply (Int.mul_le_mul_right hD).mp
  calc
    (((x.toRat.1.natAbs : Int) * y.toRat.2) * T.fmt.den) * T.fmt.den =
        ((x.toRat.1.natAbs : Int) * T.fmt.den) * y.toRat.2 * T.fmt.den := by ac_rfl
    _ = ((x.key.natAbs : Int) * x.toRat.2) * y.toRat.2 * T.fmt.den := by rw [hkx]
    _ = ((x.key.natAbs : Int) * T.fmt.den) * ((x.toRat.2 : Int) * y.toRat.2) := by ac_rfl
    _ ≤ (U * (y.key.natAbs : Int)) * ((x.toRat.2 : Int) * y.toRat.2) :=
      Int.mul_le_mul_of_nonneg_right hbound
