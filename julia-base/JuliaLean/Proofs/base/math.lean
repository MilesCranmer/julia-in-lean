/-- Exact native constants used by all three numerical scaling branches. -/
theorem early_hypot64_constants :
    jlSqrtLlvm (div (eps_float .f64) (Fl.ofInt 2)) = (Fl.ofBits 0x3e46a09e667f3bcd : FV .f64) ∧
    jlSqrtLlvm (floatmin_float .f64) = (Fl.ofBits 0x2000000000000000 : FV .f64) ∧
    mul (eps_float .f64) (Fl.ofBits 0x2000000000000000) = (Fl.ofBits 0x1cc0000000000000 : FV .f64) ∧
    div (fone .f64) (Fl.ofBits 0x1cc0000000000000) = (Fl.ofBits 0x6320000000000000 : FV .f64) ∧
    jlSqrtLlvm (div (floatmax_float .f64) (Fl.ofInt 2)) = (Fl.ofBits 0x5fe6a09e667f3bcc : FV .f64) := by
  decide

/-- The unbalanced branch returns one of the original magnitudes before any
scaling or correction. Its only numerical premise is the actual cutoff test. -/
theorem early_hypot_generic_fast {α γ β : Type} (o : GenericHypotOps α β)
    (absRight : γ → β) (x : α) (y : γ) (cutoff : β)
    (hcutoff : o.sqrt (o.div o.eps o.two) = .ok cutoff)
    (hinfLeft : o.isinf (o.div (o.abs x) (o.oneunit (o.abs x))) = false)
    (hinfRight : o.isinf (o.div (absRight y) (o.oneunit (absRight y))) = false)
    (hsmall :
      let a := o.div (o.abs x) (o.oneunit (o.abs x))
      let b := o.div (absRight y) (o.oneunit (absRight y))
      o.le (if o.greater b a then a else b)
        (o.mul (if o.greater b a then b else a) cutoff) = true) :
    hypotGeneric o absRight x y = .ok
      (if o.greater (o.div (absRight y) (o.oneunit (absRight y)))
          (o.div (o.abs x) (o.oneunit (o.abs x))) then absRight y else o.abs x) := by
  dsimp only at hsmall
  by_cases horder : o.greater (o.div (absRight y) (o.oneunit (absRight y)))
      (o.div (o.abs x) (o.oneunit (o.abs x))) = true <;>
    simp only [hypotGeneric, hypotGenericSource, hinfLeft, hinfRight, Bool.or_self,
      Bool.false_eq_true, ↓reduceIte, horder, hcutoff, bind, Except.bind,
      pure, Except.pure] at hsmall ⊢ <;>
    rw [ite_eq_left hsmall]

/-- A finite-safety theorem for every pair selected by the source's
unbalanced-operand cutoff, with the cutoff fixed to its exact native value. -/
theorem early_hypot64_fast_finite (o : IEEEOps .f64)
    (heps : o.eps = eps_float .f64)
    (hsqrt : ∀ x, o.sqrtLlvm x = jlSqrtLlvm x)
    (hone : ∀ x, o.oneunit x = fone .f64)
    (hgreater : ∀ x y, o.greater x y = flt y x)
    (x y : FV .f64) (hxf : x.isfinite = true) (hyf : y.isfinite = true)
    (hsmall : fle (if flt (fabs x) (fabs y) then fabs x else fabs y)
      (mul (if flt (fabs x) (fabs y) then fabs y else fabs x)
        (Fl.ofBits 0x3e46a09e667f3bcd)) = true) :
    ∃ h, hypotGeneric (hypotOpsOfIEEE o) (hypotOpsOfIEEE o).abs x y = .ok h ∧
      h.isfinite = true := by
  have hax := (JuliaLean.Proofs.base.math.mfFabsKey x hxf).2.1
  have hay := (JuliaLean.Proofs.base.math.mfFabsKey y hyf).2.1
  have hnormx := early_hypot_div_one (fabs x) hax
  have hnormy := early_hypot_div_one (fabs y) hay
  have hix : fisinf (fabs x) = false := by
    rw [show fisinf (fabs x) = (fabs x).isinf from isinf_IEEEFloat_eq _]
    exact Fl.isinf_of_finite hax
  have hiy : fisinf (fabs y) = false := by
    rw [show fisinf (fabs y) = (fabs y).isinf from isinf_IEEEFloat_eq _]
    exact Fl.isinf_of_finite hay
  have hcutoff : sqrtIEEE o (div o.eps (Fl.ofInt 2)) =
      .ok (Fl.ofBits 0x3e46a09e667f3bcd) := by
    have hc : flt (div (eps_float .f64) (Fl.ofInt 2)) (fzero .f64) = false := by decide
    simp only [sqrtIEEE, heps, hc, Bool.false_eq_true, ↓reduceIte,
      hsqrt, early_hypot64_constants.1]
  have hrun := early_hypot_generic_fast (hypotOpsOfIEEE o) (hypotOpsOfIEEE o).abs
    x y (Fl.ofBits 0x3e46a09e667f3bcd) hcutoff
    (by simpa only [hypotOpsOfIEEE, hone, hnormx] using hix)
    (by simpa only [hypotOpsOfIEEE, hone, hnormy] using hiy)
    (by simpa only [hypotOpsOfIEEE, hone, hgreater, hnormx, hnormy] using hsmall)
  simp only [hypotOpsOfIEEE, hone, hgreater, hnormx, hnormy] at hrun
  refine ⟨_, hrun, ?_⟩
  split
  · exact hay
  · exact hax

/-- The arithmetic correction, with its source evaluation order preserved. -/
def early_hypot64_correct (hardware : Bool) (a b h : FV .f64) : FV .f64 :=
  let two : FV .f64 := Fl.ofInt 2
  let four : FV .f64 := Fl.ofInt 4
  if hardware then
    let hsquared := mul h h
    let asquared := mul a a
    let correction := sub
      (add (jlFmaFloat (fneg b) b (sub hsquared asquared))
        (jlFmaFloat h h (fneg hsquared)))
      (jlFmaFloat a a (fneg asquared))
    sub h (div correction (mul two h))
  else if fle h (mul two b) then
    let delta := sub h b
    sub h (div
      (JuliaLean.base.float.muladd_IEEEFloat delta (sub delta (mul two (sub a b)))
        (mul a (sub (mul two delta) a))) (mul two h))
  else
    let delta := sub h a
    let inner := JuliaLean.base.float.muladd_IEEEFloat b
      (sub (mul four delta) b) (mul (mul two delta) (sub a (mul two b)))
    sub h (div (JuliaLean.base.float.muladd_IEEEFloat delta delta inner) (mul two h))

/-- Exact pure trace of the binary64 finite-input algorithm. Constants have
been reduced to checked bit patterns; operation order is unchanged. -/
def early_hypot64_value (hardware : Bool) (x y : FV .f64) : FV .f64 :=
  let x0 := fabs x
  let y0 := fabs y
  let (a, b) := if flt x0 y0 then (y0, x0) else (x0, y0)
  if fle b (mul a (Fl.ofBits 0x3e46a09e667f3bcd)) then a
  else
    let scale0 : FV .f64 := Fl.ofBits 0x1cc0000000000000
    let (a, b, scale) :=
      if flt (Fl.ofBits 0x5fe6a09e667f3bcc) a then
        (mul a scale0, mul b scale0, Fl.ofBits 0x6320000000000000)
      else if flt b (Fl.ofBits 0x2000000000000000) then
        (div a scale0, div b scale0, scale0)
      else (a, b, fone .f64)
    let h := jlSqrtLlvm (JuliaLean.base.float.muladd_IEEEFloat a a (mul b b))
    mul (mul (early_hypot64_correct hardware a b h) scale) (fone .f64)

