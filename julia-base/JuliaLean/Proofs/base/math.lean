  have hX : X.isfinite = true ∧ X.signbit = false ∧ 1 ≤ X.expField := by decide
  have hmag := hypot_positive_key_le_magnitude a hypot_rescale_boundary hs (by decide) hbound
  by_cases heq : a.magnitude = hypot_rescale_boundary.magnitude
  · have he := hypot_positive_magnitude_injective a hypot_rescale_boundary hs (by decide) heq
    rw [he]
    exact Int.le_refl _
