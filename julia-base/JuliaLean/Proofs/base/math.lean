/-- Division by the floating one is an exact normalization for every finite
IEEE input, preserving the sign of both zeros. -/
theorem early_hypot_div_one {T : FTy} (x : FV T) (hx : x.isfinite = true) :
    div x (fone T) = x := by
  have ho : (fone T).isfinite = true := by cases T <;> decide
  have hz : (fone T).iszero = false := by cases T <;> decide
  have hn : (fone T).toRat.1 = (2 ^ T.fmt.sb : Nat) := by cases T <;> decide
  have hd : (fone T).toRat.2 = 2 ^ T.fmt.sb := by cases T <;> decide
  have hs : (fone T).signbit = false := by cases T <;> decide
  have hp : ¬ ((2 ^ T.fmt.sb : Nat) : Int) < 0 := by omega
  obtain ⟨j, hj⟩ := JuliaLean.Proofs.base.math.mfToRatPow2 x hx
  have hscale := (Fl.toRat_key (good_fty T) x hx).2
  have hkey :
      (x.toRat.1 * ((2 ^ T.fmt.sb : Nat) : Int)) * (T.fmt.den : Int) =
        x.key * ((2 ^ (j + T.fmt.sb) : Nat) : Int) := by
    rw [Nat.pow_add, Int.natCast_mul]
    calc
      _ = (x.toRat.1 * (T.fmt.den : Int)) * ((2 ^ T.fmt.sb : Nat) : Int) := by ac_rfl
      _ = _ := by rw [hscale, hj]; ac_rfl
  have hrepr : NextProofs.encode T x.signbit x.magnitude = x := by
    unfold NextProofs.encode NextProofs.signMask
    rw [← (Fl.bits_split x).1, Fl.ofBits_toBits]
  change JuliaLean.base.float.div_float x (fone T) = x
  rw [JuliaLean.Proofs.base.math.mfDivRat x (fone T) hx ho hz, hn, hd, hs]
  simp only [hp, ↓reduceIte, Int.natAbs_natCast, hj, ← Nat.pow_add, Bool.bne_false]
  by_cases hx0 : x.magnitude = 0
  · have hxn : x.toRat.1 = 0 := by rw [JuliaLean.Proofs.base.math.mfToRatZero x hx hx0]
    rw [hxn, Int.zero_mul,
      JuliaLean.Proofs.base.math.mfRoundRatZero _ (Nat.ne_of_gt (Nat.two_pow_pos _))]
    rw [JuliaLean.Proofs.base.math.mfEncodeZero, ← hx0]
    exact hrepr
  · rw [JuliaLean.Proofs.base.math.mfRoundRatOfKey T _ (j + T.fmt.sb)
      x.signbit x.signbit x.magnitude hx0 ((TruncProofs.isfinite_iff_mag x).mp hx) hkey]
    exact hrepr

