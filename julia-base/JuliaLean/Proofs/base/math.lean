/-- The finite binary search returns the exact floor of a square-root ratio
when its interval contains the root and the fuel covers the interval width. -/
theorem early_sqrt_search_bounds (n d fuel lo hi : Nat)
    (hlohi : lo < hi) (hlo : lo * lo * d ≤ n) (hhi : n < hi * hi * d)
    (hwidth : hi - lo ≤ 2 ^ fuel) :
    let q := sqrtFloorRatio n d fuel lo hi
    q * q * d ≤ n ∧ n < (q + 1) * (q + 1) * d := by
  induction fuel generalizing lo hi with
  | zero =>
      have heq : hi = lo + 1 := by simp only [Nat.pow_zero] at hwidth; omega
      simpa only [sqrtFloorRatio, heq] using And.intro hlo hhi
  | succ fuel ih =>
      simp only [sqrtFloorRatio]
      split
      · rename_i hend
        have heq : hi = lo + 1 := by omega
        exact ⟨hlo, heq ▸ hhi⟩
      · rename_i hmore
        have hmidlo : lo < (lo + hi) / 2 := by omega
        have hmidhi : (lo + hi) / 2 < hi := by omega
        have hleft : (lo + hi) / 2 - lo ≤ 2 ^ fuel := by
          rw [Nat.pow_succ] at hwidth
          omega
        have hright : hi - (lo + hi) / 2 ≤ 2 ^ fuel := by
          rw [Nat.pow_succ] at hwidth
          omega
        split
        · rename_i hmid
          exact ih _ _ hmidhi hmid hhi hright
        · rename_i hmid
          exact ih _ _ hmidlo hlo (by omega) hleft

