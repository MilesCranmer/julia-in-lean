  · by_cases he : 0 ≤ (n.log2 : Int) - j
    · simp only [QPowTwo, if_pos he, QRatLe, decide_eq_true_eq]
      have heNat : ((n.log2 : Int) - j).toNat + j = n.log2 := by omega
      have hp : 2 ^ ((n.log2 : Int) - j).toNat * 2 ^ j = 2 ^ n.log2 := by
        rw [← Nat.pow_add, heNat]
      exact_mod_cast (by rw [hp]; simpa using hlo)
    · simp only [QPowTwo, if_neg he, QRatLe, decide_eq_true_eq]
      have heNat : (-( (n.log2 : Int) - j)).toNat + n.log2 = j := by omega
      have hp : 2 ^ n.log2 * 2 ^ (-( (n.log2 : Int) - j)).toNat = 2 ^ j := by
        rw [← Nat.pow_add, Nat.add_comm n.log2 (-( (n.log2 : Int) - j)).toNat, heNat]
      have hmul := Nat.mul_le_mul_right
        (2 ^ (-( (n.log2 : Int) - j)).toNat) hlo
