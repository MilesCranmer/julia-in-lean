      change a.magnitude ≤ 0x5cbfffffffffffff at hmag
      change a.magnitude ≠ 0x5cbfffffffffffff at heq
      change a.magnitude ≤ 0x5cbffffffffffffe
      omega
    have hpkey := generic_positive_key_mono a hypot_critical_boundary_prev hs (by decide) hprev
    have ha0 := (mfKeySign a).2 hs
    have ha2 := Int.mul_self_le_mul_self ha0 hpkey
    have hclosed : hypot_critical_boundary_prev.key * hypot_critical_boundary_prev.key ≤
        X.key * JuliaLean.base.float.FTy.f64.fmt.den := by decide
    have hXpos : 0 ≤ X.key := (mfKeySign X).2 hX.2.1
    have hD0 : (0 : Int) ≤ JuliaLean.base.float.FTy.f64.fmt.den := Int.natCast_nonneg _
    have hb := generic_mul64_abs_bound a a X ha ha hX.1 hX.2.1 hX.2.2
      (by have := Int.mul_nonneg hXpos hD0; have := Int.mul_nonneg ha0 ha0; omega)
      (Int.le_trans ha2 hclosed)
    have := hb.2
    change (mul a a).key ≤ X.key
    omega


/-- A finite nonnegative operand at most H has a finite square. -/
theorem hypot_critical_square_finite (a : hypot_BoundaryVal)
    (ha : a.isfinite = true) (hs : a.signbit = false)
    (hbound : a.key ≤ hypot_rescale_boundary.key) : (mul a a).isfinite = true := by
