def hypot_max_step (T : hypot_NanTy) : JuliaLean.base.reduce.FoldInit (JInt T.intTy) →
    hypot_NanVal T → JuliaLean.base.reduce.FoldInit (JInt T.intTy)
  | .initial, x => .value (reinterpret_Signed x)
  | .value a, x => .value (hypot_signed_max T a (reinterpret_Signed x))

def hypot_max_fold (T : hypot_NanTy) (seed : JInt T.intTy) (xs : List (hypot_NanVal T)) :=
  xs.foldl (fun a z => hypot_signed_max T a (reinterpret_Signed z)) seed

theorem hypot_max_fold_value (T : hypot_NanTy) (xs : List (hypot_NanVal T))
    (seed : JInt T.intTy) :
    xs.foldl (hypot_max_step T) (.value seed) = .value (hypot_max_fold T seed xs) := by
  induction xs generalizing seed with
  | nil => rfl
  | cons x xs ih =>
    simpa only [List.foldl_cons, hypot_max_step, hypot_max_fold] using
      (ih (hypot_signed_max T seed (reinterpret_Signed x)))

theorem hypot_max_fold_seed (T : hypot_NanTy) (xs : List (hypot_NanVal T))
    (seed : JInt T.intTy) : seed.val ≤ (hypot_max_fold T seed xs).val := by
  induction xs generalizing seed with
  | nil => exact Int.le_refl _
  | cons x xs ih =>
    exact Int.le_trans (hypot_signed_max_left T seed (reinterpret_Signed x))
      (ih (hypot_signed_max T seed (reinterpret_Signed x)))

theorem hypot_max_fold_member (T : hypot_NanTy) (xs : List (hypot_NanVal T))
    (seed : JInt T.intTy) (x : hypot_NanVal T) (hx : x ∈ xs) :
    (reinterpret_Signed x).val ≤ (hypot_max_fold T seed xs).val := by
  induction xs generalizing seed with
  | nil => simp only [List.not_mem_nil] at hx
  | cons y ys ih =>
    rcases List.mem_cons.mp hx with rfl | hx
    · exact Int.le_trans (hypot_signed_max_right T seed (reinterpret_Signed x))
        (hypot_max_fold_seed T ys (hypot_signed_max T seed (reinterpret_Signed x)))
    · exact ih (hypot_signed_max T seed (reinterpret_Signed y)) hx

theorem hypot_max_fold_selection (T : hypot_NanTy) (xs : List (hypot_NanVal T))
    (seed : JInt T.intTy) :
    hypot_max_fold T seed xs = seed ∨
      ∃ x ∈ xs, hypot_max_fold T seed xs = reinterpret_Signed x := by
  induction xs generalizing seed with
  | nil => exact Or.inl rfl
  | cons x xs ih =>
    rcases ih (hypot_signed_max T seed (reinterpret_Signed x)) with he | ⟨y, hy, he⟩
    · have he' : hypot_max_fold T seed (x :: xs) =
          hypot_signed_max T seed (reinterpret_Signed x) := he
      rw [he', hypot_signed_max_eq]
      split
      · exact Or.inl rfl
      · exact Or.inr ⟨x, by simp, rfl⟩
    · exact Or.inr ⟨y, List.mem_cons_of_mem x hy, he⟩

