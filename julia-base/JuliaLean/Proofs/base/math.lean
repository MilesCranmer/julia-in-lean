    _ = U * (x.toRat.2 : Int) * ((y.key.natAbs : Int) * y.toRat.2) := by ac_rfl
    _ = U * (x.toRat.2 : Int) * ((y.toRat.1.natAbs : Int) * T.fmt.den) := by rw [hky]
    _ = _ := by ac_rfl

