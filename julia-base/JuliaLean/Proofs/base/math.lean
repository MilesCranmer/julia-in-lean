/-! ## mathfuncs-ldexp16-exact-scaling -/

theorem mfLdexpZero {T : FTy} (o : IEEEOps T) (x : FV T) (e : Int) (hz : x.magnitude = 0) :
    ldexp o x e = x := by
  rw [mfLdexpUnfold]
  have hxs : withoutBits x.toBits (signMask T) T.fmt.width = x.magnitude := withoutSignBitMagnitude x
  have hnm : ¬ (x.magnitude ≥ exponentMask T) := by
    rw [hz]; unfold exponentMask
    have := Nat.two_pow_pos T.fmt.sb
    have := (good_fty T).emax_eq
    have : 0 < T.fmt.emax * 2 ^ T.fmt.sb := Nat.mul_pos (by omega) (by omega)
    omega
  simp only [Id.run, hxs, hz, Nat.zero_div, Int.natCast_zero, beq_self_eq_true, ↓reduceIte]
  split <;> rfl

theorem mfConvertFinite {f g : Fmt} (x : Fl g) (hne : (f == g) = false) (hx : x.isfinite = true) :
    (Fl.convert x : Fl f) = Fl.roundRat x.toRat.1 x.toRat.2 x.signbit := by
  unfold Fl.convert
  simp only [hne, Fl.isnan_of_finite hx, Fl.isinf_of_finite hx, Bool.false_eq_true, ↓reduceIte]

theorem mfKeyNatAbs {T : FTy} (z : FV T) : z.key.natAbs = magKey T.fmt z.magnitude := by
  unfold Fl.key; split <;> simp

theorem mfSignOfKey {T : FTy} (z : FV T) (hz : z.magnitude ≠ 0) :
    z.signbit = decide (z.key < 0) := by
  have hK := ((magKey_cases T.fmt z.magnitude).resolve_left (by omega)).2
  unfold Fl.key
  cases z.signbit
  · simp only [Bool.false_eq_true, ↓reduceIte]
    exact (decide_eq_false (by omega)).symm
  · simp only [↓reduceIte]
    exact (decide_eq_true (by omega)).symm

theorem mfMagZeroOfKey {T : FTy} (z : FV T) (h : z.key = 0) : z.magnitude = 0 := by
  have := mfKeyNatAbs z
  rw [h] at this
  rcases magKey_cases T.fmt z.magnitude with h1 | h1
  · exact h1.1
  · simp at this; omega

theorem mfRoundRatZero {T : FTy} (d : Nat) (hd : d ≠ 0) (s : Bool) :
    (Fl.roundRat 0 d s : FV T) = Fl.zero s := by
  unfold Fl.roundRat
  simp [hd]

theorem mfToRatZero {T : FTy} (x : FV T) (hx : x.isfinite = true) (hz : x.magnitude = 0) :
    x.toRat.1 = 0 := by
  obtain ⟨hd, hk⟩ := Fl.toRat_key (good_fty T) x hx
  have hkey : x.key = 0 := by unfold Fl.key; rw [hz, magKey_zero]; simp
  rw [hkey, Int.zero_mul] at hk
  have hden : (0 : Int) < T.fmt.den := by exact_mod_cast T.fmt.den_pos
  exact (Int.mul_eq_zero.1 hk).resolve_right (by omega)

theorem mfZeroMag {T : FTy} (s : Bool) : (Fl.zero s : FV T).magnitude = 0 := by
  rw [mfEncodeZero, NextProofs.mag_encode T s (by unfold NextProofs.signMask; exact Nat.two_pow_pos _)]

theorem mfHalfKeyBound (z : FV .f16) (hz : z.isfinite = true) :
    magKey (JuliaLean.base.float.FTy.fmt .f16) z.magnitude < 2 ^ 40 := by
  have h := Fl.finite_key_lt_inf (good_fty .f16) z hz
  have ha := mfKeyNatAbs z
  have hc : ((2 ^ (JuliaLean.base.float.FTy.fmt .f16).sb * 2 ^ ((JuliaLean.base.float.FTy.fmt .f16).emax - 1) : Nat) : Int) = 2 ^ 40 := by decide
  rw [hc] at h
  change z.key.natAbs = magKey (JuliaLean.base.float.FTy.fmt .f16) z.magnitude at ha
  omega

theorem ldexp16ExactScaling_proven : Ldexp16ExactScaling := by
  intro o32 x q expected hfaith hxf hef hqe hsign
  have hx : x.isfinite = true := by rw [← isfinite_IEEEFloat_eq x]; exact hxf
  have he : expected.isfinite = true := by rw [← isfinite_IEEEFloat_eq expected]; exact hef
  have hne32 : (JuliaLean.base.float.FTy.fmt .f32 == JuliaLean.base.float.FTy.fmt .f16) = false := by decide
  have hne16 : (JuliaLean.base.float.FTy.fmt .f16 == JuliaLean.base.float.FTy.fmt .f32) = false := by decide
  obtain ⟨hx2, hxk⟩ := Fl.toRat_key (good_fty .f16) x hx
  obtain ⟨he2, hek⟩ := Fl.toRat_key (good_fty .f16) expected he
  have hq : expected.toRat.1 * ((x.toRat.2 : Int) * ((QPowTwo q).2 : Int)) =
      x.toRat.1 * (QPowTwo q).1 * (expected.toRat.2 : Int) := by
    have h := of_decide_eq_true hqe
    simp only [QMul, Int.natCast_mul] at h
    exact h
  -- Exact value relation between the keys.
  have hkey : expected.key * ((QPowTwo q).2 : Int) = x.key * (QPowTwo q).1 := by
    have hpos : (0 : Int) < (x.toRat.2 : Int) * (expected.toRat.2 : Int) :=
      Int.mul_pos (by exact_mod_cast hx2) (by exact_mod_cast he2)
    apply Int.eq_of_mul_eq_mul_right (Int.ne_of_gt hpos)
    calc expected.key * ((QPowTwo q).2 : Int) * ((x.toRat.2 : Int) * (expected.toRat.2 : Int))
        = (expected.key * expected.toRat.2) * ((x.toRat.2 : Int) * ((QPowTwo q).2 : Int)) := by
          simp only [Int.mul_assoc, Int.mul_comm, Int.mul_left_comm]
      _ = (expected.toRat.1 * (JuliaLean.base.float.FTy.fmt .f16).den) * ((x.toRat.2 : Int) * ((QPowTwo q).2 : Int)) := by
          rw [hek]
      _ = (JuliaLean.base.float.FTy.fmt .f16).den * (expected.toRat.1 * ((x.toRat.2 : Int) * ((QPowTwo q).2 : Int))) := by
          simp only [Int.mul_assoc, Int.mul_comm, Int.mul_left_comm]
      _ = (JuliaLean.base.float.FTy.fmt .f16).den * (x.toRat.1 * (QPowTwo q).1 * (expected.toRat.2 : Int)) := by rw [hq]
      _ = (x.toRat.1 * (JuliaLean.base.float.FTy.fmt .f16).den) * ((QPowTwo q).1 * (expected.toRat.2 : Int)) := by
          simp only [Int.mul_assoc, Int.mul_comm, Int.mul_left_comm]
      _ = (x.key * x.toRat.2) * ((QPowTwo q).1 * (expected.toRat.2 : Int)) := by rw [hxk]
      _ = x.key * (QPowTwo q).1 * ((x.toRat.2 : Int) * (expected.toRat.2 : Int)) := by
          simp only [Int.mul_assoc, Int.mul_comm, Int.mul_left_comm]
  -- Write q = a - b with one of a, b zero.
  obtain ⟨a, b, hab, hab0, hkab⟩ : ∃ a b : Nat, q = (a : Int) - b ∧ (a = 0 ∨ b = 0) ∧
      expected.key * ((2 ^ b : Nat) : Int) = x.key * ((2 ^ a : Nat) : Int) := by
    by_cases hq0 : 0 ≤ q
    · refine ⟨q.toNat, 0, by omega, Or.inr rfl, ?_⟩
      simpa [QPowTwo, hq0] using hkey
    · refine ⟨0, (-q).toNat, by omega, Or.inl rfl, ?_⟩
      simpa [QPowTwo, hq0] using hkey
  by_cases hxz : x.magnitude = 0
  · -- Zero input: every step keeps the signed zero.
    have hxr := mfToRatZero x hx hxz
    obtain ⟨jx, hjx⟩ := mfToRatPow2 x hx
    have hy : (Fl.convert x : FV .f32) = Fl.zero x.signbit := by
      rw [mfConvertFinite x hne32 hx, hxr, hjx]
      exact mfRoundRatZero _ (by have := Nat.two_pow_pos jx; omega) _
    have hxkey0 : x.key = 0 := by unfold Fl.key; rw [hxz, magKey_zero]; simp
    have hekey0 : expected.key = 0 := by
      rw [hxkey0, Int.zero_mul] at hkab
      exact (Int.mul_eq_zero.1 hkab).resolve_right (by
        have := Nat.two_pow_pos b; omega)
    have hem := mfMagZeroOfKey expected hekey0
    have hzfin : (Fl.zero x.signbit : FV .f32).isfinite = true := (Fl.zero_spec (good_fty .f32) _).1
    have hzm := mfZeroMag (T := .f32) x.signbit
    unfold ldexp16 ldexp16Source
    dsimp only [pure, bind, Id.instMonad]
    rw [hy, mfLdexpZero o32 _ q hzm, mfConvertFinite _ hne16 hzfin,
      mfToRatZero _ hzfin hzm]
    obtain ⟨jz, hjz⟩ := mfToRatPow2 (Fl.zero x.signbit : FV .f32) hzfin
    rw [hjz, mfRoundRatZero _ (by have := Nat.two_pow_pos jz; omega), mfZeroSignbit, mfEncodeZero,
      ← hsign, ← hem, NextProofs.encode_input]
  · -- Nonzero input.
    have hxm0 : magKey (JuliaLean.base.float.FTy.fmt .f16) x.magnitude ≠ 0 :=
      Nat.ne_of_gt ((magKey_cases (JuliaLean.base.float.FTy.fmt .f16) x.magnitude).resolve_left (by omega)).2
    have hxmb := mfHalfKeyBound x hx
    have hemb := mfHalfKeyBound expected he
    have habs : magKey (JuliaLean.base.float.FTy.fmt .f16) expected.magnitude * 2 ^ b = magKey (JuliaLean.base.float.FTy.fmt .f16) x.magnitude * 2 ^ a := by
      have := congrArg Int.natAbs hkab
      simp only [Int.natAbs_mul, Int.natAbs_natCast] at this
      rw [mfKeyNatAbs, mfKeyNatAbs] at this
      exact this
    have hem0 : magKey (JuliaLean.base.float.FTy.fmt .f16) expected.magnitude ≠ 0 := by
      intro h0
      rw [h0, Nat.zero_mul] at habs
      have := Nat.mul_pos (Nat.pos_of_ne_zero hxm0) (Nat.two_pow_pos a)
      omega
    have hez : expected.magnitude ≠ 0 := by
      intro h0; rw [h0, magKey_zero] at hem0; exact hem0 rfl
    have hlogab : (magKey (JuliaLean.base.float.FTy.fmt .f16) expected.magnitude).log2 + b = (magKey (JuliaLean.base.float.FTy.fmt .f16) x.magnitude).log2 + a := by
      rw [← Fl.log2_mul_pow _ _ hem0, ← Fl.log2_mul_pow _ _ hxm0, habs]
    have hab40 : a < 40 ∧ b < 40 := by
      rcases hab0 with h0 | h0
      · subst h0
        have : 2 ^ b ≤ magKey (JuliaLean.base.float.FTy.fmt .f16) expected.magnitude * 2 ^ b :=
          Nat.le_mul_of_pos_left _ (Nat.pos_of_ne_zero hem0)
        have h40 : 2 ^ b < 2 ^ 40 := by rw [habs, Nat.pow_zero, Nat.mul_one] at this; omega
        exact ⟨by omega, (Nat.pow_lt_pow_iff_right (by decide)).1 h40⟩
      · subst h0
        have : 2 ^ a ≤ magKey (JuliaLean.base.float.FTy.fmt .f16) x.magnitude * 2 ^ a :=
          Nat.le_mul_of_pos_left _ (Nat.pos_of_ne_zero hxm0)
        have h40 : 2 ^ a < 2 ^ 40 := by rw [← habs, Nat.pow_zero, Nat.mul_one] at this; omega
        exact ⟨(Nat.pow_lt_pow_iff_right (by decide)).1 h40, by omega⟩
    have hlogE : (magKey (JuliaLean.base.float.FTy.fmt .f16) expected.magnitude).log2 < 40 := (Nat.log2_lt hem0).2 hemb
    -- Widen to Float32.
    obtain ⟨-, -, hyfinEq, -, hykey⟩ := Fl.convert_widen_key (good_fty .f16) (good_fty .f32) hne32
      (by decide) (by decide) x
    generalize hydef : (Fl.convert x : FV .f32) = y at hyfinEq hykey
    have hyfin : y.isfinite = true := by rw [hyfinEq]; exact hx
    have hyk : y.key = x.key * 2 ^ 125 := by
      have h := (hykey hx).1
      have hd16 : ((JuliaLean.base.float.FTy.fmt .f16).den : Int) = 2 ^ 24 := by decide
      have hd32 : ((JuliaLean.base.float.FTy.fmt .f32).den : Int) = 2 ^ 149 := by decide
      change y.key * ((JuliaLean.base.float.FTy.fmt .f16).den : Int) = x.key * ((JuliaLean.base.float.FTy.fmt .f32).den : Int) at h
      rw [hd16, hd32] at h
      apply Int.eq_of_mul_eq_mul_right (show (2 : Int) ^ 24 ≠ 0 by decide)
      rw [h, Int.mul_assoc]
      congr 1
    have hym : magKey (JuliaLean.base.float.FTy.fmt .f32) y.magnitude = magKey (JuliaLean.base.float.FTy.fmt .f16) x.magnitude * 2 ^ 125 := by
      have := congrArg Int.natAbs hyk
      rw [Int.natAbs_mul] at this
      change y.key.natAbs = _ at this
      rw [mfKeyNatAbs, mfKeyNatAbs] at this
      rw [this]
      rfl
    have hyz : y.magnitude ≠ 0 := by
      intro h0; rw [h0, magKey_zero] at hym
      have := Nat.mul_pos (Nat.pos_of_ne_zero hxm0) (Nat.two_pow_pos 125); omega
    have hys : y.signbit = x.signbit := by
      rw [mfSignOfKey y hyz, mfSignOfKey x hxz, hyk]
      apply decide_eq_decide.mpr
      have : (0 : Int) < 2 ^ 125 := by decide
      constructor
      · intro h; apply Classical.byContradiction; intro hn
        have := Int.mul_nonneg (show 0 ≤ x.key by omega) (Int.le_of_lt this); omega
      · intro h; exact Int.mul_neg_of_neg_of_pos h this
    obtain ⟨hc1, hc2, hrel, hnorm, hsub⟩ := mfNormSigFacts y hyfin hyz
    have hyB : y.expField ≠ 0 := by
      intro h0
      obtain ⟨-, hmk, hlg⟩ := hsub h0
      have hfr := (TruncProofs.mag_decomp y).2
      rw [hmk] at hym
      have : (2 : Nat) ^ 125 ≤ magKey (JuliaLean.base.float.FTy.fmt .f16) x.magnitude * 2 ^ 125 :=
        Nat.le_mul_of_pos_left _ (Nat.pos_of_ne_zero hxm0)
      change y.frac < 2 ^ 23 at hfr
      omega
    obtain ⟨hLy, hcy⟩ := hnorm hyB
    have hLy' : (magKey (JuliaLean.base.float.FTy.fmt .f32) y.magnitude).log2 = (magKey (JuliaLean.base.float.FTy.fmt .f16) x.magnitude).log2 + 125 := by
      rw [hym, Fl.log2_mul_pow _ _ hxm0]
    change (magKey (JuliaLean.base.float.FTy.fmt .f32) y.magnitude).log2 = 23 + y.expField - 1 at hLy
    have hBy : y.expField = (magKey (JuliaLean.base.float.FTy.fmt .f16) x.magnitude).log2 + 103 := by omega
    -- ldexp in Float32 only moves the exponent field.
    have hldexp := mfLdexpNormal o32 y q hyfin hyB (by omega) (by omega)
    have hn1 : ¬ ((y.expField : Int) + q ≥ (JuliaLean.base.float.FTy.fmt .f32).emax) := by
      change ¬ ((y.expField : Int) + q ≥ 255); omega
    have hp : (y.expField : Int) + q > 0 := by omega
    simp only [hn1, hp, ↓reduceIte] at hldexp
    have hyfr := (TruncProofs.mag_decomp y).2
    have hwB : ((y.expField : Int) + q).toNat < (JuliaLean.base.float.FTy.fmt .f32).emax := by
      change _ < 255; omega
    obtain ⟨hws, -, -, -, hwfin, hwkey⟩ := mfEncodeParts .f32 y.signbit _ _ hwB hyfr
    have hwm : magKey (JuliaLean.base.float.FTy.fmt .f32)
        (((y.expField : Int) + q).toNat * 2 ^ (JuliaLean.base.float.FTy.fmt .f32).sb + y.frac) =
        magKey (JuliaLean.base.float.FTy.fmt .f16) expected.magnitude * 2 ^ 125 := by
      change magKey (JuliaLean.base.float.FTy.fmt .f32) (((y.expField : Int) + q).toNat * 2 ^ 23 + y.frac) = _
      have h1 := mfMagKeyNormal .f32 (((y.expField : Int) + q).toNat) y.frac (by omega) hyfr
      have h2 : magKey (JuliaLean.base.float.FTy.fmt .f32) y.magnitude = (y.frac + 2 ^ 23) * 2 ^ (y.expField - 1) := by
        rw [(TruncProofs.mag_decomp y).1]
        exact mfMagKeyNormal .f32 y.expField y.frac hyB hyfr
      change magKey (JuliaLean.base.float.FTy.fmt .f32) (((y.expField : Int) + q).toNat * 2 ^ 23 + y.frac) =
        (y.frac + 2 ^ 23) * 2 ^ (((y.expField : Int) + q).toNat - 1) at h1
      apply Nat.eq_of_mul_eq_mul_right (Nat.two_pow_pos b)
      rw [h1]
      have hexp : ((y.expField : Int) + q).toNat - 1 + b = (y.expField - 1) + a := by omega
      calc (y.frac + 2 ^ 23) * 2 ^ (((y.expField : Int) + q).toNat - 1) * 2 ^ b
          = (y.frac + 2 ^ 23) * 2 ^ (y.expField - 1) * 2 ^ a := by
            rw [Nat.mul_assoc, ← Nat.pow_add, hexp, Nat.pow_add, Nat.mul_assoc]
        _ = magKey (JuliaLean.base.float.FTy.fmt .f16) x.magnitude * 2 ^ 125 * 2 ^ a := by
            rw [← h2, hym]
        _ = magKey (JuliaLean.base.float.FTy.fmt .f16) expected.magnitude * 2 ^ 125 * 2 ^ b := by
            rw [Nat.mul_right_comm, ← habs, Nat.mul_right_comm]
    -- Narrow back to Float16: the value is representable, so rounding returns `expected`.
    unfold ldexp16 ldexp16Source
    dsimp only [pure, bind, Id.instMonad]
    rw [hydef, hldexp]
    generalize hwdef : NextProofs.encode .f32 y.signbit
      (((y.expField : Int) + q).toNat * 2 ^ (JuliaLean.base.float.FTy.fmt .f32).sb + y.frac) = w
      at hws hwfin hwkey ⊢
    rw [mfConvertFinite w hne16 hwfin]
    obtain ⟨jw, hjw⟩ := mfToRatPow2 w hwfin
    obtain ⟨-, hwk⟩ := Fl.toRat_key (good_fty .f32) w hwfin
    rw [hjw] at hwk ⊢
    have hw1abs : w.toRat.1.natAbs * (JuliaLean.base.float.FTy.fmt .f16).den = magKey (JuliaLean.base.float.FTy.fmt .f16) expected.magnitude * 2 ^ jw := by
      have h := congrArg Int.natAbs hwk
      simp only [Int.natAbs_mul, Int.natAbs_natCast] at h
      rw [hwkey] at h
      have hwk' : ∀ (s : Bool) (K : Nat), (if s then -((K : Nat) : Int) else ((K : Nat) : Int)).natAbs = K := by
        intro s K; split <;> simp
      rw [hwk', hwm] at h
      change w.toRat.1.natAbs * 2 ^ 149 = magKey (JuliaLean.base.float.FTy.fmt .f16) expected.magnitude * 2 ^ 125 * 2 ^ jw at h
      change w.toRat.1.natAbs * 2 ^ 24 = magKey (JuliaLean.base.float.FTy.fmt .f16) expected.magnitude * 2 ^ jw
      apply Nat.eq_of_mul_eq_mul_right (Nat.two_pow_pos 125)
      rw [Nat.mul_assoc, show (2 : Nat) ^ 24 * 2 ^ 125 = 2 ^ 149 by decide, h, Nat.mul_right_comm]
    have hw10 : w.toRat.1 ≠ 0 := by
      intro h0
      rw [h0, Int.natAbs_zero, Nat.zero_mul] at hw1abs
      have := Nat.mul_pos (Nat.pos_of_ne_zero hem0) (Nat.two_pow_pos jw); omega
    have hemInf : expected.magnitude < NextProofs.infMag .f16 := (TruncProofs.isfinite_iff_mag expected).1 he
    rw [mfRoundRatEncode .f16 _ jw _ _ hw10 hez hemInf hw1abs]
    have hsw : decide (w.toRat.1 < 0) = expected.signbit := by
      have hwz : w.magnitude ≠ 0 := by
        intro h0
        have := mfToRatZero w hwfin h0
        exact hw10 this
      rw [hsign, ← hys, ← hws, mfSignOfKey w hwz]
      have hden : (0 : Int) < (JuliaLean.base.float.FTy.fmt .f32).den := by exact_mod_cast (JuliaLean.base.float.FTy.fmt .f32).den_pos
      have hj : (0 : Int) < ((2 ^ jw : Nat) : Int) := by exact_mod_cast Nat.two_pow_pos jw
      apply decide_eq_decide.mpr
      constructor
      · intro h
        apply Classical.byContradiction; intro hn
        have h1 : w.toRat.1 * (JuliaLean.base.float.FTy.fmt .f32).den < 0 := Int.mul_neg_of_neg_of_pos h hden
        rw [hwk] at h1
        have := Int.mul_nonneg (show 0 ≤ w.key by omega) (Int.le_of_lt hj); omega
      · intro h
        apply Classical.byContradiction; intro hn
        have h1 : w.key * ((2 ^ jw : Nat) : Int) < 0 := Int.mul_neg_of_neg_of_pos h hj
        rw [← hwk] at h1
        have := Int.mul_nonneg (show 0 ≤ w.toRat.1 by omega) (Int.le_of_lt hden); omega
    rw [hsw, NextProofs.encode_input]

end MathfuncsProofs

section MathfuncsProofs

open JuliaLean.Proofs.base.float JuliaLean.C

/-! ## Exact sums and representable keys -/

theorem mfRoundRatOfKey (T : FTy) (N : Int) (j : Nat) (z s : Bool) (M : Nat)
    (hM0 : M ≠ 0) (hM : M < NextProofs.infMag T)
    (h : N * (T.fmt.den : Int) =
      (if s then -((magKey T.fmt M : Nat) : Int) else ((magKey T.fmt M : Nat) : Int)) *
        ((2 ^ j : Nat) : Int)) :
    (Fl.roundRat N (2 ^ j) z : FV T) = NextProofs.encode T s M := by
  have hK : 0 < magKey T.fmt M := ((magKey_cases T.fmt M).resolve_left (by omega)).2
  have hden : (0 : Int) < T.fmt.den := by exact_mod_cast T.fmt.den_pos
  have hj : (0 : Int) < ((2 ^ j : Nat) : Int) := by exact_mod_cast Nat.two_pow_pos j
  have hKi : (0 : Int) < (magKey T.fmt M : Int) := by exact_mod_cast hK
  have hp := Int.mul_pos hKi hj
  have hN0 : N ≠ 0 := by
    intro h0; rw [h0, Int.zero_mul] at h
    cases s <;> simp only [Bool.false_eq_true, ↓reduceIte, Int.neg_mul] at h <;> omega
  have habs : N.natAbs * T.fmt.den = magKey T.fmt M * 2 ^ j := by
    have := congrArg Int.natAbs h
    simp only [Int.natAbs_mul, Int.natAbs_natCast] at this
    rw [this]; cases s <;> simp
  have hsg : decide (N < 0) = s := by
    cases s <;> simp only [Bool.false_eq_true, ↓reduceIte, Int.neg_mul] at h
    · apply decide_eq_false; intro hlt
      have := Int.mul_neg_of_neg_of_pos hlt hden; omega
    · apply decide_eq_true; apply Classical.byContradiction; intro hge
      have := Int.mul_nonneg (show 0 ≤ N by omega) (Int.le_of_lt hden); omega
  rw [mfRoundRatEncode T N j z M hN0 hM0 hM habs, hsg]

theorem mfSumScale {T : FTy} (x y : FV T) (hx : x.isfinite = true) (hy : y.isfinite = true) (c : Int) :
    ∃ j : Nat, x.toRat.2 * y.toRat.2 = 2 ^ j ∧
      (x.toRat.1 * (y.toRat.2 : Int) + c * (y.toRat.1 * (x.toRat.2 : Int))) * (T.fmt.den : Int) =
        (x.key + c * y.key) * ((2 ^ j : Nat) : Int) := by
  obtain ⟨jx, hjx⟩ := mfToRatPow2 x hx
  obtain ⟨jy, hjy⟩ := mfToRatPow2 y hy
  have hkx := (Fl.toRat_key (good_fty T) x hx).2
  have hky := (Fl.toRat_key (good_fty T) y hy).2
  refine ⟨jx + jy, by rw [hjx, hjy, Nat.pow_add], ?_⟩
  rw [show ((2 ^ (jx + jy) : Nat) : Int) = (x.toRat.2 : Int) * (y.toRat.2 : Int) by
    rw [hjx, hjy, Nat.pow_add, Int.natCast_mul]]
  calc (x.toRat.1 * (y.toRat.2 : Int) + c * (y.toRat.1 * (x.toRat.2 : Int))) * (T.fmt.den : Int)
      = (x.toRat.1 * T.fmt.den) * (y.toRat.2 : Int) + c * ((y.toRat.1 * T.fmt.den) * (x.toRat.2 : Int)) := by
        simp only [Int.add_mul, Int.mul_assoc, Int.mul_comm, Int.mul_left_comm]
    _ = (x.key * x.toRat.2) * (y.toRat.2 : Int) + c * ((y.key * y.toRat.2) * (x.toRat.2 : Int)) := by
        rw [hkx, hky]
    _ = (x.key + c * y.key) * ((x.toRat.2 : Int) * (y.toRat.2 : Int)) := by
        simp only [Int.add_mul, Int.mul_assoc, Int.mul_comm, Int.mul_left_comm]

theorem mfAddRat {T : FTy} (x y : FV T) (hx : x.isfinite = true) (hy : y.isfinite = true) :
    add_float x y = Fl.roundRat (x.toRat.1 * (y.toRat.2 : Int) + 1 * (y.toRat.1 * (x.toRat.2 : Int)))
      (x.toRat.2 * y.toRat.2) (x.signbit && y.signbit) := by
  unfold add_float jlAddFloat floatAdd
  simp only [finishFloat_eq, Fl.isnan_of_finite hx, Fl.isnan_of_finite hy, Fl.isinf_of_finite hx,
    Fl.isinf_of_finite hy, Bool.false_eq_true, ↓reduceIte, Int.one_mul]

theorem mfSubRat {T : FTy} (x y : FV T) (hx : x.isfinite = true) (hy : y.isfinite = true) :
    sub_float x y = Fl.roundRat (x.toRat.1 * (y.toRat.2 : Int) + (-1) * (y.toRat.1 * (x.toRat.2 : Int)))
      (x.toRat.2 * y.toRat.2) (x.signbit && !y.signbit) := by
  have h := EpsilonProofs.sub_finite_rational x y hx hy
  unfold sub_IEEEFloat at h
  rw [h]
  congr 1
  simp only [Int.neg_one_mul, Int.sub_eq_add_neg]

/-- An exact sum or difference whose exact key is `±magKey M` rounds to the encoding of `M`. -/
theorem mfSumEncode {T : FTy} (x y : FV T) (hx : x.isfinite = true) (hy : y.isfinite = true)
    (c : Int) (z : Bool) (s : Bool) (M : Nat) (hM : M < NextProofs.infMag T)
    (hkey : x.key + c * y.key =
      if s then -((magKey T.fmt M : Nat) : Int) else ((magKey T.fmt M : Nat) : Int)) :
    (Fl.roundRat (x.toRat.1 * (y.toRat.2 : Int) + c * (y.toRat.1 * (x.toRat.2 : Int)))
      (x.toRat.2 * y.toRat.2) z : FV T) = (if M = 0 then Fl.zero z else NextProofs.encode T s M) := by
  obtain ⟨j, hj, hscale⟩ := mfSumScale x y hx hy c
  rw [hj]
  by_cases hM0 : M = 0
  · subst hM0
    rw [magKey_zero] at hkey
    have hden : (0 : Int) < T.fmt.den := by exact_mod_cast T.fmt.den_pos
    have h0 : x.toRat.1 * (y.toRat.2 : Int) + c * (y.toRat.1 * (x.toRat.2 : Int)) = 0 := by
      rw [hkey] at hscale
      cases s <;> simp only [Bool.false_eq_true, ↓reduceIte, Int.natCast_zero, Int.neg_zero,
        Int.zero_mul] at hscale <;> exact (Int.mul_eq_zero.1 hscale).resolve_right (by omega)
    rw [h0, mfRoundRatZero _ (by have := Nat.two_pow_pos j; omega)]
    simp
  · rw [if_neg hM0]
    exact mfRoundRatOfKey T _ j z s M hM0 hM (by rw [hscale, hkey])

theorem mfModPowSplit (c e D : Nat) :
    (c * 2 ^ e) % 2 ^ D = (if D ≤ e then 0 else c % 2 ^ (D - e)) * 2 ^ e := by
  split
  · rename_i h
    rw [Nat.zero_mul]
    exact Nat.mod_eq_zero_of_dvd (Nat.dvd_trans (Nat.pow_dvd_pow 2 h) (Nat.dvd_mul_left _ _))
  · rename_i h
    have hD : 2 ^ D = 2 ^ (D - e) * 2 ^ e := by rw [← Nat.pow_add, Nat.sub_add_cancel (by omega)]
    rw [hD, Nat.mul_mod_mul_right]

theorem mfDivPowSplit (c e D : Nat) :
    (c * 2 ^ e) / 2 ^ D * 2 ^ D =
      (if D ≤ e then c else c / 2 ^ (D - e)) * 2 ^ (if D ≤ e then e else D) := by
  split
  · rename_i h
    have he : 2 ^ e = 2 ^ (e - D) * 2 ^ D := by rw [← Nat.pow_add, Nat.sub_add_cancel h]
    rw [he, ← Nat.mul_assoc, Nat.mul_div_cancel _ (Nat.two_pow_pos D)]
  · rename_i h
    have hD : 2 ^ D = 2 ^ (D - e) * 2 ^ e := by rw [← Nat.pow_add, Nat.sub_add_cancel (by omega)]
    rw [hD, Nat.mul_div_mul_right _ _ (Nat.two_pow_pos e)]

/-- Every key `c * 2^e` with `c < 2^(sb+1)` below the overflow threshold is the key of a finite
value. -/
theorem mfReprKey (T : FTy) (K c e : Nat) (hK : K = c * 2 ^ e) (hc : c < 2 ^ (T.fmt.sb + 1))
    (hmax : K < 2 ^ T.fmt.sb * 2 ^ (T.fmt.emax - 1)) :
    ∃ M : Nat, M < NextProofs.infMag T ∧ magKey T.fmt M = K := by
  have hg := good_fty T
  have hemax := hg.emax_eq
  have hbias := hg.bias_pos
  have hP := Nat.two_pow_pos T.fmt.sb
  have hpow : 2 ^ (T.fmt.sb + 1) = 2 * 2 ^ T.fmt.sb := by rw [Nat.pow_succ, Nat.mul_comm]
  by_cases hsmall : K < 2 ^ T.fmt.sb
  · refine ⟨K, ?_, ?_⟩
    · unfold NextProofs.infMag
      have : 2 ^ T.fmt.sb ≤ T.fmt.emax * 2 ^ T.fmt.sb := Nat.le_mul_of_pos_left _ (by omega)
      omega
    · unfold magKey; rw [Nat.div_eq_of_lt hsmall, Nat.mod_eq_of_lt hsmall]; simp
  · have hK0 : K ≠ 0 := by omega
    have hc0 : c ≠ 0 := by intro h; rw [h, Nat.zero_mul] at hK; exact hK0 hK
    have hL : K.log2 = c.log2 + e := by rw [hK, Fl.log2_mul_pow c e hc0]
    have hlc : c.log2 ≤ T.fmt.sb := by have := (Nat.log2_lt hc0).2 hc; omega
    have hLge : T.fmt.sb ≤ K.log2 := (Nat.le_log2 hK0).2 (by omega)
    have hLlt : K.log2 < T.fmt.sb + (T.fmt.emax - 1) :=
      (Nat.log2_lt hK0).2 (by rw [Nat.pow_add]; exact hmax)
    obtain ⟨sh, hsh⟩ : ∃ sh, sh = K.log2 - T.fmt.sb := ⟨_, rfl⟩
    have hse : sh ≤ e := by omega
    obtain ⟨c2, hc2⟩ : ∃ c2, c2 = c * 2 ^ (e - sh) := ⟨_, rfl⟩
    have hKc2 : K = c2 * 2 ^ sh := by
      rw [hK, hc2, Nat.mul_assoc, ← Nat.pow_add, Nat.sub_add_cancel hse]
    have hc2lo : 2 ^ T.fmt.sb ≤ c2 := by
      have h1 := Nat.log2_self_le hK0
      rw [show K.log2 = T.fmt.sb + sh by omega] at h1
      rw [hKc2, Nat.pow_add] at h1
      exact Nat.le_of_mul_le_mul_right h1 (Nat.two_pow_pos sh)
    have hc2hi : c2 < 2 ^ (T.fmt.sb + 1) := by
      have h1 := @Nat.lt_log2_self K
      rw [show K.log2 + 1 = (T.fmt.sb + 1) + sh by omega, Nat.pow_add] at h1
      rw [hKc2] at h1
      exact Nat.lt_of_mul_lt_mul_right h1
    have hr : c2 - 2 ^ T.fmt.sb < 2 ^ T.fmt.sb := by omega
    refine ⟨(sh + 1) * 2 ^ T.fmt.sb + (c2 - 2 ^ T.fmt.sb), ?_, ?_⟩
    · unfold NextProofs.infMag
      have : (sh + 1 + 1) * 2 ^ T.fmt.sb ≤ T.fmt.emax * 2 ^ T.fmt.sb :=
        Nat.mul_le_mul_right _ (by omega)
      rw [Nat.succ_mul] at this
      omega
    · rw [mfMagKeyNormal T (sh + 1) _ (by omega) hr, Nat.sub_add_cancel hc2lo, Nat.add_sub_cancel,
        hKc2]

theorem mfMagKeyForm {T : FTy} (M : Nat) :
    ∃ c e : Nat, magKey T.fmt M = c * 2 ^ e ∧ c < 2 ^ (T.fmt.sb + 1) := by
  have hr := Nat.mod_lt M (Nat.two_pow_pos T.fmt.sb)
  refine ⟨M % 2 ^ T.fmt.sb + (if M / 2 ^ T.fmt.sb = 0 then 0 else 2 ^ T.fmt.sb),
    M / 2 ^ T.fmt.sb - 1, rfl, ?_⟩
  have : 2 ^ (T.fmt.sb + 1) = 2 * 2 ^ T.fmt.sb := by rw [Nat.pow_succ, Nat.mul_comm]
  split <;> omega

theorem mfMagKeyInj {T : FTy} {a b : Nat} (h : magKey T.fmt a = magKey T.fmt b) : a = b := by
  rcases Nat.lt_trichotomy a b with hab | hab | hab
  · have := magKey_strictMono T.fmt hab; omega
  · exact hab
  · have := magKey_strictMono T.fmt hab; omega

theorem mfFiniteKeyMax {T : FTy} (x : FV T) (hx : x.isfinite = true) :
    magKey T.fmt x.magnitude < 2 ^ T.fmt.sb * 2 ^ (T.fmt.emax - 1) := by
  have h := Fl.finite_key_lt_inf (good_fty T) x hx
  have ha := mfKeyNatAbs x
  generalize 2 ^ T.fmt.sb * 2 ^ (T.fmt.emax - 1) = B at h ⊢
  omega

/-! ## mathfuncs-modf-parts -/

theorem mfTruncZero {T : FTy} (x : FV T) (hx : x.isfinite = true) (hz : x.iszero = true) :
    jlTruncLlvm x = x := by
  unfold jlTruncLlvm unaryFloat roundFloat
  simp only [finishFloat_eq, Fl.isnan_of_finite hx, hx, hz, Bool.and_false, Bool.not_true,
    Bool.or_true, Bool.false_eq_true, ↓reduceIte]

theorem mfTruncNonzero {T : FTy} (x : FV T) (hx : x.isfinite = true) (hz : x.iszero = false) :
    jlTruncLlvm x = Fl.roundRat (x.toRat.1.tdiv (x.toRat.2 : Int)) 1 x.signbit := by
  unfold jlTruncLlvm unaryFloat roundFloat
  simp only [finishFloat_eq, Fl.isnan_of_finite hx, hx, hz, Bool.and_false, Bool.not_true,
    Bool.false_or, Bool.false_eq_true, ↓reduceIte]
  generalize x.toRat = r
  obtain ⟨n, d⟩ := r
  rfl

theorem mfTruncEncode {T : FTy} (x : FV T) (hx : x.isfinite = true) :
    ∃ Mt : Nat, Mt < NextProofs.infMag T ∧
      magKey T.fmt Mt = magKey T.fmt x.magnitude / T.fmt.den * T.fmt.den ∧
      jlTruncLlvm x = NextProofs.encode T x.signbit Mt := by
  have hden := T.fmt.den_pos
  obtain ⟨c, e, hce, hc⟩ := mfMagKeyForm (T := T) x.magnitude
  have hKmax := mfFiniteKeyMax x hx
  obtain ⟨Mt, hMt, hMtk⟩ := mfReprKey T (magKey T.fmt x.magnitude / T.fmt.den * T.fmt.den)
    (if T.fmt.bias + T.fmt.sb - 1 ≤ e then c else c / 2 ^ (T.fmt.bias + T.fmt.sb - 1 - e))
    (if T.fmt.bias + T.fmt.sb - 1 ≤ e then e else T.fmt.bias + T.fmt.sb - 1)
    (by rw [hce]; exact mfDivPowSplit c e _)
    (by
      split
      · exact hc
      · exact Nat.lt_of_le_of_lt (Nat.div_le_self _ _) hc)
    (Nat.lt_of_le_of_lt (Nat.div_mul_le_self _ _) hKmax)
  refine ⟨Mt, hMt, hMtk, ?_⟩
  by_cases hz : x.iszero = true
  · rw [mfTruncZero x hx hz]
    have hm : x.magnitude = 0 := by simpa [Fl.iszero] using hz
    have hMt0 : Mt = 0 :=
      mfMagKeyInj (by rw [hMtk, hm, magKey_zero, Nat.zero_div, Nat.zero_mul])
    rw [hMt0, ← hm, NextProofs.encode_input]
  · have hz' : x.iszero = false := by simpa using hz
    rw [mfTruncNonzero x hx hz']
    obtain ⟨jx, hjx⟩ := mfToRatPow2 x hx
    obtain ⟨-, hkx⟩ := Fl.toRat_key (good_fty T) x hx
    have hxd : (0 : Int) < (x.toRat.2 : Int) := by rw [hjx]; exact_mod_cast Nat.two_pow_pos jx
    have htd : (x.toRat.1.tdiv (x.toRat.2 : Int)).natAbs = magKey T.fmt x.magnitude / T.fmt.den := by
      rw [Int.natAbs_tdiv, Int.natAbs_natCast]
      have h := congrArg Int.natAbs hkx
      simp only [Int.natAbs_mul, Int.natAbs_natCast] at h
      rw [mfKeyNatAbs] at h
      show x.toRat.1.natAbs / x.toRat.2 = _
      rw [← Nat.mul_div_mul_right _ _ hden, h, Nat.mul_comm (magKey T.fmt x.magnitude),
        Nat.mul_div_mul_left _ _ (by rw [hjx]; exact Nat.two_pow_pos jx)]
    have hden' : (0 : Int) < T.fmt.den := by exact_mod_cast hden
    have hsx : x.toRat.1.tdiv (x.toRat.2 : Int) = if x.signbit then
        -((magKey T.fmt x.magnitude / T.fmt.den : Nat) : Int)
        else ((magKey T.fmt x.magnitude / T.fmt.den : Nat) : Int) := by
      rw [← htd]
      cases hs : x.signbit
      · have hk := (mfKeySign x).2 hs
        have hn : 0 ≤ x.toRat.1 := by
          apply Classical.byContradiction; intro hn
          have h1 := Int.mul_neg_of_neg_of_pos (show x.toRat.1 < 0 by omega) hden'
          rw [hkx] at h1
          have := Int.mul_nonneg hk (Int.le_of_lt hxd); omega
        have := Int.tdiv_nonneg hn (Int.le_of_lt hxd)
        simp only [Bool.false_eq_true, ↓reduceIte]
        omega
      · have hk := (mfKeySign x).1 hs
        have hn : x.toRat.1 ≤ 0 := by
          apply Classical.byContradiction; intro hn
          have h1 := Int.mul_pos (show 0 < x.toRat.1 by omega) hden'
          rw [hkx] at h1
          have := Int.mul_nonpos_of_nonpos_of_nonneg hk (Int.le_of_lt hxd); omega
        have h2 := Int.tdiv_nonneg (show 0 ≤ -x.toRat.1 by omega) (Int.le_of_lt hxd)
        rw [Int.neg_tdiv] at h2
        simp only [↓reduceIte]
        omega
    rw [hsx]
    by_cases hq0 : magKey T.fmt x.magnitude / T.fmt.den = 0
    · have hMt0 : Mt = 0 := mfMagKeyInj (by rw [hMtk, hq0, Nat.zero_mul, magKey_zero])
      rw [hq0, hMt0, ← mfEncodeZero]
      cases x.signbit <;> exact mfRoundRatZero 1 (by decide) _
    · have hMt0 : Mt ≠ 0 := by
        intro h0; rw [h0, magKey_zero] at hMtk
        have := Nat.mul_pos (Nat.pos_of_ne_zero hq0) hden; omega
      exact mfRoundRatOfKey T _ 0 x.signbit x.signbit Mt hMt0 hMt (by
        rw [hMtk]
        cases x.signbit <;> simp [Int.natCast_mul, Int.neg_mul])

theorem modfPartsAndSigns_proven : ModfPartsAndSigns := by
  intro T o x hfaith
  rcases hfaith with ⟨_, _, _, _, _, _, _, htrunc, _, _, _, _, _, _, _, _, _, _, _⟩
  have hcap := NextProofs.infMag_lt_signMask T
  refine ⟨fun hfinite => ?_, fun hinf => ?_⟩
  · have hx : x.isfinite = true := by rw [← isfinite_IEEEFloat_eq x]; exact hfinite
    have hxi : fisinf x = false := by
      have hEq : isinf_callee x = x.isinf := isinf_IEEEFloat_eq x
      change isinf_callee x = false
      rw [hEq]
      exact Fl.isinf_of_finite hx
    dsimp only
    unfold modfIEEE
    simp only [hxi, Bool.false_eq_true, ↓reduceIte, htrunc]
    obtain ⟨Mt, hMt, hMtk, htr⟩ := mfTruncEncode x hx
    rw [htr]
    -- Integer part.
    obtain ⟨hts, -, -, -, htfin, htkey⟩ :=
      mfEncodeParts T x.signbit (Mt / 2 ^ T.fmt.sb) (Mt % 2 ^ T.fmt.sb)
        (by
          unfold NextProofs.infMag at hMt
          exact Nat.div_lt_of_lt_mul (by rw [Nat.mul_comm]; exact hMt))
        (Nat.mod_lt _ (Nat.two_pow_pos _))
    rw [Nat.div_add_mod'] at hts htfin htkey
    -- Fractional part key `K % den`.
    obtain ⟨c, e, hce, hc⟩ := mfMagKeyForm (T := T) x.magnitude
    have hKmax := mfFiniteKeyMax x hx
    obtain ⟨Mf, hMf, hMfk⟩ := mfReprKey T (magKey T.fmt x.magnitude % T.fmt.den)
      (if T.fmt.bias + T.fmt.sb - 1 ≤ e then 0 else c % 2 ^ (T.fmt.bias + T.fmt.sb - 1 - e)) e
      (by rw [hce]; exact mfModPowSplit c e _)
      (by
        split
        · exact Nat.two_pow_pos _
        · exact Nat.lt_of_le_of_lt (Nat.mod_le _ _) hc)
      (Nat.lt_of_le_of_lt (Nat.mod_le _ _) hKmax)
    obtain ⟨K, hK⟩ : ∃ K, K = magKey T.fmt x.magnitude := ⟨_, rfl⟩
    obtain ⟨Kq, hKq⟩ : ∃ Kq, Kq = magKey T.fmt x.magnitude / T.fmt.den * T.fmt.den := ⟨_, rfl⟩
    obtain ⟨Kr, hKr⟩ : ∃ Kr, Kr = magKey T.fmt x.magnitude % T.fmt.den := ⟨_, rfl⟩
    have hKdec : K = Kq + Kr := by rw [hK, hKq, hKr, Nat.div_add_mod']
    rw [← hKq] at hMtk
    rw [← hKr] at hMfk
    have hxkey : x.key = if x.signbit then -((K : Nat) : Int) else ((K : Nat) : Int) := by
      unfold Fl.key; rw [hK]
    -- `x - trunc(x)` is exact.
    have hsub : sub x (NextProofs.encode T x.signbit Mt) =
        (if Mf = 0 then Fl.zero (x.signbit && !x.signbit) else NextProofs.encode T x.signbit Mf) := by
      show sub_float _ _ = _
      rw [mfSubRat x _ hx htfin, hts]
      apply mfSumEncode x _ hx htfin (-1) _ x.signbit Mf hMf
      rw [hxkey, htkey, hMtk, hMfk]
      cases x.signbit <;> simp only [Bool.false_eq_true, ↓reduceIte] <;> omega
    rw [hsub]
    -- `copysign` restores the sign of `x` on the fraction.
    have hcopy : JuliaLean.base.float.copysign_float
        (if Mf = 0 then Fl.zero (x.signbit && !x.signbit) else NextProofs.encode T x.signbit Mf) x =
        NextProofs.encode T x.signbit Mf := by
      rw [RemainderProofs.copysign_encoded]
      congr 1
      split
      · rename_i h0; rw [h0, mfZeroMag]
      · exact NextProofs.mag_encode T _ (Nat.lt_trans hMf hcap)
    rw [hcopy]
    obtain ⟨hfs, -, -, -, hffin, hfkey⟩ :=
      mfEncodeParts T x.signbit (Mf / 2 ^ T.fmt.sb) (Mf % 2 ^ T.fmt.sb)
        (by
          unfold NextProofs.infMag at hMf
          exact Nat.div_lt_of_lt_mul (by rw [Nat.mul_comm]; exact hMf))
        (Nat.mod_lt _ (Nat.two_pow_pos _))
    rw [Nat.div_add_mod'] at hfs hffin hfkey
    refine ⟨?_, ?_, ?_⟩
    · show add_float _ _ = x
      rw [mfAddRat _ _ hffin htfin, hfs, hts]
      rw [mfSumEncode _ _ hffin htfin 1 (x.signbit && x.signbit) x.signbit x.magnitude
        ((TruncProofs.isfinite_iff_mag x).1 hx) (by
          rw [hfkey, htkey, hMtk, hMfk, ← hK]
          cases x.signbit <;> simp only [Bool.false_eq_true, ↓reduceIte] <;> omega)]
      split
      · rename_i h0
        rw [Bool.and_self, mfEncodeZero, ← h0, NextProofs.encode_input]
      · exact NextProofs.encode_input x
    · show signbit_float _ = signbit_float x
      rw [signbit_float_eq, signbit_float_eq, hfs]
    · show signbit_float _ = signbit_float x
      rw [signbit_float_eq, signbit_float_eq, hts]
  · dsimp only
    unfold modfIEEE
    simp only [hinf, ↓reduceIte]
    have hpos : 0 < NextProofs.signMask T := by unfold NextProofs.signMask; exact Nat.two_pow_pos _
    have hz0 : (fzero T).magnitude = 0 := mfZeroMag false
    refine ⟨?_, ?_, ?_⟩
    · show iszero_float _ = true
      rw [iszero_float_eq, RemainderProofs.copysign_encoded, hz0]
      simp [Fl.iszero, NextProofs.mag_encode T _ hpos]
    · show signbit_float _ = signbit_float x
      rw [signbit_float_eq, signbit_float_eq, RemainderProofs.copysign_encoded, hz0,
        NextProofs.sign_encode T _ hpos]
    · first | rfl | trivial

end MathfuncsProofs

section MathfuncsProofs

open JuliaLean.Proofs.base.float JuliaLean.C

/-! ## mathfuncs-nearest-remainder-range -/

theorem mfEncodeKey (T : FTy) (s : Bool) (M : Nat) (hM : M < NextProofs.infMag T) :
    (NextProofs.encode T s M).isfinite = true ∧
    (NextProofs.encode T s M).key =
      if s then -((magKey T.fmt M : Nat) : Int) else ((magKey T.fmt M : Nat) : Int) := by
  obtain ⟨-, -, -, -, hfin, hkey⟩ := mfEncodeParts T s (M / 2 ^ T.fmt.sb) (M % 2 ^ T.fmt.sb)
    (by
      unfold NextProofs.infMag at hM
      exact Nat.div_lt_of_lt_mul (by rw [Nat.mul_comm]; exact hM))
    (Nat.mod_lt _ (Nat.two_pow_pos _))
  rw [Nat.div_add_mod'] at hfin hkey
  exact ⟨hfin, hkey⟩

theorem mfValueRepr {T : FTy} (v : FV T) (hv : v.isfinite = true) :
    ∃ M, M < NextProofs.infMag T ∧ magKey T.fmt M = v.key.natAbs :=
  ⟨v.magnitude, (TruncProofs.isfinite_iff_mag v).1 hv, (mfKeyNatAbs v).symm⟩

theorem mfMagKeyBound {T : FTy} (M : Nat) (hM : M < NextProofs.infMag T) :
    magKey T.fmt M < 2 ^ T.fmt.sb * 2 ^ (T.fmt.emax - 1) := by
  have h := magKey_strictMono T.fmt hM
  have hk := mfMagKeyNormal T T.fmt.emax 0 (by have := (good_fty T).emax_eq; omega)
    (Nat.two_pow_pos _)
  unfold NextProofs.infMag at h
  rw [Nat.add_zero, Nat.zero_add] at hk
  rw [hk] at h
  exact h

/-- A rounded dyadic rational whose exact key is representable is that key. -/
theorem mfRoundKey (T : FTy) (N : Int) (j : Nat) (z : Bool) (k : Int)
    (h : N * (T.fmt.den : Int) = k * ((2 ^ j : Nat) : Int))
    (hrep : ∃ M, M < NextProofs.infMag T ∧ magKey T.fmt M = k.natAbs) :
    (Fl.roundRat N (2 ^ j) z : FV T).isfinite = true ∧ (Fl.roundRat N (2 ^ j) z : FV T).key = k := by
  obtain ⟨M, hM, hMk⟩ := hrep
  have hden : (0 : Int) < T.fmt.den := by exact_mod_cast T.fmt.den_pos
  have hj : (0 : Int) < ((2 ^ j : Nat) : Int) := by exact_mod_cast Nat.two_pow_pos j
  by_cases hM0 : M = 0
  · subst hM0
    rw [magKey_zero] at hMk
    have hk0 : k = 0 := by omega
    rw [hk0, Int.zero_mul] at h
    have hN : N = 0 := (Int.mul_eq_zero.1 h).resolve_right (by omega)
    rw [hN, mfRoundRatZero _ (by have := Nat.two_pow_pos j; omega), hk0]
    exact Fl.zero_spec (good_fty T) z
  · have hsk : (if decide (k < 0) then -((k.natAbs : Nat) : Int) else ((k.natAbs : Nat) : Int)) = k := by
      by_cases hk : k < 0
      · rw [if_pos (by simpa using hk)]; omega
      · rw [if_neg (by simpa using hk)]; omega
    have hr := mfRoundRatOfKey T N j z (decide (k < 0)) M hM0 hM (by rw [hMk, hsk]; exact h)
    obtain ⟨hfin, hkey⟩ := mfEncodeKey T (decide (k < 0)) M hM
    rw [hr]
    exact ⟨hfin, by rw [hkey, hMk, hsk]⟩

theorem mfSubKey {T : FTy} (a b : FV T) (ha : a.isfinite = true) (hb : b.isfinite = true)
    (hrep : ∃ M, M < NextProofs.infMag T ∧ magKey T.fmt M = (a.key - b.key).natAbs) :
    (sub a b).isfinite = true ∧ (sub a b).key = a.key - b.key := by
  obtain ⟨j, hj, hscale⟩ := mfSumScale a b ha hb (-1)
  show (sub_float a b).isfinite = true ∧ (sub_float a b).key = a.key - b.key
  rw [mfSubRat a b ha hb, hj]
  apply mfRoundKey T _ j _ _ _ hrep
  rw [hscale]
  congr 1
  omega

theorem mfMulRat {T : FTy} (x y : FV T) (hx : x.isfinite = true) (hy : y.isfinite = true) :
    mul_float x y = Fl.roundRat (x.toRat.1 * y.toRat.1) (x.toRat.2 * y.toRat.2) (x.signbit != y.signbit) := by
  unfold mul_float jlMulFloat floatMul
  simp only [finishFloat_eq, Fl.isnan_of_finite hx, Fl.isnan_of_finite hy, Fl.isinf_of_finite hx,
    Fl.isinf_of_finite hy, Bool.false_and, Bool.or_false, Bool.false_or, Bool.false_eq_true,
    ↓reduceIte]

theorem mfMulKey {T : FTy} (x y : FV T) (hx : x.isfinite = true) (hy : y.isfinite = true) (k : Int)
    (hk : x.key * y.key = k * T.fmt.den)
    (hrep : ∃ M, M < NextProofs.infMag T ∧ magKey T.fmt M = k.natAbs) :
    (mul_float x y).isfinite = true ∧ (mul_float x y).key = k := by
  obtain ⟨jx, hjx⟩ := mfToRatPow2 x hx
  obtain ⟨jy, hjy⟩ := mfToRatPow2 y hy
  have hkx := (Fl.toRat_key (good_fty T) x hx).2
  have hky := (Fl.toRat_key (good_fty T) y hy).2
  have hden : (0 : Int) < T.fmt.den := by exact_mod_cast T.fmt.den_pos
  rw [mfMulRat x y hx hy, show x.toRat.2 * y.toRat.2 = 2 ^ (jx + jy) by rw [hjx, hjy, Nat.pow_add]]
  apply mfRoundKey T _ (jx + jy) _ k _ hrep
  apply Int.eq_of_mul_eq_mul_right (Int.ne_of_gt hden)
  calc x.toRat.1 * y.toRat.1 * T.fmt.den * T.fmt.den
      = (x.toRat.1 * T.fmt.den) * (y.toRat.1 * T.fmt.den) := by
        simp only [Int.mul_assoc, Int.mul_comm, Int.mul_left_comm]
    _ = (x.key * x.toRat.2) * (y.key * y.toRat.2) := by rw [hkx, hky]
    _ = (x.key * y.key) * ((x.toRat.2 : Int) * (y.toRat.2 : Int)) := by
        simp only [Int.mul_assoc, Int.mul_comm, Int.mul_left_comm]
    _ = k * ((2 ^ (jx + jy) : Nat) : Int) * T.fmt.den := by
        rw [hk, hjx, hjy, Nat.pow_add, Int.natCast_mul]
        simp only [Int.mul_assoc, Int.mul_comm, Int.mul_left_comm]

theorem mfDivRat {T : FTy} (x y : FV T) (hx : x.isfinite = true) (hy : y.isfinite = true)
    (hy0 : y.iszero = false) :
    div_float x y = Fl.roundRat
      (if y.toRat.1 < 0 then -(x.toRat.1 * (y.toRat.2 : Int)) else x.toRat.1 * (y.toRat.2 : Int))
      (x.toRat.2 * y.toRat.1.natAbs) (x.signbit != y.signbit) := by
  unfold div_float jlDivFloat floatDiv
  simp only [finishFloat_eq, Fl.isnan_of_finite hx, Fl.isnan_of_finite hy, Fl.isinf_of_finite hx,
    Fl.isinf_of_finite hy, hy0, Bool.false_and, Bool.and_false, Bool.or_false, Bool.false_or,
    Bool.false_eq_true, ↓reduceIte]

theorem mfTwoFacts (T : FTy) :
    (Fl.ofInt 2 : FV T).isfinite = true ∧ (Fl.ofInt 2 : FV T).iszero = false ∧
    (Fl.ofInt 2 : FV T).key = 2 * (T.fmt.den : Int) := by
  cases T <;> decide +kernel

theorem mfFloatminFacts (T : FTy) :
    (floatmin_float T).isfinite = true ∧ (floatmin_float T).key = ((2 ^ T.fmt.sb : Nat) : Int) ∧
    (mul (Fl.ofInt 2) (floatmin_float T) : FV T).isfinite = true ∧
    (mul (Fl.ofInt 2) (floatmin_float T) : FV T).key = ((2 ^ (T.fmt.sb + 1) : Nat) : Int) := by
  cases T <;> decide +kernel

theorem mfDoubleRepr (T : FTy) (A : Nat) (hA : ∃ M, M < NextProofs.infMag T ∧ magKey T.fmt M = A)
    (hb : 2 * A < 2 ^ T.fmt.sb * 2 ^ (T.fmt.emax - 1)) :
    ∃ M, M < NextProofs.infMag T ∧ magKey T.fmt M = 2 * A := by
  obtain ⟨M, -, hMk⟩ := hA
  obtain ⟨c, e, hce, hc⟩ := mfMagKeyForm (T := T) M
  apply mfReprKey T _ c (e + 1) _ hc hb
  rw [← hMk, hce, Nat.pow_succ]
  simp only [Nat.mul_assoc, Nat.mul_comm, Nat.mul_left_comm]

theorem mfHalfRepr (T : FTy) (A : Nat) (hA : ∃ M, M < NextProofs.infMag T ∧ magKey T.fmt M = A)
    (hbig : 2 ^ (T.fmt.sb + 1) ≤ A) :
    A % 2 = 0 ∧ ∃ M, M < NextProofs.infMag T ∧ magKey T.fmt M = A / 2 := by
  obtain ⟨M, hM, hMk⟩ := hA
  obtain ⟨c, e, hce, hc⟩ := mfMagKeyForm (T := T) M
  rw [hMk] at hce
  have he : e ≠ 0 := by
    intro h0; rw [h0, Nat.pow_zero, Nat.mul_one] at hce; omega
  have hA2 : A = c * 2 ^ (e - 1) * 2 := by
    rw [hce, Nat.mul_assoc, ← Nat.pow_add_one, Nat.sub_add_cancel (by omega)]
  refine ⟨by rw [hA2]; omega, ?_⟩
  apply mfReprKey T _ c (e - 1) (by rw [hA2, Nat.mul_div_cancel _ (by decide)]) hc
  have := mfMagKeyBound M hM
  rw [hMk] at this
  omega

theorem mfMulTwoKey {T : FTy} (v : FV T) (hv : v.isfinite = true)
    (hb : 2 * v.key.natAbs < 2 ^ T.fmt.sb * 2 ^ (T.fmt.emax - 1)) :
    (mul (Fl.ofInt 2) v).isfinite = true ∧ (mul (Fl.ofInt 2) v).key = 2 * v.key := by
  obtain ⟨h2f, -, h2k⟩ := mfTwoFacts T
  apply mfMulKey _ v h2f hv (2 * v.key)
  · rw [h2k]; simp only [Int.mul_assoc, Int.mul_comm, Int.mul_left_comm]
  · rw [show (2 * v.key).natAbs = 2 * v.key.natAbs by omega]
    exact mfDoubleRepr T v.key.natAbs (mfValueRepr v hv) hb

theorem mfMulTwoRightKey {T : FTy} (v : FV T) (hv : v.isfinite = true)
    (hb : 2 * v.key.natAbs < 2 ^ T.fmt.sb * 2 ^ (T.fmt.emax - 1)) :
    (mul v (Fl.ofInt 2)).isfinite = true ∧ (mul v (Fl.ofInt 2)).key = 2 * v.key := by
  obtain ⟨h2f, -, h2k⟩ := mfTwoFacts T
  apply mfMulKey v _ hv h2f (2 * v.key)
  · rw [h2k]; simp only [Int.mul_assoc, Int.mul_comm, Int.mul_left_comm]
  · rw [show (2 * v.key).natAbs = 2 * v.key.natAbs by omega]
    exact mfDoubleRepr T v.key.natAbs (mfValueRepr v hv) hb

theorem mfDivTwoKey {T : FTy} (v : FV T) (hv : v.isfinite = true) (k : Int) (hk : v.key = 2 * k)
    (hrep : ∃ M, M < NextProofs.infMag T ∧ magKey T.fmt M = k.natAbs) :
    (div v (Fl.ofInt 2)).isfinite = true ∧ (div v (Fl.ofInt 2)).key = k := by
  obtain ⟨h2f, h2z, h2k⟩ := mfTwoFacts T
  show (div_float v (Fl.ofInt 2)).isfinite = true ∧ (div_float v (Fl.ofInt 2)).key = k
  rw [mfDivRat v _ hv h2f h2z]
  obtain ⟨jv, hjv⟩ := mfToRatPow2 v hv
  obtain ⟨jt, hjt⟩ := mfToRatPow2 (Fl.ofInt 2 : FV T) h2f
  have hkv := (Fl.toRat_key (good_fty T) v hv).2
  have hkt := (Fl.toRat_key (good_fty T) (Fl.ofInt 2 : FV T) h2f).2
  have hden : (0 : Int) < T.fmt.den := by exact_mod_cast T.fmt.den_pos
  have ht1 : (Fl.ofInt 2 : FV T).toRat.1 = 2 * ((Fl.ofInt 2 : FV T).toRat.2 : Int) := by
    rw [h2k] at hkt
    apply Int.eq_of_mul_eq_mul_right (Int.ne_of_gt hden)
    rw [hkt]; simp only [Int.mul_assoc, Int.mul_comm, Int.mul_left_comm]
  have hpos : ¬ (Fl.ofInt 2 : FV T).toRat.1 < 0 := by
    rw [ht1, hjt]; have := Nat.two_pow_pos jt; omega
  have hnat : (Fl.ofInt 2 : FV T).toRat.1.natAbs = 2 ^ (jt + 1) := by
    rw [ht1, hjt, Nat.pow_succ]; omega
  rw [if_neg hpos, hnat, hjv, ← Nat.pow_add]
  apply mfRoundKey T _ (jv + (jt + 1)) _ k _ hrep
  rw [hjt]
  have hkv' : v.toRat.1 * T.fmt.den = 2 * k * ((2 ^ jv : Nat) : Int) := by rw [hkv, hk, hjv]
  calc v.toRat.1 * ((2 ^ jt : Nat) : Int) * T.fmt.den
      = (v.toRat.1 * T.fmt.den) * ((2 ^ jt : Nat) : Int) := by
        simp only [Int.mul_assoc, Int.mul_comm, Int.mul_left_comm]
    _ = (2 * k * ((2 ^ jv : Nat) : Int)) * ((2 ^ jt : Nat) : Int) := by rw [hkv']
    _ = k * ((2 ^ (jv + (jt + 1)) : Nat) : Int) := by
        push_cast
        rw [Int.pow_add, Int.pow_succ']
        simp only [Int.mul_assoc, Int.mul_comm, Int.mul_left_comm]

theorem mfInfIsinf (T : FTy) (b : Bool) : (Fl.inf b : FV T).isinf = true := by
  cases T <;> cases b <;> decide

theorem mfRoundRatOverflow (T : FTy) (N : Int) (j : Nat) (z : Bool)
    (h : 2 ^ (j + (T.fmt.emax - T.fmt.bias)) ≤ N.natAbs) :
    (Fl.roundRat N (2 ^ j) z : FV T).isinf = true := by
  have hpos := Nat.two_pow_pos (j + (T.fmt.emax - T.fmt.bias))
  have hN : N ≠ 0 := by intro h0; rw [h0, Int.natAbs_zero] at h; omega
  have hbig : Fl.floorLog2Rat N.natAbs (2 ^ j) ≥ (T.fmt.emax : Int) - T.fmt.bias := by
    rw [Fl.floorLog2Rat_pow _ _ (by omega)]
    have := (Nat.le_log2 (by omega)).2 h
    have hb := (good_fty T).emax_eq
    omega
  have hd : (2 ^ j == 0) = false := by
    have := Nat.two_pow_pos j; simp only [beq_eq_false_iff_ne]; omega
  have hn : (N == 0) = false := by simp only [beq_eq_false_iff_ne]; exact hN
  unfold Fl.roundRat
  simp only [hd, hn, Bool.false_eq_true, ↓reduceIte, hbig]
  exact mfInfIsinf T _

theorem mfMulTwoOverflow {T : FTy} (v : FV T) (hv : v.isfinite = true)
    (hb : 2 ^ T.fmt.sb * 2 ^ (T.fmt.emax - 1) ≤ 2 * v.key.natAbs) :
    (mul v (Fl.ofInt 2)).isinf = true := by
  obtain ⟨h2f, -, h2k⟩ := mfTwoFacts T
  show (mul_float v (Fl.ofInt 2)).isinf = true
  rw [mfMulRat v _ hv h2f]
  obtain ⟨jv, hjv⟩ := mfToRatPow2 v hv
  obtain ⟨jt, hjt⟩ := mfToRatPow2 (Fl.ofInt 2 : FV T) h2f
  have hkv := (Fl.toRat_key (good_fty T) v hv).2
  have hkt := (Fl.toRat_key (good_fty T) (Fl.ofInt 2 : FV T) h2f).2
  have hden : (0 : Int) < T.fmt.den := by exact_mod_cast T.fmt.den_pos
  have ht1 : (Fl.ofInt 2 : FV T).toRat.1 = 2 * ((Fl.ofInt 2 : FV T).toRat.2 : Int) := by
    rw [h2k] at hkt
    apply Int.eq_of_mul_eq_mul_right (Int.ne_of_gt hden)
    rw [hkt]; simp only [Int.mul_assoc, Int.mul_comm, Int.mul_left_comm]
  have hrel : (v.toRat.1 * (Fl.ofInt 2 : FV T).toRat.1) * T.fmt.den =
      (2 * v.key) * ((2 ^ (jv + jt) : Nat) : Int) := by
    rw [ht1, hjt, Nat.pow_add, Int.natCast_mul]
    calc v.toRat.1 * (2 * ((2 ^ jt : Nat) : Int)) * T.fmt.den
        = (v.toRat.1 * T.fmt.den) * (2 * ((2 ^ jt : Nat) : Int)) := by
          simp only [Int.mul_assoc, Int.mul_comm, Int.mul_left_comm]
      _ = (v.key * ((2 ^ jv : Nat) : Int)) * (2 * ((2 ^ jt : Nat) : Int)) := by rw [hkv, hjv]
      _ = 2 * v.key * (((2 ^ jv : Nat) : Int) * ((2 ^ jt : Nat) : Int)) := by
          simp only [Int.mul_assoc, Int.mul_comm, Int.mul_left_comm]
  rw [show v.toRat.2 * (Fl.ofInt 2 : FV T).toRat.2 = 2 ^ (jv + jt) by rw [hjv, hjt, Nat.pow_add]]
  apply mfRoundRatOverflow
  have habs := congrArg Int.natAbs hrel
  simp only [Int.natAbs_mul, Int.natAbs_natCast, show (2 : Int).natAbs = 2 from rfl] at habs
  simp only [Int.natAbs_mul]
  generalize (v.toRat.1).natAbs * ((Fl.ofInt 2 : FV T).toRat.1).natAbs = U at habs ⊢
  apply Nat.le_of_mul_le_mul_right (c := T.fmt.den) _ T.fmt.den_pos
  rw [habs]
  have hp : 2 ^ (jv + jt + (T.fmt.emax - T.fmt.bias)) * T.fmt.den =
      2 ^ T.fmt.sb * 2 ^ (T.fmt.emax - 1) * 2 ^ (jv + jt) := by
    unfold Fmt.den
    rw [← Nat.pow_add, ← Nat.pow_add, ← Nat.pow_add]
    congr 1
    have := (good_fty T).emax_eq; have := (good_fty T).bias_pos; omega
  rw [hp]
  exact Nat.mul_le_mul_right _ hb

theorem mfSterbenz (T : FTy) (A B : Nat)
    (hA : ∃ M, M < NextProofs.infMag T ∧ magKey T.fmt M = A)
    (hB : ∃ M, M < NextProofs.infMag T ∧ magKey T.fmt M = B)
    (h1 : A ≤ 2 * B) (h2 : B ≤ 2 * A) :
    ∃ M, M < NextProofs.infMag T ∧ magKey T.fmt M = ((A : Int) - (B : Int)).natAbs := by
  obtain ⟨Ma, hMa, hka⟩ := hA
  obtain ⟨Mb, hMb, hkb⟩ := hB
  obtain ⟨ca, ea, hca, hcaB⟩ := mfMagKeyForm (T := T) Ma
  obtain ⟨cb, eb, hcb, hcbB⟩ := mfMagKeyForm (T := T) Mb
  rw [hka] at hca
  rw [hkb] at hcb
  have hAm := mfMagKeyBound Ma hMa
  have hBm := mfMagKeyBound Mb hMb
  rw [hka] at hAm
  rw [hkb] at hBm
  have hbound : ((A : Int) - (B : Int)).natAbs < 2 ^ T.fmt.sb * 2 ^ (T.fmt.emax - 1) := by
    generalize 2 ^ T.fmt.sb * 2 ^ (T.fmt.emax - 1) = Bd at hAm hBm ⊢
    omega
  rcases Nat.le_total ea eb with hle | hle
  · obtain ⟨b', hb'⟩ : ∃ b', b' = cb * 2 ^ (eb - ea) := ⟨_, rfl⟩
    have hB' : B = b' * 2 ^ ea := by
      rw [hcb, hb', Nat.mul_assoc, ← Nat.pow_add, Nat.sub_add_cancel hle]
    have hb'le : b' ≤ 2 * ca := by
      have h3 : b' * 2 ^ ea ≤ (2 * ca) * 2 ^ ea := by
        rw [← hB', Nat.mul_assoc, ← hca]; exact h2
      exact Nat.le_of_mul_le_mul_right h3 (Nat.two_pow_pos ea)
    apply mfReprKey T _ (if ca ≤ b' then b' - ca else ca - b') ea _ _ hbound
    · rw [hca, hB']
      split
      · rename_i h
        have h4 := Nat.mul_le_mul_right (2 ^ ea) h
        rw [Nat.sub_mul]
        generalize ca * 2 ^ ea = u at h4 ⊢
        generalize b' * 2 ^ ea = w at h4 ⊢
        omega
      · rename_i h
        have h4 := Nat.mul_le_mul_right (2 ^ ea) (show b' ≤ ca by omega)
        rw [Nat.sub_mul]
        generalize ca * 2 ^ ea = u at h4 ⊢
        generalize b' * 2 ^ ea = w at h4 ⊢
        omega
    · split <;> omega
  · obtain ⟨a', ha'⟩ : ∃ a', a' = ca * 2 ^ (ea - eb) := ⟨_, rfl⟩
    have hA' : A = a' * 2 ^ eb := by
      rw [hca, ha', Nat.mul_assoc, ← Nat.pow_add, Nat.sub_add_cancel hle]
    have ha'le : a' ≤ 2 * cb := by
      have h3 : a' * 2 ^ eb ≤ (2 * cb) * 2 ^ eb := by
        rw [← hA', Nat.mul_assoc, ← hcb]; exact h1
      exact Nat.le_of_mul_le_mul_right h3 (Nat.two_pow_pos eb)
    apply mfReprKey T _ (if a' ≤ cb then cb - a' else a' - cb) eb _ _ hbound
    · rw [hcb, hA']
      split
      · rename_i h
        have h4 := Nat.mul_le_mul_right (2 ^ eb) h
        rw [Nat.sub_mul]
        generalize a' * 2 ^ eb = u at h4 ⊢
        generalize cb * 2 ^ eb = w at h4 ⊢
        omega
      · rename_i h
        have h4 := Nat.mul_le_mul_right (2 ^ eb) (show cb ≤ a' by omega)
        rw [Nat.sub_mul]
        generalize a' * 2 ^ eb = u at h4 ⊢
        generalize cb * 2 ^ eb = w at h4 ⊢
        omega
    · split <;> omega

theorem mfQRatLeHalf {T : FTy} (a b : FV T) (ha : a.isfinite = true) (hb : b.isfinite = true)
    (h : 2 * a.key ≤ b.key) : QRatLe a.toRat (QHalf b.toRat) = true := by
  obtain ⟨ha2, hka⟩ := Fl.toRat_key (good_fty T) a ha
  obtain ⟨hb2, hkb⟩ := Fl.toRat_key (good_fty T) b hb
  have hden : (0 : Int) < T.fmt.den := by exact_mod_cast T.fmt.den_pos
  have h2a : (0 : Int) < (a.toRat.2 : Int) := by exact_mod_cast ha2
  have h2b : (0 : Int) < (b.toRat.2 : Int) := by exact_mod_cast hb2
  unfold QRatLe QHalf
  apply decide_eq_true
  apply Int.le_of_mul_le_mul_right _ hden
  calc a.toRat.1 * ((2 * b.toRat.2 : Nat) : Int) * T.fmt.den
      = (a.toRat.1 * T.fmt.den) * (2 * (b.toRat.2 : Int)) := by
        push_cast; simp only [Int.mul_assoc, Int.mul_comm, Int.mul_left_comm]
    _ = (a.key * a.toRat.2) * (2 * (b.toRat.2 : Int)) := by rw [hka]
    _ = (2 * a.key) * ((a.toRat.2 : Int) * (b.toRat.2 : Int)) := by
        simp only [Int.mul_assoc, Int.mul_comm, Int.mul_left_comm]
    _ ≤ b.key * ((a.toRat.2 : Int) * (b.toRat.2 : Int)) :=
        Int.mul_le_mul_of_nonneg_right h (Int.le_of_lt (Int.mul_pos h2a h2b))
    _ = (b.key * b.toRat.2) * (a.toRat.2 : Int) := by
        simp only [Int.mul_assoc, Int.mul_comm, Int.mul_left_comm]
    _ = (b.toRat.1 * T.fmt.den) * (a.toRat.2 : Int) := by rw [hkb]
    _ = b.toRat.1 * (a.toRat.2 : Int) * T.fmt.den := by
        simp only [Int.mul_assoc, Int.mul_comm, Int.mul_left_comm]

theorem mfAbsKey {T : FTy} (r : FV T) (hr : r.isfinite = true) :
    (fabs r).isfinite = true ∧ (fabs r).key = (r.key.natAbs : Int) := by
  have hrM := (TruncProofs.isfinite_iff_mag r).1 hr
  obtain ⟨hf, hk⟩ := mfEncodeKey T false r.magnitude hrM
  rw [← RemainderProofs.abs_encoded r hr] at hf hk
  refine ⟨hf, ?_⟩
  rw [hk]
  simp only [Bool.false_eq_true, ↓reduceIte, mfKeyNatAbs]

theorem mfNearestFinal {T : FTy} (r p0 : FV T) (hr : r.isfinite = true) (hp : p0.isfinite = true)
    (h : 2 * r.key.natAbs ≤ p0.key.natAbs) :
    fisfinite r = true ∧ QRatLe (fabs r).toRat (QHalf (fabs p0).toRat) = true := by
  refine ⟨(isfinite_IEEEFloat_eq r).trans hr, ?_⟩
  obtain ⟨hraf, hrak⟩ := mfAbsKey r hr
  obtain ⟨hpaf, hpak⟩ := mfAbsKey p0 hp
  apply mfQRatLeHalf _ _ hraf hpaf
  rw [hrak, hpak]
  omega

theorem mfFlipFacts {T : FTy} (o : IEEEOps T)
    (hflip : ∀ x y : FV T, o.flipsign x y = if y.signbit then Fl.neg x else x)
    (v y : FV T) (hv : v.isfinite = true) :
    (o.flipsign v y).isfinite = true ∧ (o.flipsign v y).key.natAbs = v.key.natAbs := by
  rw [hflip]
  split
  · obtain ⟨hm, -⟩ := fl_neg_parts v
    refine ⟨?_, ?_⟩
    · rw [TruncProofs.isfinite_iff_mag, hm]; exact (TruncProofs.isfinite_iff_mag v).1 hv
    · rw [mfKeyNatAbs, mfKeyNatAbs, hm]
  · exact ⟨hv, rfl⟩

theorem mfIdIteFlip {T : FTy} (o : IEEEOps T) (x0 a b c : FV T) (c1 c2 c3 c4 c5 : Bool) :
    Id.run (if c1 = true then
        (if c2 = true then
          (if c3 = true then pure (o.flipsign a x0) else pure (o.flipsign b x0))
        else pure (o.flipsign c x0))
      else
        (if c4 = true then
          (if c5 = true then pure (o.flipsign a x0) else pure (o.flipsign b x0))
        else pure (o.flipsign c x0))) =
    o.flipsign (if c1 = true then (if c2 = true then (if c3 = true then a else b) else c)
      else (if c4 = true then (if c5 = true then a else b) else c)) x0 := by
  cases c1 <;> cases c2 <;> cases c3 <;> cases c4 <;> cases c5 <;> rfl

/-- The reduction step of `rem(x, p, RoundNearest)` after `x = abs(rem(x, 2p))` and `p = abs(p)`. -/
def mfRemCore {T : FTy} (p x : FV T) : FV T :=
  if flt p (mul (Fl.ofInt 2) (floatmin_float T)) = true then
    (if flt p (mul (Fl.ofInt 2) x) = true then
      (if fle p (mul (Fl.ofInt 2) (sub x p)) = true then sub (sub x p) p else sub x p)
    else x)
  else
    (if flt (div p (Fl.ofInt 2)) x = true then
      (if fle (div p (Fl.ofInt 2)) (sub x p) = true then sub (sub x p) p else sub x p)
    else x)

theorem mfNearestCore {T : FTy} (p x : FV T) (hpf : p.isfinite = true) (hxf : x.isfinite = true)
    (hp0 : 0 < p.key) (hx0 : 0 ≤ x.key) (hX : x.key < 2 * p.key) :
    (mfRemCore p x).isfinite = true ∧ 2 * (mfRemCore p x).key.natAbs ≤ p.key.natAbs := by
  have hg := good_fty T
  obtain ⟨-, -, -, hsb2⟩ := mfFmtBounds T
  have hemax := hg.emax_eq
  obtain ⟨Bd, hBd⟩ : ∃ Bd, Bd = 2 ^ T.fmt.sb * 2 ^ (T.fmt.emax - 1) := ⟨_, rfl⟩
  have hBig : 2 ^ (T.fmt.sb + 3) ≤ Bd := by
    rw [hBd, ← Nat.pow_add]; exact Nat.pow_le_pow_right (by decide) (by omega)
  have h3 : 2 ^ (T.fmt.sb + 3) = 4 * 2 ^ (T.fmt.sb + 1) := by
    rw [show T.fmt.sb + 3 = (T.fmt.sb + 1) + 2 by omega, Nat.pow_add]; omega
  have hpB : p.key.natAbs < Bd := by
    have h1 := mfFiniteKeyMax p hpf; have h2 := mfKeyNatAbs p; omega
  have hlt : ∀ a b : FV T, a.isfinite = true → b.isfinite = true →
      flt a b = decide (a.key < b.key) :=
    fun a b ha hb => Fl.lt_key (Fl.isnan_of_finite ha) (Fl.isnan_of_finite hb)
  have hle : ∀ a b : FV T, a.isfinite = true → b.isfinite = true →
      fle a b = decide (a.key ≤ b.key) :=
    fun a b ha hb => le_IEEEFloat_key a b (Fl.isnan_of_finite ha) (Fl.isnan_of_finite hb)
  obtain ⟨-, -, hm2f, hm2k⟩ := mfFloatminFacts T
  have hS1 : p.key < 2 * x.key →
      (sub x p).isfinite = true ∧ (sub x p).key = x.key - p.key := fun h =>
    mfSubKey x p hxf hpf (by
      have hs := mfSterbenz T x.key.natAbs p.key.natAbs (mfValueRepr x hxf) (mfValueRepr p hpf)
        (by omega) (by omega)
      rw [show ((x.key.natAbs : Nat) : Int) = x.key by omega,
        show ((p.key.natAbs : Nat) : Int) = p.key by omega] at hs
      exact hs)
  have hS2 : p.key < 2 * x.key → p.key ≤ 2 * (x.key - p.key) →
      (sub (sub x p) p).isfinite = true ∧ (sub (sub x p) p).key = x.key - 2 * p.key := by
    intro h1 h
    obtain ⟨hf1, hk1⟩ := hS1 h1
    obtain ⟨hf2, hk2⟩ := mfSubKey (sub x p) p hf1 hpf (by
