  have hR : R.key ^ 2 = (floatmin_float .f64).key * FTy.f64.fmt.den := by decide
  have hlo := root_sqrt_lower_bound s R hi.1 hi.2.1 (by decide) (by decide) (by
    rw [hR]
    exact Int.mul_le_mul_of_nonneg_right hi.2.2.1 (Int.natCast_nonneg _))
