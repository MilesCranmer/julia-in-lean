private theorem qPowTwoRangeDyadic (n j : Nat) (hn : n ≠ 0) :
    QRatLe (QPowTwo ((n.log2 : Int) - j)) (n, 2 ^ j) = true ∧
    QRatLt (n, 2 ^ j) (QPowTwo (((n.log2 : Int) - j) + 1)) = true := by
  have hlo : 2 ^ n.log2 ≤ n := Nat.log2_self_le hn
  have hhi : n < 2 ^ (n.log2 + 1) := Nat.lt_log2_self
