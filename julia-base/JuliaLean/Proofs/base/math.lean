/-- Adding a rounded grid value and rounding on the doubled grid recovers
    the original rounded coefficient. The quarter-step margin is strict. -/
theorem hypot_round_quotient_add_rounded (n d : Nat) (hd : 0 < d) :
    Fl.roundQuotient (n + Fl.roundQuotient n d * d) (2 * d) = Fl.roundQuotient n d := by
  let q := Fl.roundQuotient n d
  let r := Fl.roundQuotient (n + q * d) (2 * d)
  have h1 := root_round_quotient_error n d hd
  have h2 := root_round_quotient_error (n + q * d) (2 * d) (by omega)
  change -(d : Int) ≤ 2 * ((q : Int) * d - n) ∧
    2 * ((q : Int) * d - n) ≤ (d : Int) at h1
  change -((2 * d : Nat) : Int) ≤ 2 * ((r : Int) * ((2 * d : Nat) : Int) - ((n + q * d : Nat) : Int)) ∧
    2 * ((r : Int) * ((2 * d : Nat) : Int) - ((n + q * d : Nat) : Int)) ≤ ((2 * d : Nat) : Int) at h2
  simp only [Int.natCast_mul, Int.natCast_add] at h2
  change -(2 * (d : Int)) ≤ 2 * ((r : Int) * (2 * (d : Int)) - ((n : Int) + (q : Int) * d)) ∧
    2 * ((r : Int) * (2 * (d : Int)) - ((n : Int) + (q : Int) * d)) ≤ 2 * (d : Int) at h2
  have hm : (r : Int) * (2 * (d : Int)) = 2 * ((r : Int) * d) := by ac_rfl
  rw [hm] at h2
  change r = q
  apply Nat.le_antisymm
  · apply Classical.byContradiction
    intro hnot
    have hgap : q + 1 ≤ r := by omega
    have hmul : ((q : Int) + 1) * d ≤ (r : Int) * d := by
      exact_mod_cast Nat.mul_le_mul_right d hgap
    rw [Int.add_mul, Int.one_mul] at hmul
    omega
  · apply Classical.byContradiction
    intro hnot
    have hgap : r + 1 ≤ q := by omega
    have hmul : ((r : Int) + 1) * d ≤ (q : Int) * d := by
      exact_mod_cast Nat.mul_le_mul_right d hgap
    rw [Int.add_mul, Int.one_mul] at hmul
    omega

/-- At large normal integer inputs, x+RN(x) has precisely the next binade. -/
theorem hypot_round_add_rounded_log (N : Nat) (hlo : 53 ≤ N.log2) :
    (N + Fl.roundQuotient N (2 ^ (N.log2 - 52)) * 2 ^ (N.log2 - 52)).log2 = N.log2 + 1 := by
  have hn : N ≠ 0 := by intro h; subst N; simp at hlo
  let q := Fl.roundQuotient N (2 ^ (N.log2 - 52))
  let G := 2 ^ (N.log2 - 52)
  have hq := rounded_significand_bounds JuliaLean.base.float.FTy.f64.fmt N hn
  change 2 ^ 52 ≤ (if 52 ≤ N.log2 then q else _) ∧
    (if 52 ≤ N.log2 then q else _) ≤ 2 ^ 53 at hq
  rw [ite_eq_left (by omega)] at hq
  have hnlo : 2 ^ N.log2 ≤ N := Nat.log2_self_le hn
  have hnhi : N < 2 ^ (N.log2 + 1) := Nat.lt_log2_self
  have hYlo : 2 ^ N.log2 ≤ q * G := by
    have h := Nat.mul_le_mul_right G hq.1
    change 2 ^ 52 * 2 ^ (N.log2 - 52) ≤ _ at h
    rw [← Nat.pow_add, Nat.add_sub_of_le (by omega : 52 ≤ N.log2)] at h
    exact h
  have hYhi : q * G ≤ 2 ^ (N.log2 + 1) := by
    have h := Nat.mul_le_mul_right G hq.2
    change _ ≤ 2 ^ 53 * 2 ^ (N.log2 - 52) at h
    rw [← Nat.pow_add, show 53 + (N.log2 - 52) = N.log2 + 1 by omega] at h
    exact h
  let M := N + q * G
  have hMlo : 2 ^ (N.log2 + 1) ≤ M := by
    rw [Nat.pow_succ]
    dsimp only [M]
    omega
  have hMhi : M < 2 ^ ((N.log2 + 1) + 1) := by
    rw [Nat.pow_succ]
    dsimp only [M]
    omega
  have hM0 : M ≠ 0 := Nat.ne_of_gt (Nat.lt_of_lt_of_le (Nat.two_pow_pos _) hMlo)
  have hl := (Nat.le_log2 hM0).mpr hMlo
  have hh := (Nat.log2_lt hM0).mpr hMhi
  change M.log2 = N.log2 + 1
  omega

/-- Rounding x+RN(x) yields exactly twice RN(x) in numeric key, well below overflow. -/
theorem hypot_round64_add_rounded_nat (N : Nat) (hlo : 53 ≤ N.log2) (hhi : N.log2 < 1022) :
    let R := Fl.roundQuotient N (2 ^ (N.log2 - 52)) * 2 ^ (N.log2 - 52)
    (Fl.roundRat ((N + R : Nat) : Int) 1 false : hypot_BoundaryVal).key =
      2 * (Fl.roundRat (N : Int) 1 false : hypot_BoundaryVal).key := by
  let q := Fl.roundQuotient N (2 ^ (N.log2 - 52))
  let G := 2 ^ (N.log2 - 52)
  let M := N + q * G
  have hN0 : N ≠ 0 := by
    intro hz
    have hlog0 : N.log2 = 0 := by rw [hz]; rfl
    omega
  have hn : (N : Int) ≠ 0 := by omega
  have hlog : M.log2 = N.log2 + 1 := hypot_round_add_rounded_log N hlo
  have hm : (M : Int) ≠ 0 := by
    intro h
    have hM : M = 0 := by omega
    rw [hM] at hlog
    simp at hlog
  have hkN := FloatRoundDirections.roundRat_integer_key .f64 (N : Int) false hn
    (by rw [Int.natAbs_natCast]; change N.log2 + 1023 < 2047; omega)
    (by rw [Int.natAbs_natCast]; change 52 ≤ N.log2; omega)
  have hkM := FloatRoundDirections.roundRat_integer_key .f64 (M : Int) false hm
    (by rw [Int.natAbs_natCast]; change M.log2 + 1023 < 2047; omega)
    (by rw [Int.natAbs_natCast]; change 52 ≤ M.log2; omega)
  simp only [Int.natAbs_natCast, ite_eq_right (by omega : ¬ (N : Int) < 0)] at hkN
  simp only [Int.natAbs_natCast, ite_eq_right (by omega : ¬ (M : Int) < 0)] at hkM
  change (Fl.roundRat (N : Int) 1 false : hypot_BoundaryVal).key =
    ((q * G * JuliaLean.base.float.FTy.f64.fmt.den : Nat) : Int) at hkN
  change (Fl.roundRat (M : Int) 1 false : hypot_BoundaryVal).key =
    ((Fl.roundQuotient M (2 ^ (M.log2 - 52)) * 2 ^ (M.log2 - 52) *
      JuliaLean.base.float.FTy.f64.fmt.den : Nat) : Int) at hkM
  have hgrid : 2 ^ (M.log2 - 52) = 2 * G := by
    rw [hlog, show N.log2 + 1 - 52 = (N.log2 - 52) + 1 by omega, Nat.pow_succ]
    dsimp only [G]
    omega
  have hq := hypot_round_quotient_add_rounded N G (Nat.two_pow_pos _)
  change Fl.roundQuotient M (2 * G) = q at hq
  rw [hgrid, hq] at hkM
  change (Fl.roundRat (M : Int) 1 false : hypot_BoundaryVal).key =
    2 * (Fl.roundRat (N : Int) 1 false : hypot_BoundaryVal).key
  rw [hkM, hkN]
  simp only [Int.natCast_mul]
  ac_rfl

/-- The exact-integer interpretation of RN(x) gives the same doubling law. -/
theorem hypot_round64_add_rounded_integer (N R : Int) (hN : 0 ≤ N)
    (hlo : 53 ≤ N.natAbs.log2) (hhi : N.natAbs.log2 < 1022)
    (hR : (Fl.roundRat N 1 false : hypot_BoundaryVal).key =
      R * JuliaLean.base.float.FTy.f64.fmt.den) :
    (Fl.roundRat (N + R) 1 false : hypot_BoundaryVal).key =
      2 * (Fl.roundRat N 1 false : hypot_BoundaryVal).key := by
  have hNcast : N = (N.natAbs : Int) := by omega
  have hn : N ≠ 0 := by intro h; simp only [h, Int.natAbs_zero, Nat.log2_zero] at hlo; omega
  have hk := FloatRoundDirections.roundRat_integer_key .f64 N false hn
    (by change N.natAbs.log2 + 1023 < 2047; omega) (by change 52 ≤ N.natAbs.log2; omega)
  simp only [ite_eq_right (by omega : ¬ N < 0)] at hk
  have hReq : R = ((Fl.roundQuotient N.natAbs (2 ^ (N.natAbs.log2 - 52)) *
      2 ^ (N.natAbs.log2 - 52) : Nat) : Int) := by
    apply Int.eq_of_mul_eq_mul_right (by decide : (JuliaLean.base.float.FTy.f64.fmt.den : Int) ≠ 0)
    rw [← hR, hk]
    simp only [show JuliaLean.base.float.FTy.f64.fmt.sb = 52 from rfl, Int.natCast_mul]
  rw [hReq, hNcast]
  have h := hypot_round64_add_rounded_nat N.natAbs hlo hhi
  simpa only [Int.natCast_add, Int.natAbs_natCast] using h

