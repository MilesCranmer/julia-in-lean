    ac_rfl
  change -((2 ^ (j + k) * T.fmt.den : Nat) : Int) ≤ 2 * err ∧
    2 * err ≤ ((2 ^ (j + k) * T.fmt.den : Nat) : Int)
  rw [he] at hlo hhi
  constructor
  · simpa only [Int.neg_mul, ← Int.natCast_mul] using hlo
  · simpa only [← Int.natCast_mul] using hhi

