/-- The correction denominator is an exact finite doubling of the first
square-root result and is strictly positive. -/
theorem early_hypot_scaled_denominator (a b : FV .f64)
    (ha : a.isfinite = true) (hb : b.isfinite = true)
    (hsa : a.signbit = false) (hsb : b.signbit = false)
    (hba : b.key ≤ a.key)
    (hcutoff : fle b (mul a (Fl.ofBits 0x3e46a09e667f3bcd)) = false) :
