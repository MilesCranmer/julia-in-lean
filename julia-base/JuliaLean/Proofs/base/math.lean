  have hqinf : q < NextProofs.infMag .f64 := by unfold NextProofs.infMag; change q < 2047 * 2 ^ 52; omega
  have hqs : q < NextProofs.signMask .f64 := Nat.lt_trans hqinf (NextProofs.infMag_lt_signMask .f64)
  have hm := NextProofs.mag_encode .f64 s hqs
  rw [TruncProofs.isfinite_iff_mag, hm]
  exact ⟨hqinf, hq⟩

theorem hypot_round64_subnormal_bound (n : Int) (j : Nat) (z : Bool)
