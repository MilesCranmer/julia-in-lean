  have hδhiC : Amax.key ≤ 4 * D2.key := by decide
  have hδlo : -D2.key ≤ delta.key := by rw [hd.2]; omega
  have hδhi : delta.key ≤ D2.key := by rw [hd.2]; omega
  have hδabs := early_abs_of_interval delta.key D2.key hδlo hδhi
  have hδbox : early_box 512 delta := ⟨hd.1, Int.le_trans hδabs (by decide)⟩
