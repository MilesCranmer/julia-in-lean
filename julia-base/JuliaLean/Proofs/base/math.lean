/-- The first software numerator cancels to the square residual, leaving
only four explicitly identified rounding errors. -/
theorem early_software_first_error_identity (A B H S C T Z N D : Int) :
    N * D - (H * H - A * A - B * B) =
      (H - B) * (C - ((H - B) - 2 * S)) - 2 * (H - B) * (S - (A - B)) +
      A * (T - (2 * (H - B) - A)) + (Z * D - A * T) +
      (N * D - ((H - B) * C + Z * D)) := by
  have coef2 (u v : Int) : u * (v * 2) = 2 * (u * v) := by ac_rfl
  simp only [Int.sub_mul, Int.mul_sub, Int.mul_comm, Int.mul_left_comm]
  simp only [coef2]
  omega

/-- The second software numerator has the analogous compensated identity. -/
theorem early_software_second_error_identity (A B H S C Z I N D : Int) :
    N * D - (H * H - A * A - B * B) =
      B * (C - (4 * (H - A) - B)) + 2 * (H - A) * (S - (A - 2 * B)) +
      (Z * D - (2 * (H - A)) * S) + (I * D - (B * C + Z * D)) +
      (N * D - ((H - A) * (H - A) + I * D)) := by
  have coef2 (u v : Int) : u * (v * 2) = 2 * (u * v) := by ac_rfl
  have coef4 (u v : Int) : u * (v * 4) = 4 * (u * v) := by ac_rfl
  simp only [Int.sub_mul, Int.mul_sub, Int.mul_comm, Int.mul_left_comm, Int.mul_assoc]
  simp only [show (2 : Int) * 2 = 4 from rfl, coef2, coef4]
  omega

end JuliaLean.ChatGPT.Batch4.Group9


