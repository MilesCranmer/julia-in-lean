/-- The exact fused input stays below2^1024 throughout the balanced interval. -/
theorem generic_hypot_balanced_fused_cap (a b : FV .f64)
    (_ha : a.isfinite = true) (hb : b.isfinite = true)
    (hsa : a.signbit = false) (hsb : b.signbit = false)
    (haB : a.key ≤ (Fl.ofBits 0x5fe6a09e667f3bcc : FV .f64).key)
    (hbB : b.key ≤ (Fl.ofBits 0x5fe6a09e667f3bcc : FV .f64).key) :
    a.key * a.key + (mul b b).key * FTy.f64.fmt.den <
      ((2 ^ 1024 : Nat) : Int) * ((FTy.f64.fmt.den : Int) * FTy.f64.fmt.den) := by
  let B : FV .f64 := Fl.ofBits 0x5fe6a09e667f3bcc
  let U : FV .f64 := Fl.ofBits 0x7fdfffffffffffff
  let M : FV .f64 := Fl.floatmax
  obtain ⟨_, _, hUf, hUs, hUE, _, _, _, hBsq, hUM⟩ := early_hypot_bigroot_square_bound
  change B.key * B.key ≤ U.key * FTy.f64.fmt.den at hBsq
  change 2 * U.key = M.key at hUM
  have hasq := Int.le_trans (early_square_le_square a.key B.key ((mfKeySign a).2 hsa) haB) hBsq
  have hbsq := Int.le_trans (early_square_le_square b.key B.key ((mfKeySign b).2 hsb) hbB) hBsq
  have hz := early_square_upper_with_round U b hb hbsq (fun n j hn hk =>
    generic_round64_le_normal n j U hn hUf hUs hUE hk)
  have hb' := Int.mul_le_mul_of_nonneg_right hz.2.2 (Int.natCast_nonneg FTy.f64.fmt.den)
  have hup : a.key * a.key + (mul b b).key * FTy.f64.fmt.den ≤ M.key * FTy.f64.fmt.den := by
    calc
      _ ≤ U.key * FTy.f64.fmt.den + U.key * FTy.f64.fmt.den := Int.add_le_add hasq hb'
      _ = (2 * U.key) * FTy.f64.fmt.den := by rw [Int.mul_assoc]; omega
      _ = _ := by rw [hUM]
  exact Int.lt_of_le_of_lt hup (by decide)

