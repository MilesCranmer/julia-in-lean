section MathfuncsProofs

open JuliaLean.Proofs.base.float JuliaLean.C

/-! ## Rounding of exactly representable dyadic rationals -/

theorem mfPackRoundedEncode (T : FTy) (neg : Bool) (c Bp : Nat)
    (hc : 1 ≤ c) (hc2 : c < 2 ^ (T.fmt.sb + 1)) (hBp : 1 ≤ Bp) (hBp2 : Bp < T.fmt.emax) :
    (Fl.packRounded neg c ((Bp : Int) - T.fmt.bias - T.fmt.sb) : FV T) =
      NextProofs.encode T neg (if c < 2 ^ T.fmt.sb then c else Bp * 2 ^ T.fmt.sb + (c - 2 ^ T.fmt.sb)) := by
  have hq0 : (c == 0) = false := by simp; omega
  have hcar : ¬ c ≥ 2 ^ (T.fmt.sb + 1) := by omega
  have hexp : (Bp : Int) - T.fmt.bias - T.fmt.sb + T.fmt.bias + T.fmt.sb = (Bp : Int) := by omega
  have hne : ¬ (Bp : Int) ≥ (T.fmt.emax : Int) := by omega
  unfold Fl.packRounded NextProofs.encode NextProofs.signMask
  simp only [hq0, hcar, Bool.false_eq_true, ↓reduceIte, hexp, hne, Int.toNat_natCast]

theorem mfLog2Eq (c s : Nat) (h1 : 2 ^ s ≤ c) (h2 : c < 2 ^ (s + 1)) : c.log2 = s := by
  have hc : c ≠ 0 := by have := Nat.two_pow_pos s; omega
  apply Nat.le_antisymm
  · have := (Nat.log2_lt hc).2 h2
    omega
  · exact (Nat.le_log2 hc).2 h1

/-- Rounding an exactly representable nonzero dyadic value returns that value. -/
theorem mfRoundRatEncode (T : FTy) (n : Int) (j : Nat) (zs : Bool) (M : Nat)
    (hn : n ≠ 0) (hM0 : M ≠ 0) (hM : M < NextProofs.infMag T)
    (hkey : n.natAbs * T.fmt.den = magKey T.fmt M * 2 ^ j) :
    (Fl.roundRat n (2 ^ j) zs : FV T) = NextProofs.encode T (decide (n < 0)) M := by
  have hg := good_fty T
  have hbias := hg.bias_pos
  have hsb := hg.sb_pos
  have hemax := hg.emax_eq
  have hP := Nat.two_pow_pos T.fmt.sb
  have hdm := Nat.div_add_mod M (2 ^ T.fmt.sb)
  have hrm := Nat.mod_lt M hP
  have hBlt : M / 2 ^ T.fmt.sb < T.fmt.emax := by
    unfold NextProofs.infMag at hM
    exact Nat.div_lt_of_lt_mul (by rw [Nat.mul_comm]; exact hM)
  have ha0 : n.natAbs ≠ 0 := by omega
  unfold magKey at hkey
  unfold Fmt.den at hkey
  generalize hB : M / 2 ^ T.fmt.sb = B at hdm hBlt hkey
  generalize hr : M % 2 ^ T.fmt.sb = r at hdm hrm hkey
  generalize hA : n.natAbs = a at ha0 hkey
  have hd : (2 ^ j == 0) = false := by simp
  have hn0 : (n == 0) = false := by simp; omega
  have hloga : (a * 2 ^ (T.fmt.bias + T.fmt.sb - 1)).log2 = a.log2 + (T.fmt.bias + T.fmt.sb - 1) :=
    Fl.log2_mul_pow a _ ha0
  have hE : Fl.floorLog2Rat a (2 ^ j) = (a.log2 : Int) - j := Fl.floorLog2Rat_pow a j ha0
  unfold Fl.roundRat
  simp only [hd, hn0, Bool.false_eq_true, ↓reduceIte, hA, hE]
  by_cases hB0 : B = 0
  · subst hB0
    simp only [↓reduceIte, Nat.zero_sub, Nat.pow_zero, Nat.mul_one, Nat.add_zero] at hkey
    have hr0 : r ≠ 0 := by omega
    have hlogr : r.log2 < T.fmt.sb := (Nat.log2_lt hr0).2 hrm
    have hlog : a.log2 + (T.fmt.bias + T.fmt.sb - 1) = r.log2 + j := by
      rw [← hloga, hkey, Fl.log2_mul_pow r j hr0]
    have h1 : ¬ ((a.log2 : Int) - j ≥ (T.fmt.emax : Int) - T.fmt.bias) := by omega
    have h2 : ¬ ((a.log2 : Int) - j < -((T.fmt.bias : Int) + T.fmt.sb) - 1) := by omega
    have hk : max ((a.log2 : Int) - j - T.fmt.sb) (1 - (T.fmt.bias : Int) - T.fmt.sb) =
        ((1 : Nat) : Int) - T.fmt.bias - T.fmt.sb := by omega
    have hk0 : ¬ (((1 : Nat) : Int) - T.fmt.bias - T.fmt.sb ≥ 0) := by omega
    have hkn : (-(((1 : Nat) : Int) - T.fmt.bias - T.fmt.sb)).toNat = T.fmt.bias + T.fmt.sb - 1 := by
      omega
    simp only [h1, h2, ↓reduceIte, hk, hk0, hkn, hkey]
    rw [Fl.roundQuotient_exact _ _ (Nat.two_pow_pos j),
      mfPackRoundedEncode T _ r 1 (by omega) (by
        have : 2 ^ T.fmt.sb < 2 ^ (T.fmt.sb + 1) := Nat.pow_lt_pow_right (by decide) (by omega)
        omega) (Nat.le_refl 1) (by omega)]
    simp only [hrm, ↓reduceIte]
    congr 1
    omega
  · simp only [hB0, ↓reduceIte] at hkey
    have hc1 : 2 ^ T.fmt.sb ≤ r + 2 ^ T.fmt.sb := by omega
    have hc2 : r + 2 ^ T.fmt.sb < 2 ^ (T.fmt.sb + 1) := by rw [Nat.pow_succ]; omega
    have hc0 : r + 2 ^ T.fmt.sb ≠ 0 := by omega
    have hlogc : (r + 2 ^ T.fmt.sb).log2 = T.fmt.sb := mfLog2Eq _ _ hc1 hc2
    have hlog : a.log2 + (T.fmt.bias + T.fmt.sb - 1) = T.fmt.sb + (B - 1) + j := by
      rw [← hloga, hkey, Nat.mul_assoc, ← Nat.pow_add, Fl.log2_mul_pow _ _ hc0, hlogc]
      omega
    have h1 : ¬ ((a.log2 : Int) - j ≥ (T.fmt.emax : Int) - T.fmt.bias) := by omega
    have h2 : ¬ ((a.log2 : Int) - j < -((T.fmt.bias : Int) + T.fmt.sb) - 1) := by omega
    have hk : max ((a.log2 : Int) - j - T.fmt.sb) (1 - (T.fmt.bias : Int) - T.fmt.sb) =
        (B : Int) - T.fmt.bias - T.fmt.sb := by omega
    simp only [h1, h2, ↓reduceIte, hk]
    have hq : Fl.roundQuotient
        (if (B : Int) - T.fmt.bias - T.fmt.sb ≥ 0 then
            (a, 2 ^ j * 2 ^ ((B : Int) - T.fmt.bias - T.fmt.sb).toNat)
          else (a * 2 ^ (-((B : Int) - T.fmt.bias - T.fmt.sb)).toNat, 2 ^ j)).1
        (if (B : Int) - T.fmt.bias - T.fmt.sb ≥ 0 then
            (a, 2 ^ j * 2 ^ ((B : Int) - T.fmt.bias - T.fmt.sb).toNat)
          else (a * 2 ^ (-((B : Int) - T.fmt.bias - T.fmt.sb)).toNat, 2 ^ j)).2 =
        r + 2 ^ T.fmt.sb := by
      by_cases hk0 : (B : Int) - T.fmt.bias - T.fmt.sb ≥ 0
      · simp only [hk0, ↓reduceIte]
        have ht : ((B : Int) - T.fmt.bias - T.fmt.sb).toNat = B - T.fmt.bias - T.fmt.sb := by omega
        rw [ht, ← Nat.pow_add]
        have hcan : a = (r + 2 ^ T.fmt.sb) * 2 ^ (j + (B - T.fmt.bias - T.fmt.sb)) := by
          apply Nat.eq_of_mul_eq_mul_right (Nat.two_pow_pos (T.fmt.bias + T.fmt.sb - 1))
          rw [hkey, Nat.mul_assoc, Nat.mul_assoc, ← Nat.pow_add, ← Nat.pow_add]
          congr 2
          omega
        rw [hcan, Fl.roundQuotient_exact _ _ (Nat.two_pow_pos _)]
      · simp only [hk0, ↓reduceIte]
        have ht : (-((B : Int) - T.fmt.bias - T.fmt.sb)).toNat = T.fmt.bias + T.fmt.sb - B := by omega
        rw [ht]
        have hcan : a * 2 ^ (T.fmt.bias + T.fmt.sb - B) = (r + 2 ^ T.fmt.sb) * 2 ^ j := by
          apply Nat.eq_of_mul_eq_mul_right (Nat.two_pow_pos (B - 1))
          rw [Nat.mul_assoc, ← Nat.pow_add, Nat.mul_assoc (r + 2 ^ T.fmt.sb), ← Nat.pow_add,
            show T.fmt.bias + T.fmt.sb - B + (B - 1) = T.fmt.bias + T.fmt.sb - 1 by omega, hkey,
            Nat.mul_assoc, ← Nat.pow_add, Nat.add_comm (B - 1) j]
        rw [hcan, Fl.roundQuotient_exact _ _ (Nat.two_pow_pos _)]
    rw [hq, mfPackRoundedEncode T _ _ B (by omega) hc2 (by omega) hBlt]
    have hnot : ¬ r + 2 ^ T.fmt.sb < 2 ^ T.fmt.sb := by omega
    simp only [hnot, ↓reduceIte]
    congr 1
    rw [Nat.add_sub_cancel, Nat.mul_comm, hdm]


/-! ## Sign of a rounded dyadic rational -/

theorem mfEncodeZero (T : FTy) (s : Bool) : (Fl.zero s : FV T) = NextProofs.encode T s 0 := by
  unfold Fl.zero NextProofs.encode NextProofs.signMask
  simp only [Nat.add_zero]

theorem mfPackTailSign (T : FTy) (neg : Bool) (m : Nat) (p : Int)
    (hm : m < 2 ^ (T.fmt.sb + 1)) :
    (if p + (T.fmt.bias : Int) + (T.fmt.sb : Int) ≥ (T.fmt.emax : Int) then (Fl.inf neg : FV T)
      else Fl.ofBits ((if neg = true then 2 ^ (T.fmt.eb + T.fmt.sb) else 0) +
        (if m < 2 ^ T.fmt.sb then m
         else (p + (T.fmt.bias : Int) + (T.fmt.sb : Int)).toNat * 2 ^ T.fmt.sb + (m - 2 ^ T.fmt.sb)))).signbit
      = neg := by
  have hcap := NextProofs.infMag_lt_signMask T
  have hemax := (good_fty T).emax_eq
  have hp1 : 2 ^ (T.fmt.sb + 1) = 2 * 2 ^ T.fmt.sb := by
    rw [Nat.pow_succ, Nat.mul_comm]
  split
  · rw [← EpsilonNeighborProofs.encode_infinity]
    exact NextProofs.sign_encode T neg hcap
  · rename_i hexp
    have hmag : (if m < 2 ^ T.fmt.sb then m
        else (p + T.fmt.bias + T.fmt.sb).toNat * 2 ^ T.fmt.sb + (m - 2 ^ T.fmt.sb)) <
        NextProofs.signMask T := by
      split
      · have : 2 ^ T.fmt.sb ≤ NextProofs.infMag T := by
          unfold NextProofs.infMag
          have := (good_fty T).emax_eq
          have := (good_fty T).bias_pos
          exact Nat.le_mul_of_pos_left _ (by omega)
        omega
      · have hle : (p + T.fmt.bias + T.fmt.sb).toNat + 1 ≤ T.fmt.emax := by omega
        have := Nat.mul_le_mul_right (2 ^ T.fmt.sb) hle
        rw [Nat.succ_mul] at this
        unfold NextProofs.infMag at hcap
        omega
    have := NextProofs.sign_encode T neg hmag
    unfold NextProofs.encode NextProofs.signMask at this
    exact this

theorem mfPackRoundedSign (T : FTy) (neg : Bool) (q : Nat) (k : Int)
    (hq : q < 2 ^ (T.fmt.sb + 2)) :
    (Fl.packRounded neg q k : FV T).signbit = neg := by
  have hp2 : 2 ^ (T.fmt.sb + 2) = 2 * 2 ^ (T.fmt.sb + 1) := by
    rw [Nat.pow_succ, Nat.mul_comm]
  unfold Fl.packRounded
  by_cases hq0 : q = 0
  · subst hq0
    simp only [beq_self_eq_true, ↓reduceIte]
    rw [mfEncodeZero]
    exact NextProofs.sign_encode T neg (by unfold NextProofs.signMask; exact Nat.two_pow_pos _)
  · have h0 : (q == 0) = false := by simp [hq0]
    simp only [h0, Bool.false_eq_true, ↓reduceIte]
    by_cases hc : q ≥ 2 ^ (T.fmt.sb + 1)
    · simp only [hc, ↓reduceIte]
      exact mfPackTailSign T neg (q / 2) (k + 1) (by omega)
    · simp only [hc, ↓reduceIte]
      exact mfPackTailSign T neg q k (by omega)

theorem mfRoundRatSignbit (T : FTy) (n : Int) (j : Nat) (zs : Bool) (hn : n ≠ 0) :
    (Fl.roundRat n (2 ^ j) zs : FV T).signbit = decide (n < 0) := by
  have hcap := NextProofs.infMag_lt_signMask T
  have ha0 : n.natAbs ≠ 0 := by omega
  have hd : (2 ^ j == 0) = false := by simp
  have hn0 : (n == 0) = false := by simp; omega
  have hE : Fl.floorLog2Rat n.natAbs (2 ^ j) = (n.natAbs.log2 : Int) - j :=
    Fl.floorLog2Rat_pow _ j ha0
  have hlt := @Nat.lt_log2_self n.natAbs
  unfold Fl.roundRat
  simp only [hd, hn0, Bool.false_eq_true, ↓reduceIte, hE]
  generalize n.natAbs = a at ha0 hlt
  generalize decide (n < 0) = neg
  split
  · rw [← EpsilonNeighborProofs.encode_infinity]
    exact NextProofs.sign_encode T neg hcap
  split
  · rw [mfEncodeZero]
    exact NextProofs.sign_encode T neg (by unfold NextProofs.signMask; exact Nat.two_pow_pos _)
  apply mfPackRoundedSign
  have hkge : (a.log2 : Int) - j - T.fmt.sb ≤
      max ((a.log2 : Int) - j - T.fmt.sb) (1 - (T.fmt.bias : Int) - T.fmt.sb) := Int.le_max_left _ _
  generalize max ((a.log2 : Int) - j - T.fmt.sb) (1 - (T.fmt.bias : Int) - T.fmt.sb) = k at hkge
  have hpow : 2 ^ (T.fmt.sb + 2) = 2 * 2 ^ (T.fmt.sb + 1) := by rw [Nat.pow_succ, Nat.mul_comm]
  have hsb1 := Nat.two_pow_pos (T.fmt.sb + 1)
  split
  · rename_i hk
    have hG := Nat.mul_pos (Nat.two_pow_pos j) (Nat.two_pow_pos k.toNat)
    have hb := (roundQuotient_floor_bounds a (2 ^ j * 2 ^ k.toNat)).2.1
    have hdiv : a / (2 ^ j * 2 ^ k.toNat) < 2 ^ (T.fmt.sb + 1) := by
      apply (Nat.div_lt_iff_lt_mul hG).2
      calc a < 2 ^ (a.log2 + 1) := hlt
        _ ≤ 2 ^ (T.fmt.sb + 1 + (j + k.toNat)) := Nat.pow_le_pow_right (by decide) (by omega)
        _ = 2 ^ (T.fmt.sb + 1) * (2 ^ j * 2 ^ k.toNat) := by rw [Nat.pow_add 2 (T.fmt.sb + 1), Nat.pow_add 2 j]
    dsimp only
    omega
  · rename_i hk
    have hb := (roundQuotient_floor_bounds (a * 2 ^ (-k).toNat) (2 ^ j)).2.1
    have hdiv : a * 2 ^ (-k).toNat / 2 ^ j < 2 ^ (T.fmt.sb + 1) := by
      apply (Nat.div_lt_iff_lt_mul (Nat.two_pow_pos j)).2
      calc a * 2 ^ (-k).toNat < 2 ^ (a.log2 + 1) * 2 ^ (-k).toNat :=
            (Nat.mul_lt_mul_right (Nat.two_pow_pos _)).2 hlt
        _ = 2 ^ (a.log2 + 1 + (-k).toNat) := by rw [Nat.pow_add 2 (a.log2 + 1)]
        _ ≤ 2 ^ (T.fmt.sb + 1 + j) := Nat.pow_le_pow_right (by decide) (by omega)
        _ = 2 ^ (T.fmt.sb + 1) * 2 ^ j := by rw [Nat.pow_add 2 (T.fmt.sb + 1)]
    dsimp only
    omega

/-! ## Exact float operations -/

theorem mfToRatPow2 {T : FTy} (x : FV T) (hx : x.isfinite = true) :
    ∃ jx : Nat, x.toRat.2 = 2 ^ jx := by
  obtain ⟨m, i, jx, hr, -, -, -⟩ := Fl.toRat_cases (good_fty T) x hx
  exact ⟨jx, congrArg Prod.snd hr⟩

theorem mfSignedMagKeyNatAbs (s : Bool) (K : Nat) (D : Int) (N : Int)
    (h : N = (if s then -(K : Int) else (K : Int)) * D) :
    N.natAbs = K * D.natAbs := by
  subst h
  cases s <;> simp [Int.natAbs_mul]

/-- Exact multiplication: when the exact product is the finite nonzero value with magnitude `M`. -/
theorem mfMulEncode {T : FTy} (x y : FV T) (hx : x.isfinite = true) (hy : y.isfinite = true)
    (s : Bool) (M : Nat) (hM0 : M ≠ 0) (hM : M < NextProofs.infMag T)
    (hkey : x.key * y.key =
      (if s then -((magKey T.fmt M : Nat) : Int) else ((magKey T.fmt M : Nat) : Int)) * T.fmt.den) :
    mul_float x y = NextProofs.encode T s M := by
  obtain ⟨jx, hjx⟩ := mfToRatPow2 x hx
  obtain ⟨jy, hjy⟩ := mfToRatPow2 y hy
  have hkx := (Fl.toRat_key (good_fty T) x hx).2
  have hky := (Fl.toRat_key (good_fty T) y hy).2
  have hden : (0 : Int) < T.fmt.den := by exact_mod_cast T.fmt.den_pos
  have hK : 0 < magKey T.fmt M := (magKey_cases T.fmt M).resolve_left (by omega) |>.2
  unfold mul_float jlMulFloat floatMul
  rw [finishFloat_eq]
  simp only [Fl.isnan_of_finite hx, Fl.isnan_of_finite hy, Fl.isinf_of_finite hx,
    Fl.isinf_of_finite hy, Bool.false_eq_true, ↓reduceIte, Bool.false_or, Bool.and_false,
    Bool.false_and, Bool.or_self]
  rw [hjx, hjy, ← Nat.pow_add]
  have hN : x.toRat.1 * y.toRat.1 * (T.fmt.den : Int) =
      (if s then -((magKey T.fmt M : Nat) : Int) else ((magKey T.fmt M : Nat) : Int)) *
        ((2 ^ (jx + jy) : Nat) : Int) := by
    apply Int.eq_of_mul_eq_mul_right (Int.ne_of_gt hden)
    calc x.toRat.1 * y.toRat.1 * (T.fmt.den : Int) * (T.fmt.den : Int)
        = (x.toRat.1 * T.fmt.den) * (y.toRat.1 * T.fmt.den) := by
          simp only [Int.mul_assoc, Int.mul_left_comm]
      _ = (x.key * x.toRat.2) * (y.key * y.toRat.2) := by rw [hkx, hky]
      _ = (x.key * y.key) * ((x.toRat.2 * y.toRat.2 : Nat) : Int) := by
          simp only [Int.natCast_mul, Int.mul_assoc, Int.mul_left_comm]
      _ = _ := by
          rw [hkey, hjx, hjy, ← Nat.pow_add]
          simp only [Int.mul_assoc, Int.mul_left_comm, Int.mul_comm]
  have hNz : x.toRat.1 * y.toRat.1 ≠ 0 := by
    intro hz
    rw [hz, Int.zero_mul] at hN
    have h2 : (0 : Int) < ((2 ^ (jx + jy) : Nat) : Int) := by exact_mod_cast Nat.two_pow_pos _
    cases s <;> simp only [Bool.false_eq_true, ↓reduceIte] at hN
    · have := Int.mul_pos (by exact_mod_cast hK : (0 : Int) < (magKey T.fmt M : Int)) h2; omega
    · have := Int.mul_pos (by exact_mod_cast hK : (0 : Int) < (magKey T.fmt M : Int)) h2
      rw [Int.neg_mul] at hN; omega
  have habs : (x.toRat.1 * y.toRat.1).natAbs * T.fmt.den = magKey T.fmt M * 2 ^ (jx + jy) := by
    have := congrArg Int.natAbs hN
    rw [Int.natAbs_mul, Int.natAbs_natCast] at this
    rw [this]
    cases s <;> simp [Int.natAbs_mul]
  have hsgn : decide (x.toRat.1 * y.toRat.1 < 0) = s := by
    have h2 : (0 : Int) < ((2 ^ (jx + jy) : Nat) : Int) := by exact_mod_cast Nat.two_pow_pos _
    have hKi : (0 : Int) < (magKey T.fmt M : Int) := by exact_mod_cast hK
    cases s <;> simp only [Bool.false_eq_true, ↓reduceIte] at hN
    · have hp := Int.mul_pos hKi h2
      apply decide_eq_false
      intro hlt
      have := Int.mul_neg_of_neg_of_pos hlt hden
      omega
    · have hp := Int.mul_pos hKi h2
      rw [Int.neg_mul] at hN
      apply decide_eq_true
      apply Classical.byContradiction
      intro hge
      have hge' : 0 ≤ x.toRat.1 * y.toRat.1 := by omega
      have := Int.mul_nonneg hge' (Int.le_of_lt hden)
      omega
  rw [mfRoundRatEncode T _ _ _ M hNz hM0 hM habs, hsgn]


/-! ## mathfuncs-minmax-isless -/

theorem mfNegClass {T : FTy} (y : FV T) :
    (Fl.neg y).isnan = y.isnan ∧ (Fl.neg y).isinf = y.isinf ∧ (Fl.neg y).signbit = !y.signbit := by
  obtain ⟨hm, hs⟩ := fl_neg_parts y
  have he : (Fl.neg y).expField = y.expField := by rw [Fl.expField_eq, hm, ← Fl.expField_eq]
  have hf : (Fl.neg y).frac = y.frac := by rw [Fl.frac_eq, hm, ← Fl.frac_eq]
  exact ⟨by simp only [Fl.isnan, he, hf], by simp only [Fl.isinf, he, hf], hs⟩

theorem mfIslessKey {T : FTy} (x y : FV T) (hx : x.isnan = false) (hy : y.isnan = false) :
    Fl.isless x y = (decide (x.key < y.key) || (x.signbit && !y.signbit)) := by
  have hxbits := (Fl.bits_split x).1
  have hybits := (Fl.bits_split y).1
  have hl : Fl.isless x y = (Fl.lt x y || (x.signbit && !y.signbit)) := by
    cases hsx : x.signbit <;> cases hsy : y.signbit <;>
      by_cases hxz : x.magnitude = 0 <;> by_cases hyz : y.magnitude = 0 <;>
      simp [Fl.isless, Fl.lt, Fl.iszero, hx, hy, hsx, hsy, hxz, hyz, hxbits, hybits] <;> omega
  rw [hl, Fl.lt_key hx hy]

theorem mfKeySign {T : FTy} (x : FV T) :
    (x.signbit = true → x.key ≤ 0) ∧ (x.signbit = false → 0 ≤ x.key) := by
  unfold Fl.key
  constructor <;> intro h <;> simp only [h, ↓reduceIte, Bool.false_eq_true] <;> omega

theorem mfInfOfNotFinite {T : FTy} (x : FV T) (hx : x.isnan = false) (hf : x.isfinite = false) :
    x.isinf = true := by
  simp only [Fl.isfinite, Fl.isnan, Fl.isinf, bne_eq_false_iff_eq, Bool.and_eq_false_imp,
    beq_iff_eq, Bool.and_eq_true] at hx hf ⊢
  refine ⟨hf, ?_⟩
  have := hx hf
  simpa using this

theorem mfKeyBound {T : FTy} (x : FV T) (hx : x.isnan = false) :
    -(((2 ^ T.fmt.sb * 2 ^ (T.fmt.emax - 1) : Nat) : Int)) ≤ x.key ∧
    x.key ≤ ((2 ^ T.fmt.sb * 2 ^ (T.fmt.emax - 1) : Nat) : Int) := by
  cases hf : x.isfinite
  · rw [Fl.inf_key_eq (good_fty T) x (mfInfOfNotFinite x hx hf)]
    split <;> omega
  · have := Fl.finite_key_lt_inf (good_fty T) x hf
    omega

theorem mfInfEq {T : FTy} (x y : FV T) (hx : x.isinf = true) (hy : y.isinf = true)
    (hs : x.signbit = y.signbit) : x = y := by
  apply Fl.ext_toBits
  have hmx := (TruncProofs.mag_decomp x).1
  have hmy := (TruncProofs.mag_decomp y).1
  simp only [Fl.isinf, Bool.and_eq_true, beq_iff_eq] at hx hy
  rw [(Fl.bits_split x).1, (Fl.bits_split y).1, hs, hmx, hmy, hx.1, hx.2, hy.1, hy.2]

theorem mfFloatSubFinite {T : FTy} (x y : FV T) (hx : x.isfinite = true) (hy : y.isfinite = true) :
    floatSub x y = Fl.roundRat
      (x.toRat.1 * (y.toRat.2 : Int) - y.toRat.1 * (x.toRat.2 : Int))
      (x.toRat.2 * y.toRat.2) (x.signbit && !y.signbit) := by
  rw [← EpsilonProofs.sub_finite_rational x y hx hy]
  unfold sub_IEEEFloat sub_float jlSubFloat
  rw [finishFloat_eq]

theorem mfZeroSignbit (T : FTy) (s : Bool) : (Fl.zero s : FV T).signbit = s := by
  rw [mfEncodeZero]
  exact NextProofs.sign_encode T s (by unfold NextProofs.signMask; exact Nat.two_pow_pos _)

theorem mfSubSignOrEq {T : FTy} (x y : FV T) (hx : x.isnan = false) (hy : y.isnan = false) :
    (floatSub x y).signbit = Fl.isless x y ∨ x = y := by
  obtain ⟨hyn, hyi, hys⟩ := mfNegClass y
  have hless := mfIslessKey x y hx hy
  have hKx := mfKeyBound x hx
  have hKy := mfKeyBound y hy
  have hsx := mfKeySign x
  have hsy := mfKeySign y
  have hg := good_fty T
  cases hfx : x.isfinite
  · have hix := mfInfOfNotFinite x hx hfx
    have hkx := Fl.inf_key_eq hg x hix
    by_cases hc : y.isinf = true ∧ x.signbit = y.signbit
    · exact Or.inr (mfInfEq x y hix hc.1 hc.2)
    · left
      have hsel : (y.neg.isinf && x.signbit != y.neg.signbit) = false := by
        rw [hyi, hys]
        cases hyy : y.isinf <;> cases hsx' : x.signbit <;> cases hsy' : y.signbit <;>
          simp_all
      unfold floatSub floatAdd
      simp only [hx, hy, hyn, hix, hsel, Bool.false_eq_true, ↓reduceIte]
      rw [hless]
      cases hsxb : x.signbit
      · simp only [hsxb, ↓reduceIte, Bool.false_eq_true] at hkx
        simp only [Bool.false_and, Bool.or_false]
        apply (decide_eq_false _).symm
        omega
      · simp only [hsxb, ↓reduceIte] at hkx
        cases hsyb : y.signbit
        · simp
        · simp only [Bool.not_true, Bool.and_false, Bool.or_false]
          apply (decide_eq_true _).symm
          cases hfy : y.isfinite
          · have hiy := mfInfOfNotFinite y hy hfy
            exact absurd ⟨hiy, by rw [hsxb, hsyb]⟩ hc
          · have := Fl.finite_key_lt_inf hg y hfy
            omega
  · cases hfy : y.isfinite
    · left
      have hiy := mfInfOfNotFinite y hy hfy
      have hky := Fl.inf_key_eq hg y hiy
      have hkxb := Fl.finite_key_lt_inf hg x hfx
      unfold floatSub floatAdd
      simp only [hx, hy, hyn, hyi, hiy, Fl.isinf_of_finite hfx, Bool.false_eq_true, ↓reduceIte]
      rw [hys, hless]
      cases hsyb : y.signbit
      · simp only [hsyb, ↓reduceIte, Bool.false_eq_true] at hky
        simp only [Bool.not_false, Bool.and_true]
        have : decide (x.key < y.key) = true := decide_eq_true (by omega)
        simp [this]
      · simp only [hsyb, ↓reduceIte] at hky
        simp only [Bool.not_true, Bool.and_false, Bool.or_false]
        exact (decide_eq_false (by omega)).symm
    · left
      rw [mfFloatSubFinite x y hfx hfy]
      obtain ⟨jx, hjx⟩ := mfToRatPow2 x hfx
      obtain ⟨jy, hjy⟩ := mfToRatPow2 y hfy
      have hkx := (Fl.toRat_key hg x hfx).2
      have hky := (Fl.toRat_key hg y hfy).2
      have hden : (0 : Int) < T.fmt.den := by exact_mod_cast T.fmt.den_pos
      have hdx : (0 : Int) < (x.toRat.2 : Int) := by rw [hjx]; exact_mod_cast Nat.two_pow_pos _
      have hdy : (0 : Int) < (y.toRat.2 : Int) := by rw [hjy]; exact_mod_cast Nat.two_pow_pos _
      have hdxy : (0 : Int) < (x.toRat.2 : Int) * (y.toRat.2 : Int) := Int.mul_pos hdx hdy
      have hscale : (x.toRat.1 * (y.toRat.2 : Int) - y.toRat.1 * (x.toRat.2 : Int)) * (T.fmt.den : Int) =
          (x.key - y.key) * ((x.toRat.2 : Int) * (y.toRat.2 : Int)) := by
        calc (x.toRat.1 * (y.toRat.2 : Int) - y.toRat.1 * (x.toRat.2 : Int)) * (T.fmt.den : Int)
            = (x.toRat.1 * T.fmt.den) * (y.toRat.2 : Int) - (y.toRat.1 * T.fmt.den) * (x.toRat.2 : Int) := by
              simp only [Int.sub_mul, Int.mul_right_comm]
          _ = (x.key * x.toRat.2) * (y.toRat.2 : Int) - (y.key * y.toRat.2) * (x.toRat.2 : Int) := by
              rw [hkx, hky]
          _ = (x.key - y.key) * ((x.toRat.2 : Int) * (y.toRat.2 : Int)) := by
              simp only [Int.sub_mul, Int.mul_assoc, Int.mul_comm (y.toRat.2 : Int) (x.toRat.2 : Int)]
      generalize hN : x.toRat.1 * (y.toRat.2 : Int) - y.toRat.1 * (x.toRat.2 : Int) = N at hscale
      rw [hjx, hjy, ← Nat.pow_add]
      generalize hD : (x.toRat.2 : Int) * (y.toRat.2 : Int) = D at hscale hdxy
      by_cases hN0 : N = 0
      · subst hN0
        have hk : x.key = y.key := by
          rw [Int.zero_mul] at hscale
          have := (Int.mul_eq_zero.1 hscale.symm).resolve_right (by omega)
          omega
        have hz : (Fl.roundRat 0 (2 ^ (jx + jy)) (x.signbit && !y.signbit) : FV T) =
            Fl.zero (x.signbit && !y.signbit) := by
          unfold Fl.roundRat
          simp
        rw [hz, mfZeroSignbit, hless, hk]
        simp
      · rw [mfRoundRatSignbit T N (jx + jy) _ hN0, hless]
        have hiff : N < 0 ↔ x.key < y.key := by
          constructor
          · intro h
            have h1 : N * (T.fmt.den : Int) < 0 := Int.mul_neg_of_neg_of_pos h hden
            rw [hscale] at h1
            apply Classical.byContradiction
            intro hge
            have := Int.mul_nonneg (show 0 ≤ x.key - y.key by omega) (Int.le_of_lt hdxy)
            omega
          · intro h
            have h1 : (x.key - y.key) * D < 0 := Int.mul_neg_of_neg_of_pos (by omega) hdxy
            rw [← hscale] at h1
            apply Classical.byContradiction
            intro hge
            have := Int.mul_nonneg (show 0 ≤ N by omega) (Int.le_of_lt hden)
            omega
        have hne : x.key ≠ y.key := by
          intro he
          rw [he, Int.sub_self, Int.zero_mul] at hscale
          have := (Int.mul_eq_zero.1 hscale).resolve_right (by omega)
          exact hN0 this
        cases hsxb : x.signbit <;> cases hsyb : y.signbit <;>
          simp only [Bool.false_and, Bool.true_and, Bool.not_false, Bool.not_true, Bool.or_false,
            Bool.or_true]
        · exact decide_eq_decide.mpr hiff
        · exact decide_eq_decide.mpr hiff
        · have h1 := hsx.1 hsxb
          have h2 := hsy.2 hsyb
          exact decide_eq_true (hiff.2 (by omega))
        · exact decide_eq_decide.mpr hiff

theorem minmaxIsless_proven : MinmaxIsless := by
  intro T o x y hfaith hxn hyn
  rcases hfaith with ⟨_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, hmin, hmax⟩
  have hx : x.isnan = false := by simpa [fisnan, isnan_callee_eq] using hxn
  have hy : y.isnan = false := by simpa [fisnan, isnan_callee_eq] using hyn
  have hsel := mfSubSignOrEq x y hx hy
  constructor
  · rw [minIEEE, hmin]
    unfold jlMinFloat
    rw [finishFloat_eq]
    simp only [hx, hy, Bool.or_false, Bool.false_eq_true, ↓reduceIte]
    rcases hsel with h | h
    · rw [h]
    · subst h
      simp
  · rw [maxIEEE, hmax]
    unfold jlMaxFloat
    rw [finishFloat_eq]
    simp only [hx, hy, Bool.or_false, Bool.false_eq_true, ↓reduceIte]
    rcases hsel with h | h
    · rw [h]
    · subst h
      simp


/-! ## Bit-level helpers for `ldexp`, `frexp`, `significand` and `exponent` -/

theorem mfFmtBounds (T : FTy) :
    T.fmt.bias ≤ 1023 ∧ T.fmt.sb ≤ 52 ∧ T.fmt.eb ≤ 11 ∧ T.fmt.sb + 2 ≤ T.fmt.bias := by
  cases T <;> decide

theorem mfWithoutBitsEq (v m w : Nat) : withoutBits v m w = Nat.land v (2 ^ w - 1 - m) := rfl

theorem mfExpMaskComplement (T : FTy) :
    2 ^ T.fmt.width - 1 - exponentMask T = 2 ^ (T.fmt.eb + T.fmt.sb) + (2 ^ T.fmt.sb - 1) := by
  cases T <;> decide

theorem mfLandSignFrac (T : FTy) (v : Nat) (hv : v < 2 ^ T.fmt.width) :
    Nat.land v (2 ^ (T.fmt.eb + T.fmt.sb) + (2 ^ T.fmt.sb - 1)) =
      (if v ≥ 2 ^ (T.fmt.eb + T.fmt.sb) then 2 ^ (T.fmt.eb + T.fmt.sb) else 0) + v % 2 ^ T.fmt.sb := by
  have hw := Fmt.width_pow T.fmt
  have hP := Nat.two_pow_pos T.fmt.sb
  have hsbS : 2 ^ T.fmt.sb ≤ 2 ^ (T.fmt.eb + T.fmt.sb) := Nat.pow_le_pow_right (by decide) (by omega)
  have hm : 2 ^ T.fmt.sb - 1 < 2 ^ (T.fmt.eb + T.fmt.sb) := by omega
  have hmask : 2 ^ (T.fmt.eb + T.fmt.sb) + (2 ^ T.fmt.sb - 1) =
      (2 ^ T.fmt.sb - 1) ||| 1 * 2 ^ (T.fmt.eb + T.fmt.sb) := by
    rw [nat_or_mul_pow _ _ _ hm]; omega
  have hr : v % 2 ^ T.fmt.sb < 2 ^ (T.fmt.eb + T.fmt.sb) := by
    have := Nat.mod_lt v hP; omega
  have hrhs : (if v ≥ 2 ^ (T.fmt.eb + T.fmt.sb) then 2 ^ (T.fmt.eb + T.fmt.sb) else 0) +
      v % 2 ^ T.fmt.sb =
      v % 2 ^ T.fmt.sb ||| (if v ≥ 2 ^ (T.fmt.eb + T.fmt.sb) then 1 else 0) *
        2 ^ (T.fmt.eb + T.fmt.sb) := by
    rw [nat_or_mul_pow _ _ _ hr]; split <;> omega
  rw [hmask, hrhs]
  apply Nat.eq_of_testBit_eq
  intro i
  show (v &&& ((2 ^ T.fmt.sb - 1) ||| 1 * 2 ^ (T.fmt.eb + T.fmt.sb))).testBit i = _
  rw [Nat.testBit_and, Nat.testBit_or, Nat.testBit_or, Nat.testBit_two_pow_sub_one,
    Nat.one_mul, Nat.testBit_two_pow, Nat.testBit_mod_two_pow]
  by_cases hi : i < T.fmt.sb
  · have hne : ¬ (T.fmt.eb + T.fmt.sb = i) := by omega
    have h2 : ((if v ≥ 2 ^ (T.fmt.eb + T.fmt.sb) then 1 else 0) * 2 ^ (T.fmt.eb + T.fmt.sb)).testBit i
        = false := by
      split
      · rw [Nat.one_mul, Nat.testBit_two_pow]; simp [hne]
      · simp
    simp [hi, hne, h2]
  · by_cases hk : i = T.fmt.eb + T.fmt.sb
    · subst hk
      have hsb : ¬ (T.fmt.eb + T.fmt.sb < T.fmt.sb) := by
        have := (good_fty T).emax_succ
        have : 1 ≤ T.fmt.eb := by
          rcases Nat.eq_zero_or_pos T.fmt.eb with h0 | h0
          · rw [h0] at this; simp at this; have := (good_fty T).emax_eq; have := (good_fty T).bias_pos; omega
          · omega
        omega
      have hbit : v.testBit (T.fmt.eb + T.fmt.sb) = decide (v ≥ 2 ^ (T.fmt.eb + T.fmt.sb)) := by
        rw [Nat.testBit_eq_decide_div_mod_eq]
        have hd : v / 2 ^ (T.fmt.eb + T.fmt.sb) < 2 := Nat.div_lt_of_lt_mul (by omega)
        by_cases hv' : v ≥ 2 ^ (T.fmt.eb + T.fmt.sb)
        · have : 1 ≤ v / 2 ^ (T.fmt.eb + T.fmt.sb) :=
            (Nat.le_div_iff_mul_le (Nat.two_pow_pos _)).2 (by omega)
          simp [hv']; omega
        · have : v / 2 ^ (T.fmt.eb + T.fmt.sb) = 0 := Nat.div_eq_of_lt (by omega)
          simp [hv', this]
      rw [hbit]
      split
      · rename_i hv'
        simp [hv', hsb, Nat.testBit_two_pow]
      · rename_i hv'
        simp [hv', hsb]
    · have h2 : ((if v ≥ 2 ^ (T.fmt.eb + T.fmt.sb) then 1 else 0) * 2 ^ (T.fmt.eb + T.fmt.sb)).testBit i
          = false := by
        split
        · rw [Nat.one_mul, Nat.testBit_two_pow]; simp; omega
        · simp
      have hne : ¬ (T.fmt.eb + T.fmt.sb = i) := by omega
      simp [hi, hne, h2]

theorem mfClearExp {T : FTy} (x : FV T) :
    withoutBits x.toBits (exponentMask T) T.fmt.width =
      (if x.signbit then 2 ^ (T.fmt.eb + T.fmt.sb) else 0) + x.frac := by
  have hlt : x.toBits < 2 ^ T.fmt.width := x.bits.isLt
  rw [mfWithoutBitsEq, mfExpMaskComplement, mfLandSignFrac T _ hlt]
  have hs : decide (x.toBits ≥ 2 ^ (T.fmt.eb + T.fmt.sb)) = x.signbit := rfl
  congr 1
  · by_cases h : x.toBits ≥ 2 ^ (T.fmt.eb + T.fmt.sb)
    · have : x.signbit = true := by rw [← hs]; exact decide_eq_true h
      simp [h, this]
    · have : x.signbit = false := by rw [← hs]; exact decide_eq_false h
      simp [h, this]

theorem mfEncodeBits (T : FTy) (s : Bool) (M : Nat) :
    (Fl.ofBits ((if s then 2 ^ (T.fmt.eb + T.fmt.sb) else 0) + M) : FV T) = NextProofs.encode T s M := rfl

theorem mfLdexpUnfold {T : FTy} (o : IEEEOps T) (x : FV T) (e : Int) : ldexp o x e = (Id.run do
    let xu0 := x.toBits
    let xs := withoutBits xu0 (signMask T) T.fmt.width
    if xs >= exponentMask T then return x
    let mut xu := xu0
    let mut k : Int := (xs / 2 ^ T.fmt.sb : Nat)
    if k == 0 then
      if xs == 0 then return x
      let m := leadingZeros T.fmt.width xs - T.fmt.eb
      let ys := xs * 2 ^ m
      xu := ys + (if fsignbit x then signMask T else 0)
      k := 1 - (m : Int)
      if e < -50000 then return o.flipsign (fzero T) x
    if e > IntTy.max .i64 then return o.flipsign (finf T) x
    else if e < IntTy.min .i64 then return o.flipsign (fzero T) x
    let n := wrapInt .i64 e
    k := wrapInt .i64 (k + n)
    if k >= T.fmt.emax then return o.flipsign (finf T) x
    if k > 0 then
      xu := withoutBits xu (exponentMask T) T.fmt.width + k.toNat * 2 ^ T.fmt.sb
      return Fl.ofBits xu
    else
      if k <= -(T.fmt.sb : Int) - 1 then
        if e > 50000 then return o.flipsign (finf T) x
        return o.flipsign (fzero T) x
      k := k + T.fmt.sb + 1
      let z : FV T := Fl.ofBits ((T.fmt.bias - T.fmt.sb - 1) * 2 ^ T.fmt.sb)
      xu := withoutBits xu (exponentMask T) T.fmt.width + k.toNat * 2 ^ T.fmt.sb
      return mul z (Fl.ofBits xu)) := by
  simp only [ldexp, ldexpSource, bind, pure, Id.instMonad, Id.run,
    JInt.wrap, decide_eq_true_eq]
  rfl

theorem mfI64Max : IntTy.max .i64 = 2 ^ 63 - 1 := by decide
theorem mfI64Min : IntTy.min .i64 = -(2 ^ 63) := by decide

theorem mfWrap64 (x : Int) (h1 : -(2 ^ 63) ≤ x) (h2 : x ≤ 2 ^ 63 - 1) : wrapInt .i64 x = x :=
  wrapInt_of_inRange .i64 x ⟨by rw [mfI64Min]; exact h1, by rw [mfI64Max]; exact h2⟩

/-- `ldexp` on a normal input: the exponent field moves by `e`. -/
theorem mfLdexpNormal {T : FTy} (o : IEEEOps T) (x : FV T) (e : Int)
    (hx : x.isfinite = true) (hB : x.expField ≠ 0) (he1 : -(2 ^ 62) ≤ e) (he2 : e ≤ 2 ^ 62) :
    ldexp o x e =
      (if (x.expField : Int) + e ≥ T.fmt.emax then o.flipsign (finf T) x
       else if (x.expField : Int) + e > 0 then
         NextProofs.encode T x.signbit (((x.expField : Int) + e).toNat * 2 ^ T.fmt.sb + x.frac)
       else if (x.expField : Int) + e ≤ -(T.fmt.sb : Int) - 1 then
         (if e > 50000 then o.flipsign (finf T) x else o.flipsign (fzero T) x)
       else mul (Fl.ofBits ((T.fmt.bias - T.fmt.sb - 1) * 2 ^ T.fmt.sb) : FV T)
         (NextProofs.encode T x.signbit
           (((x.expField : Int) + e + T.fmt.sb + 1).toNat * 2 ^ T.fmt.sb + x.frac))) := by
  rw [mfLdexpUnfold]
  have hxs : withoutBits x.toBits (signMask T) T.fmt.width = x.magnitude := withoutSignBitMagnitude x
  have hmag := (TruncProofs.isfinite_iff_mag x).1 hx
  have hnm : ¬ (x.magnitude ≥ exponentMask T) := by unfold exponentMask; omega
  have hdiv : x.magnitude / 2 ^ T.fmt.sb = x.expField := (Fl.expField_eq x).symm
  have hEb : x.expField < T.fmt.emax := by rw [← hdiv]; exact Nat.div_lt_of_lt_mul (by rw [Nat.mul_comm]; exact hmag)
  have hemax := (good_fty T).emax_eq
  have hbias := (good_fty T).bias_pos
  have hfb := mfFmtBounds T
  have hk0 : ((x.expField : Int) == 0) = false := by simp; omega
  have hmax : ¬ (e > IntTy.max .i64) := by rw [mfI64Max]; omega
  have hmin : ¬ (e < IntTy.min .i64) := by rw [mfI64Min]; omega
  have hw1 : wrapInt .i64 e = e := mfWrap64 e (by omega) (by omega)
  have hw2 : wrapInt .i64 ((x.expField : Int) + e) = (x.expField : Int) + e :=
    mfWrap64 _ (by omega) (by omega)
  have hclear := mfClearExp x
  simp only [Id.run, hxs, hnm, hdiv, hk0, hmax, hmin, hw1, hw2, Bool.false_eq_true, ↓reduceIte,
    hclear]
  by_cases h1 : (x.expField : Int) + e ≥ T.fmt.emax
  · simp only [h1, ↓reduceIte]
    rfl
  · by_cases h2 : (x.expField : Int) + e > 0
    · simp only [h1, h2, ↓reduceIte]
      rw [← mfEncodeBits]
      congr 2
      omega
    · by_cases h3 : (x.expField : Int) + e ≤ -(T.fmt.sb : Int) - 1
      · simp only [h1, h2, h3, ↓reduceIte]
        split <;> rfl
      · simp only [h1, h2, h3, ↓reduceIte]
        rw [← mfEncodeBits]
        congr 3
        omega

theorem mfEncodeParts (T : FTy) (s : Bool) (B r : Nat) (hB : B < T.fmt.emax) (hr : r < 2 ^ T.fmt.sb) :
    (NextProofs.encode T s (B * 2 ^ T.fmt.sb + r)).signbit = s ∧
    (NextProofs.encode T s (B * 2 ^ T.fmt.sb + r)).expField = B ∧
    (NextProofs.encode T s (B * 2 ^ T.fmt.sb + r)).frac = r ∧
    (NextProofs.encode T s (B * 2 ^ T.fmt.sb + r)).magnitude = B * 2 ^ T.fmt.sb + r ∧
    (NextProofs.encode T s (B * 2 ^ T.fmt.sb + r)).isfinite = true ∧
    (NextProofs.encode T s (B * 2 ^ T.fmt.sb + r)).key =
      if s then -((magKey T.fmt (B * 2 ^ T.fmt.sb + r) : Nat) : Int)
      else ((magKey T.fmt (B * 2 ^ T.fmt.sb + r) : Nat) : Int) := by
  have hS := (good_fty T).emax_succ
  have hp := Fl.pack_parts (f := T.fmt) s B r (by omega) hr
  have heq : NextProofs.encode T s (B * 2 ^ T.fmt.sb + r) = Fl.pack s B r := rfl
  rw [heq]
  refine ⟨hp.1, hp.2.1, hp.2.2.1, hp.2.2.2, ?_, ?_⟩
  · simp only [Fl.isfinite, hp.2.1, bne_iff_ne]; omega
  · unfold Fl.key; rw [hp.1, hp.2.2.2]

theorem mfMagKeyNormal (T : FTy) (B r : Nat) (hB : B ≠ 0) (hr : r < 2 ^ T.fmt.sb) :
    magKey T.fmt (B * 2 ^ T.fmt.sb + r) = (r + 2 ^ T.fmt.sb) * 2 ^ (B - 1) := by
  have hP := Nat.two_pow_pos T.fmt.sb
  unfold magKey
  have hd : (B * 2 ^ T.fmt.sb + r) / 2 ^ T.fmt.sb = B := by
    rw [Nat.add_comm, Nat.add_mul_div_right _ _ hP, Nat.div_eq_of_lt hr, Nat.zero_add]
  have hm : (B * 2 ^ T.fmt.sb + r) % 2 ^ T.fmt.sb = r := by
    rw [Nat.add_comm, Nat.add_mul_mod_self_right, Nat.mod_eq_of_lt hr]
  rw [hd, hm]
  simp [hB]

/-- `one(T)` is the normal value with exponent field `bias` and zero fraction. -/
theorem mfFoneEncode (T : FTy) : fone T = NextProofs.encode T false (T.fmt.bias * 2 ^ T.fmt.sb) := by
  have hg := good_fty T
  have hbias := hg.bias_pos
  have hemax := hg.emax_eq
  have hP := Nat.two_pow_pos T.fmt.sb
  have hM0 : T.fmt.bias * 2 ^ T.fmt.sb ≠ 0 := Nat.mul_ne_zero (by omega) (by omega)
  have hMinf : T.fmt.bias * 2 ^ T.fmt.sb < NextProofs.infMag T := by
    unfold NextProofs.infMag; exact Nat.mul_lt_mul_of_pos_right (by omega) hP
  have hkey : (1 : Int).natAbs * T.fmt.den = magKey T.fmt (T.fmt.bias * 2 ^ T.fmt.sb) * 2 ^ 0 := by
    have hm := mfMagKeyNormal T T.fmt.bias 0 (by omega) hP
    rw [Nat.add_zero] at hm
    rw [hm, Nat.zero_add, ← Nat.pow_add, Nat.pow_zero, Nat.mul_one, Int.natAbs_one, Nat.one_mul]
    unfold Fmt.den
    congr 1
    omega
  have h := mfRoundRatEncode T 1 0 false (T.fmt.bias * 2 ^ T.fmt.sb) (by decide) hM0 hMinf hkey
  show (Fl.roundRat (1 : Int) 1 false : FV T) = _
  simpa using h

/-- `ldexp(one(T), e)` is exactly `2^e` whenever that power is finite and at least the smallest
subnormal; it is `+Inf` once the exponent field overflows. -/
theorem mfLdexpOnePow {T : FTy} (o : IEEEOps T) (hfaith : IEEEFloatOpsFaithful o) (e : Int)
    (hlo : 0 ≤ e + T.fmt.bias + T.fmt.sb - 1) (he2 : e ≤ 2 ^ 62) :
    (e + T.fmt.bias < T.fmt.emax →
      (ldexp o (fone T) e).isfinite = true ∧
      (ldexp o (fone T) e).key = ((2 ^ (e + T.fmt.bias + T.fmt.sb - 1).toNat : Nat) : Int)) ∧
    (e + T.fmt.bias ≥ T.fmt.emax → ldexp o (fone T) e = finf T) := by
  rcases hfaith with ⟨_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, hflip, _, _⟩
  have hg := good_fty T
  have hbias := hg.bias_pos
  have hsb := hg.sb_pos
  have hemax := hg.emax_eq
  have hP := Nat.two_pow_pos T.fmt.sb
  have hbS : T.fmt.sb + 2 ≤ T.fmt.bias := (mfFmtBounds T).2.2.2
  have hfb := mfFmtBounds T
  obtain ⟨hs1, he1, hf1, -, hfin1, -⟩ := mfEncodeParts T false T.fmt.bias 0 (by omega) hP
  have hone : fone T = NextProofs.encode T false (T.fmt.bias * 2 ^ T.fmt.sb + 0) := by
    rw [Nat.add_zero]; exact mfFoneEncode T
  have hfin : (fone T).isfinite = true := by rw [hone]; exact hfin1
  have hB : (fone T).expField = T.fmt.bias := by rw [hone]; exact he1
  have hF : (fone T).frac = 0 := by rw [hone]; exact hf1
  have hS : (fone T).signbit = false := by rw [hone]; exact hs1
  rw [mfLdexpNormal o (fone T) e hfin (by omega) (by omega) he2, hB, hF, hS]
  refine ⟨fun hlt => ?_, fun hge => ?_⟩
  · have hn1 : ¬ ((T.fmt.bias : Int) + e ≥ T.fmt.emax) := by omega
    by_cases hpos : (T.fmt.bias : Int) + e > 0
    · simp only [hn1, hpos, ↓reduceIte, Nat.add_zero]
      have hBe : ((T.fmt.bias : Int) + e).toNat < T.fmt.emax := by omega
      obtain ⟨-, -, -, -, hfin2, hkey2⟩ := mfEncodeParts T false _ 0 hBe hP
      rw [Nat.add_zero] at hfin2 hkey2
      refine ⟨hfin2, ?_⟩
      rw [hkey2]
      simp only [Bool.false_eq_true, ↓reduceIte]
      rw [show ((T.fmt.bias : Int) + e).toNat * 2 ^ T.fmt.sb = ((T.fmt.bias : Int) + e).toNat * 2 ^ T.fmt.sb + 0
        by rw [Nat.add_zero], mfMagKeyNormal T _ 0 (by omega) hP, Nat.zero_add, ← Nat.pow_add]
      congr 2
      omega
    · have hn3 : ¬ ((T.fmt.bias : Int) + e ≤ -(T.fmt.sb : Int) - 1) := by omega
      simp only [hn1, hpos, hn3, ↓reduceIte, Nat.add_zero]
      -- the subnormal result: z * w with z = 2^(-sb-1) and w = 2^(bias+e+sb+1-bias)
      have hzB : T.fmt.bias - T.fmt.sb - 1 < T.fmt.emax := by omega
      have hz : (Fl.ofBits ((T.fmt.bias - T.fmt.sb - 1) * 2 ^ T.fmt.sb) : FV T) =
          NextProofs.encode T false ((T.fmt.bias - T.fmt.sb - 1) * 2 ^ T.fmt.sb + 0) := by
        unfold NextProofs.encode; simp
      obtain ⟨-, -, -, -, hzfin, hzkey⟩ := mfEncodeParts T false _ 0 hzB hP
      have hwB : ((T.fmt.bias : Int) + e + T.fmt.sb + 1).toNat < T.fmt.emax := by omega
      obtain ⟨-, -, -, -, hwfin, hwkey⟩ := mfEncodeParts T false _ 0 hwB hP
      rw [Nat.add_zero] at hwfin hwkey
      rw [hz]
      have hL : (e + T.fmt.bias + T.fmt.sb - 1).toNat < T.fmt.sb := by omega
      have hM0 : 2 ^ (e + T.fmt.bias + T.fmt.sb - 1).toNat ≠ 0 := by
        have := Nat.two_pow_pos (e + T.fmt.bias + T.fmt.sb - 1).toNat; omega
      have hMsmall : 2 ^ (e + T.fmt.bias + T.fmt.sb - 1).toNat < 2 ^ T.fmt.sb :=
        Nat.pow_lt_pow_right (by decide) hL
      have hMinf : 2 ^ (e + T.fmt.bias + T.fmt.sb - 1).toNat < NextProofs.infMag T := by
        unfold NextProofs.infMag
        have : 2 ^ T.fmt.sb ≤ T.fmt.emax * 2 ^ T.fmt.sb := Nat.le_mul_of_pos_left _ (by omega)
        omega
      have hmk : magKey T.fmt (2 ^ (e + T.fmt.bias + T.fmt.sb - 1).toNat) =
          2 ^ (e + T.fmt.bias + T.fmt.sb - 1).toNat := by
        unfold magKey
        rw [Nat.div_eq_of_lt hMsmall, Nat.mod_eq_of_lt hMsmall]
        simp
      have hzk : magKey T.fmt ((T.fmt.bias - T.fmt.sb - 1) * 2 ^ T.fmt.sb + 0) =
          2 ^ (T.fmt.sb + (T.fmt.bias - T.fmt.sb - 2)) := by
        rw [mfMagKeyNormal T _ 0 (by omega) hP, Nat.zero_add, ← Nat.pow_add]
        congr 1 <;> omega
      have hwk : magKey T.fmt (((T.fmt.bias : Int) + e + T.fmt.sb + 1).toNat * 2 ^ T.fmt.sb) =
          2 ^ (T.fmt.sb + (((T.fmt.bias : Int) + e + T.fmt.sb + 1).toNat - 1)) := by
        have h := mfMagKeyNormal T (((T.fmt.bias : Int) + e + T.fmt.sb + 1).toNat) 0 (by omega) hP
        rw [Nat.add_zero] at h
        rw [h, Nat.zero_add, ← Nat.pow_add]
      have hNat : 2 ^ (T.fmt.sb + (T.fmt.bias - T.fmt.sb - 2)) *
          2 ^ (T.fmt.sb + (((T.fmt.bias : Int) + e + T.fmt.sb + 1).toNat - 1)) =
          2 ^ (e + T.fmt.bias + T.fmt.sb - 1).toNat * T.fmt.den := by
        unfold Fmt.den
        rw [← Nat.pow_add, ← Nat.pow_add]
        congr 1
        omega
      have hmul := mfMulEncode (NextProofs.encode T false ((T.fmt.bias - T.fmt.sb - 1) * 2 ^ T.fmt.sb + 0))
        (NextProofs.encode T false (((T.fmt.bias : Int) + e + T.fmt.sb + 1).toNat * 2 ^ T.fmt.sb))
        hzfin hwfin false _ hM0 hMinf (by
          rw [hzkey, hwkey, hmk, hzk, hwk]
          simp only [Bool.false_eq_true, ↓reduceIte]
          exact_mod_cast hNat)
      change mul_float _ _ = _ at hmul
      show (mul_float _ _ : FV T).isfinite = true ∧ (mul_float _ _ : FV T).key = _
      rw [hmul]
      have hmag : 2 ^ (e + T.fmt.bias + T.fmt.sb - 1).toNat = 0 * 2 ^ T.fmt.sb + 2 ^ (e + T.fmt.bias + T.fmt.sb - 1).toNat := by
        simp
      obtain ⟨-, -, -, -, hrfin, hrkey⟩ := mfEncodeParts T false 0 _ (by omega) hMsmall
      rw [← hmag] at hrfin hrkey
      refine ⟨hrfin, ?_⟩
      rw [hrkey, hmk]
      simp
  · have h1 : (T.fmt.bias : Int) + e ≥ T.fmt.emax := by omega
    simp only [h1, ↓reduceIte]
    rw [hflip]
    rw [hone, NextProofs.sign_encode T false (by
      have := NextProofs.infMag_lt_signMask T; unfold NextProofs.infMag at this
      have : T.fmt.bias * 2 ^ T.fmt.sb + 0 < T.fmt.emax * 2 ^ T.fmt.sb :=
        by rw [Nat.add_zero]; exact Nat.mul_lt_mul_of_pos_right (by omega) hP
      omega)]
    rfl

/-! ## exponentFiniteNonzero is the base-two logarithm of the key -/

theorem mfExpFNZUnfold {T : FTy} (x : FV T) : exponentFiniteNonzero x =
    (let xs := withoutBits x.toBits (signMask T) T.fmt.width
     let k : Int := (xs / 2 ^ T.fmt.sb : Nat)
     if k == 0 then
       let m := leadingZeros T.fmt.width xs - T.fmt.eb
       (1 - (m : Int)) - T.fmt.bias
     else k - T.fmt.bias) := rfl

theorem mfExponentLog {T : FTy} (x : FV T) (hx : x.isfinite = true) (hz : x.magnitude ≠ 0) :
    exponentFiniteNonzero x + T.fmt.bias + T.fmt.sb - 1 =
      ((magKey T.fmt x.magnitude).log2 : Int) := by
  have hg := good_fty T
  have hsb := hg.sb_pos
  have hP := Nat.two_pow_pos T.fmt.sb
  obtain ⟨hmd, hfr⟩ := TruncProofs.mag_decomp x
  have hxs : withoutBits x.toBits (signMask T) T.fmt.width = x.magnitude := withoutSignBitMagnitude x
  have hdiv : x.magnitude / 2 ^ T.fmt.sb = x.expField := (Fl.expField_eq x).symm
  rw [mfExpFNZUnfold]
  simp only [hxs, hdiv]
  by_cases hB : x.expField = 0
  · have hmf : x.magnitude = x.frac := by rw [hmd, hB]; simp
    have hf0 : x.frac ≠ 0 := by omega
    have hlog : x.frac.log2 < T.fmt.sb := (Nat.log2_lt hf0).2 hfr
    have hwidth : T.fmt.width = T.fmt.eb + T.fmt.sb + 1 := by simp [Fmt.width]; omega
    have hmk : magKey T.fmt x.magnitude = x.frac := by
      unfold magKey; rw [hdiv, hB, ← Fl.frac_eq]; simp
    simp only [hB, Int.natCast_zero, beq_self_eq_true, ↓reduceIte]
    rw [hmk, hmf]
    unfold leadingZeros
    rw [if_neg hf0, hwidth]
    omega
  · have hBc : ((x.expField : Int) == 0) = false := by simp; omega
    simp only [hBc, Bool.false_eq_true, ↓reduceIte]
    have hmk : magKey T.fmt x.magnitude = (x.frac + 2 ^ T.fmt.sb) * 2 ^ (x.expField - 1) := by
      rw [hmd, mfMagKeyNormal T _ _ hB hfr]
    have hc1 : 2 ^ T.fmt.sb ≤ x.frac + 2 ^ T.fmt.sb := by omega
    have hc2 : x.frac + 2 ^ T.fmt.sb < 2 ^ (T.fmt.sb + 1) := by rw [Nat.pow_succ]; omega
    rw [hmk, Fl.log2_mul_pow _ _ (by omega), mfLog2Eq _ _ hc1 hc2]
    omega

/-! ## mathfuncs-exponent-float -/

theorem mfExponentFloatValue {T : FTy} (x : FV T)
    (hfinite : fisfinite x = true) (hnonzero : fiszero x = false) :
    exponentFloat x = .ok (exponentFiniteNonzero x) := by
  have hxFinite : x.isfinite = true := by
    rw [← JuliaLean.Proofs.base.float.isfinite_IEEEFloat_eq x]
    exact hfinite
  have hxZero : x.iszero = false := by
    simpa [fiszero, JuliaLean.Proofs.base.float.iszero_float_eq] using hnonzero
  have hmag : x.magnitude < T.fmt.emax * 2 ^ T.fmt.sb :=
    (JuliaLean.Proofs.base.float.TruncProofs.isfinite_iff_mag x).mp hxFinite
  have hmag0 : x.magnitude ≠ 0 := by simpa [Fl.iszero] using hxZero
  have hxs : withoutBits x.toBits (signMask T) T.fmt.width = x.magnitude :=
    withoutSignBitMagnitude x
  have hmask : ¬ (T.fmt.emax * 2 ^ T.fmt.sb ≤ x.magnitude) := by omega
  simp [exponentFloat, exponentFiniteNonzero, hxs, hmask, hmag0,
    JuliaLean.base.math.exponentMask]
  split <;> rfl

theorem mfFabsKey {T : FTy} (x : FV T) (hx : x.isfinite = true) :
    (fabs x).isnan = false ∧ (fabs x).isfinite = true ∧
    (fabs x).key = ((magKey T.fmt x.magnitude : Nat) : Int) := by
  have hm := (TruncProofs.isfinite_iff_mag x).1 hx
  have hcap : x.magnitude < NextProofs.signMask T :=
    Nat.lt_trans hm (NextProofs.infMag_lt_signMask T)
  have habs : fabs x = NextProofs.encode T false x.magnitude := RemainderProofs.abs_encoded x hx
  have hfin : (fabs x).isfinite = true := by
    rw [habs]; exact EpsilonNeighborProofs.encode_finite T false _ hm
  refine ⟨Fl.isnan_of_finite hfin, hfin, ?_⟩
  rw [habs, EpsilonNeighborProofs.encode_key T false _ hcap]
  rfl

theorem exponentFloatRange_proven : ExponentFloatRange := by
  intro T o x hfaith hfinite hzero
  have hx : x.isfinite = true := by
    rw [← JuliaLean.Proofs.base.float.isfinite_IEEEFloat_eq x]; exact hfinite
  have hz : x.magnitude ≠ 0 := by
    have : x.iszero = false := by simpa [fiszero, iszero_float_eq] using hzero
    simpa [Fl.iszero] using this
  refine ⟨exponentFiniteNonzero x, mfExponentFloatValue x hfinite hzero, ?_, ?_⟩
  all_goals
    have hlog := mfExponentLog x hx hz
    have hfb := mfFmtBounds T
    have hg := good_fty T
    have hemax := hg.emax_eq
    have hbias := hg.bias_pos
    have hsb := hg.sb_pos
    obtain ⟨hfn, -, hfk⟩ := mfFabsKey x hx
    have hK0 : magKey T.fmt x.magnitude ≠ 0 :=
      Nat.ne_of_gt ((magKey_cases T.fmt x.magnitude).resolve_left (by omega)).2
    have hKlo := Nat.log2_self_le hK0
    have hKhi := @Nat.lt_log2_self (magKey T.fmt x.magnitude)
    have hKmax := Fl.finite_key_lt_inf hg (fabs x) (mfFabsKey x hx).2.1
    rw [hfk] at hKmax
    have hLmax : (magKey T.fmt x.magnitude).log2 < T.fmt.sb + (T.fmt.emax - 1) := by
      have h1 : magKey T.fmt x.magnitude < 2 ^ (T.fmt.sb + (T.fmt.emax - 1)) := by
        rw [Nat.pow_add]; omega
      exact (Nat.log2_lt hK0).2 h1
  · obtain ⟨hres, -⟩ := mfLdexpOnePow o hfaith (exponentFiniteNonzero x) (by omega) (by omega)
    obtain ⟨hfin, hkey⟩ := hres (by omega)
    rw [show fle (T := T) = le_IEEEFloat from rfl, le_IEEEFloat_key _ _ (Fl.isnan_of_finite hfin) hfn,
      hkey, hfk]
    apply decide_eq_true
    have : (exponentFiniteNonzero x + T.fmt.bias + T.fmt.sb - 1).toNat = (magKey T.fmt x.magnitude).log2 := by
      omega
    rw [this]
    exact_mod_cast hKlo
  · have hsplit := mfLdexpOnePow o hfaith (exponentFiniteNonzero x + 1) (by omega) (by omega)
    rw [show flt (T := T) = lt_float from rfl]
    show Fl.lt _ _ = true
    by_cases hov : exponentFiniteNonzero x + 1 + T.fmt.bias < T.fmt.emax
    · obtain ⟨hfin, hkey⟩ := hsplit.1 hov
      rw [Fl.lt_key hfn (Fl.isnan_of_finite hfin), hkey, hfk]
      apply decide_eq_true
      have : (exponentFiniteNonzero x + 1 + T.fmt.bias + T.fmt.sb - 1).toNat =
          (magKey T.fmt x.magnitude).log2 + 1 := by omega
      rw [this]
      exact_mod_cast hKhi
    · rw [hsplit.2 (by omega)]
      have hinf : (finf T).isinf = true := by cases T <;> decide
      have hinfs : (finf T).signbit = false := by cases T <;> decide
      rw [Fl.lt_key hfn (by cases T <;> decide), hfk, Fl.inf_key_eq hg _ hinf, hinfs]
      simp only [Bool.false_eq_true, ↓reduceIte]
      exact decide_eq_true hKmax.2

end MathfuncsProofs

section MathfuncsProofs

open JuliaLean.Proofs.base.float JuliaLean.C

/-! ## Normalized significands: shared facts for `frexp`, `significand` and `ldexp` -/

/-- The significand of a finite nonzero value, scaled into `[2^sb, 2^(sb+1))`. -/
def mfNormSig {T : FTy} (x : FV T) : Nat :=
  if x.expField = 0 then x.frac * 2 ^ (T.fmt.sb - x.frac.log2) else x.frac + 2 ^ T.fmt.sb

theorem mfNormSigFacts {T : FTy} (x : FV T) (hx : x.isfinite = true) (hz : x.magnitude ≠ 0) :
    2 ^ T.fmt.sb ≤ mfNormSig x ∧ mfNormSig x < 2 ^ (T.fmt.sb + 1) ∧
    magKey T.fmt x.magnitude * 2 ^ T.fmt.sb = mfNormSig x * 2 ^ (magKey T.fmt x.magnitude).log2 ∧
    (x.expField ≠ 0 → (magKey T.fmt x.magnitude).log2 = T.fmt.sb + x.expField - 1 ∧
      mfNormSig x = x.frac + 2 ^ T.fmt.sb) ∧
    (x.expField = 0 → (magKey T.fmt x.magnitude).log2 = x.frac.log2 ∧
      magKey T.fmt x.magnitude = x.frac ∧ x.frac.log2 < T.fmt.sb) := by
  have hP := Nat.two_pow_pos T.fmt.sb
  obtain ⟨hmd, hfr⟩ := TruncProofs.mag_decomp x
  have hdiv : x.magnitude / 2 ^ T.fmt.sb = x.expField := (Fl.expField_eq x).symm
  have hpow : 2 ^ (T.fmt.sb + 1) = 2 * 2 ^ T.fmt.sb := by rw [Nat.pow_succ, Nat.mul_comm]
  by_cases hB : x.expField = 0
  · have hmf : x.magnitude = x.frac := by rw [hmd, hB]; simp
    have hf0 : x.frac ≠ 0 := by omega
    have hlog : x.frac.log2 < T.fmt.sb := (Nat.log2_lt hf0).2 hfr
    have hmk : magKey T.fmt x.magnitude = x.frac := by
      unfold magKey; rw [hdiv, hB, ← Fl.frac_eq]; simp
    obtain ⟨-, h1, h2⟩ := Fl.sig_bounds (f := T.fmt) x.frac hf0 (by omega)
    have hc : mfNormSig x = x.frac * 2 ^ (T.fmt.sb - x.frac.log2) := by simp [mfNormSig, hB]
    refine ⟨by rw [hc]; exact h1, by rw [hc]; exact h2, ?_, fun h => absurd hB h, fun _ => ⟨by rw [hmk], hmk, hlog⟩⟩
    rw [hmk, hc, Nat.mul_assoc, ← Nat.pow_add]
    congr 2
    omega
  · have hc1 : 2 ^ T.fmt.sb ≤ x.frac + 2 ^ T.fmt.sb := by omega
    have hc2 : x.frac + 2 ^ T.fmt.sb < 2 ^ (T.fmt.sb + 1) := by omega
    have hmk : magKey T.fmt x.magnitude = (x.frac + 2 ^ T.fmt.sb) * 2 ^ (x.expField - 1) := by
      rw [hmd, mfMagKeyNormal T _ _ hB hfr]
    have hL : (magKey T.fmt x.magnitude).log2 = T.fmt.sb + x.expField - 1 := by
      rw [hmk, Fl.log2_mul_pow _ _ (by omega), mfLog2Eq _ _ hc1 hc2]
      omega
    have hc : mfNormSig x = x.frac + 2 ^ T.fmt.sb := by simp [mfNormSig, hB]
    refine ⟨by rw [hc]; exact hc1, by rw [hc]; exact hc2, ?_, fun _ => ⟨hL, hc⟩, fun h => absurd h hB⟩
    rw [hL, hmk, hc, Nat.mul_assoc, ← Nat.pow_add]
    congr 2
    omega

theorem mfClearExpVal (T : FTy) (v : Nat) (hv : v < 2 ^ T.fmt.width) :
    withoutBits v (exponentMask T) T.fmt.width =
      (if v ≥ 2 ^ (T.fmt.eb + T.fmt.sb) then 2 ^ (T.fmt.eb + T.fmt.sb) else 0) + v % 2 ^ T.fmt.sb := by
  rw [mfWithoutBitsEq, mfExpMaskComplement, mfLandSignFrac T _ hv]

/-- The normalized subnormal bit pattern: the shifted magnitude plus the sign bit, with its
exponent field cleared, is the sign bit plus the normalized fraction. -/
theorem mfSubnormalShift {T : FTy} (x : FV T) (hx : x.isfinite = true) (hz : x.magnitude ≠ 0)
    (hB : x.expField = 0) :
    leadingZeros T.fmt.width x.magnitude - T.fmt.eb = T.fmt.sb - x.frac.log2 ∧
    withoutBits (x.magnitude * 2 ^ (leadingZeros T.fmt.width x.magnitude - T.fmt.eb) +
        (if fsignbit x then signMask T else 0)) (exponentMask T) T.fmt.width =
      (if x.signbit then 2 ^ (T.fmt.eb + T.fmt.sb) else 0) + (mfNormSig x - 2 ^ T.fmt.sb) := by
  have hP := Nat.two_pow_pos T.fmt.sb
  obtain ⟨hmd, hfr⟩ := TruncProofs.mag_decomp x
  have hmf : x.magnitude = x.frac := by rw [hmd, hB]; simp
  have hf0 : x.frac ≠ 0 := by omega
  have hlog : x.frac.log2 < T.fmt.sb := (Nat.log2_lt hf0).2 hfr
  have hwidth : T.fmt.width = T.fmt.eb + T.fmt.sb + 1 := by simp [Fmt.width]; omega
  have hlz : leadingZeros T.fmt.width x.magnitude - T.fmt.eb = T.fmt.sb - x.frac.log2 := by
    unfold leadingZeros
    rw [hmf, if_neg hf0, hwidth]
    omega
  obtain ⟨hc1, hc2, -, -, -⟩ := mfNormSigFacts x hx hz
  have hc : mfNormSig x = x.frac * 2 ^ (T.fmt.sb - x.frac.log2) := by simp [mfNormSig, hB]
  refine ⟨hlz, ?_⟩
  rw [hlz, hmf, ← hc]
  have hsg : fsignbit x = x.signbit := signbit_float_eq x
  have heb : 1 ≤ T.fmt.eb := by cases T <;> decide
  have hS : 2 ^ (T.fmt.sb + 1) ≤ 2 ^ (T.fmt.eb + T.fmt.sb) :=
    Nat.pow_le_pow_right (by decide) (by omega)
  have hw := Fmt.width_pow T.fmt
  have hsm : signMask T = 2 ^ (T.fmt.eb + T.fmt.sb) := rfl
  rw [hsg, hsm, mfClearExpVal T _ (by split <;> omega)]
  have hmod : (mfNormSig x + (if x.signbit then 2 ^ (T.fmt.eb + T.fmt.sb) else 0)) % 2 ^ T.fmt.sb =
      mfNormSig x - 2 ^ T.fmt.sb := by
    have hsplit : 2 ^ (T.fmt.eb + T.fmt.sb) = 2 ^ T.fmt.eb * 2 ^ T.fmt.sb := Nat.pow_add _ _ _
    have hpow : 2 ^ (T.fmt.sb + 1) = 2 * 2 ^ T.fmt.sb := by rw [Nat.pow_succ, Nat.mul_comm]
    have h1 : mfNormSig x % 2 ^ T.fmt.sb = mfNormSig x - 2 ^ T.fmt.sb := by
      rw [Nat.mod_eq_sub_mod (by omega), Nat.mod_eq_of_lt (by omega)]
    split
    · rw [hsplit, Nat.add_mul_mod_self_right, h1]
    · rw [Nat.add_zero, h1]
  rw [hmod]
  split <;> split <;> rename_i h1 h2 <;> first | rfl | (exfalso; omega) | skip
  all_goals simp_all <;> omega

/-- `ldexp` rebuilds a finite nonzero value from any normal value with the same sign and
normalized fraction, given the matching exponent shift. -/
theorem mfLdexpRoundTrip {T : FTy} (o : IEEEOps T) (x : FV T) (hx : x.isfinite = true)
    (hz : x.magnitude ≠ 0) (B0 : Nat) (hB0 : 1 ≤ B0) (hB0' : B0 < T.fmt.emax) (e : Int)
    (he : (B0 : Int) + e = ((magKey T.fmt x.magnitude).log2 : Int) - T.fmt.sb + 1) :
    ldexp o (NextProofs.encode T x.signbit (B0 * 2 ^ T.fmt.sb + (mfNormSig x - 2 ^ T.fmt.sb))) e = x := by
  have hg := good_fty T
  have hfb := mfFmtBounds T
  have hemax := hg.emax_eq
  have hP := Nat.two_pow_pos T.fmt.sb
  obtain ⟨hc1, hc2, hrel, hnorm, hsub⟩ := mfNormSigFacts x hx hz
  have hpow : 2 ^ (T.fmt.sb + 1) = 2 * 2 ^ T.fmt.sb := by rw [Nat.pow_succ, Nat.mul_comm]
  have hr : mfNormSig x - 2 ^ T.fmt.sb < 2 ^ T.fmt.sb := by omega
  obtain ⟨hs, hE, hF, -, hfin, -⟩ := mfEncodeParts T x.signbit B0 _ hB0' hr
  have hK0 : magKey T.fmt x.magnitude ≠ 0 :=
    Nat.ne_of_gt ((magKey_cases T.fmt x.magnitude).resolve_left (by omega)).2
  have hKmax := Fl.finite_key_lt_inf hg x hx
  have hkeyx : x.key = if x.signbit then -((magKey T.fmt x.magnitude : Nat) : Int)
      else ((magKey T.fmt x.magnitude : Nat) : Int) := rfl
  have hLmax : (magKey T.fmt x.magnitude).log2 < T.fmt.sb + (T.fmt.emax - 1) := by
    have h1 : magKey T.fmt x.magnitude < 2 ^ (T.fmt.sb + (T.fmt.emax - 1)) := by
      rw [Nat.pow_add]; cases hxs : x.signbit <;> simp only [hxs, ↓reduceIte, Bool.false_eq_true] at hkeyx <;> omega
    exact (Nat.log2_lt hK0).2 h1
  rw [mfLdexpNormal o _ e hfin (by omega) (by omega) (by omega), hE, hF, hs]
  have hn1 : ¬ ((B0 : Int) + e ≥ T.fmt.emax) := by omega
  by_cases hB : x.expField = 0
  · obtain ⟨hL, hmk, hlog⟩ := hsub hB
    have hn2 : ¬ ((B0 : Int) + e > 0) := by omega
    have hn3 : ¬ ((B0 : Int) + e ≤ -(T.fmt.sb : Int) - 1) := by omega
    simp only [hn1, hn2, hn3, ↓reduceIte]
    have hwB : ((B0 : Int) + e + T.fmt.sb + 1).toNat = (magKey T.fmt x.magnitude).log2 + 2 := by omega
    rw [hwB]
    have hzB : T.fmt.bias - T.fmt.sb - 1 < T.fmt.emax := by omega
    have hzE : (Fl.ofBits ((T.fmt.bias - T.fmt.sb - 1) * 2 ^ T.fmt.sb) : FV T) =
        NextProofs.encode T false ((T.fmt.bias - T.fmt.sb - 1) * 2 ^ T.fmt.sb + 0) := by
      unfold NextProofs.encode; simp
    obtain ⟨-, -, -, -, hzfin, hzkey⟩ := mfEncodeParts T false _ 0 hzB hP
    have hwB' : (magKey T.fmt x.magnitude).log2 + 2 < T.fmt.emax := by omega
    obtain ⟨-, -, -, -, hwfin, hwkey⟩ := mfEncodeParts T x.signbit _ _ hwB' hr
    rw [hzE]
    have hm := (TruncProofs.isfinite_iff_mag x).1 hx
    have hzk : magKey T.fmt ((T.fmt.bias - T.fmt.sb - 1) * 2 ^ T.fmt.sb + 0) =
        2 ^ (T.fmt.sb + (T.fmt.bias - T.fmt.sb - 2)) := by
      rw [mfMagKeyNormal T _ 0 (by omega) hP, Nat.zero_add, ← Nat.pow_add]
      congr 1 <;> omega
    have hwk : magKey T.fmt (((magKey T.fmt x.magnitude).log2 + 2) * 2 ^ T.fmt.sb +
        (mfNormSig x - 2 ^ T.fmt.sb)) = mfNormSig x * 2 ^ ((magKey T.fmt x.magnitude).log2 + 1) := by
      rw [mfMagKeyNormal T _ _ (by omega) hr, Nat.sub_add_cancel hc1,
        show (magKey T.fmt x.magnitude).log2 + 2 - 1 = (magKey T.fmt x.magnitude).log2 + 1 by omega]
    have hNat : 2 ^ (T.fmt.sb + (T.fmt.bias - T.fmt.sb - 2)) *
        (mfNormSig x * 2 ^ ((magKey T.fmt x.magnitude).log2 + 1)) =
        magKey T.fmt x.magnitude * T.fmt.den := by
      apply Nat.eq_of_mul_eq_mul_right hP
      unfold Fmt.den
      calc 2 ^ (T.fmt.sb + (T.fmt.bias - T.fmt.sb - 2)) *
            (mfNormSig x * 2 ^ ((magKey T.fmt x.magnitude).log2 + 1)) * 2 ^ T.fmt.sb
          = (mfNormSig x * 2 ^ (magKey T.fmt x.magnitude).log2) *
              2 ^ (T.fmt.sb + (T.fmt.bias - T.fmt.sb - 2) + 1 + T.fmt.sb) := by
            simp only [Nat.pow_add, Nat.pow_one]
            simp only [Nat.mul_assoc, Nat.mul_comm, Nat.mul_left_comm]
        _ = (magKey T.fmt x.magnitude * 2 ^ T.fmt.sb) *
              2 ^ (T.fmt.sb + (T.fmt.bias - T.fmt.sb - 2) + 1 + T.fmt.sb) := by rw [hrel]
        _ = magKey T.fmt x.magnitude * 2 ^ (T.fmt.bias + T.fmt.sb - 1) * 2 ^ T.fmt.sb := by
            rw [Nat.mul_assoc, Nat.mul_assoc, ← Nat.pow_add, ← Nat.pow_add]
            congr 2
            omega
    have hmul := mfMulEncode (NextProofs.encode T false ((T.fmt.bias - T.fmt.sb - 1) * 2 ^ T.fmt.sb + 0))
      (NextProofs.encode T x.signbit (((magKey T.fmt x.magnitude).log2 + 2) * 2 ^ T.fmt.sb +
        (mfNormSig x - 2 ^ T.fmt.sb)))
      hzfin hwfin x.signbit x.magnitude hz (by unfold NextProofs.infMag; exact hm) (by
        rw [hzkey, hwkey, hzk, hwk]
        cases x.signbit
        · simp only [Bool.false_eq_true, ↓reduceIte]; exact_mod_cast hNat
        · simp only [Bool.false_eq_true, ↓reduceIte, Int.mul_neg, Int.neg_mul]
          exact congrArg Neg.neg (by exact_mod_cast hNat))
    change mul_float _ _ = _ at hmul
    show mul_float _ _ = x
    rw [hmul, NextProofs.encode_input]
  · obtain ⟨hL, hc⟩ := hnorm hB
    have hp : (B0 : Int) + e > 0 := by omega
    simp only [hn1, hp, ↓reduceIte]
    have hE' : ((B0 : Int) + e).toNat = x.expField := by omega
    rw [hE', hc, Nat.add_sub_cancel, ← (TruncProofs.mag_decomp x).1, NextProofs.encode_input]

/-! ## Constants one, two and one half -/

theorem mfOfIntTwoEncode (T : FTy) :
    (Fl.ofInt 2 : FV T) = NextProofs.encode T false ((T.fmt.bias + 1) * 2 ^ T.fmt.sb) := by
  have hg := good_fty T
  have hbias := hg.bias_pos
  have hemax := hg.emax_eq
  have hP := Nat.two_pow_pos T.fmt.sb
  have hM0 : (T.fmt.bias + 1) * 2 ^ T.fmt.sb ≠ 0 := Nat.mul_ne_zero (by omega) (by omega)
  have hMinf : (T.fmt.bias + 1) * 2 ^ T.fmt.sb < NextProofs.infMag T := by
    unfold NextProofs.infMag; exact Nat.mul_lt_mul_of_pos_right (by omega) hP
  have hkey : (2 : Int).natAbs * T.fmt.den = magKey T.fmt ((T.fmt.bias + 1) * 2 ^ T.fmt.sb) * 2 ^ 0 := by
    have hm := mfMagKeyNormal T (T.fmt.bias + 1) 0 (by omega) hP
    rw [Nat.add_zero] at hm
    rw [hm, Nat.zero_add, ← Nat.pow_add, Nat.pow_zero, Nat.mul_one]
    unfold Fmt.den
    show 2 * 2 ^ (T.fmt.bias + T.fmt.sb - 1) = _
    rw [← Nat.pow_succ']
    congr 1
    omega
  have h := mfRoundRatEncode T 2 0 false ((T.fmt.bias + 1) * 2 ^ T.fmt.sb) (by decide) hM0 hMinf hkey
  show (Fl.roundRat (2 : Int) 1 false : FV T) = _
  simpa using h

theorem mfHalfEncode (T : FTy) :
    (div (fone T) (Fl.ofInt 2) : FV T) = NextProofs.encode T false ((T.fmt.bias - 1) * 2 ^ T.fmt.sb) := by
  cases T <;> decide +kernel

theorem mfEncodeKeyNonneg (T : FTy) (M : Nat) (hM : M < NextProofs.infMag T) :
    (NextProofs.encode T false M).isnan = false ∧ (NextProofs.encode T false M).isfinite = true ∧
    (NextProofs.encode T false M).key = ((magKey T.fmt M : Nat) : Int) := by
  have hfin := EpsilonNeighborProofs.encode_finite T false M hM
  refine ⟨Fl.isnan_of_finite hfin, hfin, ?_⟩
  rw [EpsilonNeighborProofs.encode_key T false M (Nat.lt_trans hM (NextProofs.infMag_lt_signMask T))]
  rfl

/-! ## mathfuncs-frexp-range -/

theorem mfFrexpUnfold {T : FTy} (x : FV T) : frexp x = (Id.run do
    let xu0 := x.toBits
    let mut xu := xu0
    let xs := withoutBits xu0 (signMask T) T.fmt.width
    if xs >= exponentMask T then return (x, 0)
    let mut k : Int := (xs / 2 ^ T.fmt.sb : Nat)
    if k == 0 then
      if xs == 0 then return (x, 0)
      let m := leadingZeros T.fmt.width xs - T.fmt.eb
      let xs := xs * 2 ^ m
      xu := xs + (if fsignbit x then signMask T else 0)
      k := 1 - m
    k := k - (T.fmt.bias - 1)
    xu := withoutBits xu (exponentMask T) T.fmt.width + (T.fmt.bias - 1) * 2 ^ T.fmt.sb
    return (Fl.ofBits xu, k)) := rfl

theorem mfIdPure {α : Type} (a : α) : (pure a : Id α) = a := rfl

theorem mfFrexpChar {T : FTy} (x : FV T) (hx : x.isfinite = true) (hz : x.magnitude ≠ 0) :
    frexp x = (NextProofs.encode T x.signbit ((T.fmt.bias - 1) * 2 ^ T.fmt.sb + (mfNormSig x - 2 ^ T.fmt.sb)),
      ((magKey T.fmt x.magnitude).log2 : Int) - T.fmt.bias - T.fmt.sb + 2) := by
  have hfb := mfFmtBounds T
  have hbias := (good_fty T).bias_pos
  have hxs : withoutBits x.toBits (signMask T) T.fmt.width = x.magnitude := withoutSignBitMagnitude x
  have hmag := (TruncProofs.isfinite_iff_mag x).1 hx
  have hnm : ¬ (x.magnitude ≥ exponentMask T) := by unfold exponentMask; omega
  have hdiv : x.magnitude / 2 ^ T.fmt.sb = x.expField := (Fl.expField_eq x).symm
  obtain ⟨hc1, hc2, -, hnorm, hsub⟩ := mfNormSigFacts x hx hz
  rw [mfFrexpUnfold]
  simp only [Id.run, hxs, hnm, hdiv, Bool.false_eq_true, ↓reduceIte]
  by_cases hB : x.expField = 0
  · obtain ⟨hL, -, hlog⟩ := hsub hB
    obtain ⟨hlz, hclr⟩ := mfSubnormalShift x hx hz hB
    have hz' : (x.magnitude == 0) = false := by simp [hz]
    simp only [hB, Int.natCast_zero, beq_self_eq_true, ↓reduceIte, hz', Bool.false_eq_true]
    rw [hclr, hlz, hL]
    rw [mfIdPure]
    refine Prod.ext ?_ ?_
    · show Fl.ofBits _ = _
      rw [← mfEncodeBits]; congr 1; omega
    · show (_ : Int) = _
      omega
  · obtain ⟨hL, hc⟩ := hnorm hB
    have hBc : ((x.expField : Int) == 0) = false := by simp; omega
    simp only [hBc, Bool.false_eq_true, ↓reduceIte]
    rw [mfClearExp x, hL, hc, Nat.add_sub_cancel]
    rw [mfIdPure]
    refine Prod.ext ?_ ?_
    · show Fl.ofBits _ = _
      rw [← mfEncodeBits]; congr 1; omega
    · show (_ : Int) = _
      omega

theorem frexpRoundTripRange_proven : FrexpRoundTripRange := by
  intro T o x hfaith hfinite hzero
  have hx : x.isfinite = true := by
    rw [← JuliaLean.Proofs.base.float.isfinite_IEEEFloat_eq x]; exact hfinite
  have hz : x.magnitude ≠ 0 := by
    have : x.iszero = false := by simpa [fiszero, iszero_float_eq] using hzero
    simpa [Fl.iszero] using this
  have hg := good_fty T
  have hfb := mfFmtBounds T
  have hemax := hg.emax_eq
  have hbias := hg.bias_pos
  have hP := Nat.two_pow_pos T.fmt.sb
  obtain ⟨hc1, hc2, -, -, -⟩ := mfNormSigFacts x hx hz
  have hpow : 2 ^ (T.fmt.sb + 1) = 2 * 2 ^ T.fmt.sb := by rw [Nat.pow_succ, Nat.mul_comm]
  have hr : mfNormSig x - 2 ^ T.fmt.sb < 2 ^ T.fmt.sb := by omega
  have hmB : T.fmt.bias - 1 < T.fmt.emax := by omega
  obtain ⟨hms, hmE, hmF, hmM, hmfin, -⟩ := mfEncodeParts T x.signbit (T.fmt.bias - 1) _ hmB hr
  dsimp only
  rw [mfFrexpChar x hx hz]
  dsimp only
  -- |m| as a nonnegative encoded value
  have hmlt : (T.fmt.bias - 1) * 2 ^ T.fmt.sb + (mfNormSig x - 2 ^ T.fmt.sb) < NextProofs.infMag T := by
    unfold NextProofs.infMag
    have : (T.fmt.bias - 1 + 1) * 2 ^ T.fmt.sb ≤ T.fmt.emax * 2 ^ T.fmt.sb :=
      Nat.mul_le_mul_right _ (by omega)
    rw [Nat.succ_mul] at this
    omega
  have habs : fabs (NextProofs.encode T x.signbit ((T.fmt.bias - 1) * 2 ^ T.fmt.sb + (mfNormSig x - 2 ^ T.fmt.sb))) =
      NextProofs.encode T false ((T.fmt.bias - 1) * 2 ^ T.fmt.sb + (mfNormSig x - 2 ^ T.fmt.sb)) := by
    rw [show fabs (T := T) = abs_float from rfl, RemainderProofs.abs_encoded _ hmfin, hmM]
  obtain ⟨han, -, hak⟩ := mfEncodeKeyNonneg T _ hmlt
  have hmk : magKey T.fmt ((T.fmt.bias - 1) * 2 ^ T.fmt.sb + (mfNormSig x - 2 ^ T.fmt.sb)) =
      mfNormSig x * 2 ^ (T.fmt.bias - 2) := by
    rw [mfMagKeyNormal T _ _ (by omega) hr, Nat.sub_add_cancel hc1]
    congr 2
  refine ⟨?_, ?_, ?_⟩
  · rw [habs, mfHalfEncode]
    have hhalf : (T.fmt.bias - 1) * 2 ^ T.fmt.sb < NextProofs.infMag T := by
      unfold NextProofs.infMag; exact Nat.mul_lt_mul_of_pos_right (by omega) hP
    obtain ⟨hhn, -, hhk⟩ := mfEncodeKeyNonneg T _ hhalf
    rw [show fle (T := T) = le_IEEEFloat from rfl, le_IEEEFloat_key _ _ hhn han, hhk, hak, hmk]
    apply decide_eq_true
    have h1 := mfMagKeyNormal T (T.fmt.bias - 1) 0 (by omega) hP
    rw [Nat.add_zero] at h1
    rw [h1, Nat.zero_add]
    have : 2 ^ T.fmt.sb * 2 ^ (T.fmt.bias - 1 - 1) ≤ mfNormSig x * 2 ^ (T.fmt.bias - 2) := by
      rw [show T.fmt.bias - 1 - 1 = T.fmt.bias - 2 by omega]
      exact Nat.mul_le_mul_right _ hc1
    exact_mod_cast this
  · rw [habs, mfFoneEncode]
    have hone : T.fmt.bias * 2 ^ T.fmt.sb < NextProofs.infMag T := by
      unfold NextProofs.infMag; exact Nat.mul_lt_mul_of_pos_right (by omega) hP
    obtain ⟨hon, -, hok⟩ := mfEncodeKeyNonneg T _ hone
    rw [show flt (T := T) = lt_float from rfl]
    show Fl.lt _ _ = true
    rw [Fl.lt_key han hon, hok, hak, hmk]
    apply decide_eq_true
    have h1 := mfMagKeyNormal T T.fmt.bias 0 (by omega) hP
    rw [Nat.add_zero] at h1
    rw [h1, Nat.zero_add]
    have : mfNormSig x * 2 ^ (T.fmt.bias - 2) < 2 ^ T.fmt.sb * 2 ^ (T.fmt.bias - 1) := by
      have hb : 2 ^ (T.fmt.bias - 1) = 2 * 2 ^ (T.fmt.bias - 2) := by
        rw [← Nat.pow_succ']; congr 1; omega
      rw [hb, ← Nat.mul_assoc, Nat.mul_comm (2 ^ T.fmt.sb) 2]
      exact Nat.mul_lt_mul_of_pos_right (by omega) (Nat.two_pow_pos _)
    exact_mod_cast this
  · exact mfLdexpRoundTrip o x hx hz (T.fmt.bias - 1) (by omega) hmB _ (by omega)

/-! ## mathfuncs-significand-range -/

theorem mfSubnormalThreshold (T : FTy) :
    2 ^ T.fmt.width - 1 - exponentMask T - signMask T = 2 ^ T.fmt.sb - 1 := by
  cases T <;> decide

theorem mfSignificandUnfold {T : FTy} (x : FV T) : significand x = (Id.run do
    let xu0 := x.toBits
    let mut xu := xu0
    let xs := withoutBits xu0 (signMask T) T.fmt.width
    if xs >= exponentMask T then return x
    if xs <= 2 ^ T.fmt.width - 1 - exponentMask T - signMask T then
      if xs == 0 then return x
      let m := leadingZeros T.fmt.width xs - T.fmt.eb
      let xs := xs * 2 ^ m
      xu := xs + (if fsignbit x then signMask T else 0)
    xu := withoutBits xu (exponentMask T) T.fmt.width + T.fmt.bias * 2 ^ T.fmt.sb
    return Fl.ofBits xu) := rfl

theorem mfSignificandChar {T : FTy} (x : FV T) (hx : x.isfinite = true) (hz : x.magnitude ≠ 0) :
    significand x =
      NextProofs.encode T x.signbit (T.fmt.bias * 2 ^ T.fmt.sb + (mfNormSig x - 2 ^ T.fmt.sb)) := by
  have hxs : withoutBits x.toBits (signMask T) T.fmt.width = x.magnitude := withoutSignBitMagnitude x
  have hmag := (TruncProofs.isfinite_iff_mag x).1 hx
  have hnm : ¬ (x.magnitude ≥ exponentMask T) := by unfold exponentMask; omega
  obtain ⟨hmd, hfr⟩ := TruncProofs.mag_decomp x
  obtain ⟨hc1, hc2, -, hnorm, hsub⟩ := mfNormSigFacts x hx hz
  rw [mfSignificandUnfold]
  simp only [Id.run, hxs, hnm, Bool.false_eq_true, ↓reduceIte, mfSubnormalThreshold]
  by_cases hB : x.expField = 0
  · have hmf : x.magnitude = x.frac := by rw [hmd, hB]; simp
    have hle : x.magnitude ≤ 2 ^ T.fmt.sb - 1 := by omega
    obtain ⟨-, hclr⟩ := mfSubnormalShift x hx hz hB
    have hz' : (x.magnitude == 0) = false := by simp [hz]
    simp only [hle, ↓reduceIte, hz', Bool.false_eq_true]
    rw [hclr, ← mfEncodeBits]
    show Fl.ofBits _ = Fl.ofBits _
    congr 1
    omega
  · obtain ⟨-, hc⟩ := hnorm hB
    have hle : ¬ (x.magnitude ≤ 2 ^ T.fmt.sb - 1) := by
      have : 1 * 2 ^ T.fmt.sb ≤ x.expField * 2 ^ T.fmt.sb := Nat.mul_le_mul_right _ (by omega)
      omega
    simp only [hle, ↓reduceIte]
    rw [mfClearExp x, hc, Nat.add_sub_cancel, ← mfEncodeBits]
    show Fl.ofBits _ = Fl.ofBits _
    congr 1
    omega

theorem significandRange_proven : SignificandRange := by
  intro T o x hfaith hfinite hzero
  have hx : x.isfinite = true := by
    rw [← JuliaLean.Proofs.base.float.isfinite_IEEEFloat_eq x]; exact hfinite
  have hz : x.magnitude ≠ 0 := by
    have : x.iszero = false := by simpa [fiszero, iszero_float_eq] using hzero
    simpa [Fl.iszero] using this
  have hg := good_fty T
  have hfb := mfFmtBounds T
  have hemax := hg.emax_eq
  have hbias := hg.bias_pos
  have hP := Nat.two_pow_pos T.fmt.sb
  obtain ⟨hc1, hc2, -, -, -⟩ := mfNormSigFacts x hx hz
  have hpow : 2 ^ (T.fmt.sb + 1) = 2 * 2 ^ T.fmt.sb := by rw [Nat.pow_succ, Nat.mul_comm]
  have hr : mfNormSig x - 2 ^ T.fmt.sb < 2 ^ T.fmt.sb := by omega
  have hmB : T.fmt.bias < T.fmt.emax := by omega
  obtain ⟨hms, -, -, hmM, hmfin, -⟩ := mfEncodeParts T x.signbit T.fmt.bias _ hmB hr
  have hmlt : T.fmt.bias * 2 ^ T.fmt.sb + (mfNormSig x - 2 ^ T.fmt.sb) < NextProofs.infMag T := by
    unfold NextProofs.infMag
    have : (T.fmt.bias + 1) * 2 ^ T.fmt.sb ≤ T.fmt.emax * 2 ^ T.fmt.sb :=
      Nat.mul_le_mul_right _ (by omega)
    rw [Nat.succ_mul] at this
    omega
  have habs : fabs (significand x) =
      NextProofs.encode T false (T.fmt.bias * 2 ^ T.fmt.sb + (mfNormSig x - 2 ^ T.fmt.sb)) := by
    rw [mfSignificandChar x hx hz, show fabs (T := T) = abs_float from rfl,
      RemainderProofs.abs_encoded _ hmfin, hmM]
  obtain ⟨han, -, hak⟩ := mfEncodeKeyNonneg T _ hmlt
  have hmk : magKey T.fmt (T.fmt.bias * 2 ^ T.fmt.sb + (mfNormSig x - 2 ^ T.fmt.sb)) =
      mfNormSig x * 2 ^ (T.fmt.bias - 1) := by
    rw [mfMagKeyNormal T _ _ (by omega) hr, Nat.sub_add_cancel hc1]
  refine ⟨?_, ?_, ?_, ?_⟩
  · show signbit_float (significand x) = signbit_float x
    rw [signbit_float_eq, signbit_float_eq, mfSignificandChar x hx hz, hms]
  · rw [habs, mfFoneEncode]
    have hone : T.fmt.bias * 2 ^ T.fmt.sb < NextProofs.infMag T := by
      unfold NextProofs.infMag; exact Nat.mul_lt_mul_of_pos_right (by omega) hP
    obtain ⟨hon, -, hok⟩ := mfEncodeKeyNonneg T _ hone
    rw [show fle (T := T) = le_IEEEFloat from rfl, le_IEEEFloat_key _ _ hon han, hok, hak, hmk]
    apply decide_eq_true
    have h1 := mfMagKeyNormal T T.fmt.bias 0 (by omega) hP
    rw [Nat.add_zero] at h1
    rw [h1, Nat.zero_add]
    exact_mod_cast Nat.mul_le_mul_right _ hc1
  · rw [habs, mfOfIntTwoEncode]
    have htwo : (T.fmt.bias + 1) * 2 ^ T.fmt.sb < NextProofs.infMag T := by
      unfold NextProofs.infMag; exact Nat.mul_lt_mul_of_pos_right (by omega) hP
    obtain ⟨htn, -, htk⟩ := mfEncodeKeyNonneg T _ htwo
    rw [show flt (T := T) = lt_float from rfl]
    show Fl.lt _ _ = true
    rw [Fl.lt_key han htn, htk, hak, hmk]
    apply decide_eq_true
    have h1 := mfMagKeyNormal T (T.fmt.bias + 1) 0 (by omega) hP
    rw [Nat.add_zero] at h1
    rw [h1, Nat.zero_add, Nat.add_sub_cancel]
    have : mfNormSig x * 2 ^ (T.fmt.bias - 1) < 2 ^ T.fmt.sb * 2 ^ T.fmt.bias := by
      have hb : 2 ^ T.fmt.bias = 2 * 2 ^ (T.fmt.bias - 1) := by
        rw [← Nat.pow_succ']; congr 1; omega
      rw [hb, ← Nat.mul_assoc, Nat.mul_comm (2 ^ T.fmt.sb) 2]
      exact Nat.mul_lt_mul_of_pos_right (by omega) (Nat.two_pow_pos _)
    exact_mod_cast this
  · refine ⟨exponentFiniteNonzero x, mfExponentFloatValue x hfinite hzero, ?_⟩
    have hlog := mfExponentLog x hx hz
    rw [mfSignificandChar x hx hz]
    exact mfLdexpRoundTrip o x hx hz T.fmt.bias hbias hmB _ (by omega)

end MathfuncsProofs

