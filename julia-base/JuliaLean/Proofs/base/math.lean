  let j : Nat := if x.expField = 0 then T.fmt.bias + T.fmt.sb - 1
    else T.fmt.bias + T.fmt.sb - x.expField
  have hden : JuliaLean.Proofs.base.float.TruncProofs.denominator (fabs x) = 2 ^ j := by
    simp [j, JuliaLean.Proofs.base.float.TruncProofs.denominator, hAbsExp]
  have hrat : (fabs x).toRat = ((n : Int), 2 ^ j) := by
    simpa [n, hAbsSign, hden] using
      JuliaLean.Proofs.base.float.TruncProofs.rat_parts (fabs x) hAbsFinite
  have hmagParts := JuliaLean.Proofs.base.float.TruncProofs.mag_decomp x
  have hfracPos : x.frac < 2 ^ T.fmt.sb := hmagParts.2
  have hdiv : x.magnitude / 2 ^ T.fmt.sb = x.expField :=
    (JuliaLean.Promotion.Fl.expField_eq x).symm
  have hxs : withoutBits x.toBits (signMask T) T.fmt.width = x.magnitude :=
    JuliaLean.base.math.withoutSignBitMagnitude x
  have hN : n ≠ 0 := by
    by_cases hraw : x.expField = 0
    · have hmagFrac : x.magnitude = x.frac := by
        rw [hmagParts.1, hraw]
        simp
      have hfrac : x.frac ≠ 0 := by rw [← hmagFrac]; exact hxMag
      have hn : n = x.frac := by
        simp [n, JuliaLean.Proofs.base.float.TruncProofs.numerator,
          JuliaLean.Proofs.base.float.TruncProofs.mantissaNat, hAbsExp, hAbsFrac, hraw]
      rw [hn]
      exact hfrac
    · have hpowPos : 0 < 2 ^ T.fmt.sb := Nat.two_pow_pos _
      have hm : 0 < x.frac + 2 ^ T.fmt.sb := by omega
      have hn : n = (x.frac + 2 ^ T.fmt.sb) *
          2 ^ (x.expField - (T.fmt.bias + T.fmt.sb)) := by
        simp [n, JuliaLean.Proofs.base.float.TruncProofs.numerator,
          JuliaLean.Proofs.base.float.TruncProofs.mantissaNat, hAbsExp, hAbsFrac, hraw]
      rw [hn]
      exact Nat.ne_of_gt (Nat.mul_pos hm (Nat.two_pow_pos _))
  have hExponent : exponentFiniteNonzero x = (n.log2 : Int) - j := by
    by_cases hraw : x.expField = 0
    · have hmagFrac : x.magnitude = x.frac := by
        rw [hmagParts.1, hraw]
        simp
      have hfrac : 0 < x.frac := by rw [← hmagFrac]; omega
      have hlog : x.frac.log2 < T.fmt.sb :=
        (Nat.log2_lt (by omega : x.frac ≠ 0)).2 hfracPos
      have hwidth : T.fmt.width = T.fmt.eb + T.fmt.sb + 1 := by
        simp [JuliaLean.Promotion.Fmt.width]
        omega
      have hleading :
          leadingZeros T.fmt.width x.magnitude - T.fmt.eb =
            T.fmt.sb - x.frac.log2 := by
        rw [hmagFrac]
        unfold leadingZeros
        simp only [if_neg (by omega : x.frac ≠ 0), hwidth]
        have hlog : x.frac.log2 < T.fmt.sb :=
          (Nat.log2_lt (by omega : x.frac ≠ 0)).2 hfracPos
        omega
      have hn : n = x.frac := by
        simp [n, JuliaLean.Proofs.base.float.TruncProofs.numerator,
          JuliaLean.Proofs.base.float.TruncProofs.mantissaNat, hAbsExp, hAbsFrac, hraw]
      have hj : j = T.fmt.bias + T.fmt.sb - 1 := by simp [j, hraw]
      have he : exponentFiniteNonzero x =
          (x.frac.log2 : Int) - (T.fmt.bias + T.fmt.sb - 1) := by
        unfold exponentFiniteNonzero
        change
          (let xs := withoutBits x.toBits (signMask T) T.fmt.width
           let k : Int := (xs / 2 ^ T.fmt.sb : Nat)
           if k == 0 then
             let m := leadingZeros T.fmt.width xs - T.fmt.eb
             (1 - (m : Int)) - T.fmt.bias
           else k - T.fmt.bias) =
            (x.frac.log2 : Int) - (T.fmt.bias + T.fmt.sb - 1)
        dsimp only
        rw [hxs, hdiv]
        simp [hraw, hleading]
        omega
      have hbs : 1 ≤ T.fmt.bias + T.fmt.sb := by
        have hb := (JuliaLean.Proofs.base.float.good_fty T).bias_pos
        omega
      rw [he, hn, hj]
      omega
    · let m := x.frac + 2 ^ T.fmt.sb
      have hm0 : m ≠ 0 := by
        dsimp [m]
        omega
      have hpow : 2 ^ (T.fmt.sb + 1) = 2 ^ T.fmt.sb * 2 := by
        rw [Nat.pow_succ]
      have hmlo : 2 ^ T.fmt.sb ≤ m := by
        dsimp [m]
        omega
      have hmhi : m < 2 ^ (T.fmt.sb + 1) := by
        dsimp [m]
        rw [hpow]
        omega
      have hmlog : m.log2 = T.fmt.sb := by
        apply Nat.le_antisymm
        · have := (Nat.log2_lt hm0).2 hmhi
          omega
        · exact (Nat.le_log2 hm0).2 hmlo
      have heRaw : exponentFiniteNonzero x =
          (x.expField : Int) - T.fmt.bias := by
        unfold exponentFiniteNonzero
        change
          (let xs := withoutBits x.toBits (signMask T) T.fmt.width
           let k : Int := (xs / 2 ^ T.fmt.sb : Nat)
           if k == 0 then
             let m := leadingZeros T.fmt.width xs - T.fmt.eb
             (1 - (m : Int)) - T.fmt.bias
           else k - T.fmt.bias) =
            (x.expField : Int) - T.fmt.bias
        dsimp only
        rw [hxs, hdiv]
        simp [hraw]
      by_cases hle : x.expField ≤ T.fmt.bias + T.fmt.sb
      · have hn : n = m := by
          simp [n, m, JuliaLean.Proofs.base.float.TruncProofs.numerator,
            JuliaLean.Proofs.base.float.TruncProofs.mantissaNat, hAbsExp, hAbsFrac,
            hraw, Nat.sub_eq_zero_of_le hle]
        have hj : j = T.fmt.bias + T.fmt.sb - x.expField := by simp [j, hraw]
        rw [heRaw, hn, hj, hmlog]
        omega
      · have hn : n = m * 2 ^ (x.expField - (T.fmt.bias + T.fmt.sb)) := by
          simp [n, m, JuliaLean.Proofs.base.float.TruncProofs.numerator,
            JuliaLean.Proofs.base.float.TruncProofs.mantissaNat, hAbsExp, hAbsFrac,
            hraw]
        have hthreshold : T.fmt.bias + T.fmt.sb ≤ x.expField := by omega
        have hj : j = 0 := by
          simp [j, hraw, Nat.sub_eq_zero_of_le hthreshold]
        have hlogn : n.log2 =
            m.log2 + (x.expField - (T.fmt.bias + T.fmt.sb)) := by
          rw [hn, JuliaLean.Promotion.Fl.log2_mul_pow m
            (x.expField - (T.fmt.bias + T.fmt.sb)) hm0]
        rw [heRaw, hj, hlogn, hmlog]
        omega
  dsimp only
  rw [hrat, hExponent]
  exact qPowTwoRangeDyadic n j hN


theorem minmaxNan_proven : MinmaxNan := by
  intro T o x y hfaith hnan
  rcases hfaith with ⟨_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, hminFn, hmaxFn⟩
  have hnan' : x.isnan = true ∨ y.isnan = true := by
    simpa [fisnan, JuliaLean.Proofs.base.float.isnan_callee_eq] using hnan
  have hsub := (JuliaLean.Proofs.base.float.floatArithmeticAndNanPropagation_proven
    T x y x).2.1 hnan'
  rcases hsub with ⟨_, hsub, _, _, _⟩
  have hsubEq : JuliaLean.base.float.sub_IEEEFloat x y =
      JuliaLean.C.floatSub x y := by
    unfold JuliaLean.base.float.sub_IEEEFloat JuliaLean.base.float.sub_float
      JuliaLean.C.jlSubFloat
    exact JuliaLean.Proofs.base.float.finishFloat_eq _
  have hdiff : (JuliaLean.C.floatSub x y).isnan = true := by
    rw [← hsubEq]
    exact hsub
  have hminNan : (JuliaLean.C.jlMinFloat x y).isnan = true := by
    unfold JuliaLean.C.jlMinFloat
    rw [JuliaLean.Proofs.base.float.finishFloat_eq]
    rcases hnan' with hx | hy
    · simp [hx, hdiff]
    · simp [hy, hdiff]
  have hmaxNan : (JuliaLean.C.jlMaxFloat x y).isnan = true := by
    unfold JuliaLean.C.jlMaxFloat
    rw [JuliaLean.Proofs.base.float.finishFloat_eq]
    rcases hnan' with hx | hy
    · simp [hx, hdiff]
    · simp [hy, hdiff]
  constructor
  · simpa [minmaxGeneric, minIEEE, fisnan,
      JuliaLean.Proofs.base.float.isnan_callee_eq, hminFn x y] using hminNan
  · simpa [minmaxGeneric, maxIEEE, fisnan,
      JuliaLean.Proofs.base.float.isnan_callee_eq, hmaxFn x y] using hmaxNan

private theorem unsignedValueToNatBound {t : IntTy} (x : JInt t)
    (ht : t.signed = false) : x.val.toNat < 2 ^ t.bits := by
  have hnonneg : 0 ≤ x.val := by
    simpa [IntTy.min, ht] using x.property.1
  have hmax : x.val ≤ (2 ^ t.bits : Int) - 1 := by
    simpa [IntTy.max, ht] using x.property.2
  have hcast : (x.val.toNat : Int) = x.val := Int.toNat_of_nonneg hnonneg
  have hlt : (x.val.toNat : Int) < (2 ^ t.bits : Int) := by
    rw [hcast]
    omega
  exact_mod_cast hlt

private theorem unsignedWrapToNat {t : IntTy} (ht : t.signed = false)
    (n : Nat) (hn : n < 2 ^ t.bits) :
    (JInt.wrap t (n : Int)).val.toNat = n := by
  have hnInt : (n : Int) < (2 ^ t.bits : Int) := by exact_mod_cast hn
  have hmin : t.min ≤ (n : Int) := by simpa [IntTy.min, ht]
  have hmax : (n : Int) ≤ t.max := by
    have h : (n : Int) ≤ (2 ^ t.bits : Int) - 1 := by omega
    simpa [IntTy.max, ht] using h
  change (wrapInt t (n : Int)).toNat = n
  rw [wrapInt_of_inRange t _ ⟨hmin, hmax⟩]
  simp

private theorem float64BitsBound (x : FV .f64) : x.toBits < 2 ^ 64 := by
  have h := x.bits.isLt
  change x.toBits < 2 ^ JuliaLean.base.float.FTy.f64.fmt.width at h
  have hw : JuliaLean.base.float.FTy.f64.fmt.width = 64 := by decide
  simpa [hw] using h

private theorem float32BitsBound (x : FV .f32) : x.toBits < 2 ^ 32 := by
  have h := x.bits.isLt
  change x.toBits < 2 ^ JuliaLean.base.float.FTy.f32.fmt.width at h
  have hw : JuliaLean.base.float.FTy.f32.fmt.width = 32 := by decide
  simpa [hw] using h

private theorem highwordUInt64Val (x : JInt .u64) :
    (highwordUInt64 x).val.toNat = x.val.toNat / 2 ^ 32 := by
  unfold highwordUInt64
  apply unsignedWrapToNat (t := .u32) (by decide)
  have hx : x.val.toNat < 2 ^ 32 * 2 ^ 32 := by
    have h := unsignedValueToNatBound x (by decide)
    simpa [IntTy.bits, show 2 ^ 32 * 2 ^ 32 = 2 ^ 64 by decide] using h
  rw [Nat.div_lt_iff_lt_mul (by decide : 0 < 2 ^ 32)]
  exact hx

private theorem poshighwordUInt64Val (x : JInt .u64) :
    (poshighwordUInt64 x).val.toNat =
      (x.val.toNat / 2 ^ 32) % 2 ^ 31 := by
  have hland : Nat.land (x.val.toNat / 2 ^ 32) (2 ^ 31 - 1) =
      (x.val.toNat / 2 ^ 32) % 2 ^ 31 := by
    exact Nat.and_two_pow_sub_one_eq_mod (x.val.toNat / 2 ^ 32) 31
  unfold poshighwordUInt64
  rw [hland]
  apply unsignedWrapToNat (t := .u32) (by decide)
  exact Nat.lt_of_lt_of_le
    (Nat.mod_lt _ (by decide)) (by decide)

private theorem highword64Val (x : FV .f64) :
    (highword64 x).val.toNat = x.toBits / 2 ^ 32 := by
  unfold highword64
  rw [highwordUInt64Val]
  rw [unsignedWrapToNat (t := .u64) (by decide) x.toBits (float64BitsBound x)]

private theorem poshighword64Val (x : FV .f64) :
    (poshighword64 x).val.toNat =
      (x.toBits / 2 ^ 32) % 2 ^ 31 := by
  unfold poshighword64
  rw [poshighwordUInt64Val]
  rw [unsignedWrapToNat (t := .u64) (by decide) x.toBits (float64BitsBound x)]

private theorem highword32Val (x : FV .f32) :
    (highword32 x).val.toNat = x.toBits := by
  unfold highword32
  exact unsignedWrapToNat (t := .u32) (by decide) x.toBits (float32BitsBound x)

private theorem poshighword32Val (x : FV .f32) :
    (poshighword32 x).val.toNat = x.toBits % 2 ^ 31 := by
  unfold poshighword32
  rw [show 0x7fffffff = 2 ^ 31 - 1 by decide]
  have hland : Nat.land x.toBits (2 ^ 31 - 1) = x.toBits % 2 ^ 31 := by
    exact Nat.and_two_pow_sub_one_eq_mod _ _
  change (JInt.wrap .u32
      ((Nat.land x.toBits (2 ^ 31 - 1) : Nat) : Int)).val.toNat =
    x.toBits % 2 ^ 31
  rw [hland]
  apply unsignedWrapToNat (t := .u32) (by decide)
  exact Nat.lt_of_lt_of_le
    (Nat.mod_lt _ (by decide)) (by decide)

theorem highWordRoundTrips_proven : HighWordRoundTrips := by
  constructor
  · intro x
    exact ⟨highwordUInt64Val x, poshighwordUInt64Val x⟩
  constructor
  · intro x
    let u := highword64 x
    have hu : u.val.toNat < 2 ^ 32 :=
      unsignedValueToNatBound u (by decide)
    have hprod : u.val.toNat * 2 ^ 32 < 2 ^ 64 := by
      have h := Nat.mul_lt_mul_of_pos_right hu (by decide : 0 < 2 ^ 32)
      simpa [IntTy.bits, show 2 ^ 32 * 2 ^ 32 = 2 ^ 64 by decide] using h
    have hbits : (fromhighword64 u).toBits = u.val.toNat * 2 ^ 32 := by
      unfold fromhighword64
      rw [Fl.toBits_ofBits,
        show JuliaLean.base.float.FTy.f64.fmt.width = 64 by decide,
        Nat.mod_eq_of_lt hprod]
    constructor
    · change (highword64 (fromhighword64 u)).val.toNat = u.val.toNat
      rw [highword64Val, hbits]
      exact Nat.mul_div_cancel _ (by decide)
    constructor
    · rw [hbits]
      exact Nat.mul_mod_left _ _
    · rw [poshighword64Val, highword64Val]
  · intro x
    constructor
    · apply Fin.ext
      change (fromhighword32 (highword32 x)).toBits = x.toBits
      rw [fromhighword32, Fl.toBits_ofBits,
        show JuliaLean.base.float.FTy.f32.fmt.width = 32 by decide,
        highword32Val]
      exact Nat.mod_eq_of_lt (float32BitsBound x)
    · exact poshighword32Val x

