/-- Finite numerator in the second software-correction branch. The branch
condition sharpens h≤5a/4, keeping every actual intermediate below overflow. -/
theorem early_software_second_numerator_finite (a b h : FV .f64)
    (ha : early_box 512 a) (hb : early_box 512 b) (hh : early_box 512 h)
    (hsa : a.signbit = false) (hsb : b.signbit = false) (hsh : h.signbit = false)
