theorem early_round_normal_scale (n j sb : Nat) (hn : n ≠ 0) :
    let k := ((n.log2 : Int) - j) - sb
    let scaled := if k ≥ 0 then (n, 2 ^ j * 2 ^ k.toNat)
      else (n * 2 ^ (-k).toNat, 2 ^ j)
    0 < scaled.2 ∧ 2 ^ sb * scaled.2 ≤ scaled.1 ∧
      scaled.1 < 2 ^ (sb + 1) * scaled.2 := by
  let k := ((n.log2 : Int) - j) - sb
  have hlo := Nat.log2_self_le hn
  have hhi : n < 2 ^ (n.log2 + 1) := Nat.lt_log2_self
  change let scaled := if k ≥ 0 then (n, 2 ^ j * 2 ^ k.toNat)
    else (n * 2 ^ (-k).toNat, 2 ^ j); _
  dsimp only
  split
  · rename_i hk
    dsimp only
    have he : sb + (j + k.toNat) = n.log2 := by dsimp [k] at hk ⊢; omega
    refine ⟨Nat.mul_pos (Nat.two_pow_pos _) (Nat.two_pow_pos _), ?_, ?_⟩
    · calc
        2 ^ sb * (2 ^ j * 2 ^ k.toNat) = 2 ^ (sb + (j + k.toNat)) := by rw [← Nat.pow_add, ← Nat.pow_add]
        _ = 2 ^ n.log2 := by rw [he]
        _ ≤ n := hlo
    · calc
        n < 2 ^ (n.log2 + 1) := hhi
        _ = 2 ^ ((sb + 1) + (j + k.toNat)) := by congr 1; omega
        _ = 2 ^ (sb + 1) * (2 ^ j * 2 ^ k.toNat) := by simp only [Nat.pow_add]
  · rename_i hk
    dsimp only
    have he : sb + j = n.log2 + (-k).toNat := by dsimp [k] at hk ⊢; omega
    refine ⟨Nat.two_pow_pos _, ?_, ?_⟩
    · calc
        2 ^ sb * 2 ^ j = 2 ^ (sb + j) := by rw [Nat.pow_add]
        _ = 2 ^ (n.log2 + (-k).toNat) := by rw [he]
        _ = 2 ^ n.log2 * 2 ^ (-k).toNat := by rw [Nat.pow_add]
        _ ≤ n * 2 ^ (-k).toNat := Nat.mul_le_mul_right _ hlo
    · calc
        n * 2 ^ (-k).toNat < 2 ^ (n.log2 + 1) * 2 ^ (-k).toNat :=
          Nat.mul_lt_mul_of_pos_right hhi (Nat.two_pow_pos _)
        _ = 2 ^ (n.log2 + 1 + (-k).toNat) := by simp only [Nat.pow_add]
        _ = 2 ^ ((sb + 1) + j) := by congr 1; omega
        _ = 2 ^ (sb + 1) * 2 ^ j := by rw [Nat.pow_add]

theorem early_round_normal_quotient (n d sb : Nat) (hd : 0 < d)
    (hlo : 2 ^ sb * d ≤ n) (hhi : n < 2 ^ (sb + 1) * d) :
    2 ^ sb ≤ Fl.roundQuotient n d ∧ Fl.roundQuotient n d ≤ 2 ^ (sb + 1) := by
  have hdivlo : 2 ^ sb ≤ n / d := (Nat.le_div_iff_mul_le hd).mpr hlo
  have hdivhi : n / d < 2 ^ (sb + 1) := (Nat.div_lt_iff_lt_mul hd).mpr hhi
  have hround := roundQuotient_floor_bounds n d
  omega

/-- Normal rounded significands have a directly bounded magnitude encoding,
including a carry from the largest finite exponent to infinity. -/
theorem early_round_pack_normal (T : FTy) (q B : Nat)
    (hlo : 2 ^ T.fmt.sb ≤ q) (hhi : q ≤ 2 ^ (T.fmt.sb + 1))
    (hB : 1 ≤ B) (hBhi : B < T.fmt.emax) :
    (Fl.packRounded false q ((B : Int) - T.fmt.bias - T.fmt.sb) : FV T) =
      NextProofs.encode T false (B * 2 ^ T.fmt.sb + (q - 2 ^ T.fmt.sb)) := by
  let P := 2 ^ T.fmt.sb
  have hp := Nat.two_pow_pos T.fmt.sb
  have hcap : 2 ^ (T.fmt.sb + 1) = 2 * P := by rw [Nat.pow_succ, Nat.mul_comm]
  by_cases hq : q < 2 ^ (T.fmt.sb + 1)
  · have hpack := JuliaLean.Proofs.base.math.mfPackRoundedEncode T false q B (by omega) hq hB hBhi
    rw [hpack, ite_eq_right (by omega)]
  · have heq : q = 2 * P := by rw [hcap] at hhi hq; omega
    have hP0 : P ≠ 0 := Nat.ne_of_gt hp
    have hP2 : (2 * P) / 2 = P := by rw [Nat.mul_comm, Nat.mul_div_cancel _ (by decide : 0 < 2)]
    have he : (B : Int) - T.fmt.bias - T.fmt.sb + 1 + T.fmt.bias + T.fmt.sb = B + 1 := by omega
    have henc : B * P + (q - P) = (B + 1) * P := by rw [Nat.add_mul, Nat.one_mul]; omega
    change (Fl.packRounded false q ((B : Int) - T.fmt.bias - T.fmt.sb) : FV T) =
      NextProofs.encode T false (B * P + (q - P))
    rw [henc]
    simp only [Fl.packRounded, heq, hcap, Nat.mul_eq_zero, hP0, Nat.succ_ne_zero,
      beq_iff_eq, or_self, ↓reduceIte, Nat.le_refl, hP2, he]
    by_cases hlast : B + 1 = T.fmt.emax
    · have hlastInt : (B : Int) + 1 ≥ T.fmt.emax := by omega
      rw [ite_eq_left hlastInt, hlast]
      exact (EpsilonNeighborProofs.encode_infinity T false).symm
    · have hehi : ¬(B : Int) + 1 ≥ T.fmt.emax := by omega
      simp only [hehi, ↓reduceIte]
      simp only [show ¬P < 2 ^ T.fmt.sb from Nat.lt_irrefl _, ↓reduceIte]
      have hBnat : ((B : Int) + 1).toNat = B + 1 := by omega
      simp only [P, NextProofs.encode, Bool.false_eq_true, ↓reduceIte,
        Nat.zero_add, Nat.sub_self, Nat.add_zero, hBnat]

/-- Rounding a positive dyadic with a normal-range exponent lies between the
two adjacent powers of two in its magnitude encoding. -/
theorem early_round_normal_magnitude_bounds (T : FTy) (n j : Nat) (hn : n ≠ 0)
    (hlo : 1 - (T.fmt.bias : Int) ≤ (n.log2 : Int) - j)
    (hhi : (n.log2 : Int) - j < (T.fmt.emax : Int) - T.fmt.bias) :
    let B := ((n.log2 : Int) - j + T.fmt.bias).toNat
    let r : FV T := Fl.roundRat n (2 ^ j) false
    B * 2 ^ T.fmt.sb ≤ r.magnitude ∧ r.magnitude ≤ (B + 1) * 2 ^ T.fmt.sb ∧
      r.signbit = false ∧ r.isnan = false := by
  let e := (n.log2 : Int) - j
  let k := e - T.fmt.sb
  let B := (e + T.fmt.bias).toNat
  let scaled := if k ≥ 0 then (n, 2 ^ j * 2 ^ k.toNat)
      else (n * 2 ^ (-k).toNat, 2 ^ j)
  let q := Fl.roundQuotient scaled.1 scaled.2
  have hB : 1 ≤ B := by dsimp [B, e]; omega
  have hBhi : B < T.fmt.emax := by dsimp [B, e]; omega
  have hsc := early_round_normal_scale n j T.fmt.sb hn
  change 0 < scaled.2 ∧ _ at hsc
  have hq := early_round_normal_quotient scaled.1 scaled.2 T.fmt.sb hsc.1 hsc.2.1 hsc.2.2
  change 2 ^ T.fmt.sb ≤ q ∧ q ≤ 2 ^ (T.fmt.sb + 1) at hq
  have hnorm : (Fl.roundRat n (2 ^ j) false : FV T) = Fl.packRounded false q k := by
    have hn' : ¬((n : Int) = 0) := by omega
    have hE := Fl.floorLog2Rat_pow n j hn
    have hmax : max (e - T.fmt.sb) (1 - (T.fmt.bias : Int) - T.fmt.sb) = e - T.fmt.sb := by
      dsimp [e]
      omega
    have hlower : ¬ e < -((T.fmt.bias : Int) + T.fmt.sb) - 1 := by dsimp [e]; omega
    simp only [Fl.roundRat, show (2 ^ j == 0) = false from beq_eq_false_iff_ne.mpr (Nat.ne_of_gt (Nat.two_pow_pos _)),
      beq_eq_false_iff_ne.mpr hn', Int.natAbs_natCast, Bool.false_eq_true, ↓reduceIte, hE,
      show ¬(n : Int) < 0 by omega]
    change (if e ≥ (T.fmt.emax : Int) - T.fmt.bias then _ else if e < -((T.fmt.bias : Int) + T.fmt.sb) - 1 then _ else _) = _
    rw [ite_eq_right (by exact Int.not_le.mpr hhi), ite_eq_right hlower, hmax]
    rfl
  have hkrepr : k = (B : Int) - T.fmt.bias - T.fmt.sb := by dsimp [B, k, e]; omega
  rw [hkrepr, early_round_pack_normal T q B hq.1 hq.2 hB hBhi] at hnorm
  have hcap : 2 ^ (T.fmt.sb + 1) = 2 * 2 ^ T.fmt.sb := by rw [Nat.pow_succ, Nat.mul_comm]
  have hmagHi : B * 2 ^ T.fmt.sb + (q - 2 ^ T.fmt.sb) ≤ NextProofs.infMag T := by
    have hstep := Nat.mul_le_mul_right (2 ^ T.fmt.sb) (show B + 1 ≤ T.fmt.emax by omega)
    rw [Nat.add_mul, Nat.one_mul] at hstep
    change _ ≤ T.fmt.emax * 2 ^ T.fmt.sb
    rw [hcap] at hq
    omega
  have hmagSign : B * 2 ^ T.fmt.sb + (q - 2 ^ T.fmt.sb) < NextProofs.signMask T :=
    Nat.lt_of_le_of_lt hmagHi (NextProofs.infMag_lt_signMask T)
  change B * 2 ^ T.fmt.sb ≤ (Fl.roundRat n (2 ^ j) false : FV T).magnitude ∧ _
  rw [hnorm, NextProofs.mag_encode T false hmagSign, NextProofs.sign_encode T false hmagSign]
  refine ⟨by omega, ?_, rfl, ?_⟩
  · change B * 2 ^ T.fmt.sb + (q - 2 ^ T.fmt.sb) ≤ (B + 1) * 2 ^ T.fmt.sb
    rw [Nat.add_mul, Nat.one_mul]
    rw [hcap] at hq
    omega
  · apply Bool.eq_false_iff.mpr
    intro hnan
    have hnmag := (TruncProofs.isnan_iff_mag _).mp hnan
    rw [NextProofs.mag_encode T false hmagSign] at hnmag
    exact (Nat.not_lt_of_ge hmagHi) hnmag

/-- Exact positive normal decomposition, retaining its stored exponent. -/
theorem early_cutoff_normal_rat (a : FV .f64) (ha : a.isfinite = true)
    (hs : a.signbit = false) (hE : 1 ≤ a.expField) :
    ∃ i j : Nat, a.toRat = ((((a.frac + 2 ^ 52) * 2 ^ i : Nat) : Int), 2 ^ j) ∧
      (i : Int) - j = (a.expField : Int) - 1075 := by
  let p : Int := (a.expField : Int) - 1023 - 52
  have hE0 : (a.expField == 0) = false := beq_eq_false_iff_ne.mpr (by omega)
  simp only [Fl.toRat, ha, Bool.not_true, Bool.false_eq_true, ↓reduceIte, hs, hE0]
  change ∃ i j : Nat,
    (if p ≥ 0 then (((a.frac + 2 ^ 52 : Nat) : Int) * ((2 ^ p.toNat : Nat) : Int), 1)
      else (((a.frac + 2 ^ 52 : Nat) : Int), 2 ^ (-p).toNat)) =
      ((((a.frac + 2 ^ 52) * 2 ^ i : Nat) : Int), 2 ^ j) ∧ _
  by_cases hp : p ≥ 0
  · refine ⟨p.toNat, 0, ?_, ?_⟩
    · simp only [hp, ↓reduceIte, Nat.pow_zero, Int.natCast_mul]
    · dsimp [p] at hp ⊢
      omega
  · refine ⟨0, (-p).toNat, ?_, ?_⟩
    · simp only [hp, ↓reduceIte, Nat.pow_zero, Nat.mul_one]
    · dsimp [p] at hp ⊢
      omega

/-- Multiplying by the source cutoff cannot fall below2^-511 when the
first operand is at least2^-484. This controls the small-input scaling branch. -/
theorem early_hypot_cutoff_lower (a : FV .f64) (ha : a.isfinite = true)
    (hs : a.signbit = false) (hE : 539 ≤ a.expField) :
    let r := mul a (Fl.ofBits 0x3e46a09e667f3bcd)
    r.isfinite = true ∧ r.signbit = false ∧ 512 * 2 ^ 52 ≤ r.magnitude := by
  let C : FV .f64 := Fl.ofBits 0x3e46a09e667f3bcd
  have hC : C.isfinite = true ∧ C.signbit = false ∧ C.toRat = (6369051672525773, 2 ^ 79) := by decide
  obtain ⟨i, j, hrat, hij⟩ := early_cutoff_normal_rat a ha hs (by omega)
  let m := a.frac + 2 ^ 52
  let c := 6369051672525773
  let N := m * c * 2 ^ i
  have hmc0 : 0 < m * c := Nat.mul_pos (by dsimp [m]; omega) (by decide)
  have hN : N ≠ 0 := Nat.mul_ne_zero (Nat.ne_of_gt hmc0) (Nat.ne_of_gt (Nat.two_pow_pos i))
  have hmlo : 2 ^ 52 ≤ m := by dsimp [m]; omega
  have hmhi : m < 2 ^ 53 := by
    have hf := (TruncProofs.mag_decomp a).2
    change a.frac < 2 ^ 52 at hf
    dsimp [m]
    omega
  have hmcLo : 2 ^ 104 ≤ m * c := by
    have h := Nat.mul_le_mul hmlo (by decide : 2 ^ 52 ≤ c)
    change 2 ^ 52 * 2 ^ 52 ≤ m * c at h
    simpa only [← Nat.pow_add] using h
  have hmcHi : m * c < 2 ^ 106 := by
    have h1 := Nat.mul_lt_mul_of_pos_right hmhi (by decide : 0 < c)
    have h2 := Nat.mul_lt_mul_of_pos_left (by decide : c < 2 ^ 53) (Nat.two_pow_pos 53)
    have h := Nat.lt_trans h1 h2
    simpa only [← Nat.pow_add] using h
  have hloglo : 104 ≤ (m * c).log2 := (Nat.le_log2 (Nat.ne_of_gt hmc0)).mpr hmcLo
  have hloghi : (m * c).log2 < 106 := (Nat.log2_lt (Nat.ne_of_gt hmc0)).mpr hmcHi
  have hlogN : N.log2 = (m * c).log2 + i := Fl.log2_mul_pow (m * c) i (Nat.ne_of_gt hmc0)
  have hEhi := RemainderProofs.finite_exp_lt a ha
  change a.expField < 2047 at hEhi
  have hlow : -511 ≤ (N.log2 : Int) - (j + 79) := by rw [hlogN]; omega
  have hhigh : (N.log2 : Int) - (j + 79) ≤ 997 := by rw [hlogN]; omega
  have hrun : mul a C = (Fl.roundRat N (2 ^ (j + 79)) false : FV .f64) := by
    change mul_float a C = _
    rw [JuliaLean.Proofs.base.math.mfMulRat a C ha hC.1, hrat, hC.2.2, hs, hC.2.1]
    dsimp only
    simp only [bne_self_eq_false, ← Nat.pow_add]
    congr 1
    dsimp only [N, m, c]
    simp only [Int.natCast_mul, show ((6369051672525773 : Nat) : Int) = 6369051672525773 from rfl]
    ac_rfl
  have hb := early_round_normal_magnitude_bounds .f64 N (j + 79) hN
    (by change -1022 ≤ _; omega) (by change _ < 1024; omega)
  let B := ((N.log2 : Int) - (j + 79) + 1023).toNat
  change B * 2 ^ 52 ≤ (Fl.roundRat N (2 ^ (j + 79)) false : FV .f64).magnitude ∧
    (Fl.roundRat N (2 ^ (j + 79)) false : FV .f64).magnitude ≤ (B + 1) * 2 ^ 52 ∧ _ at hb
  have hBlo : 512 ≤ B := by dsimp [B]; omega
  have hBhi : B + 1 < 2047 := by dsimp [B]; omega
  change (mul a C).isfinite = true ∧ _
  rw [hrun]
  refine ⟨?_, hb.2.2.1, Nat.le_trans (Nat.mul_le_mul_right _ hBlo) hb.1⟩
  rw [TruncProofs.isfinite_iff_mag]
  exact Nat.lt_of_le_of_lt hb.2.1 (Nat.mul_lt_mul_of_pos_right hBhi (Nat.two_pow_pos 52))

/-- In the small-input branch which survives the unbalanced cutoff, the
larger magnitude is below2^-484 (stored exponent field539). -/
theorem early_hypot_small_branch_exponent (a b : FV .f64)
    (ha : a.isfinite = true) (hb : b.isfinite = true)
    (hsa : a.signbit = false) (hsb : b.signbit = false)
    (hsmall : flt b (Fl.ofBits 0x2000000000000000) = true)
    (hcutoff : fle b (mul a (Fl.ofBits 0x3e46a09e667f3bcd)) = false) :
    a.expField < 539 := by
  apply Classical.byContradiction
  intro hE
  have hp := early_hypot_cutoff_lower a ha hsa (by omega)
  let r := mul a (Fl.ofBits 0x3e46a09e667f3bcd)
  change r.isfinite = true ∧ r.signbit = false ∧ 512 * 2 ^ 52 ≤ r.magnitude at hp
  have hroot : (Fl.ofBits 0x2000000000000000 : FV .f64).isnan = false ∧
      (Fl.ofBits 0x2000000000000000 : FV .f64).iszero = false ∧
      (Fl.ofBits 0x2000000000000000 : FV .f64).signbit = false ∧
      (Fl.ofBits 0x2000000000000000 : FV .f64).toBits = 512 * 2 ^ 52 := by decide
  have hbn := Fl.isnan_of_finite hb
  have hrn := Fl.isnan_of_finite hp.1
  have hrzero : r.iszero = false := by
    simp only [Fl.iszero, beq_eq_false_iff_ne]
    have hm := hp.2.2
    omega
  have hbbits : b.toBits = b.magnitude := by
    simpa only [hsb, Bool.false_eq_true, ↓reduceIte, Nat.zero_add] using (Fl.bits_split b).1
  have hrbits : r.toBits = r.magnitude := by
    simpa only [hp.2.1, Bool.false_eq_true, ↓reduceIte, Nat.zero_add] using (Fl.bits_split r).1
  change Fl.lt b (Fl.ofBits 0x2000000000000000) = true at hsmall
  simp only [Fl.lt, hbn, hroot.1, hroot.2.1, hroot.2.2.1, hroot.2.2.2, hsb,
    Bool.or_self, Bool.and_false, Bool.false_eq_true, bne_self_eq_false,
    ↓reduceIte, decide_eq_true_eq] at hsmall
  have hlt : Fl.lt b r = true := by
    simp only [Fl.lt, hbn, hrn, hrzero, hsb, hp.2.1, Bool.or_self,
      Bool.and_false, Bool.false_eq_true, bne_self_eq_false, ↓reduceIte, decide_eq_true_eq]
    rw [hbbits, hrbits] at *
    omega
  have hle : fle b r = true := by
    change (Fl.lt b r || Fl.eq b r) = true
    rw [hlt, Bool.true_or]
  change fle b r = false at hcutoff
  rw [hle] at hcutoff
  cases hcutoff

end JuliaLean.ChatGPT.Batch4.Group9



