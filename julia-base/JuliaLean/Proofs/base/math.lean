      · exact hypot_max_fold_seed T xs (reinterpret_Signed w)
      · exact hypot_max_fold_member T xs (reinterpret_Signed x) w hw
    rw [hm, JuliaLean.Proofs.base.float.reinterpret_Signed_val,
