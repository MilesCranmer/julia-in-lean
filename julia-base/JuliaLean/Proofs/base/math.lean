theorem generic_sqrt_lower_difference_factor (r b : Int) :
    (r + b) ^ 2 + (r - b) * (3 * r + b) = 4 * r ^ 2 := by
  have hrr : r * (3 * r) = 3 * (r * r) := by ac_rfl
  have hbr : b * (3 * r) = 3 * (r * b) := by ac_rfl
