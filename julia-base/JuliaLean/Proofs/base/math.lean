    ∃ h, hypotTupleGeneric JuliaLean.base.reduce.maximum_f JuliaLean.base.reduce.sum_f o iteratorEltype maximumReducer sumReducer isinfInput xs =
      .ok h ∧ o.isinf h = true := by
