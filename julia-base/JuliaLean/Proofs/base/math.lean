private theorem fabs_infinity {T : FTy} (x : FV T) (hx : fisinf x = true) :
    fabs x = finf T := by
  have hi : x.isinf = true := by
    have hEq : isinf_callee x = x.isinf :=
      JuliaLean.Proofs.base.float.isinf_IEEEFloat_eq x
    change isinf_callee x = true at hx
    rw [hEq] at hx
    exact hx
  have hfields : x.expField = T.fmt.emax ∧ x.frac = 0 := by
    simpa [Fl.isinf] using hi
  have hmag := (JuliaLean.Proofs.base.float.TruncProofs.mag_decomp x).1
  rw [hfields.1, hfields.2] at hmag
  have hmag : x.magnitude = exponentMask T := by
    simpa [exponentMask] using hmag
  have hn : x.isnan = false := by
    simp [Fl.isnan, hfields.1, hfields.2]
  change JuliaLean.base.float.abs_float x = finf T
  unfold JuliaLean.base.float.abs_float JuliaLean.C.jlAbsFloat JuliaLean.C.unaryFloat
  rw [JuliaLean.Proofs.base.float.finishFloat_eq]
  simp only [hn, Bool.and_false, Bool.false_eq_true, ↓reduceIte]
  rw [hmag]
  cases T <;> decide

