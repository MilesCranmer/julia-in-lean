  · obtain ⟨hyf, hyk⟩ := mfMulTwoRightKey p0 hpf hov
    have hyz : (mul p0 (Fl.ofInt 2)).iszero = false := by
      have h := mfKeyNatAbs (mul p0 (Fl.ofInt 2))
