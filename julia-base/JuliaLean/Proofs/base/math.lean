theorem generic_nearest_core_full {T : JuliaLean.base.float.FTy} (p x : JuliaLean.base.float.FV T) (hpf : p.isfinite = true) (hxf : x.isfinite = true)
    (hp0 : 0 < p.key) (hx0 : 0 ≤ x.key) (hX : x.key < 2 * p.key)
    (hxs : x.signbit = false) :
    (mfRemCore p x).isfinite = true ∧
      (mfRemCore p x).key = generic_nearest_core_key p.key x.key ∧
      ((mfRemCore p x).iszero = true → (mfRemCore p x).signbit = false) := by
  have hg := good_fty T
  obtain ⟨-, -, -, hsb2⟩ := mfFmtBounds T
  have hemax := hg.emax_eq
  obtain ⟨Bd, hBd⟩ : ∃ Bd, Bd = 2 ^ T.fmt.sb * 2 ^ (T.fmt.emax - 1) := ⟨_, rfl⟩
  have hBig : 2 ^ (T.fmt.sb + 3) ≤ Bd := by
    rw [hBd, ← Nat.pow_add]; exact Nat.pow_le_pow_right (by decide) (by omega)
  have h3 : 2 ^ (T.fmt.sb + 3) = 4 * 2 ^ (T.fmt.sb + 1) := by
    rw [show T.fmt.sb + 3 = (T.fmt.sb + 1) + 2 by omega, Nat.pow_add]; omega
  have hpB : p.key.natAbs < Bd := by
    have h1 := mfFiniteKeyMax p hpf; have h2 := mfKeyNatAbs p; omega
  have hlt : ∀ a b : JuliaLean.base.float.FV T, a.isfinite = true → b.isfinite = true →
      flt a b = decide (a.key < b.key) :=
    fun a b ha hb => Fl.lt_key (Fl.isnan_of_finite ha) (Fl.isnan_of_finite hb)
  have hle : ∀ a b : JuliaLean.base.float.FV T, a.isfinite = true → b.isfinite = true →
      fle a b = decide (a.key ≤ b.key) :=
    fun a b ha hb => le_IEEEFloat_key a b (Fl.isnan_of_finite ha) (Fl.isnan_of_finite hb)
  obtain ⟨-, -, hm2f, hm2k⟩ := mfFloatminFacts T
  have hS1 : p.key < 2 * x.key →
      (sub x p).isfinite = true ∧ (sub x p).key = x.key - p.key := fun h =>
    mfSubKey x p hxf hpf (by
      have hs := mfSterbenz T x.key.natAbs p.key.natAbs (mfValueRepr x hxf) (mfValueRepr p hpf)
        (by omega) (by omega)
      rw [show ((x.key.natAbs : Nat) : Int) = x.key by omega,
        show ((p.key.natAbs : Nat) : Int) = p.key by omega] at hs
      exact hs)
  have hS2 : p.key < 2 * x.key → p.key ≤ 2 * (x.key - p.key) →
      (sub (sub x p) p).isfinite = true ∧ (sub (sub x p) p).key = x.key - 2 * p.key := by
    intro h1 h
    obtain ⟨hf1, hk1⟩ := hS1 h1
    obtain ⟨hf2, hk2⟩ := mfSubKey (sub x p) p hf1 hpf (by
      have hs := mfSterbenz T (sub x p).key.natAbs p.key.natAbs (mfValueRepr _ hf1)
        (mfValueRepr p hpf) (by rw [hk1]; omega) (by rw [hk1]; omega)
      rw [show (((sub x p).key.natAbs : Nat) : Int) = (sub x p).key by rw [hk1]; omega,
        show ((p.key.natAbs : Nat) : Int) = p.key by omega] at hs
      exact hs)
    exact ⟨hf2, by rw [hk2, hk1]; omega⟩
  unfold mfRemCore
  by_cases c1 : flt p (mul (Fl.ofInt 2) (floatmin_float T)) = true
  · rw [if_pos c1]
    have c1' : p.key < ((2 ^ (T.fmt.sb + 1) : Nat) : Int) := by
      have h := c1; rw [hlt _ _ hpf hm2f, hm2k] at h; exact of_decide_eq_true h
    obtain ⟨h2xf, h2xk⟩ := mfMulTwoKey x hxf (by omega)
    by_cases c2 : flt p (mul (Fl.ofInt 2) x) = true
    · rw [if_pos c2]
      have c2' : p.key < 2 * x.key := by
        have h := c2; rw [hlt _ _ hpf h2xf, h2xk] at h; exact of_decide_eq_true h
      obtain ⟨hs1f, hs1k⟩ := hS1 c2'
      obtain ⟨h2sf, h2sk⟩ := mfMulTwoKey (sub x p) hs1f (by rw [hs1k]; omega)
      by_cases c3 : fle p (mul (Fl.ofInt 2) (sub x p)) = true
      · rw [if_pos c3]
        have c3' : p.key ≤ 2 * (x.key - p.key) := by
          have h := c3; rw [hle _ _ hpf h2sf, h2sk, hs1k] at h; exact of_decide_eq_true h
        obtain ⟨hf, hk⟩ := hS2 c2' c3'
        refine ⟨hf, by rw [hk]; simp only [generic_nearest_core_key, c2', c3', ↓reduceIte], ?_⟩
        intro hz
        have hzkey := generic_zero_key (sub (sub x p) p) hz
        rw [hk] at hzkey
        omega
      · rw [if_neg c3]
        have c3' : ¬ (p.key ≤ 2 * (x.key - p.key)) := fun h =>
          c3 (by rw [hle _ _ hpf h2sf, h2sk, hs1k]; exact decide_eq_true h)
        exact ⟨hs1f, by rw [hs1k]; simp only [generic_nearest_core_key, c2', c3', ↓reduceIte],
          generic_exact_sub_zero_sign x p hxf hpf hp0 hs1k⟩
    · rw [if_neg c2]
      have c2' : ¬ (p.key < 2 * x.key) := fun h =>
        c2 (by rw [hlt _ _ hpf h2xf, h2xk]; exact decide_eq_true h)
      exact ⟨hxf, by simp only [generic_nearest_core_key, c2', ↓reduceIte], fun _ => hxs⟩
  · rw [if_neg c1]
    have c1' : ¬ (p.key < ((2 ^ (T.fmt.sb + 1) : Nat) : Int)) := fun h =>
      c1 (by rw [hlt _ _ hpf hm2f, hm2k]; exact decide_eq_true h)
    obtain ⟨heven, hrepH⟩ := mfHalfRepr T p.key.natAbs (mfValueRepr p hpf) (by omega)
    obtain ⟨hhf, hhk⟩ := mfDivTwoKey p hpf (p.key / 2) (by omega)
      (by rw [show (p.key / 2).natAbs = p.key.natAbs / 2 by omega]; exact hrepH)
    by_cases c4 : flt (div p (Fl.ofInt 2)) x = true
    · rw [if_pos c4]
      have c4' : p.key < 2 * x.key := by
        have h := c4; rw [hlt _ _ hhf hxf, hhk] at h; have := of_decide_eq_true h; omega
      obtain ⟨hs1f, hs1k⟩ := hS1 c4'
      by_cases c5 : fle (div p (Fl.ofInt 2)) (sub x p) = true
      · rw [if_pos c5]
        have c5' : p.key ≤ 2 * (x.key - p.key) := by
          have h := c5; rw [hle _ _ hhf hs1f, hhk, hs1k] at h; have := of_decide_eq_true h; omega
        obtain ⟨hf, hk⟩ := hS2 c4' c5'
        refine ⟨hf, by rw [hk]; simp only [generic_nearest_core_key, c4', c5', ↓reduceIte], ?_⟩
        intro hz
        have hzkey := generic_zero_key (sub (sub x p) p) hz
        rw [hk] at hzkey
        omega
      · rw [if_neg c5]
        have c5' : ¬ (p.key ≤ 2 * (x.key - p.key)) := fun h =>
          c5 (by rw [hle _ _ hhf hs1f, hhk, hs1k]; exact decide_eq_true (by omega))
        exact ⟨hs1f, by rw [hs1k]; simp only [generic_nearest_core_key, c4', c5', ↓reduceIte],
          generic_exact_sub_zero_sign x p hxf hpf hp0 hs1k⟩
    · rw [if_neg c4]
      have c4' : ¬ (p.key < 2 * x.key) := fun h =>
        c4 (by rw [hlt _ _ hhf hxf, hhk]; exact decide_eq_true (by omega))
      exact ⟨hxf, by simp only [generic_nearest_core_key, c4', ↓reduceIte], fun _ => hxs⟩

