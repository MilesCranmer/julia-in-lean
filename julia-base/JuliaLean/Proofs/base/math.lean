    have hz : (fzero .f64).key = 0 := by decide
    rw [hz, decide_eq_false (by omega)]
  have hc : hypot_boundary_fma_correction a b = sub (add q E) R := by
    dsimp only [hypot_boundary_fma_correction]
    rw [hypot_boundary_square_certificates.2.1]
  rw [hc]
  exact ⟨hcnan, hckey, hclt⟩


/-- A coefficient with at most 53 significant bits remains exact on the residual lattice. -/
theorem hypot_boundary_lattice_integer (K : Int) (hK : K.natAbs < 2 ^ 53) (z : Bool) :
    hypot_boundary_integer
      (Fl.roundRat (K * ((2 ^ 816 : Nat) : Int)) 1 z) (K * ((2 ^ 816 : Nat) : Int)) := by
  by_cases hz : K = 0
  · subst K
    simpa [hypot_boundary_integer, Fl.roundRat] using (Fl.zero_spec (good_fty .f64) z)
  · have hlog : K.natAbs.log2 < 53 := (Nat.log2_lt (by omega)).mpr hK
    have hn : (K * ((2 ^ 816 : Nat) : Int)).natAbs = K.natAbs * 2 ^ 816 := by
      rw [Int.natAbs_mul, Int.natAbs_natCast]
    have hp := Fl.roundRat_key (good_fty .f64)
      (K * ((2 ^ 816 : Nat) : Int)) K.natAbs 816 0 z hn (by omega)
      (by exact hK) (by change 1 ≤ K.natAbs.log2 + 816 + 1023; omega)
      (by change K.natAbs.log2 + 816 + 1023 < 0 + 2047; omega)
    simpa only [hypot_boundary_integer, Nat.pow_zero, Int.natCast_one, Int.mul_one] using hp

/-- Exact product residuals follow from the residual lattice bound. -/
theorem hypot_boundary_product_residual_exact
    (a : hypot_BoundaryVal) (an yn K : Int)
    (ha : hypot_boundary_integer a an)
    (hy : hypot_boundary_integer (mul a a) yn)
    (hL : an * an - yn = K * ((2 ^ 816 : Nat) : Int))
    (hK : K.natAbs ≤ 2 ^ 52) :
    hypot_boundary_integer
      (jlFmaFloat a a (fneg (mul a a))) (an * an - yn) := by
  have hneg := hypot_boundary_neg_integer (mul a a) yn hy
  rw [hypot_boundary_fma_integer a a _ an an (-yn) ha ha hneg]
  rw [← Int.sub_eq_add_neg, hL]
  exact hypot_boundary_lattice_integer K (by omega) _

/-- The preceding lattice point is representable even at the endpoints of the residual bound. -/
theorem hypot_boundary_residual_minus_E_representable (K : Int) (hK : K.natAbs ≤ 2 ^ 52) :
    ∃ r : hypot_BoundaryVal,
      hypot_boundary_integer r (K * ((2 ^ 816 : Nat) : Int) - ((2 ^ 816 : Nat) : Int)) := by
  have hKm : (K - 1).natAbs < 2 ^ 53 := by omega
  refine ⟨Fl.roundRat ((K - 1) * ((2 ^ 816 : Nat) : Int)) 1 false, ?_⟩
  have h := hypot_boundary_lattice_integer (K - 1) hKm false
  simpa only [Int.sub_mul, Int.one_mul] using h


/-- A nonfinite non-NaN value above a finite lower bound is positive infinity. -/
theorem hypot_boundary_inf_above_finite (x m : hypot_BoundaryVal)
    (hxnan : x.isnan = false) (hxfin : x.isfinite = false)
    (hmfin : m.isfinite = true) (hmx : m.key ≤ x.key) : x = finf .f64 := by
  have hxi := mfInfOfNotFinite x hxnan hxfin
  have hxkey := Fl.inf_key_eq (good_fty .f64) x hxi
  have hmkey := (Fl.finite_key_lt_inf (good_fty .f64) m hmfin).1
  have hs : x.signbit = false := by
    cases hsx : x.signbit
    · rfl
    · simp only [hsx, ↓reduceIte] at hxkey
      omega
  exact mfInfEq x (finf .f64) hxi (by decide) (by simpa only [hs] using (by decide : false = (finf .f64).signbit))

theorem hypot_boundary_inf_add_finite (x : hypot_BoundaryVal) (hx : x.isfinite = true) :
    add (finf .f64) x = finf .f64 := by
  have hi : (finf .f64).isinf = true := by decide
  have hn : (finf .f64).isnan = false := by decide
  simp only [add, add_float, jlAddFloat, finishFloat_eq, floatAdd,
    hi, hn, Fl.isnan_of_finite hx, Fl.isinf_of_finite hx,
    Bool.false_and, Bool.false_eq_true, ↓reduceIte]

theorem hypot_boundary_inf_sub_finite (x : hypot_BoundaryVal) (hx : x.isfinite = true) :
    sub (finf .f64) x = finf .f64 := by
  have hi : (finf .f64).isinf = true := by decide
  have hn : (finf .f64).isnan = false := by decide
  have hneg := (EpsilonProofs.neg_finite_rat x hx).1
  simp only [sub, sub_float, jlSubFloat, finishFloat_eq, floatSub, floatAdd,
    hi, hn, Fl.isnan_of_finite hx, Fl.isnan_of_finite hneg, Fl.isinf_of_finite hneg,
    Bool.false_and, Bool.false_eq_true, ↓reduceIte]

/-- The same boundary sign conclusion needs no intermediate-finiteness assumptions.
    A positive-infinity intermediate also propagates to a nonnegative correction. -/
theorem hypot_boundary_fma_correction_nonnegative
    (a b r : hypot_BoundaryVal) (an bn yn : Int)
    (hb : hypot_boundary_integer b bn)
    (hd : hypot_boundary_integer
      (sub (mul hypot_rescale_boundary hypot_rescale_boundary) (mul a a))
      ((mul hypot_rescale_boundary hypot_rescale_boundary).toRat.1 - yn))
    (hres : hypot_boundary_integer
      (jlFmaFloat a a (fneg (mul a a))) (an * an - yn))
    (hr : hypot_boundary_integer r (an * an - yn - ((2 ^ 816 : Nat) : Int)))
    (hnorm : an * an + bn * bn ≤
      hypot_rescale_boundary.toRat.1 * hypot_rescale_boundary.toRat.1) :
    (hypot_boundary_fma_correction a b).isnan = false ∧
    0 ≤ (hypot_boundary_fma_correction a b).key ∧
    flt (hypot_boundary_fma_correction a b) (fzero .f64) = false := by
  let H := hypot_rescale_boundary
  let X := mul H H
  let Y := mul a a
  let E : hypot_BoundaryVal := Fl.ofBits 0x72f0000000000000
  let R := jlFmaFloat a a (fneg Y)
  let q := jlFmaFloat (fneg b) b (sub X Y)
  let N := (-bn) * bn + (X.toRat.1 - yn)
  have he : hypot_boundary_integer E ((2 ^ 816 : Nat) : Int) :=
    hypot_boundary_integer_certificates.2
  have hqeq : q = Fl.roundRat N 1
      (((fneg b).signbit != b.signbit) && (sub X Y).signbit) :=
    hypot_boundary_fma_integer _ _ _ _ _ _ (hypot_boundary_neg_integer b bn hb) hb hd
  have hMN : an * an - yn - ((2 ^ 816 : Nat) : Int) ≤ N := by
    have hclosed := hypot_boundary_square_certificates.2.2.2.2
    dsimp only [N, X, H]
    simp only [Int.neg_mul] at *
    omega
  have hrq : r.key ≤ q.key := by
    rw [hqeq]
    exact hypot_boundary_round_lower _ _ _ _ hr hMN
  have hqnan : q.isnan = false := by
    rw [hqeq]
    exact (FloatRoundDirections.roundRat_integer_integral .f64 _ _).1
  have hc : hypot_boundary_fma_correction a b = sub (add q E) R := by
    dsimp only [hypot_boundary_fma_correction]
    rw [hypot_boundary_square_certificates.2.1]
  have hgoodinf : (finf .f64).isnan = false ∧ 0 ≤ (finf .f64).key ∧
      flt (finf .f64) (fzero .f64) = false := by decide
  cases hqfin : q.isfinite
  · have hqi := hypot_boundary_inf_above_finite q r hqnan hqfin hr.1 hrq
    rw [hc, hqi, hypot_boundary_inf_add_finite E he.1, hypot_boundary_inf_sub_finite R hres.1]
    exact hgoodinf
  · obtain ⟨Q, hQ⟩ := hypot_boundary_rounded_integer N
      (((fneg b).signbit != b.signbit) && (sub X Y).signbit)
      (by rw [← hqeq]; exact hqfin)
    rw [← hqeq] at hQ
    have hQbound := hypot_boundary_integer_le r q _ Q hr hQ hrq
    have hseq := hypot_boundary_add_integer q E Q ((2 ^ 816 : Nat) : Int) hQ he
    have hRs : R.key ≤ (add q E).key := by
      rw [hseq]
      exact hypot_boundary_round_lower _ _ _ _ hres (by omega)
    cases hsumfin : (add q E).isfinite
    · have hsnan : (add q E).isnan = false := by
        rw [hseq]
        exact (FloatRoundDirections.roundRat_integer_integral .f64 _ _).1
      have hsi := hypot_boundary_inf_above_finite (add q E) R hsnan hsumfin hres.1 hRs
      rw [hc, hsi, hypot_boundary_inf_sub_finite R hres.1]
      exact hgoodinf
    · exact hypot_boundary_fma_correction_nonnegative_finite a b r an bn yn
        hb hd hres hr hnorm hqfin hsumfin


/-- Source-level sufficient hypotheses for the critical-boundary hardware-FMA sign.
    Exact product residual and representability of the preceding lattice point
    follow from the explicit residual lattice bound. -/
theorem hypot_boundary_fma_nonnegative_of_lattice
    (a b : hypot_BoundaryVal) (an bn yn K : Int)
    (ha : hypot_boundary_integer a an)
    (hb : hypot_boundary_integer b bn)
    (hy : hypot_boundary_integer (mul a a) yn)
    (hd : hypot_boundary_integer
      (sub (mul hypot_rescale_boundary hypot_rescale_boundary) (mul a a))
      ((mul hypot_rescale_boundary hypot_rescale_boundary).toRat.1 - yn))
    (hL : an * an - yn = K * ((2 ^ 816 : Nat) : Int))
    (hK : K.natAbs ≤ 2 ^ 52)
    (hnorm : an * an + bn * bn ≤
      hypot_rescale_boundary.toRat.1 * hypot_rescale_boundary.toRat.1) :
    (hypot_boundary_fma_correction a b).isnan = false ∧
    0 ≤ (hypot_boundary_fma_correction a b).key ∧
    flt (hypot_boundary_fma_correction a b) (fzero .f64) = false := by
  have hres := hypot_boundary_product_residual_exact a an yn K ha hy hL hK
  obtain ⟨r, hr⟩ := hypot_boundary_residual_minus_E_representable K hK
  rw [← hL] at hr
  exact hypot_boundary_fma_correction_nonnegative a b r an bn yn hb hd hres hr hnorm

