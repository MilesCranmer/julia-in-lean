  have b0 := (JuliaLean.Proofs.base.math.mfKeySign b).2 hsb
  have h0 := (JuliaLean.Proofs.base.math.mfKeySign h).2 hsh
  have hd := early_sub_sterbenz_nonnegative h b hh.1 hb.1 hsh hsb hbranch (by omega)
  have hδloC : Amax.key ≤ 8 * D1.key := by decide
