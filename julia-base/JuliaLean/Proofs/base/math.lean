    q * q * d ≤ n ∧ n < (q + 1) * (q + 1) * d := by
  let q := sqrtFloorRatio n d (sb + 2) 0 (2 ^ (sb + 1) + 1)
  have hiBound : n < (2 ^ (sb + 1) + 1) * (2 ^ (sb + 1) + 1) * d := by
    exact Nat.lt_of_lt_of_le hhi (Nat.mul_le_mul_right d
      (Nat.mul_self_le_mul_self (Nat.le_succ _)))
  have hwidth : 2 ^ (sb + 1) + 1 - 0 ≤ 2 ^ (sb + 2) := by
    have hp := Nat.two_pow_pos (sb + 1)
