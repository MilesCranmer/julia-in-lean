    have hsmall : q + 1 ≤ 2 ^ sb := by omega
    have hc := Nat.mul_le_mul_right d (Nat.mul_self_le_mul_self hsmall)
    omega
  have hqmax : q < 2 ^ (sb + 1) := by
    apply Classical.byContradiction
