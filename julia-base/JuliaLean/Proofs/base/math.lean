  have hD : (0 : Int) < T.fmt.den := by exact_mod_cast T.fmt.den_pos
  have hrx := (Fl.toRat_key (good_fty T) x hx).2
  have hry := (Fl.toRat_key (good_fty T) y hy).2
  apply (Int.mul_le_mul_right hD).mp
  calc
    ((x.toRat.1 * y.toRat.1) * T.fmt.den) * T.fmt.den =
        (x.toRat.1 * T.fmt.den) * (y.toRat.1 * T.fmt.den) := by ac_rfl
    _ = (x.key * x.toRat.2) * (y.key * y.toRat.2) := by rw [hrx, hry]
    _ = (x.key * y.key) * ((x.toRat.2 : Int) * y.toRat.2) := by ac_rfl
