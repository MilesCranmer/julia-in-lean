theorem hypot_widen_finite_mag_neg {S T : hypot_NanTy}
    (hne : (T.fmt == S.fmt) = false) (hsb : S.fmt.sb ≤ T.fmt.sb)
    (hbias : S.fmt.bias + S.fmt.sb ≤ T.fmt.bias)
    (x : hypot_NanVal S) (hx : x.isfinite = true) :
    (Fl.convert x : hypot_NanVal T).isfinite = true ∧
    (Fl.convert (fneg x) : hypot_NanVal T).isfinite = true ∧
    (Fl.convert (fneg x) : hypot_NanVal T).magnitude = (Fl.convert x : hypot_NanVal T).magnitude := by
  rw [hypot_fneg_eq x hx]
  have hxneg := (JuliaLean.Proofs.base.float.EpsilonProofs.neg_finite_rat x hx).1
  have hc := Fl.convert_widen_key (JuliaLean.Proofs.base.float.good_fty S)
    (JuliaLean.Proofs.base.float.good_fty T) hne hsb hbias x
  have hd := Fl.convert_widen_key (JuliaLean.Proofs.base.float.good_fty S)
    (JuliaLean.Proofs.base.float.good_fty T) hne hsb hbias (Fl.neg x)
  refine ⟨hc.2.2.1.trans hx, hd.2.2.1.trans hxneg, ?_⟩
  have he : (Fl.convert (Fl.neg x) : hypot_NanVal T).key =
      -(Fl.convert x : hypot_NanVal T).key := by
    apply Int.eq_of_mul_eq_mul_right (show (S.fmt.den : Int) ≠ 0 by
      have h := S.fmt.den_pos; omega)
    rw [(hd.2.2.2.2 hxneg).1, Int.neg_mul, (hc.2.2.2.2 hx).1, hypot_neg_key,
      Int.neg_mul]
  have ha := congrArg Int.natAbs he
  simp only [Fl.key, Int.natAbs_neg] at ha
  have hm : JuliaLean.Proofs.base.float.magKey T.fmt (Fl.convert (Fl.neg x) : hypot_NanVal T).magnitude =
      JuliaLean.Proofs.base.float.magKey T.fmt (Fl.convert x : hypot_NanVal T).magnitude := by
    cases hs : (Fl.convert (Fl.neg x) : hypot_NanVal T).signbit <;>
      cases ht : (Fl.convert x : hypot_NanVal T).signbit <;>
      simpa only [hs, ht, Bool.false_eq_true, ↓reduceIte, Int.natAbs_neg, Int.natAbs_natCast] using ha
  rcases Nat.lt_trichotomy (Fl.convert (Fl.neg x) : hypot_NanVal T).magnitude
      (Fl.convert x : hypot_NanVal T).magnitude with hl | heq | hg
  · have h := JuliaLean.Proofs.base.float.magKey_strictMono T.fmt hl
    omega
  · exact heq
  · have h := JuliaLean.Proofs.base.float.magKey_strictMono T.fmt hg
    omega

