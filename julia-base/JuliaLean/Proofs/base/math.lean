/-- Positive dyadics with exponent at most78 round to finite values at most2^79. -/
theorem early_round64_small_scale_bound (n j : Nat) (hn : n ≠ 0)
    (hlo : -1022 ≤ (n.log2 : Int) - j) (hhi : (n.log2 : Int) - j ≤ 78) :
    (Fl.roundRat n (2 ^ j) false : FV .f64).isfinite = true ∧
    (Fl.roundRat n (2 ^ j) false : FV .f64).signbit = false ∧
