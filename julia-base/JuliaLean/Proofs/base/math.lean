  have hc4 := generic_sub64_abs_bound a (mul (Fl.ofInt 2) b) Amax ha.1 h2b.1
    (by decide) (by decide) (by decide)
    (by rw [h2b.2]; omega) (by rw [h2b.2]; omega)
  have hz := early_mul_abs_upper (Fl.ofInt 2) delta D4
    (Fl.ofInt 2 : FV .f64).key D2.key (by decide) hd.1 (by decide) hδabs
    (by decide) (by decide) (by decide) (by decide)
  have hz2 := early_mul_abs_upper (mul (Fl.ofInt 2) delta) (sub a (mul (Fl.ofInt 2) b)) Z2
    D4.key Amax.key hz.1 hc4.1 hz.2 hc4.2
