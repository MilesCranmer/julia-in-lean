    have hlarge : 2 ^ (sb + 1) ≤ q := by omega
    have hc := Nat.mul_le_mul_right d (Nat.mul_self_le_mul_self hlarge)
    omega
  exact ⟨hqmin, hqmax, hqlo, hqhi⟩

/-- Rescaling the exact dyadic input places its square root in one normal
significand bin, without performing floating-point arithmetic. -/
theorem early_sqrt_scaling (n j sb : Nat) (hn : n ≠ 0) :
    let e : Int := (n.log2 : Int) - j
    let k := e / 2 - sb
    let scaled := if 2 * k ≥ 0 then (n, 2 ^ j * 2 ^ (2 * k).toNat)
      else (n * 2 ^ (-2 * k).toNat, 2 ^ j)
    0 < scaled.2 ∧
    (2 ^ sb) * (2 ^ sb) * scaled.2 ≤ scaled.1 ∧
    scaled.1 < (2 ^ (sb + 1)) * (2 ^ (sb + 1)) * scaled.2 := by
  dsimp only
  have hlo : 2 ^ n.log2 ≤ n := Nat.log2_self_le hn
  have hhi : n < 2 ^ (n.log2 + 1) := Nat.lt_log2_self
  let k : Int := ((n.log2 : Int) - j) / 2 - sb
  change let scaled := if 2 * k ≥ 0 then (n, 2 ^ j * 2 ^ (2 * k).toNat)
    else (n * 2 ^ (-2 * k).toNat, 2 ^ j); _
  have heklo : 2 * k + 2 * (sb : Int) + j ≤ n.log2 := by dsimp [k]; omega
  have hekhi : n.log2 < 2 * k + 2 * (sb : Int) + j + 2 := by dsimp [k]; omega
  split
  · rename_i hk
    dsimp only
    refine ⟨Nat.mul_pos (Nat.two_pow_pos _) (Nat.two_pow_pos _), ?_, ?_⟩
    · have he : sb + sb + (j + (2 * k).toNat) ≤ n.log2 := by omega
      calc
        2 ^ sb * 2 ^ sb * (2 ^ j * 2 ^ (2 * k).toNat) =
            2 ^ (sb + sb + (j + (2 * k).toNat)) := by rw [← Nat.pow_add, ← Nat.pow_add, ← Nat.pow_add]
        _ ≤ 2 ^ n.log2 := Nat.pow_le_pow_right (by decide) he
        _ ≤ n := hlo
    · have he : n.log2 + 1 ≤ (sb + 1) + (sb + 1) + (j + (2 * k).toNat) := by omega
      calc
        n < 2 ^ (n.log2 + 1) := hhi
        _ ≤ 2 ^ ((sb + 1) + (sb + 1) + (j + (2 * k).toNat)) :=
          Nat.pow_le_pow_right (by decide) he
        _ = 2 ^ (sb + 1) * 2 ^ (sb + 1) * (2 ^ j * 2 ^ (2 * k).toNat) := by
          rw [← Nat.pow_add, ← Nat.pow_add, ← Nat.pow_add]
  · rename_i hk
    dsimp only
    refine ⟨Nat.two_pow_pos _, ?_, ?_⟩
    · have he : sb + sb + j ≤ n.log2 + (-2 * k).toNat := by omega
      calc
        2 ^ sb * 2 ^ sb * 2 ^ j = 2 ^ (sb + sb + j) := by rw [← Nat.pow_add, ← Nat.pow_add]
        _ ≤ 2 ^ (n.log2 + (-2 * k).toNat) := Nat.pow_le_pow_right (by decide) he
        _ = 2 ^ n.log2 * 2 ^ (-2 * k).toNat := by rw [Nat.pow_add]
        _ ≤ n * 2 ^ (-2 * k).toNat := Nat.mul_le_mul_right _ hlo
    · have he : n.log2 + 1 + (-2 * k).toNat ≤ (sb + 1) + (sb + 1) + j := by omega
      calc
        n * 2 ^ (-2 * k).toNat < 2 ^ (n.log2 + 1) * 2 ^ (-2 * k).toNat :=
          Nat.mul_lt_mul_of_pos_right hhi (Nat.two_pow_pos _)
        _ = 2 ^ (n.log2 + 1 + (-2 * k).toNat) := by rw [← Nat.pow_add]
        _ ≤ 2 ^ ((sb + 1) + (sb + 1) + j) := Nat.pow_le_pow_right (by decide) he
        _ = 2 ^ (sb + 1) * 2 ^ (sb + 1) * 2 ^ j := by rw [← Nat.pow_add, ← Nat.pow_add]

theorem early_sqrt_input_dyadic {T : FTy} (x : FV T)
    (hf : x.isfinite = true) (hz : x.iszero = false) (hs : x.signbit = false) :
    ∃ n j : Nat, x.toRat = ((n : Int), 2 ^ j) ∧ n ≠ 0 ∧
      (1 - (T.fmt.bias : Int) - T.fmt.sb ≤ (n.log2 : Int) - j) ∧
      ((n.log2 : Int) - j ≤ T.fmt.bias) := by
  obtain ⟨m, i, j, hr, hk, _hmcap, hrange⟩ := Fl.toRat_cases (good_fty T) x hf
  have hxmag : x.magnitude ≠ 0 := by simpa only [Fl.iszero, beq_eq_false_iff_ne] using hz
  have hmkpos : 0 < magKey T.fmt x.magnitude := by
    have h := magKey_strictMono T.fmt (Nat.pos_of_ne_zero hxmag)
    simpa only [magKey_zero] using h
  have hm : m ≠ 0 := by
    intro hmzero
    rw [hmzero, Nat.zero_mul, Nat.zero_mul] at hk
    have hp := Nat.mul_pos hmkpos (Nat.two_pow_pos j)
    omega
  have hn : m * 2 ^ i ≠ 0 := Nat.mul_ne_zero hm (Nat.ne_of_gt (Nat.two_pow_pos i))
  have hb := hrange hm
  refine ⟨m * 2 ^ i, j, ?_, hn, ?_, ?_⟩
  · simpa only [hs, Bool.false_eq_true, ↓reduceIte] using hr
  · rw [Fl.log2_mul_pow m i hm]
    omega
  · rw [Fl.log2_mul_pow m i hm]
    omega

theorem early_sqrt_pack_safe (T : FTy) (q : Nat) (k : Int)
    (hqlo : 2 ^ T.fmt.sb ≤ q) (hqhi : q ≤ 2 ^ (T.fmt.sb + 1))
    (hklo : 2 ≤ k + T.fmt.bias + T.fmt.sb)
    (hkhi : k + T.fmt.bias + T.fmt.sb + 2 < T.fmt.emax) :
    let r : FV T := Fl.packRounded false q k
    r.isfinite = true ∧ r.signbit = false ∧ r.iszero = false := by
  have hp := Nat.two_pow_pos T.fmt.sb
  have hcap : 2 ^ (T.fmt.sb + 1) = 2 ^ T.fmt.sb * 2 := by rw [Nat.pow_succ]
  have hnormal : ∀ (c : Nat) (l : Int),
      2 ^ T.fmt.sb ≤ c → c < 2 ^ (T.fmt.sb + 1) →
      1 ≤ l + T.fmt.bias + T.fmt.sb → l + T.fmt.bias + T.fmt.sb < T.fmt.emax →
      let r : FV T := Fl.packRounded false c l
      r.isfinite = true ∧ r.signbit = false ∧ r.iszero = false := by
    intro c l hc0 hc1 hl0 hl1
    rw [Fl.packRounded_normal false c l hc0 hc1 hl1]
    have hB : (l + T.fmt.bias + T.fmt.sb).toNat < T.fmt.emax := by omega
    have hBpos : 0 < (l + T.fmt.bias + T.fmt.sb).toNat := by omega
    have hr : c - 2 ^ T.fmt.sb < 2 ^ T.fmt.sb := by rw [hcap] at hc1; omega
    have hE := (good_fty T).emax_succ
    obtain ⟨hsgn, hexp, _hfrac, hmag⟩ := Fl.pack_parts (f := T.fmt) false
      (l + T.fmt.bias + T.fmt.sb).toNat (c - 2 ^ T.fmt.sb) (by omega) hr
    refine ⟨?_, hsgn, ?_⟩
    · simp only [Fl.isfinite, hexp, bne_iff_ne]
      omega
    · simp only [Fl.iszero, hmag, beq_eq_false_iff_ne]
      have hprod := Nat.mul_pos hBpos hp
      omega
  by_cases hc : q < 2 ^ (T.fmt.sb + 1)
  · exact hnormal q k hqlo hc (by omega) (by omega)
  · have hqe : q = 2 ^ (T.fmt.sb + 1) := by omega
    have hp0 : 2 ^ T.fmt.sb ≠ 0 := Nat.ne_of_gt hp
    have hpSmall : ¬2 ^ T.fmt.sb ≥ 2 ^ (T.fmt.sb + 1) := by rw [hcap]; omega
    have hcarry : (Fl.packRounded false q k : FV T) =
        Fl.packRounded false (2 ^ T.fmt.sb) (k + 1) := by
      simp only [Fl.packRounded, hp0, beq_iff_eq, ↓reduceIte,
        hqe, Nat.le_refl, hpSmall]
      rw [hcap, Nat.mul_div_cancel _ (by decide : 0 < 2)]
      simp only [Nat.mul_eq_zero, hp0, Nat.succ_ne_zero, or_self, ↓reduceIte]
    rw [hcarry]
    exact hnormal _ _ (Nat.le_refl _) (by rw [hcap]; omega) (by omega) (by omega)

theorem early_sqrt_finite_positive {T : FTy} (x : FV T)
    (hf : x.isfinite = true) (hz : x.iszero = false) (hs : x.signbit = false) :
    (jlSqrtLlvm x).isfinite = true ∧ (jlSqrtLlvm x).signbit = false ∧
      (jlSqrtLlvm x).iszero = false := by
  obtain ⟨n, j, hrat, hn, hmin, hmax⟩ := early_sqrt_input_dyadic x hf hz hs
  let e : Int := (n.log2 : Int) - j
  let k := e / 2 - T.fmt.sb
  let scaled := if 2 * k ≥ 0 then (n, 2 ^ j * 2 ^ (2 * k).toNat)
    else (n * 2 ^ (-2 * k).toNat, 2 ^ j)
  let q := sqrtFloorRatio scaled.1 scaled.2 (T.fmt.sb + 2) 0 (2 ^ (T.fmt.sb + 1) + 1)
  let rounded := if 4 * scaled.1 > (2 * q + 1) ^ 2 * scaled.2 ||
      (4 * scaled.1 == (2 * q + 1) ^ 2 * scaled.2 && q % 2 == 1)
    then q + 1 else q
  have hscale := early_sqrt_scaling n j T.fmt.sb hn
  change 0 < scaled.2 ∧ _ at hscale
  have hq := early_sqrt_search_normalized scaled.1 scaled.2 T.fmt.sb hscale.1
    hscale.2.1 hscale.2.2
  change 2 ^ T.fmt.sb ≤ q ∧ q < 2 ^ (T.fmt.sb + 1) ∧ _ at hq
  have hrlo : 2 ^ T.fmt.sb ≤ rounded := by dsimp only [rounded]; split <;> omega
  have hrhi : rounded ≤ 2 ^ (T.fmt.sb + 1) := by dsimp only [rounded]; split <;> omega
  have hklo : 2 ≤ k + T.fmt.bias + T.fmt.sb := by
    dsimp only [k, e]
    cases T <;> simp only [FTy.fmt, JuliaLean.Promotion.half,
      JuliaLean.Promotion.single, JuliaLean.Promotion.double,
      JuliaLean.Promotion.Fmt.bias] at hmin hmax ⊢ <;> omega
  have hkhi : k + T.fmt.bias + T.fmt.sb + 2 < T.fmt.emax := by
    dsimp only [k, e]
    cases T <;> simp only [FTy.fmt, JuliaLean.Promotion.half,
      JuliaLean.Promotion.single, JuliaLean.Promotion.double,
      JuliaLean.Promotion.Fmt.bias, JuliaLean.Promotion.Fmt.emax] at hmin hmax ⊢ <;> omega
  have hnx := Fl.isnan_of_finite hf
  have hix := Fl.isinf_of_finite hf
  have hrun : jlSqrtLlvm x = (Fl.packRounded false rounded k : FV T) := by
    simp only [jlSqrtLlvm, unaryFloat, hnx, Bool.and_false, Bool.false_eq_true,
      ↓reduceIte, finishFloat_eq, JuliaLean.C.sqrtFloat, hz, hs, hix, hrat,
      Int.natAbs_natCast, Fl.floorLog2Rat_pow n j hn]
    rfl
  rw [hrun]
  exact early_sqrt_pack_safe T rounded k hrlo hrhi hklo hkhi

theorem early_sqrt_integer_midpoint (n d q : Nat)
    (hd : 0 < d) (hq : 0 < q)
    (hlo : q * q * d ≤ n) (hhi : n < (q + 1) * (q + 1) * d) :
    let t := if 4 * n > (2 * q + 1) ^ 2 * d ||
      (4 * n == (2 * q + 1) ^ 2 * d && q % 2 == 1) then q + 1 else q
    (2 * t - 1) ^ 2 * d ≤ 4 * n ∧ 4 * n ≤ (2 * t + 1) ^ 2 * d ∧
      (((2 * t - 1) ^ 2 * d = 4 * n ∨ 4 * n = (2 * t + 1) ^ 2 * d) →
        t % 2 = 0) := by
  have hscale (a : Nat) : (2 * a) * (2 * a) * d = 4 * (a * a * d) := by
    calc
      (2 * a) * (2 * a) * d = (2 * 2) * (a * a * d) := by ac_rfl
      _ = 4 * (a * a * d) := rfl
  dsimp only
  split
  · rename_i hround
    have hchoice : (2 * q + 1) ^ 2 * d < 4 * n ∨
        (4 * n = (2 * q + 1) ^ 2 * d ∧ q % 2 = 1) := by
      simpa only [Bool.or_eq_true, Bool.and_eq_true, decide_eq_true_eq,
        beq_iff_eq] using hround
    have hleft : 2 * (q + 1) - 1 = 2 * q + 1 := by omega
    have hupper : 4 * n < (2 * (q + 1) + 1) ^ 2 * d := by
      have hfour := Nat.mul_lt_mul_of_pos_left hhi (by decide : 0 < 4)
      have hsq := Nat.mul_self_le_mul_self (Nat.le_succ (2 * (q + 1)))
      have hsqmul := Nat.mul_le_mul_right d hsq
      simp only [Nat.succ_eq_add_one] at hsqmul
      rw [hscale] at hsqmul
      rw [Nat.pow_two]
      omega
    rw [hleft]
    refine ⟨by omega, Nat.le_of_lt hupper, ?_⟩
    intro htie
    have hqodd : q % 2 = 1 := by omega
    omega
  · rename_i hround
    have hchoice : ¬((2 * q + 1) ^ 2 * d < 4 * n ∨
        (4 * n = (2 * q + 1) ^ 2 * d ∧ q % 2 = 1)) := by
      simpa only [Bool.or_eq_true, Bool.and_eq_true, decide_eq_true_eq,
        beq_iff_eq] using hround
    have hlower : (2 * q - 1) ^ 2 * d < 4 * n := by
      have hinner : 2 * q - 1 < 2 * q := by omega
      have hsq := Nat.mul_self_lt_mul_self hinner
      have hsqmul := Nat.mul_lt_mul_of_pos_right hsq hd
      rw [hscale] at hsqmul
      have hfour := Nat.mul_le_mul_left 4 hlo
      rw [Nat.pow_two]
      omega
    refine ⟨Nat.le_of_lt hlower, by omega, ?_⟩
    intro htie
    have hmod := Nat.mod_lt q (by decide : 0 < 2)
    omega

theorem early_sqrt_nearest_only_reduction
    (hcell : ∀ (T : FTy) (x : FV T), x.isfinite = true → x.iszero = false →
      x.signbit = false → MathNearestSqrtCell x (jlSqrtLlvm x)) :
    IEEEFullSquareRootContract := by
  apply early_sqrt_contract_reduction
  intro T x hf hz hs
  obtain ⟨hfin, hsign, hzero⟩ := early_sqrt_finite_positive x hf hz hs
  exact ⟨hfin, hsign, hzero, hcell T x hf hz hs⟩

theorem early_sqrt_midpoint_key_comparison
    (xn xd rn rd bn bd X R B D : Int)
    (hxd : 0 < xd) (hrd : 0 < rd) (hbd : 0 < bd) (hD : 0 < D)
    (hx : xn * D = X * xd) (hr : rn * D = R * rd) (hb : bn * D = B * bd) :
    (((rn * bd + bn * rd) ^ 2 * xd ≤ xn * (2 * rd * bd) ^ 2) ↔
      (R + B) ^ 2 ≤ 4 * X * D) ∧
    (((rn * bd + bn * rd) ^ 2 * xd = xn * (2 * rd * bd) ^ 2) ↔
      (R + B) ^ 2 = 4 * X * D) := by
  let F := rd ^ 2 * bd ^ 2 * xd
  have hF : 0 < F := Int.mul_pos (Int.mul_pos (Int.pow_pos hrd) (Int.pow_pos hbd)) hxd
  have hD2 : 0 < D ^ 2 := Int.pow_pos hD
  have hsum : (rn * bd + bn * rd) * D = (R + B) * (rd * bd) := by
    calc
      (rn * bd + bn * rd) * D = (rn * D) * bd + (bn * D) * rd := by
        rw [Int.add_mul]
        ac_rfl
      _ = (R * rd) * bd + (B * bd) * rd := by rw [hr, hb]
      _ = (R + B) * (rd * bd) := by rw [Int.add_mul]; ac_rfl
  have hleft : ((rn * bd + bn * rd) ^ 2 * xd) * D ^ 2 = (R + B) ^ 2 * F := by
    calc
      ((rn * bd + bn * rd) ^ 2 * xd) * D ^ 2 = ((rn * bd + bn * rd) * D) ^ 2 * xd := by
        simp only [Int.pow_succ, Int.pow_zero]
        ac_rfl
      _ = ((R + B) * (rd * bd)) ^ 2 * xd := by rw [hsum]
      _ = (R + B) ^ 2 * F := by
        dsimp only [F]
        simp only [Int.pow_succ, Int.pow_zero]
        ac_rfl
  have hright : (xn * (2 * rd * bd) ^ 2) * D ^ 2 = (4 * X * D) * F := by
    calc
      (xn * (2 * rd * bd) ^ 2) * D ^ 2 =
          (2 * 2) * D * (xn * D) * (rd ^ 2 * bd ^ 2) := by
        simp only [Int.pow_succ, Int.pow_zero]
        ac_rfl
      _ = (2 * 2) * D * (X * xd) * (rd ^ 2 * bd ^ 2) := by rw [hx]
      _ = (4 * X * D) * F := by
        dsimp only [F]
        change (4 : Int) * D * (X * xd) * (rd ^ 2 * bd ^ 2) = _
        ac_rfl
  constructor
  · calc
      _ ↔ ((rn * bd + bn * rd) ^ 2 * xd) * D ^ 2 ≤ (xn * (2 * rd * bd) ^ 2) * D ^ 2 :=
        (Int.mul_le_mul_right hD2).symm
      _ ↔ (R + B) ^ 2 * F ≤ (4 * X * D) * F := by rw [hleft, hright]
      _ ↔ (R + B) ^ 2 ≤ 4 * X * D := Int.mul_le_mul_right hF
  · calc
      _ ↔ ((rn * bd + bn * rd) ^ 2 * xd) * D ^ 2 = (xn * (2 * rd * bd) ^ 2) * D ^ 2 :=
        (Int.mul_eq_mul_right_iff (Int.ne_of_gt hD2)).symm
      _ ↔ (R + B) ^ 2 * F = (4 * X * D) * F := by rw [hleft, hright]
      _ ↔ (R + B) ^ 2 = 4 * X * D := Int.mul_eq_mul_right_iff (Int.ne_of_gt hF)

theorem early_sqrt_cell_of_keys {T : FTy} (x r : FV T)
    (hx : x.isfinite = true) (hr : r.isfinite = true)
    (hb : (prevfloat r).isfinite = true) (ha : (nextfloat r).isfinite = true)
    (hbn : 0 ≤ (prevfloat r).key)
    (hlo : (r.key + (prevfloat r).key) ^ 2 ≤ 4 * x.key * T.fmt.den)
    (hhi : 4 * x.key * T.fmt.den ≤ (r.key + (nextfloat r).key) ^ 2)
    (heven : ((r.key + (prevfloat r).key) ^ 2 = 4 * x.key * T.fmt.den ∨
      4 * x.key * T.fmt.den = (r.key + (nextfloat r).key) ^ 2) → r.toBits % 2 = 0) :
    MathNearestSqrtCell x r := by
  obtain ⟨hxd, hxr⟩ := Fl.toRat_key (good_fty T) x hx
  obtain ⟨hrd, hrr⟩ := Fl.toRat_key (good_fty T) r hr
  obtain ⟨hbd, hbr⟩ := Fl.toRat_key (good_fty T) (prevfloat r) hb
  obtain ⟨had, har⟩ := Fl.toRat_key (good_fty T) (nextfloat r) ha
  have hD : (0 : Int) < T.fmt.den := by exact_mod_cast T.fmt.den_pos
  have hxd' : (0 : Int) < x.toRat.2 := by omega
  have hrd' : (0 : Int) < r.toRat.2 := by omega
  have hbd' : (0 : Int) < (prevfloat r).toRat.2 := by omega
  have had' : (0 : Int) < (nextfloat r).toRat.2 := by omega
  have hbn' : 0 ≤ (prevfloat r).toRat.1 := by
    apply (Int.mul_le_mul_right hD).mp
    rw [Int.zero_mul, hbr]
    exact Int.mul_nonneg hbn (Int.le_of_lt hbd')
  have hl := early_sqrt_midpoint_key_comparison x.toRat.1 x.toRat.2 r.toRat.1
    r.toRat.2 (prevfloat r).toRat.1 (prevfloat r).toRat.2
    x.key r.key (prevfloat r).key T.fmt.den hxd' hrd' hbd' hD hxr hrr hbr
  have hu := early_sqrt_midpoint_key_comparison x.toRat.1 x.toRat.2 r.toRat.1
    r.toRat.2 (nextfloat r).toRat.1 (nextfloat r).toRat.2
    x.key r.key (nextfloat r).key T.fmt.den hxd' hrd' had' hD hxr hrr har
  refine ⟨hb, ha, hbn', Int.mul_pos (Int.mul_pos (by decide) hrd') hbd',
    Int.mul_pos (Int.mul_pos (by decide) hrd') had', hl.1.mpr hlo, ?_, ?_⟩
  · have hnot : ¬((r.key + (nextfloat r).key) ^ 2 < 4 * x.key * T.fmt.den) := by omega
    have hle :
        x.toRat.1 * (2 * (r.toRat.2 : Int) * (nextfloat r).toRat.2) ^ 2 ≤
          (r.toRat.1 * (nextfloat r).toRat.2 + (nextfloat r).toRat.1 * r.toRat.2) ^ 2 * x.toRat.2 := by
      have hleiff := hu.1
      have heqiff := hu.2
      by_cases hleft : (r.key + (nextfloat r).key) ^ 2 ≤ 4 * x.key * T.fmt.den
      · have heq : (r.key + (nextfloat r).key) ^ 2 = 4 * x.key * T.fmt.den := by omega
        exact Int.le_of_eq (heqiff.mpr heq).symm
      · have hnle : ¬((r.toRat.1 * (nextfloat r).toRat.2 + (nextfloat r).toRat.1 * r.toRat.2) ^ 2 * x.toRat.2 ≤
          x.toRat.1 * (2 * (r.toRat.2 : Int) * (nextfloat r).toRat.2) ^ 2) := by
          intro hh
          exact hleft (hleiff.mp hh)
        omega
    exact hle
  · intro heq
    apply heven
    rcases heq with hlower | hupper
    · exact Or.inl (hl.2.mp hlower)
    · exact Or.inr (hu.2.mp hupper.symm).symm

/-- Adjacent-value facts for a positive normal encoding, kept away from the
largest exponent. Keys use the format's exact common dyadic denominator. -/
theorem early_sqrt_normal_neighbors (T : FTy) (B f : Nat)
    (hB : 2 ≤ B) (hBhi : B + 2 < T.fmt.emax) (hf : f < 2 ^ T.fmt.sb) :
    let r := NextProofs.encode T false (B * 2 ^ T.fmt.sb + f)
    r.isfinite = true ∧ (prevfloat r).isfinite = true ∧ (nextfloat r).isfinite = true ∧
    0 ≤ (prevfloat r).key ∧
    r.key = (((f + 2 ^ T.fmt.sb) * 2 ^ (B - 1) : Nat) : Int) ∧
    (nextfloat r).key = r.key + ((2 ^ (B - 1) : Nat) : Int) ∧
    (prevfloat r).key = r.key - ((2 ^ (if f = 0 then B - 2 else B - 1) : Nat) : Int) ∧
    r.toBits % 2 = f % 2 := by
  let P := 2 ^ T.fmt.sb
  let M := B * P + f
  have hp : 0 < P := Nat.two_pow_pos _
  have hprod : 0 < B * P := Nat.mul_pos (by omega) hp
  have hm0 : 0 < M := by dsimp [M]; omega
  have hmHi : M + 1 < NextProofs.infMag T := by
    have hstep : M + 1 ≤ (B + 1) * P := by dsimp [M]; rw [Nat.add_mul, Nat.one_mul]; omega
    have hcap := Nat.mul_lt_mul_of_pos_right (show B + 1 < T.fmt.emax by omega) hp
    exact Nat.lt_of_le_of_lt hstep hcap
  have hm : M < NextProofs.infMag T := by omega
  have hmPrev : M - 1 < NextProofs.infMag T := by omega
  have hsM : M < NextProofs.signMask T := Nat.lt_trans hm (NextProofs.infMag_lt_signMask T)
  have hsNext : M + 1 < NextProofs.signMask T := Nat.lt_trans hmHi (NextProofs.infMag_lt_signMask T)
  have hsPrev : M - 1 < NextProofs.signMask T := Nat.lt_trans hmPrev (NextProofs.infMag_lt_signMask T)
  have hrfin := EpsilonNeighborProofs.encode_finite T false M hm
  have hrsgn := NextProofs.sign_encode T false hsM
  have hrmag := NextProofs.mag_encode T false hsM
  have hneighbors := EpsilonNeighborProofs.finite_neighbors
    (NextProofs.encode T false M) hrfin (by rw [hrmag]; exact hm0)
  simp only [hrsgn, hrmag, Bool.false_eq_true, ↓reduceIte] at hneighbors
  have hnextfin := EpsilonNeighborProofs.encode_finite T false (M + 1) hmHi
  have hprevfin := EpsilonNeighborProofs.encode_finite T false (M - 1) hmPrev
  have hkey := EpsilonNeighborProofs.encode_key T false M hsM
  have hnextkey := EpsilonNeighborProofs.encode_key T false (M + 1) hsNext
  have hprevkey := EpsilonNeighborProofs.encode_key T false (M - 1) hsPrev
  simp only [Bool.false_eq_true, ↓reduceIte] at hkey hnextkey hprevkey
  have hdiv : M / P = B := by
    dsimp [M]
    rw [Nat.add_comm, Nat.add_mul_div_right _ _ hp, Nat.div_eq_of_lt hf, Nat.zero_add]
  have hprevdiv : (M - 1) / P = if f = 0 then B - 1 else B := by
    by_cases hf0 : f = 0
    · have hBP : B * P = (B - 1) * P + P := by
        calc
          B * P = ((B - 1) + 1) * P := by congr 1; omega
          _ = (B - 1) * P + P := by rw [Nat.add_mul, Nat.one_mul]
      have hrepr : M - 1 = (B - 1) * P + (P - 1) := by dsimp [M]; rw [hf0]; omega
      rw [hrepr, Nat.add_comm, Nat.add_mul_div_right _ _ hp,
        Nat.div_eq_of_lt (by omega : P - 1 < P), Nat.zero_add, ite_eq_left hf0]
    · have hrepr : M - 1 = B * P + (f - 1) := by dsimp [M]; omega
      rw [hrepr, Nat.add_comm, Nat.add_mul_div_right _ _ hp,
        Nat.div_eq_of_lt (by omega : f - 1 < P), Nat.zero_add, ite_eq_right hf0]
  have hnextgap := EpsilonNeighborProofs.magKey_next T.fmt M
  have hprevgap := EpsilonNeighborProofs.magKey_next T.fmt (M - 1)
  rw [show M - 1 + 1 = M by omega] at hprevgap
  change ((magKey T.fmt (M + 1) : Nat) : Int) - ((magKey T.fmt M : Nat) : Int) =
    ((2 ^ (M / P - 1) : Nat) : Int) at hnextgap
  change ((magKey T.fmt M : Nat) : Int) - ((magKey T.fmt (M - 1) : Nat) : Int) =
    ((2 ^ ((M - 1) / P - 1) : Nat) : Int) at hprevgap
  rw [hdiv] at hnextgap
  rw [hprevdiv] at hprevgap
  have hprevexp : (if f = 0 then B - 1 else B) - 1 =
      if f = 0 then B - 2 else B - 1 := by split <;> omega
  rw [hprevexp] at hprevgap
  have hnormal := JuliaLean.Proofs.base.math.mfMagKeyNormal T B f (by omega) hf
  change magKey T.fmt M = (f + P) * 2 ^ (B - 1) at hnormal
  have hbits := NextProofs.tb_encode T false hsM
  simp only [Bool.false_eq_true, ↓reduceIte, Nat.zero_add] at hbits
  have hevenP : P % 2 = 0 := by cases T <;> decide
  change (NextProofs.encode T false M).isfinite = true ∧ _
  rw [hneighbors.1, hneighbors.2]
  refine ⟨hrfin, hprevfin, hnextfin, ?_, ?_, ?_, ?_, ?_⟩
  · rw [hprevkey]
    omega
  · rw [hkey, hnormal]
  · rw [hkey, hnextkey]
    omega
  · rw [hkey, hprevkey]
    omega
  · rw [hbits]
    dsimp only [M]
    simp only [Nat.add_mod, Nat.mul_mod, hevenP, Nat.mul_zero, Nat.zero_mod, Nat.zero_add,
      Nat.mod_mod]

theorem early_sqrt_twice_square (a : Int) : (2 * a) ^ 2 = 4 * a ^ 2 := by
  simp only [Int.pow_succ, Int.pow_zero, Int.one_mul]
  calc
    2 * a * (2 * a) = (2 * 2) * (a * a) := by ac_rfl
    _ = 4 * (a * a) := rfl

theorem early_sqrt_packed_cell (T : FTy) (x : FV T) (t B : Nat)
    (hx : x.isfinite = true) (htlo : 2 ^ T.fmt.sb ≤ t)
    (hthi : t ≤ 2 ^ (T.fmt.sb + 1)) (hB : 2 ≤ B) (hBhi : B + 3 < T.fmt.emax)
    (hbase : ((2 ^ T.fmt.sb : Nat) * (2 ^ (B - 1) : Nat) : Int) ^ 2 ≤ x.key * T.fmt.den)
    (hlo : ((2 * (t : Int) - 1) * (2 ^ (B - 1) : Nat)) ^ 2 ≤ 4 * x.key * T.fmt.den)
    (hhi : 4 * x.key * T.fmt.den ≤ ((2 * (t : Int) + 1) * (2 ^ (B - 1) : Nat)) ^ 2)
    (heven : (((2 * (t : Int) - 1) * (2 ^ (B - 1) : Nat)) ^ 2 = 4 * x.key * T.fmt.den ∨
      4 * x.key * T.fmt.den = ((2 * (t : Int) + 1) * (2 ^ (B - 1) : Nat)) ^ 2) →
      t % 2 = 0) :
    MathNearestSqrtCell x (Fl.packRounded false t ((B : Int) - T.fmt.bias - T.fmt.sb)) := by
  let P := 2 ^ T.fmt.sb
  let U := 2 ^ (B - 1)
  have hp : 0 < P := Nat.two_pow_pos _
  have hu : 0 < U := Nat.two_pow_pos _
  have hcap : 2 ^ (T.fmt.sb + 1) = 2 * P := by dsimp [P]; rw [Nat.pow_succ, Nat.mul_comm]
  have hevenP : P % 2 = 0 := by cases T <;> decide
  by_cases ht : t < 2 ^ (T.fmt.sb + 1)
  · have hfrac : t - P < P := by rw [hcap] at ht; omega
    have hkhi : (B : Int) - T.fmt.bias - T.fmt.sb + T.fmt.bias + T.fmt.sb < T.fmt.emax := by omega
    have hBnat : ((B : Int) - T.fmt.bias - T.fmt.sb + T.fmt.bias + T.fmt.sb).toNat = B := by omega
    have hpack : (Fl.packRounded false t ((B : Int) - T.fmt.bias - T.fmt.sb) : FV T) =
        NextProofs.encode T false (B * P + (t - P)) := by
      rw [Fl.packRounded_normal false t _ htlo ht hkhi, hBnat]
      rfl
    rw [hpack]
    let r := NextProofs.encode T false (B * P + (t - P))
    obtain ⟨hr, hb, ha, hbn, hkey, hnkey, hbkey, hbits⟩ :=
      early_sqrt_normal_neighbors T B (t - P) hB (by omega) hfrac
    change r.key = _ at hkey
    change 0 ≤ (prevfloat r).key at hbn
    change (nextfloat r).key = r.key + (U : Int) at hnkey
    change (prevfloat r).key = r.key - ((2 ^ (if t - P = 0 then B - 2 else B - 1) : Nat) : Int) at hbkey
    have hrkey : r.key = (t : Int) * (U : Int) := by
      rw [hkey]
      have he : t - P + P = t := by omega
      change (((t - P + P) * U : Nat) : Int) = _
      rw [he, Int.natCast_mul]
    have hparity : r.toBits % 2 = t % 2 := by
      rw [hbits]
      omega
    have hsumhi : r.key + (nextfloat r).key = (2 * (t : Int) + 1) * (U : Int) := by
      rw [hnkey, hrkey]
      change (t : Int) * U + ((t : Int) * U + U) = _
      rw [Int.add_mul, Int.one_mul, Int.mul_assoc]
      omega
    apply early_sqrt_cell_of_keys x r hx hr hb ha hbn
    · by_cases he : t = P
      · have hnonneg : 0 ≤ r.key + (prevfloat r).key := by
          rw [hrkey]
          exact Int.add_nonneg (Int.mul_nonneg (Int.natCast_nonneg _) (Int.natCast_nonneg _)) hbn
        have hle : r.key + (prevfloat r).key ≤ 2 * r.key := by
          rw [hbkey]
          have hpw : (0 : Int) ≤ ((2 ^ (if t - P = 0 then B - 2 else B - 1) : Nat) : Int) := Int.natCast_nonneg _
          omega
        have hsq := Int.mul_self_le_mul_self hnonneg hle
        have hsq : (r.key + (prevfloat r).key) ^ 2 ≤ (2 * r.key) ^ 2 := by
          simpa only [Int.pow_succ, Int.pow_zero, Int.one_mul] using hsq
        rw [early_sqrt_twice_square] at hsq
        have hbase' : r.key ^ 2 ≤ x.key * T.fmt.den := by
          rw [hrkey, he]
          exact hbase
        have hmul := Int.mul_le_mul_of_nonneg_left hbase' (by decide : (0 : Int) ≤ 4)
        rw [← Int.mul_assoc] at hmul
        omega
      · have hf0 : t - P ≠ 0 := by omega
        have hsumlo : r.key + (prevfloat r).key = (2 * (t : Int) - 1) * (U : Int) := by
          rw [hbkey, ite_eq_right hf0, hrkey]
          change (t : Int) * U + ((t : Int) * U - U) = _
          rw [Int.sub_mul, Int.one_mul, Int.mul_assoc]
          omega
        rw [hsumlo]
        exact hlo
    · rw [hsumhi]
      exact hhi
    · intro htie
      rw [hparity]
      by_cases he : t = P
      · rw [he]
        exact hevenP
      · have hf0 : t - P ≠ 0 := by omega
        have hsumlo : r.key + (prevfloat r).key = (2 * (t : Int) - 1) * (U : Int) := by
          rw [hbkey, ite_eq_right hf0, hrkey]
          change (t : Int) * U + ((t : Int) * U - U) = _
          rw [Int.sub_mul, Int.one_mul, Int.mul_assoc]
          omega
        rw [hsumlo, hsumhi] at htie
        exact heven htie
  · have hte : t = 2 * P := by rw [hcap] at hthi ht; omega
    have hP0 : P ≠ 0 := Nat.ne_of_gt hp
    have hP2 : (2 * P) / 2 = P := by rw [Nat.mul_comm, Nat.mul_div_cancel _ (by decide : 0 < 2)]
    have he : (B : Int) - T.fmt.bias - T.fmt.sb + 1 + T.fmt.bias + T.fmt.sb = B + 1 := by omega
    have hpack : (Fl.packRounded false t ((B : Int) - T.fmt.bias - T.fmt.sb) : FV T) =
        NextProofs.encode T false ((B + 1) * P) := by
      simp only [Fl.packRounded, hte, hcap, Nat.mul_eq_zero, hP0, Nat.succ_ne_zero,
        beq_iff_eq, or_self, ↓reduceIte, Nat.le_refl, hP2, he,
        show ¬((B : Int) + 1 ≥ T.fmt.emax) by omega]
      simp only [show ¬P < 2 ^ T.fmt.sb from Nat.lt_irrefl _, ↓reduceIte]
      simp only [Bool.false_eq_true, ↓reduceIte, Nat.zero_add]
      change Fl.ofBits (((B : Int) + 1).toNat * P + (P - P)) = _
      have hB1 : ((B : Int) + 1).toNat = B + 1 := by omega
      rw [hB1, Nat.sub_self, Nat.add_zero]
      simp only [NextProofs.encode, Bool.false_eq_true, ↓reduceIte, Nat.zero_add]
    rw [hpack]
    let r := NextProofs.encode T false ((B + 1) * P)
    obtain ⟨hr, hb, ha, hbn, hkey, hnkey, hbkey, hbits⟩ :=
      early_sqrt_normal_neighbors T (B + 1) 0 (by omega) (by omega) hp
    simp only [Nat.add_zero, Nat.zero_add, ite_true] at hr hb ha hbn hkey hnkey hbkey hbits
    have hpow : 2 ^ B = 2 * U := by
      calc
        2 ^ B = 2 ^ ((B - 1) + 1) := by congr 1; omega
        _ = 2 * U := by rw [Nat.pow_succ, Nat.mul_comm]
    have hrkey : r.key = (t : Int) * (U : Int) := by
      rw [hkey]
      simp only [Nat.add_sub_cancel, hpow, Int.natCast_mul, hte]
      change (P : Int) * ((2 : Int) * U) = ((2 : Int) * P) * U
      ac_rfl
    have hbefore : (prevfloat r).key = r.key - (U : Int) := by
      simpa only [show B + 1 - 2 = B - 1 by omega] using hbkey
    have hafter : (nextfloat r).key = r.key + 2 * (U : Int) := by
      simpa only [Nat.add_sub_cancel, hpow, Int.natCast_mul, show ((2 : Nat) : Int) = 2 from rfl] using hnkey
    have hsumlo : r.key + (prevfloat r).key = (2 * (t : Int) - 1) * (U : Int) := by
      rw [hbefore, hrkey, Int.sub_mul, Int.one_mul, Int.mul_assoc]
      omega
    have hsumhi : r.key + (nextfloat r).key = (2 * (t : Int) + 2) * (U : Int) := by
      rw [hafter, hrkey, Int.add_mul, Int.mul_assoc]
      omega
    apply early_sqrt_cell_of_keys x r hx hr hb ha hbn
    · rw [hsumlo]
      exact hlo
    · rw [hsumhi]
      have hlow : (0 : Int) ≤ (2 * (t : Int) + 1) * (U : Int) :=
        Int.mul_nonneg (by omega) (by omega)
      have hstep : (2 * (t : Int) + 1) * (U : Int) ≤ (2 * (t : Int) + 2) * (U : Int) :=
        Int.mul_le_mul_of_nonneg_right (by omega) (by omega)
      have hsq := Int.mul_self_le_mul_self hlow hstep
      have hsq : ((2 * (t : Int) + 1) * (U : Int)) ^ 2 ≤ ((2 * (t : Int) + 2) * (U : Int)) ^ 2 := by
        simpa only [Int.pow_succ, Int.pow_zero, Int.one_mul] using hsq
      exact Int.le_trans hhi hsq
    · intro _
      exact hbits

/-- The integer ratio used by the square-root search is exactly the input
key divided by the square of its output grid step. -/
theorem early_sqrt_dyadic_key_scaling (X n j c : Nat) (k : Int)
    (hx : X * 2 ^ j = n * 2 ^ c) (hk : 0 ≤ k + c) :
    let scaled := if 2 * k ≥ 0 then (n, 2 ^ j * 2 ^ (2 * k).toNat)
      else (n * 2 ^ (-2 * k).toNat, 2 ^ j)
    X * 2 ^ c * scaled.2 = scaled.1 * 2 ^ (k + c).toNat * 2 ^ (k + c).toNat := by
  dsimp only
  split
  · rename_i hkpos
    dsimp only
    calc
      X * 2 ^ c * (2 ^ j * 2 ^ (2 * k).toNat) =
          (X * 2 ^ j) * (2 ^ c * 2 ^ (2 * k).toNat) := by ac_rfl
      _ = (n * 2 ^ c) * (2 ^ c * 2 ^ (2 * k).toNat) := by rw [hx]
      _ = n * 2 ^ (c + c + (2 * k).toNat) := by
        rw [Nat.pow_add, Nat.pow_add]
        ac_rfl
      _ = n * 2 ^ ((k + c).toNat + (k + c).toNat) := by congr 2; omega
      _ = n * 2 ^ (k + c).toNat * 2 ^ (k + c).toNat := by
        rw [Nat.pow_add, Nat.mul_assoc]
  · rename_i hkneg
    dsimp only
    calc
      X * 2 ^ c * 2 ^ j = (X * 2 ^ j) * 2 ^ c := by ac_rfl
      _ = (n * 2 ^ c) * 2 ^ c := by rw [hx]
      _ = n * 2 ^ (c + c) := by rw [Nat.pow_add, Nat.mul_assoc]
      _ = n * 2 ^ ((-2 * k).toNat + (k + c).toNat + (k + c).toNat) := by congr 2; omega
      _ = n * 2 ^ (-2 * k).toNat * 2 ^ (k + c).toNat * 2 ^ (k + c).toNat := by
        rw [Nat.pow_add, Nat.pow_add]
        ac_rfl

/-- Cancellation lemma transporting exact scaled square comparisons back to
keys. It also preserves equality, so the tie-to-even condition is transported. -/
theorem early_sqrt_scaled_comparison (N d K U a z : Int)
    (hd : 0 < d) (hU : 0 < U) (hscale : K * d = N * U ^ 2) :
    (a ^ 2 * d ≤ z * N ↔ (a * U) ^ 2 ≤ z * K) ∧
    (z * N ≤ a ^ 2 * d ↔ z * K ≤ (a * U) ^ 2) ∧
    (a ^ 2 * d = z * N ↔ (a * U) ^ 2 = z * K) := by
  have hU2 : 0 < U ^ 2 := Int.pow_pos hU
  have hleft : (a ^ 2 * d) * U ^ 2 = (a * U) ^ 2 * d := by
    simp only [Int.pow_succ, Int.pow_zero]
    ac_rfl
  have hright : (z * N) * U ^ 2 = (z * K) * d := by
    calc
      (z * N) * U ^ 2 = z * (N * U ^ 2) := by ac_rfl
      _ = z * (K * d) := by rw [← hscale]
      _ = (z * K) * d := by ac_rfl
  refine ⟨?_, ?_, ?_⟩
  · calc
      _ ↔ (a ^ 2 * d) * U ^ 2 ≤ (z * N) * U ^ 2 := (Int.mul_le_mul_right hU2).symm
      _ ↔ (a * U) ^ 2 * d ≤ (z * K) * d := by rw [hleft, hright]
      _ ↔ (a * U) ^ 2 ≤ z * K := Int.mul_le_mul_right hd
  · calc
      _ ↔ (z * N) * U ^ 2 ≤ (a ^ 2 * d) * U ^ 2 := (Int.mul_le_mul_right hU2).symm
      _ ↔ (z * K) * d ≤ (a * U) ^ 2 * d := by rw [hleft, hright]
      _ ↔ z * K ≤ (a * U) ^ 2 := Int.mul_le_mul_right hd
  · calc
      _ ↔ (a ^ 2 * d) * U ^ 2 = (z * N) * U ^ 2 :=
        (Int.mul_eq_mul_right_iff (Int.ne_of_gt hU2)).symm
      _ ↔ (a * U) ^ 2 * d = (z * K) * d := by rw [hleft, hright]
      _ ↔ (a * U) ^ 2 = z * K := Int.mul_eq_mul_right_iff (Int.ne_of_gt hd)

/-- Correct rounding of the faithful square-root intrinsic for every positive
finite IEEE input, including subnormal inputs and significand carries. -/
theorem early_sqrt_complete_cell {T : FTy} (x : FV T)
    (hf : x.isfinite = true) (hz : x.iszero = false) (hs : x.signbit = false) :
    MathNearestSqrtCell x (jlSqrtLlvm x) := by
  obtain ⟨n, j, hrat, hn, hmin, hmax⟩ := early_sqrt_input_dyadic x hf hz hs
  let e : Int := (n.log2 : Int) - j
  let k := e / 2 - T.fmt.sb
  let scaled := if 2 * k ≥ 0 then (n, 2 ^ j * 2 ^ (2 * k).toNat)
    else (n * 2 ^ (-2 * k).toNat, 2 ^ j)
  let q := sqrtFloorRatio scaled.1 scaled.2 (T.fmt.sb + 2) 0 (2 ^ (T.fmt.sb + 1) + 1)
  let rounded := if 4 * scaled.1 > (2 * q + 1) ^ 2 * scaled.2 ||
      (4 * scaled.1 == (2 * q + 1) ^ 2 * scaled.2 && q % 2 == 1)
    then q + 1 else q
  have hscale := early_sqrt_scaling n j T.fmt.sb hn
  change 0 < scaled.2 ∧ _ at hscale
  have hq := early_sqrt_search_normalized scaled.1 scaled.2 T.fmt.sb hscale.1
    hscale.2.1 hscale.2.2
  change 2 ^ T.fmt.sb ≤ q ∧ q < 2 ^ (T.fmt.sb + 1) ∧ _ at hq
  have hrlo : 2 ^ T.fmt.sb ≤ rounded := by dsimp only [rounded]; split <;> omega
  have hrhi : rounded ≤ 2 ^ (T.fmt.sb + 1) := by dsimp only [rounded]; split <;> omega
  have hp := Nat.two_pow_pos T.fmt.sb
  have hmid := early_sqrt_integer_midpoint scaled.1 scaled.2 q hscale.1 (by omega) hq.2.2.1 hq.2.2.2
  change (2 * rounded - 1) ^ 2 * scaled.2 ≤ 4 * scaled.1 ∧ _ at hmid
  have hklo : 2 ≤ k + T.fmt.bias + T.fmt.sb := by
    dsimp only [k, e]
    cases T <;> simp only [FTy.fmt, JuliaLean.Promotion.half,
      JuliaLean.Promotion.single, JuliaLean.Promotion.double,
      JuliaLean.Promotion.Fmt.bias] at hmin hmax ⊢ <;> omega
  have hkhi : k + T.fmt.bias + T.fmt.sb + 3 < T.fmt.emax := by
    dsimp only [k, e]
    cases T <;> simp only [FTy.fmt, JuliaLean.Promotion.half,
      JuliaLean.Promotion.single, JuliaLean.Promotion.double,
      JuliaLean.Promotion.Fmt.bias, JuliaLean.Promotion.Fmt.emax] at hmin hmax ⊢ <;> omega
  let B := (k + T.fmt.bias + T.fmt.sb).toNat
  let c := T.fmt.bias + T.fmt.sb - 1
  let U := 2 ^ (B - 1)
  let X := magKey T.fmt x.magnitude
  have hBcast : (B : Int) = k + T.fmt.bias + T.fmt.sb := by dsimp [B]; omega
  have hB : 2 ≤ B := by omega
  have hBhi : B + 3 < T.fmt.emax := by omega
  have hc : (c : Int) = (T.fmt.bias : Int) + T.fmt.sb - 1 := by
    have hbs : 1 ≤ T.fmt.bias + T.fmt.sb := by cases T <;> decide
    dsimp [c]
    omega
  have hkpos : 0 ≤ k + c := by omega
  have huExp : (k + c).toNat = B - 1 := by omega
  have hkey : x.key = (X : Int) := by simp only [Fl.key, hs, Bool.false_eq_true, ↓reduceIte]; rfl
  have hkeyrat := (Fl.toRat_key (good_fty T) x hf).2
  rw [hrat, hkey] at hkeyrat
  change (n : Int) * ((2 ^ c : Nat) : Int) = (X : Int) * ((2 ^ j : Nat) : Int) at hkeyrat
  have hkeynat : X * 2 ^ j = n * 2 ^ c := by exact_mod_cast hkeyrat.symm
  have hscaleNat := early_sqrt_dyadic_key_scaling X n j c k hkeynat hkpos
  change X * 2 ^ c * scaled.2 = scaled.1 * 2 ^ (k + c).toNat * 2 ^ (k + c).toNat at hscaleNat
  rw [huExp] at hscaleNat
  have hscaleKey : (x.key * (T.fmt.den : Int)) * (scaled.2 : Int) =
      (scaled.1 : Int) * (U : Int) ^ 2 := by
    rw [hkey]
    have he : X * 2 ^ c * scaled.2 = scaled.1 * U ^ 2 := by
      rw [Nat.pow_two]
      exact hscaleNat.trans (Nat.mul_assoc _ _ _)
    exact_mod_cast he
  have hd : (0 : Int) < scaled.2 := by omega
  have hu : (0 : Int) < U := by exact_mod_cast (Nat.two_pow_pos (B - 1))
  have hbaseCmp := early_sqrt_scaled_comparison scaled.1 scaled.2
    (x.key * T.fmt.den) U (2 ^ T.fmt.sb : Nat) 1 hd hu hscaleKey
  have hlowCmp := early_sqrt_scaled_comparison scaled.1 scaled.2
    (x.key * T.fmt.den) U (2 * (rounded : Int) - 1) 4 hd hu hscaleKey
  have hhighCmp := early_sqrt_scaled_comparison scaled.1 scaled.2
    (x.key * T.fmt.den) U (2 * (rounded : Int) + 1) 4 hd hu hscaleKey
  have hcastLo : ((2 * rounded - 1 : Nat) : Int) = 2 * (rounded : Int) - 1 := by omega
  have hbase : ((2 ^ T.fmt.sb : Nat) * (U : Int)) ^ 2 ≤ x.key * T.fmt.den := by
    have hh : ((2 ^ T.fmt.sb : Nat) : Int) ^ 2 * (scaled.2 : Int) ≤ 1 * (scaled.1 : Int) := by
      have hh' : (2 ^ T.fmt.sb) ^ 2 * scaled.2 ≤ scaled.1 := by
        simpa only [Nat.pow_two] using hscale.2.1
      simpa only [Int.one_mul] using (show ((2 ^ T.fmt.sb : Nat) : Int) ^ 2 * (scaled.2 : Int) ≤
        (scaled.1 : Int) by exact_mod_cast hh')
    simpa only [Int.one_mul] using hbaseCmp.1.mp hh
  have hlo : ((2 * (rounded : Int) - 1) * (U : Int)) ^ 2 ≤ 4 * x.key * T.fmt.den := by
    have hh : (2 * (rounded : Int) - 1) ^ 2 * (scaled.2 : Int) ≤ 4 * (scaled.1 : Int) := by
      rw [← hcastLo]
      exact_mod_cast hmid.1
    simpa only [Int.mul_assoc] using hlowCmp.1.mp hh
  have hhi : 4 * x.key * T.fmt.den ≤ ((2 * (rounded : Int) + 1) * (U : Int)) ^ 2 := by
    have hh : 4 * (scaled.1 : Int) ≤ (2 * (rounded : Int) + 1) ^ 2 * (scaled.2 : Int) := by
      exact_mod_cast hmid.2.1
    simpa only [Int.mul_assoc] using hhighCmp.2.1.mp hh
  have heven : (((2 * (rounded : Int) - 1) * (U : Int)) ^ 2 = 4 * x.key * T.fmt.den ∨
      4 * x.key * T.fmt.den = ((2 * (rounded : Int) + 1) * (U : Int)) ^ 2) → rounded % 2 = 0 := by
    intro heq
    apply hmid.2.2
    rcases heq with hloeq | hhieq
    · apply Or.inl
      have he := hlowCmp.2.2.mpr (by simpa only [Int.mul_assoc] using hloeq)
      rw [← hcastLo] at he
      exact_mod_cast he
    · apply Or.inr
      have he := hhighCmp.2.2.mpr (by simpa only [Int.mul_assoc] using hhieq.symm)
