    (hs : ∀ z ∈ xs, z.signbit = false) (hn : xs.any fisnan = true) :
    ∃ m, JuliaLean.base.reduce.maximum_f
      (JuliaLean.Bindings.base.math.reduceOps T).iteratorEltype
