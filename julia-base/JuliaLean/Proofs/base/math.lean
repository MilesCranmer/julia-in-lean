    d.isfinite = true ∧ d.signbit = false ∧ d.iszero = false ∧ d.key = 2 * h.key := by
  let q := early_hypot64_scaled a b
  let h := jlSqrtLlvm (JuliaLean.base.float.muladd_IEEEFloat q.1 q.1 (mul q.2.1 q.2.1))
  have hh := early_hypot_scaled_sqrt_interval a b ha hb hsa hsb hba hcutoff
