theorem generic_native_flip_abs {T : JuliaLean.base.float.FTy} (x : JuliaLean.base.float.FV T)
    (hx : x.isfinite = true) : nativeNearestFlipSign T (fabs x) x = x := by
  obtain ⟨haf, -⟩ := mfAbsKey x hx
  have ham : (fabs x).magnitude = x.magnitude := by
    change (abs_float x).magnitude = x.magnitude
    rw [RemainderProofs.abs_encoded x hx, NextProofs.mag_encode T false (Fl.bits_split x).2]
  have has := generic_abs_sign_all x
