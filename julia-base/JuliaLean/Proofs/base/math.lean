theorem generic_native_nearest_infinite
    (machine : JuliaLean.Bindings.base.math.Machine) {T : JuliaLean.base.float.FTy}
    (x y : JuliaLean.base.float.FV T) (hx : x.isfinite = true) (hy : y.isinf = true) :
