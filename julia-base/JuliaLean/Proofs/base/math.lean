      have hrepr : n = (n.natAbs : Int) := by omega
      have hmag : (Fl.roundRat n (2 ^ j) false : hypot_ScaleVal).magnitude ≤ 0x7990000000000000 := by
        rw [hrepr]
        apply Nat.le_trans hb.2.1
        change (((n.natAbs.log2 : Int) - j + 1023).toNat + 1) * 4503599627370496 ≤ 0x7990000000000000
