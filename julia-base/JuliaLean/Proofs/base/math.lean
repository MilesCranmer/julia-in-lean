/-- Binade 460 consists of exact integers on the 2^408 lattice. -/
theorem hypot_boundary_binade_rat (a : hypot_BoundaryVal)
    (hs : a.signbit = false) (he : a.expField = 1483) :
    a.isfinite = true ∧
    a.toRat = ((((a.frac + 2 ^ 52) * 2 ^ 408 : Nat) : Int), 1) := by
  have hf : a.isfinite = true := by
    simp only [Fl.isfinite, he]
    decide
  refine ⟨hf, ?_⟩
  simp only [Fl.toRat, hf, Bool.not_true, Bool.false_eq_true, ↓reduceIte, he, hs]
  rfl

/-- A dyadic integer with denominator one has its direct scaled-key interpretation. -/
theorem hypot_boundary_integer_from_rat (a : hypot_BoundaryVal) (N : Int)
    (hf : a.isfinite = true) (hr : a.toRat = (N, 1)) :
    hypot_boundary_integer a N := by
  have hk := (Fl.toRat_key (good_fty .f64) a hf).2
  rw [hr] at hk
  simp only [Int.natCast_one, Int.mul_one] at hk
  exact ⟨hf, hk.symm⟩

/-- Normal rounded integers above binade867 lie on the 2^816 lattice. -/
theorem hypot_boundary_rounded_lattice (N : Nat) (z : Bool) (Y : Int)
    (hN : N ≠ 0) (hlo : 868 ≤ N.log2) (hhi : N.log2 < 1024)
    (hY : hypot_boundary_integer (Fl.roundRat (N : Int) 1 z) Y) :
    ∃ J : Int, Y = J * ((2 ^ 816 : Nat) : Int) := by
  have hn : (N : Int) ≠ 0 := by omega
  have hk := FloatRoundDirections.roundRat_integer_key .f64 (N : Int) z hn
    (by rw [Int.natAbs_natCast]; change N.log2 + 1023 < 2047; omega)
    (by rw [Int.natAbs_natCast]; change 52 ≤ N.log2; omega)
  simp only [Int.natAbs_natCast, ite_eq_right (by omega : ¬ (N : Int) < 0)] at hk
  change (Fl.roundRat (N : Int) 1 z : hypot_BoundaryVal).key =
    ((Fl.roundQuotient N (2 ^ (N.log2 - 52)) * 2 ^ (N.log2 - 52) *
      JuliaLean.base.float.FTy.f64.fmt.den : Nat) : Int) at hk
  have hpow : 2 ^ (N.log2 - 52) = 2 ^ (N.log2 - 868) * 2 ^ 816 := by
    rw [← Nat.pow_add]
    congr 1
    omega
  refine ⟨((Fl.roundQuotient N (2 ^ (N.log2 - 52)) * 2 ^ (N.log2 - 868) : Nat) : Int), ?_⟩
  apply Int.eq_of_mul_eq_mul_right (by decide : (JuliaLean.base.float.FTy.f64.fmt.den : Int) ≠ 0)
  rw [← hY.2, hk]
  change ((Fl.roundQuotient N (2 ^ (N.log2 - 52)) * 2 ^ (N.log2 - 52) *
    JuliaLean.base.float.FTy.f64.fmt.den : Nat) : Int) = _
  rw [hpow]
  simp only [Int.natCast_mul, Int.mul_assoc]


/-- Squaring a normalized 53-bit significand at exponent408 has binade920 or921. -/
theorem hypot_boundary_significand_square_bounds (c : Nat)
    (hc : 2 ^ 52 ≤ c ∧ c < 2 ^ 53) :
    2 ^ 920 ≤ (c * 2 ^ 408) * (c * 2 ^ 408) ∧
    (c * 2 ^ 408) * (c * 2 ^ 408) < 2 ^ 922 := by
  let m := c * 2 ^ 408
  have hmlo : 2 ^ 460 ≤ m := by
    have h := Nat.mul_le_mul_right (2 ^ 408) hc.1
    change 2 ^ 460 ≤ c * 2 ^ 408
    simpa only [← Nat.pow_add] using h
  have hmhi : m < 2 ^ 461 := by
    have h := Nat.mul_lt_mul_of_pos_right hc.2 (Nat.two_pow_pos 408)
    change c * 2 ^ 408 < 2 ^ 461
    simpa only [← Nat.pow_add] using h
  constructor
  · have h := Nat.mul_le_mul hmlo hmlo
    simpa only [← Nat.pow_add] using h
  · have h1 := Nat.mul_lt_mul_of_pos_left hmhi (by omega : 0 < m)
    have h2 := Nat.mul_lt_mul_of_pos_right hmhi (Nat.two_pow_pos 461)
    have h := Nat.lt_trans h1 h2
    simpa only [← Nat.pow_add] using h

/-- Exact integer square on the critical residual lattice. -/
theorem hypot_boundary_square_scale (c : Nat) :
    (((c * 2 ^ 408 : Nat) : Int) * ((c * 2 ^ 408 : Nat) : Int)) =
      ((c * c : Nat) : Int) * ((2 ^ 816 : Nat) : Int) := by
  have hp : (2 ^ 408 : Nat) * 2 ^ 408 = 2 ^ 816 := by decide
  have hnat : (c * 2 ^ 408) * (c * 2 ^ 408) = c * c * 2 ^ 816 := by
    calc
      c * 2 ^ 408 * (c * 2 ^ 408) = c * c * (2 ^ 408 * 2 ^ 408) := by ac_rfl
      _ = c * c * 2 ^ 816 := by rw [hp]
  simpa only [Int.natCast_mul] using congrArg (fun n : Nat => (n : Int)) hnat

/-- The source product in this binade rounds an exact integer square. -/
theorem hypot_boundary_binade_round_square (a : hypot_BoundaryVal)
    (hs : a.signbit = false) (he : a.expField = 1483) :
    mul a a = Fl.roundRat
      (((((a.frac + 2 ^ 52) * 2 ^ 408) * ((a.frac + 2 ^ 52) * 2 ^ 408)) : Nat) : Int) 1 false := by
  have harat := hypot_boundary_binade_rat a hs he
  change mul_float a a = _
  rw [mfMulRat a a harat.1 harat.1, harat.2]
  simp only [Int.natCast_mul, hs, bne_self_eq_false]


theorem hypot_boundary_binade_significand_bounds (a : hypot_BoundaryVal) :
    2 ^ 52 ≤ a.frac + 2 ^ 52 ∧ a.frac + 2 ^ 52 < 2 ^ 53 := by
  have hfrac : a.frac < 2 ^ 52 := by
    rw [Fl.frac_eq]
    change a.magnitude % 2 ^ 52 < 2 ^ 52
    exact Nat.mod_lt _ (by decide)
  omega

theorem hypot_boundary_binade_integer (a : hypot_BoundaryVal)
    (hs : a.signbit = false) (he : a.expField = 1483) :
    hypot_boundary_integer a (((a.frac + 2 ^ 52) * 2 ^ 408 : Nat) : Int) :=
  hypot_boundary_integer_from_rat a _ (hypot_boundary_binade_rat a hs he).1
    (hypot_boundary_binade_rat a hs he).2

theorem hypot_boundary_binade_square_lattice (a : hypot_BoundaryVal)
    (hs : a.signbit = false) (he : a.expField = 1483)
    (hyfin : (mul a a).isfinite = true) :
    ∃ Y J : Int, hypot_boundary_integer (mul a a) Y ∧ Y = J * ((2 ^ 816 : Nat) : Int) := by
  let c := a.frac + 2 ^ 52
  let m := c * 2 ^ 408
  have hb := hypot_boundary_significand_square_bounds c (hypot_boundary_binade_significand_bounds a)
  change 2 ^ 920 ≤ m * m ∧ m * m < 2 ^ 922 at hb
  have hn : m * m ≠ 0 := Nat.ne_of_gt (Nat.lt_of_lt_of_le (Nat.two_pow_pos 920) hb.1)
  have hnloglo : 920 ≤ (m * m).log2 := (Nat.le_log2 hn).mpr hb.1
  have hnloghi : (m * m).log2 < 922 := (Nat.log2_lt hn).mpr hb.2
  have hYeq : mul a a = Fl.roundRat ((m * m : Nat) : Int) 1 false :=
    hypot_boundary_binade_round_square a hs he
  obtain ⟨Y, hY⟩ := hypot_boundary_rounded_integer ((m * m : Nat) : Int) false
    (by rw [← hYeq]; exact hyfin)
  obtain ⟨J, hJ⟩ := hypot_boundary_rounded_lattice (m * m) false Y hn
    (Nat.le_trans (by decide : 868 ≤ 920) hnloglo)
    (Nat.lt_trans hnloghi (by decide : 922 < 1024)) hY
  rw [← hYeq] at hY
  exact ⟨Y, J, hY, hJ⟩

theorem hypot_boundary_nat_square_abs (m : Nat) :
    ((m : Int) * (m : Int)).natAbs = m * m := by
  rw [← Int.natCast_mul, Int.natAbs_natCast]

/-- Every square residual in binade460 lies on the critical 2^816 lattice.
    This lemma establishes divisibility, independently of its ulp-size bound. -/
theorem hypot_boundary_binade_residual_lattice (a : hypot_BoundaryVal)
    (hs : a.signbit = false) (he : a.expField = 1483)
    (hyfin : (mul a a).isfinite = true) :
    ∃ an yn K : Int,
      hypot_boundary_integer a an ∧
      hypot_boundary_integer (mul a a) yn ∧
      an * an - yn = K * ((2 ^ 816 : Nat) : Int) ∧
      2 ^ 920 ≤ (an * an).natAbs ∧ (an * an).natAbs < 2 ^ 922 := by
  let c := a.frac + 2 ^ 52
  let m := c * 2 ^ 408
  have hb := hypot_boundary_significand_square_bounds c (hypot_boundary_binade_significand_bounds a)
  have ha := hypot_boundary_binade_integer a hs he
  obtain ⟨Y, J, hY, hJ⟩ := hypot_boundary_binade_square_lattice a hs he hyfin
  have hscale : (m : Int) * (m : Int) = ((c * c : Nat) : Int) * ((2 ^ 816 : Nat) : Int) :=
    hypot_boundary_square_scale c
  refine ⟨(m : Int), Y, ((c * c : Nat) : Int) - J, ha, hY, ?_, ?_, ?_⟩
  · calc
      (m : Int) * (m : Int) - Y = ((c * c : Nat) : Int) * ((2 ^ 816 : Nat) : Int) - J * ((2 ^ 816 : Nat) : Int) :=
        (congrArg (fun x : Int => x - Y) hscale).trans
          (congrArg (fun y : Int => ((c * c : Nat) : Int) * ((2 ^ 816 : Nat) : Int) - y) hJ)
      _ = (((c * c : Nat) : Int) - J) * ((2 ^ 816 : Nat) : Int) := (Int.sub_mul _ _ _).symm
  · rw [hypot_boundary_nat_square_abs]
    exact hb.1
  · rw [hypot_boundary_nat_square_abs]
    exact hb.2

/-- An absolute half-ulp bound gives exactly the coefficient bound needed above. -/
theorem hypot_boundary_lattice_coefficient_bound (A K : Int)
    (hL : A = K * ((2 ^ 816 : Nat) : Int)) (hA : A.natAbs ≤ 2 ^ 868) :
    K.natAbs ≤ 2 ^ 52 := by
  rw [hL, Int.natAbs_mul, Int.natAbs_natCast] at hA
  have hp : (2 ^ 868 : Nat) = 2 ^ 52 * 2 ^ 816 := by decide
  rw [hp] at hA
  omega


/-- Squaring an integer-valued finite source operand rounds its exact integer square. -/
theorem hypot_boundary_square_integer (a : hypot_BoundaryVal) (A : Int)
    (ha : hypot_boundary_integer a A) :
    mul a a = Fl.roundRat (A * A) 1 false := by
  obtain ⟨j, hj⟩ := mfToRatPow2 a ha.1
  have hrat := hypot_boundary_integer_rat a A ha
  change mul_float a a = _
  rw [mfMulRat a a ha.1 ha.1]
  simp only [bne_self_eq_false]
  have hnum : a.toRat.1 * a.toRat.1 = (A * A) * ((2 ^ (j + j) : Nat) : Int) := by
    rw [hrat, hj, Nat.pow_add, Int.natCast_mul]
    ac_rfl
  rw [hnum, hj, ← Nat.pow_add]
  simpa only [Nat.one_mul] using
    (ldexp_roundRat_scale (f := JuliaLean.base.float.FTy.f64.fmt) (A * A) 1 (j + j) false (by decide))

/-- In binade460 the exact residual automatically satisfies the needed coefficient bound. -/
theorem hypot_boundary_binade_residual_bounded (a : hypot_BoundaryVal)
    (hs : a.signbit = false) (he : a.expField = 1483)
    (hyfin : (mul a a).isfinite = true) :
    ∃ an yn K : Int,
      hypot_boundary_integer a an ∧
      hypot_boundary_integer (mul a a) yn ∧
      an * an - yn = K * ((2 ^ 816 : Nat) : Int) ∧ K.natAbs ≤ 2 ^ 52 := by
  obtain ⟨an, yn, K, ha, hy, hL, _, hn⟩ :=
    hypot_boundary_binade_residual_lattice a hs he hyfin
  have hsq := hypot_boundary_square_integer a an ha
  have herr := root_round64_integer_value_error (an * an) yn false 922
    (by decide) (by decide) hn (by rw [← hsq]; exact hy.2)
  have hA : (an * an - yn).natAbs ≤ 2 ^ 868 := by
    rw [show an * an - yn = -(yn - an * an) by omega, Int.natAbs_neg]
    exact herr
  exact ⟨an, yn, K, ha, hy, hL, hypot_boundary_lattice_coefficient_bound _ _ hL hA⟩

/-- Source range hypotheses suffice for a nonnegative critical-boundary FMA correction.
    The lattice, residual exactness, and Sterbenz exact subtraction are now conclusions. -/
theorem hypot_boundary_fma_nonnegative_of_binade
    (a b : hypot_BoundaryVal) (bn : Int)
    (hs : a.signbit = false) (he : a.expField = 1483)
    (hyfin : (mul a a).isfinite = true)
    (hb : hypot_boundary_integer b bn)
    (hhalf : (mul hypot_rescale_boundary hypot_rescale_boundary).key ≤ 2 * (mul a a).key)
    (horder : (mul a a).key ≤ (mul hypot_rescale_boundary hypot_rescale_boundary).key)
    (hnorm : a.toRat.1 * a.toRat.1 + bn * bn ≤
      hypot_rescale_boundary.toRat.1 * hypot_rescale_boundary.toRat.1) :
    (hypot_boundary_fma_correction a b).isnan = false ∧
    0 ≤ (hypot_boundary_fma_correction a b).key ∧
    flt (hypot_boundary_fma_correction a b) (fzero .f64) = false := by
  obtain ⟨an, yn, K, ha, hy, hL, hK⟩ := hypot_boundary_binade_residual_bounded a hs he hyfin
  have hx := hypot_boundary_integer_certificates.1
  have hxpos : 0 < (mul hypot_rescale_boundary hypot_rescale_boundary).key := by decide
