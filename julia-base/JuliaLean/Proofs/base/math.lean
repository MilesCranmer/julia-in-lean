  have hs := early_hypot_balanced_sum_bound a b ha hb hsa hsb haB hbB
  have hsign : h.signbit = false := by
    by_cases hz : s.iszero = true
    · simpa only [h, early_sqrt_zero s hz] using hs.2.2.2.1
    · exact (early_sqrt_finite_positive s hs.2.2.1 (Bool.eq_false_iff.mpr hz) hs.2.2.2.1).2.1
  have hA := (JuliaLean.Proofs.base.math.mfKeySign a).2 hsa
  have hB := (JuliaLean.Proofs.base.math.mfKeySign b).2 hsb
  have hH := (JuliaLean.Proofs.base.math.mfKeySign h).2 hsign
  have hminSq := early_square_le_square (early_bound2 508).key a.key (by decide) hhigh
  have hsmall : 16 * K ≤ a.key * a.key := Int.le_trans (by decide) hminSq
  have herr := early_hypot_initial_square_error a b ha hb hsa hsb haB hbB
  simp only [Int.pow_succ, Int.pow_zero, Int.one_mul] at herr
