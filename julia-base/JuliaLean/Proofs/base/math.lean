/-- The classification sufficient to make a real square-root call succeed. -/
def early_hypot_nonnegnan {T : FTy} (x : FV T) : Prop :=
  x.signbit = false ∨ x.isnan = true

theorem early_hypot_finite_of_classes {T : FTy} (x : FV T)
    (hn : x.isnan = false) (hi : x.isinf = false) : x.isfinite = true := by
  simp only [Fl.isnan, Fl.isinf, Fl.isfinite] at hn hi ⊢
  cases he : x.expField == T.fmt.emax <;> simp only [he, Bool.false_and, Bool.true_and] at hn hi ⊢
  · exact bne_iff_ne.mpr (beq_eq_false_iff_ne.mp he)
  · have hfrac : x.frac = 0 := by simpa only [bne_eq_false_iff_eq] using hn
    simp only [hfrac, beq_self_eq_true] at hi
    cases hi

theorem early_hypot_inf_notzero {T : FTy} (x : FV T) (hi : x.isinf = true) :
    x.iszero = false := by
  have hfields : x.expField = T.fmt.emax ∧ x.frac = 0 := by
    simpa only [Fl.isinf, Bool.and_eq_true, beq_iff_eq] using hi
  have hmag := (TruncProofs.mag_decomp x).1
  have hem : 0 < T.fmt.emax := by cases T <;> decide
  have hp := Nat.mul_pos hem (Nat.two_pow_pos T.fmt.sb)
  simp only [Fl.iszero, hmag, hfields.1, hfields.2, Nat.add_zero, beq_eq_false_iff_ne]
  omega

theorem early_hypot_square_nonnegative (n : Int) : 0 ≤ n * n := by
  by_cases hn : 0 ≤ n
  · exact Int.mul_nonneg hn hn
  · exact Int.mul_nonneg_of_nonpos_of_nonpos (by omega) (by omega)

theorem early_hypot_round_nonnegative (T : FTy) (n : Int) (j : Nat) (hn : 0 ≤ n) :
    (Fl.roundRat n (2 ^ j) false : FV T).signbit = false := by
  by_cases hz : n = 0
  · rw [hz, JuliaLean.Proofs.base.math.mfRoundRatZero _ (Nat.ne_of_gt (Nat.two_pow_pos j))]
    exact JuliaLean.Proofs.base.math.mfZeroSignbit T false
  · rw [JuliaLean.Proofs.base.math.mfRoundRatSignbit T n j false hz]
    exact decide_eq_false (by omega)

theorem early_hypot_rat_nonnegative {T : FTy} (x : FV T)
    (hs : x.signbit = false) : 0 ≤ x.toRat.1 := by
  simp only [Fl.toRat, hs, Bool.false_eq_true, ↓reduceIte]
  split
  · omega
  · split <;> split
    · exact Int.mul_nonneg (Int.natCast_nonneg _) (Int.natCast_nonneg _)
    · exact Int.natCast_nonneg _
    · exact Int.mul_nonneg (Int.natCast_nonneg _) (Int.natCast_nonneg _)
    · exact Int.natCast_nonneg _

theorem early_hypot_square_nonnegnan {T : FTy} (x : FV T) :
    early_hypot_nonnegnan (mul x x) := by
  change early_hypot_nonnegnan (jlMulFloat x x)
  simp only [jlMulFloat, finishFloat_eq]
  by_cases hn : x.isnan = true
  · exact Or.inr (by simpa only [floatMul, hn, ↓reduceIte] using quietFloat_isnan x hn)
  · have hn : x.isnan = false := Bool.eq_false_iff.mpr hn
    by_cases hi : x.isinf = true
    · have hz := early_hypot_inf_notzero x hi
      have hs : (Fl.inf false : FV T).signbit = false := by cases T <;> decide
      apply Or.inl
      simpa only [floatMul, hn, hi, hz, Bool.false_eq_true, Bool.and_false,
        Bool.or_self, ↓reduceIte, bne_self_eq_false] using hs
    · have hi : x.isinf = false := Bool.eq_false_iff.mpr hi
      have hf := early_hypot_finite_of_classes x hn hi
      obtain ⟨j, hj⟩ := JuliaLean.Proofs.base.math.mfToRatPow2 x hf
      apply Or.inl
      simp only [floatMul, hn, hi, Bool.false_eq_true, Bool.false_and,
        Bool.or_self, ↓reduceIte, bne_self_eq_false, hj, ← Nat.pow_add]
      exact early_hypot_round_nonnegative T (x.toRat.1 * x.toRat.1) (j + j)
        (early_hypot_square_nonnegative _)

theorem early_hypot_fma_square_nonnegnan {T : FTy} (x z : FV T)
    (hz : early_hypot_nonnegnan z) : early_hypot_nonnegnan (floatFma x x z) := by
  by_cases hxnan : x.isnan = true
  · exact Or.inr (by simpa only [floatFma, hxnan, ↓reduceIte] using quietFloat_isnan x hxnan)
  · have hxnan : x.isnan = false := Bool.eq_false_iff.mpr hxnan
    by_cases hznan : z.isnan = true
    · exact Or.inr (by simpa only [floatFma, hxnan, hznan, Bool.false_eq_true, ↓reduceIte]
        using quietFloat_isnan z hznan)
    · have hznan : z.isnan = false := Bool.eq_false_iff.mpr hznan
      have hzsign : z.signbit = false := hz.resolve_right (by rw [hznan]; decide)
      by_cases hxinf : x.isinf = true
      · have hxzero := early_hypot_inf_notzero x hxinf
        have hinfsign : (Fl.inf false : FV T).signbit = false := by cases T <;> decide
        apply Or.inl
        simpa only [floatFma, hxnan, hznan, hxinf, hxzero, hzsign,
          bne_self_eq_false, Bool.false_eq_true, Bool.and_false, Bool.or_self,
          ↓reduceIte] using hinfsign
      · have hxinf : x.isinf = false := Bool.eq_false_iff.mpr hxinf
        by_cases hzinf : z.isinf = true
        · apply Or.inl
          simpa only [floatFma, hxnan, hznan, hxinf, hzinf, Bool.false_eq_true,
            Bool.false_and, Bool.or_self, ↓reduceIte] using hzsign
        · have hzinf : z.isinf = false := Bool.eq_false_iff.mpr hzinf
          have hxf := early_hypot_finite_of_classes x hxnan hxinf
          have hzf := early_hypot_finite_of_classes z hznan hzinf
          obtain ⟨jx, hjx⟩ := JuliaLean.Proofs.base.math.mfToRatPow2 x hxf
          obtain ⟨jz, hjz⟩ := JuliaLean.Proofs.base.math.mfToRatPow2 z hzf
          have hzn := early_hypot_rat_nonnegative z hzsign
          apply Or.inl
          simp only [floatFma, hxnan, hznan, hxinf, hzinf, Bool.false_eq_true,
            Bool.false_and, Bool.or_self, ↓reduceIte, bne_self_eq_false,
            hjx, hjz, ← Nat.pow_add]
          apply early_hypot_round_nonnegative
          exact Int.add_nonneg
            (Int.mul_nonneg (early_hypot_square_nonnegative _) (Int.natCast_nonneg _))
            (Int.mul_nonneg hzn (Int.natCast_nonneg _))

theorem early_hypot_muladd_squares_nonnegnan {T : FTy} (hT : 32 ≤ T.fmt.width)
    (x y : FV T) : early_hypot_nonnegnan (JuliaLean.base.float.muladd_IEEEFloat x x (mul y y)) := by
  change early_hypot_nonnegnan (jlMuladdFloat x x (mul y y))
  simpa only [jlMuladdFloat, hT, ↓reduceIte, finishFloat_eq] using
    early_hypot_fma_square_nonnegnan x (mul y y) (early_hypot_square_nonnegnan y)

theorem early_hypot_sqrt_succeeds {T : FTy} (o : IEEEOps T) (x : FV T)
    (hx : early_hypot_nonnegnan x) : sqrtIEEE o x = .ok (o.sqrtLlvm x) := by
  have hn : (fzero T).isnan = false := by cases T <;> decide
  have hz : (fzero T).iszero = true := by cases T <;> decide
  have hs : (fzero T).signbit = false := by cases T <;> decide
  have hb : (fzero T).toBits = 0 := by cases T <;> rfl
  have hlt : flt x (fzero T) = false := by
    change Fl.lt x (fzero T) = false
    rcases hx with hsign | hnan
    · simp only [Fl.lt, hn, hz, hs, hb, hsign, Bool.or_false,
        Bool.and_true, Bool.bne_false, Bool.false_eq_true, ↓reduceIte]
      cases x.isnan <;> cases x.iszero <;> simp
    · simp only [Fl.lt, hnan, Bool.true_or, ↓reduceIte]
  simp only [sqrtIEEE, hlt, Bool.false_eq_true, ↓reduceIte]

/-- Once its four square-root call sites succeed, the pair algorithm has no
remaining exceptional exit. The correction and rescaling arithmetic is total. -/
theorem early_hypot_generic_total {α γ β : Type} (o : GenericHypotOps α β)
    (absRight : γ → β) (x : α) (y : γ)
    (cutoff minRoot bigRoot : β) (sumRoot : β → β → β)
    (hcutoff : o.sqrt (o.div o.eps o.two) = .ok cutoff)
    (hmin : o.sqrt o.floatmin = .ok minRoot)
    (hbig : o.sqrt (o.div o.floatmax o.two) = .ok bigRoot)
    (hsum : ∀ a b, o.sqrt (o.muladd a a (o.mul b b)) = .ok (sumRoot a b)) :
    ∃ h, hypotGeneric o absRight x y = .ok h := by
  simp only [hypotGeneric, hypotGenericSource, hcutoff, hmin, hbig, hsum, bind, Except.bind,
    pure, Except.pure]
  split
  · exact ⟨_, rfl⟩
  · split <;> (split <;> exact ⟨_, rfl⟩)

set_option maxRecDepth 4096 in
set_option exponentiation.threshold 2048 in
theorem early_hypot64_total (o : IEEEOps .f64)
    (heps : o.eps = eps_float .f64)
    (hmin : o.floatmin = floatmin_float .f64)
    (hmax : o.floatmax = floatmax_float .f64)
    (hmuladd : ∀ x y z, o.muladd x y z = JuliaLean.base.float.muladd_IEEEFloat x y z)
    (x y : FV .f64) :
    ∃ h, hypotGeneric (hypotOpsOfIEEE o) (hypotOpsOfIEEE o).abs x y = .ok h := by
  have hc : flt (div (eps_float .f64) (Fl.ofInt 2)) (fzero .f64) = false := by decide
  have hm : flt (floatmin_float .f64) (fzero .f64) = false := by decide
  have hb : flt (div (floatmax_float .f64) (Fl.ofInt 2)) (fzero .f64) = false := by decide
  apply early_hypot_generic_total (hypotOpsOfIEEE o) (hypotOpsOfIEEE o).abs x y
    (o.sqrtLlvm (div o.eps (Fl.ofInt 2))) (o.sqrtLlvm o.floatmin)
    (o.sqrtLlvm (div o.floatmax (Fl.ofInt 2)))
    (fun a b => o.sqrtLlvm (o.muladd a a (mul b b)))
  · simp only [hypotOpsOfIEEE, sqrtIEEE, heps, hc, Bool.false_eq_true, ↓reduceIte]
  · simp only [hypotOpsOfIEEE, sqrtIEEE, hmin, hm, Bool.false_eq_true, ↓reduceIte]
  · simp only [hypotOpsOfIEEE, sqrtIEEE, hmax, hb, Bool.false_eq_true, ↓reduceIte]
  · intro a b
    change sqrtIEEE o (o.muladd a a (mul b b)) = _
    apply early_hypot_sqrt_succeeds
    rw [hmuladd]
    exact early_hypot_muladd_squares_nonnegnan (by decide) a b

/-- The installed binary64 pair method returns successfully on every input,
including finite overflow, signed zero, infinities, and NaNs. -/
theorem early_hypot_native64_total (machine : JuliaLean.Bindings.base.math.Machine)
    (x y : FV .f64) : ∃ h, MathHypotPair machine .f64 x y = .ok h := by
  have h := early_hypot64_total (JuliaLean.Bindings.base.math.ieeeOps machine .f64)
    rfl rfl rfl (by intro a b c; rfl) x y
  change ∃ h, hypotGeneric
    (hypotOpsOfIEEE (JuliaLean.Bindings.base.math.ieeeOps machine .f64))
    (hypotOpsOfIEEE (JuliaLean.Bindings.base.math.ieeeOps machine .f64)).abs x y = .ok h
  exact h

theorem early_hypot16_total (o : IEEEOps .f32) (x y : FV .f16) :
    ∃ h, hypot16 o x y = .ok h := by
  unfold hypot16
  split
  · exact ⟨_, rfl⟩
  · have hn := early_hypot_muladd_squares_nonnegnan (T := .f32) (by decide)
      (Fl.convert x) (Fl.convert y)
    dsimp only
    rw [early_hypot_sqrt_succeeds o _ hn]
    exact ⟨_, rfl⟩

theorem early_hypot32_total (o : IEEEOps .f64) (x y : FV .f32) :
    ∃ h, hypot32 o x y = .ok h := by
  unfold hypot32
  split
  · exact ⟨_, rfl⟩
  · have hn := early_hypot_muladd_squares_nonnegnan (T := .f64) (by decide)
      (Fl.convert x) (Fl.convert y)
    dsimp only
    rw [early_hypot_sqrt_succeeds o _ hn]
    exact ⟨_, rfl⟩

/-- Every native same-format pair call has a successful result. This includes
all exceptional inputs; it makes no finiteness claim about overflow results. -/
theorem early_hypot_native_pair_total (machine : JuliaLean.Bindings.base.math.Machine)
    (T : FTy) (x y : FV T) : ∃ h, MathHypotPair machine T x y = .ok h := by
  cases T with
  | f16 =>
    change ∃ h, hypot16 (JuliaLean.Bindings.base.math.ieeeOps machine .f32) x y = .ok h
    exact early_hypot16_total _ x y
  | f32 =>
    change ∃ h, hypot32 (JuliaLean.Bindings.base.math.ieeeOps machine .f64) x y = .ok h
    exact early_hypot32_total _ x y
  | f64 => exact early_hypot_native64_total machine x y

