theorem generic_inf_facts (T : JuliaLean.base.float.FTy) (s : Bool) :
    (Fl.inf s : JuliaLean.base.float.FV T).isfinite = false ∧
    (Fl.inf s : JuliaLean.base.float.FV T).isnan = false ∧
