/-- Finite numerator in the first software-correction branch. Exact Sterbenz
delta and a checked subtraction error preserve enough margin below overflow. -/
theorem early_software_first_numerator_finite (a b h : FV .f64)
    (ha : early_box 512 a) (hb : early_box 512 b) (hh : early_box 512 h)
    (hsa : a.signbit = false) (hsb : b.signbit = false) (hsh : h.signbit = false)
    (hba : b.key ≤ a.key)
    (haB : a.key ≤ (Fl.ofBits 0x5fe6a09e667f3bcc : FV .f64).key)
    (hlo : 7 * a.key ≤ 8 * h.key) (hhi : 2 * h.key ≤ 3 * a.key)
    (hbranch : h.key ≤ 2 * b.key)
