/-- The Rational exponent contract is stated using the installed Rational-to-Float64 conversion. -/
def exponentRationalExact : Prop :=
  ∀ (num den : JInt .i64), 0 < den.val → num.val ≠ 0 →
    let float : JInt .i64 × JInt .i64 → JuliaLean.base.float.FV .f64 := fun pair =>
      JuliaLean.base.rational.abstractFloatRatSource
        JuliaLean.base.float.float_BitInteger JuliaLean.base.float.div_IEEEFloat
        ⟨pair.1, pair.2⟩
    ∃ e,
      JuliaLean.base.math.realFallback float (fun _ => false) "exponent"
        JuliaLean.base.math.exponentFloat (num, den) = .ok e ∧
      QRatLe (QPowTwo e) (QRationalMagnitude num den) = true ∧
      QRatLt (QRationalMagnitude num den) (QPowTwo (e + 1)) = true

def minIslessIncludingNaN : Prop :=
  ∀ x y : JuliaLean.base.float.FV .f64,
    JuliaLean.C.jlMinFloat x y =
      (if JuliaLean.Promotion.Fl.isless x y then x else y) ∧
    JuliaLean.C.jlMaxFloat x y =
      (if JuliaLean.Promotion.Fl.isless y x then x else y)

