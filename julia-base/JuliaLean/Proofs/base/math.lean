  rw [finishFloat_eq]
  generalize (if T.fmt == half && x.isnan then quietFloat x else x) = z
  simpa only [NextProofs.encode, Bool.false_eq_true, ↓reduceIte, Nat.zero_add] using
    (NextProofs.sign_encode T false (Fl.bits_split z).2)

/-- Exact native remainder for finite operands, stated first using common integer keys. -/
theorem generic_native_nearest_finite
    (machine : JuliaLean.Bindings.base.math.Machine) {T : JuliaLean.base.float.FTy}
    (x y : JuliaLean.base.float.FV T) (hx : x.isfinite = true) (hy : y.isfinite = true)
    (hyz : y.iszero = false) :
    let r := remNearest { JuliaLean.Bindings.base.math.ieeeOps machine T with flipsign := nativeNearestFlipSign T } x y
    r.isfinite = true ∧
    r.key = x.key - y.key * JuliaLean.Proofs.base.div.roundedIntegerQuotient x.key y.key .Nearest ∧
    (r.iszero = true → r.signbit = x.signbit) := by
  have hym : y.magnitude ≠ 0 := by simpa only [Fl.iszero, beq_eq_false_iff_ne] using hyz
  have hP : 0 < y.key.natAbs := by
    rw [mfKeyNatAbs]
    exact ((magKey_cases T.fmt _).resolve_left (by omega)).2
  have hnan : fisnan y = false := by
    change isnan_callee y = false
    rw [isnan_callee_eq]
    exact Fl.isnan_of_finite hy
  have hg : (fiszero y || !fisfinite x || fisnan y) = false := by
    change (iszero_float y || !isfinite_callee x || fisnan y) = false
    have hfin : isfinite_callee x = x.isfinite := isfinite_IEEEFloat_eq x
    rw [iszero_float_eq, hfin, hyz, hx, hnan]
    rfl
  dsimp only
  by_cases heq : feq x y = true
  · have hxy : x.key = y.key := of_decide_eq_true (by
      simpa only [feq, eq_float, jlEqFloat, Fl.eq_key (Fl.isnan_of_finite hx) (Fl.isnan_of_finite hy)] using heq)
    have hykey : y.key ≠ 0 := by omega
    have hq : JuliaLean.Proofs.base.div.roundedIntegerQuotient y.key y.key .Nearest = 1 := by
      have habs : 0 < (if y.key < 0 then -y.key else y.key) := by split <;> omega
      simp [generic_rounded_nearest_unfold, hykey, Int.tdiv_self, Int.tmod_self, habs,
        show ¬ (if y.key < 0 then -y.key else y.key) < 0 by omega]
    have hz0 : (fzero T).magnitude = 0 := mfZeroMag false
    have hc : copysign_float (fzero T) x = NextProofs.encode T x.signbit 0 := by
      rw [RemainderProofs.copysign_encoded, hz0]
    have h0inf : 0 < NextProofs.infMag T := by
      unfold NextProofs.infMag
      have := (good_fty T).emax_eq
      exact Nat.mul_pos (by omega) (Nat.two_pow_pos _)
    obtain ⟨hcf, hck⟩ := mfEncodeKey T x.signbit 0 h0inf
    unfold remNearest remNearestSource
    simp only [hg, heq, Bool.false_eq_true, ↓reduceIte, hc]
    dsimp only [Id.run, Pure.pure]
    refine ⟨hcf, ?_, ?_⟩
    · rw [hck, hxy, hq, magKey_zero]
      cases x.signbit <;> simp
    · intro _
      exact NextProofs.sign_encode T x.signbit (Nat.lt_trans h0inf (NextProofs.infMag_lt_signMask T))
  · have heqf : feq x y = false := by simpa using heq
    obtain ⟨hx1f, hx1b, hx1n⟩ := mfNearestX1 x y hx hy hym
    obtain ⟨-, hx1k⟩ := generic_nearest_x1_exact x y hx hy hym
    obtain ⟨hpaf, hpak⟩ := mfAbsKey y hy
    have hx1s := generic_abs_sign_all (rem_IEEEFloat x (mul y (Fl.ofInt 2)))
    obtain ⟨hvf, hvk, hvz⟩ := generic_nearest_core_full (fabs y)
      (fabs (rem_IEEEFloat x (mul y (Fl.ofInt 2)))) hpaf hx1f (by rw [hpak]; omega)
      hx1n (by rw [hpak]; omega) hx1s
    let v := mfRemCore (fabs y) (fabs (rem_IEEEFloat x (mul y (Fl.ofInt 2))))
    have hvf' : v.isfinite = true := hvf
    obtain ⟨hff, hfk, hfz, hfs⟩ := generic_native_flip_metadata v x hvf'
    have hr : remNearest { JuliaLean.Bindings.base.math.ieeeOps machine T with flipsign := nativeNearestFlipSign T } x y = nativeNearestFlipSign T v x := by
      unfold remNearest remNearestSource
      rw [mulTwoLeft_eq_right y]
      simp only [hg, heqf, Bool.false_eq_true, ↓reduceIte]
      rw [mfIdIteFlip { JuliaLean.Bindings.base.math.ieeeOps machine T with flipsign := nativeNearestFlipSign T } x]
      rfl
    rw [hr]
    refine ⟨hff, ?_, ?_⟩
    · rw [hfk]
      have hk := generic_signed_nearest_residual x.key.natAbs y.key.natAbs x.signbit y.signbit hP
      have hxsigned : (if x.signbit then -(x.key.natAbs : Int) else (x.key.natAbs : Int)) = x.key := by
        rw [mfKeyNatAbs]; rfl
      have hysigned : (if y.signbit then -(y.key.natAbs : Int) else (y.key.natAbs : Int)) = y.key := by
        rw [mfKeyNatAbs]; rfl
      dsimp only at hk
      rw [hxsigned, hysigned] at hk
      rw [hpak, hx1k] at hvk
      change (if x.signbit then -v.key else v.key) = _
      rw [hvk]
      exact hk.symm
    · intro hz
      rw [hfs, hvz (hfz ▸ hz)]
      exact Bool.false_xor x.signbit

