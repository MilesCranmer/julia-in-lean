    Int.sub_mul, hrr, hbr, Int.mul_comm b r]
  omega

theorem generic_sqrt_upper_difference_factor (r a : Int) :
    (r + a) ^ 2 = 4 * r ^ 2 + (a - r) * (a + 3 * r) := by
  have hrr : r * (3 * r) = 3 * (r * r) := by ac_rfl
  have har : a * (3 * r) = 3 * (r * a) := by ac_rfl
  simp only [Int.pow_succ, Int.pow_zero, Int.one_mul, Int.add_mul, Int.mul_add,
    Int.sub_mul, hrr, har, Int.mul_comm a r]
