    dsimp only
    rw [← Nat.pow_add]
    apply hypot_round64_subnormal_bound
    have habs : (if a.signbit then -(a.frac : Int) else (a.frac : Int)).natAbs = a.frac := by
      cases a.signbit <;> simp only [Bool.false_eq_true, ↓reduceIte, Int.natAbs_neg, Int.natAbs_natCast]
    rw [habs]
    have hlog : a.frac.log2 ≤ 52 := by
      by_cases hzero : a.frac = 0
      · simp [hzero]
      · have h := (Nat.log2_lt hzero).mpr hfr
        omega
    omega
  · have hr : a.toRat =
        ((if a.signbit then -((a.frac + 2 ^ 52 : Nat) : Int) else ((a.frac + 2 ^ 52 : Nat) : Int)),
          2 ^ (1075 - a.expField)) := by
      have hbeq : (a.expField == 0) = false := beq_eq_false_iff_ne.mpr hB0
      have hp : ¬ (a.expField : Int) - JuliaLean.base.float.FTy.f64.fmt.bias -
          JuliaLean.base.float.FTy.f64.fmt.sb ≥ 0 := by
        change ¬ (a.expField : Int) - 1023 - 52 ≥ 0
        omega
      simp only [Fl.toRat, ha, Bool.not_true, Bool.false_eq_true, ↓reduceIte, hbeq, hp]
      congr 2
      change (-((a.expField : Int) - 1023 - 52)).toNat = 1075 - a.expField
      omega
    rw [hr]
    dsimp only
    rw [← Nat.pow_add]
    apply hypot_round64_subnormal_bound
    have habs : (if a.signbit then -((a.frac + 2 ^ 52 : Nat) : Int)
        else ((a.frac + 2 ^ 52 : Nat) : Int)).natAbs = a.frac + 2 ^ 52 := by
      cases a.signbit <;> simp only [Bool.false_eq_true, ↓reduceIte, Int.natAbs_neg, Int.natAbs_natCast]
    rw [habs]
    have hlog : (a.frac + 2 ^ 52).log2 = 52 := mfLog2Eq _ _ (by omega) (by omega)
    rw [hlog]
    omega

