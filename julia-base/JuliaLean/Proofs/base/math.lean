/-- The first square-root result is finite and nonzero, between2^-511 and
the predecessor of2^512, in every surviving balanced branch. -/
theorem early_hypot_scaled_sqrt_interval (a b : FV .f64)
    (ha : a.isfinite = true) (hb : b.isfinite = true)
    (hsa : a.signbit = false) (hsb : b.signbit = false)
    (hba : b.key ≤ a.key)
    (hcutoff : fle b (mul a (Fl.ofBits 0x3e46a09e667f3bcd)) = false) :
    let q := early_hypot64_scaled a b
    let s := JuliaLean.base.float.muladd_IEEEFloat q.1 q.1 (mul q.2.1 q.2.1)
    let h := jlSqrtLlvm s
    h.isfinite = true ∧ h.signbit = false ∧ h.iszero = false ∧
    (Fl.ofBits 0x2000000000000000 : FV .f64).key ≤ h.key ∧
    h.key ≤ (Fl.ofBits 0x5fefffffffffffff : FV .f64).key := by
  let q := early_hypot64_scaled a b
