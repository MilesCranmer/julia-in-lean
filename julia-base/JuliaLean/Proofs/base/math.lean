      ((2 ^ 459 : Nat) : Int) * FTy.f64.fmt.den) :
    let delta := sub h b
    (JuliaLean.base.float.muladd_IEEEFloat delta (sub delta (mul (Fl.ofInt 2) (sub a b)))
      (mul a (sub (mul (Fl.ofInt 2) delta) a))).isfinite = true := by
  let Amax : FV .f64 := Fl.ofBits 0x5fe6a09e667f3bcc
  let D1 : FV .f64 := Fl.ofBits 0x5fe1000000000000
  let C1 : FV .f64 := Fl.ofBits 0x5fe2000000000000
  let C2 : FV .f64 := Fl.ofBits 0x5fed000000000000
  let Z : FV .f64 := Fl.ofBits 0x7fe4a00000000000
