  have hms : (Fl.roundRat m 1 false : JuliaLean.base.float.FV T).signbit = false :=
    early_hypot_round_nonnegative T m 0 (Int.natCast_nonneg _)
  by_cases hn : n = 0
  · rw [hn, Int.natCast_zero, mfRoundRatZero 1 (by decide)]
    rw [(Fl.zero_spec (good_fty T) false).2]
    exact (mfKeySign _).2 hms
  have hlog : n.log2 ≤ m.log2 := (Nat.le_log2 hm).mpr
    (Nat.le_trans (Nat.log2_self_le hn) hnm)
  have hncap : n.log2 + T.fmt.bias < T.fmt.emax := by omega
  by_cases hlt : n.log2 < m.log2
  · have hbias := (good_fty T).bias_pos
    have hnBounds := early_round_normal_magnitude_bounds T n 0 hn (by omega) (by omega)
    have hmBounds := early_round_normal_magnitude_bounds T m 0 hm (by omega) (by omega)
    simp only [Int.natCast_zero, Int.sub_zero, ← Int.natCast_add, Int.toNat_natCast,
      Nat.pow_zero] at hnBounds hmBounds
    have hstep := Nat.mul_le_mul_right (2 ^ T.fmt.sb)
      (by omega : n.log2 + T.fmt.bias + 1 ≤ m.log2 + T.fmt.bias)
    have hmag : (Fl.roundRat n 1 false : JuliaLean.base.float.FV T).magnitude ≤
        (Fl.roundRat m 1 false : JuliaLean.base.float.FV T).magnitude := by omega
    simp only [Fl.key, hnBounds.2.2.1, hms, Bool.false_eq_true, ↓reduceIte]
    exact Int.ofNat_le.mpr (magKey_mono T.fmt hmag)
  have heq : n.log2 = m.log2 := by omega
  by_cases hsmall : n.log2 < T.fmt.sb
  · have hnb : n < 2 ^ (T.fmt.sb + 1) :=
      Nat.lt_of_lt_of_le Nat.lt_log2_self (Nat.pow_le_pow_right (by decide) (by omega))
    have hmb : m < 2 ^ (T.fmt.sb + 1) :=
      Nat.lt_of_lt_of_le Nat.lt_log2_self (Nat.pow_le_pow_right (by decide) (by omega))
    have hkn := (FloatRoundDirections.roundRat_smallKey (good_fty T) (n : Int) false
      (by simpa only [Int.natAbs_natCast] using hnb)).2
    have hkm := (FloatRoundDirections.roundRat_smallKey (good_fty T) (m : Int) false
      (by simpa only [Int.natAbs_natCast] using hmb)).2
    rw [hkn, hkm]
    exact Int.mul_le_mul_of_nonneg_right (Int.ofNat_le.mpr hnm) (Int.natCast_nonneg _)
  have hkn := FloatRoundDirections.roundRat_integer_key T (n : Int) false (by omega)
    (by simpa only [Int.natAbs_natCast] using hncap) (by simpa only [Int.natAbs_natCast] using (show T.fmt.sb ≤ n.log2 by omega))
  have hkm := FloatRoundDirections.roundRat_integer_key T (m : Int) false (by omega)
    (by simpa only [Int.natAbs_natCast] using hmcap) (by simpa only [Int.natAbs_natCast] using (show T.fmt.sb ≤ m.log2 by omega))
  simp only [Int.natAbs_natCast, show ¬ (n : Int) < 0 by omega, ↓reduceIte] at hkn
  simp only [Int.natAbs_natCast, show ¬ (m : Int) < 0 by omega, ↓reduceIte, ← heq] at hkm
  rw [hkn, hkm]
  exact Int.ofNat_le.mpr (Nat.mul_le_mul_right _ (Nat.mul_le_mul_right _
    (root_round_quotient_monotone n m _ hnm)))

