  ∀ (machine : JuliaLean.Bindings.base.math.Machine) (T : FTy) (x : FV T),
    match JuliaLean.Bindings.base.math.sqrtFloat machine x with
    | .error error =>
        (∃ message, error = .domainError message) ∧ MathNegativeIEEE x
    | .ok r =>
        ¬ MathNegativeIEEE x ∧
        (x.isnan = true → r.isnan = true) ∧
        (x.iszero = true → r.toBits = x.toBits) ∧
        (x.isinf = true → r.isinf = true ∧ r.signbit = false) ∧
        (x.isfinite = true → x.iszero = false →
