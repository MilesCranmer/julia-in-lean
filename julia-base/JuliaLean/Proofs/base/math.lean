theorem early_hypot64_trace (o : IEEEOps .f64)
    (heps : o.eps = eps_float .f64)
    (hmin : o.floatmin = floatmin_float .f64)
    (hmax : o.floatmax = floatmax_float .f64)
    (hsqrt : ∀ x, o.sqrtLlvm x = jlSqrtLlvm x)
    (hone : ∀ x, o.oneunit x = fone .f64)
    (hinv : ∀ x, o.inverse x = div (fone .f64) x)
    (hgreater : ∀ x y, o.greater x y = flt y x)
    (hmuladd : ∀ x y z, o.muladd x y z = JuliaLean.base.float.muladd_IEEEFloat x y z)
    (hfma : o.haveFma = true → ∀ x y z, o.fma x y z = jlFmaFloat x y z)
    (x y : FV .f64) (hxf : x.isfinite = true) (hyf : y.isfinite = true) :
    hypotGeneric (hypotOpsOfIEEE o) (hypotOpsOfIEEE o).abs x y =
      .ok (early_hypot64_value o.haveFma x y) := by
  have hax := (JuliaLean.Proofs.base.math.mfFabsKey x hxf).2.1
  have hay := (JuliaLean.Proofs.base.math.mfFabsKey y hyf).2.1
  have hnormx := early_hypot_div_one (fabs x) hax
  have hnormy := early_hypot_div_one (fabs y) hay
  have hix : fisinf (fabs x) = false := by
    rw [show fisinf (fabs x) = (fabs x).isinf from isinf_IEEEFloat_eq _]
    exact Fl.isinf_of_finite hax
  have hiy : fisinf (fabs y) = false := by
    rw [show fisinf (fabs y) = (fabs y).isinf from isinf_IEEEFloat_eq _]
    exact Fl.isinf_of_finite hay
  have hc : sqrtIEEE o (div (eps_float .f64) (Fl.ofInt 2)) =
      .ok (Fl.ofBits 0x3e46a09e667f3bcd) := by
    have hc : flt (div (eps_float .f64) (Fl.ofInt 2)) (fzero .f64) = false := by decide
    simp only [sqrtIEEE, hc, Bool.false_eq_true, ↓reduceIte, hsqrt, early_hypot64_constants.1]
  have hm : sqrtIEEE o (floatmin_float .f64) = .ok (Fl.ofBits 0x2000000000000000) := by
    have hm : flt (floatmin_float .f64) (fzero .f64) = false := by decide
    simp only [sqrtIEEE, hm, Bool.false_eq_true, ↓reduceIte, hsqrt, early_hypot64_constants.2.1]
  have hb : sqrtIEEE o (div (floatmax_float .f64) (Fl.ofInt 2)) =
      .ok (Fl.ofBits 0x5fe6a09e667f3bcc) := by
    have hb : flt (div (floatmax_float .f64) (Fl.ofInt 2)) (fzero .f64) = false := by decide
    simp only [sqrtIEEE, hb, Bool.false_eq_true, ↓reduceIte, hsqrt, early_hypot64_constants.2.2.2.2]
  have hsum (a b : FV .f64) : sqrtIEEE o (JuliaLean.base.float.muladd_IEEEFloat a a (mul b b)) =
      .ok (jlSqrtLlvm (JuliaLean.base.float.muladd_IEEEFloat a a (mul b b))) := by
    rw [early_hypot_sqrt_succeeds o _ (early_hypot_muladd_squares_nonnegnan (by decide) a b), hsqrt]
  by_cases hhardware : o.haveFma = true
  · have hfma' := hfma hhardware
    by_cases horder : flt (fabs x) (fabs y) = true <;>
      simp only [hypotGeneric, hypotGenericSource, hypotOpsOfIEEE, hone, hnormx, hnormy, hgreater,
        hix, hiy, Bool.or_self, Bool.false_eq_true, ↓reduceIte, heps, hmin, hmax,
        hc, hm, hb, hmuladd, hsum, hfma', hinv, early_hypot64_constants.2.2.1,
        early_hypot64_constants.2.2.2.1, hhardware, horder,
        early_hypot64_value, early_hypot64_correct, bind, Except.bind, pure, Except.pure] <;>
      (split <;> rfl)
  · by_cases horder : flt (fabs x) (fabs y) = true <;>
      simp only [hypotGeneric, hypotGenericSource, hypotOpsOfIEEE, hone, hnormx, hnormy, hgreater,
        hix, hiy, Bool.or_self, Bool.false_eq_true, ↓reduceIte, heps, hmin, hmax,
        hc, hm, hb, hmuladd, hsum, hinv, early_hypot64_constants.2.2.1,
        early_hypot64_constants.2.2.2.1, hhardware, horder,
        early_hypot64_value, early_hypot64_correct, bind, Except.bind, pure, Except.pure] <;>
      (split <;> rfl)

/-- The public native finite-input result depends on the hardware-FMA flag
and the two input bit patterns; the other machine fields do not enter it. -/
theorem early_hypot_native64_trace (machine : JuliaLean.Bindings.base.math.Machine)
    (x y : FV .f64) (hxf : x.isfinite = true) (hyf : y.isfinite = true) :
    MathHypotPair machine .f64 x y =
      .ok (early_hypot64_value (JuliaLean.Bindings.base.math.haveFma machine .f64) x y) := by
  change hypotGeneric (hypotOpsOfIEEE (JuliaLean.Bindings.base.math.ieeeOps machine .f64))
    (hypotOpsOfIEEE (JuliaLean.Bindings.base.math.ieeeOps machine .f64)).abs x y = _
  apply early_hypot64_trace _ rfl rfl rfl (by intro a; rfl) (by intro a; rfl)
    (by intro a; rfl) (by intro a b; rfl) (by intro a b c; rfl) _ x y hxf hyf
  intro hh a b c
  change JuliaLean.Bindings.base.math.fmaIEEE machine a b c = jlFmaFloat a b c
  change JuliaLean.Bindings.base.math.haveFma machine .f64 = true at hh
  simp only [JuliaLean.Bindings.base.math.fmaIEEE,
    JuliaLean.base.floatfuncs.fma_IEEEFloat,
    JuliaLean.Bindings.base.math.floatFmaOps, hh, ↓reduceIte]


/-- A concrete operation record for either correction branch. Its unused pi
field is finite and positive; no pi value is needed by pair hypot. -/
def early_hypot64_ops (hardware : Bool) : IEEEOps .f64 where
  sqrtLlvm := jlSqrtLlvm
  eps := eps_float .f64
  floatmin := floatmin_float .f64
  floatmax := floatmax_float .f64
  invFloatmin := div (fone .f64) (floatmin_float .f64)
  pi := fone .f64
  fma := jlFmaFloat
  twoMul := fun x y => (mul x y, jlFmaFloat x y (fneg (mul x y)))
  trunc := jlTruncLlvm
  rem := rem_IEEEFloat
  flipsign := fun x y => if y.signbit then Fl.neg x else x
  minFloat := jlMinFloat
  maxFloat := jlMaxFloat
  clampUnsigned := fun _ _ value => value
  addFast := add
  oneunit := fun _ => fone .f64
  inverse := fun x => div (fone .f64) x
  greater := fun x y => flt y x
  muladd := jlMuladdFloat
  abs2 := fun x => mul x x
  haveFma := hardware

theorem early_hypot64_ops_faithful (hardware : Bool) :
    JuliaLean.Proofs.base.math.HypotIEEEOpsFaithful (early_hypot64_ops hardware) := by
  have hpiFinite : fisfinite (fone .f64) = true := by decide
  have hpiPositive : flt (fzero .f64) (fone .f64) = true := by decide
  constructor
  · simp only [JuliaLean.Proofs.base.math.IEEEFloatOpsFaithful, early_hypot64_ops,
      hpiFinite, hpiPositive, and_self, implies_true]
  · intro a b
    rfl

/-- The precise remaining numerical obligation, independent of callee records,
public dispatch, machine pi storage, and exceptional exits. -/
def early_hypot64_core_safety : Prop :=
  ∀ (hardware : Bool) (x y : FV .f64),
    x.isfinite = true → y.isfinite = true →
    let maxRat := (Fl.floatmax : FV .f64).toRat
    (JuliaLean.Proofs.base.math.QLT (JuliaLean.Proofs.base.math.HypotSquared64 x y)
        (JuliaLean.Proofs.base.math.QMul maxRat maxRat) ||
      JuliaLean.Proofs.base.math.QEQ (JuliaLean.Proofs.base.math.HypotSquared64 x y)
        (JuliaLean.Proofs.base.math.QMul maxRat maxRat)) = true →
    (early_hypot64_value hardware x y).isfinite = true

theorem early_hypot_fisfinite_eq {T : FTy} (x : FV T) : fisfinite x = x.isfinite :=
  isfinite_IEEEFloat_eq x

/-- Exact equivalence of the frozen generic target and the remaining concrete
arithmetic range claim. All abstraction and success obligations are discharged. -/
theorem early_hypot_finite_safety_iff_core :
    JuliaLean.Proofs.base.math.HypotFiniteSafety64 ↔ early_hypot64_core_safety := by
  constructor
  · intro hsafe hardware x y hxf hyf
    dsimp only
    intro hbound
    have htrace := early_hypot64_trace (early_hypot64_ops hardware)
      rfl rfl rfl (by intro a; rfl) (by intro a; rfl) (by intro a; rfl)
      (by intro a b; rfl) (by intro a b c; rfl) (by intro _ a b c; rfl) x y hxf hyf
    obtain ⟨h, hrun, hfin⟩ := hsafe (early_hypot64_ops hardware)
      (JuliaLean.Bindings.base.math.reduceOps .f64) (fun a b => (a, b)) id
      (early_hypot64_ops_faithful hardware) (by intro a b; rfl) (by intro a; rfl)
      x y (by simpa only [early_hypot_fisfinite_eq] using hxf)
      (by simpa only [early_hypot_fisfinite_eq] using hyf) hbound
    change hypotGeneric (hypotOpsOfIEEE (early_hypot64_ops hardware))
      (hypotOpsOfIEEE (early_hypot64_ops hardware)).abs x y = .ok h at hrun
    rw [htrace] at hrun
    have heq := Except.ok.inj hrun
    rw [← heq] at hfin
    simpa only [early_hypot_fisfinite_eq, early_hypot64_ops] using hfin
  · intro hsafe o reduction promote float hfaith hpromote hfloat x y hxf hyf
    dsimp only
    intro hbound
    rcases hfaith.1 with ⟨heps, hmin, hmax, _hinvmin, _hpi, _hpipos, hsqrt, _htrunc,
      hone, hinv, _habs2, hgreater, _hadd, hfma, hmuladd, _hrem, _hflip, _hminf, _hmaxf⟩
    have hxf' : x.isfinite = true := by simpa only [early_hypot_fisfinite_eq] using hxf
    have hyf' : y.isfinite = true := by simpa only [early_hypot_fisfinite_eq] using hyf
    have htrace := early_hypot64_trace o heps hmin hmax hsqrt hone hinv hgreater hmuladd
      (by intro _; exact hfma) x y hxf' hyf'
    refine ⟨early_hypot64_value o.haveFma x y, ?_, ?_⟩
    · simpa only [hypotTwo, hpromote, hfloat, bind, Except.bind, hypotDispatchFloat64] using htrace
    · simpa only [early_hypot_fisfinite_eq] using hsafe o.haveFma x y hxf' hyf' hbound

/-- The native target follows from exactly the same two-branch numerical
obligation, even when software FMA is installed on the machine. -/
theorem early_hypot_native_safety_of_core (hsafe : early_hypot64_core_safety) :
    JuliaLean.Proofs.base.math.Archive20261102Round7.HypotFiniteSafetyNative64 := by
  intro machine x y hxf hyf
  dsimp only
  intro hbound
  have hxf' : x.isfinite = true := by simpa only [early_hypot_fisfinite_eq] using hxf
  have hyf' : y.isfinite = true := by simpa only [early_hypot_fisfinite_eq] using hyf
  refine ⟨early_hypot64_value (JuliaLean.Bindings.base.math.haveFma machine .f64) x y,
    early_hypot_native64_trace machine x y hxf' hyf', ?_⟩
  have hmax : floatmax_float .f64 = (Fl.floatmax : FV .f64) := by decide
  simp only [hmax] at hbound
  simpa only [early_hypot_fisfinite_eq] using
    hsafe (JuliaLean.Bindings.base.math.haveFma machine .f64) x y hxf' hyf' hbound

theorem early_hypot_native_safety_of_generic
    (hsafe : JuliaLean.Proofs.base.math.HypotFiniteSafety64) :
    JuliaLean.Proofs.base.math.Archive20261102Round7.HypotFiniteSafetyNative64 :=
  early_hypot_native_safety_of_core (early_hypot_finite_safety_iff_core.mp hsafe)


/-- Cross-multiplying exact dyadics reduces the input-side hypotenuse bound to
one inequality between integer magnitude keys. -/
theorem early_hypot_rational_bound (xn xd yn yd mn md X Y M D : Int)
    (hxd : 0 < xd) (hyd : 0 < yd) (hmd : 0 < md) (hD : 0 < D)
    (hx : xn * D = X * xd) (hy : yn * D = Y * yd) (hm : mn * D = M * md) :
    ((xn ^ 2 * yd ^ 2 + yn ^ 2 * xd ^ 2) * md ^ 2 ≤
      mn ^ 2 * (xd ^ 2 * yd ^ 2)) ↔ X ^ 2 + Y ^ 2 ≤ M ^ 2 := by
  let F := xd ^ 2 * yd ^ 2 * md ^ 2
  have hF : 0 < F := Int.mul_pos (Int.mul_pos (Int.pow_pos hxd) (Int.pow_pos hyd)) (Int.pow_pos hmd)
  have hD2 : 0 < D ^ 2 := Int.pow_pos hD
  have hsquare (a b c : Int) (h : a * D = b * c) : a ^ 2 * D ^ 2 = b ^ 2 * c ^ 2 := by
    calc
      a ^ 2 * D ^ 2 = (a * D) ^ 2 := by simp only [Int.pow_succ, Int.pow_zero]; ac_rfl
      _ = (b * c) ^ 2 := by rw [h]
      _ = b ^ 2 * c ^ 2 := by simp only [Int.pow_succ, Int.pow_zero]; ac_rfl
  have hx2 := hsquare xn X xd hx
  have hy2 := hsquare yn Y yd hy
  have hm2 := hsquare mn M md hm
  have hleft : ((xn ^ 2 * yd ^ 2 + yn ^ 2 * xd ^ 2) * md ^ 2) * D ^ 2 =
      (X ^ 2 + Y ^ 2) * F := by
    calc
      _ = ((xn ^ 2 * D ^ 2) * yd ^ 2 + (yn ^ 2 * D ^ 2) * xd ^ 2) * md ^ 2 := by
        simp only [Int.add_mul]
        ac_rfl
      _ = ((X ^ 2 * xd ^ 2) * yd ^ 2 + (Y ^ 2 * yd ^ 2) * xd ^ 2) * md ^ 2 := by rw [hx2, hy2]
      _ = (X ^ 2 + Y ^ 2) * F := by dsimp only [F]; simp only [Int.add_mul]; ac_rfl
  have hright : (mn ^ 2 * (xd ^ 2 * yd ^ 2)) * D ^ 2 = M ^ 2 * F := by
    calc
      _ = (mn ^ 2 * D ^ 2) * (xd ^ 2 * yd ^ 2) := by ac_rfl
      _ = (M ^ 2 * md ^ 2) * (xd ^ 2 * yd ^ 2) := by rw [hm2]
      _ = M ^ 2 * F := by dsimp only [F]; ac_rfl
  calc
    _ ↔ ((xn ^ 2 * yd ^ 2 + yn ^ 2 * xd ^ 2) * md ^ 2) * D ^ 2 ≤
        (mn ^ 2 * (xd ^ 2 * yd ^ 2)) * D ^ 2 := (Int.mul_le_mul_right hD2).symm
    _ ↔ (X ^ 2 + Y ^ 2) * F ≤ M ^ 2 * F := by rw [hleft, hright]
    _ ↔ X ^ 2 + Y ^ 2 ≤ M ^ 2 := Int.mul_le_mul_right hF

