  change Fl.eq x (Fl.inf s) = false
  rw [Fl.eq_key (Fl.isnan_of_finite hx) hin, Fl.inf_key_eq (good_fty T) _ hii, his]
  apply decide_eq_false
  cases s <;> simp only [Bool.false_eq_true, ↓reduceIte] <;> omega

theorem generic_inf_lt_finite_false {T : JuliaLean.base.float.FTy} (x : JuliaLean.base.float.FV T)
    (hx : x.isfinite = true) : flt (Fl.inf false) x = false := by
  obtain ⟨-, hin, -, hii, his, -⟩ := generic_inf_facts T false
  have hk := Fl.finite_key_lt_inf (good_fty T) x hx
  change Fl.lt (Fl.inf false) x = false
  rw [Fl.lt_key hin (Fl.isnan_of_finite hx), Fl.inf_key_eq (good_fty T) _ hii, his]
