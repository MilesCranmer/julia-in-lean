  simp only [Fl.roundQuotient, Nat.div_eq_of_lt hnd, Nat.mod_eq_of_lt hnd,
    htwo, decide_false, beq_eq_false_iff_ne.mpr hneq, Bool.false_and, Bool.false_or,
