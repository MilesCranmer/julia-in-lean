  ∀ {t : IntTy} (x : JInt t) (coefficients : List (JInt t)),
    coefficients ≠ [] → (coefficients.length : Int) ≤ IntTy.max .i64 →
    ∀ generated,
      ∃ value : JInt t ⊕ JInt t,
        evalpolyTuple (muladd JuliaLean.base.int.mul_int JuliaLean.base.int.add_int)
          (muladd JuliaLean.base.int.mul_int JuliaLean.base.int.add_int)
          (fun _ => .ok ()) generated x coefficients = .ok value ∧
        (match value with | .inl v => v.val | .inr v => v.val) % (2 ^ t.bits : Int) =
