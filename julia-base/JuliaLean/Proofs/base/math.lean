/-- Every subnormal Float64 encoding up to the smallest normal is finite. -/
theorem hypot_scale_subnormal_pack (s : Bool) (q : Nat) (hq : q ≤ 2 ^ 52) :
    (Fl.packRounded (f := JuliaLean.base.float.FTy.f64.fmt) s q (-1074)).isfinite = true ∧
      (Fl.packRounded (f := JuliaLean.base.float.FTy.f64.fmt) s q (-1074)).magnitude ≤ 2 ^ 52 := by
