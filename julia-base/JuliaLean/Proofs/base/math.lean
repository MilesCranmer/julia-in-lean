theorem hypot16_sign_equal (o : IEEEOps .f32) (x y : hypot_NanVal .f16)
    (hx : x.isfinite = true) (hy : y.isfinite = true) :
    hypot16 o x y = hypot16 o (fneg x) y ∧ hypot16 o x y = hypot16 o x (fneg y) := by
  have hxc := hypot_widen_finite_mag_neg (T := .f32) (by decide) (by decide) (by decide) x hx
  have hyc := hypot_widen_finite_mag_neg (T := .f32) (by decide) (by decide) (by decide) y hy
  have hxinf := hypot_finite_notinf x hx
  have hyinf := hypot_finite_notinf y hy
  have hxneg := hypot_finite_notinf (fneg x) (hypot_fneg_finite x hx)
  have hyneg := hypot_finite_notinf (fneg y) (hypot_fneg_finite y hy)
  have hxfma : ∀ z : hypot_NanVal .f32,
      muladd_IEEEFloat (Fl.convert (fneg x)) (Fl.convert (fneg x)) z =
        muladd_IEEEFloat (Fl.convert x) (Fl.convert x) z := by
    intro z
    exact hypot_muladd_square_same_mag (by decide) _ _ z hxc.2.1 hxc.1 hxc.2.2
  have hysq : mul (Fl.convert (fneg y) : hypot_NanVal .f32) (Fl.convert (fneg y)) =
      mul (Fl.convert y) (Fl.convert y) :=
    hypot_square_same_mag _ _ hyc.2.1 hyc.1 hyc.2.2
  simp only [hypot16, hxinf, hyinf, hxneg, hyneg, Bool.false_or,
    Bool.false_eq_true, ↓reduceIte, hxfma, hysq, and_self]

