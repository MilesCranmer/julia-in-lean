  split
  · rename_i hs
    obtain ⟨hm, hsg⟩ := fl_neg_parts (fabs x)
    apply Fl.ext_toBits
    rw [(Fl.bits_split (Fl.neg (fabs x))).1, (Fl.bits_split x).1, hm, hsg, ham, has, hs]
    rfl
  · rename_i hs
    have hs' : x.signbit = false := by simpa using hs
    apply Fl.ext_toBits
    rw [(Fl.bits_split (fabs x)).1, (Fl.bits_split x).1, ham, has, hs']

theorem generic_native_nearest_infinite_signed
    (machine : JuliaLean.Bindings.base.math.Machine) {T : JuliaLean.base.float.FTy}
