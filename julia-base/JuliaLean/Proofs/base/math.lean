      Int.mul_le_mul_of_nonneg_right hbound
        (Int.mul_nonneg (Int.natCast_nonneg _) (Int.natCast_nonneg _))
    _ = (U * ((x.toRat.2 * y.toRat.2 : Nat) : Int)) * T.fmt.den := by rw [Int.natCast_mul]; ac_rfl

