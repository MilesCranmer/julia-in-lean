      U * ((x.toRat.2 * y.toRat.2 * z.toRat.2 : Nat) : Int) := by
  have hD : (0 : Int) < T.fmt.den := by exact_mod_cast T.fmt.den_pos
  have hrx := (Fl.toRat_key (good_fty T) x hx).2
  have hry := (Fl.toRat_key (good_fty T) y hy).2
  have hrz := (Fl.toRat_key (good_fty T) z hz).2
