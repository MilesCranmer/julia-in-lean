/-- The exact norm bound alone prevents a nonnegative operand exceeding H. -/
theorem hypot_critical_leading_upper (a b : hypot_BoundaryVal) (hsa : a.signbit = false)
    (hnorm : a.key * a.key + b.key * b.key ≤ hypot_rescale_boundary.key * hypot_rescale_boundary.key) :
    a.key ≤ hypot_rescale_boundary.key := by
  have ha0 := (mfKeySign a).2 hsa
