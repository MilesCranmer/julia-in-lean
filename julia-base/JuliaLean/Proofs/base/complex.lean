      calc _ = (Q : Int)*(Q : Int)*(ipow (p+1022).toNat*ipow (p+1022).toNat)-
          (cert.R : Int)*(ipow (cert.C+U)*ipow 1074) := by
            rw [Int.neg_mul, Int.sub_eq_add_neg]
            ac_rfl
        _ = _ := by
          rw [hpowh, hpowsq, cert.weq, Int.natCast_mul, Int.natCast_mul, Int.sub_mul]
          simp only [ipow, Int.mul_assoc]
    change _ ∧ key64 (F64.roundRat (((Q : Int)*ipow (p+1022).toNat)*((Q : Int)*ipow (p+1022).toNat)+
      (-((cert.R : Int)*ipow (cert.C+U)))*ipow 1074) (2^2148) _) = _
    rw [heq]
    exact exact_residual cert.W cert.wb _
  have hz : F64.isfinite (F64.fma a a (F64.neg AA)) = true ∧
      key64 (F64.fma a a (F64.neg AA)) = 0 := by
    rw [fma_key_round a a _ afin afin (neg_fin AA hAA), key_neg, akey, kAA]
    have hpowa : ipow (p+1074).toNat*ipow (p+1074).toNat =
        ipow (2*p+1074).toNat*ipow 1074 := ipow_product _ _ _ _ (by omega)
    change _ ∧ key64 (F64.roundRat (ipow (p+1074).toNat*ipow (p+1074).toNat+
      (-ipow (2*p+1074).toNat)*ipow 1074) (2^2148) _) = 0
    rw [hpowa, Int.neg_mul]
    have hcancel : ipow (2*p+1074).toNat*ipow 1074 + -(ipow (2*p+1074).toNat*ipow 1074) = 0 := by omega
    rw [hcancel]
    have he := exact_residual 0 (by decide) ((F64.signbit a != F64.signbit a) && F64.signbit (F64.neg AA))
    simpa only [Int.zero_mul] using he
  have hk : F64.isfinite (F64.add (F64.fma (F64.neg b) b diff) (F64.fma h h (F64.neg HH))) = true ∧
      key64 (F64.add (F64.fma (F64.neg b) b diff) (F64.fma h h (F64.neg HH))) = cert.K*ipow U := by
    rw [add_key_round _ _ hv.1 hw.1, hv.2, hw.2, ← Int.add_mul, ← cert.keq]
