  unfold floatCheckEpsilonBits
  by_cases hk : k < 52
  · have hp : p < -1022 := by dsimp only [p]; omega
    have he : (p+1074).toNat = k := by dsimp only [p]; omega
    simp only [hk, hp, ↓reduceIte, he]
  · have hp : ¬ p < -1022 := by dsimp only [p]; omega
    have he : (p+1023).toNat = k-51 := by dsimp only [p]; omega
    simp only [hk, hp, ↓reduceIte, he]

end JuliaLean.ChatGPT.Batch10.Group1

