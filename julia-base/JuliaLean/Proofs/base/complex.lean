          (((F64.toRat x).2 : Int)*((F64.toRat y).2 : Int)*((2^1074 : Nat) : Int)) := by ac_rfl
        _ = _ := by rw [key64_rat z hz]; ac_rfl
  rw [hdx, hdy, hdz, ← Nat.pow_add, ← Nat.pow_add] at hcross
  obtain ⟨hxn, hxi⟩ := floatCheckF64FiniteClasses x hx
  obtain ⟨hyn, hyi⟩ := floatCheckF64FiniteClasses y hy
