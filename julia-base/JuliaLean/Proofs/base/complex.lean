theorem quotient_one (n : Nat) : Fl.roundQuotient n 1 = n := by
  simp only [Fl.roundQuotient, Nat.div_one, Nat.mod_one]
  rfl

theorem two_mul_pack (p : Int) (Q : Nat) (hp0 : -485 ≤ p) (hp1 : p ≤ 511)
    (hQ0 : 2^52 ≤ Q) (hQ1 : Q < 2^53) :
    F64.mul Fl64.two (pk false Q (p-52)) = pk false Q (p-51) := by
  have hf := pack_key false Q (p-52) hQ0 hQ1 (by omega) (by omega)
  obtain ⟨i,j,hr,he⟩ := pack_positive_rat Q (p-52) hQ0 hQ1 (by omega) (by omega)
  rw [mul_fin _ _ (by decide) (Scalar.ProofMisc.finite_not_nan _ hf.1) (by decide)
    (Scalar.ProofMisc.finite_not_inf _ hf.1), hr, hf.2.2]
  have hr2 : F64.toRat Fl64.two = (((2^52 : Nat) : Int),2^51) := by decide
  rw [hr2]
  change F64.roundRat (((2^52 : Nat) : Int)*((Q*2^i : Nat) : Int))
    (2^51*2^j) false = _
  have hn : ((2^52 : Nat) : Int)*((Q*2^i : Nat) : Int) = (Q : Int)*((2^(i+52) : Nat) : Int) := by
    rw [Nat.pow_add, Int.natCast_mul, Int.natCast_mul]
    ac_rfl
  rw [hn, ← Nat.pow_add]
  have hlog : Fl.floorLog2Rat (Q : Int).natAbs 1 = 52 := by
    rw [Int.natAbs_natCast, SmallExact.floorLog2Rat_pow Q 0 (by omega)]
    simp only [Int.natCast_zero, Int.sub_zero]
    rw [EpsilonBounds.log_mantissa Q hQ0 hQ1]
    rfl
  have hs := normal_round_shift (Q : Int) 1 (i+52) (51+j) false
    (by omega) (by decide) (by rw [hlog]; omega) (by rw [hlog]; omega)
  rw [Nat.one_mul] at hs
  rw [hs, hlog]
  have hneg : decide ((Q : Int)<0) = false := decide_eq_false (by omega)
  have hk : (52 : Int)+(i+52 : Nat)-(51+j : Nat)-52 = p-51 := by omega
  change f64Pack (decide ((Q : Int)<0))
    (Fl.roundQuotient (Q*2^(-(52-52 : Int)).toNat) (1*2^(52-52 : Int).toNat))
      ((52 : Int)+(i+52 : Nat)-(51+j : Nat)-52) = _
  rw [hneg, hk]
  simp only [Int.sub_self, Int.neg_zero, Int.toNat_zero, Nat.pow_zero, Nat.mul_one, Nat.one_mul]
  change pk false (Fl.roundQuotient Q 1) (p-51) = _
  rw [quotient_one]

theorem pack_nonzero_positive (Q : Nat) (k : Int) (hQ0 : 2^52 ≤ Q) (hQ1 : Q < 2^53)
    (hk0 : -1074 ≤ k) (hk1 : k ≤ 971) : F64.iszero (pk false Q k) = false := by
  rw [pk_norm false Q k hQ0 hQ1 hk0 hk1]
  simp only [Bool.false_eq_true, ↓reduceIte, Nat.zero_add]
  rw [iszero_f, tb_ofBits]
  have he0 : 1 ≤ (k+1075).toNat := by omega
  have he1 : (k+1075).toNat ≤ 2046 := by omega
  omega

theorem div_pack_key (x : F64) (Q : Nat) (k : Int) (hx : F64.isfinite x = true)
    (hQ0 : 2^52 ≤ Q) (hQ1 : Q < 2^53) (hk0 : -1074 ≤ k) (hk1 : k ≤ 971) :
    ∃ i j : Nat, (i : Int)-(j : Int) = k ∧
      F64.div x (pk false Q k) =
        F64.roundRat (key64 x*((2^j : Nat) : Int)) (Q*2^(i+1074)) (F64.signbit x) := by
  obtain ⟨i,j,hr,he⟩ := pack_positive_rat Q k hQ0 hQ1 hk0 hk1
  have hy := pack_key false Q k hQ0 hQ1 hk0 hk1
  have hyz := pack_nonzero_positive Q k hQ0 hQ1 hk0 hk1
  obtain ⟨v,_,hv⟩ := Scalar.ProofMisc.finite_den_pow x hx
  have hkx := key64_rat x hx
  rw [hv] at hkx
  refine ⟨i,j,he,?_⟩
  have hxn := Scalar.ProofMisc.finite_not_nan x hx
  have hxi := Scalar.ProofMisc.finite_not_inf x hx
  have hyn := Scalar.ProofMisc.finite_not_nan _ hy.1
  have hyi := Scalar.ProofMisc.finite_not_inf _ hy.1
  unfold F64.div
  simp only [hxn,hxi,hyn,hyi,hyz,hy.2.2,Bool.false_eq_true,Bool.false_and,
    Bool.and_false,Bool.false_or,Bool.or_false,↓reduceIte,hr,hv,Prod.fst,Prod.snd,
