      rw [he, ← Int.natCast_mul, ← Nat.pow_add,
        show F64.exponentField x-1+(1075-F64.exponentField x) = 1074 by omega]

theorem floatCheckEpsilonFiniteSpacing (x : F64) (hx : F64.isfinite x = true) :
    F64.isfinite (F64.eps x) = true ∧ F64.signbit (F64.eps x) = false ∧
