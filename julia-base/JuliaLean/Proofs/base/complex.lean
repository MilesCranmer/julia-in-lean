namespace JuliaLean.ChatGPT.Batch10.Group1
open JuliaLean JuliaLean.Float JuliaLean.Promotion JuliaLean.base.complex
open JuliaLean.Proofs.base.complex
open JuliaLean.base.complex.Models1Group19
open JuliaLean.Proofs.base.complex.Models1Group19
set_option maxRecDepth 100000
set_option maxHeartbeats 10000000
set_option exponentiation.threshold 5000

/-- Scaling both sides of a quotient preserves nearest-integer rounding and tie parity. -/
theorem floatCheckRoundQuotientScale (a b c : Nat) (hc : 0 < c) :
    Fl.roundQuotient (a * c) (b * c) = Fl.roundQuotient a b := by
  unfold Fl.roundQuotient
  rw [Nat.mul_div_mul_right a b hc, Nat.mul_mod_mul_right]
  dsimp only
  have hgt : 2 * (a % b * c) > b * c ↔ 2 * (a % b) > b := by
    rw [← Nat.mul_assoc]
    exact Nat.mul_lt_mul_right hc
  have heq : 2 * (a % b * c) = b * c ↔ 2 * (a % b) = b := by
    rw [← Nat.mul_assoc]
    exact Nat.mul_right_cancel_iff (by omega)
  have hbeq : (2 * (a % b * c) == b * c) = (2 * (a % b) == b) := by
    apply Bool.eq_iff_iff.mpr
    simpa only [beq_iff_eq] using heq
  simp only [hgt, hbeq]

/-- A common binary scale leaves the rational binade unchanged. -/
theorem floatCheckFloorLogScale (n d k : Nat) (hn : n ≠ 0) (hd : d ≠ 0) :
    Fl.floorLog2Rat (n * 2 ^ k) (d * 2 ^ k) = Fl.floorLog2Rat n d := by
  unfold Fl.floorLog2Rat
  rw [floatCheckLog2MulPow n k hn, floatCheckLog2MulPow d k hd]
  have heq : ((n.log2 + k : Nat) : Int) - ((d.log2 + k : Nat) : Int) =
      (n.log2 : Int) - (d.log2 : Int) := by omega
  simp only [heq]
  by_cases he : 0 ≤ (n.log2 : Int) - (d.log2 : Int)
  · simp only [he, ↓reduceIte]
    have hb : n * 2 ^ k < d * 2 ^ k * 2 ^ ((n.log2 : Int) - d.log2).toNat ↔
        n < d * 2 ^ ((n.log2 : Int) - d.log2).toNat := by
      rw [Nat.mul_right_comm d (2 ^ k), Nat.mul_lt_mul_right (Nat.two_pow_pos k)]
    simp only [hb]
  · simp only [he, ↓reduceIte]
    have hb : n * 2 ^ k * 2 ^ (-((n.log2 : Int) - d.log2)).toNat < d * 2 ^ k ↔
        n * 2 ^ (-((n.log2 : Int) - d.log2)).toNat < d := by
      rw [Nat.mul_right_comm n (2 ^ k), Nat.mul_lt_mul_right (Nat.two_pow_pos k)]
    simp only [hb]

/-- Rounding is invariant when numerator and denominator receive a common power of two. -/
theorem floatCheckFlRoundRatScale (f : Fmt) (n : Int) (d k : Nat) (s : Bool) (hd : d ≠ 0) :
    (Fl.roundRat (n * ((2 ^ k : Nat) : Int)) (d * 2 ^ k) s : Fl f) = Fl.roundRat n d s := by
  have hp : 0 < 2 ^ k := Nat.two_pow_pos k
  have hpi : (0 : Int) < ((2 ^ k : Nat) : Int) := by omega
  have hdp : d * 2 ^ k ≠ 0 := Nat.mul_ne_zero hd (by omega)
  by_cases hn : n = 0
  · simp only [hn, Int.zero_mul, Fl.roundRat, beq_eq_false_iff_ne.mpr hd,
      beq_eq_false_iff_ne.mpr hdp, beq_self_eq_true, Bool.false_eq_true, ↓reduceIte]
  · have hnp : n * ((2 ^ k : Nat) : Int) ≠ 0 := Int.mul_ne_zero hn (by omega)
    have ha : n.natAbs ≠ 0 := by omega
    have hneg : n * ((2 ^ k : Nat) : Int) < 0 ↔ n < 0 := by
      have h := Int.mul_lt_mul_right (b := n) (c := 0) hpi
      simpa only [Int.zero_mul] using h
    simp only [Fl.roundRat, beq_eq_false_iff_ne.mpr hd, beq_eq_false_iff_ne.mpr hdp,
      beq_eq_false_iff_ne.mpr hn, beq_eq_false_iff_ne.mpr hnp, Bool.false_eq_true, ↓reduceIte,
      Int.natAbs_mul, Int.natAbs_natCast, hneg, floatCheckFloorLogScale n.natAbs d k ha hd]
    by_cases ho : Fl.floorLog2Rat n.natAbs d ≥ (f.emax : Int) - f.bias
    · simp only [ho, ↓reduceIte]
    · simp only [ho, ↓reduceIte]
      by_cases hu : Fl.floorLog2Rat n.natAbs d < -((f.bias : Int) + f.sb) - 1
      · simp only [hu, ↓reduceIte]
      · simp only [hu, ↓reduceIte]
        generalize max (Fl.floorLog2Rat n.natAbs d - f.sb) (1 - (f.bias : Int) - f.sb) = p
        by_cases hge : p ≥ 0
        · simp only [hge, ↓reduceIte]
          rw [Nat.mul_right_comm d (2 ^ k), floatCheckRoundQuotientScale _ _ _ hp]
        · simp only [hge, ↓reduceIte]
          rw [Nat.mul_right_comm n.natAbs (2 ^ k), floatCheckRoundQuotientScale _ _ _ hp]

/-- Equal dyadic rationals have identical rounded representations with the same zero sign. -/
theorem floatCheckFlRoundRatDyadicEq (f : Fmt) (n m : Int) (i j : Nat) (s : Bool)
    (h : n * ((2 ^ j : Nat) : Int) = m * ((2 ^ i : Nat) : Int)) :
    (Fl.roundRat n (2 ^ i) s : Fl f) = Fl.roundRat m (2 ^ j) s := by
  rw [← floatCheckFlRoundRatScale f n (2 ^ i) j s (Nat.ne_of_gt (Nat.two_pow_pos _)), h,
    Nat.mul_comm (2 ^ i) (2 ^ j),
    floatCheckFlRoundRatScale f m (2 ^ j) i s (Nat.ne_of_gt (Nat.two_pow_pos _))]

/-- The requested zero sign has no effect when the exact rational is nonzero. -/
theorem floatCheckFlRoundRatZeroSign (f : Fmt) (n : Int) (d : Nat) (s t : Bool) (hn : n ≠ 0) :
    (Fl.roundRat n d s : Fl f) = Fl.roundRat n d t := by
  unfold Fl.roundRat
  simp only [beq_eq_false_iff_ne.mpr hn, Bool.false_eq_true, ↓reduceIte]

end JuliaLean.ChatGPT.Batch10.Group1

