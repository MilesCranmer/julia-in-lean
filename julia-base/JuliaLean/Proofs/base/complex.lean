theorem fma_key_round (x y z : F64) (hx : F64.isfinite x = true) (hy : F64.isfinite y = true)
    (hz : F64.isfinite z = true) :
    F64.fma x y z = F64.roundRat (key64 x*key64 y+key64 z*((2^1074 : Nat) : Int))
      (2^2148) ((F64.signbit x != F64.signbit y) && F64.signbit z) := by
  obtain ⟨u, _, hdx⟩ := Scalar.ProofMisc.finite_den_pow x hx
  obtain ⟨v, _, hdy⟩ := Scalar.ProofMisc.finite_den_pow y hy
  obtain ⟨w, _, hdz⟩ := Scalar.ProofMisc.finite_den_pow z hz
