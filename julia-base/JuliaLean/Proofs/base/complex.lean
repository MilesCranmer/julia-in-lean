theorem positive_lt (x y : F64) (hx : F64.isfinite x = true) (hy : F64.isfinite y = true)
    (sx : F64.signbit x = false) (sy : F64.signbit y = false) :
    F64.lt x y = true ↔ F64.toBits x < F64.toBits y := by
  have hxb := (signbit_f x).mp sx
  have hyb := (signbit_f y).mp sy
  have hxn := (isnan_f x).mp (Scale.finite_not_nan x hx)
  have hyn := (isnan_f y).mp (Scale.finite_not_nan y hy)
  rw [lt_iff]
  simp only [hxn, hyn, Nat.mod_eq_of_lt hxb, Nat.mod_eq_of_lt hyb]
  simp only [not_false_eq_true, true_and]
  omega

theorem positive_le (x y : F64) (hx : F64.isfinite x = true) (hy : F64.isfinite y = true)
    (sx : F64.signbit x = false) (sy : F64.signbit y = false) :
    F64.le x y = true ↔ F64.toBits x ≤ F64.toBits y := by
  have hxb := (signbit_f x).mp sx
  have hyb := (signbit_f y).mp sy
  have hxn := (isnan_f x).mp (Scale.finite_not_nan x hx)
  have hyn := (isnan_f y).mp (Scale.finite_not_nan y hy)
  rw [F64.le, Bool.or_eq_true_iff, positive_lt x y hx hy sx sy, eq_iff]
  simp only [hxn, hyn, Nat.mod_eq_of_lt hxb, Nat.mod_eq_of_lt hyb]
  simp only [not_false_eq_true, true_and]
  omega

