set_option exponentiation.threshold 5000

def CorrectionProperty : Prop :=
  ∀ a : Int, ∀ d : Nat, -511 ≤ a → a ≤ 511 → d ≤ 26 → -511 ≤ a-d →
    correction (power a) (power (a-d))
      (F64.ofBits ((a+1023).toNat*2^52+(coefficient d-2^52))) =
      F64.ofBits ((a+1023).toNat*2^52+(coefficient d-2^52))

theorem tail_of_correction (hcorr : CorrectionProperty) : TailProperty := by
  intro a t d ha0 ha1 hd haq hp0 hp1 hpq ht
  have ht0 : -1074 ≤ t := by rcases ht with ht | ht | ht <;> omega
  have ht1 : t ≤ 1023 := by rcases ht with ht | ht | ht <;> omega
  obtain ⟨i, j, he, hr⟩ := EpsilonBounds.tail_raw a t d ha0 ha1 ht0 ht1 hd hp0 hp1
    (hcorr a d ha0 ha1 hd haq)
  let r := F64.roundRat ((coefficient d*2^i : Nat) : Int) (2^j) false
  have hlo := EpsilonBounds.lower_bound (a+t) d i j hp0 hp1 hpq hd he
  have hhi := EpsilonBounds.upper_bound (a+t) d i j hp0 hp1 hd he
  have heps := floatCheckEpsilonUpperEndpointSum (a+t) d i j hd hpq hp1 he
  refine ⟨r, hr, hlo.1, hlo.2.1, hlo.2.2.1, hlo.2.2.2, ?_⟩
  let endpoint := F64.roundRat (((2^52+2^(52-d))*2^i : Nat) : Int) (2^j) false
  have hden := rat_den_pos endpoint heps.1
  have hpd := rat_den_pos (power (a+t)) (power_classes (a+t) hp0 (by omega)).1
  have hqd := rat_den_pos (power (a+t-d)) (power_classes (a+t-d) hpq (by omega)).1
  have hsum : 0 < (RatSum (rat (power (a+t))) (rat (power (a+t-d)))).2 := Int.mul_pos hpd hqd
  exact (rat_equiv_right _ _ _ hden hsum heps.2.2).mp hhi

def HighCorrectionProperty : Prop :=
  ∀ a : Int, ∀ d : Nat, -485 ≤ a → a ≤ 511 → d ≤ 26 →
    correction (power a) (power (a-d))
      (F64.ofBits ((a+1023).toNat*2^52+(coefficient d-2^52))) =
      F64.ofBits ((a+1023).toNat*2^52+(coefficient d-2^52))

theorem correction_of_high (hhigh : HighCorrectionProperty) : CorrectionProperty := by
  intro a d ha0 ha1 hd haq
  by_cases hhi : -485 ≤ a
  · exact hhigh a d hhi ha1 hd
  · exact floatCheckEpsilonCorrectionLow a d ha0 (by omega) hd (by omega)

theorem complex_epsilon_of_high (hhigh : HighCorrectionProperty) : ComplexEpsilon :=
  complex_epsilon_of_tail (tail_of_correction (correction_of_high hhigh))

end JuliaLean.ChatGPT.Batch10.Group1.Epsilon

