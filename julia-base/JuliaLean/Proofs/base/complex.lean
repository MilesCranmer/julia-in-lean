      (fun error last =>
        (error = RootArrayAbstractError ∧
          ((last.label = "isconcretetype" ∧ last.detail = "false") ∨
           (last.label = "not" ∧ last.detail = "true"))) ∨
        (error = .typeError "if" ∧ last.label = "not" ∧ last.detail = "rejected"))
