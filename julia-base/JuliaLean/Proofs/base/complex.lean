  change F64.exponentField y = F64.exponentField x at he
  change F64.signbit y = F64.signbit x at hs
  change F64.fraction y = Nat.xor (F64.fraction x) 1 at hp
  have hy : F64.isfinite y = true := by simpa only [F64.isfinite, he] using hx
  have hxb : F64.exponentField x ≤ 2046 := by
    have hm : F64.exponentField x < 2048 := Nat.mod_lt _ (by decide)
    have hn : F64.exponentField x ≠ 2047 := bne_iff_ne.mp hx
