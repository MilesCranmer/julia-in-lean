    by_cases hh : F64.fraction x % 2 = 0 <;>
      simp only [hh, ↓reduceIte, decide_true, decide_false, Bool.false_eq_true] at h ⊢ <;> omega
  have hek : F64.exponentField x - 1 ≤ 2045 := by omega
  change F64.abs (F64.sub x y) = _
  rw [Scalar.ProofMisc.sub_finite x y hx hy]
  by_cases hz : F64.exponentField x = 0
  · have hzy : F64.exponentField y = 0 := he.trans hz
    rw [toRat_subn x hz, toRat_subn y hzy]
    simp only [Prod.fst, Prod.snd, hs]
