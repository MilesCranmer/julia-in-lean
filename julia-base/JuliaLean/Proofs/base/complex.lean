      _ = _ := by rw [key64_rat x hx, key64_rat y hy]; ac_rfl
  rw [hdx, hdy, ← Nat.pow_add] at hcross
  obtain ⟨hxn, hxi⟩ := floatCheckF64FiniteClasses x hx
  obtain ⟨hyn, hyi⟩ := floatCheckF64FiniteClasses y hy
  rw [mul_fin x y hxn hyn hxi hyi, hdx, hdy, ← Nat.pow_add]
