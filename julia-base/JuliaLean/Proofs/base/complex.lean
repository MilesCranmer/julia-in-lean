def LateRuntimeParts {E State A Result : Type} (parts : ComponentOps (MiddleM E State) A) :
    ComponentOps (MiddleRuntime E (MiddleWorld E (State × Option Result))) A where
  real := fun z => MiddleToRuntime (LateObserved "real" (parts.real z))
  imag := fun z => MiddleToRuntime (LateObserved "imag" (parts.imag z))

/-- Full float retains the nested scalar/constructor call language through
arbitrary custom Complex getter results.  It propagates exact selected errors,
mutation and terminal results at every depth.  A finite no-reentry body cannot
introduce divergence when every selected operation terminates.
Invariant: base/complex.jl:1130. -/
def LateFloatRecursiveAudit : Prop :=
  ∀ (E State A B Result : Type) (ops : UnaryConstructOps (MiddleM E State) A B Result)
      (dispatch : UnaryRecursiveDispatch A B Result)
      (parts : ComponentOps (MiddleM E State) A) (z : Complex A) (state : State),
    let observed : UnaryConstructOps (MiddleRuntime E (MiddleWorld E (State × Option Result))) A B Result :=
      { scalar := fun value => MiddleToRuntime (LateObserved "float" (ops.scalar value))
        construct := fun r i => MiddleToRuntime (LateReturned "construct" (ops.construct r i)) }
    let observation := MiddleRunRuntime
      (floatComplexFull
        (monotoneBind := Lean.Order.instMonoBindExceptT
          (m := StateT (MiddleWorld E (State × Option Result)) Option) (ε := E))
        observed dispatch z (LateRuntimeParts parts)) ((state, none), [])
    MiddleAudit (MiddleUnaryCompletePath "float" "construct") MiddleNoLocalError (state, none) observation ∧
    LateFinalResult observation ∧
    MiddleNoNewDivergence ((∀ a, dispatch.same a = none) ∧ MiddlePartsTotal parts ∧
      (∀ a, MiddleTotal (ops.scalar a)) ∧ (∀ r i, MiddleTotal (ops.construct r i))) observation

/-- A permitted custom real getter returning its same Complex input can
reselect the generic float fallback forever.  The actual source recursion
retains divergence instead of returning an arbitrary scalar or constructor value.
Invariant: base/complex.jl:1130. -/
def LateFloatRecursiveDivergence : Prop :=
  ∀ (E State B Result : Type)
      (ops : UnaryConstructOps (MiddleRuntime E State) MiddleRecursiveValue B Result)
      (embed : Result → B) (state : State),
    MiddleRunRuntime
      (floatComplexFull
        (monotoneBind := Lean.Order.instMonoBindExceptT (m := StateT State Option) (ε := E))
        ops { same := MiddleDecodeComplex, embed := embed }
        MiddleLoopValue MiddleLoopParts) state = none

/-- Full epsilon preserves every nested eps/eps/hypot frame, exact selected
failures and state, and the final hypot result.  The same-method classification
is unrestricted metadata and includes arbitrarily deep recursive selections.
Invariant: base/complex.jl:1164. -/
def LateEpsilonRecursiveAudit : Prop :=
  ∀ (E State A Epsilon Result : Type)
      (ops : EpsilonValueOps (MiddleM E State) A Epsilon Result)
      (dispatch : UnaryRecursiveDispatch A Epsilon Result)
      (parts : ComponentOps (MiddleM E State) A) (z : Complex A) (state : State),
    let observed : EpsilonValueOps (MiddleRuntime E (MiddleWorld E (State × Option Result))) A Epsilon Result :=
      { epsilon := fun value => MiddleToRuntime (LateObserved "epsilon" (ops.epsilon value))
        hypot := fun r i => MiddleToRuntime (LateReturned "hypot" (ops.hypot r i)) }
    let observation := MiddleRunRuntime
      (epsilonComplexFull
        (monotoneBind := Lean.Order.instMonoBindExceptT
          (m := StateT (MiddleWorld E (State × Option Result)) Option) (ε := E))
        observed dispatch z (LateRuntimeParts parts)) ((state, none), [])
    MiddleAudit (MiddleUnaryCompletePath "epsilon" "hypot") MiddleNoLocalError (state, none) observation ∧
    LateFinalResult observation ∧
    MiddleNoNewDivergence ((∀ a, dispatch.same a = none) ∧ MiddlePartsTotal parts ∧
      (∀ a, MiddleTotal (ops.epsilon a)) ∧ (∀ r i, MiddleTotal (ops.hypot r i))) observation

/-- The custom atom can represent an AbstractFloat subtype, whose selected
real getter returns the same Complex.  Repeated same-method epsilon dispatch
then diverges before reaching any scalar epsilon or hypot target.
Invariant: base/complex.jl:1164. -/
def LateEpsilonRecursiveDivergence : Prop :=
  ∀ (E State Epsilon Result : Type)
      (ops : EpsilonValueOps (MiddleRuntime E State) MiddleRecursiveValue Epsilon Result)
      (embed : Result → Epsilon) (state : State),
    MiddleRunRuntime
      (epsilonComplexFull
        (monotoneBind := Lean.Order.instMonoBindExceptT (m := StateT State Option) (ε := E))
        ops { same := MiddleDecodeComplex, embed := embed }
        MiddleLoopValue MiddleLoopParts) state = none

/-- Number of selected nonrecursive scalar leaves in a finite observation tree. -/
def LateLeafCount : MiddlePairCallTree → Nat
  | .leaf => 1
  | .node left right => LateLeafCount left + LateLeafCount right

/-- Recursive round calls receive the single current mode as both component
modes.  Thus all scalar leaves in the original real subtree use rr, all in the
original imaginary subtree use ri, and every leaf retains the original keywords.
This audits argument observations, not a second numerical rounding algorithm. -/
def LateRecursiveRoundArguments {E State Result Mode Keywords : Type}
    (modeInfo : Mode → String) (keywordInfo : Keywords → String)
    (rr ri : Mode) (keywords : Keywords)
    (observation : Option (Except (E × MiddleWorld E State) (Result × MiddleWorld E State))) : Prop :=
  match observation with
  | none => True
  | some (.ok (_, (_, history))) =>
      ∃ left right,
        MiddleLabels history = MiddleUnaryHistory "round" "construct" (.node left right) ∧
        MiddleDetails "round" history =
          List.replicate (LateLeafCount left) (LateRoundInfo modeInfo keywordInfo rr keywords) ++
          List.replicate (LateLeafCount right) (LateRoundInfo modeInfo keywordInfo ri keywords)
  | some (.error (_, (_, history))) =>
      ∀ call ∈ history, call.label = "round" → call.failure = none →
        call.detail = LateRoundInfo modeInfo keywordInfo rr keywords ∨
        call.detail = LateRoundInfo modeInfo keywordInfo ri keywords

/-- Full rounding preserves every recursive frame, constructor result,
selected failure and state.  All modes/keywords are retained through recursive
single-mode defaults as well as the original zero/one/two-mode entry forms.
Invariant/docstring: base/complex.jl:1093-1126. -/
def LateRoundRecursiveAudit : Prop :=
  ∀ (E State A Mode Keywords Rounded Result : Type)
      (ops : RoundOps (MiddleM E State) A Mode Keywords Rounded Result)
      (dispatch : RoundRecursiveDispatch A Mode Keywords Rounded Result)
      (parts : ComponentOps (MiddleM E State) A)
      (modeInfo : Mode → String) (keywordInfo : Keywords → String)
      (z : Complex A) (rr ri : Mode) (keywords : Keywords) (state : State),
    let base := LateObserveRound ops modeInfo keywordInfo
    let observed : RoundOps (MiddleRuntime E (MiddleWorld E (State × Option Result))) A Mode Keywords Rounded Result :=
      { nearest := base.nearest
        round := fun a mode kw => MiddleToRuntime (base.round a mode kw)
        construct := fun r i => MiddleToRuntime (base.construct r i) }
    let components := LateRuntimeParts parts
    let both := MiddleRunRuntime
      (roundComplexFull
        (monotoneBind := Lean.Order.instMonoBindExceptT
          (m := StateT (MiddleWorld E (State × Option Result)) Option) (ε := E))
        observed dispatch z rr ri keywords components) ((state, none), [])
    let first := MiddleRunRuntime
      (roundComplexFull
        (monotoneBind := Lean.Order.instMonoBindExceptT
          (m := StateT (MiddleWorld E (State × Option Result)) Option) (ε := E))
        observed dispatch z rr (keywords := keywords) (parts := components)) ((state, none), [])
    let defaults := MiddleRunRuntime
      (roundComplexFull
        (monotoneBind := Lean.Order.instMonoBindExceptT
          (m := StateT (MiddleWorld E (State × Option Result)) Option) (ε := E))
        observed dispatch z (keywords := keywords) (parts := components)) ((state, none), [])
    let finite := (∀ a mode kw, dispatch.same a mode kw = none) ∧ MiddlePartsTotal parts ∧
      (∀ a mode kw, MiddleTotal (ops.round a mode kw)) ∧ (∀ r i, MiddleTotal (ops.construct r i))
    let check := fun observation =>
      MiddleAudit (MiddleUnaryCompletePath "round" "construct") MiddleNoLocalError (state, none) observation ∧
      LateFinalResult observation ∧ MiddleNoNewDivergence finite observation
    check both ∧ LateRecursiveRoundArguments modeInfo keywordInfo rr ri keywords both ∧
    check first ∧ LateRecursiveRoundArguments modeInfo keywordInfo rr rr keywords first ∧
    check defaults ∧ LateRecursiveRoundArguments modeInfo keywordInfo ops.nearest ops.nearest keywords defaults

/-- Repeated recursive round selection caused by a custom getter retains
nontermination, including the recursive imaginary-mode default and every
arbitrary initial mode/keyword bundle.  No selected scalar target is fabricated.
Invariant: base/complex.jl:1123-1126. -/
def LateRoundRecursiveDivergence : Prop :=
  ∀ (E State Mode Keywords Rounded Result : Type)
      (ops : RoundOps (MiddleRuntime E State) MiddleRecursiveValue Mode Keywords Rounded Result)
      (embed : Result → Rounded) (rr ri : Mode) (keywords : Keywords) (state : State),
    MiddleRunRuntime
      (roundComplexFull
        (monotoneBind := Lean.Order.instMonoBindExceptT (m := StateT State Option) (ε := E))
        ops { same := fun value _ _ => MiddleDecodeComplex value, embed := embed }
        MiddleLoopValue rr ri keywords MiddleLoopParts) state = none

def LateFloatComplete : Prop := LateFloat ∧ LateFloatRecursiveAudit ∧ LateFloatRecursiveDivergence

def LateEpsilonComplete : Prop := LateEpsilonValueAudit ∧ LateEpsilonRecursiveAudit ∧ LateEpsilonRecursiveDivergence

def LateRoundComplete : Prop := LateRoundAudit ∧ LateRoundRecursiveAudit ∧ LateRoundRecursiveDivergence

end JuliaLean.Proofs.base.complex.Models2Group9


