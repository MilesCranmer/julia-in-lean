/-- Independent mathematical representability in a machine-integer type. -/
def FitsInt (t : IntTy) (n : Int) : Prop := t.min ≤ n ∧ n ≤ t.max

/-- An observation of checked complex construction: exact fields on success; an
InexactError precisely when at least one requested integer is unrepresentable. -/
def IntPairObservation {t : IntTy} (a b : Int) (r : Jl (Complex (JInt t))) : Prop :=
  match r with
  | .ok z => z.re.val = a ∧ z.im.val = b
  | .error (.inexactError _) => ¬ (FitsInt t a ∧ FitsInt t b)
  | .error _ => False

/-- Numerical integrality and range, independent of the scalar conversion algorithm. -/
def FloatIntegerValue (t : IntTy) (x : F64) (n : Int) : Prop :=
  F64.isfinite x = true ∧ FitsInt t n ∧
    (F64.toRat x).1 = n * ((F64.toRat x).2 : Int)

/-- Checked complex construction from floating fields, including every error input. -/
def FloatIntPairObservation (t : IntTy) (x y : F64)
    (r : Jl (Complex (JInt t))) : Prop :=
  match r with
  | .ok z => FloatIntegerValue t x z.re.val ∧ FloatIntegerValue t y z.im.val
  | .error (.inexactError _) =>
      ¬ ((∃ a : Int, FloatIntegerValue t x a) ∧ (∃ b : Int, FloatIntegerValue t y b))
  | .error _ => False

/-- Exact integer distance from a finite binary64, with its positive denominator retained. -/
def IntegerDistance (n : Int) (x : F64) : Int × Int :=
  (Int.natAbs ((F64.toRat x).1 - n * ((F64.toRat x).2 : Int)),
    (F64.toRat x).2)

/-- Independent nearest-even binary64 specification for a machine integer. All machine
integers are finite in binary64. Signed zero is fixed to positive zero for n = 0. -/
def NearestInteger64 (n : Int) (x : F64) : Prop :=
  F64.isfinite x = true ∧
  (n = 0 → x = F64.zero false) ∧
  ∀ y : F64, F64.isfinite y = true →
    (IntegerDistance n x).1 * (IntegerDistance n y).2 ≤
      (IntegerDistance n y).1 * (IntegerDistance n x).2 ∧
    ((IntegerDistance n x).1 * (IntegerDistance n y).2 =
        (IntegerDistance n y).1 * (IntegerDistance n x).2 →
      F64.eq x y = false → F64.toBits x % 2 = 0)

/-- Constructors preserve every represented integer when representable and fail with
InexactError otherwise. There are no input range premises.
Documentation: base/complex.jl:3-18,42-43; doc/src/manual/conversion-and-promotion.md:201-243. -/
def IntegerConstructors : Prop :=
  (∀ (t s : IntTy) (x : JInt t) (y : JInt s),
    IntPairObservation x.val y.val (complexIntPair x y)) ∧
  (∀ (t : IntTy) (x : JInt t),
    IntPairObservation x.val 0 (complexIntReal x)) ∧
  (∀ (t s : IntTy) (x : JInt s),
    IntPairObservation x.val 0 (complexIntAsInt t x)) ∧
  (∀ (t s : IntTy) (z : Complex (JInt s)),
    IntPairObservation z.re.val z.im.val (convertComplexInt t z))

/-- Identity construction stores the supplied fields without numeric arithmetic; this
includes all NaN payloads and both signed zeros. Unlike a restatement with a supplied
promotion law, these conclusions test closed executable calls.
Documentation: base/complex.jl:3-18,42-43,157-168. -/
def IdentityConstructors : Prop :=
  (∀ (x y : F64), complexF64Pair x y = .ok ⟨x, y⟩) ∧
  (∀ (x : F64), complexF64Real x = .ok ⟨x, F64.zero false⟩ ∧
    complexF64AsF64 x = .ok ⟨x, F64.zero false⟩) ∧
  (∀ z : ComplexF64, convertComplexF64 z = .ok z) ∧
  (∀ (x y : Bool), complexBoolPair x y = .ok ⟨x, y⟩) ∧
  (∀ x : Bool, complexBoolReal x = .ok ⟨x, false⟩)

/-- Float-to-integer construction accepts exactly finite integral values in the target
range; all other inputs produce InexactError. Full binary64 input domain.
Documentation: base/complex.jl:42-43; base/float.jl:895-927. -/
def FloatToIntConstructors : Prop :=
  (∀ (t : IntTy) (x : F64),
    FloatIntPairObservation t x (F64.zero false) (complexF64AsInt t x)) ∧
  (∀ (t : IntTy) (z : ComplexF64),
    FloatIntPairObservation t z.re z.im (convertComplexF64ToInt t z))

/-- Every machine integer converts to its nearest-even binary64 component. Expected
values are specified by rational distances, not by repeating the conversion call.
Documentation: base/complex.jl:42-43; base/float.jl:243-305; doc/src/manual/integers-and-floating-point-numbers.md:523-531. -/
def IntToFloatConstructors : Prop :=
  (∀ (t : IntTy) (x : JInt t),
    match complexIntAsF64 x with
    | .ok z => NearestInteger64 x.val z.re ∧ z.im = F64.zero false
    | .error _ => False) ∧
  (∀ (t : IntTy) (z : Complex (JInt t)),
    match convertComplexIntToF64 z with
    | .ok w => NearestInteger64 z.re.val w.re ∧ NearestInteger64 z.im.val w.im
    | .error _ => False)

/-- Scalar integer conversion succeeds exactly for a zero imaginary component and
an exactly representable integral real component, including mixed source widths.
Documentation: base/complex.jl:44-45,126-131; base/float.jl:895-927. -/
def ComplexToInteger : Prop :=
  (∀ (t s : IntTy) (z : Complex (JInt s)),
    match realIntAsInt t z with
    | .ok x => z.im.val = 0 ∧ x.val = z.re.val
    | .error (.inexactError _) => ¬ (z.im.val = 0 ∧ FitsInt t z.re.val)
    | .error _ => False) ∧
  (∀ (t : IntTy) (z : ComplexF64),
    match realF64AsInt t z with
    | .ok x => F64.iszero z.im = true ∧ FloatIntegerValue t z.re x.val
    | .error (.inexactError _) =>
        ¬ (F64.iszero z.im = true ∧ ∃ n : Int, FloatIntegerValue t z.re n)
    | .error _ => False)

/-- Scalar Float64 conversion rejects exactly nonzero or NaN imaginary parts.
Identity conversion retains every real bit; integer conversion uses nearest-even rounding.
Documentation: base/complex.jl:44-45,126-131. -/
def ComplexToFloat : Prop :=
  (∀ (t : IntTy) (z : Complex (JInt t)),
    match realIntAsF64 z with
    | .ok x => z.im.val = 0 ∧ NearestInteger64 z.re.val x
    | .error (.inexactError _) => z.im.val ≠ 0
    | .error _ => False) ∧
  (∀ z : ComplexF64,
    match realF64AsF64 z with
    | .ok x => F64.iszero z.im = true ∧ x = z.re
    | .error (.inexactError _) => F64.iszero z.im = false
    | .error _ => False)

/-- Mixed integer/Float64 construction is total, preserves the existing floating coordinate bit-for-bit, and independently rounds the integer coordinate to nearest-even. Documentation: base/complex.jl:17; base/float.jl:243-350; manual/conversion-and-promotion.md:238-243. -/
def MixedIntegerFloatConstructors : Prop :=
  (∀ (t : IntTy) (x : JInt t) (y : F64),
    match complexIntF64Pair x y with
    | .ok z => NearestInteger64 x.val z.re ∧ z.im = y
    | .error _ => False) ∧
  (∀ (t : IntTy) (x : F64) (y : JInt t),
    match complexF64IntPair x y with
    | .ok z => z.re = x ∧ NearestInteger64 y.val z.im
    | .error _ => False)

/-- Type promotion chooses the widest machine integer and unsigned on equal-width
mixed signedness. Widening doubles widths until the 128-bit BigInt boundary.
Documentation: base/complex.jl:49-57; base/int.jl:809-822,911-918; base/gmp.jl:298-299. -/
def IntegerTypeTransforms : Prop :=
  (∀ t s : IntTy,
    match promoteComplexIntRealType t s, promoteComplexIntType t s with
    | .complex r, .complex q => r = q ∧
        r.bits = max t.bits s.bits ∧
        (t.bits = s.bits → r.signed = (t.signed && s.signed)) ∧
        (s.bits < t.bits → r = t) ∧ (t.bits < s.bits → r = s)
    | _, _ => False) ∧
  (∀ t : IntTy,
    match widenComplexIntType t with
    | .complex (.machine w) => w.bits = 2 * t.bits ∧ w.signed = t.signed
    | .complex .bigInt => t.bits = 128
    | _ => False) ∧
  (∀ t : IntTy, floatComplexIntType t = .complex double)

/-- The returned parts reconstruct the stored complex value; real inputs have a
positive zero imaginary part. No scalar callback is quantified.
Documentation: base/complex.jl:59-123. -/
def PartsRoundTrip : Prop :=
  (∀ (T : Type) (z : Complex T),
    let parts := reimComplex z
    (⟨parts.1, parts.2⟩ : Complex T) = z) ∧
  (∀ (t : IntTy) (x : JInt t),
    (reimInt x).1 = x ∧ (reimInt x).2.val = 0 ∧ (imaginaryIntReal x).val = 0) ∧
  (∀ x : F64, (reimF64 x).1 = x ∧
    (reimF64 x).2 = F64.zero false ∧ imaginaryF64Real x = F64.zero false) ∧
  (∀ (R : Type) (t : R), realConcreteComplexType t = .real t)

/-- Gaussian-integer classification over every width and value.
Documentation: base/complex.jl:126-155 and numerical classification invariants. -/
def IntegerPredicates : Prop :=
  ∀ (t : IntTy) (z : Complex (JInt t)),
    (integerInt z = true ↔ z.im.val = 0) ∧
    finiteInt z = true ∧ nanInt z = false ∧ infiniteInt z = false ∧
    (zeroInt z = true ↔ z.re.val = 0 ∧ z.im.val = 0) ∧
    (oneInt z = true ↔ z.re.val = 1 ∧ z.im.val = 0)

/-- IEEE bit-level zero classification used only as an independent specification. -/
def NumericalZero64 (x : F64) : Prop := F64.toBits x % 2^63 = 0

/-- IEEE NaN classification used only as an independent specification. -/
def NaN64 (x : F64) : Prop :=
  F64.toBits x / 2^52 % 2048 = 2047 ∧ F64.toBits x % 2^52 ≠ 0

/-- IEEE infinity classification used only as an independent specification. -/
def Infinite64 (x : F64) : Prop := F64.toBits x % 2^63 = 0x7ff0000000000000

/-- Ordered numerical equality: NaNs compare unequal and signed zeros compare equal. -/
def NumericalEqual64 (x y : F64) : Prop :=
  ¬ NaN64 x ∧ ¬ NaN64 y ∧ (x = y ∨ (NumericalZero64 x ∧ NumericalZero64 y))

/-- Complete binary64 complex classification, including all NaNs, infinities and signed
zeros. Integrality is defined by decoded rational value, not a scalar correctness law.
Documentation: base/complex.jl:126-155; manual/integers-and-floating-point-numbers.md. -/
def FloatPredicates : Prop :=
  ∀ z : ComplexF64,
    (integerF64 z = true ↔ NumericalZero64 z.im ∧
      F64.isfinite z.re = true ∧
        ∃ n : Int, (F64.toRat z.re).1 = n * ((F64.toRat z.re).2 : Int)) ∧
    (finiteF64 z = true ↔
      ¬NaN64 z.re ∧ ¬NaN64 z.im ∧ ¬Infinite64 z.re ∧ ¬Infinite64 z.im) ∧
    (nanF64 z = true ↔ NaN64 z.re ∨ NaN64 z.im) ∧
    (infiniteF64 z = true ↔ Infinite64 z.re ∨ Infinite64 z.im) ∧
    (zeroF64 z = true ↔ NumericalZero64 z.re ∧ NumericalZero64 z.im) ∧
    (oneF64 z = true ↔ F64.toBits z.re = 0x3ff0000000000000 ∧ NumericalZero64 z.im)

/-- The public complex aliases construct stored components with checked integer
promotion and with exact identity storage for Float64.
Documentation: base/complex.jl:157-170. -/
def PublicComplexAliases : Prop :=
  (∀ (t : IntTy) (x : JInt t), IntPairObservation x.val 0 (asComplexInt x)) ∧
  (∀ (t s : IntTy) (x : JInt t) (y : JInt s),
    IntPairObservation x.val y.val (asComplexIntPair x y)) ∧
  (∀ x : F64, asComplexF64 x = .ok ⟨x, F64.zero false⟩) ∧
  (∀ x y : F64, asComplexF64Pair x y = .ok ⟨x, y⟩) ∧
  (∀ (t : IntTy) (x : JInt t) (y : F64),
    match asComplexIntF64Pair x y with
    | .ok z => NearestInteger64 x.val z.re ∧ z.im = y
    | .error _ => False) ∧
  (∀ (t : IntTy) (x : F64) (y : JInt t),
    match asComplexF64IntPair x y with
    | .ok z => z.re = x ∧ NearestInteger64 y.val z.im
    | .error _ => False)

/-- Flipsign performs modular integer negation or changes floating signs while preserving floating magnitudes and payloads. The Bool
case preserves the source result type change to Int64 only on the negated branch.
Documentation: base/complex.jl:197; flipsign and ifelse invariants. -/
def PrimitiveFlipsign : Prop :=
  (∀ (t s : IntTy) (z : Complex (JInt t)) (y : JInt s),
    let r := flipsignInt z y
    (y.val < 0 → (r.re.val + z.re.val) % (2 ^ t.bits : Int) = 0 ∧
      (r.im.val + z.im.val) % (2 ^ t.bits : Int) = 0) ∧
    (0 ≤ y.val → r = z)) ∧
  (∀ (z : ComplexF64) (y : F64),
    let r := flipsignF64 z y
    F64.toBits r.re % 2^63 = F64.toBits z.re % 2^63 ∧
    F64.toBits r.im % 2^63 = F64.toBits z.im % 2^63 ∧
    F64.signbit r.re = (F64.signbit z.re != F64.signbit y) ∧
    F64.signbit r.im = (F64.signbit z.im != F64.signbit y)) ∧
  (∀ (z : Complex Bool) (y : F64),
    match flipsignBoolF64 z y with
    | .inl r => F64.signbit y = true ∧
        r.re.val = -(if z.re then 1 else 0) ∧ r.im.val = -(if z.im then 1 else 0)
    | .inr r => F64.signbit y = false ∧ r = z)

/-- Complex numerical equality compares both coordinates; isequal additionally
distinguishes signed zeros and equates all NaNs. Complete primitive value domains.
Documentation: base/complex.jl:246-252; scalar == and isequal contracts. -/
def PrimitiveEqualities : Prop :=
  (∀ (t : IntTy) (z w : Complex (JInt t)),
    equalInt z w = true ↔ z.re.val = w.re.val ∧ z.im.val = w.im.val) ∧
  (∀ z w : ComplexF64,
    equalF64 z w = true ↔ NumericalEqual64 z.re w.re ∧ NumericalEqual64 z.im w.im) ∧
  (∀ (t : IntTy) (x : JInt t) (z : Complex (JInt t)),
    equalRealInt x z = true ↔ z.re.val = x.val ∧ z.im.val = 0) ∧
  (∀ (x : F64) (z : ComplexF64),
    equalRealF64 x z = true ↔ NumericalEqual64 x z.re ∧ NumericalZero64 z.im) ∧
  (∀ (t : IntTy) (x : JInt t) (z : Complex (JInt t)),
    isequalRealInt x z = true ↔ z.re.val = x.val ∧ z.im.val = 0) ∧
  (∀ (x : F64) (z : ComplexF64),
    isequalRealF64 x z = true ↔
      (x = z.re ∨ (NaN64 x ∧ NaN64 z.re)) ∧ F64.toBits z.im = 0)

/-- Squared norm agrees with the exact Gaussian-integer norm modulo the machine
modulus; floating squared norm is nonnegative, with NaN exactly for a NaN component.
Documentation: manual/complex-and-rational-numbers.md:113-116;
manual/integers-and-floating-point-numbers.md:231-249; base/complex.jl:282. -/
def SquaredNorms : Prop :=
  (∀ (t : IntTy) (z : Complex (JInt t)),
    ((abs2Int z).val - (z.re.val ^ 2 + z.im.val ^ 2)) % (2 ^ t.bits : Int) = 0) ∧
  (∀ z : ComplexF64,
    (NaN64 (abs2F64 z) ↔ NaN64 z.re ∨ NaN64 z.im) ∧
    (¬NaN64 (abs2F64 z) → F64.signbit (abs2F64 z) = false))

/-- Equality of stored coordinates to mathematical Gaussian integers modulo 2^bits.
This specification performs arithmetic in Int and imposes no no-overflow premise. -/
def ModularCoordinates {t : IntTy} (r i : Int) (z : Complex (JInt t)) : Prop :=
  (z.re.val - r) % (2 ^ t.bits : Int) = 0 ∧
  (z.im.val - i) % (2 ^ t.bits : Int) = 0

/-- Mathematical value of Bool, used only in specifications. -/
def BoolInteger (b : Bool) : Int := if b then 1 else 0

/-- Inverse of any nonzero machine-integer complex value has finite Float64
components with the conjugate signs. The operation returns normally even at zero.
Documentation: base/complex.jl:288,482-510; reciprocal/conjugate invariant. -/
def IntegerInverseFinite : Prop :=
  ∀ (t : IntTy) (z : Complex (JInt t)),
    match inverseInt z with
    | .error _ => False
    | .ok w => z.re.val ≠ 0 ∨ z.im.val ≠ 0 →
        F64.isfinite w.re = true ∧ F64.isfinite w.im = true ∧
        F64.signbit w.re = decide (z.re.val < 0) ∧
        F64.signbit w.im = decide (0 ≤ z.im.val)

/-- Every ordinary and explicit wrapping operation agrees with exact Gaussian-integer
arithmetic modulo the machine width, with all input values included.
Documentation: base/complex.jl:290-301; manual/complex-and-rational-numbers.md:20-53;
manual/integers-and-floating-point-numbers.md:231-249. -/
def IntegerArithmetic : Prop :=
  ∀ (t : IntTy) (z w : Complex (JInt t)),
    ModularCoordinates z.re.val z.im.val (positiveInt z) ∧
    ModularCoordinates (-z.re.val) (-z.im.val) (negativeInt z) ∧
    ModularCoordinates (z.re.val + w.re.val) (z.im.val + w.im.val) (addInt z w) ∧
    ModularCoordinates (z.re.val - w.re.val) (z.im.val - w.im.val) (subtractInt z w) ∧
    ModularCoordinates (z.re.val*w.re.val - z.im.val*w.im.val)
      (z.re.val*w.im.val + z.im.val*w.re.val) (multiplyInt z w) ∧
    ModularCoordinates (-z.re.val) (-z.im.val) (negativeWrapInt z) ∧
    ModularCoordinates (z.re.val + w.re.val) (z.im.val + w.im.val) (addWrapInt z w) ∧
    ModularCoordinates (z.re.val - w.re.val) (z.im.val - w.im.val) (subtractWrapInt z w) ∧
    ModularCoordinates (z.re.val*w.re.val - z.im.val*w.im.val)
      (z.re.val*w.im.val + z.im.val*w.re.val) (multiplyWrapInt z w)

/-- Float64 unary plus retains every bit; unary minus changes precisely the component
sign bits, including signed zeros and all NaNs. Source: base/complex.jl:290-291. -/
def FloatUnaryArithmetic : Prop :=
  ∀ z : ComplexF64,
    positiveF64 z = z ∧
    F64.toBits (negativeF64 z).re % 2^63 = F64.toBits z.re % 2^63 ∧
    F64.toBits (negativeF64 z).im % 2^63 = F64.toBits z.im % 2^63 ∧
    F64.signbit (negativeF64 z).re = !F64.signbit z.re ∧
    F64.signbit (negativeF64 z).im = !F64.signbit z.im

/-- All closed Bool/machine-integer combinations obey the corresponding exact
Gaussian arithmetic modulo the output width, including unsigned subtraction.
Documentation: base/complex.jl:318-334; manual modular arithmetic. -/
def IntegerBoolArithmetic : Prop :=
  ∀ (t : IntTy) (x : Bool) (z : Complex (JInt t)) (r : JInt t) (b : Complex Bool),
    ModularCoordinates (BoolInteger x + z.re.val) z.im.val (addBoolInt x z) ∧
    ModularCoordinates (z.re.val + BoolInteger x) z.im.val (addIntBool x z) ∧
    ModularCoordinates (BoolInteger x - z.re.val) (-z.im.val) (subtractBoolInt x z) ∧
    ModularCoordinates (z.re.val - BoolInteger x) z.im.val (subtractIntBool x z) ∧
    ModularCoordinates (z.re.val * BoolInteger x) (z.im.val * BoolInteger x) (multiplyIntBool z x) ∧
    ModularCoordinates (r.val + BoolInteger b.re) (BoolInteger b.im) (addRealIntComplexBool r b) ∧
    ModularCoordinates (BoolInteger b.re + r.val) (BoolInteger b.im) (addComplexBoolRealInt b r) ∧
    ModularCoordinates (r.val - BoolInteger b.re) (-BoolInteger b.im) (subtractRealIntComplexBool r b) ∧
    ModularCoordinates (BoolInteger b.re - r.val) (BoolInteger b.im) (subtractComplexBoolRealInt b r) ∧
    ModularCoordinates (r.val * BoolInteger b.re) (r.val * BoolInteger b.im) (multiplyRealIntComplexBool r b) ∧
    ModularCoordinates (BoolInteger b.re * r.val) (BoolInteger b.im * r.val) (multiplyComplexBoolRealInt b r)

/-- Right multiplication by false clears NaN and infinity to signed zeros, while true
preserves the entire value. Full binary64 domain.
Documentation: base/complex.jl:323; base/bool.jl:161-165. -/
def FloatBoolStrongZero : Prop :=
  ∀ (z : ComplexF64) (b : Bool),
    let r := multiplyF64Bool z b
    (b = true → r = z) ∧
    (b = false → NumericalZero64 r.re ∧ NumericalZero64 r.im ∧
      F64.signbit r.re = F64.signbit z.re ∧ F64.signbit r.im = F64.signbit z.im)

/-- Scalar/complex operations match the mathematical embedding of real integers
into Gaussian integers modulo the machine width. Source: base/complex.jl:337-346. -/
def IntegerRealArithmetic : Prop :=
  ∀ (t : IntTy) (x : JInt t) (z : Complex (JInt t)),
    ModularCoordinates (x.val + z.re.val) z.im.val (addRealInt x z) ∧
    ModularCoordinates (x.val + z.re.val) z.im.val (addIntReal x z) ∧
    ModularCoordinates (x.val - z.re.val) (-z.im.val) (subtractRealInt x z) ∧
    ModularCoordinates (z.re.val - x.val) z.im.val (subtractIntReal x z) ∧
    ModularCoordinates (x.val * z.re.val) (x.val * z.im.val) (multiplyRealInt x z) ∧
    ModularCoordinates (x.val * z.re.val) (x.val * z.im.val) (multiplyIntReal x z)

/-- Every assigned integer muladd specialization equals the exact multiply-plus-add
polynomial modulo the output width; no correctness law about a scalar callee is assumed.
Documentation: base/complex.jl:348-355; base/math.jl muladd; manual modular arithmetic. -/
def IntegerMuladd : Prop :=
  ∀ (t : IntTy) (x y : JInt t) (z w : Complex (JInt t)),
    ModularCoordinates (z.re.val*x.val + y.val) (z.im.val*x.val) (muladdIntRealReal z x y) ∧
    ModularCoordinates (z.re.val*x.val + w.re.val) (z.im.val*x.val + w.im.val)
      (muladdIntRealComplex z x w) ∧
    ModularCoordinates (x.val*y.val + z.re.val) z.im.val (muladdRealRealInt x y z) ∧
    ModularCoordinates (z.re.val*w.re.val - z.im.val*w.im.val + x.val)
      (z.re.val*w.im.val + z.im.val*w.re.val) (muladdIntIntReal z w x) ∧
    ModularCoordinates (x.val*z.re.val + y.val) (x.val*z.im.val)
      (muladdRealIntComplexUnion x z (.real y)) ∧
    ModularCoordinates (x.val*z.re.val + w.re.val) (x.val*z.im.val + w.im.val)
      (muladdRealIntComplexUnion x z (.complex w))

/-- Independent rational distance, represented without floating arithmetic. -/
def RationalDistance64 (n : Int) (d : Nat) (x : F64) : Int × Int :=
  (Int.natAbs ((F64.toRat x).1 * (d : Int) - n * ((F64.toRat x).2 : Int)),
    (F64.toRat x).2)

/-- Round a rational to binary64 by nearest-distance and even-significand conditions.
Overflow is specified by the midpoint between floatmax and 2^1024. A nonzero
rational that underflows retains its mathematical sign in the resulting zero. -/
def NearestRational64 (n : Int) (d : Nat) (zeroSign : Bool) (x : F64) : Prop :=
  0 < d ∧
  if n.natAbs ≥ (2^1024 - 2^970) * d then
    Infinite64 x ∧ F64.signbit x = decide (n < 0)
  else
    F64.isfinite x = true ∧
    F64.signbit x = (if n = 0 then zeroSign else decide (n < 0)) ∧
    ∀ y : F64, F64.isfinite y = true →
      (RationalDistance64 n d x).1 * (RationalDistance64 n d y).2 ≤
        (RationalDistance64 n d y).1 * (RationalDistance64 n d x).2 ∧
      ((RationalDistance64 n d x).1 * (RationalDistance64 n d y).2 =
          (RationalDistance64 n d y).1 * (RationalDistance64 n d x).2 →
        F64.eq x y = false → F64.toBits x % 2 = 0)

/-- Independent IEEE division specification, including all exceptional input classes.
The finite branch uses exact decoded rational division and minimization over the
representable set rather than calling any implementation's rounding function. -/
def ScalarQuotient64 (a b r : F64) : Prop :=
  let invalid := NaN64 a ∨ NaN64 b ∨ (Infinite64 a ∧ Infinite64 b) ∨
    (NumericalZero64 a ∧ NumericalZero64 b)
  let pole := Infinite64 a ∨ NumericalZero64 b
  (invalid → NaN64 r) ∧
  (¬invalid ∧ pole →
    Infinite64 r ∧ F64.signbit r = (F64.signbit a != F64.signbit b)) ∧
  (¬invalid ∧ ¬pole ∧ Infinite64 b →
    NumericalZero64 r ∧ F64.signbit r = (F64.signbit a != F64.signbit b)) ∧
  (¬invalid ∧ ¬pole ∧ ¬Infinite64 b →
    let numerator := (F64.toRat a).1 * ((F64.toRat b).2 : Int)
    let n := if (F64.toRat b).1 < 0 then -numerator else numerator
    let d := (F64.toRat a).2 * (F64.toRat b).1.natAbs
    NearestRational64 n d (F64.signbit a != F64.signbit b) r)

/-- Integer division's expected value uses independently specified operand rounding. -/
def IntegerScalarQuotient64 (a b : Int) (r : F64) : Prop :=
  ∃ x y : F64, NearestInteger64 a x ∧ NearestInteger64 b y ∧ ScalarQuotient64 x y r

/-- Each coordinate obeys the independent IEEE quotient relation over all Float64
and machine-integer inputs, including zero, overflow, underflow, infinity and NaN.
Documentation: base/complex.jl:358; manual/integers-and-floating-point-numbers.md:523-531;
manual/complex-and-rational-numbers.md:20-86. -/
def ComplexScalarDivision : Prop :=
  (∀ (z : ComplexF64) (x : F64),
    ScalarQuotient64 z.re x (divideComplexF64ByReal z x).re ∧
    ScalarQuotient64 z.im x (divideComplexF64ByReal z x).im) ∧
  (∀ (t s : IntTy) (z : Complex (JInt t)) (x : JInt s),
    IntegerScalarQuotient64 z.re.val x.val (divideComplexIntByReal z x).re ∧
    IntegerScalarQuotient64 z.im.val x.val (divideComplexIntByReal z x).im)

/-- Only the divisor is converted to the promoted complex integer type before
reciprocation. For a nonzero divisor the result is finite and coordinate zeros
match the mathematical quotient. No source or target width is excluded.
Source: base/complex.jl:357. -/
def RealComplexIntegerDivision : Prop :=
  ∀ (t s : IntTy) (a : JInt t) (z : Complex (JInt s)),
    let promoted := IntTy.promote t s
    match divideRealIntByComplexInt a z with
    | .error (.inexactError _) => ¬(FitsInt promoted z.re.val ∧ FitsInt promoted z.im.val)
    | .error _ => False
    | .ok w => FitsInt promoted z.re.val ∧ FitsInt promoted z.im.val ∧
        (z.re.val ≠ 0 ∨ z.im.val ≠ 0 →
          F64.isfinite w.re = true ∧ F64.isfinite w.im = true ∧
          (NumericalZero64 w.re ↔ a.val = 0 ∨ z.re.val = 0) ∧
          (NumericalZero64 w.im ↔ a.val = 0 ∨ z.im.val = 0))

/-- A finite real numerator divided by a complex value with an infinite component
returns complex numerical zero; the operation is total on all binary64 values.
Source: base/complex.jl:357,482-510; reciprocal-at-infinity invariant. -/
def RealComplexFloatInfinity : Prop :=
  ∀ (a : F64) (z : ComplexF64),
    match divideRealF64ByComplex a z with
    | .error _ => False
    | .ok w => F64.isfinite a = true →
        (F64.isinf z.re = true ∨ F64.isinf z.im = true) →
        NumericalZero64 w.re ∧ NumericalZero64 w.im

/-- Across every Float16/Float32 input bit pattern, finite division by a finite nonzero
divisor introduces no NaN; division by one preserves finite values; finite-over-
infinite division is zero when the divisor contains no NaN. These are independent
numerical invariants, not a transcription of the widened arithmetic.
Source: base/complex.jl:379-392; manual/complex-and-rational-numbers.md:20-86. -/
def SmallDivisionSanity : Prop :=
  ∀ (k : SmallFloatKind) (z w : Complex (SmallValue k)),
    (z.re.isfinite = true ∧ z.im.isfinite = true ∧
      w.re.isfinite = true ∧ w.im.isfinite = true ∧
      (w.re.iszero = false ∨ w.im.iszero = false) →
      (divideSmall k z w).re.isnan = false ∧ (divideSmall k z w).im.isnan = false) ∧
    (z.re.isfinite = true ∧ z.im.isfinite = true →
      let r := divideSmall k z ⟨Fl.ofInt 1, Fl.zero false⟩
      Fl.eq r.re z.re = true ∧ Fl.eq r.im z.im = true) ∧
    (z.re.isfinite = true ∧ z.im.isfinite = true ∧
      w.re.isnan = false ∧ w.im.isnan = false ∧
      (w.re.isinf = true ∨ w.im.isinf = true) →
      (divideSmall k z w).re.iszero = true ∧ (divideSmall k z w).im.iszero = true)

/-- Every finite nonzero small-float reciprocal has no NaN component, allowing
overflow to infinity. Any infinite component yields signed complex zero with
conjugate signs. Full Float16/Float32 domain. Source: base/complex.jl:476-481. -/
def SmallReciprocalSanity : Prop :=
  ∀ (k : SmallFloatKind) (z : Complex (SmallValue k)),
    (z.re.isfinite = true ∧ z.im.isfinite = true ∧
      (z.re.iszero = false ∨ z.im.iszero = false) →
      (inverseSmall k z).re.isnan = false ∧ (inverseSmall k z).im.isnan = false) ∧
    (z.re.isinf = true ∨ z.im.isinf = true →
      (inverseSmall k z).re.iszero = true ∧ (inverseSmall k z).im.iszero = true ∧
      (inverseSmall k z).re.signbit = z.re.signbit ∧
      (inverseSmall k z).im.signbit = !z.im.signbit)

/-- Euler phase at integer multiples of pi is exactly +1 or -1 by integer parity,
with the documented sinpi signed-zero convention. Large integers are included.
Documentation: base/complex.jl:598-618; base/special/trig.jl:1074-1078. -/
def IntegerCispi : Prop :=
  ∀ (t : IntTy) (x : JInt t),
    let z := cispiInt x
    F64.toBits z.re = (if x.val % 2 = 0 then 0x3ff0000000000000 else 0xbff0000000000000) ∧
    NumericalZero64 z.im ∧ F64.signbit z.im = decide (x.val < 0)

/-- Boolean powers select the base for exponent one and the multiplicative identity
for exponent zero. Floating false powers use a canonical positive imaginary zero.
Source: base/complex.jl:889-890; one contract at base/number.jl:368-406. -/
def BooleanPowers : Prop :=
  (∀ (z : ComplexF64) (b : Bool),
    let r := powerF64Bool z b
    (b = true → r = z) ∧
    (b = false → F64.toBits r.re = 0x3ff0000000000000 ∧ F64.toBits r.im = 0)) ∧
  (∀ (k : SmallFloatKind) (z : Complex (SmallValue k)) (b : Bool),
    let r := powerSmallBool k z b
    (b = true → r = z) ∧
    (b = false → r.re.isfinite = true ∧
      r.re.toRat.1 = (r.re.toRat.2 : Int) ∧ r.im.toBits = 0)) ∧
  (∀ (t : IntTy) (z : Complex (JInt t)) (b : Bool),
    ModularCoordinates ((1 - BoolInteger b) + BoolInteger b * z.re.val)
      (BoolInteger b * z.im.val) (pow_ComplexInteger_Bool z b)) ∧
  (∀ (z : Complex Bool) (b : Bool),
    BoolInteger (powerBoolComplex z b).re =
      (1 - BoolInteger b) + BoolInteger b * BoolInteger z.re ∧
    BoolInteger (powerBoolComplex z b).im = BoolInteger b * BoolInteger z.im)

/-- Exact distance from n/d to an integer candidate. -/
def IntegralDistance (n d k : Int) : Int := Int.natAbs (k*d - n)

/-- Nearest integer with a chosen independent tie relation. -/
def NearestIntegral (n d k : Int) : Prop :=
  ∀ j : Int, IntegralDistance n d k ≤ IntegralDistance n d j

/-- Independent directional/nearest rounding specification for a rational value. -/
def IntegralRoundingRule (mode : StandardRounding) (n d k : Int) : Prop :=
  let down := k*d ≤ n ∧ n < (k+1)*d
  let up := (k-1)*d < n ∧ n ≤ k*d
  match mode with
  | .primitive .RoundDown => down
  | .primitive .RoundUp => up
  | .primitive .RoundToZero => if n < 0 then up else down
  | .fromZero => if n < 0 then down else up
  | .primitive .RoundNearest => NearestIntegral n d k ∧
      ∀ j : Int, j ≠ k → IntegralDistance n d k = IntegralDistance n d j → k % 2 = 0
  | .primitive .RoundNearestTiesAway => NearestIntegral n d k ∧
      ∀ j : Int, IntegralDistance n d k = IntegralDistance n d j → j.natAbs ≤ k.natAbs
  | .nearestTiesUp => NearestIntegral n d k ∧
      ∀ j : Int, IntegralDistance n d k = IntegralDistance n d j → j ≤ k

/-- Every input class has an obligation: finite values round according to the
mode, infinities are preserved and NaNs stay NaN. The mathematical integer is
extracted independently from the represented result. -/
def IntegralFloatObservation (mode : StandardRounding) (x y : F64) : Prop :=
  (NaN64 x → NaN64 y) ∧ (Infinite64 x → y = x) ∧
  (F64.isfinite x = true →
    F64.isfinite y = true ∧ F64.signbit y = F64.signbit x ∧
    ∃ k : Int, (F64.toRat y).1 = k * ((F64.toRat y).2 : Int) ∧
      IntegralRoundingRule mode (F64.toRat x).1 ((F64.toRat x).2 : Int) k)

/-- The real and imaginary components independently obey their selected standard
rounding directions and tie rules. All Float64 inputs and all 49 standard mode
pairs are included, without a no-overflow or successful-call premise.
Documentation: base/complex.jl:1093-1126; base/rounding.jl:26-110. No keyword coverage claim. -/
def ComplexRoundingModes : Prop :=
  ∀ (z : ComplexF64) (rr ri : StandardRounding),
    IntegralFloatObservation rr z.re (roundComplexF64 z rr ri).re ∧
    IntegralFloatObservation ri z.im (roundComplexF64 z rr ri).im ∧
    IntegralFloatObservation (.primitive .RoundNearest) z.re (roundComplexF64 z).re ∧
    IntegralFloatObservation (.primitive .RoundNearest) z.im (roundComplexF64 z).im ∧
    IntegralFloatObservation rr z.re (roundComplexF64 z rr).re ∧
    IntegralFloatObservation rr z.im (roundComplexF64 z rr).im

/-- Complex values whose coordinates are already integral retain their values and types for all standard rounding directions, including either omitted-mode default. Full machine-integer and Bool domains; source base/complex.jl:1123-1126 and base/rounding.jl:497. -/
def IntegralComplexRounding : Prop :=
  (∀ (t : IntTy) (z : Complex (JInt t)) (rr ri : StandardRounding),
    roundComplexInt z rr ri = z ∧ roundComplexInt z rr = z ∧ roundComplexInt z = z) ∧
  (∀ (z : Complex Bool) (rr ri : StandardRounding),
    roundComplexBool z rr ri = z ∧ roundComplexBool z rr = z ∧ roundComplexBool z = z)

/-- The big type preserves integer versus floating component categories while selecting the corresponding arbitrary-precision type. The tags denote BigInt and BigFloat; no claim about value-level allocation or precision context is made. Source: base/complex.jl:1132; base/gmp.jl:489; base/mpfr.jl:561. -/
def PrimitiveBigComponentTypes : Prop :=
  (∀ t : IntTy, bigComplexIntegerType t = .complex .integer) ∧
  bigComplexBoolType = .complex .integer ∧
  bigComplexF64Type = .complex .floating ∧
  (∀ k : SmallFloatKind, bigComplexSmallType k = .complex .floating)

/-- float converts each integer coordinate to nearest-even Float64 and converts
Bool coordinates exactly. Complete Bool and machine-integer value domains.
Source: base/complex.jl:1130; base/float.jl:243-350,367. -/
def FloatingComplexConversion : Prop :=
  (∀ (t : IntTy) (z : Complex (JInt t)),
    NearestInteger64 z.re.val (floatComplexInt z).re ∧
    NearestInteger64 z.im.val (floatComplexInt z).im) ∧
  (∀ z : Complex Bool,
    F64.isfinite (floatComplexBool z).re = true ∧
    F64.isfinite (floatComplexBool z).im = true ∧
    (F64.toRat (floatComplexBool z).re).1 =
      BoolInteger z.re * ((F64.toRat (floatComplexBool z).re).2 : Int) ∧
    (F64.toRat (floatComplexBool z).im).1 =
      BoolInteger z.im * ((F64.toRat (floatComplexBool z).im).2 : Int) ∧
    F64.signbit (floatComplexBool z).re = false ∧
    F64.signbit (floatComplexBool z).im = false)

/-- IEEE spacing as an exact positive rational, derived from the stored exponent. -/
def Spacing64 (x : F64) : Int × Int :=
  let exponent : Nat := F64.toBits x / 2^52 % 2048
  let power : Int := if exponent = 0 then -1074 else (exponent : Int) - 1075
  if power ≥ 0 then ((2 ^ power.toNat : Nat), 1)
  else (1, (2 ^ (-power).toNat : Nat))

/-- Exact rational ordering for the positive-denominator specifications below. -/
