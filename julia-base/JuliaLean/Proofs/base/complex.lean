theorem correction_hsquare (p : Int) (d Q : Nat) (hp0 : -485 ≤ p) (hp1 : p ≤ 511)
    (hQ0 : 2^52 ≤ Q) (hQ1 : Q < 2^53) (cert : CorrectionCertificate d Q) :
    let h := pk false Q (p-52)
    F64.isfinite (F64.mul h h) = true ∧
      key64 (F64.mul h h) = (cert.R : Int)*((2^(cert.C+(2*p+970).toNat) : Nat) : Int) := by
  dsimp only
  have hh := pack_key false Q (p-52) hQ0 hQ1 (by omega) (by omega)
  simp only [SmallExact.signed, Bool.false_eq_true, ↓reduceIte] at hh
  rw [mul_key_round _ _ hh.1 hh.1, hh.2.1, hh.2.2, bne_self_eq_false]
  have hprod : ((Q*2^(p-52+1074).toNat : Nat) : Int)*((Q*2^(p-52+1074).toNat : Nat) : Int) =
      ((Q*Q : Nat) : Int)*((2^((p-52+1074).toNat+(p-52+1074).toNat) : Nat) : Int) := by
    simp only [Int.natCast_mul, Nat.pow_add, Int.natCast_mul]
    ac_rfl
  rw [hprod]
  have hQQ : 0 < Q*Q := Nat.mul_pos (by omega) (by omega)
  have hfloor : Fl.floorLog2Rat (((Q*Q : Nat) : Int)).natAbs 1 = (cert.C : Int)+52 := by
    rw [Int.natAbs_natCast]
    exact cert.squareLog
  have hr := normal_round_shift (((Q*Q : Nat) : Int)) 1
    ((p-52+1074).toNat+(p-52+1074).toNat) 2148 false (by omega) (by decide)
    (by rw [hfloor]; have hh := cert.cb; omega)
    (by rw [hfloor]; have hh := cert.cb; omega)
  simp only [Nat.one_mul] at hr
  rw [hr]
  have hnegative : decide (((Q*Q : Nat) : Int)<0) = false := by simp only [decide_eq_false_iff_not]; omega
  have he0 : (-((cert.C : Int)+52-52)).toNat = 0 := by omega
  have heC : ((cert.C : Int)+52-52).toNat = cert.C := by omega
  simp only [hnegative, Int.natAbs_natCast, cert.squareLog, he0, heC, Nat.pow_zero,
    Nat.mul_one, Nat.one_mul, cert.squareRound]
  change F64.isfinite (pk false cert.R ((cert.C : Int)+52+
      ((p-52+1074).toNat+(p-52+1074).toNat : Nat)-2148-52)) = true ∧
    key64 (pk false cert.R ((cert.C : Int)+52+
      ((p-52+1074).toNat+(p-52+1074).toNat : Nat)-2148-52)) = _
  let k : Int := (cert.C : Int)+52+
    ((p-52+1074).toNat+(p-52+1074).toNat : Nat)-2148-52
  have hk : k = 2*p+(cert.C : Int)-104 := by dsimp only [k]; omega
  have hpkey := pack_key false cert.R k cert.rb.1 cert.rb.2
    (by rw [hk]; have hcb := cert.cb; omega) (by rw [hk]; have hcb := cert.cb; omega)
  change F64.isfinite (pk false cert.R k) = true ∧ key64 (pk false cert.R k) = _
  refine ⟨hpkey.1, ?_⟩
  rw [hpkey.2.1]
  simp only [SmallExact.signed, Bool.false_eq_true, ↓reduceIte, Int.natCast_mul]
  have he : (k+1074).toNat = cert.C+(2*p+970).toNat := by rw [hk]; omega
  rw [he]

theorem correction_asquare (p : Int) (hp0 : -485 ≤ p) (hp1 : p ≤ 511) :
    F64.isfinite (F64.mul (power p) (power p)) = true ∧
      key64 (F64.mul (power p) (power p)) = ((2^(2*p+1074).toNat : Nat) : Int) := by
  rw [power_mul p p (by omega) (by omega) (by omega) (by omega) (by omega) (by omega)]
  have he : p+p = 2*p := by omega
  rw [he]
  exact ⟨(power_classes (2*p) (by omega) (by omega)).1,
    power_key (2*p) (by omega) (by omega)⟩

theorem correction_square_difference (p : Int) (d Q : Nat) (hp0 : -485 ≤ p) (hp1 : p ≤ 511)
    (hQ0 : 2^52 ≤ Q) (hQ1 : Q < 2^53) (cert : CorrectionCertificate d Q) :
    let h := pk false Q (p-52)
    let hh := F64.mul h h
    let aa := F64.mul (power p) (power p)
    F64.isfinite (F64.sub hh aa) = true ∧
      key64 (F64.sub hh aa) = (cert.A : Int)*((2^(2*p+1022).toNat : Nat) : Int) := by
  dsimp only
  have hh := correction_hsquare p d Q hp0 hp1 hQ0 hQ1 cert
  have ha := correction_asquare p hp0 hp1
  rw [sub_key_round _ _ hh.1 ha.1, hh.2, ha.2]
  have he1 : (2*p+1074).toNat = 104+(2*p+970).toNat := by omega
  have he2 : (2*p+1022).toNat = 52+(2*p+970).toNat := by omega
  have hdiff : (cert.R : Int)*((2^(cert.C+(2*p+970).toNat) : Nat) : Int)-
      ((2^(2*p+1074).toNat : Nat) : Int) =
      (cert.A : Int)*((2^(2*p+1022).toNat : Nat) : Int) := by
    rw [he1, he2, Nat.pow_add, Nat.pow_add, Nat.pow_add,
      Int.natCast_mul, Int.natCast_mul, Int.natCast_mul, ← Int.mul_assoc,
      ← Int.natCast_mul, cert.aeq, Int.add_mul]
    simp only [Int.mul_assoc]
    omega
  rw [hdiff]
  have hlog : cert.A.log2 ≤ 52 := by
    by_cases hz : cert.A = 0
    · simp only [hz, Nat.log2_zero]; omega
    · have hh := (Nat.log2_lt hz).mpr cert.ab
      omega
  exact round_exact_key (cert.A : Int) (2*p+1022).toNat _
    (by rw [Int.natAbs_natCast]; exact cert.ab)
    (by rw [Int.natAbs_natCast]; omega)

end JuliaLean.ChatGPT.Batch10.Group1.EpsilonExact

