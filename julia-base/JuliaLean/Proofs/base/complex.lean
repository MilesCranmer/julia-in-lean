/-- Mathematical multiplication of exact rational specifications, not a Julia callee. -/
def exactProduct (a b : Int × Nat) : Int × Nat :=
  (a.1 * b.1, a.2 * b.2)

/-- Mathematical addition of exact rational specifications, not a Julia callee. -/
def exactSum (a b : Int × Nat) : Int × Nat :=
  (a.1 * (b.2 : Int) + b.1 * (a.2 : Int), a.2 * b.2)

/-- Mathematical subtraction of exact rational specifications, not a Julia callee. -/
def exactDifference (a b : Int × Nat) : Int × Nat :=
  (a.1 * (b.2 : Int) - b.1 * (a.2 : Int), a.2 * b.2)

/-- An exact rational has a finite binary64 representation. The representation
decoder is specification-only; no assumed law about a Julia operation occurs here. -/
def Binary64Representable (q : Int × Nat) : Prop :=
  0 < q.2 ∧ ∃ v : JuliaLean.base.float.FV .f64,
    JuliaLean.Promotion.Fl.isfinite v = true ∧
    (JuliaLean.Promotion.Fl.toRat v).1 * (q.2 : Int) =
      q.1 * ((JuliaLean.Promotion.Fl.toRat v).2 : Int)

end JuliaLean.Proofs.base.complex

