/-!
Independent observations of the early generic methods.  The observer runs each
arbitrary dispatch callee once, records its actual arguments, result and state
transition, and then lets the method continue.  The propositions recognize
allowed finite call traces and test their returned observations.  They do not
assume a scalar correctness law or execute an expected copy of the method.
The trace is specification data, not a represented Julia array.

These declarations are unproved and, in this packet environment, unchecked.
-/

abbrev EarlyState (E S A : Type) := ExceptT (Error E) (StateM S) A
abbrev EarlyTrace (E S Event A : Type) := EarlyState E (S × List Event) A

structure EarlyCall (E S Input Output : Type) where
  input : Input
  outcome : Except (Error E) Output
  before : S
  after : S

/-- Observe a selected call without changing its state/error semantics. -/
def earlyObserve {E S Input Output Event : Type}
    (input : Input) (embed : EarlyCall E S Input Output → Event)
    (action : EarlyState E S Output) : EarlyTrace E S Event Output :=
  fun state =>
    let (outcome, after) := action.run state.1
    let call : EarlyCall E S Input Output :=
      { input := input, outcome := outcome, before := state.1, after := after }
    (outcome, (after, state.2 ++ [embed call]))

def earlyRun {E S A : Type} (action : EarlyState E S A) (state : S) :
    Except (Error E) A × S := action.run state

/-- A forwarding wrapper makes precisely one call with the original argument,
and returns its actual outcome and post-call state unchanged. -/
def EarlyOneCallSpec {E S Input Output : Type} (input : Input) (initial : S)
    (observed : Except (Error E) Output × (S × List (EarlyCall E S Input Output))) : Prop :=
  match observed.2.2 with
  | [call] => call.input = input ∧ call.before = initial ∧
      observed.1 = call.outcome ∧ observed.2.1 = call.after
  | _ => False

/-- A two-call dataflow invariant.  The second argument is computed from the
actual recorded first result.  Error traces end at the throwing call; normal
traces satisfy a separate observation relation on the returned value. -/
def EarlyTwoCallsSpec {E S I J A B C : Type} (firstInput : I)
    (secondInput : A → J) (returned : A → B → C → Prop) (initial : S)
    (observed : Except (Error E) C ×
      (S × List (Sum (EarlyCall E S I A) (EarlyCall E S J B)))) : Prop :=
  match observed.2.2 with
  | [.inl first] =>
      first.input = firstInput ∧ first.before = initial ∧
      observed.2.1 = first.after ∧
      match first.outcome with
      | .error error => observed.1 = .error error
      | .ok _ => False
  | [.inl first, .inr second] =>
      first.input = firstInput ∧ first.before = initial ∧
      second.before = first.after ∧ observed.2.1 = second.after ∧
      match first.outcome with
      | .error _ => False
      | .ok a => second.input = secondInput a ∧
          match second.outcome, observed.1 with
          | .error expected, .error actual => actual = expected
          | .ok b, .ok c => returned a b c
          | _, _ => False
  | _ => False

/-- Constructor evaluation preserves zero-before-construction, the original
real input, and the actual zero result, including arbitrary state and errors.
Documentation/invariant: base/complex.jl:18; manual/constructors.md. -/
def ConstructorRealEffects : Prop :=
  ∀ (E S A Zero Result : Type)
    (ops : RealConstructorOps (EarlyState E S) A Zero Result) (x : A) (s : S),
    let traced : RealConstructorOps
        (EarlyTrace E S (Sum (EarlyCall E S A Zero)
          (EarlyCall E S (A × Zero) Result))) A Zero Result :=
      { zero := fun a => earlyObserve a Sum.inl (ops.zero a)
        construct := fun a z => earlyObserve (a, z) Sum.inr (ops.construct a z) }
    EarlyTwoCallsSpec x (fun zero => (x, zero)) (fun _ output actual => actual = output) s
      (earlyRun (complexReal traced x) (s, []))

/-- Typed real construction forwards the real input and a native Int zero,
with exactly one selected constructor call and no extra conversion or effects.
Documentation/invariant: base/complex.jl:42. -/
def ConstructorTypedRealEffects : Prop :=
  ∀ (E S A Result : Type)
    (ops : TypedRealConstructorOps (EarlyState E S) A Result) (x : A) (s : S),
    let traced : TypedRealConstructorOps
        (EarlyTrace E S (EarlyCall E S (A × JInt .i64) Result)) A Result :=
      { construct := fun a zero => earlyObserve (a, zero) id (ops.construct a zero) }
    let observed := earlyRun (complexTypedReal traced x) (s, [])
    EarlyOneCallSpec (x, JInt.lit .i64 0) s observed ∧
      (∀ call ∈ observed.2.2, call.input.2.val = 0)

/-- Typed complex construction passes each stored coordinate in its original
position and preserves the selected constructor's complete outcome.
Documentation/invariant: base/complex.jl:43; complex-number field documentation. -/
def ConstructorTypedComplexEffects : Prop :=
  ∀ (E S A Result : Type)
    (ops : TypedComplexConstructorOps (EarlyState E S) A Result)
    (z : Complex A) (s : S),
    let traced : TypedComplexConstructorOps
        (EarlyTrace E S (EarlyCall E S (A × A) Result)) A Result :=
      { construct := fun a b => earlyObserve (a, b) id (ops.construct a b) }
    EarlyOneCallSpec (z.re, z.im) s (earlyRun (complexTypedComplex traced z) (s, []))

abbrev EarlyRealConversionEvent (E S A T NotBool NotT : Type) :=
  Sum (EarlyCall E S (Sum A (Complex A)) (Checked Bool NotBool))
    (EarlyCall E S A (Checked T NotT))

/-- Expected first argument to the selected isreal branch.  The inherited
method uses the imaginary field; a more-specific selection receives z. -/
def earlyRealCheckInput {m : Type → Type} {A R : Type}
    (dispatch : IsRealDispatch m A R) (z : Complex A) : Sum A (Complex A) :=
  match dispatch with
  | .inherited _ => .inl z.im
  | .selectedCustom _ => .inr z

/-- Record the actual selected predicate and constructor, without assuming
that either returns a value of the expected runtime type. -/
def earlyTraceRealConversion {E S A T NotBool NotT : Type}
    (ops : RealConversionOps (EarlyState E S) A T NotBool NotT) :
    RealConversionOps (EarlyTrace E S (EarlyRealConversionEvent E S A T NotBool NotT))
      A T NotBool NotT where
  isreal := match ops.isreal with
    | .inherited iszero => .inherited (fun a =>
        earlyObserve (.inl a : Sum A (Complex A)) Sum.inl (iszero a))
    | .selectedCustom call => .selectedCustom (fun z =>
        earlyObserve (.inr z : Sum A (Complex A)) Sum.inl (call z))
  construct := fun a => earlyObserve a Sum.inr (ops.construct a)
  typeName := ops.typeName

/-- Outcome of the explicit result type assertion, independently inspecting
the returned runtime partition and its error class. -/
def EarlyCheckedResult {E T Other : Type} (context : String)
    (returned : Except (Error E) (Checked T Other)) (actual : Except (Error E) T) : Prop :=
  match returned with
  | .error error => actual = .error error
  | .ok (.accepted value) => actual = .ok value
  | .ok (.rejected _) => actual = .error (.typeError context)

def EarlyRealConversionSpec {E S A T NotBool NotT : Type}
    (firstInput : Sum A (Complex A)) (realInput : A) (typeName : String) (initial : S)
    (observed : Except (Error E) T ×
      (S × List (EarlyRealConversionEvent E S A T NotBool NotT))) : Prop :=
  match observed.2.2 with
  | [.inl first] =>
      first.input = firstInput ∧ first.before = initial ∧ observed.2.1 = first.after ∧
      match first.outcome with
      | .error error => observed.1 = .error error
      | .ok (.rejected _) => observed.1 = .error (.typeError "if")
      | .ok (.accepted false) => observed.1 = .error (.jl (.inexactError typeName))
      | .ok (.accepted true) => False
  | [.inl first, .inr second] =>
      first.input = firstInput ∧ first.before = initial ∧
      first.outcome = .ok (.accepted true) ∧
      second.input = realInput ∧ second.before = first.after ∧
      observed.2.1 = second.after ∧
      EarlyCheckedResult "T(real(z))::T" second.outcome observed.1
  | _ => False

/-- Conversion only reaches the real constructor after an accepted true
condition.  False yields InexactError; malformed conditions and wrong-type
constructor returns yield TypeError at their respective source checks.
Documentation/invariant: base/complex.jl:44-45,126-149. -/
def ComplexRealConversionEffects : Prop :=
  ∀ (E S A T NotBool NotT : Type)
    (ops : RealConversionOps (EarlyState E S) A T NotBool NotT)
    (z : Complex A) (s : S),
    EarlyRealConversionSpec (earlyRealCheckInput ops.isreal z) z.re ops.typeName s
      (earlyRun (realFromComplex (E := E) (earlyTraceRealConversion ops) z) (s, []))

/-- A type transform calls its scalar operation once, then either constructs
the Complex type from the returned admissible parameter or rejects the actual
inadmissible result.  A dispatch error is preserved unchanged. -/
def EarlyTypeTransformSpec {E S Input Parameter Rejected : Type}
    (input : Input) (initial : S)
    (observed : Except (Error E) (ComplexTy Parameter) ×
      (S × List (EarlyCall E S Input (TypeParameter Parameter Rejected)))) : Prop :=
  match observed.2.2 with
  | [call] => call.input = input ∧ call.before = initial ∧ observed.2.1 = call.after ∧
      match call.outcome with
      | .error error => observed.1 = .error error
      | .ok (.admissible parameter) =>
          ∃ result, observed.1 = .ok result ∧
            (match result with | .complex stored => stored = parameter | _ => False)
      | .ok (.rejected _) => observed.1 = .error (.typeError "Complex type parameter")
  | _ => False

/-- A Real imaginary-part query calls zero exactly once with the original
value and preserves its type-changing return, error and state.
Documentation/invariant: base/complex.jl:89. -/
def ImaginaryRealEffects : Prop :=
  ∀ (E S A Result : Type)
    (ops : ImaginaryRealOps (EarlyState E S) A Result) (x : A) (s : S),
    let traced : ImaginaryRealOps (EarlyTrace E S (EarlyCall E S A Result)) A Result :=
      { zero := fun a => earlyObserve a id (ops.zero a) }
    EarlyOneCallSpec x s (earlyRun (imaginaryReal traced x) (s, []))

/-- Real and imaginary queries each receive the original unrestricted input,
in that order.  Successful tuple coordinates retain their respective actual
results; a failing first query suppresses the second.
Documentation/invariant: base/complex.jl:91-102. -/
def RealImaginaryEffects : Prop :=
  ∀ (E S A R I : Type) (ops : ReimOps (EarlyState E S) A R I) (x : A) (s : S),
    let traced : ReimOps
        (EarlyTrace E S (Sum (EarlyCall E S A R) (EarlyCall E S A I))) A R I :=
      { real := fun a => earlyObserve a Sum.inl (ops.real a)
        imag := fun a => earlyObserve a Sum.inr (ops.imag a) }
    EarlyTwoCallsSpec x (fun _ => x) (fun r i pair => pair.1 = r ∧ pair.2 = i) s
      (earlyRun (realImaginary traced x) (s, []))

/-- Type reflection applies real to the actual zero result, then returns the
runtime type tag of the actual real result.  Errors/state survive both calls.
Documentation/invariant: base/complex.jl:104-120. -/
def RealTypeQueryEffects : Prop :=
  ∀ (E S Tag : Type) (Value : Tag → Type)
    (ops : RealTypeQueryOps (EarlyState E S) Tag Value) (t : Tag) (s : S),
    let traced : RealTypeQueryOps
        (EarlyTrace E S (Sum (EarlyCall E S Tag (Sigma Value))
          (EarlyCall E S (Sigma Value) (Sigma Value)))) Tag Value :=
      { zero := fun a => earlyObserve a Sum.inl (ops.zero a)
        real := fun a => earlyObserve a Sum.inr (ops.real a) }
    EarlyTwoCallsSpec t id (fun _ returned actual => actual = returned.1) s
      (earlyRun (realTypeQuery traced t) (s, []))

inductive EarlyPredicateKind where
  | isrealCustom | isinteger | isfinite | isnan | isinf | iszero | isone
  | andOther | orOther

inductive EarlyPredicateArgument (A Other : Type) where
  | scalar (value : A)
  | complex (value : Complex A)
  | predicate (value : PredicateValue Other)

structure EarlyPredicateInput (A Other : Type) where
  kind : EarlyPredicateKind
  arguments : List (EarlyPredicateArgument A Other)

abbrev EarlyPredicateCall (E S A Other : Type) :=
  EarlyCall E S (EarlyPredicateInput A Other) (PredicateValue Other)

def earlyPredicateScalarInput {A Other : Type} (kind : EarlyPredicateKind) (a : A) :
    EarlyPredicateInput A Other := ⟨kind, [.scalar a]⟩

def earlyPredicateCombinationInput {A Other : Type} (disjunction : Bool)
    (a b : PredicateValue Other) : EarlyPredicateInput A Other :=
  ⟨if disjunction then .orOther else .andOther, [.predicate a, .predicate b]⟩

/-- Record every scalar and nonnative Boolean-combination call. -/
def earlyTracePredicates {E S A Other : Type}
    (ops : PredicateOps (EarlyState E S) A Other) :
    PredicateOps (EarlyTrace E S (EarlyPredicateCall E S A Other)) A Other where
  isreal := match ops.isreal with
    | .inherited iszero => .inherited (fun a =>
        earlyObserve (earlyPredicateScalarInput .iszero a) id (iszero a))
    | .selectedCustom call => .selectedCustom (fun z =>
        earlyObserve (⟨.isrealCustom, [.complex z]⟩ : EarlyPredicateInput A Other) id (call z))
  isinteger := fun a => earlyObserve (earlyPredicateScalarInput .isinteger a) id (ops.isinteger a)
  isfinite := fun a => earlyObserve (earlyPredicateScalarInput .isfinite a) id (ops.isfinite a)
  isnan := fun a => earlyObserve (earlyPredicateScalarInput .isnan a) id (ops.isnan a)
  isinf := fun a => earlyObserve (earlyPredicateScalarInput .isinf a) id (ops.isinf a)
  iszero := fun a => earlyObserve (earlyPredicateScalarInput .iszero a) id (ops.iszero a)
  isone := fun a => earlyObserve (earlyPredicateScalarInput .isone a) id (ops.isone a)
  andOther := fun a b => earlyObserve (earlyPredicateCombinationInput false a b) id (ops.andOther a b)
  orOther := fun a b => earlyObserve (earlyPredicateCombinationInput true a b) id (ops.orOther a b)

/-- Independent Boolean truth relation, rather than the implementation's
Bool.and/Bool.or expression. -/
def EarlyBooleanResult (disjunction a b actual : Bool) : Prop :=
  if disjunction then (actual = true ↔ a = true ∨ b = true)
  else (actual = true ↔ a = true ∧ b = true)

/-- Both predicates are evaluated eagerly before combination, unless an
exception interrupts evaluation.  Bool/Bool uses the logical truth relation
and no selected combination call.  Other results reach exactly one selected
combination with both actual predicate results, preserving its effects. -/
def EarlyPredicateSpec {E S A Other : Type} (disjunction : Bool)
    (firstInput secondInput : EarlyPredicateInput A Other) (initial : S)
    (observed : Except (Error E) (PredicateValue Other) ×
      (S × List (EarlyPredicateCall E S A Other))) : Prop :=
  match observed.2.2 with
  | [first] =>
      first.input = firstInput ∧ first.before = initial ∧ observed.2.1 = first.after ∧
      match first.outcome with
      | .error error => observed.1 = .error error
      | .ok _ => False
  | [first, second] =>
      first.input = firstInput ∧ first.before = initial ∧
      second.input = secondInput ∧ second.before = first.after ∧
      observed.2.1 = second.after ∧
      match first.outcome, second.outcome with
      | .ok _, .error error => observed.1 = .error error
      | .ok (.boolean a), .ok (.boolean b) =>
          ∃ actual, observed.1 = .ok (.boolean actual) ∧
            EarlyBooleanResult disjunction a b actual
      | _, _ => False
  | [first, second, combine] =>
      first.input = firstInput ∧ first.before = initial ∧
      second.input = secondInput ∧ second.before = first.after ∧
      combine.before = second.after ∧ observed.2.1 = combine.after ∧
      match first.outcome, second.outcome with
      | .ok a, .ok b =>
          (¬ ∃ x y : Bool, a = .boolean x ∧ b = .boolean y) ∧
          combine.input = earlyPredicateCombinationInput disjunction a b ∧
          observed.1 = combine.outcome
      | _, _ => False
  | _ => False

def earlyIntegerFirstInput {E S A Other : Type}
    (ops : PredicateOps (EarlyState E S) A Other) (z : Complex A) :
    EarlyPredicateInput A Other :=
  match ops.isreal with
  | .inherited _ => earlyPredicateScalarInput .iszero z.im
  | .selectedCustom _ => ⟨.isrealCustom, [.complex z]⟩

/-- Integer classification tests realness first and the real component's
integrality second, including a false first result and a later exception.
Documentation/invariant: base/complex.jl:150. -/
def IntegerComplexEffects : Prop :=
  ∀ (E S A Other : Type) (ops : PredicateOps (EarlyState E S) A Other)
    (z : Complex A) (s : S),
    EarlyPredicateSpec false (earlyIntegerFirstInput ops z)
      (earlyPredicateScalarInput .isinteger z.re) s
      (earlyRun (integerComplex (earlyTracePredicates ops) z) (s, []))

/-- Finiteness observes both stored components in order before eager &.
Documentation/invariant: base/complex.jl:151. -/
def FiniteComplexEffects : Prop :=
  ∀ (E S A Other : Type) (ops : PredicateOps (EarlyState E S) A Other)
    (z : Complex A) (s : S),
    EarlyPredicateSpec false (earlyPredicateScalarInput .isfinite z.re)
      (earlyPredicateScalarInput .isfinite z.im) s
      (earlyRun (finiteComplex (earlyTracePredicates ops) z) (s, []))

/-- NaN classification cannot suppress the imaginary call after a true real
predicate; eager | uses native Boolean logic or the selected other dispatch.
Documentation/invariant: base/complex.jl:152. -/
def NaNComplexEffects : Prop :=
  ∀ (E S A Other : Type) (ops : PredicateOps (EarlyState E S) A Other)
    (z : Complex A) (s : S),
    EarlyPredicateSpec true (earlyPredicateScalarInput .isnan z.re)
      (earlyPredicateScalarInput .isnan z.im) s
      (earlyRun (nanComplex (earlyTracePredicates ops) z) (s, []))

/-- Infinity classification retains both scalar calls, their order, and all
exceptions, including an exception following a true first result.
Documentation/invariant: base/complex.jl:153. -/
def InfiniteComplexEffects : Prop :=
  ∀ (E S A Other : Type) (ops : PredicateOps (EarlyState E S) A Other)
    (z : Complex A) (s : S),
    EarlyPredicateSpec true (earlyPredicateScalarInput .isinf z.re)
      (earlyPredicateScalarInput .isinf z.im) s
      (earlyRun (infiniteComplex (earlyTracePredicates ops) z) (s, []))

/-- Complex zero classification tests real then imaginary even when the real
coordinate's result is false, before native or custom & dispatch.
Documentation/invariant: base/complex.jl:154. -/
def ZeroComplexEffects : Prop :=
  ∀ (E S A Other : Type) (ops : PredicateOps (EarlyState E S) A Other)
    (z : Complex A) (s : S),
    EarlyPredicateSpec false (earlyPredicateScalarInput .iszero z.re)
      (earlyPredicateScalarInput .iszero z.im) s
      (earlyRun (zeroComplex (earlyTracePredicates ops) z) (s, []))

/-- Complex one classification uses isone on real and iszero on imaginary,
without short-circuiting either selected computation.
Documentation/invariant: base/complex.jl:155. -/
def OneComplexEffects : Prop :=
  ∀ (E S A Other : Type) (ops : PredicateOps (EarlyState E S) A Other)
    (z : Complex A) (s : S),
    EarlyPredicateSpec false (earlyPredicateScalarInput .isone z.re)
      (earlyPredicateScalarInput .iszero z.im) s
      (earlyRun (oneComplex (earlyTracePredicates ops) z) (s, []))


/-- Independent representability, using mathematical bounds only in the
specification. -/
def EarlyIntegerFits (t : IntTy) (value : Int) : Prop :=
  t.min ≤ value ∧ value ≤ t.max

/-- Successful native construction retains the exact requested coordinates;
an InexactError occurs precisely on an unrepresentable coordinate request. -/
def EarlyIntegerPairObservation (t : IntTy) (real imaginary : Int)
    (result : Jl (Complex (JInt t))) : Prop :=
  match result with
  | .ok z => z.re.val = real ∧ z.im.val = imaginary
  | .error (.inexactError _) =>
      ¬ (EarlyIntegerFits t real ∧ EarlyIntegerFits t imaginary)
  | .error _ => False

/-- The installed native converters, with their exception classes retained. -/
def earlyLiftJl {A : Type} (value : Jl A) : Except (Error Unit) A :=
  match value with
  | .ok x => .ok x
  | .error e => .error (.jl e)

/-- A known machine-integer two-field constructor uses installed conversions;
there are no user-supplied semantic laws in this concrete instance. -/
def earlyTypedIntegerOps (t s : IntTy) :
    TypedComplexConstructorOps Jl (JInt s) (Complex (JInt t)) where
  construct := constructTypedComplex
    (fun a => JInt.convert t.name t a.val)
    (fun b => JInt.convert t.name t b.val)

/-- Native integer constructor observations cover every width and value,
including all failed checked conversions.  The expected coordinates and
representability conditions are mathematical, not a copy of promotion code.
Documentation: base/complex.jl:3-18,42-45;
manual/conversion-and-promotion.md:201-243. -/
def NativeIntegerConstructorFields : Prop :=
  (∀ (t : IntTy) (x : JInt t),
    let ops : RealConstructorOps Jl (JInt t) (JInt t)
        (Complex (JInt (IntTy.promote t t))) :=
      { zero := fun a => .ok (zero_JInt a)
        construct := JuliaLean.base.complex.Models1Group19.complexIntPair }
    EarlyIntegerPairObservation (IntTy.promote t t) x.val 0 (complexReal ops x)) ∧
  (∀ (t s : IntTy) (x : JInt s),
    let ops : TypedRealConstructorOps Jl (JInt s) (Complex (JInt t)) :=
      { construct := constructTypedComplex
          (fun a => JInt.convert t.name t a.val)
          (fun b => JInt.convert t.name t b.val) }
    EarlyIntegerPairObservation t x.val 0 (complexTypedReal ops x)) ∧
  (∀ (t s : IntTy) (z : Complex (JInt s)),
    EarlyIntegerPairObservation t z.re.val z.im.val
      (complexTypedComplex (earlyTypedIntegerOps t s) z)) ∧
  (∀ (t s : IntTy) (z : Complex (JInt s)),
    let ops : RealConversionOps (Except (Error Unit)) (JInt s) (JInt t) Unit Unit :=
      { isreal := .inherited (fun a => .ok (.accepted (iszero_JInt a)))
        construct := fun a => (earlyLiftJl (JInt.convert t.name t a.val)).map Checked.accepted
        typeName := t.name }
    match realFromComplex (E := Unit) ops z with
    | .ok value => z.im.val = 0 ∧ value.val = z.re.val
    | .error (.jl (.inexactError _)) =>
        ¬ (z.im.val = 0 ∧ EarlyIntegerFits t z.re.val)
    | .error _ => False)

/-- Concrete scalar zero and part operations used by the public methods. -/
def earlyIntegerPredicateOps (t : IntTy) :
    PredicateOps (Except (Error Unit)) (JInt t) Unit where
  isreal := .inherited (fun a => .ok (.boolean (iszero_JInt a)))
  isinteger := fun a => .ok (.boolean (isinteger_JInt a))
  isfinite := fun a => .ok (.boolean (isfinite_JInt a))
  isnan := fun a => .ok (.boolean (isnan_JInt a))
  isinf := fun a => .ok (.boolean (isinf_JInt a))
  iszero := fun a => .ok (.boolean (iszero_JInt a))
  isone := fun a => .ok (.boolean (isone_JInt a))
  andOther := fun _ _ => .error (.user ())
  orOther := fun _ _ => .error (.user ())

/-- Gaussian integer classification on every machine-integer width/value.
The unreachable nonnative-combination branches above throw, so success also
checks that fixed Bool/Bool combination never calls those branches.
Documentation/invariant: base/complex.jl:126-155. -/
def NativeIntegerClassification : Prop :=
  ∀ (t : IntTy) (z : Complex (JInt t)),
    let ops := earlyIntegerPredicateOps t
    (∃ b : Bool, integerComplex ops z = .ok (.boolean b) ∧
      (b = true ↔ z.im.val = 0)) ∧
    finiteComplex ops z = .ok (.boolean true) ∧
    nanComplex ops z = .ok (.boolean false) ∧
    infiniteComplex ops z = .ok (.boolean false) ∧
    (∃ b : Bool, zeroComplex ops z = .ok (.boolean b) ∧
      (b = true ↔ z.re.val = 0 ∧ z.im.val = 0)) ∧
    (∃ b : Bool, oneComplex ops z = .ok (.boolean b) ∧
      (b = true ↔ z.re.val = 1 ∧ z.im.val = 0))

/-- Native real values have zero imaginary coordinate.  Real/imaginary
queries retain the exact real value, including every Float64 signed-zero and
NaN bit pattern, and the Float64 imaginary zero is positive.
Documentation: base/complex.jl:59-102; manual/complex-and-rational-numbers.md. -/
def NativeRealParts : Prop :=
  (∀ (t : IntTy) (x : JInt t),
    let zeroOps : ImaginaryRealOps Jl (JInt t) (JInt t) :=
      { zero := fun a => .ok (zero_JInt a) }
    let partsOps : ReimOps Jl (JInt t) (JInt t) (JInt t) :=
      { real := fun a => .ok (real_Real a)
        imag := fun a => .ok (imag_Real zero_JInt a) }
    (match imaginaryReal zeroOps x with
     | .ok value => value.val = 0
     | .error _ => False) ∧
    (match realImaginary partsOps x with
     | .ok pair => pair.1 = x ∧ pair.2.val = 0
     | .error _ => False)) ∧
  (∀ x : F64,
    let zeroOps : ImaginaryRealOps Jl F64 F64 :=
      { zero := fun a => .ok (zero_F64 a) }
    let partsOps : ReimOps Jl F64 F64 F64 :=
      { real := fun a => .ok (real_Real a)
        imag := fun a => .ok (imag_Real zero_F64 a) }
    imaginaryReal zeroOps x = .ok (F64.zero false) ∧
    (match realImaginary partsOps x with
     | .ok pair => pair.1 = x ∧ F64.toBits pair.2 = 0
     | .error _ => False))

end JuliaLean.Proofs.base.complex.Models2Group9


namespace JuliaLean.Proofs.base.complex.Models2Group9

open JuliaLean JuliaLean.Float JuliaLean.base.complex
open JuliaLean.base.complex.Models2Group9

/-!
Independent observations for finite source-method bodies.  These definitions
do not assert equations between a method and a second transcription of its
body.  They observe call histories, termination, mutation and exceptions of
arbitrary selected callees, and give separate arithmetic specifications for
closed Base instances.  `none` is divergence, never a successful default.
-/

/-- Observation computations retain state after failure and allow divergence.
The structure wrapper keeps this observer's instances distinct from other
world-passing computation aliases in the repository. -/
structure MiddleM (E State A : Type) where
  run : State → Option (Except (E × State) (A × State))

scoped instance {E State : Type} : Monad (MiddleM E State) where
  pure value := ⟨fun state => some (.ok (value, state))⟩
  bind action next := ⟨fun state =>
    match action.run state with
    | none => none
    | some (.error error) => some (.error error)
    | some (.ok (value, state)) => (next value).run state⟩

scoped instance {E State : Type} : MonadExceptOf E (MiddleM E State) where
  throw error := ⟨fun state => some (.error (error, state))⟩
  tryCatch action handler := ⟨fun state =>
    match action.run state with
    | none => none
    | some (.error (error, state)) => (handler error).run state
    | some (.ok result) => some (.ok result)⟩

/-- An external call receipt records the label, the precise failure if any,
and the actual post-call state.  It does not assume anything about the callee. -/
structure MiddleCall (E State : Type) where
  label : String
  failure : Option E
  after : State
  detail : String

abbrev MiddleWorld (E State : Type) := State × List (MiddleCall E State)

/-- Instrument one selected call without changing its result, mutation or
exception.  A divergent call still diverges. -/
def MiddleObserveInfo {E State A : Type} (label : String) (classify : A → String)
    (action : MiddleM E State A) :
    MiddleM E (MiddleWorld E State) A := ⟨fun (state, history) =>
  match action.run state with
  | none => none
  | some (.error (error, next)) =>
      some (.error (error, (next, history ++ [⟨label, some error, next, ""⟩])))
  | some (.ok (value, next)) =>
      some (.ok (value, (next, history ++ [⟨label, none, next, classify value⟩])))⟩

def MiddleObserve {E State A : Type} (label : String) (action : MiddleM E State A) :
    MiddleM E (MiddleWorld E State) A := MiddleObserveInfo label (fun _ => "") action

def MiddleLabels {E State : Type} (history : List (MiddleCall E State)) : List String :=
  history.map (fun call => call.label)

def MiddleLastState {E State : Type} (initial final : State)
    (history : List (MiddleCall E State)) : Prop :=
  match history.getLast? with
  | none => final = initial
  | some call => final = call.after

def MiddlePrefix (allowed : List String → Prop) (labels : List String) : Prop :=
  ∃ suffix : List String, allowed (labels ++ suffix)

/-- Every normal return has a complete permitted call history and only
successful receipts.  A callee error is terminal and is returned unchanged,
including its post-call state.  Explicit native errors have separately listed
throw sites; they also preserve the state after the preceding call. -/
def MiddleAudit {E State A : Type}
    (allowed : List String → Prop)
    (localError : E → List String → Prop)
    (initial : State)
    (observation : Option (Except (E × MiddleWorld E State) (A × MiddleWorld E State))) : Prop :=
  match observation with
  | none => True
  | some (.ok (_, (final, history))) =>
      allowed (MiddleLabels history) ∧
      (∀ call ∈ history, call.failure = none) ∧
      MiddleLastState initial final history
  | some (.error (error, (final, history))) =>
      MiddlePrefix allowed (MiddleLabels history) ∧
      ((∃ (earlier : List (MiddleCall E State)) (last : MiddleCall E State),
          history = earlier ++ [last] ∧
          (∀ call ∈ earlier, call.failure = none) ∧
          last.failure = some error ∧ final = last.after) ∨
       ((∀ call ∈ history, call.failure = none) ∧
          localError error (MiddleLabels history) ∧
          MiddleLastState initial final history))

def MiddleNoLocalError {E : Type} (_ : E) (_ : List String) : Prop := False

def MiddleOnePath (path : List String) (labels : List String) : Prop := labels = path

def MiddlePredicateInfo {Other : Type} : PredicateValue Other → String
  | .boolean true => "true"
  | .boolean false => "false"
  | .other _ => "other"

def MiddleCheckedInfo {Other : Type} : Checked Bool Other → String
  | .accepted true => "true"
  | .accepted false => "false"
  | .rejected _ => "rejected"

def MiddleDetails {E State : Type} (label : String) (history : List (MiddleCall E State)) : List String :=
  (history.filter (fun call => call.label == label)).map (fun call => call.detail)

/-- A predicate of the returned outcome and externally observed history.
This erases neither successful results nor the identity of errors. -/
def MiddleOutcomeCheck {E State A : Type}
    (check : Except E A → List (MiddleCall E State) → Prop)
    (observation : Option (Except (E × MiddleWorld E State) (A × MiddleWorld E State))) : Prop :=
  match observation with
  | none => True
  | some (.ok (value, (_, history))) => check (.ok value) history
  | some (.error (error, (_, history))) => check (.error error) history

/-- Selected coordinate queries are arbitrary effects, including more-specific
methods returning runtime tags different from the stored component type. -/
def MiddleObserveParts {E State A : Type}
    (parts : ComponentOps (MiddleM E State) A)
    (realLabel : String := "real") (imagLabel : String := "imag") :
    ComponentOps (MiddleM E (MiddleWorld E State)) A where
  real := fun z => MiddleObserve realLabel (parts.real z)
  imag := fun z => MiddleObserve imagLabel (parts.imag z)

def MiddleIsRealPath {m : Type → Type} {A Result : Type}
    (target : IsRealDispatch m A Result) : List String :=
  match target with
  | .inherited _ => ["imag", "isreal"]
  | .selectedCustom _ => ["isreal"]

def MiddleObserveCheckedIsReal {E State A NotBool : Type}
    (target : IsRealDispatch (MiddleM E State) A (Checked Bool NotBool)) :
    IsRealDispatch (MiddleM E (MiddleWorld E State)) A (Checked Bool NotBool) :=
  match target with
  | .inherited scalar => .inherited (fun value => MiddleObserveInfo "isreal" MiddleCheckedInfo (scalar value))
  | .selectedCustom call => .selectedCustom (fun value => MiddleObserveInfo "isreal" MiddleCheckedInfo (call value))

/-- Recorded condition results determine whether the second selected call
is present.  This checks the observable short-circuit gate independently of
the call-history budget and catches a caller that always skips the second call. -/
def MiddleConditionGate {E State Other : Type}
    (conditionPath : List String) (secondLabel : String)
    (observation : Option (Except ((Error E) × MiddleWorld (Error E) State)
      (PredicateValue Other × MiddleWorld (Error E) State))) : Prop :=
  MiddleOutcomeCheck (fun outcome history =>
    if MiddleDetails "isreal" history = ["false"] then
      outcome = .ok (.boolean false) ∧ MiddleLabels history = conditionPath
    else if MiddleDetails "isreal" history = ["true"] then
      (∃ rest : List String, MiddleLabels history = conditionPath ++ ["real"] ++ rest) ∧
      MiddlePrefix (MiddleOnePath (conditionPath ++ ["real", secondLabel])) (MiddleLabels history)
    else if MiddleDetails "isreal" history = ["rejected"] then
      outcome = .error (.typeError "&& condition") ∧ MiddleLabels history = conditionPath
    else True) observation

def MiddleEqualityGate {E State Other : Type}
    (observation : Option (Except (E × MiddleWorld E State)
      (PredicateValue Other × MiddleWorld E State))) : Prop :=
  MiddleOutcomeCheck (fun outcome history =>
    match MiddleDetails "equal" history with
    | [r, i] =>
        if (r = "true" ∨ r = "false") ∧ (i = "true" ∨ i = "false") then
          MiddleLabels history = ["realA", "realB", "equal", "imagA", "imagB", "equal"] ∧
          ∃ answer : Bool, outcome = .ok (.boolean answer) ∧
            (answer = true ↔ r = "true" ∧ i = "true")
        else if r ≠ "" ∧ i ≠ "" ∧ (r = "other" ∨ i = "other") then
          MiddleLabels history = ["realA", "realB", "equal", "imagA", "imagB", "equal", "and"]
        else True
    | _ => True) observation

def MiddleIsequalGate {E State : Type}
    (observation : Option (Except ((Error E) × MiddleWorld (Error E) State)
      (Bool × MiddleWorld (Error E) State))) : Prop :=
  MiddleOutcomeCheck (fun outcome history =>
    (MiddleDetails "first" history = ["rejected"] →
      outcome = .error (.typeError "isequal(real)::Bool") ∧ MiddleLabels history = ["real", "first"]) ∧
    ((MiddleDetails "first" history = ["true"] ∨ MiddleDetails "first" history = ["false"]) →
      ∃ rest : List String, MiddleLabels history = ["real", "first", "zero"] ++ rest) ∧
    (MiddleDetails "second" history = ["rejected"] →
      outcome = .error (.typeError "isequal(imag)::Bool")) ∧
    (∀ (r i : String),
      MiddleDetails "first" history = [r] → MiddleDetails "second" history = [i] →
      (r = "true" ∨ r = "false") → (i = "true" ∨ i = "false") →
      ∃ answer : Bool, outcome = .ok answer ∧ (answer = true ↔ r = "true" ∧ i = "true"))) observation

/-- Both public constructor wrappers make one selected call, preserve all
callee effects and return any callee exception with its exact final state.
Invariant: base/complex.jl:169-170. -/
def MiddlePublicConstructorsAudit : Prop :=
  (∀ (E State A Result : Type)
      (ops : PublicOneOps (MiddleM E State) A Result) (x : A) (state : State),
    MiddleAudit (MiddleOnePath ["construct"]) MiddleNoLocalError state
      ((publicComplexOne
        ({ construct := fun value => MiddleObserve "construct" (ops.construct value) } :
          PublicOneOps (MiddleM E (MiddleWorld E State)) A Result) x).run (state, []))) ∧
  (∀ (E State A B Result : Type)
      (ops : PublicTwoOps (MiddleM E State) A B Result) (x : A) (y : B) (state : State),
    MiddleAudit (MiddleOnePath ["construct"]) MiddleNoLocalError state
      ((publicComplexTwo
        ({ construct := fun a b => MiddleObserve "construct" (ops.construct a b) } :
          PublicTwoOps (MiddleM E (MiddleWorld E State)) A B Result) x y).run (state, [])))

/-- Mathematical representability and stored coordinates, with every input
included.  An InexactError is allowed only when a requested value is outside
the target machine integer's range. -/
def MiddleConstructorObservation (t : IntTy) (real imag : Int)
    (result : Jl (Complex (JInt t))) : Prop :=
  match result with
  | .ok value => value.re.val = real ∧ value.im.val = imag
  | .error (.inexactError _) =>
      ¬ (t.min ≤ real ∧ real ≤ t.max ∧ t.min ≤ imag ∧ imag ≤ t.max)
  | .error _ => False

/-- Concrete Base constructor calls preserve integer coordinates, or reject
an unrepresentable promoted coordinate.  No promotion correctness premise is
supplied.  Documentation: base/complex.jl:157-170;
doc/src/manual/conversion-and-promotion.md:201-243. -/
def MiddlePublicConstructorsNative : Prop :=
  (∀ (t : IntTy) (x : JInt t),
    MiddleConstructorObservation t x.val 0
      (publicComplexOne
        ({ construct := JuliaLean.base.complex.Models1Group19.complexIntReal } :
          PublicOneOps Jl (JInt t) (Complex (JInt t))) x)) ∧
  (∀ (t s : IntTy) (x : JInt t) (y : JInt s),
    MiddleConstructorObservation (IntTy.promote t s) x.val y.val
      (publicComplexTwo
        ({ construct := JuliaLean.base.complex.Models1Group19.complexIntPair } :
          PublicTwoOps Jl (JInt t) (JInt s) (Complex (JInt (IntTy.promote t s)))) x y))

/-- Full-domain effect and native numerical observations of public complex
construction. -/
def MiddlePublicConstructors : Prop :=
  MiddlePublicConstructorsAudit ∧ MiddlePublicConstructorsNative

/-- Generic Complex{Bool} display retains exactly one IO print, including
arbitrary IO-subtype errors and mutations.  Invariant: base/complex.jl:219-220. -/
def MiddleBoolShowAudit : Prop :=
  ∀ (E State IO Result : Type) (ops : BoolShowOps (MiddleM E State) IO Result)
      (io : IO) (z : Complex Bool) (state : State),
    MiddleAudit (MiddleOnePath ["print"]) MiddleNoLocalError state
      ((showBoolComplex
        ({ print := fun handle text => MiddleObserve "print" (ops.print handle text) } :
          BoolShowOps (MiddleM E (MiddleWorld E State)) IO Result) io z).run (state, []))

/-- All four Bool values have their public readable forms.  This observes
the emitted string, not a call to the renderer as an expected result.
Source and documented display invariant: base/complex.jl:219-220. -/
def MiddleBoolShowText : Prop :=
  ∀ (r i : Bool),
    showBoolComplex ({ print := fun (_ : Unit) (text : String) => text } :
      BoolShowOps Id Unit String) () ⟨r, i⟩ =
      (match r, i with
       | false, false => "Complex(false,false)"
       | false, true => "im"
       | true, false => "Complex(true,false)"
       | true, true => "Complex(true,true)")

def MiddleBoolShow : Prop := MiddleBoolShowAudit ∧ MiddleBoolShowText

/-- Two successful reads precede construction.  A failing read preserves its
stream mutation and prevents later calls; the constructor is not repeated.
Invariant: base/complex.jl:232-236. -/
def MiddleReadAudit : Prop :=
  ∀ (E State IO Value Result : Type)
      (ops : ReadComplexOps (MiddleM E State) IO Value Result) (io : IO) (state : State),
    MiddleAudit (MiddleOnePath ["read", "read", "construct"]) MiddleNoLocalError state
      ((readComplex
        ({ read := fun handle => MiddleObserve "read" (ops.read handle)
           construct := fun r i => MiddleObserve "construct" (ops.construct r i) } :
          ReadComplexOps (MiddleM E (MiddleWorld E State)) IO Value Result) io).run (state, []))

/-- Both selected component queries precede the one selected writer call.
Every arbitrary getter or writer exception retains its precise final state.
Invariant: base/complex.jl:237-239. -/
def MiddleWriteAudit : Prop :=
  ∀ (E State IO Value Result : Type)
      (ops : WriteComplexOps (MiddleM E State) IO Value Result)
      (parts : ComponentOps (MiddleM E State) Value)
      (io : IO) (z : Complex Value) (state : State),
    MiddleAudit (MiddleOnePath ["real", "imag", "write"]) MiddleNoLocalError state
      ((writeComplex
        ({ write := fun handle r i => MiddleObserve "write" (ops.write handle r i) } :
          WriteComplexOps (MiddleM E (MiddleWorld E State)) IO Value Result)
        io z (MiddleObserveParts parts)).run (state, []))

def MiddleObserveUnary {E State A B Result : Type}
    (ops : UnaryConstructOps (MiddleM E State) A B Result) :
    UnaryConstructOps (MiddleM E (MiddleWorld E State)) A B Result where
  scalar := fun value => MiddleObserve "scalar" (ops.scalar value)
  construct := fun r i => MiddleObserve "construct" (ops.construct r i)

/-- Byte swapping, unary plus, unary minus and wrapping negation always
evaluate both scalar calls before constructing the result.  Every selected
callee is arbitrary; failures retain their state and suppress later calls.
Invariant: base/complex.jl:242,290-291,297. -/
def MiddleUnaryAudit : Prop :=
  ∀ (E State A B Result : Type) (ops : UnaryConstructOps (MiddleM E State) A B Result)
      (parts : ComponentOps (MiddleM E State) A) (z : Complex A) (state : State),
    let observed := MiddleObserveUnary ops
    let components := MiddleObserveParts parts
    let check := MiddleAudit (MiddleOnePath ["real", "scalar", "imag", "scalar", "construct"])
      MiddleNoLocalError state
    check ((byteSwapComplex observed z components).run (state, [])) ∧
    check ((positiveComplex observed z components).run (state, [])) ∧
    check ((negativeComplex observed z components).run (state, [])) ∧
    check ((negativeWrapComplex observed z components).run (state, []))

/-- Both component comparisons are eager; a dispatched non-Bool & may add
one final call.  This includes false first comparisons and later exceptions.
Invariant: base/complex.jl:246. -/
def MiddleEqualityAudit : Prop :=
  ∀ (E State A B Other : Type) (ops : EqualityOps (MiddleM E State) A B Other)
      (partsA : ComponentOps (MiddleM E State) A)
      (partsB : ComponentOps (MiddleM E State) B)
      (z : Complex A) (w : Complex B) (state : State),
    let observation := (equalComplex
      ({ equal := fun a b => MiddleObserveInfo "equal" MiddlePredicateInfo (ops.equal a b)
         andOther := fun a b => MiddleObserve "and" (ops.andOther a b) } :
        EqualityOps (MiddleM E (MiddleWorld E State)) A B Other) z w
      (MiddleObserveParts partsA "realA" "imagA")
      (MiddleObserveParts partsB "realB" "imagB")).run (state, [])
    MiddleAudit (fun labels =>
      labels = ["realA", "realB", "equal", "imagA", "imagB", "equal"] ∨
      labels = ["realA", "realB", "equal", "imagA", "imagB", "equal", "and"])
      MiddleNoLocalError state observation ∧ MiddleEqualityGate observation

/-- Short-circuit real/complex equality has one condition query and at most
one equality call.  A native condition TypeError occurs only after the query;
callee errors retain the exact exception and final state.
Invariant: base/complex.jl:248. -/
def MiddleRealEqualityAudit : Prop :=
  ∀ (E State R A NotBool Other : Type)
      (ops : RealEqualityOps (MiddleM (Error E) State) R A NotBool Other)
      (parts : ComponentOps (MiddleM (Error E) State) A)
      (x : R) (z : Complex A) (state : State),
    let observation := (equalRealComplex (E := E)
      ({ isreal := MiddleObserveCheckedIsReal ops.isreal
         equal := fun a b => MiddleObserve "equal" (ops.equal a b) } :
        RealEqualityOps (MiddleM (Error E) (MiddleWorld (Error E) State)) R A NotBool Other)
      x z (MiddleObserveParts parts)).run (state, [])
    let conditionPath := MiddleIsRealPath ops.isreal
    MiddleAudit (fun labels => labels = conditionPath ∨ labels = conditionPath ++ ["real", "equal"])
      (fun error labels => error = .typeError "&& condition" ∧ labels = conditionPath) state observation ∧
    MiddleConditionGate conditionPath "equal" observation

/-- The explicitly asserted comparisons keep the two TypeError throw sites
distinct.  A false first comparison still requires zero and the second call.
Invariant: base/complex.jl:252. -/
def MiddleRealIsequalAudit : Prop :=
  ∀ (E State R A Zero NotBool1 NotBool2 : Type)
      (ops : RealIsequalOps (MiddleM (Error E) State) R A Zero NotBool1 NotBool2)
      (parts : ComponentOps (MiddleM (Error E) State) A)
      (z : R) (w : Complex A) (state : State),
    let observation := (isequalRealComplex (E := E)
      ({ first := fun a b => MiddleObserveInfo "first" MiddleCheckedInfo (ops.first a b)
         zero := fun a => MiddleObserve "zero" (ops.zero a)
         second := fun a b => MiddleObserveInfo "second" MiddleCheckedInfo (ops.second a b) } :
        RealIsequalOps (MiddleM (Error E) (MiddleWorld (Error E) State))
          R A Zero NotBool1 NotBool2) z w (MiddleObserveParts parts)).run (state, [])
    MiddleAudit (MiddleOnePath ["real", "first", "zero", "imag", "second"])
      (fun error labels =>
        (error = .typeError "isequal(real)::Bool" ∧ labels = ["real", "first"]) ∨
        (error = .typeError "isequal(imag)::Bool" ∧ labels = ["real", "first", "zero", "imag", "second"])) state observation ∧
    MiddleIsequalGate observation

/-- AbstractRange membership keeps the native short circuit while retaining
arbitrary range membership errors, state, and non-Bool successful results.
Invariant: base/complex.jl:254. -/
def MiddleMembershipAudit : Prop :=
  ∀ (E State A Range NotBool Other : Type)
      (ops : MembershipOps (MiddleM (Error E) State) A Range NotBool Other)
      (parts : ComponentOps (MiddleM (Error E) State) A)
      (z : Complex A) (range : Range) (state : State),
    let observation := (memberComplex (E := E)
      ({ isreal := MiddleObserveCheckedIsReal ops.isreal
         contains := fun a r => MiddleObserve "contains" (ops.contains a r) } :
        MembershipOps (MiddleM (Error E) (MiddleWorld (Error E) State)) A Range NotBool Other)
      z range (MiddleObserveParts parts)).run (state, [])
    let conditionPath := MiddleIsRealPath ops.isreal
    MiddleAudit (fun labels => labels = conditionPath ∨ labels = conditionPath ++ ["real", "contains"])
      (fun error labels => error = .typeError "&& condition" ∧ labels = conditionPath) state observation ∧
    MiddleConditionGate conditionPath "contains" observation

/-- Squared norm queries each component twice, without caching a selected
getter, and interleaves multiplication before the imaginary queries.  Every
selected getter and scalar method may mutate, fail, or diverge.
Invariant: base/complex.jl:282. -/
def MiddleAbs2Audit : Prop :=
  ∀ (E State A Product Result : Type)
      (ops : SquaredNormOps (MiddleM E State) A Product Result)
      (parts : ComponentOps (MiddleM E State) A)
      (z : Complex A) (state : State),
    MiddleAudit (MiddleOnePath ["real", "real", "multiply", "imag", "imag", "multiply", "add"])
      MiddleNoLocalError state
      ((squaredNormComplex
        ({ multiply := fun a b => MiddleObserve "multiply" (ops.multiply a b)
           add := fun a b => MiddleObserve "add" (ops.add a b) } :
          SquaredNormOps (MiddleM E (MiddleWorld E State)) A Product Result)
        z (MiddleObserveParts parts)).run (state, []))

def MiddleObserveIntegerInverse {E State A Other Result : Type}
    (ops : IntegerInverseOps E State A Other Result) :
    IntegerInverseOps E (MiddleWorld E State) A Other Result where
  toFloat := fun z => (MiddleObserve "float" (⟨ops.toFloat z⟩ : MiddleM E State
    (IntegerFloatResult A Other))).run
  inverseOther := fun value => (MiddleObserve "inverse" (⟨ops.inverseOther value⟩ :
    MiddleM E State Result)).run

/-- Every finite successful recursive inverse contains at least one float
call and one final distinct inverse call.  Errors at any depth retain their
exact payload and state, with no subsequent call.  Divergence remains explicit.
Invariant: base/complex.jl:288. -/
def MiddleIntegerInverseAudit : Prop :=
  ∀ (E State A Other Result : Type) (ops : IntegerInverseOps E State A Other Result)
      (z : Complex A) (state : State),
    MiddleAudit
      (fun labels => ∃ count : Nat, 0 < count ∧ labels = List.replicate count "float" ++ ["inverse"])
      MiddleNoLocalError state
      (inverseIntegerComplex (MiddleObserveIntegerInverse ops) z (state, []))

def MiddleObserveBinary {E State A B Scalar Result : Type}
    (ops : BinaryConstructOps (MiddleM E State) A B Scalar Result) :
    BinaryConstructOps (MiddleM E (MiddleWorld E State)) A B Scalar Result where
  scalar := fun a b => MiddleObserve "scalar" (ops.scalar a b)
  construct := fun r i => MiddleObserve "construct" (ops.construct r i)

/-- Each binary addition/subtraction variant executes two ordered scalar
calls before exactly one construction; no selected operation is assumed pure.
Invariant: base/complex.jl:292-293,298-299. -/
def MiddleBinaryAudit : Prop :=
  ∀ (E State A B Scalar Result : Type)
      (ops : BinaryConstructOps (MiddleM E State) A B Scalar Result)
      (partsA : ComponentOps (MiddleM E State) A)
      (partsB : ComponentOps (MiddleM E State) B)
      (z : Complex A) (w : Complex B) (state : State),
    let observed := MiddleObserveBinary ops
    let componentsA := MiddleObserveParts partsA "realA" "imagA"
    let componentsB := MiddleObserveParts partsB "realB" "imagB"
    let check := MiddleAudit
      (MiddleOnePath ["realA", "realB", "scalar", "imagA", "imagB", "scalar", "construct"])
      MiddleNoLocalError state
    check ((addComplex observed z w componentsA componentsB).run (state, [])) ∧
    check ((subtractComplex observed z w componentsA componentsB).run (state, [])) ∧
    check ((addWrapComplex observed z w componentsA componentsB).run (state, [])) ∧
    check ((subtractWrapComplex observed z w componentsA componentsB).run (state, []))

def MiddleObserveMultiply {E State A B Product R I Result : Type}
    (ops : MultiplyConstructOps (MiddleM E State) A B Product R I Result) :
    MultiplyConstructOps (MiddleM E (MiddleWorld E State)) A B Product R I Result where
  multiply := fun a b => MiddleObserve "multiply" (ops.multiply a b)
  subtract := fun a b => MiddleObserve "subtract" (ops.subtract a b)
  add := fun a b => MiddleObserve "add" (ops.add a b)
  construct := fun r i => MiddleObserve "construct" (ops.construct r i)

/-- Multiplication performs subtraction after the first two products and
before either cross product.  Both ordinary and wrapping methods retain every
selected error and mutation and perform one final construction.
Invariant: base/complex.jl:294-295,300-301. -/
def MiddleMultiplyAudit : Prop :=
  ∀ (E State A B Product R I Result : Type)
      (ops : MultiplyConstructOps (MiddleM E State) A B Product R I Result)
      (partsA : ComponentOps (MiddleM E State) A)
      (partsB : ComponentOps (MiddleM E State) B)
      (z : Complex A) (w : Complex B) (state : State),
    let observed := MiddleObserveMultiply ops
    let componentsA := MiddleObserveParts partsA "realA" "imagA"
    let componentsB := MiddleObserveParts partsB "realB" "imagB"
    let check := MiddleAudit
      (MiddleOnePath ["realA", "realB", "multiply", "imagA", "imagB", "multiply", "subtract",
        "realA", "imagB", "multiply", "imagA", "realB", "multiply", "add", "construct"])
      MiddleNoLocalError state
    check ((multiplyComplex observed z w componentsA componentsB).run (state, [])) ∧
    check ((multiplyWrapComplex observed z w componentsA componentsB).run (state, []))

/-- Narrow internal invariant: negation is evaluated once, before muladd;
its failure prevents muladd, and every selected failure retains its state.
No public mathematical contract is invented for arbitrary scalar methods.
Invariant: base/complex.jl:304. -/
def MiddleMulsubAudit : Prop :=
  ∀ (E State A Negative Result : Type)
      (ops : MulsubOps (MiddleM E State) A Negative Result) (a b c : A) (state : State),
    MiddleAudit (MiddleOnePath ["negate", "muladd"]) MiddleNoLocalError state
      ((mulsubSameType
        ({ negate := fun value => MiddleObserve "negate" (ops.negate value)
           muladd := fun x y z => MiddleObserve "muladd" (ops.muladd x y z) } :
          MulsubOps (MiddleM E (MiddleWorld E State)) A Negative Result) a b c).run (state, []))

/-- ifelse is an ordinary dispatched call: signbit, negation and ifelse all
occur in this order on every normal return.  In particular a false sign cannot
skip negation, and any of the three callees may change state or throw.
Invariant: base/complex.jl:197; base/essentials.jl:881-894. -/
def MiddleFlipSignAudit : Prop :=
  ∀ (E State A Sign OtherSign Negative Result : Type)
      (ops : FlipSignOps (MiddleM E State) A Sign OtherSign Negative Result)
      (x : Complex A) (y : Sign) (state : State),
    MiddleAudit (MiddleOnePath ["signbit", "negate", "ifelse"]) MiddleNoLocalError state
      ((flipSignComplex
        ({ signbit := fun value => MiddleObserve "signbit" (ops.signbit value)
           negate := fun value => MiddleObserve "negate" (ops.negate value)
           ifelse := fun condition yes no => MiddleObserve "ifelse" (ops.ifelse condition yes no) } :
          FlipSignOps (MiddleM E (MiddleWorld E State)) A Sign OtherSign Negative Result)
        x y).run (state, []))

/-- Native machine-integer constructor specialization of the installed model.
Same-type promotion is the actual Base identity dispatch; its returned values
are not constrained by a premise supplied to a theorem.
Source: base/complex.jl:13-18; base/promotion.jl:441. -/
def MiddleIntegerConstruct {t : IntTy} (r i : JInt t) : Jl (Complex (JInt t)) :=
  Complex_Real_Real (fun a b => .ok (a, b)) r i

def MiddleIntegerUnary (t : IntTy) (scalar : JInt t → JInt t) :
    UnaryConstructOps Jl (JInt t) (JInt t) (Complex (JInt t)) where
  scalar := fun value => .ok (scalar value)
  construct := MiddleIntegerConstruct

def MiddleIntegerBinary (t : IntTy) (scalar : JInt t → JInt t → JInt t) :
    BinaryConstructOps Jl (JInt t) (JInt t) (JInt t) (Complex (JInt t)) where
  scalar := fun a b => .ok (scalar a b)
  construct := MiddleIntegerConstruct

def MiddleIntegerMultiply (t : IntTy) :
    MultiplyConstructOps Jl (JInt t) (JInt t) (JInt t) (JInt t) (JInt t) (Complex (JInt t)) where
  multiply := fun a b => .ok (mul_JInt a b)
  subtract := fun a b => .ok (sub_JInt a b)
  add := fun a b => .ok (add_JInt a b)
  construct := MiddleIntegerConstruct

/-- Congruence with mathematical Gaussian-integer coordinates, independently
of the model's intermediate wrapping operations.  Native calls must terminate
normally; divergence or any exception fails this observation. -/
def MiddleModularPair (t : IntTy) (real imag : Int) (result : Jl (Complex (JInt t))) : Prop :=
  match result with
  | .ok value =>
      value.re.val % (2 ^ t.bits : Int) = real % (2 ^ t.bits : Int) ∧
      value.im.val % (2 ^ t.bits : Int) = imag % (2 ^ t.bits : Int)
  | .error _ => False

def MiddleModularScalar (t : IntTy) (value : Int) (result : Jl (JInt t)) : Prop :=
  match result with
  | .ok actual => actual.val % (2 ^ t.bits : Int) = value % (2 ^ t.bits : Int)
  | .error _ => False

/-- Native unary, binary, wrapping, multiplication and squared-norm results
agree with mathematical Gaussian integers modulo the machine width, over all
ten integer types and all their values.  The internal _mulsub instance has the
narrow corresponding congruence.  No no-overflow assumptions are imposed.
Documentation: doc/src/manual/complex-and-rational-numbers.md:20-86,88-115;
doc/src/manual/integers-and-floating-point-numbers.md:231-249;
source: base/complex.jl:282,290-301,304. -/
def MiddleNativeIntegerArithmetic : Prop :=
  (∀ (t : IntTy) (z : Complex (JInt t)),
    MiddleModularPair t z.re.val z.im.val
      (positiveComplex (MiddleIntegerUnary t pos_JInt) z) ∧
    MiddleModularPair t (-z.re.val) (-z.im.val)
      (negativeComplex (MiddleIntegerUnary t neg_JInt) z) ∧
    MiddleModularPair t (-z.re.val) (-z.im.val)
      (negativeWrapComplex (MiddleIntegerUnary t neg_JInt) z)) ∧
  (∀ (t : IntTy) (z w : Complex (JInt t)),
    MiddleModularPair t (z.re.val + w.re.val) (z.im.val + w.im.val)
      (addComplex (MiddleIntegerBinary t add_JInt) z w) ∧
    MiddleModularPair t (z.re.val - w.re.val) (z.im.val - w.im.val)
      (subtractComplex (MiddleIntegerBinary t sub_JInt) z w) ∧
    MiddleModularPair t (z.re.val + w.re.val) (z.im.val + w.im.val)
      (addWrapComplex (MiddleIntegerBinary t add_JInt) z w) ∧
    MiddleModularPair t (z.re.val - w.re.val) (z.im.val - w.im.val)
      (subtractWrapComplex (MiddleIntegerBinary t sub_JInt) z w) ∧
    MiddleModularPair t
      (z.re.val * w.re.val - z.im.val * w.im.val)
      (z.re.val * w.im.val + z.im.val * w.re.val)
      (multiplyComplex (MiddleIntegerMultiply t) z w) ∧
    MiddleModularPair t
      (z.re.val * w.re.val - z.im.val * w.im.val)
      (z.re.val * w.im.val + z.im.val * w.re.val)
      (multiplyWrapComplex (MiddleIntegerMultiply t) z w)) ∧
  (∀ (t : IntTy) (z : Complex (JInt t)),
    MiddleModularScalar t (z.re.val ^ 2 + z.im.val ^ 2)
      (squaredNormComplex
        ({ multiply := fun a b => pure (mul_JInt a b)
           add := fun a b => pure (add_JInt a b) } :
          SquaredNormOps Jl (JInt t) (JInt t) (JInt t)) z)) ∧
  (∀ (t : IntTy) (a b c : JInt t),
    MiddleModularScalar t (a.val * b.val - c.val)
      (mulsubSameType
        ({ negate := fun value => .ok (neg_JInt value)
           muladd := fun x y z => .ok (muladd_JInt x y z) } :
          MulsubOps Jl (JInt t) (JInt t) (JInt t)) a b c))

def MiddleNativeFlipOps (t s : IntTy) :
    FlipSignOps Id (JInt t) (JInt s) Empty (Complex (JInt t))
      (IfElseResult (Complex (JInt t)) (Complex (JInt t)) Empty) where
  signbit := fun y => .boolean (signbit_JInt y)
  negate := neg_Complex neg_JInt
  ifelse := fun condition yes no =>
    match condition with
    | .boolean b => nativeIfElse b yes no
    | .other impossible => nomatch impossible

/-- Integer flipsign preserves both original coordinates for nonnegative
sign sources; negative sign sources negate both coordinates modulo the width.
This exercises the actual inherited native ifelse helper as well as the caller.
Documentation/source: base/complex.jl:197; base/int.jl:234-240. -/
def MiddleNativeFlipSign : Prop :=
  ∀ (t s : IntTy) (x : Complex (JInt t)) (y : JInt s),
    match flipSignComplex (MiddleNativeFlipOps t s) x y with
    | .thenValue value => y.val < 0 ∧
        value.re.val % (2 ^ t.bits : Int) = (-x.re.val) % (2 ^ t.bits : Int) ∧
        value.im.val % (2 ^ t.bits : Int) = (-x.im.val) % (2 ^ t.bits : Int)
    | .elseValue value => 0 ≤ y.val ∧ value = x
    | .customValue impossible => nomatch impossible

def MiddleFlipSign : Prop := MiddleFlipSignAudit ∧ MiddleNativeFlipSign

/-- The actual Bool conjunction on the only inhabitant cases of this native
predicate-result carrier.  Impossible non-Bool branches are eliminated, not
given dummy callback results. -/
def MiddleNativePredicateAnd {E : Type} (a b : PredicateValue Empty) :
    Except E (PredicateValue Empty) :=
  match a, b with
  | .boolean x, .boolean y => .ok (.boolean (x && y))
  | .other impossible, _ => nomatch impossible
  | _, .other impossible => nomatch impossible

def MiddlePredicateTruth {E : Type} (expected : Prop)
    (result : Except E (PredicateValue Empty)) : Prop :=
  match result with
  | .ok (.boolean answer) => answer = true ↔ expected
  | .ok (.other impossible) => nomatch impossible
  | .error _ => False

def MiddleBoolTruth {E : Type} (expected : Prop) (result : Except E Bool) : Prop :=
  match result with
  | .ok answer => answer = true ↔ expected
  | .error _ => False

/-- Native integer equality and isequal are characterized by mathematical
coordinates, not by repeating the component tests of their implementations.
All native integer values are included, with no callee correctness premise.
Source: base/complex.jl:246,248,252; invariant: exact integer equality. -/
def MiddleNativeIntegerEquality : Prop :=
  (∀ (t : IntTy) (z w : Complex (JInt t)),
    MiddlePredicateTruth (z = w)
      (equalComplex
        ({ equal := fun a b => .ok (.boolean (a.val == b.val))
           andOther := MiddleNativePredicateAnd } :
          EqualityOps Jl (JInt t) (JInt t) Empty) z w)) ∧
  (∀ (t : IntTy) (x : JInt t) (z : Complex (JInt t)),
    MiddlePredicateTruth (z.re.val = x.val ∧ z.im.val = 0)
      (equalRealComplex (E := Empty)
        ({ isreal := .inherited (fun value => .ok (.accepted (iszero_JInt value)))
           equal := fun a b => .ok (.boolean (a.val == b.val)) } :
          RealEqualityOps (Except (Error Empty)) (JInt t) (JInt t) Empty Empty) x z)) ∧
  (∀ (t : IntTy) (x : JInt t) (z : Complex (JInt t)),
    MiddleBoolTruth (z.re.val = x.val ∧ z.im.val = 0)
      (isequalRealComplex (E := Empty)
        ({ first := fun a b => .ok (.accepted (a.val == b.val))
           zero := fun value => .ok (zero_JInt value)
           second := fun a b => .ok (.accepted (a.val == b.val)) } :
          RealIsequalOps (Except (Error Empty)) (JInt t) (JInt t) (JInt t) Empty Empty) x z))

/-- Closed native specialization: actual integer-to-Float64 conversion and
the installed Float64 inverse, with the same state retained on errors.
Source: base/complex.jl:288,482-510,1130. -/
def MiddleNativeIntegerInverseOps (State : Type) (t : IntTy) :
    IntegerInverseOps JlError State (JInt t) ComplexF64 ComplexF64 where
  toFloat := fun z state => some (.ok (.other (float_Complex F64.ofJInt z), state))
  inverseOther := fun value state =>
    match JuliaLean.base.complex.Models1Group19.inverseF64 value with
    | .ok result => some (.ok (result, state))
    | .error error => some (.error (error, state))

/-- Native integer inverses terminate without changing state.  Zero has two
NaN coordinates; nonzero inputs have finite inverse coordinates, with the real
sign preserved and the imaginary sign reversed.  Axis-aligned inputs remain
axis-aligned.  These are independent classification/sign invariants, not a
repeated reciprocal algorithm.
Source: base/complex.jl:288,482-510; doc/src/manual/complex-and-rational-numbers.md:20-86. -/
def MiddleNativeIntegerInverse : Prop :=
  ∀ (State : Type) (t : IntTy) (z : Complex (JInt t)) (state : State),
    match inverseIntegerComplex (MiddleNativeIntegerInverseOps State t) z state with
    | some (.ok (value, final)) => final = state ∧
        (if z.re.val = 0 ∧ z.im.val = 0 then
           F64.isnan value.re = true ∧ F64.isnan value.im = true
         else
           F64.isfinite value.re = true ∧ F64.isfinite value.im = true ∧
           (z.re.val = 0 → F64.iszero value.re = true) ∧
           (z.im.val = 0 → F64.iszero value.im = true) ∧
           (z.re.val ≠ 0 → F64.signbit value.re = decide (z.re.val < 0)) ∧
           (z.im.val ≠ 0 → F64.signbit value.im = decide (0 < z.im.val)))
    | _ => False

def MiddleIntegerInverse : Prop := MiddleIntegerInverseAudit ∧ MiddleNativeIntegerInverse

end JuliaLean.Proofs.base.complex.Models2Group9


namespace JuliaLean.Proofs.base.complex.Models2Group9

open JuliaLean JuliaLean.base.complex
