namespace JuliaLean.Proofs.base.complex.Models2Group9

open JuliaLean JuliaLean.base.complex
open JuliaLean.base.complex.Models2Group9 (Error Checked PredicateValue ComponentOps nativeComponents)
open JuliaLean.base.complex.Models2Group9 (DivideSameOps DivideSameTarget divideSameComplex)

/-- A standard transformer interpretation records arbitrary state changes even
when a callee throws.  `none` represents divergence, with no fabricated result.
Invariant: base/complex.jl:360-377. -/
abbrev MixedDivisionM (E State A : Type) :=
  ExceptT (Error E) (StateT State Option) A

/-- A condition receipt distinguishes an actual accepted Bool, a non-Bool
result, and a return value that is not tested as a condition. -/
inductive MixedDivisionCondition where
  | unrelated
  | accepted (value : Bool)
  | rejected

/-- Observable completed external calls retain argument identities, failure
identity, and state before and after the call. -/
structure MixedDivisionReceipt (E State V : Type) where
  label : String
  arguments : List V
  failure : Option (Error E)
  condition : MixedDivisionCondition
  returned : Option V
  before : State
  after : State

abbrev MixedDivisionWorld (E State V : Type) :=
  State × List (MixedDivisionReceipt E State V)

/-- Instrument an arbitrary selected callee without changing its actual return,
exception, divergence, or state transformation.  The history is external to that
callee, so it cannot rewrite or suppress the recorded observation. -/
def MixedDivisionObserve {E State V A : Type} (label : String) (arguments : List V)
    (condition : A → MixedDivisionCondition) (action : MixedDivisionM E State A)
    (returned : A → Option V := fun _ => none) :
    MixedDivisionM E (MixedDivisionWorld E State V) A := fun (state, history) =>
  match action state with
  | none => none
  | some (outcome, final) =>
      let receipt : MixedDivisionReceipt E State V :=
        { label, arguments
          failure := match outcome with | .error error => some error | .ok _ => none
          condition := match outcome with | .error _ => .unrelated | .ok value => condition value
          returned := match outcome with | .error _ => none | .ok value => returned value
          before := state
          after := final }
      some (outcome, (final, history ++ [receipt]))

/-- Record a scalar call whose result is not subsequently used as a Boolean
condition by this source method. -/
def MixedDivisionObserveValue {E State V A : Type}
    (label : String) (arguments : List V) (action : MixedDivisionM E State A) :
    MixedDivisionM E (MixedDivisionWorld E State V) A :=
  MixedDivisionObserve label arguments (fun _ => .unrelated) action

def MixedDivisionPredicateCondition {Other : Type} :
    PredicateValue Other → MixedDivisionCondition
  | .boolean value => .accepted value
  | .other _ => .rejected

def MixedDivisionCheckedCondition {Other : Type} :
    Checked Bool Other → MixedDivisionCondition
  | .accepted value => .accepted value
  | .rejected _ => .rejected

/-- The observed record preserves pure runtime dispatch metadata.  Inherited
recursive calls receive the same observed record and therefore expose their
actual external calls; no callback replaces the recursive body. -/
def MixedDivisionObservedOps {E State V T Other NotBool : Type}
    (ops : DivideSameOps (MixedDivisionM E State) V T Other NotBool) :
    DivideSameOps (MixedDivisionM E (MixedDivisionWorld E State V)) V T Other NotBool where
  isinf := fun value => MixedDivisionObserve "isinf" [value]
    MixedDivisionPredicateCondition (ops.isinf value)
  orOther := fun left right => MixedDivisionObserve "orOther" []
    MixedDivisionPredicateCondition (ops.orOther left right)
  isfinite := fun value => MixedDivisionObserve "isfinite" [value.re, value.im]
    MixedDivisionCheckedCondition (ops.isfinite value)
  zero := fun tag => MixedDivisionObserveValue "zero" [] (ops.zero tag)
  sign := fun value => MixedDivisionObserveValue "sign" [value] (ops.sign value)
  negate := fun value => MixedDivisionObserveValue "negate" [value] (ops.negate value)
  multiply := fun left right => MixedDivisionObserveValue "multiply" [left, right]
    (ops.multiply left right)
  multiplyThree := fun first second third => MixedDivisionObserveValue "multiplyThree"
    [first, second, third] (ops.multiplyThree first second third)
  publicComplex := fun left right => MixedDivisionObserveValue "complex" [left, right]
    (ops.publicComplex left right)
  fromNaN := fun tag nan => MixedDivisionObserveValue "fromNaN" [] (ops.fromNaN tag nan)
  multiplyImaginaryUnit := fun left right => MixedDivisionObserveValue "multiplyIm" [left]
    (ops.multiplyImaginaryUnit left right)
  add := fun left right => MixedDivisionObserveValue "add" [left, right] (ops.add left right)
  subtract := fun left right => MixedDivisionObserveValue "subtract" [left, right]
    (ops.subtract left right)
  abs := fun value => MixedDivisionObserveValue "abs" [value] (ops.abs value)
  le := fun left right => MixedDivisionObserve "le" [left, right]
    MixedDivisionCheckedCondition (ops.le left right)
  divideTarget := ops.divideTarget
  divideOther := fun left right => MixedDivisionObserveValue "divideOther" [left, right]
    (ops.divideOther left right)
  construct := fun left right => MixedDivisionObserveValue "Complex" [left, right]
    (ops.construct left right)

/-- Observe both accessors on their original complex argument, preserving
actual returned runtime values for the denominator predicate audit. -/
def MixedDivisionObservedParts {E State V : Type}
    (parts : ComponentOps (MixedDivisionM E State) V) :
    ComponentOps (MixedDivisionM E (MixedDivisionWorld E State V)) V where
  real := fun value => MixedDivisionObserve "real" [value.re, value.im]
    (fun _ => .unrelated) (parts.real value) some
  imag := fun value => MixedDivisionObserve "imag" [value.re, value.im]
    (fun _ => .unrelated) (parts.imag value) some

/-- Every completed execution starts with real(a), imag(a), real(b), imag(b),
then tests the two actual denominator accessor results in order.  A shorter
history must end in a failed accessor or predicate call.  Native true at the
first isinf does not permit skipping the second call. -/
def MixedDivisionOpening {E State V : Type} (a b : Complex V)
    (history : List (MixedDivisionReceipt E State V)) : Prop :=
  ∃ bre bim : V,
    (∀ call, history[2]? = some call → call.failure = none → call.returned = some bre) ∧
    (∀ call, history[3]? = some call → call.failure = none → call.returned = some bim) ∧
    let expected : List (String × List V) :=
      [("real", [a.re, a.im]), ("imag", [a.re, a.im]),
       ("real", [b.re, b.im]), ("imag", [b.re, b.im]),
       ("isinf", [bre]), ("isinf", [bim])]
    (history.map (fun call => (call.label, call.arguments))).take 6 =
      expected.take history.length ∧
    (history.length < 6 → ∃ call, history.getLast? = some call ∧ call.failure ≠ none)

/-- All mutations between method entry and exit are accounted for by recorded
callee transitions, including state retained after a thrown exception. -/
def MixedDivisionStateChain {E State V : Type} (initial final : State) :
    List (MixedDivisionReceipt E State V) → Prop
  | [] => final = initial
  | call :: remaining =>
      call.before = initial ∧ MixedDivisionStateChain call.after final remaining

/-- The only locally generated failure is a type assertion on a returned
non-Bool condition.  Its receipt identifies the exact just-completed operation. -/
def MixedDivisionLocalError {E State V : Type} (error : Error E)
    (last : MixedDivisionReceipt E State V) : Prop :=
  error = .typeError "if" ∧ last.failure = none ∧ last.condition = .rejected ∧
  (last.label = "orOther" ∨ last.label = "isfinite" ∨ last.label = "le")

/-- Once the top-level isfinite result selects the infinite-denominator,
finite-numerator branch, both signs precede each single ternary product.  This
is an independent call-order/count invariant, including every failure prefix. -/
def MixedDivisionTernaryOrder {E State V : Type} (complete : Bool)
    (history : List (MixedDivisionReceipt E State V)) : Prop :=
  let check := fun (finiteIndex : Nat) (opening : List String) =>
    match history[finiteIndex]? with
    | none => True
    | some condition =>
        match condition.condition with
        | .accepted true =>
            let expected := opening ++ ["isfinite", "zero", "sign", "sign", "multiplyThree",
              "zero", "negate", "sign", "sign", "multiplyThree", "complex"]
            history.map (fun call => call.label) = expected.take history.length ∧
            (complete = true → history.length = expected.length)
        | _ => True
  match history[6]? with
  | none => True
  | some call =>
      if call.label = "isfinite" then
        check 6 ["real", "imag", "real", "imag", "isinf", "isinf"]
      else if call.label = "orOther" then
        check 7 ["real", "imag", "real", "imag", "isinf", "isinf", "orOther"]
      else True

/-- Independent trace/failure specification, rather than a second copy of the
Smith-division arithmetic.  A callee error is terminal and retains its identity
and post-call state.  A local Boolean assertion retains that same post-call
state.  Normal return admits no failed call receipt. -/
def MixedDivisionAudit {E State V : Type} (a b : Complex V) (initial : State)
    (observation : Option (Except (Error E) V × MixedDivisionWorld E State V)) : Prop :=
  match observation with
  | none => True
  | some (outcome, (final, history)) =>
      MixedDivisionOpening a b history ∧
      MixedDivisionTernaryOrder (match outcome with | .ok _ => true | .error _ => false) history ∧
      MixedDivisionStateChain initial final history ∧
      match outcome with
      | .ok _ => ∀ call ∈ history, call.failure = none
      | .error error =>
          ∃ (earlier : List (MixedDivisionReceipt E State V))
            (last : MixedDivisionReceipt E State V),
            history = earlier ++ [last] ∧
            (∀ call ∈ earlier, call.failure = none) ∧
            final = last.after ∧
            (last.failure = some error ∨ MixedDivisionLocalError error last)

/-- Full-domain eager-check and exception/state invariant for same-component
complex division, including type-changing component accessors and arithmetic and repeated
inherited method selection.  Every selected callee and every runtime dispatch
classification is quantified without behavioral correctness assumptions.
The only input invariant is the source representation: a and b are Complex{t}
with real-valued stored fields, as documented by DivideSameOps.
Julia source: base/complex.jl:360-377. -/
def MixedDivisionOpeningAndFailureAudit : Prop :=
  ∀ (E State V T Other NotBool : Type)
      (ops : DivideSameOps (MixedDivisionM E State) V T Other NotBool)
      (parts : ComponentOps (MixedDivisionM E State) V)
      (tag : T) (a b : Complex V) (initial : State),
    MixedDivisionAudit a b initial
      ((divideSameComplex (E := E)
        (monotoneBind := Lean.Order.instMonoBindExceptT
          (m := StateT (MixedDivisionWorld E State V) Option) (ε := Error E))
        (MixedDivisionObservedOps ops) tag a b (MixedDivisionObservedParts parts)) (initial, []))

end JuliaLean.Proofs.base.complex.Models2Group9


namespace JuliaLean.Proofs.base.complex.Models2Group9

open JuliaLean JuliaLean.Float JuliaLean.base.complex
open JuliaLean.base.complex.Models2Group9

/-!
Independent late-method observations reuse the Middle observer's exception and
mutation semantics.  All selected callees and coordinate queries are arbitrary.
The additional terminal-result receipt checks that a caller returns the actual
selected final call's result, while literal/tag/default audits observe arguments.
No callee correctness laws or pure-operation assumptions are premises.
-/

/-- Extend an arbitrary callee's state with an observer-only return receipt.
The selected code sees exactly its original state. -/
def LateCarry {E State A Result : Type} (action : MiddleM E State A) :
    MiddleM E (State × Option Result) A := ⟨fun (state, receipt) =>
  match action.run state with
  | none => none
  | some (.error (error, final)) => some (.error (error, (final, receipt)))
  | some (.ok (value, final)) => some (.ok (value, (final, receipt)))⟩

/-- Save the selected terminal call's actual result without constraining it. -/
def LateCapture {E State Result : Type} (action : MiddleM E State Result) :
    MiddleM E (State × Option Result) Result := ⟨fun (state, receipt) =>
  match action.run state with
  | none => none
  | some (.error (error, final)) => some (.error (error, (final, receipt)))
  | some (.ok (value, final)) => some (.ok (value, (final, some value)))⟩

def LateObserved {E State A Result : Type} (label : String) (action : MiddleM E State A) :
    MiddleM E (MiddleWorld E (State × Option Result)) A :=
  MiddleObserve label (LateCarry action)

def LateObservedInfo {E State A Result : Type} (label : String) (info : A → String)
    (action : MiddleM E State A) :
    MiddleM E (MiddleWorld E (State × Option Result)) A :=
  MiddleObserveInfo label info (LateCarry action)

def LateReturned {E State Result : Type} (label : String) (action : MiddleM E State Result) :
    MiddleM E (MiddleWorld E (State × Option Result)) Result :=
  MiddleObserve label (LateCapture action)

def LateFinalResult {E State Result : Type}
    (observation : Option (Except (E × MiddleWorld E (State × Option Result))
      (Result × MiddleWorld E (State × Option Result)))) : Prop :=
  match observation with
  | some (.ok (result, ((_, receipt), _))) => receipt = some result
  | _ => True

def LateAudit {E State Result : Type}
    (path : List String) (localError : E → List String → Prop) (state : State)
    (observation : Option (Except (E × MiddleWorld E (State × Option Result))
      (Result × MiddleWorld E (State × Option Result)))) : Prop :=
  MiddleAudit (MiddleOnePath path) localError (state, none) observation ∧
    LateFinalResult observation

/-- An independently recorded argument classification on every successful
call with the label; a failing call is already checked by MiddleAudit. -/
def LateSuccessfulDetail {E State A : Type} (label expected : String)
    (observation : Option (Except (E × MiddleWorld E State) (A × MiddleWorld E State))) : Prop :=
  MiddleOutcomeCheck (fun _ history =>
    ∀ call ∈ history, call.label = label → call.failure = none → call.detail = expected) observation

def LateObserveParts {E State A Result : Type}
    (parts : ComponentOps (MiddleM E State) A) :
    ComponentOps (MiddleM E (MiddleWorld E (State × Option Result))) A where
  real := fun z => LateObserved "real" (parts.real z)
  imag := fun z => LateObserved "imag" (parts.imag z)

/-- The phase wrapper queries imaginary before real and makes exactly one
atan call, returning that call's actual result and preserving arbitrary getter
or atan failures and their final state.  No real-number approximation is assumed.
Invariant: base/complex.jl:651. -/
def LateAngleAudit : Prop :=
  ∀ (E State A Result : Type) (ops : AngleOps (MiddleM E State) A Result)
      (parts : ComponentOps (MiddleM E State) A) (z : Complex A) (state : State),
    LateAudit ["imag", "real", "atan"] MiddleNoLocalError state
      ((angleComplex
        ({ atan2 := fun y x => LateReturned "atan" (ops.atan2 y x) } :
          AngleOps (MiddleM E (MiddleWorld E (State × Option Result))) A Result)
        z (LateObserveParts parts)).run ((state, none), []))

def LateObserveLogBase {E State A Logged Real Converted Denominator Result : Type}
    (ops : LogBaseOps (MiddleM E State) A Logged Real Converted Denominator Result) :
    LogBaseOps (MiddleM E (MiddleWorld E (State × Option Result)))
      A Logged Real Converted Denominator Result where
  logarithm := fun z => LateObserved "complexLog" (ops.logarithm z)
  real := fun value => LateObserved "real" (ops.real value)
  oftype := fun value literal => LateObservedInfo "oftype" (fun _ => toString literal.val)
    (ops.oftype value literal)
  scalarLog := fun value => LateObserved "scalarLog" (ops.scalarLog value)
  divide := fun value denominator => LateReturned "divide" (ops.divide value denominator)

/-- Each logarithm base wrapper computes one logarithm, preserves the native
base literal at its conversion point, and returns the selected quotient's
actual result.  Every operation may mutate, throw, or diverge independently.
Invariant: base/complex.jl:695-702. -/
def LateLogarithmBasesAudit : Prop :=
  ∀ (E State A Logged Real Converted Denominator Result : Type)
      (ops : LogBaseOps (MiddleM E State) A Logged Real Converted Denominator Result)
      (z : Complex A) (state : State),
    let observed := LateObserveLogBase ops
    let decimal := (logarithm10Complex observed z).run ((state, none), [])
    let binary := (logarithm2Complex observed z).run ((state, none), [])
    let check := LateAudit ["complexLog", "real", "oftype", "scalarLog", "divide"]
      MiddleNoLocalError state
    check decimal ∧ LateSuccessfulDetail "oftype" "10" decimal ∧
    check binary ∧ LateSuccessfulDetail "oftype" "2" binary

/-- Classify the runtime Real/Complex embedding, without coercing values. -/
def LatePowerTag {A : Type} : RealOrComplex A (Complex A) → String
  | .real _ => "real"
  | .complex _ => "complex"

def LateObserveCPow {E State A Result : Type} (ops : CPowOps (MiddleM E State) A Result) :
    CPowOps (MiddleM E (MiddleWorld E (State × Option Result))) A Result where
  call := fun base exponent =>
    MiddleObserveInfo "cpow" (fun _ => LatePowerTag base ++ ":" ++ LatePowerTag exponent)
      (LateCapture (ops.call base exponent))

/-- All three same-type wrappers make exactly one selected _cpow call and
preserve the Real/Complex argument tags.  Result values, exceptions and mutation
are preserved without requiring any numerical promise from the helper.
Invariant: base/complex.jl:882-884. -/
def LateSameTypePowerAudit : Prop :=
  ∀ (E State A Result : Type) (ops : CPowOps (MiddleM E State) A Result)
      (z p : Complex A) (x n : A) (state : State),
    let observed := LateObserveCPow ops
    let both := (powerComplexComplex observed z p).run ((state, none), [])
    let exponent := (powerComplexRealSame observed z n).run ((state, none), [])
    let base := (powerRealComplexSame observed x p).run ((state, none), [])
    let check := LateAudit ["cpow"] MiddleNoLocalError state
    check both ∧ LateSuccessfulDetail "cpow" "complex:complex" both ∧
    check exponent ∧ LateSuccessfulDetail "cpow" "complex:real" exponent ∧
    check base ∧ LateSuccessfulDetail "cpow" "real:complex" base

def LateBooleanPowerResultCheck {E State A One : Type} (z : Complex A) (n : Bool)
    (observation : Option (Except (E × MiddleWorld E (State × Option One))
      (BooleanPowerResult A One × MiddleWorld E (State × Option One)))) : Prop :=
  match observation with
  | some (.ok (value, ((_, receipt), _))) =>
      if n then value = .original z ∧ receipt = none
      else ∃ one : One, receipt = some one ∧ value = .identity one
  | _ => True

/-- True exponent returns the original object without invoking one, including
when that selected method would throw or diverge.  False exponent calls one once
and retains its arbitrary result type, effects, exact exception and final state.
Invariant/documented Boolean exponent law: base/complex.jl:886,889-890. -/
def LateBooleanPowersAudit : Prop :=
  ∀ (E State A One : Type) (ops : BooleanPowerOps (MiddleM E State) A One)
      (z : Complex A) (n : Bool) (state : State),
    let observed : BooleanPowerOps (MiddleM E (MiddleWorld E (State × Option One))) A One :=
      { one := fun value => LateReturned "one" (ops.one value) }
    let check := fun observation =>
      MiddleAudit (MiddleOnePath (if n then [] else ["one"])) MiddleNoLocalError
        (state, none) observation ∧ LateBooleanPowerResultCheck z n observation
    check ((powerComplexBool observed z n).run ((state, none), [])) ∧
    check ((powerComplexFloatBool observed z n).run ((state, none), [])) ∧
    check ((powerComplexIntegerBool observed z n).run ((state, none), [])) ∧
    (powerComplexBool ops z true).run state = some (.ok (.original z, state)) ∧
    (powerComplexFloatBool ops z true).run state = some (.ok (.original z, state)) ∧
    (powerComplexIntegerBool ops z true).run state = some (.ok (.original z, state))

/-- The inherited Float64 one implementation is installed, so these closed
instances include every finite, infinite, signed-zero and NaN bit pattern.
The true branch preserves all bits; false produces +1 and positive zero.
Source: base/complex.jl:886,889; base/number.jl:405-406. -/
def LateBooleanPowersNative : Prop :=
  ∀ (z : ComplexF64) (n : Bool),
    let ops : BooleanPowerOps Id F64 ComplexF64 := { one := one_ComplexF64 }
    let check := fun (value : BooleanPowerResult F64 ComplexF64) =>
      match value with
      | .original original => n = true ∧ original = z
      | .identity one => n = false ∧
          one.re = F64.one ∧ F64.iszero one.im = true ∧ F64.signbit one.im = false
    check (powerComplexBool ops z n) ∧ check (powerComplexFloatBool ops z n)

def LateBooleanPowers : Prop := LateBooleanPowersAudit ∧ LateBooleanPowersNative

def LateExponentInfo {Integer Other : Type} : IntegerPowerExponent Integer Other → String
  | .recur _ => "recur"
  | .selectedOther _ => "selected"

def LateObserveIntegerPower {E State A Integer Other Result : Type}
    (ops : IntegerPowerOps E State A Integer Other Result) :
    IntegerPowerOps E (MiddleWorld E (State × Option Result)) A Integer Other Result where
  construct := fun n =>
    (LateObservedInfo "construct" LateExponentInfo
      (⟨ops.construct n⟩ : MiddleM E State (IntegerPowerExponent Integer Other))).run
  powerOther := fun z n =>
    (LateReturned "power" (⟨ops.powerOther z n⟩ : MiddleM E State Result)).run

/-- The selected distinct power call can occur only after zero or more actual
redispatches followed by a selected-target classification.  A final failing
constructor has no post-return classification. -/
def LateIntegerPowerRouting {E State Result : Type}
    (observation : Option (Except (E × MiddleWorld E State) (Result × MiddleWorld E State))) : Prop :=
  MiddleOutcomeCheck (fun _ history =>
    if (MiddleLabels history).contains "power" then
      ∃ count : Nat, MiddleDetails "construct" history = List.replicate count "recur" ++ ["selected"]
    else
      ∃ count : Nat, MiddleDetails "construct" history = List.replicate count "recur" ++ [""]) observation

/-- Every finite normal return has one or more constructors and one final
selected power call.  Constructor/power errors at arbitrary recursion depth
preserve the exact failure and state, and the selected return value is retained.
Invariant: base/complex.jl:887. -/
def LateIntegerPowerAudit : Prop :=
  ∀ (E State A Integer Other Result : Type)
      (ops : IntegerPowerOps E State A Integer Other Result)
      (z : Complex A) (n : Integer) (state : State),
    let observation := powerComplexInteger (LateObserveIntegerPower ops) z n ((state, none), [])
    MiddleAudit (fun labels => ∃ count : Nat,
      0 < count ∧ labels = List.replicate count "construct" ++ ["power"])
      MiddleNoLocalError (state, none) observation ∧
    LateIntegerPowerRouting observation ∧ LateFinalResult observation

/-- A custom constructor that always reselects this same fallback has no
finite normal or exceptional outcome.  No fuel bound, successful default, or
fabricated stack error is substituted for the source recursion.
Invariant: base/complex.jl:887; divergence in the partial-result runtime. -/
def LateIntegerPowerDivergence : Prop :=
  ∀ (E State A Integer Other Result : Type)
      (power : Complex A → Other → PartialResult E State Result)
      (z : Complex A) (n : Integer) (state : State),
    powerComplexInteger
      ({ construct := fun value current => some (.ok (.recur value, current))
         powerOther := power } : IntegerPowerOps E State A Integer Other Result)
      z n state = none

/-- An arbitrary finite number of redispatches terminates at the distinct
selected target, forwarding the original base and exponent and counting every
constructor exactly once.  The natural numbers here are observer state, not
Julia integer arithmetic or a fuel parameter in the model.
Invariant: base/complex.jl:887. -/
def LateIntegerPowerFiniteChains : Prop :=
  ∀ (E A Integer : Type) (z : Complex A) (n : Integer) (depth ticks : Nat),
    let ops : IntegerPowerOps E (Nat × Nat) A Integer Integer (Complex A × Integer) :=
      { construct := fun value (remaining, count) =>
          match remaining with
          | 0 => some (.ok (.selectedOther value, (0, count + 1)))
          | k + 1 => some (.ok (.recur value, (k, count + 1)))
        powerOther := fun base exponent state => some (.ok ((base, exponent), state)) }
    powerComplexInteger ops z n (depth, ticks) = some (.ok ((z, n), (0, ticks + depth + 1)))

/-- The same finite redispatch chain retains a terminal selected error and all
preceding state changes; no constructor or selected-power call occurs afterward.
Invariant: base/complex.jl:887. -/
def LateIntegerPowerFiniteErrors : Prop :=
  ∀ (E A Integer Result : Type) (error : E) (z : Complex A) (n : Integer) (depth ticks : Nat),
    let ops : IntegerPowerOps E (Nat × Nat) A Integer Integer Result :=
      { construct := fun value (remaining, count) =>
          match remaining with
          | 0 => some (.ok (.selectedOther value, (0, count + 1)))
          | k + 1 => some (.ok (.recur value, (k, count + 1)))
        powerOther := fun _ _ (remaining, count) => some (.error (error, (remaining, count + 1))) }
    powerComplexInteger ops z n (depth, ticks) = some (.error (error, (0, ticks + depth + 2)))

def LateIntegerPower : Prop := LateIntegerPowerAudit ∧ LateIntegerPowerDivergence ∧
  LateIntegerPowerFiniteChains ∧ LateIntegerPowerFiniteErrors

def LateObserveRotation {E State A Negative Built W I R NegR Result : Type}
    (ops : RotationOps (MiddleM E State) A Negative Built W I R NegR Result) :
    RotationOps (MiddleM E (MiddleWorld E (State × Option Result)))
      A Negative Built W I R NegR Result where
  negateInput := fun a => LateObserved "negateInput" (ops.negateInput a)
  constructInput := fun a b => LateObserved "constructInput" (ops.constructInput a b)
  transcendental := fun a => LateObserved "transcendental" (ops.transcendental a)
  imag := fun a => LateObserved "imagOutput" (ops.imag a)
  real := fun a => LateObserved "realOutput" (ops.real a)
  negateOutput := fun a => LateObserved "negateOutput" (ops.negateOutput a)
  constructOutput := fun a b => LateReturned "constructOutput" (ops.constructOutput a b)

/-- atan/asinh retain every selected input query, negation, construction and
transcendental call.  Imaginary output is queried before real output; the final
constructed value and every arbitrary failure/state are propagated unchanged.
Invariant: base/complex.jl:986-989,1024-1027. -/
def LateRotationAudit : Prop :=
  ∀ (E State A Negative Built W I R NegR Result : Type)
      (ops : RotationOps (MiddleM E State) A Negative Built W I R NegR Result)
      (parts : ComponentOps (MiddleM E State) A) (z : Complex A) (state : State),
    let observed := LateObserveRotation ops
    let components := LateObserveParts parts
    let check := LateAudit ["imag", "negateInput", "real", "constructInput", "transcendental",
      "imagOutput", "realOutput", "negateOutput", "constructOutput"] MiddleNoLocalError state
    check ((arctangentComplex observed z components).run ((state, none), [])) ∧
    check ((inverseHyperbolicSineComplex observed z components).run ((state, none), []))

def LateRoundInfo {Mode Keywords : Type} (modeInfo : Mode → String)
    (keywordInfo : Keywords → String) (mode : Mode) (keywords : Keywords) : String :=
  modeInfo mode ++ ":" ++ keywordInfo keywords

def LateObserveRound {E State A Mode Keywords Rounded Result : Type}
    (ops : RoundOps (MiddleM E State) A Mode Keywords Rounded Result)
    (modeInfo : Mode → String) (keywordInfo : Keywords → String) :
    RoundOps (MiddleM E (MiddleWorld E (State × Option Result))) A Mode Keywords Rounded Result where
  nearest := ops.nearest
  round := fun value mode keywords => LateObservedInfo "round"
    (fun _ => LateRoundInfo modeInfo keywordInfo mode keywords) (ops.round value mode keywords)
  construct := fun r i => LateReturned "construct" (ops.construct r i)

/-- Every successfully completed scalar round call received its corresponding
mode and the same original keyword bundle.  Arbitrary classifiers separate
values without any correctness law for scalar rounding. -/
def LateRoundArguments {E State Result Mode Keywords : Type}
    (modeInfo : Mode → String) (keywordInfo : Keywords → String)
    (rr ri : Mode) (keywords : Keywords)
    (observation : Option (Except (E × MiddleWorld E State) (Result × MiddleWorld E State))) : Prop :=
  MiddleOutcomeCheck (fun _ history =>
    let calls := history.filter (fun call => call.label == "round")
    (∀ first, calls.head? = some first → first.failure = none →
      first.detail = LateRoundInfo modeInfo keywordInfo rr keywords) ∧
    (∀ second, calls[1]? = some second → second.failure = none →
      second.detail = LateRoundInfo modeInfo keywordInfo ri keywords)) observation

/-- Rounding includes every mode and keyword bundle, with both argument defaults
observed.  Each component query precedes its own rounding call; construction
returns its actual value and no getter/callee failure is swallowed or reordered.
Invariant/docstring: base/complex.jl:1093-1126. -/
def LateRoundAudit : Prop :=
  ∀ (E State A Mode Keywords Rounded Result : Type)
      (ops : RoundOps (MiddleM E State) A Mode Keywords Rounded Result)
      (parts : ComponentOps (MiddleM E State) A)
      (modeInfo : Mode → String) (keywordInfo : Keywords → String)
      (z : Complex A) (rr ri : Mode) (keywords : Keywords) (state : State),
    let observed := LateObserveRound ops modeInfo keywordInfo
    let components := LateObserveParts parts
    let both := (roundComplex observed z rr ri keywords components).run ((state, none), [])
    let first := (roundComplex observed z rr (keywords := keywords) (parts := components)).run ((state, none), [])
    let defaults := (roundComplex observed z (keywords := keywords) (parts := components)).run ((state, none), [])
    let check := LateAudit ["real", "round", "imag", "round", "construct"] MiddleNoLocalError state
    check both ∧ LateRoundArguments modeInfo keywordInfo rr ri keywords both ∧
    check first ∧ LateRoundArguments modeInfo keywordInfo rr rr keywords first ∧
    check defaults ∧ LateRoundArguments modeInfo keywordInfo ops.nearest ops.nearest keywords defaults

/-- Componentwise float keeps selected getters, potentially type-changing
scalar conversion and final construction in source order; every arbitrary error
and the actual constructor result are retained.
Invariant: base/complex.jl:1130. -/
def LateFloatAudit : Prop :=
  ∀ (E State A B Result : Type) (ops : UnaryConstructOps (MiddleM E State) A B Result)
      (parts : ComponentOps (MiddleM E State) A) (z : Complex A) (state : State),
    LateAudit ["real", "float", "imag", "float", "construct"] MiddleNoLocalError state
      ((floatComplex
        ({ scalar := fun a => LateObserved "float" (ops.scalar a)
           construct := fun r i => LateReturned "construct" (ops.construct r i) } :
          UnaryConstructOps (MiddleM E (MiddleWorld E (State × Option Result))) A B Result)
        z (LateObserveParts parts)).run ((state, none), []))

/-- Native integer conversion yields finite Float64 coordinates, preserves
zero/nonzero classification and sign over all ten widths, and never raises an
exception.  The implementation uses the installed scalar conversion and
constructor rather than a numerical correctness premise.
Source: base/complex.jl:1130; doc/src/manual/conversion-and-promotion.md:26-35. -/
def LateFloatNative : Prop :=
  ∀ (t : IntTy) (z : Complex (JInt t)),
    let ops : UnaryConstructOps Jl (JInt t) F64 ComplexF64 :=
      { scalar := fun value => .ok (F64.ofJInt value)
        construct := fun r i => Complex_Real_Real (fun a b => .ok (a, b)) r i }
    match floatComplex ops z with
    | .ok value =>
        F64.isfinite value.re = true ∧ F64.isfinite value.im = true ∧
        (F64.iszero value.re = true ↔ z.re.val = 0) ∧
        (F64.iszero value.im = true ↔ z.im.val = 0) ∧
        F64.signbit value.re = decide (z.re.val < 0) ∧
        F64.signbit value.im = decide (z.im.val < 0)
    | .error _ => False

def LateFloat : Prop := LateFloatAudit ∧ LateFloatNative

def LateTypeParameterInfo {Parameter Rejected : Type} : TypeParameter Parameter Rejected → String
  | .admissible _ => "admissible"
  | .rejected _ => "rejected"

def LateBigTypeResult {E State Parameter Rejected : Type}
    (observation : Option (Except
      ((Error E) × MiddleWorld (Error E) (State × Option (TypeParameter Parameter Rejected)))
      (ComplexTy Parameter × MiddleWorld (Error E) (State × Option (TypeParameter Parameter Rejected))))) : Prop :=
  match observation with
  | none => True
  | some (.ok (target, ((_, receipt), _))) =>
      ∃ parameter, receipt = some (.admissible parameter) ∧ target = .complex parameter
  | some (.error (error, ((_, receipt), _))) =>
      match receipt with
      | none => True
      | some (.rejected _) => error = .typeError "Complex type parameter"
      | some (.admissible _) => False

def LateBigValueGate {E State Result : Type}
    (observation : Option (Except ((Error E) × MiddleWorld (Error E) State)
      (Result × MiddleWorld (Error E) State))) : Prop :=
  MiddleOutcomeCheck (fun outcome history =>
    if MiddleDetails "big" history = ["rejected"] then
      outcome = .error (.typeError "Complex type parameter") ∧ MiddleLabels history = ["big"]
    else if MiddleDetails "big" history = ["admissible"] then
      MiddleLabels history = ["big", "construct"]
    else True) observation

/-- Value epsilon queries and converts the real component before querying the
imaginary component, then calls hypot exactly once.  All selected results,
exceptions, mutations and runtime return types remain observable.
Invariant: base/complex.jl:1164. -/
def LateEpsilonValueAudit : Prop :=
  ∀ (E State A Epsilon Result : Type)
      (ops : EpsilonValueOps (MiddleM E State) A Epsilon Result)
      (parts : ComponentOps (MiddleM E State) A) (z : Complex A) (state : State),
    LateAudit ["real", "epsilon", "imag", "epsilon", "hypot"] MiddleNoLocalError state
      ((epsilonComplex
        ({ epsilon := fun value => LateObserved "epsilon" (ops.epsilon value)
           hypot := fun r i => LateReturned "hypot" (ops.hypot r i) } :
          EpsilonValueOps (MiddleM E (MiddleWorld E (State × Option Result))) A Epsilon Result)
        z (LateObserveParts parts)).run ((state, none), []))

/-- Type epsilon retains the native Int factor two, finishes the selected
square root before asking for epsilon, then returns the actual final product.
No positivity, purity or same-type assumption is imposed on custom methods.
Invariant: base/complex.jl:1166. -/
def LateEpsilonTypeAudit : Prop :=
  ∀ (E State T One Product Root Epsilon Result : Type)
      (ops : EpsilonTypeOps (MiddleM E State) T One Product Root Epsilon Result)
      (t : T) (state : State),
    let observation := (epsilonComplexType
      ({ one := fun target => LateObserved "one" (ops.one target)
         multiplyTwo := fun literal value => LateObservedInfo "multiplyTwo" (fun _ => toString literal.val)
           (ops.multiplyTwo literal value)
         sqrt := fun value => LateObserved "sqrt" (ops.sqrt value)
         epsilon := fun target => LateObserved "epsilon" (ops.epsilon target)
         multiply := fun root epsilon => LateReturned "multiply" (ops.multiply root epsilon) } :
        EpsilonTypeOps (MiddleM E (MiddleWorld E (State × Option Result)))
          T One Product Root Epsilon Result) t).run ((state, none), [])
    LateAudit ["one", "multiplyTwo", "sqrt", "epsilon", "multiply"] MiddleNoLocalError state observation ∧
    LateSuccessfulDetail "multiplyTwo" "2" observation

end JuliaLean.Proofs.base.complex.Models2Group9


