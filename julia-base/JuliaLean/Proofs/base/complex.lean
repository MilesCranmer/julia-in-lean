theorem intInvRatDivisionBounds {lo hi lo' hi' : Nat} {n m : Int} {d e : Nat}
    (hn : floatCheckRatBounds lo hi n d) (hm : floatCheckRatBounds lo' hi' m e) (hm0 : m ≠ 0) :
    floatCheckRatBounds (lo+hi') (hi+lo') (n*(e : Int)) (d*m.natAbs) := by
  have hmabs : 0 < m.natAbs := by omega
  refine ⟨Nat.mul_pos hn.1 hmabs, ?_, ?_⟩
  · rw [Int.natAbs_mul, Int.natAbs_natCast, Nat.pow_add]
    calc
      n.natAbs * e ≤ (d*2^hi)*e := Nat.mul_le_mul_right _ hn.2.1
      _ ≤ (d*2^hi)*(m.natAbs*2^lo') := Nat.mul_le_mul_left _ (hm.2.2 hm0)
      _ = d*m.natAbs*(2^hi*2^lo') := by simp only [Nat.mul_assoc, Nat.mul_comm, Nat.mul_left_comm]
  · intro hn0
    have hn0' : n ≠ 0 := by intro h; apply hn0; rw [h, Int.zero_mul]
    rw [Int.natAbs_mul, Int.natAbs_natCast, Nat.pow_add]
    calc
      d*m.natAbs ≤ (n.natAbs*2^lo)*m.natAbs := Nat.mul_le_mul_right _ (hn.2.2 hn0')
      _ ≤ (n.natAbs*2^lo)*(e*2^hi') := Nat.mul_le_mul_left _ hm.2.1
      _ = n.natAbs*e*(2^lo*2^hi') := by simp only [Nat.mul_assoc, Nat.mul_comm, Nat.mul_left_comm]

theorem intInvDivPositive {lo hi lo' hi' : Nat} {x y : F64}
    (hx : intInvBounds lo hi x) (hy : intInvBounds lo' hi' y)
    (hys : F64.signbit y = false) (hyz : F64.iszero y = false)
    (hl : lo+hi' ≤ 1021) (hh : hi+lo' ≤ 1022) :
    intInvBounds (lo+hi'+1) (hi+lo'+2) (F64.div x y) ∧
      (F64.iszero (F64.div x y) = true ↔ F64.iszero x = true) ∧
      F64.signbit (F64.div x y) = F64.signbit x := by
  have hnz : (F64.toRat y).1 ≠ 0 := by
    intro h
    have hz := (intInvRatZero y hy.1).mp h
    rw [hyz] at hz
    contradiction
  have hnpos : 0 < (F64.toRat y).1 := by
    have h := floatCheckPositiveNumerator y hys
    omega
  have he : 0 < ((F64.toRat y).2 : Int) := by have := hy.2.1; omega
  have hnumz : (F64.toRat x).1 * ((F64.toRat y).2 : Int) = 0 ↔ (F64.toRat x).1 = 0 := by
    rw [Int.mul_eq_zero]
    omega
  have hnums : decide ((F64.toRat x).1 * ((F64.toRat y).2 : Int) < 0) =
      decide ((F64.toRat x).1 < 0) := by
    apply decide_eq_decide.mpr
    constructor
    · intro h
      by_cases hn : (F64.toRat x).1 < 0
      · exact hn
      · have hp := Int.mul_nonneg (show 0 ≤ (F64.toRat x).1 by omega) (show 0 ≤ ((F64.toRat y).2 : Int) by omega)
        omega
    · intro h
      exact Int.mul_neg_of_neg_of_pos h he
  have hdiv : F64.div x y = F64.roundRat
      ((F64.toRat x).1*((F64.toRat y).2 : Int))
      ((F64.toRat x).2*(F64.toRat y).1.natAbs) (F64.signbit x) := by
    unfold F64.div
    simp only [finite_not_nan x hx.1, finite_not_nan y hy.1,
      finite_not_inf x hx.1, finite_not_inf y hy.1, hyz, hys,
      Bool.false_and, Bool.and_false, Bool.false_or, Bool.or_false,
      Bool.false_eq_true, ↓reduceIte, show ¬ ((F64.toRat y).1 < 0) by omega,
      Bool.bne_false]
  rw [hdiv]
  have hr := intInvRoundBounded _ _ (lo+hi') (hi+lo') (F64.signbit x)
    (intInvRatDivisionBounds hx.2 hy.2 hnz) hl hh
  refine ⟨hr.1, ?_, ?_⟩
  · rw [hr.2, hnumz, intInvRatZero x hx.1]
  · have hd : (F64.toRat x).2*(F64.toRat y).1.natAbs ≠ 0 := by
      have := Nat.mul_pos hx.2.1 (show 0 < (F64.toRat y).1.natAbs by omega)
      omega
    rw [(floatCheckRoundRatClass _ _ _ hd).2]
    split
    · rfl
    · rename_i h
      rw [hnums]
      exact intInvRatSign x hx.1 (by intro h0; apply h; rw [h0, Int.zero_mul])

theorem intInvDenominator (c d : F64) (hc : intInvBounds 1 130 c)
    (hd : intInvBounds 1 130 d) (hcn : F64.iszero c = false) :
    let den := F64.muladd c c (F64.mul d d)
    intInvBounds 4 265 den ∧ F64.iszero den = false ∧ F64.signbit den = false := by
  let z := F64.mul d d
  have hz : intInvBounds 3 262 z := (intInvMulBounded hd hd (by decide) (by decide)).1
  have hzs : F64.signbit z = false := (floatCheckSquareClass d).2 (finite_not_nan d hd.1)
  have hzn : 0 ≤ (F64.toRat z).1 := floatCheckPositiveNumerator z hzs
  have hcnz : (F64.toRat c).1 ≠ 0 := by
    intro h
    have hz := (intInvRatZero c hc.1).mp h
    rw [hcn] at hz
    contradiction
  have hsqn : 0 ≤ (F64.toRat c).1*(F64.toRat c).1 := by
    by_cases hs : 0 ≤ (F64.toRat c).1
    · exact Int.mul_nonneg hs hs
    · exact Int.mul_nonneg_of_nonpos_of_nonpos (by omega) (by omega)
  have hsqp : 0 < (F64.toRat c).1*(F64.toRat c).1 := by
    have hsqne : (F64.toRat c).1*(F64.toRat c).1 ≠ 0 := Int.mul_ne_zero hcnz hcnz
    omega
  have he : 0 < ((F64.toRat z).2 : Int) := by have := hz.2.1; omega
  have hnumpos : 0 < (F64.toRat c).1*(F64.toRat c).1*((F64.toRat z).2 : Int) +
      (F64.toRat z).1*(((F64.toRat c).2*(F64.toRat c).2 : Nat) : Int) := by
    have h1 := Int.mul_pos hsqp he
    have h2 := Int.mul_nonneg hzn (Int.natCast_nonneg ((F64.toRat c).2*(F64.toRat c).2))
    omega
  have hbcc : floatCheckRatBounds 3 262 ((F64.toRat c).1*(F64.toRat c).1)
      ((F64.toRat c).2*(F64.toRat c).2) :=
    floatCheckRatBoundsWeaken (floatCheckRatBoundsMul hc.2 hc.2) (by decide) (by decide)
  have hbn := floatCheckRatBoundsAdd hbcc hz.2 hsqn hzn
  have hden : F64.muladd c c z = F64.roundRat
      ((F64.toRat c).1*(F64.toRat c).1*((F64.toRat z).2 : Int) +
        (F64.toRat z).1*(((F64.toRat c).2*(F64.toRat c).2 : Nat) : Int))
      ((F64.toRat c).2*(F64.toRat c).2*(F64.toRat z).2) false := by
    unfold F64.muladd F64.fma
    simp only [finite_not_nan c hc.1, finite_not_nan z hz.1,
      finite_not_inf c hc.1, finite_not_inf z hz.1, Bool.false_and, Bool.and_false,
      Bool.false_or, Bool.or_false, Bool.false_eq_true, ↓reduceIte, bne_self_eq_false]
  change intInvBounds 4 265 (F64.muladd c c z) ∧
    F64.iszero (F64.muladd c c z) = false ∧ F64.signbit (F64.muladd c c z) = false
  rw [hden]
  have hr := intInvRoundBounded _ _ 3 263 false hbn (by decide) (by decide)
  refine ⟨hr.1, ?_, ?_⟩
  · apply Bool.eq_false_iff.mpr
    intro hz
    have := hr.2.mp hz
    omega
  · rw [(floatCheckRoundRatClass _ _ false (by have := hbn.1; omega)).2]
    simp only [show ¬ ((F64.toRat c).1*(F64.toRat c).1*((F64.toRat z).2 : Int) +
        (F64.toRat z).1*(((F64.toRat c).2*(F64.toRat c).2 : Nat) : Int) = 0) by omega,
      ↓reduceIte]
    apply decide_eq_false_iff_not.mpr
    omega
theorem intInvIntegerResult {t : IntTy} (z : Complex (JInt t))
    (hn : z.re.val ≠ 0 ∨ z.im.val ≠ 0) :
    ∃ w : ComplexF64, inverseInt z = .ok w ∧
      intInvBounds 267 136 w.re ∧ intInvBounds 267 136 w.im ∧
      (F64.iszero w.re = true ↔ z.re.val = 0) ∧
      (F64.iszero w.im = true ↔ z.im.val = 0) ∧
      F64.signbit w.re = decide (z.re.val < 0) ∧
      F64.signbit w.im = decide (0 ≤ z.im.val) := by
  let c := F64.ofJInt z.re
  let d := F64.ofJInt z.im
  let cd := if F64.lt (F64.abs d) (F64.abs c) then F64.abs c else F64.abs d
  let dc := if F64.lt (F64.abs d) (F64.abs c) then F64.abs d else F64.abs c
  let den := F64.muladd cd cd (F64.mul dc dc)
  have hc : intInvBounds 1 130 c := intInvIntegerBounds z.re
  have hd : intInvBounds 1 130 d := intInvIntegerBounds z.im
  have habsc := intInvAbsBounds hc
  have habsd := intInvAbsBounds hd
  have hcd : intInvBounds 1 130 cd := by dsimp only [cd]; split <;> assumption
  have hdc : intInvBounds 1 130 dc := by dsimp only [dc]; split <;> assumption
  have hcdhi : F64.toBits cd < 1152*2^52 := by
    dsimp only [cd]
    split
    · exact (intInvIntegerAbsBits z.re).1
    · exact (intInvIntegerAbsBits z.im).1
  have hrange : F64.le floatCheckLo cd = true ∧ F64.le cd floatCheckHi = true :=
    intInvSelectedRange z hn
  have hcdn : F64.iszero cd = false := by
    rw [iszero_f, Nat.mod_eq_of_lt (show F64.toBits cd < 2^63 by omega)]
    have hle := (intInvAbsCompare floatCheckLo cd (by decide) hcdhi).2.mp hrange.1
    have hlo : 0 < F64.toBits floatCheckLo := by decide
    omega
  obtain ⟨hden, hdenz, hdens⟩ := intInvDenominator cd dc hcd hdc hcdn
  have hre := intInvDivPositive hc hden hdens hdenz (by decide) (by decide)
  have him := intInvDivPositive (intInvNegBounds hd) hden hdens hdenz (by decide) (by decide)
  have hfast : inverseInt z = .ok ⟨F64.div c den, F64.div (F64.neg d) den⟩ := by
    unfold inverseInt inv_Complex_Integer float_Complex
    rw [floatCheckInverseBridge]
    have h := (invProperties_proven floatCheckLo floatCheckHi floatCheckSqrtLo floatCheckSqrtHi
      (by decide) (by decide) (by decide)).2.2.1 c d
      (finite_not_nan c hc.1) (finite_not_nan d hd.1)
    have hr : (F64.le floatCheckLo cd && F64.le cd floatCheckHi) = true := by
      rw [hrange.1, hrange.2]
      rfl
    exact (h hr).1
  refine ⟨⟨F64.div c den, F64.div (F64.neg d) den⟩, hfast, hre.1, him.1, ?_, ?_, ?_, ?_⟩
  · exact hre.2.1.trans (intInvIntegerAbsBits z.re).2.2
  · rw [him.2.1, JuliaLean.Proofs.base.complex.iszero_neg]
    exact (intInvIntegerAbsBits z.im).2.2
  · exact hre.2.2.trans (intInvIntegerSign z.re)
  · rw [him.2.2, Scalar.ProofsBits.signbit_neg, intInvIntegerSign z.im]
    by_cases h : z.im.val < 0
    · simp only [h, decide_true, Bool.not_true, show ¬ 0 ≤ z.im.val by omega, decide_false]
    · simp only [h, decide_false, Bool.not_false, show 0 ≤ z.im.val by omega, decide_true]

theorem Models1G19IntegerInverseFinite_proven : JuliaLean.Proofs.base.complex.Models1Group19.IntegerInverseFinite := by
  intro t z
  obtain ⟨w, hw⟩ := floatCheckInverseTotal (float_Complex F64.ofJInt z)
  change inverseInt z = .ok w at hw
  rw [hw]
  intro hn
  obtain ⟨v, hv, hvr, hvi, _, _, hsr, hsi⟩ := intInvIntegerResult z hn
  rw [hw] at hv
  cases Except.ok.inj hv
  exact ⟨hvr.1, hvi.1, hsr, hsi⟩
theorem intInvConvertSuccess {s : IntTy} (t : IntTy) (z : Complex (JInt s))
    (hr : FitsInt t z.re.val) (hi : FitsInt t z.im.val) :
    convertComplexInt t z = .ok ⟨⟨z.re.val, hr⟩, ⟨z.im.val, hi⟩⟩ := by
  dsimp only [FitsInt] at hr hi
  unfold convertComplexInt Complex_T_Complex constructTypedComplex
  simp only [real_Complex, imag_Complex, JInt.convert, hr, hi, and_self, ↓reduceDIte,
    bind, Except.bind, pure, Except.pure]

theorem intInvConvertFailure {s : IntTy} (t : IntTy) (z : Complex (JInt s))
    (h : ¬ (FitsInt t z.re.val ∧ FitsInt t z.im.val)) :
    convertComplexInt t z = .error (.inexactError t.name) := by
  unfold convertComplexInt Complex_T_Complex constructTypedComplex
  by_cases hr : FitsInt t z.re.val
  · have hi : ¬ FitsInt t z.im.val := fun hh => h ⟨hr, hh⟩
    dsimp only [FitsInt] at hr hi
    simp only [real_Complex, imag_Complex, JInt.convert, hr, hi, and_self, ↓reduceDIte,
      bind, Except.bind]
  · dsimp only [FitsInt] at hr
    simp only [real_Complex, imag_Complex, JInt.convert, hr, and_self, ↓reduceDIte,
      bind, Except.bind]

theorem Models1G19RealComplexIntegerDivision_proven :
    JuliaLean.Proofs.base.complex.Models1Group19.RealComplexIntegerDivision := by
  intro t s a z
  let r := IntTy.promote t s
  by_cases hfit : FitsInt r z.re.val ∧ FitsInt r z.im.val
  · let v : Complex (JInt r) := ⟨⟨z.re.val, hfit.1⟩, ⟨z.im.val, hfit.2⟩⟩
    have hconv : convertComplexInt r z = .ok v := intInvConvertSuccess r z hfit.1 hfit.2
    dsimp only [r] at hconv
    obtain ⟨w, hw⟩ := floatCheckInverseTotal (float_Complex F64.ofJInt v)
    change inverseInt v = .ok w at hw
    simp only [divideRealIntByComplexInt, hconv, bind, Except.bind, hw, pure, Except.pure]
    refine ⟨hfit.1, hfit.2, ?_⟩
    intro hn
    obtain ⟨q, hq, hqr, hqi, hqrz, hqiz, _, _⟩ := intInvIntegerResult v hn
    rw [hw] at hq
    cases Except.ok.inj hq
    have ha := intInvIntegerBounds a
    have hr := intInvMulBounded ha hqr (by decide) (by decide)
    have hi := intInvMulBounded ha hqi (by decide) (by decide)
    dsimp only [mul_Real_Complex, real_Complex, imag_Complex]
    refine ⟨hr.1.1, hi.1.1, ?_, ?_⟩
    · change F64.toBits (F64.mul (F64.ofJInt a) w.re) % 2^63 = 0 ↔ _
      rw [← iszero_iff, hr.2, (intInvIntegerAbsBits a).2.2, hqrz]
    · change F64.toBits (F64.mul (F64.ofJInt a) w.im) % 2^63 = 0 ↔ _
      rw [← iszero_iff, hi.2, (intInvIntegerAbsBits a).2.2, hqiz]
  · have hconv := intInvConvertFailure r z hfit
    dsimp only [r] at hconv
    simp only [divideRealIntByComplexInt, hconv, bind, Except.bind]
    exact hfit

