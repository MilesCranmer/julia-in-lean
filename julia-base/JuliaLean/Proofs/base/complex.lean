inherited isreal's selected imag call.  Invariant: base/complex.jl:150. -/
def IntegerComplexSelectedGetters : Prop :=
  ∀ (E State A Other : Type) (parts : ComponentOps (MiddleM E State) A)
      (ops : PredicateOps (MiddleM E State) A Other) (z : Complex A) (state : State),
    EarlyGetterPredicateAudit (fun ops z parts => integerComplex ops z parts) false
      (EarlyGetterIsRealPrefix ops.isreal ++ ["real", "isinteger"]) parts ops z state

/-- Both arbitrary component queries and finite predicates are eager.
Invariant: base/complex.jl:151. -/
def FiniteComplexSelectedGetters : Prop :=
  ∀ (E State A Other : Type) (parts : ComponentOps (MiddleM E State) A)
      (ops : PredicateOps (MiddleM E State) A Other) (z : Complex A) (state : State),
    EarlyGetterPredicateAudit (fun ops z parts => finiteComplex ops z parts) false
      ["real", "isfinite", "imag", "isfinite"] parts ops z state

/-- NaN queries preserve selected getters even after a true first predicate.
Invariant: base/complex.jl:152. -/
def NaNComplexSelectedGetters : Prop :=
  ∀ (E State A Other : Type) (parts : ComponentOps (MiddleM E State) A)
      (ops : PredicateOps (MiddleM E State) A Other) (z : Complex A) (state : State),
    EarlyGetterPredicateAudit (fun ops z parts => nanComplex ops z parts) true
      ["real", "isnan", "imag", "isnan"] parts ops z state

/-- Infinity queries preserve selected getter mutation and failure.
Invariant: base/complex.jl:153. -/
def InfiniteComplexSelectedGetters : Prop :=
  ∀ (E State A Other : Type) (parts : ComponentOps (MiddleM E State) A)
      (ops : PredicateOps (MiddleM E State) A Other) (z : Complex A) (state : State),
    EarlyGetterPredicateAudit (fun ops z parts => infiniteComplex ops z parts) true
      ["real", "isinf", "imag", "isinf"] parts ops z state

/-- Zero classification includes both selected component-query outcomes.
Invariant: base/complex.jl:154. -/
def ZeroComplexSelectedGetters : Prop :=
  ∀ (E State A Other : Type) (parts : ComponentOps (MiddleM E State) A)
      (ops : PredicateOps (MiddleM E State) A Other) (z : Complex A) (state : State),
    EarlyGetterPredicateAudit (fun ops z parts => zeroComplex ops z parts) false
      ["real", "iszero", "imag", "iszero"] parts ops z state

/-- One classification retains separate one/zero tests and selected queries.
Invariant: base/complex.jl:155. -/
def OneComplexSelectedGetters : Prop :=
  ∀ (E State A Other : Type) (parts : ComponentOps (MiddleM E State) A)
      (ops : PredicateOps (MiddleM E State) A Other) (z : Complex A) (state : State),
