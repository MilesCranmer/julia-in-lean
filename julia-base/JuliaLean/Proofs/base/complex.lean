      (SmallExact.signed (F64.signbit x) (F64.fraction x) * ((2^1074 : Nat) : Int) -
       SmallExact.signed (F64.signbit x) (F64.fraction y) * ((2^1074 : Nat) : Int))
      (2^1074*2^1074) (F64.signbit x && !F64.signbit x)) = _
