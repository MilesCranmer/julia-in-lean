    ((F64.toRat x).2 * 2^52) (F64.signbit x != false) = x
  have hs : (F64.signbit x != false) = F64.signbit x := by cases F64.signbit x <;> rfl
  rw [hs]
  exact hr64

theorem floatCheckEpsilonDivNotInf (x : F64) :
    F64.isinf (F64.div (F64.abs (F64.eps x)) F64.one) = false := by
  cases hx : F64.isfinite x with
