    rw [fma_key_round _ _ _ (neg_fin b bfin) bfin hDiff, key_neg, bkey, kDiff]
    have hpowb : ipow (p-d+1074).toNat*ipow (p-d+1074).toNat =
        ipow (104-2*d)*ipow (U+1074) := ipow_product _ _ _ _ (by omega)
    have hpowd : ipow (2*p+1022).toNat*ipow 1074 = ipow 52*ipow (U+1074) :=
      ipow_product _ _ _ _ (by omega)
    have heq : -ipow (p-d+1074).toNat*ipow (p-d+1074).toNat+
        ((cert.A : Int)*ipow (2*p+1022).toNat)*ipow 1074 = cert.V*ipow (U+1074) := by
      rw [Int.neg_mul, hpowb, Int.mul_assoc (cert.A : Int), hpowd, ← Int.mul_assoc]
      rw [cert.veq]
