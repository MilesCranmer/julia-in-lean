theorem intInvInputBound {t : IntTy} (x : JInt t) : x.val.natAbs < 2^128 := by
  have hl := x.property.1
  have hu := x.property.2
  cases t <;> simp only [IntTy.min, IntTy.max, IntTy.bits, IntTy.signed,
    Bool.false_eq_true, ↓reduceIte] at hl hu <;>
    rcases Int.natAbs_eq x.val with h | h <;> omega

theorem intInvAbsOfSignFalse (x : F64) (hs : F64.signbit x = false) : F64.abs x = x := by
  apply f64_ext
  rw [tb_abs, Nat.mod_eq_of_lt ((signbit_f x).mp hs)]

theorem intInvOfIntAbs (n : Int) (hn : n.natAbs < 2^128) :
    F64.abs (F64.ofInt n) = F64.roundRat (n.natAbs : Int) 1 false := by
  have habs := intInvAbsOfSignFalse _ (roundRat_nat64_finite_sign n.natAbs hn).2
  rcases Int.natAbs_eq n with h | h
  · exact (congrArg (fun v : Int => F64.abs (F64.roundRat v 1 false)) h).trans habs
  · exact (congrArg (fun v : Int => F64.abs (F64.roundRat v 1 false)) h).trans
      ((abs_roundRat_neg _ _ false false).trans habs)

theorem intInvPackedBits (q : Nat) (k : Int) (hqlo : 2^52 ≤ q) (hqhi : q ≤ 2^53)
    (hklo : -52 ≤ k) (hkhi : k ≤ 75) :
    1023*2^52 ≤ F64.toBits (pk false q k) ∧
      F64.toBits (pk false q k) < 1152*2^52 := by
  by_cases hq : q < 2^53
  · rw [pk_norm false q k hqlo hq (by omega) (by omega)]
    simp only [Bool.false_eq_true, ↓reduceIte, Nat.zero_add, tb_ofBits]
    have hElo : 1023 ≤ (k+1075).toNat := by omega
    have hEhi : (k+1075).toNat ≤ 1150 := by omega
    omega
  · have heq : q = 2^53 := by omega
    subst q
    have hpk : pk false (2^53) k = F64.ofBits ((k+1076).toNat*2^52) := by
      unfold pk
      simp only [show (2^53 == 0) = false by decide, Bool.false_eq_true, ↓reduceIte,
        Nat.le_refl, show 2^53/2 = 2^52 by decide,
        show ¬ (k+1+1075 ≥ 2047) by omega, Nat.lt_irrefl, Nat.sub_self, Nat.add_zero,
        Nat.zero_add]
      congr 2
      omega
    rw [hpk, tb_ofBits]
    have hElo : 1024 ≤ (k+1076).toNat := by omega
    have hEhi : (k+1076).toNat ≤ 1151 := by omega
    omega

theorem intInvNatBits (n : Nat) (hn0 : n ≠ 0) (hn : n < 2^128) :
    1023*2^52 ≤ F64.toBits (F64.roundRat (n : Int) 1 false) ∧
      F64.toBits (F64.roundRat (n : Int) 1 false) < 1152*2^52 := by
  have hlog : n.log2 ≤ 127 := by have := (Nat.log2_lt hn0).mpr hn; omega
  rw [roundRat_nat64_normal n (by omega) (by omega)]
  have hq := rounded_nat_significand_bounds n (by omega)
  exact intInvPackedBits _ _ hq.1 hq.2 (by omega) (by omega)

theorem intInvIntegerAbsBits {t : IntTy} (x : JInt t) :
    F64.toBits (F64.abs (F64.ofJInt x)) < 1152*2^52 ∧
      (x.val ≠ 0 → 1023*2^52 ≤ F64.toBits (F64.abs (F64.ofJInt x))) ∧
      (F64.iszero (F64.ofJInt x) = true ↔ x.val = 0) := by
  rw [intNearestOfJInt_eq, intInvOfIntAbs _ (intInvInputBound x)]
  by_cases hz : x.val = 0
  · simp only [hz, Int.natAbs_zero]
    exact ⟨by decide, fun h => False.elim (h rfl), by decide⟩
  · have hh := intInvNatBits x.val.natAbs (by omega) (intInvInputBound x)
    refine ⟨hh.2, fun _ => hh.1, ?_⟩
    rw [iszero_iff, ← tb_abs, intInvOfIntAbs _ (intInvInputBound x)]
    constructor
    · intro h
      omega
    · intro h
      exact False.elim (hz h)

theorem intInvAbsCompare (x y : F64) (hx : F64.toBits x < 1152*2^52)
    (hy : F64.toBits y < 1152*2^52) :
    (F64.lt x y = true ↔ F64.toBits x < F64.toBits y) ∧
      (F64.le x y = true ↔ F64.toBits x ≤ F64.toBits y) := by
  have hnx : F64.isnan x = false := by rw [isnan_f]; omega
  have hny : F64.isnan y = false := by rw [isnan_f]; omega
  have hsx : F64.signbit x = false := (signbit_f x).mpr (by omega)
  have hsy : F64.signbit y = false := (signbit_f y).mpr (by omega)
  constructor
  · rw [lt_iff]
    omega
  · unfold F64.le
    simp only [Bool.or_eq_true, lt_iff, eq_iff]
    omega

theorem intInvRangeBits (x : F64) (hxlo : 1023*2^52 ≤ F64.toBits x)
    (hxhi : F64.toBits x < 1152*2^52) :
    F64.le floatCheckLo x = true ∧ F64.le x floatCheckHi = true := by
  have hx : F64.toBits x < 2^64 := tb_lt x
  unfold F64.le
  simp only [Bool.or_eq_true, lt_iff, eq_iff]
  change (_ ∨ _) ∧ (_ ∨ _)
  have hl : F64.toBits floatCheckLo = 0x1ff6a09e667f3bcd := by decide
  have hh : F64.toBits floatCheckHi = 0x5fe6a09e667f3bcc := by decide
  rw [hl, hh]
  constructor <;> left <;> omega

theorem intInvSelectedRange {t : IntTy} (z : Complex (JInt t))
    (hn : z.re.val ≠ 0 ∨ z.im.val ≠ 0) :
    let c := F64.ofJInt z.re
    let d := F64.ofJInt z.im
    let cd := if F64.lt (F64.abs d) (F64.abs c) then F64.abs c else F64.abs d
    F64.le floatCheckLo cd = true ∧ F64.le cd floatCheckHi = true := by
  dsimp only
  have hc := intInvIntegerAbsBits z.re
  have hd := intInvIntegerAbsBits z.im
  by_cases hlt : F64.lt (F64.abs (F64.ofJInt z.im)) (F64.abs (F64.ofJInt z.re)) = true
  · simp only [hlt, ↓reduceIte]
    apply intInvRangeBits _ ?_ hc.1
    have hh := (intInvAbsCompare _ _ hd.1 hc.1).1.mp hlt
    rcases hn with hn | hn
    · exact hc.2.1 hn
    · have := hd.2.1 hn
      omega
  · simp only [hlt, ↓reduceIte]
    apply intInvRangeBits _ ?_ hd.1
    have hh : F64.toBits (F64.abs (F64.ofJInt z.re)) ≤ F64.toBits (F64.abs (F64.ofJInt z.im)) := by
      have ht := mt (intInvAbsCompare _ _ hd.1 hc.1).1.mpr hlt
      omega
    rcases hn with hn | hn
    · have := hc.2.1 hn
      omega
    · exact hd.2.1 hn
def intInvBounds (lo hi : Nat) (x : F64) : Prop :=
  F64.isfinite x = true ∧ floatCheckRatBounds lo hi (F64.toRat x).1 (F64.toRat x).2

theorem intInvZeroBounds (lo hi : Nat) (s : Bool) : intInvBounds lo hi (F64.zero s) := by
  refine ⟨by cases s <;> decide, ?_⟩
  rw [Scalar.ProofsBits.toRat_zero]
  refine ⟨Nat.two_pow_pos _, ?_, ?_⟩
  · exact Nat.zero_le _
  · intro h
    exact False.elim (h rfl)

theorem intInvRoundBounded (n : Int) (d lo hi : Nat) (s : Bool)
    (hb : floatCheckRatBounds lo hi n d) (hl : lo ≤ 1021) (hh : hi ≤ 1022) :
    intInvBounds (lo+1) (hi+2) (F64.roundRat n d s) ∧
      (F64.iszero (F64.roundRat n d s) = true ↔ n = 0) := by
  by_cases hz : n = 0
  · have hd : (d == 0) = false := beq_eq_false_iff_ne.mpr (by have := hb.1; omega)
    have hr : F64.roundRat n d s = F64.zero s := by
      rw [roundRat_eq]
      simp only [hd, hz, Bool.false_eq_true, beq_self_eq_true, ↓reduceIte]
    rw [hr]
    refine ⟨intInvZeroBounds _ _ s, ?_⟩
    have hs : F64.iszero (F64.zero s) = true := by cases s <;> decide
    simp only [hs, hz]
  · have hfloor := floatCheckFloorLogBounds n.natAbs d lo hi (by omega)
      (by have := hb.1; omega) (hb.2.2 hz) hb.2.1
    have hr := floatCheckFlRoundRatBounded double n d lo hi s hb
      (by change lo+2 ≤ 1023; omega) (by change hi+1023+1 < 2047; omega)
    rw [← floatCheckFlToF64RoundRat n d s (by omega)]
    unfold intInvBounds
    rw [(floatCheckFlToF64Classes (Fl.roundRat n d s : Fl double)).1,
      floatCheckFlToF64Rat,
      (floatCheckFlToF64Classes (Fl.roundRat n d s : Fl double)).2.2.1]
    exact hr

theorem intInvRatZero (x : F64) (hx : F64.isfinite x = true) :
    (F64.toRat x).1 = 0 ↔ F64.iszero x = true := by
  have h := floatCheckFlRatZeroIff double (Fl.ofF64 x)
    ((floatCheckFlOfF64Classes x).1.trans hx)
  rw [floatCheckFlOfF64Rat, (floatCheckFlOfF64Classes x).2.2.1] at h
  exact h

theorem intInvRatSign (x : F64) (hx : F64.isfinite x = true) (hn : (F64.toRat x).1 ≠ 0) :
    decide ((F64.toRat x).1 < 0) = F64.signbit x := by
  have h := floatCheckFlRatSign double (Fl.ofF64 x)
    ((floatCheckFlOfF64Classes x).1.trans hx)
    (by rw [floatCheckFlOfF64Rat]; exact hn)
  rw [floatCheckFlOfF64Rat, (floatCheckFlOfF64Classes x).2.2.2.1] at h
  exact h

theorem intInvIntegerBounds {t : IntTy} (x : JInt t) : intInvBounds 1 130 (F64.ofJInt x) := by
  rw [intNearestOfJInt_eq]
  apply (intInvRoundBounded x.val 1 0 128 false ?_ (by decide) (by decide)).1
  refine ⟨by decide, ?_, ?_⟩
  · simp only [Nat.one_mul]
    exact Nat.le_of_lt (intInvInputBound x)
  · intro hz
    simp only [Nat.pow_zero, Nat.mul_one]
    omega

