theorem round_cross (n m : Int) (i j : Nat) (s : Bool)
    (h : n*((2^j : Nat) : Int) = m*((2^i : Nat) : Int)) :
    F64.roundRat n (2^i) s = F64.roundRat m (2^j) s := by
  rw [← Epsilon.round_scale n (2^i) j s (Nat.ne_of_gt (Nat.two_pow_pos _)), h,
    Nat.mul_comm (2^i) (2^j),
    Epsilon.round_scale m (2^j) i s (Nat.ne_of_gt (Nat.two_pow_pos _))]

theorem log_mantissa (m : Nat) (hlo : 2^52 ≤ m) (hhi : m < 2^53) : m.log2 = 52 := by
  have hn : m ≠ 0 := by omega
  have hh := (Nat.log2_lt hn).mpr hhi
  have hl : ¬ m.log2 < 52 := by
    intro h
    exact (Nat.not_lt_of_ge hlo) ((Nat.log2_lt hn).mp h)
  omega

theorem log_mantissa_le (m : Nat) (hlo : 2^52 ≤ m) (hhi : m ≤ 2^53) :
    52 ≤ m.log2 ∧ m.log2 ≤ 53 := by
  have hn : m ≠ 0 := by omega
  have hh := (Nat.log2_lt hn).mpr (show m < 2^54 by omega)
  have hl : ¬ m.log2 < 52 := by
    intro h
    exact (Nat.not_lt_of_ge hlo) ((Nat.log2_lt hn).mp h)
  omega

theorem normal_rat (p : Int) (m : Nat) (hp0 : -511 ≤ p) (hp1 : p ≤ 511)
    (hm0 : 2^52 ≤ m) (hm1 : m < 2^53) :
    let h := F64.ofBits ((p+1023).toNat*2^52+(m-2^52))
    F64.isfinite h = true ∧ F64.signbit h = false ∧
      ∃ i j : Nat, F64.toRat h = (((m*2^i : Nat) : Int),2^j) ∧
        (i : Int)-(j : Int) = p-52 := by
  dsimp only
  let e := (p+1023).toNat
  let x := F64.ofBits (e*2^52+(m-2^52))
  have he1 : 1 ≤ e := by dsimp only [e]; omega
  have he2 : e ≤ 2046 := by dsimp only [e]; omega
  have heI : (e : Int) = p+1023 := by dsimp only [e]; omega
  have hb : F64.toBits x = e*2^52+(m-2^52) := by
    change F64.toBits (F64.ofBits _) = _
    rw [tb_ofBits, Nat.mod_eq_of_lt (by omega)]
  have hE : F64.toBits x / 2^52 % 2048 = e := by rw [hb]; omega
  have hM : F64.toBits x % 2^52+2^52 = m := by rw [hb]; omega
  have hs : F64.signbit x = false := by rw [signbit_f, hb]; omega
  have hf : F64.isfinite x = true := by
    simp only [F64.isfinite, F64.exponentField, hE, bne_iff_ne]; omega
  refine ⟨hf, hs, ?_⟩
  by_cases hsmall : e ≤ 1074
  · refine ⟨0,1075-e,?_,by omega⟩
    change F64.toRat x = _
    rw [toRat_norm x (by rw [hE]; exact he1) (by rw [hE]; exact hsmall), hM, hE, hs]
    simp only [Bool.false_eq_true, ↓reduceIte, Nat.pow_zero, Nat.mul_one]
  · refine ⟨e-1075,0,?_,by omega⟩
    change F64.toRat x = _
    rw [toRat_big x (by rw [hE]; omega) (by rw [hE]; omega), hM, hE, hs]
    simp only [Bool.false_eq_true, ↓reduceIte, Int.natCast_mul, Nat.pow_zero]

theorem product_normal_power (a t : Int) (m : Nat) (ha0 : -511 ≤ a) (ha1 : a ≤ 511)
    (ht0 : -1074 ≤ t) (ht1 : t ≤ 1023) (hm0 : 2^52 ≤ m) (hm1 : m < 2^53) :
    ∃ i j : Nat, (i : Int)-(j : Int) = a+t-52 ∧
      F64.mul (F64.ofBits ((a+1023).toNat*2^52+(m-2^52))) (power t) =
        F64.roundRat ((m*2^i : Nat) : Int) (2^j) false := by
  obtain ⟨hf, hs, i, j, hr, he⟩ := normal_rat a m ha0 ha1 hm0 hm1
  obtain ⟨tf, ts, tz, tn, ti⟩ := power_classes t ht0 ht1
  obtain ⟨u,v, tr,te⟩ := power_rat t ht0 ht1
  refine ⟨i+u,j+v,by omega,?_⟩
  rw [mul_fin _ _ (Scalar.ProofMisc.finite_not_nan _ hf) tn
    (Scalar.ProofMisc.finite_not_inf _ hf) ti, hr, tr, hs, ts]
  simp only [Prod.fst, Prod.snd, bne_self_eq_false]
  rw [← Int.natCast_mul, Nat.mul_assoc, ← Nat.pow_add, ← Nat.pow_add]

theorem bits_rat_le (x y : F64) (hxf : F64.isfinite x = true) (hyf : F64.isfinite y = true)
    (hxs : F64.signbit x = false) (hys : F64.signbit y = false)
    (hb : F64.toBits x % 2^63 ≤ F64.toBits y % 2^63) :
    RatLessEqual (Epsilon.rat x) (Epsilon.rat y) := by
  apply (key64_order x y hxf hyf).mpr
  apply (key64_code_order x y).mpr
  simp only [code64, hxs, hys, Bool.false_eq_true, ↓reduceIte]
  exact Int.ofNat_le.mpr hb

theorem round_mantissa_classes (p : Int) (m i j : Nat)
    (hp0 : -1074 ≤ p) (hp1 : p ≤ 971) (hm0 : 2^52 ≤ m) (hm1 : m ≤ 2^53)
    (he : (i : Int)-(j : Int) = p-52) :
    let r := F64.roundRat ((m*2^i : Nat) : Int) (2^j) false
    F64.isfinite r = true ∧ F64.signbit r = false := by
  dsimp only
  have hmpos : 0 < m := by omega
  have hnpos : 0 < m*2^i := Nat.mul_pos hmpos (Nat.two_pow_pos _)
  have hl := log_mantissa_le m hm0 hm1
  have hf : fl2 (((m*2^i : Nat) : Int)).natAbs (2^j) = ((m.log2+i : Nat) : Int)-(j : Int) := by
    rw [Int.natAbs_natCast, fl2_pow m i j hmpos]
  have hgrid := Scalar.RoundMono.round_grid ((m*2^i : Nat) : Int) (2^j) false
    (by omega) (Nat.two_pow_pos _) (by rw [hf]; omega) (by rw [hf]; omega)
  refine ⟨hgrid.1, ?_⟩
  have hs := (floatCheckRoundRatClass ((m*2^i : Nat) : Int) (2^j) false
    (Nat.ne_of_gt (Nat.two_pow_pos _))).2
  rw [ite_f (by omega), decide_eq_false (by omega)] at hs
  exact hs

theorem round_mantissa_order (p : Int) (m n i j : Nat)
    (hp0 : -1074 ≤ p) (hp1 : p ≤ 971)
    (hm0 : 2^52 ≤ m) (hm1 : m ≤ 2^53) (hn0 : 2^52 ≤ n) (hn1 : n ≤ 2^53)
    (he : (i : Int)-(j : Int) = p-52) (hmn : m ≤ n) :
    RatLessEqual (Epsilon.rat (F64.roundRat ((m*2^i : Nat) : Int) (2^j) false))
      (Epsilon.rat (F64.roundRat ((n*2^i : Nat) : Int) (2^j) false)) := by
  have hcM := round_mantissa_classes p m i j hp0 hp1 hm0 hm1 he
  have hcN := round_mantissa_classes p n i j hp0 hp1 hn0 hn1 he
  apply bits_rat_le _ _ hcM.1 hcN.1 hcM.2 hcN.2
  have hlM := log_mantissa_le m hm0 hm1
  have hlN := log_mantissa_le n hn0 hn1
  have hfM : fl2 (((m*2^i : Nat) : Int)).natAbs (2^j) = ((m.log2+i : Nat) : Int)-(j : Int) := by
    rw [Int.natAbs_natCast, fl2_pow m i j (by omega)]
  have hfN : fl2 (((n*2^i : Nat) : Int)).natAbs (2^j) = ((n.log2+i : Nat) : Int)-(j : Int) := by
    rw [Int.natAbs_natCast, fl2_pow n i j (by omega)]
  apply Scalar.RoundMono.round_magnitude_monotone _ _ _ _ _ _
  · have := Nat.mul_pos (show 0 < m by omega) (Nat.two_pow_pos i); omega
  · have := Nat.mul_pos (show 0 < n by omega) (Nat.two_pow_pos i); omega
  · exact Nat.two_pow_pos _
  · exact Nat.two_pow_pos _
  · rw [hfM]; omega
  · rw [hfM]; omega
  · rw [hfN]; omega
  · rw [hfN]; omega
  · simp only [Int.natAbs_natCast]
    exact Nat.mul_le_mul_right _ (Nat.mul_le_mul_right _ hmn)

theorem mul_one (x : F64) (hx : F64.isfinite x = true) : F64.mul x F64.one = x := by
  rw [mul_fin x F64.one (Scalar.ProofMisc.finite_not_nan x hx) (by decide)
    (Scalar.ProofMisc.finite_not_inf x hx) (by decide)]
  change F64.roundRat ((F64.toRat x).1*((2^52 : Nat) : Int))
    ((F64.toRat x).2*2^52) (F64.signbit x != false) = x
  have hs : (F64.signbit x != false) = F64.signbit x := by cases F64.signbit x <;> rfl
  rw [hs, Epsilon.round_scale _ _ _ _ (Nat.ne_of_gt (toRat_den_pos x hx)), roundRat_toRat x hx]

theorem rat_trans (a b c : Int × Int) (ha : 0 < a.2) (hb : 0 < b.2) (hc : 0 < c.2)
    (hab : RatLessEqual a b) (hbc : RatLessEqual b c) : RatLessEqual a c := by
  have h1 := Int.mul_le_mul_of_nonneg_right hab (Int.le_of_lt hc)
  have h2 := Int.mul_le_mul_of_nonneg_right hbc (Int.le_of_lt ha)
  change (a.1*b.2)*c.2 ≤ (b.1*a.2)*c.2 at h1
  change (b.1*c.2)*a.2 ≤ (c.1*b.2)*a.2 at h2
  have h : (a.1*c.2)*b.2 ≤ (c.1*a.2)*b.2 := by
    calc
      (a.1*c.2)*b.2 = (a.1*b.2)*c.2 := Int.mul_right_comm _ _ _
      _ ≤ (b.1*a.2)*c.2 := h1
      _ = (b.1*c.2)*a.2 := Int.mul_right_comm _ _ _
      _ ≤ (c.1*b.2)*a.2 := h2
      _ = (c.1*a.2)*b.2 := Int.mul_right_comm _ _ _
  exact (int_le_cancel_positive hb).mp h

theorem lower_round (p : Int) (i j : Nat) (hp0 : -1074 ≤ p) (hp1 : p ≤ 971)
    (he : (i : Int)-(j : Int) = p-52) :
    F64.roundRat (((2^52*2^i : Nat)) : Int) (2^j) false = power p := by
  rw [← Nat.pow_add]
  exact round_power (52+i) j p (by omega) hp0 (by omega) false

theorem lower_bound (p : Int) (d i j : Nat) (hp0 : -1074 ≤ p) (hp1 : p ≤ 971)
    (hq0 : -1074 ≤ p-(d : Int)) (hd : d ≤ 26)
    (he : (i : Int)-(j : Int) = p-52) :
    let r := F64.roundRat ((coefficient d*2^i : Nat) : Int) (2^j) false
    F64.isfinite r = true ∧ F64.signbit r = false ∧
      RatLessEqual (Epsilon.rat (power p)) (Epsilon.rat r) ∧
      RatLessEqual (Epsilon.rat (power (p-(d : Int)))) (Epsilon.rat r) := by
  dsimp only
  have hm := coefficient_bounds d hd
  have hc := round_mantissa_classes p (coefficient d) i j hp0 hp1 hm.1 (by omega) he
  have hl := round_mantissa_order p (2^52) (coefficient d) i j hp0 hp1
    (by decide) (by decide) hm.1 (by omega) he hm.1
  rw [lower_round p i j hp0 hp1 he] at hl
  refine ⟨hc.1,hc.2,hl,?_⟩
  have hp := power_classes p hp0 (by omega)
  have hq := power_classes (p-(d : Int)) hq0 (by omega)
  have hqp : RatLessEqual (Epsilon.rat (power (p-(d : Int)))) (Epsilon.rat (power p)) := by
    apply (Epsilon.rat_positive_order _ _ hq.1 hp.1 hq.2.1 hp.2.1).mpr
    exact (Epsilon.power_le_bits _ _ hq0 (by omega) hp0 (by omega)).mpr (by omega)
  exact rat_trans _ _ _ (Epsilon.rat_den_pos _ hq.1) (Epsilon.rat_den_pos _ hp.1)
    (Epsilon.rat_den_pos _ hc.1) hqp hl

theorem upper_bound (p : Int) (d i j : Nat) (hp0 : -1074 ≤ p) (hp1 : p ≤ 971)
    (hd : d ≤ 26) (he : (i : Int)-(j : Int) = p-52) :
    RatLessEqual
