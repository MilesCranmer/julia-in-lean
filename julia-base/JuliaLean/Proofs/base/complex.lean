theorem pk_integer_key (s : Bool) (q K : Nat) (hq : q ≤ 2^53) (hK : K ≤ 1201)
    (hlo : 0 < K → 2^52 ≤ q) :
    F64.isfinite (pk s q ((K : Int)-1074)) = true ∧
      key64 (pk s q ((K : Int)-1074)) =
        if s then -((q*2^K : Nat) : Int) else ((q*2^K : Nat) : Int) := by
  by_cases hz : q = 0
  · subst q
    simpa only [pk, beq_iff_eq, ↓reduceIte, Nat.zero_mul, Nat.add_zero, F64.zero]
      using key64_sub s 0 (by decide)
  by_cases ht : q = 2^53
  · subst q
    have hp : pk s (2^53) ((K : Int)-1074) =
        F64.ofBits ((if s then 2^63 else 0)+(K+2)*2^52+((2^52 : Nat)-2^52)) := by
      unfold pk
      rw [ite_f (by decide : ¬((2^53 : Nat) == 0) = true)]
      simp only [show (2^53 : Nat) ≥ 2^53 by decide, ↓reduceIte,
        show (2^53 : Nat) / 2 = 2^52 by decide]
      have he : (K : Int)-1074+1+1075 = (K : Int)+2 := by omega
      rw [he, ite_f (by omega : ¬((K : Int)+2 ≥ 2047)),
        ite_f (by decide : ¬((2^52 : Nat) < 2^52)),
        show ((K : Int)+2).toNat = K+2 by omega, ← Nat.add_assoc]
    rw [hp]
    have hk := key64_norm s (K+2) (2^52) (by omega) (by omega) (by decide) (by decide)
    have hh : 2^52*2^(K+2-1) = (2^53 : Nat)*2^K := by
      rw [show K+2-1 = K+1 by omega, Nat.pow_succ 2 K, ← Nat.mul_assoc,
        Nat.mul_right_comm (2^52) (2^K) 2, show (2^52 : Nat)*2 = 2^53 by decide]
    simpa only [hh] using hk
  by_cases hl : 2^52 ≤ q
  · rw [pk_norm s q ((K : Int)-1074) hl (by omega) (by omega) (by omega),
      show ((K : Int)-1074+1075).toNat = K+1 by omega]
    simpa only [Nat.add_assoc, Nat.add_sub_cancel] using
      key64_norm s (K+1) q (by omega) (by omega) hl (by omega)
  · have hzero : K = 0 := by
      by_cases hh : 0 < K
      · have hb := hlo hh
        omega
      · omega
    subst K
    rw [show ((0 : Nat) : Int)-1074 = -1074 by decide, pk_sub s q (by omega) (by omega)]
    simpa only [Nat.pow_zero, Nat.mul_one] using key64_sub s q (by omega)

theorem rq_integer_rule (a d : Nat) (hd : 0 < d) :
    IntegralRoundingRule (.primitive .RoundNearest) (a : Int) d (rq a d : Int) := by
  have hr := Nat.mod_lt a hd
  have he := Nat.mod_add_div a d
  rw [Nat.mul_comm d (a/d)] at he
  have hdi : (0 : Int) < (d : Int) := by omega
  unfold rq
  simp only [Bool.or_eq_true, Bool.and_eq_true, decide_eq_true_eq, beq_iff_eq]
  split
  · apply rootNearestEvenRule _ _ _ hdi
    all_goals simp only [Int.natCast_add, Int.natCast_one, Int.add_mul, Int.one_mul]
    all_goals omega
  · apply rootNearestEvenRule _ _ _ hdi <;> omega

theorem grid_nearest (a g b : Nat) (hg : 0 < g) (hb : b*g ≤ a)
    (u : Int) (hu : (b*g : Nat) ≤ u → ∃ v : Int, u = v*g) :
    ((rq a g : Int)*(g : Int)-(a : Int)).natAbs ≤ (u-(a : Int)).natAbs ∧
    (((rq a g : Int)*(g : Int)-(a : Int)).natAbs = (u-(a : Int)).natAbs →
      u ≠ (rq a g : Int)*(g : Int) → rq a g % 2 = 0) := by
  obtain ⟨hn, ht⟩ := rq_integer_rule a g hg
  by_cases hbound : ((b*g : Nat) : Int) ≤ u
  · obtain ⟨v, hv⟩ := hu hbound
    have hm := hn v
    unfold IntegralDistance at hm
    rw [hv]
    constructor
    · omega
    · intro he hne
      have hvq : v ≠ (rq a g : Int) := by
        intro h
        apply hne
        rw [h]
      have hp := ht v hvq (by simpa only [IntegralDistance] using congrArg (fun t : Nat => (t : Int)) he)
      omega
  · have hm := hn (b : Int)
    unfold IntegralDistance at hm
    have hbI : (b : Int)*(g : Int) ≤ (a : Int) := by
      simpa only [Int.natCast_mul] using (Int.ofNat_le.mpr hb)
    have hbu : u < (b : Int)*(g : Int) := by
      simp only [Int.natCast_mul] at hbound
      omega
    constructor
    · omega
    · intro he
      omega

theorem magKey64_lt_exp (x : F64) :
    magKey64 x < 2^52*2^(F64.exponentField x) := by
  have hf : F64.fraction x < 2^52 := Nat.mod_lt _ (Nat.two_pow_pos _)
  by_cases he : F64.exponentField x = 0
  · simpa only [magKey64, he, beq_self_eq_true, ↓reduceIte, Nat.zero_sub,
      Nat.pow_zero, Nat.mul_one, Nat.add_zero] using hf
  · have hprod : 2^53*2^(F64.exponentField x-1) =
        (2^52 : Nat)*2^(F64.exponentField x) := by
      rw [← Nat.pow_add, ← Nat.pow_add]
      congr 1
      omega
    calc
      magKey64 x = (F64.fraction x+2^52)*2^(F64.exponentField x-1) := by
        simp only [magKey64, beq_iff_eq, he, ↓reduceIte]
      _ < 2^53*2^(F64.exponentField x-1) :=
        Nat.mul_lt_mul_of_pos_right (by omega) (Nat.two_pow_pos _)
      _ = _ := hprod

theorem key64_grid (x : F64) (k : Nat) (s : Bool)
    (hb : ((2^52*2^k : Nat) : Int) ≤ (if s then -key64 x else key64 x)) :
    ∃ v : Int, (if s then -key64 x else key64 x) = v*(2^k : Nat) := by
  have hmag : 2^52*2^k ≤ magKey64 x := by
    have ha := key64_abs x
    cases s <;> simp only [Bool.false_eq_true, ↓reduceIte] at hb <;> omega
  have he : k < F64.exponentField x := by
    by_cases hk : k < F64.exponentField x
    · exact hk
    · have hp := Nat.pow_le_pow_right (show 1 ≤ (2 : Nat) by decide)
        (show F64.exponentField x ≤ k by omega)
      have hm := Nat.mul_le_mul_left (2^52) hp
      have hlt := magKey64_lt_exp x
      omega
  have hd : 2^k ∣ magKey64 x := by
    unfold magKey64
    exact Nat.dvd_trans (Nat.pow_dvd_pow 2 (by omega : k ≤ F64.exponentField x-1))
      (Nat.dvd_mul_left _ _)
  obtain ⟨v, hv⟩ := hd
  have hi : (magKey64 x : Int) = (v : Int)*(2^k : Nat) := by
    rw [hv, Int.natCast_mul, Int.mul_comm]
  unfold key64
  cases s <;> cases F64.signbit x <;> simp only [Bool.false_eq_true, ↓reduceIte,
    Int.neg_neg]
  · exact ⟨v, hi⟩
  · exact ⟨-(v : Int), by rw [hi, Int.neg_mul]⟩
  · exact ⟨-(v : Int), by rw [hi, Int.neg_mul]⟩
  · exact ⟨v, hi⟩

theorem pk_integer_even (s : Bool) (q : Nat) (k : Int) (hq : q ≤ 2^53)
    (heven : q % 2 = 0) : F64.toBits (pk s q k) % 2 = 0 := by
  unfold pk
  by_cases hz : q = 0
  · subst q
    change F64.toBits (F64.zero s) % 2 = 0
    cases s <;> decide
  · simp only [beq_iff_eq, hz, ↓reduceIte]
    by_cases hc : q ≥ 2^53
    · have hqeq : q = 2^53 := by omega
      rw [hqeq]
      simp only [show (2^53 : Nat) ≥ 2^53 by decide, ↓reduceIte,
        show (2^53 : Nat)/2 = 2^52 by decide,
        show ¬((2^52 : Nat)<2^52) by decide]
      split
      · cases s <;> decide
      · simp only [tb_ofBits]
        cases s <;> simp only [Bool.false_eq_true, ↓reduceIte] <;> omega
    · simp only [hc, ↓reduceIte]
      split
      · cases s <;> decide
      · change F64.toBits (F64.ofBits ((if s then 2^63 else 0) +
          (if q < 2^52 then q else (k+1075).toNat*2^52+(q-2^52)))) % 2 = 0
        rw [tb_ofBits]
        cases s <;> simp only [Bool.false_eq_true, ↓reduceIte] <;> split <;> omega
theorem roundRat_integer_key (n t : Int) (j : Nat) (zs : Bool)
    (hc : n*((2^1074 : Nat) : Int) = t*((2^j : Nat) : Int))
    (ht : t.natAbs < 2^1202) :
    F64.isfinite (F64.roundRat n (2^j) zs) = true ∧
      key64 (F64.roundRat n (2^j) zs) = quantizeSigned t ∧
      (rq t.natAbs (2^(t.natAbs.log2-52)) % 2 = 0 →
        F64.toBits (F64.roundRat n (2^j) zs) % 2 = 0) := by
  have hG : (0 : Int) < ((2^1074 : Nat) : Int) :=
    Int.natCast_pos.mpr (Nat.two_pow_pos _)
  have hD : (0 : Int) < ((2^j : Nat) : Int) :=
    Int.natCast_pos.mpr (Nat.two_pow_pos _)
  have hd₀ : ¬(2^j == 0) = true := by
    simp only [beq_iff_eq]
    exact Nat.ne_of_gt (Nat.two_pow_pos _)
  by_cases ht₀ : t = 0
  · have hn : n = 0 :=
      (Int.mul_eq_zero.mp (by simpa only [ht₀, Int.zero_mul] using hc)).resolve_right
        (by omega)
    rw [hn, ht₀, roundRat_eq, ite_f hd₀]
    change F64.isfinite (F64.zero zs) = true ∧ key64 (F64.zero zs) = quantizeSigned 0 ∧ _
    refine ⟨finite_zero zs, ?_, ?_⟩
    · have hz : key64 (F64.zero zs) = 0 := by cases zs <;> decide
      rw [hz]
      rfl
    · intro _
      change F64.toBits (F64.zero zs) % 2 = 0
      cases zs <;> decide
  have hn : n ≠ 0 := by
    intro hz
    rw [hz, Int.zero_mul] at hc
    have hz' : t = 0 := (Int.mul_eq_zero.mp hc.symm).resolve_right (by omega)
    exact ht₀ hz'
  have hn₀ : ¬(n == 0) = true := by simpa only [beq_iff_eq] using hn
  have hnAbs : 0 < n.natAbs := by omega
  have htAbs : 0 < t.natAbs := by omega
  have ha : n.natAbs*2^1074 = t.natAbs*2^j := by
    have hh := congrArg Int.natAbs hc
    simpa only [Int.natAbs_mul, Int.natAbs_natCast] using hh
  have hlogs := congrArg Nat.log2 ha
  rw [log2_mul_pow 1074 hnAbs, log2_mul_pow j htAbs] at hlogs
  have hL : t.natAbs.log2 ≤ 1201 := by
    have hh := (Nat.log2_lt (by omega : t.natAbs ≠ 0)).mpr ht
    omega
  let K := t.natAbs.log2-52
  have hK : K ≤ 1149 := by dsimp only [K]; omega
  have hfl : fl2 n.natAbs (2^j) = (t.natAbs.log2 : Int)-1074 := by
    have hh := fl2_pow n.natAbs 0 j hnAbs
    simp only [Nat.pow_zero, Nat.mul_one, Nat.add_zero] at hh
    rw [hh]
    omega
  have hk : max (((t.natAbs.log2 : Int)-1074)-52) (-1074) = (K : Int)-1074 := by
    dsimp only [K]
    omega
  have hround : F64.roundRat n (2^j) zs =
      pk (decide (n < 0))
        (rq t.natAbs (2^K)) ((K : Int)-1074) := by
    rw [roundRat_eq, ite_f hd₀, ite_f hn₀, hfl, ite_f (by omega), ite_f (by omega), hk]
    by_cases hpos : 1074 ≤ K
    · rw [ite_t (by omega : (K : Int)-1074 ≥ 0),
        show ((K : Int)-1074).toNat = K-1074 by omega]
      have hscale : n.natAbs*2^K = t.natAbs*(2^j*2^(K-1074)) := by
        have hpower : 2^K = (2^1074 : Nat)*2^(K-1074) := by
          rw [← Nat.pow_add]
          congr 1
          omega
        rw [hpower, ← Nat.mul_assoc, ha, Nat.mul_assoc]
      rw [rq_cross_eq n.natAbs (2^j*2^(K-1074)) t.natAbs (2^K)
        (Nat.mul_pos (Nat.two_pow_pos _) (Nat.two_pow_pos _)) (Nat.two_pow_pos _) hscale]
    · rw [ite_f (by omega : ¬((K : Int)-1074 ≥ 0)),
        show (-((K : Int)-1074)).toNat = 1074-K by omega]
      have hscale : (n.natAbs*2^(1074-K))*2^K = t.natAbs*2^j := by
        rw [Nat.mul_assoc, ← Nat.pow_add, show 1074-K+K = 1074 by omega]
        exact ha
      rw [rq_cross_eq (n.natAbs*2^(1074-K)) (2^j) t.natAbs (2^K)
        (Nat.two_pow_pos _) (Nat.two_pow_pos _) hscale]
  have hs : decide (n < 0) = decide (t < 0) := by
    apply decide_eq_decide.mpr
    constructor
    · intro hh
      have hp : t*((2^j : Nat) : Int) < 0*((2^j : Nat) : Int) := by
        rw [Int.zero_mul, ← hc]
        exact Int.mul_neg_of_neg_of_pos hh hG
      exact Int.lt_of_mul_lt_mul_right hp (Int.le_of_lt hD)
    · intro hh
      have hp : n*((2^1074 : Nat) : Int) < 0*((2^1074 : Nat) : Int) := by
        rw [Int.zero_mul, hc]
        exact Int.mul_neg_of_neg_of_pos hh hD
      exact Int.lt_of_mul_lt_mul_right hp (Int.le_of_lt hG)
  have hu : rq t.natAbs (2^K) ≤ 2^53 :=
    rq_upper_bound _ _ _ (Nat.two_pow_pos _) (quantize_nat_bounds _).1
  have hl : 0 < K → 2^52 ≤ rq t.natAbs (2^K) := by
    intro hh
    exact rq_lower_bound _ _ _ (Nat.two_pow_pos _) ((quantize_nat_bounds _).2 hh)
  rw [hround, hs]
  obtain ⟨hfin, hkey⟩ := pk_integer_key (decide (t < 0)) (rq t.natAbs (2^K)) K hu (by omega) hl
  refine ⟨hfin, ?_, ?_⟩
  · simpa only [quantizeSigned, quantizeNat, quantizeKey, Nat.one_mul,
      decide_eq_true_eq, K] using hkey
  · intro heven
    exact pk_integer_even _ _ _ hu heven

theorem key64_equal (x y : F64) (hx : F64.isfinite x = true)
    (hy : F64.isfinite y = true) (he : key64 x = key64 y) : F64.eq x y = true := by
  have hcode : code64 x = code64 y := Int.le_antisymm
    ((key64_code_order x y).mp (Int.le_of_eq he))
    ((key64_code_order y x).mp (Int.le_of_eq he.symm))
  have htx := tb_lt x
  have hty := tb_lt y
  have hcases : F64.toBits x = F64.toBits y ∨
      (F64.toBits x % 2^63 = 0 ∧ F64.toBits y % 2^63 = 0) := by
    unfold code64 F64.signbit at hcode
    simp only [decide_eq_true_eq] at hcode
    split at hcode <;> split at hcode <;> omega
  simp only [F64.eq, ProofMisc.finite_not_nan x hx, ProofMisc.finite_not_nan y hy,
    Bool.not_false, Bool.true_and, Bool.or_eq_true, Bool.and_eq_true, beq_iff_eq]
  rcases hcases with he | ⟨hxz, hyz⟩
  · exact Or.inl he
  · exact Or.inr ⟨(iszero_iff x).mpr hxz, (iszero_iff y).mpr hyz⟩

theorem distance_key_scale (n : Int) (x : F64) (hx : F64.isfinite x = true) :
    (IntegerDistance n x).1 * ((2^1074 : Nat) : Int) =
      ((key64 x-n*((2^1074 : Nat) : Int)).natAbs : Int) * ((F64.toRat x).2 : Int) := by
  have he : ((F64.toRat x).1-n*((F64.toRat x).2 : Int))*((2^1074 : Nat) : Int) =
      (key64 x-n*((2^1074 : Nat) : Int))*((F64.toRat x).2 : Int) := by
    rw [Int.sub_mul, Int.sub_mul, key64_rat x hx]
    simp only [Int.mul_assoc, Int.mul_comm, Int.mul_left_comm]
  have ha := congrArg (fun z : Int => (z.natAbs : Int)) he
  simpa only [IntegerDistance, Int.natAbs_mul, Int.natAbs_natCast, Int.natCast_mul]
    using ha

theorem distance_key_order (n : Int) (x y : F64)
    (hx : F64.isfinite x = true) (hy : F64.isfinite y = true) :
    (IntegerDistance n x).1*(IntegerDistance n y).2 ≤
      (IntegerDistance n y).1*(IntegerDistance n x).2 ↔
    (key64 x-n*((2^1074 : Nat) : Int)).natAbs ≤
      (key64 y-n*((2^1074 : Nat) : Int)).natAbs := by
  have hG : (0 : Int) < ((2^1074 : Nat) : Int) :=
    Int.natCast_pos.mpr (Nat.two_pow_pos _)
  have hd : (0 : Int) < ((F64.toRat x).2 : Int)*((F64.toRat y).2 : Int) :=
    Int.mul_pos (Int.natCast_pos.mpr (toRat_den_pos x hx))
      (Int.natCast_pos.mpr (toRat_den_pos y hy))
  have he₁ : ((IntegerDistance n x).1*(IntegerDistance n y).2)*((2^1074 : Nat) : Int) =
      ((key64 x-n*((2^1074 : Nat) : Int)).natAbs : Int) *
        (((F64.toRat x).2 : Int)*((F64.toRat y).2 : Int)) := by
    rw [Int.mul_right_comm, distance_key_scale n x hx, Int.mul_assoc]
    rfl
  have he₂ : ((IntegerDistance n y).1*(IntegerDistance n x).2)*((2^1074 : Nat) : Int) =
      ((key64 y-n*((2^1074 : Nat) : Int)).natAbs : Int) *
        (((F64.toRat x).2 : Int)*((F64.toRat y).2 : Int)) := by
    rw [Int.mul_right_comm, distance_key_scale n y hy]
    simp only [IntegerDistance, Int.mul_assoc, Int.mul_comm, Int.mul_left_comm]
  rw [← int_le_cancel_positive hG, he₁, he₂, int_le_cancel_positive hd]
  exact Int.ofNat_le

theorem distance_key_equal (n : Int) (x y : F64)
    (hx : F64.isfinite x = true) (hy : F64.isfinite y = true) :
    (IntegerDistance n x).1*(IntegerDistance n y).2 =
      (IntegerDistance n y).1*(IntegerDistance n x).2 ↔
    (key64 x-n*((2^1074 : Nat) : Int)).natAbs =
      (key64 y-n*((2^1074 : Nat) : Int)).natAbs := by
  constructor
  · intro he
    exact Nat.le_antisymm ((distance_key_order n x y hx hy).mp (Int.le_of_eq he))
      ((distance_key_order n y x hy hx).mp (Int.le_of_eq he.symm))
  · intro he
    exact Int.le_antisymm ((distance_key_order n x y hx hy).mpr (Nat.le_of_eq he))
      ((distance_key_order n y x hy hx).mpr (Nat.le_of_eq he.symm))

theorem quantize_key_nearest (t : Int) (hlarge : 52 ≤ t.natAbs.log2) (y : F64) :
    (quantizeSigned t-t).natAbs ≤ (key64 y-t).natAbs ∧
    ((quantizeSigned t-t).natAbs = (key64 y-t).natAbs →
      key64 y ≠ quantizeSigned t → rq t.natAbs (2^(t.natAbs.log2-52)) % 2 = 0) := by
  let K := t.natAbs.log2-52
  have hpos : 0 < t.natAbs := by
    by_cases hz : t.natAbs = 0
    · rw [hz] at hlarge
      contradiction
    · omega
  have hboundary : 2^52*2^K ≤ t.natAbs := by
    have he : 2^52*2^K = (2^t.natAbs.log2 : Nat) := by
      rw [← Nat.pow_add]
      congr 1
      dsimp only [K]
      omega
    rw [he]
    exact Nat.log2_self_le (by omega)
  by_cases hs : t < 0
  · have ht : t = -(t.natAbs : Int) := Int.eq_neg_natAbs_of_nonpos (by omega)
    have hg := grid_nearest t.natAbs (2^K) (2^52) (Nat.two_pow_pos _) hboundary
      (-key64 y) (by intro h; exact key64_grid y K true h)
    have hq : quantizeSigned t = -((rq t.natAbs (2^K) : Int)*(2^K : Nat)) := by
      simp only [quantizeSigned, hs, ↓reduceIte, quantizeNat, quantizeKey,
        Nat.one_mul, Int.natCast_mul, K]
    have hd₁ : (quantizeSigned t-t).natAbs =
        ((rq t.natAbs (2^K) : Int)*(2^K : Nat)-(t.natAbs : Int)).natAbs := by
      rw [hq, ht]
      omega
    have hd₂ : (key64 y-t).natAbs = (-key64 y-(t.natAbs : Int)).natAbs := by
      rw [ht]
      omega
    rw [hd₁, hd₂]
    refine ⟨hg.1, ?_⟩
    intro he hne
    apply hg.2 he
    rw [hq] at hne
    omega
  · have ht : (t.natAbs : Int) = t := Int.natAbs_of_nonneg (by omega)
    have hg := grid_nearest t.natAbs (2^K) (2^52) (Nat.two_pow_pos _) hboundary
      (key64 y) (by intro h; exact key64_grid y K false h)
    have hq : quantizeSigned t = (rq t.natAbs (2^K) : Int)*(2^K : Nat) := by
      simp only [quantizeSigned, hs, ↓reduceIte, quantizeNat, quantizeKey,
        Nat.one_mul, Int.natCast_mul, K]
    simpa only [hq, ht, K] using hg

theorem integer_nearest (n : Int) (hn : n.natAbs < 2^128) :
    NearestInteger64 n (F64.ofInt n) := by
  let t := n*((2^1074 : Nat) : Int)
  have htAbs : t.natAbs = n.natAbs*2^1074 := by
    simp only [t, Int.natAbs_mul, Int.natAbs_natCast]
  have ht : t.natAbs < 2^1202 := by
    rw [htAbs]
    have hh := Nat.mul_lt_mul_of_pos_right hn (Nat.two_pow_pos 1074)
    simpa only [← Nat.pow_add] using hh
  obtain ⟨hf, hk, heven⟩ := roundRat_integer_key n t 0 false
    (by simp only [Nat.pow_zero, Int.natCast_one, Int.mul_one, t]) ht
  change F64.isfinite (F64.ofInt n) = true at hf
  change key64 (F64.ofInt n) = quantizeSigned t at hk
  change rq t.natAbs (2^(t.natAbs.log2-52)) % 2 = 0 →
    F64.toBits (F64.ofInt n) % 2 = 0 at heven
  refine ⟨hf, ?_, ?_⟩
  · intro hz
    subst n
    rfl
  · intro y hy
    by_cases hz : n = 0
    · have ht0 : t = 0 := by simp only [t, hz, Int.zero_mul]
      have hq0 : quantizeSigned t = 0 := by rw [ht0]; rfl
      have hx0 : key64 (F64.ofInt n) = 0 := by rw [hk, hq0]
      have hmin : (key64 (F64.ofInt n)-t).natAbs ≤ (key64 y-t).natAbs := by
        rw [hx0, ht0]
        omega
      refine ⟨(distance_key_order n _ y hf hy).mpr hmin, ?_⟩
      intro he hne
      have hekey := (distance_key_equal n _ y hf hy).mp he
      change (key64 (F64.ofInt n)-t).natAbs = (key64 y-t).natAbs at hekey
      rw [hx0, ht0] at hekey
      have hky : key64 y = 0 := by omega
      have heq := key64_equal _ y hf hy (by rw [hx0, hky])
      rw [heq] at hne
      contradiction
    · have hpos : 0 < n.natAbs := by omega
      have hl : 52 ≤ t.natAbs.log2 := by
        rw [htAbs, log2_mul_pow 1074 hpos]
        omega
      obtain ⟨hm, hp⟩ := quantize_key_nearest t hl y
      have hmin : (key64 (F64.ofInt n)-t).natAbs ≤ (key64 y-t).natAbs := by
        rw [hk]
        exact hm
      refine ⟨(distance_key_order n _ y hf hy).mpr hmin, ?_⟩
      intro he hne
      apply heven
      apply hp
      · have hekey := (distance_key_equal n _ y hf hy).mp he
        change (key64 (F64.ofInt n)-t).natAbs = (key64 y-t).natAbs at hekey
        rwa [hk] at hekey
      · intro hekey
        have heq := key64_equal _ y hf hy (by rw [hk, hekey])
        rw [heq] at hne
        contradiction

