theorem floatCheckNearestQuotientIntervalNat (n d lo hi : Nat) (hd : 0 < d)
    (hlo : lo * d ≤ n) (hhi : n ≤ hi * d) :
    let q := n / d
    let r := n % d
    let rounded := if decide (d < 2 * r) || (2 * r == d && q % 2 == 1)
      then q + 1 else q
    lo ≤ rounded ∧ rounded ≤ hi := by
  have hlq : lo ≤ n / d := (Nat.le_div_iff_mul_le hd).mpr hlo
  have huq : n / d ≤ hi := Nat.div_le_of_le_mul (by
    rw [Nat.mul_comm d hi]
    exact hhi)
  have hdecomp := Nat.div_add_mod n d
  rw [Nat.mul_comm d (n / d)] at hdecomp
  dsimp only
  cases hg : decide (d < 2 * (n % d)) || (2 * (n % d) == d && (n / d) % 2 == 1) with
  | false =>
    simp only [Bool.false_eq_true, ↓reduceIte]
    exact ⟨hlq, huq⟩
  | true =>
    simp only [↓reduceIte]
    have hstrict : n / d < hi := by
      by_cases hq : n / d = hi
      · have hr : n % d = 0 := by
          rw [hq] at hdecomp
          omega
        rcases Bool.or_eq_true_iff.mp hg with hgt | heq
        · have ht : d < 2 * (n % d) := decide_eq_true_iff.mp hgt
          rw [hr, Nat.mul_zero] at ht
          omega
        · have ht : 2 * (n % d) = d :=
            beq_iff_eq.mp (Bool.and_eq_true_iff.mp heq).1
          rw [hr, Nat.mul_zero] at ht
          omega
      · omega
    exact ⟨by omega, by omega⟩


theorem floatCheckLog2ScaleBracketNat (n d shift : Nat) (hn : n ≠ 0) (hd : d ≠ 0)
    (hlog : n.log2 = d.log2 + shift) :
    d * 2 ^ shift < 2 * n ∧ n < 2 * (d * 2 ^ shift) := by
  have hnlo := Nat.log2_self_le hn
  have hdlo := Nat.log2_self_le hd
  have hnhi : n < 2 ^ (n.log2 + 1) := Nat.lt_log2_self
  have hdhi : d < 2 ^ (d.log2 + 1) := Nat.lt_log2_self
  have hpowlo : 2 ^ (d.log2 + 1) * 2 ^ shift = 2 ^ n.log2 * 2 := by
    rw [← Nat.pow_add, ← Nat.pow_succ]
    congr 1
    omega
  have hpowhi : 2 ^ (n.log2 + 1) = 2 * (2 ^ d.log2 * 2 ^ shift) := by
    rw [hlog, Nat.pow_succ, Nat.pow_add, Nat.mul_comm (2 ^ d.log2 * 2 ^ shift) 2]
  constructor
  · calc
      d * 2 ^ shift < 2 ^ (d.log2 + 1) * 2 ^ shift :=
        Nat.mul_lt_mul_of_pos_right hdhi (Nat.two_pow_pos _)
      _ = 2 ^ n.log2 * 2 := hpowlo
      _ ≤ n * 2 := Nat.mul_le_mul_right 2 hnlo
      _ = 2 * n := Nat.mul_comm n 2
  · calc
      n < 2 ^ (n.log2 + 1) := hnhi
      _ = 2 * (2 ^ d.log2 * 2 ^ shift) := hpowhi
      _ ≤ 2 * (d * 2 ^ shift) :=
        Nat.mul_le_mul_left 2 (Nat.mul_le_mul_right (2 ^ shift) hdlo)

theorem floatCheckLog2RatioBracketNat (n d : Nat) (hn : n ≠ 0) (hd : d ≠ 0) :
    let e : Int := (n.log2 : Int) - (d.log2 : Int)
    if e ≥ 0 then
      d * 2 ^ e.toNat < 2 * n ∧ n < 2 * (d * 2 ^ e.toNat)
    else
      d < 2 * (n * 2 ^ (-e).toNat) ∧ n * 2 ^ (-e).toNat < 2 * d := by
  dsimp only
  split
  next hge =>
    exact floatCheckLog2ScaleBracketNat n d ((n.log2 : Int) - d.log2).toNat hn hd (by omega)
  next hlt =>
    have h := floatCheckLog2ScaleBracketNat d n (-((n.log2 : Int) - d.log2)).toNat hd hn (by omega)
    exact ⟨h.2, h.1⟩

theorem floatCheckFloorLog2NormalizedNat (n d : Nat) (hn : n ≠ 0) (hd : d ≠ 0) :
    let e : Int := (n.log2 : Int) - (d.log2 : Int)
    let below := if e ≥ 0 then n < d * 2 ^ e.toNat else n * 2 ^ (-e).toNat < d
    let k := if below then e - 1 else e
    if k ≥ 0 then
      d * 2 ^ k.toNat ≤ n ∧ n < 2 * (d * 2 ^ k.toNat)
    else
      d ≤ n * 2 ^ (-k).toNat ∧ n * 2 ^ (-k).toNat < 2 * d := by
  have hbracket := floatCheckLog2RatioBracketNat n d hn hd
  dsimp only at hbracket ⊢
  generalize (n.log2 : Int) - (d.log2 : Int) = e at hbracket ⊢
  by_cases he : 0 ≤ e
  · have hb : d * 2 ^ e.toNat < 2 * n ∧ n < 2 * (d * 2 ^ e.toNat) := by
      simpa only [he, ↓reduceIte] using hbracket
    simp only [he, ↓reduceIte]
    by_cases hbelow : n < d * 2 ^ e.toNat
    · simp only [hbelow, ↓reduceIte]
      by_cases hk : 0 ≤ e - 1
      · simp only [hk, ↓reduceIte]
        have hshift : e.toNat = (e - 1).toNat + 1 := by omega
        have hp : d * 2 ^ e.toNat = 2 * (d * 2 ^ (e - 1).toNat) := by
          calc
            d * 2 ^ e.toNat = d * (2 ^ (e - 1).toNat * 2) := by
              rw [hshift, Nat.pow_succ]
            _ = (d * 2 ^ (e - 1).toNat) * 2 := (Nat.mul_assoc _ _ _).symm
            _ = 2 * (d * 2 ^ (e - 1).toNat) := Nat.mul_comm _ _
        rw [hp] at hb hbelow
        exact ⟨by omega, hbelow⟩
      · simp only [hk, ↓reduceIte]
        have he0 : e = 0 := by omega
        have heN : e.toNat = 0 := by omega
        have hkN : (-(e - 1)).toNat = 1 := by omega
        have hc : d * 2 ^ e.toNat = d := by
          rw [heN, Nat.pow_zero, Nat.mul_one]
        rw [hc] at hb hbelow
        rw [hkN, Nat.pow_one]
        constructor <;> omega
    · simp only [hbelow, ↓reduceIte, he]
      exact ⟨by omega, hb.2⟩
  · have hb : d < 2 * (n * 2 ^ (-e).toNat) ∧ n * 2 ^ (-e).toNat < 2 * d := by
      simpa only [he, ↓reduceIte] using hbracket
    simp only [he, ↓reduceIte]
    by_cases hbelow : n * 2 ^ (-e).toNat < d
    · simp only [hbelow, ↓reduceIte]
      have hk : ¬ 0 ≤ e - 1 := by omega
      simp only [hk, ↓reduceIte]
      have hshift : (-(e - 1)).toNat = (-e).toNat + 1 := by omega
      have hp : n * 2 ^ (-(e - 1)).toNat = 2 * (n * 2 ^ (-e).toNat) := by
        calc
          n * 2 ^ (-(e - 1)).toNat = n * (2 ^ (-e).toNat * 2) := by
            rw [hshift, Nat.pow_succ]
          _ = (n * 2 ^ (-e).toNat) * 2 := (Nat.mul_assoc _ _ _).symm
          _ = 2 * (n * 2 ^ (-e).toNat) := Nat.mul_comm _ _
      rw [hp]
      constructor <;> omega
    · simp only [hbelow, ↓reduceIte, he]
      exact ⟨by omega, hb.2⟩

theorem floatCheckRescaleUpper (n d precision : Nat) (e k : Int)
    (bound : if e ≥ 0 then n < 2 * (d * 2 ^ e.toNat)
      else n * 2 ^ (-e).toNat < 2 * d)
    (scale : e - precision ≤ k) :
    if k ≥ 0 then n < 2 ^ (precision + 1) * (d * 2 ^ k.toNat)
    else n * 2 ^ (-k).toNat < 2 ^ (precision + 1) * d := by
  have ht : 2 ≤ 2 ^ (precision + 1) := by
    have h := Nat.pow_le_pow_right (n := 2) (by decide) (show 1 ≤ precision + 1 by omega)
    simpa only [Nat.pow_one] using h
  by_cases he : 0 ≤ e
  · simp only [he, ↓reduceIte] at bound
    by_cases hk : 0 ≤ k
    · simp only [hk, ↓reduceIte]
      calc
        n < 2 * (d * 2 ^ e.toNat) := bound
        _ = d * 2 ^ (e.toNat + 1) := by
          simp only [Nat.pow_succ, Nat.mul_assoc, Nat.mul_comm, Nat.mul_left_comm]
        _ ≤ d * 2 ^ (precision + 1 + k.toNat) :=
          Nat.mul_le_mul_left d (Nat.pow_le_pow_right (by decide) (by omega))
        _ = 2 ^ (precision + 1) * (d * 2 ^ k.toNat) := by
          simp only [Nat.pow_add, Nat.mul_assoc, Nat.mul_comm, Nat.mul_left_comm]
    · simp only [hk, ↓reduceIte]
      calc
        n * 2 ^ (-k).toNat < (2 * (d * 2 ^ e.toNat)) * 2 ^ (-k).toNat :=
          Nat.mul_lt_mul_of_pos_right bound (Nat.two_pow_pos _)
        _ = d * 2 ^ (e.toNat + 1 + (-k).toNat) := by
          simp only [Nat.pow_add, Nat.pow_one, Nat.mul_assoc, Nat.mul_comm, Nat.mul_left_comm]
        _ ≤ d * 2 ^ (precision + 1) :=
          Nat.mul_le_mul_left d (Nat.pow_le_pow_right (by decide) (by omega))
        _ = 2 ^ (precision + 1) * d := Nat.mul_comm _ _
  · simp only [he, ↓reduceIte] at bound
    by_cases hk : 0 ≤ k
    · simp only [hk, ↓reduceIte]
      have hn : n ≤ n * 2 ^ (-e).toNat := by
        have h := Nat.mul_le_mul_left n (Nat.two_pow_pos (-e).toNat)
        simpa only [Nat.mul_one] using h
      have hd : d ≤ d * 2 ^ k.toNat := by
        have h := Nat.mul_le_mul_left d (Nat.two_pow_pos k.toNat)
        simpa only [Nat.mul_one] using h
      exact Nat.lt_of_lt_of_le (Nat.lt_of_le_of_lt hn bound) (Nat.mul_le_mul ht hd)
    · simp only [hk, ↓reduceIte]
      by_cases hek : e ≤ k
      · calc
          n * 2 ^ (-k).toNat ≤ n * 2 ^ (-e).toNat :=
            Nat.mul_le_mul_left n (Nat.pow_le_pow_right (by decide) (by omega))
          _ < 2 * d := bound
          _ ≤ 2 ^ (precision + 1) * d := Nat.mul_le_mul_right d ht
      · have hexp : (-k).toNat = (-e).toNat + (e - k).toNat := by omega
        calc
          n * 2 ^ (-k).toNat = (n * 2 ^ (-e).toNat) * 2 ^ (e - k).toNat := by
            rw [hexp, Nat.pow_add, Nat.mul_assoc]
          _ < (2 * d) * 2 ^ (e - k).toNat :=
            Nat.mul_lt_mul_of_pos_right bound (Nat.two_pow_pos _)
          _ = d * 2 ^ ((e - k).toNat + 1) := by
            simp only [Nat.pow_succ, Nat.mul_assoc, Nat.mul_comm, Nat.mul_left_comm]
          _ ≤ d * 2 ^ (precision + 1) :=
            Nat.mul_le_mul_left d (Nat.pow_le_pow_right (by decide) (by omega))
          _ = 2 ^ (precision + 1) * d := Nat.mul_comm _ _

/-- The actual scaled quotient in roundRat has at most one rounding carry bit. -/
theorem floatCheckScaledRoundedBound (n d precision : Nat) (hn : n ≠ 0) (hd : d ≠ 0)
    (k : Int) (hk : f64Fl2 n d - precision ≤ k) :
    let scaled := if k ≥ 0 then (n, d * 2 ^ k.toNat) else (n * 2 ^ (-k).toNat, d)
    f64Rq scaled.1 scaled.2 ≤ 2 ^ (precision + 1) := by
  have normalized := floatCheckFloorLog2NormalizedNat n d hn hd
  change (if f64Fl2 n d ≥ 0 then
    d * 2 ^ (f64Fl2 n d).toNat ≤ n ∧
      n < 2 * (d * 2 ^ (f64Fl2 n d).toNat)
    else d ≤ n * 2 ^ (-f64Fl2 n d).toNat ∧
      n * 2 ^ (-f64Fl2 n d).toNat < 2 * d) at normalized
  have upper : if f64Fl2 n d ≥ 0 then
      n < 2 * (d * 2 ^ (f64Fl2 n d).toNat)
      else n * 2 ^ (-f64Fl2 n d).toNat < 2 * d := by
    by_cases he : 0 ≤ f64Fl2 n d
    · simp only [he, ↓reduceIte] at normalized ⊢
      exact normalized.2
    · simp only [he, ↓reduceIte] at normalized ⊢
      exact normalized.2
  have scaledBound := floatCheckRescaleUpper n d precision (f64Fl2 n d) k upper hk
  dsimp only
  by_cases hk0 : 0 ≤ k
  · simp only [hk0, ↓reduceIte] at scaledBound ⊢
    have hp := Nat.mul_pos (show 0 < d by omega) (Nat.two_pow_pos k.toNat)
    have h := floatCheckNearestQuotientIntervalNat n (d * 2 ^ k.toNat) 0
      (2 ^ (precision + 1)) hp (by simp only [Nat.zero_mul, Nat.zero_le])
      (Nat.le_of_lt scaledBound)
    exact h.2
  · simp only [hk0, ↓reduceIte] at scaledBound ⊢
    have h := floatCheckNearestQuotientIntervalNat (n * 2 ^ (-k).toNat) d 0
      (2 ^ (precision + 1)) (by omega) (by simp only [Nat.zero_mul, Nat.zero_le])
      (Nat.le_of_lt scaledBound)
    exact h.2


theorem floatCheckMagnitudeClass (s : Bool) (m : Nat)
    (hm : m ≤ 0x7ff0000000000000) :
    F64.signbit (F64.ofBits ((if s then 2^63 else 0) + m)) = s ∧
      F64.isnan (F64.ofBits ((if s then 2^63 else 0) + m)) = false := by
  unfold F64.signbit F64.isnan F64.exponentField F64.fraction F64.toBits F64.ofBits
  cases s <;> simp only [Bool.false_eq_true, ↓reduceIte, Nat.zero_add,
    BitVec.toNat_ofNat, decide_eq_false_iff_not, decide_eq_true_iff,
    Bool.and_eq_false_iff, beq_eq_false_iff_ne, bne_eq_false_iff_eq] <;>
    constructor <;> omega

theorem floatCheckPackClass (s : Bool) (q : Nat) (k : Int) (hq : q ≤ 2^53) :
    F64.signbit (f64Pack s q k) = s ∧ F64.isnan (f64Pack s q k) = false := by
  unfold f64Pack
  by_cases hz : q = 0
  · simp only [hz, beq_self_eq_true, ↓reduceIte]
    cases s <;> decide
  · simp only [beq_eq_false_iff_ne.mpr hz, Bool.false_eq_true, ↓reduceIte]
    by_cases he : (if q ≥ 2^53 then k + 1 else k) + 1075 ≥ 2047
    · simp only [he, ↓reduceIte]
      cases s <;> decide
    · simp only [he, ↓reduceIte]
      apply floatCheckMagnitudeClass
      have hm : (if q ≥ 2^53 then q / 2 else q) < 2^53 := by split <;> omega
      have hx : ((if q ≥ 2^53 then k + 1 else k) + 1075).toNat ≤ 2046 := by omega
      by_cases hsmall : (if q ≥ 2^53 then q / 2 else q) < 2^52
      · simp only [hsmall, ↓reduceIte]
        omega
      · simp only [hsmall, ↓reduceIte]
        omega

theorem floatCheckRoundRatClass (n : Int) (d : Nat) (s : Bool) (hd : d ≠ 0) :
    F64.isnan (F64.roundRat n d s) = false ∧
      F64.signbit (F64.roundRat n d s) = (if n = 0 then s else decide (n < 0)) := by
  rw [f64_roundRat_eq]
  simp only [beq_eq_false_iff_ne.mpr hd, Bool.false_eq_true, ↓reduceIte]
  by_cases hn : n = 0
  · simp only [hn, beq_self_eq_true, ↓reduceIte]
    cases s <;> decide
  · simp only [hn, beq_eq_false_iff_ne.mpr hn, Bool.false_eq_true, ↓reduceIte]
    split
    next he => cases decide (n < 0) <;> decide
    next he =>
      split
      next hu => cases decide (n < 0) <;> decide
      next hu =>
        have hq := floatCheckScaledRoundedBound n.natAbs d 52 (by omega) hd
          (max (f64Fl2 n.natAbs d - 52) (-1074)) (Int.le_max_left _ _)
        exact (floatCheckPackClass _ _ _ hq).symm

theorem floatCheckQuietNan (x : F64) (hx : F64.isnan x = true) :
    F64.isnan (f64QuietNaN x) = true := by
  unfold f64QuietNaN
  split
  next hsmall =>
    have hxBound := x.isLt
    simp only [F64.isnan, F64.exponentField, F64.fraction, F64.toBits,
      Bool.and_eq_true, beq_iff_eq, bne_iff_ne] at hx
    simp only [F64.fraction, F64.toBits] at hsmall
    simp only [F64.isnan, F64.exponentField, F64.fraction, F64.toBits,
      F64.ofBits, BitVec.toNat_ofNat, Bool.and_eq_true, beq_iff_eq, bne_iff_ne]
    constructor <;> omega
  next _ => exact hx

theorem floatCheckInfNonzero (x : F64) (hi : F64.isinf x = true) :
    F64.iszero x = false := by
  unfold F64.isinf at hi
  simp only [beq_iff_eq] at hi
  simp only [F64.iszero, hi]
  decide

theorem floatCheckSquareClass (x : F64) :
    F64.isnan (F64.mul x x) = F64.isnan x ∧
      (F64.isnan x = false → F64.signbit (F64.mul x x) = false) := by
  by_cases hn : F64.isnan x = true
  · have hm : F64.mul x x = f64QuietNaN x := by
      simp only [F64.mul, hn, ↓reduceIte]
      rfl
    rw [hm, floatCheckQuietNan x hn, hn]
    exact ⟨rfl, by intro h; cases h⟩
  · have hnf : F64.isnan x = false := Bool.eq_false_iff.mpr hn
    by_cases hi : F64.isinf x = true
    · have hz := floatCheckInfNonzero x hi
      have hm : F64.mul x x = F64.inf false := by
        simp only [F64.mul, hnf, hi, hz, bne_self_eq_false, Bool.false_eq_true,
          Bool.true_or, Bool.true_and, Bool.false_and, Bool.and_false, Bool.or_false,
          Bool.false_or, ↓reduceIte]
      rw [hm, hnf]
      exact ⟨by decide, fun _ => by decide⟩
    · have hif : F64.isinf x = false := Bool.eq_false_iff.mpr hi
      have hf : F64.isfinite x = true := by
        rw [isfinite_iff_not_nan_not_inf, hnf, hif]
        rfl
      have hd : (F64.toRat x).2 * (F64.toRat x).2 ≠ 0 :=
        Nat.ne_of_gt (Nat.mul_pos (toRat_snd_pos x hf) (toRat_snd_pos x hf))
      have hsq : 0 ≤ (F64.toRat x).1 * (F64.toRat x).1 := by
        by_cases hsign : 0 ≤ (F64.toRat x).1
        · exact Int.mul_nonneg hsign hsign
        · exact Int.mul_nonneg_of_nonpos_of_nonpos (by omega) (by omega)
      have hc := floatCheckRoundRatClass
        ((F64.toRat x).1 * (F64.toRat x).1) ((F64.toRat x).2 * (F64.toRat x).2) false hd
      have hs : F64.signbit (F64.roundRat
          ((F64.toRat x).1 * (F64.toRat x).1) ((F64.toRat x).2 * (F64.toRat x).2) false) = false := by
        rw [hc.2]
        split
        · rfl
        · exact decide_eq_false_iff_not.mpr (by omega)
      simp only [F64.mul, hnf, hif, bne_self_eq_false, Bool.false_and,
        Bool.and_false, Bool.false_or, Bool.false_eq_true, ↓reduceIte]
      exact ⟨hc.1, fun _ => hs⟩

theorem floatCheckPositiveNumerator (x : F64) (hs : F64.signbit x = false) :
    0 ≤ (F64.toRat x).1 := by
  unfold F64.toRat
  cases hf : F64.isfinite x <;>
    simp only [hf, Bool.not_false, Bool.not_true, Bool.false_eq_true, ↓reduceIte]
  · exact Int.le_refl _
  · simp only [hs, Bool.false_eq_true, ↓reduceIte]
    by_cases hp : (if F64.exponentField x == 0 then (-1074 : Int) else
        (F64.exponentField x : Int) - 1075) ≥ 0
    · simp only [hp, ↓reduceIte]
      exact Int.mul_nonneg (Int.natCast_nonneg _) (Int.natCast_nonneg _)
    · simp only [hp, ↓reduceIte]
      exact Int.natCast_nonneg _

theorem floatCheckAddPositive (x y : F64)
    (hnx : F64.isnan x = false) (hny : F64.isnan y = false)
    (hsx : F64.signbit x = false) (hsy : F64.signbit y = false) :
    F64.isnan (F64.add x y) = false ∧ F64.signbit (F64.add x y) = false := by
  by_cases hi : F64.isinf x = true
  · simp only [F64.add, hnx, hny, hi, hsx, hsy, bne_self_eq_false,
      Bool.and_false, Bool.false_eq_true, ↓reduceIte]
    exact ⟨True.intro, True.intro⟩
  · have hix : F64.isinf x = false := Bool.eq_false_iff.mpr hi
    by_cases hj : F64.isinf y = true
    · simp only [F64.add, hnx, hny, hix, hj, Bool.false_eq_true, ↓reduceIte]
      exact ⟨True.intro, hsy⟩
    · have hiy : F64.isinf y = false := Bool.eq_false_iff.mpr hj
      have hfx : F64.isfinite x = true := by
        rw [isfinite_iff_not_nan_not_inf, hnx, hix]
        rfl
      have hfy : F64.isfinite y = true := by
        rw [isfinite_iff_not_nan_not_inf, hny, hiy]
        rfl
      have hd : (F64.toRat x).2 * (F64.toRat y).2 ≠ 0 :=
        Nat.ne_of_gt (Nat.mul_pos (toRat_snd_pos x hfx) (toRat_snd_pos y hfy))
      have hn : 0 ≤ (F64.toRat x).1 * ((F64.toRat y).2 : Int) +
          (F64.toRat y).1 * ((F64.toRat x).2 : Int) :=
        Int.add_nonneg
          (Int.mul_nonneg (floatCheckPositiveNumerator x hsx) (Int.natCast_nonneg _))
          (Int.mul_nonneg (floatCheckPositiveNumerator y hsy) (Int.natCast_nonneg _))
      simp only [F64.add, hnx, hny, hix, hiy, hsx, hsy, Bool.and_self,
        Bool.false_eq_true, ↓reduceIte]
      have hc := floatCheckRoundRatClass
        ((F64.toRat x).1 * ((F64.toRat y).2 : Int) +
          (F64.toRat y).1 * ((F64.toRat x).2 : Int))
        ((F64.toRat x).2 * (F64.toRat y).2) false hd
      refine ⟨hc.1, ?_⟩
      rw [hc.2]
      split
      · rfl
      · exact decide_eq_false_iff_not.mpr (by omega)

theorem floatCheckNanAdd (x y : F64)
    (hn : F64.isnan x = true ∨ F64.isnan y = true) :
    F64.isnan (F64.add x y) = true := by
  by_cases hx : F64.isnan x = true
  · have h : F64.add x y = f64QuietNaN x := by
      simp only [F64.add, hx, ↓reduceIte]
      rfl
    rw [h]
    exact floatCheckQuietNan x hx
  · have hxf : F64.isnan x = false := Bool.eq_false_iff.mpr hx
    have hy : F64.isnan y = true := hn.resolve_left hx
    have h : F64.add x y = f64QuietNaN y := by
      simp only [F64.add, hxf, hy, Bool.false_eq_true, ↓reduceIte]
      rfl
    rw [h]
    exact floatCheckQuietNan y hy

theorem floatCheckNaNSpec (x : F64) : NaN64 x ↔ F64.isnan x = true := by
  simp only [NaN64, F64.isnan, F64.exponentField, F64.fraction,
    Bool.and_eq_true, beq_iff_eq, bne_iff_ne]

theorem floatCheckSquaredNormFloat (z : ComplexF64) :
    (NaN64 (abs2F64 z) ↔ NaN64 z.re ∨ NaN64 z.im) ∧
      (¬ NaN64 (abs2F64 z) → F64.signbit (abs2F64 z) = false) := by
  simp only [floatCheckNaNSpec]
  change (F64.isnan (F64.add (F64.mul z.re z.re) (F64.mul z.im z.im)) = true ↔
      F64.isnan z.re = true ∨ F64.isnan z.im = true) ∧
    (¬ F64.isnan (F64.add (F64.mul z.re z.re) (F64.mul z.im z.im)) = true →
      F64.signbit (F64.add (F64.mul z.re z.re) (F64.mul z.im z.im)) = false)
  have hr := floatCheckSquareClass z.re
  have hi := floatCheckSquareClass z.im
  by_cases hnan : F64.isnan z.re = true ∨ F64.isnan z.im = true
  · have hsum : F64.isnan (F64.add (F64.mul z.re z.re) (F64.mul z.im z.im)) = true :=
      floatCheckNanAdd _ _ (by simpa only [hr.1, hi.1] using hnan)
    exact ⟨⟨fun _ => hnan, fun _ => hsum⟩, fun h => False.elim (h hsum)⟩
  · have hrn : F64.isnan z.re = false := Bool.eq_false_iff.mpr
      (fun h => hnan (Or.inl h))
    have hin : F64.isnan z.im = false := Bool.eq_false_iff.mpr
      (fun h => hnan (Or.inr h))
    have hsum := floatCheckAddPositive _ _ (hr.1.trans hrn) (hi.1.trans hin)
      (hr.2 hrn) (hi.2 hin)
    exact ⟨⟨fun h => False.elim (by rw [hsum.1] at h; cases h),
      fun h => False.elim (hnan h)⟩, fun _ => hsum.2⟩

theorem floatCheckSquaredNormInteger (t : IntTy) (z : Complex (JInt t)) :
    ((abs2Int z).val - (z.re.val ^ 2 + z.im.val ^ 2)) % (2 ^ t.bits : Int) = 0 := by
  have h := wrapInt_emod_self t (z.re.val * z.re.val + z.im.val * z.im.val)
  have hm : (2 ^ t.bits : Int) = ((2 ^ t.bits : Nat) : Int) := by
    exact (Int.natCast_pow 2 t.bits).symm
  rw [hm]
  change (wrapInt t (wrapInt t (z.re.val * z.re.val) + wrapInt t (z.im.val * z.im.val)) -
    (z.re.val ^ 2 + z.im.val ^ 2)) % ((2 ^ t.bits : Nat) : Int) = 0
  rw [wrapInt_add_left, wrapInt_add_right]
  simp only [Int.pow_succ, Int.pow_zero, Int.one_mul]
  rw [Int.sub_emod, h, Int.sub_self, Int.zero_emod]

theorem Models1G19SquaredNorms_proven :
    JuliaLean.Proofs.base.complex.Models1Group19.SquaredNorms :=
  ⟨floatCheckSquaredNormInteger, floatCheckSquaredNormFloat⟩


theorem floatCheckFlOfBits {f : Fmt} (n : Nat) :
    (Fl.ofBits n : Fl f).toBits = n % 2 ^ f.width := rfl

theorem floatCheckFlWidth (f : Fmt) : 2 ^ f.width = 2 * 2 ^ (f.eb + f.sb) := by
  simp only [Fmt.width, Nat.add_assoc, Nat.pow_add, Nat.pow_one]

theorem floatCheckFlScaledRoundedBound (n d precision : Nat) (hn : n ≠ 0) (hd : d ≠ 0)
    (k : Int) (hk : Fl.floorLog2Rat n d - precision ≤ k) :
    let scaled := if k ≥ 0 then (n, d * 2 ^ k.toNat) else (n * 2 ^ (-k).toNat, d)
    Fl.roundQuotient scaled.1 scaled.2 ≤ 2 ^ (precision + 1) :=
  floatCheckScaledRoundedBound n d precision hn hd k hk

def floatCheckFlPack {f : Fmt} (s : Bool) (e p : Nat) : Fl f :=
  Fl.ofBits ((if s then 2 ^ (f.eb + f.sb) else 0) + (e * 2 ^ f.sb + p))

theorem floatCheckFlExpMagnitude {f : Fmt} (x : Fl f) :
    x.expField = x.magnitude / 2 ^ f.sb := by
  unfold Fl.expField Fl.magnitude
  rw [Nat.add_comm f.eb f.sb, Nat.pow_add, Nat.mod_mul_right_div_self]

theorem floatCheckFlFracMagnitude {f : Fmt} (x : Fl f) :
    x.frac = x.magnitude % 2 ^ f.sb := by
  unfold Fl.frac Fl.magnitude
  rw [Nat.add_comm f.eb f.sb, Nat.pow_add, Nat.mod_mul_right_mod]

theorem floatCheckFlPackParts {f : Fmt} (s : Bool) (e p : Nat)
    (he : e < 2 ^ f.eb) (hp : p < 2 ^ f.sb) :
    (floatCheckFlPack s e p : Fl f).signbit = s ∧
    (floatCheckFlPack s e p : Fl f).expField = e ∧
    (floatCheckFlPack s e p : Fl f).frac = p := by
  have hP := Nat.two_pow_pos f.sb
  have hM : e * 2 ^ f.sb + p < 2 ^ (f.eb + f.sb) := by
    rw [Nat.pow_add]
    have : (e + 1) * 2 ^ f.sb ≤ 2 ^ f.eb * 2 ^ f.sb :=
      Nat.mul_le_mul_right _ he
    rw [Nat.succ_mul] at this
    omega
  have hw := floatCheckFlWidth f
  have ht : (floatCheckFlPack s e p : Fl f).toBits =
      (if s then 2 ^ (f.eb + f.sb) else 0) + (e * 2 ^ f.sb + p) := by
    unfold floatCheckFlPack
    rw [floatCheckFlOfBits, Nat.mod_eq_of_lt]
    rw [hw]
    cases s <;> simp only [Bool.false_eq_true, ↓reduceIte, Nat.zero_add] <;> omega
  have hm : (floatCheckFlPack s e p : Fl f).magnitude = e * 2 ^ f.sb + p := by
    unfold Fl.magnitude
    rw [ht]
    cases s <;> simp only [Bool.false_eq_true, ↓reduceIte, Nat.zero_add,
      Nat.add_mod_left, Nat.mod_eq_of_lt hM]
  refine ⟨?_, ?_, ?_⟩
  · unfold Fl.signbit
    rw [ht]
    cases s <;> simp only [Bool.false_eq_true, ↓reduceIte, Nat.zero_add,
      decide_eq_false_iff_not, decide_eq_true_iff] <;> omega
  · rw [floatCheckFlExpMagnitude, hm, Nat.add_comm,
      Nat.add_mul_div_right _ _ hP, Nat.div_eq_of_lt hp, Nat.zero_add]
  · rw [floatCheckFlFracMagnitude, hm, Nat.add_comm,
      Nat.add_mul_mod_self_right, Nat.mod_eq_of_lt hp]

/-- Zero has the requested sign and cannot be NaN. -/
theorem floatCheckFlZeroClass (f : Fmt) (s : Bool) :
    (Fl.zero s : Fl f).signbit = s ∧ (Fl.zero s : Fl f).isnan = false := by
  have hz : (Fl.zero s : Fl f) = floatCheckFlPack s 0 0 := by
    simp only [Fl.zero, floatCheckFlPack, Nat.zero_mul, Nat.add_zero]
  rw [hz]
  obtain ⟨hs, he, hp⟩ := floatCheckFlPackParts (f := f) s 0 0
    (Nat.two_pow_pos _) (Nat.two_pow_pos _)
  exact ⟨hs, by simp only [Fl.isnan, hp, bne_self_eq_false, Bool.and_false]⟩

/-- Infinity has the requested sign and cannot be NaN. -/
theorem floatCheckFlInfClass (f : Fmt) (s : Bool) :
    (Fl.inf s : Fl f).signbit = s ∧ (Fl.inf s : Fl f).isnan = false := by
  have hi : (Fl.inf s : Fl f) = floatCheckFlPack s f.emax 0 := by
    simp only [Fl.inf, floatCheckFlPack, Nat.add_zero]
  have hmax : f.emax < 2 ^ f.eb := by
    unfold Fmt.emax
    have := Nat.two_pow_pos f.eb
    omega
  rw [hi]
  obtain ⟨hs, he, hp⟩ := floatCheckFlPackParts (f := f) s f.emax 0 hmax (Nat.two_pow_pos _)
  exact ⟨hs, by simp only [Fl.isnan, hp, bne_self_eq_false, Bool.and_false]⟩

/-- A bounded significand cannot enter the NaN payload or corrupt its sign. -/
theorem floatCheckFlPackTailClass (f : Fmt) (hemax : 0 < f.emax)
    (s : Bool) (m : Nat) (p : Int) (hm : m < 2 ^ (f.sb + 1)) :
    let y : Fl f := if p + f.bias + f.sb ≥ f.emax then Fl.inf s else
      Fl.ofBits ((if s then 2 ^ (f.eb + f.sb) else 0) +
        (if m < 2 ^ f.sb then m else
          (p + f.bias + f.sb).toNat * 2 ^ f.sb + (m - 2 ^ f.sb)))
    y.signbit = s ∧ y.isnan = false := by
  dsimp only
  by_cases he : p + (f.bias : Int) + f.sb ≥ f.emax
  · simp only [he, ↓reduceIte]
    exact floatCheckFlInfClass f s
  · simp only [he, ↓reduceIte]
    by_cases hsmall : m < 2 ^ f.sb
    · simp only [hsmall, ↓reduceIte]
      have hpack : (Fl.ofBits ((if s then 2 ^ (f.eb + f.sb) else 0) + m) : Fl f) =
          floatCheckFlPack s 0 m := by
        simp only [floatCheckFlPack, Nat.zero_mul, Nat.zero_add]
      rw [hpack]
      obtain ⟨hs, hexp, _⟩ := floatCheckFlPackParts (f := f) s 0 m (Nat.two_pow_pos _) hsmall
      have hne : (0 == f.emax) = false := beq_eq_false_iff_ne.mpr (by omega)
      exact ⟨hs, by simp only [Fl.isnan, hexp, hne, Bool.false_and]⟩
    · simp only [hsmall, ↓reduceIte]
      change (floatCheckFlPack s (p + f.bias + f.sb).toNat (m - 2 ^ f.sb) : Fl f).signbit = s ∧
        (floatCheckFlPack s (p + f.bias + f.sb).toNat (m - 2 ^ f.sb) : Fl f).isnan = false
      have hraw : (p + (f.bias : Int) + f.sb).toNat < f.emax := by omega
      have hmax : f.emax < 2 ^ f.eb := by
        unfold Fmt.emax
        have := Nat.two_pow_pos f.eb
        omega
      have hfrac : m - 2 ^ f.sb < 2 ^ f.sb := by
        rw [Nat.pow_succ] at hm
        omega
      obtain ⟨hs, hexp, _⟩ := floatCheckFlPackParts (f := f) s
        (p + f.bias + f.sb).toNat (m - 2 ^ f.sb) (Nat.lt_trans hraw hmax) hfrac
      have hne : ((p + (f.bias : Int) + f.sb).toNat == f.emax) = false :=
        beq_eq_false_iff_ne.mpr (Nat.ne_of_lt hraw)
      exact ⟨hs, by simp only [Fl.isnan, hexp, hne, Bool.false_and]⟩

/-- The complete packing routine preserves sign and produces no NaN at its input bound. -/
theorem floatCheckFlPackRoundedClass (f : Fmt) (hemax : 0 < f.emax)
    (s : Bool) (q : Nat) (k : Int) (hq : q < 2 ^ (f.sb + 2)) :
    (Fl.packRounded s q k : Fl f).signbit = s ∧
      (Fl.packRounded s q k : Fl f).isnan = false := by
  unfold Fl.packRounded
  by_cases hzero : q = 0
  · simp only [hzero, beq_self_eq_true, ↓reduceIte]
    exact floatCheckFlZeroClass f s
  · have hzero' : (q == 0) = false := beq_eq_false_iff_ne.mpr hzero
    simp only [hzero', Bool.false_eq_true, ↓reduceIte]
    by_cases hcarry : q ≥ 2 ^ (f.sb + 1)
    · simp only [hcarry, ↓reduceIte]
      apply floatCheckFlPackTailClass f hemax s (q / 2) (k + 1)
      have hp : 2 ^ (f.sb + 2) = 2 * 2 ^ (f.sb + 1) := by
        rw [Nat.pow_succ, Nat.mul_comm]
      rw [hp] at hq
      omega
    · simp only [hcarry, ↓reduceIte]
      exact floatCheckFlPackTailClass f hemax s q k (by omega)

/-- Rounding a rational with positive denominator preserves the nonzero numerator's sign. -/
theorem floatCheckFlRoundRatNonzeroClass (f : Fmt) (hemax : 0 < f.emax)
    (n : Int) (d : Nat) (zeroSign : Bool) (hn : n ≠ 0) (hd : d ≠ 0) :
    (Fl.roundRat n d zeroSign : Fl f).signbit = decide (n < 0) ∧
      (Fl.roundRat n d zeroSign : Fl f).isnan = false := by
  have hdb : (d == 0) = false := beq_eq_false_iff_ne.mpr hd
  have hnb : (n == 0) = false := beq_eq_false_iff_ne.mpr hn
  have ha : n.natAbs ≠ 0 := by omega
  unfold Fl.roundRat
  simp only [hdb, hnb, Bool.false_eq_true, ↓reduceIte]
  by_cases hover : Fl.floorLog2Rat n.natAbs d ≥ (f.emax : Int) - f.bias
  · simp only [hover, ↓reduceIte]
    exact floatCheckFlInfClass f _
  · simp only [hover, ↓reduceIte]
    by_cases hunder : Fl.floorLog2Rat n.natAbs d < -((f.bias : Int) + f.sb) - 1
    · simp only [hunder, ↓reduceIte]
      exact floatCheckFlZeroClass f _
    · simp only [hunder, ↓reduceIte]
      apply floatCheckFlPackRoundedClass f hemax
      have hbound := floatCheckFlScaledRoundedBound n.natAbs d f.sb ha hd
        (max (Fl.floorLog2Rat n.natAbs d - f.sb) (1 - (f.bias : Int) - f.sb))
        (Int.le_max_left _ _)
      exact Nat.lt_of_le_of_lt hbound (Nat.pow_lt_pow_right (by decide) (by omega))

/-- Positive-denominator rational rounding always avoids NaNs, including an exact zero. -/
theorem floatCheckFlRoundRatNotNan (f : Fmt) (hemax : 0 < f.emax)
    (n : Int) (d : Nat) (zeroSign : Bool) (hd : d ≠ 0) :
    (Fl.roundRat n d zeroSign : Fl f).isnan = false := by
  by_cases hn : n = 0
  · have hdb : (d == 0) = false := beq_eq_false_iff_ne.mpr hd
    simp only [Fl.roundRat, hdb, hn, beq_self_eq_true, Bool.false_eq_true, ↓reduceIte]
    exact (floatCheckFlZeroClass f zeroSign).2
  · exact (floatCheckFlRoundRatNonzeroClass f hemax n d zeroSign hn hd).2


/-- Multiplication by a power of two shifts the integer logarithm exactly. -/
theorem floatCheckLog2MulPow (n k : Nat) (hn : n ≠ 0) :
    (n * 2 ^ k).log2 = n.log2 + k := by
  have hp : n * 2 ^ k ≠ 0 := Nat.mul_ne_zero hn (Nat.ne_of_gt (Nat.two_pow_pos _))
  apply Nat.le_antisymm
  · have hu : n * 2 ^ k < 2 ^ (n.log2 + k + 1) := by
      rw [show n.log2 + k + 1 = (n.log2 + 1) + k by omega, Nat.pow_add]
      exact Nat.mul_lt_mul_of_pos_right Nat.lt_log2_self (Nat.two_pow_pos _)
    have hh := (Nat.log2_lt hp).mpr hu
    omega
  · apply (Nat.le_log2 hp).mpr
    rw [Nat.pow_add]
    exact Nat.mul_le_mul_right _ (Nat.log2_self_le hn)

theorem floatCheckLog2Mono (n d : Nat) (hn : n ≠ 0) (hd : d ≠ 0) (h : n ≤ d) :
    n.log2 ≤ d.log2 := by
  exact (Nat.le_log2 hd).mpr (Nat.le_trans (Nat.log2_self_le hn) h)

/-- Coarse power-of-two rational bounds give safe bounds on its binary exponent. -/
theorem floatCheckFloorLogBounds (n d lo hi : Nat) (hn : n ≠ 0) (hd : d ≠ 0)
    (hlo : d ≤ n * 2 ^ lo) (hhi : n ≤ d * 2 ^ hi) :
    -(lo : Int) - 1 ≤ Fl.floorLog2Rat n d ∧ Fl.floorLog2Rat n d ≤ hi := by
  have hlo' := floatCheckLog2Mono d (n * 2 ^ lo) hd
    (Nat.mul_ne_zero hn (Nat.ne_of_gt (Nat.two_pow_pos _))) hlo
  have hhi' := floatCheckLog2Mono n (d * 2 ^ hi) hn
    (Nat.mul_ne_zero hd (Nat.ne_of_gt (Nat.two_pow_pos _))) hhi
  rw [floatCheckLog2MulPow n lo hn] at hlo'
  rw [floatCheckLog2MulPow d hi hd] at hhi'
  unfold Fl.floorLog2Rat
  dsimp only
  split <;> constructor <;> omega

/-- Scaling by the normal-binade spacing retains at least the hidden leading bit. -/
theorem floatCheckRescaleLower (n d precision : Nat) (e : Int)
    (bound : if e ≥ 0 then d * 2 ^ e.toNat ≤ n else d ≤ n * 2 ^ (-e).toNat) :
    let k := e - precision
    if k ≥ 0 then 2 ^ precision * (d * 2 ^ k.toNat) ≤ n
    else 2 ^ precision * d ≤ n * 2 ^ (-k).toNat := by
  dsimp only
  by_cases he : 0 ≤ e
  · simp only [he, ↓reduceIte] at bound
    by_cases hk : 0 ≤ e - precision
    · simp only [hk, ↓reduceIte]
      calc
        2 ^ precision * (d * 2 ^ (e - precision).toNat) = d * 2 ^ e.toNat := by
          have ht : e.toNat = precision + (e - precision).toNat := by omega
          rw [ht, Nat.pow_add]
          simp only [Nat.mul_assoc, Nat.mul_comm, Nat.mul_left_comm]
        _ ≤ n := bound
    · simp only [hk, ↓reduceIte]
      calc
        2 ^ precision * d = (d * 2 ^ e.toNat) * 2 ^ (-(e - precision)).toNat := by
          have ht : precision = e.toNat + (-(e - precision)).toNat := by omega
          have hp : 2 ^ precision = 2 ^ e.toNat * 2 ^ (-(e - precision)).toNat := by
            rw [← Nat.pow_add]
            exact congrArg (fun j : Nat => 2 ^ j) ht
          rw [hp]
          simp only [Nat.mul_assoc, Nat.mul_comm, Nat.mul_left_comm]
        _ ≤ n * 2 ^ (-(e - precision)).toNat := Nat.mul_le_mul_right _ bound
  · simp only [he, ↓reduceIte] at bound
    have hk : ¬ 0 ≤ e - precision := by omega
    simp only [hk, ↓reduceIte]
    calc
      2 ^ precision * d ≤ 2 ^ precision * (n * 2 ^ (-e).toNat) := Nat.mul_le_mul_left _ bound
      _ = n * 2 ^ (-(e - precision)).toNat := by
        have ht : (-(e - precision)).toNat = precision + (-e).toNat := by omega
        rw [ht, Nat.pow_add]
        simp only [Nat.mul_assoc, Nat.mul_comm, Nat.mul_left_comm]

theorem floatCheckFlScaledRoundedLower (n d precision : Nat) (hn : n ≠ 0) (hd : d ≠ 0) :
    let k := Fl.floorLog2Rat n d - precision
    let scaled := if k ≥ 0 then (n, d * 2 ^ k.toNat) else (n * 2 ^ (-k).toNat, d)
    2 ^ precision ≤ Fl.roundQuotient scaled.1 scaled.2 := by
  have norm := floatCheckFloorLog2NormalizedNat n d hn hd
  change (if Fl.floorLog2Rat n d ≥ 0 then
    d * 2 ^ (Fl.floorLog2Rat n d).toNat ≤ n ∧
      n < 2 * (d * 2 ^ (Fl.floorLog2Rat n d).toNat)
    else d ≤ n * 2 ^ (-Fl.floorLog2Rat n d).toNat ∧
      n * 2 ^ (-Fl.floorLog2Rat n d).toNat < 2 * d) at norm
  have low : if Fl.floorLog2Rat n d ≥ 0 then
      d * 2 ^ (Fl.floorLog2Rat n d).toNat ≤ n
      else d ≤ n * 2 ^ (-Fl.floorLog2Rat n d).toNat := by
    by_cases he : 0 ≤ Fl.floorLog2Rat n d <;> simp only [he, ↓reduceIte] at norm ⊢ <;> exact norm.1
  have sl := floatCheckRescaleLower n d precision (Fl.floorLog2Rat n d) low
  dsimp only at sl ⊢
  by_cases hk : 0 ≤ Fl.floorLog2Rat n d - precision
  · simp only [hk, ↓reduceIte] at sl ⊢
    exact (floatCheckNearestQuotientIntervalNat n
      (d * 2 ^ (Fl.floorLog2Rat n d - precision).toNat) (2 ^ precision) n
      (Nat.mul_pos (by omega) (Nat.two_pow_pos _)) sl (by
        have hp := Nat.mul_pos (show 0 < d by omega) (Nat.two_pow_pos (Fl.floorLog2Rat n d - precision).toNat)
        have h := Nat.mul_le_mul_left n hp
        simpa only [Nat.mul_one] using h)).1
  · simp only [hk, ↓reduceIte] at sl ⊢
    exact (floatCheckNearestQuotientIntervalNat (n * 2 ^ (-(Fl.floorLog2Rat n d - precision)).toNat)
      d (2 ^ precision) (n * 2 ^ (-(Fl.floorLog2Rat n d - precision)).toNat)
      (by omega) sl (by
        have h := Nat.mul_le_mul_left (n * 2 ^ (-(Fl.floorLog2Rat n d - precision)).toNat) (show 1 ≤ d by omega)
        simpa only [Nat.mul_one] using h)).1

/-- A normal, non-overflowing rounded significand remains finite and nonzero. -/
theorem floatCheckFlPackRoundedNormal (f : Fmt) (s : Bool) (q : Nat) (e : Int)
    (hlo : 2 ^ f.sb ≤ q) (hhi : q ≤ 2 ^ (f.sb + 1))
    (elo : 1 ≤ e + f.bias) (ehi : e + f.bias + 1 < f.emax) :
    let y := (Fl.packRounded s q (e - f.sb) : Fl f)
    y.isfinite = true ∧ y.iszero = false ∧
      e + f.bias ≤ (y.expField : Int) ∧ (y.expField : Int) ≤ e + f.bias + 1 := by
  have hmax : f.emax < 2 ^ f.eb := by
    unfold Fmt.emax
    have := Nat.two_pow_pos f.eb
    omega
  have hq : (q == 0) = false := beq_eq_false_iff_ne.mpr (by
    have := Nat.two_pow_pos f.sb
    omega)
  unfold Fl.packRounded
  simp only [hq, Bool.false_eq_true, ↓reduceIte]
  by_cases hc : q ≥ 2 ^ (f.sb + 1)
  · have heq : q = 2 ^ (f.sb + 1) := by omega
    have hm : q / 2 = 2 ^ f.sb := by rw [heq, Nat.pow_succ, Nat.mul_div_cancel]; decide
    have hm0 : ¬ q / 2 < 2 ^ f.sb := by omega
    have hx : ¬ e - (f.sb : Int) + 1 + f.bias + f.sb ≥ f.emax := by omega
    simp only [hc, ↓reduceIte, hx, hm0]
    change (floatCheckFlPack s (e - (f.sb : Int) + 1 + f.bias + f.sb).toNat
        (q / 2 - 2 ^ f.sb) : Fl f).isfinite = true ∧ _
    have helo : 0 < (e - (f.sb : Int) + 1 + f.bias + f.sb).toNat := by omega
    have hehi : (e - (f.sb : Int) + 1 + f.bias + f.sb).toNat < f.emax := by omega
    have hp : q / 2 - 2 ^ f.sb < 2 ^ f.sb := by rw [hm, Nat.sub_self]; exact Nat.two_pow_pos _
    obtain ⟨_, hexp, _⟩ := floatCheckFlPackParts (f := f) s _ _ (Nat.lt_trans hehi hmax) hp
    have hnz : (floatCheckFlPack s (e - (f.sb : Int) + 1 + f.bias + f.sb).toNat
        (q / 2 - 2 ^ f.sb) : Fl f).iszero = false := by
      unfold Fl.iszero
      apply beq_eq_false_iff_ne.mpr
      intro hz
      have hz' := floatCheckFlExpMagnitude (floatCheckFlPack (f := f) s
        (e - (f.sb : Int) + 1 + f.bias + f.sb).toNat (q / 2 - 2 ^ f.sb))
      rw [hz, Nat.zero_div, hexp] at hz'
      omega
    have hexp' := hexp
    unfold floatCheckFlPack at hexp'
    exact ⟨by simp only [Fl.isfinite, hexp, bne_iff_ne]; omega, hnz, by rw [hexp']; omega, by rw [hexp']; omega⟩
  · have hm0 : ¬ q < 2 ^ f.sb := by omega
    have hx : ¬ e - (f.sb : Int) + f.bias + f.sb ≥ f.emax := by omega
    simp only [hc, ↓reduceIte, hx, hm0]
    change (floatCheckFlPack s (e - (f.sb : Int) + f.bias + f.sb).toNat
        (q - 2 ^ f.sb) : Fl f).isfinite = true ∧ _
    have helo : 0 < (e - (f.sb : Int) + f.bias + f.sb).toNat := by omega
    have hehi : (e - (f.sb : Int) + f.bias + f.sb).toNat < f.emax := by omega
    have hp : q - 2 ^ f.sb < 2 ^ f.sb := by rw [Nat.pow_succ] at hc; omega
    obtain ⟨_, hexp, _⟩ := floatCheckFlPackParts (f := f) s _ _ (Nat.lt_trans hehi hmax) hp
    have hnz : (floatCheckFlPack s (e - (f.sb : Int) + f.bias + f.sb).toNat
        (q - 2 ^ f.sb) : Fl f).iszero = false := by
      unfold Fl.iszero
      apply beq_eq_false_iff_ne.mpr
      intro hz
      have hz' := floatCheckFlExpMagnitude (floatCheckFlPack (f := f) s
        (e - (f.sb : Int) + f.bias + f.sb).toNat (q - 2 ^ f.sb))
      rw [hz, Nat.zero_div, hexp] at hz'
      omega
    have hexp' := hexp
    unfold floatCheckFlPack at hexp'
    exact ⟨by simp only [Fl.isfinite, hexp, bne_iff_ne]; omega, hnz, by rw [hexp']; omega, by rw [hexp']; omega⟩

theorem floatCheckFlRoundRatNormal (f : Fmt) (n : Int) (d : Nat) (s : Bool)
    (hn : n ≠ 0) (hd : d ≠ 0)
    (hlo : 1 ≤ Fl.floorLog2Rat n.natAbs d + f.bias)
    (hhi : Fl.floorLog2Rat n.natAbs d + f.bias + 1 < f.emax) :
    let y := (Fl.roundRat n d s : Fl f)
    y.isfinite = true ∧ y.iszero = false ∧
      Fl.floorLog2Rat n.natAbs d + f.bias ≤ (y.expField : Int) ∧
      (y.expField : Int) ≤ Fl.floorLog2Rat n.natAbs d + f.bias + 1 := by
  have hdb : (d == 0) = false := beq_eq_false_iff_ne.mpr hd
  have hnb : (n == 0) = false := beq_eq_false_iff_ne.mpr hn
  have ha : n.natAbs ≠ 0 := by omega
  have ho : ¬ Fl.floorLog2Rat n.natAbs d ≥ (f.emax : Int) - f.bias := by omega
  have hu : ¬ Fl.floorLog2Rat n.natAbs d < -((f.bias : Int) + f.sb) - 1 := by omega
  have hk : max (Fl.floorLog2Rat n.natAbs d - f.sb) (1 - (f.bias : Int) - f.sb) =
      Fl.floorLog2Rat n.natAbs d - f.sb := Int.max_eq_left (by omega)
  unfold Fl.roundRat
  simp only [hdb, hnb, ho, hu, hk, Bool.false_eq_true, ↓reduceIte]
  apply floatCheckFlPackRoundedNormal
  · exact floatCheckFlScaledRoundedLower n.natAbs d f.sb ha hd
  · exact floatCheckFlScaledRoundedBound n.natAbs d f.sb ha hd _ (by omega)
  · exact hlo
  · exact hhi


/-- Binary64 reinterpreting a generic double preserves its bit pattern. -/
theorem floatCheckFlToF64Bits (x : Fl double) : F64.toBits (Fl.toF64 x) = x.toBits := by
  have hx : x.toBits < 2 ^ 64 := x.bits.isLt
  simp only [Fl.toF64, F64.toBits, F64.ofBits, BitVec.toNat_ofNat, Nat.mod_eq_of_lt hx]

theorem floatCheckFlToF64OfBits (n : Nat) : Fl.toF64 (Fl.ofBits n : Fl double) = F64.ofBits n := by
  apply BitVec.eq_of_toNat_eq
  change F64.toBits (Fl.toF64 (Fl.ofBits n : Fl double)) = F64.toBits (F64.ofBits n)
  rw [floatCheckFlToF64Bits, floatCheckFlOfBits]
  rfl

theorem floatCheckFlToF64Zero (s : Bool) : Fl.toF64 (Fl.zero s : Fl double) = F64.zero s := by
  unfold Fl.zero F64.zero
  exact floatCheckFlToF64OfBits _

theorem floatCheckFlToF64Inf (s : Bool) : Fl.toF64 (Fl.inf s : Fl double) = F64.inf s := by
  unfold Fl.inf F64.inf
  exact floatCheckFlToF64OfBits _

theorem floatCheckFlToF64Pack (s : Bool) (q : Nat) (k : Int) :
    Fl.toF64 (Fl.packRounded s q k : Fl double) = f64Pack s q k := by
  unfold Fl.packRounded f64Pack
  change Fl.toF64 (if q == 0 then Fl.zero s else
    let m := if q ≥ 2 ^ 53 then q / 2 else q
    let p := if q ≥ 2 ^ 53 then k + 1 else k
    if p + 1023 + 52 ≥ 2047 then Fl.inf s else
      Fl.ofBits ((if s then 2 ^ 63 else 0) +
        (if m < 2 ^ 52 then m else (p + 1023 + 52).toNat * 2 ^ 52 + (m - 2 ^ 52)))) = _
  by_cases hq : q == 0
  · simp only [hq, ↓reduceIte]
    exact floatCheckFlToF64Zero s
  · simp only [hq, Bool.false_eq_true, ↓reduceIte]
    have hp : (if q ≥ 2 ^ 53 then k + 1 else k) + 1023 + 52 =
        (if q ≥ 2 ^ 53 then k + 1 else k) + 1075 := by omega
    rw [hp]
    by_cases he : (if q ≥ 2 ^ 53 then k + 1 else k) + 1075 ≥ 2047
    · simp only [he, ↓reduceIte]
      exact floatCheckFlToF64Inf s
    · simp only [he, ↓reduceIte]
      exact floatCheckFlToF64OfBits _

theorem floatCheckFlToF64RoundRat (n : Int) (d : Nat) (s : Bool)
    (he : -1075 ≤ Fl.floorLog2Rat n.natAbs d) :
    Fl.toF64 (Fl.roundRat n d s : Fl double) = F64.roundRat n d s := by
  rw [f64_roundRat_eq]
  unfold Fl.roundRat
  change Fl.toF64 (if d == 0 then if n == 0 then Fl.nan else Fl.inf (decide (n < 0))
    else if n == 0 then Fl.zero s else
      if f64Fl2 n.natAbs d ≥ 1024 then Fl.inf (decide (n < 0))
      else if f64Fl2 n.natAbs d < -1076 then Fl.zero (decide (n < 0))
      else let k := max (f64Fl2 n.natAbs d - 52) (-1074)
           let scaled := if k ≥ 0 then (n.natAbs, d * 2 ^ k.toNat) else (n.natAbs * 2 ^ (-k).toNat, d)
           Fl.packRounded (decide (n < 0)) (f64Rq scaled.1 scaled.2) k) = _
  by_cases hd : d == 0
  · by_cases hn : n == 0
    · simp only [hd, hn, ↓reduceIte]
      exact floatCheckFlToF64OfBits _
    · simp only [hd, hn, Bool.false_eq_true, ↓reduceIte]
      exact floatCheckFlToF64Inf _
  · simp only [hd, Bool.false_eq_true, ↓reduceIte]
    by_cases hn : n == 0
    · simp only [hn, ↓reduceIte]
      exact floatCheckFlToF64Zero _
    · simp only [hn, Bool.false_eq_true, ↓reduceIte]
      by_cases ho : f64Fl2 n.natAbs d ≥ 1024
      · simp only [ho, ↓reduceIte]
        exact floatCheckFlToF64Inf _
      · simp only [ho, ↓reduceIte]
        have hu : ¬ f64Fl2 n.natAbs d < -1075 := by change -1075 ≤ f64Fl2 n.natAbs d at he; omega
        have hu' : ¬ f64Fl2 n.natAbs d < -1076 := by omega
        simp only [hu, hu', ↓reduceIte]
        exact floatCheckFlToF64Pack _ _ _

theorem floatCheckFlToF64Classes (x : Fl double) :
    F64.isfinite (Fl.toF64 x) = x.isfinite ∧ F64.isnan (Fl.toF64 x) = x.isnan ∧
      F64.iszero (Fl.toF64 x) = x.iszero ∧ F64.signbit (Fl.toF64 x) = x.signbit ∧
      F64.exponentField (Fl.toF64 x) = x.expField := by
  have hmag : F64.toBits (F64.abs (Fl.toF64 x)) = x.magnitude := by
    unfold F64.abs
    simp only [F64.toBits, F64.ofBits, BitVec.toNat_ofNat]
    change (F64.toBits (Fl.toF64 x) % 2 ^ 63) % 2 ^ 64 = x.magnitude
    rw [floatCheckFlToF64Bits]
    change (x.toBits % 2 ^ 63) % 2 ^ 64 = x.toBits % 2 ^ 63
    have ht := Nat.mod_lt x.toBits (show 0 < 2 ^ 63 by decide)
    exact Nat.mod_eq_of_lt (by omega)
  simp only [F64.isfinite, F64.isnan, F64.iszero, F64.signbit, F64.exponentField,
    F64.fraction, floatCheckFlToF64Bits, hmag]
  exact ⟨rfl, rfl, rfl, rfl, rfl⟩

/-- A rational safely inside the normal binary64 range rounds to a finite nonzero value. -/
theorem floatCheckRoundRatNormal (n : Int) (d : Nat) (s : Bool)
    (hn : n ≠ 0) (hd : d ≠ 0)
    (hlo : -1022 ≤ Fl.floorLog2Rat n.natAbs d)
    (hhi : Fl.floorLog2Rat n.natAbs d ≤ 1022) :
    F64.isfinite (F64.roundRat n d s) = true ∧ F64.iszero (F64.roundRat n d s) = false := by
  obtain ⟨hf, hz, _, _⟩ := floatCheckFlRoundRatNormal double n d s hn hd
    (by change 1 ≤ Fl.floorLog2Rat n.natAbs d + 1023; omega)
    (by change Fl.floorLog2Rat n.natAbs d + 1023 + 1 < 2047; omega)
  rw [← floatCheckFlToF64RoundRat n d s (by omega)]
  obtain ⟨h1, _, h3, _, _⟩ := floatCheckFlToF64Classes (Fl.roundRat n d s : Fl double)
  exact ⟨h1.trans hf, h3.trans hz⟩


/-- Unsigned decoding separates the sign from the significand and power of two. -/
theorem floatCheckFlRatAbs (f : Fmt) (x : Fl f) (hf : x.isfinite = true) :
    let m := x.frac + if x.expField == 0 then 0 else 2 ^ f.sb
    let p : Int := if x.expField == 0 then 1 - (f.bias : Int) - f.sb else (x.expField : Int) - f.bias - f.sb
    (x.toRat.1.natAbs, x.toRat.2) =
      if p ≥ 0 then (m * 2 ^ p.toNat, 1) else (m, 2 ^ (-p).toNat) := by
  unfold Fl.toRat
  simp only [hf, Bool.not_true, Bool.false_eq_true, ↓reduceIte]
  by_cases hp : 0 ≤ (if x.expField == 0 then 1 - (f.bias : Int) - f.sb else
      (x.expField : Int) - f.bias - f.sb)
  · simp only [hp, ↓reduceIte]
    cases hs : x.signbit <;> simp only [Bool.false_eq_true, ↓reduceIte,
      Int.natAbs_mul, Int.natAbs_natCast, Int.natAbs_neg]
  · simp only [hp, ↓reduceIte]
    cases hs : x.signbit <;> simp only [Bool.false_eq_true, ↓reduceIte,
      Int.natAbs_natCast, Int.natAbs_neg]

theorem floatCheckFlRatDenPos (f : Fmt) (x : Fl f) (hf : x.isfinite = true) :
    0 < x.toRat.2 := by
  have h := congrArg Prod.snd (floatCheckFlRatAbs f x hf)
  dsimp only at h
  by_cases he : 0 ≤ (if x.expField == 0 then 1 - (f.bias : Int) - f.sb else
      (x.expField : Int) - f.bias - f.sb)
  · simp only [he, ↓reduceIte] at h
    rw [h]
    decide
  · simp only [he, ↓reduceIte] at h
    rw [h]
    exact Nat.two_pow_pos _

theorem floatCheckFlFiniteExponent (f : Fmt) (x : Fl f) (hf : x.isfinite = true) :
    x.expField < f.emax := by
  have hu : x.expField < 2 ^ f.eb := Nat.mod_lt _ (Nat.two_pow_pos _)
  have hn : x.expField ≠ f.emax := by simpa only [Fl.isfinite, bne_iff_ne] using hf
  unfold Fmt.emax at hn ⊢
  omega

theorem floatCheckFlNonzeroMantissa (f : Fmt) (x : Fl f) (hz : x.iszero = false) :
    0 < x.frac + if x.expField == 0 then 0 else 2 ^ f.sb := by
  have hm : x.magnitude ≠ 0 := by simpa only [Fl.iszero, beq_eq_false_iff_ne] using hz
  rw [floatCheckFlExpMagnitude, floatCheckFlFracMagnitude]
  have hdiv := Nat.div_add_mod x.magnitude (2 ^ f.sb)
  split
  · rename_i he
    have he' : x.magnitude / 2 ^ f.sb = 0 := beq_iff_eq.mp he
    rw [he', Nat.mul_zero, Nat.zero_add] at hdiv
    omega
  · have hp := Nat.two_pow_pos f.sb
    omega

/-- A finite input lies between conservative power bounds appropriate to its format. -/
theorem floatCheckFlInputRatBounds (f : Fmt) (x : Fl f) (hf : x.isfinite = true) :
    0 < x.toRat.2 ∧ x.toRat.1.natAbs ≤ x.toRat.2 * 2 ^ f.emax ∧
      (x.iszero = false → x.toRat.2 ≤ x.toRat.1.natAbs * 2 ^ (f.bias + f.sb)) := by
  have hexp := floatCheckFlFiniteExponent f x hf
  have hfrac : x.frac < 2 ^ f.sb := Nat.mod_lt _ (Nat.two_pow_pos _)
  have hp := Nat.two_pow_pos f.sb
  have hrat := floatCheckFlRatAbs f x hf
  dsimp only at hrat
  refine ⟨floatCheckFlRatDenPos f x hf, ?_, ?_⟩
  · have hnum := congrArg Prod.fst hrat
    have hden := congrArg Prod.snd hrat
    dsimp only at hnum hden
    by_cases hz : x.expField == 0
    · have hexp0 : x.expField = 0 := beq_iff_eq.mp hz
      simp only [hz, ↓reduceIte, Nat.add_zero] at hnum hden
      by_cases he : 0 ≤ 1 - (f.bias : Int) - f.sb
      · simp only [he, ↓reduceIte] at hnum hden
        rw [hnum, hden, Nat.one_mul]
        have hpw : f.sb + (1 - (f.bias : Int) - f.sb).toNat ≤ f.emax := by
          have := Nat.two_pow_pos f.eb
          unfold Fmt.emax Fmt.bias at *
          omega
        calc
          x.frac * 2 ^ (1 - (f.bias : Int) - f.sb).toNat ≤
              2 ^ f.sb * 2 ^ (1 - (f.bias : Int) - f.sb).toNat := Nat.mul_le_mul_right _ (Nat.le_of_lt hfrac)
          _ = 2 ^ (f.sb + (1 - (f.bias : Int) - f.sb).toNat) := (Nat.pow_add _ _ _).symm
          _ ≤ 2 ^ f.emax := Nat.pow_le_pow_right (by decide) hpw
      · simp only [he, ↓reduceIte] at hnum hden
        rw [hnum, hden, ← Nat.pow_add]
        have hpw : f.sb ≤ (-(1 - (f.bias : Int) - f.sb)).toNat + f.emax := by
          unfold Fmt.emax Fmt.bias at *
          have := Nat.two_pow_pos f.eb
          omega
        exact Nat.le_trans (Nat.le_of_lt hfrac) (Nat.pow_le_pow_right (by decide) hpw)
    · simp only [hz, Bool.false_eq_true, ↓reduceIte] at hnum hden
      have hm : x.frac + 2 ^ f.sb < 2 ^ (f.sb + 1) := by rw [Nat.pow_succ]; omega
      by_cases he : 0 ≤ (x.expField : Int) - f.bias - f.sb
      · simp only [he, ↓reduceIte] at hnum hden
        rw [hnum, hden, Nat.one_mul]
        calc
          (x.frac + 2 ^ f.sb) * 2 ^ ((x.expField : Int) - f.bias - f.sb).toNat ≤
              2 ^ (f.sb + 1) * 2 ^ ((x.expField : Int) - f.bias - f.sb).toNat := Nat.mul_le_mul_right _ (Nat.le_of_lt hm)
          _ = 2 ^ (f.sb + 1 + ((x.expField : Int) - f.bias - f.sb).toNat) := (Nat.pow_add _ _ _).symm
          _ ≤ 2 ^ f.emax := Nat.pow_le_pow_right (by decide) (by omega)
      · simp only [he, ↓reduceIte] at hnum hden
        rw [hnum, hden, ← Nat.pow_add]
        exact Nat.le_trans (Nat.le_of_lt hm) (Nat.pow_le_pow_right (by decide) (by omega))
  · intro hz
    have hmpos := floatCheckFlNonzeroMantissa f x hz
    have hnum := congrArg Prod.fst hrat
    have hden := congrArg Prod.snd hrat
    dsimp only at hnum hden
    by_cases he : 0 ≤ (if x.expField == 0 then 1 - (f.bias : Int) - f.sb else (x.expField : Int) - f.bias - f.sb)
    · simp only [he, ↓reduceIte] at hnum hden
      rw [hnum, hden]
      exact Nat.mul_pos (Nat.mul_pos hmpos (Nat.two_pow_pos _)) (Nat.two_pow_pos _)
    · simp only [he, ↓reduceIte] at hnum hden
      rw [hnum, hden]
      have hl : (-(if x.expField == 0 then 1 - (f.bias : Int) - f.sb else
          (x.expField : Int) - f.bias - f.sb)).toNat ≤ f.bias + f.sb := by
        split <;> omega
      calc
        2 ^ (-(if x.expField == 0 then 1 - (f.bias : Int) - f.sb else
          (x.expField : Int) - f.bias - f.sb)).toNat ≤ 2 ^ (f.bias + f.sb) :=
            Nat.pow_le_pow_right (by decide) hl
        _ ≤ (x.frac + if x.expField == 0 then 0 else 2 ^ f.sb) * 2 ^ (f.bias + f.sb) := by
          have h := Nat.mul_le_mul_right (2 ^ (f.bias + f.sb)) hmpos
          simpa only [Nat.one_mul] using h


/-- Normal exponent-field bounds give corresponding rational magnitude bounds. -/
theorem floatCheckFlNormalRatBounds (f : Fmt) (x : Fl f) (hf : x.isfinite = true)
    (hexp : 0 < x.expField) (lo hi : Nat)
    (hlo : -(lo : Int) ≤ (x.expField : Int) - f.bias)
    (hhi : (x.expField : Int) - f.bias + 1 ≤ hi) :
    0 < x.toRat.1.natAbs ∧ x.toRat.2 ≤ x.toRat.1.natAbs * 2 ^ lo ∧
      x.toRat.1.natAbs ≤ x.toRat.2 * 2 ^ hi := by
  have hfraction : x.frac < 2 ^ f.sb := Nat.mod_lt _ (Nat.two_pow_pos _)
  have hmlo : 2 ^ f.sb ≤ x.frac + 2 ^ f.sb := by omega
  have hmhi : x.frac + 2 ^ f.sb ≤ 2 ^ (f.sb + 1) := by rw [Nat.pow_succ]; omega
  have hmpos : 0 < x.frac + 2 ^ f.sb := Nat.lt_of_lt_of_le (Nat.two_pow_pos _) hmlo
  have he0 : (x.expField == 0) = false := beq_eq_false_iff_ne.mpr (by omega)
  have hr := floatCheckFlRatAbs f x hf
  simp only [he0, Bool.false_eq_true, ↓reduceIte] at hr
  have hn := congrArg Prod.fst hr
  have hd := congrArg Prod.snd hr
  dsimp only at hn hd
  by_cases hp : 0 ≤ (x.expField : Int) - f.bias - f.sb
  · simp only [hp, ↓reduceIte] at hn hd
    rw [hn, hd]
    refine ⟨Nat.mul_pos hmpos (Nat.two_pow_pos _), ?_, ?_⟩
    · exact Nat.mul_pos (Nat.mul_pos hmpos (Nat.two_pow_pos _)) (Nat.two_pow_pos _)
    · rw [Nat.one_mul]
      calc
        (x.frac + 2 ^ f.sb) * 2 ^ ((x.expField : Int) - f.bias - f.sb).toNat ≤
            2 ^ (f.sb + 1) * 2 ^ ((x.expField : Int) - f.bias - f.sb).toNat := Nat.mul_le_mul_right _ hmhi
        _ = 2 ^ (f.sb + 1 + ((x.expField : Int) - f.bias - f.sb).toNat) := (Nat.pow_add _ _ _).symm
        _ ≤ 2 ^ hi := Nat.pow_le_pow_right (by decide) (by omega)
  · simp only [hp, ↓reduceIte] at hn hd
    rw [hn, hd]
    refine ⟨hmpos, ?_, ?_⟩
    · calc
        2 ^ (-((x.expField : Int) - f.bias - f.sb)).toNat ≤ 2 ^ (f.sb + lo) :=
          Nat.pow_le_pow_right (by decide) (by omega)
        _ = 2 ^ f.sb * 2 ^ lo := Nat.pow_add _ _ _
        _ ≤ (x.frac + 2 ^ f.sb) * 2 ^ lo := Nat.mul_le_mul_right _ hmlo
    · calc
        x.frac + 2 ^ f.sb ≤ 2 ^ (f.sb + 1) := hmhi
        _ ≤ 2 ^ ((-((x.expField : Int) - f.bias - f.sb)).toNat + hi) :=
          Nat.pow_le_pow_right (by decide) (by omega)
        _ = 2 ^ (-((x.expField : Int) - f.bias - f.sb)).toNat * 2 ^ hi := Nat.pow_add _ _ _

/-- Coarse magnitude bounds are preserved, with two spare powers of two, by normal rounding. -/
theorem floatCheckFlRoundRatBounds (f : Fmt) (n : Int) (d lo hi : Nat) (s : Bool)
    (hn : n ≠ 0) (hd : d ≠ 0)
    (hlo : d ≤ n.natAbs * 2 ^ lo) (hhi : n.natAbs ≤ d * 2 ^ hi)
    (flo : lo + 2 ≤ f.bias) (fhi : hi + f.bias + 1 < f.emax) :
    let x := (Fl.roundRat n d s : Fl f)
    x.isfinite = true ∧ x.iszero = false ∧
      x.toRat.2 ≤ x.toRat.1.natAbs * 2 ^ (lo + 1) ∧
      x.toRat.1.natAbs ≤ x.toRat.2 * 2 ^ (hi + 2) := by
  have ha : n.natAbs ≠ 0 := by omega
  have hl := floatCheckFloorLogBounds n.natAbs d lo hi ha hd hlo hhi
  have helo : 1 ≤ Fl.floorLog2Rat n.natAbs d + f.bias := by omega
  have hehi : Fl.floorLog2Rat n.natAbs d + f.bias + 1 < f.emax := by omega
  obtain ⟨hfinite, hzero, hele, hege⟩ := floatCheckFlRoundRatNormal f n d s hn hd helo hehi
  have hpositive : 0 < (Fl.roundRat n d s : Fl f).expField := by omega
  obtain ⟨_, hlow, hhigh⟩ := floatCheckFlNormalRatBounds f (Fl.roundRat n d s) hfinite hpositive
    (lo + 1) (hi + 2) (by omega) (by omega)
  exact ⟨hfinite, hzero, hlow, hhigh⟩


/-- A finite zero is exactly a zero rational, and conversely. -/
theorem floatCheckFlRatZeroIff (f : Fmt) (x : Fl f) (hf : x.isfinite = true) :
    x.toRat.1 = 0 ↔ x.iszero = true := by
  constructor
  · intro hn
    by_cases hz : x.iszero = true
    · exact hz
    · have hzf : x.iszero = false := Bool.eq_false_iff.mpr hz
      have hm := floatCheckFlNonzeroMantissa f x hzf
      have hr := congrArg Prod.fst (floatCheckFlRatAbs f x hf)
      dsimp only at hr
      rw [hn] at hr
      by_cases hp : 0 ≤ (if x.expField == 0 then 1 - (f.bias : Int) - f.sb else
          (x.expField : Int) - f.bias - f.sb)
      · simp only [hp, ↓reduceIte, Int.natAbs_zero] at hr
        have hh := Nat.mul_pos hm (Nat.two_pow_pos (if x.expField == 0 then
          1 - (f.bias : Int) - f.sb else (x.expField : Int) - f.bias - f.sb).toNat)
        omega
      · simp only [hp, ↓reduceIte, Int.natAbs_zero] at hr
        omega
  · intro hz
    have hm : x.magnitude = 0 := by simpa only [Fl.iszero, beq_iff_eq] using hz
    have he : x.expField = 0 := by rw [floatCheckFlExpMagnitude, hm, Nat.zero_div]
    have hf' : x.frac = 0 := by rw [floatCheckFlFracMagnitude, hm, Nat.zero_mod]
    have hr := congrArg Prod.fst (floatCheckFlRatAbs f x hf)
    simp only [he, hf', beq_self_eq_true, ↓reduceIte, Nat.add_zero, Nat.zero_mul] at hr
    have hzero : x.toRat.1.natAbs = 0 := by split at hr <;> exact hr
    omega

theorem floatCheckFlZeroBasics (f : Fmt) (hem : 0 < f.emax) (s : Bool) :
    (Fl.zero s : Fl f).isfinite = true ∧ (Fl.zero s : Fl f).iszero = true ∧
      (Fl.zero s : Fl f).toRat.1 = 0 := by
  have hz : (Fl.zero s : Fl f) = floatCheckFlPack s 0 0 := by
    simp only [Fl.zero, floatCheckFlPack, Nat.zero_mul, Nat.zero_add, Nat.add_zero]
  obtain ⟨_, he, _⟩ := floatCheckFlPackParts (f := f) s 0 0 (Nat.two_pow_pos _) (Nat.two_pow_pos _)
  have hf : (Fl.zero s : Fl f).isfinite = true := by
    rw [hz]
    simp only [Fl.isfinite, he, bne_iff_ne]
    omega
  have hzero : (Fl.zero s : Fl f).iszero = true := by
    unfold Fl.iszero Fl.magnitude Fl.zero
    rw [floatCheckFlOfBits, floatCheckFlWidth]
    have hp := Nat.two_pow_pos (f.eb + f.sb)
    cases s
    · simp only [Bool.false_eq_true, ↓reduceIte, Nat.zero_mod, beq_self_eq_true]
    · simp only [↓reduceIte, Nat.mod_eq_of_lt (show 2 ^ (f.eb + f.sb) < 2 * 2 ^ (f.eb + f.sb) by omega), Nat.mod_self, beq_self_eq_true]
  exact ⟨hf, hzero, (floatCheckFlRatZeroIff f _ hf).mpr hzero⟩

/-- Conservative magnitude bounds for a rational, with a lower bound only when nonzero. -/
def floatCheckRatBounds (lo hi : Nat) (n : Int) (d : Nat) : Prop :=
  0 < d ∧ n.natAbs ≤ d * 2 ^ hi ∧ (n ≠ 0 → d ≤ n.natAbs * 2 ^ lo)

/-- The finite IEEE value satisfies the rational range invariant. -/
def floatCheckFlBounds (f : Fmt) (lo hi : Nat) (x : Fl f) : Prop :=
  x.isfinite = true ∧ floatCheckRatBounds lo hi x.toRat.1 x.toRat.2

theorem floatCheckFlInputBounds (f : Fmt) (x : Fl f) (hf : x.isfinite = true) :
    floatCheckFlBounds f (f.bias + f.sb) f.emax x := by
  obtain ⟨hd, hu, hl⟩ := floatCheckFlInputRatBounds f x hf
  refine ⟨hf, hd, hu, ?_⟩
  intro hn
  have hz : x.iszero = false := by
    apply Bool.eq_false_iff.mpr
    intro hh
    exact hn ((floatCheckFlRatZeroIff f x hf).mpr hh)
  exact hl hz

theorem floatCheckFlZeroBounds (f : Fmt) (lo hi : Nat) (hem : 0 < f.emax) (s : Bool) :
    floatCheckFlBounds f lo hi (Fl.zero s) := by
  obtain ⟨hf, _, hn⟩ := floatCheckFlZeroBasics f hem s
  refine ⟨hf, floatCheckFlRatDenPos f _ hf, ?_, ?_⟩
  · rw [hn, Int.natAbs_zero]
    exact Nat.zero_le _
  · intro hh
    exact False.elim (hh hn)

theorem floatCheckFlRoundRatBounded (f : Fmt) (n : Int) (d lo hi : Nat) (s : Bool)
    (hb : floatCheckRatBounds lo hi n d)
    (flo : lo + 2 ≤ f.bias) (fhi : hi + f.bias + 1 < f.emax) :
    floatCheckFlBounds f (lo + 1) (hi + 2) (Fl.roundRat n d s) ∧
      ((Fl.roundRat n d s : Fl f).iszero = true ↔ n = 0) := by
  have hem : 0 < f.emax := by omega
  by_cases hn : n = 0
  · have hdb : (d == 0) = false := beq_eq_false_iff_ne.mpr (by have := hb.1; omega)
    have hz : (Fl.roundRat n d s : Fl f) = Fl.zero s := by
      simp only [Fl.roundRat, hdb, hn, beq_self_eq_true, Bool.false_eq_true, ↓reduceIte]
    rw [hz]
    exact ⟨floatCheckFlZeroBounds f _ _ hem s, by
      rw [(floatCheckFlZeroBasics f hem s).2.1]
      exact ⟨fun _ => hn, fun _ => rfl⟩⟩
  · obtain ⟨hf, hz, hl, hu⟩ := floatCheckFlRoundRatBounds f n d lo hi s hn
      (by have := hb.1; omega) (hb.2.2 hn) hb.2.1 flo fhi
    refine ⟨⟨hf, floatCheckFlRatDenPos f _ hf, hu, fun _ => hl⟩, ?_⟩
    simp only [hz, Bool.false_eq_true, hn]

theorem floatCheckRatBoundsWeaken {lo hi lo' hi' : Nat} {n : Int} {d : Nat}
    (hb : floatCheckRatBounds lo hi n d) (hl : lo ≤ lo') (hu : hi ≤ hi') :
    floatCheckRatBounds lo' hi' n d := by
  refine ⟨hb.1, ?_, ?_⟩
  · exact Nat.le_trans hb.2.1 (Nat.mul_le_mul_left d (Nat.pow_le_pow_right (by decide) hu))
  · intro hn
    exact Nat.le_trans (hb.2.2 hn) (Nat.mul_le_mul_left n.natAbs (Nat.pow_le_pow_right (by decide) hl))

theorem floatCheckRatBoundsMul {lo hi lo' hi' : Nat} {n m : Int} {d e : Nat}
    (hn : floatCheckRatBounds lo hi n d) (hm : floatCheckRatBounds lo' hi' m e) :
    floatCheckRatBounds (lo + lo') (hi + hi') (n * m) (d * e) := by
  refine ⟨Nat.mul_pos hn.1 hm.1, ?_, ?_⟩
  · rw [Int.natAbs_mul, Nat.pow_add]
    have h := Nat.mul_le_mul hn.2.1 hm.2.1
    simpa only [Nat.mul_assoc, Nat.mul_comm, Nat.mul_left_comm] using h
  · intro hnz
    have hnz' : n ≠ 0 := by intro h; rw [h, Int.zero_mul] at hnz; exact hnz rfl
    have hmz' : m ≠ 0 := by intro h; rw [h, Int.mul_zero] at hnz; exact hnz rfl
    rw [Int.natAbs_mul, Nat.pow_add]
    have h := Nat.mul_le_mul (hn.2.2 hnz') (hm.2.2 hmz')
    simpa only [Nat.mul_assoc, Nat.mul_comm, Nat.mul_left_comm] using h


/-- Adding nonnegative rationals loses at most one binary exponent in the upper bound. -/
theorem floatCheckRatBoundsAdd {lo hi : Nat} {n m : Int} {d e : Nat}
    (hn : floatCheckRatBounds lo hi n d) (hm : floatCheckRatBounds lo hi m e)
    (hns : 0 ≤ n) (hms : 0 ≤ m) :
    floatCheckRatBounds lo (hi + 1) (n * (e : Int) + m * (d : Int)) (d * e) := by
  have hncast : (n.natAbs : Int) = n := Int.natAbs_of_nonneg hns
  have hmcast : (m.natAbs : Int) = m := Int.natAbs_of_nonneg hms
  have habs : (n * (e : Int) + m * (d : Int)).natAbs = n.natAbs * e + m.natAbs * d := by
    rw [← hncast, ← hmcast, ← Int.natCast_mul, ← Int.natCast_mul, ← Int.natCast_add]
    exact Int.natAbs_natCast _
  refine ⟨Nat.mul_pos hn.1 hm.1, ?_, ?_⟩
  · rw [habs, Nat.pow_succ]
    have h1 := Nat.mul_le_mul_right e hn.2.1
    have h2 := Nat.mul_le_mul_right d hm.2.1
    have h2' : m.natAbs * d ≤ d * 2 ^ hi * e := by
      simpa only [Nat.mul_assoc, Nat.mul_comm, Nat.mul_left_comm] using h2
    have hsum : n.natAbs * e + m.natAbs * d ≤ d * 2 ^ hi * e * 2 := by omega
    simpa only [Nat.mul_assoc, Nat.mul_comm, Nat.mul_left_comm] using hsum
  · intro hnz
    by_cases hn0 : n = 0
    · have hm0 : m ≠ 0 := by intro hh; simp only [hn0, hh, Int.zero_mul, Int.zero_add] at hnz; exact hnz rfl
      have h := Nat.mul_le_mul_right d (hm.2.2 hm0)
      rw [habs, hn0, Int.natAbs_zero, Nat.zero_mul, Nat.zero_add]
      simpa only [Nat.mul_assoc, Nat.mul_comm, Nat.mul_left_comm] using h
    · have h := Nat.mul_le_mul_right e (hn.2.2 hn0)
      rw [habs]
      calc
        d * e ≤ n.natAbs * e * 2 ^ lo := by
          simpa only [Nat.mul_assoc, Nat.mul_comm, Nat.mul_left_comm] using h
        _ ≤ (n.natAbs * e + m.natAbs * d) * 2 ^ lo :=
          Nat.mul_le_mul_right _ (Nat.le_add_right _ _)

theorem floatCheckFlFiniteClasses (f : Fmt) (x : Fl f) (hf : x.isfinite = true) :
    x.isnan = false ∧ x.isinf = false := by
  have hne : (x.expField == f.emax) = false := by
    apply beq_eq_false_iff_ne.mpr
    simpa only [Fl.isfinite, bne_iff_ne] using hf
  simp only [Fl.isnan, Fl.isinf, hne, Bool.false_and]
  exact ⟨True.intro, True.intro⟩

theorem floatCheckFlFiniteOfClasses (f : Fmt) (x : Fl f)
    (hn : x.isnan = false) (hi : x.isinf = false) : x.isfinite = true := by
  unfold Fl.isnan at hn
  unfold Fl.isinf at hi
  unfold Fl.isfinite
  by_cases he : x.expField = f.emax
  · simp only [he, beq_self_eq_true, Bool.true_and] at hn hi
    cases h : x.frac == 0 <;> simp only [bne, h, Bool.not_false, Bool.not_true, Bool.true_eq_false] at hn hi
  · exact bne_iff_ne.mpr he

theorem floatCheckFlOfBitsRoundtrip {f : Fmt} (x : Fl f) : Fl.ofBits x.toBits = x := by
  cases x with
  | mk bits =>
    apply congrArg Fl.mk
    apply Fin.ext
    exact Nat.mod_eq_of_lt bits.isLt

theorem floatCheckFlRatSign (f : Fmt) (x : Fl f) (hf : x.isfinite = true) (hn : x.toRat.1 ≠ 0) :
    decide (x.toRat.1 < 0) = x.signbit := by
  unfold Fl.toRat at hn ⊢
  simp only [hf, Bool.not_true, Bool.false_eq_true, ↓reduceIte] at hn ⊢
  by_cases hp : 0 ≤ (if x.expField == 0 then 1 - (f.bias : Int) - f.sb else
      (x.expField : Int) - f.bias - f.sb)
  · simp only [hp, ↓reduceIte] at hn ⊢
    cases hs : x.signbit
    · simp only [hs, Bool.false_eq_true, ↓reduceIte] at hn ⊢
      apply decide_eq_false_iff_not.mpr
      exact Int.not_lt.mpr (Int.mul_nonneg (Int.natCast_nonneg _) (Int.natCast_nonneg _))
    · simp only [hs, ↓reduceIte] at hn ⊢
      apply decide_eq_true_iff.mpr
      have h : -(↑(x.frac + if x.expField == 0 then 0 else 2 ^ f.sb) : Int) *
          ↑(2 ^ (if x.expField == 0 then 1 - (f.bias : Int) - f.sb else
            (x.expField : Int) - f.bias - f.sb).toNat : Nat) ≤ 0 :=
        Int.mul_nonpos_of_nonpos_of_nonneg (by omega) (Int.natCast_nonneg _)
      omega
  · simp only [hp, ↓reduceIte] at hn ⊢
    cases hs : x.signbit <;> simp only [hs, Bool.false_eq_true, ↓reduceIte] at hn ⊢
    · apply decide_eq_false_iff_not.mpr
      omega
    · apply decide_eq_true_iff.mpr
      omega

/-- Conversions preserve the sign even for infinities and NaN payloads. -/
theorem floatCheckFlConvertSign (f g : Fmt) (hfs : 0 < f.sb) (hem : 0 < f.emax) (x : Fl g) :
    (Fl.convert x : Fl f).signbit = x.signbit := by
  by_cases heq : f = g
  · subst f
    simp only [Fl.convert, beq_self_eq_true, ↓reduceIte, floatCheckFlOfBitsRoundtrip]
  · have hneq : (f == g) = false := beq_eq_false_iff_ne.mpr heq
    unfold Fl.convert
    simp only [hneq, Bool.false_eq_true, ↓reduceIte]
    by_cases hn : x.isnan = true
    · simp only [hn, ↓reduceIte]
      let payload := if f.sb ≥ g.sb then x.frac * 2 ^ (f.sb - g.sb) else x.frac / 2 ^ (g.sb - f.sb)
      have hpay : payload < 2 ^ f.sb := by
        have hx : x.frac < 2 ^ g.sb := Nat.mod_lt _ (Nat.two_pow_pos _)
        dsimp only [payload]
        split
        · rename_i h
          calc x.frac * 2 ^ (f.sb - g.sb) < 2 ^ g.sb * 2 ^ (f.sb - g.sb) :=
              Nat.mul_lt_mul_of_pos_right hx (Nat.two_pow_pos _)
            _ = 2 ^ f.sb := by rw [← Nat.pow_add]; congr 1; omega
        · rename_i h
          apply (Nat.div_lt_iff_lt_mul (Nat.two_pow_pos _)).mpr
          calc x.frac < 2 ^ g.sb := hx
            _ = 2 ^ f.sb * 2 ^ (g.sb - f.sb) := by rw [← Nat.pow_add]; congr 1; omega
      have hquiet : 2 ^ (f.sb - 1) < 2 ^ f.sb := Nat.pow_lt_pow_right (by decide) (by omega)
      have hp := Nat.or_lt_two_pow hpay hquiet
      have he : f.emax < 2 ^ f.eb := by unfold Fmt.emax; have := Nat.two_pow_pos f.eb; omega
      have hpack : (Fl.ofBits ((if x.signbit then 2 ^ (f.eb + f.sb) else 0) + f.emax * 2 ^ f.sb +
          Nat.lor payload (2 ^ (f.sb - 1))) : Fl f) =
          floatCheckFlPack x.signbit f.emax (Nat.lor payload (2 ^ (f.sb - 1))) := by
        unfold floatCheckFlPack
        rw [Nat.add_assoc]
      change (Fl.ofBits ((if x.signbit then 2 ^ (f.eb + f.sb) else 0) + f.emax * 2 ^ f.sb +
        Nat.lor payload (2 ^ (f.sb - 1))) : Fl f).signbit = _
      rw [hpack]
      exact (floatCheckFlPackParts (f := f) x.signbit f.emax _ he hp).1
    · have hnf : x.isnan = false := Bool.eq_false_iff.mpr hn
      simp only [hnf, Bool.false_eq_true, ↓reduceIte]
      by_cases hi : x.isinf = true
      · simp only [hi, ↓reduceIte]
        exact (floatCheckFlInfClass f x.signbit).1
      · have hif : x.isinf = false := Bool.eq_false_iff.mpr hi
        simp only [hif, Bool.false_eq_true, ↓reduceIte]
        have hf := floatCheckFlFiniteOfClasses g x hnf hif
        have hd : x.toRat.2 ≠ 0 := by have := floatCheckFlRatDenPos g x hf; omega
        by_cases hz : x.toRat.1 = 0
        · have hdb : (x.toRat.2 == 0) = false := beq_eq_false_iff_ne.mpr hd
          simp only [Fl.roundRat, hdb, hz, beq_self_eq_true, Bool.false_eq_true, ↓reduceIte]
          exact (floatCheckFlZeroClass f x.signbit).1
        · exact (floatCheckFlRoundRatNonzeroClass f hem x.toRat.1 x.toRat.2 x.signbit hz hd).1.trans
            (floatCheckFlRatSign g x hf hz)

/-- A non-NaN operand remains non-NaN after a format conversion. -/
theorem floatCheckFlConvertNotNan (f g : Fmt) (hem : 0 < f.emax) (x : Fl g) (hn : x.isnan = false) :
    (Fl.convert x : Fl f).isnan = false := by
  by_cases heq : f = g
  · subst f
    simp only [Fl.convert, beq_self_eq_true, ↓reduceIte, floatCheckFlOfBitsRoundtrip, hn]
  · have hneq : (f == g) = false := beq_eq_false_iff_ne.mpr heq
    unfold Fl.convert
    simp only [hneq, hn, Bool.false_eq_true, ↓reduceIte]
    by_cases hi : x.isinf = true
    · simp only [hi, ↓reduceIte]
      exact (floatCheckFlInfClass f x.signbit).2
    · have hif : x.isinf = false := Bool.eq_false_iff.mpr hi
      simp only [hif, Bool.false_eq_true, ↓reduceIte]
      have hf := floatCheckFlFiniteOfClasses g x hn hif
      exact floatCheckFlRoundRatNotNan f hem x.toRat.1 x.toRat.2 x.signbit
        (by have := floatCheckFlRatDenPos g x hf; omega)


/-- Exact finite-rational decoding agrees across the two binary64 representations. -/
theorem floatCheckFlToF64Rat (x : Fl double) : F64.toRat (Fl.toF64 x) = x.toRat := by
  obtain ⟨hf, _, _, hs, he⟩ := floatCheckFlToF64Classes x
  have hfrac : F64.fraction (Fl.toF64 x) = x.frac := by
    unfold F64.fraction
    rw [floatCheckFlToF64Bits]
    rfl
  unfold F64.toRat Fl.toRat
  rw [hf, hs, he, hfrac]
  change (if !x.isfinite then (0, 0) else
    let m := x.frac + if x.expField == 0 then 0 else 2 ^ 52
    let p : Int := if x.expField == 0 then -1074 else (x.expField : Int) - 1075
    let s : Int := if x.signbit then -(m : Int) else (m : Int)
    if p ≥ 0 then (s * (2 ^ p.toNat : Nat), 1) else (s, 2 ^ (-p).toNat)) =
    (if !x.isfinite then (0, 0) else
    let m := x.frac + if x.expField == 0 then 0 else 2 ^ 52
    let p : Int := if x.expField == 0 then -1074 else (x.expField : Int) - 1023 - 52
    let s : Int := if x.signbit then -(m : Int) else (m : Int)
    if p ≥ 0 then (s * (2 ^ p.toNat : Nat), 1) else (s, 2 ^ (-p).toNat))
  have hpower : (x.expField : Int) - 1023 - 52 = (x.expField : Int) - 1075 := by omega
  rw [hpower]

theorem floatCheckFlToOfF64 (x : F64) : Fl.toF64 (Fl.ofF64 x) = x := by
  unfold Fl.ofF64
  rw [floatCheckFlToF64OfBits]
  apply BitVec.eq_of_toNat_eq
  exact Nat.mod_eq_of_lt x.isLt

theorem floatCheckFlOfToF64 (x : Fl double) : Fl.ofF64 (Fl.toF64 x) = x := by
  unfold Fl.ofF64
  rw [floatCheckFlToF64Bits, floatCheckFlOfBitsRoundtrip]

theorem floatCheckFlOfF64Classes (x : F64) :
    (Fl.ofF64 x).isfinite = F64.isfinite x ∧ (Fl.ofF64 x).isnan = F64.isnan x ∧
      (Fl.ofF64 x).iszero = F64.iszero x ∧ (Fl.ofF64 x).signbit = F64.signbit x ∧
      (Fl.ofF64 x).expField = F64.exponentField x := by
  obtain ⟨hf, hn, hz, hs, he⟩ := floatCheckFlToF64Classes (Fl.ofF64 x)
  rw [floatCheckFlToOfF64] at hf hn hz hs he
  exact ⟨hf.symm, hn.symm, hz.symm, hs.symm, he.symm⟩

theorem floatCheckFlOfF64Rat (x : F64) : (Fl.ofF64 x).toRat = F64.toRat x := by
  have h := floatCheckFlToF64Rat (Fl.ofF64 x)
  rw [floatCheckFlToOfF64] at h
  exact h.symm

