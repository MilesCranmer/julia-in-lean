  isreal := .inherited (fun value => pure (.boolean (iszero_JInt value)))
  isinteger := fun value => pure (.boolean (isinteger_JInt value))
  isfinite := fun value => pure (.boolean (isfinite_JInt value))
  isnan := fun value => pure (.boolean (isnan_JInt value))
  isinf := fun value => pure (.boolean (isinf_JInt value))
  iszero := fun value => pure (.boolean (iszero_JInt value))
  isone := fun value => pure (.boolean (isone_JInt value))
