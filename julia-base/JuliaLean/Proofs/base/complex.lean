abbrev ipow (k : Nat) : Int := ((2^k : Nat) : Int)

theorem ipow_mul (a b c : Nat) (h : a+b = c) : ipow a*ipow b = ipow c := by
  unfold ipow
  rw [← Int.natCast_mul, ← Nat.pow_add, h]

theorem ipow_product (a b c e : Nat) (h : a+b = c+e) : ipow a*ipow b = ipow c*ipow e := by
  rw [ipow_mul a b (a+b) rfl, ipow_mul c e (c+e) rfl, h]

theorem round_key_scaled (n : Int) (k : Nat) (s : Bool) :
    F64.roundRat (n*ipow (k+1074)) (2^2148) s = F64.roundRat (n*ipow k) (2^1074) s := by
  have hp := ipow_mul k 1074 (k+1074) rfl
  rw [← hp, ← Int.mul_assoc]
  have hd : (2^2148 : Nat) = 2^1074*2^1074 := by rw [← Nat.pow_add]
  rw [hd]
  exact Epsilon.round_scale _ _ _ _ (by have := Nat.two_pow_pos 1074; omega)

def residual (a b h : F64) : F64 :=
  let HH := F64.mul h h
  let AA := F64.mul a a
  F64.sub (F64.add (F64.fma (F64.neg b) b (F64.sub HH AA))
    (F64.fma h h (F64.neg HH))) (F64.fma a a (F64.neg AA))

theorem residual_key (p : Int) (d Q : Nat) (hp0 : -485 ≤ p) (hp1 : p ≤ 511) (hd : d ≤ 26)
    (hQ0 : 2^52 ≤ Q) (hQ1 : Q < 2^53) (cert : CorrectionCertificate d Q)
    (hHH : F64.isfinite (F64.mul (pk false Q (p-52)) (pk false Q (p-52))) = true)
    (kHH : key64 (F64.mul (pk false Q (p-52)) (pk false Q (p-52))) =
      (cert.R : Int)*ipow (cert.C+(2*p+970).toNat))
    (hAA : F64.isfinite (F64.mul (power p) (power p)) = true)
    (kAA : key64 (F64.mul (power p) (power p)) = ipow (2*p+1074).toNat)
    (hDiff : F64.isfinite (F64.sub (F64.mul (pk false Q (p-52)) (pk false Q (p-52)))
      (F64.mul (power p) (power p))) = true)
    (kDiff : key64 (F64.sub (F64.mul (pk false Q (p-52)) (pk false Q (p-52)))
      (F64.mul (power p) (power p))) = (cert.A : Int)*ipow (2*p+1022).toNat) :
    F64.isfinite (residual (power p) (power (p-d)) (pk false Q (p-52))) = true ∧
      key64 (residual (power p) (power (p-d)) (pk false Q (p-52))) = cert.K*ipow (2*p+970).toNat := by
  let a := power p
  let b := power (p-d)
  let h := pk false Q (p-52)
  let HH := F64.mul h h
  let AA := F64.mul a a
  let diff := F64.sub HH AA
  let U := (2*p+970).toNat
  have hU : (U : Int) = 2*p+970 := by dsimp only [U]; omega
  have hf := pack_key false Q (p-52) hQ0 hQ1 (by omega) (by omega)
  have hfin : F64.isfinite h = true := hf.1
  have hkey : key64 h = (Q : Int)*ipow (p+1022).toNat := by
    have he : p-52+1074 = p+1022 := by omega
    simpa only [SmallExact.signed, Bool.false_eq_true, ↓reduceIte, he, Int.natCast_mul] using hf.2.1
  have afin := (power_classes p (by omega) (by omega)).1
  have bfin := (power_classes (p-d) (by omega) (by omega)).1
