theorem round_exact_key_le (n : Int) (k : Nat) (s : Bool) (hn : n.natAbs ≤ 2^53)
    (htop : n.natAbs.log2+k ≤ 2097) :
    F64.isfinite (F64.roundRat (n*((2^k : Nat) : Int)) (2^1074) s) = true ∧
    key64 (F64.roundRat (n*((2^k : Nat) : Int)) (2^1074) s) = n*((2^k : Nat) : Int) := by
  by_cases hlt : n.natAbs < 2^53
  · exact round_exact_key n k s hlt htop
  have he : n.natAbs = 2^53 := by omega
  have hlog : n.natAbs.log2 = 53 := by rw [he, Nat.log2_two_pow]
  rcases Int.natAbs_eq n with hp | hp
  · have hnval : n = ((2^53 : Nat) : Int) := by rw [he] at hp; exact hp
    have heq : n*((2^k : Nat) : Int) = ((2^52 : Nat) : Int)*((2^(k+1) : Nat) : Int) := by
      rw [hnval, ← Int.natCast_mul, ← Int.natCast_mul, ← Nat.pow_add, ← Nat.pow_add]
      congr 2
      omega
    rw [heq]
    exact round_exact_key ((2^52 : Nat) : Int) (k+1) s (by decide)
      (by simp only [Int.natAbs_natCast, Nat.log2_two_pow]; omega)
  · have hnval : n = -((2^53 : Nat) : Int) := by rw [he] at hp; exact hp
    have heq : n*((2^k : Nat) : Int) = -((2^52 : Nat) : Int)*((2^(k+1) : Nat) : Int) := by
      rw [hnval, Int.neg_mul, Int.neg_mul, ← Int.natCast_mul, ← Int.natCast_mul, ← Nat.pow_add, ← Nat.pow_add]
      congr 3
      omega
    rw [heq]
    exact round_exact_key (-((2^52 : Nat) : Int)) (k+1) s (by decide)
      (by simp only [Int.natAbs_neg, Int.natAbs_natCast, Nat.log2_two_pow]; omega)

theorem pack_key (s : Bool) (Q : Nat) (k : Int) (hQ0 : 2^52 ≤ Q) (hQ1 : Q < 2^53)
    (hk0 : -1074 ≤ k) (hk1 : k ≤ 971) :
    F64.isfinite (pk s Q k) = true ∧
    key64 (pk s Q k) = SmallExact.signed s (Q*2^(k+1074).toNat) ∧
    F64.signbit (pk s Q k) = s := by
  rw [pk_norm s Q k hQ0 hQ1 hk0 hk1]
  have hE0 : 1 ≤ (k+1075).toNat := by omega
  have hE1 : (k+1075).toNat ≤ 2046 := by omega
  have hkey := key64_norm s (k+1075).toNat Q hE0 hE1 hQ0 hQ1
  have hf := Scalar.ProofMisc.norm_fields s (k+1075).toNat Q hE0 hE1 hQ0 hQ1
  dsimp only at hkey
  rw [Nat.add_assoc] at hkey hf
  have he : (k+1075).toNat-1 = (k+1074).toNat := by omega
  rw [he] at hkey
  exact ⟨hkey.1, hkey.2, hf.2.2.1⟩

theorem pack_positive_rat (Q : Nat) (k : Int) (hQ0 : 2^52 ≤ Q) (hQ1 : Q < 2^53)
    (hk0 : -1074 ≤ k) (hk1 : k ≤ 971) :
    ∃ i j : Nat, F64.toRat (pk false Q k) = (((Q*2^i : Nat) : Int),2^j) ∧ (i : Int)-j = k := by
  rw [pk_norm false Q k hQ0 hQ1 hk0 hk1]
  simp only [Bool.false_eq_true, ↓reduceIte, Nat.zero_add]
  let E := (k+1075).toNat
  let x := F64.ofBits (E*2^52+(Q-2^52))
  have hf := Scalar.ProofMisc.norm_fields false E Q (by dsimp only [E]; omega)
    (by dsimp only [E]; omega) hQ0 hQ1
  simp only [Bool.false_eq_true, ↓reduceIte, Nat.zero_add] at hf
  change F64.toBits x/2^52%2048 = E ∧ F64.toBits x%2^52 = Q-2^52 ∧
    F64.signbit x = false ∧ F64.isfinite x = true at hf
  change ∃ i j : Nat, F64.toRat x = (((Q*2^i : Nat) : Int),2^j) ∧ (i : Int)-j = k
  have hM : Q-2^52+2^52 = Q := Nat.sub_add_cancel hQ0
  by_cases hsmall : E ≤ 1074
  · rw [toRat_norm x (by rw [hf.1]; dsimp only [E]; omega) (by rw [hf.1]; exact hsmall),
      hf.1, hf.2.1, hf.2.2.1, hM]
    simp only [Bool.false_eq_true, ↓reduceIte]
    exact ⟨0,1075-E, by simp only [Nat.pow_zero, Nat.mul_one], by dsimp only [E] at *; omega⟩
  · rw [toRat_big x (by rw [hf.1]; omega) (by rw [hf.1]; dsimp only [E]; omega),
      hf.1, hf.2.1, hf.2.2.1, hM]
    simp only [Bool.false_eq_true, ↓reduceIte]
    exact ⟨E-1075,0, by rw [Int.natCast_mul], by dsimp only [E] at *; omega⟩

theorem power_key (p : Int) (hp0 : -1022 ≤ p) (hp1 : p ≤ 1023) :
    key64 (power p) = ((2^(p+1074).toNat : Nat) : Int) := by
  have heq : power p = pk false (2^52) (p-52) := by
    rw [pk_norm false _ _ (by decide) (by decide) (by omega) (by omega)]
    simp only [power, show ¬p < -1022 by omega, ↓reduceIte, Bool.false_eq_true,
      Nat.sub_self, Nat.add_zero, Nat.zero_add]
    congr 2
    omega
  rw [heq, (pack_key false _ _ (by decide) (by decide) (by omega) (by omega)).2.1]
  simp only [SmallExact.signed, Bool.false_eq_true, ↓reduceIte]
  rw [← Nat.pow_add]
  congr 2
  omega

