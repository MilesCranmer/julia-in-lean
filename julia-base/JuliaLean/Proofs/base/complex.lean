    hm.1 (by omega) (by omega) (by omega) he hm.2.2

theorem tail_raw (a t : Int) (d : Nat) (ha0 : -511 ≤ a) (ha1 : a ≤ 511)
    (ht0 : -1074 ≤ t) (ht1 : t ≤ 1023) (hd : d ≤ 26)
    (hp0 : -1074 ≤ a+t) (hp1 : a+t ≤ 971)
    (hcorr : Epsilon.correction (power a) (power (a-(d : Int)))
      (F64.ofBits ((a+1023).toNat*2^52+(coefficient d-2^52))) =
      F64.ofBits ((a+1023).toNat*2^52+(coefficient d-2^52))) :
    ∃ i j : Nat, (i : Int)-(j : Int) = a+t-52 ∧
      Epsilon.tail (power a) (power (a-(d : Int))) (power t) =
        .ok (F64.roundRat ((coefficient d*2^i : Nat) : Int) (2^j) false) := by
  have hcoef := coefficient_bounds d hd
  obtain ⟨i,j,he,hprod⟩ := product_normal_power a t (coefficient d) ha0 ha1 ht0 ht1 hcoef.1 hcoef.2.1
