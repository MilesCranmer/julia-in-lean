namespace JuliaLean.ChatGPT.Batch10.Group1
open JuliaLean JuliaLean.Float JuliaLean.Promotion JuliaLean.base.complex
open JuliaLean.Proofs.base.complex
open JuliaLean.base.complex.Models1Group19
open JuliaLean.Proofs.base.complex.Models1Group19
open Scalar.ProofsBits
set_option maxRecDepth 100000
set_option maxHeartbeats 200000
set_option exponentiation.threshold 5000

def floatCheckEpsilonBits (k : Nat) : Nat :=
  if k < 52 then 2 ^ k else (k - 51) * 2 ^ 52

theorem floatCheckEpsilonBitsBound (k : Nat) (hk : k ≤ 2045) :
    0 < floatCheckEpsilonBits k ∧ floatCheckEpsilonBits k < 2047 * 2 ^ 52 := by
  unfold floatCheckEpsilonBits
  split
  · rename_i h
    have hp := Nat.two_pow_pos k
    have hu := Nat.pow_lt_pow_right (by decide : 1 < 2) h
    omega
  · omega

theorem floatCheckAbsSignedBits (s : Bool) (m : Nat) (hm : m < 2 ^ 63) :
    F64.abs (F64.ofBits ((if s then 2 ^ 63 else 0) + m)) = F64.ofBits m := by
  apply BitVec.eq_of_toNat_eq
  change F64.toBits (F64.abs _) = F64.toBits _
  rw [tb_abs, tb_ofBits, tb_ofBits]
  cases s <;> simp only [Bool.false_eq_true, ↓reduceIte, Nat.zero_add] <;> omega

theorem floatCheckRoundPower (i j k : Nat) (s zs : Bool)
    (hij : i + 1074 = j + k) (hk : k ≤ 2045) :
    F64.abs (F64.roundRat (SmallExact.signed s (2 ^ i)) (2 ^ j) zs) =
      F64.ofBits (floatCheckEpsilonBits k) := by
  have hlog : Fl.floorLog2Rat (SmallExact.signed s (2 ^ i)).natAbs (2 ^ j) = (i : Int) - j := by
    rw [SmallExact.signed_natAbs, SmallExact.floorLog2Rat_pow _ _ (Nat.ne_of_gt (Nat.two_pow_pos _)), Nat.log2_two_pow]
  rw [← floatCheckFlToF64RoundRat _ _ _ (by rw [hlog]; omega)]
  have heq : SmallExact.signed s (2 ^ i) * ((2 ^ 1074 : Nat) : Int) =
      SmallExact.signed s (2 ^ k) * ((2 ^ j : Nat) : Int) := by
    rw [SmallExact.signed_mul, SmallExact.signed_mul, ← Nat.pow_add, ← Nat.pow_add]
    rw [hij, Nat.add_comm j k]
  rw [floatCheckFlRoundRatDyadicEq double _ _ j 1074 zs heq]
  by_cases hsub : k < 52
  · have hp : 2 ^ k < 2 ^ 52 := by
      exact Nat.pow_lt_pow_right (by decide) hsub
    have hr := SmallExact.roundRat_subnormal_signed SmallExact.good_double s (2 ^ k) 0 1074 zs
      (Nat.two_pow_pos _) hp (by decide)
    simp only [Nat.pow_zero, Nat.mul_one] at hr
    rw [hr]
    change F64.abs (Fl.toF64 (Fl.ofBits ((if s then 2^63 else 0) + (0 * 2^52 + 2^k)) : Fl double)) = _
    rw [floatCheckFlToF64OfBits]
    simp only [Nat.zero_mul, Nat.zero_add, floatCheckEpsilonBits, hsub, ↓reduceIte]
    exact floatCheckAbsSignedBits s (2^k) (by omega)
  · have hr := SmallExact.roundRat_normal_signed SmallExact.good_double s 1 k 1074 zs
      (by decide) (by decide) (by change 1075 ≤ 0+k+1023; omega)
      (by change 0+k+1023 < 1074+2047; omega)
    simp only [Nat.one_mul, (show Nat.log2 1 = 0 from rfl), Nat.zero_add, Nat.sub_zero, Nat.sub_self] at hr
    rw [hr]
    change F64.abs (Fl.toF64 (Fl.ofBits ((if s then 2^63 else 0) +
      ((k+1023-1074) * 2^52 + 0)) : Fl double)) = _
    rw [floatCheckFlToF64OfBits]
    simp only [Nat.sub_zero, Nat.one_mul, Nat.sub_self, Nat.add_zero]
    have he : k+1023-1074 = k-51 := by omega
    rw [he]
    have hb := floatCheckEpsilonBitsBound k hk
    simp only [floatCheckEpsilonBits, hsub, ↓reduceIte] at hb ⊢
    exact floatCheckAbsSignedBits s _ (by omega)

theorem floatCheckXorOneDifference (a : Nat) :
    ((a ^^^ 1 : Nat) : Int) - (a : Int) = if a % 2 = 0 then 1 else -1 := by
  have hd : (a ^^^ 1) / 2 = a / 2 := by rw [Nat.xor_div_two]; exact Nat.xor_zero _
  have hm : ((a ^^^ 1) % 2 = 1) ↔ a % 2 = 0 := by
    rw [Nat.xor_mod_two_eq_one]
    simp only [Nat.one_mod, Nat.reduceEqDiff, iff_true]
    have ha := Nat.mod_two_eq_zero_or_one a
    omega
  have h0 := Nat.mod_two_eq_zero_or_one a
  have h1 := Nat.mod_two_eq_zero_or_one (a ^^^ 1)
  have hv0 := Nat.mod_add_div a 2
