  before : State
  after : State
  failure : Option E
  returned : Option Result

structure MixedWorld (E State Cache Result : Type) where
  user : State
  cache : Cache
  history : List (MixedReceipt E State Result)

abbrev MixedObservedM (E State Cache Result : Type) :=
  MixedM E (MixedWorld E State Cache Result)

/-- Instrument a selected call without changing its user state, result,
exception, or divergence.  A successful result updates only the observer's
private cache, enabling subsequent data-dependency checks. -/
def MixedObserve {E State Cache Result A : Type}
    (label : Cache → String) (arguments : Cache → Prop)
    (update : Cache → A → Cache) (returned : A → Option Result)
    (action : MixedM E State A) : MixedObservedM E State Cache Result A :=
  fun world =>
    match action world.user with
    | none => none
    | some (outcome, after) =>
      let receipt : MixedReceipt E State Result :=
        { label := label world.cache, arguments := arguments world.cache
          before := world.user, after := after
          failure := match outcome with | .ok _ => none | .error error => some error
          returned := match outcome with | .ok value => returned value | .error _ => none }
      let cache := match outcome with
        | .ok value => update world.cache value
        | .error _ => world.cache
      some (outcome, { user := after, cache := cache, history := world.history ++ [receipt] })

def MixedStart {E State Cache Result : Type} (state : State) (cache : Cache) :
    MixedWorld E State Cache Result := ⟨state, cache, []⟩

/-- Totality of an arbitrary selected call in every possible user state. -/
def MixedTotal {E State A : Type} (action : MixedM E State A) : Prop :=
  ∀ state, ∃ result, action state = some result

/-- No state transition is inserted, discarded or reordered around selected
calls, including the mutation performed by the final failing call. -/
def MixedStateChain {E State Result : Type} (initial final : State) :
    List (MixedReceipt E State Result) → Prop
  | [] => final = initial
  | call :: rest => call.before = initial ∧ MixedStateChain call.after final rest

/-- An independent finite-call protocol: exact successful call counts/order,
argument forwarding, final result identity, first-error propagation, and state
continuity.  Divergence cannot be manufactured from total selected callees. -/
def MixedAudit {E State Cache Result : Type} (allTotal : Prop)
    (expected : List String) (initial : State)
    (observation : Option (Except E Result × MixedWorld E State Cache Result)) : Prop :=
  match observation with
  | none => ¬ allTotal
  | some (.ok value, world) =>
      world.history.map (fun call => call.label) = expected ∧
      (∀ call ∈ world.history, call.arguments ∧ call.failure = none) ∧
      MixedStateChain initial world.user world.history ∧
      ∃ earlier last, world.history = earlier ++ [last] ∧ last.returned = some value
  | some (.error error, world) =>
      (∃ suffix, world.history.map (fun call => call.label) ++ suffix = expected) ∧
      (∀ call ∈ world.history, call.arguments) ∧
      MixedStateChain initial world.user world.history ∧
      ∃ earlier last, world.history = earlier ++ [last] ∧
        (∀ call ∈ earlier, call.failure = none) ∧ last.failure = some error

/-- Protocol for one scalar call followed by a constructor, retaining the
original imaginary field.  The expected scalar argument order is explicit. -/
def MixedScalarLeftAudit {E State Scalar A R Result : Type}
    (body : ScalarLeftOps (MixedObservedM E State (Option R) Result) Scalar A R Result →
      Scalar → Complex A → MixedObservedM E State (Option R) Result Result)
    (ops : ScalarLeftOps (MixedM E State) Scalar A R Result)
    (x : Scalar) (z : Complex A) (state : State) : Prop :=
  let observed : ScalarLeftOps (MixedObservedM E State (Option R) Result) Scalar A R Result :=
    { operation := fun a b => MixedObserve (fun _ => "operation")
        (fun _ => a = x ∧ b = z.re) (fun _ value => some value) (fun _ => none)
        (ops.operation a b)
      construct := fun r i => MixedObserve (fun _ => "construct")
        (fun previous => previous = some r ∧ i = z.im) (fun previous _ => previous) some
        (ops.construct r i) }
  MixedAudit ((∀ a b, MixedTotal (ops.operation a b)) ∧
      (∀ r i, MixedTotal (ops.construct r i))) ["operation", "construct"] state
    (body observed x z (MixedStart state none))

/-- The right-operand variant checks the original coordinate before scalar. -/
def MixedScalarRightAudit {E State Scalar A R Result : Type}
    (body : ScalarRightOps (MixedObservedM E State (Option R) Result) A Scalar R Result →
      Complex A → Scalar → MixedObservedM E State (Option R) Result Result)
    (ops : ScalarRightOps (MixedM E State) A Scalar R Result)
    (z : Complex A) (x : Scalar) (state : State) : Prop :=
  let observed : ScalarRightOps (MixedObservedM E State (Option R) Result) A Scalar R Result :=
    { operation := fun a b => MixedObserve (fun _ => "operation")
        (fun _ => a = z.re ∧ b = x) (fun _ value => some value) (fun _ => none)
        (ops.operation a b)
      construct := fun r i => MixedObserve (fun _ => "construct")
        (fun previous => previous = some r ∧ i = z.im) (fun previous _ => previous) some
        (ops.construct r i) }
  MixedAudit ((∀ a b, MixedTotal (ops.operation a b)) ∧
      (∀ r i, MixedTotal (ops.construct r i))) ["operation", "construct"] state
    (body observed z x (MixedStart state none))

/-- The private cache distinguishes the first and second coordinate calls. -/
def MixedPairLabel {Product : Type} (cache : Option Product × Option Product) : String :=
  match cache.1 with | none => "real" | some _ => "imag"

def MixedPairSave {Product : Type} (cache : Option Product × Option Product)
    (value : Product) : Option Product × Option Product :=
  match cache.1 with | none => (some value, cache.2) | some _ => (cache.1, some value)

/-- Coordinate-wise scalar-left protocol, with a separate receipt for each
call even when their input or returned values coincide. -/
def MixedScaleLeftAudit {E State Scalar A Product Result : Type}
    (body : ScaleLeftOps (MixedObservedM E State (Option Product × Option Product) Result)
        Scalar A Product Result → Scalar → Complex A →
        MixedObservedM E State (Option Product × Option Product) Result Result)
    (ops : ScaleLeftOps (MixedM E State) Scalar A Product Result)
    (x : Scalar) (z : Complex A) (state : State) : Prop :=
  let observed : ScaleLeftOps (MixedObservedM E State (Option Product × Option Product) Result)
      Scalar A Product Result :=
    { operation := fun a b => MixedObserve MixedPairLabel
        (fun previous => a = x ∧ b = (match previous.1 with | none => z.re | some _ => z.im))
        MixedPairSave (fun _ => none) (ops.operation a b)
      construct := fun r i => MixedObserve (fun _ => "construct")
        (fun previous => previous.1 = some r ∧ previous.2 = some i)
        (fun previous _ => previous) some (ops.construct r i) }
  MixedAudit ((∀ a b, MixedTotal (ops.operation a b)) ∧
      (∀ r i, MixedTotal (ops.construct r i))) ["real", "imag", "construct"] state
    (body observed x z (MixedStart state (none, none)))

/-- Coordinate-wise scalar-right protocol, also used by complex/scalar
source division.  It does not presume multiplication commutes. -/
def MixedScaleRightAudit {E State Scalar A Product Result : Type}
    (body : ScaleRightOps (MixedObservedM E State (Option Product × Option Product) Result)
        A Scalar Product Result → Complex A → Scalar →
        MixedObservedM E State (Option Product × Option Product) Result Result)
    (ops : ScaleRightOps (MixedM E State) A Scalar Product Result)
    (z : Complex A) (x : Scalar) (state : State) : Prop :=
  let observed : ScaleRightOps (MixedObservedM E State (Option Product × Option Product) Result)
      A Scalar Product Result :=
    { operation := fun a b => MixedObserve MixedPairLabel
        (fun previous => a = (match previous.1 with | none => z.re | some _ => z.im) ∧ b = x)
        MixedPairSave (fun _ => none) (ops.operation a b)
      construct := fun r i => MixedObserve (fun _ => "construct")
        (fun previous => previous.1 = some r ∧ previous.2 = some i)
        (fun previous _ => previous) some (ops.construct r i) }
  MixedAudit ((∀ a b, MixedTotal (ops.operation a b)) ∧
      (∀ r i, MixedTotal (ops.construct r i))) ["real", "imag", "construct"] state
    (body observed z x (MixedStart state (none, none)))

/-- oftype receives the actual difference and the stored imaginary field;
negation receives the actual selected oftype result.  No law about oftype,
conversion, negation, or either possible result type is assumed. -/
def MixedRealSubtractAudit {E State Scalar A Difference Converted Negative Result : Type}
    (body : RealSubtractOps
        (MixedObservedM E State (Option Difference × Option Converted × Option Negative) Result)
        Scalar A Difference Converted Negative Result → Scalar → Complex A →
        MixedObservedM E State (Option Difference × Option Converted × Option Negative) Result Result)
    (ops : RealSubtractOps (MixedM E State) Scalar A Difference Converted Negative Result)
    (x : Scalar) (z : Complex A) (state : State) : Prop :=
  let observed : RealSubtractOps
      (MixedObservedM E State (Option Difference × Option Converted × Option Negative) Result)
      Scalar A Difference Converted Negative Result :=
    { subtract := fun a b => MixedObserve (fun _ => "subtract")
        (fun _ => a = x ∧ b = z.re) (fun previous value => (some value, previous.2))
        (fun _ => none) (ops.subtract a b)
      oftype := fun r i => MixedObserve (fun _ => "oftype")
        (fun previous => previous.1 = some r ∧ i = z.im)
        (fun previous value => (previous.1, some value, previous.2.2))
        (fun _ => none) (ops.oftype r i)
      negate := fun value => MixedObserve (fun _ => "negate")
        (fun previous => previous.2.1 = some value)
        (fun previous result => (previous.1, previous.2.1, some result))
        (fun _ => none) (ops.negate value)
      construct := fun r i => MixedObserve (fun _ => "construct")
        (fun previous => previous.1 = some r ∧ previous.2.2 = some i)
        (fun previous _ => previous) some (ops.construct r i) }
  MixedAudit ((∀ a b, MixedTotal (ops.subtract a b)) ∧
      (∀ a b, MixedTotal (ops.oftype a b)) ∧ (∀ a, MixedTotal (ops.negate a)) ∧
      (∀ r i, MixedTotal (ops.construct r i))) ["subtract", "oftype", "negate", "construct"] state
    (body observed x z (MixedStart state (none, none, none)))

/-- Component-query totality is part of the no-new-divergence observation,
not a correctness law or a restriction on any quantified operation record. -/
def MixedComponentsTotal {E State A : Type}
    (parts : ComponentOps (MixedM E State) A) : Prop :=
  (∀ value, MixedTotal (parts.real value)) ∧ (∀ value, MixedTotal (parts.imag value))

/-- Observe both selected component queries without replacing their effects
or returned runtime values by stored fields.  Each receipt checks the actual
receiver against the original source expression's receiver. -/
def MixedObservedComponents {E State A Cache Result : Type}
    (parts : ComponentOps (MixedM E State) A) (expected : Complex A)
    (realLabel imagLabel : Cache → String)
    (saveReal saveImag : Cache → A → Cache) :
    ComponentOps (MixedObservedM E State Cache Result) A where
  real := fun value => MixedObserve realLabel (fun _ => value = expected)
    saveReal (fun _ => none) (parts.real value)
  imag := fun value => MixedObserve imagLabel (fun _ => value = expected)
    saveImag (fun _ => none) (parts.imag value)

structure MixedScalarQueryCache (A R : Type) where
  real : Option A := none
  imag : Option A := none
  scalar : Option R := none

/-- One scalar-left operation is bracketed by source-ordered real/imaginary
queries, which may themselves mutate, throw, diverge or change runtime type. -/
def MixedScalarLeftPartsAudit {E State Scalar A R Result : Type}
    (body : ScalarLeftOps (MixedObservedM E State (MixedScalarQueryCache A R) Result)
        Scalar A R Result → Scalar → Complex A →
        ComponentOps (MixedObservedM E State (MixedScalarQueryCache A R) Result) A →
        MixedObservedM E State (MixedScalarQueryCache A R) Result Result)
    (ops : ScalarLeftOps (MixedM E State) Scalar A R Result)
    (parts : ComponentOps (MixedM E State) A)
    (x : Scalar) (z : Complex A) (state : State) : Prop :=
  let queries := MixedObservedComponents (Result := Result) parts z
    (fun _ => "real") (fun _ => "imag")
    (fun (cache : MixedScalarQueryCache A R) value => { cache with real := some value })
    (fun cache value => { cache with imag := some value })
  let observed : ScalarLeftOps
      (MixedObservedM E State (MixedScalarQueryCache A R) Result) Scalar A R Result :=
    { operation := fun a b => MixedObserve (fun _ => "operation")
        (fun cache => a = x ∧ cache.real = some b)
        (fun cache value => { cache with scalar := some value }) (fun _ => none)
        (ops.operation a b)
      construct := fun r i => MixedObserve (fun _ => "construct")
        (fun cache => cache.scalar = some r ∧ cache.imag = some i)
        (fun cache _ => cache) some (ops.construct r i) }
  MixedAudit (MixedComponentsTotal parts ∧
      (∀ a b, MixedTotal (ops.operation a b)) ∧ (∀ r i, MixedTotal (ops.construct r i)))
    ["real", "operation", "imag", "construct"] state
    (body observed x z queries (MixedStart state {}))

/-- The coordinate/scalar order is retained independently of query behavior. -/
def MixedScalarRightPartsAudit {E State Scalar A R Result : Type}
    (body : ScalarRightOps (MixedObservedM E State (MixedScalarQueryCache A R) Result)
        A Scalar R Result → Complex A → Scalar →
        ComponentOps (MixedObservedM E State (MixedScalarQueryCache A R) Result) A →
        MixedObservedM E State (MixedScalarQueryCache A R) Result Result)
    (ops : ScalarRightOps (MixedM E State) A Scalar R Result)
    (parts : ComponentOps (MixedM E State) A)
    (z : Complex A) (x : Scalar) (state : State) : Prop :=
  let queries := MixedObservedComponents (Result := Result) parts z
    (fun _ => "real") (fun _ => "imag")
    (fun (cache : MixedScalarQueryCache A R) value => { cache with real := some value })
    (fun cache value => { cache with imag := some value })
  let observed : ScalarRightOps
      (MixedObservedM E State (MixedScalarQueryCache A R) Result) A Scalar R Result :=
    { operation := fun a b => MixedObserve (fun _ => "operation")
        (fun cache => cache.real = some a ∧ b = x)
        (fun cache value => { cache with scalar := some value }) (fun _ => none)
        (ops.operation a b)
      construct := fun r i => MixedObserve (fun _ => "construct")
        (fun cache => cache.scalar = some r ∧ cache.imag = some i)
        (fun cache _ => cache) some (ops.construct r i) }
  MixedAudit (MixedComponentsTotal parts ∧
      (∀ a b, MixedTotal (ops.operation a b)) ∧ (∀ r i, MixedTotal (ops.construct r i)))
    ["real", "operation", "imag", "construct"] state
    (body observed z x queries (MixedStart state {}))

structure MixedCoordinateQueryCache (A R I : Type) where
  real : Option A := none
  imag : Option A := none
  first : Option R := none
  second : Option I := none

def MixedCoordinateOperationLabel {A Product : Type}
    (cache : MixedCoordinateQueryCache A Product Product) : String :=
  match cache.first with | none => "real-operation" | some _ => "imag-operation"

def MixedCoordinateOperationSave {A Product : Type}
    (cache : MixedCoordinateQueryCache A Product Product) (value : Product) :
    MixedCoordinateQueryCache A Product Product :=
  match cache.first with
  | none => { cache with first := some value }
  | some _ => { cache with second := some value }

/-- Both selected component queries remain at their separate literal call
sites, and each product receives the actual corresponding query result. -/
def MixedScaleLeftPartsAudit {E State Scalar A Product Result : Type}
    (body : ScaleLeftOps
        (MixedObservedM E State (MixedCoordinateQueryCache A Product Product) Result)
        Scalar A Product Result → Scalar → Complex A →
        ComponentOps (MixedObservedM E State (MixedCoordinateQueryCache A Product Product) Result) A →
        MixedObservedM E State (MixedCoordinateQueryCache A Product Product) Result Result)
    (ops : ScaleLeftOps (MixedM E State) Scalar A Product Result)
    (parts : ComponentOps (MixedM E State) A)
    (x : Scalar) (z : Complex A) (state : State) : Prop :=
  let queries := MixedObservedComponents (Result := Result) parts z
    (fun _ => "real-query") (fun _ => "imag-query")
    (fun (cache : MixedCoordinateQueryCache A Product Product) value => { cache with real := some value })
    (fun cache value => { cache with imag := some value })
  let observed : ScaleLeftOps
      (MixedObservedM E State (MixedCoordinateQueryCache A Product Product) Result)
      Scalar A Product Result :=
    { operation := fun a b => MixedObserve MixedCoordinateOperationLabel
        (fun cache => a = x ∧ (match cache.first with | none => cache.real | some _ => cache.imag) = some b)
        MixedCoordinateOperationSave (fun _ => none) (ops.operation a b)
      construct := fun r i => MixedObserve (fun _ => "construct")
        (fun cache => cache.first = some r ∧ cache.second = some i)
        (fun cache _ => cache) some (ops.construct r i) }
  MixedAudit (MixedComponentsTotal parts ∧
      (∀ a b, MixedTotal (ops.operation a b)) ∧ (∀ r i, MixedTotal (ops.construct r i)))
    ["real-query", "real-operation", "imag-query", "imag-operation", "construct"] state
    (body observed x z queries (MixedStart state {}))

/-- Scalar-right operations retain source argument order even if the selected
queries return unrelated runtime types in the universal value carrier. -/
def MixedScaleRightPartsAudit {E State Scalar A Product Result : Type}
    (body : ScaleRightOps
        (MixedObservedM E State (MixedCoordinateQueryCache A Product Product) Result)
        A Scalar Product Result → Complex A → Scalar →
        ComponentOps (MixedObservedM E State (MixedCoordinateQueryCache A Product Product) Result) A →
        MixedObservedM E State (MixedCoordinateQueryCache A Product Product) Result Result)
    (ops : ScaleRightOps (MixedM E State) A Scalar Product Result)
    (parts : ComponentOps (MixedM E State) A)
    (z : Complex A) (x : Scalar) (state : State) : Prop :=
  let queries := MixedObservedComponents (Result := Result) parts z
    (fun _ => "real-query") (fun _ => "imag-query")
    (fun (cache : MixedCoordinateQueryCache A Product Product) value => { cache with real := some value })
    (fun cache value => { cache with imag := some value })
  let observed : ScaleRightOps
      (MixedObservedM E State (MixedCoordinateQueryCache A Product Product) Result)
      A Scalar Product Result :=
    { operation := fun a b => MixedObserve MixedCoordinateOperationLabel
        (fun cache => (match cache.first with | none => cache.real | some _ => cache.imag) = some a ∧ b = x)
        MixedCoordinateOperationSave (fun _ => none) (ops.operation a b)
      construct := fun r i => MixedObserve (fun _ => "construct")
        (fun cache => cache.first = some r ∧ cache.second = some i)
        (fun cache _ => cache) some (ops.construct r i) }
  MixedAudit (MixedComponentsTotal parts ∧
      (∀ a b, MixedTotal (ops.operation a b)) ∧ (∀ r i, MixedTotal (ops.construct r i)))
    ["real-query", "real-operation", "imag-query", "imag-operation", "construct"] state
    (body observed z x queries (MixedStart state {}))

