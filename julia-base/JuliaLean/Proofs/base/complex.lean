def floatCheckHypotFastRoot : F64 := F64.ofBits 0x3e46a09e667f3bcd
def floatCheckHypotMinRoot : F64 := F64.ofBits 0x2000000000000000

theorem floatCheckHypotFastRootSource :
    F64.sqrt (F64.div Fl64.eps Fl64.two) = .ok floatCheckHypotFastRoot := by decide

theorem floatCheckHypotMinRootSource : F64.sqrt F64.floatmin = .ok floatCheckHypotMinRoot := by decide

def floatCheckHypotTail (ax ay scale : F64) : Jl F64 := do
  let h ← F64.sqrt (F64.muladd ax ax (F64.mul ay ay))
  let hsquared := F64.mul h h
  let axsquared := F64.mul ax ax
  let corr := F64.sub
    (F64.add (F64.fma (F64.neg ay) ay (F64.sub hsquared axsquared)) (F64.fma h h (F64.neg hsquared)))
    (F64.fma ax ax (F64.neg axsquared))
  let h := F64.sub h (F64.div corr (F64.mul Fl64.two h))
  return F64.mul (F64.mul h scale) F64.one

theorem floatCheckHypotTailNan (ax ay scale : F64)
    (hn : F64.isnan ax = true ∨ F64.isnan ay = true) :
    ∃ r, floatCheckHypotTail ax ay scale = .ok r ∧ F64.isnan r = true := by
  have hsum : F64.isnan (F64.muladd ax ax (F64.mul ay ay)) = true := by
    rcases hn with hn | hn
    · exact floatCheckFmaNan _ _ _ (Or.inl hn)
    · exact floatCheckFmaNan _ _ _ (Or.inr (Or.inr (floatCheckMulNan _ _ (Or.inl hn))))
  unfold floatCheckHypotTail
  rw [floatCheckSqrtNan _ hsum]
  dsimp only [Bind.bind, Pure.pure, Except.bind, Except.pure]
  refine ⟨_, rfl, ?_⟩
  apply floatCheckMulNan
  left
  apply floatCheckMulNan
  left
  apply floatCheckSubNan
  left
  exact floatCheckQuietNan _ hsum

theorem floatCheckHypotNan (x y : F64)
    (hxi : F64.isinf (F64.div (F64.abs x) F64.one) = false)
    (hyi : F64.isinf (F64.div (F64.abs y) F64.one) = false)
    (hn : F64.isnan x = true ∨ F64.isnan y = true) :
    ∃ r, Fl64.hypot x y = .ok r ∧ F64.isnan r = true := by
  let ax := F64.div (F64.abs x) F64.one
  let ay := F64.div (F64.abs y) F64.one
  let scale := F64.mul Fl64.eps floatCheckHypotMinRoot
  have hnan : F64.isnan ax = true ∨ F64.isnan ay = true := by
    rcases hn with hn | hn
    · left
      exact floatCheckDivNan _ _ (Or.inl (by rw [(floatCheckAbsClasses _).1]; exact hn))
    · right
      exact floatCheckDivNan _ _ (Or.inl (by rw [(floatCheckAbsClasses _).1]; exact hn))
  have horder := (floatCheckNanComparison ax ay hnan).1
  have hsmall : F64.le ay (F64.mul ax floatCheckHypotFastRoot) = false := by
    rcases hnan with hnan | hnan
    · exact (floatCheckNanComparison _ _ (Or.inr (floatCheckMulNan _ _ (Or.inl hnan)))).2
    · exact (floatCheckNanComparison _ _ (Or.inl hnan)).2
  have heval : Fl64.hypot x y =
      if F64.lt floatCheckHi ax then floatCheckHypotTail (F64.mul ax scale) (F64.mul ay scale) (F64.div F64.one scale)
      else if F64.lt ay floatCheckHypotMinRoot then floatCheckHypotTail (F64.div ax scale) (F64.div ay scale) scale
      else floatCheckHypotTail ax ay F64.one := by
    unfold Fl64.hypot
    dsimp only
    rw [hxi, hyi, horder]
    simp only [Bool.false_or, Bool.false_eq_true, ↓reduceIte]
    change (do
      let r ← F64.sqrt (F64.div Fl64.eps Fl64.two)
      if F64.le ay (F64.mul ax r) then return F64.abs x
      let sfm ← F64.sqrt F64.floatmin
      let shm ← F64.sqrt (F64.div F64.floatmax Fl64.two)
      let sc := F64.mul Fl64.eps sfm
      let (ax', ay', sc') := if F64.lt shm ax then (F64.mul ax sc, F64.mul ay sc, F64.div F64.one sc)
        else if F64.lt ay sfm then (F64.div ax sc, F64.div ay sc, sc) else (ax, ay, F64.one)
      floatCheckHypotTail ax' ay' sc') = _
    rw [floatCheckHypotFastRootSource, floatCheckHypotMinRootSource, floatCheckSqrtHi]
    simp only [Bind.bind, Pure.pure, Except.bind, Except.pure, hsmall, Bool.false_eq_true, ↓reduceIte]
    split
    · simp only [Prod.fst, Prod.snd, scale]
    · split <;> simp only [Prod.fst, Prod.snd, scale]
  rw [heval]
  split
  · apply floatCheckHypotTailNan
    rcases hnan with hn | hn
    · exact Or.inl (floatCheckMulNan _ _ (Or.inl hn))
    · exact Or.inr (floatCheckMulNan _ _ (Or.inl hn))
  · split
    · apply floatCheckHypotTailNan
      rcases hnan with hn | hn
      · exact Or.inl (floatCheckDivNan _ _ (Or.inl hn))
      · exact Or.inr (floatCheckDivNan _ _ (Or.inl hn))
    · exact floatCheckHypotTailNan ax ay F64.one hnan

