    let traced : ArrayComplexOps (RootM E (RootWorld E State)) Tag Value Array NotBool :=
      { isConcrete := fun tag => rootObserveInfo "isconcretetype"
          (fun value => match value with
            | .boolean true => "true"
            | .boolean false => "false"
            | .other _ => "other") (ops.isConcrete tag)
        notOther := fun value => rootObserveInfo "not"
          (fun result => match result with
