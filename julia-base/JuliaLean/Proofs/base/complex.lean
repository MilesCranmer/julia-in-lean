/-- Arbitrary stateful calls, with state retained on exceptions and none
representing divergence. -/
abbrev MixedShowM (E State A : Type) := ExceptT E (StateT State Option) A

/-- Observable operation identity includes the original IO handle and exact
printed string or complex value. -/
inductive MixedShowOperation (IO A : Type) where
  | print (io : IO) (text : String)
  | shownValue (io : IO) (value : Complex A)

/-- An externally recorded receipt retains the actual returned value or
exception and both states.  Callees cannot alter prior receipts. -/
structure MixedShowReceipt (E State IO A Printed Shown : Type) where
  operation : MixedShowOperation IO A
  outcome : Except E (Printed ⊕ Shown)
  before : State
  after : State

abbrev MixedShowWorld (E State IO A Printed Shown : Type) :=
  State × List (MixedShowReceipt E State IO A Printed Shown)

/-- Observe one call without changing its actual behavior. -/
def MixedShowObserve {E State IO A Printed Shown Value : Type}
    (operation : MixedShowOperation IO A) (inject : Value → Printed ⊕ Shown)
    (action : MixedShowM E State Value) :
    MixedShowM E (MixedShowWorld E State IO A Printed Shown) Value := fun (state, history) =>
  match action state with
  | none => none
  | some (outcome, final) =>
      let receipt : MixedShowReceipt E State IO A Printed Shown :=
        { operation, outcome := outcome.map inject, before := state, after := final }
      some (outcome, (final, history ++ [receipt]))

/-- Lift every selected operation, leaving the underlying IO handle, original
complex value, actual strings, and return carriers unchanged. -/
def MixedShowObservedOps {E State IO A Printed Shown : Type}
    (ops : ShowUnquotedOps (MixedShowM E State) IO A Printed Shown) :
    ShowUnquotedOps (MixedShowM E (MixedShowWorld E State IO A Printed Shown))
      IO A Printed Shown where
  print := fun io text => MixedShowObserve (.print io text) Sum.inl (ops.print io text)
  showValue := fun io value => MixedShowObserve (.shownValue io value) Sum.inr (ops.showValue io value)

/-- The source only changes state through its selected print/show calls. -/
def MixedShowStateChain {E State IO A Printed Shown : Type} (initial final : State) :
    List (MixedShowReceipt E State IO A Printed Shown) → Prop
  | [] => final = initial
  | call :: remaining =>
      call.before = initial ∧ MixedShowStateChain call.after final remaining

/-- A successful return comes from the last actually completed operation. -/
def MixedShowReturned {Printed Shown : Type} :
    ShowUnquotedResult Printed Shown → Printed ⊕ Shown
  | .printed value => .inl value
  | .shown value => .inr value

/-- A mathematical precedence boundary, independent of the model's JInt
comparison and parser-constant helper.  This records observable calls, not a
second implementation of show_unquoted or an assumed contract for show. -/
def MixedShowExpectedCalls {IO A : Type} (io : IO) (z : Complex A) (prec : JInt .i64) :
    List (MixedShowOperation IO A) :=
  if 11 ≤ prec.val then [.print io "(", .shownValue io z, .print io ")"] else [.shownValue io z]

/-- Normal return completes the required call history, returns the actual last
call result, and retains its state.  Failure stops at the first failed call,
returns its precise error, and retains all state changes already performed. -/
def MixedShowAudit {E State IO A Printed Shown : Type}
    (io : IO) (z : Complex A) (prec : JInt .i64) (initial : State)
    (observation : Option (Except E (ShowUnquotedResult Printed Shown) ×
      MixedShowWorld E State IO A Printed Shown)) : Prop :=
  match observation with
  | none => True
  | some (outcome, (final, history)) =>
      MixedShowStateChain initial final history ∧
      match outcome with
      | .ok result =>
          history.map (fun call => call.operation) = MixedShowExpectedCalls io z prec ∧
          (∀ call ∈ history, ∃ value, call.outcome = .ok value) ∧
          ∃ (earlier : List (MixedShowReceipt E State IO A Printed Shown))
            (last : MixedShowReceipt E State IO A Printed Shown),
            history = earlier ++ [last] ∧ last.outcome = .ok (MixedShowReturned result) ∧
            final = last.after
      | .error error =>
          (∃ suffix : List (MixedShowOperation IO A),
            history.map (fun call => call.operation) ++ suffix = MixedShowExpectedCalls io z prec) ∧
          ∃ (earlier : List (MixedShowReceipt E State IO A Printed Shown))
            (last : MixedShowReceipt E State IO A Printed Shown),
            history = earlier ++ [last] ∧
            (∀ call ∈ earlier, ∃ value, call.outcome = .ok value) ∧
            last.outcome = .error error ∧ final = last.after

/-- Full-domain parenthesization, argument-forwarding, return-origin, and
exception/state invariant.  Both Int arguments cover every native Int64 value,
including the boundary 11 and both extremes.  Every IO handle, complex value,
and selected printing/showing computation is included without correctness laws.
