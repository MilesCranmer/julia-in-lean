theorem floatCheckEpsilonFiniteBits (x : F64) (hx : F64.isfinite x = true) :
    F64.eps x = F64.ofBits (floatCheckEpsilonBits (F64.exponentField x - 1)) := by
  let y := F64.ofBits (Nat.xor (F64.toBits x) 1)
