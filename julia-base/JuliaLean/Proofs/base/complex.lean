  rw [abs_neg_f64]

theorem signbit_copysign (x y : F64) : F64.signbit (Fl64.copysign x y) = F64.signbit y := by
  have hy : y.toNat < 2^64 := y.isLt
  have habs : (F64.abs x).toNat < 2^63 := by
