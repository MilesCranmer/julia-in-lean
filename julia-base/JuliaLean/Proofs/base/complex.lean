namespace JuliaLean.ChatGPT.Batch10.Group1
open JuliaLean JuliaLean.Float JuliaLean.Promotion JuliaLean.base.complex
open JuliaLean.Proofs.base.complex
open JuliaLean.base.complex.Models1Group19
open JuliaLean.Proofs.base.complex.Models1Group19
set_option maxRecDepth 100000
set_option maxHeartbeats 10000000
set_option exponentiation.threshold 5000

/-- An upper magnitude bound also bounds the rational's binary exponent. -/
theorem floatCheckLogUpper (n d b : Nat) (hn : n ≠ 0) (hd : d ≠ 0)
    (hu : n ≤ d * 2 ^ b) : Fl.floorLog2Rat n d ≤ b := by
  have hlog := floatCheckLog2Mono n (d * 2 ^ b) hn
    (Nat.mul_ne_zero hd (Nat.ne_of_gt (Nat.two_pow_pos _))) hu
  rw [floatCheckLog2MulPow d b hd] at hlog
  unfold Fl.floorLog2Rat
  dsimp only
  split <;> omega

theorem floatCheckFlPackTailUpper (f : Fmt) (s : Bool) (m b : Nat) (p : Int)
    (hm : m < 2 ^ (f.sb + 1)) (hp : p + f.sb ≤ b) (hb : b + f.bias < f.emax) :
    let y : Fl f := if p + f.bias + f.sb ≥ f.emax then Fl.inf s else
      Fl.ofBits ((if s then 2 ^ (f.eb + f.sb) else 0) +
        (if m < 2 ^ f.sb then m else (p + f.bias + f.sb).toNat * 2 ^ f.sb + (m - 2 ^ f.sb)))
    y.isfinite = true := by
  have hem : f.emax < 2 ^ f.eb := by unfold Fmt.emax; have := Nat.two_pow_pos f.eb; omega
  have hno : ¬ p + (f.bias : Int) + f.sb ≥ f.emax := by omega
  dsimp only
  simp only [hno, ↓reduceIte]
  by_cases hs : m < 2 ^ f.sb
  · simp only [hs, ↓reduceIte]
    have hpack : (Fl.ofBits ((if s then 2 ^ (f.eb + f.sb) else 0) + m) : Fl f) =
        floatCheckFlPack s 0 m := by unfold floatCheckFlPack; simp only [Nat.zero_mul, Nat.zero_add]
    rw [hpack]
    have he := (floatCheckFlPackParts (f := f) s 0 m (Nat.two_pow_pos _) hs).2.1
    simp only [Fl.isfinite, he, bne_iff_ne]
    omega
  · simp only [hs, ↓reduceIte]
    change (floatCheckFlPack s (p + f.bias + f.sb).toNat (m - 2 ^ f.sb) : Fl f).isfinite = true
    have heraw : (p + (f.bias : Int) + f.sb).toNat < f.emax := by omega
    have hfrac : m - 2 ^ f.sb < 2 ^ f.sb := by rw [Nat.pow_succ] at hm; omega
    have he := (floatCheckFlPackParts (f := f) s _ _ (Nat.lt_trans heraw hem) hfrac).2.1
    simp only [Fl.isfinite, he, bne_iff_ne]
    omega

theorem floatCheckFlPackRoundedUpper (f : Fmt) (s : Bool) (q b : Nat) (k : Int)
    (hq : q ≤ 2 ^ (f.sb + 1)) (hk : k + f.sb ≤ b) (hb : b + f.bias + 1 < f.emax) :
    (Fl.packRounded s q k : Fl f).isfinite = true := by
  unfold Fl.packRounded
  by_cases hz : q = 0
  · simp only [hz, beq_self_eq_true, ↓reduceIte]
    exact (floatCheckFlZeroBasics f (by omega) s).1
  · simp only [beq_eq_false_iff_ne.mpr hz, Bool.false_eq_true, ↓reduceIte]
    by_cases hc : q ≥ 2 ^ (f.sb + 1)
    · simp only [hc, ↓reduceIte]
      apply floatCheckFlPackTailUpper f s (q / 2) (b + 1) (k + 1)
      · have hpow : 2 ^ (f.sb + 1) = 2 ^ f.sb * 2 := Nat.pow_succ _ _
        rw [hpow] at hq hc ⊢
        have hp := Nat.two_pow_pos f.sb
        omega
      · omega
      · omega
    · simp only [hc, ↓reduceIte]
      apply floatCheckFlPackTailUpper f s q b k (by omega) hk (by omega)

/-- Underflow cannot spoil finiteness when the input has a safe upper bound. -/
theorem floatCheckFlRoundRatUpperFinite (f : Fmt) (n : Int) (d b : Nat) (s : Bool)
    (hd : d ≠ 0) (hbias : 1 ≤ f.bias) (hb : b + f.bias + 1 < f.emax)
    (hnum : n.natAbs ≤ d * 2 ^ b) : (Fl.roundRat n d s : Fl f).isfinite = true := by
  have hem : 0 < f.emax := by omega
  unfold Fl.roundRat
  simp only [beq_eq_false_iff_ne.mpr hd, Bool.false_eq_true, ↓reduceIte]
  by_cases hn : n = 0
  · simp only [hn, beq_self_eq_true, ↓reduceIte]
    exact (floatCheckFlZeroBasics f hem s).1
  · simp only [beq_eq_false_iff_ne.mpr hn, Bool.false_eq_true, ↓reduceIte]
    have ha : n.natAbs ≠ 0 := by omega
    have he := floatCheckLogUpper n.natAbs d b ha hd hnum
    have ho : ¬ Fl.floorLog2Rat n.natAbs d ≥ (f.emax : Int) - f.bias := by omega
    simp only [ho, ↓reduceIte]
    by_cases hu : Fl.floorLog2Rat n.natAbs d < -((f.bias : Int) + f.sb) - 1
    · simp only [hu, ↓reduceIte]
      exact (floatCheckFlZeroBasics f hem _).1
    · simp only [hu, ↓reduceIte]
      apply floatCheckFlPackRoundedUpper f _ _ b
      · exact floatCheckFlScaledRoundedBound n.natAbs d f.sb ha hd _ (Int.le_max_left _ _)
      · omega
      · exact hb

theorem floatCheckF64RoundRatUpperFinite (n : Int) (d b : Nat) (s : Bool)
    (hd : d ≠ 0) (hb : b ≤ 1022) (hnum : n.natAbs ≤ d * 2 ^ b) :
    F64.isfinite (F64.roundRat n d s) = true := by
  by_cases he : -1075 ≤ Fl.floorLog2Rat n.natAbs d
  · rw [← floatCheckFlToF64RoundRat n d s he, (floatCheckFlToF64Classes _).1]
    exact floatCheckFlRoundRatUpperFinite double n d b s hd (by decide)
      (by change b + 1023 + 1 < 2047; omega) hnum
  · rw [f64_roundRat_eq]
    simp only [beq_eq_false_iff_ne.mpr hd, Bool.false_eq_true, ↓reduceIte]
    by_cases hn : n = 0
    · simp only [hn, beq_self_eq_true, ↓reduceIte]
      cases s <;> decide
    · simp only [beq_eq_false_iff_ne.mpr hn, Bool.false_eq_true, ↓reduceIte]
      change ¬ -1075 ≤ f64Fl2 n.natAbs d at he
      have ho : ¬ f64Fl2 n.natAbs d ≥ 1024 := by omega
      have hu : f64Fl2 n.natAbs d < -1075 := by omega
      simp only [ho, hu, ↓reduceIte]
      cases decide (n < 0) <;> decide

theorem floatCheckWideRoundUpperFinite (k : SmallFloatKind) (n : Int) (d b : Nat) (s : Bool)
    (hd : d ≠ 0) (hb : b + (wideFormat k).bias + 1 < (wideFormat k).emax)
    (hnum : n.natAbs ≤ d * 2 ^ b) : (floatCheckWideRound k n d s).isfinite = true := by
  cases k with
  | f16 => exact floatCheckFlRoundRatUpperFinite single n d b s hd (by decide) hb hnum
  | f32 =>
    change (Fl.ofF64 (F64.roundRat n d s)).isfinite = true
    rw [(floatCheckFlOfF64Classes _).1]
    exact floatCheckF64RoundRatUpperFinite n d b s hd (by change b + 1023 + 1 < 2047 at hb; omega) hnum

/-- Opposite signs cannot increase a sum beyond the sum of its two magnitude bounds. -/
theorem floatCheckRatUpperAdd (n m : Int) (d e b : Nat)
    (hn : n.natAbs ≤ d * 2 ^ b) (hm : m.natAbs ≤ e * 2 ^ b) :
    (n * (e : Int) + m * (d : Int)).natAbs ≤ (d * e) * 2 ^ (b + 1) := by
  have ht := Int.natAbs_add_le (n * (e : Int)) (m * (d : Int))
  simp only [Int.natAbs_mul, Int.natAbs_natCast] at ht
  have hleft : n.natAbs * e ≤ d * e * 2 ^ b := by
    have h := Nat.mul_le_mul_right e hn
    simpa only [Nat.mul_assoc, Nat.mul_comm, Nat.mul_left_comm] using h
  have hright : m.natAbs * d ≤ d * e * 2 ^ b := by
    have h := Nat.mul_le_mul_right d hm
    simpa only [Nat.mul_assoc, Nat.mul_comm, Nat.mul_left_comm] using h
  rw [Nat.pow_succ, ← Nat.mul_assoc]
  omega

theorem floatCheckWideMuladdUpperFinite (k : SmallFloatKind) (x y z : WideValue k) (b : Nat)
    (hx : x.isfinite = true) (hy : y.isfinite = true) (hz : z.isfinite = true)
    (hxb : x.toRat.1.natAbs ≤ x.toRat.2 * 2 ^ b)
    (hyb : y.toRat.1.natAbs ≤ y.toRat.2 * 2 ^ b)
    (hzb : z.toRat.1.natAbs ≤ z.toRat.2 * 2 ^ (b + b + 2))
    (hroom : b + b + 3 + (wideFormat k).bias + 1 < (wideFormat k).emax) :
    (wideMuladd k x y z).isfinite = true := by
  rw [floatCheckWideMuladdFinite k x y z hx hy hz]
  have hmul : (x.toRat.1 * y.toRat.1).natAbs ≤ (x.toRat.2 * y.toRat.2) * 2 ^ (b + b) := by
    rw [Int.natAbs_mul, Nat.pow_add]
    have h := Nat.mul_le_mul hxb hyb
    simpa only [Nat.mul_assoc, Nat.mul_comm, Nat.mul_left_comm] using h
  have hmul' : (x.toRat.1 * y.toRat.1).natAbs ≤ (x.toRat.2 * y.toRat.2) * 2 ^ (b + b + 2) :=
    Nat.le_trans hmul (Nat.mul_le_mul_left _ (Nat.pow_le_pow_right (by decide) (by omega)))
  have hsum := floatCheckRatUpperAdd _ _ _ _ _ hmul' hzb
  apply floatCheckWideRoundUpperFinite k _ _ (b + b + 2 + 1)
  · exact Nat.ne_of_gt (Nat.mul_pos (Nat.mul_pos (floatCheckFlRatDenPos (wideFormat k) x hx)
      (floatCheckFlRatDenPos (wideFormat k) y hy)) (floatCheckFlRatDenPos (wideFormat k) z hz))
  · omega
  · exact hsum

theorem floatCheckFlNegRatAbs (f : Fmt) (x : Fl f) (hf : x.isfinite = true) :
    ((Fl.neg x).toRat.1.natAbs, (Fl.neg x).toRat.2) = (x.toRat.1.natAbs, x.toRat.2) := by
  have hf' := (floatCheckFlNegFinite f x).trans hf
  have he : (Fl.neg x).expField = x.expField := by
    simp only [floatCheckFlExpMagnitude, floatCheckFlNegMagnitude]
  have hp : (Fl.neg x).frac = x.frac := by
    simp only [floatCheckFlFracMagnitude, floatCheckFlNegMagnitude]
  rw [floatCheckFlRatAbs f (Fl.neg x) hf', floatCheckFlRatAbs f x hf, he, hp]

theorem floatCheckFlNegBounds (f : Fmt) (x : Fl f) (lo hi : Nat)
    (hb : floatCheckFlBounds f lo hi x) : floatCheckFlBounds f lo hi (Fl.neg x) := by
  have habs := congrArg Prod.fst (floatCheckFlNegRatAbs f x hb.1)
  have hden := congrArg Prod.snd (floatCheckFlNegRatAbs f x hb.1)
  dsimp only at habs hden
  refine ⟨(floatCheckFlNegFinite f x).trans hb.1, ?_, ?_, ?_⟩
  · rw [hden]
    exact hb.2.1
  · rw [habs, hden]
    exact hb.2.2.1
  · intro hn
    rw [habs, hden]
    apply hb.2.2.2
    intro hx
    rw [hx, Int.natAbs_zero] at habs
    have hzero : (Fl.neg x).toRat.1 = 0 := by omega
    exact hn hzero


/-- The reciprocal of the widened squared modulus is finite for every nonzero small divisor. -/
theorem floatCheckSmallMagnitudeFinite (k : SmallFloatKind) (w : Complex (SmallValue k))
    (hwr : w.re.isfinite = true) (hwi : w.im.isfinite = true)
    (hw : w.re.iszero = false ∨ w.im.iszero = false) :
    (wideInverse k (wideMuladd k (Fl.convert w.re) (Fl.convert w.re)
      (wideMultiply k (Fl.convert w.im) (Fl.convert w.im)))).isfinite = true := by
  obtain ⟨hc, hcz⟩ := floatCheckWidenBounds k w.re hwr
  obtain ⟨hd, hdz⟩ := floatCheckWidenBounds k w.im hwi
  have hs := floatCheckWideSquaredSumBounds k (Fl.convert w.re) (Fl.convert w.im)
    (floatCheckSmallLo k) (floatCheckSmallHi k) hc hd
    (by cases k <;> decide) (by cases k <;> decide)
  let rho := wideMuladd k (Fl.convert w.re) (Fl.convert w.re)
    (wideMultiply k (Fl.convert w.im) (Fl.convert w.im))
  change floatCheckFlBounds (wideFormat k) (floatCheckSmallLo k + floatCheckSmallLo k + 2)
      (floatCheckSmallHi k + floatCheckSmallHi k + 5) rho ∧
    rho.signbit = false ∧ (rho.iszero = true ↔
      (Fl.convert w.re : WideValue k).iszero = true ∧ (Fl.convert w.im : WideValue k).iszero = true) at hs
  have hnum : 0 < rho.toRat.1 := by
    have hge := floatCheckFlPositiveRat (wideFormat k) rho hs.1.1 hs.2.1
    have hn : rho.toRat.1 ≠ 0 := by
      intro hh
      have hzrho := (floatCheckFlRatZeroIff (wideFormat k) rho hs.1.1).mp hh
      obtain ⟨hcz0, hdz0⟩ := hs.2.2.mp hzrho
      have hwr0 := hcz.mp hcz0
      have hwi0 := hdz.mp hdz0
      rcases hw with hw | hw
      · rw [hw] at hwr0
        contradiction
      · rw [hw] at hwi0
        contradiction
    omega
  exact floatCheckWideInverseFinite k rho
    (floatCheckSmallLo k + floatCheckSmallLo k + 2)
    (floatCheckSmallHi k + floatCheckSmallHi k + 5) hs.1 hnum
    (by cases k <;> decide) (by cases k <;> decide)

/-- Every widened intermediate of finite small-complex division avoids invalid arithmetic. -/
theorem floatCheckSmallDivisionFinite (k : SmallFloatKind) (z w : Complex (SmallValue k))
    (hzr : z.re.isfinite = true) (hzi : z.im.isfinite = true)
    (hwr : w.re.isfinite = true) (hwi : w.im.isfinite = true)
    (hw : w.re.iszero = false ∨ w.im.iszero = false) :
    (divideSmall k z w).re.isnan = false ∧ (divideSmall k z w).im.isnan = false := by
  let a : WideValue k := Fl.convert z.re
  let b : WideValue k := Fl.convert z.im
  let c : WideValue k := Fl.convert w.re
  let d : WideValue k := Fl.convert w.im
  have ha := (floatCheckWidenBounds k z.re hzr).1
  have hb := (floatCheckWidenBounds k z.im hzi).1
  have hc := (floatCheckWidenBounds k w.re hwr).1
  have hd := (floatCheckWidenBounds k w.im hwi).1
  change floatCheckFlBounds (wideFormat k) (floatCheckSmallLo k) (floatCheckSmallHi k) a at ha
  change floatCheckFlBounds (wideFormat k) (floatCheckSmallLo k) (floatCheckSmallHi k) b at hb
  change floatCheckFlBounds (wideFormat k) (floatCheckSmallLo k) (floatCheckSmallHi k) c at hc
  change floatCheckFlBounds (wideFormat k) (floatCheckSmallLo k) (floatCheckSmallHi k) d at hd
  have hna := floatCheckFlNegBounds (wideFormat k) a _ _ ha
  have hflo : floatCheckSmallLo k + floatCheckSmallLo k + 2 ≤ (wideFormat k).bias := by cases k <;> decide
  have hfhi : floatCheckSmallHi k + floatCheckSmallHi k + (wideFormat k).bias + 1 < (wideFormat k).emax := by cases k <;> decide
  have hbd := (floatCheckWideMultiplyBounds k b d _ _ _ _ hb hd hflo hfhi).1
  have hnad := (floatCheckWideMultiplyBounds k (Fl.neg a) d _ _ _ _ hna hd hflo hfhi).1
  have hre := floatCheckWideMuladdUpperFinite k a c (wideMultiply k b d) (floatCheckSmallHi k)
    ha.1 hc.1 hbd.1 ha.2.2.1 hc.2.2.1 hbd.2.2.1 (by cases k <;> decide)
  have him := floatCheckWideMuladdUpperFinite k b c (wideMultiply k (Fl.neg a) d) (floatCheckSmallHi k)
    hb.1 hc.1 hnad.1 hb.2.2.1 hc.2.2.1 hnad.2.2.1 (by cases k <;> decide)
  let mag := wideInverse k (wideMuladd k c c (wideMultiply k d d))
  have hmag : mag.isfinite = true := floatCheckSmallMagnitudeFinite k w hwr hwi hw
  have hproductre := floatCheckWideMultiplyNotNan k (wideMuladd k a c (wideMultiply k b d)) mag hre hmag
  have hproductim := floatCheckWideMultiplyNotNan k (wideMuladd k b c (wideMultiply k (Fl.neg a) d)) mag him hmag
  have hcre := floatCheckFlConvertNotNan (smallFormat k) (wideFormat k) (by cases k <;> decide) _ hproductre
  have hcim := floatCheckFlConvertNotNan (smallFormat k) (wideFormat k) (by cases k <;> decide) _ hproductim
  have hci := (floatCheckFlFiniteClasses (wideFormat k) c hc.1).2
  have hdi := (floatCheckFlFiniteClasses (wideFormat k) d hd.1).2
  unfold divideSmall widenSmallComplex reimComplex
  change (if c.isinf || d.isinf then _ else
    narrowSmallComplex k ⟨wideMultiply k (wideMuladd k a c (wideMultiply k b d)) mag,
      wideMultiply k (wideMuladd k b c (wideMultiply k (Fl.neg a) d)) mag⟩).re.isnan = false ∧
    (if c.isinf || d.isinf then _ else
    narrowSmallComplex k ⟨wideMultiply k (wideMuladd k a c (wideMultiply k b d)) mag,
      wideMultiply k (wideMuladd k b c (wideMultiply k (Fl.neg a) d)) mag⟩).im.isnan = false
  simp only [hci, hdi, Bool.false_or, Bool.false_eq_true, ↓reduceIte, narrowSmallComplex]
  exact ⟨hcre, hcim⟩

/-- A finite multiplication with a zero factor returns a signed zero. -/
theorem floatCheckMultiplyFloatZero (f : Fmt) (x y : Fl f)
    (hx : x.isfinite = true) (hy : y.isfinite = true) (hz : x.iszero = true) :
    multiplyFloatAt x y = Fl.zero (x.signbit != y.signbit) := by
  obtain ⟨hxn, hxi⟩ := floatCheckFlFiniteClasses f x hx
  obtain ⟨hyn, hyi⟩ := floatCheckFlFiniteClasses f y hy
  have hn := (floatCheckFlRatZeroIff f x hx).mpr hz
  have hd : (x.toRat.2 * y.toRat.2 == 0) = false := beq_eq_false_iff_ne.mpr
    (Nat.ne_of_gt (Nat.mul_pos (floatCheckFlRatDenPos f x hx) (floatCheckFlRatDenPos f y hy)))
  simp only [multiplyFloatAt, hxn, hyn, hxi, hyi, Bool.false_eq_true, Bool.false_and,
    Bool.false_or, ↓reduceIte, hn, Int.zero_mul, Fl.roundRat, hd, beq_self_eq_true]

/-- Only zero can be unordered against zero in both directions without being NaN. -/
theorem floatCheckFlZeroOfBothComparisons (f : Fmt) (x : Fl f)
    (hn : x.isnan = false) (hl : Fl.lt x (Fl.zero false) = false)
    (hr : Fl.lt (Fl.zero false) x = false) : x.iszero = true := by
  have hzbits : (Fl.zero false : Fl f).toBits = 0 := by
    unfold Fl.zero
    simp only [Bool.false_eq_true, ↓reduceIte, floatCheckFlOfBits, Nat.zero_mod]
  have hzsign : (Fl.zero false : Fl f).signbit = false := (floatCheckFlZeroClass f false).1
  have hznan : (Fl.zero false : Fl f).isnan = false := (floatCheckFlZeroClass f false).2
  have hzzero : (Fl.zero false : Fl f).iszero = true := by
    simp only [Fl.iszero, Fl.magnitude, hzbits, Nat.zero_mod, beq_self_eq_true]
  by_cases hx : x.iszero = true
  · exact hx
  · have hxf : x.iszero = false := Bool.eq_false_iff.mpr hx
    unfold Fl.lt at hl hr
    simp only [hn, hznan, hxf, hzzero, hzbits, hzsign, Bool.false_and, Bool.and_false,
      Bool.false_or, Bool.false_eq_true, ↓reduceIte] at hl hr
    cases hs : x.signbit
    · simp only [hs, bne_self_eq_false, Bool.false_eq_true, ↓reduceIte] at hr
      have hx0 : x.toBits = 0 := by
        have hh : ¬ 0 < x.toBits := decide_eq_false_iff_not.mp hr
        omega
      have hz : x.iszero = true := by
        simp only [Fl.iszero, Fl.magnitude, hx0, Nat.zero_mod, beq_self_eq_true]
      exact False.elim (hx hz)
    · simp only [hs, show (true != false) = true from rfl, ↓reduceIte] at hl
      contradiction

/-- A sign of a non-NaN small float is always finite, including signs of infinities. -/
theorem floatCheckSmallSignFinite (k : SmallFloatKind) (x : SmallValue k) (hn : x.isnan = false) :
    (smallSign x).isfinite = true := by
  unfold smallSign
  by_cases hl : Fl.lt x (Fl.zero false) = true
  · simp only [hl, ↓reduceIte]
    cases k <;> decide
  · have hlf : Fl.lt x (Fl.zero false) = false := Bool.eq_false_iff.mpr hl
    simp only [hlf, Bool.false_eq_true, ↓reduceIte]
    by_cases hr : Fl.lt (Fl.zero false) x = true
    · simp only [hr, ↓reduceIte]
      cases k <;> decide
    · have hrf : Fl.lt (Fl.zero false) x = false := Bool.eq_false_iff.mpr hr
      simp only [hrf, Bool.false_eq_true, ↓reduceIte]
      have hz := floatCheckFlZeroOfBothComparisons (smallFormat k) x hn hlf hrf
      have hm : x.magnitude = 0 := beq_iff_eq.mp hz
      have he : x.expField = 0 := by rw [floatCheckFlExpMagnitude, hm, Nat.zero_div]
      have hem : 0 < (smallFormat k).emax := by cases k <;> decide
      simp only [Fl.isfinite, he, bne_iff_ne]
      omega

/-- The infinity branch consists of finite signed-zero multiplications. -/
theorem floatCheckSmallDivisionInfinity (k : SmallFloatKind) (z w : Complex (SmallValue k))
    (hzr : z.re.isfinite = true) (hzi : z.im.isfinite = true)
    (hwr : w.re.isnan = false) (hwi : w.im.isnan = false)
    (hw : w.re.isinf = true ∨ w.im.isinf = true) :
    (divideSmall k z w).re.iszero = true ∧ (divideSmall k z w).im.iszero = true := by
  have hinf : ((Fl.convert w.re : WideValue k).isinf || (Fl.convert w.im : WideValue k).isinf) = true := by
    rcases hw with hw | hw
    · rw [floatCheckFlConvertInfinite (wideFormat k) (smallFormat k) w.re hw]
      exact Bool.true_or _
    · rw [floatCheckFlConvertInfinite (wideFormat k) (smallFormat k) w.im hw]
      exact Bool.or_true _
  have hzfinite : isfinite_Complex Fl.isfinite z = true := by
    simp only [isfinite_Complex, real_Complex, imag_Complex, hzr, hzi, Bool.true_and]
  have hsignzr := floatCheckSmallSignFinite k z.re (floatCheckFlFiniteClasses (smallFormat k) z.re hzr).1
  have hsignzi := floatCheckSmallSignFinite k z.im (floatCheckFlFiniteClasses (smallFormat k) z.im hzi).1
  have hsignwr := floatCheckSmallSignFinite k w.re hwr
  have hsignwi := floatCheckSmallSignFinite k w.im hwi
  have hem : 0 < (smallFormat k).emax := by cases k <;> decide
  have hzero := floatCheckFlZeroBasics (smallFormat k) hem false
  have hnegzero : (Fl.neg (Fl.zero false) : SmallValue k) = Fl.zero true := by cases k <;> decide
  have hnzero := floatCheckFlZeroBasics (smallFormat k) hem true
  unfold divideSmall widenSmallComplex reimComplex reim real_Complex imag_Complex
  simp only [hinf, ↓reduceIte, hzfinite, hnegzero]
  have h1 := floatCheckMultiplyFloatZero (smallFormat k) (Fl.zero false) (smallSign z.re)
    hzero.1 hsignzr hzero.2.1
  have h2 := floatCheckMultiplyFloatZero (smallFormat k) (Fl.zero true) (smallSign z.im)
    hnzero.1 hsignzi hnzero.2.1
  rw [h1, h2]
  have hzero1 := floatCheckFlZeroBasics (smallFormat k) hem
    ((Fl.zero false : SmallValue k).signbit != (smallSign z.re).signbit)
  have hzero2 := floatCheckFlZeroBasics (smallFormat k) hem
    ((Fl.zero true : SmallValue k).signbit != (smallSign z.im).signbit)
  rw [floatCheckMultiplyFloatZero (smallFormat k) _ _ hzero1.1 hsignwr hzero1.2.1,
    floatCheckMultiplyFloatZero (smallFormat k) _ _ hzero2.1 hsignwi hzero2.2.1]
  exact ⟨(floatCheckFlZeroBasics (smallFormat k) hem _).2.1,
    (floatCheckFlZeroBasics (smallFormat k) hem _).2.1⟩

end JuliaLean.ChatGPT.Batch10.Group1

