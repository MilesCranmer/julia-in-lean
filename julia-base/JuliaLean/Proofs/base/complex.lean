theorem rootNearIntegralBound (n d k : Int) (hd : 0 < d)
    (hl : -d ≤ 2*(k*d-n)) (hu : 2*(k*d-n) ≤ d) :
    NearestIntegral n d k := by
  intro j
  unfold IntegralDistance
  rcases Int.lt_trichotomy j k with h | h | h
  · have hm := Int.mul_le_mul_of_nonneg_right (show j+1 ≤ k by omega) (Int.le_of_lt hd)
    rw [Int.add_mul, Int.one_mul] at hm
    omega
  · subst j
    exact Int.le_refl _
  · have hm := Int.mul_le_mul_of_nonneg_right (show k+1 ≤ j by omega) (Int.le_of_lt hd)
    rw [Int.add_mul, Int.one_mul] at hm
    omega

theorem rootNearIntegralTie (n d k j : Int) (hd : 0 < d)
    (hl : -d ≤ 2*(k*d-n)) (hu : 2*(k*d-n) ≤ d)
    (hj : j ≠ k) (he : IntegralDistance n d k = IntegralDistance n d j) :
    (2*(k*d-n) = d ∧ j = k-1) ∨ (2*(k*d-n) = -d ∧ j = k+1) := by
  unfold IntegralDistance at he
  rcases Int.lt_trichotomy j k with h | h | h
  · have hm := Int.mul_le_mul_of_nonneg_right (show j+1 ≤ k by omega) (Int.le_of_lt hd)
    rw [Int.add_mul, Int.one_mul] at hm
    have hdelta : 2*(k*d-n) = d := by omega
    left
    refine ⟨hdelta, ?_⟩
    have hprod : (j+1)*d = k*d := by rw [Int.add_mul, Int.one_mul]; omega
    have hjk : j+1=k := (Int.mul_eq_mul_right_iff (by omega : d ≠ 0)).mp hprod
    omega
  · exact False.elim (hj h)
  · have hm := Int.mul_le_mul_of_nonneg_right (show k+1 ≤ j by omega) (Int.le_of_lt hd)
    rw [Int.add_mul, Int.one_mul] at hm
    have hdelta : 2*(k*d-n) = -d := by omega
    right
    refine ⟨hdelta, ?_⟩
    have hprod : (k+1)*d = j*d := by rw [Int.add_mul, Int.one_mul]; omega
    have hjk : k+1=j := (Int.mul_eq_mul_right_iff (by omega : d ≠ 0)).mp hprod
    omega

def rootRoundingMode : StandardRounding → Scalar.Mode
  | .primitive .RoundNearest => .Nearest
  | .primitive .RoundNearestTiesAway => .NearestTiesAway
  | .primitive .RoundToZero => .ToZero
  | .primitive .RoundDown => .Down
  | .primitive .RoundUp => .Up
  | .fromZero => .FromZero
  | .nearestTiesUp => .NearestTiesUp

theorem rootNearestEvenRule (n d k : Int) (hd : 0 < d)
    (hl : -d ≤ 2*(k*d-n)) (hu : 2*(k*d-n) ≤ d)
    (ht : 2*(k*d-n) = d ∨ 2*(k*d-n) = -d → k % 2 = 0) :
    IntegralRoundingRule (.primitive .RoundNearest) n d k := by
  refine ⟨rootNearIntegralBound n d k hd hl hu, ?_⟩
  intro j hj he
  rcases rootNearIntegralTie n d k j hd hl hu hj he with ⟨he, _⟩ | ⟨he, _⟩
  · exact ht (Or.inl he)
  · exact ht (Or.inr he)

theorem rootNearestAwayRule (n d k : Int) (hd : 0 < d)
    (hl : -d ≤ 2*(k*d-n)) (hu : 2*(k*d-n) ≤ d)
    (hp : 2*(k*d-n) = d → 0 < k)
    (hn : 2*(k*d-n) = -d → k < 0) :
    IntegralRoundingRule (.primitive .RoundNearestTiesAway) n d k := by
  refine ⟨rootNearIntegralBound n d k hd hl hu, ?_⟩
  intro j he
  by_cases hj : j = k
  · subst j
    exact Nat.le_refl _
  · rcases rootNearIntegralTie n d k j hd hl hu hj he with ⟨he, hj⟩ | ⟨he, hj⟩
    · have hs := hp he
      omega
    · have hs := hn he
      omega

theorem rootNearestUpRule (n d k : Int) (hd : 0 < d)
    (hl : -d < 2*(k*d-n)) (hu : 2*(k*d-n) ≤ d) :
    IntegralRoundingRule .nearestTiesUp n d k := by
  refine ⟨rootNearIntegralBound n d k hd (by omega) hu, ?_⟩
  intro j he
  by_cases hj : j = k
  · omega
  · have ht := rootNearIntegralTie n d k j hd (by omega) hu hj he
    omega

theorem rootExactRoundRule (m : StandardRounding) (n : Int) (d : Nat) (hd : 0 < d) :
    IntegralRoundingRule m n d (Scalar.exactRound n d (rootRoundingMode m)) := by
  have hdi : (0 : Int) < (d : Int) := Int.natCast_pos.mpr hd
  have hr0 := Int.emod_nonneg n (by omega : (d : Int) ≠ 0)
  have hr1 := Int.emod_lt_of_pos n hdi
  have hn := Int.emod_add_ediv_mul n (d : Int)
  have hqneg : n < 0 → n/(d : Int) < 0 := by
    intro hnneg
    by_cases hq : n/(d : Int) < 0
    · exact hq
    · have hmul := Int.mul_nonneg (show 0 ≤ n/(d : Int) by omega) (Int.le_of_lt hdi)
      omega
  have hqpos : 0 ≤ n → 0 ≤ n/(d : Int) := by
    intro hnpos
    exact Int.ediv_nonneg hnpos (Int.le_of_lt hdi)
  cases m with
  | primitive p =>
    cases p with
    | RoundDown =>
      simp only [rootRoundingMode, Scalar.exactRound, IntegralRoundingRule]
      split <;> simp only [Int.add_mul, Int.one_mul] <;> omega
    | RoundUp =>
      simp only [rootRoundingMode, Scalar.exactRound, IntegralRoundingRule]
      split <;> simp only [Int.add_mul, Int.sub_mul, Int.one_mul] <;> omega
    | RoundToZero =>
      simp only [rootRoundingMode, Scalar.exactRound, IntegralRoundingRule]
      split <;> split <;> simp only [Int.add_mul, Int.sub_mul, Int.one_mul] <;> omega
    | RoundNearest =>
      simp only [rootRoundingMode, Scalar.exactRound]
      split
      · apply rootNearestEvenRule _ _ _ hdi <;> omega
      · split
        · apply rootNearestEvenRule _ _ _ hdi <;> omega
        · split
          · apply rootNearestEvenRule _ _ _ hdi <;>
              simp only [Int.add_mul, Int.one_mul] <;> omega
          · split
            · apply rootNearestEvenRule _ _ _ hdi <;> omega
            · apply rootNearestEvenRule _ _ _ hdi <;>
                simp only [Int.add_mul, Int.one_mul] <;> omega
    | RoundNearestTiesAway =>
      simp only [rootRoundingMode, Scalar.exactRound]
      split
      · apply rootNearestAwayRule _ _ _ hdi <;> omega
      · split
        · apply rootNearestAwayRule _ _ _ hdi <;> omega
        · split
          · apply rootNearestAwayRule _ _ _ hdi <;>
              simp only [Int.add_mul, Int.one_mul] <;> omega
          · split
            · have hq := hqneg (by assumption)
              apply rootNearestAwayRule _ _ _ hdi <;> omega
            · have hq := hqpos (by omega)
              apply rootNearestAwayRule _ _ _ hdi <;>
                simp only [Int.add_mul, Int.one_mul] <;> omega
  | fromZero =>
    simp only [rootRoundingMode, Scalar.exactRound, IntegralRoundingRule]
    split <;> split <;> simp only [Int.add_mul, Int.sub_mul, Int.one_mul] <;> omega
  | nearestTiesUp =>
    simp only [rootRoundingMode, Scalar.exactRound]
    split
    · apply rootNearestUpRule _ _ _ hdi <;> omega
    · split
      · apply rootNearestUpRule _ _ _ hdi <;> omega
      · apply rootNearestUpRule _ _ _ hdi <;>
          simp only [Int.add_mul, Int.one_mul] <;> omega

theorem rootRoundScalarBridge (x : F64) (m : StandardRounding) :
    roundScalarF64 x m = Scalar.roundF x (rootRoundingMode m) := by
  cases m with
  | primitive p => cases p <;> rfl
  | fromZero => rfl
  | nearestTiesUp =>
    exact (Scalar.ProofsBits.copysign_eq_Fl64 _ _).symm

theorem rootRoundingObservation (x : F64) (m : StandardRounding) :
    IntegralFloatObservation m x (roundScalarF64 x m) := by
  rw [rootRoundScalarBridge]
  refine ⟨?_, ?_, ?_⟩
  · intro hx
    exact (Scalar.ProofsBits.isnan_iff _).mp
      (Scalar.ProofRoundInt.roundF_nan x _ ((Scalar.ProofsBits.isnan_iff _).mpr hx))
  · intro hx
    have hi : F64.isinf x = true := (Scalar.ProofsBits.isinf_iff _).mpr hx
    obtain ⟨s, rfl⟩ := Scalar.ProofsBits.inf_of_isinf x hi
    exact Scalar.ProofRoundInt.roundF_inf s _
  · intro hx
    obtain ⟨hf, hs, hr⟩ := Scalar.roundModesExact_proven x (rootRoundingMode m) hx
    refine ⟨hf, hs, Scalar.exactRound (F64.toRat x).1 (F64.toRat x).2
      (rootRoundingMode m), hr, ?_⟩
    exact rootExactRoundRule m _ _ (Scalar.ProofsBits.toRat_den_pos x hx)

theorem Models1G19ComplexRoundingModes_proven :
    JuliaLean.Proofs.base.complex.Models1Group19.ComplexRoundingModes := by
  intro z rr ri
  exact ⟨rootRoundingObservation z.re rr, rootRoundingObservation z.im ri,
    rootRoundingObservation z.re (.primitive .RoundNearest),
    rootRoundingObservation z.im (.primitive .RoundNearest),
    rootRoundingObservation z.re rr, rootRoundingObservation z.im rr⟩

end JuliaLean.ChatGPT.Batch10.Group1

