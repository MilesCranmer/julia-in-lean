theorem intDivOneSmall (k : SmallFloatKind) (z : Complex (SmallValue k))
    (hr : z.re.isfinite = true) (hi : z.im.isfinite = true) :
    let r := divideSmall k z ⟨Fl.ofInt 1, Fl.zero false⟩
    Fl.eq r.re z.re = true ∧ Fl.eq r.im z.im = true :=
