base/show.jl:1706-1713 @ f755f49a9e41380d7da126b3c1db9fe7f83dd027. -/
def MixedShowUnquotedEffects : Prop :=
  ∀ (E State IO A Printed Shown : Type)
      (ops : ShowUnquotedOps (MixedShowM E State) IO A Printed Shown)
      (io : IO) (z : Complex A) (indent prec : JInt .i64) (initial : State),
    MixedShowAudit io z prec initial
      ((showUnquotedComplex (MixedShowObservedOps ops) io z indent prec) (initial, []))

