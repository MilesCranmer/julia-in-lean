theorem nat_or_mul_pow (a b k : Nat) (hr : a < 2 ^ k) :
    a ||| b * 2 ^ k = a + b * 2 ^ k := by
  apply Nat.eq_of_testBit_eq
  intro i
  rw [Nat.testBit_or]
  rcases Nat.lt_or_ge i k with hlt | hge
  · have h1 : (b * 2 ^ k).testBit i = false := by
      have hm : (b * 2 ^ k) % 2 ^ k = 0 := Nat.mul_mod_left b (2 ^ k)
      have htb := Nat.testBit_mod_two_pow (b * 2 ^ k) k i
      rw [hm, decide_eq_true hlt, Bool.true_and, Nat.zero_testBit] at htb
      exact htb.symm
    have h2 : (a + b * 2 ^ k).testBit i = a.testBit i := by
      have hm : (a + b * 2 ^ k) % 2 ^ k = a := by
        rw [Nat.add_mul_mod_self_right, Nat.mod_eq_of_lt hr]
      have htb := Nat.testBit_mod_two_pow (a + b * 2 ^ k) k i
      rw [hm, decide_eq_true hlt, Bool.true_and] at htb
      exact htb.symm
    rw [h1, h2, Bool.or_false]
  · have h1 : a.testBit i = false :=
      Nat.testBit_lt_two_pow (Nat.lt_of_lt_of_le hr (Nat.pow_le_pow_right (by decide) hge))
    have hi : i = (i - k) + k := (Nat.sub_add_cancel hge).symm
    rw [h1, Bool.false_or, hi, Nat.testBit_add, Nat.testBit_add,
      Nat.mul_div_cancel _ (Nat.two_pow_pos k),
      Nat.add_mul_div_right _ _ (Nat.two_pow_pos k), Nat.div_eq_of_lt hr, Nat.zero_add]

theorem roundQuotient_scale (a b k : Nat) (hk : 0 < k) :
    rq (a * k) (b * k) = rq a b := by
  unfold rq
  rw [Nat.mul_div_mul_right a b hk, Nat.mul_mod_mul_right]
  dsimp only
  have hgt : 2 * (a % b * k) > b * k ↔ 2 * (a % b) > b := by
    rw [← Nat.mul_assoc]
    exact Nat.mul_lt_mul_right hk
  have heq : 2 * (a % b * k) = b * k ↔ 2 * (a % b) = b := by
    rw [← Nat.mul_assoc]
    exact Nat.mul_right_cancel_iff (by omega)
  have hbeq : (2 * (a % b * k) == b * k) = (2 * (a % b) == b) := by
    apply Bool.eq_iff_iff.mpr
    simpa only [beq_iff_eq] using heq
  simp only [hgt, hbeq]

theorem roundQuotient_guard (a d : Nat) (hd : 0 < d) :
    rq a (d * 2) =
      let y := (a / d + 1) / 2
      if a % d = 0 ∧ a / d % 2 = 1 then y - y % 2 else y := by
  have hrem : a % d < d := Nat.mod_lt a hd
  have hbit : a / d % 2 < 2 := Nat.mod_lt _ (by decide)
  have hsplit : a % (d * 2) = d * (a / d % 2) + a % d := by
    calc
      a % (d * 2) = d * (a % (d * 2) / d) + a % (d * 2) % d := by
        simpa [Nat.mul_comm, Nat.add_comm] using (Nat.mod_add_div (a % (d * 2)) d).symm
      _ = d * (a / d % 2) + a % d := by
        rw [Nat.mod_mul_right_div_self, Nat.mod_mul_right_mod]
  have hdiv : a / (d * 2) = a / d / 2 := by
    rw [Nat.div_div_eq_div_mul]
  unfold rq
  rw [hsplit, hdiv]
  dsimp only
  clear hsplit hdiv
  generalize a / d = b at *
  generalize a % d = r at *
  by_cases hb : b % 2 = 0
  · have hy : (b + 1) / 2 = b / 2 := by omega
    have hc : ¬(2 * r > d * 2) := by omega
    have ht : 2 * r ≠ d * 2 := by omega
    simp [hb, hc, ht, hy]
  · have hb1 : b % 2 = 1 := by omega
    have hy : (b + 1) / 2 = b / 2 + 1 := by omega
    rw [hb1, Nat.mul_one, hy]
    by_cases hz : r = 0
    · simp only [hz, Nat.add_zero, Nat.mul_comm d 2, Nat.lt_irrefl, decide_false,
        beq_self_eq_true, Bool.false_or, Bool.true_and, true_and, ↓reduceIte]
      generalize b / 2 = q
      have hpar : q % 2 < 2 := Nat.mod_lt _ (by decide)
      by_cases hp : q % 2 = 1 <;> simp [hp] <;> omega
    · have hstrict : 2 * (d + r) > d * 2 := by omega
      simp [hz, hstrict]

theorem nat_or_div_pow (a b r : Nat) (hb : b < 2 ^ r) :
    (a ||| b) / 2 ^ r = a / 2 ^ r := by
  apply Nat.eq_of_testBit_eq
  intro i
  rw [Nat.testBit_div_two_pow, Nat.testBit_or, Nat.testBit_div_two_pow]
  have hbit : b.testBit (i + r) = false := by
    have ht := congrArg (fun z : Nat => z.testBit i) (Nat.div_eq_of_lt hb)
    simpa only [Nat.testBit_div_two_pow, Nat.zero_testBit] using ht
  simp only [hbit, Bool.or_false]

theorem nat_or_mod_pow (a b r : Nat) :
    (a ||| b) % 2 ^ r = (a % 2 ^ r) ||| (b % 2 ^ r) := by
  apply Nat.eq_of_testBit_eq
  intro i
  simp only [Nat.testBit_mod_two_pow, Nat.testBit_or]
  by_cases hi : i < r <;> simp [hi]

theorem nat_or_zero (a b : Nat) : (a ||| b) = 0 ↔ a = 0 ∧ b = 0 := by
  constructor
  · intro h
    have ha : a = 0 := by
      apply Nat.eq_of_testBit_eq
      intro i
      have hz := congrArg (fun n : Nat => n.testBit i) h
      simp only [Nat.testBit_or, Nat.zero_testBit, Bool.or_eq_false_iff] at hz
      simpa only [Nat.zero_testBit] using hz.1
    have hb : b = 0 := by
      apply Nat.eq_of_testBit_eq
      intro i
      have hz := congrArg (fun n : Nat => n.testBit i) h
      simp only [Nat.testBit_or, Nat.zero_testBit, Bool.or_eq_false_iff] at hz
      simpa only [Nat.zero_testBit] using hz.2
    exact ⟨ha, hb⟩
  · rintro ⟨rfl, rfl⟩
    rfl

theorem sticky24_div_guard (n k : Nat) (hk : 49 ≤ k) :
    (((n / 2 ^ 24) ||| (n % 2 ^ 24)) * 2 ^ 24) / 2 ^ (k - 1) = n / 2 ^ (k - 1) := by
  have hb : n % 2 ^ 24 < 2 ^ (k - 25) :=
    Nat.lt_of_lt_of_le (Nat.mod_lt n (Nat.two_pow_pos 24)) (Nat.pow_le_pow_right (by decide) (by omega))
  have hd : 2 ^ (k - 1) = 2 ^ (k - 25) * 2 ^ 24 := by
    rw [← Nat.pow_add]; congr 1; omega
  rw [hd, Nat.mul_div_mul_right _ _ (Nat.two_pow_pos 24), nat_or_div_pow _ _ _ hb]
  rw [Nat.div_div_eq_div_mul, Nat.mul_comm (2 ^ 24)]

theorem sticky24_zero_guard (n k : Nat) (hk : 49 ≤ k) :
    (((n / 2 ^ 24) ||| (n % 2 ^ 24)) * 2 ^ 24) % 2 ^ (k - 1) = 0 ↔ n % 2 ^ (k - 1) = 0 := by
  have hb : n % 2 ^ 24 < 2 ^ (k - 25) :=
    Nat.lt_of_lt_of_le (Nat.mod_lt n (Nat.two_pow_pos 24)) (Nat.pow_le_pow_right (by decide) (by omega))
  have hd : 2 ^ (k - 1) = 2 ^ (k - 25) * 2 ^ 24 := by
    rw [← Nat.pow_add]; congr 1; omega
  rw [hd, Nat.mul_mod_mul_right, nat_or_mod_pow, Nat.mod_eq_of_lt hb]
  have hz : ∀ a : Nat, a * 2 ^ 24 = 0 ↔ a = 0 := by intro a; omega
  rw [hz, nat_or_zero]
  have hdiv : n % (2 ^ (k - 25) * 2 ^ 24) / 2 ^ 24 = n / 2 ^ 24 % 2 ^ (k - 25) := by
    rw [Nat.mul_comm (2 ^ (k - 25)), Nat.mod_mul_right_div_self]
  have hmod : n % (2 ^ (k - 25) * 2 ^ 24) % 2 ^ 24 = n % 2 ^ 24 := by
    rw [Nat.mul_comm (2 ^ (k - 25)), Nat.mod_mul_right_mod]
  constructor
  · rintro ⟨ha, hb0⟩
    rw [ha] at hdiv
    rw [hb0] at hmod
    omega
  · intro hn
    rw [hn] at hdiv hmod
    simp only [Nat.zero_div, Nat.zero_mod] at hdiv hmod
    exact ⟨hdiv.symm, hmod.symm⟩

theorem roundQuotient_sticky24 (n k : Nat) (hk : 49 ≤ k) :
    rq (((n / 2 ^ 24) ||| (n % 2 ^ 24)) * 2 ^ 24) (2 ^ k) =
      rq n (2 ^ k) := by
  have hd : 2 ^ k = 2 ^ (k - 1) * 2 := by
    rw [← Nat.pow_succ]; congr 1; omega
  rw [hd, roundQuotient_guard _ _ (Nat.two_pow_pos _), roundQuotient_guard _ _ (Nat.two_pow_pos _)]
  simp only [sticky24_div_guard n k hk, sticky24_zero_guard n k hk]

theorem roundRat_scale_pow (n j : Nat) (s : Bool) :
    F64.roundRat ((n * 2 ^ j : Nat) : Int) (2 ^ j) s = F64.roundRat (n : Int) 1 s := by
  have hp : 2 ^ j ≠ 0 := by have := Nat.two_pow_pos j; omega
  by_cases hn : n = 0
  · subst n
    simp only [Nat.zero_mul, Int.natCast_zero, roundRat_eq, beq_iff_eq,
      hp, Nat.one_ne_zero, ↓reduceIte, beq_self_eq_true]
  · have hnp : n * 2 ^ j ≠ 0 := Nat.mul_ne_zero hn hp
    have hnneg : decide ((n : Int) < 0) = false := decide_eq_false (Int.not_lt.mpr (Int.natCast_nonneg _))
    have hnpneg : decide (((n * 2 ^ j : Nat) : Int) < 0) = false :=
      decide_eq_false (Int.not_lt.mpr (Int.natCast_nonneg _))
    rw [roundRat_eq, roundRat_eq]
    simp only [beq_iff_eq, hp, hn, hnp, Int.natCast_eq_zero,
      Bool.false_eq_true, ↓reduceIte, Int.natAbs_natCast, hnpneg, hnneg]
    have hl : fl2 (n * 2^j) (2^j) = (n.log2 : Int) := by
      rw [fl2_pow n j j (by omega)]; omega
    have hr : fl2 n 1 = (n.log2 : Int) := by
      simpa only [Nat.pow_zero, Nat.mul_one, Nat.add_zero, Int.natCast_zero, Int.sub_zero] using
        fl2_pow n 0 0 (by omega)
    rw [hl, hr]
    simp only [show ¬ (1 : Nat) = 0 from by decide, ↓reduceIte]
    split
    · rfl
    · split
      · rfl
      · generalize max ((n.log2 : Int) - 52) (-1074) = k
        by_cases hk : k ≥ 0
        · simp only [hk, ↓reduceIte, Nat.one_mul]
          rw [Nat.mul_comm (2 ^ j) (2 ^ k.toNat), roundQuotient_scale _ _ _ (Nat.two_pow_pos j)]
        · simp only [hk, ↓reduceIte]
          rw [Nat.mul_right_comm n (2 ^ j) _]
          congr 1
          simpa only [Nat.one_mul] using
            roundQuotient_scale (n * 2 ^ (-k).toNat) 1 (2 ^ j) (Nat.two_pow_pos j)

theorem roundRat_exact_nat64 (c p : Nat) (hc : c < 2 ^ 53) (hp : p ≤ 76) :
    let x := F64.roundRat ((c * 2 ^ p : Nat) : Int) 1 false
    F64.isfinite x = true ∧ F64.signbit x = false ∧
      (F64.toRat x).1 = ((c * 2 ^ p : Nat) : Int) * ((F64.toRat x).2 : Int) := by
  dsimp only
  by_cases hc0 : c = 0
  · subst c
    simp only [Nat.zero_mul, Int.natCast_zero, roundRat_eq, beq_self_eq_true,
      Bool.false_eq_true, ↓reduceIte]
    exact ⟨by decide, by decide, by decide⟩
  have hl : c.log2 ≤ 52 := by have := (Nat.log2_lt hc0).mpr hc; omega
  let j := 52 - c.log2
  let M := c * 2^j
  have hj : j ≤ 52 := by dsimp only [j]; omega
  have hMlo : 2^52 ≤ M := by
    have h := Nat.mul_le_mul_right (2^j) (Nat.log2_self_le hc0)
    have hpow : 2^c.log2 * 2^j = 2^52 := by rw [← Nat.pow_add]; congr 1; dsimp only [j]; omega
    simpa only [hpow] using h
  have hMhi : M < 2^53 := by
    have h := Nat.mul_lt_mul_of_pos_right (show c < 2^(c.log2+1) from Nat.lt_log2_self) (Nat.two_pow_pos j)
    have hpow : 2^(c.log2+1) * 2^j = 2^53 := by rw [← Nat.pow_add]; congr 1; dsimp only [j]; omega
    simpa only [hpow] using h
  have hr := roundRat_norm M p j false false hMlo hMhi (by omega) (by omega)
  have hprod : M * 2^p = (c * 2^p) * 2^j := by dsimp only [M]; rw [Nat.mul_right_comm]
  simp only [Bool.false_eq_true, ↓reduceIte, hprod, Nat.zero_add,
    roundRat_scale_pow] at hr
  rw [hr]
  obtain ⟨hE, hF, hS, hfin⟩ := norm_fields false (p+1075-j) M (by omega) (by omega) hMlo hMhi
  simp only [Bool.false_eq_true, ↓reduceIte, Nat.zero_add] at hE hF hS hfin
  refine ⟨hfin, hS, ?_⟩
  by_cases hsmall : p < j
  · rw [toRat_norm _ (by omega) (by omega)]
    simp only [hS, hF, hE, Bool.false_eq_true, ↓reduceIte]
    have hM : M - 2^52 + 2^52 = M := by omega
    have hD : 1075 - (p+1075-j) = j-p := by omega
    rw [hM, hD, ← Int.natCast_mul]
    apply Int.natCast_inj.mpr
    dsimp only [M]
    rw [Nat.mul_assoc, ← Nat.pow_add]
    rw [show p+(j-p) = j by omega]
  · rw [toRat_big _ (by omega) (by omega)]
    simp only [hS, hF, hE, Bool.false_eq_true, ↓reduceIte,
      Int.natCast_one, Int.mul_one]
    have hM : M - 2^52 + 2^52 = M := by omega
    have hD : p+1075-j-1075 = p-j := by omega
    rw [hM, hD, ← Int.natCast_mul]
    apply Int.natCast_inj.mpr
    dsimp only [M]
    rw [Nat.mul_assoc, ← Nat.pow_add]
    rw [show j+(p-j) = p by omega]

theorem floatAdd_exact_naturals64 (x y : F64) (a b : Nat)
    (hx : F64.isfinite x = true ∧ F64.signbit x = false ∧
      (F64.toRat x).1 = (a : Int) * ((F64.toRat x).2 : Int))
    (hy : F64.isfinite y = true ∧ F64.signbit y = false ∧
      (F64.toRat y).1 = (b : Int) * ((F64.toRat y).2 : Int)) :
    F64.add x y = F64.roundRat ((a + b : Nat) : Int) 1 false := by
  obtain ⟨jx, _, hxd⟩ := finite_den_pow x hx.1
  obtain ⟨jy, _, hyd⟩ := finite_den_pow y hy.1
  unfold F64.add
  simp only [finite_not_nan x hx.1, finite_not_nan y hy.1,
    finite_not_inf x hx.1, finite_not_inf y hy.1, Bool.false_eq_true,
    ↓reduceIte, hx.2.1, hy.2.1, Bool.false_and]
  rw [hx.2.2, hy.2.2]
  have hn : (a : Int) * ((F64.toRat x).2 : Int) * ((F64.toRat y).2 : Int) +
      (b : Int) * ((F64.toRat y).2 : Int) * ((F64.toRat x).2 : Int) =
      ((a + b : Nat) : Int) * (((F64.toRat x).2 * (F64.toRat y).2 : Nat) : Int) := by
    simp only [Int.natCast_add, Int.natCast_mul, Int.add_mul, Int.mul_assoc, Int.mul_comm, Int.mul_left_comm]
  rw [hn, hxd, hyd, ← Nat.pow_add, ← Int.natCast_mul]
  exact roundRat_scale_pow (a + b) (jx + jy) false

theorem packed_integer_rat (e m : Nat) (he : 1075 ≤ e ∧ e ≤ 1151) (hm : m < 2 ^ 52) :
    let x := F64.ofBits (e * 2^52 + m)
    F64.isfinite x = true ∧ F64.signbit x = false ∧
      F64.toRat x = ((((2^52 + m) * 2^(e-1075) : Nat) : Int), 1) := by
  have hp := norm_fields false e (2^52+m) (by omega) (by omega) (by omega) (by omega)
  simp only [Bool.false_eq_true, ↓reduceIte, Nat.zero_add, Nat.add_sub_cancel_left] at hp
  dsimp only
  refine ⟨hp.2.2.2, hp.2.2.1, ?_⟩
  rw [toRat_big _ (by omega) (by omega)]
  simp only [hp.2.2.1, hp.1, hp.2.1, Bool.false_eq_true, ↓reduceIte,
    Int.natCast_mul]
  rw [Nat.add_comm m (2^52)]

theorem floatSub_packed_exact (m p : Nat) (hm : m < 2 ^ 52) (hp : p ≤ 76) :
    F64.sub (F64.ofBits ((1075+p)*2^52+m)) (F64.ofBits ((1075+p)*2^52)) =
      F64.roundRat ((m * 2 ^ p : Nat) : Int) 1 false := by
  have hx := packed_integer_rat (1075+p) m (by omega) hm
  have hz := packed_integer_rat (1075+p) 0 (by omega) (Nat.two_pow_pos 52)
  simp only [Nat.add_zero] at hz
  rw [sub_finite _ _ hx.1 hz.1, hx.2.2, hz.2.2]
  simp only [Prod.fst, Prod.snd, Int.natCast_one, Int.mul_one, Nat.one_mul,
    hx.2.1, Bool.false_and, Nat.add_sub_cancel_left, Nat.add_zero]
  congr 1
  simp only [Int.natCast_mul, Int.natCast_add, Int.add_mul]
  omega
theorem roundRat_nat64_normal (n : Nat) (hn : 0 < n) (hlog : n.log2 ≤ 1023) :
    F64.roundRat (n : Int) 1 false =
      pk false (if 52 ≤ n.log2 then rq n (2^(n.log2-52))
        else n * 2^(52-n.log2)) ((n.log2 : Int)-52) := by
  have hnI : (n : Int) ≠ 0 := by omega
  have hneg : decide ((n : Int) < 0) = false := decide_eq_false (Int.not_lt.mpr (Int.natCast_nonneg _))
  have hfloor : fl2 n 1 = (n.log2 : Int) := by
    simpa only [Nat.pow_zero, Nat.mul_one, Nat.add_zero, Int.natCast_zero, Int.sub_zero] using
      fl2_pow n 0 0 hn
  rw [roundRat_eq]
  simp only [show ((1 : Nat) == 0) = false from rfl, Bool.false_eq_true, ↓reduceIte,
    beq_eq_false_iff_ne.mpr hnI, hneg, Int.natAbs_natCast, hfloor]
  rw [ite_eq_right (show ¬ ((n.log2 : Int) ≥ 1024) by omega),
    ite_eq_right (show ¬ ((n.log2 : Int) < -1075) by omega)]
  have hk : max ((n.log2 : Int)-52) (-1074) = (n.log2 : Int)-52 := by omega
  rw [hk]
  by_cases he : 52 ≤ n.log2
  · have heI : 0 ≤ (n.log2 : Int)-52 := by omega
    have hcast : ((n.log2 : Int)-52).toNat = n.log2-52 := by omega
    simp only [he, ↓reduceIte, heI, hcast, Nat.one_mul]
  · have heI : ¬ (0 ≤ (n.log2 : Int)-52) := by omega
    have hcast : (-((n.log2 : Int)-52)).toNat = 52-n.log2 := by omega
    simp only [he, ↓reduceIte, heI, hcast]
    rw [rq_exact _ 1 (by decide) (Nat.mod_one _), Nat.div_one]

theorem roundRat_sticky24_64 (n : Nat) (hlo : 2 ^ 104 ≤ n) (hhi : n < 2 ^ 128) :
    (F64.roundRat ((((n / 2 ^ 24) ||| (n % 2 ^ 24)) * 2 ^ 24 : Nat) : Int) 1 false) =
      F64.roundRat (n : Int) 1 false := by
  let m := ((n / 2 ^ 24) ||| (n % 2 ^ 24)) * 2 ^ 24
  have hn0 : n ≠ 0 := by omega
  have hl : 104 ≤ n.log2 := (Nat.le_log2 hn0).mpr hlo
  have hh : n.log2 ≤ 127 := by have := (Nat.log2_lt hn0).mpr hhi; omega
  have hd := Nat.two_pow_pos n.log2
  have hnlow := Nat.log2_self_le hn0
  have hnhigh : n < 2 ^ (n.log2 + 1) := Nat.lt_log2_self
  have hnqlo : 1 ≤ n / 2 ^ n.log2 := (Nat.le_div_iff_mul_le hd).mpr (by simpa using hnlow)
  have hnqhi : n / 2 ^ n.log2 < 2 := (Nat.div_lt_iff_lt_mul hd).mpr (by simpa only [Nat.pow_succ, Nat.mul_comm] using hnhigh)
  have hnq : n / 2 ^ n.log2 = 1 := by omega
  have hmq := sticky24_div_guard n (n.log2 + 1) (by omega)
  change m / 2 ^ (n.log2 + 1 - 1) = _ at hmq
  rw [show n.log2 + 1 - 1 = n.log2 by omega, hnq] at hmq
  have hmlow : 2 ^ n.log2 ≤ m := by
    simpa only [Nat.one_mul] using
      (Nat.le_div_iff_mul_le hd).mp (show 1 ≤ m / 2 ^ n.log2 by omega)
  have hmhi : m < 2 ^ (n.log2 + 1) := by
    have h := (Nat.div_lt_iff_lt_mul hd).mp (show m / 2 ^ n.log2 < 2 by omega)
    simpa only [Nat.pow_succ, Nat.mul_comm] using h
  have hm0 : m ≠ 0 := by omega
  have hml : m.log2 = n.log2 := by
    have h1 := (Nat.le_log2 hm0).mpr hmlow
    have h2 := (Nat.log2_lt hm0).mpr hmhi
    omega
  change (F64.roundRat (m : Int) 1 false) = _
  rw [roundRat_nat64_normal m (by omega) (by omega), roundRat_nat64_normal n (by omega) (by omega), hml]
  simp only [show 52 ≤ n.log2 by omega, ↓reduceIte]
  congr 1
  exact roundQuotient_sticky24 n (n.log2 - 52) (by omega)

def uint128Source (n : Nat) : F64 :=
  if n < 2^104 then
    let lowExp := F64.ofBits (1075 <<< 52)
    let highExp := F64.ofBits (1127 <<< 52)
    let lowBits := Nat.land (n % 2^64) (2^52-1)
    let lowValue := F64.sub (F64.ofBits (Nat.lor (F64.toBits lowExp) lowBits)) lowExp
    let highBits := (n >>> 52) % 2^64
    let highValue := F64.sub (F64.ofBits (Nat.lor (F64.toBits highExp) highBits)) highExp
    F64.add lowValue highValue
  else
    let lowExp := F64.ofBits (1099 <<< 52)
    let highExp := F64.ofBits (1151 <<< 52)
    let lowBits := Nat.lor (((n >>> 12) % 2^64) >>> 12) (Nat.land (n % 2^64) 0xffffff)
    let lowValue := F64.sub (F64.ofBits (Nat.lor (F64.toBits lowExp) lowBits)) lowExp
    let highBits := (n >>> 76) % 2^64
    let highValue := F64.sub (F64.ofBits (Nat.lor (F64.toBits highExp) highBits)) highExp
    F64.add lowValue highValue

theorem exponent_or (e m : Nat) (he : e < 2048) (hm : m < 2^52) :
    Nat.lor (F64.toBits (F64.ofBits (e * 2^52))) m = e * 2^52 + m := by
  rw [tb_ofBits, Nat.mod_eq_of_lt (show e*2^52 < 2^64 by omega)]
  change e * 2^52 ||| m = _
  rw [Nat.or_comm, nat_or_mul_pow m e 52 hm, Nat.add_comm]

theorem uint128Source_intermediate (n : Nat) (hn : n < 2^128) :
    uint128Source n = F64.roundRat
      ((if n < 2^104 then n else
        (((n / 2^24) % 2^52) ||| (n % 2^24)) * 2^24 +
          (n / 2^76) * 2^76 : Nat) : Int) 1 false := by
  unfold uint128Source
  by_cases hs : n < 2^104
  · simp only [hs, ↓reduceIte]
    have hm := Nat.mod_lt n (Nat.two_pow_pos 52)
    have hh : n / 2^52 < 2^52 := by omega
    have hl : Nat.land (n % 2^64) (2^52-1) = n % 2^52 := by
      rw [Nat.land_eq, Nat.and_two_pow_sub_one_eq_mod]
      exact Nat.mod_mod_of_dvd n (by decide)
    have hhigh : (n >>> 52) % 2^64 = n / 2^52 := by
      rw [Nat.shiftRight_eq_div_pow, Nat.mod_eq_of_lt (by omega)]
    rw [hl, hhigh]
    simp only [Nat.shiftLeft_eq]
    rw [exponent_or 1075 _ (by decide) hm, exponent_or 1127 _ (by decide) hh]
    rw [floatSub_packed_exact _ 0 hm (by decide), floatSub_packed_exact _ 52 hh (by decide)]
    rw [floatAdd_exact_naturals64 _ _ _ _
      (roundRat_exact_nat64 _ 0 (by omega) (by decide))
      (roundRat_exact_nat64 _ 52 (by omega) (by decide))]
    congr 1
    simp only [Nat.pow_zero, Nat.mul_one]
    congr 1
    omega
  · simp only [hs, ↓reduceIte]
    have hl1 : ((n >>> 12) % 2^64) >>> 12 = (n / 2^24) % 2^52 := by
      simp only [Nat.shiftRight_eq_div_pow]; omega
    have hl2 : Nat.land (n % 2^64) 0xffffff = n % 2^24 := by
      change Nat.land (n%2^64) (2^24-1) = _
      rw [Nat.land_eq, Nat.and_two_pow_sub_one_eq_mod]
      exact Nat.mod_mod_of_dvd n (by decide)
    have hl : ((n / 2^24) % 2^52 ||| n % 2^24) < 2^52 :=
      Nat.or_lt_two_pow (Nat.mod_lt _ (Nat.two_pow_pos 52))
        (by have := Nat.mod_lt n (Nat.two_pow_pos 24); omega)
    have hh : n / 2^76 < 2^52 := by omega
    have hhigh : (n >>> 76) % 2^64 = n / 2^76 := by
      rw [Nat.shiftRight_eq_div_pow, Nat.mod_eq_of_lt (by omega)]
    rw [hl1, hl2, hhigh, Nat.lor_eq (m := (n/2^24)%2^52) (n := n%2^24)]
    simp only [Nat.shiftLeft_eq]
    rw [exponent_or 1099 _ (by decide) hl, exponent_or 1151 _ (by decide) hh]
    rw [floatSub_packed_exact _ 24 hl (by decide), floatSub_packed_exact _ 76 hh (by decide)]
    exact floatAdd_exact_naturals64 _ _ _ _
      (roundRat_exact_nat64 _ 24 (by omega) (by decide))
      (roundRat_exact_nat64 _ 76 (by omega) (by decide))

theorem uint128Source_rounded (n : Nat) (hn : n < 2^128) :
    uint128Source n = F64.roundRat (n : Int) 1 false := by
  rw [uint128Source_intermediate n hn]
  by_cases hs : n < 2^104
  · simp only [hs, ↓reduceIte]
  · simp only [hs, ↓reduceIte]
    have hb : n % 2^24 < 2^52 := by have := Nat.mod_lt n (Nat.two_pow_pos 24); omega
    have ha := Nat.mod_lt (n/2^24) (Nat.two_pow_pos 52)
    have hl : ((n/2^24)%2^52 ||| n%2^24) < 2^52 := Nat.or_lt_two_pow ha hb
    have hdiv : n/2^24 = (n/2^24)%2^52 + (n/2^76)*2^52 := by omega
    have hor : (n/2^24 ||| n%2^24) =
        ((n/2^24)%2^52 ||| n%2^24) + (n/2^76)*2^52 := by
      conv => lhs; rw [hdiv]
      rw [← nat_or_mul_pow _ _ 52 ha, Nat.or_assoc,
        Nat.or_comm ((n/2^76)*2^52), ← Nat.or_assoc, nat_or_mul_pow _ _ 52 hl]
    have hnum : ((n/2^24)%2^52 ||| n%2^24)*2^24 + n/2^76*2^76 =
        (n/2^24 ||| n%2^24)*2^24 := by
      rw [hor, Nat.add_mul]; omega
    rw [hnum]
    exact roundRat_sticky24_64 n (by omega) hn
theorem rq_floor_bounds (n d : Nat) : n/d ≤ rq n d ∧ rq n d ≤ n/d+1 := by
  unfold rq
  dsimp only
  split <;> omega

theorem rounded_nat_significand_bounds (n : Nat) (hn : 0 < n) :
    let q := if 52 ≤ n.log2 then rq n (2^(n.log2-52)) else n*2^(52-n.log2)
    2^52 ≤ q ∧ q ≤ 2^53 := by
  dsimp only
  have hlo := Nat.log2_self_le (by omega : n ≠ 0)
  have hhi : n < 2^(n.log2+1) := Nat.lt_log2_self
  by_cases he : 52 ≤ n.log2
  · simp only [he, ↓reduceIte]
    have hp : 2^52*2^(n.log2-52) = 2^n.log2 := by
      rw [← Nat.pow_add]; congr 1; omega
    have hp' : 2^53*2^(n.log2-52) = 2^(n.log2+1) := by
      rw [← Nat.pow_add]; congr 1; omega
    have hqlo : 2^52 ≤ n/2^(n.log2-52) := by
      apply (Nat.le_div_iff_mul_le (Nat.two_pow_pos _)).mpr
      rw [hp]; exact hlo
    have hqhi : n/2^(n.log2-52) < 2^53 := by
      apply (Nat.div_lt_iff_lt_mul (Nat.two_pow_pos _)).mpr
      rw [hp']; exact hhi
    have hq := rq_floor_bounds n (2^(n.log2-52))
    omega
  · simp only [he, ↓reduceIte]
    have hp : 2^n.log2 * 2^(52-n.log2) = 2^52 := by
      rw [← Nat.pow_add]; congr 1; omega
    have hp' : 2^(n.log2+1) * 2^(52-n.log2) = 2^53 := by
      rw [← Nat.pow_add]; congr 1; omega
    have hqlo := Nat.mul_le_mul_right (2^(52-n.log2)) hlo
    have hqhi := Nat.mul_lt_mul_of_pos_right hhi (Nat.two_pow_pos (52-n.log2))
    rw [hp] at hqlo
    rw [hp'] at hqhi
    omega

theorem pk_nat_finite_sign (q : Nat) (k : Int) (hqlo : 2^52 ≤ q) (hqhi : q ≤ 2^53)
    (hklo : -52 ≤ k) (hkhi : k ≤ 75) :
    F64.isfinite (pk false q k) = true ∧ F64.signbit (pk false q k) = false := by
  by_cases hq : q < 2^53
  · rw [pk_norm false q k hqlo hq (by omega) (by omega)]
    have hfields := norm_fields false (k+1075).toNat q (by omega) (by omega) hqlo hq
    simp only [Bool.false_eq_true, ↓reduceIte, Nat.zero_add] at hfields ⊢
    exact ⟨hfields.2.2.2, hfields.2.2.1⟩
  · have heq : q = 2^53 := by omega
    subst q
    have hpk : pk false (2^53) k = F64.ofBits ((k+1076).toNat*2^52) := by
      unfold pk
      simp only [show (2^53 == 0) = false by decide, Bool.false_eq_true, ↓reduceIte,
        Nat.le_refl, show 2^53/2 = 2^52 by decide,
        show ¬ (k+1+1075 ≥ 2047) by omega, Nat.lt_irrefl, Nat.sub_self, Nat.add_zero,
        Nat.zero_add]
      congr 2
      omega
    rw [hpk]
    have hfields := norm_fields false (k+1076).toNat (2^52) (by omega) (by omega)
      (by omega) (by decide)
    simp only [Bool.false_eq_true, ↓reduceIte, Nat.zero_add, Nat.sub_self, Nat.add_zero] at hfields
    exact ⟨hfields.2.2.2, hfields.2.2.1⟩

theorem roundRat_nat64_finite_sign (n : Nat) (hn : n < 2^128) :
    F64.isfinite (F64.roundRat (n : Int) 1 false) = true ∧
      F64.signbit (F64.roundRat (n : Int) 1 false) = false := by
  by_cases hz : n = 0
  · subst n
    exact ⟨by decide, by decide⟩
  have hlog : n.log2 ≤ 127 := by have := (Nat.log2_lt hz).mpr hn; omega
  rw [roundRat_nat64_normal n (by omega) (by omega)]
  have hq := rounded_nat_significand_bounds n (by omega)
  exact pk_nat_finite_sign _ _ hq.1 hq.2 (by omega) (by omega)

theorem ofJInt_u128_rounded (x : JInt .u128) : F64.ofJInt x = F64.ofInt x.val := by
  have hxlo : 0 ≤ x.val := x.property.1
  have hxhi : x.val < (2^128 : Int) := by have := x.property.2; change x.val ≤ 2^128-1 at this; omega
  change uint128Source (wrapInt .u128 x.val).toNat = _
  rw [wrapInt_of_inRange _ _ x.property, uint128Source_rounded _ (by omega)]
  rw [Int.toNat_of_nonneg hxlo]
  rfl

theorem ofJInt_i128_source (x : JInt .i128) : F64.ofJInt x =
    F64.ofBits (Nat.lor (F64.toBits (uint128Source x.val.natAbs))
      (if x.val < 0 then 2^63 else 0)) := by
  have hxlo := x.property.1
  have hxhi := x.property.2
  change -(2^127 : Int) ≤ x.val at hxlo
  change x.val ≤ (2^127 : Int)-1 at hxhi
  have hmag : IntTy.u128.min ≤ (x.val.natAbs : Int) ∧ (x.val.natAbs : Int) ≤ IntTy.u128.max := by
    change 0 ≤ (x.val.natAbs : Int) ∧ (x.val.natAbs : Int) ≤ 2^128-1
    constructor
    · omega
    · rcases Int.natAbs_eq x.val with h | h <;> omega
  change F64.ofBits (Nat.lor (F64.toBits (uint128Source (wrapInt .u128 (x.val.natAbs : Int)).toNat))
      (if x.val < 0 then 2^63 else 0)) = _
  rw [wrapInt_of_inRange _ _ hmag, Int.toNat_natCast]
theorem roundRat_zeroSign_irrel (n : Int) (d : Nat) (s t : Bool) (hn : n ≠ 0) :
    F64.roundRat n d s = F64.roundRat n d t := by
  rw [roundRat_eq, roundRat_eq]
  simp only [beq_eq_false_iff_ne.mpr hn, Bool.false_eq_true, ↓reduceIte]

theorem roundRat_neg_nonzero (n : Int) (hn : n ≠ 0) :
    F64.roundRat (-n) 1 false = F64.neg (F64.roundRat n 1 false) := by
  rw [← roundRat_neg_of_den_ne_zero n 1 false (by decide)]
  exact roundRat_zeroSign_irrel _ _ _ _ (by omega)

theorem ofBits_toBits (x : F64) : F64.ofBits (F64.toBits x) = x := by
  apply f64_ext
  rw [tb_ofBits, Nat.mod_eq_of_lt (tb_lt x)]

theorem ofJInt_i128_rounded (x : JInt .i128) : F64.ofJInt x = F64.ofInt x.val := by
  have hxlo := x.property.1
  have hxhi := x.property.2
  change -(2^127 : Int) ≤ x.val at hxlo
  change x.val ≤ (2^127 : Int)-1 at hxhi
  have hmag : x.val.natAbs < 2^128 := by
    rcases Int.natAbs_eq x.val with h | h <;> omega
  rw [ofJInt_i128_source, uint128Source_rounded _ hmag]
  by_cases hs : x.val < 0
  · simp only [hs, ↓reduceIte]
    have hsign := (roundRat_nat64_finite_sign x.val.natAbs hmag).2
    have hbits := signbit_f _ |>.mp hsign
    have hor : Nat.lor (F64.toBits (F64.roundRat (x.val.natAbs : Int) 1 false)) (2^63) =
        F64.toBits (F64.roundRat (x.val.natAbs : Int) 1 false) + 2^63 := by
      simpa only [Nat.one_mul, Nat.lor_eq] using nat_or_mul_pow
        (F64.toBits (F64.roundRat (x.val.natAbs : Int) 1 false)) 1 63 hbits
    rw [hor]
    have hneg : F64.neg (F64.roundRat (x.val.natAbs : Int) 1 false) =
        F64.ofBits (F64.toBits (F64.roundRat (x.val.natAbs : Int) 1 false)+2^63) := by
      unfold F64.neg
      simp only [hsign, Bool.false_eq_true, ↓reduceIte]
    rw [← hneg, ← roundRat_neg_nonzero _ (by omega)]
    have hx : -(x.val.natAbs : Int) = x.val := (Int.eq_neg_natAbs_of_nonpos (by omega)).symm
    rw [hx]
    rfl
  · simp only [hs, ↓reduceIte, Nat.lor_eq, Nat.or_zero, ofBits_toBits]
    rw [Int.natAbs_of_nonneg (by omega)]
    rfl

end Scalar.IntSource

