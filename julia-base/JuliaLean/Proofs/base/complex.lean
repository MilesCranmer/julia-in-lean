set_option maxRecDepth 10000
set_option maxHeartbeats 1000000
set_option exponentiation.threshold 10000
set_option linter.unusedSimpArgs false

variable {f : Fmt}

theorem good_wide (k : SmallFloatKind) : Good (wideFormat k) := by
  cases k
  · exact good_single
  · exact good_double

theorem zero_of_iszero (x : Fl f) (hz : x.iszero = true) : x = Fl.zero x.signbit := by
  have hm : x.magnitude = 0 := beq_iff_eq.mp hz
  have he : x.expField = 0 := by rw [floatCheckFlExpMagnitude, hm, Nat.zero_div]
  have hr : x.frac = 0 := by rw [floatCheckFlFracMagnitude, hm, Nat.zero_mod]
  calc x = pack x.signbit x.expField x.frac := (pack_source x).symm
    _ = Fl.zero x.signbit := by
      simp only [pack, floatCheckFlPack, he, hr, Nat.zero_mul, Nat.zero_add, Nat.add_zero, Fl.zero]

theorem roundRat_toRat_zeroSign (hf : Good f) (x : Fl f) (hx : x.isfinite = true) (s : Bool) :
    Fl.roundRat x.toRat.1 x.toRat.2 s = if x.iszero then Fl.zero s else x := by
  have hd : x.toRat.2 ≠ 0 := Nat.ne_of_gt (floatCheckFlRatDenPos f x hx)
  by_cases hz : x.iszero = true
  · have hn := (floatCheckFlRatZeroIff f x hx).mpr hz
    simp only [Fl.roundRat, beq_eq_false_iff_ne.mpr hd, hn, beq_self_eq_true,
      Bool.false_eq_true, ↓reduceIte, hz]
  · have hn : x.toRat.1 ≠ 0 := fun h => hz ((floatCheckFlRatZeroIff f x hx).mp h)
    rw [floatCheckFlRoundRatZeroSign f _ _ s x.signbit hn, roundRat_toRat hf x hx,
      if_neg hz]

theorem wideRound_zero (k : SmallFloatKind) (d : Nat) (s : Bool) (hd : d ≠ 0) :
    floatCheckWideRound k 0 d s = Fl.zero s := by
  cases k
  · simp only [floatCheckWideRound, Fl.roundRat, beq_eq_false_iff_ne.mpr hd,
      beq_self_eq_true, Bool.false_eq_true, ↓reduceIte]
  · change Fl.ofF64 (F64.roundRat 0 d s) = (Fl.zero s : Fl double)
    rw [f64_roundRat_eq]
    simp only [beq_eq_false_iff_ne.mpr hd, beq_self_eq_true, Bool.false_eq_true, ↓reduceIte]
    rw [← floatCheckFlToF64Zero, floatCheckFlOfToF64]

theorem wideRound_scaled_toRat (k : SmallFloatKind) (x : WideValue k)
    (hx : x.isfinite = true) (j : Nat) (s : Bool) :
    floatCheckWideRound k (x.toRat.1 * ((2^j : Nat) : Int)) (x.toRat.2*2^j) s =
      (Fl.roundRat x.toRat.1 x.toRat.2 s : WideValue k) := by
  have hd : x.toRat.2 ≠ 0 := Nat.ne_of_gt (floatCheckFlRatDenPos _ x hx)
  cases k with
  | f16 => exact floatCheckFlRoundRatScale single _ _ j s hd
  | f32 =>
    change Fl.ofF64 (F64.roundRat (x.toRat.1 * ((2^j : Nat) : Int)) (x.toRat.2*2^j) s) = _
    by_cases hn : x.toRat.1 = 0
    · have h1 := wideRound_zero .f32 (x.toRat.2*2^j) s
        (Nat.mul_ne_zero hd (Nat.ne_of_gt (Nat.two_pow_pos j)))
      change Fl.ofF64 (F64.roundRat 0 (x.toRat.2*2^j) s) = (Fl.zero s : Fl double) at h1
      rw [hn, Int.zero_mul, h1]
      simp only [Fl.roundRat, beq_eq_false_iff_ne.mpr hd, beq_self_eq_true,
        Bool.false_eq_true, ↓reduceIte]
      rfl
    · have he := toRat_floor_lower good_double x hx hn
      have hscaled : Fl.floorLog2Rat (x.toRat.1 * ((2^j : Nat) : Int)).natAbs (x.toRat.2*2^j) =
          Fl.floorLog2Rat x.toRat.1.natAbs x.toRat.2 := by
        rw [Int.natAbs_mul, Int.natAbs_natCast,
          floatCheckFloorLogScale _ _ j (by omega) hd]
      have hlow : -1075 ≤ Fl.floorLog2Rat (x.toRat.1 * ((2^j : Nat) : Int)).natAbs (x.toRat.2*2^j) := by
        rw [hscaled]
        exact Int.le_trans (by decide : (-1075 : Int) ≤ 1-(double.bias : Int)-double.sb) he
      rw [← floatCheckFlToF64RoundRat _ _ _ hlow, floatCheckFlOfToF64,
        floatCheckFlRoundRatScale double _ _ j s hd]
      rfl

theorem wideOneFacts (k : SmallFloatKind) :
    (Fl.ofInt 1 : WideValue k).isfinite = true ∧
    (Fl.ofInt 1 : WideValue k).signbit = false ∧
    (Fl.ofInt 1 : WideValue k).toRat = (((2^(wideFormat k).sb : Nat) : Int), 2^(wideFormat k).sb) := by
  cases k <;> decide

theorem wideZeroRat (k : SmallFloatKind) (s : Bool) :
    (Fl.zero s : WideValue k).toRat = (0, 2^((wideFormat k).bias+(wideFormat k).sb-1)) := by
  cases k <;> cases s <;> decide

theorem wideMultiply_one (k : SmallFloatKind) (x : WideValue k) (hx : x.isfinite = true) :
    wideMultiply k x (Fl.ofInt 1) = x := by
  obtain ⟨hfin, hs, hr⟩ := wideOneFacts k
  rw [floatCheckWideMultiplyFinite k x _ hx hfin, hs, hr]
  simp only [Bool.bne_false, Prod.fst, Prod.snd]
  rw [wideRound_scaled_toRat k x hx, roundRat_toRat (good_wide k) x hx]

theorem wideMultiply_zero (k : SmallFloatKind) (x : WideValue k) (hx : x.isfinite = true) (s : Bool) :
    wideMultiply k x (Fl.zero s) = Fl.zero (x.signbit != s) := by
  have hz := floatCheckFlZeroBasics (wideFormat k) (by cases k <;> decide) s
  rw [floatCheckWideMultiplyFinite k x _ hx hz.1, hz.2.2, Int.mul_zero,
    (floatCheckFlZeroClass (wideFormat k) s).1, wideRound_zero]
  exact Nat.mul_ne_zero (Nat.ne_of_gt (floatCheckFlRatDenPos _ x hx))
    (Nat.ne_of_gt (floatCheckFlRatDenPos _ _ hz.1))

theorem wideMuladd_one_zero (k : SmallFloatKind) (x : WideValue k) (hx : x.isfinite = true) (s : Bool) :
    wideMuladd k x (Fl.ofInt 1) (Fl.zero s) =
      if x.iszero then Fl.zero (x.signbit && s) else x := by
  obtain ⟨hfin, hs, hr⟩ := wideOneFacts k
  have hz := floatCheckFlZeroBasics (wideFormat k) (by cases k <;> decide) s
  rw [floatCheckWideMuladdFinite k x _ _ hx hfin hz.1, hs, hr, wideZeroRat,
    (floatCheckFlZeroClass (wideFormat k) s).1]
  simp only [Prod.fst, Prod.snd, Bool.bne_false, Int.zero_mul, Int.add_zero]
  rw [Int.mul_assoc, ← Int.natCast_mul, ← Nat.pow_add, Nat.mul_assoc, ← Nat.pow_add,
    wideRound_scaled_toRat k x hx, roundRat_toRat_zeroSign (good_wide k) x hx]

theorem smallConvertRoundtrip (k : SmallFloatKind) (x : SmallValue k) (hx : x.isfinite = true) :
    (Fl.convert (Fl.convert x : WideValue k) : SmallValue k) = x := by
  cases k
  · exact convert_roundtrip good_half good_single (by decide) (by decide) (by decide) x hx
  · exact convert_roundtrip good_single good_double (by decide) (by decide) (by decide) x hx

theorem smallNarrowZero (k : SmallFloatKind) (s : Bool) :
    (Fl.convert (Fl.zero s : WideValue k) : SmallValue k) = Fl.zero s := by
  cases k <;> cases s <;> decide

theorem smallWidenConstants (k : SmallFloatKind) :
    (Fl.convert (Fl.ofInt 1 : SmallValue k) : WideValue k) = Fl.ofInt 1 ∧
    (Fl.convert (Fl.zero false : SmallValue k) : WideValue k) = Fl.zero false ∧
    (Fl.ofInt 1 : WideValue k).isinf = false ∧
    (Fl.zero false : WideValue k).isinf = false ∧
    wideInverse k (wideMuladd k (Fl.ofInt 1) (Fl.ofInt 1)
      (wideMultiply k (Fl.zero false) (Fl.zero false))) = Fl.ofInt 1 := by
  cases k <;> decide

theorem conditionalZeroFinite (k : SmallFloatKind) (x : WideValue k) (hx : x.isfinite = true) (s : Bool) :
    (if x.iszero then (Fl.zero s : WideValue k) else x).isfinite = true := by
  split
  · exact (floatCheckFlZeroBasics (wideFormat k) (by cases k <;> decide) s).1
  · exact hx

theorem narrowConditionalZero (k : SmallFloatKind) (x : SmallValue k) (hx : x.isfinite = true) (s : Bool) :
    Fl.eq (Fl.convert (if (Fl.convert x : WideValue k).iszero then Fl.zero s else
      (Fl.convert x : WideValue k)) : SmallValue k) x = true := by
  by_cases hz : (Fl.convert x : WideValue k).iszero = true
  · rw [if_pos hz, smallNarrowZero]
    have hzx := (floatCheckWidenBounds k x hx).2.mp hz
    have hxn := (floatCheckFlFiniteClasses (smallFormat k) x hx).1
    have hzn := (floatCheckFlZeroClass (smallFormat k) s).2
    have hzz := (floatCheckFlZeroBasics (smallFormat k) (by cases k <;> decide) s).2.1
    simp only [Fl.eq, hxn, hzn, hzx, hzz, Bool.not_false, Bool.true_and,
      Bool.or_true]
  · rw [if_neg hz, smallConvertRoundtrip k x hx]
    have hxn := (floatCheckFlFiniteClasses (smallFormat k) x hx).1
    simp only [Fl.eq, hxn, Bool.not_false, Bool.true_and, beq_self_eq_true, Bool.true_or]

theorem division_one (k : SmallFloatKind) (z : Complex (SmallValue k))
    (hr : z.re.isfinite = true) (hi : z.im.isfinite = true) :
    let r := divideSmall k z ⟨Fl.ofInt 1, Fl.zero false⟩
    Fl.eq r.re z.re = true ∧ Fl.eq r.im z.im = true := by
  have ha := (floatCheckWidenBounds k z.re hr).1.1
  have hb := (floatCheckWidenBounds k z.im hi).1.1
  obtain ⟨hc, hd, hci, hdi, hmag⟩ := smallWidenConstants k
  simp only [divideSmall, widenSmallComplex, reimComplex, reim, real_Complex, imag_Complex,
    hc, hd, hci, hdi, Bool.false_or, Bool.false_eq_true, ↓reduceIte, hmag]
  rw [wideMultiply_zero k _ hb false,
    wideMultiply_zero k _ (by rw [floatCheckFlNegFinite]; exact ha) false,
    wideMuladd_one_zero k _ ha, wideMuladd_one_zero k _ hb,
    wideMultiply_one k _ (conditionalZeroFinite k _ ha _),
    wideMultiply_one k _ (conditionalZeroFinite k _ hb _)]
  change Fl.eq (Fl.convert (if (Fl.convert z.re : WideValue k).iszero then Fl.zero _ else
    (Fl.convert z.re : WideValue k)) : SmallValue k) z.re = true ∧
    Fl.eq (Fl.convert (if (Fl.convert z.im : WideValue k).iszero then Fl.zero _ else
    (Fl.convert z.im : WideValue k)) : SmallValue k) z.im = true
  exact ⟨narrowConditionalZero k z.re hr _, narrowConditionalZero k z.im hi _⟩

end JuliaLean.ChatGPT.Batch10.Group1.SmallExact

