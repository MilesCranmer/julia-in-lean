theorem mul_fin (x y : F64) (h1 : F64.isnan x = false) (h2 : F64.isnan y = false)
    (h3 : F64.isinf x = false) (h4 : F64.isinf y = false) :
    F64.mul x y = F64.roundRat ((F64.toRat x).1 * (F64.toRat y).1) ((F64.toRat x).2 * (F64.toRat y).2)
