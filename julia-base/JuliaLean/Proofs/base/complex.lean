theorem rq_scale (a b c : Nat) (hc : 0 < c) :
    f64Rq (a*c) (b*c) = f64Rq a b := floatCheckRoundQuotientScale a b c hc

theorem round_scale (n : Int) (d k : Nat) (s : Bool) (hd : d ≠ 0) :
    F64.roundRat (n * ((2^k : Nat) : Int)) (d*2^k) s = F64.roundRat n d s := by
  have hp : 0 < 2^k := Nat.two_pow_pos k
  have hpi : (0 : Int) < ((2^k : Nat) : Int) := by omega
  have hdp : d*2^k ≠ 0 := Nat.mul_ne_zero hd (by omega)
  by_cases hn : n = 0
  · simp only [hn, Int.zero_mul, f64_roundRat_eq, beq_eq_false_iff_ne.mpr hd,
      beq_eq_false_iff_ne.mpr hdp, beq_self_eq_true, Bool.false_eq_true, ↓reduceIte]
  · have hnp : n*((2^k : Nat) : Int) ≠ 0 := Int.mul_ne_zero hn (by omega)
    have ha : n.natAbs ≠ 0 := by omega
    have hneg : n*((2^k : Nat) : Int) < 0 ↔ n < 0 := by
      have h := Int.mul_lt_mul_right (b := n) (c := 0) hpi
      simpa only [Int.zero_mul] using h
    have hfloor : f64Fl2 (n.natAbs * 2^k) (d*2^k) = f64Fl2 n.natAbs d :=
      floatCheckFloorLogScale n.natAbs d k ha hd
    simp only [f64_roundRat_eq, beq_eq_false_iff_ne.mpr hd, beq_eq_false_iff_ne.mpr hdp,
      beq_eq_false_iff_ne.mpr hn, beq_eq_false_iff_ne.mpr hnp, Bool.false_eq_true, ↓reduceIte,
      Int.natAbs_mul, Int.natAbs_natCast, hneg, hfloor]
    by_cases ho : f64Fl2 n.natAbs d ≥ 1024
    · simp only [ho, ↓reduceIte]
    · simp only [ho, ↓reduceIte]
      by_cases hu : f64Fl2 n.natAbs d < -1075
      · simp only [hu, ↓reduceIte]
      · simp only [hu, ↓reduceIte]
        generalize max (f64Fl2 n.natAbs d - 52) (-1074) = p
        by_cases hge : p ≥ 0
        · simp only [hge, ↓reduceIte]
          rw [Nat.mul_right_comm d (2^k), rq_scale _ _ _ hp]
        · simp only [hge, ↓reduceIte]
          rw [Nat.mul_right_comm n.natAbs (2^k), rq_scale _ _ _ hp]

theorem div_one (x : F64) (hx : F64.isfinite x = true) : F64.div x F64.one = x := by
  have hxn := Scale.finite_not_nan x hx
  have hxi := Scale.finite_not_inf x hx
  have h1n : F64.isnan F64.one = false := rfl
  have h1i : F64.isinf F64.one = false := rfl
  have h1z : F64.iszero F64.one = false := rfl
  simp only [F64.div, hxn, hxi, h1n, h1i, h1z, Bool.false_eq_true,
    Bool.false_and, Bool.and_false, Bool.false_or, ite_false]
  change F64.roundRat ((F64.toRat x).1 * ((2^52 : Nat) : Int))
    ((F64.toRat x).2 * 2^52) (F64.signbit x != false) = x
  have hs : (F64.signbit x != false) = F64.signbit x := by cases F64.signbit x <;> rfl
  rw [hs, round_scale _ _ _ _ (Nat.ne_of_gt (toRat_den_pos x hx)), roundRat_toRat x hx]

def correction (ax ay h : F64) : F64 :=
  let hsquared := F64.mul h h
  let axsquared := F64.mul ax ax
  let corr := F64.sub
    (F64.add (F64.fma (F64.neg ay) ay (F64.sub hsquared axsquared))
      (F64.fma h h (F64.neg hsquared)))
    (F64.fma ax ax (F64.neg axsquared))
  F64.sub h (F64.div corr (F64.mul Fl64.two h))

def fastRoot : F64 := F64.ofBits 0x3e46a09e667f3bcd

theorem fastRoot_source : F64.sqrt (F64.div Fl64.eps Fl64.two) = .ok fastRoot := by
  decide

theorem abs_id (x : F64) (hs : F64.signbit x = false) : F64.abs x = x := by
  apply f64_ext
  rw [tb_abs]
  exact Nat.mod_eq_of_lt ((signbit_f x).mp hs)

def tail (ax ay scale : F64) : Jl F64 := do
  let h ← F64.sqrt (F64.muladd ax ax (F64.mul ay ay))
  return F64.mul (F64.mul (correction ax ay h) scale) F64.one

def scaled (ax ay : F64) : Jl F64 := do
  let sfm ← F64.sqrt F64.floatmin
  let shm ← F64.sqrt (F64.div F64.floatmax Fl64.two)
  let scale := F64.mul Fl64.eps sfm
  let (ax, ay, scale) :=
    if F64.lt shm ax then (F64.mul ax scale, F64.mul ay scale, F64.div F64.one scale)
    else if F64.lt ay sfm then (F64.div ax scale, F64.div ay scale, scale)
    else (ax, ay, F64.one)
  tail ax ay scale

def ordered (axu ax ay : F64) : Jl F64 := do
  let r ← F64.sqrt (F64.div Fl64.eps Fl64.two)
  if F64.le ay (F64.mul ax r) then return axu
  scaled ax ay

def prepared (axu ayu ax ay : F64) : Jl F64 := do
  if F64.isinf ax || F64.isinf ay then return Fl64.inf
  let (axu, ax, ay) := if F64.lt ax ay then (ayu, ay, ax) else (axu, ax, ay)
  ordered axu ax ay

theorem hypot_form (x y : F64) : Fl64.hypot x y =
    prepared (F64.abs x) (F64.abs y) (F64.div (F64.abs x) F64.one)
      (F64.div (F64.abs y) F64.one) := rfl

theorem hypot_fast_left (x y : F64) (hx : F64.isfinite x = true) (hy : F64.isfinite y = true)
    (horder : F64.lt (F64.abs x) (F64.abs y) = false)
    (hsmall : F64.le (F64.abs y) (F64.mul (F64.abs x) fastRoot) = true) :
    Fl64.hypot x y = .ok (F64.abs x) := by
  have hax := Scale.abs_finite x hx
  have hay := Scale.abs_finite y hy
  rw [hypot_form, div_one _ hax, div_one _ hay]
  simp only [prepared, Scale.finite_not_inf _ hax, Scale.finite_not_inf _ hay,
    Bool.false_or, Bool.false_eq_true, horder, ite_false, ordered, fastRoot_source,
    Bind.bind, Pure.pure, Except.bind, Except.pure, hsmall, ite_true]

theorem hypot_fast_right (x y : F64) (hx : F64.isfinite x = true) (hy : F64.isfinite y = true)
    (horder : F64.lt (F64.abs x) (F64.abs y) = true)
    (hsmall : F64.le (F64.abs x) (F64.mul (F64.abs y) fastRoot) = true) :
    Fl64.hypot x y = .ok (F64.abs y) := by
  have hax := Scale.abs_finite x hx
  have hay := Scale.abs_finite y hy
  rw [hypot_form, div_one _ hax, div_one _ hay]
  simp only [prepared, Scale.finite_not_inf _ hax, Scale.finite_not_inf _ hay,
    Bool.false_or, Bool.false_eq_true, horder, ite_false, ite_true, ordered, fastRoot_source,
    Bind.bind, Pure.pure, Except.bind, Except.pure, hsmall, ite_true]

end JuliaLean.ChatGPT.Batch10.Group1.Epsilon

-- EpsilonExactOpsPart
namespace JuliaLean.ChatGPT.Batch10.Group1.EpsilonExact

open JuliaLean JuliaLean.Float JuliaLean.Promotion JuliaLean.base.complex
open JuliaLean.Proofs.base.complex
open Scalar.ProofsBits

set_option maxRecDepth 10000
set_option maxHeartbeats 1000000
set_option exponentiation.threshold 10000
set_option linter.unusedSimpArgs false

def power (p : Int) : F64 :=
  if p < -1022 then F64.ofBits (2^(p+1074).toNat)
  else F64.ofBits ((p+1023).toNat*2^52)

theorem power_bits (p : Int) (hlo : -1074 ≤ p) (hhi : p ≤ 1023) :
    F64.toBits (power p) = (if p < -1022 then 2^(p+1074).toNat else (p+1023).toNat*2^52) ∧
    0 < F64.toBits (power p) ∧ F64.toBits (power p) < 2047*2^52 := by
  unfold power
  by_cases h : p < -1022
  · have hp : (p+1074).toNat < 52 := by omega
    have hu : 2^(p+1074).toNat < 2^52 := Nat.pow_lt_pow_right (by decide) hp
    have hpos := Nat.two_pow_pos (p+1074).toNat
    simp only [h, ↓reduceIte, tb_ofBits, Nat.mod_eq_of_lt (show 2^(p+1074).toNat < 2^64 by omega)]
    exact ⟨True.intro, hpos, by omega⟩
  · have hp : 1 ≤ (p+1023).toNat ∧ (p+1023).toNat ≤ 2046 := by omega
    simp only [h, ↓reduceIte, tb_ofBits,
      Nat.mod_eq_of_lt (show (p+1023).toNat*2^52 < 2^64 by omega)]
    exact ⟨True.intro, by omega, by omega⟩

theorem power_fields (p : Int) (hlo : -1074 ≤ p) (hhi : p ≤ 1023) :
    F64.exponentField (power p) = (if p < -1022 then 0 else (p+1023).toNat) ∧
    F64.fraction (power p) = (if p < -1022 then 2^(p+1074).toNat else 0) := by
  have hb := (power_bits p hlo hhi).1
  unfold F64.exponentField F64.fraction
  rw [hb]
  by_cases h : p < -1022
  · have hp : (p+1074).toNat < 52 := by omega
    have hu : 2^(p+1074).toNat < 2^52 := Nat.pow_lt_pow_right (by decide) hp
    simp only [h, ↓reduceIte, Nat.div_eq_of_lt hu, Nat.zero_mod, Nat.mod_eq_of_lt hu]
    exact ⟨True.intro, True.intro⟩
  · have hp : (p+1023).toNat < 2048 := by omega
    simp only [h, ↓reduceIte, Nat.mul_div_cancel _ (Nat.two_pow_pos _),
      Nat.mod_eq_of_lt hp, Nat.mul_mod_left]
    exact ⟨True.intro, True.intro⟩

theorem power_classes (p : Int) (hlo : -1074 ≤ p) (hhi : p ≤ 1023) :
    F64.isfinite (power p) = true ∧ F64.signbit (power p) = false ∧
    F64.iszero (power p) = false ∧ F64.isnan (power p) = false ∧ F64.isinf (power p) = false := by
  have hb := (power_bits p hlo hhi).2
  have he := (power_fields p hlo hhi).1
  have hs : F64.signbit (power p) = false := (signbit_f _).mpr (by omega)
  have hz : F64.iszero (power p) = false := (iszero_f _).mpr (by rw [Nat.mod_eq_of_lt (by omega)]; omega)
  have hf : F64.isfinite (power p) = true := by
    rw [F64.isfinite, he, bne_iff_ne]
    split <;> omega
  obtain ⟨hn, hi⟩ := floatCheckF64FiniteClasses _ hf
  exact ⟨hf, hs, hz, hn, hi⟩

theorem power_abs (p : Int) (hlo : -1074 ≤ p) (hhi : p ≤ 1023) : F64.abs (power p) = power p := by
  apply f64_ext
  rw [tb_abs, Nat.mod_eq_of_lt ((signbit_f _).mp (power_classes p hlo hhi).2.1)]

theorem power_rat (p : Int) (hlo : -1074 ≤ p) (hhi : p ≤ 1023) :
    ∃ i j : Nat, F64.toRat (power p) = (((2^i : Nat) : Int), 2^j) ∧ (i : Int)-j = p := by
  obtain ⟨hf, hs, _⟩ := power_classes p hlo hhi
  obtain ⟨he, hm⟩ := power_fields p hlo hhi
  unfold F64.toRat
  simp only [hf, Bool.not_true, Bool.false_eq_true, ↓reduceIte, he, hm, hs]
  by_cases h : p < -1022
  · simp only [h, ↓reduceIte, beq_self_eq_true, Nat.add_zero,
      show ¬ ((-1074 : Int) ≥ 0) by omega]
    refine ⟨(p+1074).toNat, 1074, rfl, by omega⟩
  · simp only [h, ↓reduceIte, beq_eq_false_iff_ne.mpr (show (p+1023).toNat ≠ 0 by omega), Nat.zero_add, Bool.false_eq_true]

    by_cases hbig : p ≥ 52
    · have hp : ((p+1023).toNat : Int)-1075 ≥ 0 := by omega
      simp only [hp, ↓reduceIte]
      refine ⟨52+(((p+1023).toNat : Int)-1075).toNat, 0, ?_, by omega⟩
      rw [Nat.pow_add, Int.natCast_mul]
    · have hp : ¬ (((p+1023).toNat : Int)-1075 ≥ 0) := by omega
      simp only [hp, ↓reduceIte]
      exact ⟨52, (-(((p+1023).toNat : Int)-1075)).toNat, rfl, by omega⟩

theorem round_power (i j : Nat) (p : Int) (he : (i : Int)-j = p)
    (hlo : -1074 ≤ p) (hhi : p ≤ 1023) (s : Bool) :
    F64.roundRat ((2^i : Nat) : Int) (2^j) s = power p := by
  have hfloor : Fl.floorLog2Rat (((2^i : Nat) : Int)).natAbs (2^j) = p := by
    rw [Int.natAbs_natCast, SmallExact.floorLog2Rat_pow _ _ (Nat.ne_of_gt (Nat.two_pow_pos _)),
      Nat.log2_two_pow, he]
  rw [← floatCheckFlToF64RoundRat _ _ _ (by rw [hfloor]; omega)]
  unfold power
  by_cases hsub : p < -1022
  · rw [ite_eq_left hsub]
    have heq : ((2^i : Nat) : Int) * ((2^1074 : Nat) : Int) =
        ((2^(p+1074).toNat : Nat) : Int) * ((2^j : Nat) : Int) := by
      rw [← Int.natCast_mul, ← Int.natCast_mul, ← Nat.pow_add, ← Nat.pow_add]
      congr 2
      omega
    rw [floatCheckFlRoundRatDyadicEq double _ _ j 1074 s heq]
    have hr := SmallExact.roundRat_subnormal_signed SmallExact.good_double false
      (2^(p+1074).toNat) 0 1074 s (Nat.two_pow_pos _)
      (by change 2^(p+1074).toNat < 2^52; exact Nat.pow_lt_pow_right (by decide) (by omega)) (by decide)
    simp only [SmallExact.signed, Bool.false_eq_true, ↓reduceIte, Nat.pow_zero, Nat.mul_one] at hr
    rw [hr]
    change Fl.toF64 (Fl.ofBits (0+(0*2^52+2^(p+1074).toNat)) : Fl double) = _
    rw [floatCheckFlToF64OfBits]
    simp only [Nat.zero_mul, Nat.zero_add]
  · rw [ite_eq_right hsub]
    have hr := SmallExact.roundRat_normal_signed SmallExact.good_double false 1 i j s
      (by decide) (by decide) (by change j+1 ≤ 0+i+1023; omega)
      (by change 0+i+1023 < j+2047; omega)
    simp only [SmallExact.signed, Bool.false_eq_true, ↓reduceIte, Nat.one_mul, show Nat.log2 1 = 0 from rfl,
      Nat.zero_add] at hr
    rw [hr]
    change Fl.toF64 (Fl.ofBits (0+((i+1023-j)*2^52+(2^(52-0)-2^52))) : Fl double) = _
    rw [floatCheckFlToF64OfBits]
    simp only [Nat.sub_zero, Nat.sub_self, Nat.add_zero, Nat.zero_add]
    have hE : i+1023-j = (p+1023).toNat := by omega
    rw [hE]

theorem power_mul (p q : Int) (hp0 : -1074 ≤ p) (hp1 : p ≤ 1023)
    (hq0 : -1074 ≤ q) (hq1 : q ≤ 1023) (hr0 : -1074 ≤ p+q) (hr1 : p+q ≤ 1023) :
    F64.mul (power p) (power q) = power (p+q) := by
  obtain ⟨hf, hs, hz, hn, hi⟩ := power_classes p hp0 hp1
  obtain ⟨gf, gs, gz, gn, gi⟩ := power_classes q hq0 hq1
  obtain ⟨i, j, hrat, hp⟩ := power_rat p hp0 hp1
  obtain ⟨a, b, grat, hq⟩ := power_rat q hq0 hq1
  rw [mul_fin _ _ hn gn hi gi, hs, gs, hrat, grat]
  simp only [Prod.fst, Prod.snd, bne_self_eq_false]
  rw [← Int.natCast_mul, ← Nat.pow_add, ← Nat.pow_add]
  exact round_power (i+a) (j+b) (p+q) (by omega) hr0 hr1 false

theorem power_div (p q : Int) (hp0 : -1074 ≤ p) (hp1 : p ≤ 1023)
    (hq0 : -1074 ≤ q) (hq1 : q ≤ 1023) (hr0 : -1074 ≤ p-q) (hr1 : p-q ≤ 1023) :
    F64.div (power p) (power q) = power (p-q) := by
  obtain ⟨hf, hs, hz, hn, hi⟩ := power_classes p hp0 hp1
  obtain ⟨gf, gs, gz, gn, gi⟩ := power_classes q hq0 hq1
  obtain ⟨i, j, hrat, hp⟩ := power_rat p hp0 hp1
  obtain ⟨a, b, grat, hq⟩ := power_rat q hq0 hq1
  simp only [F64.div, hn, gn, hi, gi, hz, gz, Bool.false_eq_true, Bool.false_and,
    Bool.false_or, ↓reduceIte, hs, gs, bne_self_eq_false, hrat, grat, Prod.fst, Prod.snd]
  rw [Int.natAbs_natCast, ← Int.natCast_mul, ← Nat.pow_add, ← Nat.pow_add]
  exact round_power (i+b) (j+a) (p-q) (by omega) hr0 hr1 false

theorem floorLog_dyadic_eq (n m i j : Nat) (hn : n ≠ 0) (hm : m ≠ 0)
    (he : n*2^j = m*2^i) :
    Fl.floorLog2Rat n (2^i) = Fl.floorLog2Rat m (2^j) := by
  rw [← floatCheckFloorLogScale n (2^i) j hn (Nat.ne_of_gt (Nat.two_pow_pos _)), he,
    Nat.mul_comm (2^i) (2^j),
    floatCheckFloorLogScale m (2^j) i hm (Nat.ne_of_gt (Nat.two_pow_pos _))]

theorem round_positive_cross_normal (n j c i l : Nat) (s : Bool)
    (hc0 : 0 < c) (hc1 : c < 2^53)
    (hlo : l+1 ≤ c.log2+i+1023) (hhi : c.log2+i+1023 < l+2047)
    (he : n*2^l = c*2^i*2^j) :
    F64.roundRat (n : Int) (2^j) s =
      F64.ofBits ((c.log2+i+1023-l)*2^52+(c*2^(52-c.log2)-2^52)) := by
  have hcp : 0 < c*2^i := Nat.mul_pos hc0 (Nat.two_pow_pos _)
  have hn : n ≠ 0 := by
    intro hz
    rw [hz, Nat.zero_mul] at he
    have hp := Nat.mul_pos hcp (Nat.two_pow_pos j)
    omega
  have hfloor : Fl.floorLog2Rat (n : Int).natAbs (2^j) = ((c.log2+i : Nat) : Int)-l := by
    rw [Int.natAbs_natCast, floorLog_dyadic_eq n (c*2^i) j l hn (by omega) he,
      SmallExact.floorLog2Rat_pow _ _ (by omega), SmallExact.log2_mul_pow c i (by omega)]
  rw [← floatCheckFlToF64RoundRat _ _ _ (by rw [hfloor]; omega)]
  have he' : (n : Int)*((2^l : Nat) : Int) = ((c*2^i : Nat) : Int)*((2^j : Nat) : Int) := by
    rw [← Int.natCast_mul, ← Int.natCast_mul, he]
  rw [floatCheckFlRoundRatDyadicEq double _ _ j l s he']
  have hr := SmallExact.roundRat_normal_signed SmallExact.good_double false c i l s
    (by omega) hc1 hlo hhi
  simp only [SmallExact.signed, Bool.false_eq_true, ↓reduceIte] at hr
  rw [hr]
  change Fl.toF64 (Fl.ofBits (0+((c.log2+i+1023-l)*2^52+(c*2^(52-c.log2)-2^52))) : Fl double) = _
  rw [floatCheckFlToF64OfBits, Nat.zero_add]

theorem sum_significand (d : Nat) (hd : d ≤ 26) :
    (2^(2*d)+1).log2 = (if d = 0 then 1 else 2*d) ∧
    0 < 2^(2*d)+1 ∧ 2^(2*d)+1 < 2^53 := by
  by_cases hz : d = 0
  · subst d
    decide
  · have he : 1 ≤ 2*d := by omega
    have hpow := Nat.pow_le_pow_right (n := 2) (by decide) he
    have hbig : 2^(2*d)+1 < 2^(2*d+1) := by rw [Nat.pow_succ]; omega
    have hlog := (Nat.log2_lt (by omega : 2^(2*d)+1 ≠ 0)).mpr hbig
    have hlog2 := (Nat.le_log2 (by omega : 2^(2*d)+1 ≠ 0)).mpr (show 2^(2*d) ≤ 2^(2*d)+1 by omega)
    have hu : 2^(2*d+1) ≤ 2^53 := Nat.pow_le_pow_right (by decide) (by omega)
    simp only [hz, ↓reduceIte]
    exact ⟨by omega, by omega, by omega⟩

theorem power_square_sum (p : Int) (d : Nat) (hp0 : -511 ≤ p) (hp1 : p ≤ 511) (hd : d ≤ 26) :
    F64.muladd (power p) (power p) (F64.mul (power (p-d)) (power (p-d))) =
      if d = 0 then F64.ofBits ((2*p+1024).toNat*2^52)
      else F64.ofBits ((2*p+1023).toNat*2^52+2^(52-2*d)) := by
  have hp0' : -1074 ≤ p := by omega
  have hp1' : p ≤ 1023 := by omega
  have hq0 : -1074 ≤ p-d := by omega
  have hq1 : p-d ≤ 1023 := by omega
  have hq20 : -1074 ≤ (p-d)+(p-d) := by omega
  have hq21 : (p-d)+(p-d) ≤ 1023 := by omega
  rw [power_mul (p-d) (p-d) hq0 hq1 hq0 hq1 hq20 hq21]
  obtain ⟨hf, hs, hz, hn, hi⟩ := power_classes p hp0' hp1'
  obtain ⟨gf, gs, gz, gn, gi⟩ := power_classes ((p-d)+(p-d)) hq20 hq21
  obtain ⟨a, b, hrx, hpx⟩ := power_rat p hp0' hp1'
  obtain ⟨c, e, hry, hqy⟩ := power_rat ((p-d)+(p-d)) hq20 hq21
  simp only [F64.muladd, F64.fma, hn, gn, hi, gi, hz, gz, hs, gs,
    Bool.false_eq_true, Bool.false_and, Bool.false_or, bne_self_eq_false, ↓reduceIte,
    hrx, hry, Prod.fst, Prod.snd]
  rw [← Int.natCast_mul, ← Int.natCast_mul, ← Int.natCast_mul, ← Int.natCast_add,
    show 2^b*2^b*2^e = 2^(b+b+e) by rw [Nat.pow_add, Nat.pow_add]]
  let L := (2*p-2*(d : Int)+2148).toNat
  have hL : (L : Int) = 2*p-2*(d : Int)+2148 := by dsimp only [L]; omega
  have heq : (2^a*2^a*2^e+2^c*(2^b*2^b))*2^2148 =
      (2^(2*d)+1)*2^L*2^(b+b+e) := by
    rw [Nat.add_mul, Nat.add_mul, Nat.one_mul, Nat.add_mul]
    congr 1
    · simp only [Nat.mul_assoc, ← Nat.pow_add]
      apply congrArg (fun v : Nat => 2^v)
      omega
    · simp only [Nat.mul_assoc, ← Nat.pow_add]
      apply congrArg (fun v : Nat => 2^v)
      omega
  obtain ⟨hlog, hpos, hbound⟩ := sum_significand d hd
  have hr := round_positive_cross_normal (2^a*2^a*2^e+2^c*(2^b*2^b)) (b+b+e)
    (2^(2*d)+1) L 2148 false hpos hbound (by rw [hlog]; split <;> omega)
    (by rw [hlog]; split <;> omega) heq
  rw [hr, hlog]
  by_cases hd0 : d = 0
  · subst d
    simp only [↓reduceIte]
    have hE : 1+L+1023-2148 = (2*p+1024).toNat := by omega
    have hm : (2^(2*0)+1)*2^(52-1)-2^52 = 0 := by decide
    rw [hE, hm, Nat.add_zero]
  · simp only [hd0, ↓reduceIte]
    have hE : 2*d+L+1023-2148 = (2*p+1023).toNat := by omega
    have hm : (2^(2*d)+1)*2^(52-2*d)-2^52 = 2^(52-2*d) := by
      rw [Nat.add_mul, Nat.one_mul, ← Nat.pow_add,
        show 2*d+(52-2*d) = 52 by omega]
      exact Nat.add_sub_cancel_left _ _
    rw [hE, hm]

end JuliaLean.ChatGPT.Batch10.Group1.EpsilonExact

-- EpsilonSqrtPart
namespace JuliaLean.ChatGPT.Batch10.Group1.EpsilonSqrt
open JuliaLean JuliaLean.Float JuliaLean.base.complex
open JuliaLean.Proofs.base.complex
open JuliaLean.ChatGPT.Batch10.Group1
open Scalar.ProofsBits
set_option maxRecDepth 10000
set_option maxHeartbeats 1000000
set_option exponentiation.threshold 10000

def search (n d : Nat) : Nat → Nat → Nat → Nat
  | 0, lo, _ => lo
  | fuel+1, lo, hi =>
    if hi ≤ lo+1 then lo
    else let mid := (lo+hi)/2
      if mid*mid*d ≤ n then search n d fuel mid hi
      else search n d fuel lo mid

def roundedRoot (n d : Nat) : Nat :=
  let q := search n d 54 0 (2^53+1)
  if 4*n > (2*q+1)*(2*q+1)*d ||
      (4*n == (2*q+1)*(2*q+1)*d && q%2 == 1) then q+1 else q

theorem mul_compare (a b d : Nat) (hd : 0 < d) : a*d ≤ b*d ↔ a ≤ b :=
  ⟨fun h => Nat.le_of_mul_le_mul_right h hd, fun h => Nat.mul_le_mul_right d h⟩

theorem search_scale (r d f lo hi : Nat) (hd : 0 < d) :
    search (r*d) d f lo hi = search r 1 f lo hi := by
  induction f generalizing lo hi with
  | zero => rfl
  | succ f ih =>
    simp only [search, Nat.mul_one]
    simp only [mul_compare _ _ _ hd]
    split
    · rfl
    · split <;> exact ih _ _

theorem roundedRoot_scale (r d : Nat) (hd : 0 < d) :
    roundedRoot (r*d) d = roundedRoot r 1 := by
  unfold roundedRoot
  rw [search_scale r d 54 0 (2^53+1) hd]
  let q := search r 1 54 0 (2^53+1)
  have heq : 4*(r*d) = (2*q+1)*(2*q+1)*d ↔ 4*r = (2*q+1)*(2*q+1) := by
    rw [← Nat.mul_assoc]
    exact ⟨fun h => Nat.eq_of_mul_eq_mul_right hd h, fun h => congrArg (·*d) h⟩
  have hlt : (2*q+1)*(2*q+1)*d < 4*(r*d) ↔ (2*q+1)*(2*q+1) < 4*r := by
    rw [← Nat.mul_assoc]
    exact ⟨Nat.lt_of_mul_lt_mul_right, fun h => Nat.mul_lt_mul_of_pos_right h hd⟩
  simp only [Nat.mul_one]
  change (if decide ((2*q+1)*(2*q+1)*d < 4*(r*d)) ||
      (decide (4*(r*d) = (2*q+1)*(2*q+1)*d) && q%2 == 1) then q+1 else q) = _
  simp only [hlt, heq, beq_iff_eq]
  rfl

theorem sqrt_formula (x : F64) (hlt : F64.lt x (F64.zero false) = false)
    (hn : F64.isnan x = false) (hi : F64.isinf x = false) (hz : F64.iszero x = false) :
    F64.sqrt x = .ok (let a := F64.toRat x
      let k := fl2 a.1.natAbs a.2 / 2 - 52
      let scaled := if 2*k ≥ 0 then (a.1.natAbs,a.2*2^(2*k).toNat)
        else (a.1.natAbs*2^(-(2*k)).toNat,a.2)
      pk false (roundedRoot scaled.1 scaled.2) k) := by
  unfold F64.sqrt
  rw [hlt, hn, hi, hz]
  simp only [Bool.false_or, Bool.false_eq_true, ↓reduceIte]
  unfold roundedRoot
  let k := fl2 (F64.toRat x).1.natAbs (F64.toRat x).2 / 2 - 52
  let sc := if 2*k ≥ 0 then ((F64.toRat x).1.natAbs,(F64.toRat x).2*2^(2*k).toNat)
    else ((F64.toRat x).1.natAbs*2^(-(2*k)).toNat,(F64.toRat x).2)
  generalize (54 : Nat) = fuel
  apply congrArg (fun q : Nat => (Except.ok (pk false
    (if 4*sc.1 > (2*q+1)*(2*q+1)*sc.2 ||
      (4*sc.1 == (2*q+1)*(2*q+1)*sc.2 && q%2 == 1) then q+1 else q) k) : Jl F64))
  generalize (0 : Nat) = lo
  generalize (2^53+1 : Nat) = hi
  induction fuel generalizing lo hi with
  | zero => rfl
  | succ fuel ih =>
    change (if hi ≤ lo+1 then lo else
      if ((lo+hi)/2)*((lo+hi)/2)*sc.2 ≤ sc.1 then _ else _) = search sc.1 sc.2 (fuel+1) lo hi
    rw [search]
    dsimp only []
    by_cases hstop : hi ≤ lo+1
    · simp only [hstop, ↓reduceIte]
    · simp only [hstop, ↓reduceIte]
      by_cases hmid : ((lo+hi)/2)*((lo+hi)/2)*sc.2 ≤ sc.1
      · simp only [hmid, ↓reduceIte]
        exact ih _ _
      · simp only [hmid, ↓reduceIte]
        exact ih _ _

theorem sqrt_dyadic (x : F64) (m a b : Nat) (p : Int) (δ : Nat)
    (hm : 2^52 ≤ m) (hmhi : m < 2^53) (hδ : δ ≤ 1)
    (hs : (a : Int)-(b : Int) = 2*p+(δ : Int)-52)
    (hlt : F64.lt x (F64.zero false) = false)
    (hn : F64.isnan x = false) (hi : F64.isinf x = false) (hz : F64.iszero x = false)
    (hr : F64.toRat x = (((m*2^a : Nat) : Int),2^b)) :
    F64.sqrt x = .ok (pk false (roundedRoot (m*2^(52+δ)) 1) (p-52)) := by
  have hm0 : 0 < m := by omega
  have hlog : m.log2 = 52 := by
    have hlow := Nat.log2_self_le (by omega : m ≠ 0)
    have hhigh := Nat.lt_log2_self (n := m)
    have hltlog := (Nat.log2_lt (by omega : m ≠ 0)).mpr hmhi
    have hgelog : ¬ m.log2 < 52 := by
      intro h
      exact (Nat.not_lt_of_ge hm) ((Nat.log2_lt (by omega : m ≠ 0)).mp h)
    omega
  rw [sqrt_formula x hlt hn hi hz, hr]
  simp only [Int.natAbs_natCast]
  rw [fl2_pow m a b hm0, hlog]
  have hk : (((52+a : Nat) : Int)-(b : Int))/2-52 = p-52 := by omega
  rw [hk]
  by_cases he : 2*(p-52) ≥ 0
  · rw [ite_t he]
    have hpow : a = (52+δ)+ (b+(2*(p-52)).toNat) := by omega
    have hc : m*2^a = (m*2^(52+δ))*(2^b*2^(2*(p-52)).toNat) := by
      rw [hpow]
      simp only [Nat.pow_add, Nat.mul_assoc]
    rw [hc, roundedRoot_scale _ _ (Nat.mul_pos (Nat.two_pow_pos _) (Nat.two_pow_pos _))]
  · rw [ite_f he]
    have hpow : a+(-(2*(p-52))).toNat = (52+δ)+b := by omega
    have hc : m*2^a*2^(-(2*(p-52))).toNat = (m*2^(52+δ))*2^b := by
      rw [Nat.mul_assoc, ← Nat.pow_add, hpow, Nat.pow_add, ← Nat.mul_assoc]
    rw [hc, roundedRoot_scale _ _ (Nat.two_pow_pos _)]

theorem sqrt_normal (p : Int) (δ m : Nat) (hplo : -511 ≤ p) (hphi : p ≤ 511)
    (hδ : δ ≤ 1) (hm : 2^52 ≤ m) (hmhi : m < 2^53) :
    F64.sqrt (F64.ofBits ((2*p+1023+(δ : Int)).toNat*2^52+(m-2^52))) =
      .ok (pk false (roundedRoot (m*2^(52+δ)) 1) (p-52)) := by
  let e := (2*p+1023+(δ : Int)).toNat
  let x := F64.ofBits (e*2^52+(m-2^52))
  have he1 : 1 ≤ e := by dsimp only [e]; omega
  have he2 : e ≤ 2046 := by dsimp only [e]; omega
  have heI : (e : Int) = 2*p+1023+(δ : Int) := by dsimp only [e]; omega
  have hb : F64.toBits x = e*2^52+(m-2^52) := by
    change F64.toBits (F64.ofBits _) = _
    rw [tb_ofBits, Nat.mod_eq_of_lt (by omega)]
  have hE : F64.toBits x / 2^52 % 2048 = e := by rw [hb]; omega
  have hM : F64.toBits x % 2^52+2^52 = m := by rw [hb]; omega
  have hs : F64.signbit x = false := by rw [signbit_f, hb]; omega
  have hf : F64.isfinite x = true := by
    simp only [F64.isfinite, F64.exponentField, hE, bne_iff_ne]; omega
  have hn := Scalar.ProofMisc.finite_not_nan x hf
  have hi := Scalar.ProofMisc.finite_not_inf x hf
  have hz : F64.iszero x = false := by rw [iszero_f, hb]; omega
  have hlt : F64.lt x (F64.zero false) = false := by
    unfold F64.lt
    simp only [hn, hz, hs, show F64.isnan (F64.zero false) = false from rfl,
      show F64.signbit (F64.zero false) = false from rfl,
      Bool.false_or, Bool.false_and, bne_self_eq_false, Bool.false_eq_true, ↓reduceIte]
    change decide (F64.toBits x < 0) = false
    exact decide_eq_false (Nat.not_lt_zero _)
  change F64.sqrt x = _
  by_cases hsmall : e ≤ 1074
  · have hr : F64.toRat x = (((m*2^0 : Nat) : Int),2^(1075-e)) := by
      rw [toRat_norm x (by rw [hE]; exact he1) (by rw [hE]; exact hsmall), hM, hE, hs]
      simp only [Bool.false_eq_true, ↓reduceIte, Nat.pow_zero, Nat.mul_one]
    exact sqrt_dyadic x m 0 (1075-e) p δ hm hmhi hδ (by omega) hlt hn hi hz hr
  · have hr : F64.toRat x = (((m*2^(e-1075) : Nat) : Int),2^0) := by
      rw [toRat_big x (by rw [hE]; omega) (by rw [hE]; omega), hM, hE, hs]
      simp only [Bool.false_eq_true, ↓reduceIte, Int.natCast_mul, Nat.pow_zero]
    exact sqrt_dyadic x m (e-1075) 0 p δ hm hmhi hδ (by omega) hlt hn hi hz hr

def coefficient (d : Nat) : Nat :=
  roundedRoot (if d=0 then 2^105 else 2^104+2^(104-2*d)) 1

def sumBits (p : Int) (d : Nat) : F64 :=
  if d=0 then F64.ofBits ((2*p+1024).toNat*2^52)
  else F64.ofBits ((2*p+1023).toNat*2^52+2^(52-2*d))

theorem sqrt_sum_pack (p : Int) (d : Nat) (hplo : -511 ≤ p) (hphi : p ≤ 511)
    (hd : d ≤ 26) :
    F64.sqrt (sumBits p d) = .ok (pk false (coefficient d) (p-52)) := by
  by_cases hz : d=0
  · rw [sumBits, ite_t hz]
    have h := sqrt_normal p 1 (2^52) hplo hphi (by decide) (by decide) (by decide)
    have hbits : (2*p+1023+(1 : Int)) = 2*p+1024 := by omega
    have hm : (2^52 : Nat)*2^(52+1) = 2^105 := by decide
    rw [coefficient, ite_t hz]
    simp only [Int.natCast_one] at h
    rw [hbits, hm, Nat.sub_self, Nat.add_zero] at h
    exact h
  · rw [sumBits, ite_f hz]
    have hp : (2 : Nat)^(52-2*d) < 2^52 := by
      apply Nat.pow_lt_pow_right (by decide)
      omega
    have hpos := Nat.zero_le ((2 : Nat)^(52-2*d))
    have h := sqrt_normal p 0 (2^52+2^(52-2*d)) hplo hphi (by decide) (by omega) (by omega)
    have he : (2*p+1023+(0 : Int)) = 2*p+1023 := by omega
    have hepow : (52-2*d)+(52+0) = 104-2*d := by omega
    have hm : ((2 : Nat)^52+2^(52-2*d))*2^(52+0) = 2^104+2^(104-2*d) := by
      rw [Nat.add_mul, ← Nat.pow_add, ← Nat.pow_add, hepow]
    have hs : (2 : Nat)^52+2^(52-2*d)-2^52 = 2^(52-2*d) := by omega
    rw [coefficient, ite_f hz]
    simp only [Int.natCast_zero] at h
    rw [he, hm, hs] at h
    exact h

end JuliaLean.ChatGPT.Batch10.Group1.EpsilonSqrt

