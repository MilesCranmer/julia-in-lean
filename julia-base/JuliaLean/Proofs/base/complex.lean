def rootPromotedParameterInfo {Tag Rejected : Type} : TypeParameter Tag Rejected → String
  | .admissible _ => "accepted"
  | .rejected _ => "rejected"

def rootObservedPromotedPower {E State V Tag Rejected : Type}
    (ops : PromotedPowerOps (RootM E State) V Tag Rejected) :
    PromotedPowerOps (RootM E (RootWorld E State)) V Tag Rejected where
  promote := fun t s => rootObserveInfo "promote" rootPromotedParameterInfo (ops.promote t s)
  scalarConstruct := fun parameter value => rootObserveInfo "scalar"
    (fun _ => rootPromotedParameterInfo parameter) (ops.scalarConstruct parameter value)
  complexConstruct := fun target value => rootObserve "complex" (ops.complexConstruct target value)
  powerTarget := ops.powerTarget
  powerOther := fun base exponent => rootObserve "power" (ops.powerOther base exponent)

end JuliaLean.Proofs.base.complex.Models2Group9


namespace JuliaLean.Proofs.base.complex.Models2Group9

open JuliaLean JuliaLean.base.complex JuliaLean.Float
open JuliaLean.base.complex.Models2Group9

/-- Arbitrary state and exceptions, with divergence represented by none. -/
abbrev SsqsM (E State A : Type) := ExceptT (Error E) (StateT State Option) A

/-- Actual argument identities at observed calls, including fixed native
literals and the static Val{2} tag. -/
inductive SsqsArgument (Tag V Other ExponentOther : Type) where
  | value (value : V)
  | typeTag (tag : Tag)
  | int64 (value : JInt .i64)
  | float64 (value : F64)
  | predicateOther (value : Other)
  | exponentOther (value : ExponentOther)
  | literal (tag : SsqsLiteralExponent)

/-- The actual outcome of each selected callee, before any caller assertion. -/
inductive SsqsObservedResult (V Other NotT ExponentOther NotInt : Type) where
  | value (value : V)
  | predicate (value : PredicateValue Other)
  | maximum (value : SsqsMaximum V)
  | checkedType (value : Checked V NotT)
  | exponent (value : SsqsExponentValue ExponentOther)
  | checkedInt (value : Checked (JInt .i64) NotInt)

structure SsqsReceipt (E State Tag V Other NotT ExponentOther NotInt : Type) where
  label : String
  arguments : List (SsqsArgument Tag V Other ExponentOther)
  outcome : Except (Error E) (SsqsObservedResult V Other NotT ExponentOther NotInt)
  before : State
  after : State

abbrev SsqsHistory (E State Tag V Other NotT ExponentOther NotInt : Type) :=
  List (SsqsReceipt E State Tag V Other NotT ExponentOther NotInt)

abbrev SsqsWorld (E State Tag V Other NotT ExponentOther NotInt : Type) :=
  State × SsqsHistory E State Tag V Other NotT ExponentOther NotInt

/-- Add a receipt after an actual call completes, preserving its original
outcome and post-call state.  The callee cannot rewrite the observation log. -/
def SsqsObserve {E State Tag V Other NotT ExponentOther NotInt A : Type}
    (label : String) (arguments : List (SsqsArgument Tag V Other ExponentOther))
    (encode : A → SsqsObservedResult V Other NotT ExponentOther NotInt)
    (action : SsqsM E State A) :
    SsqsM E (SsqsWorld E State Tag V Other NotT ExponentOther NotInt) A :=
  fun (state, history) =>
    match action state with
    | none => none
    | some (outcome, final) =>
        let receipt : SsqsReceipt E State Tag V Other NotT ExponentOther NotInt :=
          { label, arguments, outcome := outcome.map encode, before := state, after := final }
        some (outcome, (final, history ++ [receipt]))

/-- All callbacks remain arbitrary.  Instrumentation records arguments and
returned values but assumes no numerical, conversion, or predicate laws. -/
def SsqsObservedOps {E State Tag V Other NotT ExponentOther NotInt : Type}
    (ops : SsqsOps (SsqsM E State) Tag V Other NotT ExponentOther NotInt) :
    SsqsOps (SsqsM E (SsqsWorld E State Tag V Other NotT ExponentOther NotInt))
      Tag V Other NotT ExponentOther NotInt where
  multiply := fun x y => SsqsObserve "multiply" [.value x, .value y]
    SsqsObservedResult.value (ops.multiply x y)
  add := fun x y => SsqsObserve "add" [.value x, .value y]
    SsqsObservedResult.value (ops.add x y)
  isfinite := fun value => SsqsObserve "isfinite" [.value value]
    SsqsObservedResult.predicate (ops.isfinite value)
  notOther := fun value => SsqsObserve "notOther" [.predicateOther value]
    SsqsObservedResult.predicate (ops.notOther value)
  isinf := fun value => SsqsObserve "isinf" [.value value]
    SsqsObservedResult.predicate (ops.isinf value)
  convertInf := fun tag value => SsqsObserve "convertInf" [.typeTag tag, .float64 value]
    SsqsObservedResult.value (ops.convertInf tag value)
  equalZero := fun value zero => SsqsObserve "equalZero" [.value value, .int64 zero]
    SsqsObservedResult.predicate (ops.equalZero value zero)
  notEqualZero := fun value zero => SsqsObserve "notEqualZero" [.value value, .int64 zero]
    SsqsObservedResult.predicate (ops.notEqualZero value zero)
  zero := fun tag => SsqsObserve "zero" [.typeTag tag]
    SsqsObservedResult.value (ops.zero tag)
  nextfloat := fun value => SsqsObserve "nextfloat" [.value value]
    SsqsObservedResult.value (ops.nextfloat value)
  epsilon := fun tag => SsqsObserve "epsilon" [.typeTag tag]
    SsqsObservedResult.value (ops.epsilon tag)
  literalPower := fun value power => SsqsObserve "literalPower" [.value value, .literal power]
    SsqsObservedResult.value (ops.literalPower value power)
  multiplyInt := fun factor value => SsqsObserve "multiplyInt" [.int64 factor, .value value]
    SsqsObservedResult.value (ops.multiplyInt factor value)
  divide := fun x y => SsqsObserve "divide" [.value x, .value y]
    SsqsObservedResult.value (ops.divide x y)
  less := fun x y => SsqsObserve "less" [.value x, .value y]
    SsqsObservedResult.predicate (ops.less x y)
  abs := fun value => SsqsObserve "abs" [.value value]
    SsqsObservedResult.value (ops.abs value)
  max := fun x y => SsqsObserve "max" [.value x, .value y]
    SsqsObservedResult.maximum (ops.max x y)
  convertMax := fun tag value => SsqsObserve "convertMax" [.typeTag tag, .value value]
    SsqsObservedResult.checkedType (ops.convertMax tag value)
  exponent := fun value => SsqsObserve "exponent" [.value value]
    SsqsObservedResult.exponent (ops.exponent value)
  convertInt := fun value => SsqsObserve "convertInt" [.exponentOther value]
    SsqsObservedResult.checkedInt (ops.convertInt value)
  ldexp := fun value exponent => SsqsObserve "ldexp" [.value value, .int64 exponent]
    SsqsObservedResult.value (ops.ldexp value exponent)

def SsqsFailure {E State Tag V Other NotT ExponentOther NotInt : Type}
    (receipt : SsqsReceipt E State Tag V Other NotT ExponentOther NotInt) : Option (Error E) :=
  match receipt.outcome with | .error error => some error | .ok _ => none

def SsqsStateChain {E State Tag V Other NotT ExponentOther NotInt : Type}
    (initial final : State) : SsqsHistory E State Tag V Other NotT ExponentOther NotInt → Prop
  | [] => final = initial
  | receipt :: rest => receipt.before = initial ∧ SsqsStateChain receipt.after final rest

def SsqsValueAt {E State Tag V Other NotT ExponentOther NotInt : Type}
    (history : SsqsHistory E State Tag V Other NotT ExponentOther NotInt) (index : Nat) : Option V :=
  match history[index]? with
  | some receipt => match receipt.outcome with | .ok (.value value) => some value | _ => none
  | none => none

def SsqsCallAt {E State Tag V Other NotT ExponentOther NotInt : Type}
    (history : SsqsHistory E State Tag V Other NotT ExponentOther NotInt)
    (index : Nat) (label : String)
    (arguments : List (SsqsArgument Tag V Other ExponentOther)) : Prop :=
  ∃ receipt, history[index]? = some receipt ∧ receipt.label = label ∧ receipt.arguments = arguments

/-- Observe two distinct squaring calls on the original inputs before the
addition.  The add receives their actual returned values, not assumed squares.
An incomplete opening sequence must end in the first thrown callee exception. -/
def SsqsOpening {E State Tag V Other NotT ExponentOther NotInt : Type}
    (x y : V) (history : SsqsHistory E State Tag V Other NotT ExponentOther NotInt) : Prop :=
  ∃ xx yy : V,
    (∀ value, SsqsValueAt history 0 = some value → xx = value) ∧
    (∀ value, SsqsValueAt history 1 = some value → yy = value) ∧
    let expected : List (String × List (SsqsArgument Tag V Other ExponentOther)) :=
      [("multiply", [.value x, .value x]), ("multiply", [.value y, .value y]),
       ("add", [.value xx, .value yy])]
    (history.map (fun receipt => (receipt.label, receipt.arguments))).take 3 =
      expected.take history.length ∧
    (history.length < 3 → ∃ last, history.getLast? = some last ∧ SsqsFailure last ≠ none)

/-- Mathematical native-Int64 negation, expressed independently of the model's
Neg instance.  The one exceptional endpoint wraps back to itself. -/
def SsqsNegatedIntValue (value : JInt .i64) : Int :=
  if value.val = -(2 : Int)^63 then value.val else -value.val

/-- A successful k assignment is followed by the original x and y ldexp calls
with the same wrapping-negated native exponent.  The second call is required
only after the first returns, and receives the original y unchanged. -/
def SsqsLdexpPairAt {E State Tag V Other NotT ExponentOther NotInt : Type}
    (history : SsqsHistory E State Tag V Other NotT ExponentOther NotInt)
    (index : Nat) (x y : V) (k : JInt .i64) : Prop :=
  ∃ first negative,
    history[index]? = some first ∧ first.label = "ldexp" ∧
    first.arguments = [.value x, .int64 negative] ∧ negative.val = SsqsNegatedIntValue k ∧
    (∀ value, first.outcome = .ok (.value value) →
      SsqsCallAt history (index + 1) "ldexp" [.value y, .int64 negative])

/-- The actual value accepted for m is compared with native zero.  The
following selected call depends on that actual comparison result. -/
def SsqsMaximumContinuation {E State Tag V Other NotT ExponentOther NotInt : Type}
    (history : SsqsHistory E State Tag V Other NotT ExponentOther NotInt)
    (index : Nat) (x y value : V) : Prop :=
  SsqsCallAt history index "equalZero" [.value value, .int64 (JInt.lit .i64 0)] ∧
    (∀ next, history[index]? = some next →
      match next.outcome with
      | .ok (.predicate (.boolean true)) =>
          SsqsLdexpPairAt history (index + 1) x y (JInt.lit .i64 0)
      | .ok (.predicate (.boolean false)) =>
          SsqsCallAt history (index + 1) "exponent" [.value value]
      | _ => True)

/-- Typed local assignment is an observable conditional-conversion protocol.
The runtime isa-T partition skips conversion only when already inside T;
otherwise selected convert(T,max(...)) runs and its accepted actual result
continues.  Native exponent results likewise skip convert(Int,...) while
nonnative results execute it before any ldexp call.  Threshold calls retain
their literal power tag and native Int factor without arithmetic assumptions. -/
def SsqsAssignmentFlow {E State Tag V Other NotT ExponentOther NotInt : Type}
    (tag : Tag) (x y : V)
    (history : SsqsHistory E State Tag V Other NotT ExponentOther NotInt) : Prop :=
  ∀ (index : Nat) (receipt : SsqsReceipt E State Tag V Other NotT ExponentOther NotInt),
    history[index]? = some receipt →
    match receipt.label, receipt.outcome with
    | "isfinite", .ok (.predicate (.other value)) =>
        SsqsCallAt history (index + 1) "notOther" [.predicateOther value]
    | "max", .ok (.maximum (.inType value)) =>
        SsqsMaximumContinuation history (index + 1) x y value
    | "max", .ok (.maximum (.other value)) =>
        SsqsCallAt history (index + 1) "convertMax" [.typeTag tag, .value value]
    | "convertMax", .ok (.checkedType (.accepted value)) =>
        SsqsMaximumContinuation history (index + 1) x y value
    | "exponent", .ok (.exponent (.int64 value)) =>
        SsqsLdexpPairAt history (index + 1) x y value
    | "exponent", .ok (.exponent (.other value)) =>
        SsqsCallAt history (index + 1) "convertInt" [.exponentOther value]
    | "convertInt", .ok (.checkedInt (.accepted value)) =>
        SsqsLdexpPairAt history (index + 1) x y value
    | "zero", .ok (.value value) =>
        SsqsCallAt history (index + 1) "nextfloat" [.value value]
    | "nextfloat", .ok (.value _) =>
        SsqsCallAt history (index + 1) "epsilon" [.typeTag tag]
    | "epsilon", .ok (.value value) =>
        SsqsCallAt history (index + 1) "literalPower" [.value value, .literal .two]
    | "literalPower", .ok (.value value) =>
        SsqsCallAt history (index + 1) "multiplyInt" [.int64 (JInt.lit .i64 2), .value value]
    | "multiplyInt", .ok (.value denominator) =>
        ∃ numerator, SsqsValueAt history (index - 3) = some numerator ∧
          SsqsCallAt history (index + 1) "divide" [.value numerator, .value denominator]
    | "divide", .ok (.value threshold) =>
        ∃ rho, SsqsValueAt history 2 = some rho ∧
          SsqsCallAt history (index + 1) "less" [.value rho, .value threshold]
    | _, _ => True

/-- Precisely the results that the caller must reject immediately.  A
non-Bool isfinite result itself is not rejected: selected ! must run first.
The infinity-conversion result is intentionally absent from this list. -/
def SsqsRequiredError {E State Tag V Other NotT ExponentOther NotInt : Type}
    (receipt : SsqsReceipt E State Tag V Other NotT ExponentOther NotInt) : Option (Error E) :=
  match receipt.label, receipt.outcome with
  | "convertMax", .ok (.checkedType (.rejected _)) => some (.typeError "ssqs m::T")
  | "convertInt", .ok (.checkedInt (.rejected _)) => some (.typeError "ssqs k::Int")
  | "notOther", .ok (.predicate (.other _)) => some (.typeError "ssqs Boolean condition")
  | "isinf", .ok (.predicate (.other _)) => some (.typeError "ssqs Boolean condition")
  | "equalZero", .ok (.predicate (.other _)) => some (.typeError "ssqs Boolean condition")
  | "notEqualZero", .ok (.predicate (.other _)) => some (.typeError "ssqs Boolean condition")
  | "less", .ok (.predicate (.other _)) => some (.typeError "ssqs Boolean condition")
  | _, _ => none

/-- The value returned for rho is the last actual add/convertInf result.  k is
the actual native exponent or accepted conversion result, or native zero when
no nonzero-maximum exponent was requested.  This promises data provenance, not
a fabricated public numerical specification for the internal helper. -/
def SsqsReturnOrigin {E State Tag V Other NotT ExponentOther NotInt : Type}
    (history : SsqsHistory E State Tag V Other NotT ExponentOther NotInt)
    (result : V × JInt .i64) : Prop :=
  let rhoValues := history.filterMap (fun receipt =>
    match receipt.label, receipt.outcome with
    | "add", .ok (.value value) => some value
    | "convertInf", .ok (.value value) => some value
    | _, _ => none)
  let exponentValues := history.filterMap (fun receipt =>
    match receipt.label, receipt.outcome with
    | "exponent", .ok (.exponent (.int64 value)) => some value
    | "convertInt", .ok (.checkedInt (.accepted value)) => some value
    | _, _ => none)
  rhoValues.getLast? = some result.1 ∧
    result.2 = exponentValues.getLast?.getD (JInt.lit .i64 0)

/-- Completed observations retain call order, exact first failures, state,
conversion/assertion boundaries, and the provenance of the returned pair.
No correctness premise for any selected callee appears in this specification. -/
def SsqsAudit {E State Tag V Other NotT ExponentOther NotInt : Type}
    (tag : Tag) (x y : V) (initial : State)
    (observed : Option (Except (Error E) (V × JInt .i64) ×
      SsqsWorld E State Tag V Other NotT ExponentOther NotInt)) : Prop :=
  match observed with
  | none => True
  | some (outcome, (final, history)) =>
      SsqsOpening x y history ∧ SsqsStateChain initial final history ∧
      SsqsAssignmentFlow tag x y history ∧
      (∀ index receipt error, history[index]? = some receipt →
        SsqsRequiredError receipt = some error →
        history.length = index + 1 ∧ outcome = .error error) ∧
      match outcome with
      | .ok result => (∀ receipt ∈ history, SsqsFailure receipt = none) ∧
          SsqsReturnOrigin history result
      | .error error =>
          ∃ earlier last, history = earlier ++ [last] ∧
            (∀ receipt ∈ earlier, SsqsFailure receipt = none) ∧ final = last.after ∧
            (SsqsFailure last = some error ∨
              (SsqsFailure last = none ∧ SsqsRequiredError last = some error))

/-- Independent internal invariant over every source input and arbitrary
selected stateful/errorful scalar operations: initial products are distinct,
actual results are forwarded, typed assignments preserve runtime type guards, conversion and error
boundaries, native exponent negation wraps correctly, and the result pair
retains its actual value origins.  This does not invent a public contract or
claim numerical accuracy for ssqs.
Julia source: base/complex.jl:519-531; base/intfuncs.jl:453-460;
manual/types.md:85-89 @ f755f49a9e41380d7da126b3c1db9fe7f83dd027. -/
def SsqsEvaluationAndTypedAssignmentAudit : Prop :=
  ∀ (E State Tag V Other NotT ExponentOther NotInt : Type)
      (ops : SsqsOps (SsqsM E State) Tag V Other NotT ExponentOther NotInt)
      (tag : Tag) (x y : V) (initial : State),
    SsqsAudit tag x y initial ((scaledSquares (E := E) (SsqsObservedOps ops) tag x y) (initial, []))

end JuliaLean.Proofs.base.complex.Models2Group9


