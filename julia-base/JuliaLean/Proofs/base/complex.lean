/-- The scalar conversion obligation shared by five complex targets. -/
def rootIntegerNearestCore : Prop :=
  ∀ (t : IntTy) (x : JInt t), NearestInteger64 x.val (F64.ofJInt x)

theorem rootIntegerNearestCore_proven : rootIntegerNearestCore := by
  intro t x
  rw [intNearestOfJInt_eq]
  apply Scalar.IntegerNearest.integer_nearest
  have hlo := x.property.1
  have hhi := x.property.2
  cases t <;> rcases Int.natAbs_eq x.val with ha | ha <;>
    simp only [IntTy.min, IntTy.max, IntTy.signed, IntTy.bits] at hlo hhi <;> omega

theorem rootIntConstructorsFromNearest (h : rootIntegerNearestCore) :
    IntToFloatConstructors := by
  constructor
  · intro t x
    change NearestInteger64 x.val (F64.ofJInt x) ∧ F64.ofJInt (JInt.lit .i64 0) = F64.zero false
    exact ⟨h t x, rfl⟩
  · intro t z
    exact ⟨h t z.re, h t z.im⟩

theorem rootMixedConstructorsFromNearest (h : rootIntegerNearestCore) :
    MixedIntegerFloatConstructors := by
  exact ⟨fun t x _ => ⟨h t x, rfl⟩, fun t _ y => ⟨rfl, h t y⟩⟩

theorem rootFloatScalarIdentity (z : ComplexF64) :
    match realF64AsF64 z with
    | .ok x => F64.iszero z.im = true ∧ x = z.re
    | .error (.inexactError _) => F64.iszero z.im = false
    | .error _ => False := by
  unfold realF64AsF64 Type_T_Complex isreal_Complex imag_Complex
  cases h : F64.iszero z.im <;> simp only [h, Bool.false_eq_true, ↓reduceIte, and_self]

theorem rootComplexToFloatFromNearest (h : rootIntegerNearestCore) :
    ComplexToFloat := by
  refine ⟨?_, rootFloatScalarIdentity⟩
  intro t z
  unfold realIntAsF64 Type_T_Complex isreal_Complex iszero_JInt imag_Complex
  by_cases hz : z.im.val = 0
  · simp only [hz, beq_self_eq_true, ↓reduceIte]
    exact ⟨trivial, h t z.re⟩
  · simp only [beq_eq_false_iff_ne.mpr hz, Bool.false_eq_true, ↓reduceIte]
    exact hz

theorem rootPublicAliasesFromNearest (h : rootIntegerNearestCore)
    (hc : IntegerConstructors) : PublicComplexAliases := by
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_⟩
  · intro t x
    exact hc.2.1 t x
  · intro t s x y
    exact hc.1 t s x y
  · intro x
    rfl
  · intro x y
    rfl
  · intro t x y
    exact ⟨h t x, rfl⟩
  · intro t x y
    exact ⟨rfl, h t y⟩

theorem rootFloatBoolConversion (z : Complex Bool) :
    F64.isfinite (floatComplexBool z).re = true ∧
    F64.isfinite (floatComplexBool z).im = true ∧
    (F64.toRat (floatComplexBool z).re).1 =
      BoolInteger z.re * ((F64.toRat (floatComplexBool z).re).2 : Int) ∧
    (F64.toRat (floatComplexBool z).im).1 =
      BoolInteger z.im * ((F64.toRat (floatComplexBool z).im).2 : Int) ∧
    F64.signbit (floatComplexBool z).re = false ∧
    F64.signbit (floatComplexBool z).im = false := by
  rcases z with ⟨r, i⟩
  cases r <;> cases i <;> unfold BoolInteger <;> decide

theorem rootFloatingConversionFromNearest (h : rootIntegerNearestCore) :
    FloatingComplexConversion := by
  exact ⟨fun t z => ⟨h t z.re, h t z.im⟩, rootFloatBoolConversion⟩

theorem Models1G19IntToFloatConstructors_proven :
