set_option maxRecDepth 10000
set_option maxHeartbeats 1000000
set_option exponentiation.threshold 5000

def ratEquiv (a b : Int × Int) : Prop := a.1*b.2 = b.1*a.2

theorem rat_equiv_left (a b c : Int × Int) (ha : 0 < a.2) (hb : 0 < b.2)
    (hab : ratEquiv a b) : RatLessEqual a c ↔ RatLessEqual b c := by
  have hl : (a.1*c.2)*b.2 = (b.1*c.2)*a.2 := by
    rw [Int.mul_right_comm, show a.1*b.2 = b.1*a.2 from hab, Int.mul_right_comm]
  have hr : (c.1*a.2)*b.2 = (c.1*b.2)*a.2 := Int.mul_right_comm _ _ _
  change a.1*c.2 ≤ c.1*a.2 ↔ b.1*c.2 ≤ c.1*b.2
  calc
    a.1*c.2 ≤ c.1*a.2 ↔ (a.1*c.2)*b.2 ≤ (c.1*a.2)*b.2 := (int_le_cancel_positive hb).symm
    _ ↔ (b.1*c.2)*a.2 ≤ (c.1*b.2)*a.2 := by rw [hl, hr]
    _ ↔ b.1*c.2 ≤ c.1*b.2 := int_le_cancel_positive ha

theorem rat_equiv_right (a b c : Int × Int) (ha : 0 < a.2) (hb : 0 < b.2)
    (hab : ratEquiv a b) : RatLessEqual c a ↔ RatLessEqual c b := by
  have hl : (c.1*a.2)*b.2 = (c.1*b.2)*a.2 := Int.mul_right_comm _ _ _
  have hr : (a.1*c.2)*b.2 = (b.1*c.2)*a.2 := by
    rw [Int.mul_right_comm, show a.1*b.2 = b.1*a.2 from hab, Int.mul_right_comm]
  change c.1*a.2 ≤ a.1*c.2 ↔ c.1*b.2 ≤ b.1*c.2
  calc
    c.1*a.2 ≤ a.1*c.2 ↔ (c.1*a.2)*b.2 ≤ (a.1*c.2)*b.2 := (int_le_cancel_positive hb).symm
    _ ↔ (c.1*b.2)*a.2 ≤ (b.1*c.2)*a.2 := by rw [hl, hr]
    _ ↔ c.1*b.2 ≤ b.1*c.2 := int_le_cancel_positive ha

theorem rat_equiv_sum (a b c d : Int × Int) (hac : ratEquiv a c) (hbd : ratEquiv b d) :
    ratEquiv (RatSum a b) (RatSum c d) := by
  change (a.1*b.2+b.1*a.2)*(c.2*d.2) = (c.1*d.2+d.1*c.2)*(a.2*b.2)
  rw [Int.add_mul, Int.add_mul]
  congr 1
  · calc
      (a.1*b.2)*(c.2*d.2) = (a.1*c.2)*(b.2*d.2) := by
        simp only [Int.mul_assoc, Int.mul_comm, Int.mul_left_comm]
      _ = (c.1*a.2)*(b.2*d.2) := by rw [show a.1*c.2=c.1*a.2 from hac]
      _ = (c.1*d.2)*(a.2*b.2) := by simp only [Int.mul_assoc, Int.mul_comm, Int.mul_left_comm]
  · calc
      (b.1*a.2)*(c.2*d.2) = (b.1*d.2)*(a.2*c.2) := by
        simp only [Int.mul_assoc, Int.mul_comm, Int.mul_left_comm]
      _ = (d.1*b.2)*(a.2*c.2) := by rw [show b.1*d.2=d.1*b.2 from hbd]
      _ = (d.1*c.2)*(a.2*b.2) := by simp only [Int.mul_assoc, Int.mul_comm, Int.mul_left_comm]

theorem spacing_den_pos (x : F64) : 0 < (Spacing64 x).2 := by
  let e : Nat := F64.toBits x / 2^52 % 2048
  let u : Int := if e = 0 then -1074 else (e : Int)-1075
  change 0 < (if u ≥ 0 then (((2^u.toNat : Nat) : Int), (1 : Int))
    else ((1 : Int), ((2^(-u).toNat : Nat) : Int))).2
  split
  · exact Int.zero_lt_one
  · exact Int.natCast_pos.mpr (Nat.two_pow_pos _)

theorem epsilon_bounds_transport (x y r : F64) (hx : F64.isfinite x = true) (hy : F64.isfinite y = true)
    (hb : bounds (F64.eps x) (F64.eps y) r) :
    F64.isfinite r = true ∧ F64.signbit r = false ∧
      RatLessEqual (Spacing64 x) (rat r) ∧ RatLessEqual (Spacing64 y) (rat r) ∧
      RatLessEqual (rat r) (RatSum (Spacing64 x) (Spacing64 y)) := by
  have hxs := floatCheckEpsilonFiniteSpacing x hx
  have hys := floatCheckEpsilonFiniteSpacing y hy
  have hxe : ratEquiv (rat (F64.eps x)) (Spacing64 x) := hxs.2.2
  have hye : ratEquiv (rat (F64.eps y)) (Spacing64 y) := hys.2.2
  have hxd := rat_den_pos _ hxs.1
  have hyd := rat_den_pos _ hys.1
  have hxsD := spacing_den_pos x
  have hysD := spacing_den_pos y
  rcases hb with ⟨hf, hs, hrx, hry, hrs⟩
  refine ⟨hf, hs,
    (rat_equiv_left _ _ _ hxd hxsD hxe).mp hrx,
    (rat_equiv_left _ _ _ hyd hysD hye).mp hry, ?_⟩
  exact (rat_equiv_right _ _ _ (Int.mul_pos hxd hyd) (Int.mul_pos hxsD hysD)
    (rat_equiv_sum _ _ _ _ hxe hye)).mp hrs

def TailProperty : Prop :=
  ∀ a t : Int, ∀ d : Nat,
    -511 ≤ a → a ≤ 511 → d ≤ 26 → -511 ≤ a-d →
    -1074 ≤ a+t → a+t ≤ 971 → -1074 ≤ a+t-d →
    (t = 0 ∨ t = 563 ∨ t = -563) →
    ∃ r : F64, tail (power a) (power (a-d)) (power t) = .ok r ∧
      bounds (power (a+t)) (power (a+t-d)) r

theorem hypot_bounds_ordered (htail : TailProperty) (p q : Int)
    (hp0 : -1074 ≤ p) (hp1 : p ≤ 971) (hq0 : -1074 ≤ q) (hq1 : q ≤ 971)
    (horder : q ≤ p) :
    ∃ r : F64, Fl64.hypot (power p) (power q) = .ok r ∧ bounds (power p) (power q) r := by
  rw [hypot_power_ordered p q hp0 hp1 hq0 hq1 horder]
  cases hfast : F64.le (power q) (F64.mul (power p) fastRoot) with
  | true =>
      simp only [↓reduceIte]
      exact ⟨power p, rfl, fast_bounds p q hp0 hp1 hq0 hq1 horder⟩
  | false =>
      simp only [Bool.false_eq_true, ↓reduceIte]
      have hg := failed_fast_gap p q hp0 hp1 hq0 hq1 hfast
      obtain ⟨a, t, ha0, ha1, haq, hat, ht, heval⟩ := scaled_power p q hp0 hp1 hq0 hq1 horder hg
      let d : Nat := (p-q).toNat
      have hdEq : p-q = (d : Int) := by dsimp only [d]; omega
      have hd : d ≤ 26 := by omega
      rw [hdEq] at haq heval
      obtain ⟨r, hr, hb⟩ := htail a t d ha0 ha1 hd haq (by omega) (by omega) (by omega) ht
      refine ⟨r, heval.trans hr, ?_⟩
      have hqeq : p-d = q := by omega
      simpa only [hat, hqeq] using hb

theorem hypot_power_bounds (htail : TailProperty) (p q : Int)
    (hp0 : -1074 ≤ p) (hp1 : p ≤ 971) (hq0 : -1074 ≤ q) (hq1 : q ≤ 971) :
    ∃ r : F64, Fl64.hypot (power p) (power q) = .ok r ∧ bounds (power p) (power q) r := by
  by_cases horder : q ≤ p
  · exact hypot_bounds_ordered htail p q hp0 hp1 hq0 hq1 horder
  · rw [hypot_power_swap p q hp0 hp1 hq0 hq1 (by omega)]
    obtain ⟨r, hr, hb⟩ := hypot_bounds_ordered htail q p hq0 hq1 hp0 hp1 (by omega)
    exact ⟨r, hr, bounds_swap _ _ _ hb⟩

theorem epsilon_finite_bounds (htail : TailProperty) (x y : F64)
    (hx : F64.isfinite x = true) (hy : F64.isfinite y = true) :
    ∃ r : F64, Fl64.hypot (F64.eps x) (F64.eps y) = .ok r ∧
      bounds (F64.eps x) (F64.eps y) r := by
  let p : Int := ((F64.exponentField x-1 : Nat) : Int)-1074
  let q : Int := ((F64.exponentField y-1 : Nat) : Int)-1074
  have hxp : -1074 ≤ p ∧ p ≤ 971 ∧ F64.eps x = power p := floatCheckEpsilonPowerForm x hx
  have hyp : -1074 ≤ q ∧ q ≤ 971 ∧ F64.eps y = power q := floatCheckEpsilonPowerForm y hy
  rw [hxp.2.2, hyp.2.2]
  exact hypot_power_bounds htail p q hxp.1 hxp.2.1 hyp.1 hyp.2.1

theorem complex_epsilon_of_tail (htail : TailProperty) : ComplexEpsilon := by
  constructor
  · intro z
    by_cases hf : F64.isfinite z.re = true ∧ F64.isfinite z.im = true
    · obtain ⟨r, hr, hb⟩ := epsilon_finite_bounds htail z.re z.im hf.1 hf.2
      have he : epsilonComplexF64 z = .ok r := hr
      rw [he]
      refine ⟨fun _ => epsilon_bounds_transport z.re z.im r hf.1 hf.2 hb, ?_⟩
      intro hn
      rcases hn with hn | hn
      · rw [hf.1] at hn
        contradiction
      · rw [hf.2] at hn
        contradiction
    · have hn : F64.isfinite z.re = false ∨ F64.isfinite z.im = false := by
        by_cases hr : F64.isfinite z.re = true
        · exact Or.inr (Bool.eq_false_iff.mpr (fun hi => hf ⟨hr, hi⟩))
        · exact Or.inl (Bool.eq_false_iff.mpr hr)
      obtain ⟨r, hr, hnan⟩ := floatCheckEpsilonComplexNonfinite z hn
      rw [hr]
      exact ⟨fun h => False.elim (hf h), fun _ => hnan⟩
  · exact floatCheckEpsilonType

end JuliaLean.ChatGPT.Batch10.Group1.Epsilon

