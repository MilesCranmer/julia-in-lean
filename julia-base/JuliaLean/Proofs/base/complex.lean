/-- The closed type-level epsilon evaluation has the required binary64 bits. -/
theorem floatCheckEpsilonType : epsilonTypeF64 = .ok (F64.ofBits 0x3cb6a09e667f3bcd) := by decide

theorem floatCheckAbsClasses (x : F64) : F64.isnan (F64.abs x) = F64.isnan x ∧
    F64.isfinite (F64.abs x) = F64.isfinite x := by
  have ht := x.isLt
  have he : F64.exponentField (F64.abs x) = F64.exponentField x := by
    simp only [F64.exponentField, tb_abs]
    omega
  have hp : F64.fraction (F64.abs x) = F64.fraction x := by
    simp only [F64.fraction, tb_abs]
    omega
  simp only [F64.isnan, F64.isfinite, he, hp]
  exact ⟨True.intro, True.intro⟩

theorem floatCheckNaNNotInf (x : F64) (hn : F64.isnan x = true) : F64.isinf x = false := by
  have ht := x.isLt
  simp only [F64.isnan, F64.exponentField, F64.fraction, Bool.and_eq_true,
    beq_iff_eq, bne_iff_ne] at hn
  simp only [F64.isinf, tb_abs, beq_eq_false_iff_ne]
  omega

theorem floatCheckSubNan (x y : F64) (h : F64.isnan x = true ∨ F64.isnan y = true) :
    F64.isnan (F64.sub x y) = true := by
  unfold F64.sub
  by_cases hx : F64.isnan x = true
  · simp only [hx, ↓reduceIte]
    exact floatCheckQuietNan x hx
  · have hxf : F64.isnan x = false := Bool.eq_false_iff.mpr hx
    have hy := h.resolve_left hx
    simp only [hxf, hy, Bool.false_eq_true, ↓reduceIte]
    exact floatCheckQuietNan y hy

theorem floatCheckMulNan (x y : F64) (h : F64.isnan x = true ∨ F64.isnan y = true) :
    F64.isnan (F64.mul x y) = true := by
  unfold F64.mul
  by_cases hx : F64.isnan x = true
  · simp only [hx, ↓reduceIte]
    exact floatCheckQuietNan x hx
  · have hxf : F64.isnan x = false := Bool.eq_false_iff.mpr hx
    have hy := h.resolve_left hx
    simp only [hxf, hy, Bool.false_eq_true, ↓reduceIte]
    exact floatCheckQuietNan y hy

theorem floatCheckDivNan (x y : F64) (h : F64.isnan x = true ∨ F64.isnan y = true) :
    F64.isnan (F64.div x y) = true := by
  unfold F64.div
  by_cases hx : F64.isnan x = true
  · simp only [hx, ↓reduceIte]
    exact floatCheckQuietNan x hx
  · have hxf : F64.isnan x = false := Bool.eq_false_iff.mpr hx
    have hy := h.resolve_left hx
    simp only [hxf, hy, Bool.false_eq_true, ↓reduceIte]
    exact floatCheckQuietNan y hy

theorem floatCheckFmaNan (x y z : F64)
    (h : F64.isnan x = true ∨ F64.isnan y = true ∨ F64.isnan z = true) :
    F64.isnan (F64.muladd x y z) = true := by
  unfold F64.muladd F64.fma
  by_cases hx : F64.isnan x = true
  · simp only [hx, ↓reduceIte]
    exact floatCheckQuietNan x hx
  · have hxf : F64.isnan x = false := Bool.eq_false_iff.mpr hx
    simp only [hxf, Bool.false_eq_true, ↓reduceIte]
    by_cases hy : F64.isnan y = true
    · simp only [hy, ↓reduceIte]
      exact floatCheckQuietNan y hy
    · have hyf : F64.isnan y = false := Bool.eq_false_iff.mpr hy
      have hz := (h.resolve_left hx).resolve_left hy
      simp only [hyf, hz, Bool.false_eq_true, ↓reduceIte]
      exact floatCheckQuietNan z hz

theorem floatCheckNanComparison (x y : F64) (h : F64.isnan x = true ∨ F64.isnan y = true) :
    F64.lt x y = false ∧ F64.le x y = false := by
  have hor : (F64.isnan x || F64.isnan y) = true := by simpa only [Bool.or_eq_true] using h
  have hlt : F64.lt x y = false := by
    unfold F64.lt
    simp only [hor, Bool.true_or, ↓reduceIte]
  have heq : F64.eq x y = false := by
    unfold F64.eq
    rcases h with h | h <;> simp only [h, Bool.not_true, Bool.false_and, Bool.and_false]
  exact ⟨hlt, by simp only [F64.le, hlt, heq, Bool.false_or]⟩

theorem floatCheckSqrtNan (x : F64) (hx : F64.isnan x = true) :
    F64.sqrt x = .ok (f64QuietNaN x) := by
  have hlt := (floatCheckNanComparison x (F64.zero false) (Or.inl hx)).1
  unfold F64.sqrt
  simp only [hlt, hx, Bool.false_eq_true, ↓reduceIte]
  rfl

/-- Toggling the least bit keeps sign and exponent fixed and changes the fraction by one step. -/
theorem floatCheckEpsilonNeighbor (x : F64) :
    let y := F64.ofBits (Nat.xor (F64.toBits x) 1)
    F64.exponentField y = F64.exponentField x ∧ F64.signbit y = F64.signbit x ∧
      F64.fraction y = Nat.xor (F64.fraction x) 1 ∧
      F64.fraction x ≤ F64.fraction y + 1 ∧ F64.fraction y ≤ F64.fraction x + 1 := by
  have ht := x.isLt
  have hxor : Nat.xor (F64.toBits x) 1 < 2 ^ 64 := Nat.xor_lt_two_pow ht (by decide)
  have hb : F64.toBits (F64.ofBits (Nat.xor (F64.toBits x) 1)) = Nat.xor (F64.toBits x) 1 := by
    rw [tb_ofBits, Nat.mod_eq_of_lt hxor]
  have he : Nat.xor (F64.toBits x) 1 / 2 ^ 52 = F64.toBits x / 2 ^ 52 := by
    change (F64.toBits x ^^^ 1) / 2 ^ 52 = F64.toBits x / 2 ^ 52
    rw [Nat.xor_div_two_pow]
    exact Nat.xor_zero _
  have hs : Nat.xor (F64.toBits x) 1 / 2 ^ 63 = F64.toBits x / 2 ^ 63 := by
    change (F64.toBits x ^^^ 1) / 2 ^ 63 = F64.toBits x / 2 ^ 63
    rw [Nat.xor_div_two_pow]
    exact Nat.xor_zero _
  have hhalf : Nat.xor (F64.toBits x) 1 / 2 = F64.toBits x / 2 := by
    change (F64.toBits x ^^^ 1) / 2 = F64.toBits x / 2
    rw [Nat.xor_div_two]
    exact Nat.xor_zero _
  have h1 := Nat.div_add_mod (Nat.xor (F64.toBits x) 1) 2
  have h2 := Nat.div_add_mod (F64.toBits x) 2
  have h1r := Nat.mod_lt (Nat.xor (F64.toBits x) 1) (by decide : 0 < 2)
  have h2r := Nat.mod_lt (F64.toBits x) (by decide : 0 < 2)
  dsimp only
  refine ⟨?_, ?_, ?_, ?_, ?_⟩
  · simp only [F64.exponentField, hb, he]
  · simp only [F64.signbit, hb]
    apply Bool.eq_iff_iff.mpr
    simp only [decide_eq_true_iff]
    omega
  · simp only [F64.fraction, hb]
    change (F64.toBits x ^^^ 1) % 2 ^ 52 = (F64.toBits x % 2 ^ 52) ^^^ 1
    rw [Nat.xor_mod_two_pow]
  · simp only [F64.fraction, hb]
    omega
  · simp only [F64.fraction, hb]
    omega

theorem floatCheckEpsilonNonfinite (x : F64) (hx : F64.isfinite x = false) :
    F64.isnan (F64.eps x) = true := by
  let y := F64.ofBits (Nat.xor (F64.toBits x) 1)
  obtain ⟨he, _, hp, _, _⟩ := floatCheckEpsilonNeighbor x
  change F64.exponentField y = F64.exponentField x at he
  change F64.fraction y = Nat.xor (F64.fraction x) 1 at hp
  have hnan : F64.isnan x = true ∨ F64.isnan y = true := by
    by_cases hn : F64.isnan x = true
    · exact Or.inl hn
    · have hnf : F64.isnan x = false := Bool.eq_false_iff.mpr hn
      have hemax : F64.exponentField x = 2047 := by simpa only [F64.isfinite, bne_eq_false_iff_eq] using hx
      have hfrac : F64.fraction x = 0 := by
        simp only [F64.isnan, hemax, beq_self_eq_true, Bool.true_and, bne_eq_false_iff_eq] at hnf
        exact hnf
      apply Or.inr
      simp only [F64.isnan, he, hemax, hp, hfrac, Nat.zero_xor]
      rfl
  unfold F64.eps
  change F64.isnan (F64.abs (F64.sub x y)) = true
  rw [(floatCheckAbsClasses _).1]
  exact floatCheckSubNan x y hnan

