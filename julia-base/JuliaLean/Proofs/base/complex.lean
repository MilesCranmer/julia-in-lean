namespace JuliaLean.ChatGPT.Batch10.Group1.SmallExact

open JuliaLean JuliaLean.Float JuliaLean.Promotion JuliaLean.Promotion.Fl
open JuliaLean.base.complex JuliaLean.base.complex.Models1Group19

set_option maxRecDepth 10000
set_option maxHeartbeats 1000000
set_option exponentiation.threshold 10000
set_option linter.unusedSimpArgs false

structure Good (f : Fmt) : Prop where
  emax_eq : f.emax = 2*f.bias+1
  emax_succ : f.emax+1 = 2^f.eb
  bias_pos : 1 ≤ f.bias
  sb_pos : 1 ≤ f.sb
  sb_le : f.sb ≤ f.bias

theorem good_half : Good half := ⟨by decide, by decide, by decide, by decide, by decide⟩
theorem good_single : Good single := ⟨by decide, by decide, by decide, by decide, by decide⟩
theorem good_double : Good double := ⟨by decide, by decide, by decide, by decide, by decide⟩

variable {f g : Fmt}

abbrev pack (s : Bool) (E M : Nat) : Fl f := floatCheckFlPack s E M

theorem bits_split {f : Fmt} (x : Fl f) :
    x.toBits = (if x.signbit then 2 ^ (f.eb + f.sb) else 0) + x.magnitude ∧
    x.magnitude < 2 ^ (f.eb + f.sb) := by
  have h : x.toBits < 2 * 2 ^ (f.eb + f.sb) := by
    have h1 := x.bits.isLt
    have h2 := floatCheckFlWidth f
    have h3 : x.toBits = x.bits.val := rfl
    omega
  have hW := Nat.two_pow_pos (f.eb + f.sb)
  refine ⟨?_, Nat.mod_lt _ hW⟩
  unfold Fl.signbit Fl.magnitude
  by_cases hs : x.toBits ≥ 2 ^ (f.eb + f.sb)
  · rw [Nat.mod_eq_sub_mod hs, Nat.mod_eq_of_lt (by omega)]
    simp only [hs, decide_true, ↓reduceIte]
    omega
  · rw [Nat.mod_eq_of_lt (by omega)]
    simp [hs]

theorem pow_mul_eq (m a b c d : Nat) (h : a + b = c + d) : m * 2 ^ a * 2 ^ b = m * 2 ^ c * 2 ^ d := by
  rw [Nat.mul_assoc, Nat.mul_assoc, ← Nat.pow_add, ← Nat.pow_add, h]

theorem log2_mul_pow (c i : Nat) (hc : c ≠ 0) : (c * 2 ^ i).log2 = c.log2 + i := by
  have hne : c * 2 ^ i ≠ 0 := Nat.mul_ne_zero hc (by have := Nat.two_pow_pos i; omega)
  apply Nat.le_antisymm
  · have : c * 2 ^ i < 2 ^ (c.log2 + i + 1) := by
      rw [show c.log2 + i + 1 = (c.log2 + 1) + i by omega, Nat.pow_add]
      exact (Nat.mul_lt_mul_right (Nat.two_pow_pos i)).2 Nat.lt_log2_self
    have := (Nat.log2_lt hne).2 this
    omega
  · apply (Nat.le_log2 hne).2
    rw [Nat.pow_add]
    exact Nat.mul_le_mul_right _ (Nat.log2_self_le hc)

theorem floorLog2Rat_pow (a j : Nat) (ha : a ≠ 0) :
    floorLog2Rat a (2 ^ j) = (a.log2 : Int) - j := by
  have h1 := Nat.log2_self_le ha
  unfold floorLog2Rat
  simp only [Nat.log2_two_pow]
  split
  · rename_i hge
    have : 2 ^ j * 2 ^ ((a.log2 : Int) - j).toNat = 2 ^ a.log2 := by
      rw [← Nat.pow_add]
      congr 1
      omega
    have hc : ¬ a < 2 ^ j * 2 ^ ((a.log2 : Int) - j).toNat := by omega
    split
    · contradiction
    · rfl
  · rename_i hlt
    have : 2 ^ a.log2 * 2 ^ (-((a.log2 : Int) - j)).toNat = 2 ^ j := by
      rw [← Nat.pow_add]
      congr 1
      omega
    have := Nat.mul_le_mul_right (2 ^ (-((a.log2 : Int) - j)).toNat) h1
    have hc : ¬ a * 2 ^ (-((a.log2 : Int) - j)).toNat < 2 ^ j := by omega
    split
    · contradiction
    · rfl

theorem roundQuotient_exact (q d : Nat) (hd : 0 < d) : roundQuotient (q * d) d = q := by
  unfold roundQuotient
  rw [Nat.mul_div_cancel _ hd, Nat.mul_mod_left]
  dsimp only
  split
  · rename_i h
    simp at h <;> omega
  · rfl

theorem packRounded_normal (neg : Bool) (q : Nat) (k : Int) (h1 : 2 ^ f.sb ≤ q)
    (h2 : q < 2 ^ (f.sb + 1)) (hk2 : k + f.bias + f.sb < f.emax) :
    (packRounded neg q k : Fl f) = pack neg (k + f.bias + f.sb).toNat (q - 2 ^ f.sb) := by
  have hP := Nat.two_pow_pos f.sb
  have hq0 : (q == 0) = false := by simp; omega
  have hc : ¬ q ≥ 2 ^ (f.sb + 1) := by omega
  have he : ¬ k + f.bias + f.sb ≥ (f.emax : Int) := by omega
  have hm : ¬ q < 2 ^ f.sb := by omega
  unfold packRounded pack floatCheckFlPack
  simp only [hq0, hc, he, hm, Bool.false_eq_true, ↓reduceIte]

theorem sig_bounds (c : Nat) (hc : c ≠ 0) (hc1 : c < 2 ^ (f.sb + 1)) :
    c.log2 ≤ f.sb ∧ 2 ^ f.sb ≤ c * 2 ^ (f.sb - c.log2) ∧
    c * 2 ^ (f.sb - c.log2) < 2 ^ (f.sb + 1) := by
  have hlc : c.log2 ≤ f.sb := by have := (Nat.log2_lt hc).2 hc1; omega
  refine ⟨hlc, ?_, ?_⟩
  · calc 2 ^ f.sb = 2 ^ c.log2 * 2 ^ (f.sb - c.log2) := by
          rw [← Nat.pow_add]
          congr 1
          omega
      _ ≤ _ := Nat.mul_le_mul_right _ (Nat.log2_self_le hc)
  · calc c * 2 ^ (f.sb - c.log2) < 2 ^ (c.log2 + 1) * 2 ^ (f.sb - c.log2) :=
          (Nat.mul_lt_mul_right (Nat.two_pow_pos _)).2 Nat.lt_log2_self
      _ = 2 ^ (f.sb + 1) := by
          rw [← Nat.pow_add]
          congr 1
          omega

theorem roundRat_normal (hf : Good f) (n : Int) (c i j : Nat) (z : Bool)
    (hn : n.natAbs = c * 2 ^ i) (hc0 : 1 ≤ c) (hc1 : c < 2 ^ (f.sb + 1))
    (hlo : j + 1 ≤ c.log2 + i + f.bias) (hhi : c.log2 + i + f.bias < j + f.emax) :
    (roundRat n (2 ^ j) z : Fl f) =
      pack (decide (n < 0)) (c.log2 + i + f.bias - j) (c * 2 ^ (f.sb - c.log2) - 2 ^ f.sb) := by
  have hc : c ≠ 0 := by omega
  obtain ⟨hlc, hq1, hq2⟩ := sig_bounds (f := f) c hc hc1
  have ha : n.natAbs ≠ 0 := by
    rw [hn]
    exact Nat.mul_ne_zero hc (by have := Nat.two_pow_pos i; omega)
  have hn0 : (n == 0) = false := by simp; omega
  have hd : (2 ^ j == 0) = false := by simp
  have hE : floorLog2Rat n.natAbs (2 ^ j) = ((c.log2 + i : Nat) : Int) - j := by
    rw [floorLog2Rat_pow _ _ ha, hn, log2_mul_pow c i hc]
  have hb := hf.bias_pos
  have hem := hf.emax_eq
  have hs := hf.sb_pos
  unfold roundRat
  simp only [hd, hn0, Bool.false_eq_true, ↓reduceIte]
  generalize floorLog2Rat n.natAbs (2 ^ j) = e at hE
  split
  · exfalso; omega
  split
  · exfalso; omega
  have hk : max (e - f.sb) (1 - (f.bias : Int) - f.sb) = e - f.sb := by omega
  rw [hk]
  have hpack : ∀ q : Nat, q = c * 2 ^ (f.sb - c.log2) →
      (packRounded (decide (n < 0)) q (e - f.sb) : Fl f) =
        pack (decide (n < 0)) (c.log2 + i + f.bias - j) (c * 2 ^ (f.sb - c.log2) - 2 ^ f.sb) := by
    intro q hq
    subst hq
    rw [packRounded_normal _ _ _ hq1 hq2 (by omega)]
    congr 1
    omega
  apply hpack
  by_cases hk0 : e - (f.sb : Int) ≥ 0
  · rw [ite_eq_left_iff.mpr fun h => absurd hk0 h]
    dsimp only
    have h1 : n.natAbs = c * 2 ^ (f.sb - c.log2) * (2 ^ j * 2 ^ (e - f.sb).toNat) := by
      rw [hn, Nat.mul_assoc, ← Nat.pow_add, ← Nat.pow_add]
      congr 2
      omega
    rw [h1, roundQuotient_exact _ _ (Nat.mul_pos (Nat.two_pow_pos _) (Nat.two_pow_pos _))]
  · rw [ite_eq_right_iff.mpr fun h => absurd h hk0]
    dsimp only
    have h1 : n.natAbs * 2 ^ (-(e - f.sb)).toNat = c * 2 ^ (f.sb - c.log2) * 2 ^ j := by
      rw [hn]
      exact pow_mul_eq _ _ _ _ _ (by omega)
    rw [h1, roundQuotient_exact _ _ (Nat.two_pow_pos _)]

theorem pack_source (x : Fl f) : pack x.signbit x.expField x.frac = x := by
  calc
    pack x.signbit x.expField x.frac = Fl.ofBits x.toBits := by
      unfold pack floatCheckFlPack
      apply congrArg Fl.ofBits
      rw [(bits_split x).1, floatCheckFlExpMagnitude, floatCheckFlFracMagnitude]
      have h := Nat.div_add_mod x.magnitude (2^f.sb)
      rw [Nat.mul_comm (2^f.sb)] at h
      rw [h]
    _ = x := floatCheckFlOfBitsRoundtrip x

theorem finite_dyadic (hf : Good f) (x : Fl f) (hx : x.isfinite = true) :
    ∃ m i j : Nat,
      x.toRat = ((if x.signbit then -((m*2^i : Nat) : Int) else ((m*2^i : Nat) : Int)), 2^j) ∧
      m < 2^(f.sb+1) ∧
      (m ≠ 0 → j+1 ≤ m.log2+i+f.bias+f.sb ∧ m.log2+i ≤ j+f.bias) := by
  have hP := Nat.two_pow_pos f.sb
  have hb := hf.bias_pos
  have hs := hf.sb_pos
  have hE := hf.emax_eq
  have hS := hf.emax_succ
  have hM := (bits_split x).2
  have hfin : x.magnitude / 2^f.sb ≠ f.emax := by
    simpa only [Fl.isfinite, bne_iff_ne, floatCheckFlExpMagnitude] using hx
  have hdiv : x.magnitude / 2^f.sb < 2^f.eb := by
    apply Nat.div_lt_of_lt_mul
    rw [← Nat.pow_add, Nat.add_comm]
    exact hM
  have hr := Nat.mod_lt x.magnitude hP
  have hpow : 2^(f.sb+1) = 2*2^f.sb := by rw [Nat.pow_succ, Nat.mul_comm]
  unfold Fl.toRat
  rw [floatCheckFlExpMagnitude, floatCheckFlFracMagnitude]
  simp only [hx, Bool.not_true, Bool.false_eq_true, ↓reduceIte, beq_iff_eq]
  generalize x.signbit = s
  generalize x.magnitude / 2^f.sb = e at *
  generalize x.magnitude % 2^f.sb = r at *
  rcases Nat.eq_zero_or_pos e with he | he
  · subst e
    refine ⟨r, 0, f.bias+f.sb-1, ?_, by omega, ?_⟩
    · simp only [↓reduceIte, Nat.add_zero]
      split
      · omega
      · refine Prod.ext ?_ ?_
        · cases s <;> simp only [Bool.false_eq_true, ↓reduceIte, Nat.pow_zero, Nat.mul_one]
        · apply congrArg (fun v : Nat => 2^v)
          omega
    · intro hr0
      have := (Nat.log2_lt hr0).mpr hr
      omega
  · have he0 : e ≠ 0 := by omega
    have hne : r+2^f.sb ≠ 0 := by omega
    have hl1 : (r+2^f.sb).log2 < f.sb+1 := (Nat.log2_lt hne).mpr (by omega)
    have hl2 : f.sb ≤ (r+2^f.sb).log2 := (Nat.le_log2 hne).mpr (by omega)
    simp only [he0, ↓reduceIte]
    split
    · rename_i hp
      refine ⟨r+2^f.sb, e-f.bias-f.sb, 0, ?_, by omega, fun _ => by omega⟩
      have ht : ((e : Int)-f.bias-f.sb).toNat = e-f.bias-f.sb := by omega
      rw [ht]
      refine Prod.ext ?_ rfl
      cases s <;> simp only [Bool.false_eq_true, ↓reduceIte, Int.natCast_mul, Int.neg_mul]
    · rename_i hp
      refine ⟨r+2^f.sb, 0, f.bias+f.sb-e, ?_, by omega, fun _ => by omega⟩
      refine Prod.ext ?_ ?_
      · cases s <;> simp only [Bool.false_eq_true, ↓reduceIte, Nat.pow_zero, Nat.mul_one]
      · apply congrArg (fun v : Nat => 2^v)
        omega

def signed (s : Bool) (m : Nat) : Int := if s then -(m : Int) else (m : Int)

theorem signed_mul (s : Bool) (m d : Nat) : signed s m * (d : Int) = signed s (m*d) := by
  cases s <;> simp only [signed, Bool.false_eq_true, ↓reduceIte, Int.natCast_mul, Int.neg_mul]

theorem signed_abs (n : Int) : n = signed (decide (n < 0)) n.natAbs := by
  rcases Int.natAbs_eq n with h | h <;>
    by_cases hs : n < 0 <;> simp only [signed, hs, decide_true, decide_false, Bool.false_eq_true, ↓reduceIte] <;> omega

theorem roundRat_normal_value (hf : Good f) (n : Int) (c i j : Nat) (z : Bool)
    (hn : n.natAbs = c*2^i) (hc0 : 1 ≤ c) (hc1 : c < 2^(f.sb+1))
    (hlo : j+1 ≤ c.log2+i+f.bias) (hhi : c.log2+i+f.bias < j+f.emax) :
    let x := (Fl.roundRat n (2^j) z : Fl f)
    x.isfinite = true ∧ x.toRat.1 * ((2^j : Nat) : Int) = n*(x.toRat.2 : Int) := by
  dsimp only
  let M := c*2^(f.sb-c.log2)
  let E := c.log2+i+f.bias-j
  obtain ⟨hlog, hMlo, hMhi⟩ := sig_bounds (f := f) c (by omega) hc1
  have hElo : 1 ≤ E := by dsimp only [E]; omega
  have hEhi : E < f.emax := by dsimp only [E]; omega
  have hEB : E < 2^f.eb := by have := hf.emax_succ; omega
  have hR : M-2^f.sb < 2^f.sb := by
    have hp : 2^(f.sb+1) = 2*2^f.sb := by rw [Nat.pow_succ, Nat.mul_comm]
    dsimp only [M]
    omega
  have hr := roundRat_normal hf n c i j z hn hc0 hc1 hlo hhi
  change Fl.roundRat n (2^j) z = (pack (decide (n<0)) E (M-2^f.sb) : Fl f) at hr
  rw [hr]
  have parts := floatCheckFlPackParts (f := f) (decide (n<0)) E (M-2^f.sb) hEB hR
  have hfin : (pack (decide (n<0)) E (M-2^f.sb) : Fl f).isfinite = true := by
    rw [Fl.isfinite, parts.2.1, bne_iff_ne]
    omega
  refine ⟨hfin, ?_⟩
  have hMsum : M-2^f.sb+2^f.sb = M := by dsimp only [M]; omega
  have hN : n = signed (decide (n<0)) (c*2^i) := by rw [← hn]; exact signed_abs n
  unfold Fl.toRat
  simp only [hfin, Bool.not_true, Bool.false_eq_true, ↓reduceIte,
    parts.1, parts.2.1, parts.2.2, beq_eq_false_iff_ne.mpr (show E ≠ 0 by omega), hMsum]
  by_cases hp : (E : Int)-f.bias-f.sb ≥ 0
  · simp only [hp, ↓reduceIte, Int.natCast_one, Int.mul_one]
    change signed (decide (n<0)) M * ((2^((E : Int)-f.bias-f.sb).toNat : Nat) : Int) *
      ((2^j : Nat) : Int) = n
    rw [signed_mul, signed_mul]
    conv => rhs; rw [hN]
    apply congrArg (signed (decide (n<0)))
    dsimp only [M]
    have hpow : (f.sb-c.log2)+((E : Int)-f.bias-f.sb).toNat+j = i := by
      dsimp only [E] at hp ⊢
      omega
    rw [Nat.mul_assoc, Nat.mul_assoc, ← Nat.pow_add, ← Nat.pow_add, ← Nat.add_assoc, hpow]
  · simp only [hp, ↓reduceIte]
    change signed (decide (n<0)) M * ((2^j : Nat) : Int) =
      n*((2^(-((E : Int)-f.bias-f.sb)).toNat : Nat) : Int)
    conv => rhs; rw [hN]
    rw [signed_mul, signed_mul]
    apply congrArg (signed (decide (n<0)))
    dsimp only [M]
    exact pow_mul_eq c (f.sb-c.log2) j i (-((E : Int)-f.bias-f.sb)).toNat (by
      dsimp only [E] at hp ⊢; omega)
theorem signed_natAbs (s : Bool) (m : Nat) : (signed s m).natAbs = m := by
  cases s <;> simp only [signed, Bool.false_eq_true, ↓reduceIte, Int.natAbs_neg, Int.natAbs_natCast]

theorem signed_negative (s : Bool) (m : Nat) (hm : 0 < m) : decide (signed s m < 0) = s := by
  cases s <;> simp only [signed, Bool.false_eq_true, ↓reduceIte, decide_eq_true_iff,
    decide_eq_false_iff_not] <;> omega

theorem roundRat_normal_signed (hf : Good f) (s : Bool) (c i j : Nat) (z : Bool)
    (hc0 : 1 ≤ c) (hc1 : c < 2^(f.sb+1))
    (hlo : j+1 ≤ c.log2+i+f.bias) (hhi : c.log2+i+f.bias < j+f.emax) :
    (Fl.roundRat (signed s (c*2^i)) (2^j) z : Fl f) =
      pack s (c.log2+i+f.bias-j) (c*2^(f.sb-c.log2)-2^f.sb) := by
  rw [roundRat_normal hf _ c i j z (signed_natAbs _ _) hc0 hc1 hlo hhi,
    signed_negative s _ (Nat.mul_pos (by omega) (Nat.two_pow_pos i))]

theorem roundRat_subnormal_signed (hf : Good f) (s : Bool) (c i j : Nat) (z : Bool)
    (hc0 : 0 < c) (hc1 : c < 2^f.sb) (hexp : j = i+f.bias+f.sb-1) :
    (Fl.roundRat (signed s (c*2^i)) (2^j) z : Fl f) = pack s 0 c := by
  have hb := hf.bias_pos
  have hs := hf.sb_pos
  have hem := hf.emax_eq
  have hc : c ≠ 0 := by omega
  have hnumpos := Nat.mul_pos hc0 (Nat.two_pow_pos i)
  have hnum : signed s (c*2^i) ≠ 0 := by
    have h := signed_natAbs s (c*2^i)
    intro hz
    rw [hz, Int.natAbs_zero] at h
    omega
  have hfloor : Fl.floorLog2Rat (signed s (c*2^i)).natAbs (2^j) =
      ((c.log2+i : Nat) : Int)-j := by
    rw [signed_natAbs, floorLog2Rat_pow _ j (by omega), log2_mul_pow c i hc]
  have hlog : c.log2 < f.sb := (Nat.log2_lt hc).mpr hc1
  unfold Fl.roundRat
  simp only [beq_eq_false_iff_ne.mpr (Nat.ne_of_gt (Nat.two_pow_pos j)),
    beq_eq_false_iff_ne.mpr hnum, Bool.false_eq_true, ↓reduceIte, hfloor]
  rw [ite_eq_right (show ¬ (((c.log2+i : Nat) : Int)-j ≥ (f.emax : Int)-f.bias) by omega),
    ite_eq_right (show ¬ (((c.log2+i : Nat) : Int)-j < -((f.bias : Int)+f.sb)-1) by omega)]
  have hk : max (((c.log2+i : Nat) : Int)-j-f.sb) (1-(f.bias : Int)-f.sb) =
      1-(f.bias : Int)-f.sb := by omega
  have hkneg : ¬ (1-(f.bias : Int)-f.sb ≥ 0) := by omega
  have hto : (-(1-(f.bias : Int)-f.sb)).toNat = f.bias+f.sb-1 := by omega
  rw [hk, ite_eq_right hkneg, signed_natAbs, hto]
  simp only [Prod.fst, Prod.snd]
  have hpower : c*2^i*2^(f.bias+f.sb-1) = c*2^j := by
    rw [Nat.mul_assoc, ← Nat.pow_add]
    have hj : i+(f.bias+f.sb-1) = j := by omega
    rw [hj]
  rw [hpower, roundQuotient_exact c (2^j) (Nat.two_pow_pos _), signed_negative s _ hnumpos]
  have hcarry : ¬ c ≥ 2^(f.sb+1) := by
    have hpow : 2^f.sb ≤ 2^(f.sb+1) := Nat.pow_le_pow_right (by decide) (by omega)
    omega
  unfold Fl.packRounded
  simp only [beq_eq_false_iff_ne.mpr hc, Bool.false_eq_true, ↓reduceIte,
    hcarry, show 1-(f.bias : Int)-f.sb+f.bias+f.sb = 1 by omega,
    show ¬ (1 : Int) ≥ (f.emax : Int) by omega, hc1]
  simp only [pack, floatCheckFlPack, Nat.zero_mul, Nat.zero_add]

theorem roundRat_toRat (hf : Good f) (x : Fl f) (hx : x.isfinite = true) :
    Fl.roundRat x.toRat.1 x.toRat.2 x.signbit = x := by
  have hb := hf.bias_pos
  have hs := hf.sb_pos
  have hexp : x.expField < f.emax := floatCheckFlFiniteExponent f x hx
  have hfrac : x.frac < 2^f.sb := Nat.mod_lt _ (Nat.two_pow_pos _)
  by_cases he0 : x.expField = 0
  · have hrat : x.toRat = (signed x.signbit x.frac, 2^(f.bias+f.sb-1)) := by
      unfold Fl.toRat
      simp only [hx, Bool.not_true, Bool.false_eq_true, ↓reduceIte, he0,
        beq_self_eq_true, Nat.add_zero,
        show ¬ (1-(f.bias : Int)-f.sb ≥ 0) by omega,
        show (-(1-(f.bias : Int)-f.sb)).toNat = f.bias+f.sb-1 by omega, signed]
    rw [hrat]
    dsimp only
    by_cases hz : x.frac = 0
    · have hn : signed x.signbit x.frac = 0 := by rw [hz]; cases x.signbit <;> rfl
      have hd : (2^(f.bias+f.sb-1) == 0) = false := beq_eq_false_iff_ne.mpr (Nat.ne_of_gt (Nat.two_pow_pos _))
      rw [hn]
      simp only [Fl.roundRat, hd, beq_self_eq_true, Bool.false_eq_true, ↓reduceIte]
      calc
        Fl.zero x.signbit = pack x.signbit x.expField x.frac := by
          simp only [pack, floatCheckFlPack, he0, hz, Nat.zero_mul, Nat.zero_add, Nat.add_zero, Fl.zero]
        _ = x := pack_source x
    · have hr := roundRat_subnormal_signed hf x.signbit x.frac 0 (f.bias+f.sb-1) x.signbit
        (by omega) hfrac (by omega)
      simp only [Nat.pow_zero, Nat.mul_one] at hr
      rw [hr, ← he0, pack_source]
  · let m := x.frac+2^f.sb
    have hmlo : 2^f.sb ≤ m := by dsimp only [m]; omega
    have hmhi : m < 2^(f.sb+1) := by
      have hp : 2^(f.sb+1) = 2*2^f.sb := by rw [Nat.pow_succ, Nat.mul_comm]
      dsimp only [m]
      omega
    have hmpos : 0 < m := Nat.lt_of_lt_of_le (Nat.two_pow_pos f.sb) hmlo
    have hlog : m.log2 = f.sb := by
      have h1 := (Nat.le_log2 (by omega : m ≠ 0)).mpr hmlo
      have h2 := (Nat.log2_lt (by omega : m ≠ 0)).mpr hmhi
      omega
    have hsub : m-2^f.sb = x.frac := by dsimp only [m]; omega
    by_cases hp : (x.expField : Int)-f.bias-f.sb ≥ 0
    · have hrat : x.toRat = (signed x.signbit (m*2^((x.expField : Int)-f.bias-f.sb).toNat), 1) := by
        unfold Fl.toRat
        simp only [hx, Bool.not_true, Bool.false_eq_true, ↓reduceIte,
          beq_eq_false_iff_ne.mpr he0, hp]
        change (signed x.signbit m * ((2^((x.expField : Int)-f.bias-f.sb).toNat : Nat) : Int), 1) = _
        rw [signed_mul]
      rw [hrat]
      dsimp only
      have hr := roundRat_normal_signed hf x.signbit m ((x.expField : Int)-f.bias-f.sb).toNat 0 x.signbit
        (by omega) hmhi (by rw [hlog]; omega) (by rw [hlog]; omega)
      simp only [Nat.pow_zero, hlog, Nat.sub_self, Nat.mul_one, Nat.sub_zero, hsub] at hr
      have hE : f.sb+((x.expField : Int)-f.bias-f.sb).toNat+f.bias = x.expField := by omega
      rw [hE] at hr
      rw [hr, pack_source]
    · have hrat : x.toRat = (signed x.signbit m, 2^(-((x.expField : Int)-f.bias-f.sb)).toNat) := by
        unfold Fl.toRat
        simp only [hx, Bool.not_true, Bool.false_eq_true, ↓reduceIte,
          beq_eq_false_iff_ne.mpr he0, hp]
        rfl
      rw [hrat]
      dsimp only
      have hr := roundRat_normal_signed hf x.signbit m 0 (-((x.expField : Int)-f.bias-f.sb)).toNat x.signbit
        (by omega) hmhi (by rw [hlog]; omega) (by rw [hlog]; omega)
      simp only [Nat.pow_zero, hlog, Nat.sub_self, Nat.mul_one, Nat.add_zero, hsub] at hr
      have hE : f.sb+f.bias-(-((x.expField : Int)-f.bias-f.sb)).toNat = x.expField := by omega
      rw [hE] at hr
      rw [hr, pack_source]
theorem widen_exact (hf : Good f) (hg : Good g) (hne : (g == f) = false)
    (hsb : f.sb ≤ g.sb) (hbias : f.bias+f.sb ≤ g.bias) (x : Fl f) (hx : x.isfinite = true) :
    (Fl.convert x : Fl g).isfinite = true ∧
      (Fl.convert x : Fl g).toRat.1 * (x.toRat.2 : Int) = x.toRat.1 * ((Fl.convert x : Fl g).toRat.2 : Int) := by
  have hgE := hg.emax_eq
  have hgB := hg.bias_pos
  have hgS := hg.sb_pos
  have hfB := hf.bias_pos
  have hfS := hf.sb_pos
  obtain ⟨hnan, hinf⟩ := floatCheckFlFiniteClasses f x hx
  unfold Fl.convert
  simp only [hne, hnan, hinf, Bool.false_eq_true, ↓reduceIte]
  obtain ⟨m, i, j, hrat, hm, hrange⟩ := finite_dyadic hf x hx
  rw [hrat]
  dsimp only
  by_cases hm0 : m = 0
  · subst m
    have hn : (if x.signbit then -((0*2^i : Nat) : Int) else ((0*2^i : Nat) : Int)) = 0 := by
      cases x.signbit <;> simp only [Bool.false_eq_true, ↓reduceIte, Nat.zero_mul, Int.natCast_zero, Int.neg_zero]
    rw [hn]
    have hd : (2^j == 0) = false := beq_eq_false_iff_ne.mpr (Nat.ne_of_gt (Nat.two_pow_pos _))
    simp only [Fl.roundRat, hd, beq_self_eq_true, Bool.false_eq_true, ↓reduceIte]
    have hz := floatCheckFlZeroBasics g (by omega) x.signbit
    exact ⟨hz.1, by rw [hz.2.2, Int.zero_mul, Int.zero_mul]⟩
  · obtain ⟨hlo, hhi⟩ := hrange hm0
    have hm1 : m < 2^(g.sb+1) := Nat.lt_of_lt_of_le hm (Nat.pow_le_pow_right (by decide) (by omega))
    exact roundRat_normal_value hg (signed x.signbit (m*2^i)) m i j x.signbit
      (signed_natAbs _ _) (by omega) hm1 (by omega) (by omega)

theorem convert_roundtrip (hf : Good f) (hg : Good g) (hne : (g == f) = false)
    (hsb : f.sb ≤ g.sb) (hbias : f.bias+f.sb ≤ g.bias) (x : Fl f) (hx : x.isfinite = true) :
    (Fl.convert (Fl.convert x : Fl g) : Fl f) = x := by
  let y := (Fl.convert x : Fl g)
  have hy := widen_exact hf hg hne hsb hbias x hx
  have hys : y.signbit = x.signbit := floatCheckFlConvertSign g f (by have := hg.sb_pos; omega)
    (by have h:=hg.emax_eq; have hb:=hg.bias_pos; omega) x
  have hne' : (f == g) = false := beq_eq_false_iff_ne.mpr (Ne.symm (beq_eq_false_iff_ne.mp hne))
  obtain ⟨hyn, hyi⟩ := floatCheckFlFiniteClasses g y hy.1
  obtain ⟨mx, ix, jx, hrx, _, _⟩ := finite_dyadic hf x hx
  obtain ⟨my, iy, jy, hry, _, _⟩ := finite_dyadic hg y hy.1
  have hdx : x.toRat.2 = 2^jx := congrArg Prod.snd hrx
  have hdy : y.toRat.2 = 2^jy := congrArg Prod.snd hry
  change (Fl.convert y : Fl f) = x
  unfold Fl.convert
  simp only [hne', hyn, hyi, Bool.false_eq_true, ↓reduceIte]
  have hr := floatCheckFlRoundRatDyadicEq f y.toRat.1 x.toRat.1 jy jx y.signbit (by
    rw [← hdx, ← hdy]; exact hy.2)
  rw [hdy, hr, ← hdx, hys, roundRat_toRat hf x hx]

theorem toRat_floor_lower (hf : Good f) (x : Fl f) (hx : x.isfinite = true)
    (hn : x.toRat.1 ≠ 0) : 1-(f.bias : Int)-f.sb ≤ Fl.floorLog2Rat x.toRat.1.natAbs x.toRat.2 := by
  obtain ⟨m, i, j, hr, hm, hbounds⟩ := finite_dyadic hf x hx
  have hm0 : m ≠ 0 := by
    intro h
    apply hn
    rw [hr, h]
    cases x.signbit <;> simp only [Bool.false_eq_true, ↓reduceIte, Nat.zero_mul, Int.natCast_zero, Int.neg_zero]
  obtain ⟨hlo, _⟩ := hbounds hm0
  rw [hr]
  change 1-(f.bias : Int)-f.sb ≤ Fl.floorLog2Rat (signed x.signbit (m*2^i)).natAbs (2^j)
  rw [signed_natAbs, floorLog2Rat_pow _ _ (Nat.mul_ne_zero hm0 (Nat.ne_of_gt (Nat.two_pow_pos i))),
    log2_mul_pow m i hm0]
  omega

end JuliaLean.ChatGPT.Batch10.Group1.SmallExact

