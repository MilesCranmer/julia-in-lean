theorem log_lower (n d a : Nat) (hn : n ≠ 0) (hd : d ≠ 0)
    (h : d ≤ n*2^a) : -(a : Int) ≤ fl2 n d := by
  have hb := floatCheckFloorLog2NormalizedNat n d hn hd
  change (if fl2 n d ≥ 0 then d*2^(fl2 n d).toNat ≤ n ∧
    n < 2*(d*2^(fl2 n d).toNat) else
    d ≤ n*2^(-fl2 n d).toNat ∧ n*2^(-fl2 n d).toNat < 2*d) at hb
  by_cases he : fl2 n d ≥ 0
  · omega
  · simp only [he, ↓reduceIte] at hb
    by_cases hg : -(a : Int) ≤ fl2 n d
    · exact hg
    · have hp := Nat.pow_le_pow_right (show 1 ≤ (2 : Nat) by decide)
        (show a+1 ≤ (-fl2 n d).toNat by omega)
      have hm := Nat.mul_le_mul_left n hp
      rw [Nat.pow_succ, ← Nat.mul_assoc] at hm
      omega

theorem pack_nonzero (s : Bool) (q : Nat) (k : Int) (hlo : 0 < q)
    (hhi : q ≤ 2^53) (hk : -1074 ≤ k) : F64.iszero (pk s q k) = false := by
  unfold pk
  simp only [beq_iff_eq, show q ≠ 0 by omega, ↓reduceIte]
  have hm0 : 0 < (if q ≥ 2^53 then q/2 else q) := by split <;> omega
  have hm1 : (if q ≥ 2^53 then q/2 else q) < 2^53 := by split <;> omega
  have he0 : 1 ≤ (if q ≥ 2^53 then k+1 else k)+1075 := by split <;> omega
  by_cases he : (if q ≥ 2^53 then k+1 else k)+1075 ≥ 2047
  · rw [ite_t he]
    cases s <;> decide
  · rw [ite_f he, iszero_f, tb_ofBits]
    by_cases hm : (if q ≥ 2^53 then q/2 else q) < 2^52
    · rw [ite_t hm]
      cases s <;> simp only [Bool.false_eq_true, ↓reduceIte] <;> omega
    · rw [ite_f hm]
      cases s <;> simp only [Bool.false_eq_true, ↓reduceIte] <;> omega

theorem round_nonzero (n : Int) (d : Nat) (s : Bool) (hd : 0 < d)
    (hn : (d : Nat) ≤ n.natAbs*2^1074) : F64.iszero (F64.roundRat n d s) = false := by
  have hn0 : n ≠ 0 := by intro he; simp only [he, Int.natAbs_zero, Nat.zero_mul] at hn; omega
  have hlog := log_lower n.natAbs d 1074 (by omega) (by omega) hn
  rw [roundRat_eq, ite_f (by simp only [beq_iff_eq]; omega),
    ite_f (by simp only [beq_iff_eq]; exact hn0)]
  split
  · cases decide (n < 0) <;> decide
  · rw [ite_f (by omega : ¬ (fl2 n.natAbs d < -1075))]
    apply pack_nonzero
    · by_cases hk : fl2 n.natAbs d-52 ≤ -1074
      · rw [Int.max_eq_right hk]
        change 0 < rq (n.natAbs*2^1074) d
        have hl := rq_lower_bound (n.natAbs*2^1074) d 1 hd (by simpa only [Nat.one_mul] using hn)
        omega
      · rw [Int.max_eq_left (by omega : -1074 ≤ fl2 n.natAbs d-52)]
        have hl := floatCheckFlScaledRoundedLower n.natAbs d 52 (by omega) (by omega)
        change 2^52 ≤ rq (if fl2 n.natAbs d-52 ≥ 0 then
          (n.natAbs,d*2^(fl2 n.natAbs d-52).toNat) else
          (n.natAbs*2^(-(fl2 n.natAbs d-52)).toNat,d)).1
          (if fl2 n.natAbs d-52 ≥ 0 then
          (n.natAbs,d*2^(fl2 n.natAbs d-52).toNat) else
          (n.natAbs*2^(-(fl2 n.natAbs d-52)).toNat,d)).2 at hl
        omega
    · exact floatCheckScaledRoundedBound n.natAbs d 52 (by omega) (by omega)
        _ (Int.le_max_left _ _)
    · exact Int.le_max_right _ _

theorem finite_of_classes (x : F64) (hn : F64.isnan x = false) (hi : F64.isinf x = false) :
    F64.isfinite x = true := by
  rw [isfinite_iff_not_nan_not_inf, hn, hi]
  rfl

theorem mul_not_nan (x y : F64) (hx : F64.isnan x = false)
    (hy : F64.isfinite y = true) (hyz : F64.iszero y = false) :
    F64.isnan (F64.mul x y) = false := by
  have hyn := Scalar.ProofMisc.finite_not_nan y hy
  have hyi := Scalar.ProofMisc.finite_not_inf y hy
  by_cases hxi : F64.isinf x = true
  · simp only [F64.mul, hx, hyn, hyi, hyz, hxi, Bool.false_eq_true,
      Bool.and_false, Bool.false_and, Bool.or_false, Bool.false_or, ↓reduceIte]
    cases F64.signbit x != F64.signbit y <;> decide
  · have hxi' : F64.isinf x = false := Bool.eq_false_iff.mpr hxi
    have hxf := finite_of_classes x hx hxi'
    rw [mul_fin x y hx hyn hxi' hyi]
    exact (floatCheckRoundRatClass _ _ _
      (Nat.ne_of_gt (Nat.mul_pos (toRat_den_pos x hxf) (toRat_den_pos y hy)))).1

theorem div_not_nan (x y : F64) (hx : F64.isfinite x = true)
    (hy : F64.isnan y = false) (hyz : F64.iszero y = false) :
    F64.isnan (F64.div x y) = false := by
  have hxn := Scalar.ProofMisc.finite_not_nan x hx
  have hxi := Scalar.ProofMisc.finite_not_inf x hx
  by_cases hyi : F64.isinf y = true
  · simp only [F64.div, hxn, hxi, hy, hyi, hyz, Bool.false_eq_true,
      Bool.and_false, Bool.false_and, Bool.or_false, Bool.false_or, ↓reduceIte]
    cases F64.signbit x != F64.signbit y <;> decide
  · have hyi' : F64.isinf y = false := Bool.eq_false_iff.mpr hyi
    have hyf := finite_of_classes y hy hyi'
    simp only [F64.div, hxn, hxi, hy, hyi', hyz, Bool.false_eq_true,
      Bool.and_false, Bool.false_and, Bool.or_false, Bool.false_or, ↓reduceIte]
    exact (floatCheckRoundRatClass _ _ _ (Nat.mul_ne_zero
      (Nat.ne_of_gt (toRat_den_pos x hx))
      (by have := toRat_fst_ne_zero y hyf hyz; omega))).1

theorem rational_minimum (x : F64) (hf : F64.isfinite x = true) (hz : F64.iszero x = false) :
    (F64.toRat x).2 ≤ (F64.toRat x).1.natAbs*2^1074 := by
  have hb := (iszero_f x).mp hz
  have he : 0 < magKey64 x := by
    unfold magKey64
    by_cases hE : F64.exponentField x = 0
    · simp only [hE, beq_self_eq_true, ↓reduceIte, Nat.zero_sub, Nat.pow_zero,
        Nat.mul_one, Nat.add_zero]
      unfold F64.exponentField at hE
      unfold F64.fraction
      omega
    · simp only [beq_iff_eq, hE, ↓reduceIte]
      exact Nat.mul_pos (by omega) (Nat.two_pow_pos _)
  have hk := congrArg Int.natAbs (key64_rat x hf)
  simp only [Int.natAbs_mul, Int.natAbs_natCast, key64_abs] at hk
  calc
    (F64.toRat x).2 ≤ magKey64 x*(F64.toRat x).2 := by
      have hh := Nat.mul_le_mul_right (F64.toRat x).2 he
      simpa only [Nat.one_mul] using hh
    _ = _ := hk.symm

theorem rational_sign (x : F64) (hf : F64.isfinite x = true) (hn : (F64.toRat x).1 ≠ 0) :
    F64.signbit x = decide ((F64.toRat x).1 < 0) := by
  have hh := floatCheckFlRatSign double (Fl.ofF64 x)
    (by rw [(floatCheckFlOfF64Classes x).1]; exact hf)
    (by rw [floatCheckFlOfF64Rat]; exact hn)
  rw [(floatCheckFlOfF64Classes x).2.2.2.1, floatCheckFlOfF64Rat] at hh
  exact hh.symm

theorem rational_sign_weak (x : F64) (hf : F64.isfinite x = true) :
    (F64.signbit x = true → (F64.toRat x).1 ≤ 0) ∧
    (F64.signbit x = false → 0 ≤ (F64.toRat x).1) := by
  by_cases hn : (F64.toRat x).1 = 0
  · rw [hn]
    exact ⟨fun _ => Int.le_refl _, fun _ => Int.le_refl _⟩
  · rw [rational_sign x hf hn]
    simp only [decide_eq_true_eq, decide_eq_false_iff_not]
    constructor <;> omega

theorem fma_same_nonzero (x y z : F64)
    (hx : F64.isfinite x = true) (hy : F64.isfinite y = true)
    (hz : F64.isfinite z = true) (hz0 : F64.iszero z = false)
    (hs : (0 ≤ (F64.toRat x).1*(F64.toRat y).1 ∧ 0 ≤ (F64.toRat z).1) ∨
      ((F64.toRat x).1*(F64.toRat y).1 ≤ 0 ∧ (F64.toRat z).1 ≤ 0)) :
    F64.isnan (F64.fma x y z) = false ∧ F64.iszero (F64.fma x y z) = false := by
  have hdx := toRat_den_pos x hx
  have hdy := toRat_den_pos y hy
  have hdz := toRat_den_pos z hz
  have hdxy := Nat.mul_pos hdx hdy
  have hN : (F64.toRat z).1.natAbs*((F64.toRat x).2*(F64.toRat y).2) ≤
      ((F64.toRat x).1*(F64.toRat y).1*((F64.toRat z).2 : Int) +
        (F64.toRat z).1*((F64.toRat x).2*(F64.toRat y).2 : Nat)).natAbs := by
    have hab : ((F64.toRat z).1*((F64.toRat x).2*(F64.toRat y).2 : Nat)).natAbs =
        (F64.toRat z).1.natAbs*((F64.toRat x).2*(F64.toRat y).2) := by
      rw [Int.natAbs_mul, Int.natAbs_natCast]
    rw [← hab]
    rcases hs with ⟨hp, hq⟩ | ⟨hp, hq⟩
    · have hP := Int.mul_nonneg hp (Int.natCast_nonneg (F64.toRat z).2)
      have hQ := Int.mul_nonneg hq (Int.natCast_nonneg ((F64.toRat x).2*(F64.toRat y).2))
      omega
    · have hP := Int.mul_nonpos_of_nonpos_of_nonneg hp (Int.natCast_nonneg (F64.toRat z).2)
      have hQ := Int.mul_nonpos_of_nonpos_of_nonneg hq (Int.natCast_nonneg ((F64.toRat x).2*(F64.toRat y).2))
      omega
  have hmin := rational_minimum z hz hz0
  have hmin' := Nat.mul_le_mul_left ((F64.toRat x).2*(F64.toRat y).2) hmin
  have hN' := Nat.mul_le_mul_right (2^1074) hN
  have hbound : (F64.toRat x).2*(F64.toRat y).2*(F64.toRat z).2 ≤
      ((F64.toRat x).1*(F64.toRat y).1*((F64.toRat z).2 : Int) +
        (F64.toRat z).1*((F64.toRat x).2*(F64.toRat y).2 : Nat)).natAbs*2^1074 := by
    simp only [Nat.mul_assoc, Nat.mul_comm, Nat.mul_left_comm] at hmin' hN' ⊢
    exact Nat.le_trans hmin' hN'
  simp only [F64.fma, Scalar.ProofMisc.finite_not_nan x hx,
    Scalar.ProofMisc.finite_not_nan y hy, Scalar.ProofMisc.finite_not_nan z hz,
    Scalar.ProofMisc.finite_not_inf x hx, Scalar.ProofMisc.finite_not_inf y hy,
    Scalar.ProofMisc.finite_not_inf z hz, Bool.false_eq_true, Bool.false_and,
    Bool.and_false, Bool.false_or, Bool.or_false, ↓reduceIte]
  exact ⟨(floatCheckRoundRatClass _ _ _ (Nat.ne_of_gt (Nat.mul_pos hdxy hdz))).1,
    round_nonzero _ _ _ (Nat.mul_pos hdxy hdz) hbound⟩

theorem magnitude_rat_order (x y : F64) (hx : F64.isfinite x = true)
    (hy : F64.isfinite y = true) (hb : F64.toBits x % 2^63 ≤ F64.toBits y % 2^63) :
    (F64.toRat x).1.natAbs*(F64.toRat y).2 ≤
      (F64.toRat y).1.natAbs*(F64.toRat x).2 := by
  have hmag : magKey64 x ≤ magKey64 y := by
    rw [magKey64_eq, magKey64_eq]
    rcases Nat.lt_or_eq_of_le hb with hb | hb
    · exact Nat.le_of_lt (Scalar.KeyOrder.magKey_strictMono double hb)
    · rw [hb]
      exact Nat.le_refl _
  have hax := congrArg Int.natAbs (key64_rat x hx)
  have hay := congrArg Int.natAbs (key64_rat y hy)
  simp only [Int.natAbs_mul, Int.natAbs_natCast, key64_abs] at hax hay
  apply Nat.le_of_mul_le_mul_right (c := 2^1074) _ (Nat.two_pow_pos _)
  rw [Nat.mul_right_comm, hax, Nat.mul_assoc]
  rw [Nat.mul_right_comm _ _ (2^1074), hay]
  have hm := Nat.mul_le_mul_right ((F64.toRat x).2*(F64.toRat y).2) hmag
  simpa only [Nat.mul_assoc, Nat.mul_comm, Nat.mul_left_comm] using hm

theorem div_raw (x y : F64) (hx : F64.isfinite x = true)
    (hy : F64.isfinite y = true) (hz : F64.iszero y = false) :
    F64.div x y = F64.roundRat
      (if (F64.toRat y).1 < 0 then -((F64.toRat x).1*((F64.toRat y).2 : Int))
        else (F64.toRat x).1*((F64.toRat y).2 : Int))
      ((F64.toRat x).2*(F64.toRat y).1.natAbs) (F64.signbit x != F64.signbit y) := by
  simp only [F64.div, Scalar.ProofMisc.finite_not_nan x hx,
    Scalar.ProofMisc.finite_not_nan y hy, Scalar.ProofMisc.finite_not_inf x hx,
    Scalar.ProofMisc.finite_not_inf y hy, hz, Bool.false_eq_true,
    Bool.and_false, Bool.false_and, Bool.or_false, Bool.false_or, ↓reduceIte]

theorem div_finite_bound (x y : F64) (b : Nat) (hx : F64.isfinite x = true)
    (hy : F64.isfinite y = true) (hz : F64.iszero y = false) (hb : b ≤ 1022)
    (hm : (F64.toRat x).1.natAbs*(F64.toRat y).2 ≤
      ((F64.toRat x).2*(F64.toRat y).1.natAbs)*2^b) :
    F64.isfinite (F64.div x y) = true := by
  rw [div_raw x y hx hy hz]
  apply floatUpperRoundRatFinite _ _ b
  · exact Nat.mul_ne_zero (Nat.ne_of_gt (toRat_den_pos x hx))
      (by have := toRat_fst_ne_zero y hy hz; omega)
  · exact hb
  · split <;> simpa only [Int.natAbs_neg, Int.natAbs_mul, Int.natAbs_natCast] using hm

theorem div_sign (x y : F64) (hx : F64.isfinite x = true)
    (hy : F64.isfinite y = true) (hz : F64.iszero y = false) :
    F64.signbit (F64.div x y) = (F64.signbit x != F64.signbit y) := by
  rw [div_raw x y hx hy hz, (floatCheckRoundRatClass _ _ _
    (Nat.mul_ne_zero (Nat.ne_of_gt (toRat_den_pos x hx))
      (by have := toRat_fst_ne_zero y hy hz; omega))).2]
  let N := if (F64.toRat y).1 < 0 then -((F64.toRat x).1*((F64.toRat y).2 : Int))
    else (F64.toRat x).1*((F64.toRat y).2 : Int)
  change (if N = 0 then F64.signbit x != F64.signbit y else decide (N < 0)) = _
  by_cases hnum : N = 0
  · rw [ite_t hnum]
  · rw [ite_f hnum]
    have hn : (F64.toRat x).1 ≠ 0 := by
      intro hzero
      apply hnum
      simp only [N, hzero, Int.zero_mul, Int.neg_zero, ite_self]
    have hy0 := toRat_fst_ne_zero y hy hz
    rw [rational_sign x hx hn, rational_sign y hy hy0]
    have hd : (0 : Int) < ((F64.toRat y).2 : Int) := Int.natCast_pos.mpr (toRat_den_pos y hy)
    by_cases hxn : (F64.toRat x).1 < 0
    · have hp := Int.mul_neg_of_neg_of_pos hxn hd
      by_cases hyn : (F64.toRat y).1 < 0
      · simp only [N, hyn, hxn, ↓reduceIte, decide_true]
        change decide (-((F64.toRat x).1*((F64.toRat y).2 : Int)) < 0) = false
        exact decide_eq_false (by omega)
      · simp only [N, hyn, hxn, ↓reduceIte, decide_true, decide_false]
        exact decide_eq_true hp
    · have hp := Int.mul_pos (show 0 < (F64.toRat x).1 by omega) hd
      by_cases hyn : (F64.toRat y).1 < 0
      · simp only [N, hyn, hxn, ↓reduceIte, decide_true, decide_false]
        exact decide_eq_true (by omega)
      · simp only [N, hyn, hxn, ↓reduceIte, decide_false]
        exact decide_eq_false (by omega)

theorem robust_not_nan (c d : F64) (hc : F64.isfinite c = true)
    (hd : F64.isfinite d = true) (hc0 : F64.iszero c = false)
    (hr : F64.isfinite (F64.div d c) = true) :
    F64.isnan (robust_cinv c d).1 = false ∧ F64.isnan (robust_cinv c d).2 = false := by
  let r := F64.div d c
  have hrS : F64.signbit r = (F64.signbit d != F64.signbit c) := div_sign d c hd hc hc0
  have hcr := rational_sign_weak c hc
  have hdr := rational_sign_weak d hd
  have hrr := rational_sign_weak r hr
  have hsign : (0 ≤ (F64.toRat d).1*(F64.toRat r).1 ∧ 0 ≤ (F64.toRat c).1) ∨
      ((F64.toRat d).1*(F64.toRat r).1 ≤ 0 ∧ (F64.toRat c).1 ≤ 0) := by
    cases hcs : F64.signbit c <;> cases hds : F64.signbit d
    · have hrs : F64.signbit r = false := by simpa only [hcs, hds, bne_self_eq_false, Bool.bne_false, Bool.false_bne, Bool.true_bne, Bool.bne_true, Bool.not_false, Bool.not_true] using hrS
      exact Or.inl ⟨Int.mul_nonneg (hdr.2 hds) (hrr.2 hrs), hcr.2 hcs⟩
    · have hrs : F64.signbit r = true := by simpa only [hcs, hds, bne_self_eq_false, Bool.bne_false, Bool.false_bne, Bool.true_bne, Bool.bne_true, Bool.not_false, Bool.not_true] using hrS
      exact Or.inl ⟨Int.mul_nonneg_of_nonpos_of_nonpos (hdr.1 hds) (hrr.1 hrs), hcr.2 hcs⟩
    · have hrs : F64.signbit r = true := by simpa only [hcs, hds, bne_self_eq_false, Bool.bne_false, Bool.false_bne, Bool.true_bne, Bool.bne_true, Bool.not_false, Bool.not_true] using hrS
      exact Or.inr ⟨Int.mul_nonpos_of_nonneg_of_nonpos (hdr.2 hds) (hrr.1 hrs), hcr.1 hcs⟩
    · have hrs : F64.signbit r = false := by simpa only [hcs, hds, bne_self_eq_false, Bool.bne_false, Bool.false_bne, Bool.true_bne, Bool.bne_true, Bool.not_false, Bool.not_true] using hrS
      exact Or.inr ⟨Int.mul_nonpos_of_nonpos_of_nonneg (hdr.1 hds) (hrr.2 hrs), hcr.1 hcs⟩
  have hz := fma_same_nonzero d r c hd hr hc hc0 hsign
  have hrn : F64.isfinite (F64.neg r) = true := by rw [isfinite_neg]; exact hr
  exact ⟨div_not_nan F64.one _ (by decide) hz.1 hz.2,
    div_not_nan (F64.neg r) _ hrn hz.1 hz.2⟩

theorem robust_ordered_not_nan (c d : F64) (hc : F64.isfinite c = true)
    (hd : F64.isfinite d = true) (hc0 : F64.iszero c = false)
    (horder : F64.toBits d % 2^63 ≤ F64.toBits c % 2^63) :
    F64.isnan (robust_cinv c d).1 = false ∧ F64.isnan (robust_cinv c d).2 = false := by
  apply robust_not_nan c d hc hd hc0
  apply div_finite_bound d c 0 hd hc hc0 (by decide)
  simpa only [Nat.pow_zero, Nat.mul_one, Nat.one_mul, Nat.mul_comm] using magnitude_rat_order d c hd hc horder


theorem log_upper_lt (n d b : Nat) (hn : 0 < n) (hd : 0 < d)
    (h : n < d*2^b) : fl2 n d < (b : Int) := by
  have hb := floatCheckFloorLog2NormalizedNat n d (by omega) (by omega)
  change (if fl2 n d ≥ 0 then d*2^(fl2 n d).toNat ≤ n ∧
    n < 2*(d*2^(fl2 n d).toNat) else
    d ≤ n*2^(-fl2 n d).toNat ∧ n*2^(-fl2 n d).toNat < 2*d) at hb
  by_cases hg : fl2 n d < (b : Int)
  · exact hg
  · have he : fl2 n d ≥ 0 := by omega
    rw [ite_t he] at hb
    have hp := Nat.pow_le_pow_right (show 1 ≤ (2 : Nat) by decide)
      (show b ≤ (fl2 n d).toNat by omega)
    have hh := Nat.mul_le_mul_left d hp
    omega

theorem rational_upper_strict (x : F64) (hf : F64.isfinite x = true) :
    (F64.toRat x).1.natAbs < (F64.toRat x).2*2^1024 := by
  have he : F64.exponentField x ≤ 2046 := by
    have he0 : F64.exponentField x ≠ 2047 := by simpa only [F64.isfinite, bne_iff_ne] using hf
    have he1 : F64.exponentField x < 2048 := Nat.mod_lt _ (by decide)
    omega
  have hm := Scalar.IntegerNearest.magKey64_lt_exp x
  have hp := Nat.pow_le_pow_right (show 1 ≤ (2 : Nat) by decide) he
  have hh := Nat.mul_le_mul_left (2^52) hp
  have hmag : magKey64 x < 2^2098 := by
    have hpow : (2^52 : Nat)*2^2046 = 2^2098 := by rw [← Nat.pow_add]
    rw [hpow] at hh
    omega
  have hr := congrArg Int.natAbs (key64_rat x hf)
  simp only [Int.natAbs_mul, Int.natAbs_natCast, key64_abs] at hr
  have hscaled := Nat.mul_lt_mul_of_pos_right hmag (toRat_den_pos x hf)
  rw [← hr] at hscaled
  have heq : (2^2098 : Nat)*(F64.toRat x).2 =
      ((F64.toRat x).2*2^1024)*2^1074 := by
    rw [Nat.mul_assoc, ← Nat.pow_add, Nat.mul_comm]
  rw [heq] at hscaled
  exact Nat.lt_of_mul_lt_mul_right hscaled

theorem rational_zero_iff (x : F64) (hf : F64.isfinite x = true) :
    (F64.toRat x).1 = 0 ↔ F64.iszero x = true := by
  have hh := floatCheckFlRatZeroIff double (Fl.ofF64 x)
    (by rw [(floatCheckFlOfF64Classes x).1]; exact hf)
  rw [floatCheckFlOfF64Rat, (floatCheckFlOfF64Classes x).2.2.1] at hh
  exact hh

def ProductRange (x v : F64) : Prop :=
  let n := (F64.toRat x).1*(F64.toRat v).1
  let d := (F64.toRat x).2*(F64.toRat v).2
  (n ≠ 0 → d ≤ n.natAbs*2^1075) ∧ n.natAbs < d*2^1023

theorem mul_range_finite (x v : F64) (hx : F64.isfinite x = true)
    (hv : F64.isfinite v = true) (hr : ProductRange x v) :
    F64.isfinite (F64.mul x v) = true := by
  rw [mul_fin x v (Scalar.ProofMisc.finite_not_nan x hx) (Scalar.ProofMisc.finite_not_nan v hv)
    (Scalar.ProofMisc.finite_not_inf x hx) (Scalar.ProofMisc.finite_not_inf v hv)]
  have hd := Nat.mul_pos (toRat_den_pos x hx) (toRat_den_pos v hv)
  by_cases hn : (F64.toRat x).1*(F64.toRat v).1 = 0
  · simp only [F64.roundRat, hn, beq_eq_false_iff_ne.mpr (by omega :
        (F64.toRat x).2*(F64.toRat v).2 ≠ 0), beq_self_eq_true,
        Bool.false_eq_true, ↓reduceIte]
    exact finite_zero _
  · exact (Scalar.RoundMono.round_grid _ _ _ hn hd
      (log_lower _ _ _ (by omega) (by omega) (hr.1 hn))
      (by have hh := log_upper_lt _ _ _ (by omega) hd hr.2; omega)).1

theorem mul_range_order (x y v : F64) (hx : F64.isfinite x = true)
    (hy : F64.isfinite y = true) (hv : F64.isfinite v = true)
    (hrx : ProductRange x v) (hry : ProductRange y v)
    (horder : F64.toBits x % 2^63 ≤ F64.toBits y % 2^63) :
    F64.toBits (F64.mul x v) % 2^63 ≤ F64.toBits (F64.mul y v) % 2^63 := by
  have hdx := Nat.mul_pos (toRat_den_pos x hx) (toRat_den_pos v hv)
  have hdy := Nat.mul_pos (toRat_den_pos y hy) (toRat_den_pos v hv)
  have hrat := magnitude_rat_order x y hx hy horder
  have hprod := Nat.mul_le_mul_right ((F64.toRat v).1.natAbs*(F64.toRat v).2) hrat
  have hprod' : ((F64.toRat x).1*(F64.toRat v).1).natAbs*
      ((F64.toRat y).2*(F64.toRat v).2) ≤
      ((F64.toRat y).1*(F64.toRat v).1).natAbs*((F64.toRat x).2*(F64.toRat v).2) := by
    simpa only [Int.natAbs_mul, Nat.mul_assoc, Nat.mul_comm, Nat.mul_left_comm] using hprod
  rw [mul_fin x v (Scalar.ProofMisc.finite_not_nan x hx) (Scalar.ProofMisc.finite_not_nan v hv)
      (Scalar.ProofMisc.finite_not_inf x hx) (Scalar.ProofMisc.finite_not_inf v hv),
    mul_fin y v (Scalar.ProofMisc.finite_not_nan y hy) (Scalar.ProofMisc.finite_not_nan v hv)
      (Scalar.ProofMisc.finite_not_inf y hy) (Scalar.ProofMisc.finite_not_inf v hv)]
  by_cases hn : (F64.toRat x).1*(F64.toRat v).1 = 0
  · simp only [F64.roundRat, hn, beq_eq_false_iff_ne.mpr (by omega :
        (F64.toRat x).2*(F64.toRat v).2 ≠ 0), beq_self_eq_true,
        Bool.false_eq_true, ↓reduceIte]
    have hz : F64.toBits (F64.zero (F64.signbit x != F64.signbit v)) % 2^63 = 0 := by
      cases F64.signbit x != F64.signbit v <;> decide
    rw [hz]
    exact Nat.zero_le _
  · have hm : (F64.toRat y).1*(F64.toRat v).1 ≠ 0 := by
      intro hm0
      rw [hm0, Int.natAbs_zero, Nat.zero_mul] at hprod'
      have hh := (Nat.mul_eq_zero.mp (Nat.eq_zero_of_le_zero hprod')).resolve_right (Nat.ne_of_gt hdy)
      exact hn (Int.natAbs_eq_zero.mp hh)
    exact Scalar.RoundMono.round_magnitude_monotone _ _ _ _ _ _ hn hm hdx hdy
      (log_lower _ _ _ (by omega) (by omega) (hrx.1 hn))
      (by have hh := log_upper_lt _ _ _ (by omega) hdx hrx.2; omega)
      (log_lower _ _ _ (by omega) (by omega) (hry.1 hm))
      (by have hh := log_upper_lt _ _ _ (by omega) hdy hry.2; omega) hprod'

theorem half_rat : F64.toRat Fl64.half = (((2^52 : Nat) : Int), 2^53) := by decide

def scaleUp : F64 := F64.ofBits 0x4680000000000000

theorem scaleUp_source : F64.div Fl64.two (F64.mul Fl64.eps Fl64.eps) = scaleUp := by decide

theorem scaleUp_rat : F64.toRat scaleUp = (((2^105 : Nat) : Int), 1) := by decide

theorem rational_le_one (x : F64) (hx : F64.isfinite x = true)
    (hb : F64.toBits x % 2^63 ≤ 0x3ff0000000000000) :
    (F64.toRat x).1.natAbs ≤ (F64.toRat x).2 := by
  have horder : F64.toBits x % 2^63 ≤ F64.toBits F64.one % 2^63 := hb
  have hh := magnitude_rat_order x F64.one hx (by decide) horder
  have hr : F64.toRat F64.one = (((2^52 : Nat) : Int), 2^52) := by decide
  rw [hr] at hh
  simp only [Prod.fst, Prod.snd, Int.natAbs_natCast] at hh
  apply Nat.le_of_mul_le_mul_right (c := 2^52) _ (Nat.two_pow_pos _)
  simpa only [Nat.mul_comm] using hh

theorem rational_ge_one (x : F64) (hx : F64.isfinite x = true)
    (hb : 0x3ff0000000000000 ≤ F64.toBits x % 2^63) :
    (F64.toRat x).2 ≤ (F64.toRat x).1.natAbs := by
  have horder : F64.toBits F64.one % 2^63 ≤ F64.toBits x % 2^63 := hb
  have hh := magnitude_rat_order F64.one x (by decide) hx horder
  have hr : F64.toRat F64.one = (((2^52 : Nat) : Int), 2^52) := by decide
  rw [hr] at hh
  simp only [Prod.fst, Prod.snd, Int.natAbs_natCast] at hh
  apply Nat.le_of_mul_le_mul_right (c := 2^52) _ (Nat.two_pow_pos _)
  simpa only [Nat.mul_comm] using hh

theorem half_product_range (x : F64) (hx : F64.isfinite x = true) : ProductRange x Fl64.half := by
  unfold ProductRange
  rw [half_rat]
  simp only [Prod.fst, Prod.snd, Int.natAbs_mul, Int.natAbs_natCast]
  constructor
  · intro hn
    have hxn : (F64.toRat x).1 ≠ 0 := by intro hz; apply hn; rw [hz, Int.zero_mul]
    have hxz : F64.iszero x = false := Bool.eq_false_iff.mpr
      (fun hz => hxn ((rational_zero_iff x hx).mpr hz))
    have hm := Nat.mul_le_mul_right (2^53) (rational_minimum x hx hxz)
    simpa only [Nat.mul_assoc, ← Nat.pow_add] using hm
  · have hm := Nat.mul_lt_mul_of_pos_right (rational_upper_strict x hx) (Nat.two_pow_pos 52)
    simpa only [Nat.mul_assoc, ← Nat.pow_add] using hm

theorem up_product_range (x : F64) (hx : F64.isfinite x = true)
    (hb : F64.toBits x % 2^63 ≤ 0x3ff0000000000000) : ProductRange x scaleUp := by
  unfold ProductRange
  rw [scaleUp_rat]
  simp only [Prod.fst, Prod.snd, Int.natAbs_mul, Int.natAbs_natCast, Nat.mul_one]
  constructor
  · intro hn
    have hxn : (F64.toRat x).1 ≠ 0 := by intro hz; apply hn; rw [hz, Int.zero_mul]
    have hxz : F64.iszero x = false := Bool.eq_false_iff.mpr
      (fun hz => hxn ((rational_zero_iff x hx).mpr hz))
    have hm := rational_minimum x hx hxz
    calc
      (F64.toRat x).2 ≤ (F64.toRat x).1.natAbs*2^1074 := hm
      _ ≤ _ := by
        rw [Nat.mul_assoc, ← Nat.pow_add]
        exact Nat.mul_le_mul_left _ (Nat.pow_le_pow_right (by decide) (by decide))
  · have hm := Nat.mul_le_mul_right (2^105) (rational_le_one x hx hb)
    exact Nat.lt_of_le_of_lt hm
      (Nat.mul_lt_mul_of_pos_left (Nat.pow_lt_pow_right (by decide) (by decide : 105 < 1023))
        (toRat_den_pos x hx))

theorem mul_nonzero_bound (x v : F64) (hx : F64.isfinite x = true)
    (hv : F64.isfinite v = true)
    (hb : (F64.toRat x).2*(F64.toRat v).2 ≤
      ((F64.toRat x).1*(F64.toRat v).1).natAbs*2^1074) : F64.iszero (F64.mul x v) = false := by
  rw [mul_fin x v (Scalar.ProofMisc.finite_not_nan x hx) (Scalar.ProofMisc.finite_not_nan v hv)
    (Scalar.ProofMisc.finite_not_inf x hx) (Scalar.ProofMisc.finite_not_inf v hv)]
  exact round_nonzero _ _ _ (Nat.mul_pos (toRat_den_pos x hx) (toRat_den_pos v hv)) hb

theorem half_nonzero_large (x : F64) (hx : F64.isfinite x = true)
    (hb : 0x3ff0000000000000 ≤ F64.toBits x % 2^63) : F64.iszero (F64.mul x Fl64.half) = false := by
  apply mul_nonzero_bound x Fl64.half hx (by decide)
  rw [half_rat]
  simp only [Prod.fst, Prod.snd, Int.natAbs_mul, Int.natAbs_natCast]
  calc
    (F64.toRat x).2*2^53 ≤ (F64.toRat x).1.natAbs*2^53 :=
      Nat.mul_le_mul_right _ (rational_ge_one x hx hb)
    _ ≤ _ := by
      rw [Nat.mul_assoc, ← Nat.pow_add]
      exact Nat.mul_le_mul_left _ (Nat.pow_le_pow_right (by decide) (by decide))

theorem up_nonzero (x : F64) (hx : F64.isfinite x = true) (hz : F64.iszero x = false) :
    F64.iszero (F64.mul x scaleUp) = false := by
  apply mul_nonzero_bound x scaleUp hx (by decide)
  rw [scaleUp_rat]
  simp only [Prod.fst, Prod.snd, Nat.mul_one, Int.natAbs_mul, Int.natAbs_natCast]
  calc
    (F64.toRat x).2 ≤ (F64.toRat x).1.natAbs*2^1074 := rational_minimum x hx hz
    _ ≤ _ := by
      rw [Nat.mul_assoc, ← Nat.pow_add]
      exact Nat.mul_le_mul_left _ (Nat.pow_le_pow_right (by decide) (by decide))

theorem fma_square_nonzero (x z : F64) (hx : F64.isfinite x = true)
    (hzn : F64.isnan z = false) (hzs : F64.signbit z = false)
    (hbound : (F64.toRat x).2*(F64.toRat x).2 ≤
      ((F64.toRat x).1.natAbs*(F64.toRat x).1.natAbs)*2^1074) :
    F64.isnan (F64.fma x x z) = false ∧ F64.iszero (F64.fma x x z) = false := by
  have hxn := Scalar.ProofMisc.finite_not_nan x hx
  have hxi := Scalar.ProofMisc.finite_not_inf x hx
  by_cases hzi : F64.isinf z = true
  · have hz : F64.fma x x z = z := by
      simp only [F64.fma, hxn, hxi, hzn, hzi, Bool.false_eq_true,
        Bool.false_and, Bool.and_false, Bool.or_false, Bool.false_or, ↓reduceIte]
    rw [hz]
    exact ⟨hzn, floatCheckInfNonzero z hzi⟩
  · have hzi' : F64.isinf z = false := Bool.eq_false_iff.mpr hzi
    have hzf := finite_of_classes z hzn hzi'
    have hdx := toRat_den_pos x hx
    have hdz := toRat_den_pos z hzf
    have hxx : 0 ≤ (F64.toRat x).1*(F64.toRat x).1 := by
      by_cases hs : 0 ≤ (F64.toRat x).1
      · exact Int.mul_nonneg hs hs
      · exact Int.mul_nonneg_of_nonpos_of_nonpos (by omega) (by omega)
    have hznum := (rational_sign_weak z hzf).2 hzs
    have hX := Int.mul_nonneg hxx (Int.natCast_nonneg (F64.toRat z).2)
    have hZ := Int.mul_nonneg hznum
      (Int.natCast_nonneg ((F64.toRat x).2*(F64.toRat x).2))
    have hab : ((F64.toRat x).1.natAbs*(F64.toRat x).1.natAbs)*(F64.toRat z).2 ≤
        ((F64.toRat x).1*(F64.toRat x).1*((F64.toRat z).2 : Int) +
          (F64.toRat z).1*((F64.toRat x).2*(F64.toRat x).2 : Nat)).natAbs := by
      have hh : ((F64.toRat x).1*(F64.toRat x).1*((F64.toRat z).2 : Int)).natAbs ≤
          ((F64.toRat x).1*(F64.toRat x).1*((F64.toRat z).2 : Int) +
            (F64.toRat z).1*((F64.toRat x).2*(F64.toRat x).2 : Nat)).natAbs := by omega
      simpa only [Int.natAbs_mul, Int.natAbs_natCast] using hh
    have hB := Nat.mul_le_mul_right (F64.toRat z).2 hbound
    have hA := Nat.mul_le_mul_right (2^1074) hab
    have hmin : (F64.toRat x).2*(F64.toRat x).2*(F64.toRat z).2 ≤
        ((F64.toRat x).1*(F64.toRat x).1*((F64.toRat z).2 : Int) +
          (F64.toRat z).1*((F64.toRat x).2*(F64.toRat x).2 : Nat)).natAbs*2^1074 := by
      simp only [Nat.mul_assoc, Nat.mul_comm, Nat.mul_left_comm] at hB hA ⊢
      exact Nat.le_trans hB hA
    simp only [F64.fma, hxn, hxi, hzn, hzi', Bool.false_eq_true,
      Bool.false_and, Bool.and_false, Bool.or_false, Bool.false_or, ↓reduceIte]
    have hd := Nat.mul_pos (Nat.mul_pos hdx hdx) hdz
    exact ⟨(floatCheckRoundRatClass _ _ _ (Nat.ne_of_gt hd)).1,
      round_nonzero _ _ _ hd hmin⟩

theorem fast_denominator (c d : F64) (hc : F64.isfinite c = true)
    (hd : F64.isfinite d = true) (hlo : 0x1ff0000000000000 ≤ F64.toBits c % 2^63) :
    F64.isnan (F64.muladd c c (F64.mul d d)) = false ∧
      F64.iszero (F64.muladd c c (F64.mul d d)) = false := by
  have hn := Scalar.ProofMisc.finite_not_nan d hd
  have hsquare := floatCheckSquareClass d
  apply fma_square_nonzero c (F64.mul d d) hc (hsquare.1.trans hn) (hsquare.2 hn)
  have he : 511 ≤ F64.exponentField c := by unfold F64.exponentField; omega
  have heU : F64.exponentField c ≤ 2046 := by
    have hnot : F64.exponentField c ≠ 2047 := by simpa only [F64.isfinite, bne_iff_ne] using hc
    have hh : F64.exponentField c < 2048 := Nat.mod_lt _ (by decide)
    omega
  have hrat := floatCheckFlNormalRatBounds double (Fl.ofF64 c)
    (by rw [(floatCheckFlOfF64Classes c).1]; exact hc)
    (by rw [(floatCheckFlOfF64Classes c).2.2.2.2]; omega) 512 1024
    (by rw [(floatCheckFlOfF64Classes c).2.2.2.2]; change -(512 : Int) ≤ (F64.exponentField c : Int)-1023; omega)
    (by rw [(floatCheckFlOfF64Classes c).2.2.2.2]; change (F64.exponentField c : Int)-1023+1 ≤ 1024; omega)
  rw [floatCheckFlOfF64Rat] at hrat
  have hsq := Nat.mul_le_mul hrat.2.1 hrat.2.1
  calc
    (F64.toRat c).2*(F64.toRat c).2 ≤
        ((F64.toRat c).1.natAbs*2^512)*((F64.toRat c).1.natAbs*2^512) := hsq
    _ = ((F64.toRat c).1.natAbs*(F64.toRat c).1.natAbs)*2^1024 := by
      rw [← show (2^512 : Nat)*2^512 = 2^1024 by rw [← Nat.pow_add]]
      simp only [Nat.mul_assoc, Nat.mul_comm, Nat.mul_left_comm]
    _ ≤ _ := Nat.mul_le_mul_left _ (Nat.pow_le_pow_right (by decide) (by decide))

theorem abs_finite (x : F64) (hx : F64.isfinite x = true) : F64.isfinite (F64.abs x) = true := by
  have he : F64.toBits x / 2^52 % 2048 ≠ 2047 := by
    simpa only [F64.isfinite, F64.exponentField, bne_iff_ne] using hx
  simp only [F64.isfinite, F64.exponentField, tb_abs, bne_iff_ne]
  omega

theorem abs_sign (x : F64) : F64.signbit (F64.abs x) = false := by
  rw [signbit_f, tb_abs]
  exact Nat.mod_lt _ (Nat.two_pow_pos _)

theorem mag_neg (x : F64) : F64.toBits (F64.neg x) % 2^63 = F64.toBits x % 2^63 := by
  rw [tb_neg]
  have hx := tb_lt x
  split <;> omega

theorem positive_lt_bits (x y : F64) (hxn : F64.isnan x = false)
    (hyn : F64.isnan y = false) (hxs : F64.signbit x = false) (hys : F64.signbit y = false) :
    F64.lt x y = true ↔ F64.toBits x < F64.toBits y := by
  have hxb := (signbit_f x).mp hxs
  have hyb := (signbit_f y).mp hys
  have hxf := (isnan_f x).mp hxn
  have hyf := (isnan_f y).mp hyn
  rw [lt_iff]
  constructor
  · intro hh
    omega
  · intro hh
    refine ⟨hxf, hyf, ?_, ?_⟩ <;> omega

theorem positive_le_bits (x y : F64) (hxn : F64.isnan x = false)
    (hyn : F64.isnan y = false) (hxs : F64.signbit x = false) (hys : F64.signbit y = false) :
    F64.le x y = true ↔ F64.toBits x ≤ F64.toBits y := by
  have hxb := (signbit_f x).mp hxs
  have hyb := (signbit_f y).mp hys
  have hlt := positive_lt_bits x y hxn hyn hxs hys
  simp only [F64.le, Bool.or_eq_true, hlt, F64.eq, hxn, hyn,
    Bool.not_false, Bool.true_and, Bool.or_eq_true, Bool.and_eq_true, beq_iff_eq,
    iszero_iff]
  omega

theorem abs_lt_bits (x y : F64) (hx : F64.isfinite x = true) (hy : F64.isfinite y = true) :
    F64.lt (F64.abs x) (F64.abs y) = true ↔ F64.toBits x % 2^63 < F64.toBits y % 2^63 := by
  rw [positive_lt_bits _ _ (Scalar.ProofMisc.finite_not_nan _ (abs_finite x hx))
    (Scalar.ProofMisc.finite_not_nan _ (abs_finite y hy)) (abs_sign x) (abs_sign y), tb_abs, tb_abs]

theorem abs_le_bits (x y : F64) (hx : F64.isfinite x = true) (hy : F64.isfinite y = true) :
    F64.le (F64.abs x) (F64.abs y) = true ↔ F64.toBits x % 2^63 ≤ F64.toBits y % 2^63 := by
  rw [positive_le_bits _ _ (Scalar.ProofMisc.finite_not_nan _ (abs_finite x hx))
    (Scalar.ProofMisc.finite_not_nan _ (abs_finite y hy)) (abs_sign x) (abs_sign y), tb_abs, tb_abs]

def finish (c d x y s : F64) : ComplexF64 :=
  let (p,q) := if F64.le (F64.abs d) (F64.abs c) then robust_cinv x y else
    let (q,p) := robust_cinv (F64.neg y) (F64.neg x)
    (p,q)
  ⟨F64.mul p s, F64.mul q s⟩

theorem finish_not_nan (c d x y s : F64) (hc : F64.isfinite c = true)
    (hd : F64.isfinite d = true) (hx : F64.isfinite x = true) (hy : F64.isfinite y = true)
    (hs : F64.isfinite s = true) (hs0 : F64.iszero s = false)
    (hleft : F64.toBits d % 2^63 ≤ F64.toBits c % 2^63 →
      F64.toBits y % 2^63 ≤ F64.toBits x % 2^63 ∧ F64.iszero x = false)
    (hright : F64.toBits c % 2^63 < F64.toBits d % 2^63 →
      F64.toBits x % 2^63 ≤ F64.toBits y % 2^63 ∧ F64.iszero y = false) :
    F64.isnan (finish c d x y s).re = false ∧ F64.isnan (finish c d x y s).im = false := by
  unfold finish
  by_cases h : F64.le (F64.abs d) (F64.abs c) = true
  · rw [ite_t h]
    have hb := hleft ((abs_le_bits d c hd hc).mp h)
    have hn := robust_ordered_not_nan x y hx hy hb.2 hb.1
    exact ⟨mul_not_nan _ s hn.1 hs hs0, mul_not_nan _ s hn.2 hs hs0⟩
  · rw [ite_f h]
    have hbo : F64.toBits c % 2^63 < F64.toBits d % 2^63 := by
      apply Nat.lt_of_not_ge
      intro hb
      exact h ((abs_le_bits d c hd hc).mpr hb)
    have hb := hright hbo
    have hn := robust_ordered_not_nan (F64.neg y) (F64.neg x)
      (by rw [isfinite_neg]; exact hy) (by rw [isfinite_neg]; exact hx)
      (by rw [iszero_neg]; exact hb.2) (by rw [mag_neg, mag_neg]; exact hb.1)
    exact ⟨mul_not_nan _ s hn.2 hs hs0, mul_not_nan _ s hn.1 hs hs0⟩

theorem nonzero_of_dominates (c d : F64)
    (hz : F64.iszero c = false ∨ F64.iszero d = false)
    (ho : F64.toBits d % 2^63 ≤ F64.toBits c % 2^63) : F64.iszero c = false := by
  rw [iszero_f]
  rcases hz with h | h
  · exact (iszero_f c).mp h
  · have hh := (iszero_f d).mp h
    omega

theorem finish_half (c d : F64) (hc : F64.isfinite c = true) (hd : F64.isfinite d = true)
    (hb : 0x3ff0000000000000 ≤ max (F64.toBits c % 2^63) (F64.toBits d % 2^63)) :
    F64.isnan (finish c d (F64.mul c Fl64.half) (F64.mul d Fl64.half) Fl64.half).re = false ∧
      F64.isnan (finish c d (F64.mul c Fl64.half) (F64.mul d Fl64.half) Fl64.half).im = false := by
  apply finish_not_nan c d _ _ _ hc hd
    (mul_range_finite c Fl64.half hc (by decide) (half_product_range c hc))
    (mul_range_finite d Fl64.half hd (by decide) (half_product_range d hd))
    (by decide) (by decide)
  · intro ho
    exact ⟨mul_range_order d c Fl64.half hd hc (by decide)
      (half_product_range d hd) (half_product_range c hc) ho,
      half_nonzero_large c hc (by rw [Nat.max_eq_left ho] at hb; exact hb)⟩
  · intro ho
    exact ⟨mul_range_order c d Fl64.half hc hd (by decide)
      (half_product_range c hc) (half_product_range d hd) (Nat.le_of_lt ho),
      half_nonzero_large d hd (by rw [Nat.max_eq_right (Nat.le_of_lt ho)] at hb; exact hb)⟩

theorem finish_up (c d : F64) (hc : F64.isfinite c = true) (hd : F64.isfinite d = true)
    (hz : F64.iszero c = false ∨ F64.iszero d = false)
    (hb : max (F64.toBits c % 2^63) (F64.toBits d % 2^63) ≤ 0x3ff0000000000000) :
    F64.isnan (finish c d (F64.mul c scaleUp) (F64.mul d scaleUp) scaleUp).re = false ∧
      F64.isnan (finish c d (F64.mul c scaleUp) (F64.mul d scaleUp) scaleUp).im = false := by
  have hbC : F64.toBits c % 2^63 ≤ 0x3ff0000000000000 := Nat.le_trans (Nat.le_max_left _ _) hb
  have hbD : F64.toBits d % 2^63 ≤ 0x3ff0000000000000 := Nat.le_trans (Nat.le_max_right _ _) hb
  apply finish_not_nan c d _ _ _ hc hd
    (mul_range_finite c scaleUp hc (by decide) (up_product_range c hc hbC))
    (mul_range_finite d scaleUp hd (by decide) (up_product_range d hd hbD))
    (by decide) (by decide)
  · intro ho
    exact ⟨mul_range_order d c scaleUp hd hc (by decide)
      (up_product_range d hd hbD) (up_product_range c hc hbC) ho,
      up_nonzero c hc (nonzero_of_dominates c d hz ho)⟩
  · intro ho
    exact ⟨mul_range_order c d scaleUp hc hd (by decide)
      (up_product_range c hc hbC) (up_product_range d hd hbD) (Nat.le_of_lt ho),
      up_nonzero d hd (nonzero_of_dominates d c hz.symm (Nat.le_of_lt ho))⟩

theorem finish_unscaled (c d : F64) (hc : F64.isfinite c = true) (hd : F64.isfinite d = true)
    (hz : F64.iszero c = false ∨ F64.iszero d = false) :
    F64.isnan (finish c d c d F64.one).re = false ∧ F64.isnan (finish c d c d F64.one).im = false := by
  apply finish_not_nan c d c d _ hc hd hc hd (by decide) (by decide)
  · intro ho
    exact ⟨ho, nonzero_of_dominates c d hz ho⟩
  · intro ho
    exact ⟨Nat.le_of_lt ho, nonzero_of_dominates d c hz.symm (Nat.le_of_lt ho)⟩

theorem inverse_not_nan (w : ComplexF64) (hc : F64.isfinite w.re = true)
    (hd : F64.isfinite w.im = true) (hz : F64.iszero w.re = false ∨ F64.iszero w.im = false) :
    match inverseF64 w with
    | .error _ => False
    | .ok v => F64.isnan v.re = false ∧ F64.isnan v.im = false := by
  let c := w.re
  let d := w.im
  let cd := if F64.lt (F64.abs d) (F64.abs c) then F64.abs c else F64.abs d
  let dc := if F64.lt (F64.abs d) (F64.abs c) then F64.abs d else F64.abs c
  have hcd : F64.isfinite cd = true := by dsimp only [cd]; split <;> first | exact abs_finite c hc | exact abs_finite d hd
  have hdc : F64.isfinite dc = true := by dsimp only [dc]; split <;> first | exact abs_finite c hc | exact abs_finite d hd
  have hcdS : F64.signbit cd = false := by dsimp only [cd]; split <;> exact abs_sign _
  have hcdB : F64.toBits cd = max (F64.toBits c % 2^63) (F64.toBits d % 2^63) := by
    dsimp only [cd]
    by_cases h : F64.lt (F64.abs d) (F64.abs c) = true
    · rw [ite_t h, tb_abs, Nat.max_eq_left (Nat.le_of_lt ((abs_lt_bits d c hd hc).mp h))]
    · rw [ite_f h, tb_abs, Nat.max_eq_right (by
        apply Nat.le_of_not_lt
        intro hlt
        exact h ((abs_lt_bits d c hd hc).mpr hlt))]
  have hpair : (if F64.lt (F64.abs d) (F64.abs c) then
      (F64.abs c,F64.abs d) else (F64.abs d,F64.abs c)) = (cd,dc) := by
    dsimp only [cd,dc]
    split <;> rfl
  rw [floatCheckInverseBridge]
  unfold inv_ComplexF64
  dsimp only [reim, real_Complex, imag_Complex]
  rw [floatCheckSqrtLo]
  dsimp only [bind, Except.bind, pure, Except.pure]
  rw [floatCheckSqrtHi]
  dsimp only [bind, Except.bind, pure, Except.pure]
  dsimp only [c,d] at hpair
  rw [hpair]
  change (match (show Jl ComplexF64 from if F64.le floatCheckLo cd && F64.le cd floatCheckHi then
      .ok (div_Complex_Real F64.div (conj_Complex F64.neg w) (F64.muladd cd cd (F64.mul dc dc)))
    else if F64.isinf c || F64.isinf d then
      .ok ⟨Fl64.copysign Fl64.pzero c, Fl64.flipsign Fl64.nzero d⟩
    else
      let bs := F64.div Fl64.two (F64.mul Fl64.eps Fl64.eps)
      let (x,y,s) := if F64.le (F64.div F64.floatmax Fl64.two) cd then
        (F64.mul c Fl64.half,F64.mul d Fl64.half,Fl64.half)
      else if F64.le cd (F64.div (F64.mul Fl64.two F64.floatmin) Fl64.eps) then
        (F64.mul c bs,F64.mul d bs,bs)
      else (c,d,F64.one)
      .ok (finish c d x y s)) with
    | .error _ => False
    | .ok v => F64.isnan v.re = false ∧ F64.isnan v.im = false)
  by_cases hf : (F64.le floatCheckLo cd && F64.le cd floatCheckHi) = true
  · rw [ite_t hf]
    have hconj : F64.le floatCheckLo cd = true ∧ F64.le cd floatCheckHi = true := by
      simpa only [Bool.and_eq_true] using hf
    have hlo := hconj.1
    have hlob : F64.toBits floatCheckLo ≤ F64.toBits cd :=
      (positive_le_bits _ _ (by decide) (Scalar.ProofMisc.finite_not_nan cd hcd) (by decide) hcdS).mp hlo
    have hmag : 0x1ff0000000000000 ≤ F64.toBits cd % 2^63 := by
      have hsign := (signbit_f cd).mp hcdS
      have hbits : F64.toBits floatCheckLo = 0x1ff6a09e667f3bcd := by decide
      rw [hbits] at hlob
      omega
    have hden := fast_denominator cd dc hcd hdc hmag
    exact ⟨div_not_nan c _ hc hden.1 hden.2,
      div_not_nan (F64.neg d) _ (by rw [isfinite_neg]; exact hd) hden.1 hden.2⟩
  · rw [ite_f hf]
    simp only [Scalar.ProofMisc.finite_not_inf c hc, Scalar.ProofMisc.finite_not_inf d hd,
      Bool.false_or, Bool.false_eq_true, ↓reduceIte, scaleUp_source]
    by_cases hhigh : F64.le (F64.div F64.floatmax Fl64.two) cd = true
    · rw [ite_t hhigh]
      apply finish_half c d hc hd
      have hb : F64.toBits (F64.div F64.floatmax Fl64.two) ≤ F64.toBits cd :=
        (positive_le_bits _ _ (by decide) (Scalar.ProofMisc.finite_not_nan cd hcd) (by decide) hcdS).mp hhigh
      rw [hcdB] at hb
      have hb0 : 0x3ff0000000000000 ≤ F64.toBits (F64.div F64.floatmax Fl64.two) := by decide
      exact Nat.le_trans hb0 hb
    · rw [ite_f hhigh]
      by_cases hlow : F64.le cd (F64.div (F64.mul Fl64.two F64.floatmin) Fl64.eps) = true
      · rw [ite_t hlow]
        apply finish_up c d hc hd hz
        have hb : F64.toBits cd ≤ F64.toBits (F64.div (F64.mul Fl64.two F64.floatmin) Fl64.eps) :=
          (positive_le_bits _ _ (Scalar.ProofMisc.finite_not_nan cd hcd) (by decide) hcdS (by decide)).mp hlow
        rw [hcdB] at hb
        have hb0 : F64.toBits (F64.div (F64.mul Fl64.two F64.floatmin) Fl64.eps) ≤ 0x3ff0000000000000 := by decide
        exact Nat.le_trans hb hb0
      · rw [ite_f hlow]
        exact finish_unscaled c d hc hd hz

end JuliaLean.ChatGPT.Batch10.Group1.Reciprocal

