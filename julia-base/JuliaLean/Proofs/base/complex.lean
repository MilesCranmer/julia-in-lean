theorem floatCheckSpacingPower (x : F64) :
    (Spacing64 x).1 * ((2^1074 : Nat) : Int) =
      ((2^(F64.exponentField x-1) : Nat) : Int) * (Spacing64 x).2 := by
  let p : Int := if F64.exponentField x = 0 then -1074 else (F64.exponentField x : Int)-1075
  have hs : Spacing64 x = if p ≥ 0 then (((2^p.toNat : Nat) : Int), (1 : Int))
