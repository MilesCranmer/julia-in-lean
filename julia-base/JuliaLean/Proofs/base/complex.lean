  have bkey : key64 b = ipow (p-d+1074).toNat := power_key (p-d) (by omega) (by omega)
  have neg_fin (x : F64) (hx : F64.isfinite x = true) : F64.isfinite (F64.neg x) = true := by
    rw [Scalar.ProofMisc.neg_isfinite, hx]
  have exact_residual (n : Int) (hn : n.natAbs ≤ 2^53) (s : Bool) :
      F64.isfinite (F64.roundRat (n*ipow (U+1074)) (2^2148) s) = true ∧
      key64 (F64.roundRat (n*ipow (U+1074)) (2^2148) s) = n*ipow U := by
    rw [round_key_scaled]
    apply round_exact_key_le n U s hn
