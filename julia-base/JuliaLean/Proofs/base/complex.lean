  have hw : F64.isfinite (F64.fma h h (F64.neg HH)) = true ∧
      key64 (F64.fma h h (F64.neg HH)) = cert.W*ipow U := by
    rw [fma_key_round h h _ hfin hfin (neg_fin HH hHH), key_neg, hkey, kHH]
    have hpowh : ipow (p+1022).toNat*ipow (p+1022).toNat = ipow (U+1074) :=
      ipow_mul _ _ _ (by omega)
    have hpowsq : ipow (cert.C+U)*ipow 1074 = ipow cert.C*ipow (U+1074) :=
      ipow_product _ _ _ _ (by omega)
    have heq : ((Q : Int)*ipow (p+1022).toNat)*((Q : Int)*ipow (p+1022).toNat)+
