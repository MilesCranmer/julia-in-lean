/-- Standard transformer interpretation with retained failure state and true
partiality.  No absent computation is replaced by a default Julia value. -/
abbrev RootM (E State A : Type) := ExceptT (Error E) (StateT State Option) A

structure RootReceipt (E State : Type) where
  label : String
  detail : String
  failure : Option (Error E)
  before : State
  after : State

abbrev RootWorld (E State : Type) := State × List (RootReceipt E State)

/-- Run each actual callee once; observing it adds no effects visible to the
callee.  The record retains exact exception identity and both boundary states. -/
def rootObserveInfo {E State A : Type} (label : String) (detail : A → String)
    (action : RootM E State A) : RootM E (RootWorld E State) A := fun (state, history) =>
  match action state with
  | none => none
  | some (outcome, final) =>
      let receipt : RootReceipt E State :=
        { label
          detail := match outcome with | .ok value => detail value | .error _ => ""
          failure := match outcome with | .ok _ => none | .error error => some error
          before := state, after := final }
      some (outcome, (final, history ++ [receipt]))

def rootObserve {E State A : Type} (label : String) (action : RootM E State A) :
    RootM E (RootWorld E State) A := rootObserveInfo label (fun _ => "") action

def RootStateChain {E State : Type} (initial final : State) : List (RootReceipt E State) → Prop
  | [] => final = initial
  | receipt :: rest => receipt.before = initial ∧ RootStateChain receipt.after final rest

/-- A completed recursive execution begins at its documented first external
call.  All mutation is accounted for by actual selected calls.  A selected
exception is terminal, keeps its identity and preserves its post-call state;
only explicitly listed native throw sites are admitted otherwise. -/
def RootRecursiveAudit {E State A : Type} (firstLabel : String)
    (lastLabels : List String)
    (localError : Error E → RootReceipt E State → Prop) (initial : State)
    (observed : Option (Except (Error E) A × RootWorld E State)) : Prop :=
  match observed with
  | none => True
  | some (outcome, (final, history)) =>
      RootStateChain initial final history ∧
      (∃ first rest, history = first :: rest ∧ first.label = firstLabel) ∧
      match outcome with
      | .ok _ =>
          (∀ receipt ∈ history, receipt.failure = none) ∧
          ∃ last, history.getLast? = some last ∧ last.label ∈ lastLabels
      | .error error =>
          ∃ earlier last, history = earlier ++ [last] ∧
            (∀ receipt ∈ earlier, receipt.failure = none) ∧
            (last.failure = some error ∨
              (last.failure = none ∧ localError error last))

def RootNoLocalError {E State : Type} (_ : Error E) (_ : RootReceipt E State) : Prop := False

def rootObservedParts {E State A : Type} (parts : ComponentOps (RootM E State) A) :
    ComponentOps (RootM E (RootWorld E State)) A where
  real := fun value => rootObserve "real" (parts.real value)
  imag := fun value => rootObserve "imag" (parts.imag value)

def rootObservedPredicates {E State A Other : Type}
    (ops : PredicateOps (RootM E State) A Other) :
    PredicateOps (RootM E (RootWorld E State)) A Other where
  isreal := match ops.isreal with
    | .inherited call => .inherited (fun value => rootObserveInfo "isreal" MiddlePredicateInfo (call value))
    | .selectedCustom call => .selectedCustom (fun value => rootObserveInfo "isreal" MiddlePredicateInfo (call value))
  isinteger := fun value => rootObserveInfo "isinteger" MiddlePredicateInfo (ops.isinteger value)
  isfinite := fun value => rootObserveInfo "isfinite" MiddlePredicateInfo (ops.isfinite value)
  isnan := fun value => rootObserveInfo "isnan" MiddlePredicateInfo (ops.isnan value)
  isinf := fun value => rootObserveInfo "isinf" MiddlePredicateInfo (ops.isinf value)
  iszero := fun value => rootObserveInfo "iszero" MiddlePredicateInfo (ops.iszero value)
  isone := fun value => rootObserveInfo "isone" MiddlePredicateInfo (ops.isone value)
  andOther := fun left right => rootObserveInfo "and" MiddlePredicateInfo (ops.andOther left right)
  orOther := fun left right => rootObserveInfo "or" MiddlePredicateInfo (ops.orOther left right)

