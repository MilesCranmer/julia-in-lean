/-- The installed partial-computation monad supplies the fixed-point order.
State is outside Except, so exceptions retain mutation; Option.none is divergence. -/
abbrev MiddleRuntime (E State : Type) := ExceptT E (StateT State Option)

/-- Change only the observer representation, not a callee's state, value,
exception, termination, or divergence. -/
def MiddleToRuntime {E State A : Type} (action : MiddleM E State A) : MiddleRuntime E State A :=
  fun state => match action.run state with
    | none => none
    | some (.error (error, final)) => some (.error error, final)
    | some (.ok (value, final)) => some (.ok value, final)

def MiddleRunRuntime {E State A : Type} (action : MiddleRuntime E State A) (state : State) :
    Option (Except (E × State) (A × State)) :=
  match action.run state with
  | none => none
  | some (.error error, final) => some (.error (error, final))
  | some (.ok value, final) => some (.ok (value, final))

def MiddleRuntimeObserve {E State A : Type} (label : String) (action : MiddleM E State A) :
    MiddleRuntime E (MiddleWorld E State) A := MiddleToRuntime (MiddleObserve label action)

def MiddleRuntimeParts {E State A : Type} (parts : ComponentOps (MiddleM E State) A)
    (realLabel : String := "real") (imagLabel : String := "imag") :
    ComponentOps (MiddleRuntime E (MiddleWorld E State)) A where
  real := fun z => MiddleRuntimeObserve realLabel (parts.real z)
  imag := fun z => MiddleRuntimeObserve imagLabel (parts.imag z)

/-- Totality describes an observed selected computation, not a correctness
law assumed of it.  The propositions below quantify all callees regardless. -/
def MiddleTotal {E State A : Type} (action : MiddleM E State A) : Prop :=
  ∀ state, ∃ outcome, action.run state = some outcome

def MiddlePartsTotal {E State A : Type} (parts : ComponentOps (MiddleM E State) A) : Prop :=
  (∀ z, MiddleTotal (parts.real z)) ∧ (∀ z, MiddleTotal (parts.imag z))

/-- A finite no-reentry body cannot manufacture divergence when all its selected
callees terminate.  Divergent callees and recursive classifications remain
within the quantified domain; there is no totality premise on the property. -/
def MiddleNoNewDivergence {A : Type} (finite : Prop) (observation : Option A) : Prop :=
  observation = none → ¬ finite

/-- A finite nested call tree is an observation witness, not an execution
algorithm or a supplied callback.  Leaves are distinct selected scalar calls. -/
inductive MiddlePairCallTree where
  | leaf
  | node (left right : MiddlePairCallTree)

/-- Independent source call-language for one coordinate query per scalar slot.
The labels can distinguish bswap, arithmetic, float, rounding and epsilon. -/
def MiddleUnaryHistory (scalar terminal : String) : MiddlePairCallTree → List String
  | .leaf => [scalar]
  | .node left right => ["real"] ++ MiddleUnaryHistory scalar terminal left ++
      ["imag"] ++ MiddleUnaryHistory scalar terminal right ++ [terminal]

def MiddleUnaryCompletePath (scalar terminal : String) (labels : List String) : Prop :=
  ∃ left right, labels = MiddleUnaryHistory scalar terminal (.node left right)

def MiddleBinaryHistory : MiddlePairCallTree → List String
  | .leaf => ["scalar"]
  | .node left right => ["realA", "realB"] ++ MiddleBinaryHistory left ++
      ["imagA", "imagB"] ++ MiddleBinaryHistory right ++ ["construct"]

def MiddleBinaryCompletePath (labels : List String) : Prop :=
  ∃ left right, labels = MiddleBinaryHistory (.node left right)

inductive MiddleQuadCallTree where
  | leaf
  | node (realReal imagImag realImag imagReal : MiddleQuadCallTree)

def MiddleMultiplyHistory : MiddleQuadCallTree → List String
  | .leaf => ["multiply"]
  | .node rr ii ri ir =>
      ["realA", "realB"] ++ MiddleMultiplyHistory rr ++
      ["imagA", "imagB"] ++ MiddleMultiplyHistory ii ++ ["subtract"] ++
      ["realA", "imagB"] ++ MiddleMultiplyHistory ri ++
      ["imagA", "realB"] ++ MiddleMultiplyHistory ir ++ ["add", "construct"]

def MiddleMultiplyCompletePath (labels : List String) : Prop :=
  ∃ rr ii ri ir, labels = MiddleMultiplyHistory (.node rr ii ri ir)

inductive MiddleEqualityCallTree where
  | leaf
  | node (left right : MiddleEqualityCallTree) (selectedAnd : Bool)

def MiddleEqualityHistory : MiddleEqualityCallTree → List String
  | .leaf => ["equal"]
  | .node left right selectedAnd =>
      ["realA", "realB"] ++ MiddleEqualityHistory left ++
      ["imagA", "imagB"] ++ MiddleEqualityHistory right ++
      (if selectedAnd then ["and"] else [])

def MiddleEqualityCompletePath (labels : List String) : Prop :=
  ∃ left right selectedAnd, labels = MiddleEqualityHistory (.node left right selectedAnd)

/-- Isequal's two selected leaf labels distinguish its Bool assertion sites. -/
def MiddleIsequalHistory (leafLabel : String) : MiddlePairCallTree → List String
  | .leaf => [leafLabel]
  | .node left right => ["real"] ++ MiddleIsequalHistory "first" left ++ ["zero", "imag"] ++
      MiddleIsequalHistory "second" right

def MiddleIsequalCompletePath (labels : List String) : Prop :=
  ∃ left right, labels = MiddleIsequalHistory "unused-root" (.node left right)

inductive MiddleMemberCallTree where
  | nonreal
  | selected
  | recursive (next : MiddleMemberCallTree)

def MiddleMemberHistory : MiddleMemberCallTree → List String
  | .nonreal => ["isreal"]
  | .selected => ["isreal", "real", "contains"]
  | .recursive next => ["isreal", "real"] ++ MiddleMemberHistory next

def MiddleMemberCompletePath (labels : List String) : Prop :=
  ∃ tree, labels = MiddleMemberHistory tree

/-- When every completed selected equality has a Bool result, no frame may
invoke the open & target.  A successful root then has the conjunction of all
leaf truths; these facts are independent of the recursive call-language budget. -/
def MiddleEqualityRecursiveTruth {E State Other : Type}
    (observation : Option (Except (E × MiddleWorld E State)
      (PredicateValue Other × MiddleWorld E State))) : Prop :=
  MiddleOutcomeCheck (fun outcome history =>
    let truths := MiddleDetails "equal" history
    if truths ≠ [] ∧ (∀ value ∈ truths, value = "true" ∨ value = "false") then
      MiddleDetails "and" history = [] ∧
      (match outcome with
       | .ok result => ∃ value : Bool, result = .boolean value ∧
           (value = true ↔ ∀ leaf ∈ truths, leaf = "true")
       | .error _ => True)
    else True) observation

/-- Every successful asserted comparison leaf is Bool, and the root result is
true exactly when every such leaf is true.  Recursive intermediate Bools do not
need a second assumed scalar correctness contract. -/
def MiddleIsequalRecursiveTruth {E State : Type}
    (observation : Option (Except ((Error E) × MiddleWorld (Error E) State)
      (Bool × MiddleWorld (Error E) State))) : Prop :=
  match observation with
  | some (.ok (answer, (_, history))) =>
      let calls := history.filter (fun call => call.label == "first" || call.label == "second")
      (∀ call ∈ calls, call.detail = "true" ∨ call.detail = "false") ∧
      (answer = true ↔ ∀ call ∈ calls, call.detail = "true")
  | _ => True

/-- Membership has only a recursive tail after the real query.  Therefore its
last false condition is the root's false return, a rejected condition is its
exact native error, and a true condition cannot be the final observed call. -/
def MiddleMembershipRecursiveGate {E State Other : Type}
    (observation : Option (Except ((Error E) × MiddleWorld (Error E) State)
      (PredicateValue Other × MiddleWorld (Error E) State))) : Prop :=
  MiddleOutcomeCheck (fun outcome history =>
    match (MiddleDetails "isreal" history).getLast? with
    | some "false" => outcome = .ok (.boolean false) ∧ (MiddleLabels history).getLast? = some "isreal"
    | some "rejected" => outcome = .error (.typeError "&& condition") ∧
        (MiddleLabels history).getLast? = some "isreal"
    | some "true" => (MiddleLabels history).getLast? ≠ some "isreal"
    | _ => True) observation

/-- Full unary methods retain the recursively nested two-slot call language.
Every selected getter, scalar or constructor remains arbitrary, and a failure
at any depth returns the precise callee exception and post-call state.
Invariant: base/complex.jl:242,290-291,297. -/
def MiddleUnaryRecursiveAudit : Prop :=
  ∀ (E State A Scalar Result : Type)
      (ops : UnaryConstructOps (MiddleM E State) A Scalar Result)
      (dispatch : UnaryRecursiveDispatch A Scalar Result)
      (parts : ComponentOps (MiddleM E State) A) (z : Complex A) (state : State),
    let observed : UnaryConstructOps (MiddleRuntime E (MiddleWorld E State)) A Scalar Result :=
      { scalar := fun value => MiddleRuntimeObserve "scalar" (ops.scalar value)
        construct := fun r i => MiddleRuntimeObserve "construct" (ops.construct r i) }
    let components := MiddleRuntimeParts parts
    let finite := (∀ a, dispatch.same a = none) ∧ MiddlePartsTotal parts ∧
      (∀ a, MiddleTotal (ops.scalar a)) ∧ (∀ r i, MiddleTotal (ops.construct r i))
    let check := fun observation =>
      MiddleAudit (MiddleUnaryCompletePath "scalar" "construct") MiddleNoLocalError state observation ∧
        MiddleNoNewDivergence finite observation
    check (MiddleRunRuntime (byteSwapComplexFull (monotoneBind := Lean.Order.instMonoBindExceptT (m := StateT (MiddleWorld E State) Option) (ε := E)) observed dispatch z components) (state, [])) ∧
    check (MiddleRunRuntime (positiveComplexFull (monotoneBind := Lean.Order.instMonoBindExceptT (m := StateT (MiddleWorld E State) Option) (ε := E)) observed dispatch z components) (state, [])) ∧
    check (MiddleRunRuntime (negativeComplexFull (monotoneBind := Lean.Order.instMonoBindExceptT (m := StateT (MiddleWorld E State) Option) (ε := E)) observed dispatch z components) (state, [])) ∧
    check (MiddleRunRuntime (negativeWrapComplexFull (monotoneBind := Lean.Order.instMonoBindExceptT (m := StateT (MiddleWorld E State) Option) (ε := E)) observed dispatch z components) (state, []))

/-- Full binary arithmetic retains the recursively nested two-slot language,
with both operand queries before each leaf or recursive operation.  All selected
failures at arbitrary depth preserve the actual exception and mutated state.
Invariant: base/complex.jl:292-293,298-299. -/
def MiddleBinaryRecursiveAudit : Prop :=
  ∀ (E State A B Scalar Result : Type)
      (ops : BinaryConstructOps (MiddleM E State) A B Scalar Result)
      (dispatch : BinaryRecursiveDispatch A B Scalar Result)
      (partsA : ComponentOps (MiddleM E State) A) (partsB : ComponentOps (MiddleM E State) B)
      (z : Complex A) (w : Complex B) (state : State),
    let observed : BinaryConstructOps (MiddleRuntime E (MiddleWorld E State)) A B Scalar Result :=
      { scalar := fun a b => MiddleRuntimeObserve "scalar" (ops.scalar a b)
        construct := fun r i => MiddleRuntimeObserve "construct" (ops.construct r i) }
    let a := MiddleRuntimeParts partsA "realA" "imagA"
    let b := MiddleRuntimeParts partsB "realB" "imagB"
    let finite := (∀ a b, dispatch.same a b = none) ∧
      MiddlePartsTotal partsA ∧ MiddlePartsTotal partsB ∧
      (∀ a b, MiddleTotal (ops.scalar a b)) ∧ (∀ r i, MiddleTotal (ops.construct r i))
    let check := fun observation => MiddleAudit MiddleBinaryCompletePath MiddleNoLocalError state observation ∧
      MiddleNoNewDivergence finite observation
    check (MiddleRunRuntime (addComplexFull (monotoneBind := Lean.Order.instMonoBindExceptT (m := StateT (MiddleWorld E State) Option) (ε := E)) observed dispatch z w a b) (state, [])) ∧
    check (MiddleRunRuntime (subtractComplexFull (monotoneBind := Lean.Order.instMonoBindExceptT (m := StateT (MiddleWorld E State) Option) (ε := E)) observed dispatch z w a b) (state, [])) ∧
    check (MiddleRunRuntime (addWrapComplexFull (monotoneBind := Lean.Order.instMonoBindExceptT (m := StateT (MiddleWorld E State) Option) (ε := E)) observed dispatch z w a b) (state, [])) ∧
    check (MiddleRunRuntime (subtractWrapComplexFull (monotoneBind := Lean.Order.instMonoBindExceptT (m := StateT (MiddleWorld E State) Option) (ε := E)) observed dispatch z w a b) (state, []))

/-- Every full multiplication frame queries all four product operands in
source order and finishes the real subtraction before either cross-product query.
Recursive product frames retain this language and arbitrary errors/state exactly.
Invariant: base/complex.jl:294-295,300-301. -/
def MiddleMultiplyRecursiveAudit : Prop :=
  ∀ (E State A B Product R I Result : Type)
      (ops : MultiplyConstructOps (MiddleM E State) A B Product R I Result)
      (dispatch : MultiplyRecursiveDispatch A B Product Result)
      (partsA : ComponentOps (MiddleM E State) A) (partsB : ComponentOps (MiddleM E State) B)
      (z : Complex A) (w : Complex B) (state : State),
    let observed : MultiplyConstructOps (MiddleRuntime E (MiddleWorld E State)) A B Product R I Result :=
      { multiply := fun a b => MiddleRuntimeObserve "multiply" (ops.multiply a b)
        subtract := fun a b => MiddleRuntimeObserve "subtract" (ops.subtract a b)
        add := fun a b => MiddleRuntimeObserve "add" (ops.add a b)
        construct := fun r i => MiddleRuntimeObserve "construct" (ops.construct r i) }
    let a := MiddleRuntimeParts partsA "realA" "imagA"
    let b := MiddleRuntimeParts partsB "realB" "imagB"
    let finite := (∀ a b, dispatch.same a b = none) ∧
      MiddlePartsTotal partsA ∧ MiddlePartsTotal partsB ∧
      (∀ a b, MiddleTotal (ops.multiply a b)) ∧ (∀ a b, MiddleTotal (ops.subtract a b)) ∧
      (∀ a b, MiddleTotal (ops.add a b)) ∧ (∀ r i, MiddleTotal (ops.construct r i))
    let check := fun observation => MiddleAudit MiddleMultiplyCompletePath MiddleNoLocalError state observation ∧
      MiddleNoNewDivergence finite observation
    check (MiddleRunRuntime (multiplyComplexFull (monotoneBind := Lean.Order.instMonoBindExceptT (m := StateT (MiddleWorld E State) Option) (ε := E)) observed dispatch z w a b) (state, [])) ∧
    check (MiddleRunRuntime (multiplyWrapComplexFull (monotoneBind := Lean.Order.instMonoBindExceptT (m := StateT (MiddleWorld E State) Option) (ε := E)) observed dispatch z w a b) (state, []))

/-- Full equality retains eager comparison order at every recursive frame,
with at most one selected & call per frame.  Arbitrary selected exceptions
at any depth keep their precise identity and post-call state.
Invariant: base/complex.jl:246. -/
def MiddleEqualityRecursiveAudit : Prop :=
  ∀ (E State A B Other : Type) (ops : EqualityOps (MiddleM E State) A B Other)
      (dispatch : EqualityRecursiveDispatch A B)
      (partsA : ComponentOps (MiddleM E State) A) (partsB : ComponentOps (MiddleM E State) B)
      (z : Complex A) (w : Complex B) (state : State),
    let observation := MiddleRunRuntime
        (equalComplexFull (monotoneBind := Lean.Order.instMonoBindExceptT (m := StateT (MiddleWorld E State) Option) (ε := E))
          ({ equal := fun a b => MiddleToRuntime (MiddleObserveInfo "equal" MiddlePredicateInfo (ops.equal a b))
             andOther := fun a b => MiddleRuntimeObserve "and" (ops.andOther a b) } :
            EqualityOps (MiddleRuntime E (MiddleWorld E State)) A B Other)
          dispatch z w (MiddleRuntimeParts partsA "realA" "imagA")
          (MiddleRuntimeParts partsB "realB" "imagB")) (state, [])
    MiddleAudit MiddleEqualityCompletePath MiddleNoLocalError state observation ∧
    MiddleEqualityRecursiveTruth observation ∧
    MiddleNoNewDivergence ((∀ a b, dispatch.same a b = none) ∧
      MiddlePartsTotal partsA ∧ MiddlePartsTotal partsB ∧
      (∀ a b, MiddleTotal (ops.equal a b)) ∧ (∀ a b, MiddleTotal (ops.andOther a b))) observation

/-- Full real-complex isequal preserves recursive getter/comparison/zero
order.  A local Bool assertion error ends immediately at its corresponding
selected comparison; external failures preserve their exact state at any depth.
Invariant: base/complex.jl:252. -/
def MiddleIsequalRecursiveAudit : Prop :=
  ∀ (E State R A Zero NotBool1 NotBool2 : Type)
      (ops : RealIsequalOps (MiddleM (Error E) State) R A Zero NotBool1 NotBool2)
      (dispatch : IsequalRecursiveDispatch R A Zero)
      (parts : ComponentOps (MiddleM (Error E) State) A)
      (z : R) (w : Complex A) (state : State),
    let observation := MiddleRunRuntime
        (isequalRealComplexFull (monotoneBind := Lean.Order.instMonoBindExceptT (m := StateT (MiddleWorld (Error E) State) Option) (ε := Error E)) (E := E)
          ({ first := fun a b => MiddleToRuntime (MiddleObserveInfo "first" MiddleCheckedInfo (ops.first a b))
             zero := fun a => MiddleRuntimeObserve "zero" (ops.zero a)
             second := fun a b => MiddleToRuntime (MiddleObserveInfo "second" MiddleCheckedInfo (ops.second a b)) } :
            RealIsequalOps (MiddleRuntime (Error E) (MiddleWorld (Error E) State))
              R A Zero NotBool1 NotBool2)
          dispatch z w (MiddleRuntimeParts parts)) (state, [])
    MiddleAudit MiddleIsequalCompletePath
      (fun error labels =>
        (error = .typeError "isequal(real)::Bool" ∧ labels.getLast? = some "first") ∨
        (error = .typeError "isequal(imag)::Bool" ∧ labels.getLast? = some "second")) state observation ∧
    MiddleIsequalRecursiveTruth observation ∧
    MiddleNoNewDivergence ((∀ a b, dispatch.first a b = none) ∧
      (∀ a b, dispatch.second a b = none) ∧ MiddlePartsTotal parts ∧
      (∀ a b, MiddleTotal (ops.first a b)) ∧ (∀ a, MiddleTotal (ops.zero a)) ∧
      (∀ a b, MiddleTotal (ops.second a b))) observation

/-- Every recursive membership frame checks its condition before querying
real.  A false condition returns without further calls; otherwise the history
continues with one selected or recursive range test.  Errors retain exact state.
Invariant: base/complex.jl:254. -/
def MiddleMembershipRecursiveAudit : Prop :=
  ∀ (E State A Range NotBool Other : Type)
      (ops : MembershipRecursiveOps (MiddleM (Error E) State) A Range NotBool Other)
      (parts : ComponentOps (MiddleM (Error E) State) A)
      (z : Complex A) (range : Range) (state : State),
    let observation := MiddleRunRuntime
        (memberComplexFull (monotoneBind := Lean.Order.instMonoBindExceptT (m := StateT (MiddleWorld (Error E) State) Option) (ε := Error E)) (E := E)
          ({ isreal := fun value => MiddleToRuntime (MiddleObserveInfo "isreal" MiddleCheckedInfo (ops.isreal value))
             contains := fun a r => MiddleRuntimeObserve "contains" (ops.contains a r)
             same := ops.same } :
            MembershipRecursiveOps (MiddleRuntime (Error E) (MiddleWorld (Error E) State))
              A Range NotBool Other)
          z range (MiddleRuntimeParts parts)) (state, [])
    MiddleAudit MiddleMemberCompletePath
      (fun error labels => error = .typeError "&& condition" ∧ labels.getLast? = some "isreal") state observation ∧
    MiddleMembershipRecursiveGate observation ∧
    MiddleNoNewDivergence ((∀ a r, ops.same a r = none) ∧ MiddlePartsTotal parts ∧
      (∀ z, MiddleTotal (ops.isreal z)) ∧ (∀ a r, MiddleTotal (ops.contains a r))) observation

/-- A tagged runtime witness with one custom Real atom and immutable Complex
values.  The input Complex has Real fields; the custom getter can return that
same whole Complex as its result without violating the stored-field invariant. -/
inductive MiddleRecursiveValue where
  | realAtom
  | complexValue (real imag : MiddleRecursiveValue)

def MiddleLoopValue : Complex MiddleRecursiveValue := ⟨.realAtom, .realAtom⟩

def MiddleDecodeComplex : MiddleRecursiveValue → Option (Complex MiddleRecursiveValue)
  | .realAtom => none
  | .complexValue r i => some ⟨r, i⟩

def MiddleLoopParts {m : Type → Type} [Pure m] : ComponentOps m MiddleRecursiveValue where
  real := fun z => pure (.complexValue z.re z.im)
  imag := fun z => pure z.im

/-- The source is allowed to diverge when a custom real getter returns its
own input Complex and unary dispatch selects this method again.  No arbitrary
selected scalar or constructor callback is reached in that loop.
Invariant: base/complex.jl:242,290-291,297. -/
def MiddleUnaryRecursiveDivergence : Prop :=
  ∀ (E State Scalar Result : Type)
      (ops : UnaryConstructOps (MiddleRuntime E State) MiddleRecursiveValue Scalar Result)
      (embed : Result → Scalar) (state : State),
    let dispatch : UnaryRecursiveDispatch MiddleRecursiveValue Scalar Result :=
      { same := MiddleDecodeComplex, embed := embed }
    MiddleRunRuntime (byteSwapComplexFull (monotoneBind := Lean.Order.instMonoBindExceptT (m := StateT State Option) (ε := E)) ops dispatch MiddleLoopValue MiddleLoopParts) state = none ∧
    MiddleRunRuntime (positiveComplexFull (monotoneBind := Lean.Order.instMonoBindExceptT (m := StateT State Option) (ε := E)) ops dispatch MiddleLoopValue MiddleLoopParts) state = none ∧
    MiddleRunRuntime (negativeComplexFull (monotoneBind := Lean.Order.instMonoBindExceptT (m := StateT State Option) (ε := E)) ops dispatch MiddleLoopValue MiddleLoopParts) state = none ∧
    MiddleRunRuntime (negativeWrapComplexFull (monotoneBind := Lean.Order.instMonoBindExceptT (m := StateT State Option) (ε := E)) ops dispatch MiddleLoopValue MiddleLoopParts) state = none

def MiddleDecodePair (a b : MiddleRecursiveValue) :
    Option (Complex MiddleRecursiveValue × Complex MiddleRecursiveValue) := do
  return (← MiddleDecodeComplex a, ← MiddleDecodeComplex b)

/-- Binary arithmetic and multiplication likewise diverge when both selected
real getters return their own Complex operands.  All operation records remain
arbitrary and uncalled before the recursive loop.
Invariant: base/complex.jl:292-295,298-301. -/
def MiddleBinaryRecursiveDivergence : Prop :=
  ∀ (E State Scalar Result : Type)
      (ops : BinaryConstructOps (MiddleRuntime E State) MiddleRecursiveValue MiddleRecursiveValue Scalar Result)
      (embed : Result → Scalar) (state : State),
    let dispatch : BinaryRecursiveDispatch MiddleRecursiveValue MiddleRecursiveValue Scalar Result :=
      { same := MiddleDecodePair, embed := embed }
    MiddleRunRuntime (addComplexFull (monotoneBind := Lean.Order.instMonoBindExceptT (m := StateT State Option) (ε := E)) ops dispatch MiddleLoopValue MiddleLoopValue MiddleLoopParts MiddleLoopParts) state = none ∧
    MiddleRunRuntime (subtractComplexFull (monotoneBind := Lean.Order.instMonoBindExceptT (m := StateT State Option) (ε := E)) ops dispatch MiddleLoopValue MiddleLoopValue MiddleLoopParts MiddleLoopParts) state = none ∧
    MiddleRunRuntime (addWrapComplexFull (monotoneBind := Lean.Order.instMonoBindExceptT (m := StateT State Option) (ε := E)) ops dispatch MiddleLoopValue MiddleLoopValue MiddleLoopParts MiddleLoopParts) state = none ∧
    MiddleRunRuntime (subtractWrapComplexFull (monotoneBind := Lean.Order.instMonoBindExceptT (m := StateT State Option) (ε := E)) ops dispatch MiddleLoopValue MiddleLoopValue MiddleLoopParts MiddleLoopParts) state = none

def MiddleMultiplyRecursiveDivergence : Prop :=
  ∀ (E State Product R I Result : Type)
      (ops : MultiplyConstructOps (MiddleRuntime E State) MiddleRecursiveValue MiddleRecursiveValue Product R I Result)
      (embed : Result → Product) (state : State),
    let dispatch : MultiplyRecursiveDispatch MiddleRecursiveValue MiddleRecursiveValue Product Result :=
      { same := MiddleDecodePair, embed := embed }
    MiddleRunRuntime (multiplyComplexFull (monotoneBind := Lean.Order.instMonoBindExceptT (m := StateT State Option) (ε := E)) ops dispatch MiddleLoopValue MiddleLoopValue MiddleLoopParts MiddleLoopParts) state = none ∧
    MiddleRunRuntime (multiplyWrapComplexFull (monotoneBind := Lean.Order.instMonoBindExceptT (m := StateT State Option) (ε := E)) ops dispatch MiddleLoopValue MiddleLoopValue MiddleLoopParts MiddleLoopParts) state = none

/-- The full equality source has the same reachable recursive divergence
when both selected real queries return their original Complex arguments.
Invariant: base/complex.jl:246. -/
def MiddleEqualityRecursiveDivergence : Prop :=
  ∀ (E State Other : Type)
      (ops : EqualityOps (MiddleRuntime E State) MiddleRecursiveValue MiddleRecursiveValue Other)
      (state : State),
    MiddleRunRuntime
      (equalComplexFull (monotoneBind := Lean.Order.instMonoBindExceptT (m := StateT State Option) (ε := E)) ops { same := MiddleDecodePair }
        MiddleLoopValue MiddleLoopValue MiddleLoopParts MiddleLoopParts) state = none

/-- A custom real getter can reselect the same Real/Complex isequal method
before its first comparison returns; its assertion cannot fabricate a result.
Invariant: base/complex.jl:252. -/
def MiddleIsequalRecursiveDivergence : Prop :=
  ∀ (E State R Zero NotBool1 NotBool2 : Type)
      (ops : RealIsequalOps (MiddleRuntime (Error E) State)
        R MiddleRecursiveValue Zero NotBool1 NotBool2)
      (value : R) (state : State),
    let dispatch : IsequalRecursiveDispatch R MiddleRecursiveValue Zero :=
      { first := fun real other => (MiddleDecodeComplex other).map (fun z => (real, z))
        second := fun _ _ => none }
    MiddleRunRuntime
      (isequalRealComplexFull (E := E)
        (monotoneBind := Lean.Order.instMonoBindExceptT (m := StateT State Option) (ε := Error E))
        ops dispatch value MiddleLoopValue MiddleLoopParts) state = none

/-- True custom isreal and a real getter returning the same Complex create a
reachable membership loop.  The original range is retained, with no fabricated
false value or exception when the selected range test is never reached.
Invariant: base/complex.jl:254. -/
def MiddleMembershipRecursiveDivergence : Prop :=
  ∀ (E State Range NotBool Other : Type)
      (contains : MiddleRecursiveValue → Range → MiddleRuntime (Error E) State (PredicateValue Other))
      (range : Range) (state : State),
    MiddleRunRuntime
      (memberComplexFull (E := E)
        (monotoneBind := Lean.Order.instMonoBindExceptT (m := StateT State Option) (ε := Error E))
        ({ isreal := fun _ => pure (.accepted true)
           contains := contains
           same := fun value _ => MiddleDecodeComplex value } :
          MembershipRecursiveOps (MiddleRuntime (Error E) State) MiddleRecursiveValue Range NotBool Other)
        MiddleLoopValue range MiddleLoopParts) state = none

/-- The full methods and their actual one-step implementation helpers are
both observed; native helper invariants retain the concrete Base arithmetic. -/
def MiddleUnaryComplete : Prop := MiddleUnaryAudit ∧ MiddleUnaryRecursiveAudit ∧ MiddleUnaryRecursiveDivergence

def MiddleBinaryComplete : Prop := MiddleBinaryAudit ∧ MiddleBinaryRecursiveAudit ∧ MiddleBinaryRecursiveDivergence

def MiddleMultiplyComplete : Prop := MiddleMultiplyAudit ∧ MiddleMultiplyRecursiveAudit ∧ MiddleMultiplyRecursiveDivergence

def MiddleEqualityComplete : Prop := MiddleEqualityAudit ∧ MiddleEqualityRecursiveAudit ∧ MiddleEqualityRecursiveDivergence

def MiddleIsequalComplete : Prop := MiddleRealIsequalAudit ∧ MiddleIsequalRecursiveAudit ∧ MiddleIsequalRecursiveDivergence

def MiddleMembershipComplete : Prop := MiddleMembershipAudit ∧ MiddleMembershipRecursiveAudit ∧ MiddleMembershipRecursiveDivergence

end JuliaLean.Proofs.base.complex.Models2Group9


namespace JuliaLean.Proofs.base.complex.Models2Group9

open JuliaLean JuliaLean.base.complex JuliaLean.base.complex.Models2Group9

/-!
Full selected-getter observations supplement the inherited/native-coordinate
properties.  No getter law is assumed.  Each selected query can change the
runtime value's type, mutate, throw, or diverge; the universal carrier A retains
those values.  The observations constrain call histories and error boundaries,
not an expected second execution of the source algorithm.
-/

def EarlyGetterObservedParts {E State A : Type}
    (parts : ComponentOps (MiddleM E State) A) :
    ComponentOps (MiddleM E (MiddleWorld E State)) A where
  real := fun value => MiddleObserve "real" (parts.real value)
  imag := fun value => MiddleObserve "imag" (parts.imag value)

/-- Typed complex conversion queries real before imaginary and constructs
only after both queries return.  Every selected error retains its post-call
state and suppresses later calls.  Invariant: base/complex.jl:43. -/
def ConstructorTypedComplexSelectedGetters : Prop :=
  ∀ (E State A Result : Type)
      (parts : ComponentOps (MiddleM E State) A)
      (ops : TypedComplexConstructorOps (MiddleM E State) A Result)
      (z : Complex A) (state : State),
    MiddleAudit (MiddleOnePath ["real", "imag", "construct"])
      MiddleNoLocalError state
      ((complexTypedComplex
        ({ construct := fun r i => MiddleObserve "construct" (ops.construct r i) } :
          TypedComplexConstructorOps (MiddleM E (MiddleWorld E State)) A Result)
        z (EarlyGetterObservedParts parts)).run (state, []))

def EarlyGetterIsRealPrefix {m : Type → Type} {A R : Type}
    (target : IsRealDispatch m A R) : List String :=
  match target with
  | .inherited _ => ["imag", "isreal"]
  | .selectedCustom _ => ["isreal"]

def EarlyGetterCheckedResultInfo {T Other : Type} : Checked T Other → String
  | .accepted _ => "accepted"
  | .rejected _ => "rejected"

/-- Explicit checks remain at their respective source boundaries after
arbitrary selected getters.  False realness must skip the real query; a bad
getter or constructor result is never replaced by a successful default.
Invariant: base/complex.jl:44-45,149. -/
def ComplexRealConversionSelectedGetters : Prop :=
  ∀ (E State A T NotBool NotT : Type)
      (parts : ComponentOps (MiddleM (Error E) State) A)
      (ops : RealConversionOps (MiddleM (Error E) State) A T NotBool NotT)
      (z : Complex A) (state : State),
    let opening := EarlyGetterIsRealPrefix ops.isreal
    let traced : RealConversionOps
        (MiddleM (Error E) (MiddleWorld (Error E) State)) A T NotBool NotT :=
      { isreal := MiddleObserveCheckedIsReal ops.isreal
        construct := fun value => MiddleObserveInfo "construct"
          EarlyGetterCheckedResultInfo (ops.construct value)
        typeName := ops.typeName }
    let observed := (realFromComplex (E := E) traced z
      (EarlyGetterObservedParts parts)).run (state, [])
    MiddleAudit (fun labels => labels = opening ++ ["real", "construct"])
      (fun error labels =>
        (labels = opening ∧ (error = .typeError "if" ∨
          error = .jl (.inexactError ops.typeName))) ∨
        (labels = opening ++ ["real", "construct"] ∧
          error = .typeError "T(real(z))::T")) state observed ∧
    MiddleOutcomeCheck (fun outcome history =>
      (MiddleDetails "isreal" history = ["false"] →
        outcome = .error (.jl (.inexactError ops.typeName)) ∧
          MiddleLabels history = opening) ∧
      (MiddleDetails "isreal" history = ["rejected"] →
        outcome = .error (.typeError "if") ∧ MiddleLabels history = opening) ∧
      (MiddleDetails "construct" history = ["rejected"] →
        outcome = .error (.typeError "T(real(z))::T")) ∧
      (MiddleDetails "construct" history = ["accepted"] →
        ∃ value, outcome = .ok value)) observed

def EarlyGetterObservedPredicates {E State A Other : Type}
    (ops : PredicateOps (MiddleM E State) A Other) :
    PredicateOps (MiddleM E (MiddleWorld E State)) A Other where
  isreal := match ops.isreal with
    | .inherited call => .inherited (fun value =>
        MiddleObserveInfo "isreal" MiddlePredicateInfo (call value))
    | .selectedCustom call => .selectedCustom (fun value =>
        MiddleObserveInfo "isreal" MiddlePredicateInfo (call value))
  isinteger := fun value => MiddleObserveInfo "isinteger" MiddlePredicateInfo (ops.isinteger value)
  isfinite := fun value => MiddleObserveInfo "isfinite" MiddlePredicateInfo (ops.isfinite value)
  isnan := fun value => MiddleObserveInfo "isnan" MiddlePredicateInfo (ops.isnan value)
  isinf := fun value => MiddleObserveInfo "isinf" MiddlePredicateInfo (ops.isinf value)
  iszero := fun value => MiddleObserveInfo "iszero" MiddlePredicateInfo (ops.iszero value)
  isone := fun value => MiddleObserveInfo "isone" MiddlePredicateInfo (ops.isone value)
  andOther := fun left right => MiddleObserveInfo "and" MiddlePredicateInfo (ops.andOther left right)
  orOther := fun left right => MiddleObserveInfo "or" MiddlePredicateInfo (ops.orOther left right)

def EarlyGetterPredicateDetails {E State : Type} (history : List (MiddleCall E State)) :
    List String :=
  (history.filter (fun call =>
    ["isreal", "isinteger", "isfinite", "isnan", "isinf", "iszero", "isone"].contains call.label)).map
      (fun call => call.detail)

/-- The two actual predicate receipts determine native truth behavior versus
selected non-Bool combination.  A later component query is observable even
when the first result would suffice for a short-circuit Boolean operation. -/
def EarlyGetterPredicateGate {E State Other : Type} (disjunction : Bool)
    (basePath : List String)
    (observed : Option (Except (E × MiddleWorld E State)
      (PredicateValue Other × MiddleWorld E State))) : Prop :=
  MiddleOutcomeCheck (fun outcome history =>
    match EarlyGetterPredicateDetails history with
    | [left, right] =>
        if (left = "true" ∨ left = "false") ∧ (right = "true" ∨ right = "false") then
          MiddleLabels history = basePath ∧
          ∃ answer : Bool, outcome = .ok (.boolean answer) ∧
            (if disjunction then answer = true ↔ left = "true" ∨ right = "true"
             else answer = true ↔ left = "true" ∧ right = "true")
        else if left ≠ "" ∧ right ≠ "" ∧ (left = "other" ∨ right = "other") then
          MiddleLabels history = basePath ++ [if disjunction then "or" else "and"]
        else True
    | _ => True) observed

/-- Classifier call histories include every component query, preserve eager
evaluation, and expose all selected errors and state changes.  The predicate
record and getter record range independently over their complete domains.
Invariant: base/complex.jl:150-155. -/
def EarlyGetterPredicateAudit {E State A Other : Type}
    (method : PredicateOps (MiddleM E (MiddleWorld E State)) A Other →
      Complex A → ComponentOps (MiddleM E (MiddleWorld E State)) A →
      MiddleM E (MiddleWorld E State) (PredicateValue Other))
    (disjunction : Bool) (basePath : List String)
    (parts : ComponentOps (MiddleM E State) A)
    (ops : PredicateOps (MiddleM E State) A Other) (z : Complex A) (state : State) : Prop :=
  let observed := (method (EarlyGetterObservedPredicates ops) z
    (EarlyGetterObservedParts parts)).run (state, [])
  MiddleAudit (fun labels => labels = basePath ∨
      labels = basePath ++ [if disjunction then "or" else "and"])
    MiddleNoLocalError state observed ∧
  EarlyGetterPredicateGate disjunction basePath observed

