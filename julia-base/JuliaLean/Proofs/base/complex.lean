set_option maxRecDepth 10000
set_option maxHeartbeats 2000000
set_option exponentiation.threshold 10000
set_option linter.unusedSimpArgs false

theorem mul_pow_lt_cross (n d a b c e : Nat) (hh : a+e = c+b) :
    n*2^a < d*2^b ↔ n*2^c < d*2^e := by
  have h1 : n*2^a*2^e = n*2^c*2^b := by rw [Nat.mul_assoc, Nat.mul_assoc, ← Nat.pow_add, ← Nat.pow_add, hh]
  have h2 : d*2^b*2^e = d*2^e*2^b := by rw [Nat.mul_right_comm d]
  calc
    n*2^a < d*2^b ↔ n*2^a*2^e < d*2^b*2^e := (Nat.mul_lt_mul_right (Nat.two_pow_pos e)).symm
    _ ↔ n*2^c*2^b < d*2^e*2^b := by rw [h1, h2]
    _ ↔ n*2^c < d*2^e := Nat.mul_lt_mul_right (Nat.two_pow_pos b)

theorem floorLog_uniform (n d : Nat) :
    Fl.floorLog2Rat n d =
      let e : Int := (n.log2 : Int)-d.log2
      if n*2^(-e).toNat < d*2^e.toNat then e-1 else e := by
  unfold Fl.floorLog2Rat
  dsimp only
  generalize (n.log2 : Int)-d.log2 = e
  by_cases he : e ≥ 0
  · have hne : (-e).toNat = 0 := by omega
    simp only [he, ↓reduceIte, hne, Nat.pow_zero, Nat.mul_one]
  · have hne : e.toNat = 0 := by omega
    simp only [he, ↓reduceIte, hne, Nat.pow_zero, Nat.mul_one]

theorem floorLog_shift (n d i j : Nat) (hn : n ≠ 0) (hd : d ≠ 0) :
    Fl.floorLog2Rat (n*2^i) (d*2^j) = Fl.floorLog2Rat n d + (i : Int)-j := by
  rw [floorLog_uniform, floorLog_uniform, SmallExact.log2_mul_pow n i hn,
    SmallExact.log2_mul_pow d j hd]
  dsimp only
  let e : Int := (n.log2 : Int)-d.log2
  have he : ((n.log2+i : Nat) : Int)-((d.log2+j : Nat) : Int) = e+(i : Int)-j := by dsimp only [e]; omega
  rw [he]
  change (if n*2^i*2^(-(e+(i : Int)-j)).toNat < d*2^j*2^(e+(i : Int)-j).toNat
    then e+(i : Int)-j-1 else e+(i : Int)-j) =
    (if n*2^(-e).toNat < d*2^e.toNat then e-1 else e)+(i : Int)-j
  have hb : n*2^i*2^(-(e+(i : Int)-j)).toNat < d*2^j*2^(e+(i : Int)-j).toNat ↔
      n*2^(-e).toNat < d*2^e.toNat := by
    rw [Nat.mul_assoc, Nat.mul_assoc, ← Nat.pow_add, ← Nat.pow_add]
    apply mul_pow_lt_cross
    omega
  simp only [hb]
  split <;> omega

theorem rq_equal_fraction (n d m e : Nat) (hd : 0 < d) (he : 0 < e) (hcross : n*e = m*d) :
    Fl.roundQuotient n d = Fl.roundQuotient m e := by
  rw [← floatCheckRoundQuotientScale n d e he, hcross, Nat.mul_comm d e,
    floatCheckRoundQuotientScale m e d hd]

theorem rq_pow_cross (n d a b c e : Nat) (hd : d ≠ 0) (hh : a+e = c+b) :
    Fl.roundQuotient (n*2^a) (d*2^b) = Fl.roundQuotient (n*2^c) (d*2^e) := by
  apply rq_equal_fraction _ _ _ _
    (Nat.mul_pos (by omega) (Nat.two_pow_pos _)) (Nat.mul_pos (by omega) (Nat.two_pow_pos _))
  calc n*2^a*(d*2^e) = n*d*(2^a*2^e) := by ac_rfl
    _ = n*d*(2^c*2^b) := by rw [← Nat.pow_add, ← Nat.pow_add, hh]
    _ = n*2^c*(d*2^b) := by ac_rfl

theorem normal_round_shift (n : Int) (d i j : Nat) (s : Bool) (hn : n ≠ 0) (hd : d ≠ 0)
    (hlo : -1022 ≤ Fl.floorLog2Rat n.natAbs d+(i : Int)-j)
    (hhi : Fl.floorLog2Rat n.natAbs d+(i : Int)-j < 1024) :
    F64.roundRat (n*((2^i : Nat) : Int)) (d*2^j) s =
      f64Pack (decide (n<0))
        (Fl.roundQuotient (n.natAbs*2^(-(Fl.floorLog2Rat n.natAbs d-52)).toNat)
          (d*2^(Fl.floorLog2Rat n.natAbs d-52).toNat))
        (Fl.floorLog2Rat n.natAbs d+(i : Int)-j-52) := by
  have ha : n.natAbs ≠ 0 := by omega
  have hdp : d*2^j ≠ 0 := Nat.mul_ne_zero hd (Nat.ne_of_gt (Nat.two_pow_pos j))
  have hnp : n*((2^i : Nat) : Int) ≠ 0 := Int.mul_ne_zero hn (by have := Nat.two_pow_pos i; omega)
  have hneg : n*((2^i : Nat) : Int) < 0 ↔ n < 0 := by
    have h := Int.mul_lt_mul_right (b := n) (c := 0) (show (0 : Int) < ((2^i : Nat) : Int) by have := Nat.two_pow_pos i; omega)
    simpa only [Int.zero_mul] using h
  have hfloor : f64Fl2 (n.natAbs*2^i) (d*2^j) = Fl.floorLog2Rat n.natAbs d+(i : Int)-j := by
    exact floorLog_shift n.natAbs d i j ha hd
  rw [f64_roundRat_eq]
  simp only [beq_eq_false_iff_ne.mpr hdp, beq_eq_false_iff_ne.mpr hnp,
    Bool.false_eq_true, ↓reduceIte, hfloor, hneg, Int.natAbs_mul, Int.natAbs_natCast]
  rw [ite_eq_right (show ¬ Fl.floorLog2Rat n.natAbs d+(i : Int)-j ≥ 1024 by omega),
    ite_eq_right (show ¬ Fl.floorLog2Rat n.natAbs d+(i : Int)-j < -1075 by omega)]
  have hk : max (Fl.floorLog2Rat n.natAbs d+(i : Int)-j-52) (-1074) =
      Fl.floorLog2Rat n.natAbs d+(i : Int)-j-52 := by omega
  rw [hk]
  apply congrArg (fun q => f64Pack (decide (n<0)) q (Fl.floorLog2Rat n.natAbs d+(i : Int)-j-52))
  let k := Fl.floorLog2Rat n.natAbs d+(i : Int)-j-52
  let k0 := Fl.floorLog2Rat n.natAbs d-52
  change f64Rq (if k ≥ 0 then (n.natAbs*2^i, d*2^j*2^k.toNat) else
    (n.natAbs*2^i*2^(-k).toNat, d*2^j)).1
    (if k ≥ 0 then (n.natAbs*2^i, d*2^j*2^k.toNat) else
    (n.natAbs*2^i*2^(-k).toNat, d*2^j)).2 =
    Fl.roundQuotient (n.natAbs*2^(-k0).toNat) (d*2^k0.toNat)
  by_cases hge : k ≥ 0
  · simp only [hge, ↓reduceIte]
    rw [Nat.mul_assoc, ← Nat.pow_add]
    apply rq_pow_cross _ _ _ _ _ _ hd
    dsimp only [k, k0] at hge ⊢
    omega
  · simp only [hge, ↓reduceIte]
    rw [Nat.mul_assoc, ← Nat.pow_add]
    apply rq_pow_cross _ _ _ _ _ _ hd
    dsimp only [k, k0] at hge ⊢
    omega

open Scalar.ProofRound

theorem round_dyadic_eq (n m : Int) (i j : Nat) (s : Bool)
    (h : n*((2^j : Nat) : Int) = m*((2^i : Nat) : Int)) :
    F64.roundRat n (2^i) s = F64.roundRat m (2^j) s := by
  rw [← Epsilon.round_scale n (2^i) j s (Nat.ne_of_gt (Nat.two_pow_pos _)), h,
    Nat.mul_comm (2^i) (2^j), Epsilon.round_scale m (2^j) i s (Nat.ne_of_gt (Nat.two_pow_pos _))]

theorem round_exact_key (n : Int) (k : Nat) (s : Bool) (hn : n.natAbs < 2^53)
    (htop : n.natAbs.log2+k ≤ 2097) :
    F64.isfinite (F64.roundRat (n*((2^k : Nat) : Int)) (2^1074) s) = true ∧
    key64 (F64.roundRat (n*((2^k : Nat) : Int)) (2^1074) s) = n*((2^k : Nat) : Int) := by
  by_cases hn0 : n = 0
  · subst n
    simp only [Int.zero_mul, f64_roundRat_eq, show (2^1074 == 0) = false by decide,
      Bool.false_eq_true, beq_self_eq_true, ↓reduceIte]
    cases s <;> decide
  have hnpos : 0 < n.natAbs := by omega
  have hsig := SmallExact.sig_bounds (f := double) n.natAbs (by omega) hn
  change n.natAbs.log2 ≤ 52 ∧ 2^52 ≤ n.natAbs*2^(52-n.natAbs.log2) ∧ n.natAbs*2^(52-n.natAbs.log2) < 2^53 at hsig
  have hsgn : n*((2^k : Nat) : Int) = SmallExact.signed (decide (n<0)) (n.natAbs*2^k) := by
    conv => lhs; rw [SmallExact.signed_abs n]
    exact SmallExact.signed_mul _ _ _
  have hfloor : Fl.floorLog2Rat (n*((2^k : Nat) : Int)).natAbs (2^1074) =
      ((n.natAbs.log2+k : Nat) : Int)-1074 := by
    rw [Int.natAbs_mul, Int.natAbs_natCast,
      SmallExact.floorLog2Rat_pow _ _ (Nat.mul_ne_zero (by omega) (Nat.ne_of_gt (Nat.two_pow_pos _))),
      SmallExact.log2_mul_pow _ _ (by omega)]
    rfl
  rw [← floatCheckFlToF64RoundRat _ _ _ (by rw [hfloor]; omega), hsgn]
  by_cases hnormal : 52 ≤ n.natAbs.log2+k
  · have hr := SmallExact.roundRat_normal_signed SmallExact.good_double (decide (n<0)) n.natAbs k 1074 s
      (by omega) hn (by change 1075 ≤ n.natAbs.log2+k+1023; omega)
      (by change n.natAbs.log2+k+1023 < 1074+2047; omega)
    rw [hr]
    change F64.isfinite (Fl.toF64 (Fl.ofBits
      ((if decide (n<0) then 2^63 else 0)+((n.natAbs.log2+k+1023-1074)*2^52+
      (n.natAbs*2^(52-n.natAbs.log2)-2^52))) : Fl double)) = true ∧
      key64 (Fl.toF64 (Fl.ofBits ((if decide (n<0) then 2^63 else 0)+
        ((n.natAbs.log2+k+1023-1074)*2^52+(n.natAbs*2^(52-n.natAbs.log2)-2^52))) : Fl double)) =
        SmallExact.signed (decide (n<0)) (n.natAbs*2^k)
    rw [floatCheckFlToF64OfBits]
    have he0 : 1 ≤ n.natAbs.log2+k+1023-1074 := by omega
    have he1 : n.natAbs.log2+k+1023-1074 ≤ 2046 := by omega
    have hk := key64_norm (decide (n<0)) (n.natAbs.log2+k+1023-1074)
      (n.natAbs*2^(52-n.natAbs.log2)) he0 he1 hsig.2.1 hsig.2.2
    dsimp only at hk
    rw [Nat.add_assoc] at hk
    refine ⟨hk.1, ?_⟩
    rw [hk.2]
    have heq : n.natAbs*2^(52-n.natAbs.log2)*2^(n.natAbs.log2+k+1023-1074-1) = n.natAbs*2^k := by
      rw [Nat.mul_assoc, ← Nat.pow_add]
      congr 2
      omega
    rw [heq]
    rfl
  · have hm : n.natAbs*2^k < 2^52 := by
      have hu : n.natAbs*2^k < 2^(n.natAbs.log2+k+1) := by
        rw [show n.natAbs.log2+k+1 = (n.natAbs.log2+1)+k by omega, Nat.pow_add]
        exact Nat.mul_lt_mul_of_pos_right Nat.lt_log2_self (Nat.two_pow_pos _)
      exact Nat.lt_of_lt_of_le hu (Nat.pow_le_pow_right (by decide) (by omega))
    have hr := SmallExact.roundRat_subnormal_signed SmallExact.good_double (decide (n<0))
      (n.natAbs*2^k) 0 1074 s (Nat.mul_pos hnpos (Nat.two_pow_pos _)) hm (by decide)
    simp only [Nat.pow_zero, Nat.mul_one] at hr
    rw [hr]
    change F64.isfinite (Fl.toF64 (Fl.ofBits ((if decide (n<0) then 2^63 else 0)+
      (0*2^52+n.natAbs*2^k)) : Fl double)) = true ∧
      key64 (Fl.toF64 (Fl.ofBits ((if decide (n<0) then 2^63 else 0)+(0*2^52+n.natAbs*2^k)) : Fl double)) =
        SmallExact.signed (decide (n<0)) (n.natAbs*2^k)
    rw [floatCheckFlToF64OfBits]
    simp only [Nat.zero_mul, Nat.zero_add]
    have hk := key64_sub (decide (n<0)) (n.natAbs*2^k) hm
    exact hk

theorem key_neg (x : F64) : key64 (F64.neg x) = -key64 x := by
  have hfields := Scalar.ProofMisc.neg_fields x
  unfold key64 magKey64
  rw [hfields.1, hfields.2, Scalar.ProofsBits.signbit_neg]
  cases F64.signbit x <;> simp only [Bool.false_eq_true, ↓reduceIte, Bool.not_false,
    Bool.not_true, Int.neg_neg]

theorem add_key_round (x y : F64) (hx : F64.isfinite x = true) (hy : F64.isfinite y = true) :
    F64.add x y = F64.roundRat (key64 x+key64 y) (2^1074) (F64.signbit x && F64.signbit y) := by
  obtain ⟨u, _, hdx⟩ := Scalar.ProofMisc.finite_den_pow x hx
  obtain ⟨v, _, hdy⟩ := Scalar.ProofMisc.finite_den_pow y hy
  have hcross :
      ((F64.toRat x).1*((F64.toRat y).2 : Int) +
        (F64.toRat y).1*((F64.toRat x).2 : Int)) * ((2^1074 : Nat) : Int) =
      (key64 x+key64 y) * (((F64.toRat x).2*(F64.toRat y).2 : Nat) : Int) := by
    rw [Int.add_mul]
    rw [Int.mul_right_comm (F64.toRat x).1, Int.mul_right_comm (F64.toRat y).1,
      key64_rat x hx, key64_rat y hy, Int.natCast_mul, Int.add_mul]
    ac_rfl
  rw [hdx, hdy, ← Nat.pow_add] at hcross
  rw [Scalar.ProofRound.add_finite x y hx hy, hdx, hdy, ← Nat.pow_add]
  exact round_dyadic_eq _ _ _ _ _ hcross

theorem sub_key_round (x y : F64) (hx : F64.isfinite x = true) (hy : F64.isfinite y = true) :
    F64.sub x y = F64.roundRat (key64 x-key64 y) (2^1074) (F64.signbit x && !F64.signbit y) := by
  obtain ⟨hxn, _⟩ := floatCheckF64FiniteClasses x hx
  obtain ⟨hyn, _⟩ := floatCheckF64FiniteClasses y hy
