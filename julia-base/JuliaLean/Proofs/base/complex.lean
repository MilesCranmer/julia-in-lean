  ∀ (E State : Type) (concreteMetadata : Bool)
      (complexOther : Sigma (fun _ : Bool => Unit) → RootM E State (Sigma (fun _ : Bool => Unit)))
      (convert : AbstractArrayType Bool → Unit → RootM E State (Sigma (fun _ : Bool => Unit)))
      (state : State),
    let element : ArrayElementType Bool := ⟨false, concreteMetadata⟩
    let ops : ArrayComplexOps (RootM E State) Bool (fun _ => Unit) Unit Empty :=
      { isConcrete := fun _ => pure (.boolean true)
