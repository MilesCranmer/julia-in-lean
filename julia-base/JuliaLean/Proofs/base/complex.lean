  rw [add_key_round x (F64.neg y) hx (by rw [Scalar.ProofMisc.neg_isfinite]; exact hy), key_neg, Scalar.ProofsBits.signbit_neg]
  rfl

theorem mul_key_round (x y : F64) (hx : F64.isfinite x = true) (hy : F64.isfinite y = true) :
    F64.mul x y = F64.roundRat (key64 x*key64 y) (2^2148) (F64.signbit x != F64.signbit y) := by
  obtain ⟨u, _, hdx⟩ := Scalar.ProofMisc.finite_den_pow x hx
  obtain ⟨v, _, hdy⟩ := Scalar.ProofMisc.finite_den_pow y hy
  have hcross : ((F64.toRat x).1*(F64.toRat y).1)*((2^2148 : Nat) : Int) =
      (key64 x*key64 y)*(((F64.toRat x).2*(F64.toRat y).2 : Nat) : Int) := by
    have hp : ((2^2148 : Nat) : Int) = ((2^1074 : Nat) : Int)*((2^1074 : Nat) : Int) := by
      rw [← Int.natCast_mul, ← Nat.pow_add]
