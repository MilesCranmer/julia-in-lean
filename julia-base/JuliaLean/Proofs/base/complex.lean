set_option exponentiation.threshold 5000

def floatCheckLo : F64 := F64.ofBits 0x1ff6a09e667f3bcd
def floatCheckHi : F64 := F64.ofBits 0x5fe6a09e667f3bcc

theorem floatCheckSqrtLo :
    F64.sqrt (F64.div F64.floatmin Fl64.two) = .ok floatCheckLo := by
  decide

theorem floatCheckSqrtHi :
    F64.sqrt (F64.div F64.floatmax Fl64.two) = .ok floatCheckHi := by
  decide

theorem floatCheckAndBranch {T : Type} (a b : Bool) (x y : T) :
    (if a then if b then x else y else y) = (if a && b then x else y) := by
  cases a <;> cases b <;> rfl

theorem floatCheckInverseBridge (w : ComplexF64) :
    inverseF64 w = inv_ComplexF64 w := by
  unfold inverseF64 inv_ComplexF64
  simp only [reim, real_Complex, imag_Complex, floatCheckSqrtLo, floatCheckSqrtHi,
    bind, Except.bind, pure, Except.pure]
  exact floatCheckAndBranch _ _ _ _

theorem floatCheckInverseTotal (w : ComplexF64) : ∃ v, inverseF64 w = .ok v := by
  rw [floatCheckInverseBridge]
  unfold inv_ComplexF64 reim real_Complex imag_Complex
  simp only [floatCheckSqrtLo, floatCheckSqrtHi,
    bind, Except.bind, pure, Except.pure]
  generalize (if F64.lt (F64.abs w.im) (F64.abs w.re) then
    (F64.abs w.re, F64.abs w.im) else (F64.abs w.im, F64.abs w.re)) = cd
  cases h : F64.le floatCheckLo cd.1 && F64.le cd.1 floatCheckHi <;>
    simp only [h, Bool.false_eq_true, ↓reduceIte]
  · cases hi : F64.isinf w.re || F64.isinf w.im <;>
      simp only [hi, Bool.false_eq_true, ↓reduceIte] <;> exact ⟨_, rfl⟩
  · exact ⟨_, rfl⟩

theorem floatCheckInverseInfinity (w : ComplexF64)
    (h : F64.isinf w.re = true ∨ F64.isinf w.im = true) :
    inverseF64 w = .ok ⟨Fl64.copysign Fl64.pzero w.re, Fl64.flipsign Fl64.nzero w.im⟩ := by
  rw [floatCheckInverseBridge]
  have h' := (invProperties_proven floatCheckLo floatCheckHi
    floatCheckSqrtLo floatCheckSqrtHi (by decide) (by decide) (by decide)).1
      w.re w.im (by simpa only [Bool.or_eq_true] using h)
  exact h'.2.2.1

theorem floatCheckNumericalZero (s : Bool) : NumericalZero64 (F64.zero s) := by
  unfold NumericalZero64
  cases s <;> decide

theorem Models1G19RealComplexFloatInfinity_proven :
    JuliaLean.Proofs.base.complex.Models1Group19.RealComplexFloatInfinity := by
  intro a z
  obtain ⟨v, hv⟩ := floatCheckInverseTotal z
  simp only [divideRealF64ByComplex, convertComplexF64, Complex_T_Complex,
    constructTypedComplex, real_Complex, imag_Complex,
    bind, Except.bind, pure, Except.pure]
  rw [hv]
  simp only [bind, Except.bind, pure, Except.pure]
  intro ha hz
  have hinv := floatCheckInverseInfinity z hz
  rw [hv] at hinv
  cases Except.ok.inj hinv
  dsimp only [mul_Real_Complex, real_Complex, imag_Complex]
  have hc : Fl64.copysign Fl64.pzero z.re = F64.zero (F64.signbit z.re) := by
    unfold Fl64.copysign
    cases F64.signbit z.re <;> decide
  have hf : Fl64.flipsign Fl64.nzero z.im = F64.zero (!F64.signbit z.im) := by
    unfold Fl64.flipsign
    cases F64.signbit z.im <;> decide
  rw [hc, hf, mul_zero_f64 a _ ha, mul_zero_f64 a _ ha]
  exact ⟨floatCheckNumericalZero _, floatCheckNumericalZero _⟩

end JuliaLean.ChatGPT.Batch10.Group1

-- FloatUpperPart
namespace JuliaLean.ChatGPT.Batch10.Group1

open JuliaLean JuliaLean.Float JuliaLean.Promotion JuliaLean.base.complex
open JuliaLean.Proofs.base.complex
open Scalar.ProofsBits

set_option maxRecDepth 100000
set_option maxHeartbeats 10000000
set_option exponentiation.threshold 5000

theorem floatUpperLogBound (n d b : Nat) (hd : d ≠ 0)
    (h : n ≤ d * 2^b) : f64Fl2 n d ≤ (b : Int) := by
  have hlog : n.log2 ≤ (d * 2^b).log2 := by
    by_cases hn : n = 0
    · rw [hn]; exact Nat.zero_le _
    · exact floatCheckLog2Mono n (d * 2^b) hn
        (Nat.mul_ne_zero hd (Nat.ne_of_gt (Nat.two_pow_pos _))) h
  rw [log2_mul_pow b (by omega)] at hlog
  unfold f64Fl2
  dsimp only
  split <;> omega

theorem floatUpperPackBound (s : Bool) (q b : Nat) (k : Int)
    (hq : q ≤ 2^53) (hb : b ≤ 1022) (hk : k ≤ (b : Int) - 52) :
    F64.toBits (f64Pack s q k) % 2^63 < (b + 1025) * 2^52 := by
  unfold f64Pack
  by_cases hz : q = 0
  · simp only [hz, beq_self_eq_true, ite_true]
    cases s <;> change 0 < (b + 1025) * 2^52 <;> omega
  · simp only [beq_eq_false_iff_ne.mpr hz, Bool.false_eq_true, ite_false]
    have he : ¬ (if q ≥ 2^53 then k+1 else k) + 1075 ≥ 2047 := by
      split <;> omega
    rw [ite_f he]
    have hE : ((if q ≥ 2^53 then k+1 else k) + 1075).toNat ≤ b+1024 := by
      split <;> omega
    have hm : (if q ≥ 2^53 then q/2 else q) < 2^53 := by
      split <;> omega
    rw [tb_ofBits]
    by_cases hsmall : (if q ≥ 2^53 then q/2 else q) < 2^52
    · rw [ite_t hsmall]
      cases s <;> simp only [Bool.false_eq_true, ite_false, ite_true, Nat.zero_add] <;> omega
    · rw [ite_f hsmall]
      cases s <;> simp only [Bool.false_eq_true, ite_false, ite_true, Nat.zero_add] <;> omega

theorem floatUpperRoundRatBound (n : Int) (d b : Nat) (s : Bool)
    (hd : d ≠ 0) (hb : b ≤ 1022) (hnum : n.natAbs ≤ d * 2^b) :
    F64.toBits (F64.roundRat n d s) % 2^63 < (b+1025)*2^52 := by
  have hlog := floatUpperLogBound n.natAbs d b hd hnum
  rw [f64_roundRat_eq]
  simp only [beq_eq_false_iff_ne.mpr hd, Bool.false_eq_true, ite_false]
  by_cases hn : n = 0
  · simp only [hn, beq_self_eq_true, ite_true]
    cases s <;> change 0 < (b+1025)*2^52 <;> omega
  · simp only [beq_eq_false_iff_ne.mpr hn, Bool.false_eq_true, ite_false]
    have ho : ¬ f64Fl2 n.natAbs d ≥ 1024 := by omega
    rw [ite_f ho]
    by_cases hu : f64Fl2 n.natAbs d < -1075
    · rw [ite_t hu]
      cases decide (n < 0) <;> change 0 < (b+1025)*2^52 <;> omega
    · rw [ite_f hu]
      apply floatUpperPackBound
      · exact floatCheckScaledRoundedBound n.natAbs d 52 (by omega) hd _ (by omega)
      · exact hb
      · omega

theorem floatUpperRoundRatFinite (n : Int) (d b : Nat) (s : Bool)
    (hd : d ≠ 0) (hb : b ≤ 1022) (hnum : n.natAbs ≤ d * 2^b) :
    F64.isfinite (F64.roundRat n d s) = true := by
  have hbound := floatUpperRoundRatBound n d b s hd hb hnum
  simp only [F64.isfinite, F64.exponentField, bne_iff_ne]
  omega


theorem floatUpperRatBound (x : F64) (b : Nat) (hf : F64.isfinite x = true)
    (he : F64.toBits x / 2^52 % 2048 ≤ b+1022) :
    (F64.toRat x).1.natAbs ≤ (F64.toRat x).2 * 2^b := by
  have hfrac : F64.toBits x % 2^52 < 2^52 := Nat.mod_lt _ (by decide)
  have hmant : F64.toBits x % 2^52 + 2^52 ≤ 2^53 := by omega
  by_cases hz : F64.toBits x / 2^52 % 2048 = 0
  · rw [toRat_subn x hz]
    have habs : (if F64.signbit x then -((F64.toBits x % 2^52 : Nat) : Int)
        else ((F64.toBits x % 2^52 : Nat) : Int)).natAbs = F64.toBits x % 2^52 := by
      cases F64.signbit x <;> simp only [Bool.false_eq_true, ite_false, ite_true,
        Int.natAbs_neg, Int.natAbs_natCast]
    change (if F64.signbit x then -((F64.toBits x % 2^52 : Nat) : Int)
        else ((F64.toBits x % 2^52 : Nat) : Int)).natAbs ≤ 2^1074 * 2^b
    rw [habs, ← Nat.pow_add]
    exact Nat.le_trans (Nat.le_of_lt hfrac) (Nat.pow_le_pow_right (by decide) (by omega))
  · by_cases hsmall : F64.toBits x / 2^52 % 2048 ≤ 1074
    · rw [toRat_norm x (by omega) hsmall]
      have habs : (if F64.signbit x then -((F64.toBits x % 2^52 + 2^52 : Nat) : Int)
          else ((F64.toBits x % 2^52 + 2^52 : Nat) : Int)).natAbs = F64.toBits x % 2^52 + 2^52 := by
        cases F64.signbit x <;> simp only [Bool.false_eq_true, ite_false, ite_true,
          Int.natAbs_neg, Int.natAbs_natCast]
      change (if F64.signbit x then -((F64.toBits x % 2^52 + 2^52 : Nat) : Int)
          else ((F64.toBits x % 2^52 + 2^52 : Nat) : Int)).natAbs ≤
        2^(1075 - F64.toBits x / 2^52 % 2048) * 2^b
      rw [habs, ← Nat.pow_add]
      exact Nat.le_trans hmant (Nat.pow_le_pow_right (by decide) (by omega))
    · have hupper : F64.toBits x / 2^52 % 2048 ≤ 2046 := by
        simp only [F64.isfinite, F64.exponentField, bne_iff_ne] at hf
        have := Nat.mod_lt (F64.toBits x / 2^52) (by decide : 0 < 2048)
        omega
      rw [toRat_big x (by omega) hupper]
      have habs : (if F64.signbit x then -((F64.toBits x % 2^52 + 2^52 : Nat) : Int)
          else ((F64.toBits x % 2^52 + 2^52 : Nat) : Int)).natAbs = F64.toBits x % 2^52 + 2^52 := by
        cases F64.signbit x <;> simp only [Bool.false_eq_true, ite_false, ite_true,
          Int.natAbs_neg, Int.natAbs_natCast]
      simp only [Int.natAbs_mul, Int.natAbs_natCast, habs, Nat.one_mul]
      calc
        (F64.toBits x % 2^52 + 2^52) * 2^(F64.toBits x / 2^52 % 2048 - 1075)
            ≤ 2^53 * 2^(F64.toBits x / 2^52 % 2048 - 1075) := Nat.mul_le_mul_right _ hmant
        _ = 2^(53 + (F64.toBits x / 2^52 % 2048 - 1075)) := (Nat.pow_add _ _ _).symm
        _ ≤ 2^b := Nat.pow_le_pow_right (by decide) (by omega)

theorem floatUpperFiniteOfBits (x : F64)
    (h : F64.toBits x % 2^63 < 2047*2^52) : F64.isfinite x = true := by
  simp only [F64.isfinite, F64.exponentField, bne_iff_ne]
  omega

theorem floatUpperMulBound (x y : F64) (a b : Nat)
    (hx : F64.isfinite x = true) (hy : F64.isfinite y = true)
    (ha : (F64.toRat x).1.natAbs ≤ (F64.toRat x).2 * 2^a)
    (hb : (F64.toRat y).1.natAbs ≤ (F64.toRat y).2 * 2^b)
    (hab : a+b ≤ 1022) :
    F64.toBits (F64.mul x y) % 2^63 < (a+b+1025)*2^52 := by
  have hxn : F64.isnan x = false := by
    rw [isfinite_iff_not_nan_not_inf] at hx
    simpa only [Bool.not_eq_true'] using (Bool.and_eq_true_iff.mp hx).1
  have hyn : F64.isnan y = false := by
    rw [isfinite_iff_not_nan_not_inf] at hy
    simpa only [Bool.not_eq_true'] using (Bool.and_eq_true_iff.mp hy).1
  have hxi : F64.isinf x = false := by
    rw [isfinite_iff_not_nan_not_inf] at hx
    simpa only [Bool.not_eq_true'] using (Bool.and_eq_true_iff.mp hx).2
  have hyi : F64.isinf y = false := by
    rw [isfinite_iff_not_nan_not_inf] at hy
    simpa only [Bool.not_eq_true'] using (Bool.and_eq_true_iff.mp hy).2
  rw [mul_fin x y hxn hyn hxi hyi]
  apply floatUpperRoundRatBound
  · exact Nat.ne_of_gt (Nat.mul_pos (toRat_den_pos x hx) (toRat_den_pos y hy))
  · exact hab
  · rw [Int.natAbs_mul, Nat.pow_add]
    have hmul := Nat.mul_le_mul ha hb
    simpa only [Nat.mul_assoc, Nat.mul_comm, Nat.mul_left_comm] using hmul


theorem floatUpperAddForm (x y : F64) (hx : F64.isfinite x = true)
    (hy : F64.isfinite y = true) :
    F64.add x y = F64.roundRat
      ((F64.toRat x).1 * ((F64.toRat y).2 : Int) + (F64.toRat y).1 * ((F64.toRat x).2 : Int))
      ((F64.toRat x).2 * (F64.toRat y).2) (F64.signbit x && F64.signbit y) := by
  have hxn : F64.isnan x = false := by
    rw [isfinite_iff_not_nan_not_inf] at hx
    simpa only [Bool.not_eq_true'] using (Bool.and_eq_true_iff.mp hx).1
  have hyn : F64.isnan y = false := by
    rw [isfinite_iff_not_nan_not_inf] at hy
    simpa only [Bool.not_eq_true'] using (Bool.and_eq_true_iff.mp hy).1
  have hxi : F64.isinf x = false := by
    rw [isfinite_iff_not_nan_not_inf] at hx
    simpa only [Bool.not_eq_true'] using (Bool.and_eq_true_iff.mp hx).2
  have hyi : F64.isinf y = false := by
    rw [isfinite_iff_not_nan_not_inf] at hy
    simpa only [Bool.not_eq_true'] using (Bool.and_eq_true_iff.mp hy).2
  simp only [F64.add, hxn, hyn, hxi, hyi, Bool.false_eq_true, ite_false]

theorem floatUpperAddBound (x y : F64) (a : Nat)
    (hx : F64.isfinite x = true) (hy : F64.isfinite y = true)
    (ha : (F64.toRat x).1.natAbs ≤ (F64.toRat x).2 * 2^a)
    (hb : (F64.toRat y).1.natAbs ≤ (F64.toRat y).2 * 2^a)
    (hab : a+1 ≤ 1022) :
    F64.toBits (F64.add x y) % 2^63 < (a+1+1025)*2^52 := by
  rw [floatUpperAddForm x y hx hy]
  apply floatUpperRoundRatBound
  · exact Nat.ne_of_gt (Nat.mul_pos (toRat_den_pos x hx) (toRat_den_pos y hy))
  · exact hab
  · have ht := Int.natAbs_add_le ((F64.toRat x).1 * ((F64.toRat y).2 : Int))
        ((F64.toRat y).1 * ((F64.toRat x).2 : Int))
    simp only [Int.natAbs_mul, Int.natAbs_natCast] at ht
    have hleft : (F64.toRat x).1.natAbs * (F64.toRat y).2 ≤
        (F64.toRat x).2 * (F64.toRat y).2 * 2^a := by
      have hh := Nat.mul_le_mul_right (F64.toRat y).2 ha
      simpa only [Nat.mul_assoc, Nat.mul_comm, Nat.mul_left_comm] using hh
    have hright : (F64.toRat y).1.natAbs * (F64.toRat x).2 ≤
        (F64.toRat x).2 * (F64.toRat y).2 * 2^a := by
      have hh := Nat.mul_le_mul_right (F64.toRat x).2 hb
      simpa only [Nat.mul_assoc, Nat.mul_comm, Nat.mul_left_comm] using hh
    have hsum := Nat.add_le_add hleft hright
    have hbound : (F64.toRat x).2 * (F64.toRat y).2 * 2^a +
        (F64.toRat x).2 * (F64.toRat y).2 * 2^a =
        ((F64.toRat x).2 * (F64.toRat y).2) * 2^(a+1) := by
      rw [Nat.pow_succ, ← Nat.mul_assoc]
      omega
    exact Nat.le_trans ht (hbound ▸ hsum)

end JuliaLean.ChatGPT.Batch10.Group1

-- RoundMonotonePart
namespace JuliaLean.ChatGPT.Batch10.Group1.Scalar.RoundMono
open JuliaLean JuliaLean.Float JuliaLean.Promotion
open JuliaLean.ChatGPT.Batch10.Group1
open Scalar.ProofsBits Scalar.ProofRound
set_option maxRecDepth 10000
set_option maxHeartbeats 2000000
set_option exponentiation.threshold 10000
set_option linter.unusedSimpArgs false

theorem pk_grid_key (s : Bool) (q K : Nat) (hq : q ≤ 2^53) (hK : K ≤ 2044)
    (hlo : 0 < K → 2^52 ≤ q) :
    F64.isfinite (pk s q ((K : Int)-1074)) = true ∧
      key64 (pk s q ((K : Int)-1074)) =
        if s then -((q*2^K : Nat) : Int) else ((q*2^K : Nat) : Int) := by
  by_cases hz : q = 0
  · subst q
    simpa only [pk, beq_iff_eq, ↓reduceIte, Nat.zero_mul, Nat.add_zero, F64.zero]
      using key64_sub s 0 (by decide)
  by_cases ht : q = 2^53
  · subst q
    have hp : pk s (2^53) ((K : Int)-1074) =
        F64.ofBits ((if s then 2^63 else 0)+(K+2)*2^52+((2^52 : Nat)-2^52)) := by
      unfold pk
      rw [ite_f (by decide : ¬((2^53 : Nat) == 0) = true)]
      simp only [show (2^53 : Nat) ≥ 2^53 by decide, ↓reduceIte,
        show (2^53 : Nat) / 2 = 2^52 by decide]
      have he : (K : Int)-1074+1+1075 = (K : Int)+2 := by omega
      rw [he, ite_f (by omega : ¬((K : Int)+2 ≥ 2047)),
        ite_f (by decide : ¬((2^52 : Nat) < 2^52)),
        show ((K : Int)+2).toNat = K+2 by omega, ← Nat.add_assoc]
    rw [hp]
    have hk := key64_norm s (K+2) (2^52) (by omega) (by omega) (by decide) (by decide)
    have hh : 2^52*2^(K+2-1) = (2^53 : Nat)*2^K := by
      rw [show K+2-1 = K+1 by omega, Nat.pow_succ 2 K, ← Nat.mul_assoc,
        Nat.mul_right_comm (2^52) (2^K) 2, show (2^52 : Nat)*2 = 2^53 by decide]
    simpa only [hh] using hk
  by_cases hl : 2^52 ≤ q
  · rw [pk_norm s q ((K : Int)-1074) hl (by omega) (by omega) (by omega),
      show ((K : Int)-1074+1075).toNat = K+1 by omega]
    simpa only [Nat.add_assoc, Nat.add_sub_cancel] using
      key64_norm s (K+1) q (by omega) (by omega) hl (by omega)
  · have hzero : K = 0 := by
      by_cases hh : 0 < K
      · have hb := hlo hh
        omega
      · omega
    subst K
    rw [show ((0 : Nat) : Int)-1074 = -1074 by decide, pk_sub s q (by omega) (by omega)]
    simpa only [Nat.pow_zero, Nat.mul_one] using key64_sub s q (by omega)

def gridScale (n d : Nat) : Nat := (max (fl2 n d+1022) 0).toNat

theorem scale_relation (n d : Nat) :
    max (fl2 n d-52) (-1074) = (gridScale n d : Int)-1074 := by
  unfold gridScale
  omega

theorem grid_bounds (n d : Nat) (hn : 0 < n) (hd : 0 < d) :
    n*2^1074 < (2^53*2^(gridScale n d))*d ∧
    (0 < gridScale n d → (2^52*2^(gridScale n d))*d ≤ n*2^1074) := by
  let e := fl2 n d
  let K := gridScale n d
  let k : Int := (K : Int)-1074
  have hk : max (e-52) (-1074) = k := scale_relation n d
  have hnrm := floatCheckFloorLog2NormalizedNat n d (by omega) (by omega)
  change (if e ≥ 0 then d*2^e.toNat ≤ n ∧ n < 2*(d*2^e.toNat)
    else d ≤ n*2^(-e).toNat ∧ n*2^(-e).toNat < 2*d) at hnrm
  have hu : if e ≥ 0 then n < 2*(d*2^e.toNat) else n*2^(-e).toNat < 2*d := by
    split <;> simp only [* , ↓reduceIte] at hnrm <;> exact hnrm.2
  have hl : if e ≥ 0 then d*2^e.toNat ≤ n else d ≤ n*2^(-e).toNat := by
    split <;> simp only [* , ↓reduceIte] at hnrm <;> exact hnrm.1
  have hsu := floatCheckRescaleUpper n d 52 e k hu (by rw [← hk]; exact Int.le_max_left _ _)
  constructor
  · by_cases hkg : 0 ≤ k
    · simp only [hkg, ↓reduceIte] at hsu
      have hkp : K = k.toNat+1074 := by dsimp only [k] at *; omega
      have hh := Nat.mul_lt_mul_of_pos_right hsu (Nat.two_pow_pos 1074)
      change n*2^1074 < (2^53*2^K)*d
      rw [hkp, Nat.pow_add]
      simpa only [Nat.mul_assoc, Nat.mul_comm, Nat.mul_left_comm] using hh
    · simp only [hkg, ↓reduceIte] at hsu
      have hkp : (-k).toNat+K = 1074 := by dsimp only [k] at *; omega
      have hh := Nat.mul_lt_mul_of_pos_right hsu (Nat.two_pow_pos K)
      rw [Nat.mul_assoc n, ← Nat.pow_add, hkp] at hh
      simpa only [K, Nat.mul_assoc, Nat.mul_comm, Nat.mul_left_comm] using hh
  · intro hK
    have hke : k = e-52 := by
      dsimp only [k, K, gridScale, e] at *
      omega
    have hsl := floatCheckRescaleLower n d 52 e hl
    change (if e-52 ≥ 0 then 2^52*(d*2^(e-52).toNat) ≤ n
      else 2^52*d ≤ n*2^(-(e-52)).toNat) at hsl
    rw [← hke] at hsl
    by_cases hkg : 0 ≤ k
    · simp only [hkg, ↓reduceIte] at hsl
      have hkp : K = k.toNat+1074 := by dsimp only [k] at *; omega
      have hh := Nat.mul_le_mul_right (2^1074) hsl
      change (2^52*2^K)*d ≤ n*2^1074
      rw [hkp, Nat.pow_add]
      simpa only [Nat.mul_assoc, Nat.mul_comm, Nat.mul_left_comm] using hh
    · simp only [hkg, ↓reduceIte] at hsl
      have hkp : (-k).toNat+K = 1074 := by dsimp only [k] at *; omega
      have hh := Nat.mul_le_mul_right (2^K) hsl
      rw [Nat.mul_assoc n, ← Nat.pow_add, hkp] at hh
      simpa only [K, Nat.mul_assoc, Nat.mul_comm, Nat.mul_left_comm] using hh

theorem round_grid (n : Int) (d : Nat) (s : Bool) (hn : n ≠ 0) (hd : 0 < d)
    (hlo : -1075 ≤ fl2 n.natAbs d) (hhi : fl2 n.natAbs d ≤ 1022) :
    F64.isfinite (F64.roundRat n d s) = true ∧
      magKey64 (F64.roundRat n d s) =
        quantizeKey (n.natAbs*2^1074) d (gridScale n.natAbs d) := by
  let K := gridScale n.natAbs d
  have hK : K ≤ 2044 := by dsimp only [K, gridScale]; omega
  have hb := grid_bounds n.natAbs d (by omega) hd
  have hqhi : rq (n.natAbs*2^1074) (d*2^K) ≤ 2^53 := by
    apply rq_upper_bound _ _ _ (Nat.mul_pos hd (Nat.two_pow_pos _))
    simpa only [K, Nat.mul_assoc, Nat.mul_comm, Nat.mul_left_comm] using hb.1
  have hqlo : 0 < K → 2^52 ≤ rq (n.natAbs*2^1074) (d*2^K) := by
    intro hK0
    apply rq_lower_bound _ _ _ (Nat.mul_pos hd (Nat.two_pow_pos _))
    simpa only [K, Nat.mul_assoc, Nat.mul_comm, Nat.mul_left_comm] using hb.2 hK0
  have hround : F64.roundRat n d s =
      pk (decide (n < 0)) (rq (n.natAbs*2^1074) (d*2^K)) ((K : Int)-1074) := by
    rw [roundRat_eq, ite_f (by simp only [beq_iff_eq]; omega),
      ite_f (by simp only [beq_iff_eq]; exact hn), ite_f (by omega), ite_f (by omega), scale_relation]
    change pk (decide (n < 0))
      (rq (if (K : Int)-1074 ≥ 0 then (n.natAbs,d*2^((K : Int)-1074).toNat)
        else (n.natAbs*2^(-((K : Int)-1074)).toNat,d)).1
        (if (K : Int)-1074 ≥ 0 then (n.natAbs,d*2^((K : Int)-1074).toNat)
        else (n.natAbs*2^(-((K : Int)-1074)).toNat,d)).2) _ = _
    by_cases hk : 1074 ≤ K
    · rw [ite_t (by omega : (K : Int)-1074 ≥ 0)]
      simp only [Prod.fst, Prod.snd, show ((K : Int)-1074).toNat = K-1074 by omega]
      have hp : 2^K = (2^1074 : Nat)*2^(K-1074) := by
        rw [← Nat.pow_add]
        congr 1
        omega
      rw [rq_cross_eq n.natAbs (d*2^(K-1074)) (n.natAbs*2^1074) (d*2^K)
        (Nat.mul_pos hd (Nat.two_pow_pos _)) (Nat.mul_pos hd (Nat.two_pow_pos _)) (by
          rw [hp]
          simp only [Nat.mul_assoc, Nat.mul_comm, Nat.mul_left_comm])]
    · rw [ite_f (by omega : ¬((K : Int)-1074 ≥ 0))]
      simp only [Prod.fst, Prod.snd, show (-((K : Int)-1074)).toNat = 1074-K by omega]
      have hp : 2^(1074-K)*2^K = (2^1074 : Nat) := by
        rw [← Nat.pow_add]
        congr 1
        omega
      rw [rq_cross_eq (n.natAbs*2^(1074-K)) d (n.natAbs*2^1074) (d*2^K)
        hd (Nat.mul_pos hd (Nat.two_pow_pos _)) (by
          calc
            (n.natAbs*2^(1074-K))*(d*2^K) = (n.natAbs*d)*(2^(1074-K)*2^K) := by
              simp only [Nat.mul_assoc, Nat.mul_comm, Nat.mul_left_comm]
            _ = (n.natAbs*d)*2^1074 := by rw [hp]
            _ = _ := by simp only [Nat.mul_assoc, Nat.mul_comm, Nat.mul_left_comm])]
  rw [hround]
  obtain ⟨hf, hkey⟩ := pk_grid_key (decide (n < 0)) _ K hqhi hK hqlo
  refine ⟨hf, ?_⟩
  change magKey64 (pk (decide (n < 0)) (rq (n.natAbs*2^1074) (d*2^K)) ((K : Int)-1074)) =
    rq (n.natAbs*2^1074) (d*2^K)*2^K
  have ha := congrArg Int.natAbs hkey
  rw [key64_abs] at ha
  exact ha.trans (signed_natAbs _ _)

theorem magnitude_bits_order (x y : F64) (h : magKey64 x ≤ magKey64 y) :
    F64.toBits x % 2^63 ≤ F64.toBits y % 2^63 := by
  by_cases hb : F64.toBits x % 2^63 ≤ F64.toBits y % 2^63
  · exact hb
  · have hh := KeyOrder.magKey_strictMono double (show F64.toBits y % 2^63 < F64.toBits x % 2^63 by omega)
    rw [← magKey64_eq, ← magKey64_eq] at hh
    omega

theorem round_magnitude_monotone (n m : Int) (d e : Nat) (s t : Bool)
    (hn : n ≠ 0) (hm : m ≠ 0) (hd : 0 < d) (he : 0 < e)
    (hloN : -1075 ≤ fl2 n.natAbs d) (hhiN : fl2 n.natAbs d ≤ 1022)
    (hloM : -1075 ≤ fl2 m.natAbs e) (hhiM : fl2 m.natAbs e ≤ 1022)
    (horder : n.natAbs*e ≤ m.natAbs*d) :
    F64.toBits (F64.roundRat n d s) % 2^63 ≤ F64.toBits (F64.roundRat m e t) % 2^63 := by
  have hN := round_grid n d s hn hd hloN hhiN
  have hM := round_grid m e t hm he hloM hhiM
  apply magnitude_bits_order
  rw [hN.2, hM.2]
  have horder' := Nat.mul_le_mul_right (2^1074) horder
  have hbN := grid_bounds n.natAbs d (by omega) hd
  have hbM := grid_bounds m.natAbs e (by omega) he
  exact quantize_normalized_monotone _ _ _ _ _ _ hd he
    (by simpa only [Nat.mul_assoc, Nat.mul_comm, Nat.mul_left_comm] using horder')
    hbN.1 hbM.1 hbN.2 hbM.2

end JuliaLean.ChatGPT.Batch10.Group1.Scalar.RoundMono

