theorem and_split {i a b c d : Nat} (hb : b < 2^i) (hd : d < 2^i) :
    (2^i*a + b) &&& (2^i*c + d) = 2^i*(a &&& c) + (b &&& d) := by
  apply Nat.eq_of_testBit_eq
  intro j
  rw [Nat.testBit_and, Nat.testBit_two_pow_mul_add _ hb, Nat.testBit_two_pow_mul_add _ hd,
    Nat.testBit_two_pow_mul_add _ (Nat.and_lt_two_pow b hd)]
  split <;> simp [Nat.testBit_and]

theorem or_split {i a b c d : Nat} (hb : b < 2^i) (hd : d < 2^i) :
    (2^i*a + b) ||| (2^i*c + d) = 2^i*(a ||| c) + (b ||| d) := by
  apply Nat.eq_of_testBit_eq
  intro j
  rw [Nat.testBit_or, Nat.testBit_two_pow_mul_add _ hb, Nat.testBit_two_pow_mul_add _ hd,
    Nat.testBit_two_pow_mul_add _ (Nat.or_lt_two_pow hb hd)]
  split <;> simp [Nat.testBit_or]

theorem or_split0 {i b c d : Nat} (hb : b < 2^i) (hd : d < 2^i) :
    b ||| (2^i*c + d) = 2^i*c + (b ||| d) := by
  have h := or_split (a := 0) (c := c) hb hd
  simp only [Nat.mul_zero, Nat.zero_add, Nat.zero_or] at h
  exact h

theorem pack_bits {u K : Nat} (hu : u < 2^64) (hK : K < 2048) :
    Nat.lor (Nat.land u 0x800fffffffffffff) (K * 2^52) = u / 2^63 * 2^63 + K * 2^52 + u % 2^52 := by
  obtain ⟨s, E, f, hs, hE, hf, rfl⟩ : ∃ s E f, s < 2 ∧ E < 2^11 ∧ f < 2^52 ∧
      u = 2^52*(2^11*s + E) + f :=
    ⟨u/2^63, u/2^52%2048, u%2^52, by omega, by omega, by omega, by omega⟩
  have m1 : (0x800fffffffffffff : Nat) = 2^52*(2^11*1 + 0) + (2^52-1) := by decide
  have m2 : K * 2^52 = 2^52*(2^11*0 + K) + 0 := by omega
  show ((2^52*(2^11*s + E) + f) &&& 0x800fffffffffffff) ||| (K * 2^52) = _
  rw [m1, m2, and_split hf (by decide : 2^52 - 1 < 2^52),
    and_split hE (by decide : (0:Nat) < 2^11),
    or_split (Nat.and_lt_two_pow f (by decide : 2^52 - 1 < 2^52)) (by decide : (0:Nat) < 2^52),
    or_split (Nat.and_lt_two_pow E (by decide : (0:Nat) < 2^11)) hK]
  simp only [Nat.and_zero, Nat.zero_or, Nat.or_zero, Nat.and_two_pow_sub_one_eq_mod,
    Nat.mod_eq_of_lt hf, Nat.and_one_is_mod]
  omega

theorem sign_or {u F : Nat} (hu : u < 2^64) (hF : F < 2^63) :
    Nat.lor F (Nat.land u 0x8000000000000000) = u / 2^63 * 2^63 + F := by
  obtain ⟨s, r, hs, hr, rfl⟩ : ∃ s r, s < 2 ∧ r < 2^63 ∧ u = 2^63*s + r :=
    ⟨u/2^63, u%2^63, by omega, by omega, by omega⟩
  have m1 : (0x8000000000000000 : Nat) = 2^63*1 + 0 := by decide
  show F ||| ((2^63*s + r) &&& 0x8000000000000000) = _
  rw [m1, and_split hr (by decide : (0:Nat) < 2^63), Nat.and_zero, Nat.and_one_is_mod,
    or_split0 hF (by decide : (0:Nat) < 2^63), Nat.or_zero]
  omega

theorem wrapU (n : Nat) (h : n < 2^64) : (JInt.wrap .u64 (Int.ofNat n)).val.toNat = n := by
  show ((n : Int) % 2^64).toNat = n
  rw [Int.emod_eq_of_lt (by omega) (by omega)]
  simp

theorem wrapI (a : Int) (h1 : -2^63 ≤ a) (h2 : a < 2^63) : (JInt.wrap .i64 a).val = a := by
  show (a + 2^63) % 2^64 - 2^63 = a
  omega


theorem add_i64_value (a b : JInt .i64) (hlo : -2^63 ≤ a.val+b.val)
    (hhi : a.val+b.val < 2^63) : (a+b).val = a.val+b.val := by
  exact wrapI (a.val+b.val) hlo hhi


theorem lz_val {f : Nat} (h0 : f ≠ 0) (hf : f < 2^52) :
    (if ((JInt.wrap .u64 (Int.ofNat f)).val.toNat == 0) = true then 64
      else 63 - ((JInt.wrap .u64 (Int.ofNat f)).val.toNat).log2) - 11 = 52 - f.log2 := by
  rw [wrapU f (by omega)]
  have c : ¬ ((f == 0) = true) := by simp only [beq_iff_eq]; omega
  rw [ite_f c]
  obtain ⟨h1, -, -⟩ := log2_facts h0 hf
  omega

theorem shl_val {f : Nat} (h0 : f ≠ 0) (hf : f < 2^52) :
    (if 52 - f.log2 ≥ 64 then JInt.wrap .u64 (Int.ofNat 0)
      else JInt.wrap .u64 (Int.ofNat ((JInt.wrap .u64 (Int.ofNat f)).val.toNat <<< (52 - f.log2)))).val.toNat
      = f * 2^(52 - f.log2) := by
  have c : ¬ (52 - f.log2 ≥ 64) := by omega
  rw [ite_f c, wrapU f (by omega), Nat.shiftLeft_eq]
  obtain ⟨-, h2, -⟩ := sub_mant h0 hf
  exact wrapU _ (by omega)

theorem exponent_eq (x : F64) : F64.exponent x =
    if F64.toBits (F64.abs x) ≥ 0x7ff0000000000000 then .error (.domainError "Cannot be NaN or Inf.")
    else if (Int.ofNat (F64.toBits (F64.abs x) >>> 52) == 0) = true then
      (if (F64.toBits (F64.abs x) == 0) = true then .error (.domainError "Cannot be ±0.0.")
       else .ok (1 - Int.ofNat ((if ((JInt.wrap .u64 (Int.ofNat (F64.toBits (F64.abs x)))).val.toNat == 0) = true
          then 64 else 63 - ((JInt.wrap .u64 (Int.ofNat (F64.toBits (F64.abs x)))).val.toNat).log2) - 11) - 1023))
    else .ok (Int.ofNat (F64.toBits (F64.abs x) >>> 52) - 1023) := rfl

theorem exponent_ok (x : F64) (hfin : F64.isfinite x = true) (hz : F64.iszero x = false) :
    F64.exponent x = .ok (if F64.toBits x / 2^52 % 2048 = 0
      then ((F64.toBits x % 2^52).log2 : Int) - 1074
      else ((F64.toBits x / 2^52 % 2048 : Nat) : Int) - 1023) := by
  have ht := tb_lt x
  have hf : ¬ F64.toBits x / 2^52 % 2048 = 2047 := by
    simpa [F64.isfinite, F64.exponentField] using hfin
  have hz' := (iszero_f x).mp hz
  have c1 : ¬ (F64.toBits x % 2^63 ≥ 0x7ff0000000000000) := by omega
  rw [exponent_eq, tb_abs, Nat.shiftRight_eq_div_pow, ite_f c1]
  by_cases hE : F64.toBits x / 2^52 % 2048 = 0
  · have c2 : (Int.ofNat (F64.toBits x % 2^63 / 2^52) == 0) = true := by
      simp only [beq_iff_eq, Int.ofNat_eq_natCast]; omega
    have c3 : ¬ ((F64.toBits x % 2^63 == 0) = true) := by
      simp only [beq_iff_eq]; omega
    have e1 : F64.toBits x % 2^63 = F64.toBits x % 2^52 := by omega
    have hne : F64.toBits x % 2^52 ≠ 0 := by omega
    obtain ⟨h1, -, -⟩ := log2_facts hne (by omega)
    have c4 : ¬ ((F64.toBits x % 2^52 == 0) = true) := by simp only [beq_iff_eq]; omega
    rw [ite_t c2, ite_f c3, wrapU (F64.toBits x % 2^63) (by omega), e1, ite_f c4, ite_t hE,
      Except.ok.injEq, Int.ofNat_eq_natCast]
    omega
  · have c2 : ¬ ((Int.ofNat (F64.toBits x % 2^63 / 2^52) == 0) = true) := by
      simp only [beq_iff_eq, Int.ofNat_eq_natCast]; omega
    rw [ite_f c2, ite_f hE, Except.ok.injEq, Int.ofNat_eq_natCast]
    simp only [Nat.reducePow] at *
    omega


theorem ldexp_norm (x : F64) (e : Int) (h1 : 2^52 ≤ F64.toBits x % 2^63)
    (h2 : F64.toBits x % 2^63 < 0x7ff0000000000000) (he1 : -1100 ≤ e) (he2 : e ≤ 1100) :
    F64.ldexp x e =
      if (((F64.toBits x % 2^63 / 2^52 : Nat) : Int) + e) ≥ 2047 then F64.inf (F64.signbit x)
      else if (((F64.toBits x % 2^63 / 2^52 : Nat) : Int) + e) > 0 then
        F64.ofBits (Nat.lor (Nat.land (F64.toBits x) 0x800fffffffffffff) ((((F64.toBits x % 2^63 / 2^52 : Nat) : Int) + e).toNat * 2^52))
      else if (((F64.toBits x % 2^63 / 2^52 : Nat) : Int) + e) ≤ -53 then F64.zero (F64.signbit x)
      else F64.mul (F64.ofBits (970 * 2^52))
        (F64.ofBits (Nat.lor (Nat.land (F64.toBits x) 0x800fffffffffffff) (((((F64.toBits x % 2^63 / 2^52 : Nat) : Int) + e) + 53).toNat * 2^52))) := by
  have hk0 : (JInt.wrap .i64 (Int.ofNat (F64.toBits (F64.abs x) >>> 52))).val =
      ((F64.toBits x % 2^63 / 2^52 : Nat) : Int) := by
    rw [tb_abs, Nat.shiftRight_eq_div_pow, Int.ofNat_eq_natCast]
    exact wrapI _ (by omega) (by omega)
  have hk : (JInt.wrap .i64 (Int.ofNat (F64.toBits (F64.abs x) >>> 52)) + JInt.wrap .i64 e).val = (((F64.toBits x % 2^63 / 2^52 : Nat) : Int) + e) := by
    show (JInt.wrap .i64 ((JInt.wrap .i64 (Int.ofNat (F64.toBits (F64.abs x) >>> 52))).val +
      (JInt.wrap .i64 e).val)).val = _
    rw [hk0, wrapI e (by omega) (by omega)]
    exact wrapI _ (by omega) (by omega)
  have hk53 : ((JInt.wrap .i64 (Int.ofNat (F64.toBits (F64.abs x) >>> 52)) + JInt.wrap .i64 e) + JInt.wrap .i64 53).val = (((F64.toBits x % 2^63 / 2^52 : Nat) : Int) + e) + 53 := by
    show (JInt.wrap .i64 ((JInt.wrap .i64 (Int.ofNat (F64.toBits (F64.abs x) >>> 52)) + JInt.wrap .i64 e).val + (JInt.wrap .i64 53).val)).val = _
    rw [hk, wrapI 53 (by omega) (by omega)]
    exact wrapI _ (by omega) (by omega)
  have hmax : IntTy.i64.max = 2^63 - 1 := by decide
  have hmin : IntTy.i64.min = -2^63 := by decide
  have c1 : ¬ (F64.toBits (F64.abs x) ≥ 0x7ff0000000000000) := by rw [tb_abs]; omega
  have c2 : ¬ (((JInt.wrap .i64 (Int.ofNat (F64.toBits (F64.abs x) >>> 52))).val == 0) = true) := by
    rw [hk0]; simp only [beq_iff_eq]; omega
  have c3 : ¬ (e > IntTy.i64.max) := by rw [hmax]; omega
  have c4 : ¬ (e < IntTy.i64.min) := by rw [hmin]; omega
  have c5 : ¬ (e > 50000) := by omega
  show (if F64.toBits (F64.abs x) ≥ 0x7ff0000000000000 then x
    else if ((JInt.wrap .i64 (Int.ofNat (F64.toBits (F64.abs x) >>> 52))).val == 0) = true then _
    else if e > IntTy.i64.max then F64.inf (F64.signbit x)
    else if e < IntTy.i64.min then F64.zero (F64.signbit x)
    else if (JInt.wrap .i64 (Int.ofNat (F64.toBits (F64.abs x) >>> 52)) + JInt.wrap .i64 e).val ≥ 2047 then F64.inf (F64.signbit x)
    else if (JInt.wrap .i64 (Int.ofNat (F64.toBits (F64.abs x) >>> 52)) + JInt.wrap .i64 e).val > 0 then
      F64.ofBits (Nat.lor (Nat.land (F64.toBits x) 0x800fffffffffffff) ((JInt.wrap .i64 (Int.ofNat (F64.toBits (F64.abs x) >>> 52)) + JInt.wrap .i64 e).val.toNat <<< 52))
    else if (JInt.wrap .i64 (Int.ofNat (F64.toBits (F64.abs x) >>> 52)) + JInt.wrap .i64 e).val ≤ -53 then
      (if e > 50000 then F64.inf (F64.signbit x) else F64.zero (F64.signbit x))
    else F64.mul (F64.ofBits (970 <<< 52)) (F64.ofBits (Nat.lor (Nat.land (F64.toBits x) 0x800fffffffffffff)
      (((JInt.wrap .i64 (Int.ofNat (F64.toBits (F64.abs x) >>> 52)) + JInt.wrap .i64 e) + JInt.wrap .i64 53).val.toNat <<< 52)))) = _
  rw [ite_f c1, ite_f c2, ite_f c3, ite_f c4, hk53, hk, ite_f c5, Nat.shiftLeft_eq, Nat.shiftLeft_eq,
    Nat.shiftLeft_eq]


theorem exponent_bounds (x : F64) (hfin : F64.isfinite x = true)
    (hz : F64.iszero x = false) :
    ∃ k : Int, F64.exponent x = .ok k ∧ -1074 ≤ k ∧ k ≤ 1023 := by
  refine ⟨_, exponent_ok x hfin hz, ?_⟩
  have he : F64.toBits x / 2^52 % 2048 < 2047 := by
    have hb := Nat.mod_lt (F64.toBits x / 2^52) (by decide : 0 < 2048)
    simp only [F64.isfinite, F64.exponentField, bne_iff_ne] at hfin
    omega
  have hf : (F64.toBits x % 2^52).log2 < 52 := by
    by_cases hzero : F64.toBits x % 2^52 = 0
    · rw [hzero]
      decide
    · exact (Nat.log2_lt hzero).mpr (Nat.mod_lt _ (by decide))
  split <;> constructor <;> omega

theorem nan_finite_false (x : F64) (hn : F64.isnan x = true) :
    F64.isfinite x = false := by
  have he := (isnan_iff x).mp hn
  simp only [F64.isfinite, F64.exponentField, he.1, bne_self_eq_false]

theorem nan_inf_false (x : F64) (hn : F64.isnan x = true) :
    F64.isinf x = false := by
  apply Bool.eq_false_iff.mpr
  intro hi
  have he := (isnan_iff x).mp hn
  have hb := (isinf_iff x).mp hi
  omega

theorem nan_eq_false (x y : F64) (hn : F64.isnan x = true) :
    F64.eq x y = false := by
  simp only [F64.eq, hn, Bool.not_true, Bool.false_and]

theorem nan_lt_false (x y : F64) (hn : F64.isnan x = true) :
    F64.lt x y = false := by
  simp only [F64.lt, hn, Bool.true_or, ite_true]

theorem rescale_inputs_finite (x y : F64)
    (hfirst : (!F64.isfinite (abs2F64 ⟨x, y⟩) &&
      (F64.isinf x || F64.isinf y)) = false)
    (hsecond : (F64.isinf (abs2F64 ⟨x, y⟩) ||
      (F64.eq (abs2F64 ⟨x, y⟩) Fl64.pzero &&
        (!F64.eq x Fl64.pzero || !F64.eq y Fl64.pzero)) ||
      F64.lt (abs2F64 ⟨x, y⟩) (F64.div (F64.nextfloat Fl64.pzero)
        (F64.mul Fl64.two (F64.mul Fl64.eps Fl64.eps)))) = true) :
    F64.isfinite x = true ∧ F64.isfinite y = true := by
  have hnan : F64.isnan (abs2F64 ⟨x, y⟩) = false := by
    apply Bool.eq_false_iff.mpr
    intro hn
    simp only [nan_inf_false _ hn, nan_eq_false _ _ hn, nan_lt_false _ _ hn,
      Bool.false_and, Bool.false_or] at hsecond
    cases hsecond
  have hinputs : F64.isnan x = false ∧ F64.isnan y = false := by
    have hiff := (floatCheckSquaredNormFloat (⟨x, y⟩ : ComplexF64)).1
    simp only [floatCheckNaNSpec] at hiff
    constructor
    · apply Bool.eq_false_iff.mpr
      intro hx
      have := hiff.mpr (Or.inl hx)
      rw [hnan] at this
      cases this
    · apply Bool.eq_false_iff.mpr
      intro hy
      have := hiff.mpr (Or.inr hy)
      rw [hnan] at this
      cases this
  have hinfs : F64.isinf x = false ∧ F64.isinf y = false := by
    by_cases hi : F64.isinf x = true ∨ F64.isinf y = true
    · have hsum_inf : F64.isinf (abs2F64 ⟨x, y⟩) = true := by
        rcases hi with hx | hy
        · have hxz := floatCheckInfNonzero x hx
          have hsx : F64.mul x x = F64.inf false := by
            simp only [F64.mul, hinputs.1, hx, hxz, bne_self_eq_false,
              Bool.false_eq_true, Bool.false_or, Bool.true_or, Bool.false_and,
              Bool.and_false, Bool.or_false, Bool.true_and, ite_true, ite_false]
          have hyn := (floatCheckSquareClass y).1.trans hinputs.2
          have hys := (floatCheckSquareClass y).2 hinputs.2
          change F64.isinf (F64.add (F64.mul x x) (F64.mul y y)) = true
          rw [hsx]
          simp only [F64.add, show F64.isnan (F64.inf false) = false from rfl,
            show F64.isinf (F64.inf false) = true from rfl,
            show F64.signbit (F64.inf false) = false from rfl,
            hyn, hys, bne_self_eq_false, Bool.and_false, Bool.false_eq_true,
            ite_true, ite_false]
        · have hyz := floatCheckInfNonzero y hy
          have hsy : F64.mul y y = F64.inf false := by
            simp only [F64.mul, hinputs.2, hy, hyz, bne_self_eq_false,
              Bool.false_eq_true, Bool.false_or, Bool.true_or, Bool.false_and,
              Bool.and_false, Bool.or_false, Bool.true_and, ite_true, ite_false]
          have hxn := (floatCheckSquareClass x).1.trans hinputs.1
          have hxs := (floatCheckSquareClass x).2 hinputs.1
          change F64.isinf (F64.add (F64.mul x x) (F64.mul y y)) = true
          rw [hsy]
          simp only [F64.add, show F64.isnan (F64.inf false) = false from rfl,
            show F64.isinf (F64.inf false) = true from rfl,
            show F64.signbit (F64.inf false) = false from rfl,
            hxn, hxs, bne_self_eq_false, Bool.and_false, Bool.false_eq_true,
            ite_true, ite_false]
          split
          · assumption
          · rfl
      have hsum_fin : F64.isfinite (abs2F64 ⟨x, y⟩) = false := by
        have he := (isinf_iff _).mp hsum_inf
        simp only [F64.isfinite, F64.exponentField, bne_eq_false_iff_eq]
        omega
      have hior : (F64.isinf x || F64.isinf y) = true :=
        Bool.or_eq_true_iff.mpr hi
      rw [hsum_fin, hior] at hfirst
      cases hfirst
    · exact ⟨Bool.eq_false_iff.mpr (fun h => hi (Or.inl h)),
        Bool.eq_false_iff.mpr (fun h => hi (Or.inr h))⟩
  constructor
  · rw [JuliaLean.Proofs.base.complex.isfinite_iff_not_nan_not_inf,
      hinputs.1, hinfs.1]
    rfl
  · rw [JuliaLean.Proofs.base.complex.isfinite_iff_not_nan_not_inf,
      hinputs.2, hinfs.2]
    rfl

theorem abs_finite (x : F64) (hfin : F64.isfinite x = true) :
    F64.isfinite (F64.abs x) = true := by
  simp only [F64.isfinite, F64.exponentField, bne_iff_ne, tb_abs] at hfin ⊢
  omega

theorem max_selection (x y : F64) : Fl64.max x y = x ∨ Fl64.max x y = y := by
  unfold Fl64.max
  split
  · exact Or.inl rfl
  · split
    · exact Or.inr rfl
    · split
      · exact Or.inr rfl
      · split
        · exact Or.inl rfl
        · split
          · exact Or.inr rfl
          · exact Or.inl rfl

theorem max_abs_finite (x y : F64) (hx : F64.isfinite x = true)
    (hy : F64.isfinite y = true) :
    F64.isfinite (Fl64.max (F64.abs x) (F64.abs y)) = true := by
  rcases max_selection (F64.abs x) (F64.abs y) with h | h
  · rw [h]
    exact abs_finite x hx
  · rw [h]
    exact abs_finite y hy

theorem eq_pzero (x : F64) : F64.eq x Fl64.pzero = F64.iszero x := by
  apply Bool.eq_iff_iff.mpr
  rw [eq_iff, iszero_iff]
  have ht := tb_lt x
  have hz : F64.toBits Fl64.pzero = 0 := rfl
  rw [hz]
  simp only [Nat.zero_div, Nat.zero_mod]
  constructor
  · rintro ⟨_, _, h | ⟨h, _⟩⟩
    · omega
    · exact h
  · intro h
    have he : F64.toBits x / 2^52 % 2048 = 0 := by omega
    refine ⟨by omega, by decide, Or.inr ⟨h, True.intro⟩⟩

theorem wrapped_exponent_value (k : Int) (hlo : -1074 ≤ k) (hhi : k ≤ 1023) :
    (JInt.lit .i64 k).val = k := by
  exact wrapI k (by omega) (by omega)

theorem scaled_total_bounds (x y : F64) :
    ∃ rho : F64, ∃ k : JInt .i64,
      scaledSquaresF64 x y = .ok (rho, k) ∧ -1074 ≤ k.val ∧ k.val ≤ 1023 := by
  unfold scaledSquaresF64
  dsimp only
  split
  · refine ⟨_, _, rfl, ?_, ?_⟩ <;> decide
  · rename_i hfirst
    split
    · rename_i hsecond
      have hfin := rescale_inputs_finite x y (Bool.eq_false_iff.mpr hfirst) hsecond
      have hmfin := max_abs_finite x y hfin.1 hfin.2
      by_cases hmz : F64.eq (Fl64.max (F64.abs x) (F64.abs y)) Fl64.pzero = true
      · simp only [hmz, ite_true, Bind.bind, Pure.pure, Except.bind, Except.pure]
        refine ⟨_, _, rfl, ?_, ?_⟩ <;> decide
      · have hmz' : F64.iszero (Fl64.max (F64.abs x) (F64.abs y)) = false :=
          Bool.eq_false_iff.mpr (by rwa [← eq_pzero])
        obtain ⟨e, he, hlo, hhi⟩ := exponent_bounds _ hmfin hmz'
        simp only [hmz, ite_false, he, Bind.bind, Pure.pure, Except.bind, Except.pure]
        refine ⟨_, _, rfl, ?_, ?_⟩
        · rw [wrapped_exponent_value e hlo hhi]
          exact hlo
        · rw [wrapped_exponent_value e hlo hhi]
          exact hhi
    · refine ⟨_, _, rfl, ?_, ?_⟩ <;> decide

theorem ldexp_zero (x : F64) (e : Int) (hz : F64.iszero x = true) :
    F64.ldexp x e = x := by
  have hzero := (iszero_iff x).mp hz
  change (if F64.toBits (F64.abs x) ≥ 0x7ff0000000000000 then x
    else if (JInt.wrap .i64 (Int.ofNat (F64.toBits (F64.abs x) >>> 52))).val == 0 then
      (if F64.toBits (F64.abs x) == 0 then x else _) else _) = x
  rw [tb_abs, hzero]
  rfl

theorem ldexp_sub (x : F64) (e : Int)
    (h0 : 0 < F64.toBits x % 2^63) (h1 : F64.toBits x % 2^63 < 2^52)
    (he1 : -1100 ≤ e) (he2 : e ≤ 1100) :
    let f : Nat := F64.toBits x % 2^63
    let m : Nat := 52 - f.log2
    let u : Nat := F64.toBits x / 2^63 * 2^63 + f * 2^m
    let E : Int := 1 - (m : Int) + e
    F64.ldexp x e =
      if E ≥ 2047 then F64.inf (F64.signbit x)
      else if E > 0 then
        F64.ofBits (Nat.lor (Nat.land u 0x800fffffffffffff) (E.toNat * 2^52))
      else if E ≤ -53 then F64.zero (F64.signbit x)
      else F64.mul (F64.ofBits (970 * 2^52))
        (F64.ofBits (Nat.lor (Nat.land u 0x800fffffffffffff) ((E+53).toNat * 2^52))) := by
  dsimp only
  have ht := tb_lt x
  have hm : 52 - (F64.toBits x % 2^63).log2 ≤ 52 := by omega
  have hnorm := sub_mant (by omega : F64.toBits x % 2^63 ≠ 0) h1
  have c1 : ¬ F64.toBits x % 2^63 ≥ 0x7ff0000000000000 := by omega
  have c2 : ((JInt.wrap .i64 (Int.ofNat ((F64.toBits x % 2^63) >>> 52))).val == 0) = true := by
    rw [Nat.shiftRight_eq_div_pow, Nat.div_eq_of_lt h1]
    rfl
  have c3 : ¬ ((F64.toBits x % 2^63 == 0) = true) := by simp only [beq_iff_eq]; omega
  change (if F64.toBits (F64.abs x) ≥ 0x7ff0000000000000 then x
    else if (JInt.wrap .i64 (Int.ofNat (F64.toBits (F64.abs x) >>> 52))).val == 0 then
      (if F64.toBits (F64.abs x) == 0 then x else _) else _) = _
  rw [tb_abs, ite_f c1, ite_t c2, ite_f c3]
  change (if e < -50000 then F64.zero (F64.signbit x) else _) = _
  rw [ite_f (by omega : ¬ e < -50000)]
  change (let m := (if ((JInt.wrap .u64 (Int.ofNat (F64.toBits x % 2^63))).val.toNat == 0) = true then 64
      else 63 - ((JInt.wrap .u64 (Int.ofNat (F64.toBits x % 2^63))).val.toNat).log2) - 11
    let u := Nat.lor
      (if m ≥ 64 then JInt.wrap .u64 (Int.ofNat 0)
        else JInt.wrap .u64 (Int.ofNat ((JInt.wrap .u64 (Int.ofNat (F64.toBits x % 2^63))).val.toNat <<< m))).val.toNat
      (Nat.land (F64.toBits x) 0x8000000000000000)
    let k := JInt.wrap .i64 (1 - Int.ofNat m) + JInt.wrap .i64 e
    if e > IntTy.i64.max then F64.inf (F64.signbit x)
    else if e < IntTy.i64.min then F64.zero (F64.signbit x)
    else if k.val ≥ 2047 then F64.inf (F64.signbit x)
    else if k.val > 0 then F64.ofBits (Nat.lor (Nat.land u 0x800fffffffffffff) (k.val.toNat <<< 52))
    else if k.val ≤ -53 then
      (if e > 50000 then F64.inf (F64.signbit x) else F64.zero (F64.signbit x))
    else F64.mul (F64.ofBits (970 <<< 52))
      (F64.ofBits (Nat.lor (Nat.land u 0x800fffffffffffff) ((k + JInt.wrap .i64 53).val.toNat <<< 52)))) = _
  dsimp only
  rw [lz_val (by omega : F64.toBits x % 2^63 ≠ 0) h1,
    shl_val (by omega : F64.toBits x % 2^63 ≠ 0) h1,
    sign_or ht (by omega)]
  have hk0 : (JInt.wrap .i64 (1 - ((52 - (F64.toBits x % 2^63).log2 : Nat) : Int))).val =
      1 - ((52 - (F64.toBits x % 2^63).log2 : Nat) : Int) := by
    exact wrapI _ (by omega) (by omega)
  have hev : (JInt.wrap .i64 e).val = e := wrapI e (by omega) (by omega)
  have h53v : (JInt.wrap .i64 53).val = 53 := wrapI 53 (by omega) (by omega)
  have hk : (JInt.wrap .i64 (1 - ((52 - (F64.toBits x % 2^63).log2 : Nat) : Int)) +
      JInt.wrap .i64 e).val = 1 - ((52 - (F64.toBits x % 2^63).log2 : Nat) : Int) + e := by
    rw [add_i64_value _ _ (by rw [hk0, hev]; omega) (by rw [hk0, hev]; omega), hk0, hev]
  have hk53 : ((JInt.wrap .i64 (1 - ((52 - (F64.toBits x % 2^63).log2 : Nat) : Int)) +
      JInt.wrap .i64 e) + JInt.wrap .i64 53).val =
      1 - ((52 - (F64.toBits x % 2^63).log2 : Nat) : Int) + e + 53 := by
    rw [add_i64_value _ _ (by rw [hk, h53v]; omega) (by rw [hk, h53v]; omega), hk, h53v]
  have c4 : ¬ e > IntTy.i64.max := by change ¬ e > 2^63-1; omega
  have c5 : ¬ e < IntTy.i64.min := by change ¬ e < -2^63; omega
  simp only [Int.ofNat_eq_natCast]
  rw [ite_f c4, ite_f c5, hk53, hk, ite_f (by omega : ¬ e > 50000)]
  simp only [Nat.shiftLeft_eq]

def code (u : Nat) : Int :=
  if u < 2^52 then (u.log2 : Int) - 51 else (u / 2^52 : Nat)

def fraction (u : Nat) : Nat :=
  if u < 2^52 then u * 2^(52-u.log2) - 2^52 else u % 2^52

theorem fraction_lt (u : Nat) (hu : 0 < u) : fraction u < 2^52 := by
  unfold fraction
  split
  · rename_i hsmall
    have hm := sub_mant (by omega : u ≠ 0) hsmall
    omega
  · exact Nat.mod_lt _ (by decide)

theorem code_bounds (u : Nat) (hu : 0 < u) (hfin : u < 2047*2^52) :
    -51 ≤ code u ∧ code u ≤ 2046 := by
  unfold code
  split
  · rename_i hsmall
    have hl := (log2_facts (by omega : u ≠ 0) hsmall).1
    constructor <;> omega
  · constructor <;> omega

theorem code_mono (u v : Nat) (hu : 0 < u) (huv : u ≤ v) : code u ≤ code v := by
  unfold code
  by_cases hus : u < 2^52 <;> by_cases hvs : v < 2^52
  · rw [ite_t hus, ite_t hvs]
    have hl := floatCheckLog2Mono u v (by omega) (by omega) huv
    omega
  · rw [ite_t hus, ite_f hvs]
    have hl := (log2_facts (by omega : u ≠ 0) hus).1
    omega
  · omega
  · rw [ite_f hus, ite_f hvs]
    exact Int.ofNat_le.mpr (Nat.div_le_div_right huv)

theorem exponent_code (x : F64) (hf : F64.isfinite x = true)
    (hz : F64.iszero x = false) :
    F64.exponent x = .ok (code (F64.toBits x % 2^63) - 1023) := by
  rw [exponent_ok x hf hz]
  have ht := tb_lt x
  unfold code
  by_cases hsmall : F64.toBits x % 2^63 < 2^52
  · have he : F64.toBits x / 2^52 % 2048 = 0 := by omega
    have hm : F64.toBits x % 2^52 = F64.toBits x % 2^63 := by omega
    rw [ite_t he, ite_t hsmall, hm]
    congr 1
    omega
  · have he : F64.toBits x / 2^52 % 2048 ≠ 0 := by omega
    rw [ite_f he, ite_f hsmall]
    congr 1
    omega

theorem ldexp_parts (x : F64) (e : Int)
    (hf : F64.isfinite x = true) (hz : F64.iszero x = false)
    (he1 : -1100 ≤ e) (he2 : e ≤ 1100) :
    let E := code (F64.toBits x % 2^63) + e
    let s := F64.toBits x / 2^63 * 2^63
    let f := fraction (F64.toBits x % 2^63)
    F64.ldexp x e =
      if E ≥ 2047 then F64.inf (F64.signbit x)
      else if E > 0 then F64.ofBits (s + E.toNat * 2^52 + f)
      else if E ≤ -53 then F64.zero (F64.signbit x)
      else F64.mul (F64.ofBits (970 * 2^52))
        (F64.ofBits (s + (E+53).toNat * 2^52 + f)) := by
  dsimp only
  have ht := tb_lt x
  have hnz : 0 < F64.toBits x % 2^63 := by
    have := (iszero_f x).mp hz
    omega
  have hfin : F64.toBits x % 2^63 < 2047*2^52 := by
    simp only [F64.isfinite, F64.exponentField, bne_iff_ne] at hf
    omega
  by_cases hsub : F64.toBits x % 2^63 < 2^52
  · have hm := sub_mant (by omega : F64.toBits x % 2^63 ≠ 0) hsub
    have hl := (log2_facts (by omega : F64.toBits x % 2^63 ≠ 0) hsub).1
    have hc : 1 - ((52 - (F64.toBits x % 2^63).log2 : Nat) : Int) + e =
        code (F64.toBits x % 2^63) + e := by
      unfold code
      rw [ite_t hsub]
      omega
    have hp (K : Nat) (hK : K < 2048) :
        Nat.lor (Nat.land (F64.toBits x / 2^63 * 2^63 +
          F64.toBits x % 2^63 * 2^(52-(F64.toBits x % 2^63).log2)) 0x800fffffffffffff)
          (K*2^52) = F64.toBits x / 2^63 * 2^63 + K*2^52 + fraction (F64.toBits x % 2^63) := by
      rw [pack_bits (by omega) hK]
      unfold fraction
      rw [ite_t hsub]
      omega
    rw [ldexp_sub x e hnz hsub he1 he2]
    rw [hc]
    by_cases hover : code (F64.toBits x % 2^63) + e ≥ 2047
    · rw [ite_t hover, ite_t hover]
    · rw [ite_f hover, ite_f hover]
      by_cases hpos : code (F64.toBits x % 2^63) + e > 0
      · rw [ite_t hpos, ite_t hpos, hp _ (by omega)]
      · rw [ite_f hpos, ite_f hpos]
        by_cases hlow : code (F64.toBits x % 2^63) + e ≤ -53
        · rw [ite_t hlow, ite_t hlow]
        · rw [ite_f hlow, ite_f hlow, hp _ (by omega)]
  · have hc : (((F64.toBits x % 2^63 / 2^52 : Nat) : Int) + e) =
        code (F64.toBits x % 2^63) + e := by
      unfold code
      rw [ite_f hsub]
    have hp (K : Nat) (hK : K < 2048) :
        Nat.lor (Nat.land (F64.toBits x) 0x800fffffffffffff) (K*2^52) =
          F64.toBits x / 2^63 * 2^63 + K*2^52 + fraction (F64.toBits x % 2^63) := by
      rw [pack_bits ht hK]
      unfold fraction
      rw [ite_f hsub]
      omega
    rw [ldexp_norm x e (by omega) hfin he1 he2, hc]
    by_cases hover : code (F64.toBits x % 2^63) + e ≥ 2047
    · rw [ite_t hover, ite_t hover]
    · rw [ite_f hover, ite_f hover]
      by_cases hpos : code (F64.toBits x % 2^63) + e > 0
      · rw [ite_t hpos, ite_t hpos, hp _ (by omega)]
      · rw [ite_f hpos, ite_f hpos]
        by_cases hlow : code (F64.toBits x % 2^63) + e ≤ -53
        · rw [ite_t hlow, ite_t hlow]
        · rw [ite_f hlow, ite_f hlow, hp _ (by omega)]

theorem finite_bits (x : F64) (hf : F64.isfinite x = true) :
    F64.toBits x % 2^63 < 2047*2^52 := by
  simp only [F64.isfinite, F64.exponentField, bne_iff_ne] at hf
  omega

theorem finite_not_nan (x : F64) (hf : F64.isfinite x = true) :
    F64.isnan x = false := by
  rw [JuliaLean.Proofs.base.complex.isfinite_iff_not_nan_not_inf] at hf
  simpa only [Bool.not_eq_true'] using (Bool.and_eq_true_iff.mp hf).1

theorem finite_not_inf (x : F64) (hf : F64.isfinite x = true) :
    F64.isinf x = false := by
  rw [JuliaLean.Proofs.base.complex.isfinite_iff_not_nan_not_inf] at hf
  simpa only [Bool.not_eq_true'] using (Bool.and_eq_true_iff.mp hf).2

theorem abs_lt (x y : F64) (hx : F64.isfinite x = true) (hy : F64.isfinite y = true) :
    F64.lt (F64.abs x) (F64.abs y) = decide (F64.toBits x % 2^63 < F64.toBits y % 2^63) := by
  apply Bool.eq_iff_iff.mpr
  rw [lt_iff, tb_abs, tb_abs, decide_eq_true_eq]
  have hxb := finite_bits x hx
  have hyb := finite_bits y hy
  constructor
  · intro h
    omega
  · intro h
    refine ⟨?_, ?_, ?_, Or.inr (Or.inr ⟨?_, ?_, h⟩)⟩ <;> omega

theorem max_abs_bits (x y : F64) (hx : F64.isfinite x = true) (hy : F64.isfinite y = true) :
    F64.toBits (Fl64.max (F64.abs x) (F64.abs y)) =
      max (F64.toBits x % 2^63) (F64.toBits y % 2^63) := by
  have hxn := finite_not_nan (F64.abs x) (abs_finite x hx)
  have hyn := finite_not_nan (F64.abs y) (abs_finite y hy)
  have hxs : F64.signbit (F64.abs x) = false := by
    rw [signbit_f, tb_abs]
    exact Nat.mod_lt _ (by decide)
  unfold Fl64.max
  rw [hxn, hyn, hxs, abs_lt x y hx hy, abs_lt y x hy hx]
  simp only [Bool.false_eq_true, ite_false]
  by_cases hlt : F64.toBits x % 2^63 < F64.toBits y % 2^63
  · rw [ite_t (decide_eq_true hlt), tb_abs]
    exact (Nat.max_eq_right (by omega)).symm
  · rw [ite_f (by simpa only [decide_eq_true_eq] using hlt)]
    by_cases hrev : F64.toBits y % 2^63 < F64.toBits x % 2^63
    · rw [ite_t (decide_eq_true hrev), tb_abs]
      exact (Nat.max_eq_left (by omega)).symm
    · rw [ite_f (by simpa only [decide_eq_true_eq] using hrev), tb_abs]
      exact (Nat.max_eq_left (by omega)).symm

theorem max_abs_zero (x y : F64) (hx : F64.isfinite x = true) (hy : F64.isfinite y = true) :
    F64.iszero (Fl64.max (F64.abs x) (F64.abs y)) = true ↔
      F64.iszero x = true ∧ F64.iszero y = true := by
  rw [iszero_iff, max_abs_bits x y hx hy, iszero_iff, iszero_iff]
  have hmax : max (F64.toBits x % 2^63) (F64.toBits y % 2^63) < 2^63 := by
    exact Nat.max_lt.mpr ⟨Nat.mod_lt _ (by decide), Nat.mod_lt _ (by decide)⟩
  rw [Nat.mod_eq_of_lt hmax]
  omega

theorem encoded_mag (x : F64) (E f : Nat) (hE : E < 2048) (hf : f < 2^52) :
    F64.toBits (F64.ofBits (F64.toBits x / 2^63 * 2^63 + E*2^52+f)) % 2^63 =
      E*2^52+f := by
  have ht := tb_lt x
  rw [tb_ofBits]
  omega

theorem ldexp_bound (x : F64) (e : Int) (hf : F64.isfinite x = true)
    (he1 : -1100 ≤ e) (he2 : e ≤ 1100)
    (hbound : code (F64.toBits x % 2^63) + e ≤ 1023) :
    F64.toBits (F64.ldexp x e) % 2^63 < 1025*2^52 := by
  by_cases hz : F64.iszero x = true
  · rw [ldexp_zero x e hz, (iszero_iff x).mp hz]
    decide
  · have hzf : F64.iszero x = false := Bool.eq_false_iff.mpr hz
    have hm : fraction (F64.toBits x % 2^63) < 2^52 :=
      fraction_lt _ (by have := (iszero_f x).mp hzf; omega)
    rw [ldexp_parts x e hf hzf he1 he2]
    rw [ite_f (by omega : ¬ code (F64.toBits x % 2^63) + e ≥ 2047)]
    by_cases hpos : code (F64.toBits x % 2^63) + e > 0
    · rw [ite_t hpos, encoded_mag x _ _ (by omega) hm]
      omega
    · rw [ite_f hpos]
      by_cases hlow : code (F64.toBits x % 2^63) + e ≤ -53
      · rw [ite_t hlow]
        cases F64.signbit x <;> decide
      · rw [ite_f hlow]
        let y := F64.ofBits (F64.toBits x / 2^63 * 2^63 +
          (code (F64.toBits x % 2^63) + e + 53).toNat * 2^52 + fraction (F64.toBits x % 2^63))
        have hybits : F64.toBits y % 2^63 =
            (code (F64.toBits x % 2^63) + e + 53).toNat * 2^52 + fraction (F64.toBits x % 2^63) :=
          encoded_mag x _ _ (by omega) hm
        have hyfin : F64.isfinite y = true := floatUpperFiniteOfBits y (by rw [hybits]; omega)
        have hyval := floatUpperRatBound y 0 hyfin (by
          have ht := tb_lt y
          omega)
        have hzfin : F64.isfinite (F64.ofBits (970*2^52)) = true := by decide
        have hzval := floatUpperRatBound (F64.ofBits (970*2^52)) 0 hzfin (by decide)
        exact floatUpperMulBound (F64.ofBits (970*2^52)) y 0 0 hzfin hyfin hzval hyval (by decide)

theorem ldexp_normalized (x : F64) (e : Int) (hf : F64.isfinite x = true)
    (hz : F64.iszero x = false) (he1 : -1100 ≤ e) (he2 : e ≤ 1100)
    (hcode : code (F64.toBits x % 2^63) + e = 1023) :
    1023*2^52 ≤ F64.toBits (F64.ldexp x e) % 2^63 ∧
      F64.toBits (F64.ldexp x e) % 2^63 < 1024*2^52 := by
  have hm : fraction (F64.toBits x % 2^63) < 2^52 :=
    fraction_lt _ (by have := (iszero_f x).mp hz; omega)
  rw [ldexp_parts x e hf hz he1 he2]
  rw [hcode]
  simp only [show ¬ (1023 : Int) ≥ 2047 by decide, show (1023 : Int) > 0 by decide,
    ite_true, ite_false]
  rw [show (1023 : Int).toNat = 1023 from rfl, encoded_mag x 1023 _ (by decide) hm]
  constructor <;> omega

theorem negative_scale_value (e : Int) (hlo : -1074 ≤ e) (hhi : e ≤ 1023) :
    (-(JInt.lit .i64 e)).val = -e := by
  change (JInt.wrap .i64 (-(JInt.wrap .i64 e).val)).val = -e
  rw [wrapI e (by omega) (by omega)]
  exact wrapI (-e) (by omega) (by omega)

theorem rat_at_least_one (x : F64) (hf : F64.isfinite x = true)
    (hmag : 1023*2^52 ≤ F64.toBits x % 2^63) :
    (F64.toRat x).2 ≤ (F64.toRat x).1.natAbs := by
  have he : 1023 ≤ F64.toBits x / 2^52 % 2048 := by omega
  have hupper : F64.toBits x / 2^52 % 2048 ≤ 2046 := by
    have hb := finite_bits x hf
    omega
  have hm : 2^52 ≤ F64.toBits x % 2^52 + 2^52 := by omega
  have habs : (if F64.signbit x then -((F64.toBits x % 2^52 + 2^52 : Nat) : Int)
      else ((F64.toBits x % 2^52 + 2^52 : Nat) : Int)).natAbs =
      F64.toBits x % 2^52 + 2^52 := by
    cases F64.signbit x <;> simp only [Bool.false_eq_true, ite_false, ite_true,
      Int.natAbs_neg, Int.natAbs_natCast]
  by_cases hsmall : F64.toBits x / 2^52 % 2048 ≤ 1074
  · rw [toRat_norm x (by omega) hsmall]
    change 2^(1075 - F64.toBits x / 2^52 % 2048) ≤ _
    rw [habs]
    exact Nat.le_trans (Nat.pow_le_pow_right (by decide) (by omega)) hm
  · rw [toRat_big x (by omega) hupper]
    simp only [Int.natAbs_mul, Int.natAbs_natCast, habs]
    exact Nat.mul_pos (by omega) (Nat.two_pow_pos _)

theorem square_large_nonzero (x : F64) (hf : F64.isfinite x = true)
    (hmag : 1023*2^52 ≤ F64.toBits x % 2^63) :
    F64.iszero (F64.mul x x) = false := by
  have hr := rat_at_least_one x hf hmag
  rw [mul_fin x x (finite_not_nan x hf) (finite_not_nan x hf)
    (finite_not_inf x hf) (finite_not_inf x hf)]
  apply Reciprocal.round_nonzero
  · exact Nat.mul_pos (toRat_den_pos x hf) (toRat_den_pos x hf)
  · rw [Int.natAbs_mul]
    calc
      (F64.toRat x).2 * (F64.toRat x).2 ≤
          (F64.toRat x).1.natAbs * (F64.toRat x).1.natAbs := Nat.mul_le_mul hr hr
      _ ≤ ((F64.toRat x).1.natAbs * (F64.toRat x).1.natAbs) * 2^1074 := by
        have hp := Nat.mul_le_mul_left ((F64.toRat x).1.natAbs * (F64.toRat x).1.natAbs)
          (show 1 ≤ 2^1074 by decide)
        simpa only [Nat.mul_one] using hp

theorem add_positive_nonzero (x y : F64) (hx : F64.isfinite x = true)
    (hy : F64.isfinite y = true) (hsx : F64.signbit x = false) (hsy : F64.signbit y = false)
    (hz : F64.iszero x = false ∨ F64.iszero y = false) :
    F64.iszero (F64.add x y) = false := by
  have hnx := floatCheckPositiveNumerator x hsx
  have hny := floatCheckPositiveNumerator y hsy
  rw [floatUpperAddForm x y hx hy]
  apply Reciprocal.round_nonzero
  · exact Nat.mul_pos (toRat_den_pos x hx) (toRat_den_pos y hy)
  · rw [Int.natAbs_add_of_nonneg (Int.mul_nonneg hnx (by omega))
      (Int.mul_nonneg hny (by omega)), Int.natAbs_mul, Int.natAbs_mul,
      Int.natAbs_natCast, Int.natAbs_natCast]
    rcases hz with hzx | hzy
    · have hmin := Reciprocal.rational_minimum x hx hzx
      calc
        (F64.toRat x).2 * (F64.toRat y).2 ≤
            ((F64.toRat x).1.natAbs*2^1074) * (F64.toRat y).2 := Nat.mul_le_mul_right _ hmin
        _ = ((F64.toRat x).1.natAbs * (F64.toRat y).2)*2^1074 := by
          simp only [Nat.mul_assoc, Nat.mul_comm, Nat.mul_left_comm]
        _ ≤ ((F64.toRat x).1.natAbs * (F64.toRat y).2 +
            (F64.toRat y).1.natAbs * (F64.toRat x).2)*2^1074 := Nat.mul_le_mul_right _ (by omega)
    · have hmin := Reciprocal.rational_minimum y hy hzy
      calc
        (F64.toRat x).2 * (F64.toRat y).2 ≤
            (F64.toRat x).2 * ((F64.toRat y).1.natAbs*2^1074) := Nat.mul_le_mul_left _ hmin
        _ = ((F64.toRat y).1.natAbs * (F64.toRat x).2)*2^1074 := by
          simp only [Nat.mul_assoc, Nat.mul_comm, Nat.mul_left_comm]
        _ ≤ ((F64.toRat x).1.natAbs * (F64.toRat y).2 +
            (F64.toRat y).1.natAbs * (F64.toRat x).2)*2^1074 := Nat.mul_le_mul_right _ (by omega)

theorem sum_small_class (x y : F64)
    (hx : F64.toBits x % 2^63 < 1025*2^52)
    (hy : F64.toBits y % 2^63 < 1025*2^52)
    (hlarge : 1023*2^52 ≤ F64.toBits x % 2^63 ∨
      1023*2^52 ≤ F64.toBits y % 2^63) :
    F64.isfinite (abs2F64 ⟨x, y⟩) = true ∧
      F64.signbit (abs2F64 ⟨x, y⟩) = false ∧ F64.iszero (abs2F64 ⟨x, y⟩) = false := by
  have hxf := floatUpperFiniteOfBits x (by omega)
  have hyf := floatUpperFiniteOfBits y (by omega)
  have hxrat := floatUpperRatBound x 2 hxf (by omega)
  have hyrat := floatUpperRatBound y 2 hyf (by omega)
  have hxx := floatUpperMulBound x x 2 2 hxf hxf hxrat hxrat (by decide)
  have hyy := floatUpperMulBound y y 2 2 hyf hyf hyrat hyrat (by decide)
  have hxxf := floatUpperFiniteOfBits (F64.mul x x) (by omega)
  have hyyf := floatUpperFiniteOfBits (F64.mul y y) (by omega)
  have hxxrat := floatUpperRatBound (F64.mul x x) 6 hxxf (by omega)
  have hyyrat := floatUpperRatBound (F64.mul y y) 6 hyyf (by omega)
  have hsum := floatUpperAddBound (F64.mul x x) (F64.mul y y) 6 hxxf hyyf hxxrat hyyrat (by decide)
  have hsumf := floatUpperFiniteOfBits (abs2F64 ⟨x, y⟩) (by change _ < _; exact Nat.lt_trans hsum (by decide))
  have hxxs := (floatCheckSquareClass x).2 (finite_not_nan x hxf)
  have hyys := (floatCheckSquareClass y).2 (finite_not_nan y hyf)
  refine ⟨hsumf, ?_, ?_⟩
  · exact (floatCheckAddPositive (F64.mul x x) (F64.mul y y)
      (finite_not_nan _ hxxf) (finite_not_nan _ hyyf) hxxs hyys).2
  · apply add_positive_nonzero _ _ hxxf hyyf hxxs hyys
    rcases hlarge with h | h
    · exact Or.inl (square_large_nonzero x hxf h)
    · exact Or.inr (square_large_nonzero y hyf h)

theorem zero_value (x : F64) (hz : F64.iszero x = true) : x = F64.zero (F64.signbit x) := by
  apply f64_ext
  have ht := tb_lt x
  have hb := (iszero_iff x).mp hz
  cases hs : F64.signbit x
  · have hsign := (signbit_f x).mp hs
    change F64.toBits x = 0
    omega
  · have hsign := (signbit_iff x).mp hs
    change F64.toBits x = 2^63
    omega

theorem sum_zero (x y : F64) (hx : F64.iszero x = true) (hy : F64.iszero y = true) :
    abs2F64 ⟨x, y⟩ = F64.zero false := by
  rw [zero_value x hx, zero_value y hy]
  cases F64.signbit x <;> cases F64.signbit y <;> decide

theorem normalized_pair (x y : F64) (e : Int)
    (hx : F64.isfinite x = true) (hy : F64.isfinite y = true)
    (hmz : F64.iszero (Fl64.max (F64.abs x) (F64.abs y)) = false)
    (he : F64.exponent (Fl64.max (F64.abs x) (F64.abs y)) = .ok e)
    (hlo : -1074 ≤ e) (hhi : e ≤ 1023) :
    F64.toBits (F64.ldexp x (-e)) % 2^63 < 1025*2^52 ∧
      F64.toBits (F64.ldexp y (-e)) % 2^63 < 1025*2^52 ∧
      (1023*2^52 ≤ F64.toBits (F64.ldexp x (-e)) % 2^63 ∨
        1023*2^52 ≤ F64.toBits (F64.ldexp y (-e)) % 2^63) := by
  have hmf := max_abs_finite x y hx hy
  have hmax : max (F64.toBits x % 2^63) (F64.toBits y % 2^63) < 2^63 :=
    Nat.max_lt.mpr ⟨Nat.mod_lt _ (by decide), Nat.mod_lt _ (by decide)⟩
  have hmagm : F64.toBits (Fl64.max (F64.abs x) (F64.abs y)) % 2^63 =
      max (F64.toBits x % 2^63) (F64.toBits y % 2^63) := by
    rw [max_abs_bits x y hx hy, Nat.mod_eq_of_lt hmax]
  have hmp : 0 < max (F64.toBits x % 2^63) (F64.toBits y % 2^63) := by
    have hh := (iszero_f _).mp hmz
    rw [hmagm] at hh
    omega
  have hmc := (code_bounds _ hmp (by
    have hh := finite_bits _ hmf
    rw [hmagm] at hh
    exact hh)).1
  have heq : e = code (max (F64.toBits x % 2^63) (F64.toBits y % 2^63)) - 1023 := by
    have hh := exponent_code _ hmf hmz
    rw [he, hmagm] at hh
    exact Except.ok.inj hh
  have hcx : code (F64.toBits x % 2^63) ≤
      code (max (F64.toBits x % 2^63) (F64.toBits y % 2^63)) := by
    by_cases hz : F64.toBits x % 2^63 = 0
    · rw [hz]
      change -51 ≤ _
      rw [hz] at hmc
      exact hmc
    · exact code_mono _ _ (by omega) (Nat.le_max_left _ _)
  have hcy : code (F64.toBits y % 2^63) ≤
      code (max (F64.toBits x % 2^63) (F64.toBits y % 2^63)) := by
    by_cases hz : F64.toBits y % 2^63 = 0
    · rw [hz]
      change -51 ≤ _
      rw [hz] at hmc
      exact hmc
    · exact code_mono _ _ (by omega) (Nat.le_max_right _ _)
  refine ⟨ldexp_bound x (-e) hx (by omega) (by omega) (by omega),
    ldexp_bound y (-e) hy (by omega) (by omega) (by omega), ?_⟩
  by_cases hxy : F64.toBits x % 2^63 ≤ F64.toBits y % 2^63
  · rw [Nat.max_eq_right hxy] at heq hmp
    have hyz : F64.iszero y = false := (iszero_f y).mpr (by omega)
    exact Or.inr (ldexp_normalized y (-e) hy hyz (by omega) (by omega) (by omega)).1
  · have hyx : F64.toBits y % 2^63 ≤ F64.toBits x % 2^63 := by omega
    rw [Nat.max_eq_left hyx] at heq hmp
    have hxz : F64.iszero x = false := (iszero_f x).mpr (by omega)
    exact Or.inl (ldexp_normalized x (-e) hx hxz (by omega) (by omega) (by omega)).1

theorem unscaled_finite_class (x y : F64)
    (hx : F64.isfinite x = true) (hy : F64.isfinite y = true)
    (hguard : (F64.isinf (abs2F64 ⟨x, y⟩) ||
      (F64.eq (abs2F64 ⟨x, y⟩) Fl64.pzero &&
        (!F64.eq x Fl64.pzero || !F64.eq y Fl64.pzero)) ||
      F64.lt (abs2F64 ⟨x, y⟩) (F64.div (F64.nextfloat Fl64.pzero)
        (F64.mul Fl64.two (F64.mul Fl64.eps Fl64.eps)))) = false) :
    F64.isfinite (abs2F64 ⟨x, y⟩) = true ∧ F64.signbit (abs2F64 ⟨x, y⟩) = false ∧
      (F64.iszero (abs2F64 ⟨x, y⟩) = true ↔ F64.iszero x = true ∧ F64.iszero y = true) := by
  have hxn := finite_not_nan x hx
  have hyn := finite_not_nan y hy
  have hxx := floatCheckSquareClass x
  have hyy := floatCheckSquareClass y
  have hsum := floatCheckAddPositive (F64.mul x x) (F64.mul y y)
    (hxx.1.trans hxn) (hyy.1.trans hyn) (hxx.2 hxn) (hyy.2 hyn)
  change F64.isnan (abs2F64 ⟨x, y⟩) = false ∧ F64.signbit (abs2F64 ⟨x, y⟩) = false at hsum
  have hsplit := Bool.or_eq_false_iff.mp (Bool.or_eq_false_iff.mp hguard).1
  have hrhofin : F64.isfinite (abs2F64 ⟨x, y⟩) = true := by
    rw [JuliaLean.Proofs.base.complex.isfinite_iff_not_nan_not_inf, hsum.1, hsplit.1]
    rfl
  refine ⟨hrhofin, hsum.2, ?_⟩
  constructor
  · intro hz
    have hh := hsplit.2
    rw [eq_pzero, hz, Bool.true_and, eq_pzero, eq_pzero] at hh
    have hh' := Bool.or_eq_false_iff.mp hh
    exact ⟨by simpa only [Bool.not_eq_false'] using hh'.1,
      by simpa only [Bool.not_eq_false'] using hh'.2⟩
  · intro ⟨hxz, hyz⟩
    rw [sum_zero x y hxz hyz]
    rfl

end Scale

theorem Models1G19ScaledSquaresClassification_proven :
    JuliaLean.Proofs.base.complex.Models1Group19.ScaledSquaresClassification := by
  intro x y
  unfold scaledSquaresF64
  dsimp only
  by_cases hfirst : (!F64.isfinite (F64.add (F64.mul x x) (F64.mul y y)) &&
      (F64.isinf x || F64.isinf y)) = true
  · simp only [hfirst, ite_true, Pure.pure, Except.pure]
    refine ⟨by decide, by decide, ?_⟩
    intro ⟨hx, hy⟩
    have hix := Scale.finite_not_inf x hx
    have hiy := Scale.finite_not_inf y hy
    simp only [hix, hiy, Bool.false_or, Bool.and_false] at hfirst
    cases hfirst
  · simp only [hfirst, Bool.false_eq_true, ite_false]
    by_cases hsecond : (F64.isinf (F64.add (F64.mul x x) (F64.mul y y)) ||
      (F64.eq (F64.add (F64.mul x x) (F64.mul y y)) Fl64.pzero &&
        (!F64.eq x Fl64.pzero || !F64.eq y Fl64.pzero)) ||
      F64.lt (F64.add (F64.mul x x) (F64.mul y y))
        (F64.div (F64.nextfloat Fl64.pzero) (F64.mul Fl64.two (F64.mul Fl64.eps Fl64.eps)))) = true
    · simp only [hsecond, ite_true]
      have hfin := Scale.rescale_inputs_finite x y (Bool.eq_false_iff.mpr hfirst) hsecond
      have hmfin := Scale.max_abs_finite x y hfin.1 hfin.2
      by_cases hmz : F64.eq (Fl64.max (F64.abs x) (F64.abs y)) Fl64.pzero = true
      · have hmzero : F64.iszero (Fl64.max (F64.abs x) (F64.abs y)) = true := by
          rwa [Scale.eq_pzero] at hmz
        have hzeros := (Scale.max_abs_zero x y hfin.1 hfin.2).mp hmzero
        simp only [hmz, ite_true, Bind.bind, Pure.pure, Except.bind, Except.pure]
        refine ⟨by decide, by decide, ?_⟩
        intro _
        rw [Scale.ldexp_zero x _ hzeros.1, Scale.ldexp_zero y _ hzeros.2]
        have hsumzero : F64.add (F64.mul x x) (F64.mul y y) = F64.zero false :=
          Scale.sum_zero x y hzeros.1 hzeros.2
        rw [hsumzero, hzeros.1, hzeros.2]
        decide
      · have hmz' : F64.iszero (Fl64.max (F64.abs x) (F64.abs y)) = false :=
          Bool.eq_false_iff.mpr (by rwa [← Scale.eq_pzero])
        obtain ⟨e, he, hlo, hhi⟩ := Scale.exponent_bounds _ hmfin hmz'
        simp only [hmz, Bool.false_eq_true, ite_false, he, Bind.bind, Pure.pure, Except.bind, Except.pure]
        rw [Scale.wrapped_exponent_value e hlo hhi, Scale.negative_scale_value e hlo hhi]
        refine ⟨hlo, hhi, ?_⟩
        intro _
        have hb := Scale.normalized_pair x y e hfin.1 hfin.2 hmz' he hlo hhi
        have hs := Scale.sum_small_class (F64.ldexp x (-e)) (F64.ldexp y (-e)) hb.1 hb.2.1 hb.2.2
        refine ⟨hs.1, hs.2.1, ?_⟩
        constructor
        · intro h
          change F64.iszero (abs2F64 ⟨F64.ldexp x (-e), F64.ldexp y (-e)⟩) = true at h
          rw [hs.2.2] at h
          cases h
        · intro h
          have hmztrue := (Scale.max_abs_zero x y hfin.1 hfin.2).mpr h
          rw [hmz'] at hmztrue
          cases hmztrue
    · simp only [hsecond, Bool.false_eq_true, ite_false, Pure.pure, Except.pure]
      refine ⟨by decide, by decide, ?_⟩
      intro ⟨hx, hy⟩
      exact Scale.unscaled_finite_class x y hx hy (Bool.eq_false_iff.mpr hsecond)

end JuliaLean.ChatGPT.Batch10.Group1

-- SmallReciprocalPart
namespace JuliaLean.ChatGPT.Batch10.Group1
open JuliaLean JuliaLean.Float JuliaLean.Promotion JuliaLean.base.complex
open JuliaLean.Proofs.base.complex
open JuliaLean.base.complex.Models1Group19
open JuliaLean.Proofs.base.complex.Models1Group19
set_option maxRecDepth 100000
set_option maxHeartbeats 10000000
set_option exponentiation.threshold 5000

/-- The two widened implementations use the corresponding exact rational rounder. -/
def floatCheckWideRound : (k : SmallFloatKind) → Int → Nat → Bool → WideValue k
  | .f16, n, d, s => Fl.roundRat n d s
  | .f32, n, d, s => Fl.ofF64 (F64.roundRat n d s)

theorem floatCheckOfF64RoundRatBounded (n : Int) (d lo hi : Nat) (s : Bool)
    (hb : floatCheckRatBounds lo hi n d) (hlo : lo + 2 ≤ 1023) :
    Fl.ofF64 (F64.roundRat n d s) = (Fl.roundRat n d s : Fl double) := by
  have hd : d ≠ 0 := by have := hb.1; omega
  by_cases hn : n = 0
  · have hdb : (d == 0) = false := beq_eq_false_iff_ne.mpr hd
    have hgen : (Fl.roundRat n d s : Fl double) = Fl.zero s := by
      simp only [Fl.roundRat, hdb, hn, beq_self_eq_true, Bool.false_eq_true, ↓reduceIte]
    have hf64 : F64.roundRat n d s = F64.zero s := by
      rw [f64_roundRat_eq]
      simp only [hdb, hn, beq_self_eq_true, Bool.false_eq_true, ↓reduceIte]
    rw [hgen, hf64, ← floatCheckFlToF64Zero, floatCheckFlOfToF64]
  · have ha : n.natAbs ≠ 0 := by omega
    have he := floatCheckFloorLogBounds n.natAbs d lo hi ha hd (hb.2.2 hn) hb.2.1
    rw [← floatCheckFlToF64RoundRat n d s (by omega), floatCheckFlOfToF64]

theorem floatCheckWideRoundBounded (k : SmallFloatKind) (n : Int) (d lo hi : Nat) (s : Bool)
    (hb : floatCheckRatBounds lo hi n d)
    (flo : lo + 2 ≤ (wideFormat k).bias)
    (fhi : hi + (wideFormat k).bias + 1 < (wideFormat k).emax) :
    floatCheckFlBounds (wideFormat k) (lo + 1) (hi + 2) (floatCheckWideRound k n d s) ∧
      ((floatCheckWideRound k n d s).iszero = true ↔ n = 0) := by
  cases k with
  | f16 => exact floatCheckFlRoundRatBounded single n d lo hi s hb flo fhi
  | f32 =>
    change floatCheckFlBounds double (lo + 1) (hi + 2) (Fl.ofF64 (F64.roundRat n d s)) ∧
      ((Fl.ofF64 (F64.roundRat n d s)).iszero = true ↔ n = 0)
    rw [floatCheckOfF64RoundRatBounded n d lo hi s hb flo]
    exact floatCheckFlRoundRatBounded double n d lo hi s hb flo fhi

theorem floatCheckWideRoundNotNan (k : SmallFloatKind) (n : Int) (d : Nat) (s : Bool)
    (hd : d ≠ 0) : (floatCheckWideRound k n d s).isnan = false := by
  cases k with
  | f16 => exact floatCheckFlRoundRatNotNan single (by decide) n d s hd
  | f32 =>
    change (Fl.ofF64 (F64.roundRat n d s)).isnan = false
    rw [(floatCheckFlOfF64Classes _).2.1]
    exact (floatCheckRoundRatClass n d s hd).1

theorem floatCheckF64FiniteClasses (x : F64) (hf : F64.isfinite x = true) :
    F64.isnan x = false ∧ F64.isinf x = false := by
  rw [isfinite_iff_not_nan_not_inf] at hf
  cases hn : F64.isnan x <;> cases hi : F64.isinf x <;>
    simp only [hn, hi, Bool.not_false, Bool.not_true, Bool.true_and, Bool.false_and, Bool.false_eq_true] at hf ⊢
  exact ⟨True.intro, True.intro⟩

/-- Finite widened multiplication executes exactly the rounded rational product. -/
theorem floatCheckWideMultiplyFinite (k : SmallFloatKind) (x y : WideValue k)
    (hx : x.isfinite = true) (hy : y.isfinite = true) :
    wideMultiply k x y = floatCheckWideRound k (x.toRat.1 * y.toRat.1)
      (x.toRat.2 * y.toRat.2) (x.signbit != y.signbit) := by
  cases k with
  | f16 =>
    change Fl single at x y
    obtain ⟨hxn, hxi⟩ := floatCheckFlFiniteClasses single x hx
    obtain ⟨hyn, hyi⟩ := floatCheckFlFiniteClasses single y hy
    change multiplyFloatAt (f := single) x y = Fl.roundRat (x.toRat.1 * y.toRat.1)
      (x.toRat.2 * y.toRat.2) (x.signbit != y.signbit)
    simp only [multiplyFloatAt, hxn, hyn, hxi, hyi, Bool.false_eq_true,
      Bool.false_and, Bool.false_or, ↓reduceIte, floatCheckWideRound]
  | f32 =>
    change Fl double at x y
    have hxf := (floatCheckFlToF64Classes x).1.trans hx
    have hyf := (floatCheckFlToF64Classes y).1.trans hy
    obtain ⟨hxn, hxi⟩ := floatCheckF64FiniteClasses (Fl.toF64 x) hxf
    obtain ⟨hyn, hyi⟩ := floatCheckF64FiniteClasses (Fl.toF64 y) hyf
    change Fl.ofF64 (F64.mul (Fl.toF64 x) (Fl.toF64 y)) =
      Fl.ofF64 (F64.roundRat (x.toRat.1 * y.toRat.1) (x.toRat.2 * y.toRat.2) (x.signbit != y.signbit))
    simp only [F64.mul, hxn, hyn, hxi, hyi, Bool.false_eq_true,
      Bool.false_and, Bool.and_false, Bool.false_or, ↓reduceIte, floatCheckWideRound,
      floatCheckFlToF64Rat, (floatCheckFlToF64Classes x).2.2.2.1,
      (floatCheckFlToF64Classes y).2.2.2.1]

theorem floatCheckWideMultiplyBounds (k : SmallFloatKind) (x y : WideValue k)
    (lo hi lo' hi' : Nat) (hx : floatCheckFlBounds (wideFormat k) lo hi x)
    (hy : floatCheckFlBounds (wideFormat k) lo' hi' y)
    (flo : lo + lo' + 2 ≤ (wideFormat k).bias)
    (fhi : hi + hi' + (wideFormat k).bias + 1 < (wideFormat k).emax) :
    floatCheckFlBounds (wideFormat k) (lo + lo' + 1) (hi + hi' + 2) (wideMultiply k x y) ∧
      ((wideMultiply k x y).iszero = true ↔ x.iszero = true ∨ y.iszero = true) := by
  rw [floatCheckWideMultiplyFinite k x y hx.1 hy.1]
  have hb := floatCheckRatBoundsMul hx.2 hy.2
  obtain ⟨hb', hz⟩ := floatCheckWideRoundBounded k _ _ _ _ _ hb flo fhi
  refine ⟨hb', ?_⟩
  rw [hz, Int.mul_eq_zero]
  rw [floatCheckFlRatZeroIff (wideFormat k) x hx.1, floatCheckFlRatZeroIff (wideFormat k) y hy.1]

theorem floatCheckWideMultiplyNotNan (k : SmallFloatKind) (x y : WideValue k)
    (hx : x.isfinite = true) (hy : y.isfinite = true) :
    (wideMultiply k x y).isnan = false := by
  rw [floatCheckWideMultiplyFinite k x y hx hy]
  exact floatCheckWideRoundNotNan k _ _ _ (Nat.ne_of_gt (Nat.mul_pos
    (floatCheckFlRatDenPos (wideFormat k) x hx) (floatCheckFlRatDenPos (wideFormat k) y hy)))

/-- Source-format ranges leave ample room for exact widening and later squared magnitudes. -/
def floatCheckSmallLo : SmallFloatKind → Nat
  | .f16 => 26 | .f32 => 151

def floatCheckSmallHi : SmallFloatKind → Nat
  | .f16 => 33 | .f32 => 257

theorem floatCheckWidenBounds (k : SmallFloatKind) (x : SmallValue k) (hx : x.isfinite = true) :
    floatCheckFlBounds (wideFormat k) (floatCheckSmallLo k) (floatCheckSmallHi k)
      (Fl.convert x) ∧
      ((Fl.convert x : WideValue k).iszero = true ↔ x.iszero = true) := by
  have hne : ((wideFormat k) == (smallFormat k)) = false := by cases k <;> decide
  obtain ⟨hxn, hxi⟩ := floatCheckFlFiniteClasses (smallFormat k) x hx
  unfold Fl.convert
  simp only [hne, hxn, hxi, Bool.false_eq_true, ↓reduceIte]
  have hb := (floatCheckFlInputBounds (smallFormat k) x hx).2
  have hlo : (smallFormat k).bias + (smallFormat k).sb + 2 ≤ (wideFormat k).bias := by cases k <;> decide
  have hhi : (smallFormat k).emax + (wideFormat k).bias + 1 < (wideFormat k).emax := by cases k <;> decide
  have h := floatCheckFlRoundRatBounded (wideFormat k) x.toRat.1 x.toRat.2
    ((smallFormat k).bias + (smallFormat k).sb) (smallFormat k).emax x.signbit hb hlo hhi
  have hlo' : (smallFormat k).bias + (smallFormat k).sb + 1 = floatCheckSmallLo k := by cases k <;> decide
  have hhi' : (smallFormat k).emax + 2 = floatCheckSmallHi k := by cases k <;> decide
  rw [hlo', hhi'] at h
  exact ⟨h.1, h.2.trans (floatCheckFlRatZeroIff (smallFormat k) x hx)⟩


theorem floatCheckSquareNonnegative (n : Int) : 0 ≤ n * n := by
  by_cases hn : 0 ≤ n
  · exact Int.mul_nonneg hn hn
  · exact Int.mul_nonneg_of_nonpos_of_nonpos (by omega) (by omega)

theorem floatCheckWideRoundPositiveSign (k : SmallFloatKind) (n : Int) (d : Nat)
    (hn : 0 ≤ n) (hd : d ≠ 0) : (floatCheckWideRound k n d false).signbit = false := by
  have hs : decide (n < 0) = false := decide_eq_false_iff_not.mpr (by omega)
  cases k with
  | f16 =>
    change (Fl.roundRat n d false : Fl single).signbit = false
    by_cases hz : n = 0
    · have hdb : (d == 0) = false := beq_eq_false_iff_ne.mpr hd
      simp only [Fl.roundRat, hdb, hz, beq_self_eq_true, Bool.false_eq_true, ↓reduceIte]
      exact (floatCheckFlZeroClass single false).1
    · rw [(floatCheckFlRoundRatNonzeroClass single (by decide) n d false hz hd).1, hs]
  | f32 =>
    change (Fl.ofF64 (F64.roundRat n d false)).signbit = false
    rw [(floatCheckFlOfF64Classes _).2.2.2.1, (floatCheckRoundRatClass n d false hd).2]
    split <;> first | rfl | exact hs

theorem floatCheckFlPositiveRat (f : Fmt) (x : Fl f) (hf : x.isfinite = true)
    (hs : x.signbit = false) : 0 ≤ x.toRat.1 := by
  by_cases hn : x.toRat.1 = 0
  · omega
  · have h := floatCheckFlRatSign f x hf hn
    rw [hs] at h
    exact Int.not_lt.mp (decide_eq_false_iff_not.mp h)

theorem floatCheckWideSquareSign (k : SmallFloatKind) (x : WideValue k) (hx : x.isfinite = true) :
    (wideMultiply k x x).signbit = false := by
  rw [floatCheckWideMultiplyFinite k x x hx hx, bne_self_eq_false]
  exact floatCheckWideRoundPositiveSign k _ _ (floatCheckSquareNonnegative _)
    (Nat.ne_of_gt (Nat.mul_pos (floatCheckFlRatDenPos (wideFormat k) x hx)
      (floatCheckFlRatDenPos (wideFormat k) x hx)))

/-- The fused call on finite operands uses a single exact-rational rounding. -/
theorem floatCheckWideMuladdFinite (k : SmallFloatKind) (x y z : WideValue k)
    (hx : x.isfinite = true) (hy : y.isfinite = true) (hz : z.isfinite = true) :
    wideMuladd k x y z = floatCheckWideRound k
      (x.toRat.1 * y.toRat.1 * (z.toRat.2 : Int) + z.toRat.1 * ((x.toRat.2 * y.toRat.2 : Nat) : Int))
      (x.toRat.2 * y.toRat.2 * z.toRat.2) ((x.signbit != y.signbit) && z.signbit) := by
  cases k with
  | f16 =>
    change Fl single at x y z
    obtain ⟨hxn, hxi⟩ := floatCheckFlFiniteClasses single x hx
    obtain ⟨hyn, hyi⟩ := floatCheckFlFiniteClasses single y hy
    obtain ⟨hzn, hzi⟩ := floatCheckFlFiniteClasses single z hz
    change muladdFloat32 x y z = Fl.roundRat
      (x.toRat.1 * y.toRat.1 * (z.toRat.2 : Int) + z.toRat.1 * ((x.toRat.2 * y.toRat.2 : Nat) : Int))
      (x.toRat.2 * y.toRat.2 * z.toRat.2) ((x.signbit != y.signbit) && z.signbit)
    simp only [muladdFloat32, hxn, hyn, hzn, hxi, hyi, hzi, Bool.false_eq_true,
      Bool.false_and, Bool.false_or, ↓reduceIte]
  | f32 =>
    change Fl double at x y z
    have hxf := (floatCheckFlToF64Classes x).1.trans hx
    have hyf := (floatCheckFlToF64Classes y).1.trans hy
    have hzf := (floatCheckFlToF64Classes z).1.trans hz
    obtain ⟨hxn, hxi⟩ := floatCheckF64FiniteClasses (Fl.toF64 x) hxf
    obtain ⟨hyn, hyi⟩ := floatCheckF64FiniteClasses (Fl.toF64 y) hyf
    obtain ⟨hzn, hzi⟩ := floatCheckF64FiniteClasses (Fl.toF64 z) hzf
    change Fl.ofF64 (F64.muladd (Fl.toF64 x) (Fl.toF64 y) (Fl.toF64 z)) = Fl.ofF64 (F64.roundRat
      (x.toRat.1 * y.toRat.1 * (z.toRat.2 : Int) + z.toRat.1 * ((x.toRat.2 * y.toRat.2 : Nat) : Int))
      (x.toRat.2 * y.toRat.2 * z.toRat.2) ((x.signbit != y.signbit) && z.signbit))
    simp only [F64.muladd, F64.fma, hxn, hyn, hzn, hxi, hyi, hzi, Bool.false_eq_true,
      Bool.false_and, Bool.and_false, Bool.false_or, ↓reduceIte, floatCheckFlToF64Rat,
      (floatCheckFlToF64Classes x).2.2.2.1, (floatCheckFlToF64Classes y).2.2.2.1,
      (floatCheckFlToF64Classes z).2.2.2.1]

theorem floatCheckPositiveSumZero (n m : Int) (d e : Nat) (hn : 0 ≤ n) (hm : 0 ≤ m)
    (hd : 0 < d) (he : 0 < e) : n * (e : Int) + m * (d : Int) = 0 ↔ n = 0 ∧ m = 0 := by
  constructor
  · intro h
    have h1 := Int.mul_nonneg hn (Int.natCast_nonneg e)
    have h2 := Int.mul_nonneg hm (Int.natCast_nonneg d)
    have h1z : n * (e : Int) = 0 := by omega
    have h2z : m * (d : Int) = 0 := by omega
    exact ⟨(Int.mul_eq_zero.mp h1z).resolve_right (by omega),
      (Int.mul_eq_zero.mp h2z).resolve_right (by omega)⟩
  · rintro ⟨rfl, rfl⟩
    simp only [Int.zero_mul, Int.zero_add]

/-- The widened sum of squares remains positive and finite throughout the small domains. -/
theorem floatCheckWideSquaredSumBounds (k : SmallFloatKind) (x y : WideValue k)
    (lo hi : Nat) (hx : floatCheckFlBounds (wideFormat k) lo hi x)
    (hy : floatCheckFlBounds (wideFormat k) lo hi y)
    (flo : lo + lo + 3 ≤ (wideFormat k).bias)
    (fhi : hi + hi + 3 + (wideFormat k).bias + 1 < (wideFormat k).emax) :
    let r := wideMuladd k x x (wideMultiply k y y)
    floatCheckFlBounds (wideFormat k) (lo + lo + 2) (hi + hi + 5) r ∧
      r.signbit = false ∧ (r.iszero = true ↔ x.iszero = true ∧ y.iszero = true) := by
  have flo0 : lo + lo + 2 ≤ (wideFormat k).bias := by omega
  have fhi0 : hi + hi + (wideFormat k).bias + 1 < (wideFormat k).emax := by omega
  obtain ⟨hy2, hy2z⟩ := floatCheckWideMultiplyBounds k y y lo hi lo hi hy hy flo0 fhi0
  have hy2s := floatCheckWideSquareSign k y hy.1
  have hy2n := floatCheckFlPositiveRat (wideFormat k) (wideMultiply k y y) hy2.1 hy2s
  have hx2 := floatCheckRatBoundsMul hx.2 hx.2
  have hx2' : floatCheckRatBounds (lo + lo + 1) (hi + hi + 2)
      (x.toRat.1 * x.toRat.1) (x.toRat.2 * x.toRat.2) :=
    floatCheckRatBoundsWeaken hx2 (by omega) (by omega)
  have hsum := floatCheckRatBoundsAdd hx2' hy2.2 (floatCheckSquareNonnegative _) hy2n
  have hbound := floatCheckWideRoundBounded k _ _ _ _ false hsum flo fhi
  dsimp only
  rw [floatCheckWideMuladdFinite k x x (wideMultiply k y y) hx.1 hx.1 hy2.1,
    bne_self_eq_false, Bool.false_and]
  have hsumn : 0 ≤ x.toRat.1 * x.toRat.1 * ((wideMultiply k y y).toRat.2 : Int) +
      (wideMultiply k y y).toRat.1 * ((x.toRat.2 * x.toRat.2 : Nat) : Int) :=
    Int.add_nonneg (Int.mul_nonneg (floatCheckSquareNonnegative _) (Int.natCast_nonneg _))
      (Int.mul_nonneg hy2n (Int.natCast_nonneg _))
  refine ⟨?_, floatCheckWideRoundPositiveSign k _ _ hsumn (Nat.ne_of_gt hsum.1), ?_⟩
  · simpa only [Nat.add_assoc] using hbound.1
  · rw [hbound.2, floatCheckPositiveSumZero _ _ _ _ (floatCheckSquareNonnegative _) hy2n hx2.1 hy2.2.1]
    rw [Int.mul_eq_zero, or_self, floatCheckFlRatZeroIff (wideFormat k) x hx.1,
      floatCheckFlRatZeroIff (wideFormat k) (wideMultiply k y y) hy2.1, hy2z, or_self]


/-- A reciprocal reverses the two rational magnitude bounds. -/
theorem floatCheckRatBoundsInverse (n : Int) (d c lo hi : Nat)
    (hb : floatCheckRatBounds lo hi n d) (hn : n ≠ 0) (hc : 0 < c) :
    floatCheckRatBounds hi lo ((c : Int) * (d : Int)) (c * n.natAbs) := by
  have ha : 0 < n.natAbs := by omega
  refine ⟨Nat.mul_pos hc ha, ?_, ?_⟩
  · rw [Int.natAbs_mul, Int.natAbs_natCast, Int.natAbs_natCast]
    have h := Nat.mul_le_mul_left c (hb.2.2 hn)
    simpa only [Nat.mul_assoc] using h
  · intro _
    rw [Int.natAbs_mul, Int.natAbs_natCast, Int.natAbs_natCast]
    have h := Nat.mul_le_mul_left c hb.2.1
    simpa only [Nat.mul_assoc] using h

/-- The scalar reciprocal reduces to a quotient with the encoded unit significand. -/
theorem floatCheckWideInversePositive (k : SmallFloatKind) (x : WideValue k)
    (hf : x.isfinite = true) (hp : 0 < x.toRat.1) :
    wideInverse k x = floatCheckWideRound k
      ((2 ^ (wideFormat k).sb : Nat) * (x.toRat.2 : Int))
      (2 ^ (wideFormat k).sb * x.toRat.1.natAbs) (false != x.signbit) := by
  have hn : x.toRat.1 ≠ 0 := by omega
  have hz : x.iszero = false := by
    apply Bool.eq_false_iff.mpr
    intro h
    exact hn ((floatCheckFlRatZeroIff (wideFormat k) x hf).mpr h)
  have hnegative : ¬ x.toRat.1 < 0 := by omega
  cases k with
  | f16 =>
    change Fl single at x
    change x.iszero = false at hz
    change ¬ x.toRat.1 < 0 at hnegative
    change divideFloatAt (Fl.ofInt 1 : Fl single) x =
      Fl.roundRat ((2 ^ 23 : Nat) * (x.toRat.2 : Int)) (2 ^ 23 * x.toRat.1.natAbs) (false != x.signbit)
    obtain ⟨hxn, hxi⟩ := floatCheckFlFiniteClasses single x hf
    have honeN : (Fl.ofInt 1 : Fl single).isnan = false := by decide
    have honeI : (Fl.ofInt 1 : Fl single).isinf = false := by decide
    have honeZ : (Fl.ofInt 1 : Fl single).iszero = false := by decide
    have honeS : (Fl.ofInt 1 : Fl single).signbit = false := by decide
    have honeR : (Fl.ofInt 1 : Fl single).toRat = (((2 ^ 23 : Nat) : Int), 2 ^ 23) := by decide
    unfold divideFloatAt
    simp only [honeN, honeI, honeZ, honeS, honeR, hxn, hxi, hz, hnegative,
      Bool.false_eq_true, Bool.false_and, Bool.false_or, ↓reduceIte]
  | f32 =>
    change Fl double at x
    change x.iszero = false at hz
    change ¬ x.toRat.1 < 0 at hnegative
    change Fl.ofF64 (F64.div F64.one (Fl.toF64 x)) =
      Fl.ofF64 (F64.roundRat ((2 ^ 52 : Nat) * (x.toRat.2 : Int))
        (2 ^ 52 * x.toRat.1.natAbs) (false != x.signbit))
    have hxf := (floatCheckFlToF64Classes x).1.trans hf
    obtain ⟨hxn, hxi⟩ := floatCheckF64FiniteClasses (Fl.toF64 x) hxf
    have honeN : F64.isnan F64.one = false := by decide
    have honeI : F64.isinf F64.one = false := by decide
    have honeZ : F64.iszero F64.one = false := by decide
    have honeS : F64.signbit F64.one = false := by decide
    have honeR : F64.toRat F64.one = (((2 ^ 52 : Nat) : Int), 2 ^ 52) := by decide
    unfold F64.div
    simp only [honeN, honeI, honeZ, honeS, honeR, hxn, hxi, (floatCheckFlToF64Classes x).2.2.1,
      hz, floatCheckFlToF64Rat, hnegative, (floatCheckFlToF64Classes x).2.2.2.1,
      Bool.false_eq_true, Bool.false_and, Bool.false_or, ↓reduceIte]

theorem floatCheckWideInverseFinite (k : SmallFloatKind) (x : WideValue k) (lo hi : Nat)
    (hb : floatCheckFlBounds (wideFormat k) lo hi x) (hp : 0 < x.toRat.1)
    (flo : hi + 2 ≤ (wideFormat k).bias)
    (fhi : lo + (wideFormat k).bias + 1 < (wideFormat k).emax) :
    (wideInverse k x).isfinite = true := by
  rw [floatCheckWideInversePositive k x hb.1 hp]
  have hrat := floatCheckRatBoundsInverse x.toRat.1 x.toRat.2 (2 ^ (wideFormat k).sb) lo hi hb.2
    (by omega) (Nat.two_pow_pos _)
  exact (floatCheckWideRoundBounded k _ _ _ _ _ hrat flo fhi).1.1

/-- Sign toggling preserves the exponent and finite classification in every format. -/
theorem floatCheckFlNegMagnitude (f : Fmt) (x : Fl f) : (Fl.neg x).magnitude = x.magnitude := by
  have hx : x.toBits < 2 * 2 ^ (f.eb + f.sb) := by
    have h := x.bits.isLt
    change x.toBits < 2 ^ f.width at h
    rw [floatCheckFlWidth] at h
    exact h
  unfold Fl.neg
  by_cases hs : x.signbit = true
  · have hbits : 2 ^ (f.eb + f.sb) ≤ x.toBits := by simpa only [Fl.signbit, decide_eq_true_iff] using hs
    simp only [hs, ↓reduceIte]
    unfold Fl.magnitude
    rw [floatCheckFlOfBits, floatCheckFlWidth,
      Nat.mod_eq_of_lt (show x.toBits - 2 ^ (f.eb + f.sb) < 2 * 2 ^ (f.eb + f.sb) by omega)]
    calc
      (x.toBits - 2 ^ (f.eb + f.sb)) % 2 ^ (f.eb + f.sb) =
          (2 ^ (f.eb + f.sb) + (x.toBits - 2 ^ (f.eb + f.sb))) % 2 ^ (f.eb + f.sb) :=
        (Nat.add_mod_left _ _).symm
      _ = x.toBits % 2 ^ (f.eb + f.sb) := congrArg (fun j : Nat => j % 2 ^ (f.eb + f.sb)) (by omega)
  · have hsf : x.signbit = false := Bool.eq_false_iff.mpr hs
    have hbits : x.toBits < 2 ^ (f.eb + f.sb) := by
      have h : ¬ x.toBits ≥ 2 ^ (f.eb + f.sb) := by simpa only [Fl.signbit, decide_eq_false_iff_not] using hsf
      omega
    simp only [hsf, Bool.false_eq_true, ↓reduceIte]
    unfold Fl.magnitude
    rw [floatCheckFlOfBits, floatCheckFlWidth,
      Nat.mod_eq_of_lt (show x.toBits + 2 ^ (f.eb + f.sb) < 2 * 2 ^ (f.eb + f.sb) by omega),
      Nat.add_mod_right]

theorem floatCheckFlNegFinite (f : Fmt) (x : Fl f) : (Fl.neg x).isfinite = x.isfinite := by
  simp only [Fl.isfinite, floatCheckFlExpMagnitude, floatCheckFlNegMagnitude]


theorem floatCheckFlInfIsInf (f : Fmt) (s : Bool) : (Fl.inf s : Fl f).isinf = true := by
  have hpack : (Fl.inf s : Fl f) = floatCheckFlPack s f.emax 0 := by
    simp only [Fl.inf, floatCheckFlPack, Nat.add_zero]
  have hem : f.emax < 2 ^ f.eb := by unfold Fmt.emax; have := Nat.two_pow_pos f.eb; omega
  obtain ⟨_, he, hp⟩ := floatCheckFlPackParts (f := f) s f.emax 0 hem (Nat.two_pow_pos _)
  rw [hpack]
  simp only [Fl.isinf, he, hp, beq_self_eq_true, Bool.true_and]

theorem floatCheckFlInfiniteNotNan (f : Fmt) (x : Fl f) (hi : x.isinf = true) : x.isnan = false := by
  have hp : x.frac = 0 := by
    have h := (Bool.and_eq_true_iff.mp hi).2
    exact beq_iff_eq.mp h
  simp only [Fl.isnan, hp, bne_self_eq_false, Bool.and_false]

theorem floatCheckFlConvertInfinite (f g : Fmt) (x : Fl g) (hi : x.isinf = true) :
    (Fl.convert x : Fl f).isinf = true := by
  by_cases he : f = g
  · subst f
    simp only [Fl.convert, beq_self_eq_true, ↓reduceIte, floatCheckFlOfBitsRoundtrip, hi]
  · have hne : (f == g) = false := beq_eq_false_iff_ne.mpr he
    have hn := floatCheckFlInfiniteNotNan g x hi
    simp only [Fl.convert, hne, hn, hi, Bool.false_eq_true, ↓reduceIte]
    exact floatCheckFlInfIsInf f x.signbit

/-- Finite nonzero small inputs cannot form NaN in widened reciprocal arithmetic. -/
theorem floatCheckSmallInverseFinite (k : SmallFloatKind) (z : Complex (SmallValue k))
    (hzr : z.re.isfinite = true) (hzi : z.im.isfinite = true)
    (hz : z.re.iszero = false ∨ z.im.iszero = false) :
    (inverseSmall k z).re.isnan = false ∧ (inverseSmall k z).im.isnan = false := by
  let c : WideValue k := Fl.convert z.re
  let d : WideValue k := Fl.convert z.im
  obtain ⟨hc, hcz⟩ := floatCheckWidenBounds k z.re hzr
  obtain ⟨hd, hdz⟩ := floatCheckWidenBounds k z.im hzi
  change floatCheckFlBounds (wideFormat k) (floatCheckSmallLo k) (floatCheckSmallHi k) c at hc
  change floatCheckFlBounds (wideFormat k) (floatCheckSmallLo k) (floatCheckSmallHi k) d at hd
  change c.iszero = true ↔ z.re.iszero = true at hcz
  change d.iszero = true ↔ z.im.iszero = true at hdz
  have hs := floatCheckWideSquaredSumBounds k c d (floatCheckSmallLo k) (floatCheckSmallHi k) hc hd
    (by cases k <;> decide) (by cases k <;> decide)
  let rho := wideMuladd k c c (wideMultiply k d d)
  change floatCheckFlBounds (wideFormat k) (floatCheckSmallLo k + floatCheckSmallLo k + 2)
      (floatCheckSmallHi k + floatCheckSmallHi k + 5) rho ∧
    rho.signbit = false ∧ (rho.iszero = true ↔ c.iszero = true ∧ d.iszero = true) at hs
  have hnum : 0 < rho.toRat.1 := by
    have hge := floatCheckFlPositiveRat (wideFormat k) rho hs.1.1 hs.2.1
    have hn : rho.toRat.1 ≠ 0 := by
      intro hh
      have hzrho := (floatCheckFlRatZeroIff (wideFormat k) rho hs.1.1).mp hh
      obtain ⟨hcz0, hdz0⟩ := hs.2.2.mp hzrho
      have hzr0 := hcz.mp hcz0
      have hzi0 := hdz.mp hdz0
      rcases hz with hz | hz
      · rw [hz] at hzr0
        contradiction
      · rw [hz] at hzi0
        contradiction
    omega
  have hmag := floatCheckWideInverseFinite k rho
    (floatCheckSmallLo k + floatCheckSmallLo k + 2)
    (floatCheckSmallHi k + floatCheckSmallHi k + 5) hs.1 hnum
    (by cases k <;> decide) (by cases k <;> decide)
  have hnc := floatCheckWideMultiplyNotNan k c (wideInverse k rho) hc.1 hmag
  have hnd := floatCheckWideMultiplyNotNan k (Fl.neg d) (wideInverse k rho)
    ((floatCheckFlNegFinite (wideFormat k) d).trans hd.1) hmag
  have hcre := floatCheckFlConvertNotNan (smallFormat k) (wideFormat k)
    (by cases k <;> decide) (wideMultiply k c (wideInverse k rho)) hnc
  have hcim := floatCheckFlConvertNotNan (smallFormat k) (wideFormat k)
    (by cases k <;> decide) (wideMultiply k (Fl.neg d) (wideInverse k rho)) hnd
  have hci := (floatCheckFlFiniteClasses (wideFormat k) c hc.1).2
  have hdi := (floatCheckFlFiniteClasses (wideFormat k) d hd.1).2
  unfold inverseSmall widenSmallComplex reimComplex
  change (if c.isinf || d.isinf then ⟨Fl.zero c.signbit, Fl.zero (!d.signbit)⟩ else
    narrowSmallComplex k ⟨wideMultiply k c (wideInverse k rho),
      wideMultiply k (Fl.neg d) (wideInverse k rho)⟩).re.isnan = false ∧
    (if c.isinf || d.isinf then ⟨Fl.zero c.signbit, Fl.zero (!d.signbit)⟩ else
    narrowSmallComplex k ⟨wideMultiply k c (wideInverse k rho),
      wideMultiply k (Fl.neg d) (wideInverse k rho)⟩).im.isnan = false
  simp only [hci, hdi, Bool.false_or, Bool.false_eq_true, ↓reduceIte, narrowSmallComplex]
  exact ⟨hcre, hcim⟩

/-- Infinite components return the documented conjugate-signed zeros, including mixed NaNs. -/
theorem floatCheckSmallInverseInfinity (k : SmallFloatKind) (z : Complex (SmallValue k))
    (hi : z.re.isinf = true ∨ z.im.isinf = true) :
    (inverseSmall k z).re.iszero = true ∧ (inverseSmall k z).im.iszero = true ∧
      (inverseSmall k z).re.signbit = z.re.signbit ∧
      (inverseSmall k z).im.signbit = !z.im.signbit := by
  let c : WideValue k := Fl.convert z.re
  let d : WideValue k := Fl.convert z.im
  have hinf : (c.isinf || d.isinf) = true := by
    rcases hi with hi | hi
    · have hc := floatCheckFlConvertInfinite (wideFormat k) (smallFormat k) z.re hi
      change c.isinf = true at hc
      simp only [hc, Bool.true_or]
    · have hd := floatCheckFlConvertInfinite (wideFormat k) (smallFormat k) z.im hi
      change d.isinf = true at hd
      simp only [hd, Bool.or_true]
  have hcs : c.signbit = z.re.signbit := floatCheckFlConvertSign (wideFormat k) (smallFormat k)
    (by cases k <;> decide) (by cases k <;> decide) z.re
  have hds : d.signbit = z.im.signbit := floatCheckFlConvertSign (wideFormat k) (smallFormat k)
    (by cases k <;> decide) (by cases k <;> decide) z.im
  unfold inverseSmall widenSmallComplex reimComplex
  change (if c.isinf || d.isinf then (⟨Fl.zero c.signbit, Fl.zero (!d.signbit)⟩ : Complex (SmallValue k)) else _).re.iszero = true ∧
    (if c.isinf || d.isinf then (⟨Fl.zero c.signbit, Fl.zero (!d.signbit)⟩ : Complex (SmallValue k)) else _).im.iszero = true ∧
    (if c.isinf || d.isinf then (⟨Fl.zero c.signbit, Fl.zero (!d.signbit)⟩ : Complex (SmallValue k)) else _).re.signbit = z.re.signbit ∧
    (if c.isinf || d.isinf then (⟨Fl.zero c.signbit, Fl.zero (!d.signbit)⟩ : Complex (SmallValue k)) else _).im.signbit = !z.im.signbit
  simp only [hinf, ↓reduceIte]
  exact ⟨(floatCheckFlZeroBasics (smallFormat k) (by cases k <;> decide) c.signbit).2.1,
    (floatCheckFlZeroBasics (smallFormat k) (by cases k <;> decide) (!d.signbit)).2.1,
    (floatCheckFlZeroClass (smallFormat k) c.signbit).1.trans hcs,
    (floatCheckFlZeroClass (smallFormat k) (!d.signbit)).1.trans (congrArg Bool.not hds)⟩

theorem Models1G19SmallReciprocalSanity_proven :
    JuliaLean.Proofs.base.complex.Models1Group19.SmallReciprocalSanity := by
  intro k z
  exact ⟨fun h => floatCheckSmallInverseFinite k z h.1 h.2.1 h.2.2,
    floatCheckSmallInverseInfinity k z⟩

end JuliaLean.ChatGPT.Batch10.Group1

