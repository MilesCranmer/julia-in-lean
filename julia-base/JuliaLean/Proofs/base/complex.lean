  · simp only [hs, ht, ↓reduceIte, Nat.pow_lt_pow_iff_right (by decide : 1 < (2 : Nat))]
    omega
  · have hp := Nat.pow_lt_pow_right (by decide : 1 < (2 : Nat)) (show (p+1074).toNat < 52 by omega)
    simp only [hs, ht, ↓reduceIte]
    omega
  · have hq := Nat.pow_lt_pow_right (by decide : 1 < (2 : Nat)) (show (q+1074).toNat < 52 by omega)
    simp only [hs, ht, ↓reduceIte]
