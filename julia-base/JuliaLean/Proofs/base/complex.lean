/-- Independent mathematical residue specification for machine arithmetic:
the stored coordinate lies in the native type's range and represents the
unbounded mathematical coordinate modulo 2^bits.  No wrapping implementation
is used in this specification. -/
def MixedIntegerCoordinate (t : IntTy) (expected actual : Int) : Prop :=
  t.min ≤ actual ∧ actual ≤ t.max ∧ (actual - expected) % (2 : Int) ^ t.bits = 0

