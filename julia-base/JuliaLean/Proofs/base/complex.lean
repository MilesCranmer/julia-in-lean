theorem floatCheckEpsilonGridExact (c K : Nat) (hc0 : 0 < c) (hc1 : c < 2^53)
    (hbound : c.log2+K ≤ 2046) :
    let n := c*2^K
    let r := F64.roundRat (n : Int) (2^1074) false
    F64.isfinite r = true ∧ F64.signbit r = false ∧
      (F64.toRat r).1 * ((2^1074 : Nat) : Int) = (n : Int) * ((F64.toRat r).2 : Int) := by
  let n := c*2^K
  let z : Fl double := Fl.roundRat (n : Int) (2^1074) false
  have hn : 0 < n := Nat.mul_pos hc0 (Nat.two_pow_pos K)
  have hlog : Fl.floorLog2Rat (n : Int).natAbs (2^1074) = ((c.log2+K : Nat) : Int)-1074 := by
    rw [Int.natAbs_natCast, SmallExact.floorLog2Rat_pow _ _ (by omega)]
    rw [SmallExact.log2_mul_pow c K (by omega)]
    omega
  have hconv : Fl.toF64 z = F64.roundRat (n : Int) (2^1074) false :=
    floatCheckFlToF64RoundRat _ _ _ (by rw [hlog]; omega)
  have hsign : F64.signbit (F64.roundRat (n : Int) (2^1074) false) = false := by
    have hh := (floatCheckRoundRatClass (n : Int) (2^1074) false (by decide)).2
    have hn0 : (n : Int) ≠ 0 := by omega
    have hnn : ¬ (n : Int) < 0 := by omega
    simpa only [ite_eq_right hn0, decide_eq_false_iff_not.mpr hnn] using hh
  have hresult : F64.isfinite (F64.roundRat (n : Int) (2^1074) false) = true ∧
      (F64.toRat (F64.roundRat (n : Int) (2^1074) false)).1 * ((2^1074 : Nat) : Int) =
        (n : Int) * ((F64.toRat (F64.roundRat (n : Int) (2^1074) false)).2 : Int) := by
    by_cases hnorm : 52 ≤ c.log2+K
    · have hr := SmallExact.roundRat_normal_value SmallExact.good_double (n : Int) c K 1074 false
        (by exact Int.natAbs_natCast n) (by omega) hc1 (by change 1075 ≤ c.log2+K+1023; omega)
        (by change c.log2+K+1023 < 1074+2047; omega)
      rw [← hconv, (floatCheckFlToF64Classes z).1, floatCheckFlToF64Rat]
      exact hr
    · have hsmall : n < 2^52 := by
        apply (Nat.log2_lt (by omega : n ≠ 0)).mp
        rw [SmallExact.log2_mul_pow c K (by omega)]
        omega
      have hr := SmallExact.roundRat_subnormal_signed SmallExact.good_double false n 0 1074 false
        hn hsmall (by decide)
      simp only [SmallExact.signed, Bool.false_eq_true, ↓reduceIte, Nat.pow_zero, Nat.mul_one] at hr
      have hb : F64.roundRat (n : Int) (2^1074) false = F64.ofBits n := by
        rw [← hconv]
        change Fl.toF64 (Fl.roundRat (n : Int) (2^1074) false : Fl double) = F64.ofBits n
        rw [hr]
        change Fl.toF64 (Fl.ofBits (0+(0*2^52+n)) : Fl double) = F64.ofBits n
        rw [floatCheckFlToF64OfBits]
        simp only [Nat.zero_mul, Nat.zero_add]
      have ht : F64.toBits (F64.ofBits n) = n := (tb_ofBits _).trans (Nat.mod_eq_of_lt (by omega))
      have hE : F64.exponentField (F64.ofBits n) = 0 := by
        simp only [F64.exponentField, ht, Nat.div_eq_of_lt hsmall, Nat.zero_mod]
      have hs : F64.signbit (F64.ofBits n) = false := by
        simp only [F64.signbit, ht, decide_eq_false_iff_not]
        omega
      rw [hb]
      refine ⟨?_, ?_⟩
      · simp only [F64.isfinite, hE]
        rfl
      · rw [toRat_subn _ hE]
        simp only [hs, Bool.false_eq_true, ↓reduceIte, ht, Nat.mod_eq_of_lt hsmall]
  exact ⟨hresult.1, hsign, hresult.2⟩

theorem floatCheckEpsilonSumMantissa (d : Nat) (hd : d ≤ 26) :
    (2^d+1).log2 = (if d = 0 then 1 else d) ∧ 0 < 2^d+1 ∧ 2^d+1 < 2^53 := by
  by_cases hz : d = 0
  · subst d
    decide
  · have hp : 2 ≤ 2^d := Nat.pow_le_pow_right (n := 2) (by decide) (show 1 ≤ d by omega)
    have hbig : 2^d+1 < 2^(d+1) := by rw [Nat.pow_succ]; omega
    have hlog := (Nat.log2_lt (by omega : 2^d+1 ≠ 0)).mpr hbig
    have hlo := (Nat.le_log2 (by omega : 2^d+1 ≠ 0)).mpr (show 2^d ≤ 2^d+1 by omega)
    have hu : 2^(d+1) ≤ 2^53 := Nat.pow_le_pow_right (by decide) (by omega)
    simp only [hz, ↓reduceIte]
    exact ⟨by omega, by omega, by omega⟩

theorem floatCheckCrossCancel (a b c d e f : Int) (hb : b ≠ 0)
    (ha : a*b = c*d) (he : e*b = c*f) : a*f = e*d := by
  apply Int.eq_of_mul_eq_mul_right hb
  calc
    (a*f)*b = (a*b)*f := by rw [Int.mul_right_comm]
    _ = (c*d)*f := by rw [ha]
    _ = (c*f)*d := by rw [Int.mul_right_comm]
    _ = (e*b)*d := by rw [← he]
    _ = (e*d)*b := by rw [Int.mul_right_comm]

theorem floatCheckEpsilonUpperEndpoint (p : Int) (d I J : Nat)
    (hd : d ≤ 26) (hq : -1074 ≤ p-d) (hp : p ≤ 971) (he : (I : Int)-J = p-52) :
    let n : Nat := (2^52+2^(52-d))*2^I
    let r := F64.roundRat (n : Int) (2^J) false
    F64.isfinite r = true ∧ F64.signbit r = false ∧
      (F64.toRat r).1 * ((2^J : Nat) : Int) = (n : Int) * ((F64.toRat r).2 : Int) := by
  let K := (p-d+1074).toNat
  have hK : (K : Int) = p-d+1074 := by dsimp only [K]; omega
  obtain ⟨hlog, hc0, hc1⟩ := floatCheckEpsilonSumMantissa d hd
  have hbound : (2^d+1).log2+K ≤ 2046 := by rw [hlog]; split <;> omega
  have hC : 2^52+2^(52-d) = (2^d+1)*2^(52-d) := by
    rw [Nat.add_mul, Nat.one_mul, ← Nat.pow_add, show d+(52-d) = 52 by omega]
  have hcross : ((2^52+2^(52-d))*2^I)*2^1074 = ((2^d+1)*2^K)*2^J := by
    rw [hC]
    simp only [Nat.mul_assoc, ← Nat.pow_add]
    apply congrArg (fun v : Nat => (2^d+1)*2^v)
    omega
  have hcrossI : (((2^52+2^(52-d))*2^I : Nat) : Int) * ((2^1074 : Nat) : Int) =
      (((2^d+1)*2^K : Nat) : Int) * ((2^J : Nat) : Int) := by
    simpa only [Int.natCast_mul] using congrArg (fun n : Nat => (n : Int)) hcross
  have hr := EpsilonBounds.round_cross _ _ J 1074 false hcrossI
  have hx := floatCheckEpsilonGridExact (2^d+1) K hc0 hc1 hbound
  dsimp only at hx ⊢
  rw [hr]
  refine ⟨hx.1, hx.2.1, ?_⟩
  exact floatCheckCrossCancel _ ((2^1074 : Nat) : Int) _ _ _ _ (by decide) hx.2.2 hcrossI


theorem floatCheckEpsilonUpperEndpointSum (p : Int) (d I J : Nat)
    (hd : d ≤ 26) (hq : -1074 ≤ p-d) (hp : p ≤ 971) (he : (I : Int)-J = p-52) :
    let n : Nat := (2^52+2^(52-d))*2^I
    let r := F64.roundRat (n : Int) (2^J) false
    let s := RatSum (Epsilon.rat (EpsilonExact.power p)) (Epsilon.rat (EpsilonExact.power (p-d)))
    F64.isfinite r = true ∧ F64.signbit r = false ∧
      (Epsilon.rat r).1 * s.2 = s.1 * (Epsilon.rat r).2 := by
  obtain ⟨a, b, hxr, hpx⟩ := EpsilonExact.power_rat p (by omega) (by omega)
  obtain ⟨c, e, hyr, hqy⟩ := EpsilonExact.power_rat (p-d) hq (by omega)
  let n : Nat := (2^52+2^(52-d))*2^I
  let N := 2^a*2^e+2^c*2^b
  let D := 2^b*2^e
  have hcross : N*2^J = n*D := by
    dsimp only [N, n, D]
    simp only [Nat.add_mul, Nat.mul_assoc, ← Nat.pow_add]
    have h1 : a+e+J = 52+I+(b+e) := by omega
    have h2 : c+b+J = (52-d)+I+(b+e) := by omega
    rw [h1, h2]
  have hcrossI : (N : Int) * ((2^J : Nat) : Int) = (n : Int) * (D : Int) := by
    simpa only [Int.natCast_mul] using congrArg (fun t : Nat => (t : Int)) hcross
  have hr := floatCheckEpsilonUpperEndpoint p d I J hd hq hp he
  dsimp only at hr ⊢
  refine ⟨hr.1, hr.2.1, ?_⟩
  have ht := floatCheckCrossCancel _ ((2^J : Nat) : Int) (n : Int) _ (N : Int) (D : Int)
    (by have hpj := Nat.two_pow_pos J; omega) hr.2.2 hcrossI
  simpa only [Epsilon.rat, RatSum, hxr, hyr, Prod.fst, Prod.snd, n, N, D,
    Int.natCast_add, Int.natCast_mul] using ht

