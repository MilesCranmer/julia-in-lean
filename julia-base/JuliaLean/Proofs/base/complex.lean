/-- A direct standard state/error interpretation for the closed primitive. -/
abbrev FieldPrimitiveM (E Ref V A : Type) := ExceptT (Error E) (StateM (FieldHeap Ref V)) A

/-- The native field position, used only to state storage provenance. -/
def FieldPosition : FieldIndex → Nat
  | .first => 0
  | .second => 1

/-- A returned field is present at its declared position in the receiver's
actual immutable storage or current mutable object store.  This is a relation
on data, independent of the primitive's computation and error algorithm. -/
def FieldStoredAt {Ref V : Type} (heap : FieldHeap Ref V)
    (view : V → FieldDescriptor Ref V) (receiver : V) (index : FieldIndex) (value : V) : Prop :=
  (∃ storage, view receiver = .immutableValue storage ∧
    storage.slots[FieldPosition index]? = some (.value value)) ∨
  (∃ reference, view receiver = .mutableValue reference ∧
    (heap.objects reference).slots[FieldPosition index]? = some (.value value))

/-- Every completed primitive leaves the object store unchanged.  Successful
returns have exact stored-value provenance; the primitive cannot fabricate a
value, run arbitrary user code, or produce an unrelated exception class.
Invariant: src/builtins.c:1173-1234,1572-1584; src/datatype.c:1886-1943. -/
def FieldReadStateAndProvenance : Prop :=
  ∀ (E Ref V : Type) (view : V → FieldDescriptor Ref V) (receiver : V)
      (index : FieldIndex) (heap : FieldHeap Ref V),
    let observed := ((getfieldFixed (m := FieldPrimitiveM E Ref V) (E := E) (Ref := Ref)
      view receiver index).run) heap
    observed.2 = heap ∧
      match observed.1 with
      | .ok value => FieldStoredAt heap view receiver index value
      | .error error => error = .typeError "getglobal" ∨ error = .jl .boundsError ∨
          error = .undefRefError

/-- Module receivers take getglobal's Symbol-type failure before bounds
checking, for either native index and every possible heap.
Invariant: src/builtins.c:1217-1220,1572-1584. -/
def FieldReadModuleError : Prop :=
  ∀ (E Ref V : Type) (view : V → FieldDescriptor Ref V) (receiver : V)
      (index : FieldIndex) (heap : FieldHeap Ref V),
    view receiver = .moduleValue →
      ((getfieldFixed (m := FieldPrimitiveM E Ref V) (E := E) (Ref := Ref)
        view receiver index).run) heap = (.error (.typeError "getglobal"), heap)

/-- Every present stored value is returned, and a stored null reference is
rejected.  Field count bounds are mathematical storage bounds constrained by
the native UInt32 layout representation.  The same contract applies through
a mutable reference to the current store, preserving aliasing.
Invariant: src/builtins.c:1173-1194; src/datatype.c:1886-1943. -/
def FieldReadStorageLaw : Prop :=
  ∀ (E Ref V : Type) (storage : FieldStorage V) (receiver : V)
      (index : FieldIndex) (heap : FieldHeap Ref V),
    let read := ((getfieldFixed (m := FieldPrimitiveM E Ref V) (E := E) (Ref := Ref)
      (fun _ => .immutableValue storage) receiver index).run) heap
    (∀ value, storage.slots[FieldPosition index]? = some (.value value) →
      read = (.ok value, heap)) ∧
    (storage.slots[FieldPosition index]? = some .nullReference →
      read = (.error .undefRefError, heap)) ∧
    (storage.slots.size ≤ FieldPosition index → read = (.error (.jl .boundsError), heap)) ∧
    (∀ reference, heap.objects reference = storage →
      ((getfieldFixed (m := FieldPrimitiveM E Ref V) (E := E) (Ref := Ref)
        (fun _ => .mutableValue reference) receiver index).run) heap = read)

/-- State and heap are separate standard transformer layers.  Iterator
callees can mutate both, throw with their final state retained, or diverge.
Core field reads use the actual FieldHeap state instance. -/
abbrev FieldM (E Ref V State A : Type) :=
  ExceptT (Error E) (StateT (FieldHeap Ref V) (StateT State Option)) A

structure FieldIterationReceipt (E Ref V State : Type) where
  second : Bool
  receiver : V
  index : JInt .i64
  stateArgument : Option V
  outcome : Except (Error E) V
  beforeHeap : FieldHeap Ref V
  afterHeap : FieldHeap Ref V
  beforeState : State
  afterState : State

/-- Observe an actual selected iterator invocation exactly once without
changing its heap, user state, result, exception, or termination behavior. -/
def FieldObserveIteration {E Ref V State : Type} (second : Bool)
    (receiver : V) (index : JInt .i64) (stateArgument : Option V)
    (action : FieldM E Ref V State V) :
    FieldM E Ref V (State × List (FieldIterationReceipt E Ref V State)) V :=
  fun heap (state, history) =>
    match action.run heap state with
    | none => none
    | some ((outcome, finalHeap), finalState) =>
        let receipt : FieldIterationReceipt E Ref V State :=
          { second, receiver, index, stateArgument, outcome
            beforeHeap := heap, afterHeap := finalHeap
            beforeState := state, afterState := finalState }
        some ((outcome, finalHeap), (finalState, history ++ [receipt]))

/-- These are precisely the source-independent classes of local numeric
getfield failure; selected iterator exceptions are tracked separately. -/
def FieldLocalError {E : Type} (error : Error E) : Prop :=
  error = .typeError "getglobal" ∨ error = .jl .boundsError ∨ error = .undefRefError

/-- A completed destructuring observation contains one or two selected
iterator invocations in order.  The second invocation has the original iterable,
native index2, and state obtained from the first result's actual second field.
Successful output coordinates come from the field reads at their respective
heap snapshots, even when the second iterator mutates an alias of the first.
Every first selected failure is terminal and keeps its post-call state.
This is a call-count/argument/provenance invariant, not an expected second
implementation of Julia's lowering. -/
def FieldUnpackAudit {E Ref V State : Type} (view : V → FieldDescriptor Ref V)
    (receiver : V) (initialHeap : FieldHeap Ref V) (initialState : State)
    (observed : Option ((Except (Error E) (V × V) × FieldHeap Ref V) ×
      (State × List (FieldIterationReceipt E Ref V State)))) : Prop :=
  match observed with
  | none => True
  | some ((outcome, finalHeap), (finalState, history)) =>
      ∃ first rest, history = first :: rest ∧
        first.second = false ∧ first.receiver = receiver ∧
        first.index = JInt.lit .i64 1 ∧ first.stateArgument = none ∧
        first.beforeHeap = initialHeap ∧ first.beforeState = initialState ∧
        match rest with
        | [] =>
            finalHeap = first.afterHeap ∧ finalState = first.afterState ∧
            match first.outcome with
            | .error error => outcome = .error error
            | .ok _ => ∃ error, outcome = .error error ∧ FieldLocalError error
        | [second] =>
            second.second = true ∧ second.receiver = receiver ∧
            second.index = JInt.lit .i64 2 ∧
            second.beforeHeap = first.afterHeap ∧ second.beforeState = first.afterState ∧
            finalHeap = second.afterHeap ∧ finalState = second.afterState ∧
            ∃ firstResult firstValue stateValue,
              first.outcome = .ok firstResult ∧
              FieldStoredAt first.afterHeap view firstResult .first firstValue ∧
              FieldStoredAt first.afterHeap view firstResult .second stateValue ∧
              second.stateArgument = some stateValue ∧
              match second.outcome with
              | .error error => outcome = .error error
              | .ok secondResult =>
                  match outcome with
                  | .error error => FieldLocalError error
                  | .ok (actualFirst, actualSecond) => actualFirst = firstValue ∧
                      FieldStoredAt second.afterHeap view secondResult .first actualSecond
        | _ => False

/-- Complete-domain invariant for actual two-value destructuring, including
arbitrary iterable/results, state mutation, aliases, exceptions, malformed
indexed_iterate result objects, and divergence.  No selected-callee correctness
law or tuple-result assumption is imposed.
Invariant: src/julia-syntax.scm:1888-1910,2564-2609. -/
def TwoValueDestructureEffects : Prop :=
  ∀ (E Ref V State : Type) (view : V → FieldDescriptor Ref V)
      (ops : IndexedIterateOps (FieldM E Ref V State) V)
      (receiver : V) (heap : FieldHeap Ref V) (state : State),
    let observed : IndexedIterateOps
        (FieldM E Ref V (State × List (FieldIterationReceipt E Ref V State))) V :=
      { first := fun value index => FieldObserveIteration false value index none (ops.first value index)
        next := fun value index argument =>
          FieldObserveIteration true value index (some argument) (ops.next value index argument) }
    FieldUnpackAudit view receiver heap state
      ((destructureTwo (E := E) view observed receiver).run heap (state, []))

/-- Runtime values for a concrete custom iterator whose final result has only
one field.  This is a valid selected-callee instance, not a restriction on the
generic invariant or an assumption about sincos/reim result types. -/
inductive FieldTailValue where
  | iterable
  | firstResult
  | secondResult
  | firstValue
  | stateValue
  | secondValue

/-- Constructible native layout witnesses for the selected iterator instance. -/
def FieldTailStorage (second : Bool) : FieldStorage FieldTailValue :=
  if second then
    { count := JInt.lit .u32 1, slots := #[.value .secondValue], count_eq := by decide }
  else
    { count := JInt.lit .u32 2, slots := #[.value .firstValue, .value .stateValue], count_eq := by decide }

def FieldTailView : FieldTailValue → FieldDescriptor Unit FieldTailValue
  | .firstResult => .immutableValue (FieldTailStorage false)
  | .secondResult => .immutableValue (FieldTailStorage true)
  | _ => .moduleValue

/-- A one-field final iterator result succeeds: lowering never requests its
missing second field.  This also asserts native termination and exact returned
coordinates for every initial heap and user state.
Invariant: src/julia-syntax.scm:2601-2609. -/
def TwoValueDestructureSingleFieldTail : Prop :=
  ∀ (E State : Type) (heap : FieldHeap Unit FieldTailValue) (state : State),
    let ops : IndexedIterateOps (FieldM E Unit FieldTailValue State) FieldTailValue :=
      { first := fun _ _ => pure .firstResult
        next := fun _ _ _ => pure .secondResult }
    (destructureTwo (E := E) FieldTailView ops .iterable).run heap state =
      some ((.ok (.firstValue, .secondValue), heap), state)

end JuliaLean.Proofs.base.complex.Models2Group9



namespace JuliaLean.Proofs.base.complex.Models2Group9

open JuliaLean JuliaLean.base.complex
open JuliaLean.base.complex.Models2Group9

/-!
The six destructuring callers are observed over arbitrary selected operations,
including changes to the same mutable heap used by Core.getfield.  This observer
adds only private call receipts and a terminal-return receipt.  It never supplies
a correctness law for a selected operation.  The independent invariants concern
call count/order, the native iteration indices, exact failure and heap state,
actual final-result provenance, and absence of new divergence in a finite caller.
-/

abbrev ReopenedBase (E Ref V State : Type) :=
  MiddleM (Error E) (FieldHeap Ref V × State)

abbrev ReopenedObserved (E Ref V State : Type) :=
  MiddleM (Error E)
    (MiddleWorld (Error E) ((FieldHeap Ref V × State) × Option V))

/-- Core reads the same heap that arbitrary selected callees can mutate.
Receipt fields are observer-owned and are unchanged by the native state access. -/
scoped instance {E Ref V State : Type} :
    MonadStateOf (FieldHeap Ref V) (ReopenedObserved E Ref V State) where
  get := ⟨fun world => some (.ok (world.1.1.1, world))⟩
  set heap := ⟨fun world =>
    some (.ok (PUnit.unit, (((heap, world.1.1.2), world.1.2), world.2)))⟩
  modifyGet f := ⟨fun world =>
    let (result, heap) := f world.1.1.1
    some (.ok (result, (((heap, world.1.1.2), world.1.2), world.2)))⟩

/-- Record the actual native index even when the selected iterator throws.
The receipt is private to the observer; arbitrary result, heap mutation and
exception values are left unchanged. -/
def ReopenedObserveIndex {E Ref V State : Type} (label : String)
    (index : JInt .i64) (action : ReopenedBase E Ref V State V) :
    ReopenedObserved E Ref V State V := ⟨fun (state, history) =>
  match (LateCarry (Result := V) action).run state with
  | none => none
  | some (.error (error, next)) =>
      some (.error (error,
        (next, history ++ [⟨label, some error, next, toString index.val⟩])))
  | some (.ok (value, next)) =>
      some (.ok (value,
        (next, history ++ [⟨label, none, next, toString index.val⟩])))⟩

/-- Observe actual native index arguments independently of the caller's returned
value.  Arbitrary iterator errors, heap mutations, and divergence are retained. -/
def ReopenedObserveIteration {E Ref V State : Type}
    (ops : IndexedIterateOps (ReopenedBase E Ref V State) V) :
    IndexedIterateOps (ReopenedObserved E Ref V State) V where
  first := fun value index => ReopenedObserveIndex "indexedFirst" index
    (ops.first value index)
  next := fun value index state => ReopenedObserveIndex "indexedNext" index
    (ops.next value index state)

/-- Both successful and failed selected iterator calls carry their actual
native literal argument; this assertion is independent of their result values. -/
def ReopenedIndexArguments {E State A : Type}
    (observation : Option (Except (E × MiddleWorld E State)
      (A × MiddleWorld E State))) : Prop :=
  MiddleOutcomeCheck (fun _ history =>
    ∀ call ∈ history,
      (call.label = "indexedFirst" → call.detail = "1") ∧
      (call.label = "indexedNext" → call.detail = "2")) observation

/-- The only native error sites are the three fixed Core field reads after
one of the two iterator calls.  They preserve the final heap of that call. -/
def ReopenedLocalError {E : Type} (before : List String)
    (error : Error E) (labels : List String) : Prop :=
  (error = .typeError "getglobal" ∨ error = .jl .boundsError ∨ error = .undefRefError) ∧
  (labels = before ++ ["indexedFirst"] ∨
    labels = before ++ ["indexedFirst", "indexedNext"])

/-- Full observations cover both arbitrary selected exceptions and the closed
Core exceptions; normal return comes from the actual final selected call. -/
def ReopenedAudit {E Ref V State : Type} (path before : List String)
    (initial : FieldHeap Ref V × State)
    (observation : Option (Except
      (Error E × MiddleWorld (Error E) ((FieldHeap Ref V × State) × Option V))
      (V × MiddleWorld (Error E) ((FieldHeap Ref V × State) × Option V)))) : Prop :=
  LateAudit path (ReopenedLocalError before) initial observation ∧
    ReopenedIndexArguments observation

def ReopenedIterationTotal {E Ref V State : Type}
    (ops : IndexedIterateOps (ReopenedBase E Ref V State) V) : Prop :=
  (∀ value index, MiddleTotal (ops.first value index)) ∧
    (∀ value index state, MiddleTotal (ops.next value index state))

def ReopenedObserveCisReal {E Ref V State : Type}
    (ops : CisRealOps (ReopenedBase E Ref V State) V) :
    CisRealOps (ReopenedObserved E Ref V State) V where
  sincos := fun value => LateObserved "sincos" (ops.sincos value)
  iteration := ReopenedObserveIteration ops.iteration
  construct := fun re im => LateReturned "construct" (ops.construct re im)

/-- Real cis preserves arbitrary sincos/iteration/constructor effects, exactly
two indexed calls with native indices 1 and 2, all Core destructuring failures,
and the final constructor value.  Total selected calls cannot introduce divergence.
Invariant: base/complex.jl:587-590. -/
def ReopenedCisRealAudit : Prop :=
  ∀ (E Ref V State : Type) (view : V → FieldDescriptor Ref V)
      (ops : CisRealOps (ReopenedBase E Ref V State) V)
      (theta : V) (heap : FieldHeap Ref V) (state : State),
    let observation := (cisReal (E := E) view (ReopenedObserveCisReal ops) theta).run
      (((heap, state), none), [])
    ReopenedAudit ["sincos", "indexedFirst", "indexedNext", "construct"]
      ["sincos"] (heap, state) observation ∧
    MiddleNoNewDivergence
      ((∀ value, MiddleTotal (ops.sincos value)) ∧
        ReopenedIterationTotal ops.iteration ∧
        (∀ re im, MiddleTotal (ops.construct re im))) observation

def ReopenedObserveCisComplex {E Ref V State : Type}
    (ops : CisComplexOps (ReopenedBase E Ref V State) V) :
    CisComplexOps (ReopenedObserved E Ref V State) V where
  negate := fun value => LateObserved "negate" (ops.negate value)
  exponential := fun value => LateObserved "exp" (ops.exponential value)
  sincos := fun value => LateObserved "sincos" (ops.sincos value)
  iteration := ReopenedObserveIteration ops.iteration
  multiply := fun a b => LateObserved "multiply" (ops.multiply a b)
  construct := fun re im => LateReturned "construct" (ops.construct re im)

/-- Complex cis computes damping before its real query, then one sincos,
two indexed calls, two ordered products and one terminal constructor.  Every
selected error and mutable heap is retained; native reads have only their fixed
error sites.  Finite selected calls imply finite caller execution.
Invariant: base/complex.jl:592-596. -/
def ReopenedCisComplexAudit : Prop :=
  ∀ (E Ref V State : Type) (view : V → FieldDescriptor Ref V)
      (ops : CisComplexOps (ReopenedBase E Ref V State) V)
      (parts : ComponentOps (ReopenedBase E Ref V State) V)
      (z : Complex V) (heap : FieldHeap Ref V) (state : State),
    let observation := (cisComplex (E := E) view (ReopenedObserveCisComplex ops) z
      (LateObserveParts parts)).run (((heap, state), none), [])
    ReopenedAudit ["imag", "negate", "exp", "real", "sincos", "indexedFirst",
      "indexedNext", "multiply", "multiply", "construct"]
      ["imag", "negate", "exp", "real", "sincos"] (heap, state) observation ∧
    MiddleNoNewDivergence
      (MiddlePartsTotal parts ∧ (∀ value, MiddleTotal (ops.negate value)) ∧
        (∀ value, MiddleTotal (ops.exponential value)) ∧
        (∀ value, MiddleTotal (ops.sincos value)) ∧
        ReopenedIterationTotal ops.iteration ∧
        (∀ a b, MiddleTotal (ops.multiply a b)) ∧
        (∀ re im, MiddleTotal (ops.construct re im))) observation

def ReopenedObserveCisPiComplex {E Ref V State : Type}
    (ops : CisPiComplexOps (ReopenedBase E Ref V State) V) :
    CisPiComplexOps (ReopenedObserved E Ref V State) V where
  multiplyPi := fun value => LateObserved "multiplyPi" (ops.multiplyPi value)
  negate := fun value => LateObserved "negate" (ops.negate value)
  exponential := fun value => LateObserved "exp" (ops.exponential value)
  sincospi := fun value => LateObserved "sincospi" (ops.sincospi value)
  iteration := ReopenedObserveIteration ops.iteration
  multiply := fun a b => LateObserved "multiply" (ops.multiply a b)
  construct := fun re im => LateReturned "construct" (ops.construct re im)

/-- Cispi observes the distinct actual-π multiplication before negation and
exponentiation.  Getter/iteration/product effects and all exact error states
remain observable on the full unfixed domain, with actual final-value provenance.
Invariant: base/complex.jl:620-624. -/
def ReopenedCisPiComplexAudit : Prop :=
  ∀ (E Ref V State : Type) (view : V → FieldDescriptor Ref V)
      (ops : CisPiComplexOps (ReopenedBase E Ref V State) V)
      (parts : ComponentOps (ReopenedBase E Ref V State) V)
      (z : Complex V) (heap : FieldHeap Ref V) (state : State),
    let observation := (cispiComplex (E := E) view (ReopenedObserveCisPiComplex ops) z
      (LateObserveParts parts)).run (((heap, state), none), [])
    ReopenedAudit ["imag", "multiplyPi", "negate", "exp", "real", "sincospi",
      "indexedFirst", "indexedNext", "multiply", "multiply", "construct"]
      ["imag", "multiplyPi", "negate", "exp", "real", "sincospi"]
      (heap, state) observation ∧
    MiddleNoNewDivergence
      (MiddlePartsTotal parts ∧ (∀ value, MiddleTotal (ops.multiplyPi value)) ∧
        (∀ value, MiddleTotal (ops.negate value)) ∧
        (∀ value, MiddleTotal (ops.exponential value)) ∧
        (∀ value, MiddleTotal (ops.sincospi value)) ∧
        ReopenedIterationTotal ops.iteration ∧
        (∀ a b, MiddleTotal (ops.multiply a b)) ∧
        (∀ re im, MiddleTotal (ops.construct re im))) observation

def ReopenedObserveTangent {E Ref V State : Type}
    (ops : TangentOps (ReopenedBase E Ref V State) V) :
    TangentOps (ReopenedObserved E Ref V State) V where
  reim := fun z => LateObserved "reim" (ops.reim z)
  iteration := ReopenedObserveIteration ops.iteration
  negateInput := fun value => LateObserved "negateInput" (ops.negateInput value)
  constructInput := fun re im => LateObserved "constructInput" (ops.constructInput re im)
  hyperbolicTangent := fun value => LateObserved "tanh" (ops.hyperbolicTangent value)
  imag := fun value => LateObserved "imag" (ops.imag value)
  real := fun value => LateObserved "real" (ops.real value)
  negateOutput := fun value => LateObserved "negateOutput" (ops.negateOutput value)
  constructOutput := fun re im => LateReturned "constructOutput" (ops.constructOutput re im)

/-- Tangent preserves the selected reim iteration, both rotations and tanh
call, querying its arbitrary result's imaginary part before real.  Exact errors,
heap mutations, terminal value and finite-call termination are all retained.
Invariant: base/complex.jl:943-947. -/
def ReopenedTangentAudit : Prop :=
  ∀ (E Ref V State : Type) (view : V → FieldDescriptor Ref V)
      (ops : TangentOps (ReopenedBase E Ref V State) V)
      (z : Complex V) (heap : FieldHeap Ref V) (state : State),
    let observation := (tangentComplex (E := E) view (ReopenedObserveTangent ops) z).run
      (((heap, state), none), [])
    ReopenedAudit ["reim", "indexedFirst", "indexedNext", "negateInput",
      "constructInput", "tanh", "imag", "real", "negateOutput", "constructOutput"]
      ["reim"] (heap, state) observation ∧
    MiddleNoNewDivergence
      ((∀ value, MiddleTotal (ops.reim value)) ∧ ReopenedIterationTotal ops.iteration ∧
        (∀ value, MiddleTotal (ops.negateInput value)) ∧
        (∀ re im, MiddleTotal (ops.constructInput re im)) ∧
        (∀ value, MiddleTotal (ops.hyperbolicTangent value)) ∧
        (∀ value, MiddleTotal (ops.imag value)) ∧
        (∀ value, MiddleTotal (ops.real value)) ∧
        (∀ value, MiddleTotal (ops.negateOutput value)) ∧
        (∀ re im, MiddleTotal (ops.constructOutput re im))) observation

def ReopenedObserveHyperbolicSine {E Ref V State : Type}
    (ops : HyperbolicSineOps (ReopenedBase E Ref V State) V) :
    HyperbolicSineOps (ReopenedObserved E Ref V State) V where
  reim := fun z => LateObserved "reim" (ops.reim z)
  iteration := ReopenedObserveIteration ops.iteration
  constructInput := fun re im => LateObserved "constructInput" (ops.constructInput re im)
  sine := fun value => LateObserved "sin" (ops.sine value)
  imag := fun value => LateObserved "imag" (ops.imag value)
  real := fun value => LateObserved "real" (ops.real value)
  constructOutput := fun re im => LateReturned "constructOutput" (ops.constructOutput re im)

/-- Hyperbolic sine makes one selected sin call between its two constructors,
with output imaginary-before-real queries; arbitrary returned runtime types,
heap mutations and exact errors are preserved, and no new divergence is added.
Invariant: base/complex.jl:991-995. -/
def ReopenedHyperbolicSineAudit : Prop :=
  ∀ (E Ref V State : Type) (view : V → FieldDescriptor Ref V)
      (ops : HyperbolicSineOps (ReopenedBase E Ref V State) V)
      (z : Complex V) (heap : FieldHeap Ref V) (state : State),
    let observation := (hyperbolicSineComplex (E := E) view
      (ReopenedObserveHyperbolicSine ops) z).run (((heap, state), none), [])
    ReopenedAudit ["reim", "indexedFirst", "indexedNext", "constructInput",
      "sin", "imag", "real", "constructOutput"] ["reim"] (heap, state) observation ∧
    MiddleNoNewDivergence
      ((∀ value, MiddleTotal (ops.reim value)) ∧ ReopenedIterationTotal ops.iteration ∧
        (∀ re im, MiddleTotal (ops.constructInput re im)) ∧
        (∀ value, MiddleTotal (ops.sine value)) ∧
        (∀ value, MiddleTotal (ops.imag value)) ∧
        (∀ value, MiddleTotal (ops.real value)) ∧
        (∀ re im, MiddleTotal (ops.constructOutput re im))) observation

def ReopenedObserveHyperbolicCosine {E Ref V State : Type}
    (ops : HyperbolicCosineOps (ReopenedBase E Ref V State) V) :
    HyperbolicCosineOps (ReopenedObserved E Ref V State) V where
  reim := fun z => LateObserved "reim" (ops.reim z)
  iteration := ReopenedObserveIteration ops.iteration
  negate := fun value => LateObserved "negate" (ops.negate value)
  construct := fun re im => LateObserved "construct" (ops.construct re im)
  cosine := fun value => LateReturned "cos" (ops.cosine value)

/-- Hyperbolic cosine performs one negation and one constructor after the
selected reim iteration, returns the actual cosine result directly, and retains
all arbitrary callee errors and mutable heaps plus the fixed Core read failures.
Invariant: base/complex.jl:997-1000. -/
def ReopenedHyperbolicCosineAudit : Prop :=
  ∀ (E Ref V State : Type) (view : V → FieldDescriptor Ref V)
      (ops : HyperbolicCosineOps (ReopenedBase E Ref V State) V)
      (z : Complex V) (heap : FieldHeap Ref V) (state : State),
    let observation := (hyperbolicCosineComplex (E := E) view
      (ReopenedObserveHyperbolicCosine ops) z).run (((heap, state), none), [])
    ReopenedAudit ["reim", "indexedFirst", "indexedNext", "negate", "construct", "cos"]
      ["reim"] (heap, state) observation ∧
    MiddleNoNewDivergence
      ((∀ value, MiddleTotal (ops.reim value)) ∧ ReopenedIterationTotal ops.iteration ∧
        (∀ value, MiddleTotal (ops.negate value)) ∧
        (∀ re im, MiddleTotal (ops.construct re im)) ∧
        (∀ value, MiddleTotal (ops.cosine value))) observation

end JuliaLean.Proofs.base.complex.Models2Group9


namespace JuliaLean.Proofs.base.complex.Models2Group9

open JuliaLean JuliaLean.base.complex
open JuliaLean.base.complex.Models2Group9

/-- Arbitrary mutable Julia field heap and unrelated user state. -/
abbrev InverseReopenedState (Ref V State : Type) := FieldHeap Ref V × State

/-- Callee errors retain state; none represents divergence. -/
abbrev InverseReopenedM (E Ref V State A : Type) :=
  ExceptT (Error E) (StateT (InverseReopenedState Ref V State) Option) A

/-- Concrete lens exposing the very same heap to the unpack primitive and to
all arbitrary selected callees.  Auxiliary observation state is kept separate. -/
scoped instance InverseReopenedHeapState {E Ref V State : Type} :
    MonadStateOf (FieldHeap Ref V) (InverseReopenedM E Ref V State) where
  get := fun state => some (.ok state.1, state)
  set heap := fun state => some (.ok (), (heap, state.2))
  modifyGet f := fun state =>
    let (value, heap) := f state.1
    some (.ok value, (heap, state.2))

inductive InverseReopenedArgument (A V Other : Type) where
  | input (z : Complex A)
  | value (value : V)
  | nativeInt (index : JInt .i64)
  | predicate (value : PredicateValue Other)

inductive InverseReopenedObservedResult (V Other : Type) where
  | value (value : V)
  | predicate (value : PredicateValue Other)

structure InverseReopenedReceipt (E Ref A V Other State : Type) where
  label : String
  arguments : List (InverseReopenedArgument A V Other)
  outcome : Except (Error E) (InverseReopenedObservedResult V Other)
  before : InverseReopenedState Ref V State
  after : InverseReopenedState Ref V State

abbrev InverseReopenedHistory (E Ref A V Other State : Type) :=
  List (InverseReopenedReceipt E Ref A V Other State)

/-- Observe actual selected calls without allowing them to alter the history.
The heap remains shared, and exceptions retain all preceding heap mutations. -/
def InverseReopenedObserve {E Ref A V Other State X : Type}
    (label : String) (arguments : List (InverseReopenedArgument A V Other))
    (encode : X → InverseReopenedObservedResult V Other)
    (action : InverseReopenedM E Ref V State X) :
    InverseReopenedM E Ref V (State × InverseReopenedHistory E Ref A V Other State) X :=
  fun (heap, (state, history)) =>
    match action (heap, state) with
    | none => none
    | some (outcome, (heapAfter, stateAfter)) =>
        let receipt : InverseReopenedReceipt E Ref A V Other State :=
          { label, arguments, outcome := outcome.map encode,
            before := (heap, state), after := (heapAfter, stateAfter) }
        some (outcome, (heapAfter, (stateAfter, history ++ [receipt])))

/-- Every selected operation is unrestricted; no purity, algebraic, predicate,
conversion or iterator correctness law is supplied to the model. -/
def InverseReopenedObservedOps {E Ref A V Other State : Type}
    (ops : InverseReopenedOps (InverseReopenedM E Ref V State) A V Other) :
    InverseReopenedOps
      (InverseReopenedM E Ref V (State × InverseReopenedHistory E Ref A V Other State))
      A V Other where
  reim := fun z => InverseReopenedObserve "reim" [.input z]
    InverseReopenedObservedResult.value (ops.reim z)
  iterations := {
    first := fun value index => InverseReopenedObserve "indexedFirst" [.value value, .nativeInt index]
      InverseReopenedObservedResult.value (ops.iterations.first value index)
    next := fun value index state => InverseReopenedObserve "indexedNext"
      [.value value, .nativeInt index, .value state]
      InverseReopenedObservedResult.value (ops.iterations.next value index state) }
  isinf := fun value => InverseReopenedObserve "isinf" [.value value]
    InverseReopenedObservedResult.predicate (ops.isinf value)
  orOther := fun left right => InverseReopenedObserve "orOther" [.predicate left, .predicate right]
    InverseReopenedObservedResult.predicate (ops.orOther left right)
  zero := fun value => InverseReopenedObserve "zero" [.value value]
    InverseReopenedObservedResult.value (ops.zero value)
  negate := fun value => InverseReopenedObserve "negate" [.value value]
    InverseReopenedObservedResult.value (ops.negate value)
  copysign := fun x y => InverseReopenedObserve "copysign" [.value x, .value y]
    InverseReopenedObservedResult.value (ops.copysign x y)
  flipsign := fun x y => InverseReopenedObserve "flipsign" [.value x, .value y]
    InverseReopenedObservedResult.value (ops.flipsign x y)
  publicComplex := fun x y => InverseReopenedObserve "publicComplex" [.value x, .value y]
    InverseReopenedObservedResult.value (ops.publicComplex x y)
  multiply := fun x y => InverseReopenedObserve "multiply" [.value x, .value y]
    InverseReopenedObservedResult.value (ops.multiply x y)
  add := fun x y => InverseReopenedObserve "add" [.value x, .value y]
    InverseReopenedObservedResult.value (ops.add x y)
  divide := fun x y => InverseReopenedObserve "divide" [.value x, .value y]
    InverseReopenedObservedResult.value (ops.divide x y)

def InverseReopenedFailure {E Ref A V Other State : Type}
    (receipt : InverseReopenedReceipt E Ref A V Other State) : Option (Error E) :=
  match receipt.outcome with | .error error => some error | .ok _ => none

def InverseReopenedStateChain {E Ref A V Other State : Type}
    (initial final : InverseReopenedState Ref V State) :
    InverseReopenedHistory E Ref A V Other State → Prop
  | [] => final = initial
  | receipt :: rest => receipt.before = initial ∧
      InverseReopenedStateChain receipt.after final rest

def InverseReopenedValueAt {E Ref A V Other State : Type}
    (history : InverseReopenedHistory E Ref A V Other State) (index : Nat) : Option V :=
  match history[index]? with
  | some receipt => match receipt.outcome with | .ok (.value value) => some value | _ => none
  | none => none

/-- The only selected-call prefix before the inverse's predicates consists of
reim and the two indexed-iteration targets on its actual result.  Primitive
field failures may end that prefix; the helper's separately registered
invariant covers their field indices, lookup results and precise errors. -/
def InverseReopenedOpening {E Ref A V Other State : Type}
    (z : Complex A) (history : InverseReopenedHistory E Ref A V Other State) : Prop :=
  match InverseReopenedValueAt history 0 with
  | none => history.map (fun receipt => (receipt.label, receipt.arguments)) = [("reim", [.input z])]
  | some components =>
      ∃ state : V,
        let expected : List (String × List (InverseReopenedArgument A V Other)) :=
          [("reim", [.input z]), ("indexedFirst", [.value components, .nativeInt (JInt.lit .i64 1)]),
           ("indexedNext", [.value components, .nativeInt (JInt.lit .i64 2), .value state])]
        (history.map (fun receipt => (receipt.label, receipt.arguments))).take 3 =
          expected.take history.length ∧ history ≠ []

/-- An independent branch receipt language.  The infinity branch never
multiplies or divides; the ordinary branch constructs its numerator before
any denominator arithmetic.  Each later argument uses the actual earlier
result, and an incomplete word must end at a thrown selected-call exception. -/
def InverseReopenedBranch {E Ref A V Other State : Type}
    (infinite : Bool) (c d : V)
    (history : InverseReopenedHistory E Ref A V Other State) : Prop :=
  ∃ v0 v1 v2 v3 v4 : V,
    (∀ value, InverseReopenedValueAt history 0 = some value → v0 = value) ∧
    (∀ value, InverseReopenedValueAt history 1 = some value → v1 = value) ∧
    (∀ value, InverseReopenedValueAt history 2 = some value → v2 = value) ∧
    (∀ value, InverseReopenedValueAt history 3 = some value → v3 = value) ∧
    (∀ value, InverseReopenedValueAt history 4 = some value → v4 = value) ∧
    let expected : List (String × List (InverseReopenedArgument A V Other)) :=
      if infinite then
        [("zero", [.value c]), ("copysign", [.value v0, .value c]),
         ("zero", [.value d]), ("negate", [.value v2]),
         ("flipsign", [.value v3, .value d]), ("publicComplex", [.value v1, .value v4])]
      else
        [("negate", [.value d]), ("publicComplex", [.value c, .value v0]),
         ("multiply", [.value c, .value c]), ("multiply", [.value d, .value d]),
         ("add", [.value v2, .value v3]), ("divide", [.value v1, .value v4])]
    history.length ≤ 6 ∧
      history.map (fun receipt => (receipt.label, receipt.arguments)) = expected.take history.length ∧
      (history.length < 6 → ∃ last, history.getLast? = some last ∧ InverseReopenedFailure last ≠ none)

/-- Both predicate calls precede | selection.  Native Bool operands use the
fixed disjunction; otherwise exactly one selected | target must run with both
actual operands.  A non-Bool final condition fails before either branch. -/
def InverseReopenedEagerGate {E Ref A V Other State : Type}
    (history : InverseReopenedHistory E Ref A V Other State)
    (outcome : Except (Error E) V) : Prop :=
  ∀ (first : InverseReopenedReceipt E Ref A V Other State), history[3]? = some first →
    ∃ c d : V,
      first.label = "isinf" ∧ first.arguments = [.value c] ∧
      match first.outcome with
      | .error _ => True
      | .ok (.value _) => False
      | .ok (.predicate left) =>
          ∃ second, history[4]? = some second ∧ second.label = "isinf" ∧
            second.arguments = [.value d] ∧
            match second.outcome with
            | .error _ => True
            | .ok (.value _) => False
            | .ok (.predicate right) =>
                match left, right with
                | .boolean a, .boolean b =>
                    InverseReopenedBranch (a || b) c d (history.drop 5)
                | _, _ =>
                    ∃ disjunction, history[5]? = some disjunction ∧
                      disjunction.label = "orOther" ∧
                      disjunction.arguments = [.predicate left, .predicate right] ∧
                      match disjunction.outcome with
                      | .error _ => True
                      | .ok (.value _) => False
                      | .ok (.predicate (.boolean infinite)) =>
                          InverseReopenedBranch infinite c d (history.drop 6)
                      | .ok (.predicate (.other _)) =>
                          history.length = 6 ∧ outcome = .error (.typeError "inv Boolean condition")

/-- Locally generated failures are restricted to the fixed unpack primitive
or the inverse's Boolean condition.  Arbitrary selected exceptions keep their
exact original payload instead of being converted into one of these errors. -/
def InverseReopenedLocalFailure {E Ref A V Other State : Type}
    (last : InverseReopenedReceipt E Ref A V Other State) (error : Error E) : Prop :=
  ((last.label = "indexedFirst" ∨ last.label = "indexedNext") ∧
    (∃ value, last.outcome = .ok (.value value)) ∧
    (error = .typeError "getglobal" ∨ error = .jl .boundsError ∨ error = .undefRefError)) ∨
  (last.label = "orOther" ∧
    (∃ value, last.outcome = .ok (.predicate (.other value))) ∧
    error = .typeError "inv Boolean condition")

/-- Call receipts form an uninterrupted chain of actual heap and user states.
The first selected exception is propagated exactly; concrete local errors
occur only at their unpack/condition boundary.  Successful results come from
the final actual lowercase-complex or division target. -/
def InverseReopenedAudit {E Ref A V Other State : Type}
    (z : Complex A) (initial : InverseReopenedState Ref V State)
    (observed : Option (Except (Error E) V ×
      InverseReopenedState Ref V (State × InverseReopenedHistory E Ref A V Other State))) : Prop :=
  match observed with
  | none => True
  | some (outcome, (heap, (state, history))) =>
      InverseReopenedOpening z history ∧
      InverseReopenedStateChain initial (heap, state) history ∧
      InverseReopenedEagerGate history outcome ∧
      match outcome with
      | .ok value =>
          (∀ receipt ∈ history, InverseReopenedFailure receipt = none) ∧
          ∃ last, history.getLast? = some last ∧ last.outcome = .ok (.value value) ∧
            (last.label = "publicComplex" ∨ last.label = "divide")
      | .error error =>
          ∃ earlier last, history = earlier ++ [last] ∧
            (∀ receipt ∈ earlier, InverseReopenedFailure receipt = none) ∧
            (heap, state) = last.after ∧
            (InverseReopenedFailure last = some error ∨
              (InverseReopenedFailure last = none ∧ InverseReopenedLocalFailure last error))

/-- Totality here permits any returned value or exception and any heap/state
mutation.  It asserts only that a selected call does not diverge. -/
def InverseReopenedCallTotal {E Ref V State X : Type}
    (action : InverseReopenedM E Ref V State X) : Prop :=
  ∀ state, action state ≠ none

/-- A finite caller cannot introduce divergence when all selected targets
complete.  This supplies no algebraic or result-correctness law. -/
def InverseReopenedCallsTotal {E Ref A V Other State : Type}
    (ops : InverseReopenedOps (InverseReopenedM E Ref V State) A V Other) : Prop :=
  (∀ z, InverseReopenedCallTotal (ops.reim z)) ∧
  (∀ value index, InverseReopenedCallTotal (ops.iterations.first value index)) ∧
  (∀ value index state, InverseReopenedCallTotal (ops.iterations.next value index state)) ∧
  (∀ value, InverseReopenedCallTotal (ops.isinf value)) ∧
  (∀ left right, InverseReopenedCallTotal (ops.orOther left right)) ∧
  (∀ value, InverseReopenedCallTotal (ops.zero value)) ∧
  (∀ value, InverseReopenedCallTotal (ops.negate value)) ∧
  (∀ x y, InverseReopenedCallTotal (ops.copysign x y)) ∧
  (∀ x y, InverseReopenedCallTotal (ops.flipsign x y)) ∧
  (∀ x y, InverseReopenedCallTotal (ops.publicComplex x y)) ∧
  (∀ x y, InverseReopenedCallTotal (ops.multiply x y)) ∧
  (∀ x y, InverseReopenedCallTotal (ops.add x y)) ∧
  (∀ x y, InverseReopenedCallTotal (ops.divide x y))

/-- Independent effect/order invariant for the full generic inverse domain,
including arbitrary reim and iterator results, mutable field heaps, non-Bool
predicates, type-changing arithmetic, constructor results and user exceptions.
No callee correctness law or purity premise is assumed.  Native eager |,
branch gates, numerator-before-denominator evaluation, source arguments,
first errors and returned-value origins remain observable.
Julia source: base/complex.jl:283-287; indexed unpacking base/tuple.jl:161-172. -/
def InverseReopenedEvaluationAudit : Prop :=
  ∀ (E Ref A V Other State : Type)
      (view : V → FieldDescriptor Ref V)
      (ops : InverseReopenedOps (InverseReopenedM E Ref V State) A V Other)
      (z : Complex A) (heap : FieldHeap Ref V) (state : State),
    let observed := (inverseComplexReopened (E := E) view (InverseReopenedObservedOps ops) z)
      (heap, (state, []))
    InverseReopenedAudit z (heap, state) observed ∧
      (InverseReopenedCallsTotal ops → observed ≠ none)

end JuliaLean.Proofs.base.complex.Models2Group9


namespace JuliaLean.Proofs.base.complex.Models2Group9

open JuliaLean JuliaLean.base.complex JuliaLean.base.complex.Models2Group9

abbrev ExpBaseTrace (E Ref V State : Type) :=
  State × List (RootReceipt E (FieldHeap Ref V × State))

/-- Observe actual selected calls over the shared field heap and arbitrary
auxiliary state.  Heap reads remain the closed native primitive's state reads. -/
def expBaseObserve {E Ref V State A : Type} (label : String)
    (action : FieldM E Ref V State A) : FieldM E Ref V (ExpBaseTrace E Ref V State) A :=
  fun heap (state, history) =>
    match action.run heap state with
    | none => none
    | some ((outcome, nextHeap), nextState) =>
        let receipt : RootReceipt E (FieldHeap Ref V × State) :=
          { label, detail := ""
            failure := match outcome with | .ok _ => none | .error error => some error
            before := (heap, state), after := (nextHeap, nextState) }
        some ((outcome, nextHeap), (nextState, history ++ [receipt]))

def expBaseObservedOps {E Ref V State Tag Target : Type}
    (ops : ExponentialBaseOps (FieldM E Ref V State) V Tag Target) :
    ExponentialBaseOps (FieldM E Ref V (ExpBaseTrace E Ref V State)) V Tag Target where
  floatValue := fun value => expBaseObserve "float" (ops.floatValue value)
  real := fun value => expBaseObserve "real" (ops.real value)
  imag := fun value => expBaseObserve "imag" (ops.imag value)
  same := ops.same
  scalarExponential := fun value => expBaseObserve "exponential" (ops.scalarExponential value)
  floatType := fun tag => expBaseObserve "floatType" (ops.floatType tag)
  convert := fun target literal => expBaseObserve ("convert:" ++ toString literal.val)
    (ops.convert target literal)
  logarithm := fun value => expBaseObserve "log" (ops.logarithm value)
  multiply := fun left right => expBaseObserve "multiply" (ops.multiply left right)
  sincos := fun value => expBaseObserve "sincos" (ops.sincos value)
  iterate :=
    { first := fun value index => expBaseObserve ("iterate:" ++ toString index.val)
        (ops.iterate.first value index)
      next := fun value index state => expBaseObserve ("iterate:" ++ toString index.val)
        (ops.iterate.next value index state) }
  construct := fun re im => expBaseObserve "construct" (ops.construct re im)

def expBaseObservation {E Ref V State A : Type}
    (observed : Option ((Except (Error E) A × FieldHeap Ref V) × ExpBaseTrace E Ref V State)) :
    Option (Except (Error E) A × RootWorld E (FieldHeap Ref V × State)) :=
  observed.map (fun ((outcome, heap), (state, history)) => (outcome, ((heap, state), history)))

/-- Complete successful call histories have one scalar exponential leaf, one
float/real prefix for every recursive frame, and one ordered post-exponential
suffix for every frame.  The literal and both native iteration indices occur
in the labels taken from the actual arguments supplied to those selected calls.
This is a call-tree invariant, not a second computation of any numeric result. -/
def ExpBaseCallTree (base : Int) (labels : List String) : Prop :=
  ∃ depth : Nat,
    let opening := (List.replicate (depth + 1) ["float", "real"]).flatten
    let ending := ["imag", "floatType", "convert:" ++ toString base, "log", "multiply",
      "sincos", "iterate:1", "iterate:2", "multiply", "multiply", "construct"]
    labels = opening ++ ["exponential"] ++ (List.replicate (depth + 1) ending).flatten

def ExpBaseObservationAudit {E Ref V State : Type} (base : Int)
    (initialHeap : FieldHeap Ref V) (initialState : State)
    (observed : Option ((Except (Error E) V × FieldHeap Ref V) × ExpBaseTrace E Ref V State)) : Prop :=
  let projected := expBaseObservation observed
  RootRecursiveAudit "float" ["construct"]
    (fun error last => FieldLocalError error ∧
      (last.label = "iterate:1" ∨ last.label = "iterate:2"))
    (initialHeap, initialState) projected ∧
  match projected with
  | none => True
  | some (outcome, (_, history)) =>
      let labels := history.map (fun receipt => receipt.label)
      match outcome with
      | .ok _ => ExpBaseCallTree base labels
      | .error _ => ∃ suffix, ExpBaseCallTree base (labels ++ suffix)

/-- All original type tags, inputs, getter results, selected arithmetic,
iterator effects and mutable heaps are included.  Same-method recursion remains
actual recursion, and malformed unpacking returns preserve Core's exact error
classes and post-iterator state.  The fixed base is native Int2 in every frame.
Invariant: base/complex.jl:775-781. -/
def Exponential2ComplexEffects : Prop :=
  ∀ (E Ref V State Tag Target : Type) (view : V → FieldDescriptor Ref V)
      (ops : ExponentialBaseOps (FieldM E Ref V State) V Tag Target)
      (t : Tag) (z : Complex V) (heap : FieldHeap Ref V) (state : State),
    ExpBaseObservationAudit 2 heap state
      ((exponential2Complex (E := E)
        (monotoneBind := Lean.Order.instMonoBindExceptT
          (m := StateT (FieldHeap Ref V) (StateT (ExpBaseTrace E Ref V State) Option))
          (ε := Error E)) view (expBaseObservedOps ops) t z).run heap (state, []))

/-- Base-ten exponential has the same independent recursive call-tree/error
contract and passes actual native Int10 to conversion at every depth.
Invariant: base/complex.jl:783-789. -/
def Exponential10ComplexEffects : Prop :=
  ∀ (E Ref V State Tag Target : Type) (view : V → FieldDescriptor Ref V)
      (ops : ExponentialBaseOps (FieldM E Ref V State) V Tag Target)
      (t : Tag) (z : Complex V) (heap : FieldHeap Ref V) (state : State),
    ExpBaseObservationAudit 10 heap state
      ((exponential10Complex (E := E)
        (monotoneBind := Lean.Order.instMonoBindExceptT
          (m := StateT (FieldHeap Ref V) (StateT (ExpBaseTrace E Ref V State) Option))
          (ε := Error E)) view (expBaseObservedOps ops) t z).run heap (state, []))

/-- An actual same-method cycle through float/real cannot silently acquire a
fuel-bound error or a successful value.  Other selected callees are arbitrary
and are unreachable before the next recursive entry.
Invariant: base/complex.jl:775-789. -/
def ExponentialBaseCycleDiverges : Prop :=
  ∀ (E Ref State Target : Type) (view : Bool → FieldDescriptor Ref Bool)
      (ops : ExponentialBaseOps (FieldM E Ref Bool State) Bool Unit Target)
      (heap : FieldHeap Ref Bool) (state : State),
    let z : Complex Bool := ⟨false, false⟩
    let looping := { ops with
      floatValue := fun _ => pure true
      real := fun _ => pure true
      same := fun value => if value then some ((), z) else none }
    ((exponential2Complex (E := E)
      (monotoneBind := Lean.Order.instMonoBindExceptT
        (m := StateT (FieldHeap Ref Bool) (StateT State Option)) (ε := Error E))
      view looping () z).run heap state = none) ∧
    ((exponential10Complex (E := E)
      (monotoneBind := Lean.Order.instMonoBindExceptT
        (m := StateT (FieldHeap Ref Bool) (StateT State Option)) (ε := Error E))
      view looping () z).run heap state = none)

end JuliaLean.Proofs.base.complex.Models2Group9


namespace JuliaLean.Proofs.base.complex.Models2Group9

open JuliaLean JuliaLean.base.complex JuliaLean.base.complex.Models2Group9

inductive LogArgument (Tag V : Type) where
  | value (value : V)
  | complex (value : Complex V)
  | typeTag (tag : Tag)
  | integer (value : JInt .i64)
  | float64 (value : JuliaLean.Float.F64)

inductive LogObservedResult (V Other : Type) where
  | value (value : V)
  | predicate (value : PredicateValue Other)

structure LogReceipt (E Ref Tag V Other State : Type) where
  label : String
  arguments : List (LogArgument Tag V)
  outcome : Except (Error E) (LogObservedResult V Other)
  beforeHeap : FieldHeap Ref V
  afterHeap : FieldHeap Ref V
  beforeState : State
  afterState : State

/-- Observe each actual selected callee once; recursive calls are implemented
by the model and are not substituted with observer callbacks. -/
def LogObserve {E Ref Tag V Other State A : Type} (label : String)
    (arguments : List (LogArgument Tag V)) (pack : A → LogObservedResult V Other)
    (action : FieldM E Ref V State A) :
    FieldM E Ref V (State × List (LogReceipt E Ref Tag V Other State)) A :=
  fun heap (state, history) =>
    match action.run heap state with
    | none => none
    | some ((outcome, finalHeap), finalState) =>
        let receipt : LogReceipt E Ref Tag V Other State :=
          { label, arguments, outcome := outcome.map pack
            beforeHeap := heap, afterHeap := finalHeap
            beforeState := state, afterState := finalState }
        some ((outcome, finalHeap), (finalState, history ++ [receipt]))

def LogObservedOps {E Ref Tag V Other State : Type}
    (ops : LogComplexOps (FieldM E Ref V State) Tag V Other) :
    LogComplexOps (FieldM E Ref V (State × List (LogReceipt E Ref Tag V Other State))) Tag V Other where
  float := fun z => LogObserve "float" [.complex z] .value (ops.float z)
  real := fun value => LogObserve "real" [.value value] .value (ops.real value)
  typeOf := ops.typeOf
  convert := fun tag number => LogObserve "convert" [.typeTag tag, .integer number] .value (ops.convert tag number)
  divide := fun a b => LogObserve "divide" [.value a, .value b] .value (ops.divide a b)
  sameLog := ops.sameLog
  logOther := fun value => LogObserve "log" [.value value] .value (ops.logOther value)
  reim := fun value => LogObserve "reim" [.value value] .value (ops.reim value)
  ssqs := fun x y => LogObserve "ssqs" [.value x, .value y] .value (ops.ssqs x y)
  iteration :=
    { first := fun value index => LogObserve "indexed_first" [.value value, .integer index] .value
        (ops.iteration.first value index)
      next := fun value index state => LogObserve "indexed_next" [.value value, .integer index, .value state] .value
        (ops.iteration.next value index state) }
  abs := fun value => LogObserve "abs" [.value value] .value (ops.abs value)
  less := fun a b => LogObserve "less" [.value a, .value b] .predicate (ops.less a b)
  equalZero := fun value zero => LogObserve "equalZero" [.value value, .integer zero] .predicate (ops.equalZero value zero)
  halfLess := fun half value => LogObserve "halfLess" [.float64 half, .value value] .predicate (ops.halfLess half value)
  lessEqual := fun a b => LogObserve "lessEqual" [.value a, .value b] .predicate (ops.lessEqual a b)
  multiply := fun a b => LogObserve "multiply" [.value a, .value b] .value (ops.multiply a b)
  subtractInt := fun value one => LogObserve "subtractInt" [.value value, .integer one] .value (ops.subtractInt value one)
  addInt := fun value one => LogObserve "addInt" [.value value, .integer one] .value (ops.addInt value one)
  add := fun a b => LogObserve "add" [.value a, .value b] .value (ops.add a b)
  log1p := fun value => LogObserve "log1p" [.value value] .value (ops.log1p value)
  divideInt := fun value two => LogObserve "divideInt" [.value value, .integer two] .value (ops.divideInt value two)
  angle := fun value => LogObserve "angle" [.value value] .value (ops.angle value)
  construct := fun real imag => LogObserve "construct" [.value real, .value imag] .value (ops.construct real imag)

def LogValueAt {E Ref Tag V Other State : Type}
    (history : List (LogReceipt E Ref Tag V Other State)) (index : Nat) : Option V := do
  let receipt ← history[index]?
  match receipt.outcome with
  | .ok (.value value) => some value
  | _ => none

def LogCallAt {E Ref Tag V Other State : Type}
    (history : List (LogReceipt E Ref Tag V Other State)) (index : Nat)
    (label : String) (arguments : List (LogArgument Tag V)) : Prop :=
  ∃ receipt, history[index]? = some receipt ∧ receipt.label = label ∧ receipt.arguments = arguments

/-- Ordered opening and actual conversion data flow, before the first
possible recursive log selection.  The first real query's actual runtime type
supplies every conversion tag; both conversion results reach the first divide.
The invariant observes calls and data, not scalar arithmetic laws. -/
def LogOpening {E Ref Tag V Other State : Type} (typeOf : V → Tag)
    (original : Complex V) (history : List (LogReceipt E Ref Tag V Other State)) : Prop :=
  (history.map (fun receipt => receipt.label)).take 7 =
    ["float", "real", "convert", "convert", "divide", "convert", "convert"].take (min 7 history.length) ∧
  LogCallAt history 0 "float" [.complex original] ∧
  (∀ value, LogValueAt history 0 = some value → LogCallAt history 1 "real" [.value value]) ∧
  (∀ value, LogValueAt history 1 = some value →
    (∀ receipt, history[2]? = some receipt → receipt.arguments = [.typeTag (typeOf value), .integer (JInt.lit .i64 5)]) ∧
    (∀ receipt, history[3]? = some receipt → receipt.arguments = [.typeTag (typeOf value), .integer (JInt.lit .i64 4)]) ∧
    (∀ receipt, history[5]? = some receipt → receipt.arguments = [.typeTag (typeOf value), .integer (JInt.lit .i64 3)]) ∧
    (∀ receipt, history[6]? = some receipt → receipt.arguments = [.typeTag (typeOf value), .integer (JInt.lit .i64 2)])) ∧
  (∀ receipt, history[4]? = some receipt → ∃ five four,
    LogValueAt history 2 = some five ∧ LogValueAt history 3 = some four ∧
    receipt.arguments = [.value five, .value four])

/-- Every literal argument retains its native Julia type and exact value at
all recursion depths.  Arbitrary selected callees need not obey algebraic laws. -/
def LogLiteralArguments {E Ref Tag V Other State : Type}
    (history : List (LogReceipt E Ref Tag V Other State)) : Prop :=
  ∀ receipt ∈ history,
    match receipt.label with
    | "convert" => ∃ tag number, receipt.arguments = [.typeTag tag, .integer number] ∧
        number.val ∈ [2, 3, 4, 5]
    | "equalZero" => ∃ value, receipt.arguments = [.value value, .integer (JInt.lit .i64 0)]
    | "halfLess" => ∃ value, receipt.arguments = [.float64 Fl64.half, .value value]
    | "subtractInt" => ∃ value, receipt.arguments = [.value value, .integer (JInt.lit .i64 1)]
    | "addInt" => ∃ value, receipt.arguments = [.value value, .integer (JInt.lit .i64 1)]
    | "divideInt" => ∃ value, receipt.arguments = [.value value, .integer (JInt.lit .i64 2)]
    | "indexed_first" => ∃ value, receipt.arguments = [.value value, .integer (JInt.lit .i64 1)]
    | "indexed_next" => ∃ value state, receipt.arguments = [.value value, .integer (JInt.lit .i64 2), .value state]
    | _ => True

def LogStateChain {E Ref Tag V Other State : Type}
    (initialHeap finalHeap : FieldHeap Ref V) (initialState finalState : State) :
    List (LogReceipt E Ref Tag V Other State) → Prop
  | [] => initialHeap = finalHeap ∧ initialState = finalState
  | receipt :: rest => receipt.beforeHeap = initialHeap ∧ receipt.beforeState = initialState ∧
      LogStateChain receipt.afterHeap finalHeap receipt.afterState finalState rest

def LogFailure {E Ref Tag V Other State : Type}
    (receipt : LogReceipt E Ref Tag V Other State) : Option (Error E) :=
  match receipt.outcome with | .error error => some error | .ok _ => none

/-- Local failures occur only at the actual Boolean use or fixed field read;
all other thrown values must be the exact exception of a selected callee. -/
def LogLocalError {E Ref Tag V Other State : Type}
    (error : Error E) (last : LogReceipt E Ref Tag V Other State) : Prop :=
  (error = .typeError "log Boolean condition" ∧
    last.label ∈ ["less", "equalZero", "halfLess", "lessEqual"] ∧
    ∃ value, last.outcome = .ok (.predicate (.other value))) ∨
  (last.label ∈ ["indexed_first", "indexed_next"] ∧ FieldLocalError error)

/-- Completed full-method executions retain the actual initial dataflow,
all native literals, complete mutation accounting, terminal first exceptions,
and the final selected constructor's exact return object.  Nested inherited
log calls obey the same algorithm; no recursive callback is supplied. -/
def LogExecutionAudit {E Ref Tag V Other State : Type}
    (typeOf : V → Tag) (original : Complex V) (heap : FieldHeap Ref V) (state : State)
    (observed : Option ((Except (Error E) V × FieldHeap Ref V) ×
      (State × List (LogReceipt E Ref Tag V Other State)))) : Prop :=
  match observed with
  | none => True
  | some ((outcome, finalHeap), (finalState, history)) =>
      LogOpening typeOf original history ∧ LogLiteralArguments history ∧
      LogStateChain heap finalHeap state finalState history ∧
      match outcome with
      | .ok value => (∀ receipt ∈ history, LogFailure receipt = none) ∧
          ∃ last, history.getLast? = some last ∧ last.label = "construct" ∧ last.outcome = .ok (.value value)
      | .error error => ∃ earlier last, history = earlier ++ [last] ∧
          (∀ receipt ∈ earlier, LogFailure receipt = none) ∧
          (LogFailure last = some error ∨
            (LogFailure last = none ∧ LogLocalError error last))

/-- Totality here describes termination, not correctness.  It is used only
in a conclusion excluding fabricated divergence for a finite no-reentry path. -/
def LogTotal {E Ref V State A : Type} (action : FieldM E Ref V State A) : Prop :=
  ∀ heap state, ∃ observed, action.run heap state = some observed

def LogCalleesTotal {E Ref Tag V Other State : Type}
    (ops : LogComplexOps (FieldM E Ref V State) Tag V Other) : Prop :=
  (∀ z, LogTotal (ops.float z)) ∧ (∀ value, LogTotal (ops.real value)) ∧
  (∀ tag number, LogTotal (ops.convert tag number)) ∧ (∀ a b, LogTotal (ops.divide a b)) ∧
  (∀ value, LogTotal (ops.logOther value)) ∧ (∀ value, LogTotal (ops.reim value)) ∧
  (∀ x y, LogTotal (ops.ssqs x y)) ∧
  (∀ value index, LogTotal (ops.iteration.first value index)) ∧
  (∀ value index state, LogTotal (ops.iteration.next value index state)) ∧
  (∀ value, LogTotal (ops.abs value)) ∧ (∀ a b, LogTotal (ops.less a b)) ∧
  (∀ value zero, LogTotal (ops.equalZero value zero)) ∧
  (∀ half value, LogTotal (ops.halfLess half value)) ∧ (∀ a b, LogTotal (ops.lessEqual a b)) ∧
  (∀ a b, LogTotal (ops.multiply a b)) ∧ (∀ value one, LogTotal (ops.subtractInt value one)) ∧
  (∀ value one, LogTotal (ops.addInt value one)) ∧ (∀ a b, LogTotal (ops.add a b)) ∧
  (∀ value, LogTotal (ops.log1p value)) ∧ (∀ value two, LogTotal (ops.divideInt value two)) ∧
  (∀ value, LogTotal (ops.angle value)) ∧ (∀ real imag, LogTotal (ops.construct real imag))

/-- Independent full-domain invariant over every selected callee and heap,
including type-changing conversions/getters, recursive log selection, malformed
reim/ssqs iterator results, mutation, exceptions, and divergence.  If dispatch
never reselects this source method and all callees terminate, this finite body
cannot invent divergence.  No scalar or callee correctness law is assumed.
Invariant: base/complex.jl:653-674. -/
def LogComplexRecursiveEffects : Prop :=
  ∀ (E Ref Tag V Other State : Type)
      (ops : LogComplexOps (FieldM E Ref V State) Tag V Other)
      (view : V → FieldDescriptor Ref V) (original : Complex V)
      (heap : FieldHeap Ref V) (state : State),
    let observed := (logComplexFull (E := E)
      (monotoneBind := Lean.Order.instMonoBindExceptT
        (m := StateT (FieldHeap Ref V)
          (StateT (State × List (LogReceipt E Ref Tag V Other State)) Option)) (ε := Error E))
      view (LogObservedOps ops) original).run heap (state, [])
    LogExecutionAudit ops.typeOf original heap state observed ∧
      (observed = none → ¬ ((∀ value, ops.sameLog value = none) ∧ LogCalleesTotal ops))

/-- A reachable custom conversion may return the original Complex at the
literal-two call, reselecting log(::Complex) indefinitely before reim or angle.
False represents a custom Real atom and true the enclosing Complex; their
runtime type tags are distinct Bool tags.  Arbitrary remaining selected calls
are unreached, so they cannot fabricate a recursive result or exception.
Invariant: base/complex.jl:653-674. -/
def LogComplexRecursiveCycle : Prop :=
  ∀ (E Ref Other State : Type)
      (ops : LogComplexOps (FieldM E Ref Bool State) Bool Bool Other)
      (view : Bool → FieldDescriptor Ref Bool) (heap : FieldHeap Ref Bool) (state : State),
    let original : Complex Bool := ⟨false, false⟩
    let cyclic : LogComplexOps (FieldM E Ref Bool State) Bool Bool Other :=
      { ops with
        float := fun _ => pure false
        real := fun _ => pure false
        typeOf := id
        convert := fun _ number => pure (decide (number.val = 2))
        divide := fun _ _ => pure false
        sameLog := fun value => if value then some original else none }
    (logComplexFull (E := E)
      (monotoneBind := Lean.Order.instMonoBindExceptT
        (m := StateT (FieldHeap Ref Bool) (StateT State Option)) (ε := Error E))
      view cyclic original).run heap state = none


/-- Native Bool short circuits suppress every later selected guard call.
The remaining callees are arbitrary, including throwing or divergent ones;
these concrete selected-predicate instances impose no correctness laws.
Invariant: base/complex.jl:668. -/
def LogNearUnitShortCircuits : Prop :=
  ∀ (E Ref Tag V Other State : Type)
      (ops : LogComplexOps (FieldM E Ref V State) Tag V Other)
      (k beta rho t1 t2 product : V) (heap : FieldHeap Ref V) (state : State),
    let firstFalse := { ops with equalZero := fun _ _ => pure (.boolean false) }
    let secondFalse := { ops with
      equalZero := fun _ _ => pure (.boolean true)
      multiply := fun _ _ => pure product
      halfLess := fun _ _ => pure (.boolean false) }
    let comparisonTrue := { ops with
      equalZero := fun _ _ => pure (.boolean true)
      multiply := fun _ _ => pure product
      halfLess := fun _ _ => pure (.boolean true)
      lessEqual := fun _ _ => pure (.boolean true) }
    (logNearUnit (E := E) firstFalse k beta rho t1 t2).run heap state =
      some ((.ok false, heap), state) ∧
    (logNearUnit (E := E) secondFalse k beta rho t1 t2).run heap state =
      some ((.ok false, heap), state) ∧
    (logNearUnit (E := E) comparisonTrue k beta rho t1 t2).run heap state =
      some ((.ok true, heap), state)

end JuliaLean.Proofs.base.complex.Models2Group9



namespace JuliaLean.Proofs.base.complex.Models2Group9

open JuliaLean JuliaLean.Float JuliaLean.base.complex
open JuliaLean.base.complex.Models2Group9

abbrev ExpRuntime (E Ref V State : Type) := MiddleRuntime (Error E)
  (MiddleWorld (Error E) ((FieldHeap Ref V × State) × Option V))

/-- Recursive execution and selected callees share one heap; observation
receipts remain private and native reads never alter them. -/
scoped instance {E Ref V State : Type} : MonadStateOf (FieldHeap Ref V)
    (ExpRuntime E Ref V State) where
  get := fun world => some (.ok world.1.1.1, world)
  set heap := fun world =>
    some (.ok PUnit.unit, (((heap, world.1.1.2), world.1.2), world.2))
  modifyGet f := fun world =>
    let (value, heap) := f world.1.1.1
    some (.ok value, (((heap, world.1.1.2), world.1.2), world.2))

def ExpObserveIteration {E Ref V State : Type}
    (ops : IndexedIterateOps (ReopenedBase E Ref V State) V) :
    IndexedIterateOps (ExpRuntime E Ref V State) V where
  first := fun value index => MiddleToRuntime (ReopenedObserveIndex "indexedFirst" index
    (ops.first value index))
  next := fun value index state => MiddleToRuntime (ReopenedObserveIndex "indexedNext" index
    (ops.next value index state))

def ExpObservePredicate {E Ref V State : Type} (label : String)
    (action : ReopenedBase E Ref V State (PredicateValue V)) :
    ExpRuntime E Ref V State (PredicateValue V) :=
  MiddleToRuntime (LateObservedInfo label MiddlePredicateInfo action)

def ExpFloatLabel (literal : F64) : String :=
  if literal.toBits = Fl64.inf.toBits then "equalInf"
  else if literal.toBits = Fl64.ninf.toBits then "equalNInf"
  else "badFloatLiteral"

def ExpNaNLabel (literal : F64) : String :=
  if literal.toBits = F64.nan.toBits then "oftypeNaN" else "badNaNLiteral"

def ExpObserve {E Ref V State : Type}
    (ops : ExponentialOps (ReopenedBase E Ref V State) V) :
    ExponentialOps (ExpRuntime E Ref V State) V where
  reim := fun z => MiddleToRuntime (LateObserved "reim" (ops.reim z))
  iteration := ExpObserveIteration ops.iteration
  isnan := fun value => ExpObservePredicate "isnan" (ops.isnan value)
  equalZero := fun value literal => ExpObservePredicate
    (if literal.val = 0 then "equalZero" else "badZeroLiteral") (ops.equalZero value literal)
  isfinite := fun value => ExpObservePredicate "isfinite" (ops.isfinite value)
  notOther := fun value => ExpObservePredicate "not" (ops.notOther value)
  equalFloat := fun value literal => ExpObservePredicate (ExpFloatLabel literal)
    (ops.equalFloat value literal)
  negate := fun value => MiddleToRuntime (LateObserved "negate" (ops.negate value))
  oftype := fun value literal => MiddleToRuntime
    (LateObserved (ExpNaNLabel literal) (ops.oftype value literal))
  zero := fun value => MiddleToRuntime (LateObserved "zero" (ops.zero value))
  copysign := fun a b => MiddleToRuntime (LateObserved "copysign" (ops.copysign a b))
  same := ops.same
  scalarExp := fun value => MiddleToRuntime (LateObserved "scalarExp" (ops.scalarExp value))
  iszero := fun value => ExpObservePredicate "iszero" (ops.iszero value)
  sincos := fun value => MiddleToRuntime (LateObserved "sincos" (ops.sincos value))
  multiply := fun a b => MiddleToRuntime (LateObserved "multiply" (ops.multiply a b))
  construct := fun a b => MiddleToRuntime (LateReturned "construct" (ops.construct a b))

abbrev ExpToken := String × String

def ExpOrdinary (labels : List String) : List ExpToken := labels.map (fun label => (label, ""))

def ExpBool (value : Bool) : String := if value then "true" else "false"

def ExpIteration : List ExpToken := [("indexedFirst", "1"), ("indexedNext", "2")]

def ExpEntry : List ExpToken := [("reim", "")] ++ ExpIteration

/-- The original isfinite result determines whether ! uses closed Bool negation
or the selected non-Bool method.  The latter's actual Bool result gates the branch. -/
def ExpFiniteGate (nonfinite custom : Bool) : List ExpToken :=
  if custom then [("isfinite", "other"), ("not", ExpBool nonfinite)]
  else [("isfinite", ExpBool (!nonfinite))]

/-- Finite normal-return call trees are history witnesses, not an implementation
of exponential arithmetic or a second expected-result computation. -/
inductive ExpTrace where
  | nan (zero : Bool)
  | positiveInf (customNot : Bool)
  | negativeInf (customNot : Bool)
  | otherNonfinite (customNot : Bool)
  | realAxis (customNot : Bool) (recursive : Option ExpTrace)
  | trigonometric (customNot : Bool) (recursive : Option ExpTrace)

def ExpTraceTokens : ExpTrace → List ExpToken
  | .nan zero => ExpEntry ++ [("isnan", "true"), ("equalZero", ExpBool zero), ("construct", "")]
  | .positiveInf custom => ExpEntry ++ [("isnan", "false")] ++ ExpFiniteGate true custom ++
      [("equalInf", "true")] ++ ExpOrdinary ["negate", "oftypeNaN", "construct"]
  | .negativeInf custom => ExpEntry ++ [("isnan", "false")] ++ ExpFiniteGate true custom ++
      [("equalInf", "false"), ("equalNInf", "true")] ++
      ExpOrdinary ["zero", "negate", "zero", "copysign", "construct"]
  | .otherNonfinite custom => ExpEntry ++ [("isnan", "false")] ++ ExpFiniteGate true custom ++
      [("equalInf", "false"), ("equalNInf", "false")] ++
      ExpOrdinary ["oftypeNaN", "oftypeNaN", "construct"]
  | .realAxis custom child => ExpEntry ++ [("isnan", "false")] ++ ExpFiniteGate false custom ++
      (match child with | none => ExpOrdinary ["scalarExp"] | some tree => ExpTraceTokens tree) ++
      [("iszero", "true"), ("construct", "")]
  | .trigonometric custom child => ExpEntry ++ [("isnan", "false")] ++ ExpFiniteGate false custom ++
      (match child with | none => ExpOrdinary ["scalarExp"] | some tree => ExpTraceTokens tree) ++
      [("iszero", "false"), ("sincos", "")] ++ ExpIteration ++
      ExpOrdinary ["multiply", "multiply", "construct"]

def ExpReceiptTokens {E State : Type} (history : List (MiddleCall E State)) : List ExpToken :=
  history.map (fun call => (call.label, call.detail))

def ExpTokenPrefix (before : List ExpToken) (whole : List ExpToken) : Prop :=
  ∃ after, whole = before ++ after

/-- Error observations allow only a prefix consistent with all already-returned
predicate values.  A failed selected call stops at its actual call site; a local
Bool error occurs exactly on a non-Bool result at a guard that requires Bool. -/
def ExpTraceAudit {E State Result : Type} (paths : List ExpToken → Prop)
    (observation : Option (Except (Error E × MiddleWorld (Error E) State)
      (Result × MiddleWorld (Error E) State))) : Prop :=
  match observation with
  | none => True
  | some (.ok (_, (_, history))) => paths (ExpReceiptTokens history)
  | some (.error (error, (_, history))) =>
      (∃ earlier last expected detail after,
        history = earlier ++ [last] ∧ last.failure = some error ∧
        paths expected ∧ expected = ExpReceiptTokens earlier ++ [(last.label, detail)] ++ after) ∨
      ((error = .typeError "getglobal" ∨ error = .jl .boundsError ∨ error = .undefRefError) ∧
        (∃ last, history.getLast? = some last ∧
          (last.label = "indexedFirst" ∨ last.label = "indexedNext")) ∧
        ∃ expected, paths expected ∧ ExpTokenPrefix (ExpReceiptTokens history) expected) ∨
      (error = .typeError "if" ∧
        ∃ earlier last expected detail after,
          history = earlier ++ [last] ∧ last.failure = none ∧ last.detail = "other" ∧
          last.label ∈ ["isnan", "equalZero", "not", "equalInf", "equalNInf", "iszero", "finiteEr"] ∧
          paths expected ∧ expected = ExpReceiptTokens earlier ++ [(last.label, detail)] ++ after ∧
          (detail = "true" ∨ detail = "false"))

def ExpLocalError {E : Type} (error : Error E) (labels : List String) : Prop :=
  (error = .typeError "if") ∨
  ((error = .typeError "getglobal" ∨ error = .jl .boundsError ∨ error = .undefRefError) ∧
    (labels.getLast? = some "indexedFirst" ∨ labels.getLast? = some "indexedNext"))

def ExpOperationsTotal {E Ref V State : Type}
    (ops : ExponentialOps (ReopenedBase E Ref V State) V) : Prop :=
  (∀ value, ops.same value = none) ∧
  (∀ z, MiddleTotal (ops.reim z)) ∧ ReopenedIterationTotal ops.iteration ∧
  (∀ value, MiddleTotal (ops.isnan value)) ∧
  (∀ value literal, MiddleTotal (ops.equalZero value literal)) ∧
  (∀ value, MiddleTotal (ops.isfinite value)) ∧
  (∀ value, MiddleTotal (ops.notOther value)) ∧
  (∀ value literal, MiddleTotal (ops.equalFloat value literal)) ∧
  (∀ value, MiddleTotal (ops.negate value)) ∧
  (∀ value literal, MiddleTotal (ops.oftype value literal)) ∧
  (∀ value, MiddleTotal (ops.zero value)) ∧
  (∀ a b, MiddleTotal (ops.copysign a b)) ∧
  (∀ value, MiddleTotal (ops.scalarExp value)) ∧
  (∀ value, MiddleTotal (ops.iszero value)) ∧
  (∀ value, MiddleTotal (ops.sincos value)) ∧
  (∀ a b, MiddleTotal (ops.multiply a b)) ∧
  (∀ a b, MiddleTotal (ops.construct a b))

/-- Across the full runtime domain, exp's nested call language is gated by the
actual predicate values, including custom ! and own recursive calls.  It retains
native literal identities, exact selected failures and post-call heap state,
fixed Core/Bool failures, and the actual final constructor result.  The caller
cannot diverge when no own reentry is selected and every selected call terminates.
Invariant: base/complex.jl:704-725. -/
def ExpCompleteAudit : Prop :=
  ∀ (E Ref V State : Type) (view : V → FieldDescriptor Ref V)
      (ops : ExponentialOps (ReopenedBase E Ref V State) V)
      (z : Complex V) (heap : FieldHeap Ref V) (state : State),
    let observation := MiddleRunRuntime
      (exponentialComplex (E := E)
        (monotoneBind := Lean.Order.instMonoBindExceptT
          (m := StateT (MiddleWorld (Error E) ((FieldHeap Ref V × State) × Option V)) Option)
          (ε := Error E))
        view (ExpObserve ops) z) (((heap, state), none), [])
    let paths := fun tokens => ∃ tree, tokens = ExpTraceTokens tree
    MiddleAudit (fun labels => ∃ tree, labels = (ExpTraceTokens tree).map Prod.fst)
      ExpLocalError ((heap, state), none) observation ∧
    ExpTraceAudit paths observation ∧ LateFinalResult observation ∧
    ReopenedIndexArguments observation ∧
    MiddleNoNewDivergence (ExpOperationsTotal ops) observation

/-- Runtime representation for a reachable custom reim cycle: storedReal is
an admissible Real component, while nestedComplex is the exact original Complex
returned as the first destructured value by selected custom iteration. -/
inductive ExpLoopValue where
  | storedReal
  | nestedComplex
  | iterable
  | firstResult
  | secondResult
  | state

def ExpLoopInput : Complex ExpLoopValue := ⟨.storedReal, .storedReal⟩

def ExpLoopEmpty : FieldStorage ExpLoopValue :=
  ⟨JInt.lit .u32 0, #[], by decide⟩

def ExpLoopView : ExpLoopValue → FieldDescriptor Unit ExpLoopValue
  | .firstResult => .immutableValue
      ⟨JInt.lit .u32 2, #[.value .nestedComplex, .value .state], by decide⟩
  | .secondResult => .immutableValue
      ⟨JInt.lit .u32 1, #[.value .storedReal], by decide⟩
  | _ => .immutableValue ExpLoopEmpty

def ExpLoopOps : ExponentialOps (ReopenedBase Unit Unit ExpLoopValue Unit) ExpLoopValue where
  reim := fun _ => pure .iterable
  iteration := {
    first := fun _ _ => pure .firstResult
    next := fun _ _ _ => pure .secondResult }
  isnan := fun _ => pure (.boolean false)
  equalZero := fun _ _ => pure (.boolean false)
  isfinite := fun _ => pure (.boolean true)
  notOther := fun _ => pure (.boolean false)
  equalFloat := fun _ _ => pure (.boolean false)
  negate := fun value => pure value
  oftype := fun value _ => pure value
  zero := fun _ => pure .storedReal
  copysign := fun value _ => pure value
  same := fun value => match value with
    | .nestedComplex => some ExpLoopInput
    | _ => none
  scalarExp := fun value => pure value
  iszero := fun _ => pure (.boolean true)
  sincos := fun _ => pure .iterable
  multiply := fun value _ => pure value
  construct := fun _ _ => pure .nestedComplex

/-- A custom reim/iteration result can return the original Complex as zr.
This reachable same-method cycle diverges instead of exhausting fuel, returning
a fabricated default, or calling the selected-other scalar operation.
Invariant: base/complex.jl:718. -/
def ExpOwnRecursionDivergence : Prop :=
  ∀ (heap : FieldHeap Unit ExpLoopValue),
    MiddleRunRuntime
      (exponentialComplex (E := Unit)
        (monotoneBind := Lean.Order.instMonoBindExceptT
          (m := StateT (MiddleWorld (Error Unit)
            ((FieldHeap Unit ExpLoopValue × Unit) × Option ExpLoopValue)) Option)
          (ε := Error Unit))
        ExpLoopView (ExpObserve ExpLoopOps) ExpLoopInput)
      (((heap, ()), none), []) = none

def ExponentialComplete : Prop := ExpCompleteAudit ∧ ExpOwnRecursionDivergence

def Expm1Observe {E Ref V State Tag : Type}
    (ops : ExponentialMinusOneOps (ReopenedBase E Ref V State) V Tag) :
    ExponentialMinusOneOps (ExpRuntime E Ref V State) V Tag where
  floatType := fun tag => MiddleToRuntime (LateObserved "floatType" (ops.floatType tag))
  reim := fun z => MiddleToRuntime (LateObserved "reim" (ops.reim z))
  iteration := ExpObserveIteration ops.iteration
  isnan := fun value => ExpObservePredicate "isnan" (ops.isnan value)
  equalZero := fun value literal => ExpObservePredicate
    (if literal.val = 0 then "equalZero" else "badZeroLiteral") (ops.equalZero value literal)
  isfiniteImag := fun value => ExpObservePredicate "isfinite" (ops.isfiniteImag value)
  notOther := fun value => ExpObservePredicate "not" (ops.notOther value)
  equalFloat := fun value literal => ExpObservePredicate (ExpFloatLabel literal)
    (ops.equalFloat value literal)
  negate := fun value => MiddleToRuntime (LateObserved "negate" (ops.negate value))
  oftype := fun value literal => MiddleToRuntime
    (LateObserved (ExpNaNLabel literal) (ops.oftype value literal))
  one := fun value => MiddleToRuntime (LateObserved "one" (ops.one value))
  zero := fun value => MiddleToRuntime (LateObserved "zero" (ops.zero value))
  copysign := fun a b => MiddleToRuntime (LateObserved "copysign" (ops.copysign a b))
  same := ops.same
  scalarExpm1 := fun value => MiddleToRuntime (LateObserved "scalarExpm1" (ops.scalarExpm1 value))
  add := fun a b => MiddleToRuntime (LateObserved "add" (ops.add a b))
  isfiniteExp := fun value => ExpObservePredicate "finiteEr" (ops.isfiniteExp value)
  convert := fun target literal => MiddleToRuntime (LateObserved
    (if literal.toBits = Fl64.half.toBits then "convertHalf" else "badHalfLiteral")
    (ops.convert target literal))
  multiply := fun a b => MiddleToRuntime (LateObserved "multiply" (ops.multiply a b))
  sine := fun value => MiddleToRuntime (LateObserved "sin" (ops.sine value))
  literalPower := fun value literal => MiddleToRuntime
    (LateObserved "literalPower2" (ops.literalPower value literal))
  multiplyThree := fun literal a b => MiddleToRuntime (LateObserved
    (if literal.val = 2 then "multiplyThree" else "badTwoLiteral")
    (ops.multiplyThree literal a b))
  subtract := fun a b => MiddleToRuntime (LateObserved "subtract" (ops.subtract a b))
  sincos := fun value => MiddleToRuntime (LateObserved "sincos" (ops.sincos value))
  construct := fun a b => MiddleToRuntime (LateReturned "construct" (ops.construct a b))

/-- Every recursive frame has an initial type conversion and its own observed
branch decisions; the finite-er correction and sincos fallback are disjoint. -/
inductive Expm1Trace where
  | nan (zero : Bool)
  | positiveInf (customNot : Bool)
  | negativeInf (customNot : Bool)
  | otherNonfinite (customNot : Bool)
  | realAxis (customNot : Bool) (recursive : Option Expm1Trace)
  | finiteEr (customNot : Bool) (recursive : Option Expm1Trace)
  | nonfiniteEr (customNot : Bool) (recursive : Option Expm1Trace)

def Expm1Entry : List ExpToken := [("floatType", "")] ++ ExpEntry

def Expm1TraceTokens : Expm1Trace → List ExpToken
  | .nan zero => Expm1Entry ++ [("isnan", "true"), ("equalZero", ExpBool zero), ("construct", "")]
  | .positiveInf custom => Expm1Entry ++ [("isnan", "false")] ++ ExpFiniteGate true custom ++
      [("equalInf", "true")] ++ ExpOrdinary ["negate", "oftypeNaN", "construct"]
  | .negativeInf custom => Expm1Entry ++ [("isnan", "false")] ++ ExpFiniteGate true custom ++
      [("equalInf", "false"), ("equalNInf", "true")] ++
      ExpOrdinary ["one", "negate", "zero", "copysign", "construct"]
  | .otherNonfinite custom => Expm1Entry ++ [("isnan", "false")] ++ ExpFiniteGate true custom ++
      [("equalInf", "false"), ("equalNInf", "false")] ++
      ExpOrdinary ["oftypeNaN", "oftypeNaN", "construct"]
  | .realAxis custom child => Expm1Entry ++ [("isnan", "false")] ++ ExpFiniteGate false custom ++
      (match child with | none => ExpOrdinary ["scalarExpm1"] | some tree => Expm1TraceTokens tree) ++
      [("equalZero", "true"), ("construct", "")]
  | .finiteEr custom child => Expm1Entry ++ [("isnan", "false")] ++ ExpFiniteGate false custom ++
      (match child with | none => ExpOrdinary ["scalarExpm1"] | some tree => Expm1TraceTokens tree) ++
      [("equalZero", "false")] ++ ExpOrdinary ["one", "add"] ++ [("finiteEr", "true")] ++
      ExpOrdinary ["convertHalf", "multiply", "sin", "literalPower2", "multiplyThree",
        "subtract", "sin", "multiply", "construct"]
  | .nonfiniteEr custom child => Expm1Entry ++ [("isnan", "false")] ++ ExpFiniteGate false custom ++
      (match child with | none => ExpOrdinary ["scalarExpm1"] | some tree => Expm1TraceTokens tree) ++
      [("equalZero", "false")] ++ ExpOrdinary ["one", "add"] ++ [("finiteEr", "false"),
        ("sincos", "")] ++ ExpIteration ++ ExpOrdinary ["multiply", "multiply", "construct"]

def Expm1OperationsTotal {E Ref V State Tag : Type}
    (ops : ExponentialMinusOneOps (ReopenedBase E Ref V State) V Tag) : Prop :=
  (∀ value, ops.same value = none) ∧
  (∀ tag, MiddleTotal (ops.floatType tag)) ∧
  (∀ z, MiddleTotal (ops.reim z)) ∧ ReopenedIterationTotal ops.iteration ∧
  (∀ value, MiddleTotal (ops.isnan value)) ∧
  (∀ value literal, MiddleTotal (ops.equalZero value literal)) ∧
  (∀ value, MiddleTotal (ops.isfiniteImag value)) ∧
  (∀ value, MiddleTotal (ops.notOther value)) ∧
  (∀ value literal, MiddleTotal (ops.equalFloat value literal)) ∧
  (∀ value, MiddleTotal (ops.negate value)) ∧
  (∀ value literal, MiddleTotal (ops.oftype value literal)) ∧
  (∀ value, MiddleTotal (ops.one value)) ∧
  (∀ value, MiddleTotal (ops.zero value)) ∧
  (∀ a b, MiddleTotal (ops.copysign a b)) ∧
  (∀ value, MiddleTotal (ops.scalarExpm1 value)) ∧
  (∀ a b, MiddleTotal (ops.add a b)) ∧
  (∀ value, MiddleTotal (ops.isfiniteExp value)) ∧
  (∀ target literal, MiddleTotal (ops.convert target literal)) ∧
  (∀ a b, MiddleTotal (ops.multiply a b)) ∧
  (∀ value, MiddleTotal (ops.sine value)) ∧
  (∀ value literal, MiddleTotal (ops.literalPower value literal)) ∧
  (∀ literal a b, MiddleTotal (ops.multiplyThree literal a b)) ∧
  (∀ a b, MiddleTotal (ops.subtract a b)) ∧
  (∀ value, MiddleTotal (ops.sincos value)) ∧
  (∀ a b, MiddleTotal (ops.construct a b))

/-- Expm1's full-domain observation checks float(T) before each reim, actual
recursive branch gates, custom !, both Boolean assertions and native Core errors.
The finite-er branch finishes half conversion, sine and literal_pow before the
single three-argument multiplication.  Exact native constants, all selected
failure/heap states, actual constructor returns and finite-call termination are
retained without any callee correctness assumptions.
Invariant: base/complex.jl:727-755. -/
def Expm1CompleteAudit : Prop :=
  ∀ (E Ref V State Tag : Type) (view : V → FieldDescriptor Ref V)
      (ops : ExponentialMinusOneOps (ReopenedBase E Ref V State) V Tag)
      (tag : Tag) (z : Complex V) (heap : FieldHeap Ref V) (state : State),
    let observation := MiddleRunRuntime
      (exponentialMinusOneComplex (E := E)
        (monotoneBind := Lean.Order.instMonoBindExceptT
          (m := StateT (MiddleWorld (Error E) ((FieldHeap Ref V × State) × Option V)) Option)
          (ε := Error E))
        view (Expm1Observe ops) tag z) (((heap, state), none), [])
    let paths := fun tokens => ∃ tree, tokens = Expm1TraceTokens tree
    MiddleAudit (fun labels => ∃ tree, labels = (Expm1TraceTokens tree).map Prod.fst)
      ExpLocalError ((heap, state), none) observation ∧
    ExpTraceAudit paths observation ∧ LateFinalResult observation ∧
    ReopenedIndexArguments observation ∧
    MiddleNoNewDivergence (Expm1OperationsTotal ops) observation

def Expm1LoopOps : ExponentialMinusOneOps
    (ReopenedBase Unit Unit ExpLoopValue Unit) ExpLoopValue Unit where
  floatType := fun _ => pure .storedReal
  reim := fun _ => pure .iterable
  iteration := {
    first := fun _ _ => pure .firstResult
    next := fun _ _ _ => pure .secondResult }
  isnan := fun _ => pure (.boolean false)
  equalZero := fun _ _ => pure (.boolean false)
  isfiniteImag := fun _ => pure (.boolean true)
  notOther := fun _ => pure (.boolean false)
  equalFloat := fun _ _ => pure (.boolean false)
  negate := fun value => pure value
  oftype := fun value _ => pure value
  one := fun _ => pure .storedReal
  zero := fun _ => pure .storedReal
  copysign := fun value _ => pure value
  same := fun value => match value with
    | .nestedComplex => some ((), ExpLoopInput)
    | _ => none
  scalarExpm1 := fun value => pure value
  add := fun value _ => pure value
  isfiniteExp := fun _ => pure (.boolean true)
  convert := fun value _ => pure value
  multiply := fun value _ => pure value
  sine := fun value => pure value
  literalPower := fun value _ => pure value
  multiplyThree := fun _ value _ => pure value
  subtract := fun value _ => pure value
  sincos := fun _ => pure .iterable
  construct := fun _ _ => pure .nestedComplex

/-- Own reentry through a custom reim result repeatedly executes the same typed
expm1 body, retaining its type tag and initial float(T) call.  The unending cycle
has the partial-computation divergence result, with no finite fuel convention.
Invariant: base/complex.jl:728,742. -/
def Expm1OwnRecursionDivergence : Prop :=
  ∀ (heap : FieldHeap Unit ExpLoopValue),
    MiddleRunRuntime
      (exponentialMinusOneComplex (E := Unit)
        (monotoneBind := Lean.Order.instMonoBindExceptT
          (m := StateT (MiddleWorld (Error Unit)
            ((FieldHeap Unit ExpLoopValue × Unit) × Option ExpLoopValue)) Option)
          (ε := Error Unit))
        ExpLoopView (Expm1Observe Expm1LoopOps) () ExpLoopInput)
      (((heap, ()), none), []) = none

def ExponentialMinusOneComplete : Prop := Expm1CompleteAudit ∧ Expm1OwnRecursionDivergence

end JuliaLean.Proofs.base.complex.Models2Group9


namespace JuliaLean.Proofs.base.complex.Models2Group9

open JuliaLean JuliaLean.base.complex JuliaLean.Float
open JuliaLean.base.complex.Models2Group9

abbrev Log1pReopenedState (Ref V State : Type) := FieldHeap Ref V × State
abbrev Log1pReopenedM (E Ref V State A : Type) :=
  ExceptT (Error E) (StateT (Log1pReopenedState Ref V State) Option) A

scoped instance Log1pReopenedHeapState {E Ref V State : Type} :
    MonadStateOf (FieldHeap Ref V) (Log1pReopenedM E Ref V State) where
  get := fun state => some (.ok state.1, state)
  set heap := fun state => some (.ok (), (heap, state.2))
  modifyGet f := fun state =>
    let (value, heap) := f state.1
    some (.ok value, (heap, state.2))

inductive Log1pReopenedArgument (A Tag V : Type) where
  | input (z : Complex A)
  | value (value : V)
  | typeTag (tag : Tag)
  | nativeInt (value : JInt .i64)
  | float64 (value : F64)

inductive Log1pReopenedObservedResult (V Other : Type) where
  | value (value : V)
  | predicate (value : PredicateValue Other)

structure Log1pReopenedReceipt (E Ref A Tag V Other State : Type) where
  label : String
  arguments : List (Log1pReopenedArgument A Tag V)
  outcome : Except (Error E) (Log1pReopenedObservedResult V Other)
  before : Log1pReopenedState Ref V State
  after : Log1pReopenedState Ref V State

abbrev Log1pReopenedHistory (E Ref A Tag V Other State : Type) :=
  List (Log1pReopenedReceipt E Ref A Tag V Other State)

/-- Records actual arguments, outcomes and the shared heap/user states.  The
selected callee can mutate those states but cannot modify the isolated log. -/
def Log1pReopenedObserve {E Ref A Tag V Other State X : Type}
    (label : String) (arguments : List (Log1pReopenedArgument A Tag V))
    (encode : X → Log1pReopenedObservedResult V Other)
    (action : Log1pReopenedM E Ref V State X) :
    Log1pReopenedM E Ref V (State × Log1pReopenedHistory E Ref A Tag V Other State) X :=
  fun (heap, (state, history)) =>
    match action (heap, state) with
    | none => none
    | some (outcome, (heapAfter, stateAfter)) =>
        let receipt : Log1pReopenedReceipt E Ref A Tag V Other State :=
          { label, arguments, outcome := outcome.map encode,
            before := (heap, state), after := (heapAfter, stateAfter) }
        some (outcome, (heapAfter, (stateAfter, history ++ [receipt])))

/-- Unrestricted selected operations, with actual type-tagged runtime values.
The fixed pi argument of convertPi is inherent in that specialized target. -/
def Log1pReopenedObservedOps {E Ref A Tag Other State : Type} {Value : Tag → Type}
    (ops : Log1pReopenedOps (Log1pReopenedM E Ref (Log1pValue Value) State) A Tag Other Value) :
    Log1pReopenedOps
      (Log1pReopenedM E Ref (Log1pValue Value)
        (State × Log1pReopenedHistory E Ref A Tag (Log1pValue Value) Other State))
      A Tag Other Value where
  reim := fun z => Log1pReopenedObserve "reim" [.input z]
    Log1pReopenedObservedResult.value (ops.reim z)
  isfinite := fun value => Log1pReopenedObserve "isfinite" [.value value]
    Log1pReopenedObservedResult.predicate (ops.isfinite value)
  isinf := fun value => Log1pReopenedObserve "isinf" [.value value]
    Log1pReopenedObservedResult.predicate (ops.isinf value)
  isnan := fun value => Log1pReopenedObserve "isnan" [.value value]
    Log1pReopenedObservedResult.predicate (ops.isnan value)
  logOriginal := fun z => Log1pReopenedObserve "logOriginal" [.input z]
    Log1pReopenedObservedResult.value (ops.logOriginal z)
  floatType := fun tag => Log1pReopenedObserve "floatType" [.typeTag tag]
    Log1pReopenedObservedResult.value (ops.floatType tag)
  one := fun value => Log1pReopenedObserve "one" [.value value]
    Log1pReopenedObservedResult.value (ops.one value)
  addOriginal := fun value z => Log1pReopenedObserve "addOriginal" [.value value, .input z]
    Log1pReopenedObservedResult.value (ops.addOriginal value z)
  equalInt := fun value literal => Log1pReopenedObserve "equalInt" [.value value, .nativeInt literal]
    Log1pReopenedObservedResult.predicate (ops.equalInt value literal)
  convertOriginal := fun tag z => Log1pReopenedObserve "convertOriginal" [.typeTag tag, .input z]
    Log1pReopenedObservedResult.value (ops.convertOriginal tag z)
  real := fun value => Log1pReopenedObserve "real" [.value value]
    Log1pReopenedObservedResult.value (ops.real value)
  lessEqualInt := fun value literal => Log1pReopenedObserve "lessEqualInt" [.value value, .nativeInt literal]
    Log1pReopenedObservedResult.predicate (ops.lessEqualInt value literal)
  log := fun value => Log1pReopenedObserve "log" [.value value]
    Log1pReopenedObservedResult.value (ops.log value)
  subtractInt := fun value literal => Log1pReopenedObserve "subtractInt" [.value value, .nativeInt literal]
    Log1pReopenedObservedResult.value (ops.subtractInt value literal)
  divideOriginal := fun z value => Log1pReopenedObserve "divideOriginal" [.input z, .value value]
    Log1pReopenedObservedResult.value (ops.divideOriginal z value)
  multiply := fun x y => Log1pReopenedObserve "multiply" [.value x, .value y]
    Log1pReopenedObservedResult.value (ops.multiply x y)
  construct := fun x y => Log1pReopenedObserve "construct" [.value x, .value y]
    Log1pReopenedObservedResult.value (ops.construct x y)
  fromFloat := fun tag literal => Log1pReopenedObserve "fromFloat" [.typeTag tag, .float64 literal]
    Log1pReopenedObservedResult.value (ops.fromFloat tag literal)
  greaterInt := fun value literal => Log1pReopenedObserve "greaterInt" [.value value, .nativeInt literal]
    Log1pReopenedObservedResult.predicate (ops.greaterInt value literal)
  zeroType := fun tag => Log1pReopenedObserve "zeroType" [.typeTag tag]
    Log1pReopenedObservedResult.value (ops.zeroType tag)
  convertPi := fun tag => Log1pReopenedObserve "convertPi" [.typeTag tag]
    Log1pReopenedObservedResult.value (ops.convertPi tag)
  copysign := fun x y => Log1pReopenedObserve "copysign" [.value x, .value y]
    Log1pReopenedObservedResult.value (ops.copysign x y)
  iterations := {
    first := fun value index => Log1pReopenedObserve "indexedFirst" [.value value, .nativeInt index]
      Log1pReopenedObservedResult.value (ops.iterations.first value index)
    next := fun value index state => Log1pReopenedObserve "indexedNext"
      [.value value, .nativeInt index, .value state]
      Log1pReopenedObservedResult.value (ops.iterations.next value index state) }

def Log1pReopenedFailure {E Ref A Tag V Other State : Type}
    (receipt : Log1pReopenedReceipt E Ref A Tag V Other State) : Option (Error E) :=
  match receipt.outcome with | .error error => some error | .ok _ => none

def Log1pReopenedStateChain {E Ref A Tag V Other State : Type}
    (initial final : Log1pReopenedState Ref V State) :
    Log1pReopenedHistory E Ref A Tag V Other State → Prop
  | [] => final = initial
  | receipt :: rest => receipt.before = initial ∧ Log1pReopenedStateChain receipt.after final rest

def Log1pReopenedValueAt {E Ref A Tag V Other State : Type}
    (history : Log1pReopenedHistory E Ref A Tag V Other State) (index : Nat) : Option V :=
  match history[index]? with
  | some receipt => match receipt.outcome with | .ok (.value value) => some value | _ => none
  | none => none

def Log1pReopenedPredicateAt {E Ref A Tag V Other State : Type}
    (history : Log1pReopenedHistory E Ref A Tag V Other State) (index : Nat) : Option (PredicateValue Other) :=
  match history[index]? with
  | some receipt => match receipt.outcome with | .ok (.predicate value) => some value | _ => none
  | none => none

def Log1pReopenedCallAt {E Ref A Tag V Other State : Type}
    (history : Log1pReopenedHistory E Ref A Tag V Other State) (index : Nat)
    (label : String) (arguments : List (Log1pReopenedArgument A Tag V)) : Prop :=
  ∃ receipt, history[index]? = some receipt ∧ receipt.label = label ∧ receipt.arguments = arguments

/-- A completed call sequence is a prefix of a finite permitted receipt word.
This specification inspects calls; it never reruns or assumes laws for callees. -/
def Log1pReopenedWord {E Ref A Tag V Other State : Type}
    (outcome : Except (Error E) V)
    (history : Log1pReopenedHistory E Ref A Tag V Other State)
    (expected : List (String × List (Log1pReopenedArgument A Tag V))) : Prop :=
  history.length ≤ expected.length ∧
    history.map (fun receipt => (receipt.label, receipt.arguments)) = expected.take history.length ∧
    (∀ value, outcome = .ok value → history.length = expected.length)

/-- Selected reim precedes both indexed-iteration calls on its actual result.
Concrete getfield behavior is covered by the helper's registered invariant. -/
def Log1pReopenedOpening {E Ref A Tag V Other State : Type}
    (z : Complex A) (history : Log1pReopenedHistory E Ref A Tag V Other State) : Prop :=
  match Log1pReopenedValueAt history 0 with
  | none => history.map (fun receipt => (receipt.label, receipt.arguments)) = [("reim", [.input z])]
  | some components =>
      ∃ state : V,
        let expected : List (String × List (Log1pReopenedArgument A Tag V)) :=
          [("reim", [.input z]), ("indexedFirst", [.value components, .nativeInt (JInt.lit .i64 1)]),
           ("indexedNext", [.value components, .nativeInt (JInt.lit .i64 2), .value state])]
        (history.map (fun receipt => (receipt.label, receipt.arguments))).take 3 =
          expected.take history.length ∧ history ≠ []

/-- Finite-input receipt language: float(T) is delayed until after component
checks, typeof(u) is its actual tag, and the correction calls log, subtraction,
selected complex division and multiplication in that order.  Every operand
comes from the recorded actual earlier result, not an assumed numerical value. -/
def Log1pReopenedFiniteWord {E Ref A Tag V Other State : Type}
    (typeOf : V → Tag) (t : Tag) (z : Complex A)
    (outcome : Except (Error E) V)
    (history : Log1pReopenedHistory E Ref A Tag V Other State) : Prop :=
  ∃ floated one u real logarithm denominator ratio : V,
    (∀ value, Log1pReopenedValueAt history 0 = some value → floated = value) ∧
    (∀ value, Log1pReopenedValueAt history 1 = some value → one = value) ∧
    (∀ value, Log1pReopenedValueAt history 2 = some value → u = value) ∧
    (∀ value, Log1pReopenedValueAt history 4 = some value → real = value) ∧
    (∀ value, Log1pReopenedValueAt history 6 = some value → logarithm = value) ∧
    (∀ value, Log1pReopenedValueAt history 7 = some value → denominator = value) ∧
    (∀ value, Log1pReopenedValueAt history 8 = some value → ratio = value) ∧
    let initialWord : List (String × List (Log1pReopenedArgument A Tag V)) :=
      [("floatType", [.typeTag t]), ("one", [.value floated]),
       ("addOriginal", [.value one, .input z]),
       ("equalInt", [.value u, .nativeInt (JInt.lit .i64 1)])]
    let suffix : List (String × List (Log1pReopenedArgument A Tag V)) :=
      match Log1pReopenedPredicateAt history 3 with
      | some (.boolean true) => [("convertOriginal", [.typeTag (typeOf u), .input z])]
      | _ =>
          [("real", [.value u]), ("lessEqualInt", [.value real, .nativeInt (JInt.lit .i64 0)]),
           ("log", [.value u])] ++
          match Log1pReopenedPredicateAt history 5 with
          | some (.boolean true) => []
          | _ => [("subtractInt", [.value u, .nativeInt (JInt.lit .i64 1)]),
                  ("divideOriginal", [.input z, .value denominator]),
                  ("multiply", [.value logarithm, .value ratio])]
    Log1pReopenedWord outcome history (initialWord ++ suffix)

/-- Nonfinite-input receipt language, preserving T(Inf) before the inner
comparison, exact zero versus Irrational-pi conversion selection, and both
original T constructor calls in the nonfinite-imaginary case. -/
def Log1pReopenedNonfiniteWord {E Ref A Tag V Other State : Type}
    (t : Tag) (zr zi : V) (finiteImaginary : Bool)
    (outcome : Except (Error E) V)
    (history : Log1pReopenedHistory E Ref A Tag V Other State) : Prop :=
  ∃ real magnitude imag : V,
    (∀ value, Log1pReopenedValueAt history 0 = some value → real = value) ∧
    (∀ value, Log1pReopenedValueAt history 2 = some value → magnitude = value) ∧
    (∀ value, Log1pReopenedValueAt history (if finiteImaginary then 3 else 1) = some value → imag = value) ∧
    if finiteImaginary then
      let magnitudeCall := match Log1pReopenedPredicateAt history 1 with
        | some (.boolean true) => "zeroType"
        | _ => "convertPi"
      Log1pReopenedWord outcome history
        [("fromFloat", [.typeTag t, .float64 (F64.inf false)]),
         ("greaterInt", [.value zr, .nativeInt (JInt.lit .i64 0)]),
         (magnitudeCall, [.typeTag t]), ("copysign", [.value magnitude, .value zi]),
         ("construct", [.value real, .value imag])]
    else
      Log1pReopenedWord outcome history
        [("fromFloat", [.typeTag t, .float64 (F64.inf false)]),
         ("fromFloat", [.typeTag t, .float64 F64.nan]),
         ("construct", [.value real, .value imag])]

/-- Outer branch gates operate on the original extracted components.  In
particular no float(T), one, addition or logarithm may precede those tests. -/
def Log1pReopenedGates {E Ref A Tag V Other State : Type}
    (typeOf : V → Tag) (t : Tag) (z : Complex A)
    (outcome : Except (Error E) V)
    (history : Log1pReopenedHistory E Ref A Tag V Other State) : Prop :=
  ∀ (first : Log1pReopenedReceipt E Ref A Tag V Other State), history[3]? = some first →
    ∃ zr zi : V,
      first.label = "isfinite" ∧ first.arguments = [.value zr] ∧
      match first.outcome with
      | .error _ | .ok (.predicate (.other _)) => True
      | .ok (.value _) => False
      | .ok (.predicate (.boolean true)) =>
          ∃ second, history[4]? = some second ∧ second.label = "isinf" ∧ second.arguments = [.value zi] ∧
            match second.outcome with
            | .error _ | .ok (.predicate (.other _)) => True
            | .ok (.value _) => False
            | .ok (.predicate (.boolean true)) =>
                Log1pReopenedWord outcome (history.drop 5) [("logOriginal", [.input z])]
            | .ok (.predicate (.boolean false)) =>
                Log1pReopenedFiniteWord typeOf t z outcome (history.drop 5)
      | .ok (.predicate (.boolean false)) =>
          ∃ second, history[4]? = some second ∧ second.label = "isnan" ∧ second.arguments = [.value zr] ∧
            match second.outcome with
            | .error _ | .ok (.predicate (.other _)) => True
            | .ok (.value _) => False
            | .ok (.predicate (.boolean true)) =>
                Log1pReopenedWord outcome (history.drop 5) [("construct", [.value zr, .value zr])]
            | .ok (.predicate (.boolean false)) =>
                ∃ third, history[5]? = some third ∧ third.label = "isfinite" ∧ third.arguments = [.value zi] ∧
                  match third.outcome with
                  | .error _ | .ok (.predicate (.other _)) => True
                  | .ok (.value _) => False
                  | .ok (.predicate (.boolean finiteImaginary)) =>
                      Log1pReopenedNonfiniteWord t zr zi finiteImaginary outcome (history.drop 6)

def Log1pReopenedPredicateFailure {E Ref A Tag V Other State : Type}
    (receipt : Log1pReopenedReceipt E Ref A Tag V Other State) : Prop :=
  receipt.label ∈ ["isfinite", "isinf", "isnan", "equalInt", "lessEqualInt", "greaterInt"] ∧
    ∃ value, receipt.outcome = .ok (.predicate (.other value))

def Log1pReopenedLocalFailure {E Ref A Tag V Other State : Type}
    (last : Log1pReopenedReceipt E Ref A Tag V Other State) (error : Error E) : Prop :=
  ((last.label = "indexedFirst" ∨ last.label = "indexedNext") ∧
    (∃ value, last.outcome = .ok (.value value)) ∧
    (error = .typeError "getglobal" ∨ error = .jl .boundsError ∨ error = .undefRefError)) ∨
  (Log1pReopenedPredicateFailure last ∧ error = .typeError "log1p Boolean condition")

/-- Observations conserve both mutable heap and auxiliary state, stop at the
first selected exception or fixed local error, and return only the final
actual selected result.  Non-Bool conditions fail immediately after their
predicate, before any call belonging to a later branch. -/
def Log1pReopenedAudit {E Ref A Tag V Other State : Type}
    (typeOf : V → Tag) (t : Tag) (z : Complex A)
    (initial : Log1pReopenedState Ref V State)
    (observed : Option (Except (Error E) V ×
      Log1pReopenedState Ref V (State × Log1pReopenedHistory E Ref A Tag V Other State))) : Prop :=
  match observed with
  | none => True
  | some (outcome, (heap, (state, history))) =>
      Log1pReopenedOpening z history ∧
      Log1pReopenedStateChain initial (heap, state) history ∧
      Log1pReopenedGates typeOf t z outcome history ∧
      (∀ index receipt, history[index]? = some receipt → Log1pReopenedPredicateFailure receipt →
        history.length = index + 1 ∧ outcome = .error (.typeError "log1p Boolean condition")) ∧
      match outcome with
      | .ok value =>
          (∀ receipt ∈ history, Log1pReopenedFailure receipt = none) ∧
          ∃ last, history.getLast? = some last ∧ last.outcome = .ok (.value value) ∧
            last.label ∈ ["logOriginal", "convertOriginal", "log", "construct", "multiply"]
      | .error error =>
          ∃ earlier last, history = earlier ++ [last] ∧
            (∀ receipt ∈ earlier, Log1pReopenedFailure receipt = none) ∧ (heap, state) = last.after ∧
            (Log1pReopenedFailure last = some error ∨
              (Log1pReopenedFailure last = none ∧ Log1pReopenedLocalFailure last error))

def Log1pReopenedCallTotal {E Ref V State X : Type}
    (action : Log1pReopenedM E Ref V State X) : Prop :=
  ∀ state, action state ≠ none

/-- Totality permits arbitrary returned values, throws and state changes; it
supplies no callee correctness law. -/
def Log1pReopenedCallsTotal {E Ref A Tag Other State : Type} {Value : Tag → Type}
    (ops : Log1pReopenedOps (Log1pReopenedM E Ref (Log1pValue Value) State) A Tag Other Value) : Prop :=
  (∀ z, Log1pReopenedCallTotal (ops.reim z)) ∧
  (∀ value, Log1pReopenedCallTotal (ops.isfinite value)) ∧
  (∀ value, Log1pReopenedCallTotal (ops.isinf value)) ∧
  (∀ value, Log1pReopenedCallTotal (ops.isnan value)) ∧
  (∀ z, Log1pReopenedCallTotal (ops.logOriginal z)) ∧
  (∀ tag, Log1pReopenedCallTotal (ops.floatType tag)) ∧
  (∀ value, Log1pReopenedCallTotal (ops.one value)) ∧
  (∀ value z, Log1pReopenedCallTotal (ops.addOriginal value z)) ∧
  (∀ value literal, Log1pReopenedCallTotal (ops.equalInt value literal)) ∧
  (∀ tag z, Log1pReopenedCallTotal (ops.convertOriginal tag z)) ∧
  (∀ value, Log1pReopenedCallTotal (ops.real value)) ∧
  (∀ value literal, Log1pReopenedCallTotal (ops.lessEqualInt value literal)) ∧
  (∀ value, Log1pReopenedCallTotal (ops.log value)) ∧
  (∀ value literal, Log1pReopenedCallTotal (ops.subtractInt value literal)) ∧
  (∀ z value, Log1pReopenedCallTotal (ops.divideOriginal z value)) ∧
  (∀ x y, Log1pReopenedCallTotal (ops.multiply x y)) ∧
  (∀ x y, Log1pReopenedCallTotal (ops.construct x y)) ∧
  (∀ tag literal, Log1pReopenedCallTotal (ops.fromFloat tag literal)) ∧
  (∀ value literal, Log1pReopenedCallTotal (ops.greaterInt value literal)) ∧
  (∀ tag, Log1pReopenedCallTotal (ops.zeroType tag)) ∧
  (∀ tag, Log1pReopenedCallTotal (ops.convertPi tag)) ∧
  (∀ x y, Log1pReopenedCallTotal (ops.copysign x y)) ∧
  (∀ value index, Log1pReopenedCallTotal (ops.iterations.first value index)) ∧
  (∀ value index state, Log1pReopenedCallTotal (ops.iterations.next value index state))

/-- Independent full-domain log1p call-order and state invariant.  It checks
original-component branch gates, actual runtime typeof used for conversion,
exact correction division dispatch and evaluation order, nonfinite branches,
first failures and return provenance.  With total selected targets, this
finite source body introduces no divergence.  All callee results and errors
remain arbitrary; no logarithm or arithmetic law is assumed.
Julia source: base/complex.jl:757-773; base/tuple.jl:161-172. -/
def Log1pReopenedEvaluationAudit : Prop :=
  ∀ (E Ref A Tag Other State : Type) (Value : Tag → Type)
      (view : Log1pValue Value → FieldDescriptor Ref (Log1pValue Value))
      (ops : Log1pReopenedOps (Log1pReopenedM E Ref (Log1pValue Value) State) A Tag Other Value)
      (t : Tag) (z : Complex A) (heap : FieldHeap Ref (Log1pValue Value)) (state : State),
    let observed := (log1pComplexReopened (E := E) view (Log1pReopenedObservedOps ops) t z)
      (heap, (state, []))
    Log1pReopenedAudit (fun value => value.1) t z (heap, state) observed ∧
      (Log1pReopenedCallsTotal ops → observed ≠ none)

end JuliaLean.Proofs.base.complex.Models2Group9


namespace JuliaLean.Proofs.base.complex.Models2Group9

open JuliaLean JuliaLean.base.complex JuliaLean.base.complex.Models2Group9

inductive CPowArgument (Tag V Other : Type) where
  | value (value : V)
  | typeTag (tag : Tag)
  | integer (value : JInt .i64)
  | int32 (value : JInt .i32)
  | float64 (value : JuliaLean.Float.F64)
  | predicate (value : PredicateValue Other)
  | complexType (value : ComplexTy Tag)

inductive CPowObservedResult (V Other : Type) where
  | value (value : V)
  | predicate (value : PredicateValue Other)

structure CPowReceipt (E Ref Tag V Other State : Type) where
  label : String
  arguments : List (CPowArgument Tag V Other)
  outcome : Except (Error E) (CPowObservedResult V Other)
  beforeHeap : FieldHeap Ref V
  afterHeap : FieldHeap Ref V
  beforeState : State
  afterState : State

/-- Each selected action runs once on the same heap and user state. -/
def CPowObserve {E Ref Tag V Other State A : Type} (label : String)
    (arguments : List (CPowArgument Tag V Other)) (pack : A → CPowObservedResult V Other)
    (action : FieldM E Ref V State A) :
    FieldM E Ref V (State × List (CPowReceipt E Ref Tag V Other State)) A :=
  fun heap (state, history) =>
    match action.run heap state with
    | none => none
    | some ((outcome, finalHeap), finalState) =>
        let receipt : CPowReceipt E Ref Tag V Other State :=
          { label, arguments, outcome := outcome.map pack
            beforeHeap := heap, afterHeap := finalHeap
            beforeState := state, afterState := finalState }
        some ((outcome, finalHeap), (finalState, history ++ [receipt]))

def CPowObservedOps {E Ref Tag V Other Rejected State : Type}
    (ops : CPowFullOps (FieldM E Ref V State) Tag V Other Rejected) :
    CPowFullOps (FieldM E Ref V (State × List (CPowReceipt E Ref Tag V Other State))) Tag V Other Rejected where
  floatValue := fun value => CPowObserve "floatValue" [.value value] .value (ops.floatValue value)
  floatType := fun tag => CPowObserve "floatType" [.typeTag tag] .value (ops.floatType tag)
  isreal := fun value => CPowObserve "isreal" [.value value] .predicate (ops.isreal value)
  real := fun value => CPowObserve "real" [.value value] .value (ops.real value)
  imag := fun value => CPowObserve "imag" [.value value] .value (ops.imag value)
  isinteger := fun value => CPowObserve "isinteger" [.value value] .predicate (ops.isinteger value)
  abs := fun value => CPowObserve "abs" [.value value] .value (ops.abs value)
  lessInt32 := fun value number => CPowObserve "lessInt32" [.value value, .int32 number] .predicate (ops.lessInt32 value number)
  iszero := fun value => CPowObserve "iszero" [.value value] .predicate (ops.iszero value)
  zero := fun value => CPowObserve "zero" [.value value] .value (ops.zero value)
  one := fun value => CPowObserve "one" [.value value] .value (ops.one value)
  copysign := fun a b => CPowObserve "copysign" [.value a, .value b] .value (ops.copysign a b)
  flipsign := fun a b => CPowObserve "flipsign" [.value a, .value b] .value (ops.flipsign a b)
  construct := fun a b => CPowObserve "construct" [.value a, .value b] .value (ops.construct a b)
  convertInt := fun value => CPowObserve "convertInt" [.value value] .value (ops.convertInt value)
  lessInt := fun value number => CPowObserve "lessInt" [.value value, .integer number] .predicate (ops.lessInt value number)
  greaterInt := fun value number => CPowObserve "greaterInt" [.value value, .integer number] .predicate (ops.greaterInt value number)
  fromFloat := fun value number => CPowObserve "fromFloat" [.value value, .float64 number] .value (ops.fromFloat value number)
  inverse := fun value => CPowObserve "inverse" [.value value] .value (ops.inverse value)
  negate := fun value => CPowObserve "negate" [.value value] .value (ops.negate value)
  powerBySquaring := fun a b => CPowObserve "powerBySquaring" [.value a, .value b] .value (ops.powerBySquaring a b)
  iseven := fun value => CPowObserve "iseven" [.value value] .predicate (ops.iseven value)
  signbit := fun value => CPowObserve "signbit" [.value value] .predicate (ops.signbit value)
  andOther := fun a b => CPowObserve "andOther" [.predicate a, .predicate b] .predicate (ops.andOther a b)
  ifelse := fun condition a b => CPowObserve "ifelse" [.predicate condition, .value a, .value b] .value (ops.ifelse condition a b)
  publicComplexOne := fun value => CPowObserve "publicComplexOne" [.value value] .value (ops.publicComplexOne value)
  publicComplexTwo := fun a b => CPowObserve "publicComplexTwo" [.value a, .value b] .value (ops.publicComplexTwo a b)
  power := fun a b => CPowObserve "power" [.value a, .value b] .value (ops.power a b)
  cospi := fun value => CPowObserve "cospi" [.value value] .value (ops.cospi value)
  sinpi := fun value => CPowObserve "sinpi" [.value value] .value (ops.sinpi value)
  isfinite := fun value => CPowObserve "isfinite" [.value value] .predicate (ops.isfinite value)
  zeroComplexType := fun target => CPowObserve "zeroComplexType" [.complexType target] .value (ops.zeroComplexType target)
  angle := fun value => CPowObserve "angle" [.value value] .value (ops.angle value)
  reim := fun value => CPowObserve "reim" [.value value] .value (ops.reim value)
  callPi := fun value => CPowObserve "callPi" [.value value] .value (ops.callPi value)
  log := fun value => CPowObserve "log" [.value value] .value (ops.log value)
  floatmax := fun value => CPowObserve "floatmax" [.value value] .value (ops.floatmax value)
  subtract := fun a b => CPowObserve "subtract" [.value a, .value b] .value (ops.subtract a b)
  less := fun a b => CPowObserve "less" [.value a, .value b] .predicate (ops.less a b)
  multiply := fun a b => CPowObserve "multiply" [.value a, .value b] .value (ops.multiply a b)
  exp := fun value => CPowObserve "exp" [.value value] .value (ops.exp value)
  add := fun a b => CPowObserve "add" [.value a, .value b] .value (ops.add a b)
  cis := fun value => CPowObserve "cis" [.value value] .value (ops.cis value)
  isaReal := ops.isaReal
  complexParameter := ops.complexParameter
  iterations :=
    { first := fun value index => CPowObserve "indexed_first" [.value value, .integer index] .value
        (ops.iterations.first value index)
      next := fun value index state => CPowObserve "indexed_next" [.value value, .integer index, .value state] .value
        (ops.iterations.next value index state) }

def CPowValueAt {E Ref Tag V Other State : Type}
    (history : List (CPowReceipt E Ref Tag V Other State)) (index : Nat) : Option V := do
  let receipt ← history[index]?
  match receipt.outcome with | .ok (.value value) => some value | _ => none

def CPowCallAt {E Ref Tag V Other State : Type}
    (history : List (CPowReceipt E Ref Tag V Other State)) (index : Nat)
    (label : String) (arguments : List (CPowArgument Tag V Other)) : Prop :=
  ∃ receipt, history[index]? = some receipt ∧ receipt.label = label ∧ receipt.arguments = arguments

/-- The original operands are floated separately before the original T is
floated, and the first predicate consumes the actual second float result. -/
def CPowOpening {E Ref Tag V Other State : Type} (t : Tag) (z p : V)
    (history : List (CPowReceipt E Ref Tag V Other State)) : Prop :=
  (history.map (fun receipt => receipt.label)).take 4 =
    ["floatValue", "floatValue", "floatType", "isreal"].take (min 4 history.length) ∧
  CPowCallAt history 0 "floatValue" [.value z] ∧
  (∀ receipt, history[1]? = some receipt → receipt.arguments = [.value p]) ∧
  (∀ receipt, history[2]? = some receipt → receipt.arguments = [.typeTag t]) ∧
  (∀ receipt, history[3]? = some receipt → ∃ floated,
    CPowValueAt history 1 = some floated ∧ receipt.arguments = [.value floated])

/-- Native literals retain their exact Julia types.  Every Tf operation
receives the actual result of float(T), not a substituted fixed float type.
The unchecked convert(Int,pr) result cannot be rejected by this caller before
the next source isreal(z) call. -/
def CPowArguments {E Ref Tag V Other State : Type}
    (history : List (CPowReceipt E Ref Tag V Other State)) : Prop :=
  (∀ receipt ∈ history,
    match receipt.label with
    | "lessInt32" => ∃ value, receipt.arguments = [.value value, .int32 (JInt.typemax .i32)]
    | "lessInt" => ∃ value number, receipt.arguments = [.value value, .integer number] ∧ number.val ∈ [0, 1]
    | "greaterInt" => ∃ value, receipt.arguments = [.value value, .integer (JInt.lit .i64 0)]
    | "fromFloat" => ∃ tf, CPowValueAt history 2 = some tf ∧
        receipt.arguments = [.value tf, .float64 JuliaLean.Float.F64.nan]
    | "zero" => ∃ tf, CPowValueAt history 2 = some tf ∧ receipt.arguments = [.value tf]
    | "one" => ∃ tf, CPowValueAt history 2 = some tf ∧ receipt.arguments = [.value tf]
    | "floatmax" => ∃ tf, CPowValueAt history 2 = some tf ∧ receipt.arguments = [.value tf]
    | "callPi" => ∃ tf, CPowValueAt history 2 = some tf ∧ receipt.arguments = [.value tf]
    | "indexed_first" => ∃ value, receipt.arguments = [.value value, .integer (JInt.lit .i64 1)]
    | "indexed_next" => ∃ value state, receipt.arguments = [.value value, .integer (JInt.lit .i64 2), .value state]
    | _ => True) ∧
  (∀ index receipt value, history[index]? = some receipt → receipt.label = "convertInt" →
    receipt.outcome = .ok (.value value) → ∃ floatedZ,
      CPowValueAt history 0 = some floatedZ ∧ CPowCallAt history (index + 1) "isreal" [.value floatedZ])

/-- Both ifelse arguments are evaluated eagerly.  The sign-correction site
negates its stored imaginary value; the positive-real-base site queries imag(p),
negates that actual result, then separately queries imag(p) again.  Its final
argument need not equal the first query, because selected getters can mutate. -/
def CPowIfelseArguments {E Ref Tag V Other State : Type}
    (history : List (CPowReceipt E Ref Tag V Other State)) : Prop :=
  ∀ index receipt, history[index]? = some receipt → receipt.label = "ifelse" →
    ∃ condition negative imaginary,
      receipt.arguments = [.predicate condition, .value negative, .value imaginary] ∧
      ((1 ≤ index ∧ CPowValueAt history (index - 1) = some negative ∧
          CPowCallAt history (index - 1) "negate" [.value imaginary]) ∨
       (3 ≤ index ∧ ∃ p firstImag,
          CPowCallAt history (index - 3) "imag" [.value p] ∧
          CPowValueAt history (index - 3) = some firstImag ∧
          CPowCallAt history (index - 2) "negate" [.value firstImag] ∧
          CPowValueAt history (index - 2) = some negative ∧
          CPowCallAt history (index - 1) "imag" [.value p] ∧
          CPowValueAt history (index - 1) = some imaginary))

def CPowStateChain {E Ref Tag V Other State : Type}
    (initialHeap finalHeap : FieldHeap Ref V) (initialState finalState : State) :
    List (CPowReceipt E Ref Tag V Other State) → Prop
  | [] => initialHeap = finalHeap ∧ initialState = finalState
  | receipt :: rest => receipt.beforeHeap = initialHeap ∧ receipt.beforeState = initialState ∧
      CPowStateChain receipt.afterHeap finalHeap receipt.afterState finalState rest

def CPowFailure {E Ref Tag V Other State : Type}
    (receipt : CPowReceipt E Ref Tag V Other State) : Option (Error E) :=
  match receipt.outcome with | .error error => some error | .ok _ => none

def CPowLocalError {E Ref Tag V Other State : Type}
    (error : Error E) (last : CPowReceipt E Ref Tag V Other State) : Prop :=
  (error = .typeError "_cpow Boolean condition" ∧
    last.label ∈ ["isreal", "isinteger", "lessInt32", "iszero", "lessInt", "greaterInt", "isfinite", "less"] ∧
    ∃ value, last.outcome = .ok (.predicate (.other value))) ∨
  (last.label ∈ ["indexed_first", "indexed_next"] ∧ FieldLocalError error) ∨
  (error = .typeError "Complex type parameter" ∧ last.label = "iszero" ∧
    last.outcome = .ok (.predicate (.boolean true)))

/-- Exact mutation accounting, terminal first exceptions, and return origin
for a complete selected-call observation; local caller errors are distinguished. -/
def CPowCoreAudit {E Ref Tag V Other State : Type} (terminal : List String)
    (localError : Error E → CPowReceipt E Ref Tag V Other State → Prop)
    (heap : FieldHeap Ref V) (state : State)
    (observed : Option ((Except (Error E) V × FieldHeap Ref V) ×
      (State × List (CPowReceipt E Ref Tag V Other State)))) : Prop :=
  match observed with
  | none => True
  | some ((outcome, finalHeap), (finalState, history)) =>
      CPowStateChain heap finalHeap state finalState history ∧
      match outcome with
      | .ok value => (∀ receipt ∈ history, CPowFailure receipt = none) ∧
          ∃ last, history.getLast? = some last ∧ last.label ∈ terminal ∧ last.outcome = .ok (.value value)
      | .error error => ∃ earlier last, history = earlier ++ [last] ∧
          (∀ receipt ∈ earlier, CPowFailure receipt = none) ∧
          (CPowFailure last = some error ∨ (CPowFailure last = none ∧ localError error last))

def CPowTotal {E Ref V State A : Type} (action : FieldM E Ref V State A) : Prop :=
  ∀ heap state, ∃ observed, action.run heap state = some observed

def CPowCalleesTotal {E Ref Tag V Other Rejected State : Type}
    (ops : CPowFullOps (FieldM E Ref V State) Tag V Other Rejected) : Prop :=
  (∀ value, CPowTotal (ops.floatValue value)) ∧
  (∀ tag, CPowTotal (ops.floatType tag)) ∧
  (∀ value, CPowTotal (ops.isreal value)) ∧
  (∀ value, CPowTotal (ops.real value)) ∧
  (∀ value, CPowTotal (ops.imag value)) ∧
  (∀ value, CPowTotal (ops.isinteger value)) ∧
  (∀ value, CPowTotal (ops.abs value)) ∧
  (∀ value number, CPowTotal (ops.lessInt32 value number)) ∧
  (∀ value, CPowTotal (ops.iszero value)) ∧
  (∀ value, CPowTotal (ops.zero value)) ∧
  (∀ value, CPowTotal (ops.one value)) ∧
  (∀ a b, CPowTotal (ops.copysign a b)) ∧
  (∀ a b, CPowTotal (ops.flipsign a b)) ∧
  (∀ a b, CPowTotal (ops.construct a b)) ∧
  (∀ value, CPowTotal (ops.convertInt value)) ∧
  (∀ value number, CPowTotal (ops.lessInt value number)) ∧
  (∀ value number, CPowTotal (ops.greaterInt value number)) ∧
  (∀ value number, CPowTotal (ops.fromFloat value number)) ∧
  (∀ value, CPowTotal (ops.inverse value)) ∧
  (∀ value, CPowTotal (ops.negate value)) ∧
  (∀ a b, CPowTotal (ops.powerBySquaring a b)) ∧
  (∀ value, CPowTotal (ops.iseven value)) ∧
  (∀ value, CPowTotal (ops.signbit value)) ∧
  (∀ a b, CPowTotal (ops.andOther a b)) ∧
  (∀ condition a b, CPowTotal (ops.ifelse condition a b)) ∧
  (∀ value, CPowTotal (ops.publicComplexOne value)) ∧
  (∀ a b, CPowTotal (ops.publicComplexTwo a b)) ∧
  (∀ a b, CPowTotal (ops.power a b)) ∧
  (∀ value, CPowTotal (ops.cospi value)) ∧
  (∀ value, CPowTotal (ops.sinpi value)) ∧
  (∀ value, CPowTotal (ops.isfinite value)) ∧
  (∀ target, CPowTotal (ops.zeroComplexType target)) ∧
  (∀ value, CPowTotal (ops.angle value)) ∧
  (∀ value, CPowTotal (ops.reim value)) ∧
  (∀ value, CPowTotal (ops.callPi value)) ∧
  (∀ value, CPowTotal (ops.log value)) ∧
  (∀ value, CPowTotal (ops.floatmax value)) ∧
  (∀ a b, CPowTotal (ops.subtract a b)) ∧
  (∀ a b, CPowTotal (ops.less a b)) ∧
  (∀ a b, CPowTotal (ops.multiply a b)) ∧
  (∀ value, CPowTotal (ops.exp value)) ∧
  (∀ a b, CPowTotal (ops.add a b)) ∧
  (∀ value, CPowTotal (ops.cis value)) ∧
  (∀ value index, CPowTotal (ops.iterations.first value index)) ∧
  (∀ value index state, CPowTotal (ops.iterations.next value index state))

/-- Two separate actual Tf(NaN) results reach the final constructor in order;
the first failing constructor/callee retains its heap and state.  No common
subexpression or assumption that both calls return the same value is admitted.
Invariant: base/complex.jl:810,826,839,847,879. -/
def CPowNaNConstruction : Prop :=
  ∀ (E Ref Tag V Other Rejected State : Type)
      (ops : CPowFullOps (FieldM E Ref V State) Tag V Other Rejected)
      (tf : V) (heap : FieldHeap Ref V) (state : State),
    let observed := (cpowNaN (CPowObservedOps ops) tf).run heap (state, [])
    CPowCoreAudit ["construct"] (fun _ _ => False) heap state observed ∧
    (match observed with
      | none => True
      | some ((outcome, _), (_, history)) =>
          (history.map (fun receipt => receipt.label)) = ["fromFloat", "fromFloat", "construct"].take history.length ∧
          CPowCallAt history 0 "fromFloat" [.value tf, .float64 JuliaLean.Float.F64.nan] ∧
          (∀ receipt, history[1]? = some receipt → receipt.arguments = [.value tf, .float64 JuliaLean.Float.F64.nan]) ∧
          (∀ receipt, history[2]? = some receipt → ∃ real imag,
            CPowValueAt history 0 = some real ∧ CPowValueAt history 1 = some imag ∧
            receipt.arguments = [.value real, .value imag]) ∧
          (match outcome with | .ok _ => history.length = 3 | .error _ => True)) ∧
    (observed = none → ¬ (CPowTotal (ops.fromFloat tf JuliaLean.Float.F64.nan) ∧
      (∀ real imag, CPowTotal (ops.construct real imag))))

/-- Both native Bool operands of & use the closed Boolean result and leave
all state unchanged, regardless of the arbitrary selected non-Bool fallback.
Invariant: base/complex.jl:818. -/
def CPowNativeBooleanAnd : Prop :=
  ∀ (E Ref Tag V Other Rejected State : Type)
      (ops : CPowFullOps (FieldM E Ref V State) Tag V Other Rejected)
      (left right : Bool) (heap : FieldHeap Ref V) (state : State),
    (cpowAnd ops (.boolean left) (.boolean right)).run heap state =
      some ((.ok (.boolean (left && right)), heap), state)

end JuliaLean.Proofs.base.complex.Models2Group9


namespace JuliaLean.Proofs.base.complex.Models2Group9

open JuliaLean JuliaLean.base.complex JuliaLean.Float
open JuliaLean.base.complex.Models2Group9

abbrev TrigReopenedState (Ref V State : Type) := FieldHeap Ref V × State
abbrev TrigReopenedM (E Ref V State A : Type) :=
  ExceptT (Error E) (StateT (TrigReopenedState Ref V State) Option) A

scoped instance TrigReopenedHeapState {E Ref V State : Type} :
    MonadStateOf (FieldHeap Ref V) (TrigReopenedM E Ref V State) where
  get := fun state => some (.ok state.1, state)
  set heap := fun state => some (.ok (), (heap, state.2))
  modifyGet f := fun state =>
    let (value, heap) := f state.1
    some (.ok value, (heap, state.2))

inductive TrigReopenedArgument (A Tag V Other : Type) where
  | input (z : Complex A)
  | value (value : V)
  | typeTag (tag : Tag)
  | nativeInt (value : JInt .i64)
  | float64 (value : F64)
  | other (value : Other)

inductive TrigReopenedObservedResult (V Other : Type) where
  | value (value : V)
  | predicate (value : PredicateValue Other)

structure TrigReopenedReceipt (E Ref A Tag V Other State : Type) where
  label : String
  arguments : List (TrigReopenedArgument A Tag V Other)
  outcome : Except (Error E) (TrigReopenedObservedResult V Other)
  before : TrigReopenedState Ref V State
  after : TrigReopenedState Ref V State

abbrev TrigReopenedHistory (E Ref A Tag V Other State : Type) :=
  List (TrigReopenedReceipt E Ref A Tag V Other State)

/-- Observe actual selected calls and the shared current field heap.  Callees
can mutate the heap and user state but cannot change the isolated history. -/
def TrigReopenedObserve {E Ref A Tag V Other State X : Type}
    (label : String) (arguments : List (TrigReopenedArgument A Tag V Other))
    (encode : X → TrigReopenedObservedResult V Other)
    (action : TrigReopenedM E Ref V State X) :
    TrigReopenedM E Ref V (State × TrigReopenedHistory E Ref A Tag V Other State) X :=
  fun (heap, (state, history)) =>
    match action (heap, state) with
    | none => none
    | some (outcome, (heapAfter, stateAfter)) =>
        let receipt : TrigReopenedReceipt E Ref A Tag V Other State :=
          { label, arguments, outcome := outcome.map encode,
            before := (heap, state), after := (heapAfter, stateAfter) }
        some (outcome, (heapAfter, (stateAfter, history ++ [receipt])))

/-- Instrument every arbitrary selected target without assuming any result,
constructor, predicate or transcendental correctness law. -/
def TrigReopenedObservedOps {E Ref A Tag V Other State : Type}
    (ops : TrigReopenedOps (TrigReopenedM E Ref V State) A Tag V Other) :
    TrigReopenedOps
      (TrigReopenedM E Ref V (State × TrigReopenedHistory E Ref A Tag V Other State))
      A Tag V Other where
  floatType := fun tag => TrigReopenedObserve "floatType" [.typeTag tag]
    TrigReopenedObservedResult.value (ops.floatType tag)
  reim := fun z => TrigReopenedObserve "reim" [.input z]
    TrigReopenedObservedResult.value (ops.reim z)
  equalZero := fun value zero => TrigReopenedObserve "equalZero" [.value value, .nativeInt zero]
    TrigReopenedObservedResult.predicate (ops.equalZero value zero)
  isfinite := fun value => TrigReopenedObserve "isfinite" [.value value]
    TrigReopenedObservedResult.predicate (ops.isfinite value)
  notOther := fun value => TrigReopenedObserve "notOther" [.other value]
    TrigReopenedObservedResult.predicate (ops.notOther value)
  isinf := fun value => TrigReopenedObserve "isinf" [.value value]
    TrigReopenedObservedResult.predicate (ops.isinf value)
  isnan := fun value => TrigReopenedObserve "isnan" [.value value]
    TrigReopenedObservedResult.predicate (ops.isnan value)
  callFloat := fun f value => TrigReopenedObserve "callFloat" [.value f, .value value]
    TrigReopenedObservedResult.value (ops.callFloat f value)
  callFloatLiteral := fun f literal => TrigReopenedObserve "callFloatLiteral" [.value f, .float64 literal]
    TrigReopenedObservedResult.value (ops.callFloatLiteral f literal)
  zero := fun value => TrigReopenedObserve "zero" [.value value]
    TrigReopenedObservedResult.value (ops.zero value)
  sinh := fun value => TrigReopenedObserve "sinh" [.value value]
    TrigReopenedObservedResult.value (ops.sinh value)
  cosh := fun value => TrigReopenedObserve "cosh" [.value value]
    TrigReopenedObservedResult.value (ops.cosh value)
  sincos := fun value => TrigReopenedObserve "sincos" [.value value]
    TrigReopenedObservedResult.value (ops.sincos value)
  multiply := fun x y => TrigReopenedObserve "multiply" [.value x, .value y]
    TrigReopenedObservedResult.value (ops.multiply x y)
  flipsign := fun x y => TrigReopenedObserve "flipsign" [.value x, .value y]
    TrigReopenedObservedResult.value (ops.flipsign x y)
  negate := fun value => TrigReopenedObserve "negate" [.value value]
    TrigReopenedObservedResult.value (ops.negate value)
  construct := fun x y => TrigReopenedObserve "construct" [.value x, .value y]
    TrigReopenedObservedResult.value (ops.construct x y)
  iterations := {
    first := fun value index => TrigReopenedObserve "indexedFirst" [.value value, .nativeInt index]
      TrigReopenedObservedResult.value (ops.iterations.first value index)
    next := fun value index state => TrigReopenedObserve "indexedNext"
      [.value value, .nativeInt index, .value state]
      TrigReopenedObservedResult.value (ops.iterations.next value index state) }

def TrigReopenedFailure {E Ref A Tag V Other State : Type}
    (receipt : TrigReopenedReceipt E Ref A Tag V Other State) : Option (Error E) :=
  match receipt.outcome with | .error error => some error | .ok _ => none

def TrigReopenedStateChain {E Ref A Tag V Other State : Type}
    (initial final : TrigReopenedState Ref V State) :
    TrigReopenedHistory E Ref A Tag V Other State → Prop
  | [] => final = initial
  | receipt :: rest => receipt.before = initial ∧ TrigReopenedStateChain receipt.after final rest

def TrigReopenedValueAt {E Ref A Tag V Other State : Type}
    (history : TrigReopenedHistory E Ref A Tag V Other State) (index : Nat) : Option V :=
  match history[index]? with
  | some receipt => match receipt.outcome with | .ok (.value value) => some value | _ => none
  | none => none

def TrigReopenedPredicateAt {E Ref A Tag V Other State : Type}
    (history : TrigReopenedHistory E Ref A Tag V Other State) (index : Nat) : Option (PredicateValue Other) :=
  match history[index]? with
  | some receipt => match receipt.outcome with | .ok (.predicate value) => some value | _ => none
  | none => none

/-- Permitted call words are complete on success and may end at a failure.
Expected arguments come only from actual receipts and original inputs. -/
def TrigReopenedWord {E Ref A Tag V Other State : Type}
    (outcome : Except (Error E) V)
    (history : TrigReopenedHistory E Ref A Tag V Other State)
    (expected : List (String × List (TrigReopenedArgument A Tag V Other))) : Prop :=
  history.length ≤ expected.length ∧
    history.map (fun receipt => (receipt.label, receipt.arguments)) = expected.take history.length ∧
    (∀ value, outcome = .ok value → history.length = expected.length)

/-- float(T) is first, then reim of the original value and its two selected
iterator calls.  This prefix also covers empty result carriers with a throwing
first call.  Exact field reads are covered by the registered unpack helper. -/
def TrigReopenedOpening {E Ref A Tag V Other State : Type}
    (t : Tag) (z : Complex A) (history : TrigReopenedHistory E Ref A Tag V Other State) : Prop :=
  match TrigReopenedValueAt history 0 with
  | none => history.map (fun receipt => (receipt.label, receipt.arguments)) = [("floatType", [.typeTag t])]
  | some _ =>
      match TrigReopenedValueAt history 1 with
      | none => history.map (fun receipt => (receipt.label, receipt.arguments)) =
          [("floatType", [.typeTag t]), ("reim", [.input z])]
      | some components =>
          ∃ state : V,
            let expected : List (String × List (TrigReopenedArgument A Tag V Other)) :=
              [("floatType", [.typeTag t]), ("reim", [.input z]),
               ("indexedFirst", [.value components, .nativeInt (JInt.lit .i64 1)]),
               ("indexedNext", [.value components, .nativeInt (JInt.lit .i64 2), .value state])]
            (history.map (fun receipt => (receipt.label, receipt.arguments))).take 4 =
              expected.take history.length

/-- Mathematical slot-membership observation, independent of the executable
getfield helper.  Mutable objects use the exact recorded post-call heap. -/
def TrigReopenedStoredValue {Ref V : Type}
    (view : V → FieldDescriptor Ref V) (heap : FieldHeap Ref V)
    (object : V) (index : Nat) (value : V) : Prop :=
  match view object with
  | .moduleValue => False
  | .immutableValue storage => storage.slots[index]? = some (.value value)
  | .mutableValue reference => (heap.objects reference).slots[index]? = some (.value value)

/-- Once unpacking has completed, its values and forwarded iterator state
must occur in the actual returned objects' recorded field stores. -/
def TrigReopenedUnpackedAt {E Ref A Tag V Other State : Type}
    (view : V → FieldDescriptor Ref V)
    (history : TrigReopenedHistory E Ref A Tag V Other State)
    (index : Nat) (iterable firstValue secondValue : V) : Prop :=
  ∃ first firstObject second secondObject iteratorState,
    history[index]? = some first ∧ first.outcome = .ok (.value firstObject) ∧
    first.arguments = [.value iterable, .nativeInt (JInt.lit .i64 1)] ∧
    TrigReopenedStoredValue view first.after.1 firstObject 0 firstValue ∧
    TrigReopenedStoredValue view first.after.1 firstObject 1 iteratorState ∧
    history[index + 1]? = some second ∧ second.outcome = .ok (.value secondObject) ∧
    second.arguments = [.value iterable, .nativeInt (JInt.lit .i64 2), .value iteratorState] ∧
    TrigReopenedStoredValue view second.after.1 secondObject 0 secondValue

/-- The zero-real branches preserve the first constructor argument before
any nested predicate/conversion for the second argument. -/
def TrigReopenedZeroRealWord {E Ref A Tag V Other State : Type}
    (cosine : Bool) (floated zr zi : V) (outcome : Except (Error E) V)
    (history : TrigReopenedHistory E Ref A Tag V Other State) : Prop :=
  let received := fun index => (TrigReopenedValueAt history index).getD zr
  if cosine then
    let tail : List (String × List (TrigReopenedArgument A Tag V Other)) :=
      match TrigReopenedPredicateAt history 1 with
      | some (.boolean true) => [("callFloat", [.value floated, .value zr]),
                                ("construct", [.value (received 0), .value (received 2)])]
      | _ => [("callFloat", [.value floated, .value zr]),
              ("flipsign", [.value (received 2), .value zi]), ("negate", [.value (received 3)]),
              ("construct", [.value (received 0), .value (received 4)])]
    TrigReopenedWord outcome history ([("cosh", [.value zi]), ("isnan", [.value zi])] ++ tail)
  else
    TrigReopenedWord outcome history
      [("callFloat", [.value floated, .value zr]), ("sinh", [.value zi]),
       ("construct", [.value (received 0), .value (received 1)])]

/-- Zero-imaginary exceptional branches retain F(NaN) before the cosine's
isnan test and its selected zero(F) or conversion/sign/negation sequence. -/
def TrigReopenedZeroImagWord {E Ref A Tag V Other State : Type}
    (cosine : Bool) (floated zr zi : V) (outcome : Except (Error E) V)
    (history : TrigReopenedHistory E Ref A Tag V Other State) : Prop :=
  let received := fun index => (TrigReopenedValueAt history index).getD zr
  if cosine then
    let tail : List (String × List (TrigReopenedArgument A Tag V Other)) :=
      match TrigReopenedPredicateAt history 1 with
      | some (.boolean true) => [("zero", [.value floated]),
                                ("construct", [.value (received 0), .value (received 2)])]
      | _ => [("callFloat", [.value floated, .value zi]),
              ("flipsign", [.value (received 2), .value zr]), ("negate", [.value (received 3)]),
              ("construct", [.value (received 0), .value (received 4)])]
    TrigReopenedWord outcome history
      ([("callFloatLiteral", [.value floated, .float64 F64.nan]), ("isnan", [.value zr])] ++ tail)
  else
    TrigReopenedWord outcome history
      [("callFloatLiteral", [.value floated, .float64 F64.nan]),
       ("callFloat", [.value floated, .value zi]), ("construct", [.value (received 0), .value (received 1)])]

/-- Repeated constructor-target calls are separate observable effects.  The
actual returned F is reused, while Inf/NaN remain fixed Float64 arguments. -/
def TrigReopenedExceptionalWord {E Ref A Tag V Other State : Type}
    (cosine infiniteImaginary : Bool) (floated zi : V) (outcome : Except (Error E) V)
    (history : TrigReopenedHistory E Ref A Tag V Other State) : Prop :=
  let received := fun index => (TrigReopenedValueAt history index).getD zi
  let firstLiteral := if cosine && infiniteImaginary then F64.inf false else F64.nan
  let secondCall : String × List (TrigReopenedArgument A Tag V Other) :=
    if !cosine && infiniteImaginary then ("callFloat", [.value floated, .value zi])
    else ("callFloatLiteral", [.value floated, .float64 F64.nan])
  TrigReopenedWord outcome history
    [("callFloatLiteral", [.value floated, .float64 firstLiteral]), secondCall,
     ("construct", [.value (received 0), .value (received 1)])]

/-- The finite branch preserves sincos/unpacking and the two products in
constructor-argument order.  Cosine explicitly requires negate(s), then
sinh(zi), then multiply; reassociation to negate(product) violates this word. -/
def TrigReopenedFiniteWord {E Ref A Tag V Other State : Type}
    (view : V → FieldDescriptor Ref V)
    (cosine : Bool) (zr zi : V) (outcome : Except (Error E) V)
    (history : TrigReopenedHistory E Ref A Tag V Other State) : Prop :=
  ∃ s c iterationState : V,
    let received := fun index => (TrigReopenedValueAt history index).getD zr
    let initialWord : List (String × List (TrigReopenedArgument A Tag V Other)) :=
      [("sincos", [.value zr]),
       ("indexedFirst", [.value (received 0), .nativeInt (JInt.lit .i64 1)]),
       ("indexedNext", [.value (received 0), .nativeInt (JInt.lit .i64 2), .value iterationState]),
       ("cosh", [.value zi]), ("multiply", [.value (if cosine then c else s), .value (received 3)])]
    let tail : List (String × List (TrigReopenedArgument A Tag V Other)) :=
      if cosine then
        [("negate", [.value s]), ("sinh", [.value zi]),
         ("multiply", [.value (received 5), .value (received 6)]),
         ("construct", [.value (received 4), .value (received 7)])]
      else
        [("sinh", [.value zi]), ("multiply", [.value c, .value (received 5)]),
         ("construct", [.value (received 4), .value (received 6)])]
    TrigReopenedWord outcome history (initialWord ++ tail) ∧
      (history[3]?.isSome = true → TrigReopenedUnpackedAt view history 1 (received 0) s c)

/-- Original imaginary-component predicates retain short-circuit order. -/
def TrigReopenedNonfiniteGate {E Ref A Tag V Other State : Type}
    (cosine : Bool) (floated zr zi : V) (outcome : Except (Error E) V)
    (history : TrigReopenedHistory E Ref A Tag V Other State) : Prop :=
  ∃ first, history[0]? = some first ∧ first.label = "equalZero" ∧
    first.arguments = [.value zi, .nativeInt (JInt.lit .i64 0)] ∧
    match first.outcome with
    | .error _ | .ok (.predicate (.other _)) => True
    | .ok (.value _) => False
    | .ok (.predicate (.boolean true)) =>
        TrigReopenedZeroImagWord cosine floated zr zi outcome (history.drop 1)
    | .ok (.predicate (.boolean false)) =>
        ∃ second, history[1]? = some second ∧ second.label = "isinf" ∧ second.arguments = [.value zi] ∧
          match second.outcome with
          | .error _ | .ok (.predicate (.other _)) => True
          | .ok (.value _) => False
          | .ok (.predicate (.boolean infiniteImaginary)) =>
              TrigReopenedExceptionalWord cosine infiniteImaginary floated zi outcome (history.drop 2)

/-- Final Boolean gate after native or selected !. -/
def TrigReopenedAfterFinite {E Ref A Tag V Other State : Type}
    (view : V → FieldDescriptor Ref V)
    (cosine nonfinite : Bool) (floated zr zi : V) (outcome : Except (Error E) V)
    (history : TrigReopenedHistory E Ref A Tag V Other State) : Prop :=
  if nonfinite then TrigReopenedNonfiniteGate cosine floated zr zi outcome history
  else TrigReopenedFiniteWord view cosine zr zi outcome history

/-- Non-Bool isfinite results invoke selected ! before condition rejection.
Native Bool results use closed negation, and cannot trigger that callback. -/
def TrigReopenedMainGate {E Ref A Tag V Other State : Type}
    (view : V → FieldDescriptor Ref V)
    (cosine : Bool) (floated : V) (outcome : Except (Error E) V)
    (history : TrigReopenedHistory E Ref A Tag V Other State) : Prop :=
  ∀ (first : TrigReopenedReceipt E Ref A Tag V Other State), history[4]? = some first →
    ∃ zr zi : V,
      first.label = "equalZero" ∧ first.arguments = [.value zr, .nativeInt (JInt.lit .i64 0)] ∧
      (∃ iterable, TrigReopenedValueAt history 1 = some iterable ∧
        TrigReopenedUnpackedAt view history 2 iterable zr zi) ∧
      match first.outcome with
      | .error _ | .ok (.predicate (.other _)) => True
      | .ok (.value _) => False
      | .ok (.predicate (.boolean true)) =>
          TrigReopenedZeroRealWord cosine floated zr zi outcome (history.drop 5)
      | .ok (.predicate (.boolean false)) =>
          ∃ finite, history[5]? = some finite ∧ finite.label = "isfinite" ∧ finite.arguments = [.value zr] ∧
            match finite.outcome with
            | .error _ => True
            | .ok (.value _) => False
            | .ok (.predicate (.boolean value)) =>
                TrigReopenedAfterFinite view cosine (!value) floated zr zi outcome (history.drop 6)
            | .ok (.predicate (.other value)) =>
                ∃ negation, history[6]? = some negation ∧ negation.label = "notOther" ∧
                  negation.arguments = [.other value] ∧
                  match negation.outcome with
                  | .error _ | .ok (.predicate (.other _)) => True
                  | .ok (.value _) => False
                  | .ok (.predicate (.boolean nonfinite)) =>
                      TrigReopenedAfterFinite view cosine nonfinite floated zr zi outcome (history.drop 7)

/-- isfinite itself is deliberately excluded: a non-Bool there first goes
through selected !.  All listed results are immediately used as conditions. -/
def TrigReopenedPredicateFailure {E Ref A Tag V Other State : Type}
    (receipt : TrigReopenedReceipt E Ref A Tag V Other State) : Prop :=
  receipt.label ∈ ["equalZero", "isinf", "isnan", "notOther"] ∧
    ∃ value, receipt.outcome = .ok (.predicate (.other value))

def TrigReopenedLocalFailure {E Ref A Tag V Other State : Type}
    (last : TrigReopenedReceipt E Ref A Tag V Other State) (error : Error E) : Prop :=
  ((last.label = "indexedFirst" ∨ last.label = "indexedNext") ∧
    (∃ value, last.outcome = .ok (.value value)) ∧
    (error = .typeError "getglobal" ∨ error = .jl .boundsError ∨ error = .undefRefError)) ∨
  (TrigReopenedPredicateFailure last ∧ error = .typeError "complex sin/cos Boolean condition")

/-- Both complete methods retain the exact first failure, state, caller
condition boundary and terminal constructor result. -/
def TrigReopenedAudit {E Ref A Tag V Other State : Type}
    (view : V → FieldDescriptor Ref V)
    (cosine : Bool) (t : Tag) (z : Complex A) (initial : TrigReopenedState Ref V State)
    (observed : Option (Except (Error E) V ×
      TrigReopenedState Ref V (State × TrigReopenedHistory E Ref A Tag V Other State))) : Prop :=
  match observed with
  | none => True
  | some (outcome, (heap, (state, history))) =>
      TrigReopenedOpening t z history ∧ TrigReopenedStateChain initial (heap, state) history ∧
      (∀ floated, TrigReopenedValueAt history 0 = some floated →
        TrigReopenedMainGate view cosine floated outcome history) ∧
      (∀ index receipt, history[index]? = some receipt → TrigReopenedPredicateFailure receipt →
        history.length = index + 1 ∧ outcome = .error (.typeError "complex sin/cos Boolean condition")) ∧
      match outcome with
      | .ok value =>
          (∀ receipt ∈ history, TrigReopenedFailure receipt = none) ∧
          ∃ last, history.getLast? = some last ∧ last.label = "construct" ∧ last.outcome = .ok (.value value)
      | .error error =>
          ∃ earlier last, history = earlier ++ [last] ∧
            (∀ receipt ∈ earlier, TrigReopenedFailure receipt = none) ∧ (heap, state) = last.after ∧
            (TrigReopenedFailure last = some error ∨
              (TrigReopenedFailure last = none ∧ TrigReopenedLocalFailure last error))

def TrigReopenedCallTotal {E Ref V State X : Type}
    (action : TrigReopenedM E Ref V State X) : Prop := ∀ state, action state ≠ none

/-- Arbitrary successful values, exceptions and state changes are total
outcomes.  Only divergence is excluded by this conditional progress premise. -/
def TrigReopenedCallsTotal {E Ref A Tag V Other State : Type}
    (ops : TrigReopenedOps (TrigReopenedM E Ref V State) A Tag V Other) : Prop :=
  (∀ tag, TrigReopenedCallTotal (ops.floatType tag)) ∧
  (∀ z, TrigReopenedCallTotal (ops.reim z)) ∧
  (∀ value zero, TrigReopenedCallTotal (ops.equalZero value zero)) ∧
  (∀ value, TrigReopenedCallTotal (ops.isfinite value)) ∧
  (∀ value, TrigReopenedCallTotal (ops.notOther value)) ∧
  (∀ value, TrigReopenedCallTotal (ops.isinf value)) ∧
  (∀ value, TrigReopenedCallTotal (ops.isnan value)) ∧
  (∀ f value, TrigReopenedCallTotal (ops.callFloat f value)) ∧
  (∀ f literal, TrigReopenedCallTotal (ops.callFloatLiteral f literal)) ∧
  (∀ value, TrigReopenedCallTotal (ops.zero value)) ∧
  (∀ value, TrigReopenedCallTotal (ops.sinh value)) ∧
  (∀ value, TrigReopenedCallTotal (ops.cosh value)) ∧
  (∀ value, TrigReopenedCallTotal (ops.sincos value)) ∧
  (∀ x y, TrigReopenedCallTotal (ops.multiply x y)) ∧
  (∀ x y, TrigReopenedCallTotal (ops.flipsign x y)) ∧
  (∀ value, TrigReopenedCallTotal (ops.negate value)) ∧
  (∀ x y, TrigReopenedCallTotal (ops.construct x y)) ∧
  (∀ value index, TrigReopenedCallTotal (ops.iterations.first value index)) ∧
  (∀ value index state, TrigReopenedCallTotal (ops.iterations.next value index state))

/-- Complete-domain effect and branch invariant shared by the two source
bodies.  No callee correctness law is assumed.  Success requires a complete
permitted receipt word, errors retain precise state and throw boundaries, and
total selected targets imply that the finite caller introduces no divergence.
Julia source: base/complex.jl:905-940. -/
def TrigReopenedEvaluationAudit (cosine : Bool) : Prop :=
  ∀ (E Ref A Tag V Other State : Type)
      (view : V → FieldDescriptor Ref V)
      (ops : TrigReopenedOps (TrigReopenedM E Ref V State) A Tag V Other)
      (t : Tag) (z : Complex A) (heap : FieldHeap Ref V) (state : State),
    let observed := (if cosine then cosComplexReopened (E := E) view (TrigReopenedObservedOps ops) t z
                     else sinComplexReopened (E := E) view (TrigReopenedObservedOps ops) t z)
      (heap, (state, []))
    TrigReopenedAudit view cosine t z (heap, state) observed ∧
      (TrigReopenedCallsTotal ops → observed ≠ none)

/-- Full generic sine source ordering, branch gates, literal/actual arguments,
heap/error preservation and no new divergence. Julia source: base/complex.jl:905-920. -/
def SineReopenedEvaluationAudit : Prop := TrigReopenedEvaluationAudit false

/-- Full generic cosine source ordering, including negate(s) before sinh and
multiplication, with arbitrary returned types/errors/state.
Julia source: base/complex.jl:923-940. -/
def CosineReopenedEvaluationAudit : Prop := TrigReopenedEvaluationAudit true

end JuliaLean.Proofs.base.complex.Models2Group9


namespace JuliaLean.Proofs.base.complex.Models2Group9

open JuliaLean JuliaLean.base.complex JuliaLean.base.complex.Models2Group9

structure ArcSineReceipt (E Ref A V State : Type) where
  call : ArcSineCall A V
  outcome : Except (Error E) V
  before : FieldHeap Ref V × State
  after : FieldHeap Ref V × State

abbrev ArcSineWorld (E Ref A V State : Type) :=
  State × List (ArcSineReceipt E Ref A V State)

/-- Instrument actual selected calls without exposing observation history to
them; native field reads and callees continue to share the actual heap. -/
def arcSineObservedOps {E Ref A V State : Type}
    (ops : ArcSineOps (FieldM E Ref V State) A V) :
    ArcSineOps (FieldM E Ref V (ArcSineWorld E Ref A V State)) A V where
  boolValue := ops.boolValue
  selected := fun call heap (state, history) =>
    match (ops.selected call).run heap state with
    | none => none
    | some ((outcome, nextHeap), nextState) =>
        let receipt : ArcSineReceipt E Ref A V State :=
          { call, outcome, before := (heap, state), after := (nextHeap, nextState) }
        some ((outcome, nextHeap), (nextState, history ++ [receipt]))

def ArcSineBaseLabel {A V : Type} : ArcSineCall A V → String
  | .reim _ => "reim"
  | .indexedFirst _ _ => "iterate1"
  | .indexedNext _ _ _ => "iterate2"
  | .isinf _ => "inf"
  | .isnan _ => "nan"
  | .isfinite _ => "finite"
  | .equalInt _ _ => "equal"
  | .notOther _ => "not"
  | .oftypePi _ => "pi"
  | .oftypeFloat _ _ => "oftypeFloat"
  | .divideInt _ _ => "divideInt"
  | .sign _ => "sign"
  | .copysign _ _ => "copysign"
  | .multiply _ _ => "multiply"
  | .subtractOriginal _ _ => "subtract"
  | .addOriginal _ _ => "add"
  | .squareRoot _ => "sqrt"
  | .conjugate _ => "conj"
  | .real _ => "real"
  | .imag _ => "imag"
  | .imagOriginal _ => "imagOriginal"
  | .atan _ _ => "atan"
  | .asinh _ => "asinh"
  | .construct _ _ => "construct"

def ArcSineIsTest {A V : Type} : ArcSineCall A V → Bool
  | .isinf _ | .isnan _ | .isfinite _ | .equalInt _ _ | .notOther _ => true
  | _ => false

def ArcSineLabel {E Ref A V State : Type} (boolValue : V → Option Bool)
    (receipt : ArcSineReceipt E Ref A V State) : String :=
  let label := ArcSineBaseLabel receipt.call
  if ArcSineIsTest receipt.call then
    match receipt.outcome with
    | .error _ => label ++ ":failed"
    | .ok value => match boolValue value with
      | some true => label ++ ":T"
      | some false => label ++ ":F"
      | none => label ++ ":other"
  else label

def ArcSineEraseTest : String → String
  | "inf:T" | "inf:F" | "inf:other" => "inf"
  | "nan:T" | "nan:F" | "nan:other" => "nan"
  | "finite:T" | "finite:F" | "finite:other" => "finite"
  | "equal:T" | "equal:F" | "equal:other" => "equal"
  | "not:T" | "not:F" | "not:other" => "not"
  | label => label

/-- A finite language of legal source call histories, with actual observed
Bool results selecting the early-return and real-coordinate paths.  It only
constrains calls and control flow; no expected numerical implementation or
callee correctness law is supplied. -/
def ArcSineCompleteWord (word : List String) : Prop :=
  let opening := ["reim", "iterate1", "iterate2"]
  let imaginary := ["subtract", "conj", "sqrt", "add", "sqrt", "multiply",
    "imag", "imagOriginal", "copysign", "asinh", "construct"]
  word = opening ++ ["inf:T", "inf:T", "pi", "divideInt", "copysign", "construct"] ∨
  ∃ firstCheck : List String,
    (firstCheck = ["inf:F"] ∨ firstCheck = ["inf:T", "inf:F"]) ∧
    (word = opening ++ firstCheck ++ ["nan:T", "inf:T", "oftypeFloat", "construct"] ∨
      ∃ secondCheck realPart : List String,
        (secondCheck = ["nan:F"] ∨ secondCheck = ["nan:T", "inf:F"]) ∧
        (realPart = ["equal:T"] ∨
          (∃ test, (test = ["finite:F"] ∨ test = ["finite:other", "not:T"]) ∧
            realPart = ["equal:F"] ++ test ++ ["pi", "divideInt", "sign", "multiply"]) ∨
          (∃ test, (test = ["finite:T"] ∨ test = ["finite:other", "not:F"]) ∧
            realPart = ["equal:F"] ++ test ++
              ["subtract", "sqrt", "add", "sqrt", "multiply", "real", "atan"])) ∧
        word = opening ++ firstCheck ++ secondCheck ++ realPart ++ imaginary)

/-- Native iteration and arithmetic literals retain their actual Julia types
and source values.  Repeated calls using the original argument retain exactly
that argument; in particular imag(z) is not replaced by the earlier reim result.
The two divide sites are independently separated by their surrounding calls. -/
def ArcSineArguments {E Ref A V State : Type} (z : Complex A)
    (history : List (ArcSineReceipt E Ref A V State)) : Prop :=
  (∀ receipt ∈ history, match receipt.call with
    | .reim original | .imagOriginal original => original = z
    | .subtractOriginal literal original | .addOriginal literal original =>
        original = z ∧ literal = JInt.lit .i64 1
    | .indexedFirst _ index => index = JInt.lit .i64 1
    | .indexedNext _ index _ => index = JInt.lit .i64 2
    | .equalInt _ literal => literal = JInt.lit .i64 0
    | .oftypeFloat _ literal => literal = JuliaLean.Float.F64.inf false
    | .divideInt _ literal => literal = JInt.lit .i64 2 ∨ literal = JInt.lit .i64 4
    | _ => True) ∧
  (∀ before call after, history = before ++ [call] ++ after →
    match call.call with
    | .divideInt _ literal =>
        (literal = JInt.lit .i64 4 →
          (before.map (fun receipt => ArcSineBaseLabel receipt.call)).count "nan" = 0) ∧
        (literal = JInt.lit .i64 2 →
          (before.map (fun receipt => ArcSineBaseLabel receipt.call)).count "equal" = 1)
    | _ => True)

def ArcSineStateChain {E Ref A V State : Type}
    (initial final : FieldHeap Ref V × State) : List (ArcSineReceipt E Ref A V State) → Prop
  | [] => final = initial
  | receipt :: rest => receipt.before = initial ∧ ArcSineStateChain receipt.after final rest

/-- Only primitive field failures or an actual failed Bool assertion can be
introduced by this finite caller; selected errors retain their exact identity. -/
def ArcSineLocalError {E Ref A V State : Type} (boolValue : V → Option Bool)
    (error : Error E) (last : ArcSineReceipt E Ref A V State) : Prop :=
  match last.call with
  | .indexedFirst _ _ | .indexedNext _ _ _ => FieldLocalError error
  | .isinf _ | .isnan _ | .equalInt _ _ | .notOther _ =>
      error = .typeError "if" ∧ ∃ value, last.outcome = .ok value ∧ boolValue value = none
  | _ => False

/-- Full-domain independent branch/effect/error/result invariant.  Actual
predicate results gate the permitted successful history; failures retain their
post-call heap and stop at the first error or exact native throw site.  The
final return must be the actual constructor result.  Every selected target is
unrestricted, including all custom reim and indexed_iterate behavior.
Invariant: base/complex.jl:949-961. -/
def ArcSineCompleteEffects : Prop :=
  ∀ (E Ref A V State : Type) (view : V → FieldDescriptor Ref V)
      (ops : ArcSineOps (FieldM E Ref V State) A V) (z : Complex A)
      (heap : FieldHeap Ref V) (state : State),
    (match (arcSineComplex (E := E) view (arcSineObservedOps ops) z).run heap (state, []) with
      | none => True
      | some ((outcome, finalHeap), (finalState, history)) =>
          ArcSineStateChain (heap, state) (finalHeap, finalState) history ∧
          ArcSineArguments z history ∧
          match outcome with
          | .ok value =>
              ArcSineCompleteWord (history.map (ArcSineLabel ops.boolValue)) ∧
              (∀ receipt ∈ history, ∃ result, receipt.outcome = .ok result) ∧
              ∃ real imag last, history.getLast? = some last ∧
                last.call = .construct real imag ∧ last.outcome = .ok value
          | .error error =>
              (∃ word suffix, ArcSineCompleteWord word ∧
                history.map (fun receipt => ArcSineBaseLabel receipt.call) ++ suffix =
                  word.map ArcSineEraseTest) ∧
              ∃ earlier last, history = earlier ++ [last] ∧
                (∀ receipt ∈ earlier, ∃ result, receipt.outcome = .ok result) ∧
                (last.outcome = .error error ∨
                  (∃ result, last.outcome = .ok result ∧ ArcSineLocalError ops.boolValue error last))) ∧
    ((∀ call h s, (ops.selected call).run h s ≠ none) →
      (arcSineComplex (E := E) view ops z).run heap state ≠ none)

end JuliaLean.Proofs.base.complex.Models2Group9


namespace JuliaLean.Proofs.base.complex.Models2Group9

open JuliaLean JuliaLean.Float JuliaLean.base.complex
open JuliaLean.base.complex.Models2Group9

/-- Observer-only native zero classification uses the installed IEEE zero/sign
queries.  It is independent of identicalFloat64's bit-equality implementation. -/
inductive AcosZeroClass where
  | positive
  | negative
  | other
  deriving DecidableEq

def AcosClassifyZero {V : Type} (asFloat64 : V → Option F64) (value : V) : AcosZeroClass :=
  match asFloat64 value with
  | none => .other
  | some actual =>
      if F64.iszero actual then if F64.signbit actual then .negative else .positive
      else .other

def AcosNaNLabel : AcosZeroClass → String
  | .positive => "isnanPositiveZero"
  | .negative => "isnanNegativeZero"
  | .other => "isnanOther"

/-- The isnan receipt records both its actual predicate result and an independent
classification of its argument's native type and sign.  Thus later identity
branch gates cannot silently treat Float32 zero as Float64 zero. -/
def AcosObserve {E Ref V State : Type}
    (ops : ArccosineOps (ReopenedBase E Ref V State) V) :
    ArccosineOps (ReopenedObserved E Ref V State) V where
  floatValue := fun z => LateObserved "float" (ops.floatValue z)
  reim := fun z => LateObserved "reim" (ops.reim z)
  iteration := ReopenedObserveIteration ops.iteration
  isnan := fun value => LateObservedInfo
    (AcosNaNLabel (AcosClassifyZero ops.asFloat64 value)) MiddlePredicateInfo (ops.isnan value)
  isinf := fun value => LateObservedInfo "isinf" MiddlePredicateInfo (ops.isinf value)
  equalSame := fun a b => LateObservedInfo "equalSame" MiddlePredicateInfo (ops.equalSame a b)
  equalZero := fun value literal => LateObservedInfo
    (if literal.val = 0 then "equalZero" else "badZeroLiteral") MiddlePredicateInfo
    (ops.equalZero value literal)
  equalFloat := fun value literal => LateObservedInfo (ExpFloatLabel literal)
    MiddlePredicateInfo (ops.equalFloat value literal)
  asFloat64 := ops.asFloat64
  negate := fun value => LateObserved "negate" (ops.negate value)
  abs := fun value => LateObserved "abs" (ops.abs value)
  oftypePi := fun value => LateObserved "oftypePi" (ops.oftypePi value)
  divideInt := fun value literal => LateObserved
    (if literal.val = 2 then "divideTwo" else if literal.val = 4 then "divideFour" else "badDivisor")
    (ops.divideInt value literal)
  subtractFromOne := fun literal value => LateObserved
    (if literal.val = 1 then "oneMinus" else "badOneLiteral") (ops.subtractFromOne literal value)
  addToOne := fun literal value => LateObserved
    (if literal.val = 1 then "onePlus" else "badOneLiteral") (ops.addToOne literal value)
  sqrt := fun value => LateObserved "sqrt" (ops.sqrt value)
  real := fun value => LateObserved "real" (ops.real value)
  atan := fun a b => LateObserved "atan" (ops.atan a b)
  multiplyInt := fun literal value => LateObserved
    (if literal.val = 2 then "multiplyTwo" else "badMultiplier") (ops.multiplyInt literal value)
  conjugate := fun value => LateObserved "conj" (ops.conjugate value)
  multiply := fun a b => LateObserved "multiply" (ops.multiply a b)
  imag := fun value => LateObserved "imag" (ops.imag value)
  inverseHyperbolicSine := fun value => LateObserved "asinh" (ops.inverseHyperbolicSine value)
  sign := fun value => LateObserved "sign" (ops.sign value)
  subtract := fun a b => LateObserved "subtract" (ops.subtract a b)
  construct := fun a b => LateReturned "construct" (ops.construct a b)

/-- The two independently observable ways the scalar equality chain fails. -/
inductive AcosZeroFailure where
  | different
  | sameNonzero

def AcosFailedZeroTokens : AcosZeroFailure → List ExpToken
  | .different => [("equalSame", "false")]
  | .sameNonzero => [("equalSame", "true"), ("equalZero", "false")]

def AcosEntry : List ExpToken := ExpOrdinary ["float", "reim"] ++ ExpIteration

def AcosNonNaNEntry (real imag : AcosZeroClass) : List ExpToken :=
  AcosEntry ++ [(AcosNaNLabel real, "false"), (AcosNaNLabel imag, "false")]

/-- A normal-return branch witness records predicate decisions and actual
native zero classes.  No numerical result or callee-correctness law is supplied. -/
inductive AcosTrace where
  | nanReal (real : AcosZeroClass) (imagInfinite : Bool)
  | nanImagInfinite (real imag : AcosZeroClass)
  | nanImagZero (real imag : AcosZeroClass)
  | nanImagOther (real imag : AcosZeroClass)
  | bothZero (real imag : AcosZeroClass)
  | positiveInfinite (real : AcosZeroClass) (failedZero : AcosZeroFailure)
  | negativeInfinite (real : AcosZeroClass) (failedZero : AcosZeroFailure) (positiveEquality : Bool)
  | regular (real imag : AcosZeroClass) (failedZero : AcosZeroFailure)
      (positiveEquality negativeEquality realInfinite imagInfinite : Bool)

/-- The regular branch excludes precisely the two native identity early returns.
Only the actual Float64 zero class may satisfy either identity test. -/
def AcosTraceValid : AcosTrace → Prop
  | .regular _ imag _ positive negative _ _ =>
      (positive = false ∨ imag ≠ .positive) ∧ (negative = false ∨ imag ≠ .negative)
  | _ => True

def AcosRegularWork : List ExpToken :=
  ExpOrdinary ["oneMinus", "sqrt", "real", "onePlus", "sqrt", "real", "atan", "multiplyTwo",
    "onePlus", "conj", "sqrt", "oneMinus", "sqrt", "multiply", "imag", "asinh"]

def AcosTraceTokens : AcosTrace → List ExpToken
  | .nanReal real infinite => AcosEntry ++
      [(AcosNaNLabel real, "true"), ("isinf", ExpBool infinite)] ++
      (if infinite then ExpOrdinary ["negate", "construct"] else ExpOrdinary ["construct"])
  | .nanImagInfinite real imag => AcosEntry ++
      [(AcosNaNLabel real, "false"), (AcosNaNLabel imag, "true"), ("isinf", "true")] ++
      ExpOrdinary ["abs", "construct"]
  | .nanImagZero real imag => AcosEntry ++
      [(AcosNaNLabel real, "false"), (AcosNaNLabel imag, "true"), ("isinf", "false"),
        ("equalZero", "true")] ++ ExpOrdinary ["oftypePi", "divideTwo", "construct"]
  | .nanImagOther real imag => AcosEntry ++
      [(AcosNaNLabel real, "false"), (AcosNaNLabel imag, "true"), ("isinf", "false"),
        ("equalZero", "false")] ++ ExpOrdinary ["construct"]
  | .bothZero real imag => AcosNonNaNEntry real imag ++
      [("equalSame", "true"), ("equalZero", "true")] ++
      ExpOrdinary ["oftypePi", "divideTwo", "negate", "construct"]
  | .positiveInfinite real zeroFailure => AcosNonNaNEntry real .positive ++
      AcosFailedZeroTokens zeroFailure ++ [("equalInf", "true")] ++
      ExpOrdinary ["negate", "construct"]
  | .negativeInfinite real zeroFailure positive => AcosNonNaNEntry real .negative ++
      AcosFailedZeroTokens zeroFailure ++ [("equalInf", ExpBool positive), ("equalNInf", "true")] ++
      ExpOrdinary ["oftypePi", "negate", "construct"]
  | .regular real imag zeroFailure positive negative realInfinite imagInfinite =>
      AcosNonNaNEntry real imag ++ AcosFailedZeroTokens zeroFailure ++
      [("equalInf", ExpBool positive), ("equalNInf", ExpBool negative)] ++ AcosRegularWork ++
      [("isinf", ExpBool realInfinite)] ++
      (if realInfinite then [("isinf", ExpBool imagInfinite)] else []) ++
      (if realInfinite && imagInfinite then
        ExpOrdinary ["oftypePi", "divideFour", "sign", "multiply", "subtract"] else []) ++
      ExpOrdinary ["construct"]

def AcosPaths (tokens : List ExpToken) : Prop :=
  ∃ trace, AcosTraceValid trace ∧ tokens = AcosTraceTokens trace

/-- On error, already-recorded branch decisions must still form a valid prefix.
A local Bool error is tied to an actual non-Bool predicate return; a native Core
error is tied to the immediately preceding indexed-iteration result. -/
def AcosTraceAudit {E State Result : Type}
    (observation : Option (Except (Error E × MiddleWorld (Error E) State)
      (Result × MiddleWorld (Error E) State))) : Prop :=
  match observation with
  | none => True
  | some (.ok (_, (_, history))) => AcosPaths (ExpReceiptTokens history)
  | some (.error (error, (_, history))) =>
      (∃ earlier last expected detail after,
        history = earlier ++ [last] ∧ last.failure = some error ∧
        AcosPaths expected ∧ expected = ExpReceiptTokens earlier ++ [(last.label, detail)] ++ after) ∨
      ((error = .typeError "getglobal" ∨ error = .jl .boundsError ∨ error = .undefRefError) ∧
        (∃ last, history.getLast? = some last ∧
          (last.label = "indexedFirst" ∨ last.label = "indexedNext")) ∧
        ∃ expected, AcosPaths expected ∧ ExpTokenPrefix (ExpReceiptTokens history) expected) ∨
      (error = .typeError "if" ∧
        ∃ earlier last expected detail after,
          history = earlier ++ [last] ∧ last.failure = none ∧ last.detail = "other" ∧
          last.label ∈ ["isnanPositiveZero", "isnanNegativeZero", "isnanOther", "isinf",
            "equalSame", "equalZero", "equalInf", "equalNInf"] ∧
          AcosPaths expected ∧ expected = ExpReceiptTokens earlier ++ [(last.label, detail)] ++ after ∧
          (detail = "true" ∨ detail = "false"))

def AcosOperationsTotal {E Ref V State : Type}
    (ops : ArccosineOps (ReopenedBase E Ref V State) V) : Prop :=
  (∀ z, MiddleTotal (ops.floatValue z)) ∧ (∀ value, MiddleTotal (ops.reim value)) ∧
  ReopenedIterationTotal ops.iteration ∧
  (∀ value, MiddleTotal (ops.isnan value)) ∧ (∀ value, MiddleTotal (ops.isinf value)) ∧
  (∀ a b, MiddleTotal (ops.equalSame a b)) ∧
  (∀ value literal, MiddleTotal (ops.equalZero value literal)) ∧
  (∀ value literal, MiddleTotal (ops.equalFloat value literal)) ∧
  (∀ value, MiddleTotal (ops.negate value)) ∧ (∀ value, MiddleTotal (ops.abs value)) ∧
  (∀ value, MiddleTotal (ops.oftypePi value)) ∧
  (∀ value literal, MiddleTotal (ops.divideInt value literal)) ∧
  (∀ literal value, MiddleTotal (ops.subtractFromOne literal value)) ∧
  (∀ literal value, MiddleTotal (ops.addToOne literal value)) ∧
  (∀ value, MiddleTotal (ops.sqrt value)) ∧ (∀ value, MiddleTotal (ops.real value)) ∧
  (∀ a b, MiddleTotal (ops.atan a b)) ∧
  (∀ literal value, MiddleTotal (ops.multiplyInt literal value)) ∧
  (∀ value, MiddleTotal (ops.conjugate value)) ∧ (∀ a b, MiddleTotal (ops.multiply a b)) ∧
  (∀ value, MiddleTotal (ops.imag value)) ∧
  (∀ value, MiddleTotal (ops.inverseHyperbolicSine value)) ∧
  (∀ value, MiddleTotal (ops.sign value)) ∧ (∀ a b, MiddleTotal (ops.subtract a b)) ∧
  (∀ a b, MiddleTotal (ops.construct a b))

/-- Full-domain acos invariant: actual predicate results and independently
observed Float64 type/zero classes control all short circuits; chained equality
cannot skip or eagerly add a comparison; all four roots and repeated 1±z calls
remain visible.  Native literals, exact selected errors/heap states, local
condition/Core errors, final constructor values and finite-call termination are
retained, with no correctness assumptions about any selected callee.
Invariant: base/complex.jl:963-984. -/
def AcosCompleteAudit : Prop :=
  ∀ (E Ref V State : Type) (view : V → FieldDescriptor Ref V)
      (ops : ArccosineOps (ReopenedBase E Ref V State) V)
      (z : Complex V) (heap : FieldHeap Ref V) (state : State),
    let observation := (arccosineComplex (E := E) view (AcosObserve ops) z).run
      (((heap, state), none), [])
    MiddleAudit (fun labels => ∃ trace, AcosTraceValid trace ∧
        labels = (AcosTraceTokens trace).map Prod.fst)
      ExpLocalError ((heap, state), none) observation ∧
    AcosTraceAudit observation ∧ LateFinalResult observation ∧
    ReopenedIndexArguments observation ∧
    MiddleNoNewDivergence (AcosOperationsTotal ops) observation

/-- Exact-type exclusion and signed-zero separation are independent native
identity invariants.  The first clause includes every non-Float64 type, such as
Float32 signed zero, without converting it to Float64.  Native Float64 identity
is reflexive and symmetric over all bit patterns, including NaNs.
Invariant: base/complex.jl:975,977; src/julia.h:2094-2101. -/
def NativeFloat64Identity : Prop :=
  (∀ (V : Type) (view : V → Option F64) (value : V) (literal : F64),
    view value = none → identicalFloat64 view value literal = false) ∧
  (∀ value : F64, identicalFloat64 some value value = true) ∧
  (∀ a b : F64, identicalFloat64 some a b = identicalFloat64 some b a) ∧
  identicalFloat64 some Fl64.pzero Fl64.nzero = false ∧
  identicalFloat64 some Fl64.nzero Fl64.pzero = false

end JuliaLean.Proofs.base.complex.Models2Group9


namespace JuliaLean.Proofs.base.complex.Models2Group9

open JuliaLean JuliaLean.base.complex
open JuliaLean.base.complex.Models2Group9

abbrev TanhReopenedState (Ref V State : Type) := FieldHeap Ref V × State
abbrev TanhReopenedM (E Ref V State A : Type) :=
  ExceptT (Error E) (StateT (TanhReopenedState Ref V State) Option) A

scoped instance TanhReopenedHeapState {E Ref V State : Type} :
    MonadStateOf (FieldHeap Ref V) (TanhReopenedM E Ref V State) where
  get := fun state => some (.ok state.1, state)
  set heap := fun state => some (.ok (), (heap, state.2))
  modifyGet f := fun state =>
    let (value, heap) := f state.1
    some (.ok value, (heap, state.2))

structure TanhReopenedReceipt (E Ref A Tag V State : Type) where
  call : TanhReopenedCall A Tag V
  outcome : Except (Error E) V
  before : TanhReopenedState Ref V State
  after : TanhReopenedState Ref V State

abbrev TanhReopenedHistory (E Ref A Tag V State : Type) :=
  List (TanhReopenedReceipt E Ref A Tag V State)

/-- Observe the actual selected call, result/error and complete heap/user
states; arbitrary callee mutations cannot alter this isolated receipt log. -/
def TanhReopenedObservedOps {E Ref A Tag V State : Type}
    (ops : TanhReopenedOps (TanhReopenedM E Ref V State) A Tag V) :
    TanhReopenedOps (TanhReopenedM E Ref V (State × TanhReopenedHistory E Ref A Tag V State)) A Tag V where
  boolValue := ops.boolValue
  selected := fun call => fun (heap, (state, history)) =>
    match ops.selected call (heap, state) with
    | none => none
    | some (outcome, (heapAfter, stateAfter)) =>
        let receipt : TanhReopenedReceipt E Ref A Tag V State :=
          { call, outcome, before := (heap, state), after := (heapAfter, stateAfter) }
        some (outcome, (heapAfter, (stateAfter, history ++ [receipt])))

def TanhReopenedFailure {E Ref A Tag V State : Type}
    (receipt : TanhReopenedReceipt E Ref A Tag V State) : Option (Error E) :=
  match receipt.outcome with | .error error => some error | .ok _ => none

def TanhReopenedStateChain {E Ref A Tag V State : Type}
    (initial final : TanhReopenedState Ref V State) : TanhReopenedHistory E Ref A Tag V State → Prop
  | [] => final = initial
  | receipt :: rest => receipt.before = initial ∧ TanhReopenedStateChain receipt.after final rest

def TanhReopenedValueAt {E Ref A Tag V State : Type}
    (history : TanhReopenedHistory E Ref A Tag V State) (index : Nat) : Option V :=
  match history[index]? with
  | some receipt => match receipt.outcome with | .ok value => some value | .error _ => none
  | none => none

def TanhReopenedBoolAt {E Ref A Tag V State : Type}
    (decode : V → Option Bool) (history : TanhReopenedHistory E Ref A Tag V State)
    (index : Nat) : Option Bool := (TanhReopenedValueAt history index).bind decode

/-- Mathematical field membership in the actual recorded store, independent
of the executable getfield helper. -/
def TanhReopenedStoredValue {Ref V : Type}
    (view : V → FieldDescriptor Ref V) (heap : FieldHeap Ref V)
    (object : V) (index : Nat) (value : V) : Prop :=
  match view object with
  | .moduleValue => False
  | .immutableValue storage => storage.slots[index]? = some (.value value)
  | .mutableValue reference => (heap.objects reference).slots[index]? = some (.value value)

def TanhReopenedUnpackedAt {E Ref A Tag V State : Type}
    (view : V → FieldDescriptor Ref V) (history : TanhReopenedHistory E Ref A Tag V State)
    (index : Nat) (iterable firstValue secondValue : V) : Prop :=
  ∃ first firstObject second secondObject iteratorState,
    history[index]? = some first ∧ first.outcome = .ok firstObject ∧
    first.call = .indexedFirst iterable (JInt.lit .i64 1) ∧
    TanhReopenedStoredValue view first.after.1 firstObject 0 firstValue ∧
    TanhReopenedStoredValue view first.after.1 firstObject 1 iteratorState ∧
    history[index + 1]? = some second ∧ second.outcome = .ok secondObject ∧
    second.call = .indexedNext iterable (JInt.lit .i64 2) iteratorState ∧
    TanhReopenedStoredValue view second.after.1 secondObject 0 secondValue

/-- A completed source branch has its entire permitted call word; failure
may truncate that word.  Expected values come from actual prior receipts. -/
def TanhReopenedWord {E Ref A Tag V State : Type}
    (outcome : Except (Error E) V) (history : TanhReopenedHistory E Ref A Tag V State)
    (expected : List (TanhReopenedCall A Tag V)) : Prop :=
  history.length ≤ expected.length ∧ history.map (·.call) = expected.take history.length ∧
    (∀ value, outcome = .ok value → history.length = expected.length)

/-- Preserve float(z), float(T), typemax, prevfloat, reim, and then the exact
indexed-iteration prefix on reim's actual result. -/
def TanhReopenedOpening {E Ref A Tag V State : Type}
    (tag : Tag) (original : Complex A) (history : TanhReopenedHistory E Ref A Tag V State) : Prop :=
  match TanhReopenedValueAt history 0 with
  | none => history.map (·.call) = [.float original]
  | some floated =>
      ∃ iterationState : V,
        let received := fun index => (TanhReopenedValueAt history index).getD floated
        let expected : List (TanhReopenedCall A Tag V) :=
          [.float original, .floatType tag, .typemax (received 1), .prevfloat (received 2),
           .reim floated, .indexedFirst (received 4) (JInt.lit .i64 1),
           .indexedNext (received 4) (JInt.lit .i64 2) iterationState]
        (history.map (·.call)).take 7 = expected.take history.length

/-- The overflow branch computes the real argument first, then zero(Tf),
then the finite-imaginary ternary, and only then the imaginary sign/product. -/
def TanhReopenedOverflowWord {E Ref A Tag V State : Type}
    (decode : V → Option Bool) (tf xi eta : V) (outcome : Except (Error E) V)
    (history : TanhReopenedHistory E Ref A Tag V State) : Prop :=
  let received := fun index => (TanhReopenedValueAt history index).getD xi
  let initialWord : List (TanhReopenedCall A Tag V) :=
    [.one tf, .copysign (received 0) xi, .zero tf, .isfinite eta]
  let tail : List (TanhReopenedCall A Tag V) :=
    match TanhReopenedBoolAt decode history 3 with
    | some true => [.abs eta, .multiplyIntLeft (JInt.lit .i64 2) (received 4),
        .sin (received 5), .multiply eta (received 6), .copysign (received 2) (received 7),
        .construct (received 1) (received 8)]
    | _ => [.one eta, .multiply eta (received 4), .copysign (received 2) (received 5),
        .construct (received 1) (received 6)]
  TanhReopenedWord outcome history (initialWord ++ tail)

/-- The ordinary branch distinguishes binary squares from both actual
three-operand products.  It constructs the numerator before the denominator
product, addition and selected division; reassociation violates this word. -/
def TanhReopenedNormalWord {E Ref A Tag V State : Type}
    (decode : V → Option Bool) (xi eta : V) (outcome : Except (Error E) V)
    (history : TanhReopenedHistory E Ref A Tag V State) : Prop :=
  let received := fun index => (TanhReopenedValueAt history index).getD xi
  let initialWord : List (TanhReopenedCall A Tag V) :=
    [.tan eta, .multiply (received 0) (received 0), .addIntLeft (JInt.lit .i64 1) (received 1),
     .sinh xi, .multiply (received 3) (received 3), .addIntLeft (JInt.lit .i64 1) (received 4),
     .squareRoot (received 5), .isinf (received 0)]
  let tail : List (TanhReopenedCall A Tag V) :=
    match TanhReopenedBoolAt decode history 7 with
    | some true => [.divide (received 6) (received 3), .divideIntLeft (JInt.lit .i64 1) (received 0),
        .construct (received 8) (received 9)]
    | _ => [.multiply3 (received 2) (received 6) (received 3), .construct (received 8) (received 0),
        .multiply3 (received 2) (received 3) (received 3), .addIntLeft (JInt.lit .i64 1) (received 10),
        .divide (received 9) (received 11)]
  TanhReopenedWord outcome history (initialWord ++ tail)

/-- Overflow comparison evaluates 4*abs(xi) before asinh(omega). -/
def TanhReopenedAfterNaN {E Ref A Tag V State : Type}
    (decode : V → Option Bool) (tf omega xi eta : V) (outcome : Except (Error E) V)
    (history : TanhReopenedHistory E Ref A Tag V State) : Prop :=
  let received := fun index => (TanhReopenedValueAt history index).getD xi
  let expected : List (TanhReopenedCall A Tag V) :=
    [.abs xi, .multiplyIntLeft (JInt.lit .i64 4) (received 0), .asinh omega,
     .greater (received 1) (received 2)]
  (history.map (·.call)).take 4 = expected.take history.length ∧
    match TanhReopenedBoolAt decode history 3 with
    | none => True
    | some true => TanhReopenedOverflowWord decode tf xi eta outcome (history.drop 4)
    | some false => TanhReopenedNormalWord decode xi eta outcome (history.drop 4)

/-- The first predicate sees exactly the unpacked real component.  The zero
imaginary check is skipped unless that predicate is true. -/
def TanhReopenedGates {E Ref A Tag V State : Type}
    (view : V → FieldDescriptor Ref V) (decode : V → Option Bool)
    (tf omega : V) (outcome : Except (Error E) V)
    (history : TanhReopenedHistory E Ref A Tag V State) : Prop :=
  ∀ (first : TanhReopenedReceipt E Ref A Tag V State), history[7]? = some first →
    ∃ xi eta iterable : V,
      first.call = .isnan xi ∧ TanhReopenedValueAt history 4 = some iterable ∧
      TanhReopenedUnpackedAt view history 5 iterable xi eta ∧
      match first.outcome with
      | .error _ => True
      | .ok value =>
          match decode value with
          | none => True
          | some false => TanhReopenedAfterNaN decode tf omega xi eta outcome (history.drop 8)
          | some true =>
              ∃ second, history[8]? = some second ∧ second.call = .equalInt eta (JInt.lit .i64 0) ∧
                match second.outcome with
                | .error _ => True
                | .ok value =>
                    match decode value with
                    | none => True
                    | some true => TanhReopenedWord outcome (history.drop 9) [.construct xi eta]
                    | some false => TanhReopenedAfterNaN decode tf omega xi eta outcome (history.drop 9)

def TanhReopenedConditionCall {A Tag V : Type} : TanhReopenedCall A Tag V → Bool
  | .isnan _ | .equalInt _ _ | .greater _ _ | .isfinite _ | .isinf _ => true
  | _ => false

def TanhReopenedPredicateFailure {E Ref A Tag V State : Type}
    (decode : V → Option Bool) (receipt : TanhReopenedReceipt E Ref A Tag V State) : Prop :=
  TanhReopenedConditionCall receipt.call = true ∧
    ∃ value, receipt.outcome = .ok value ∧ decode value = none

def TanhReopenedLocalFailure {E Ref A Tag V State : Type}
    (decode : V → Option Bool) (last : TanhReopenedReceipt E Ref A Tag V State) (error : Error E) : Prop :=
  ((match last.call with | .indexedFirst _ _ | .indexedNext _ _ _ => True | _ => False) ∧
    (∃ value, last.outcome = .ok value) ∧
    (error = .typeError "getglobal" ∨ error = .jl .boundsError ∨ error = .undefRefError)) ∨
  (TanhReopenedPredicateFailure decode last ∧ error = .typeError "tanh Boolean condition")

/-- Full branch, argument, heap/state, exception and returned-value invariant.
No expected-result computation reruns any selected target or assumes its laws. -/
def TanhReopenedAudit {E Ref A Tag V State : Type}
    (view : V → FieldDescriptor Ref V) (decode : V → Option Bool)
    (tag : Tag) (original : Complex A) (initial : TanhReopenedState Ref V State)
    (observed : Option (Except (Error E) V ×
      TanhReopenedState Ref V (State × TanhReopenedHistory E Ref A Tag V State))) : Prop :=
  match observed with
  | none => True
  | some (outcome, (heap, (state, history))) =>
      TanhReopenedOpening tag original history ∧ TanhReopenedStateChain initial (heap, state) history ∧
      (∀ tf omega, TanhReopenedValueAt history 1 = some tf → TanhReopenedValueAt history 3 = some omega →
        TanhReopenedGates view decode tf omega outcome history) ∧
      (∀ index receipt, history[index]? = some receipt → TanhReopenedPredicateFailure decode receipt →
        history.length = index + 1 ∧ outcome = .error (.typeError "tanh Boolean condition")) ∧
      match outcome with
      | .ok value =>
          (∀ receipt ∈ history, TanhReopenedFailure receipt = none) ∧
          ∃ last, history.getLast? = some last ∧ last.outcome = .ok value ∧
            (match last.call with | .construct _ _ | .divide _ _ => True | _ => False)
      | .error error =>
          ∃ earlier last, history = earlier ++ [last] ∧
            (∀ receipt ∈ earlier, TanhReopenedFailure receipt = none) ∧ (heap, state) = last.after ∧
            (TanhReopenedFailure last = some error ∨
              (TanhReopenedFailure last = none ∧ TanhReopenedLocalFailure decode last error))

/-- Every selected call may return any value or exception and mutate state;
this condition excludes only divergence, not numerical or type failures. -/
def TanhReopenedCallsTotal {E Ref A Tag V State : Type}
    (ops : TanhReopenedOps (TanhReopenedM E Ref V State) A Tag V) : Prop :=
  ∀ call state, ops.selected call state ≠ none

/-- Independent full-domain invariant for generic tanh.  Actual runtime type
changes, non-Bool predicates, custom variadic multiplication, mutable field
stores and arbitrary exceptions remain permitted.  Success respects complete
source call words; total selected calls imply no new caller divergence.
Julia source: base/complex.jl:1002-1022; base/tuple.jl:161-172. -/
def TanhReopenedEvaluationAudit : Prop :=
  ∀ (E Ref A Tag V State : Type) (view : V → FieldDescriptor Ref V)
      (ops : TanhReopenedOps (TanhReopenedM E Ref V State) A Tag V)
      (tag : Tag) (original : Complex A) (heap : FieldHeap Ref V) (state : State),
    let observed := (tanhComplexReopened (E := E) view (TanhReopenedObservedOps ops) tag original)
      (heap, (state, []))
    TanhReopenedAudit view ops.boolValue tag original (heap, state) observed ∧
      (TanhReopenedCallsTotal ops → observed ≠ none)

end JuliaLean.Proofs.base.complex.Models2Group9


namespace JuliaLean.Proofs.base.complex.Models2Group9

open JuliaLean JuliaLean.base.complex JuliaLean.base.complex.Models2Group9

structure ArcCoshReceipt (E Ref A V State : Type) where
  call : ArcCoshCall A V
  outcome : Except (Error E) V
  before : FieldHeap Ref V × State
  after : FieldHeap Ref V × State

abbrev ArcCoshWorld (E Ref A V State : Type) :=
  State × List (ArcCoshReceipt E Ref A V State)

def arcCoshObservedOps {E Ref A V State : Type}
    (ops : ArcCoshOps (FieldM E Ref V State) A V) :
    ArcCoshOps (FieldM E Ref V (ArcCoshWorld E Ref A V State)) A V where
  boolValue := ops.boolValue
  asFloat64 := ops.asFloat64
  selected := fun call heap (state, history) =>
    match (ops.selected call).run heap state with
    | none => none
    | some ((outcome, nextHeap), nextState) =>
        let receipt : ArcCoshReceipt E Ref A V State :=
          { call, outcome, before := (heap, state), after := (nextHeap, nextState) }
        some ((outcome, nextHeap), (nextState, history ++ [receipt]))

def ArcCoshBaseLabel {A V : Type} : ArcCoshCall A V → String
  | .reim _ => "reim"
  | .indexedFirst _ _ => "iterate1"
  | .indexedNext _ _ _ => "iterate2"
  | .isnan _ => "nan"
  | .isinf _ => "inf"
  | .equalFloat _ _ => "equal"
  | .oftypeFloat _ literal =>
      if literal = JuliaLean.Float.F64.inf false then "oftype:Inf"
      else if literal = JuliaLean.Float.F64.nan then "oftype:NaN"
      else if literal.toNat = 0xc00921fb54442d18 then "oftype:-Pi"
      else "oftype:other"
  | .oftypePi _ => "pi"
  | .subtractIntOriginal _ _ => "subtractInt"
  | .addIntOriginal _ _ => "addInt"
  | .conjugate _ => "conj"
  | .squareRoot _ => "sqrt"
  | .multiply _ _ => "multiply"
  | .multiplyThree _ _ _ => "multiplyThree"
  | .multiplyNative _ _ => "multiplyNative"
  | .real _ => "real"
  | .imag _ => "imag"
  | .asinh _ => "asinh"
  | .atan _ _ => "atan"
  | .divideInt _ _ => "divideInt"
  | .sign _ => "sign"
  | .subtract _ _ => "subtract"
  | .construct _ _ => "construct"

def ArcCoshIsTest {A V : Type} : ArcCoshCall A V → Bool
  | .isnan _ | .isinf _ | .equalFloat _ _ => true
  | _ => false

def ArcCoshLabel {E Ref A V State : Type} (boolValue : V → Option Bool)
    (receipt : ArcCoshReceipt E Ref A V State) : String :=
  let label := ArcCoshBaseLabel receipt.call
  if ArcCoshIsTest receipt.call then
    match receipt.outcome with
    | .error _ => label ++ ":failed"
    | .ok value => match boolValue value with
      | some true => label ++ ":T"
      | some false => label ++ ":F"
      | none => label ++ ":other"
  else label

/-- Legal successful histories are constrained by actual selected predicates,
native literal identities, repeated source arguments, and the optional final
infinite-coordinate correction.  This is a call-language invariant, not an
alternative numerical implementation of acosh. -/
def ArcCoshCompleteWord (word : List String) : Prop :=
  let opening := ["reim", "iterate1", "iterate2"]
  let numerical := ["subtractInt", "conj", "sqrt", "addInt", "sqrt", "multiply",
    "real", "asinh", "subtractInt", "sqrt", "imag", "addInt", "sqrt", "real",
    "atan", "multiplyNative"]
  (∃ nanCheck infCheck,
    (nanCheck = ["nan:T"] ∨ nanCheck = ["nan:F", "nan:T"]) ∧
    ((infCheck = ["inf:T"] ∨ infCheck = ["inf:F", "inf:T"]) ∧
      word = opening ++ nanCheck ++ infCheck ++ ["oftype:Inf", "oftype:NaN", "construct"] ∨
      infCheck = ["inf:F", "inf:F"] ∧
        word = opening ++ nanCheck ++ infCheck ++ ["oftype:NaN", "oftype:NaN", "construct"])) ∨
  word = opening ++ ["nan:F", "nan:F", "equal:T", "oftype:Inf", "oftype:-Pi", "construct"] ∨
  (∃ equality correction,
    (equality = "equal:T" ∨ equality = "equal:F") ∧
    (correction = ["inf:F", "construct"] ∨
      correction = ["inf:T", "inf:F", "construct"] ∨
      correction = ["inf:T", "inf:T", "pi", "divideInt", "sign", "sign",
        "multiplyThree", "subtract", "construct"]) ∧
    word = opening ++ ["nan:F", "nan:F", equality] ++ numerical ++ correction)

/-- Primitive read provenance is a relation on the actual recorded data and
post-iterator heaps.  No assumed tuple return or recomputed caller result is
used to identify the two extracted source coordinates. -/
def ArcCoshUnpacked {E Ref A V State : Type} (view : V → FieldDescriptor Ref V)
    (z : Complex A) (history : List (ArcCoshReceipt E Ref A V State)) (zr zi : V) : Prop :=
  ∃ reim first second rest iterable firstResult secondResult iterState,
    history = reim :: first :: second :: rest ∧
    reim.call = .reim z ∧ reim.outcome = .ok iterable ∧
    first.call = .indexedFirst iterable (JInt.lit .i64 1) ∧ first.outcome = .ok firstResult ∧
    FieldStoredAt first.after.1 view firstResult .first zr ∧
    FieldStoredAt first.after.1 view firstResult .second iterState ∧
    second.call = .indexedNext iterable (JInt.lit .i64 2) iterState ∧
    second.outcome = .ok secondResult ∧
    FieldStoredAt second.after.1 view secondResult .first zi

def ArcCoshArguments {E Ref A V State : Type} (z : Complex A)
    (history : List (ArcCoshReceipt E Ref A V State)) : Prop :=
  ∀ receipt ∈ history, match receipt.call with
    | .reim original => original = z
    | .subtractIntOriginal original literal | .addIntOriginal original literal =>
        original = z ∧ literal = JInt.lit .i64 1
    | .indexedFirst _ index => index = JInt.lit .i64 1
    | .indexedNext _ index _ => index = JInt.lit .i64 2
    | .equalFloat _ literal => literal = JuliaLean.Float.F64.inf true
    | .divideInt _ literal => literal = JInt.lit .i64 4
    | .multiplyNative literal _ => literal = JInt.lit .i64 2
    | _ => True

/-- Fixed Float64 identity uses the exact runtime type and bits.  A numerically
equal Float32, integer zero or positive Float64 zero cannot take the edge branch.
The literal passed after that edge is the negative binary64 approximation of
pi.  All selected predicate outcomes remain unrestricted. -/
def ArcCoshCoordinateGates {E Ref A V State : Type}
    (boolValue : V → Option Bool) (asFloat64 : V → Option JuliaLean.Float.F64)
    (zr zi : V) (history : List (ArcCoshReceipt E Ref A V State)) : Prop :=
  (∀ receipt ∈ history, match receipt.call with
    | .isnan value | .isinf value => value = zr ∨ value = zi
    | .equalFloat value _ => value = zr
    | .oftypeFloat value literal =>
        (literal = JuliaLean.Float.F64.inf false → value = zr) ∧
        (literal.toNat = 0xc00921fb54442d18 →
          value = zi ∧ asFloat64 zi = some (JuliaLean.Float.F64.zero true))
    | _ => True) ∧
  (∀ test, history[5]? = some test →
    match test.call with
    | .equalFloat _ _ =>
        ∀ result, test.outcome = .ok result →
          (boolValue result = some true ∧ asFloat64 zi = some (JuliaLean.Float.F64.zero true) →
            (history.drop 6).map (fun receipt => ArcCoshBaseLabel receipt.call) =
              ["oftype:Inf", "oftype:-Pi", "construct"])
    | _ => True)

def ArcCoshStateChain {E Ref A V State : Type}
    (initial final : FieldHeap Ref V × State) : List (ArcCoshReceipt E Ref A V State) → Prop
  | [] => final = initial
  | receipt :: rest => receipt.before = initial ∧ ArcCoshStateChain receipt.after final rest

def ArcCoshLocalError {E Ref A V State : Type} (boolValue : V → Option Bool)
    (error : Error E) (last : ArcCoshReceipt E Ref A V State) : Prop :=
  match last.call with
  | .indexedFirst _ _ | .indexedNext _ _ _ => FieldLocalError error
  | .isnan _ | .isinf _ | .equalFloat _ _ =>
      error = .typeError "if" ∧ ∃ value, last.outcome = .ok value ∧ boolValue value = none
  | _ => False

/-- Full generic invariant: predicate-controlled call histories and exact
primitive coordinate provenance, original argument and literal forwarding,
signed-zero identity gate, first errors with actual final heap/state, and actual
constructor return.  Every selected target is arbitrary.  Total selected calls
cannot introduce divergence into this finite source body.
Invariant: base/complex.jl:1029-1046. -/
def ArcCoshCompleteEffects : Prop :=
  ∀ (E Ref A V State : Type) (view : V → FieldDescriptor Ref V)
      (ops : ArcCoshOps (FieldM E Ref V State) A V) (z : Complex A)
      (heap : FieldHeap Ref V) (state : State),
    (match (arcCoshComplex (E := E) view (arcCoshObservedOps ops) z).run heap (state, []) with
      | none => True
      | some ((outcome, finalHeap), (finalState, history)) =>
          ArcCoshStateChain (heap, state) (finalHeap, finalState) history ∧
          ArcCoshArguments z history ∧
          match outcome with
          | .ok value =>
              ArcCoshCompleteWord (history.map (ArcCoshLabel ops.boolValue)) ∧
              (∀ receipt ∈ history, ∃ result, receipt.outcome = .ok result) ∧
              (∃ zr zi, ArcCoshUnpacked view z history zr zi ∧
                ArcCoshCoordinateGates ops.boolValue ops.asFloat64 zr zi history) ∧
              ∃ real imag last, history.getLast? = some last ∧
                last.call = .construct real imag ∧ last.outcome = .ok value
          | .error error =>
              (∃ word suffix, ArcCoshCompleteWord word ∧
                history.map (fun receipt => ArcCoshBaseLabel receipt.call) ++ suffix =
                  word.map ArcSineEraseTest) ∧
              ∃ earlier last, history = earlier ++ [last] ∧
                (∀ receipt ∈ earlier, ∃ result, receipt.outcome = .ok result) ∧
                (last.outcome = .error error ∨
                  (∃ result, last.outcome = .ok result ∧ ArcCoshLocalError ops.boolValue error last))) ∧
    ((∀ call h s, (ops.selected call).run h s ≠ none) →
      (arcCoshComplex (E := E) view ops z).run heap state ≠ none)

/-- A narrow independent bit-value invariant for the concrete negative-pi
dependency.  It records the IEEE64 result, not a definition-level negation
identity, and prevents replacing this source value by an exact irrational.
Invariant: base/irrationals.jl:215; base/mathconstants.jl:13. -/
def ArcCoshNegativePiBits : Prop :=
  arcCoshNegativePi.toNat = 0xc00921fb54442d18

end JuliaLean.Proofs.base.complex.Models2Group9


namespace JuliaLean.Proofs.base.complex.Models2Group9

open JuliaLean JuliaLean.base.complex JuliaLean.base.complex.Models2Group9

structure ArcTanhReceipt (E Ref A Tag V State : Type) where
  call : ArcTanhCall A Tag V
  outcome : Except (Error E) V
  beforeHeap : FieldHeap Ref V
  afterHeap : FieldHeap Ref V
  beforeState : State
  afterState : State

def ArcTanhObserve {E Ref A Tag V State : Type} (call : ArcTanhCall A Tag V)
    (action : FieldM E Ref V State V) :
    FieldM E Ref V (State × List (ArcTanhReceipt E Ref A Tag V State)) V :=
  fun heap (state, history) =>
    match action.run heap state with
    | none => none
    | some ((outcome, finalHeap), finalState) =>
        let receipt : ArcTanhReceipt E Ref A Tag V State :=
          { call, outcome, beforeHeap := heap, afterHeap := finalHeap,
            beforeState := state, afterState := finalState }
        some ((outcome, finalHeap), (finalState, history ++ [receipt]))

def ArcTanhObservedOps {E Ref A Tag V State : Type}
    (ops : ArcTanhOps (FieldM E Ref V State) A Tag V) :
    ArcTanhOps (FieldM E Ref V (State × List (ArcTanhReceipt E Ref A Tag V State))) A Tag V where
  selected := fun call => ArcTanhObserve call (ops.selected call)
  boolValue := ops.boolValue

def ArcTanhLabel {A Tag V : Type} : ArcTanhCall A Tag V → String
  | .float _ => "float"
  | .floatType _ => "floatType"
  | .reim _ => "reim"
  | .indexedFirst _ _ => "indexedFirst"
  | .indexedNext _ _ _ => "indexedNext"
  | .abs _ => "abs"
  | .floatmax _ => "floatmax"
  | .squareRoot _ => "squareRoot"
  | .divideInt _ _ => "divideInt"
  | .greater _ _ => "greater"
  | .isnan _ => "isnan"
  | .isinf _ => "isinf"
  | .zero _ => "zero"
  | .copysign _ _ => "copysign"
  | .construct _ _ => "construct"
  | .inverse _ => "inverse"
  | .real _ => "real"
  | .oftypePi _ => "oftypePi"
  | .one _ => "one"
  | .multiply _ _ => "multiply"
  | .equalInt _ _ => "equalInt"
  | .oftypeFloat _ _ => "oftypeFloat"
  | .muladdInt _ _ _ => "muladdInt"
  | .divide _ _ => "divide"
  | .log _ => "log"
  | .atan _ => "atan"
  | .add _ _ => "add"
  | .literalPowerTwo _ => "literalPowerTwo"
  | .multiplyIntLeft _ _ => "multiplyIntLeft"
  | .subtractIntLeft _ _ => "subtractIntLeft"
  | .addIntLeft _ _ => "addIntLeft"
  | .muladd _ _ _ => "muladd"
  | .log1p _ => "log1p"
  | .subtract _ _ => "subtract"
  | .angle _ => "angle"

def ArcTanhValueAt {E Ref A Tag V State : Type}
    (history : List (ArcTanhReceipt E Ref A Tag V State)) (index : Nat) : Option V :=
  match history[index]? with
  | some receipt => match receipt.outcome with | .ok value => some value | .error _ => none
  | none => none

def ArcTanhCallAt {E Ref A Tag V State : Type}
    (history : List (ArcTanhReceipt E Ref A Tag V State)) (index : Nat)
    (call : ArcTanhCall A Tag V) : Prop :=
  ∀ receipt, history[index]? = some receipt → receipt.call = call

/-- This finite language records complete source call words.  Error outcomes
may stop at a prefix, including a local Core error immediately after iteration.
No language member recomputes a numerical result or calls an operation. -/
def ArcTanhWords : List (List String) :=
  let opening := ["float", "floatType", "reim", "indexedFirst", "indexedNext", "abs", "abs",
    "floatmax", "squareRoot", "divideInt", "greater"]
  let exceptional := [
    ["isnan", "isinf", "zero", "copysign", "construct"],
    ["isnan", "isinf", "inverse", "real", "construct"],
    ["isnan", "isinf", "zero", "copysign", "oftypePi", "divideInt", "copysign", "construct"],
    ["isnan", "isinf", "inverse", "real", "oftypePi", "divideInt", "copysign", "construct"]]
  let normal := opening ++ ["greater", "one", "copysign", "multiply", "reim",
    "indexedFirst", "indexedNext", "equalInt"]
  let finish := ["construct", "multiply"]
  let eta := ["subtractIntLeft", "addIntLeft", "multiply", "subtract", "multiplyIntLeft",
    "construct", "angle", "divideInt"]
  (exceptional.map (fun suffix => opening ++ suffix)) ++
  (exceptional.map (fun suffix => opening ++ ["greater"] ++ suffix)) ++
  [ normal ++ ["equalInt", "oftypeFloat"] ++ finish,
    normal ++ ["equalInt", "muladdInt", "squareRoot", "squareRoot", "squareRoot", "divide", "log",
      "oftypePi", "divideInt", "divideInt", "atan", "add", "copysign", "divideInt"] ++ finish,
    normal ++ ["literalPowerTwo", "equalInt"] ++ eta ++ finish,
    normal ++ ["literalPowerTwo", "equalInt", "multiplyIntLeft", "subtractIntLeft", "subtractIntLeft",
      "muladd", "divide", "log1p", "divideInt"] ++ eta ++ finish ]

def ArcTanhWordAudit {E Ref A Tag V State : Type}
    (outcome : Except (Error E) V) (history : List (ArcTanhReceipt E Ref A Tag V State)) : Prop :=
  ∃ expected ∈ ArcTanhWords,
    history.length ≤ expected.length ∧
    history.map (fun receipt => ArcTanhLabel receipt.call) = expected.take history.length ∧
    (∀ value, outcome = .ok value → history.length = expected.length)

/-- Actual original inputs, results of both float calls, and the fixed first
operation chain; no source call result is replaced by a projected input field. -/
def ArcTanhOpening {E Ref A Tag V State : Type} (tag : Tag) (original : Complex A)
    (history : List (ArcTanhReceipt E Ref A Tag V State)) : Prop :=
  ArcTanhCallAt history 0 (.float original) ∧ ArcTanhCallAt history 1 (.floatType tag) ∧
  (∀ receipt, history[2]? = some receipt → ∃ z,
    ArcTanhValueAt history 0 = some z ∧ receipt.call = .reim z) ∧
  (∀ receipt, history[7]? = some receipt → ∃ tf,
    ArcTanhValueAt history 1 = some tf ∧ receipt.call = .floatmax tf) ∧
  (∀ receipt, history[8]? = some receipt → ∃ maximum,
    ArcTanhValueAt history 7 = some maximum ∧ receipt.call = .squareRoot maximum) ∧
  (∀ receipt, history[9]? = some receipt → ∃ root,
    ArcTanhValueAt history 8 = some root ∧ receipt.call = .divideInt root (JInt.lit .i64 4)) ∧
  (∀ receipt, history[10]? = some receipt → ∃ ax theta,
    ArcTanhValueAt history 5 = some ax ∧ ArcTanhValueAt history 9 = some theta ∧
    receipt.call = .greater ax theta)

/-- Every numeric iterator index is literal Int1 or Int2.  The iterator state
comes from the first result's current stored field2, and first coordinate has
already been read successfully before the second iterator runs. -/
def ArcTanhIterationAudit {E Ref A Tag V State : Type}
    (view : V → FieldDescriptor Ref V) (history : List (ArcTanhReceipt E Ref A Tag V State)) : Prop :=
  ∀ (index : Nat) (receipt : ArcTanhReceipt E Ref A Tag V State), history[index]? = some receipt →
    match receipt.call with
    | .indexedFirst iterable native => native = JInt.lit .i64 1 ∧ 1 ≤ index ∧
        ∃ previous, history[index - 1]? = some previous ∧
          previous.outcome = .ok iterable ∧ ArcTanhLabel previous.call = "reim"
    | .indexedNext iterable native state => native = JInt.lit .i64 2 ∧ 1 ≤ index ∧
        ∃ previous firstResult firstValue,
          history[index - 1]? = some previous ∧
          previous.call = .indexedFirst iterable (JInt.lit .i64 1) ∧
          previous.outcome = .ok firstResult ∧
          FieldStoredAt previous.afterHeap view firstResult .first firstValue ∧
          FieldStoredAt previous.afterHeap view firstResult .second state
    | _ => True

/-- The two selected abs arguments are extracted from actual result storage.
The same first-coordinate field origin controls the comparison after z *= beta.
This explicitly covers mutable alias changes made by either iterator call. -/
def ArcTanhCoordinates {E Ref A Tag V State : Type}
    (view : V → FieldDescriptor Ref V) (history : List (ArcTanhReceipt E Ref A Tag V State)) : Prop :=
  (∀ receipt, history[5]? = some receipt → ∃ first result x,
    history[3]? = some first ∧ first.outcome = .ok result ∧
    FieldStoredAt first.afterHeap view result .first x ∧ receipt.call = .abs x) ∧
  (∀ receipt, history[6]? = some receipt → ∃ second result y,
    history[4]? = some second ∧ second.outcome = .ok result ∧
    FieldStoredAt second.afterHeap view result .first y ∧ receipt.call = .abs y) ∧
  (∀ receipt, history[18]? = some receipt → ArcTanhLabel receipt.call = "equalInt" →
    ∃ first result x, history[16]? = some first ∧ first.outcome = .ok result ∧
      FieldStoredAt first.afterHeap view result .first x ∧ receipt.call = .equalInt x (JInt.lit .i64 1))

/-- Native constants and the stored original ay remain visible in the full
trace.  The literal-power call, sqrt(ay), and atan(ay/2) use the first ay even
after the second reim call has produced entirely different coordinates. -/
def ArcTanhLiteralAndOldAy {E Ref A Tag V State : Type}
    (history : List (ArcTanhReceipt E Ref A Tag V State)) : Prop :=
  (∀ (index : Nat) (receipt : ArcTanhReceipt E Ref A Tag V State), history[index]? = some receipt →
    match receipt.call with
    | .divideInt _ literal => literal = JInt.lit .i64 2 ∨ literal = JInt.lit .i64 4
    | .equalInt _ literal => literal = JInt.lit .i64 0 ∨ literal = JInt.lit .i64 1
    | .multiplyIntLeft literal _ => literal = JInt.lit .i64 2 ∨ literal = JInt.lit .i64 4
    | .subtractIntLeft literal _ => literal = JInt.lit .i64 1
    | .addIntLeft literal _ => literal = JInt.lit .i64 1
    | .muladdInt _ _ literal => literal = JInt.lit .i64 4
    | .oftypeFloat _ literal => literal = JuliaLean.Float.F64.inf false
    | .literalPowerTwo value => ArcTanhValueAt history 6 = some value
    | .atan value => 1 ≤ index ∧ ∃ previous ay,
        history[index - 1]? = some previous ∧ previous.outcome = .ok value ∧
        ArcTanhValueAt history 6 = some ay ∧
        previous.call = .divideInt ay (JInt.lit .i64 2)
    | _ => True) ∧
  (∀ receipt value, history[23]? = some receipt → receipt.call = .squareRoot value →
    ArcTanhValueAt history 6 = some value)

/-- The normal branch forwards the exact floated value into z *= beta,
then unpacks its actual result and uses beta as the left final multiplier.
The repeated 1-x operands of muladd are separate selected calls with the same
actual x; their possibly different returned values reach muladd unchanged. -/
def ArcTanhNormalDataflow {E Ref A Tag V State : Type}
    (history : List (ArcTanhReceipt E Ref A Tag V State)) : Prop :=
  (∀ receipt, history[14]? = some receipt → ArcTanhLabel receipt.call = "multiply" →
    ∃ floated beta, ArcTanhValueAt history 0 = some floated ∧
      ArcTanhValueAt history 13 = some beta ∧ receipt.call = .multiply floated beta) ∧
  (∀ receipt, history[15]? = some receipt → ArcTanhLabel receipt.call = "reim" →
    ∃ changed, ArcTanhValueAt history 14 = some changed ∧ receipt.call = .reim changed) ∧
  (∀ (index : Nat) (receipt : ArcTanhReceipt E Ref A Tag V State) first second ysq,
    history[index]? = some receipt → receipt.call = .muladd first second ysq →
      2 ≤ index ∧ ∃ left right x,
        history[index - 2]? = some left ∧ history[index - 1]? = some right ∧
        left.call = .subtractIntLeft (JInt.lit .i64 1) x ∧
        right.call = .subtractIntLeft (JInt.lit .i64 1) x ∧
        left.outcome = .ok first ∧ right.outcome = .ok second) ∧
  (∀ last, history.getLast? = some last → (∃ value, last.outcome = .ok value) → ArcTanhLabel last.call = "multiply" →
    1 ≤ history.length ∧ ∃ previous beta constructed,
      history[history.length - 2]? = some previous ∧
      ArcTanhLabel previous.call = "construct" ∧ previous.outcome = .ok constructed ∧
      ArcTanhValueAt history 13 = some beta ∧ last.call = .multiply beta constructed)

def ArcTanhStateChain {E Ref A Tag V State : Type}
    (heap finalHeap : FieldHeap Ref V) (state finalState : State) :
    List (ArcTanhReceipt E Ref A Tag V State) → Prop
  | [] => heap = finalHeap ∧ state = finalState
  | receipt :: rest => receipt.beforeHeap = heap ∧ receipt.beforeState = state ∧
      ArcTanhStateChain receipt.afterHeap finalHeap receipt.afterState finalState rest

def ArcTanhFailure {E Ref A Tag V State : Type}
    (receipt : ArcTanhReceipt E Ref A Tag V State) : Option (Error E) :=
  match receipt.outcome with | .error error => some error | .ok _ => none

def ArcTanhLocalError {E Ref A Tag V State : Type}
    (boolValue : V → Option Bool) (error : Error E)
    (receipt : ArcTanhReceipt E Ref A Tag V State) : Prop :=
  (error = .typeError "if" ∧ ArcTanhLabel receipt.call ∈ ["greater", "isnan", "isinf", "equalInt"] ∧
    ∃ value, receipt.outcome = .ok value ∧ boolValue value = none) ∨
  (ArcTanhLabel receipt.call ∈ ["indexedFirst", "indexedNext"] ∧ FieldLocalError error)

/-- Complete-domain source invariant for generic atanh.  Successful calls
follow a complete source path, return the actual last constructor/product,
and retain all heap/state changes.  Errors preserve the exact first selected
exception or the actual local primitive/Bool throw site.  Iteration values,
original ay, repeated calls and literal arguments have explicit provenance.
This finite source body cannot invent divergence if all selected callees
terminate.  No callee numerical, predicate, promotion or constructor law is
assumed.
Invariant: base/complex.jl:1048-1089. -/
def ArcTanhCompleteEffects : Prop :=
  ∀ (E Ref A Tag V State : Type)
      (ops : ArcTanhOps (FieldM E Ref V State) A Tag V)
      (view : V → FieldDescriptor Ref V) (tag : Tag) (original : Complex A)
      (heap : FieldHeap Ref V) (state : State),
    let observed := (arcTanhComplex (E := E) view (ArcTanhObservedOps ops) tag original).run heap (state, [])
    (match observed with
    | none => True
    | some ((outcome, finalHeap), (finalState, history)) =>
        ArcTanhStateChain heap finalHeap state finalState history ∧
        ArcTanhWordAudit outcome history ∧ ArcTanhOpening tag original history ∧
        ArcTanhIterationAudit view history ∧ ArcTanhCoordinates view history ∧
        ArcTanhLiteralAndOldAy history ∧ ArcTanhNormalDataflow history ∧
        match outcome with
        | .ok value => (∀ receipt ∈ history, ArcTanhFailure receipt = none) ∧
            ∃ last, history.getLast? = some last ∧
              ArcTanhLabel last.call ∈ ["construct", "multiply"] ∧ last.outcome = .ok value
        | .error error => ∃ earlier last, history = earlier ++ [last] ∧
            (∀ receipt ∈ earlier, ArcTanhFailure receipt = none) ∧
            (ArcTanhFailure last = some error ∨
              (ArcTanhFailure last = none ∧ ArcTanhLocalError ops.boolValue error last))) ∧
    (observed = none → ¬ (∀ call currentHeap currentState,
      ∃ result, (ops.selected call).run currentHeap currentState = some result))

/-- A native true first overflow comparison suppresses the second comparison
and the entire normal branch, even if their arbitrary selected targets would
mutate, throw, or diverge.  Only the original reim is evaluated, and successful
returns come directly from the exceptional constructor.
Invariant: base/complex.jl:1055-1068. -/
def ArcTanhOverflowShortCircuit : Prop :=
  ∀ (E Ref A Tag V State : Type)
      (ops : ArcTanhOps (FieldM E Ref V State) A Tag V)
      (view : V → FieldDescriptor Ref V) (tag : Tag) (original : Complex A)
      (heap : FieldHeap Ref V) (state : State),
    match (arcTanhComplex (E := E) view (ArcTanhObservedOps ops) tag original).run heap (state, []) with
    | none => True
    | some ((outcome, _), (_, history)) =>
        (∃ first value, history[10]? = some first ∧ first.outcome = .ok value ∧
          ops.boolValue value = some true) →
        (∀ (index : Nat) (receipt : ArcTanhReceipt E Ref A Tag V State),
          history[index]? = some receipt →
          (ArcTanhLabel receipt.call = "greater" → index = 10) ∧
          (ArcTanhLabel receipt.call = "reim" → index = 2) ∧
          ArcTanhLabel receipt.call ∉ ["one", "literalPowerTwo", "equalInt", "multiply"]) ∧
        (∀ value, outcome = .ok value → ∃ last,
          history.getLast? = some last ∧ ArcTanhLabel last.call = "construct" ∧ last.outcome = .ok value)

