  have hlo := power_classes (p-27) (by omega) (by omega)
  have hround : F64.roundRat ((2^(i+52) : Nat) : Int) d false = power (p-27) :=
    round_power (i+52) (j+79) (p-27) (by omega) (by omega) (by omega) false
  rw [hround, Nat.mod_eq_of_lt ((signbit_f _).mp hlo.2.1),
    Nat.mod_eq_of_lt ((signbit_f _).mp hsign)] at horder
  exact horder

theorem failed_fast_gap (p q : Int) (hp0 : -1074 ≤ p) (hp1 : p ≤ 971)
    (hq0 : -1074 ≤ q) (hq1 : q ≤ 971)
    (hfail : F64.le (power q) (F64.mul (power p) fastRoot) = false) : p-q ≤ 26 := by
  by_cases hg : p-q ≤ 26
  · exact hg
  · have hb := fast_product p (by omega) hp1
    have hq := power_classes q hq0 (by omega)
    have hbits := (power_le_bits q (p-27) hq0 (by omega) (by omega) (by omega)).mpr (by omega)
    have hs := (positive_le _ _ hq.1 hb.1 hq.2.1 hb.2.1).mpr (Nat.le_trans hbits hb.2.2)
    rw [hfail] at hs
    contradiction

theorem minRoot_source : F64.sqrt F64.floatmin = .ok (power (-511)) := by decide

theorem hypotScale_source : F64.mul Fl64.eps (power (-511)) = power (-563) := by decide

theorem scaleInverse_source : F64.div F64.one (power (-563)) = power 563 := by decide

theorem one_power : F64.one = power 0 := by decide

theorem hiRoot_power_test (p : Int) (hp0 : -1074 ≤ p) (hp1 : p ≤ 971) :
    F64.lt floatCheckHi (power p) = true ↔ 512 ≤ p := by
  have hp := power_classes p hp0 (by omega)
  have hf : F64.isfinite floatCheckHi = true := by decide
  have hs : F64.signbit floatCheckHi = false := by decide
  rw [positive_lt _ _ hf hp.1 hs hp.2.1, (power_bits p hp0 (by omega)).1]
  have hh : F64.toBits floatCheckHi = 0x5fe6a09e667f3bcc := by decide
  rw [hh]
  by_cases hl : p < -1022
  · have hpow := Nat.pow_lt_pow_right (by decide : 1 < (2 : Nat))
      (show (p+1074).toNat < 52 by omega)
    simp only [hl, ↓reduceIte]
    omega
  · simp only [hl, ↓reduceIte]
    omega

theorem scaled_power (p q : Int) (hp0 : -1074 ≤ p) (hp1 : p ≤ 971)
    (hq0 : -1074 ≤ q) (hq1 : q ≤ 971) (horder : q ≤ p) (hgap : p-q ≤ 26) :
    ∃ a t : Int, -511 ≤ a ∧ a ≤ 511 ∧ -511 ≤ a-(p-q) ∧ a+t=p ∧
      (t = 0 ∨ t = 563 ∨ t = -563) ∧
      scaled (power p) (power q) = tail (power a) (power (a-(p-q))) (power t) := by
  unfold scaled
  rw [minRoot_source, floatCheckSqrtHi]
  dsimp only [Bind.bind, Pure.pure, Except.bind, Except.pure]
  rw [hypotScale_source]
  by_cases hbig : 512 ≤ p
  · have ht := (hiRoot_power_test p hp0 hp1).mpr hbig
    simp only [ht, ↓reduceIte, Prod.fst, Prod.snd]
    have hx := power_mul p (-563) hp0 (by omega) (by decide) (by decide) (by omega) (by omega)
    have hy := power_mul q (-563) hq0 (by omega) (by decide) (by decide) (by omega) (by omega)
    rw [hx, hy, scaleInverse_source]
    refine ⟨p-563, 563, by omega, by omega, by omega, by omega, Or.inr (Or.inl rfl), ?_⟩
    congr 2 <;> omega
  · have ht : F64.lt floatCheckHi (power p) = false := by
      apply Bool.eq_false_iff.mpr
      intro hh
      exact hbig ((hiRoot_power_test p hp0 hp1).mp hh)
    simp only [ht, Bool.false_eq_true, ↓reduceIte]
    by_cases hsmall : q < -511
    · have hm := (power_lt q (-511) hq0 (by omega) (by decide) (by decide)).mpr hsmall
      simp only [hm, ↓reduceIte, Prod.fst, Prod.snd]
      have hx := power_div p (-563) hp0 (by omega) (by decide) (by decide) (by omega) (by omega)
      have hy := power_div q (-563) hq0 (by omega) (by decide) (by decide) (by omega) (by omega)
      rw [hx, hy]
      refine ⟨p+563, -563, by omega, by omega, by omega, by omega, Or.inr (Or.inr rfl), ?_⟩
      congr 2 <;> omega
    · have hm : F64.lt (power q) (power (-511)) = false := by
        apply Bool.eq_false_iff.mpr
        intro hh
        exact hsmall ((power_lt q (-511) hq0 (by omega) (by decide) (by decide)).mp hh)
      simp only [hm, Bool.false_eq_true, ↓reduceIte, Prod.fst, Prod.snd]
      rw [one_power]
      refine ⟨p, 0, by omega, by omega, by omega, by omega, Or.inl rfl, ?_⟩
      congr 2 <;> omega

theorem hypot_power_ordered (p q : Int) (hp0 : -1074 ≤ p) (hp1 : p ≤ 971)
    (hq0 : -1074 ≤ q) (hq1 : q ≤ 971) (horder : q ≤ p) :
    Fl64.hypot (power p) (power q) =
      if F64.le (power q) (F64.mul (power p) fastRoot) then .ok (power p)
      else scaled (power p) (power q) := by
  have hp := power_classes p hp0 (by omega)
  have hq := power_classes q hq0 (by omega)
  have hlt : F64.lt (power p) (power q) = false := by
    apply Bool.eq_false_iff.mpr
    intro hh
    have hh' := (power_lt p q hp0 (by omega) hq0 (by omega)).mp hh
    omega
  rw [hypot_form, power_abs p hp0 (by omega), power_abs q hq0 (by omega),
    div_one _ hp.1, div_one _ hq.1]
  simp only [prepared, hp.2.2.2.2, hq.2.2.2.2, Bool.false_or, Bool.false_eq_true,
    hlt, ite_false, ordered, fastRoot_source, Bind.bind, Pure.pure, Except.bind, Except.pure]

theorem hypot_power_swap (p q : Int) (hp0 : -1074 ≤ p) (hp1 : p ≤ 971)
    (hq0 : -1074 ≤ q) (hq1 : q ≤ 971) (horder : p < q) :
    Fl64.hypot (power p) (power q) = Fl64.hypot (power q) (power p) := by
  have hp := power_classes p hp0 (by omega)
  have hq := power_classes q hq0 (by omega)
  have hlt := (power_lt p q hp0 (by omega) hq0 (by omega)).mpr horder
  rw [hypot_power_ordered q p hq0 hq1 hp0 hp1 (by omega), hypot_form,
    power_abs p hp0 (by omega), power_abs q hq0 (by omega), div_one _ hp.1, div_one _ hq.1]
  simp only [prepared, hp.2.2.2.2, hq.2.2.2.2, Bool.false_or, Bool.false_eq_true,
    hlt, ite_false, ite_true, ordered, fastRoot_source, Bind.bind, Pure.pure, Except.bind, Except.pure]

def rat (x : F64) : Int × Int := ((F64.toRat x).1, ((F64.toRat x).2 : Int))

def bounds (x y r : F64) : Prop :=
  F64.isfinite r = true ∧ F64.signbit r = false ∧
  RatLessEqual (rat x) (rat r) ∧ RatLessEqual (rat y) (rat r) ∧
  RatLessEqual (rat r) (RatSum (rat x) (rat y))

theorem rat_den_pos (x : F64) (hx : F64.isfinite x = true) : 0 < (rat x).2 :=
  Int.natCast_pos.mpr (toRat_den_pos x hx)

theorem rat_positive_order (x y : F64) (hx : F64.isfinite x = true) (hy : F64.isfinite y = true)
    (sx : F64.signbit x = false) (sy : F64.signbit y = false) :
    RatLessEqual (rat x) (rat y) ↔ F64.toBits x ≤ F64.toBits y := by
  change (F64.toRat x).1*((F64.toRat y).2 : Int) ≤
    (F64.toRat y).1*((F64.toRat x).2 : Int) ↔ _
  rw [key64_order x y hx hy, key64_code_order]
  simp only [code64, sx, sy, Bool.false_eq_true, ↓reduceIte,
    Nat.mod_eq_of_lt ((signbit_f _).mp sx), Nat.mod_eq_of_lt ((signbit_f _).mp sy)]
  omega

theorem rat_sum_comm (a b : Int × Int) : RatSum a b = RatSum b a := by
  simp only [RatSum, Int.add_comm, Int.mul_comm]

theorem bounds_swap (x y r : F64) (h : bounds x y r) : bounds y x r := by
  rcases h with ⟨hf, hs, hx, hy, hz⟩
  exact ⟨hf, hs, hy, hx, by rw [rat_sum_comm]; exact hz⟩

theorem rat_le_self_sum (a b : Int × Int) (hb : 0 ≤ b.1) (ha : 0 ≤ a.2) :
    RatLessEqual a (RatSum a b) := by
  change a.1*(a.2*b.2) ≤ (a.1*b.2+b.1*a.2)*a.2
  rw [Int.add_mul, Int.mul_right_comm a.1 b.2 a.2, Int.mul_assoc a.1 a.2 b.2]
  exact Int.le_add_of_nonneg_right (Int.mul_nonneg (Int.mul_nonneg hb ha) ha)

theorem fast_bounds (p q : Int) (hp0 : -1074 ≤ p) (hp1 : p ≤ 971)
    (hq0 : -1074 ≤ q) (hq1 : q ≤ 971) (horder : q ≤ p) :
    bounds (power p) (power q) (power p) := by
  have hp := power_classes p hp0 (by omega)
  have hq := power_classes q hq0 (by omega)
  refine ⟨hp.1, hp.2.1, Int.le_refl _, ?_, ?_⟩
  · exact (rat_positive_order _ _ hq.1 hp.1 hq.2.1 hp.2.1).mpr
      ((power_le_bits q p hq0 (by omega) hp0 (by omega)).mpr horder)
  · apply rat_le_self_sum
    · obtain ⟨i, j, hr, _⟩ := power_rat q hq0 (by omega)
      change 0 ≤ (F64.toRat (power q)).1
      rw [hr]
      exact Int.natCast_nonneg _
    · exact Int.le_of_lt (rat_den_pos _ hp.1)

end JuliaLean.ChatGPT.Batch10.Group1.Epsilon

