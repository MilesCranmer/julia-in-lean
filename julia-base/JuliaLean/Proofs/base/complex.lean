/-- A pure runtime dispatch classification whose every possible call selects
another method.  This is an observed condition used only to state the finite
body's no-new-divergence consequence; it is not an assumed callee law. -/
def MixedNoInherited {CallArgs MethodArgs Result OperationResult : Type}
    (self : SelfDispatch CallArgs MethodArgs Result OperationResult) : Prop :=
  ∀ arguments, self.classify arguments = .selectedOther

/-- A selected nonrecursive callee receipt for the full recursive interpreter.
The private natural-number counter measures observations, never Julia values. -/
def MixedRecursiveCall {E State Result A : Type} (label : String)
    (returned : A → Option Result) (action : MixedM E State A) :
    MixedObservedM E State Nat Result A :=
  MixedObserve (fun _ => label) (fun _ => True) (fun count _ => count + 1) returned action

/-- Observe queries throughout all inherited recursive invocations.  Initial
source receivers are checked at their mandated opening positions; later
recursive receivers are retained as arbitrary operands of the inherited call. -/
def MixedRecursiveParts {E State A Result : Type}
    (parts : ComponentOps (MixedM E State) A) (initialReceiver : Complex A)
    (realLabel imagLabel : String) (realIndex imagIndex : Option Nat) :
    ComponentOps (MixedObservedM E State Nat Result) A where
  real := fun value => MixedObserve (fun _ => realLabel)
    (fun count => realIndex = some count → value = initialReceiver)
    (fun count _ => count + 1) (fun _ => none) (parts.real value)
  imag := fun value => MixedObserve (fun _ => imagLabel)
    (fun count => imagIndex = some count → value = initialReceiver)
    (fun count _ => count + 1) (fun _ => none) (parts.imag value)

/-- Full recursive-method invariant.  Every finite execution retains its
mandatory opening queries, every callee exception is terminal with its identity
and post-call state, and the returned value comes from the final constructor.
All mutation is accounted for by selected calls.  Divergence is possible under
inherited reselection, but cannot be manufactured when all classifications are
other methods and every selected call terminates.

This does not duplicate the method's arithmetic.  The separately registered
per-body audits check all call sites and data dependencies within an invocation;
this invariant checks the complete least-fixed-point interpreter. -/
def MixedRecursiveAudit {E State Result : Type} (finiteDispatch : Prop)
    (opening : List String) (initial : State)
    (observation : Option (Except E Result × MixedWorld E State Nat Result)) : Prop :=
  match observation with
  | none => ¬ finiteDispatch
  | some (.ok value, world) =>
      (∃ rest, world.history.map (fun call => call.label) = opening ++ rest) ∧
      (∀ call ∈ world.history, call.arguments ∧ call.failure = none) ∧
      MixedStateChain initial world.user world.history ∧
      ∃ earlier last, world.history = earlier ++ [last] ∧ last.returned = some value
  | some (.error error, world) =>
      (∃ rest, (world.history.map (fun call => call.label)).take opening.length ++ rest = opening) ∧
      (∀ call ∈ world.history, call.arguments) ∧
      MixedStateChain initial world.user world.history ∧
      ∃ earlier last, world.history = earlier ++ [last] ∧
        (∀ call ∈ earlier, call.failure = none) ∧ last.failure = some error

