  rw [hsq, sqrt_sum a d ha0 ha1 hd]
  simp only [bind, Except.bind, pure, Except.pure]
  rw [hcorr, hprod, mul_one _ (round_mantissa_classes (a+t) (coefficient d) i j hp0 hp1
    hcoef.1 (by omega) he).1]

