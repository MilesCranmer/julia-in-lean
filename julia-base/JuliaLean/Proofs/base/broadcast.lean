    (core : Bool → CoreOps (World W L) L)
    (select : Value L → Value L → Value L → W → Method)
    (bindings : Bindings L) (style bc original : Value L) (boundscheck : Bool)
    (values : Nat → Value L) (worlds : Nat → W) (methods : Nat → Method)
    (coherent : ∀ step, methods (step + 1) =
      select style bc (values (3 * step + 2)) (worlds (3 * step + 2)))
    (initial : W) (history : List (ContextEvent L))
    (remaining : List (Reply W L)) (depth position : Nat)
    (tail : List (ContextEvent L)) (error : Value L) (failureWorld : W)
    (nonterminal : ∀ step, step < depth → isTerminal (methods step) = false)
    (positionBound : position < 3 * depth) :
    runMethod (observingDispatch core select) bindings (methods 0)
      style bc original boundscheck
      ⟨initial, successes position values worlds ++ .thrown error failureWorld :: remaining, history⟩ =
      some (.error (error, ⟨failureWorld, remaining,
        history ++ (conversionEvents bindings boundscheck bc original values methods depth ++
          tail).take (position + 1)⟩)) := by
  let completed := position / 3
  let offset := position % 3
  have splitPosition : position = 3 * completed + offset := by
    dsimp [completed, offset]
    omega
  have completedBound : completed < depth := by
    dsimp [completed]
    omega
  have offsetBound : offset < 3 := by
    dsimp [offset]
    omega
  rw [splitPosition, successes_add, List.append_assoc]
  rw [run_conversion_prefix core select bindings style bc original boundscheck values worlds
    methods coherent initial history
    (successes offset (fun i => values (3 * completed + i))
      (fun i => worlds (3 * completed + i)) ++ .thrown error failureWorld :: remaining)
    completed (fun step h => nonterminal step (by omega))]
  rw [conversionEvents_take_inside bindings boundscheck bc original values methods
    depth completed offset tail completedBound offsetBound]
  have selectedNonterminal := nonterminal completed completedBound
  have offsetCases : offset = 0 ∨ offset = 1 ∨ offset = 2 := by omega
