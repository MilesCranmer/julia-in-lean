namespace JuliaLean.Proofs.base.broadcast.Models2Group5.CartesianRanges

open JuliaLean.Registry
open JuliaLean.base.expr (Value)
open JuliaLean.base.boot (CoreOps)
open JuliaLean.base.broadcast.Models2Group5.CartesianRanges
open JuliaLean.Proofs.base.broadcast.Models2Group5.ForwardObservations

/-- Observe the actual selected map with the callable's runtime identity and
original two input objects. Executable callable behavior is independently
covered by ClosureContract below. No map law or copied range evaluator is
assumed, and all selected map outcomes remain arbitrary. -/
def observingCartesian {W L : Type} (core : CoreOps (ProbeWorld W L) L)
    (bindings : Bindings L) : Ops (ProbeWorld W L) L where
  toOps := JuliaLean.Proofs.base.broadcast.Models2Group5.RangeRuntime.observingRange
    core bindings.toBindings
  map := fun function left right =>
    observe (.call bindings.map [function.value, left, right])

/-- The plus mapper receives the actual plus singleton and exact axes/
coordinate replies in source order. Constructor output, errors, world changes
and divergence retain their source position. Source1245-1246. -/
def PlusObservations : Prop :=
  ∀ {W L : Type} (bindings : Bindings L) (indices offset : Value L),
    ReturnsLastAfter (W := W) (L := L) 3
      (fun core => plus (observingCartesian core bindings) bindings indices offset)
      (fun core values _ _ =>
        [.call bindings.getproperty [indices, .symbol "indices"],
         .call (JuliaLean.base.boot.coreV core "Tuple") [offset],
         .call bindings.map [bindings.closureValue .plus, values 0, values 1],
         .call bindings.cartesianIndices [values 2]])

/-- The reversed-plus adapter swaps the two original objects only at the
broadcasted call, then materializes its exact reply. Source1247-1248. -/
def PlusReversedObservations : Prop :=
  ∀ {W L : Type} (bindings : Bindings L) (offset indices : Value L),
    ReturnsLastAfter (W := W) (L := L) 1
      (fun core => plusReversed core bindings offset indices)
      (fun _ values _ _ =>
        [.call bindings.broadcasted [bindings.add, indices, offset],
         .call bindings.materialize [values 0]])

/-- The minus mapper preserves range-minus-offset orientation and the
actual minus singleton. It cannot pre-zip a finite list or bypass source
Tuple/property/map/constructor effects. Source1249-1250. -/
def MinusObservations : Prop :=
  ∀ {W L : Type} (bindings : Bindings L) (indices offset : Value L),
    ReturnsLastAfter (W := W) (L := L) 3
      (fun core => minus (observingCartesian core bindings) bindings indices offset)
      (fun core values _ _ =>
        [.call bindings.getproperty [indices, .symbol "indices"],
         .call (JuliaLean.base.boot.coreV core "Tuple") [offset],
         .call bindings.map [bindings.closureValue .minus, values 0, values 1],
         .call bindings.cartesianIndices [values 2]])

/-- Source1251 obtains offsets before ranges, maps the actual diffrange,
constructs CartesianIndices, then reverses that exact result. Every selected
result, error and world is arbitrary; no equal-list/rank or success premise
narrows the original runtime domain. -/
def MinusReversedObservations : Prop :=
  ∀ {W L : Type} (bindings : Bindings L) (offset indices : Value L),
    ReturnsLastAfter (W := W) (L := L) 4
      (fun core => minusReversed (observingCartesian core bindings) bindings offset indices)
      (fun core values _ _ =>
        [.call (JuliaLean.base.boot.coreV core "Tuple") [offset],
         .call bindings.getproperty [indices, .symbol "indices"],
         .call bindings.map [bindings.closureValue .difference, values 0, values 1],
         .call bindings.cartesianIndices [values 2],
         .call bindings.reverse [values 3]])

/-- Independent diffrange invariant: last then offset-minus-last precedes
length then step; the named range arguments are length and step in that
order, without negation or swapped operands. Source: broadcast.jl:1252. -/
def DifferenceObservations : Prop :=
  ∀ {W L : Type} (bindings : Bindings L) (offset range : Value L),
    ReturnsLastAfter (W := W) (L := L) 4
      (fun core => differenceBody
        (JuliaLean.Proofs.base.broadcast.Models2Group5.RangeRuntime.observingRange
          core bindings.toBindings) bindings offset range)
      (fun _ values _ _ =>
        [.call bindings.last [range],
         .call bindings.subtract [offset, values 0],
         .call bindings.length [range],
         .call bindings.step [range],
         .keywordCall bindings.range [values 1] [("length", values 2), ("step", values 3)]])

theorem plusObservations : PlusObservations := by
  unfold PlusObservations
  intros
  simp [ReturnsLastAfter, successfulReplies, List.ofFn_succ, List.ofFn_zero,
    Fin.forall_fin_succ, plus, observingOps, observe, Bind.bind,
    List.append_assoc, observingCartesian, closure, JuliaLean.Proofs.base.broadcast.Models2Group5.RangeRuntime.observingRange, JuliaLean.base.boot.coreV]

