/-- Failure observations for the actual layered exception representation.
A runtime error remains a CoreM error, never an outer success carrying a range
error; divergence remains none. Finite reply records are proof observations,
not replacement Julia input collections. -/
def RuntimeFailurePrefixes {W L A : Type} (action : M (World W L) L A)
    (successful : List (Reply W L)) (prescribed : List (ContextEvent L))
    (initial : W) (history : List (ContextEvent L)) (suffix : List (Reply W L)) : Prop :=
  (∀ (position : Fin successful.length) (error : Value L) (failureWorld : W),
    let remaining := successful.drop (position.val + 1) ++ suffix
    let before : World W L := ⟨initial, successful.take position.val ++
      [.thrown error failureWorld] ++ remaining, history⟩
    let after : World W L :=
      ⟨failureWorld, remaining, history ++ prescribed.take (position.val + 1)⟩
    action.run before = some (.error (error, after))) ∧
  (∀ position : Fin successful.length,
    let before : World W L := ⟨initial, successful.take position.val ++ [.diverged] ++
      successful.drop (position.val + 1) ++ suffix, history⟩
    action.run before = none)

/-- Successful layered observations use `.ok` in both exception channels and
preserve the independent designated result and final arbitrary runtime world. -/
def Finishes {W L A : Type} (action : M (World W L) L A)
    (values : Nat → Value L) (worlds : Nat → W) (initial : W)
    (history : List (ContextEvent L)) (suffix : List (Reply W L))
    (events : List (ContextEvent L)) (returned : A) : Prop :=
  let successful := successes events.length values worlds
  let before : World W L := ⟨initial, successful ++ suffix, history⟩
  let after : World W L := ⟨worlds (events.length - 1), suffix, history ++ events⟩
  0 < events.length ∧ action.run before = some (.ok (.ok returned, after)) ∧
    RuntimeFailurePrefixes action successful events initial history suffix

/-- Both exception adapters retain their class, position and world. They do
not extract a default from a failed installed native model, nor reclassify a
runtime thrown value. Quantification includes success, failure and divergence.
Source: base/broadcast.jl:1035-1073. -/
def ExceptionLayerContract : Prop :=
  (∀ {W L A : Type} (action : CoreM W L A) (world : W),
    match action world with
    | none => (liftRuntime action).run world = none
    | some (.error failure) => (liftRuntime action).run world = some (.error failure)
    | some (.ok (value, after)) =>
        (liftRuntime action).run world = some (.ok (.ok value, after))) ∧
  (∀ {W L A : Type} (action : JuliaLean.base.range.JlX A) (world : W),
    (liftNative (W := W) (L := L) action).run world = some (.ok (action, world)))

/-- Independent native metadata laws. Length is the wrapped signed difference
plus one, even when overflow makes it nonpositive. Ordinal iteration returns
original endpoints first, advances by native wrapping one, and stops at the
stored last endpoint. All Int64 endpoints/states are quantified, including
empty and extreme representations; no callee law is assumed.
Sources: range794-804,935-943. -/
def NativeMetadataContract : Prop :=
  (∀ (range : JuliaLean.base.range.UnitRange (JInt .i64)),
    nativeLength range = .ok (JInt.lit .i64 (1 + range.stop.val - range.start.val))) ∧
  (∀ (range : JuliaLean.base.range.UnitRange (JInt .i64)),
    nativeIterate range none =
      if range.stop.val < range.start.val then .ok none
      else .ok (some (range.start, range.start))) ∧
  (∀ (range : JuliaLean.base.range.UnitRange (JInt .i64)) (state : JInt .i64),
    nativeIterate range (some state) =
      if state.val = range.stop.val then .ok none
      else .ok (some (JInt.lit .i64 (state.val + 1), JInt.lit .i64 (state.val + 1))))

/-- Closed-form body trace of the concrete native SIMD fold. The native colon
constructor empties descending ranges; otherwise the signed native length
may still wrap nonpositive. A positive count yields exactly that many body
calls, indexes start+k modulo Int64, and forwards each prior body result as
the next accumulator. There are no runtime calls for native range mechanics.
Both body failure channels, worlds and divergence remain observable. The
arbitrary body is a proof observer, not a public-model callback replacing a
broadcast loop. Sources: broadcast1050-1062; simdloop66-86. -/
def NativeFoldContract : Prop :=
  ∀ {W L : Type} (core : CoreOps (World W L) L)
      (start stop : JInt .i64) (seed tag : Value L)
      (values : Nat → Value L) (worlds : Nat → W) (initial : W)
      (history : List (ContextEvent L)) (suffix : List (Reply W L)),
    let count : Nat :=
      if start.val ≤ stop.val then (JInt.lit .i64 (1 + stop.val - start.val)).val.toNat
      else 0
    let action : M (World W L) L (Value L) :=
      nativeFold start stop seed (fun index state =>
        liftRuntime (observe false (.call tag [JuliaLean.base.boot.intV core index, state])))
    let events := (List.range count).map (fun (k : Nat) =>
      call false tag [JuliaLean.base.boot.intV core (JInt.lit .i64 (start.val + (k : Int))),
        if k = 0 then seed else values (k - 1)])
    if count = 0 then
      action.run ⟨initial, suffix, history⟩ = some (.ok (.ok seed, ⟨initial, suffix, history⟩))
    else Finishes action values worlds initial history suffix events (values (count - 1))

/-- Arbitrary native failures from the body of the concrete fold are not
reclassified or consumed as iterations. The first positive-length body sees
the first source index and preserves its supplied range exception/world.
The condition is the actual native range representation invariant for entry.
Source: broadcast1050-1062; simdloop66-86. -/
def NativeBodyFailureContract : Prop :=
  ∀ {W L S : Type} (start stop : JInt .i64) (state : S)
      (error : JuliaLean.base.range.Exc) (world : W),
    let count := (JInt.lit .i64 (1 + stop.val - start.val)).val
    start.val ≤ stop.val → 0 < count →
      (nativeFold (W := W) (L := L) start stop state
        (fun _ _ => liftNative (.error error))).run world =
          some (.ok (.error error, world))

/-- Full accumulation call provenance, including arbitrary conversion and
operator results. No promise forces conversion to Bool or UInt64: all five
actual reply objects are forwarded exactly, and the final or result is kept.
The source read, conversion, constructor, shift and or occur in that order.
Source: broadcast1051,1059,1066. -/
def AccumulationContract : Prop :=
  ∀ {W L : Type} (core : Bool → CoreOps (World W L) L) (bindings : Bindings L)
      (ready outer index previous : Value L) (shift : JInt .i64)
      (values : Nat → Value L) (worlds : Nat → W) (initial : W)
      (history : List (ContextEvent L)) (suffix : List (Reply W L)),
    let action := accumulate ((observeContexts core).inContext false) bindings
      ready outer index shift previous
    ReturnsLast action 5 values worlds
      [call false bindings.getindex [ready, index, outer],
       call false bindings.convert [JuliaLean.base.boot.coreV (core false) "Bool", values 0],
       call false (JuliaLean.base.boot.coreV (core false) "UInt64") [values 1],
       call false bindings.shiftLeft [values 2, JuliaLean.base.boot.intV (core false) shift],
       call false bindings.bitOr [previous, values 3]] initial history suffix

/-- Incrementing full-word bodies keep the actual + result as i, and mask the
native j independently of all user results. Final-range bodies increment only
the native bit counter and preserve the output chunk index. Every error before
completion retains its actual world and leaves the remaining operations alone.
Sources: broadcast1051,1059,1066-1067. -/
def BodyRegistersContract : Prop :=
  (∀ {W L : Type} (core : Bool → CoreOps (World W L) L) (bindings : Bindings L)
      (ready outer index previous : Value L) (j : JInt .i64)
      (values : Nat → Value L) (worlds : Nat → W) (initial : W)
      (history : List (ContextEvent L)) (suffix : List (Reply W L)),
    let current := (observeContexts core).inContext false
    Finishes (wordBody current bindings ready outer j (index, previous))
      values worlds initial history suffix
      [call false bindings.simd.add [index, JuliaLean.base.boot.intV (core false) (JInt.lit .i64 1)],
       call false bindings.getindex [ready, values 0, outer],
       call false bindings.convert [JuliaLean.base.boot.coreV (core false) "Bool", values 1],
       call false (JuliaLean.base.boot.coreV (core false) "UInt64") [values 2],
       call false bindings.shiftLeft [values 3, JuliaLean.base.boot.intV (core false)
         (JInt.lit .i64 (j.val % 64))],
       call false bindings.bitOr [previous, values 4]] (values 0, values 5)) ∧
  (∀ {W L : Type} (core : Bool → CoreOps (World W L) L) (bindings : Bindings L)
      (ready outer index : Value L) (state : State L)
      (values : Nat → Value L) (worlds : Nat → W) (initial : W)
      (history : List (ContextEvent L)) (suffix : List (Reply W L)),
    let current := (observeContexts core).inContext false
    let action := liftRuntime (remainingBody current bindings ready outer index state)
    Finishes action values worlds initial history suffix
      [call false bindings.getindex [ready, index, outer],
       call false bindings.convert [JuliaLean.base.boot.coreV (core false) "Bool", values 0],
       call false (JuliaLean.base.boot.coreV (core false) "UInt64") [values 1],
       call false bindings.shiftLeft [values 2, JuliaLean.base.boot.intV (core false)
         (JInt.lit .i64 (state.bitst.val % 64))],
       call false bindings.bitOr [state.remain, values 3]]
      { indc := state.indc, bitst := JInt.lit .i64 (state.bitst.val + 1), remain := values 4 })

/-- The full-chunk loop checks fresh last/subtraction/comparison before any
read or write. A false test preserves both lexical registers and current i.
All contexts and selected call failures remain arbitrary.
Source: broadcast1056-1063. -/
def FullWordGuardContract : Prop :=
  ∀ {W L : Type} (core : Bool → CoreOps (World W L) L) (bindings : Bindings L)
      (ready outer axis chunks index : Value L) (state : State L) (boundscheck : Bool)
      (values : Nat → Value L) (worlds : Nat → W) (initial : W)
      (history : List (ContextEvent L)) (suffix : List (Reply W L)),
    let action := fullWords (observeContexts core) bindings ready outer axis chunks index state boundscheck
    let events := [call boundscheck bindings.last [axis],
      call boundscheck bindings.subtract [values 0, JuliaLean.base.boot.intV (core boundscheck) (JInt.lit .i64 64)],
      call boundscheck bindings.lessEqual [index, values 1]]
    RuntimeFailurePrefixes action (successes 3 values worlds) events initial history suffix ∧
    ((match values 2 with | .leaf leaf => (core boundscheck).asBool leaf | _ => none) = some false →
      Finishes action values worlds initial history suffix events (index, state))

/-- A full chunk is a closed trace of 64 bits: every increment precedes its
read, each accumulator uses the preceding or result, and the chunk write is
performed once with the final or value at the wrapped next chunk index. The
next while test rereads last after that mutation. This independent fixed-size
trace checks the entire native inner loop without assuming reader/operator
laws, and preserves arbitrary failure worlds at every call.
Source: broadcast1056-1063. -/
def OneFullChunkContract : Prop :=
  ∀ {W L : Type} (core : Bool → CoreOps (World W L) L) (bindings : Bindings L)
      (ready outer axis chunks index : Value L) (state : State L) (boundscheck : Bool)
      (values : Nat → Value L) (worlds : Nat → W) (initial : W)
      (history : List (ContextEvent L)) (suffix : List (Reply W L)),
    let action := fullWords (observeContexts core) bindings ready outer axis chunks index state boundscheck
    let guardEvents := [call boundscheck bindings.last [axis],
      call boundscheck bindings.subtract [values 0, JuliaLean.base.boot.intV (core boundscheck) (JInt.lit .i64 64)],
      call boundscheck bindings.lessEqual [index, values 1]]
    let body := (List.range 64).flatMap (fun (k : Nat) =>
      let offset := 3 + 6 * k
      [call false bindings.simd.add [if k = 0 then index else values (offset - 6),
         JuliaLean.base.boot.intV (core false) (JInt.lit .i64 1)],
       call false bindings.getindex [ready, values offset, outer],
       call false bindings.convert [JuliaLean.base.boot.coreV (core false) "Bool", values (offset + 1)],
       call false (JuliaLean.base.boot.coreV (core false) "UInt64") [values (offset + 2)],
       call false bindings.shiftLeft [values (offset + 3),
         JuliaLean.base.boot.intV (core false) (JInt.lit .i64 (k : Int))],
       call false bindings.bitOr
         [if k = 0 then JuliaLean.base.boot.intV (core boundscheck) (JInt.lit .u64 0)
          else values (offset - 1), values (offset + 4)]])
    let nextChunk := JInt.lit .i64 (state.indc.val + 1)
    let events := guardEvents ++ body ++
      [call false bindings.setindex [chunks, values 386, JuliaLean.base.boot.intV (core false) nextChunk],
       call boundscheck bindings.last [axis],
       call boundscheck bindings.subtract [values 388, JuliaLean.base.boot.intV (core boundscheck) (JInt.lit .i64 64)],
       call boundscheck bindings.lessEqual [values 381, values 389]]
    (match values 2 with | .leaf leaf => (core boundscheck).asBool leaf | _ => none) = some true →
      RuntimeFailurePrefixes action (successes 391 values worlds) events initial history suffix ∧
      ((match values 390 with | .leaf leaf => (core boundscheck).asBool leaf | _ => none) = some false →
        Finishes action values worlds initial history suffix events
          (values 381, { state with indc := nextChunk }))

/-- Each row reads first(ax1) before subtracting one, and tests ndims(bc)==1
before length-based space arithmetic. The returned dimension value is never
replaced by type metadata; a second ndims read is required only after the
outer test succeeds. The prefix covers every register state and axis object.
Source: broadcast1047-1049. -/
def RowEntryContract : Prop :=
  ∀ {W L : Type} (core : Bool → CoreOps (World W L) L) (bindings : Bindings L)
      (bc ready axis chunks outer : Value L) (state : State L) (boundscheck : Bool)
      (values : Nat → Value L) (worlds : Nat → W) (initial : W)
      (history : List (ContextEvent L)) (suffix : List (Reply W L)),
    let action := row (observeContexts core) bindings bc ready axis chunks outer state boundscheck
    let events := [call boundscheck bindings.first [axis],
      call boundscheck bindings.subtract [values 0, JuliaLean.base.boot.intV (core boundscheck) (JInt.lit .i64 1)],
      call boundscheck bindings.ndims [bc],
      call boundscheck bindings.equal [values 2, JuliaLean.base.boot.intV (core boundscheck) (JInt.lit .i64 1)]]
    RuntimeFailurePrefixes action (successes 4 values worlds) events initial history suffix ∧
    (match (match values 3 with | .leaf leaf => (core boundscheck).asBool leaf | _ => none) with
    | some true => RuntimeFailurePrefixes action (successes 6 values worlds)
        (events ++ [call boundscheck bindings.ndims [bc],
          call boundscheck bindings.greater [values 4, JuliaLean.base.boot.intV (core boundscheck) (JInt.lit .i64 1)]])
        initial history suffix
    | some false => RuntimeFailurePrefixes action (successes 7 values worlds)
        (events ++ [call boundscheck bindings.length [axis],
          call boundscheck bindings.subtract [JuliaLean.base.boot.intV (core boundscheck) (JInt.lit .i64 64), values 4],
          call boundscheck bindings.greaterEqual [JuliaLean.base.boot.intV (core boundscheck) state.bitst, values 5]])
        initial history suffix
    | none => True)

/-- Outer exhaustion preserves all lexical registers without reading fields
or invoking a row. A nonempty iterate reply is destructured in field1/field2
order before the first axis operation of the row, retaining their real errors.
All supplied iterate objects and previous mutation states are admitted.
Source: broadcast1046-1069. -/
def OuterEntryContract : Prop :=
  ∀ {W L : Type} (core : Bool → CoreOps (World W L) L) (bindings : Bindings L)
      (bc ready axis chunks out next : Value L) (state : State L) (boundscheck : Bool)
      (values : Nat → Value L) (worlds : Nat → W) (initial : W)
      (history : List (ContextEvent L)) (suffix : List (Reply W L)),
    let action := outerLoop (observeContexts core) bindings bc ready axis chunks out next state boundscheck
    if (core boundscheck).same next (JuliaLean.base.boot.nothingV (core boundscheck)) then
      action.run ⟨initial, suffix, history⟩ = some (.ok (.ok state, ⟨initial, suffix, history⟩))
    else RuntimeFailurePrefixes action (successes 3 values worlds)
      [⟨boundscheck, .getfield next (JuliaLean.base.boot.intV (core boundscheck) (JInt.lit .i64 1))⟩,
       ⟨boundscheck, .getfield next (JuliaLean.base.boot.intV (core boundscheck) (JInt.lit .i64 2))⟩,
       call boundscheck bindings.first [axis]] initial history suffix

/-- Public initial branches retain actual chunked-copy results, original
scalar destination identity, source-before-destination mutation order, and
exact general setup through the first outer iterate. On actual exhaustion
that setup returns the destination with no chunk write. Every branch includes
all actual operation failures and worlds; non-Bool guards are additionally
covered by the arbitrary-depth error accounting below. The reused dimension
guard has its independent registered full short-circuit contract.
Source: broadcast1035-1046,1070-1073. -/
def EntryBranchesContract : Prop :=
  ∀ {W L : Type} (core : Bool → CoreOps (World W L) L) (bindings : Bindings L)
      (dest bc : Value L) (boundscheck : Bool)
      (values : Nat → Value L) (worlds : Nat → W) (initial : W)
      (history : List (ContextEvent L)) (suffix : List (Reply W L)),
    let action := copy (observeContexts core) bindings dest bc boundscheck
    let priorReplies := [call boundscheck bindings.axes [dest], call boundscheck bindings.axes [bc],
      call boundscheck bindings.equal [values 0, values 1]]
    RuntimeFailurePrefixes action (successes 3 values worlds) priorReplies initial history suffix ∧
    ((match values 2 with | .leaf leaf => (core boundscheck).asBool leaf | _ => none) = some true →
      let chunkedPrefix := priorReplies ++ [call boundscheck bindings.isChunked [dest, bc]]
      RuntimeFailurePrefixes action (successes 4 values worlds) chunkedPrefix initial history suffix ∧
      match (match values 3 with | .leaf leaf => (core boundscheck).asBool leaf | _ => none) with
      | some true => Finishes action values worlds initial history suffix
          (chunkedPrefix ++ [call boundscheck bindings.chunkedCopy [dest, bc]]) (values 4)
      | some false =>
          let scalarPrefix := chunkedPrefix ++ [call boundscheck bindings.ndims [dest],
            call boundscheck bindings.equal [values 4, JuliaLean.base.boot.intV (core boundscheck) (JInt.lit .i64 0)]]
          RuntimeFailurePrefixes action (successes 6 values worlds) scalarPrefix initial history suffix ∧
          match (match values 5 with | .leaf leaf => (core boundscheck).asBool leaf | _ => none) with
          | some true => Finishes action values worlds initial history suffix
              (scalarPrefix ++ [call boundscheck bindings.getindex [bc],
                call boundscheck bindings.setindex [dest, values 6]]) dest
          | some false =>
              let setup := scalarPrefix ++ [call boundscheck bindings.preprocess [dest, bc],
                call boundscheck bindings.axes [dest],
                call boundscheck bindings.getindex [values 7, JuliaLean.base.boot.intV (core boundscheck) (JInt.lit .i64 1)],
                call boundscheck bindings.tail [values 7],
                call boundscheck bindings.cartesianIndices [values 9],
                call boundscheck bindings.getproperty [dest, .symbol "chunks"],
                call boundscheck bindings.simd.iterate [values 10]]
              RuntimeFailurePrefixes action (successes 13 values worlds) setup initial history suffix ∧
              ((core boundscheck).same (values 12) (JuliaLean.base.boot.nothingV (core boundscheck)) = true →
                Finishes action values worlds initial history suffix setup dest)
          | none => True
      | none => True)

/-- Every depth of the ordinary outer, pending-bit, full-chunk and dynamic
SIMD loops retains the precise first failing runtime world. The only generated
runtime exception is conditional TypeError at an actually tested non-Bool
comparison/guard. Native range errors stay in their separate original channel,
with the world of the last successful runtime operation. On normal completion,
only the original destination or the actual chunked-copy return may escape.
No assumption restricts custom effects, successful result types or termination.
Source: broadcast1035-1073; simdloop66-86. -/
def OutcomeAccountingContract : Prop :=
  ∀ {W L : Type} (core : Bool → CoreOps (World W L) L) (bindings : Bindings L)
      (dest bc : Value L) (boundscheck : Bool) (initial : W)
      (history : List (ContextEvent L)) (replies : List (Reply W L)),
    match (copy (observeContexts core) bindings dest bc boundscheck).run ⟨initial, replies, history⟩ with
    | some (.error (error, after)) =>
        (∃ (priorReplies : List (Reply W L)) (payload : W) (events : List (ContextEvent L)),
          replies = priorReplies ++ [.thrown error payload] ++ after.replies ∧
          AllReturned priorReplies ∧ after.payload = payload ∧
          after.events = history ++ events ∧ events.length = priorReplies.length + 1) ∨
        (∃ (priorReplies : List (Reply W L)) (bad function : Value L) (arguments : List (Value L))
          (payload : W) (events : List (ContextEvent L)) (context : Bool),
          replies = priorReplies ++ [.returned bad payload] ++ after.replies ∧
          AllReturned priorReplies ∧ after.payload = payload ∧
          after.events = history ++ events ++ [call context function arguments] ∧
          events.length = priorReplies.length ∧
          (function = bindings.equal ∨ function = bindings.isChunked ∨
            function = bindings.greaterEqual ∨ function = bindings.greater ∨
            function = bindings.lessEqual ∨ function = bindings.simd.less) ∧
          (match bad with | .leaf leaf => (core context).asBool leaf = none | _ => True) ∧
          error = JuliaLean.base.boot.objV (core context) (.typeError (.symbol "if")
            (JuliaLean.base.boot.strV (core context) "")
            (JuliaLean.base.boot.coreV (core context) "Bool") bad))
    | some (.ok (.error _, after)) =>
        ∃ (priorReplies : List (Reply W L)) (events : List (ContextEvent L)),
          replies = priorReplies ++ after.replies ∧ AllReturned priorReplies ∧
          after.events = history ++ events ∧ events.length = priorReplies.length ∧
          (match priorReplies.getLast? with
          | none => after.payload = initial
          | some (.returned _ payload) => after.payload = payload
          | _ => False)
    | some (.ok (.ok returned, after)) =>
        returned = dest ∨
          ∃ (priorReplies : List (Reply W L)) (payload : W) (events : List (ContextEvent L)),
            replies = priorReplies ++ [.returned returned payload] ++ after.replies ∧
            AllReturned priorReplies ∧ after.payload = payload ∧
            after.events = history ++ events ++ [call boundscheck bindings.chunkedCopy [dest, bc]] ∧
            events.length = priorReplies.length
    | none => True

def RuntimeContract : Prop :=
  ExceptionLayerContract ∧ AccumulationContract ∧ BodyRegistersContract ∧
  FullWordGuardContract ∧ OneFullChunkContract ∧ RowEntryContract ∧ OuterEntryContract ∧
  EntryBranchesContract ∧ OutcomeAccountingContract ∧
  JuliaLean.Proofs.base.broadcast.Models2Group5.PlainCopy.AxesGuardObservations

def NativeSIMDContract : Prop :=
