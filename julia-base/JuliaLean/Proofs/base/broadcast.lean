namespace JuliaLean.ChatGPT.Batch11.Group12
namespace NonleafProofs

open JuliaLean
open JuliaLean.base.expr (Value)
open JuliaLean.base.boot (CoreOps CoreM)
open JuliaLean.base.broadcast.Models2Group5.NonleafCopy
open JuliaLean.Proofs.base.broadcast.Models2Group5.NonleafCopy
open JuliaLean.Proofs.base.broadcast.Models2Group5.ForwardObservations (Event Reply)
open JuliaLean.Proofs.base.broadcast.Models2Group5.IndexAccess.ContextObservations

theorem bind_apply {S L A B : Type} (action : CoreM S L A)
    (next : A → CoreM S L B) (world : S) :
    (action >>= next) world =
      match action world with
      | none => none
      | some (.error error) => some (.error error)
      | some (.ok (value, after)) => next value after := by
  change (Option.bind (action world) (fun result =>
    match result with
    | .error error => some (Except.error error)
    | .ok (value, after) => next value after)) = _
  cases action world with
  | none => rfl
  | some result =>
      cases result with
      | error error => rfl
      | ok pair =>
          cases pair
          rfl

theorem bind_pure_right {S L A : Type} (action : CoreM S L A) :
    (action >>= fun value => pure value) = action := by
  funext world
  rw [bind_apply]
  cases action world with
  | none => rfl
  | some result =>
      cases result with
      | error error => rfl
      | ok pair =>
          cases pair
          rfl

theorem observe_steps {W L : Type} (frame : Frame W L) :
    Steps (observe frame.event.boundscheck frame.event.event)
      [frame] (stop (.ok frame.value)) := by
  have expanded : step (W := W) frame.event (fun value => stop (.ok value)) =
      observe frame.event.boundscheck frame.event.event := by
    exact bind_pure_right _
  rw [← expanded]
  exact Steps.cons frame _ [] _ (Steps.nil _)

theorem steps_extend {W L : Type}
    {action residual : CoreM (World W L) L (Value L)}
    {frames : List (Frame W L)} (path : Steps action frames residual) :
    ∀ {last : CoreM (World W L) L (Value L)} {tail : List (Frame W L)},
      Steps residual tail last → Steps action (frames ++ tail) last := by
  induction path with
  | nil action =>
      intro last tail continuation
      exact continuation
  | cons frame next frames residual child ih =>
      intro last tail continuation
      exact Steps.cons frame next (frames ++ tail) last (ih continuation)

theorem steps_prefix_extend {W L : Type}
    {action residual : CoreM (World W L) L (Value L)}
    {frames : List (Frame W L)} (path : Steps action frames residual) :
    ∀ {tail : List (Frame W L)},
      Prefix residual tail → Prefix action (frames ++ tail) := by
  induction path with
  | nil action =>
      intro tail continuation
      exact continuation
  | cons frame next frames residual child ih =>
      intro tail continuation
      exact prefix_step frame next (frames ++ tail) (ih continuation)

theorem steps_trace {W L : Type}
    {action : CoreM (World W L) L (Value L)}
    {frames : List (Frame W L)} {returned : Value L}
    (path : Steps action frames (stop (.ok returned)))
    (plan : List (ContextEvent L)) (values : Nat → Value L)
    (worlds : Nat → W) (initial : W) (history : List (ContextEvent L))
    (suffix : List (Reply W L))
    (positive : 0 < plan.length)
    (scheduled : replies frames = successes plan.length values worlds)
    (observations : events frames = plan)
    (payload : finalPayload frames initial = worlds (plan.length - 1)) :
    Trace action plan values worlds initial history suffix returned := by
  refine ⟨positive, ?_, ?_⟩
  · simpa only [scheduled, observations, payload, stop] using
      steps_success path initial history suffix
  · simpa only [scheduled, observations] using
      steps_prefix path initial history suffix

/-- The exact selected-recursion suffix of the unchanged source body. -/
def chosenRestart {W L : Type} (ops : Ops W L) (bindings : Bindings L)
    (inputs : RestartInputs L) : CoreM W L (Value L) := do
  let core := ops.contexts.inContext true
  let method ← (show CoreM W L Selection from fun world =>
    some (.ok (ops.selectedRestart inputs world, world)))
  return ← match method with
  | .builtin => run ops bindings (.restart inputs)
  | .custom => core.call bindings.restart [inputs.newdest, inputs.dest, inputs.bc, inputs.value,
      inputs.index, inputs.iterator, inputs.state, inputs.count]

/-- The exact selected-copy suffix of the unchanged restart body. -/
def chosenCopy {W L : Type} (ops : Ops W L) (bindings : Bindings L)
    (inputs : CopyInputs L) : CoreM W L (Value L) := do
  let core := ops.contexts.inContext true
  let method ← (show CoreM W L Selection from fun world =>
    some (.ok (ops.selectedCopy inputs world, world)))
  return ← match method with
  | .builtin => run ops bindings (.copy inputs)
  | .custom => core.call bindings.copy [inputs.dest, inputs.bc, inputs.iterator, inputs.state, inputs.count]

/-- The source suffix after the actual value was read inbounds. -/
def afterRead {W L : Type} (ops : Ops W L) (bindings : Bindings L)
    (inputs : CopyInputs L) (elementType index nextState value : Value L) :
    CoreM W L (Value L) := do
  let core := ops.contexts.inContext true
  let unchecked := ops.contexts.inContext false
  let one := JuliaLean.base.boot.intV core (JInt.lit .i64 1)
  if ← JuliaLean.base.broadcast.Models2Group5.RuntimeTypes.checkedIsa core value elementType then
    let _ ← unchecked.call bindings.setindexBang [inputs.dest, value, index]
    let nextCount ← core.call bindings.add [inputs.count, one]
    run ops bindings (.loop {inputs with state := nextState, count := nextCount} elementType)
  else
    let widened ← core.call bindings.promoteTypejoin [elementType, .leaf (core.typeOf value)]
    let newdest ← core.call bindings.similar [inputs.bc, widened]
    chosenRestart ops bindings
      ⟨newdest, inputs.dest, inputs.bc, value, index, inputs.iterator, nextState, inputs.count⟩

theorem chosenRestart_custom {W L : Type}
    (core : Bool → CoreOps (World W L) L)
    (copySelect : CopyInputs L → W → Selection)
    (bindings : Bindings L) (inputs : RestartInputs L) :
    chosenRestart (instrument core copySelect (fun _ _ => .custom)) bindings inputs =
      observe true (.call bindings.restart
        [inputs.newdest, inputs.dest, inputs.bc, inputs.value, inputs.index,
         inputs.iterator, inputs.state, inputs.count]) := by
  unfold chosenRestart
  simp only [bind_pure_right] <;> rfl

theorem chosenRestart_builtin {W L : Type}
    (core : Bool → CoreOps (World W L) L)
    (copySelect : CopyInputs L → W → Selection)
    (bindings : Bindings L) (inputs : RestartInputs L) :
    chosenRestart (instrument core copySelect (fun _ _ => .builtin)) bindings inputs =
      run (instrument core copySelect (fun _ _ => .builtin)) bindings (.restart inputs) := by
  unfold chosenRestart
  simp only [bind_pure_right] <;> rfl

theorem chosenCopy_custom {W L : Type}
    (core : Bool → CoreOps (World W L) L)
    (restartSelect : RestartInputs L → W → Selection)
    (bindings : Bindings L) (inputs : CopyInputs L) :
    chosenCopy (instrument core (fun _ _ => .custom) restartSelect) bindings inputs =
      observe true (.call bindings.copy
        [inputs.dest, inputs.bc, inputs.iterator, inputs.state, inputs.count]) := by
  unfold chosenCopy
  simp only [bind_pure_right] <;> rfl

theorem copy_read_steps {W L : Type}
    (core : Bool → CoreOps (World W L) L)
    (copySelect : CopyInputs L → W → Selection)
    (restartSelect : RestartInputs L → W → Selection)
    (bindings : Bindings L) (dest bc iterator state count : Value L)
    (values : Nat → Value L) (worlds : Nat → W)
    (started : (core true).same (values 1)
      (JuliaLean.base.boot.nothingV (core true)) = false) :
    Steps (copy (instrument core copySelect restartSelect)
      bindings dest bc iterator state count)
      (copyFrames core bindings dest bc iterator state values worlds)
      (afterRead (instrument core copySelect restartSelect) bindings
        ⟨dest, bc, iterator, state, count⟩ (values 0) (values 3) (values 6) (values 7)) := by
  unfold copyFrames copy
  rw [run.eq_def]
  change Steps (step (call true bindings.eltype [dest]) _) _ _
  apply steps_cons
  rw [run.eq_def]
  change Steps (step (call true bindings.iterate [iterator, state]) _) _ _
  apply steps_cons
  change Steps (if (core true).same (values 1)
    (JuliaLean.base.boot.nothingV (core true)) then _ else _) _ _
  simp only [started, Bool.false_eq_true, ↓reduceIte]
  change Steps (step (call true bindings.indexedIterate
    [values 1, JuliaLean.base.boot.intV (core true) (JInt.lit .i64 1)]) _) _ _
  apply steps_cons
  change Steps (step ⟨true, .getfield (values 2)
    (JuliaLean.base.boot.intV (core true) (JInt.lit .i64 1))⟩ _) _ _
  apply steps_cons
  change Steps (step ⟨true, .getfield (values 2)
    (JuliaLean.base.boot.intV (core true) (JInt.lit .i64 2))⟩ _) _ _
  apply steps_cons
  change Steps (step (call true bindings.indexedIterate
    [values 1, JuliaLean.base.boot.intV (core true) (JInt.lit .i64 2), values 4]) _) _ _
  apply steps_cons
  change Steps (step ⟨true, .getfield (values 5)
    (JuliaLean.base.boot.intV (core true) (JInt.lit .i64 1))⟩ _) _ _
  apply steps_cons
  change Steps (step (call false bindings.getindex [bc, values 3]) _) _ _
  apply steps_cons
  exact Steps.nil _

theorem checkedIsa_valid {W L : Type}
    (core : Bool → CoreOps (World W L) L)
    (copySelect : CopyInputs L → W → Selection)
    (restartSelect : RestartInputs L → W → Selection)
    (value elementType : Value L)
    (valid : (core true).isa elementType (JuliaLean.base.boot.coreV (core true) "Type") = true) :
    JuliaLean.base.broadcast.Models2Group5.RuntimeTypes.checkedIsa
      ((instrument core copySelect restartSelect).contexts.inContext true) value elementType =
      (pure ((core true).isa value elementType) : CoreM (World W L) L Bool) := by
  change JuliaLean.base.broadcast.Models2Group5.RuntimeTypes.checkedIsa
    (core true) value elementType = _
  unfold JuliaLean.base.broadcast.Models2Group5.RuntimeTypes.checkedIsa
  simp only [valid, ↓reduceIte]

theorem afterRead_fits {W L : Type}
    (core : Bool → CoreOps (World W L) L)
    (copySelect : CopyInputs L → W → Selection)
    (restartSelect : RestartInputs L → W → Selection)
    (bindings : Bindings L) (inputs : CopyInputs L)
    (elementType index nextState value : Value L)
    (valid : (core true).isa elementType (JuliaLean.base.boot.coreV (core true) "Type") = true)
    (fits : (core true).isa value elementType = true) :
    afterRead (instrument core copySelect restartSelect) bindings inputs elementType index nextState value =
      step (call false bindings.setindexBang [inputs.dest, value, index]) (fun _ =>
        step (call true bindings.add
          [inputs.count, JuliaLean.base.boot.intV (core true) (JInt.lit .i64 1)]) (fun nextCount =>
            run (instrument core copySelect restartSelect) bindings
              (.loop {inputs with state := nextState, count := nextCount} elementType))) := by
  unfold afterRead
  dsimp only
  rw [checkedIsa_valid core copySelect restartSelect value elementType valid, fits] <;> rfl

theorem afterRead_widens {W L : Type}
    (core : Bool → CoreOps (World W L) L)
    (copySelect : CopyInputs L → W → Selection)
    (restartSelect : RestartInputs L → W → Selection)
    (bindings : Bindings L) (inputs : CopyInputs L)
    (elementType index nextState value : Value L)
    (valid : (core true).isa elementType (JuliaLean.base.boot.coreV (core true) "Type") = true)
    (fits : (core true).isa value elementType = false) :
    afterRead (instrument core copySelect restartSelect) bindings inputs elementType index nextState value =
      step (call true bindings.promoteTypejoin [elementType, .leaf ((core true).typeOf value)])
        (fun widened => step (call true bindings.similar [inputs.bc, widened]) (fun newdest =>
          chosenRestart (instrument core copySelect restartSelect) bindings
            ⟨newdest, inputs.dest, inputs.bc, value, index, inputs.iterator, nextState, inputs.count⟩)) := by
  unfold afterRead
  dsimp only
  rw [checkedIsa_valid core copySelect restartSelect value elementType valid, fits] <;> rfl

theorem afterRead_invalid {W L : Type}
    (core : Bool → CoreOps (World W L) L)
    (copySelect : CopyInputs L → W → Selection)
    (restartSelect : RestartInputs L → W → Selection)
    (bindings : Bindings L) (inputs : CopyInputs L)
    (elementType index nextState value : Value L)
    (invalid : (core true).isa elementType (JuliaLean.base.boot.coreV (core true) "Type") = false) :
    afterRead (instrument core copySelect restartSelect) bindings inputs elementType index nextState value =
      stop (.error (JuliaLean.base.boot.objV (core true) (.typeError (.symbol "isa")
        (JuliaLean.base.boot.strV (core true) "") (JuliaLean.base.boot.coreV (core true) "Type")
        elementType))) := by
  have checked : JuliaLean.base.broadcast.Models2Group5.RuntimeTypes.checkedIsa
      ((instrument core copySelect restartSelect).contexts.inContext true) value elementType =
      (show CoreM (World W L) L Bool from fun world => some (.error
        (JuliaLean.base.boot.objV (core true) (.typeError (.symbol "isa")
          (JuliaLean.base.boot.strV (core true) "") (JuliaLean.base.boot.coreV (core true) "Type")
          elementType), world))) := by
    change JuliaLean.base.broadcast.Models2Group5.RuntimeTypes.checkedIsa
      (core true) value elementType = _
    unfold JuliaLean.base.broadcast.Models2Group5.RuntimeTypes.checkedIsa
    simp only [invalid, Bool.false_eq_true, ↓reduceIte] <;> rfl
  unfold afterRead
  dsimp only
  rw [checked] <;> rfl

theorem prefix_observations {W L : Type}
    {action : CoreM (World W L) L (Value L)} {frames : List (Frame W L)}
    (path : Prefix action frames) (count : Nat) (values : Nat → Value L)
    (worlds : Nat → W) (plan : List (ContextEvent L))
    (initial : W) (history : List (ContextEvent L)) (suffix : List (Reply W L))
    (scheduled : replies frames = successes count values worlds)
    (observations : events frames = plan) :
    FailurePrefixes action (successes count values worlds) plan initial history suffix := by
  simpa only [scheduled, observations] using path initial history suffix

