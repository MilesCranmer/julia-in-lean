namespace JuliaLean.Proofs.base.broadcast.Models2Group5.Iteration

open JuliaLean
open JuliaLean.Registry
open JuliaLean.base.expr (Value)
open JuliaLean.base.boot (CoreOps)
open JuliaLean.base.broadcast.Models2Group5.Iteration
open JuliaLean.Proofs.base.broadcast.Models2Group5.ForwardObservations

/-- Instrument the actually requested compiler context only. The other
context retains arbitrary runtime behavior, so the universal contract can
detect a body that hard-codes the wrong context even if it otherwise issues
the right calls. This is proof instrumentation, not a model primitive. -/
def observingContext {W L : Type}
    (contexts : ContextOps (ProbeWorld W L) L) (boundscheck : Bool) :
    ContextOps (ProbeWorld W L) L where
  inContext := fun requested =>
    if requested = boundscheck then observingOps (contexts.inContext requested)
    else contexts.inContext requested

/-- Independent event specification for a nonexhausted iteration. The first
reply is the state iterator's output; the following observations destructure
it, read the Broadcasted value at its produced index, and only then read the
original state carrier's first item. No second implementation computes an
expected element or iterator state. Source: base/broadcast.jl:288-293;
base/tuple.jl:161-172; installed flfrontend.destructure2:59-66. -/
def stepEvents {W L : Type} (ops : CoreOps (ProbeWorld W L) L)
    (bindings : Bindings L) (bc s : Value L)
    (values : Fin 8 → Value L) : List (Event L) :=
  let one := JuliaLean.base.boot.intV ops (JInt.lit .i64 1)
  let two := JuliaLean.base.boot.intV ops (JInt.lit .i64 2)
  [.splat bindings.iterate [bindings.iterate, s],
   .call bindings.indexedIterate [values 0, one],
   .getfield (values 1) one,
   .getfield (values 1) two,
   .call bindings.indexedIterate [values 0, two, values 3],
   .getfield (values 4) one,
   .call bindings.getindex [bc, values 2],
   .call bindings.getindex [s, one]]

/-- Independent provenance of the returned pair: its element comes from the
Broadcasted read; its inner state retains the value of the original state
carrier's first item and the second destructured iterator result. It does not
store either temporary destructuring pair or reuse an old iterator state.
The installed tuple primitive preserves the exact leaf/reference values.
Source: base/broadcast.jl:292. -/
def stepResult {W L : Type} (ops : CoreOps (ProbeWorld W L) L)
    (values : Fin 8 → Value L) : Value L :=
  JuliaLean.base.boot.tupleV ops
    [values 6, JuliaLean.base.boot.tupleV ops [values 7, values 5]]

/-- Total observation contract for the generic stateful iteration method.
All Julia values, contexts, runtime operations, successful outcomes, error
values, worlds and divergence positions are quantified. For an exhausted
iterator the only call is its splatted iteration: no destructuring or indexing
occurs, and every later script entry remains untouched. For a nonexhausted
iterator there are exactly eight effectful observations and the result has
the independently specified tuple provenance. A thrown value at every
reachable position propagates unchanged with its precise world and trace
prefix; a diverging reachable operation remains divergent. Failures and
divergence in an unreachable script suffix do not prevent exhaustion.

The script is proof observation data, not a model argument or a law about a
callee. No input is restricted to native tuples, arrays, Int64 indices, or
successful custom dispatch. Both outcomes of the builtin identity test are
specified. A faulty model that omits/switches reads, loses custom state,
ignores propagation metadata, changes errors, or evaluates after exhaustion
violates a quantified observation. Source: base/broadcast.jl:288-293;
doc/src/manual/functions.md:394-409; devdocs/boundscheck.md:70-79. -/
def RuntimeContract : Prop :=
  ∀ {W L : Type} (contexts : ContextOps (ProbeWorld W L) L)
      (bindings : Bindings L) (bc s : Value L) (boundscheck : Bool)
      (values : Fin 8 → Value L) (worlds : Fin 8 → W)
      (initial : W) (history : List (Event L)) (suffix : List (Reply W L)),
    let ops := contexts.inContext boundscheck
    let action := iterateStep (observingContext contexts boundscheck)
      bindings bc s boundscheck
    let successful := successfulReplies 7 values worlds
    let prescribed := stepEvents ops bindings bc s values
    let exhausted := ops.same (values 0) (JuliaLean.base.boot.nothingV ops)
    let before : ProbeWorld W L := ⟨initial, successful ++ suffix, history⟩
    (if exhausted then
      let after : ProbeWorld W L :=
        ⟨worlds 0, successful.drop 1 ++ suffix,
          history ++ [.splat bindings.iterate [bindings.iterate, s]]⟩
      action before = some (.ok (JuliaLean.base.boot.nothingV ops, after))
    else
      let after : ProbeWorld W L := ⟨worlds 7, suffix, history ++ prescribed⟩
      action before = some (.ok (stepResult ops values, after))) ∧
    (∀ (position : Fin 8) (error : Value L) (failureWorld : W),
      let remaining := successful.drop (position.val + 1) ++ suffix
      let script := successful.take position.val ++ [.thrown error failureWorld] ++ remaining
      let failureBefore : ProbeWorld W L := ⟨initial, script, history⟩
      if position.val = 0 then
        let failureAfter : ProbeWorld W L :=
          ⟨failureWorld, remaining, history ++ prescribed.take 1⟩
        action failureBefore = some (.error (error, failureAfter))
      else if exhausted then
        let after : ProbeWorld W L :=
          ⟨worlds 0, script.drop 1,
            history ++ [.splat bindings.iterate [bindings.iterate, s]]⟩
        action failureBefore = some (.ok (JuliaLean.base.boot.nothingV ops, after))
      else
        let failureAfter : ProbeWorld W L :=
          ⟨failureWorld, remaining, history ++ prescribed.take (position.val + 1)⟩
        action failureBefore = some (.error (error, failureAfter))) ∧
    (∀ position : Fin 8,
      let script := successful.take position.val ++ [.diverged] ++
        successful.drop (position.val + 1) ++ suffix
      let divergenceBefore : ProbeWorld W L := ⟨initial, script, history⟩
      if position.val = 0 then
        action divergenceBefore = none
      else if exhausted then
        let after : ProbeWorld W L :=
          ⟨worlds 0, script.drop 1,
            history ++ [.splat bindings.iterate [bindings.iterate, s]]⟩
        action divergenceBefore = some (.ok (JuliaLean.base.boot.nothingV ops, after))
      else
        action divergenceBefore = none)

/-- Proposed entry for the group's entriesModels2Group5 aggregation. -/
def proposedEntries : List Entry := [
  { id := "broadcast-iterate-state-effects",
    juliaFile := "base/broadcast.jl",
    juliaFns := ["Base.iterate(bc::Broadcasted, s)"],
    statement := "Broadcasted iteration preserves its propagated bounds context and splats the original state. Exhaustion returns nothing before destructuring or indexing. Otherwise it destructures in source order, reads bc at the produced index before s[1], returns the new element and exact next-state components, and preserves every reachable exception, world change and divergence.",
    source := "base/broadcast.jl:288-293; base/tuple.jl:161-172; doc/src/manual/functions.md:394-409; doc/src/devdocs/boundscheck.md:70-79",
    status := .proven,
    prop := ``JuliaLean.Proofs.base.broadcast.Models2Group5.Iteration.RuntimeContract,
    thm := some `JuliaLean.Proofs.base.broadcast.Models2Group5.Iteration.RuntimeContract_proven,
    notes := "Full Value/CoreM input domain. Explicit context-selected existing CoreOps handles compiler bounds metadata without a shared interface change. Uses the already-installed destructure2 lowering order inline to avoid an unavailable extra import. All iterator/getindex operations selected on unfixed types remain open; primitive splatting/getfield/tuple creation use installed boundaries. No callee correctness assumptions or native-iterator restriction." }
]

end JuliaLean.Proofs.base.broadcast.Models2Group5.Iteration


namespace JuliaLean.Proofs.base.broadcast.Models2Group5.IteratorSize

open JuliaLean.Registry
