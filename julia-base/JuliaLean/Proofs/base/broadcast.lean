    thm := some ``JuliaLean.Proofs.base.broadcast.Models2Group5.Preprocessing.unaliasObservations_proved, notes := "Proves the full registered runtime contract, including every selected operation failure and divergence position, without callee correctness assumptions." },
  { id := "broadcast-preprocess-broadcasted-boundary", juliaFile := "base/broadcast.jl",
