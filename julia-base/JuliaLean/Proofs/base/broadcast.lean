/-- Only actual operation hooks are instrumented; both mutually recursive
selectors observe the payload world from all preceding source effects. -/
def observingPreprocess {W L : Type} (core : CoreOps (ProbeWorld W L) L)
    (selectPre : Value L → Value L → W → PreprocessMethod)
    (selectArgs : Value L → Value L → W → ArgumentsMethod) : Ops (ProbeWorld W L) L where
  toCoreOps := observingOps core
  selectedPreprocess := fun dest value world => selectPre dest value world.payload
  selectedArguments := fun dest value world => selectArgs dest value world.payload

/-- Self-identity is the sole source bypass for preventative alias handling.
It returns the original source and world without touching any queued effect;
the other route invokes exactly unalias(dest,source) and preserves its complete
arbitrary outcome, including failed copying and mutation before an exception.
Source: base/broadcast.jl:995-1002. -/
def UnaliasObservations : Prop :=
  ∀ {W L : Type} (core : CoreOps (ProbeWorld W L) L) (bindings : Bindings L)
      (dest source : Value L) (values : Nat → Value L) (worlds : Nat → W)
      (initial : W) (history : List (Event L)) (suffix : List (Reply W L)),
    let action := unalias (observingOps core) bindings dest source
    if core.same dest source then
      let before : ProbeWorld W L := ⟨initial, suffix, history⟩
      action before = some (.ok (source, before))
    else FollowsPlan action values worlds initial history suffix
      [.call bindings.unalias [dest, source]] (values 0)

/-- Fallback preprocessing unaliases before extruding the exact returned
object. It retains every allocation/reference, mutation world, error and
divergence, with no promise that either custom method returns its input.
Source: base/broadcast.jl:1008. -/
def FallbackObservations : Prop :=
  ∀ {W L : Type} (bindings : Bindings L) (dest value : Value L)
      (selectPre : Value L → Value L → W → PreprocessMethod)
      (selectArgs : Value L → Value L → W → ArgumentsMethod),
    ReturnsLastAfter (W := W) (L := L) 1
      (fun core => fallback
        { toCoreOps := core
          selectedPreprocess := fun dest value world => selectPre dest value world.payload
          selectedArguments := fun dest value world => selectArgs dest value world.payload }
        bindings dest value)
      (fun _ values _ _ =>
        [.call bindings.broadcastUnalias [dest, value], .call bindings.extrude [values 0]])

/-- Proof-only classification of successful consumed operation replies. -/
def AllReturned {W L : Type} (replies : List (Reply W L)) : Prop :=
  ∀ reply ∈ replies, ∃ (value : Value L) (world : W), reply = .returned value world

/-- A propagated error must come from the next actual operation after a fully
successful prefix. Its exact thrown object and world survive; later replies
are untouched and prior history is extended by exactly one event per consumed
operation. This does not prescribe a second preprocessing algorithm. -/
def RetainedError {W L : Type} (replies : List (Reply W L)) (history : List (Event L))
    (error : Value L) (after : ProbeWorld W L) : Prop :=
  ∃ (priorReplies : List (Reply W L)) (payload : W) (events : List (Event L)),
    replies = priorReplies ++ [.thrown error payload] ++ after.replies ∧
    AllReturned priorReplies ∧ after.payload = payload ∧
    after.events = history ++ events ∧ events.length = priorReplies.length + 1

/-- Select public wrappers where present, so contracts depend on their actual
model declarations as well as on the shared recursive source interpreter. -/
def entry {W L : Type} (ops : Ops W L) (bindings : Bindings L)
    (method : Method) (dest value : Value L) : CoreM W L (Value L) :=
  match method with
  | .broadcasted => broadcasted ops bindings dest value
  | .fallback => fallback ops bindings dest value
  | .arguments => arguments ops bindings dest value
  | .singleton => singleton ops bindings dest value
  | _ => run ops bindings method dest value

/-- Full-domain error provenance across arbitrary mutual-recursion depth,
custom tail/tree cycles and all selected branches. These bodies invent no
exception: every returned error is precisely an actual operation failure,
with the already-mutated world and unused effects retained. No premise says
that a recursive selector terminates, picks canonical Base, or returns a type
with a conventional representation. The finite reply list is proof metadata;
the model itself has no list/fuel bound. Source: broadcast1007-1012. -/
def RecursiveErrorAccounting : Prop :=
  ∀ {W L : Type} (core : CoreOps (ProbeWorld W L) L)
      (selectPre : Value L → Value L → W → PreprocessMethod)
      (selectArgs : Value L → Value L → W → ArgumentsMethod)
      (bindings : Bindings L) (method : Method) (dest value : Value L)
      (initial : W) (history : List (Event L)) (replies : List (Reply W L)),
    let action := entry (observingPreprocess core selectPre selectArgs) bindings method dest value
    match action ⟨initial, replies, history⟩ with
    | some (.error (error, after)) => RetainedError replies history error after
    | _ => True

/-- Final-boundary return identity, independent of intermediate algorithm.
No successful source operation may be skipped or replaced by its input. -/
def LastReplyReturned {W L : Type} (replies : List (Reply W L))
    (result : Value L) (after : ProbeWorld W L) : Prop :=
  ∃ (priorReplies : List (Reply W L)) (payload : W),
    replies = priorReplies ++ [.returned result payload] ++ after.replies ∧
    AllReturned priorReplies ∧ after.payload = payload

/-- Successful Broadcasted preprocessing preserves the early style/function
values through all nested argument work, then reads axes immediately before
the actual constructor. The constructor receives those exact style/function/
axes values; arbitrary nested processed arguments and constructor results stay
open. This mutation-sensitive outer-boundary invariant is independent of how
many recursive nodes or custom methods are visited between the two boundaries.
Source: base/broadcast.jl:1007. -/
def BroadcastedBoundaryObservations : Prop :=
  ∀ {W L : Type} (core : CoreOps (ProbeWorld W L) L)
      (selectPre : Value L → Value L → W → PreprocessMethod)
      (selectArgs : Value L → Value L → W → ArgumentsMethod)
      (bindings : Bindings L) (dest bc : Value L) (initial : W)
      (history : List (Event L)) (replies : List (Reply W L)),
    match broadcasted (observingPreprocess core selectPre selectArgs) bindings dest bc
        ⟨initial, replies, history⟩ with
    | some (.ok (result, after)) =>
        LastReplyReturned replies result after ∧
        ∃ (style function originalArgs processed axes : Value L)
          (styleWorld functionWorld argsWorld axesWorld returnWorld : W)
          (middleReplies : List (Reply W L)) (middleEvents : List (Event L)),
          replies = [.returned style styleWorld, .returned function functionWorld,
            .returned originalArgs argsWorld] ++ middleReplies ++
            [.returned axes axesWorld, .returned result returnWorld] ++ after.replies ∧
          AllReturned middleReplies ∧ middleReplies.length = middleEvents.length ∧
          after.events = history ++
            [.call bindings.getproperty [bc, .symbol "style"],
             .call bindings.getproperty [bc, .symbol "f"],
             .call bindings.getproperty [bc, .symbol "args"]] ++ middleEvents ++
            [.call bindings.getproperty [bc, .symbol "axes"],
             .call bindings.broadcasted [style, function, processed, axes]]
    | _ => True

/-- The generic tuple body starts with native-one indexing of the actual
original tuple and ends only through its actual tuple splat, with a singleton
container for the processed head followed by the processed tail object.
The splat's arbitrary returned value/world is retained. This shape/provenance
invariant admits every recursive/custom head and tail outcome without a
recursive evaluator or a tuple-returning callee law.
Source: base/broadcast.jl:1010. -/
def ArgumentsBoundaryObservations : Prop :=
  ∀ {W L : Type} (core : CoreOps (ProbeWorld W L) L)
      (selectPre : Value L → Value L → W → PreprocessMethod)
      (selectArgs : Value L → Value L → W → ArgumentsMethod)
      (bindings : Bindings L) (dest args : Value L) (initial : W)
      (history : List (Event L)) (replies : List (Reply W L)),
    match arguments (observingPreprocess core selectPre selectArgs) bindings dest args
        ⟨initial, replies, history⟩ with
    | some (.ok (result, after)) =>
        LastReplyReturned replies result after ∧
        ∃ (processedHead processedTail : Value L) (middle : List (Event L)),
          after.events = history ++
            [.call bindings.getindex [args, JuliaLean.base.boot.intV core (JInt.lit .i64 1)]] ++
            middle ++ [.splat bindings.iterate
              [JuliaLean.base.boot.coreV core "tuple",
               JuliaLean.base.boot.tupleV core [processedHead], processedTail]]
    | _ => True

/-- Singleton preprocessing performs its required first-index read and returns
one tuple slot containing a processed runtime value. It never substitutes an
unwrapped scalar, forced native-Int list, or runtime splat of that value.
Error behavior at any nested depth is covered separately by the common
registered error provenance invariant. Source: base/broadcast.jl:1011. -/
def SingletonPackaging : Prop :=
  ∀ {W L : Type} (core : CoreOps (ProbeWorld W L) L)
      (selectPre : Value L → Value L → W → PreprocessMethod)
      (selectArgs : Value L → Value L → W → ArgumentsMethod)
      (bindings : Bindings L) (dest args : Value L) (initial : W)
      (history : List (Event L)) (replies : List (Reply W L)),
    match singleton (observingPreprocess core selectPre selectArgs) bindings dest args
        ⟨initial, replies, history⟩ with
    | some (.ok (result, after)) =>
        ∃ (processed : Value L) (remaining : List (Event L)),
          result = JuliaLean.base.boot.tupleV core [processed] ∧
          after.events = history ++
            [.call bindings.getindex [args, JuliaLean.base.boot.intV core (JInt.lit .i64 1)]] ++
            remaining
    | _ => True

/-- The canonical empty tuple path is pure and preserves its exact input
world/reply stream; it cannot invoke a getter, alias copy or a custom head.
This separately checks the reused concrete base case of both recursions.
Source: base/broadcast.jl:1012. -/
def EmptyTuplePure : Prop :=
  ∀ {W L : Type} (ops : Ops W L) (bindings : Bindings L)
      (dest args : Value L) (world : W),
    run ops bindings .empty dest args world =
      some (.ok (JuliaLean.base.boot.tupleV ops.toCoreOps [], world))

def RecursiveContracts : Prop := RecursiveErrorAccounting ∧ EmptyTuplePure

private theorem unaliasObservations_proved : UnaliasObservations := by
  unfold UnaliasObservations
  intro W L core bindings dest source values worlds initial history suffix
  cases h : core.same dest source <;>
    simp [JuliaLean.base.broadcast.Models2Group5.Preprocessing.unalias,
      FollowsPlan, h, observingOps, observe, List.range_succ, bind, pure,
      List.append_assoc, Fin.forall_fin_succ]

private theorem fallbackObservations_proved : FallbackObservations := by
  unfold FallbackObservations ReturnsLastAfter
  intro W L bindings dest value selectPre selectArgs core values worlds initial history suffix
  simp only [JuliaLean.base.broadcast.Models2Group5.Preprocessing.fallback,
    JuliaLean.base.broadcast.Models2Group5.Preprocessing.run.eq_def]
  simp [successfulReplies, observingOps, observe, List.ofFn_succ, List.ofFn_zero,
    bind, pure, List.append_assoc, Fin.forall_fin_succ]

