        omega
      rcases cases with rfl | rfl | rfl <;> simp [successes, List.range_succ, construct, constructorContexts, observe, call, Bind.bind, Pure.pure, List.append_assoc]
theorem dotviewObservations : DotviewObservations := by
  unfold DotviewObservations
  intros
