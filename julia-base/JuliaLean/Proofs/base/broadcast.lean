namespace JuliaLean.Proofs.base.broadcast.Models2Group5.Similar

open JuliaLean.Registry
open JuliaLean.base.expr (Value)
open JuliaLean.base.boot (CoreM)
open JuliaLean.base.broadcast

/-- Proof-side observations of the actual wrapper, element type, dimensions
and incoming world at each selected call. These observations do not occur in
the Julia model and are not Julia arrays. -/
inductive Event (W S F A X T D : Type) where
  | axes (bc : Lazy.Broadcasted S F A X) (before : W)
  | similar (bc : Lazy.Broadcasted S F A X) (elementType : T) (dims : D) (before : W)

/-- Arbitrary successful, throwing or divergent selected-call outcome. -/
inductive Reply (W L V : Type) where
  | returned (value : V) (world : W)
  | thrown (error : Value L) (world : W)
  | diverged

/-- The arbitrary runtime payload and a finite proof-side observation list. -/
structure ProbeWorld (W E : Type) where
  payload : W
  events : List E

abbrev LogWorld (W S F A X T D : Type) :=
  ProbeWorld W (Event W S F A X T D)

/-- Observe a selected operation, including its incoming state. Its reply is
arbitrary data, not a callee-correctness premise. The observation preserves the
exact returned value, thrown value, outgoing world or divergence. -/
def observeReply {W L V E : Type} (event : W → E) (reply : Reply W L V) :
    CoreM (ProbeWorld W E) L V := fun world =>
  match reply with
  | .returned value payload =>
      some (.ok (value, ⟨payload, world.events ++ [event world.payload]⟩))
  | .thrown error payload =>
      some (.error (error, ⟨payload, world.events ++ [event world.payload]⟩))
  | .diverged => none

/-- Observation of the axes call on its actual argument. -/
def axesObserver {W L S F A X T D : Type} (reply : Reply W L D)
    (bc : Lazy.Broadcasted S F A X) : CoreM (LogWorld W S F A X T D) L D :=
  observeReply (fun world => .axes bc world) reply

/-- Observation of the three-argument similar call on its actual arguments. -/
def similarObserver {W L S F A X T D R : Type} (reply : Reply W L R)
    (bc : Lazy.Broadcasted S F A X) (elementType : T) (dims : D) :
    CoreM (LogWorld W S F A X T D) L R :=
  observeReply (fun world => .similar bc elementType dims world) reply

/-- On arbitrary successful selected-call outcomes, allocation observes axes
once on the original wrapper, forwards those exact dimensions with the same
wrapper and element type, and returns the selected allocator's actual result.
The second call sees exactly the world produced by the first call. No
assumption constrains either returned value or world. A wrong wrapper, type,
dimension, call count, call order, result or state transfer falsifies this
observation contract. Source: base/broadcast.jl:229. -/
def SuccessfulForwarding : Prop :=
  ∀ {W L S F A X T D R : Type}
      (bc : Lazy.Broadcasted S F A X) (elementType : T)
      (dims : D) (result : R) (initial axesWorld allocationWorld : W)
      (history : List (Event W S F A X T D)),
    let before : LogWorld W S F A X T D := ⟨initial, history⟩
    let after : LogWorld W S F A X T D :=
      ⟨allocationWorld,
        history ++ [.axes bc initial, .similar bc elementType dims axesWorld]⟩
    Lazy.m229 (m := CoreM (LogWorld W S F A X T D) L)
      (axesObserver (T := T) (.returned dims axesWorld))
      (similarObserver (.returned result allocationWorld)) bc elementType before =
      some (.ok (result, after))

/-- An axes exception is propagated unchanged with the exact world at the
throw and one axes observation. The allocator is arbitrary, including possible
mutation, throws and divergence, and cannot affect the execution because it
is never reached. This quantifies every exception value, wrapper, element
type and world without an axes-success premise.
Source: base/broadcast.jl:229 (exception sequencing invariant). -/
def AxesFailureSuppressesAllocation : Prop :=
  ∀ {W L S F A X T D R : Type}
      (bc : Lazy.Broadcasted S F A X) (elementType : T)
      (allocator : Lazy.Broadcasted S F A X → T → D →
        CoreM (LogWorld W S F A X T D) L R)
      (initial failureWorld : W) (error : Value L)
      (history : List (Event W S F A X T D)),
    let before : LogWorld W S F A X T D := ⟨initial, history⟩
    let after : LogWorld W S F A X T D :=
      ⟨failureWorld, history ++ [.axes bc initial]⟩
    Lazy.m229 (m := CoreM (LogWorld W S F A X T D) L)
      (axesObserver (T := T) (.thrown error failureWorld))
      allocator bc elementType before = some (.error (error, after))

/-- Divergent axes discovery remains divergent for every possible allocator;
allocation cannot recover from it or substitute stored dimensions.
Source: base/broadcast.jl:229. -/
def AxesDivergenceSuppressesAllocation : Prop :=
  ∀ {W L S F A X T D R : Type}
      (bc : Lazy.Broadcasted S F A X) (elementType : T)
      (allocator : Lazy.Broadcasted S F A X → T → D →
        CoreM (LogWorld W S F A X T D) L R)
      (initial : W) (history : List (Event W S F A X T D)),
    let before : LogWorld W S F A X T D := ⟨initial, history⟩
    Lazy.m229 (m := CoreM (LogWorld W S F A X T D) L)
      (axesObserver (T := T) .diverged)
      allocator bc elementType before = none

/-- An allocator exception follows exactly one successful axes observation,
receives the dimensions and world actually returned by that call, and retains
its own exact error value and world. Neither dimensions nor error results are
restricted to any native array or indexing convention.
Source: base/broadcast.jl:229. -/
def AllocationFailurePreservesEffects : Prop :=
  ∀ {W L S F A X T D R : Type}
      (bc : Lazy.Broadcasted S F A X) (elementType : T) (dims : D)
      (initial axesWorld failureWorld : W) (error : Value L)
      (history : List (Event W S F A X T D)),
    let before : LogWorld W S F A X T D := ⟨initial, history⟩
    let after : LogWorld W S F A X T D :=
      ⟨failureWorld,
        history ++ [.axes bc initial, .similar bc elementType dims axesWorld]⟩
    Lazy.m229 (m := CoreM (LogWorld W S F A X T D) L)
      (axesObserver (T := T) (.returned dims axesWorld))
      (similarObserver (R := R) (.thrown error failureWorld)) bc elementType before =
      some (.error (error, after))

/-- A divergent allocator remains divergent after arbitrary axes discovery
results and effects. Source: base/broadcast.jl:229. -/
def AllocationDivergencePreserved : Prop :=
  ∀ {W L S F A X T D R : Type}
      (bc : Lazy.Broadcasted S F A X) (elementType : T) (dims : D)
      (initial axesWorld : W) (history : List (Event W S F A X T D)),
    let before : LogWorld W S F A X T D := ⟨initial, history⟩
    Lazy.m229 (m := CoreM (LogWorld W S F A X T D) L)
      (axesObserver (T := T) (.returned dims axesWorld))
      (similarObserver (R := R) .diverged) bc elementType before = none

/-- Complete operation-observation invariant for the installed two-argument
similar method. The callbacks remain dispatch-selected operations on the
unspecified Broadcasted type parameters and element type. Success, throws,
divergence, incoming worlds, returned worlds and arbitrary error values are
covered; no callee correctness law is supplied. -/
def RuntimeContract : Prop :=
  SuccessfulForwarding ∧ AxesFailureSuppressesAllocation ∧
    AxesDivergenceSuppressesAllocation ∧ AllocationFailurePreservesEffects ∧
    AllocationDivergencePreserved

/-- Proposed entry for the group's single entriesModels2Group5 list. -/
theorem RuntimeContract_proven : RuntimeContract := by
  unfold RuntimeContract
  refine ⟨?_, ?_, ?_, ?_, ?_⟩
  all_goals first
    | unfold SuccessfulForwarding
    | unfold AxesFailureSuppressesAllocation
    | unfold AxesDivergenceSuppressesAllocation
    | unfold AllocationFailurePreservesEffects
    | unfold AllocationDivergencePreserved
  all_goals repeat intro
  all_goals simp +zetaDelta [JuliaLean.base.broadcast.Lazy.m229, axesObserver, similarObserver, observeReply, bind, List.append_assoc]

def proposedEntries : List Entry := [
  { id := "broadcast-similar-axes-allocation-effects",
    juliaFile := "base/broadcast.jl",
    juliaFns := ["Base.similar(bc::Broadcasted, ::Type{T}) where {T}"],
    statement := "Two-argument similar observes axes exactly once before allocation, forwards the original wrapper, element type and exact dimensions, threads the axes call's world into allocation, returns its actual result, and preserves throws and divergence. Axes failure prevents every possible allocator effect.",
    source := "base/broadcast.jl:229; doc/src/manual/interfaces.md:459-478,544-555 (broadcast allocation interface and source-order invariant)",
    status := .proven,
    prop := ``JuliaLean.Proofs.base.broadcast.Models2Group5.Similar.RuntimeContract,
    thm := some ``JuliaLean.Proofs.base.broadcast.Models2Group5.Similar.RuntimeContract_proven,
    notes := "Reuses the unchanged JuliaLean.base.broadcast.Lazy.m229. The packet's dispatch-parameter rule permits its axes and three-argument similar callees because the source signature leaves relevant type parameters open. Arbitrary CoreM results, exceptions, divergence, worlds and nonstandard dimensions are covered. Scripted observations are proof-side specifications, not model callbacks with assumed correctness. " }
]

end JuliaLean.Proofs.base.broadcast.Models2Group5.Similar


namespace JuliaLean.Proofs.base.broadcast.Models2Group5.ForwardObservations

open JuliaLean.base.expr (Value Sym)
open JuliaLean.base.boot (CoreOps CoreM)

/-!
Proof-observation support for independent source-call ordering invariants.
None of the definitions in this namespace is a model algorithm or a new
runtime primitive. Scripted replies impose no callee-correctness law: every
returned value, error, world, and divergence position is universally variable.
The finite lists below are proof records, not modelled Julia arrays/tuples.
-/

/-- Observable uses of the existing CoreOps operations. For splat the first
field is the iterator function supplied to _apply_iterate; the second is its
remaining argument list [target, containers...]. It is not a list containing
only containers, and the target is not the first field. -/
inductive Event (L : Type) where
  | call (function : Value L) (arguments : List (Value L))
  | applyType (constructor : Value L) (parameters : List (Value L))
  | splat (iterate : Value L) (arguments : List (Value L))
  | newObject (type : Value L) (fields : List (Value L))
  | fieldtype (type : Value L) (field : Sym)
  | getfield (object field : Value L)
  /-- A selected source-level call with explicit keyword names and values.
  This is proof observation data; it introduces no runtime primitive. -/
  | keywordCall (function : Value L) (positional : List (Value L))
      (keywords : List (Sym × Value L))

/-- One arbitrary operation outcome with the runtime world at its return or
throw. A diverging operation returns no world in the installed CoreM model. -/
inductive Reply (W L : Type) where
  | returned (value : Value L) (world : W)
  | thrown (error : Value L) (world : W)
  | diverged

/-- Runtime payload together with proof-only remaining observations and
prior observations. Every initial payload and history is admitted. -/
structure ProbeWorld (W L : Type) where
  payload : W
  replies : List (Reply W L)
  events : List (Event L)

/-- Observe one operation while retaining arbitrary returned values,
exception identities and worlds. No available reply is interpreted as
divergence, never as a default Julia value. -/
def observe {W L : Type} (event : Event L) :
    CoreM (ProbeWorld W L) L (Value L) := fun world =>
  match world.replies with
  | [] => none
  | .diverged :: _ => none
  | .returned value payload :: remaining =>
      some (.ok (value, ⟨payload, remaining, world.events ++ [event]⟩))
  | .thrown error payload :: remaining =>
      some (.error (error, ⟨payload, remaining, world.events ++ [event]⟩))

/-- Instrument the named effectful runtime hooks only. All other operations,
including builtin type/identity observations, remain independently arbitrary
fields of the supplied existing interface. A model receives no prescribed
trace or successful outcome as an argument. -/
def observingOps {W L : Type} (ops : CoreOps (ProbeWorld W L) L) :
    CoreOps (ProbeWorld W L) L :=
  { ops with
    call := fun function arguments => observe (.call function arguments)
    applyType := fun constructor parameters => observe (.applyType constructor parameters)
    applyIterate := fun iterate arguments => observe (.splat iterate arguments)
    new := fun type fields => observe (.newObject type fields)
    fieldtype := fun type field => observe (.fieldtype type field)
    getfield := fun object field => observe (.getfield object field) }

/-- k+1 success observations ensure an actual last operation even when k=0.
The finite-index bound is proof instrumentation, not Julia arithmetic. -/
def successfulReplies {W L : Type} (k : Nat)
    (values : Fin (k + 1) → Value L) (worlds : Fin (k + 1) → W) :
    List (Reply W L) :=
  List.ofFn (fun i => .returned (values i) (worlds i))

/-- A model supplied with an existing runtime interface. -/
abbrev Action (W L : Type) :=
  CoreOps (ProbeWorld W L) L → CoreM (ProbeWorld W L) L (Value L)

/-- Independently prescribed observations may use immutable builtin metadata,
prior arbitrary runtime values/worlds, and the original world. They must be
written as source event lists, not computed by running a second model body. -/
abbrev Expected (W L : Type) (k : Nat) :=
  CoreOps (ProbeWorld W L) L →
    (Fin (k + 1) → Value L) → (Fin (k + 1) → W) → W → List (Event L)

/-- Full-domain forwarding invariant for k+1 source operations. Successful
execution makes exactly the prescribed observations and returns the actual
last reply without changing it. Failure at every position preserves the exact
thrown value and world, records precisely the prefix through the throwing
operation, and leaves every later reply unused. Divergence at every position
remains divergence after arbitrary successful prefixes.

The arbitrary suffix detects extra operations; the remaining successful
replies detect premature return. No premise requires a callee to be correct,
return a particular type, succeed, or terminate. The prescribed list must have
exactly k+1 events as a conclusion, not a premise. k=0 means one operation and
never constructs Fin 0. CoreM gives divergence no returned trace; finite
prefixes are observed by the successful and throwing members of the same
universally quantified script family.

For example, a two-call source body uses k=1, and an expected list such as
[.call first [input], .call second [values 0]], with the fixed source bindings
and original input captured in the caller's property. This is an observation
contract, not a semantic implementation of either callee. -/
def ReturnsLastAfter {W L : Type} (k : Nat)
    (action : Action W L) (expected : Expected W L k) : Prop :=
  ∀ (ops : CoreOps (ProbeWorld W L) L)
    (values : Fin (k + 1) → Value L) (worlds : Fin (k + 1) → W)
    (initial : W) (history : List (Event L)) (suffix : List (Reply W L)),
    let successful := successfulReplies k values worlds
    let prescribed := expected ops values worlds initial
    let before : ProbeWorld W L := ⟨initial, successful ++ suffix, history⟩
    let after : ProbeWorld W L :=
      ⟨worlds (Fin.last k), suffix, history ++ prescribed⟩
    prescribed.length = k + 1 ∧
    action (observingOps ops) before = some (.ok (values (Fin.last k), after)) ∧
    (∀ (position : Fin (k + 1)) (error : Value L) (failureWorld : W),
      let remaining := successful.drop (position.val + 1) ++ suffix
      let failureBefore : ProbeWorld W L :=
        ⟨initial, successful.take position.val ++
          [.thrown error failureWorld] ++ remaining, history⟩
      let failureAfter : ProbeWorld W L :=
        ⟨failureWorld, remaining, history ++ prescribed.take (position.val + 1)⟩
      action (observingOps ops) failureBefore = some (.error (error, failureAfter))) ∧
    (∀ position : Fin (k + 1),
      let divergenceBefore : ProbeWorld W L :=
        ⟨initial, successful.take position.val ++ [.diverged] ++
          successful.drop (position.val + 1) ++ suffix, history⟩
      action (observingOps ops) divergenceBefore = none)

end JuliaLean.Proofs.base.broadcast.Models2Group5.ForwardObservations


namespace JuliaLean.Proofs.base.broadcast.Models2Group5.ShortCircuit

open JuliaLean.Registry
open JuliaLean.base.expr (Value)
open JuliaLean.base.boot (CoreOps CoreM)
open JuliaLean.base.broadcast.Models2Group5.ShortCircuit

/-- Independent truth-table/operand-identity and complete arity contract.
The Boolean implications partition every actual first-operand classification;
no callee law or success restriction is assumed. Non-Bool errors name the
original first operand, while wrong arities name the entire actual tuple and
nominal function with current world age. Source: base/broadcast.jl:196,207;
doc/src/manual/control-flow.md:377-395. -/
def ApplicationLaw {W L : Type} (core : CoreOps W L) (bindings : Bindings L)
    (name : ClosureName)
    (arguments : JuliaLean.base.broadcast.Models2Group5.Constructors.ArgumentTuple L)
    (world : W) (outcome : Option (Except (Value L × W) (Value L × W))) : Prop :=
  match arguments.values with
  | [left, right] =>
      let flag := match left with | .leaf value => core.asBool value | _ => none
      (flag = some false → outcome = some (.ok
        ((match name with | .conjunction => left | .disjunction => right), world))) ∧
      (flag = some true → outcome = some (.ok
        ((match name with | .conjunction => right | .disjunction => left), world))) ∧
      (flag = none → outcome = some (.error
        (JuliaLean.base.boot.objV core (.typeError (.symbol "if")
          (JuliaLean.base.boot.strV core "") (JuliaLean.base.boot.coreV core "Bool") left), world)))
  | _ =>
      match core.worldAge world with
      | none => outcome = none
      | some (.error (error, after)) => outcome = some (.error (error, after))
      | some (.ok (age, after)) => outcome = some (.error
          (JuliaLean.base.boot.objV core (.methodError (bindings.functionValue name)
            (JuliaLean.base.boot.tupleV core arguments.values)
            (JuliaLean.base.boot.intV core age)), after))

/-- Source callable identity and its independent full-domain application law.
This checks both nominal singleton identity and actual executable body. -/
def CallableRuntime (name : ClosureName) : Prop :=
  ∀ {W L : Type} (core : CoreOps W L) (bindings : Bindings L)
      (arguments : JuliaLean.base.broadcast.Models2Group5.Constructors.ArgumentTuple L)
      (world : W),
    let function := closure core bindings name
    function.name = name ∧ function.value = bindings.functionValue name ∧
      ApplicationLaw core bindings name arguments world (function.invoke arguments world)

/-- Proof-side selection of the public source entry under test. -/
def entry {W L : Type} (name : ClosureName) (ops : Ops W L) (bindings : Bindings L)
    (left right : Value L) : CoreM W L (Value L) :=
  match name with
  | .conjunction => broadcastAnd ops bindings left right
  | .disjunction => broadcastOr ops bindings left right

/-- A source adapter emits exactly one actual selected invocation with its
original argument identities and nominal function. All runtime replies,
errors, mutation worlds and divergence are unrestricted. -/
def ForwardRuntime (name : ClosureName) : Prop :=
  ∀ {W L : Type} (bindings : Bindings L) (left right : Value L),
    JuliaLean.Proofs.base.broadcast.Models2Group5.ForwardObservations.ReturnsLastAfter
      (W := W) (L := L) 0
      (fun core => entry name
        { toCoreOps := core
          broadcasted := fun function left right =>
            core.call bindings.broadcasted [function.value, left, right] }
        bindings left right)
      (fun _ _ _ _ => [.call bindings.broadcasted
        [bindings.functionValue name, left, right]])

/-- An actual selected callee can invoke the received callable at any native
arity, independent of the outer broadcast operands. This catches a wrong or
incomplete executable callable even when its nominal identity is right.
The chosen callee is one universally tested runtime instantiation, not a law
required of other callees. -/
def PassedCallableRuntime (name : ClosureName) : Prop :=
  ∀ {W L : Type} (core : CoreOps W L) (bindings : Bindings L)
      (arguments : JuliaLean.base.broadcast.Models2Group5.Constructors.ArgumentTuple L)
      (left right : Value L) (world : W),
    let ops : Ops W L :=
      { toCoreOps := core
        broadcasted := fun function _ _ => function.invoke arguments }
    ApplicationLaw core bindings name arguments world
      (entry name ops bindings left right world)

def AndBroadcastPreservesCall : Prop :=
  CallableRuntime .conjunction ∧ ForwardRuntime .conjunction ∧ PassedCallableRuntime .conjunction

def OrBroadcastPreservesCall : Prop :=
  CallableRuntime .disjunction ∧ ForwardRuntime .disjunction ∧ PassedCallableRuntime .disjunction

def entryProposals : List Entry := [
  { id := "broadcast-andand-callable-effects", juliaFile := "base/broadcast.jl",
    juliaFns := ["broadcasted(::AndAnd, a, b)"],
    statement := "AndAnd forwards original operands once with its complete nominal conjunction callable. That callable preserves the chosen operand under the Boolean truth table, raises the exact non-Bool TypeError, and rejects every other native-bounded arity with the actual function/tuple/world-age MethodError. Selected dispatch may invoke the real body; every runtime outcome/world is retained.",
    source := "base/broadcast.jl:196; doc/src/manual/control-flow.md:377-395", status := .proven,
    prop := ``JuliaLean.Proofs.base.broadcast.Models2Group5.ShortCircuit.AndBroadcastPreservesCall,
    thm := some `JuliaLean.Proofs.base.broadcast.Models2Group5.ShortCircuit.AndBroadcastPreservesCall_proven, notes := "Full Value/CoreM and all-arity callable representation, no callee laws or opaque scalar body. Independent truth-table, identity, dispatch-outcome and actual-passed-callable contracts cover binary and closure helpers. All argument counts and runtime outcomes are proved." },
  { id := "broadcast-oror-callable-effects", juliaFile := "base/broadcast.jl",
    juliaFns := ["broadcasted(::OrOr, a, b)"],
    statement := "OrOr forwards original operands once with its complete nominal disjunction callable. That callable preserves the chosen operand under the Boolean truth table, raises the exact non-Bool TypeError, and rejects every other native-bounded arity with the actual function/tuple/world-age MethodError. Selected dispatch may invoke the real body; every runtime outcome/world is retained.",
    source := "base/broadcast.jl:207; doc/src/manual/control-flow.md:377-395", status := .proven,
    prop := ``JuliaLean.Proofs.base.broadcast.Models2Group5.ShortCircuit.OrBroadcastPreservesCall,
    thm := some `JuliaLean.Proofs.base.broadcast.Models2Group5.ShortCircuit.OrBroadcastPreservesCall_proven, notes := "Full Value/CoreM and all-arity callable representation, no callee laws or opaque scalar body. Independent truth-table, identity, dispatch-outcome and actual-passed-callable contracts cover binary and closure helpers. All argument counts and runtime outcomes are proved." }
]

end JuliaLean.Proofs.base.broadcast.Models2Group5.ShortCircuit


namespace JuliaLean.Proofs.base.broadcast.Models2Group5.Forward

open JuliaLean
open JuliaLean.Registry
open JuliaLean.base.expr (Value)
open JuliaLean.base.boot (CoreOps CoreM)
open JuliaLean.base.broadcast.Models2Group5.Forward (Bindings)
open JuliaLean.Proofs.base.broadcast.Models2Group5.ForwardObservations

/-!
Independent full-domain call-observation invariants. A prescribed trace records
source arguments and actual returned values; it does not implement any callee.
The shared observation contract includes success, every failure position,
divergence, arbitrary worlds, and arbitrary unused effects after termination.
Runtime Values include reference leaves and nonstandard axes or iterator
objects. Signature restrictions are the same trusted dispatch restrictions as
in the installed Core models; no user-dispatch correctness law is assumed.
-/

/-- The DefaultArrayStyle Boolean adapter passes the unchanged, unrestricted dims value to similar with exactly the BitArray binding. It preserves every selected result, thrown value, runtime world and divergence.
This is an independent argument-identity, operation-count and effect-order
invariant over all selected callees, not a law assumed about their results.
