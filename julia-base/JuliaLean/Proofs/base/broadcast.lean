theorem vectorCustomEquation {W L : Type}
    (other : JuliaLean.base.broadcast.Models2Group5.Iteration.ContextOps (ProbeWorld W L) L)
    (core : CoreOps (ProbeWorld W L) L) (bindings : Bindings L)
    (index chunks : Value L) (tail : Tail L) (boundscheck : Bool) :
    vector (customOps other core boundscheck) bindings index chunks tail boundscheck =
      (do let first ← core.call bindings.getindex [chunks, index]
          let suffix ← core.call bindings.ithchunk (index :: tail.values)
          core.applyIterate bindings.iterate
            [JuliaLean.base.boot.coreV core "tuple", JuliaLean.base.boot.tupleV core [first], suffix]) := by
  unfold vector
  change
    (do let first ← ((customOps other core boundscheck).contexts.inContext boundscheck).call
                      bindings.getindex [chunks, index]
        let suffix ← run (customOps other core boundscheck) bindings boundscheck none index tail.values
        ((customOps other core boundscheck).contexts.inContext boundscheck).applyIterate
          bindings.iterate
          [JuliaLean.base.boot.coreV ((customOps other core boundscheck).contexts.inContext boundscheck) "tuple",
           JuliaLean.base.boot.tupleV ((customOps other core boundscheck).contexts.inContext boundscheck) [first], suffix]) = _
  rw [IndexChunkProofs.runCustomSuffix]
  cases boundscheck <;> rfl

theorem scalarCustomEquation {W L : Type}
    (other : JuliaLean.base.broadcast.Models2Group5.Iteration.ContextOps (ProbeWorld W L) L)
    (core : CoreOps (ProbeWorld W L) L) (bindings : Bindings L)
    (index : Value L) (word : JInt .u64) (tail : Tail L) (boundscheck : Bool) :
    scalar (customOps other core boundscheck) bindings index word tail boundscheck =
      (do let suffix ← core.call bindings.ithchunk (index :: tail.values)
          core.applyIterate bindings.iterate
            [JuliaLean.base.boot.coreV core "tuple",
             JuliaLean.base.boot.tupleV core [JuliaLean.base.boot.intV core word], suffix]) := by
  unfold scalar
  change
    (do let suffix ← run (customOps other core boundscheck) bindings boundscheck none index tail.values
        ((customOps other core boundscheck).contexts.inContext boundscheck).applyIterate
          bindings.iterate
          [JuliaLean.base.boot.coreV ((customOps other core boundscheck).contexts.inContext boundscheck) "tuple",
           JuliaLean.base.boot.tupleV ((customOps other core boundscheck).contexts.inContext boundscheck)
             [JuliaLean.base.boot.intV ((customOps other core boundscheck).contexts.inContext boundscheck) word], suffix]) = _
  rw [IndexChunkProofs.runCustomSuffix]
  cases boundscheck <;> rfl

theorem customSuffixRuntime :
    JuliaLean.Proofs.base.broadcast.Models2Group5.IthChunk.CustomSuffixRuntime := by
  intro W L other bindings index chunks word tail boundscheck
  constructor
  · apply CombineProofs.returns_three
      (first := fun _ => .call bindings.getindex [chunks, index])
      (second := fun _ _ => .call bindings.ithchunk (index :: tail.values))
      (third := fun core first suffix => .splat bindings.iterate
        [JuliaLean.base.boot.coreV core "tuple", JuliaLean.base.boot.tupleV core [first], suffix])
    intro core
    rw [vectorCustomEquation]
    rfl
  · apply CombineProofs.returns_two
      (first := fun _ => .call bindings.ithchunk (index :: tail.values))
      (second := fun core suffix => .splat bindings.iterate
        [JuliaLean.base.boot.coreV core "tuple",
         JuliaLean.base.boot.tupleV core [JuliaLean.base.boot.intV core word], suffix])
    intro core
    rw [scalarCustomEquation]
    rfl

end JuliaLean.ChatGPT.Batch11.Group10.ChunkCustomProofs

namespace JuliaLean.ChatGPT.Batch11.Group10.ChunkPlanProofs
open JuliaLean.base.expr (Value)
open JuliaLean.base.boot (CoreM)
open JuliaLean.Proofs.base.broadcast.Models2Group5.ForwardObservations

theorem bind_run {W L A B : Type} (action : CoreM W L A)
    (next : A → CoreM W L B) (world : W) :
    (do let a ← action; next a) world =
      match action world with
      | none => none
      | some (.error e) => some (.error e)
      | some (.ok (a, after)) => next a after := by
  change (Option.bind (action world) (fun result =>
    match result with
    | .error e => some (.error e)
    | .ok (a, after) => next a after)) = _
  cases action world with
  | none => rfl
  | some result => cases result <;> rfl

inductive Plan {W L : Type} :
    CoreM (ProbeWorld W L) L (Value L) → List (Event L × Value L) → Value L → Prop
  | done {action result}
      (pure_run : ∀ world, action world = some (.ok (result, world))) :
      Plan action [] result
  | step {action continuation event value rest result}
      (returned : ∀ initial payload suffix history,
        action ⟨initial, .returned value payload :: suffix, history⟩ =
          continuation ⟨payload, suffix, history ++ [event]⟩)
      (thrown : ∀ initial payload error suffix history,
        action ⟨initial, .thrown error payload :: suffix, history⟩ =
          some (.error (error, ⟨payload, suffix, history ++ [event]⟩)))
      (diverged : ∀ initial suffix history,
        action ⟨initial, .diverged :: suffix, history⟩ = none)
      (tail : Plan continuation rest result) :
      Plan action ((event, value) :: rest) result

theorem plan_congr {W L : Type} {action other : CoreM (ProbeWorld W L) L (Value L)}
    {schedule : List (Event L × Value L)} {result : Value L}
    (h : ∀ world, action world = other world) (p : Plan action schedule result) :
    Plan other schedule result := by
  cases p with
  | done pure_run => exact .done (fun world => (h world).symm.trans (pure_run world))
  | step returned thrown diverged tail =>
      exact .step (fun i p s h' => (h _).symm.trans (returned i p s h'))
        (fun i p e s h' => (h _).symm.trans (thrown i p e s h'))
        (fun i s h' => (h _).symm.trans (diverged i s h')) tail

theorem plan_pure {W L : Type} (result : Value L) :
    Plan (pure result : CoreM (ProbeWorld W L) L (Value L)) [] result :=
  .done (fun _ => rfl)

theorem plan_observe {W L : Type} (event : Event L) (value : Value L) :
    Plan (observe (W := W) event) [(event,value)] value := by
  exact .step (fun _ _ _ _ => rfl) (fun _ _ _ _ _ => rfl)
    (fun _ _ _ => rfl) (plan_pure value)

theorem plan_bind {W L : Type} {action : CoreM (ProbeWorld W L) L (Value L)}
    {schedule : List (Event L × Value L)} {result : Value L}
    (p : Plan action schedule result)
    (next : Value L → CoreM (ProbeWorld W L) L (Value L))
    {following : List (Event L × Value L)} {finalValue : Value L}
    (q : Plan (next result) following finalValue) :
    Plan (do let a ← action; next a) (schedule ++ following) finalValue := by
  induction p with
  | done pure_run =>
      apply plan_congr (action := next _) _ q
      intro world
      rw [bind_run, pure_run]
  | step returned thrown diverged tail ih =>
      refine .step ?_ ?_ ?_ (ih q)
      · intro initial payload suffix history
        rw [bind_run, returned, bind_run]
      · intro initial payload error suffix history
        rw [bind_run, thrown]
      · intro initial suffix history
        rw [bind_run, diverged]

end JuliaLean.ChatGPT.Batch11.Group10.ChunkPlanProofs

namespace JuliaLean.ChatGPT.Batch11.Group10.ChunkPlanProofs
open JuliaLean.base.expr (Value)
open JuliaLean.base.boot (CoreM)
open JuliaLean.Proofs.base.broadcast.Models2Group5.ForwardObservations

def planReplies {W L : Type} (values : Nat → Value L) (worlds : Nat → W)
    (offset count : Nat) : List (Reply W L) :=
  (List.range' offset count).map (fun i => .returned (values i) (worlds i))

theorem planReplies_zero {W L : Type} (values : Nat → Value L) (worlds : Nat → W)
    (offset : Nat) : planReplies values worlds offset 0 = [] := rfl

theorem planReplies_succ {W L : Type} (values : Nat → Value L) (worlds : Nat → W)
    (offset count : Nat) :
    planReplies values worlds offset (count + 1) =
      .returned (values offset) (worlds offset) :: planReplies values worlds (offset + 1) count := by
  simp only [planReplies, List.range'_succ, List.map_cons]

theorem planReplies_take {W L : Type} (values : Nat → Value L) (worlds : Nat → W)
    (offset count taken : Nat) (bound : taken ≤ count) :
    (planReplies values worlds offset count).take taken =
      planReplies values worlds offset taken := by
  simp only [planReplies, ← List.map_take, List.take_range'_of_length_ge bound]

theorem planLastWorld {W : Type} (worlds : Nat → W) (offset count : Nat) :
    (if count = 0 then worlds offset else worlds (offset + 1 + count - 1)) =
      worlds (offset + (count + 1) - 1) := by
  cases count with
  | zero => simp only [ite_true, Nat.add_zero, Nat.add_sub_cancel]
  | succ count =>
      simp only [Nat.succ_ne_zero, ite_false]
      congr 1
      omega

theorem plan_success {W L : Type} {action : CoreM (ProbeWorld W L) L (Value L)}
    {schedule : List (Event L × Value L)} {result : Value L}
    (p : Plan action schedule result) :
    ∀ (values : Nat → Value L) (worlds : Nat → W) (offset : Nat),
      (List.range' offset schedule.length).map values = schedule.map Prod.snd →
      ∀ (initial : W) (history : List (Event L)) (suffix : List (Reply W L)),
      action ⟨initial, planReplies values worlds offset schedule.length ++ suffix, history⟩ =
        some (.ok (result,
          ⟨if schedule.length = 0 then initial else worlds (offset + schedule.length - 1),
           suffix, history ++ schedule.map Prod.fst⟩)) := by
  induction p with
  | @done action result pure_run =>
      intro values worlds offset agreement initial history suffix
      simpa only [List.length_nil, planReplies_zero, List.nil_append, ite_true,
        List.map_nil, List.append_nil] using pure_run ⟨initial, suffix, history⟩
  | @step action continuation event value rest result returned thrown diverged tail ih =>
      intro values worlds offset agreement initial history suffix
      have pieces : values offset = value ∧
          (List.range' (offset + 1) rest.length).map values = rest.map Prod.snd := by
        simpa only [List.length_cons, List.range'_succ, List.map_cons, List.cons.injEq] using agreement
      rw [List.length_cons, planReplies_succ, pieces.1, List.cons_append, returned,
        ih values worlds (offset + 1) pieces.2]
      simp only [List.map_cons, List.append_assoc, List.cons_append, List.nil_append,
        Nat.succ_ne_zero, ite_false, planLastWorld]

 theorem plan_failure {W L : Type} {action : CoreM (ProbeWorld W L) L (Value L)}
    {schedule : List (Event L × Value L)} {result : Value L}
    (p : Plan action schedule result) :
    ∀ (values : Nat → Value L) (worlds : Nat → W) (offset : Nat),
      (List.range' offset schedule.length).map values = schedule.map Prod.snd →
      ∀ (position : Nat), position < schedule.length →
      ∀ (initial : W) (history : List (Event L)) (suffix : List (Reply W L))
        (error : Value L) (failureWorld : W),
      action ⟨initial, planReplies values worlds offset position ++
          (.thrown error failureWorld :: suffix), history⟩ =
        some (.error (error, ⟨failureWorld, suffix,
          history ++ (schedule.map Prod.fst).take (position + 1)⟩)) := by
  induction p with
  | done pure_run =>
      intro values worlds offset agreement position bound
      exact False.elim (Nat.not_lt_zero position bound)
  | @step action continuation event value rest result returned thrown diverged tail ih =>
      intro values worlds offset agreement position bound initial history suffix error failureWorld
      have pieces : values offset = value ∧
          (List.range' (offset + 1) rest.length).map values = rest.map Prod.snd := by
        simpa only [List.length_cons, List.range'_succ, List.map_cons, List.cons.injEq] using agreement
      cases position with
      | zero =>
          simpa only [planReplies_zero, List.nil_append, List.map_cons,
            List.take_succ_cons, List.take_zero] using thrown initial failureWorld error suffix history
      | succ position =>
          have smaller : position < rest.length := by
            simpa only [List.length_cons] using Nat.lt_of_succ_lt_succ bound
          rw [planReplies_succ, pieces.1, List.cons_append, returned,
            ih values worlds (offset + 1) pieces.2 position smaller]
          simp only [List.map_cons, List.take_succ_cons,
            List.append_assoc, List.cons_append, List.nil_append]

 theorem plan_divergence {W L : Type} {action : CoreM (ProbeWorld W L) L (Value L)}
    {schedule : List (Event L × Value L)} {result : Value L}
    (p : Plan action schedule result) :
    ∀ (values : Nat → Value L) (worlds : Nat → W) (offset : Nat),
      (List.range' offset schedule.length).map values = schedule.map Prod.snd →
      ∀ (position : Nat), position < schedule.length →
      ∀ (initial : W) (history : List (Event L)) (suffix : List (Reply W L)),
      action ⟨initial, planReplies values worlds offset position ++ (.diverged :: suffix), history⟩ = none := by
  induction p with
  | done pure_run =>
      intro values worlds offset agreement position bound
      exact False.elim (Nat.not_lt_zero position bound)
  | @step action continuation event value rest result returned thrown diverged tail ih =>
      intro values worlds offset agreement position bound initial history suffix
      have pieces : values offset = value ∧
          (List.range' (offset + 1) rest.length).map values = rest.map Prod.snd := by
        simpa only [List.length_cons, List.range'_succ, List.map_cons, List.cons.injEq] using agreement
      cases position with
      | zero =>
          simpa only [planReplies_zero, List.nil_append] using diverged initial suffix history
      | succ position =>
          have smaller : position < rest.length := by
            simpa only [List.length_cons] using Nat.lt_of_succ_lt_succ bound
          rw [planReplies_succ, pieces.1, List.cons_append, returned]
          exact ih values worlds (offset + 1) pieces.2 position smaller _ _ _

 theorem plan_complete {W L : Type} {action : CoreM (ProbeWorld W L) L (Value L)}
    {schedule : List (Event L × Value L)} {result : Value L}
    (p : Plan action schedule result) (positive : 0 < schedule.length)
    (worlds : Nat → W) (initial : W) (history : List (Event L))
    (suffix : List (Reply W L)) (fallback : Value L) :
    JuliaLean.Proofs.base.broadcast.Models2Group5.NewIndex.FollowsPlan action
      (fun i => (schedule.map Prod.snd).getD i fallback) worlds initial history suffix
      (schedule.map Prod.fst) result := by
  let values : Nat → Value L := fun i => (schedule.map Prod.snd).getD i fallback
  have agreement : (List.range' 0 schedule.length).map values = schedule.map Prod.snd := by
    simpa only [List.length_map, List.range_eq_range'] using
      ChunkListProofs.map_getD_range (schedule.map Prod.snd) fallback
  have script :
      (List.range schedule.length).map (fun i => Reply.returned (values i) (worlds i)) =
        planReplies values worlds 0 schedule.length := by
    simp only [planReplies, List.range_eq_range']
  change JuliaLean.Proofs.base.broadcast.Models2Group5.NewIndex.FollowsPlan action values
    worlds initial history suffix (schedule.map Prod.fst) result
  dsimp only [JuliaLean.Proofs.base.broadcast.Models2Group5.NewIndex.FollowsPlan]
  simp only [List.length_map, script]
  refine ⟨positive, ?_, ?_, ?_⟩
  · simpa only [Nat.zero_add, if_neg (Nat.ne_of_gt positive)] using
      plan_success p values worlds 0 agreement initial history suffix
  · intro position error failureWorld
    have bound : position.val < schedule.length := by
      simpa only [List.length_map] using position.isLt
    rw [planReplies_take values worlds 0 schedule.length position.val (Nat.le_of_lt bound)]
    simpa only [List.cons_append, List.nil_append, List.append_assoc] using
      plan_failure p values worlds 0 agreement position.val bound initial history
        ((planReplies values worlds 0 schedule.length).drop (position.val + 1) ++ suffix) error failureWorld
  · intro position
    have bound : position.val < schedule.length := by
      simpa only [List.length_map] using position.isLt
    rw [planReplies_take values worlds 0 schedule.length position.val (Nat.le_of_lt bound)]
    simpa only [List.cons_append, List.nil_append, List.append_assoc] using
      plan_divergence p values worlds 0 agreement position.val bound initial history
        ((planReplies values worlds 0 schedule.length).drop (position.val + 1) ++ suffix)

end JuliaLean.ChatGPT.Batch11.Group10.ChunkPlanProofs

namespace JuliaLean.ChatGPT.Batch11.Group10.ChunkFiniteProofs
open JuliaLean
open JuliaLean.base.expr (Value)
open JuliaLean.base.boot (CoreOps CoreM)
open JuliaLean.base.broadcast.Models2Group5.IthChunk
open JuliaLean.Proofs.base.broadcast.Models2Group5.ForwardObservations
open JuliaLean.Proofs.base.broadcast.Models2Group5.IthChunk (chainOps)
open ChunkPlanProofs

def schedule {W L : Type} (core : CoreOps (ProbeWorld W L) L)
    (bindings : Bindings L) (index : Value L)
    (argument : Nat → Value L) (keep : Nat → Bool)
    (reads assembled : Nat → Value L) (total : Nat) (positions : List Nat) :
    List (Event L × Value L) :=
  positions.filterMap (fun p => if keep p then
    some (.call bindings.getindex [argument p,index], reads p) else none) ++
  positions.reverse.map (fun p =>
    (.splat bindings.iterate [JuliaLean.base.boot.coreV core "tuple",
      JuliaLean.base.boot.tupleV core [if keep p then reads p else argument p],
      if p+1=total then JuliaLean.base.boot.tupleV core [] else assembled (p+1)],
      assembled p))

theorem schedule_nil {W L : Type} (core : CoreOps (ProbeWorld W L) L)
    (bindings : Bindings L) (index : Value L)
    (argument : Nat → Value L) (keep : Nat → Bool)
    (reads assembled : Nat → Value L) (total : Nat) :
    schedule core bindings index argument keep reads assembled total [] = [] := rfl

theorem schedule_cons {W L : Type} (core : CoreOps (ProbeWorld W L) L)
    (bindings : Bindings L) (index : Value L)
    (argument : Nat → Value L) (keep : Nat → Bool)
    (reads assembled : Nat → Value L) (total p : Nat) (positions : List Nat) :
    schedule core bindings index argument keep reads assembled total (p::positions) =
      (if keep p then [(.call bindings.getindex [argument p,index], reads p)] else []) ++
      schedule core bindings index argument keep reads assembled total positions ++
      [(.splat bindings.iterate [JuliaLean.base.boot.coreV core "tuple",
        JuliaLean.base.boot.tupleV core [if keep p then reads p else argument p],
        if p+1=total then JuliaLean.base.boot.tupleV core [] else assembled (p+1)], assembled p)] := by
  cases h : keep p <;>
    simp only [schedule, List.filterMap_cons, h, Bool.false_eq_true, ite_false, ite_true,
      List.reverse_cons, List.map_append, List.map_cons, List.map_nil,
      List.nil_append, List.cons_append, List.append_assoc]

theorem run_nil {W L : Type}
    (other : JuliaLean.base.broadcast.Models2Group5.Iteration.ContextOps (ProbeWorld W L) L)
    (core : CoreOps (ProbeWorld W L) L) (bindings : Bindings L)
    (boundscheck : Bool) (tailLength : Nat) (isVector : Nat → Bool) (index : Value L) :
    run (chainOps other core boundscheck tailLength isVector) bindings boundscheck none index [] =
      pure (JuliaLean.base.boot.tupleV core []) := by
  cases boundscheck <;> rfl

theorem run_cons {W L : Type}
    (other : JuliaLean.base.broadcast.Models2Group5.Iteration.ContextOps (ProbeWorld W L) L)
    (core : CoreOps (ProbeWorld W L) L) (bindings : Bindings L)
    (boundscheck : Bool) (tailLength : Nat) (isVector : Nat → Bool)
    (index head : Value L) (rest : List (Value L)) (flag : Bool)
    (h : isVector (tailLength-rest.length) = flag) :
    run (chainOps other core boundscheck tailLength isVector) bindings boundscheck none index (head::rest) =
      if flag then
        (do let first ← observe (.call bindings.getindex [head,index])
            let suffix ← run (chainOps other core boundscheck tailLength isVector)
              bindings boundscheck none index rest
            observe (.splat bindings.iterate [JuliaLean.base.boot.coreV core "tuple",
              JuliaLean.base.boot.tupleV core [first],suffix]))
      else
        (do let suffix ← run (chainOps other core boundscheck tailLength isVector)
              bindings boundscheck none index rest
            observe (.splat bindings.iterate [JuliaLean.base.boot.coreV core "tuple",
              JuliaLean.base.boot.tupleV core [head],suffix])) := by
  rw [run.eq_def]
  simp only [chainOps, h]
  cases flag <;> rfl


theorem suffix_plan {W L : Type}
    (other : JuliaLean.base.broadcast.Models2Group5.Iteration.ContextOps (ProbeWorld W L) L)
    (core : CoreOps (ProbeWorld W L) L) (bindings : Bindings L)
    (boundscheck : Bool) (tailLength : Nat) (isVector : Nat → Bool)
    (index : Value L) (argument : Nat → Value L) (keep : Nat → Bool)
    (reads assembled : Nat → Value L) (count : Nat) :
    ∀ start, start+count = tailLength+1 →
      (∀ p, start ≤ p → isVector p = keep p) →
      Plan (run (chainOps other core boundscheck tailLength isVector) bindings boundscheck none
        index ((List.range' start count).map argument))
        (schedule core bindings index argument keep reads assembled (tailLength+1)
          (List.range' start count))
        (if count=0 then JuliaLean.base.boot.tupleV core [] else assembled start) := by
  induction count with
  | zero =>
      intro start htotal hkeep
      simp only [List.range'_zero, List.map_nil, schedule_nil, ite_true]
      rw [run_nil]
      exact plan_pure _
  | succ count ih =>
      intro start htotal hkeep
      have htail : (start+1)+count=tailLength+1 := by omega
      have inner := ih (start+1) htail (fun p hp => hkeep p (by omega))
      have select : isVector (tailLength-((List.range' (start+1) count).map argument).length)
          = keep start := by
        simp only [List.length_map, List.length_range']
        have hindex : tailLength-count=start := by omega
        rw [hindex, hkeep start (Nat.le_refl start)]
      have hout : (if count=0 then JuliaLean.base.boot.tupleV core [] else assembled (start+1)) =
          (if start+1=tailLength+1 then JuliaLean.base.boot.tupleV core [] else assembled (start+1)) := by
        by_cases hz : count=0
        · have heq : start+1=tailLength+1 := by omega
          simp only [hz, heq, ite_true]
        · have hne : ¬start+1=tailLength+1 := by omega
          simp only [hz, hne, ite_false]
      rw [hout] at inner
      simp only [List.range'_succ, List.map_cons, schedule_cons, Nat.succ_ne_zero, ite_false]
      rw [run_cons other core bindings boundscheck tailLength isVector index
        (argument start) ((List.range' (start+1) count).map argument) (keep start) select]
      cases hf : keep start with
      | false =>
          simp only [hf, Bool.false_eq_true, ite_false, List.nil_append]
          exact plan_bind inner _ (plan_observe _ (assembled start))
      | true =>
          simp only [hf, ite_true, List.cons_append, List.nil_append]
          exact plan_bind (plan_observe _ (reads start)) _
            (plan_bind inner _ (plan_observe _ (assembled start)))


theorem argument_tail {A : Type} (tail : List A) (first : A) :
    (List.range' 1 tail.length).map
      (fun p => if p=0 then first else tail.getD (p-1) first) = tail := by
  rw [List.range'_eq_map_range, List.map_map]
  have hfun : (fun p => (if 1+p=0 then first else tail.getD (1+p-1) first)) =
      (fun p => tail.getD p first) := by
    funext p
    have hn : ¬1+p=0 := by omega
    have hp : 1+p-1=p := by omega
    simp only [hn, ite_false, hp]
  change (List.range tail.length).map (fun p => if 1+p=0 then first else tail.getD (1+p-1) first) = tail
  rw [hfun]
  exact ChunkListProofs.map_getD_range tail first

theorem map_filtered {A B C : Type} (positions : List A) (keep : A → Bool)
    (f : A → B) (g : B → C) :
    (positions.filterMap (fun p => if keep p then some (f p) else none)).map g =
      positions.filterMap (fun p => if keep p then some (g (f p)) else none) := by
  induction positions with
  | nil => rfl
  | cons p ps ih =>
      cases h : keep p <;>
        simp only [List.filterMap_cons, h, Bool.false_eq_true, ite_false, ite_true,
          List.map_cons, ih]

theorem schedule_first {W L : Type} (core : CoreOps (ProbeWorld W L) L)
    (bindings : Bindings L) (index : Value L)
    (argument : Nat → Value L) (keep : Nat → Bool)
    (reads assembled : Nat → Value L) (total : Nat) (positions : List Nat) :
    (schedule core bindings index argument keep reads assembled total positions).map Prod.fst =
      positions.filterMap (fun p => if keep p then
        some (.call bindings.getindex [argument p,index]) else none) ++
      positions.reverse.map (fun p =>
        .splat bindings.iterate [JuliaLean.base.boot.coreV core "tuple",
          JuliaLean.base.boot.tupleV core [if keep p then reads p else argument p],
          if p+1=total then JuliaLean.base.boot.tupleV core [] else assembled (p+1)]) := by
  simp only [schedule, List.map_append, map_filtered, List.map_map]
  rfl

theorem schedule_second {W L : Type} (core : CoreOps (ProbeWorld W L) L)
    (bindings : Bindings L) (index : Value L)
    (argument : Nat → Value L) (keep : Nat → Bool)
    (reads assembled : Nat → Value L) (total : Nat) (positions : List Nat) :
    (schedule core bindings index argument keep reads assembled total positions).map Prod.snd =
      positions.filterMap (fun p => if keep p then some (reads p) else none) ++
      positions.reverse.map assembled := by
  simp only [schedule, List.map_append, map_filtered, List.map_map]
  rfl


theorem head_plan {W L : Type}
    (other : JuliaLean.base.broadcast.Models2Group5.Iteration.ContextOps (ProbeWorld W L) L)
    (core : CoreOps (ProbeWorld W L) L) (bindings : Bindings L)
    (index chunks : Value L) (word : JInt .u64) (tail : Tail L)
    (boundscheck vectorEntry : Bool) (isVector : Nat → Bool)
    (argument : Nat → Value L) (keep : Nat → Bool)
    (reads assembled : Nat → Value L)
    (hfirst : argument 0 = if vectorEntry then chunks else JuliaLean.base.boot.intV core word)
    (harguments : (List.range' 1 tail.values.length).map argument = tail.values)
    (hzero : keep 0 = vectorEntry)
    (hkeep : ∀ p, 1 ≤ p → isVector p = keep p) :
    Plan (if vectorEntry then
        vector (chainOps other core boundscheck tail.values.length isVector)
          bindings index chunks tail boundscheck
      else scalar (chainOps other core boundscheck tail.values.length isVector)
          bindings index word tail boundscheck)
      (schedule core bindings index argument keep reads assembled (tail.values.length+1)
        (List.range (tail.values.length+1))) (assembled 0) := by
  have inner := suffix_plan other core bindings boundscheck tail.values.length isVector
    index argument keep reads assembled tail.values.length 1 (by omega) hkeep
  rw [harguments] at inner
  have hout : (if tail.values.length=0 then JuliaLean.base.boot.tupleV core [] else assembled 1) =
      (if 1=tail.values.length+1 then JuliaLean.base.boot.tupleV core [] else assembled 1) := by
    by_cases hz : tail.values.length=0
    · simp only [hz, Nat.zero_add, ite_true]
    · have hn : ¬1=tail.values.length+1 := by omega
      simp only [hz, hn, ite_false]
  rw [hout] at inner
  have run_head : (if vectorEntry then
        vector (chainOps other core boundscheck tail.values.length isVector)
          bindings index chunks tail boundscheck
      else scalar (chainOps other core boundscheck tail.values.length isVector)
          bindings index word tail boundscheck) =
      (if vectorEntry then
        (do let first ← observe (.call bindings.getindex [argument 0,index])
            let suffix ← run (chainOps other core boundscheck tail.values.length isVector)
              bindings boundscheck none index tail.values
            observe (.splat bindings.iterate [JuliaLean.base.boot.coreV core "tuple",
              JuliaLean.base.boot.tupleV core [first],suffix]))
      else
        (do let suffix ← run (chainOps other core boundscheck tail.values.length isVector)
              bindings boundscheck none index tail.values
            observe (.splat bindings.iterate [JuliaLean.base.boot.coreV core "tuple",
              JuliaLean.base.boot.tupleV core [argument 0],suffix]))) := by
    rw [hfirst]
    cases vectorEntry <;> cases boundscheck <;> rfl
  rw [run_head, List.range_eq_range', List.range'_succ, schedule_cons]
  simp only [Nat.zero_add, hzero]
  cases hf : vectorEntry with
  | false =>
      simp only [Bool.false_eq_true, ite_false, List.nil_append]
      exact plan_bind inner _ (plan_observe _ (assembled 0))
  | true =>
      simp only [ite_true, List.cons_append, List.nil_append]
      exact plan_bind (plan_observe _ (reads 0)) _
        (plan_bind inner _ (plan_observe _ (assembled 0)))


theorem finite_runtime :
    JuliaLean.Proofs.base.broadcast.Models2Group5.IthChunk.FiniteRecursionRuntime := by
  intro W L other core bindings index chunks word tail boundscheck vectorEntry isVector
    readValues assembled worlds initial history suffix
  let first := if vectorEntry then chunks else JuliaLean.base.boot.intV core word
  let argument := fun p => if p=0 then first else tail.values.getD (p-1) first
  let keep := fun p => if p=0 then vectorEntry else isVector p
  let positions := List.range (tail.values.length+1)
  have p := head_plan other core bindings index chunks word tail boundscheck vectorEntry isVector
    argument keep readValues assembled (by rfl) (argument_tail tail.values first) (by rfl)
    (by
      intro position positive
      have hn : ¬position=0 := by omega
      simp only [keep, hn, ite_false])
  have positive : 0 < (schedule core bindings index argument keep readValues assembled
      (tail.values.length+1) positions).length := by
    simp only [schedule, List.length_append, List.length_map, List.length_reverse,
      positions, List.length_range]
    omega
  have completed := plan_complete p positive worlds initial history suffix first
  rw [schedule_first, schedule_second] at completed
  refine ⟨?_, completed⟩
  have hfirst := congrArg List.length
    (schedule_first core bindings index argument keep readValues assembled
      (tail.values.length+1) positions)
  have hsecond := congrArg List.length
    (schedule_second core bindings index argument keep readValues assembled
      (tail.values.length+1) positions)
  rw [List.length_map] at hfirst hsecond
  exact hfirst.symm.trans hsecond

