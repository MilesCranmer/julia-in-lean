/-- IteratorSize queries the original type once, carries the exact arbitrary
ndims result into type application, and then calls the constructor selected in
the resulting runtime world. It returns that constructor's actual result and
world, without asserting a return type. Exceptions and divergence at all three
sites stop later source actions. No operation is assumed to return a correct
rank, type, value or world; the observation family universally varies them.
The test detects reordered calls, dimension coercions, wrong constructor
selection, changed results, eager defaults and errors replaced by values.
Source: base/broadcast.jl:295; base/generator.jl:66,70-85. -/
def RuntimeObservations : Prop :=
  ∀ {W L : Type} (select : Value L → W → ConstructorMethod)
      (bindings : Bindings L) (T : Value L),
    ReturnsLastAfter (W := W) (L := L) 2
      (fun core => iteratorSize
        { toCoreOps := core
          selectedConstructor := fun type world => select type world.payload }
        bindings T)
      (fun _ values worlds _ =>
        [.call bindings.ndims [T],
         .applyType bindings.hasShape [values 0],
         match select (values 1) (worlds 1) with
         | .builtin => .newObject (values 1) []
         | .custom => .call (values 1) []])

/-- Changing the unused builtin isa and typeof hooks cannot change any
execution, including failure or divergence. This independently rejects an
invented dimension/return type assertion or type inspection. The actual
selected call/new operations are held fixed by record update, so this places
no restriction on type inspections inside custom dispatched code.
Source: base/broadcast.jl:295. -/
def NoExtraTypeInspection : Prop :=
  ∀ {W L : Type} (ops : Ops W L) (bindings : Bindings L) (T : Value L) (world : W)
      (isa1 isa2 : Value L → Value L → Bool)
      (typeOf1 typeOf2 : Value L → L),
    let first : Ops W L :=
      { ops with toCoreOps := { ops.toCoreOps with isa := isa1, typeOf := typeOf1 } }
    let second : Ops W L :=
      { ops with toCoreOps := { ops.toCoreOps with isa := isa2, typeOf := typeOf2 } }
    iteratorSize first bindings T world = iteratorSize second bindings T world

/-- Independent call/error/world observations together with the absence of
extra dimension or return-type checks; no callee correctness laws. -/
def RuntimeContract : Prop := RuntimeObservations ∧ NoExtraTypeInspection

def proposedEntries : List Entry := [
  { id := "broadcast-iterator-size-runtime-contract", juliaFile := "base/broadcast.jl",
    juliaFns := ["Base.IteratorSize(::Type{T}) where {T<:Broadcasted}",
      "Base.HasShape{N}() (generated constructor dependency)"],
    statement := "IteratorSize queries the original Broadcasted type once, applies HasShape to the exact dimension result, and invokes the constructor selected after those effects. It retains arbitrary constructor results and worlds, propagates every exception or divergence without later actions, and adds no dimension or return-type inspection.",
    source := "base/broadcast.jl:295; base/generator.jl:66,70-85; doc/src/manual/constructors.md:329-342 (type-parameter, effect-order and inspection invariants)",
    status := .proven,
    prop := ``JuliaLean.Proofs.base.broadcast.Models2Group5.IteratorSize.RuntimeContract,
    thm := some `JuliaLean.Proofs.base.broadcast.Models2Group5.IteratorSize.RuntimeContract_proven,
    notes := "Full Value/CoreOps/CoreM domain, including custom ndims and constructor dispatch, arbitrary axes type parameters and invalid type-parameter errors. No Nat/Int64 dimension restriction. Covers callConstructor and the necessary generated hasShapeNew dependency; existing generator declarations remain unchanged. No callee correctness assumptions are required." }
]

