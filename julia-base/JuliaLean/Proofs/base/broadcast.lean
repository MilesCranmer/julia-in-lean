        JuliaLean.base.broadcast.Models2Group5.Forward.argtype ops bindings second world) ∧
      (JuliaLean.base.broadcast.Models2Group5.Forward.indexStyle ops bindings first world =
        JuliaLean.base.broadcast.Models2Group5.Forward.indexStyle ops bindings second world) ∧
      (JuliaLean.base.broadcast.Models2Group5.Forward.ndims ops bindings first world =
        JuliaLean.base.broadcast.Models2Group5.Forward.ndims ops bindings second world)

