open JuliaLean.base.boot (CoreOps)
open JuliaLean.base.broadcast.Models2Group5.CombineAxes
open JuliaLean.Proofs.base.broadcast.Models2Group5.ForwardObservations

/-- Binary combination queries the original left value before the original
right value, then passes their exact axes results in that order to the shape
callee. All results, errors, worlds and divergence remain arbitrary. No shape
compatibility, associativity, axis indexing or callee-correctness assumption
is imposed. Source: base/broadcast.jl:503; documentation at489-500. -/
def BinaryObservations : Prop :=
  ∀ {W L : Type} (bindings : Bindings L) (left right : Value L),
    ReturnsLastAfter (W := W) (L := L) 2
      (fun ops => combineTwo ops bindings left right)
      (fun _ values _ _ =>
        [.call bindings.axes [left], .call bindings.axes [right],
         .call bindings.broadcastShape [values 0, values 1]])

/-- Unary combination observes axes on the original value exactly once and
returns the complete selected outcome unchanged, including nonstandard/custom
axes, errors, worlds and divergence. No result-type assertion is invented.
Source: base/broadcast.jl:504; documentation at489-500. -/
def UnaryObservations : Prop :=
  ∀ {W L : Type} (bindings : Bindings L) (value : Value L),
    ReturnsLastAfter (W := W) (L := L) 0
      (fun ops => combineOne ops bindings value)
      (fun _ _ _ _ => [.call bindings.axes [value]])

/-- A proof-observation terminal is either the final axes query of canonical
recursion or one selected custom call on the remaining suffix. This is not
runtime dispatch and supplies no model result. -/
inductive Terminal where
  | axes
  | custom

/-- Pure scan locating the trace's terminal observation. The only operations
inspected are actual dispatch selections at the preceding arbitrary payload
world. At a canonical binary call, source503 queries its second operand's axes
directly; it never selects a unary combine_axes overload for that operand.
Consequently the binary case advances once and ends without another selector
call. A selected custom method stops descent at the current suffix. This scan
computes a trace position only, never an axis, shape or method result. -/
def cutPoint {W L : Type}
    (select : Value L → List (Value L) → W → Method)
    (worlds : Nat → W) (processed : Nat) (first : Value L)
    (rest : List (Value L)) : Nat × Terminal :=
  match select first rest (worlds (processed - 1)) with
  | .custom => (processed, .custom)
  | .builtin =>
      match rest with
      | [] => (processed, .axes)
      | [_second] => (processed + 1, .axes)
      | second :: third :: tail =>
          cutPoint select worlds (processed + 1) second (third :: tail)
termination_by rest.length

/-- Independent closed-form trace grammar: axes queries on an original prefix,
then a final axes query or one custom call on the remaining suffix, then shape
joins in reverse prefix order. The left token of each join is the corresponding
original axes reply, and its right token is the preceding deeper result.
Only take/drop and arithmetic over proof records are used; there is no second
combine_axes evaluator or supplied shape-correctness law. -/
def variadicEvents {L : Type} (bindings : Bindings L)
    (inputs : List (Value L)) (cut : Nat) (terminal : Terminal)
    (values : Nat → Value L) : List (Event L) :=
  (inputs.take cut).map (fun value => .call bindings.axes [value]) ++
  (match terminal with
   | .axes => (inputs.drop cut).map (fun value => .call bindings.axes [value])
   | .custom => [.call bindings.combineAxes (inputs.drop cut)]) ++
  (List.range cut).map (fun index =>
    .call bindings.broadcastShape [values (cut - 1 - index), values (cut + index)])

/-- Only the operation hooks are instrumented. Pure method selection sees
exactly the arbitrary payload world returned by preceding axes operations;
it cannot be replaced by an entry-time selection or a callee-result law. -/
def observingCombine {W L : Type} (core : CoreOps (ProbeWorld W L) L)
    (select : Value L → List (Value L) → W → Method) :
    Ops (ProbeWorld W L) L where
  toCoreOps := observingOps core
  selectedCombine := fun first rest world => select first rest world.payload

/-- Full nonempty-suffix observation contract for source502. The empty suffix
is handled separately by EmptySuffixMissingMethod, and both are registered as
one complete-domain contract. Every input reference, returned axes/shape value,
world, custom selector, error and divergence position is quantified. The trace
is the original-prefix/terminal-suffix/reverse-join grammar, with exact result
provenance. Every failure stops at its source position with no later effects.
The bound is the actual Tail representation invariant, not a success premise.
Source: base/broadcast.jl:502-504; documentation at489-500. -/
def NonemptyVariadicObservations : Prop :=
  ∀ {W L : Type} (core : CoreOps (ProbeWorld W L) L)
      (select : Value L → List (Value L) → W → Method)
      (bindings : Bindings L) (first : Value L) (rest : Tail L)
      (values : Nat → Value L) (worlds : Nat → W) (initial : W)
      (history : List (Event L)) (suffix : List (Reply W L)),
    match rest.values with
    | [] => True
    | second :: remainingInputs =>
        let inputs := first :: rest.values
        let plan := cutPoint select worlds 1 second remainingInputs
        let cut := plan.1
        let terminal := plan.2
        let count := 2 * cut + 1
        let prescribed := variadicEvents bindings inputs cut terminal values
        let successful : List (Reply W L) :=
          (List.range count).map (fun index => .returned (values index) (worlds index))
        let ops := observingCombine core select
        let before : ProbeWorld W L := ⟨initial, successful ++ suffix, history⟩
        let after : ProbeWorld W L :=
          ⟨worlds (count - 1), suffix, history ++ prescribed⟩
        (0 < cut ∧ cut < inputs.length) ∧ prescribed.length = count ∧
        (match terminal with
         | .axes => (inputs.drop cut).length = 1
         | .custom => True) ∧
        combineMany ops bindings first rest before =
          some (.ok (values (count - 1), after)) ∧
        (∀ (position : Fin count) (error : Value L) (failureWorld : W),
          let unused := successful.drop (position.val + 1) ++ suffix
          let failureBefore : ProbeWorld W L :=
            ⟨initial, successful.take position.val ++
              [.thrown error failureWorld] ++ unused, history⟩
          let failureAfter : ProbeWorld W L :=
            ⟨failureWorld, unused, history ++ prescribed.take (position.val + 1)⟩
          combineMany ops bindings first rest failureBefore =
            some (.error (error, failureAfter))) ∧
        (∀ position : Fin count,
          let divergenceBefore : ProbeWorld W L :=
            ⟨initial, successful.take position.val ++ [.diverged] ++
              successful.drop (position.val + 1) ++ suffix, history⟩
          combineMany ops bindings first rest divergenceBefore = none)

/-- Independent missing-method contract for explicitly selecting source502
with no B arguments. After the first axes observation, the runtime world-age
primitive determines the age carried by the mandatory MethodError for the
actual combine_axes binding and empty argument tuple. There is no shape call
or fabricated empty-axis result. A primitive failure or divergence is retained
unchanged, with its actual world. This compares only the existing world-age
primitive's arbitrary observation; it does not run a second combination model
or assume a correctness law about that primitive.
Source: base/broadcast.jl:502-504 (no nullary method), installed boot.noMethod. -/
def EmptySuffixMissingMethod : Prop :=
  ∀ {W L : Type} (core : CoreOps (ProbeWorld W L) L)
      (select : Value L → List (Value L) → W → Method)
      (bindings : Bindings L) (first : Value L) (rest : Tail L)
      (firstAxes : Value L) (axisWorld initial : W)
      (history : List (Event L)) (remaining : List (Reply W L)),
    match rest.values with
    | _ :: _ => True
    | [] =>
        let ops := observingCombine core select
        let before : ProbeWorld W L :=
          ⟨initial, .returned firstAxes axisWorld :: remaining, history⟩
        let afterAxes : ProbeWorld W L :=
          ⟨axisWorld, remaining, history ++ [.call bindings.axes [first]]⟩
        let actual := combineMany ops bindings first rest before
        match core.worldAge afterAxes with
        | none => actual = none
        | some (.error (error, failureWorld)) =>
            actual = some (.error (error, failureWorld))
        | some (.ok (age, throwWorld)) =>
            actual = some (.error
              (.leaf (core.obj (.methodError bindings.combineAxes
                (JuliaLean.base.boot.tupleV core [])
                (JuliaLean.base.boot.intV core age))), throwWorld))

/-- Failure or divergence in the first axes query prevents every suffix
operation, including the missing-method world-age read in the empty case.
This completes the empty-suffix contract's possible outcomes and additionally
checks the first call uniformly for all full-size-bounded input tuples.
Source: base/broadcast.jl:502. -/
def FirstAxisFailureStops : Prop :=
  ∀ {W L : Type} (core : CoreOps (ProbeWorld W L) L)
      (select : Value L → List (Value L) → W → Method)
      (bindings : Bindings L) (first : Value L) (rest : Tail L)
      (initial failureWorld : W) (error : Value L)
      (history : List (Event L)) (remaining : List (Reply W L)),
    let ops := observingCombine core select
    let failureBefore : ProbeWorld W L :=
      ⟨initial, .thrown error failureWorld :: remaining, history⟩
    let failureAfter : ProbeWorld W L :=
      ⟨failureWorld, remaining, history ++ [.call bindings.axes [first]]⟩
    let divergenceBefore : ProbeWorld W L :=
      ⟨initial, .diverged :: remaining, history⟩
    combineMany ops bindings first rest failureBefore = some (.error (error, failureAfter)) ∧
    combineMany ops bindings first rest divergenceBefore = none

/-- Together the cases cover every Tail, including the explicit-invoke empty
case, and every operation outcome; no nonempty or success premise narrows the
source method's domain. -/
def VariadicRuntimeContract : Prop :=
  NonemptyVariadicObservations ∧ EmptySuffixMissingMethod ∧ FirstAxisFailureStops

