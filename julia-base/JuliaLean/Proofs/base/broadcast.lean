open JuliaLean.base.broadcast.Models2Group5.Constructors
open JuliaLean.Proofs.base.broadcast.Models2Group5.ConstructorProbe

/-- Successful observations before the source's style assertion. The optional
first value is only the type object created for the concrete nullary route. -/
def styleReplies {W L : Type} (args : ArgumentTuple L)
    (appliedType style : Value L) (typeWorld styleWorld : W) : List (Reply W L) :=
  match args.values with
  | [] => [.returned appliedType typeWorld, .returned style styleWorld]
  | _ :: _ => [.returned style styleWorld]

def styleCallCount {L : Type} (args : ArgumentTuple L) : Nat :=
  match args.values with
  | [] => 2
  | _ :: _ => 1

/-- Independent observable requirements before the style assertion. Constructor
selection is read in the exact intermediate world, including the actual probe
queue, so the property does not assume selection is insensitive to effects. -/
def styleEvents {W L : Type} (ops : DefaultStyle.Ops (World W L) L)
    (bindings : Bindings L) (args : ArgumentTuple L)
    (appliedType : Value L) (typeWorld : W)
    (history : List (Event L)) (replies : List (Reply W L)) : List (Event L) :=
  match args.values with
  | [] =>
      let first : Event L := .applyType bindings.defaultArrayStyle
        [JuliaLean.base.boot.intV ops.toCoreOps (JInt.lit .i64 0)]
      let current : World W L := ⟨typeWorld, replies.drop 1, history ++ [first]⟩
      let second : Event L := match ops.selectedConstructor appliedType current with
        | .builtin => .new appliedType []
        | .custom => .call appliedType []
      [first, second]
  | _ :: _ => [.call bindings.combineStyles args.values]

/-- The inferred constructor body does not itself evaluate f or tuple elements,
forwards the exact tuple and axes identities, and does not promise anything about a custom
constructor result. Successful style resolution is followed by exactly the
source style assertion. A bad style is rejected before construction, even when
the uncalled constructor would diverge; a good style transports every possible
constructor reply unchanged, including a non-Broadcasted value, arbitrary
exception, changed world, or divergence. Probe values and operations have no
callee correctness laws. This checks call/argument identity, laziness and the
single assertion boundary rather than equating the model to a copied body.
Source: base/broadcast.jl:181-183,431;
doc/src/manual/interfaces.md:557-560,626-650. -/
def LazyTransportAndStyleAssertion : Prop :=
  ∀ {W L : Type} (ops : DefaultStyle.Ops (World W L) L)
      (bindings : Bindings L) (f axes : Value L) (args : ArgumentTuple L)
      (appliedType style : Value L) (typeWorld styleWorld initial : W)
      (lastReply : Reply W L) (remaining : List (Reply W L))
      (history : List (Event L)),
    let replies := styleReplies args appliedType style typeWorld styleWorld ++
      (lastReply :: remaining)
    let historyPrefix := history ++ styleEvents ops bindings args appliedType typeWorld history replies
    let finalCall : Event L := .call bindings.broadcasted
      [style, f, JuliaLean.base.boot.tupleV ops.toCoreOps args.values, axes]
    let actual := inferred (observingDefault ops) bindings f args axes
      ⟨initial, replies, history⟩
    if ops.isa style bindings.broadcastStyle then
      actual = replyOutcome lastReply remaining (historyPrefix ++ [finalCall])
    else
      actual = some (.error
        (.leaf (ops.obj (.typeError (.symbol "typeassert") (.leaf (ops.str ""))
          bindings.broadcastStyle style)),
         ⟨styleWorld, lastReply :: remaining, historyPrefix⟩))

/-- Every failure during style resolution remains the same thrown Julia value
in that call's exact world. No constructor or scalar function is evaluated
later, and unconsumed observations remain untouched. The failed site ranges
over both the fixed nullary Base dependency and every nonempty generic call.
Source: base/broadcast.jl:181-183,431. -/
def StyleFailureStopsConstruction : Prop :=
  ∀ {W L : Type} (ops : DefaultStyle.Ops (World W L) L)
      (bindings : Bindings L) (f axes : Value L) (args : ArgumentTuple L)
      (appliedType style error : Value L) (typeWorld styleWorld initial failedWorld : W)
      (remaining : List (Reply W L)) (history : List (Event L))
      (position : Fin (styleCallCount args)),
    let success := styleReplies args appliedType style typeWorld styleWorld
    let rest := success.drop (position.val + 1) ++ remaining
    let replies := success.take position.val ++ [.thrown error failedWorld] ++ rest
    let events := history ++
      (styleEvents ops bindings args appliedType typeWorld history replies).take (position.val + 1)
    inferred (observingDefault ops) bindings f args axes ⟨initial, replies, history⟩ =
      some (.error (error, ⟨failedWorld, rest, events⟩))

/-- Divergence in style discovery or its concrete nullary constructor remains
divergence for every input function, tuple and axes; no default value can
silently substitute for it. Source: base/broadcast.jl:181-183,431. -/
def StyleDivergenceIsPreserved : Prop :=
  ∀ {W L : Type} (ops : DefaultStyle.Ops (World W L) L)
      (bindings : Bindings L) (f axes : Value L) (args : ArgumentTuple L)
      (appliedType style : Value L) (typeWorld styleWorld initial : W)
      (remaining : List (Reply W L)) (history : List (Event L))
      (position : Fin (styleCallCount args)),
    let success := styleReplies args appliedType style typeWorld styleWorld
    let replies := success.take position.val ++ [.diverged] ++
      success.drop (position.val + 1) ++ remaining
    inferred (observingDefault ops) bindings f args axes ⟨initial, replies, history⟩ = none

def entryProposals : List JuliaLean.Registry.Entry := [
  { id := "broadcast-inferred-constructor-lazy-transport", juliaFile := "base/broadcast.jl",
    juliaFns := ["Broadcasted(f::F, args::Tuple, axes=nothing) where {F}", "combine_styles()"],
    statement := "Inferred-style construction preserves the exact lazy function/tuple/axes call arguments, rejects a non-style before construction, and otherwise transports arbitrary custom constructor results, exceptions, divergence and worlds without an extra result assertion.",
    source := "base/broadcast.jl:181-183,431; doc/src/manual/interfaces.md:557-560,626-650 (laziness and argument identity invariant)",
    status := .proven,
    prop := ``JuliaLean.Proofs.base.broadcast.Models2Group5.Constructors.LazyTransportAndStyleAssertion,
    thm := some `JuliaLean.Proofs.base.broadcast.Models2Group5.Constructors.LazyTransportAndStyleAssertion_proven,
    notes := "Complete machine-sized heterogeneous input tuples. Open dispatch is on unfixed tuple element/style/F/Args/Axes types. Nullary combine_styles is explicitly modelled through the zero-rank DefaultArrayStyle constructor. No field-preservation claim is imposed on custom constructors." },
  { id := "broadcast-inferred-constructor-style-failures", juliaFile := "base/broadcast.jl",
