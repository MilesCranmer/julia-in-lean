  | generic => simp only [selected, isTerminal, Bool.true_eq_false] at selectedNonterminal
  | custom => simp only [selected, isTerminal, Bool.true_eq_false] at selectedNonterminal
  | cartesianInteger =>
    rcases offsetCases with offsetCase | offsetCase | offsetCase <;>
      rw [runMethod.eq_def] <;>
      simp only [selected, offsetCase, observingDispatch, observingContexts,
        successes, List.range_succ, List.range_zero, List.map_cons, List.map_nil,
        List.map_append, List.cons_append, List.nil_append, bind_apply, observe,
        Nat.add_zero, Nat.reduceAdd,
        blockEvents, call, List.take, List.append_assoc]
  | linearCartesian =>
    rcases offsetCases with offsetCase | offsetCase | offsetCase <;>
