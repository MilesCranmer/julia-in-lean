  | newObject (type : Value L) (fields : List (Value L))

/-- Arbitrary runtime outcomes, with the world at a return or throw.
No assumption is made about a selected callee's result or correctness. -/
inductive Reply (W L : Type) where
  | returned (value : Value L) (world : W)
  | thrown (error : Value L) (world : W)
  | diverged

/-- Proof-side observation data. Lists are finite instrument records, not
representations of Julia arrays or tuples. -/
structure ProbeWorld (W L : Type) where
  payload : W
  replies : List (Reply W L)
  events : List (Event L)

/-- Observe one existing runtime operation. Every returned value, error and
world is arbitrary. Exhausting an observation script gives divergence; no
fallback result is supplied. -/
def observe {W L : Type} (event : Event L) :
    CoreM (ProbeWorld W L) L (Value L) := fun world =>
  match world.replies with
  | [] => none
  | .diverged :: _ => none
  | .returned value payload :: replies =>
      some (.ok (value, ⟨payload, replies, world.events ++ [event]⟩))
  | .thrown error payload :: replies =>
      some (.error (error, ⟨payload, replies, world.events ++ [event]⟩))

/-- Instrument only the three runtime operations used by this method.
Constructor selection sees the current arbitrary payload world, including
changes made by ndims and applyType. Other runtime operations remain arbitrary. -/
def observingOps {W L : Type} (ops : CoreOps (ProbeWorld W L) L)
    (select : Value L → W → ConstructorMethod) : Ops (ProbeWorld W L) L where
  toCoreOps :=
    { ops with
      call := fun function arguments => observe (.call function arguments)
      applyType := fun constructor parameters => observe (.applyType constructor parameters)
      new := fun type fields => observe (.newObject type fields) }
  selectedConstructor := fun type world => select type world.payload

/-- Three arbitrary successful runtime outcomes, indexed only in the
independent observation. -/
def successfulReplies {W L : Type} (values : Fin 3 → Value L)
    (worlds : Fin 3 → W) : List (Reply W L) :=
  [.returned (values 0) (worlds 0), .returned (values 1) (worlds 1),
   .returned (values 2) (worlds 2)]

/-- Independent evaluation-order specification: one ndims call on the
original type, one application with its unmodified result, then the constructor
selected in the world at that call. Source: base/broadcast.jl:97,103.
The expected result is never computed by a second implementation of fallback. -/
def requiredEvents {W L : Type} (bindings : Bindings L) (T : Value L)
    (select : Value L → W → ConstructorMethod)
    (values : Fin 3 → Value L) (worlds : Fin 3 → W) : List (Event L) :=
  [.call bindings.ndims [T],
   .applyType bindings.defaultArrayStyle [values 0],
   match select (values 1) (worlds 1) with
   | .builtin => .newObject (values 1) []
   | .custom => .call (values 1) []]

/-- A successful fallback has exactly the required runtime observations,
returns the actual constructor result unchanged, and retains its final world.
All input types, ndims values (including invalid parameter candidates), type
objects, constructor returns, worlds and selection rules are quantified.
This rejects missing or reordered calls, changed call arguments, coercing the
dimension, wrong constructor branches, and discarded constructor results.
Source: base/broadcast.jl:97,103; manual/interfaces.md:459-555. -/
def SuccessfulObservations : Prop :=
  ∀ {W L : Type} (ops : CoreOps (ProbeWorld W L) L)
      (select : Value L → W → ConstructorMethod)
      (bindings : Bindings L) (T : Value L)
      (values : Fin 3 → Value L) (worlds : Fin 3 → W)
      (initial : W) (history : List (Event L)),
    let before : ProbeWorld W L :=
      ⟨initial, successfulReplies values worlds, history⟩
    let after : ProbeWorld W L :=
      ⟨worlds 2, [], history ++ requiredEvents bindings T select values worlds⟩
    fallback (observingOps ops select) bindings T before =
      some (.ok (values 2, after))

/-- Throwing at any source call site preserves exactly that error and its
world. Only the trace prefix through that call occurs; later replies remain
unused. No error is replaced by a default style, no type assertion is added,
and errors from ndims or type application prevent construction.
The errors and all preceding returned values/worlds are arbitrary, not
callee-correctness premises. Source: base/broadcast.jl:97,103. -/
def FailureObservations : Prop :=
  ∀ {W L : Type} (ops : CoreOps (ProbeWorld W L) L)
      (select : Value L → W → ConstructorMethod)
      (bindings : Bindings L) (T : Value L)
      (values : Fin 3 → Value L) (worlds : Fin 3 → W)
      (initial failureWorld : W) (history : List (Event L))
      (position : Fin 3) (error : Value L),
    let successful := successfulReplies values worlds
    let remaining := successful.drop (position.val + 1)
    let before : ProbeWorld W L :=
      ⟨initial, successful.take position.val ++ [.thrown error failureWorld] ++ remaining,
        history⟩
    let after : ProbeWorld W L :=
      ⟨failureWorld, remaining,
        history ++ (requiredEvents bindings T select values worlds).take (position.val + 1)⟩
    fallback (observingOps ops select) bindings T before =
      some (.error (error, after))

/-- Divergence in ndims, type application, or the actually selected
constructor remains divergence after arbitrary preceding effects.
Source: base/broadcast.jl:97,103. -/
def DivergenceObservations : Prop :=
  ∀ {W L : Type} (ops : CoreOps (ProbeWorld W L) L)
      (select : Value L → W → ConstructorMethod)
      (bindings : Bindings L) (T : Value L)
      (values : Fin 3 → Value L) (worlds : Fin 3 → W)
      (initial : W) (history : List (Event L)) (position : Fin 3),
    let successful := successfulReplies values worlds
    let before : ProbeWorld W L :=
      ⟨initial, successful.take position.val ++ [.diverged] ++
        successful.drop (position.val + 1), history⟩
    fallback (observingOps ops select) bindings T before = none

/-- Complete observable success, throw and divergence contract for this
source body. The instrumented operations range over arbitrary replies; no
primitive or selected user call is assumed to satisfy a correctness law. -/
def RuntimeObservations : Prop :=
  SuccessfulObservations ∧ FailureObservations ∧ DivergenceObservations

/-- The fallback itself does not query isa or typeof, nor assert that a
constructor returned a BroadcastStyle. Changing those unused hooks leaves
complete executions unchanged for every runtime, selected callee, input,
world and outcome. This independently rejects an added result assertion or
input-type inspection. Effects inside the actual call/new primitives remain
fixed, so no claim restricts the internals of selected user code.
Source: base/broadcast.jl:103. -/
def NoExtraTypeInspection : Prop :=
  ∀ {W L : Type} (ops : Ops W L)
      (bindings : Bindings L) (T : Value L) (world : W)
      (isa1 isa2 : Value L → Value L → Bool)
      (typeOf1 typeOf2 : Value L → L),
    let first : Ops W L :=
      { ops with toCoreOps := { ops.toCoreOps with isa := isa1, typeOf := typeOf1 } }
    let second : Ops W L :=
      { ops with toCoreOps := { ops.toCoreOps with isa := isa2, typeOf := typeOf2 } }
    fallback first bindings T world = fallback second bindings T world

theorem NoExtraTypeInspection_proven : NoExtraTypeInspection := by
  repeat intro
  rfl

/-- Proposed entries for concatenation in the group's single entries list. -/
theorem RuntimeObservations_proven : RuntimeObservations := by
  unfold RuntimeObservations
  refine ⟨?_, ?_, ?_⟩
  · unfold SuccessfulObservations
    intro W L ops select bindings T values worlds initial history
    cases hs : select (values 1) (worlds 1) <;>
      simp +zetaDelta [fallback, callConstructor, defaultStyleNew, observingOps,
        observe, successfulReplies, requiredEvents, hs, bind, List.append_assoc]
  · unfold FailureObservations
    intro W L ops select bindings T values worlds initial failureWorld history
    cases hs : select (values 1) (worlds 1) <;>
      simp +zetaDelta [Fin.forall_fin_succ, fallback, callConstructor, defaultStyleNew,
        observingOps, observe, successfulReplies, requiredEvents, hs, bind, List.append_assoc]
  · unfold DivergenceObservations
    intro W L ops select bindings T values worlds initial history
    cases hs : select (values 1) (worlds 1) <;>
      simp +zetaDelta [Fin.forall_fin_succ, fallback, callConstructor, defaultStyleNew,
        observingOps, observe, successfulReplies, hs, bind]

def proposedEntries : List Entry := [
  { id := "broadcast-default-style-runtime-observations",
    juliaFile := "base/broadcast.jl",
    juliaFns := ["BroadcastStyle(::Type{T}) where {T}", "DefaultArrayStyle{N}() (generated constructor)"],
    statement := "The fallback observes ndims on the original type, applies DefaultArrayStyle to its exact result, and invokes the constructor selected in the resulting runtime world. It preserves the actual constructor result and world, propagates a throw at each site without later effects, and preserves divergence.",
    source := "base/broadcast.jl:97,103; doc/src/manual/constructors.md:329-342; doc/src/manual/interfaces.md:459-555",
    status := .proven,
    prop := ``JuliaLean.Proofs.base.broadcast.Models2Group5.DefaultStyle.RuntimeObservations,
    thm := some ``JuliaLean.Proofs.base.broadcast.Models2Group5.DefaultStyle.RuntimeObservations_proven,
    notes := "Full selected-fallback domain via Value/CoreOps/CoreM; no Rank/Nat narrowing or callee laws. Known zero-field construction calls defaultStyleNew; custom construction stays open. Proof-side observation scripts are not model implementations. Covers the internal callConstructor helper and necessary generated constructor dependency." },
  { id := "broadcast-default-style-no-extra-type-checks",
    juliaFile := "base/broadcast.jl",
    juliaFns := ["BroadcastStyle(::Type{T}) where {T}"],
    statement := "For every runtime and selected constructor, changing unused isa and typeof hooks leaves the fallback's entire execution unchanged: it adds no input inspection or constructor-result type assertion.",
    source := "base/broadcast.jl:103 (evaluation invariant)",
    status := .proven,
    prop := ``JuliaLean.Proofs.base.broadcast.Models2Group5.DefaultStyle.NoExtraTypeInspection,
    thm := some ``JuliaLean.Proofs.base.broadcast.Models2Group5.DefaultStyle.NoExtraTypeInspection_proven,
    notes := "Universal noninterference property, falsifiable by an unjustified type assertion. Includes arbitrary values, errors, worlds and divergence, with no correctness law for dispatch targets." }
]

end JuliaLean.Proofs.base.broadcast.Models2Group5.DefaultStyle


/- STATEMENT FRAGMENT: the model fragments above must already be imported.
