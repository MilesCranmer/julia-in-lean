      (bindings : Bindings L) (bc index : Value L)
      (values : Nat → Value L) (worlds : Nat → W) (initial : W)
      (history : List (Event L)) (suffix : List (Reply W L)),
    CheckOutcome core (cartesian (observingOps core) bindings bc index)
      values worlds initial history suffix
      [.call bindings.axes [bc],
       .call bindings.checkboundsIndices
        [JuliaLean.base.boot.coreV core "Bool", values 0,
         JuliaLean.base.boot.tupleV core [index]]]
      (.call bindings.throwBoundsError [bc, index])

