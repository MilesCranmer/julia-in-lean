namespace JuliaLean.Proofs.base.broadcast.Models2Group5.MaterialForward

open JuliaLean
open JuliaLean.Registry
open JuliaLean.base.expr (Value)
open JuliaLean.base.boot (CoreOps CoreM)
open JuliaLean.base.broadcast.Models2Group5.MaterialForward
open JuliaLean.Proofs.base.broadcast.Models2Group5.ForwardObservations
open JuliaLean.Proofs.base.broadcast.Models2Group5.NewIndex (FollowsPlan PrefixFailures)

/-- The original callable/varargs reach broadcasted before its exact result
reaches materialize. Every selected result, error, world and divergence is
quantified without a correctness law. Source: base/broadcast.jl:859. -/
def BroadcastRuntime : Prop :=
  ∀ {W L : Type} (bindings : Bindings L) (function : Value L)
      (args : JuliaLean.base.broadcast.Models2Group5.Constructors.ArgumentTuple L),
    ReturnsLastAfter (W := W) (L := L) 1
      (fun ops => broadcast ops bindings function args)
      (fun ops values _ _ =>
        [.splat bindings.iterate
          [bindings.broadcasted, JuliaLean.base.boot.tupleV ops [function],
           JuliaLean.base.boot.tupleV ops args.values],
         .call bindings.materialize [values 0]])

/-- Tuple broadcasting retains every original tuple and callable reference
and the complete selected map outcome. Equal source tuple lengths are trusted
dispatch metadata; no list zip/filterMap, pure callable, or first-error loss
is permitted by this one-call contract. Source: base/broadcast.jl:863. -/
def TupleBroadcastRuntime : Prop :=
  ∀ {W L : Type} (bindings : Bindings L) (function first : Value L)
      (rest : JuliaLean.base.broadcast.Models2Group5.Constructors.ArgumentTuple L),
    ReturnsLastAfter (W := W) (L := L) 0
      (fun ops => tupleBroadcast ops bindings function first rest)
      (fun ops _ _ _ =>
        [.splat bindings.iterate
          [bindings.map, JuliaLean.base.boot.tupleV ops [function, first],
           JuliaLean.base.boot.tupleV ops rest.values]])

/-- The mutating broadcast's returned identity is its original destination,
while all actual selected mutation/error worlds survive. In particular dest
is not silently included as a source argument. Source: broadcast.jl:865-898. -/
def BroadcastBangRuntime : Prop :=
  ∀ {W L : Type} (core : CoreOps (ProbeWorld W L) L)
      (bindings : Bindings L) (function dest : Value L)
      (args : JuliaLean.base.broadcast.Models2Group5.Constructors.ArgumentTuple L)
      (values : Nat → Value L) (worlds : Nat → W) (initial : W)
      (history : List (Event L)) (suffix : List (Reply W L)),
    FollowsPlan (broadcastBang (observingOps core) bindings function dest args)
      values worlds initial history suffix
      [.splat bindings.iterate
        [bindings.broadcasted, JuliaLean.base.boot.tupleV core [function],
         JuliaLean.base.boot.tupleV core args.values],
       .call bindings.materializeBang [dest, values 0]] dest

/-- Full branching observation contract for source908: only a true Bool
zero-dimensional test reaches similar/fill!, and it uses typeof(the actual
materialized value). False preserves that original value after the five
mandatory operations. Non-Bool reports the exact conditional TypeError.
All selected calls may return any value, mutate, throw or diverge; no law
asserts axes/length/equality or the allocation/fill result is conventional. -/
def PreservingZeroRuntime : Prop :=
  ∀ {W L : Type} (core : CoreOps (ProbeWorld W L) L)
      (bindings : Bindings L) (function : Value L)
      (args : JuliaLean.base.broadcast.Models2Group5.Constructors.ArgumentTuple L)
      (values : Nat → Value L) (worlds : Nat → W) (initial : W)
      (history : List (Event L)) (suffix : List (Reply W L)),
    let action := preservingZero (observingOps core) bindings function args
    let priorReplies : List (Event L) :=
      [.splat bindings.iterate
        [bindings.broadcasted, JuliaLean.base.boot.tupleV core [function],
         JuliaLean.base.boot.tupleV core args.values],
       .call bindings.materialize [values 0],
       .call bindings.axes [values 0],
       .call bindings.length [values 2],
       .call bindings.equal [values 3, JuliaLean.base.boot.intV core (JInt.lit .i64 0)]]
    let flag := match values 4 with | .leaf leaf => core.asBool leaf | _ => none
    match flag with
    | some true =>
        FollowsPlan action values worlds initial history suffix
          (priorReplies ++ [.call bindings.similar [values 0, .leaf (core.typeOf (values 1))],
                      .call bindings.fillBang [values 5, values 1]]) (values 6)
    | some false => FollowsPlan action values worlds initial history suffix priorReplies (values 1)
    | none =>
        let successful : List (Reply W L) :=
          (List.range 5).map (fun position => .returned (values position) (worlds position))
        let before : ProbeWorld W L := ⟨initial, successful ++ suffix, history⟩
        let after : ProbeWorld W L := ⟨worlds 4, suffix, history ++ priorReplies⟩
        PrefixFailures action values worlds initial history suffix priorReplies ∧
        action before = some (.error
          (JuliaLean.base.boot.objV core (.typeError (.symbol "if")
            (JuliaLean.base.boot.strV core "") (JuliaLean.base.boot.coreV core "Bool")
            (values 4)), after))

/-- The source913 nullary callable must complete before fill sees its exact
result. No ZeroD wrapper can replace the actual selected allocation or hide
an exception as an element. Source: base/broadcast.jl:913. -/
def PreservingNullaryRuntime : Prop :=
  ∀ {W L : Type} (bindings : Bindings L) (function : Value L),
    ReturnsLastAfter (W := W) (L := L) 1
      (fun ops => preservingNullary ops bindings function)
      (fun _ values _ _ => [.call function [], .call bindings.fill [values 0]])

/-- Number-vararg evaluation preserves argument identities, the actual
callable reply and all selected fill outcomes. Source: base/broadcast.jl:914. -/
def PreservingNumbersRuntime : Prop :=
  ∀ {W L : Type} (bindings : Bindings L) (function : Value L)
      (args : JuliaLean.base.broadcast.Models2Group5.Constructors.ArgumentTuple L),
    ReturnsLastAfter (W := W) (L := L) 1
      (fun ops => preservingNumbers ops bindings function args)
      (fun ops values _ _ =>
        [.splat bindings.iterate [function, JuliaLean.base.boot.tupleV ops args.values],
         .call bindings.fill [values 0]])

/-- instantiate precedes copy; custom returned types and every outcome are
preserved. This is an effect/provenance invariant rather than a claim that
all custom copies allocate or preserve a particular shape. Source921. -/
def MaterializeRuntime : Prop :=
  ∀ {W L : Type} (bindings : Bindings L) (bc : Value L),
    ReturnsLastAfter (W := W) (L := L) 1
      (fun ops => materialize ops bindings bc)
      (fun _ values _ _ =>
        [.call bindings.instantiate [bc], .call bindings.copy [values 0]])

/-- Source932's actual fields, constructor, instantiate and copyto! calls
retain source order, original destination identity and every arbitrary
returned value/error/world. The method may not bypass any property read or
constructor by rebuilding a simplified record. Source: broadcast.jl:932-934. -/
def MaterializeStyledRuntime : Prop :=
  ∀ {W L : Type} (bindings : Bindings L) (style dest bc : Value L),
    ReturnsLastAfter (W := W) (L := L) 6
      (fun ops => materializeStyled ops bindings style dest bc)
      (fun _ values _ _ =>
        [.call bindings.getproperty [bc, .symbol "style"],
         .call bindings.getproperty [bc, .symbol "f"],
         .call bindings.getproperty [bc, .symbol "args"],
         .call bindings.axes [dest],
         .call bindings.broadcastedConstructor [values 0, values 1, values 2, values 3],
         .call bindings.instantiate [values 4],
         .call bindings.copytoBang [dest, values 5]])

/-- The unused separate style argument cannot change any result, error or
runtime effect. The wrapper's own style property is still evaluated normally.
Source: base/broadcast.jl:932-934. -/
def StyleArgumentIndependent : Prop :=
  ∀ {W L : Type} (ops : CoreOps W L) (bindings : Bindings L)
      (first second dest bc : Value L),
    materializeStyled ops bindings first dest bc =
      materializeStyled ops bindings second dest bc

/-- Zero-dimensional copy uses the concrete empty CartesianIndex, not a
scalar zero/one index or arbitrary selected constructor. The chosen getindex
outcome is preserved without an element purity assumption. Source942/631. -/
def CopyZeroRuntime : Prop :=
  ∀ {W L : Type} (bindings : Bindings L) (bc : Value L),
    ReturnsLastAfter (W := W) (L := L) 0
      (fun ops => copyZero ops bindings bc)
      (fun _ _ _ _ => [.call bindings.getindex [bc, bindings.indexValue (.cartesian [])]])

