def sourceAny {Axis : Type} (predicate : Axis → Shape.Result Bool)
    (axes : List Axis) : Shape.Result Bool :=
  match anyTupleMethod anyTupleLoop anyTupleStep anyTupleDone
      (fun axis => (predicate axis).map PredicateValue.bool) true axes with
  | .ok (some result) => .ok result
  | .ok none => .error .argumentError
  | .error (.predicate error) => .error error
  | .error .typeError => .error .argumentError

private theorem loop_pure {Axis : Type} (predicate : Axis → Bool) (axes : List Axis) :
    anyTupleLoop.loop (ε := Shape.Error) (fun axis => .ok (.bool (predicate axis))) false axes =
      .ok (some (axes.any predicate)) := by
  induction axes with
  | nil => rfl
  | cons axis rest ih =>
