theorem map_getD_range {A : Type} (items : List A) (fallback : A) :
    (List.range items.length).map (fun i => items.getD i fallback) = items := by
  apply List.ext_getElem
  · simp only [List.length_map, List.length_range]
  · intro i hMapped hItems
    simp only [List.getElem_map, List.getElem_range, List.getD_eq_getElem?_getD,
      List.getElem?_eq_getElem hItems, Option.getD_some]

theorem range_drop (count offset : Nat) :
    (List.range count).drop offset = List.range' offset (count - offset) := by
  rw [List.range_eq_range', List.drop_range']
  simp only [Nat.mul_one, Nat.zero_add]

theorem map_getD_range_suffix {A : Type} (items : List A) (fallback : A)
    (offset : Nat) :
    (List.range' offset (items.length - offset)).map (fun i => items.getD i fallback) =
      items.drop offset := by
  rw [← range_drop, List.map_drop, map_getD_range]

theorem map_getD_range_window {A : Type} (items : List A) (fallback : A)
    (offset count : Nat) (bound : offset + count ≤ items.length) :
    (List.range' offset count).map (fun i => items.getD i fallback) =
      (items.drop offset).take count := by
  have remaining : count ≤ items.length - offset := by omega
  rw [← map_getD_range_suffix items fallback offset, ← List.map_take,
    List.take_range'_of_length_ge remaining]

end JuliaLean.ChatGPT.Batch11.Group10.ChunkListProofs

namespace JuliaLean.ChatGPT.Batch11.Group10.ChunkCustomProofs

open JuliaLean
open JuliaLean.base.expr (Value)
open JuliaLean.base.boot (CoreOps CoreM)
open JuliaLean.Proofs.base.broadcast.Models2Group5.ForwardObservations
