theorem conversionEvents_take_tail {L : Type} (bindings : Bindings L)
    (boundscheck : Bool) (bc original : Value L) (values : Nat → Value L)
    (methods : Nat → Method) (depth offset : Nat) (tail : List (ContextEvent L)) :
    (conversionEvents bindings boundscheck bc original values methods depth ++ tail).take
      (3 * depth + offset + 1) =
      conversionEvents bindings boundscheck bc original values methods depth ++ tail.take (offset + 1) := by
  rw [List.take_append, conversionEvents_length]
  have allPrevious :
      (conversionEvents bindings boundscheck bc original values methods depth).take
        (3 * depth + offset + 1) =
      conversionEvents bindings boundscheck bc original values methods depth :=
    take_full _ _ (by rw [conversionEvents_length]; omega)
