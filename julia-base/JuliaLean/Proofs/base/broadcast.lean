theorem nonterminal_window {W L : Type}
    (core : Bool → CoreOps (World W L) L)
    (select : Value L → Value L → Value L → W → Method)
    (bindings : Bindings L) (style bc original : Value L) (boundscheck : Bool)
    (values : Nat → Value L) (worlds : Nat → W) (methods : Nat → Method)
    (coherent : ∀ step, methods (step + 1) =
      select style bc (values (3 * step + 2)) (worlds (3 * step + 2)))
    (initial : W) (history : List (ContextEvent L)) (suffix : List (Reply W L))
    (depth : Nat) (depthPositive : 0 < depth)
    (nonterminal : ∀ step, step < depth → isTerminal (methods step) = false) :
    ContinuesAfter
      (runMethod (observingDispatch core select) bindings (methods 0)
        style bc original boundscheck)
      (3 * depth) values worlds
      (conversionEvents bindings boundscheck bc original values methods depth)
      initial history suffix := by
  unfold ContinuesAfter FailurePrefixes
  refine ⟨by omega, conversionEvents_length _ _ _ _ _ _ _, ?_, ?_, ?_⟩
  · have stepped := run_conversion_prefix core select bindings style bc original boundscheck
      values worlds methods coherent initial history [] depth nonterminal
    have stopped := run_empty core select bindings (methods depth) style bc
      (indexAt original values depth) boundscheck (payloadAt initial worlds depth)
      (history ++ conversionEvents bindings boundscheck bc original values methods depth)
    simpa only [List.append_nil] using stepped.trans stopped
  · intro position error failureWorld
    have bound : position.val < 3 * depth := by
      simpa only [successes, List.length_map, List.length_range] using position.isLt
    rw [successes_take (3 * depth) position.val values worlds (Nat.le_of_lt bound)]
    simpa only [List.append_nil, List.cons_append, List.nil_append, List.append_assoc] using
      run_prefix_throw core select bindings style bc original boundscheck values worlds
        methods coherent initial history
        ((successes (3 * depth) values worlds).drop (position.val + 1) ++ suffix)
        depth position.val [] error failureWorld nonterminal bound
  · intro position
    have bound : position.val < 3 * depth := by
      simpa only [successes, List.length_map, List.length_range] using position.isLt
    rw [successes_take (3 * depth) position.val values worlds (Nat.le_of_lt bound)]
    simpa only [List.cons_append, List.nil_append, List.append_assoc] using
      run_prefix_diverge core select bindings style bc original boundscheck values worlds
        methods coherent initial history
        ((successes (3 * depth) values worlds).drop (position.val + 1) ++ suffix)
        depth position.val nonterminal bound


theorem terminal_window {W L : Type}
    (core : Bool → CoreOps (World W L) L)
    (select : Value L → Value L → Value L → W → Method)
    (bindings : Bindings L) (style bc original : Value L) (boundscheck : Bool)
    (values : Nat → Value L) (worlds : Nat → W) (methods : Nat → Method)
    (coherent : ∀ step, methods (step + 1) =
      select style bc (values (3 * step + 2)) (worlds (3 * step + 2)))
    (initial : W) (history : List (ContextEvent L)) (suffix : List (Reply W L))
    (depth : Nat)
    (nonterminal : ∀ step, step < depth → isTerminal (methods step) = false)
    (terminal : isTerminal (methods depth) = true) :
    let tail := terminalEvents bindings boundscheck style bc
      (indexAt original values depth) (methods depth)
    ReturnsLast
      (runMethod (observingDispatch core select) bindings (methods 0)
        style bc original boundscheck)
      (3 * depth + tail.length) values worlds
      (conversionEvents bindings boundscheck bc original values methods depth ++ tail)
      initial history suffix := by
  let tail := terminalEvents bindings boundscheck style bc
    (indexAt original values depth) (methods depth)
  have tailPositive : 0 < tail.length := terminal_positive bindings boundscheck style bc
    (indexAt original values depth) (methods depth) terminal
  change ReturnsLast
    (runMethod (observingDispatch core select) bindings (methods 0)
      style bc original boundscheck)
    (3 * depth + tail.length) values worlds
    (conversionEvents bindings boundscheck bc original values methods depth ++ tail)
    initial history suffix
  unfold ReturnsLast FailurePrefixes
  refine ⟨by omega, ?_, ?_, ?_, ?_⟩
  · rw [List.length_append, conversionEvents_length]
  · rw [successes_add, List.append_assoc]
    rw [run_conversion_prefix core select bindings style bc original boundscheck values worlds
      methods coherent initial history
      (successes tail.length (fun i => values (3 * depth + i))
        (fun i => worlds (3 * depth + i)) ++ suffix) depth nonterminal]
    simpa only [List.append_assoc, tail] using
      run_terminal_success core select bindings (methods depth) style bc
        (indexAt original values depth) boundscheck values worlds (3 * depth)
        (payloadAt initial worlds depth)
        (history ++ conversionEvents bindings boundscheck bc original values methods depth)
        suffix terminal
  · intro position error failureWorld
    have bound : position.val < 3 * depth + tail.length := by
      simpa only [successes, List.length_map, List.length_range] using position.isLt
    rw [successes_take (3 * depth + tail.length) position.val values worlds (Nat.le_of_lt bound)]
    by_cases early : position.val < 3 * depth
    · simpa only [List.cons_append, List.nil_append, List.append_assoc] using
        run_prefix_throw core select bindings style bc original boundscheck values worlds
          methods coherent initial history
          ((successes (3 * depth + tail.length) values worlds).drop (position.val + 1) ++ suffix)
          depth position.val tail error failureWorld nonterminal early
    · let remaining :=
        (successes (3 * depth + tail.length) values worlds).drop (position.val + 1) ++ suffix
      simp only [List.append_assoc]
      change runMethod (observingDispatch core select) bindings (methods 0)
        style bc original boundscheck
        ⟨initial, successes position.val values worlds ++ (.thrown error failureWorld :: remaining),
          history⟩ =
        some (.error (error, ⟨failureWorld, remaining,
          history ++ (conversionEvents bindings boundscheck bc original values methods depth ++
            tail).take (position.val + 1)⟩))
      let offset := position.val - 3 * depth
      have positionEq : position.val = 3 * depth + offset := by dsimp [offset]; omega
      have offsetBound : offset < tail.length := by dsimp [offset]; omega
      rw [positionEq, successes_add]
      simp only [List.append_assoc]
      rw [run_conversion_prefix core select bindings style bc original boundscheck values worlds
        methods coherent initial history
        (successes offset (fun i => values (3 * depth + i))
          (fun i => worlds (3 * depth + i)) ++ (.thrown error failureWorld :: remaining))
        depth nonterminal]
      rw [conversionEvents_take_tail bindings boundscheck bc original values methods depth offset tail]
      simpa only [List.append_assoc, List.cons_append, List.nil_append, tail] using
        run_terminal_throw core select bindings (methods depth) style bc
          (indexAt original values depth) boundscheck values worlds (3 * depth)
          (payloadAt initial worlds depth)
          (history ++ conversionEvents bindings boundscheck bc original values methods depth)
          remaining offset error failureWorld terminal offsetBound
  · intro position
    have bound : position.val < 3 * depth + tail.length := by
      simpa only [successes, List.length_map, List.length_range] using position.isLt
    rw [successes_take (3 * depth + tail.length) position.val values worlds (Nat.le_of_lt bound)]
    by_cases early : position.val < 3 * depth
    · simpa only [List.cons_append, List.nil_append, List.append_assoc] using
        run_prefix_diverge core select bindings style bc original boundscheck values worlds
          methods coherent initial history
          ((successes (3 * depth + tail.length) values worlds).drop (position.val + 1) ++ suffix)
          depth position.val nonterminal early
    · let remaining :=
        (successes (3 * depth + tail.length) values worlds).drop (position.val + 1) ++ suffix
      simp only [List.append_assoc]
      change runMethod (observingDispatch core select) bindings (methods 0)
        style bc original boundscheck
        ⟨initial, successes position.val values worlds ++ (.diverged :: remaining), history⟩ = none
      let offset := position.val - 3 * depth
      have positionEq : position.val = 3 * depth + offset := by dsimp [offset]; omega
      have offsetBound : offset < tail.length := by dsimp [offset]; omega
      rw [positionEq, successes_add]
      simp only [List.append_assoc]
      rw [run_conversion_prefix core select bindings style bc original boundscheck values worlds
        methods coherent initial history
        (successes offset (fun i => values (3 * depth + i))
          (fun i => worlds (3 * depth + i)) ++ (.diverged :: remaining))
        depth nonterminal]
      simpa only [List.cons_append, List.nil_append] using
        run_terminal_diverge core select bindings (methods depth) style bc
          (indexAt original values depth) boundscheck values worlds (3 * depth)
          (payloadAt initial worlds depth)
          (history ++ conversionEvents bindings boundscheck bc original values methods depth)
          remaining offset terminal offsetBound


def RunObservations (entry : Method) : Prop :=
  ∀ {W L : Type} (core : Bool → CoreOps (World W L) L)
      (select : Value L → Value L → Value L → W → Method)
      (bindings : Bindings L) (style bc index : Value L) (boundscheck : Bool)
      (values : Nat → Value L) (worlds : Nat → W) (initial : W)
      (history : List (ContextEvent L)) (suffix : List (Reply W L)) (window : Nat),
    let methods := methodAt select entry style bc values worlds
    let action := runMethod (observingDispatch core select) bindings entry style bc index boundscheck
    match (List.range (window + 1)).find? (fun depth => isTerminal (methods depth)) with
    | none =>
        ContinuesAfter action (3 * (window + 1)) values worlds
          (conversionEvents bindings boundscheck bc index values methods (window + 1))
          initial history suffix
    | some depth =>
        let tail := terminalEvents bindings boundscheck style bc
          (indexAt index values depth) (methods depth)
        depth ≤ window ∧ isTerminal (methods depth) = true ∧
        ReturnsLast action (3 * depth + tail.length) values worlds
          (conversionEvents bindings boundscheck bc index values methods depth ++ tail)
          initial history suffix

theorem run_observations (entry : Method) : RunObservations entry := by
  intro W L core select bindings style bc index boundscheck values worlds initial history suffix window
  dsimp only
  let methods := methodAt select entry style bc values worlds
  have coherent : ∀ step, methods (step + 1) =
      select style bc (values (3 * step + 2)) (worlds (3 * step + 2)) := by
    intro step
    dsimp only [methods, methodAt]
    have last : 3 * (step + 1) - 1 = 3 * step + 2 := by omega
    rw [last]
  split
  · rename_i found
    have all := List.find?_range_eq_none.mp found
    have nonterminal : ∀ step, step < window + 1 → isTerminal (methods step) = false := by
      intro step bound
      have stopped : (!isTerminal (methods step)) = true := all step bound
      cases selected : isTerminal (methods step) <;>
        simp only [selected, Bool.not_false, Bool.not_true, Bool.false_eq_true] at stopped ⊢
    exact nonterminal_window core select bindings style bc index boundscheck values worlds
      methods coherent initial history suffix (window + 1) (by omega) nonterminal
  · rename_i depth found
    obtain ⟨terminal, member, earlier⟩ := List.find?_range_eq_some.mp found
    have depthBound : depth ≤ window := by
      have inRange := List.mem_range.mp member
      omega
    have nonterminal : ∀ step, step < depth → isTerminal (methods step) = false := by
      intro step bound
      have stopped : (!isTerminal (methods step)) = true := earlier step bound
      cases selected : isTerminal (methods step) <;>
        simp only [selected, Bool.not_false, Bool.not_true, Bool.false_eq_true] at stopped ⊢
    refine ⟨depthBound, terminal, ?_⟩
    exact terminal_window core select bindings style bc index boundscheck values worlds
      methods coherent initial history suffix depth nonterminal terminal

end ConversionProofs
end EvaluationProofs

theorem BroadcastIndexCartesianRecursiveProvenance_proven :
    JuliaLean.Proofs.base.broadcast.Models2Group5.IndexAccess.CartesianIntegerObservations :=
  EvaluationProofs.ConversionProofs.run_observations .cartesianInteger

theorem BroadcastIndexLinearRecursiveProvenance_proven :
    JuliaLean.Proofs.base.broadcast.Models2Group5.IndexAccess.LinearCartesianObservations :=
  EvaluationProofs.ConversionProofs.run_observations .linearCartesian

