    statement := "Every style-resolution exception stops inferred construction at the failed source call, preserving the thrown Julia object, world, call trace and unconsumed effects.",
    source := "base/broadcast.jl:181-183,431 (exception and effect-order invariant)",
    status := .proven,
    prop := ``JuliaLean.Proofs.base.broadcast.Models2Group5.Constructors.StyleFailureStopsConstruction,
    thm := some `JuliaLean.Proofs.base.broadcast.Models2Group5.Constructors.StyleFailureStopsConstruction_proven,
    notes := "Includes both nullary dependency operations and the generic nonempty splatted call; arbitrary callee outcomes, no correctness laws." },
