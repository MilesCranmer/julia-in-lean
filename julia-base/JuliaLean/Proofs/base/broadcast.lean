/-- A genuinely selected custom suffix receives exactly the original index and argument list. -/
theorem runCustomSuffix {W L : Type}
    (other : JuliaLean.base.broadcast.Models2Group5.Iteration.ContextOps (ProbeWorld W L) L)
    (core : CoreOps (ProbeWorld W L) L)
    (bindings : JuliaLean.base.broadcast.Models2Group5.IthChunk.Bindings L)
    (index : Value L) (arguments : List (Value L)) (boundscheck : Bool) :
    JuliaLean.base.broadcast.Models2Group5.IthChunk.run
      (JuliaLean.Proofs.base.broadcast.Models2Group5.IthChunk.customOps other core boundscheck)
      bindings boundscheck none index arguments =
      core.call bindings.ithchunk (index :: arguments) := by
  cases boundscheck <;> cases arguments <;> rfl

/-- Replacing returned payloads with corresponding events preserves the number of reads. -/
theorem filteredLength {A B C : Type} (positions : List A) (keep : A → Bool)
    (first : A → B) (second : A → C) :
    (positions.filterMap (fun position => if keep position then some (first position) else none)).length =
    (positions.filterMap (fun position => if keep position then some (second position) else none)).length := by
  induction positions with
  | nil => rfl
  | cons head tail ih =>
      cases h : keep head with
      | false =>
          simpa only [List.filterMap_cons, h, Bool.false_eq_true, ite_false, ite_true] using ih
      | true =>
          simpa only [List.filterMap_cons, h, Bool.false_eq_true, ite_false, ite_true, List.length_cons] using congrArg Nat.succ ih

/-- Descending selected reads and one ascending assembly per position have matching event/reply counts. -/
theorem pairedTraceLength {A B C : Type} (positions : List A) (keep : A → Bool)
    (firstRead firstJoin : A → B) (secondRead secondJoin : A → C) :
    ((positions.filterMap (fun position => if keep position then some (firstRead position) else none)) ++
      positions.reverse.map firstJoin).length =
    ((positions.filterMap (fun position => if keep position then some (secondRead position) else none)) ++
      positions.reverse.map secondJoin).length := by
  have h := filteredLength positions keep firstRead secondRead
  simpa only [List.length_append, List.length_map] using
    congrArg (fun n => n + positions.reverse.length) h

