namespace JuliaLean.Proofs.base.broadcast.Models2Group5.ConstructorProbe

open JuliaLean.base.expr (Value)
open JuliaLean.base.boot (CoreOps CoreM)
open JuliaLean.base.broadcast.Models2Group5

/-- Observations of the already-installed runtime boundaries. -/
inductive Event (L : Type) where
  | applyType (constructor : Value L) (parameters : List (Value L))
  | call (function : Value L) (arguments : List (Value L))
  | new (type : Value L) (fields : List (Value L))

/-- Arbitrary terminating and nonterminating replies; no correctness law is
attached to a callee's value, exception, or changed world. -/
inductive Reply (W L : Type) where
  | returned (value : Value L) (world : W)
  | thrown (error : Value L) (world : W)
  | diverged

/-- A finite test observation, not a Julia tuple or array. -/
structure World (W L : Type) where
  payload : W
  replies : List (Reply W L)
  events : List (Event L)

def observe {W L : Type} (event : Event L) :
    CoreM (World W L) L (Value L) := fun world =>
  match world.replies with
  | [] => none
  | .diverged :: _ => none
  | .returned value payload :: replies =>
      some (.ok (value, ⟨payload, replies, world.events ++ [event]⟩))
  | .thrown error payload :: replies =>
      some (.error (error, ⟨payload, replies, world.events ++ [event]⟩))

def observingCore {W L : Type} (ops : CoreOps (World W L) L) :
    CoreOps (World W L) L :=
  { ops with
    applyType := fun constructor parameters => observe (.applyType constructor parameters)
    call := fun function arguments => observe (.call function arguments)
    new := fun type fields => observe (.new type fields) }

def observingDefault {W L : Type} (ops : DefaultStyle.Ops (World W L) L) :
    DefaultStyle.Ops (World W L) L :=
  { ops with
    applyType := fun constructor parameters => observe (.applyType constructor parameters)
    call := fun function arguments => observe (.call function arguments)
    new := fun type fields => observe (.new type fields) }

/-- Observe any final selected callee's reply, without a return-type promise.
This helper has no knowledge of the broadcast algorithm or its arguments. -/
def replyOutcome {W L : Type} (reply : Reply W L)
    (remaining : List (Reply W L)) (events : List (Event L)) :
    Option (Except (Value L × World W L) (Value L × World W L)) :=
  match reply with
  | .returned value payload => some (.ok (value, ⟨payload, remaining, events⟩))
  | .thrown error payload => some (.error (error, ⟨payload, remaining, events⟩))
  | .diverged => none

end JuliaLean.Proofs.base.broadcast.Models2Group5.ConstructorProbe

namespace JuliaLean.Proofs.base.broadcast.Models2Group5.Constructors

open JuliaLean
