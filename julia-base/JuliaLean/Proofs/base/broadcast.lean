namespace JuliaLean.Proofs.base.broadcast.Models2Group5.ChunkedCheck

open JuliaLean
open JuliaLean.Registry
open JuliaLean.base.expr (Value)
open JuliaLean.base.boot (CoreOps CoreM)
open JuliaLean.base.broadcast.Models2Group5.ChunkedCheck
open JuliaLean.base.broadcast.Models2Group5.NewIndex (TupleGetMethod)
open JuliaLean.Proofs.base.broadcast.Models2Group5.ForwardObservations
open JuliaLean.Proofs.base.broadcast.Models2Group5.NewIndex (FollowsPlan PrefixFailures)

/-- Observe runtime calls and lift arbitrary current-world dispatch metadata.
The observation list is not visible to the actual Julia world or selectors. -/
def instrument {W L : Type} (core : CoreOps (ProbeWorld W L) L)
    (two : Value L → Value L → W → Method)
    (three : Value L → Value L → Value L → W → Method)
    (get : Value L → JInt .i64 → W → TupleGetMethod) : Ops (ProbeWorld W L) L where
  toIntegerOps := { toOps := { toCoreOps := observingOps core, selectedIfElse := fun _ _ _ _ => .missing }, selectedKeepGet := fun tuple index world => get tuple index world.payload }
  selectedTwo := fun result value world => two result value world.payload
  selectedThree := fun result value function world => three result value function world.payload

def headEvent {W L : Type} (core : CoreOps (ProbeWorld W L) L)
    (bindings : Bindings L) (get : Value L → JInt .i64 → W → TupleGetMethod)
    (value : Value L) (world : W) : Event L :=
  let one := JuliaLean.base.boot.intV core (JInt.lit .i64 1)
  match get value (JInt.lit .i64 1) world with
  | .builtin => .getfield value one
  | .custom => .call bindings.getindex [value, one]

/-- Every public source prefix is evaluated in the indicated order even with
arbitrary recursive dispatch, native/custom tuple access and worlds. No later
recursive work can replace a thrown value, hide its world, or execute before
a mandatory prefix completes. The Bool-head source does not read its head.
This invariant covers all input values and all selected-method metadata.
Source: base/broadcast.jl:1098-1104. -/
def PrefixRuntime : Prop :=
  ∀ {W L : Type} (core : CoreOps (ProbeWorld W L) L)
      (two : Value L → Value L → W → Method)
      (three : Value L → Value L → Value L → W → Method)
      (get : Value L → JInt .i64 → W → TupleGetMethod)
      (bindings : Bindings L) (result value function : Value L)
      (values : Nat → Value L) (worlds : Nat → W) (initial : W)
      (history : List (Event L)) (suffix : List (Reply W L)),
    let ops := instrument core two three get
    PrefixFailures (wrapper ops bindings result value) values worlds initial history suffix
      [.call bindings.getproperty [value, .symbol "f"],
       .call bindings.getproperty [value, .symbol "args"],
       .call bindings.chunkop [values 0, values 1]] ∧
    PrefixFailures (withFunction ops bindings result value function)
      values worlds initial history suffix
      [.call bindings.getproperty [value, .symbol "args"]] ∧
    PrefixFailures (bitHead ops bindings result value) values worlds initial history suffix
      [.call bindings.size [result], headEvent core bindings get value (worlds 0),
       .call bindings.size [values 1], .call bindings.equal [values 0, values 2]] ∧
    PrefixFailures (boolHead ops bindings result value) values worlds initial history suffix
      [.call bindings.tail [value]] ∧
    PrefixFailures (wrapperHead ops bindings result value) values worlds initial history suffix
      [headEvent core bindings get value initial]

/-- Independent outcome rule for &&: false returns literal false, true reaches
only the prescribed subsequent calls, and non-Bool raises the actual TypeError
without touching the suffix. All calls retain their arbitrary outcomes.
The plan lists observations only and never evaluates a Julia operation. -/
def AndOutcome {W L : Type} (core : CoreOps (ProbeWorld W L) L)
    (action : CoreM (ProbeWorld W L) L (Value L))
    (values : Nat → Value L) (worlds : Nat → W) (initial : W)
    (history : List (Event L)) (suffix : List (Reply W L))
    (priorReplies continuation : List (Event L)) (returned : Value L) : Prop :=
  let count := priorReplies.length
  let checked := values (count - 1)
  let flag := match checked with | .leaf leaf => core.asBool leaf | _ => none
  0 < count ∧
    match flag with
    | some true => FollowsPlan action values worlds initial history suffix
        (priorReplies ++ continuation) returned
    | some false => FollowsPlan action values worlds initial history suffix priorReplies
        (JuliaLean.base.boot.boolV core false)
    | none =>
        let successful : List (Reply W L) :=
          (List.range count).map (fun pos => .returned (values pos) (worlds pos))
        let before : ProbeWorld W L := ⟨initial, successful ++ suffix, history⟩
        let after : ProbeWorld W L := ⟨worlds (count - 1), suffix, history ++ priorReplies⟩
        PrefixFailures action values worlds initial history suffix priorReplies ∧
        action before = some (.error
          (JuliaLean.base.boot.objV core (.typeError (.symbol "if")
            (JuliaLean.base.boot.strV core "") (JuliaLean.base.boot.coreV core "Bool") checked),
           after))

/-- Wrapper dispatch retains the actual chunkop result as the third argument.
A selected Nothing method stops after the three mandatory calls. A selected
with-function Base method really reads args again before its two-argument
custom target; it cannot be replaced by the old arbitrary recursive callback.
All operation outcomes and original wrapper/result identities are observed.
Source: base/broadcast.jl:1098-1100. -/
def WrapperPaths : Prop :=
  ∀ {W L : Type} (core : CoreOps (ProbeWorld W L) L) (bindings : Bindings L)
      (result value : Value L) (values : Nat → Value L) (worlds : Nat → W)
      (initial : W) (history : List (Event L)) (suffix : List (Reply W L)),
    let priorReplies : List (Event L) :=
      [.call bindings.getproperty [value, .symbol "f"],
       .call bindings.getproperty [value, .symbol "args"],
       .call bindings.chunkop [values 0, values 1]]
    let make := fun method => instrument core (fun _ _ _ => .customTwo)
      (fun _ _ _ _ => method) (fun _ _ _ => .builtin)
    FollowsPlan (wrapper (make .noFunction) bindings result value)
      values worlds initial history suffix priorReplies (JuliaLean.base.boot.boolV core false) ∧
    FollowsPlan (wrapper (make .customThree) bindings result value)
      values worlds initial history suffix
      (priorReplies ++ [.call bindings.ischunked [result, value, values 2]]) (values 3) ∧
    FollowsPlan (wrapper (make .withFunction) bindings result value)
      values worlds initial history suffix
      (priorReplies ++ [.call bindings.getproperty [value, .symbol "args"],
                  .call bindings.ischunked [result, values 3]]) (values 4)

/-- The already selected three-argument fallback ignores its function operand
for every possible recursive behavior, state, exception and divergence. Its
args property result must reach the selected two-argument call unchanged.
Source: base/broadcast.jl:1100. -/
def WithFunctionRuntime : Prop :=
  (∀ {W L : Type} (ops : Ops W L) (bindings : Bindings L)
      (result value first second : Value L),
    withFunction ops bindings result value first =
      withFunction ops bindings result value second) ∧
  (∀ {W L : Type} (bindings : Bindings L) (result value function : Value L),
    ReturnsLastAfter (W := W) (L := L) 1
      (fun core => withFunction
        (instrument core (fun _ _ _ => .customTwo)
          (fun _ _ _ _ => .customThree) (fun _ _ _ => .builtin))
        bindings result value function)
      (fun _ values _ _ =>
        [.call bindings.getproperty [value, .symbol "args"],
         .call bindings.ischunked [result, values 0]]))

/-- A bit-array head checks size(R) before touching its tuple slot, compares
both actual size results, and obtains/recurses on the tail only after true.
A nested-wrapper head fully evaluates that head before any tail access. Both
checks retain false, non-Bool, errors and divergence without a shape law.
Source: base/broadcast.jl:1102,1104. -/
def ShortCircuitRuntime : Prop :=
  ∀ {W L : Type} (core : CoreOps (ProbeWorld W L) L) (bindings : Bindings L)
      (get : Value L → JInt .i64 → W → TupleGetMethod)
      (result value : Value L) (values : Nat → Value L) (worlds : Nat → W)
      (initial : W) (history : List (Event L)) (suffix : List (Reply W L)),
    let ops := instrument core (fun _ _ _ => .customTwo)
      (fun _ _ _ _ => .customThree) get
    AndOutcome core (bitHead ops bindings result value) values worlds initial history suffix
      [.call bindings.size [result], headEvent core bindings get value (worlds 0),
       .call bindings.size [values 1], .call bindings.equal [values 0, values 2]]
      [.call bindings.tail [value], .call bindings.ischunked [result, values 4]] (values 5) ∧
    AndOutcome core (wrapperHead ops bindings result value) values worlds initial history suffix
      [headEvent core bindings get value initial,
       .call bindings.ischunked [result, values 0]]
      [.call bindings.tail [value], .call bindings.ischunked [result, values 2]] (values 3)

/-- Arbitrary positive finite chains of Bool-head tuples execute one tail call
per level and never inspect a Bool slot. All three actual terminal families
are covered: installed false fallback, installed true empty tuple, and a
custom target with arbitrary return/effects. The model has no depth input;
the Nat cursor is proof instrumentation in otherwise arbitrary worlds.
Every error/divergence prefix and unused reply suffix is retained.
Source: base/broadcast.jl:1101,1103,1105. -/
def BoolRecursionRuntime : Prop :=
  ∀ {W L : Type} (core : CoreOps (ProbeWorld (Nat × W) L) L)
      (bindings : Bindings L) (result : Value L) (arguments : Nat → Value L)
      (customResult : Value L) (worlds : Nat → W) (initial : W)
      (history : List (Event L)) (suffix : List (Reply (Nat × W) L))
      (depth : Nat) (terminal : Option Bool),
    let frames := depth + 1
    let terminalMethod := match terminal with
      | some true => Method.empty
      | some false => Method.fallback
      | none => Method.customTwo
    let ops := instrument core
      (fun _ _ world => if world.1 = frames then terminalMethod else .boolHead)
      (fun _ _ _ _ => .customThree) (fun _ _ _ => .builtin)
    let values := fun position => if position < frames then arguments (position + 1)
      else customResult
    let prescribed := (List.range frames).map (fun position =>
      Event.call bindings.tail [arguments position]) ++
      (match terminal with
       | some _ => []
       | none => [.call bindings.ischunked [result, arguments frames]])
    let returned := match terminal with
      | some flag => JuliaLean.base.boot.boolV core flag
      | none => customResult
    FollowsPlan (boolHead ops bindings result (arguments 0)) values
      (fun position => (position + 1, worlds position)) (0, initial) history suffix
      prescribed returned

def WrapperContract : Prop := PrefixRuntime ∧ WrapperPaths

def FunctionContract : Prop := PrefixRuntime ∧ WithFunctionRuntime

def BitHeadContract : Prop := PrefixRuntime ∧ ShortCircuitRuntime

def BoolHeadContract : Prop := PrefixRuntime ∧ BoolRecursionRuntime

def WrapperHeadContract : Prop := PrefixRuntime ∧ ShortCircuitRuntime


