namespace JuliaLean.Proofs.base.broadcast.Models2Group5.EltypeSampling

open JuliaLean
open JuliaLean.Registry
open JuliaLean.base.expr (Value)
open JuliaLean.base.boot (CoreOps CoreM)
open JuliaLean.base.broadcast.Models2Group5.EltypeSampling
open JuliaLean.Proofs.base.broadcast.Models2Group5.ForwardObservations

/-- Number sampling preserves the exact input value, supplied index and the
entire selected runtime outcome. Number subtypes and custom indexing remain
unrestricted. Source: base/broadcast.jl:747. -/
def NumberObservations : Prop :=
  ∀ {W L : Type} (bindings : Bindings L) (value index : Value L),
    ReturnsLastAfter (W := W) (L := L) 0
      (fun core => sampleNumber core bindings value index)
      (fun _ _ _ _ => [.call bindings.broadcastGetindex [value, index]])

/-- Tuple sampling keeps the entire tuple and index object intact and returns
the selected getter's actual outcome, without specializing index kinds or
assuming an ordinary checked result. Source: base/broadcast.jl:748. -/
def TupleObservations : Prop :=
  ∀ {W L : Type} (bindings : Bindings L) (value index : Value L),
    ReturnsLastAfter (W := W) (L := L) 0
      (fun core => sampleTuple core bindings value index)
      (fun _ _ _ _ => [.call bindings.broadcastGetindex [value, index]])

/-- Sampling precedes the original value's eltype query. The asserted result
is the sampling reply, never the later type reply. The exact builtin isa
decides success versus TypeError; either preceding call may independently
mutate, throw or diverge. Source: base/broadcast.jl:751;
base/essentials.jl:1211 and installed boot.typeassert. -/
def FallbackObservations : Prop :=
  ∀ {W L : Type} (core : CoreOps (ProbeWorld W L) L)
      (bindings : Bindings L) (value index : Value L)
      (values : Fin 2 → Value L) (worlds : Fin 2 → W)
      (initial : W) (history : List (Event L)) (suffix : List (Reply W L)),
    let successful := successfulReplies 1 values worlds
    let prescribed : List (Event L) :=
      [.call bindings.broadcastGetindex [value, index], .call bindings.eltype [value]]
    let action := sampleFallback (observingOps core) bindings value index
    let before : ProbeWorld W L := ⟨initial, successful ++ suffix, history⟩
    let after : ProbeWorld W L := ⟨worlds 1, suffix, history ++ prescribed⟩
    (if core.isa (values 1) (JuliaLean.base.boot.coreV core "Type") then
       if core.isa (values 0) (values 1) then
         action before = some (.ok (values 0, after))
       else action before = some (.error
         (.leaf (core.obj (.typeError (.symbol "typeassert") (.leaf (core.str ""))
           (values 1) (values 0))), after))
     else action before = some (.error
       (.leaf (core.obj (.typeError (.symbol "typeassert") (.leaf (core.str ""))
         (JuliaLean.base.boot.coreV core "Type") (values 1))), after))) ∧
    (∀ (position : Fin 2) (error : Value L) (failureWorld : W),
      let remaining := successful.drop (position.val + 1) ++ suffix
      let failed : ProbeWorld W L :=
        ⟨initial, successful.take position.val ++ [.thrown error failureWorld] ++
          remaining, history⟩
      let stopped : ProbeWorld W L :=
        ⟨failureWorld, remaining, history ++ prescribed.take (position.val + 1)⟩
      action failed = some (.error (error, stopped))) ∧
    (∀ position : Fin 2,
      let diverged : ProbeWorld W L :=
        ⟨initial, successful.take position.val ++ [.diverged] ++
          successful.drop (position.val + 1) ++ suffix, history⟩
      action diverged = none)

def observingSampling {W L : Type} (core : CoreOps (ProbeWorld W L) L)
    (sample : Value L → Value L → W → SampleMethod)
    (samples : Value L → Value L → W → SamplesMethod) : Ops (ProbeWorld W L) L where
  toCoreOps := observingOps core
  selectedSample := fun value index world => sample value index world.payload
  selectedSamples := fun arguments index world => samples arguments index world.payload

def replies {W L : Type} (count : Nat)
    (values : Nat → Value L) (worlds : Nat → W) : List (Reply W L) :=
  (List.range count).map (fun position => .returned (values position) (worlds position))

/-- A completed call consumes exactly a prefix of arbitrary runtime replies,
retains all later replies, and records one event for each consumed operation.
This is a trace accounting invariant, not an evaluator for any Julia body. -/
def SuccessAccounting {W L : Type} (before after : ProbeWorld W L)
    (value : Value L) (count : Nat) (values : Nat → Value L) (worlds : Nat → W)
    (trace : List (Event L)) : Prop :=
  0 < count ∧ before.replies = replies count values worlds ++ after.replies ∧
  after.payload = worlds (count - 1) ∧ after.events = before.events ++ trace ∧
  trace.length = count ∧ value = values (count - 1)

/-- The only synthesized error in the recursive sampling subsystem is the
source751 assertion. Every other thrown value is the first exceptional
runtime reply, unchanged. Assertion errors use exactly the last two adjacent
sample/eltype replies; no other exception, recovery, ignored failure or extra
world mutation is permitted. -/
def ErrorAccounting {W L : Type} (core : CoreOps (ProbeWorld W L) L)
    (bindings : Bindings L) (before after : ProbeWorld W L) (error : Value L)
    (trace : List (Event L)) : Prop :=
  ∃ (count : Nat) (values : Nat → Value L) (worlds : Nat → W),
    0 < count ∧ after.events = before.events ++ trace ∧ trace.length = count ∧
    ((before.replies = replies (count - 1) values worlds ++
        [.thrown error after.payload] ++ after.replies) ∨
     (2 ≤ count ∧ before.replies = replies count values worlds ++ after.replies ∧
      after.payload = worlds (count - 1) ∧
      ((core.isa (values (count - 1)) (JuliaLean.base.boot.coreV core "Type") = false ∧
        error = JuliaLean.base.boot.objV core
          (.typeError (.symbol "typeassert") (.leaf (core.str ""))
            (JuliaLean.base.boot.coreV core "Type") (values (count - 1)))) ∨
       (core.isa (values (count - 1)) (JuliaLean.base.boot.coreV core "Type") = true ∧
        core.isa (values (count - 2)) (values (count - 1)) = false ∧
        error = JuliaLean.base.boot.objV core
          (.typeError (.symbol "typeassert") (.leaf (core.str ""))
            (values (count - 1)) (values (count - 2))))) ∧
      ∃ original index, trace.drop (count - 2) =
        [.call bindings.broadcastGetindex [original, index], .call bindings.eltype [original]]))

/-- Every observable completion of source744 starts with the original bc's
f and args properties in that order. Success ends with a splat into the
captured f, and returns the exact final runtime reply. Its argument container
is the selected empty tuple or the actual immediately preceding sampler
result, according to current-world dispatch after the args read. Failures
retain exact consumed-prefix accounting and their source751 assertion or
original exceptional reply. No recursive expected interpreter is supplied.
All input values, selectors, scripts, histories and runtime fields are
universally quantified. Divergence has no returned world in CoreM; the
separate initial-failure and finite-leaf members force observable outcomes
where the source has them. Source: base/broadcast.jl:744,753-754. -/
def BroadcastedCompletionInvariant : Prop :=
  ∀ {W L : Type} (core : CoreOps (ProbeWorld W L) L)
      (sample : Value L → Value L → W → SampleMethod)
      (samples : Value L → Value L → W → SamplesMethod)
      (bindings : Bindings L) (bc index : Value L) (before : ProbeWorld W L),
    let ops := observingSampling core sample samples
    let priorReplies : List (Event L) :=
      [.call bindings.getproperty [bc, .symbol "f"],
       .call bindings.getproperty [bc, .symbol "args"]]
    match sampleBroadcasted ops bindings bc index before with
    | none => True
    | some (.error (error, after)) =>
        ∃ trace, ErrorAccounting core bindings before after error trace ∧
          trace.take 2 = priorReplies.take trace.length
    | some (.ok (value, after)) =>
        ∃ (count : Nat) (values : Nat → Value L) (worlds : Nat → W)
          (trace front : List (Event L)),
          3 ≤ count ∧ SuccessAccounting before after value count values worlds trace ∧
          trace.take 2 = priorReplies ∧
          let arguments := match samples (values 1) index (worlds 1) with
            | .empty => JuliaLean.base.boot.tupleV core []
            | _ => values (count - 2)
          trace = front ++ [.splat bindings.iterate [values 0, arguments]]

/-- On any successful source753 completion, the first operation reads the
original tuple's first slot and a later operation obtains that same tuple's
tail. The final tuple splat uses the actual head sampler result immediately
before that tail read (or its previous sample reply for source751), and the
actual recursive suffix result immediately before composition, with the
known empty suffix represented explicitly. These independent provenance
positions remain meaningful for arbitrary nesting and current-world dispatch.
Errors are unchanged replies or exact installed assertion errors, and every
completed path retains its consumed-prefix trace/world accounting.
Source: base/broadcast.jl:753-754,744-751. -/
def ArgumentsCompletionInvariant : Prop :=
  ∀ {W L : Type} (core : CoreOps (ProbeWorld W L) L)
      (sample : Value L → Value L → W → SampleMethod)
      (samples : Value L → Value L → W → SamplesMethod)
      (bindings : Bindings L) (arguments index : Value L) (before : ProbeWorld W L),
    let ops := observingSampling core sample samples
    let first : Event L := .call bindings.getindex
      [arguments, JuliaLean.base.boot.intV core (JInt.lit .i64 1)]
    match sampleArguments ops bindings arguments index before with
    | none => True
    | some (.error (error, after)) =>
        ∃ trace, ErrorAccounting core bindings before after error trace ∧
          trace.take 1 = [first]
    | some (.ok (value, after)) =>
        ∃ (count boundary : Nat) (values : Nat → Value L) (worlds : Nat → W)
          (trace front : List (Event L)),
          4 ≤ count ∧ 2 ≤ boundary ∧ boundary < count - 1 ∧
          SuccessAccounting before after value count values worlds trace ∧
          trace.take 1 = [first] ∧
          (trace.drop boundary).take 1 = [.call bindings.tail [arguments]] ∧
          let head := match sample (values 0) index (worlds 0) with
            | .fallback => values (boundary - 2)
            | _ => values (boundary - 1)
          let suffix := match samples (values boundary) index (worlds boundary) with
            | .empty => JuliaLean.base.boot.tupleV core []
            | _ => values (count - 2)
          trace = front ++ [.splat bindings.iterate
            [JuliaLean.base.boot.coreV core "tuple", JuliaLean.base.boot.tupleV core [head], suffix]]

/-- Even on arbitrary recursive selections, a first-operation error or
divergence prevents every subsequent property read, sampling call and splat.
The same exact identity/world law covers both public entries. -/
def InitialFailures : Prop :=
  ∀ {W L : Type} (core : CoreOps (ProbeWorld W L) L)
      (sample : Value L → Value L → W → SampleMethod)
      (samples : Value L → Value L → W → SamplesMethod)
      (bindings : Bindings L) (value index error : Value L)
      (initial failed : W) (history : List (Event L)) (suffix : List (Reply W L)),
    let ops := observingSampling core sample samples
    let before : ProbeWorld W L := ⟨initial, .thrown error failed :: suffix, history⟩
    let diverged : ProbeWorld W L := ⟨initial, .diverged :: suffix, history⟩
    sampleBroadcasted ops bindings value index before = some (.error (error,
      ⟨failed, suffix, history ++ [.call bindings.getproperty [value, .symbol "f"]]⟩)) ∧
    sampleArguments ops bindings value index before = some (.error (error,
      ⟨failed, suffix, history ++ [.call bindings.getindex
        [value, JuliaLean.base.boot.intV core (JInt.lit .i64 1)]]⟩)) ∧
    sampleBroadcasted ops bindings value index diverged = none ∧
    sampleArguments ops bindings value index diverged = none

/-- Exact finite success when dispatch selects the known empty sampler after
the two arbitrary property replies. The selector is universally variable;
this is a case split on actual dispatch metadata, not a correctness law or a
restriction on the public method's domain. The captured callable receives the
actual empty tuple, and every suffix remains untouched. -/
def EmptyArgumentApplication : Prop :=
  ∀ {W L : Type} (core : CoreOps (ProbeWorld W L) L)
      (sample : Value L → Value L → W → SampleMethod)
      (samples : Value L → Value L → W → SamplesMethod)
      (bindings : Bindings L) (bc index : Value L)
      (values : Fin 3 → Value L) (worlds : Fin 3 → W)
      (initial : W) (history : List (Event L)) (suffix : List (Reply W L)),
    match samples (values 1) index (worlds 1) with
    | .empty =>
        let before : ProbeWorld W L :=
          ⟨initial, successfulReplies 2 values worlds ++ suffix, history⟩
        let after : ProbeWorld W L := ⟨worlds 2, suffix, history ++
          [.call bindings.getproperty [bc, .symbol "f"],
           .call bindings.getproperty [bc, .symbol "args"],
           .splat bindings.iterate [values 0, JuliaLean.base.boot.tupleV core []]]⟩
        sampleBroadcasted (observingSampling core sample samples) bindings bc index before =
          some (.ok (values 2, after))
    | _ => True

/-- Exact finite success for an open selected head sampler and the known
empty suffix. This additionally checks that source753 actually samples before
tail lookup and composes the head reply, without assuming any law about that
selected custom method or its returned value. Other selections are covered
by the full-domain completion invariant. -/
def SingleCustomArgumentApplication : Prop :=
  ∀ {W L : Type} (core : CoreOps (ProbeWorld W L) L)
      (sample : Value L → Value L → W → SampleMethod)
      (samples : Value L → Value L → W → SamplesMethod)
      (bindings : Bindings L) (arguments index : Value L)
      (values : Fin 4 → Value L) (worlds : Fin 4 → W)
      (initial : W) (history : List (Event L)) (suffix : List (Reply W L)),
    match sample (values 0) index (worlds 0), samples (values 2) index (worlds 2) with
    | .custom, .empty =>
        let before : ProbeWorld W L :=
