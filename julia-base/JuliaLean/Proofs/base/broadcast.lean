namespace JuliaLean.Proofs.base.broadcast.Models2Group5.MaskedForward

open JuliaLean
open JuliaLean.Registry
open JuliaLean.base.expr (Value)
open JuliaLean.base.boot (CoreOps CoreM)
open JuliaLean.base.broadcast.Models2Group5.MaskedForward
open JuliaLean.Proofs.base.broadcast.Models2Group5.IndexAccess.ContextObservations
open JuliaLean.Proofs.base.broadcast.Models2Group5.ForwardObservations (Reply ReturnsLastAfter)

/-- Observe the constructor's call and type-application hooks in both
compiler contexts. All unobserved runtime primitives remain arbitrary. -/
def constructorContexts {W L : Type} (core : Bool → CoreOps (World W L) L) :
    JuliaLean.base.broadcast.Models2Group5.Iteration.ContextOps (World W L) L where
  inContext := fun context =>
    { core context with
      call := fun function arguments => observe context (.call function arguments)
      applyType := fun type parameters => observe context (.applyType type parameters) }

/-- The optional bounds check precedes target type formation, which precedes
construction from the original two arrays. Eliding the check cannot elide or
reorder the latter operations. Native type-parameter values, array aliases,
all returned objects, errors, mutation worlds and divergence are arbitrary.
Source: base/broadcast.jl:1263-1266; devdocs/boundscheck.md:12-36. -/
def ConstructorObservations : Prop :=
  ∀ {W L : Type} (core : Bool → CoreOps (World W L) L) (bindings : Bindings L)
      (n m parent mask : Value L) (boundscheck : Bool)
      (values : Nat → Value L) (worlds : Nat → W) (initial : W)
      (history : List (ContextEvent L)) (suffix : List (Reply W L)),
    let count := if boundscheck then 3 else 2
    let targetPosition := if boundscheck then 1 else 0
    let prescribed :=
      (if boundscheck then [call true bindings.checkbounds [parent, mask]] else []) ++
      [⟨boundscheck, .applyType bindings.bitMasked [n, m]⟩,
       call boundscheck (values targetPosition) [parent, mask]]
    ReturnsLast
      (construct (constructorContexts core) bindings n m parent mask boundscheck)
      count values worlds prescribed initial history suffix

/-- Specialized dotview preserves both exact array references, the incoming
context, and every outcome of their selected masked constructor. -/
def DotviewObservations : Prop :=
  ∀ {W L : Type} (core : Bool → CoreOps (World W L) L) (bindings : Bindings L)
      (parent mask : Value L) (boundscheck : Bool)
      (values : Nat → Value L) (worlds : Nat → W) (initial : W)
      (history : List (ContextEvent L)) (suffix : List (Reply W L)),
    ReturnsLast (dotview (observingContexts core) bindings parent mask boundscheck)
      1 values worlds [call boundscheck bindings.bitMasked [parent, mask]]
      initial history suffix

/-- The identity/Bool materialization specialization performs exactly the
actual args read, first-slot query and fill! call. It returns the selected
fill outcome unchanged rather than assuming destination identity or success.
Source: base/broadcast.jl:1270. -/
def ScalarMaterializationObservations : Prop :=
  ∀ {W L : Type} (bindings : Bindings L) (destination broadcast : Value L),
    ReturnsLastAfter (W := W) (L := L) 2
      (fun core => materializeScalar core bindings destination broadcast)
      (fun core values _ _ =>
        [.call bindings.getproperty [broadcast, .symbol "args"],
         .call bindings.getindex [values 0, JuliaLean.base.boot.intV core (JInt.lit .i64 1)],
         .call bindings.fill [destination, values 1]])

namespace ShowObservations

open JuliaLean.Proofs.base.broadcast.Models2Group5.ForwardObservations (Event)

/-- A proof event stores the actual represented callable and tuple supplied
to foreach, including the captured IO identity. It is not a Julia allocation
or an extra runtime call. -/
inductive ShowEvent (L : Type) where
  | runtime (event : Event L)
  | foreach (closure : ShowClosure L) (arguments : Value L)

structure ShowWorld (W L : Type) where
  payload : W
  replies : List (Reply W L)
  events : List (ShowEvent L)

def observe {W L : Type} (event : ShowEvent L) :
    CoreM (ShowWorld W L) L (Value L) := fun world =>
  match world.replies with
  | [] => none
  | .diverged :: _ => none
  | .returned value payload :: remaining =>
      some (.ok (value, ⟨payload, remaining, world.events ++ [event]⟩))
  | .thrown error payload :: remaining =>
      some (.error (error, ⟨payload, remaining, world.events ++ [event]⟩))

def observing {W L : Type} (core : CoreOps (ShowWorld W L) L)
    (closureValue : ShowClosure L → Value L) :
    ShowOps (ShowWorld W L) L where
  toCoreOps := { core with call := fun function arguments => observe (.runtime (.call function arguments)) }
  closureValue := closureValue
  foreach := fun closure arguments => observe (.foreach closure arguments)

end ShowObservations

/-- The represented closure's executable body preserves captured IO and the
actual supplied element at the real show dispatch, with every stream effect,
error and divergence arbitrary. This is a callable observation contract, not
a law imposed on the selected foreach implementation. -/
def ShowClosureObservations : Prop :=
  ∀ {W L : Type} (bindings : Bindings L) (io argument : Value L),
    ReturnsLastAfter (W := W) (L := L) 0
      (fun core => callShowClosure core bindings ⟨.source1268, io⟩ argument)
      (fun _ _ _ _ => [.call bindings.showFn [io, argument]])

/-- Complete arity and runtime identity contract for the source callable.
Unary calls retain the original IO/argument at show. Every other constructible
arity raises the genuine MethodError carrying this exact code/capture value,
argument tuple and runtime world age. A world-age failure or divergence is
preserved unchanged. The identity embedding is metadata, never a supplied
call result or replacement lambda body. -/
def ShowClosureIdentityAndArity : Prop :=
  (∀ {W L : Type} (bindings : Bindings L) (io : Value L)
      (embedding : ShowClosure L → Value L)
      (arguments : JuliaLean.base.broadcast.Models2Group5.Constructors.ArgumentTuple L),
    match arguments.values with
    | [argument] =>
        ReturnsLastAfter (W := W) (L := L) 0
          (fun core => invokeShowClosure core bindings embedding ⟨.source1268, io⟩ arguments)
          (fun _ _ _ _ => [.call bindings.showFn [io, argument]])
    | _ => True) ∧
  (∀ {W L : Type} (core : CoreOps W L) (bindings : Bindings L) (io : Value L)
      (embedding : ShowClosure L → Value L)
      (arguments : JuliaLean.base.broadcast.Models2Group5.Constructors.ArgumentTuple L)
      (initial : W),
    match arguments.values with
    | [_] => True
    | _ =>
        let actual := invokeShowClosure core bindings embedding ⟨.source1268, io⟩ arguments initial
        match core.worldAge initial with
        | none => actual = none
        | some (.error (error, after)) => actual = some (.error (error, after))
        | some (.ok (age, after)) =>
            actual = some (.error
              (JuliaLean.base.boot.objV core (.methodError (embedding ⟨.source1268, io⟩)
                (JuliaLean.base.boot.tupleV core arguments.values)
                (JuliaLean.base.boot.intV core age)), after)))

/-- Masked-array display reads both properties before invoking foreach with
the actual type and nested parent/mask tuple. It passes a closure capturing
the original IO, and preserves the entire selected foreach result/error/world
without assuming rendering strings, concrete IO, or foreach correctness.
Source: base/broadcast.jl:1268. -/
def ShowMaskedObservations : Prop :=
  ∀ {W L : Type} (core : CoreOps (ShowObservations.ShowWorld W L) L)
      (bindings : Bindings L) (embedding : ShowClosure L → Value L) (io value : Value L)
      (values : Fin 3 → Value L) (worlds : Fin 3 → W) (initial : W)
      (history : List (ShowObservations.ShowEvent L)) (suffix : List (Reply W L)),
    let successful :=
      JuliaLean.Proofs.base.broadcast.Models2Group5.ForwardObservations.successfulReplies 2 values worlds
    let prescribed : List (ShowObservations.ShowEvent L) :=
      [.runtime (.call bindings.getproperty [value, .symbol "parent"]),
       .runtime (.call bindings.getproperty [value, .symbol "mask"]),
       .foreach ⟨.source1268, io⟩ (JuliaLean.base.boot.tupleV core
         [.leaf (core.typeOf value), JuliaLean.base.boot.tupleV core [values 0, values 1]])]
    let action := showMasked (ShowObservations.observing core embedding) bindings io value
    let before : ShowObservations.ShowWorld W L := ⟨initial, successful ++ suffix, history⟩
    let after : ShowObservations.ShowWorld W L := ⟨worlds 2, suffix, history ++ prescribed⟩
    action before = some (.ok (values 2, after)) ∧
    (∀ (position : Fin 3) (error : Value L) (failedWorld : W),
      let remaining := successful.drop (position.val + 1) ++ suffix
      let beforeFailure : ShowObservations.ShowWorld W L :=
        ⟨initial, successful.take position.val ++ [.thrown error failedWorld] ++ remaining, history⟩
      let afterFailure : ShowObservations.ShowWorld W L :=
        ⟨failedWorld, remaining, history ++ prescribed.take (position.val + 1)⟩
      action beforeFailure = some (.error (error, afterFailure))) ∧
    (∀ position : Fin 3,
      let beforeDivergence : ShowObservations.ShowWorld W L :=
        ⟨initial, successful.take position.val ++ [.diverged] ++
          successful.drop (position.val + 1) ++ suffix, history⟩
      action beforeDivergence = none)

def DisplayRuntimeInvariant : Prop :=
  ShowClosureObservations ∧ ShowClosureIdentityAndArity ∧ ShowMaskedObservations

private theorem showClosureObservations : ShowClosureObservations := by
  unfold ShowClosureObservations
  intros
  simp [JuliaLean.Proofs.base.broadcast.Models2Group5.ForwardObservations.ReturnsLastAfter, JuliaLean.Proofs.base.broadcast.Models2Group5.ForwardObservations.successfulReplies, List.ofFn_succ, List.ofFn_zero,
    callShowClosure, JuliaLean.Proofs.base.broadcast.Models2Group5.ForwardObservations.observingOps, JuliaLean.Proofs.base.broadcast.Models2Group5.ForwardObservations.observe]
private theorem showClosureIdentityAndArity : ShowClosureIdentityAndArity := by
  constructor
  · intro W L bindings io embedding args
    rcases args with ⟨arguments, bound⟩
    cases arguments with
    | nil => trivial
    | cons argument tail =>
      cases tail with
      | nil =>
        simp [JuliaLean.Proofs.base.broadcast.Models2Group5.ForwardObservations.ReturnsLastAfter, JuliaLean.Proofs.base.broadcast.Models2Group5.ForwardObservations.successfulReplies, List.ofFn_succ, List.ofFn_zero,
          invokeShowClosure, callShowClosure, JuliaLean.Proofs.base.broadcast.Models2Group5.ForwardObservations.observingOps, JuliaLean.Proofs.base.broadcast.Models2Group5.ForwardObservations.observe]
      | cons next rest => trivial
  · intro W L core bindings io embedding args initial
    rcases args with ⟨arguments, bound⟩
    cases arguments with
    | nil =>
      cases h : core.worldAge initial with
      | none => simp [invokeShowClosure, h, Bind.bind]
      | some outcome => cases outcome <;>
          simp [invokeShowClosure, h, Bind.bind, JuliaLean.base.boot.throwObj] <;> rfl
    | cons argument tail =>
      cases tail with
      | nil => trivial
      | cons next rest =>
        cases h : core.worldAge initial with
        | none => simp [invokeShowClosure, h, Bind.bind]
        | some outcome => cases outcome <;>
            simp [invokeShowClosure, h, Bind.bind, JuliaLean.base.boot.throwObj] <;> rfl
private theorem showMaskedObservations : ShowMaskedObservations := by
  unfold ShowMaskedObservations
  intro W L core bindings embedding io value values worlds initial history suffix
  simp [JuliaLean.Proofs.base.broadcast.Models2Group5.ForwardObservations.successfulReplies, List.ofFn_succ, List.ofFn_zero, Fin.forall_fin_succ,
    showMasked, ShowObservations.observing, ShowObservations.observe,
    Bind.bind, List.append_assoc, JuliaLean.base.boot.tupleV]
theorem displayRuntimeInvariant : DisplayRuntimeInvariant :=
  ⟨showClosureObservations, showClosureIdentityAndArity, showMaskedObservations⟩

def isOther : MaterializeMethod → Bool
  | .same => false
  | .other => true

def viewInput {L : Type} (original : Value L) (values : Nat → Value L) : Nat → Value L
  | 0 => original
  | previous + 1 => values (3 * (previous + 1) - 1)

/-- Flat three-operation view blocks, with the entire source view expression
observed in the explicit @inbounds context. -/
def viewEvents {L : Type} (bindings : Bindings L) (original : Value L)
    (values : Nat → Value L) (frames : Nat) : List (ContextEvent L) :=
  (List.range frames).flatMap (fun depth =>
    [call false bindings.getproperty [viewInput original values depth, .symbol "parent"],
     call false bindings.getproperty [viewInput original values depth, .symbol "mask"],
     call false bindings.view [values (3 * depth), values (3 * depth + 1)]])

def observingMaterialize {W L : Type} (core : Bool → CoreOps (World W L) L)
    (select : Value L → Value L → W → MaterializeMethod) : MaterializeOps (World W L) L where
  contexts := observingContexts core
  selectedMaterialize := fun value broadcast world => select value broadcast world.payload

/-- Every finite window of repeated masked materialization consists of actual
three-call inbounds view blocks. Its first different selected method receives
the final returned view and unchanged broadcast in the surrounding context.
No terminal within the window permits an invented return. Every call's
failure/divergence stops at its precise position, even with self-returning
views and aliases. Source: base/broadcast.jl:1271. -/
def ViewMaterializationObservations : Prop :=
  ∀ {W L : Type} (core : Bool → CoreOps (World W L) L)
      (select : Value L → Value L → W → MaterializeMethod) (bindings : Bindings L)
      (destination broadcast : Value L) (boundscheck : Bool)
      (values : Nat → Value L) (worlds : Nat → W) (initial : W)
      (history : List (ContextEvent L)) (suffix : List (Reply W L)) (window : Nat),
    let action := materializeView (observingMaterialize core select)
      bindings destination broadcast boundscheck
    match (List.range (window + 1)).find? (fun depth =>
      isOther (select (values (3 * depth + 2)) broadcast (worlds (3 * depth + 2)))) with
    | none =>
        ContinuesAfter action (3 * (window + 1)) values worlds
          (viewEvents bindings destination values (window + 1)) initial history suffix
    | some depth =>
        let frames := depth + 1
        depth ≤ window ∧
        ReturnsLast action (3 * frames + 1) values worlds
          (viewEvents bindings destination values frames ++
            [call boundscheck bindings.materialize [values (3 * frames - 1), broadcast]])
          initial history suffix

theorem scalarMaterializationObservations : ScalarMaterializationObservations := by
  unfold ScalarMaterializationObservations
  intros
  simp [JuliaLean.Proofs.base.broadcast.Models2Group5.ForwardObservations.ReturnsLastAfter, JuliaLean.Proofs.base.broadcast.Models2Group5.ForwardObservations.successfulReplies, List.ofFn_succ, List.ofFn_zero,
