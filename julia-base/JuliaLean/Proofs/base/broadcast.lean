namespace JuliaLean.ChatGPT.Batch11.Group12
namespace NonleafProofs

open JuliaLean
open JuliaLean.base.expr (Value)
open JuliaLean.base.boot (CoreOps CoreM)
open JuliaLean.base.broadcast.Models2Group5.NonleafCopy
open JuliaLean.Proofs.base.broadcast.Models2Group5.NonleafCopy
open JuliaLean.Proofs.base.broadcast.Models2Group5.ForwardObservations (Event Reply)
open JuliaLean.Proofs.base.broadcast.Models2Group5.IndexAccess.ContextObservations

structure Frame (W L : Type) where
  event : ContextEvent L
  value : Value L
  world : W

def replies {W L : Type} (frames : List (Frame W L)) : List (Reply W L) :=
  frames.map (fun frame => .returned frame.value frame.world)

def events {W L : Type} (frames : List (Frame W L)) : List (ContextEvent L) :=
  frames.map Frame.event

def stop {W L : Type} (result : Except (Value L) (Value L)) :
    CoreM (World W L) L (Value L) := fun world =>
  some (match result with
    | .ok value => .ok (value, world)
    | .error error => .error (error, world))

def step {W L : Type} (event : ContextEvent L)
    (next : Value L → CoreM (World W L) L (Value L)) :
    CoreM (World W L) L (Value L) := do
  let value ← observe event.boundscheck event.event
  next value

theorem step_returned {W L : Type} (event : ContextEvent L)
    (next : Value L → CoreM (World W L) L (Value L))
    (value : Value L) (initial after : W) (remaining : List (Reply W L))
    (history : List (ContextEvent L)) :
    step event next ⟨initial, .returned value after :: remaining, history⟩ =
      next value ⟨after, remaining, history ++ [event]⟩ := by
  cases event
  rfl

theorem step_thrown {W L : Type} (event : ContextEvent L)
    (next : Value L → CoreM (World W L) L (Value L))
    (error : Value L) (initial after : W) (remaining : List (Reply W L))
    (history : List (ContextEvent L)) :
    step event next ⟨initial, .thrown error after :: remaining, history⟩ =
      some (.error (error, ⟨after, remaining, history ++ [event]⟩)) := by
  cases event
  rfl

theorem step_diverged {W L : Type} (event : ContextEvent L)
    (next : Value L → CoreM (World W L) L (Value L))
    (initial : W) (remaining : List (Reply W L))
    (history : List (ContextEvent L)) :
    step event next ⟨initial, .diverged :: remaining, history⟩ = none := by
  cases event
  rfl

def Prefix {W L : Type} (action : CoreM (World W L) L (Value L))
    (frames : List (Frame W L)) : Prop :=
  ∀ initial history suffix,
    FailurePrefixes action (replies frames) (events frames) initial history suffix

theorem prefix_nil {W L : Type} (action : CoreM (World W L) L (Value L)) :
    Prefix action [] := by
  intro initial history suffix
  constructor
  · intro position
    exact Fin.elim0 position
  · intro position
    exact Fin.elim0 position

theorem prefix_step {W L : Type} (frame : Frame W L)
    (next : Value L → CoreM (World W L) L (Value L))
    (frames : List (Frame W L))
    (tail : Prefix (next frame.value) frames) :
    Prefix (step frame.event next) (frame :: frames) := by
  intro initial history suffix
  have ht := tail frame.world (history ++ [frame.event]) suffix
  rcases ht with ⟨he, hd⟩
  constructor
  · rintro ⟨position, bound⟩ error failureWorld
    cases position with
    | zero =>
        simp only [replies, events, List.map_cons, List.take_zero,
          List.nil_append, List.singleton_append, List.drop_succ_cons,
          List.drop_zero, List.take_succ_cons, step_thrown]
    | succ position =>
        have bound' : position < (replies frames).length := by
          simpa only [replies, List.map_cons, List.length_cons,
            Nat.succ_lt_succ_iff] using bound
        have h := he ⟨position, bound'⟩ error failureWorld
        simpa only [replies, events, List.map_cons, List.take_succ_cons,
          List.drop_succ_cons, List.cons_append, step_returned,
          List.append_assoc, List.singleton_append, List.nil_append] using h
  · rintro ⟨position, bound⟩
    cases position with
    | zero =>
        simp only [replies, events, List.map_cons, List.take_zero,
          List.nil_append, List.singleton_append, List.drop_succ_cons,
          List.drop_zero, List.cons_append, step_diverged]
    | succ position =>
        have bound' : position < (replies frames).length := by
          simpa only [replies, List.map_cons, List.length_cons,
            Nat.succ_lt_succ_iff] using bound
        have h := hd ⟨position, bound'⟩
        simpa only [replies, events, List.map_cons, List.take_succ_cons,
          List.drop_succ_cons, List.cons_append, step_returned,
          List.append_assoc, List.singleton_append, List.nil_append] using h

/-- A finite sequence of the original computation's observed calls. -/
inductive Steps {W L : Type} : CoreM (World W L) L (Value L) →
    List (Frame W L) → CoreM (World W L) L (Value L) → Prop where
  | nil (action) : Steps action [] action
  | cons (frame : Frame W L)
      (next : Value L → CoreM (World W L) L (Value L))
      (frames : List (Frame W L)) (residual : CoreM (World W L) L (Value L))
      (tail : Steps (next frame.value) frames residual) :
      Steps (step frame.event next) (frame :: frames) residual

theorem steps_cons {W L : Type} (event : ContextEvent L) (value : Value L) (world : W)
    (next : Value L → CoreM (World W L) L (Value L)) (frames : List (Frame W L))
    (residual : CoreM (World W L) L (Value L))
    (tail : Steps (next value) frames residual) :
    Steps (step event next) (⟨event, value, world⟩ :: frames) residual :=
  Steps.cons ⟨event, value, world⟩ next frames residual tail

def finalPayload {W L : Type} (frames : List (Frame W L)) (initial : W) : W :=
  frames.foldl (fun _ frame => frame.world) initial

theorem steps_prefix {W L : Type}
    {action residual : CoreM (World W L) L (Value L)}
    {frames : List (Frame W L)} (path : Steps action frames residual) :
    Prefix action frames := by
  induction path with
  | nil action => exact prefix_nil action
  | cons frame next frames residual tail ih =>
      exact prefix_step frame next frames ih

theorem steps_success {W L : Type}
    {action residual : CoreM (World W L) L (Value L)}
    {frames : List (Frame W L)} (path : Steps action frames residual)
    (initial : W) (history : List (ContextEvent L)) (suffix : List (Reply W L)) :
    action ⟨initial, replies frames ++ suffix, history⟩ =
      residual ⟨finalPayload frames initial, suffix, history ++ events frames⟩ := by
  induction path generalizing initial history suffix with
  | nil action =>
      simp only [replies, events, finalPayload, List.map_nil, List.foldl_nil,
        List.nil_append, List.append_nil]
  | cons frame next frames residual tail ih =>
      simpa only [replies, events, finalPayload, List.map_cons, List.foldl_cons,
        List.cons_append, step_returned, List.append_assoc, List.singleton_append, List.nil_append]
        using ih frame.world (history ++ [frame.event]) suffix


def copyFrames {W L : Type} (core : Bool → CoreOps (World W L) L)
    (bindings : Bindings L) (dest bc iterator state : Value L)
    (values : Nat → Value L) (worlds : Nat → W) : List (Frame W L) :=
  let one := JuliaLean.base.boot.intV (core true) (JInt.lit .i64 1)
  let two := JuliaLean.base.boot.intV (core true) (JInt.lit .i64 2)
  [⟨call true bindings.eltype [dest], values 0, worlds 0⟩,
   ⟨call true bindings.iterate [iterator, state], values 1, worlds 1⟩,
   ⟨call true bindings.indexedIterate [values 1, one], values 2, worlds 2⟩,
   ⟨⟨true, .getfield (values 2) one⟩, values 3, worlds 3⟩,
   ⟨⟨true, .getfield (values 2) two⟩, values 4, worlds 4⟩,
   ⟨call true bindings.indexedIterate [values 1, two, values 4], values 5, worlds 5⟩,
   ⟨⟨true, .getfield (values 5) one⟩, values 6, worlds 6⟩,
   ⟨call false bindings.getindex [bc, values 3], values 7, worlds 7⟩]

theorem copy_frames_events {W L : Type}
    (core : Bool → CoreOps (World W L) L) (bindings : Bindings L)
    (dest bc iterator state : Value L)
    (values : Nat → Value L) (worlds : Nat → W) :
    events (copyFrames core bindings dest bc iterator state values worlds) =
      copyPrefix core bindings dest bc iterator state values := rfl

theorem copy_frames_replies {W L : Type}
    (core : Bool → CoreOps (World W L) L) (bindings : Bindings L)
    (dest bc iterator state : Value L)
    (values : Nat → Value L) (worlds : Nat → W) :
    replies (copyFrames core bindings dest bc iterator state values worlds) =
      successes 8 values worlds := rfl

theorem copy_exhausted_steps {W L : Type}
    (core : Bool → CoreOps (World W L) L)
    (copySelect : CopyInputs L → W → Selection)
    (restartSelect : RestartInputs L → W → Selection)
    (bindings : Bindings L) (dest bc iterator state count : Value L)
    (values : Nat → Value L) (worlds : Nat → W)
    (exhausted : (core true).same (values 1)
      (JuliaLean.base.boot.nothingV (core true)) = true) :
    Steps (copy (instrument core copySelect restartSelect)
      bindings dest bc iterator state count)
      ((copyFrames core bindings dest bc iterator state values worlds).take 2)
      (stop (.ok dest)) := by
  unfold copyFrames copy
  rw [run.eq_def]
  change Steps (step (call true bindings.eltype [dest]) _)
    [⟨call true bindings.eltype [dest], values 0, worlds 0⟩,
     ⟨call true bindings.iterate [iterator, state], values 1, worlds 1⟩]
    (stop (.ok dest))
  apply steps_cons
  rw [run.eq_def]
  change Steps (step (call true bindings.iterate [iterator, state]) _)
    [⟨call true bindings.iterate [iterator, state], values 1, worlds 1⟩]
    (stop (.ok dest))
  apply steps_cons
  change Steps (if (core true).same (values 1)
    (JuliaLean.base.boot.nothingV (core true)) then _ else _) [] (stop (.ok dest))
  simp only [exhausted, ↓reduceIte]
  exact Steps.nil _

theorem copy_started_prefix {W L : Type}
    (core : Bool → CoreOps (World W L) L)
    (copySelect : CopyInputs L → W → Selection)
    (restartSelect : RestartInputs L → W → Selection)
    (bindings : Bindings L) (dest bc iterator state count : Value L)
    (values : Nat → Value L) (worlds : Nat → W)
    (started : (core true).same (values 1)
      (JuliaLean.base.boot.nothingV (core true)) = false) :
    Prefix (copy (instrument core copySelect restartSelect)
      bindings dest bc iterator state count)
      (copyFrames core bindings dest bc iterator state values worlds) := by
  unfold copyFrames copy
  rw [run.eq_def]
  change Prefix (step (call true bindings.eltype [dest]) _) _
  apply prefix_step
  rw [run.eq_def]
  change Prefix (step (call true bindings.iterate [iterator, state]) _) _
  apply prefix_step
  change Prefix (if (core true).same (values 1)
    (JuliaLean.base.boot.nothingV (core true)) then _ else _) _
  simp only [started, Bool.false_eq_true, ↓reduceIte]
  change Prefix (step (call true bindings.indexedIterate
    [values 1, JuliaLean.base.boot.intV (core true) (JInt.lit .i64 1)]) _) _
  apply prefix_step
  change Prefix (step ⟨true, .getfield (values 2)
    (JuliaLean.base.boot.intV (core true) (JInt.lit .i64 1))⟩ _) _
  apply prefix_step
  change Prefix (step ⟨true, .getfield (values 2)
    (JuliaLean.base.boot.intV (core true) (JInt.lit .i64 2))⟩ _) _
  apply prefix_step
  change Prefix (step (call true bindings.indexedIterate
    [values 1, JuliaLean.base.boot.intV (core true) (JInt.lit .i64 2), values 4]) _) _
  apply prefix_step
  change Prefix (step ⟨true, .getfield (values 5)
    (JuliaLean.base.boot.intV (core true) (JInt.lit .i64 1))⟩ _) _
  apply prefix_step
  change Prefix (step (call false bindings.getindex [bc, values 3]) _) _
  apply prefix_step
  exact prefix_nil _

theorem copy_prefix_runtime : CopyPrefixRuntime := by
  intro W L core copySelect restartSelect bindings dest bc iterator state count
    values worlds initial history suffix
  cases branch : (core true).same (values 1)
      (JuliaLean.base.boot.nothingV (core true)) with
  | false =>
      simp only [branch, Bool.false_eq_true, ↓reduceIte]
      have hp := copy_started_prefix core copySelect restartSelect bindings
        dest bc iterator state count values worlds branch
      simpa only [copy_frames_events, copy_frames_replies] using hp initial history suffix
  | true =>
      simp only [branch, ↓reduceIte]
      have path := copy_exhausted_steps core copySelect restartSelect bindings
        dest bc iterator state count values worlds branch
      change 0 < 2 ∧
        copy (instrument core copySelect restartSelect) bindings dest bc iterator state count
          ⟨initial, [.returned (values 0) (worlds 0), .returned (values 1) (worlds 1)] ++
            suffix, history⟩ =
          some (.ok (dest, ⟨worlds 1, suffix, history ++
            [call true bindings.eltype [dest], call true bindings.iterate [iterator, state]]⟩)) ∧
        FailurePrefixes
          (copy (instrument core copySelect restartSelect) bindings dest bc iterator state count)
          [.returned (values 0) (worlds 0), .returned (values 1) (worlds 1)]
          [call true bindings.eltype [dest], call true bindings.iterate [iterator, state]]
          initial history suffix
      refine ⟨by decide, ?_, ?_⟩
      · simpa only [copyFrames, replies, events, finalPayload, stop,
          List.take_succ_cons, List.take_zero, List.map_cons, List.map_nil,
          List.foldl_cons, List.foldl_nil] using
          steps_success path initial history suffix
      · simpa only [copyFrames, replies, events, List.take_succ_cons,
          List.take_zero, List.map_cons, List.map_nil] using
          steps_prefix path initial history suffix

theorem restart_prefix_runtime : RestartPrefixRuntime := by
  intro W L core copySelect restartSelect bindings newdest dest bc value index
    iterator state count values worlds initial history suffix
  have hp : Prefix (restart (instrument core copySelect restartSelect)
      bindings newdest dest bc value index iterator state count)
      [⟨call true bindings.take [iterator, count], values 0, worlds 0⟩,
       ⟨call true bindings.iterate [values 0], values 1, worlds 1⟩] := by
    unfold restart
    rw [run.eq_def]
    change Prefix (step (call true bindings.take [iterator, count]) _) _
    apply prefix_step
    change Prefix (step (call true bindings.iterate [values 0]) _) _
    apply prefix_step
    exact prefix_nil _
  simpa only [replies, events, successes, List.range_succ, List.range_zero,
    List.map_append, List.map_cons, List.map_nil, List.nil_append,
    List.cons_append, List.append_nil] using hp initial history suffix

end NonleafProofs
