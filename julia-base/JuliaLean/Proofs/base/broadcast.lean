namespace JuliaLean.Proofs.base.broadcast.Models2Group5.IthChunk

open JuliaLean
open JuliaLean.Registry
open JuliaLean.base.expr (Value)
open JuliaLean.base.boot (CoreOps)
open JuliaLean.base.broadcast.Models2Group5.IthChunk
open JuliaLean.Proofs.base.broadcast.Models2Group5.ForwardObservations
open JuliaLean.Proofs.base.broadcast.Models2Group5.NewIndex (FollowsPlan)

/-- Instrument only the actual propagated context. All original selected
method metadata and operations in the other context remain arbitrary. -/
def observing {W L : Type} (ops : Ops (ProbeWorld W L) L) (wanted : Bool) :
    Ops (ProbeWorld W L) L :=
  { ops with contexts :=
      { inContext := fun flag =>
          if flag = wanted then observingOps (ops.contexts.inContext flag)
          else ops.contexts.inContext flag } }

/-- A vector read is the first operation for every index type, tail, bounds
context and selected recursive callee. Failure retains that exact original
vector/index call, error and world, with all suffix operations unused.
Source: base/broadcast.jl:1118. -/
def VectorFirstRead : Prop :=
  ∀ {W L : Type} (ops : Ops (ProbeWorld W L) L) (bindings : Bindings L)
      (index chunks : Value L) (tail : Tail L) (boundscheck : Bool)
      (initial failureWorld : W) (error : Value L) (history : List (Event L))
      (suffix : List (Reply W L)),
    let action := vector (observing ops boundscheck) bindings index chunks tail boundscheck
    action ⟨initial, .thrown error failureWorld :: suffix, history⟩ =
      some (.error (error, ⟨failureWorld, suffix,
        history ++ [.call bindings.getindex [chunks, index]]⟩)) ∧
    action ⟨initial, .diverged :: suffix, history⟩ = none

/-- Constant custom suffix selection, keeping the other compiler context
arbitrary so a wrong hardcoded context remains observable. -/
def customOps {W L : Type}
    (other : JuliaLean.base.broadcast.Models2Group5.Iteration.ContextOps (ProbeWorld W L) L)
    (core : CoreOps (ProbeWorld W L) L) (wanted : Bool) : Ops (ProbeWorld W L) L where
  contexts := { inContext := fun flag => if flag = wanted then core else other.inContext flag }
  selectedCons := fun _ _ _ _ => .custom
  selectedNil := fun _ _ => .custom

/-- Both public methods forward the original index and every actual vararg
to a selected custom suffix before tuple assembly. The vector head is read
once; the UInt64 head is preserved without reading or converting it. All
custom returns, errors, divergence, worlds and bounds contexts are included.
Source: base/broadcast.jl:1118-1119. -/
def CustomSuffixRuntime : Prop :=
  ∀ {W L : Type}
      (other : JuliaLean.base.broadcast.Models2Group5.Iteration.ContextOps (ProbeWorld W L) L)
      (bindings : Bindings L) (index chunks : Value L) (word : JInt .u64)
      (tail : Tail L) (boundscheck : Bool),
    ReturnsLastAfter (W := W) (L := L) 2
      (fun core => vector (customOps other core boundscheck)
        bindings index chunks tail boundscheck)
      (fun core values _ _ =>
        [.call bindings.getindex [chunks, index],
         .call bindings.ithchunk (index :: tail.values),
         .splat bindings.iterate [JuliaLean.base.boot.coreV core "tuple",
           JuliaLean.base.boot.tupleV core [values 0], values 1]]) ∧
    ReturnsLastAfter (W := W) (L := L) 1
      (fun core => scalar (customOps other core boundscheck)
        bindings index word tail boundscheck)
      (fun core values _ _ =>
        [.call bindings.ithchunk (index :: tail.values),
         .splat bindings.iterate [JuliaLean.base.boot.coreV core "tuple",
           JuliaLean.base.boot.tupleV core [JuliaLean.base.boot.intV core word], values 0]])

/-- An independently selected vector/scalar pattern for an entire native
vararg tuple. Position arithmetic is proof metadata over immutable slots,
not modelled Julia Int arithmetic. The actual recursive body still runs. -/
def chainOps {W L : Type}
    (other : JuliaLean.base.broadcast.Models2Group5.Iteration.ContextOps (ProbeWorld W L) L)
    (core : CoreOps (ProbeWorld W L) L) (wanted : Bool) (tailLength : Nat)
    (isVector : Nat → Bool) : Ops (ProbeWorld W L) L where
  contexts := { inContext := fun flag =>
    if flag = wanted then observingOps core else other.inContext flag }
  selectedCons := fun _ _ rest _ =>
    if isVector (tailLength - rest.length) then .vector else .scalar
  selectedNil := fun _ _ => .builtin

/-- Closed-form full recursion trace for every constructible argument tuple
and every vector/scalar method pattern: all vector reads descend left to
right, scalar positions produce no read, then every tuple splat occurs in
reverse order using its own original word/read result and exact assembled
suffix. The nullary Base body terminates with the empty tuple. Both entry
methods, arbitrary index types, contexts, aliases, returned values, worlds,
errors and divergence prefixes are included, with no callee law or model fuel.
Source: base/broadcast.jl:1117-1119. -/
def FiniteRecursionRuntime : Prop :=
  ∀ {W L : Type}
      (other : JuliaLean.base.broadcast.Models2Group5.Iteration.ContextOps (ProbeWorld W L) L)
      (core : CoreOps (ProbeWorld W L) L) (bindings : Bindings L)
      (index chunks : Value L) (word : JInt .u64) (tail : Tail L)
      (boundscheck vectorEntry : Bool) (isVector : Nat → Bool)
      (readValues assembled : Nat → Value L) (worlds : Nat → W)
      (initial : W) (history : List (Event L)) (suffix : List (Reply W L)),
    let first := if vectorEntry then chunks else JuliaLean.base.boot.intV core word
    let count := tail.values.length + 1
    let argument := fun position => if position = 0 then first
      else tail.values.getD (position - 1) first
    let vectorAt := fun position => if position = 0 then vectorEntry else isVector position
    let positions := List.range count
    let reads := positions.filterMap (fun position =>
      if vectorAt position then some (readValues position) else none)
    let replies := reads ++ positions.reverse.map assembled
    let values := fun position => replies.getD position first
    let prescribed := positions.filterMap (fun position =>
      if vectorAt position then some (Event.call bindings.getindex [argument position, index])
      else none) ++
      positions.reverse.map (fun position =>
        .splat bindings.iterate [JuliaLean.base.boot.coreV core "tuple",
          JuliaLean.base.boot.tupleV core
            [if vectorAt position then readValues position else argument position],
          if position + 1 = count then JuliaLean.base.boot.tupleV core []
          else assembled (position + 1)])
    let ops := chainOps other core boundscheck tail.values.length isVector
    let action := if vectorEntry then vector ops bindings index chunks tail boundscheck
      else scalar ops bindings index word tail boundscheck
    prescribed.length = replies.length ∧
      FollowsPlan action values worlds initial history suffix prescribed (assembled 0)

def VectorRuntime : Prop := VectorFirstRead ∧ CustomSuffixRuntime ∧ FiniteRecursionRuntime

def ScalarRuntime : Prop := CustomSuffixRuntime ∧ FiniteRecursionRuntime

def proposedEntries : List Entry := [
  { id := "broadcast-ithchunk-vector-runtime", juliaFile := "base/broadcast.jl",
    juliaFns := ["ithchunk(i, c::Vector{UInt64}, args...)"],
    statement := "Vector chunk indexing reads the original vector at the unrestricted original index before explicitly executing the selected recursive suffix. Complete native-sized heterogeneous argument tuples preserve context, left-to-right reads, reverse tuple assembly, custom suffix calls and every error/divergence/world.",
    source := "base/broadcast.jl:1117-1119; doc/src/devdocs/boundscheck.md:70-79",
    status := .proven,
    prop := ``JuliaLean.Proofs.base.broadcast.Models2Group5.IthChunk.VectorRuntime,
    thm := some `JuliaLean.Proofs.base.broadcast.Models2Group5.IthChunk.VectorRuntime_proven,
    notes := "Combines first-read failure observations with the proved full-domain custom-suffix and finite-recursion contracts." },
  { id := "broadcast-ithchunk-scalar-runtime", juliaFile := "base/broadcast.jl",
    juliaFns := ["ithchunk(i, b::UInt64, args...)"],
    statement := "Scalar chunk indexing preserves the actual UInt64 word without reading or converting it, explicitly executes recursive vector/scalar/custom suffixes with the original index, and assembles tuple results in return order while retaining every runtime outcome and context.",
    source := "base/broadcast.jl:1117-1119; doc/src/devdocs/boundscheck.md:70-79",
    status := .proven,
    prop := ``JuliaLean.Proofs.base.broadcast.Models2Group5.IthChunk.ScalarRuntime,
    thm := some `JuliaLean.ChatGPT.Batch11.Group10.BroadcastIthchunkScalarRuntime_proven,
    notes := "JInt.u64 scalar and full arbitrary index/tail values. Structural recursion traverses only the supplied native-bounded vararg tuple; every selected custom method remains an ordinary call. Nullary Base case reuses Bits.m1117." }
]

end JuliaLean.Proofs.base.broadcast.Models2Group5.IthChunk


namespace JuliaLean.Proofs.base.broadcast.Models2Group5.ChunkedCopy

open JuliaLean
open JuliaLean.Registry
open JuliaLean.base.expr (Value)
open JuliaLean.base.boot (CoreOps)
open JuliaLean.base.broadcast.Models2Group5.ChunkedCopy
open JuliaLean.Proofs.base.broadcast.Models2Group5.ForwardObservations
open JuliaLean.Proofs.base.broadcast.Models2Group5.NewIndex (FollowsPlan PrefixFailures)

/-- Observe just the requested compiler context while leaving the other
context arbitrary. Selection reads only the actual runtime payload world. -/
def probe {W L : Type}
    (other : JuliaLean.base.broadcast.Models2Group5.Iteration.ContextOps (ProbeWorld W L) L)
    (core : CoreOps (ProbeWorld W L) L) (wanted : Bool)
    (select : Value L → Value L → W → AndMethod) : Ops (ProbeWorld W L) L where
  contexts := { inContext := fun flag =>
    if flag = wanted then observingOps core else other.inContext flag }
  selectedAnd := fun left right world => select left right world.payload

/-- Full-domain entry and preprocessing prefix. True emptiness returns the
original destination with all later operations unused; non-Bool raises the
conditional TypeError; false evaluates every setup operation in source order.
Every prefix failure/divergence retains its exact world. Selected methods and
all input/reference values remain arbitrary. Source: broadcast.jl:1120-1125. -/
def SourcePrefixRuntime : Prop :=
  ∀ {W L : Type}
      (other : JuliaLean.base.broadcast.Models2Group5.Iteration.ContextOps (ProbeWorld W L) L)
      (core : CoreOps (ProbeWorld W L) L)
      (select : Value L → Value L → W → AndMethod) (bindings : Bindings L)
      (dest bc : Value L) (boundscheck : Bool)
      (values : Nat → Value L) (worlds : Nat → W) (initial : W)
      (history : List (Event L)) (suffix : List (Reply W L)),
    let action := copy (probe other core boundscheck select) bindings dest bc boundscheck
    let first : List (Event L) := [.call bindings.isempty [dest]]
    let flag := match values 0 with | .leaf leaf => core.asBool leaf | _ => none
    match flag with
    | some true => FollowsPlan action values worlds initial history suffix first dest
    | some false => PrefixFailures action values worlds initial history suffix
        [.call bindings.isempty [dest],
         .call bindings.liftfuncs [bc],
         .call bindings.flatten [values 1],
         .call bindings.getproperty [values 2, .symbol "args"],
         .call bindings.liftchunks [values 3],
         .call bindings.getproperty [dest, .symbol "chunks"],
         .call bindings.eachindex [values 5]]
    | none =>
        let before : ProbeWorld W L :=
          ⟨initial, .returned (values 0) (worlds 0) :: suffix, history⟩
        let after : ProbeWorld W L := ⟨worlds 0, suffix, history ++ first⟩
        PrefixFailures action values worlds initial history suffix first ∧
        action before = some (.error
          (JuliaLean.base.boot.objV core (.typeError (.symbol "if")
            (JuliaLean.base.boot.strV core "") (JuliaLean.base.boot.coreV core "Bool")
            (values 0)), after))

/-- Each actual loop body reads f.f before gathering chunk arguments, applies
that exact function to the actual returned argument tuple, then writes that
value at the same index and chunk reference. Assignment retains its RHS value
instead of a custom setter's return. All operations must use @inbounds=false
context, including all errors, alias changes and divergence.
Source: base/broadcast.jl:1126. -/
def BodyRuntime : Prop :=
  ∀ {W L : Type}
      (other : JuliaLean.base.broadcast.Models2Group5.Iteration.ContextOps (ProbeWorld W L) L)
      (core : CoreOps (ProbeWorld W L) L) (bindings : Bindings L)
      (flat arguments chunks index : Value L)
      (values : Nat → Value L) (worlds : Nat → W) (initial : W)
      (history : List (Event L)) (suffix : List (Reply W L)),
    FollowsPlan (writeChunk (probe other core false (fun _ _ _ => .custom))
      bindings flat arguments chunks index) values worlds initial history suffix
      [.call bindings.getproperty [flat, .symbol "f"],
       .splat bindings.simd.iterate [bindings.ithchunk,
         JuliaLean.base.boot.tupleV core [index], arguments],
       .splat bindings.simd.iterate [values 0, values 1],
       .call bindings.setindexBang [chunks, values 2, index]] (values 2)

/-- Last-index evaluation occurs once and precedes both the word read and
mask call. The current-world selection chooses the concrete UInt64 result or
the actual custom operator return, then exactly that value reaches setindex!.
The original destination is returned only after the write succeeds. Every
error/divergence position and mutated world is retained. Source1128-1129. -/
def FinishRuntime : Prop :=
  ∀ {W L : Type}
      (other : JuliaLean.base.broadcast.Models2Group5.Iteration.ContextOps (ProbeWorld W L) L)
      (core : CoreOps (ProbeWorld W L) L)
      (select : Value L → Value L → W → AndMethod) (bindings : Bindings L)
      (dest chunks : Value L) (values : Nat → Value L) (worlds : Nat → W)
      (initial : W) (history : List (Event L)) (suffix : List (Reply W L)),
    let action := finish (probe other core false select) bindings dest chunks
    let priorReplies : List (Event L) :=
      [.call bindings.lastindex [chunks],
       .call bindings.getindex [chunks, values 0],
       .call bindings.maskEnd [dest]]
    let continuation := match select (values 1) (values 2) (worlds 2) with
      | .words left right =>
          [.call bindings.setindexBang [chunks,
            JuliaLean.base.boot.intV core (JuliaLean.base.int.band left right), values 0]]
      | .custom =>
          [.call bindings.and [values 1, values 2],
           .call bindings.setindexBang [chunks, values 3, values 0]]
    FollowsPlan action values worlds initial history suffix (priorReplies ++ continuation) dest

/-- The concrete UInt64 branch preserves every bit according to Boolean AND,
without calling any open operator, changing the world or reinterpreting signed
integers. The actual returned word is observed by its 64 independent binary
digits, not by restating the band implementation. Source1128/int407. -/
def NativeAndLanes : Prop :=
  ∀ {W L : Type} (contexts : JuliaLean.base.broadcast.Models2Group5.Iteration.ContextOps W L)
      (bindings : Bindings L) (left right : Value L) (a b : JInt .u64) (world : W),
    let ops : Ops W L := { contexts := contexts, selectedAnd := fun _ _ _ => .words a b }
    ∃ word : JInt .u64,
      bitAnd ops bindings left right world = some (.ok
        (JuliaLean.base.boot.intV (contexts.inContext false) word, world)) ∧
      ∀ lane : Fin 64,
        ((word.val / (2 : Int) ^ lane.val) % 2).toNat =
          ((a.val / (2 : Int) ^ lane.val) % 2).toNat *
          ((b.val / (2 : Int) ^ lane.val) % 2).toNat

/-- One complete reachable iteration independently observes the source setup,
exact SIMD expansion, body and final mask. The branch guards classify the
scripted runtime outcomes; they assume no callee law or successful body.
Every call is separately allowed to fail/diverge after an arbitrary successful
prefix, preserving all earlier writes. This detects skipping the loop, wrong
f/args/chunks wiring, a missing second zero, wrong counter update, premature
masking, repeated end evaluation, or a lost destination reference.
Source: base/broadcast.jl:1120-1130; simdloop.jl:66-86. -/
def OneIterationRuntime : Prop :=
  ∀ {W L : Type} (core : CoreOps (ProbeWorld W L) L) (bindings : Bindings L)
      (dest bc : Value L) (boundscheck : Bool)
      (values : Nat → Value L) (worlds : Nat → W) (initial : W)
      (history : List (Event L)) (suffix : List (Reply W L)),
    let ops : Ops (ProbeWorld W L) L :=
      { contexts := { inContext := fun _ => observingOps core },
        selectedAnd := fun _ _ _ => .custom }
    let flag : Nat → Option Bool := fun position => match values position with
      | .leaf leaf => core.asBool leaf
      | _ => none
    if flag 0 = some false ∧
        core.same (values 8) (JuliaLean.base.boot.nothingV core) = false ∧
        flag 13 = some true ∧ flag 15 = some true ∧ flag 22 = some false ∧
        core.same (values 23) (JuliaLean.base.boot.nothingV core) = true then
      FollowsPlan (copy ops bindings dest bc boundscheck) values worlds initial history suffix
        [.call bindings.isempty [dest],
         .call bindings.liftfuncs [bc],
         .call bindings.flatten [values 1],
         .call bindings.getproperty [values 2, .symbol "args"],
         .call bindings.liftchunks [values 3],
         .call bindings.getproperty [dest, .symbol "chunks"],
         .call bindings.eachindex [values 5],
         .call bindings.simd.simd_outer_range [values 6],
         .call bindings.simd.iterate [values 7],
         .getfield (values 8) (JuliaLean.base.boot.intV core (JInt.lit .i64 1)),
         .getfield (values 8) (JuliaLean.base.boot.intV core (JInt.lit .i64 2)),
         .call bindings.simd.simd_inner_length [values 6, values 9],
         .call bindings.simd.zero [values 11],
         .call bindings.simd.less [values 12, values 11],
         .call bindings.simd.zero [values 11],
         .call bindings.simd.less [values 14, values 11],
         .call bindings.simd.simd_index [values 6, values 9, values 14],
         .call bindings.getproperty [values 2, .symbol "f"],
         .splat bindings.simd.iterate [bindings.ithchunk,
           JuliaLean.base.boot.tupleV core [values 16], values 4],
         .splat bindings.simd.iterate [values 17, values 18],
         .call bindings.setindexBang [values 5, values 19, values 16],
         .call bindings.simd.add [values 14, JuliaLean.base.boot.intV core (JInt.lit .i64 1)],
         .call bindings.simd.less [values 21, values 11],
         .call bindings.simd.iterate [values 7, values 10],
         .call bindings.lastindex [values 5],
         .call bindings.getindex [values 5, values 24],
         .call bindings.maskEnd [dest],
         .call bindings.and [values 25, values 26],
         .call bindings.setindexBang [values 5, values 27, values 24]] dest
    else True

def RuntimeContract : Prop :=
  SourcePrefixRuntime ∧ BodyRuntime ∧ FinishRuntime ∧ NativeAndLanes ∧ OneIterationRuntime

def proposedEntries : List Entry := [
  { id := "broadcast-chunked-copy-runtime", juliaFile := "base/broadcast.jl",
    juliaFns := ["chunkedcopyto!(dest::BitArray, bc::Broadcasted)"],
    statement := "Chunked copying short-circuits actual emptiness, evaluates preprocessing once in source order, executes the exact SIMD expansion with explicit loop state, writes each actual function result in bounds-elided context, then reads/end-masks/writes the last chunk and returns the original destination. Canonical UInt64 AND obeys all64 bit lanes, and every custom result, alias mutation, exception, world and divergence is retained.",
    source := "base/broadcast.jl:1120-1130; base/simdloop.jl:66-86; base/int.jl:407",
    status := .todo,
    prop := ``JuliaLean.Proofs.base.broadcast.Models2Group5.ChunkedCopy.RuntimeContract,
    thm := none,
    notes := "Open: NativeAndLanes needs the UInt64 band digit theorem for every Fin 64 lane; OneIterationRuntime additionally needs the SIMD partial fixed-point unfolding with all 29 exceptional prefixes." }
]

end JuliaLean.Proofs.base.broadcast.Models2Group5.ChunkedCopy


namespace JuliaLean.Proofs.base.broadcast.Models2Group5.NonleafCopy

open JuliaLean
open JuliaLean.Registry
open JuliaLean.base.expr (Value)
open JuliaLean.base.boot (CoreOps CoreM)
open JuliaLean.base.broadcast.Models2Group5.NonleafCopy
open JuliaLean.Proofs.base.broadcast.Models2Group5.ForwardObservations (Event Reply)
open JuliaLean.Proofs.base.broadcast.Models2Group5.IndexAccess.ContextObservations

/-- Context-labelled runtime observations retain both default-context source
calls and the explicitly inbounds read/write. Selectors see arbitrary payload
worlds, not proof scripts. No callee/selector correctness law is supplied. -/
def instrument {W L : Type} (core : Bool → CoreOps (World W L) L)
    (copySelect : CopyInputs L → W → Selection)
    (restartSelect : RestartInputs L → W → Selection) : Ops (World W L) L where
  contexts := { inContext := fun flag =>
    { core flag with
      call := fun function arguments => observe flag (.call function arguments)
      getfield := fun object field => observe flag (.getfield object field) } }
  selectedCopy := fun inputs world => copySelect inputs world.payload
  selectedRestart := fun inputs world => restartSelect inputs world.payload

/-- Observe a finite prescribed call plan and a designated returned reference,
including every error/divergence prefix with untouched future replies. -/
def Trace {W L : Type} (action : CoreM (World W L) L (Value L))
    (events : List (ContextEvent L)) (values : Nat → Value L) (worlds : Nat → W)
    (initial : W) (history : List (ContextEvent L)) (suffix : List (Reply W L))
    (returned : Value L) : Prop :=
  let count := events.length
  let successful := successes count values worlds
  let before : World W L := ⟨initial, successful ++ suffix, history⟩
  let after : World W L := ⟨worlds (count - 1), suffix, history ++ events⟩
  0 < count ∧ action before = some (.ok (returned, after)) ∧
    FailurePrefixes action successful events initial history suffix

/-- Flat observation prefix through the first actual broadcast value. The
explicit I,state=y assignment uses the generic indexed_iterate protocol and
only its required fields; the final bc read is the inbounds operation. -/
def copyPrefix {W L : Type} (core : Bool → CoreOps (World W L) L)
    (bindings : Bindings L) (dest bc iterator state : Value L)
    (values : Nat → Value L) : List (ContextEvent L) :=
  let one := JuliaLean.base.boot.intV (core true) (JInt.lit .i64 1)
  let two := JuliaLean.base.boot.intV (core true) (JInt.lit .i64 2)
  [call true bindings.eltype [dest],
   call true bindings.iterate [iterator, state],
   call true bindings.indexedIterate [values 1, one],
   ⟨true, .getfield (values 2) one⟩,
   ⟨true, .getfield (values 2) two⟩,
   call true bindings.indexedIterate [values 1, two, values 4],
   ⟨true, .getfield (values 5) one⟩,
   call false bindings.getindex [bc, values 3]]

/-- Every copy entry evaluates eltype then its actual stateful iterator.
Exhaustion returns original dest even if eltype returned a non-type, since isa
is not reached. Otherwise all generic destructuring and broadcast-read
failures remain at their precise default/inbounds context and retain worlds.
Both recursive selectors are entirely arbitrary. Source1145-1151. -/
def CopyPrefixRuntime : Prop :=
  ∀ {W L : Type} (core : Bool → CoreOps (World W L) L)
      (copySelect : CopyInputs L → W → Selection)
      (restartSelect : RestartInputs L → W → Selection)
      (bindings : Bindings L) (dest bc iterator state count : Value L)
      (values : Nat → Value L) (worlds : Nat → W) (initial : W)
      (history : List (ContextEvent L)) (suffix : List (Reply W L)),
    let action := copy (instrument core copySelect restartSelect)
      bindings dest bc iterator state count
    let priorReplies := copyPrefix core bindings dest bc iterator state values
    if (core true).same (values 1) (JuliaLean.base.boot.nothingV (core true)) then
      Trace action (priorReplies.take 2) values worlds initial history suffix dest
    else FailurePrefixes action (successes 8 values worlds) priorReplies initial history suffix

/-- Exact first-value branch policy with a selected custom restart. Invalid
eltype targets raise isa's TypeError after the value read; fitting values are
written before count+1 and the next iterator call, with cached T unchanged.
Non-fitting values promote from cached T and typeof(actual value), allocate,
then forward every exact restart argument without incrementing count early.
All operation outcomes, contexts, errors, aliases and worlds remain arbitrary.
Source: base/broadcast.jl:1145-1163. -/
def CopyBranchRuntime : Prop :=
  ∀ {W L : Type} (core : Bool → CoreOps (World W L) L) (bindings : Bindings L)
      (dest bc iterator state count : Value L)
      (values : Nat → Value L) (worlds : Nat → W) (initial : W)
      (history : List (ContextEvent L)) (suffix : List (Reply W L)),
    let normal := core true
    let ops := instrument core (fun _ _ => .custom) (fun _ _ => .custom)
    let action := copy ops bindings dest bc iterator state count
    let priorReplies := copyPrefix core bindings dest bc iterator state values
    if normal.same (values 1) (JuliaLean.base.boot.nothingV normal) then True
    else if normal.isa (values 0) (JuliaLean.base.boot.coreV normal "Type") then
      if normal.isa (values 7) (values 0) then
        let events := priorReplies ++
          [call false bindings.setindexBang [dest, values 7, values 3],
           call true bindings.add
             [count, JuliaLean.base.boot.intV normal (JInt.lit .i64 1)],
           call true bindings.iterate [iterator, values 6]]
        if normal.same (values 10) (JuliaLean.base.boot.nothingV normal) then
          Trace action events values worlds initial history suffix dest
        else FailurePrefixes action (successes 11 values worlds) events initial history suffix
      else
        Trace action (priorReplies ++
          [call true bindings.promoteTypejoin [values 0, .leaf (normal.typeOf (values 7))],
           call true bindings.similar [bc, values 8],
           call true bindings.restart
             [values 9, dest, bc, values 7, values 3, iterator, values 6, count]])
          values worlds initial history suffix (values 10)
    else
      let before : World W L := ⟨initial, successes 8 values worlds ++ suffix, history⟩
      let after : World W L := ⟨worlds 7, suffix, history ++ priorReplies⟩
      FailurePrefixes action (successes 8 values worlds) priorReplies initial history suffix ∧
      action before = some (.error
        (JuliaLean.base.boot.objV normal (.typeError (.symbol "isa")
          (JuliaLean.base.boot.strV normal "") (JuliaLean.base.boot.coreV normal "Type")
          (values 0)), after))

/-- A canonical restart is actually executed after widening, not replaced by
a named callback. Its current value is written after take is exhausted, then
count is incremented and the selected copy continuation receives newdest,
original iterator and newly destructured state. Every effect/failure prefix
is retained. The guards classify reachable source branches, not callee laws.
Source: base/broadcast.jl:1136-1163. -/
def WideningRecursionRuntime : Prop :=
  ∀ {W L : Type} (core : Bool → CoreOps (World W L) L) (bindings : Bindings L)
      (dest bc iterator state count : Value L)
      (values : Nat → Value L) (worlds : Nat → W) (initial : W)
      (history : List (ContextEvent L)) (suffix : List (Reply W L)),
    let normal := core true
    let ops := instrument core (fun _ _ => .custom) (fun _ _ => .builtin)
    let action := copy ops bindings dest bc iterator state count
    let priorReplies := copyPrefix core bindings dest bc iterator state values ++
      [call true bindings.promoteTypejoin [values 0, .leaf (normal.typeOf (values 7))],
       call true bindings.similar [bc, values 8],
       call true bindings.take [iterator, count],
       call true bindings.iterate [values 10]]
    if normal.same (values 1) (JuliaLean.base.boot.nothingV normal) = false ∧
        normal.isa (values 0) (JuliaLean.base.boot.coreV normal "Type") = true ∧
        normal.isa (values 7) (values 0) = false then
      if normal.same (values 11) (JuliaLean.base.boot.nothingV normal) then
        Trace action (priorReplies ++
          [call true bindings.setindexBang [values 9, values 7, values 3],
           call true bindings.add [count, JuliaLean.base.boot.intV normal (JInt.lit .i64 1)],
           call true bindings.copy [values 9, bc, iterator, values 6, values 13]])
          values worlds initial history suffix (values 14)
      else FailurePrefixes action (successes 12 values worlds) priorReplies initial history suffix
    else True

/-- Restart must call take(iter,count) and iterate that exact reply before
reading/writing a prefix element or writing the current element. These calls'
errors/divergence are preserved for every arbitrary selected continuation.
Source: base/broadcast.jl:1136-1143. -/
def RestartPrefixRuntime : Prop :=
  ∀ {W L : Type} (core : Bool → CoreOps (World W L) L)
      (copySelect : CopyInputs L → W → Selection)
      (restartSelect : RestartInputs L → W → Selection)
      (bindings : Bindings L) (newdest dest bc value index iterator state count : Value L)
      (values : Nat → Value L) (worlds : Nat → W) (initial : W)
      (history : List (ContextEvent L)) (suffix : List (Reply W L)),
    let action := restart (instrument core copySelect restartSelect)
