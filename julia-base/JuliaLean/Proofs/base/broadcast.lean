theorem corePure {W L A : Type} (value : A) (world : W) :
    (pure value : CoreM W L A) world = some (.ok (value, world)) := rfl

theorem coreThrow {W L A : Type} (value : Value L) (world : W) :
    (throw value : CoreM W L A) world = some (.error (value, world)) := rfl

theorem threePositions (position : Fin 3) : position = 0 ∨ position = 1 ∨ position = 2 := by
  have bound := position.isLt
  have h : position.val = 0 ∨ position.val = 1 ∨ position.val = 2 := by omega
  rcases h with h | h | h
  · exact Or.inl (Fin.ext h)
  · exact Or.inr (Or.inl (Fin.ext h))
  · exact Or.inr (Or.inr (Fin.ext h))

theorem observedOne {W L : Type} (action : Action W L)
    (event : CoreOps (ProbeWorld W L) L → Event L)
    (run : ∀ ops, action (observingOps ops) = observe (event ops)) :
    ReturnsLastAfter 0 action (fun ops _ _ _ => [event ops]) := by
  intro ops values worlds initial history suffix
  refine ⟨rfl, ?_, ?_, ?_⟩
  · rw [run]
    rfl
  · intro position error failureWorld
    have bound := position.isLt
    have hp : position = 0 := Fin.ext (by omega)
    subst position
    rw [run]
    rfl
  · intro position
    have bound := position.isLt
    have hp : position = 0 := Fin.ext (by omega)
    subst position
    rw [run]
    rfl

theorem observedTwo {W L : Type} (action : Action W L)
    (first : CoreOps (ProbeWorld W L) L → Event L)
    (second : CoreOps (ProbeWorld W L) L → Value L → Event L)
    (run : ∀ ops, action (observingOps ops) =
      (observe (first ops) >>= fun value => observe (second ops value))) :
    ReturnsLastAfter 1 action (fun ops values _ _ => [first ops, second ops (values 0)]) :=
  CombineProofs.returns_two action first second run

