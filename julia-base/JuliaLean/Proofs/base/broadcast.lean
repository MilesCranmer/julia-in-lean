theorem copy_branch_runtime : CopyBranchRuntime := by
  intro W L core bindings dest bc iterator state count values worlds initial history suffix
  cases started : (core true).same (values 1)
      (JuliaLean.base.boot.nothingV (core true)) with
  | true =>
      simp only [started, ↓reduceIte]
  | false =>
      simp only [started, Bool.false_eq_true, ↓reduceIte]
      have path := copy_read_steps core (fun _ _ => .custom) (fun _ _ => .custom)
        bindings dest bc iterator state count values worlds started
      cases valid : (core true).isa (values 0)
          (JuliaLean.base.boot.coreV (core true) "Type") with
      | false =>
          simp only [valid, Bool.false_eq_true, ↓reduceIte]
          rw [afterRead_invalid core (fun _ _ => .custom) (fun _ _ => .custom)
            bindings ⟨dest, bc, iterator, state, count⟩
            (values 0) (values 3) (values 6) (values 7) valid] at path
          refine ⟨?_, ?_⟩
          · simpa only [copy_frames_events, copy_frames_replies] using
              steps_prefix path initial history suffix
          · have payload : finalPayload
                (copyFrames core bindings dest bc iterator state values worlds) initial = worlds 7 := rfl
            simpa only [copy_frames_events, copy_frames_replies, payload, stop] using
              steps_success path initial history suffix
      | true =>
          simp only [valid, ↓reduceIte]
          cases fits : (core true).isa (values 7) (values 0) with
          | false =>
              simp only [fits, Bool.false_eq_true, ↓reduceIte]
              have tail := custom_widen_steps core (fun _ _ => .custom)
                bindings dest bc iterator state count values worlds valid fits
              have complete := steps_extend path tail
              apply steps_trace complete
              · change 0 < 11
                decide
              · rfl
              · rfl
              · rfl
          | true =>
              simp only [fits, ↓reduceIte]
              cases finished : (core true).same (values 10)
                  (JuliaLean.base.boot.nothingV (core true)) with
              | false =>
                  simp only [finished, Bool.false_eq_true, ↓reduceIte]
                  have tail := fit_tail_prefix core (fun _ _ => .custom) (fun _ _ => .custom)
                    bindings dest bc iterator state count values worlds valid fits
                  have complete := steps_prefix_extend path tail
                  apply prefix_observations complete
                  · rfl
                  · rfl
              | true =>
                  simp only [finished, ↓reduceIte]
                  have tail := fit_tail_steps core (fun _ _ => .custom) (fun _ _ => .custom)
                    bindings dest bc iterator state count values worlds valid fits finished
                  have complete := steps_extend path tail
                  apply steps_trace complete
                  · change 0 < 11
                    decide
                  · rfl
                  · rfl
                  · rfl

