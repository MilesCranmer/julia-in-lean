def replies {W L : Type} (count : Nat)
    (values : Nat → Value L) (worlds : Nat → W) : List (Reply W L) :=
  (List.range count).map (fun position => .returned (values position) (worlds position))

/-- A proof-only source prefix contract: every exceptional or diverging
operation stops before all later effects and leaves every later reply unused.
No success, type or reflection law is imposed on any call. -/
def FailurePrefixes {W L : Type} (action : CoreM (ProbeWorld W L) L (Value L))
    (successful : List (Reply W L)) (prescribed : List (Event L))
    (initial : W) (history : List (Event L)) (suffix : List (Reply W L)) : Prop :=
  (∀ (position : Fin successful.length) (error : Value L) (failedWorld : W),
    let remaining := successful.drop (position.val + 1) ++ suffix
    let before : ProbeWorld W L :=
      ⟨initial, successful.take position.val ++ [.thrown error failedWorld] ++
        remaining, history⟩
    let after : ProbeWorld W L :=
      ⟨failedWorld, remaining, history ++ prescribed.take (position.val + 1)⟩
    action before = some (.error (error, after))) ∧
  (∀ position : Fin successful.length,
    let before : ProbeWorld W L :=
      ⟨initial, successful.take position.val ++ [.diverged] ++
        successful.drop (position.val + 1) ++ suffix, history⟩
    action before = none)

/-- Independent observation grammar for an inference gate. The first k+1
calls establish the argument object. Bottom identity forbids both subsequent
inference calls; otherwise reflection receives the original callable and
that exact object, and promotion receives its exact reply. Arbitrary suffixes
detect forbidden work after either branch, and every reachable failure or
divergence preserves its precise source prefix. -/
def BottomGate {W L : Type} (k : Nat) (bindings : Bindings L)
    (function : Value L) (action : Action W L)
    (priorReplies : CoreOps (ProbeWorld W L) L → (Nat → Value L) → List (Event L)) : Prop :=
  ∀ (core : CoreOps (ProbeWorld W L) L) (values : Nat → Value L) (worlds : Nat → W)
      (initial : W) (history : List (Event L)) (suffix : List (Reply W L)),
    let bottom := JuliaLean.base.boot.coreV core "Union{}"
    let stops := core.same (values k) bottom
    let count := if stops then k + 1 else k + 3
    let prescribed := priorReplies core values ++
      (if stops then [] else
        [.call bindings.returnType [function, values k],
         .call bindings.promoteUnion [values (k + 1)]])
    let successful := replies count values worlds
    let before : ProbeWorld W L := ⟨initial, successful ++ suffix, history⟩
    let after : ProbeWorld W L :=
      ⟨worlds (count - 1), suffix, history ++ prescribed⟩
    let result := if stops then bottom else values (k + 2)
    let observed := action (observingOps core)
    (priorReplies core values).length = k + 1 ∧ prescribed.length = count ∧
    observed before = some (.ok (result, after)) ∧
    FailurePrefixes observed successful prescribed initial history suffix

/-- The original broadcast's typeof and actual eachindex/eltype replies
determine the TupleOrBottom call, in source order. Exact bottom identity skips
reflection and promotion; every other returned object reaches the original
_bc_eltype callable's reflection query. Full runtime type objects, mutations,
errors and divergence remain in scope. Source: base/broadcast.jl:756-761. -/
def ResultEltypeObservations : Prop :=
  ∀ {W L : Type} (bindings : Bindings L) (bc : Value L),
    BottomGate (W := W) (L := L) 2 bindings bindings.bcEltype
      (fun core => resultEltype core bindings bc)
      (fun core values =>
        [.call bindings.eachindex [bc],
         .call bindings.eltype [values 0],
         .call bindings.tupleOrBottom [.leaf (core.typeOf bc), values 1]])

/-- The retained Broadcasted wrapper captures f before args and passes those
exact two property replies to combine_eltypes. No property or inference law
is assumed. Source: base/broadcast.jl:765. -/
def BroadcastedEltypeObservations : Prop :=
  ∀ {W L : Type} (bindings : Bindings L) (bc : Value L),
    ReturnsLastAfter (W := W) (L := L) 2
      (fun core => broadcastedEltype core bindings bc)
      (fun _ values _ _ =>
        [.call bindings.getproperty [bc, .symbol "f"],
         .call bindings.getproperty [bc, .symbol "args"],
         .call bindings.combineEltypes [values 0, values 1]])

/-- The generic retained element-type helper returns the original value's
selected eltype outcome unchanged. Source: base/broadcast.jl:766. -/
def OtherEltypeObservations : Prop :=
  ∀ {W L : Type} (bindings : Bindings L) (value : Value L),
    ReturnsLastAfter (W := W) (L := L) 0
      (fun core => otherEltype core bindings value)
      (fun _ _ _ _ => [.call bindings.eltype [value]])

/-- Singleton tuple inference indexes the original tuple once by native one,
queries that exact element and then constructs the result from its exact type
reply. Arbitrary returned objects and all effect outcomes remain admitted.
Source: base/broadcast.jl:769. -/
def OneEltypeObservations : Prop :=
  ∀ {W L : Type} (bindings : Bindings L) (tuple : Value L),
    ReturnsLastAfter (W := W) (L := L) 2
      (fun core => oneEltype core bindings tuple)
      (fun core values _ _ =>
        [.call bindings.getindex [tuple, JuliaLean.base.boot.intV core (JInt.lit .i64 1)],
         .call bindings.broadcastGetindexEltype [values 0],
         .call bindings.tupleOrBottom [values 1]])

/-- Both pair element queries finish before TupleOrBottom starts. The left
query precedes even the right indexing operation, and a bottom left result
does not suppress right-side mutation, error or divergence.
Source: base/broadcast.jl:770. -/
def TwoEltypeObservations : Prop :=
  ∀ {W L : Type} (bindings : Bindings L) (tuple : Value L),
    ReturnsLastAfter (W := W) (L := L) 4
      (fun core => twoEltypes core bindings tuple)
      (fun core values _ _ =>
        [.call bindings.getindex [tuple, JuliaLean.base.boot.intV core (JInt.lit .i64 1)],
         .call bindings.broadcastGetindexEltype [values 0],
         .call bindings.getindex [tuple, JuliaLean.base.boot.intV core (JInt.lit .i64 2)],
         .call bindings.broadcastGetindexEltype [values 2],
         .call bindings.tupleOrBottom [values 1, values 3]])

/-- combine_eltypes queries the actual argument tuple before inference. Only
bottom skips the original callable's reflection query; promotion receives the
actual reflection reply. Full type identity, custom dispatch and every
runtime effect remain arbitrary. Source: base/broadcast.jl:774-778. -/
def CombineEltypesObservations : Prop :=
  ∀ {W L : Type} (bindings : Bindings L) (function arguments : Value L),
    BottomGate (W := W) (L := L) 0 bindings function
      (fun core => combineEltypes core bindings function arguments)
      (fun _ _ => [.call bindings.eltypes [arguments]])

def observingInference {W L : Type} (core : CoreOps (ProbeWorld W L) L)
    (select : Value L → W → Method) : Ops (ProbeWorld W L) L where
  toCoreOps := observingOps core
  selectedEltypes := fun tuple world => select tuple world.payload

/-- A known empty child returns the fixed Tuple{} constant. A recursive child
can return either the actual final reply or the source's literal Union{};
other terminal children return their actual last reply. This provenance
classification assumes no type/identity law or child correctness theorem. -/
def TailProvenance {L : Type} (empty bottom last value : Value L) : Method → Prop
  | .empty => value = empty
  | .recursive => value = last ∨ value = bottom
  | .one => value = last
  | .two => value = last
  | .custom => value = last

/-- Independent completed-path invariant for source771. The first observation
is always tail(t). A completed bottom path returns only the actual Union{}
constant and has no final head-composition suffix. A completed composition
ends with the original head indexing, its element-type query, the actual
child result's parameters property, and a splat using those two exact replies.
The returned value is the final splat reply. Every completion consumes an
exact prefix of arbitrary runtime replies, preserves its world and suffix,
and every error is the first exceptional reply unchanged.

The property uses terminal reply provenance and a flat four-event suffix,
not a second recursive interpreter. It covers arbitrary depth, custom tail
objects and current-world selection. CoreM returns no trace for divergence;
the separate leaf and initial-failure contracts require observable finite
outcomes at their actual source positions. Source: base/broadcast.jl:768-771. -/
def TupleEltypesCompletionInvariant : Prop :=
  ∀ {W L : Type} (core : CoreOps (ProbeWorld W L) L)
      (select : Value L → W → Method) (bindings : Bindings L)
      (tuple : Value L) (before : ProbeWorld W L),
    let action := tupleEltypes (observingInference core select) bindings tuple
    let bottom := JuliaLean.base.boot.coreV core "Union{}"
    match action before with
    | none => True
    | some (.error (error, after)) =>
        ∃ (count : Nat) (values : Nat → Value L) (worlds : Nat → W)
          (trace : List (Event L)),
          0 < count ∧ before.replies = replies (count - 1) values worlds ++
            [.thrown error after.payload] ++ after.replies ∧
          after.events = before.events ++ trace ∧ trace.length = count ∧
          trace.take 1 = [.call bindings.tail [tuple]]
    | some (.ok (value, after)) =>
        ∃ (count : Nat) (values : Nat → Value L) (worlds : Nat → W)
          (trace : List (Event L)),
          0 < count ∧ before.replies = replies count values worlds ++ after.replies ∧
          after.payload = worlds (count - 1) ∧ after.events = before.events ++ trace ∧
          trace.length = count ∧ trace.take 1 = [.call bindings.tail [tuple]] ∧
          ((∃ tailType,
             TailProvenance bindings.emptyTupleType bottom (values (count - 1)) tailType
               (select (values 0) (worlds 0)) ∧
             core.same tailType bottom = true ∧ value = bottom) ∨
           (5 ≤ count ∧ value = values (count - 1) ∧
            ∃ (tailType : Value L) (front : List (Event L)),
              TailProvenance bindings.emptyTupleType bottom (values (count - 5)) tailType
                (select (values 0) (worlds 0)) ∧
              core.same tailType bottom = false ∧
              trace = front ++
                [.call bindings.getindex
                   [tuple, JuliaLean.base.boot.intV core (JInt.lit .i64 1)],
                 .call bindings.broadcastGetindexEltype [values (count - 4)],
                 .call bindings.getproperty [tailType, .symbol "parameters"],
                 .splat bindings.iterate
                   [bindings.tupleOrBottom,
                    JuliaLean.base.boot.tupleV core [values (count - 3)],
                    values (count - 2)]]))

/-- Every recursive path starts with the real tail operation. Its error or
divergence prevents all selected recursive work and all head queries. -/
def TupleEltypesInitialFailure : Prop :=
  ∀ {W L : Type} (core : CoreOps (ProbeWorld W L) L)
      (select : Value L → W → Method) (bindings : Bindings L)
      (tuple error : Value L) (initial failed : W)
      (history : List (Event L)) (suffix : List (Reply W L)),
    let action := tupleEltypes (observingInference core select) bindings tuple
    let before : ProbeWorld W L := ⟨initial, .thrown error failed :: suffix, history⟩
    let after : ProbeWorld W L :=
      ⟨failed, suffix, history ++ [.call bindings.tail [tuple]]⟩
    let diverged : ProbeWorld W L := ⟨initial, .diverged :: suffix, history⟩
    action before = some (.error (error, after)) ∧ action diverged = none

/-- Full finite trace when the actual post-tail metadata selects the empty
method. Both bottom/continuation cases are retained even for arbitrary runtime
identity metadata. The continuation uses the fixed Tuple{} value's real
parameters property, and every reachable failure/divergence prefix stops
exactly. No assumption about the head/query/property/splat callees is made. -/
def TupleEltypesEmptyChild : Prop :=
  ∀ {W L : Type} (core : CoreOps (ProbeWorld W L) L)
      (select : Value L → W → Method) (bindings : Bindings L) (tuple : Value L)
      (values : Nat → Value L) (worlds : Nat → W) (initial : W)
      (history : List (Event L)) (suffix : List (Reply W L)),
    match select (values 0) (worlds 0) with
    | .empty =>
        let bottom := JuliaLean.base.boot.coreV core "Union{}"
        let stops := core.same bindings.emptyTupleType bottom
        let count := if stops then 1 else 5
        let prescribed : List (Event L) := [.call bindings.tail [tuple]] ++
          (if stops then [] else
            [.call bindings.getindex
               [tuple, JuliaLean.base.boot.intV core (JInt.lit .i64 1)],
             .call bindings.broadcastGetindexEltype [values 1],
             .call bindings.getproperty [bindings.emptyTupleType, .symbol "parameters"],
             .splat bindings.iterate
               [bindings.tupleOrBottom, JuliaLean.base.boot.tupleV core [values 2], values 3]])
        let successful := replies count values worlds
        let before : ProbeWorld W L := ⟨initial, successful ++ suffix, history⟩
        let after : ProbeWorld W L :=
          ⟨worlds (count - 1), suffix, history ++ prescribed⟩
        let action := tupleEltypes (observingInference core select) bindings tuple
        action before = some (.ok ((if stops then bottom else values 4), after)) ∧
        FailurePrefixes action successful prescribed initial history suffix
    | _ => True

def TupleEltypesRuntimeInvariant : Prop :=
  TupleEltypesCompletionInvariant ∧ TupleEltypesInitialFailure ∧ TupleEltypesEmptyChild

