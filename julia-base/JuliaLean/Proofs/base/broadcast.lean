namespace JuliaLean.Proofs.base.broadcast.Models2Group5.IndexAccess

open JuliaLean
open JuliaLean.Registry
open JuliaLean.base.expr (Value)
open JuliaLean.base.boot (CoreOps CoreM)
open JuliaLean.base.broadcast.Models2Group5.IndexAccess

namespace ContextObservations

open JuliaLean.Proofs.base.broadcast.Models2Group5.ForwardObservations (Event Reply)

/- Proof-only contextual observations. Runtime actions remain the installed
CoreOps hooks; no observation helper implements an indexing algorithm. -/

structure ContextEvent (L : Type) where
  boundscheck : Bool
  event : Event L

structure World (W L : Type) where
  payload : W
  replies : List (Reply W L)
  events : List (ContextEvent L)

def observe {W L : Type} (boundscheck : Bool) (event : Event L) :
    CoreM (World W L) L (Value L) := fun world =>
  match world.replies with
  | [] => none
  | .diverged :: _ => none
  | .returned value payload :: remaining =>
      some (.ok (value, ⟨payload, remaining,
        world.events ++ [⟨boundscheck, event⟩]⟩))
  | .thrown error payload :: remaining =>
      some (.error (error, ⟨payload, remaining,
        world.events ++ [⟨boundscheck, event⟩]⟩))

def observingContexts {W L : Type}
    (core : Bool → CoreOps (World W L) L) :
    JuliaLean.base.broadcast.Models2Group5.Iteration.ContextOps (World W L) L where
  inContext := fun context =>
    { core context with
      call := fun function arguments => observe context (.call function arguments) }

def call {L : Type} (context : Bool) (function : Value L)
    (arguments : List (Value L)) : ContextEvent L :=
  ⟨context, .call function arguments⟩

def successes {W L : Type} (count : Nat)
    (values : Nat → Value L) (worlds : Nat → W) : List (Reply W L) :=
  (List.range count).map (fun index => .returned (values index) (worlds index))

/-- Every failure site preserves its exact exception and world, records only
the prefix through that call, and leaves every later reply untouched. Every
diverging operation remains divergence after the same arbitrary successful
prefix. The sequences here are finite proof records, not Julia arrays. -/
def FailurePrefixes {W L : Type} (action : CoreM (World W L) L (Value L))
    (successful : List (Reply W L)) (prescribed : List (ContextEvent L))
    (initial : W) (history : List (ContextEvent L)) (suffix : List (Reply W L)) : Prop :=
  (∀ (position : Fin successful.length) (error : Value L) (failureWorld : W),
    let remaining := successful.drop (position.val + 1) ++ suffix
    let before : World W L :=
      ⟨initial, successful.take position.val ++
        [.thrown error failureWorld] ++ remaining, history⟩
    let after : World W L :=
      ⟨failureWorld, remaining, history ++ prescribed.take (position.val + 1)⟩
    action before = some (.error (error, after))) ∧
  (∀ position : Fin successful.length,
    let before : World W L :=
      ⟨initial, successful.take position.val ++ [.diverged] ++
        successful.drop (position.val + 1) ++ suffix, history⟩
    action before = none)

/-- A terminal trace returns its final arbitrary reply and world with the
specified context-labelled observations, then stops. No premise restricts a
callee to success, a particular returned type, or a correct answer. -/
def ReturnsLast {W L : Type} (action : CoreM (World W L) L (Value L))
    (count : Nat) (values : Nat → Value L) (worlds : Nat → W)
    (prescribed : List (ContextEvent L)) (initial : W)
    (history : List (ContextEvent L)) (suffix : List (Reply W L)) : Prop :=
  let successful := successes count values worlds
  let before : World W L := ⟨initial, successful ++ suffix, history⟩
  let after : World W L := ⟨worlds (count - 1), suffix, history ++ prescribed⟩
  0 < count ∧ prescribed.length = count ∧
  action before = some (.ok (values (count - 1), after)) ∧
  FailurePrefixes action successful prescribed initial history suffix

/-- A nonterminal finite prefix cannot return a value before another source
operation. Its every failure/divergence position is observable; exhaustion of
the finite proof reply stream is divergence, never a fabricated value. This
contract is quantified at every prefix depth, including paths with no finite
terminal selection. CoreM does not return a trace for divergence. -/
def ContinuesAfter {W L : Type} (action : CoreM (World W L) L (Value L))
    (count : Nat) (values : Nat → Value L) (worlds : Nat → W)
    (prescribed : List (ContextEvent L)) (initial : W)
    (history : List (ContextEvent L)) (suffix : List (Reply W L)) : Prop :=
  let successful := successes count values worlds
  let exhausted : World W L := ⟨initial, successful, history⟩
  0 < count ∧ prescribed.length = count ∧ action exhausted = none ∧
  FailurePrefixes action successful prescribed initial history suffix

end ContextObservations

open ContextObservations
open JuliaLean.Proofs.base.broadcast.Models2Group5.ForwardObservations (Reply)

/-- The public vararg entry preserves flatten → to_index → IndexStyle →
_getindex order, tuple identity and provenance of all three intermediate
values. Every call uses the source's incoming propagated bounds context.
Native-bounded tuples retain heterogeneous custom coordinates and references.
All runtime return values, errors, worlds and divergence sites are arbitrary.
Source: base/broadcast.jl:615-618; devdocs/boundscheck.md:70-79. -/
def PublicEntryObservations : Prop :=
  ∀ {W L : Type} (core : Bool → CoreOps (World W L) L)
      (bindings : Bindings L) (bc : Value L)
      (indices : JuliaLean.base.broadcast.Models2Group5.Constructors.ArgumentTuple L)
      (boundscheck : Bool) (values : Nat → Value L) (worlds : Nat → W)
      (initial : W) (history : List (ContextEvent L)) (suffix : List (Reply W L)),
    let contexts := observingContexts core
    ReturnsLast (getindexBroadcasted contexts bindings bc indices boundscheck)
      4 values worlds
      [call boundscheck bindings.flatten
         [JuliaLean.base.boot.tupleV (core boundscheck) indices.values],
       call boundscheck bindings.toIndex [values 0],
       call boundscheck bindings.indexStyle [bc],
       call boundscheck bindings.getindexHelper [values 2, bc, values 1]]
      initial history suffix

/-- The generic helper checks only when its incoming bounds block is retained,
and always reads in the explicit false context selected by @inbounds. Its
successful check reply is ignored; the original bc and coordinate are used
unchanged for the read. Failures stop before later effects, and no check is
observed in the elided case. Source: base/broadcast.jl:619-622;
devdocs/boundscheck.md:12-36,70-79. -/
def GenericObservations : Prop :=
  ∀ {W L : Type} (core : Bool → CoreOps (World W L) L)
      (bindings : Bindings L) (style bc index : Value L) (boundscheck : Bool)
      (values : Nat → Value L) (worlds : Nat → W) (initial : W)
      (history : List (ContextEvent L)) (suffix : List (Reply W L)),
    let contexts := observingContexts core
    let prescribed :=
      (if boundscheck then [call true bindings.checkbounds [bc, index]] else []) ++
      [call false bindings.broadcastGetindex [bc, index]]
    ReturnsLast (getindexGeneric contexts bindings style bc index boundscheck)
      (if boundscheck then 2 else 1) values worlds prescribed initial history suffix

/-- A terminal dispatch is either the generic read or a genuinely selected
different method. Conversion methods continue with another coordinate. -/
def isTerminal : Method → Bool
  | .generic => true
  | .custom => true
  | .cartesianInteger => false
  | .linearCartesian => false

/-- Proof-only selection at a candidate conversion depth. All earlier
conversion blocks have exactly three source operations, so the last arbitrary
reply of the preceding block supplies this call's index and payload world.
The root selected body is fixed by its method entry, never reselected. -/
def methodAt {W L : Type}
    (select : Value L → Value L → Value L → W → Method) (entry : Method)
    (style bc : Value L) (values : Nat → Value L) (worlds : Nat → W)
    (depth : Nat) : Method :=
  match depth with
  | 0 => entry
  | successor + 1 =>
      select style bc (values (3 * (successor + 1) - 1))
        (worlds (3 * (successor + 1) - 1))

/-- Coordinate provenance after an arbitrary number of conversion blocks. -/
def indexAt {L : Type} (original : Value L) (values : Nat → Value L)
    (depth : Nat) : Value L :=
  match depth with
  | 0 => original
  | successor + 1 => values (3 * (successor + 1) - 1)

/-- Closed-form flat observation grammar for a conversion prefix. Each block
queries the original bc's axes, constructs the selected index representation,
then indexes it with the preceding block's actual coordinate. The original
style and bc are never replaced. This maps proof positions to source calls;
it does not run or recursively restate the model algorithm. -/
def conversionEvents {L : Type} (bindings : Bindings L) (boundscheck : Bool)
    (bc original : Value L) (values : Nat → Value L)
    (methods : Nat → Method) (depth : Nat) : List (ContextEvent L) :=
  (List.range depth).flatMap (fun step =>
    let constructor := match methods step with
      | .cartesianInteger => bindings.cartesianIndices
      | _ => bindings.linearIndices
    [call boundscheck bindings.axes [bc],
     call boundscheck constructor [values (3 * step)],
     call boundscheck bindings.getindex
       [values (3 * step + 1), indexAt original values step]])

/-- The final source observations depend only on the selected terminal body.
The generic body has a conditional checked call and an unconditionally
inbounds read; the custom body receives the original style and bc and the
exact converted index. Conversion cases are not terminals. -/
def terminalEvents {L : Type} (bindings : Bindings L) (boundscheck : Bool)
    (style bc index : Value L) : Method → List (ContextEvent L)
  | .generic =>
      (if boundscheck then [call true bindings.checkbounds [bc, index]] else []) ++
      [call false bindings.broadcastGetindex [bc, index]]
  | .custom => [call boundscheck bindings.getindexHelper [style, bc, index]]
  | .cartesianInteger => []
  | .linearCartesian => []

def observingDispatch {W L : Type}
    (core : Bool → CoreOps (World W L) L)
    (select : Value L → Value L → Value L → W → Method) : Ops (World W L) L where
  contexts := observingContexts core
  selectedGetindex := fun style bc index world => select style bc index world.payload

/-- Independent arbitrary-depth trace and provenance invariant for a selected
conversion method. A finite scan of pure dispatch metadata finds the first
terminal candidate; there is no assumption that a selector ever terminates,
chooses a particular body, or is unaffected by mutations. Prior conversion
events are a flat list indexed by depth, not a second recursive implementation.

If a terminal occurs within the observation window, the model produces exactly
the prefix plus terminal event list, returns its final arbitrary reply, and
preserves every error/divergence prefix. If no terminal occurs, all three calls
of every conversion block remain observable and the model cannot fabricate a
finite return. Quantifying every window admits repeated conversion methods,
alternating conversions and paths with no finite terminal. Incoming context is
retained until the generic body's explicit @inbounds read. Every supplied and
returned value keeps its identity, including custom/offset axes and mutable
references. Source: base/broadcast.jl:619-630. -/
def ConversionObservations (entry : Method) : Prop :=
  ∀ {W L : Type} (core : Bool → CoreOps (World W L) L)
      (select : Value L → Value L → Value L → W → Method)
      (bindings : Bindings L) (style bc index : Value L) (boundscheck : Bool)
      (values : Nat → Value L) (worlds : Nat → W) (initial : W)
      (history : List (ContextEvent L)) (suffix : List (Reply W L))
      (window : Nat),
    let methods := methodAt select entry style bc values worlds
    let ops := observingDispatch core select
    let action := match entry with
      | .cartesianInteger =>
          getindexCartesianInteger ops bindings style bc index boundscheck
      | .linearCartesian =>
          getindexLinearCartesian ops bindings style bc index boundscheck
      | _ => runMethod ops bindings entry style bc index boundscheck
    match (List.range (window + 1)).find? (fun depth => isTerminal (methods depth)) with
    | none =>
        let depth := window + 1
        ContinuesAfter action (3 * depth) values worlds
          (conversionEvents bindings boundscheck bc index values methods depth)
          initial history suffix
    | some depth =>
        let tail := terminalEvents bindings boundscheck style bc
          (indexAt index values depth) (methods depth)
        let prescribed :=
          conversionEvents bindings boundscheck bc index values methods depth ++ tail
        depth ≤ window ∧ isTerminal (methods depth) = true ∧
        ReturnsLast action (3 * depth + tail.length) values worlds
