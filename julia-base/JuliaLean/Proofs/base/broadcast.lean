def finishFrame {W L : Type} (ops : CoreOps W L) (bindings : Bindings L)
    (typeValue bc index firstValue : Value L) : CoreM W L (Value L) := do
  let storedAgain ← ops.call bindings.getproperty [bc, .symbol "args"]
  let tailOnce ← ops.call bindings.tail [storedAgain]
  let tailTwice ← ops.call bindings.tail [tailOnce]
  let arguments ← ops.call bindings.gather [tailTwice, index]
  let function ← ops.call bindings.getproperty [bc, .symbol "f"]
  ops.applyIterate bindings.iterate
    [bindings.evalf, JuliaLean.base.boot.tupleV ops [function, firstValue, typeValue], arguments]

def stack {W L : Type} (finish : Nat → Value L → CoreM W L (Value L)) :
    Nat → CoreM W L (Value L) → CoreM W L (Value L)
  | 0, action => action
  | depth + 1, action => stack finish depth (action >>= finish depth)

theorem stack_transfer {W L : Type} (finish : Nat → Value L → CoreM W L (Value L))
    (depth : Nat) (left right : CoreM W L (Value L)) (before after : W)
    (same : left before = right after) :
    stack finish depth left before = stack finish depth right after := by
  induction depth generalizing left right before after with
  | zero => exact same
  | succ depth ih =>
    apply ih
    simp only [bind_apply, same]

theorem stack_none {W L : Type} (finish : Nat → Value L → CoreM W L (Value L))
    (depth : Nat) (action : CoreM W L (Value L)) (world : W)
    (stopped : action world = none) : stack finish depth action world = none := by
  induction depth generalizing action with
  | zero => exact stopped
  | succ depth ih =>
    apply ih
    simp only [bind_apply, stopped]

theorem stack_error {W L : Type} (finish : Nat → Value L → CoreM W L (Value L))
    (depth : Nat) (action : CoreM W L (Value L)) (before after : W) (error : Value L)
    (stopped : action before = some (.error (error, after))) :
    stack finish depth action before = some (.error (error, after)) := by
  induction depth generalizing action with
  | zero => exact stopped
  | succ depth ih =>
    apply ih
    simp only [bind_apply, stopped]

def frameAt {W L : Type} (core : Bool → CoreOps (World W L) L)
    (select : Value L → Value L → W → ElementMethod L) (bindings : Bindings L)
    (originalType original index : Value L) (boundscheck : Bool)
    (values : Nat → Value L) (worlds : Nat → W) (depth : Nat) :
    Value L → CoreM (World W L) L (Value L) :=
  finishFrame ((observeContexts core).inContext boundscheck) bindings
    (typeAt select originalType index values worlds depth) (inputAt original values depth) index

def payloadAt {W : Type} (initial : W) (worlds : Nat → W) : Nat → W
  | 0 => initial
  | depth + 1 => worlds (2 * (depth + 1) - 1)

theorem successes_two {W L : Type} (values : Nat → Value L) (worlds : Nat → W) :
    successes 2 values worlds =
      [.returned (values 0) (worlds 0), .returned (values 1) (worlds 1)] := rfl

def blockEvents {W L : Type} (core : Bool → CoreOps (World W L) L)
    (bindings : Bindings L) (original : Value L) (boundscheck : Bool)
    (values : Nat → Value L) (depth : Nat) : List (ContextEvent L) :=
  [call boundscheck bindings.getproperty [inputAt original values depth, .symbol "args"],
   call boundscheck bindings.getindex
     [values (2 * depth), JuliaLean.base.boot.intV (core boundscheck) (JInt.lit .i64 1)]]

theorem descentEvents_succ {W L : Type} (core : Bool → CoreOps (World W L) L)
    (bindings : Bindings L) (original : Value L) (boundscheck : Bool)
    (values : Nat → Value L) (depth : Nat) :
    descentEvents (core boundscheck) bindings original boundscheck values (depth + 1) =
      descentEvents (core boundscheck) bindings original boundscheck values depth ++
        blockEvents core bindings original boundscheck values depth := by
  simp only [descentEvents, blockEvents, List.range_succ, List.flatMap_append,
    List.flatMap_cons, List.flatMap_nil, List.append_nil]

theorem descentEvents_length {W L : Type} (core : Bool → CoreOps (World W L) L)
    (bindings : Bindings L) (original : Value L) (boundscheck : Bool)
    (values : Nat → Value L) (depth : Nat) :
    (descentEvents (core boundscheck) bindings original boundscheck values depth).length = 2 * depth := by
  induction depth with
  | zero => rfl
  | succ depth ih =>
    rw [descentEvents_succ, List.length_append, ih]
    simp only [blockEvents, List.length_cons, List.length_nil]
    omega

theorem run_descent_prefix {W L : Type} (core : Bool → CoreOps (World W L) L)
    (select : Value L → Value L → W → ElementMethod L) (bindings : Bindings L)
    (originalType original index : Value L) (boundscheck : Bool)
    (values : Nat → Value L) (worlds : Nat → W) (initial : W)
    (history : List (ContextEvent L)) (suffix : List (Reply W L)) (depth : Nat)
    (nonterminal : ∀ step, step < depth →
      isOther (select (values (2 * step + 1)) index (worlds (2 * step + 1))) = false) :
    secondType (observingSecond core select) bindings originalType original index boundscheck
      ⟨initial, successes (2 * depth) values worlds ++ suffix, history⟩ =
    stack (frameAt core select bindings originalType original index boundscheck values worlds) depth
      (secondType (observingSecond core select) bindings
        (typeAt select originalType index values worlds depth) (inputAt original values depth)
        index boundscheck)
      ⟨payloadAt initial worlds depth, suffix,
        history ++ descentEvents (core boundscheck) bindings original boundscheck values depth⟩ := by
  revert nonterminal
  induction depth generalizing suffix with
  | zero =>
    intro nonterminal
    simp only [Nat.mul_zero, successes, List.range_zero, List.map_nil, List.nil_append,
      stack, payloadAt, typeAt, inputAt, descentEvents, List.flatMap_nil, List.append_nil]
  | succ depth ih =>
    intro nonterminal
    have countEq : 2 * (depth + 1) = 2 * depth + 2 := by omega
    have lastEq : 2 * (depth + 1) - 1 = 2 * depth + 1 := by omega
    rw [countEq, successes_add, List.append_assoc]
    rw [ih (suffix := successes 2 (fun i => values (2 * depth + i))
      (fun i => worlds (2 * depth + i)) ++ suffix)
      (fun step h => nonterminal step (by omega))]
    rw [stack]
    apply stack_transfer
    have selectedNonterminal := nonterminal depth (by omega)
    cases selected : select (values (2 * depth + 1)) index (worlds (2 * depth + 1)) with
    | other => simp only [selected, isOther, Bool.true_eq_false] at selectedNonterminal
    | same nextType =>
      rw [secondType.eq_def]
      simp only [observingSecond, observeContexts, successes_two,
        List.cons_append, List.nil_append, bind_apply, observe, selected,
        frameAt, finishFrame, descentEvents_succ, blockEvents, inputAt, typeAt,
        payloadAt, lastEq, Nat.add_zero, call, JuliaLean.base.boot.intV, List.append_assoc]

theorem descentEvents_take_blocks {W L : Type} (core : Bool → CoreOps (World W L) L)
    (bindings : Bindings L) (original : Value L) (boundscheck : Bool)
    (values : Nat → Value L) (depth preCount : Nat) (bound : preCount ≤ depth) :
    (descentEvents (core boundscheck) bindings original boundscheck values depth).take (2 * preCount) =
      descentEvents (core boundscheck) bindings original boundscheck values preCount := by
  revert preCount
  induction depth with
  | zero =>
    intro preCount bound
    have hp : preCount = 0 := by omega
    subst preCount
    rfl
  | succ depth ih =>
    intro preCount bound
    by_cases earlier : preCount ≤ depth
    · rw [descentEvents_succ, List.take_append, descentEvents_length]
      have noTail : 2 * preCount - 2 * depth = 0 := by omega
      rw [noTail, List.take_zero, List.append_nil, ih preCount earlier]
    · have last : preCount = depth + 1 := by omega
      subst preCount
      exact take_full _ _ (by rw [descentEvents_length]; omega)

theorem descentEvents_take_with_tail {W L : Type} (core : Bool → CoreOps (World W L) L)
    (bindings : Bindings L) (original : Value L) (boundscheck : Bool)
    (values : Nat → Value L) (depth preCount : Nat) (tail : List (ContextEvent L))
    (bound : preCount ≤ depth) :
    (descentEvents (core boundscheck) bindings original boundscheck values depth ++ tail).take
      (2 * preCount) = descentEvents (core boundscheck) bindings original boundscheck values preCount := by
  rw [List.take_append, descentEvents_length]
  have noTail : 2 * preCount - 2 * depth = 0 := by omega
  rw [noTail, List.take_zero, List.append_nil,
    descentEvents_take_blocks core bindings original boundscheck values depth preCount bound]

theorem descentEvents_take_inside {W L : Type} (core : Bool → CoreOps (World W L) L)
    (bindings : Bindings L) (original : Value L) (boundscheck : Bool)
    (values : Nat → Value L) (depth step offset : Nat) (tail : List (ContextEvent L))
    (stepBound : step < depth) (offsetBound : offset < 2) :
    (descentEvents (core boundscheck) bindings original boundscheck values depth ++ tail).take
      (2 * step + offset + 1) =
      descentEvents (core boundscheck) bindings original boundscheck values step ++
        (blockEvents core bindings original boundscheck values step).take (offset + 1) := by
  have within : 2 * step + offset + 1 ≤ 2 * (step + 1) := by omega
  have firstBlocks := descentEvents_take_with_tail core bindings original boundscheck
    values depth (step + 1) tail (by omega)
  have firstPart := congrArg (fun events : List (ContextEvent L) =>
    events.take (2 * step + offset + 1)) firstBlocks
  simp only [List.take_take, Nat.min_eq_left within, Nat.min_eq_right within] at firstPart
  rw [firstPart, descentEvents_succ, List.take_append, descentEvents_length]
  have allPrevious :
      (descentEvents (core boundscheck) bindings original boundscheck values step).take
        (2 * step + offset + 1) =
      descentEvents (core boundscheck) bindings original boundscheck values step :=
    take_full _ _ (by rw [descentEvents_length]; omega)
  have remaining : 2 * step + offset + 1 - 2 * step = offset + 1 := by omega
  rw [allPrevious, remaining]


theorem run_empty {W L : Type} (core : Bool → CoreOps (World W L) L)
    (select : Value L → Value L → W → ElementMethod L) (bindings : Bindings L)
    (typeValue bc index : Value L) (boundscheck : Bool) (initial : W)
    (history : List (ContextEvent L)) :
    secondType (observingSecond core select) bindings typeValue bc index boundscheck
      ⟨initial, [], history⟩ = none := by
  rw [secondType.eq_def]
  simp only [observingSecond, observeContexts, bind_apply, observe]

theorem run_descent_throw {W L : Type} (core : Bool → CoreOps (World W L) L)
    (select : Value L → Value L → W → ElementMethod L) (bindings : Bindings L)
    (originalType original index : Value L) (boundscheck : Bool)
    (values : Nat → Value L) (worlds : Nat → W) (initial : W)
    (history : List (ContextEvent L)) (suffix : List (Reply W L))
    (frames position : Nat) (tail : List (ContextEvent L))
    (error : Value L) (failureWorld : W)
    (nonterminal : ∀ step, step + 1 < frames →
      isOther (select (values (2 * step + 1)) index (worlds (2 * step + 1))) = false)
    (bound : position < 2 * frames) :
    secondType (observingSecond core select) bindings originalType original index boundscheck
      ⟨initial, successes position values worlds ++ (.thrown error failureWorld :: suffix), history⟩ = some (.error (error, ⟨failureWorld, suffix,
        history ++ (descentEvents (core boundscheck) bindings original boundscheck values frames ++ tail).take
          (position + 1)⟩)) := by
  let completed := position / 2
  let offset := position % 2
  have offsetBound : offset < 2 := by dsimp [offset]; omega
  have completedBound : completed < frames := by dsimp [completed]; omega
  have positionEq : position = 2 * completed + offset := by
    dsimp [completed, offset]
    omega
  rw [positionEq, successes_add]
  simp only [List.append_assoc]
  rw [run_descent_prefix core select bindings originalType original index boundscheck
    values worlds initial history
    (successes offset (fun i => values (2 * completed + i))
      (fun i => worlds (2 * completed + i)) ++ (.thrown error failureWorld :: suffix))
    completed (fun step earlier => nonterminal step (by omega))]
  rw [descentEvents_take_inside core bindings original boundscheck values
    frames completed offset tail completedBound offsetBound]
  apply stack_error
  have offsetCases : offset = 0 ∨ offset = 1 := by omega
  rcases offsetCases with h | h <;> rw [h] <;> rw [secondType.eq_def] <;>
    simp only [observingSecond, observeContexts, bind_apply, observe, successes,
      List.range_succ, List.range_zero, List.map_cons, List.map_nil,
      List.map_append, List.nil_append, List.cons_append, blockEvents,
      List.take_succ_cons, List.take_zero, List.take_nil, JuliaLean.base.boot.intV,
      List.append_nil, Nat.add_zero, call, List.append_assoc]

theorem run_descent_diverge {W L : Type} (core : Bool → CoreOps (World W L) L)
    (select : Value L → Value L → W → ElementMethod L) (bindings : Bindings L)
    (originalType original index : Value L) (boundscheck : Bool)
    (values : Nat → Value L) (worlds : Nat → W) (initial : W)
    (history : List (ContextEvent L)) (suffix : List (Reply W L))
    (frames position : Nat)
    (nonterminal : ∀ step, step + 1 < frames →
      isOther (select (values (2 * step + 1)) index (worlds (2 * step + 1))) = false)
    (bound : position < 2 * frames) :
    secondType (observingSecond core select) bindings originalType original index boundscheck
      ⟨initial, successes position values worlds ++ (.diverged :: suffix), history⟩ = none := by
  let completed := position / 2
  let offset := position % 2
  have offsetBound : offset < 2 := by dsimp [offset]; omega
  have completedBound : completed < frames := by dsimp [completed]; omega
  have positionEq : position = 2 * completed + offset := by
    dsimp [completed, offset]
    omega
  rw [positionEq, successes_add]
  simp only [List.append_assoc]
  rw [run_descent_prefix core select bindings originalType original index boundscheck
    values worlds initial history
    (successes offset (fun i => values (2 * completed + i))
      (fun i => worlds (2 * completed + i)) ++ (.diverged :: suffix))
    completed (fun step earlier => nonterminal step (by omega))]
  apply stack_none
  have offsetCases : offset = 0 ∨ offset = 1 := by omega
  rcases offsetCases with h | h <;> rw [h] <;> rw [secondType.eq_def] <;>
    simp only [observingSecond, observeContexts, bind_apply, observe, successes,
      List.range_succ, List.range_zero, List.map_cons, List.map_nil,
      List.map_append, List.nil_append, List.cons_append, blockEvents,
      List.take_succ_cons, List.take_zero, List.take_nil, JuliaLean.base.boot.intV,
      List.append_nil, Nat.add_zero, call, List.append_assoc]

theorem nonterminal_window {W L : Type} (core : Bool → CoreOps (World W L) L)
    (select : Value L → Value L → W → ElementMethod L) (bindings : Bindings L)
    (originalType original index : Value L) (boundscheck : Bool)
    (values : Nat → Value L) (worlds : Nat → W) (initial : W)
    (history : List (ContextEvent L)) (suffix : List (Reply W L))
    (frames : Nat) (positive : 0 < frames)
    (nonterminal : ∀ step, step < frames →
      isOther (select (values (2 * step + 1)) index (worlds (2 * step + 1))) = false) :
    ContinuesAfter
      (secondType (observingSecond core select) bindings originalType original index boundscheck)
      (2 * frames) values worlds
      (descentEvents (core boundscheck) bindings original boundscheck values frames)
      initial history suffix := by
  unfold ContinuesAfter FailurePrefixes
  refine ⟨by omega, descentEvents_length _ _ _ _ _ _, ?_, ?_, ?_⟩
  · have stepped := run_descent_prefix core select bindings originalType original index boundscheck
      values worlds initial history [] frames nonterminal
    have stopped := run_empty core select bindings
      (typeAt select originalType index values worlds frames) (inputAt original values frames)
      index boundscheck (payloadAt initial worlds frames)
      (history ++ descentEvents (core boundscheck) bindings original boundscheck values frames)
    have allStopped := stack_none
      (frameAt core select bindings originalType original index boundscheck values worlds)
      frames _ _ stopped
    simpa only [List.append_nil] using stepped.trans allStopped
  · intro position error failureWorld
    have bound : position.val < 2 * frames := by
      simpa only [successes, List.length_map, List.length_range] using position.isLt
    rw [successes_take (2 * frames) position.val values worlds (Nat.le_of_lt bound)]
    simpa only [List.append_nil, List.cons_append, List.nil_append, List.append_assoc] using
      run_descent_throw core select bindings originalType original index boundscheck values worlds
        initial history
        ((successes (2 * frames) values worlds).drop (position.val + 1) ++ suffix)
        frames position.val [] error failureWorld
        (fun step earlier => nonterminal step (by omega)) bound
  · intro position
    have bound : position.val < 2 * frames := by
      simpa only [successes, List.length_map, List.length_range] using position.isLt
    rw [successes_take (2 * frames) position.val values worlds (Nat.le_of_lt bound)]
    simpa only [List.cons_append, List.nil_append, List.append_assoc] using
      run_descent_diverge core select bindings originalType original index boundscheck values worlds
        initial history
        ((successes (2 * frames) values worlds).drop (position.val + 1) ++ suffix)
        frames position.val (fun step earlier => nonterminal step (by omega)) bound


theorem run_terminal_descent {W L : Type} (core : Bool → CoreOps (World W L) L)
    (select : Value L → Value L → W → ElementMethod L) (bindings : Bindings L)
    (originalType original index : Value L) (boundscheck : Bool)
    (values : Nat → Value L) (worlds : Nat → W) (initial : W)
    (history : List (ContextEvent L)) (suffix : List (Reply W L)) (depth : Nat)
    (nonterminal : ∀ step, step < depth →
      isOther (select (values (2 * step + 1)) index (worlds (2 * step + 1))) = false)
    (terminal : isOther (select (values (2 * depth + 1)) index (worlds (2 * depth + 1))) = true) :
    secondType (observingSecond core select) bindings originalType original index boundscheck
      ⟨initial, successes (2 * (depth + 1)) values worlds ++ suffix, history⟩ =
    stack (frameAt core select bindings originalType original index boundscheck values worlds) (depth + 1)
      (observe boundscheck (.call bindings.broadcastGetindex
        [values (2 * (depth + 1) - 1), index]))
      ⟨payloadAt initial worlds (depth + 1), suffix,
        history ++ descentEvents (core boundscheck) bindings original boundscheck values (depth + 1)⟩ := by
  have countEq : 2 * (depth + 1) = 2 * depth + 2 := by omega
  have lastEq : 2 * (depth + 1) - 1 = 2 * depth + 1 := by omega
  have expandedLast : 2 * depth + 2 - 1 = 2 * depth + 1 := by omega
  rw [countEq, successes_add, List.append_assoc]
  rw [run_descent_prefix core select bindings originalType original index boundscheck
    values worlds initial history
    (successes 2 (fun i => values (2 * depth + i))
      (fun i => worlds (2 * depth + i)) ++ suffix) depth nonterminal]
  rw [stack]
  apply stack_transfer
  cases selected : select (values (2 * depth + 1)) index (worlds (2 * depth + 1)) with
  | same nextType => simp only [selected, isOther, Bool.false_eq_true] at terminal
  | other =>
    rw [secondType.eq_def]
    simp only [observingSecond, observeContexts, successes_two,
      List.cons_append, List.nil_append, bind_apply, observe, selected,
      frameAt, finishFrame, descentEvents_succ, blockEvents, inputAt, typeAt,
      payloadAt, lastEq, expandedLast, Nat.add_zero, call, JuliaLean.base.boot.intV, List.append_assoc]


end SecondDescentProofs
