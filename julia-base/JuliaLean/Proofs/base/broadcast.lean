def restartFrameBlock {W L : Type} (core : Bool → CoreOps (World W L) L)
    (bindings : Bindings L) (newdest dest taken : Value L)
    (values : Nat → Value L) (worlds : Nat → W) (frame : Nat) : List (Frame W L) :=
  let base := 2 + 5 * frame
  let one := JuliaLean.base.boot.intV (core true) (JInt.lit .i64 1)
  let two := JuliaLean.base.boot.intV (core true) (JInt.lit .i64 2)
  [⟨⟨true, .getfield (values (base - 1)) one⟩, values base, worlds base⟩,
   ⟨⟨true, .getfield (values (base - 1)) two⟩, values (base + 1), worlds (base + 1)⟩,
   ⟨call true bindings.getindex [dest, values base], values (base + 2), worlds (base + 2)⟩,
   ⟨call true bindings.setindexBang [newdest, values (base + 2), values base],
      values (base + 3), worlds (base + 3)⟩,
   ⟨call true bindings.iterate [taken, values (base + 1)], values (base + 4), worlds (base + 4)⟩]

def restartLoopFrames {W L : Type} (core : Bool → CoreOps (World W L) L)
    (bindings : Bindings L) (newdest dest taken : Value L)
    (values : Nat → Value L) (worlds : Nat → W) (start count : Nat) : List (Frame W L) :=
  (List.range' start count).flatMap (restartFrameBlock core bindings newdest dest taken values worlds)

theorem restart_loop_steps {W L : Type}
    (core : Bool → CoreOps (World W L) L)
    (copySelect : CopyInputs L → W → Selection)
    (restartSelect : RestartInputs L → W → Selection)
    (bindings : Bindings L) (inputs : RestartInputs L) (taken : Value L)
    (values : Nat → Value L) (worlds : Nat → W) (count : Nat) :
    ∀ start,
      (∀ frame, frame ∈ List.range' start count →
        (core true).same (values (1 + 5 * frame)) (JuliaLean.base.boot.nothingV (core true)) = false) →
      Steps (run (instrument core copySelect restartSelect) bindings
        (.priorReplies inputs taken (values (1 + 5 * start))))
        (restartLoopFrames core bindings inputs.newdest inputs.dest taken values worlds start count)
        (run (instrument core copySelect restartSelect) bindings
          (.priorReplies inputs taken (values (1 + 5 * (start + count))))) := by
  induction count with
  | zero =>
      intro start guards
      change Steps _ [] _
      exact Steps.nil _
  | succ count ih =>
      intro start guards
      have current : (core true).same (values (1 + 5 * start))
          (JuliaLean.base.boot.nothingV (core true)) = false := by
        apply guards start
        rw [List.range'_succ]
        exact List.mem_cons_self
      have later : ∀ frame, frame ∈ List.range' (start + 1) count →
          (core true).same (values (1 + 5 * frame))
            (JuliaLean.base.boot.nothingV (core true)) = false := by
        intro frame member
        apply guards frame
        rw [List.range'_succ]
        exact List.mem_cons_of_mem start member
      simp only [restartLoopFrames, List.range'_succ, List.flatMap_cons]
      change Steps _
        (restartFrameBlock core bindings inputs.newdest inputs.dest taken values worlds start ++
         restartLoopFrames core bindings inputs.newdest inputs.dest taken values worlds (start + 1) count) _
      rw [run.eq_def]
      change Steps (if (core true).same (values (1 + 5 * start))
        (JuliaLean.base.boot.nothingV (core true)) then _ else _) _ _
      simp only [current, Bool.false_eq_true, ↓reduceIte]
      unfold restartFrameBlock
      have previous : 2 + 5 * start - 1 = 1 + 5 * start := by omega
      simp only [previous]
      change Steps (step ⟨true, .getfield (values (1 + 5 * start))
        (JuliaLean.base.boot.intV (core true) (JInt.lit .i64 1))⟩ _) _ _
      apply steps_cons
      change Steps (step ⟨true, .getfield (values (1 + 5 * start))
        (JuliaLean.base.boot.intV (core true) (JInt.lit .i64 2))⟩ _) _ _
      apply steps_cons
      change Steps (step (call true bindings.getindex [inputs.dest, values (2 + 5 * start)]) _) _ _
      apply steps_cons
      change Steps (step (call true bindings.setindexBang
        [inputs.newdest, values (2 + 5 * start + 2), values (2 + 5 * start)]) _) _ _
      apply steps_cons
      change Steps (step (call true bindings.iterate [taken, values (2 + 5 * start + 1)]) _) _ _
      apply steps_cons
      dsimp only [List.append]
      have following : 2 + 5 * start + 4 = 1 + 5 * (start + 1) := by omega
      have ending : 1 + 5 * (start + 1 + count) = 1 + 5 * (start + (count + 1)) := by omega
      simpa only [following, ending, List.nil_append] using ih (start + 1) later

def restartStartFrames {W L : Type} (bindings : Bindings L) (iterator count : Value L)
    (values : Nat → Value L) (worlds : Nat → W) : List (Frame W L) :=
  [⟨call true bindings.take [iterator, count], values 0, worlds 0⟩,
   ⟨call true bindings.iterate [values 0], values 1, worlds 1⟩]

theorem restart_start_steps {W L : Type}
    (core : Bool → CoreOps (World W L) L)
    (copySelect : CopyInputs L → W → Selection)
    (restartSelect : RestartInputs L → W → Selection)
    (bindings : Bindings L) (inputs : RestartInputs L)
    (values : Nat → Value L) (worlds : Nat → W) :
    Steps (restart (instrument core copySelect restartSelect) bindings inputs.newdest inputs.dest
      inputs.bc inputs.value inputs.index inputs.iterator inputs.state inputs.count)
      (restartStartFrames bindings inputs.iterator inputs.count values worlds)
      (run (instrument core copySelect restartSelect) bindings
        (.priorReplies inputs (values 0) (values 1))) := by
  unfold restart restartStartFrames
  rw [run.eq_def]
  change Steps (step (call true bindings.take [inputs.iterator, inputs.count]) _) _ _
  apply steps_cons
  change Steps (step (call true bindings.iterate [values 0]) _) _ _
  apply steps_cons
  exact Steps.nil _


def replyRange {W L : Type} (values : Nat → Value L) (worlds : Nat → W)
    (start count : Nat) : List (Reply W L) :=
  (List.range' start count).map (fun index => .returned (values index) (worlds index))

theorem replyRange_append {W L : Type} (values : Nat → Value L) (worlds : Nat → W)
    (start first second : Nat) :
    replyRange values worlds start first ++ replyRange values worlds (start + first) second =
      replyRange values worlds start (first + second) := by
  unfold replyRange
  rw [← List.map_append, List.range'_append_1]

theorem replies_restart_block {W L : Type} (core : Bool → CoreOps (World W L) L)
    (bindings : Bindings L) (newdest dest taken : Value L)
    (values : Nat → Value L) (worlds : Nat → W) (frame : Nat) :
    replies (restartFrameBlock core bindings newdest dest taken values worlds frame) =
      replyRange values worlds (2 + 5 * frame) 5 := by
  simp only [replies, restartFrameBlock, replyRange, List.range'_succ, List.range'_zero,
    List.map_cons, List.map_nil]

theorem replies_restart_loop {W L : Type} (core : Bool → CoreOps (World W L) L)
    (bindings : Bindings L) (newdest dest taken : Value L)
    (values : Nat → Value L) (worlds : Nat → W) (count : Nat) :
    ∀ start, replies (restartLoopFrames core bindings newdest dest taken values worlds start count) =
      replyRange values worlds (2 + 5 * start) (5 * count) := by
  induction count with
  | zero =>
      intro start
      rfl
  | succ count ih =>
      intro start
      simp only [restartLoopFrames, List.range'_succ, List.flatMap_cons, replies, List.map_append]
      change replies (restartFrameBlock core bindings newdest dest taken values worlds start) ++
        replies (restartLoopFrames core bindings newdest dest taken values worlds (start + 1) count) = _
      rw [replies_restart_block, ih]
      have next : 2 + 5 * (start + 1) = (2 + 5 * start) + 5 := by omega
      have length : 5 * (count + 1) = 5 + 5 * count := by omega
      rw [next, length, replyRange_append]

def restartLoopEvents {W L : Type} (core : Bool → CoreOps (World W L) L)
    (bindings : Bindings L) (newdest dest taken : Value L)
    (values : Nat → Value L) (start count : Nat) : List (ContextEvent L) :=
  (List.range' start count).flatMap (fun frame =>
    let base := 2 + 5 * frame
    let one := JuliaLean.base.boot.intV (core true) (JInt.lit .i64 1)
    let two := JuliaLean.base.boot.intV (core true) (JInt.lit .i64 2)
    [⟨true, .getfield (values (base - 1)) one⟩,
     ⟨true, .getfield (values (base - 1)) two⟩,
     call true bindings.getindex [dest, values base],
     call true bindings.setindexBang [newdest, values (base + 2), values base],
     call true bindings.iterate [taken, values (base + 1)]])

theorem events_restart_loop {W L : Type} (core : Bool → CoreOps (World W L) L)
    (bindings : Bindings L) (newdest dest taken : Value L)
    (values : Nat → Value L) (worlds : Nat → W) (start count : Nat) :
    events (restartLoopFrames core bindings newdest dest taken values worlds start count) =
      restartLoopEvents core bindings newdest dest taken values start count := by
  simp only [events, restartLoopFrames, restartLoopEvents, List.map_flatMap,
    restartFrameBlock, List.map_cons, List.map_nil]

theorem chosenCopy_builtin {W L : Type}
    (core : Bool → CoreOps (World W L) L)
    (restartSelect : RestartInputs L → W → Selection)
    (bindings : Bindings L) (inputs : CopyInputs L) :
    chosenCopy (instrument core (fun _ _ => .builtin) restartSelect) bindings inputs =
      run (instrument core (fun _ _ => .builtin) restartSelect) bindings (.copy inputs) := by
  unfold chosenCopy
  simp only [bind_pure_right] <;> rfl

def restartCustomFinishFrames {W L : Type} (core : Bool → CoreOps (World W L) L)
    (bindings : Bindings L) (inputs : RestartInputs L)
    (values : Nat → Value L) (worlds : Nat → W) (iterations : Nat) : List (Frame W L) :=
  let base := 2 + 5 * iterations
  [⟨call true bindings.setindexBang [inputs.newdest, inputs.value, inputs.index], values base, worlds base⟩,
   ⟨call true bindings.add
      [inputs.count, JuliaLean.base.boot.intV (core true) (JInt.lit .i64 1)],
      values (base + 1), worlds (base + 1)⟩,
   ⟨call true bindings.copy [inputs.newdest, inputs.bc, inputs.iterator, inputs.state, values (base + 1)],
      values (base + 2), worlds (base + 2)⟩]

def restartBuiltinFinishFrames {W L : Type} (core : Bool → CoreOps (World W L) L)
    (bindings : Bindings L) (inputs : RestartInputs L)
    (values : Nat → Value L) (worlds : Nat → W) (iterations : Nat) : List (Frame W L) :=
  let base := 2 + 5 * iterations
  [⟨call true bindings.setindexBang [inputs.newdest, inputs.value, inputs.index], values base, worlds base⟩,
   ⟨call true bindings.add
      [inputs.count, JuliaLean.base.boot.intV (core true) (JInt.lit .i64 1)],
      values (base + 1), worlds (base + 1)⟩,
   ⟨call true bindings.eltype [inputs.newdest], values (base + 2), worlds (base + 2)⟩,
   ⟨call true bindings.iterate [inputs.iterator, inputs.state], values (base + 3), worlds (base + 3)⟩]

theorem restart_custom_finish {W L : Type}
    (core : Bool → CoreOps (World W L) L)
    (restartSelect : RestartInputs L → W → Selection)
    (bindings : Bindings L) (inputs : RestartInputs L) (taken : Value L)
    (values : Nat → Value L) (worlds : Nat → W) (iterations : Nat)
    (finished : (core true).same (values (1 + 5 * iterations))
      (JuliaLean.base.boot.nothingV (core true)) = true) :
    Steps (run (instrument core (fun _ _ => .custom) restartSelect) bindings
      (.priorReplies inputs taken (values (1 + 5 * iterations))))
      (restartCustomFinishFrames core bindings inputs values worlds iterations)
      (stop (.ok (values (2 + 5 * iterations + 2)))) := by
  unfold restartCustomFinishFrames
  rw [run.eq_def]
  change Steps (if (core true).same (values (1 + 5 * iterations))
    (JuliaLean.base.boot.nothingV (core true)) then _ else _) _ _
  simp only [finished, ↓reduceIte]
  change Steps (step (call true bindings.setindexBang [inputs.newdest, inputs.value, inputs.index]) _) _ _
  apply steps_cons
  change Steps (step (call true bindings.add
    [inputs.count, JuliaLean.base.boot.intV (core true) (JInt.lit .i64 1)]) _) _ _
  apply steps_cons
  change Steps (chosenCopy (instrument core (fun _ _ => .custom) restartSelect) bindings
    ⟨inputs.newdest, inputs.bc, inputs.iterator, inputs.state, values (2 + 5 * iterations + 1)⟩) _ _
  rw [chosenCopy_custom]
  exact observe_steps
    ⟨call true bindings.copy
      [inputs.newdest, inputs.bc, inputs.iterator, inputs.state, values (2 + 5 * iterations + 1)],
      values (2 + 5 * iterations + 2), worlds (2 + 5 * iterations + 2)⟩

theorem restart_builtin_prefix {W L : Type}
    (core : Bool → CoreOps (World W L) L)
    (restartSelect : RestartInputs L → W → Selection)
    (bindings : Bindings L) (inputs : RestartInputs L) (taken : Value L)
    (values : Nat → Value L) (worlds : Nat → W) (iterations : Nat)
    (finished : (core true).same (values (1 + 5 * iterations))
      (JuliaLean.base.boot.nothingV (core true)) = true) :
    Prefix (run (instrument core (fun _ _ => .builtin) restartSelect) bindings
      (.priorReplies inputs taken (values (1 + 5 * iterations))))
      (restartBuiltinFinishFrames core bindings inputs values worlds iterations) := by
  unfold restartBuiltinFinishFrames
  rw [run.eq_def]
  change Prefix (if (core true).same (values (1 + 5 * iterations))
    (JuliaLean.base.boot.nothingV (core true)) then _ else _) _
  simp only [finished, ↓reduceIte]
  change Prefix (step (call true bindings.setindexBang [inputs.newdest, inputs.value, inputs.index]) _) _
  apply prefix_step
  change Prefix (step (call true bindings.add
    [inputs.count, JuliaLean.base.boot.intV (core true) (JInt.lit .i64 1)]) _) _
  apply prefix_step
  change Prefix (chosenCopy (instrument core (fun _ _ => .builtin) restartSelect) bindings
    ⟨inputs.newdest, inputs.bc, inputs.iterator, inputs.state, values (2 + 5 * iterations + 1)⟩) _
  rw [chosenCopy_builtin, run.eq_def]
  change Prefix (step (call true bindings.eltype [inputs.newdest]) _) _
  apply prefix_step
  rw [run.eq_def]
  change Prefix (step (call true bindings.iterate [inputs.iterator, inputs.state]) _) _
  apply prefix_step
  exact prefix_nil _

theorem restart_builtin_finish {W L : Type}
    (core : Bool → CoreOps (World W L) L)
    (restartSelect : RestartInputs L → W → Selection)
    (bindings : Bindings L) (inputs : RestartInputs L) (taken : Value L)
    (values : Nat → Value L) (worlds : Nat → W) (iterations : Nat)
    (finished : (core true).same (values (1 + 5 * iterations))
      (JuliaLean.base.boot.nothingV (core true)) = true)
    (copied : (core true).same (values (2 + 5 * iterations + 3))
      (JuliaLean.base.boot.nothingV (core true)) = true) :
    Steps (run (instrument core (fun _ _ => .builtin) restartSelect) bindings
      (.priorReplies inputs taken (values (1 + 5 * iterations))))
      (restartBuiltinFinishFrames core bindings inputs values worlds iterations)
      (stop (.ok inputs.newdest)) := by
  unfold restartBuiltinFinishFrames
  rw [run.eq_def]
  change Steps (if (core true).same (values (1 + 5 * iterations))
    (JuliaLean.base.boot.nothingV (core true)) then _ else _) _ _
  simp only [finished, ↓reduceIte]
  change Steps (step (call true bindings.setindexBang [inputs.newdest, inputs.value, inputs.index]) _) _ _
  apply steps_cons
  change Steps (step (call true bindings.add
    [inputs.count, JuliaLean.base.boot.intV (core true) (JInt.lit .i64 1)]) _) _ _
  apply steps_cons
  change Steps (chosenCopy (instrument core (fun _ _ => .builtin) restartSelect) bindings
    ⟨inputs.newdest, inputs.bc, inputs.iterator, inputs.state, values (2 + 5 * iterations + 1)⟩) _ _
  rw [chosenCopy_builtin, run.eq_def]
  change Steps (step (call true bindings.eltype [inputs.newdest]) _) _ _
  apply steps_cons
  rw [run.eq_def]
  change Steps (step (call true bindings.iterate [inputs.iterator, inputs.state]) _) _ _
  apply steps_cons
  change Steps (if (core true).same (values (2 + 5 * iterations + 3))
    (JuliaLean.base.boot.nothingV (core true)) then _ else _) [] (stop (.ok inputs.newdest))
  simp only [copied, ↓reduceIte]
  exact Steps.nil _


theorem replies_append {W L : Type} (first second : List (Frame W L)) :
    replies (first ++ second) = replies first ++ replies second := List.map_append

theorem events_append {W L : Type} (first second : List (Frame W L)) :
    events (first ++ second) = events first ++ events second := List.map_append

theorem replyRange_zero_append {W L : Type} (values : Nat → Value L) (worlds : Nat → W)
    (first second : Nat) :
    replyRange values worlds 0 first ++ replyRange values worlds first second =
      replyRange values worlds 0 (first + second) := by
  simpa only [Nat.zero_add] using replyRange_append values worlds 0 first second

theorem replies_restart_start {W L : Type} (bindings : Bindings L) (iterator count : Value L)
    (values : Nat → Value L) (worlds : Nat → W) :
    replies (restartStartFrames bindings iterator count values worlds) = replyRange values worlds 0 2 := rfl

theorem replies_restart_custom_finish {W L : Type} (core : Bool → CoreOps (World W L) L)
    (bindings : Bindings L) (inputs : RestartInputs L)
    (values : Nat → Value L) (worlds : Nat → W) (iterations : Nat) :
    replies (restartCustomFinishFrames core bindings inputs values worlds iterations) =
      replyRange values worlds (2 + 5 * iterations) 3 := by
  simp only [replies, restartCustomFinishFrames, replyRange, List.range'_succ, List.range'_zero,
    List.map_cons, List.map_nil]

theorem replies_restart_builtin_finish {W L : Type} (core : Bool → CoreOps (World W L) L)
    (bindings : Bindings L) (inputs : RestartInputs L)
    (values : Nat → Value L) (worlds : Nat → W) (iterations : Nat) :
    replies (restartBuiltinFinishFrames core bindings inputs values worlds iterations) =
      replyRange values worlds (2 + 5 * iterations) 4 := by
  simp only [replies, restartBuiltinFinishFrames, replyRange, List.range'_succ, List.range'_zero,
    List.map_cons, List.map_nil]

def restartAllCustomFrames {W L : Type} (core : Bool → CoreOps (World W L) L)
    (bindings : Bindings L) (inputs : RestartInputs L)
    (values : Nat → Value L) (worlds : Nat → W) (iterations : Nat) : List (Frame W L) :=
  (restartStartFrames bindings inputs.iterator inputs.count values worlds ++
   restartLoopFrames core bindings inputs.newdest inputs.dest (values 0) values worlds 0 iterations) ++
   restartCustomFinishFrames core bindings inputs values worlds iterations

def restartAllBuiltinFrames {W L : Type} (core : Bool → CoreOps (World W L) L)
    (bindings : Bindings L) (inputs : RestartInputs L)
    (values : Nat → Value L) (worlds : Nat → W) (iterations : Nat) : List (Frame W L) :=
  (restartStartFrames bindings inputs.iterator inputs.count values worlds ++
   restartLoopFrames core bindings inputs.newdest inputs.dest (values 0) values worlds 0 iterations) ++
   restartBuiltinFinishFrames core bindings inputs values worlds iterations

theorem replies_restart_all_custom {W L : Type} (core : Bool → CoreOps (World W L) L)
    (bindings : Bindings L) (inputs : RestartInputs L)
    (values : Nat → Value L) (worlds : Nat → W) (iterations : Nat) :
    replies (restartAllCustomFrames core bindings inputs values worlds iterations) =
      replyRange values worlds 0 (2 + 5 * iterations + 3) := by
  simp only [restartAllCustomFrames, replies_append, replies_restart_start,
    replies_restart_loop, replies_restart_custom_finish, Nat.mul_zero, Nat.add_zero]
  rw [replyRange_zero_append, replyRange_zero_append]

theorem replies_restart_all_builtin {W L : Type} (core : Bool → CoreOps (World W L) L)
    (bindings : Bindings L) (inputs : RestartInputs L)
    (values : Nat → Value L) (worlds : Nat → W) (iterations : Nat) :
    replies (restartAllBuiltinFrames core bindings inputs values worlds iterations) =
      replyRange values worlds 0 (2 + 5 * iterations + 4) := by
  simp only [restartAllBuiltinFrames, replies_append, replies_restart_start,
    replies_restart_loop, replies_restart_builtin_finish, Nat.mul_zero, Nat.add_zero]
  rw [replyRange_zero_append, replyRange_zero_append]

def restartHeadPlan {W L : Type} (core : Bool → CoreOps (World W L) L)
    (bindings : Bindings L) (inputs : RestartInputs L)
    (values : Nat → Value L) (iterations : Nat) : List (ContextEvent L) :=
  let one := JuliaLean.base.boot.intV (core true) (JInt.lit .i64 1)
  let two := JuliaLean.base.boot.intV (core true) (JInt.lit .i64 2)
  [call true bindings.take [inputs.iterator, inputs.count], call true bindings.iterate [values 0]] ++
    (List.range iterations).flatMap (fun frame =>
      let base := 2 + 5 * frame
      [⟨true, Event.getfield (values (base - 1)) one⟩,
       ⟨true, Event.getfield (values (base - 1)) two⟩,
       call true bindings.getindex [inputs.dest, values base],
       call true bindings.setindexBang [inputs.newdest, values (base + 2), values base],
       call true bindings.iterate [values 0, values (base + 1)]]) ++
    [call true bindings.setindexBang [inputs.newdest, inputs.value, inputs.index],
     call true bindings.add [inputs.count, one]]

def restartCustomPlan {W L : Type} (core : Bool → CoreOps (World W L) L)
    (bindings : Bindings L) (inputs : RestartInputs L)
    (values : Nat → Value L) (iterations : Nat) : List (ContextEvent L) :=
  restartHeadPlan core bindings inputs values iterations ++
    [call true bindings.copy
      [inputs.newdest, inputs.bc, inputs.iterator, inputs.state, values ((4 + 5 * iterations) - 1)]]

def restartBuiltinPlan {W L : Type} (core : Bool → CoreOps (World W L) L)
    (bindings : Bindings L) (inputs : RestartInputs L)
    (values : Nat → Value L) (iterations : Nat) : List (ContextEvent L) :=
  restartHeadPlan core bindings inputs values iterations ++
    [call true bindings.eltype [inputs.newdest], call true bindings.iterate [inputs.iterator, inputs.state]]

theorem events_restart_all_custom {W L : Type} (core : Bool → CoreOps (World W L) L)
    (bindings : Bindings L) (inputs : RestartInputs L)
    (values : Nat → Value L) (worlds : Nat → W) (iterations : Nat) :
    events (restartAllCustomFrames core bindings inputs values worlds iterations) =
      restartCustomPlan core bindings inputs values iterations := by
  have countIndex : 2 + 5 * iterations + 1 = (4 + 5 * iterations) - 1 := by omega
  unfold restartAllCustomFrames
  rw [events_append, events_append, events_restart_loop]
  simp only [events, restartStartFrames, restartCustomFinishFrames, restartCustomPlan, restartHeadPlan,
    restartLoopEvents, List.range_eq_range', List.map_cons, List.map_nil,
    List.append_assoc, List.cons_append, List.nil_append, countIndex]

theorem events_restart_all_builtin {W L : Type} (core : Bool → CoreOps (World W L) L)
    (bindings : Bindings L) (inputs : RestartInputs L)
    (values : Nat → Value L) (worlds : Nat → W) (iterations : Nat) :
    events (restartAllBuiltinFrames core bindings inputs values worlds iterations) =
      restartBuiltinPlan core bindings inputs values iterations := by
  unfold restartAllBuiltinFrames
  rw [events_append, events_append, events_restart_loop]
  simp only [events, restartStartFrames, restartBuiltinFinishFrames, restartBuiltinPlan, restartHeadPlan,
    restartLoopEvents, List.range_eq_range', List.map_cons, List.map_nil,
    List.append_assoc, List.cons_append, List.nil_append]

theorem length_from_replies {W L : Type} {frames : List (Frame W L)}
    (values : Nat → Value L) (worlds : Nat → W) (count : Nat)
    (scheduled : replies frames = replyRange values worlds 0 count) :
    (events frames).length = count := by
  have lengths := congrArg List.length scheduled
