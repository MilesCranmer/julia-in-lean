/-- Every input's original type is the sole argument of BroadcastStyle; the
exact reply reaches unary result_style. Both arbitrary callee outcomes retain
their values, errors, worlds and divergence at the original call site, without
additional type assertions. Source: base/broadcast.jl:432. -/
def UnaryObservations : Prop :=
  ∀ {W L : Type} (bindings : Bindings L) (value : Value L),
    ReturnsLastAfter (W := W) (L := L) 1
      (fun ops => combineOne ops bindings value)
      (fun ops values _ _ =>
        [.call bindings.broadcastStyle [.leaf (ops.typeOf value)],
         .call bindings.resultStyle [values 0]])

/-- The unary method depends on the input's type, not its payload or stored
array/axis values. This compares complete executions for two same-type
observations and imposes no result, success or purity law on dispatched code.
Source: base/broadcast.jl:432; style trait documentation at lines20-32,416-420. -/
def UnaryDependsOnlyOnType : Prop :=
  ∀ {W L : Type} (ops : CoreOps W L) (bindings : Bindings L)
      (first second : Value L) (world : W),
    ops.typeOf first = ops.typeOf second →
      combineOne ops bindings first world = combineOne ops bindings second world

def UnaryContract : Prop := UnaryObservations ∧ UnaryDependsOnlyOnType

/-- The binary body observes left and right exactly once in that order,
combines the actual replies in the same order, and returns the result unchanged.
Every call can fail or diverge; those outcomes stop the remaining source calls.
No commutativity, associativity or other custom-style law is assumed.
Source: base/broadcast.jl:437. -/
def BinaryObservations : Prop :=
  ∀ {W L : Type} (bindings : Bindings L) (left right : Value L),
    ReturnsLastAfter (W := W) (L := L) 2
      (fun ops => combineTwo ops bindings left right)
      (fun _ values _ _ =>
        [.call bindings.combineStyles [left],
         .call bindings.combineStyles [right],
         .call bindings.resultStyle [values 0, values 1]])

/-- Proof-only scan locating the terminal suffix call. Before that point,
canonical recursion peels one original input at a time. A selected custom
method consumes the remaining suffix in one open call; a singleton also ends
the descent. `processed` counts earlier singleton observations, so its preceding
world is the arbitrary world returned by observation processed-1. This scan
prescribes only the trace's cut point, not callee values or a model result. -/
def cutPoint {W L : Type}
    (select : Value L → Value L → List (Value L) → W → Method)
    (worlds : Nat → W) (processed : Nat) (first : Value L)
    (rest : List (Value L)) : Nat :=
  match rest with
  | [] => processed
  | second :: tail =>
      match select first second tail (worlds (processed - 1)) with
      | .custom => processed
      | .builtin => cutPoint select worlds (processed + 1) second tail
termination_by rest.length

/-- Independent closed-form observation grammar for a right-associated
combination: singleton calls in original order, one terminal suffix call, then
joins in reverse prefix order. Each join's right token is the preceding deeper
result, while its left token is the corresponding singleton observation. This
uses take/drop and index arithmetic on proof records, not a second evaluator of
combine_styles. The expected result is not computed here. -/
def variadicEvents {L : Type} (bindings : Bindings L) (inputs : List (Value L))
    (cut : Nat) (values : Nat → Value L) : List (Event L) :=
  (inputs.take cut).map (fun value => .call bindings.combineStyles [value]) ++
  [.call bindings.combineStyles (inputs.drop cut)] ++
  (List.range cut).map (fun index =>
    .call bindings.resultStyle [values (cut - 1 - index), values (cut + index)])

/-- Full-domain recursion/dispatch invariant. The observed calls have exactly
the original prefix/remaining-suffix/reverse-join form, preserving every input
reference and the actual right-associated result dependencies. A custom suffix
method is observed once and never reimplemented or recursively inspected.
Selection uses the world after preceding unary effects. Every thrown value and
world is propagated at its exact trace prefix, and divergence at every possible
call position remains divergence. Values and worlds at all operations, every
selection function, the initial history and unused replies are arbitrary.
The native tuple bound belongs to Tail, not to a success premise.
Source: base/broadcast.jl:437-438; combine_styles docs at lines416-420. -/
def VariadicObservations : Prop :=
  ∀ {W L : Type} (core : CoreOps (ProbeWorld W L) L)
      (select : Value L → Value L → List (Value L) → W → Method)
      (bindings : Bindings L) (first second : Value L) (rest : Tail L)
      (values : Nat → Value L) (worlds : Nat → W) (initial : W)
      (history : List (Event L)) (suffix : List (Reply W L)),
    let inputs := first :: second :: rest.values
    let cut := cutPoint select worlds 1 second rest.values
    let count := 2 * cut + 1
    let prescribed := variadicEvents bindings inputs cut values
    let successful : List (Reply W L) :=
      (List.range count).map (fun index => .returned (values index) (worlds index))
    let ops : Ops (ProbeWorld W L) L :=
      { toCoreOps := observingOps core
        selectedCombine := fun left right tail world => select left right tail world.payload }
    let before : ProbeWorld W L := ⟨initial, successful ++ suffix, history⟩
    let after : ProbeWorld W L :=
      ⟨worlds (count - 1), suffix, history ++ prescribed⟩
    (0 < cut ∧ cut < inputs.length) ∧ prescribed.length = count ∧
    combineMany ops bindings first second rest before =
      some (.ok (values (count - 1), after)) ∧
    (∀ (position : Fin count) (error : Value L) (failureWorld : W),
      let remaining := successful.drop (position.val + 1) ++ suffix
      let failureBefore : ProbeWorld W L :=
        ⟨initial, successful.take position.val ++
          [.thrown error failureWorld] ++ remaining, history⟩
      let failureAfter : ProbeWorld W L :=
        ⟨failureWorld, remaining, history ++ prescribed.take (position.val + 1)⟩
      combineMany ops bindings first second rest failureBefore =
        some (.error (error, failureAfter))) ∧
    (∀ position : Fin count,
      let divergenceBefore : ProbeWorld W L :=
        ⟨initial, successful.take position.val ++ [.diverged] ++
          successful.drop (position.val + 1) ++ suffix, history⟩
      combineMany ops bindings first second rest divergenceBefore = none)

theorem UnaryObservations_proven : UnaryObservations := by
  unfold UnaryObservations ReturnsLastAfter
  repeat intro
  simp +zetaDelta [combineOne, observingOps, observe, successfulReplies, List.ofFn_succ, Fin.forall_fin_succ, bind, List.append_assoc, JuliaLean.base.broadcast.Shape.m503]

theorem BinaryObservations_proven : BinaryObservations := by
  unfold BinaryObservations ReturnsLastAfter
  repeat intro
  simp +zetaDelta [combineTwo, observingOps, observe, successfulReplies, List.ofFn_succ, Fin.forall_fin_succ, bind, List.append_assoc, JuliaLean.base.broadcast.Shape.m503]

theorem UnaryContract_proven : UnaryContract := by
  refine ⟨UnaryObservations_proven, ?_⟩
