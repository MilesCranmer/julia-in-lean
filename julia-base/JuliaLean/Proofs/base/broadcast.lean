/-- Wrong arity preserves the real anonymous function identity and original
argument tuple in MethodError, including world-age effects/failure/divergence.
No arbitrary application is misreported as an undefined operation or coerced
into a two-word specialization. This is an outcome observation, not a body
or assumed constructor/application law. -/
def ArityFailure {W L : Type} (ops : CoreOps W L) (bindings : Bindings L)
    (code : Models1Group12.ChunkFunctionCode) (arguments : JuliaLean.base.broadcast.Models2Group5.Constructors.ArgumentTuple L) : Prop :=
  ∀ world : W,
    match ops.worldAge world with
    | none => invoke ops bindings code arguments world = none
    | some (.error (error, after)) =>
        invoke ops bindings code arguments world = some (.error (error, after))
    | some (.ok (age, after)) =>
        invoke ops bindings code arguments world = some (.error
          (JuliaLean.base.boot.objV ops (.methodError (bindings.functionValue code)
            (JuliaLean.base.boot.tupleV ops arguments.values) (JuliaLean.base.boot.intV ops age)),
           after))

