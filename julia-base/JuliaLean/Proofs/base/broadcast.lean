/-- Proof-side binding of the installed generic Style.m463, not another
implementation of result_style. Unit removes only the old model's optional
StateT bookkeeping layer: all Julia mutation, exceptions and divergence
remain in the arbitrary CoreM world. Both source-selected operations use the
existing interface, including the actual ResultJoinCall instance. Values are
unrestricted Julia values, without the old Style-kind/rank approximation.
Source: base/broadcast.jl:463. -/
def installedInvocation {W L : Type} (ops : CoreOps W L)
    (broadcastStyle resultJoin left right : Value L) : CoreM W L (Value L) :=
  letI : Style.ResultJoinCall (StateT Unit (CoreM W L)) (Value L) :=
    { join := fun left right forward reverse =>
        StateT.lift (ops.call resultJoin [left, right, forward, reverse]) }
  do
    let result ← Style.m463 (σ := Unit) (m := CoreM W L)
      (fun first second => StateT.lift (ops.call broadcastStyle [first, second]))
      left right ()
    pure result.1

/-- For every pair of original inputs and every selected rule/join dispatch,
result_style evaluates the forward rule before the reversed rule, passes the
original operands and both exact rule results to the join, and preserves its
actual result. Errors at each site preserve their identity, world and source
prefix while suppressing later calls; divergence at each site is retained.
No style-return, symmetry, type-identity, purity, or callee-correctness law is
assumed. Arbitrary contexts and worlds are quantified by ReturnsLastAfter.
