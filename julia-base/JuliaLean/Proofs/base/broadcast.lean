            (prescribed ++ [.call bindings.materializeBang [dest, values (3 * count - 1)]])
            (values (3 * count))
      | .fallback =>
          let successful : List (Reply W L) :=
            (List.range (3 * count)).map (fun pos => .returned (values pos) (worlds pos))
          let exhausted : ProbeWorld W L := ⟨initial, successful, history⟩
          action exhausted = none ∧
          PrefixFailures action values worlds initial history suffix prescribed

