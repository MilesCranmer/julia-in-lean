namespace JuliaLean.Proofs.base.broadcast.Models2Group5.Gather

open JuliaLean
open JuliaLean.Registry
open JuliaLean.base.expr (Value)
open JuliaLean.base.boot (CoreOps)
open JuliaLean.base.broadcast.Models2Group5.Gather
open JuliaLean.Proofs.base.broadcast.Models2Group5.ForwardObservations

/-- Observe only the actual propagated compiler context; the other context
retains arbitrary operations. All selected-method metadata remains unchanged. -/
def observingContexts {W L : Type} (contexts : ContextOps (ProbeWorld W L) L)
    (wanted : Bool) : ContextOps (ProbeWorld W L) L where
  inContext := fun flag =>
    let ops := contexts.inContext flag
    if flag = wanted then
      { ops with toIntegerOps :=
          { ops.toIntegerOps with toOps :=
              { ops.toIntegerOps.toOps with
                toCoreOps := observingOps ops.toIntegerOps.toOps.toCoreOps } } }
    else ops

/-- The native tuple read is a getfield event; a selected custom getter is a
call event. Selection observes the exact pre-call world, including arbitrary
metadata. This is an observation specification, not a replacement getter. -/
def headEvent {W L : Type} (ops : Ops (ProbeWorld W L) L)
    (bindings : Bindings L) (args : Value L) (world : ProbeWorld W L) : Event L :=
  let one := JuliaLean.base.boot.intV ops.toIntegerOps.toOps.toCoreOps (JInt.lit .i64 1)
  match ops.selectedKeepGet args (JInt.lit .i64 1) world with
  | .builtin => .getfield args one
  | .custom => .call bindings.getindex [args, one]

/-- For all actual tuple getter selections, native bounds contexts, runtime
values and custom broadcast getters, the singleton overload reads its one
slot once and broadcasts that exact value at the original index once. It
returns the resulting reference as a singleton tuple. Either hook's exception
and world are retained exactly; divergence suppresses all later operations.
Source: base/broadcast.jl:701; base/tuple.jl:33. -/
def SingletonContract : Prop :=
  ∀ {W L : Type} (contexts : ContextOps (ProbeWorld W L) L)
      (bindings : Bindings L) (args index : Value L) (boundscheck : Bool)
      (values : Fin 2 → Value L) (worlds : Fin 2 → W)
      (initial : W) (history : List (Event L)) (suffix : List (Reply W L)),
    let ops := contexts.inContext boundscheck
    let core := ops.toIntegerOps.toOps.toCoreOps
    let successful := successfulReplies 1 values worlds
    let action := singleton (observingContexts contexts boundscheck)
      bindings args index boundscheck
    let before : ProbeWorld W L := ⟨initial, successful ++ suffix, history⟩
    let prescribed := [headEvent ops bindings args before,
      .call bindings.broadcastGetindex [values 0, index]]
    action before = some (.ok (JuliaLean.base.boot.tupleV core [values 1],
      ⟨worlds 1, suffix, history ++ prescribed⟩)) ∧
    (∀ (position : Fin 2) (error : Value L) (failureWorld : W),
      let remaining := successful.drop (position.val + 1) ++ suffix
      let failureBefore : ProbeWorld W L :=
        ⟨initial, successful.take position.val ++ [.thrown error failureWorld] ++ remaining,
          history⟩
      let failureEvents := [headEvent ops bindings args failureBefore,
        .call bindings.broadcastGetindex [values 0, index]]
      action failureBefore = some (.error (error,
        ⟨failureWorld, remaining, history ++ failureEvents.take (position.val + 1)⟩))) ∧
    (∀ position : Fin 2,
      let divergenceBefore : ProbeWorld W L :=
        ⟨initial, successful.take position.val ++ [.diverged] ++
          successful.drop (position.val + 1) ++ suffix, history⟩
      action divergenceBefore = none)

/-- The generic body never evaluates tail before its first broadcast value,
and never recurses before tail returns. This invariant quantifies over every
callee and selector, including explicitly invoked empty tuples and their
actual native tuple-read errors. Source: base/broadcast.jl:700. -/
def PrefixFailureContract : Prop :=
  ∀ {W L : Type} (contexts : ContextOps (ProbeWorld W L) L)
      (bindings : Bindings L) (args index : Value L) (boundscheck : Bool)
      (values : Fin 3 → Value L) (worlds : Fin 3 → W)
      (initial : W) (history : List (Event L)) (suffix : List (Reply W L)),
    let ops := contexts.inContext boundscheck
    let successful := successfulReplies 2 values worlds
    let action := gather (observingContexts contexts boundscheck)
      bindings args index boundscheck
    (∀ (position : Fin 3) (error : Value L) (failureWorld : W),
      let remaining := successful.drop (position.val + 1) ++ suffix
      let before : ProbeWorld W L :=
        ⟨initial, successful.take position.val ++ [.thrown error failureWorld] ++ remaining,
          history⟩
      let prescribed := [headEvent ops bindings args before,
        .call bindings.broadcastGetindex [values 0, index], .call bindings.tail [args]]
      action before = some (.error (error,
        ⟨failureWorld, remaining, history ++ prescribed.take (position.val + 1)⟩))) ∧
    (∀ position : Fin 3,
      let before : ProbeWorld W L :=
        ⟨initial, successful.take position.val ++ [.diverged] ++
          successful.drop (position.val + 1) ++ suffix, history⟩
      action before = none)

/-- Proof scenarios for the actual last recursive method. -/
inductive Terminal where
  | singleton
  | empty
  | custom

def terminalMethod : Terminal → Method
  | .singleton => .singleton
  | .empty => .empty
  | .custom => .custom

/-- Arbitrary containers, slot values, broadcast results and splat outcomes.
These indexed functions are proof observations, not Julia containers. -/
structure Chain (L : Type) where
  arguments : Nat → Value L
  heads : Nat → Value L
  values : Nat → Value L
  customGet : Nat → Bool
  assembled : Nat → Value L
  customTerminal : Value L

/-- Three descending calls per generic frame; the terminal is empty, makes
two singleton calls, or makes one custom call. One splat per generic frame
then occurs in reverse order. No recursive model computes this list. -/
def chainValues {L : Type} (frames : Nat) (terminal : Terminal)
    (chain : Chain L) : List (Value L) :=
  (List.range frames).flatMap (fun j =>
    [chain.heads j, chain.values j, chain.arguments (j + 1)]) ++
  (match terminal with
   | .singleton => [chain.heads frames, chain.values frames]
   | .empty => []
   | .custom => [chain.customTerminal]) ++
  (List.range frames).reverse.map chain.assembled

def chainReplies {W L : Type} (values : List (Value L)) (worlds : Nat → W) :
    List (Reply (Nat × W) L) :=
  (values.zip (List.range values.length)).map fun (value, index) =>
    .returned value (index + 1, worlds index)

/-- Selected dispatch reads the observation cursor only after the actual tail
call. No fuel or assumed callee law is given to the recursive model. -/
def chainContexts {W L : Type} (other : ContextOps (ProbeWorld (Nat × W) L) L)
    (core : CoreOps (ProbeWorld (Nat × W) L) L) (boundscheck : Bool)
    (frames : Nat) (terminal : Terminal) (customGet : Nat → Bool) :
    ContextOps (ProbeWorld (Nat × W) L) L where
  inContext := fun flag =>
    if flag = boundscheck then
      { toIntegerOps := { toOps := { toCoreOps := observingOps core, selectedIfElse := fun _ _ _ _ => .missing }, selectedKeepGet := fun _ _ world => if customGet (world.payload.1 / 3) then .custom else .builtin }
        selectedGather := fun _ _ world =>
          if world.payload.1 = 3 * frames then terminalMethod terminal else .generic }
    else other.inContext flag

/-- Independent closed-form source trace: native/custom head accesses are
chosen per frame, and each broadcast getter sees the same original index.
Ascending tuple splats receive precisely the corresponding broadcast result
and the immediately deeper assembled tuple. Source: base/broadcast.jl:700-702. -/
def chainEvents {W L : Type} (ops : CoreOps (ProbeWorld (Nat × W) L) L)
    (bindings : Bindings L) (index : Value L) (frames : Nat) (terminal : Terminal)
    (chain : Chain L) : List (Event L) :=
  let one := JuliaLean.base.boot.intV ops (JInt.lit .i64 1)
  let head := fun j => if chain.customGet j then
    Event.call bindings.getindex [chain.arguments j, one]
    else Event.getfield (chain.arguments j) one
  let terminalValue := match terminal with
    | .singleton => JuliaLean.base.boot.tupleV ops [chain.values frames]
    | .empty => JuliaLean.base.boot.tupleV ops []
    | .custom => chain.customTerminal
  (List.range frames).flatMap (fun j =>
    [head j, .call bindings.broadcastGetindex [chain.heads j, index],
      .call bindings.tail [chain.arguments j]]) ++
  (match terminal with
   | .singleton => [head frames,
       .call bindings.broadcastGetindex [chain.heads frames, index]]
   | .empty => []
   | .custom => [.call bindings.gather [chain.arguments frames, index]]) ++
  (List.range frames).reverse.map (fun j =>
    .splat bindings.iterate [JuliaLean.base.boot.coreV ops "tuple",
      JuliaLean.base.boot.tupleV ops [chain.values j],
      if j + 1 = frames then terminalValue else chain.assembled (j + 1)])

/-- At every positive finite depth, generic recursion preserves left-to-right
reads and returns through reverse-order splats. Both bounds contexts, native
and custom tuple getters, every terminal method, all returned references and
worlds, and every error/divergence prefix are admitted. Mutable aliases can
repeat at any depth. Unreachable outer splats remain unexecuted on failure.
The model itself has no depth parameter and admits nonterminating chains.
Source: base/broadcast.jl:700-702. -/
def FiniteRecursionContract : Prop :=
  ∀ {W L : Type} (other : ContextOps (ProbeWorld (Nat × W) L) L)
      (ops : CoreOps (ProbeWorld (Nat × W) L) L) (bindings : Bindings L)
      (index : Value L) (boundscheck : Bool) (depth : Nat) (terminal : Terminal)
      (chain : Chain L) (worlds : Nat → W) (initial : W)
      (history : List (Event L)) (suffix : List (Reply (Nat × W) L)),
    let frames := depth + 1
    let values := chainValues frames terminal chain
    let successful := chainReplies values worlds
    let prescribed := chainEvents ops bindings index frames terminal chain
    let action := gather (chainContexts other ops boundscheck frames terminal chain.customGet)
      bindings (chain.arguments 0) index boundscheck
    let before : ProbeWorld (Nat × W) L := ⟨(0, initial), successful ++ suffix, history⟩
    let after : ProbeWorld (Nat × W) L :=
      ⟨(values.length, worlds (values.length - 1)), suffix, history ++ prescribed⟩
    prescribed.length = values.length ∧
    action before = some (.ok (chain.assembled 0, after)) ∧
    (∀ (position : Fin values.length) (error : Value L) (failureWorld : W),
      let remaining := successful.drop (position.val + 1) ++ suffix
      let failureBefore : ProbeWorld (Nat × W) L :=
        ⟨(0, initial), successful.take position.val ++
          [.thrown error (position.val + 1, failureWorld)] ++ remaining, history⟩
      let failureAfter : ProbeWorld (Nat × W) L :=
        ⟨(position.val + 1, failureWorld), remaining,
          history ++ prescribed.take (position.val + 1)⟩
      action failureBefore = some (.error (error, failureAfter))) ∧
    (∀ position : Fin values.length,
      let before : ProbeWorld (Nat × W) L :=
        ⟨(0, initial), successful.take position.val ++ [.diverged] ++
          successful.drop (position.val + 1) ++ suffix, history⟩
      action before = none)

def GenericContract : Prop := PrefixFailureContract ∧ FiniteRecursionContract

private theorem singletonContract_proved : SingletonContract := by
  intro W L contexts bindings args index boundscheck values worlds initial history suffix
  simp [JuliaLean.base.broadcast.Models2Group5.Gather.singleton,
    observingContexts, headEvent,
    JuliaLean.base.broadcast.Models2Group5.NewIndex.tupleGet,
    JuliaLean.base.broadcast.Index.m701, observingOps, observe, successfulReplies,
    List.ofFn_succ, List.ofFn_zero, bind, pure, JuliaLean.base.boot.tupleV,
    JuliaLean.base.boot.intV, Fin.forall_fin_succ, List.append_assoc]
  all_goals
    repeat' apply And.intro
    all_goals intros
    all_goals split <;> simp_all [bind, pure, List.append_assoc]
    all_goals
      split at * <;> simp_all [bind, pure, List.append_assoc]
    all_goals
      rcases ‹_ ∧ _› with ⟨hvalue, hworld⟩
      subst_vars
      simp [bind, pure]

