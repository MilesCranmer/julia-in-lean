theorem restart_recursion_runtime : RestartRecursionRuntime := by
  intro W L core bindings newdest dest bc value index iterator state count iterations terminal
    values worlds initial history suffix
  by_cases condition :
      ((List.range iterations).all (fun frame =>
        !((core true).same (values (1 + 5 * frame)) (JuliaLean.base.boot.nothingV (core true)))) &&
        (core true).same (values (1 + 5 * iterations)) (JuliaLean.base.boot.nothingV (core true))) = true
  · simp only [condition, ↓reduceIte]
    have both :
        (List.range iterations).all (fun frame =>
          !((core true).same (values (1 + 5 * frame)) (JuliaLean.base.boot.nothingV (core true)))) = true ∧
        (core true).same (values (1 + 5 * iterations)) (JuliaLean.base.boot.nothingV (core true)) = true := by
      simpa only [Bool.and_eq_true] using condition
    have guards : ∀ frame, frame ∈ List.range' 0 iterations →
        (core true).same (values (1 + 5 * frame))
          (JuliaLean.base.boot.nothingV (core true)) = false := by
      intro frame member
      have inRange : frame ∈ List.range iterations := by
        simpa only [List.range_eq_range'] using member
      have test := List.all_eq_true.mp both.1 frame inRange
      cases flag : (core true).same (values (1 + 5 * frame))
          (JuliaLean.base.boot.nothingV (core true)) with
      | false => rfl
      | true =>
          have impossible : false = true := by simpa only [flag, Bool.not_true] using test
          cases impossible
    cases terminal with
    | custom =>
        exact restart_custom_trace core bindings
          ⟨newdest, dest, bc, value, index, iterator, state, count⟩
          values worlds iterations initial history suffix guards both.2
    | builtin =>
        cases copied : (core true).same (values ((4 + 5 * iterations) + 1))
            (JuliaLean.base.boot.nothingV (core true)) with
        | false =>
            simp only [copied, Bool.false_eq_true, ↓reduceIte]
            exact restart_builtin_failure_prefixes core bindings
              ⟨newdest, dest, bc, value, index, iterator, state, count⟩
              values worlds iterations initial history suffix guards both.2
        | true =>
            simp only [copied, ↓reduceIte]
            exact restart_builtin_trace core bindings
              ⟨newdest, dest, bc, value, index, iterator, state, count⟩
              values worlds iterations initial history suffix guards both.2 copied
  · simp only [condition, Bool.false_eq_true, ↓reduceIte]

