/-- Independent outcome policy for explicit bounds checks. The prescribed
prefix must have a last predicate observation. A true Bool yields nothing
without reaching the error function; false calls the error function once,
with its arbitrary outcome, and any successful return is discarded. A
non-Bool raises the exact conditional TypeError before any error call.
Every call error/divergence is tested without any predicate-correctness law.
This is proof observation support, not a second bounds evaluator: it does not
compute axes, check coordinates, or call any selected Julia function. -/
def CheckOutcome {W L : Type} (core : CoreOps (ProbeWorld W L) L)
    (action : CoreM (ProbeWorld W L) L (Value L))
    (values : Nat → Value L) (worlds : Nat → W) (initial : W)
    (history : List (Event L)) (suffix : List (Reply W L))
    (priorReplies : List (Event L)) (failureCall : Event L) : Prop :=
  let count := priorReplies.length
  let checked := values (count - 1)
  let flag := match checked with
    | .leaf leaf => core.asBool leaf
    | _ => none
  0 < count ∧
    match flag with
    | some true =>
        FollowsPlan action values worlds initial history suffix priorReplies
          (JuliaLean.base.boot.nothingV core)
    | some false =>
        FollowsPlan action values worlds initial history suffix (priorReplies ++ [failureCall])
          (JuliaLean.base.boot.nothingV core)
    | none =>
        let successful : List (Reply W L) :=
          (List.range count).map (fun position => .returned (values position) (worlds position))
        let before : ProbeWorld W L := ⟨initial, successful ++ suffix, history⟩
        let after : ProbeWorld W L := ⟨worlds (count - 1), suffix, history ++ priorReplies⟩
        PrefixFailures action values worlds initial history suffix priorReplies ∧
        action before = some (.error
          (JuliaLean.base.boot.objV core (.typeError (.symbol "if")
            (JuliaLean.base.boot.strV core "") (JuliaLean.base.boot.coreV core "Bool") checked),
            after))

