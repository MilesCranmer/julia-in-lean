/-- Invalid RHS targets are runtime argument errors for both builtins. The
error names the builtin, expects Type, reports the target rather than the
value being tested, and preserves the complete world. The antecedent is the
actual runtime type-validity classification, not a correctness law for a
callee or a promised successful assertion. -/
def InvalidTargets : Prop :=
  ∀ {W L : Type} (ops : CoreOps W L) (value type : Value L) (world : W),
    ops.isa type (JuliaLean.base.boot.coreV ops "Type") = false →
      checkedIsa ops value type world = some (.error
        (JuliaLean.base.boot.objV ops (.typeError (.symbol "isa")
          (JuliaLean.base.boot.strV ops "") (JuliaLean.base.boot.coreV ops "Type") type), world)) ∧
      checkedAssert ops value type world = some (.error
        (JuliaLean.base.boot.objV ops (.typeError (.symbol "typeassert")
          (JuliaLean.base.boot.strV ops "") (JuliaLean.base.boot.coreV ops "Type") type), world))

/-- On valid type targets, isa terminates without changing the world and
observes the installed membership predicate exactly. A successful assertion
retains the exact original value, including mutable reference identity; a
failed assertion reports the asserted type and tested value, never an
invalid-target diagnostic. All types, values and worlds remain quantified. -/
def ValidTargets : Prop :=
  ∀ {W L : Type} (ops : CoreOps W L) (value type : Value L) (world : W),
    ops.isa type (JuliaLean.base.boot.coreV ops "Type") = true →
      checkedIsa ops value type world = some (.ok (ops.isa value type, world)) ∧
      (ops.isa value type = true →
        checkedAssert ops value type world = some (.ok (value, world))) ∧
      (ops.isa value type = false →
        checkedAssert ops value type world = some (.error
          (JuliaLean.base.boot.objV ops (.typeError (.symbol "typeassert")
            (JuliaLean.base.boot.strV ops "") type value), world)))

def RuntimeContract : Prop := InvalidTargets ∧ ValidTargets

