namespace JuliaLean.Proofs.base.broadcast.Models2Group5.CopyNarrowing

open JuliaLean
open JuliaLean.Registry
open JuliaLean.base.expr (Value Sym)
open JuliaLean.base.boot (CoreOps CoreM)
open JuliaLean.base.broadcast.Models2Group5.CopyNarrowing
open JuliaLean.Proofs.base.broadcast.Models2Group5.ForwardObservations (Reply)
open JuliaLean.Proofs.base.broadcast.Models2Group5.IndexAccess.ContextObservations

/-- Observe calls and assignment-field reads in their actual compiler context;
other primitive operations retain their arbitrary supplied behavior. -/
def observeContexts {W L : Type}
    (core : Bool → CoreOps (World W L) L) :
    JuliaLean.base.broadcast.Models2Group5.Iteration.ContextOps (World W L) L where
  inContext := fun context =>
    { core context with
      call := fun function arguments => observe context (.call function arguments)
      getfield := fun object field => observe context (.getfield object field) }

/-- Lift constructor-selection metadata through proof-world instrumentation. -/
def observingCopy {W L : Type} (core : Bool → CoreOps (World W L) L)
    (selectType : Sym → Value L → W → ConstructorMethod)
    (selectUnion : Value L → Value L → W → ConstructorMethod) : Ops (World W L) L where
  contexts := observeContexts core
  selectedTypeVar := fun name bound world => selectType name bound world.payload
  selectedUnionAll := fun typeVariableValue body world => selectUnion typeVariableValue body world.payload

/-- Source initialization trace before narrowing/type construction. The index
and iterate state come from distinct indexed_iterate results; exactly the
index token is used by both explicit-inbounds operations. The chosen allocation
receives builtin typeof of the exact read value, and its setter receives that
original value, never an earlier iterator object or converted placeholder. -/
def initializationEvents {W L : Type} (core : CoreOps W L) (bindings : Bindings L)
    (bc : Value L) (boundscheck : Bool) (values : Nat → Value L) :
    List (ContextEvent L) :=
  let one := JuliaLean.base.boot.intV core (JInt.lit .i64 1)
  let two := JuliaLean.base.boot.intV core (JInt.lit .i64 2)
  [call boundscheck bindings.resultEltype [bc],
   call boundscheck bindings.isConcreteType [values 0],
   call boundscheck bindings.preprocess [JuliaLean.base.boot.nothingV core, bc],
   call boundscheck bindings.eachindex [values 2],
   call boundscheck bindings.iterate [values 3],
   call boundscheck bindings.indexedIterate [values 4, one],
   ⟨boundscheck, .getfield (values 5) one⟩,
   ⟨boundscheck, .getfield (values 5) two⟩,
   call boundscheck bindings.indexedIterate [values 4, two, values 7],
   ⟨boundscheck, .getfield (values 8) one⟩,
   call false bindings.getindex [values 2, values 6],
   call boundscheck bindings.similar [values 2, .leaf (core.typeOf (values 10))],
   call false bindings.setindex [values 11, values 10, values 6]]

/-- Independent default-copy control and initialization invariant over every
runtime input and arbitrary selected outcome. A true isconcretetype result
reaches exactly similar then copyto!. False queries preprocess/eachindex/iterate;
only actual nothing takes the empty allocation branch. Every other iterate
result must undergo the full source destructuring and initialization sequence,
whose every failure/divergence prefix is preserved with its actual world.
Non-Bool isconcretetype raises the exact conditional TypeError before allocation.
This is intentionally a source initialization/exception invariant, not a
claim about an arbitrary selected copier's final array semantics. The complete
model continues through narrowing and the original final type assertion.
Source: base/broadcast.jl:948-975; manual/functions.md:394-409. -/
def CopyInitializationObservations : Prop :=
  ∀ {W L : Type} (core : Bool → CoreOps (World W L) L)
      (selectType : Sym → Value L → W → ConstructorMethod)
      (selectUnion : Value L → Value L → W → ConstructorMethod)
      (bindings : Bindings L) (bc : Value L) (boundscheck : Bool)
      (values : Nat → Value L) (worlds : Nat → W) (initial : W)
      (history : List (ContextEvent L)) (suffix : List (Reply W L)),
    let sourceCore := core boundscheck
    let action := copy (observingCopy core selectType selectUnion) bindings bc boundscheck
    let priorReplies : List (ContextEvent L) :=
      [call boundscheck bindings.resultEltype [bc],
       call boundscheck bindings.isConcreteType [values 0]]
    match (match values 1 with | .leaf value => sourceCore.asBool value | _ => none) with
    | some true =>
        ReturnsLast action 4 values worlds
          (priorReplies ++ [call boundscheck bindings.similar [bc, values 0],
            call boundscheck bindings.copyTo [values 2, bc]]) initial history suffix
    | some false =>
        if sourceCore.same (values 4) (JuliaLean.base.boot.nothingV sourceCore) then
          ReturnsLast action 6 values worlds
            (priorReplies ++
              [call boundscheck bindings.preprocess
                 [JuliaLean.base.boot.nothingV sourceCore, bc],
               call boundscheck bindings.eachindex [values 2],
               call boundscheck bindings.iterate [values 3],
               call boundscheck bindings.similar [values 2, values 0]])
            initial history suffix
        else
          FailurePrefixes action (successes 13 values worlds)
            (initializationEvents sourceCore bindings bc boundscheck values)
            initial history suffix
    | none =>
        let successful := successes 2 values worlds
        let before : World W L := ⟨initial, successful ++ suffix, history⟩
        let after : World W L := ⟨worlds 1, suffix, history ++ priorReplies⟩
        FailurePrefixes action successful priorReplies initial history suffix ∧
        action before = some (.error
          (JuliaLean.base.boot.objV sourceCore (.typeError (.symbol "if")
            (JuliaLean.base.boot.strV sourceCore "")
            (JuliaLean.base.boot.coreV sourceCore "Bool") (values 1)), after))

/-- A failure during post-write subtyping must retain the state produced by
all earlier initialization operations, including the successful first write.
The builtin is instrumented with a context-labelled call observation carrying
its actual two operands; that tag is proof instrumentation, not a generic
replacement for the model's CoreOps.subtype. No prior mutation is rolled back.
Branch tests are the source's actual Bool/nothing/bottom decisions, not assumed
callee correctness or successful types. All inputs and primitive worlds are
quantified; this covers the reached post-write branch when applicable.
Source: base/broadcast.jl:964-974. -/
def FirstWriteSurvivesTypeFailure : Prop :=
  ∀ {W L : Type} (core : Bool → CoreOps (World W L) L)
      (selectType : Sym → Value L → W → ConstructorMethod)
      (selectUnion : Value L → Value L → W → ConstructorMethod)
      (bindings : Bindings L) (bc : Value L) (boundscheck : Bool)
      (values : Nat → Value L) (worlds : Nat → W) (initial failureWorld : W)
      (history : List (ContextEvent L)) (suffix : List (Reply W L)) (error : Value L),
    let sourceCore := core boundscheck
    let reached :=
      (match values 1 with | .leaf value => sourceCore.asBool value == some false | _ => false) &&
      !(sourceCore.same (values 4) (JuliaLean.base.boot.nothingV sourceCore)) &&
      !(sourceCore.same (values 0) (JuliaLean.base.boot.coreV sourceCore "Union{}"))
    if reached then
      let observedCore := fun context =>
        { core context with
          subtype := fun left right world =>
            some (.error (error,
              { world with payload := failureWorld
                           events := world.events ++
                             [call context (JuliaLean.base.boot.coreV (core context) "<:")
                               [left, right]] })) }
      let action := copy (observingCopy observedCore selectType selectUnion) bindings bc boundscheck
      let before : World W L := ⟨initial, successes 13 values worlds ++ suffix, history⟩
      let after : World W L :=
        ⟨failureWorld, suffix,
          history ++ initializationEvents sourceCore bindings bc boundscheck values ++
            [call boundscheck (JuliaLean.base.boot.coreV sourceCore "<:")
              [values 0, JuliaLean.base.boot.coreV sourceCore "Type"]]⟩
      action before = some (.error (error, after))
    else True

/-- Proof-only observations for the two existing constructor primitives.
The symbols _typevar and jl_type_unionall are trace labels for primitive
operations, not invented runtime bindings or model callees. -/
def observeConstructors {W L : Type} (core : CoreOps (World W L) L) :
    CoreOps (World W L) L :=
  { core with
    call := fun function arguments => observe true (.call function arguments)
    typevar := fun name lower upper => observe true
      (.call (.symbol "_typevar") [.symbol name, lower, upper])
    typeUnionall := fun typeVariableValue body => observe true
      (.call (.symbol "jl_type_unionall") [typeVariableValue, body]) }

/-- The anonymous-bound constructor forwards its exact generated Symbol and
bound, preserves primitive/custom return identity and every error/world, and
performs exactly the selected canonical or custom operation. Canonical _typevar
receives the real empty-union lower bound. No type/result law is imposed on
custom constructor dispatch. Source: broadcast973; boot371. -/
def TypeVariableObservations : Prop :=
  ∀ {W L : Type} (core : CoreOps (World W L) L)
      (selectType : Sym → Value L → W → ConstructorMethod)
      (selectUnion : Value L → Value L → W → ConstructorMethod)
      (name : Sym) (bound : Value L) (values : Nat → Value L) (worlds : Nat → W)
      (initial : W) (history : List (ContextEvent L)) (suffix : List (Reply W L)),
    let observed := observeConstructors core
    let ops : Ops (World W L) L :=
      { contexts := ⟨fun _ => observed⟩
        selectedTypeVar := fun name bound world => selectType name bound world.payload
        selectedUnionAll := fun typeVariableValue body world => selectUnion typeVariableValue body world.payload }
    let event := match selectType name bound initial with
      | .builtin => call true (.symbol "_typevar")
          [.symbol name, JuliaLean.base.boot.coreV core "Union{}", bound]
      | .custom => call true (JuliaLean.base.boot.coreV core "TypeVar") [.symbol name, bound]
    ReturnsLast (typeVariable ops observed name bound) 1 values worlds [event]
      initial history suffix

/-- Canonical UnionAll validates its actual variable before its primitive,
retaining the exact TypeError/world on failure; custom selection is allowed
its complete arbitrary result. Successful selected operations receive the
unmodified variable/body and preserve every operation outcome.
Source: broadcast973; boot373. -/
def UniversalTypeObservations : Prop :=
  ∀ {W L : Type} (core : CoreOps (World W L) L)
      (selectType : Sym → Value L → W → ConstructorMethod)
      (selectUnion : Value L → Value L → W → ConstructorMethod)
      (typeVariableValue body : Value L) (values : Nat → Value L) (worlds : Nat → W)
      (initial : W) (history : List (ContextEvent L)) (suffix : List (Reply W L)),
    let observed := observeConstructors core
    let ops : Ops (World W L) L :=
      { contexts := ⟨fun _ => observed⟩
        selectedTypeVar := fun name bound world => selectType name bound world.payload
        selectedUnionAll := fun typeVariableValue body world => selectUnion typeVariableValue body world.payload }
    let action := universalType ops observed typeVariableValue body
    match selectUnion typeVariableValue body initial with
    | .custom =>
        ReturnsLast action 1 values worlds
          [call true (JuliaLean.base.boot.coreV core "UnionAll") [typeVariableValue, body]]
          initial history suffix
    | .builtin =>
        if core.isa typeVariableValue (JuliaLean.base.boot.coreV core "TypeVar") then
          ReturnsLast action 1 values worlds
            [call true (.symbol "jl_type_unionall") [typeVariableValue, body]] initial history suffix
        else
          let before : World W L := ⟨initial, suffix, history⟩
          action before = some (.error
            (JuliaLean.base.boot.objV core (.typeError (.symbol "typeassert")
              (JuliaLean.base.boot.strV core "") (JuliaLean.base.boot.coreV core "TypeVar")
              typeVariableValue), before))

def AnonymousTypeConstructorContract : Prop :=
  TypeVariableObservations ∧ UniversalTypeObservations

def CopyRuntimeContract : Prop :=
  CopyInitializationObservations ∧ FirstWriteSurvivesTypeFailure

def proposedEntries : List Entry := [
  { id := "broadcast-copy-anonymous-type-constructors", juliaFile := "base/broadcast.jl",
    juliaFns := ["copy(bc::Broadcasted)"],
