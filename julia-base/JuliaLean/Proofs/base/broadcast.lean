/-- Observe the exact compiler context of source calls and allocation. The
selected ntuple remains a fully effectful arbitrary runtime target; its spy
records the actual callable value and actual Val result before replying. -/
def instrument {W L : Type} (core : Bool → CoreOps (World W L) L)
    (bindings : Bindings L) : Ops (World W L) L where
  contexts := { inContext := fun context =>
    { core context with
      call := fun function arguments => observe context (.call function arguments)
      new := fun type fields => observe context (.newObject type fields) } }
  ntuple := fun function count =>
    observe true (.call bindings.ntuple [function.value, count])

/-- The three calls leading to the dimension comparison, with the actual
axes result and native Int1 preserved. This is a proof observation list. -/
def dimensionPrefix {W L : Type} (core : CoreOps (World W L) L)
    (bindings : Bindings L) (bc : Value L) (values : Nat → Value L) :
    List (ContextEvent L) :=
  [call true bindings.axes [bc], call true bindings.length [values 0],
   call true bindings.equal [values 1, JuliaLean.base.boot.intV core (JInt.lit .i64 1)]]

/-- All source branches are independently specified by their observations.
True comparison forwards original bc through a captured callable and actual
axis length through Val, then returns ntuple's exact reply. False constructs
and throws the fixed DimensionMismatch with the original literal. Non-Bool
fails before allocation/indexing. Every call/allocation error or divergence
prefix retains its exact world and leaves later replies untouched. The values
and worlds at every open dispatch boundary are arbitrary, with no callee law.
Source: base/broadcast.jl:1167-1172. -/
def SourceRuntime : Prop :=
  ∀ {W L : Type} (core : Bool → CoreOps (World W L) L)
      (bindings : Bindings L) (bc : Value L)
      (values : Nat → Value L) (worlds : Nat → W) (initial : W)
      (history : List (ContextEvent L)) (suffix : List (Reply W L)),
    let normal := core true
    let action := copy (instrument core bindings) bindings bc
    let priorReplies := dimensionPrefix normal bindings bc values
    let flag := match values 2 with | .leaf leaf => normal.asBool leaf | _ => none
    match flag with
    | some true =>
        ReturnsLast action 7 values worlds
          (priorReplies ++
            [call true bindings.getindex
               [values 0, JuliaLean.base.boot.intV normal (JInt.lit .i64 1)],
             call true bindings.length [values 3],
             call true bindings.val [values 4],
             call true bindings.ntuple [bindings.closureValue bc, values 5]])
          initial history suffix
    | some false =>
        let events := priorReplies ++
          [⟨true, .newObject bindings.dimensionMismatch
            [JuliaLean.base.boot.strV normal "tuple only supports one dimension"]⟩]
        let before : World W L := ⟨initial, successes 4 values worlds ++ suffix, history⟩
        let after : World W L := ⟨worlds 3, suffix, history ++ events⟩
        FailurePrefixes action (successes 4 values worlds) events initial history suffix ∧
        action before = some (.error (values 3, after))
    | none =>
        let before : World W L := ⟨initial, successes 3 values worlds ++ suffix, history⟩
        let after : World W L := ⟨worlds 2, suffix, history ++ priorReplies⟩
        FailurePrefixes action (successes 3 values worlds) priorReplies initial history suffix ∧
        action before = some (.error
          (JuliaLean.base.boot.objV normal (.typeError (.symbol "if")
            (JuliaLean.base.boot.strV normal "") (JuliaLean.base.boot.coreV normal "Bool")
            (values 2)), after))

/-- The necessary typed default constructor invokes only the existing new
primitive with DimensionMismatch and the exact source message. No rendering,
conversion, altered message or extra type assertion is introduced. Allocation
success identity, exception world and divergence are all preserved. -/
def ConstructorRuntime : Prop :=
  ∀ {W L : Type} (bindings : Bindings L),
    JuliaLean.Proofs.base.broadcast.Models2Group5.ForwardObservations.ReturnsLastAfter
      (W := W) 0 (fun core => constructDimensionMismatch core bindings)
      (fun core _ _ _ => [.newObject bindings.dimensionMismatch
        [JuliaLean.base.boot.strV core "tuple only supports one dimension"]])

/-- Correct-arity invocation forwards the captured original bc and arbitrary
actual index exactly once, always under the closure body's explicit inbounds
context. The selected getter's arbitrary result, errors and divergence remain
observable. This covers all unary indices, including non-integers. -/
def ClosureUnaryRuntime : Prop :=
  ∀ {W L : Type} (core : Bool → CoreOps (World W L) L)
      (bindings : Bindings L) (bc : Value L)
      (arguments : JuliaLean.base.broadcast.Models2Group5.Constructors.ArgumentTuple L)
      (values : Nat → Value L) (worlds : Nat → W) (initial : W)
      (history : List (ContextEvent L)) (suffix : List (Reply W L)),
    match arguments.values with
    | [index] =>
        let function := closure (observingContexts core) bindings bc
        ReturnsLast (function.invoke arguments) 1 values worlds
          [call false bindings.broadcastGetindex [bc, index]] initial history suffix
    | _ => True

/-- Capture/value identity and all non-unary positional arities. Missing
method dispatch retains the actual callable, complete native-bounded argument
tuple and current world age. Failure/divergence of the world-age operation is
preserved, and no broadcast read occurs on an arity mismatch. -/
def ClosureArityAndIdentity : Prop :=
  ∀ {W L : Type}
      (contexts : JuliaLean.base.broadcast.Models2Group5.Iteration.ContextOps W L)
      (bindings : Bindings L) (bc : Value L)
      (arguments : JuliaLean.base.broadcast.Models2Group5.Constructors.ArgumentTuple L)
      (world : W),
    let function := closure contexts bindings bc
    let core := contexts.inContext true
    function.capturedBc = bc ∧ function.value = bindings.closureValue bc ∧
      match arguments.values with
      | [_] => True
      | _ =>
          match core.worldAge world with
          | none => function.invoke arguments world = none
          | some (.error (error, after)) =>
              function.invoke arguments world = some (.error (error, after))
          | some (.ok (age, after)) =>
              function.invoke arguments world = some (.error
                (JuliaLean.base.boot.objV core (.methodError
                  (bindings.closureValue bc) (JuliaLean.base.boot.tupleV core arguments.values)
                  (JuliaLean.base.boot.intV core age)), after))

/-- A selected ntuple implementation can execute the actual passed callable.
Instantiate that target by invoking it on one arbitrary supplied argument;
the observable source setup must then be followed by the correct captured-bc
read under inbounds=false. This detects passing an inert marker or a callable
with the wrong capture/body, even when its nominal value looked correct.
No behavior of the actual Base ntuple implementation is presumed. -/
def PassedCallableRuntime : Prop :=
  ∀ {W L : Type} (core : Bool → CoreOps (World W L) L)
      (bindings : Bindings L) (bc : Value L)
      (arguments : JuliaLean.base.broadcast.Models2Group5.Constructors.ArgumentTuple L)
      (values : Nat → Value L) (worlds : Nat → W) (initial : W)
      (history : List (ContextEvent L)) (suffix : List (Reply W L)),
    let normal := core true
    let flag := match values 2 with | .leaf leaf => normal.asBool leaf | _ => none
    match arguments.values, flag with
    | [index], some true =>
        let ops : Ops (World W L) L :=
          { (instrument core bindings) with
            ntuple := fun function _ => function.invoke arguments }
        ReturnsLast (copy ops bindings bc) 7 values worlds
          (dimensionPrefix normal bindings bc values ++
            [call true bindings.getindex
               [values 0, JuliaLean.base.boot.intV normal (JInt.lit .i64 1)],
             call true bindings.length [values 3],
             call true bindings.val [values 4],
             call false bindings.broadcastGetindex [bc, index]])
          initial history suffix
    | _, _ => True

def ClosureRuntime : Prop :=
  ClosureUnaryRuntime ∧ ClosureArityAndIdentity ∧ PassedCallableRuntime

def RuntimeContract : Prop := SourceRuntime ∧ ConstructorRuntime ∧ ClosureRuntime

