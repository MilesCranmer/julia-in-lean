/-- Both scalar expansion words have the same value in every output bit. -/
theorem chunkRepeatedBoolean (value : Bool) (k : Fin 64) :
    ((if value then JInt.typemax .u64 else JInt.lit .u64 0).val /
      (2 : Int) ^ k.val) % 2 = if value then 1 else 0 := by
  let word := if value then JInt.typemax .u64 else JInt.lit .u64 0
  have hbits : (fromJInt word).getLsbD k.val = value := by
    cases value with
    | false =>
      change (0#64).getLsbD k.val = false
      exact BitVec.getLsbD_zero
    | true =>
      change (BitVec.allOnes 64).getLsbD k.val = true
      rw [BitVec.getLsbD_allOnes, decide_eq_true k.isLt]
  have hdigit := chunkLaneDigit_bit word k
  rw [hbits] at hdigit
  unfold ChunkLaneDigit at hdigit
  have hnonneg := Int.emod_nonneg (word.val / (2 : Int) ^ k.val) (by decide : (2 : Int) ≠ 0)
  have he := congrArg (fun n : Nat => (n : Int)) hdigit
  rw [Int.toNat_of_nonneg hnonneg] at he
  cases value <;> exact he

/-- Prepending an array slot preserves all observations of the suffix. -/
theorem chunkObservation_array {ChunkRef : Type} (head : LiftBitArray ChunkRef)
    (input : List (LiftChunksInput ChunkRef))
    (result : Jl (List (LiftChunksOutput ChunkRef)))
    (h : LiftChunksObservation input result) :
    LiftChunksObservation (.bitarray head :: input)
      (do let suffix ← result; pure (.chunks head.chunks :: suffix)) := by
  cases result with
  | error error =>
    exact ⟨h.1, List.mem_cons_of_mem _ h.2⟩
  | ok output =>
    rcases h with ⟨hlen, hnot, harr, hbool⟩
    refine ⟨congrArg Nat.succ hlen, ?_, ?_, ?_⟩
    · intro h
      rcases List.mem_cons.mp h with h | h
      · cases h
      · exact hnot h
    · intro i array hi
      cases i with
      | zero => cases hi; rfl
      | succ n => exact harr n array hi
    · intro i value hi
      cases i with
      | zero => cases hi
      | succ n =>
        obtain ⟨word, hw, hb⟩ := hbool n value hi
        exact ⟨word, hw, hb⟩

/-- Prepending a scalar slot preserves all observations of the suffix. -/
theorem chunkObservation_boolean {ChunkRef : Type} (head : Bool)
    (input : List (LiftChunksInput ChunkRef))
    (result : Jl (List (LiftChunksOutput ChunkRef)))
    (h : LiftChunksObservation input result) :
    LiftChunksObservation (.boolean head :: input)
      (do let suffix ← result
          pure (.word (if head then JInt.typemax .u64 else JInt.lit .u64 0) :: suffix)) := by
  cases result with
  | error error =>
    exact ⟨h.1, List.mem_cons_of_mem _ h.2⟩
  | ok output =>
    rcases h with ⟨hlen, hnot, harr, hbool⟩
    refine ⟨congrArg Nat.succ hlen, ?_, ?_, ?_⟩
    · intro h
      rcases List.mem_cons.mp h with h | h
      · cases h
      · exact hnot h
    · intro i array hi
      cases i with
      | zero => cases hi
      | succ n => exact harr n array hi
    · intro i value hi
      cases i with
      | zero =>
        cases hi
        exact ⟨if head then JInt.typemax .u64 else JInt.lit .u64 0,
          rfl, chunkRepeatedBoolean head⟩
      | succ n =>
        obtain ⟨word, hw, hb⟩ := hbool n value hi
        exact ⟨word, hw, hb⟩

/-- The empty suffix meets all positional observations. -/
theorem chunkObservation_empty {ChunkRef : Type} :
    LiftChunksObservation ([] : List (LiftChunksInput ChunkRef)) (.ok []) := by
  refine ⟨rfl, List.not_mem_nil, ?_, ?_⟩
  · intro i array hi
    cases hi
  · intro i value hi
    cases hi

/-- Joint induction follows either installed head overload through its suffix. -/
theorem chunkLifting_observation {ChunkRef : Type}
    (input : List (LiftChunksInput ChunkRef))
    (bound : (input.length : Int) + 1 ≤ IntTy.max .i64) :
    (∀ head : LiftBitArray ChunkRef,
      LiftChunksObservation (.bitarray head :: input) (m1114 head ⟨input, bound⟩)) ∧
    (∀ head : Bool,
      LiftChunksObservation (.boolean head :: input) (m1116 head ⟨input, bound⟩)) := by
  induction input with
  | nil =>
    exact ⟨fun head => chunkObservation_array head [] (.ok []) chunkObservation_empty,
      fun head => chunkObservation_boolean head [] (.ok []) chunkObservation_empty⟩
  | cons first rest ih =>
    have hrest : (rest.length : Int) + 1 ≤ IntTy.max .i64 := by
      simp only [List.length_cons, Int.natCast_add, Int.natCast_one] at bound
      omega
    obtain ⟨harray, hboolean⟩ := ih hrest
    cases first with
    | bitarray array =>
      exact ⟨fun head => chunkObservation_array head (.bitarray array :: rest)
          (m1114 array ⟨rest, hrest⟩) (harray array),
        fun head => chunkObservation_boolean head (.bitarray array :: rest)
          (m1114 array ⟨rest, hrest⟩) (harray array)⟩
    | boolean value =>
      exact ⟨fun head => chunkObservation_array head (.boolean value :: rest)
          (m1116 value ⟨rest, hrest⟩) (hboolean value),
        fun head => chunkObservation_boolean head (.boolean value :: rest)
          (m1116 value ⟨rest, hrest⟩) (hboolean value)⟩
    | unsupported =>
      have herror : LiftChunksObservation (.unsupported :: rest)
          (.error (.methodError "liftchunks")) := ⟨rfl, List.mem_cons_self⟩
      exact ⟨fun head => chunkObservation_array head (.unsupported :: rest)
          (.error (.methodError "liftchunks")) herror,
        fun head => chunkObservation_boolean head (.unsupported :: rest)
          (.error (.methodError "liftchunks")) herror⟩

