theorem successes_add {W L : Type} (n m : Nat)
    (values : Nat → Value L) (worlds : Nat → W) :
    successes (n + m) values worlds = successes n values worlds ++
      successes m (fun i => values (n + i)) (fun i => worlds (n + i)) := by
  unfold successes
  rw [List.range_add, List.map_append, List.map_map]
  rfl

theorem successes_three {W L : Type} (values : Nat → Value L) (worlds : Nat → W) :
    successes 3 values worlds =
      [.returned (values 0) (worlds 0), .returned (values 1) (worlds 1),
       .returned (values 2) (worlds 2)] := rfl

def blockEvents {L : Type} (bindings : Bindings L) (boundscheck : Bool)
    (bc original : Value L) (values : Nat → Value L)
    (methods : Nat → Method) (step : Nat) : List (ContextEvent L) :=
  let constructor := match methods step with
    | .cartesianInteger => bindings.cartesianIndices
    | _ => bindings.linearIndices
  [call boundscheck bindings.axes [bc],
   call boundscheck constructor [values (3 * step)],
   call boundscheck bindings.getindex
     [values (3 * step + 1), indexAt original values step]]

theorem conversionEvents_succ {L : Type} (bindings : Bindings L)
    (boundscheck : Bool) (bc original : Value L) (values : Nat → Value L)
    (methods : Nat → Method) (depth : Nat) :
    conversionEvents bindings boundscheck bc original values methods (depth + 1) =
      conversionEvents bindings boundscheck bc original values methods depth ++
        blockEvents bindings boundscheck bc original values methods depth := by
  simp only [conversionEvents, blockEvents, List.range_succ, List.flatMap_append,
    List.flatMap_cons, List.flatMap_nil, List.append_nil]

theorem conversionEvents_length {L : Type} (bindings : Bindings L)
    (boundscheck : Bool) (bc original : Value L) (values : Nat → Value L)
    (methods : Nat → Method) (depth : Nat) :
    (conversionEvents bindings boundscheck bc original values methods depth).length =
      3 * depth := by
  induction depth with
  | zero => rfl
  | succ depth ih =>
    rw [conversionEvents_succ, List.length_append, ih]
    simp only [blockEvents, List.length_cons, List.length_nil]
    omega

def payloadAt {W : Type} (initial : W) (worlds : Nat → W) : Nat → W
  | 0 => initial
  | depth + 1 => worlds (3 * (depth + 1) - 1)

theorem run_conversion_prefix {W L : Type}
    (core : Bool → CoreOps (World W L) L)
    (select : Value L → Value L → Value L → W → Method)
    (bindings : Bindings L) (style bc original : Value L) (boundscheck : Bool)
    (values : Nat → Value L) (worlds : Nat → W) (methods : Nat → Method)
    (coherent : ∀ depth, methods (depth + 1) =
      select style bc (values (3 * depth + 2)) (worlds (3 * depth + 2)))
    (initial : W) (history : List (ContextEvent L)) (suffix : List (Reply W L))
    (depth : Nat)
    (nonterminal : ∀ step, step < depth → isTerminal (methods step) = false) :
    runMethod (observingDispatch core select) bindings (methods 0)
      style bc original boundscheck
      ⟨initial, successes (3 * depth) values worlds ++ suffix, history⟩ =
    runMethod (observingDispatch core select) bindings (methods depth)
      style bc (indexAt original values depth) boundscheck
      ⟨payloadAt initial worlds depth, suffix,
        history ++ conversionEvents bindings boundscheck bc original values methods depth⟩ := by
  revert nonterminal
  induction depth generalizing suffix with
  | zero =>
    intro nonterminal
    simp only [Nat.mul_zero, successes, List.range_zero, List.map_nil, List.nil_append,
      payloadAt, indexAt, conversionEvents, List.flatMap_nil, List.append_nil]
  | succ depth ih =>
    intro nonterminal
    have countEq : 3 * (depth + 1) = 3 * depth + 3 := by omega
    have lastEq : 3 * (depth + 1) - 1 = 3 * depth + 2 := by omega
    rw [countEq, successes_add, List.append_assoc]
    rw [ih (suffix := successes 3 (fun i => values (3 * depth + i))
      (fun i => worlds (3 * depth + i)) ++ suffix)
      (fun step h => nonterminal step (by omega))]
    have selectedNonterminal := nonterminal depth (by omega)
    cases selected : methods depth with
    | generic => simp only [selected, isTerminal, Bool.true_eq_false] at selectedNonterminal
    | custom => simp only [selected, isTerminal, Bool.true_eq_false] at selectedNonterminal
    | cartesianInteger =>
      rw [runMethod.eq_def]
      simp only [selected, observingDispatch, observingContexts, successes_three,
        List.cons_append, List.nil_append, bind_apply, observe, coherent,
        conversionEvents_succ, blockEvents, indexAt, payloadAt, lastEq,
        Nat.add_zero, call, List.append_assoc]
    | linearCartesian =>
      rw [runMethod.eq_def]
      simp only [selected, observingDispatch, observingContexts, successes_three,
        List.cons_append, List.nil_append, bind_apply, observe, coherent,
        conversionEvents_succ, blockEvents, indexAt, payloadAt, lastEq,
        Nat.add_zero, call, List.append_assoc]


theorem take_full {A : Type} (items : List A) (count : Nat)
    (bound : items.length ≤ count) : items.take count = items := by
  induction items generalizing count with
  | nil => simp only [List.take_nil]
  | cons head tail ih =>
    cases count with
    | zero => simp only [List.length_cons] at bound; omega
    | succ count =>
      have tailBound : tail.length ≤ count := by
        simp only [List.length_cons] at bound
        omega
      change head :: tail.take count = head :: tail
      rw [ih count tailBound]

theorem successes_take {W L : Type} (count preCount : Nat)
    (values : Nat → Value L) (worlds : Nat → W) (bound : preCount ≤ count) :
    (successes count values worlds).take preCount = successes preCount values worlds := by
  unfold successes
  rw [← List.map_take, List.take_range, Nat.min_eq_left bound]

theorem conversionEvents_take_blocks {L : Type} (bindings : Bindings L)
    (boundscheck : Bool) (bc original : Value L) (values : Nat → Value L)
    (methods : Nat → Method) (depth preCount : Nat) (bound : preCount ≤ depth) :
    (conversionEvents bindings boundscheck bc original values methods depth).take (3 * preCount) =
      conversionEvents bindings boundscheck bc original values methods preCount := by
  revert preCount
  induction depth with
  | zero =>
    intro preCount bound
    have hp : preCount = 0 := by omega
    subst preCount
    rfl
  | succ depth ih =>
    intro preCount bound
    by_cases earlier : preCount ≤ depth
    · rw [conversionEvents_succ, List.take_append, conversionEvents_length]
      have noTail : 3 * preCount - 3 * depth = 0 := by omega
      rw [noTail, List.take_zero, List.append_nil, ih preCount earlier]
    · have last : preCount = depth + 1 := by omega
      subst preCount
      exact take_full _ _ (by rw [conversionEvents_length]; omega)

theorem conversionEvents_take_with_tail {L : Type} (bindings : Bindings L)
    (boundscheck : Bool) (bc original : Value L) (values : Nat → Value L)
    (methods : Nat → Method) (depth preCount : Nat) (tail : List (ContextEvent L))
    (bound : preCount ≤ depth) :
    (conversionEvents bindings boundscheck bc original values methods depth ++ tail).take
      (3 * preCount) = conversionEvents bindings boundscheck bc original values methods preCount := by
  rw [List.take_append, conversionEvents_length]
  have noTail : 3 * preCount - 3 * depth = 0 := by omega
  rw [noTail, List.take_zero, List.append_nil,
    conversionEvents_take_blocks bindings boundscheck bc original values methods depth preCount bound]

theorem conversionEvents_take_inside {L : Type} (bindings : Bindings L)
    (boundscheck : Bool) (bc original : Value L) (values : Nat → Value L)
    (methods : Nat → Method) (depth step offset : Nat) (tail : List (ContextEvent L))
    (stepBound : step < depth) (offsetBound : offset < 3) :
    (conversionEvents bindings boundscheck bc original values methods depth ++ tail).take
      (3 * step + offset + 1) =
      conversionEvents bindings boundscheck bc original values methods step ++
        (blockEvents bindings boundscheck bc original values methods step).take (offset + 1) := by
  have within : 3 * step + offset + 1 ≤ 3 * (step + 1) := by omega
  have firstBlocks := conversionEvents_take_with_tail bindings boundscheck bc original
    values methods depth (step + 1) tail (by omega)
  have firstPart := congrArg (fun events : List (ContextEvent L) =>
    events.take (3 * step + offset + 1)) firstBlocks
  simp only [List.take_take, Nat.min_eq_left within, Nat.min_eq_right within] at firstPart
  rw [firstPart, conversionEvents_succ, List.take_append, conversionEvents_length]
  have allPrevious :
      (conversionEvents bindings boundscheck bc original values methods step).take
        (3 * step + offset + 1) =
      conversionEvents bindings boundscheck bc original values methods step :=
    take_full _ _ (by rw [conversionEvents_length]; omega)
  have remaining : 3 * step + offset + 1 - 3 * step = offset + 1 := by omega
  rw [allPrevious, remaining]

