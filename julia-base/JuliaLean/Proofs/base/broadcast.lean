open JuliaLean.Proofs.base.broadcast.Models2Group5.BroadcastEvaluation
open JuliaLean.Proofs.base.broadcast.Models2Group5.IndexAccess.ContextObservations
open JuliaLean.Proofs.base.broadcast.Models2Group5.ForwardObservations (Reply)
open ConversionProofs (successes_add successes_take take_full)
open SecondDescentProofs
open SecondUnwindProofs (terminal_stack_returns terminal_stack_spec replies_successes)

def tailEvents {W L : Type} (core : Bool → CoreOps (World W L) L)
    (select : Value L → Value L → W → ElementMethod L) (bindings : Bindings L)
    (originalType original index : Value L) (boundscheck : Bool)
    (values : Nat → Value L) (worlds : Nat → W) (frames : Nat) : List (ContextEvent L) :=
  [call boundscheck bindings.broadcastGetindex [values (2 * frames - 1), index]] ++
    unwindEvents (core boundscheck) bindings select originalType original index boundscheck values worlds frames

theorem descentEvents_take_tail {W L : Type} (core : Bool → CoreOps (World W L) L)
    (bindings : Bindings L) (original : Value L) (boundscheck : Bool)
    (values : Nat → Value L) (frames offset : Nat) (tail : List (ContextEvent L)) :
    (descentEvents (core boundscheck) bindings original boundscheck values frames ++ tail).take
      (2 * frames + offset + 1) =
      descentEvents (core boundscheck) bindings original boundscheck values frames ++ tail.take (offset + 1) := by
  rw [List.take_append, descentEvents_length]
  have first : (descentEvents (core boundscheck) bindings original boundscheck values frames).take
      (2 * frames + offset + 1) = descentEvents (core boundscheck) bindings original boundscheck values frames :=
    take_full _ _ (by rw [descentEvents_length]; omega)
  have remaining : 2 * frames + offset + 1 - 2 * frames = offset + 1 := by omega
  rw [first, remaining]

theorem terminal_window {W L : Type} (core : Bool → CoreOps (World W L) L)
    (select : Value L → Value L → W → ElementMethod L) (bindings : Bindings L)
    (originalType original index : Value L) (boundscheck : Bool)
    (values : Nat → Value L) (worlds : Nat → W) (initial : W)
    (history : List (ContextEvent L)) (suffix : List (Reply W L)) (depth : Nat)
    (nonterminal : ∀ step, step < depth →
      isOther (select (values (2 * step + 1)) index (worlds (2 * step + 1))) = false)
    (terminal : isOther (select (values (2 * depth + 1)) index (worlds (2 * depth + 1))) = true) :
    ReturnsLast
      (secondType (observingSecond core select) bindings originalType original index boundscheck)
      (8 * (depth + 1) + 1) values worlds
      (descentEvents (core boundscheck) bindings original boundscheck values (depth + 1) ++
        tailEvents core select bindings originalType original index boundscheck values worlds (depth + 1))
      initial history suffix := by
  let frames := depth + 1
  let tail := tailEvents core select bindings originalType original index boundscheck values worlds frames
  have countEq : 8 * frames + 1 = 2 * frames + (6 * frames + 1) := by omega
  have shiftedLast : 2 * frames + (6 * frames + 1 - 1) = 8 * frames := by omega
  have lastEq : 8 * frames + 1 - 1 = 8 * frames := by omega
  have completed := terminal_stack_returns core select bindings originalType original index boundscheck
    values worlds frames (payloadAt initial worlds frames)
    (history ++ descentEvents (core boundscheck) bindings original boundscheck values frames) suffix
  have specification := terminal_stack_spec core select bindings originalType original index boundscheck
    values worlds frames (payloadAt initial worlds frames)
  have tailLength : tail.length = 6 * frames + 1 := completed.2.1
  change ReturnsLast _ (8 * frames + 1) values worlds
    (descentEvents (core boundscheck) bindings original boundscheck values frames ++ tail) initial history suffix
  unfold ReturnsLast FailurePrefixes
  refine ⟨by omega, ?_, ?_, ?_, ?_⟩
  · rw [List.length_append, descentEvents_length, tailLength]
    omega
  · rw [countEq, successes_add, List.append_assoc]
    rw [run_terminal_descent core select bindings originalType original index boundscheck
      values worlds initial history
      (successes (6 * frames + 1) (fun i => values (2 * frames + i))
        (fun i => worlds (2 * frames + i)) ++ suffix) depth nonterminal terminal]
    have returned := completed.2.2.1
    have expandedLast : 2 * frames + (6 * frames + 1) - 1 = 8 * frames := by omega
    simpa only [shiftedLast, expandedLast, List.append_assoc, tail, tailEvents, frames] using returned
  · intro position error failureWorld
    have bound : position.val < 8 * frames + 1 := by
      simpa only [successes, List.length_map, List.length_range] using position.isLt
    rw [successes_take (8 * frames + 1) position.val values worlds (Nat.le_of_lt bound)]
    by_cases early : position.val < 2 * frames
    · simpa only [List.cons_append, List.nil_append, List.append_assoc] using
        run_descent_throw core select bindings originalType original index boundscheck values worlds
          initial history ((successes (8 * frames + 1) values worlds).drop (position.val + 1) ++ suffix)
          frames position.val tail error failureWorld
          (fun step h => nonterminal step (by dsimp [frames] at h; omega)) early
    · let remaining := (successes (8 * frames + 1) values worlds).drop (position.val + 1) ++ suffix
      simp only [List.append_assoc]
      change secondType (observingSecond core select) bindings originalType original index boundscheck
        ⟨initial, successes position.val values worlds ++ (.thrown error failureWorld :: remaining), history⟩ = _
      let offset := position.val - 2 * frames
      have positionEq : position.val = 2 * frames + offset := by dsimp [offset]; omega
      have offsetBound : offset < tail.length := by rw [tailLength]; dsimp [offset]; omega
      rw [positionEq, successes_add]
      simp only [List.append_assoc]
      rw [run_terminal_descent core select bindings originalType original index boundscheck
        values worlds initial history
        (successes offset (fun i => values (2 * frames + i)) (fun i => worlds (2 * frames + i)) ++
          (.thrown error failureWorld :: remaining)) depth nonterminal terminal]
      rw [descentEvents_take_tail]
      have failed := specification.2.1 offset offsetBound error failureWorld
        (history ++ descentEvents (core boundscheck) bindings original boundscheck values frames) remaining
      simpa only [replies_successes, List.append_assoc, tail, tailEvents, remaining, positionEq, frames] using failed
  · intro position
    have bound : position.val < 8 * frames + 1 := by
      simpa only [successes, List.length_map, List.length_range] using position.isLt
    rw [successes_take (8 * frames + 1) position.val values worlds (Nat.le_of_lt bound)]
    by_cases early : position.val < 2 * frames
    · simpa only [List.cons_append, List.nil_append, List.append_assoc] using
        run_descent_diverge core select bindings originalType original index boundscheck values worlds
          initial history ((successes (8 * frames + 1) values worlds).drop (position.val + 1) ++ suffix)
          frames position.val (fun step h => nonterminal step (by dsimp [frames] at h; omega)) early
    · let remaining := (successes (8 * frames + 1) values worlds).drop (position.val + 1) ++ suffix
      simp only [List.append_assoc]
      change secondType (observingSecond core select) bindings originalType original index boundscheck
        ⟨initial, successes position.val values worlds ++ (.diverged :: remaining), history⟩ = none
      let offset := position.val - 2 * frames
      have positionEq : position.val = 2 * frames + offset := by dsimp [offset]; omega
      have offsetBound : offset < tail.length := by rw [tailLength]; dsimp [offset]; omega
      rw [positionEq, successes_add]
      simp only [List.append_assoc]
      rw [run_terminal_descent core select bindings originalType original index boundscheck
        values worlds initial history
        (successes offset (fun i => values (2 * frames + i)) (fun i => worlds (2 * frames + i)) ++
          (.diverged :: remaining)) depth nonterminal terminal]
      have diverged := specification.2.2 offset offsetBound
        (history ++ descentEvents (core boundscheck) bindings original boundscheck values frames) remaining
      simpa only [replies_successes] using diverged

end SecondTerminalProofs
end EvaluationProofs

