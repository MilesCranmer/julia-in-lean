open JuliaLean.base.broadcast.Models2Group5.NewIndex
open JuliaLean.Proofs.base.broadcast.Models2Group5.ForwardObservations

/-- The generic Cartesian route respects actual rank-dependent property
selection: canonical fallback projects I, while a selected extension invokes
the original getter. The exact result goes with keep/default to the remapper,
then to_index receives that exact remapped value. No forced CartesianIndex
result or native coordinate conversion is introduced. Every getter/callee
preserves its arbitrary exceptions, divergence and worlds.
Source: base/broadcast.jl:593; base/multidimensional.jl:75-78;
base/Base_compiler.jl:59. -/
def CartesianRuntimeProtocol : Prop :=
  ∀ {W L : Type} (bindings : Bindings L) (index keep defaults : Value L)
      (select : Value L → W → CartesianPropertyMethod),
    ReturnsLastAfter (W := W) (L := L) 2
      (fun core => cartesian
        { toCoreOps := core
          selectedIndexProperty := fun value world => select value world.payload }
        bindings index keep defaults)
      (fun _ values _ initial =>
        [(match select index initial with
          | .builtin => .getfield index (.symbol "I")
          | .custom => .call bindings.getproperty [index, .symbol "I"]),
         .call bindings.remap [values 0, keep, defaults],
         .call bindings.toIndex [values 1]])

/-- The rank-one Cartesian specialization uses concrete stored fields and
passes the original coordinate value to newindex, without an Int conversion
or an open getter for the fixed CartesianIndex{1}/Tuple{Int64} types. The
actual keep/default-dependent newindex result, errors and effects are retained.
Source: base/broadcast.jl:594; base/Base_compiler.jl:59; base/tuple.jl:33. -/
def CartesianOneRuntimeProtocol : Prop :=
  ∀ {W L : Type} (bindings : Bindings L) (index keep defaults : Value L),
    ReturnsLastAfter (W := W) (L := L) 2
      (fun ops => cartesianOne ops bindings index keep defaults)
      (fun ops values _ _ =>
        [.getfield index (.symbol "I"),
         .getfield (values 0) (JuliaLean.base.boot.intV ops (JInt.lit .i64 1)),
         .call bindings.newIndex [values 1, keep, defaults]])

/-- Proof-side contract for a prescribed finite observation plan. The plan
records source calls and the designated returned identity, not an alternative
implementation. All boundary values/worlds are arbitrary; every failing or
diverging position is tested, and unused replies detect extra effects. -/
def FollowsPlan {W L : Type} (action : CoreM (ProbeWorld W L) L (Value L))
    (values : Nat → Value L) (worlds : Nat → W) (initial : W)
    (history : List (Event L)) (suffix : List (Reply W L))
    (events : List (Event L)) (returned : Value L) : Prop :=
  let count := events.length
  let successful : List (Reply W L) :=
    (List.range count).map (fun position => .returned (values position) (worlds position))
  let before : ProbeWorld W L := ⟨initial, successful ++ suffix, history⟩
  let after : ProbeWorld W L :=
    ⟨worlds (count - 1), suffix, history ++ events⟩
  0 < count ∧ action before = some (.ok (returned, after)) ∧
  (∀ (position : Fin count) (error : Value L) (failureWorld : W),
    let remaining := successful.drop (position.val + 1) ++ suffix
    let failed : ProbeWorld W L :=
      ⟨initial, successful.take position.val ++ [.thrown error failureWorld] ++ remaining,
        history⟩
    action failed = some (.error
      (error, ⟨failureWorld, remaining, history ++ events.take (position.val + 1)⟩))) ∧
  (∀ position : Fin count,
    let diverging : ProbeWorld W L :=
      ⟨initial, successful.take position.val ++ [.diverged] ++
        successful.drop (position.val + 1) ++ suffix, history⟩
    action diverging = none)

/-- Failures before an ifelse call cannot be replaced by the later dispatch
failure, a constructor, or a silently selected branch. This is observation
support; no source callee is supplied to the model by this predicate. -/
def PrefixFailures {W L : Type} (action : CoreM (ProbeWorld W L) L (Value L))
    (values : Nat → Value L) (worlds : Nat → W) (initial : W)
    (history : List (Event L)) (suffix : List (Reply W L))
    (events : List (Event L)) : Prop :=
  let count := events.length
  let successful : List (Reply W L) :=
    (List.range count).map (fun position => .returned (values position) (worlds position))
  (∀ (position : Fin count) (error : Value L) (failureWorld : W),
    let remaining := successful.drop (position.val + 1) ++ suffix
    let failed : ProbeWorld W L :=
      ⟨initial, successful.take position.val ++ [.thrown error failureWorld] ++ remaining,
        history⟩
    action failed = some (.error
      (error, ⟨failureWorld, remaining, history ++ events.take (position.val + 1)⟩))) ∧
  (∀ position : Fin count,
    let diverging : ProbeWorld W L :=
      ⟨initial, successful.take position.val ++ [.diverged] ++
        successful.drop (position.val + 1) ++ suffix, history⟩
    action diverging = none)

/-- A failed Base.ifelse dispatch must report MethodError with the actual
function, eager operand values and native world age. It cannot return a value
or substitute the Boolean-context/Core.ifelse TypeError. If the installed
runtime world-age primitive itself fails or diverges, its outcome survives.
The predicate observes the existing primitive, not a law asserting it is
correct or successful. All previously observed calls remain in the world. -/
def MissingDispatchReported {W L : Type} (core : CoreOps (ProbeWorld W L) L)
    (function condition first second : Value L) (before : ProbeWorld W L)
    (result : Option (Except (Value L × ProbeWorld W L)
      (Value L × ProbeWorld W L))) : Prop :=
  match core.worldAge before, result with
  | none, none => True
  | some (.error (error, world)), some (.error (actualError, actualWorld)) =>
      actualError = error ∧ actualWorld = world
  | some (.ok (age, world)), some (.error (actualError, actualWorld)) =>
      actualError = JuliaLean.base.boot.objV core (.methodError function
        (JuliaLean.base.boot.tupleV core [condition, first, second])
        (JuliaLean.base.boot.intV core age)) ∧ actualWorld = world
  | _, _ => False

/-- Full source595 argument/effect protocol. The first keep read precedes both
Int conversions and the mandatory first default read. Only after all four
operations can Base.ifelse be selected. Canonical Bool selection preserves the
appropriate converted value; a selected custom method can return anything.
The second default is read only after that call returns, and the original
CartesianIndex binding receives exactly two arguments. A missing ifelse method
raises MethodError after both conversions, with no second default read.
Every input and metadata selector, callback result, error and world is arbitrary;
no Integer-conversion, default-indexing or constructor correctness law is used.
Source: base/broadcast.jl:595; base/essentials.jl:880-894. -/
def IntegerManyRuntimeProtocol : Prop :=
  ∀ {W L : Type} (core : CoreOps (ProbeWorld W L) L)
      (selectIf : Value L → Value L → Value L → W → IfElseMethod)
      (selectKeep : Value L → JInt .i64 → W → TupleGetMethod)
      (bindings : Bindings L) (index keep defaults : Value L)
      (values : Nat → Value L) (worlds : Nat → W) (initial : W)
      (history : List (Event L)) (suffix : List (Reply W L)),
    let one := JuliaLean.base.boot.intV core (JInt.lit .i64 1)
    let two := JuliaLean.base.boot.intV core (JInt.lit .i64 2)
    let keepEvent : Event L := match selectKeep keep (JInt.lit .i64 1) initial with
      | .builtin => .getfield keep one
      | .custom => .call bindings.getindex [keep, one]
    let priorReplies : List (Event L) :=
      [keepEvent, .call bindings.intConstructor [index],
       .call bindings.getindex [defaults, one], .call bindings.intConstructor [values 2]]
    let ops : IntegerOps (ProbeWorld W L) L :=
      { toOps :=
          { toCoreOps := observingOps core
            selectedIfElse := fun condition first second world =>
              selectIf condition first second world.payload }
        selectedKeepGet := fun tuple position world => selectKeep tuple position world.payload }
    let action := integerMany ops bindings index keep defaults
    match selectIf (values 0) (values 1) (values 3) (worlds 3) with
    | .boolean flag =>
        FollowsPlan action values worlds initial history suffix
          (priorReplies ++ [.call bindings.getindex [defaults, two],
            .call bindings.cartesianIndex
              [if flag then values 1 else values 3, values 4]])
          (values 5)
    | .custom =>
        FollowsPlan action values worlds initial history suffix
          (priorReplies ++ [.call bindings.ifElse [values 0, values 1, values 3],
            .call bindings.getindex [defaults, two],
            .call bindings.cartesianIndex [values 4, values 5]])
          (values 6)
    | .missing =>
        let successful : List (Reply W L) :=
          (List.range 4).map (fun position => .returned (values position) (worlds position))
        let before : ProbeWorld W L := ⟨initial, successful ++ suffix, history⟩
        let atIfElse : ProbeWorld W L := ⟨worlds 3, suffix, history ++ priorReplies⟩
        MissingDispatchReported core bindings.ifElse (values 0) (values 1) (values 3)
          atIfElse (action before) ∧
        PrefixFailures action values worlds initial history suffix priorReplies

/-- Full source596 protocol. The fixed keep tuple is read through its concrete
field, and the default getter always runs before selection, including true keep.
Canonical Bool selection returns the original index or exact default object
without converting either. A selected custom ifelse may return any value; a
missing method is reported only after the eager read. All effects, exceptions
and divergence retain their position and world. These observations also reject
extra Int conversion, default copying, or a getter callback for fixed keep.
Source: base/broadcast.jl:596; base/tuple.jl:33; base/essentials.jl:880-894. -/
def IntegerOneRuntimeProtocol : Prop :=
  ∀ {W L : Type} (core : CoreOps (ProbeWorld W L) L)
      (selectIf : Value L → Value L → Value L → W → IfElseMethod)
      (bindings : Bindings L) (index keep defaults : Value L)
      (values : Nat → Value L) (worlds : Nat → W) (initial : W)
      (history : List (Event L)) (suffix : List (Reply W L)),
    let one := JuliaLean.base.boot.intV core (JInt.lit .i64 1)
    let priorReplies : List (Event L) :=
      [.getfield keep one, .call bindings.getindex [defaults, one]]
    let ops : Ops (ProbeWorld W L) L :=
      { toCoreOps := observingOps core
        selectedIfElse := fun condition first second world =>
          selectIf condition first second world.payload }
    let action := integerOne ops bindings index keep defaults
    match selectIf (values 0) index (values 1) (worlds 1) with
    | .boolean flag =>
        FollowsPlan action values worlds initial history suffix priorReplies
          (if flag then index else values 1)
    | .custom =>
        FollowsPlan action values worlds initial history suffix
          (priorReplies ++ [.call bindings.ifElse [values 0, index, values 1]]) (values 2)
    | .missing =>
        let successful : List (Reply W L) :=
          [.returned (values 0) (worlds 0), .returned (values 1) (worlds 1)]
        let before : ProbeWorld W L := ⟨initial, successful ++ suffix, history⟩
        let atIfElse : ProbeWorld W L := ⟨worlds 1, suffix, history ++ priorReplies⟩
        MissingDispatchReported core bindings.ifElse (values 0) index (values 1)
          atIfElse (action before) ∧
        PrefixFailures action values worlds initial history suffix priorReplies

