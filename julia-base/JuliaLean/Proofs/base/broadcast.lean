/-- Full-domain field/map/constructor provenance for source1109. The map
receives the actual global recursive function object; axes is read afterward,
and every arbitrary result, effect, error and divergence stays in source order. -/
def PreserveRuntime : Prop :=
  ∀ {W L : Type} (bindings : Bindings L) (bc : Value L),
    ReturnsLastAfter (W := W) (L := L) 5
      (fun core => preserve core bindings bc)
      (fun _ values _ _ =>
        [.call bindings.getproperty [bc, .symbol "style"],
         .call bindings.getproperty [bc, .symbol "f"],
         .call bindings.getproperty [bc, .symbol "args"],
         .call bindings.map [bindings.liftfuncs, values 2],
         .call bindings.getproperty [bc, .symbol "axes"],
         .call bindings.broadcasted [values 0, values 1, values 3, values 4]])

/-- Full-domain source1110 invariant. The replacement value is forwarded by
identity and bc.f is never read. All map/constructor outcomes remain arbitrary. -/
def ReplaceRuntime : Prop :=
  ∀ {W L : Type} (bindings : Bindings L) (bc function : Value L),
    ReturnsLastAfter (W := W) (L := L) 4
      (fun core => replace core bindings bc function)
      (fun _ values _ _ =>
        [.call bindings.getproperty [bc, .symbol "style"],
         .call bindings.getproperty [bc, .symbol "args"],
         .call bindings.map [bindings.liftfuncs, values 1],
         .call bindings.getproperty [bc, .symbol "axes"],
         .call bindings.broadcasted [values 0, function, values 2, values 3]])

/-- Every unary call completes f/args/chunkop before selecting its next method,
including arbitrary metadata and worlds; failure in that prefix suppresses
all later work. The following independent path grammar observes both real
Base continuations and the custom target, including all later failures.
Source: base/broadcast.jl:1108-1110. -/
def WrapperRuntime : Prop :=
  (∀ {W L : Type} (core : CoreOps (ProbeWorld W L) L)
      (select : Value L → Value L → W → Method) (bindings : Bindings L) (bc : Value L)
      (values : Nat → Value L) (worlds : Nat → W) (initial : W)
      (history : List (Event L)) (suffix : List (Reply W L)),
    let ops : Ops (ProbeWorld W L) L :=
      { toCoreOps := observingOps core,
        selectedLift := fun bc value world => select bc value world.payload }
    PrefixFailures (wrapper ops bindings bc) values worlds initial history suffix
      [.call bindings.getproperty [bc, .symbol "f"],
       .call bindings.getproperty [bc, .symbol "args"],
       .call bindings.chunkop [values 0, values 1]]) ∧
  (∀ {W L : Type} (core : CoreOps (ProbeWorld W L) L)
      (method : Method) (bindings : Bindings L) (bc : Value L)
      (values : Nat → Value L) (worlds : Nat → W) (initial : W)
      (history : List (Event L)) (suffix : List (Reply W L)),
    let ops : Ops (ProbeWorld W L) L :=
      { toCoreOps := observingOps core, selectedLift := fun _ _ _ => method }
    let priorReplies : List (Event L) :=
      [.call bindings.getproperty [bc, .symbol "f"],
       .call bindings.getproperty [bc, .symbol "args"],
       .call bindings.chunkop [values 0, values 1]]
    let continuation : List (Event L) := match method with
      | .preserve =>
          [.call bindings.getproperty [bc, .symbol "style"],
           .call bindings.getproperty [bc, .symbol "f"],
           .call bindings.getproperty [bc, .symbol "args"],
           .call bindings.map [bindings.liftfuncs, values 5],
           .call bindings.getproperty [bc, .symbol "axes"],
           .call bindings.broadcasted [values 3, values 4, values 6, values 7]]
      | .replace =>
          [.call bindings.getproperty [bc, .symbol "style"],
           .call bindings.getproperty [bc, .symbol "args"],
           .call bindings.map [bindings.liftfuncs, values 4],
           .call bindings.getproperty [bc, .symbol "axes"],
           .call bindings.broadcasted [values 3, values 2, values 5, values 6]]
      | .custom => [.call bindings.liftfuncs [bc, values 2]]
    FollowsPlan (wrapper ops bindings bc) values worlds initial history suffix
      (priorReplies ++ continuation) (values (2 + continuation.length)))

