/-- Complete two-argument callable behavior for all three generated
identities, independent of what custom map chooses to pass. These are
arbitrary values, not just native offsets/ranges. The actual callable's
invoke operation is tested, not a separately supplied scalar evaluator.
Source: base/broadcast.jl:1245,1249,1252. -/
def ClosureBinaryContracts : Prop :=
  ∀ {W L : Type} (bindings : Bindings L) (name : ClosureName)
      (args : JuliaLean.base.broadcast.Models2Group5.Constructors.ArgumentTuple L),
    match args.values with
    | [left, right] =>
        match name with
        | .plus =>
            ReturnsLastAfter (W := W) (L := L) 1
              (fun core => (closure
                (JuliaLean.Proofs.base.broadcast.Models2Group5.RangeRuntime.observingRange
                  core bindings.toBindings) bindings name).invoke args)
              (fun _ values _ _ =>
                [.call bindings.broadcasted [bindings.add, left, right],
                 .call bindings.materialize [values 0]])
        | .minus =>
            ReturnsLastAfter (W := W) (L := L) 1
              (fun core => (closure
                (JuliaLean.Proofs.base.broadcast.Models2Group5.RangeRuntime.observingRange
                  core bindings.toBindings) bindings name).invoke args)
              (fun _ values _ _ =>
                [.call bindings.broadcasted [bindings.subtract, left, right],
                 .call bindings.materialize [values 0]])
        | .difference =>
            ReturnsLastAfter (W := W) (L := L) 4
              (fun core => (closure
                (JuliaLean.Proofs.base.broadcast.Models2Group5.RangeRuntime.observingRange
                  core bindings.toBindings) bindings name).invoke args)
              (fun _ values _ _ =>
                [.call bindings.last [right],
                 .call bindings.subtract [left, values 0],
                 .call bindings.length [right],
                 .call bindings.step [right],
                 .keywordCall bindings.range [values 1]
                   [("length", values 2), ("step", values 3)]])
    | _ => True

/-- Native-bounded wrong-arity calls fail with the actual generated function
identity, entire original argument tuple and current world age. The runtime
primitive's own failure or divergence is preserved. Identity is stable for
each source singleton; no user captures or payload copies are introduced.
Correct binary calls are covered by ClosureBinaryContracts rather than a
precondition excluding wrong arity from the callable domain. -/
def ClosureArityAndIdentity : Prop :=
  ∀ {W L : Type} (ops : JuliaLean.base.broadcast.Models2Group5.RangeRuntime.Ops W L)
      (bindings : Bindings L) (name : ClosureName)
      (args : JuliaLean.base.broadcast.Models2Group5.Constructors.ArgumentTuple L)
      (world : W),
    let function := closure ops bindings name
    function.name = name ∧ function.value = bindings.closureValue name ∧
      match args.values with
      | [_, _] => True
      | _ =>
          match ops.worldAge world with
          | none => function.invoke args world = none
          | some (.error (error, after)) =>
              function.invoke args world = some (.error (error, after))
          | some (.ok (age, after)) =>
              function.invoke args world = some (.error
                (JuliaLean.base.boot.objV ops.toCoreOps (.methodError
                  (bindings.closureValue name)
                  (JuliaLean.base.boot.tupleV ops.toCoreOps args.values)
                  (JuliaLean.base.boot.intV ops.toCoreOps age)), after))

/-- Registered dependency contract for actual callable identity, execution
and all invocation arities, used by the three Cartesian map callers. -/
def ClosureContract : Prop := ClosureBinaryContracts ∧ ClosureArityAndIdentity

private theorem closureBinaryContracts : ClosureBinaryContracts := by
  intro W L bindings name args
  rcases args with ⟨arguments, bound⟩
  cases arguments with
  | nil => trivial
  | cons left tail =>
    cases tail with
    | nil => trivial
    | cons right tail =>
      cases tail with
      | cons third rest => trivial
      | nil =>
        cases name <;>
          simp [ReturnsLastAfter, successfulReplies, List.ofFn_succ, List.ofFn_zero,
            Fin.forall_fin_succ, closure, plusBody, minusBody, differenceBody,
            JuliaLean.Proofs.base.broadcast.Models2Group5.RangeRuntime.observingRange,
            observingOps, observe, Bind.bind, List.append_assoc]
private theorem closureArityAndIdentity : ClosureArityAndIdentity := by
  intro W L ops bindings name args world
  refine ⟨rfl, rfl, ?_⟩
  rcases args with ⟨arguments, bound⟩
  cases arguments with
  | nil =>
      cases h : ops.worldAge world with
      | none => simp [closure, h, Bind.bind]
      | some outcome => cases outcome <;>
          simp [closure, h, Bind.bind, JuliaLean.base.boot.throwObj] <;> rfl
  | cons left tail =>
    cases tail with
    | nil =>
      cases h : ops.worldAge world with
      | none => simp [closure, h, Bind.bind]
      | some outcome => cases outcome <;>
          simp [closure, h, Bind.bind, JuliaLean.base.boot.throwObj] <;> rfl
    | cons right tail =>
      cases tail with
      | nil => trivial
      | cons third rest =>
        cases h : ops.worldAge world with
        | none => simp [closure, h, Bind.bind]
        | some outcome => cases outcome <;>
            simp [closure, h, Bind.bind, JuliaLean.base.boot.throwObj] <;> rfl
theorem closureContract : ClosureContract := ⟨closureBinaryContracts, closureArityAndIdentity⟩

