    statement := "Generic dotview forwards the exact original native-sized heterogeneous argument tuple to maybeview once, preserving its propagated bounds context and complete result/error/world/divergence outcome.",
    source := "base/broadcast.jl:1297; doc/src/devdocs/boundscheck.md:70-79",
    status := .proven,
    prop := ``JuliaLean.Proofs.base.broadcast.Models2Group5.SyntaxBoundary.RuntimeContract,
