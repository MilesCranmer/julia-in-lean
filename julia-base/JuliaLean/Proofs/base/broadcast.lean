namespace JuliaLean.Proofs.base.broadcast.Models2Group5.Remap

open JuliaLean
open JuliaLean.Registry
open JuliaLean.base.expr (Value)
open JuliaLean.base.boot (CoreOps)
open JuliaLean.base.broadcast.Models2Group5.Remap
open JuliaLean.Proofs.base.broadcast.Models2Group5.ForwardObservations

/-- Observe existing hooks while leaving all dispatch metadata arbitrary. -/
def observingRemap {W L : Type} (ops : Ops (ProbeWorld W L) L) :
    Ops (ProbeWorld W L) L :=
  { ops with toOps :=
      { ops.toOps with toCoreOps := observingOps ops.toOps.toCoreOps } }

/-- The three eager reads required before any ifelse call, tail evaluation
or recursive dispatch. This is an observation list, not a model body. -/
def firstReads {W L : Type} (ops : CoreOps (ProbeWorld W L) L)
    (bindings : Bindings L) (indices keep defaults : Value L) : List (Event L) :=
  let one := JuliaLean.base.boot.intV ops (JInt.lit .i64 1)
  [.call bindings.getindex [keep, one],
   .call bindings.getindex [indices, one],
   .call bindings.getindex [defaults, one]]

/-- In the complete open-dispatch domain, every failure/divergence in the
first three reads stops at that exact site. Defaults are read even when keep
would select the index; no Bool assumption is needed, because ifelse selection
occurs only after all operands are evaluated. All later operations and their
metadata are arbitrary and unreachable. Exact error identities, worlds,
source-order prefixes and untouched suffixes are retained.
Source: base/broadcast.jl:598-599; essentials.jl:881-894 (eager ifelse). -/
def EagerReadFailures : Prop :=
  ∀ {W L : Type} (ops : Ops (ProbeWorld W L) L) (bindings : Bindings L)
      (indices keep defaults : Value L)
      (values : Fin 3 → Value L) (worlds : Fin 3 → W)
      (initial : W) (history : List (Event L)) (suffix : List (Reply W L)),
    let successful := successfulReplies 2 values worlds
    let prescribed := firstReads ops.toOps.toCoreOps bindings indices keep defaults
    (∀ (position : Fin 3) (error : Value L) (failureWorld : W),
      let remaining := successful.drop (position.val + 1) ++ suffix
      let before : ProbeWorld W L :=
        ⟨initial, successful.take position.val ++ [.thrown error failureWorld] ++ remaining,
          history⟩
      let after : ProbeWorld W L :=
        ⟨failureWorld, remaining, history ++ prescribed.take (position.val + 1)⟩
      remap (observingRemap ops) bindings indices keep defaults before =
        some (.error (error, after))) ∧
    (∀ position : Fin 3,
      let before : ProbeWorld W L :=
        ⟨initial, successful.take position.val ++ [.diverged] ++
          successful.drop (position.val + 1) ++ suffix, history⟩
      remap (observingRemap ops) bindings indices keep defaults before = none)

/-- A genuine custom ifelse and a genuine custom recursive suffix must both
receive their actual arguments at the correct position. The shared helper is
still called; no assumed answer for it is injected into the model. The nine
observations include all eager operands, tail calls and the final tuple splat.
All arbitrary results, errors, divergence and worlds remain in scope.
Source: base/broadcast.jl:598-599. -/
def CustomDispatchContract : Prop :=
  ∀ {W L : Type} (bindings : Bindings L) (indices keep defaults : Value L),
    ReturnsLastAfter (W := W) (L := L) 8
      (fun core =>
        let ops : Ops (ProbeWorld W L) L :=
          { toOps := { toCoreOps := core, selectedIfElse := fun _ _ _ _ => .custom },
            selectedRemap := fun _ _ _ _ => .custom }
        remap ops bindings indices keep defaults)
      (fun core values _ _ =>
        let one := JuliaLean.base.boot.intV core (JInt.lit .i64 1)
        [.call bindings.getindex [keep, one],
         .call bindings.getindex [indices, one],
         .call bindings.getindex [defaults, one],
         .call bindings.ifElse [values 0, values 1, values 2],
         .call bindings.tail [indices],
         .call bindings.tail [keep],
         .call bindings.tail [defaults],
         .call bindings.remap [values 4, values 5, values 6],
         .splat bindings.iterate [JuliaLean.base.boot.coreV core "tuple",
           JuliaLean.base.boot.tupleV core [values 3], values 7]])

/-- Terminal branches for an arbitrary finite chain of actual generic body
executions. This is proof scenario metadata, not a model recursion limit. -/
inductive Terminal where
  | emptyKeep
  | emptyIndex
  | emptyBoth
  | custom

/-- Choose the actual terminal method tag, without evaluating its body. -/
def terminalMethod : Terminal → Method
  | .emptyKeep => .emptyKeep
  | .emptyIndex => .emptyIndex
  | .emptyBoth => .emptyBoth
  | .custom => .custom

/-- Arbitrary observed containers and results at every potential depth. These
functions are proof data, not Julia arrays. No two consecutive containers
need differ: stateful custom tails may reuse the same reference. -/
structure Chain (L : Type) where
  indices : Nat → Value L
  keeps : Nat → Value L
  defaults : Nat → Value L
  conditions : Nat → Value L
  coordinates : Nat → Value L
  fallbackValues : Nat → Value L
  flags : Nat → Bool
  assembled : Nat → Value L
  customTerminal : Value L

/-- Closed-form reply values for a finite recursion trace: six calls per
descending frame, optionally one custom terminal call, then one tuple splat
per frame in reverse order. This does not execute or recursively simulate the
model. frames is observation depth, not a Julia integer or supplied fuel. -/
def chainValues {L : Type} (frames : Nat) (terminal : Terminal)
    (chain : Chain L) : List (Value L) :=
  (List.range frames).flatMap (fun j =>
    [chain.conditions j, chain.coordinates j, chain.fallbackValues j,
     chain.indices (j + 1), chain.keeps (j + 1), chain.defaults (j + 1)]) ++
  (match terminal with | .custom => [chain.customTerminal] | _ => []) ++
  (List.range frames).reverse.map chain.assembled

/-- Every call has an arbitrary returned payload world. The additional Nat
is an observation cursor permitting selected methods to change after effects;
it is never used in the model's Julia arithmetic. -/
def chainReplies {W L : Type} (values : List (Value L)) (worlds : Nat → W) :
    List (Reply (Nat × W) L) :=
  (values.zip (List.range values.length)).map fun (value, index) =>
    .returned value (index + 1, worlds index)

/-- Canonical Bool ifelse at each frame, followed by the selected terminal
after all three final tail calls. The arbitrary CoreOps hooks are observed,
not assumed correct. This uses live world metadata rather than a bounded
recursive model or a parameterized replacement for its body. -/
def chainOps {W L : Type} (ops : CoreOps (ProbeWorld (Nat × W) L) L)
    (frames : Nat) (terminal : Terminal) (flags : Nat → Bool) :
    Ops (ProbeWorld (Nat × W) L) L where
  toOps :=
    { toCoreOps := observingOps ops,
      selectedIfElse := fun _ _ _ world => .boolean (flags (world.payload.1 / 6)) }
  selectedRemap := fun _ _ _ world =>
    if world.payload.1 = 6 * frames then terminalMethod terminal else .generic

/-- Independent, nonrecursive event formula: all descending reads/tails,
then the optional custom terminal, then all ascending splats. This detects
swapped tails, lost defaults, wrong truncation, a premature callback replacing
recursion, wrong selected heads and incorrect suffix assembly.
Source: base/broadcast.jl:598-602. -/
def chainEvents {W L : Type} (ops : CoreOps (ProbeWorld (Nat × W) L) L)
    (bindings : Bindings L) (frames : Nat) (terminal : Terminal)
    (chain : Chain L) : List (Event L) :=
  let one := JuliaLean.base.boot.intV ops (JInt.lit .i64 1)
  let suffix := match terminal with
    | .custom => chain.customTerminal
    | _ => JuliaLean.base.boot.tupleV ops []
  (List.range frames).flatMap (fun j =>
    [.call bindings.getindex [chain.keeps j, one],
     .call bindings.getindex [chain.indices j, one],
     .call bindings.getindex [chain.defaults j, one],
     .call bindings.tail [chain.indices j],
     .call bindings.tail [chain.keeps j],
     .call bindings.tail [chain.defaults j]]) ++
  (match terminal with
   | .custom => [.call bindings.remap
       [chain.indices frames, chain.keeps frames, chain.defaults frames]]
   | _ => []) ++
  (List.range frames).reverse.map (fun j =>
    .splat bindings.iterate [JuliaLean.base.boot.coreV ops "tuple",
      JuliaLean.base.boot.tupleV ops
        [if chain.flags j then chain.coordinates j else chain.fallbackValues j],
      if j + 1 = frames then suffix else chain.assembled (j + 1)])

/-- For every positive finite depth, both Bool values, arbitrary reference
containers/coordinates/defaults, all three Base empty cases and custom
terminal methods, recursion has the independently prescribed descending and
ascending observations and returns the outermost actual splat result. Every
reachable call failure/divergence preserves its prefix and suppresses the
remainder, including all suspended outer splats. The arbitrary suffix rejects
extra evaluations after completion. There is no callee-correctness premise,
Julia-array-size premise, List-domain restriction or model fuel.
Source: base/broadcast.jl:598-602. -/
def FiniteRecursionContract : Prop :=
  ∀ {W L : Type} (ops : CoreOps (ProbeWorld (Nat × W) L) L)
      (bindings : Bindings L) (depth : Nat) (terminal : Terminal) (chain : Chain L)
      (worlds : Nat → W) (initial : W) (history : List (Event L))
      (suffix : List (Reply (Nat × W) L)),
    let frames := depth + 1
    let values := chainValues frames terminal chain
    let successful := chainReplies values worlds
    let prescribed := chainEvents ops bindings frames terminal chain
    let action := remap (chainOps ops frames terminal chain.flags) bindings
      (chain.indices 0) (chain.keeps 0) (chain.defaults 0)
    let before : ProbeWorld (Nat × W) L := ⟨(0, initial), successful ++ suffix, history⟩
    let after : ProbeWorld (Nat × W) L :=
      ⟨(values.length, worlds (values.length - 1)), suffix, history ++ prescribed⟩
    prescribed.length = values.length ∧
    action before = some (.ok (chain.assembled 0, after)) ∧
    (∀ (position : Fin values.length) (error : Value L) (failureWorld : W),
      let remaining := successful.drop (position.val + 1) ++ suffix
      let failureBefore : ProbeWorld (Nat × W) L :=
        ⟨(0, initial), successful.take position.val ++
          [.thrown error (position.val + 1, failureWorld)] ++ remaining, history⟩
      let failureAfter : ProbeWorld (Nat × W) L :=
        ⟨(position.val + 1, failureWorld), remaining,
          history ++ prescribed.take (position.val + 1)⟩
      action failureBefore = some (.error (error, failureAfter))) ∧
    (∀ position : Fin values.length,
      let divergenceBefore : ProbeWorld (Nat × W) L :=
        ⟨(0, initial), successful.take position.val ++ [.diverged] ++
          successful.drop (position.val + 1) ++ suffix, history⟩
      action divergenceBefore = none)

/-- The registered contract includes the full-domain eager-read invariant,
all custom selected ifelse/suffix outcomes, and arbitrary-depth canonical
recursion through every empty/custom terminal. All statements are unproved. -/
def RuntimeContract : Prop :=
  EagerReadFailures ∧ CustomDispatchContract ∧ FiniteRecursionContract

