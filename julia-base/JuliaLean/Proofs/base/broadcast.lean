namespace JuliaLean.Proofs.base.broadcast.Models2Group5.SimdLoop

open JuliaLean
open JuliaLean.Registry
open JuliaLean.base.expr (Value)
open JuliaLean.base.boot (CoreOps CoreM)
open JuliaLean.base.broadcast.Models2Group5.SimdLoop
open JuliaLean.Proofs.base.broadcast.Models2Group5.ForwardObservations
open JuliaLean.Proofs.base.broadcast.Models2Group5.NewIndex (PrefixFailures)

/-- Generic-state entry invariant. The outer range is obtained once before
its initial iterate; exhaustion preserves the entire lexical state without
calling any body, SIMD index, length or numeric operation. Both initial calls
retain every exception/world/divergence, for an arbitrary body computation.
Source: base/simdloop.jl:66-86. -/
def EntryRuntime : Prop :=
  ∀ {W L S : Type} (core : CoreOps (ProbeWorld W L) L) (bindings : Bindings L)
      (range : Value L) (state : S) (body : Value L → S → CoreM (ProbeWorld W L) L S)
      (values : Fin 2 → Value L) (worlds : Fin 2 → W) (initial : W)
      (history : List (Event L)) (suffix : List (Reply W L)),
    let action := fold (observingOps core) bindings range state body
    let successful := successfulReplies 1 values worlds
    let prescribed := [.call bindings.simd_outer_range [range],
      .call bindings.iterate [values 0]]
    let before : ProbeWorld W L := ⟨initial, successful ++ suffix, history⟩
    (if core.same (values 1) (JuliaLean.base.boot.nothingV core) then
      action before = some (.ok (state, ⟨worlds 1, suffix, history ++ prescribed⟩))
    else True) ∧
    (∀ (position : Fin 2) (error : Value L) (failureWorld : W),
      let remaining := successful.drop (position.val + 1) ++ suffix
      let failed : ProbeWorld W L :=
        ⟨initial, successful.take position.val ++ [.thrown error failureWorld] ++ remaining,
          history⟩
      action failed = some (.error
        (error, ⟨failureWorld, remaining, history ++ prescribed.take (position.val + 1)⟩))) ∧
    (∀ position : Fin 2,
      action ⟨initial, successful.take position.val ++ [.diverged] ++
        successful.drop (position.val + 1) ++ suffix, history⟩ = none)

/-- The generated outer-loop body must read both iterator fields before
inner-length, zero and the initial comparison. An already exhausted iterator
returns immediately, preserving all pending observations. This is a full
input-domain failure/order invariant with an arbitrary stateful body.
Source: base/simdloop.jl:69-83. -/
def OuterPrefixRuntime : Prop :=
  ∀ {W L S : Type} (core : CoreOps (ProbeWorld W L) L) (bindings : Bindings L)
      (range outerRange next : Value L) (state : S)
      (body : Value L → S → CoreM (ProbeWorld W L) L S)
      (values : Fin 5 → Value L) (worlds : Fin 5 → W) (initial : W)
      (history : List (Event L)) (suffix : List (Reply W L)),
    let action := outer (observingOps core) bindings range outerRange next state body
    let successful := successfulReplies 4 values worlds
    let prescribed :=
      [.getfield next (JuliaLean.base.boot.intV core (JInt.lit .i64 1)),
       .getfield next (JuliaLean.base.boot.intV core (JInt.lit .i64 2)),
       .call bindings.simd_inner_length [range, values 0],
       .call bindings.zero [values 2],
       .call bindings.less [values 3, values 2]]
    if core.same next (JuliaLean.base.boot.nothingV core) then
      ∀ before : ProbeWorld W L, action before = some (.ok (state, before))
    else
      (∀ (position : Fin 5) (error : Value L) (failureWorld : W),
        let remaining := successful.drop (position.val + 1) ++ suffix
        let failed : ProbeWorld W L :=
          ⟨initial, successful.take position.val ++ [.thrown error failureWorld] ++ remaining,
            history⟩
        action failed = some (.error
          (error, ⟨failureWorld, remaining, history ++ prescribed.take (position.val + 1)⟩))) ∧
      (∀ position : Fin 5,
        action ⟨initial, successful.take position.val ++ [.diverged] ++
          successful.drop (position.val + 1) ++ suffix, history⟩ = none)

/-- An inner comparison is always first. False suppresses the index call and
body and preserves lexical state; non-Bool raises exact conditional TypeError.
All first-comparison failures/divergence survive independently of body behavior.
Source: base/simdloop.jl:73-80. -/
def InnerShortCircuit : Prop :=
  ∀ {W L S : Type} (core : CoreOps (ProbeWorld W L) L) (bindings : Bindings L)
      (range outerIndex count counter : Value L) (state : S)
      (body : Value L → S → CoreM (ProbeWorld W L) L S)
      (comparison : Value L) (initial returnedWorld failureWorld : W)
      (error : Value L) (history : List (Event L)) (suffix : List (Reply W L)),
    let action := inner (observingOps core) bindings range outerIndex count counter state body
    let event := Event.call bindings.less [counter, count]
    let before : ProbeWorld W L := ⟨initial, .returned comparison returnedWorld :: suffix, history⟩
    let after : ProbeWorld W L := ⟨returnedWorld, suffix, history ++ [event]⟩
    let flag := match comparison with | .leaf leaf => core.asBool leaf | _ => none
    (match flag with
     | some false => action before = some (.ok (state, after))
     | none => action before = some (.error
         (JuliaLean.base.boot.objV core (.typeError (.symbol "if")
           (JuliaLean.base.boot.strV core "") (JuliaLean.base.boot.coreV core "Bool") comparison),
          after))
     | some true => True) ∧
    action ⟨initial, .thrown error failureWorld :: suffix, history⟩ =
      some (.error (error, ⟨failureWorld, suffix, history ++ [event]⟩)) ∧
    action ⟨initial, .diverged :: suffix, history⟩ = none

/-- Independent positive-iteration provenance. The actual SIMD index reaches
the body with the original state, addition follows the completed body, and
the next comparison retains count while using the returned counter. If that
comparison is also true, the next body receives the previous body's actual
state. The observed body is an arbitrary scripted callee, with arbitrary
values/worlds/errors/divergence and no correctness law. Conditional branches
below describe which observations are reachable; no successful body or
termination premise is assumed. Source: base/simdloop.jl:73-80. -/
def InnerPositivePrefixes : Prop :=
  ∀ {W L : Type} (core : CoreOps (ProbeWorld W L) L) (bindings : Bindings L)
      (range outerIndex count counter state bodyFunction : Value L)
      (values : Nat → Value L) (worlds : Nat → W) (initial : W)
      (history : List (Event L)) (suffix : List (Reply W L)),
    let observed := observingOps core
    let action := inner observed bindings range outerIndex count counter state
      (fun index state => observed.call bodyFunction [index, state])
    let flag := fun position => match values position with
      | .leaf leaf => core.asBool leaf
      | _ => none
    let first : List (Event L) :=
      [.call bindings.less [counter, count],
       .call bindings.simd_index [range, outerIndex, counter],
       .call bodyFunction [values 1, state],
       .call bindings.add [counter, JuliaLean.base.boot.intV core (JInt.lit .i64 1)],
       .call bindings.less [values 3, count]]
    match flag 0 with
    | some true =>
        PrefixFailures action values worlds initial history suffix first ∧
        (match flag 4 with
         | some true => PrefixFailures action values worlds initial history suffix
             (first ++ [.call bindings.simd_index [range, outerIndex, values 3],
                         .call bodyFunction [values 5, values 2]])
         | _ => True)
    | _ => True

def RuntimeContract : Prop :=
  EntryRuntime ∧ OuterPrefixRuntime ∧ InnerShortCircuit ∧ InnerPositivePrefixes

def proposedEntries : List Entry := [
  { id := "broadcast-simd-expansion-effects", juliaFile := "base/simdloop.jl",
    juliaFns := ["@simd runtime expansion used by broadcast copy methods"],
    statement := "The exact SIMD expansion obtains and iterates its outer range before reading both iterator fields, then performs the distinct zero/positive and inner comparison stages. Exhaustion/false suppress body work, non-Bool raises TypeError, each actual SIMD index reaches the body with current state, and addition/next comparisons follow completed body effects without losing errors, divergence or worlds.",
    source := "base/simdloop.jl:66-86; base/broadcast.jl:1015-1032,1035-1072,1120-1130",
    status := .todo,
    prop := ``JuliaLean.Proofs.base.broadcast.Models2Group5.SimdLoop.RuntimeContract,
    thm := none,
    notes := "Todo: needs composed EntryRuntime, OuterPrefixRuntime, InnerShortCircuit and InnerPositivePrefixes proofs for both partial loops, with arbitrary body state/worlds and non-Bool comparison errors." }
]

end JuliaLean.Proofs.base.broadcast.Models2Group5.SimdLoop


namespace JuliaLean.Proofs.base.broadcast.Models2Group5.PlainCopy

open JuliaLean
open JuliaLean.Registry
open JuliaLean.base.expr (Value)
open JuliaLean.base.boot (CoreOps CoreM)
open JuliaLean.base.broadcast.Models2Group5.PlainCopy
open JuliaLean.Proofs.base.broadcast.Models2Group5.ForwardObservations (Reply)
open JuliaLean.Proofs.base.broadcast.Models2Group5.IndexAccess.ContextObservations
open JuliaLean.Proofs.base.broadcast.Models2Group5.Preprocessing (AllReturned)

/-- Observe exactly the runtime operations used here and in the shared SIMD
expansion, retaining their actual caller/inbounds context labels. -/
def observeContexts {W L : Type} (core : Bool → CoreOps (World W L) L) :
    JuliaLean.base.broadcast.Models2Group5.Iteration.ContextOps (World W L) L where
  inContext := fun context =>
    { core context with
      call := fun function arguments => observe context (.call function arguments)
      applyType := fun constructor parameters => observe context (.applyType constructor parameters)
      getfield := fun object field => observe context (.getfield object field) }

/-- Complete scripted observation contract for an independently designated
returned value. Every boundary result/world/error/divergence is arbitrary. -/
def FinishesWith {W L : Type} (action : CoreM (World W L) L (Value L))
    (values : Nat → Value L) (worlds : Nat → W) (initial : W)
    (history : List (ContextEvent L)) (suffix : List (Reply W L))
    (events : List (ContextEvent L)) (returned : Value L) : Prop :=
  let successful := successes events.length values worlds
  let before : World W L := ⟨initial, successful ++ suffix, history⟩
  let after : World W L := ⟨worlds (events.length - 1), suffix, history ++ events⟩
  0 < events.length ∧ action before = some (.ok (returned, after)) ∧
    FailurePrefixes action successful events initial history suffix

/-- Source dimension checking validates only the left equality operand of ||.
A false result rereads both axes in order and discards a returned throwdm value;
a non-Bool equality raises conditional TypeError before those rereads. All
selected throwdm errors/worlds survive, with no assumption it must throw.
Source: base/broadcast.jl:1016. -/
def AxesGuardObservations : Prop :=
  ∀ {W L : Type} (core : Bool → CoreOps (World W L) L) (bindings : Bindings L)
      (dest bc : Value L) (boundscheck : Bool) (values : Nat → Value L) (worlds : Nat → W)
      (initial : W) (history : List (ContextEvent L)) (suffix : List (Reply W L)),
    let current := core boundscheck
    let action : CoreM (World W L) L (Value L) := do
      checkAxes ((observeContexts core).inContext boundscheck) bindings dest bc
      pure dest
    let priorReplies := [call boundscheck bindings.axes [dest], call boundscheck bindings.axes [bc],
      call boundscheck bindings.equal [values 0, values 1]]
    match (match values 2 with | .leaf leaf => current.asBool leaf | _ => none) with
    | some true => FinishesWith action values worlds initial history suffix priorReplies dest
    | some false => FinishesWith action values worlds initial history suffix
        (priorReplies ++ [call boundscheck bindings.axes [dest], call boundscheck bindings.axes [bc],
          call boundscheck bindings.throwDimension [values 3, values 4]]) dest
    | none =>
        let before : World W L := ⟨initial, successes 3 values worlds ++ suffix, history⟩
        let after : World W L := ⟨worlds 2, suffix, history ++ priorReplies⟩
        FailurePrefixes action (successes 3 values worlds) priorReplies initial history suffix ∧
        action before = some (.error
          (JuliaLean.base.boot.objV current (.typeError (.symbol "if")
            (JuliaLean.base.boot.strV current "") (JuliaLean.base.boot.coreV current "Bool")
            (values 2)), after))

/-- Exact identity shortcut candidate protocol, including both short-circuit
checks, the mandatory second args getter, original destination axes, actual
candidate axes and final Boolean comparison. Successful comparison returns
that exact candidate internally; false returns no candidate. A non-Bool never
silently enables the shortcut. Tuple encoding here is proof instrumentation
of the internal Option, not an added operation of the source method.
Source: base/broadcast.jl:1017-1023. -/
def IdentityCandidateObservations : Prop :=
  ∀ {W L : Type} (core : Bool → CoreOps (World W L) L) (bindings : Bindings L)
      (dest bc : Value L) (boundscheck : Bool) (values : Nat → Value L) (worlds : Nat → W)
      (initial : W) (history : List (ContextEvent L)) (suffix : List (Reply W L)),
    let current := core boundscheck
    let action : CoreM (World W L) L (Value L) := do
      let candidate ← identitySource ((observeContexts core).inContext boundscheck) bindings dest bc
      pure (JuliaLean.base.boot.tupleV current (match candidate with | none => [] | some value => [value]))
    let first := [call boundscheck bindings.getproperty [bc, .symbol "f"]]
    if !(current.same (values 0) bindings.identity) then
      FinishesWith action values worlds initial history suffix first
        (JuliaLean.base.boot.tupleV current [])
    else
      let second := first ++
        [call boundscheck bindings.getproperty [bc, .symbol "args"],
         ⟨boundscheck, .applyType (JuliaLean.base.boot.coreV current "Tuple") [bindings.abstractArray]⟩]
      if !(current.isa (values 1) (values 2)) then
        FinishesWith action values worlds initial history suffix second
          (JuliaLean.base.boot.tupleV current [])
      else
        let priorReplies := second ++
          [call boundscheck bindings.getproperty [bc, .symbol "args"],
           call boundscheck bindings.getindex
             [values 3, JuliaLean.base.boot.intV current (JInt.lit .i64 1)],
           call boundscheck bindings.axes [dest], call boundscheck bindings.axes [values 4],
           call boundscheck bindings.equal [values 5, values 6]]
        match (match values 7 with | .leaf leaf => current.asBool leaf | _ => none) with
        | some true => FinishesWith action values worlds initial history suffix priorReplies
            (JuliaLean.base.boot.tupleV current [values 4])
        | some false => FinishesWith action values worlds initial history suffix priorReplies
            (JuliaLean.base.boot.tupleV current [])
        | none =>
            let before : World W L := ⟨initial, successes 8 values worlds ++ suffix, history⟩
            let after : World W L := ⟨worlds 7, suffix, history ++ priorReplies⟩
            FailurePrefixes action (successes 8 values worlds) priorReplies initial history suffix ∧
            action before = some (.error
              (JuliaLean.base.boot.objV current (.typeError (.symbol "if")
                (JuliaLean.base.boot.strV current "") (JuliaLean.base.boot.coreV current "Bool")
                (values 7)), after))

/-- Each actual loop body performs one source read followed by one write of
that exact value at the same index in the original destination. Both run in
false bounds context, including failures; no write occurs after a failed read,
and no heap state is rolled back on a failed write. Source: broadcast1028. -/
def BodyReadWriteObservations : Prop :=
  ∀ {W L : Type} (core : Bool → CoreOps (World W L) L) (bindings : Bindings L)
      (dest ready index : Value L) (values : Nat → Value L) (worlds : Nat → W)
      (initial : W) (history : List (ContextEvent L)) (suffix : List (Reply W L)),
    let action : CoreM (World W L) L (Value L) := do
      writeOne ((observeContexts core).inContext false) bindings dest ready index
      pure dest
    FinishesWith action values worlds initial history suffix
      [call false bindings.getindex [ready, index],
       call false bindings.setindex [dest, values 0, index]] dest

/-- Preprocessing precedes range creation, and the entire eachindex/SIMD
expansion is within the source's false context. An actually exhausted outer
iterator returns the exact destination without a read/write or fake native
range traversal. Every initial operation can fail/diverge with its own world.
The shared SIMD contract covers subsequent outer/inner iteration behavior.
Source: base/broadcast.jl:1024-1031; simdloop66-86. -/
def LoopEntryObservations : Prop :=
  ∀ {W L : Type} (core : Bool → CoreOps (World W L) L) (bindings : Bindings L)
      (dest bc : Value L) (boundscheck : Bool) (values : Nat → Value L) (worlds : Nat → W)
      (initial : W) (history : List (ContextEvent L)) (suffix : List (Reply W L)),
    let action := copyLoop (observeContexts core) bindings dest bc boundscheck
    let events :=
      [call boundscheck bindings.preprocess [dest, bc],
       call false bindings.eachindex [values 0],
       call false bindings.simd.simd_outer_range [values 1],
       call false bindings.simd.iterate [values 2]]
    if (core false).same (values 3) (JuliaLean.base.boot.nothingV (core false)) then
      FinishesWith action values worlds initial history suffix events dest
    else FailurePrefixes action (successes 4 values worlds) events initial history suffix

/-- Public entry must complete its first axes/equality observations before
any getter, shortcut, preprocessing or recursive copy target is considered.
The selectors and every input/runtime effect remain arbitrary.
Source: base/broadcast.jl:1015-1016. -/
def EntryFailureOrder : Prop :=
  ∀ {W L : Type} (core : Bool → CoreOps (World W L) L)
      (select : Value L → Value L → W → Bool) (bindings : Bindings L)
      (dest bc : Value L) (boundscheck : Bool) (values : Nat → Value L) (worlds : Nat → W)
      (initial : W) (history : List (ContextEvent L)) (suffix : List (Reply W L)),
    let ops : Ops (World W L) L :=
      { contexts := observeContexts core
        selectedSelf := fun dest source world => select dest source world.payload }
    FailurePrefixes (copy ops bindings dest bc boundscheck) (successes 3 values worlds)
      [call boundscheck bindings.axes [dest], call boundscheck bindings.axes [bc],
       call boundscheck bindings.equal [values 0, values 1]] initial history suffix

/-- Complete error accounting at every own-recursion or SIMD depth. A failure
is either the next actual observed operation's thrown object/world, or the
source conditional TypeError caused by the last successful non-Bool comparison.
Earlier operations are successful and every remaining reply is untouched.
This protects partial mutation state throughout the loops without assuming
that custom axes, iterators, comparisons, readers or writers are correct.
Source: base/broadcast.jl:1015-1031; simdloop66-86. -/
def RecursiveErrorsKeepWorlds : Prop :=
  ∀ {W L : Type} (core : Bool → CoreOps (World W L) L)
      (select : Value L → Value L → W → Bool) (bindings : Bindings L)
      (dest bc : Value L) (boundscheck : Bool) (initial : W)
      (history : List (ContextEvent L)) (replies : List (Reply W L)),
    let ops : Ops (World W L) L :=
      { contexts := observeContexts core
        selectedSelf := fun dest source world => select dest source world.payload }
    match copy ops bindings dest bc boundscheck ⟨initial, replies, history⟩ with
    | some (.error (error, after)) =>
        (∃ (priorReplies : List (Reply W L)) (payload : W) (events : List (ContextEvent L)),
          replies = priorReplies ++ [.thrown error payload] ++ after.replies ∧
          AllReturned priorReplies ∧ after.payload = payload ∧
          after.events = history ++ events ∧ events.length = priorReplies.length + 1) ∨
        (∃ (priorReplies : List (Reply W L)) (bad function : Value L) (arguments : List (Value L))
          (payload : W) (events : List (ContextEvent L)) (context : Bool),
          replies = priorReplies ++ [.returned bad payload] ++ after.replies ∧
          AllReturned priorReplies ∧ after.payload = payload ∧
          after.events = history ++ events ++ [call context function arguments] ∧
          events.length = priorReplies.length ∧
          (function = bindings.equal ∨ function = bindings.simd.less) ∧
          (match bad with | .leaf leaf => (core context).asBool leaf = none | _ => True) ∧
          error = JuliaLean.base.boot.objV (core context) (.typeError (.symbol "if")
            (JuliaLean.base.boot.strV (core context) "")
            (JuliaLean.base.boot.coreV (core context) "Bool") bad))
    | _ => True

def RuntimeContract : Prop :=
  AxesGuardObservations ∧ IdentityCandidateObservations ∧ BodyReadWriteObservations ∧
  LoopEntryObservations ∧ EntryFailureOrder ∧ RecursiveErrorsKeepWorlds

def proposedEntries : List Entry := [
  { id := "broadcast-copyto-plain-runtime", juliaFile := "base/broadcast.jl",
    juliaFns := ["copyto!(dest::AbstractArray, bc::Broadcasted{Nothing})"],
    statement := "Plain broadcast copying preserves repeated-axis and identity-shortcut order, continues after a returned custom throwdm, and performs actual recursive copy selection or the exact inbounds SIMD expansion. Every loop body reads before writing the exact value at the same destination index, and all failures retain their original mutation world and unused operations.",
    source := "base/broadcast.jl:1015-1031; base/simdloop.jl:66-86 (guard, alias, context, iteration and error-world invariants)",
    status := .todo,
    prop := ``JuliaLean.Proofs.base.broadcast.Models2Group5.PlainCopy.RuntimeContract,
    thm := none,
    notes := "Todo: needs RecursiveErrorsKeepWorlds fixed-point induction through self redispatch and generic SIMD loops, including conditional TypeErrors; finite guard/read-write/entry observations do not settle the full RuntimeContract." }
]

end JuliaLean.Proofs.base.broadcast.Models2Group5.PlainCopy


namespace JuliaLean.Proofs.base.broadcast.Models2Group5.BitCopy

