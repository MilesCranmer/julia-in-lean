    (first second : CoreM (ProbeWorld W L) L (Value L))
    (initial : W) (values : Nat → Value L) (worlds : Nat → W)
    (offset : Nat) (events : List (Event L))
    (h : ∀ (replies : List (Reply W L)) (history : List (Event L)),
      first ⟨initial, replies, history⟩ = second ⟨initial, replies, history⟩)
