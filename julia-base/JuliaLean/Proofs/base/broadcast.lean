Base.@propagate_inbounds _newindex(ax::Tuple{}, I::Tuple) = ()
Base.@propagate_inbounds _newindex(ax::Tuple, I::Tuple{}) = (ax[1][begin], _newindex(tail(ax), ())...)
Base.@propagate_inbounds _newindex(ax::Tuple{}, I::Tuple{}) = ()
```
-/
def remapAxes : List Index.Axis → List Int → Index.Result (List Int) :=
  Index.remapAxes (fun axis : Index.Axis => .ok axis.values.length)
    (fun n : Nat => .ok (decide (n = 1)))
    (fun _ : Index.Axis => .ok ()) (fun axis _ => .ok axis.first)
    (fun c x y => .ok (JuliaLean.base.essentials.ifelse c x y))

/--
Pure legacy Cartesian caller specialization; canonical m585 remains the subject.
Julia source: base/broadcast.jl:585-585 @ f755f49a9e41380d7da126b3c1db9fe7f83dd027
```julia
