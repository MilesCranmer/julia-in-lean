theorem widening_recursion_runtime : WideningRecursionRuntime := by
  intro W L core bindings dest bc iterator state count values worlds initial history suffix
  by_cases guards :
      (core true).same (values 1) (JuliaLean.base.boot.nothingV (core true)) = false ∧
      (core true).isa (values 0) (JuliaLean.base.boot.coreV (core true) "Type") = true ∧
      (core true).isa (values 7) (values 0) = false
  · simp only [guards, ↓reduceIte]
    rcases guards with ⟨started, valid, fits⟩
    have path := copy_read_steps core (fun _ _ => .custom) (fun _ _ => .builtin)
      bindings dest bc iterator state count values worlds started
    cases finished : (core true).same (values 11)
        (JuliaLean.base.boot.nothingV (core true)) with
    | false =>
        simp only [finished, Bool.false_eq_true, ↓reduceIte]
        have tail := builtin_widen_prefix core (fun _ _ => .custom)
          bindings dest bc iterator state count values worlds valid fits
        have complete := steps_prefix_extend path tail
        apply prefix_observations complete
        · rfl
        · rfl
    | true =>
        simp only [finished, ↓reduceIte]
        have tail := builtin_widen_steps core
          bindings dest bc iterator state count values worlds valid fits finished
        have complete := steps_extend path tail
        apply steps_trace complete
        · change 0 < 15
          decide
        · rfl
        · rfl
        · rfl
  · simp only [guards, ↓reduceIte]

end NonleafProofs

