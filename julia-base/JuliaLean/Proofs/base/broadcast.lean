namespace ClosureAux

theorem bind_apply {W L A B : Type} (action : CoreM W L A)
    (next : A → CoreM W L B) (world : W) :
    (action >>= next) world =
      (match action world with
       | none => none
       | some (.error error) => some (.error error)
       | some (.ok (value, after)) => next value after) := by
  change (Option.bind (action world) (fun answer =>
    match answer with
    | .error error => some (Except.error error)
    | .ok (value, after) => next value after)) = _
  cases action world with
  | none => rfl
  | some answer => cases answer <;> rfl

theorem twoCalls {W L : Type} (first : Value L) (args : List (Value L))
    (second : Value L) (next : Value L → List (Value L)) :
    ReturnsLastAfter (W := W) (L := L) 1
      (fun ops => do
        let value ← ops.call first args
        ops.call second (next value))
      (fun _ values _ _ => [.call first args, .call second (next (values 0))]) := by
  intro ops values worlds initial history suffix
  refine ⟨rfl, ?_, ?_, ?_⟩
  · simp only [successfulReplies, List.ofFn_succ, List.ofFn_zero,
      List.cons_append, List.nil_append, observingOps, bind_apply, observe,
      List.append_assoc, List.append_nil] <;> rfl
  · intro position error failureWorld
    rcases position with ⟨n, hn⟩
    have positions : n = 0 ∨ n = 1 := by omega
    rcases positions with rfl | rfl <;>
      simp only [successfulReplies, List.ofFn_succ, List.ofFn_zero,
        List.take, List.drop, List.cons_append, List.nil_append,
        observingOps, bind_apply, observe, List.append_assoc, List.append_nil] <;> rfl
  · intro position
    rcases position with ⟨n, hn⟩
    have positions : n = 0 ∨ n = 1 := by omega
    rcases positions with rfl | rfl <;>
      simp only [successfulReplies, List.ofFn_succ, List.ofFn_zero,
        List.take, List.drop, List.cons_append, List.nil_append,
        observingOps, bind_apply, observe, List.append_assoc, List.append_nil] <;> rfl

theorem badArity {W L : Type} (ops : CoreOps W L) (bindings : Bindings L)
    (code : Models1Group12.ChunkFunctionCode)
    (isClosure : code = .lessEqualClosure ∨ code = .greaterClosure ∨ code = .greaterEqualClosure)
    (arguments : Models2Group5.Constructors.ArgumentTuple L)
    (length_ne : arguments.values.length ≠ 2) :
    ArityFailure ops bindings code arguments := by
  intro world
  rcases arguments with ⟨arguments, bound, size, size_eq⟩
  cases arguments with
  | nil =>
      rcases isClosure with rfl | rfl | rfl <;>
        simp only [invoke, bind_apply] <;>
        cases h : ops.worldAge world with
        | none => rfl
        | some result => cases result <;> rfl
  | cons first rest =>
      cases rest with
      | nil =>
          rcases isClosure with rfl | rfl | rfl <;>
            simp only [invoke, bind_apply] <;>
            cases h : ops.worldAge world with
            | none => rfl
            | some result => cases result <;> rfl
      | cons second rest =>
          cases rest with
          | nil => exact False.elim (length_ne rfl)
          | cons third rest =>
              rcases isClosure with rfl | rfl | rfl <;>
                simp only [invoke, bind_apply] <;>
                cases h : ops.worldAge world with
                | none => rfl
                | some result => cases result <;> rfl
