theorem cut_bounds {W L : Type}
    (select : Value L → List (Value L) → W → Method)
    (worlds : Nat → W) (processed : Nat) (first : Value L) (rest : List (Value L)) :
    processed ≤ (cutPoint select worlds processed first rest).1 ∧
      (cutPoint select worlds processed first rest).1 < processed + (first :: rest).length ∧
      ((cutPoint select worlds processed first rest).2 = .axes →
        (cutPoint select worlds processed first rest).1 = processed + rest.length) := by
  induction rest generalizing processed first with
  | nil =>
      cases chosen : select first [] (worlds (processed - 1)) with
      | custom =>
          simp only [cutPoint, chosen, List.length_cons, List.length_nil, Nat.zero_add]
          refine ⟨by omega, by omega, ?_⟩
          intro h
          cases h
      | builtin =>
          simp only [cutPoint, chosen, List.length_cons, List.length_nil, Nat.zero_add, Nat.add_zero]
          refine ⟨by omega, by omega, ?_⟩
          intro _
          exact True.intro
  | cons second tail ih =>
      cases chosen : select first (second :: tail) (worlds (processed - 1)) with
      | custom =>
          cases tail <;>
            simp only [cutPoint, chosen, List.length_cons, List.length_nil] <;>
            refine ⟨by omega, by omega, ?_⟩ <;>
            intro h <;> cases h
      | builtin =>
          cases tail with
          | nil =>
              simp only [cutPoint, chosen, List.length_cons, List.length_nil, Nat.zero_add]
              refine ⟨by omega, by omega, ?_⟩
              intro _
              exact True.intro
          | cons third tail =>
              have recBounds := ih (processed + 1) second
              simp only [List.length_cons] at recBounds
              simp only [cutPoint, chosen, List.length_cons]
              refine ⟨by omega, by omega, ?_⟩
              intro h
              have last := recBounds.2.2 h
              omega

def suffixEvents {L : Type} (bindings : Bindings L) (inputs : List (Value L))
    (processed cut : Nat) (terminal : Terminal) (values : Nat → Value L) : List (Event L) :=
  (inputs.take (cut - processed)).map (fun value => .call bindings.axes [value]) ++
  (match terminal with
   | .axes => (inputs.drop (cut - processed)).map (fun value => .call bindings.axes [value])
   | .custom => [.call bindings.combineAxes (inputs.drop (cut - processed))]) ++
  (List.range (cut - processed)).map (fun index =>
    .call bindings.broadcastShape [values (cut - 1 - index), values (cut + index)])

theorem cut_drop {W L : Type}
    (select : Value L → List (Value L) → W → Method)
    (worlds : Nat → W) (processed : Nat) (first : Value L) (rest : List (Value L)) :
    match (cutPoint select worlds processed first rest).2 with
    | .axes => ((first :: rest).drop ((cutPoint select worlds processed first rest).1 - processed)).length = 1
    | .custom => True := by
  have bounds := cut_bounds select worlds processed first rest
  cases terminal : (cutPoint select worlds processed first rest).2 with
  | axes =>
      have last := bounds.2.2 terminal
      simp only [List.length_drop, List.length_cons]
      omega
  | custom => exact True.intro

theorem suffixEvents_length {L : Type} (bindings : Bindings L)
    (inputs : List (Value L)) (processed cut : Nat) (terminal : Terminal)
    (values : Nat → Value L) (h : cut - processed ≤ inputs.length)
    (last : match terminal with | .axes => (inputs.drop (cut - processed)).length = 1 | .custom => True) :
    (suffixEvents bindings inputs processed cut terminal values).length = 2 * (cut - processed) + 1 := by
  cases terminal with
  | axes =>
      simp only [suffixEvents, List.length_append, List.length_map, List.length_take,
        List.length_range, Nat.min_eq_left h, last]
      omega
  | custom =>
      simp only [suffixEvents, List.length_append, List.length_map, List.length_take,
        List.length_range, Nat.min_eq_left h, List.length_cons, List.length_nil]
      omega

theorem suffixEvents_custom {L : Type} (bindings : Bindings L)
    (inputs : List (Value L)) (processed : Nat) (values : Nat → Value L) :
    suffixEvents bindings inputs processed processed .custom values =
      [.call bindings.combineAxes inputs] := by
  simp only [suffixEvents, Nat.sub_self, List.take_zero, List.drop_zero,
    List.map_nil, List.nil_append, List.range_zero, List.append_nil]

theorem suffixEvents_one {L : Type} (bindings : Bindings L)
    (first : Value L) (processed : Nat) (values : Nat → Value L) :
    suffixEvents bindings [first] processed processed .axes values = [.call bindings.axes [first]] := by
  simp only [suffixEvents, Nat.sub_self, List.take_zero, List.drop_zero,
    List.map_nil, List.nil_append, List.range_zero, List.append_nil, List.map_cons]

theorem suffixEvents_two {L : Type} (bindings : Bindings L)
    (first second : Value L) (processed : Nat) (values : Nat → Value L) :
    suffixEvents bindings [first, second] processed (processed + 1) .axes values =
      [.call bindings.axes [first], .call bindings.axes [second],
        .call bindings.broadcastShape [values processed, values (processed + 1)]] := by
  have count : processed + 1 - processed = 1 := by omega
  simp only [suffixEvents, count, List.take_succ_cons, List.take_zero, List.drop_succ_cons,
    List.drop_zero, List.map_cons, List.map_nil, List.range_one, Nat.sub_zero,
    Nat.add_sub_cancel, Nat.add_zero, List.cons_append, List.nil_append]

theorem suffixEvents_step {L : Type} (bindings : Bindings L)
    (first : Value L) (rest : List (Value L)) (processed cut : Nat)
    (terminal : Terminal) (values : Nat → Value L) (h : processed < cut) :
    suffixEvents bindings (first :: rest) processed cut terminal values =
      .call bindings.axes [first] ::
        (suffixEvents bindings rest (processed + 1) cut terminal values ++
         [.call bindings.broadcastShape [values processed, values (2 * cut - processed - 1)]]) := by
  have splitCount : cut - processed = (cut - (processed + 1)) + 1 := by omega
  have leftIndex : cut - 1 - (cut - (processed + 1)) = processed := by omega
  have rightIndex : cut + (cut - (processed + 1)) = 2 * cut - processed - 1 := by omega
  cases terminal <;>
    simp only [suffixEvents, splitCount, List.take_succ_cons, List.drop_succ_cons,
      List.map_cons, List.range_succ, List.map_append, List.map_cons, List.map_nil,
      leftIndex, rightIndex, List.cons_append, List.append_assoc]

theorem binary_spec {W L : Type} (core : CoreOps (ProbeWorld W L) L)
    (bindings : Bindings L) (first second : Value L) (initial : W)
    (values : Nat → Value L) (worlds : Nat → W) (processed : Nat) :
    SequenceSpec (combineTwo (observingOps core) bindings first second)
      initial values worlds processed
      [.call bindings.axes [first], .call bindings.axes [second],
        .call bindings.broadcastShape [values processed, values (processed + 1)]] := by
  exact sequence_wrap (.call bindings.axes [first])
    (fun _ => observe (.call bindings.axes [second]))
    (fun a b => .call bindings.broadcastShape [a, b])
    initial values worlds processed [.call bindings.axes [second]]
    (sequence_one (.call bindings.axes [second]) (worlds processed) values worlds (processed + 1))

theorem suffix_custom_eq {W L : Type} (ops : Ops W L) (bindings : Bindings L)
    (first : Value L) (rest : List (Value L)) (world : W)
    (h : ops.selectedCombine first rest world = .custom) :
    combineSuffix ops bindings first rest world =
      ops.call bindings.combineAxes (first :: rest) world := by
  cases rest with
  | nil => simp only [combineSuffix, h]
  | cons second tail =>
      cases tail with
      | nil => simp only [combineSuffix, h]
      | cons third tail => simp only [combineSuffix, h]

theorem suffix_recursive_eq {W L : Type} (ops : Ops W L) (bindings : Bindings L)
    (first second third : Value L) (tail : List (Value L)) (world : W)
    (h : ops.selectedCombine first (second :: third :: tail) world = .builtin) :
    combineSuffix ops bindings first (second :: third :: tail) world =
      (do let left ← ops.call bindings.axes [first]
          let right ← combineSuffix ops bindings second (third :: tail)
          ops.call bindings.broadcastShape [left, right]) world := by
  simp only [combineSuffix, h]

theorem cut_custom_eq {W L : Type}
    (select : Value L → List (Value L) → W → Method)
    (worlds : Nat → W) (processed : Nat) (first : Value L) (rest : List (Value L))
    (h : select first rest (worlds (processed - 1)) = .custom) :
    cutPoint select worlds processed first rest = (processed, .custom) := by
  cases rest with
  | nil => simp only [cutPoint, h]
  | cons second tail =>
      cases tail with
      | nil => simp only [cutPoint, h]
      | cons third tail => simp only [cutPoint, h]

theorem suffix_spec {W L : Type} (core : CoreOps (ProbeWorld W L) L)
    (select : Value L → List (Value L) → W → Method)
    (bindings : Bindings L) (values : Nat → Value L) (worlds : Nat → W)
    (processed : Nat) (first : Value L) (rest : List (Value L)) :
    SequenceSpec (combineSuffix (observingCombine core select) bindings first rest)
      (worlds (processed - 1)) values worlds processed
      (suffixEvents bindings (first :: rest) processed
        (cutPoint select worlds processed first rest).1
        (cutPoint select worlds processed first rest).2 values) := by
  induction rest generalizing processed first with
  | nil =>
      cases chosen : select first [] (worlds (processed - 1)) with
      | custom =>
          simp only [cut_custom_eq select worlds processed first [] chosen]
          rw [suffixEvents_custom]
          apply sequence_congr (first := observe (.call bindings.combineAxes [first]))
          · intro script history
            symm
            apply suffix_custom_eq
            exact chosen
          · exact sequence_one (.call bindings.combineAxes [first])
              (worlds (processed - 1)) values worlds processed
      | builtin =>
          simp only [cutPoint, chosen]
          rw [suffixEvents_one]
          apply sequence_congr (first := observe (.call bindings.axes [first]))
          · intro script history
            simp only [combineSuffix, observingCombine, chosen, combineOne, observingOps]
          · exact sequence_one (.call bindings.axes [first])
              (worlds (processed - 1)) values worlds processed
  | cons second tail ih =>
      cases chosen : select first (second :: tail) (worlds (processed - 1)) with
      | custom =>
          simp only [cut_custom_eq select worlds processed first (second :: tail) chosen]
          rw [suffixEvents_custom]
          apply sequence_congr (first := observe (.call bindings.combineAxes (first :: second :: tail)))
          · intro script history
            symm
            apply suffix_custom_eq
            exact chosen
          · exact sequence_one (.call bindings.combineAxes (first :: second :: tail))
              (worlds (processed - 1)) values worlds processed
      | builtin =>
          cases tail with
          | nil =>
              simp only [cutPoint, chosen]
              rw [suffixEvents_two]
              apply sequence_congr (first := combineTwo (observingOps core) bindings first second)
              · intro script history
                simp only [combineSuffix, observingCombine, chosen]
              · exact binary_spec core bindings first second (worlds (processed - 1)) values worlds processed

          | cons third tail =>
              simp only [cutPoint, chosen]
              let plan := cutPoint select worlds (processed + 1) second (third :: tail)
              have bounds := cut_bounds select worlds (processed + 1) second (third :: tail)
              have positive : processed < plan.1 := by dsimp only [plan]; omega
              rw [suffixEvents_step bindings first (second :: third :: tail) processed plan.1 plan.2 values positive]
              have inner : SequenceSpec
                  (combineSuffix (observingCombine core select) bindings second (third :: tail))
                  (worlds processed) values worlds (processed + 1)
                  (suffixEvents bindings (second :: third :: tail) (processed + 1) plan.1 plan.2 values) := by
                simpa only [Nat.add_sub_cancel] using ih (processed + 1) second
              have elen : (suffixEvents bindings (second :: third :: tail)
                    (processed + 1) plan.1 plan.2 values).length =
                  2 * (plan.1 - (processed + 1)) + 1 :=
                suffixEvents_length bindings (second :: third :: tail) (processed + 1) plan.1 plan.2 values
                  (by dsimp only [plan]; omega)
                  (cut_drop select worlds (processed + 1) second (third :: tail))
              have resultIndex : processed + (suffixEvents bindings (second :: third :: tail)
                    (processed + 1) plan.1 plan.2 values).length = 2 * plan.1 - processed - 1 := by
                rw [elen]
                dsimp only [plan] at *
                omega
              have wrapped := sequence_wrap (.call bindings.axes [first])
                (fun _ => combineSuffix (observingCombine core select) bindings second (third :: tail))
                (fun a b => Event.call bindings.broadcastShape [a, b])
                (worlds (processed - 1)) values worlds processed
                (suffixEvents bindings (second :: third :: tail) (processed + 1) plan.1 plan.2 values) inner
              rw [resultIndex] at wrapped
              apply sequence_congr (first :=
                (do let left ← observe (.call bindings.axes [first])
                    let right ← combineSuffix (observingCombine core select) bindings second (third :: tail)
                    observe (.call bindings.broadcastShape [left, right])))
              · intro script history
                symm
                apply suffix_recursive_eq
                exact chosen
              · exact wrapped

theorem nonempty_runtime : NonemptyVariadicObservations := by
  intro W L core select bindings first rest values worlds initial history suffix
  cases restValues : rest.values with
  | nil => exact True.intro
  | cons second tail =>
      let plan := cutPoint select worlds 1 second tail
      let cut := plan.1
      let terminal := plan.2
      let inputs := first :: second :: tail
      let events := variadicEvents bindings inputs cut terminal values
      let innerEvents := suffixEvents bindings (second :: tail) 1 cut terminal values
      have bounds := cut_bounds select worlds 1 second tail
      have positive : 0 < cut ∧ cut < inputs.length := by
        dsimp only [cut, plan, inputs]
        simp only [List.length_cons] at *
        omega
      have terminalDrop : match terminal with
          | .axes => (inputs.drop cut).length = 1
          | .custom => True := by
        cases terminalEq : terminal with
        | axes =>
            have last := bounds.2.2 terminalEq
            dsimp only [inputs]
            simp only [List.length_drop, List.length_cons]
            dsimp only [cut, plan] at *
            omega
        | custom => exact True.intro
      have elen : events.length = 2 * cut + 1 := by
        change (suffixEvents bindings inputs 0 cut terminal values).length = _
        have h := suffixEvents_length bindings inputs 0 cut terminal values
          (by omega) (by cases terminalEq : terminal <;> simpa only [terminalEq, Nat.sub_zero] using terminalDrop)
        simpa only [Nat.sub_zero] using h
      have innerLen : innerEvents.length = 2 * cut - 1 := by
        have h := suffixEvents_length bindings (second :: tail) 1 cut terminal values
          (by dsimp only [cut, plan]; omega) (cut_drop select worlds 1 second tail)
        change innerEvents.length = 2 * (cut - 1) + 1 at h
        rw [h]
        omega
      have inner : SequenceSpec
          (combineSuffix (observingCombine core select) bindings second tail)
          (worlds 0) values worlds 1 innerEvents :=
        suffix_spec core select bindings values worlds 1 second tail
      have eventStep : events = .call bindings.axes [first] ::
          (innerEvents ++ [.call bindings.broadcastShape [values 0, values innerEvents.length]]) := by
        change suffixEvents bindings inputs 0 cut terminal values = _
        rw [suffixEvents_step bindings first (second :: tail) 0 cut terminal values positive.1]
        rw [innerLen]
        rfl
      have whole := sequence_wrap (.call bindings.axes [first])
        (fun _ => combineSuffix (observingCombine core select) bindings second tail)
        (fun a b => Event.call bindings.broadcastShape [a, b])
        initial values worlds 0 innerEvents inner
      have spec : SequenceSpec (combineMany (observingCombine core select) bindings first rest)
          initial values worlds 0 events := by
        rw [eventStep]
        simpa only [combineMany, JuliaLean.base.broadcast.Shape.m502,
          restValues, observingCombine, observingOps, Nat.zero_add] using whole
      have full := sequence_complete _ initial values worlds events (2 * cut + 1)
        elen spec history suffix
      exact ⟨positive, elen, terminalDrop, full.1, full.2.1, full.2.2⟩

theorem throw_run {W L A : Type} (value : Value L) (world : W) :
    (throw value : CoreM W L A) world = some (.error (value, world)) := rfl

theorem empty_runtime : EmptySuffixMissingMethod := by
  intro W L core select bindings first rest firstAxes axisWorld initial history remaining
  cases restValues : rest.values with
  | cons second tail => exact True.intro
  | nil =>
      dsimp only
      cases outcome : core.worldAge
          (⟨axisWorld, remaining, history ++ [.call bindings.axes [first]]⟩ : ProbeWorld W L) with
      | none =>
          simp only [combineMany, JuliaLean.base.broadcast.Shape.m502, restValues,
            observingCombine, observingOps, bind_run, observe_return, missingNullary, outcome]
      | some result =>
          cases result with
          | error failure =>
              rcases failure with ⟨error, failureWorld⟩
              simp only [combineMany, JuliaLean.base.broadcast.Shape.m502, restValues,
                observingCombine, observingOps, bind_run, observe_return, missingNullary, outcome]
          | ok returned =>
              rcases returned with ⟨age, throwWorld⟩
              simp only [combineMany, JuliaLean.base.broadcast.Shape.m502, restValues,
                observingCombine, observingOps, bind_run, observe_return, missingNullary, outcome,
                JuliaLean.base.boot.throwObj, JuliaLean.base.boot.objV,
                JuliaLean.base.boot.tupleV, JuliaLean.base.boot.intV, throw_run]

theorem first_failure : FirstAxisFailureStops := by
  intro W L core select bindings first rest initial failureWorld error history remaining
  exact ⟨rfl, rfl⟩

