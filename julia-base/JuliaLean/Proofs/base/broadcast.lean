open JuliaLean.Proofs.base.broadcast.Models2Group5.ConstructorProbe

/-- Six unrestricted successful observations: target type, f, args, axes,
constructor result, then the independently evaluated assertion type. -/
def successfulReplies {W L : Type} (values : Fin 6 → Value L)
    (worlds : Fin 6 → W) : List (Reply W L) :=
  [.returned (values 0) (worlds 0), .returned (values 1) (worlds 1),
   .returned (values 2) (worlds 2), .returned (values 3) (worlds 3),
   .returned (values 4) (worlds 4), .returned (values 5) (worlds 5)]

/-- Independent runtime observations: source-declared metadata appears in both
type expressions, and property/constructor argument identities are retained. -/
def requiredEvents {L : Type} (bindings : Bindings L) (parameters : Parameters L)
    (bc : Value L) (values : Fin 6 → Value L) : List (Event L) :=
  [.applyType bindings.broadcasted
      [parameters.style, parameters.axes, parameters.function, parameters.arguments],
   .call bindings.getproperty [bc, .symbol "f"],
   .call bindings.getproperty [bc, .symbol "args"],
   .call bindings.getproperty [bc, .symbol "axes"],
   .call (values 0) [values 1, values 2, values 3],
   .applyType bindings.broadcasted
      [parameters.style, parameters.axes, parameters.function, parameters.arguments]]

/-- Successful boundary calls preserve the observed constructor result and its
assertion against the second evaluated target type; a failed assertion throws
the installed TypeError at the final world. All property values, constructor
results and type-application results are arbitrary. The trace requirements
reject reordered/duplicated property reads, cached assertion types, changed
arguments and eager scalar evaluation. No custom callee correctness law or
field-preservation promise is imposed.
Source: base/broadcast.jl:215-216; base/boot.lean:typeassert. -/
def TraceAndFinalAssertion : Prop :=
  ∀ {W L : Type} (ops : CoreOps (World W L) L)
      (bindings : Bindings L) (parameters : Parameters L)
      (bc : Value L) (values : Fin 6 → Value L) (worlds : Fin 6 → W)
      (initial : W) (history : List (Event L)),
    let before : World W L := ⟨initial, successfulReplies values worlds, history⟩
    let after : World W L :=
      ⟨worlds 5, [], history ++ requiredEvents bindings parameters bc values⟩
    let actual := convert (observingCore ops) bindings parameters bc before
    if ops.isa (values 4) (values 5) then
      actual = some (.ok (values 4, after))
    else
      actual = some (.error
        (.leaf (ops.obj (.typeError (.symbol "typeassert")
          (.leaf (ops.str "")) (values 5) (values 4))), after))

/-- Every thrown value at one of the six source sites is propagated with the
same failed-call world and the exact trace prefix. Later property reads,
construction or assertion cannot run after the failure. All error classes and
all preceding returned values are quantified, without callee laws.
Source: base/broadcast.jl:215-216. -/
def FailureStopsAtExactSite : Prop :=
  ∀ {W L : Type} (ops : CoreOps (World W L) L)
      (bindings : Bindings L) (parameters : Parameters L)
      (bc : Value L) (values : Fin 6 → Value L) (worlds : Fin 6 → W)
      (initial failureWorld : W) (history : List (Event L))
      (position : Fin 6) (error : Value L),
    let successful := successfulReplies values worlds
    let remaining := successful.drop (position.val + 1)
    let before : World W L :=
      ⟨initial, successful.take position.val ++ [.thrown error failureWorld] ++ remaining,
        history⟩
    let after : World W L :=
      ⟨failureWorld, remaining,
        history ++ (requiredEvents bindings parameters bc values).take (position.val + 1)⟩
    convert (observingCore ops) bindings parameters bc before = some (.error (error, after))

/-- The conversion does not recover from divergence at any type application,
property access or constructor call. Source: base/broadcast.jl:215-216. -/
def DivergenceIsPreserved : Prop :=
  ∀ {W L : Type} (ops : CoreOps (World W L) L)
      (bindings : Bindings L) (parameters : Parameters L)
      (bc : Value L) (values : Fin 6 → Value L) (worlds : Fin 6 → W)
      (initial : W) (history : List (Event L)) (position : Fin 6),
    let successful := successfulReplies values worlds
    let before : World W L :=
      ⟨initial, successful.take position.val ++ [.diverged] ++
        successful.drop (position.val + 1), history⟩
    convert (observingCore ops) bindings parameters bc before = none

theorem TraceAndFinalAssertion_proven : TraceAndFinalAssertion := by
  unfold TraceAndFinalAssertion
  intro W L ops bindings parameters bc values worlds initial history
  simp +zetaDelta [convert, observingCore, observe, successfulReplies, requiredEvents,
    JuliaLean.base.boot.typeassert, JuliaLean.base.boot.throwTypeError, JuliaLean.base.boot.throwObj, JuliaLean.base.boot.objV, JuliaLean.base.boot.strV, bind, pure, List.append_assoc]
  split <;> simp_all [pure, throw, throwThe] <;> rfl

theorem FailureStopsAtExactSite_proven : FailureStopsAtExactSite := by
  unfold FailureStopsAtExactSite
  intro W L ops bindings parameters bc values worlds initial failureWorld history
  simp +zetaDelta [Fin.forall_fin_succ, convert, observingCore, observe,
