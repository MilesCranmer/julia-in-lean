theorem cut_bounds {W L : Type}
    (select : Value L → Value L → List (Value L) → W → Method)
    (worlds : Nat → W) (processed : Nat) (first : Value L) (rest : List (Value L)) :
    processed ≤ cutPoint select worlds processed first rest ∧
      cutPoint select worlds processed first rest < processed + (first :: rest).length := by
  induction rest generalizing processed first with
  | nil =>
      simp only [cutPoint, List.length_cons, List.length_nil, Nat.zero_add]
      constructor <;> omega
  | cons second tail ih =>
      cases h : select first second tail (worlds (processed - 1)) with
      | custom =>
          simp only [cutPoint, h, List.length_cons]
          constructor <;> omega
      | builtin =>
          have hrec := ih (processed + 1) second
          simp only [cutPoint, h, List.length_cons] at *
          constructor <;> omega

def suffixEvents {L : Type} (bindings : Bindings L) (inputs : List (Value L))
    (processed cut : Nat) (values : Nat → Value L) : List (Event L) :=
  (inputs.take (cut - processed)).map (fun value => .call bindings.combineStyles [value]) ++
  [.call bindings.combineStyles (inputs.drop (cut - processed))] ++
  (List.range (cut - processed)).map (fun index =>
    .call bindings.resultStyle [values (cut - 1 - index), values (cut + index)])

theorem suffixEvents_length {L : Type} (bindings : Bindings L)
    (inputs : List (Value L)) (processed cut : Nat) (values : Nat → Value L)
    (h : cut - processed ≤ inputs.length) :
    (suffixEvents bindings inputs processed cut values).length = 2 * (cut - processed) + 1 := by
  simp only [suffixEvents, List.length_append, List.length_map, List.length_take,
    List.length_cons, List.length_nil, Nat.zero_add, List.length_range,
    Nat.min_eq_left h]
  omega

theorem suffixEvents_terminal {L : Type} (bindings : Bindings L)
    (inputs : List (Value L)) (processed : Nat) (values : Nat → Value L) :
    suffixEvents bindings inputs processed processed values =
      [.call bindings.combineStyles inputs] := by
  simp only [suffixEvents, Nat.sub_self, List.take_zero, List.drop_zero,
    List.map_nil, List.nil_append, List.range_zero, List.append_nil]

theorem suffixEvents_step {L : Type} (bindings : Bindings L)
    (first : Value L) (rest : List (Value L)) (processed cut : Nat)
    (values : Nat → Value L) (h : processed < cut) :
    suffixEvents bindings (first :: rest) processed cut values =
      .call bindings.combineStyles [first] ::
        (suffixEvents bindings rest (processed + 1) cut values ++
         [.call bindings.resultStyle [values processed, values (2 * cut - processed - 1)]]) := by
  have splitCount : cut - processed = (cut - (processed + 1)) + 1 := by omega
  have leftIndex : cut - 1 - (cut - (processed + 1)) = processed := by omega
  have rightIndex : cut + (cut - (processed + 1)) = 2 * cut - processed - 1 := by omega
  simp only [suffixEvents, splitCount, List.take_succ_cons, List.drop_succ_cons,
    List.map_cons, List.range_succ, List.map_append, List.map_cons, List.map_nil,
    leftIndex, rightIndex, List.cons_append, List.append_assoc]

def observing {W L : Type} (core : CoreOps (ProbeWorld W L) L)
    (select : Value L → Value L → List (Value L) → W → Method) :
    Ops (ProbeWorld W L) L where
  toCoreOps := observingOps core
  selectedCombine := fun first second rest world => select first second rest world.payload

theorem suffix_custom_eq {W L : Type} (ops : Ops W L) (bindings : Bindings L)
    (first second : Value L) (tail : List (Value L)) (world : W)
    (h : ops.selectedCombine first second tail world = .custom) :
    combineSuffix ops bindings first (second :: tail) world =
      ops.call bindings.combineStyles (first :: second :: tail) world := by
  cases tail with
  | nil => simp only [combineSuffix, h]
  | cons third tail => simp only [combineSuffix, h]

theorem suffix_builtin_eq {W L : Type} (ops : Ops W L) (bindings : Bindings L)
    (first second : Value L) (tail : List (Value L)) (world : W)
    (h : ops.selectedCombine first second tail world = .builtin) :
    combineSuffix ops bindings first (second :: tail) world =
      (do let left ← ops.call bindings.combineStyles [first]
          let right ← combineSuffix ops bindings second tail
          ops.call bindings.resultStyle [left, right]) world := by
  cases tail with
  | nil => simp only [combineSuffix, h, combineTwo]
  | cons third tail => simp only [combineSuffix, h]

theorem suffix_spec {W L : Type} (core : CoreOps (ProbeWorld W L) L)
    (select : Value L → Value L → List (Value L) → W → Method)
    (bindings : Bindings L) (values : Nat → Value L) (worlds : Nat → W)
    (processed : Nat) (first : Value L) (rest : List (Value L)) :
    SequenceSpec (combineSuffix (observing core select) bindings first rest)
      (worlds (processed - 1)) values worlds processed
      (suffixEvents bindings (first :: rest) processed
        (cutPoint select worlds processed first rest) values) := by
  induction rest generalizing processed first with
  | nil =>
      rw [cutPoint, suffixEvents_terminal, combineSuffix]
      exact sequence_one (.call bindings.combineStyles [first])
        (worlds (processed - 1)) values worlds processed
  | cons second tail ih =>
      cases chosen : select first second tail (worlds (processed - 1)) with
      | custom =>
          rw [cutPoint, chosen, suffixEvents_terminal]
          apply sequence_congr (first := observe (.call bindings.combineStyles (first :: second :: tail)))
          · intro script history
            symm
            apply suffix_custom_eq
            exact chosen
          · exact sequence_one (.call bindings.combineStyles (first :: second :: tail))
              (worlds (processed - 1)) values worlds processed
      | builtin =>
          rw [cutPoint, chosen]
          let cut := cutPoint select worlds (processed + 1) second tail
          have bounds := cut_bounds select worlds (processed + 1) second tail
          have positive : processed < cut := by dsimp only [cut]; omega
          rw [suffixEvents_step bindings first (second :: tail) processed cut values positive]
          have inner : SequenceSpec (combineSuffix (observing core select) bindings second tail)
