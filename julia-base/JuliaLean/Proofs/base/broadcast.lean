Source: base/broadcast.jl:479-485. -/
def DependsOnlyOnTypes : Prop :=
  ∀ {W L : Type} (ops : Ops W L) (bindings : Bindings L)
      (types : TypeParameters L) (a b c d a' b' c' d' : Value L) (world : W),
    conflicting ops bindings types a b c d world =
      conflicting ops bindings types a' b' c' d' world

