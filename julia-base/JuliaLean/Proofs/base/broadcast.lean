theorem BroadcastExtrudedAxesRecursion_proven :
    JuliaLean.Proofs.base.broadcast.Models2Group5.Extrusion.AxesRecursiveObservations := by
  intro W L core select bindings original values worlds initial history suffix window
  dsimp only
  cases search : (List.range (window + 1)).find?
    (fun step => isOther (select (values step) (worlds step))) with
  | none =>
      have flags := find_range_none
        (fun step => isOther (select (values step) (worlds step))) (window + 1) search
      apply axes_continues core select bindings original values worlds initial (window + 1)
        (Nat.succ_pos window) _ history suffix
      intro i bound
      have flag := flags i bound
      cases selected : select (values i) (worlds i) with
      | extruded => rfl
      | other =>
          simp only [selected, isOther] at flag
          cases flag
  | some step =>
      have found := find_range_some
        (fun step => isOther (select (values step) (worlds step))) (window + 1) step search
      have recursive : ∀ i, i < step → select (values i) (worlds i) = .extruded := by
        intro i bound
        have flag := found.2.2 i bound
        cases selected : select (values i) (worlds i) with
        | extruded => rfl
        | other =>
            simp only [selected, isOther] at flag
            cases flag
      have last : select (values step) (worlds step) = .other := by
        have flag := found.2.1
        cases selected : select (values step) (worlds step) with
        | extruded =>
            simp only [selected, isOther] at flag
            cases flag
        | other => rfl
      exact ⟨by omega, axes_returns core select bindings original values worlds initial step
        recursive last history suffix⟩

end JuliaLean.ChatGPT.Batch11.Group10

