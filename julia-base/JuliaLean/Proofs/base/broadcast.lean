private theorem applicationLaw (name : ClosureName) {W L : Type}
    (core : CoreOps W L) (bindings : Bindings L)
    (arguments : JuliaLean.base.broadcast.Models2Group5.Constructors.ArgumentTuple L)
    (world : W) :
    ApplicationLaw core bindings name arguments world
      ((closure core bindings name).invoke arguments world) := by
  cases hargs : arguments.values with
  | nil =>
    cases hage : core.worldAge world with
    | none => simp [ApplicationLaw, closure, hargs, hage, bind]
    | some result =>
      cases result <;>
        simp [ApplicationLaw, closure, hargs, hage, bind,
          JuliaLean.base.boot.throwObj, JuliaLean.base.boot.objV, throw, throwThe] <;> rfl
  | cons first remaining =>
    cases remaining with
    | nil =>
      cases hage : core.worldAge world with
      | none => simp [ApplicationLaw, closure, hargs, hage, bind]
      | some result =>
        cases result <;>
          simp [ApplicationLaw, closure, hargs, hage, bind,
            JuliaLean.base.boot.throwObj, JuliaLean.base.boot.objV, throw, throwThe] <;> rfl
    | cons second remaining =>
      cases remaining with
      | nil =>
        cases first <;>
          simp [ApplicationLaw, closure, binary, hargs, pure,
            JuliaLean.base.boot.throwTypeError, JuliaLean.base.boot.throwObj,
            JuliaLean.base.boot.objV, throw, throwThe] <;> try rfl
        all_goals
          rename_i value
          cases hflag : core.asBool value with
          | none =>
            cases name <;> simp [hflag] <;> rfl
          | some flag =>
            cases flag <;> cases name <;> simp [hflag, pure]
      | cons third rest =>
        cases hage : core.worldAge world with
        | none => simp [ApplicationLaw, closure, hargs, hage, bind]
        | some result =>
          cases result <;>
            simp [ApplicationLaw, closure, hargs, hage, bind,
              JuliaLean.base.boot.throwObj, JuliaLean.base.boot.objV, throw, throwThe] <;> rfl

private theorem callableRuntime (name : ClosureName) : CallableRuntime name := by
  intro W L core bindings arguments world
  exact ⟨rfl, rfl, applicationLaw name core bindings arguments world⟩

private theorem forwardRuntime (name : ClosureName) : ForwardRuntime name := by
  unfold ForwardRuntime
  intros
  cases name <;>
    simp [ReturnsLastAfter, successfulReplies, observingOps, observe,
      entry, broadcastAnd, broadcastOr, closure, List.ofFn_succ, List.ofFn_zero,
      Fin.forall_fin_succ, bind, pure, List.append_assoc]

private theorem passedCallableRuntime (name : ClosureName) : PassedCallableRuntime name := by
  intro W L core bindings arguments left right world
  cases name <;> exact applicationLaw _ core bindings arguments world

