namespace JuliaLean.Proofs.base.broadcast.Models2Group5.MaskedFill

open JuliaLean
open JuliaLean.Registry
open JuliaLean.base.expr (Value)
open JuliaLean.base.boot (CoreOps CoreM)
open JuliaLean.base.broadcast.Models2Group5.MaskedFill
open JuliaLean.Proofs.base.broadcast.Models2Group5.IndexAccess.ContextObservations
open JuliaLean.Proofs.base.broadcast.Models2Group5.ForwardObservations (Event Reply ReturnsLastAfter)

/-- Proof observations preserve both compiler contexts, all actual runtime
calls, and the builtin for-result projections. Selection is pure metadata
read from the current payload after the preceding source operation. -/
def observingFill {W L : Type} (core : Bool → CoreOps (World W L) L)
    (binarySelection : Binary → Value L → Value L → W → BinaryMethod)
    (unarySelection : Value L → W → UnaryMethod) : ContextOps (World W L) L where
  inContext := fun context =>
    { toCoreOps :=
        { core context with
          call := fun function arguments => observe context (.call function arguments)
          getfield := fun value field => observe context (.getfield value field) }
      selectedBinary := fun operation left right world =>
        binarySelection operation left right world.payload
      selectedUnary := fun value world => unarySelection value world.payload }

/-- The source's fixed initial provenance, before any word is accessed.
Only property reads precede the explicit inbounds region. -/
def initialEvents {W L : Type} (core : CoreOps W L) (bindings : Bindings L)
    (value : Value L) (values : Nat → Value L) : List (ContextEvent L) :=
  [call true bindings.getproperty [value, .symbol "parent"],
   call true bindings.getproperty [values 0, .symbol "chunks"],
   call true bindings.getproperty [value, .symbol "mask"],
   call true bindings.getproperty [values 2, .symbol "chunks"],
   call false bindings.length [values 1],
   call false bindings.colon [JuliaLean.base.boot.intV core (JInt.lit .i64 1), values 4],
   call false bindings.iterate [values 5]]

/-- A full-domain completion invariant independent of any native-array or
operator assumption. Every completion consumes only an actual prefix of the
runtime replies, preserves the remaining script and exact mutation world,
starts with the prescribed parent/mask/range provenance, and stops on the
first thrown reply. Success returns the original B reference and follows an
actual iterator-exhaustion result. Aliased references are not copied and no
successful getter, iterator or operator behavior is assumed.
Source: base/broadcast.jl:1272-1285. -/
def CompletionInvariant : Prop :=
  ∀ {W L : Type} (core : Bool → CoreOps (World W L) L)
      (binarySelection : Binary → Value L → Value L → W → BinaryMethod)
      (unarySelection : Value L → W → UnaryMethod)
      (bindings : Bindings L) (original : Value L) (bit : Bool) (before : World W L),
    let action := fill (observingFill core binarySelection unarySelection) bindings original bit
    match action before with
    | none => True
    | some (.error (error, after)) =>
        ∃ (count : Nat) (values : Nat → Value L) (worlds : Nat → W)
            (trace : List (ContextEvent L)),
          0 < count ∧ before.replies = successes (count - 1) values worlds ++
            [.thrown error after.payload] ++ after.replies ∧
          after.events = before.events ++ trace ∧ trace.length = count ∧
          trace.take 7 = (initialEvents (core false) bindings original values).take count
    | some (.ok (result, after)) =>
        ∃ (count : Nat) (values : Nat → Value L) (worlds : Nat → W)
            (trace front : List (ContextEvent L)) (lastArguments : List (Value L)),
          7 ≤ count ∧ before.replies = successes count values worlds ++ after.replies ∧
          after.payload = worlds (count - 1) ∧ after.events = before.events ++ trace ∧
          trace.length = count ∧ result = original ∧
          trace.take 7 = initialEvents (core false) bindings original values ∧
          trace = front ++ [call false bindings.iterate lastArguments] ∧
          (lastArguments = [values 5] ∨ ∃ state, lastArguments = [values 5, state]) ∧
          (core false).same (values (count - 1))
            (JuliaLean.base.boot.nothingV (core false)) = true

/-- The mathematical truth value of a single UInt64 bit. This reads the
unsigned numeric value and does not invoke the model's bitwise operators. -/
def wordBit (word : JInt .u64) (position : Nat) : Bool :=
  (word.val.toNat / 2 ^ position) % 2 == 1

/-- Independent per-bit specification: an unmasked position keeps its old
bit, while a masked position becomes the requested Bool. Reconstructing the
word from these 64 truth values avoids restating OR/AND/complement code. -/
def maskedBits (bit : Bool) (old mask : JInt .u64) : JInt .u64 :=
  JInt.lit .u64 (((List.range 64).foldl (fun total position =>
    if (if wordBit mask position then bit else wordBit old position) then
      total + 2 ^ position else total) (0 : Nat)) : Int)

/-- Native word replies occupy the two source getter positions of each
six-operation iteration. Every other reply, including iterator/state values,
setter returns and all worlds, remains arbitrary. -/
def nativeValues {W L : Type} (core : CoreOps W L) (values : Nat → Value L)
    (oldWords maskWords : Nat → JInt .u64) (position : Nat) : Value L :=
  if 9 ≤ position ∧ (position - 9) % 6 = 0 then
    JuliaLean.base.boot.intV core (oldWords ((position - 9) / 6))
  else if 10 ≤ position ∧ (position - 10) % 6 = 0 then
    JuliaLean.base.boot.intV core (maskWords ((position - 10) / 6))
  else values position

/-- Flat contextual trace for native-word iterations. Setter arguments use
the independent truth-table word and the exact previously obtained index;
each later word read therefore occurs only after all earlier setters. -/
def nativeEvents {W L : Type} (core : CoreOps W L) (bindings : Bindings L)
    (original : Value L) (bit : Bool) (values : Nat → Value L)
    (oldWords maskWords : Nat → JInt .u64) (steps : Nat) : List (ContextEvent L) :=
  initialEvents core bindings original values ++
  (List.range steps).flatMap (fun step =>
    [⟨false, .getfield (values (6 + 6 * step))
        (JuliaLean.base.boot.intV core (JInt.lit .i64 1))⟩,
     ⟨false, .getfield (values (6 + 6 * step))
        (JuliaLean.base.boot.intV core (JInt.lit .i64 2))⟩,
     call false bindings.getindex [values 1, values (7 + 6 * step)],
     call false bindings.getindex [values 3, values (7 + 6 * step)],
     call false bindings.setindex
       [values 1, JuliaLean.base.boot.intV core (maskedBits bit (oldWords step) (maskWords step)),
        values (7 + 6 * step)],
     call false bindings.iterate [values 5, values (8 + 6 * step)]])

/-- Native selection at the current observation cursor is a concrete
instantiation of the existing dispatch metadata, not a callee correctness
premise. The source's complement is pure and therefore cannot move the cursor
between false-branch complement and intersection. -/
def nativeContexts {W L : Type} (core : Bool → CoreOps (World (Nat × W) L) L)
    (oldWords maskWords : Nat → JInt .u64) : ContextOps (World (Nat × W) L) L :=
  observingFill core
    (fun operation _ _ payload =>
      let step := (payload.1 - 11) / 6
      match operation with
      | .union => .native (oldWords step) (maskWords step)
      | .intersection => .native (oldWords step) (JuliaLean.base.int.bnot (maskWords step)))
    (fun _ payload => .native (maskWords ((payload.1 - 11) / 6)))

/-- Arbitrary-depth native-word law with an independent per-bit result.
The first exhausted iterator reply within any finite window determines the
exact terminal prefix. Every earlier failure/divergence position is tested,
and a window with no exhaustion cannot fabricate a completed result. Native
words and worlds may vary independently at every iteration, so overlapping
parent/mask aliases and earlier writes are represented by their current-world
read replies rather than snapshots. Getter/setter/iterator correctness is
never assumed. Source: base/broadcast.jl:1272-1285. -/
def NativeLoopObservations : Prop :=
  ∀ {W L : Type} (core : Bool → CoreOps (World (Nat × W) L) L)
      (bindings : Bindings L) (original : Value L) (bit : Bool)
      (rawValues : Nat → Value L) (worlds : Nat → W)
      (oldWords maskWords : Nat → JInt .u64) (initial : W)
      (history : List (ContextEvent L)) (suffix : List (Reply (Nat × W) L)) (window : Nat),
    let values := nativeValues (core false) rawValues oldWords maskWords
    let payloads := fun position => (position + 1, worlds position)
    let action := fill (nativeContexts core oldWords maskWords) bindings original bit
    match (List.range (window + 1)).find? (fun step =>
      (core false).same (values (6 + 6 * step)) (JuliaLean.base.boot.nothingV (core false))) with
    | none =>
        ContinuesAfter action (7 + 6 * window) values payloads
          (nativeEvents (core false) bindings original bit values oldWords maskWords window)
          (0, initial) history suffix
    | some steps =>
        let count := 7 + 6 * steps
        let successful := successes count values payloads
        let prescribed := nativeEvents (core false) bindings original bit values oldWords maskWords steps
        let before : World (Nat × W) L := ⟨(0, initial), successful ++ suffix, history⟩
        let after : World (Nat × W) L := ⟨payloads (count - 1), suffix, history ++ prescribed⟩
        steps ≤ window ∧ prescribed.length = count ∧
        action before = some (.ok (original, after)) ∧
        FailurePrefixes action successful prescribed (0, initial) history suffix

/-- A genuine selected non-UInt64 operator remains the actual source call,
with unchanged operand identity and complete arbitrary return/error/world/
divergence behavior. No native-word condition is imposed on these paths. -/
def CustomOperatorObservations : Prop :=
  (∀ {W L : Type} (bindings : Bindings L) (operation : Binary) (left right : Value L),
    ReturnsLastAfter (W := W) (L := L) 0
      (fun core => binary
        { toCoreOps := core, selectedBinary := fun _ _ _ _ => .custom,
          selectedUnary := fun _ _ => .custom } bindings operation left right)
      (fun _ _ _ _ =>
        [.call (match operation with | .union => bindings.union | .intersection => bindings.intersection)
          [left, right]])) ∧
  (∀ {W L : Type} (bindings : Bindings L) (word : Value L),
    ReturnsLastAfter (W := W) (L := L) 0
      (fun core => complement
        { toCoreOps := core, selectedBinary := fun _ _ _ _ => .custom,
          selectedUnary := fun _ _ => .custom } bindings word)
      (fun _ _ _ _ => [.call bindings.complement [word]]))

def RuntimeInvariant : Prop :=
  CompletionInvariant ∧ NativeLoopObservations ∧ CustomOperatorObservations

def proposedEntries : List Entry := [
  { id := "broadcast-masked-fill-current-world-bits", juliaFile := "base/broadcast.jl",
    juliaFns := ["Base.fill!(B::BitMaskedBitArray, b::Bool)"],
    statement := "Masked fill retains the original parent/mask references and exact source contexts, reads each current word before its setter and subsequent iteration, and returns the original B. On native UInt64 words each masked bit becomes b and every unmasked bit is preserved; arbitrary finite loop prefixes retain every error/divergence and current mutation world, including aliases. Genuine different operator methods keep their actual selected outcomes.",
    source := "base/broadcast.jl:1272-1285; doc/src/manual/interfaces.md:29-54 (iteration protocol)",
    status := .todo,
    prop := ``JuliaLean.Proofs.base.broadcast.Models2Group5.MaskedFill.RuntimeInvariant,
    thm := none,
    notes := "Open: NativeLoopObservations needs a fixed-point prefix induction relating six-call current-world iterations to nativeEvents; CompletionInvariant also needs bor/band/bnot per-bit preservation." }
]

end JuliaLean.Proofs.base.broadcast.Models2Group5.MaskedFill


namespace JuliaLean.Proofs.base.broadcast.Models2Group5.SyntaxBoundary

open JuliaLean.Registry
open JuliaLean.base.expr (Value)
open JuliaLean.base.boot (CoreOps)
open JuliaLean.base.broadcast.Models2Group5.SyntaxBoundary
open JuliaLean.Proofs.base.broadcast.Models2Group5.ForwardObservations (Reply)
open JuliaLean.Proofs.base.broadcast.Models2Group5.IndexAccess.ContextObservations

/-- The forwarding boundary supplies the original native tuple slots once,
in order, with the original propagated context. The complete chosen outcome
is retained: success returns the selected reply identity, failure returns its
original error and mutation world, and divergence prevents any continuation.
This quantifies every constructible heterogeneous/empty argument tuple and
all actual callee outcomes, without modeling or constraining maybeview's own
separately dispatched algorithm. Source: base/broadcast.jl:1297. -/
def RuntimeContract : Prop :=
  ∀ {W L : Type} (core : Bool → CoreOps (World W L) L)
      (maybeView : Value L)
      (arguments : JuliaLean.base.broadcast.Models2Group5.Constructors.ArgumentTuple L)
      (boundscheck : Bool) (values : Nat → Value L) (worlds : Nat → W)
      (initial : W) (history : List (ContextEvent L)) (suffix : List (Reply W L)),
    ReturnsLast (dotview (observingContexts core) maybeView arguments boundscheck)
      1 values worlds [call boundscheck maybeView arguments.values]
      initial history suffix

theorem runtimeContract : RuntimeContract := by
  unfold RuntimeContract
  intros
  simp [ReturnsLast, FailurePrefixes, successes, List.range_succ,
    Fin.forall_fin_succ, dotview, JuliaLean.base.broadcast.Syntax.m1297,
