namespace JuliaLean.Proofs.base.broadcast.Models2Group5.KeywordBroadcast

open JuliaLean
open JuliaLean.Registry
open JuliaLean.base.expr (Value)
open JuliaLean.base.boot (CoreOps CoreM)
open JuliaLean.base.broadcast.Models2Group5.KeywordBroadcast
open JuliaLean.Proofs.base.broadcast.Models2Group5.ForwardObservations

/-- The macro preserves original input identity into the actual transform,
then passes its exact reply to esc. The second call never runs after failure
or divergence; no finite-AST, allocation or escape success law is assumed.
Source: base/broadcast.jl:1390-1392. -/
def MacroObservations : Prop :=
  ∀ {W L : Type} (bindings : Bindings L) (value : Value L),
    ReturnsLastAfter (W := W) (L := L) 1
      (fun core => dotMacro core bindings value)
      (fun _ values _ _ =>
        [.call bindings.dotTransform [value], .call bindings.esc [values 0]])

namespace KeywordProbe

/-- Proof records retain the actual keyword object and target function,
instead of erasing them into positional calls or a keyword-emptiness flag. -/
inductive Event (L : Type) where
  | runtime (event : JuliaLean.Proofs.base.broadcast.Models2Group5.ForwardObservations.Event L)
  | keyword (function : Value L) (arguments : List (Value L)) (kwargs : Value L)
  | broadcastClosure (function : Value L) (captures : KeywordClosure L) (identity : Value L)
      (arguments : JuliaLean.base.broadcast.Models2Group5.CombineAxes.Tail L)

structure World (W L : Type) where
  payload : W
  replies : List (Reply W L)
  events : List (Event L)

def observe {W L : Type} (event : Event L) : CoreM (World W L) L (Value L) := fun world =>
  match world.replies with
  | [] => none
  | .diverged :: _ => none
  | .returned value payload :: remaining =>
      some (.ok (value, ⟨payload, remaining, world.events ++ [event]⟩))
  | .thrown error payload :: remaining =>
      some (.error (error, ⟨payload, remaining, world.events ++ [event]⟩))

def observing {W L : Type} (core : CoreOps (World W L) L)
    (embedding : KeywordClosure L → Value L) : KeywordOps (World W L) L where
  toCoreOps :=
    { core with
      call := fun function arguments => observe (.runtime (.call function arguments))
      applyIterate := fun iterate arguments => observe (.runtime (.splat iterate arguments)) }
  closureValue := embedding
  keywordCall := fun function arguments kwargs => observe (.keyword function arguments kwargs)
  broadcastClosure := fun function callable arguments =>
    observe (.broadcastClosure function callable.captures callable.identity arguments)

def successes {W L : Type} (count : Nat) (values : Nat → Value L)
    (worlds : Nat → W) : List (Reply W L) :=
  (List.range count).map (fun position => .returned (values position) (worlds position))

/-- Generic complete exceptional-prefix observation, independent of any
keyword-broadcast body or callee algorithm. -/
def FailurePrefixes {W L : Type} (action : CoreM (World W L) L (Value L))
    (successful : List (Reply W L)) (prescribed : List (Event L))
    (initial : W) (history : List (Event L)) (suffix : List (Reply W L)) : Prop :=
  (∀ (position : Fin successful.length) (error : Value L) (failed : W),
    let remaining := successful.drop (position.val + 1) ++ suffix
    let before : World W L :=
      ⟨initial, successful.take position.val ++ [.thrown error failed] ++ remaining, history⟩
    let after : World W L := ⟨failed, remaining, history ++ prescribed.take (position.val + 1)⟩
    action before = some (.error (error, after))) ∧
  (∀ position : Fin successful.length,
    let before : World W L :=
      ⟨initial, successful.take position.val ++ [.diverged] ++
        successful.drop (position.val + 1) ++ suffix, history⟩
    action before = none)

def ReturnsLast {W L : Type} (action : CoreM (World W L) L (Value L))
    (count : Nat) (values : Nat → Value L) (worlds : Nat → W)
    (prescribed : List (Event L)) (initial : W)
    (history : List (Event L)) (suffix : List (Reply W L)) : Prop :=
  let successful := successes count values worlds
  let before : World W L := ⟨initial, successful ++ suffix, history⟩
  let after : World W L := ⟨worlds (count - 1), suffix, history ++ prescribed⟩
  0 < count ∧ prescribed.length = count ∧
  action before = some (.ok (values (count - 1), after)) ∧
  FailurePrefixes action successful prescribed initial history suffix

end KeywordProbe

/-- Every native-bounded arity of the generated vararg callable reaches the
captured function with exactly those positional arguments and the same full
keyword object. All returned values, exception identities, mutation worlds
and divergence are arbitrary. The source code/capture identity is retained
at the outer runtime embedding; no closure body is supplied by a caller.
Source: base/broadcast.jl:1394-1400;
doc/src/manual/functions.md:1126-1127 (keywords pass through each scalar call). -/
def KeywordClosureObservations : Prop :=
  ∀ {W L : Type} (core : CoreOps (KeywordProbe.World W L) L)
      (embedding : KeywordClosure L → Value L) (function kwargs : Value L)
      (arguments : JuliaLean.base.broadcast.Models2Group5.Constructors.ArgumentTuple L)
      (values : Nat → Value L) (worlds : Nat → W) (initial : W)
      (history : List (KeywordProbe.Event L)) (suffix : List (Reply W L)),
    KeywordProbe.ReturnsLast
      (invokeKeywordClosure (KeywordProbe.observing core embedding)
        ⟨.source1394, function, kwargs⟩ arguments)
      1 values worlds [.keyword function arguments.values kwargs] initial history suffix

def booleanView {W L : Type} (core : CoreOps W L) : Value L → Option Bool
  | .leaf value => core.asBool value
  | _ => none

/-- Keyword emptiness is an actual dispatched query, not a pre-extracted flag.
A true reply preserves f itself; false embeds the nominal source1394 callable
with the exact f and collected kwargs. Both branches retain the original
argument tuple. A non-Bool emptiness reply raises the precise if-context TypeError at
that world before any broadcasted invocation; earlier errors/divergence also
stop immediately. All embeddings, keyword values, native tuples, replies,
worlds and histories are universally quantified, without callee laws.
Source: base/broadcast.jl:1394-1400. -/
def KeywordSyntaxObservations : Prop :=
  ∀ {W L : Type} (core : CoreOps (KeywordProbe.World W L) L)
      (embedding : KeywordClosure L → Value L) (bindings : Bindings L)
      (function kwargs : Value L)
      (arguments : JuliaLean.base.broadcast.Models2Group5.CombineAxes.Tail L)
      (values : Nat → Value L) (worlds : Nat → W) (initial : W)
      (history : List (KeywordProbe.Event L)) (suffix : List (Reply W L)),
    let action := keywordSyntax (KeywordProbe.observing core embedding)
      bindings function arguments kwargs
    let first : KeywordProbe.Event L := .runtime (.call bindings.isempty [kwargs])
    match booleanView core (values 0) with
    | none =>
        let successful := KeywordProbe.successes 1 values worlds
        let before : KeywordProbe.World W L := ⟨initial, successful ++ suffix, history⟩
        let after : KeywordProbe.World W L := ⟨worlds 0, suffix, history ++ [first]⟩
        action before = some (.error
          (JuliaLean.base.boot.objV core (.typeError (.symbol "if")
            (JuliaLean.base.boot.strV core "") (JuliaLean.base.boot.coreV core "Bool") (values 0)),
           after)) ∧
        KeywordProbe.FailurePrefixes action successful [first] initial history suffix
    | some true =>
        KeywordProbe.ReturnsLast action 2 values worlds
          [first, .runtime (.splat bindings.iterate
            [bindings.broadcasted, JuliaLean.base.boot.tupleV core [function],
              JuliaLean.base.boot.tupleV core arguments.values])]
          initial history suffix
    | some false =>
        let captures : KeywordClosure L := ⟨.source1394, function, kwargs⟩
        KeywordProbe.ReturnsLast action 2 values worlds
          [first, .broadcastClosure bindings.broadcasted captures (embedding captures) arguments]
          initial history suffix

/-- Exercise the actual callable received by a selected higher-order callee,
rather than merely comparing a nominal runtime embedding. This concrete
broadcasted instantiation invokes its received callable at any independently
chosen native arity; the resulting operation must use the original captured f
and full kwargs, with exact invoked arguments and all arbitrary outcomes.
The normal outer contract separately observes original broadcast arguments
and runtime identity. No correctness law is imposed on an unknown callee.
Source: base/broadcast.jl:1394-1400. -/
def ReceivedCallableInvokesCapturedFunction : Prop :=
  ∀ {W L : Type} (core : CoreOps (KeywordProbe.World W L) L)
      (embedding : KeywordClosure L → Value L) (bindings : Bindings L)
      (function kwargs : Value L)
      (arguments : JuliaLean.base.broadcast.Models2Group5.CombineAxes.Tail L)
      (invocation : JuliaLean.base.broadcast.Models2Group5.Constructors.ArgumentTuple L)
      (values : Nat → Value L) (worlds : Nat → W) (initial : W)
      (history : List (KeywordProbe.Event L)) (suffix : List (Reply W L)),
    let base := KeywordProbe.observing core embedding
    let ops : KeywordOps (KeywordProbe.World W L) L :=
      { base with broadcastClosure := fun _ callable _ => callable.invoke invocation }
    match booleanView core (values 0) with
    | some false =>
        KeywordProbe.ReturnsLast (keywordSyntax ops bindings function arguments kwargs)
          2 values worlds
          [.runtime (.call bindings.isempty [kwargs]), .keyword function invocation.values kwargs]
          initial history suffix
    | _ => True

def KeywordRuntimeInvariant : Prop :=
  KeywordClosureObservations ∧ KeywordSyntaxObservations ∧ ReceivedCallableInvokesCapturedFunction

private theorem closureObservations : KeywordClosureObservations := by
  intro W L core embedding function kwargs arguments values worlds initial history suffix
  simp [KeywordProbe.ReturnsLast, KeywordProbe.FailurePrefixes, KeywordProbe.successes,
    List.range_succ, invokeKeywordClosure, KeywordProbe.observing, KeywordProbe.observe]
private theorem boolContext {W L : Type}
    (core : CoreOps W L) (value : Value L) (world : W) :
    JuliaLean.base.broadcast.Models2Group5.CheckedBounds.booleanContext core value world =
      match booleanView core value with
      | some flag => some (.ok (flag, world))
      | none => some (.error (JuliaLean.base.boot.objV core (.typeError (.symbol "if")
          (JuliaLean.base.boot.strV core "") (JuliaLean.base.boot.coreV core "Bool") value), world)) := by
  cases value <;> try rfl
  rename_i leaf
  cases h : core.asBool leaf <;>
    simp [JuliaLean.base.broadcast.Models2Group5.CheckedBounds.booleanContext,
      booleanView, h] <;> rfl

private theorem syntaxObservations : KeywordSyntaxObservations := by
  intro W L core embedding bindings function kwargs arguments values worlds initial history suffix
  dsimp only
  cases hf : booleanView core (values 0) with
  | none =>
    simp only [booleanView] at hf
    simp [KeywordProbe.FailurePrefixes, KeywordProbe.successes, List.range_succ, keywordSyntax, keywordCallable, invokeKeywordClosure, KeywordProbe.observing, KeywordProbe.observe, boolContext, booleanView, hf, Bind.bind, Pure.pure, List.append_assoc, JuliaLean.base.boot.tupleV, JuliaLean.base.boot.objV, JuliaLean.base.boot.strV, JuliaLean.base.boot.coreV]
  | some flag =>
    cases flag <;> simp only [booleanView] at hf
    all_goals
      refine ⟨by decide, rfl, ?_, ?_, ?_⟩
      · simp [KeywordProbe.successes, List.range_succ, keywordSyntax, keywordCallable, invokeKeywordClosure, KeywordProbe.observing, KeywordProbe.observe, boolContext, booleanView, hf, Bind.bind, Pure.pure, List.append_assoc, JuliaLean.base.boot.tupleV]
      · intro position error failureWorld
        rcases position with ⟨p, hp⟩
        have cases : p = 0 ∨ p = 1 := by
          simp [KeywordProbe.successes] at hp
          omega
        rcases cases with rfl | rfl <;> simp [KeywordProbe.successes, List.range_succ, keywordSyntax, keywordCallable, invokeKeywordClosure, KeywordProbe.observing, KeywordProbe.observe, boolContext, booleanView, hf, Bind.bind, Pure.pure, List.append_assoc, JuliaLean.base.boot.tupleV]
      · intro position
        rcases position with ⟨p, hp⟩
        have cases : p = 0 ∨ p = 1 := by
          simp [KeywordProbe.successes] at hp
          omega
        rcases cases with rfl | rfl <;> simp [KeywordProbe.successes, List.range_succ, keywordSyntax, keywordCallable, invokeKeywordClosure, KeywordProbe.observing, KeywordProbe.observe, boolContext, booleanView, hf, Bind.bind, Pure.pure, List.append_assoc, JuliaLean.base.boot.tupleV]

private theorem receivedCallable : ReceivedCallableInvokesCapturedFunction := by
  intro W L core embedding bindings function kwargs arguments invocation values worlds initial history suffix
  dsimp only
  cases hf : booleanView core (values 0) with
  | none => trivial
  | some flag =>
    cases flag with
    | true => trivial
    | false =>
      simp only [booleanView] at hf
      refine ⟨by decide, rfl, ?_, ?_, ?_⟩
      · simp [KeywordProbe.successes, List.range_succ, keywordSyntax, keywordCallable, invokeKeywordClosure, KeywordProbe.observing, KeywordProbe.observe, boolContext, booleanView, hf, Bind.bind, Pure.pure, List.append_assoc, JuliaLean.base.boot.tupleV]
      · intro position error failureWorld
        rcases position with ⟨p, hp⟩
        have cases : p = 0 ∨ p = 1 := by
          simp [KeywordProbe.successes] at hp
          omega
        rcases cases with rfl | rfl <;> simp [KeywordProbe.successes, List.range_succ, keywordSyntax, keywordCallable, invokeKeywordClosure, KeywordProbe.observing, KeywordProbe.observe, boolContext, booleanView, hf, Bind.bind, Pure.pure, List.append_assoc, JuliaLean.base.boot.tupleV]
      · intro position
        rcases position with ⟨p, hp⟩
        have cases : p = 0 ∨ p = 1 := by
          simp [KeywordProbe.successes] at hp
          omega
        rcases cases with rfl | rfl <;> simp [KeywordProbe.successes, List.range_succ, keywordSyntax, keywordCallable, invokeKeywordClosure, KeywordProbe.observing, KeywordProbe.observe, boolContext, booleanView, hf, Bind.bind, Pure.pure, List.append_assoc, JuliaLean.base.boot.tupleV]

theorem keywordRuntimeInvariant : KeywordRuntimeInvariant :=
  ⟨closureObservations, syntaxObservations, receivedCallable⟩

/-- Generic broadcast construction preserves f through both branches. Empty
arguments execute the concrete zero-rank style constructor without calling
broadcastable; nonempty tuples pass the same actual mapped container into
style selection and final broadcasted splatting, with style before f. Every
operation can return an arbitrary object, mutate, throw or diverge; all such
prefixes and exact selected-constructor worlds are covered.
Source: base/broadcast.jl:1401-1404,431; base/tuple.jl:358. -/
def GenericBroadcastObservations : Prop :=
  ∀ {W L : Type} (bindings : Bindings L) (function : Value L)
      (arguments : JuliaLean.base.broadcast.Models2Group5.CombineAxes.Tail L)
      (select : Value L → W → JuliaLean.base.broadcast.Models2Group5.DefaultStyle.ConstructorMethod),
    let action := fun core : CoreOps (ProbeWorld W L) L =>
      broadcastedGeneric
        { toCoreOps := core, selectedConstructor := fun value world => select value world.payload }
        bindings function arguments
    match arguments.values with
    | [] =>
        ReturnsLastAfter (W := W) (L := L) 2 action
          (fun core values worlds _ =>
            [.applyType bindings.defaultArrayStyle [JuliaLean.base.boot.intV core (JInt.lit .i64 0)],
             (match select (values 0) (worlds 0) with
               | .builtin => .newObject (values 0) []
               | .custom => .call (values 0) []),
             .call bindings.broadcasted [values 1, function]])
    | _ :: _ =>
        ReturnsLastAfter (W := W) (L := L) 2 action
          (fun core values _ _ =>
            [.call bindings.map [bindings.broadcastable, JuliaLean.base.boot.tupleV core arguments.values],
             .splat bindings.iterate [bindings.combineStyles, values 0],
             .splat bindings.iterate
               [bindings.broadcasted, JuliaLean.base.boot.tupleV core [values 1, function], values 0]])

theorem genericBroadcastObservations : GenericBroadcastObservations := by
  intro W L bindings function arguments select
  cases h : arguments.values with
  | nil =>
      simp only [h]
      unfold ReturnsLastAfter
      intro core values worlds initial history suffix
      cases hs : select (values 0) (worlds 0) <;>
        simp [successfulReplies, List.ofFn_succ, List.ofFn_zero,
          Fin.forall_fin_succ, broadcastedGeneric, h,
          JuliaLean.base.tuple.mapOneEmpty,
          JuliaLean.base.broadcast.Models2Group5.Constructors.combineEmpty,
          JuliaLean.base.broadcast.Models2Group5.DefaultStyle.callConstructor,
          JuliaLean.base.broadcast.Models2Group5.DefaultStyle.defaultStyleNew,
          observingOps, observe, Bind.bind, Pure.pure, List.append_assoc,
          JuliaLean.base.boot.intV, hs]
  | cons head tail =>
      simp [h, ReturnsLastAfter, successfulReplies, List.ofFn_succ,
        List.ofFn_zero, Fin.forall_fin_succ, broadcastedGeneric,
        observingOps, observe, Bind.bind, List.append_assoc,
        JuliaLean.base.boot.tupleV]

/-- Dotted BroadcastFunction invocation retains the exact queried f, original
argument tuple and complete collected keyword object in the actual selected
keyword call, then materializes its actual result. A failure at any step
preserves its exception/stream world and prevents later calls. No implicit
scalar mapping, fixed broadcast representation or keyword merge is assumed.
Source: base/broadcast.jl:1452; devdocs/functions.md:124-184. -/
def BroadcastFunctionObservations : Prop :=
  ∀ {W L : Type} (core : CoreOps (KeywordProbe.World W L) L)
      (embedding : KeywordClosure L → Value L) (bindings : Bindings L)
      (operator kwargs : Value L)
      (arguments : JuliaLean.base.broadcast.Models2Group5.Constructors.ArgumentTuple L)
      (values : Nat → Value L) (worlds : Nat → W) (initial : W)
      (history : List (KeywordProbe.Event L)) (suffix : List (Reply W L)),
    KeywordProbe.ReturnsLast
      (broadcastFunction (KeywordProbe.observing core embedding) bindings operator arguments kwargs)
      3 values worlds
      [.runtime (.call bindings.getproperty [operator, .symbol "f"]),
       .keyword bindings.broadcastedKeyword (values 0 :: arguments.values) kwargs,
       .runtime (.call bindings.materialize [values 1])]
      initial history suffix

namespace ShowProbe

def successes {W L : Type} (count : Nat) (values : Nat → Value L)
    (worlds : Nat → W) : List (Reply W L) :=
  (List.range count).map (fun position => .returned (values position) (worlds position))

def FailurePrefixes {W L : Type} (action : CoreM (ProbeWorld W L) L (Value L))
    (successful : List (Reply W L)) (prescribed : List (Event L))
    (initial : W) (history : List (Event L)) (suffix : List (Reply W L)) : Prop :=
  (∀ (position : Fin successful.length) (error : Value L) (failed : W),
    let remaining := successful.drop (position.val + 1) ++ suffix
    let before : ProbeWorld W L :=
      ⟨initial, successful.take position.val ++ [.thrown error failed] ++ remaining, history⟩
    let after : ProbeWorld W L := ⟨failed, remaining, history ++ prescribed.take (position.val + 1)⟩
    action before = some (.error (error, after))) ∧
  (∀ position : Fin successful.length,
    let before : ProbeWorld W L :=
      ⟨initial, successful.take position.val ++ [.diverged] ++
        successful.drop (position.val + 1) ++ suffix, history⟩
    action before = none)

def observing {W L : Type} (core : CoreOps (ProbeWorld W L) L)
    (select : Value L → Value L → W → ShowMethod) : ShowOps (ProbeWorld W L) L where
  toCoreOps := observingOps core
  selectedShow := fun io value world => select io value world.payload

def isOther : ShowMethod → Bool
  | .same => false
  | .other => true

/-- The first wrapper is supplied by the caller; every later wrapper is the
exact preceding f property reply. -/
def wrapperAt {L : Type} (original : Value L) (values : Nat → Value L) : Nat → Value L
  | 0 => original
  | step + 1 => values (2 * (step + 1) - 1)

/-- Flat descent grammar: each wrapper prints its type/opening Char before
reading its f. No recursive expected interpreter is used. -/
def descent {L : Type} (bindings : Bindings L) (io original : Value L)
    (values : Nat → Value L) (frames : Nat) : List (Event L) :=
  (List.range frames).flatMap (fun step =>
    [.call bindings.print [io, bindings.broadcastFunctionType, bindings.leftParen],
     .call bindings.getproperty [wrapperAt original values step, .symbol "f"]])

end ShowProbe

/-- Every finite nested-wrapper display prefix has two descent operations
per wrapper, one actual terminal different show call, and one closing print
per wrapper on return. The first different selected show is determined in
the world after its f query; cycles need not have a finite terminal. Success
returns nothing, regardless of arbitrary print/show reply values. Every
operation's exception preserves exactly the emitted prefix and its actual
world, so errors neither erase earlier IO nor print later closing characters.
No fixed render string, nonrecursive callable assumption, or renderer callback
replaces the source body. Source: base/broadcast.jl:1454-1459. -/
def ShowFunctionObservations : Prop :=
  ∀ {W L : Type} (core : CoreOps (ProbeWorld W L) L)
      (select : Value L → Value L → W → ShowMethod) (bindings : Bindings L)
      (io operator : Value L) (values : Nat → Value L) (worlds : Nat → W)
      (initial : W) (history : List (Event L)) (suffix : List (Reply W L)) (window : Nat),
    let action := showFunction (ShowProbe.observing core select) bindings io operator
    match (List.range (window + 1)).find? (fun depth =>
      ShowProbe.isOther (select io (values (2 * depth + 1)) (worlds (2 * depth + 1)))) with
    | none =>
        let count := 2 * (window + 1)
        let successful := ShowProbe.successes count values worlds
        let prescribed := ShowProbe.descent bindings io operator values (window + 1)
        let exhausted : ProbeWorld W L := ⟨initial, successful, history⟩
        prescribed.length = count ∧ action exhausted = none ∧
        ShowProbe.FailurePrefixes action successful prescribed initial history suffix
    | some depth =>
        let frames := depth + 1
        let count := 3 * frames + 1
        let successful := ShowProbe.successes count values worlds
        let prescribed := ShowProbe.descent bindings io operator values frames ++
          [.call bindings.showFn [io, values (2 * frames - 1)]] ++
          (List.range frames).map (fun _ => .call bindings.print [io, bindings.rightParen])
        let before : ProbeWorld W L := ⟨initial, successful ++ suffix, history⟩
        let after : ProbeWorld W L := ⟨worlds (count - 1), suffix, history ++ prescribed⟩
        depth ≤ window ∧ prescribed.length = count ∧
        action before = some (.ok (JuliaLean.base.boot.nothingV core, after)) ∧
        ShowProbe.FailurePrefixes action successful prescribed initial history suffix

/-- Text/plain forwarding preserves the actual IO/wrapper and complete
selected two-argument show outcome, including custom non-nothing replies,
exceptions after partial output and divergence. Source: base/broadcast.jl:1460. -/
def PlainShowObservations : Prop :=
  ∀ {W L : Type} (bindings : Bindings L) (io operator : Value L),
    ReturnsLastAfter (W := W) (L := L) 0
      (fun core => showPlain core bindings io operator)
      (fun _ _ _ _ => [.call bindings.showFn [io, operator]])

theorem macroObservations : MacroObservations := by
  unfold MacroObservations
  intros
  simp [ReturnsLastAfter, successfulReplies, List.ofFn_succ, List.ofFn_zero,
    Fin.forall_fin_succ, dotMacro, observingOps, observe, Bind.bind,
    List.append_assoc]

theorem plainShowObservations : PlainShowObservations := by
  unfold PlainShowObservations
  intros
  simp [ReturnsLastAfter, successfulReplies, List.ofFn_succ, List.ofFn_zero,
    Fin.forall_fin_succ, showPlain, observingOps, observe, Bind.bind,
    List.append_assoc]

theorem broadcastFunctionObservations : BroadcastFunctionObservations := by
  intro W L core embedding bindings operator kwargs arguments values worlds initial history suffix
  refine ⟨by decide, rfl, ?_, ?_, ?_⟩
  · simp [KeywordProbe.successes, List.range_succ, broadcastFunction, KeywordProbe.observing, KeywordProbe.observe, Bind.bind, List.append_assoc]
  · intro position error failureWorld
    rcases position with ⟨p, hp⟩
    have cases : p = 0 ∨ p = 1 ∨ p = 2 := by
      simp [KeywordProbe.successes] at hp
      omega
    rcases cases with rfl | rfl | rfl <;> simp [KeywordProbe.successes, List.range_succ, broadcastFunction, KeywordProbe.observing, KeywordProbe.observe, Bind.bind, List.append_assoc]
  · intro position
    rcases position with ⟨p, hp⟩
    have cases : p = 0 ∨ p = 1 ∨ p = 2 := by
      simp [KeywordProbe.successes] at hp
      omega
    rcases cases with rfl | rfl | rfl <;> simp [KeywordProbe.successes, List.range_succ, broadcastFunction, KeywordProbe.observing, KeywordProbe.observe, Bind.bind, List.append_assoc]

