/-- Observe existing calls while keeping world-dependent selected-method
metadata over the arbitrary runtime payload. No selection rule or callee law
is assumed, and no observation script enters the model's Julia arguments. -/
def observingRuntime {W L : Type} (ops : CoreOps (ProbeWorld W L) L)
    (selectError : Value L → W → ErrorMethod)
    (selectException : Value L → W → ExceptionMethod) : Ops (ProbeWorld W L) L where
  toCoreOps := observingOps ops
  selectedError := fun message world => selectError message world.payload
  selectedException := fun message world => selectException message world.payload

/-- Independent source observation of the literal diagnostic and the six
type occurrences in the two conflicting equations. This deliberately does
not call the model's interpolationArguments helper. Source: broadcast.jl:480-484. -/
def interpolationEvent {W L : Type} (ops : CoreOps (ProbeWorld W L) L)
    (bindings : Bindings L) (types : TypeParameters L) : Event L :=
  .call bindings.string
    [JuliaLean.base.boot.strV ops
        "conflicting broadcast rules defined\n  Broadcast.BroadcastStyle(::",
     types.left, JuliaLean.base.boot.strV ops ", ::", types.right,
     JuliaLean.base.boot.strV ops ") = ", types.forward,
     JuliaLean.base.boot.strV ops "()\n  Broadcast.BroadcastStyle(::",
     types.right, JuliaLean.base.boot.strV ops ", ::", types.left,
     JuliaLean.base.boot.strV ops ") = ", types.reverse,
     JuliaLean.base.boot.strV ops
        "()\nOne of these should be undefined (and thus return Broadcast.Unknown)."]

/-- One independent observable diagnostic route. The type is proof data,
not a dispatcher used by the model. terminal.ok is allowed only for an actual
custom error call; the canonical error route always throws. -/
structure ExpectedPath (W L : Type) where
  used : Nat
  events : List (Event L)
  terminal : Except (Value L) (Value L)
  finalWorld : W

/-- Diagnostic outcome and observation requirements for every selected
route, without a correctness assumption about string, error or a constructor.
Canonical ErrorException must retain the exact selected message. A custom
constructor's arbitrary returned value is thrown unchanged. A custom error
method's arbitrary returned value is returned unchanged. A non-AbstractString
interpolation result is rendered again only in the canonical error method.
Selections use the worlds at their actual call positions. This is a finite
observation specification, not an evaluator supplied to the model.
Source: broadcast.jl:479-485; error.jl:47-57; boot.jl:470-473. -/
def expectedPath {W L : Type} (ops : CoreOps (ProbeWorld W L) L)
    (selectError : Value L → W → ErrorMethod)
    (selectException : Value L → W → ExceptionMethod)
    (bindings : Bindings L) (types : TypeParameters L)
    (values : Fin 3 → Value L) (worlds : Fin 3 → W) : ExpectedPath W L :=
  let interpolation := interpolationEvent ops bindings types
  let exceptionType := JuliaLean.base.boot.coreV ops "ErrorException"
  match selectError (values 0) (worlds 0) with
  | .custom =>
      { used := 2,
        events := [interpolation, .call bindings.error [values 0]],
        terminal := .ok (values 1), finalWorld := worlds 1 }
  | .canonicalOne =>
      if ops.isa (values 0) (JuliaLean.base.boot.coreV ops "AbstractString") then
        match selectException (values 0) (worlds 0) with
        | .canonicalAbstractString =>
            { used := 1, events := [interpolation],
              terminal := .error (.leaf (ops.obj (.errorException (values 0)))),
              finalWorld := worlds 0 }
        | .custom =>
            { used := 2,
              events := [interpolation, .call exceptionType [values 0]],
              terminal := .error (values 1), finalWorld := worlds 1 }
      else
        match selectException (values 1) (worlds 1) with
        | .canonicalAbstractString =>
            { used := 2,
              events := [interpolation, .call bindings.string [values 0]],
              terminal := .error (.leaf (ops.obj (.errorException (values 1)))),
              finalWorld := worlds 1 }
        | .custom =>
            { used := 3,
              events := [interpolation, .call bindings.string [values 0],
                .call exceptionType [values 1]],
              terminal := .error (values 2), finalWorld := worlds 2 }

/-- Interpret an independently prescribed terminal observation. This helper
never calls a model or runtime operation. -/
def terminalObservation {W L : Type} (terminal : Except (Value L) (Value L))
    (world : ProbeWorld W L) :
    Option (Except (Value L × ProbeWorld W L) (Value L × ProbeWorld W L)) :=
  match terminal with
  | .error error => some (.error (error, world))
  | .ok value => some (.ok (value, world))

/-- All runtime routes obey the independent diagnostic observation policy.
There is always at least the original interpolation call, and at most three
selected calls. Exact type ordering, literal text, error class/message,
constructor provenance, arbitrary custom-error returns, worlds and call
counts are checked. A failure or divergence at every reachable call is
preserved; every unreachable suffix remains untouched, including scripts
that would throw or diverge if incorrectly reached.

All runtime hooks, selection functions, input type values, operand values,
returned values, errors and worlds are quantified. Branch selection is
metadata, not a callee-correctness premise. In particular rendering failures
may precede the nominal ErrorException, and custom string methods need not
return an AbstractString. Source: broadcast.jl:479-485; error.jl:47-57;
boot.jl:470-473; manual/strings.md:534-573. -/
def RuntimeContract : Prop :=
  ∀ {W L : Type} (ops : CoreOps (ProbeWorld W L) L)
      (selectError : Value L → W → ErrorMethod)
      (selectException : Value L → W → ExceptionMethod)
      (bindings : Bindings L) (types : TypeParameters L)
      (left right forward reverse : Value L)
      (values : Fin 3 → Value L) (worlds : Fin 3 → W)
      (initial : W) (history : List (Event L)) (suffix : List (Reply W L)),
    let action := conflicting (observingRuntime ops selectError selectException)
      bindings types left right forward reverse
    let path := expectedPath ops selectError selectException bindings types values worlds
    let successful := successfulReplies 2 values worlds
    let before : ProbeWorld W L := ⟨initial, successful ++ suffix, history⟩
    let after : ProbeWorld W L :=
      ⟨path.finalWorld, (successful ++ suffix).drop path.used, history ++ path.events⟩
    1 ≤ path.used ∧ path.used ≤ 3 ∧ path.events.length = path.used ∧
    action before = terminalObservation path.terminal after ∧
    (∀ (position : Fin 3) (error : Value L) (failureWorld : W),
      let script := successful.take position.val ++ [.thrown error failureWorld] ++
        successful.drop (position.val + 1) ++ suffix
      let failureBefore : ProbeWorld W L := ⟨initial, script, history⟩
      if position.val < path.used then
        let failureAfter : ProbeWorld W L :=
          ⟨failureWorld, script.drop (position.val + 1),
            history ++ path.events.take (position.val + 1)⟩
        action failureBefore = some (.error (error, failureAfter))
      else
        let unchangedAfter : ProbeWorld W L :=
          ⟨path.finalWorld, script.drop path.used, history ++ path.events⟩
        action failureBefore = terminalObservation path.terminal unchangedAfter) ∧
    (∀ position : Fin 3,
      let script := successful.take position.val ++ [.diverged] ++
        successful.drop (position.val + 1) ++ suffix
      let divergenceBefore : ProbeWorld W L := ⟨initial, script, history⟩
      if position.val < path.used then
        action divergenceBefore = none
      else
        let unchangedAfter : ProbeWorld W L :=
          ⟨path.finalWorld, script.drop path.used, history ++ path.events⟩
        action divergenceBefore = terminalObservation path.terminal unchangedAfter)

/-- Operand payloads cannot affect the diagnostic when the actual four
source type parameters and runtime are fixed. This holds for complete
executions, including rendering effects, arbitrary constructor/error results,
