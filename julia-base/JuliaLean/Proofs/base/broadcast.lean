/-- The asserted linear-index result retains both the constructor's identity
and the source's explicit one-dimensional type check. Success/TypeError is
determined by the final runtime isa, with every earlier boundary outcome
arbitrary. All source failures and divergences stop at their exact positions;
unused script suffixes rule out hidden calls or recovery.
The expected tuple shape is a type-level requirement, not an assumed law for
the user-selected constructor. Source: base/broadcast.jl:265. -/
def LinearIndicesAssertionAndEffects : Prop :=
  ∀ {W L : Type} (ops : CoreOps (ProbeWorld W L) L)
      (bindings : Bindings L) (bc : Value L)
      (values : Fin 3 → Value L) (worlds : Fin 3 → W)
      (initial : W) (history : List (Event L)) (suffix : List (Reply W L)),
    let successful := successfulReplies 2 values worlds
    let prescribed : List (Event L) :=
      [.call bindings.axes [bc],
       .call bindings.linearIndices [values 0],
       .applyType bindings.linearIndices
         [JuliaLean.base.boot.intV ops (JInt.lit .i64 1)]]
    let action := fun state =>
      JuliaLean.base.broadcast.Models2Group5.Forward.linearIndices
        (observingOps ops) bindings bc state
    let before : ProbeWorld W L := ⟨initial, successful ++ suffix, history⟩
    let after : ProbeWorld W L := ⟨worlds 2, suffix, history ++ prescribed⟩
    (if ops.isa (values 1) (values 2) then
       action before = some (.ok (values 1, after))
     else
       action before = some (.error
         (.leaf (ops.obj (.typeError (.symbol "typeassert") (.leaf (ops.str ""))
           (values 2) (values 1))), after))) ∧
    (∀ (position : Fin 3) (error : Value L) (failureWorld : W),
      let remaining := successful.drop (position.val + 1) ++ suffix
      let failBefore : ProbeWorld W L :=
        ⟨initial, successful.take position.val ++ [.thrown error failureWorld] ++ remaining,
          history⟩
      let failAfter : ProbeWorld W L :=
        ⟨failureWorld, remaining, history ++ prescribed.take (position.val + 1)⟩
      action failBefore = some (.error (error, failAfter))) ∧
    (∀ position : Fin 3,
      let divergeBefore : ProbeWorld W L :=
        ⟨initial, successful.take position.val ++ [.diverged] ++
          successful.drop (position.val + 1) ++ suffix, history⟩
      action divergeBefore = none)

