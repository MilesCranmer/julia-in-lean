namespace JuliaLean.Proofs.base.broadcast.Models2Group5.CopyDispatch

open JuliaLean
open JuliaLean.Registry
open JuliaLean.base.expr (Value)
open JuliaLean.base.boot (CoreOps CoreM)
open JuliaLean.base.broadcast.Models2Group5.CopyDispatch
open JuliaLean.Proofs.base.broadcast.Models2Group5.ForwardObservations
open JuliaLean.Proofs.base.broadcast.Models2Group5.NewIndex (FollowsPlan PrefixFailures)

/-- Observe existing operations only; actual selection sees the payload world
returned by the preceding conversion. There are no callee-result laws. -/
def observingCopy {W L : Type} (core : CoreOps (ProbeWorld W L) L)
    (select : Value L → Value L → W → Method) : Ops (ProbeWorld W L) L where
  toCoreOps := observingOps core
  selectedCopy := fun dest source world => select dest source world.payload

/-- A prescribed finite prefix of a recursive copy cannot fabricate a value
when another source operation is needed. Every throwing/diverging operation
in the prefix keeps its exact position, error and world. This proof stream is
finite instrumentation, not a Julia tuple or a fuel argument to the model. -/
def ContinuesPlan {W L : Type} (action : CoreM (ProbeWorld W L) L (Value L))
    (values : Nat → Value L) (worlds : Nat → W) (initial : W)
    (history : List (Event L)) (suffix : List (Reply W L))
    (events : List (Event L)) : Prop :=
  let successful : List (Reply W L) :=
    (List.range events.length).map (fun position => .returned (values position) (worlds position))
  0 < events.length ∧ action ⟨initial, successful, history⟩ = none ∧
    PrefixFailures action values worlds initial history suffix events

def isGeneric : Method → Bool
  | .generic => true
  | _ => false

/-- Source provenance at an arbitrary conversion depth. -/
def sourceAt {L : Type} (original : Value L) (values : Nat → Value L) : Nat → Value L
  | 0 => original
  | predecessor + 1 => values (2 * (predecessor + 1) - 1)

/-- Independent flat conversion grammar, one type application and one convert
per visited generic body. Every new source is exactly the previous reply. -/
def conversionEvents {W L : Type} (core : CoreOps W L) (bindings : Bindings L)
    (original : Value L) (values : Nat → Value L) (frames : Nat) : List (Event L) :=
  (List.range frames).flatMap (fun depth =>
    [.applyType bindings.broadcasted [JuliaLean.base.boot.coreV core "Nothing"],
     .call bindings.convert [values (2 * depth), sourceAt original values depth]])

/-- Generic copy conversion repeats its actual source expression until a
selected different body is reached. A selected external body receives the
original destination and exact last converted source; a scalar body begins
with its required f getter. If every candidate remains generic, every finite
window preserves its conversion/error prefix and cannot invent a result.
There is no terminal-dispatch, conversion-correctness or purity assumption.
Source: base/broadcast.jl:980-993. -/
def GenericRecursiveObservations : Prop :=
  ∀ {W L : Type} (core : CoreOps (ProbeWorld W L) L)
      (select : Value L → Value L → W → Method) (bindings : Bindings L)
      (dest bc : Value L) (values : Nat → Value L) (worlds : Nat → W)
      (initial : W) (history : List (Event L)) (suffix : List (Reply W L)) (window : Nat),
    let action := generic (observingCopy core select) bindings dest bc
    match (List.range (window + 1)).find? (fun step =>
        !(isGeneric (select dest (values (2 * step + 1)) (worlds (2 * step + 1))))) with
    | none =>
        ContinuesPlan action values worlds initial history suffix
          (conversionEvents core bindings bc values (window + 1))
    | some step =>
        let frames := step + 1
        let priorReplies := conversionEvents core bindings bc values frames
        match select dest (values (2 * frames - 1)) (worlds (2 * frames - 1)) with
        | .other =>
            FollowsPlan action values worlds initial history suffix
              (priorReplies ++ [.call bindings.copyTo [dest, values (2 * frames - 1)]])
              (values (2 * frames))
        | .scalar =>
            ContinuesPlan action values worlds initial history suffix
              (priorReplies ++ [.call bindings.getproperty [values (2 * frames - 1), .symbol "f"]])
        | .generic => False

/-- Observation grammar for a reached scalar fallback. The required
conversion is followed by the first actual selected body operation; if that
body is external, its complete return is preserved. Known recursive bodies
must begin with their own type application/property read, not an open copyto!
callback. This checks the reached transition with arbitrary selector worlds. -/
def FallbackObservations {W L : Type} (core : CoreOps (ProbeWorld W L) L)
    (select : Value L → Value L → W → Method) (bindings : Bindings L)
    (dest bc : Value L) (action : CoreM (ProbeWorld W L) L (Value L))
    (values : Nat → Value L) (worlds : Nat → W) (initial : W)
    (history : List (Event L)) (suffix : List (Reply W L))
    (priorReplies : List (Event L)) : Prop :=
  let offset := priorReplies.length
  let converted := values (offset + 1)
  let conversion := priorReplies ++
    [.applyType bindings.broadcasted [JuliaLean.base.boot.coreV core "Nothing"],
     .call bindings.convert [values offset, bc]]
  match select dest converted (worlds (offset + 1)) with
  | .other =>
      FollowsPlan action values worlds initial history suffix
        (conversion ++ [.call bindings.copyTo [dest, converted]]) (values (offset + 2))
  | .generic =>
      ContinuesPlan action values worlds initial history suffix
        (conversion ++ [.applyType bindings.broadcasted [JuliaLean.base.boot.coreV core "Nothing"]])
  | .scalar =>
      ContinuesPlan action values worlds initial history suffix
        (conversion ++ [.call bindings.getproperty [converted, .symbol "f"]])

/-- Full short-circuit and alias-sensitive scalar optimization invariant.
Later tests/readers cannot run until earlier identity/isa/flatness tests pass.
Only true Bool flatness reaches the reread, first-argument read, scalar read
and fill; its exact returned value survives. Each false route performs the
real conversion and selected copy transition, while a non-Bool raises the
conditional TypeError at isflat. All values/errors/worlds/selectors and mutation
outcomes are arbitrary; the destination is never replaced or copied by this
body. Source: base/broadcast.jl:983-993. -/
def ScalarObservations : Prop :=
  ∀ {W L : Type} (core : CoreOps (ProbeWorld W L) L)
      (select : Value L → Value L → W → Method) (bindings : Bindings L)
      (dest bc : Value L) (values : Nat → Value L) (worlds : Nat → W)
      (initial : W) (history : List (Event L)) (suffix : List (Reply W L)),
    let action := scalar (observingCopy core select) bindings dest bc
    let first : List (Event L) := [.call bindings.getproperty [bc, .symbol "f"]]
    if !(core.same (values 0) bindings.identity) then
      FallbackObservations core select bindings dest bc action values worlds initial history suffix first
    else
      let second := first ++
        [.call bindings.getproperty [bc, .symbol "args"],
         .applyType (JuliaLean.base.boot.coreV core "Tuple")
           [JuliaLean.base.boot.coreV core "Any"]]
      if !(core.isa (values 1) (values 2)) then
        FallbackObservations core select bindings dest bc action values worlds initial history suffix second
      else
        let priorReplies := second ++ [.call bindings.isFlat [bc]]
        match (match values 3 with | .leaf value => core.asBool value | _ => none) with
        | some false =>
            FallbackObservations core select bindings dest bc action values worlds initial history suffix priorReplies
        | some true =>
            FollowsPlan action values worlds initial history suffix
              (priorReplies ++
                [.call bindings.getproperty [bc, .symbol "args"],
                 .call bindings.getindex
                   [values 4, JuliaLean.base.boot.intV core (JInt.lit .i64 1)],
                 .call bindings.getindex [values 5],
                 .call bindings.fill [dest, values 6]]) (values 7)
        | none =>
            let successful : List (Reply W L) :=
              (List.range 4).map (fun position => .returned (values position) (worlds position))
            let before : ProbeWorld W L := ⟨initial, successful ++ suffix, history⟩
            let after : ProbeWorld W L := ⟨worlds 3, suffix, history ++ priorReplies⟩
            PrefixFailures action values worlds initial history suffix priorReplies ∧
            action before = some (.error
              (JuliaLean.base.boot.objV core (.typeError (.symbol "if")
                (JuliaLean.base.boot.strV core "") (JuliaLean.base.boot.coreV core "Bool")
                (values 3)), after))

def proposedEntries : List Entry := [
  { id := "broadcast-copyto-conversion-recursion", juliaFile := "base/broadcast.jl",
    juliaFns := ["copyto!(dest::AbstractArray, bc::Broadcasted)"],
    statement := "Generic copyto! applies Broadcasted{Nothing}, converts the exact source, and redispatches with the unchanged destination. Every own conversion repeats explicitly with current-world selection; arbitrary-depth traces preserve converted provenance, failure worlds and genuine divergence, with no fabricated terminal result.",
    source := "base/broadcast.jl:980-993 (conversion, recursive provenance and propagation invariants)",
    status := .todo,
    prop := ``JuliaLean.Proofs.base.broadcast.Models2Group5.CopyDispatch.GenericRecursiveObservations,
    thm := none,
    notes := "Todo: needs run fixed-point trace induction for repeated Nothing conversions and current-world generic/scalar/custom redispatch, matching GenericRecursiveObservations at every frontier window." },
  { id := "broadcast-copyto-scalar-short-circuit", juliaFile := "base/broadcast.jl",
    juliaFns := ["copyto!(dest::AbstractArray, bc::Broadcasted{<:AbstractArrayStyle{0}})"],
    statement := "Scalar copyto! respects identity→singleton-type→flatness short circuit, rereads args only on the successful shortcut, then performs the selected scalar read and fill. False routes perform actual conversion and method redispatch; non-Bool flatness throws before the shortcut. Every arbitrary result, error and mutation world remains intact.",
    source := "base/broadcast.jl:983-993 (short-circuit, argument identity and mutation/error invariants)",
    status := .todo,
    prop := ``JuliaLean.Proofs.base.broadcast.Models2Group5.CopyDispatch.ScalarObservations,
    thm := none,
    notes := "Todo: needs scalarFast observation proof for identity/isa/flatness short circuit and exact TypeError, composed with the conversion redispatch invariant for every failed shortcut." }
]

