open ConversionProofs (take_full)

def replies {W L : Type} (values : Nat → Value L) (worlds : Nat → W)
    (offset count : Nat) : List (Reply W L) :=
  (List.range' offset count).map (fun i => .returned (values i) (worlds i))

theorem replies_zero {W L : Type} (values : Nat → Value L) (worlds : Nat → W)
    (offset : Nat) : replies values worlds offset 0 = [] := rfl

theorem replies_succ {W L : Type} (values : Nat → Value L) (worlds : Nat → W)
    (offset count : Nat) :
    replies values worlds offset (count + 1) =
      .returned (values offset) (worlds offset) :: replies values worlds (offset + 1) count := by
  simp only [replies, List.range'_succ, List.map_cons]

theorem replies_append {W L : Type} (values : Nat → Value L) (worlds : Nat → W)
    (offset first second : Nat) :
    replies values worlds offset (first + second) =
      replies values worlds offset first ++ replies values worlds (offset + first) second := by
  unfold replies
  rw [← List.range'_append_1 (s := offset) (m := first) (n := second), List.map_append]

def SequenceSpec {W L : Type} (action : CoreM (World W L) L (Value L))
    (initial : W) (values : Nat → Value L) (worlds : Nat → W)
    (offset : Nat) (events : List (ContextEvent L)) : Prop :=
  (∀ (history : List (ContextEvent L)) (suffix : List (Reply W L)),
    action ⟨initial, replies values worlds offset events.length ++ suffix, history⟩ =
      some (.ok (values (offset + events.length - 1),
        ⟨worlds (offset + events.length - 1), suffix, history ++ events⟩))) ∧
  (∀ (position : Nat), position < events.length →
    ∀ (error : Value L) (failureWorld : W)
      (history : List (ContextEvent L)) (suffix : List (Reply W L)),
    action ⟨initial, replies values worlds offset position ++
      .thrown error failureWorld :: suffix, history⟩ =
      some (.error (error,
        ⟨failureWorld, suffix, history ++ events.take (position + 1)⟩))) ∧
  (∀ (position : Nat), position < events.length →
    ∀ (history : List (ContextEvent L)) (suffix : List (Reply W L)),
    action ⟨initial, replies values worlds offset position ++ .diverged :: suffix, history⟩ = none)

theorem sequence_one {W L : Type} (event : ContextEvent L) (initial : W)
    (values : Nat → Value L) (worlds : Nat → W) (offset : Nat) :
    SequenceSpec (observe event.boundscheck event.event)
      initial values worlds offset [event] := by
  cases event with
  | mk context event =>
    refine ⟨?_, ?_, ?_⟩
    · intro history suffix
      simp only [List.length_cons, List.length_nil, Nat.zero_add, replies_succ,
        replies_zero, List.cons_append, List.nil_append, observe]
      rfl
    · intro position h error failureWorld history suffix
      have hp : position = 0 := by
        have hzero : position ≤ 0 := Nat.le_of_lt_succ h
        exact Nat.eq_zero_of_le_zero hzero
      subst position
      rfl
    · intro position h history suffix
      have hp : position = 0 := by
        have hzero : position ≤ 0 := Nat.le_of_lt_succ h
        exact Nat.eq_zero_of_le_zero hzero
      subst position
      rfl

theorem sequence_append {W L : Type}
    (action : CoreM (World W L) L (Value L))
    (next : Value L → CoreM (World W L) L (Value L))
    (initial : W) (values : Nat → Value L) (worlds : Nat → W)
    (offset : Nat) (front back : List (ContextEvent L))
    (first : SequenceSpec action initial values worlds offset front)
    (second : SequenceSpec (next (values (offset + front.length - 1)))
      (worlds (offset + front.length - 1)) values worlds (offset + front.length) back) :
    SequenceSpec (action >>= next) initial values worlds offset (front ++ back) := by
  refine ⟨?_, ?_, ?_⟩
  · intro history suffix
    rw [List.length_append, replies_append, List.append_assoc, bind_apply, first.1]
    simp only [second.1, Nat.add_assoc, List.append_assoc]
  · intro position bound error failureWorld history suffix
    rw [List.length_append] at bound
    by_cases early : position < front.length
    · rw [bind_apply, first.2.1 position early error failureWorld]
      rw [List.take_append_of_le_length (by omega)]
    · let extra := position - front.length
      have split : position = front.length + extra := by dsimp [extra]; omega
      have later : extra < back.length := by dsimp [extra]; omega
      rw [split, replies_append, List.append_assoc, bind_apply, first.1]
      simp only [second.2.1 extra later error failureWorld]
      have all : front.take (front.length + extra + 1) = front :=
        take_full _ _ (by omega)
      have remaining : front.length + extra + 1 - front.length = extra + 1 := by omega
      rw [List.take_append, all, remaining]
      simp only [List.append_assoc]
  · intro position bound history suffix
    rw [List.length_append] at bound
    by_cases early : position < front.length
    · rw [bind_apply, first.2.2 position early]
    · let extra := position - front.length
      have split : position = front.length + extra := by dsimp [extra]; omega
      have later : extra < back.length := by dsimp [extra]; omega
      rw [split, replies_append, List.append_assoc, bind_apply, first.1]
      exact second.2.2 extra later _ _

def frameEvents {W L : Type} (core : Bool → CoreOps (World W L) L)
    (bindings : Bindings L) (typeValue bc index firstValue : Value L)
    (boundscheck : Bool) (values : Nat → Value L) (offset : Nat) : List (ContextEvent L) :=
  [call boundscheck bindings.getproperty [bc, .symbol "args"],
   call boundscheck bindings.tail [values offset],
   call boundscheck bindings.tail [values (offset + 1)],
   call boundscheck bindings.gather [values (offset + 2), index],
   call boundscheck bindings.getproperty [bc, .symbol "f"],
   ⟨boundscheck, .splat bindings.iterate
      [bindings.evalf,
       JuliaLean.base.boot.tupleV (core boundscheck) [values (offset + 4), firstValue, typeValue],
       values (offset + 3)]⟩]

theorem frame_spec {W L : Type} (core : Bool → CoreOps (World W L) L)
    (bindings : Bindings L) (typeValue bc index firstValue : Value L)
    (boundscheck : Bool) (values : Nat → Value L) (worlds : Nat → W)
    (offset : Nat) (initial : W) :
    SequenceSpec
      (finishFrame ((observeContexts core).inContext boundscheck) bindings typeValue bc index firstValue)
      initial values worlds offset
      (frameEvents core bindings typeValue bc index firstValue boundscheck values offset) := by
  have last : offset + 6 - 1 = offset + 5 := by omega
  refine ⟨?_, ?_, ?_⟩
  · intro history suffix
    simp only [frameEvents, List.length_cons, List.length_nil, Nat.reduceAdd,
      replies_succ, replies_zero, List.cons_append, List.nil_append,
      finishFrame, observeContexts, bind_apply, observe,
      JuliaLean.base.boot.tupleV, call, List.append_assoc,
      Nat.add_assoc, Nat.reduceAdd, last]
  · intro position bound error failureWorld history suffix
    have h : position < 6 := bound
    have cases : position = 0 ∨ position = 1 ∨ position = 2 ∨ position = 3 ∨
        position = 4 ∨ position = 5 := by omega
    rcases cases with rfl | rfl | rfl | rfl | rfl | rfl <;>
      simp only [frameEvents, replies_succ, replies_zero, List.cons_append, List.nil_append,
        finishFrame, observeContexts, bind_apply, observe,
        JuliaLean.base.boot.tupleV, call, List.append_assoc,
        List.take, Nat.add_assoc, Nat.reduceAdd]
  · intro position bound history suffix
    have h : position < 6 := bound
    have cases : position = 0 ∨ position = 1 ∨ position = 2 ∨ position = 3 ∨
        position = 4 ∨ position = 5 := by omega
    rcases cases with rfl | rfl | rfl | rfl | rfl | rfl <;>
      simp only [frameEvents, replies_succ, replies_zero, List.cons_append, List.nil_append,
        finishFrame, observeContexts, bind_apply, observe,
        JuliaLean.base.boot.tupleV, call, List.append_assoc,
        List.take, Nat.add_assoc, Nat.reduceAdd]

def unwindBlock {W L : Type} (core : Bool → CoreOps (World W L) L)
    (select : Value L → Value L → W → ElementMethod L) (bindings : Bindings L)
    (originalType original index : Value L) (boundscheck : Bool)
    (values : Nat → Value L) (worlds : Nat → W) (depth start : Nat) : List (ContextEvent L) :=
  frameEvents core bindings (typeAt select originalType index values worlds depth)
    (inputAt original values depth) index (values (start - 1)) boundscheck values start

def stackEvents {W L : Type} (core : Bool → CoreOps (World W L) L)
    (select : Value L → Value L → W → ElementMethod L) (bindings : Bindings L)
    (originalType original index : Value L) (boundscheck : Bool)
    (values : Nat → Value L) (worlds : Nat → W) (depth start : Nat) : List (ContextEvent L) :=
  (List.range depth).flatMap (fun step =>
    unwindBlock core select bindings originalType original index boundscheck values worlds
      (depth - 1 - step) (start + 6 * step))

theorem stackEvents_succ {W L : Type} (core : Bool → CoreOps (World W L) L)
    (select : Value L → Value L → W → ElementMethod L) (bindings : Bindings L)
    (originalType original index : Value L) (boundscheck : Bool)
    (values : Nat → Value L) (worlds : Nat → W) (depth start : Nat) :
    stackEvents core select bindings originalType original index boundscheck values worlds
      (depth + 1) start =
      unwindBlock core select bindings originalType original index boundscheck values worlds depth start ++
      stackEvents core select bindings originalType original index boundscheck values worlds depth (start + 6) := by
  simp only [stackEvents, List.range_succ_eq_map, List.flatMap_cons, List.flatMap_map,
    Nat.add_sub_cancel, Nat.sub_zero, Nat.mul_zero, Nat.add_zero]
  congr 1
  apply congrArg (fun f : Nat → List (ContextEvent L) => (List.range depth).flatMap f)
  funext step
  have depthEq : depth - (step + 1) = depth - 1 - step := by omega
  have startEq : start + 6 * (step + 1) = start + 6 + 6 * step := by omega
  simp only [Nat.succ_eq_add_one, depthEq, startEq]

theorem stackEvents_length {W L : Type} (core : Bool → CoreOps (World W L) L)
    (select : Value L → Value L → W → ElementMethod L) (bindings : Bindings L)
    (originalType original index : Value L) (boundscheck : Bool)
    (values : Nat → Value L) (worlds : Nat → W) (depth start : Nat) :
    (stackEvents core select bindings originalType original index boundscheck values worlds depth start).length =
      6 * depth := by
  induction depth generalizing start with
  | zero => rfl
  | succ depth ih =>
    rw [stackEvents_succ, List.length_append, ih]
    simp only [unwindBlock, frameEvents, List.length_cons, List.length_nil]
    omega

theorem stack_spec {W L : Type} (core : Bool → CoreOps (World W L) L)
    (select : Value L → Value L → W → ElementMethod L) (bindings : Bindings L)
    (originalType original index : Value L) (boundscheck : Bool)
    (values : Nat → Value L) (worlds : Nat → W) (depth offset : Nat)
    (action : CoreM (World W L) L (Value L)) (initial : W)
    (events : List (ContextEvent L))
    (spec : SequenceSpec action initial values worlds offset events) :
    SequenceSpec
      (stack (frameAt core select bindings originalType original index boundscheck values worlds)
        depth action)
      initial values worlds offset
      (events ++ stackEvents core select bindings originalType original index boundscheck values worlds
        depth (offset + events.length)) := by
  induction depth generalizing action initial events with
  | zero => simpa only [stack, stackEvents, List.range_zero, List.flatMap_nil, List.append_nil] using spec
  | succ depth ih =>
    let finish := frameAt core select bindings originalType original index boundscheck values worlds depth
    let block := unwindBlock core select bindings originalType original index boundscheck values worlds
      depth (offset + events.length)
    have nextSpec :
        SequenceSpec (finish (values (offset + events.length - 1)))
          (worlds (offset + events.length - 1)) values worlds (offset + events.length) block :=
      frame_spec core bindings (typeAt select originalType index values worlds depth)
        (inputAt original values depth) index (values (offset + events.length - 1))
        boundscheck values worlds (offset + events.length) (worlds (offset + events.length - 1))
    have joined := sequence_append action finish initial values worlds offset events block spec nextSpec
    have rest := ih (action := action >>= finish) (initial := initial) (events := events ++ block) joined
    have len : block.length = 6 := rfl
    simpa only [stack, stackEvents_succ, List.length_append, len, Nat.add_assoc,
      List.append_assoc, finish, block] using rest

theorem unwindEvents_eq {W L : Type} (core : Bool → CoreOps (World W L) L)
    (select : Value L → Value L → W → ElementMethod L) (bindings : Bindings L)
    (originalType original index : Value L) (boundscheck : Bool)
    (values : Nat → Value L) (worlds : Nat → W) (frames : Nat) :
    unwindEvents (core boundscheck) bindings select originalType original index boundscheck values worlds frames =
      stackEvents core select bindings originalType original index boundscheck values worlds
        frames (2 * frames + 1) := by
  unfold unwindEvents stackEvents
  apply congrArg (fun f : Nat → List (ContextEvent L) => (List.range frames).flatMap f)
  funext step
  have last : 2 * frames + 1 + 6 * step - 1 = 2 * frames + 6 * step := by omega
  simp only [unwindBlock, frameEvents, last]

theorem unwindEvents_length {W L : Type} (core : Bool → CoreOps (World W L) L)
    (select : Value L → Value L → W → ElementMethod L) (bindings : Bindings L)
    (originalType original index : Value L) (boundscheck : Bool)
    (values : Nat → Value L) (worlds : Nat → W) (frames : Nat) :
    (unwindEvents (core boundscheck) bindings select originalType original index boundscheck values worlds frames).length =
      6 * frames := by
  rw [unwindEvents_eq, stackEvents_length]

theorem terminal_stack_spec {W L : Type} (core : Bool → CoreOps (World W L) L)
    (select : Value L → Value L → W → ElementMethod L) (bindings : Bindings L)
    (originalType original index : Value L) (boundscheck : Bool)
    (values : Nat → Value L) (worlds : Nat → W) (frames : Nat) (initial : W) :
    SequenceSpec
      (stack (frameAt core select bindings originalType original index boundscheck values worlds) frames
        (observe boundscheck (.call bindings.broadcastGetindex [values (2 * frames - 1), index])))
      initial values worlds (2 * frames)
      ([call boundscheck bindings.broadcastGetindex [values (2 * frames - 1), index]] ++
        unwindEvents (core boundscheck) bindings select originalType original index boundscheck values worlds frames) := by
  rw [unwindEvents_eq]
  exact stack_spec core select bindings originalType original index boundscheck values worlds
    frames (2 * frames) _ initial _
    (sequence_one (call boundscheck bindings.broadcastGetindex [values (2 * frames - 1), index])
      initial values worlds (2 * frames))

theorem replies_successes {W L : Type} (values : Nat → Value L) (worlds : Nat → W)
    (offset count : Nat) :
    replies values worlds offset count =
      successes count (fun i => values (offset + i)) (fun i => worlds (offset + i)) := by
  unfold replies successes
  rw [List.range'_eq_map_range, List.map_map]
  rfl

theorem sequence_returns {W L : Type}
    (action : CoreM (World W L) L (Value L))
    (initial : W) (values : Nat → Value L) (worlds : Nat → W)
    (offset : Nat) (events : List (ContextEvent L)) (count : Nat)
    (lengthEq : events.length = count) (positive : 0 < count)
    (spec : SequenceSpec action initial values worlds offset events)
    (history : List (ContextEvent L)) (suffix : List (Reply W L)) :
    ReturnsLast action count (fun i => values (offset + i)) (fun i => worlds (offset + i))
      events initial history suffix := by
  unfold ReturnsLast FailurePrefixes
  refine ⟨positive, lengthEq, ?_, ?_, ?_⟩
  · have last : offset + count - 1 = offset + (count - 1) := by omega
    simpa only [lengthEq, replies_successes, last] using spec.1 history suffix
  · intro position error failureWorld
    have bound : position.val < count := by
      simpa only [successes, List.length_map, List.length_range] using position.isLt
    rw [ConversionProofs.successes_take count position.val
      (fun i => values (offset + i)) (fun i => worlds (offset + i)) (by omega)]
    simpa only [replies_successes, List.cons_append, List.nil_append, List.append_assoc] using
      spec.2.1 position.val (by rw [lengthEq]; exact bound) error failureWorld history
        ((successes count (fun i => values (offset + i)) (fun i => worlds (offset + i))).drop
          (position.val + 1) ++ suffix)
  · intro position
    have bound : position.val < count := by
      simpa only [successes, List.length_map, List.length_range] using position.isLt
    rw [ConversionProofs.successes_take count position.val
      (fun i => values (offset + i)) (fun i => worlds (offset + i)) (by omega)]
    simpa only [replies_successes, List.cons_append, List.nil_append, List.append_assoc] using
      spec.2.2 position.val (by rw [lengthEq]; exact bound) history
        ((successes count (fun i => values (offset + i)) (fun i => worlds (offset + i))).drop
          (position.val + 1) ++ suffix)

theorem terminal_stack_returns {W L : Type} (core : Bool → CoreOps (World W L) L)
    (select : Value L → Value L → W → ElementMethod L) (bindings : Bindings L)
    (originalType original index : Value L) (boundscheck : Bool)
    (values : Nat → Value L) (worlds : Nat → W) (frames : Nat) (initial : W)
    (history : List (ContextEvent L)) (suffix : List (Reply W L)) :
    ReturnsLast
      (stack (frameAt core select bindings originalType original index boundscheck values worlds) frames
        (observe boundscheck (.call bindings.broadcastGetindex [values (2 * frames - 1), index])))
      (6 * frames + 1) (fun i => values (2 * frames + i)) (fun i => worlds (2 * frames + i))
      ([call boundscheck bindings.broadcastGetindex [values (2 * frames - 1), index]] ++
        unwindEvents (core boundscheck) bindings select originalType original index boundscheck values worlds frames)
      initial history suffix := by
  apply sequence_returns _ initial values worlds (2 * frames) _ (6 * frames + 1)
  · rw [List.length_append, unwindEvents_length]
    simp only [List.length_cons, List.length_nil]
    omega
  · omega
  · exact terminal_stack_spec core select bindings originalType original index boundscheck
      values worlds frames initial


