are exactly the prior depth's getindex reply. This is a closed provenance
formula over proof positions, not a recursively supplied model argument. -/
def inputAt {L : Type} (original : Value L) (values : Nat → Value L) :
    Nat → Value L
  | 0 => original
  | predecessor + 1 => values (2 * (predecessor + 1) - 1)

/-- Static parameter provenance at a recursive frame. A nonzero visited frame
inherits the actual T carried by its preceding selected self-method metadata.
The other branch is unused before the first terminal selection; it merely
makes this proof-position function total and supplies no runtime default. -/
def typeAt {W L : Type}
    (select : Value L → Value L → W → ElementMethod L)
    (originalType index : Value L) (values : Nat → Value L) (worlds : Nat → W) :
    Nat → Value L
  | 0 => originalType
  | predecessor + 1 =>
      match select (values (2 * predecessor + 1)) index
          (worlds (2 * predecessor + 1)) with
      | .same typeValue => typeValue
      | .other => originalType

/-- Flat descent grammar: each visited frame reads its original args property
and indexes the exact returned object at native Int one. The next frame, when
selected, uses precisely that indexed value and the unchanged coordinate. -/
def descentEvents {W L : Type} (core : CoreOps W L) (bindings : Bindings L)
    (original : Value L) (boundscheck : Bool) (values : Nat → Value L)
    (frames : Nat) : List (ContextEvent L) :=
  (List.range frames).flatMap (fun depth =>
    [call boundscheck bindings.getproperty [inputAt original values depth, .symbol "args"],
     call boundscheck bindings.getindex
       [values (2 * depth), JuliaLean.base.boot.intV core (JInt.lit .i64 1)]])

/-- Independent reverse-frame trace grammar. Every frame rereads its own
args after its child has returned, takes two tails, gathers at the original
coordinate and only then reads f. The child token is the terminal selected
reply for the deepest frame and the previous completed splat for every outer
frame. Static types come from each frame's dispatch metadata; the final args
splat has exact prefix (f,childResult,T). This is a flat index/provenance
formula over observations, not a second recursive evaluator. -/
def unwindEvents {W P L : Type} (core : CoreOps P L) (bindings : Bindings L)
    (select : Value L → Value L → W → ElementMethod L)
    (originalType original index : Value L) (boundscheck : Bool)
    (values : Nat → Value L) (worlds : Nat → W) (frames : Nat) :
    List (ContextEvent L) :=
  (List.range frames).flatMap (fun step =>
    let depth := frames - 1 - step
    let start := 2 * frames + 1 + 6 * step
    let wrapper := inputAt original values depth
    [call boundscheck bindings.getproperty [wrapper, .symbol "args"],
     call boundscheck bindings.tail [values start],
     call boundscheck bindings.tail [values (start + 1)],
     call boundscheck bindings.gather [values (start + 2), index],
     call boundscheck bindings.getproperty [wrapper, .symbol "f"],
     ⟨boundscheck, .splat bindings.iterate
       [bindings.evalf,
        JuliaLean.base.boot.tupleV core
          [values (start + 4), values (2 * frames + 6 * step),
           typeAt select originalType index values worlds depth],
        values (start + 3)]⟩])

/-- Runtime operations are observed while pure element selection retains
exactly the payload world produced by preceding calls. -/
def observingSecond {W L : Type}
    (core : Bool → CoreOps (World W L) L)
    (select : Value L → Value L → W → ElementMethod L) : SecondOps (World W L) L where
  contexts := observeContexts core
  selectedElement := fun value index world => select value index world.payload

/-- Full source689 invariant for every recursion depth and selector. The first
non-self element selection terminates descent; source calls then have the
closed grammar of two calls per frame, one terminal element call, and six
calls per frame in reverse order. Every returned value retains its original
reference/provenance, and every frame's static T remains its own selected T.
The repeated args getter is mandatory and occurs after its child's effects.

If no terminal is selected within an arbitrary finite window, every descent
call remains observable, every error/divergence preserves its site, and the
model cannot fabricate a return without further source operations. No premise
requires a terminating tree, correct getter, canonical gather result, pure
function, or successful open callee. Bounds context stays unchanged through
all own recursive frames, with the explicit evalf boundary retained.
Source: base/broadcast.jl:689-693,704; rationale at679-684. -/
def SecondTypeRecursiveObservations : Prop :=
  ∀ {W L : Type} (core : Bool → CoreOps (World W L) L)
      (select : Value L → Value L → W → ElementMethod L)
      (bindings : Bindings L) (typeValue bc index : Value L) (boundscheck : Bool)
      (values : Nat → Value L) (worlds : Nat → W) (initial : W)
      (history : List (ContextEvent L)) (suffix : List (Reply W L)) (window : Nat),
    let ops := observingSecond core select
    let action := secondType ops bindings typeValue bc index boundscheck
    match (List.range (window + 1)).find? (fun depth =>
        isOther (select (values (2 * depth + 1)) index (worlds (2 * depth + 1)))) with
    | none =>
        let frames := window + 1
        ContinuesAfter action (2 * frames) values worlds
          (descentEvents (core boundscheck) bindings bc boundscheck values frames)
          initial history suffix
    | some depth =>
        let frames := depth + 1
        let prescribed :=
          descentEvents (core boundscheck) bindings bc boundscheck values frames ++
          [call boundscheck bindings.broadcastGetindex [values (2 * frames - 1), index]] ++
          unwindEvents (core boundscheck) bindings select typeValue bc index
            boundscheck values worlds frames
        depth ≤ window ∧
        ReturnsLast action (8 * frames + 1) values worlds prescribed initial history suffix

