namespace JuliaLean.Proofs.base.broadcast.Models2Group5.MaterialRecursion

open JuliaLean.Registry
open JuliaLean.base.expr (Value)
open JuliaLean.base.boot (CoreOps CoreM)
open JuliaLean.base.broadcast.Models2Group5.MaterialRecursion
open JuliaLean.Proofs.base.broadcast.Models2Group5.ForwardObservations
open JuliaLean.Proofs.base.broadcast.Models2Group5.NewIndex (FollowsPlan PrefixFailures)

/-- Source928 style combination must complete before dispatching the
three-argument materialize!, with original destination/wrapper identities.
Every selected value, error, world and divergence is arbitrary. -/
def BroadcastedBangRuntime : Prop :=
  ∀ {W L : Type} (bindings : Bindings L) (dest bc : Value L),
    ReturnsLastAfter (W := W) (L := L) 1
      (fun ops => broadcastedBang ops bindings dest bc)
      (fun _ values _ _ =>
        [.call bindings.combineStyles [dest, bc],
         .call bindings.materializeBang [values 0, dest, bc]])

/-- A proof-only scan of method-selection tags after the third arbitrary
reply of each frame. It locates the first non-fallback within a finite
observation window; it computes no Julia value and executes no model body.
The window is not passed to the model and never bounds its recursion. -/
def frontier {W L : Type} (select : Value L → Value L → W → Method)
    (dest : Value L) (values : Nat → Value L) (worlds : Nat → W)
    (remaining processed : Nat) : Nat × Method :=
  match remaining with
  | 0 => (processed, .fallback)
  | next + 1 =>
      match select dest (values (3 * processed + 2)) (worlds (3 * processed + 2)) with
      | .fallback => frontier select dest values worlds next (processed + 1)
      | .broadcasted => (processed + 1, .broadcasted)
      | .other => (processed + 1, .other)

/-- Independent flat grammar of recursive wrapping observations. Frame n
uses the preceding frame's exact instantiate reply (or the original input
for frame zero); every frame preserves destination identity and constructs
a singleton, never a flattened payload. The grammar is just indexed lists
of observations and does not evaluate materialize! or any Julia callee. -/
def prefixEvents {W L : Type} (core : CoreOps (ProbeWorld W L) L)
    (bindings : Bindings L) (dest original : Value L)
    (values : Nat → Value L) (count : Nat) : List (Event L) :=
  (List.range count).flatMap (fun frame =>
    let input := if frame == 0 then original else values (3 * frame - 1)
    [.call bindings.axes [dest],
     .call bindings.broadcastedConstructor
       [bindings.identity, JuliaLean.base.boot.tupleV core [input], values (3 * frame)],
     .call bindings.instantiate [values (3 * frame + 1)]])

/-- Observe existing runtime calls while selecting on the actual payload
world after preceding effects. No selector or returned-value law is assumed. -/
def observingMaterial {W L : Type} (core : CoreOps (ProbeWorld W L) L)
    (select : Value L → Value L → W → Method) : Ops (ProbeWorld W L) L where
  toCoreOps := observingOps core
  selectedMaterialize := fun dest value world => select dest value world.payload

/-- Complete-domain recursion observation family for source924. At every
positive finite window, every executed frame has the same destination and
exact singleton/value provenance. If a terminal method is reached, its actual
return becomes the result after exactly the appropriate one or two terminal
calls; all successful, throwing and diverging call positions are retained.
If the window contains only recursive selections, no value is returned before
the next operation, and all finite exceptional/diverging prefixes remain
observable. Infinite fallback chains are admitted by the actual model's
least partial fixed point. There is no success, termination, conventional
constructor result or callee-correctness premise. -/
def FallbackBangRuntime : Prop :=
  ∀ {W L : Type} (core : CoreOps (ProbeWorld W L) L)
      (select : Value L → Value L → W → Method)
      (bindings : Bindings L) (dest original : Value L)
      (values : Nat → Value L) (worlds : Nat → W) (initial : W)
      (history : List (Event L)) (suffix : List (Reply W L)) (window : Nat),
    let cut := frontier select dest values worlds (window + 1) 0
    let count := cut.1
    let prescribed := prefixEvents core bindings dest original values count
    let action := fallbackBang (observingMaterial core select) bindings dest original
    0 < count ∧ count ≤ window + 1 ∧ prescribed.length = 3 * count ∧
      match cut.2 with
      | .broadcasted =>
          FollowsPlan action values worlds initial history suffix
            (prescribed ++
              [.call bindings.combineStyles [dest, values (3 * count - 1)],
               .call bindings.materializeBang
                 [values (3 * count), dest, values (3 * count - 1)]])
            (values (3 * count + 1))
      | .other =>
