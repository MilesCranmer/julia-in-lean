namespace JuliaLean.ChatGPT.Batch11.Group10.AxesProofs
open JuliaLean.base.expr (Value)
open JuliaLean.base.boot (CoreOps CoreM)
open JuliaLean.base.broadcast.Models2Group5.Extrusion
open JuliaLean.Proofs.base.broadcast.Models2Group5.Extrusion
open JuliaLean.Proofs.base.broadcast.Models2Group5.ForwardObservations (Reply Event)
open JuliaLean.Proofs.base.broadcast.Models2Group5.IndexAccess.ContextObservations

theorem bind_run {W L A B : Type} (action : CoreM W L A)
    (next : A → CoreM W L B) (world : W) :
    (action >>= next) world = match action world with
      | none => none
      | some (.error error) => some (.error error)
      | some (.ok (value, after)) => next value after := by
  change (Option.bind (action world) (fun result =>
    match result with
    | .error error => some (.error error)
    | .ok (value, after) => next value after)) = _
  cases action world with
  | none => rfl
  | some result => cases result <;> rfl

theorem axes_step {W L : Type} (core : CoreOps (World W L) L)
    (select : Value L → W → AxesMethod) (bindings : Bindings L)
    (value : Value L) (world : World W L) :
    axes (observingAxes core select) bindings value world =
      match observe true (.call bindings.getproperty [value, .symbol "x"]) world with
      | none => none
      | some (.error error) => some (.error error)
      | some (.ok (underlying, after)) =>
        match select underlying after.payload with
        | .extruded => axes (observingAxes core select) bindings underlying after
        | .other => observe true (.call bindings.axes [underlying]) after := by
  rw [axes.eq_def]
  change ((observe true (.call bindings.getproperty [value, .symbol "x"])) >>=
    fun underlying => (fun state => some (.ok (select underlying state.payload, state))) >>=
      fun selected => match selected with
        | .extruded => axes (observingAxes core select) bindings underlying
        | .other => observe true (.call bindings.axes [underlying])) world = _
  rw [bind_run]
  cases h : observe true (.call bindings.getproperty [value, .symbol "x"]) world with
  | none => rfl
  | some result =>
      cases result with
      | error error => rfl
      | ok pair =>
          rcases pair with ⟨underlying, after⟩
          dsimp only
          rw [bind_run]
          dsimp only
          cases select underlying after.payload <;> rfl

def payloadAt {W : Type} (initial : W) (worlds : Nat → W) : Nat → W
  | 0 => initial
  | n + 1 => worlds n

theorem successes_succ {W L : Type} (values : Nat → Value L) (worlds : Nat → W) (n : Nat) :
    successes (n + 1) values worlds = successes n values worlds ++ [.returned (values n) (worlds n)] := by
  simp only [successes, List.range_succ, List.map_append, List.map_cons, List.map_nil]

theorem properties_succ {L : Type} (bindings : Bindings L) (original : Value L)
    (values : Nat → Value L) (n : Nat) :
    propertyEvents bindings original values (n + 1) = propertyEvents bindings original values n ++
      [call true bindings.getproperty [wrapperAt original values n, .symbol "x"]] := by
  simp only [propertyEvents, List.range_succ, List.map_append, List.map_cons, List.map_nil]

theorem axes_prefix {W L : Type} (core : CoreOps (World W L) L)
    (select : Value L → W → AxesMethod) (bindings : Bindings L)
    (original : Value L) (values : Nat → Value L) (worlds : Nat → W) (initial : W)
    (count : Nat) (recursive : ∀ i, i < count → select (values i) (worlds i) = .extruded)
    (remaining : List (Reply W L)) (history : List (ContextEvent L)) :
    axes (observingAxes core select) bindings original
      ⟨initial, successes count values worlds ++ remaining, history⟩ =
    axes (observingAxes core select) bindings (wrapperAt original values count)
      ⟨payloadAt initial worlds count, remaining, history ++ propertyEvents bindings original values count⟩ := by
  induction count generalizing remaining history with
  | zero =>
      simp only [successes, List.range_zero, List.map_nil, List.nil_append,
        wrapperAt, payloadAt, propertyEvents, List.append_nil]
  | succ count ih =>
      rw [successes_succ, List.append_assoc]
      rw [ih (fun i hi => recursive i (by omega))]
      rw [axes_step]
      simp only [List.cons_append, List.nil_append, observe,
        recursive count (Nat.lt_succ_self count), wrapperAt, payloadAt,
        properties_succ, call, List.append_assoc]



theorem successes_take {W L : Type} (values : Nat → Value L) (worlds : Nat → W)
    (count n : Nat) (bound : n ≤ count) :
    (successes count values worlds).take n = successes n values worlds := by
  simp only [successes, ← List.map_take, List.take_range, Nat.min_eq_left bound]

theorem properties_take {L : Type} (bindings : Bindings L) (original : Value L)
    (values : Nat → Value L) (count n : Nat) (bound : n ≤ count) :
    (propertyEvents bindings original values count).take n = propertyEvents bindings original values n := by
  simp only [propertyEvents, ← List.map_take, List.take_range, Nat.min_eq_left bound]

theorem properties_length {L : Type} (bindings : Bindings L) (original : Value L)
    (values : Nat → Value L) (count : Nat) :
    (propertyEvents bindings original values count).length = count := by
  simp only [propertyEvents, List.length_map, List.length_range]

theorem axes_throw {W L : Type} (core : CoreOps (World W L) L)
    (select : Value L → W → AxesMethod) (bindings : Bindings L)
    (original : Value L) (values : Nat → Value L) (worlds : Nat → W) (initial : W)
    (count : Nat) (recursive : ∀ i, i < count → select (values i) (worlds i) = .extruded)
    (error : Value L) (failureWorld : W) (remaining : List (Reply W L)) (history : List (ContextEvent L)) :
    axes (observingAxes core select) bindings original
      ⟨initial, successes count values worlds ++ .thrown error failureWorld :: remaining, history⟩ =
    some (.error (error, ⟨failureWorld, remaining,
      history ++ propertyEvents bindings original values (count + 1)⟩)) := by
  rw [axes_prefix core select bindings original values worlds initial count recursive]
  rw [axes_step]
  simp only [observe, properties_succ, call, List.append_assoc]

theorem axes_diverge {W L : Type} (core : CoreOps (World W L) L)
    (select : Value L → W → AxesMethod) (bindings : Bindings L)
    (original : Value L) (values : Nat → Value L) (worlds : Nat → W) (initial : W)
    (count : Nat) (recursive : ∀ i, i < count → select (values i) (worlds i) = .extruded)
    (remaining : List (Reply W L)) (history : List (ContextEvent L)) :
    axes (observingAxes core select) bindings original
      ⟨initial, successes count values worlds ++ .diverged :: remaining, history⟩ = none := by
  rw [axes_prefix core select bindings original values worlds initial count recursive]
  rw [axes_step]
  rfl

theorem axes_terminal {W L : Type} (core : CoreOps (World W L) L)
    (select : Value L → W → AxesMethod) (bindings : Bindings L)
    (original : Value L) (values : Nat → Value L) (worlds : Nat → W) (initial : W)
    (count : Nat) (recursive : ∀ i, i < count → select (values i) (worlds i) = .extruded)
    (last : select (values count) (worlds count) = .other)
    (remaining : List (Reply W L)) (history : List (ContextEvent L)) :
    axes (observingAxes core select) bindings original
      ⟨initial, successes (count + 1) values worlds ++ remaining, history⟩ =
    observe true (.call bindings.axes [values count])
      ⟨worlds count, remaining, history ++ propertyEvents bindings original values (count + 1)⟩ := by
  rw [successes_succ, List.append_assoc]
  rw [axes_prefix core select bindings original values worlds initial count recursive]
  rw [axes_step]
  simp only [List.cons_append, List.nil_append, observe, last,
    properties_succ, call, List.append_assoc]



theorem axes_continues {W L : Type} (core : CoreOps (World W L) L)
    (select : Value L → W → AxesMethod) (bindings : Bindings L)
    (original : Value L) (values : Nat → Value L) (worlds : Nat → W) (initial : W)
    (count : Nat) (positive : 0 < count)
    (recursive : ∀ i, i < count → select (values i) (worlds i) = .extruded)
    (history : List (ContextEvent L)) (suffix : List (Reply W L)) :
    ContinuesAfter (axes (observingAxes core select) bindings original) count values worlds
      (propertyEvents bindings original values count) initial history suffix := by
  unfold ContinuesAfter
  refine ⟨positive, properties_length bindings original values count, ?_, ?_, ?_⟩
  · have h := axes_prefix core select bindings original values worlds initial count recursive [] history
    simp only [List.append_nil] at h
    rw [h, axes_step]
    rfl
  · intro position error failureWorld
    have bound : position.val < count := by
      simpa only [successes, List.length_map, List.length_range] using position.isLt
    dsimp only
    rw [successes_take values worlds count position.val (by omega),
      properties_take bindings original values count (position.val + 1) (by omega)]
    simpa only [List.append_assoc, List.cons_append, List.nil_append] using
      axes_throw core select bindings original values worlds initial position.val
        (fun i hi => recursive i (by omega)) error failureWorld
        ((successes count values worlds).drop (position.val + 1) ++ suffix) history
  · intro position
    have bound : position.val < count := by
      simpa only [successes, List.length_map, List.length_range] using position.isLt
    dsimp only
    rw [successes_take values worlds count position.val (by omega)]
    simpa only [List.append_assoc, List.cons_append, List.nil_append] using
      axes_diverge core select bindings original values worlds initial position.val
        (fun i hi => recursive i (by omega))
        ((successes count values worlds).drop (position.val + 1) ++ suffix) history



theorem axes_returns {W L : Type} (core : CoreOps (World W L) L)
    (select : Value L → W → AxesMethod) (bindings : Bindings L)
    (original : Value L) (values : Nat → Value L) (worlds : Nat → W) (initial : W)
    (count : Nat) (recursive : ∀ i, i < count → select (values i) (worlds i) = .extruded)
    (last : select (values count) (worlds count) = .other)
    (history : List (ContextEvent L)) (suffix : List (Reply W L)) :
    ReturnsLast (axes (observingAxes core select) bindings original) (count + 2) values worlds
      (propertyEvents bindings original values (count + 1) ++ [call true bindings.axes [values count]])
      initial history suffix := by
  have finalIndex : count + 2 - 1 = count + 1 := by omega
  have traceLength :
      (propertyEvents bindings original values (count + 1) ++ [call true bindings.axes [values count]]).length =
        count + 2 := by
    simp only [List.length_append, properties_length, List.length_cons, List.length_nil]
  unfold ReturnsLast
  refine ⟨by omega, traceLength, ?_, ?_, ?_⟩
  ·
    rw [successes_succ values worlds (count + 1), List.append_assoc,
      axes_terminal core select bindings original values worlds initial count recursive last]
    simp only [List.cons_append, List.nil_append, observe, call, List.append_assoc, finalIndex]
  · intro position error failureWorld
    have bound : position.val < count + 2 := by
      simpa only [successes, List.length_map, List.length_range] using position.isLt
    dsimp only
    rw [successes_take values worlds (count + 2) position.val (by omega)]
    by_cases inProperties : position.val < count + 1
    · have traceTake :
          (propertyEvents bindings original values (count + 1) ++ [call true bindings.axes [values count]]).take
            (position.val + 1) = propertyEvents bindings original values (position.val + 1) := by
        rw [List.take_append_of_le_length (by rw [properties_length]; omega)]
        exact properties_take bindings original values (count + 1) (position.val + 1) (by omega)
      rw [traceTake]
      simpa only [List.append_assoc, List.cons_append, List.nil_append] using
        axes_throw core select bindings original values worlds initial position.val
          (fun i hi => recursive i (by omega)) error failureWorld
          ((successes (count + 2) values worlds).drop (position.val + 1) ++ suffix) history
    · have atLast : position.val = count + 1 := by omega
      rw [atLast]
      have traceTake :
          (propertyEvents bindings original values (count + 1) ++ [call true bindings.axes [values count]]).take
            (count + 1 + 1) =
          propertyEvents bindings original values (count + 1) ++ [call true bindings.axes [values count]] := by
        apply List.take_of_length_le
        rw [traceLength]
        omega
      rw [traceTake]
      simp only [List.append_assoc, List.cons_append, List.nil_append]
      rw [axes_terminal core select bindings original values worlds initial count recursive last]
      simp only [observe, call, List.append_assoc]
  · intro position
    have bound : position.val < count + 2 := by
      simpa only [successes, List.length_map, List.length_range] using position.isLt
    dsimp only
    rw [successes_take values worlds (count + 2) position.val (by omega)]
    by_cases inProperties : position.val < count + 1
    · simpa only [List.append_assoc, List.cons_append, List.nil_append] using
        axes_diverge core select bindings original values worlds initial position.val
          (fun i hi => recursive i (by omega))
          ((successes (count + 2) values worlds).drop (position.val + 1) ++ suffix) history
    · have atLast : position.val = count + 1 := by omega
      rw [atLast]
      simp only [List.append_assoc, List.cons_append, List.nil_append]
      rw [axes_terminal core select bindings original values worlds initial count recursive last]
      rfl



theorem find_range_none (predicate : Nat → Bool) (count : Nat)
    (notFound : (List.range count).find? predicate = none) :
    ∀ i, i < count → predicate i = false := by
  intro i bound
  have negative := List.find?_eq_none.mp notFound i (List.mem_range.mpr bound)
  cases test : predicate i with
  | false => rfl
  | true => exact False.elim (negative test)

theorem find_range_some (predicate : Nat → Bool) (count found : Nat)
    (search : (List.range count).find? predicate = some found) :
    found < count ∧ predicate found = true ∧ (∀ i, i < found → predicate i = false) := by
  induction count generalizing found with
  | zero =>
      change none = some found at search
      cases search
  | succ count ih =>
      rw [List.range_succ, List.find?_append] at search
      cases early : (List.range count).find? predicate with
      | none =>
          rw [early, Option.none_or, List.find?_singleton] at search
          cases test : predicate count with
          | false =>
              simp only [test, Bool.false_eq_true, ite_false] at search
              cases search
          | true =>
              simp only [test, ite_true, Option.some.injEq] at search
              subst found
              exact ⟨Nat.lt_succ_self count, test, find_range_none predicate count early⟩
      | some earlier =>
          rw [early, Option.some_or] at search
          have equal : earlier = found := Option.some.inj search
          subst found
          have h := ih earlier early
          exact ⟨by omega, h.2⟩

end JuliaLean.ChatGPT.Batch11.Group10.AxesProofs

namespace JuliaLean.ChatGPT.Batch11.Group10
open JuliaLean.base.broadcast.Models2Group5.Extrusion
