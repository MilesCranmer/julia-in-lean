theorem bind_run {W L A B : Type} (action : CoreM W L A)
    (next : A → CoreM W L B) (world : W) :
    (do let a ← action; next a) world =
      match action world with
      | none => none
      | some (.error e) => some (.error e)
      | some (.ok (a, after)) => next a after := by
  change (Option.bind (action world) (fun result =>
    match result with
    | .error e => some (.error e)
    | .ok (a, after) => next a after)) = _
  cases action world with
  | none => rfl
  | some result => cases result <;> rfl

theorem observe_return {W L : Type} (event : Event L) (value : Value L)
    (initial payload : W) (rest : List (Reply W L)) (history : List (Event L)) :
    observe event ⟨initial, .returned value payload :: rest, history⟩ =
      some (.ok (value, ⟨payload, rest, history ++ [event]⟩)) := rfl

theorem observe_throw {W L : Type} (event : Event L) (error : Value L)
    (initial payload : W) (rest : List (Reply W L)) (history : List (Event L)) :
    observe event ⟨initial, .thrown error payload :: rest, history⟩ =
      some (.error (error, ⟨payload, rest, history ++ [event]⟩)) := rfl

theorem observe_diverge {W L : Type} (event : Event L) (initial : W)
    (rest : List (Reply W L)) (history : List (Event L)) :
    observe event ⟨initial, .diverged :: rest, history⟩ = none := rfl

theorem returns_two {W L : Type}
    (action : Action W L)
    (first : CoreOps (ProbeWorld W L) L → Event L)
    (second : CoreOps (ProbeWorld W L) L → Value L → Event L)
    (run : ∀ ops, action (observingOps ops) =
      (do let value ← observe (first ops); observe (second ops value))) :
    ReturnsLastAfter 1 action (fun ops values _ _ => [first ops, second ops (values 0)]) := by
  intro ops values worlds initial history suffix
  refine ⟨rfl, ?_, ?_, ?_⟩
  · rw [run]
    change (do let value ← observe (first ops); observe (second ops value))
      ⟨initial, .returned (values 0) (worlds 0) :: .returned (values 1) (worlds 1) :: suffix, history⟩ =
      some (.ok (values 1, ⟨worlds 1, suffix, history ++ [first ops, second ops (values 0)]⟩))
    simp only [bind_run, observe_return, List.append_assoc, List.cons_append, List.nil_append]
  · intro position error failureWorld
    rcases position with ⟨position, bound⟩
    have positions : position = 0 ∨ position = 1 := by omega
    rcases positions with hp | hp <;> subst position
    · rw [run]
      rfl
    · rw [run]
      change (do let value ← observe (first ops); observe (second ops value))
        ⟨initial, .returned (values 0) (worlds 0) :: .thrown error failureWorld :: suffix, history⟩ =
        some (.error (error, ⟨failureWorld, suffix, history ++ [first ops, second ops (values 0)]⟩))
      simp only [bind_run, observe_return, observe_throw, List.append_assoc, List.cons_append, List.nil_append]
  · intro position
    rcases position with ⟨position, bound⟩
    have positions : position = 0 ∨ position = 1 := by omega
    rcases positions with hp | hp <;> subst position <;> rw [run] <;> rfl

theorem returns_three {W L : Type}
    (action : Action W L)
    (first : CoreOps (ProbeWorld W L) L → Event L)
    (second : CoreOps (ProbeWorld W L) L → Value L → Event L)
    (third : CoreOps (ProbeWorld W L) L → Value L → Value L → Event L)
    (run : ∀ ops, action (observingOps ops) =
