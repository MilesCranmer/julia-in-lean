theorem octLoop_written {I : Type} (value : I → Int) (lowByte : I → Nat) (shr : I → Nat → I)
    (hlow : ∀ x, 0 ≤ value x → lowByte x % 8 = (value x % 8).toNat)
    (hshift : ∀ x, 0 ≤ value x → value (shr x 3) = value x / 8) (neg : Bool) :
    ∀ (k fuel : Nat) (x : I) (b : Buffer) (tail : List Nat),
      k ≤ fuel → 0 ≤ value x →
      b.bytes = List.replicate ((boolInt neg).toNat + k) 0 ++ tail →
      (octLoop lowByte shr neg fuel b x (boolInt neg + k)).bytes =
        List.replicate (boolInt neg).toNat 0 ++ writtenDigits 8 false k (value x) ++ tail := by
  intro k
  induction k with
  | zero =>
    intro fuel x b tail _ _ hbytes
    cases fuel <;> simpa only [octLoop, Int.natCast_zero, Int.add_zero, Int.le_refl,
      ite_true, writtenDigits, List.append_nil, Nat.add_zero] using hbytes
  | succ k ih =>
    intro fuel x b tail hfuel hx hbytes
    cases fuel with
    | zero => omega
    | succ fuel =>
      have hoff : 0 ≤ boolInt neg := by cases neg <;> decide
      have hr0 : 0 ≤ value x % 8 := Int.emod_nonneg _ (by decide)
      have hrlt : value x % 8 < 8 := Int.emod_lt_of_pos _ (by decide)
      have hrl : (value x % 8).toNat < 10 := by omega
      have hchar : asciiDigit false (value x % 8).toNat = 48 + lowByte x % 8 := by
        rw [hlow x hx]
        simp only [asciiDigit, hrl, ite_true]
      let next := store b (boolInt neg + (k + 1 : Nat)) (48 + lowByte x % 8)
      have hnbytes : next.bytes = List.replicate ((boolInt neg).toNat + k) 0 ++
          asciiDigit false (value x % 8).toNat :: tail := by
        have hi : boolInt neg + (k + 1 : Nat) = (((boolInt neg).toNat + k : Nat) : Int) + 1 := by omega
        dsimp only [next]
        rw [hi, ← hchar]
        apply store_zero_prefix _ _ tail _ hbytes
        rw [hchar]
        have hr : lowByte x % 8 < 8 := Nat.mod_lt _ (by decide)
        omega
      rw [octLoop, if_neg (by omega)]
      have hi : boolInt neg + (k + 1 : Nat) - 1 = boolInt neg + k := by omega
      rw [hi]
      have h := ih fuel (shr x 3) next
        (asciiDigit false (value x % 8).toNat :: tail) (by omega)
        (by rw [hshift x hx]; exact Int.ediv_nonneg hx (by decide)) hnbytes
      rw [h, writtenDigits, hshift x hx]
      simp only [List.append_assoc, List.singleton_append]

