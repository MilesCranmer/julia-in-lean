  have hpattern :
      JuliaLean.Proofs.base.int.pattern (JuliaLean.base.int.unsigned (JuliaLean.base.int.abs x)) =
        x.val.toNat := by
    rw [JuliaLean.Proofs.base.int.pattern_of_unsigned (u := t.toUnsigned) (by cases t <;> rfl),
      hval]
  have hnat : x.val.toNat ≠ 0 := by
    intro hzero
    have hcast : (x.val.toNat : Int) = x.val := Int.toNat_of_nonneg (by omega)
    rw [hzero] at hcast
    omega
  have hnonzero :
      JuliaLean.Proofs.base.int.pattern (JuliaLean.base.int.unsigned (JuliaLean.base.int.abs x)) ≠ 0 := by
    rw [hpattern]
    exact hnat
  rw [topBit_val_of_ne_zero _ hnonzero, hpattern]
