private theorem sq_le_iff_le (z c M : Int) (hz : 0 ≤ z) (hc : 0 ≤ c)
    (h1 : c * c ≤ M) (h2 : M < (c + 1) * (c + 1)) :
    z * z ≤ M ↔ z ≤ c := by
  constructor
  · intro h
    by_cases hle : z ≤ c
    · exact hle
    · have hge : c + 1 ≤ z := by omega
      have hpos : 0 ≤ c + 1 := by omega
      have hmul : (c + 1) * (c + 1) ≤ z * z := by
        calc (c + 1) * (c + 1) ≤ (c + 1) * z := Int.mul_le_mul_of_nonneg_left hge hpos
        _ ≤ z * z := Int.mul_le_mul_of_nonneg_right hge hz
      omega
  · intro h
    have hmul : z * z ≤ c * c := by
      calc z * z ≤ z * c := Int.mul_le_mul_of_nonneg_left h hz
      _ ≤ c * c := Int.mul_le_mul_of_nonneg_right h hc
    omega

