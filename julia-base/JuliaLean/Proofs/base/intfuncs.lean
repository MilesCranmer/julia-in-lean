def effectReducer {R : Type} (op : R → R → Jl R) : JuliaLean.base.reduce.Reducer (Jl R) R where
  first := fun x => .value (.ok x)
  step := fun state x => match state with
    | .initial => .value (.ok x)
    | .value acc => .value (acc >>= fun a => op a x)
  empty := .ok JuliaLean.base.reduce._empty_reduce_error

def arrayReduce {R : Type} : ArrayReduceCallees (List R) R where
  withInit := fun op xs init =>
    (JuliaLean.base.reduce.reduce (fun _ => .hasEltype) id (effectReducer op)
      (.values xs) (.value (.ok init))) >>= id
  withoutInit := fun op xs =>
    (JuliaLean.base.reduce.reduce (fun _ => .hasEltype) id (effectReducer op)
      (.values xs) .initial) >>= id

