def sameDiv {s t : IntTy} (x : JInt s) (y : JInt t) : Jl (JInt (s.promote t)) :=
  let (a,b) := JuliaLean.base.int.promoteSameSign x y
  divDefaultBitInteger a b

def sameDivrem {s t : IntTy} (x : JInt s) (y : JInt t) :
    Jl (JInt (s.promote t) × JInt (s.promote t)) :=
  let (a,b) := JuliaLean.base.int.promoteSameSign x y
  divremBitIntegerToZero a b

def modMixed {s t : IntTy} (x : JInt s) (y : JInt t) : Jl Int :=
  if s.signed = t.signed then (modMixedSameSign x y).map Subtype.val
  else if s.signed then (modMixedSignedUnsigned x y).map Subtype.val
  else (modMixedUnsignedSigned x y).map Subtype.val

def quotient (s t : IntTy) (up down : Bool) (x y : Int) : Jl Int :=
  let a := JuliaLean.base.int.lit s x
  let b := JuliaLean.base.int.lit t y
  if s.signed = t.signed then
    let (a,b) := JuliaLean.base.int.promoteSameSign a b
    (divBitIntegerMode a b (if up then .Up else if down then .Down else .ToZero)).map Subtype.val
  else if s.signed then
    if up then
      (div_Signed_Unsigned_Up
        (JuliaLean.base.int.divrem_BitSigned_Unsigned sameDivrem)
        JuliaLean.base.int.signbit (fun r => decide (r.val = 0))
        (fun q bit => JuliaLean.base.int.add q (JuliaLean.base.int.ofBool _ bit)) a b).map Subtype.val
    else if down then (fldmodMixedSignedUnsigned a b).map (fun pair => pair.1.val)
    else (JuliaLean.base.int.div_BitSigned_Unsigned sameDiv a b).map Subtype.val
  else
    if up then
      (div_Unsigned_Signed_Up
        (JuliaLean.base.int.divrem_Unsigned_BitSigned sameDivrem)
        JuliaLean.base.int.signbit (fun r => decide (r.val = 0))
        (fun q bit => JuliaLean.base.int.add q (JuliaLean.base.int.ofBool _ bit)) a b).map Subtype.val
    else if down then (fldmodMixedUnsignedSigned a b).map (fun pair => pair.1.val)
    else (JuliaLean.base.int.div_Unsigned_BitSigned sameDiv a b).map Subtype.val

def digitCallees : DigitCallees := ⟨quotient⟩

/-- GMP/BigInt operation interfaces, pending the translation of base/gmp.jl. -/
structure GmpPrimitives where
  gcdx : Int → Int → Jl (Int × Int × Int)
  powermod : Int → Int → Int → Jl Int

/-- Exact gcdext and modular-exponentiation promises of the external GMP/BigInt operations.
No mixed fixed-width mod or multiplicative-inverse operation is assumed correct. -/
def GmpDocs (g : GmpPrimitives) : Prop :=
  (∀ a b, ∃ d u v, g.gcdx a b = .ok (d,u,v) ∧
    d = (Nat.gcd a.natAbs b.natAbs : Int) ∧ a*u+b*v = d) ∧
  (∀ x p m, m ≠ 0 → (p < 0 → Nat.gcd x.natAbs m.natAbs = 1) →
    ∃ y, g.powermod x p m = .ok y ∧ ModularPower x p m y) ∧
  (∀ x p, divideError (g.powermod x p 0))

def numberCallees (g : GmpPrimitives) : NumberCallees where
  mixedMod := modMixed
  gmpGcdx := g.gcdx
  gmpPowermod := g.powermod
  magicMod := magicModBits

/-- Unbounded two's-complement XOR on the mathematical integer representation. -/
def bigXor : Int → Int → Int
  | .ofNat x, .ofNat y => .ofNat (Nat.xor x y)
  | .negSucc x, .ofNat y => .negSucc (Nat.xor x y)
  | .ofNat x, .negSucc y => .negSucc (Nat.xor x y)
  | .negSucc x, .negSucc y => .ofNat (Nat.xor x y)

/-- BigInt division uses the generic directed-rounding methods on exact integer primitives. -/
def bigFloor (x y : Int) : Jl Int :=
  div_Integer_Down bigOps.div (fun n => decide (n < 0)) bigXor Int.mul
    (fun x y => decide (x ≠ y)) (fun q bit => q - if bit then 1 else 0) x y

def bigCeiling (x y : Int) : Jl Int :=
  div_Integer_Up bigOps.div (fun n => decide (0 < n)) Int.mul
    (fun x y => decide (x ≠ y)) (fun q bit => q + if bit then 1 else 0) x y

/-- The decimal callback is unreachable in the non-BitInteger ndigits0zpb branch;
no law about its result is assumed. -/
def bigPositive (decimal : Int → Jl JInt64) (n base : Int) : Jl JInt64 :=
  ndigitsPositive id (JInt.convert (IntTy.i64.name) .i64) bigOps.abs false id id id
    (fun n => n.natAbs.log2 + 1) (fun _ => 0) (fun _ => 0) decimal
    (fun n b => bigOps.div n b.val) ispow2Bits
    (fun b => (JuliaLean.base.int.cttz_int b).val.toNat) n base

def bigNegative (n base : Int) : Jl JInt64 :=
  ndigitsNegative id false Int.neg bigFloor id Int.neg id id bigCeiling n base

def bigZero (decimal : Int → Jl JInt64) (n base : Int) : Jl JInt64 :=
  ndigitsZero id bigNegative (bigPositive decimal) n base

def bigNdigits (decimal : Int → Jl JInt64) (n base pad : Int) : Jl Int :=
