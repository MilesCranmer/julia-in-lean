/-- The terminal branch of `gcdxLoop` (taken when `b == 0`, and on exhausted fuel). -/
def finish {I : Type} (o : IntegerOps I) (a s0 t0 : I) : Jl (I × I × I) :=
  if o.value a < 0 ∧ o.value (o.abs a) < 0 then .error (.domainError "")
  else .ok (if o.value a < 0 then (o.abs a, o.neg s0, o.neg t0) else (a, s0, t0))

theorem tmod_self_or_small (a lo : Int) (hlo : lo ≠ 0) (h1 : lo ≤ a) (h2 : a < -lo) :
    a.tmod lo = 0 ∨ a.tmod lo = a := by
  have hn := Int.natAbs_tmod a lo
  have hb := JuliaLean.Proofs.base.int.tmod_between a lo
  by_cases he : a = lo
  · left; subst he; exact Int.tmod_self
  · right
    have hlt : a.natAbs < lo.natAbs := by omega
    rw [Nat.mod_eq_of_lt hlt] at hn
    by_cases ha : 0 ≤ a
    · have := hb.1 ha; omega
    · have := hb.2 (by omega); omega

