structure HasTypeMaxEvent (W Ty : Type) where
  function : ExtremumFunction
  typeValue : Ty
  observed : RationalCallSnapshot W Bool

def observeHasTypeMaxOps {W Ty : Type} (ops : HasTypeMaxOps W Ty) :
    HasTypeMaxOps (W × List (HasTypeMaxEvent W Ty)) Ty where
  applicable function typeValue := observeArrayCall
    (fun observed => ⟨function, typeValue, observed⟩)
    (ops.applicable function typeValue)

/-- Independent bounded-call, state, rejection and applicability truth
invariant. It does not assume correctness/purity of runtime queries or use the
method body as an expected result. False can be certified by either actual
negative answer; true requires both distinct extrema queries to return true.
Julia documentation: base/intfuncs.jl:1214-1217; source:1219. -/
def HasTypeMaxApplicabilityProvenance : Prop :=
  ∀ (W Ty : Type) (ops : HasTypeMaxOps W Ty) (typeValue : Ty) (world : W),
    match hasTypeMaxType (observeHasTypeMaxOps ops) typeValue (world, []) with
    | none => True
    | some (.ok (value, (final, trace))) =>
        1 ≤ trace.length ∧ trace.length ≤ 2 ∧
        (trace.map (fun event => event.function)).Nodup ∧
        (∀ event ∈ trace, event.typeValue = typeValue) ∧
        trace.map (fun event => event.observed.before) =
          (world :: trace.map (fun event => event.observed.after)).take trace.length ∧
        (∃ last, trace.getLast? = some last ∧ last.observed.after = final) ∧
        (∀ event ∈ trace, ∃ result, event.observed.outcome = .ok result) ∧
        (value = true ↔ trace.map (fun event => event.function) = [.maximum, .minimum] ∧
          ∀ event ∈ trace, event.observed.outcome = .ok true) ∧
        (value = false ↔ ∃ event ∈ trace, event.observed.outcome = .ok false) ∧
        (∀ event ∈ trace, event.function = .minimum →
          ∃ earlier, trace.head? = some earlier ∧ earlier.function = .maximum ∧
            earlier.observed.outcome = .ok true)
    | some (.error (error, (final, trace))) =>
        1 ≤ trace.length ∧ trace.length ≤ 2 ∧
        (trace.map (fun event => event.function)).Nodup ∧
        (∀ event ∈ trace, event.typeValue = typeValue) ∧
        trace.map (fun event => event.observed.before) =
          (world :: trace.map (fun event => event.observed.after)).take trace.length ∧
        (trace.filterMap fun event => match event.observed.outcome with
          | .error error => some error | _ => none) = [error] ∧
        (∃ last, trace.getLast? = some last ∧ last.observed.outcome = .error error ∧
          last.observed.after = final) ∧
        (∀ event ∈ trace, event.function = .minimum →
          ∃ earlier, trace.head? = some earlier ∧ earlier.function = .maximum ∧
            earlier.observed.outcome = .ok true)

