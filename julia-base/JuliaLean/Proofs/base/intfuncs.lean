private theorem rationalPowerTwoComponents (t : IntTy) (x : Rat t) :
    isPow2RatSource ispow2Bits x = true ↔
      (∃ k : Nat, x.num.val = (2 : Int)^k) ∧ (∃ k : Nat, x.den.val = (2 : Int)^k) := by
  unfold isPow2RatSource
  have hband : bwand (ispow2Bits x.num) (ispow2Bits x.den) = true ↔
      ispow2Bits x.num = true ∧ ispow2Bits x.den = true := by
    unfold bwand
    cases ispow2Bits x.num <;> cases ispow2Bits x.den <;> decide
  rw [hband, isPowerTwoExact_proven.1 t x.num, isPowerTwoExact_proven.1 t x.den]

private theorem bigRatPowerTwoComponents (x : BigRat) :
    isPow2RatSource (ispow2_Integer bigOps.value bigOps.countOnes) x = true ↔
      (∃ k : Nat, x.num = (2 : Int)^k) ∧ (∃ k : Nat, x.den = (2 : Int)^k) := by
  unfold isPow2RatSource
  have hband :
      bwand (ispow2_Integer bigOps.value bigOps.countOnes x.num)
        (ispow2_Integer bigOps.value bigOps.countOnes x.den) = true ↔
      ispow2_Integer bigOps.value bigOps.countOnes x.num = true ∧
        ispow2_Integer bigOps.value bigOps.countOnes x.den = true := by
    unfold bwand
    cases ispow2_Integer bigOps.value bigOps.countOnes x.num <;>
      cases ispow2_Integer bigOps.value bigOps.countOnes x.den <;> decide
