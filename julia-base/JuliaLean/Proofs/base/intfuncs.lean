theorem store_at_append (b : Buffer) (priorBytes : List Nat) (old : Nat)
    (tail : List Nat) (ch : Nat)
    (hb : b.bytes = priorBytes ++ old :: tail) (hch : ch < 256) :
    (store b ((priorBytes.length : Int) + 1) ch).bytes = priorBytes ++ ch :: tail := by
  unfold store
  rw [hb]
  have hi : ((priorBytes.length : Int) + 1 - 1).toNat = priorBytes.length := by omega
  rw [hi, Nat.mod_eq_of_lt hch,
    List.set_append_right _ _ (Nat.le_refl priorBytes.length)]
  simp only [Nat.sub_self, List.set_cons_zero]

theorem store_pair_zero_prefix (b : Buffer) (p : Nat) (tail : List Nat)
    (hi lo : Nat) (hb : b.bytes = List.replicate (p + 2) 0 ++ tail)
    (hhi : hi < 256) (hlo : lo < 256) :
    (store (store b ((p : Int) + 1) hi) ((p : Int) + 2) lo).bytes =
      List.replicate p 0 ++ hi :: lo :: tail := by
  have hfirst : (store b ((p : Int) + 1) hi).bytes =
      List.replicate p 0 ++ hi :: 0 :: tail := by
    apply store_zero_prefix _ p (0 :: tail) hi
    · simpa only [Nat.add_assoc, List.replicate_succ', List.append_assoc,
        List.singleton_append, List.cons_append, List.nil_append] using hb
    · exact hhi
  have hsecond := store_at_append (store b ((p : Int) + 1) hi)
    (List.replicate p 0 ++ [hi]) 0 tail lo
    (by simpa only [List.append_assoc, List.singleton_append] using hfirst) hlo
  simpa only [List.length_append, List.length_replicate, List.length_singleton,
    Int.natCast_add, Int.natCast_one, Int.add_assoc, List.append_assoc,
    List.singleton_append, show (1 : Int) + 1 = 2 by decide] using hsecond

theorem hexChar_ascii (d : Nat) (hd : d < 16) :
    hexChar d = asciiDigit false d ∧ hexChar d < 256 := by
  have h : ∀ d : Fin 16, hexChar d.val = asciiDigit false d.val ∧
      hexChar d.val < 256 := by decide
  exact h ⟨d, hd⟩

theorem writtenDigits_pair (k : Nat) (n : Int) :
    writtenDigits 16 false (k + 2) n =
      writtenDigits 16 false k (n / 256) ++
        [asciiDigit false (n / 16 % 16).toNat,
          asciiDigit false (n % 16).toNat] := by
  simp only [writtenDigits, List.append_assoc, List.singleton_append]
  rw [Int.ediv_ediv_of_nonneg (by decide : (0 : Int) ≤ 16)]
  rfl

theorem writtenDigits_split (a b : Nat) (n : Int) :
    writtenDigits 16 false (a + b) n =
      writtenDigits 16 false a (n / (16 : Int) ^ b) ++
        writtenDigits 16 false b n := by
  induction b generalizing n with
  | zero => simp only [Nat.add_zero, Int.pow_zero, Int.ediv_one, writtenDigits, List.append_nil]
  | succ b ih =>
    rw [Nat.add_succ, writtenDigits, ih, writtenDigits, List.append_assoc]
    rw [Int.ediv_ediv_of_nonneg (by decide : (0 : Int) ≤ 16),
      Int.pow_succ, Int.mul_comm (16 : Int) ((16 : Int) ^ b)]

theorem writtenDigits_head (k : Nat) (n : Int) :
    writtenDigits 16 false (k + 1) n =
      asciiDigit false (n / (16 : Int) ^ k % 16).toNat ::
        writtenDigits 16 false k n := by
  have h := writtenDigits_split 1 k n
  simpa only [Nat.add_comm 1 k, writtenDigits, List.nil_append,
    List.singleton_append] using h

theorem lowByte_digits (n : Int) (byte : Nat)
    (hb : byte % 256 = (n % 256).toNat) :
    (byte % 256) / 16 = (n / 16 % 16).toNat ∧
    (byte % 256) % 16 = (n % 16).toNat := by
  have hr0 : 0 ≤ n % 256 := Int.emod_nonneg _ (by decide)
  have hrlt : n % 256 < 256 := Int.emod_lt_of_pos _ (by decide)
  have hd0 : 0 ≤ n / 16 % 16 := Int.emod_nonneg _ (by decide)
  have hdlt : n / 16 % 16 < 16 := Int.emod_lt_of_pos _ (by decide)
  have hl0 : 0 ≤ n % 16 := Int.emod_nonneg _ (by decide)
  have hllt : n % 16 < 16 := Int.emod_lt_of_pos _ (by decide)
  rw [hb]
  constructor <;> omega

theorem hexLoop_written {I : Type} (value : I → Int) (lowByte : I → Nat)
    (shr : I → Nat → I)
    (hlow : ∀ x, 0 ≤ value x → lowByte x % 256 = (value x % 256).toNat)
    (hshift : ∀ x, 0 ≤ value x → value (shr x 8) = value x / 256) :
    ∀ (k fuel r : Nat) (x : I) (b : Buffer) (tail : List Nat),
      k ≤ fuel → r < 2 → 0 ≤ value x →
      b.bytes = List.replicate (r + 2 * k) 0 ++ tail →
      ∃ out y, hexLoop lowByte shr fuel b x ((r + 2 * k : Nat) : Int) =
          (out, y, (r : Int)) ∧
        out.bytes = List.replicate r 0 ++
          writtenDigits 16 false (2 * k) (value x) ++ tail ∧
        value y = value x / (256 : Int) ^ k := by
  intro k
  induction k with
  | zero =>
    intro fuel r x b tail _ hr _ hb
    refine ⟨b, x, ?_, ?_, ?_⟩
    · cases fuel <;> simp only [hexLoop, Nat.mul_zero, Nat.add_zero,
        if_pos (show (r : Int) < 2 by omega)]
    · simpa only [Nat.mul_zero, Nat.add_zero, writtenDigits, List.append_nil] using hb
    · simp only [Int.pow_zero, Int.ediv_one]
  | succ k ih =>
    intro fuel r x b tail hf hr hx hb
    cases fuel with
    | zero => omega
    | succ fuel =>
      let hi := hexChar ((lowByte x % 256) / 16)
      let lo := hexChar ((lowByte x % 256) % 16)
      have hbyte : lowByte x % 256 < 256 := Nat.mod_lt _ (by decide)
      have hhi := hexChar_ascii ((lowByte x % 256) / 16) (by omega)
      have hlo := hexChar_ascii ((lowByte x % 256) % 16) (Nat.mod_lt _ (by decide))
      have hd := lowByte_digits (value x) (lowByte x) (hlow x hx)
      have hi_eq : hi = asciiDigit false (value x / 16 % 16).toNat := by
        exact hhi.1.trans (congrArg (asciiDigit false) hd.1)
      have lo_eq : lo = asciiDigit false (value x % 16).toNat := by
        exact hlo.1.trans (congrArg (asciiDigit false) hd.2)
      let next := store (store b (((r + 2 * k : Nat) : Int) + 1) hi)
        (((r + 2 * k : Nat) : Int) + 2) lo
      have hnext : next.bytes = List.replicate (r + 2 * k) 0 ++ hi :: lo :: tail := by
        apply store_pair_zero_prefix _ (r + 2 * k) tail hi lo
        · simpa only [Nat.mul_add, Nat.mul_one, Nat.add_assoc] using hb
        · exact hhi.2
        · exact hlo.2
      obtain ⟨out, y, hloop, hout, hy⟩ := ih fuel r (shr x 8) next (hi :: lo :: tail)
        (by omega) hr (by rw [hshift x hx]; exact Int.ediv_nonneg hx (by decide)) hnext
      refine ⟨out, y, ?_, ?_, ?_⟩
      · rw [hexLoop, if_neg (by omega)]
        have hi1 : (((r + 2 * (k + 1) : Nat) : Int) - 1) =
            (((r + 2 * k : Nat) : Int) + 1) := by omega
        have hi2 : (((r + 2 * (k + 1) : Nat) : Int)) =
            (((r + 2 * k : Nat) : Int) + 2) := by omega
        have hi0 : (((r + 2 * (k + 1) : Nat) : Int) - 2) =
            (((r + 2 * k : Nat) : Int)) := by omega
        rw [hi1, hi0, hi2]
        exact hloop
      · rw [hout, hshift x hx]
        have hk : 2 * (k + 1) = 2 * k + 2 := by omega
        rw [hk, writtenDigits_pair, hi_eq, lo_eq]
        simp only [List.append_assoc, List.cons_append, List.nil_append]
      · rw [hy, hshift x hx, Int.ediv_ediv_of_nonneg (by decide : (0 : Int) ≤ 256),
          Int.pow_succ, Int.mul_comm (256 : Int) ((256 : Int) ^ k)]

theorem minusSign_cons (b : Buffer) (old : Nat) (tail : List Nat)
    (hb : b.bytes = old :: tail) :
    (minusSign true b).bytes = 45 :: tail := by
  have h := store_at_append b [] old tail 45 hb (by decide)
  simpa only [minusSign, ite_true, List.length_nil, Int.natCast_zero,
    Int.zero_add, List.nil_append] using h

theorem hex_finish_written {I : Type} (value : I → Int) (lowByte : I → Nat)
    (shr : I → Nat → I)
    (hlow : ∀ x, 0 ≤ value x → lowByte x % 256 = (value x % 256).toNat)
    (hshift : ∀ x, 0 ≤ value x → value (shr x 8) = value x / 256)
    (x : I) (b : Buffer) (count n : Nat) (neg : Bool)
    (hx : 0 ≤ value x) (hn : n = (boolInt neg).toNat + count)
    (hb : b.bytes = List.replicate n 0) :
    let out := hexLoop lowByte shr (n / 2 + 1) b x (n : Int)
    (minusSign neg (if out.2.2 > boolInt neg then
      store out.1 out.2.2 (hexChar (lowByte out.2.1 % 16)) else out.1)).bytes =
      (if neg then [45] else []) ++ writtenDigits 16 false count (value x) := by
  let k := n / 2
  let r := n % 2
  have hr : r < 2 := Nat.mod_lt _ (by decide)
  have hnr : n = r + 2 * k := (Nat.mod_add_div n 2).symm
  obtain ⟨out, y, hloop, hout, hy⟩ := hexLoop_written value lowByte shr hlow hshift
    k (n / 2 + 1) r x b [] (by dsimp only [k]; omega) hr hx
    (by rw [← hnr]; simpa only [List.append_nil] using hb)
  rw [← hnr] at hloop
  dsimp only
  rw [hloop]
  simp only [List.append_nil] at hout
  have hyr : 0 ≤ value y := by
    rw [hy]
    exact Int.ediv_nonneg hx (Int.le_of_lt (Int.pow_pos (by decide)))
  have hlow16 : lowByte y % 16 = (value y % 16).toNat := by
    have hm : lowByte y % 16 = (lowByte y % 256) % 16 := by omega
    exact hm.trans (lowByte_digits (value y) (lowByte y) (hlow y hyr)).2
  have hpow : (16 : Int) ^ (2 * k) = (256 : Int) ^ k := by
    rw [Int.pow_mul]
    rfl
  have hr_cases : r = 0 ∨ r = 1 := by omega
  cases neg with
  | false =>
    simp only [boolInt, Bool.false_eq_true, ite_false, Int.toNat_zero, Nat.zero_add] at hn
    simp only [boolInt, Bool.false_eq_true, ite_false, List.nil_append, minusSign]
    rcases hr_cases with hr0 | hr1
    · have hc : count = 2 * k := by omega
      rw [hr0, if_neg (by omega), hc]
      simpa only [hr0, List.replicate_zero, List.nil_append] using hout
    · have hc : count = 2 * k + 1 := by omega
      rw [hr1, if_pos (by omega), hc]
      have hb' : out.bytes = 0 :: writtenDigits 16 false (2 * k) (value x) := by
        simpa only [hr1, List.replicate_one, List.singleton_append] using hout
      have hch := hexChar_ascii (lowByte y % 16) (Nat.mod_lt _ (by decide))
      have hstore := store_at_append out [] 0
        (writtenDigits 16 false (2 * k) (value x)) (hexChar (lowByte y % 16)) hb' hch.2
      have hstore' : (store out 1 (hexChar (lowByte y % 16))).bytes =
          hexChar (lowByte y % 16) :: writtenDigits 16 false (2 * k) (value x) := by
        simpa only [List.length_nil, Int.natCast_zero, Int.zero_add, List.nil_append] using hstore
      rw [Int.natCast_one, hstore', hch.1, hlow16, hy, ← hpow, writtenDigits_head]
  | true =>
    simp only [boolInt, ite_true, Int.toNat_one] at hn
    simp only [boolInt, ite_true, List.singleton_append]
    rcases hr_cases with hr0 | hr1
    · have hc : 2 * k = count + 1 := by omega
      rw [hr0, if_neg (by omega)]
      have hb' : out.bytes =
          asciiDigit false (value x / (16 : Int) ^ count % 16).toNat ::
            writtenDigits 16 false count (value x) := by
        simpa only [hr0, List.replicate_zero, List.nil_append, hc, writtenDigits_head] using hout
      exact minusSign_cons out _ _ hb'
    · have hc : count = 2 * k := by omega
      rw [hr1, if_neg (by omega), hc]
      have hb' : out.bytes = 0 :: writtenDigits 16 false (2 * k) (value x) := by
        simpa only [hr1, List.replicate_one, List.singleton_append] using hout
      exact minusSign_cons out 0 _ hb'

def hexOutput {I : Type} (lowByte : I → Nat) (shr : I → Nat → I)
    (x : I) (neg : Bool) (n : Int) (initial : Buffer) : Buffer :=
  let run := hexLoop lowByte shr (n.toNat / 2 + 1) initial x n
  minusSign neg (if run.2.2 > boolInt neg then
    store run.1 run.2.2 (hexChar (lowByte run.2.1 % 16)) else run.1)

/-- Expose the modeled call with abstract callbacks before specializing them to native integers. -/
theorem hex_call_success {I : Type} (top : I → Nat) (lowByte : I → Nat)
    (shr : I → Nat → I) (x : I) (pad : JInt64) (neg : Bool)
    (m n : Int) (initial : Buffer)
    (hm : ((top x : Int) + 3) / 4 = m)
    (hn : wrapInt .i64 (boolInt neg + max pad.val m) = n)
    (hnew : newBuffer n = .ok initial) :
    hex top lowByte shr x pad neg = .ok (hexOutput lowByte shr x neg n initial) := by
  unfold hex hexOutput
  simp only [hm, hn, hnew, Bind.bind, Except.bind, Pure.pure, Except.pure] <;> rfl

theorem hex_call_error {I : Type} (top : I → Nat) (lowByte : I → Nat)
    (shr : I → Nat → I) (x : I) (pad : JInt64) (neg : Bool)
    (m n : Int) (e : JlError)
    (hm : ((top x : Int) + 3) / 4 = m)
    (hn : wrapInt .i64 (boolInt neg + max pad.val m) = n)
    (hnew : newBuffer n = .error e) :
    hex top lowByte shr x pad neg = .error e := by
  unfold hex
  simp only [hm, hn, hnew, Bind.bind, Except.bind] <;> rfl

theorem hex_output_written {I : Type} (value : I → Int) (lowByte : I → Nat)
    (shr : I → Nat → I)
    (hlow : ∀ x, 0 ≤ value x → lowByte x % 256 = (value x % 256).toNat)
    (hshift : ∀ x, 0 ≤ value x → value (shr x 8) = value x / 256)
    (x : I) (b : Buffer) (count : Nat) (n : Int) (neg : Bool)
    (hx : 0 ≤ value x) (hn0 : 0 ≤ n)
    (hn : n.toNat = (boolInt neg).toNat + count)
    (hb : b.bytes = List.replicate n.toNat 0) :
    (hexOutput lowByte shr x neg n b).bytes =
      (if neg then [45] else []) ++ writtenDigits 16 false count (value x) := by
  have h := hex_finish_written value lowByte shr hlow hshift x b count n.toNat neg hx hn hb
  rw [Int.toNat_of_nonneg hn0] at h
  exact h

theorem native_hex_writer (t : IntTy) (x : JInt t) (pad : JInt64) (neg : Bool)
    (ht : t.signed = false) :
    approvedRound6.WriterNumeral (approvedRound6.Concrete.hexBits x pad neg)
      x.val 16 pad.val neg := by
  let m := (topBit x + 3) / 4
  have hmInt : ((topBit x : Int) + 3) / 4 = (m : Int) := by
    dsimp only [m]
    rw [Int.natCast_ediv, Int.natCast_add]
    rfl
  have hm0 := native_power_count ht x pad.val 4 (by decide)
  dsimp only at hm0
  have hm_eq : (topBit x + 4 - 1) / 4 = m := by dsimp only [m]; omega
  rw [hm_eq] at hm0
  change m ≤ 128 ∧ DigitCount x.val 16 pad.val (max pad.val (m : Int)) at hm0
  unfold approvedRound6.WriterNumeral
  by_cases herr : neg = true ∧ pad.val = IntTy.max .i64
  · rw [if_pos herr]
    obtain ⟨rfl, hp⟩ := herr
    have hmax : max pad.val (m : Int) = IntTy.max .i64 := by
      rw [hp]
      apply Int.max_eq_left
      change (m : Int) ≤ 9223372036854775807
      omega
    have hwrap : wrapInt .i64 (boolInt true + max pad.val (m : Int)) =
        -9223372036854775808 := by rw [hmax]; decide
    have hresult : approvedRound6.Concrete.hexBits x pad true =
        .error (.inexactError (IntTy.u64.name)) := by
      change hex topBit (fun x : JInt t => (JuliaLean.base.int.remT .u8 x).val.toNat)
        (fun x n => JuliaLean.base.int.lshr_Int x (JuliaLean.base.int.lit .i64 n))
        x pad true = _
      exact hex_call_error _ _ _ x pad true (m : Int) (-9223372036854775808)
        (.inexactError (IntTy.u64.name)) hmInt hwrap
        (newBuffer_negative (-9223372036854775808) (by decide))
    rw [hresult]
    trivial
  · rw [if_neg herr]
    let count := max pad.val (m : Int)
    let n := boolInt neg + count
    have hbounds := writer_length_bounds pad m hm0.1 neg herr
    have hc0 : 0 ≤ count := hbounds.1
    have hn0 : 0 ≤ n := hbounds.2.1
    have hnmax : n ≤ IntTy.max .i64 := hbounds.2.2
    have hnmaxu : n ≤ IntTy.max .u64 := by
      change n ≤ 18446744073709551615
      change n ≤ 9223372036854775807 at hnmax
      omega
    have hwrap : wrapInt .i64 (boolInt neg + max pad.val (m : Int)) = n := by
      apply wrapInt_of_inRange
      constructor
      · change -9223372036854775808 ≤ n
