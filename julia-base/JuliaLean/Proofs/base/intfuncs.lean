def onlyList {A : Type} (xs : List A) : Jl A :=
  let lift {B : Type} (result : Jl B) : JuliaLean.base.iterators.Exec JlError Unit B :=
    fun () => some (result, ())
  let run (values : List A) (state : Option Nat) :=
    lift ((JuliaLean.base.iterators.listIterator values).run state)
  let pair (value : Option (A × Nat)) : JuliaLean.base.iterators.Exec JlError Unit (A × Nat) :=
    lift (match value with
      | some pair => pure pair
      | none => .error (.methodError "NTuple{2,Any}"))
  let failure (message : String) : JuliaLean.base.iterators.Exec JlError Unit A :=
    lift (.error (.argumentError message))
  let output := JuliaLean.base.iterators.onlyModel run pair failure xs true ()
  have total : output.isSome := by
    cases xs with
    | nil =>
      simp [output, run, pair, failure, lift, JuliaLean.base.iterators.onlyModel,
        JuliaLean.base.iterators.sourceMethod1661, JuliaLean.base.iterators.bind,
        JuliaLean.base.iterators.ret, JuliaLean.base.iterators.listIterator,
        JuliaLean.base.iterators.listGet, Bind.bind, Pure.pure, Except.pure]
    | cons x xs =>
      cases xs <;>
        simp [output, run, pair, failure, lift, JuliaLean.base.iterators.onlyModel,
          JuliaLean.base.iterators.sourceMethod1661, JuliaLean.base.iterators.bind,
          JuliaLean.base.iterators.ret, JuliaLean.base.iterators.listIterator,
          JuliaLean.base.iterators.listGet, Bind.bind, Pure.pure, Except.pure]
  (output.get total).1

