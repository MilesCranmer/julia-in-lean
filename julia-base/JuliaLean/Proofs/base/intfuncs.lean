/-- Independent native Bezout outcome: exact mathematical gcd and a
coefficient congruence in the machine ring, including unsigned coefficients.
An unrepresentable nonnegative gcd is the two-argument gcdx DomainError.
This does not prescribe the extended-Euclidean recurrence or callback laws. -/
def NativeBezoutOutcome {W : Type} {t : IntTy} (world : W) (a b : Int)
    (observed : Option (Except (JuliaLean.base.io.Error × W)
      ((JInt t × JInt t × JInt t) × W))) : Prop :=
  let expected : Int := Nat.gcd a.natAbs b.natAbs
  if expected ≤ t.max then
    ∃ d u v, observed = some (.ok ((d, u, v), world)) ∧ d.val = expected ∧
      (a * u.val + b * v.val - d.val) % (2 ^ t.bits : Int) = 0 ∧
      (a = 0 ∧ b = 0 → u.val = 0 ∧ v.val = 0)
  else
    ∃ message, observed = some (.error (.jl (.domainError message), world))

/-- All ordered native type/value pairs in the Real gcdx body preserve
promotion failure before arithmetic, then the mathematical gcd and modular
Bezout identity, or DomainError for an unrepresentable gcd. No representable-
input premise excludes mixed signed/unsigned errors; every outcome preserves
the world. The native promotion and gcdx implementations are installed models.
Julia source/documentation: base/intfuncs.jl:194-261;
doc/src/manual/conversion-and-promotion.md:28-39. -/
def GcdxRealBitsBezout : Prop :=
  ∀ (W : Type) (world : W) (s t : IntTy) (a : JInt s) (b : JInt t),
    let observed := gcdxReal (gcdxPromoteBitsOps (World := W) s t) a b world
    if (s.promote t).min ≤ a.val ∧ a.val ≤ (s.promote t).max ∧
        (s.promote t).min ≤ b.val ∧ b.val ≤ (s.promote t).max then
      NativeBezoutOutcome world a.val b.val observed
    else
      ∃ name, observed = some (.error (.jl (.inexactError name), world))

/-- Reused same-type Real fallback rejects every input pair with the proper
MethodError and never fabricates a result. Its argument tuple and message
printing are outside the established exception payload boundary.
Julia source: base/intfuncs.jl:262. -/
def UnsupportedRealGcdxRejection : Prop :=
  ∀ (Input Result : Type) (a b : Input),
    UnsupportedRealFailure "gcdx"
      (JuliaLean.base.intfuncs.gcdx_NoMethod (A := Result) a b)

/-- Unary native gcdx returns magnitude and an exact Bezout coefficient of
unit magnitude, with coefficient +1 for zero. Signed minimum fails before
the coefficient calls with OverflowError, distinct from binary gcdx's
DomainError. Every width/value and all zero/sign cases are included.
Julia source/documentation: base/intfuncs.jl:194-234,263. -/
def GcdxUnaryBitsBezout : Prop :=
  ∀ (W : Type) (world : W) (t : IntTy) (a : JInt t),
    let expected : Int := a.val.natAbs
    let observed := gcdxUnary (gcdxUnaryBitsOps (World := W) t) a world
    if expected ≤ t.max then
      ∃ d coefficient, observed = some (.ok ((d, coefficient), world)) ∧
        d.val = expected ∧ a.val * coefficient.val = d.val ∧
        coefficient.val.natAbs = 1 ∧ (a.val = 0 → coefficient.val = 1)
    else
      ∃ message, observed = some (.error (.jl (.overflowError message), world))

