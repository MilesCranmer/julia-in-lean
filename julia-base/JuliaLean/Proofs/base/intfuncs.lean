      JuliaLean.base.io.M W R) world = some (.error (.jl (.domainError message), world))

/-! The state-aware observer is the existing `recordStateCall` from the
promotion property fragment. It evaluates selected actions once. -/

inductive PowerDiagnosticEvent (W P F N : Type) where
  | floating (before : W) (argument : P)
      (result : Except JuliaLean.base.io.Error F) (after : W)
  | negating (before : W) (argument : P)
      (result : Except JuliaLean.base.io.Error N) (after : W)

def observePowerDomainOps {W P F N : Type} (ops : PowerDomainIntegerOps W P F N) :
    PowerDomainIntegerOps (W × List (PowerDiagnosticEvent W P F N)) P F N where
  float p := recordStateCall (fun before result after =>
    .floating before p result after) (ops.float p)
  neg p := recordStateCall (fun before result after =>
    .negating before p result after) (ops.neg p)

def powerDiagnosticBefore {W P F N : Type} : PowerDiagnosticEvent W P F N → W
  | .floating before _ _ _ => before
  | .negating before _ _ _ => before

def powerDiagnosticAfter {W P F N : Type} : PowerDiagnosticEvent W P F N → W
  | .floating _ _ _ after => after
  | .negating _ _ _ after => after

def powerDiagnosticArgument {W P F N : Type} : PowerDiagnosticEvent W P F N → P
  | .floating _ argument _ _ => argument
  | .negating _ argument _ _ => argument

def powerDiagnosticRank {W P F N : Type} : PowerDiagnosticEvent W P F N → Nat
  | .floating _ _ _ _ => 0
  | .negating _ _ _ _ => 1

def powerDiagnosticError {W P F N : Type} :
    PowerDiagnosticEvent W P F N → Option JuliaLean.base.io.Error
  | .floating _ _ (.error error) _ => some error
  | .negating _ _ (.error error) _ => some error
  | _ => none

/-- All observed changes originate in selected callees; each eager diagnostic
operation runs at most once in order and receives the original exponent.
A callee failure is unique and final. Only after both calls succeed may the
helper produce its own DomainError. The output is never a normal value.
These are execution invariants for arbitrary callees, not callee laws.
Julia source: base/intfuncs.jl:388-392. -/
def PowerDiagnosticFailureInvariant {W P F N : Type} (p : P)
    (initial final : W) (trace : List (PowerDiagnosticEvent W P F N))
    (error : JuliaLean.base.io.Error) : Prop :=
  trace.length ≤ 2 ∧
  trace.head?.map powerDiagnosticBefore = some initial ∧
  trace.getLast?.map powerDiagnosticAfter = some final ∧
  trace.Pairwise (fun first second => powerDiagnosticRank first < powerDiagnosticRank second) ∧
  (∀ event ∈ trace, powerDiagnosticArgument event = p) ∧
  (∀ index first second, (trace)[index]? = some first → (trace)[index + 1]? = some second →
    powerDiagnosticAfter first = powerDiagnosticBefore second) ∧
  match trace.filterMap powerDiagnosticError with
  | [] => trace.length = 2 ∧ ∃ message, error = .jl (.domainError message)
  | errors => errors = [error] ∧
      ∃ event, trace.getLast? = some event ∧ powerDiagnosticError event = some error

/-- Complete diagnostic failure provenance for every exponent carrier, result
carrier, mutable world and arbitrary float/negation implementations. Callbacks
may mutate, throw, or diverge; no correctness or termination law is assumed.
Any completed run is an error with the stated state/argument provenance.
Julia source: base/intfuncs.jl:388-392 at
f755f49a9e41380d7da126b3c1db9fe7f83dd027. -/
def IntegerPowerDomainFailureProvenance : Prop :=
  ∀ (W A P F N R : Type) (ops : PowerDomainIntegerOps W P F N)
      (x : A) (p : P) (world : W),
    match (throwPowerDomainInteger (observePowerDomainOps ops) x p :
        JuliaLean.base.io.M (W × List (PowerDiagnosticEvent W P F N)) R) (world, []) with
    | none => True
    | some (.ok _) => False
    | some (.error (error, (final, trace))) =>
        PowerDiagnosticFailureInvariant p world final trace error

