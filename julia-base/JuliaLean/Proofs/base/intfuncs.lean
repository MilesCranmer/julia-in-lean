inductive TailBinomialPromotionEvent (W A B P R : Type) where
  | promoted (before : W) (a : A) (b : B)
      (result : Except JuliaLean.base.io.Error P) (after : W)
  | applied (before : W) (iterate : IterateToken) (function : TailBinomialFunction)
      (promoted : P) (result : Except JuliaLean.base.io.Error R) (after : W)

def observeBinomialPromotionOps {W A B P R : Type}
    (ops : BinomialPromoteOps (JuliaLean.base.io.M W) A B P R) :
    BinomialPromoteOps (JuliaLean.base.io.M (W × List (TailBinomialPromotionEvent W A B P R))) A B P R where
  promote a b := recordStateCall (fun before result after =>
    .promoted before a b result after) (ops.promote a b)
  applyIterate iterate function promoted := recordStateCall
    (fun before result after => .applied before iterate function promoted result after)
    (ops.applyIterate iterate function promoted)

def tailBinomialPromotionBefore {W A B P R : Type} : TailBinomialPromotionEvent W A B P R → W
  | .promoted before _ _ _ _ => before
  | .applied before _ _ _ _ _ => before

def tailBinomialPromotionAfter {W A B P R : Type} : TailBinomialPromotionEvent W A B P R → W
  | .promoted _ _ _ _ after => after
  | .applied _ _ _ _ _ after => after

def tailBinomialPromotionError {W A B P R : Type} :
    TailBinomialPromotionEvent W A B P R → Option JuliaLean.base.io.Error
  | .promoted _ _ _ (.error error) _ => some error
  | .applied _ _ _ _ (.error error) _ => some error
  | _ => none

def tailBinomialPromotionInputs {W A B P R : Type} (trace : List (TailBinomialPromotionEvent W A B P R)) :
    List (A × B) :=
  trace.filterMap fun event => match event with
    | .promoted _ a b _ _ => some (a, b)
    | _ => none

def tailBinomialPromotionOutputs {W A B P R : Type} (trace : List (TailBinomialPromotionEvent W A B P R)) : List P :=
  trace.filterMap fun event => match event with
    | .promoted _ _ _ (.ok value) _ => some value
    | _ => none

def tailBinomialPromotionApplicationOutputs {W A B P R : Type}
    (trace : List (TailBinomialPromotionEvent W A B P R)) : List R :=
  trace.filterMap fun event => match event with
    | .applied _ _ _ _ (.ok value) _ => some value
    | _ => none

/-- Call cardinality, reference identity, fixed function identity, and state
conservation. The runtime receives precisely the opaque promoted object; no
pair, tuple, length or iterator law is assumed. All changes to the private
world originate in actual observed callee changes.
Source invariants: base/intfuncs.jl:1373. -/
def TailBinomialPromotionTraceInvariant {W A B P R : Type} (function : TailBinomialFunction)
    (a : A) (b : B) (initial final : W) (trace : List (TailBinomialPromotionEvent W A B P R)) : Prop :=
  trace.length ≤ 2 ∧
  tailBinomialPromotionInputs trace = [(a, b)] ∧
  trace.head?.map tailBinomialPromotionBefore = some initial ∧
  trace.getLast?.map tailBinomialPromotionAfter = some final ∧
  (∀ index first second,
    (trace)[index]? = some first → (trace)[index + 1]? = some second →
    tailBinomialPromotionAfter first = tailBinomialPromotionBefore second) ∧
  (∀ before iterate actualFunction promoted result after,
    TailBinomialPromotionEvent.applied before iterate actualFunction promoted result after ∈ trace →
      iterate = .baseIterate ∧ actualFunction = function ∧
      tailBinomialPromotionOutputs trace = [promoted])

def TailBinomialPromotionTerminalInvariant {W A B P R : Type}
    (trace : List (TailBinomialPromotionEvent W A B P R)) : Except JuliaLean.base.io.Error R → Prop
  | .ok value => tailBinomialPromotionApplicationOutputs trace = [value] ∧ trace.filterMap tailBinomialPromotionError = []
  | .error error => trace.filterMap tailBinomialPromotionError = [error] ∧
      ∃ event, trace.getLast? = some event ∧ tailBinomialPromotionError event = some error

def TailBinomialPromotionObservation {W A B P R : Type} (function : TailBinomialFunction)
    (a : A) (b : B) (initial : W)
    (action : JuliaLean.base.io.M (W × List (TailBinomialPromotionEvent W A B P R)) R) : Prop :=
  match action (initial, []) with
  | none => True
  | some (.ok (value, (final, trace))) =>
      TailBinomialPromotionTraceInvariant function a b initial final trace ∧
      TailBinomialPromotionTerminalInvariant trace (.ok value)
  | some (.error (error, (final, trace))) =>
      TailBinomialPromotionTraceInvariant function a b initial final trace ∧
      TailBinomialPromotionTerminalInvariant trace (.error error)


/-- Entire promotion/application provenance, over all effectful callees and opaque
promotion results, with no shape or arithmetic law. -/
def BinomialMixedProvenance : Prop :=
  ∀ (W N K P R : Type) (ops : BinomialPromoteOps (JuliaLean.base.io.M W) N K P R)
      (n : N) (k : K) (world : W),
    TailBinomialPromotionObservation .binomial n k world
      (binomialMixed (observeBinomialPromotionOps ops) n k)


/-- Ordered native intervals have the mathematical metric projection. Reversed
bounds retain their documented endpoint priority. No native value is excluded. -/
def ClampNativeProjection : Prop :=
  ∀ (W : Type) (t : IntTy) (x lo hi : JInt t) (world : W),
    ∃ result, clampGeneric (clampBitsOps t) x lo hi world = some (.ok (result, world)) ∧
      (result = x ∨ result = lo ∨ result = hi) ∧
      (if lo.val ≤ hi.val then result.val = min hi.val (max lo.val x.val)
       else result.val = if x.val ≤ hi.val then lo.val else hi.val)

/-- All ordered native source/target type pairs saturate to the target interval,
without a conversion error or change to the private world. -/
def ClampTypeNativeProjection : Prop :=
  ∀ (W : Type) (source target : IntTy) (x : JInt source) (world : W),
    ∃ result, clampType (clampTypeBitsOps source target) x target world =
        some (.ok (result, world)) ∧
      result.val = min target.max (max target.min x.val)

def ClampBottomErrorIdentity : Prop :=
  ∀ (X Tail R : Type) (x : X) (rest : Tail),
    match (JuliaLean.base.intfuncs.clamp_Bottom x rest : Jl R) with
    | .error (.methodError name) => name = "clamp"
    | _ => False

/-- Observation utilities do not modify any Julia computation. -/
def tailPreserveLog {W E A : Type} (action : JuliaLean.base.io.M W A) :
    JuliaLean.base.io.M (W × List E) A := fun (world, events) =>
  match action world with
  | none => none
  | some (.ok (result, next)) => some (.ok (result, (next, events)))
  | some (.error (error, next)) => some (.error (error, (next, events)))

/-- A higher-order callee sees the original private world, not instrumentation.
Nested callback events are excluded from the surrounding call-boundary trace. -/
def tailDropLog {W E A : Type} (action : JuliaLean.base.io.M (W × List E) A) :
    JuliaLean.base.io.M W A := fun world =>
  match action (world, []) with
  | none => none
  | some (.ok (result, (next, _))) => some (.ok (result, next))
  | some (.error (error, (next, _))) => some (.error (error, next))

structure TailEvent (W Call : Type) where
  before : W
  call : Call
  after : W

def TailWorldConservation {W Call : Type} (initial final : W)
    (events : List (TailEvent W Call)) : Prop :=
  events.head?.map (·.before) = some initial ∧
  events.getLast?.map (·.after) = some final ∧
  ∀ i first second, events[i]? = some first → events[i+1]? = some second →
    first.after = second.before

def tailObserve {W Call A : Type} (call : Except JuliaLean.base.io.Error A → Call)
    (action : JuliaLean.base.io.M W A) : JuliaLean.base.io.M (W × List (TailEvent W Call)) A :=
  recordStateCall (fun before result after => ⟨before, call result, after⟩) action

inductive BinomialNumberCall (V Iter Other : Type) where
  | test (k : V) (literal : JInt64) (result : Except JuliaLean.base.io.Error (Bool ⊕ Other))
  | zero (x : V) (result : Except JuliaLean.base.io.Error V)
  | one (k : V) (result : Except JuliaLean.base.io.Error V)
  | unit (x : V) (result : Except JuliaLean.base.io.Error V)
  | iterator (k : V) (result : Except JuliaLean.base.io.Error Iter)
  | offset (i : V) (literal : JInt64) (result : Except JuliaLean.base.io.Error V)
  | subtract (x offset : V) (result : Except JuliaLean.base.io.Error V)
  | divide (numerator denominator : V) (result : Except JuliaLean.base.io.Error V)
  | product (iterator : Iter) (initial : V) (result : Except JuliaLean.base.io.Error V)

def observeBinomialNumberOps {W V Iter Other : Type}
    (ops : BinomialNumberOps W V Iter Other) :
    BinomialNumberOps (W × List (TailEvent W (BinomialNumberCall V Iter Other))) V Iter Other where
  negative := fun k n => tailObserve (.test k n) (ops.negative k n)
  zero := fun x => tailObserve (.zero x) (ops.zero x)
  one := fun k => tailObserve (.one k) (ops.one k)
  oneunit := fun x => tailObserve (.unit x) (ops.oneunit x)
  oneTo := fun k => tailObserve (.iterator k) (ops.oneTo k)
  subtractLiteral := fun i n => tailObserve (.offset i n) (ops.subtractLiteral i n)
  subtract := fun x offset => tailObserve (.subtract x offset) (ops.subtract x offset)
  divide := fun n d => tailObserve (.divide n d) (ops.divide n d)
  product := fun callback iterator initial => tailObserve (.product iterator initial)
    (ops.product (fun i => tailDropLog (callback i)) iterator initial)

def binomialNumberError {V Iter Other : Type} : BinomialNumberCall V Iter Other → Option JuliaLean.base.io.Error
  | .test _ _ (.error e) => some e
  | .zero _ (.error e) => some e
  | .one _ (.error e) => some e
  | .unit _ (.error e) => some e
  | .iterator _ (.error e) => some e
  | .offset _ _ (.error e) => some e
  | .subtract _ _ (.error e) => some e
  | .divide _ _ (.error e) => some e
  | .product _ _ (.error e) => some e
  | _ => none

def binomialNumberReturn {V Iter Other : Type} : BinomialNumberCall V Iter Other → Option V
  | .divide _ _ (.ok value) => some value
  | .product _ _ (.ok value) => some value
  | _ => none

def BinomialNumberTerminal {V Iter Other : Type} (calls : List (BinomialNumberCall V Iter Other)) :
    Except JuliaLean.base.io.Error V → Prop
  | .ok value => calls.getLast?.bind binomialNumberReturn = some value ∧
      calls.filterMap binomialNumberError = []
  | .error error =>
      (calls.filterMap binomialNumberError = [error] ∧
       calls.getLast?.bind binomialNumberError = some error) ∨
      (∃ k other, calls = [.test k (JuliaLean.base.int.lit .i64 0) (.ok (.inr other))] ∧
        error = .foreignError "TypeError" "")

def BinomialNumberOuterInvariant {V Iter Other : Type}
    (x k : V) (calls : List (BinomialNumberCall V Iter Other)) : Prop :=
  calls.length ≤ 6 ∧
  (calls.filterMap fun c => match c with | .test input literal _ => some (input,literal) | _ => none) =
    [(k, JuliaLean.base.int.lit .i64 0)] ∧
  (∀ value result, BinomialNumberCall.zero value result ∈ calls → value = x) ∧
  (∀ value result, BinomialNumberCall.unit value result ∈ calls → value = x) ∧
  (∀ value result, BinomialNumberCall.one value result ∈ calls → value = k) ∧
  (∀ value result, BinomialNumberCall.iterator value result ∈ calls → value = k) ∧
  (∀ iterator initial result, BinomialNumberCall.product iterator initial result ∈ calls →
    (calls.filterMap fun c => match c with | .iterator _ (.ok value) => some value | _ => none) = [iterator] ∧
    (calls.filterMap fun c => match c with | .divide _ _ (.ok value) => some value | _ => none) = [initial]) ∧
  (∀ i literal result, BinomialNumberCall.offset i literal result ∉ calls) ∧
  (∀ a b result, BinomialNumberCall.subtract a b result ∉ calls) ∧
  (∀ (i j : Nat) (iterator : Except JuliaLean.base.io.Error Iter)
      (unitResult : Except JuliaLean.base.io.Error V),
    calls[i]? = some (.iterator k iterator) → calls[j]? = some (.unit x unitResult) → i < j)

def BinomialTermInvariant {V Iter Other : Type}
    (x i : V) (calls : List (BinomialNumberCall V Iter Other)) : Prop :=
  calls.length ≤ 3 ∧
  (calls.filterMap fun c => match c with | .offset input literal _ => some (input,literal) | _ => none) =
    [(i, JuliaLean.base.int.lit .i64 1)] ∧
  (∀ a b result, BinomialNumberCall.subtract a b result ∈ calls → a = x ∧
    (calls.filterMap fun c => match c with | .offset _ _ (.ok value) => some value | _ => none) = [b]) ∧
  (∀ a b result, BinomialNumberCall.divide a b result ∈ calls → b = i ∧
    (calls.filterMap fun c => match c with | .subtract _ _ (.ok value) => some value | _ => none) = [a])

def BinomialNumberEffects : Prop :=
  ∀ (W V Iter Other : Type) (ops : BinomialNumberOps W V Iter Other) (x k : V) (world : W),
    (match binomialNumberGeneric (observeBinomialNumberOps ops) x k (world, []) with
    | none => True
    | some (.ok (value,(final,events))) =>
        TailWorldConservation world final events ∧
        BinomialNumberOuterInvariant x k (events.map (·.call)) ∧
        BinomialNumberTerminal (events.map (·.call)) (.ok value)
    | some (.error (error,(final,events))) =>
        TailWorldConservation world final events ∧
        BinomialNumberOuterInvariant x k (events.map (·.call)) ∧
        BinomialNumberTerminal (events.map (·.call)) (.error error)) ∧
    (∀ i, match binomialNumberTerm (observeBinomialNumberOps ops) x i (world, []) with
    | none => True
    | some (.ok (value,(final,events))) =>
        TailWorldConservation world final events ∧ BinomialTermInvariant x i (events.map (·.call)) ∧
        BinomialNumberTerminal (events.map (·.call)) (.ok value)
    | some (.error (error,(final,events))) =>
        TailWorldConservation world final events ∧ BinomialTermInvariant x i (events.map (·.call)) ∧
        BinomialNumberTerminal (events.map (·.call)) (.error error))


def tailLiftClampOps {W E V Ty Other : Type} (ops : ClampOps W V Ty Other) :
    ClampOps (W × List E) V Ty Other where
  typeOf := ops.typeOf
  promoteType := fun a b c => tailPreserveLog (ops.promoteType a b c)
  greater := fun a b => tailPreserveLog (ops.greater a b)
  less := fun a b => tailPreserveLog (ops.less a b)
  convert := fun a b => tailPreserveLog (ops.convert a b)

def tailLiftClampDispatch {W E V Ty Other : Type} (ops : ClampDispatchOps W V Ty Other) :
    ClampDispatchOps (W × List E) V Ty Other where
  generic := tailLiftClampOps ops.generic
  select := fun x lo hi => match ops.select x lo hi with
    | .generic => .generic
    | .custom method => .custom (fun a b c => tailPreserveLog (method a b c))

inductive ClampBangCall (A Iter Index State V SetResult : Type) where
  | indices (array : A) (result : Except JuliaLean.base.io.Error Iter)
  | step (iterator : Iter) (state : Option State)
      (result : Except JuliaLean.base.io.Error (Option (Index × State)))
  | read (inbounds : Bool) (array : A) (index : Index) (result : Except JuliaLean.base.io.Error V)
  | write (inbounds : Bool) (array : A) (value : V) (index : Index)
      (result : Except JuliaLean.base.io.Error SetResult)

def observeClampBangOps {W A Iter Index State V Ty Other SetResult : Type}
    (ops : ClampBangOps W A Iter Index State V Ty Other SetResult) :
    ClampBangOps (W × List (ClampBangCall A Iter Index State V SetResult))
      A Iter Index State V Ty Other SetResult where
  eachindex := fun x => recordCall (.indices x) (ops.eachindex x)
  iteration := {
    first := fun iterator => recordCall (.step iterator none) (ops.iteration.first iterator)
    next := fun iterator state => recordCall (.step iterator (some state)) (ops.iteration.next iterator state) }
  getindex := fun flag x i => recordCall (.read flag x i) (ops.getindex flag x i)
  setindex := fun flag x value i => recordCall (.write flag x value i) (ops.setindex flag x value i)
  clamp := tailLiftClampDispatch ops.clamp

def clampBangYields {A Iter Index State V SetResult : Type}
    (calls : List (ClampBangCall A Iter Index State V SetResult)) : List (Index × State) :=
  calls.filterMap fun call => match call with
    | .step _ _ (.ok (some pair)) => some pair
    | _ => none

def clampBangReadIndices {A Iter Index State V SetResult : Type}
    (calls : List (ClampBangCall A Iter Index State V SetResult)) : List Index :=
  calls.filterMap fun call => match call with | .read _ _ i _ => some i | _ => none

def clampBangWriteIndices {A Iter Index State V SetResult : Type}
    (calls : List (ClampBangCall A Iter Index State V SetResult)) : List Index :=
  calls.filterMap fun call => match call with | .write _ _ _ i _ => some i | _ => none

def clampBangStepStates {A Iter Index State V SetResult : Type}
    (calls : List (ClampBangCall A Iter Index State V SetResult)) : List (Option State) :=
  calls.filterMap fun call => match call with | .step _ state _ => some state | _ => none

def clampBangCallError {A Iter Index State V SetResult : Type} :
    ClampBangCall A Iter Index State V SetResult → Option JuliaLean.base.io.Error
  | .indices _ (.error error) => some error
  | .step _ _ (.error error) => some error
  | .read _ _ _ (.error error) => some error
  | .write _ _ _ _ (.error error) => some error
  | _ => none

def TailPrefix {A : Type} (beginning full : List A) : Prop := ∃ rest, full = beginning ++ rest

def ClampBangIdentityInvariant {A Iter Index State V SetResult : Type}
    (x : A) (calls : List (ClampBangCall A Iter Index State V SetResult)) : Prop :=
  (calls.filterMap fun c => match c with | .indices input _ => some input | _ => none) = [x] ∧
  (∀ flag array index result, ClampBangCall.read flag array index result ∈ calls →
    flag = true ∧ array = x) ∧
  (∀ flag array value index result, ClampBangCall.write flag array value index result ∈ calls →
    flag = true ∧ array = x) ∧
  (∀ iterator state result, ClampBangCall.step iterator state result ∈ calls →
    (calls.filterMap fun c => match c with | .indices _ (.ok value) => some value | _ => none) = [iterator])

/-- Full custom-array input domain: original reference identity, live iteration
state provenance, exact yielded/read/written index accounting, inbounds context,
and failure-prefix preservation. No indexing, mutation or order laws are assumed. -/
def ClampBangOpenMutationAccounting : Prop :=
  ∀ (W A Iter Index State V Ty Other SetResult : Type)
      (ops : ClampBangOps W A Iter Index State V Ty Other SetResult)
      (x : A) (lo hi : V) (world : W),
    match clampBangGeneric (observeClampBangOps ops) x lo hi (world, []) with
    | none => True
    | some (.ok (result, (_, calls))) =>
        result = x ∧ ClampBangIdentityInvariant x calls ∧
        clampBangReadIndices calls = (clampBangYields calls).map Prod.fst ∧
        clampBangWriteIndices calls = clampBangReadIndices calls ∧
        clampBangStepStates calls = none :: (clampBangYields calls).map (some ∘ Prod.snd) ∧
        calls.filterMap clampBangCallError = []
    | some (.error (error, (_, calls))) =>
        ClampBangIdentityInvariant x calls ∧
        TailPrefix (clampBangWriteIndices calls) (clampBangReadIndices calls) ∧
        TailPrefix (clampBangReadIndices calls) ((clampBangYields calls).map Prod.fst) ∧
        TailPrefix (clampBangStepStates calls)
          (none :: (clampBangYields calls).map (some ∘ Prod.snd)) ∧
        (clampBangYields calls).length ≤ (clampBangWriteIndices calls).length + 1 ∧
        (calls.filterMap clampBangCallError = [] ∨
         (calls.filterMap clampBangCallError = [error] ∧
          calls.getLast?.bind clampBangCallError = some error))

inductive ClampRangeCall (V Range Ty Other : Type) where
  | first (range : Range) (result : Except JuliaLean.base.io.Error V)
  | last (range : Range) (result : Except JuliaLean.base.io.Error V)
  | greater (x hi : V) (result : Except JuliaLean.base.io.Error (Bool ⊕ Other))
  | less (x lo : V) (result : Except JuliaLean.base.io.Error (Bool ⊕ Other))
  | convert (type : Ty) (value : V) (result : Except JuliaLean.base.io.Error V)
  | custom (x lo hi : V) (result : Except JuliaLean.base.io.Error V)

def observeClampRangeOps {W V Range Ty Other : Type} (ops : ClampRangeOps W V Range Ty Other) :
    ClampRangeOps (W × List (ClampRangeCall V Range Ty Other)) V Range Ty Other where
  first := fun r => recordCall (.first r) (ops.first r)
  last := fun r => recordCall (.last r) (ops.last r)
  clamp := {
    generic := {
      typeOf := ops.clamp.generic.typeOf
      promoteType := fun a b c => tailPreserveLog (ops.clamp.generic.promoteType a b c)
      greater := fun a b => recordCall (.greater a b) (ops.clamp.generic.greater a b)
      less := fun a b => recordCall (.less a b) (ops.clamp.generic.less a b)
      convert := fun t a => recordCall (.convert t a) (ops.clamp.generic.convert t a) }
    select := fun x lo hi => match ops.clamp.select x lo hi with
      | .generic => .generic
      | .custom method => .custom (fun a b c => recordCall (.custom a b c) (method a b c)) }

def clampRangeFirsts {V Range Ty Other : Type} (calls : List (ClampRangeCall V Range Ty Other)) : List V :=
  calls.filterMap fun c => match c with | .first _ (.ok value) => some value | _ => none

def clampRangeLasts {V Range Ty Other : Type} (calls : List (ClampRangeCall V Range Ty Other)) : List V :=
  calls.filterMap fun c => match c with | .last _ (.ok value) => some value | _ => none

def clampRangeReturn {V Range Ty Other : Type} : ClampRangeCall V Range Ty Other → Option V
  | .convert _ _ (.ok value) => some value
  | .custom _ _ _ (.ok value) => some value
  | _ => none

def clampRangeError {V Range Ty Other : Type} : ClampRangeCall V Range Ty Other → Option JuliaLean.base.io.Error
  | .first _ (.error e) => some e
  | .last _ (.error e) => some e
  | .greater _ _ (.error e) => some e
  | .less _ _ (.error e) => some e
  | .convert _ _ (.error e) => some e
  | .custom _ _ _ (.error e) => some e
  | _ => none

def ClampRangeOriginInvariant {V Range Ty Other : Type}
    (x : V) (range : Range) (calls : List (ClampRangeCall V Range Ty Other)) : Prop :=
  (calls.filterMap fun c => match c with | .first r _ => some r | _ => none) = [range] ∧
  TailPrefix (calls.filterMap fun c => match c with | .last r _ => some r | _ => none) [range] ∧
  (∀ a b result, ClampRangeCall.greater a b result ∈ calls → a = x ∧ clampRangeLasts calls = [b]) ∧
  (∀ a b result, ClampRangeCall.less a b result ∈ calls → a = x ∧ clampRangeFirsts calls = [b]) ∧
  (∀ a lo hi result, ClampRangeCall.custom a lo hi result ∈ calls →
    a = x ∧ clampRangeFirsts calls = [lo] ∧ clampRangeLasts calls = [hi]) ∧
  (∀ t value result, ClampRangeCall.convert t value result ∈ calls →
    value = x ∨ value ∈ clampRangeFirsts calls ∨ value ∈ clampRangeLasts calls)

/-- Arbitrary effectful range endpoints retain reference and operand provenance;
normal output comes from the actual selected clamp conversion/specialization.
A tracked failure remains the terminal failure, with no callback laws. -/
def ClampRangeOpenProvenance : Prop :=
  ∀ (W V Range Ty Other : Type) (ops : ClampRangeOps W V Range Ty Other)
      (x : V) (range : Range) (world : W),
    match clampRange (observeClampRangeOps ops) x range (world, []) with
    | none => True
    | some (.ok (value, (_, calls))) =>
        ClampRangeOriginInvariant x range calls ∧
        calls.getLast?.bind clampRangeReturn = some value ∧
        calls.filterMap clampRangeError = []
    | some (.error (error, (_, calls))) =>
        ClampRangeOriginInvariant x range calls ∧
        (calls.filterMap clampRangeError = [] ∨
         (calls.filterMap clampRangeError = [error] ∧ calls.getLast?.bind clampRangeError = some error))


inductive IsqrtCall (I F T R : Type) where
  | root (input : I) (result : Except JuliaLean.base.io.Error F)
  | truncate (input : F) (result : Except JuliaLean.base.io.Error T)
  | convert (original : I) (input : T) (result : Except JuliaLean.base.io.Error R)

def observeIsqrtOps {W I F T R : Type} (ops : IsqrtOps (JuliaLean.base.io.M W) I F T R) :
    IsqrtOps (JuliaLean.base.io.M (W × List (TailEvent W (IsqrtCall I F T R)))) I F T R where
  sqrt := fun x => tailObserve (.root x) (ops.sqrt x)
  trunc := fun x => tailObserve (.truncate x) (ops.trunc x)
  oftype := fun original x => tailObserve (.convert original x) (ops.oftype original x)

def isqrtCallError {I F T R : Type} : IsqrtCall I F T R → Option JuliaLean.base.io.Error
  | .root _ (.error e) => some e
  | .truncate _ (.error e) => some e
  | .convert _ _ (.error e) => some e
  | _ => none

def isqrtCallReturn {I F T R : Type} : IsqrtCall I F T R → Option R
  | .convert _ _ (.ok value) => some value
  | _ => none

def IsqrtCallInvariant {I F T R : Type} (original : I) (calls : List (IsqrtCall I F T R)) : Prop :=
  calls.length ≤ 3 ∧
  (calls.filterMap fun c => match c with | .root x _ => some x | _ => none) = [original] ∧
  (∀ value result, IsqrtCall.truncate value result ∈ calls →
    (calls.filterMap fun c => match c with | .root _ (.ok x) => some x | _ => none) = [value]) ∧
  (∀ x value result, IsqrtCall.convert x value result ∈ calls → x = original ∧
    (calls.filterMap fun c => match c with | .truncate _ (.ok x) => some x | _ => none) = [value])

/-- Arbitrary custom sqrt/trunc/oftype dispatch conserves the original reference,
intermediate identity, entire world provenance and terminal failure/result origin.
No numerical, conversion, or termination law is assumed. -/
def IsqrtOpenProvenance : Prop :=
  ∀ (W I F T R : Type) (ops : IsqrtOps (JuliaLean.base.io.M W) I F T R)
      (x : I) (world : W),
    match isqrtInteger (observeIsqrtOps ops) x (world, []) with
    | none => True
    | some (.ok (value, (final, events))) =>
        TailWorldConservation world final events ∧ IsqrtCallInvariant x (events.map (·.call)) ∧
        (events.map (·.call)).getLast?.bind isqrtCallReturn = some value ∧
        (events.map (·.call)).filterMap isqrtCallError = []
    | some (.error (error, (final, events))) =>
        TailWorldConservation world final events ∧ IsqrtCallInvariant x (events.map (·.call)) ∧
        (events.map (·.call)).filterMap isqrtCallError = [error] ∧
        (events.map (·.call)).getLast?.bind isqrtCallError = some error


@[simp] private theorem io_pure {W A : Type} (v : A) (w : W) :
    (pure v : JuliaLean.base.io.M W A) w = some (.ok (v, w)) := rfl

@[simp] private theorem io_bind {W A B : Type} (m : JuliaLean.base.io.M W A)
    (f : A → JuliaLean.base.io.M W B) (w : W) :
    (m >>= f) w = match m w with
      | none => none
      | some (.error e) => some (.error e)
      | some (.ok (v, w')) => f v w' := by
  change (m w).bind (fun r => match r with | .error error => some (.error error) | .ok (value, world) => f value world) = _
  cases m w with
  | none => rfl
  | some r => cases r <;> rfl

@[simp] private theorem io_throw {W A : Type} (e : JuliaLean.base.io.Error) (w : W) :
    (throw e : JuliaLean.base.io.M W A) w = some (.error (e, w)) := rfl

@[simp] private theorem io_liftJl {W A : Type} (x : Jl A) (w : W) :
    (JuliaLean.base.io.liftJl x : JuliaLean.base.io.M W A) w =
      match x with
      | .ok r => some (.ok (r, w))
      | .error e => some (.error (.jl e, w)) := by
  cases x <;> rfl

@[simp] private theorem liftJl_bind {W A B : Type} (x : Jl A) (f : A → Jl B) :
    (JuliaLean.base.io.liftJl x >>= fun a => JuliaLean.base.io.liftJl (f a) : JuliaLean.base.io.M W B) =
      JuliaLean.base.io.liftJl (x >>= f) := by
  funext w; cases x <;> rfl

private theorem adj_1 {α : Type} (P : α → α → Prop) (a : α) :
    ∀ i x y, ([a])[i]? = some x → ([a])[i+1]? = some y → P x y := by
  intro i x y h1 h2; cases i <;> simp at h1 h2

private theorem adj_2 {α : Type} (P : α → α → Prop) (a b : α) (hab : P a b) :
    ∀ i x y, ([a, b])[i]? = some x → ([a, b])[i+1]? = some y → P x y := by
  intro i x y h1 h2
  cases i with
  | zero => simp at h1 h2; subst h1; subst h2; exact hab
  | succ i => cases i <;> simp at h1 h2

private theorem adj_3 {α : Type} (P : α → α → Prop) (a b c : α) (hab : P a b) (hbc : P b c) :
    ∀ i x y, ([a, b, c])[i]? = some x → ([a, b, c])[i+1]? = some y → P x y := by
  intro i x y h1 h2
  cases i with
  | zero => simp at h1 h2; subst h1; subst h2; exact hab
  | succ i =>
    cases i with
    | zero => simp at h1 h2; subst h1; subst h2; exact hbc
    | succ i => cases i <;> simp at h1 h2

