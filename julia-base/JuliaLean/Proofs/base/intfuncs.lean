    · rw [dif_neg hlt]
      have hc : JuliaLean.C.jlTruncInt 8 x = .ok (BitVec.ofNat 8 x.toNat) := by
        simp only [JuliaLean.C.jlTruncInt, show ¬ 8 ≥ bits by omega, ite_false,
          Bind.bind, Except.bind, Pure.pure, Except.pure, BitVec.ofInt_natCast] <;> rfl
      rw [JuliaLean.Proofs.base.int.okOf_eq hc, BitVec.toNat_ofNat]

theorem primitiveShift_value {bits : Nat} (x : BitVec bits) (k : Nat)
    (hk : k < 2 ^ 64) :
    (JuliaLean.C.jlLshrInt x (BitVec.ofNat 64 k)).toNat = x.toNat / 2 ^ k := by
  unfold JuliaLean.C.jlLshrInt
  rw [BitVec.toNat_ofNat, Nat.mod_eq_of_lt hk]
  split
  · rename_i h
    simp only [BitVec.toNat_ofNat, Nat.zero_mod]
    exact (Nat.div_eq_of_lt (Nat.lt_of_lt_of_le x.isLt
      (Nat.pow_le_pow_right (by decide) h))).symm
  · rw [BitVec.toNat_ofNat]
    exact Nat.mod_eq_of_lt (Nat.lt_of_le_of_lt (Nat.div_le_self _ _) x.isLt)

theorem binLoop1_enough {U : Type} (lowByte : U → Nat) (shr : U → Nat → U)
    (neg : Bool) :
    ∀ (k fuel : Nat) (b : Buffer) (x : U), k ≤ fuel →
      binLoop1 lowByte shr neg fuel b x (boolInt neg + k) =
        binLoop1 lowByte shr neg k b x (boolInt neg + k) := by
  intro k
  induction k with
  | zero =>
    intro fuel b x _
    cases fuel <;> simp only [binLoop1, Int.natCast_zero, Int.add_zero,
      Int.le_refl, ite_true]
  | succ k ih =>
    intro fuel b x hf
    cases fuel with
    | zero => omega
    | succ fuel =>
      have hi : boolInt neg + (k + 1 : Nat) - 1 = boolInt neg + k := by omega
      simp only [binLoop1, show ¬ boolInt neg + (k + 1 : Nat) ≤ boolInt neg by omega,
        ite_false, hi]
      exact ih fuel _ _ (by omega)

/-- The arbitrary-width primitive clause is valid whenever its modeled allocation length fits. -/
theorem primitiveBitstring_bounded (bits : Nat) (x : BitVec bits)
    (hbits : (bits : Int) ≤ IntTy.max .u64) :
    ∃ s, primitiveBitstring x = .ok s ∧ s.bytes.length = bits ∧
      ∀ j : Nat, j < bits → s.bytes[j]? =
        some (if x.toNat.testBit (bits - 1 - j) then 49 else 48) := by
  let shift : BitVec bits → Nat → BitVec bits := fun x k =>
    JuliaLean.C.jlLshrInt x (BitVec.ofNat 64 k)
  have hlow : ∀ y : BitVec bits, primitiveByte y % 256 = y.toNat % 256 := by
    intro y
    rw [primitiveByte_value, Nat.mod_mod]
  have hlow2 : ∀ y : BitVec bits, primitiveByte y % 2 = y.toNat % 2 := by
    intro y
    rw [primitiveByte_value]
    exact Nat.mod_mod_of_dvd y.toNat (by decide : 2 ∣ 256)
  have hshift : ∀ y : BitVec bits, (shift y 4).toNat = y.toNat / 2 ^ 4 := by
    intro y
    exact primitiveShift_value y 4 (by decide)
  have hshift1 : ∀ y : BitVec bits, (shift y 1).toNat = y.toNat / 2 := by
    intro y
    exact primitiveShift_value y 1 (by decide)
  let initial : Buffer := ⟨List.replicate bits 0, [], []⟩
  let m := bits / 4
  let r := bits % 4
  have hr : r < 4 := Nat.mod_lt bits (by decide)
  have hsize : 4 * m + r = bits := by dsimp only [m, r]; omega
  have hlen : initial.bytes.length = bits := List.length_replicate
  have hnew : newBuffer (bits : Int) = .ok initial := by
    unfold newBuffer JInt.convert
    rw [dite_eq_left (show IntTy.min .u64 ≤ (bits : Int) ∧ (bits : Int) ≤ IntTy.max .u64 from
      ⟨Int.natCast_nonneg bits, hbits⟩)]
    rfl
  obtain ⟨out, y, hcall, _, _, _⟩ := binaryLoop4_spec
    (fun y : BitVec bits => y.toNat) primitiveByte shift hlow hshift m r hr initial x
    (by rw [hsize, hlen]; exact Nat.le_refl _)
  rw [hsize] at hcall
  let result := binLoop1 primitiveByte shift false (r + 1) out y r
  have hsmall := binLoop1_enough primitiveByte shift false r (r + 1) out y (by omega)
  have hlarge := binLoop1_enough primitiveByte shift false r (bits + 1) out y (by omega)
  simp only [boolInt, Bool.false_eq_true, ite_false, Int.zero_add] at hsmall hlarge
  have hfuels : binLoop1 primitiveByte shift false (r + 1) out y r =
      binLoop1 primitiveByte shift false (bits + 1) out y r := hsmall.trans hlarge.symm
  have hfill := binary_fill (fun y : BitVec bits => y.toNat) primitiveByte shift
    hlow hlow2 hshift hshift1 x bits false
    (by simp only [boolInt, Bool.false_eq_true, ite_false, Int.toNat_zero]; exact Nat.zero_le _)
  change (let (b, y, i) := binLoop4 primitiveByte shift (m + 1) initial x bits
    (minusSign false (binLoop1 primitiveByte shift false (bits + 1) b y i)).bytes) = _ at hfill
  rw [hcall] at hfill
  simp only [minusSign, Bool.false_eq_true, ite_false, List.nil_append,
    boolInt, Int.toNat_zero, Nat.sub_zero] at hfill
  have hbytes : result.bytes = writtenDigits 2 false bits (x.toNat : Int) := by
    dsimp only [result]
    rw [hfuels]
    exact hfill
  refine ⟨result, ?_, ?_, ?_⟩
  · unfold primitiveBitstring bitstring
    simp only [Bool.not_true, Bool.false_eq_true, ite_false, ite_self, hnew,
      Bind.bind, Except.bind, Pure.pure, Except.pure]
    change (let result := binLoop4 primitiveByte shift (m + 1) initial x bits
      Except.ok (binLoop1 primitiveByte shift false (result.2.2.toNat + 1)
        result.1 result.2.1 result.2.2)) = _
    rw [hcall]
    rfl
  · rw [hbytes, writtenDigits_length]
  · intro j hj
    rw [hbytes, writtenDigits_binary_get bits x.toNat j hj]
    rfl

end PrimitiveBitstringWork
end JuliaLean.ChatGPT.Batch4.Group12

