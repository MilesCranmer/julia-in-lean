private def IsPow2LoopInv {W V Count Other : Type} (x : V) :
    V → (W × List (IsPow2Event V Count Other)) → Prop
  | v, (_, trace) =>
      x :: ispow2RealOutputs trace = ispow2Tests trace ++ [v] ∧
      ispow2RealInputs trace = ispow2Tests trace ∧
      ispow2GreaterInputs trace = [] ∧
      ispow2CustomInputs trace = [] ∧
      ispow2OnesInputs trace = [] ∧
      ispow2OnesOutputs trace = [] ∧
      ispow2EqualInputs trace = [] ∧
      trace.filterMap ispow2EventError = [] ∧
      (∀ val zero res, IsPow2Event.greater val zero res ∈ trace → False) ∧
      (∀ val one res, IsPow2Event.equal val one res ∈ trace → False)

