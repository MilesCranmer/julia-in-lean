private theorem chooseZero (n : Nat) : chooseMath n 0 = 1 := KummerWork.choose_zero n

private theorem chooseAbove (n k : Nat) (h : n < k) : chooseMath n k = 0 :=
  KummerWork.choose_above n k h

private theorem chooseSelf (n : Nat) : chooseMath n n = 1 := by
  induction n with
  | zero => rfl
  | succ n ih =>
    rw [chooseMath, ih, chooseAbove n (n+1) (by omega), Nat.add_zero]

private theorem chooseOne (n : Nat) : chooseMath n 1 = n := KummerWork.choose_one n

private theorem choosePositive (n k : Nat) (hk : k ≤ n) : 0 < chooseMath n k := by
  induction n generalizing k with
  | zero =>
    have : k = 0 := by omega
    subst k
    decide
  | succ n ih =>
    cases k with
    | zero => exact Nat.zero_lt_one
    | succ k =>
      rw [chooseMath]
      have h := ih k (by omega)
      omega

/-- Pascal's recursion gives the exact multiplicative step used by Julia. -/
theorem chooseMulStep (n k : Nat) :
    (k+1) * chooseMath (n+1) (k+1) = (n+1) * chooseMath n k :=
  KummerWork.choose_mul_step n k

private theorem chooseSymmetry (n k : Nat) (hk : k ≤ n) :
    chooseMath n k = chooseMath n (n-k) := by
  induction n generalizing k with
  | zero =>
    have : k = 0 := by omega
    subst k
    rfl
  | succ n ih =>
    by_cases hzero : k = 0
    · subst k
      rw [Nat.sub_zero, chooseSelf]
      rfl
    · by_cases htop : k = n+1
      · subst k
        rw [Nat.sub_self, chooseSelf]
        rfl
      · have hkn : k ≤ n := by omega
        have hpos : 0 < k := by omega
        have hrestpos : 0 < n + 1 - k := by omega
        obtain ⟨j, hj⟩ := Nat.exists_eq_succ_of_ne_zero (by omega : k ≠ 0)
        subst k
        obtain ⟨l, hl⟩ := Nat.exists_eq_succ_of_ne_zero (by omega : n+1-(j+1) ≠ 0)
        rw [hl, chooseMath, chooseMath, ih j (by omega), ih (j+1) (by omega)]
        have hjl : n - j = l+1 := by omega
        have hjl' : n - (j+1) = l := by omega
        rw [hjl, hjl']
        omega

/-- The rising-numerator sequence is monotone, including every partial loop result. -/
theorem chooseRisingMonotone (a r : Nat) :
    chooseMath (a+r) r ≤ chooseMath (a+(r+1)) (r+1) := by
  rw [show a + (r+1) = (a+r)+1 by omega, chooseMath]
  omega

private theorem chooseRisingMonotoneMany (a r s : Nat) (h : r ≤ s) :
    chooseMath (a+r) r ≤ chooseMath (a+s) s := by
  induction s with
  | zero =>
    have : r = 0 := by omega
    subst r
    exact Nat.le_refl _
  | succ s ih =>
    by_cases hs : r ≤ s
    · exact Nat.le_trans (ih hs) (chooseRisingMonotone a s)
    · have : r = s+1 := by omega
      subst r
      exact Nat.le_refl _

private theorem binomialMinNonpositive (t : IntTy) : t.min ≤ 0 := by
  cases t <;> decide

private theorem binomialLitNat (t : IntTy) (n : Nat) (hn : (n : Int) ≤ t.max) :
    (JuliaLean.base.int.lit t n).val = n :=
  JuliaLean.Proofs.base.int.lit_of_fits ⟨by have := binomialMinNonpositive t; omega, hn⟩

private theorem binomialAddLit (t : IntTy) (a b : Int) :
    JuliaLean.base.int.add (JuliaLean.base.int.lit t a) (JuliaLean.base.int.lit t b) =
      JuliaLean.base.int.lit t (a+b) := by
  apply Subtype.ext
  change (JuliaLean.base.int.add_int _ _).val = _
  rw [JuliaLean.Proofs.base.int.add_int_val]
  change wrapInt t (wrapInt t a + wrapInt t b) = wrapInt t (a+b)
  rw [JuliaLean.Proofs.base.int.wrapInt_add_left,
    JuliaLean.Proofs.base.int.wrapInt_add_right]

private abbrev binomialWideDiv {t : IntTy} (x nn rr : JInt t) : Jl Int :=
  if rr.val = 0 then .error .divideError else .ok ((x.val * nn.val).tdiv rr.val)

/-- Every remaining multiplicative step is exact until its first out-of-range result. -/
theorem binomialLoop_rising (t : IntTy) (a r f : Nat) (hr : 1 ≤ r)
    (htop : ((a+r+f : Nat) : Int) ≤ t.max) (x : JInt t)
    (hx : x.val = (chooseMath (a+r) r : Int)) :
    binomialLoop (bitsOps t) binomialWideDiv f x
      (JuliaLean.base.int.lit t ((a+r+1 : Nat) : Int)) (JuliaLean.base.int.lit t ((r+1 : Nat) : Int))
      (JuliaLean.base.int.lit t ((r+f : Nat) : Int)) =
    if fits t (chooseMath (a+r+f) (r+f) : Int)
      then .ok (JuliaLean.base.int.lit t (chooseMath (a+r+f) (r+f) : Int))
      else .error (.overflowError "") := by
  induction f generalizing r x with
  | zero =>
    have hfit : fits t (chooseMath (a+r) r : Int) := by
      rw [← hx]
      exact x.property
    have hlit : JuliaLean.base.int.lit t (chooseMath (a+r) r : Int) = x := by
      apply Subtype.ext
      rw [JuliaLean.Proofs.base.int.lit_of_fits hfit, hx]
    simpa only [Nat.add_zero, hfit, ite_true, hlit, binomialLoop, Pure.pure, Except.pure]
  | succ f ih =>
    have hnn : (JuliaLean.base.int.lit t ((a+r+1 : Nat) : Int)).val = (a+r+1 : Nat) :=
      binomialLitNat t _ (by omega)
    have hrr : (JuliaLean.base.int.lit t ((r+1 : Nat) : Int)).val = (r+1 : Nat) :=
      binomialLitNat t _ (by omega)
    have hk : (JuliaLean.base.int.lit t ((r+(f+1) : Nat) : Int)).val = (r+(f+1) : Nat) :=
      binomialLitNat t _ (by omega)
    have htest : ¬ (JuliaLean.base.int.lit t ((r+1 : Nat) : Int)).val >
        (JuliaLean.base.int.lit t ((r+(f+1) : Nat) : Int)).val := by rw [hrr, hk]; omega
    have hden : (JuliaLean.base.int.lit t ((r+1 : Nat) : Int)).val ≠ 0 := by rw [hrr]; omega
    have hstep := congrArg (fun n : Nat => (n : Int)) (chooseMulStep (a+r) r)
    simp only [Int.natCast_mul] at hstep
    have hdiv : binomialWideDiv x (JuliaLean.base.int.lit t ((a+r+1 : Nat) : Int))
        (JuliaLean.base.int.lit t ((r+1 : Nat) : Int)) =
        .ok (chooseMath (a+(r+1)) (r+1) : Int) := by
      dsimp only [binomialWideDiv]
      rw [ite_eq_right hden, hx, hnn, hrr]
      congr 1
      apply Int.tdiv_eq_of_eq_mul_left (by omega)
      rw [show a+(r+1) = a+r+1 by omega]
      simpa only [Int.mul_comm] using hstep.symm
    change (if (bitsOps t).value (JuliaLean.base.int.lit t ((r+1 : Nat) : Int)) >
        (bitsOps t).value (JuliaLean.base.int.lit t ((r+(f+1) : Nat) : Int)) then pure x else
        do let xt ← binomialWideDiv x (JuliaLean.base.int.lit t ((a+r+1 : Nat) : Int))
              (JuliaLean.base.int.lit t ((r+1 : Nat) : Int))
           let xx := (bitsOps t).ofInt xt
           if (bitsOps t).value xx ≠ xt then .error (.overflowError "") else
             binomialLoop (bitsOps t) binomialWideDiv f xx
               ((bitsOps t).add (JuliaLean.base.int.lit t ((a+r+1 : Nat) : Int)) ((bitsOps t).ofInt 1))
               ((bitsOps t).add (JuliaLean.base.int.lit t ((r+1 : Nat) : Int)) ((bitsOps t).ofInt 1))
               (JuliaLean.base.int.lit t ((r+(f+1) : Nat) : Int))) = _
    simp only [show (bitsOps t).value = Subtype.val from rfl, htest, ite_false, hdiv,
      Bind.bind, Except.bind]
    change (if (JuliaLean.base.int.lit t (chooseMath (a+(r+1)) (r+1))).val ≠
        (chooseMath (a+(r+1)) (r+1) : Int) then .error (.overflowError "") else
        binomialLoop (bitsOps t) binomialWideDiv f
          (JuliaLean.base.int.lit t (chooseMath (a+(r+1)) (r+1)))
          (JuliaLean.base.int.add (JuliaLean.base.int.lit t ((a+r+1 : Nat) : Int)) (JuliaLean.base.int.lit t 1))
          (JuliaLean.base.int.add (JuliaLean.base.int.lit t ((r+1 : Nat) : Int)) (JuliaLean.base.int.lit t 1))
          (JuliaLean.base.int.lit t ((r+(f+1) : Nat) : Int))) = _
    by_cases hfit : fits t (chooseMath (a+(r+1)) (r+1) : Int)
    · have heq := JuliaLean.Proofs.base.int.lit_of_fits hfit
      rw [heq, ite_eq_right (by simp)]
      rw [binomialAddLit, binomialAddLit]
      have hc := ih (r+1) (by omega) (by omega)
        (JuliaLean.base.int.lit t (chooseMath (a+(r+1)) (r+1))) heq
      simpa only [Int.natCast_add, Int.natCast_one, Nat.add_assoc, Int.add_assoc,
        Nat.add_comm, Nat.add_left_comm, Int.add_comm, Int.add_left_comm] using hc
    · have hneq : (JuliaLean.base.int.lit t (chooseMath (a+(r+1)) (r+1))).val ≠
          (chooseMath (a+(r+1)) (r+1) : Int) := by
        intro heq
        exact hfit (by rw [← heq]; exact (JuliaLean.base.int.lit t _).property)
      rw [ite_eq_left hneq]
      have hmono := chooseRisingMonotoneMany a (r+1) (r+(f+1)) (by omega)
      have hmonoZ := Int.ofNat_le.mpr hmono
      have hfinal : ¬ fits t (chooseMath (a+r+(f+1)) (r+(f+1)) : Int) := by
        intro h
        apply hfit
        constructor
        · have := binomialMinNonpositive t
          omega
        · have hh : a + (r + (f+1)) = a+r+(f+1) := by omega
          rw [hh] at hmonoZ
          exact Int.le_trans hmonoZ h.2
      rw [ite_eq_right hfinal]

private theorem binomialSub_eqLit {t : IntTy} (x y : JInt t) :
    JuliaLean.base.int.sub x y = JuliaLean.base.int.lit t (x.val-y.val) := by
  apply Subtype.ext
  change (JuliaLean.base.int.sub_int _ _).val = _
  rw [JuliaLean.Proofs.base.int.sub_int_val]
  rfl

private theorem binomialLit_valEq {t : IntTy} (x : JInt t) :
    JuliaLean.base.int.lit t x.val = x := by
  apply Subtype.ext
  exact JuliaLean.Proofs.base.int.lit_of_fits x.property

/-- The concrete loop computes a nonnegative row coefficient for every positive in-row index. -/
theorem binomialLoop_nonnegative {t : IntTy} (n k : JInt t)
    (hk : 1 ≤ k.val) (hkn : k.val ≤ n.val) :
    binomialLoop (bitsOps t) binomialWideDiv (k.val-1).toNat
      (JuliaLean.base.int.add (JuliaLean.base.int.sub n k) (JuliaLean.base.int.lit t 1))
      (JuliaLean.base.int.add
        (JuliaLean.base.int.add (JuliaLean.base.int.sub n k) (JuliaLean.base.int.lit t 1))
        (JuliaLean.base.int.lit t 1))
      (JuliaLean.base.int.lit t 2) k =
    if fits t (chooseMath n.val.toNat k.val.toNat : Int)
      then .ok (JuliaLean.base.int.lit t (chooseMath n.val.toNat k.val.toNat : Int))
      else .error (.overflowError "") := by
  let N := n.val.toNat
  let K := k.val.toNat
  have hN : (N : Int) = n.val := Int.toNat_of_nonneg (by omega)
  have hK : (K : Int) = k.val := Int.toNat_of_nonneg (by omega)
  have hKN : K ≤ N := by omega
  have hK1 : 1 ≤ K := by omega
  have hsum : N-K+1+(K-1) = N := by omega
  have hidx : 1+(K-1) = K := by omega
  have htop : ((N-K+1+(K-1) : Nat) : Int) ≤ t.max := by
    rw [hsum, hN]
    exact n.property.2
  have hinit : fits t ((N-K+1 : Nat) : Int) := by
    constructor
    · have := binomialMinNonpositive t
      omega
    · have := n.property.2
      omega
  have hval : (JuliaLean.base.int.lit t ((N-K+1 : Nat) : Int)).val =
      (chooseMath (N-K+1) 1 : Int) := by
    rw [JuliaLean.Proofs.base.int.lit_of_fits hinit, chooseOne]
  have hloop := binomialLoop_rising t (N-K) 1 (K-1) (by omega) htop
    (JuliaLean.base.int.lit t ((N-K+1 : Nat) : Int)) hval
  rw [hsum, hidx] at hloop
  rw [binomialSub_eqLit, binomialAddLit, binomialAddLit]
  have hfuel : (k.val-1).toNat = K-1 := by omega
  have hx : n.val-k.val+1 = ((N-K+1 : Nat) : Int) := by omega
  have hnn : n.val-k.val+1+1 = ((N-K+1+1 : Nat) : Int) := by omega
  rw [hfuel, hx]
  simpa only [Nat.add_zero, Nat.zero_add, Nat.add_assoc, Int.natCast_add,
    Int.natCast_one, Int.add_assoc, show (1 : Int)+1=2 from rfl, hK, binomialLit_valEq] using hloop

private theorem binomial_bind_ok {A : Type} (m : Jl A) :
    (do let x ← m; Except.ok x) = m := by
  cases m <;> rfl

/-- Nonnegative native inputs return the mathematical coefficient, or exactly an overflow. -/
theorem binomialBits_nonnegative {t : IntTy} (n k : JInt t)
    (hn : 0 ≤ n.val) (hk : 0 ≤ k.val) :
    binomialBits n k =
    if fits t (chooseMath n.val.toNat k.val.toNat : Int)
      then .ok (JuliaLean.base.int.lit t (chooseMath n.val.toNat k.val.toNat : Int))
      else .error (.overflowError "") := by
  have hn' : ¬ n.val < 0 := by omega
  have hk' : ¬ k.val < 0 := by omega
  have h0 : (JuliaLean.base.int.lit t 0).val = 0 := by cases t <;> decide
  have h1 : (JuliaLean.base.int.lit t 1).val = 1 := by cases t <;> decide
  have hfit0 : fits t 0 := by cases t <;> decide
  have hfit1 : fits t 1 := by cases t <;> decide
  by_cases hkn : k.val > n.val
  · have hC : chooseMath n.val.toNat k.val.toNat = 0 := chooseAbove _ _ (by omega)
    simp only [binomialBits, binomial_Integer, bitsOps, bitOps, hk', hn', hkn,
      ite_false, ite_true, Pure.pure, Except.pure, hC, Int.natCast_zero, hfit0]
  · by_cases hedge : k.val = 0 ∨ k.val = n.val
    · have hC : chooseMath n.val.toNat k.val.toNat = 1 := by
        rcases hedge with h | h
        · rw [h]; exact chooseZero _
        · rw [h]; exact chooseSelf _
      simp only [binomialBits, binomial_Integer, bitsOps, bitOps, hk', hn', hkn, hedge,
        ite_false, ite_true, Pure.pure, Except.pure, hC, Int.natCast_one, hfit1]
    · by_cases hk1 : k.val = 1
      · have hC : (chooseMath n.val.toNat k.val.toNat : Int) = n.val := by
          rw [hk1]
          change (chooseMath n.val.toNat 1 : Int) = n.val
          rw [chooseOne, Int.toNat_of_nonneg hn]
        have hnfit : fits t n.val := n.property
        have hmul : JuliaLean.base.int.mul (JuliaLean.base.int.lit t 1) n = n := by
          apply Subtype.ext
          change (JuliaLean.base.int.mul_int _ _).val = _
          rw [JuliaLean.Proofs.base.int.mul_int_val, h1, Int.one_mul,
            JuliaLean.Proofs.base.int.wrapInt_val]
        rw [hC, ite_eq_left hnfit, binomialLit_valEq]
        simp only [binomialBits, binomial_Integer, bitsOps, bitOps, hk', hn', hkn, hedge, ite_false]
        rw [ite_eq_left hk1]
        exact congrArg Except.ok hmul
      · have hcore : ∀ j : JInt t, 1 ≤ j.val → j.val ≤ n.val →
            chooseMath n.val.toNat j.val.toNat = chooseMath n.val.toNat k.val.toNat →
            (do let x ← binomialLoop (bitsOps t) binomialWideDiv (j.val-1).toNat
                    (JuliaLean.base.int.add (JuliaLean.base.int.sub n j) (JuliaLean.base.int.lit t 1))
                    (JuliaLean.base.int.add
                      (JuliaLean.base.int.add (JuliaLean.base.int.sub n j) (JuliaLean.base.int.lit t 1))
                      (JuliaLean.base.int.lit t 1))
                    (JuliaLean.base.int.lit t 2) j
                pure x) =
            if fits t (chooseMath n.val.toNat k.val.toNat : Int)
              then .ok (JuliaLean.base.int.lit t (chooseMath n.val.toNat k.val.toNat : Int))
              else .error (.overflowError "") := by
          intro j hj hjn hchoose
          rw [binomialLoop_nonnegative n j hj hjn, hchoose]
        by_cases hred : k.val >
            (JuliaLean.base.int.shr_Int n (JuliaLean.base.int.lit .i64 1)).val
        · have hsub : (JuliaLean.base.int.sub n k).val = n.val-k.val := by
            rw [binomialSub_eqLit]
            exact JuliaLean.Proofs.base.int.lit_of_fits
              ⟨by have := binomialMinNonpositive t; omega, by have := n.property.2; omega⟩
          have hsym : chooseMath n.val.toNat (JuliaLean.base.int.sub n k).val.toNat =
              chooseMath n.val.toNat k.val.toNat := by
            rw [hsub, chooseSymmetry _ _ (by omega)]
            congr 1
            omega
          have hc := hcore (JuliaLean.base.int.sub n k) (by rw [hsub]; omega)
            (by rw [hsub]; omega) hsym
          simpa only [binomialBits, binomial_Integer, bitsOps, bitOps, hk', hn', hkn,
            hedge, hk1, hred, ite_false, ite_true, h1, show ¬ (1 : Int) < 0 by omega,
            Int.natCast_one, binomialWideDiv, Pure.pure, Except.pure, binomial_bind_ok] using hc
        · have hc := hcore k (by omega) (by omega) rfl
          simpa only [binomialBits, binomial_Integer, bitsOps, bitOps, hk', hn', hkn,
            hedge, hk1, hred, ite_false, ite_true, h1, show ¬ (1 : Int) < 0 by omega,
            Int.natCast_one, binomialWideDiv, Pure.pure, Except.pure, binomial_bind_ok] using hc

private def binomialFiniteSum (f : Nat → Int) : Nat → Int
  | 0 => 0
  | n+1 => binomialFiniteSum f n + f n

private theorem binomialFiniteSum_congr (f g : Nat → Int) (h : ∀ k, f k = g k) (n : Nat) :
    binomialFiniteSum f n = binomialFiniteSum g n := by
  induction n with
  | zero => rfl
  | succ n ih => rw [binomialFiniteSum, binomialFiniteSum, ih, h]

private theorem binomialFiniteSum_add (f g : Nat → Int) (n : Nat) :
    binomialFiniteSum (fun k => f k + g k) n = binomialFiniteSum f n + binomialFiniteSum g n := by
  induction n with
  | zero => rfl
  | succ n ih =>
    simp only [binomialFiniteSum, ih]
    omega

private theorem binomialFiniteSum_mul (z : Int) (f : Nat → Int) (n : Nat) :
    binomialFiniteSum (fun k => z * f k) n = z * binomialFiniteSum f n := by
  induction n with
  | zero => simp only [binomialFiniteSum, Int.mul_zero]
  | succ n ih => rw [binomialFiniteSum, binomialFiniteSum, ih, Int.mul_add]

private theorem binomialFiniteSum_shift (f : Nat → Int) (n : Nat) :
    binomialFiniteSum f (n+1) = f 0 + binomialFiniteSum (fun k => f (k+1)) n := by
  induction n with
  | zero => simp only [binomialFiniteSum, Int.zero_add, Int.add_zero]
  | succ n ih =>
    rw [binomialFiniteSum, ih, binomialFiniteSum]
    omega

/-- The polynomial identity follows directly from Pascal recursion over unbounded integers. -/
theorem chooseMath_polynomial (n : Nat) (z : Int) :
    binomialFiniteSum (fun k => (chooseMath n k : Int) * z^k) (n+1) = (1+z)^n := by
  induction n with
  | zero => simp only [binomialFiniteSum, chooseMath, Int.pow_zero, Int.natCast_one, Int.one_mul, Int.zero_add]
  | succ n ih =>
    rw [binomialFiniteSum_shift]
    have hhead : (chooseMath (n+1) 0 : Int) * z^0 = 1 := by
      rw [chooseZero, Int.pow_zero, Int.natCast_one, Int.mul_one]
    rw [hhead]
    have hcoeff : (fun k => (chooseMath (n+1) (k+1) : Int) * z^(k+1)) =
        (fun k => z*((chooseMath n k : Int)*z^k) + (chooseMath n (k+1) : Int)*z^(k+1)) := by
      funext k
      rw [chooseMath, Int.natCast_add, Int.add_mul, Int.pow_succ]
      congr 1
      ac_rfl
    rw [hcoeff, binomialFiniteSum_add, binomialFiniteSum_mul]
    have htail := binomialFiniteSum_shift (fun k => (chooseMath n k : Int)*z^k) (n+1)
    have hzero : (chooseMath n (n+1) : Int)*z^(n+1) = 0 := by
      rw [chooseAbove _ _ (by omega), Int.natCast_zero, Int.zero_mul]
    have hone : (chooseMath n 0 : Int)*z^0 = 1 := by
      rw [chooseZero, Int.pow_zero, Int.natCast_one, Int.mul_one]
    change binomialFiniteSum (fun k => (chooseMath n k : Int)*z^k) (n+1) +
        (chooseMath n (n+1) : Int)*z^(n+1) = _ at htail
    rw [hzero, Int.add_zero, hone, ih] at htail
    rw [ih, Int.pow_succ, Int.mul_add, Int.mul_one]
    rw [Int.mul_comm z ((1+z)^n)]
    omega

private theorem binomialFoldRange (f : Nat → Int) (n : Nat) :
    ((List.range n).map f).foldl (fun a b => a+b) 0 = binomialFiniteSum f n := by
  induction n with
  | zero => rfl
  | succ n ih =>
    rw [List.range_succ, List.map_append, List.foldl_append]
    simp only [List.map_cons, List.map_nil, List.foldl_cons, List.foldl_nil, ih, binomialFiniteSum]

/-- Exact native row coefficients satisfy the entire binomial polynomial identity. -/
theorem CombinatoricsBinomialNonnegativeEdges_proven : JuliaLean.Proofs.base.intfuncs.approvedRound3.BinomialNonnegativePolynomial := by
  intro t n hn z
  have hindex : ∀ k : Nat, k ≤ n.val.toNat → (JuliaLean.base.int.lit t (k : Int)).val = k := by
    intro k hk
    apply binomialLitNat
    have := n.property.2
    have := Int.toNat_of_nonneg hn
    omega
  have hspec : ∀ k : Nat, k ≤ n.val.toNat →
      ExactOrOverflow (binomialBits n (JuliaLean.base.int.lit t k))
        (chooseMath n.val.toNat k : Int) := by
    intro k hk
    have hki := hindex k hk
    rw [binomialBits_nonnegative n _ hn (by rw [hki]; omega), hki, Int.toNat_natCast]
    unfold ExactOrOverflow
    by_cases hfit : fits t (chooseMath n.val.toNat k : Int)
    · rw [ite_eq_left hfit, ite_eq_left hfit]
      exact ⟨_, rfl, JuliaLean.Proofs.base.int.lit_of_fits hfit⟩
    · rw [ite_eq_right hfit, ite_eq_right hfit]
      trivial
  refine ⟨hspec, ?_⟩
  intro coeffs hlen hcoeffs
  have hvalues : ∀ k : Nat, k ≤ n.val.toNat →
      ∃ c : JInt t, coeffs[k]? = some c ∧ c.val = (chooseMath n.val.toNat k : Int) := by
    intro k hk
    obtain ⟨c, hc, hres⟩ := hcoeffs k hk
    have hex := hspec k hk
    unfold ExactOrOverflow at hex
    split at hex
    · obtain ⟨r, hr, hv⟩ := hex
      rw [hres] at hr
      cases hr
      exact ⟨c, hc, hv⟩
    · rw [hres] at hex
      exact False.elim hex
  have hlist : (coeffs.zipIdx.map (fun ck => ck.1.val*z^ck.2)) =
      ((List.range (n.val.toNat+1)).map (fun k => (chooseMath n.val.toNat k : Int)*z^k)) := by
    apply List.ext_getElem?
    intro k
    by_cases hk : k < n.val.toNat+1
    · obtain ⟨c, hc, hv⟩ := hvalues k (by omega)
      simp only [List.getElem?_map, List.getElem?_zipIdx, hc, Option.map_some,
        Nat.zero_add, List.getElem?_range hk, hv]
    · have hleft : coeffs[k]? = none := List.getElem?_eq_none (by omega)
      have hright : (List.range (n.val.toNat+1))[k]? = none :=
        List.getElem?_eq_none (by simpa only [List.length_range] using Nat.le_of_not_gt hk)
      simp only [List.getElem?_map, List.getElem?_zipIdx, hleft, hright, Option.map_none]
  have hfold := congrArg (fun xs : List Int => xs.foldl (fun a b => a+b) 0) hlist
  rw [List.foldl_map] at hfold
  rw [hfold, binomialFoldRange, chooseMath_polynomial]

/-- The nonnegative-input part of the mixed exactness target, including every signed index. -/
theorem binomialBits_nonnegative_exact {t : IntTy} (n k : JInt t) (hn : 0 ≤ n.val) :
    ExactOrOverflow (binomialBits n k) (binomialMath n.val k.val) := by
  by_cases hk : k.val < 0
  · have hfit0 : fits t 0 := by cases t <;> decide
    have h0 : (JuliaLean.base.int.lit t 0).val = 0 := by cases t <;> decide
    simp only [binomialMath, hk, ite_true, ExactOrOverflow, hfit0]
    exact ⟨_, by simp only [binomialBits, binomial_Integer, bitsOps, bitOps, hk,
      ite_true, Pure.pure, Except.pure], h0⟩
  · rw [binomialMath, ite_eq_right hk, ite_eq_left hn,
      binomialBits_nonnegative n k hn (by omega)]
    unfold ExactOrOverflow
    by_cases hfit : fits t (chooseMath n.val.toNat k.val.toNat : Int)
    · rw [ite_eq_left hfit, ite_eq_left hfit]
      exact ⟨_, rfl, JuliaLean.Proofs.base.int.lit_of_fits hfit⟩
    · rw [ite_eq_right hfit, ite_eq_right hfit]
      trivial

private theorem binomialConvert_value {s : IntTy} (t : IntTy) (x : JInt s) (y : JInt t)
    (h : JuliaLean.base.int.convert t x = .ok y) : y.val = x.val := by
  unfold JuliaLean.base.int.convert JInt.convert at h
  split at h
  · cases h
    rfl
  · cases h

private theorem binomialPromote_values {s k : IntTy} (n : JInt s) (r : JInt k)
    (n' r' : JInt (s.promote k)) (h : promoteBits n r = .ok (n',r')) :
    n'.val = n.val ∧ r'.val = r.val := by
  unfold promoteBits at h
  cases h₁ : JuliaLean.base.int.convert (s.promote k) n with
  | error e =>
    simp only [h₁, Bind.bind, Except.bind] at h
    cases h
  | ok nn =>
    cases h₂ : JuliaLean.base.int.convert (s.promote k) r with
    | error e =>
      simp only [h₁, h₂, Bind.bind, Except.bind] at h
      cases h
    | ok rr =>
      simp only [h₁, h₂, Bind.bind, Except.bind, Pure.pure, Except.pure] at h
      cases h
      exact ⟨binomialConvert_value _ _ _ h₁, binomialConvert_value _ _ _ h₂⟩

theorem IntfuncsBinomialMixedExact_nonnegative (s k : IntTy) (n : JInt s) (r : JInt k)
    (hn : 0 ≤ n.val) :
    match promoteBits n r with
    | .error e => binomialMixedBits n r = .error e
    | .ok (n',r') =>
        n'.val = n.val ∧ r'.val = r.val ∧
        binomialMixedBits n r = binomialBits n' r' ∧
        ExactOrOverflow (binomialMixedBits n r) (binomialMath n.val r.val) := by
  cases hp : promoteBits n r with
  | error e =>
    simp only [binomialMixedBits, binomial_Mixed, hp, Bind.bind, Except.bind]
  | ok pair =>
    obtain ⟨n',r'⟩ := pair
    obtain ⟨hnv, hrv⟩ := binomialPromote_values n r n' r' hp
    have hcall : binomialMixedBits n r = binomialBits n' r' := by
      simp only [binomialMixedBits, binomial_Mixed, hp, Bind.bind, Except.bind]
    refine ⟨hnv, hrv, hcall, ?_⟩
    rw [hcall]
    have hresult := binomialBits_nonnegative_exact n' r' (by rw [hnv]; exact hn)
    simpa only [hnv, hrv] using hresult

private abbrev binomialTransformed {t : IntTy} (n k : JInt t) : JInt t :=
  JuliaLean.base.int.sub
    (JuliaLean.base.int.add (JuliaLean.base.int.neg n) k) (JuliaLean.base.int.lit t 1)

/-- The guarded negative-top transformation remains exact even if its intermediate negation wraps. -/
theorem binomialTransformed_value {t : IntTy} (n k : JInt t)
    (hn : n.val < 0) (hk : 0 ≤ k.val) (hbound : -n.val+k.val-1 ≤ t.max) :
    (binomialTransformed n k).val = -n.val+k.val-1 := by
  have h1 : (JuliaLean.base.int.lit t 1).val = 1 := by cases t <;> decide
  have hfit : fits t (-n.val+k.val-1) := by
    have := binomialMinNonpositive t
    exact ⟨by omega, hbound⟩
  change (JuliaLean.base.int.sub_int
    (JuliaLean.base.int.add_int (JuliaLean.base.int.neg_int n) k)
    (JuliaLean.base.int.lit t 1)).val = _
  rw [JuliaLean.Proofs.base.int.sub_int_val, JuliaLean.Proofs.base.int.add_int_val,
    JuliaLean.Proofs.base.int.neg_int_val, h1,
    JuliaLean.Proofs.base.int.wrapInt_add_left,
    JuliaLean.Proofs.base.int.wrapInt_sub_left]
  exact wrapInt_of_inRange t _ hfit

private theorem binomial_mul_one {t : IntTy} (x : JInt t) :
    JuliaLean.base.int.mul (JuliaLean.base.int.lit t 1) x = x := by
  apply Subtype.ext
  change (JuliaLean.base.int.mul_int _ _).val = _
  have h1 : (JuliaLean.base.int.lit t 1).val = 1 := by cases t <;> decide
  rw [JuliaLean.Proofs.base.int.mul_int_val, h1, Int.one_mul,
    JuliaLean.Proofs.base.int.wrapInt_val]

private theorem binomial_neg_one_value {t : IntTy} (n : JInt t) (hn : n.val < 0) :
    (JuliaLean.base.int.neg (JuliaLean.base.int.lit t 1)).val = -1 := by
  have h1 : (JuliaLean.base.int.lit t 1).val = 1 := by cases t <;> decide
  have hmax : 0 ≤ t.max := by cases t <;> decide
  change (JuliaLean.base.int.neg_int _).val = _
  rw [JuliaLean.Proofs.base.int.neg_int_val, h1]
  exact wrapInt_of_inRange t _ ⟨by have := n.property.1; omega, by omega⟩

private theorem binomial_mul_neg_one {t : IntTy} (n x : JInt t) (hn : n.val < 0) :
    JuliaLean.base.int.mul (JuliaLean.base.int.neg (JuliaLean.base.int.lit t 1)) x =
      JuliaLean.base.int.neg x := by
  apply Subtype.ext
  change (JuliaLean.base.int.mul_int _ _).val = (JuliaLean.base.int.neg_int _).val
  rw [JuliaLean.Proofs.base.int.mul_int_val, binomial_neg_one_value n hn,
    JuliaLean.Proofs.base.int.neg_int_val, Int.neg_mul, Int.one_mul]

private theorem binomial_map_bind {A B : Type} (f : A → B) (x : Jl A) :
    (do let a ← x; pure (f a)) = x.map f := by
  cases x <;> rfl

private abbrev binomialBody {t : IntTy} (n k sign : JInt t) : Jl (JInt t) := do
  if k.val > n.val then pure (JuliaLean.base.int.lit t 0)
  else if k.val = 0 ∨ k.val = n.val then pure sign
  else if k.val = 1 then pure (JuliaLean.base.int.mul sign n)
  else
    let j := if k.val > (JuliaLean.base.int.shr_Int n (JuliaLean.base.int.lit .i64 1)).val
      then JuliaLean.base.int.sub n k else k
    let x := JuliaLean.base.int.add (JuliaLean.base.int.sub n j) (JuliaLean.base.int.lit t 1)
    let x ← binomialLoop (bitsOps t) binomialWideDiv (j.val-1).toNat x
      (JuliaLean.base.int.add x (JuliaLean.base.int.lit t 1)) (JuliaLean.base.int.lit t 2) j
    pure (if sign.val < 0 then JuliaLean.base.int.neg x else x)

/-- Negative inputs reduce to the same nonnegative coefficient loop, followed by the source sign. -/
theorem binomialBits_negative_map {t : IntTy} (n k : JInt t)
    (hn : n.val < 0) (hk : 0 ≤ k.val) (hbound : -n.val+k.val-1 ≤ t.max) :
    binomialBits n k = (binomialBits (binomialTransformed n k) k).map
      (fun x => if k.val % 2 ≠ 0 then JuliaLean.base.int.neg x else x) := by
  let nt := binomialTransformed n k
  let sgn := if k.val % 2 ≠ 0 then JuliaLean.base.int.neg (JuliaLean.base.int.lit t 1)
      else JuliaLean.base.int.lit t 1
  let sign : JInt t → JInt t := fun x => if k.val % 2 ≠ 0 then JuliaLean.base.int.neg x else x
  have hnt : nt.val = -n.val+k.val-1 := binomialTransformed_value n k hn hk hbound
  have hnt0 : ¬ nt.val < 0 := by rw [hnt]; omega
  have hk0 : ¬ k.val < 0 := by omega
  have hkn : ¬ k.val > nt.val := by rw [hnt]; omega
  have h1 : (JuliaLean.base.int.lit t 1).val = 1 := by cases t <;> decide
  have hcopy : ∀ x : JInt t, (if sgn.val < 0 then JuliaLean.base.int.neg x else x) = sign x := by
    intro x
    by_cases hodd : k.val % 2 ≠ 0
    · simp [sgn, sign, hodd, binomial_neg_one_value n hn]
    · have heven : k.val % 2 = 0 := by omega
      simp [sgn, sign, heven, h1]
  have hmul : JuliaLean.base.int.mul sgn nt = sign nt := by
    by_cases hodd : k.val % 2 ≠ 0
    · simpa [sgn, sign, hodd] using binomial_mul_neg_one n nt hn
    · have heven : k.val % 2 = 0 := by omega
      simpa [sgn, sign, heven] using binomial_mul_one nt
  have hmodel : binomialBits n k = binomialBody nt k sgn := by
    simp only [binomialBits, binomial_Integer, bitsOps, bitOps, hk0, hn, ite_false, ite_true, Int.natCast_one]
    all_goals rfl
  have hmodel0 : binomialBits nt k = binomialBody nt k (JuliaLean.base.int.lit t 1) := by
    simp only [binomialBits, binomial_Integer, bitsOps, bitOps, hk0, hnt0, ite_false, Int.natCast_one]
    all_goals rfl
  change binomialBits n k = (binomialBits nt k).map sign
  rw [hmodel, hmodel0]
  by_cases hedge : k.val = 0 ∨ k.val = nt.val
  · have hsign1 : sgn = sign (JuliaLean.base.int.lit t 1) := rfl
    simpa only [binomialBody, hkn, hedge, ite_true, ite_false,
      Pure.pure, Except.pure, Except.map] using congrArg Except.ok hsign1
  · by_cases hk1 : k.val = 1
    · simp only [binomialBody, hkn, hedge, ite_false,
        show (k.val = 1) = True from propext ⟨fun _ => trivial, fun _ => hk1⟩,
        ite_true, Pure.pure, Except.pure, Except.map, binomial_mul_one]
      exact congrArg Except.ok hmul
    · simp only [binomialBody, hkn, hedge, hk1, ite_false, h1,
        show ¬ (1 : Int) < 0 by omega, hcopy, Pure.pure, Except.pure, binomial_bind_ok]
      exact binomial_map_bind sign _

private theorem binomial_signed_min (t : IntTy) (hn : t.min < 0) : t.min = -t.max-1 := by
  revert hn
  cases t <;> decide

private theorem binomial_neg_one_pow (k : Int) (hk : 0 ≤ k) :
    (-1 : Int)^k.toNat = if k % 2 ≠ 0 then -1 else 1 := by
  have hm : ((k.toNat % 2 : Nat) : Int) = k % 2 := by
    rw [Int.natCast_emod, Int.toNat_of_nonneg hk]
    rfl
  have hp : (-1 : Int)^k.toNat = if k.toNat % 2 = 0 then 1 else -1 := by
    simpa only [Nat.zero_add, Nat.one_pow, Int.natCast_one, Int.negOfNat_eq,
      Int.ofNat_eq_natCast, Int.negSucc_eq, Int.natCast_zero, Int.zero_add, Int.reduceNeg] using (Int.negSucc_pow 0 k.toNat)
  rw [hp]
  by_cases he : k % 2 = 0
  · have he' : k.toNat % 2 = 0 := by omega
    simp only [he, he', ne_eq, not_true_eq_false, ite_false, ite_true]
  · have he' : k.toNat % 2 ≠ 0 := by omega
    simp only [ne_eq, he, he', not_false_eq_true, ite_false, ite_true]

/-- Guarded negative native exactness; the only arithmetic side condition is the signed-minimum magnitude. -/
theorem binomialBits_negative_exact_except_min {t : IntTy} (n k : JInt t)
    (hn : n.val < 0) (hk : 0 ≤ k.val) (hbound : -n.val+k.val-1 ≤ t.max)
    (hmag : (chooseMath (k.val-n.val-1).toNat k.val.toNat : Int) ≠ -t.min) :
    ExactOrOverflow (binomialBits n k) (binomialMath n.val k.val) := by
  let nt := binomialTransformed n k
  let C : Int := chooseMath nt.val.toNat k.val.toNat
  have hnt : nt.val = -n.val+k.val-1 := binomialTransformed_value n k hn hk hbound
  have hnt0 : 0 ≤ nt.val := by rw [hnt]; omega
  have hC : C = (chooseMath (k.val-n.val-1).toNat k.val.toNat : Int) := by
    dsimp only [C]
    rw [hnt]
    congr 2
    omega
  have hmag' : C ≠ -t.min := by rw [hC]; exact hmag
  have hC0 : 0 ≤ C := Int.natCast_nonneg _
  have hmin : t.min < 0 := by have := n.property.1; omega
  have hminEq := binomial_signed_min t hmin
  have hmax : 0 ≤ t.max := by cases t <;> decide
  have hmath : binomialMath n.val k.val = if k.val % 2 ≠ 0 then -C else C := by
    rw [binomialMath, ite_eq_right (by omega : ¬ k.val < 0),
      ite_eq_right (by omega : ¬ 0 ≤ n.val), binomial_neg_one_pow k.val hk, ← hC]
    by_cases ho : k.val % 2 = 0
    · simp only [ho, ne_eq, not_true_eq_false, ite_false, Int.one_mul]
    · simp only [ne_eq, ho, not_false_eq_true, ite_true, Int.neg_mul, Int.one_mul]
  rw [binomialBits_negative_map n k hn hk hbound,
    binomialBits_nonnegative nt k hnt0 hk, hmath]
  change ExactOrOverflow
    ((if fits t C then (Except.ok (JuliaLean.base.int.lit t C) : Jl (JInt t))
      else Except.error (.overflowError "")).map
      (fun x => if k.val % 2 ≠ 0 then JuliaLean.base.int.neg x else x))
    (if k.val % 2 ≠ 0 then -C else C)
  by_cases hodd : k.val % 2 ≠ 0
  · simp only [ne_eq, hodd, not_false_eq_true, ite_true]
    have hfitEq : fits t (-C) ↔ fits t C := by
      unfold fits
      constructor <;> intro h <;> constructor <;> omega
    unfold ExactOrOverflow
    by_cases hfit : fits t C
    · have hfitNeg := hfitEq.mpr hfit
      rw [ite_eq_left hfit, ite_eq_left hfitNeg]
      refine ⟨JuliaLean.base.int.neg (JuliaLean.base.int.lit t C), rfl, ?_⟩
      change (JuliaLean.base.int.neg_int _).val = -C
      rw [JuliaLean.Proofs.base.int.neg_int_val, JuliaLean.Proofs.base.int.lit_of_fits hfit]
      exact wrapInt_of_inRange t _ hfitNeg
    · have hfitNeg : ¬ fits t (-C) := fun h => hfit (hfitEq.mp h)
      rw [ite_eq_right hfit, ite_eq_right hfitNeg]
      trivial
  · simp only [hodd, ite_false]
    unfold ExactOrOverflow
    by_cases hfit : fits t C
    · rw [ite_eq_left hfit, ite_eq_left hfit]
      exact ⟨_, rfl, JuliaLean.Proofs.base.int.lit_of_fits hfit⟩
    · rw [ite_eq_right hfit, ite_eq_right hfit]
      trivial

private theorem binomialSignedFacts (t : IntTy) (hn : t.min < 0) :
    1 ≤ t.bits-1 ∧ -t.min = ((2^(t.bits-1) : Nat) : Int) ∧
      t.max = ((2^(t.bits-1) : Nat) : Int)-1 := by
  revert hn
  cases t <;> decide

/-- Kummer's elementary binary-carry bound rules out the only signed-minimum endpoint. -/
theorem binomial_negative_magnitude_ne_min {t : IntTy} (n k : JInt t)
    (hn : n.val < 0) (hk : 0 ≤ k.val) (hbound : -n.val+k.val-1 ≤ t.max) :
    (chooseMath (k.val-n.val-1).toNat k.val.toNat : Int) ≠ -t.min := by
  have hmin : t.min < 0 := by have := n.property.1; omega
  obtain ⟨hw, hpow, hmax⟩ := binomialSignedFacts t hmin
  have htop0 : 0 ≤ k.val-n.val-1 := by omega
  have htop : (k.val-n.val-1).toNat < 2^(t.bits-1) := by
    have hnat := Int.toNat_of_nonneg htop0
    omega
  have hindex : k.val.toNat ≤ (k.val-n.val-1).toNat := by omega
  intro heq
  rw [hpow] at heq
  exact KummerWork.chooseMath_not_power_two _ _ _ hw htop hindex (Int.ofNat_inj.mp heq)

/-- Full fixed-width exactness under the frozen mixed target's transformation guard. -/
theorem binomialBits_guarded_exact {t : IntTy} (n k : JInt t)
    (hguard : 0 ≤ n.val ∨ -n.val+k.val-1 ≤ t.max) :
    ExactOrOverflow (binomialBits n k) (binomialMath n.val k.val) := by
  by_cases hn : 0 ≤ n.val
  · exact binomialBits_nonnegative_exact n k hn
  · by_cases hk : k.val < 0
    · have hfit0 : fits t 0 := by cases t <;> decide
      have h0 : (JuliaLean.base.int.lit t 0).val = 0 := by cases t <;> decide
      simp only [binomialMath, hk, ite_true, ExactOrOverflow, hfit0]
      exact ⟨_, by simp only [binomialBits, binomial_Integer, bitsOps, bitOps, hk,
        ite_true, Pure.pure, Except.pure], h0⟩
    · have hneg : n.val < 0 := by omega
      have hk0 : 0 ≤ k.val := by omega
      have hbound : -n.val+k.val-1 ≤ t.max := hguard.resolve_left hn
      exact binomialBits_negative_exact_except_min n k hneg hk0 hbound
        (binomial_negative_magnitude_ne_min n k hneg hk0 hbound)

/-- Source-preserving promotion plus guarded native exactness proves the complete mixed target. -/
theorem IntfuncsBinomialMixedExact_proven : JuliaLean.Proofs.base.intfuncs.BinomialMixedExact := by
  intro s k n r hguard
  cases hp : promoteBits n r with
  | error e =>
    simp only [binomialMixedBits, binomial_Mixed, hp, Bind.bind, Except.bind]
  | ok pair =>
    obtain ⟨n',r'⟩ := pair
    obtain ⟨hnv, hrv⟩ := binomialPromote_values n r n' r' hp
    have hcall : binomialMixedBits n r = binomialBits n' r' := by
      simp only [binomialMixedBits, binomial_Mixed, hp, Bind.bind, Except.bind]
    refine ⟨hnv, hrv, hcall, ?_⟩
    rw [hcall]
    have hguard' : 0 ≤ n'.val ∨ -n'.val+r'.val-1 ≤ (s.promote k).max := by
      simpa only [hnv, hrv] using hguard
    have hresult := binomialBits_guarded_exact n' r' hguard'
    simpa only [hnv, hrv] using hresult

