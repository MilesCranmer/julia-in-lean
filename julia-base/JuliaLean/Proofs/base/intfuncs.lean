private theorem le_of_eq {n m : Nat} (k : Nat) (h1 : n = k := by rfl) (h2 : k ≤ m := by decide) : n ≤ m :=
  h1 ▸ h2

private theorem ge_of_eq {m n : Nat} (k : Nat) (h1 : n = k := by rfl) (h2 : m ≤ k := by decide) : m ≤ n :=
  h1 ▸ h2

private theorem le_of_eq2 {n m : Nat} (k1 k2 : Nat)
    (h1 : n = k1 := by rfl) (h2 : m = k2 := by rfl) (h3 : k1 ≤ k2 := by decide) : n ≤ m :=
  h1 ▸ h2 ▸ h3

@[simp] private theorem io_tryCatch {W A : Type} (act : JuliaLean.base.io.M W A)
    (h : JuliaLean.base.io.Error → JuliaLean.base.io.M W A) (w : W) :
    tryCatch act h w = match act w with
      | none => none
      | some (.ok r) => some (.ok r)
      | some (.error (e, w')) => h e w' := rfl

@[simp] private theorem recordCall_snapshot {W E A : Type}
    (f : Except JuliaLean.base.io.Error (RationalCallSnapshot W A) → E)
    (action : JuliaLean.base.io.M W A) (wt : W × List E) :
    recordCall f (snapshotRationalCall action) wt =
    match action wt.1 with
    | none => none
    | some (.ok (v, w')) =>
        some (.ok (⟨wt.1, .ok v, w'⟩, (w', wt.2 ++ [f (.ok ⟨wt.1, .ok v, w'⟩)])))
    | some (.error (e, w')) =>
        some (.ok (⟨wt.1, .error e, w'⟩, (w', wt.2 ++ [f (.ok ⟨wt.1, .error e, w'⟩)]))) := by
  rcases wt with ⟨w, tr⟩
  dsimp only [recordCall, snapshotRationalCall, JuliaLean.base.io.getWorld]
  simp only [io_bind, io_pure, io_tryCatch, JuliaLean.base.io.getWorld]
  cases action w with
  | none => rfl
  | some r => cases r <;> rfl

@[simp] private theorem recordCall_apply {W E A : Type}
    (ev : Except JuliaLean.base.io.Error A → E) (act : JuliaLean.base.io.M W A)
    (wt : W × List E) :
    recordCall ev act wt = match act wt.1 with
      | none => none
      | some (.error (err, next)) => some (.error (err, (next, wt.2 ++ [ev (.error err)])))
      | some (.ok (val, next)) => some (.ok (val, (next, wt.2 ++ [ev (.ok val)]))) := by
  rcases wt with ⟨w, tr⟩; rfl

@[simp] private theorem tailObserve_apply {W Call A : Type}
    (call : Except JuliaLean.base.io.Error A → Call) (act : JuliaLean.base.io.M W A)
    (wt : W × List (TailEvent W Call)) :
    tailObserve call act wt = match act wt.1 with
      | none => none
      | some (.error (err, next)) =>
          some (.error (err, (next, wt.2 ++ [⟨wt.1, call (.error err), next⟩])))
      | some (.ok (val, next)) =>
          some (.ok (val, (next, wt.2 ++ [⟨wt.1, call (.ok val), next⟩]))) := by
  rcases wt with ⟨w, tr⟩; rfl

@[simp] private theorem tailPreserveLog_apply {W E A : Type}
    (act : JuliaLean.base.io.M W A) (wt : W × List E) :
    tailPreserveLog act wt = match act wt.1 with
      | none => none
      | some (.ok (res, next)) => some (.ok (res, (next, wt.2)))
      | some (.error (err, next)) => some (.error (err, (next, wt.2))) := by
  rcases wt with ⟨w, tr⟩; rfl

@[simp] private theorem gcdxAssertBool_apply {W Other : Type} (v : Bool ⊕ Other) (w : W) :
    gcdxAssertBool v w = match v with
      | .inl b => some (.ok (b, w))
      | .inr _ => some (.error (.foreignError "TypeError" "", w)) := by
  cases v <;> rfl

@[simp] private theorem resumeRationalOutcome_apply {W A : Type}
    (out : Except JuliaLean.base.io.Error A) (w : W) :
    resumeRationalOutcome out w = match out with
      | .ok v => some (.ok (v, w))
      | .error e => some (.error (e, w)) := by
  cases out <;> rfl

@[simp] private theorem wrapperObserve_apply {W Atom R : Type} (call : WrapperCall)
