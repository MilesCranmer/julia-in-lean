private theorem lcm_Nary_eq_gcd_Nary {R : Type} (op : R → R → Jl R) (unary : R → Jl R) :
    ∀ (cs : List R) (a b : R), lcm_Nary op unary a b cs = gcd_Nary op unary a b cs
  | [], _, _ => rfl
  | [_], _, _ => rfl
  | c :: d :: ds, a, b => by
    unfold lcm_Nary gcd_Nary
    dsimp only
    rw [lcm_Nary_eq_gcd_Nary op unary (d :: ds) b c]
termination_by cs => cs.length

private theorem foldl_op_assoc {R : Type} (val : R → Int) (op : Int → Int → Int)
    (hop : ∀ x y z, op (op x y) z = op x (op y z)) (xs : List R) (a b : Int) :
    xs.foldl (fun acc x => op acc (val x)) (op a b) =
      op a (xs.foldl (fun acc x => op acc (val x)) b) := by
  induction xs generalizing b with
  | nil => rfl
  | cons x xs ih =>
    simp only [List.foldl_cons, ← ih (op b (val x)), hop]
private theorem foldl_cons2 {R : Type} (f : R → Int) (op : Int → Int → Int) (e : Int)
    (he : ∀ x, op e (f x) = (f x).natAbs)
    (habs : ∀ x y : Int, op x (y.natAbs : Int) = op x y ∧ op (x.natAbs : Int) y = op x y)
    (x y : R) (zs : List R) :
    (x :: y :: zs).foldl (fun g z => op g (f z)) e =
      zs.foldl (fun g z => op g (f z)) (op (f x) (f y)) := by
  simp only [List.foldl_cons, he, (habs _ _).2]

private theorem gcd_Nary_spec {R : Type} (f1 f2 : R → Int)
    (op1 op2 : Int → Int → Int) (e1 e2 : Int)
    (hop1 : ∀ x y z, op1 (op1 x y) z = op1 x (op1 y z))
    (hop2 : ∀ x y z, op2 (op2 x y) z = op2 x (op2 y z))
    (he1 : ∀ x, op1 e1 (f1 x) = (f1 x).natAbs)
    (he2 : ∀ x, op2 e2 (f2 x) = (f2 x).natAbs)
    (habs1 : ∀ x y : Int, op1 x (y.natAbs : Int) = op1 x y ∧ op1 (x.natAbs : Int) y = op1 x y)
    (habs2 : ∀ x y : Int, op2 x (y.natAbs : Int) = op2 x y ∧ op2 (x.natAbs : Int) y = op2 x y)
    (bin : R → R → Jl R) (unary : R → Jl R)
    (hbin : ∀ x y, ∃ r, bin x y = .ok r ∧ f1 r = op1 (f1 x) (f1 y) ∧ f2 r = op2 (f2 x) (f2 y))
    (hun : ∀ x, ∃ r, unary x = .ok r ∧ f1 r = (f1 x).natAbs ∧ f2 r = (f2 x).natAbs) :
    ∀ (cs : List R) (a b : R),
      ∃ r, gcd_Nary bin unary a b cs = .ok r ∧
        f1 r = (a :: b :: cs).foldl (fun g x => op1 g (f1 x)) e1 ∧
        f2 r = (a :: b :: cs).foldl (fun l x => op2 l (f2 x)) e2
  | [], a, b => by
    unfold gcd_Nary
    dsimp only
    obtain ⟨t, ht, ht1, ht2⟩ := hun b
    obtain ⟨r, hr, hr1, hr2⟩ := hbin a t
    rw [ht, ok_bind, hr]
    refine ⟨r, rfl, ?_, ?_⟩
    · simp only [List.foldl_cons, List.foldl_nil, he1, (habs1 _ _).2]
      rw [hr1, ht1, (habs1 _ _).1]
    · simp only [List.foldl_cons, List.foldl_nil, he2, (habs2 _ _).2]
      rw [hr2, ht2, (habs2 _ _).1]
  | [c], a, b => by
    unfold gcd_Nary
    dsimp only
    obtain ⟨t, ht, ht1, ht2⟩ := hbin b c
    obtain ⟨r, hr, hr1, hr2⟩ := hbin a t
    rw [ht, ok_bind, hr]
    refine ⟨r, rfl, ?_, ?_⟩
    · simp only [List.foldl_cons, List.foldl_nil, he1, (habs1 _ _).2]
      rw [hr1, ht1, hop1]
    · simp only [List.foldl_cons, List.foldl_nil, he2, (habs2 _ _).2]
      rw [hr2, ht2, hop2]
  | c :: d :: ds, a, b => by
    unfold gcd_Nary
    dsimp only
    obtain ⟨t, ht, ht1, ht2⟩ := gcd_Nary_spec f1 f2 op1 op2 e1 e2 hop1 hop2 he1 he2 habs1 habs2 bin unary hbin hun (d :: ds) b c
    obtain ⟨r, hr, hr1, hr2⟩ := hbin a t
    rw [ht, ok_bind, hr]
    refine ⟨r, rfl, ?_, ?_⟩
    · rw [foldl_cons2 f1 op1 e1 he1 habs1 b c (d :: ds)] at ht1
      rw [foldl_cons2 f1 op1 e1 he1 habs1 a b (c :: d :: ds), List.foldl_cons, hr1, ht1,
        ← foldl_op_assoc f1 op1 hop1 (d :: ds) (f1 a) (op1 (f1 b) (f1 c)), ← hop1]
    · rw [foldl_cons2 f2 op2 e2 he2 habs2 b c (d :: ds)] at ht2
      rw [foldl_cons2 f2 op2 e2 he2 habs2 a b (c :: d :: ds), List.foldl_cons, hr2, ht2,
        ← foldl_op_assoc f2 op2 hop2 (d :: ds) (f2 a) (op2 (f2 b) (f2 c)), ← hop2]
termination_by cs => cs.length

theorem gcdLcmNaryExact_proven : GcdLcmNaryExact := by
