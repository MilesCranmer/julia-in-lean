inductive WrapperCall where
  | absolute | unsigned | lessZero | maxPad | minPad | remInt | equalBase
  | splitSign | indexedFirst | indexedLast | format | positiveCondition
  | convertSigned | positiveRaw | negativeRaw | bitAnd | general
  | typedDigits | digitCount | zeros | fill
  deriving BEq, DecidableEq

/-- A selected call is observed once, with actual reference/value identities,
mutable worlds and its outcome. No callee is replayed by the specification. -/
structure WrapperEvent (W Atom : Type) where
  call : WrapperCall
  arguments : List Atom
  before : W
  outcome : Except JuliaLean.base.io.Error Atom
  after : W

def wrapperObserve {W Atom R : Type} (call : WrapperCall) (arguments : List Atom)
    (encode : R → Atom) (action : JuliaLean.base.io.M W R) :
    JuliaLean.base.io.M (W × List (WrapperEvent W Atom)) R :=
  fun (world, trace) => match action world with
  | none => none
  | some (.ok (value, next)) =>
      some (.ok (value, (next, trace ++ [⟨call, arguments, world, .ok (encode value), next⟩])))
  | some (.error (error, next)) =>
      some (.error (error, (next, trace ++ [⟨call, arguments, world, .error error, next⟩])))

def wrapperCalls {W A : Type} (call : WrapperCall) (trace : List (WrapperEvent W A)) :=
  trace.filter (fun event => event.call == call)
def wrapperOutputs {W A : Type} (call : WrapperCall) (trace : List (WrapperEvent W A)) :=
  (wrapperCalls call trace).filterMap (fun event => event.outcome.toOption)
def wrapperErrors {W A : Type} (trace : List (WrapperEvent W A)) : List JuliaLean.base.io.Error :=
  trace.filterMap fun event => match event.outcome with | .error error => some error | _ => none

def WrapperWorldAccounting {W A : Type} (initial final : W) (trace : List (WrapperEvent W A)) : Prop :=
  trace.map WrapperEvent.before = (initial :: trace.map WrapperEvent.after).take trace.length ∧
  final = ((trace.getLast?).map WrapperEvent.after).getD initial

def WrapperSelectedError {W A : Type} (trace : List (WrapperEvent W A)) (error : JuliaLean.base.io.Error) : Prop :=
  wrapperErrors trace = [error] ∧ ∃ event, trace.getLast? = some event ∧ event.outcome = .error error

/-- Inspect a completed observation without imposing termination or any law
on a selected operation. Local pure operations retain the last observed world. -/
def WrapperExecution {W A R : Type}
    (action : JuliaLean.base.io.M (W × List (WrapperEvent W A)) R) (world : W)
    (invariant : List (WrapperEvent W A) → Prop)
    (terminal : List (WrapperEvent W A) → Except JuliaLean.base.io.Error R → Prop) : Prop :=
  match action (world, []) with
  | none => True
  | some (.ok (value, (final, trace))) =>
      invariant trace ∧ WrapperWorldAccounting world final trace ∧ terminal trace (.ok value)
  | some (.error (error, (final, trace))) =>
      invariant trace ∧ WrapperWorldAccounting world final trace ∧ terminal trace (.error error)

inductive SplitSignAtom (I A U C : Type) where
  | input (value : I)
  | absolute (value : A)
  | magnitude (value : U)
  | comparison (value : C)
