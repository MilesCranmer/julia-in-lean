private theorem convert_self {t : IntTy} (x : JInt t) :
    JuliaLean.base.int.convert t x = .ok x := by
  unfold JuliaLean.base.int.convert JInt.convert
  rw [dite_eq_left x.property]

private theorem indexedPointer_byte_val (p : JuliaLean.base.pointer.Ptr (JInt .u8)) (index : JInt64) :
    (JuliaLean.base.pointer.indexedPointer formattingByteCodec p index).address.val =
      (p.address.val + index.val - 1) % (2 ^ 64 : Int) := by
  change wrapInt .u64 (p.address.val +
    wrapInt .u64 (wrapInt .i64 (1 * wrapInt .i64 (index.val - 1)))) = _
  have hd1 := JuliaLean.Proofs.base.intfuncs.opusRing.wrap_dvd .i64 (index.val - 1)
  have hd2 := JuliaLean.Proofs.base.intfuncs.opusRing.wrap_dvd .i64 (1 * wrapInt .i64 (index.val - 1))
  have hd3 := JuliaLean.Proofs.base.intfuncs.opusRing.wrap_dvd .u64
    (wrapInt .i64 (1 * wrapInt .i64 (index.val - 1)))
  change (2 ^ 64 : Int) ∣ _ at hd1 hd2 hd3
  have hsum : (2 ^ 64 : Int) ∣
      (p.address.val + wrapInt .u64 (wrapInt .i64 (1 * wrapInt .i64 (index.val - 1)))) -
      (p.address.val + index.val - 1) := by
    rcases hd1 with ⟨k1, hk1⟩; rcases hd2 with ⟨k2, hk2⟩; rcases hd3 with ⟨k3, hk3⟩
    exact ⟨k3 + k2 + k1, by omega⟩
  change (p.address.val + wrapInt .u64 (wrapInt .i64 (1 * wrapInt .i64 (index.val - 1)))) % (2 ^ 64 : Int) = _
  exact Int.emod_eq_emod_iff_emod_sub_eq_zero.mpr (Int.emod_eq_zero_of_dvd hsum)

