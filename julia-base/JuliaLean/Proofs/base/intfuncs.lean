private theorem ndMixedFloorZero (u s : IntTy) (hu : u.signed = false)
    (hs : s.signed = true) (y : JInt s) (hy : y.val ≠ 0) :
    mixedDivUnsignedSigned (JuliaLean.base.int.lit u 0) y .Down =
      .ok (JuliaLean.base.int.lit (u.promote s.toUnsigned).toSigned.toUnsigned 0) := by
  change (div_Unsigned_Signed_Down
    (JuliaLean.base.int.divrem_Unsigned_BitSigned sameSignTruncDivrem)
    JuliaLean.base.int.signbit (fun r => decide (r.val = 0))
    (fun q bit => q - JuliaLean.base.int.ofBool _ bit)
    (JuliaLean.base.int.lit u 0) y) = _
  rw [div_Unsigned_Signed_Down, ndMixedDivremZero u s hu hs y hy]
  simp only [Bind.bind, Except.bind, ndZeroLitVal, decide_true, Bool.not_true,
    Bool.and_false, JuliaLean.base.int.ofBool, Bool.false_eq_true, ite_false,
    Pure.pure, Except.pure]
  congr 1
  apply Subtype.ext
  change wrapInt _ ((JuliaLean.base.int.lit _ 0).val - (JuliaLean.base.int.lit _ 0).val) = _
  simp only [ndZeroLitVal, Int.sub_self, ndZeroWrap]

private theorem ndFldmodFirstZero (u s : IntTy) (hu : u.signed = false)
    (hs : s.signed = true) (y : JInt s) (hy : y.val ≠ 0) :
    (fldmodMixedUnsignedSigned (JuliaLean.base.int.lit u 0) y).map
      (fun qr => qr.1.val) = .ok 0 := by
  change ((do
    let q ← mixedDivUnsignedSigned (JuliaLean.base.int.lit u 0) y .Down
    pure (q, JuliaLean.base.int.binop JuliaLean.base.int.sub_int
      (JuliaLean.base.int.lit u 0)
      (JuliaLean.base.int.binop JuliaLean.base.int.mul_int q y)) :
    Jl (JInt (u.promote s.toUnsigned).toSigned.toUnsigned ×
      JInt (u.promote ((u.promote s.toUnsigned).toSigned.toUnsigned.promote s)))).map
      (fun qr => qr.1.val)) = _
  rw [ndMixedFloorZero u s hu hs y hy]
  simp only [Bind.bind, Except.bind, Pure.pure, Except.pure, Except.map, ndZeroLitVal]

private theorem ndConcreteQuotientZero (u s : IntTy) (hu : u.signed = false)
    (hs : s.signed = true) (y : JInt s) (hy : y.val ≠ 0) :
    approvedRound3.Concrete.digitCallees.quotient u s false true 0 y.val = .ok 0 := by
  have hyEq : JuliaLean.base.int.lit s y.val = y := by
    apply Subtype.ext
    exact JuliaLean.Proofs.base.int.lit_of_fits y.property
  simp only [approvedRound3.Concrete.digitCallees, approvedRound3.Concrete.quotient,
    hu, hs, Bool.false_eq_true, ite_false, ite_true, hyEq]
