def stringPadObservation {V S : Type} : Sum JInt64 V → StringIntegerAtom V S
  | .inl value => .native value
  | .inr value => .invalidPad value

def observeStringIntegerOps {W V S : Type} (ops : StringIntegerOps W V S) :
    StringIntegerOps (W × List (WrapperEvent W (StringIntegerAtom V S))) V S where
  maxPad pad minimum := wrapperObserve .maxPad [.value pad,.native minimum] .value (ops.maxPad pad minimum)
  minPad value maximum := wrapperObserve .minPad [.value value,.native maximum] .value (ops.minPad value maximum)
  remInt value := wrapperObserve .remInt [.value value] stringPadObservation (ops.remInt value)
  equalBase base literal := wrapperObserve .equalBase [.value base,.native literal] .boolean (ops.equalBase base literal)
  splitSign n := wrapperObserve .splitSign [.value n] .value (ops.splitSign n)
  indexedFirst result index := wrapperObserve .indexedFirst [.value result,.native index]
    (fun (value, state) => .iteration value state) (ops.indexedFirst result index)
  indexedLast result index state := wrapperObserve .indexedLast [.value result,.native index,.state state]
    .value (ops.indexedLast result index state)
  format kind positive pad negative := wrapperObserve .format
    [.formatter kind,.value positive,.native pad,.value negative] .value (ops.format kind positive pad negative)
  positiveCondition base zero := wrapperObserve .positiveCondition [.value base,.native zero] .boolean (ops.positiveCondition base zero)
  abs n := wrapperObserve .absolute [.value n] .value (ops.abs n)
  unsigned absolute := wrapperObserve .unsigned [.value absolute] .value (ops.unsigned absolute)
  convertSigned n := wrapperObserve .convertSigned [.value n] .value (ops.convertSigned n)
  positiveRaw base zero := wrapperObserve .positiveRaw [.value base,.native zero] .value (ops.positiveRaw base zero)
  negativeRaw n zero := wrapperObserve .negativeRaw [.value n,.native zero] .value (ops.negativeRaw n zero)
  bitAnd positive negative := wrapperObserve .bitAnd [.value positive,.value negative] .value (ops.bitAnd positive negative)
  general base magnitude pad sign := wrapperObserve .general [.value base,.value magnitude,.native pad,.value sign]
    .value (ops.general base magnitude pad sign)

def stringObservedValues {W V S : Type} (call : WrapperCall) (trace : List (WrapperEvent W (StringIntegerAtom V S))) : List V :=
  (wrapperOutputs call trace).filterMap fun result => match result with | .value value => some value | _ => none

def stringObservedBooleans {W V S : Type} (call : WrapperCall) (trace : List (WrapperEvent W (StringIntegerAtom V S))) : List Bool :=
  (wrapperOutputs call trace).filterMap fun result => match result with | .boolean value => some value | _ => none

def stringObservedIterations {W V S : Type} (trace : List (WrapperEvent W (StringIntegerAtom V S))) : List (V × S) :=
  (wrapperOutputs .indexedFirst trace).filterMap fun result => match result with | .iteration value state => some (value,state) | _ => none

def StringFormatterLiteral (kind : IntegerFormat) (literal : JInt64) : Prop :=
  literal.val = match kind with | .binary => 2 | .octal => 8 | .decimal => 10 | .hexadecimal => 16

/-- The observed magnitude has one of two actual producers, determined by
the FIRST base>0 condition. The second raw comparison remains independent. -/
def StringMagnitudeOrigin {W V S : Type} (trace : List (WrapperEvent W (StringIntegerAtom V S))) (magnitude : V) : Prop :=
  (stringObservedBooleans .positiveCondition trace = [true] ∧ stringObservedValues .unsigned trace = [magnitude]) ∨
  (stringObservedBooleans .positiveCondition trace = [false] ∧ stringObservedValues .convertSigned trace = [magnitude])

def StringIntegerCausal {W V S : Type} (n base pad : V)
    (before : List (WrapperEvent W (StringIntegerAtom V S)))
    (event : WrapperEvent W (StringIntegerAtom V S)) : Prop :=
  match event.call with
  | .maxPad => before = [] ∧ event.arguments = [.value pad,.native (JuliaLean.base.int.typemin .i64)]
  | .minPad => ∃ lower, stringObservedValues .maxPad before = [lower] ∧
      event.arguments = [.value lower,.native (JuliaLean.base.int.typemax .i64)]
  | .remInt => ∃ upper, stringObservedValues .minPad before = [upper] ∧ event.arguments = [.value upper]
  | .equalBase => ∃ nativePad literal,
      wrapperOutputs .remInt before = [.native nativePad] ∧
      ([2,8,10,16] : List Int)[(wrapperCalls .equalBase before).length]? = some literal ∧
      stringObservedBooleans .equalBase before = List.replicate (wrapperCalls .equalBase before).length false ∧
      event.arguments = [.value base,.native (JuliaLean.base.int.lit .i64 literal)]
  | .splitSign => (stringObservedBooleans .equalBase before).getLast? = some true ∧ event.arguments = [.value n]
  | .indexedFirst => ∃ result, stringObservedValues .splitSign before = [result] ∧
      event.arguments = [.value result,.native (JuliaLean.base.int.lit .i64 1)]
  | .indexedLast => ∃ result positive state,
      stringObservedValues .splitSign before = [result] ∧ stringObservedIterations before = [(positive,state)] ∧
      event.arguments = [.value result,.native (JuliaLean.base.int.lit .i64 2),.state state]
  | .format => ∃ kind positive negative state nativePad lastEquality literal,
      stringObservedIterations before = [(positive,state)] ∧ stringObservedValues .indexedLast before = [negative] ∧
      wrapperOutputs .remInt before = [.native nativePad] ∧
      (wrapperCalls .equalBase before).getLast? = some lastEquality ∧
      lastEquality.arguments = [.value base,.native literal] ∧ lastEquality.outcome = .ok (.boolean true) ∧
      StringFormatterLiteral kind literal ∧
      event.arguments = [.formatter kind,.value positive,.native nativePad,.value negative]
  | .positiveCondition => stringObservedBooleans .equalBase before = [false,false,false,false] ∧
      event.arguments = [.value base,.native (JuliaLean.base.int.lit .i64 0)]
  | .absolute => stringObservedBooleans .positiveCondition before = [true] ∧ event.arguments = [.value n]
  | .unsigned => ∃ absolute, stringObservedValues .absolute before = [absolute] ∧ event.arguments = [.value absolute]
  | .convertSigned => stringObservedBooleans .positiveCondition before = [false] ∧ event.arguments = [.value n]
  | .positiveRaw => (∃ magnitude, StringMagnitudeOrigin before magnitude) ∧
      event.arguments = [.value base,.native (JuliaLean.base.int.lit .i64 0)]
  | .negativeRaw => (∃ positive, stringObservedValues .positiveRaw before = [positive]) ∧
      event.arguments = [.value n,.native (JuliaLean.base.int.lit .i64 0)]
  | .bitAnd => ∃ positive negative,
      stringObservedValues .positiveRaw before = [positive] ∧ stringObservedValues .negativeRaw before = [negative] ∧
      event.arguments = [.value positive,.value negative]
  | .general => ∃ magnitude nativePad sign,
      StringMagnitudeOrigin before magnitude ∧ wrapperOutputs .remInt before = [.native nativePad] ∧
      stringObservedValues .bitAnd before = [sign] ∧
      event.arguments = [.value base,.value magnitude,.native nativePad,.value sign]
  | _ => False

