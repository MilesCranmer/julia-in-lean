  | .absolute => before = [] ∧ event.arguments = [.input n]
  | .unsigned => ∃ absolute, wrapperOutputs .absolute before = [.absolute absolute] ∧ event.arguments = [.absolute absolute]
  | .lessZero => (∃ magnitude, wrapperOutputs .unsigned before = [.magnitude magnitude]) ∧
      event.arguments = [.input n,.native (JuliaLean.base.int.lit .i64 0)]
