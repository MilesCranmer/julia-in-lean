  have h := Int.mul_lt_mul_of_pos_left hbase hp
  simpa only [Int.mul_one] using h

private theorem nextpow_real_correction {A X : Type} (valA : A → Int) (valX : X → Int)
    (log : A → X → Jl Int) (base : A) (input : X) (n : Int) (k : Nat)
    (hbase : 1 < valA base) (hinput : 1 < valX input) (hn : 1 ≤ n)
    (hlog : log base input = .ok n)
    (hnear : n = (k : Int) - 1 ∨ n = k ∨ n = (k : Int) + 1)
    (hbelow : ∀ j : Nat, j < k → (valA base) ^ j < valX input)
    (hupper : valX input ≤ (valA base) ^ k) :
    nextpow (fun x => decide (valX x ≤ 0)) (fun _ => false) false
      (fun _ => .error (.methodError "_nextpow2"))
      (fun a => decide (valA a ≤ 1)) (fun x => decide (valX x ≤ 1)) (fun _ => (1 : Int))
      log (fun a m => pure ((valA a) ^ m.toNat)) (fun _ => false) (fun _ _ => false)
      (fun p x => decide (p ≥ valX x)) (fun p q => decide (p > q)) base input =
      .ok ((valA base) ^ k) := by
  have hpositive : ¬ valX input ≤ 0 := by omega
  have hbaseNotSmall : ¬ valA base ≤ 1 := by omega
  have hinputNotSmall : ¬ valX input ≤ 1 := by omega
  rcases hnear with hnlo | hneq | hnhi
  · have hnat : n.toNat = k - 1 := by omega
    have hnatlo : (n - 1).toNat = k - 2 := by omega
    have hnathi : (n + 1).toNat = k := by omega
    have hk2 : 2 ≤ k := by omega
    have hlow := hbelow (k - 2) (by omega)
    have hmid := hbelow (k - 1) (by omega)
    have hstep1 : (valA base) ^ (k - 2) < (valA base) ^ (k - 1) := by
      have h := nextpow_power_increasing (valA base) hbase (k - 2)
      simpa only [show k - 2 + 1 = k - 1 by omega] using h
    have hstep2 : (valA base) ^ (k - 1) < (valA base) ^ k := by
      have h := nextpow_power_increasing (valA base) hbase (k - 1)
      simpa only [show k - 1 + 1 = k by omega] using h
    simp only [nextpow, hpositive, hbaseNotSmall, hinputNotSmall, decide_false,
      Bool.false_eq_true, ite_false, hlog, Bind.bind, Except.bind,
      hnat, hnatlo, hnathi, Pure.pure, Except.pure, Bool.and_false,
      show ¬ (valA base) ^ (k - 2) ≥ valX input by omega,
      show ¬ (valA base) ^ (k - 1) ≥ valX input by omega,
      hstep1, hstep2, decide_true, Bool.not_true]
  · have hnat : n.toNat = k := by omega
    have hnatlo : (n - 1).toNat = k - 1 := by omega
    have hk : 0 < k := by omega
    have hlow := hbelow (k - 1) (by omega)
    have hstep : (valA base) ^ (k - 1) < (valA base) ^ k := by
      have h := nextpow_power_increasing (valA base) hbase (k - 1)
      simpa only [show k - 1 + 1 = k by omega] using h
    simp only [nextpow, hpositive, hbaseNotSmall, hinputNotSmall, decide_false,
      Bool.false_eq_true, ite_false, hlog, Bind.bind, Except.bind,
      hnat, hnatlo, Pure.pure, Except.pure, Bool.and_false,
      show ¬ (valA base) ^ (k - 1) ≥ valX input by omega,
      hstep, hupper, decide_true, Bool.not_true, ite_true]
  · have hnatlo : (n - 1).toNat = k := by omega
    simp only [nextpow, hpositive, hbaseNotSmall, hinputNotSmall, decide_false,
      Bool.false_eq_true, ite_false, hlog, Bind.bind, Except.bind,
      hnatlo, Pure.pure, Except.pure, Bool.and_false,
      hupper, decide_true, ite_true]

/-- intfuncs-nextpow-exact. The finite-type conjunct follows from an inconsistent
frozen callee law; the real-value conjunct verifies the source's correction branches. -/
theorem IntfuncsNextpowExact_proven : JuliaLean.Proofs.base.intfuncs.NextpowExact := by
  refine ⟨?_, ?_⟩
  · intro a x log hlog
    exact False.elim (nativeCeilLogLaw_inconsistent a x log hlog)
  · intro A X valA valX log hlog base input
    dsimp only
    by_cases hbad : valX input ≤ 0 ∨ valA base ≤ 1
    · rw [ite_eq_left hbad]
      rcases hbad with hinput | hbase
      · simp only [nextpow, hinput, decide_true, ite_true, domainError]
      · by_cases hinput : valX input ≤ 0
        · simp only [nextpow, hinput, decide_true, ite_true, domainError]
        · simp only [nextpow, hinput, hbase, decide_false, decide_true, Bool.false_and,
            Bool.false_eq_true, ite_false, ite_true, domainError]
    · rw [ite_eq_right hbad]
      intro k hbelow hupper
      by_cases hsmall : valX input ≤ 1
      · have hk : k = 0 := by
          by_cases hk : k = 0
          · exact hk
          · have hzero := hbelow 0 (by omega)
            simp only [Int.pow_zero] at hzero
            omega
        simp only [hk, Int.pow_zero, nextpow, show ¬ valX input ≤ 0 by omega,
          show ¬ valA base ≤ 1 by omega, hsmall, decide_false, decide_true,
          Bool.false_and, Bool.false_eq_true, ite_false, ite_true,
          Pure.pure, Except.pure]
      · obtain ⟨n, hncall, hn, hnear⟩ :=
          hlog base input k (by omega) (by omega) hbelow hupper
        exact nextpow_real_correction valA valX log base input n k
          (by omega) (by omega) hn hncall hnear hbelow hupper

end JuliaLean.ChatGPT.Batch4.Group12

