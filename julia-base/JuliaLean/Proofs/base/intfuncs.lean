private theorem causal_1 {α : Type} (P : List α → α → Prop) (e1 : α)
    (h1 : P [] e1) :
    ∀ before event after, [e1] = before ++ event :: after → P before event := by
  intro before event after h
  cases before with
  | nil => simp at h; rcases h with ⟨rfl, _⟩; exact h1
  | cons x xs => cases xs <;> simp at h

private theorem causal_2 {α : Type} (P : List α → α → Prop) (e1 e2 : α)
    (h1 : P [] e1) (h2 : P [e1] e2) :
    ∀ before event after, [e1, e2] = before ++ event :: after → P before event := by
  intro before event after h
  cases before with
  | nil => simp at h; rcases h with ⟨rfl, _⟩; exact h1
  | cons x1 b1 =>
    cases b1 with
    | nil => simp at h; rcases h with ⟨rfl, rfl, _⟩; exact h2
    | cons x2 b2 => cases b2 <;> simp at h

private theorem causal_3 {α : Type} (P : List α → α → Prop) (e1 e2 e3 : α)
    (h1 : P [] e1) (h2 : P [e1] e2) (h3 : P [e1, e2] e3) :
    ∀ before event after, [e1, e2, e3] = before ++ event :: after → P before event := by
  intro before event after h
  cases before with
  | nil => simp at h; rcases h with ⟨rfl, _⟩; exact h1
  | cons x1 b1 =>
    cases b1 with
    | nil => simp at h; rcases h with ⟨rfl, rfl, _⟩; exact h2
    | cons x2 b2 =>
      cases b2 with
      | nil => simp at h; rcases h with ⟨rfl, rfl, rfl, _⟩; exact h3
      | cons x3 b3 => cases b3 <;> simp at h

private theorem causal_4 {α : Type} (P : List α → α → Prop) (e1 e2 e3 e4 : α)
    (h1 : P [] e1) (h2 : P [e1] e2) (h3 : P [e1, e2] e3) (h4 : P [e1, e2, e3] e4) :
    ∀ before event after, [e1, e2, e3, e4] = before ++ event :: after → P before event := by
  intro before event after h
  cases before with
  | nil => simp at h; rcases h with ⟨rfl, _⟩; exact h1
  | cons x1 b1 =>
    cases b1 with
    | nil => simp at h; rcases h with ⟨rfl, rfl, _⟩; exact h2
    | cons x2 b2 =>
      cases b2 with
      | nil => simp at h; rcases h with ⟨rfl, rfl, rfl, _⟩; exact h3
      | cons x3 b3 =>
        cases b3 with
        | nil => simp at h; rcases h with ⟨rfl, rfl, rfl, rfl, _⟩; exact h4
        | cons x4 b4 => cases b4 <;> simp at h

private theorem causal_5 {α : Type} (P : List α → α → Prop) (e1 e2 e3 e4 e5 : α)
    (h1 : P [] e1) (h2 : P [e1] e2) (h3 : P [e1, e2] e3)
    (h4 : P [e1, e2, e3] e4) (h5 : P [e1, e2, e3, e4] e5) :
    ∀ before event after, [e1, e2, e3, e4, e5] = before ++ event :: after → P before event := by
  intro before event after h
  cases before with
  | nil => simp at h; rcases h with ⟨rfl, _⟩; exact h1
  | cons x1 b1 =>
    cases b1 with
    | nil => simp at h; rcases h with ⟨rfl, rfl, _⟩; exact h2
    | cons x2 b2 =>
      cases b2 with
      | nil => simp at h; rcases h with ⟨rfl, rfl, rfl, _⟩; exact h3
      | cons x3 b3 =>
        cases b3 with
        | nil => simp at h; rcases h with ⟨rfl, rfl, rfl, rfl, _⟩; exact h4
        | cons x4 b4 =>
          cases b4 with
          | nil => simp at h; rcases h with ⟨rfl, rfl, rfl, rfl, rfl, _⟩; exact h5
          | cons x5 b5 => cases b5 <;> simp at h

private theorem wrapperCalls_le_one_1 {W A : Type} (e1 : WrapperEvent W A) :
    ∀ call, (wrapperCalls call [e1]).length ≤ 1 := by
  intro call; simp only [wrapperCalls, List.filter]
  cases e1.call == call <;> simp

private theorem wrapperCalls_le_one_2 {W A : Type} (e1 e2 : WrapperEvent W A)
    (h12 : ∀ c, (e1.call == c && e2.call == c) = false) :
    ∀ call, (wrapperCalls call [e1, e2]).length ≤ 1 := by
  intro call; simp only [wrapperCalls, List.filter]
  have a := h12 call; revert a
  cases e1.call == call <;> cases e2.call == call <;> simp

