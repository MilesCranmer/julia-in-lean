    trailingZeros_i64_power hbase64pos (by simpa [base64] using hpow)
  have hbasePow : base.val = (2 : Int)^k := by
    calc
      base.val = base64.val := hbase64.symm
      _ = (2 : Int)^k := hpowBase
  have hnat : x.val.toNat ≠ 0 := by
    intro hzero
    have hcast : (x.val.toNat : Int) = x.val := Int.toNat_of_nonneg (by omega)
    rw [hzero] at hcast
    omega
  have hnatlt : x.val.toNat < 2^k := by
    have hcast : (x.val.toNat : Int) = x.val := Int.toNat_of_nonneg (by omega)
    have hltInt : (x.val.toNat : Int) < (2 : Int)^k := by
      rw [hcast, ← hbasePow]
      exact hlt
    exact_mod_cast hltInt
  have hloglt : x.val.toNat.log2 < k := (Nat.log2_lt hnat).2 hnatlt
  have htop := topBit_unsignedAbs_positive x hx
  have htopPos : 0 < topBit (JuliaLean.base.int.unsigned (JuliaLean.base.int.abs x)) := by
    rw [htop]
    omega
  have htopLe : topBit (JuliaLean.base.int.unsigned (JuliaLean.base.int.abs x)) ≤ k := by
    rw [htop]
    omega
  have htopNonzero : topBit (JuliaLean.base.int.unsigned (JuliaLean.base.int.abs x)) ≠ 0 := by
    omega
  have hformulaInt :
      (if topBit (JuliaLean.base.int.unsigned (JuliaLean.base.int.abs x)) % k = 0 then
        (topBit (JuliaLean.base.int.unsigned (JuliaLean.base.int.abs x)) : Int) / k
      else
        (topBit (JuliaLean.base.int.unsigned (JuliaLean.base.int.abs x)) : Int) / k + 1) = 1 := by
    by_cases heq : topBit (JuliaLean.base.int.unsigned (JuliaLean.base.int.abs x)) = k
    · have hdiv : (k : Int) / k = 1 := Int.ediv_self (by omega)
      simp [heq, hdiv]
    · have hltTop : topBit (JuliaLean.base.int.unsigned (JuliaLean.base.int.abs x)) < k := by omega
      have hdiv :
          (topBit (JuliaLean.base.int.unsigned (JuliaLean.base.int.abs x)) : Int) / k = 0 :=
        Int.ediv_eq_zero_of_lt (by omega) (by omega)
      simp [Nat.mod_eq_of_lt hltTop, htopNonzero, hdiv]
  have hconv := convert_i64_exact base hfit
  have honeValue : (JuliaLean.base.int.lit .i64 1).val = 1 := by decide
  constructor
  · simp [ndigitsZeroBits, ndigitsZero, ndigitsPositiveBits, ndigitsPositive, hconv, base64,
      hbase64, hcttzVal, hcttz, hbase, hneg, hn, hnot2, hnot8, hnot16, hnot10, hpow,
      hformulaInt, hx, honeValue, Bind.bind, Except.bind, Pure.pure, Except.pure]
  · simp [ndigitsBits, ndigits, ndigitsZeroBits, ndigitsZero, ndigitsPositiveBits, ndigitsPositive,
      hconv, base64, hbase64, hcttzVal, hcttz, hbase, hneg, hn, hnot2, hnot8, hnot16, hnot10,
      hpow, hformulaInt, hx, honeValue, Bind.bind, Except.bind, Pure.pure, Except.pure]

