def bigDivrem (n base : Int) : Jl (Int × Int) := bigOps.divrem n base

def bigFldmod (n base : Int) : Jl (Int × Int) :=
  JuliaLean.base.div.divrem_Integer_Directed bigOps.div bigFloor
    (fun x y mode => if mode = .Down then bigFloor x y
      else if mode = .Up then bigCeiling x y else bigOps.div x y)
    Int.mul Int.sub n base .Down

def bigDigitsBang (hasMax : Bool) (elementMax : Int) (a : Vector Int)
    (n base : Int) : Jl (Vector Int) :=
  digitsBang id bigOps hasMax elementMax false (JInt.convert (IntTy.i64.name) .i64)
    (fun b => (JuliaLean.base.int.cttz_int b).val.toNat)
    (fun _ _ _ => 0) bigDivrem bigFldmod id Int.neg bigFldmod pure a n base

def bigDigits (decimal : Int → Jl JInt64) (n base pad : Int) : Jl (Vector Int) :=
