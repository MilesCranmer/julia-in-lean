theorem lcmGenericExact_proven : LcmGenericExact := by
  intro a b
  unfold lcm_Integer
  by_cases h0 : bigOps.value a = 0 ∨ bigOps.value b = 0
  · simp only [h0, ↓reduceIte]
    rcases h0 with ha | hb
    · have ha' : a = 0 := ha
      subst ha'
      simp [bigOps, lcmMath, Pure.pure, Except.pure]
    · have hb' : b = 0 := hb
      subst hb'
      simp [bigOps, lcmMath, Pure.pure, Except.pure]
  · simp only [h0, ↓reduceIte]
    have ha : a ≠ 0 := fun h => h0 (Or.inl h)
    have hb : b ≠ 0 := fun h => h0 (Or.inr h)
    rw [gcd_Integer_bigOps_eq]
    have hpos : 0 < Nat.gcd b.natAbs a.natAbs :=
      Nat.gcd_pos_of_pos_left _ (Int.natAbs_pos.mpr hb)
    have hd0 : gcdMath b a ≠ 0 := by unfold gcdMath; omega
    simp only [Bind.bind, Except.bind, bigOps, hd0, ↓reduceIte, Pure.pure, Except.pure]
    congr 1
    unfold lcmMath gcdMath
    have hdiv : (b.tdiv (Nat.gcd b.natAbs a.natAbs : Int)).natAbs =
        b.natAbs / Nat.gcd b.natAbs a.natAbs := by
      rw [Int.natAbs_tdiv]
      rfl
    rw [Int.natAbs_mul, hdiv, Nat.gcd_comm b.natAbs a.natAbs]
    have hdvd : Nat.gcd a.natAbs b.natAbs ∣ b.natAbs := Nat.gcd_dvd_right a.natAbs b.natAbs
    have hm := Nat.gcd_mul_lcm a.natAbs b.natAbs
    have hmul : a.natAbs * (b.natAbs / Nat.gcd a.natAbs b.natAbs) * Nat.gcd a.natAbs b.natAbs =
        Nat.lcm a.natAbs b.natAbs * Nat.gcd a.natAbs b.natAbs := by
      rw [Nat.mul_assoc, Nat.div_mul_cancel hdvd, ← hm, Nat.mul_comm (Nat.gcd _ _)]
    have hpos' : 0 < Nat.gcd a.natAbs b.natAbs := by rw [Nat.gcd_comm]; exact hpos
    exact congrArg Int.ofNat (Nat.eq_of_mul_eq_mul_right hpos' hmul)
private theorem natAbs_eq_ite (z : Int) : (z.natAbs : Int) = if z < 0 then -z else z := by omega

private theorem int_nonneg_of_mul_pos {a b : Int} (hab : 0 ≤ a * b) (hb : 0 < b) : 0 ≤ a := by
  by_cases ha : 0 ≤ a
  · exact ha
  · have ha1 : a ≤ -1 := by omega
    have hle := Int.mul_le_mul_of_nonneg_right ha1 (Int.le_of_lt hb)
    omega

theorem rationalUnaryGcd_proven : RationalUnaryGcd := by
  intro R num den ratio hratio a hden
  unfold gcd_Unary_Rational
  obtain ⟨r, hr, hdenr, hnumr⟩ := hratio (num a).natAbs (den a) hden
  refine ⟨r, ?_, hnumr, ?_, hdenr⟩
  · simp [bigOps, Bind.bind, Except.bind, Pure.pure, Except.pure, hr]
  · have hnonneg : 0 ≤ ((num a).natAbs : Int) * den r :=
      Int.mul_nonneg (Int.natCast_nonneg _) (Int.le_of_lt hdenr)
