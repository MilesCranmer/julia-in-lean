/-- Observation of loop bookkeeping, independent of multiplication and remainders. -/
inductive PowermodLoopEvent (V Other : Type) where
  | bitAnd (exponent : V) (literal : JInt64) (result : Except JuliaLean.base.io.Error V)
  | notEqual (mask : V) (literal : JInt64)
      (result : Except JuliaLean.base.io.Error (Bool ⊕ Other))
  | shift (exponent : V) (literal : JInt64) (result : Except JuliaLean.base.io.Error V)

/-- Lift an unobserved dependency without changing its world, result, or error. -/
def preservePowermodTrace {W E A : Type} (action : JuliaLean.base.io.M W A) :
    JuliaLean.base.io.M (W × List E) A := fun (world, events) =>
  match action world with
  | none => none
  | some (.ok (result, next)) => some (.ok (result, (next, events)))
  | some (.error (error, next)) => some (.error (error, (next, events)))

/-- Wrap exactly three selected dependencies, preserving all other calls. -/
def observePowermodOps {W V Ty Other : Type} (ops : PowermodOps W V Ty Other) :
    PowermodOps (W × List (PowermodLoopEvent V Other)) V Ty Other where
  typeOf := ops.typeOf
  equalLiteral := fun a b => preservePowermodTrace (ops.equalLiteral a b)
  equal := fun a b => preservePowermodTrace (ops.equal a b)
  lessLiteral := fun a b => preservePowermodTrace (ops.lessLiteral a b)
  greaterLiteral := fun a b => preservePowermodTrace (ops.greaterLiteral a b)
  greater := fun a b => preservePowermodTrace (ops.greater a b)
  notEqualLiteral := fun a b => recordCall (.notEqual a b) (ops.notEqualLiteral a b)
  isodd := fun a => preservePowermodTrace (ops.isodd a)
  iszero := fun a => preservePowermodTrace (ops.iszero a)
  neg := fun a => preservePowermodTrace (ops.neg a)
  divLiteral := fun a b => preservePowermodTrace (ops.divLiteral a b)
  one := fun a => preservePowermodTrace (ops.one a)
  zero := fun a => preservePowermodTrace (ops.zero a)
  uabs := fun a => preservePowermodTrace (ops.uabs a)
  mod := fun a b => preservePowermodTrace (ops.mod a b)
  oftype := fun a b => preservePowermodTrace (ops.oftype a b)
  widemul := fun a b => preservePowermodTrace (ops.widemul a b)
  mul := fun a b => preservePowermodTrace (ops.mul a b)
  add := fun a b => preservePowermodTrace (ops.add a b)
  bitAndLiteral := fun a b => recordCall (.bitAnd a b) (ops.bitAndLiteral a b)
  shiftRightLiteral := fun a b => recordCall (.shift a b) (ops.shiftRightLiteral a b)
  sizeOf := fun a => preservePowermodTrace (ops.sizeOf a)
  mulLiteralLeft := fun a b => preservePowermodTrace (ops.mulLiteralLeft a b)
  multiplicativeinverse := fun a => preservePowermodTrace (ops.multiplicativeinverse a)
  invmod := fun a b => preservePowermodTrace (ops.invmod a b)
  convert := fun a b => preservePowermodTrace (ops.convert a b)
  isInstance := ops.isInstance
  legal := {
    unsigned := {
      typeOf := ops.legal.unsigned.typeOf
      hasTypeMax := fun a => preservePowermodTrace (ops.legal.unsigned.hasTypeMax a)
      typeMax := fun a => preservePowermodTrace (ops.legal.unsigned.typeMax a)
      sizeOfType := fun a => preservePowermodTrace (ops.legal.unsigned.sizeOfType a)
      shiftLeft := fun a b => preservePowermodTrace (ops.legal.unsigned.shiftLeft a b)
      shiftRight := fun a b => preservePowermodTrace (ops.legal.unsigned.shiftRight a b)
      lessEqual := fun a b => preservePowermodTrace (ops.legal.unsigned.lessEqual a b) }
    select := fun a => match ops.legal.select a with
      | .integer => .integer
      | .unsigned => .unsigned
      | .custom method => .custom (fun a => preservePowermodTrace (method a))
      | .noMethod => .noMethod }
  recursiveDispatch := fun a b c => match ops.recursiveDispatch a b c with
    | .generic => .generic
    | .custom method => .custom (fun a b c => preservePowermodTrace (method a b c))
    | .noMethod => .noMethod

/-- A successful loop iteration consumes one original exponent for both the
bit-test and the shift. Returned mask and predicate identity are observed, never
assumed correct mathematically. -/
structure PowermodLoopBatch (V : Type) where
  exponent : V
  mask : V
  decision : Bool
  nextExponent : V

def powermodBatchEvents {V Other : Type} (batch : PowermodLoopBatch V) :
    List (PowermodLoopEvent V Other) :=
  [ .bitAnd batch.exponent (JuliaLean.base.int.lit .i64 1) (.ok batch.mask),
    .notEqual batch.mask (JuliaLean.base.int.lit .i64 0) (.ok (.inl batch.decision)),
    .shift batch.exponent (JuliaLean.base.int.lit .i64 1) (.ok batch.nextExponent) ]

/-- At a finite failure, completed bookkeeping batches may be followed by one
unfinished iteration. A tracked callee failure retains the exact error; a non-Bool
parity predicate produces TypeError. Other arithmetic failures may happen between
the successful parity predicate and the shift. -/
def PowermodLoopFailureTail {V Other : Type}
    (error : JuliaLean.base.io.Error) (events : List (PowermodLoopEvent V Other)) : Prop :=
  events = [] ∨
  (∃ p, events = [.bitAnd p (JuliaLean.base.int.lit .i64 1) (.error error)]) ∨
  (∃ p mask, events =
    [.bitAnd p (JuliaLean.base.int.lit .i64 1) (.ok mask),
     .notEqual mask (JuliaLean.base.int.lit .i64 0) (.error error)]) ∨
  (∃ p mask other, events =
    [.bitAnd p (JuliaLean.base.int.lit .i64 1) (.ok mask),
     .notEqual mask (JuliaLean.base.int.lit .i64 0) (.ok (.inr other))] ∧
    error = .foreignError "TypeError" "") ∨
  (∃ p mask decision, events =
    [.bitAnd p (JuliaLean.base.int.lit .i64 1) (.ok mask),
     .notEqual mask (JuliaLean.base.int.lit .i64 0) (.ok (.inl decision))]) ∨
  (∃ p mask decision, events =
    [.bitAnd p (JuliaLean.base.int.lit .i64 1) (.ok mask),
     .notEqual mask (JuliaLean.base.int.lit .i64 0) (.ok (.inl decision)),
     .shift p (JuliaLean.base.int.lit .i64 1) (.error error)])

/-- Falsifiable loop accounting/provenance invariant for arbitrary callees,
including changing values, mutable worlds, exceptions and non-Bool predicates.
No arithmetic or termination properties of the supplied methods are hypotheses. -/
def PowermodOpenLoopAccounting : Prop :=
  ∀ (W V Ty Other : Type) (ops : PowermodOps W V Ty Other) (x p m : V) (world : W),
    match powermodGeneric (observePowermodOps ops) x p m (world, []) with
    | none => True
    | some (.ok (_, (_, events))) =>
        ∃ batches : List (PowermodLoopBatch V),
          events = batches.flatMap (powermodBatchEvents (Other := Other))
    | some (.error (error, (_, events))) =>
        ∃ (batches : List (PowermodLoopBatch V)) (tail : List (PowermodLoopEvent V Other)),
          events = batches.flatMap (powermodBatchEvents (Other := Other)) ++ tail ∧
          PowermodLoopFailureTail error tail

/-- The native optimization threshold is exactly the set of unsigned moduli whose
square fits in the native result ring, over every width and value. This mathematical
criterion does not repeat the helper's bit shifts. -/
def PowermodNativeLegalSquareBound : Prop :=
  ∀ (W : Type) (t : IntTy) (_unsigned : t.signed = false) (mm : JInt t) (world : W),
    powermodMILegalUnsigned (powermodMILegalBitsOps (World := W) t) mm world =
      some (.ok (.inl (decide (mm.val * mm.val ≤ t.max)), world))

