theorem ceiling_bounds (l k : Nat) (hk : 0 < k) :
    1 ≤ (l + k) / k ∧ (l + k) / k ≤ l + 1 ∧
      l + 1 ≤ k * ((l + k) / k) ∧ k * ((l + k) / k - 1) ≤ l := by
  have hp := Nat.mod_add_div (l + k) k
  have hr := Nat.mod_lt (l + k) hk
  have hmul : l ≤ k * l := by
    simpa only [Nat.one_mul] using Nat.mul_le_mul_right l (Nat.succ_le_of_lt hk)
  have hupper : (l + k) / k ≤ l + 1 :=
    Nat.div_le_of_le_mul (by
      rw [Nat.mul_add, Nat.mul_one]
      exact Nat.add_le_add_right hmul k)
  have hpos : 1 ≤ (l + k) / k := (Nat.le_div_iff_mul_le hk).mpr (by
    simpa only [Nat.one_mul] using Nat.le_add_left k l)
  have hceil : l + 1 ≤ k * ((l + k) / k) := by
    have ht := Nat.add_lt_add_right hr (k * ((l + k) / k))
    rw [hp, Nat.add_comm k (k * ((l + k) / k))] at ht
    exact Nat.succ_le_of_lt (Nat.lt_of_add_lt_add_right ht)
  refine ⟨hpos, hupper, hceil, ?_⟩
  have hbound : k * ((l + k) / k) ≤ l + k :=
    Nat.le_trans (Nat.le_add_left (k * ((l + k) / k)) ((l + k) % k)) (Nat.le_of_eq hp)
  rw [Nat.mul_sub_left_distrib, Nat.mul_one]
  simpa only [Nat.add_sub_cancel] using Nat.sub_le_sub_right hbound k

