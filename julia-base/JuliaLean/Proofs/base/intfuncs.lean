  generalize he : symbolicOutput.values.map Subtype.val = ds at hn h0 hr ⊢
  cases ds with
  | nil => cases h0
  | cons d ds =>
    have hd : d = 1 := Option.some.inj h0
    have ht : ∀ x ∈ ds, 0 ≤ x := fun x hx => hn x (by simp only [List.mem_cons]; exact Or.inr hx)
    have hindex : (2 ^ 59 : Nat) = (2 ^ 59 - 1) + 1 := by decide
    rw [hindex] at hr
    have hpos := polynomial_positive_at (2 ^ 32) (by decide) ds ht (2 ^ 59 - 1) 1 hr (by decide)
    have hm := Int.mul_pos (show (0 : Int) < 2 ^ 32 by decide) hpos
    change 1 < d + 2 ^ 32 * evalpoly (2 ^ 32) ds
    omega

