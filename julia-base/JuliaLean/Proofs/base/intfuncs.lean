/-! Observation machinery for the queued unary Rational gcd. This snippet
uses the common `recordCall` defined with the generic-GCD properties. These
definitions observe the actual selected callees; they are not Julia models
and do not prescribe arithmetic, normalization, termination or heap laws. -/

/-- The before/after worlds and actual outcome of one selected dispatch call.
The snapshots allow the property to account for state on exceptional returns
as well as successful returns. -/
structure RationalCallSnapshot (W A : Type) where
  before : W
  outcome : Except JuliaLean.base.io.Error A
  after : W

/-- Capture the selected action's outcome without losing its post-call world.
An exception is temporarily made data for observation and is rethrown by the
instrumented operation below. Divergence remains divergence. -/
def snapshotRationalCall {W A : Type} (action : JuliaLean.base.io.M W A) :
    JuliaLean.base.io.M W (RationalCallSnapshot W A) := do
  let before ← JuliaLean.base.io.getWorld
  let outcome ← tryCatch (do pure (Except.ok (← action)))
    (fun error => pure (Except.error error))
  let after ← JuliaLean.base.io.getWorld
  pure ⟨before, outcome, after⟩

/-- No callback is evaluated again when an observed outcome is resumed. -/
def resumeRationalOutcome {W A : Type} :
    Except JuliaLean.base.io.Error A → JuliaLean.base.io.M W A
  | .ok value => pure value
  | .error error => throw error

/-- Actual arguments, outcomes and states of the two dispatch leaves.
The outer Except is the common logger's observation envelope; the inner
snapshot retains the original selected operation's successful or exceptional
outcome. A completed observation always contains a snapshot. -/
inductive RationalUnaryEvent (W I U R : Type) where
  | absolute (input : I)
      (observed : Except JuliaLean.base.io.Error (RationalCallSnapshot W U))
  | ratio (numerator : U) (denominator : I)
      (observed : Except JuliaLean.base.io.Error (RationalCallSnapshot W R))

/-- Instrumentation preserves each selected action's return value, exception,
world changes and divergence. The operations receive no access to the trace.
No result, state transition or reference-identity law is assumed. -/
def observeRationalUnaryOps {W I U R : Type}
    (ops : RationalUnaryOps (JuliaLean.base.io.M W) I U R) :
    RationalUnaryOps (JuliaLean.base.io.M (W × List (RationalUnaryEvent W I U R)))
      I U R where
  checkedAbs input := do
    let snapshot ← recordCall (.absolute input)
      (snapshotRationalCall (ops.checkedAbs input))
    resumeRationalOutcome snapshot.outcome
  ratio numerator denominator := do
    let snapshot ← recordCall (.ratio numerator denominator)
      (snapshotRationalCall (ops.ratio numerator denominator))
    resumeRationalOutcome snapshot.outcome

def rationalAbsoluteInputs {W I U R : Type}
    (trace : List (RationalUnaryEvent W I U R)) : List I :=
  trace.filterMap fun event => match event with
    | .absolute input _ => some input
    | _ => none

def rationalAbsoluteOutputs {W I U R : Type}
    (trace : List (RationalUnaryEvent W I U R)) : List U :=
  trace.filterMap fun event => match event with
    | .absolute _ (.ok snapshot) => snapshot.outcome.toOption
    | _ => none

def rationalRatioInputs {W I U R : Type}
    (trace : List (RationalUnaryEvent W I U R)) : List (U × I) :=
  trace.filterMap fun event => match event with
    | .ratio numerator denominator _ => some (numerator, denominator)
    | _ => none

def rationalRatioOutputs {W I U R : Type}
    (trace : List (RationalUnaryEvent W I U R)) : List R :=
  trace.filterMap fun event => match event with
    | .ratio _ _ (.ok snapshot) => snapshot.outcome.toOption
    | _ => none

def rationalEventWorlds {W I U R : Type} :
    RationalUnaryEvent W I U R → Option (W × W)
  | .absolute _ (.ok snapshot) => some (snapshot.before, snapshot.after)
  | .ratio _ _ (.ok snapshot) => some (snapshot.before, snapshot.after)
  | _ => none

def rationalEventError {W I U R : Type} :
    RationalUnaryEvent W I U R → Option JuliaLean.base.io.Error
  | .absolute _ (.ok ⟨_, .error error, _⟩) => some error
  | .ratio _ _ (.ok ⟨_, .error error, _⟩) => some error
  | .absolute _ (.error error) => some error
  | .ratio _ _ (.error error) => some error
  | _ => none

/-- Independent call accounting and operand/reference provenance. Every
completed execution has one absolute-value call and at most one ratio call.
The ratio's numerator is exactly the observed absolute-value result, while
its denominator is the original stored field, including when the two input
fields alias. These are data-origin constraints, not a replay of arithmetic.
Source invariant: base/intfuncs.jl:153; field layout: base/rational.jl:9-15. -/
def RationalUnaryProvenance {W I U R : Type} (a : RationalStorage I)
    (trace : List (RationalUnaryEvent W I U R)) : Prop :=
  let ratioInputs := rationalRatioInputs trace
  rationalAbsoluteInputs trace = [a.num] ∧
  ratioInputs.length ≤ 1 ∧
  ratioInputs.map Prod.fst = rationalAbsoluteOutputs trace ∧
  ratioInputs.map Prod.snd = List.replicate ratioInputs.length a.den ∧
  ∃ observation, trace.head? = some (.absolute a.num observation)

/-- The function adds no state changes between its selected calls and does
not roll back the world when a selected call fails. Every adjacent call starts
in its predecessor's actual post-call world; the last post-call world is the
returned world. No callee transition is constrained.
Source invariant: base/intfuncs.jl:153. -/
def RationalUnaryWorldAccounting {W I U R : Type} (initial final : W)
    (trace : List (RationalUnaryEvent W I U R)) : Prop :=
  let worlds := trace.filterMap rationalEventWorlds
  worlds.length = trace.length ∧
  worlds.map Prod.fst = (initial :: worlds.map Prod.snd).take worlds.length ∧
  (worlds.getLast?).map Prod.snd = some final

/-- A returned reference/value originates in one actual successful ratio
call. A returned exception is the unique observed failure and belongs to the
last completed call, so failures are neither swallowed nor followed by calls.
Source invariant: base/intfuncs.jl:153. -/
def RationalUnaryTerminal {W I U R : Type}
    (trace : List (RationalUnaryEvent W I U R)) :
    Except JuliaLean.base.io.Error R → Prop
  | .ok value =>
      rationalRatioOutputs trace = [value] ∧
      trace.filterMap rationalEventError = [] ∧ trace.length = 2
  | .error error =>
      trace.filterMap rationalEventError = [error] ∧
      rationalRatioOutputs trace = [] ∧
      ∃ event, trace.getLast? = some event ∧ rationalEventError event = some error

/-- Unary Rational gcd preserves field and result provenance, alias handles,
call accounting, world sequencing, and the unique first exception for every
raw field pair and arbitrary effectful arithmetic dispatch. I, U and R may be
different dynamic carriers and may contain references into W. No normalized-
fraction, nonzero-denominator, callee-correctness or termination premise is
assumed. Divergence is allowed; completed executions must satisfy the same
invariants whether the selected ratio call succeeds or throws.

This property does not define an expected value by invoking either callback
again. It rejects swapped fields, duplicated/dropped calls, fabricated result
handles, discarded mutations and execution after a failure.

Julia source: base/intfuncs.jl:153; base/rational.jl:9-15 at
f755f49a9e41380d7da126b3c1db9fe7f83dd027.
Julia documentation: doc/src/manual/complex-and-rational-numbers.md:180-209,
283-303. -/
def GcdRationalOpenDispatchProvenance : Prop :=
  ∀ (W I U R : Type)
      (ops : RationalUnaryOps (JuliaLean.base.io.M W) I U R)
      (a : RationalStorage I) (world : W),
    match gcdUnaryRational (observeRationalUnaryOps ops) a (world, []) with
    | none => True
    | some (.ok (value, (final, trace))) =>
        RationalUnaryProvenance a trace ∧
        RationalUnaryWorldAccounting world final trace ∧
        RationalUnaryTerminal trace (.ok value)
    | some (.error (error, (final, trace))) =>
        RationalUnaryProvenance a trace ∧
        RationalUnaryWorldAccounting world final trace ∧
        RationalUnaryTerminal trace (.error error)

/-- A further concrete arithmetic invariant requires only the already
installed native checked_abs, not an assumed law for rational construction.
For every machine width and every raw numerator/denominator, the magnitude
delivered to // is the mathematical absolute numerator. If that magnitude is
unrepresentable, OverflowError occurs before // can run and the world is
unchanged. The ratio operation remains completely arbitrary, including
errors, mutation, heterogeneous results and divergence.

No rational positivity/normalization promise is inferred for arbitrary //.
On a representable numerator, a divergent ratio remains allowed; every
completed execution records the exact magnitude and one ratio call.

Julia source: base/intfuncs.jl:153; base/checked.jl:109-128 at
f755f49a9e41380d7da126b3c1db9fe7f83dd027.
Julia documentation: doc/src/manual/integers-and-floating-point-numbers.md:231-249.
-/
def GcdRationalNativeNumeratorGate : Prop :=
  ∀ (W R : Type) (t : IntTy)
      (ratio : JInt t → JInt t → JuliaLean.base.io.M W R)
      (a : RationalStorage (JInt t)) (world : W),
    let ops : RationalUnaryOps (JuliaLean.base.io.M W) (JInt t) (JInt t) R := {
      checkedAbs := fun input =>
        JuliaLean.base.io.liftJl (JuliaLean.base.checked.checkedAbsBits input)
      ratio := ratio }
    let observed := gcdUnaryRational (observeRationalUnaryOps ops) a (world, [])
    let magnitude : Int := a.num.val.natAbs
    if magnitude ≤ t.max then
      match observed with
      | none => True
      | some (.ok (_, (_, trace))) =>
          (rationalAbsoluteOutputs trace).map Subtype.val = [magnitude] ∧
          (rationalRatioInputs trace).map (fun input => input.1.val) = [magnitude] ∧
          (rationalRatioInputs trace).map Prod.snd = [a.den]
      | some (.error (_, (_, trace))) =>
          (rationalAbsoluteOutputs trace).map Subtype.val = [magnitude] ∧
          (rationalRatioInputs trace).map (fun input => input.1.val) = [magnitude] ∧
          (rationalRatioInputs trace).map Prod.snd = [a.den]
    else
      match observed with
      | some (.error (.jl (.overflowError _), (final, trace))) =>
          final = world ∧ (rationalRatioInputs trace).isEmpty = true ∧ trace.length = 1
      | _ => False

