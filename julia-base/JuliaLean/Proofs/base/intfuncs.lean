        · exact hbytes
        · exact hchar
      obtain ⟨out, hout, hbout⟩ := ih fuel q next
        (asciiDigit (decide (36 < base)) (o.value x % base).toNat :: tail)
        (by omega) (by rw [hqv]; exact Int.ediv_nonneg hx (by omega)) hnext
      refine ⟨out, ?_, ?_⟩
      · rw [baseLoop, if_neg (by omega), if_pos (by omega), hrem x hx]
        simp only [Bind.bind, Except.bind, hc, hq]
        have hi : boolInt neg + (k + 1 : Nat) - 1 = boolInt neg + k := by omega
        rw [hi]
        exact hout
      · rw [hbout, writtenDigits, hqv]
        simp only [List.append_assoc, List.singleton_append]


def decodeStep (base : Int) (n : Int) (ch : Nat) : Option Int := do
  let d ← digitValue base ch
  if 0 ≤ d ∧ d < (base.natAbs : Int) then some (n * base + d) else none

theorem decodeStep_ascii (base : Int) (d : Nat) (n : Int)
    (hb : 2 ≤ base) (hb62 : base ≤ 62) (hd : (d : Int) < base) :
    decodeStep base n (asciiDigit (decide (36 < base)) d) = some (n * base + d) := by
  have habs : (base.natAbs : Int) = base := Int.natAbs_of_nonneg (by omega)
  unfold decodeStep
  rw [asciiDigit_value base d hb hb62 hd]
  simp only [Bind.bind, Option.bind, habs]
  rw [if_pos ⟨Int.natCast_nonneg _, hd⟩]

theorem writtenDigits_decode (base : Int) (hb : 2 ≤ base) (hb62 : base ≤ 62)
    (k : Nat) (n seed : Int) (hn : 0 ≤ n) (hsize : n < base ^ k) :
    (writtenDigits base (decide (36 < base)) k n).foldlM (decodeStep base) seed =
      some (seed * base ^ k + n) := by
  induction k generalizing n seed with
  | zero =>
    have hn0 : n = 0 := by simp only [Int.pow_zero] at hsize; omega
    simp only [writtenDigits, List.foldlM_nil, Int.pow_zero, Int.mul_one, hn0, Int.add_zero, pure]
  | succ k ih =>
    have hq0 : 0 ≤ n / base := Int.ediv_nonneg hn (by omega)
    have hqlt : n / base < base ^ k := by
      apply (Int.ediv_lt_iff_lt_mul (by omega)).mpr
      simpa only [Int.pow_succ] using hsize
    have hr0 : 0 ≤ n % base := Int.emod_nonneg _ (by omega)
    have hrlt : n % base < base := Int.emod_lt_of_pos _ (by omega)
    have hr : ((n % base).toNat : Int) = n % base := Int.toNat_of_nonneg hr0
    rw [writtenDigits, List.foldlM_append, ih (n / base) seed hq0 hqlt]
    simp only [Bind.bind, Option.bind, List.foldlM_cons, List.foldlM_nil, pure]
    rw [decodeStep_ascii base _ _ hb hb62 (by omega)]
    simp only [Option.bind_some, hr]
    congr 1
    rw [Int.add_mul, Int.mul_assoc, ← Int.pow_succ]
    have heq := Int.ediv_mul_add_emod n base
    simp only [Nat.succ_eq_add_one]
    omega


theorem writtenDigits_ascii (base : Int) (hb : 2 ≤ base) (hb62 : base ≤ 62)
    (k : Nat) (n : Int) (hn : 0 ≤ n) :
    ∀ ch ∈ writtenDigits base (decide (36 < base)) k n, 48 ≤ ch := by
  induction k generalizing n with
  | zero => simp only [writtenDigits, List.not_mem_nil, false_implies, implies_true]
  | succ k ih =>
    intro ch hch
    rw [writtenDigits, List.mem_append] at hch
    rcases hch with hch | hch
    · exact ih (n / base) (Int.ediv_nonneg hn (by omega)) ch hch
    · have heq : ch = asciiDigit (decide (36 < base)) (n % base).toNat := by
        simpa only [List.mem_singleton] using hch
      rw [heq]
      apply (asciiDigit_table _ _ ?_).2.2.1
      have h0 : 0 ≤ n % base := Int.emod_nonneg _ (by omega)
      have hlt : n % base < base := Int.emod_lt_of_pos _ (by omega)
      by_cases hl : 36 < base <;> simp only [hl, decide_true, decide_false, ite_true,
        Bool.false_eq_true, ite_false] <;> omega

theorem writtenDigits_leading (base : Int) (hb : 2 ≤ base) (hb62 : base ≤ 62)
    (k : Nat) (n : Int) (hlo : base ^ k ≤ n) (hhi : n < base ^ (k + 1)) :
    (writtenDigits base (decide (36 < base)) (k + 1) n).head? ≠ some 48 := by
  induction k generalizing n with
  | zero =>
    have hn : 1 ≤ n := by simpa only [Int.pow_zero] using hlo
    have hnb : n < base := by simpa only [Nat.zero_add, Int.pow_one] using hhi
    have hmod : n % base = n := Int.emod_eq_of_lt (by omega) hnb
    simp only [writtenDigits, List.nil_append, List.head?_cons, hmod, ne_eq, Option.some.injEq]
    have hc := asciiDigit_table (decide (36 < base)) n.toNat (by
      by_cases hl : 36 < base <;> simp only [hl, decide_true, decide_false, ite_true,
        Bool.false_eq_true, ite_false] <;> omega)
    intro hzero
    have := hc.2.2.2.mp hzero
    omega
  | succ k ih =>
    have hql : base ^ k ≤ n / base := by
      apply (Int.le_ediv_iff_mul_le (by omega)).mpr
      simpa only [Int.pow_succ, Nat.succ_eq_add_one] using hlo
    have hqh : n / base < base ^ (k + 1) := by
      apply (Int.ediv_lt_iff_lt_mul (by omega)).mpr
      simpa only [Int.pow_succ, Nat.succ_eq_add_one] using hhi
    have hnonempty : writtenDigits base (decide (36 < base)) (k + 1) (n / base) ≠ [] := by
      intro he
      have he' := congrArg List.length he
      rw [writtenDigits_length] at he'
      simp only [List.length_nil] at he'
      omega
    rw [writtenDigits]
    have hlead := ih (n / base) hql hqh
    cases hd : writtenDigits base (decide (36 < base)) (k + 1) (n / base) with
    | nil => exact False.elim (hnonempty hd)
    | cons ch tail =>
      simpa only [hd, List.cons_append, List.head?_cons] using hlead

theorem writtenDigits_numeral (base : Int) (hb : 2 ≤ base) (hb62 : base ≤ 62)
    (k : Nat) (n : Int) (hn : 0 ≤ n) (hsize : n < base ^ k) :
    decodeNumeral base (writtenDigits base (decide (36 < base)) k n) = some n := by
  have hd : decodeUnsigned base (writtenDigits base (decide (36 < base)) k n) = some n := by
    have h := writtenDigits_decode base hb hb62 k n 0 hn hsize
    change (writtenDigits base (decide (36 < base)) k n).foldlM (decodeStep base) 0 = some n
    simpa only [Int.zero_mul, Int.zero_add] using h
  have hm := writtenDigits_ascii base hb hb62 k n hn
  cases he : writtenDigits base (decide (36 < base)) k n with
  | nil => simpa only [he, decodeNumeral] using hd
  | cons ch tail =>
    have hch : ch ≠ 45 := by
      have := hm ch (by rw [he]; exact List.mem_cons_self)
      omega
    simp only [he] at hd
    unfold decodeNumeral
    split
    · next rest heq =>
        have heq' : ch = 45 := (List.cons.inj heq).1
        exact False.elim (hch heq')
    · exact hd


theorem writtenDigits_representation (base n pad count : Int) (neg : Bool)
    (hb : 2 ≤ base) (hb62 : base ≤ 62) (hn : 0 ≤ n)
    (hneg : neg = false ∨ 0 < n) (hc : DigitCount n base pad count) :
    StringRepresentation (if neg then -n else n) base pad
      ((if neg then [45] else []) ++ writtenDigits base (decide (36 < base)) count.toNat n) := by
  have habs : (base.natAbs : Int) = base := Int.natAbs_of_nonneg (by omega)
  have hnabs : (n.natAbs : Int) = n := Int.natAbs_of_nonneg hn
  obtain ⟨hc0, hpc, hz, hnz⟩ := (show 0 ≤ count ∧ pad ≤ count ∧
      (n = 0 → count = max pad 0) ∧
      (n ≠ 0 → 1 ≤ count ∧ (n.natAbs : Int) < base ^ count.toNat ∧
        (pad < count → base ^ (count.toNat - 1) ≤ (n.natAbs : Int))) by
    simpa only [DigitCount, show 0 < base by omega, ite_true] using hc)
  have hcast : (count.toNat : Int) = count := Int.toNat_of_nonneg hc0
  have hsize : n < base ^ count.toNat := by
    by_cases hn0 : n = 0
    · rw [hn0]
      exact Int.pow_pos (by omega)
    · simpa only [hnabs] using (hnz hn0).2.1
  have hd : decodeUnsigned base (writtenDigits base (decide (36 < base)) count.toNat n) = some n := by
    change (writtenDigits base (decide (36 < base)) count.toNat n).foldlM (decodeStep base) 0 = some n
    simpa only [Int.zero_mul, Int.zero_add] using writtenDigits_decode base hb hb62 count.toNat n 0 hn hsize
  have hpadding : (max 0 pad).toNat ≤ count.toNat := by omega
  have hlead : (max 0 pad).toNat < count.toNat →
      (writtenDigits base (decide (36 < base)) count.toNat n).head? ≠ some 48 := by
    intro hp
    have hpad : pad < count := by omega
    have hn0 : n ≠ 0 := by
      intro hn0
      have hzero := hz hn0
      omega
    have hbound := (hnz hn0).2.2 hpad
    rw [hnabs] at hbound
    have hk : count.toNat - 1 + 1 = count.toNat := by have := (hnz hn0).1; omega
    have h := writtenDigits_leading base hb hb62 (count.toNat - 1) n hbound (by simpa only [hk] using hsize)
    simpa only [hk] using h
  have habs0 : 2 ≤ base.natAbs := by omega
  have habs62 : base.natAbs ≤ 62 := by omega
  cases neg with
  | false =>
    have hdn := writtenDigits_numeral base hb hb62 count.toNat n hn hsize
    simp only [Bool.false_eq_true, ite_false, List.nil_append]
    unfold StringRepresentation
    simp only [show base > 0 by omega, show ¬n < 0 by omega, and_false, ite_false,
      Nat.zero_add, writtenDigits_length, List.drop_zero]
    exact ⟨habs0, habs62, hdn, hpadding, hlead⟩
  | true =>
    have hnp : 0 < n := by rcases hneg with hbad | hnp; cases hbad; exact hnp
    simp only [ite_true, List.singleton_append]
    unfold StringRepresentation
    simp only [show base > 0 by omega, show -n < 0 by omega, and_self, ite_true,
      decodeNumeral, hd, Option.map_some, List.length_cons, writtenDigits_length,
      List.drop_succ_cons, List.drop_zero]
    refine ⟨habs0, habs62, rfl, ?_, ?_⟩
    · omega
    · intro hp
      apply hlead
      omega


theorem newBuffer_nonnegative (n : Int) (hn : 0 ≤ n) (hmax : n ≤ IntTy.max .u64) :
    newBuffer n = .ok ⟨List.replicate n.toNat 0, [], []⟩ := by
  have hmin : IntTy.min .u64 ≤ n := hn
  unfold newBuffer JInt.convert
  rw [dif_pos (show IntTy.min .u64 ≤ n ∧ n ≤ IntTy.max .u64 from ⟨hmin, hmax⟩)]
