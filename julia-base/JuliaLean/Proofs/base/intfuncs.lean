-- 4, 5, 6. Negative sign address properties (bin/oct, hex, dec)
private theorem store_minus_at_one {W V : Type} (ops : FormattingOps W V)
    (s : FormattingString) (w : FormattingWorld W) :
    ∃ after,
      formattingStore ops (.bytePointer s.data) (JuliaLean.base.int.lit .u8 0x2d)
        (.inl (JuliaLean.base.int.lit .i64 1)) w = some (.ok ((), (w.1, after))) ∧
      after.readByte s.data.address.val.toNat = JuliaLean.base.int.lit .u8 0x2d := by
  obtain ⟨after, hst, hread, _⟩ :=
    formattingNativeStoreFootprint_proven W V ops s.data
      (JuliaLean.base.int.lit .u8 0x2d) (JuliaLean.base.int.lit .i64 1) w
  have haddr : ((s.data.address.val + (JuliaLean.base.int.lit .i64 1).val - 1) % (2 ^ 64 : Int)).toNat =
      s.data.address.val.toNat := by
    have hprop := s.data.address.property
    change (0 : Int) ≤ s.data.address.val ∧ s.data.address.val ≤ 2 ^ 64 - 1 at hprop
    have h1 : (JuliaLean.base.int.lit .i64 1).val = 1 := rfl
    have heq : (s.data.address.val + (JuliaLean.base.int.lit .i64 1).val - 1) % (2 ^ 64 : Int) =
        s.data.address.val := by
      rw [h1]
      have : s.data.address.val + 1 - 1 = s.data.address.val := by omega
      rw [this]
      exact Int.emod_eq_of_lt hprop.1 (by omega)
    rw [heq]
  exact ⟨after, hst, haddr ▸ hread⟩

private def MinusAtStringAddress {W V : Type} :
    Option (Except (JuliaLean.base.io.Error × FormattingWorld W) (FormattingStringValue V × FormattingWorld W)) → Prop
  | some (.ok (.string result, (_, heap))) =>
      heap.readByte result.data.address.val.toNat = JuliaLean.base.int.lit .u8 0x2d
  | _ => True

private theorem sign_store_final {W V : Type} (ops : FormattingOps W V)
    (s : FormattingString) (w : FormattingWorld W) :
    MinusAtStringAddress (V := V) ((do
      formattingStore ops (.bytePointer s.data) (JuliaLean.base.int.lit .u8 0x2d) (.inl (JuliaLean.base.int.lit .i64 1))
      pure (FormattingStringValue.string s)) w) := by
  unfold MinusAtStringAddress
  simp only [io_bind2, io_pure2]
  obtain ⟨after, hst, hread⟩ := store_minus_at_one ops s w
  rw [hst]
  exact hread

private theorem bind_preserve_sign {W V β : Type}
    (m : JuliaLean.base.io.M (FormattingWorld W) β)
    (k : β → JuliaLean.base.io.M (FormattingWorld W) (FormattingStringValue V))
    (w : FormattingWorld W)
    (hk : ∀ b w', MinusAtStringAddress (k b w')) :
    MinusAtStringAddress ((m >>= k) w) := by
  unfold MinusAtStringAddress
  rw [io_bind2]
  cases m w with
  | none => trivial
  | some r =>
    cases r with
    | error _ => trivial
    | ok vw => exact hk vw.1 vw.2

private theorem other_return_sign {W V α : Type}
    (v : V) (m : JuliaLean.base.io.M (FormattingWorld W) α) (w : FormattingWorld W) :
    MinusAtStringAddress ((do let _ ← m; pure (FormattingStringValue.other v)) w) := by
  unfold MinusAtStringAddress
  simp only [io_bind2, io_pure2]
  cases m w with
  | none => trivial
  | some r => cases r <;> trivial
private theorem formattingPointer_string_preserve_sign {W V : Type} (ops : FormattingOps W V)
    (s : FormattingString)
    (k : FormattingPointer V → JuliaLean.base.io.M (FormattingWorld W) (FormattingStringValue V))
    (w : FormattingWorld W)
    (hk : MinusAtStringAddress (k (.bytePointer s.data) w)) :
    MinusAtStringAddress ((formattingPointer ops (.string s) >>= k) w) :=
  hk

