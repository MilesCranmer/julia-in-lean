def IsPow2Terminal {V Count Other : Type} (select : V → IsPow2Route)
    (trace : List (IsPow2Event V Count Other)) :
    Except JuliaLean.base.io.Error (Pow2BoolResult Other) → Prop
  | .ok result => trace.filterMap ispow2EventError = [] ∧
      match trace.getLast? with
      | some (.realTest _ (.ok false)) => result = .boolean false
      | some (.greater _ _ (.ok false)) => result = .boolean false
      | some (.equal _ _ (.ok value)) => result = value
      | some (.custom _ (.ok value)) => result = value
      | _ => False
  | .error error =>
      (trace.filterMap ispow2EventError = [error] ∧
        ∃ event, trace.getLast? = some event ∧ ispow2EventError event = some error) ∨
      (trace.filterMap ispow2EventError = [] ∧ error = .jl (.methodError "ispow2") ∧
        ∃ argument value, trace.getLast? = some (.real argument (.ok value)) ∧ select value = .noMethod)

/-- Universal effectful Number fallback invariant, including arbitrary depth
of self-recursion, unknown returned types, custom dispatch and first errors.
The real Integer helper is invoked on its selected route.
Julia source: base/intfuncs.jl:622,624. -/
def IsPow2NumberOpenAccounting : Prop :=
  ∀ (W V Count Other : Type) (ops : IsPow2NumberOps W V Count Other)
      (x : V) (world : W),
    match ispow2Number (observeIsPow2NumberOps ops) x (world, []) with
    | none => True
    | some (.ok (value, (_, trace))) =>
        IsPow2CallInvariant x trace ∧ IsPow2Terminal ops.select trace (.ok value)
    | some (.error (error, (_, trace))) =>
        IsPow2CallInvariant x trace ∧ IsPow2Terminal ops.select trace (.error error)

/-- Universal Integer short-circuit, literal and operand provenance invariant
with dynamic non-Bool final results and arbitrary mutable state.
Julia source: base/intfuncs.jl:624. -/
def IsPow2IntegerOpenAccounting : Prop :=
  ∀ (W V Count Other : Type)
      (ops : IsPow2IntegerOps (JuliaLean.base.io.M W) V Count Other)
      (x : V) (world : W),
    match ispow2Integer (observeIsPow2IntegerOps ops) x (world, []) with
    | none => True
    | some (.ok (value, (_, trace))) =>
        IsPow2CallInvariant x trace ∧ IsPow2Terminal (fun _ => .integer) trace (.ok value)
    | some (.error (error, (_, trace))) =>
        IsPow2CallInvariant x trace ∧ IsPow2Terminal (fun _ => .integer) trace (.error error)

