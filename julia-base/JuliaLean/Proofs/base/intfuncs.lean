/-! Observation/specification machinery, not new Julia callees. Actual dispatch
results are recorded without constraining them or their private world. -/

/-- A completed call, including a call that throws. Its arguments and returned
values are observations, not correctness assumptions. -/
inductive GcdEvent (V : Type) where
  | test (value : V) (zero : JInt64)
      (result : Except JuliaLean.base.io.Error Bool)
  | remainder (dividend divisor : V)
      (result : Except JuliaLean.base.io.Error V)
  | absolute (value : V) (result : Except JuliaLean.base.io.Error V)

/-- Generic instrumentation: append a completed-call event, retaining the
selected action's value, error, state change or divergence exactly. -/
def recordCall {W E A : Type}
    (event : Except JuliaLean.base.io.Error A → E)
    (action : JuliaLean.base.io.M W A) :
    JuliaLean.base.io.M (W × List E) A := fun (world, trace) =>
  match action world with
  | none => none
  | some (.error (error, nextWorld)) =>
      some (.error (error, (nextWorld, trace ++ [event (.error error)])))
  | some (.ok (value, nextWorld)) =>
      some (.ok (value, (nextWorld, trace ++ [event (.ok value)])))

/-- Observe the three open leaves of base/intfuncs.jl:44-51. Each field calls
the original selected operation exactly once. -/
def observeGcdOps {W V : Type} (ops : GcdOps W V) :
    GcdOps (W × List (GcdEvent V)) V where
  notEqualZero value zero :=
    recordCall (.test value zero) (ops.notEqualZero value zero)
  rem dividend divisor :=
    recordCall (.remainder dividend divisor) (ops.rem dividend divisor)
  checkedAbs value :=
    recordCall (.absolute value) (ops.checkedAbs value)

def gcdTestInputs {V : Type} (trace : List (GcdEvent V)) : List V :=
  trace.filterMap fun event => match event with
    | .test value _ _ => some value
    | _ => none

def gcdRemainderInputs {V : Type} (trace : List (GcdEvent V)) : List (V × V) :=
  trace.filterMap fun event => match event with
    | .remainder dividend divisor _ => some (dividend, divisor)
    | _ => none

def gcdRemainderOutputs {V : Type} (trace : List (GcdEvent V)) : List V :=
  trace.filterMap fun event => match event with
    | .remainder _ _ (.ok value) => some value
    | _ => none

def gcdAbsoluteInputs {V : Type} (trace : List (GcdEvent V)) : List V :=
  trace.filterMap fun event => match event with
    | .absolute value _ => some value
    | _ => none

def gcdAbsoluteOutputs {V : Type} (trace : List (GcdEvent V)) : List V :=
  trace.filterMap fun event => match event with
    | .absolute _ (.ok value) => some value
    | _ => none

def gcdEventError {V : Type} : GcdEvent V → Option JuliaLean.base.io.Error
  | .test _ _ (.error error) => some error
  | .remainder _ _ (.error error) => some error
  | .absolute _ (.error error) => some error
  | _ => none

/-- Independent accounting and operand provenance of a completed execution.
These do not replay the loop or prescribe any selected callee's result.
Previous divisors become subsequent dividends; tested values originate in the
initial divisor and actual remainder results. A final absolute-value call is
unique and uses the most recent dividend.
Source invariant: base/intfuncs.jl:44-51. -/
def GcdTraceInvariant {V : Type} (a b : V) (trace : List (GcdEvent V)) : Prop :=
  let tests := gcdTestInputs trace
  let remainders := gcdRemainderInputs trace
  let absolutes := gcdAbsoluteInputs trace
  remainders.length ≤ tests.length ∧
  tests.length ≤ remainders.length + 1 ∧
  absolutes.length ≤ 1 ∧
  tests = (b :: gcdRemainderOutputs trace).take tests.length ∧
  remainders.map Prod.fst = (a :: remainders.map Prod.snd).take remainders.length ∧
  remainders.map Prod.snd = tests.take remainders.length ∧
  (∀ value zero result, GcdEvent.test value zero result ∈ trace → zero.val = 0) ∧
  (∀ value result, GcdEvent.absolute value result ∈ trace →
    trace.getLast? = some (.absolute value result) ∧
    (a :: remainders.map Prod.snd).getLast? = some value)

/-- A returned value has exactly one actual successful absolute-value origin;
a propagated exception is the unique logged failure and belongs to the final
call. No equation specifies a dispatch operation's implementation.
Source invariant: base/intfuncs.jl:44-51. -/
def GcdTerminalInvariant {V : Type} (trace : List (GcdEvent V)) :
    Except JuliaLean.base.io.Error V → Prop
  | .ok value =>
      gcdAbsoluteOutputs trace = [value] ∧
      trace.filterMap gcdEventError = [] ∧
      (gcdTestInputs trace).length = (gcdRemainderInputs trace).length + 1
  | .error error =>
      trace.filterMap gcdEventError = [error] ∧
      ∃ event, trace.getLast? = some event ∧ gcdEventError event = some error

