inductive DigitCall where
  | notEqual | negBase | floorDiv | signed | neg | ceilDiv
  | initialZero | toInt | absolute | baseEqual | ispow2 | trailingZeros | divrem
  | indexedFirst | indexedSecond | iszero | addOne | greaterMax | divide | lessEqual | multiply
  | lessBase | greaterBase | negativeOverride | positiveOverride | topZero | topExponent | topAdd
  deriving BEq, DecidableEq

inductive DigitAtom (C Pair State : Type) where
  | value (value : DigitValue C)
  | native (value : JInt64)
  | boolean (value : Bool)
  | pair (value : Pair)
  | state (value : State)
  | iteration (value : DigitValue C) (state : State)

structure DigitEvent (W C Pair State : Type) where
  call : DigitCall
  arguments : List (DigitAtom C Pair State)
  before : W
  outcome : Except JuliaLean.base.io.Error (DigitAtom C Pair State)
  after : W

/-- Observe the action once, including its actual before/after world and error. -/
def digitObserve {W C Pair State R : Type} (call : DigitCall) (arguments : List (DigitAtom C Pair State))
    (encode : R → DigitAtom C Pair State) (action : JuliaLean.base.io.M W R) :
    JuliaLean.base.io.M (W × List (DigitEvent W C Pair State)) R :=
  fun (world, trace) => match action world with
  | none => none
  | some (.ok (result, next)) =>
      some (.ok (result, (next, trace ++ [⟨call, arguments, world, .ok (encode result), next⟩])))
  | some (.error (error, next)) =>
      some (.error (error, (next, trace ++ [⟨call, arguments, world, .error error, next⟩])))

/-- Keep the concrete global table in its real world position. It is neither
copied into a frozen model parameter nor replaced by a callback. Selected
calls can mutate it before the actual decimal method reads it. -/
def digitObserveDecimal {W C Pair State R : Type} (call : DigitCall)
    (arguments : List (DigitAtom C Pair State)) (encode : R → DigitAtom C Pair State)
    (action : JuliaLean.base.io.M (DecimalWorld W) R) :
    JuliaLean.base.io.M (DecimalWorld (W × List (DigitEvent (DecimalWorld W) C Pair State))) R :=
  fun ((world, trace), table) => match action (world, table) with
  | none => none
  | some (.ok (result, (next, nextTable))) =>
      some (.ok (result, ((next, trace ++ [⟨call, arguments, (world, table),
        .ok (encode result), (next, nextTable)⟩]), nextTable)))
  | some (.error (error, (next, nextTable))) =>
      some (.error (error, ((next, trace ++ [⟨call, arguments, (world, table),
        .error error, (next, nextTable)⟩]), nextTable)))

def digitCalls {W C P S : Type} (call : DigitCall) (trace : List (DigitEvent W C P S)) :=
  trace.filter (fun event => event.call == call)
def digitOutputs {W C P S : Type} (call : DigitCall) (trace : List (DigitEvent W C P S)) :=
  (digitCalls call trace).filterMap (fun event => event.outcome.toOption)
def digitValues {W C P S : Type} (call : DigitCall) (trace : List (DigitEvent W C P S)) : List (DigitValue C) :=
  (digitOutputs call trace).filterMap fun result => match result with | .value value => some value | _ => none
def digitBooleans {W C P S : Type} (call : DigitCall) (trace : List (DigitEvent W C P S)) : List Bool :=
  (digitOutputs call trace).filterMap fun result => match result with | .boolean value => some value | _ => none
def digitPairs {W C P S : Type} (call : DigitCall) (trace : List (DigitEvent W C P S)) : List P :=
  (digitOutputs call trace).filterMap fun result => match result with | .pair value => some value | _ => none
def digitIterations {W C P S : Type} (call : DigitCall) (trace : List (DigitEvent W C P S)) : List (DigitValue C × S) :=
  (digitOutputs call trace).filterMap fun result => match result with | .iteration value state => some (value, state) | _ => none
def digitErrors {W C P S : Type} (trace : List (DigitEvent W C P S)) : List JuliaLean.base.io.Error :=
  trace.filterMap fun event => match event.outcome with | .error error => some error | _ => none

def DigitWorldAccounting {W C P S : Type} (initial final : W) (trace : List (DigitEvent W C P S)) : Prop :=
  trace.map DigitEvent.before = (initial :: trace.map DigitEvent.after).take trace.length ∧
  final = ((trace.getLast?).map DigitEvent.after).getD initial

def DigitSelectedError {W C P S : Type} (trace : List (DigitEvent W C P S)) (error : JuliaLean.base.io.Error) : Prop :=
  digitErrors trace = [error] ∧ ∃ event, trace.getLast? = some event ∧ event.outcome = .error error

def DigitDecimalExecution {W C P S : Type}
    (action : JuliaLean.base.io.M (DecimalWorld (W × List (DigitEvent (DecimalWorld W) C P S))) (DigitValue C))
    (world : W) (table : DecimalTable) (invariant : List (DigitEvent (DecimalWorld W) C P S) → Prop)
    (terminal : List (DigitEvent (DecimalWorld W) C P S) → Except JuliaLean.base.io.Error (DigitValue C) → Prop) : Prop :=
  match action ((world, []), table) with
  | none => True
  | some (.ok (result, ((final, trace), finalTable))) =>
      invariant trace ∧ DigitWorldAccounting (world, table) (final, finalTable) trace ∧ terminal trace (.ok result)
  | some (.error (error, ((final, trace), finalTable))) =>
      invariant trace ∧ DigitWorldAccounting (world, table) (final, finalTable) trace ∧ terminal trace (.error error)

def observeDigitNegativeOps {W C P S : Type} (ops : DigitNegativeOps W C) :
    DigitNegativeOps (W × List (DigitEvent (DecimalWorld W) C P S)) C where
  notEqual x zero := digitObserveDecimal .notEqual [.value x, .native zero] .boolean (ops.notEqual x zero)
  negBase b := digitObserveDecimal .negBase [.value b] .value (ops.negBase b)
  floorDiv x b := digitObserveDecimal .floorDiv [.value x, .value b] .value (ops.floorDiv x b)
  signed x := digitObserveDecimal .signed [.value x] .value (ops.signed x)
  neg x := digitObserveDecimal .neg [.value x] .value (ops.neg x)
  ceilDiv x b := digitObserveDecimal .ceilDiv [.value x, .value b] .value (ops.ceilDiv x b)

def digitNegativeCurrent {W C P S : Type} (original : DigitValue C) (trace : List (DigitEvent W C P S)) : DigitValue C :=
  ((digitValues .ceilDiv trace).getLast?).getD (((digitValues .neg trace).head?).getD original)

def DigitNegativeCausal {W C P S : Type} (x b : DigitValue C)
    (before : List (DigitEvent W C P S)) (event : DigitEvent W C P S) : Prop :=
  match event.call with
  | .notEqual => event.arguments = [.value (digitNegativeCurrent x before), .native (JuliaLean.base.int.lit .i64 0)]
  | .negBase => digitIsUnsigned x = true ∧ event.arguments = [.value b] ∧
      ∃ nonzero, digitBooleans .notEqual before = [nonzero]
  | .floorDiv => ∃ negativeBase, digitValues .negBase before = [negativeBase] ∧ event.arguments = [.value x, .value negativeBase]
  | .signed => ∃ quotient, digitValues .floorDiv before = [quotient] ∧ event.arguments = [.value quotient]
  | .neg => ∃ signed, digitValues .signed before = [signed] ∧ event.arguments = [.value signed]
  | .ceilDiv => (digitBooleans .notEqual before).getLast? = some true ∧
      event.arguments = [.value (digitNegativeCurrent x before), .value b]
  | _ => False

/-- Count equals the number of completed ceil divisions plus the actual
initial unsigned Bool contribution, reduced modulo native Int64 arithmetic. -/
def DigitNegativeTerminal {W C P S : Type} (x : DigitValue C) (trace : List (DigitEvent W C P S)) :
    Except JuliaLean.base.io.Error (DigitValue C) → Prop
  | .error error => DigitSelectedError trace error
  | .ok result => digitErrors trace = [] ∧ ∃ count event,
      result = .native .i64 count ∧ trace.getLast? = some event ∧
      event.call = .notEqual ∧ event.outcome = .ok (.boolean false) ∧
      count.val = (JInt.wrap .i64 ((digitValues .ceilDiv trace).length +
        (if digitIsUnsigned x && ((digitBooleans .notEqual trace).head?.getD false) then 1 else 0))).val

/-- Arbitrary selected operations preserve all data origins and initial
assertion order, original base identity, actual state/error transitions and
native count accounting. No numerical or termination law is assumed.
Julia source: base/intfuncs.jl:746-758. -/
def DigitNegativeOpenInvariant : Prop :=
  ∀ (W C : Type) (ops : DigitNegativeOps W C) (x b : DigitValue C) (world : W) (table : DecimalTable),
    DigitDecimalExecution (digitsNegative (observeDigitNegativeOps (P := Unit) (S := Unit) ops) x b) world table
      (fun trace => 1 ≤ (digitCalls .notEqual trace).length ∧
        (∀ call, call ∈ [DigitCall.negBase, .floorDiv, .signed, .neg] → (digitCalls call trace).length ≤ 1) ∧
        (∀ before event after, trace = before ++ event :: after → DigitNegativeCausal x b before event))
      (DigitNegativeTerminal x)

def observeDigitPositiveOps {W C P S : Type} (ops : DigitPositiveOps W C P S) :
    DigitPositiveOps (W × List (DigitEvent (DecimalWorld W) C P S)) C P S where
  initialZero x zero := digitObserveDecimal .initialZero [.value x, .native zero] .boolean (ops.initialZero x zero)
  toInt b := digitObserveDecimal .toInt [.value b] .value (ops.toInt b)
  abs x := digitObserveDecimal .absolute [.value x] .value (ops.abs x)
  baseEqual b literal := digitObserveDecimal .baseEqual [.value b, .native literal] .boolean (ops.baseEqual b literal)
  ispow2 b := digitObserveDecimal .ispow2 [.value b] .boolean (ops.ispow2 b)
  trailingZeros b := digitObserveDecimal .trailingZeros [.value b] .value (ops.trailingZeros b)
  divrem top zeros := digitObserveDecimal .divrem [.native top, .value zeros] .pair (ops.divrem top zeros)
  indexedFirst pair index := digitObserveDecimal .indexedFirst [.pair pair, .native index]
    (fun (value, state) => .iteration value state) (ops.indexedFirst pair index)
  indexedSecond pair index state := digitObserveDecimal .indexedSecond [.pair pair, .native index, .state state]
    .value (ops.indexedSecond pair index state)
  iszero x := digitObserveDecimal .iszero [.value x] .boolean (ops.iszero x)
  addOne x one := digitObserveDecimal .addOne [.value x, .native one] .value (ops.addOne x one)
  greaterMax x maximum := digitObserveDecimal .greaterMax [.value x, .native maximum] .boolean (ops.greaterMax x maximum)
  divide x b := digitObserveDecimal .divide [.value x, .value b] .value (ops.divide x b)
  lessEqual m x := digitObserveDecimal .lessEqual [.value m, .value x] .boolean (ops.lessEqual m x)
  multiply m b := digitObserveDecimal .multiply [.value m, .value b] .value (ops.multiply m b)

def digitPositiveNormalized {W C P S : Type} (trace : List (DigitEvent W C P S)) : Option (DigitValue C) :=
  (digitValues .absolute trace).head?.map fun value => match value with
    | .native _ value => digitUnsignedValue (digitUnsignedOfBits value)
    | other => other

def digitPositiveCurrent {W C P S : Type} (trace : List (DigitEvent W C P S)) : Option (DigitValue C) :=
  ((digitValues .divide trace).getLast?).orElse (fun _ => digitPositiveNormalized trace)

def digitMultiplierCurrent {W C P S : Type} (trace : List (DigitEvent W C P S)) : DigitValue C :=
  ((digitValues .multiply trace).getLast?).getD (.native .i64 (JuliaLean.base.int.lit .i64 1))

def DigitPositiveCausal {W C P S : Type} (x b : DigitValue C)
    (before : List (DigitEvent W C P S)) (event : DigitEvent W C P S) : Prop :=
  match event.call with
  | .initialZero => before = [] ∧ event.arguments = [.value x, .native (JuliaLean.base.int.lit .i64 0)]
  | .toInt => digitBooleans .initialZero before = [false] ∧ event.arguments = [.value b]
  | .absolute => (∃ convertedBase, digitValues .toInt before = [convertedBase]) ∧ event.arguments = [.value x]
  | .baseEqual => ∃ convertedBase type value literal,
      digitValues .toInt before = [convertedBase] ∧ digitValues .absolute before = [.native type value] ∧
      ([2,8,16,10] : List Int)[(digitCalls .baseEqual before).length]? = some literal ∧
      digitBooleans .baseEqual before = List.replicate (digitCalls .baseEqual before).length false ∧
      event.arguments = [.value convertedBase, .native (JuliaLean.base.int.lit .i64 literal)]
  | .ispow2 => ∃ convertedBase, digitValues .toInt before = [convertedBase] ∧
      digitBooleans .baseEqual before = [false,false,false,false] ∧ event.arguments = [.value convertedBase]
  | .trailingZeros => ∃ convertedBase, digitValues .toInt before = [convertedBase] ∧
      digitBooleans .ispow2 before = [true] ∧ event.arguments = [.value convertedBase]
  | .divrem => ∃ type value zeros,
      digitValues .absolute before = [.native type value] ∧ digitValues .trailingZeros before = [zeros] ∧
      event.arguments = [.native (digitUnsignedNative JuliaLean.base.int.top_set_bit (digitUnsignedOfBits value)), .value zeros]
  | .indexedFirst => ∃ pair, digitPairs .divrem before = [pair] ∧
      event.arguments = [.pair pair, .native (JuliaLean.base.int.lit .i64 1)]
  | .indexedSecond => ∃ pair quotient state,
      digitPairs .divrem before = [pair] ∧ digitIterations .indexedFirst before = [(quotient,state)] ∧
      event.arguments = [.pair pair, .native (JuliaLean.base.int.lit .i64 2), .state state]
  | .iszero => ∃ remainder, digitValues .indexedSecond before = [remainder] ∧ event.arguments = [.value remainder]
  | .addOne => ∃ quotient state, digitIterations .indexedFirst before = [(quotient,state)] ∧
      digitBooleans .iszero before = [false] ∧ event.arguments = [.value quotient, .native (JuliaLean.base.int.lit .i64 1)]
  | .greaterMax => ∃ current, digitPositiveCurrent before = some current ∧
      event.arguments = [.value current, .native (JuliaLean.base.int.typemax .i64)]
  | .divide => ∃ current convertedBase, digitPositiveCurrent before = some current ∧
      digitValues .toInt before = [convertedBase] ∧ event.arguments = [.value current, .value convertedBase]
  | .lessEqual => ∃ reduced, (digitValues .divide before).getLast? = some reduced ∧
      event.arguments = [.value (digitMultiplierCurrent before), .value reduced]
  | .multiply => ∃ convertedBase, digitValues .toInt before = [convertedBase] ∧
      (digitBooleans .lessEqual before).getLast? = some true ∧
      event.arguments = [.value (digitMultiplierCurrent before), .value convertedBase]
  | _ => False

def DigitDecimalBoundsError {W C P S : Type} (trace : List (DigitEvent W C P S)) (error : JuliaLean.base.io.Error) : Prop :=
  digitErrors trace = [] ∧ error = .jl .boundsError ∧ ∃ event b,
    trace.getLast? = some event ∧ event.call = .baseEqual ∧ event.outcome = .ok (.boolean true) ∧
    event.arguments = [.value b, .native (JuliaLean.base.int.lit .i64 10)]

/-- Mathematical minimal positional numeral length, independent of the
implemented bit algorithms or arbitrary selected operations. -/
def DigitMathematicalCount (magnitude base count : Nat) : Prop :=
  if magnitude = 0 then count = 0
  else 0 < count ∧ base ^ (count - 1) ≤ magnitude ∧ magnitude < base ^ count

/-- Native fast branches count the unsigned residue of the actual returned
abs value. Bases 2/8/16 are exact. The mutable decimal-table correction can
change the mathematical decimal length by at most one. No constructor,
absolute-value or base-comparison law is assumed. -/
def DigitNativeFastCount {W C P S : Type} (trace : List (DigitEvent W C P S))
    (event : DigitEvent W C P S) (count : JInt64) : Prop :=
  ∃ type sourceValue base literal,
    digitValues .absolute trace = [.native type sourceValue] ∧
    event.arguments = [.value base, .native literal] ∧
    let magnitude := (sourceValue.val % ((2 : Int) ^ type.bits)).toNat
    if literal.val = 10 then
      ∃ expected, DigitMathematicalCount magnitude 10 expected ∧
        (count.val - (expected : Int)).natAbs ≤ 1
    else (literal.val = 2 ∨ literal.val = 8 ∨ literal.val = 16) ∧
      DigitMathematicalCount magnitude literal.val.toNat count.val.toNat

/-- Successful loop counts are native wrapping sums of completed divisions
and multiplications. Closed native fast paths stay in the full 0..128 bit
range, give exact mathematical lengths in bases 2/8/16, and stay within
one of decimal length even for an arbitrarily modified live decimal table. The generic
power-of-two route returns the observed quotient or selected +1 result. -/
def DigitPositiveTerminal {W C P S : Type} (trace : List (DigitEvent W C P S)) :
    Except JuliaLean.base.io.Error (DigitValue C) → Prop
  | .error error => DigitSelectedError trace error ∨ DigitDecimalBoundsError trace error
  | .ok result => digitErrors trace = [] ∧ ∃ event,
      trace.getLast? = some event ∧
      ((event.call = .initialZero ∧ event.outcome = .ok (.boolean true) ∧
          result = .native .i64 (JuliaLean.base.int.lit .i64 0)) ∨
       (event.call = .baseEqual ∧ event.outcome = .ok (.boolean true) ∧
          ∃ count, result = .native .i64 count ∧ 0 ≤ count.val ∧ count.val ≤ 128 ∧
            DigitNativeFastCount trace event count) ∨
       (event.call = .iszero ∧ event.outcome = .ok (.boolean true) ∧
          ∃ state, digitIterations .indexedFirst trace = [(result,state)]) ∨
       (event.call = .addOne ∧ event.outcome = .ok (.value result)) ∨
       (event.call = .lessEqual ∧ event.outcome = .ok (.boolean false) ∧
          ∃ count, result = .native .i64 count ∧
            count.val = (JInt.wrap .i64 ((digitValues .divide trace).length + (digitValues .multiply trace).length)).val ∧
            (digitValues .divide trace).length = (digitBooleans .greaterMax trace).count true + 1 ∧
            (digitBooleans .greaterMax trace).count false = 1 ∧
            (digitValues .multiply trace).length = (digitBooleans .lessEqual trace).count true ∧
            (digitBooleans .lessEqual trace).count false = 1))

def DigitPositiveBudget {W C P S : Type} (trace : List (DigitEvent W C P S)) : Prop :=
  (digitCalls .initialZero trace).length = 1 ∧ (digitCalls .baseEqual trace).length ≤ 4 ∧
  (∀ call, call ∈ [DigitCall.toInt, .absolute, .ispow2, .trailingZeros, .divrem,
    .indexedFirst, .indexedSecond, .iszero, .addOne] → (digitCalls call trace).length ≤ 1)

/-- Full dynamic positive-base domain, with live global table worlds,
constructor/type changes, iterator effects, two unbounded source loops,
native counters, causality, branch bounds and first failures. There are no
normalization, arithmetic, purity or termination assumptions on callees.
Julia source: base/intfuncs.jl:764-796. -/
def DigitPositiveOpenInvariant : Prop :=
  ∀ (W C P S : Type) (ops : DigitPositiveOps W C P S) (x b : DigitValue C) (world : W) (table : DecimalTable),
    DigitDecimalExecution (digitsPositive (observeDigitPositiveOps ops) x b) world table
      (fun trace => DigitPositiveBudget trace ∧
        ∀ before event after, trace = before ++ event :: after → DigitPositiveCausal x b before event)
      DigitPositiveTerminal

def observeDigitDispatchOps {W C P S : Type} (ops : DigitDispatchOps W C P S) :
    DigitDispatchOps (W × List (DigitEvent (DecimalWorld W) C P S)) C P S where
  negative := observeDigitNegativeOps ops.negative
  positive := observeDigitPositiveOps ops.positive
  selectNegative := fun x b => match ops.selectNegative x b with
    | .base => .base
    | .custom callee => .custom (fun x b => digitObserveDecimal .negativeOverride [.value x,.value b] .value (callee x b))
  selectPositive := fun x b => match ops.selectPositive x b with
    | .base => .base
    | .custom callee => .custom (fun x b => digitObserveDecimal .positiveOverride [.value x,.value b] .value (callee x b))
  lessBase b minusOne := digitObserveDecimal .lessBase [.value b,.native minusOne] .boolean (ops.lessBase b minusOne)
  greaterBase b one := digitObserveDecimal .greaterBase [.value b,.native one] .boolean (ops.greaterBase b one)

def digitNegativeCall (call : DigitCall) : Bool :=
  [DigitCall.notEqual, .negBase, .floorDiv, .signed, .neg, .ceilDiv].contains call
def digitPositiveCall (call : DigitCall) : Bool :=
  [DigitCall.initialZero, .toInt, .absolute, .baseEqual, .ispow2, .trailingZeros, .divrem,
   .indexedFirst, .indexedSecond, .iszero, .addOne, .greaterMax, .divide, .lessEqual, .multiply].contains call

def DigitDispatchCausal {W C P S : Type} (decimal : Bool) (x b : DigitValue C)
    (before : List (DigitEvent W C P S)) (event : DigitEvent W C P S) : Prop :=
  if digitNegativeCall event.call then
    decimal = false ∧ digitBooleans .lessBase before = [true] ∧
      DigitNegativeCausal x b (before.filter (fun e => digitNegativeCall e.call)) event
  else if digitPositiveCall event.call then
    (decimal = true ∨ (digitBooleans .lessBase before = [false] ∧ digitBooleans .greaterBase before = [true])) ∧
      DigitPositiveCausal x b (before.filter (fun e => digitPositiveCall e.call)) event
  else match event.call with
    | .lessBase => decimal = false ∧ before = [] ∧ event.arguments = [.value b,.native (JuliaLean.base.int.lit .i64 (-1))]
    | .greaterBase => decimal = false ∧ digitBooleans .lessBase before = [false] ∧
        event.arguments = [.value b,.native (JuliaLean.base.int.lit .i64 1)]
    | .negativeOverride => decimal = false ∧ digitBooleans .lessBase before = [true] ∧ event.arguments = [.value x,.value b]
    | .positiveOverride => (decimal = true ∨ (digitBooleans .lessBase before = [false] ∧ digitBooleans .greaterBase before = [true])) ∧
        event.arguments = [.value x,.value b]
    | _ => False

def DigitDispatchTerminal {W C P S : Type} (x : DigitValue C) (trace : List (DigitEvent W C P S)) :
    Except JuliaLean.base.io.Error (DigitValue C) → Prop
  | .error error => DigitSelectedError trace error ∨ DigitDecimalBoundsError trace error ∨
      (digitErrors trace = [] ∧ error = .jl (.domainError "The base must not be in `[-1, 0, 1]`.") ∧
        ∃ event, trace.getLast? = some event ∧ event.call = .greaterBase ∧ event.outcome = .ok (.boolean false))
  | .ok result => DigitNegativeTerminal x trace (.ok result) ∨ DigitPositiveTerminal trace (.ok result) ∨
      (digitErrors trace = [] ∧ ∃ event, trace.getLast? = some event ∧
        (event.call = .negativeOverride ∨ event.call = .positiveOverride) ∧ event.outcome = .ok (.value result)) ∨
      (digitErrors trace = [] ∧ ∃ value, x = .boolean value ∧
        result = .native .i64 (JuliaLean.base.int.ofBool .i64 value))

/-- The outer base selector and fixed-ten decimal wrapper retain original
argument identities, exact native literals and first errors. Default routes
execute the real negative/positive/Bool models; selected overrides alone are
parameters. Their internal observations retain every causal invariant.
Julia source: base/intfuncs.jl:741,829-838. -/
def DigitDispatchAndDecimalInvariant : Prop :=
  ∀ (W C P S : Type) (ops : DigitDispatchOps W C P S) (decimal : Bool)
      (x originalBase : DigitValue C) (world : W) (table : DecimalTable),
    let base := if decimal then DigitValue.native .i64 (JuliaLean.base.int.lit .i64 10) else originalBase
    let observed := observeDigitDispatchOps ops
    DigitDecimalExecution (if decimal then digitsDecimal observed x else digitsZero observed x originalBase) world table
      (fun trace =>
        (digitCalls .lessBase trace).length = (if decimal then 0 else 1) ∧
        (digitCalls .greaterBase trace).length ≤ 1 ∧
        (digitCalls .negativeOverride trace).length + (digitCalls .positiveOverride trace).length ≤ 1 ∧
        (∀ before event after, trace = before ++ event :: after → DigitDispatchCausal decimal x base before event))
      (DigitDispatchTerminal x)

/-- Both installed Bool methods cover every base argument, including invalid
bases: their result is a native 0/1 with the same Boolean value. This narrower
internal invariant needs no base-validity precondition and is independent of
the numeral-length definition. Julia source: base/intfuncs.jl:761,798. -/
def DigitBoolNativeRange : Prop :=
  ∀ (B : Type) (value : Bool) (base : B),
    ∀ count ∈ [JuliaLean.base.intfuncs.ndigitsNegative_Bool value base,
      JuliaLean.base.intfuncs.ndigitsPositive_Bool value base],
      0 ≤ count.val ∧ count.val ≤ 1 ∧ (count.val = 0 ↔ value = false) ∧ (count.val = 1 ↔ value = true)

def observeDigitTopOps {W C : Type} (ops : DigitTopBitOps W C) :
    DigitTopBitOps (W × List (DigitEvent W C Unit Unit)) C where
  iszero x := digitObserve .topZero [.value x] .boolean (ops.iszero x)
  exponent x := digitObserve .topExponent [.value x] .value (ops.exponent x)
  add exponent one := digitObserve .topAdd [.value exponent,.native one] .value (ops.add exponent one)

/-- Generic top-bit preserves conditional short circuit, original operand,
actual exponent result and native increment literal, arbitrary resulting
type, mutable worlds and first errors. No mathematical exponent law is
assumed for custom Integer types. Julia source: base/intfuncs.jl:842. -/
def DigitTopBitOpenInvariant : Prop :=
  ∀ (W C : Type) (ops : DigitTopBitOps W C) (x : DigitValue C) (world : W),
    match digitTopSetBit (observeDigitTopOps ops) x (world, []) with
    | none => True
    | some result =>
      let (outcome, final, trace) := match result with
        | .ok (value, (final, trace)) => (Except.ok value, final, trace)
        | .error (error, (final, trace)) => (Except.error error, final, trace)
      DigitWorldAccounting world final trace ∧ 1 ≤ trace.length ∧ trace.length ≤ 3 ∧
      (digitCalls .topZero trace).length = 1 ∧
      (∀ call, (digitCalls call trace).length ≤ 1) ∧
      (∀ before event after, trace = before ++ event :: after →
        match event.call with
        | .topZero => before = [] ∧ event.arguments = [.value x]
        | .topExponent => digitBooleans .topZero before = [false] ∧ event.arguments = [.value x]
        | .topAdd => ∃ exponent, digitValues .topExponent before = [exponent] ∧
            event.arguments = [.value exponent,.native (JuliaLean.base.int.lit .i64 1)]
        | _ => False) ∧
      (match outcome with
       | .error error => DigitSelectedError trace error
       | .ok value => digitErrors trace = [] ∧
           ((digitBooleans .topZero trace = [true] ∧ trace.length = 1 ∧
              value = .native .i64 (JuliaLean.base.int.lit .i64 0)) ∨
            (∃ event, trace.getLast? = some event ∧ event.call = .topAdd ∧ event.outcome = .ok (.value value))))

