def productReducer {R : Type} (mul : R → R → Jl R) :
    JuliaLean.base.reduce.Reducer (Jl R) (Jl R) where
  first := fun x => .value x
  step := fun state x => match state with
    | .initial => .value x
    | .value acc => .value (acc >>= fun a => x >>= fun b => mul a b)
  empty := .ok JuliaLean.base.reduce._empty_reduce_error

def product {I R : Type} (mul : R → R → Jl R) (f : I → Jl R)
    (itr : JuliaLean.base.reduce.JIterator I) (init : R) : Jl R :=
  (JuliaLean.base.reduce.prod_f (fun _ => .hasEltype) f (productReducer mul) itr
    (.value (.ok init))) >>= id

def bigTopBit (n : Int) : Nat := if n = 0 then 0 else n.natAbs.log2 + 1
def bigLowByte (n : Int) : Nat := (n % 256).toNat
def bigBin := bin bigTopBit bigLowByte bigOps.shiftRight
def bigOct := oct bigTopBit bigLowByte bigOps.shiftRight
def bigHex := hex bigTopBit bigLowByte bigOps.shiftRight
def bigDec (decimal : Int → Jl JInt64) :=
