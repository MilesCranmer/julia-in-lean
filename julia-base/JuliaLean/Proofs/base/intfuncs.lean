/-- Unsigned decimal correctness also covers signed magnitudes. -/
theorem decimalInput_of_decimalUnsigned (h : DecimalDigitCount) : DecimalInputDigitCount := by
  intro t x
  cases hs : t.signed with
  | false =>
    obtain ⟨count, hr, hc⟩ := h t x hs
    exact ⟨count, by simpa only [hs, Bool.false_eq_true, ite_false,
      ndigitsDecimal_Unsigned] using hr, hc⟩
  | true =>
    let u := JuliaLean.base.int.unsigned (JuliaLean.base.int.abs x)
    obtain ⟨count, hr, hc⟩ := h t.toUnsigned u (by cases t <;> rfl)
    refine ⟨count, ?_, ?_⟩
    · simpa only [hs, ite_true, ndigitsDecimal_Signed] using hr
    · have hu : u.val = (x.val.natAbs : Int) :=
        JuliaLean.Proofs.base.int.unsigned_abs_val hs x
      have hz : u.val = 0 ↔ x.val = 0 := by rw [hu]; omega
      have ha : u.val.natAbs = x.val.natAbs := by rw [hu, Int.natAbs_natCast]
      simp only [DigitCount, show (0 : Int) < 10 by decide, ite_true] at hc ⊢
      refine ⟨hc.1, hc.2.1, ?_, ?_⟩
      · intro hx
        exact hc.2.2.1 (hz.mpr hx)
      · intro hx
        simpa only [ha] using hc.2.2.2 (fun hu => hx (hz.mp hu))

