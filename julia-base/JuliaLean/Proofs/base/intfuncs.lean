      (fun trace => 1 ≤ trace.length ∧ trace.length ≤ 3 ∧
        (wrapperCalls .absolute trace).length = 1 ∧
        (∀ call, (wrapperCalls call trace).length ≤ 1) ∧
        (∀ before event after, trace = before ++ event :: after → SplitSignCausal n before event))
