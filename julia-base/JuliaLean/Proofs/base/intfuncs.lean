/-- Only accesses made by the call matter; prior trace entries belong to earlier calls. -/
def NewAccessesSafe (before after : Buffer) : Prop :=
  (∀ i ∈ after.writes.drop before.writes.length, 1 ≤ i ∧ i ≤ after.bytes.length) ∧
  (∀ access ∈ after.tableReads.drop before.tableReads.length,
    1 ≤ access.1 ∧ access.1 ≤ access.2)

