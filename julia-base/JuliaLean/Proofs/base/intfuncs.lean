namespace opusPowNeg

theorem neg_reduce {X I P U R MI : Type} {io : IntegerOps I} {po : IntegerOps P} {uvalue : U → Int}
    {uone uzero : U → U} {uabs : I → U} {modI : I → I → Jl I} {modX : X → U → Jl U}
    {modInverse : R → U → Jl U} {toI : U → Jl I} {wideSquare : I → I → I → Jl I}
    {wideLast : I → R → I → Jl I} {wideModU : U → U → U → Jl U} {invmod : X → I → Jl R}
    {legal : U → Bool} {bytes : U → Nat} {inverse : U → Jl MI} {magicMod : U → U → MI → Jl U}
    {x : X} {p : P} {m : I} {imod : R}
    (hp : po.value p < 0) (hne : po.value p ≠ po.value (po.neg p)) (hpos : 0 < po.value (po.neg p))
    (hinv : invmod x m = .ok imod) :
    powermod_Integer io po uvalue uone uzero uabs modI modX modInverse toI wideSquare wideLast wideModU
      invmod legal bytes inverse magicMod x p m =
    powermod_Integer io po uvalue uone uzero uabs modI modInverse modInverse toI wideSquare wideLast
      wideModU (fun _ _ => (Except.error JlError.divideError : Jl R)) legal bytes inverse magicMod
      imod (po.neg p) m := by
  unfold powermod_Integer
  simp only [if_neg (show po.value p ≠ 0 by omega), if_pos hp, if_neg hne, hinv, Bind.bind, Except.bind,
    if_neg (show po.value (po.neg p) ≠ 0 by omega), if_neg (show ¬ po.value (po.neg p) < 0 by omega)]

theorem tm_reduce {X I P U R MI : Type} {io : IntegerOps I} {po : IntegerOps P} {uvalue : U → Int}
    {uone uzero : U → U} {uabs : I → U} {modI : I → I → Jl I} {modX : X → U → Jl U}
    {modInverse : R → U → Jl U} {toI : U → Jl I} {wideSquare : I → I → I → Jl I}
    {wideLast : I → R → I → Jl I} {wideModU : U → U → U → Jl U} {invmod : X → I → Jl R}
    {legal : U → Bool} {bytes : U → Nat} {inverse : U → Jl MI} {magicMod : U → U → MI → Jl U}
    {x : X} {p : P} {m : I} {imod : R} {half : P}
    (hp : po.value p < 0) (heq : po.value p = po.value (po.neg p))
    (hinv : invmod x m = .ok imod) (hdiv : po.div p (po.ofInt 2) = .ok half)
    (hpos : 0 < po.value (po.neg half)) :
    powermod_Integer io po uvalue uone uzero uabs modI modX modInverse toI wideSquare wideLast wideModU
      invmod legal bytes inverse magicMod x p m =
    (powermod_Integer io po uvalue uone uzero uabs modI modInverse modInverse toI wideSquare wideLast
      wideModU (fun _ _ => (Except.error JlError.divideError : Jl R)) legal bytes inverse magicMod
      imod (po.neg half) m >>= fun rhalf => wideSquare rhalf rhalf m >>= fun r =>
        if po.value p % 2 ≠ 0 then wideLast r imod m else pure r) := by
  unfold powermod_Integer
  simp only [if_neg (show po.value p ≠ 0 by omega), if_pos hp, if_pos heq, hinv, hdiv, Bind.bind,
    Except.bind, if_neg (show po.value (po.neg half) ≠ 0 by omega),
    if_neg (show ¬ po.value (po.neg half) < 0 by omega)]

/-- The positive-exponent part of `powermod` on a fixed-width modulus, applied to an inverse. -/
theorem pos_spec (g : approvedRound2.Concrete.GmpPrimitives) (e t : IntTy) (h128 : ¬ t.bits = 128)
    (q : JInt e) (m : JInt t) (imod : Int) (hq : 0 ≤ q.val) (hm : m.val ≠ 0) :
    ∃ y, powermod_Integer (bitsOps t) (bitsOps e) Subtype.val
      (fun _ => JuliaLean.base.int.lit t.toUnsigned 1)
      (fun _ => JuliaLean.base.int.lit t.toUnsigned 0) JuliaLean.base.float.uabs
      (fun a b => do JInt.convert (t.name) t (← (approvedRound2.Concrete.numberCallees g).mixedMod a b))
      (fun a mm => if mm.val = 0 then .error .divideError
        else pure (JuliaLean.base.int.lit t.toUnsigned (a % mm.val)))
      (fun a mm => if mm.val = 0 then .error .divideError
        else pure (JuliaLean.base.int.lit t.toUnsigned (a % mm.val)))
      (fun a => JInt.convert (t.name) t a.val)
      (fun a b m => do JInt.convert (t.name) t (← workMod (approvedRound2.Concrete.numberCallees g)
        (JuliaLean.base.int.widenType t) (a.val * b.val) m.val))
      (fun a b m => do JInt.convert (t.name) t (← workMod (approvedRound2.Concrete.numberCallees g)
        (JuliaLean.base.int.widenType t) (a.val * b) m.val))
      (fun a b mm => do
        let productMod ← workMod (approvedRound2.Concrete.numberCallees g)
          (JuliaLean.base.int.widenType t.toUnsigned) (a.val * b.val) mm.val
        JInt.convert (t.toUnsigned.name) t.toUnsigned productMod)
      (fun _ _ => (Except.error JlError.divideError : Jl Int))
      (powermodMILegal_Unsigned (hasTypeMax true true)
        (JuliaLean.base.int.lit t.toUnsigned t.toUnsigned.max)
        (fun a b => decide (a.val ≤ b.val))
        (fun x n => JuliaLean.base.int.lshr_int x (JuliaLean.base.int.lit .i64 n)) (t.bits / 8))
      (fun _ => t.bits / 8) inverseForBits (approvedRound2.Concrete.numberCallees g).magicMod
      imod q m = .ok y ∧ y.val = fmod (imod ^ q.val.toNat) m.val := by
  have hu := opusPowInst.uabs_val m
  have hle := opusPowInst.natAbs_le_toU t m
  have hM : (0 : Int) < (m.val.natAbs : Int) := by omega
  have hfx := (JuliaLean.Proofs.base.int.fmod_bounds imod (m.val.natAbs : Int) (by omega)).1 hM
  have hfitx : t.toUnsigned.min ≤ imod.fmod (m.val.natAbs : Int) ∧
      imod.fmod (m.val.natAbs : Int) ≤ t.toUnsigned.max := by
    have := opusPowInst.toU_min t; constructor <;> omega
  have hem : imod.fmod (m.val.natAbs : Int) = imod % (m.val.natAbs : Int) :=
    JuliaLean.Proofs.base.int.fmod_char _ _ _ (by omega)
      ⟨imod / (m.val.natAbs : Int), by rw [Int.emod_def]; omega⟩
      ⟨fun _ => ⟨Int.emod_nonneg _ (by omega), Int.emod_lt_of_pos _ hM⟩, fun h => by omega⟩
  have H1 : ∃ r, (approvedRound2.Concrete.modMixed (JuliaLean.base.int.lit t 1) m >>=
      JInt.convert (t.name) t) = .ok r ∧ r.val = (1 : Int).fmod m.val := by
    have hf := opusBigPow.fmod_fits_mod t 1 m hm
    refine ⟨⟨_, hf⟩, ?_, rfl⟩
    rw [opusPowInst.modMixed_all, if_neg hm, (opusPowParts.lit_toU t).2.2,
      opusModMixed.fmod_spec_eq _ _ hm]
    exact opusBigPow.convert_ok' t _ hf
  exact opusPowFixed.nonneg_spec t (bitsOps e) _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ imod q m imod hq hm
    (opusPowParts.shift_bits e) H1 (fun _ => (opusPowParts.lit_toU t).1)
    (fun _ => (opusPowParts.lit_toU t).2.1) hu
    ⟨⟨_, hfitx⟩, by
      show (if (JuliaLean.base.float.uabs m).val = 0 then Except.error JlError.divideError
        else pure (JuliaLean.base.int.lit t.toUnsigned (imod % (JuliaLean.base.float.uabs m).val))) = _
      rw [hu, if_neg (by omega)]
      show Except.ok _ = Except.ok _
      congr 1
      apply Subtype.ext
      show wrapInt _ _ = _
      rw [← hem]
      exact wrapInt_of_inRange _ _ hfitx, rfl⟩
    (fun a b ha ha1 hb hb1 => opusPowInst.wide_spec (approvedRound2.Concrete.numberCallees g)
      (fun _ _ => rfl) t h128 m a b ha ha1 hb hb1 _ hu)
    (opusPowParts.magic_hyp t m hm)
    (fun rr h0 h1 => opusPowParts.toI_hyp t m rr h0 h1)

theorem widen_sq (t : IntTy) (h : ¬ t.bits = 128) :
    ∃ w, JuliaLean.base.int.widenType t = some w ∧ w.min ≤ t.min ∧ t.max ≤ w.max ∧
      t.max * t.max ≤ w.max ∧ w.min ≤ 0 ∧ t.min ≤ 0 ∧ -t.min ≤ t.max + 1 := by
  cases t <;> simp [IntTy.bits] at h <;> exact ⟨_, rfl, by decide⟩

theorem wsq_spec (g : approvedRound2.Concrete.GmpPrimitives) (t : IntTy) (h128 : ¬ t.bits = 128)
    (m a : JInt t) (hm : m.val ≠ 0) (ha : a.val.natAbs < m.val.natAbs) :
    ∃ r, (do JInt.convert (t.name) t (← workMod (approvedRound2.Concrete.numberCallees g)
        (JuliaLean.base.int.widenType t) (a.val * a.val) m.val)) = .ok r ∧
      r.val = (a.val * a.val).fmod m.val := by
  obtain ⟨w, hw, h1, h2, h3, h4, h5, h6⟩ := widen_sq t h128
  have hmr := m.property
  have hA : a.val.natAbs ≤ t.max.toNat := by omega
  have hsq : a.val * a.val = ((a.val.natAbs * a.val.natAbs : Nat) : Int) := (Int.natAbs_mul_self).symm
  have hle : a.val.natAbs * a.val.natAbs ≤ t.max.toNat * t.max.toNat := Nat.mul_le_mul hA hA
  have htm : ((t.max.toNat * t.max.toNat : Nat) : Int) = t.max * t.max := by
    rw [Int.natCast_mul, Int.toNat_of_nonneg (by omega)]
  have hl1 : (JuliaLean.base.int.lit w (a.val * a.val)).val = a.val * a.val :=
    JuliaLean.Proofs.base.int.lit_of_fits ⟨by omega, by omega⟩
  have hl2 : (JuliaLean.base.int.lit w m.val).val = m.val :=
    JuliaLean.Proofs.base.int.lit_of_fits ⟨by omega, by omega⟩
  have hf := opusBigPow.fmod_fits_mod t (a.val * a.val) m hm
  refine ⟨⟨_, hf⟩, ?_, rfl⟩
  rw [hw]
  show (do JInt.convert (t.name) t (← approvedRound2.Concrete.modMixed
    (JuliaLean.base.int.lit w (a.val * a.val)) (JuliaLean.base.int.lit w m.val))) = _
  rw [opusPowInst.modMixed_all, hl1, hl2, if_neg hm, opusModMixed.fmod_spec_eq _ _ hm]
  exact opusBigPow.convert_ok' _ _ hf

theorem fmod_congr (a b m : Int) (hm : m ≠ 0) (h : m ∣ a - b) : a.fmod m = b.fmod m := by
  have hb := JuliaLean.Proofs.base.int.fmod_bounds b m hm
  apply JuliaLean.Proofs.base.int.fmod_char a m _ hm
  · have e : a - b.fmod m = (a - b) + m * b.fdiv m := by rw [Int.fmod_def]; omega
    rw [e]; exact Int.dvd_add h (Int.dvd_mul_right _ _)
  · exact hb

theorem ipow_add (a : Int) (m : Nat) : ∀ n : Nat, a ^ (m + n) = a ^ m * a ^ n
  | 0 => by simp
  | n + 1 => by rw [← Nat.add_assoc, Int.pow_succ, Int.pow_succ, ipow_add a m n, Int.mul_assoc]

theorem tm_facts (e : IntTy) (he : e.signed = true) :
    0 < -(e.min.tdiv 2) ∧ -(e.min.tdiv 2) ≤ e.max ∧ e.min.tdiv 2 ≥ e.min ∧ e.min % 2 = 0 ∧
      (-(e.min.tdiv 2)).toNat + (-(e.min.tdiv 2)).toNat = e.min.natAbs := by
  cases e <;> simp [IntTy.signed] at he <;> decide

/-- `powermod` with a negative exponent on every fixed-width modulus type. -/
theorem powermod_neg (g : approvedRound2.Concrete.GmpPrimitives) (hg : approvedRound2.Concrete.GmpDocs g)
    (s e t : IntTy) (x : JInt s) (p : JInt e) (m : JInt t) (hp : p.val < 0) (hm : m.val ≠ 0)
    (hg1 : gcdMath x.val m.val = 1) :
    ∃ y, powermodBits (approvedRound2.Concrete.numberCallees g) x p m = .ok y ∧
      ModularPower x.val p.val m.val y.val := by
  unfold powermodBits
  by_cases h128 : t.bits = 128
  · rw [if_pos h128]
    obtain ⟨y, hy, hmp⟩ := hg.2.1 x.val p.val m.val hm (fun _ => by unfold gcdMath at hg1; omega)
    have hmp' := hmp
    unfold ModularPower at hmp'
    rw [if_neg (by omega)] at hmp'
    obtain ⟨inv, _, hyv⟩ := hmp'
    have hf : t.min ≤ y ∧ y ≤ t.max := by
      rw [hyv, opusModMixed.fmod_spec_eq _ _ hm]; exact opusBigPow.fmod_fits_mod t _ m hm
    refine ⟨⟨y, hf⟩, ?_, hmp⟩
    unfold powermod_128
    show (g.powermod x.val p.val m.val >>= JInt.convert (t.name) t) = _
    rw [hy]
    exact opusBigPow.convert_ok' t _ hf
  rw [if_neg h128]
  obtain ⟨imod, hinv, hmi⟩ : ∃ imod, invmodBits (approvedRound2.Concrete.numberCallees g) x m = .ok imod ∧
      ModInverse x.val m.val imod := by
    have := opusInvmodW.invmod_all g hg s t x m
    unfold InverseResult at this
    rw [if_neg (by omega)] at this
    exact this
  have hep : e.signed = true := by
    cases h : e.signed
    · have := JuliaLean.Proofs.base.int.nonneg_of_unsigned h p; omega
    · rfl
  have hem := opusGcdx.min_neg e hep
  have hpr := p.property
  have hnegv : (JuliaLean.base.int.neg p).val = wrapInt e (-p.val) := by
    change (JuliaLean.base.int.neg_int p).val = _
    rw [JuliaLean.Proofs.base.int.neg_int_val]
  by_cases htm : p.val = e.min
  · have hnv : (JuliaLean.base.int.neg p).val = p.val := by
      rw [hnegv, htm]
      have : wrapInt e (-e.min) = e.min := by cases e <;> simp [IntTy.signed] at hep <;> decide
      exact this
    obtain ⟨f1, f2, f3, f4, f5⟩ := tm_facts e hep
    have hdiv : (bitsOps e).div p ((bitsOps e).ofInt 2) =
        .ok (JuliaLean.base.int.lit e (p.val.tdiv 2)) := by
      change JuliaLean.base.int.divSame p (JuliaLean.base.int.lit e 2) = _
      have h2 : (JuliaLean.base.int.lit e 2).val = 2 := by
        cases e <;> simp [IntTy.signed] at hep <;> decide
      rw [JuliaLean.Proofs.base.int.divSame_eq, h2, if_neg (by omega)]
    have hhv : (JuliaLean.base.int.lit e (p.val.tdiv 2)).val = e.min.tdiv 2 := by
      rw [htm]; exact JuliaLean.Proofs.base.int.lit_of_fits ⟨by omega, by omega⟩
    have hnh : (JuliaLean.base.int.neg (JuliaLean.base.int.lit e (p.val.tdiv 2))).val =
        -(e.min.tdiv 2) := by
      change (JuliaLean.base.int.neg_int _).val = _
      rw [JuliaLean.Proofs.base.int.neg_int_val, hhv]
      exact wrapInt_of_inRange _ _ ⟨by omega, by omega⟩
    rw [tm_reduce (po := bitsOps e) hp (by show p.val = (JuliaLean.base.int.neg p).val; omega) hinv hdiv
      (by show 0 < (JuliaLean.base.int.neg _).val; omega)]
    obtain ⟨rh, hrh, hrhv⟩ := pos_spec g e t h128
      (JuliaLean.base.int.neg (JuliaLean.base.int.lit e (p.val.tdiv 2))) m imod (by omega) hm
    rw [show (bitsOps e).neg (JuliaLean.base.int.lit e (p.val.tdiv 2)) =
      JuliaLean.base.int.neg (JuliaLean.base.int.lit e (p.val.tdiv 2)) from rfl, hrh]
    simp only [Bind.bind, Except.bind]
    have hfb := JuliaLean.Proofs.base.int.fmod_bounds (imod ^ (-(e.min.tdiv 2)).toNat) m.val hm
    rw [hnh, opusModMixed.fmod_spec_eq _ _ hm] at hrhv
    have hrb : rh.val.natAbs < m.val.natAbs := by
      rw [hrhv]
      by_cases hp0 : 0 < m.val
      · have := hfb.1 hp0; omega
      · have := hfb.2 (by omega); omega
    obtain ⟨r, hr, hrv⟩ := wsq_spec g t h128 m rh hm hrb
    simp only [Bind.bind, Except.bind] at hr
    rw [hr]
    have hev : ¬ ((bitsOps e).value p % 2 ≠ 0) := by
      show ¬ (p.val % 2 ≠ 0); rw [htm]; omega
    simp only [hev, if_false, Pure.pure, Except.pure]
    refine ⟨r, rfl, ?_⟩
    unfold ModularPower
    rw [if_neg (by omega)]
    refine ⟨imod, hmi, ?_⟩
    rw [hrv, opusModMixed.fmod_spec_eq _ _ hm]
    apply fmod_congr _ _ _ hm
    have hk : p.val.natAbs = (-(e.min.tdiv 2)).toNat + (-(e.min.tdiv 2)).toNat := by rw [htm]; omega
    rw [hk, ipow_add]
    generalize imod ^ (-(e.min.tdiv 2)).toNat = X at hrhv ⊢
    have hd : m.val ∣ rh.val - X := by
      rw [hrhv]; exact ⟨-(X.fdiv m.val), by rw [Int.fmod_def, Int.mul_neg]; omega⟩
    have e1 : rh.val * rh.val - X * X = (rh.val - X) * (rh.val + X) := by grind
    rw [e1]
    exact Int.dvd_trans hd (Int.dvd_mul_right _ _)
  · have hv : (JuliaLean.base.int.neg p).val = -p.val := by
      rw [hnegv]; exact wrapInt_of_inRange _ _ ⟨by omega, by omega⟩
    rw [neg_reduce (po := bitsOps e) hp (by show p.val ≠ (JuliaLean.base.int.neg p).val; omega)
      (by show 0 < (JuliaLean.base.int.neg p).val; omega) hinv]
    rw [show (bitsOps e).neg p = JuliaLean.base.int.neg p from rfl]
    obtain ⟨y, hy, hyv⟩ := pos_spec g e t h128 (JuliaLean.base.int.neg p) m imod (by omega) hm
    refine ⟨y, hy, ?_⟩
    unfold ModularPower
    rw [if_neg (by omega)]
    refine ⟨imod, hmi, ?_⟩
    rw [hyv, hv]
    congr 2
    omega

theorem powermodNegative_proven : approvedRound2.PowermodNegative :=
  fun g hg s e t x p m hp hm hg1 => powermod_neg g hg s e t x p m hp hm hg1

theorem odd_sq (a : Int) (ha : a % 2 ≠ 0) : (8 : Int) ∣ a ^ (2 ^ 1) - 1 := by
  have h : a ^ (2 ^ 1) = a * a := by simp [Int.pow_succ]
  rw [h]
  apply Int.dvd_of_emod_eq_zero
  have h8 : a % 8 = 1 ∨ a % 8 = 3 ∨ a % 8 = 5 ∨ a % 8 = 7 := by omega
  rw [Int.sub_emod, Int.mul_emod]
  rcases h8 with h8 | h8 | h8 | h8 <;> rw [h8] <;> decide

theorem odd_pow2 (a : Int) (ha : a % 2 ≠ 0) : ∀ j : Nat, (2 : Int) ^ (j + 3) ∣ a ^ (2 ^ (j + 1)) - 1
  | 0 => by simpa using odd_sq a ha
  | j + 1 => by
    have ih := odd_pow2 a ha j
    have e1 : a ^ (2 ^ (j + 1 + 1)) = a ^ (2 ^ (j + 1)) * a ^ (2 ^ (j + 1)) := by
      rw [show 2 ^ (j + 1 + 1) = 2 ^ (j + 1) + 2 ^ (j + 1) by rw [Nat.pow_succ]; omega, ipow_add]
    rw [e1]
    generalize a ^ (2 ^ (j + 1)) = X at ih ⊢
    obtain ⟨k, hk⟩ := ih
    have e2 : X * X - 1 = (X - 1) * (X + 1) := by grind
    have h2 : (2 : Int) ∣ X + 1 := ⟨2 ^ (j + 2) * k + 1, by
      rw [show (2 : Int) ^ (j + 3) = 2 * 2 ^ (j + 2) by rw [Int.pow_succ]; grind] at hk; grind⟩
    rw [e2, hk, show (2 : Int) ^ (j + 1 + 3) = 2 ^ (j + 3) * 2 by rw [Int.pow_succ]]
    exact Int.mul_dvd_mul (Int.dvd_mul_right _ _) h2

theorem tmin_facts (t : IntTy) (ht : t.signed = true) :
    (JuliaLean.base.int.typemin t).val = t.min ∧ t.min ≤ -128 ∧
      ∃ j : Nat, t.min.natAbs = 2 ^ (j + 1) ∧ t.min ∣ (2 : Int) ^ (j + 3) := by
  cases t <;> simp [IntTy.signed] at ht
