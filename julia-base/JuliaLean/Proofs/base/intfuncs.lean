        decide (z.im.num.val = 0) := by
      change (z.im.num.val == 0) = decide (z.im.num.val = 0)
      rfl
    have hpow := rationalPowerTwoComponents t z.re
    change (isZeroRationalSource (jintOps t).iszero z.im &&
      isPow2RatSource ispow2Bits z.re) = true ↔ _
    rw [Bool.and_eq_true, hzero, hpow]
    simp
  · intro z
    have hzero : isZeroRationalSource bigIntOps.iszero z.im =
        decide (z.im.num = 0) := by
      change (z.im.num == 0) = decide (z.im.num = 0)
      rfl
    have hpow := bigRatPowerTwoComponents z.re
    change (isZeroRationalSource bigIntOps.iszero z.im &&
      isPow2RatSource (ispow2_Integer bigOps.value bigOps.countOnes) z.re) = true ↔ _
    rw [Bool.and_eq_true, hzero, hpow]
    simp

theorem numberPowerTwo_floatComplex_ofReal
    (hreal : ∀ (T : FTy) (x : FV T),
      ispow2_AbstractFloat JuliaLean.base.math.frexp x = true ↔ FloatPowerOfTwo x) :
    ∀ (T : FTy) (z : JuliaLean.base.complex.Complex (FV T)),
      ispow2_Number (JuliaLean.base.complex.isreal_Complex iszero_float)
        JuliaLean.base.complex.real_Complex
        (ispow2_AbstractFloat JuliaLean.base.math.frexp) z = true ↔
      z.im.iszero = true ∧ FloatPowerOfTwo z.re := by
  intro T z
  unfold ispow2_Number
  simp only [JuliaLean.base.complex.isreal_Complex, JuliaLean.base.complex.real_Complex,
    JuliaLean.base.complex.imag_Complex]
  rw [Bool.and_eq_true, hreal T z.re, JuliaLean.Proofs.base.float.iszero_float_eq]


theorem prevpowExact_two_base_proven :
    ∀ (a x : IntTy) (log : JInt a → JInt x → Jl Int), FloorLogLaw log →
      ∀ (base : JInt a) (input : JInt x),
        base.val = 2 → 1 ≤ input.val →
        ∃ y k, prevpowBits log base input = .ok y ∧
          y = base.val ^ k ∧ y ≤ input.val ∧ input.val < base.val ^ (k + 1) := by
  intro a x log _ base input hbase hinput
  obtain ⟨k, hpow, hle, hlt⟩ := prevpowTwoExact_proven x input hinput
  have hcall : prevpowBits log base input = .ok (prevpow2Bits input).val := by
    unfold prevpowBits prevpow
    simp [hbase, show ¬ input.val < 1 by omega, Pure.pure, Except.pure]
  refine ⟨(prevpow2Bits input).val, k, hcall, ?_, hle, ?_⟩
  · rw [hbase, hpow]
  · calc
      input.val < 2 * (prevpow2Bits input).val := hlt
      _ = base.val ^ (k + 1) := by rw [hbase, hpow, Int.pow_succ]; exact Int.mul_comm _ _

private theorem exists_floorPower (b x : Nat) (hb : 2 ≤ b) (hx : 1 ≤ x) :
    ∃ k, b^k ≤ x ∧ x < b^(k + 1) := by
  induction x using Nat.strongRecOn with
  | ind x ih =>
    by_cases hxb : x < b
    · exact ⟨0, by simpa using hx, by simpa using hxb⟩
    · have hxb : b ≤ x := by omega
      have hbpos : 0 < b := by omega
      let q := x / b
      have hqpos : 1 ≤ q := by
        apply (Nat.le_div_iff_mul_le hbpos).2
        simpa [q] using hxb
      have hqlt : q < x := by
        exact Nat.div_lt_self (by omega) (by omega)
      obtain ⟨k, hlo, hhi⟩ := ih q hqlt hqpos
      have hqb : q * b ≤ x := by
        simpa [q] using Nat.div_mul_le_self x b
      have hrem : x % b < b := Nat.mod_lt x hbpos
      have hdecomp : x = b * q + x % b := by
        calc
          x = b * (x / b) + x % b := (Nat.div_add_mod x b).symm
          _ = b * q + x % b := by rfl
      have htopBound : x < b * (q + 1) := by
        rw [hdecomp]
        calc
          b * q + x % b < b * q + b := Nat.add_lt_add_left hrem _
          _ = b * (q + 1) := by rw [Nat.mul_add, Nat.mul_one]
      have hqSucc : q + 1 ≤ b^(k + 1) := Nat.succ_le_of_lt hhi
      have htopMul : b * (q + 1) ≤ b * b^(k + 1) :=
        Nat.mul_le_mul_left b hqSucc
      have hpowStep : b * b^(k + 1) = b^(k + 2) := by
        have hp : b^(k + 2) = b^(k + 1) * b := by
          rw [show k + 2 = (k + 1) + 1 by omega]
          exact Nat.pow_succ _ _
        calc
          b * b^(k + 1) = b^(k + 1) * b := Nat.mul_comm _ _
          _ = b^(k + 2) := hp.symm
      have htop : x < b^(k + 2) := by
        have h := Nat.lt_of_lt_of_le htopBound htopMul
        rw [hpowStep] at h
        exact h
      refine ⟨k + 1, ?_, ?_⟩
      · have hp : b^(k + 1) = b^k * b := Nat.pow_succ _ _
        rw [hp]
        exact Nat.le_trans (Nat.mul_le_mul_right b hlo) hqb
      · simpa [Nat.add_assoc] using htop

private theorem prevpowExact_nonbinary_proven
    (a x : IntTy) (log : JInt a → JInt x → Jl Int) (hlog : FloorLogLaw log)
    (base : JInt a) (input : JInt x) (hbase : base.val > 1)
    (hbaseTwo : base.val ≠ 2) (hx : input.val ≥ 1) (hinputMax : input.val ≤ a.max) :
    ∃ y k, prevpowBits log base input = .ok y ∧ y = base.val ^ k ∧
      y ≤ input.val ∧ input.val < base.val ^ (k + 1) := by
  let power : JInt a → Int → Jl Int := fun aa p =>
    (powerBySquaring bigOps (fun u v => pure (JuliaLean.base.int.mul u v)) true
      pure pure pure id (fun _ => JuliaLean.base.int.lit a 1) (fun z => pure (JuliaLean.base.int.neg z))
      (fun z => decide (z.val = 1)) (fun u v => pure (JuliaLean.base.int.mul u v))
      true aa p throwPowerDomain_Integer).map Subtype.val
  let mulChecked : JInt a → Int → Jl (Int × Bool) := fun aa p => do
    let (result, overflow) ←
      JuliaLean.base.checked.mulWithOverflowBits aa (JuliaLean.base.int.lit a p)
    pure (result.val, overflow)
  have powerExact (j : Int) (hj : 0 ≤ j) (hfit : fits a (base.val ^ j.toNat)) :
      power base j = .ok (base.val ^ j.toNat) := by
    unfold power
    rw [powerBySquaring_monoidPow bigOps JuliaLean.base.int.mul
      (JuliaLean.base.int.lit a 1) (fun z => pure (JuliaLean.base.int.neg z)) (fun z => decide (z.val = 1))
      throwPowerDomain_Integer (jint_mul_assoc a) (jint_mul_one_left a)
      (jint_mul_one_right a) bigOps_trailing_shift base j hj]
    simp only [Functor.map, Except.map]
    simp [bigOps]
    rw [monoidPow_jint_val a base j.toNat, wrapInt_of_inRange a _ hfit]
  have mulExact (aa : JInt a) (p : Int) (hfit : fits a p) :
      mulChecked aa p =
        .ok (wrapInt a (aa.val * p), decide (¬ fits a (aa.val * p))) := by
    unfold mulChecked
    have hlit : (JuliaLean.base.int.lit a p).val = p :=
      JuliaLean.Proofs.base.int.lit_of_fits hfit
    rw [JuliaLean.Proofs.base.checked.mulWithOverflowBitsExact]
    by_cases hlo : a.min ≤ aa.val * p <;> by_cases hhi : aa.val * p ≤ a.max <;>
      simp [JuliaLean.Proofs.base.checked.intrinsicResult, JuliaLean.JInt.wrap, hlit,
        Bind.bind, Except.bind, Pure.pure, Except.pure, fits, hlo, hhi]
  have hbaseCast : (base.val.toNat : Int) = base.val :=
    Int.toNat_of_nonneg (by omega)
  have hinputCast : (input.val.toNat : Int) = input.val :=
    Int.toNat_of_nonneg (by omega)
  have hbaseNat : 2 ≤ base.val.toNat := by
    have hcast : (2 : Int) ≤ (base.val.toNat : Int) := by rw [hbaseCast]; omega
    exact_mod_cast hcast
  have hinputNat : 1 ≤ input.val.toNat := by
    have hcast : (1 : Int) ≤ (input.val.toNat : Int) := by rw [hinputCast]; omega
    exact_mod_cast hcast
  obtain ⟨k, hlowNat, hhighNat⟩ :=
    exists_floorPower base.val.toNat input.val.toNat hbaseNat hinputNat
  have hpowCast (j : Nat) : ((base.val.toNat)^j : Int) = base.val^j := by
    simp [hbaseCast]
  have hlow : base.val^k ≤ input.val := by
    have hcast : ((base.val.toNat)^k : Int) ≤ (input.val.toNat : Int) :=
      Int.ofNat_le.mpr hlowNat
    rw [hpowCast, hinputCast] at hcast
    exact hcast
  have hhigh : input.val < base.val^(k + 1) := by
    have hcast : (input.val.toNat : Int) < ((base.val.toNat)^(k + 1) : Int) :=
      Int.ofNat_lt.mpr hhighNat
    rw [hinputCast, hpowCast] at hcast
    exact hcast
  have hmin : a.min ≤ 0 := by cases a <;> decide
  have powNonneg (j : Nat) : 0 ≤ base.val^j := Int.pow_nonneg (by omega)
  have fitPow (j : Nat) (hmax : base.val^j ≤ a.max) : fits a (base.val^j) := by
    exact ⟨Int.le_trans hmin (powNonneg j), hmax⟩
  have hfitOut : fits a (base.val^k) :=
    fitPow k (by omega)
  have powStep (j : Nat) : base.val^j < base.val^(j + 1) := by
    have hp : 0 < base.val^j := Int.pow_pos (by omega)
    have hmul : base.val^j < base.val^j * base.val := by
      simpa using Int.mul_lt_mul_of_pos_left (show 1 < base.val by omega) hp
    calc
      base.val^j = base.val^j * 1 := by simp
      _ < base.val^j * base.val := by simpa using hmul
      _ = base.val^(j + 1) := by rw [Int.pow_succ]
  have hbelow : decide (input.val < 1) = false := by
    simp [show ¬ input.val < 1 by omega]
  have htwo : decide (base.val = 2) = false := by simp [hbaseTwo]
  have hsmall : decide (base.val ≤ 1) = false := by
    simp [show ¬ base.val ≤ 1 by omega]
  have hmax : decide (input.val > a.max) = false := by
    simp [show ¬ input.val > a.max by omega]
  have hmodel : prevpowBits log base input =
      prevpow (fun x => decide (x.val < 1)) (fun aa => decide (aa.val = 2)) true
        (fun x => pure (prevpow2Bits x).val) (fun aa => decide (aa.val ≤ 1)) log power
        (fun _ => hasTypeMax true true) (fun x _ => decide (x.val > a.max)) true
        mulChecked (fun p x => decide (p ≤ x.val)) base input := by
    rfl
  obtain ⟨n, hcall, hn, hnear, hfitNbound⟩ :=
    hlog base input k hbase hx hlow hhigh
  have hfitN : fits a (base.val^n.toNat) :=
    fitPow n.toNat hfitNbound
  have toNatEq (z : Int) (hz : 0 ≤ z) (m : Nat) (heq : z = (m : Int)) :
      z.toNat = m := by
    have hc : (z.toNat : Int) = (m : Int) := by
      rw [Int.toNat_of_nonneg hz, heq]
    exact_mod_cast hc
  have hCore : prevpowBits log base input = .ok (base.val^k) := by
    rcases hnear with hprev | heq | hnext
    · have hnNat : n.toNat = k - 1 :=
        toNatEq n hn (k - 1) (by omega)
      have hn1Nat : (n + 1).toNat = k :=
        toNatEq (n + 1) (by omega) k (by omega)
      have hprod : base.val * base.val^n.toNat = base.val^k := by
        have he : n.toNat + 1 = k := by rw [hnNat]; omega
        calc
          base.val * base.val^n.toNat = base.val^n.toNat * base.val := Int.mul_comm _ _
          _ = base.val^(n.toNat + 1) := (Int.pow_succ _ _).symm
          _ = base.val^k := by rw [he]
      have hmulK : mulChecked base (base.val^n.toNat) = .ok (base.val^k, false) := by
        rw [mulExact base _ hfitN, hprod, wrapInt_of_inRange a _ hfitOut]
        simp [hfitOut]
      have hp := powerExact n (by omega) hfitN
      rw [hmodel]
      simp [prevpow, hbelow, htwo, hsmall, hmax, hcall, hp,
        hn1Nat, hmulK, hasTypeMax, hlow, Bind.bind, Except.bind, Pure.pure, Except.pure]
    · have hnNat : n.toNat = k := toNatEq n hn k (by omega)
      have hn1Nat : (n + 1).toNat = k + 1 :=
        toNatEq (n + 1) (by omega) (k + 1) (by omega)
      have hprod : base.val * base.val^k = base.val^(k + 1) := by
        calc
          base.val * base.val^k = base.val^k * base.val := Int.mul_comm _ _
          _ = base.val^(k + 1) := (Int.pow_succ _ _).symm
      have hnotK1 : ¬ base.val^(k + 1) ≤ input.val := by omega
      by_cases hfitProd : fits a (base.val^(k + 1))
      · have hmulK : mulChecked base (base.val^k) =
            .ok (base.val^(k + 1), false) := by
          rw [mulExact base _ hfitOut, hprod, wrapInt_of_inRange a _ hfitProd]
          simp [hfitProd]
        have hp := powerExact n (by omega) hfitN
        rw [hmodel]
        simp [prevpow, hbelow, htwo, hsmall, hmax, hcall, hp,
          hnNat, hn1Nat, hmulK, hasTypeMax, hlow, hnotK1,
          Bind.bind, Except.bind, Pure.pure, Except.pure]
      · have hmulK : mulChecked base (base.val^k) =
            .ok (wrapInt a (base.val^(k + 1)), true) := by
          rw [mulExact base _ hfitOut, hprod]
          have hdec : decide (¬ fits a (base.val^(k + 1))) = true :=
            decide_eq_true hfitProd
          rw [hdec]
        have hp := powerExact n (by omega) hfitN
        rw [hmodel]
        simp [prevpow, hbelow, htwo, hsmall, hmax, hcall, hp,
          hnNat, hn1Nat, hmulK, hasTypeMax, hlow, hnotK1,
          Bind.bind, Except.bind, Pure.pure, Except.pure]
    · have hnNat : n.toNat = k + 1 :=
        toNatEq n hn (k + 1) (by omega)
      have hn1Nat : (n + 1).toNat = k + 2 :=
        toNatEq (n + 1) (by omega) (k + 2) (by omega)
      have hnm1Nat : (n - 1).toNat = k :=
        toNatEq (n - 1) (by omega) k (by omega)
      have hprod : base.val * base.val^(k + 1) = base.val^(k + 2) := by
        have hn1 : (k + 1) + 1 = k + 2 := by omega
        calc
          base.val * base.val^(k + 1) = base.val^(k + 1) * base.val := Int.mul_comm _ _
          _ = base.val^((k + 1) + 1) := (Int.pow_succ _ _).symm
          _ = base.val^(k + 2) := by rw [hn1]
      have hnotK1 : ¬ base.val^(k + 1) ≤ input.val := by omega
      have hnotK2 : ¬ base.val^(k + 2) ≤ input.val := by
        have hpowHi : base.val^(k + 1) < base.val^(k + 2) := powStep (k + 1)
        omega
      have hfitPrev : fits a (base.val^(n - 1).toNat) := by
        rw [hnm1Nat]
        exact hfitOut
      have hprevPower := powerExact (n - 1) (by omega) hfitPrev
      have hfitPN : fits a (base.val^(k + 1)) := by
        rw [← hnNat]
        exact hfitN
      by_cases hfitProd : fits a (base.val^(k + 2))
      · have hmulK : mulChecked base (base.val^(k + 1)) =
            .ok (base.val^(k + 2), false) := by
          rw [mulExact base _ hfitPN, hprod, wrapInt_of_inRange a _ hfitProd]
          simp [hfitProd]
        have hp := powerExact n (by omega) hfitN
        rw [hmodel]
        simp [prevpow, hbelow, htwo, hsmall, hmax, hcall, hp,
          hprevPower, hnNat, hn1Nat, hnm1Nat, hmulK, hasTypeMax, hnotK1, hnotK2,
          Bind.bind, Except.bind, Pure.pure, Except.pure]
      · have hmulK : mulChecked base (base.val^(k + 1)) =
            .ok (wrapInt a (base.val^(k + 2)), true) := by
          rw [mulExact base _ hfitPN, hprod]
          have hdec : decide (¬ fits a (base.val^(k + 2))) = true :=
            decide_eq_true hfitProd
          rw [hdec]
        have hp := powerExact n (by omega) hfitN
        rw [hmodel]
        simp [prevpow, hbelow, htwo, hsmall, hmax, hcall, hp,
          hprevPower, hnNat, hn1Nat, hnm1Nat, hmulK, hasTypeMax, hnotK1, hnotK2,
          Bind.bind, Except.bind, Pure.pure, Except.pure]
  refine ⟨base.val^k, k, hCore, rfl, hlow, hhigh⟩

private theorem prevpowBits_oversized_domainError
    (a x : IntTy) (log : JInt a → JInt x → Jl Int) (hlog : FloorLogLaw log)
    (base : JInt a) (input : JInt x) (hbase : base.val > 1)
    (hbaseTwo : base.val ≠ 2) (hx : input.val ≥ 1) (hlarge : input.val > a.max) :
    domainError (prevpowBits log base input) := by
  let power : JInt a → Int → Jl Int := fun aa p =>
    (powerBySquaring bigOps (fun u v => pure (JuliaLean.base.int.mul u v)) true
      pure pure pure id (fun _ => JuliaLean.base.int.lit a 1) (fun z => pure (JuliaLean.base.int.neg z))
      (fun z => decide (z.val = 1)) (fun u v => pure (JuliaLean.base.int.mul u v))
      true aa p throwPowerDomain_Integer).map Subtype.val
  let mulChecked : JInt a → Int → Jl (Int × Bool) := fun aa p => do
    let (result, overflow) ←
      JuliaLean.base.checked.mulWithOverflowBits aa (JuliaLean.base.int.lit a p)
    pure (result.val, overflow)
  have powerWrapped (j : Int) (hj : 0 ≤ j) :
      power base j = .ok (wrapInt a (base.val ^ j.toNat)) := by
    unfold power
    rw [powerBySquaring_monoidPow bigOps JuliaLean.base.int.mul
      (JuliaLean.base.int.lit a 1) (fun z => pure (JuliaLean.base.int.neg z)) (fun z => decide (z.val = 1))
      throwPowerDomain_Integer (jint_mul_assoc a) (jint_mul_one_left a)
      (jint_mul_one_right a) bigOps_trailing_shift base j hj]
    simp only [Functor.map, Except.map]
    simp [bigOps]
    rw [monoidPow_jint_val a base j.toNat]
  have hbaseCast : (base.val.toNat : Int) = base.val :=
    Int.toNat_of_nonneg (by omega)
  have hinputCast : (input.val.toNat : Int) = input.val :=
    Int.toNat_of_nonneg (by omega)
  have hbaseNat : 2 ≤ base.val.toNat := by
    have hcast : (2 : Int) ≤ (base.val.toNat : Int) := by rw [hbaseCast]; omega
    exact_mod_cast hcast
  have hinputNat : 1 ≤ input.val.toNat := by
    have hcast : (1 : Int) ≤ (input.val.toNat : Int) := by rw [hinputCast]; omega
    exact_mod_cast hcast
  obtain ⟨k, hlowNat, hhighNat⟩ :=
    exists_floorPower base.val.toNat input.val.toNat hbaseNat hinputNat
  have hpowCast (j : Nat) : ((base.val.toNat)^j : Int) = base.val^j := by
    simp [hbaseCast]
  have hlow : base.val^k ≤ input.val := by
    have hcast : ((base.val.toNat)^k : Int) ≤ (input.val.toNat : Int) :=
      Int.ofNat_le.mpr hlowNat
    rw [hpowCast, hinputCast] at hcast
    exact hcast
  have hhigh : input.val < base.val^(k + 1) := by
    have hcast : (input.val.toNat : Int) < ((base.val.toNat)^(k + 1) : Int) :=
      Int.ofNat_lt.mpr hhighNat
    rw [hinputCast, hpowCast] at hcast
    exact hcast
  obtain ⟨n, hcall, hn, _⟩ := hlog base input k hbase hx hlow hhigh
  have hp := powerWrapped n hn
  have hbelow : decide (input.val < 1) = false := by
    simp [show ¬ input.val < 1 by omega]
  have hsmall : decide (base.val ≤ 1) = false := by
    simp [show ¬ base.val ≤ 1 by omega]
  have htwo : decide (base.val = 2) = false := by simp [hbaseTwo]
  have hmax : decide (input.val > a.max) = true := by simp [hlarge]
  have hmodel : prevpowBits log base input =
      prevpow (fun x => decide (x.val < 1)) (fun aa => decide (aa.val = 2)) true
        (fun x => pure (prevpow2Bits x).val) (fun aa => decide (aa.val ≤ 1)) log power
        (fun _ => hasTypeMax true true) (fun x _ => decide (x.val > a.max)) true
        mulChecked (fun p x => decide (p ≤ x.val)) base input := by
    rfl
  rw [hmodel]
  simp [prevpow, hbelow, htwo, hsmall, hcall, hp, hmax, hasTypeMax,
    domainError, Bind.bind, Except.bind, Pure.pure, Except.pure]

theorem prevpowExact_real_proven :
    ∀ (A X : Type) (valA : A → Int) (valX : X → Int) (log : A → X → Jl Int),
      FloorLogRealLaw valA valX log →
      ∀ (base : A) (input : X),
        let result := prevpow (fun x => decide (valX x < 1)) (fun _ => false) false
          (fun _ => .error (.methodError "_prevpow2"))
          (fun a => decide (valA a ≤ 1)) log (fun a n => pure ((valA a)^n.toNat))
          (fun _ => false) (fun _ _ => false) false
          (fun a p => pure (valA a * p, false)) (fun p x => decide (p ≤ valX x)) base input
        if valX input < 1 ∨ valA base ≤ 1 then domainError result
        else ∀ k : Nat, (valA base)^k ≤ valX input →
          valX input < (valA base)^(k + 1) → result = .ok ((valA base)^k) := by
  intro A X valA valX log hlog base input
  dsimp only
  by_cases hbad : valX input < 1 ∨ valA base ≤ 1
  · rcases hbad with hlt | hbaseBad
    · simp [prevpow, hlt, domainError]
    · by_cases hlt : valX input < 1
      · simp [prevpow, hlt, domainError]
      · simp [prevpow, hlt, hbaseBad, domainError]
  · rw [if_neg hbad]
    have hbase : 1 < valA base := by omega
    have hx : 1 ≤ valX input := by omega
    have hbelow : decide (valX input < 1) = false := by
      simp [show ¬ valX input < 1 by omega]
    have hsmall : decide (valA base ≤ 1) = false := by
      simp [show ¬ valA base ≤ 1 by omega]
    intro k hpow hpowlt
    obtain ⟨n, hcall, hnonneg, hnear⟩ :=
      hlog base input k hbase hx hpow hpowlt
    rcases hnear with hprev | heq | hnext
    · have hkpos : 0 < k := by omega
      have hnNat : n.toNat = k - 1 := by
        have hcast := Int.toNat_of_nonneg hnonneg
        rw [hprev] at hcast
        omega
      have hn1Nat : (n + 1).toNat = k := by
        have hcast := Int.toNat_of_nonneg (show 0 ≤ n + 1 by omega)
        rw [hprev] at hcast
        omega
      simp [prevpow, hbelow, hsmall, hcall, hnNat, hn1Nat, hpow, hpowlt,
        Bind.bind, Except.bind, Pure.pure, Except.pure]
    · have hnNat : n.toNat = k := by
        have hcast := Int.toNat_of_nonneg hnonneg
        rw [heq] at hcast
        omega
      have hn1Nat : (n + 1).toNat = k + 1 := by
        have hcast := Int.toNat_of_nonneg (show 0 ≤ n + 1 by omega)
        rw [heq] at hcast
        omega
      have hnotK1 : ¬ valA base^(k + 1) ≤ valX input := by omega
      simp [prevpow, hbelow, hsmall, hcall, hnNat, hn1Nat, hpow, hnotK1,
        Bind.bind, Except.bind, Pure.pure, Except.pure]
    · have hnNat : n.toNat = k + 1 := by
        have hcast := Int.toNat_of_nonneg hnonneg
        rw [hnext] at hcast
        omega
      have hn1Nat : (n + 1).toNat = k + 2 := by
        have hcast := Int.toNat_of_nonneg (show 0 ≤ n + 1 by omega)
        rw [hnext] at hcast
        omega
      have hnm1Nat : (n - 1).toNat = k := by
        have hcast := Int.toNat_of_nonneg (show 0 ≤ n - 1 by omega)
        rw [hnext] at hcast
        omega
      have hp1 : (valA base)^(k + 1) = (valA base)^k * valA base := by
        rw [Int.pow_succ]
      have hp2 : (valA base)^(k + 2) = (valA base)^(k + 1) * valA base := by
        change (valA base)^((k + 1) + 1) = _
        exact Int.pow_succ _ _
      have hnextPow : (valA base)^(k + 1) < (valA base)^(k + 2) := by
        have hb : 1 < valA base := by omega
        have hbasePos : 0 < valA base := by omega
        have hpowPos : 0 < (valA base)^k := Int.pow_pos hbasePos
        have hmulPos : 0 < (valA base)^k * valA base :=
          Int.mul_pos hpowPos hbasePos
        have hmul : (valA base)^k * valA base <
            ((valA base)^k * valA base) * valA base := by
          simpa using Int.mul_lt_mul_of_pos_left hb hmulPos
        calc
          (valA base)^(k + 1) = (valA base)^k * valA base := hp1
          _ < ((valA base)^k * valA base) * valA base := hmul
          _ = (valA base)^(k + 2) := by rw [← hp1, ← hp2]
      have htooHigh : valX input < (valA base)^(k + 2) := by omega
      have hnotK1 : ¬ valA base^(k + 1) ≤ valX input := by omega
      have hnotK2 : ¬ valA base^(k + 2) ≤ valX input := by omega
      simp [prevpow, hbelow, hsmall, hcall, hnNat, hn1Nat, hnm1Nat, hpow,
        hnotK1, hnotK2, Bind.bind, Except.bind, Pure.pure, Except.pure]

theorem prevpowExact_proven : PrevpowExact := by
  refine ⟨?_, prevpowExact_real_proven⟩
  intro a x log hlog base input
  by_cases hbad : input.val < 1 ∨ base.val ≤ 1
  · rw [if_pos hbad]
    rcases hbad with hlt | hsmall
    · simp [prevpowBits, prevpow, hlt, domainError]
    · by_cases hlt : input.val < 1
      · simp [prevpowBits, prevpow, hlt, domainError]
      · have htwo : base.val ≠ 2 := by omega
        simp [prevpowBits, prevpow, hlt, hsmall, htwo, domainError]
  · rw [if_neg hbad]
    by_cases hlarge : base.val ≠ 2 ∧ input.val > a.max
    · rw [if_pos hlarge]
      exact prevpowBits_oversized_domainError a x log hlog base input
        (by omega) hlarge.1 (by omega) hlarge.2
    · rw [if_neg hlarge]
      by_cases htwo : base.val = 2
      · obtain ⟨y, k, hresult, hpow, hle, hlt⟩ :=
          prevpowExact_two_base_proven a x log hlog base input htwo (by omega)
        exact ⟨y, k, hresult, hpow, hle, hlt⟩
      · have hinputMax : input.val ≤ a.max := by
          by_cases h : input.val ≤ a.max
          · exact h
          · exact False.elim (hlarge ⟨by omega, by omega⟩)
        exact prevpowExact_nonbinary_proven a x log hlog base input
          (by omega) htwo (by omega) hinputMax
private theorem unsignedAbsVal_positive {t : IntTy} (x : JInt t) (hx : 0 < x.val) :
    (JuliaLean.base.int.unsigned (JuliaLean.base.int.abs x)).val = x.val := by
  by_cases hs : t.signed = true
  · rw [JuliaLean.Proofs.base.int.unsigned_abs_val hs]
    exact Int.natAbs_of_nonneg (by omega)
  · have hu : t.toUnsigned = t := by
      cases t <;> simp_all [IntTy.toUnsigned, IntTy.signed]
    have habs : JuliaLean.base.int.abs x = x := by
      simp [JuliaLean.base.int.abs, hs, JuliaLean.base.int.abs_Unsigned]
    rw [habs, JuliaLean.Proofs.base.int.unsigned_val, hu]
    exact JuliaLean.Proofs.base.int.wrapInt_val x

private theorem topBit_unsignedAbs_positive {t : IntTy} (x : JInt t) (hx : 0 < x.val) :
    topBit (JuliaLean.base.int.unsigned (JuliaLean.base.int.abs x)) =
      x.val.toNat.log2 + 1 := by
