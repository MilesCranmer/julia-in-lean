@[simp] private theorem clampBangYields_append {A Iter Index State V SetResult : Type}
    (xs ys : List (ClampBangCall A Iter Index State V SetResult)) :
    clampBangYields (xs ++ ys) = clampBangYields xs ++ clampBangYields ys := by
  unfold clampBangYields; exact List.filterMap_append

@[simp] private theorem clampBangReadIndices_append {A Iter Index State V SetResult : Type}
    (xs ys : List (ClampBangCall A Iter Index State V SetResult)) :
    clampBangReadIndices (xs ++ ys) = clampBangReadIndices xs ++ clampBangReadIndices ys := by
  unfold clampBangReadIndices; exact List.filterMap_append

@[simp] private theorem clampBangWriteIndices_append {A Iter Index State V SetResult : Type}
    (xs ys : List (ClampBangCall A Iter Index State V SetResult)) :
    clampBangWriteIndices (xs ++ ys) = clampBangWriteIndices xs ++ clampBangWriteIndices ys := by
  unfold clampBangWriteIndices; exact List.filterMap_append

@[simp] private theorem clampBangStepStates_append {A Iter Index State V SetResult : Type}
    (xs ys : List (ClampBangCall A Iter Index State V SetResult)) :
    clampBangStepStates (xs ++ ys) = clampBangStepStates xs ++ clampBangStepStates ys := by
  unfold clampBangStepStates; exact List.filterMap_append

@[simp] private theorem clampBangYields_singleton {A Iter Index State V SetResult : Type}
    (c : ClampBangCall A Iter Index State V SetResult) :
    clampBangYields [c] = match c with | .step _ _ (.ok (some pair)) => [pair] | _ => [] := by
  cases c with | step _ _ r => (cases r with | error _ => rfl | ok o => cases o <;> rfl) | _ => rfl

@[simp] private theorem clampBangReadIndices_singleton {A Iter Index State V SetResult : Type}
    (c : ClampBangCall A Iter Index State V SetResult) :
    clampBangReadIndices [c] = match c with | .read _ _ i _ => [i] | _ => [] := by cases c <;> rfl

@[simp] private theorem clampBangWriteIndices_singleton {A Iter Index State V SetResult : Type}
    (c : ClampBangCall A Iter Index State V SetResult) :
    clampBangWriteIndices [c] = match c with | .write _ _ _ i _ => [i] | _ => [] := by cases c <;> rfl

@[simp] private theorem clampBangStepStates_singleton {A Iter Index State V SetResult : Type}
    (c : ClampBangCall A Iter Index State V SetResult) :
    clampBangStepStates [c] = match c with | .step _ s _ => [s] | _ => [] := by cases c <;> rfl

private theorem clampSelected_lift {W E V Ty Other : Type}
    (ops : ClampDispatchOps W V Ty Other) (v lo hi : V) (wt : W × List E) :
    clampSelected (tailLiftClampDispatch ops) v lo hi wt =
      tailPreserveLog (clampSelected ops v lo hi) wt := by
  rcases wt with ⟨w, tr⟩
  dsimp only [clampSelected, tailLiftClampDispatch]
  cases ops.select v lo hi with
  | custom method => rfl
  | generic =>
    dsimp only [clampGeneric, tailLiftClampOps]
    simp only [io_bind2, tailPreserveLog_apply, gcdxAssertBool_apply]
    cases ops.generic.promoteType (ops.generic.typeOf v) (ops.generic.typeOf lo) (ops.generic.typeOf hi) w with
    | none => rfl
    | some r1 =>
      cases r1 with
      | error e1 => rcases e1 with ⟨_, _⟩; rfl
      | ok vw1 =>
        rcases vw1 with ⟨T, w1⟩
        dsimp only
        cases ops.generic.greater v hi w1 with
        | none => rfl
        | some r2 =>
          cases r2 with
          | error e2 => rcases e2 with ⟨_, _⟩; rfl
          | ok vw2 =>
            rcases vw2 with ⟨g, w2⟩
            cases g with
            | inr _ => rfl
            | inl gb =>
              cases gb with
              | true => rfl
              | false =>
                simp only [Bool.false_eq_true, ↓reduceIte, io_bind2, tailPreserveLog_apply, gcdxAssertBool_apply]
                cases ops.generic.less v lo w2 with
                | none => rfl
                | some r3 =>
                  cases r3 with
                  | error e3 => rcases e3 with ⟨_, _⟩; rfl
                  | ok vw3 =>
                    rcases vw3 with ⟨l, w3⟩
                    cases l with
                    | inr _ => rfl
                    | inl lb => cases lb <;> rfl
private def cbIndInput {A Iter Index State V SetResult : Type} :
    ClampBangCall A Iter Index State V SetResult → Option A
  | .indices input _ => some input
  | _ => none

private def cbIndOutput {A Iter Index State V SetResult : Type} :
    ClampBangCall A Iter Index State V SetResult → Option Iter
  | .indices _ (.ok value) => some value
  | _ => none

@[simp] private theorem cbIndInput_step {A Iter Index State V SetResult : Type}
    (it : Iter) (st : Option State) (res : Except JuliaLean.base.io.Error (Option (Index × State))) :
    cbIndInput (ClampBangCall.step (A := A) (V := V) (SetResult := SetResult) it st res) = none := rfl

@[simp] private theorem cbIndInput_read {A Iter Index State V SetResult : Type}
    (fl : Bool) (ar : A) (idx : Index) (res : Except JuliaLean.base.io.Error V) :
    cbIndInput (ClampBangCall.read (Iter := Iter) (State := State) (SetResult := SetResult) fl ar idx res) = none := rfl

@[simp] private theorem cbIndInput_write {A Iter Index State V SetResult : Type}
    (fl : Bool) (ar : A) (val : V) (idx : Index) (res : Except JuliaLean.base.io.Error SetResult) :
    cbIndInput (ClampBangCall.write (Iter := Iter) (State := State) fl ar val idx res) = none := rfl

@[simp] private theorem cbIndOutput_step {A Iter Index State V SetResult : Type}
    (it : Iter) (st : Option State) (res : Except JuliaLean.base.io.Error (Option (Index × State))) :
    cbIndOutput (ClampBangCall.step (A := A) (V := V) (SetResult := SetResult) it st res) = none := rfl

@[simp] private theorem cbIndOutput_read {A Iter Index State V SetResult : Type}
    (fl : Bool) (ar : A) (idx : Index) (res : Except JuliaLean.base.io.Error V) :
    cbIndOutput (ClampBangCall.read (Iter := Iter) (State := State) (SetResult := SetResult) fl ar idx res) = none := rfl

@[simp] private theorem cbIndOutput_write {A Iter Index State V SetResult : Type}
    (fl : Bool) (ar : A) (val : V) (idx : Index) (res : Except JuliaLean.base.io.Error SetResult) :
    cbIndOutput (ClampBangCall.write (Iter := Iter) (State := State) fl ar val idx res) = none := rfl

private theorem filterMap_congr_eq {α β : Type} {f g : α → Option β}
    (l : List α) (h : ∀ x, f x = g x) :
    l.filterMap f = l.filterMap g := by
  induction l with
  | nil => rfl
  | cons a as ih => simp [List.filterMap, h a, ih]

private def ClampBangBaseInv {A Iter Index State V SetResult : Type}
    (x : A) (iterator : Iter) (calls : List (ClampBangCall A Iter Index State V SetResult)) : Prop :=
  calls.filterMap cbIndInput = [x] ∧
  calls.filterMap cbIndOutput = [iterator] ∧
  (∀ flag array index result, ClampBangCall.read flag array index result ∈ calls →
    flag = true ∧ array = x) ∧
  (∀ flag array value index result, ClampBangCall.write flag array value index result ∈ calls →
    flag = true ∧ array = x) ∧
  (∀ it state result, ClampBangCall.step it state result ∈ calls → it = iterator)

private theorem clampBangBaseInv_to_identity {A Iter Index State V SetResult : Type}
    {x : A} {iterator : Iter} {calls : List (ClampBangCall A Iter Index State V SetResult)}
    (h : ClampBangBaseInv x iterator calls) :
    ClampBangIdentityInvariant x calls := by
  rcases h with ⟨hind, hindOk, hread, hwrite, hstepIt⟩
  refine ⟨?_, hread, hwrite, ?_⟩
  · rw [← hind]
    apply filterMap_congr_eq
    intro c; cases c <;> rfl
  · intro it state result hm
    rw [hstepIt it state result hm, ← hindOk]
    apply filterMap_congr_eq
    intro c; cases c with
    | indices _ r => cases r <;> rfl
    | _ => rfl

private def ClampBangLoopInv {W A Iter Index State V SetResult : Type}
    (x : A) (iterator : Iter) :
    Option State → (W × List (ClampBangCall A Iter Index State V SetResult)) → Prop
  | st, (_, calls) =>
      calls.filterMap cbIndInput = [x] ∧
      calls.filterMap cbIndOutput = [iterator] ∧
      (∀ flag array index result, ClampBangCall.read flag array index result ∈ calls →
        flag = true ∧ array = x) ∧
      (∀ flag array value index result, ClampBangCall.write flag array value index result ∈ calls →
        flag = true ∧ array = x) ∧
      (∀ it state result, ClampBangCall.step it state result ∈ calls → it = iterator) ∧
      clampBangReadIndices calls = (clampBangYields calls).map Prod.fst ∧
      clampBangWriteIndices calls = (clampBangYields calls).map Prod.fst ∧
      none :: (clampBangYields calls).map (some ∘ Prod.snd) = clampBangStepStates calls ++ [st] ∧
      calls.filterMap clampBangCallError = []

private def clampBangIterStep {W A Iter Index State V Ty Other SetResult : Type}
    (ops : ClampBangOps W A Iter Index State V Ty Other SetResult)
    (iterator : Iter) : Option State → JuliaLean.base.io.M W (Option (Index × State))
  | none => ops.iteration.first iterator
  | some state => ops.iteration.next iterator state

private def clampBangStep {W A Iter Index State V Ty Other SetResult : Type}
    (ops : ClampBangOps W A Iter Index State V Ty Other SetResult)
    (x : A) (lo hi : V) (iterator : Iter) (st : Option State) :
    JuliaLean.base.io.M (W × List (ClampBangCall A Iter Index State V SetResult)) (Sum A (Option State)) := do
  let step ← recordCall (ClampBangCall.step iterator st) (clampBangIterStep ops iterator st)
  match step with
  | none => pure (Sum.inl x)
  | some (index, next) => do
    let value ← (observeClampBangOps ops).getindex true x index
    let result ← clampSelected (observeClampBangOps ops).clamp value lo hi
    let _ ← (observeClampBangOps ops).setindex true x result index
    pure (Sum.inr (some next))

private theorem of_eq_step {α : Type} {r1 r2 : α} {P : α → Prop} (heq : r1 = r2) (h : P r2) : P r1 :=
  heq ▸ h

theorem clampBangOpenMutationAccounting_proven : ClampBangOpenMutationAccounting := by
  intro W A Iter Index State V Ty Other SetResult ops x lo hi world
  unfold clampBangGeneric
  have h1_eq : (observeClampBangOps ops).eachindex x (world, []) =
      recordCall (.indices x) (ops.eachindex x) (world, []) := rfl
  rw [io_bind2, h1_eq, recordCall_apply]
  cases heach : ops.eachindex x world with
  | none => trivial
  | some r0 =>
    cases r0 with
    | error e0 =>
      rcases e0 with ⟨err, w0⟩
      dsimp [ClampBangIdentityInvariant, clampBangYields, clampBangReadIndices,
        clampBangWriteIndices, clampBangStepStates, clampBangCallError, TailPrefix]
      refine ⟨⟨rfl, ?_, ?_, ?_⟩, ⟨[], rfl⟩, ⟨[], rfl⟩, ⟨[none], rfl⟩, by simp, Or.inr ⟨rfl, rfl⟩⟩
      · intro _ _ _ _ h; simp at h
      · intro _ _ _ _ _ h; simp at h
      · intro _ _ _ h; simp at h
    | ok v0 =>
      rcases v0 with ⟨iterator, w0⟩
      dsimp only [List.nil_append]
      cases h : JuliaLean.base.io.whileLoop _ none (w0, [ClampBangCall.indices x (.ok iterator)]) with
      | none => trivial
      | some out =>
      refine ioWhileLoop_of_eq_cases' (clampBangStep ops x lo hi iterator) h (ClampBangLoopInv x iterator)
        (fun out => match out with
          | .ok (result, (_, calls)) =>
              result = x ∧ ClampBangBaseInv x iterator calls ∧
              clampBangReadIndices calls = (clampBangYields calls).map Prod.fst ∧
              clampBangWriteIndices calls = clampBangReadIndices calls ∧
              clampBangStepStates calls = none :: (clampBangYields calls).map (some ∘ Prod.snd) ∧
              calls.filterMap clampBangCallError = []
          | .error (error, (_, calls)) =>
              ClampBangBaseInv x iterator calls ∧
              TailPrefix (clampBangWriteIndices calls) (clampBangReadIndices calls) ∧
              TailPrefix (clampBangReadIndices calls) ((clampBangYields calls).map Prod.fst) ∧
              TailPrefix (clampBangStepStates calls)
                (none :: (clampBangYields calls).map (some ∘ Prod.snd)) ∧
              (clampBangYields calls).length ≤ (clampBangWriteIndices calls).length + 1 ∧
              (calls.filterMap clampBangCallError = [] ∨
               (calls.filterMap clampBangCallError = [error] ∧
                calls.getLast?.bind clampBangCallError = some error)))
        ?_ ?_ (fun s w => by cases s <;> rfl) ?_
      · rcases out with ⟨_, _, _⟩ | ⟨_, _, _⟩
        · rintro ⟨h1, h2, h3, h4, h5, h6⟩
          exact ⟨clampBangBaseInv_to_identity h1, h2, h3, h4, h5, h6⟩
        · rintro ⟨h1, h2, h3, h4, h5, h6⟩
          exact ⟨h1, clampBangBaseInv_to_identity h2, h3, h4, h5, h6⟩
      · refine ⟨rfl, rfl, ?_, ?_, ?_, rfl, rfl, rfl, rfl⟩
        · intro _ _ _ _ hm; simp at hm
        · intro _ _ _ _ _ hm; simp at hm
        · intro _ _ _ hm; simp at hm
      · rintro st ⟨w, calls⟩ ⟨hind, hindOk, hread, hwrite, hstepIt, hreadEq, hwriteEq, hstatesEq, herr⟩
        unfold clampBangStep
        rw [io_bind2, recordCall_apply]
        cases hst : clampBangIterStep ops iterator st w with
        | none => trivial
        | some rst =>
          cases rst with
          | error est =>
            rcases est with ⟨err, w1⟩
            dsimp [ClampBangBaseInv, TailPrefix]
            simp only [clampBangYields_append, clampBangReadIndices_append,
              clampBangWriteIndices_append, clampBangStepStates_append, List.filterMap_append,
              hind, hindOk, hreadEq, hwriteEq, ← hstatesEq, herr,
              clampBangYields_singleton, clampBangReadIndices_singleton,
              clampBangWriteIndices_singleton, clampBangStepStates_singleton,
              List.filterMap_cons, List.filterMap_nil, clampBangCallError, List.append_nil]
            refine ⟨⟨by simp, by simp, ?_, ?_, ?_⟩, ⟨[], by simp⟩, ⟨[], by simp⟩, ⟨[], by simp⟩, by simp,
              Or.inr ⟨by simp, by simp [clampBangCallError]⟩⟩
            · intro fl ar idx res hm
              rcases List.mem_append.mp hm with hm | hm
              · exact hread fl ar idx res hm
              · simp at hm
            · intro fl ar val idx res hm
              rcases List.mem_append.mp hm with hm | hm
              · exact hwrite fl ar val idx res hm
              · simp at hm
            · intro it s res hm
              rcases List.mem_append.mp hm with hm | hm
              · exact hstepIt it s res hm
              · simp at hm; rcases hm with ⟨rfl, _⟩; rfl
          | ok vst =>
            rcases vst with ⟨stepVal, w1⟩
            cases stepVal with
            | none =>
              simp only [io_pure2]
              dsimp [ClampBangBaseInv]
              simp only [clampBangYields_append, clampBangReadIndices_append,
                clampBangWriteIndices_append, clampBangStepStates_append, List.filterMap_append,
                hind, hindOk, hreadEq, hwriteEq, ← hstatesEq, herr,
                clampBangYields_singleton, clampBangReadIndices_singleton,
                clampBangWriteIndices_singleton, clampBangStepStates_singleton,
                List.filterMap_cons, List.filterMap_nil, clampBangCallError, List.append_nil]
              refine ⟨by simp, ⟨by simp, by simp, ?_, ?_, ?_⟩, by simp, by simp, by simp, by simp⟩
              · intro fl ar idx res hm
                rcases List.mem_append.mp hm with hm | hm
                · exact hread fl ar idx res hm
                · simp at hm
              · intro fl ar val idx res hm
                rcases List.mem_append.mp hm with hm | hm
                · exact hwrite fl ar val idx res hm
                · simp at hm
              · intro it s res hm
                rcases List.mem_append.mp hm with hm | hm
                · exact hstepIt it s res hm
                · simp at hm; rcases hm with ⟨rfl, _⟩; rfl
            | some pair =>
              rcases pair with ⟨index, next⟩
              dsimp [observeClampBangOps]
              simp only [io_bind2, recordCall_apply, clampSelected_lift, tailPreserveLog_apply, io_pure2]
              cases hget : ops.getindex true x index w1 with
              | none => trivial
              | some rget =>
                cases rget with
                | error eget =>
                  rcases eget with ⟨err, w2⟩
                  dsimp [ClampBangBaseInv, TailPrefix]
                  simp only [List.append_assoc, clampBangYields_append, clampBangReadIndices_append,
                    clampBangWriteIndices_append, clampBangStepStates_append, List.filterMap_append,
                    hind, hindOk, hreadEq, hwriteEq, herr,
                    clampBangYields_singleton, clampBangReadIndices_singleton,
                    clampBangWriteIndices_singleton, clampBangStepStates_singleton,
                    List.filterMap_cons, List.filterMap_nil, clampBangCallError,
                    List.append_nil, List.nil_append, List.map_append, List.map]
                  refine ⟨⟨by simp, by simp, ?_, ?_, ?_⟩, ⟨[index], by simp⟩, ⟨[], by simp⟩,
                    ⟨[some next], by rw [← List.cons_append, hstatesEq, List.append_assoc]; rfl⟩,
                    by simp, Or.inr ⟨by simp, by simp [clampBangCallError]⟩⟩
                  · intro fl ar idx res hm
                    rcases List.mem_append.mp hm with hm | hm
                    · exact hread fl ar idx res hm
                    · simp at hm; rcases hm with ⟨rfl, rfl, _⟩; exact ⟨rfl, rfl⟩
                  · intro fl ar val idx res hm
                    rcases List.mem_append.mp hm with hm | hm
                    · exact hwrite fl ar val idx res hm
                    · simp at hm
                  · intro it s res hm
                    rcases List.mem_append.mp hm with hm | hm
                    · exact hstepIt it s res hm
                    · simp at hm; rcases hm with ⟨rfl, _⟩; rfl
                | ok vget =>
                  rcases vget with ⟨val, w2⟩
                  dsimp
                  cases hcl : clampSelected ops.clamp val lo hi w2 with
                  | none => trivial
                  | some rcl =>
                    cases rcl with
                    | error ecl =>
                      rcases ecl with ⟨err, w3⟩
                      dsimp [ClampBangBaseInv, TailPrefix]
                      simp only [List.append_assoc, clampBangYields_append, clampBangReadIndices_append,
                        clampBangWriteIndices_append, clampBangStepStates_append, List.filterMap_append,
                        hind, hindOk, hreadEq, hwriteEq, herr,
