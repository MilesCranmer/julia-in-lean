def observeLcmArrayOps {W A L Ty V R : Type}
    (ops : LcmArrayOps (JuliaLean.base.io.M W) A L Ty V R) :
    LcmArrayOps (JuliaLean.base.io.M (W × List (LcmArrayEvent W A L Ty V R)))
      A L Ty V R where
  length array := observeArrayCall (.length array) (ops.length array)
