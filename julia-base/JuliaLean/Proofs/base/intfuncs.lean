/-- Every successful digit array reconstructs the input with the documented least-significant
first order, digit ranges and minimal padded length. Fixed and unbounded input/base combinations
are included; component and array-length conversion errors are explicit. -/
def DigitsRoundtrip : Prop :=
  (∀ (t b p e : IntTy) (n : JInt t) (base : JInt b) (pad : JInt p),
    2 ≤ base.val.natAbs → (base.val.natAbs : Int) - 1 ≤ e.max →
    (base.val > 0 → n.val < 0 → e.signed = true) →
    if base.val > 1 ∧ ¬ fits .i64 base.val ∧ n.val ≠ 0 then
      inexactError (digitsBits digitCallees e n base pad)
    else if pad.val > IntTy.max .i64 then inexactError (digitsBits digitCallees e n base pad)
    else if b.signed = true ∧ base.val = b.min then domainError (digitsBits digitCallees e n base pad)
    else ∃ a, digitsBits digitCallees e n base pad = .ok a ∧
      evalpoly base.val (a.values.map Subtype.val) = n.val ∧
      DigitCount n.val base.val pad.val a.values.length ∧
      DigitRange n.val base.val (a.values.map Subtype.val)) ∧
  (∀ decimal (n base pad : Int), 2 ≤ base.natAbs →
    if 0 < base ∧ ¬ fits .i64 base ∧ n ≠ 0 then inexactError (bigDigits decimal n base pad)
    else if pad > IntTy.max .i64 then inexactError (bigDigits decimal n base pad)
    else ∃ a, bigDigits decimal n base pad = .ok a ∧
      evalpoly base a.values = n ∧ DigitCount n base pad a.values.length ∧
      DigitRange n base a.values) ∧
  (∀ decimal (b p e : IntTy) (n : Int) (base : JInt b) (pad : JInt p),
    2 ≤ base.val.natAbs → (base.val.natAbs : Int) - 1 ≤ e.max →
    (0 < base.val → n < 0 → e.signed = true) →
    pad.val ≤ IntTy.max .i64 → (0 < base.val → fits .i64 base.val) →
    (b.signed = true → base.val ≠ b.min) →
    ∃ a, bigDigitsFixedBase decimal e n base pad = .ok a ∧
      evalpoly base.val (a.values.map Subtype.val) = n ∧
      DigitCount n base.val pad.val a.values.length ∧
      DigitRange n base.val (a.values.map Subtype.val)) ∧
  (∀ (t p : IntTy) (n : JInt t) (base : Int) (pad : JInt p),
    2 ≤ base.natAbs → pad.val ≤ IntTy.max .i64 → (0 < base → fits .i64 base) →
    ∃ a, fixedDigitsBigBase n base pad = .ok a ∧
      evalpoly base a.values = n.val ∧ DigitCount n.val base pad.val a.values.length ∧
      DigitRange n.val base a.values)
