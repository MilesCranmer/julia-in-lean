      dsimp only [Bind.bind, Except.bind, Pure.pure, Except.pure]
      rw [ndZeroLitVal]
      rfl
  · rw [ite_eq_right (by omega), ite_eq_left hpos]
    unfold ndigitsPositiveBits ndigitsPositive
    rw [ite_eq_left (ndZeroLitVal t)]
    rfl

private theorem ndValidOfMagnitude (z : Int) (h : 2 ≤ z.natAbs) : z < -1 ∨ z > 1 := by
