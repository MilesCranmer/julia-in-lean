-- 30. intfuncs-real-promotion-dispatch-provenance
private theorem promotionObservation_of_op {W A B P R : Type}
    (ops : PromoteApplyOps (JuliaLean.base.io.M W) A B P R)
    (fn : NumberTheoryFunction) (a : A) (b : B) (world : W) :
    PromotionObservation fn a b world
      (do
        let promoted ← (observePromotionOps ops).promote a b
        (observePromotionOps ops).applyIterate .baseIterate fn promoted) := by
  unfold PromotionObservation observePromotionOps
  simp only [io_bind, recordStateCall, recordCall]
  cases hp : ops.promote a b world with
  | none => trivial
  | some rp =>
    cases rp with
    | error ep =>
      rcases ep with ⟨err, w1⟩
      dsimp [PromotionTraceInvariant, PromotionTerminalInvariant,
        promotionInputs, promotionOutputs, promotionApplicationOutputs,
        promotionBefore, promotionAfter, promotionError]
      refine ⟨⟨by decide, rfl, rfl, rfl, adj_1 _ _, ?_⟩, rfl, _, rfl, rfl⟩
      intro _ _ _ _ _ _ hmem; simp at hmem
    | ok vp =>
      rcases vp with ⟨pval, w1⟩
      dsimp
      cases ha : ops.applyIterate .baseIterate fn pval w1 with
      | none => trivial
      | some ra =>
        cases ra with
        | error ea =>
          rcases ea with ⟨err, w2⟩
          dsimp [PromotionTraceInvariant, PromotionTerminalInvariant,
            promotionInputs, promotionOutputs, promotionApplicationOutputs,
            promotionBefore, promotionAfter, promotionError]
          refine ⟨⟨by decide, rfl, rfl, rfl, adj_2 _ _ _ rfl, ?_⟩, rfl, _, rfl, rfl⟩
          intro _ _ _ _ _ _ hmem
          rcases List.mem_cons.mp hmem with h1 | hmem
          · cases h1
          · simp at hmem; rcases hmem with ⟨_, rfl, rfl, rfl, _, _⟩
            exact ⟨rfl, rfl, rfl⟩
        | ok va =>
          rcases va with ⟨rval, w2⟩
          dsimp [PromotionTraceInvariant, PromotionTerminalInvariant,
            promotionInputs, promotionOutputs, promotionApplicationOutputs,
            promotionBefore, promotionAfter, promotionError]
          refine ⟨⟨by decide, rfl, rfl, rfl, adj_2 _ _ _ rfl, ?_⟩, rfl, rfl⟩
          intro _ _ _ _ _ _ hmem
          rcases List.mem_cons.mp hmem with h1 | hmem
          · cases h1
          · simp at hmem; rcases hmem with ⟨_, rfl, rfl, rfl, _, _⟩
            exact ⟨rfl, rfl, rfl⟩

