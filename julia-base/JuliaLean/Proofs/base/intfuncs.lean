/-- A selected call's actual state and outcome. Only value-producing
operations carry a value; predicate observations retain their error/state.
This is observation data, not an expected arithmetic implementation. -/
structure PowermodOutcomeEvent (W V : Type) where
  operation : String
  before : W
  outcome : Except JuliaLean.base.io.Error (Option V)
  after : W

def observePowermodOutcomeCall {W V A : Type} (name : String)
    (view : A → Option V) (action : JuliaLean.base.io.M W A) :
    JuliaLean.base.io.M (W × List (PowermodOutcomeEvent W V)) A :=
  observeArrayCall (fun snapshot =>
    ⟨name, snapshot.before, snapshot.outcome.map view, snapshot.after⟩) action

def observePowermodOutcomeOps {W V Ty Other : Type} (ops : PowermodOps W V Ty Other) :
    PowermodOps (W × List (PowermodOutcomeEvent W V)) V Ty Other where
  typeOf := ops.typeOf
  isInstance := ops.isInstance
  equalLiteral := fun a b => observePowermodOutcomeCall "equalLiteral" (fun _ => none) (ops.equalLiteral a b)
  equal := fun a b => observePowermodOutcomeCall "equal" (fun _ => none) (ops.equal a b)
  lessLiteral := fun a b => observePowermodOutcomeCall "lessLiteral" (fun _ => none) (ops.lessLiteral a b)
  greaterLiteral := fun a b => observePowermodOutcomeCall "greaterLiteral" (fun _ => none) (ops.greaterLiteral a b)
  greater := fun a b => observePowermodOutcomeCall "greater" (fun _ => none) (ops.greater a b)
  notEqualLiteral := fun a b => observePowermodOutcomeCall "notEqualLiteral" (fun _ => none) (ops.notEqualLiteral a b)
  isodd := fun a => observePowermodOutcomeCall "isodd" (fun _ => none) (ops.isodd a)
  iszero := fun a => observePowermodOutcomeCall "iszero" (fun _ => none) (ops.iszero a)
  neg := fun a => observePowermodOutcomeCall "neg" some (ops.neg a)
  divLiteral := fun a b => observePowermodOutcomeCall "divLiteral" some (ops.divLiteral a b)
  one := fun a => observePowermodOutcomeCall "one" some (ops.one a)
  zero := fun a => observePowermodOutcomeCall "zero" some (ops.zero a)
  uabs := fun a => observePowermodOutcomeCall "uabs" some (ops.uabs a)
  mod := fun a b => observePowermodOutcomeCall "mod" some (ops.mod a b)
  oftype := fun a b => observePowermodOutcomeCall "oftype" some (ops.oftype a b)
  widemul := fun a b => observePowermodOutcomeCall "widemul" some (ops.widemul a b)
  mul := fun a b => observePowermodOutcomeCall "mul" some (ops.mul a b)
  add := fun a b => observePowermodOutcomeCall "add" some (ops.add a b)
  bitAndLiteral := fun a b => observePowermodOutcomeCall "bitAndLiteral" some (ops.bitAndLiteral a b)
  shiftRightLiteral := fun a b => observePowermodOutcomeCall "shiftRightLiteral" some (ops.shiftRightLiteral a b)
  sizeOf := fun a => observePowermodOutcomeCall "sizeOf" some (ops.sizeOf a)
  mulLiteralLeft := fun a b => observePowermodOutcomeCall "mulLiteralLeft" some (ops.mulLiteralLeft a b)
  multiplicativeinverse := fun a => observePowermodOutcomeCall "multiplicativeinverse" some (ops.multiplicativeinverse a)
  invmod := fun a b => observePowermodOutcomeCall "invmod" some (ops.invmod a b)
  convert := fun a b => observePowermodOutcomeCall "convert" some (ops.convert a b)
  legal := {
    unsigned := {
      typeOf := ops.legal.unsigned.typeOf
      hasTypeMax := fun a => observePowermodOutcomeCall "hasTypeMax" (fun _ => none) (ops.legal.unsigned.hasTypeMax a)
      typeMax := fun a => observePowermodOutcomeCall "typeMax" some (ops.legal.unsigned.typeMax a)
      sizeOfType := fun a => observePowermodOutcomeCall "sizeOfType" some (ops.legal.unsigned.sizeOfType a)
      shiftLeft := fun a b => observePowermodOutcomeCall "legalShiftLeft" some (ops.legal.unsigned.shiftLeft a b)
      shiftRight := fun a b => observePowermodOutcomeCall "legalShiftRight" some (ops.legal.unsigned.shiftRight a b)
      lessEqual := fun a b => observePowermodOutcomeCall "legalLessEqual" (fun _ => none) (ops.legal.unsigned.lessEqual a b) }
    select := fun a => match ops.legal.select a with
      | .integer => .integer
      | .unsigned => .unsigned
      | .noMethod => .noMethod
      | .custom method => .custom (fun a =>
          observePowermodOutcomeCall "legalOther" (fun _ => none) (method a)) }
  recursiveDispatch := fun a b c => match ops.recursiveDispatch a b c with
    | .generic => .generic
    | .noMethod => .noMethod
    | .custom method => .custom (fun a b c =>
        observePowermodOutcomeCall "recursiveOther" some (method a b c))

def powermodOutcomeErrors {W V : Type} (trace : List (PowermodOutcomeEvent W V)) :
    List JuliaLean.base.io.Error :=
  trace.filterMap fun event => match event.outcome with
    | .error error => some error
    | _ => none

def powermodOutcomeValues {W V : Type} (trace : List (PowermodOutcomeEvent W V)) :
    List (String × V) :=
  trace.filterMap fun event => match event.outcome with
    | .ok (some value) => some (event.operation, value)
    | _ => none

def PowermodOutcomeWorlds {W V : Type} (initial final : W)
    (trace : List (PowermodOutcomeEvent W V)) : Prop :=
  trace ≠ [] ∧
  trace.map PowermodOutcomeEvent.before =
    (initial :: trace.map PowermodOutcomeEvent.after).take trace.length ∧
  trace.getLast?.map PowermodOutcomeEvent.after = some final

/-- Complete-call state, exception and return-origin conservation, over every
selected implementation and all source paths. A result is the last actual
value from a permissible exit producer; no fabricated arithmetic, conversion
or default value is permitted. The unique first selected failure is retained.
Only the source's own conditional/type assertions and absent-method dispatch
can create a local error. No callback purity, arithmetic, termination or
return-type law is imposed. Julia source: base/intfuncs.jl:524-584. -/
def PowermodWholeOutcomeProvenance : Prop :=
  ∀ (W V Ty Other : Type) (ops : PowermodOps W V Ty Other) (x p m : V) (world : W),
    match powermodGeneric (observePowermodOutcomeOps ops) x p m (world, []) with
    | none => True
    | some (.ok (value, (final, trace))) =>
        PowermodOutcomeWorlds world final trace ∧ powermodOutcomeErrors trace = [] ∧
        ∃ producer, (powermodOutcomeValues trace).getLast? = some (producer, value) ∧
          producer ∈ ["mod", "zero", "recursiveOther", "convert", "add"]
    | some (.error (error, (final, trace))) =>
        PowermodOutcomeWorlds world final trace ∧
        ((powermodOutcomeErrors trace = [error] ∧
          ∃ last, trace.getLast? = some last ∧ last.outcome = .error error) ∨
         (powermodOutcomeErrors trace = [] ∧
          (error = .foreignError "TypeError" "" ∨
           error = .jl (.methodError "powermod") ∨
           error = .jl (.methodError "_powermod_mi_legal"))))

