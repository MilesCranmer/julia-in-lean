  · rw [← Int.pow_mul]
    exact Int.lt_of_lt_of_le hu (pow_mono (by decide) h.2.2.1)
  · rw [← Int.pow_mul]
    exact Int.le_trans (pow_mono (by decide) h.2.2.2) hl

