/-- Mathematical decimal length, with the documented zero-length convention. -/
def DecimalMathematicalCount (magnitude digits : Nat) : Prop :=
  if magnitude = 0 then digits = 0
  else 0 < digits ∧ 10 ^ (digits - 1) ≤ magnitude ∧ magnitude < 10 ^ digits

/-- Original mathematical contents as a condition on the current mutable world;
const does not prevent element mutation or resizing. -/
def DecimalStandardTable (table : DecimalTable) : Prop :=
  table.memory.contents table.handle =
    (List.range 20).map (fun k => some (JuliaLean.base.int.lit .u64 ((10 : Nat) ^ k)))

def decimalUnsigned64Magnitude : DecimalUnsigned64 → Nat
  | .u8 value => value.val.toNat
  | .u16 value => value.val.toNat
  | .u32 value => value.val.toNat
  | .u64 value => value.val.toNat

def decimalUnsignedMagnitude : DecimalUnsigned → Nat
  | .small value => decimalUnsigned64Magnitude value
  | .u128 value => value.val.toNat

def decimalSignedMagnitude : DecimalSigned → Nat
  | .i8 value => value.val.natAbs
  | .i16 value => value.val.natAbs
  | .i32 value => value.val.natAbs
  | .i64 value => value.val.natAbs
  | .i128 value => value.val.natAbs

/-- Numerical and effect invariant over every valid current table. Execution
finishes and preserves the complete world. Changed contents alter the count by at
most one, while the original powers give the exact count. Only a too-short table
can cause an exception, and its class is BoundsError. -/
def DecimalCurrentTableOutcome {W : Type}
    (world : DecimalWorld W) (magnitude bound : Nat)
    (observed : Option (Except (JuliaLean.base.io.Error × DecimalWorld W)
      (JInt64 × DecimalWorld W))) : Prop :=
  ∃ outcome, observed = some outcome ∧
    match outcome with
    | .ok (count, finalWorld) =>
        finalWorld = world ∧ 0 ≤ count.val ∧ count.val ≤ (bound : Int) ∧
        ∃ digits : Nat,
          DecimalMathematicalCount magnitude digits ∧
          (count.val - (digits : Int)).natAbs ≤ 1 ∧
          (DecimalStandardTable world.2 → count.val = (digits : Int))
    | .error (error, finalWorld) =>
        finalWorld = world ∧ error = .jl .boundsError ∧
          (world.2.memory.contents world.2.handle).length < 20

/-- Complete four-type input union and arbitrary valid current global array. -/
def BitDigits64CurrentTable : Prop :=
  ∀ (W : Type) (x : DecimalUnsigned64) (world : DecimalWorld W),
    DecimalCurrentTableOutcome world (decimalUnsigned64Magnitude x) 20
      (bitDigits64 x world)

/-- Full UInt128 domain, including both possible 19-digit reductions. -/
def BitDigits128CurrentTable : Prop :=
  ∀ (W : Type) (x : JInt .u128) (world : DecimalWorld W),
    DecimalCurrentTableOutcome world x.val.toNat 39 (bitDigits128 x world)

/-- Every native unsigned width retains the current-table contract. -/
def DecimalUnsignedCurrentTable : Prop :=
  ∀ (W : Type) (x : DecimalUnsigned) (world : DecimalWorld W),
    DecimalCurrentTableOutcome world (decimalUnsignedMagnitude x) 39
      (decimalUnsigned x world)

