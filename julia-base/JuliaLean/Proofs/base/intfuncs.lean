/-! Observational accounting for arbitrary effectful LCM callees. `recordCall`
is the generic observation helper supplied by the gcd property fragment. -/

inductive LcmArithmetic where
  | gcd | divide | multiply | absolute
  deriving BEq, DecidableEq

def lcmArithmeticRank : LcmArithmetic → Nat
  | .gcd => 0
  | .divide => 1
  | .multiply => 2
  | .absolute => 3

inductive LcmEvent (V : Type) where
  | test (value : V) (result : Except JuliaLean.base.io.Error Bool)
  | zero (value : V) (result : Except JuliaLean.base.io.Error V)
  | arithmetic (operation : LcmArithmetic)
      (result : Except JuliaLean.base.io.Error V)

def observeLcmOps {W V : Type}
    (ops : LcmOps (JuliaLean.base.io.M W) V) :
    LcmOps (JuliaLean.base.io.M (W × List (LcmEvent V))) V where
  equalZero value zero := recordCall (.test value) (ops.equalZero value zero)
  zero value := recordCall (.zero value) (ops.zero value)
  gcd a b := recordCall (.arithmetic .gcd) (ops.gcd a b)
  div a b := recordCall (.arithmetic .divide) (ops.div a b)
  checkedMul a b := recordCall (.arithmetic .multiply) (ops.checkedMul a b)
  checkedAbs value := recordCall (.arithmetic .absolute) (ops.checkedAbs value)

def lcmArithmeticCalls {V : Type} (trace : List (LcmEvent V)) : List LcmArithmetic :=
  trace.filterMap fun event => match event with
    | .arithmetic operation _ => some operation
    | _ => none

def lcmTestResults {V : Type} (trace : List (LcmEvent V)) :
    List (Except JuliaLean.base.io.Error Bool) :=
  trace.filterMap fun event => match event with
    | .test _ result => some result
    | _ => none

def lcmEventError {V : Type} : LcmEvent V → Option JuliaLean.base.io.Error
  | .test _ (.error error) => some error
  | .zero _ (.error error) => some error
  | .arithmetic _ (.error error) => some error
  | _ => none

def lcmTerminalOutputs {V : Type} (trace : List (LcmEvent V)) : List V :=
  trace.filterMap fun event => match event with
    | .zero _ (.ok value) => some value
    | .arithmetic .absolute (.ok value) => some value
    | _ => none

/-- A call-budget and effect-order invariant independent of callback results:
at most six leaves run, comparisons number at most two, arithmetic stages are
strictly ordered and never repeated, and an observed zero never reaches the
arithmetic stages. Every zero operation retains the original first argument.
These observations do not calculate the method's output.
Source invariant: base/intfuncs.jl:136-144. -/
def LcmTraceAccounting {V : Type} (a : V) (trace : List (LcmEvent V)) : Prop :=
  trace.length ≤ 6 ∧
  (lcmTestResults trace).length ≤ 2 ∧
  (lcmArithmeticCalls trace).Pairwise
    (fun earlier later => lcmArithmeticRank earlier < lcmArithmeticRank later) ∧
  ((Except.ok true) ∈ lcmTestResults trace → lcmArithmeticCalls trace = []) ∧
  (∀ value result, LcmEvent.zero value result ∈ trace →
    value = a ∧ lcmArithmeticCalls trace = [] ∧
    trace.getLast? = some (.zero value result)) ∧
  (∀ result, LcmEvent.arithmetic .absolute result ∈ trace →
    trace.getLast? = some (.arithmetic .absolute result))

/-- Success originates in exactly one terminal-producing call; a failed call
is unique, final, and supplies the propagated exception. -/
def LcmTerminalAccounting {V : Type} (trace : List (LcmEvent V)) :
    Except JuliaLean.base.io.Error V → Prop
  | .ok value => lcmTerminalOutputs trace = [value] ∧ trace.filterMap lcmEventError = []
  | .error error => trace.filterMap lcmEventError = [error] ∧
      ∃ event, trace.getLast? = some event ∧ lcmEventError event = some error

/-- Completed executions retain short-circuiting, bounded effect accounting,
and first-error propagation for all custom operations and mutable worlds. No
operation law, successful-run premise, or input restriction is supplied.
Divergent dispatch is allowed and retains the installed runtime's none result.

Julia source invariant: base/intfuncs.jl:136-144 at
f755f49a9e41380d7da126b3c1db9fe7f83dd027. -/
def LcmOpenDispatchAccounting : Prop :=
  ∀ (W V : Type) (ops : LcmOps (JuliaLean.base.io.M W) V) (a b : V) (world : W),
    match lcmInteger (observeLcmOps ops) a b (world, []) with
    | none => True
    | some (.ok (value, (_, trace))) =>
        LcmTraceAccounting a trace ∧ LcmTerminalAccounting trace (.ok value)
    | some (.error (error, (_, trace))) =>
        LcmTraceAccounting a trace ∧ LcmTerminalAccounting trace (.error error)

