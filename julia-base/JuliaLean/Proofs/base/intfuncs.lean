  exact Int.pow_pos (by decide)

theorem digitCount_two_power (k : Nat) : DigitCount ((2 : Int) ^ k) 2 1 (k + 1) := by
  have hp : 0 < (2 : Int) ^ k := Int.pow_pos (by decide)
  have habs : (((2 : Int) ^ k).natAbs : Int) = (2 : Int) ^ k :=
    Int.natAbs_of_nonneg (Int.le_of_lt hp)
  refine ⟨by omega, by omega, ?_⟩
  simp only [show (0 : Int) < 2 by decide, ite_true]
  refine ⟨fun hz => False.elim (Int.ne_of_gt hp hz), fun _ => ?_⟩
  refine ⟨by omega, ?_, fun _ => ?_⟩
  · rw [habs]
    have hk : ((k : Int) + 1).toNat = k + 1 := by omega
    rw [hk, Int.pow_succ]
    have h := Int.mul_lt_mul_of_pos_left (by decide : (1 : Int) < 2) hp
    simpa only [Int.mul_one] using h
  · rw [habs]
    have hk : ((k : Int) + 1).toNat - 1 = k := by omega
    rw [hk]
    exact Int.le_refl _

