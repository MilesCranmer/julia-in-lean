    rw [Int.ofNat_natAbs_of_nonpos (by omega)] at hh
    omega
  · have hh : (2 : Int) ≤ (z.natAbs : Int) := Int.ofNat_le.mpr h
    rw [Int.natAbs_of_nonneg (by omega)] at hh
    omega

/-- intfuncs-ndigits-zero-domain. The concrete mixed signedness floor operation is
checked at zero before using the negative-base loop's fixed state. -/
theorem IntfuncsNdigitsZeroDomain_proven : JuliaLean.Proofs.base.intfuncs.approvedRound3.NdigitsZeroAndDomain := by
