  rw [if_pos (show 0 < base by omega)]
  refine ⟨by omega, hpad, ?_, ?_⟩
  · intro hz
    exact False.elim (hn hz)
  · intro _
    refine ⟨by omega, hup, ?_⟩
    intro hlt
    have he : max pad (m : Int) = (m : Int) := Int.max_eq_right (by omega)
    simpa only [he, Int.toNat_natCast] using hl

