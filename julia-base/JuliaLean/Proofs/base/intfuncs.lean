    if 0 < base.val ∧ n.val < 0 ∧ effectivePad = IntTy.max .i64 then
      inexactError (stringBits digitCallees n base pad)
    else ∃ s, stringBits digitCallees n base pad = .ok s ∧ BufferSafe s) ∧
  (∀ decimal (n base pad : Int), 2 ≤ base.natAbs → base.natAbs ≤ 62 →
    let effectivePad := min (max pad (IntTy.min .i64)) (IntTy.max .i64)
    if 0 < base ∧ n < 0 ∧ effectivePad = IntTy.max .i64 then
      inexactError (bigString decimal n base pad)
    else ∃ s, bigString decimal n base pad = .ok s ∧ BufferSafe s) ∧
  (∀ (t : IntTy) (n : JInt t) (s : Buffer), bitstringBits n = .ok s → BufferSafe s)
/-- A Euclidean coefficient step preserves the generated ideal, not merely its own formula. -/
def BezoutUpdateInvariant : Prop :=
  (∀ a b s0 s1 t0 t1 q : Int,
    let r0 := a*s0+b*t0
    let r1 := a*s1+b*t1
    let r2 := a * gcdxUpdate Int.sub Int.mul s0 q s1 +
      b * gcdxUpdate Int.sub Int.mul t0 q t1
    Nat.gcd r1.natAbs r2.natAbs = Nat.gcd r0.natAbs r1.natAbs) ∧
  (∀ (t : IntTy) (a b s0 s1 t0 t1 q : JInt t),
    let update := if t.signed then
      gcdxUpdate JuliaLean.base.int.sub JuliaLean.base.int.mul
      else gcdxUpdate_Unsigned JuliaLean.base.int.subWrap JuliaLean.base.int.mulWrap
    let r0 := wrapInt t (a.val*s0.val+b.val*t0.val)
    let r1 := wrapInt t (a.val*s1.val+b.val*t1.val)
    let r2 := wrapInt t (a.val*(update s0 q s1).val+b.val*(update t0 q t1).val)
    Nat.gcd r1.natAbs (Nat.gcd r2.natAbs (2^t.bits)) =
      Nat.gcd r0.natAbs (Nat.gcd r1.natAbs (2^t.bits)))

open JuliaLean.base.float
open JuliaLean.Promotion (Fl Fmt)

/-- IEEE multiplication specified through exact rational values and rounding, including all
NaN, infinity, signed-zero, overflow and underflow cases. -/
def RoundedProduct {T : FTy} (x y result : FV T) : Prop :=
  if x.isnan = true ∨ y.isnan = true then result.isnan = true
  else if (x.isinf = true ∧ y.iszero = true) ∨ (x.iszero = true ∧ y.isinf = true) then
    result.isnan = true
  else if x.isinf = true ∨ y.isinf = true then
    result = Fl.inf (x.signbit != y.signbit)
  else result = Fl.roundRat (x.toRat.1*y.toRat.1) (x.toRat.2*y.toRat.2)
    (x.signbit != y.signbit)

def ReciprocalValue {T : FTy} (x result : FV T) : Prop :=
  if x.isnan = true then result.isnan = true
  else if x.isinf = true then result = Fl.zero x.signbit
  else if x.iszero = true then result = Fl.inf x.signbit
  else result = Fl.roundRat
    (if x.toRat.1 < 0 then -(x.toRat.2 : Int) else (x.toRat.2 : Int))
    x.toRat.1.natAbs x.signbit

def literalBits {t : IntTy} (k : Fin 4) (x : JInt t) : Jl (JInt t) :=
  if k.val = 0 then .ok (literalPow_Zero (fun _ => JuliaLean.base.int.lit t 1) x)
  else if k.val = 1 then .ok (literalPow_One x)
  else if k.val = 2 then literalPow_Two (fun a b => .ok (JuliaLean.base.int.mul a b)) x
  else literalPow_Three (fun a b => .ok (JuliaLean.base.int.mul a b)) x

def literalFloat {T : FTy} (k : Fin 4) (x : FV T) : Jl (FV T) :=
  if k.val = 0 then .ok (literalPow_Zero (fun _ => one_float T) x)
  else if k.val = 1 then .ok (literalPow_One x)
  else if k.val = 2 then literalPow_Two (fun a b => .ok (mul_IEEEFloat a b)) x
  else literalPow_Three (fun a b => .ok (mul_IEEEFloat a b)) x

/-- Literal evaluation obeys exact modular powers and the square/cube binomial laws for
hardware integers; float squares/cubes obey correctly rounded arithmetic at each multiply. -/
def LiteralPowerExact : Prop :=
  (∀ (t : IntTy) (x y : JInt t),
    (∀ k : Fin 4, (literalBits k x).map Subtype.val = .ok (wrapInt t (x.val^k.val))) ∧
    ((literalBits ⟨2,by decide⟩ (JuliaLean.base.int.add x y)).map Subtype.val =
      .ok (wrapInt t (x.val^2+2*x.val*y.val+y.val^2))) ∧
    ((literalBits ⟨3,by decide⟩ (JuliaLean.base.int.add x y)).map Subtype.val =
      .ok (wrapInt t (x.val^3+3*x.val^2*y.val+3*x.val*y.val^2+y.val^3)))) ∧
  (∀ (T : FTy) (x : FV T),
    (∃ one, literalFloat ⟨0,by decide⟩ x = .ok one ∧ one.isfinite = true ∧
      one.toRat.1 = (one.toRat.2 : Int)) ∧
    literalFloat ⟨1,by decide⟩ x = .ok x ∧
    (∃ square, literalFloat ⟨2,by decide⟩ x = .ok square ∧ RoundedProduct x x square ∧
      ∃ cube, literalFloat ⟨3,by decide⟩ x = .ok cube ∧ RoundedProduct square x cube))
private theorem wrapInt_pow (t : IntTy) (z : Int) (k : Nat) :
    wrapInt t (wrapInt t z ^ k) = wrapInt t (z ^ k) := by
  induction k with
  | zero => simp
  | succ k ih =>
      rw [Int.pow_succ, Int.pow_succ, ← JuliaLean.Proofs.base.int.wrapInt_mul_left,
        ih, JuliaLean.Proofs.base.int.wrapInt_mul_left,
        JuliaLean.Proofs.base.int.wrapInt_mul_right]
private theorem int_two_mul (z : Int) : 2 * z = z + z := by
  calc
    2 * z = (1 + 1) * z := by rw [show (2 : Int) = 1 + 1 by decide]
    _ = 1 * z + 1 * z := Int.add_mul _ _ _
    _ = z + z := by simp

private theorem int_add_sq (a b : Int) :
    (a + b) ^ 2 = a ^ 2 + 2 * a * b + b ^ 2 := by
  have hp2 (z : Int) : z ^ 2 = z * z := by simp [Int.pow_succ]
  have hcoeff : 2 * a * b = a * b + a * b := by
    calc
      2 * a * b = 2 * (a * b) := by rw [Int.mul_assoc]
      _ = a * b + a * b := int_two_mul _
  rw [hp2 (a + b), Int.add_mul, Int.mul_add, Int.mul_add, hp2 a, hp2 b,
    Int.mul_comm b a, hcoeff]
  ac_rfl

private theorem int_add_cube (a b : Int) :
    (a + b) ^ 3 = a ^ 3 + 3 * a ^ 2 * b + 3 * a * b ^ 2 + b ^ 3 := by
  have hp3 (z : Int) : z ^ 3 = z ^ 2 * z := by simp [Int.pow_succ]
  have hthree (z : Int) : 3 * z = z + z + z := by
    calc
      3 * z = (2 + 1) * z := by rw [show (3 : Int) = 2 + 1 by decide]
      _ = 2 * z + 1 * z := Int.add_mul _ _ _
      _ = z + z + z := by rw [int_two_mul, Int.one_mul]
  have hcoeffA : a ^ 2 * b + 2 * a * b * a = 3 * (a ^ 2 * b) := by
    have hmon : 2 * a * b * a = 2 * (a ^ 2 * b) := by
      simp [Int.pow_succ, Int.pow_zero, Int.one_mul]
      ac_rfl
    rw [hthree (a ^ 2 * b), hmon, int_two_mul]
    ac_rfl
  have hcoeffB : 2 * a * b * b + b ^ 2 * a = 3 * (a * b ^ 2) := by
    have hmon : 2 * a * b * b = 2 * (a * b ^ 2) := by
      simp [Int.pow_succ, Int.pow_zero, Int.one_mul]
      ac_rfl
    have hcomm : b ^ 2 * a = a * b ^ 2 := by
      simp [Int.pow_succ, Int.pow_zero, Int.one_mul]
      ac_rfl
    rw [hthree (a * b ^ 2), hmon, hcomm, int_two_mul]
  calc
    (a + b) ^ 3 = (a + b) ^ 2 * (a + b) := hp3 (a + b)
    _ = (a ^ 2 + 2 * a * b + b ^ 2) * (a + b) := by rw [int_add_sq]
    _ = a ^ 2 * a + (a ^ 2 * b + 2 * a * b * a) +
        (2 * a * b * b + b ^ 2 * a) + b ^ 2 * b := by
      rw [Int.add_mul, Int.add_mul, Int.mul_add, Int.mul_add, Int.mul_add]
      ac_rfl
    _ = a ^ 3 + 3 * a ^ 2 * b + 3 * a * b ^ 2 + b ^ 3 := by
      rw [← hp3 a, ← hp3 b, hcoeffA, hcoeffB]
      ac_rfl


private theorem literalBits_exact {t : IntTy} (x : JInt t) (k : Fin 4) :
    (literalBits k x).map Subtype.val = .ok (wrapInt t (x.val ^ k.val)) := by
  have hfit : fits t 1 := by cases t <;> decide
  have h1 : (JuliaLean.base.int.lit t 1).val = 1 := by cases t <;> decide
  have hwrap1 : wrapInt t 1 = 1 :=
    JuliaLean.wrapInt_of_inRange t 1 hfit
  by_cases hk0 : k.val = 0
  · have heq : k = ⟨0, by decide⟩ := Fin.ext hk0
    subst k
    simp [literalBits, literalPow_Zero, h1, hwrap1, Except.map]
  · by_cases hk1 : k.val = 1
    · have heq : k = ⟨1, by decide⟩ := Fin.ext hk1
      subst k
      simp [literalBits, literalPow_One, JuliaLean.Proofs.base.int.wrapInt_val,
        Int.pow_succ, Int.pow_zero, Int.one_mul, Except.map]
    · by_cases hk2 : k.val = 2
      · have heq : k = ⟨2, by decide⟩ := Fin.ext hk2
        subst k
        simp [literalBits, literalPow_Two, Except.map, JuliaLean.base.int.mul,
          JuliaLean.Proofs.base.int.mul_int_val, Int.pow_succ, Int.pow_zero, Int.one_mul]
      · have hk3 : k.val = 3 := by omega
        have heq : k = ⟨3, by decide⟩ := Fin.ext hk3
        subst k
        simp [literalBits, literalPow_Three, Bind.bind, Except.bind, Pure.pure,
          Except.pure, Except.map, JuliaLean.base.int.mul,
          JuliaLean.Proofs.base.int.mul_int_val,
          JuliaLean.Proofs.base.int.wrapInt_mul_left,
          Int.pow_succ, Int.pow_zero, Int.one_mul]

private theorem roundedProduct_mul {T : FTy} (x y : FV T) :
    RoundedProduct x y (JuliaLean.base.float.mul_IEEEFloat x y) := by
  unfold RoundedProduct JuliaLean.base.float.mul_IEEEFloat
    JuliaLean.base.float.mul_float
  have hfmt : T.fmt ≠ JuliaLean.C.bfloat := by cases T <;> decide
  by_cases hx : x.isnan = true
  · have hq := JuliaLean.Proofs.base.float.quietFloat_isnan x hx
    simp [JuliaLean.C.jlMulFloat, JuliaLean.C.finishFloat, JuliaLean.C.floatMul,
      hfmt, hx, hq]
  · by_cases hy : y.isnan = true
    · have hq := JuliaLean.Proofs.base.float.quietFloat_isnan y hy
      simp [JuliaLean.C.jlMulFloat, JuliaLean.C.finishFloat, JuliaLean.C.floatMul,
        hfmt, hx, hy, hq]
    · have hnanx : x.isnan = false := Bool.eq_false_iff.mpr hx
      have hnany : y.isnan = false := Bool.eq_false_iff.mpr hy
      by_cases hxy : (x.isinf && y.iszero) = true
      · have hxySpec : x.isinf = true ∧ y.iszero = true := by
          simpa [Bool.and_eq_true] using hxy
        have hinv : (JuliaLean.C.invalidFloat T.fmt).isnan = true := by
          cases T <;> decide
        simp [JuliaLean.C.jlMulFloat, JuliaLean.C.finishFloat, JuliaLean.C.floatMul,
          hfmt, hnanx, hnany, hxy, hxySpec, hinv]
      · have hxyFalse : (x.isinf && y.iszero) = false :=
          Bool.eq_false_iff.mpr hxy
        by_cases hyx : (y.isinf && x.iszero) = true
        · have hyxSpec : y.isinf = true ∧ x.iszero = true := by
            simpa [Bool.and_eq_true] using hyx
          have hinv : (JuliaLean.C.invalidFloat T.fmt).isnan = true := by
            cases T <;> decide
          simp [JuliaLean.C.jlMulFloat, JuliaLean.C.finishFloat, JuliaLean.C.floatMul,
            hfmt, hnanx, hnany, hxyFalse, hyx, hyxSpec, hinv]
        · have hyxFalse : (y.isinf && x.iszero) = false :=
            Bool.eq_false_iff.mpr hyx
          have hxySpecFalse : ¬(x.isinf = true ∧ y.iszero = true) := by
            intro h
            simp [h.1, h.2] at hxyFalse
          have hyxSpecFalse : ¬(y.isinf = true ∧ x.iszero = true) := by
            intro h
            simp [h.1, h.2] at hyxFalse
          have hzeroInfFalse : ¬(x.iszero = true ∧ y.isinf = true) := by
            intro h
            exact hyxSpecFalse ⟨h.2, h.1⟩
          by_cases hxi : x.isinf = true
          · have hyZeroFalse : y.iszero = false :=
              Bool.eq_false_iff.mpr (fun hyz => hxySpecFalse ⟨hxi, hyz⟩)
            simp [JuliaLean.C.jlMulFloat, JuliaLean.C.finishFloat,
              JuliaLean.C.floatMul, hfmt, hnanx, hnany, hxyFalse, hyxFalse,
              hxySpecFalse, hyxSpecFalse, hzeroInfFalse, hxi, hyZeroFalse]
          · have hxif : x.isinf = false := Bool.eq_false_iff.mpr hxi
            by_cases hyi : y.isinf = true
            · have hxZeroFalse : x.iszero = false :=
                Bool.eq_false_iff.mpr (fun hxz => hyxSpecFalse ⟨hyi, hxz⟩)
              simp [JuliaLean.C.jlMulFloat, JuliaLean.C.finishFloat,
                JuliaLean.C.floatMul, hfmt, hnanx, hnany, hxyFalse, hyxFalse,
                hxySpecFalse, hyxSpecFalse, hzeroInfFalse, hxif, hyi, hxZeroFalse]
            · have hyif : y.isinf = false := Bool.eq_false_iff.mpr hyi
              simp [JuliaLean.C.jlMulFloat, JuliaLean.C.finishFloat,
                JuliaLean.C.floatMul, hfmt, hnanx, hnany, hxyFalse, hyxFalse,
                hxySpecFalse, hyxSpecFalse, hxif, hyif]

theorem literalPowerExact_proven : LiteralPowerExact := by
  refine ⟨?_, ?_⟩
  · intro t x y
    refine ⟨?_, ?_, ?_⟩
    · intro k
      exact literalBits_exact x k
    · have hadd := JuliaLean.Proofs.base.int.addWraps_proven t x y
      have hsquare := literalBits_exact (JuliaLean.base.int.add x y) ⟨2, by decide⟩
      rw [hadd, wrapInt_pow t (x.val + y.val) 2] at hsquare
      rw [int_add_sq] at hsquare
      exact hsquare
    · have hadd := JuliaLean.Proofs.base.int.addWraps_proven t x y
      have hcube := literalBits_exact (JuliaLean.base.int.add x y) ⟨3, by decide⟩
      rw [hadd, wrapInt_pow t (x.val + y.val) 3] at hcube
      rw [int_add_cube] at hcube
      exact hcube
  · intro T x
    obtain ⟨hzero, hone, htwo, hthree⟩ :=
      JuliaLean.Proofs.base.intfuncs.literalPowerExact_proven.2 T x
    have honeSpec :
        (one_float T).isfinite = true ∧
          (one_float T).toRat.1 = (one_float T).toRat.2 := by
      cases T <;> decide
    refine ⟨⟨one_float T, ?_, honeSpec.1, honeSpec.2⟩, ?_,
      ⟨JuliaLean.base.float.mul_IEEEFloat x x, ?_,
        roundedProduct_mul x x,
        ⟨JuliaLean.base.float.mul_IEEEFloat (JuliaLean.base.float.mul_IEEEFloat x x) x,
          ?_, roundedProduct_mul _ _⟩⟩⟩
    · simpa [literalFloat] using congrArg (fun y => (Except.ok y : Jl (FV T))) hzero
    · simpa [literalFloat] using congrArg (fun y => (Except.ok y : Jl (FV T))) hone
    · simpa [literalFloat, Pure.pure, Except.pure] using htwo
    · simpa [literalFloat, Pure.pure, Except.pure] using hthree
def floatInverse {T : FTy} (x : FV T) : Jl (FV T) :=
  JuliaLean.base.number.inv (fun _ => .ok (one_float T))
    (fun a b => .ok (div_IEEEFloat a b)) x

def integerInverse {t : IntTy} (x : JInt t) : Jl (FV .f64) :=
  JuliaLean.base.number.inv (fun _ => .ok (JuliaLean.base.int.lit t 1))
    (fun a b => .ok (div_IEEEFloat (floatOfInt .f64 a) (floatOfInt .f64 b))) x
private theorem floorLog2Rat_scale_pow (a d j : Nat) (ha : a ≠ 0) (hd : d ≠ 0) :
    Fl.floorLog2Rat (a * 2 ^ j) (d * 2 ^ j) = Fl.floorLog2Rat a d := by
  unfold Fl.floorLog2Rat
  rw [JuliaLean.Promotion.Fl.log2_mul_pow a j ha,
    JuliaLean.Promotion.Fl.log2_mul_pow d j hd]
  have heq : ((a.log2 + j : Nat) : Int) - ((d.log2 + j : Nat) : Int) =
      (a.log2 : Int) - d.log2 := by omega
  rw [heq]
  by_cases he : (a.log2 : Int) - d.log2 ≥ 0
  · have hnat : ((a.log2 : Int) - d.log2).toNat = a.log2 - d.log2 := by omega
    have hnatOrder : d.log2 ≤ a.log2 := by omega
    by_cases hb : a < d * 2 ^ (a.log2 - d.log2)
    · have hbs : a * 2 ^ j < d * 2 ^ j * 2 ^ (a.log2 - d.log2) := by
        calc
          a * 2 ^ j < (d * 2 ^ (a.log2 - d.log2)) * 2 ^ j :=
            (Nat.mul_lt_mul_right (Nat.two_pow_pos j)).2 hb
          _ = d * 2 ^ j * 2 ^ (a.log2 - d.log2) := by ac_rfl
      simp [he, hnat, hnatOrder, hb, hbs]
    · have hbs : ¬ a * 2 ^ j < d * 2 ^ j * 2 ^ (a.log2 - d.log2) := by
        intro h
        have h' : a * 2 ^ j < (d * 2 ^ (a.log2 - d.log2)) * 2 ^ j := by
          simpa [Nat.mul_assoc, Nat.mul_left_comm, Nat.mul_comm] using h
        exact hb ((Nat.mul_lt_mul_right (Nat.two_pow_pos j)).1 h')
      simp [he, hnat, hnatOrder, hb, hbs]
  · have hnat : (-( (a.log2 : Int) - d.log2)).toNat = d.log2 - a.log2 := by omega
    have hnatOrder : ¬ d.log2 ≤ a.log2 := by omega
    by_cases hb : a * 2 ^ (d.log2 - a.log2) < d
    · have hbs :
          a * 2 ^ j * 2 ^ (d.log2 - a.log2) < d * 2 ^ j := by
        calc
          a * 2 ^ j * 2 ^ (d.log2 - a.log2) =
              (a * 2 ^ (d.log2 - a.log2)) * 2 ^ j := by ac_rfl
          _ < d * 2 ^ j := (Nat.mul_lt_mul_right (Nat.two_pow_pos j)).2 hb
      simp [he, hnat, hnatOrder, hb, hbs]
    · have hbs :
          ¬ a * 2 ^ j * 2 ^ (d.log2 - a.log2) < d * 2 ^ j := by
        intro h
        have h' : (a * 2 ^ (d.log2 - a.log2)) * 2 ^ j < d * 2 ^ j := by
          simpa [Nat.mul_assoc, Nat.mul_left_comm, Nat.mul_comm] using h
        exact hb ((Nat.mul_lt_mul_right (Nat.two_pow_pos j)).1 h')
      simp [he, hnat, hnatOrder, hb, hbs]

private theorem roundRat_signed_scale_pair {f : Fmt} (n d j : Nat) (s z : Bool)
    (hd : d ≠ 0) :
    (Fl.roundRat (if s then -((n * 2 ^ j : Nat) : Int) else ((n * 2 ^ j : Nat) : Int))
      (d * 2 ^ j) z : Fl f) =
      Fl.roundRat (if s then -(n : Int) else (n : Int)) d z := by
  have hc : 2 ^ j ≠ 0 := by have := Nat.two_pow_pos j; omega
  have hden : d * 2 ^ j ≠ 0 := Nat.mul_ne_zero hd hc
  by_cases hn : n = 0
  · subst n
    cases s <;> simp [Fl.roundRat, hd, hden]
  · have hnp : n * 2 ^ j ≠ 0 := Nat.mul_ne_zero hn hc
    have hnum0 :
        (if s then -((n * 2 ^ j : Nat) : Int) else ((n * 2 ^ j : Nat) : Int)) ≠ 0 := by
      cases s <;> simp only [Bool.false_eq_true, ↓reduceIte] <;> omega
    have hn0 : (if s then -(n : Int) else (n : Int)) ≠ 0 := by
      cases s <;> simp only [Bool.false_eq_true, ↓reduceIte] <;> omega
    have hnpabs :
        (if s then -((n * 2 ^ j : Nat) : Int) else ((n * 2 ^ j : Nat) : Int)).natAbs =
          n * 2 ^ j := by
      cases s <;> simp only [Bool.false_eq_true, ↓reduceIte, Int.natAbs_neg,
        Int.natAbs_natCast]
    have hnabs : (if s then -(n : Int) else (n : Int)).natAbs = n := by
      cases s <;> simp only [Bool.false_eq_true, ↓reduceIte, Int.natAbs_neg,
        Int.natAbs_natCast]
    have hsn : decide ((if s then -(n : Int) else (n : Int)) < 0) = s := by
      cases s
      · exact decide_eq_false (Int.not_lt.mpr (Int.natCast_nonneg _))
      · change decide (-(n : Int) < 0) = true
        exact decide_eq_true (by omega)
    have hsnp :
        decide ((if s then -((n * 2 ^ j : Nat) : Int)
          else ((n * 2 ^ j : Nat) : Int)) < 0) = s := by
      cases s
      · exact decide_eq_false (Int.not_lt.mpr (Int.natCast_nonneg _))
      · change decide (-((n * 2 ^ j : Nat) : Int) < 0) = true
        exact decide_eq_true (by omega)
    simp only [Fl.roundRat, beq_iff_eq, hd, hden, hnum0, hn0, hnpabs, hnabs,
      hsn, hsnp, Bool.false_eq_true, ↓reduceIte]
    rw [floorLog2Rat_scale_pow n d j hn hd]
    split
    · rfl
    · split
      · rfl
      · generalize max (Fl.floorLog2Rat n d - f.sb)
          (1 - (f.bias : Int) - f.sb) = k
        by_cases hk : k ≥ 0
        · simp only [hk, ↓reduceIte]
          rw [Nat.mul_right_comm d (2 ^ j) (2 ^ k.toNat),
            JuliaLean.Proofs.base.float.roundQuotient_scale n (d * 2 ^ k.toNat)
              (2 ^ j) (Nat.two_pow_pos j)]
        · simp only [hk, ↓reduceIte]
          rw [Nat.mul_right_comm n (2 ^ j) (2 ^ (-k).toNat),
            JuliaLean.Proofs.base.float.roundQuotient_scale
              (n * 2 ^ (-k).toNat) d (2 ^ j) (Nat.two_pow_pos j)]

private theorem reciprocalValue_div_one {T : FTy} (x : FV T) :
    ReciprocalValue x (JuliaLean.base.float.div_IEEEFloat (one_float T) x) := by
  unfold ReciprocalValue JuliaLean.base.float.div_IEEEFloat JuliaLean.base.float.div_float
  have hfmt : T.fmt ≠ JuliaLean.C.bfloat := by cases T <;> decide
  have hone : (one_float T).isfinite = true ∧ (one_float T).isnan = false ∧
      (one_float T).isinf = false ∧ (one_float T).iszero = false ∧
      (one_float T).signbit = false := by
    cases T <;> decide
  have honeRat : (one_float T).toRat = ((2 ^ T.fmt.sb : Int), 2 ^ T.fmt.sb) := by
    cases T <;> decide
  rcases hone with ⟨honeFinite, honeNan, honeInf, honeZero, honeSign⟩
  by_cases hn : x.isnan = true
  · have hq := JuliaLean.Proofs.base.float.quietFloat_isnan x hn
    simp [JuliaLean.C.jlDivFloat, JuliaLean.C.floatDiv, JuliaLean.C.finishFloat,
      hfmt, hn, hq, honeNan]
  · have hnan : x.isnan = false := Bool.eq_false_iff.mpr hn
    by_cases hi : x.isinf = true
    · simp [JuliaLean.C.jlDivFloat, JuliaLean.C.floatDiv, JuliaLean.C.finishFloat,
        hfmt, hnan, hi, honeNan, honeInf, honeZero, honeSign]
    · have hinf : x.isinf = false := Bool.eq_false_iff.mpr hi
      by_cases hz : x.iszero = true
      · simp [JuliaLean.C.jlDivFloat, JuliaLean.C.floatDiv, JuliaLean.C.finishFloat,
          hfmt, hnan, hi, hz, honeNan, honeInf, honeZero, honeSign]
      · have hzero : x.iszero = false := Bool.eq_false_iff.mpr hz
        have hfinite : x.isfinite = true := by
          by_cases he : x.expField == T.fmt.emax
          · by_cases hf : x.frac == 0
            · have hbad : x.isinf = true := by simp [Fl.isinf, he, hf]
              exact False.elim (hi hbad)
            · have hfne : x.frac ≠ 0 := by
                intro h; apply hf; simp [h]
              have hbad : x.isnan = true := by simp [Fl.isnan, he, hfne]
              exact False.elim (hn hbad)
          · have hen : x.expField ≠ T.fmt.emax := by
              intro h; apply he; simp [h]
            simp [Fl.isfinite, hen]
        have hmag : x.magnitude ≠ 0 := by
          intro hmag
          apply hz
          simp [Fl.iszero, hmag]
        have hkeypos : 0 < JuliaLean.Proofs.base.float.magKey T.fmt x.magnitude := by
          rcases JuliaLean.Proofs.base.float.magKey_cases T.fmt x.magnitude with h | h
          · exact (hmag h.1).elim
          · exact h.2
        obtain ⟨m, i, j, hrat, hkey, _, _⟩ :=
          JuliaLean.Promotion.Fl.toRat_cases
            (JuliaLean.Proofs.base.float.good_fty T) x hfinite
        have hm : m ≠ 0 := by
          intro hm
          rw [hm] at hkey
          have hp : 0 < 2 ^ j := Nat.two_pow_pos j
          have hprod : 0 < JuliaLean.Proofs.base.float.magKey T.fmt x.magnitude * 2 ^ j :=
            Nat.mul_pos hkeypos hp
          simp at hkey
          exact (Nat.ne_of_gt hprod) hkey
        have hnum : x.toRat.1.natAbs = m * 2 ^ i := by
          rw [hrat]
          by_cases hs : x.signbit = true <;>
            simp only [hs, Bool.false_eq_true, ↓reduceIte, Int.natAbs_neg,
              Int.natAbs_natCast]
        have hden : x.toRat.1.natAbs ≠ 0 := by
          rw [hnum]
          exact Nat.mul_ne_zero hm (by have := Nat.two_pow_pos i; omega)
        have hscale := roundRat_signed_scale_pair (f := T.fmt) x.toRat.2
          x.toRat.1.natAbs T.fmt.sb (decide (x.toRat.1 < 0)) x.signbit hden
        simp [JuliaLean.C.jlDivFloat, JuliaLean.C.floatDiv, JuliaLean.C.finishFloat,
          hfmt, hnan, hinf, hzero, hfinite, honeNan, honeInf, honeZero, honeSign,
          honeRat]
        simpa [Int.mul_comm, Nat.mul_comm] using hscale

/-- Every hardware input is included. IEEE inversion is total, including zeros, infinities
and NaNs; integer inversion returns Float64. No inverse-success assumption is made. -/
def LiteralInverseSquare : Prop :=
  (∀ (T : FTy) (x : FV T), ∃ inverse result,
    floatInverse x = .ok inverse ∧ ReciprocalValue x inverse ∧
    literalPow_NegTwo floatInverse (fun a b => .ok (mul_IEEEFloat a b)) x = .ok result ∧
    RoundedProduct inverse inverse result) ∧
  (∀ (t : IntTy) (x : JInt t), ∃ inverse result,
    integerInverse x = .ok inverse ∧ ReciprocalValue (floatOfInt .f64 x) inverse ∧
    literalPow_NegTwo integerInverse (fun a b => .ok (mul_IEEEFloat a b)) x = .ok result ∧
    RoundedProduct inverse inverse result) ∧
  (∀ (N R : Type) (inv : N → Jl R) (mul : R → R → Jl R) (x : N) (err : JlError),
    inv x = .error err → literalPow_NegTwo inv mul x = .error err)
def HasTypeMaxSpec : Prop :=
  JuliaLean.Proofs.base.intfuncs.DigitsErrors ∧
  (∀ (n base : Int) (before : Vector Int), 2 ≤ base.natAbs →
    ∃ after, bigDigitsBang (hasTypeMax false false) 0 before n base = .ok after ∧
      after.first = before.first ∧ after.values.length = before.values.length ∧
      DigitRange n base after.values ∧
      ∃ q : Int, evalpoly base after.values+base^before.values.length*q = n) ∧
  JuliaLean.Proofs.base.intfuncs.HasTypeMaxSpec
theorem literalInverseSquare_proven : LiteralInverseSquare := by
  refine ⟨?_, ?_, ?_⟩
  · intro T x
    let inverse := JuliaLean.base.float.div_IEEEFloat (one_float T) x
    let result := JuliaLean.base.float.mul_IEEEFloat inverse inverse
    have hinv : floatInverse x = .ok inverse := by
      simp [floatInverse, JuliaLean.base.number.inv, inverse, Bind.bind, Except.bind,
        Pure.pure, Except.pure]
    have hpow :
        literalPow_NegTwo floatInverse (fun a b => .ok (mul_IEEEFloat a b)) x =
          .ok result := by
      simp [literalPow_NegTwo, hinv, result, Bind.bind, Except.bind, Pure.pure,
        Except.pure]
    exact ⟨inverse, result, hinv, by simpa [inverse] using reciprocalValue_div_one x,
      hpow, by simpa [result] using roundedProduct_mul inverse inverse⟩
  · intro t x
    have hone : floatOfInt .f64 (JuliaLean.base.int.lit t 1) = one_float .f64 := by
      rw [JuliaLean.Proofs.base.float.floatOfInt_roundRat]
      have hval : (JuliaLean.base.int.lit t 1).val = 1 := by cases t <;> decide
      rw [hval]
      rfl
    let y := floatOfInt .f64 x
    let inverse := JuliaLean.base.float.div_IEEEFloat (one_float .f64) y
    let result := JuliaLean.base.float.mul_IEEEFloat inverse inverse
    have hinv : integerInverse x = .ok inverse := by
      simp [integerInverse, JuliaLean.base.number.inv, hone, y, inverse, Bind.bind,
        Except.bind, Pure.pure, Except.pure]
    have hpow :
        literalPow_NegTwo integerInverse (fun a b => .ok (mul_IEEEFloat a b)) x =
          .ok result := by
      simp [literalPow_NegTwo, hinv, result, Bind.bind, Except.bind, Pure.pure,
        Except.pure]
    exact ⟨inverse, result, hinv, by simpa [y, inverse] using reciprocalValue_div_one y,
      hpow, by simpa [result] using roundedProduct_mul inverse inverse⟩
  · intro N R inv mul x err h
    simp [literalPow_NegTwo, h, Bind.bind, Except.bind]

private theorem bigDivrem_eq (n b : Int) (hb : b ≠ 0) :
    Concrete.bigDivrem n b = .ok (n.tdiv b, n.tmod b) := by
  simp [Concrete.bigDivrem, JuliaLean.base.intfuncs.bigOps, hb,
    Pure.pure, Except.pure]

private theorem bigFloor_eq_fdiv (n b : Int) (hb : 0 < b) :
    Concrete.bigFloor n b = .ok (n.fdiv b) := by
  have hb0 : b ≠ 0 := by omega
  have hx : Concrete.bigXor n b < 0 ↔ n < 0 := by
    cases n <;> cases b <;> simp [Concrete.bigXor] at * <;> omega
  have hxBool : decide (Concrete.bigXor n b < 0) = decide (n < 0) := by
    by_cases hn : n < 0
    · have hx' := hx.mpr hn
      simp [hn, hx']
    · have hx' : ¬ Concrete.bigXor n b < 0 := fun h' => hn (hx.mp h')
      simp [hn, hx']
  have htrunc : n.tdiv b * b + n.tmod b = n := by
    simpa [Int.mul_comm] using Int.mul_tdiv_add_tmod n b
  have hfloor : n.fmod b + n.fdiv b * b = n := Int.fmod_add_fdiv_mul n b
  have hmod := JuliaLean.Proofs.base.int.fmod_pos_tmod n b hb
  have hbounds := JuliaLean.Proofs.base.int.tmod_between n b
  have hquot : n.tdiv b -
      (if n < 0 ∧ n.tdiv b * b ≠ n then 1 else 0) = n.fdiv b := by
    by_cases hn : n < 0
    · by_cases hr0 : n.tmod b = 0
      · have hrnonneg : ¬ n.tmod b < 0 := by omega
        have hmod' : n.fmod b = n.tmod b := by
          simpa [hrnonneg] using hmod
        have hprod : n.tdiv b * b = n := by simpa [hr0] using htrunc
        have hfprod : n.fdiv b * b = n := by
          have h := hfloor
          rw [hmod', hr0] at h
          omega
        have hq : n.tdiv b = n.fdiv b :=
          Int.eq_of_mul_eq_mul_right hb0 (by omega)
        simp [hn, hprod, hq, hfprod]
      · have hrneg : n.tmod b < 0 := by
          have hr := hbounds.2 hn
          omega
        have hmod' := hmod
        rw [if_pos hrneg] at hmod'
        have hprod : n.tdiv b * b ≠ n := by
          intro h
          apply hr0
          omega
        have hqmul : (n.fdiv b + 1) * b = n.tdiv b * b := by
          have heq : n.tdiv b * b + n.tmod b =
              n.fmod b + n.fdiv b * b := by omega
          rw [hmod'] at heq
          rw [Int.add_mul, Int.one_mul]
          omega
        have hq : n.tdiv b = n.fdiv b + 1 :=
          Int.eq_of_mul_eq_mul_right hb0 hqmul.symm
        have hprod' : (n.fdiv b + 1) * b ≠ n := by
          rw [hqmul]
          exact hprod
        simp [hn, hprod', hq]
    · have hnonneg : 0 ≤ n := by omega
      have hrnonneg : ¬ n.tmod b < 0 := by
        have hr := hbounds.1 hnonneg
        omega
      have hmod' : n.fmod b = n.tmod b := by
        simpa [hrnonneg] using hmod
      have heq : n.tdiv b * b + n.tmod b =
          n.fmod b + n.fdiv b * b := by omega
      rw [hmod'] at heq
      have hqmul : n.tdiv b * b = n.fdiv b * b := by omega
      have hq : n.tdiv b = n.fdiv b :=
        Int.eq_of_mul_eq_mul_right hb0 hqmul
      simp [hn, hq]
  unfold Concrete.bigFloor JuliaLean.base.div.div_Integer_Down
  simp [JuliaLean.base.intfuncs.bigOps, hb0, hxBool, hquot,
    Bind.bind, Except.bind, Pure.pure, Except.pure]

private theorem bigFldmod_eq (n b : Int) (hb : 0 < b) :
    Concrete.bigFldmod n b = .ok (n.fdiv b, n.fmod b) := by
  have hrem : n - n.fdiv b * b = n.fmod b := by
    rw [Int.sub_eq_add_neg]
    have h := Int.fmod_add_fdiv_mul n b
    omega
  unfold Concrete.bigFldmod
  rw [JuliaLean.base.div.divrem_Integer_Directed]
  rw [if_neg (by decide : ¬ JuliaLean.base.div.DirectedMode.Down =
      JuliaLean.base.div.DirectedMode.ToZero), if_pos rfl]
  rw [bigFloor_eq_fdiv n b hb]
  simp only [Bind.bind, Except.bind, Pure.pure, Except.pure,
    Except.ok.injEq, Prod.mk.injEq]
  constructor
  · trivial
  · change n - n.fdiv b * b = n.fmod b
    exact hrem

private theorem bigDigitStep_spec (base n : Int) (hbase : 2 ≤ base.natAbs) :
    ∃ q d, (if base > 0 then Concrete.bigDivrem n base else do
      let (q', d') ← Concrete.bigFldmod n (-base)
      pure (-q', d')) = .ok (q, d) ∧
      n = base * q + d ∧ d.natAbs < base.natAbs ∧
      (base < 0 → 0 ≤ d) ∧
      (base > 0 → (n ≤ 0 → d ≤ 0) ∧ (0 ≤ n → 0 ≤ d) ∧
        (n ≤ 0 → q ≤ 0) ∧ (0 ≤ n → 0 ≤ q)) := by
  have hbase0 : base ≠ 0 := by
    intro hz
    subst base
    simp at hbase
  by_cases hpos : 0 < base
  · have hb0 : base ≠ 0 := by omega
    refine ⟨n.tdiv base, n.tmod base, ?_, ?_, ?_, ?_, ?_⟩
    · rw [if_pos hpos, bigDivrem_eq n base hb0]
    · have h := Int.mul_tdiv_add_tmod n base
      simpa [Int.mul_comm] using h.symm
    · rw [Int.natAbs_tmod]
      exact Nat.mod_lt _ (by omega)
    · intro _
      omega
    · intro _
      refine ⟨?_, ?_, ?_, ?_⟩
      · intro hn
        by_cases hneg : n < 0
        · exact (JuliaLean.Proofs.base.int.tmod_between n base).2 hneg |>.2
        · have hzero : n = 0 := by omega
          simp [hzero]
      · intro hn
        exact (JuliaLean.Proofs.base.int.tmod_between n base).1 hn |>.1
      · intro hn
        by_cases hneg : n < 0
        · have hq := Int.tdiv_nonneg (by omega : 0 ≤ -n) (by omega : 0 ≤ base)
          rw [Int.neg_tdiv] at hq
          omega
        · have hzero : n = 0 := by omega
          simp [hzero]
      · intro hn
        exact Int.tdiv_nonneg hn (by omega)
  · have hneg : base < 0 := by omega
    let b : Int := -base
    let q : Int := -(n.fdiv b)
    let d : Int := n.fmod b
    have hb : 0 < b := by dsimp [b]; omega
    refine ⟨q, d, ?_, ?_, ?_, ?_, ?_⟩
    · rw [if_neg (by omega : ¬ 0 < base), bigFldmod_eq n b hb]
      simp [q, d, Bind.bind, Except.bind, Pure.pure, Except.pure]
    · have hfloor := Int.fmod_add_fdiv_mul n b
      have hbaseEq : base = -b := by dsimp [b]; omega
      have hmul : base * q = n.fdiv b * b := by
        dsimp [q]
        rw [hbaseEq, Int.neg_mul, Int.mul_neg, Int.neg_neg, Int.mul_comm]
      rw [hmul]
      omega
    · have hbounds := JuliaLean.Proofs.base.int.fmod_bounds n b (by omega)
      have hlow : 0 ≤ d := by dsimp [d]; exact (hbounds.1 hb).1
      have hlt : d < b := by dsimp [d]; exact (hbounds.1 hb).2
      have hbaseNat : (base.natAbs : Int) = b := by
        have hbaseEq : base = -b := by dsimp [b]; omega
        rw [hbaseEq, Int.natAbs_neg, Int.natAbs_of_nonneg (by omega)]
      have hdnat : (d.natAbs : Int) = d := Int.natAbs_of_nonneg hlow
      have hltInt : (d.natAbs : Int) < (base.natAbs : Int) := by
        rw [hdnat, hbaseNat]
        exact hlt
      exact Int.ofNat_lt.mp hltInt
    · intro _
      have hbounds := JuliaLean.Proofs.base.int.fmod_bounds n b (by omega)
      dsimp [d]
      exact (hbounds.1 hb).1
    · intro h
      omega

private theorem list_set_middle {α : Type} (pre : List α) (old new : α)
    (tail : List α) :
    (pre ++ old :: tail).set pre.length new = pre ++ new :: tail := by
  induction pre with
  | nil => rfl
  | cons x xs ih => simp [List.set, ih]

private theorem vectorStore_prefix (a : Vector Int) (pre : List Int)
    (old new : Int) (tail : List Int)
    (hvals : a.values = pre ++ old :: tail) :
    (vectorStore a (a.first + pre.length) new).values = pre ++ new :: tail := by
  unfold vectorStore
  rw [hvals]
  have hindex : (a.first + (pre.length : Int) - a.first).toNat = pre.length := by omega
  rw [hindex]
  exact list_set_middle pre old new tail

private theorem evalpoly_append_digit (base : Int) (digits : List Int) (d : Int) :
    evalpoly base (digits ++ [d]) =
      evalpoly base digits + base ^ digits.length * d := by
  induction digits with
  | nil => simp [evalpoly]
  | cons x xs ih =>
    simp [evalpoly, ih, List.length, Int.pow_succ, Int.mul_add,
      Int.mul_assoc, Int.mul_comm, Int.add_assoc, Int.add_left_comm, Int.add_comm]
    ac_rfl
private theorem digitFoldPrefix (base original : Int) (step : Int → Jl (Int × Int))
    (hstep : ∀ n, ∃ q d, step n = .ok (q, d) ∧
      n = base * q + d ∧ d.natAbs < base.natAbs ∧
      (base < 0 → 0 ≤ d) ∧
      (base > 0 → (n ≤ 0 → d ≤ 0) ∧ (0 ≤ n → 0 ≤ d) ∧
        (n ≤ 0 → q ≤ 0) ∧ (0 ≤ n → 0 ≤ q))) :
    ∀ (a : Vector Int) (current : Int) (offset : Nat) (pre tail : List Int),
      pre.length = offset → a.values = pre ++ tail →
      offset + tail.length = a.values.length →
      evalpoly base pre + base ^ offset * current = original →
      DigitRange original base pre →
      (base > 0 → (original < 0 → current ≤ 0) ∧ (0 ≤ original → 0 ≤ current)) →
      ∀ k, k ≤ tail.length →
      ∃ after current' digits suffix,
        (List.range k).foldlM
          (fun (s : Vector Int × Int) (j : Nat) => do
            let (q, d) ← step s.2
            pure (vectorStore s.1 (s.1.first + (offset + j)) d, q))
          (a, current) = .ok (after, current') ∧
        digits.length = offset + k ∧ after.first = a.first ∧
        after.values = digits ++ suffix ∧
        offset + k + suffix.length = a.values.length ∧
        evalpoly base digits + base ^ (offset + k) * current' = original ∧
        DigitRange original base digits ∧
        (base > 0 → (original < 0 → current' ≤ 0) ∧ (0 ≤ original → 0 ≤ current')) := by
  intro a current offset pre tail hpre hvals hlen hpoly hrange hsign k
  revert a current offset pre tail hpre hvals hlen hpoly hrange hsign
  induction k with
  | zero =>
    intro a current offset pre tail hpre hvals hlen hpoly hrange hsign hle
    refine ⟨a, current, pre, tail, ?_, hpre, rfl, hvals, hlen, hpoly, hrange, hsign⟩
    simp [Pure.pure, Except.pure]
  | succ k ih =>
    intro a current offset pre tail hpre hvals hlen hpoly hrange hsign hle
    have hkle : k ≤ tail.length := by omega
    obtain ⟨after, current', digits, suffix, hfold, hdigits, hfirst,
      hvalues, hsuffix, hpoly', hrange', hsign'⟩ :=
      ih a current offset pre tail hpre hvals hlen hpoly hrange hsign hkle
    have hsuffixPos : 0 < suffix.length := by omega
    cases suffix with
    | nil => simp at hsuffixPos
    | cons old rest =>
      obtain ⟨q, d, hstepCall, hstepValue, habs, hneg, hpos⟩ := hstep current'
      let after' := vectorStore after (after.first + (offset + k)) d
      have hdigits' : (digits ++ [d]).length = offset + (k + 1) := by
        simp [hdigits]
        omega
      have hvalues' : after'.values = (digits ++ [d]) ++ rest := by
        dsimp [after']
        have hcast : (digits.length : Int) = (offset + k : Nat) := by
          exact congrArg (fun x : Nat => (x : Int)) hdigits
        have hindex : (offset : Int) + (k : Int) = (digits.length : Int) := by
          simpa only [Int.natCast_add] using hcast.symm
        rw [hindex]
        simpa [List.append_assoc] using
          (vectorStore_prefix after digits old d rest hvalues)
      have hsuffix' : offset + (k + 1) + rest.length = a.values.length := by
        have hlen' : offset + k + (rest.length + 1) = a.values.length := by
          simpa using hsuffix
        omega
      have hstepValue' : d + base * q = current' := by omega
      have hpow : base ^ (offset + (k + 1)) = base ^ (offset + k) * base := by
        have heq : offset + (k + 1) = offset + k + 1 := by omega
        rw [heq, Int.pow_succ]
      have hpoly'' :
          evalpoly base (digits ++ [d]) + base ^ (offset + (k + 1)) * q = original := by
        rw [evalpoly_append_digit, hdigits, hpow]
        calc
          evalpoly base digits + base ^ (offset + k) * d +
              (base ^ (offset + k) * base) * q =
            evalpoly base digits + base ^ (offset + k) * (d + base * q) := by
              rw [Int.add_assoc, Int.mul_add, Int.mul_assoc]
          _ = evalpoly base digits + base ^ (offset + k) * current' := by
            rw [hstepValue']
          _ = original := hpoly'
      have hrange'' : DigitRange original base (digits ++ [d]) := by
        unfold DigitRange at hrange' ⊢
        intro x hx
        rcases List.mem_append.mp hx with hx | hx
        · exact hrange' x hx
        · simp only [List.mem_singleton] at hx
          subst x
          refine ⟨habs, ?_, ?_⟩
          · intro hbaseNeg
            exact hneg hbaseNeg
          · intro hbasePos
            rcases hpos hbasePos with ⟨hcurNeg, hcurPos, _, _⟩
            refine ⟨?_, ?_⟩
            · intro hnegative
              exact hcurNeg ((hsign' hbasePos).1 hnegative)
            · intro hnonnegative
              exact hcurPos ((hsign' hbasePos).2 hnonnegative)
      have hsign'' :
          base > 0 →
            (original < 0 → q ≤ 0) ∧ (0 ≤ original → 0 ≤ q) := by
        intro hbasePos
        rcases hpos hbasePos with ⟨_, _, hqNeg, hqPos⟩
        refine ⟨?_, ?_⟩
        · intro hnegative
          exact hqNeg ((hsign' hbasePos).1 hnegative)
        · intro hnonnegative
          exact hqPos ((hsign' hbasePos).2 hnonnegative)
      have hfold' :
          (List.range (k + 1)).foldlM
            (fun (s : Vector Int × Int) (j : Nat) => do
              let (q, d) ← step s.2
              pure (vectorStore s.1 (s.1.first + (offset + j)) d, q))
            (a, current) = .ok (after', q) := by
        rw [List.range_succ, List.foldlM_append, hfold, ok_bind,
          List.foldlM_cons, hstepCall, ok_bind]
        simp [List.foldlM_nil, Bind.bind, Except.bind, Pure.pure, Except.pure]
        rfl
      refine ⟨after', q, digits ++ [d], rest, hfold', hdigits', ?_, hvalues',
        hsuffix', hpoly'', hrange'', hsign''⟩
      dsimp [after']
      exact hfirst
theorem hasTypeMaxSpec_proven : HasTypeMaxSpec := by
  refine ⟨JuliaLean.Proofs.base.intfuncs.digitsErrors_proven, ?_,
    JuliaLean.Proofs.base.intfuncs.hasTypeMaxSpec_proven⟩
  intro n base before hbase
  have hvalid : ¬ bigOps.value (bigOps.abs base) < 2 := by
    change ¬ (base.natAbs : Int) < 2
    omega
  let step : Int → Jl (Int × Int) := fun x =>
    if base > 0 then Concrete.bigDivrem x base else do
      let (q, d) ← Concrete.bigFldmod x (-base)
      pure (-q, d)
  have hstep : ∀ x, ∃ q d, step x = .ok (q, d) ∧
      x = base * q + d ∧ d.natAbs < base.natAbs ∧
      (base < 0 → 0 ≤ d) ∧
      (base > 0 → (x ≤ 0 → d ≤ 0) ∧ (0 ≤ x → 0 ≤ d) ∧
        (x ≤ 0 → q ≤ 0) ∧ (0 ≤ x → 0 ≤ q)) := by
    intro x
    simpa [step] using bigDigitStep_spec base x hbase
  cases hv : before.values with
  | nil =>
      refine ⟨before, ?_, rfl, by simp [hv], ?_, ⟨n, ?_⟩⟩
      · unfold Concrete.bigDigitsBang JuliaLean.base.intfuncs.digitsBang
        rw [if_neg hvalid]
        rw [if_neg (by simp [hasTypeMax])]
        rw [if_pos (by simp [hv])]
        rfl
      · intro d hd
        simp [hv] at hd
      · simp [evalpoly, hv]
  | cons old tail =>
      have hnotempty : ¬ before.values.isEmpty := by simp [hv]
      by_cases hpos : base > 0
      · have hsign0 : base > 0 →
            (n < 0 → n ≤ 0) ∧ (0 ≤ n → 0 ≤ n) := by
          intro _
          exact ⟨by omega, by omega⟩
        have hrange0 : DigitRange n base [] := by
          intro d hd
          simp at hd
        have hpoly0 : evalpoly base [] + base ^ 0 * n = n := by
          simp [evalpoly]
        obtain ⟨after, q, digits, suffix, hfold, hdigits, hfirst,
          hvalues, hlength, hpoly, hrange, _⟩ :=
          (digitFoldPrefix base n step hstep before n 0 [] before.values
