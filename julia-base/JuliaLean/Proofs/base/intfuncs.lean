theorem literalInverseSquare_proven : LiteralInverseSquare := by
  refine ⟨?_, ?_⟩
  · intro t num den inv mul _ hden hinv hmul x hx
    unfold literalPow_NegTwo
    obtain ⟨i, hi, hispec⟩ := hinv x hx
    obtain ⟨r, hr, hrspec⟩ := hmul i i
    refine ⟨r, ?_, ?_⟩
    · simp [hi, hr, Bind.bind, Except.bind]
    · have hpow (z : Int) : z ^ 2 = z * z := by simp [Int.pow_succ, Int.pow_zero, Int.one_mul]
      rw [hpow (num x), hpow (den x)]
      have hdi : den i ≠ 0 := by have := hden i; omega
      have hdii : den i * den i ≠ 0 := Int.mul_ne_zero hdi hdi
      have h1 : (num i * num x) * (num i * num x) = (den i * den x) * (den i * den x) :=
        congrArg (fun z => z * z) hispec
      have hkey : num r * (num x * num x) * (den i * den i) =
          den r * (den x * den x) * (den i * den i) := by
        have step1 : num r * (num x * num x) * (den i * den i) =
            (num r * (den i * den i)) * (num x * num x) := by ac_rfl
        have step2 : (num i * num i * den r) * (num x * num x) =
            den r * ((num i * num x) * (num i * num x)) := by ac_rfl
        have step3 : den r * ((den i * den x) * (den i * den x)) =
            den r * (den x * den x) * (den i * den i) := by ac_rfl
        rw [step1, hrspec, step2, h1, step3]
      exact Int.eq_of_mul_eq_mul_right hdii hkey
  · intro T x inv y hy
    simp [literalPow_NegTwo, hy, Bind.bind, Except.bind, Pure.pure, Except.pure]

theorem powermodZeroModulus_proven : PowermodZeroModulus := by
