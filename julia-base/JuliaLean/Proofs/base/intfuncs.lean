def oddProduct : Nat → Nat
  | 0 => 1
  | n + 1 => if (n + 1) % 2 = 1 then (n + 1) * oddProduct n else oddProduct n

theorem oddProduct_odd (n : Nat) : oddProduct n % 2 = 1 := by
  induction n with
  | zero => rfl
  | succ n ih =>
    rw [oddProduct]
    split
    · rename_i h
      rw [Nat.mul_mod, h, ih]
    · exact ih

theorem factorial_halves (n : Nat) :
    factorialMath n = 2 ^ (n / 2) * factorialMath (n / 2) * oddProduct n := by
  induction n with
  | zero => rfl
  | succ n ih =>
    rw [factorialMath, ih, oddProduct]
    by_cases hodd : (n + 1) % 2 = 1
    · rw [if_pos hodd]
      have hq : (n + 1) / 2 = n / 2 := by omega
      rw [hq]
      ac_rfl
    · rw [if_neg hodd]
      have hq : (n + 1) / 2 = n / 2 + 1 := by omega
      have hn : n + 1 = 2 * (n / 2 + 1) := by omega
      rw [hq, factorialMath, Nat.pow_succ]
      rw [hn]
      ac_rfl

def factorialExponent : Nat → Nat → Nat
  | 0, _ => 0
  | w + 1, n => n / 2 + factorialExponent w (n / 2)

theorem quotient_below_power (w n : Nat) (hn : n < 2 ^ (w + 1)) :
    n / 2 < 2 ^ w := by
  apply (Nat.div_lt_iff_lt_mul (by decide : 0 < 2)).mpr
  simpa only [Nat.pow_succ] using hn

theorem factorial_factor_two (w n : Nat) (hn : n < 2 ^ w) :
    ∃ odd, odd % 2 = 1 ∧ factorialMath n = 2 ^ factorialExponent w n * odd := by
  induction w generalizing n with
  | zero =>
    have hn0 : n = 0 := by simp only [Nat.pow_zero] at hn; omega
    subst n
    exact ⟨1, rfl, rfl⟩
  | succ w ih =>
    obtain ⟨odd, hodd, hfac⟩ := ih (n / 2) (quotient_below_power w n hn)
    refine ⟨odd * oddProduct n, ?_, ?_⟩
    · rw [Nat.mul_mod, hodd, oddProduct_odd]
    · rw [factorial_halves, hfac, factorialExponent, Nat.pow_add]
      ac_rfl

theorem factorialExponent_stable (w n : Nat) (hn : n < 2 ^ (w + 1)) :
    factorialExponent (w + 1) n = factorialExponent w n := by
  induction w generalizing n with
  | zero =>
    have hq : n / 2 = 0 := by change n < 2 at hn; omega
    simp only [factorialExponent, hq, Nat.zero_add]
  | succ w ih =>
    change n / 2 + factorialExponent (w + 1) (n / 2) =
      n / 2 + factorialExponent w (n / 2)
    rw [ih (n / 2) (quotient_below_power (w + 1) n hn)]

theorem factorialExponent_add (w a b c : Nat) (hc : c ≤ 1) :
    factorialExponent w (a + b + c) ≤
      factorialExponent w a + factorialExponent w b + w := by
  induction w generalizing a b c with
  | zero => simp only [factorialExponent, Nat.zero_add, Nat.le_refl]
  | succ w ih =>
    let carry := (a % 2 + b % 2 + c) / 2
    have hcarry : carry ≤ 1 := by dsimp only [carry]; omega
    have hq : (a + b + c) / 2 = a / 2 + b / 2 + carry := by
      dsimp only [carry]
      omega
    have h := ih (a / 2) (b / 2) carry hcarry
    simp only [factorialExponent]
    rw [hq]
    omega

theorem two_power_odd_unique (a b u v : Nat) (hu : u % 2 = 1) (hv : v % 2 = 1)
    (h : 2 ^ a * u = 2 ^ b * v) : a = b := by
  induction a generalizing b with
  | zero =>
    cases b with
    | zero => rfl
    | succ b =>
      have hm := congrArg (fun n : Nat => n % 2) h
      simp only [Nat.pow_zero, Nat.one_mul, hu, Nat.pow_succ, Nat.mul_mod,
        Nat.mod_self, Nat.mul_zero, Nat.zero_mul, Nat.zero_mod] at hm
      omega
  | succ a ih =>
    cases b with
    | zero =>
      have hm := congrArg (fun n : Nat => n % 2) h
      simp only [Nat.pow_zero, Nat.one_mul, hv, Nat.pow_succ, Nat.mul_mod,
        Nat.mod_self, Nat.mul_zero, Nat.zero_mul, Nat.zero_mod] at hm
      omega
    | succ b =>
      have he : 2 * (2 ^ a * u) = 2 * (2 ^ b * v) := by
        simpa only [Nat.pow_succ, Nat.mul_assoc, Nat.mul_comm, Nat.mul_left_comm] using h
      have hc : 2 ^ a * u = 2 ^ b * v :=
        Nat.eq_of_mul_eq_mul_left (by decide : 0 < 2) he
      exact congrArg Nat.succ (ih b hc)

theorem choose_zero (n : Nat) : chooseMath n 0 = 1 := by
  cases n <;> rfl

theorem choose_above (n k : Nat) (h : n < k) : chooseMath n k = 0 := by
  induction n generalizing k with
  | zero => cases k <;> (first | omega | rfl)
  | succ n ih =>
    cases k with
    | zero => omega
    | succ k => rw [chooseMath, ih k (by omega), ih (k + 1) (by omega)]

theorem choose_one (n : Nat) : chooseMath n 1 = n := by
  induction n with
  | zero => rfl
  | succ n ih => rw [chooseMath, ih, choose_zero]; omega

theorem choose_mul_step (n k : Nat) :
    (k + 1) * chooseMath (n + 1) (k + 1) = (n + 1) * chooseMath n k := by
  induction n generalizing k with
  | zero =>
    cases k with
    | zero => rfl
    | succ k =>
      rw [choose_above 1 (k + 1 + 1) (by omega),
        choose_above 0 (k + 1) (by omega), Nat.mul_zero, Nat.mul_zero]
  | succ n ih =>
    cases k with
    | zero =>
      rw [choose_one, choose_zero]
      simp only [Nat.zero_add, Nat.one_mul, Nat.mul_one]
    | succ k =>
      have ha := ih k
      have hb := ih (k + 1)
      have hc : chooseMath (n + 1) (k + 1) = chooseMath n k + chooseMath n (k + 1) := rfl
      rw [chooseMath]
      rw [Nat.mul_add, show (k + 1 + 1) * chooseMath (n + 1) (k + 1) =
          (k + 1) * chooseMath (n + 1) (k + 1) + chooseMath (n + 1) (k + 1) by
            rw [Nat.add_mul, Nat.one_mul], ha, hb]
      simp only [hc, Nat.add_mul, Nat.one_mul, Nat.mul_add]
      omega

theorem choose_factorial (n k : Nat) (hk : k ≤ n) :
    chooseMath n k * factorialMath k * factorialMath (n - k) = factorialMath n := by
  induction k generalizing n with
  | zero => simp only [choose_zero, factorialMath, Nat.one_mul, Nat.mul_one, Nat.sub_zero]
  | succ k ih =>
    cases n with
    | zero => omega
    | succ n =>
      have ih' := ih n (by omega)
      rw [factorialMath, Nat.add_sub_add_right]
      calc
        chooseMath (n + 1) (k + 1) * ((k + 1) * factorialMath k) * factorialMath (n - k) =
            ((k + 1) * chooseMath (n + 1) (k + 1)) *
              (factorialMath k * factorialMath (n - k)) := by ac_rfl
        _ = ((n + 1) * chooseMath n k) * (factorialMath k * factorialMath (n - k)) := by
          rw [choose_mul_step]
        _ = (n + 1) * (chooseMath n k * factorialMath k * factorialMath (n - k)) := by ac_rfl
        _ = factorialMath (n + 1) := by rw [ih']; rfl

theorem chooseMath_not_power_two (N K w : Nat) (hw : 1 ≤ w)
    (hN : N < 2 ^ w) (hK : K ≤ N) : chooseMath N K ≠ 2 ^ w := by
  intro he
  obtain ⟨on, hon, hfn⟩ := factorial_factor_two w N hN
  obtain ⟨ok, hok, hfk⟩ := factorial_factor_two w K (by omega)
  obtain ⟨ol, hol, hfl⟩ := factorial_factor_two w (N - K) (by omega)
  have hfac := choose_factorial N K hK
  rw [he, hfn, hfk, hfl] at hfac
  have hpow : 2 ^ (w + factorialExponent w K + factorialExponent w (N - K)) * (ok * ol) =
      2 ^ factorialExponent w N * on := by
    simpa only [Nat.pow_add, Nat.mul_assoc, Nat.mul_comm, Nat.mul_left_comm] using hfac
  have heq := two_power_odd_unique _ _ _ _
    (by rw [Nat.mul_mod, hok, hol]) hon hpow
  cases w with
  | zero => omega
  | succ w =>
    have hn := factorialExponent_stable w N hN
    have hk := factorialExponent_stable w K (by omega : K < 2 ^ (w + 1))
    have hl := factorialExponent_stable w (N - K) (by omega : N - K < 2 ^ (w + 1))
    rw [hn, hk, hl] at heq
    have hb := factorialExponent_add w K (N - K) 0 (by decide)
    have hs : K + (N - K) + 0 = N := by omega
    rw [hs] at hb
    omega

