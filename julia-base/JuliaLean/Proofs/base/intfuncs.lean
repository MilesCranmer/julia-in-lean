namespace JuliaLean.Proofs.base.intfuncs.Models2Group16

open JuliaLean JuliaLean.Registry
open JuliaLean.base.intfuncs.Models2Group16

/-- A source-visible store attempt and the live table immediately before
that selected buffer operation, including an operation which mutates it. -/
structure FormattingStoreEvent (V Buf : Type) where
  buffer : Buf
  value : Sum (JInt .u8) V
  position : JInt64
  tableBefore : FormattingPairs
  result : Except JuliaLean.base.io.Error Unit

inductive FormattingAppendEvent (V Buf Other : Type) where
  | store (event : FormattingStoreEvent V Buf)
  | zero (value : V) (result : Except JuliaLean.base.io.Error Bool)
  | customC (length : JInt64) (value : V) (buffer : Buf) (position : JInt64)
      (result : Except JuliaLean.base.io.Error (Sum JInt64 Other))
  | customNine (value : V) (buffer : Buf) (position : JInt64)
      (result : Except JuliaLean.base.io.Error (Sum JInt64 Other))

/-- Every original action retains its table mutations, error state and
divergence; only the observation log is threaded through the product layout. -/
def liftAppendObservation {W E A : Type}
    (action : JuliaLean.base.io.M (FormattingAppendWorld W) A) :
    JuliaLean.base.io.M (FormattingAppendWorld (W × List E)) A := fun ((world, trace), table) =>
  match action (world, table) with
  | none => none
  | some (.ok (value, (world, table))) => some (.ok (value, ((world, trace), table)))
  | some (.error (error, (world, table))) => some (.error (error, ((world, trace), table)))

def recordAppendObservation {W E A : Type}
    (event : Except JuliaLean.base.io.Error A → E)
    (action : JuliaLean.base.io.M (FormattingAppendWorld W) A) :
    JuliaLean.base.io.M (FormattingAppendWorld (W × List E)) A := fun ((world, trace), table) =>
  match recordCall event action ((world, table), trace) with
  | none => none
  | some (.ok (value, ((world, table), trace))) => some (.ok (value, ((world, trace), table)))
  | some (.error (error, ((world, table), trace))) => some (.error (error, ((world, trace), table)))

def observeFormattingAppend {W V Iter State Buf Other : Type}
    (ops : FormattingAppendOps W V Iter State Buf Other) :
    FormattingAppendOps (W × List (FormattingAppendEvent V Buf Other)) V Iter State Buf Other where
  divrem100 := fun x n => liftAppendObservation (ops.divrem100 x n)
  divremChunk := fun x n => liftAppendObservation (ops.divremChunk x n)
  indexedFirst := fun x i => liftAppendObservation (ops.indexedFirst x i)
  indexedNext := fun x i s => liftAppendObservation (ops.indexedNext x i s)
  oftype := fun x y => liftAppendObservation (ops.oftype x y)
  remInt := fun x => liftAppendObservation (ops.remInt x)
  remTen := fun x n => liftAppendObservation (ops.remTen x n)
  remByte := fun x => liftAppendObservation (ops.remByte x)
  addByte := fun x y => liftAppendObservation (ops.addByte x y)
  store := fun buf value position => do
    let (_, table) ← JuliaLean.base.io.getWorld
    recordAppendObservation (fun result => .store ⟨buf, value, position, table, result⟩)
      (ops.store buf value position)
  equalZero := fun x zero => recordAppendObservation (.zero x) (ops.equalZero x zero)
  greaterUInt := fun x n => liftAppendObservation (ops.greaterUInt x n)
  remUInt32 := fun x => liftAppendObservation (ops.remUInt32 x)
  remUInt64 := fun x => liftAppendObservation (ops.remUInt64 x)
  cRoute := ops.cRoute
  customC := fun n x buf pos => recordAppendObservation (.customC n x buf pos) (ops.customC n x buf pos)
  nineRoute := ops.nineRoute
  customNine := fun x buf pos => recordAppendObservation (.customNine x buf pos) (ops.customNine x buf pos)

def formattingAppendStores {V Buf Other : Type} (trace : List (FormattingAppendEvent V Buf Other)) :
    List (FormattingStoreEvent V Buf) :=
  trace.filterMap fun event => match event with | .store event => some event | _ => none

/-- A mathematical destination sequence, independent of either source loop:
descending decimal pairs and an odd leading byte last, at native width. -/
def formattingPairPositions (length pos : JInt64) : List JInt64 :=
  ((List.range (length.val.toNat / 2)).flatMap fun (k : Nat) =>
    [JInt.wrap .i64 (pos.val + length.val - 2 * ((k : Int) + 1)),
     JInt.wrap .i64 (pos.val + length.val - 2 * (k : Int) - 1)]) ++
    (if length.val.toNat % 2 = 1 then [pos] else [])

/-- Distinct destinations in the original native digit span, preserving
buffer identity and the last failing store. No dispatch laws are imposed.
Julia source invariant: base/intfuncs.jl:938-980. -/
def FormattingAppendStoreBounds {V Buf : Type} (length : JInt64) (buf : Buf) (pos : JInt64)
    (stores : List (FormattingStoreEvent V Buf)) : Prop :=
  stores.length ≤ length.val.toNat ∧
  (stores.map FormattingStoreEvent.position).Nodup ∧
  (∀ event ∈ stores, event.buffer = buf ∧
    ∃ k : Nat, k < length.val.toNat ∧
      (event.position.val - pos.val - (k : Int)) % (2 ^ 64 : Int) = 0) ∧
  (∀ event ∈ stores, ∀ error, event.result = .error error → stores.getLast? = some event)

/-- Native-position conservation and live-table byte provenance. The second
byte retains the same actual pre-first-store table cell even when the first
custom buffer store aliases/mutates _dec_d100. All lengths, positions and
custom values are included; errors retain their attempted-write prefix.
Julia source invariant: base/intfuncs.jl:938-952. -/
def AppendCDigitsPositionAndTableProvenance : Prop :=
  ∀ (W V Iter State Buf Other : Type) (ops : FormattingAppendOps W V Iter State Buf Other)
      (length : JInt64) (digits : V) (buf : Buf) (pos : JInt64) (world : FormattingAppendWorld W),
    match appendCDigits (observeFormattingAppend ops) length digits buf pos ((world.1, []), world.2) with
    | none => True
    | some result =>
      let trace := match result with | .ok (_, ((_, t), _)) => t | .error (_, ((_, t), _)) => t
      let stores := formattingAppendStores trace
      FormattingAppendStoreBounds length buf pos stores ∧
      stores.map FormattingStoreEvent.position = (formattingPairPositions length pos).take stores.length ∧
      (∀ k first, k < length.val.toNat / 2 → stores[2*k]? = some first →
        ∃ cell ∈ first.tableBefore.cells,
          first.value = .inl (JuliaLean.base.int.remT .u8 cell) ∧
          ∀ second, stores[2*k+1]? = some second →
            second.value = .inl (JuliaLean.base.int.lit .u8 (cell.val / 256))) ∧
      (match result with
       | .ok (returned, _) => stores.length = length.val.toNat ∧
           (returned.val - pos.val - length.val) % (2 ^ 64 : Int) = 0 ∧
           ∀ event ∈ stores, event.result = .ok ()
       | .error (error, _) => ∀ event ∈ stores,
           event.result = .error error ∨ event.result = .ok ())

/-- The zero branch writes nine ASCII zeros at consecutive wrapped native
positions. Other successful paths execute the actual nine-digit base body
or retain the selected custom append result. No truth or arithmetic law is
imposed on the test/callees. Julia source invariant: base/intfuncs.jl:954-963. -/
def AppendNineDigitsBranchAccounting : Prop :=
  ∀ (W V Iter State Buf Other : Type) (ops : FormattingAppendOps W V Iter State Buf Other)
      (digits : V) (buf : Buf) (pos : JInt64) (world : FormattingAppendWorld W),
    match appendNineDigits (observeFormattingAppend ops) digits buf pos ((world.1, []), world.2) with
    | none => True
    | some result =>
      let trace := match result with | .ok (_, ((_, t), _)) => t | .error (_, ((_, t), _)) => t
      let stores := formattingAppendStores trace
