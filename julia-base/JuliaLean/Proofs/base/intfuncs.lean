-- 1. intfuncs-gcd-rational-dispatch-provenance
theorem gcdRationalOpenDispatchProvenance_proven : GcdRationalOpenDispatchProvenance := by
  intro W I U R ops a world
  unfold gcdUnaryRational observeRationalUnaryOps
  dsimp only
  simp only [io_bind, recordCall_snapshot, resumeRationalOutcome_apply]
  cases h1 : ops.checkedAbs a.num world with
  | none => trivial
  | some r1 =>
    cases r1 with
    | error e1 =>
      rcases e1 with ⟨err, w1⟩
      dsimp [RationalUnaryProvenance, RationalUnaryWorldAccounting, RationalUnaryTerminal,
        rationalAbsoluteInputs, rationalAbsoluteOutputs, rationalRatioInputs, rationalRatioOutputs,
        rationalEventWorlds, rationalEventError]
      exact ⟨⟨rfl, le_of_eq 0, rfl, rfl, _, rfl⟩, ⟨rfl, rfl, rfl⟩, ⟨rfl, rfl, _, rfl, rfl⟩⟩
    | ok v1 =>
      rcases v1 with ⟨num, w1⟩
      dsimp
      cases h2 : ops.ratio num a.den w1 with
      | none => trivial
      | some r2 =>
        cases r2 with
        | error e2 =>
          rcases e2 with ⟨err, w2⟩
          dsimp [RationalUnaryProvenance, RationalUnaryWorldAccounting, RationalUnaryTerminal,
            rationalAbsoluteInputs, rationalAbsoluteOutputs, rationalRatioInputs, rationalRatioOutputs,
            rationalEventWorlds, rationalEventError]
          exact ⟨⟨rfl, le_of_eq 1, rfl, rfl, _, rfl⟩, ⟨rfl, rfl, rfl⟩, ⟨rfl, rfl, _, rfl, rfl⟩⟩
        | ok v2 =>
          rcases v2 with ⟨res, w2⟩
          dsimp [RationalUnaryProvenance, RationalUnaryWorldAccounting, RationalUnaryTerminal,
            rationalAbsoluteInputs, rationalAbsoluteOutputs, rationalRatioInputs, rationalRatioOutputs,
            rationalEventWorlds, rationalEventError]
          exact ⟨⟨rfl, le_of_eq 1, rfl, rfl, _, rfl⟩, ⟨rfl, rfl, rfl⟩, ⟨rfl, rfl, rfl⟩⟩

-- 2. intfuncs-gcd-rational-native-numerator-gate
theorem gcdRationalNativeNumeratorGate_proven : GcdRationalNativeNumeratorGate := by
  intro W R t ratio a world
  have habs := JuliaLean.Proofs.base.intfuncs.opusBinGcd.checkedAbs_eo t a.num
  unfold ExactOrOverflow at habs
  have hmin : t.min ≤ (a.num.val.natAbs : Int) := by
    have : t.min ≤ 0 := by cases t <;> decide
    omega
  dsimp only
  unfold gcdUnaryRational observeRationalUnaryOps
  dsimp only
  simp only [io_bind, recordCall_snapshot, resumeRationalOutcome_apply]
  by_cases hmax : (a.num.val.natAbs : Int) ≤ t.max
  · have hfit : fits t (a.num.val.natAbs : Int) := ⟨hmin, hmax⟩
    rw [ite_eq_left hmax]
    rw [ite_eq_left hfit] at habs
    obtain ⟨u, hu, huval⟩ := habs
    rw [hu, io_liftJl]
    dsimp
    cases hr : ratio u a.den world with
    | none => trivial
    | some r =>
      cases r with
      | ok vw =>
        rcases vw with ⟨res, w1⟩
        dsimp [rationalAbsoluteOutputs, rationalRatioInputs]
        exact ⟨congrArg (· :: []) huval, congrArg (· :: []) huval, rfl⟩
      | error ew =>
        rcases ew with ⟨err, w1⟩
        dsimp [rationalAbsoluteOutputs, rationalRatioInputs]
        exact ⟨congrArg (· :: []) huval, congrArg (· :: []) huval, rfl⟩
  · have hnf : ¬ fits t (a.num.val.natAbs : Int) := fun hf => hmax hf.2
    rw [ite_eq_right hmax]
    rw [ite_eq_right hnf] at habs
    cases hc : JuliaLean.base.checked.checkedAbsBits a.num with
    | ok _ => rw [hc] at habs; cases habs
    | error e =>
      rw [hc] at habs
      cases e with
      | overflowError msg =>
        dsimp [rationalRatioInputs]
        exact ⟨rfl, rfl, rfl⟩
      | _ => cases habs

