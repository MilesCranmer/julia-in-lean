theorem digitsErrors_proven : DigitsErrors := by
  refine ⟨?_, ?_⟩
  · intro t b e n base a
    have habs : (JuliaLean.base.int.abs base).val =
        if b.signed = true ∧ base.val = b.min then b.min else (base.val.natAbs : Int) :=
      JuliaLean.Proofs.base.int.abs_val base
    have hbmin_lt : b.signed = true → b.min < 2 := by
      intro hs; cases b <;> simp_all [IntTy.signed, IntTy.min, IntTy.bits]
    refine ⟨?_, ?_⟩
    · intro hdom
      unfold digitsBangBits digitsBang bitsOps bitOps
      have hlt2 : (JuliaLean.base.int.abs base).val < 2 := by
        rw [habs]
        rcases hdom with h1 | h2
        · split
          · next hm => exact hbmin_lt hm.1
          · omega
        · rw [if_pos h2]
          exact hbmin_lt h2.1
      change domainError (if (JuliaLean.base.int.abs base).val < 2 then .error (.domainError "") else _)
      rw [if_pos hlt2]
      trivial
    · intro hnotmin ⟨hbig, h2⟩
      unfold digitsBangBits digitsBang bitsOps bitOps
      have hnotmin' : ¬ (b.signed = true ∧ base.val = b.min) := by
        intro ⟨hs, hm⟩
        rcases hnotmin with hu | hne
        · exact Bool.noConfusion (hu.symm.trans hs)
        · exact hne hm
      have habs' : (JuliaLean.base.int.abs base).val = (base.val.natAbs : Int) := by
        rw [habs, if_neg hnotmin']
      have hge2 : ¬ (JuliaLean.base.int.abs base).val < 2 := by rw [habs']; omega
      have hsub : (JuliaLean.base.int.sub (JuliaLean.base.int.abs base) (JuliaLean.base.int.lit b 1)).val =
          (base.val.natAbs : Int) - 1 := by
        rw [JuliaLean.base.int.sub, JuliaLean.Proofs.base.int.sub_int_val, habs']
        have h1 : (JuliaLean.base.int.lit b 1).val = 1 := by cases b <;> decide
        rw [h1]
        apply wrapInt_of_inRange b
        have hbprop := base.property
        cases b <;> simp_all [IntTy.signed, IntTy.min, IntTy.max, IntTy.bits] <;> omega
      have hcond : (hasTypeMax true true && decide ((JuliaLean.base.int.sub (JuliaLean.base.int.abs base)
          (JuliaLean.base.int.lit b 1)).val > e.max)) = true := by
        simp [hasTypeMax, hsub, hbig]
      change argumentError (if (JuliaLean.base.int.abs base).val < 2 then .error (.domainError "")
        else if (hasTypeMax true true && decide ((JuliaLean.base.int.sub (JuliaLean.base.int.abs base)
          (JuliaLean.base.int.lit b 1)).val > e.max)) = true then .error (.argumentError "") else _)
      rw [if_neg hge2, if_pos hcond]
      trivial
  · intro V hasMax elementMax convert n base a
    refine ⟨?_, ?_⟩
    · intro hdom
      unfold digitsBang
      have hlt2 : bigOps.value (bigOps.abs base) < 2 := by
        change (base.natAbs : Int) < 2; omega
      rw [if_pos hlt2]
      trivial
    · intro ⟨hmax, hbig, h2⟩
      unfold digitsBang
      have hge2 : ¬ bigOps.value (bigOps.abs base) < 2 := by
        change ¬ (base.natAbs : Int) < 2; omega
      have hcond : (hasMax && decide (bigOps.value (bigOps.sub (bigOps.abs base) (bigOps.ofInt 1)) > elementMax)) = true := by
        change (hasMax && decide ((base.natAbs : Int) - 1 > elementMax)) = true
        simp [hmax, hbig]
      rw [if_neg hge2, if_pos hcond]
      trivial

private theorem clampOrder_spec {X L H O T : Type} (order : ClampOrderOps X L H O T) (x : X) (lo : L) (hi : H)
    (hlo_hi : ¬ order.lt (order.projectHi hi) (order.projectLo lo)) :
    ∃ y, clamp (fun x hi => order.less (order.projectHi hi) (order.projectX x))
      (fun x lo => order.less (order.projectX x) (order.projectLo lo))
      order.convertX order.convertLo order.convertHi x lo hi = .ok y ∧
      ¬ order.lt (order.projectT y) (order.projectLo lo) ∧
      ¬ order.lt (order.projectHi hi) (order.projectT y) ∧
      (¬ order.lt (order.projectX x) (order.projectLo lo) →
       ¬ order.lt (order.projectHi hi) (order.projectX x) →
       order.projectT y = order.projectX x) := by
  unfold clamp
  by_cases hgt : order.less (order.projectHi hi) (order.projectX x) = true
  · rw [if_pos hgt]
    have hlt_hix : order.lt (order.projectHi hi) (order.projectX x) := (order.lessSpec _ _).mp hgt
    obtain ⟨y, hy, hyproj⟩ := order.convertHiSpec hi
    refine ⟨y, hy, ?_, ?_, ?_⟩
    · rw [hyproj]; exact hlo_hi
    · rw [hyproj]; exact order.irrefl _
    · intro _ hnot; exact absurd hlt_hix hnot
  · rw [if_neg hgt]
    have hnot_hix : ¬ order.lt (order.projectHi hi) (order.projectX x) :=
      fun h => hgt ((order.lessSpec _ _).mpr h)
    by_cases hlt : order.less (order.projectX x) (order.projectLo lo) = true
    · rw [if_pos hlt]
      have hlt_xlo : order.lt (order.projectX x) (order.projectLo lo) := (order.lessSpec _ _).mp hlt
      obtain ⟨y, hy, hyproj⟩ := order.convertLoSpec lo
      refine ⟨y, hy, ?_, ?_, ?_⟩
      · rw [hyproj]; exact order.irrefl _
      · rw [hyproj]; exact hlo_hi
      · intro hnot _; exact absurd hlt_xlo hnot
    · rw [if_neg hlt]
      have hnot_xlo : ¬ order.lt (order.projectX x) (order.projectLo lo) :=
        fun h => hlt ((order.lessSpec _ _).mpr h)
      obtain ⟨y, hy, hyproj⟩ := order.convertXSpec x
      refine ⟨y, hy, ?_, ?_, fun _ _ => hyproj⟩
      · rw [hyproj]; exact hnot_xlo
      · rw [hyproj]; exact hnot_hix

theorem clampExact_proven : ClampExact := by
  refine ⟨fun X L H O T order x lo hi hlo_hi => clampOrder_spec order x lo hi hlo_hi, ?_⟩
  intro t x lo hi hle
  unfold clampBits clamp
  by_cases hgt : x.val > hi.val
  · rw [if_pos (decide_eq_true hgt)]
    exact ⟨hi, rfl, hle, Int.le_refl _, by omega⟩
  · have hgtf : ¬ (decide (x.val > hi.val) = true) := by simp [hgt]
    rw [if_neg hgtf]
    by_cases hlt : x.val < lo.val
    · rw [if_pos (decide_eq_true hlt)]
      exact ⟨lo, rfl, Int.le_refl _, hle, by omega⟩
    · have hltf : ¬ (decide (x.val < lo.val) = true) := by simp [hlt]
      rw [if_neg hltf]
      exact ⟨x, rfl, by omega, by omega, by omega⟩

theorem clampTypeExact_proven : ClampTypeExact := by
  intro t X val x
  unfold clamp_Type
  have hmin : (JuliaLean.base.int.typemin t).val = t.min := JuliaLean.Proofs.base.int.typemin_val t
  have hmax : (JuliaLean.base.int.typemax t).val = t.max := JuliaLean.Proofs.base.int.typemax_val t
  have hle : t.min ≤ t.max := by cases t <;> decide
  by_cases hgt : val x > (JuliaLean.base.int.typemax t).val
  · rw [if_pos (decide_eq_true hgt)]
    refine ⟨JuliaLean.base.int.typemax t, rfl, ?_, ?_, ?_, ?_⟩
    · rw [hmax]; exact hle
    · rw [hmax]; exact Int.le_refl _
    · rw [hmax] at hgt ⊢; omega
    · intro hf; rw [hmax] at hgt; have := hf.2; omega
  · have hgtf : ¬ (decide (val x > (JuliaLean.base.int.typemax t).val) = true) := by simp [hgt]
    rw [if_neg hgtf]
    by_cases hlt : val x < (JuliaLean.base.int.typemin t).val
    · rw [if_pos (decide_eq_true hlt)]
      refine ⟨JuliaLean.base.int.typemin t, rfl, ?_, ?_, ?_, ?_⟩
      · rw [hmin]; exact Int.le_refl _
      · rw [hmin]; exact hle
      · rw [hmin] at hlt ⊢; omega
      · intro hf; rw [hmin] at hlt; have := hf.1; omega
    · have hltf : ¬ (decide (val x < (JuliaLean.base.int.typemin t).val) = true) := by simp [hlt]
      rw [if_neg hltf]
      have hfit : t.min ≤ val x ∧ val x ≤ t.max := by rw [hmin] at hlt; rw [hmax] at hgt; omega
      have hconv : (fun x => JInt.convert (t.name) t (val x)) x = .ok ⟨val x, hfit⟩ := by
        simp [JInt.convert, hfit]
      rw [hconv]
      refine ⟨⟨val x, hfit⟩, rfl, hfit.1, hfit.2, ?_, fun _ => rfl⟩
      change val x = min t.max (max t.min (val x))
      omega

private theorem clampBang_foldlM {A Axis Index V L H O : Type} [DecidableEq Index]
    (index : JuliaLean.base.arraymath.ArrayIndexOps Id A Axis)
    (getindex : A → Index → Jl V) (setindex : A → Index → V → Jl A)
    (order : ClampOrderOps V L H O V) (lo : L) (hi : H)
    (hlo_hi : ¬ order.lt (order.projectHi hi) (order.projectLo lo))
    (indices : List Index) (hnodup : indices.Nodup) (x : A)
    (hget : ∀ a i, i ∈ indices → ∃ value, getindex a i = .ok value)
    (hset : ∀ a i v, i ∈ indices → ∃ updated, setindex a i v = .ok updated)
    (hframe : ∀ a i v updated, i ∈ indices → setindex a i v = .ok updated →
      index.axes updated = index.axes a ∧
      getindex updated i = .ok v ∧
      ∀ j, j ≠ i → getindex updated j = getindex a j) :
    let clampFn := clamp (fun v hi => order.less (order.projectHi hi) (order.projectX v))
      (fun v lo => order.less (order.projectX v) (order.projectLo lo))
      order.convertX order.convertLo order.convertHi
    ∃ y, indices.foldlM (fun x i => do
      let value ← getindex x i
      setindex x i (← clampFn value lo hi)) x = .ok y ∧
      index.axes y = index.axes x ∧
      (∀ i, i ∈ indices →
        ∃ value clamped, getindex x i = .ok value ∧
          clampFn value lo hi = .ok clamped ∧
          getindex y i = .ok clamped ∧
          ¬ order.lt (order.projectT clamped) (order.projectLo lo) ∧
          ¬ order.lt (order.projectHi hi) (order.projectT clamped)) ∧
      (∀ i, i ∉ indices → getindex y i = getindex x i) := by
  intro clampFn
  induction indices generalizing x with
  | nil =>
    exact ⟨x, rfl, rfl, fun _ h => False.elim (List.not_mem_nil h), fun _ _ => rfl⟩
  | cons idx rest ih =>
    rw [List.nodup_cons] at hnodup
    obtain ⟨hnotmem, hnodup_rest⟩ := hnodup
    have hmem_head : idx ∈ idx :: rest := List.mem_cons_self
    obtain ⟨v0, hv0⟩ := hget x idx hmem_head
    obtain ⟨c0, hc0, hc0_lo, hc0_hi, _⟩ := clampOrder_spec order v0 lo hi hlo_hi
    obtain ⟨x1, hx1⟩ := hset x idx c0 hmem_head
    obtain ⟨haxes1, hget1_eq, hget1_ne⟩ := hframe x idx c0 x1 hmem_head hx1
    obtain ⟨y, hy, haxes_y, hin_y, hout_y⟩ := ih hnodup_rest x1
      (fun a i hi => hget a i (List.mem_cons_of_mem idx hi))
      (fun a i v hi => hset a i v (List.mem_cons_of_mem idx hi))
      (fun a i v u hi => hframe a i v u (List.mem_cons_of_mem idx hi))
    refine ⟨y, ?_, haxes_y.trans haxes1, ?_, ?_⟩
    · dsimp only [clampFn] at hc0 ⊢
      rw [List.foldlM_cons, hv0, ok_bind, hc0, ok_bind, hx1, ok_bind]
      exact hy
    · intro i hi
      rcases List.mem_cons.mp hi with rfl | hrest
      · refine ⟨v0, c0, hv0, hc0, ?_, hc0_lo, hc0_hi⟩
        rw [hout_y i hnotmem, hget1_eq]
      · have hne : i ≠ idx := fun h => hnotmem (h ▸ hrest)
        obtain ⟨vi, ci, hvi, hci, hyi, hlo_i, hhi_i⟩ := hin_y i hrest
        rw [hget1_ne i hne] at hvi
        exact ⟨vi, ci, hvi, hci, hyi, hlo_i, hhi_i⟩
    · intro i hi
      have hne : i ≠ idx := fun h => hi (h ▸ hmem_head)
      have hnotin : i ∉ rest := fun h => hi (List.mem_cons_of_mem idx h)
      rw [hout_y i hnotin, hget1_ne i hne]

theorem clampBangExact_proven : ClampBangExact := by
  intro A Axis Index V L H O _ index eachindex getindex setindex order x lo hi indices
    clampFn hlo_hi heach hnodup hget hset hframe
  unfold clampBang
  rw [heach, ok_bind]
  obtain ⟨y, hy, haxes, hin, hout⟩ :=
    clampBang_foldlM index getindex setindex order lo hi hlo_hi indices hnodup x hget hset hframe
  dsimp only [clampFn] at hy ⊢
  rw [hy]
  exact ⟨y, rfl, haxes, hin, hout⟩

private theorem factorialMath_pos (n : Nat) : 1 ≤ factorialMath n := by
  induction n with
  | zero => decide
  | succ n ih =>
    unfold factorialMath
    exact Nat.le_trans ih (Nat.le_mul_of_pos_left (factorialMath n) (Nat.succ_pos n))

private theorem factorialMath_mono {m n : Nat} (h : m ≤ n) : factorialMath m ≤ factorialMath n := by
  induction n with
  | zero =>
    have hm0 : m = 0 := by omega
    subst hm0
    exact Nat.le_refl _
  | succ n ih =>
    by_cases hmn : m ≤ n
    · rw [factorialMath]
      exact Nat.le_trans (ih hmn) (Nat.le_mul_of_pos_left (factorialMath n) (Nat.succ_pos n))
    · have hmeq : m = n + 1 := by omega
      subst hmeq
      exact Nat.le_refl _

private theorem self_le_factorialMath (n : Nat) : n ≤ factorialMath n := by
  cases n with
  | zero => decide
  | succ n =>
    unfold factorialMath
    have := factorialMath_pos n
    exact Nat.le_mul_of_pos_right _ this

private theorem factorial_foldlM {F : Type} (valF : F → Int) (ofInt : Int → Jl F) (mul : F → F → Jl F)
    (B : Int) (k : Nat) (hk : (factorialMath (k + 1) : Int) ≤ B)
    (hof : ∀ z, 1 ≤ z → z ≤ B → ∃ f, ofInt z = .ok f ∧ valF f = z)
    (hmul : ∀ a b, 1 ≤ valF a → 1 ≤ valF b → valF a * valF b ≤ B →
      ∃ r, mul a b = .ok r ∧ valF r = valF a * valF b)
    (f1 : F) (hf1 : valF f1 = 1) :
    ∃ r, (List.range k).foldlM (fun f (j : Nat) => do
      let i ← ofInt ((j : Int) + 2)
      mul f i) f1 = .ok r ∧ valF r = (factorialMath (k + 1) : Int) := by
  induction k with
  | zero =>
    exact ⟨f1, rfl, hf1⟩
  | succ k ih =>
    have hmono : (factorialMath (k + 1) : Int) ≤ (factorialMath (k + 2) : Int) :=
      Int.ofNat_le.mpr (factorialMath_mono (Nat.le_succ (k + 1)))
    obtain ⟨rk, hrk, hrkval⟩ := ih (Int.le_trans hmono hk)
    have hk2_le : ((k : Int) + 2) ≤ (factorialMath (k + 2) : Int) := by
      have hle := self_le_factorialMath (k + 2)
      omega
    obtain ⟨ik, hik, hikval⟩ := hof ((k : Int) + 2) (by omega) (Int.le_trans hk2_le hk)
    have hstep_eq : ((factorialMath (k + 2) : Nat) : Int) =
        (factorialMath (k + 1) : Int) * ((k : Int) + 2) := by
      change (((k + 2) * factorialMath (k + 1) : Nat) : Int) = _
      rw [Int.natCast_mul, Int.mul_comm]
      rfl
    have hprod_le : valF rk * valF ik ≤ B := by
      rw [hrkval, hikval, ← hstep_eq]
      exact hk
    have hrk_pos : 1 ≤ valF rk := by
      rw [hrkval]
      exact Int.ofNat_le.mpr (factorialMath_pos (k + 1))
    obtain ⟨rnext, hrnext, hrnextval⟩ := hmul rk ik hrk_pos (by omega) hprod_le
    refine ⟨rnext, ?_, ?_⟩
    · rw [List.range_succ, List.foldlM_append, hrk, ok_bind, List.foldlM_cons, hik, ok_bind,
        hrnext, ok_bind, List.foldlM_nil]
      rfl
    · rw [hrnextval, hrkval, hikval, ← hstep_eq]

theorem factorialGenericBig_proven : FactorialGenericBig := by
  intro n
  unfold factorial_Integer factorialLoop
  by_cases hn : n < 0
  · have hn' : id n < 0 := hn
    rw [if_pos hn, if_pos hn']; trivial
  · have hn' : ¬ id n < 0 := hn
    rw [if_neg hn, if_neg hn', pure_bind]
    by_cases hn0 : n = 0
    · subst hn0; rfl
    · have hk : n.toNat = (n - 1).toNat + 1 := by omega
      obtain ⟨r, hr, hrval⟩ := factorial_foldlM id pure (fun x y => pure (x * y))
        (factorialMath ((n - 1).toNat + 1)) (n - 1).toNat (Int.le_refl _)
        (fun z _ _ => ⟨z, rfl, rfl⟩) (fun a b _ _ _ => ⟨a * b, rfl, rfl⟩) 1 rfl
      dsimp only [id] at hr hrval ⊢
      rw [hr, hrval, ← hk]

theorem factorialFallbackNoOverflow_proven : FactorialFallbackNoOverflow := by
  refine ⟨?_, ?_⟩
  · intro t n
    have hmin0 : t.min ≤ 0 := by cases t <;> decide
    have h1fit : t.min ≤ 1 ∧ 1 ≤ t.max := ⟨by cases t <;> decide, by cases t <;> decide⟩
    refine ⟨?_, ?_⟩
    · intro hn
      unfold factorialFallbackBits factorial_Integer
      rw [if_pos hn]; trivial
    · intro hn hfit
      unfold factorialFallbackBits factorial_Integer factorialLoop
      rw [if_neg (by omega)]
      have hconv1 : JInt.convert (t.name) t 1 = .ok ⟨1, h1fit⟩ := by
        simp [JInt.convert, h1fit]
      rw [hconv1]
      dsimp only [Bind.bind, Except.bind]
      by_cases hn0 : n.val = 0
      · have h0 : (n.val - 1).toNat = 0 := by omega
        have h0' : n.val.toNat = 0 := by omega
        rw [h0, h0']
        exact ⟨⟨1, h1fit⟩, rfl, rfl⟩
      · have hk : n.val.toNat = (n.val - 1).toNat + 1 := by omega
        have hkfit : (factorialMath ((n.val - 1).toNat + 1) : Int) ≤ t.max := by
          rw [← hk]; exact hfit.2
        obtain ⟨r, hr, hrval⟩ := factorial_foldlM Subtype.val (JInt.convert (t.name) t)
          (fun x y => pure (JuliaLean.base.int.mul x y)) t.max (n.val - 1).toNat hkfit
          (fun z hz1 hzmax => by
            have hzfit : t.min ≤ z ∧ z ≤ t.max := ⟨by omega, hzmax⟩
            refine ⟨⟨z, hzfit⟩, ?_, rfl⟩
            simp [JInt.convert, hzfit])
          (fun a b ha1 hb1 hab => by
            refine ⟨JuliaLean.base.int.mul a b, rfl, ?_⟩
            rw [JuliaLean.base.int.mul, JuliaLean.Proofs.base.int.mul_int_val]
            have hnonneg : 0 ≤ a.val * b.val := Int.mul_nonneg (by omega) (by omega)
            exact wrapInt_of_inRange t _ ⟨by omega, hab⟩)
          ⟨1, h1fit⟩ rfl
        rw [hk]
        exact ⟨r, hr, hrval⟩
  · intro I F value valF ofInt mul hof hmul n
    unfold factorial_Integer factorialLoop
    by_cases hn : value n < 0
    · rw [if_pos hn, if_pos hn]; trivial
    · rw [if_neg hn, if_neg hn]
      obtain ⟨f1, hf1, hf1val⟩ := hof 1 (by decide)
      rw [hf1]
      dsimp only [Bind.bind, Except.bind]
      by_cases hn0 : value n = 0
      · have h0 : (value n - 1).toNat = 0 := by omega
        have h0' : (value n).toNat = 0 := by omega
        rw [h0, h0']
        exact ⟨f1, rfl, hf1val⟩
      · have hk : (value n).toNat = (value n - 1).toNat + 1 := by omega
        obtain ⟨r, hr, hrval⟩ := factorial_foldlM valF ofInt mul
          (factorialMath ((value n - 1).toNat + 1)) (value n - 1).toNat (Int.le_refl _)
          (fun z hz1 _ => hof z hz1)
          (fun a b _ _ _ => hmul a b) f1 hf1val
        rw [hk]
        exact ⟨r, hr, hrval⟩

private theorem foldlM_const_step {S A B : Type} (step : S → Jl S) :
    ∀ (xs : List A) (ys : List B) (s : S), xs.length = ys.length →
      xs.foldlM (fun s _ => step s) s = ys.foldlM (fun s _ => step s) s
  | [], [], _, _ => rfl
  | _ :: xs, _ :: ys, s, h => by
    simp only [List.length_cons, Nat.succ.injEq] at h
    simp only [List.foldlM_cons]
    cases step s with
    | error _ => rfl
    | ok s' => exact foldlM_const_step step xs ys s' h

private theorem repeatM_succ {S : Type} (n : Nat) (step : S → Jl S) (s : S) :
    JuliaLean.base.intfuncs.repeatM (n + 1) step s = (step s).bind (JuliaLean.base.intfuncs.repeatM n step) := by
  unfold JuliaLean.base.intfuncs.repeatM
  rw [foldlM_const_step step (List.range (n + 1)) (0 :: List.range n) s (by simp)]
  rfl

private theorem repeatM_fixed {S : Type} (step : S → Jl S) (s : S) (h : step s = .ok s) :
    ∀ n : Nat, JuliaLean.base.intfuncs.repeatM n step s = .ok s
  | 0 => rfl
  | n + 1 => by
    rw [repeatM_succ, h]
    exact repeatM_fixed step s h n

private theorem gcd_Real_foldlM {R : Type} (num den : R → Int)
    (promote : R → R → Jl (R × R)) (gcdPair : R → R → Jl R)
    (hprom : ∀ a b, promote a b = .ok (a, b))
    (hgcd : ∀ a b, ∃ r, gcdPair a b = .ok r ∧
      num r = gcdMath (num a) (num b) ∧ den r = lcmMath (den a) (den b))
    (xs : List R) (init : R) (hinit : 0 ≤ num init) :
    ∃ r, xs.foldlM (gcd_Real promote gcdPair) init = .ok r ∧
      num r = ((xs.foldl (fun (g : Nat) x => Nat.gcd g (num x).natAbs) (num init).natAbs : Nat) : Int) := by
  induction xs generalizing init with
  | nil =>
    exact ⟨init, rfl, by simp; omega⟩
  | cons x xs ih =>
    obtain ⟨r1, hr1, hnum1, _⟩ := hgcd init x
    have hstep : gcd_Real promote gcdPair init x = .ok r1 := by
      unfold gcd_Real; rw [hprom init x]; exact hr1
    have hnum1_nonneg : 0 ≤ num r1 := by rw [hnum1]; unfold gcdMath; omega
