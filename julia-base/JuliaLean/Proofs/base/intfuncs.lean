  (∀ (t : IntTy) (n : JInt t) (m : Int), InverseResult n.val m (bigInvmod n.val m))

def InvmodRingUnboundedInput : Prop := ∀ (t : IntTy) (n : Int),
  let call := invmod_Type (fun n => JuliaLean.base.int.lit t n) invmod_Ring n
