Julia source invariants: base/intfuncs.jl:159-160 at
f755f49a9e41380d7da126b3c1db9fe7f83dd027. -/
def PromotionOpenDispatchProvenance : Prop :=
  ∀ (W A B P R : Type) (ops : PromoteApplyOps (JuliaLean.base.io.M W) A B P R)
      (a : A) (b : B) (world : W),
    PromotionObservation .gcd a b world (gcdReal (observePromotionOps ops) a b) ∧
    PromotionObservation .lcm a b world (lcmReal (observePromotionOps ops) a b)

