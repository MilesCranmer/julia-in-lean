        JuliaLean.base.int.lit t.toUnsigned 0 := by
      cases t <;> decide
    by_cases hp0 : p.val = 0
    · simp [powermodBits, h128, powermod_Integer, hp0, numberCallees, bitsOps,
        bitOps, huabs, hwrap0, modMixed_zero, divideError, Bind.bind, Except.bind,
        Pure.pure, Except.pure, JInt.convert, JuliaLean.Proofs.base.int.lit_val]
    · have hpneg : ¬ p.val < 0 := by omega
      simp [powermodBits, h128, powermod_Integer, hp0, hpneg, hp, numberCallees,
        bitsOps, bitOps, huabs, hwrap0, modMixed_zero, divideError, Bind.bind,
