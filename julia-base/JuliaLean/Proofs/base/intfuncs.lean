        intro hzero
        have hwrap : wrapInt b (-base.val) = 0 := by
          simpa only [JuliaLean.base.int.neg, JuliaLean.Proofs.base.int.neg_int_val] using hzero
        have hinverse : wrapInt b (-wrapInt b (-base.val)) = base.val := by
          rw [JuliaLean.Proofs.base.int.wrapInt_neg, Int.neg_neg,
            wrapInt_of_inRange b base.val base.property]
