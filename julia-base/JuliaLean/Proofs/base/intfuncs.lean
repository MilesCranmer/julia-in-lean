inductive FormattingFunction where
  | binary
  | octal
  deriving DecidableEq

inductive FormattingCall where
  | top | maxPad | addBool | addNative | divNative | shift | subNative
  deriving DecidableEq

inductive FormattingLiteral where
  | native (value : JInt64)
  | boolean (value : Bool)
  | byte (value : JInt .u8)

inductive FormattingEvent (V : Type) where
  | value (kind : FormattingCall) (input : V) (literal : Option FormattingLiteral)
      (result : Except JuliaLean.base.io.Error V)
  | ge (value : V) (literal : JInt64) (result : Except JuliaLean.base.io.Error Bool)
  | gt (value : V) (literal : Bool) (result : Except JuliaLean.base.io.Error Bool)
  | low (value : V) (result : Except JuliaLean.base.io.Error (Sum (JInt .u8) V))
  | size (value : V) (result : Except JuliaLean.base.io.Error (JInt .u64))
  | alloc (size : JInt .u64) (result : Except JuliaLean.base.io.Error FormattingString)
  | customString (value : V) (result : Except JuliaLean.base.io.Error (FormattingStringValue V))
  | pointer (value : V) (result : Except JuliaLean.base.io.Error (FormattingPointer V))
  | index (value : V) (result : Except JuliaLean.base.io.Error JInt64)
  | customByteStore (pointer : JuliaLean.base.pointer.Ptr (JInt .u8))
      (value : JInt .u8) (index : V) (result : Except JuliaLean.base.io.Error Unit)
  | store (pointer : V) (value : JInt .u8) (index : Sum JInt64 V)
      (result : Except JuliaLean.base.io.Error Unit)

/-- Observation adapter preserves the common shared byte heap. The existing
recordCall performs each actual leaf once; only the observation log moves
between the two product layouts. -/
def recordFormattingCall {W E A : Type}
    (event : Except JuliaLean.base.io.Error A → E)
    (action : JuliaLean.base.io.M (FormattingWorld W) A) :
    JuliaLean.base.io.M (FormattingWorld (W × List E)) A := fun ((world, trace), heap) =>
  match recordCall event action ((world, heap), trace) with
  | none => none
  | some (.ok (value, ((world, heap), trace))) => some (.ok (value, ((world, trace), heap)))
  | some (.error (error, ((world, heap), trace))) => some (.error (error, ((world, trace), heap)))

def observeFormattingOps {W V : Type} (ops : FormattingOps W V) :
    FormattingOps (W × List (FormattingEvent V)) V where
  topBit := fun x => recordFormattingCall (.value .top x none) (ops.topBit x)
  maxPad := fun pad x => recordFormattingCall (.value .maxPad x (some (.native pad))) (ops.maxPad pad x)
  addBool := fun neg x => recordFormattingCall (.value .addBool x (some (.boolean neg))) (ops.addBool neg x)
  addNative := fun x n => recordFormattingCall (.value .addNative x (some (.native n))) (ops.addNative x n)
  divNative := fun x n => recordFormattingCall (.value .divNative x (some (.native n))) (ops.divNative x n)
  stringRoute := ops.stringRoute
  toCsize := fun x => recordFormattingCall (.size x) (ops.toCsize x)
  allocateString := fun n => recordFormattingCall (.alloc n) (ops.allocateString n)
  customString := fun x => recordFormattingCall (.customString x) (ops.customString x)
  pointerOther := fun x => recordFormattingCall (.pointer x) (ops.pointerOther x)
  greaterEqual := fun x n => recordFormattingCall (.ge x n) (ops.greaterEqual x n)
  greaterBool := fun x neg => recordFormattingCall (.gt x neg) (ops.greaterBool x neg)
  lowByte := fun x => recordFormattingCall (.low x) (ops.lowByte x)
  shiftRight := fun x n => recordFormattingCall (.value .shift x (some (.byte n))) (ops.shiftRight x n)
  subNative := fun x n => recordFormattingCall (.value .subNative x (some (.native n))) (ops.subNative x n)
  toNativeIndex := fun x => recordFormattingCall (.index x) (ops.toNativeIndex x)
  storeByteRoute := ops.storeByteRoute
  customByteStore := fun p x i => recordFormattingCall (.customByteStore p x i) (ops.customByteStore p x i)
  storeOther := fun p x i => recordFormattingCall (.store p x i) (ops.storeOther p x i)

def formattingError {V : Type} : FormattingEvent V → Option JuliaLean.base.io.Error
  | .value _ _ _ (.error e) => some e
  | .ge _ _ (.error e) => some e
  | .gt _ _ (.error e) => some e
  | .low _ (.error e) => some e
  | .size _ (.error e) => some e
  | .alloc _ (.error e) => some e
  | .customString _ (.error e) => some e
  | .pointer _ (.error e) => some e
  | .index _ (.error e) => some e
  | .customByteStore _ _ _ (.error e) => some e
  | .store _ _ _ (.error e) => some e
  | _ => none

def formattingInputs {V : Type} (kind : FormattingCall) (trace : List (FormattingEvent V)) : List V :=
  trace.filterMap fun event => match event with
    | .value name input _ _ => if name = kind then some input else none
    | _ => none

def formattingOutputs {V : Type} (kind : FormattingCall) (trace : List (FormattingEvent V)) : List V :=
  trace.filterMap fun event => match event with
    | .value name _ _ (.ok output) => if name = kind then some output else none
    | _ => none

def formattingLowInputs {V : Type} (trace : List (FormattingEvent V)) : List V :=
  trace.filterMap fun event => match event with | .low input _ => some input | _ => none

def formattingStringOutputs {V : Type} (trace : List (FormattingEvent V)) : List (FormattingStringValue V) :=
  trace.filterMap fun event => match event with
    | .alloc _ (.ok value) => some (.string value)
    | .customString _ (.ok value) => some value
    | _ => none

/-- Independent conservation of digits consumed by each completed shift,
not a second implementation of either loop. Every remainder input is the
original value or an actual previous shift result; at most one remainder
call can be pending without its shift. Width computations and allocation
occur at most once, all sign flags/literals retain their input values, and
only the actual allocation/custom-string result can be returned.
Julia source invariant: base/intfuncs.jl:878-920. -/
def FormattingTraceInvariant {V : Type} (fn : FormattingFunction) (x : V)
    (pad : JInt64) (neg : Bool) (trace : List (FormattingEvent V)) : Prop :=
  let low := formattingLowInputs trace
  let shifted := formattingInputs .shift trace
  formattingInputs .top trace = [x] ∧
  (formattingInputs .maxPad trace).length ≤ 1 ∧
  (formattingInputs .addBool trace).length ≤ 1 ∧
  (formattingStringOutputs trace).length ≤ 1 ∧
  low = (x :: formattingOutputs .shift trace).take low.length ∧
  shifted = low.take shifted.length ∧ shifted.length ≤ low.length ∧
  low.length ≤ shifted.length + 1 ∧
  (∀ value literal result, FormattingEvent.value .maxPad value (some (.native literal)) result ∈ trace → literal = pad) ∧
  (∀ value flag result, FormattingEvent.value .addBool value (some (.boolean flag)) result ∈ trace → flag = neg) ∧
  (∀ value flag result, FormattingEvent.gt value flag result ∈ trace → flag = neg) ∧
  (∀ value literal result, FormattingEvent.ge value literal result ∈ trace → fn = .binary ∧ literal.val = 4) ∧
  (∀ value literal result, FormattingEvent.value .shift value (some (.byte literal)) result ∈ trace →
    match fn with | .binary => literal.val = 4 ∨ literal.val = 1 | .octal => literal.val = 3) ∧
  (∀ value literal result, FormattingEvent.value .addNative value (some (.native literal)) result ∈ trace →
    fn = .octal ∧ literal.val = 2) ∧
  (∀ value literal result, FormattingEvent.value .divNative value (some (.native literal)) result ∈ trace →
    fn = .octal ∧ literal.val = 3)

/-- Original reference identity, completed-loop accounting and first-error
preservation. The only locally generated failures are the explicit UInt8
assertion and absent _string_n/unsafe_store! methods; their observed tag or
actual selector witnesses are required. Julia source: base/intfuncs.jl:878-920. -/
def FormattingTerminal {W V : Type} (ops : FormattingOps W V)
    (trace : List (FormattingEvent V)) :
    Except JuliaLean.base.io.Error (FormattingStringValue V) → Prop
  | .ok value => formattingStringOutputs trace = [value] ∧
      trace.filterMap formattingError = [] ∧
      (formattingLowInputs trace).length = (formattingInputs .shift trace).length
  | .error error =>
      (trace.filterMap formattingError = [error] ∧
        ∃ event, trace.getLast? = some event ∧ formattingError event = some error) ∨
      (trace.filterMap formattingError = [] ∧
        ((error = .foreignError "TypeError" "typeassert UInt8" ∧
          ∃ x other, trace.getLast? = some (.low x (.ok (.inr other)))) ∨
         (error = .jl (.methodError "_string_n") ∧
          ∃ n, formattingOutputs .addBool trace = [n] ∧ ops.stringRoute n = .noMethod) ∨
         (error = .jl (.methodError "unsafe_store!") ∧
          ∃ index, ops.storeByteRoute index = .noMethod)))

/-- Universal dispatch, mutation, type-change, alias and error accounting
for both formatting bodies. V may encode every runtime value, and every
selected operation may throw, mutate the shared heap or diverge. No callee
correctness, termination, native-counter or input-size premise is imposed.
Known UInt8/UInt32 computations and pointer stores remain closed.
Julia source: base/intfuncs.jl:878-920; manual/types.md:154-174. -/
def FormattingOpenAccounting : Prop :=
  ∀ (W V : Type) (ops : FormattingOps W V) (fn : FormattingFunction)
      (x : V) (pad : JInt64) (neg : Bool) (world : FormattingWorld W),
    let observed := match fn with
      | .binary => binUnsigned (observeFormattingOps ops) x pad neg ((world.1, []), world.2)
      | .octal => octUnsigned (observeFormattingOps ops) x pad neg ((world.1, []), world.2)
    match observed with
    | none => True
    | some (.ok (value, ((_, trace), _))) =>
        FormattingTraceInvariant fn x pad neg trace ∧ FormattingTerminal ops trace (.ok value)
    | some (.error (error, ((_, trace), _))) =>
        FormattingTraceInvariant fn x pad neg trace ∧ FormattingTerminal ops trace (.error error)

/-- A successful negative concrete-String result has '-' at the exact
shared-memory address returned by jl_string_ptr, even if arbitrary earlier
custom operations changed its heap. This observable mutation invariant
actually depends on the concrete pointer store, byte codec and both public
bodies, with no allocation, arithmetic or dispatch correctness assumptions.
It is a raw-memory statement and does not assert that every custom allocator
or malformed width makes that address a valid allocation.
Julia source invariant: base/intfuncs.jl:900,917; base/pointer.jl:178. -/
def FormattingNegativeSignAddress : Prop :=
  ∀ (W V : Type) (ops : FormattingOps W V) (fn : FormattingFunction)
      (x : V) (pad : JInt64) (world : FormattingWorld W),
    let observed := match fn with
      | .binary => binUnsigned ops x pad true world
      | .octal => octUnsigned ops x pad true world
    match observed with
    | some (.ok (.string result, (_, heap))) =>
        heap.readByte result.data.address.val.toNat = JuliaLean.base.int.lit .u8 0x2d
    | _ => True

/-- The four byte lanes are independently specified as ASCII bits of the
input nibble, rather than by the multiply/shift/mask trick in the source.
All 256 possible asserted-byte values are included; no high-nibble premise
is imposed. The installed UInt8-to-UInt32 constructor is exercised too.
Julia source invariant: base/intfuncs.jl:886-891. -/
def FormattingBinaryPackedAscii : Prop :=
  ∀ byte : JInt .u8,
    ∃ widened, JuliaLean.base.int.convert .u32 byte = .ok widened ∧
      ∀ lane : Nat, lane < 4 →
        ((formattingBinaryPacked widened).val / (2 ^ (8 * lane) : Int)) % 256 =
          48 + (byte.val / (2 ^ (3 - lane) : Int)) % 2

/-- Narrow memory invariant of the concrete store helper, independent of
its implementation: an already-native byte/index updates the selected byte
and every other address is unchanged. No validity assumption invents a
BoundsError for this unchecked primitive. Both positive and negative native
indices and all pointer addresses are covered, including address wrap.
Julia source: base/pointer.jl:178 and the pointerset primitive. -/
def FormattingNativeStoreFootprint : Prop :=
  ∀ (W V : Type) (ops : FormattingOps W V) (p : JuliaLean.base.pointer.Ptr (JInt .u8))
      (byte : JInt .u8) (index : JInt64) (world : FormattingWorld W),
    ∃ after,
      formattingStore ops (.bytePointer p) byte (.inl index) world = some (.ok ((), (world.1, after))) ∧
      let address := (p.address.val + index.val - 1) % (2 ^ 64 : Int)
      after.readByte address.toNat = byte ∧
      ∀ location : Nat, location < 2 ^ 64 → location ≠ address.toNat →
        after.readByte location = world.2.readByte location

