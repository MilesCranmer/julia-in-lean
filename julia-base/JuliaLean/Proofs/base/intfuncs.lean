/-- The frozen finite-type logarithm law requires an overflowing neighboring power
for a base at its type maximum; hence no callback can satisfy that law. -/
theorem nativeCeilLogLaw_inconsistent (a x : IntTy)
    (log : JInt a → JInt x → Jl Int) : ¬ CeilLogLaw log := by
  intro hlog
  let base : JInt a := JuliaLean.base.int.lit a a.max
  let input : JInt x := JuliaLean.base.int.lit x 2
  have hb : base.val = a.max :=
    JuliaLean.Proofs.base.int.lit_of_fits (by cases a <;> decide)
  have hx : input.val = 2 :=
    JuliaLean.Proofs.base.int.lit_of_fits (by cases x <;> decide)
  have hm : 2 ≤ a.max := by cases a <;> decide
  obtain ⟨n, _, hn, hnear, hfits⟩ := hlog base input 1 (by omega) (by omega)
    (by
      intro j hj
      have hj0 : j = 0 := by omega
      simp only [hj0, Int.pow_zero, hx]
      decide)
    (by simp only [Int.pow_one, hb, hx]; exact hm)
  have hbound := hfits (n + 1) (by simp only [List.mem_cons]; exact Or.inr (Or.inr (Or.inl True.intro)))
  have hn12 : n = 1 ∨ n = 2 := by omega
  rcases hn12 with hn1 | hn2
  · have hbad : a.max < a.max ^ 2 := by cases a <;> decide
    simp only [hn1, hb] at hbound
    change a.max ^ 2 ≤ a.max at hbound
    omega
  · have hbad : a.max < a.max ^ 3 := by cases a <;> decide
    simp only [hn2, hb] at hbound
    change a.max ^ 3 ≤ a.max at hbound
    omega

private theorem nextpow_power_increasing (base : Int) (hbase : 1 < base) (m : Nat) :
    base ^ m < base ^ (m + 1) := by
