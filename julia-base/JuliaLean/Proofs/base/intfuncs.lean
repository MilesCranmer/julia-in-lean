  gcdArrayZeroInputs trace = gcdArrayTypeOutputs trace ∧
  reductions.map (fun call => call.2.2) = gcdArrayZeroOutputs trace ∧
  reductions.map Prod.fst = List.replicate reductions.length .gcd ∧
