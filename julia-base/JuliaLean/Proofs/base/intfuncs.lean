  abs n := wrapperObserve .absolute [.input n] .absolute (ops.abs n)
  unsigned absolute := wrapperObserve .unsigned [.absolute absolute] .magnitude (ops.unsigned absolute)
  lessZero n zero := wrapperObserve .lessZero [.input n,.native zero] .comparison (ops.lessZero n zero)

def SplitSignCausal {W I A U C : Type} (n : I) (before : List (WrapperEvent W (SplitSignAtom I A U C)))
    (event : WrapperEvent W (SplitSignAtom I A U C)) : Prop :=
