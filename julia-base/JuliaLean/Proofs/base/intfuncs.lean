and Newton correction. Covers every native width and value without callee laws. -/
def IsqrtNativeFloor : Prop :=
  ∀ (W : Type) (t : IntTy) (x : JInt t) (world : W),
    if x.val < 0 then
      ∃ message, isqrtNative x world = some (.error (.jl (.domainError message), world))
    else
      ∃ result, isqrtNative x world = some (.ok (result, world)) ∧
        0 ≤ result.val ∧ result.val * result.val ≤ x.val ∧
        x.val < (result.val + 1) * (result.val + 1)

