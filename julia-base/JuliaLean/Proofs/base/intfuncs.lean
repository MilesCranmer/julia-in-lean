theorem polynomial_lt_power (base : Int) (hb : 0 < base) (ds : List Int)
    (hd : ∀ d ∈ ds, d < base) : evalpoly base ds < base ^ ds.length := by
  induction ds with
  | nil => simp only [evalpoly, List.length_nil, Int.pow_zero]; decide
  | cons d ds ih =>
    have hhead := hd d (by simp only [List.mem_cons, true_or])
    have htail := ih (fun x hx => hd x (by simp only [List.mem_cons]; exact Or.inr hx))
    have hm := Int.mul_le_mul_of_nonneg_left
      (show evalpoly base ds ≤ base ^ ds.length - 1 by omega) (Int.le_of_lt hb)
    rw [Int.mul_sub, Int.mul_one] at hm
    simp only [evalpoly, List.length_cons, Int.pow_succ]
    rw [Int.mul_comm (base ^ ds.length) base]
    omega

