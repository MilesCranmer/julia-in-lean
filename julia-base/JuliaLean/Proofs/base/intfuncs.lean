and the gcd of the pair are preserved, and the `typemin ÷ -1` division never occurs. -/
theorem loop_inv {I : Type} (o : IntegerOps I) (M lo A B : Int)
    (hdiv : ∀ x y, o.value y ≠ 0 → (o.value y = -1 → o.value x ≠ lo) →
      ∃ q r, o.divrem x y = .ok (q, r) ∧ o.value r = (o.value x).tmod (o.value y) ∧
        M ∣ o.value x - (o.value q * o.value y + o.value r))
    (hupd : ∀ s0 q s1, M ∣ o.value ((if o.unsigned then gcdxUpdate_Unsigned o.sub o.mul
        else gcdxUpdate o.sub o.mul) s0 q s1) - (o.value s0 - o.value q * o.value s1))
    (hrange : lo ≠ 0 → ∀ x, lo ≤ o.value x ∧ o.value x < -lo) :
    ∀ (n : Nat) (a b s0 s1 t0 t1 : I), (o.value b).natAbs < n →
      (o.value b = -1 → o.value a ≠ lo) → (o.value b = lo → o.value b ≠ 0 → o.value a ≠ -1) →
      M ∣ o.value s0 * A + o.value t0 * B - o.value a →
      M ∣ o.value s1 * A + o.value t1 * B - o.value b →
      ∃ a' s' t', gcdxLoop o n a b s0 s1 t0 t1 = finish o a' s' t' ∧
        (o.value a').natAbs = Nat.gcd (o.value a).natAbs (o.value b).natAbs ∧
        M ∣ o.value s' * A + o.value t' * B - o.value a' := by
  intro n
  induction n with
  | zero => intro a b s0 s1 t0 t1 h; omega
  | succ n ih =>
    intro a b s0 s1 t0 t1 hn h1 h2 hs ht
    by_cases hb : o.value b = 0
    · refine ⟨a, s0, t0, ?_, ?_, hs⟩
      · simp only [gcdxLoop, hb, if_true, finish, Pure.pure, Except.pure]
      · rw [hb]; simp
    · obtain ⟨q, r, hqr, hr, hdq⟩ := hdiv a b hb h1
      have hrlt : (o.value r).natAbs < (o.value b).natAbs := by
        rw [hr, Int.natAbs_tmod]; exact Nat.mod_lt _ (by omega)
      have hloop : gcdxLoop o (n + 1) a b s0 s1 t0 t1 =
          gcdxLoop o n b r s1 ((if o.unsigned then gcdxUpdate_Unsigned o.sub o.mul
            else gcdxUpdate o.sub o.mul) s0 q s1) t1 ((if o.unsigned then gcdxUpdate_Unsigned o.sub o.mul
            else gcdxUpdate o.sub o.mul) t0 q t1) := by
        simp only [gcdxLoop, hb, if_false, hqr, Bind.bind, Except.bind]
      generalize hU : (if o.unsigned then gcdxUpdate_Unsigned o.sub o.mul
        else gcdxUpdate o.sub o.mul) = U at hloop hupd
      have hr1 : o.value r = -1 → o.value b ≠ lo := by
        intro hr1 hblo
        have hlo : lo ≠ 0 := by omega
        have hra := hrange hlo a
        have ha1 := h2 hblo hb
        rcases tmod_self_or_small (o.value a) lo hlo hra.1 hra.2 with h | h <;>
          rw [← hblo] at h <;> omega
      have hr2 : o.value r = lo → o.value r ≠ 0 → o.value b ≠ -1 := by
        intro hrlo hr0 hb1
        have hlo : lo ≠ 0 := by omega
        have hrb := hrange hlo b
        omega
      have hsU := hupd s0 q s1
      have htU := hupd t0 q t1
      have hnew : M ∣ o.value (U s0 q s1) * A + o.value (U t0 q t1) * B - o.value r := by
        have key : o.value (U s0 q s1) * A + o.value (U t0 q t1) * B - o.value r =
            (o.value (U s0 q s1) - (o.value s0 - o.value q * o.value s1)) * A +
            (o.value (U t0 q t1) - (o.value t0 - o.value q * o.value t1)) * B +
            (o.value s0 * A + o.value t0 * B - o.value a) -
            o.value q * (o.value s1 * A + o.value t1 * B - o.value b) +
            (o.value a - (o.value q * o.value b + o.value r)) := by
          simp only [Int.sub_mul, Int.mul_sub, Int.mul_add, Int.add_mul]
          rw [Int.mul_assoc (o.value q) (o.value s1) A, Int.mul_assoc (o.value q) (o.value t1) B]
          omega
        rw [key]
        exact Int.dvd_add (Int.dvd_sub (Int.dvd_add (Int.dvd_add
          (Int.dvd_trans hsU (Int.dvd_mul_right _ A)) (Int.dvd_trans htU (Int.dvd_mul_right _ B))) hs)
          (Int.dvd_trans ht (Int.dvd_mul_left (o.value q) _))) hdq
      obtain ⟨a', s', t', hres, hg, hbez⟩ :=
        ih b r s1 (U s0 q s1) t1 (U t0 q t1) (by omega) hr1 hr2 ht hnew
      refine ⟨a', s', t', hloop.trans hres, ?_, hbez⟩
      rw [hg, hr, Int.natAbs_tmod, Nat.gcd_comm (o.value b).natAbs, ← Nat.gcd_rec, Nat.gcd_comm]

/-! ### Arbitrary-precision instantiation -/

theorem big_loop (A B : Int) (n : Nat) (a b s0 s1 t0 t1 : Int) (hn : b.natAbs < n)
    (hb1 : b ≠ -1) (hs : s0 * A + t0 * B = a) (ht : s1 * A + t1 * B = b) :
    ∃ a' s' t', gcdxLoop bigOps n a b s0 s1 t0 t1 = finish bigOps a' s' t' ∧
      a'.natAbs = Nat.gcd a.natAbs b.natAbs ∧ s' * A + t' * B = a' := by
  obtain ⟨a', s', t', h1, h2, h3⟩ := loop_inv bigOps 0 0 A B
    (by
      intro x y hy _
      refine ⟨x.tdiv y, x.tmod y, ?_, rfl, ?_⟩
      · simp [bigOps, show y ≠ 0 from hy, Pure.pure, Except.pure]
      · have := Int.tdiv_mul_add_tmod x y
        change (0 : Int) ∣ x - (x.tdiv y * y + x.tmod y)
        rw [this]; simp)
    (by
      intro s0 q s1
      change (0 : Int) ∣ (s0 - q * s1) - (s0 - q * s1)
      simp)
    (by intro h; exact absurd rfl h)
    n a b s0 s1 t0 t1 hn (fun h => absurd h hb1) (by intro h h'; exact absurd h h')
    (by change (0 : Int) ∣ s0 * A + t0 * B - a; rw [hs]; simp)
    (by change (0 : Int) ∣ s1 * A + t1 * B - b; rw [ht]; simp)
  refine ⟨a', s', t', h1, h2, ?_⟩
  have := Int.zero_dvd.mp h3
  change s' * A + t' * B - a' = 0 at this
  omega

theorem gcdxBezout_big (a b : Int) :
    ∃ d u v, gcdx_Integer bigOps a b = .ok (d, u, v) ∧
      d = gcdMath a b ∧ a * u + b * v = d ∧
      ((a = 0 ∧ b = 0) → d = 0 ∧ u = 0 ∧ v = 0) := by
  unfold gcdx_Integer
  by_cases h00 : bigOps.value a = 0 ∧ bigOps.value b = 0
  · have ha : a = 0 := h00.1
    have hb : b = 0 := h00.2
    subst ha; subst hb
    exact ⟨0, 0, 0, by simp [h00, bigOps, Pure.pure, Except.pure], by simp [gcdMath], by simp,
      fun _ => ⟨rfl, rfl, rfl⟩⟩
  rw [if_neg h00]
  have hnz : ¬ (a = 0 ∧ b = 0) := h00
  by_cases hb1 : bigOps.value (bigOps.abs b) = 1
  · have hb1' : b.natAbs = 1 := by change ((b.natAbs : Int)) = 1 at hb1; omega
    rw [if_pos hb1]
    refine ⟨1, 0, b, rfl, ?_, ?_, fun h => absurd h hnz⟩
    · simp [gcdMath, hb1']
    · rcases Int.natAbs_eq b with h | h <;> rw [h, hb1'] <;> simp
  rw [if_neg hb1]
  by_cases ha1 : bigOps.value (bigOps.abs a) = 1
  · have ha1' : a.natAbs = 1 := by change ((a.natAbs : Int)) = 1 at ha1; omega
    rw [if_pos ha1]
    refine ⟨1, a, 0, rfl, ?_, ?_, fun h => absurd h hnz⟩
    · simp [gcdMath, ha1']
    · rcases Int.natAbs_eq a with h | h <;> rw [h, ha1'] <;> simp
  rw [if_neg ha1]
  obtain ⟨a', s', t', hres, hg, hbez⟩ := big_loop a b (magnitude bigOps b + 1) a b 1 0 0 1
    (by unfold magnitude; change b.natAbs < b.natAbs + 1; omega)
    (by intro h; apply hb1; change ((b.natAbs : Int)) = 1; rw [h]; rfl) (by simp) (by simp)
  have hofInt : ∀ z : Int, bigOps.ofInt z = z := fun _ => rfl
  rw [hofInt, hofInt, hres]
  unfold finish
  have habs : bigOps.value (bigOps.abs a') = (a'.natAbs : Int) := rfl
  have hva : bigOps.value a' = a' := rfl
  rw [habs, hva]
  have hgm : gcdMath a b = (a'.natAbs : Int) := by unfold gcdMath; rw [hg]
  by_cases hneg : a' < 0
  · rw [if_neg (by omega), if_pos hneg]
    refine ⟨_, _, _, rfl, hgm.symm, ?_, fun h => absurd h hnz⟩
    change a * (-s') + b * (-t') = (a'.natAbs : Int)
    rw [Int.mul_neg, Int.mul_neg, Int.mul_comm a, Int.mul_comm b]
    omega
  · rw [if_neg (by omega), if_neg hneg]
    refine ⟨_, _, _, rfl, by omega, ?_, fun h => absurd h hnz⟩
    rw [Int.mul_comm a, Int.mul_comm b]
    exact hbez


/-! ### Fixed-width instantiation -/

theorem wrap_dvd (t : IntTy) (z : Int) : (2 ^ t.bits : Int) ∣ wrapInt t z - z := by
  have h := JuliaLean.Proofs.base.int.wrapInt_emod_self t z
  have hc : ((2 ^ t.bits : Nat) : Int) = (2 ^ t.bits : Int) := by simp
  rw [hc] at h
  exact Int.dvd_of_emod_eq_zero (Int.emod_eq_emod_iff_emod_sub_eq_zero.mp h)

theorem lit01 (t : IntTy) : (JuliaLean.base.int.lit t 0).val = 0 ∧ (JuliaLean.base.int.lit t 1).val = 1 := by
  cases t <;> decide

theorem fits01 (t : IntTy) : fits t 0 ∧ fits t 1 := by
  cases t <;> decide

theorem min_neg (t : IntTy) (h : t.signed = true) : t.min ≤ -128 ∧ t.max = -t.min - 1 := by
  cases t <;> simp_all [IntTy.min, IntTy.max, IntTy.signed, IntTy.bits]

theorem val_range (t : IntTy) (x : JInt t) : t.min ≤ x.val ∧ x.val ≤ t.max ∧
    (t.signed = false → 0 ≤ x.val) ∧ (t.signed = true → x.val < -t.min) := by
  have hx := x.property
  refine ⟨hx.1, hx.2, ?_, ?_⟩
  · intro h; have : t.min = 0 := by cases t <;> simp_all [IntTy.min, IntTy.signed]
    omega
  · intro h; have := min_neg t h; omega

theorem abs_one_iff (t : IntTy) (x : JInt t) :
    (JuliaLean.base.int.abs x).val = 1 ↔ x.val.natAbs = 1 := by
  rw [JuliaLean.Proofs.base.int.abs_val]
  by_cases h : t.signed = true ∧ x.val = t.min
  · rw [if_pos h]
    have := min_neg t h.1
    constructor
    · intro; omega
    · intro h1; omega
  · rw [if_neg h]; omega

theorem bits_loop (t : IntTy) (A B : Int) (n : Nat) (a b s0 s1 t0 t1 : JInt t)
    (hn : b.val.natAbs < n) (h1 : b.val ≠ -1) (h2 : a.val ≠ -1)
    (hs : (2 ^ t.bits : Int) ∣ s0.val * A + t0.val * B - a.val)
    (ht : (2 ^ t.bits : Int) ∣ s1.val * A + t1.val * B - b.val) :
    ∃ a' s' t', gcdxLoop (bitsOps t) n a b s0 s1 t0 t1 = finish (bitsOps t) a' s' t' ∧
      a'.val.natAbs = Nat.gcd a.val.natAbs b.val.natAbs ∧
      (2 ^ t.bits : Int) ∣ s'.val * A + t'.val * B - a'.val :=
  loop_inv (bitsOps t) (2 ^ t.bits : Int) t.min A B
    (by
      intro x y hy hlo
      have hy' : y.val ≠ 0 := hy
      have hns : ¬ (t.signed = true ∧ x.val = t.min ∧ y.val = -1) :=
        fun h => hlo h.2.2 h.2.1
      refine ⟨JuliaLean.base.int.lit t (x.val.tdiv y.val), JuliaLean.base.int.lit t (x.val.tmod y.val),
        ?_, ?_, ?_⟩
      · change divremBits x y = _
        unfold divremBits
        rw [JuliaLean.Proofs.base.int.divSame_eq, if_neg (by intro h; rcases h with h | h; exact hy' h; exact hns h),
          JuliaLean.Proofs.base.int.remSame_eq, if_neg hy']
        rfl
      · exact JuliaLean.Proofs.base.int.lit_of_fits (JuliaLean.Proofs.base.int.tmod_fits x y)
      · change (2 ^ t.bits : Int) ∣ x.val - ((JuliaLean.base.int.lit t (x.val.tdiv y.val)).val * y.val +
          (JuliaLean.base.int.lit t (x.val.tmod y.val)).val)
        rw [JuliaLean.Proofs.base.int.lit_of_fits (JuliaLean.Proofs.base.int.tmod_fits x y),
          JuliaLean.Proofs.base.int.lit_of_fits (JuliaLean.Proofs.base.int.tdiv_fits x y hy' hns),
          Int.tdiv_mul_add_tmod]
        simp)
    (by
      intro s0 q s1
      have hU : (if (bitsOps t).unsigned then gcdxUpdate_Unsigned (bitsOps t).sub (bitsOps t).mul
          else gcdxUpdate (bitsOps t).sub (bitsOps t).mul) s0 q s1 =
          JuliaLean.base.int.sub s0 (JuliaLean.base.int.mul q s1) := by
        split <;> rfl
      rw [hU]
      change (2 ^ t.bits : Int) ∣ (JuliaLean.base.int.sub_int s0 (JuliaLean.base.int.mul_int q s1)).val -
        (s0.val - q.val * s1.val)
      rw [JuliaLean.Proofs.base.int.sub_int_val, JuliaLean.Proofs.base.int.mul_int_val]
      have e : wrapInt t (s0.val - wrapInt t (q.val * s1.val)) - (s0.val - q.val * s1.val) =
          (wrapInt t (s0.val - wrapInt t (q.val * s1.val)) - (s0.val - wrapInt t (q.val * s1.val))) -
          (wrapInt t (q.val * s1.val) - q.val * s1.val) := by omega
      rw [e]
      exact Int.dvd_sub (wrap_dvd t _) (wrap_dvd t _))
    (by
      intro hlo x
      have hr := val_range t x
      have hsg : t.signed = true := by
        cases h : t.signed
        · exact absurd (by cases t <;> simp_all [IntTy.min, IntTy.signed]) hlo
        · rfl
      exact ⟨hr.1, hr.2.2.2 hsg⟩)
    n a b s0 s1 t0 t1 hn (fun h => absurd h h1) (fun _ _ => h2) hs ht

theorem gcdxBezout_bits (t : IntTy) (a b : JInt t) :
    if fits t (gcdMath a.val b.val) then
      ∃ d u v, gcdxBits a b = .ok (d, u, v) ∧
        d.val = gcdMath a.val b.val ∧
        (a.val * u.val + b.val * v.val - d.val) % (2 ^ t.bits : Int) = 0 ∧
        ((a.val = 0 ∧ b.val = 0) → d.val = 0 ∧ u.val = 0 ∧ v.val = 0)
    else domainError (gcdxBits a b) := by
  have hl := lit01 t
  have hf := fits01 t
  unfold gcdxBits gcdx_Integer
  by_cases h00 : (bitsOps t).value a = 0 ∧ (bitsOps t).value b = 0
  · have ha : a.val = 0 := h00.1
    have hb : b.val = 0 := h00.2
    have hg : gcdMath a.val b.val = 0 := by simp [gcdMath, ha, hb]
    rw [if_pos h00, hg, if_pos hf.1]
    refine ⟨_, _, _, rfl, hl.1, ?_, fun _ => ⟨hl.1, hl.1, hl.1⟩⟩
    change (a.val * (JuliaLean.base.int.lit t 0).val + b.val * (JuliaLean.base.int.lit t 0).val -
      (JuliaLean.base.int.lit t 0).val) % _ = 0
    rw [hl.1]; simp
  rw [if_neg h00]
  have hnz : ¬ (a.val = 0 ∧ b.val = 0) := h00
  by_cases hb1 : (bitsOps t).value ((bitsOps t).abs b) = 1
  · have hb1' : b.val.natAbs = 1 := (abs_one_iff t b).mp hb1
    have hg : gcdMath a.val b.val = 1 := by simp [gcdMath, hb1']
    rw [if_pos hb1, hg, if_pos hf.2]
    refine ⟨_, _, _, rfl, hl.2, ?_, fun h => absurd h hnz⟩
    change (a.val * (JuliaLean.base.int.lit t 0).val + b.val * b.val -
      (JuliaLean.base.int.lit t 1).val) % _ = 0
    rw [hl.1, hl.2]
    rcases Int.natAbs_eq b.val with h | h <;> rw [h, hb1'] <;> simp
  rw [if_neg hb1]
  have hb1n : b.val ≠ -1 := by
    intro h; apply hb1; exact (abs_one_iff t b).mpr (by rw [h]; rfl)
  by_cases ha1 : (bitsOps t).value ((bitsOps t).abs a) = 1
  · have ha1' : a.val.natAbs = 1 := (abs_one_iff t a).mp ha1
    have hg : gcdMath a.val b.val = 1 := by simp [gcdMath, ha1']
    rw [if_pos ha1, hg, if_pos hf.2]
    refine ⟨_, _, _, rfl, hl.2, ?_, fun h => absurd h hnz⟩
    change (a.val * a.val + b.val * (JuliaLean.base.int.lit t 0).val -
      (JuliaLean.base.int.lit t 1).val) % _ = 0
    rw [hl.1, hl.2]
    rcases Int.natAbs_eq a.val with h | h <;> rw [h, ha1'] <;> simp
  rw [if_neg ha1]
  have ha1n : a.val ≠ -1 := by
    intro h; apply ha1; exact (abs_one_iff t a).mpr (by rw [h]; rfl)
  obtain ⟨a', s', t', hres, hg, hbez⟩ := bits_loop t a.val b.val (magnitude (bitsOps t) b + 1) a b
    (JuliaLean.base.int.lit t 1) (JuliaLean.base.int.lit t 0) (JuliaLean.base.int.lit t 0) (JuliaLean.base.int.lit t 1)
    (by unfold magnitude; change b.val.natAbs < b.val.natAbs + 1; omega) hb1n ha1n
    (by rw [hl.1, hl.2]; simp) (by rw [hl.1, hl.2]; simp)
  have hgm : gcdMath a.val b.val = (a'.val.natAbs : Int) := by unfold gcdMath; rw [hg]
  have hr := val_range t a'
  have habs := JuliaLean.Proofs.base.int.abs_val a'
  have hof : ∀ z, (bitsOps t).ofInt z = JuliaLean.base.int.lit t z := fun _ => rfl
  rw [hof, hof, hres, hgm]
  unfold finish
  have hv : ∀ x : JInt t, (bitsOps t).value x = x.val := fun _ => rfl
  have hab : (bitsOps t).abs a' = JuliaLean.base.int.abs a' := rfl
  have hng : ∀ x : JInt t, (bitsOps t).neg x = JuliaLean.base.int.neg x := fun _ => rfl
  simp only [hv, hab, hng]
  by_cases hmin : t.signed = true ∧ a'.val = t.min
  · have hm := min_neg t hmin.1
    rw [if_pos hmin] at habs
    have hnf : ¬ fits t (a'.val.natAbs : Int) := by unfold fits; omega
    rw [if_neg hnf, if_pos ⟨by omega, by omega⟩]
    trivial
  · rw [if_neg hmin] at habs
    have hfit : fits t (a'.val.natAbs : Int) := by
      unfold fits
      by_cases hs : t.signed = true
      · have hm := min_neg t hs
        have : a'.val ≠ t.min := fun h => hmin ⟨hs, h⟩
        omega
      · have : t.signed = false := by simpa using hs
        have := hr.2.2.1 this
        have h0 : t.min = 0 := by cases t <;> simp_all [IntTy.min, IntTy.signed]
        omega
    rw [if_pos hfit, if_neg (by omega)]
    by_cases hneg : a'.val < 0
    · rw [if_pos hneg]
      refine ⟨_, _, _, rfl, habs, ?_, fun h => absurd h hnz⟩
      apply Int.emod_eq_zero_of_dvd
      change (2 ^ t.bits : Int) ∣ a.val * (JuliaLean.base.int.neg_int s').val +
        b.val * (JuliaLean.base.int.neg_int t').val - (JuliaLean.base.int.abs a').val
      rw [JuliaLean.Proofs.base.int.neg_int_val, JuliaLean.Proofs.base.int.neg_int_val, habs]
      have e : a.val * wrapInt t (-s'.val) + b.val * wrapInt t (-t'.val) - (a'.val.natAbs : Int) =
          a.val * (wrapInt t (-s'.val) - -s'.val) + b.val * (wrapInt t (-t'.val) - -t'.val) -
          (s'.val * a.val + t'.val * b.val - a'.val) := by
        have : (a'.val.natAbs : Int) = -a'.val := by omega
        rw [this]; grind
      rw [e]
      exact Int.dvd_sub (Int.dvd_add (Int.dvd_trans (wrap_dvd t _) (Int.dvd_mul_left _ _))
        (Int.dvd_trans (wrap_dvd t _) (Int.dvd_mul_left _ _))) hbez
    · rw [if_neg hneg]
      refine ⟨_, _, _, rfl, by omega, ?_, fun h => absurd h hnz⟩
      apply Int.emod_eq_zero_of_dvd
      have e : a.val * s'.val + b.val * t'.val - a'.val = s'.val * a.val + t'.val * b.val - a'.val := by
        rw [Int.mul_comm a.val, Int.mul_comm b.val]
      rw [e]; exact hbez

theorem gcdxBezout_proven : GcdxBezout := ⟨gcdxBezout_big, gcdxBezout_bits⟩

end opusGcdx

namespace opusRing

theorem wrap_dvd (t : IntTy) (z : Int) : (2 ^ t.bits : Int) ∣ wrapInt t z - z := by
  have h := JuliaLean.Proofs.base.int.wrapInt_emod_self t z
  have hc : ((2 ^ t.bits : Nat) : Int) = (2 ^ t.bits : Int) := by simp
  rw [hc] at h
  exact Int.dvd_of_emod_eq_zero (Int.emod_eq_emod_iff_emod_sub_eq_zero.mp h)

theorem dvd32 (t : IntTy) : (32 : Int) ∣ 2 ^ t.bits := by cases t <;> decide

theorem wrap_mod32 (t : IntTy) (z : Int) : wrapInt t z % 32 = z % 32 :=
  Int.emod_eq_emod_iff_emod_sub_eq_zero.mpr
    (Int.emod_eq_zero_of_dvd (Int.dvd_trans (dvd32 t) (wrap_dvd t z)))

theorem pattern_mod32 {t : IntTy} (x : JInt t) :
    ((JuliaLean.Proofs.base.int.pattern x : Nat) : Int) % 32 = x.val % 32 := by
  unfold JuliaLean.Proofs.base.int.pattern
  have hpos : (0 : Int) < ((2 ^ t.bits : Nat) : Int) := by
    have : 0 < 2 ^ t.bits := Nat.two_pow_pos _
    omega
  rw [Int.toNat_of_nonneg (Int.emod_nonneg _ (by omega))]
  have hc : ((2 ^ t.bits : Nat) : Int) = (2 ^ t.bits : Int) := by simp
  rw [hc]
  exact Int.emod_emod_of_dvd _ (dvd32 t)

theorem xor2_mod32 {u : IntTy} (a : JInt u) :
    JuliaLean.Proofs.base.int.pattern (JuliaLean.base.int.xor_int a (JuliaLean.base.int.lit u 2)) % 32 =
      (JuliaLean.Proofs.base.int.pattern a % 32) ^^^ 2 := by
  have h2 : JuliaLean.Proofs.base.int.pattern (JuliaLean.base.int.lit u 2) = 2 := by cases u <;> decide
  have h5 : u.bits ≥ 5 := by cases u <;> decide
  apply Nat.eq_of_testBit_eq
  intro i
  rw [show (32 : Nat) = 2 ^ 5 from rfl, Nat.testBit_mod_two_pow, Nat.testBit_xor, Nat.testBit_mod_two_pow]
  have hb := JuliaLean.Proofs.base.int.bitOf_bxor a (JuliaLean.base.int.lit u 2) i
  simp only [JuliaLean.Proofs.base.int.bitOf_eq, JuliaLean.base.int.bxor, h2] at hb
  by_cases hi : i < 5
  · simp only [hi, decide_true, Bool.true_and]
    exact hb
  · have : (2 : Nat).testBit i = false := by
      apply Nat.testBit_lt_two_pow
      calc 2 < 2 ^ 5 := by decide
        _ ≤ 2 ^ i := Nat.pow_le_pow_right (by decide) (by omega)
    simp [hi, this]

theorem odd_table : ∀ r : Nat, r < 32 → r % 2 = 1 → (r * ((3 * r % 32) ^^^ 2)) % 32 = 1 := by
  decide

/-- The seed `(3n ⊻ 2) % T` is an inverse of every odd `n` modulo 32. -/
theorem seed_mod32 (t : IntTy) (n : JInt t) (hodd : n.val % 2 ≠ 0) :
    let promoted := IntTy.promote .i64 t
    let xn := JuliaLean.base.int.mul (JuliaLean.base.int.lit promoted 3) (JuliaLean.base.int.remT promoted n)
    let x := JuliaLean.base.int.remT t (JuliaLean.base.int.xor_int xn (JuliaLean.base.int.lit promoted 2))
    (n.val * x.val) % 32 = 1 := by
  intro promoted xn x
  have hx : x.val % 32 = (((JuliaLean.Proofs.base.int.pattern xn % 32) ^^^ 2 : Nat) : Int) := by
    show (JuliaLean.base.int.remT t _).val % 32 = _
    rw [JuliaLean.Proofs.base.int.remT_val, wrap_mod32, ← pattern_mod32, ← xor2_mod32]
    omega
  have hxn : ((JuliaLean.Proofs.base.int.pattern xn : Nat) : Int) % 32 = (3 * n.val) % 32 := by
    rw [pattern_mod32]
    show (JuliaLean.base.int.mul_int _ _).val % 32 = _
    rw [JuliaLean.Proofs.base.int.mul_int_val, wrap_mod32, JuliaLean.Proofs.base.int.lit_val,
      JuliaLean.Proofs.base.int.remT_val, Int.mul_emod, wrap_mod32, wrap_mod32, ← Int.mul_emod]
  generalize hr : (n.val % 32).toNat = r
  have hr32 : r < 32 := by omega
  have hrodd : r % 2 = 1 := by omega
  have hpat : JuliaLean.Proofs.base.int.pattern xn % 32 = 3 * r % 32 := by omega
  rw [hpat] at hx
  have := odd_table r hr32 hrodd
  rw [Int.mul_emod, hx]
  have hn : n.val % 32 = (r : Int) := by omega
  rw [hn]
  omega


def step {t : IntTy} (s : JInt t × JInt t) : JInt t × JInt t :=
  (JuliaLean.base.int.mul s.1 (JuliaLean.base.int.add s.2 (JuliaLean.base.int.lit t 1)),
    JuliaLean.base.int.mul s.2 s.2)

theorem newton_fold (t : IntTy) (n : JInt t) : ∀ (k : Nat) (x y : JInt t) (z : Int),
    (2 ^ t.bits : Int) ∣ n.val * x.val - (1 - y.val) → (2 ^ t.bits : Int) ∣ y.val - z → (32 : Int) ∣ z →
    let r := (List.range k).foldl (fun (s : JInt t × JInt t) _ => step s) (x, y)
    (2 ^ t.bits : Int) ∣ n.val * r.1.val - (1 - r.2.val) ∧
      ∃ z', (2 ^ t.bits : Int) ∣ r.2.val - z' ∧ (32 : Int) ^ (2 ^ k) ∣ z' := by
  intro k
  induction k with
  | zero => intro x y z h1 h2 h3; exact ⟨h1, z, h2, by simpa using h3⟩
  | succ k ih =>
    intro x y z h1 h2 h3
    obtain ⟨hA, z', hB, hC⟩ := ih x y z h1 h2 h3
    simp only [List.range_succ, List.foldl_append, List.foldl_cons, List.foldl_nil]
    generalize (List.range k).foldl (fun (s : JInt t × JInt t) _ => step s) (x, y) = r at hA hB hC
    obtain ⟨X, Y⟩ := r
    simp only at hA hB
    simp only [step]
    have hm : ∀ a b : JInt t, (JuliaLean.base.int.mul a b).val = wrapInt t (a.val * b.val) :=
      fun a b => JuliaLean.Proofs.base.int.mul_int_val a b
    have ha : ∀ a b : JInt t, (JuliaLean.base.int.add a b).val = wrapInt t (a.val + b.val) :=
      fun a b => JuliaLean.Proofs.base.int.add_int_val a b
    rw [hm, ha, hm]
    have hl1 : (JuliaLean.base.int.lit t 1).val = 1 := by cases t <;> decide
    rw [hl1]
    refine ⟨?_, z' * z', ?_, ?_⟩
    · have e : n.val * wrapInt t (X.val * wrapInt t (Y.val + 1)) - (1 - wrapInt t (Y.val * Y.val)) =
          n.val * (wrapInt t (X.val * wrapInt t (Y.val + 1)) - X.val * wrapInt t (Y.val + 1)) +
          n.val * X.val * (wrapInt t (Y.val + 1) - (Y.val + 1)) +
          (n.val * X.val - (1 - Y.val)) * (Y.val + 1) +
          (wrapInt t (Y.val * Y.val) - Y.val * Y.val) := by grind
      rw [e]
      exact Int.dvd_add (Int.dvd_add (Int.dvd_add
        (Int.dvd_trans (wrap_dvd t _) (Int.dvd_mul_left _ _))
        (Int.dvd_trans (wrap_dvd t _) (Int.dvd_mul_left _ _)))
        (Int.dvd_trans hA (Int.dvd_mul_right _ _))) (wrap_dvd t _)
    · have e : wrapInt t (Y.val * Y.val) - z' * z' =
          (wrapInt t (Y.val * Y.val) - Y.val * Y.val) + (Y.val - z') * (Y.val + z') := by grind
      rw [e]
      exact Int.dvd_add (wrap_dvd t _) (Int.dvd_trans hB (Int.dvd_mul_right _ _))
    · rw [Nat.pow_succ, Int.pow_mul, Int.pow_succ, Int.pow_one]
      exact Int.mul_dvd_mul hC hC

theorem iterations_enough (t : IntTy) :
    (2 ^ t.bits : Int) ∣ (32 : Int) ^ (2 ^ (JuliaLean.base.int.cttz_int
      (JuliaLean.base.int.lit .i64 (2 * (t.bits / 8)))).val.toNat) := by
  cases t <;> decide

theorem ring_inverse (t : IntTy) (n : JInt t) :
    if n.val % 2 = 0 then domainError (invmod_Ring n)
    else ∃ y, invmod_Ring n = .ok y ∧ (JuliaLean.base.int.mul n y).val = 1 := by
  by_cases hodd : n.val % 2 = 0
  · rw [if_pos hodd]; unfold invmod_Ring; rw [if_pos hodd]; trivial
  rw [if_neg hodd]
  unfold invmod_Ring
  rw [if_neg hodd]
  refine ⟨_, rfl, ?_⟩
  have hseed := seed_mod32 t n hodd
  simp only at hseed
  generalize hx : JuliaLean.base.int.remT t (JuliaLean.base.int.xor_int
    (JuliaLean.base.int.mul (JuliaLean.base.int.lit (IntTy.promote .i64 t) 3)
      (JuliaLean.base.int.remT (IntTy.promote .i64 t) n))
    (JuliaLean.base.int.lit (IntTy.promote .i64 t) 2)) = x at hseed ⊢
  have hl1 : (JuliaLean.base.int.lit t 1).val = 1 := by cases t <;> decide
  have hy : (JuliaLean.base.int.sub (JuliaLean.base.int.lit t 1) (JuliaLean.base.int.mul n x)).val =
      wrapInt t (1 - wrapInt t (n.val * x.val)) := by
    show (JuliaLean.base.int.sub_int _ (JuliaLean.base.int.mul_int _ _)).val = _
    rw [JuliaLean.Proofs.base.int.sub_int_val, JuliaLean.Proofs.base.int.mul_int_val, hl1]
  obtain ⟨hA, z', hB, hC⟩ := newton_fold t n
    (JuliaLean.base.int.cttz_int (JuliaLean.base.int.lit .i64 (2 * (t.bits / 8)))).val.toNat
    x (JuliaLean.base.int.sub (JuliaLean.base.int.lit t 1) (JuliaLean.base.int.mul n x))
    (1 - n.val * x.val)
    (by
      rw [hy]
      have e : n.val * x.val - (1 - wrapInt t (1 - wrapInt t (n.val * x.val))) =
          (wrapInt t (1 - wrapInt t (n.val * x.val)) - (1 - wrapInt t (n.val * x.val))) -
          (wrapInt t (n.val * x.val) - n.val * x.val) := by omega
      rw [e]; exact Int.dvd_sub (wrap_dvd t _) (wrap_dvd t _))
    (by
      rw [hy]
      have e : wrapInt t (1 - wrapInt t (n.val * x.val)) - (1 - n.val * x.val) =
          (wrapInt t (1 - wrapInt t (n.val * x.val)) - (1 - wrapInt t (n.val * x.val))) -
          (wrapInt t (n.val * x.val) - n.val * x.val) := by omega
      rw [e]; exact Int.dvd_sub (wrap_dvd t _) (wrap_dvd t _))
    (by apply Int.dvd_of_emod_eq_zero; omega)
  have hz : (2 ^ t.bits : Int) ∣ z' := Int.dvd_trans (iterations_enough t) hC
  show (JuliaLean.base.int.mul n ((List.range
      (JuliaLean.base.int.cttz_int (JuliaLean.base.int.lit .i64 (2 * (t.bits / 8)))).val.toNat).foldl
      (fun (s : JInt t × JInt t) _ => step s)
      (x, JuliaLean.base.int.sub (JuliaLean.base.int.lit t 1) (JuliaLean.base.int.mul n x))).1).val = 1
  generalize (List.range
      (JuliaLean.base.int.cttz_int (JuliaLean.base.int.lit .i64 (2 * (t.bits / 8)))).val.toNat).foldl
      (fun (s : JInt t × JInt t) _ => step s)
      (x, JuliaLean.base.int.sub (JuliaLean.base.int.lit t 1) (JuliaLean.base.int.mul n x)) = R at hA hB ⊢
  have hfin : (2 ^ t.bits : Int) ∣ n.val * R.1.val - 1 := by
    have e : n.val * R.1.val - 1 = (n.val * R.1.val - (1 - R.2.val)) - (R.2.val - z') - z' := by omega
    rw [e]; exact Int.dvd_sub (Int.dvd_sub hA hB) hz
  show (JuliaLean.base.int.mul_int n R.1).val = 1
  rw [JuliaLean.Proofs.base.int.mul_int_val]
  have h1w : wrapInt t 1 = 1 := by cases t <;> decide
  have hc : ((2 ^ t.bits : Nat) : Int) = (2 ^ t.bits : Int) := by simp
  have hw := JuliaLean.Proofs.base.int.wrapInt_congr t (a := n.val * R.1.val) (b := 1)
    (by rw [hc]; exact Int.emod_eq_emod_iff_emod_sub_eq_zero.mpr (Int.emod_eq_zero_of_dvd hfin))
  rw [hw, h1w]

theorem ringInverseUnsigned_proven : RingInverseUnsigned := fun t n _ => ring_inverse t n

theorem ringInverseSigned_proven : RingInverseSigned := fun t n _ => ring_inverse t n

theorem invmodRingUnboundedInput_proven : approvedRound3.InvmodRingUnboundedInput := by
  intro t n
  simp only
  have hpar : (JuliaLean.base.int.lit t n).val % 2 = n % 2 := by
    rw [JuliaLean.Proofs.base.int.lit_val]
    have h2 : (2 : Int) ∣ 2 ^ t.bits := by cases t <;> decide
    exact Int.emod_eq_emod_iff_emod_sub_eq_zero.mpr
      (Int.emod_eq_zero_of_dvd (Int.dvd_trans h2 (wrap_dvd t n)))
  have hr := ring_inverse t (JuliaLean.base.int.lit t n)
  unfold invmod_Type
  by_cases h : n % 2 = 0
  · rw [if_pos h]; rw [if_pos (by omega)] at hr; exact hr
  · rw [if_neg h]; rw [if_neg (by omega)] at hr
    obtain ⟨y, hy, h1⟩ := hr
    refine ⟨y, hy, ?_⟩
    have hm : (JuliaLean.base.int.mul (JuliaLean.base.int.lit t n) y).val =
        wrapInt t ((JuliaLean.base.int.lit t n).val * y.val) :=
      JuliaLean.Proofs.base.int.mul_int_val _ _
    rw [hm, JuliaLean.Proofs.base.int.lit_val] at h1
    have e : n * y.val - 1 = (wrapInt t (wrapInt t n * y.val) - 1) -
        (wrapInt t (wrapInt t n * y.val) - wrapInt t n * y.val) - (wrapInt t n - n) * y.val := by
      rw [Int.sub_mul]; omega
    apply Int.emod_eq_zero_of_dvd
    rw [e]
    refine Int.dvd_sub (Int.dvd_sub ?_ (wrap_dvd t _))
      (Int.dvd_trans (wrap_dvd t n) (Int.dvd_mul_right _ _))
    rw [h1]; exact Int.dvd_zero _

end opusRing

namespace opusInvmod

theorem fmod_inverse (n m x v : Int) (hm : m ≠ 0) (hb : n * x + m * v = 1) :
    ModInverse n m (x.fmod m) := by
  refine ⟨hm, ?_, ?_⟩
  · apply Int.emod_eq_zero_of_dvd
    refine ⟨-v - n * x.fdiv m, ?_⟩
    rw [Int.fmod_def]
    have e : n * (x - m * x.fdiv m) - 1 = (n * x + m * v - 1) - m * v - m * (n * x.fdiv m) := by
      rw [Int.mul_sub, Int.mul_left_comm n m]; omega
    rw [e, hb, Int.mul_sub, Int.mul_neg]; omega
  · have hb2 := JuliaLean.Proofs.base.int.fmod_bounds x m hm
    have hlt : (x.fmod m).natAbs < m.natAbs := by
      by_cases hp : 0 < m
      · have := hb2.1 hp; omega
      · have := hb2.2 (by omega); omega
    have h0 : (x.fmod m).natAbs / m.natAbs = 0 := Nat.div_eq_of_lt hlt
    have : ((x.fmod m).tdiv m).natAbs = 0 := by rw [Int.natAbs_tdiv]; exact h0
    omega

theorem bigInvmod_spec (n m : Int) : InverseResult n m (approvedRound3.Concrete.bigInvmod n m) := by
  unfold InverseResult approvedRound3.Concrete.bigInvmod invmod_Integer
  by_cases hm : m = 0
  · rw [if_pos (Or.inl hm)]; simp [hm]; trivial
  obtain ⟨d, u, v, hg, hd, hb, _⟩ := opusGcdx.gcdxBezout_big n m
  simp only [hm, decide_false, Bool.false_eq_true, if_false, if_true, bezoutCoef, hg,
    Bind.bind, Except.bind]
  by_cases h1 : gcdMath n m = 1
  · rw [if_neg (by simp [hm, h1])]
    have hd1 : d = 1 := by omega
    simp only [hd1, decide_true, Bool.not_true, Bool.false_eq_true, if_false, Pure.pure, Except.pure,
      JuliaLean.base.rational.bigIntOps, hm]
    exact ⟨_, rfl, fmod_inverse n m u v hm (by rw [hb, hd1])⟩
  · rw [if_pos (Or.inr h1)]
    have hd1 : ¬ d = 1 := by omega
    simp only [hd1, decide_false, Bool.not_false, if_true]
    trivial

theorem invmodUnbounded_proven : approvedRound3.InvmodUnbounded :=
  ⟨bigInvmod_spec, fun _ n m => bigInvmod_spec n m.val, fun _ n m => bigInvmod_spec n.val m⟩

end opusInvmod

namespace opusMixed

/-- Numeric facts about the promotion type `r` of a signed `S` and an unsigned `U`. -/
def MixedFacts (r S U : IntTy) : Prop :=
  (r.signed = true ↔ S.bits > U.bits) ∧ (r.signed = true → r.min = S.min ∧ r.max = S.max) ∧
  (r.signed = false → r.min = 0 ∧ -S.min ≤ r.max) ∧ U.max ≤ r.max ∧ r.min ≤ 0 ∧ U.min = 0 ∧
  r.toSigned.signed = true ∧ r.toSigned.min ≤ S.min ∧ S.max ≤ r.toSigned.max ∧
  (r.toSigned.min = S.min ↔ S.bits ≥ U.bits) ∧ S.min < 0 ∧ S.max = -S.min - 1 ∧
  wrapInt S (S.min - 1) = S.max ∧ (JuliaLean.base.int.ofBool S true).val = 1 ∧
  (JuliaLean.base.int.ofBool S false).val = 0

theorem mixedFacts_left (s t : IntTy) (hs : s.signed = true) (ht : t.signed = false) :
    MixedFacts (s.promote t) s t := by
  unfold MixedFacts
  cases s <;> cases t <;> simp [IntTy.signed] at hs ht <;> decide

theorem mixedFacts_right (s t : IntTy) (hs : s.signed = false) (ht : t.signed = true) :
    MixedFacts (s.promote t) t s := by
  unfold MixedFacts
  cases s <;> cases t <;> simp [IntTy.signed] at hs ht <;> decide

theorem sameFacts (s t : IntTy) (h : s.signed = t.signed) :
    (s.promote t).min ≤ s.min ∧ s.max ≤ (s.promote t).max ∧
    (s.promote t).min ≤ t.min ∧ t.max ≤ (s.promote t).max := by
  cases s <;> cases t <;> simp [IntTy.signed] at h <;> decide

theorem convert_ok (r : IntTy) {S : IntTy} (x : JInt S) (h : r.min ≤ x.val ∧ x.val ≤ r.max) :
    JuliaLean.base.int.convert r x = .ok ⟨x.val, h⟩ := by
  unfold JuliaLean.base.int.convert JInt.convert
  rw [dif_pos h]

theorem gcdMath_natAbs_left (a a' b : Int) (h : a'.natAbs = a.natAbs) : gcdMath a' b = gcdMath a b := by
  unfold gcdMath; rw [h]

/-- `gcdx(::Signed, ::Unsigned)` with promotion type `r`. -/
theorem signedUnsigned (r S U : IntTy) (hR : MixedFacts r S U) (a : JInt S) (b : JInt U)
    (hmin : S.bits = U.bits → a.val ≠ S.min) (hfit : fits r (gcdMath a.val b.val)) :
    ∃ d u v, gcdx_Signed_Unsigned (promoteMixedTo r) gcdxBits (fun x => decide (x.val < 0)) r.signed
      JuliaLean.base.int.subWrap (JuliaLean.base.int.ofBool S)
      (fun u sign => if sign.val < 0 then JuliaLean.base.int.neg u else u) a b = .ok (d, u, v) ∧
      d.val = gcdMath a.val b.val ∧
      (a.val * u.val + b.val * v.val - d.val) % (2 ^ r.bits : Int) = 0 := by
  obtain ⟨hR1, hR2, hR3, hR4, hR5, hR6, hR7, hR8, hR9, hR10, hR11, hR12, hR13, hR14, hR15⟩ := hR
  have ha := a.property
  have hb := b.property
  have hrem : (JuliaLean.base.int.remT r.toSigned a).val = a.val := by
    rw [JuliaLean.Proofs.base.int.remT_val]
    exact wrapInt_of_inRange _ _ ⟨by omega, by omega⟩
  -- K1: coefficient kept and promoted value equals `a`; K2: coefficient negated, value `-a`.
  by_cases hk : 0 ≤ a.val ∨ (a.val = S.min ∧ r.signed = true)
  · have habs : (JuliaLean.base.int.abs (JuliaLean.base.int.remT r.toSigned a)).val = a.val := by
      rw [JuliaLean.Proofs.base.int.abs_val, hrem]
      rcases hk with hk | hk
      · split <;> omega
      · have := hR10.mpr (by have := hR1.mp hk.2; omega)
        rw [if_pos ⟨hR7, by omega⟩]; omega
    have hfa : r.min ≤ (JuliaLean.base.int.abs (JuliaLean.base.int.remT r.toSigned a)).val ∧
        (JuliaLean.base.int.abs (JuliaLean.base.int.remT r.toSigned a)).val ≤ r.max := by
      rw [habs]
      rcases hk with hk | hk
      · cases hrs : r.signed
        · have := hR3 hrs; omega
        · have := hR2 hrs; omega
      · have := hR2 hk.2; omega
    have hfb : r.min ≤ b.val ∧ b.val ≤ r.max := ⟨by omega, by omega⟩
    have hg' : gcdMath (⟨_, hfa⟩ : JInt r).val (⟨_, hfb⟩ : JInt r).val = gcdMath a.val b.val :=
      gcdMath_natAbs_left _ _ _ (by simp only [habs])
    have hB := opusGcdx.gcdxBezout_bits r ⟨_, hfa⟩ ⟨_, hfb⟩
    rw [hg', if_pos hfit] at hB
    obtain ⟨d, u, v, hres, hd, hbez, _⟩ := hB
    have hsign : ¬ (JuliaLean.base.int.subWrap a (JuliaLean.base.int.ofBool S
        (decide (a.val < 0) && r.signed))).val < 0 := by
      show ¬ (JuliaLean.base.int.sub_int _ _).val < 0
      rw [JuliaLean.Proofs.base.int.sub_int_val]
      rcases hk with hk | hk
      · have : (decide (a.val < 0) && r.signed) = false := by simp; omega
        rw [this, hR15, Int.sub_zero, JuliaLean.Proofs.base.int.wrapInt_val]; omega
      · have : (decide (a.val < 0) && r.signed) = true := by simp [hk.2]; omega
        rw [this, hR14, hk.1, hR13]; omega
    refine ⟨d, u, v, ?_, hd, ?_⟩
    · unfold gcdx_Signed_Unsigned promoteMixedTo promoteMixedSigns
      simp only [convert_ok r _ hfa, convert_ok r _ hfb, Bind.bind, Except.bind, Pure.pure, Except.pure]
      rw [hres]
      simp only [hsign, if_false]
    · rw [habs] at hbez; exact hbez
  · have hneg : a.val < 0 := by omega
    have hne : a.val ≠ r.toSigned.min := by
      intro h
      have h1 : r.toSigned.min = S.min := by omega
      have h2 := hR10.mp h1
      by_cases hgt : S.bits > U.bits
      · exact hk (Or.inr ⟨by omega, hR1.mpr hgt⟩)
      · exact hmin (by omega) (by omega)
    have habs : (JuliaLean.base.int.abs (JuliaLean.base.int.remT r.toSigned a)).val = -a.val := by
      rw [JuliaLean.Proofs.base.int.abs_val, hrem, if_neg (by intro h; exact hne h.2)]; omega
    have hfa : r.min ≤ (JuliaLean.base.int.abs (JuliaLean.base.int.remT r.toSigned a)).val ∧
        (JuliaLean.base.int.abs (JuliaLean.base.int.remT r.toSigned a)).val ≤ r.max := by
      rw [habs]
      cases hrs : r.signed
      · have := hR3 hrs; omega
      · have := hR2 hrs
        have : a.val ≠ S.min := fun h => hk (Or.inr ⟨h, hrs⟩)
        omega
    have hfb : r.min ≤ b.val ∧ b.val ≤ r.max := ⟨by omega, by omega⟩
    have hg' : gcdMath (⟨_, hfa⟩ : JInt r).val (⟨_, hfb⟩ : JInt r).val = gcdMath a.val b.val :=
      gcdMath_natAbs_left _ _ _ (by simp only [habs]; omega)
    have hB := opusGcdx.gcdxBezout_bits r ⟨_, hfa⟩ ⟨_, hfb⟩
    rw [hg', if_pos hfit] at hB
    obtain ⟨d, u, v, hres, hd, hbez, _⟩ := hB
    have hsign : (JuliaLean.base.int.subWrap a (JuliaLean.base.int.ofBool S
        (decide (a.val < 0) && r.signed))).val < 0 := by
      show (JuliaLean.base.int.sub_int _ _).val < 0
      rw [JuliaLean.Proofs.base.int.sub_int_val]
      cases hrs : r.signed
      · have : (decide (a.val < 0) && false) = false := by simp
        rw [this, hR15, Int.sub_zero, JuliaLean.Proofs.base.int.wrapInt_val]; omega
      · have : (decide (a.val < 0) && true) = true := by simp [hneg]
        have hm : a.val ≠ S.min := fun h => hk (Or.inr ⟨h, hrs⟩)
        rw [this, hR14, wrapInt_of_inRange _ _ ⟨by omega, by omega⟩]; omega
    refine ⟨d, JuliaLean.base.int.neg u, v, ?_, hd, ?_⟩
    · unfold gcdx_Signed_Unsigned promoteMixedTo promoteMixedSigns
      simp only [convert_ok r _ hfa, convert_ok r _ hfb, Bind.bind, Except.bind, Pure.pure, Except.pure]
      rw [hres]
      simp only [hsign, if_true]
    · rw [habs] at hbez
      have hbez' := Int.dvd_of_emod_eq_zero hbez
      apply Int.emod_eq_zero_of_dvd
      show (2 ^ r.bits : Int) ∣ a.val * (JuliaLean.base.int.neg_int u).val + b.val * v.val - d.val
      rw [JuliaLean.Proofs.base.int.neg_int_val]
      have e : a.val * wrapInt r (-u.val) + b.val * v.val - d.val =
          a.val * (wrapInt r (-u.val) - -u.val) + (-a.val * u.val + b.val * v.val - d.val) := by
        rw [Int.mul_sub, Int.mul_neg, Int.neg_mul]; omega
      rw [e]
      exact Int.dvd_add (Int.dvd_trans (opusGcdx.wrap_dvd r _) (Int.dvd_mul_left _ _)) hbez'

theorem fixedWidths (s t : IntTy) (a : JInt s) (b : JInt t)
    (h1 : s.signed = true ∧ t.signed = false ∧ s.bits = t.bits → a.val ≠ s.min)
    (h2 : s.signed = false ∧ t.signed = true ∧ s.bits = t.bits → b.val ≠ t.min)
    (hfit : fits (s.promote t) (gcdMath a.val b.val)) : ∃ d u v,
      gcdxMixedBits a b = .ok (d, u, v) ∧ d.val = gcdMath a.val b.val ∧
      (a.val * u.val + b.val * v.val - d.val) % (2 ^ (s.promote t).bits : Int) = 0 := by
  unfold gcdxMixedBits
  cases hs : s.signed <;> cases ht : t.signed
  · -- both unsigned
    simp only [Bool.false_and, Bool.not_false, Bool.true_and, Bool.false_eq_true, if_false]
    have hf := sameFacts s t (by rw [hs, ht])
    have ha := a.property; have hb := b.property
    have hfa : (s.promote t).min ≤ a.val ∧ a.val ≤ (s.promote t).max := ⟨by omega, by omega⟩
    have hfb : (s.promote t).min ≤ b.val ∧ b.val ≤ (s.promote t).max := ⟨by omega, by omega⟩
    have hB := opusGcdx.gcdxBezout_bits (s.promote t) ⟨_, hfa⟩ ⟨_, hfb⟩
    simp only at hB
    rw [if_pos hfit] at hB
    obtain ⟨d, u, v, hres, hd, hbez, _⟩ := hB
    refine ⟨d, u, v, ?_, hd, hbez⟩
    unfold gcdx_Real promoteBits
    simp only [convert_ok _ _ hfa, convert_ok _ _ hfb, Bind.bind, Except.bind, Pure.pure, Except.pure]
    exact hres
  · -- unsigned, signed
    simp only [Bool.false_and, Bool.not_false, Bool.true_and, Bool.not_true, Bool.false_eq_true, if_false,
      if_true]
    obtain ⟨d, v, u, hres, hd, hbez⟩ := signedUnsigned (s.promote t) t s (mixedFacts_right s t hs ht) b a
      (fun hb => h2 ⟨hs, ht, hb.symm⟩) (by rw [show gcdMath b.val a.val = gcdMath a.val b.val by
        unfold gcdMath; rw [Nat.gcd_comm]]; exact hfit)
    refine ⟨d, u, v, ?_, by rw [hd]; unfold gcdMath; rw [Nat.gcd_comm], ?_⟩
    · unfold gcdx_Unsigned_Signed
      rw [hres]; rfl
    · have e : a.val * u.val + b.val * v.val - d.val = b.val * v.val + a.val * u.val - d.val := by omega
      rw [e]; exact hbez
  · -- signed, unsigned
    simp only [Bool.true_and, Bool.not_false, if_true]
    exact signedUnsigned (s.promote t) s t (mixedFacts_left s t hs ht) a b
      (fun hb => h1 ⟨hs, ht, hb⟩) hfit
  · -- both signed
    simp only [Bool.true_and, Bool.not_true, Bool.false_eq_true, if_false, Bool.false_and]
    have hf := sameFacts s t (by rw [hs, ht])
    have ha := a.property; have hb := b.property
    have hfa : (s.promote t).min ≤ a.val ∧ a.val ≤ (s.promote t).max := ⟨by omega, by omega⟩
    have hfb : (s.promote t).min ≤ b.val ∧ b.val ≤ (s.promote t).max := ⟨by omega, by omega⟩
    have hB := opusGcdx.gcdxBezout_bits (s.promote t) ⟨_, hfa⟩ ⟨_, hfb⟩
    simp only at hB
    rw [if_pos hfit] at hB
    obtain ⟨d, u, v, hres, hd, hbez, _⟩ := hB
    refine ⟨d, u, v, ?_, hd, hbez⟩
    unfold gcdx_Real promoteBits
    simp only [convert_ok _ _ hfa, convert_ok _ _ hfb, Bind.bind, Except.bind, Pure.pure, Except.pure]
    exact hres

theorem bigUnsigned (u : IntTy) (a : Int) (b : JInt u) (hu : u.signed = false) :
    let promoteSU := promoteMixedSigns id bigOps.abs (fun x (y : JInt u) => pure (x, y.val))
    let signedUnsigned := gcdx_Signed_Unsigned promoteSU (gcdx_Integer bigOps)
      (fun x => decide (x < 0)) true Int.sub (fun b => if b then 1 else 0)
      (fun x s => if s < 0 then -x else x)
    (∃ d ucoef vcoef, signedUnsigned a b = .ok (d, ucoef, vcoef) ∧
      d = gcdMath a b.val ∧ a * ucoef + b.val * vcoef = d) ∧
    (∃ d ucoef vcoef, gcdx_Unsigned_Signed signedUnsigned b a = .ok (d, ucoef, vcoef) ∧
      d = gcdMath b.val a ∧ b.val * ucoef + a * vcoef = d) := by
  intro promoteSU signedUnsigned
  obtain ⟨d, x, y, hres, hd, hb, _⟩ := opusGcdx.gcdxBezout_big (a.natAbs : Int) b.val
  have hg : gcdMath (a.natAbs : Int) b.val = gcdMath a b.val := by unfold gcdMath; simp
  have hcore : signedUnsigned a b = .ok (d, if a < 0 then -x else x, y) := by
    show (do
      let (a', b') ← promoteSU a b
      let (d, u, v) ← gcdx_Integer bigOps a' b'
      pure (d, (fun x s => if s < 0 then -x else x) u
        (Int.sub a (if (decide (a < 0) && true) then 1 else 0)), v)) = _
    have hp : promoteSU a b = .ok ((a.natAbs : Int), b.val) := rfl
    rw [hp]
    simp only [Bind.bind, Except.bind, hres, Pure.pure, Except.pure]
    have hsub : ∀ z : Int, Int.sub a z = a - z := fun _ => rfl
    by_cases ha : a < 0 <;> simp [ha, hsub] <;> omega
  have hbez : a * (if a < 0 then -x else x) + b.val * y = d := by
    by_cases ha : a < 0
    · rw [if_pos ha]
      have : (a.natAbs : Int) = -a := by omega
      rw [this] at hb; rw [Int.mul_neg, ← Int.neg_mul]; exact hb
    · rw [if_neg ha]
      have : (a.natAbs : Int) = a := by omega
      rw [this] at hb; exact hb
  refine ⟨⟨d, _, y, hcore, by rw [hd, hg], hbez⟩, ⟨d, y, if a < 0 then -x else x, ?_, ?_, ?_⟩⟩
  · unfold gcdx_Unsigned_Signed; rw [hcore]; rfl
  · rw [hd, hg]; unfold gcdMath; rw [Nat.gcd_comm]
  · rw [← hbez]; omega

theorem gcdxMixedBezout_proven : GcdxMixedBezout :=
  ⟨fun s t a b h1 h2 hfit => fixedWidths s t a b h1 h2 hfit, fun u a b hu => bigUnsigned u a b hu⟩

end opusMixed

namespace opusBinGcd

open JuliaLean.Proofs.base.int (pattern pattern_cast pattern_lt bitOf_eq)

theorem testBits_dvd (p F : Nat) (h : ∀ k, k < F → p.testBit k = false) : p % 2 ^ F = 0 := by
  apply Nat.eq_of_testBit_eq
  intro i
  rw [Nat.testBit_mod_two_pow, Nat.zero_testBit]
  by_cases hi : i < F
  · simp [hi, h i hi]
  · simp [hi]

theorem testBit_not_dvd (p F : Nat) (h : p.testBit F = true) : p % 2 ^ (F + 1) ≠ 0 := by
  intro h0
  have := congrArg (fun q => q.testBit F) h0
  simp only [Nat.testBit_mod_two_pow, Nat.zero_testBit] at this
  simp [h] at this

theorem cttz_val {t : IntTy} (x : JInt t) :
    (JuliaLean.base.int.cttz_int x).val =
      (((List.range t.bits).find? (fun i => (pattern x).testBit i)).getD t.bits : Nat) := by
  unfold JuliaLean.base.int.cttz_int JuliaLean.C.jlCttzInt
  rw [← JuliaLean.Proofs.base.int.pattern_fromJInt]
  have hf : (fun i => pattern x / 2 ^ i % 2 == 1) = (fun i => (pattern x).testBit i) := by
    funext i
    rw [Nat.testBit_eq_decide_div_mod_eq]
    cases h : (pattern x / 2 ^ i % 2 == 1) <;> simp_all
  rw [hf, JuliaLean.Proofs.base.int.toJInt_ofNat_val]
  have hle := (JuliaLean.Proofs.base.int.trailing_spec x).1
  generalize ((List.range t.bits).find? (fun i => (pattern x).testBit i)).getD t.bits = n at hle ⊢
  cases t <;> simp only [IntTy.bits] at hle <;> simp [wrapInt, IntTy.signed, IntTy.bits] <;> omega

/-- `trailing_zeros` of a nonzero value: the exact power of two dividing it. -/
theorem cttz_spec {t : IntTy} (x : JInt t) (hx : x.val ≠ 0) :
    (JuliaLean.base.int.cttz_int x).val.toNat < t.bits ∧
    (2 : Int) ^ (JuliaLean.base.int.cttz_int x).val.toNat ∣ x.val ∧
    ¬ (2 : Int) ^ ((JuliaLean.base.int.cttz_int x).val.toNat + 1) ∣ x.val := by
  rw [cttz_val]
  simp only [Int.toNat_natCast]
  have hs := JuliaLean.Proofs.base.int.trailing_spec x
  generalize ((List.range t.bits).find? (fun i => (pattern x).testBit i)).getD t.bits = F at hs ⊢
  obtain ⟨hle, hlow, hbit⟩ := hs
  have hpc := pattern_cast x
  have hc : ((2 ^ t.bits : Nat) : Int) = (2 : Int) ^ t.bits := by simp
  rw [hc] at hpc
  have hxp := x.property
  have hmn : -(2 : Int) ^ t.bits < t.min := by cases t <;> decide
  have hmx : t.max < (2 : Int) ^ t.bits := by cases t <;> decide
  have hM : (0 : Int) < 2 ^ t.bits := Int.pow_pos (by decide)
  have hp0 : pattern x ≠ 0 := by
    intro h0
    rw [h0] at hpc
    by_cases hn : 0 ≤ x.val
    · rw [Int.emod_eq_of_lt hn (by omega)] at hpc; omega
    · have e : x.val % 2 ^ t.bits = (x.val + 2 ^ t.bits * 1) % 2 ^ t.bits := by
        rw [Int.add_mul_emod_self_left]
      rw [e, Int.mul_one, Int.emod_eq_of_lt (by omega) (by omega)] at hpc; omega
  have hF : F < t.bits := by
    rcases Nat.lt_or_eq_of_le hle with h | h
    · exact h
    · exfalso
      apply hp0
      have := testBits_dvd (pattern x) t.bits (fun k hk => by
        have := hlow k (by omega); rwa [bitOf_eq] at this)
      rwa [Nat.mod_eq_of_lt (pattern_lt x)] at this
  have hdvdP : ∀ G, G ≤ t.bits → ((2 : Int) ^ G ∣ x.val ↔ pattern x % 2 ^ G = 0) := by
    intro G hG
    have hG1 : (2 : Int) ^ G ∣ 2 ^ t.bits := ⟨2 ^ (t.bits - G), by rw [← Int.pow_add]; congr 1; omega⟩
    have e1 : x.val % 2 ^ G = ((pattern x % 2 ^ G : Nat) : Int) := by
      rw [← Int.emod_emod_of_dvd x.val hG1, ← hpc]
      simp
    constructor
    · intro h
      have := Int.emod_eq_zero_of_dvd h
      rw [e1] at this; omega
    · intro h
      apply Int.dvd_of_emod_eq_zero
      rw [e1, h]; rfl
  refine ⟨hF, (hdvdP F (by omega)).mpr (testBits_dvd _ _ (fun k hk => by
      have := hlow k hk; rwa [bitOf_eq] at this)), ?_⟩
  rw [hdvdP (F + 1) (by omega)]
  apply testBit_not_dvd
  have := hbit hF; rwa [bitOf_eq] at this

theorem lit_i64_nat (n : Nat) (h : n ≤ 128) : (JuliaLean.base.int.lit .i64 (n : Int)).val = (n : Int) :=
  wrapInt_of_inRange .i64 (n : Int) ⟨by simp [IntTy.min, IntTy.signed, IntTy.bits] <;> omega,
    by simp [IntTy.max, IntTy.signed, IntTy.bits] <;> omega⟩

theorem shr_val {t : IntTy} (a : JInt t) (n : Nat) (h : n ≤ 128) :
    (JuliaLean.base.int.shr_Int a (JuliaLean.base.int.lit .i64 (n : Int))).val = a.val / (2 : Int) ^ n := by
  have hsh := (JuliaLean.Proofs.base.int.shiftIntCount_proven t a (JuliaLean.base.int.lit .i64 (n : Int))).1
  rw [lit_i64_nat n h] at hsh
  rw [hsh, if_pos (Int.natCast_nonneg n), Int.toNat_natCast]

theorem minBits_val {t : IntTy} (a b : JInt t) : (minBits a b).val = min a.val b.val := by
  unfold minBits JuliaLean.base.operators.min
  rw [JuliaLean.Proofs.base.int.ltSame_eq]
  by_cases h : b.val < a.val
  · simp only [h, decide_true, JuliaLean.base.int.ifelse, ↓reduceIte]; omega
  · simp only [h, decide_false, JuliaLean.base.int.ifelse, Bool.false_eq_true, ↓reduceIte]; omega

theorem signed_min (t : IntTy) (h : t.signed = true) : t.min = -t.max - 1 := by
  revert h; cases t <;> decide

theorem bits_le_128 (t : IntTy) : t.bits ≤ 128 := by cases t <;> decide

theorem coprime_pow_odd (z B : Nat) (hB : B % 2 = 1) : (2 ^ z).Coprime B := by
  have h2 : B.Coprime 2 := by
    show Nat.gcd B 2 = 1
    rw [Nat.gcd_comm, Nat.gcd_rec, hB]; rfl
  exact (h2.pow_right z).symm

/-- One `while a != 0` iteration preserves `gcd(a, b)` (with `b` odd) and decreases `a + b`. -/
theorem loop_spec (t : IntTy) : ∀ (n : Nat) (a b : JInt t) (za : Nat), 0 ≤ a.val → 0 < b.val →
    b.val % 2 = 1 → (a.val ≠ 0 → za ≤ 128 ∧ (2 : Int) ^ za ∣ a.val ∧ ¬ (2 : Int) ^ (za + 1) ∣ a.val) →
    a.val + b.val < n →
    (binaryGcdLoop n a b za).val = (Nat.gcd a.val.natAbs b.val.natAbs : Int) := by
  intro n
  induction n with
  | zero => intro a b za _ _ _ _ h; omega
  | succ n ih =>
    intro a b za ha hb hbo hz hn
    by_cases ha0 : a.val = 0
    · simp only [binaryGcdLoop, ha0, if_true]
      simp; omega
    obtain ⟨hz128, hdvd, hndvd⟩ := hz ha0
    have hax := a.property
    have hbx := b.property
    have hpz : (0 : Int) < 2 ^ za := Int.pow_pos (by decide)
    -- a1 = a >> za is the odd part of a
    have ha1v := shr_val a za hz128
    generalize ha1 : JuliaLean.base.int.shr_Int a (JuliaLean.base.int.lit .i64 (za : Int)) = a1 at ha1v
    have hdec : a.val = 2 ^ za * a1.val := by
      rw [ha1v]; exact (Int.mul_ediv_cancel' hdvd).symm
    have ha1pos : 0 < a1.val := by
      rcases Int.lt_trichotomy a1.val 0 with h | h | h
      · have := Int.mul_lt_mul_of_pos_left h hpz; simp at this; omega
      · rw [h] at hdec; simp at hdec; omega
      · exact h
    have ha1odd : a1.val % 2 = 1 := by
      have : ¬ (2 : Int) ∣ a1.val := by
        intro ⟨c, hc⟩
        apply hndvd
        exact ⟨c, by rw [hdec, hc, Int.pow_succ, Int.mul_assoc]⟩
      omega
    have ha1le : a1.val ≤ a.val := by
      rw [hdec]
      have : 1 ≤ (2 : Int) ^ za := hpz
      have := Int.mul_le_mul_of_nonneg_right this (Int.le_of_lt ha1pos)
      simpa using this
    -- the absolute difference and its signed/unsigned witness
    obtain ⟨absd, d, hpair, habs, hdabs⟩ : ∃ absd d : JInt t,
        (if t.signed then absdiff_Signed JuliaLean.base.int.sub JuliaLean.base.int.abs a1 b
          else absdiff_Unsigned maxBits minBits JuliaLean.base.int.sub a1 b) = (absd, d) ∧
        absd.val = ((a1.val - b.val).natAbs : Int) ∧ (d.val.natAbs : Int) = ((a1.val - b.val).natAbs : Int) := by
      cases hs : t.signed
      · have h := absDifferenceExact_proven.1 t a1 b hs
        refine ⟨(absdiff_Unsigned maxBits minBits JuliaLean.base.int.sub a1 b).1,
          (absdiff_Unsigned maxBits minBits JuliaLean.base.int.sub a1 b).2, ?_, h.1, by rw [h.2]; omega⟩
        simp only [Bool.false_eq_true, ↓reduceIte]
      · have hsm : t.min = -t.max - 1 := signed_min t hs
        have hfit1 : t.min ≤ a1.val - b.val ∧ a1.val - b.val ≤ t.max := by
          have := a1.property; constructor <;> omega
        have hfit2 : t.min ≤ ((a1.val - b.val).natAbs : Int) ∧ ((a1.val - b.val).natAbs : Int) ≤ t.max := by
          have := a1.property; constructor <;> omega
        have h := absDifferenceExact_proven.2.1 t a1 b hs hfit1 hfit2
        refine ⟨(absdiff_Signed JuliaLean.base.int.sub JuliaLean.base.int.abs a1 b).1,
          (absdiff_Signed JuliaLean.base.int.sub JuliaLean.base.int.abs a1 b).2, ?_, h.1, by rw [h.2]⟩
        simp only [↓reduceIte]
    have hstep : binaryGcdLoop (n + 1) a b za =
        binaryGcdLoop n absd (minBits a1 b) (JuliaLean.base.int.cttz_int d).val.toNat := by
      simp only [binaryGcdLoop, ha0, if_false]
      rw [ha1, hpair]
    rw [hstep]
    have hmin := minBits_val a1 b
    have hfin := ih absd (minBits a1 b) (JuliaLean.base.int.cttz_int d).val.toNat
      (by rw [habs]; omega) (by rw [hmin]; omega) (by rw [hmin]; omega)
      (by
        intro habs0
        have hd0 : d.val ≠ 0 := by intro h; rw [h] at hdabs; rw [habs] at habs0; omega
        obtain ⟨h1, h2, h3⟩ := cttz_spec d hd0
        have hbits := bits_le_128 t
        refine ⟨by omega, ?_, ?_⟩
        · rw [habs, ← hdabs]; exact Int.dvd_natAbs.mpr h2
        · rw [habs, ← hdabs]; intro h; exact h3 (Int.dvd_natAbs.mp h))
      (by rw [habs, hmin]; omega)
    rw [hfin]
    apply congrArg (fun n : Nat => (n : Int))
    rw [habs, hmin, Int.natAbs_natCast]
    have hA : a.val.natAbs = 2 ^ za * a1.val.natAbs := by
      rw [hdec, Int.natAbs_mul, Int.natAbs_pow]; rfl
    have hBodd : b.val.natAbs % 2 = 1 := by omega
    rw [hA, Nat.gcd_comm (2 ^ za * a1.val.natAbs), (coprime_pow_odd za _ hBodd).gcd_mul_left_cancel_right,
      Nat.gcd_comm]
    by_cases hle : a1.val ≤ b.val
    · have e1 : (a1.val - b.val).natAbs = b.val.natAbs - a1.val.natAbs := by omega
      have e2 : (min a1.val b.val).natAbs = a1.val.natAbs := by rw [Int.min_eq_left hle]
      rw [e1, e2, Nat.gcd_sub_self_right (by omega)]
      first | rfl | exact Nat.gcd_comm _ _
    · have e1 : (a1.val - b.val).natAbs = a1.val.natAbs - b.val.natAbs := by omega
      have e2 : (min a1.val b.val).natAbs = b.val.natAbs := by rw [Int.min_eq_right (by omega)]
      rw [e1, e2, Nat.gcd_sub_self_right (by omega)]

theorem odd_part (x : Int) (z : Nat) (h1 : (2 : Int) ^ z ∣ x) (h2 : ¬ (2 : Int) ^ (z + 1) ∣ x) :
    x.natAbs = 2 ^ z * (x / 2 ^ z).natAbs ∧ (x / 2 ^ z).natAbs % 2 = 1 ∧ x = 2 ^ z * (x / 2 ^ z) := by
  have hx : x = 2 ^ z * (x / 2 ^ z) := (Int.mul_ediv_cancel' h1).symm
  refine ⟨?_, ?_, hx⟩
  · conv => lhs; rw [hx]
    rw [Int.natAbs_mul, Int.natAbs_pow]; rfl
  · have : ¬ (2 : Int) ∣ x / 2 ^ z := by
      intro ⟨c, hc⟩
      apply h2
      exact ⟨c, by rw [hx, hc, Int.pow_succ, Int.mul_assoc]⟩
    omega

theorem gcd_pow_split (za zb A B : Nat) (hA : A % 2 = 1) (hB : B % 2 = 1) :
    Nat.gcd (2 ^ za * A) (2 ^ zb * B) = 2 ^ (min za zb) * Nat.gcd A B := by
  have e1 : 2 ^ za * A = 2 ^ (min za zb) * (2 ^ (za - min za zb) * A) := by
    rw [← Nat.mul_assoc, ← Nat.pow_add]; congr 2; omega
  have e2 : 2 ^ zb * B = 2 ^ (min za zb) * (2 ^ (zb - min za zb) * B) := by
    rw [← Nat.mul_assoc, ← Nat.pow_add]; congr 2; omega
  rw [e1, e2, Nat.gcd_mul_left]
  congr 1
  by_cases h : za ≤ zb
  · rw [show za - min za zb = 0 by omega, Nat.pow_zero, Nat.one_mul,
      (coprime_pow_odd _ A hA).gcd_mul_left_cancel_right]
  · rw [show zb - min za zb = 0 by omega, Nat.pow_zero, Nat.one_mul, Nat.gcd_comm,
      (coprime_pow_odd _ B hB).gcd_mul_left_cancel_right, Nat.gcd_comm]

theorem min_even (t : IntTy) (h : t.signed = true) : t.min % 2 = 0 := by
  revert h; cases t <;> decide

theorem binaryGcd_spec (t : IntTy) (ain bin : JInt t) (hb0 : bin.val ≠ 0)
    (hmin : t.signed = true → ain.val ≠ t.min) (ha0 : ain.val ≠ 0) :
    (binaryGcd ain bin hb0 hmin).val = gcdMath ain.val bin.val ∧
      fits t (gcdMath ain.val bin.val) := by
  have hax := ain.property
  have hbx := bin.property
  have h128 := bits_le_128 t
  obtain ⟨za128, zadvd, zandvd⟩ := cttz_spec ain ha0
  obtain ⟨zb128, zbdvd, zbndvd⟩ := cttz_spec bin hb0
  generalize hza : (JuliaLean.base.int.cttz_int ain).val.toNat = za at za128 zadvd zandvd
  generalize hzb : (JuliaLean.base.int.cttz_int bin).val.toNat = zb at zb128 zbdvd zbndvd
  obtain ⟨hAabs, hAodd, _⟩ := odd_part ain.val za zadvd zandvd
  obtain ⟨hBabs, hBodd, hBdec⟩ := odd_part bin.val zb zbdvd zbndvd
  -- a = abs(ain)
  have haval : (JuliaLean.base.int.abs ain).val = (ain.val.natAbs : Int) := by
    rw [JuliaLean.Proofs.base.int.abs_val, if_neg (fun h => hmin h.1 h.2)]
  -- b = abs(bin >> zb), the odd part of bin
  have hshr := shr_val bin zb (by omega)
  generalize hb0' : JuliaLean.base.int.shr_Int bin (JuliaLean.base.int.lit .i64 (zb : Int)) = b0 at hshr
  have hbval : (JuliaLean.base.int.abs b0).val = ((bin.val / 2 ^ zb).natAbs : Int) := by
    rw [JuliaLean.Proofs.base.int.abs_val, hshr]
    rw [if_neg]
    intro h
    have := min_even t h.1
    have : (bin.val / 2 ^ zb) % 2 = 0 := by rw [h.2]; exact this
    omega
  have hloop := loop_spec t (ain.val.natAbs + bin.val.natAbs + 1) (JuliaLean.base.int.abs ain)
    (JuliaLean.base.int.abs b0) za (by rw [haval]; omega) (by rw [hbval]; omega)
    (by rw [hbval]; omega)
    (by
      intro _
      refine ⟨by omega, ?_, ?_⟩
      · rw [haval]; exact Int.dvd_natAbs.mpr zadvd
      · rw [haval]; intro h; exact zandvd (Int.dvd_natAbs.mp h))
    (by
      rw [haval, hbval]
      have : (bin.val / 2 ^ zb).natAbs ≤ bin.val.natAbs := by
        rw [hBabs]; exact Nat.le_mul_of_pos_left _ (Nat.two_pow_pos _)
      push_cast; omega)
  rw [haval, hbval] at hloop
  simp only [Int.natAbs_natCast] at hloop
  have hG : gcdMath ain.val bin.val =
      (Nat.gcd ain.val.natAbs (bin.val / 2 ^ zb).natAbs : Int) * 2 ^ (min za zb) := by
    unfold gcdMath
    rw [hAabs, hBabs, gcd_pow_split za zb _ _ hAodd hBodd, Nat.gcd_comm (2 ^ za * _),
      (coprime_pow_odd za _ hBodd).gcd_mul_left_cancel_right, Nat.gcd_comm]
    push_cast
    rw [Int.mul_comm]
  have hfit : fits t (gcdMath ain.val bin.val) := by
    have hle : Nat.gcd ain.val.natAbs bin.val.natAbs ≤ ain.val.natAbs := Nat.gcd_le_left _ (by omega)
    unfold fits gcdMath
    have hm0 : t.min ≤ 0 := by cases t <;> decide
    by_cases hs : t.signed = true
    · have := hmin hs
      have := signed_min t hs
      constructor <;> omega
    · have h0 : t.min = 0 := by revert hs; cases t <;> decide
      constructor <;> omega
  refine ⟨?_, hfit⟩
  unfold binaryGcd
  simp only
  rw [hza, hzb, hb0']
  generalize binaryGcdLoop (ain.val.natAbs + bin.val.natAbs + 1) (JuliaLean.base.int.abs ain)
    (JuliaLean.base.int.abs b0) za = L at hloop
  rw [JuliaLean.Proofs.base.int.remT_val, JuliaLean.Proofs.base.int.shl_int_val,
    JuliaLean.Proofs.base.int.pattern_of_nonneg _ (by rw [lit_i64_nat _ (by omega)]; omega),
    lit_i64_nat _ (by omega), Int.toNat_natCast, hloop, ← hG]
  rw [JuliaLean.Proofs.base.int.wrapInt_wrapInt]
  exact wrapInt_of_inRange t _ hfit

theorem binaryGcdExactOnDomain_proven : BinaryGcdExactOnDomain := by
  intro t a b nonzero firstNotMin ha0
  exact (binaryGcd_spec t a b nonzero firstNotMin ha0).1

theorem eo_conv {t : IntTy} (r : Jl (JInt t)) (n : Int)
    (h : JuliaLean.Proofs.base.checked.ExactOrOverflow r n) : ExactOrOverflow r n := by
  unfold JuliaLean.Proofs.base.checked.ExactOrOverflow at h
  unfold ExactOrOverflow
  by_cases hf : fits t n
  · rw [if_pos hf]; rw [if_pos (show t.min ≤ n ∧ n ≤ t.max from hf)] at h; exact h
  · rw [if_neg hf]; rw [if_neg (show ¬ (t.min ≤ n ∧ n ≤ t.max) from hf)] at h
    revert h
    cases r with
    | ok z => intro h; exact h
    | error e =>
        cases e <;> intro h <;>
          simpa [overflowError, JuliaLean.Proofs.base.checked.Overflowed] using h

theorem checkedAbs_eo (t : IntTy) (x : JInt t) :
    ExactOrOverflow (JuliaLean.base.checked.checkedAbsBits x) (x.val.natAbs : Int) := by
  have h := JuliaLean.Proofs.base.checked.absExact t x
  rw [show (if x.val < 0 then -x.val else x.val) = (x.val.natAbs : Int) by split <;> omega] at h
  exact eo_conv _ _ h

theorem gcdExact_proven : GcdExact := by
  intro t a b
  have hax := a.property
  have hbx := b.property
  unfold gcd_BitInteger
  by_cases ha : a.val = 0
  · rw [dif_pos ha]
    have : gcdMath a.val b.val = (b.val.natAbs : Int) := by simp [gcdMath, ha]
    rw [this]; exact checkedAbs_eo t b
  rw [dif_neg ha]
  by_cases hb : b.val = 0
  · rw [dif_pos hb]
    have : gcdMath a.val b.val = (a.val.natAbs : Int) := by simp [gcdMath, hb]
    rw [this]; exact checkedAbs_eo t a
  rw [dif_neg hb]
  by_cases hm : t.signed = true ∧ a.val = t.min
  · rw [dif_pos hm]
    by_cases he : a.val = b.val
    · rw [dif_pos he]
      have hnf : ¬ fits t (gcdMath a.val b.val) := by
        unfold fits gcdMath
        rw [← he, Nat.gcd_self, hm.2]
        have := signed_min t hm.1
        have : t.min < 0 := by have h := hm.1; revert h; cases t <;> decide
        omega
      unfold ExactOrOverflow; rw [if_neg hnf]; trivial
    · rw [dif_neg he]
      have hbm : t.signed = true → b.val ≠ t.min := fun _ h => he (hm.2.trans h.symm)
      obtain ⟨hv, hf⟩ := binaryGcd_spec t b a ha hbm hb
      have hcomm : gcdMath b.val a.val = gcdMath a.val b.val := by unfold gcdMath; rw [Nat.gcd_comm]
      rw [hcomm] at hv hf
      unfold ExactOrOverflow; rw [if_pos hf]
      exact ⟨_, rfl, hv⟩
  · rw [dif_neg hm]
    obtain ⟨hv, hf⟩ := binaryGcd_spec t a b hb (fun hs h => hm ⟨hs, h⟩) ha
    unfold ExactOrOverflow; rw [if_pos hf]
    exact ⟨_, rfl, hv⟩

theorem lcmExact_proven : LcmExact := by
  intro t a b
  have hax := a.property
  have hbx := b.property
  have hm0 : t.min ≤ 0 := by cases t <;> decide
  have hmx0 : 0 < t.max := by cases t <;> decide
  have hsmin : t.signed = true → t.min = -t.max - 1 := signed_min t
  have humin : t.signed = false → t.min = 0 := by intro h; revert h; cases t <;> decide
  unfold lcmBits lcm_Integer
  by_cases h0 : (bitsOps t).value a = 0 ∨ (bitsOps t).value b = 0
  · rw [if_pos h0]
    have hl : lcmMath a.val b.val = 0 := by
      have h0' : a.val = 0 ∨ b.val = 0 := h0
      unfold lcmMath
      rcases h0' with h | h <;> simp [h]
    rw [hl]
    unfold ExactOrOverflow
    rw [if_pos (by unfold fits; omega)]
    exact ⟨_, rfl, by show (JuliaLean.base.int.lit t 0).val = 0; cases t <;> decide⟩
  rw [if_neg h0]
  have ha : a.val ≠ 0 := fun h => h0 (Or.inl h)
  have hb : b.val ≠ 0 := fun h => h0 (Or.inr h)
  have hg := gcdExact_proven t b a
  have hGa : Nat.gcd b.val.natAbs a.val.natAbs ≤ a.val.natAbs := Nat.gcd_le_right _ (by omega)
  have hGb : Nat.gcd b.val.natAbs a.val.natAbs ≤ b.val.natAbs := Nat.gcd_le_left _ (by omega)
  have hGpos : 0 < Nat.gcd b.val.natAbs a.val.natAbs := Nat.gcd_pos_of_pos_left _ (by omega)
  unfold ExactOrOverflow at hg ⊢
  by_cases hgf : fits t (gcdMath b.val a.val)
  · rw [if_pos hgf] at hg
    obtain ⟨d, hd, hdv⟩ := hg
    unfold gcdMath at hdv
    generalize hG : Nat.gcd b.val.natAbs a.val.natAbs = G at hdv hGa hGb hGpos
    have hGdvd_b : (G : Int) ∣ b.val := by
      rw [← hG]; exact Int.natAbs_dvd_natAbs.mp (by simpa using Nat.gcd_dvd_left _ _)
    have hdiv : (bitsOps t).div b d = .ok (JuliaLean.base.int.lit t (b.val.tdiv G)) := by
      show JuliaLean.base.int.divSame b d = _
      rw [JuliaLean.Proofs.base.int.divSame_eq, if_neg (by rw [hdv]; omega), hdv]
    have hqv : (JuliaLean.base.int.lit t (b.val.tdiv G)).val = b.val.tdiv G := by
      apply JuliaLean.Proofs.base.int.lit_of_fits
      apply JuliaLean.Proofs.base.int.tdiv_fits b d (by rw [hdv]; omega) (by rw [hdv]; omega) |> fun h => by
        rw [hdv] at h; exact h
    generalize JuliaLean.base.int.lit t (b.val.tdiv G) = q at hdiv hqv
    have hbq : b.val = b.val.tdiv G * G := (Int.tdiv_mul_cancel hGdvd_b).symm
    have hlcm : lcmMath a.val b.val = ((a.val * q.val).natAbs : Int) := by
      unfold lcmMath
      rw [hqv, Int.natAbs_mul]
      have hbn : b.val.natAbs = (b.val.tdiv G).natAbs * G := by
        conv => lhs; rw [hbq]
        rw [Int.natAbs_mul]; rfl
      have hG' : Nat.gcd a.val.natAbs b.val.natAbs = G := by rw [Nat.gcd_comm]; exact hG
      unfold Nat.lcm
      rw [hG', hbn, ← Nat.mul_assoc, Nat.mul_div_cancel _ hGpos]
    have hmul := eo_conv _ _ (JuliaLean.Proofs.base.checked.mulExact t a q)
    unfold ExactOrOverflow at hmul
    have hcm : (bitsOps t).checkedMul a q = JuliaLean.base.checked.checkedMulBits a q := rfl
    rw [hd]
    simp only [Bind.bind, Except.bind, hdiv]
    by_cases hpf : fits t (a.val * q.val)
    · rw [if_pos hpf] at hmul
      obtain ⟨p, hp, hpv⟩ := hmul
      have habs := checkedAbs_eo t p
      unfold ExactOrOverflow at habs
      rw [hpv, ← hlcm] at habs
      rw [hcm, hp]; exact habs
    · rw [if_neg hpf] at hmul
      have hnf : ¬ fits t (lcmMath a.val b.val) := by
        rw [hlcm]; unfold fits at hpf ⊢
        intro hf
        apply hpf
        cases hs : t.signed
        · have := humin hs
          have h1 : 0 ≤ a.val := by omega
          have h2 : 0 ≤ q.val := by
            have := q.property; omega
          have := Int.mul_nonneg h1 h2
          omega
        · have := hsmin hs; omega
      rw [if_neg hnf]
      rw [hcm]
      revert hmul
      cases JuliaLean.base.checked.checkedMulBits a q with
      | ok _ => intro h; exact absurd h id
      | error e => intro h; exact h
  · rw [if_neg hgf] at hg
    have hnf : ¬ fits t (lcmMath a.val b.val) := by
      unfold fits gcdMath at hgf
      unfold fits lcmMath
      cases hs : t.signed
      · have := humin hs; omega
      · have := hsmin hs
        have hae : a.val.natAbs = b.val.natAbs := by omega
        rw [hae, Nat.lcm_self]; omega
    rw [if_neg hnf]
    revert hg
    cases gcd_BitInteger b a with
    | ok _ => intro h; exact absurd h id
    | error e => intro h; exact h

end opusBinGcd

namespace opusPowmod

theorem pow_sub_dvd (a b : Int) : ∀ j : Nat, (a - b) ∣ a ^ j - b ^ j
  | 0 => by simp
  | j + 1 => by
    have ih := pow_sub_dvd a b j
    have e : a ^ (j + 1) - b ^ (j + 1) = a * (a ^ j - b ^ j) + (a - b) * b ^ j := by
      rw [Int.pow_succ, Int.pow_succ]; grind
    rw [e]
    exact Int.dvd_add (Int.dvd_trans ih (Int.dvd_mul_left _ _)) (Int.dvd_mul_right _ _)

theorem pow_split (B : Int) (k : Nat) : B ^ k = B ^ (k % 2) * (B * B) ^ (k / 2) := by
  have hk : k = k % 2 + 2 * (k / 2) := by omega
  conv => lhs; rw [hk]
  rw [Int.pow_add, Int.pow_mul, show B ^ 2 = B * B by rw [Int.pow_succ, Int.pow_one]]

/-- The square-and-multiply loop of `powermod`: with a modular multiplication that is correct
modulo `M` and returns canonical values, the loop returns a canonical value congruent to
`rr * bb ^ p` modulo `M`. -/
theorem loop_spec {P U : Type} (po : IntegerOps P) (value : U → Int) (mulmod : U → U → Jl U)
    (M : Int) (Canon : U → Prop)
    (hshift : ∀ p, 0 ≤ po.value p → po.value (po.shiftRight p 1) = po.value p / 2)
    (hmul : ∀ a b, ∃ c, mulmod a b = .ok c ∧ Canon c ∧ M ∣ value c - value a * value b) :
    ∀ (n : Nat) (p : P) (rr bb : U), 0 < po.value p → (po.value p).toNat ≤ n → Canon rr →
      ∃ r, powermodLoop po value mulmod n p rr bb = .ok r ∧ Canon r ∧
        M ∣ value r - value rr * value bb ^ (po.value p).toNat := by
  intro n
  induction n with
  | zero => intro p rr bb hp hn _; omega
  | succ n ih =>
    intro p rr bb hp hn hc
    obtain ⟨rr1, hrr1, hc1, hd1⟩ : ∃ rr1, (if po.value p % 2 ≠ 0 then mulmod rr bb else pure rr) = .ok rr1 ∧
        Canon rr1 ∧ M ∣ value rr1 - value rr * value bb ^ ((po.value p).toNat % 2) := by
      by_cases hodd : po.value p % 2 ≠ 0
      · obtain ⟨c, h1, h2, h3⟩ := hmul rr bb
        refine ⟨c, by rw [if_pos hodd]; exact h1, h2, ?_⟩
        rw [show (po.value p).toNat % 2 = 1 by omega, Int.pow_one]; exact h3
      · refine ⟨rr, by rw [if_neg hodd]; rfl, hc, ?_⟩
        rw [show (po.value p).toNat % 2 = 0 by omega]; simp
    have hstep : powermodLoop po value mulmod (n + 1) p rr bb =
        (if po.value (po.shiftRight p 1) = 0 then pure rr1 else do
          let bb ← mulmod bb bb
          powermodLoop po value mulmod n (po.shiftRight p 1) rr1 bb) := by
      by_cases hodd : po.value p % 2 ≠ 0
      · have h1 : mulmod rr bb = .ok rr1 := by rw [if_pos hodd] at hrr1; exact hrr1
        simp only [powermodLoop, if_pos hodd, h1, Bind.bind, Except.bind]
      · have h1 : rr1 = rr := by rw [if_neg hodd] at hrr1; exact (Except.ok.inj hrr1).symm
        subst h1
        simp only [powermodLoop, if_neg hodd, Bind.bind, Except.bind, Pure.pure, Except.pure]
    have hp2 := hshift p (by omega)
    have hk := pow_split (value bb) (po.value p).toNat
    by_cases hz : po.value (po.shiftRight p 1) = 0
    · refine ⟨rr1, ?_, hc1, ?_⟩
      · rw [hstep, if_pos hz]; rfl
      · rw [hk, show (po.value p).toNat / 2 = 0 by omega]; simpa using hd1
    · obtain ⟨b2, hb2, _, hdb⟩ := hmul bb bb
      obtain ⟨r, hr, hcr, hdr⟩ := ih (po.shiftRight p 1) rr1 b2 (by omega) (by omega) hc1
      refine ⟨r, ?_, hcr, ?_⟩
      · rw [hstep, if_neg hz]
        simp only [Bind.bind, Except.bind, hb2]
        exact hr
      · rw [hp2] at hdr
        rw [show (po.value p / 2).toNat = (po.value p).toNat / 2 by omega] at hdr
        rw [hk]
        generalize (po.value p).toNat / 2 = j at hdr
        generalize (po.value p).toNat % 2 = e at hd1
        have e1 : value r - value rr * (value bb ^ e * (value bb * value bb) ^ j) =
            (value r - value rr1 * value b2 ^ j) +
            (value rr1 - value rr * value bb ^ e) * value b2 ^ j +
            value rr * value bb ^ e * (value b2 ^ j - (value bb * value bb) ^ j) := by grind
        rw [e1]
        exact Int.dvd_add (Int.dvd_add hdr (Int.dvd_trans hd1 (Int.dvd_mul_right _ _)))
          (Int.dvd_trans (Int.dvd_trans hdb (pow_sub_dvd _ _ j)) (Int.dvd_mul_left _ _))

end opusPowmod

namespace opusModMixed

/-- The same-sign promoted `rem` that `div.jl` hands to the mixed-sign `mod` methods. -/
def promotedRem : JuliaLean.base.int.BinOpJl := fun x y =>
  let (a, b) := JuliaLean.base.int.promoteSameSign x y
  JuliaLean.base.int.remSame a b

theorem promotedRem_spec : JuliaLean.Proofs.base.int.UnsignedRemSpec promotedRem := by
  intro a b ha hb x y
  have hx := JuliaLean.Proofs.base.int.widen_promote_left (show a.signed = b.signed by rw [ha, hb]) x
  have hy := JuliaLean.Proofs.base.int.widen_promote_right (show a.signed = b.signed by rw [ha, hb]) y
  unfold promotedRem JuliaLean.base.int.promoteSameSign
  simp only
  rw [JuliaLean.Proofs.base.int.remSame_eq]
  simp only [JuliaLean.Proofs.base.int.widenTo_val, hx, hy]
  have h0x := JuliaLean.Proofs.base.int.nonneg_of_unsigned ha x
  have h0y := JuliaLean.Proofs.base.int.nonneg_of_unsigned hb y
  by_cases h : y.val = 0
  · simp [h]
  · rw [if_neg h, if_neg h, Int.tmod_eq_emod_of_nonneg h0x]

theorem fmod_spec_eq (a m : Int) (hm : m ≠ 0) : fmod a m = a.fmod m := by
  have hb := JuliaLean.Proofs.base.int.fmod_bounds a m hm
  have hc : (a - a.fmod m) % m = 0 := by
    rw [Int.fmod_def, show a - (a - m * a.fdiv m) = m * a.fdiv m by omega]; simp
  unfold fmod
  have h1 := Int.emod_emod_of_dvd a (Int.dvd_refl m)
  have hd : m ∣ a - a.fmod m := Int.dvd_of_emod_eq_zero hc
  have he : a % m = a.fmod m % m := by
    have := Int.emod_eq_emod_iff_emod_sub_eq_zero.mpr hc; exact this
  have hn := Int.emod_nonneg a hm
  by_cases hp : 0 < m
  · have h2 := hb.1 hp
    rw [Int.emod_eq_of_lt h2.1 h2.2] at he
    rw [if_pos (Or.inr hp)]; exact he
  · have h2 := hb.2 (by omega)
    by_cases hz : a.fmod m = 0
    · rw [hz] at he; simp at he
      rw [if_pos (Or.inl he), he, hz]
    · have e2 : a.fmod m % m = a.fmod m - m := by
        have : (a.fmod m - m) % m = a.fmod m % m := by
          rw [Int.sub_emod, Int.emod_self, Int.sub_zero, Int.emod_emod]
        rw [← this, ← Int.emod_neg]
        exact Int.emod_eq_of_lt (by omega) (by omega)
      rw [e2] at he
      rw [if_neg (by omega)]; omega

/-- `mod(x, y)` for any BitInteger `x` and an unsigned modulus `y` is the floored remainder. -/
theorem modMixed_unsigned_modulus (s t : IntTy) (ht : t.signed = false) (x : JInt s) (y : JInt t) :
    approvedRound2.Concrete.modMixed x y =
      if y.val = 0 then .error .divideError else .ok (fmod x.val y.val) := by
  unfold approvedRound2.Concrete.modMixed
  cases hs : s.signed
  · rw [if_pos (by rw [ht])]
    have hsame : s.signed = t.signed := by rw [hs, ht]
    have hr : promotedRem x y = _ := promotedRem_spec s t hs ht x y
    have hmod : JuliaLean.base.div.modMixedSameSign x y = promotedRem x y := by
      have hu : (s.promote t).signed = false := by
        revert hs ht; cases s <;> cases t <;> decide
      show (do
        let (a, b) := JuliaLean.base.int.promoteSameSign x y
        if (s.promote t).signed then JuliaLean.base.int.mod_BitSigned JuliaLean.base.div.fldBitInteger a b
        else JuliaLean.base.int.mod_Unsigned a b) = _
      simp only [hu, Bool.false_eq_true, if_false]
      rfl
    rw [hmod, hr]
    by_cases h0 : y.val = 0
    · simp [h0, Except.map]
    · rw [if_neg h0, if_neg h0, fmod_spec_eq _ _ h0]
      simp only [Except.map]
      congr 1
      rw [JuliaLean.Proofs.base.int.lit_val]
      have h0x := JuliaLean.Proofs.base.int.nonneg_of_unsigned hs x
      have h0y := JuliaLean.Proofs.base.int.nonneg_of_unsigned ht y
      rw [Int.fmod_eq_emod_of_nonneg _ (by omega)]
      apply wrapInt_of_inRange
      have hx := x.property; have hy := y.property
      have hmx := JuliaLean.Proofs.base.int.widen_promote_right hsame y
      have hb := wrapInt_bounds (s.promote t) y.val
      rw [hmx] at hb
      have := Int.emod_lt_of_pos x.val (show 0 < y.val by omega)
      have := Int.emod_nonneg x.val h0
      have hm0 : (s.promote t).min ≤ 0 := by cases s <;> cases t <;> decide
      constructor <;> omega
  · rw [if_neg (by rw [ht]; decide), if_pos rfl]
    have hm := (JuliaLean.Proofs.base.int.modMixed_proven promotedRem promotedRem_spec).1 s t hs ht x y
    have heq : JuliaLean.base.div.modMixedSignedUnsigned x y =
        JuliaLean.base.int.mod_BitSigned_Unsigned promotedRem x y := rfl
    rw [heq]
    by_cases h0 : y.val = 0
    · rw [if_pos h0, hm.1.mpr h0]; rfl
    · rw [if_neg h0, fmod_spec_eq _ _ h0]
      have hR : ((s.toUnsigned.promote t).toSigned.promote t).toUnsigned.min = 0 ∧
          t.max ≤ ((s.toUnsigned.promote t).toSigned.promote t).toUnsigned.max := by
        revert hs ht; cases s <;> cases t <;> decide
      have hy := y.property
      have h0y := JuliaLean.Proofs.base.int.nonneg_of_unsigned ht y
      have hfb := (JuliaLean.Proofs.base.int.fmod_bounds x.val y.val h0).1 (by omega)
      have hok := (hm.2 ⟨x.val.fmod y.val, by omega, by omega⟩).mpr ⟨h0, rfl⟩
      rw [hok]; rfl

/-- `mod(x::Unsigned, y::Signed)` is the floored remainder. -/
theorem modMixed_unsigned_signed (s t : IntTy) (hs : s.signed = false) (ht : t.signed = true)
    (x : JInt s) (y : JInt t) :
    approvedRound2.Concrete.modMixed x y =
      if y.val = 0 then .error .divideError else .ok (fmod x.val y.val) := by
  unfold approvedRound2.Concrete.modMixed
  rw [if_neg (by rw [hs, ht]; decide), if_neg (by rw [hs]; decide)]
  have hm := (JuliaLean.Proofs.base.int.modMixed_proven promotedRem promotedRem_spec).2 s t hs ht x y
  have heq : JuliaLean.base.div.modMixedUnsignedSigned x y =
      JuliaLean.base.int.mod_Unsigned_Signed promotedRem x y := rfl
  rw [heq]
  by_cases h0 : y.val = 0
  · rw [if_pos h0, hm.1.mpr h0]; rfl
  · rw [if_neg h0, fmod_spec_eq _ _ h0]
    have hR : ((s.promote t.toUnsigned).toSigned.promote t).min ≤ t.min ∧
        t.max ≤ ((s.promote t.toUnsigned).toSigned.promote t).max := by
      revert hs ht; cases s <;> cases t <;> decide
    have hy := y.property
    have htm : t.min = -t.max - 1 := by revert ht; cases t <;> decide
    have hfb := JuliaLean.Proofs.base.int.fmod_bounds x.val y.val h0
    have hlo : ((s.promote t.toUnsigned).toSigned.promote t).min ≤ x.val.fmod y.val ∧
        x.val.fmod y.val ≤ ((s.promote t.toUnsigned).toSigned.promote t).max := by
      by_cases hp : 0 < y.val
      · have := hfb.1 hp; omega
      · have := hfb.2 (by omega); omega
    have hok := (hm.2 ⟨x.val.fmod y.val, hlo⟩).mpr ⟨h0, rfl⟩
    rw [hok]; rfl

end opusModMixed

namespace opusBigPow

/-- The sign fix-up at the end of `powermod`: a canonical residue modulo `|m|` becomes `mod(X, m)`. -/
theorem finish_fmod (X m r : Int) (hm : m ≠ 0) (h0 : 0 ≤ r) (h1 : r < (m.natAbs : Int))
    (hd : (m.natAbs : Int) ∣ r - X) :
    (if r = 0 ∨ m > 0 then r else r + m) = X.fmod m := by
  have hd' : m ∣ X - (if r = 0 ∨ m > 0 then r else r + m) := by
    have hm' : m ∣ r - X := Int.natAbs_dvd.mp hd
    split
    · have := Int.dvd_neg.mpr hm'; rw [Int.neg_sub] at this; exact this
    · have e : X - (r + m) = -(r - X) - m := by omega
      rw [e]; exact Int.dvd_sub (Int.dvd_neg.mpr hm') (Int.dvd_refl m)
  refine (JuliaLean.Proofs.base.int.fmod_char X m _ hm hd' ⟨fun hp => ?_, fun hn => ?_⟩).symm
  · rw [if_pos (Or.inr hp)]; omega
  · split
    · rename_i h; rcases h with h | h
      · rw [h]; omega
      · omega
    · omega

theorem fmod_pow_unit (X m : Int) (h : m.natAbs = 1) : X.fmod m = 0 := by
  have : m = 1 ∨ m = -1 := by omega
  rcases this with rfl | rfl
  · simp [Int.fmod_one]
  · have := JuliaLean.Proofs.base.int.fmod_char X (-1) 0 (by decide) (by simp) ⟨by omega, by omega⟩
    exact this

theorem bigPowermod_spec (x p m : Int) (hp : 0 ≤ p) (hm : m ≠ 0) :
    approvedRound3.Concrete.bigPowermod x p m = .ok (fmod (x ^ p.toNat) m) := by
  rw [opusModMixed.fmod_spec_eq _ _ hm]
  unfold approvedRound3.Concrete.bigPowermod powermod_Integer
  by_cases hp0 : p = 0
  · subst hp0
    show (if (0 : Int) = 0 then JuliaLean.base.rational.bigIntOps.mod 1 m else _) = _
    rw [if_pos rfl]
    show (if m = 0 then Except.error JlError.divideError else Except.ok ((1 : Int).fmod m)) = _
    rw [if_neg hm]; simp
  have hv : ∀ z : Int, bigOps.value z = z := fun _ => rfl
  have ha : ∀ z : Int, bigOps.abs z = (z.natAbs : Int) := fun _ => rfl
  simp only [hv, ha, id, if_neg hp0, show ¬ p < 0 by omega, if_false]
  by_cases hu : m = 1 ∨ m = -1
  · rw [if_pos hu, fmod_pow_unit _ _ (by omega)]; rfl

  rw [if_neg hu]
  have hmm : 2 ≤ m.natAbs := by omega
  have hbb : JuliaLean.base.rational.bigIntOps.mod x (m.natAbs : Int) = .ok (x.fmod (m.natAbs : Int)) := by
    show (if (m.natAbs : Int) = 0 then Except.error JlError.divideError else Except.ok _) = _
    rw [if_neg (by omega)]
  have hbnd := (JuliaLean.Proofs.base.int.fmod_bounds x (m.natAbs : Int) (by omega)).1 (by omega)
  have hxd : (m.natAbs : Int) ∣ x.fmod (m.natAbs : Int) - x := by
    have := Int.fmod_def x (m.natAbs : Int)
    exact ⟨-(x.fdiv (m.natAbs : Int)), by rw [this]; rw [Int.mul_neg]; omega⟩
  simp only [hbb, Bind.bind, Except.bind, powermodMILegal_Integer, Bool.false_and, Bool.false_eq_true,
    if_false, Pure.pure, Except.pure]
  generalize hB : x.fmod (m.natAbs : Int) = B at hbnd hxd
  by_cases hB0 : B = 0
  · rw [if_pos hB0]
    rw [if_pos (Or.inl trivial)]
    congr 1
    refine (JuliaLean.Proofs.base.int.fmod_char _ m 0 hm ?_ ⟨by omega, by omega⟩).symm
    rw [hB0] at hxd
    have hx : m ∣ x := by have := Int.natAbs_dvd.mp hxd; simpa using this
    rw [Int.sub_zero, show p.toNat = (p.toNat - 1) + 1 by omega, Int.pow_succ]
    exact Int.dvd_trans hx (Int.dvd_mul_left _ _)
  rw [if_neg hB0]
  obtain ⟨r, hr, ⟨hr0, hr1⟩, hrd⟩ := opusPowmod.loop_spec bigOps id
    (fun a b => JuliaLean.base.rational.bigIntOps.mod (bigOps.mul a b) (m.natAbs : Int))
    (m.natAbs : Int) (fun c => 0 ≤ c ∧ c < (m.natAbs : Int))
    (by intro q _; show q / (2 ^ 1 : Int) = q / 2; rfl)
    (by
      intro a b
      refine ⟨(a * b).fmod (m.natAbs : Int), ?_, ?_, ?_⟩
      · show (if (m.natAbs : Int) = 0 then Except.error JlError.divideError else Except.ok _) = _
        rw [if_neg (by omega)]; rfl
      · exact (JuliaLean.Proofs.base.int.fmod_bounds _ _ (by omega)).1 (by omega)
      · have := Int.fmod_def (a * b) (m.natAbs : Int)
        exact ⟨-((a * b).fdiv (m.natAbs : Int)), by simp only [id]; rw [this, Int.mul_neg]; omega⟩)
    p.natAbs p 1 B (by rw [hv]; omega) (by rw [hv]; omega) ⟨by decide, by omega⟩
  rw [hr]
  simp only
  congr 1
  apply finish_fmod _ _ _ hm hr0 hr1
  simp only [id, Int.one_mul, hv] at hrd
  have e : r - x ^ p.toNat = (r - B ^ p.toNat) + (B ^ p.toNat - x ^ p.toNat) := by omega
  rw [e]
  exact Int.dvd_add hrd (Int.dvd_trans hxd (opusPowmod.pow_sub_dvd _ _ _))

theorem fmod_fits_mod (t : IntTy) (X : Int) (m : JInt t) (hm : m.val ≠ 0) :
    t.min ≤ X.fmod m.val ∧ X.fmod m.val ≤ t.max := by
  have hb := JuliaLean.Proofs.base.int.fmod_bounds X m.val hm
  have hx := m.property
  have h0 : t.min ≤ 0 := by cases t <;> decide
  have h1 : 0 ≤ t.max := by cases t <;> decide
  by_cases hp : 0 < m.val
  · have := hb.1 hp; omega
  · have := hb.2 (by omega); omega

theorem convert_ok' (t : IntTy) (z : Int) (h : t.min ≤ z ∧ z ≤ t.max) :
    JInt.convert (t.name) t z = .ok ⟨z, h⟩ := by
  unfold JInt.convert; rw [dif_pos h]

theorem powermod128_spec (t : IntTy) (x p : Int) (m : JInt t) (hp : 0 ≤ p) (hm : m.val ≠ 0) :
    ∃ r, powermod_128 Subtype.val approvedRound3.Concrete.bigPowermod (JInt.convert (t.name) t) x p m = .ok r ∧
      r.val = fmod (x ^ p.toNat) m.val := by
  have hf := fmod_fits_mod t (x ^ p.toNat) m hm
  refine ⟨⟨_, hf⟩, ?_, by rw [opusModMixed.fmod_spec_eq _ _ hm]⟩
  unfold powermod_128
  rw [bigPowermod_spec x p m.val hp hm, opusModMixed.fmod_spec_eq _ _ hm]
  exact convert_ok' t _ hf

theorem powermodNonnegative_big :
    (∀ x p m : Int, 0 ≤ p → m ≠ 0 →
      approvedRound3.Concrete.bigPowermod x p m = .ok (fmod (x ^ p.toNat) m)) ∧
    (∀ (s e : IntTy) (x : JInt s) (p : JInt e) (m : Int), 0 ≤ p.val → m ≠ 0 →
      approvedRound3.Concrete.bigPowermod x.val p.val m = .ok (fmod (x.val ^ p.val.toNat) m)) ∧
    (∀ (t : IntTy) (x p : Int) (m : JInt t), t.bits = 128 → 0 ≤ p → m.val ≠ 0 →
      ∃ r, powermod_128 Subtype.val approvedRound3.Concrete.bigPowermod (JInt.convert (t.name) t) x p m = .ok r ∧
        r.val = fmod (x ^ p.toNat) m.val) :=
  ⟨bigPowermod_spec, fun _ _ x p m hp hm => bigPowermod_spec x.val p.val m hp hm,
    fun t x p m _ hp hm => powermod128_spec t x p m hp hm⟩

end opusBigPow

namespace opusPowFixed

theorem loop_spec_canon {P U : Type} (po : IntegerOps P) (value : U → Int) (mulmod : U → U → Jl U)
    (M : Int) (Canon : U → Prop)
    (hshift : ∀ p, 0 ≤ po.value p → po.value (po.shiftRight p 1) = po.value p / 2)
    (hmul : ∀ a b, Canon a → Canon b → ∃ c, mulmod a b = .ok c ∧ Canon c ∧ M ∣ value c - value a * value b) :
    ∀ (n : Nat) (p : P) (rr bb : U), 0 < po.value p → (po.value p).toNat ≤ n → Canon rr → Canon bb →
      ∃ r, powermodLoop po value mulmod n p rr bb = .ok r ∧ Canon r ∧
        M ∣ value r - value rr * value bb ^ (po.value p).toNat := by
  intro n
  induction n with
  | zero => intro p rr bb hp hn _ _; omega
  | succ n ih =>
    intro p rr bb hp hn hc hcb
    obtain ⟨rr1, hrr1, hc1, hd1⟩ : ∃ rr1, (if po.value p % 2 ≠ 0 then mulmod rr bb else pure rr) = .ok rr1 ∧
        Canon rr1 ∧ M ∣ value rr1 - value rr * value bb ^ ((po.value p).toNat % 2) := by
      by_cases hodd : po.value p % 2 ≠ 0
      · obtain ⟨c, h1, h2, h3⟩ := hmul rr bb hc hcb
        refine ⟨c, by rw [if_pos hodd]; exact h1, h2, ?_⟩
        rw [show (po.value p).toNat % 2 = 1 by omega, Int.pow_one]; exact h3
      · refine ⟨rr, by rw [if_neg hodd]; rfl, hc, ?_⟩
        rw [show (po.value p).toNat % 2 = 0 by omega]; simp
    have hstep : powermodLoop po value mulmod (n + 1) p rr bb =
        (if po.value (po.shiftRight p 1) = 0 then pure rr1 else do
          let bb ← mulmod bb bb
          powermodLoop po value mulmod n (po.shiftRight p 1) rr1 bb) := by
      by_cases hodd : po.value p % 2 ≠ 0
      · have h1 : mulmod rr bb = .ok rr1 := by rw [if_pos hodd] at hrr1; exact hrr1
        simp only [powermodLoop, if_pos hodd, h1, Bind.bind, Except.bind]
      · have h1 : rr1 = rr := by rw [if_neg hodd] at hrr1; exact (Except.ok.inj hrr1).symm
        subst h1
        simp only [powermodLoop, if_neg hodd, Bind.bind, Except.bind, Pure.pure, Except.pure]
    have hp2 := hshift p (by omega)
    have hk := opusPowmod.pow_split (value bb) (po.value p).toNat
    by_cases hz : po.value (po.shiftRight p 1) = 0
    · refine ⟨rr1, ?_, hc1, ?_⟩
      · rw [hstep, if_pos hz]; rfl
      · rw [hk, show (po.value p).toNat / 2 = 0 by omega]; simpa using hd1
    · obtain ⟨b2, hb2, hcb2, hdb⟩ := hmul bb bb hcb hcb
      obtain ⟨r, hr, hcr, hdr⟩ := ih (po.shiftRight p 1) rr1 b2 (by omega) (by omega) hc1 hcb2
      refine ⟨r, ?_, hcr, ?_⟩
      · rw [hstep, if_neg hz]
        simp only [Bind.bind, Except.bind, hb2]
        exact hr
      · rw [hp2] at hdr
        rw [show (po.value p / 2).toNat = (po.value p).toNat / 2 by omega] at hdr
        rw [hk]
        generalize (po.value p).toNat / 2 = j at hdr
        generalize (po.value p).toNat % 2 = e at hd1
        have e1 : value r - value rr * (value bb ^ e * (value bb * value bb) ^ j) =
            (value r - value rr1 * value b2 ^ j) +
            (value rr1 - value rr * value bb ^ e) * value b2 ^ j +
            value rr * value bb ^ e * (value b2 ^ j - (value bb * value bb) ^ j) := by grind
        rw [e1]
        exact Int.dvd_add (Int.dvd_add hdr (Int.dvd_trans hd1 (Int.dvd_mul_right _ _)))
          (Int.dvd_trans (Int.dvd_trans hdb (opusPowmod.pow_sub_dvd _ _ j)) (Int.dvd_mul_left _ _))


/-- Nonnegative-exponent `powermod` on a fixed-width modulus type, from the specifications of its
callees: the reduced base, the widened or magic modular product, and the final conversion. -/
theorem nonneg_spec {X P R MI : Type} (t : IntTy) (po : IntegerOps P)
    (uone uzero : JInt t.toUnsigned → JInt t.toUnsigned) (uabs : JInt t → JInt t.toUnsigned)
    (modI : JInt t → JInt t → Jl (JInt t)) (modX : X → JInt t.toUnsigned → Jl (JInt t.toUnsigned))
    (modInverse : R → JInt t.toUnsigned → Jl (JInt t.toUnsigned)) (toI : JInt t.toUnsigned → Jl (JInt t))
    (wideSquare : JInt t → JInt t → JInt t → Jl (JInt t)) (wideLast : JInt t → R → JInt t → Jl (JInt t))
    (wideModU : JInt t.toUnsigned → JInt t.toUnsigned → JInt t.toUnsigned → Jl (JInt t.toUnsigned))
    (invmod : X → JInt t → Jl R) (legal : JInt t.toUnsigned → Bool) (bytes : JInt t.toUnsigned → Nat)
    (inverse : JInt t.toUnsigned → Jl MI)
    (magicMod : JInt t.toUnsigned → JInt t.toUnsigned → MI → Jl (JInt t.toUnsigned))
    (x : X) (p : P) (m : JInt t) (Xv : Int)
    (hp : 0 ≤ po.value p) (hm : m.val ≠ 0)
    (hshift : ∀ p, 0 ≤ po.value p → po.value (po.shiftRight p 1) = po.value p / 2)
    (H1 : ∃ r, modI (JuliaLean.base.int.lit t 1) m = .ok r ∧ r.val = (1 : Int).fmod m.val)
    (Hone : ∀ u, (uone u).val = 1) (Hzero : ∀ u, (uzero u).val = 0)
    (Habs : (uabs m).val = (m.val.natAbs : Int))
    (HmodX : ∃ b, modX x (uabs m) = .ok b ∧ b.val = Xv.fmod (m.val.natAbs : Int))
    (Hwide : ∀ a b : JInt t.toUnsigned, 0 ≤ a.val → a.val < (m.val.natAbs : Int) → 0 ≤ b.val →
      b.val < (m.val.natAbs : Int) →
      ∃ c, wideModU a b (uabs m) = .ok c ∧ c.val = (a.val * b.val).fmod (m.val.natAbs : Int))
    (Hmagic : legal (uabs m) = true → ∃ mis, inverse (uabs m) = .ok mis ∧
      ∀ a b : JInt t.toUnsigned, 0 ≤ a.val → a.val < (m.val.natAbs : Int) → 0 ≤ b.val →
        b.val < (m.val.natAbs : Int) →
        ∃ c, magicMod a b mis = .ok c ∧ c.val = (a.val * b.val).fmod (m.val.natAbs : Int))
    (HtoI : ∀ rr : JInt t.toUnsigned, 0 ≤ rr.val → rr.val < (m.val.natAbs : Int) →
      ∃ r, toI rr = .ok r ∧ r.val = rr.val) :
    ∃ y, powermod_Integer (bitsOps t) po Subtype.val uone uzero uabs modI modX modInverse toI
      wideSquare wideLast wideModU invmod legal bytes inverse magicMod x p m = .ok y ∧
      y.val = fmod (Xv ^ (po.value p).toNat) m.val := by
  rw [opusModMixed.fmod_spec_eq _ _ hm]
  have hv : ∀ z : JInt t, (bitsOps t).value z = z.val := fun _ => rfl
  have hof : ∀ z, (bitsOps t).ofInt z = JuliaLean.base.int.lit t z := fun _ => rfl
  unfold powermod_Integer
  simp only [hv, hof]
  by_cases hp0 : po.value p = 0
  · rw [if_pos hp0, hp0]
    obtain ⟨r, hr, hrv⟩ := H1
    exact ⟨r, hr, by rw [hrv]; simp⟩
  rw [if_neg hp0, if_neg (by omega)]
  by_cases hu : m.val = 1 ∨ m.val = -1
  · rw [if_pos hu]
    refine ⟨_, rfl, ?_⟩
    rw [opusBigPow.fmod_pow_unit _ _ (by omega)]
    show (JuliaLean.base.int.lit t 0).val = 0
    cases t <;> decide
  rw [if_neg hu]
  have hM : 2 ≤ m.val.natAbs := by omega
  obtain ⟨b, hb, hbv⟩ := HmodX
  have hbb := (JuliaLean.Proofs.base.int.fmod_bounds Xv (m.val.natAbs : Int) (by omega)).1 (by omega)
  have hxd : (m.val.natAbs : Int) ∣ b.val - Xv := by
    rw [hbv]
    exact ⟨-(Xv.fdiv (m.val.natAbs : Int)), by rw [Int.fmod_def, Int.mul_neg]; omega⟩
  simp only [hb, Bind.bind, Except.bind]
  -- loop result, uniformly over the two modular products
  have hloop : ∀ (mulmod : JInt t.toUnsigned → JInt t.toUnsigned → Jl (JInt t.toUnsigned)),
      (∀ a b : JInt t.toUnsigned, 0 ≤ a.val → a.val < (m.val.natAbs : Int) → 0 ≤ b.val →
        b.val < (m.val.natAbs : Int) →
        ∃ c, mulmod a b = .ok c ∧ c.val = (a.val * b.val).fmod (m.val.natAbs : Int)) →
      b.val ≠ 0 →
      ∃ rr, powermodLoop po Subtype.val mulmod (po.value p).natAbs p (uone (uabs m)) b = .ok rr ∧
        0 ≤ rr.val ∧ rr.val < (m.val.natAbs : Int) ∧
        (m.val.natAbs : Int) ∣ rr.val - Xv ^ (po.value p).toNat := by
    intro mulmod hmul hb0
    obtain ⟨rr, hrr, ⟨h0, h1⟩, hd⟩ := loop_spec_canon po Subtype.val mulmod (m.val.natAbs : Int)
      (fun c => 0 ≤ c.val ∧ c.val < (m.val.natAbs : Int)) hshift
      (by
        intro a b' ha hb'
        obtain ⟨c, hc, hcv⟩ := hmul a b' ha.1 ha.2 hb'.1 hb'.2
        refine ⟨c, hc, ?_, ?_⟩
        · rw [hcv]; exact (JuliaLean.Proofs.base.int.fmod_bounds _ _ (by omega)).1 (by omega)
        · rw [hcv]
          exact ⟨-((a.val * b'.val).fdiv (m.val.natAbs : Int)), by rw [Int.fmod_def, Int.mul_neg]; omega⟩)
      (po.value p).natAbs p (uone (uabs m)) b (by omega) (by omega)
      ⟨by rw [Hone]; decide, by rw [Hone]; omega⟩ ⟨by omega, by omega⟩
    refine ⟨rr, hrr, h0, h1, ?_⟩
    rw [Hone, Int.one_mul] at hd
    have e : rr.val - Xv ^ (po.value p).toNat =
        (rr.val - b.val ^ (po.value p).toNat) + (b.val ^ (po.value p).toNat - Xv ^ (po.value p).toNat) := by
      omega
    rw [e]
    exact Int.dvd_add hd (Int.dvd_trans hxd (opusPowmod.pow_sub_dvd _ _ _))
  -- the common final step
  have hfinal : ∀ rr : JInt t.toUnsigned, 0 ≤ rr.val → rr.val < (m.val.natAbs : Int) →
      (m.val.natAbs : Int) ∣ rr.val - Xv ^ (po.value p).toNat →
      ∃ r, toI rr = .ok r ∧
        (if r.val = 0 ∨ m.val > 0 then r else (bitsOps t).add r m).val =
          (Xv ^ (po.value p).toNat).fmod m.val := by
    intro rr h0 h1 hd
    obtain ⟨r, hr, hrv⟩ := HtoI rr h0 h1
    refine ⟨r, hr, ?_⟩
    rw [← opusBigPow.finish_fmod _ _ r.val hm (by omega) (by omega) (by rw [hrv]; exact hd)]
    split
    · rfl
    · show (JuliaLean.base.int.add_int r m).val = _
      rw [JuliaLean.Proofs.base.int.add_int_val]
      apply wrapInt_of_inRange
      have hmx := m.property
      have h0' : t.min ≤ 0 := by cases t <;> decide
      constructor <;> omega
  have hzero : b.val = 0 → (m.val.natAbs : Int) ∣ (uzero (uabs m)).val - Xv ^ (po.value p).toNat := by
    intro h
    rw [Hzero, Int.zero_sub, Int.dvd_neg]
    rw [h] at hxd
    have : (m.val.natAbs : Int) ∣ Xv := by have := Int.dvd_neg.mpr hxd; simpa using this
    rw [show (po.value p).toNat = ((po.value p).toNat - 1) + 1 by omega, Int.pow_succ]
    exact Int.dvd_trans this (Int.dvd_mul_left _ _)
  by_cases hleg : (legal (uabs m) && decide (po.value p > 2 * (bytes (uabs m) : Int))) = true
  · rw [if_pos hleg]
    by_cases hb0 : b.val = 0
    · rw [if_pos hb0]
      obtain ⟨r, hr, hrv⟩ := hfinal (uzero (uabs m)) (by rw [Hzero]; decide) (by rw [Hzero]; omega) (hzero hb0)
      simp only [Pure.pure, Except.pure, hr]
      exact ⟨_, rfl, hrv⟩
    · rw [if_neg hb0]
      obtain ⟨mis, hmis, hmm⟩ := Hmagic (by simp at hleg; exact hleg.1)
      obtain ⟨rr, hrr, h0, h1, hd⟩ := hloop (fun a b => magicMod a b mis) hmm hb0
      obtain ⟨r, hr, hrv⟩ := hfinal rr h0 h1 hd
      simp only [hmis, hrr, hr, Pure.pure, Except.pure]
      exact ⟨_, rfl, hrv⟩
  · rw [if_neg hleg]
    by_cases hb0 : b.val = 0
    · rw [if_pos hb0]
      obtain ⟨r, hr, hrv⟩ := hfinal (uzero (uabs m)) (by rw [Hzero]; decide) (by rw [Hzero]; omega) (hzero hb0)
      simp only [Pure.pure, Except.pure, hr]
      exact ⟨_, rfl, hrv⟩
    · rw [if_neg hb0]
      obtain ⟨rr, hrr, h0, h1, hd⟩ := hloop (fun a b => wideModU a b (uabs m)) Hwide hb0
      obtain ⟨r, hr, hrv⟩ := hfinal rr h0 h1 hd
      simp only [hrr, hr, Pure.pure, Except.pure]
      exact ⟨_, rfl, hrv⟩

end opusPowFixed

namespace opusPowInst

theorem modMixed_same (s u : IntTy) (h : s.signed = u.signed) (x : JInt s) (y : JInt u) :
    approvedRound2.Concrete.modMixed x y =
      if y.val = 0 then .error .divideError else .ok (fmod x.val y.val) := by
  unfold approvedRound2.Concrete.modMixed
  rw [if_pos h]
  have hx := JuliaLean.Proofs.base.int.widen_promote_left h x
  have hy := JuliaLean.Proofs.base.int.widen_promote_right h y
  have heq : JuliaLean.base.div.modMixedSameSign x y =
      JuliaLean.base.div.modBitInteger (JuliaLean.base.int.widenTo (s.promote u) x)
        (JuliaLean.base.int.widenTo (s.promote u) y) := Eq.trans rfl rfl
  rw [heq, JuliaLean.Proofs.base.div.modBitInteger_eq]
  simp only [JuliaLean.Proofs.base.int.widenTo_val, hx, hy]
  by_cases h0 : y.val = 0
  · rw [if_pos h0, if_pos h0]; rfl
  · rw [if_neg h0, if_neg h0, opusModMixed.fmod_spec_eq _ _ h0]
    show Except.ok (JuliaLean.base.int.lit (s.promote u) (x.val.fmod y.val)).val = _
    rw [JuliaLean.Proofs.base.int.lit_val]
    congr 1
    apply wrapInt_of_inRange
    have hb := wrapInt_bounds (s.promote u) y.val
    rw [hy] at hb
    have hfb := JuliaLean.Proofs.base.int.fmod_bounds x.val y.val h0
    have h0' : (s.promote u).min ≤ 0 := by cases s <;> cases u <;> decide
    have h1' : 0 ≤ (s.promote u).max := by cases s <;> cases u <;> decide
    by_cases hp : 0 < y.val
    · have := hfb.1 hp; constructor <;> omega
    · have := hfb.2 (by omega); constructor <;> omega

theorem modMixed_r3 {s u : IntTy} (x : JInt s) (y : JInt u) :
    approvedRound3.Concrete.modMixed x y = approvedRound2.Concrete.modMixed x y := Eq.trans rfl rfl

/-- Every mixed `mod` of two BitIntegers is the floored remainder. -/
theorem modMixed_all (s u : IntTy) (x : JInt s) (y : JInt u) :
    approvedRound2.Concrete.modMixed x y =
      if y.val = 0 then .error .divideError else .ok (fmod x.val y.val) := by
  cases hs : s.signed <;> cases hu : u.signed
  · exact modMixed_same s u (by rw [hs, hu]) x y
  · exact opusModMixed.modMixed_unsigned_signed s u hs hu x y
  · exact opusModMixed.modMixed_unsigned_modulus s u hu x y
  · exact modMixed_same s u (by rw [hs, hu]) x y

theorem uabs_val {t : IntTy} (m : JInt t) :
    (JuliaLean.base.float.uabs m).val = (m.val.natAbs : Int) := by
  unfold JuliaLean.base.float.uabs
  cases hs : t.signed
  · simp only [Bool.false_eq_true, if_false, JuliaLean.base.float.uabs_Integer]
    rw [JuliaLean.Proofs.base.int.remT_val, JuliaLean.Proofs.base.int.abs_val, if_neg (by rw [hs]; simp)]
    have h0 := JuliaLean.Proofs.base.int.nonneg_of_unsigned hs m
    have hm := m.property
    apply wrapInt_of_inRange
    have : t.toUnsigned.max = t.max ∧ t.toUnsigned.min = 0 := by revert hs; cases t <;> decide
    constructor <;> omega
  · simp only [if_true, JuliaLean.base.float.uabs_BitSigned]
    exact JuliaLean.Proofs.base.int.unsigned_abs_val hs m

theorem toU_min (t : IntTy) : t.toUnsigned.min = 0 := by cases t <;> decide

theorem natAbs_le_toU (t : IntTy) (m : JInt t) : (m.val.natAbs : Int) ≤ t.toUnsigned.max := by
  have hm := m.property
  have : t.toUnsigned.max = 2 ^ t.bits - 1 ∧ -(2 : Int) ^ t.bits < t.min ∧ t.max < 2 ^ t.bits ∧
      (t.signed = true → t.min = -t.max - 1) := by cases t <;> decide
  by_cases hs : t.signed = true
  · have := this.2.2.2 hs; omega
  · have : t.min = 0 := by revert hs; cases t <;> decide
    omega

theorem toI_fits (t : IntTy) (m : JInt t) (r : Int) (h0 : 0 ≤ r) (h1 : r < (m.val.natAbs : Int)) :
    t.min ≤ r ∧ r ≤ t.max := by
  have hm := m.property
  have h0' : t.min ≤ 0 := by cases t <;> decide
  by_cases hs : t.signed = true
  · have : t.min = -t.max - 1 := by revert hs; cases t <;> decide
    constructor <;> omega
  · have : t.min = 0 := by revert hs; cases t <;> decide
    constructor <;> omega

theorem widen_some (t : IntTy) (h : t.bits ≠ 128) :
    ∃ w, JuliaLean.base.int.widenType t.toUnsigned = some w ∧ w.signed = false ∧
      w.min = 0 ∧ (2 ^ t.bits : Int) * 2 ^ t.bits ≤ w.max + 1 ∧ t.toUnsigned.max = 2 ^ t.bits - 1 := by
  cases t <;> simp [IntTy.bits] at h <;> exact ⟨_, rfl, by decide, by decide, by decide, by decide⟩

theorem wide_spec (c : NumberCallees) (hc : ∀ {s u : IntTy} (x : JInt s) (y : JInt u),
      c.mixedMod x y = approvedRound2.Concrete.modMixed x y)
    (t : IntTy) (h : t.bits ≠ 128) (m : JInt t) (a b : JInt t.toUnsigned)
    (ha : 0 ≤ a.val) (ha1 : a.val < (m.val.natAbs : Int)) (hb : 0 ≤ b.val) (hb1 : b.val < (m.val.natAbs : Int))
    (mm : JInt t.toUnsigned) (hmm : mm.val = (m.val.natAbs : Int)) :
    ∃ r, (do
      let productMod ← workMod c (JuliaLean.base.int.widenType t.toUnsigned) (a.val * b.val) mm.val
      JInt.convert (t.toUnsigned.name) t.toUnsigned productMod) = .ok r ∧
      r.val = (a.val * b.val).fmod (m.val.natAbs : Int) := by
  obtain ⟨w, hw, hws, hwmin, hwmax, htm⟩ := widen_some t h
  have hle := natAbs_le_toU t m
  have hpos : 0 < (m.val.natAbs : Int) := by omega
  have hab : a.val * b.val < 2 ^ t.bits * 2 ^ t.bits := by
    have h2 : (0 : Int) < 2 ^ t.bits := Int.pow_pos (by decide)
    generalize (2 : Int) ^ t.bits = M at h2 htm hwmax ⊢
    have h3 := Int.mul_le_mul (show a.val ≤ M - 1 by omega) (show b.val ≤ M - 1 by omega) hb (by omega)
    have e : (M - 1) * (M - 1) = M * M - 2 * M + 1 := by grind
    omega
  have hab0 : 0 ≤ a.val * b.val := Int.mul_nonneg ha hb
  have h4 : (2 : Int) ^ t.bits ≤ 2 ^ t.bits * 2 ^ t.bits := by
    have h2 : (1 : Int) ≤ 2 ^ t.bits := Int.pow_pos (by decide)
    have := Int.mul_le_mul_of_nonneg_left h2 (show (0 : Int) ≤ 2 ^ t.bits by omega)
    omega
  have hl1 : (JuliaLean.base.int.lit w (a.val * b.val)).val = a.val * b.val :=
    JuliaLean.Proofs.base.int.lit_of_fits ⟨by omega, by omega⟩
  have hl2 : (JuliaLean.base.int.lit w mm.val).val = mm.val :=
    JuliaLean.Proofs.base.int.lit_of_fits ⟨by omega, by omega⟩
  have hfb := (JuliaLean.Proofs.base.int.fmod_bounds (a.val * b.val) (m.val.natAbs : Int) (by omega)).1 hpos
  have hfit : t.toUnsigned.min ≤ (a.val * b.val).fmod (m.val.natAbs : Int) ∧
      (a.val * b.val).fmod (m.val.natAbs : Int) ≤ t.toUnsigned.max := by
    have := toU_min t; constructor <;> omega
  refine ⟨⟨_, hfit⟩, ?_, rfl⟩
  rw [hw]
  show (do
    let productMod ← c.mixedMod (JuliaLean.base.int.lit w (a.val * b.val)) (JuliaLean.base.int.lit w mm.val)
    JInt.convert (t.toUnsigned.name) t.toUnsigned productMod) = _
  rw [hc, opusModMixed.modMixed_unsigned_modulus w w hws, hl1, hl2, if_neg (by omega),
    opusModMixed.fmod_spec_eq _ _ (by omega), hmm]
  exact opusBigPow.convert_ok' _ _ hfit

theorem legal_shift_val (t : IntTy) :
    (JuliaLean.base.int.lshr_int (JuliaLean.base.int.lit t.toUnsigned t.toUnsigned.max)
      (JuliaLean.base.int.lit .i64 ((t.bits / 8 * 4 : Nat) : Int))).val = 2 ^ (t.bits / 2) - 1 := by
  cases t <;> decide

theorem legal_bound (t : IntTy) (mm : JInt t.toUnsigned)
    (h : powermodMILegal_Unsigned (hasTypeMax true true) (JuliaLean.base.int.lit t.toUnsigned t.toUnsigned.max)
      (fun a b => decide (a.val ≤ b.val))
      (fun x n => JuliaLean.base.int.lshr_int x (JuliaLean.base.int.lit .i64 n)) (t.bits / 8) mm = true) :
    mm.val ≤ 2 ^ (t.bits / 2) - 1 := by
  unfold powermodMILegal_Unsigned hasTypeMax at h
  simp only [Bool.true_and, decide_eq_true_eq] at h
  have e := legal_shift_val t
  rw [e] at h; exact h

theorem magic_spec (t : IntTy) (mm : JInt t.toUnsigned) (hmm : 0 < mm.val)
    (hb : mm.val ≤ 2 ^ (t.bits / 2) - 1) :
    ∃ mis, inverseForBits mm = .ok mis ∧
      ∀ a b : JInt t.toUnsigned, 0 ≤ a.val → a.val < mm.val → 0 ≤ b.val → b.val < mm.val →
        ∃ c, magicModBits a b mis = .ok c ∧ c.val = (a.val * b.val).fmod mm.val := by
  have hu : t.toUnsigned.signed = false := by cases t <;> decide
  obtain ⟨inv, hinv, hdiv, hall⟩ :=
    JuliaLean.Proofs.base.multinverses.unsignedArithmetic_proven t.toUnsigned hu mm (by omega)
  refine ⟨.unsigned inv, ?_, ?_⟩
  · unfold inverseForBits
    rw [dif_neg (by rw [hu]; decide)]
    simp only [JuliaLean.base.multinverses.multiplicativeinverseUnsigned] at hinv ⊢
    rw [hinv]; rfl
  · intro a b ha ha1 hb0 hb1
    have hsq : (2 : Int) ^ (t.bits / 2) * 2 ^ (t.bits / 2) = 2 ^ t.bits ∧
        t.toUnsigned.max = 2 ^ t.bits - 1 := by cases t <;> decide
    have hab : a.val * b.val ≤ t.toUnsigned.max := by
      generalize (2 : Int) ^ (t.bits / 2) = K at hb hsq
      have h3 := Int.mul_le_mul (show a.val ≤ K - 1 by omega) (show b.val ≤ K - 1 by omega) hb0 (by omega)
      have e : (K - 1) * (K - 1) = K * K - 2 * K + 1 := by grind
      omega
    have hmul : (JuliaLean.base.int.mul a b).val = a.val * b.val := by
      show (JuliaLean.base.int.mul_int a b).val = _
      rw [JuliaLean.Proofs.base.int.mul_int_val]
      exact wrapInt_of_inRange _ _ ⟨by have := toU_min t; have := Int.mul_nonneg ha hb0; omega, hab⟩
    obtain ⟨q, r, m', dq, dr, _, _, hm', _, _, _, hm'v, _⟩ := hall (JuliaLean.base.int.mul a b)
    have hfb := (JuliaLean.Proofs.base.int.fmod_bounds (a.val * b.val) mm.val (by omega)).1 hmm
    have hfit : t.toUnsigned.min ≤ m'.val ∧ m'.val ≤ t.toUnsigned.max := m'.property
    refine ⟨⟨m'.val, hfit⟩, ?_, by show m'.val = _; rw [hm'v, hmul]⟩
    unfold magicModBits
    simp only [hm', Bind.bind, Except.bind]
    exact opusMixed.convert_ok _ m' hfit

end opusPowInst

