namespace JuliaLean.Proofs.base.intfuncs.Models2Group16
open JuliaLean JuliaLean.Registry
open JuliaLean.base.intfuncs.Models2Group16

/-- Actual selected-call identities, not a replay of the invmod algorithm. -/
inductive InvmodCall where
  | iszero | promoteTypeof | subtype | signedType | hasTypeMax | customNot
  | typemax | lessEqual | widen | remType | isnegative | absolute | add | sub | mod
  | gcdx | indexedFirst | indexedSecond | indexedThird | notEqualOne | customBezout
  deriving BEq, DecidableEq

/-- Tagged observations preserve dynamic value/type/result/iterator-state
identities without requiring any two source carriers to be the same type. -/
inductive InvmodAtom (V Ty P State Other : Type) where
  | value (value : V)
  | typeValue (value : Ty)
  | carrier (value : P)
  | state (value : State)
  | iteration (value : V) (state : State)
  | boolean (value : Bool)
  | nonBool (value : Other)
  | native (value : JInt64)
  | signedToken
  | unit

structure InvmodEvent (W V Ty P State Other : Type) where
  call : InvmodCall
  arguments : List (InvmodAtom V Ty P State Other)
  before : W
  outcome : Except JuliaLean.base.io.Error (InvmodAtom V Ty P State Other)
  after : W

def invmodObserve {W V Ty P State Other Result : Type}
    (call : InvmodCall) (arguments : List (InvmodAtom V Ty P State Other))
    (encode : Result → InvmodAtom V Ty P State Other)
    (action : JuliaLean.base.io.M W Result) :
    JuliaLean.base.io.M (W × List (InvmodEvent W V Ty P State Other)) Result :=
  fun (world, trace) => match action world with
  | none => none
  | some (.ok (value, nextWorld)) =>
      some (.ok (value, (nextWorld,
        trace ++ [⟨call, arguments, world, .ok (encode value), nextWorld⟩])))
  | some (.error (error, nextWorld)) =>
      some (.error (error, (nextWorld,
        trace ++ [⟨call, arguments, world, .error error, nextWorld⟩])))

def invmodPredicateAtom {V Ty P State Other : Type} :
    Bool ⊕ Other → InvmodAtom V Ty P State Other
  | .inl value => .boolean value
  | .inr value => .nonBool value

/-- Observe every actual gcdx/destructuring/inequality call, including the
third ignored value's effect. No callback is replayed or constrained. -/
def observeBezoutCoefOps {W V Ty P State Other : Type}
    (ops : BezoutCoefOps W V P State) :
    BezoutCoefOps (W × List (InvmodEvent W V Ty P State Other)) V P State where
  gcdx n m := invmodObserve .gcdx [.value n, .value m] .carrier (ops.gcdx n m)
  indexedFirst result index :=
    invmodObserve .indexedFirst [.carrier result, .native index]
      (fun (value, state) => .iteration value state) (ops.indexedFirst result index)
  indexedSecond result index state :=
    invmodObserve .indexedSecond [.carrier result, .native index, .state state]
      (fun (value, next) => .iteration value next) (ops.indexedSecond result index state)
  indexedThird result index state :=
    invmodObserve .indexedThird [.carrier result, .native index, .state state]
      (fun _ => .unit) (ops.indexedThird result index state)
  notEqual value literal :=
    invmodObserve .notEqualOne [.value value, .native literal] .boolean (ops.notEqual value literal)

/-- Selection retains the implemented generic helper. Only a selected
custom override is observed as a custom call; it is never substituted for
known _bezout_coef behavior. -/
def observeBezoutDispatch {W V Ty P State Other : Type}
    (ops : BezoutCoefDispatchOps W V P State) :
    BezoutCoefDispatchOps (W × List (InvmodEvent W V Ty P State Other)) V P State where
  generic := observeBezoutCoefOps ops.generic
  select := fun n m => match ops.select n m with
    | .generic => .generic
    | .custom callee => .custom (fun n m =>
        invmodObserve .customBezout [.value n, .value m] .value (callee n m))

/-- Instrument all selected leaves, preserving arbitrary effects, errors,
divergence and before/after worlds, and preserving the generic-helper route. -/
def observeInvmodOps {W V Ty P State Other : Type}
    (ops : InvmodOps W V Ty P State Other) :
    InvmodOps (W × List (InvmodEvent W V Ty P State Other)) V Ty P State Other where
  iszero value := invmodObserve .iszero [.value value] .boolean (ops.iszero value)
  promoteTypeof n m := invmodObserve .promoteTypeof [.value n, .value m] .typeValue (ops.promoteTypeof n m)
  subtype typeValue upper := invmodObserve .subtype [.typeValue typeValue, .signedToken] .boolean (ops.subtype typeValue upper)
  signedType typeValue := invmodObserve .signedType [.typeValue typeValue] .typeValue (ops.signedType typeValue)
  hasTypeMax typeValue := invmodObserve .hasTypeMax [.typeValue typeValue] invmodPredicateAtom (ops.hasTypeMax typeValue)
  notOther value := invmodObserve .customNot [.nonBool value] invmodPredicateAtom (ops.notOther value)
  typemax typeValue := invmodObserve .typemax [.typeValue typeValue] .value (ops.typemax typeValue)
  lessEqual a b := invmodObserve .lessEqual [.value a, .value b] .boolean (ops.lessEqual a b)
  widen typeValue := invmodObserve .widen [.typeValue typeValue] .typeValue (ops.widen typeValue)
  remType value typeValue := invmodObserve .remType [.value value, .typeValue typeValue] .value (ops.remType value typeValue)
  isnegative value := invmodObserve .isnegative [.value value] .boolean (ops.isnegative value)
  abs value := invmodObserve .absolute [.value value] .value (ops.abs value)
  add a b := invmodObserve .add [.value a, .value b] .value (ops.add a b)
  sub a b := invmodObserve .sub [.value a, .value b] .value (ops.sub a b)
  mod a b := invmodObserve .mod [.value a, .value b] .value (ops.mod a b)
  bezout := observeBezoutDispatch ops.bezout

def invmodCalls {W V Ty P State Other : Type} (call : InvmodCall)
    (trace : List (InvmodEvent W V Ty P State Other)) :=
  trace.filter (fun event => event.call == call)

def invmodArguments {W V Ty P State Other : Type} (call : InvmodCall)
    (trace : List (InvmodEvent W V Ty P State Other)) :=
  (invmodCalls call trace).map InvmodEvent.arguments

def invmodOutputs {W V Ty P State Other : Type} (call : InvmodCall)
    (trace : List (InvmodEvent W V Ty P State Other)) :=
  (invmodCalls call trace).filterMap (fun event => event.outcome.toOption)

def invmodValues {W V Ty P State Other : Type} (call : InvmodCall)
    (trace : List (InvmodEvent W V Ty P State Other)) : List (V) :=
  (invmodOutputs call trace).filterMap fun value => match value with
    | .value value => some value
    | _ => none

def invmodTypes {W V Ty P State Other : Type} (call : InvmodCall)
    (trace : List (InvmodEvent W V Ty P State Other)) : List (Ty) :=
  (invmodOutputs call trace).filterMap fun value => match value with
    | .typeValue value => some value
    | _ => none

def invmodBooleans {W V Ty P State Other : Type} (call : InvmodCall)
    (trace : List (InvmodEvent W V Ty P State Other)) : List (Bool) :=
  (invmodOutputs call trace).filterMap fun value => match value with
    | .boolean value => some value
    | _ => none

def invmodCarriers {W V Ty P State Other : Type} (call : InvmodCall)
    (trace : List (InvmodEvent W V Ty P State Other)) : List (P) :=
  (invmodOutputs call trace).filterMap fun value => match value with
    | .carrier value => some value
    | _ => none

def invmodIterations {W V Ty P State Other : Type} (call : InvmodCall)
    (trace : List (InvmodEvent W V Ty P State Other)) : List (V × State) :=
  (invmodOutputs call trace).filterMap fun value => match value with
    | .iteration value state => some (value, state)
    | _ => none

def invmodEventError {W V Ty P State Other : Type}
    (event : InvmodEvent W V Ty P State Other) : Option JuliaLean.base.io.Error :=
  match event.outcome with
  | .error error => some error
  | _ => none

/-- World accounting observes only actual selected actions; it imposes no
purity or transition law. A local throw retains the last action's world. -/
def InvmodWorldAccounting {W V Ty P State Other : Type} (initial final : W)
    (trace : List (InvmodEvent W V Ty P State Other)) : Prop :=
  trace.map InvmodEvent.before = (initial :: trace.map InvmodEvent.after).take trace.length ∧
  (trace.getLast?).map InvmodEvent.after = some final

/-- Data origins of the three destructuring steps, including their actual
iterator states and literal indices. The comparison consumes the first value
only after the ignored third step completed. No gcdx triple-shape law exists. -/
def BezoutEventCausal {W V Ty P State Other : Type} (n m : V)
    (before : List (InvmodEvent W V Ty P State Other))
    (event : InvmodEvent W V Ty P State Other) : Prop :=
  match event.call with
  | .gcdx => event.arguments = [.value n, .value m]
  | .indexedFirst => ∃ result,
      invmodCarriers .gcdx before = [result] ∧
      event.arguments = [.carrier result, .native (JuliaLean.base.int.lit .i64 1)]
  | .indexedSecond => ∃ result g state,
      invmodCarriers .gcdx before = [result] ∧ invmodIterations .indexedFirst before = [(g, state)] ∧
      event.arguments = [.carrier result, .native (JuliaLean.base.int.lit .i64 2), .state state]
  | .indexedThird => ∃ result x state,
      invmodCarriers .gcdx before = [result] ∧ invmodIterations .indexedSecond before = [(x, state)] ∧
      event.arguments = [.carrier result, .native (JuliaLean.base.int.lit .i64 3), .state state]
  | .notEqualOne => ∃ g state,
      invmodIterations .indexedFirst before = [(g, state)] ∧
      invmodOutputs .indexedThird before = [.unit] ∧
      event.arguments = [.value g, .native (JuliaLean.base.int.lit .i64 1)]
  | _ => False

def BezoutCallAccounting {W V Ty P State Other : Type} (n m : V)
    (trace : List (InvmodEvent W V Ty P State Other)) : Prop :=
  (invmodCalls .gcdx trace).length = 1 ∧
  (invmodCalls .indexedFirst trace).length ≤ 1 ∧
  (invmodCalls .indexedSecond trace).length ≤ 1 ∧
  (invmodCalls .indexedThird trace).length ≤ 1 ∧
  (invmodCalls .notEqualOne trace).length ≤ 1 ∧ 1 ≤ trace.length ∧ trace.length ≤ 5 ∧
  (∀ before event after, trace = before ++ event :: after →
    BezoutEventCausal n m before event)

/-- First-error propagation or the sole local non-unit-gcd DomainError.
Success returns the actual second extracted value, after all extraction
steps and the inequality check; no expected arithmetic is supplied. -/
def BezoutTerminal {W V Ty P State Other : Type}
    (trace : List (InvmodEvent W V Ty P State Other)) : Except JuliaLean.base.io.Error V → Prop
  | .ok value =>
      (invmodIterations .indexedSecond trace).map Prod.fst = [value] ∧
      invmodBooleans .notEqualOne trace = [false] ∧
      trace.filterMap invmodEventError = [] ∧ trace.length = 5
  | .error error =>
      (trace.filterMap invmodEventError = [error] ∧
        ∃ event, trace.getLast? = some event ∧ invmodEventError event = some error) ∨
      (trace.filterMap invmodEventError = [] ∧ error = .jl (.domainError "") ∧
        ∃ event, trace.getLast? = some event ∧ event.call = .notEqualOne ∧
          event.outcome = .ok (.boolean true))

/-- The internal coefficient helper's full arbitrary-dispatch invariant.
All values, result carriers, iterator states and mutable worlds are included.
It preserves three separate indexed_iterate effects, the native 1/2/3 and
comparison-1 literals, coefficient origin, first failures and state changes.
The third discarded component is not silently skipped. No mathematical or
shape correctness law is assumed for gcdx or indexed_iterate.
Julia source: base/intfuncs.jl:337-341 at
f755f49a9e41380d7da126b3c1db9fe7f83dd027. -/
def BezoutCoefOpenDispatchProvenance : Prop :=
  ∀ (W V P State : Type) (ops : BezoutCoefOps W V P State) (n m : V) (world : W),
    let observed := bezoutCoefGeneric
      (observeBezoutCoefOps (Ty := Unit) (Other := Empty) ops) n m (world, [])
    match observed with
    | none => True
    | some (.ok (value, (final, trace))) =>
        BezoutCallAccounting n m trace ∧ InvmodWorldAccounting world final trace ∧ BezoutTerminal trace (.ok value)
    | some (.error (error, (final, trace))) =>
        BezoutCallAccounting n m trace ∧ InvmodWorldAccounting world final trace ∧ BezoutTerminal trace (.error error)

/-- Actual coefficient producers; this does not execute the helper again. -/
def invmodCoefficientValues {W V Ty P State Other : Type}
    (trace : List (InvmodEvent W V Ty P State Other)) : List V :=
  invmodValues .customBezout trace ++ (invmodIterations .indexedSecond trace).map Prod.fst

/-- The observed value of !hastypemax after its selected non-Bool ! route,
if any. This is observation decoding, not an assumed trait law. -/
def invmodNoMaximum {W V Ty P State Other : Type}
    (trace : List (InvmodEvent W V Ty P State Other)) : Option Bool :=
  match invmodOutputs .hasTypeMax trace with
  | [.boolean value] => some (!value)
  | [.nonBool _] => (invmodBooleans .customNot trace).head?
  | _ => none

def invmodWorkType {W V Ty P State Other : Type}
    (trace : List (InvmodEvent W V Ty P State Other)) : Option Ty :=
  (invmodTypes .widen trace ++ invmodTypes .signedType trace).head?

def invmodFastAdjusted {W V Ty P State Other : Type}
    (trace : List (InvmodEvent W V Ty P State Other)) : Option V :=
  (invmodValues .add trace ++ invmodCoefficientValues trace).head?

def invmodWideAdjusted {W V Ty P State Other : Type}
    (trace : List (InvmodEvent W V Ty P State Other)) : Option V :=
  (invmodValues .sub trace ++ invmodValues .mod trace).head?

/-- Operand/type/reference provenance over actual call observations. Each
edge identifies a previously returned value, including the two independently
observed typemax bounds and the repeated wide conversion of the original m.
No arithmetic body or selected callback is used to define an expected value.
Julia source invariants: base/intfuncs.jl:308-335. -/
def InvmodEventCausal {W V Ty P State Other : Type} (n m : V)
    (before : List (InvmodEvent W V Ty P State Other))
    (event : InvmodEvent W V Ty P State Other) : Prop :=
  match event.call with
  | .iszero => event.arguments = [.value m] ∧ before = []
  | .promoteTypeof => event.arguments = [.value n, .value m] ∧ invmodBooleans .iszero before = [false]
  | .subtype => ∃ resultType, invmodTypes .promoteTypeof before = [resultType] ∧
      event.arguments = [.typeValue resultType, .signedToken]
  | .signedType => ∃ resultType, invmodTypes .promoteTypeof before = [resultType] ∧
      event.arguments = [.typeValue resultType] ∧ invmodBooleans .subtype before = [false]
  | .hasTypeMax => ∃ signedType, invmodTypes .signedType before = [signedType] ∧
      event.arguments = [.typeValue signedType]
  | .customNot => ∃ value, invmodOutputs .hasTypeMax before = [.nonBool value] ∧
      event.arguments = [.nonBool value]
  | .typemax => ∃ signedType, invmodTypes .signedType before = [signedType] ∧
      event.arguments = [.typeValue signedType] ∧ invmodNoMaximum before = some false ∧
      ((invmodCalls .typemax before).length = 0 ∨ invmodBooleans .lessEqual before = [true])
  | .lessEqual => ∃ maximum,
      (invmodValues .typemax before).getLast? = some maximum ∧
      ((invmodCalls .lessEqual before).length = 0 ∧ event.arguments = [.value n, .value maximum] ∨
        invmodBooleans .lessEqual before = [true] ∧ event.arguments = [.value m, .value maximum]) ∧
      (invmodValues .typemax before).length = (invmodCalls .lessEqual before).length + 1
  | .widen => ∃ signedType, invmodTypes .signedType before = [signedType] ∧
      event.arguments = [.typeValue signedType] ∧ false ∈ invmodBooleans .lessEqual before
  | .remType =>
      let count := (invmodCalls .remType before).length
      if count = 0 then ∃ ty, invmodWorkType before = some ty ∧ event.arguments = [.value n, .typeValue ty]
      else if count = 1 then ∃ ty, invmodWorkType before = some ty ∧ event.arguments = [.value m, .typeValue ty]
      else if count = 2 ∧ (invmodCalls .widen before).length = 1 then
        ∃ ty, invmodTypes .widen before = [ty] ∧ event.arguments = [.value m, .typeValue ty]
      else ∃ resultType value, invmodTypes .promoteTypeof before = [resultType] ∧
        (if (invmodCalls .widen before).length = 0 then invmodFastAdjusted before else invmodWideAdjusted before) = some value ∧
        event.arguments = [.value value, .typeValue resultType]
  | .gcdx | .customBezout =>
      (invmodBooleans .subtype before = [true] ∧ event.arguments = [.value n, .value m]) ∨
      (∃ convertedN convertedM, (invmodValues .remType before).take 2 = [convertedN, convertedM] ∧
        event.arguments = [.value convertedN, .value convertedM])
  | .indexedFirst | .indexedSecond | .indexedThird | .notEqualOne => BezoutEventCausal n m before event
  | .isnegative =>
      if (invmodCalls .widen before).length = 0 then
        ∃ coefficient, invmodCoefficientValues before = [coefficient] ∧ event.arguments = [.value coefficient]
      else event.arguments = [.value m]
  | .absolute => event.arguments = [.value m] ∧ invmodBooleans .isnegative before = [true] ∧
      (invmodCalls .widen before).length = 0
  | .add => ∃ coefficient magnitude,
      invmodCoefficientValues before = [coefficient] ∧ invmodValues .absolute before = [magnitude] ∧
      event.arguments = [.value coefficient, .value magnitude]
  | .sub => ∃ residue, invmodValues .mod before = [residue] ∧
      invmodBooleans .isnegative before = [true] ∧ event.arguments = [.value residue, .value m]
  | .mod =>
      if (invmodCalls .widen before).length = 1 ∧ (invmodCalls .mod before).length = 0 then
        ∃ coefficient convertedM, invmodCoefficientValues before = [coefficient] ∧
          (invmodValues .remType before).getLast? = some convertedM ∧
          event.arguments = [.value coefficient, .value convertedM]
      else if invmodBooleans .subtype before = [true] then
        ∃ coefficient, invmodCoefficientValues before = [coefficient] ∧ event.arguments = [.value coefficient, .value m]
      else ∃ converted, (invmodValues .remType before).getLast? = some converted ∧
          event.arguments = [.value converted, .value m]

/-- Bounds and branch isolation are stated over observations, including
short circuit before either typemax query and between the two <= calls.
The whole method has at most 24 selected calls, even with a custom ! and
both correction operations on the widest path. -/
def InvmodCallAccounting {W V Ty P State Other : Type}
    (trace : List (InvmodEvent W V Ty P State Other)) : Prop :=
  (invmodCalls .iszero trace).length = 1 ∧ 1 ≤ trace.length ∧ trace.length ≤ 24 ∧
  (∀ call, call ∈ [InvmodCall.promoteTypeof, .subtype, .signedType, .hasTypeMax, .customNot,
      .widen, .isnegative, .absolute, .add, .sub, .gcdx, .indexedFirst, .indexedSecond,
      .indexedThird, .notEqualOne, .customBezout] → (invmodCalls call trace).length ≤ 1) ∧
  (invmodCalls .typemax trace).length ≤ 2 ∧ (invmodCalls .lessEqual trace).length ≤ 2 ∧
  (invmodCalls .remType trace).length ≤ 4 ∧ (invmodCalls .mod trace).length ≤ 2 ∧
  (invmodCalls .gcdx trace).length + (invmodCalls .customBezout trace).length ≤ 1 ∧
  (invmodBooleans .iszero trace = [true] → trace.length = 1) ∧
  (invmodBooleans .subtype trace = [true] →
    ∀ call, call ∈ [InvmodCall.signedType, .hasTypeMax, .customNot, .typemax, .lessEqual,
      .widen, .remType, .isnegative, .absolute, .add, .sub] → invmodCalls call trace = []) ∧
  (invmodNoMaximum trace = some true →
    invmodCalls .typemax trace = [] ∧ invmodCalls .lessEqual trace = [] ∧ invmodCalls .widen trace = []) ∧
  (invmodBooleans .lessEqual trace = [false] → (invmodCalls .typemax trace).length = 1) ∧
  (invmodBooleans .lessEqual trace = [true, true] → invmodCalls .widen trace = []) ∧
  (invmodCalls .widen trace = [] → invmodCalls .sub trace = [] ∧ (invmodCalls .mod trace).length ≤ 1) ∧
  ((invmodCalls .widen trace).length = 1 → invmodCalls .absolute trace = [] ∧ invmodCalls .add trace = [])

/-- A completed value originates in the final mod call with the ORIGINAL
modulus. Errors are either the unique first selected failure, the initial
