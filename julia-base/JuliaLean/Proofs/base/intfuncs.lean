-- 9. models2-g16-dec-live-table-memory
private theorem lit_u16_val_self (x : JInt .u16) :
    JuliaLean.base.int.lit .u16 x.val = x := by
  apply Subtype.ext
  change wrapInt .u16 x.val = x.val
  have h := x.property
  change (0 : Int) ≤ x.val ∧ x.val ≤ 2 ^ 16 - 1 at h
  unfold wrapInt
  dsimp [IntTy.signed, IntTy.bits]
  exact Int.emod_eq_of_lt h.1 (by omega)

private theorem indexedPointer_u16_val (abi : DecABI)
    (p : JuliaLean.base.pointer.Ptr (JInt .u16)) (slot : Int)
    (h0 : 0 ≤ slot) :
    (JuliaLean.base.pointer.indexedPointer abi.word p (JuliaLean.base.int.lit .i64 ((slot.toNat : Int) + 1))).address.val =
      (p.address.val + 2 * slot) % (2 ^ 64 : Int) := by
  have hnat : (slot.toNat : Int) = slot := Int.toNat_of_nonneg h0
  rw [hnat]
  have hidx_val : (JuliaLean.base.int.lit .i64 (slot + 1)).val = wrapInt .i64 (slot + 1) := rfl
  change wrapInt .u64 (p.address.val +
    wrapInt .u64 (wrapInt .i64 (abi.word.elementSize.val *
      wrapInt .i64 ((JuliaLean.base.int.lit .i64 (slot + 1)).val - 1)))) = _
  rw [abi.wordBytes, hidx_val]
  have hd0 := JuliaLean.Proofs.base.intfuncs.opusRing.wrap_dvd .i64 (slot + 1)
  have hd1 := JuliaLean.Proofs.base.intfuncs.opusRing.wrap_dvd .i64 (wrapInt .i64 (slot + 1) - 1)
  have hd2 := JuliaLean.Proofs.base.intfuncs.opusRing.wrap_dvd .i64 (2 * wrapInt .i64 (wrapInt .i64 (slot + 1) - 1))
  have hd3 := JuliaLean.Proofs.base.intfuncs.opusRing.wrap_dvd .u64
    (wrapInt .i64 (2 * wrapInt .i64 (wrapInt .i64 (slot + 1) - 1)))
  change (2 ^ 64 : Int) ∣ _ at hd0 hd1 hd2 hd3
  have hsum : (2 ^ 64 : Int) ∣
      (p.address.val + wrapInt .u64 (wrapInt .i64 (2 * wrapInt .i64 (wrapInt .i64 (slot + 1) - 1)))) -
      (p.address.val + 2 * slot) := by
    rcases hd0 with ⟨k0, hk0⟩; rcases hd1 with ⟨k1, hk1⟩; rcases hd2 with ⟨k2, hk2⟩; rcases hd3 with ⟨k3, hk3⟩
    exact ⟨k3 + k2 + 2 * k1 + 2 * k0, by omega⟩
  change (p.address.val + wrapInt .u64 (wrapInt .i64 (2 * wrapInt .i64 (wrapInt .i64 (slot + 1) - 1)))) % (2 ^ 64 : Int) = _
  exact Int.emod_eq_emod_iff_emod_sub_eq_zero.mpr (Int.emod_eq_zero_of_dvd hsum)

@[simp] private theorem hm_bind_run {α β : Type} (action : JuliaLean.base.essentials.HM α)
    (next : α → JuliaLean.base.essentials.HM β) (heap : JuliaLean.base.essentials.Heap) :
    (action >>= next).run heap =
      match action.run heap with
      | none => none
      | some (.error e) => some (.error e)
      | some (.ok (value, heap')) => (next value).run heap' := by
  simp only [StateT.run, Bind.bind, StateT.bind, ExceptT.bind, ExceptT.mk, Option.bind]
  cases action heap with
  | none => rfl
  | some result => cases result <;> rfl

@[simp] private theorem hm_pure_run {α : Type} (value : α) (heap : JuliaLean.base.essentials.Heap) :
    (pure value : JuliaLean.base.essentials.HM α).run heap = some (.ok (value, heap)) := rfl

@[simp] private theorem hm_throw_run {α : Type} (e : JuliaLean.base.essentials.Err) (heap : JuliaLean.base.essentials.Heap) :
    (throw e : JuliaLean.base.essentials.HM α).run heap = some (.error e) := rfl

@[simp] private theorem hm_get_run (heap : JuliaLean.base.essentials.Heap) :
    (get : JuliaLean.base.essentials.HM JuliaLean.base.essentials.Heap).run heap = some (.ok (heap, heap)) := rfl

theorem decKnownTableReadSharedMemory_proven : DecKnownTableReadSharedMemory := by
  intro W abi world index
  rcases world with ⟨⟨w, header⟩, heap⟩
  dsimp only
  have hslot_nonneg : 0 ≤ ((header.offset : Int) + index.val - 1) % (2 ^ 64 : Int) :=
    Int.emod_nonneg _ (by decide)
  by_cases hlt : ((header.offset : Int) + index.val - 1) % (2 ^ 64 : Int) < (header.memoryLength : Int)
  · rw [ite_eq_left hlt]
    have hlen_pos : header.memoryLength ≠ 0 := by omega
    have hslot_lt : (((header.offset : Int) + index.val - 1) % (2 ^ 64 : Int)).toNat < header.memoryLength := by omega
    have hcheck : JuliaLean.base.essentials.checkAccessOrder false "not_atomic" true false
        "memoryrefget: non-atomic memory cannot be accessed atomically"
        "memoryrefget: atomic memory cannot be accessed non-atomically" = .ok () := rfl
    let cell := JuliaLean.base.pointer.pointerRef abi.word heap header.memoryAddress
      (JuliaLean.base.int.lit .i64 (((((header.offset : Int) + index.val - 1) % (2 ^ 64 : Int)).toNat : Int) + 1))
      (JuliaLean.base.int.lit .i64 1)
    refine ⟨cell, ?_, ?_⟩
    · unfold decReadPairNative formattingReadPair JuliaLean.base.essentials.getindexArray
        JuliaLean.base.essentials.memoryrefnewRef JuliaLean.base.essentials.memoryrefget
        JuliaLean.base.essentials.memLength JuliaLean.base.essentials.memObj
        formattingPairsArray formattingPairsHeap decPairView
      simp only [Bool.false_eq_true, ↓reduceIte, hm_bind_run, hm_pure_run, hm_get_run,
        List.getElem?_cons_zero, List.map_map, List.length_map, List.length_range,
        hlt, hcheck, JuliaLean.base.essentials.liftHM, hlen_pos,
        List.getElem?_map, List.getElem?_range hslot_lt, Option.map_some, Function.comp_apply]
      change some (Except.ok (JuliaLean.base.int.lit .u16 cell.val, ((w, header), heap))) =
        some (Except.ok (cell, ((w, header), heap)))
      rw [lit_u16_val_self cell]
    · unfold cell JuliaLean.base.pointer.pointerRef
      have hsz : abi.word.elementSize.val.toNat = 2 := by rw [abi.wordBytes]; rfl
      rw [hsz, indexedPointer_u16_val abi header.memoryAddress
        (((header.offset : Int) + index.val - 1) % (2 ^ 64 : Int)) hslot_nonneg]
  · rw [ite_eq_right hlt]
    unfold decReadPairNative formattingReadPair JuliaLean.base.essentials.getindexArray
      JuliaLean.base.essentials.memoryrefnewRef
      JuliaLean.base.essentials.memLength JuliaLean.base.essentials.memObj
      formattingPairsArray formattingPairsHeap decPairView
    simp only [Bool.false_eq_true, ↓reduceIte, hm_bind_run, hm_pure_run, hm_throw_run, hm_get_run,
      List.getElem?_cons_zero, List.map_map, List.length_map, List.length_range, hlt]
    rfl

-- 10. models2-g16-dec-byte-table-alias
theorem decByteStoreTableAlias_proven : DecByteStoreTableAlias := by
  intro W abi world p byte index tableIndex
  dsimp only
  intro hlt
  let ops : FormattingOps (W × DecTableHeader) Unit := {
    topBit := fun x => pure x
    maxPad := fun _ x => pure x
    addBool := fun _ x => pure x
    addNative := fun x _ => pure x
    divNative := fun x _ => pure x
    stringRoute := fun _ => .noMethod
    toCsize := fun _ => pure (JuliaLean.base.int.lit .u64 0)
    allocateString := fun _ => throw (.jl .boundsError)
    customString := fun _ => throw (.jl .boundsError)
    pointerOther := fun _ => throw (.jl .boundsError)
    greaterEqual := fun _ _ => pure false
    greaterBool := fun _ _ => pure false
    lowByte := fun _ => pure (.inl byte)
    shiftRight := fun x _ => pure x
    subNative := fun x _ => pure x
    toNativeIndex := fun _ => pure index
    storeByteRoute := fun _ => .noMethod
    customByteStore := fun _ _ _ => pure ()
    storeOther := fun _ _ _ => pure () }
  obtain ⟨afterHeap, hstore, hreadChanged, hreadOther⟩ :=
    formattingNativeStoreFootprint_proven (W × DecTableHeader) Unit ops p byte index world
  have hstore' : formattingStoreNative p byte index world = some (.ok ((), (world.1, afterHeap))) := hstore
  have htable := decKnownTableReadSharedMemory_proven W abi (world.1, afterHeap) tableIndex
  dsimp only at htable
  rw [ite_eq_left hlt] at htable
  obtain ⟨result, hreadPair, hdecode⟩ := htable
  refine ⟨result, (world.1, afterHeap), ?_, rfl, ?_⟩
  · rw [io_bind2, hstore']
    exact hreadPair
  · rw [hdecode]
    let slot := ((world.1.2.offset : Int) + tableIndex.val - 1) % (2 ^ 64 : Int)
    let address := (world.1.2.memoryAddress.address.val + 2 * slot) % (2 ^ 64 : Int)
    let second := (address + 1) % (2 ^ 64 : Int)
    let changed := (p.address.val + index.val - 1) % (2 ^ 64 : Int)
    have haddr0 : 0 ≤ address ∧ address < 2 ^ 64 :=
      ⟨Int.emod_nonneg _ (by decide), Int.emod_lt_of_pos _ (by decide)⟩
    have hsec0 : 0 ≤ second ∧ second < 2 ^ 64 :=
      ⟨Int.emod_nonneg _ (by decide), Int.emod_lt_of_pos _ (by decide)⟩
    have hchg0 : 0 ≤ changed ∧ changed < 2 ^ 64 :=
      ⟨Int.emod_nonneg _ (by decide), Int.emod_lt_of_pos _ (by decide)⟩
    have hbytes : afterHeap.readBytes address.toNat 2 =
        [afterHeap.readByte address.toNat, afterHeap.readByte second.toNat] := by
      dsimp [JuliaLean.base.pointer.ByteHeap.readBytes, JuliaLean.base.pointer.ByteHeap.readByte,
        JuliaLean.base.pointer.addressMod, List.range, List.range.loop]
      have h2 : (address.toNat + 1) % 18446744073709551616 = second.toNat % 18446744073709551616 := by
        have : ((address.toNat + 1 : Nat) : Int) % (2 ^ 64 : Int) = second := by
          have hto : (address.toNat : Int) = address := Int.toNat_of_nonneg haddr0.1
          rw [Int.natCast_add, hto]; rfl
        omega
      rw [h2]
    rw [hbytes]
    have hb1 : afterHeap.readByte address.toNat =
        if changed = address then byte else world.2.readByte address.toNat := by
      by_cases heq : changed = address
      · rw [ite_eq_left heq, ← heq]; exact hreadChanged
      · rw [ite_eq_right heq]
        apply hreadOther address.toNat (by omega)
        intro hnat; apply heq; omega
    have hb2 : afterHeap.readByte second.toNat =
        if changed = second then byte else world.2.readByte second.toNat := by
      by_cases heq : changed = second
      · rw [ite_eq_left heq, ← heq]; exact hreadChanged
      · rw [ite_eq_right heq]
        apply hreadOther second.toNat (by omega)
        intro hnat; apply heq; omega
    rw [hb1, hb2]

