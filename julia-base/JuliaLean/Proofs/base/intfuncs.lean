def binBits {t : IntTy} (x : JInt t) (pad : JInt64) (neg : Bool) : Jl Buffer :=
  bin (fun x => (JuliaLean.base.int.top_set_bit x).val.toNat)
    (fun x => (JuliaLean.base.int.remT .u8 x).val.toNat)
    (fun x n => JuliaLean.base.int.lshr_Int x (JuliaLean.base.int.lit .i64 n)) x pad neg

def octBits {t : IntTy} (x : JInt t) (pad : JInt64) (neg : Bool) : Jl Buffer :=
  oct (fun x => (JuliaLean.base.int.top_set_bit x).val.toNat)
    (fun x => (JuliaLean.base.int.remT .u8 x).val.toNat)
    (fun x n => JuliaLean.base.int.lshr_Int x (JuliaLean.base.int.lit .i64 n)) x pad neg

def hexBits {t : IntTy} (x : JInt t) (pad : JInt64) (neg : Bool) : Jl Buffer :=
  hex (fun x => (JuliaLean.base.int.top_set_bit x).val.toNat)
    (fun x => (JuliaLean.base.int.remT .u8 x).val.toNat)
    (fun x n => JuliaLean.base.int.lshr_Int x (JuliaLean.base.int.lit .i64 n)) x pad neg
end Concrete

def WriterNumeral (result : Jl Buffer) (value base pad : Int) (neg : Bool) : Prop :=
  if neg = true ∧ pad = IntTy.max .i64 then inexactError result
  else ∃ s payload, result = .ok s ∧
    s.bytes = (if neg then [45] else []) ++ payload ∧
    decodeUnsigned base payload = some value ∧
    DigitCount value base pad (payload.length : Int)

def FormattingWritersAvailable : Prop :=
  ∀ (t : IntTy) (n : JInt t) (pad : JInt64) (neg : Bool), t.signed = false →
    WriterNumeral (Concrete.binBits n pad neg) n.val 2 pad.val neg ∧
    WriterNumeral (Concrete.octBits n pad neg) n.val 8 pad.val neg ∧
    WriterNumeral (Concrete.hexBits n pad neg) n.val 16 pad.val neg
end approvedRound6
