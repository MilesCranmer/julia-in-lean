private theorem ndMixedDivremZero (u s : IntTy) (hu : u.signed = false)
    (hs : s.signed = true) (y : JInt s) (hy : y.val ≠ 0) :
    JuliaLean.base.int.divrem_Unsigned_BitSigned sameSignTruncDivrem
      (JuliaLean.base.int.lit u 0) y =
      .ok (JuliaLean.base.int.lit (u.promote s.toUnsigned).toSigned.toUnsigned 0,
        JuliaLean.base.int.lit (u.promote s.toUnsigned) 0) := by
  have hsu : s.toUnsigned.signed = false := by cases s <;> decide
  have hsn : (u.promote s.toUnsigned).toSigned.signed = true := by
    cases u.promote s.toUnsigned <;> decide
  have hval := JuliaLean.Proofs.base.int.unsigned_abs_val hs y
  have hne : (JuliaLean.base.int.unsigned (JuliaLean.base.int.abs y)).val ≠ 0 := by
    rw [hval]
    intro h
    have h' : y.val.natAbs = 0 := Int.ofNat_eq_zero.mp h
    exact hy (Int.natAbs_eq_zero.mp h')
  rw [JuliaLean.base.int.divrem_Unsigned_BitSigned, JuliaLean.base.int.Generic.divrem_Unsigned_BitSigned,
    ndPromotedDivremZero u s.toUnsigned hu hsu _ hne]
  simp only [Bind.bind, Except.bind, ndSignedZero, ndFlipsignZero _ s hsn hs y,
