open JuliaLean.base.intfuncs.Models2Group16

/-! These observations describe actual selected calls, their arguments and
their before/after worlds. Trace lists are mathematical observations, not
Julia arrays or replacement implementations of reduce/only. Neither an array
index origin nor an element-type stability law is imposed. -/

/-- Record one arbitrary selected action with its real pre/post worlds.
The operation sees only W, so it cannot edit the observation trace. Its
exception, state changes and divergence are preserved without a second call.
RationalCallSnapshot is the already defined generic observation record. -/
def observeArrayCall {W E Value : Type}
    (event : RationalCallSnapshot W Value → E)
    (action : JuliaLean.base.io.M W Value) :
    JuliaLean.base.io.M (W × List E) Value := fun (world, trace) =>
  match action world with
  | none => none
  | some (.ok (value, nextWorld)) =>
      some (.ok (value, (nextWorld,
        trace ++ [event ⟨world, .ok value, nextWorld⟩])))
  | some (.error (error, nextWorld)) =>
      some (.error (error, (nextWorld,
        trace ++ [event ⟨world, .error error, nextWorld⟩])))

/-- Completed calls of the generic real-array gcd, including failing calls. -/
inductive GcdArrayEvent (W A Ty Init R : Type) where
  | elementType (array : A) (observation : RationalCallSnapshot W Ty)
  | zero (typeValue : Ty) (observation : RationalCallSnapshot W Init)
  | reduction (function : NumberTheoryFunction) (array : A) (initial : Init)
      (observation : RationalCallSnapshot W R)

def observeGcdArrayOps {W A Ty Init R : Type}
    (ops : GcdArrayOps (JuliaLean.base.io.M W) A Ty Init R) :
    GcdArrayOps (JuliaLean.base.io.M (W × List (GcdArrayEvent W A Ty Init R)))
      A Ty Init R where
  eltype array := observeArrayCall (.elementType array) (ops.eltype array)
  zero typeValue := observeArrayCall (.zero typeValue) (ops.zero typeValue)
  reduceWithInit function array initial :=
    observeArrayCall (.reduction function array initial)
      (ops.reduceWithInit function array initial)

def gcdArrayTypeInputs {W A Ty Init R : Type}
    (trace : List (GcdArrayEvent W A Ty Init R)) : List A :=
  trace.filterMap fun event => match event with
    | .elementType array _ => some array
    | _ => none

def gcdArrayTypeOutputs {W A Ty Init R : Type}
    (trace : List (GcdArrayEvent W A Ty Init R)) : List Ty :=
  trace.filterMap fun event => match event with
    | .elementType _ observation => observation.outcome.toOption
    | _ => none

def gcdArrayZeroInputs {W A Ty Init R : Type}
    (trace : List (GcdArrayEvent W A Ty Init R)) : List Ty :=
  trace.filterMap fun event => match event with
    | .zero typeValue _ => some typeValue
    | _ => none

def gcdArrayZeroOutputs {W A Ty Init R : Type}
    (trace : List (GcdArrayEvent W A Ty Init R)) : List Init :=
  trace.filterMap fun event => match event with
    | .zero _ observation => observation.outcome.toOption
    | _ => none

def gcdArrayReductionInputs {W A Ty Init R : Type}
    (trace : List (GcdArrayEvent W A Ty Init R)) : List (NumberTheoryFunction × A × Init) :=
  trace.filterMap fun event => match event with
    | .reduction function array initial _ => some (function, array, initial)
    | _ => none

def gcdArrayReductionOutputs {W A Ty Init R : Type}
    (trace : List (GcdArrayEvent W A Ty Init R)) : List R :=
  trace.filterMap fun event => match event with
    | .reduction _ _ _ observation => observation.outcome.toOption
    | _ => none

def gcdArrayEventWorlds {W A Ty Init R : Type} :
    GcdArrayEvent W A Ty Init R → W × W
  | .elementType _ observation => (observation.before, observation.after)
  | .zero _ observation => (observation.before, observation.after)
  | .reduction _ _ _ observation => (observation.before, observation.after)

def gcdArrayEventError {W A Ty Init R : Type} :
    GcdArrayEvent W A Ty Init R → Option JuliaLean.base.io.Error
  | .elementType _ ⟨_, .error error, _⟩ => some error
  | .zero _ ⟨_, .error error, _⟩ => some error
  | .reduction _ _ _ ⟨_, .error error, _⟩ => some error
  | _ => none

def gcdArrayEventRank {W A Ty Init R : Type} : GcdArrayEvent W A Ty Init R → Nat
  | .elementType _ _ => 0
