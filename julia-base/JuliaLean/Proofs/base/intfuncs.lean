private def GcdLoopInv {W V : Type} (a b : V) : (V × V) → (W × List (GcdEvent V)) → Prop
  | (u, v), (_, trace) =>
      b :: gcdRemainderOutputs trace = gcdTestInputs trace ++ [v] ∧
      a :: (gcdRemainderInputs trace).map Prod.snd = (gcdRemainderInputs trace).map Prod.fst ++ [u] ∧
      (gcdRemainderInputs trace).map Prod.snd = gcdTestInputs trace ∧
      gcdAbsoluteInputs trace = [] ∧
      gcdAbsoluteOutputs trace = [] ∧
      trace.filterMap gcdEventError = [] ∧
      (∀ value zero result, GcdEvent.test value zero result ∈ trace → zero.val = 0) ∧
      (∀ value result, GcdEvent.absolute value result ∈ trace → False)

