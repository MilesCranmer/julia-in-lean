  intro k
  rw [tripleGcdDvd, tripleGcdDvd]
  constructor
  · rintro ⟨ha, hb, hm⟩
    exact ⟨(wrappedDivisibility t k hm a).mp ha,
      (wrappedDivisibility t k hm b).mp hb, hm⟩
  · rintro ⟨ha, hb, hm⟩
