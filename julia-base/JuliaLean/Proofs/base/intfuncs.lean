theorem IntfuncsDecimalCount_proven : JuliaLean.Proofs.base.intfuncs.DecimalDigitCount := by
  intro t x hu
  by_cases hw : t.bits = 128
  · have ht : t = .u128 := by
      cases t <;> simp_all only [IntTy.bits, IntTy.signed, Bool.true_eq_false] <;> omega
    subst t
