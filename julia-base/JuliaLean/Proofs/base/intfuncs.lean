open opusPowInst

theorem lit_toU (t : IntTy) : (JuliaLean.base.int.lit t.toUnsigned 1).val = 1 ∧
    (JuliaLean.base.int.lit t.toUnsigned 0).val = 0 ∧ (JuliaLean.base.int.lit t 1).val = 1 := by
  cases t <;> decide

theorem mod1_spec (t : IntTy) (m : JInt t) (hm : m.val ≠ 0) :
    ∃ r, (approvedRound3.Concrete.modMixed (JuliaLean.base.int.lit t 1) m >>= JInt.convert (t.name) t) =
      Except.ok r ∧ r.val = (1 : Int).fmod m.val := by
  have hf := opusBigPow.fmod_fits_mod t 1 m hm
  refine ⟨⟨_, hf⟩, ?_, rfl⟩
  rw [modMixed_r3, modMixed_all, if_neg hm, (lit_toU t).2.2, opusModMixed.fmod_spec_eq _ _ hm]
  exact opusBigPow.convert_ok' t _ hf

theorem shift_bits (e : IntTy) (q : JInt e) (_ : 0 ≤ (bitsOps e).value q) :
    (bitsOps e).value ((bitsOps e).shiftRight q 1) = (bitsOps e).value q / 2 := by
  show (JuliaLean.base.int.shr_Int q (JuliaLean.base.int.lit .i64 ((1 : Nat) : Int))).val = q.val / 2
  rw [opusBinGcd.shr_val q 1 (by decide)]; rfl

theorem shift_big (q : Int) (_ : 0 ≤ bigOps.value q) :
    bigOps.value (bigOps.shiftRight q 1) = bigOps.value q / 2 := rfl

theorem magic_hyp (t : IntTy) (m : JInt t) (hm : m.val ≠ 0) :
    powermodMILegal_Unsigned (hasTypeMax true true) (JuliaLean.base.int.lit t.toUnsigned t.toUnsigned.max)
        (fun a b => decide (a.val ≤ b.val))
        (fun x n => JuliaLean.base.int.lshr_int x (JuliaLean.base.int.lit .i64 n)) (t.bits / 8)
        (JuliaLean.base.float.uabs m) = true →
    ∃ mis, inverseForBits (JuliaLean.base.float.uabs m) = .ok mis ∧
      ∀ a b : JInt t.toUnsigned, 0 ≤ a.val → a.val < (m.val.natAbs : Int) → 0 ≤ b.val →
        b.val < (m.val.natAbs : Int) →
        ∃ c, magicModBits a b mis = .ok c ∧ c.val = (a.val * b.val).fmod (m.val.natAbs : Int) := by
  intro hl
  have hu := uabs_val m
  obtain ⟨mis, h1, h2⟩ := magic_spec t (JuliaLean.base.float.uabs m) (by rw [hu]; omega) (legal_bound t _ hl)
  refine ⟨mis, h1, fun a b ha ha1 hb hb1 => ?_⟩
  rw [← hu]
  exact h2 a b ha (by rw [hu]; exact ha1) hb (by rw [hu]; exact hb1)

theorem toI_hyp (t : IntTy) (m : JInt t) (rr : JInt t.toUnsigned) (h0 : 0 ≤ rr.val)
    (h1 : rr.val < (m.val.natAbs : Int)) :
    ∃ r, JInt.convert (t.name) t rr.val = .ok r ∧ r.val = rr.val :=
  ⟨⟨rr.val, toI_fits t m rr.val h0 h1⟩, opusBigPow.convert_ok' t _ _, rfl⟩

theorem mixedPowermod_small (g : approvedRound3.Concrete.GmpPrimitives) (t : IntTy) (x p : Int) (m : JInt t)
    (h128 : ¬ t.bits = 128) (hp : 0 ≤ p) (hm : m.val ≠ 0) :
    ∃ r, approvedRound3.Concrete.mixedPowermod g x p m = .ok r ∧ r.val = fmod (x ^ p.toNat) m.val := by
  unfold approvedRound3.Concrete.mixedPowermod
  rw [if_neg h128]
  have hu := uabs_val m
  have hle := natAbs_le_toU t m
  have hfx := (JuliaLean.Proofs.base.int.fmod_bounds x (m.val.natAbs : Int) (by omega)).1 (by omega)
  have hfitx : t.toUnsigned.min ≤ x.fmod (m.val.natAbs : Int) ∧
      x.fmod (m.val.natAbs : Int) ≤ t.toUnsigned.max := by
    have := toU_min t; constructor <;> omega
  exact opusPowFixed.nonneg_spec t bigOps _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ x p m x hp hm shift_big
    (mod1_spec t m hm) (fun _ => (lit_toU t).1) (fun _ => (lit_toU t).2.1) hu
    ⟨⟨_, hfitx⟩, by
      show (JuliaLean.base.rational.bigIntOps.mod x (JuliaLean.base.float.uabs m).val >>=
        JInt.convert (t.toUnsigned.name) t.toUnsigned) = _
      rw [hu]
      show ((if (m.val.natAbs : Int) = 0 then Except.error JlError.divideError
          else Except.ok (x.fmod (m.val.natAbs : Int))) >>= JInt.convert (t.toUnsigned.name) t.toUnsigned) = _
      rw [if_neg (by omega)]
      exact opusBigPow.convert_ok' _ _ hfitx, rfl⟩
    (fun a b ha ha1 hb hb1 => wide_spec (approvedRound3.Concrete.numberCallees g)
      (fun x y => modMixed_r3 x y) t h128 m a b ha ha1 hb hb1 _ hu)
    (magic_hyp t m hm)
    (fun rr h0 h1 => toI_hyp t m rr h0 h1)

theorem powermodBits_nonneg (g : approvedRound3.Concrete.GmpPrimitives) (hg : approvedRound3.Concrete.GmpDocs g)
    (s e t : IntTy) (x : JInt s) (p : JInt e) (m : JInt t) (hp : 0 ≤ p.val) (hm : m.val ≠ 0) :
    ∃ y, powermodBits (approvedRound3.Concrete.numberCallees g) x p m = .ok y ∧
      y.val = fmod (x.val ^ p.val.toNat) m.val := by
  unfold powermodBits
  by_cases h128 : t.bits = 128
  · rw [if_pos h128]
    obtain ⟨y, hy, hyv⟩ := hg.2.1 x.val p.val m.val hp hm
    have hf := opusBigPow.fmod_fits_mod t (x.val ^ p.val.toNat) m hm
    rw [← opusModMixed.fmod_spec_eq _ _ hm] at hf
    refine ⟨⟨_, hf⟩, ?_, rfl⟩
    unfold powermod_128
    show (g.powermod x.val p.val m.val >>= JInt.convert (t.name) t) = _
    rw [hy, hyv]
    exact opusBigPow.convert_ok' t _ hf
  rw [if_neg h128]
  have hu := uabs_val m
  have hle := natAbs_le_toU t m
  have hfx := (JuliaLean.Proofs.base.int.fmod_bounds x.val (m.val.natAbs : Int) (by omega)).1 (by omega)
  have hfitx : t.toUnsigned.min ≤ x.val.fmod (m.val.natAbs : Int) ∧
      x.val.fmod (m.val.natAbs : Int) ≤ t.toUnsigned.max := by
    have := toU_min t; constructor <;> omega
  exact opusPowFixed.nonneg_spec t (bitsOps e) _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ x p m x.val hp hm
    (shift_bits e)
    (mod1_spec t m hm) (fun _ => (lit_toU t).1) (fun _ => (lit_toU t).2.1) hu
    ⟨⟨_, hfitx⟩, by
      show (approvedRound3.Concrete.modMixed x (JuliaLean.base.float.uabs m) >>=
        JInt.convert (t.toUnsigned.name) t.toUnsigned) = _
      rw [modMixed_r3, modMixed_all, hu, if_neg (by omega), opusModMixed.fmod_spec_eq _ _ (by omega)]
      exact opusBigPow.convert_ok' _ _ hfitx, rfl⟩
    (fun a b ha ha1 hb hb1 => wide_spec (approvedRound3.Concrete.numberCallees g)
      (fun x y => modMixed_r3 x y) t h128 m a b ha ha1 hb hb1 _ hu)
    (magic_hyp t m hm)
    (fun rr h0 h1 => toI_hyp t m rr h0 h1)

theorem mixedPowermod_spec (g : approvedRound3.Concrete.GmpPrimitives) (t : IntTy) (x p : Int) (m : JInt t)
    (hp : 0 ≤ p) (hm : m.val ≠ 0) :
    ∃ r, approvedRound3.Concrete.mixedPowermod g x p m = .ok r ∧ r.val = fmod (x ^ p.toNat) m.val := by
  by_cases h128 : t.bits = 128
  · unfold approvedRound3.Concrete.mixedPowermod
    rw [if_pos h128]
    exact opusBigPow.powermod128_spec t x p m hp hm
  · exact mixedPowermod_small g t x p m h128 hp hm

theorem powermodNonnegative_proven : approvedRound3.PowermodNonnegative :=
  ⟨fun g hg s e t x p m hp hm => powermodBits_nonneg g hg s e t x p m hp hm,
   opusBigPow.powermodNonnegative_big.1, opusBigPow.powermodNonnegative_big.2.1,
   opusBigPow.powermodNonnegative_big.2.2,
   fun g _ t x p m hp hm => mixedPowermod_spec g t x p m hp hm⟩

end opusPowParts

namespace opusInvmodW

/-- Ghost cofactor invariant of one Euclid coefficient column: the wrapped coefficients are images
of exact integers `X0`, `X1` with `X0 * C ≡ a` and `X1 * C ≡ b` modulo `D`, bounded by `|D|`. -/
def G (t : IntTy) (C D : Int) (a b x0 x1 : JInt t) : Prop :=
  ∃ X0 X1 : Int, x0.val = wrapInt t X0 ∧ x1.val = wrapInt t X1 ∧
    D ∣ X0 * C - a.val ∧ D ∣ X1 * C - b.val ∧
    b.val.natAbs * X0.natAbs + a.val.natAbs * X1.natAbs ≤ D.natAbs ∧
    X0.natAbs ≤ D.natAbs ∧ (X1.natAbs ≤ D.natAbs ∨ a.val ≠ 0)

def H (t : IntTy) (C D : Int) (a x : JInt t) : Prop :=
  ∃ X : Int, x.val = wrapInt t X ∧ D ∣ X * C - a.val ∧ X.natAbs ≤ D.natAbs

theorem ghost_step (C D a b q r X0 X1 : Int) (hqr : a = q * b + r)
    (habs : a.natAbs = q.natAbs * b.natAbs + r.natAbs)
    (h1 : D ∣ X0 * C - a) (h2 : D ∣ X1 * C - b)
    (h3 : b.natAbs * X0.natAbs + a.natAbs * X1.natAbs ≤ D.natAbs)
    (h5 : X1.natAbs ≤ D.natAbs ∨ a ≠ 0) :
    D ∣ (X0 - q * X1) * C - r ∧
    r.natAbs * X1.natAbs + b.natAbs * (X0 - q * X1).natAbs ≤ D.natAbs ∧
    X1.natAbs ≤ D.natAbs := by
  refine ⟨?_, ?_, ?_⟩
  · have e : (X0 - q * X1) * C - r = (X0 * C - a) - q * (X1 * C - b) + (a - (q * b + r)) := by
      grind
    rw [e, ← hqr, Int.sub_self, Int.add_zero]
    exact Int.dvd_sub h1 (Int.dvd_trans h2 (Int.dvd_mul_left q _))
  · have e1 : (X0 - q * X1).natAbs ≤ X0.natAbs + q.natAbs * X1.natAbs := by
      have := Int.natAbs_sub_le X0 (q * X1); rw [Int.natAbs_mul] at this; exact this
    have e2 := Nat.mul_le_mul_left b.natAbs e1
    have e3 : b.natAbs * (X0.natAbs + q.natAbs * X1.natAbs) =
        b.natAbs * X0.natAbs + q.natAbs * b.natAbs * X1.natAbs := by
      rw [Nat.mul_add, ← Nat.mul_assoc, Nat.mul_comm b.natAbs q.natAbs]
    have e4 : a.natAbs * X1.natAbs = q.natAbs * b.natAbs * X1.natAbs + r.natAbs * X1.natAbs := by
      rw [habs, Nat.add_mul]
    omega
  · rcases h5 with h | h
    · exact h
    · have : X1.natAbs ≤ a.natAbs * X1.natAbs := Nat.le_mul_of_pos_left _ (by omega)
      omega

theorem sub_mul_val (t : IntTy) (x0 q x1 : JInt t) (X0 X1 : Int)
    (e0 : x0.val = wrapInt t X0) (e1 : x1.val = wrapInt t X1) :
    (JuliaLean.base.int.sub x0 (JuliaLean.base.int.mul q x1)).val = wrapInt t (X0 - q.val * X1) := by
  change (JuliaLean.base.int.sub_int x0 (JuliaLean.base.int.mul_int q x1)).val = _
  rw [JuliaLean.Proofs.base.int.sub_int_val, JuliaLean.Proofs.base.int.mul_int_val, e0, e1,
    JuliaLean.Proofs.base.int.wrapInt_mul_right, JuliaLean.Proofs.base.int.wrapInt_sub_left,
    JuliaLean.Proofs.base.int.wrapInt_sub_right]

theorem G_step (t : IntTy) (C D : Int) (a b q r x0 x1 : JInt t)
    (hqr : a.val = q.val * b.val + r.val)
    (habs : a.val.natAbs = q.val.natAbs * b.val.natAbs + r.val.natAbs) (hb : b.val ≠ 0)
    (h : G t C D a b x0 x1) :
    G t C D b r x1 (JuliaLean.base.int.sub x0 (JuliaLean.base.int.mul q x1)) := by
  obtain ⟨X0, X1, e0, e1, d0, d1, h3, _, h5⟩ := h
  obtain ⟨n1, n2, n3⟩ := ghost_step C D a.val b.val q.val r.val X0 X1 hqr habs d0 d1 h3 h5
  exact ⟨X1, X0 - q.val * X1, e1, sub_mul_val t x0 q x1 X0 X1 e0 e1, d1, n1, n2, n3, Or.inr hb⟩

theorem div_facts (t : IntTy) (x y : JInt t) (hy : y.val ≠ 0)
    (hns : ¬ (t.signed = true ∧ x.val = t.min ∧ y.val = -1)) :
    (bitsOps t).divrem x y = .ok (JuliaLean.base.int.lit t (x.val.tdiv y.val),
      JuliaLean.base.int.lit t (x.val.tmod y.val)) ∧
    (JuliaLean.base.int.lit t (x.val.tdiv y.val)).val = x.val.tdiv y.val ∧
    (JuliaLean.base.int.lit t (x.val.tmod y.val)).val = x.val.tmod y.val := by
  refine ⟨?_, JuliaLean.Proofs.base.int.lit_of_fits (JuliaLean.Proofs.base.int.tdiv_fits x y hy hns),
    JuliaLean.Proofs.base.int.lit_of_fits (JuliaLean.Proofs.base.int.tmod_fits x y)⟩
  change divremBits x y = _
  unfold divremBits
  rw [JuliaLean.Proofs.base.int.divSame_eq,
    if_neg (by intro h; rcases h with h | h; exact hy h; exact hns h),
    JuliaLean.Proofs.base.int.remSame_eq, if_neg hy]
  rfl

/-- The Euclid loop of `gcdx` on a signed type keeps both ghost coefficient columns. -/
theorem gloop (t : IntTy) (ht : t.signed = true) (A B : Int) :
    ∀ (n : Nat) (a b s0 s1 t0 t1 : JInt t), b.val.natAbs < n →
      (b.val = -1 → a.val ≠ t.min) → (b.val = t.min → a.val ≠ -1) →
      (B ≠ 0 → G t A B a b s0 s1) → (A ≠ 0 → G t B A a b t0 t1) →
      ∃ a' s' t', gcdxLoop (bitsOps t) n a b s0 s1 t0 t1 = opusGcdx.finish (bitsOps t) a' s' t' ∧
        a'.val.natAbs = Nat.gcd a.val.natAbs b.val.natAbs ∧
        (B ≠ 0 → H t A B a' s') ∧ (A ≠ 0 → H t B A a' t') := by
  intro n
  induction n with
  | zero => intro a b s0 s1 t0 t1 h; omega
  | succ n ih =>
    intro a b s0 s1 t0 t1 hn h1 h2 hS hT
    by_cases hb : b.val = 0
    · refine ⟨a, s0, t0, ?_, ?_, ?_, ?_⟩
      · have hb' : (bitsOps t).value b = 0 := hb
        simp only [gcdxLoop, hb', if_true, opusGcdx.finish, Pure.pure, Except.pure]
      · rw [hb]; simp
      · intro hB
        obtain ⟨X0, X1, e0, _, d0, _, _, b0, _⟩ := hS hB
        exact ⟨X0, e0, d0, b0⟩
      · intro hA
        obtain ⟨X0, X1, e0, _, d0, _, _, b0, _⟩ := hT hA
        exact ⟨X0, e0, d0, b0⟩
    · have hns : ¬ (t.signed = true ∧ a.val = t.min ∧ b.val = -1) := fun h => h1 h.2.2 h.2.1
      obtain ⟨hqr, hq, hr⟩ := div_facts t a b hb hns
      have hexact : a.val = (JuliaLean.base.int.lit t (a.val.tdiv b.val)).val * b.val +
          (JuliaLean.base.int.lit t (a.val.tmod b.val)).val := by
        rw [hq, hr]; exact (Int.tdiv_mul_add_tmod a.val b.val).symm
      have habs : a.val.natAbs = (JuliaLean.base.int.lit t (a.val.tdiv b.val)).val.natAbs * b.val.natAbs +
          (JuliaLean.base.int.lit t (a.val.tmod b.val)).val.natAbs := by
        rw [hq, hr, Int.natAbs_tdiv, Int.natAbs_tmod, Nat.mul_comm]
        exact (Nat.div_add_mod _ _).symm
      have hrlt : (JuliaLean.base.int.lit t (a.val.tmod b.val)).val.natAbs < b.val.natAbs := by
        rw [hr, Int.natAbs_tmod]; exact Nat.mod_lt _ (by omega)
      have hrv := hr
      generalize JuliaLean.base.int.lit t (a.val.tdiv b.val) = q at hqr hexact habs
      generalize JuliaLean.base.int.lit t (a.val.tmod b.val) = r at hqr hexact habs hrlt hrv
      have hb' : ¬ (bitsOps t).value b = 0 := hb
      have hU : ∀ x0 x1 : JInt t, (if (bitsOps t).unsigned then gcdxUpdate_Unsigned (bitsOps t).sub
          (bitsOps t).mul else gcdxUpdate (bitsOps t).sub (bitsOps t).mul) x0 q x1 =
          JuliaLean.base.int.sub x0 (JuliaLean.base.int.mul q x1) := by
        intro x0 x1; split <;> rfl
      have hloop : gcdxLoop (bitsOps t) (n + 1) a b s0 s1 t0 t1 =
          gcdxLoop (bitsOps t) n b r s1 ((if (bitsOps t).unsigned then gcdxUpdate_Unsigned
            (bitsOps t).sub (bitsOps t).mul else gcdxUpdate (bitsOps t).sub (bitsOps t).mul) s0 q s1)
            t1 ((if (bitsOps t).unsigned then gcdxUpdate_Unsigned (bitsOps t).sub (bitsOps t).mul
            else gcdxUpdate (bitsOps t).sub (bitsOps t).mul) t0 q t1) := by
        simp only [gcdxLoop, hb', if_false, hqr, Bind.bind, Except.bind]
      rw [hU, hU] at hloop
      have hra := opusGcdx.val_range t a
      have hrb := opusGcdx.val_range t b
      have hm := opusGcdx.min_neg t ht
      have hr1 : r.val = -1 → b.val ≠ t.min := by
        intro hr1 hblo
        have ha1 := h2 hblo
        have hbt : a.val.tmod b.val = a.val.tmod t.min := by rw [hblo]
        rcases opusGcdx.tmod_self_or_small a.val t.min (by omega) hra.1 (hra.2.2.2 ht) with h | h <;>
          omega
      have hr2 : r.val = t.min → b.val ≠ -1 := by
        intro hrlo hb1
        rw [hb1] at hrlt; simp at hrlt; omega
      obtain ⟨a', s', t', hres, hg, hs, htt⟩ :=
        ih b r s1 (JuliaLean.base.int.sub s0 (JuliaLean.base.int.mul q s1))
          t1 (JuliaLean.base.int.sub t0 (JuliaLean.base.int.mul q t1)) (by omega) hr1 hr2
          (fun hB => G_step t A B a b q r s0 s1 hexact habs hb (hS hB))
          (fun hA => G_step t B A a b q r t0 t1 hexact habs hb (hT hA))
      refine ⟨a', s', t', hloop.trans hres, ?_, hs, htt⟩
      rw [hg, hrv, Int.natAbs_tmod, Nat.gcd_comm b.val.natAbs, ← Nat.gcd_rec, Nat.gcd_comm]

theorem min_dvd (t : IntTy) (ht : t.signed = true) : t.min ∣ (2 ^ t.bits : Int) := by
  cases t <;> simp [IntTy.signed] at ht <;> exact ⟨-2, by decide⟩

theorem H_out (t : IntTy) (ht : t.signed = true) (C D c : Int) (x : JInt t) (X : Int)
    (hx : x.val = wrapInt t X) (hd : D ∣ X * C - c) (hX : X.natAbs ≤ D.natAbs)
    (hD : t.min ≤ D ∧ D ≤ t.max) :
    D ∣ C * x.val - c ∧ x.val.natAbs ≤ D.natAbs := by
  have hm := opusGcdx.min_neg t ht
  have hxr := x.property
  by_cases hfit : (D.natAbs : Int) ≤ t.max
  · have hX' : t.min ≤ X ∧ X ≤ t.max := by omega
    rw [hx, wrapInt_of_inRange t X hX', Int.mul_comm]
    exact ⟨hd, hX⟩
  · have hDmin : D = t.min := by omega
    have hdvd : D ∣ (2 ^ t.bits : Int) := by rw [hDmin]; exact min_dvd t ht
    have hw : (2 ^ t.bits : Int) ∣ x.val - X := by rw [hx]; exact opusGcdx.wrap_dvd t X
    refine ⟨?_, by omega⟩
    have e : C * x.val - c = (X * C - c) + C * (x.val - X) := by grind
    rw [e]
    exact Int.dvd_add hd (Int.dvd_trans (Int.dvd_trans hdvd hw) (Int.dvd_mul_left _ _))

theorem H_out_neg (t : IntTy) (ht : t.signed = true) (C D : Int) (a x : JInt t)
    (h : H t C D a x) (hD : t.min ≤ D ∧ D ≤ t.max) :
    D ∣ C * (JuliaLean.base.int.neg x).val - (-a.val) ∧
      (JuliaLean.base.int.neg x).val.natAbs ≤ D.natAbs := by
  obtain ⟨X, hx, hd, hX⟩ := h
  apply H_out t ht C D (-a.val) (JuliaLean.base.int.neg x) (-X)
  · change (JuliaLean.base.int.neg_int x).val = _
    rw [JuliaLean.Proofs.base.int.neg_int_val, hx, JuliaLean.Proofs.base.int.wrapInt_neg]
  · have e : -X * C - -a.val = -(X * C - a.val) := by grind
    rw [e]; exact Int.dvd_neg.mpr hd
  · omega
  · exact hD

theorem dvd_pm1 (x y : Int) (h : x.natAbs = 1) : x ∣ y := by
  have : x = 1 ∨ x = -1 := by omega
  rcases this with h | h <;> rw [h] <;> simp

/-- `gcdx` on a signed type: exact gcd, and each coefficient is an inverse modulo the other
argument with magnitude at most that argument. -/
theorem gcdx_inv (t : IntTy) (ht : t.signed = true) (a b : JInt t)
    (hfit : fits t (gcdMath a.val b.val)) :
    ∃ d u v, gcdxBits a b = .ok (d, u, v) ∧ d.val = gcdMath a.val b.val ∧
      (b.val ≠ 0 → b.val ∣ a.val * u.val - d.val ∧ u.val.natAbs ≤ b.val.natAbs) ∧
      (a.val ≠ 0 → a.val ∣ b.val * v.val - d.val ∧ v.val.natAbs ≤ a.val.natAbs) := by
  have hl := opusGcdx.lit01 t
  unfold gcdxBits gcdx_Integer
  by_cases h00 : (bitsOps t).value a = 0 ∧ (bitsOps t).value b = 0
  · have ha : a.val = 0 := h00.1
    have hb : b.val = 0 := h00.2
    rw [if_pos h00]
    refine ⟨_, _, _, rfl, ?_, fun h => absurd hb h, fun h => absurd ha h⟩
    change (JuliaLean.base.int.lit t 0).val = _
    rw [hl.1]; simp [gcdMath, ha, hb]
  rw [if_neg h00]
  have hnz : ¬ (a.val = 0 ∧ b.val = 0) := h00
  by_cases hb1 : (bitsOps t).value ((bitsOps t).abs b) = 1
  · have hb1' : b.val.natAbs = 1 := (opusGcdx.abs_one_iff t b).mp hb1
    rw [if_pos hb1]
    refine ⟨_, _, _, rfl, ?_, ?_, ?_⟩
    · change (JuliaLean.base.int.lit t 1).val = _
      rw [hl.2]; simp [gcdMath, hb1']
    · intro _
      change b.val ∣ a.val * (JuliaLean.base.int.lit t 0).val - (JuliaLean.base.int.lit t 1).val ∧
        (JuliaLean.base.int.lit t 0).val.natAbs ≤ _
      rw [hl.1, hl.2]
      exact ⟨dvd_pm1 _ _ hb1', by simp⟩
    · intro ha
      change a.val ∣ b.val * b.val - (JuliaLean.base.int.lit t 1).val ∧ b.val.natAbs ≤ a.val.natAbs
      rw [hl.2]
      have hbb : b.val * b.val = 1 := by
        have : b.val = 1 ∨ b.val = -1 := by omega
        rcases this with h | h <;> rw [h] <;> decide
      rw [hbb]
      exact ⟨by simp, by omega⟩
  rw [if_neg hb1]
  have hb1n : b.val ≠ -1 := by
    intro h; apply hb1; exact (opusGcdx.abs_one_iff t b).mpr (by rw [h]; rfl)
  by_cases ha1 : (bitsOps t).value ((bitsOps t).abs a) = 1
  · have ha1' : a.val.natAbs = 1 := (opusGcdx.abs_one_iff t a).mp ha1
    rw [if_pos ha1]
    refine ⟨_, _, _, rfl, ?_, ?_, ?_⟩
    · change (JuliaLean.base.int.lit t 1).val = _
      rw [hl.2]; simp [gcdMath, ha1']
    · intro hb
      change b.val ∣ a.val * a.val - (JuliaLean.base.int.lit t 1).val ∧ a.val.natAbs ≤ b.val.natAbs
      rw [hl.2]
      have haa : a.val * a.val = 1 := by
        have : a.val = 1 ∨ a.val = -1 := by omega
        rcases this with h | h <;> rw [h] <;> decide
      rw [haa]
      exact ⟨by simp, by omega⟩
    · intro _
      change a.val ∣ b.val * (JuliaLean.base.int.lit t 0).val - (JuliaLean.base.int.lit t 1).val ∧
        (JuliaLean.base.int.lit t 0).val.natAbs ≤ _
      rw [hl.1, hl.2]
      exact ⟨dvd_pm1 _ _ ha1', by simp⟩
  rw [if_neg ha1]
  have ha1n : a.val ≠ -1 := by
    intro h; apply ha1; exact (opusGcdx.abs_one_iff t a).mpr (by rw [h]; rfl)
  have hra := opusGcdx.val_range t a
  have hrb := opusGcdx.val_range t b
  have hm := opusGcdx.min_neg t ht
  obtain ⟨a', s', t', hres, hg, hS, hT⟩ := gloop t ht a.val b.val (magnitude (bitsOps t) b + 1) a b
    (JuliaLean.base.int.lit t 1) (JuliaLean.base.int.lit t 0) (JuliaLean.base.int.lit t 0)
    (JuliaLean.base.int.lit t 1)
    (by unfold magnitude; change b.val.natAbs < b.val.natAbs + 1; omega)
    (fun h => absurd h hb1n) (fun _ => ha1n)
    (fun hB => ⟨1, 0, rfl, rfl, by simp, by simp, by simp, by simp; omega, Or.inl (by simp)⟩)
    (fun hA => ⟨0, 1, rfl, rfl, by simp, by simp, by simp, by simp, Or.inl (by simp; omega)⟩)
  have hgm : gcdMath a.val b.val = (a'.val.natAbs : Int) := by unfold gcdMath; rw [hg]
  have hr := opusGcdx.val_range t a'
  have habs := JuliaLean.Proofs.base.int.abs_val a'
  have hof : ∀ z, (bitsOps t).ofInt z = JuliaLean.base.int.lit t z := fun _ => rfl
  rw [hof, hof, hres]
  unfold opusGcdx.finish
  have hv : ∀ x : JInt t, (bitsOps t).value x = x.val := fun _ => rfl
  have hab : (bitsOps t).abs a' = JuliaLean.base.int.abs a' := rfl
  have hng : ∀ x : JInt t, (bitsOps t).neg x = JuliaLean.base.int.neg x := fun _ => rfl
  simp only [hv, hab, hng]
  have hmin : ¬ (t.signed = true ∧ a'.val = t.min) := by
    intro h
    rw [hgm] at hfit; unfold fits at hfit; omega
  rw [if_neg hmin] at habs
  rw [if_neg (by omega)]
  have hAr : t.min ≤ a.val ∧ a.val ≤ t.max := ⟨hra.1, hra.2.1⟩
  have hBr : t.min ≤ b.val ∧ b.val ≤ t.max := ⟨hrb.1, hrb.2.1⟩
  by_cases hneg : a'.val < 0
  · rw [if_pos hneg]
    refine ⟨_, _, _, rfl, by rw [habs, hgm], ?_, ?_⟩
    · intro hB
      have := H_out_neg t ht a.val b.val a' s' (hS hB) hBr
      rw [habs, show ((a'.val.natAbs : Nat) : Int) = -a'.val by omega]; exact this
    · intro hA
      have := H_out_neg t ht b.val a.val a' t' (hT hA) hAr
      rw [habs, show ((a'.val.natAbs : Nat) : Int) = -a'.val by omega]; exact this
  · rw [if_neg hneg]
    refine ⟨_, _, _, rfl, by rw [hgm]; omega, ?_, ?_⟩
    · intro hB
      obtain ⟨X, hx, hd, hX⟩ := hS hB
      exact H_out t ht a.val b.val a'.val s' X hx hd hX hBr
    · intro hA
      obtain ⟨X, hx, hd, hX⟩ := hT hA
      exact H_out t ht b.val a.val a'.val t' X hx hd hX hAr

theorem de_bind {A B : Type} (x : Jl A) (f : A → Jl B) (h : domainError x) :
    domainError (x >>= f) := by
  cases x with
  | ok _ => exact absurd h id
  | error e => cases e <;> exact h

theorem de_msg {A : Type} (x : Jl A) (h : domainError x) : ∃ msg, x = .error (.domainError msg) := by
  cases x with
  | ok _ => exact absurd h id
  | error e => cases e <;> first | exact ⟨_, rfl⟩ | exact absurd h id

/-- `gcdx(::Signed, ::Unsigned)` with a signed promotion type: exact inverse coefficients. -/
theorem su_inv (r S U : IntTy) (hR : opusMixed.MixedFacts r S U) (hrs : r.signed = true)
    (a : JInt S) (b : JInt U) :
    (fits r (gcdMath a.val b.val) → ∃ d u v, gcdx_Signed_Unsigned (promoteMixedTo r) gcdxBits
        (fun x => decide (x.val < 0)) r.signed JuliaLean.base.int.subWrap (JuliaLean.base.int.ofBool S)
        (fun u sign => if sign.val < 0 then JuliaLean.base.int.neg u else u) a b = .ok (d, u, v) ∧
      d.val = gcdMath a.val b.val ∧
      (b.val ≠ 0 → b.val ∣ a.val * u.val - d.val) ∧ (a.val ≠ 0 → a.val ∣ b.val * v.val - d.val)) ∧
    (¬ fits r (gcdMath a.val b.val) → domainError (gcdx_Signed_Unsigned (promoteMixedTo r) gcdxBits
        (fun x => decide (x.val < 0)) r.signed JuliaLean.base.int.subWrap (JuliaLean.base.int.ofBool S)
        (fun u sign => if sign.val < 0 then JuliaLean.base.int.neg u else u) a b)) := by
  obtain ⟨hR1, hR2, hR3, hR4, hR5, hR6, hR7, hR8, hR9, hR10, hR11, hR12, hR13, hR14, hR15⟩ := hR
  have ha := a.property
  have hb := b.property
  have hr2 := hR2 hrs
  have hrem : (JuliaLean.base.int.remT r.toSigned a).val = a.val := by
    rw [JuliaLean.Proofs.base.int.remT_val]
    exact wrapInt_of_inRange _ _ ⟨by omega, by omega⟩
  have hfb : r.min ≤ b.val ∧ b.val ≤ r.max := ⟨by omega, by omega⟩
  by_cases hk : 0 ≤ a.val ∨ a.val = S.min
  · have habs : (JuliaLean.base.int.abs (JuliaLean.base.int.remT r.toSigned a)).val = a.val := by
      rw [JuliaLean.Proofs.base.int.abs_val, hrem]
      rcases hk with hk | hk
      · split <;> omega
      · have := hR10.mpr (by have := hR1.mp hrs; omega)
        rw [if_pos ⟨hR7, by omega⟩]; omega
    have hfa : r.min ≤ (JuliaLean.base.int.abs (JuliaLean.base.int.remT r.toSigned a)).val ∧
        (JuliaLean.base.int.abs (JuliaLean.base.int.remT r.toSigned a)).val ≤ r.max := by
      rw [habs]; omega
    have hg' : gcdMath (⟨_, hfa⟩ : JInt r).val (⟨_, hfb⟩ : JInt r).val = gcdMath a.val b.val :=
      opusMixed.gcdMath_natAbs_left _ _ _ (by simp only [habs])
    have hsign : ¬ (JuliaLean.base.int.subWrap a (JuliaLean.base.int.ofBool S
        (decide (a.val < 0) && r.signed))).val < 0 := by
      show ¬ (JuliaLean.base.int.sub_int _ _).val < 0
      rw [JuliaLean.Proofs.base.int.sub_int_val]
      rcases hk with hk | hk
      · have : (decide (a.val < 0) && r.signed) = false := by simp; omega
        rw [this, hR15, Int.sub_zero, JuliaLean.Proofs.base.int.wrapInt_val]; omega
      · have : (decide (a.val < 0) && r.signed) = true := by simp [hrs]; omega
        rw [this, hR14, hk, hR13]; omega
    constructor
    · intro hfit
      obtain ⟨d, u, v, hres, hd, hu, hv⟩ := gcdx_inv r hrs ⟨_, hfa⟩ ⟨_, hfb⟩ (by rw [hg']; exact hfit)
      refine ⟨d, u, v, ?_, by rw [hd, hg'], ?_, ?_⟩
      · unfold gcdx_Signed_Unsigned promoteMixedTo promoteMixedSigns
        simp only [opusMixed.convert_ok r _ hfa, opusMixed.convert_ok r _ hfb, Bind.bind, Except.bind,
          Pure.pure, Except.pure]
        rw [hres]
        simp only [hsign, if_false]
      · intro hb0
        have := (hu hb0).1
        simp only [habs] at this
        exact this
      · intro ha0
        have := (hv (by show (JuliaLean.base.int.abs (JuliaLean.base.int.remT r.toSigned a)).val ≠ 0
                        rw [habs]; exact ha0)).1
        simp only [habs] at this
        exact this
    · intro hnf
      have hB := opusGcdx.gcdxBezout_bits r ⟨_, hfa⟩ ⟨_, hfb⟩
      rw [hg', if_neg hnf] at hB
      obtain ⟨msg, hmsg⟩ := de_msg _ hB
      unfold gcdx_Signed_Unsigned promoteMixedTo promoteMixedSigns
      simp only [opusMixed.convert_ok r _ hfa, opusMixed.convert_ok r _ hfb, Bind.bind, Except.bind,
        Pure.pure, Except.pure]
      rw [hmsg]; trivial
  · have hneg : a.val < 0 := by omega
    have hnm : a.val ≠ S.min := by omega
    have hne : a.val ≠ r.toSigned.min := by omega
    have habs : (JuliaLean.base.int.abs (JuliaLean.base.int.remT r.toSigned a)).val = -a.val := by
      rw [JuliaLean.Proofs.base.int.abs_val, hrem, if_neg (by intro h; exact hne h.2)]; omega
    have hfa : r.min ≤ (JuliaLean.base.int.abs (JuliaLean.base.int.remT r.toSigned a)).val ∧
        (JuliaLean.base.int.abs (JuliaLean.base.int.remT r.toSigned a)).val ≤ r.max := by
      rw [habs]; omega
    have hg' : gcdMath (⟨_, hfa⟩ : JInt r).val (⟨_, hfb⟩ : JInt r).val = gcdMath a.val b.val :=
      opusMixed.gcdMath_natAbs_left _ _ _ (by simp only [habs]; omega)
    have hsign : (JuliaLean.base.int.subWrap a (JuliaLean.base.int.ofBool S
        (decide (a.val < 0) && r.signed))).val < 0 := by
      show (JuliaLean.base.int.sub_int _ _).val < 0
      rw [JuliaLean.Proofs.base.int.sub_int_val]
      have : (decide (a.val < 0) && r.signed) = true := by simp [hrs, hneg]
      rw [this, hR14, wrapInt_of_inRange _ _ ⟨by omega, by omega⟩]; omega
    constructor
    · intro hfit
      obtain ⟨d, u, v, hres, hd, hu, hv⟩ := gcdx_inv r hrs ⟨_, hfa⟩ ⟨_, hfb⟩ (by rw [hg']; exact hfit)
      refine ⟨d, JuliaLean.base.int.neg u, v, ?_, by rw [hd, hg'], ?_, ?_⟩
      · unfold gcdx_Signed_Unsigned promoteMixedTo promoteMixedSigns
        simp only [opusMixed.convert_ok r _ hfa, opusMixed.convert_ok r _ hfb, Bind.bind, Except.bind,
          Pure.pure, Except.pure]
        rw [hres]
        simp only [hsign, if_true]
      · intro hb0
        obtain ⟨hdv, hbd⟩ := hu hb0
        simp only [habs] at hdv hbd
        have hur := u.property
        have hnv : (JuliaLean.base.int.neg u).val = -u.val := by
          change (JuliaLean.base.int.neg_int u).val = _
          rw [JuliaLean.Proofs.base.int.neg_int_val]
          exact wrapInt_of_inRange _ _ ⟨by omega, by omega⟩
        rw [hnv, Int.mul_neg, ← Int.neg_mul]
        exact hdv
      · intro ha0
        have := (hv (by show (JuliaLean.base.int.abs (JuliaLean.base.int.remT r.toSigned a)).val ≠ 0
                        rw [habs]; omega)).1
        simp only [habs] at this
        exact Int.neg_dvd.mp this
    · intro hnf
      have hB := opusGcdx.gcdxBezout_bits r ⟨_, hfa⟩ ⟨_, hfb⟩
      rw [hg', if_neg hnf] at hB
      obtain ⟨msg, hmsg⟩ := de_msg _ hB
      unfold gcdx_Signed_Unsigned promoteMixedTo promoteMixedSigns
      simp only [opusMixed.convert_ok r _ hfa, opusMixed.convert_ok r _ hfb, Bind.bind, Except.bind,
        Pure.pure, Except.pure]
      rw [hmsg]; trivial

/-- Mixed-type `gcdx` with a signed promotion type: the first coefficient inverts `n` modulo `m`. -/
theorem mixed_inv (s t : IntTy) (n : JInt s) (m : JInt t) (hr : (s.promote t).signed = true)
    (hm : m.val ≠ 0) :
    (fits (s.promote t) (gcdMath n.val m.val) → ∃ d u v, gcdxMixedBits n m = .ok (d, u, v) ∧
      d.val = gcdMath n.val m.val ∧ m.val ∣ n.val * u.val - d.val) ∧
    (¬ fits (s.promote t) (gcdMath n.val m.val) → domainError (gcdxMixedBits n m)) := by
  have hcomm : gcdMath m.val n.val = gcdMath n.val m.val := by unfold gcdMath; rw [Nat.gcd_comm]
  unfold gcdxMixedBits
  cases hs : s.signed <;> cases ht : t.signed
  · exfalso; revert hr hs ht; cases s <;> cases t <;> decide
  · simp only [Bool.false_and, Bool.not_false, Bool.true_and, Bool.not_true, Bool.false_eq_true,
      if_false, if_true]
    have H := su_inv (s.promote t) t s (opusMixed.mixedFacts_right s t hs ht) hr m n
    rw [hcomm] at H
    constructor
    · intro hfit
      obtain ⟨d, x1, x2, hres, hd, _, hdv⟩ := H.1 hfit
      refine ⟨d, x2, x1, ?_, hd, hdv hm⟩
      unfold gcdx_Unsigned_Signed
      rw [hres]; rfl
    · intro hnf
      obtain ⟨msg, hmsg⟩ := de_msg _ (H.2 hnf)
      unfold gcdx_Unsigned_Signed
      rw [hmsg]; trivial
  · simp only [Bool.true_and, Bool.not_false, if_true]
    have H := su_inv (s.promote t) s t (opusMixed.mixedFacts_left s t hs ht) hr n m
    constructor
    · intro hfit
      obtain ⟨d, u, v, hres, hd, hdu, _⟩ := H.1 hfit
      exact ⟨d, u, v, hres, hd, hdu hm⟩
    · exact H.2
  · simp only [Bool.true_and, Bool.not_true, Bool.false_eq_true, if_false, Bool.false_and]
    have hf := opusMixed.sameFacts s t (by rw [hs, ht])
    have ha := n.property
    have hb := m.property
    have hfa : (s.promote t).min ≤ n.val ∧ n.val ≤ (s.promote t).max := ⟨by omega, by omega⟩
    have hfb : (s.promote t).min ≤ m.val ∧ m.val ≤ (s.promote t).max := ⟨by omega, by omega⟩
    constructor
    · intro hfit
      obtain ⟨d, u, v, hres, hd, hu, _⟩ := gcdx_inv (s.promote t) hr ⟨_, hfa⟩ ⟨_, hfb⟩ hfit
      refine ⟨d, u, v, ?_, hd, (hu hm).1⟩
      unfold gcdx_Real promoteBits
      simp only [opusMixed.convert_ok _ _ hfa, opusMixed.convert_ok _ _ hfb, Bind.bind, Except.bind,
        Pure.pure, Except.pure]
      exact hres
    · intro hnf
      have hB := opusGcdx.gcdxBezout_bits (s.promote t) ⟨_, hfa⟩ ⟨_, hfb⟩
      simp only at hB
      rw [if_neg hnf] at hB
      unfold gcdx_Real promoteBits
      simp only [opusMixed.convert_ok _ _ hfa, opusMixed.convert_ok _ _ hfb, Bind.bind, Except.bind,
        Pure.pure, Except.pure]
      exact hB

theorem bezoutMixed_spec (s t : IntTy) (n : JInt s) (m : JInt t) (hr : (s.promote t).signed = true)
    (hm : m.val ≠ 0) :
    (gcdMath n.val m.val = 1 → ∃ u : JInt (s.promote t),
      bezoutCoef gcdxMixedBits (fun g : JInt (s.promote t) => decide (g.val = 1)) n m = .ok u ∧
      m.val ∣ n.val * u.val - 1) ∧
    (gcdMath n.val m.val ≠ 1 →
      domainError (bezoutCoef gcdxMixedBits (fun g : JInt (s.promote t) => decide (g.val = 1)) n m)) := by
  have H := mixed_inv s t n m hr hm
  constructor
  · intro h1
    obtain ⟨d, u, v, hres, hd, hdv⟩ := H.1 (by rw [h1]; exact (opusGcdx.fits01 _).2)
    refine ⟨u, ?_, by rw [hd, h1] at hdv; exact hdv⟩
    simp only [bezoutCoef, hres, Bind.bind, Except.bind, hd, h1, decide_true, Bool.not_true,
      Bool.false_eq_true, if_false, Pure.pure, Except.pure]
  · intro h1
    by_cases hf : fits (s.promote t) (gcdMath n.val m.val)
    · obtain ⟨d, u, v, hres, hd, _⟩ := H.1 hf
      simp only [bezoutCoef, hres, Bind.bind, Except.bind, hd, h1, decide_false, Bool.not_false,
        if_true]
      trivial
    · unfold bezoutCoef
      exact de_bind _ _ (H.2 hf)

theorem bezoutBits_spec (t : IntTy) (ht : t.signed = true) (a b : JInt t) (hb : b.val ≠ 0) :
    (gcdMath a.val b.val = 1 → ∃ u : JInt t,
      bezoutCoef gcdxBits (fun g : JInt t => decide (g.val = 1)) a b = .ok u ∧
      b.val ∣ a.val * u.val - 1 ∧ u.val.natAbs ≤ b.val.natAbs) ∧
    (gcdMath a.val b.val ≠ 1 →
      domainError (bezoutCoef gcdxBits (fun g : JInt t => decide (g.val = 1)) a b)) := by
  constructor
  · intro h1
    obtain ⟨d, u, v, hres, hd, hu, _⟩ := gcdx_inv t ht a b (by rw [h1]; exact (opusGcdx.fits01 t).2)
    have hu' := hu hb
    rw [hd, h1] at hu'
    refine ⟨u, ?_, hu'⟩
    simp only [bezoutCoef, hres, Bind.bind, Except.bind, hd, h1, decide_true, Bool.not_true,
      Bool.false_eq_true, if_false, Pure.pure, Except.pure]
  · intro h1
    by_cases hf : fits t (gcdMath a.val b.val)
    · obtain ⟨d, u, v, hres, hd, _⟩ := gcdx_inv t ht a b hf
      simp only [bezoutCoef, hres, Bind.bind, Except.bind, hd, h1, decide_false, Bool.not_false,
        if_true]
      trivial
    · have hB := opusGcdx.gcdxBezout_bits t a b
      rw [if_neg hf] at hB
      unfold bezoutCoef
      exact de_bind _ _ hB

theorem bezoutBig_spec (g : approvedRound2.Concrete.GmpPrimitives) (hg : approvedRound2.Concrete.GmpDocs g)
    (a b : Int) :
    (gcdMath a b = 1 → ∃ u : Int, bezoutCoef g.gcdx (fun d : Int => decide (d = 1)) a b = .ok u ∧
      b ∣ a * u - 1) ∧
    (gcdMath a b ≠ 1 → domainError (bezoutCoef g.gcdx (fun d : Int => decide (d = 1)) a b)) := by
  obtain ⟨d, u, v, hres, hd, hbez⟩ := hg.1 a b
  have hd' : d = gcdMath a b := hd
  constructor
  · intro h1
    refine ⟨u, ?_, ⟨-v, ?_⟩⟩
    · simp only [bezoutCoef, hres, Bind.bind, Except.bind, hd', h1, decide_true, Bool.not_true,
        Bool.false_eq_true, if_false, Pure.pure, Except.pure]
    · rw [Int.mul_neg]; rw [hd', h1] at hbez; omega
  · intro h1
    simp only [bezoutCoef, hres, Bind.bind, Except.bind, hd', h1, decide_false, Bool.not_false, if_true]
    trivial

theorem finish_inv (n m F u : Int) (hm : m ≠ 0) (hu : m ∣ n * u - 1) (hF : m ∣ F - u) :
    ModInverse n m (fmod F m) := by
  have h : m ∣ n * F - 1 := by
    have e : n * F - 1 = (n * u - 1) + n * (F - u) := by grind
    rw [e]; exact Int.dvd_add hu (Int.dvd_trans hF (Int.dvd_mul_left _ _))
  obtain ⟨k, hk⟩ := h
  rw [opusModMixed.fmod_spec_eq F m hm]
  exact opusInvmod.fmod_inverse n m F (-k) hm (by rw [Int.mul_neg]; omega)

theorem ufacts (s t : IntTy) (hr : (s.promote t).signed = false) :
    (s.promote t).toSigned.signed = true ∧ (s.promote t).toSigned.bits = (s.promote t).bits ∧
    (s.promote t).min = 0 ∧ (s.promote t).toSigned.min = -(s.promote t).toSigned.max - 1 ∧
    (s.promote t).max = 2 * (s.promote t).toSigned.max + 1 ∧
    (s.promote t).toSigned.min ≤ s.min ∧ s.max ≤ (s.promote t).max ∧
    (s.promote t).toSigned.min ≤ t.min ∧ t.max ≤ (s.promote t).max ∧
    (t.signed = true → t.max ≤ (s.promote t).toSigned.max ∧ t.min = -t.max - 1 ∧
      t.min ∣ (2 ^ (s.promote t).bits : Int)) ∧
    (t.signed = false → t.min = 0) := by
  revert hr; cases s <;> cases t <;> decide

theorem widen_none (s t : IntTy) (hr : (s.promote t).signed = false) (h : (s.promote t).bits = 128) :
    JuliaLean.base.int.widenType (s.promote t).toSigned = none := by
  revert hr h; cases s <;> cases t <;> decide

theorem widen_some' (s t : IntTy) (hr : (s.promote t).signed = false) (h : (s.promote t).bits ≠ 128) :
    ∃ w, JuliaLean.base.int.widenType (s.promote t).toSigned = some w ∧ w.signed = true ∧
      w.min ≤ (s.promote t).toSigned.min ∧ (s.promote t).max ≤ w.max := by
  revert hr h; cases s <;> cases t <;> decide

theorem lit_lit (r st : IntTy) (z : Int) :
    (JuliaLean.base.int.lit r (JuliaLean.base.int.remT r (JuliaLean.base.int.lit st z)).val).val =
      wrapInt r (wrapInt st z) := by
  rw [JuliaLean.Proofs.base.int.lit_val, JuliaLean.Proofs.base.int.remT_val,
    JuliaLean.Proofs.base.int.lit_val, JuliaLean.Proofs.base.int.wrapInt_wrapInt]

/-- `invmod(n, m)` at every pair of fixed widths. -/
theorem invmod_all (g : approvedRound2.Concrete.GmpPrimitives) (hg : approvedRound2.Concrete.GmpDocs g)
    (s t : IntTy) (n : JInt s) (m : JInt t) :
    InverseResult n.val m.val (invmodBits (approvedRound2.Concrete.numberCallees g) n m) := by
  have hmod : ∀ {a : IntTy} (x : JInt a), m.val ≠ 0 →
      (approvedRound2.Concrete.numberCallees g).mixedMod x m = .ok (fmod x.val m.val) := by
    intro a x hm
    show approvedRound2.Concrete.modMixed x m = _
    rw [opusPowInst.modMixed_all, if_neg hm]
  unfold InverseResult
  by_cases hm0 : m.val = 0
  · rw [if_pos (Or.inl hm0)]
    have : invmodBits (approvedRound2.Concrete.numberCallees g) n m = .error (.domainError "") := by
      unfold invmodBits invmod_Integer; simp [hm0]
    rw [this]; trivial
  suffices hX : (gcdMath n.val m.val = 1 → ∃ y,
      invmodBits (approvedRound2.Concrete.numberCallees g) n m = .ok y ∧ ModInverse n.val m.val y) ∧
      (gcdMath n.val m.val ≠ 1 → domainError (invmodBits (approvedRound2.Concrete.numberCallees g) n m)) by
    by_cases h1 : gcdMath n.val m.val = 1
    · rw [if_neg (by omega)]; exact hX.1 h1
    · rw [if_pos (Or.inr h1)]; exact hX.2 h1
  have hnr := n.property
  have hmr := m.property
  unfold invmodBits invmod_Integer
  simp only [hm0, decide_false, Bool.false_eq_true, if_false]
  cases hr : (s.promote t).signed
  · obtain ⟨hst, hbits, hr0, hstm, hrmax, hsmin, hsmax, htmin, htmax, htsg, htun⟩ := ufacts s t hr
    simp only [Bool.false_eq_true, if_false, hasTypeMax, Bool.and_self, Bool.not_true, Bool.false_or,
      Bool.and_eq_true, decide_eq_true_eq]
    split
    · rename_i hf2
      have hN : (JuliaLean.base.int.remT (s.promote t).toSigned n).val = n.val := by
        rw [JuliaLean.Proofs.base.int.remT_val]
        exact wrapInt_of_inRange _ _ ⟨by omega, by omega⟩
      have hM : (JuliaLean.base.int.remT (s.promote t).toSigned m).val = m.val := by
        rw [JuliaLean.Proofs.base.int.remT_val]
        exact wrapInt_of_inRange _ _ ⟨by omega, by omega⟩
      have H := bezoutBits_spec (s.promote t).toSigned hst
        (JuliaLean.base.int.remT (s.promote t).toSigned n) (JuliaLean.base.int.remT (s.promote t).toSigned m)
        (by rw [hM]; exact hm0)
      rw [hN, hM] at H
      constructor
      · intro h1
        obtain ⟨u, hres, hdv, hbd⟩ := H.1 h1
        rw [hres]
        simp only [Bind.bind, Except.bind]
        have hur := u.property
        by_cases hneg : u.val < 0
        · simp only [hneg, decide_true, if_true]
          rw [hmod _ hm0]
          refine ⟨_, rfl, finish_inv _ _ _ u.val hm0 hdv ?_⟩
          rw [lit_lit]
          by_cases hmin : t.signed = true ∧ m.val = t.min
          · have hab : (JuliaLean.base.int.abs m).val = m.val := by
              rw [JuliaLean.Proofs.base.int.abs_val, if_pos hmin, hmin.2]
            rw [hab]
            have hdv2 : m.val ∣ (2 ^ (s.promote t).bits : Int) := by rw [hmin.2]; exact (htsg hmin.1).2.2
            have w1 := opusGcdx.wrap_dvd (s.promote t) (wrapInt (s.promote t).toSigned (u.val + m.val))
            have w2 := opusGcdx.wrap_dvd (s.promote t).toSigned (u.val + m.val)
            rw [hbits] at w2
            have e : wrapInt (s.promote t) (wrapInt (s.promote t).toSigned (u.val + m.val)) - u.val =
                (wrapInt (s.promote t) (wrapInt (s.promote t).toSigned (u.val + m.val)) -
                  wrapInt (s.promote t).toSigned (u.val + m.val)) +
                (wrapInt (s.promote t).toSigned (u.val + m.val) - (u.val + m.val)) + m.val := by omega
            rw [e]
            exact Int.dvd_add (Int.dvd_add (Int.dvd_trans hdv2 w1) (Int.dvd_trans hdv2 w2)) (Int.dvd_refl _)
          · have hab : (JuliaLean.base.int.abs m).val = (m.val.natAbs : Int) := by
              rw [JuliaLean.Proofs.base.int.abs_val, if_neg hmin]
            rw [hab]
            have hmle : (m.val.natAbs : Int) ≤ (s.promote t).toSigned.max := by
              by_cases hts : t.signed = true
              · have := htsg hts
                have : m.val ≠ t.min := fun h => hmin ⟨hts, h⟩
                omega
              · have := htun (by simpa using hts); omega
            rw [wrapInt_of_inRange (s.promote t).toSigned (u.val + (m.val.natAbs : Int)) ⟨by omega, by omega⟩,
              wrapInt_of_inRange (s.promote t) (u.val + (m.val.natAbs : Int)) ⟨by omega, by omega⟩]
            rw [show u.val + (m.val.natAbs : Int) - u.val = (m.val.natAbs : Int) by omega]
            exact Int.dvd_natAbs.mpr (Int.dvd_refl _)
        · simp only [hneg, decide_false, Bool.false_eq_true, if_false]
          rw [hmod _ hm0]
          refine ⟨_, rfl, finish_inv _ _ _ u.val hm0 hdv ?_⟩
          rw [JuliaLean.Proofs.base.int.lit_val, JuliaLean.Proofs.base.int.remT_val,
            JuliaLean.Proofs.base.int.wrapInt_wrapInt, wrapInt_of_inRange _ _ ⟨by omega, by omega⟩]
          simp
      · intro h1
        exact de_bind _ _ (H.2 h1)
    · rename_i hf2
      by_cases h128 : (s.promote t).bits = 128
      · have hW := widen_none s t hr h128
        simp only [hW, workValue, bezoutWork, workMod]
        have H := bezoutBig_spec g hg n.val m.val
        constructor
        · intro h1
          obtain ⟨u, hres, hdv⟩ := H.1 h1
          have hres' : bezoutCoef (approvedRound2.Concrete.numberCallees g).gmpGcdx
              (fun d : Int => decide (d = 1)) n.val m.val = .ok u := hres
          rw [hres']
          simp only [Bind.bind, Except.bind, hm0, if_false, Pure.pure, Except.pure]
          have hb1 := Int.emod_nonneg u hm0
          have hb2 := Int.emod_lt u hm0
          have hed := Int.emod_def u m.val
          by_cases hneg : m.val < 0
          · simp only [hneg, decide_true, if_true]
            rw [hmod _ hm0]
            refine ⟨_, rfl, finish_inv _ _ _ u hm0 hdv ?_⟩
            rw [JuliaLean.Proofs.base.int.lit_val, JuliaLean.Proofs.base.int.lit_val,
              JuliaLean.Proofs.base.int.wrapInt_wrapInt]
            have := htsg (by cases hts : t.signed <;> simp_all <;> omega)
            rw [wrapInt_of_inRange _ _ ⟨by omega, by omega⟩]
            exact ⟨-(u / m.val) - 1, by rw [Int.mul_sub, Int.mul_neg, Int.mul_one]; omega⟩
          · simp only [hneg, decide_false, Bool.false_eq_true, if_false]
            rw [hmod _ hm0]
            refine ⟨_, rfl, finish_inv _ _ _ u hm0 hdv ?_⟩
            rw [JuliaLean.Proofs.base.int.lit_val, JuliaLean.Proofs.base.int.lit_val,
              JuliaLean.Proofs.base.int.wrapInt_wrapInt]
            rw [wrapInt_of_inRange _ _ ⟨by omega, by omega⟩]
            exact ⟨-(u / m.val), by rw [Int.mul_neg]; omega⟩
        · intro h1
          have h2 : domainError (bezoutCoef (approvedRound2.Concrete.numberCallees g).gmpGcdx
              (fun d : Int => decide (d = 1)) n.val m.val) := H.2 h1
          exact de_bind _ _ h2
      · obtain ⟨w, hW, hws, hwmin, hwmax⟩ := widen_some' s t hr h128
        have hwm := opusGcdx.min_neg w hws
        have hNw : (JuliaLean.base.int.lit w n.val).val = n.val :=
          JuliaLean.Proofs.base.int.lit_of_fits ⟨by omega, by omega⟩
        have hMw : (JuliaLean.base.int.lit w m.val).val = m.val :=
          JuliaLean.Proofs.base.int.lit_of_fits ⟨by omega, by omega⟩
        simp only [hW, workValue, bezoutWork, workMod, hNw, hMw]
        have H := bezoutBits_spec w hws (JuliaLean.base.int.lit w n.val) (JuliaLean.base.int.lit w m.val)
          (by rw [hMw]; exact hm0)
        rw [hNw, hMw] at H
        constructor
        · intro h1
          obtain ⟨u, hres, hdv, hbd⟩ := H.1 h1
          rw [hres]
          have huw : JuliaLean.base.int.lit w u.val = u := Subtype.ext (by
            rw [JuliaLean.Proofs.base.int.lit_val, JuliaLean.Proofs.base.int.wrapInt_val])
          simp only [Except.map, Bind.bind, Except.bind, huw]
          rw [show (approvedRound2.Concrete.numberCallees g).mixedMod u (JuliaLean.base.int.lit w m.val) =
              .ok (fmod u.val m.val) by
            show approvedRound2.Concrete.modMixed _ _ = _
            rw [opusPowInst.modMixed_all, if_neg (by rw [hMw]; exact hm0), hMw]]
          simp only
          have hfe := opusModMixed.fmod_spec_eq u.val m.val hm0
          have hfb := JuliaLean.Proofs.base.int.fmod_bounds u.val m.val hm0
          have hfd := Int.fmod_def u.val m.val
          by_cases hneg : m.val < 0
          · simp only [hneg, decide_true, if_true]
            rw [hmod _ hm0]
            refine ⟨_, rfl, finish_inv _ _ _ u.val hm0 hdv ?_⟩
            have := htsg (by cases hts : t.signed <;> simp_all <;> omega)
            have hb2 := hfb.2 hneg
            rw [JuliaLean.Proofs.base.int.lit_val, JuliaLean.Proofs.base.int.lit_val,
              JuliaLean.Proofs.base.int.wrapInt_wrapInt, JuliaLean.Proofs.base.int.lit_val, hfe,
              wrapInt_of_inRange w _ ⟨by omega, by omega⟩, wrapInt_of_inRange _ _ ⟨by omega, by omega⟩]
            exact ⟨-(u.val.fdiv m.val) - 1, by rw [Int.mul_sub, Int.mul_neg, Int.mul_one]; omega⟩
          · simp only [hneg, decide_false, Bool.false_eq_true, if_false]
            rw [hmod _ hm0]
            refine ⟨_, rfl, finish_inv _ _ _ u.val hm0 hdv ?_⟩
            have hb1 := hfb.1 (Int.lt_iff_le_and_ne.mpr ⟨Int.not_lt.mp hneg, Ne.symm hm0⟩)
            rw [JuliaLean.Proofs.base.int.lit_val, JuliaLean.Proofs.base.int.lit_val,
              JuliaLean.Proofs.base.int.wrapInt_wrapInt, hfe,
              wrapInt_of_inRange (s.promote t) (u.val.fmod m.val) ⟨by omega, by omega⟩]
            exact ⟨-(u.val.fdiv m.val), by rw [Int.mul_neg]; omega⟩
        · intro h1
          have h2 := H.2 h1
          have h3 : domainError ((bezoutCoef gcdxBits (fun g : JInt w => decide (g.val = 1))
              (JuliaLean.base.int.lit w n.val) (JuliaLean.base.int.lit w m.val)).map Subtype.val) := by
            obtain ⟨msg, hmsg⟩ := de_msg _ h2
            rw [hmsg]; trivial
          exact de_bind _ _ h3
  · simp only [if_true]
    have H := bezoutMixed_spec s t n m hr hm0
    constructor
    · intro h1
      obtain ⟨u, hres, hdv⟩ := H.1 h1
      rw [hres]
      simp only [Bind.bind, Except.bind]
      rw [hmod _ hm0]
      exact ⟨_, rfl, finish_inv _ _ _ u.val hm0 hdv (by simp)⟩
    · intro h1
      exact de_bind _ _ (H.2 h1)

