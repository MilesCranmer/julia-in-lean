          omega
        | succ k => rw [Nat.pow_succ] at hk_eq; omega

theorem isPowerTwoExact_proven : IsPowerTwoExact := by
  refine ⟨?_, ?_⟩
  · intro t x
    unfold ispow2Bits ispow2_Integer
    dsimp only
    have hct : (JuliaLean.base.int.ctpop_int x).val.toNat =
        (List.range t.bits).countP (fun i => (JuliaLean.Proofs.base.int.pattern x).testBit i) := by
      rw [ctpop_int_val x, JuliaLean.Proofs.base.int.count_ones_val x, Int.toNat_natCast]
      unfold JuliaLean.Proofs.base.int.onesCount
      have hbit : (fun k => JuliaLean.Proofs.base.int.bitOf x k) = (fun i => (JuliaLean.Proofs.base.int.pattern x).testBit i) := by
        funext i; exact JuliaLean.Proofs.base.int.bitOf_eq x i
      rw [hbit]
    rw [hct, Bool.and_eq_true, decide_eq_true_eq, beq_iff_eq]
    constructor
    · rintro ⟨hpos, h1⟩
      have hpat := JuliaLean.Proofs.base.int.pattern_of_nonneg x (by omega)
      have hlt := JuliaLean.Proofs.base.int.pattern_lt x
      obtain ⟨k, _, hk⟩ := (countP_range_testBit_eq_one t.bits (JuliaLean.Proofs.base.int.pattern x) hlt).mp h1
      rw [hpat] at hk
      refine ⟨k, ?_⟩
      have hcast : (x.val.toNat : Int) = ((2 ^ k : Nat) : Int) := congrArg Int.ofNat hk
      rw [Int.toNat_of_nonneg (by omega)] at hcast
      simpa using hcast
    · rintro ⟨k, hk⟩
      have hpos : x.val > 0 := by
        have : (0 : Int) < (2 : Int) ^ k := Int.pow_pos (by decide)
        omega
      have hpat := JuliaLean.Proofs.base.int.pattern_of_nonneg x (by omega)
      have hlt := JuliaLean.Proofs.base.int.pattern_lt x
      have hpat_eq : JuliaLean.Proofs.base.int.pattern x = 2 ^ k := by
        have hpow_cast : (2 : Int) ^ k = ((2 ^ k : Nat) : Int) := by simp
        rw [hpat, hk, hpow_cast, Int.toNat_natCast]
      have hk_lt : k < t.bits := by
        rw [hpat_eq] at hlt
        exact (Nat.pow_lt_pow_iff_right (by decide : 1 < 2)).mp hlt
      exact ⟨hpos, (countP_range_testBit_eq_one t.bits _ hlt).mpr ⟨k, hk_lt, hpat_eq⟩⟩
  · intro x
    unfold ispow2_Integer bigOps
    dsimp only [id]
    rw [Bool.and_eq_true, decide_eq_true_eq, beq_iff_eq]
    constructor
    · rintro ⟨hpos, h1⟩
      have hn_pos : 0 < x.natAbs := Int.natAbs_pos.mpr (by omega)
      have hlt : x.natAbs < 2 ^ (x.natAbs.log2 + 1) := Nat.lt_log2_self
      obtain ⟨k, _, hk⟩ := (countP_range_testBit_eq_one (x.natAbs.log2 + 1) x.natAbs hlt).mp h1
      refine ⟨k, ?_⟩
      have hcast : (x.natAbs : Int) = ((2 ^ k : Nat) : Int) := congrArg Int.ofNat hk
      rw [Int.natAbs_of_nonneg (by omega)] at hcast
      simpa using hcast
    · rintro ⟨k, hk⟩
      have hpos : x > 0 := by
        have : (0 : Int) < (2 : Int) ^ k := Int.pow_pos (by decide)
        omega
      have hn_eq : x.natAbs = 2 ^ k := by
        have hpow_cast : (2 : Int) ^ k = ((2 ^ k : Nat) : Int) := by simp
        rw [hk, hpow_cast, Int.natAbs_natCast]
      have hlt : x.natAbs < 2 ^ (x.natAbs.log2 + 1) := Nat.lt_log2_self
      have hlt' : 2 ^ k < 2 ^ (x.natAbs.log2 + 1) := by
        exact hn_eq ▸ hlt
      have hk_lt : k < x.natAbs.log2 + 1 :=
        (Nat.pow_lt_pow_iff_right (by decide : 1 < 2)).mp hlt'
      exact ⟨hpos, (countP_range_testBit_eq_one (x.natAbs.log2 + 1) x.natAbs hlt).mpr ⟨k, hk_lt, hn_eq⟩⟩

theorem numberPowerTwo_proven : NumberPowerTwo := by
  refine ⟨?_, ?_⟩
  · intro N t isreal real imaginary hreal x
    unfold ispow2_Number
    rw [Bool.and_eq_true, hreal x, isPowerTwoExact_proven.1 t (real x)]
  · intro N isreal real imaginary hreal x
    unfold ispow2_Number
    rw [Bool.and_eq_true, hreal x, isPowerTwoExact_proven.2 (real x)]

private theorem find?_map_succ_testBit (l : List Nat) (p : Nat) :
    (l.map Nat.succ).find? (fun i => p.testBit i) =
      (l.find? (fun i => (p / 2).testBit i)).map Nat.succ := by
  induction l with
  | nil => rfl
  | cons a l ih =>
    simp only [List.map_cons, List.find?_cons, Nat.testBit_succ]
    cases (p / 2).testBit a <;> simp [ih]

private theorem find?_range_testBit : ∀ (w p : Nat), 0 < p → p < 2 ^ w →
    ∃ tz < w, (List.range w).find? (fun i => p.testBit i) = some tz ∧
      p = 2 ^ tz * (1 + 2 * (p / 2 ^ (tz + 1)))
  | 0, p, hp0, hpw => by simp at hpw; omega
  | w + 1, p, hp0, hpw => by
    rw [List.range_succ_eq_map, List.find?_cons, Nat.testBit_zero]
    rcases Nat.mod_two_eq_zero_or_one p with h | h
    · simp only [h, Nat.zero_ne_one, decide_false, find?_map_succ_testBit]
      have hp2_pos : 0 < p / 2 := by omega
      have hp2_lt : p / 2 < 2 ^ w := by rw [Nat.pow_succ] at hpw; omega
      obtain ⟨tz, htz_lt, hfind, heq⟩ := find?_range_testBit w (p / 2) hp2_pos hp2_lt
      rw [hfind]
      refine ⟨tz + 1, by omega, rfl, ?_⟩
      have hdiv : (p / 2) / 2 ^ (tz + 1) = p / 2 ^ (tz + 2) := by
        rw [Nat.div_div_eq_div_mul, Nat.mul_comm 2, ← Nat.pow_succ]
      rw [hdiv] at heq
      have hp_eq : p = 2 * (p / 2) := by omega
      have hpow_mul : 2 * (2 ^ tz * (1 + 2 * (p / 2 ^ (tz + 2)))) =
          2 ^ (tz + 1) * (1 + 2 * (p / 2 ^ (tz + 2))) := by
        rw [← Nat.mul_assoc, Nat.mul_comm 2 (2 ^ tz), ← Nat.pow_succ]
      conv => lhs; rw [hp_eq, heq, hpow_mul]
    · simp only [h, decide_true]
      refine ⟨0, by omega, rfl, ?_⟩
      simp only [Nat.pow_zero, Nat.zero_add, Nat.pow_one, Nat.one_mul]
      omega

private def monoidPow {T : Type} (mulOp : T → T → T) (one : T) (x : T) : Nat → T
  | 0 => one
  | k + 1 => mulOp (monoidPow mulOp one x k) x

private theorem monoidPow_add {T : Type} (mulOp : T → T → T) (one : T)
    (hassoc : ∀ a b c, mulOp (mulOp a b) c = mulOp a (mulOp b c))
    (hone_r : ∀ a, mulOp a one = a) (x : T) (m : Nat) :
    ∀ n : Nat, monoidPow mulOp one x (m + n) = mulOp (monoidPow mulOp one x m) (monoidPow mulOp one x n)
  | 0 => by simp [monoidPow, hone_r]
  | n + 1 => by
    rw [Nat.add_succ, monoidPow, monoidPow, monoidPow_add mulOp one hassoc hone_r x m n, hassoc]

private theorem powerSquares_monoidPow {T : Type} (mulOp : T → T → T) (one : T)
    (hassoc : ∀ a b c, mulOp (mulOp a b) c = mulOp a (mulOp b c))
    (hone_r : ∀ a, mulOp a one = a) (x : T) :
    ∀ (k m : Nat),
      powerSquares (fun a b => pure (mulOp a b)) k (monoidPow mulOp one x m) =
        .ok (monoidPow mulOp one x (m * 2 ^ k))
  | 0, m => by rw [Nat.pow_zero, Nat.mul_one]; rfl
  | k + 1, m => by
    rw [powerSquares, repeatM_succ]
    dsimp only [Bind.bind, Except.bind, Pure.pure, Except.pure]
    have hsq : mulOp (monoidPow mulOp one x m) (monoidPow mulOp one x m) = monoidPow mulOp one x (m * 2) := by
      rw [← monoidPow_add mulOp one hassoc hone_r x m m, show m + m = m * 2 by omega]
    rw [hsq]
    change powerSquares (fun a b => pure (mulOp a b)) k (monoidPow mulOp one x (m * 2)) = _
    rw [powerSquares_monoidPow mulOp one hassoc hone_r x k (m * 2), Nat.mul_assoc, ← Nat.pow_succ']

private theorem powerLoop_monoidPow {T E : Type} (eo : IntegerOps E) (mulOp : T → T → T) (one : T)
    (hassoc : ∀ a b c, mulOp (mulOp a b) c = mulOp a (mulOp b c))
    (hone_r : ∀ a, mulOp a one = a)
    (heo : ∀ p : E, 0 < eo.value p →
      let tz := eo.trailingZeros p
      let q := eo.shiftRight p (tz + 1)
      0 ≤ eo.value q ∧ (eo.value p).toNat = 2 ^ tz * (1 + 2 * (eo.value q).toNat))
    (x : T) :
    ∀ (fuel m : Nat) (y : T) (p : E),
      0 ≤ eo.value p → (eo.value p).toNat ≤ fuel →
      powerLoop eo (fun a b => pure (mulOp a b)) fuel (monoidPow mulOp one x m) y p =
        .ok (mulOp y (monoidPow mulOp one x (m * 2 * (eo.value p).toNat)))
  | 0, m, y, p, hp0, hle => by
    have hp_eq0 : (eo.value p).toNat = 0 := by omega
    simp [powerLoop, hp_eq0, monoidPow, hone_r, Pure.pure, Except.pure]
  | n + 1, m, y, p, hp0, hle => by
    unfold powerLoop
    by_cases hle0 : eo.value p ≤ 0
    · rw [if_pos hle0]
      have hp_eq0 : (eo.value p).toNat = 0 := by omega
      simp [hp_eq0, monoidPow, hone_r, Pure.pure, Except.pure]
    · rw [if_neg hle0]
      dsimp only
      have hpos : 0 < eo.value p := by omega
      obtain ⟨hq0, hp_eq⟩ := heo p hpos
      have hpow_pos : 0 < 2 ^ eo.trailingZeros p := Nat.two_pow_pos (eo.trailingZeros p)
      have hq_lt : (eo.value (eo.shiftRight p (eo.trailingZeros p + 1))).toNat < (eo.value p).toNat := by
        have : 1 + 2 * (eo.value (eo.shiftRight p (eo.trailingZeros p + 1))).toNat ≤
            2 ^ eo.trailingZeros p * (1 + 2 * (eo.value (eo.shiftRight p (eo.trailingZeros p + 1))).toNat) :=
          Nat.le_mul_of_pos_left _ hpow_pos
        omega
      rw [powerSquares_monoidPow mulOp one hassoc hone_r x (eo.trailingZeros p + 1) m, ok_bind, pure_bind]
      rw [powerLoop_monoidPow eo mulOp one hassoc hone_r heo x n (m * 2 ^ (eo.trailingZeros p + 1))
        (mulOp y (monoidPow mulOp one x (m * 2 ^ (eo.trailingZeros p + 1))))
        (eo.shiftRight p (eo.trailingZeros p + 1)) hq0 (by omega)]
      rw [hassoc, ← monoidPow_add mulOp one hassoc hone_r]
      let tz := eo.trailingZeros p
      let q := eo.shiftRight p (tz + 1)
      have hexp : m * 2 ^ (tz + 1) + m * 2 ^ (tz + 1) * 2 * (eo.value q).toNat =
          m * 2 * (eo.value p).toNat := by
        rw [hp_eq, Nat.pow_succ]
        have h1 : m * (2 ^ tz * 2) = (m * 2) * 2 ^ tz := by
          rw [← Nat.mul_assoc, Nat.mul_assoc m (2 ^ tz) 2, Nat.mul_comm (2 ^ tz) 2, ← Nat.mul_assoc]
        rw [h1, Nat.mul_assoc ((m * 2) * 2 ^ tz) 2, Nat.mul_assoc (m * 2) (2 ^ tz) (2 * (eo.value q).toNat)]
        have h2 : (m * 2) * 2 ^ tz + (m * 2) * (2 ^ tz * (2 * (eo.value q).toNat)) =
            (m * 2) * (2 ^ tz * (1 + 2 * (eo.value q).toNat)) := by
          rw [← Nat.left_distrib, Nat.left_distrib (2 ^ tz) 1, Nat.mul_one]
        exact h2
      rw [hexp]

private theorem powerBySquaring_monoidPow {T E : Type} (eo : IntegerOps E) (mulOp : T → T → T) (one : T)
    (neg : T → Jl T) (isone : T → Bool) (throwDomerr : T → E → Jl T)
    (hassoc : ∀ a b c, mulOp (mulOp a b) c = mulOp a (mulOp b c))
    (hone_l : ∀ a, mulOp one a = a) (hone_r : ∀ a, mulOp a one = a)
    (heo : ∀ p : E, 0 < eo.value p →
      let tz := eo.trailingZeros p
      let q := eo.shiftRight p (tz + 1)
      0 ≤ eo.value q ∧ (eo.value p).toNat = 2 ^ tz * (1 + 2 * (eo.value q).toNat))
    (x : T) (p : E) (hp : 0 ≤ eo.value p) :
    powerBySquaring eo (fun a b => pure (mulOp a b)) true pure pure pure id
      (fun _ => one) neg isone (fun a b => pure (mulOp a b)) true x p throwDomerr =
      .ok (monoidPow mulOp one x (eo.value p).toNat) := by
  unfold powerBySquaring
  change (if eo.value p = 1 then pure (id x)
    else if eo.value p = 0 then pure one
    else if eo.value p = 2 then pure (mulOp x x)
    else if eo.value p < 0 then
      if isone x then pure (id x)
      else do
        let negX ← neg x
        if isone negX then pure (if eo.value p % 2 = 0 then one else id x)
        else throwDomerr x p
    else
      let t := eo.trailingZeros p + 1
      let p := eo.shiftRight p t
      do
        let (x, t) ← if t > 1 then pure (mulOp x x, t - 1) else pure (x, t - 1)
        let x ← powerSquares (fun a b => pure (mulOp a b)) (t - 1) x
        powerLoop eo (fun a b => pure (mulOp a b)) (eo.value p).natAbs x x p) = _
  by_cases hp1 : eo.value p = 1
  · rw [if_pos hp1]
    simp [hp1, monoidPow, hone_l, Pure.pure, Except.pure]
  · rw [if_neg hp1]
    by_cases hp0 : eo.value p = 0
    · rw [if_pos hp0]
      simp [hp0, monoidPow, Pure.pure, Except.pure]
    · rw [if_neg hp0]
      by_cases hp2 : eo.value p = 2
      · rw [if_pos hp2]
        simp [hp2, monoidPow, hone_l, Pure.pure, Except.pure]
      · rw [if_neg hp2, if_neg (by omega : ¬ eo.value p < 0)]
        dsimp only
        have hpos : 0 < eo.value p := by omega
        obtain ⟨hq0, hp_eq⟩ := heo p hpos
        have hq_le : (eo.value (eo.shiftRight p (eo.trailingZeros p + 1))).toNat ≤
            (eo.value (eo.shiftRight p (eo.trailingZeros p + 1))).natAbs := by omega
        have hexp_final : 2 ^ eo.trailingZeros p + 2 ^ eo.trailingZeros p * 2 * (eo.value (eo.shiftRight p (eo.trailingZeros p + 1))).toNat =
            2 ^ eo.trailingZeros p * (1 + 2 * (eo.value (eo.shiftRight p (eo.trailingZeros p + 1))).toNat) := by
          rw [Nat.left_distrib, Nat.mul_one, ← Nat.mul_assoc]
        by_cases htz : eo.trailingZeros p + 1 > 1
        · rw [if_pos htz, pure_bind]
          have hsq : mulOp x x = monoidPow mulOp one x 2 := by simp [monoidPow, hone_l]
          rw [hsq, powerSquares_monoidPow mulOp one hassoc hone_r x (eo.trailingZeros p + 1 - 1 - 1) 2, ok_bind]
          have hexp : 2 * 2 ^ (eo.trailingZeros p + 1 - 1 - 1) = 2 ^ eo.trailingZeros p := by
            cases htz_eq : eo.trailingZeros p with
            | zero => omega
            | succ k => simp [Nat.pow_succ, Nat.mul_comm]
          rw [hexp, powerLoop_monoidPow eo mulOp one hassoc hone_r heo x
            (eo.value (eo.shiftRight p (eo.trailingZeros p + 1))).natAbs (2 ^ eo.trailingZeros p)
            (monoidPow mulOp one x (2 ^ eo.trailingZeros p)) (eo.shiftRight p (eo.trailingZeros p + 1)) hq0 hq_le]
          rw [← monoidPow_add mulOp one hassoc hone_r, hp_eq, hexp_final]
        · rw [if_neg htz, pure_bind]
          have htz0 : eo.trailingZeros p = 0 := by omega
          have hps0 : powerSquares (fun a b => pure (mulOp a b)) (eo.trailingZeros p + 1 - 1 - 1) x =
              .ok (monoidPow mulOp one x (2 ^ eo.trailingZeros p)) := by
            rw [htz0]
            exact congrArg Except.ok (hone_l x).symm
          rw [hps0, ok_bind, powerLoop_monoidPow eo mulOp one hassoc hone_r heo x
            (eo.value (eo.shiftRight p (eo.trailingZeros p + 1))).natAbs (2 ^ eo.trailingZeros p)
            (monoidPow mulOp one x (2 ^ eo.trailingZeros p)) (eo.shiftRight p (eo.trailingZeros p + 1)) hq0 hq_le]
          rw [← monoidPow_add mulOp one hassoc hone_r, hp_eq, hexp_final]

private theorem bigOps_trailing_shift (p : Int) (hp : 0 < bigOps.value p) :
    let tz := bigOps.trailingZeros p
    let q := bigOps.shiftRight p (tz + 1)
    0 ≤ bigOps.value q ∧ (bigOps.value p).toNat = 2 ^ tz * (1 + 2 * (bigOps.value q).toNat) := by
  dsimp only [bigOps, id] at hp ⊢
  have hn_pos : 0 < p.natAbs := Int.natAbs_pos.mpr (by omega)
  have hlt : p.natAbs < 2 ^ (p.natAbs.log2 + 1) := Nat.lt_log2_self
  obtain ⟨tz, _, hfind, heq⟩ := find?_range_testBit (p.natAbs.log2 + 1) p.natAbs hn_pos hlt
  rw [hfind, Option.getD_some]
  have hpow_pos : (0 : Int) < (2 : Int) ^ (tz + 1) := Int.pow_pos (by decide)
  have hq0 : 0 ≤ p / (2 ^ (tz + 1) : Int) := Int.ediv_nonneg (by omega) (by omega)
  refine ⟨hq0, ?_⟩
  have hp_nat : p.toNat = p.natAbs := by omega
  have hdiv_nat : (p / (2 ^ (tz + 1) : Int)).toNat = p.natAbs / 2 ^ (tz + 1) := by
    have h1 : ((p.natAbs / 2 ^ (tz + 1) : Nat) : Int) = p / (2 ^ (tz + 1) : Int) := by
      rw [Int.natCast_ediv, Int.natAbs_of_nonneg (by omega)]
      simp
    rw [← h1, Int.toNat_natCast]
  rw [hp_nat, hdiv_nat]
  exact heq

private theorem lit_i64_val_of_nat_le_128 (n : Nat) (h : n ≤ 128) :
    (JuliaLean.base.int.lit .i64 (n : Int)).val = (n : Int) :=
  lit_i64_val_of_bounds (n : Int) (by omega) (by omega)

private theorem bitsOps_trailingZeros_eq (t : IntTy) (p : JInt t) :
    (bitsOps t).trailingZeros p = (JuliaLean.base.int.cttz_int p).val.toNat := rfl

private theorem bitsOps_value_eq (t : IntTy) (p : JInt t) :
    (bitsOps t).value p = p.val := rfl

private theorem bitsOps_shiftRight_eq (t : IntTy) (p : JInt t) (n : Nat) :
    (bitsOps t).shiftRight p n = JuliaLean.base.int.shr_Int p (JuliaLean.base.int.lit .i64 (n : Int)) := by
  rw [bitsOps, bitOps]

private theorem bitsOps_shiftRight_val (t : IntTy) (p : JInt t) (n : Nat) (h : n ≤ 128) :
    ((bitsOps t).shiftRight p n).val = p.val / (2 : Int) ^ n := by
  have hsh := (JuliaLean.Proofs.base.int.shiftIntCount_proven t p (JuliaLean.base.int.lit .i64 (n : Int))).1
  have hlit := lit_i64_val_of_nat_le_128 n h
  have hpos : (0 : Int) ≤ (JuliaLean.base.int.lit .i64 (n : Int)).val := by
    rw [hlit]; exact Int.natCast_nonneg n
  rw [if_pos hpos, hlit, Int.toNat_natCast] at hsh
  exact (congrArg Subtype.val (bitsOps_shiftRight_eq t p n)).trans hsh

private theorem toNat_pos_of_pos {z : Int} (h : 0 < z) : 0 < z.toNat := by omega

private theorem bits_le_128 (t : IntTy) : t.bits ≤ 128 := by cases t <;> decide

private theorem bitsOps_trailing_shift (t : IntTy) (p : JInt t) (hp : 0 < (bitsOps t).value p) :
    let tz := (bitsOps t).trailingZeros p
    let q := (bitsOps t).shiftRight p (tz + 1)
    0 ≤ (bitsOps t).value q ∧ ((bitsOps t).value p).toNat = 2 ^ tz * (1 + 2 * ((bitsOps t).value q).toNat) := by
  dsimp only
  rw [bitsOps_value_eq] at hp ⊢
  have hnonneg : 0 ≤ p.val := Int.le_of_lt hp
  have hpat := JuliaLean.Proofs.base.int.pattern_of_nonneg p hnonneg
  have hlt := JuliaLean.Proofs.base.int.pattern_lt p
  have hpat_pos : 0 < JuliaLean.Proofs.base.int.pattern p := by
    rw [hpat]; exact toNat_pos_of_pos hp
  obtain ⟨tz, htz_lt, hfind, heq⟩ := find?_range_testBit t.bits (JuliaLean.Proofs.base.int.pattern p) hpat_pos hlt
  have htz_eq : (bitsOps t).trailingZeros p = tz := by
    rw [bitsOps_trailingZeros_eq, cttz_int_val p, JuliaLean.Proofs.base.int.trailing_zeros_val p, hfind, Option.getD_some, Int.toNat_natCast]
  rw [htz_eq, bitsOps_shiftRight_val t p (tz + 1) (Nat.le_trans htz_lt (bits_le_128 t))]
  have hpow_pos : (0 : Int) < (2 : Int) ^ (tz + 1) := Int.pow_pos (by decide)
  have hq0 : 0 ≤ p.val / (2 : Int) ^ (tz + 1) := Int.ediv_nonneg hnonneg (Int.le_of_lt hpow_pos)
  refine ⟨hq0, ?_⟩
  have hdiv_nat : (p.val / (2 : Int) ^ (tz + 1)).toNat = (JuliaLean.Proofs.base.int.pattern p) / 2 ^ (tz + 1) := by
    have h1 : (((JuliaLean.Proofs.base.int.pattern p) / 2 ^ (tz + 1) : Nat) : Int) = p.val / (2 : Int) ^ (tz + 1) := by
      rw [Int.natCast_ediv, hpat, Int.toNat_of_nonneg hnonneg, Int.natCast_pow]
      rfl
    rw [← h1, Int.toNat_natCast]
  rw [bitsOps_value_eq, ← hpat, hdiv_nat]
  exact heq

private theorem monoidPow_int_eq (x : Int) : ∀ k : Nat, monoidPow (· * ·) 1 x k = x ^ k
  | 0 => by simp [monoidPow]
  | k + 1 => by
    rw [monoidPow, monoidPow_int_eq x k, Int.pow_succ]

private theorem jint_mul_assoc (t : IntTy) (a b c : JInt t) :
    JuliaLean.base.int.mul (JuliaLean.base.int.mul a b) c =
      JuliaLean.base.int.mul a (JuliaLean.base.int.mul b c) := by
  apply Subtype.ext
  simp only [JuliaLean.base.int.mul, JuliaLean.Proofs.base.int.mul_int_val]
  rw [JuliaLean.Proofs.base.int.wrapInt_mul_left, JuliaLean.Proofs.base.int.wrapInt_mul_right, Int.mul_assoc]

private theorem jint_mul_one_left (t : IntTy) (a : JInt t) :
    JuliaLean.base.int.mul (JuliaLean.base.int.lit t 1) a = a := by
