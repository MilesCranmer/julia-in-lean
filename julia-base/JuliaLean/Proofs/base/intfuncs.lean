    · rw [if_pos hp0]
      have hmod := h0.1 t t (JuliaLean.base.int.lit t 1) (JuliaLean.base.int.lit t 0)
      rw [if_pos hzero] at hmod
      simp [bitsOps, bitOps, hmod, Bind.bind, Except.bind, divideError]
    · have hnotneg : ¬ (bitsOps e).value p < 0 := by change ¬ p.val < 0; omega
      rw [if_neg hp0, if_neg hnotneg]
      have hm1 : ¬ ((bitsOps t).value (JuliaLean.base.int.lit t 0) = 1 ∨
          (bitsOps t).value (JuliaLean.base.int.lit t 0) = -1) := by
        change ¬ ((JuliaLean.base.int.lit t 0).val = 1 ∨ (JuliaLean.base.int.lit t 0).val = -1)
        rw [hzero]; decide
      dsimp only
      rw [if_neg hm1]
      have hmod := h0.1 s t.toUnsigned x (JuliaLean.base.float.uabs (JuliaLean.base.int.lit t 0))
      rw [if_pos huabs] at hmod
      simp [hmod, Bind.bind, Except.bind, divideError]

