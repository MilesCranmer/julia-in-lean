theorem numberPowerTwo_rationalCases :
    (∀ (t : IntTy) (z : JuliaLean.base.complex.Complex (Rat t)),
      ispow2_Number
        (JuliaLean.base.complex.isreal_Complex (isZeroRationalSource (jintOps t).iszero))
        JuliaLean.base.complex.real_Complex (isPow2RatSource ispow2Bits) z = true ↔
        z.im.num.val = 0 ∧
          (∃ k : Nat, z.re.num.val = (2 : Int)^k) ∧
          (∃ k : Nat, z.re.den.val = (2 : Int)^k)) ∧
    (∀ z : JuliaLean.base.complex.Complex BigRat,
      ispow2_Number
        (JuliaLean.base.complex.isreal_Complex (isZeroRationalSource bigIntOps.iszero))
        JuliaLean.base.complex.real_Complex
        (isPow2RatSource (ispow2_Integer bigOps.value bigOps.countOnes)) z = true ↔
        z.im.num = 0 ∧ (∃ k : Nat, z.re.num = (2 : Int)^k) ∧
