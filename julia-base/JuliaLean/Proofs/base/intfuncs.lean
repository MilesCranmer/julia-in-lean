    JuliaLean.base.intfuncs.hasTypeMax JuliaLean.base.reduce.assertBool
  simp only [io_bind, io_pure, Bool.true_and, ↓reduceIte]
  congr 4
  rw [JuliaLean.Proofs.base.int.leSame_eq]
  have hbound : (JuliaLean.base.int.shr_Int (JuliaLean.base.int.typemax t)
      (JuliaLean.base.int.shl_Int (JuliaLean.base.int.lit .i64 (JuliaLean.base.int.sizeofT t))
        (JuliaLean.base.int.lit .i64 2))).val = 2 ^ (t.bits / 2) - 1 := by
    cases t <;> first | contradiction | decide
  rw [hbound]
  have hz : 0 ≤ mm.val := by
    have hm := mm.property.1
    have hmin0 : t.min = 0 := by cases t <;> first | contradiction | rfl
    omega
  have hc : 0 ≤ (2 ^ (t.bits / 2) - 1 : Int) := by cases t <;> first | contradiction | decide
  have h1 : (2 ^ (t.bits / 2) - 1 : Int) * (2 ^ (t.bits / 2) - 1 : Int) ≤ t.max := by
    cases t <;> first | contradiction | decide
  have h2 : t.max < ((2 ^ (t.bits / 2) - 1 : Int) + 1) * ((2 ^ (t.bits / 2) - 1 : Int) + 1) := by
    cases t <;> first | contradiction | decide
  apply Bool.eq_iff_iff.mpr
  simp only [decide_eq_true_eq]
  exact (sq_le_iff_le mm.val (2 ^ (t.bits / 2) - 1) t.max hz hc h1 h2).symm

