        | zero => omega
        | succ k => exact ⟨k, by omega, by rw [Nat.pow_succ] at hk_eq; omega⟩
    · simp only [h, ↓reduceIte]
      have h0 := countP_range_testBit_eq_zero w (p / 2) hp2
