/-- Mathematical rounding in the finite unsigned range. Zero and a rounded
power beyond the machine range produce zero. Every remaining input returns
the least mathematical power of two above it. No source shift/count formula
is repeated in the expectation, and no native value or width is excluded.
Julia source invariant: base/intfuncs.jl:589. -/
def NextPow2UnsignedBitsRounding : Prop :=
  ∀ (W : Type) (world : W) (t : IntTy), t.signed = false → ∀ (x : JInt t),
    ∃ result, nextpow2Unsigned (nextpow2UnsignedBitsOps (World := W) t) x world =
      some (.ok (result, world)) ∧
      (if x.val = 0 ∨ (2 ^ (t.bits - 1) : Int) < x.val then result.val = 0
       else ∃ exponent : Nat, exponent < t.bits ∧ result.val = 2 ^ exponent ∧
         x.val ≤ result.val ∧
         ∀ k : Nat, x.val ≤ (2 ^ k : Int) → exponent ≤ k)

/-- Mathematical rounding down in every unsigned native width, with the
zero case explicit and no shift or bit-count expression in the expectation.
Julia source invariant: base/intfuncs.jl:591. -/
def PrevPow2UnsignedBitsRounding : Prop :=
  ∀ (W : Type) (world : W) (t : IntTy), t.signed = false → ∀ (x : JInt t),
    ∃ result, prevpow2Unsigned (prevpow2UnsignedBitsOps (World := W) t) x world =
      some (.ok (result, world)) ∧
      (if x.val = 0 then result.val = 0 else
        ∃ exponent : Nat, exponent < t.bits ∧ result.val = 2 ^ exponent ∧
          result.val ≤ x.val ∧ x.val < 2 * result.val)

/-- Operation names distinguish the two source Unsigned methods from the
Integer frame operations, so recursion depth and invocation counts are
observable even when every operation uses the same runtime carrier. -/
inductive Pow2Call where
  | negate | toUnsigned | custom
  | nextOneunit | nextSub | nextTop | nextShift
  | prevOne | prevTop | prevSub | prevUnsigned | prevShift
  deriving DecidableEq

inductive Pow2Event (Ty V : Type) where
  | test (value : V) (zero : JInt64) (result : Except JuliaLean.base.io.Error Bool)
  | call (operation : Pow2Call) (arguments : List V) (literal : Option JInt64)
      (result : Except JuliaLean.base.io.Error V)
  | reinterpret (type : Ty) (value : V) (result : Except JuliaLean.base.io.Error V)

/-- Each observation runs the original effectful leaf exactly once. No
return, error, world transition, alias or divergence is prescribed. -/
def observePow2Ops {W V Ty : Type} (ops : Pow2IntegerOps W V Ty) :
    Pow2IntegerOps (W × List (Pow2Event Ty V)) V Ty where
  typeOf := ops.typeOf
  lessZero := fun value zero => recordCall (.test value zero) (ops.lessZero value zero)
  neg := fun value => recordCall (.call .negate [value] none) (ops.neg value)
  unsigned := fun value => recordCall (.call .toUnsigned [value] none) (ops.unsigned value)
  reinterpret := fun type value => recordCall (.reinterpret type value) (ops.reinterpret type value)
  select := ops.select
  custom := fun fn value => recordCall (.call .custom [value] none) (ops.custom fn value)
  nextUnsigned := {
    oneunit := fun value => recordCall (.call .nextOneunit [value] none) (ops.nextUnsigned.oneunit value)
    sub := fun x y => recordCall (.call .nextSub [x,y] none) (ops.nextUnsigned.sub x y)
    topBit := fun value => recordCall (.call .nextTop [value] none) (ops.nextUnsigned.topBit value)
    shift := fun x y => recordCall (.call .nextShift [x,y] none) (ops.nextUnsigned.shift x y) }
  prevUnsigned := {
    one := fun value => recordCall (.call .prevOne [value] none) (ops.prevUnsigned.one value)
    topBit := fun value => recordCall (.call .prevTop [value] none) (ops.prevUnsigned.topBit value)
    subOne := fun value one => recordCall (.call .prevSub [value] (some one)) (ops.prevUnsigned.subOne value one)
    unsigned := fun value => recordCall (.call .prevUnsigned [value] none) (ops.prevUnsigned.unsigned value)
    shift := fun x y => recordCall (.call .prevShift [x,y] none) (ops.prevUnsigned.shift x y) }

def pow2TestInputs {Ty V : Type} (trace : List (Pow2Event Ty V)) : List V :=
  trace.filterMap fun event => match event with
    | .test value _ _ => some value
    | _ => none

def pow2NegativeTests {Ty V : Type} (trace : List (Pow2Event Ty V)) : List V :=
  trace.filterMap fun event => match event with
    | .test value _ (.ok true) => some value
    | _ => none

def pow2CallInputs {Ty V : Type} (kind : Pow2Call) (trace : List (Pow2Event Ty V)) : List (List V) :=
  trace.filterMap fun event => match event with
    | .call name arguments _ _ => if name = kind then some arguments else none
    | _ => none

def pow2CallOutputs {Ty V : Type} (kind : Pow2Call) (trace : List (Pow2Event Ty V)) : List V :=
  trace.filterMap fun event => match event with
    | .call name _ _ (.ok value) => if name = kind then some value else none
    | _ => none

def pow2ReinterpretTypes {Ty V : Type} (trace : List (Pow2Event Ty V)) : List Ty :=
  trace.filterMap fun event => match event with
    | .reinterpret type _ _ => some type
    | _ => none

def pow2EventError {Ty V : Type} : Pow2Event Ty V → Option JuliaLean.base.io.Error
  | .test _ _ (.error error) => some error
  | .call _ _ _ (.error error) => some error
  | .reinterpret _ _ (.error error) => some error
  | _ => none

/-- An independent conservation invariant of pending recursive calls:
each comparison consumes either the initial input or an actual unsigned
result; at most one terminal route executes; saved type tags are restored
in reverse call order. Negations cannot exceed the two required by each
successful negative test. Literal arguments retain their native values.
No selected callee is required to satisfy any arithmetic or type law.
Julia source invariant: base/intfuncs.jl:589-592. -/
def Pow2FrameInvariant {W V Ty : Type} (ops : Pow2IntegerOps W V Ty)
    (fn : Pow2Function) (x : V) (trace : List (Pow2Event Ty V)) : Prop :=
  let tests := pow2TestInputs trace
  let converted := pow2CallOutputs .toUnsigned trace
  let restored := pow2ReinterpretTypes trace
  tests = (x :: converted).take tests.length ∧
  restored = (tests.map ops.typeOf).reverse.take restored.length ∧
  restored.length ≤ converted.length ∧
  (pow2CallInputs .toUnsigned trace).length ≤ tests.length ∧
  (pow2CallInputs .negate trace).length ≤ 2 * (pow2NegativeTests trace).length ∧
  (pow2CallInputs .custom trace).length ≤ 1 ∧
  (pow2CallInputs .nextOneunit trace).length ≤ 2 ∧
  (pow2CallInputs .prevOne trace).length ≤ 1 ∧
  ((pow2CallInputs .custom trace).isEmpty = true ∨
    (pow2CallInputs .nextOneunit trace).isEmpty = true ∧
    (pow2CallInputs .prevOne trace).isEmpty = true) ∧
  (∀ value zero result, Pow2Event.test value zero result ∈ trace → zero.val = 0) ∧
  (∀ args one result, Pow2Event.call .prevSub args (some one) result ∈ trace → one.val = 1) ∧
  (∀ value result, Pow2Event.call .custom [value] none result ∈ trace →
    ops.select fn value = .custom) ∧
  (∀ value result, Pow2Event.call .nextOneunit [value] none result ∈ trace →
    fn = .next ∧ ops.select fn value = .unsigned) ∧
  (∀ value result, Pow2Event.call .prevOne [value] none result ∈ trace →
    fn = .prev ∧ ops.select fn value = .unsigned) ∧
  (∀ before type value result after,
    trace = before ++ [.reinterpret type value result] ++ after →
      pow2TestInputs after = [] ∧ pow2CallInputs .toUnsigned after = [])

/-- Terminal accounting, provenance of the returned reference/value, and
unique first-error propagation. A method error generated at the recursive
call has the actual last unsigned result and absent method as its witness.
Julia source invariant: base/intfuncs.jl:590,592. -/
def Pow2FrameTerminal {W V Ty : Type} (ops : Pow2IntegerOps W V Ty)
    (fn : Pow2Function) (trace : List (Pow2Event Ty V)) :
    Except JuliaLean.base.io.Error V → Prop
  | .ok value =>
      trace.filterMap pow2EventError = [] ∧
      (pow2ReinterpretTypes trace).length = (pow2TestInputs trace).length ∧
      (pow2CallInputs .negate trace).length = 2 * (pow2NegativeTests trace).length ∧
      ∃ type argument, trace.getLast? = some (.reinterpret type argument (.ok value))
  | .error error =>
      (trace.filterMap pow2EventError = [error] ∧
        ∃ event, trace.getLast? = some event ∧ pow2EventError event = some error) ∨
      (trace.filterMap pow2EventError = [] ∧
        error = .jl (.methodError (match fn with | .next => "_nextpow2" | .prev => "_prevpow2")) ∧
        ∃ argument value, trace.getLast? = some (.call .toUnsigned [argument] none (.ok value)) ∧
          ops.select fn value = .noMethod)

/-- Quantifies over every dynamic carrier, mutable world and unrestricted
selected callee, including changes of runtime type and arbitrarily deep
Integer recursion. The registered property actually invokes each public
Integer wrapper and its real recursive helper. Divergence remains allowed;
completed executions must conserve frames and propagate the first failure.
Julia source: base/intfuncs.jl:589-592; manual/types.md:154-174. -/
def Pow2IntegerOpenFrameAccounting : Prop :=
  ∀ (W V Ty : Type) (ops : Pow2IntegerOps W V Ty) (fn : Pow2Function)
      (x : V) (world : W),
    let observed := match fn with
      | .next => nextpow2Integer (observePow2Ops ops) x (world, [])
      | .prev => prevpow2Integer (observePow2Ops ops) x (world, [])
    match observed with
    | none => True
    | some (.ok (value, (_, trace))) =>
        Pow2FrameInvariant ops fn x trace ∧ Pow2FrameTerminal ops fn trace (.ok value)
    | some (.error (error, (_, trace))) =>
        Pow2FrameInvariant ops fn x trace ∧ Pow2FrameTerminal ops fn trace (.error error)

/-- A completed unsigned call performs exactly five dispatched operations.
Next-power invokes oneunit twice on the original handle, and the output of
the first invocation remains the final shift's left operand even if the
second call mutates the shared world or returns another handle. The two
calls are not assumed equal. Previous-power similarly preserves one(x).
The invariant accounts for every error prefix without constraining callees.
Julia source: base/intfuncs.jl:589,591. -/
def Pow2UnsignedCallAccounting : Prop :=
  ∀ (W V Ty : Type) (ops : Pow2IntegerOps W V Ty) (fn : Pow2Function)
      (x : V) (world : W),
    let observed := match fn with
      | .next => nextpow2Unsigned (observePow2Ops ops).nextUnsigned x (world, [])
      | .prev => prevpow2Unsigned (observePow2Ops ops).prevUnsigned x (world, [])
    let kinds := match fn with
      | .next => [Pow2Call.nextOneunit, .nextOneunit, .nextSub, .nextTop, .nextShift]
      | .prev => [Pow2Call.prevOne, .prevTop, .prevSub, .prevUnsigned, .prevShift]
    match observed with
    | none => True
    | some result =>
      let trace := match result with | .ok (_, (_, t)) => t | .error (_, (_, t)) => t
      let calls := trace.filterMap fun event => match event with
        | .call kind _ _ _ => some kind
        | _ => none
      calls = kinds.take calls.length ∧ trace.length = calls.length ∧ trace.length ≤ 5 ∧
      (∀ value result, Pow2Event.call .nextOneunit [value] none result ∈ trace → value = x) ∧
      (∀ value count result, Pow2Event.call .nextShift [value,count] none result ∈ trace →
        (pow2CallOutputs .nextOneunit trace).head? = some value) ∧
      (∀ value count result, Pow2Event.call .prevShift [value,count] none result ∈ trace →
        pow2CallOutputs .prevOne trace = [value]) ∧
      (match result with
       | .ok (value, _) => trace.length = 5 ∧ trace.filterMap pow2EventError = [] ∧
           ∃ args, trace.getLast? = some (.call
             (match fn with | .next => .nextShift | .prev => .prevShift) args none (.ok value))
       | .error (error, _) => trace.filterMap pow2EventError = [error] ∧
           ∃ event, trace.getLast? = some event ∧ pow2EventError event = some error)

inductive IsPow2Event (V Count Other : Type) where
  | realTest (value : V) (result : Except JuliaLean.base.io.Error Bool)
  | real (value : V) (result : Except JuliaLean.base.io.Error V)
  | greater (value : V) (zero : JInt64) (result : Except JuliaLean.base.io.Error Bool)
  | ones (value : V) (result : Except JuliaLean.base.io.Error Count)
  | equal (value : Count) (one : JInt64) (result : Except JuliaLean.base.io.Error (Pow2BoolResult Other))
  | custom (value : V) (result : Except JuliaLean.base.io.Error (Pow2BoolResult Other))

def observeIsPow2IntegerOps {W V Count Other : Type}
    (ops : IsPow2IntegerOps (JuliaLean.base.io.M W) V Count Other) :
    IsPow2IntegerOps (JuliaLean.base.io.M (W × List (IsPow2Event V Count Other))) V Count Other where
  greaterZero := fun value zero => recordCall (.greater value zero) (ops.greaterZero value zero)
  countOnes := fun value => recordCall (.ones value) (ops.countOnes value)
  equalOne := fun value one => recordCall (.equal value one) (ops.equalOne value one)

def observeIsPow2NumberOps {W V Count Other : Type}
    (ops : IsPow2NumberOps W V Count Other) :
    IsPow2NumberOps (W × List (IsPow2Event V Count Other)) V Count Other where
  isReal := fun value => recordCall (.realTest value) (ops.isReal value)
  real := fun value => recordCall (.real value) (ops.real value)
  select := ops.select
  custom := fun value => recordCall (.custom value) (ops.custom value)
  integer := observeIsPow2IntegerOps ops.integer

def ispow2EventError {V Count Other : Type} : IsPow2Event V Count Other → Option JuliaLean.base.io.Error
  | .realTest _ (.error error) => some error
  | .real _ (.error error) => some error
  | .greater _ _ (.error error) => some error
  | .ones _ (.error error) => some error
  | .equal _ _ (.error error) => some error
  | .custom _ (.error error) => some error
  | _ => none

def ispow2RealInputs {V Count Other : Type} (trace : List (IsPow2Event V Count Other)) : List V :=
  trace.filterMap fun event => match event with | .real value _ => some value | _ => none

def ispow2RealOutputs {V Count Other : Type} (trace : List (IsPow2Event V Count Other)) : List V :=
  trace.filterMap fun event => match event with | .real _ (.ok value) => some value | _ => none

def ispow2Tests {V Count Other : Type} (trace : List (IsPow2Event V Count Other)) : List V :=
  trace.filterMap fun event => match event with | .realTest value _ => some value | _ => none

def ispow2GreaterInputs {V Count Other : Type} (trace : List (IsPow2Event V Count Other)) : List V :=
  trace.filterMap fun event => match event with | .greater value _ _ => some value | _ => none

def ispow2OnesInputs {V Count Other : Type} (trace : List (IsPow2Event V Count Other)) : List V :=
  trace.filterMap fun event => match event with | .ones value _ => some value | _ => none

def ispow2OnesOutputs {V Count Other : Type} (trace : List (IsPow2Event V Count Other)) : List Count :=
  trace.filterMap fun event => match event with | .ones _ (.ok value) => some value | _ => none

def ispow2EqualInputs {V Count Other : Type} (trace : List (IsPow2Event V Count Other)) : List Count :=
  trace.filterMap fun event => match event with | .equal value _ _ => some value | _ => none

def ispow2CustomInputs {V Count Other : Type} (trace : List (IsPow2Event V Count Other)) : List V :=
  trace.filterMap fun event => match event with | .custom value _ => some value | _ => none

/-- Independent traversal and leaf accounting: repeated Number tests consume
actual real results; at most one terminal custom or Integer route occurs;
count/equality operands originate in the original tested value and actual
population-count return. No purity, Bool-result or mathematical laws for
these operations are assumed. Julia source: base/intfuncs.jl:622,624. -/
def IsPow2CallInvariant {V Count Other : Type} (x : V)
    (trace : List (IsPow2Event V Count Other)) : Prop :=
  let tests := ispow2Tests trace
  let greater := ispow2GreaterInputs trace
  let ones := ispow2OnesInputs trace
  let equal := ispow2EqualInputs trace
  tests = (x :: ispow2RealOutputs trace).take tests.length ∧
  ispow2RealInputs trace = tests.take (ispow2RealInputs trace).length ∧
  (ispow2RealInputs trace).length ≤ tests.length ∧
  tests.length ≤ (ispow2RealInputs trace).length + 1 ∧
  greater.length + (ispow2CustomInputs trace).length ≤ 1 ∧
  ones = greater.take ones.length ∧ ones.length ≤ greater.length ∧
  equal = (ispow2OnesOutputs trace).take equal.length ∧ equal.length ≤ ones.length ∧
  (∀ value, value ∈ greater → value ∈ x :: ispow2RealOutputs trace) ∧
  (∀ value zero result, IsPow2Event.greater value zero result ∈ trace → zero.val = 0) ∧
  (∀ value one result, IsPow2Event.equal value one result ∈ trace → one.val = 1)

/-- A successful result comes from an actual terminal callee unchanged, or
is exactly Bool false from a short-circuiting false condition. In particular
custom non-Bool equality/ispow2 results are not coerced to Bool. Errors stop
