    JuliaLean.base.io.M (DecWorld (W × List E)) A := fun (((world, trace), header), heap) =>
  match recordCall event action (((world, header), heap), trace) with
  | none => none
  | some (.ok (value, (((world, header), heap), trace))) =>
      some (.ok (value, (((world, trace), header), heap)))
  | some (.error (error, (((world, header), heap), trace))) =>
      some (.error (error, (((world, trace), header), heap)))

