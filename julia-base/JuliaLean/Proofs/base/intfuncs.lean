/-! Mathematical result vocabulary. The component formula specifies both halves of a rational. -/
def BigRatValid (x : BigRat) : Prop :=
  0 ≤ x.den ∧ Nat.gcd x.num.natAbs x.den.natAbs = 1

def ExactRatOrOverflow {t : IntTy} (result : Jl (Rat t)) (n d : Int) : Prop :=
  if fits t n ∧ fits t d then
    ∃ r, result = .ok r ∧ r.num.val = n ∧ r.den.val = d
  else overflowError result

def BigRatResult (result : Jl BigRat) (n d : Int) : Prop :=
  ∃ r, result = .ok r ∧ r.num = n ∧ r.den = d

def gcdNumerator (xs : List (Int × Int)) : Int := xs.foldl (fun g x => gcdMath g x.1) 0
def gcdDenominator (xs : List (Int × Int)) : Int := xs.foldl (fun d x => lcmMath d x.2) 1
def lcmNumerator (xs : List (Int × Int)) : Int := lcmArrayMath (xs.map Prod.fst)
def lcmDenominator (xs : List (Int × Int)) : Int := xs.foldl (fun d x => gcdMath d x.2) 0

def PowermodNonnegative : Prop :=
  (∀ g : GmpPrimitives, GmpDocs g →
    ∀ (s e t : IntTy) (x : JInt s) (p : JInt e) (m : JInt t),
      0 ≤ p.val → m.val ≠ 0 → ∃ y,
        powermodBits (numberCallees g) x p m = .ok y ∧ y.val = fmod (x.val ^ p.val.toNat) m.val) ∧
  (∀ x p m : Int, 0 ≤ p → m ≠ 0 →
    bigPowermod x p m = .ok (fmod (x ^ p.toNat) m)) ∧
  (∀ (s e : IntTy) (x : JInt s) (p : JInt e) (m : Int), 0 ≤ p.val → m ≠ 0 →
    bigPowermod x.val p.val m = .ok (fmod (x.val ^ p.val.toNat) m)) ∧
  (∀ (t : IntTy) (x p : Int) (m : JInt t), t.bits = 128 → 0 ≤ p → m.val ≠ 0 →
    ∃ r, powermod_128 Subtype.val bigPowermod (JInt.convert (t.name) t) x p m = .ok r ∧
      r.val = fmod (x ^ p.toNat) m.val)
  ∧ (∀ g : GmpPrimitives, GmpDocs g →
    ∀ (t : IntTy) (x p : Int) (m : JInt t), 0 ≤ p → m.val ≠ 0 →
      ∃ r, mixedPowermod g x p m = .ok r ∧ r.val = fmod (x^p.toNat) m.val)
def LargeBaseSingleDigit : Prop :=
  ∀ (t b : IntTy) (x : JInt t) (base : JInt b),
    base.val > 1 → 0 < x.val → x.val < base.val →
    if fits .i64 base.val then
      ndigitsZeroBits digitCallees x base = .ok (JuliaLean.base.int.lit .i64 1) ∧
      ndigitsBits digitCallees x base (JuliaLean.base.int.lit .i64 1) = .ok 1
    else inexactError (ndigitsBits digitCallees x base (JuliaLean.base.int.lit .i64 1))
def StringRoundtrip : Prop :=
  (∀ (t b p : IntTy) (n : JInt t) (base : JInt b) (pad : JInt p), 2 ≤ base.val → base.val ≤ 62 →
    let effectivePad := min (max pad.val (IntTy.min .i64)) (IntTy.max .i64)
    if n.val < 0 ∧ effectivePad = IntTy.max .i64 then inexactError (stringBits digitCallees n base pad)
    else ∃ s, stringBits digitCallees n base pad = .ok s ∧
      StringRepresentation n.val base.val effectivePad s.bytes) ∧
  (∀ decimal (n base pad : Int), 2 ≤ base → base ≤ 62 →
    let effectivePad := min (max pad (IntTy.min .i64)) (IntTy.max .i64)
    if n < 0 ∧ effectivePad = IntTy.max .i64 then inexactError (bigString decimal n base pad)
    else ∃ s, bigString decimal n base pad = .ok s ∧ StringRepresentation n base effectivePad s.bytes)
def BinomialNonnegativePolynomial : Prop := ∀ (t : IntTy) (n : JInt t), 0 ≤ n.val →
  ∀ z : Int,
    (∀ k : Nat, k ≤ n.val.toNat →
      ExactOrOverflow (binomialBits n (JuliaLean.base.int.lit t k)) (chooseMath n.val.toNat k : Int)) ∧
    (∀ coeffs : List (JInt t), coeffs.length = n.val.toNat + 1 →
      (∀ k : Nat, k ≤ n.val.toNat →
        ∃ c, coeffs[k]? = some c ∧ binomialBits n (JuliaLean.base.int.lit t k) = .ok c) →
      ((coeffs.zipIdx).foldl (fun total ck => total + ck.1.val * z ^ ck.2) 0) = (1+z)^n.val.toNat)
def GcdUnaryExact : Prop :=
  (∀ (t : IntTy) (x : JInt t),
    ExactOrOverflow (gcd_Unary_Integer JuliaLean.base.checked.checkedAbsBits x) (x.val.natAbs : Int) ∧
    ExactOrOverflow (lcm_Unary (gcd_Unary_Integer JuliaLean.base.checked.checkedAbsBits) x) (x.val.natAbs : Int)) ∧
  (∀ x : Int, gcd_Unary_Integer bigOps.checkedAbs x = .ok (x.natAbs : Int) ∧
    lcm_Unary (gcd_Unary_Integer bigOps.checkedAbs) x = .ok (x.natAbs : Int)) ∧
  (∀ (t : IntTy) (x : Rat t), Normalized x →
    ExactRatOrOverflow (lcm_Unary ratUnary x) (x.num.val.natAbs : Int) x.den.val) ∧
  (∀ x : BigRat, BigRatValid x →
    BigRatResult (lcm_Unary bigRatUnary x) (x.num.natAbs : Int) x.den)

def RationalUnaryAllWidths : Prop :=
  (∀ (t : IntTy) (x : Rat t), Normalized x →
    ExactRatOrOverflow (ratUnary x) (x.num.val.natAbs : Int) x.den.val) ∧
  (∀ x : BigRat, BigRatValid x → BigRatResult (bigRatUnary x) (x.num.natAbs : Int) x.den)
def NdigitsZeroAndDomain : Prop :=
  (∀ (t b p : IntTy) (base : JInt b) (pad : JInt p) (x : JInt t),
    ((-1 ≤ base.val ∧ base.val ≤ 1) → domainError (ndigitsZeroBits digitCallees x base)) ∧
    ((-1 ≤ base.val ∧ base.val ≤ 1) → domainError (ndigitsBits digitCallees x base pad)) ∧
    (2 ≤ base.val.natAbs → ndigitsZeroBits digitCallees (JuliaLean.base.int.lit t 0) base =
      .ok (JuliaLean.base.int.lit .i64 0)) ∧
    (2 ≤ base.val.natAbs → ndigitsBits digitCallees (JuliaLean.base.int.lit t 0) base pad = .ok (max pad.val 0)) ∧
    (base.val > 1 → ¬ fits .i64 base.val → x.val ≠ 0 → inexactError (ndigitsBits digitCallees x base pad))) ∧
  (∀ decimal (n base pad : Int),
    ((-1 ≤ base ∧ base ≤ 1) → domainError (bigNdigits decimal n base pad)) ∧
    (2 ≤ base.natAbs → bigNdigits decimal 0 base pad = .ok (max pad 0)) ∧
    (base > 1 → ¬ fits .i64 base → n ≠ 0 → inexactError (bigNdigits decimal n base pad)))
def PrimitiveBitstring : Prop :=
  JuliaLean.Proofs.base.intfuncs.BitstringExact ∧
  (∀ (bits : Nat) (x : BitVec bits), ∃ s, primitiveBitstring x = .ok s ∧
    s.bytes.length = bits ∧ ∀ j : Nat, j < bits →
      s.bytes[j]? = some (if x.toNat.testBit (bits-1-j) then 49 else 48)) ∧
  (∀ (T : FTy) (x : FV T), ∃ s, floatBitstring x = .ok s ∧ s.bytes.length = T.fmt.width ∧
    ∀ j : Nat, j < T.fmt.width → s.bytes[j]? = some
      (if x.toBits.testBit (T.fmt.width-1-j) then 49 else 48)) ∧
  (∀ (A : Type) (bits : Nat) (bitcast zext trunc : A → Nat) (shift : A → Nat → A) (x : A),
    argumentError (bitstring false bits bitcast zext trunc shift x))
def FactorialFallbackNoOverflow : Prop :=
  (∀ (t : IntTy) (n : JInt t), if n.val < 0 then domainError (factorialFallbackBits n)
    else ∃ r, factorialFallbackBits n = .ok r ∧ r.val = wrapInt t (factorialMath n.val.toNat : Int)) ∧
  JuliaLean.Proofs.base.intfuncs.FactorialGenericBig
private theorem factorialLoopWrapped {t : IntTy} (f1 : JInt t) (hf1 : f1.val = 1) :
    ∀ k : Nat, ((k + 1 : Nat) : Int) ≤ t.max →
    ∃ r : JInt t,
      (List.range k).foldlM (fun f (j : Nat) => do
        let i ← JInt.convert (t.name) t ((j : Int) + 2)
        pure (JuliaLean.base.int.mul f i)) f1 = .ok r ∧
      r.val = wrapInt t (factorialMath (k + 1) : Int) := by
  intro k
  induction k with
  | zero =>
    intro _
    refine ⟨f1, rfl, ?_⟩
    rw [hf1]
    have hfit : fits t 1 := by cases t <;> decide
    change (1 : Int) = wrapInt t 1
    exact (wrapInt_of_inRange t 1 hfit).symm
  | succ k ih =>
    intro hbound
    have hprev : ((k + 1 : Nat) : Int) ≤ t.max := by omega
    obtain ⟨r, hr, hrval⟩ := ih hprev
    have hmin : t.min ≤ 0 := by cases t <;> decide
    have hfactor : ((k : Int) + 2) ≤ t.max := by omega
    have hfit : fits t ((k : Int) + 2) := ⟨by omega, hfactor⟩
    let i : JInt t := ⟨(k : Int) + 2, hfit⟩
    have hconv : JInt.convert (t.name) t ((k : Int) + 2) = .ok i := by
      have hfit' : t.min ≤ (k : Int) + 2 ∧ (k : Int) + 2 ≤ t.max := hfit
      unfold JInt.convert
      rw [dif_pos hfit']
    have hfactNat : factorialMath (k + 2) = (k + 2) * factorialMath (k + 1) := rfl
    have hfact : (factorialMath (k + 2) : Int) =
        (factorialMath (k + 1) : Int) * ((k : Int) + 2) := by
      rw [hfactNat, Int.natCast_mul, Int.natCast_add]
      simp
      ac_rfl
    refine ⟨JuliaLean.base.int.mul r i, ?_, ?_⟩
    · rw [List.range_succ, List.foldlM_append, hr]
      simp [List.foldlM_cons, hconv, Bind.bind, Except.bind, Pure.pure, Except.pure]
    · rw [JuliaLean.base.int.mul, JuliaLean.Proofs.base.int.mul_int_val, hrval]
      rw [show i.val = (k : Int) + 2 by rfl,
        JuliaLean.Proofs.base.int.wrapInt_mul_left, ← hfact]

theorem factorialFallbackWrapped_proven : FactorialFallbackNoOverflow := by
  refine ⟨?_, JuliaLean.Proofs.base.intfuncs.factorialGenericBig_proven⟩
  intro t n
  by_cases hn : n.val < 0
  · rw [if_pos hn]
    simp [factorialFallbackBits, factorial_Integer, hn, domainError]
  · rw [if_neg hn]
    have hnonneg : 0 ≤ n.val := by omega
    have hfit1 : fits t 1 := by cases t <;> decide
    let f1 : JInt t := ⟨1, hfit1⟩
    have hconv1 : JInt.convert (t.name) t 1 = .ok f1 := by
      have hfit1' : t.min ≤ 1 ∧ 1 ≤ t.max := hfit1
      unfold JInt.convert
      rw [dif_pos hfit1']
    have hf1 : f1.val = 1 := rfl
    have hbase : factorialFallbackBits n = factorialLoop Subtype.val (JInt.convert (t.name) t)
        (fun x y => pure (JuliaLean.base.int.mul x y)) n f1 := by
      unfold factorialFallbackBits factorial_Integer
      rw [if_neg hn, hconv1]
      simp [Bind.bind, Except.bind, Pure.pure, Except.pure]
    by_cases hn0 : n.val = 0
    · refine ⟨f1, ?_, ?_⟩
      · rw [hbase]
        simp [factorialLoop, hn0, Pure.pure, Except.pure]
      · have hnat0 : n.val.toNat = 0 := by omega
        rw [hf1, hnat0]
        change (1 : Int) = wrapInt t 1
        exact (wrapInt_of_inRange t 1 hfit1).symm
    · let k : Nat := (n.val - 1).toNat
      have hnat : n.val.toNat = k + 1 := by dsimp [k]; omega
      have hbound : ((k + 1 : Nat) : Int) ≤ t.max := by
        rw [← hnat, Int.toNat_of_nonneg hnonneg]
        exact n.property.2
      obtain ⟨r, hr, hrval⟩ := factorialLoopWrapped f1 hf1 k hbound
      refine ⟨r, ?_, ?_⟩
      · rw [hbase]
        simpa [factorialLoop, k] using hr
      · rw [hrval, ← hnat]
/- A finite positive dyadic value is an integer power of two, including negative exponents. -/
def FloatPowerOfTwo {T : FTy} (x : FV T) : Prop :=
  x.isfinite = true ∧ 0 < x.toRat.1 ∧
    ((∃ k : Nat, x.toRat.1 = (x.toRat.2 : Int) * (2 : Int)^k) ∨
      (∃ k : Nat, x.toRat.1 * (2 : Int)^k = (x.toRat.2 : Int)))
def NumberPowerTwo : Prop :=
  (∀ (t : IntTy) (z : JuliaLean.base.complex.Complex (JInt t)),
    ispow2_Number (JuliaLean.base.complex.isreal_Complex (fun x => decide (x.val = 0)))
      JuliaLean.base.complex.real_Complex ispow2Bits z = true ↔
        z.im.val = 0 ∧ ∃ k : Nat, z.re.val = (2 : Int)^k) ∧
  (∀ z : JuliaLean.base.complex.Complex Int,
    ispow2_Number (JuliaLean.base.complex.isreal_Complex bigIntOps.iszero)
      JuliaLean.base.complex.real_Complex (ispow2_Integer bigOps.value bigOps.countOnes) z = true ↔
        z.im = 0 ∧ ∃ k : Nat, z.re = (2 : Int)^k) ∧
  (∀ (T : FTy) (x : FV T),
    ispow2_Number JuliaLean.base.complex.isreal_Real JuliaLean.base.complex.real_Real
      (ispow2_AbstractFloat JuliaLean.base.math.frexp) x = true ↔ FloatPowerOfTwo x) ∧
  (∀ (T : FTy) (z : JuliaLean.base.complex.Complex (FV T)),
    ispow2_Number (JuliaLean.base.complex.isreal_Complex iszero_float)
      JuliaLean.base.complex.real_Complex (ispow2_AbstractFloat JuliaLean.base.math.frexp) z = true ↔
        z.im.iszero = true ∧ FloatPowerOfTwo z.re)
  ∧ (∀ (t : IntTy) (z : JuliaLean.base.complex.Complex (Rat t)),
    Normalized z.re → Normalized z.im →
    (ispow2_Number (JuliaLean.base.complex.isreal_Complex
      (isZeroRationalSource (jintOps t).iszero)) JuliaLean.base.complex.real_Complex
      (isPow2RatSource ispow2Bits) z = true ↔ z.im.num.val = 0 ∧
        (∃ k : Nat, z.re.num.val = (2 : Int)^k) ∧ (∃ k : Nat, z.re.den.val = (2 : Int)^k)))
  ∧ (∀ z : JuliaLean.base.complex.Complex BigRat, BigRatValid z.re → BigRatValid z.im →
    (ispow2_Number (JuliaLean.base.complex.isreal_Complex
      (isZeroRationalSource bigIntOps.iszero)) JuliaLean.base.complex.real_Complex
      (isPow2RatSource (ispow2_Integer bigOps.value bigOps.countOnes)) z = true ↔
        z.im.num = 0 ∧ (∃ k : Nat, z.re.num = (2 : Int)^k) ∧ (∃ k : Nat, z.re.den = (2 : Int)^k)))
