theorem formattingNativeStoreFootprint_proven : FormattingNativeStoreFootprint := by
  intro W V ops p byte index world
  refine ⟨(JuliaLean.base.pointer.pointerSet formattingByteCodec world.2 p byte index (JuliaLean.base.int.lit .i64 1)).1,
    ?_, ?_, ?_⟩
  · unfold formattingStore formattingStoreNative formattingNativeWrite
      JuliaLean.base.io.getWorld JuliaLean.base.io.setWorld
    dsimp only
    rw [convert_self byte, convert_self index]
    cases world; rfl
  · unfold JuliaLean.base.pointer.pointerSet JuliaLean.base.pointer.ByteHeap.writeBytes
      JuliaLean.base.pointer.ByteHeap.writeByte JuliaLean.base.pointer.ByteHeap.readByte
      JuliaLean.base.pointer.addressMod
    rw [indexedPointer_byte_val p index]
    have henc : formattingByteCodec.encode byte = [byte] := rfl
    rw [henc]
    dsimp [JuliaLean.base.pointer.ByteHeap.writeBytes]
    simp
  · intro location hloc hne
    let address := (p.address.val + index.val - 1) % (2 ^ 64 : Int)
    have hnonneg : 0 ≤ address := Int.emod_nonneg _ (by decide)
    have hlt : address < (2 ^ 64 : Int) := Int.emod_lt_of_pos _ (by decide)
    have hnat_lt : address.toNat < 2 ^ 64 := by omega
    unfold JuliaLean.base.pointer.pointerSet JuliaLean.base.pointer.ByteHeap.writeBytes
      JuliaLean.base.pointer.ByteHeap.writeByte JuliaLean.base.pointer.ByteHeap.readByte
      JuliaLean.base.pointer.addressMod
    rw [indexedPointer_byte_val p index]
    have henc : formattingByteCodec.encode byte = [byte] := rfl
    rw [henc]
    dsimp [JuliaLean.base.pointer.ByteHeap.writeBytes]
    simp [Nat.mod_eq_of_lt hloc]
    intro heq
    exfalso
    apply hne
    omega


-- 1. General whileLoop invariant lemma for JuliaLean.base.io.whileLoop
theorem ioWhileLoop_invariant {World S A : Type}
    (step : S → JuliaLean.base.io.M World (Sum A S))
    (Inv : S → World → Prop)
    (Post : Except (JuliaLean.base.io.Error × World) (A × World) → Prop)
    (hstep : ∀ s w, Inv s w →
      match step s w with
      | none => True
      | some (.error ew) => Post (.error ew)
      | some (.ok (.inl a, w')) => Post (.ok (a, w'))
      | some (.ok (.inr s', w')) => Inv s' w') :
    ∀ s w out, JuliaLean.base.io.whileLoop step s w = some out → Inv s w → Post out := by
  apply JuliaLean.base.io.whileLoop.fixpoint_induct step
    (fun loop => ∀ s w out, loop s w = some out → Inv s w → Post out)
  · refine Lean.Order.admissible_pi_apply
      (fun (s : S) (f : JuliaLean.base.io.M World A) =>
        ∀ w out, f w = some out → Inv s w → Post out) ?_
    intro s
    refine Lean.Order.admissible_pi_apply
      (fun (w : World) (r : Option (Except (JuliaLean.base.io.Error × World) (A × World))) =>
        ∀ out, r = some out → Inv s w → Post out) ?_
    intro w
    refine Lean.Order.admissible_pi
      (fun (r : Option (Except (JuliaLean.base.io.Error × World) (A × World)))
           (out : Except (JuliaLean.base.io.Error × World) (A × World)) =>
        r = some out → Inv s w → Post out) ?_
    intro out
    exact Lean.Order.Option.admissible_eq_some (Inv s w → Post out) out
  · intro loop ih s w out hrun hinv
    have hs := hstep s w hinv
    cases hst : step s w with
    | none => simp [hst] at hrun
    | some r =>
      rw [hst] at hs
      cases r with
      | error ew =>
        simp [hst] at hrun
        subst hrun
        exact hs
      | ok vw =>
        rcases vw with ⟨sum, w'⟩
        cases sum with
        | inl a =>
          simp [hst] at hrun
          subst hrun
          exact hs
        | inr s' =>
          simp [hst] at hrun
          exact ih s' w' out hrun hs

theorem ioWhileLoop_run {World S A : Type}
    (step : S → JuliaLean.base.io.M World (Sum A S))
    (Inv : S → World → Prop)
    (Post : Except (JuliaLean.base.io.Error × World) (A × World) → Prop)
    (s0 : S) (w0 : World)
    (hinit : Inv s0 w0)
    (hstep : ∀ s w, Inv s w →
      match step s w with
      | none => True
      | some (.error ew) => Post (.error ew)
      | some (.ok (.inl a, w')) => Post (.ok (a, w'))
      | some (.ok (.inr s', w')) => Inv s' w') :
    ∀ out, JuliaLean.base.io.whileLoop step s0 w0 = some out → Post out :=
  fun out hrun => ioWhileLoop_invariant step Inv Post hstep s0 w0 out hrun hinit

theorem ioWhileLoop_of_eq_cases {World S A : Type}
    {step : S → JuliaLean.base.io.M World (Sum A S)}
    {s0 : S} {w0 : World}
    {out : Except (JuliaLean.base.io.Error × World) (A × World)}
    {Goal : Prop}
    (hrun : JuliaLean.base.io.whileLoop step s0 w0 = some out)
    (Inv : S → World → Prop)
    (Post : Except (JuliaLean.base.io.Error × World) (A × World) → Prop)
    (hgoal : Post out → Goal)
    (hinit : Inv s0 w0)
    (hstep : ∀ s w, Inv s w →
      match step s w with
      | none => True
      | some (.error ew) => Post (.error ew)
      | some (.ok (.inl a, w')) => Post (.ok (a, w'))
      | some (.ok (.inr s', w')) => Inv s' w') :
    Goal :=
  hgoal (ioWhileLoop_invariant step Inv Post hstep s0 w0 out hrun hinit)

theorem ioWhileLoop_of_eq_cases' {World S A : Type}
    {step : S → JuliaLean.base.io.M World (Sum A S)}
    (step' : S → JuliaLean.base.io.M World (Sum A S))
    {s0 : S} {w0 : World}
    {out : Except (JuliaLean.base.io.Error × World) (A × World)}
    {Goal : Prop}
    (hrun : JuliaLean.base.io.whileLoop step s0 w0 = some out)
    (Inv : S → World → Prop)
    (Post : Except (JuliaLean.base.io.Error × World) (A × World) → Prop)
    (hgoal : Post out → Goal)
    (hinit : Inv s0 w0)
    (heq : ∀ s w, step s w = step' s w)
    (hstep : ∀ s w, Inv s w →
      match step' s w with
      | none => True
      | some (.error ew) => Post (.error ew)
      | some (.ok (.inl a, w')) => Post (.ok (a, w'))
      | some (.ok (.inr s', w')) => Inv s' w') :
    Goal := by
  refine ioWhileLoop_of_eq_cases hrun Inv Post hgoal hinit (fun s w hinv => ?_)
  rw [heq s w]
  exact hstep s w hinv

@[simp] private theorem io_pure2 {W A : Type} (v : A) (w : W) :
    (pure v : JuliaLean.base.io.M W A) w = some (.ok (v, w)) := rfl

@[simp] private theorem io_bind2 {W A B : Type} (m : JuliaLean.base.io.M W A)
    (f : A → JuliaLean.base.io.M W B) (w : W) :
    (m >>= f) w = match m w with
      | none => none
      | some (.error e) => some (.error e)
      | some (.ok (v, w')) => f v w' := by
  change (m w).bind (fun r => match r with | .error error => some (.error error) | .ok (value, world) => f value world) = _
  cases m w with
  | none => rfl
  | some r => cases r <;> rfl

@[simp] private theorem io_throw2 {W A : Type} (e : JuliaLean.base.io.Error) (w : W) :
    (throw e : JuliaLean.base.io.M W A) w = some (.error (e, w)) := rfl

@[simp] private theorem io_liftJl2 {W A : Type} (x : Jl A) (w : W) :
    (JuliaLean.base.io.liftJl x : JuliaLean.base.io.M W A) w =
      match x with
      | .ok r => some (.ok (r, w))
      | .error e => some (.error (.jl e, w)) := by
  cases x <;> rfl


