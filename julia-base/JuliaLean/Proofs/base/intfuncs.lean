inductive PowerTailCall where
  | equal | orOther | less | diagnosticFloat | diagnosticNeg | customDiagnostic
  | power | apply | one | square | cube | inverse | inverseSquare
  | negExponent | powerOriginal | powerFloat | powerInverse
  deriving BEq, DecidableEq

/-- An observation records an actual invocation once, including reference
identities, mutable worlds and failure. It never replays a callee. -/
structure PowerTailEvent (World Atom : Type) where
  call : PowerTailCall
  arguments : List Atom
  before : World
  outcome : Except JuliaLean.base.io.Error Atom
  after : World

def powerTailObserve {World Atom Result : Type} (call : PowerTailCall)
    (arguments : List Atom) (encode : Result → Atom) (action : JuliaLean.base.io.M World Result) :
    JuliaLean.base.io.M (World × List (PowerTailEvent World Atom)) Result :=
  fun (world, trace) => match action world with
  | none => none
  | some (.ok (value, next)) =>
      some (.ok (value, (next, trace ++ [⟨call, arguments, world, .ok (encode value), next⟩])))
  | some (.error (error, next)) =>
      some (.error (error, (next, trace ++ [⟨call, arguments, world, .error error, next⟩])))

def powerTailCalls {W A : Type} (call : PowerTailCall) (trace : List (PowerTailEvent W A)) :=
  trace.filter (fun event => event.call == call)

def powerTailOutputs {W A : Type} (call : PowerTailCall) (trace : List (PowerTailEvent W A)) :=
  (powerTailCalls call trace).filterMap (fun event => event.outcome.toOption)

def powerTailErrors {W A : Type} (trace : List (PowerTailEvent W A)) : List JuliaLean.base.io.Error :=
  trace.filterMap fun event => match event.outcome with | .error e => some e | _ => none

/-- Independent conservation of mutable worlds, also for a method making no
calls. A failure or pure return cannot discard a completed mutation. -/
def PowerTailWorlds {W A : Type} (initial final : W) (trace : List (PowerTailEvent W A)) : Prop :=
  trace.map PowerTailEvent.before = (initial :: trace.map PowerTailEvent.after).take trace.length ∧
  final = ((trace.getLast?).map PowerTailEvent.after).getD initial

/-- A returned value is the actual last selected result; a propagated error
is the unique last failed call. This does not compute any expected result. -/
def PowerTailSelectedTerminal {W A : Type} (trace : List (PowerTailEvent W A)) :
    Except JuliaLean.base.io.Error A → Prop
  | .ok value => powerTailErrors trace = [] ∧
      ∃ event, trace.getLast? = some event ∧ event.outcome = .ok value
  | .error error => powerTailErrors trace = [error] ∧
      ∃ event, trace.getLast? = some event ∧ event.outcome = .error error

def PowerTailExecution {W A : Type}
    (action : JuliaLean.base.io.M (W × List (PowerTailEvent W A)) A) (world : W)
    (invariant : List (PowerTailEvent W A) → Prop)
    (terminal : List (PowerTailEvent W A) → Except JuliaLean.base.io.Error A → Prop) : Prop :=
  match action (world, []) with
  | none => True
  | some (.ok (value, (final, trace))) =>
      invariant trace ∧ PowerTailWorlds world final trace ∧ terminal trace (.ok value)
  | some (.error (error, (final, trace))) =>
      invariant trace ∧ PowerTailWorlds world final trace ∧ terminal trace (.error error)

inductive BoolPowerAtom (P Other F N : Type) where
  | exponent (value : P)
  | native (value : JInt64)
  | boolean (value : Bool)
  | other (value : Other)
  | value (value : BoolPowerValue Other)
  | diagnosticFloat (value : F)
  | diagnosticNeg (value : N)
  | unit

def observeBoolPowerOps {W P Other F N : Type} (ops : BoolPowerOps W P Other F N) :
    BoolPowerOps (W × List (PowerTailEvent W (BoolPowerAtom P Other F N))) P Other F N where
  equal p zero := powerTailObserve .equal [.exponent p, .native zero] .value (ops.equal p zero)
  orOther value x := powerTailObserve .orOther [.other value, .boolean x] .value (ops.orOther value x)
  less p zero := powerTailObserve .less [.exponent p, .native zero] .boolean (ops.less p zero)
  diagnostic := {
    float := fun p => powerTailObserve .diagnosticFloat [.exponent p] .diagnosticFloat (ops.diagnostic.float p)
    neg := fun p => powerTailObserve .diagnosticNeg [.exponent p] .diagnosticNeg (ops.diagnostic.neg p) }
  selectDiagnostic := fun x p => match ops.selectDiagnostic x p with
    | .integer => .integer
    | .custom callee => .custom (fun x p =>
        powerTailObserve .customDiagnostic [.boolean x, .exponent p] (fun _ => .unit) (callee x p))

def BoolPowerCausal {W P Other F N : Type} (integer : Bool) (x : Bool) (p : P)
    (before : List (PowerTailEvent W (BoolPowerAtom P Other F N)))
    (event : PowerTailEvent W (BoolPowerAtom P Other F N)) : Prop :=
  match event.call with
  | .less => integer = true ∧ before = [] ∧
      event.arguments = [.exponent p, .native (JuliaLean.base.int.lit .i64 0)]
  | .equal => event.arguments = [.exponent p, .native (JuliaLean.base.int.lit .i64 0)] ∧
      (integer = false ∨ powerTailOutputs .less before = [.boolean false] ∨
        (powerTailOutputs .less before = [.boolean true] ∧
          (x = true ∨ powerTailOutputs .customDiagnostic before = [.unit])))
  | .orOther => ∃ other, powerTailOutputs .equal before = [.value (.other other)] ∧
      event.arguments = [.other other, .boolean x]
  | .customDiagnostic => integer = true ∧ x = false ∧
      powerTailOutputs .less before = [.boolean true] ∧ event.arguments = [.boolean x, .exponent p]
  | .diagnosticFloat => integer = true ∧ x = false ∧
      powerTailOutputs .less before = [.boolean true] ∧ event.arguments = [.exponent p]
  | .diagnosticNeg => ∃ value, powerTailOutputs .diagnosticFloat before = [.diagnosticFloat value] ∧
      event.arguments = [.exponent p]
  | _ => False

def BoolPowerTerminal {W P Other F N : Type} (x : Bool)
    (trace : List (PowerTailEvent W (BoolPowerAtom P Other F N))) :
    Except JuliaLean.base.io.Error (BoolPowerAtom P Other F N) → Prop
  | .ok value => powerTailErrors trace = [] ∧
      (∃ event result, trace.getLast? = some event ∧ event.call = .orOther ∧
        event.outcome = .ok (.value result) ∧ value = .value result) ∨
      (powerTailErrors trace = [] ∧ ∃ event equal result,
        trace.getLast? = some event ∧ event.call = .equal ∧
        event.outcome = .ok (.value (.boolean equal)) ∧ value = .value (.boolean result) ∧
        (result = true ↔ equal = true ∨ x = true))
  | .error error =>
      PowerTailSelectedTerminal trace (.error error) ∨
      (powerTailErrors trace = [] ∧ error = .jl (.domainError "") ∧
        ∃ event value, trace.getLast? = some event ∧ event.call = .diagnosticNeg ∧
          event.outcome = .ok (.diagnosticNeg value))

/-- Full Bool-power invariants for all selected Integer/Unsigned operations.
They preserve arbitrary equality results, actual OR operands, diagnostic
order, short circuit, normal custom-diagnostic continuation and worlds/errors. In the concrete Bool OR branch the
returned truth value represents disjunction; no callback law is assumed.
Julia source: base/intfuncs.jl:444-448; Integer diagnostics:388-392. -/
def BoolPowerOpenDispatchProvenance : Prop :=
  ∀ (W P Other F N : Type) (ops : BoolPowerOps W P Other F N)
      (integer x : Bool) (p : P) (world : W),
    let observed := observeBoolPowerOps ops
    PowerTailExecution
      (do let result ← if integer then powerBoolInteger observed x p else powerBoolUnsigned observed x p
          pure (.value result)) world
      (fun trace =>
        trace.length ≤ 4 ∧
        (powerTailCalls .less trace).length = (if integer then 1 else 0) ∧
        (∀ call, (powerTailCalls call trace).length ≤ 1) ∧
        (∀ before event after, trace = before ++ event :: after → BoolPowerCausal integer x p before event))
      (BoolPowerTerminal x)

inductive PowerWrapperAtom (F A P R : Type) where
  | function (value : PowerTailFunction)
  | callable (value : F)
  | input (value : A)
  | exponent (value : P)
  | result (value : R)

def observePowerWrapperOps {W F A P R : Type} (ops : PowerWrapperOps W A P R) :
    PowerWrapperOps (W × List (PowerTailEvent W (PowerWrapperAtom F A P R))) A P R where
  call function x p := powerTailObserve .power [.function function, .input x, .exponent p]
    .result (ops.call function x p)

def PowerSingleCall {W Atom : Type} (call : PowerTailCall) (arguments : List Atom)
    (trace : List (PowerTailEvent W Atom)) : Prop :=
  trace.length = 1 ∧ ∀ event ∈ trace, event.call = call ∧ event.arguments = arguments

/-- All five call wrappers preserve the original callable identity and both
operands, perform exactly one selected call, return its actual heterogeneous
result, and conserve every world change or failure. P ranges over arbitrary
Val parameters, not an Int-only subset. These are observations of invocation
and causality, not an equation between the wrapper and its source body.
Julia source: base/intfuncs.jl:450,451,460,478,479. -/
def PowerCallIdentityAndEffects : Prop :=
  (∀ (W A R : Type) (ops : PowerWrapperOps W A A R) (x p : A) (world : W),
    PowerTailExecution
      (do pure (.result (← powInteger (observePowerWrapperOps (F := Unit) ops) x p))) world
      (PowerSingleCall .power [.function .powerBySquaring, .input x, .exponent p])
      PowerTailSelectedTerminal) ∧
  (∀ (W A P R : Type) (ops : PowerWrapperOps W A P R) (x : A) (p : P) (world : W),
    PowerTailExecution
      (do pure (.result (← powNumber (observePowerWrapperOps (F := Unit) ops) x p))) world
      (PowerSingleCall .power [.function .powerBySquaring, .input x, .exponent p])
      PowerTailSelectedTerminal) ∧
  (∀ (W F A P R : Type) (apply : F → A → P → JuliaLean.base.io.M W R)
      (f : F) (x : A) (p : P) (world : W),
    PowerTailExecution
      (do pure (PowerWrapperAtom.result (F := F) (A := A) (P := P)
        (← literalPowFunction (fun f x p => powerTailObserve .apply [.callable f, .input x, .exponent p]
          .result (apply f x p)) f x p))) world
      (PowerSingleCall .apply [.callable f, .input x, .exponent p]) PowerTailSelectedTerminal) ∧
  (∀ (W A P R : Type) (ops : PowerWrapperOps W A P R) (x : A) (p : P) (world : W),
    PowerTailExecution
      (do pure (.result (← literalFloatPower (observePowerWrapperOps (F := Unit) ops) x p))) world
      (PowerSingleCall .power [.function .basePower, .input x, .exponent p]) PowerTailSelectedTerminal) ∧
  (∀ (W A R : Type) (inv : A → JuliaLean.base.io.M W R) (x : A) (world : W),
    PowerTailExecution
      (do pure (PowerWrapperAtom.result (F := Unit) (A := A) (P := Unit)
        (← literalFloatNegOne (fun x => powerTailObserve .inverse [.input x] .result (inv x)) x))) world
      (PowerSingleCall .inverse [.input x]) PowerTailSelectedTerminal)

inductive HardwareLiteralCase where
  | zero | one | two | three | negOne | negTwo
  deriving BEq, DecidableEq

inductive HardwareLiteralAtom (A Square Inverse Result : Type) where
  | input (value : A)
  | square (value : Square)
  | inverse (value : Inverse)
  | result (value : Result)

def observeHardwareLiteralOps {W A S I R : Type} (ops : HardwareLiteralOps W A S I R) :
    HardwareLiteralOps (W × List (PowerTailEvent W (HardwareLiteralAtom A S I R))) A S I R where
  one x := powerTailObserve .one [.input x] .result (ops.one x)
  square x y := powerTailObserve .square [.input x, .input y] .square (ops.square x y)
  cube x y z := powerTailObserve .cube [.input x, .input y, .input z] .result (ops.cube x y z)
  inv x := powerTailObserve .inverse [.input x] .inverse (ops.inv x)
  inverseSquare x y := powerTailObserve .inverseSquare [.inverse x, .inverse y] .result (ops.inverseSquare x y)

/-- Select a model for observation; the identity branch reuses its already
faithful installed declaration. This runner is not an expected-result model. -/
def observeHardwareLiteral {W A S I R : Type} (ops : HardwareLiteralOps W A S I R)
    (kind : HardwareLiteralCase) (x : A) :
    JuliaLean.base.io.M (W × List (PowerTailEvent W (HardwareLiteralAtom A S I R)))
      (HardwareLiteralAtom A S I R) := do
  let observed := observeHardwareLiteralOps ops
  match kind with
  | .zero => pure (.result (← literalHardwareZero observed x))
  | .one => pure (.input (JuliaLean.base.intfuncs.literalPow_One x))
  | .two => pure (.square (← literalHardwareTwo observed x))
  | .three => pure (.result (← literalHardwareThree observed x))
  | .negOne => pure (.inverse (← literalHardwareNegOne observed x))
  | .negTwo => pure (.result (← literalHardwareNegTwo observed x))

def HardwareLiteralCausal {W A S I R : Type} (kind : HardwareLiteralCase) (x : A)
    (before : List (PowerTailEvent W (HardwareLiteralAtom A S I R)))
    (event : PowerTailEvent W (HardwareLiteralAtom A S I R)) : Prop :=
  match event.call with
  | .one => kind = .zero ∧ before = [] ∧ event.arguments = [.input x]
  | .square => kind = .two ∧ before = [] ∧ event.arguments = [.input x, .input x]
  | .cube => kind = .three ∧ before = [] ∧ event.arguments = [.input x, .input x, .input x]
  | .inverse => (kind = .negOne ∨ kind = .negTwo) ∧ before = [] ∧ event.arguments = [.input x]
  | .inverseSquare => kind = .negTwo ∧ ∃ inverse,
      powerTailOutputs .inverse before = [.inverse inverse] ∧ event.arguments = [.inverse inverse, .inverse inverse]
  | _ => False

/-- Full HWNumber literal family, including complex/rational members and
heterogeneous selected results. Cube preserves the three-argument multiplication dispatch; inverse-square uses
one inverse result twice. The identity case preserves reference identity and
makes no calls. Arbitrary effects/errors remain unconstrained and conserved.
Julia source: base/intfuncs.jl:470-475. -/
def HardwareLiteralProvenance : Prop :=
  ∀ (W A S I R : Type) (ops : HardwareLiteralOps W A S I R)
      (kind : HardwareLiteralCase) (x : A) (world : W),
    PowerTailExecution (observeHardwareLiteral ops kind x) world
      (fun trace => trace.length ≤ 2 ∧
        (∀ call, (powerTailCalls call trace).length ≤ 1) ∧
        (∀ before event after, trace = before ++ event :: after → HardwareLiteralCausal kind x before event))
      (fun trace outcome =>
        match kind, outcome with
        | .one, .ok value => trace = [] ∧ value = .input x
        | .one, .error _ => False
        | _, .ok value => PowerTailSelectedTerminal trace (.ok value) ∧
            trace.length = (if kind = .negTwo then 2 else 1)
        | _, .error error => PowerTailSelectedTerminal trace (.error error))

inductive LiteralFallbackAtom (A P Negative Inverse R : Type) where
  | original (value : LiteralPowerArgument A)
  | other (value : A)
  | exponent (value : P)
  | native (value : JInt64)
  | negative (value : Negative)
  | inverse (value : Inverse)
  | floating (value : JuliaLean.base.float.FV .f64)
  | function (value : PowerTailFunction)
  | boolean (value : Bool)
  | result (value : R)

def observeLiteralBasePowerOps {W A P N I R : Type} (ops : LiteralBasePowerOps W A P N I R) :
    LiteralBasePowerOps (W × List (PowerTailEvent W (LiteralFallbackAtom A P N I R))) A P N I R where
  less p zero := powerTailObserve .less [.exponent p, .native zero] .boolean (ops.less p zero)
  inv x := powerTailObserve .inverse [.other x] .inverse (ops.inv x)
  neg p := powerTailObserve .negExponent [.exponent p] .negative (ops.neg p)
  powerOriginal function x p := powerTailObserve .powerOriginal [.function function, .original x, .exponent p]
    .result (ops.powerOriginal function x p)
  powerFloat function x p := powerTailObserve .powerFloat [.function function, .floating x, .exponent p]
    .result (ops.powerFloat function x p)
  powerInverse function x p := powerTailObserve .powerInverse [.function function, .inverse x, .negative p]
    .result (ops.powerInverse function x p)

def LiteralFallbackCausal {W A P N I R : Type} (x : LiteralPowerArgument A) (p : P)
    (before : List (PowerTailEvent W (LiteralFallbackAtom A P N I R)))
    (event : PowerTailEvent W (LiteralFallbackAtom A P N I R)) : Prop :=
  match event.call with
  | .less => before = [] ∧ event.arguments = [.exponent p, .native (JuliaLean.base.int.lit .i64 0)]
  | .inverse => ∃ other, x = .other other ∧ powerTailOutputs .less before = [.boolean true] ∧
      event.arguments = [.other other]
  | .negExponent => (∃ inverse, powerTailOutputs .inverse before = [.inverse inverse]) ∧
      event.arguments = [.exponent p]
  | .powerOriginal => powerTailOutputs .less before = [.boolean false] ∧
      event.arguments = [.function .basePower, .original x, .exponent p]
  | .powerFloat => ∃ type width value, x = .native64 type width value ∧
      powerTailOutputs .less before = [.boolean true] ∧
      event.arguments = [.function .basePower,
        .floating (JuliaLean.base.float.floatOfInt .f64 value), .exponent p]
  | .powerInverse => ∃ inverse negative,
      powerTailOutputs .inverse before = [.inverse inverse] ∧
      powerTailOutputs .negExponent before = [.negative negative] ∧
      event.arguments = [.function .basePower, .inverse inverse, .negative negative]
  | _ => False

/-- Every representable Val parameter and every base value obey operand,
function identity and result provenance. Negative non-native bases invert
before negating the exponent; BitInteger64 bases use the installed Float64
conversion without inverse or exponent negation. At most four selected calls
occur, and the first error retains its world. No selected arithmetic law or
native-only premise is required. Julia source: base/intfuncs.jl:483-493. -/
def LiteralFallbackProvenance : Prop :=
  ∀ (W A P N I R : Type) (ops : LiteralBasePowerOps W A P N I R)
      (x : LiteralPowerArgument A) (p : P) (world : W),
    PowerTailExecution
      (do pure (.result (← literalBasePower (observeLiteralBasePowerOps ops) x p))) world
      (fun trace => 1 ≤ trace.length ∧ trace.length ≤ 4 ∧
        (powerTailCalls .less trace).length = 1 ∧
        (∀ call, (powerTailCalls call trace).length ≤ 1) ∧
        (powerTailCalls .powerOriginal trace).length + (powerTailCalls .powerFloat trace).length +
          (powerTailCalls .powerInverse trace).length ≤ 1 ∧
        (∀ before event after, trace = before ++ event :: after → LiteralFallbackCausal x p before event))
      PowerTailSelectedTerminal

/-- The native adapter preserves machine wrapping, including signed-minimum
negation, rather than silently changing exponent arithmetic to unbounded Int.
This is an independent mathematical value/state invariant on the adapter.
Julia source: base/intfuncs.jl:484,488; installed unary negation:base/int.jl. -/
def LiteralNativeExponentWrapping : Prop :=
  ∀ (W A I R : Type) (t : IntTy) (inv : A → JuliaLean.base.io.M W I)
      (original : PowerTailFunction → LiteralPowerArgument A → JInt t → JuliaLean.base.io.M W R)
      (floating : PowerTailFunction → JuliaLean.base.float.FV .f64 → JInt t → JuliaLean.base.io.M W R)
      (inverse : PowerTailFunction → I → JInt t → JuliaLean.base.io.M W R)
      (p : JInt t) (world : W),
    let ops := literalNativeExponentOps t inv original floating inverse
    (∃ result, ops.neg p world = some (.ok (result, world)) ∧
      result.val = (JInt.wrap t (-p.val)).val) ∧
    (∃ result, ops.less p (JuliaLean.base.int.lit .i64 0) world = some (.ok (result, world)) ∧
      (result = true ↔ p.val < 0))

