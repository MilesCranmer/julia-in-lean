/-! Proof component: Digits.lean -/

namespace JuliaLean.ChatGPT.Batch4.Group12
open JuliaLean JuliaLean.base.intfuncs JuliaLean.Proofs.base.intfuncs

namespace DigitWork

def fill {A : Type} (digit : Nat → A) (n : Nat) (before : Vector A) : Vector A :=
  (List.range n).foldl (fun a (j : Nat) => vectorStore a (a.first + j) (digit j)) before

theorem fill_succ {A : Type} (digit : Nat → A) (n : Nat) (before : Vector A) :
    fill digit (n + 1) before =
      vectorStore (fill digit n before) ((fill digit n before).first + n) (digit n) := by
  simp only [fill, List.range_succ, List.foldl_append, List.foldl_cons, List.foldl_nil]

theorem fill_first_length {A : Type} (digit : Nat → A) (n : Nat) (before : Vector A) :
    (fill digit n before).first = before.first ∧
      (fill digit n before).values.length = before.values.length := by
  induction n with
  | zero => exact ⟨rfl, rfl⟩
  | succ n ih =>
    rw [fill_succ]
    simpa only [vectorStore, List.length_set] using ih

theorem fill_get {A : Type} (digit : Nat → A) (n : Nat) (before : Vector A)
    (hn : n ≤ before.values.length) (j : Nat) (hj : j < n) :
    (fill digit n before).values[j]? = some (digit j) := by
  induction n with
  | zero => omega
  | succ n ih =>
    rw [fill_succ]
    have hidx : ((fill digit n before).first + (n : Int) -
        (fill digit n before).first).toNat = n := by omega
    simp only [vectorStore, hidx]
    by_cases he : n = j
    · subst j
      exact List.getElem?_set_self (by rw [(fill_first_length digit n before).2]; omega)
    · rw [List.getElem?_set_ne he]
      exact ih (by omega) (by omega)

theorem convert_value_self (t : IntTy) (name : String) (x : JInt t) :
    JInt.convert name t x.val = .ok x := by
  simp only [JInt.convert, dif_pos x.property]

theorem fill_convert (t : IntTy) (digit : Nat → JInt t) (before : Vector (JInt t)) :
    (List.range before.values.length).foldlM
      (fun a (j : Nat) => do
        let d ← JInt.convert t.name t (digit j).val
        pure (vectorStore a (a.first + j) d)) before =
      .ok (fill digit before.values.length before) := by
  simp only [convert_value_self, Bind.bind, Except.bind]
  exact List.foldlM_pure

def wrappedPowerDigit (j : Nat) : JInt .u64 :=
  JuliaLean.base.int.band
    (JuliaLean.base.int.shr_Int (JuliaLean.base.int.lit .u64 1)
      (JuliaLean.base.int.lit .i64 ((32 * j : Nat) : Int)))
    (JuliaLean.base.int.lit .u64 (2 ^ 32 - 1))

theorem wrappedPowerDigit_zero : (wrappedPowerDigit 0).val = 1 := by decide

theorem wrappedPowerDigit_repeat : (wrappedPowerDigit (2 ^ 59)).val = 1 := by decide


theorem digits_power_expand (before : Vector (JInt .u64)) :
    digitsBangBits before (JuliaLean.base.int.lit .u64 1)
      (JuliaLean.base.int.lit .u64 (2 ^ 32)) =
      if before.values.isEmpty then .ok before else
        (List.range before.values.length).foldlM
          (fun a (j : Nat) => do
            let d ← JInt.convert IntTy.u64.name .u64 (wrappedPowerDigit j).val
            pure (vectorStore a (a.first + j) d)) before := by
  rfl

theorem digits_power_fill (before : Vector (JInt .u64)) :
    digitsBangBits before (JuliaLean.base.int.lit .u64 1)
      (JuliaLean.base.int.lit .u64 (2 ^ 32)) =
      .ok (fill wrappedPowerDigit before.values.length before) := by
  rw [digits_power_expand]
  by_cases he : before.values.isEmpty = true
  · rw [if_pos he]
    have hnil : before.values = [] := List.isEmpty_iff.mp he
    simp only [hnil, List.length_nil, fill, List.range_zero, List.foldl_nil]
  · rw [if_neg he]
    exact fill_convert .u64 wrappedPowerDigit before

def symbolicVector : Vector (JInt .u64) :=
  ⟨1, List.replicate (2 ^ 59 + 1) (JuliaLean.base.int.lit .u64 0), []⟩

def symbolicOutput : Vector (JInt .u64) :=
  fill wrappedPowerDigit symbolicVector.values.length symbolicVector

theorem symbolicVector_length : symbolicVector.values.length = 2 ^ 59 + 1 := by
  exact List.length_replicate

theorem symbolicOutput_length : symbolicOutput.values.length = 2 ^ 59 + 1 := by
  exact (fill_first_length wrappedPowerDigit _ symbolicVector).2.trans symbolicVector_length

theorem symbolicOutput_at (j : Nat) (hj : j < 2 ^ 59 + 1) :
    symbolicOutput.values[j]? = some (wrappedPowerDigit j) := by
  exact fill_get wrappedPowerDigit symbolicVector.values.length symbolicVector
    (Nat.le_refl _) j (by rw [symbolicVector_length]; exact hj)

theorem symbolicOutput_first :
    (symbolicOutput.values[0]?).map Subtype.val = some 1 := by
  rw [symbolicOutput_at 0 (by decide)]
  exact congrArg some wrappedPowerDigit_zero

theorem symbolicOutput_repeated :
    (symbolicOutput.values[2 ^ 59]?).map Subtype.val = some 1 := by
  rw [symbolicOutput_at (2 ^ 59) (Nat.lt_succ_self _)]
  exact congrArg some wrappedPowerDigit_repeat

theorem symbolic_bang_call : digitsBangBits symbolicVector
    (JuliaLean.base.int.lit .u64 1) (JuliaLean.base.int.lit .u64 (2 ^ 32)) =
    .ok symbolicOutput := digits_power_fill symbolicVector

theorem symbolic_digit_count :
    ndigitsBits approvedRound2.Concrete.digitCallees (JuliaLean.base.int.lit .u64 1)
      (JuliaLean.base.int.lit .u64 (2 ^ 32)) (JuliaLean.base.int.lit .i64 (2 ^ 59 + 1)) =
      .ok (2 ^ 59 + 1) := by decide

theorem symbolic_zeros : zerosVector (JuliaLean.base.int.lit .u64 0) (2 ^ 59 + 1) =
    .ok symbolicVector := by rfl

theorem digits_type_ok {N B P T L : Type} (zeros : L → Jl (Vector T))
    (count : N → B → P → Jl L) (bang : Vector T → N → B → Jl (Vector T))
    (n : N) (base : B) (pad : P) (length : L) (before after : Vector T)
    (hc : count n base pad = .ok length) (hz : zeros length = .ok before)
    (hb : bang before n base = .ok after) :
    digits_Type zeros count bang n base pad = .ok after := by
  simp only [digits_Type, hc, Bind.bind, Except.bind, hz, hb]

theorem symbolic_digits_call :
    digitsBits approvedRound2.Concrete.digitCallees .u64
