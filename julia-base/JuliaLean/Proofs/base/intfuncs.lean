local instance (p : Prop) : Decidable p := Classical.propDecidable p

/-- `base/gmp.jl:48-57,68-71`: a BigInt has at most `typemax(Cint)` 64-bit limbs. -/
def BigIntRepresentable (n : Int) : Prop :=
  ∃ limbs : Nat, limbs ≤ 2147483647 ∧ n.natAbs < 2 ^ (64 * limbs)

/-- The native branch uses the existing rounding-only logarithm law, without the
inconsistent requirement that all three trial powers fit the base type. -/
def NextpowExact : Prop :=
  (∀ (a x : IntTy) (log : JInt a → JInt x → Jl Int),
    CeilLogRealLaw Subtype.val Subtype.val log →
    ∀ (base : JInt a) (input : JInt x),
    if input.val ≤ 0 ∨ base.val ≤ 1 then domainError (nextpowBits log base input)
    else if base.val ≠ 2 ∧ input.val > a.max then domainError (nextpowBits log base input)
    else
      ((∃ k : Nat, fits (if base.val = 2 then x else a) (base.val ^ k) ∧ input.val ≤ base.val ^ k) →
        ∃ y k, nextpowBits log base input = .ok y ∧ y = base.val ^ k ∧ input.val ≤ y ∧
          ∀ j : Nat, j < k → base.val ^ j < input.val)) ∧
  (∀ (A X : Type) (valA : A → Int) (valX : X → Int) (log : A → X → Jl Int),
    CeilLogRealLaw valA valX log →
    ∀ (base : A) (input : X),
    let result := nextpow (fun x => decide (valX x ≤ 0)) (fun _ => false) false
      (fun _ => .error (.methodError "_nextpow2"))
      (fun a => decide (valA a ≤ 1)) (fun x => decide (valX x ≤ 1)) (fun _ => (1 : Int))
      log (fun a n => pure ((valA a) ^ n.toNat)) (fun _ => false) (fun _ _ => false)
      (fun p x => decide (p ≥ valX x)) (fun p q => decide (p > q)) base input
    if valX input ≤ 0 ∨ valA base ≤ 1 then domainError result
    else (∀ k : Nat, (∀ j : Nat, j < k → (valA base) ^ j < valX input) → valX input ≤ (valA base) ^ k →
      result = .ok ((valA base) ^ k)))

/-- `base/intfuncs.jl:1342-1354,1373`: promotion does not restrict the negative-top identity. -/
def BinomialMixedExact : Prop := ∀ (s k : IntTy) (n : JInt s) (r : JInt k),
  match promoteBits n r with
  | .error e => binomialMixedBits n r = .error e
  | .ok (n', r') =>
      n'.val = n.val ∧ r'.val = r.val ∧
      binomialMixedBits n r = binomialBits n' r' ∧
      ExactOrOverflow (binomialMixedBits n r) (binomialMath n.val r.val)

def DefaultDecimalGeneric : Prop :=
  (∀ (t : IntTy) (x : JInt t), ∃ count,
