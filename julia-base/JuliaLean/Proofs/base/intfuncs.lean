    addBool := fun neg x => recordDecCall (.scalar .addBool) (ops.formatting.addBool neg x)
    addNative := fun x n => recordDecCall (.scalar .unused) (ops.formatting.addNative x n)
    divNative := fun x n => recordDecCall (.scalar .unused) (ops.formatting.divNative x n)
    stringRoute := ops.formatting.stringRoute
    toCsize := fun x => recordDecCall .size (ops.formatting.toCsize x)
    allocateString := fun n => recordDecCall .allocated (ops.formatting.allocateString n)
    customString := fun x => recordDecCall .customAllocated (ops.formatting.customString x)
    pointerOther := fun x => recordDecCall .pointer (ops.formatting.pointerOther x)
    greaterEqual := fun x n => recordDecCall (.condition .pair n.val) (ops.formatting.greaterEqual x n)
    greaterBool := fun x neg => recordDecCall (.condition .final (if neg then 1 else 0)) (ops.formatting.greaterBool x neg)
    lowByte := fun x => recordDecCall .byte (ops.formatting.lowByte x)
    shiftRight := fun x n => recordDecCall (.scalar .unused) (ops.formatting.shiftRight x n)
    subNative := fun x n => recordDecCall (.scalar .subIndex) (ops.formatting.subNative x n)
    toNativeIndex := fun x => recordDecCall (.index x) (ops.formatting.toNativeIndex x)
    storeByteRoute := ops.formatting.storeByteRoute
    customByteStore := fun p b i => recordDecCall .unit (ops.formatting.customByteStore p b i)
    storeOther := fun p b i => recordDecCall .unit (ops.formatting.storeOther p b i) }
  ndigits := fun x pad => recordDecCall (.ndigits x pad) (ops.ndigits x pad)
  greaterNative := fun x n => recordDecCall (.condition .outer n.val) (ops.greaterNative x n)
  greaterUInt := fun x n => recordDecCall (.condition .wide n.val) (ops.greaterUInt x n)
  divremChunk := fun x n => recordDecCall (.chunk x n) (ops.divremChunk x n)
  divrem100 := fun x n => recordDecCall (.hundred x n) (ops.divrem100 x n)
  indexedFirst := fun x i => recordDecCall (.first x i) (ops.indexedFirst x i)
  indexedFinal := fun x i s => recordDecCall (.final x i s) (ops.indexedFinal x i s)
  oftype := fun x q => recordDecCall (.oftype x q) (ops.oftype x q)
  rem32 := fun x => recordDecCall (.rem32 x) (ops.rem32 x)
  rem64 := fun x => recordDecCall (.rem64 x) (ops.rem64 x)
  remInt := fun x => recordDecCall (.scalar .remInt) (ops.remInt x)
  addIndexOne := fun one x => recordDecCall (.indexExpr one) (ops.addIndexOne one x)
  getOtherIndex := fun token x => recordDecCall (.tableOther token) (ops.getOtherIndex token x)
  shiftPairValue := fun x n => recordDecCall (.scalar .shiftPair) (ops.shiftPairValue x n)
  remByte := fun x => recordDecCall .byte (ops.remByte x)
  addByte := fun b x => recordDecCall .byte (ops.addByte b x)
  remTen := fun x n => recordDecCall (.scalar .remTen) (ops.remTen x n)
  valueStoreRoute := ops.valueStoreRoute
  customValueStore := fun p v i => recordDecCall .unit (ops.customValueStore p v i)
  convertByte := fun x => recordDecCall (.converted x) (ops.convertByte x)
  storeOtherValue := fun p v i => recordDecCall .unit (ops.storeOtherValue p v i)

