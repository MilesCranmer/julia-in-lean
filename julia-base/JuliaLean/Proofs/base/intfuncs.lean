/-!
# Specifications of `base/intfuncs.jl`

Mathematical integers, divisibility, powers, polynomial evaluation, and numeral decoding below
are specification vocabulary. They do not call the algorithms being specified. The laws for
external callees describe division, GMP arithmetic, square-root rounding, and logarithm seeds.
-/

namespace JuliaLean.Proofs.base.intfuncs

open JuliaLean JuliaLean.base.intfuncs JuliaLean.Registry

private instance {α : Type} [DecidableEq α] : DecidableEq (Jl α)
  | .ok a, .ok b => match decEq a b with
    | .isTrue h => .isTrue (congrArg Except.ok h)
    | .isFalse h => .isFalse (fun e => h (Except.ok.inj e))
  | .error a, .error b => match decEq a b with
    | .isTrue h => .isTrue (congrArg Except.error h)
    | .isFalse h => .isFalse (fun e => h (Except.error.inj e))
  | .ok _, .error _ => .isFalse (fun e => nomatch e)
  | .error _, .ok _ => .isFalse (fun e => nomatch e)

def domainError {A : Type} : Jl A → Prop
  | .error (.domainError _) => True
  | _ => False

instance {A : Type} (r : Jl A) : Decidable (domainError r) := by
  cases r with
  | ok _ => exact isFalse not_false
  | error e => cases e <;> first | exact isTrue trivial | exact isFalse not_false

def overflowError {A : Type} : Jl A → Prop
  | .error (.overflowError _) => True
  | _ => False

instance {A : Type} (r : Jl A) : Decidable (overflowError r) := by
  cases r with
  | ok _ => exact isFalse not_false
  | error e => cases e <;> first | exact isTrue trivial | exact isFalse not_false

def argumentError {A : Type} : Jl A → Prop
  | .error (.argumentError _) => True
  | _ => False

instance {A : Type} (r : Jl A) : Decidable (argumentError r) := by
  cases r with
  | ok _ => exact isFalse not_false
  | error e => cases e <;> first | exact isTrue trivial | exact isFalse not_false

def inexactError {A : Type} : Jl A → Prop
  | .error (.inexactError _) => True
  | _ => False

instance {A : Type} (r : Jl A) : Decidable (inexactError r) := by
  cases r with
  | ok _ => exact isFalse not_false
  | error e => cases e <;> first | exact isTrue trivial | exact isFalse not_false

def divideError {A : Type} : Jl A → Prop
  | .error .divideError => True
  | _ => False

instance {A : Type} (r : Jl A) : Decidable (divideError r) := by
  cases r with
  | ok _ => exact isFalse not_false
  | error e => cases e <;> first | exact isTrue trivial | exact isFalse not_false

def fits (t : IntTy) (z : Int) : Prop := t.min ≤ z ∧ z ≤ t.max

instance (t : IntTy) (z : Int) : Decidable (fits t z) :=
  inferInstanceAs (Decidable (t.min ≤ z ∧ z ≤ t.max))

def ExactOrOverflow {t : IntTy} (result : Jl (JInt t)) (z : Int) : Prop :=
  if fits t z then ∃ r, result = .ok r ∧ r.val = z else overflowError result
def gcdMath (a b : Int) : Int := (Nat.gcd a.natAbs b.natAbs : Int)
def lcmMath (a b : Int) : Int := (Nat.lcm a.natAbs b.natAbs : Int)

def fmod (a m : Int) : Int :=
  if a % m = 0 ∨ m > 0 then a % m else a % m + m

def ModInverse (a m y : Int) : Prop := m ≠ 0 ∧ (a * y - 1) % m = 0 ∧ y.tdiv m = 0

def InverseResult (a m : Int) (result : Jl Int) : Prop :=
  if m = 0 ∨ gcdMath a m ≠ 1 then domainError result
  else ∃ y, result = .ok y ∧ ModInverse a m y

def ModularPower (x p m y : Int) : Prop :=
  if p ≥ 0 then y = fmod (x ^ p.toNat) m
  else ∃ inverse, ModInverse x m inverse ∧ y = fmod (inverse ^ p.natAbs) m

/-- Only promises of callees defined outside `intfuncs.jl` occur here. -/
def NumberLaws (c : NumberCallees) : Prop :=
  (∀ (s t : IntTy) (a : JInt s) (b : JInt t),
    c.mixedMod a b = if b.val = 0 then .error .divideError else .ok (fmod a.val b.val)) ∧
  (∀ a b : Int, ∃ g u v, c.gmpGcdx a b = .ok (g, u, v) ∧
    g = gcdMath a b ∧ a * u + b * v = g) ∧
  (∀ x p m : Int, m ≠ 0 → (p < 0 → gcdMath x m = 1) →
    ∃ y, c.gmpPowermod x p m = .ok y ∧ ModularPower x p m y) ∧
  (∀ x p : Int, divideError (c.gmpPowermod x p 0)) ∧
  (∀ (t : IntTy) (a b mm : JInt t) (mis : JuliaLean.base.multinverses.BitsMultiplicativeInverse t),
    t.signed = false → 0 < mm.val → fits t (a.val * b.val) →
    inverseForBits mm = .ok mis →
    c.magicMod a b mis = .ok (JuliaLean.base.int.lit t ((a.val * b.val) % mm.val)))

def quotientType (a b : IntTy) : IntTy :=
  if a.signed = b.signed then a.promote b
  else if a.signed then (a.toUnsigned.promote b.toUnsigned).toSigned
  else (a.toUnsigned.promote b.toUnsigned).toUnsigned

/-- Julia's mixed quotient returns the type-correct floor, ceiling, or truncated quotient. -/
def QuotientLaws (c : DigitCallees) : Prop :=
  ∀ (a b : IntTy) (up down : Bool) (x y : Int),
    fits a x → fits b y → y ≠ 0 →
    ¬ (a.signed = true ∧ x = a.min ∧ y = -1) →
    c.quotient a b up down x y = .ok
      (wrapInt (quotientType a b) (if up then -((-x).fdiv y) else if down then x.fdiv y else x.tdiv y))

def exactDigitCallees : DigitCallees where
  quotient a b up down x y :=
    if y = 0 ∨ (a.signed = true ∧ x = a.min ∧ y = -1) then .error .divideError
    else .ok (wrapInt (quotientType a b) (if up then -((-x).fdiv y) else if down then x.fdiv y else x.tdiv y))

theorem exactDigitCallees_laws : QuotientLaws exactDigitCallees := by
  intro a b up down x y _ _ hy hmin
  simp [exactDigitCallees, hy, hmin]

/-- Horner evaluation of digits in least-significant-first order. -/
def evalpoly (base : Int) : List Int → Int
  | [] => 0
  | d :: ds => d + base * evalpoly base ds

def DigitRange (n base : Int) (ds : List Int) : Prop :=
  ∀ d ∈ ds, d.natAbs < base.natAbs ∧
    (base < 0 → 0 ≤ d) ∧ (base > 0 → (n < 0 → d ≤ 0) ∧ (0 ≤ n → 0 ≤ d))

def DigitCount (n base pad count : Int) : Prop :=
  0 ≤ count ∧ pad ≤ count ∧
  if 0 < base then
    (n = 0 → count = max pad 0) ∧
    (n ≠ 0 → 1 ≤ count ∧ (n.natAbs : Int) < base ^ count.toNat ∧
      (pad < count → base ^ (count.toNat - 1) ≤ (n.natAbs : Int)))
  else
    ∃ ds : List Int, (ds.length : Int) = count ∧ evalpoly base ds = n ∧
      DigitRange n base ds ∧ (pad < count → ds.getLast? ≠ some 0)

def digitValue (base : Int) (ch : Nat) : Option Int :=
  if 48 ≤ ch ∧ ch ≤ 57 then some (ch - 48 : Nat)
  else if base.natAbs ≤ 36 ∧ 97 ≤ ch ∧ ch ≤ 122 then some (ch - 97 + 10 : Nat)
  else if 36 < base.natAbs ∧ 65 ≤ ch ∧ ch ≤ 90 then some (ch - 65 + 10 : Nat)
  else if 36 < base.natAbs ∧ 97 ≤ ch ∧ ch ≤ 122 then some (ch - 97 + 36 : Nat)
  else none

def decodeUnsigned (base : Int) (bytes : List Nat) : Option Int :=
  bytes.foldlM (fun n ch => do
    let d ← digitValue base ch
    if 0 ≤ d ∧ d < (base.natAbs : Int) then some (n * base + d) else none) 0

def decodeNumeral (base : Int) (bytes : List Nat) : Option Int :=
  match bytes with
  | 45 :: rest => if base > 0 then (decodeUnsigned base rest).map Int.neg else none
  | _ => decodeUnsigned base bytes

def digitCharacterCode (base digit : Int) : Nat :=
  if digit < 10 then 48 + digit.toNat
  else if base.natAbs ≤ 36 then 97 + (digit - 10).toNat
  else if digit < 36 then 65 + (digit - 10).toNat
  else 97 + (digit - 36).toNat

def digitsForBase (base : Int) (digits : List Int) : Prop :=
  ∀ d ∈ digits, 0 ≤ d ∧ d < base.natAbs

def numeralBytes (base : Int) (digits : List Int) : List Nat :=
  digits.reverse.map (digitCharacterCode base)

def StringRepresentation (n base pad : Int) (bytes : List Nat) : Prop :=
  2 ≤ base.natAbs ∧ base.natAbs ≤ 62 ∧
  let negSign : Nat := if base > 0 ∧ n < 0 then 1 else 0
  decodeNumeral base bytes = some n ∧
  negSign + (max 0 pad).toNat ≤ bytes.length ∧
  (negSign + (max 0 pad).toNat < bytes.length → (bytes.drop negSign).head? ≠ some 48)

def BufferSafe (b : Buffer) : Prop :=
  (∀ i ∈ b.writes, 1 ≤ i ∧ i ≤ (b.bytes.length : Int)) ∧
  (∀ r ∈ b.tableReads, 1 ≤ r.1 ∧ r.1 ≤ (r.2 : Int))

def factorialMath : Nat → Nat
  | 0 => 1
  | n + 1 => (n + 1) * factorialMath n

def chooseMath : Nat → Nat → Nat
  | _, 0 => 1
  | 0, _ + 1 => 0
  | n + 1, k + 1 => chooseMath n k + chooseMath n (k + 1)

def binomialMath (n k : Int) : Int :=
  if k < 0 then 0
  else if n ≥ 0 then (chooseMath n.toNat k.toNat : Int)
  else (-1 : Int) ^ k.toNat * (chooseMath (k - n - 1).toNat k.toNat : Int)

/-! ## Greatest common divisors and least common multiples -/

def GcdExact : Prop := ∀ (t : IntTy) (a b : JInt t),
  ExactOrOverflow (gcd_BitInteger a b) (gcdMath a.val b.val)

def GcdGenericExact : Prop :=
  (∀ a b : Int, gcd_Integer bigOps a b = .ok (gcdMath a b)) ∧
  (∀ xs : List Int,
    gcd_Array_Integer bigOps (gcd_Integer bigOps) xs =
      .ok ((xs.foldl (fun (g : Nat) x => Nat.gcd g x.natAbs) 0 : Nat) : Int))

def GcdTypeminOverflow : Prop := ∀ t : IntTy, t.signed = true →
  overflowError (gcd_BitInteger (JuliaLean.base.int.typemin t) (JuliaLean.base.int.typemin t))

def LcmExact : Prop := ∀ (t : IntTy) (a b : JInt t),
  ExactOrOverflow (lcmBits a b) (lcmMath a.val b.val)

def LcmGenericExact : Prop := ∀ a b : Int,
  lcm_Integer bigOps (gcd_Integer bigOps) a b = .ok (lcmMath a b)

def MixedLcmRepresentable : Prop := ∀ (s t : IntTy) (a : JInt s) (b : JInt t),
  fits (s.promote t) (lcmMath a.val b.val) →
  ∃ r, lcmMixedBits a b = .ok r ∧ r.val = lcmMath a.val b.val

def MixedGcdRepresentable : Prop := ∀ (s t : IntTy) (a : JInt s) (b : JInt t),
  (fits (s.promote t) (gcdMath a.val b.val) →
    (∃ r, gcdMixedBits a b = .ok r ∧ r.val = gcdMath a.val b.val) ∧
    (∃ d u v, gcdxMixedBits a b = .ok (d, u, v) ∧ d.val = gcdMath a.val b.val ∧
      (if (s.promote t).signed then a.val * u.val + b.val * v.val = d.val
       else (a.val * u.val + b.val * v.val - d.val) % (2 ^ (s.promote t).bits : Int) = 0))) ∧
  (fits (s.promote t) (lcmMath a.val b.val) →
    ∃ r, lcmMixedBits a b = .ok r ∧ r.val = lcmMath a.val b.val)

def lcmArrayMath : List Int → Int
  | [] => 1
  | x :: xs => xs.foldl (fun acc next => lcmMath acc next) x.natAbs

def GcdArrayRepresentable : Prop := ∀ (t : IntTy) (xs : List (JInt t)),
  fits t ((xs.foldl (fun (g : Nat) x => Nat.gcd g x.val.natAbs) 0 : Nat) : Int) →
  ∃ r, gcd_Array_Integer (bitsOps t) gcd_BitInteger xs = .ok r ∧
    r.val = ((xs.foldl (fun (g : Nat) x => Nat.gcd g x.val.natAbs) 0 : Nat) : Int)

def GcdArrayRealExact : Prop := ∀ (R : Type) (num den : R → Int) (zero : R)
    (promote : R → R → Jl (R × R)) (gcdPair : R → R → Jl R)
    (reduce : ArrayReduceCallees (List R) R) (xs : List R),
  num zero = 0 → den zero = 1 →
  (∀ a b, promote a b = .ok (a, b)) →
  (∀ ys init, reduce.withInit (gcd_Real promote gcdPair) ys init =
    ys.foldlM (gcd_Real promote gcdPair) init) →
  (∀ a b, ∃ r, gcdPair a b = .ok r ∧
    num r = gcdMath (num a) (num b) ∧ den r = lcmMath (den a) (den b)) →
  ∃ r, gcd_Array_Real ⟨reduce, gcd_Real promote gcdPair, zero⟩ xs = .ok r ∧
    num r = ((xs.foldl (fun (g : Nat) x => Nat.gcd g (num x).natAbs) 0 : Nat) : Int)

def GcdUnaryExact : Prop :=
  (∀ (t : IntTy) (x : JInt t),
    ExactOrOverflow (gcd_Unary_Integer JuliaLean.base.checked.checkedAbsBits x) (x.val.natAbs : Int) ∧
    ExactOrOverflow (lcm_Unary (gcd_Unary_Integer JuliaLean.base.checked.checkedAbsBits) x) (x.val.natAbs : Int)) ∧
  (∀ x : Int,
    gcd_Unary_Integer bigOps.checkedAbs x = .ok (x.natAbs : Int) ∧
    lcm_Unary (gcd_Unary_Integer bigOps.checkedAbs) x = .ok (x.natAbs : Int)) ∧
  (∀ (R : Type) (num den : R → Int) (ratio : Int → Int → Jl R),
    (∀ n d : Int, 0 < d → ∃ r, ratio n d = .ok r ∧ 0 < den r ∧ num r * d = n * den r) →
    ∀ a : R, 0 < den a → ∃ r,
      lcm_Unary (gcd_Unary_Rational num den bigOps.checkedAbs ratio) a = .ok r ∧
      num r * den a = (num a).natAbs * den r ∧ 0 ≤ num r ∧ 0 < den r)

def AbsDifferenceExact : Prop :=
  (∀ (t : IntTy) (x y : JInt t), t.signed = false →
    (absdiff_Unsigned maxBits minBits JuliaLean.base.int.sub x y).1.val = ((x.val - y.val).natAbs : Int) ∧
    (absdiff_Unsigned maxBits minBits JuliaLean.base.int.sub x y).2.val = ((x.val - y.val).natAbs : Int)) ∧
  (∀ (t : IntTy) (x y : JInt t), t.signed = true → fits t (x.val - y.val) →
    fits t ((x.val - y.val).natAbs : Int) →
    (absdiff_Signed JuliaLean.base.int.sub JuliaLean.base.int.abs x y).1.val = ((x.val - y.val).natAbs : Int) ∧
    (absdiff_Signed JuliaLean.base.int.sub JuliaLean.base.int.abs x y).2.val = x.val - y.val) ∧
  (∀ x y : Int,
    absdiff_Signed Int.sub bigOps.abs x y = (((x - y).natAbs : Int), x - y))

def BinaryGcdExactOnDomain : Prop := ∀ (t : IntTy) (a b : JInt t) (nonzero : b.val ≠ 0)
    (firstNotMin : t.signed = true → a.val ≠ t.min) (_ha0 : a.val ≠ 0),
  (binaryGcd a b nonzero firstNotMin).val = gcdMath a.val b.val

/-! ## Extended gcd and inverses -/

def GcdxBezout : Prop :=
  (∀ a b : Int,
    ∃ d u v, gcdx_Integer bigOps a b = .ok (d, u, v) ∧
      d = gcdMath a b ∧ a * u + b * v = d ∧
      ((a = 0 ∧ b = 0) → d = 0 ∧ u = 0 ∧ v = 0)) ∧
  (∀ (t : IntTy) (a b : JInt t),
    if fits t (gcdMath a.val b.val) then
      ∃ d u v, gcdxBits a b = .ok (d, u, v) ∧
        d.val = gcdMath a.val b.val ∧
        (a.val * u.val + b.val * v.val - d.val) % (2 ^ t.bits : Int) = 0 ∧
        ((a.val = 0 ∧ b.val = 0) → d.val = 0 ∧ u.val = 0 ∧ v.val = 0)
    else domainError (gcdxBits a b))

def GcdxStrictBounds : Prop :=
  (∀ (t : IntTy) (a b : JInt t),
    t.signed = true → a.val ≠ 0 → b.val ≠ 0 →
    if fits t (gcdMath a.val b.val) then
      ∃ d u v, gcdxBits a b = .ok (d, u, v) ∧
        u.val * a.val + v.val * b.val = d.val ∧
        u.val.natAbs < (b.val.tdiv d.val).natAbs ∧
        v.val.natAbs < (a.val.tdiv d.val).natAbs
    else domainError (gcdxBits a b)) ∧
  (∀ a b : Int, a ≠ 0 → b ≠ 0 →
    ∃ d u v, gcdx_Integer bigOps a b = .ok (d, u, v) ∧
      u * a + v * b = d ∧
      u.natAbs < (b.tdiv d).natAbs ∧
      v.natAbs < (a.tdiv d).natAbs)

def GcdxUnrepresentable : Prop := ∀ (t : IntTy) (a b : JInt t),
  ¬ fits t (gcdMath a.val b.val) → domainError (gcdxBits a b)

def GcdxNaryBezout : Prop :=
  (∀ (a b : Int) (cs : List Int),
    let args := a :: b :: cs
    ∃ (d u v : Int) (rest : List Int),
      gcdx_Nary (gcdx_Integer bigOps)
        (gcdx_Unary (gcd_Unary_Integer bigOps.checkedAbs)
          (fun x => decide (x < 0)) (fun _ => 1) Int.neg)
        Int.mul a b cs = .ok (d, u, v, rest) ∧
      let us := u :: v :: rest
      us.length = cs.length + 2 ∧
      d = ((args.foldl (fun (g : Nat) x => Nat.gcd g x.natAbs) 0 : Nat) : Int) ∧
      (args.zip us).foldl (fun z pair => z + pair.1 * pair.2) 0 = d) ∧
  (∀ (t : IntTy) (a b : JInt t) (cs : List (JInt t)),
    let args := a :: b :: cs
    let prefixesFit := ∀ (k : Nat), 2 ≤ k → k ≤ args.length →
      fits t (((args.take k).foldl (fun (g : Nat) x => Nat.gcd g x.val.natAbs) 0 : Nat) : Int)
    let computation :=
      gcdx_Nary gcdxBits
        (gcdx_Unary (gcd_Unary_Integer JuliaLean.base.checked.checkedAbsBits)
          (fun x => decide (x.val < 0)) (fun _ => JuliaLean.base.int.lit t 1) JuliaLean.base.int.neg)
        JuliaLean.base.int.mul a b cs
    (prefixesFit →
      ∃ (d u v : JInt t) (rest : List (JInt t)),
        computation = .ok (d, u, v, rest) ∧
        let us := u :: v :: rest
        us.length = cs.length + 2 ∧
        d.val = ((args.foldl (fun (g : Nat) x => Nat.gcd g x.val.natAbs) 0 : Nat) : Int) ∧
        (let total := (args.zip us).foldl (fun z pair => z + pair.1.val * pair.2.val) 0
         (total - d.val) % (2 ^ t.bits : Int) = 0)) ∧
    (¬ prefixesFit → domainError computation)) ∧
  (∀ (R : Type) (val : R → Int) (mul : R → R → R)
      (gcdxPair : R → R → Jl (R × R × R)) (unary : R → Jl (R × R)),
    (∀ x y, val (mul x y) = val x * val y) →
    (∀ x y, ∃ d u v, gcdxPair x y = .ok (d, u, v) ∧
      val d = gcdMath (val x) (val y) ∧ val x * val u + val y * val v = val d) →
    (∀ x, ∃ d u, unary x = .ok (d, u) ∧
      val d = (val x).natAbs ∧ val x * val u = val d) →
    ∀ (a b : R) (cs : List R),
      let args := a :: b :: cs
      ∃ d u v rest, gcdx_Nary gcdxPair unary mul a b cs = .ok (d, u, v, rest) ∧
        let us := u :: v :: rest
        us.length = cs.length + 2 ∧
        val d = ((args.foldl (fun (g : Nat) x => Nat.gcd g (val x).natAbs) 0 : Nat) : Int) ∧
        (args.zip us).foldl (fun z pair => z + val pair.1 * val pair.2) 0 = val d)

/-- Signed n-ary Bézout identity, `base/intfuncs.jl:196-204,228-233,264-274`. -/
def GcdxNarySignedExactBezout : Prop :=
  ∀ (t : IntTy), t.signed = true →
  ∀ (a b : JInt t) (cs : List (JInt t)) (d u v : JInt t) (rest : List (JInt t)),
    gcdx_Nary gcdxBits
      (gcdx_Unary (gcd_Unary_Integer JuliaLean.base.checked.checkedAbsBits)
        (fun x => decide (x.val < 0)) (fun _ => JuliaLean.base.int.lit t 1)
        JuliaLean.base.int.neg)
      JuliaLean.base.int.mul a b cs = .ok (d, u, v, rest) →
    ((a :: b :: cs).zip (u :: v :: rest)).foldl
      (fun total pair => total + pair.1.val * pair.2.val) 0 = d.val

def InvmodAllWidths : Prop := ∀ c : NumberCallees, NumberLaws c →
  ∀ (s t : IntTy) (n : JInt s) (m : JInt t),
  (s.signed = true ∧ t.signed = false ∧ s.bits = t.bits → n.val ≠ s.min) →
  (s.signed = false ∧ t.signed = true ∧ s.bits = t.bits → m.val ≠ t.min) →
  InverseResult n.val m.val (invmodBits c n m)

def RingInverseUnsigned : Prop := ∀ (t : IntTy) (n : JInt t), t.signed = false →
  if n.val % 2 = 0 then domainError (invmod_Ring n)
  else ∃ y, invmod_Ring n = .ok y ∧ (JuliaLean.base.int.mul n y).val = 1

def RingInverseSigned : Prop := ∀ (t : IntTy) (n : JInt t), t.signed = true →
  if n.val % 2 = 0 then domainError (invmod_Ring n)
  else ∃ y, invmod_Ring n = .ok y ∧ (JuliaLean.base.int.mul n y).val = 1

def RingInverseType : Prop := ∀ (s t : IntTy) (n : JInt s),
  if n.val % 2 = 0 then domainError (invmod_Type (JuliaLean.base.int.remT t) invmod_Ring n)
  else ∃ y, invmod_Type (JuliaLean.base.int.remT t) invmod_Ring n = .ok y ∧
    (n.val * y.val - 1) % (2 ^ t.bits : Int) = 0

/-! ## Powers and powers of two -/

def IntegerPowerExact : Prop := ∀ (t e : IntTy) (x : JInt t) (p : JInt e), 0 ≤ p.val →
  ∃ y, powerBits x p = .ok y ∧ y.val = wrapInt t (x.val ^ p.val.toNat)

def IntegerPowerNegative : Prop :=
  (∀ (t e : IntTy) (x : JInt t) (p : JInt e), p.val < 0 →
    if x.val = 1 ∨ (JuliaLean.base.int.neg x).val = 1 then
      ∃ y, powerBits x p = .ok y ∧ y.val = if p.val % 2 = 0 then 1 else x.val
    else domainError (powerBits x p)) ∧
  (∀ x p : Int, p < 0 →
    if x = 1 ∨ -x = 1 then
      ∃ y, powerBig x p = .ok y ∧ y = if p % 2 = 0 then 1 else x
    else domainError (powerBig x p))

def BigIntegerPowerExact : Prop := ∀ x p : Int, 0 ≤ p → powerBig x p = .ok (x ^ p.toNat)

def BoolPowerExact : Prop :=
  (∀ (e : IntTy) (x : Bool) (p : JInt e),
    if p.val < 0 ∧ x = false then domainError (powerBool_Integer Subtype.val x p)
    else ∃ result, powerBool_Integer Subtype.val x p = .ok result ∧
      result = (List.range p.val.toNat).foldl (fun acc _ => acc && x) true) ∧
  (∀ (x : Bool) (p : Int),
    if p < 0 ∧ x = false then domainError (powerBool_Integer id x p)
    else ∃ result, powerBool_Integer id x p = .ok result ∧
      result = (List.range p.toNat).foldl (fun acc _ => acc && x) true)

def LiteralPowerExact : Prop :=
  (∀ (t : IntTy) (x : JInt t), t.bits ≤ 64 →
    (literalPow_Zero (fun _ => JuliaLean.base.int.lit t 1) x).val = 1 ∧
    (literalPow_One x).val = x.val ∧
    (literalPow_Two (fun x y => pure (JuliaLean.base.int.mul x y)) x).map Subtype.val =
      .ok (wrapInt t (x.val ^ 2)) ∧
    (literalPow_Three (fun x y => pure (JuliaLean.base.int.mul x y)) x).map Subtype.val =
      .ok (wrapInt t (x.val ^ 3))) ∧
  (∀ (T : JuliaLean.base.float.FTy) (x : JuliaLean.base.float.FV T),
    literalPow_Zero (fun _ => JuliaLean.base.float.one_float T) x = JuliaLean.base.float.one_float T ∧
    literalPow_One x = x ∧
    literalPow_Two (fun a b => pure (JuliaLean.base.float.mul_IEEEFloat a b)) x =
      .ok (JuliaLean.base.float.mul_IEEEFloat x x) ∧
    literalPow_Three (fun a b => pure (JuliaLean.base.float.mul_IEEEFloat a b)) x =
      .ok (JuliaLean.base.float.mul_IEEEFloat (JuliaLean.base.float.mul_IEEEFloat x x) x))

def PowermodNonnegative : Prop := ∀ c : NumberCallees, NumberLaws c →
  ∀ (s e t : IntTy) (x : JInt s) (p : JInt e) (m : JInt t), 0 ≤ p.val → m.val ≠ 0 →
  ∃ y, powermodBits c x p m = .ok y ∧ y.val = fmod (x.val ^ p.val.toNat) m.val

def PowermodNegative : Prop := ∀ c : NumberCallees, NumberLaws c →
  ∀ (s e t : IntTy) (x : JInt s) (p : JInt e) (m : JInt t),
  p.val < 0 → m.val ≠ 0 → gcdMath x.val m.val = 1 →
  (s.signed = true ∧ t.signed = false ∧ s.bits = t.bits → x.val ≠ s.min) →
  (s.signed = false ∧ t.signed = true ∧ s.bits = t.bits → m.val ≠ t.min) →
  ∃ y, powermodBits c x p m = .ok y ∧ ModularPower x.val p.val m.val y.val

def PowermodTypeminResidue : Prop := ∀ c : NumberCallees, NumberLaws c →
  ∀ (t : IntTy) (x : JInt t), t.signed = true → x.val % 2 ≠ 0 →
  (powermodBits c x (JuliaLean.base.int.typemin t) (JuliaLean.base.int.typemin t)).map Subtype.val = .ok (t.min + 1)

def PowermodZeroModulus : Prop := ∀ c : NumberCallees, NumberLaws c →
  ∀ (s e t : IntTy) (x : JInt s) (p : JInt e), 0 ≤ p.val →
  divideError (powermodBits c x p (JuliaLean.base.int.lit t 0))

def IsPowerTwoExact : Prop :=
  (∀ (t : IntTy) (x : JInt t),
    ispow2Bits x = true ↔ ∃ k : Nat, x.val = (2 : Int) ^ k) ∧
  (∀ x : Int,
    ispow2_Integer bigOps.value bigOps.countOnes x = true ↔ ∃ k : Nat, x = (2 : Int) ^ k)

def NextpowLowerBound : Prop :=
  (∀ (t : IntTy) (log : JInt .i64 → JInt t → Jl Int)
      (x : JInt t) (r : Int), 0 < x.val →
    nextpowBits log (JuliaLean.base.int.lit .i64 2) x = .ok r → x.val ≤ r) ∧
  (∀ (log : Int → Int → Jl Int) (x r : Int),
    0 < x →
    nextpow (fun x => decide (x ≤ 0)) (fun a => decide (a = 2)) true
      (fun x => pure (2 ^ ((x - 1).toNat.log2 + 1) : Int))
      (fun a => decide (a ≤ 1)) (fun x => decide (x ≤ 1)) (fun _ => 1)
      log powerBig (fun _ => false) (fun _ _ => false)
      (fun p x => decide (p ≥ x)) (fun p q => decide (p > q)) 2 x = .ok r → x ≤ r)

def PrevpowTwoExact : Prop := ∀ (t : IntTy) (x : JInt t), 1 ≤ x.val →
  ∃ k : Nat, (prevpow2Bits x).val = (2 : Int) ^ k ∧
    (prevpow2Bits x).val ≤ x.val ∧ x.val < 2 * (prevpow2Bits x).val

/-- The ceiling-log callee is permitted its documented last-bit rounding error. -/
def CeilLogLaw {a x : IntTy} (log : JInt a → JInt x → Jl Int) : Prop :=
  ∀ (base : JInt a) (input : JInt x) (k : Nat), base.val > 1 → input.val > 1 →
    (∀ j : Nat, j < k → base.val ^ j < input.val) → input.val ≤ base.val ^ k →
    ∃ n, log base input = .ok n ∧ 1 ≤ n ∧ (n = (k : Int) - 1 ∨ n = k ∨ n = (k : Int) + 1) ∧
      (∀ j ∈ [n - 1, n, n + 1], base.val ^ j.toNat ≤ a.max)

def CeilLogRealLaw {A X : Type} (valA : A → Int) (valX : X → Int) (log : A → X → Jl Int) : Prop :=
  ∀ (base : A) (input : X) (k : Nat), valA base > 1 → valX input > 1 →
    (∀ j : Nat, j < k → (valA base) ^ j < valX input) → valX input ≤ (valA base) ^ k →
    ∃ n, log base input = .ok n ∧ 1 ≤ n ∧ (n = (k : Int) - 1 ∨ n = k ∨ n = (k : Int) + 1)

def NextpowExact : Prop :=
  (∀ (a x : IntTy) (log : JInt a → JInt x → Jl Int), CeilLogLaw log →
    ∀ (base : JInt a) (input : JInt x),
    if input.val ≤ 0 ∨ base.val ≤ 1 then domainError (nextpowBits log base input)
    else if base.val ≠ 2 ∧ input.val > a.max then domainError (nextpowBits log base input)
    else
      ((∃ k : Nat, fits (if base.val = 2 then x else a) (base.val ^ k) ∧ input.val ≤ base.val ^ k) →
        ∃ y k, nextpowBits log base input = .ok y ∧ y = base.val ^ k ∧ input.val ≤ y ∧
          ∀ j : Nat, j < k → base.val ^ j < input.val)) ∧
  (∀ (A X : Type) (valA : A → Int) (valX : X → Int) (log : A → X → Jl Int),
    CeilLogRealLaw valA valX log →
    ∀ (base : A) (input : X),
    let result := nextpow (fun x => decide (valX x ≤ 0)) (fun _ => false) false
      (fun _ => .error (.methodError "_nextpow2"))
      (fun a => decide (valA a ≤ 1)) (fun x => decide (valX x ≤ 1)) (fun _ => (1 : Int))
      log (fun a n => pure ((valA a) ^ n.toNat)) (fun _ => false) (fun _ _ => false)
      (fun p x => decide (p ≥ valX x)) (fun p q => decide (p > q)) base input
    if valX input ≤ 0 ∨ valA base ≤ 1 then domainError result
    else (∀ k : Nat, (∀ j : Nat, j < k → (valA base) ^ j < valX input) → valX input ≤ (valA base) ^ k →
      result = .ok ((valA base) ^ k)))

/-! ## Digit counts, extraction, formatting, and bit representations -/

def NegativeBaseTypeminBehavior : Prop := ∀ c : DigitCallees, QuotientLaws c →
  ∀ (t b : IntTy) (x : JInt t) (base : JInt b),
  base.val < -1 → 0 < x.val → x.val < -base.val →
  ndigitsZeroBits c x base = .ok (JuliaLean.base.int.lit .i64 1) ∧
  ndigitsBits c x base (JuliaLean.base.int.lit .i64 1) = .ok 1

def SignedTypeminBaseBehavior : Prop := ∀ c : DigitCallees, QuotientLaws c →
  ∀ (b p : IntTy) (x : JInt b) (pad : JInt p), b.signed = true →
  let count : Int := if x.val < 0 then 2 else if x.val = 0 then 0 else 1
  ndigitsZeroBits c x (JuliaLean.base.int.typemin b) = .ok (JuliaLean.base.int.lit .i64 count) ∧
  ndigitsBits c x (JuliaLean.base.int.typemin b) pad = .ok (max pad.val count)

def LargeBaseSingleDigit : Prop := ∀ c : DigitCallees, QuotientLaws c →
  ∀ (t b : IntTy) (x : JInt t) (base : JInt b),
  base.val > 1 → 0 < x.val → x.val < base.val →
  ndigitsZeroBits c x base = .ok (JuliaLean.base.int.lit .i64 1) ∧
  ndigitsBits c x base (JuliaLean.base.int.lit .i64 1) = .ok 1

def NdigitsExact : Prop :=
  (∀ c : DigitCallees, QuotientLaws c →
    ∀ (t b p : IntTy) (x : JInt t) (base : JInt b) (pad : JInt p),
    ((base.val < -1 ∧ (b.signed = false ∨ base.val ≠ b.min)) ∨
      (base.val > 1 ∧ fits .i64 base.val)) →
    ∃ count, ndigitsBits c x base pad = .ok count ∧ DigitCount x.val base.val pad.val count) ∧
  (∀ (x base pad : Int),
    base < -1 →
    ∃ count,
      ndigits
        (ndigitsZero id
          (ndigitsNegative id false Int.neg (fun x b => pure (x / b)) id Int.neg id id
            (fun x b => pure (-(x / (-b)))))
          (fun _ _ => .error (.domainError "")))
        (fun p d => pure (max p d.val)) x base pad = .ok count ∧
      DigitCount x base pad count)

def NdigitsZeroAndDomain : Prop := ∀ c : DigitCallees, QuotientLaws c →
  ∀ (t b p : IntTy) (base : JInt b) (pad : JInt p) (x : JInt t),
  ((-1 ≤ base.val ∧ base.val ≤ 1) → domainError (ndigitsZeroBits c x base)) ∧
  ((-1 ≤ base.val ∧ base.val ≤ 1) → domainError (ndigitsBits c x base pad)) ∧
  ((base.val < -1 ∨ base.val > 1) →
    ndigitsZeroBits c (JuliaLean.base.int.lit t 0) base = .ok (JuliaLean.base.int.lit .i64 0)) ∧
  ((base.val < -1 ∨ base.val > 1) →
    ndigitsBits c (JuliaLean.base.int.lit t 0) base pad = .ok (max pad.val 0)) ∧
  ((base.val > 1 ∧ ¬ fits .i64 base.val ∧ x.val ≠ 0) →
    inexactError (ndigitsBits c x base pad)) ∧
  ((base.val > 1 ∧ ¬ fits .i64 base.val ∧ x.val = 0) →
    ndigitsBits c x base pad = .ok (max pad.val 0))

def DigitsRoundtrip : Prop := ∀ c : DigitCallees, QuotientLaws c →
  ∀ (t b p e : IntTy) (n : JInt t) (base : JInt b) (pad : JInt p),
  (base.val < -1 ∨ base.val > 1) →
  (base.val.natAbs : Int) - 1 ≤ e.max →
  (base.val > 1 → n.val < 0 → e.signed = true) →
  if base.val > 1 ∧ ¬ fits .i64 base.val ∧ n.val ≠ 0 then
    inexactError (digitsBits c e n base pad)
  else if pad.val > IntTy.max .i64 then inexactError (digitsBits c e n base pad)
  else if b.signed = true ∧ base.val = b.min then domainError (digitsBits c e n base pad)
  else ∃ a, digitsBits c e n base pad = .ok a ∧
    digits_Default (digitsBits c b) n base pad = digitsBits c b n base pad ∧
    evalpoly base.val (a.values.map Subtype.val) = n.val ∧
    DigitCount n.val base.val pad.val a.values.length ∧ DigitRange n.val base.val (a.values.map Subtype.val)

def DigitsFillLowOrder : Prop :=
  (∀ (t b e : IntTy) (n : JInt t) (base : JInt b)
      (before after : Vector (JInt e)), digitsBangBits before n base = .ok after →
    after.first = before.first ∧ after.values.length = before.values.length ∧
    (∃ q : Int, evalpoly base.val (after.values.map Subtype.val) + base.val ^ before.values.length * q = n.val) ∧
    DigitRange n.val base.val (after.values.map Subtype.val)) ∧
  (∀ (n base : Int) (before after : Vector Int),
    digitsBang id bigOps false 0 false (JInt.convert (IntTy.i64.name) .i64)
      (fun x => (JuliaLean.base.int.cttz_int x).val.toNat) (fun _ _ _ => 0)
      (fun x b => if b = 0 then .error .divideError else pure (x.tdiv b, x.tmod b))
      (fun x b => if b = 0 then .error .divideError else pure (x / b, x % b))
      id Int.neg
      (fun x b => if b = 0 then .error .divideError else pure (x / b, x % b))
      pure before n base = .ok after →
    after.first = before.first ∧ after.values.length = before.values.length ∧
    (∃ q : Int, evalpoly base after.values + base ^ before.values.length * q = n) ∧
    DigitRange n base after.values)

def DigitsValidBase : Prop := ∀ c : DigitCallees, QuotientLaws c →
  (∀ (t : IntTy) (n : JInt t) (base : JInt .i64),
    (base.val ≤ -2 ∨ base.val ≥ 2) →
    ∃ a, digitsBits c .i64 n base (JuliaLean.base.int.lit .i64 1) = .ok a ∧
      evalpoly base.val (a.values.map Subtype.val) = n.val ∧
      DigitRange n.val base.val (a.values.map Subtype.val)) ∧
  (∀ (n : Int) (base : JInt .i64),
    (base.val ≤ -2 ∨ base.val ≥ 2) →
    ∃ a, digitsBang id (bitsOps .i64) false 0 false pure
      (fun x => (JuliaLean.base.int.cttz_int x).val.toNat) (fun _ _ _ => 0)
      (fun x b => if b.val = 0 then .error .divideError else pure (x.tdiv b.val, x.tmod b.val))
      (fun x b => if b.val = 0 then .error .divideError else pure (x / b.val, x % b.val))
      id Int.neg
      (fun x b => if b.val = 0 then .error .divideError else pure (x / b.val, x % b.val))
      pure ⟨1, [0], []⟩ n base = .ok a ∧
      DigitRange n base.val a.values)

def DigitsErrors : Prop :=
  (∀ (t b e : IntTy) (n : JInt t) (base : JInt b) (a : Vector (JInt e)),
    (((-1 ≤ base.val ∧ base.val ≤ 1) ∨
      (b.signed = true ∧ base.val = b.min)) → domainError (digitsBangBits a n base)) ∧
    ((b.signed = false ∨ base.val ≠ b.min) →
      (((base.val.natAbs : Int) - 1 > e.max ∧ 2 ≤ (base.val.natAbs : Int)) →
        argumentError (digitsBangBits a n base)))) ∧
  (∀ (V : Type) (hasMax : Bool) (elementMax : Int) (convert : Int → Jl V)
      (n base : Int) (a : Vector V),
    let call := digitsBang id bigOps hasMax elementMax false (JInt.convert (IntTy.i64.name) .i64)
      (fun x => (JuliaLean.base.int.cttz_int x).val.toNat) (fun _ _ _ => 0)
      (fun x b => if b = 0 then .error .divideError else pure (x.tdiv b, x.tmod b))
      (fun x b => if b = 0 then .error .divideError else pure (x / b, x % b))
      id Int.neg
      (fun x b => if b = 0 then .error .divideError else pure (x / b, x % b))
      convert a n base
    ((-1 ≤ base ∧ base ≤ 1) → domainError call) ∧
    ((hasMax = true ∧ (base.natAbs : Int) - 1 > elementMax ∧ 2 ≤ (base.natAbs : Int)) →
      argumentError call))

def StringRoundtrip : Prop := ∀ c : DigitCallees, QuotientLaws c →
  ∀ (t b p : IntTy) (n : JInt t) (base : JInt b) (pad : JInt p), 2 ≤ base.val → base.val ≤ 62 →
  let effectivePad := min (max pad.val (IntTy.min .i64)) (IntTy.max .i64)
  if n.val < 0 ∧ effectivePad = IntTy.max .i64 then inexactError (stringBits c n base pad)
  else ∃ s, stringBits c n base pad = .ok s ∧
    StringRepresentation n.val base.val effectivePad s.bytes

def StringNegativeBase : Prop := ∀ c : DigitCallees, QuotientLaws c →
  ∀ (t b p : IntTy) (n : JInt t) (base : JInt b) (pad : JInt p),
  -62 ≤ base.val → base.val ≤ -2 →
  let effectivePad := min (max pad.val (IntTy.min .i64)) (IntTy.max .i64)
  ∃ s, stringBits c n base pad = .ok s ∧
    StringRepresentation n.val base.val effectivePad s.bytes

def FormattingWriterResult (result : Jl Buffer) (value base pad : Int) (neg : Bool) : Prop :=
  if neg = true ∧ pad = IntTy.max .i64 then inexactError result
  else ∃ s, result = .ok s ∧ StringRepresentation value base pad s.bytes

def BaseStringPositive : Prop :=
  (∀ c : DigitCallees, QuotientLaws c →
    ∀ (t b : IntTy) (n : JInt t) (base : JInt b) (pad : JInt64) (neg : Bool),
    2 ≤ base.val → base.val ≤ 62 → 0 ≤ n.val → (neg = false ∨ 0 < n.val) →
    FormattingWriterResult (formatBase c base n pad neg)
      (if neg then -n.val else n.val) base.val pad.val neg) ∧
  (∀ (n base : Int) (pad : JInt64) (neg : Bool)
      (ndigitsFn : Int → JInt64 → JInt64 → Jl JInt64) (count : JInt64),
    2 ≤ base → base ≤ 62 → 0 ≤ n → (neg = false ∨ 0 < n) →
    ndigitsFn n (JuliaLean.base.int.lit .i64 base) pad = .ok count →
    DigitCount n base pad.val count.val →
    FormattingWriterResult
      (baseString bigOps bigOps (JuliaLean.base.int.lit .i64)
        (fun x b => if b = 0 then .error .divideError else pure (x.tmod b))
        (fun x b => if b = 0 then .error .divideError else pure (x.tdiv b))
        (fun x b => if b = 0 then .error .divideError else pure (x % b))
        (fun x b => if b = 0 then .error .divideError else pure (-(x / (-b))))
        ndigitsFn base n pad neg)
      (if neg then -n else n) base pad.val neg)

def BitstringExact : Prop := ∀ (t : IntTy) (x : JInt t), ∃ s,
  bitstringBits x = .ok s ∧ s.bytes.length = t.bits ∧
  (∀ j : Nat, j < t.bits → s.bytes[j]? = some (if (x.val % (2 ^ t.bits : Int)).toNat.testBit (t.bits - 1 - j) then 49 else 48))

def FormattingMemorySafe : Prop :=
  (∀ c : DigitCallees, QuotientLaws c →
    ∀ (t b p : IntTy) (n : JInt t) (base : JInt b) (pad : JInt p),
    2 ≤ base.val → base.val ≤ 62 →
    let effectivePad := min (max pad.val (IntTy.min .i64)) (IntTy.max .i64)
    if n.val < 0 ∧ effectivePad = IntTy.max .i64 then inexactError (stringBits c n base pad)
    else ∃ s, stringBits c n base pad = .ok s ∧ BufferSafe s) ∧
  (∀ c : DigitCallees, QuotientLaws c →
    ∀ (t b p : IntTy) (n : JInt t) (base : JInt b) (pad : JInt p),
    -62 ≤ base.val → base.val ≤ -2 → fits t.toSigned n.val →
    ∃ s, stringBits c n base pad = .ok s ∧ BufferSafe s) ∧
  (∀ (t : IntTy) (n : JInt t) (s : Buffer),
    bitstringBits n = .ok s → BufferSafe s)

def decodeBoolString : String → Option Bool
  | "true" => some true
  | "false" => some false
  | _ => none

def BoolStrings : Prop := ∀ b : Bool,
  decodeBoolString (string_Bool b) = some b ∧
    ∀ b', string_Bool b = string_Bool b' → b = b'

/-! ## Square roots, factorials, binomial coefficients, and clamping -/

def SqrtLaw (sqrt : {t : IntTy} → JInt t → Jl (JuliaLean.base.float.FV .f64)) : Prop :=
  ∀ (t : IntTy) (x : JInt t),
    (x.val < 0 → domainError (sqrt x)) ∧
    (0 ≤ x.val →
      ∃ s : JInt t,
        (do JuliaLean.base.float.intOfFloat t (JuliaLean.base.float.trunc_llvm (← sqrt x))) = .ok s ∧
        let k : Int := x.val.toNat.sqrt
        if t.bits = 64 ∨ t.bits = 128 then
          (x.val > 0 → 0 < s.val ∧ s.val + x.val.tdiv s.val ≤ t.max ∧
            let m := (s.val + x.val.tdiv s.val) / 2
            (m = k ∨ m = k + 1) ∧ m * m ≤ t.max)
        else s.val = k)

def IsqrtFloor : Prop :=
  (∀ sqrt, SqrtLaw sqrt → ∀ (t : IntTy) (x : JInt t),
    if x.val < 0 then domainError (isqrtBits sqrt x)
    else ∃ r, isqrtBits sqrt x = .ok r ∧ r.val ≥ 0 ∧
      r.val * r.val ≤ x.val ∧ x.val < (r.val + 1) * (r.val + 1)) ∧
  (∀ (I F R : Type) (val : I → Int) (sqrt : I → Jl F) (trunc : F → Jl R) (oftype : R → Jl I),
    (∀ x, val x < 0 → domainError (sqrt x)) →
    (∀ x, 0 ≤ val x → ∃ r, (do oftype (← trunc (← sqrt x))) = .ok r ∧ val r = (val x).toNat.sqrt) →
    ∀ x : I,
      if val x < 0 then domainError (isqrt_Integer sqrt trunc oftype x)
      else ∃ r, isqrt_Integer sqrt trunc oftype x = .ok r ∧ 0 ≤ val r ∧
        val r * val r ≤ val x ∧ val x < (val r + 1) * (val r + 1))

def FactorialFallbackNoOverflow : Prop :=
  (∀ (t : IntTy) (n : JInt t),
    (n.val < 0 → domainError (factorialFallbackBits n)) ∧
    (0 ≤ n.val → fits t (factorialMath n.val.toNat : Int) →
      ∃ r, factorialFallbackBits n = .ok r ∧ r.val = (factorialMath n.val.toNat : Int))) ∧
  (∀ (I F : Type) (value : I → Int) (valF : F → Int) (ofInt : Int → Jl F) (mul : F → F → Jl F),
    (∀ z, 1 ≤ z → ∃ f, ofInt z = .ok f ∧ valF f = z) →
    (∀ a b, ∃ r, mul a b = .ok r ∧ valF r = valF a * valF b) →
    ∀ n : I,
      if value n < 0 then domainError (factorial_Integer value ofInt mul n)
      else ∃ r, factorial_Integer value ofInt mul n = .ok r ∧
        valF r = (factorialMath (value n).toNat : Int))

def FactorialGenericBig : Prop := ∀ n : Int,
  if n < 0 then domainError (factorial_Integer id pure (fun x y => pure (x * y)) n)
  else factorial_Integer id pure (fun x y => pure (x * y)) n = .ok (factorialMath n.toNat : Int)

def BinomialExactAndOverflow : Prop := ∀ (t : IntTy) (n k : JInt t),
  ExactOrOverflow (binomialBits n k) (binomialMath n.val k.val)

def BinomialNonnegativeEdges : Prop := ∀ (t : IntTy) (n k : JInt t), 0 ≤ n.val →
  (k.val < 0 → (binomialBits n k).map Subtype.val = .ok 0) ∧
  (n.val < k.val → (binomialBits n k).map Subtype.val = .ok 0) ∧
  (k.val = 0 → (binomialBits n k).map Subtype.val = .ok 1)

def BinomialMixedExact : Prop := ∀ (s k : IntTy) (n : JInt s) (r : JInt k),
  (0 ≤ n.val ∨ -n.val + r.val - 1 ≤ (s.promote k).max) →
  match promoteBits n r with
  | .error e => binomialMixedBits n r = .error e
  | .ok (n', r') =>
      n'.val = n.val ∧ r'.val = r.val ∧
      binomialMixedBits n r = binomialBits n' r' ∧
      ExactOrOverflow (binomialMixedBits n r) (binomialMath n.val r.val)

structure ClampOrderOps (X L H O T : Type) where
  projectX : X → O
  projectLo : L → O
  projectHi : H → O
  projectT : T → O
  lt : O → O → Prop
  less : O → O → Bool
  lessSpec : ∀ x y, less x y = true ↔ lt x y
  irrefl : ∀ x, ¬ lt x x
  transitive : ∀ x y z, lt x y → lt y z → lt x z
  total : ∀ x y, lt x y ∨ x = y ∨ lt y x
  convertX : X → Jl T
  convertLo : L → Jl T
  convertHi : H → Jl T
  convertXSpec : ∀ x, ∃ t, convertX x = .ok t ∧ projectT t = projectX x
  convertLoSpec : ∀ lo, ∃ t, convertLo lo = .ok t ∧ projectT t = projectLo lo
  convertHiSpec : ∀ hi, ∃ t, convertHi hi = .ok t ∧ projectT t = projectHi hi

def ClampExact : Prop :=
  (∀ (X L H O T : Type) (order : ClampOrderOps X L H O T) (x : X) (lo : L) (hi : H),
    ¬ order.lt (order.projectHi hi) (order.projectLo lo) →
    ∃ y, clamp (fun x hi => order.less (order.projectHi hi) (order.projectX x))
      (fun x lo => order.less (order.projectX x) (order.projectLo lo))
      order.convertX order.convertLo order.convertHi x lo hi = .ok y ∧
      ¬ order.lt (order.projectT y) (order.projectLo lo) ∧
      ¬ order.lt (order.projectHi hi) (order.projectT y) ∧
      (¬ order.lt (order.projectX x) (order.projectLo lo) →
       ¬ order.lt (order.projectHi hi) (order.projectX x) →
       order.projectT y = order.projectX x)) ∧
  (∀ (t : IntTy) (x lo hi : JInt t), lo.val ≤ hi.val →
    ∃ y, clampBits x lo hi = .ok y ∧
      lo.val ≤ y.val ∧ y.val ≤ hi.val ∧
      y.val = min hi.val (max lo.val x.val))

def ClampTypeExact : Prop := ∀ (t : IntTy) (X : Type) (val : X → Int) (x : X),
  ∃ y,
    clamp_Type (JuliaLean.base.int.typemin t) (JuliaLean.base.int.typemax t)
      (fun x hi => decide (val x > hi.val))
      (fun x lo => decide (val x < lo.val))
      (fun x => JInt.convert (t.name) t (val x)) x = .ok y ∧
    t.min ≤ y.val ∧ y.val ≤ t.max ∧
    y.val = min t.max (max t.min (val x)) ∧
    (fits t (val x) → y.val = val x)

def ClampBangExact : Prop := ∀ {A Axis Index V L H O : Type} [DecidableEq Index]
    (index : JuliaLean.base.arraymath.ArrayIndexOps Id A Axis)
    (eachindex : JuliaLean.base.arraymath.ArrayIndexOps Id A Axis → A → Jl (List Index))
    (getindex : A → Index → Jl V) (setindex : A → Index → V → Jl A)
    (order : ClampOrderOps V L H O V) (x : A) (lo : L) (hi : H)
    (indices : List Index),
  let clampFn := clamp (fun v hi => order.less (order.projectHi hi) (order.projectX v))
    (fun v lo => order.less (order.projectX v) (order.projectLo lo))
    order.convertX order.convertLo order.convertHi
  ¬ order.lt (order.projectHi hi) (order.projectLo lo) →
  eachindex index x = .ok indices →
  indices.Nodup →
  (∀ a i, i ∈ indices → ∃ value, getindex a i = .ok value) →
  (∀ a i v, i ∈ indices → ∃ updated, setindex a i v = .ok updated) →
  (∀ a i v updated, i ∈ indices → setindex a i v = .ok updated →
    index.axes updated = index.axes a ∧
    getindex updated i = .ok v ∧
    ∀ j, j ≠ i → getindex updated j = getindex a j) →
  ∃ y, clampBang index eachindex getindex setindex clampFn x lo hi = .ok y ∧
    index.axes y = index.axes x ∧
    (∀ i, i ∈ indices →
      ∃ value clamped, getindex x i = .ok value ∧
        clampFn value lo hi = .ok clamped ∧
        getindex y i = .ok clamped ∧
        ¬ order.lt (order.projectT clamped) (order.projectLo lo) ∧
        ¬ order.lt (order.projectHi hi) (order.projectT clamped)) ∧
    (∀ i, i ∉ indices → getindex y i = getindex x i)

def GcdLcmNaryExact : Prop :=
  (∀ xs : List Int, ∀ a b : Int,
    gcd_Nary (gcd_Integer bigOps) (gcd_Unary_Integer bigOps.checkedAbs) a b xs =
      .ok ((a :: b :: xs).foldl gcdMath 0)) ∧
  (∀ xs : List Int, ∀ a b : Int,
    lcm_Nary (lcm_Integer bigOps (gcd_Integer bigOps))
      (lcm_Unary (gcd_Unary_Integer bigOps.checkedAbs)) a b xs =
      .ok ((a :: b :: xs).foldl lcmMath 1)) ∧
  (∀ (R : Type) (num den : R → Int) (promote : R → R → Jl (R × R))
      (gcdPair lcmPair : R → R → Jl R) (ratio : Int → Int → Jl R),
    (∀ x y, promote x y = .ok (x, y)) →
    (∀ x y, ∃ r, gcdPair x y = .ok r ∧ num r = gcdMath (num x) (num y) ∧ den r = lcmMath (den x) (den y)) →
    (∀ x y, ∃ r, lcmPair x y = .ok r ∧ num r = lcmMath (num x) (num y) ∧ den r = gcdMath (den x) (den y)) →
    (∀ n d, ∃ r, ratio n d = .ok r ∧ num r = n ∧ den r = d.natAbs) →
    ∀ (a b : R) (cs : List R),
      let args := a :: b :: cs
      (∃ r, gcd_Nary (gcd_Real promote gcdPair) (gcd_Unary_Rational num den bigOps.checkedAbs ratio) a b cs = .ok r ∧
        num r = args.foldl (fun g x => gcdMath g (num x)) 0 ∧
        den r = args.foldl (fun l x => lcmMath l (den x)) 1) ∧
      (∃ r, lcm_Nary (lcm_Real promote lcmPair) (lcm_Unary (gcd_Unary_Rational num den bigOps.checkedAbs ratio)) a b cs = .ok r ∧
        num r = args.foldl (fun l x => lcmMath l (num x)) 1 ∧
        den r = args.foldl (fun g x => gcdMath g (den x)) 0))

def LcmArrayExact : Prop :=
  (∀ (t : IntTy) (xs : List (JInt t))
      (reduce : ArrayReduceCallees (List (JInt t)) (JInt t)),
    (∀ ys, 2 ≤ ys.length →
      ExactOrOverflow (reduce.withoutInit lcmBits ys) (lcmArrayMath (ys.map Subtype.val))) →
    ExactOrOverflow
      (lcm_Array_Real
        ({ length := List.length
           isInteger := true
           one := JuliaLean.base.int.lit t 1
           elementType := "Integer"
           abs := JuliaLean.base.checked.checkedAbsBits
           only := fun ys => match ys with | [x] => .ok x | _ => .error .boundsError
           reduce := reduce
           lcm := lcmBits } : LcmArrayCallees (List (JInt t)) (JInt t)) xs)
      (lcmArrayMath (xs.map Subtype.val))) ∧
  (∀ (xs : List Int) (reduce : ArrayReduceCallees (List Int) Int),
    (∀ ys, 2 ≤ ys.length →
      reduce.withoutInit (lcm_Integer bigOps (gcd_Integer bigOps)) ys = .ok (lcmArrayMath ys)) →
    lcm_Array_Real
      ({ length := List.length
         isInteger := true
         one := 1
         elementType := "BigInt"
         abs := bigOps.checkedAbs
         only := fun ys => match ys with | [x] => .ok x | _ => .error .boundsError
         reduce := reduce
         lcm := lcm_Integer bigOps (gcd_Integer bigOps) } : LcmArrayCallees (List Int) Int) xs =
      .ok (lcmArrayMath xs))

def LcmArrayRealSemantics : Prop := ∀ (R : Type) (num den : R → Int) (one : R)
    (promote : R → R → Jl (R × R)) (lcmPair : R → R → Jl R) (ratio : Int → Int → Jl R)
    (reduce : ArrayReduceCallees (List R) R) (xs : List R),
  (∀ x, 0 < den x) →
  (∀ n d, 0 < d → ∃ r, ratio n d = .ok r ∧ num r = n ∧ den r = d) →
  (∀ ys, 2 ≤ ys.length →
    ∃ r, reduce.withoutInit (lcm_Real promote lcmPair) ys = .ok r ∧
      num r = lcmArrayMath (ys.map num)) →
  let c : LcmArrayCallees (List R) R := {
    length := List.length
    isInteger := false
    one := one
    elementType := "Rational"
    abs := lcm_Unary (gcd_Unary_Rational num den bigOps.checkedAbs ratio)
    only := fun ys => match ys with | [x] => .ok x | _ => .error .boundsError
    reduce := reduce
    lcm := lcm_Real promote lcmPair
  }
  if xs.length = 0 then
    argumentError (lcm_Array_Real c xs)
  else
    ∃ r, lcm_Array_Real c xs = .ok r ∧ num r = lcmArrayMath (xs.map num)

def RationalUnaryGcd : Prop := ∀ (R : Type) (num den : R → Int)
    (ratio : Int → Int → Jl R),
  (∀ n d : Int, 0 < d → ∃ r, ratio n d = .ok r ∧ 0 < den r ∧ num r * d = n * den r) →
  ∀ a : R, 0 < den a → ∃ r,
    gcd_Unary_Rational num den bigOps.checkedAbs ratio a = .ok r ∧
    num r * den a = (num a).natAbs * den r ∧ 0 ≤ num r ∧ 0 < den r

def BezoutUpdateRing : Prop :=
  (∀ (t : IntTy) (s0 q s1 : JInt t),
    (gcdxUpdate_Unsigned JuliaLean.base.int.subWrap JuliaLean.base.int.mulWrap s0 q s1).val =
      wrapInt t (s0.val - q.val * s1.val) ∧
    (gcdxUpdate JuliaLean.base.int.sub JuliaLean.base.int.mul s0 q s1).val =
      wrapInt t (s0.val - q.val * s1.val)) ∧
  (∀ s0 q s1 t0 t1 a b : Int,
    gcdxUpdate Int.sub Int.mul s0 q s1 = s0 - q * s1 ∧
    (gcdxUpdate Int.sub Int.mul s0 q s1) * a + (gcdxUpdate Int.sub Int.mul t0 q t1) * b =
      (s0 * a + t0 * b) - q * (s1 * a + t1 * b))

def BezoutCoefficient : Prop :=
  (∀ n m : Int, m ≠ 0 →
    if gcdMath n m = 1 then
      ∃ x, bezoutCoef (gcdx_Integer bigOps) (fun g => decide (g = 1)) n m = .ok x ∧
        (n * x - 1) % m = 0
    else domainError (bezoutCoef (gcdx_Integer bigOps) (fun g => decide (g = 1)) n m)) ∧
  (∀ (t : IntTy) (n m : JInt t), m.val ≠ 0 →
    if gcdMath n.val m.val = 1 then
      ∃ x, bezoutCoef gcdxBits (fun g => decide (g.val = 1)) n m = .ok x ∧
        (n.val * x.val - 1) % (Nat.gcd m.val.natAbs (2 ^ t.bits) : Int) = 0
    else domainError (bezoutCoef gcdxBits (fun g => decide (g.val = 1)) n m))

def NextpowSeedCorrection : Prop :=
  (∀ (a x : IntTy) (log : JInt a → JInt x → Jl Int)
      (base : JInt a) (input : JInt x) (n : Int) (k : Nat),
    base.val > 2 → input.val > 1 → input.val ≤ a.max → n > 0 →
    log base input = .ok n →
    (n + 1 = (k : Int) ∨ n = k ∨ n = (k : Int) + 1) →
    (∀ j : Nat, j < k → base.val ^ j < input.val) → input.val ≤ base.val ^ k →
    (∀ j ∈ [n - 1, n, n + 1], fits a (base.val ^ j.toNat)) →
    nextpowBits log base input = .ok (base.val ^ k)) ∧
  (∀ (A X : Type) (valA : A → Int) (valX : X → Int) (log : A → X → Jl Int)
      (base : A) (input : X) (n : Int) (k : Nat),
    valA base > 2 → valX input > 1 → n > 0 →
    log base input = .ok n →
    (n + 1 = (k : Int) ∨ n = k ∨ n = (k : Int) + 1) →
    (∀ j : Nat, j < k → (valA base) ^ j < valX input) → valX input ≤ (valA base) ^ k →
    nextpow (fun x => decide (valX x ≤ 0)) (fun _ => false) false
      (fun _ => .error (.methodError "_nextpow2"))
      (fun a => decide (valA a ≤ 1)) (fun x => decide (valX x ≤ 1)) (fun _ => (1 : Int))
      log (fun a m => pure ((valA a) ^ m.toNat)) (fun _ => false) (fun _ _ => false)
      (fun p x => decide (p ≥ valX x)) (fun p q => decide (p > q)) base input =
      .ok ((valA base) ^ k))

def FloorLogLaw {a x : IntTy} (log : JInt a → JInt x → Jl Int) : Prop :=
  ∀ (base : JInt a) (input : JInt x) (k : Nat), base.val > 1 → input.val ≥ 1 →
    base.val ^ k ≤ input.val → input.val < base.val ^ (k + 1) →
    ∃ n, log base input = .ok n ∧ 0 ≤ n ∧ (n = (k : Int) - 1 ∨ n = k ∨ n = (k : Int) + 1) ∧
      base.val ^ n.toNat ≤ a.max

def FloorLogRealLaw {A X : Type} (valA : A → Int) (valX : X → Int) (log : A → X → Jl Int) : Prop :=
  ∀ (base : A) (input : X) (k : Nat), valA base > 1 → valX input ≥ 1 →
    (valA base) ^ k ≤ valX input → valX input < (valA base) ^ (k + 1) →
    ∃ n, log base input = .ok n ∧ 0 ≤ n ∧ (n = (k : Int) - 1 ∨ n = k ∨ n = (k : Int) + 1)

def PrevpowExact : Prop :=
  (∀ (a x : IntTy) (log : JInt a → JInt x → Jl Int), FloorLogLaw log →
    ∀ (base : JInt a) (input : JInt x),
    if input.val < 1 ∨ base.val ≤ 1 then domainError (prevpowBits log base input)
    else if base.val ≠ 2 ∧ input.val > a.max then domainError (prevpowBits log base input)
    else ∃ y k, prevpowBits log base input = .ok y ∧ y = base.val ^ k ∧
      y ≤ input.val ∧ input.val < base.val ^ (k + 1)) ∧
  (∀ (A X : Type) (valA : A → Int) (valX : X → Int) (log : A → X → Jl Int),
    FloorLogRealLaw valA valX log →
    ∀ (base : A) (input : X),
    let result := prevpow (fun x => decide (valX x < 1)) (fun _ => false) false
      (fun _ => .error (.methodError "_prevpow2"))
      (fun a => decide (valA a ≤ 1)) log (fun a n => pure ((valA a) ^ n.toNat))
      (fun _ => false) (fun _ _ => false) false
      (fun a p => pure (valA a * p, false)) (fun p x => decide (p ≤ valX x)) base input
    if valX input < 1 ∨ valA base ≤ 1 then domainError result
    else (∀ k : Nat, (valA base) ^ k ≤ valX input → valX input < (valA base) ^ (k + 1) →
      result = .ok ((valA base) ^ k)))

def floatPowerLe {A X : JuliaLean.base.float.FTy}
    (a : JuliaLean.base.float.FV A) (k : Nat) (x : JuliaLean.base.float.FV X) : Prop :=
  a.toRat.1 ^ k * (x.toRat.2 : Int) ≤ x.toRat.1 * (a.toRat.2 : Int) ^ k

instance {A X : JuliaLean.base.float.FTy}
    (a : JuliaLean.base.float.FV A) (k : Nat) (x : JuliaLean.base.float.FV X) :
    Decidable (floatPowerLe a k x) := by
  unfold floatPowerLe; infer_instance
def PrevpowFloat32Bound : Prop :=
  ∀ (log : JuliaLean.base.float.FV .f32 → JuliaLean.base.float.FV .f64 → Jl Int)
    (a : JuliaLean.base.float.FV .f32) (x : JuliaLean.base.float.FV .f64) (n : Int) (k : Nat),
  a.isfinite = true → x.isfinite = true →
  floatPowerLe a k x → ¬ floatPowerLe a (k + 1) x →
  log a x = .ok n → 0 ≤ n → (n = (k : Int) - 1 ∨ n = k ∨ n = (k : Int) + 1) →
  if JuliaLean.Promotion.Fl.le a (JuliaLean.base.float.one_float .f32) = true ∨
      JuliaLean.Promotion.Fl.lt x (JuliaLean.base.float.one_float .f64) = true ∨
      JuliaLean.Promotion.Fl.lt
        (JuliaLean.base.float.convertFloat .f64
          (JuliaLean.base.float.typemax_Float32)) x = true
  then domainError (prevpowFloat32 log a x)
  else ∃ r, prevpowFloat32 log a x = .ok r ∧
    JuliaLean.Promotion.Fl.le (JuliaLean.base.float.convertFloat .f64 r) x = true

def SplitSignExact : Prop :=
  (∀ (t : IntTy) (n : JInt t),
    let pair := splitSign_Integer JuliaLean.base.int.abs JuliaLean.base.int.unsigned Subtype.val n
    pair.1.val = (n.val.natAbs : Int) ∧ (pair.2 = true ↔ n.val < 0) ∧
    (t.signed = false → (splitSign_Unsigned n).1.val = pair.1.val ∧ (splitSign_Unsigned n).2 = pair.2)) ∧
  (∀ n : Int,
    let pair := splitSign_Integer bigOps.abs id id n
    pair.1 = (n.natAbs : Int) ∧ (pair.2 = true ↔ n < 0))

def DecimalDigitCount : Prop := ∀ (t : IntTy) (n : JInt t), t.signed = false →
  ∃ count, decimalBits n = .ok count ∧ DigitCount n.val 10 0 count.val

def TopBitGeneric : Prop := ∀ n : Int, 0 ≤ n →
  if n = 0 then topSetBit_Integer (fun n => decide (n = 0))
    (fun n => pure ((n.natAbs.log2 : Int))) n = .ok 0
  else ∃ r, topSetBit_Integer (fun n => decide (n = 0))
    (fun n => pure ((n.natAbs.log2 : Int))) n = .ok r ∧
    1 ≤ r ∧ (2 : Int) ^ (r - 1).toNat ≤ n ∧ n < (2 : Int) ^ r.toNat

def FormattingWriters : Prop := ∀ c : DigitCallees, QuotientLaws c →
  ∀ (t : IntTy) (n : JInt t) (pad : JInt64) (neg : Bool),
  t.signed = false → (neg = false ∨ 0 < n.val) →
