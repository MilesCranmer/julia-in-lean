theorem absDifferenceExact_proven : AbsDifferenceExact := by
  refine ⟨?_, ?_, ?_⟩
  · intro t x y hu
    have hx := x.property
    have hy := y.property
    have hmin0 : t.min = 0 := by cases t <;> simp_all [IntTy.signed, IntTy.min]
    unfold absdiff_Unsigned maxBits minBits JuliaLean.base.operators.max JuliaLean.base.operators.min
    rw [JuliaLean.Proofs.base.int.ltSame_eq]
    by_cases hlt : y.val < x.val
    · simp only [hlt, decide_true, JuliaLean.base.int.ifelse, ↓reduceIte]
      have hsub : (JuliaLean.base.int.sub x y).val = x.val - y.val := by
        rw [JuliaLean.base.int.sub, JuliaLean.Proofs.base.int.sub_int_val]
        exact wrapInt_of_inRange t _ ⟨by omega, by omega⟩
      rw [hsub]
      exact ⟨by omega, by omega⟩
    · simp only [hlt, decide_false, JuliaLean.base.int.ifelse, Bool.false_eq_true, ↓reduceIte]
      have hsub : (JuliaLean.base.int.sub y x).val = y.val - x.val := by
        rw [JuliaLean.base.int.sub, JuliaLean.Proofs.base.int.sub_int_val]
        exact wrapInt_of_inRange t _ ⟨by omega, by omega⟩
      rw [hsub]
      exact ⟨by omega, by omega⟩
  · intro t x y hs hfit1 hfit2
    unfold absdiff_Signed
    have hd : (JuliaLean.base.int.sub x y).val = x.val - y.val := by
      rw [JuliaLean.base.int.sub, JuliaLean.Proofs.base.int.sub_int_val]
      exact wrapInt_of_inRange t _ hfit1
    refine ⟨?_, hd⟩
    rw [JuliaLean.Proofs.base.int.abs_val, hd]
    have hnotmin : ¬ (t.signed = true ∧ x.val - y.val = t.min) := by
      intro ⟨_, hmin⟩
      have : t.min < 0 := by cases t <;> simp_all [IntTy.signed, IntTy.min, IntTy.bits]
      have : -t.min > t.max := by cases t <;> simp_all [IntTy.signed, IntTy.min, IntTy.max, IntTy.bits]
      have h2 := hfit2.2
      omega
    rw [if_neg hnotmin]
  · intro x y
    rfl
theorem bezoutUpdateRing_proven : BezoutUpdateRing := by
  refine ⟨?_, ?_⟩
  · intro t s0 q s1
    unfold gcdxUpdate_Unsigned gcdxUpdate
    have hmul : (JuliaLean.base.int.mulWrap q s1).val = wrapInt t (q.val * s1.val) :=
      JuliaLean.Proofs.base.int.mul_int_val q s1
    have hsub : (JuliaLean.base.int.subWrap s0 (JuliaLean.base.int.mulWrap q s1)).val =
        wrapInt t (s0.val - q.val * s1.val) := by
      rw [JuliaLean.base.int.subWrap, JuliaLean.Proofs.base.int.sub_int_val, hmul,
        JuliaLean.Proofs.base.int.wrapInt_sub_right]
    exact ⟨hsub, hsub⟩
  · intro s0 q s1 t0 t1 a b
    unfold gcdxUpdate
    refine ⟨rfl, ?_⟩
    show (s0 - q * s1) * a + (t0 - q * t1) * b = s0 * a + t0 * b - q * (s1 * a + t1 * b)
    rw [Int.sub_mul, Int.sub_mul, Int.mul_add, Int.mul_assoc, Int.mul_assoc]
    omega

private theorem foldl_and_range (n : Nat) (x : Bool) :
    (List.range n).foldl (fun acc _ => acc && x) true = (decide (n = 0) || x) := by
  induction n with
  | zero => rfl
  | succ n ih =>
    rw [List.range_succ, List.foldl_append, List.foldl_cons, List.foldl_nil, ih]
    cases n <;> cases x <;> rfl

