private theorem ctlz_unsignedAbs_positive {t : IntTy} (x : JInt t) (hx : 0 < x.val) :
    (JuliaLean.base.int.ctlz_int
      (JuliaLean.base.int.unsigned (JuliaLean.base.int.abs x))).val =
