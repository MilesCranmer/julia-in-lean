def asciiDigit (large : Bool) (d : Nat) : Nat :=
  if d < 10 then 48 + d
  else if large then if d < 36 then 65 + (d - 10) else 97 + (d - 36)
  else 97 + (d - 10)

theorem asciiDigit_table (large : Bool) (d : Nat)
    (hd : d < if large then 62 else 36) :
    digitChar large d = .ok (asciiDigit large d) ∧
      asciiDigit large d < 256 ∧ 48 ≤ asciiDigit large d ∧
      (asciiDigit large d = 48 ↔ d = 0) := by
  cases large with
  | false =>
    have h : ∀ d : Fin 36,
        digitChar false d.val = .ok (asciiDigit false d.val) ∧
        asciiDigit false d.val < 256 ∧ 48 ≤ asciiDigit false d.val ∧
        (asciiDigit false d.val = 48 ↔ d.val = 0) := by decide
    exact h ⟨d, hd⟩
  | true =>
    have h : ∀ d : Fin 62,
        digitChar true d.val = .ok (asciiDigit true d.val) ∧
        asciiDigit true d.val < 256 ∧ 48 ≤ asciiDigit true d.val ∧
        (asciiDigit true d.val = 48 ↔ d.val = 0) := by decide
    exact h ⟨d, hd⟩

def writtenDigits (base : Int) (large : Bool) : Nat → Int → List Nat
