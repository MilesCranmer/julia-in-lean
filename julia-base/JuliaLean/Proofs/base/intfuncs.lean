/-- Independent mathematical specification of the native default-multiply
instantiation. Nonnegative exponents compute the power in the machine ring.
Negative exponents are accepted precisely for the two signed units in that
ring (including unsigned typemax), and the result is their inverse power.
All other negative cases raise DomainError after the eager diagnostic calls.
Every base/exponent width and value is included, without range hypotheses.
Julia source: base/intfuncs.jl:399-443; power documentation:
base/promotion.jl:468-499; machine arithmetic:
doc/src/manual/integers-and-floating-point-numbers.md:231-249. -/
def PowerNativeRingSpecification : Prop :=
  ∀ (W : Type) (world : W) (t e : IntTy) (x : JInt t) (p : JInt e),
    let modulus : Int := 2 ^ t.bits
    let observed := JuliaLean.base.intfuncs.Models2Group16.powerBySquaring
      (powerBitsOps (World := W) t e) x p .baseStar world
    if 0 ≤ p.val then
      ∃ result, observed = some (.ok (result, world)) ∧
        (result.val - x.val ^ p.val.toNat) % modulus = 0
    else if (x.val - 1) % modulus = 0 ∨ (x.val + 1) % modulus = 0 then
      ∃ result, observed = some (.ok (result, world)) ∧
        (result.val * x.val ^ p.val.natAbs - 1) % modulus = 0
    else
      ∃ message, observed = some (.error (.jl (.domainError message), world))

/-- The independent binary-chain multiplication budget, from bit length and
Hamming weight. This describes the number of custom keyword calls, excluding
the eager Base square that the source performs even when it cannot reuse it. -/
def powerCustomCallBudget (n : Nat) : Nat :=
  n.log2 + ((List.range (n.log2 + 1)).filter n.testBit).length - 1

/-- Actual custom multiplication arguments and complete state/outcome. -/
structure PowerCustomEvent (W : Type) (t : IntTy) where
  left : JInt t
  right : JInt t
  observation : RationalCallSnapshot W (JInt t)

def powerCustomOutputs {W : Type} {t : IntTy}
    (trace : List (PowerCustomEvent W t)) : List (JInt t) :=
  trace.filterMap fun event => event.observation.outcome.toOption

def powerCustomErrors {W : Type} {t : IntTy}
    (trace : List (PowerCustomEvent W t)) : List JuliaLean.base.io.Error :=
  trace.filterMap fun event => match event.observation.outcome with
    | .ok _ => none
    | .error error => some error

/-- Custom calls may only consume the original converted input or values
actually returned by preceding calls. No multiplication law is assumed;
state mutations and alias references remain arbitrary. -/
def PowerCustomCausality {W : Type} {t : IntTy} (input : JInt t)
    (initial final : W) (trace : List (PowerCustomEvent W t)) : Prop :=
  (∀ k event, (trace)[k]? = some event →
    event.left ∈ input :: powerCustomOutputs (trace.take k) ∧
    event.right ∈ input :: powerCustomOutputs (trace.take k)) ∧
  (match trace.head? with
   | none => final = initial
   | some first => first.observation.before = initial) ∧
  (∀ left right, (left, right) ∈ trace.zip (trace.drop 1) →
    left.observation.after = right.observation.before) ∧
  (∀ last, trace.getLast? = some last → last.observation.after = final)

/-- For arbitrary effectful keyword multipliers on native values, the source
has the independent binary-chain call budget, causal argument/result origins,
exact state chaining, and first-error short-circuiting. A successful positive
power returns the last custom result when any custom call was needed. A
divergent execution must involve a divergent selected custom call; numerical
control itself cannot diverge for a native exponent. No associativity, value,
termination, purity or state law is imposed on the keyword function.
Julia source: base/intfuncs.jl:399-443 (internal call/causality invariant). -/
def PowerCustomNativeAccounting : Prop :=
  ∀ (W : Type) (world : W) (t e : IntTy) (x : JInt t) (p : JInt e)
      (custom : JInt t → JInt t → JuliaLean.base.io.M W (JInt t)),
    let observedCustom : JInt t → JInt t →
        JuliaLean.base.io.M (W × List (PowerCustomEvent W t)) (JInt t) :=
      fun left right => observeArrayCall (PowerCustomEvent.mk left right)
        (custom left right)
    let budget := powerCustomCallBudget p.val.toNat
    let observed := JuliaLean.base.intfuncs.Models2Group16.powerBySquaring
      (powerBitsOps (World := W × List (PowerCustomEvent W t)) t e)
      x p (.custom observedCustom) (world, [])
    match observed with
    | none => ∃ left right current, custom left right current = none
    | some (.ok (result, (final, trace))) =>
        PowerCustomCausality x world final trace ∧
        trace.length = budget ∧ powerCustomErrors trace = [] ∧
        (trace ≠ [] → ∃ last, trace.getLast? = some last ∧
          last.observation.outcome = .ok result) ∧
        (trace = [] → result = x ∨ result.val = 1)
    | some (.error (error, (final, trace))) =>
        PowerCustomCausality x world final trace ∧ trace.length ≤ budget ∧
        ((trace = [] ∧ p.val < 0 ∧
          ∃ message, error = .jl (.domainError message)) ∨
         (powerCustomErrors trace = [error] ∧
          ∃ last, trace.getLast? = some last ∧
            last.observation.outcome = .error error))

