private theorem trailingZeros_i64_power {base : JInt .i64}
    (hbase : 1 < base.val) (hpow : ispow2Bits base = true) :
    ∃ k : Nat, base.val = (2 : Int)^k ∧
      (JuliaLean.base.int.cttz_int base).val = (k : Int) ∧
      (JuliaLean.base.int.cttz_int base).val.toNat = k ∧ 0 < k ∧ k < 64 := by
  obtain ⟨k, hval⟩ := (isPowerTwoExact_proven.1 .i64 base).mp hpow
  have hkpos : 0 < k := by
    by_cases hk0 : k = 0
    · rw [hk0] at hval
      simp at hval
      omega
    · omega
  have hpowlt : (2 : Nat)^k < 2^63 := by
    have hbound : (2 : Int)^k < 2^63 := by
      rw [← hval]
      have hmax : IntTy.max .i64 + 1 = 2^63 := by decide
      rw [← hmax]
      have hb := base.property.2
      omega
    exact_mod_cast hbound
  have hklt63 : k < 63 :=
    (Nat.pow_lt_pow_iff_right (by decide : 1 < 2)).mp hpowlt
  have hklt : k < 64 := by omega
  have hpowNat : ((2 : Int)^k).toNat = 2^k := by
    have hcast :
        ((((2 : Int)^k).toNat : Nat) : Int) = (2 : Int)^k :=
      Int.toNat_of_nonneg (Int.pow_nonneg (by decide))
    exact_mod_cast hcast
  have hpattern : JuliaLean.Proofs.base.int.pattern base = 2^k := by
    rw [JuliaLean.Proofs.base.int.pattern_of_nonneg base (by omega), hval, hpowNat]
  have hfind : (List.range 64).find? (fun i => (2^k).testBit i) = some k := by
    apply List.find?_range_eq_some.mpr
    refine ⟨by simp [Nat.testBit_two_pow], List.mem_range.mpr hklt, ?_⟩
    intro i hi
    have hne : i ≠ k := by omega
    simp [Nat.testBit_two_pow, hne]
    omega
  have hcttzVal : (JuliaLean.base.int.cttz_int base).val = (k : Int) := by
    rw [cttz_int_val, JuliaLean.Proofs.base.int.trailing_zeros_val, hpattern]
    rw [show IntTy.i64.bits = 64 by decide, hfind]
    simp
  have hcttz : (JuliaLean.base.int.cttz_int base).val.toNat = k := by
    rw [hcttzVal]
    simp
  exact ⟨k, hval, hcttzVal, hcttz, hkpos, hklt⟩
private theorem largeBaseSingleDigit_fitted_power_proven :
    ∀ (t b : IntTy) (x : JInt t) (base : JInt b),
      base.val > 1 → 0 < x.val → x.val < base.val → fits .i64 base.val →
      base.val ≠ 2 → base.val ≠ 8 → base.val ≠ 16 → base.val ≠ 10 →
