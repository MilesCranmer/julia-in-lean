def GcdArrayRealNative : Prop :=
  ∀ (t : IntTy) (xs : List (Rat t)), (∀ x ∈ xs, Normalized x) →
    let args := xs.map (fun x => (x.num.val,x.den.val))
    let result := gcd_Array_Real ⟨Concrete.arrayReduce, Concrete.ratGcd, Concrete.ratZeroOfType t⟩ xs
    if xs.any (fun x => decide (x.den.val = 0)) then argumentError result
    else intfuncsRound3.ExactRatOrOverflow result
      (intfuncsRound3.gcdNumerator args) (intfuncsRound3.gcdDenominator args)

def LcmArrayExact : Prop :=
  (∀ (t : IntTy) (xs : List (JInt t)),
    ExactOrOverflow (Concrete.integerArrayLcm xs) (lcmArrayMath (xs.map Subtype.val))) ∧
  (∀ xs : List Int, Concrete.bigArrayLcm xs = .ok (lcmArrayMath xs))

def LcmArrayRealNativeAnyError : Prop :=
  ∀ (t : IntTy) (xs : List (Rat t)), (∀ x ∈ xs, Normalized x) →
    let args := xs.map (fun x => (x.num.val,x.den.val))
    if xs.isEmpty then
      ∃ e, JuliaLean.Proofs.base.intfuncs.approvedRound5.Concrete.ratArrayLcm xs = .error e
    else if xs.any (fun x => decide (x.den.val = 0)) ∧ xs.any (fun x => decide (x.den.val ≠ 0)) then
      ∃ e, JuliaLean.Proofs.base.intfuncs.approvedRound5.Concrete.ratArrayLcm xs = .error e
    else JuliaLean.Proofs.base.intfuncs.approvedRound5.intfuncsRound3.ExactRatOrOverflow
      (JuliaLean.Proofs.base.intfuncs.approvedRound5.Concrete.ratArrayLcm xs)
      (JuliaLean.Proofs.base.intfuncs.approvedRound5.intfuncsRound3.lcmNumerator args)
      (JuliaLean.Proofs.base.intfuncs.approvedRound5.intfuncsRound3.lcmDenominator args)

def GcdxUnaryAvailable : Prop :=
  (∀ (t : IntTy) (a : JInt t),
    let result := gcdx_Unary (gcd_Unary_Integer JuliaLean.base.checked.checkedAbsBits)
      JuliaLean.base.int.signbit Concrete.bitsOne JuliaLean.base.int.neg a
    if fits t (a.val.natAbs : Int) then ∃ d u, result = .ok (d,u) ∧
      d.val = (a.val.natAbs : Int) ∧
      (if t.signed then a.val*u.val = d.val else (a.val*u.val-d.val) % (2^t.bits : Int) = 0)
