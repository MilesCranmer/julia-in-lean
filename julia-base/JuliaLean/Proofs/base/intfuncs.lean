/-- Once its quotient is at most the table cutoff, every later loop state is fixed. -/
theorem decimal128Repeat_small (x : JInt .u128) (c : JInt64) (fuel : Nat)
    (hx : x.val ≤ 10000000000000000000) :
    repeatM fuel decimal128Step (x, c) = .ok (x, c) := by
  apply decimalRepeatFixed
  simp only [decimal128Step, show ¬ x.val > 10000000000000000000 by omega,
    ite_false, Pure.pure, Except.pure]

/-- Exact execution after any established final state of the UInt128 loop. -/
theorem decimal128_finish (decimal64 : JInt .u64 → Jl JInt64) (x y : JInt .u128) (n c : JInt64)
    (hr : repeatM (x.val.natAbs + 1) decimal128Step
      (x, JuliaLean.base.int.lit .i64 0) = .ok (y, n))
    (hc : decimal64 (JuliaLean.base.int.remT .u64 y) = .ok c) :
    bitNdigits128 decimal64
      JuliaLean.base.int.divSame x = .ok (JuliaLean.base.int.add n c) := by
  unfold bitNdigits128
  change (do
    let (y, n) ← repeatM (x.val.natAbs + 1) decimal128Step
      (x, JuliaLean.base.int.lit .i64 0)
    pure (JuliaLean.base.int.add n
      (← decimal64 (JuliaLean.base.int.remT .u64 y)))) = _
  rw [hr]
  simp only [Bind.bind, Except.bind, hc, Pure.pure, Except.pure]


/-- UInt128 requires at most two divisions by the nineteen-digit cutoff. -/
theorem decimal128_spec (x : JInt .u128) :
    ∃ c, bitNdigits128 (fun z => bitNdigits64 z (by decide) (by decide))
      JuliaLean.base.int.divSame x = .ok c ∧ DigitCount x.val 10 0 c.val := by
  have hx0 : 0 ≤ x.val := x.property.1
  have hxmax : x.val ≤ 340282366920938463463374607431768211455 := x.property.2
  by_cases hx : x.val ≤ 10000000000000000000
  · obtain ⟨c, hc, hd, hb⟩ := decimal128SmallCount x hx
    have hr := decimal128Repeat_small x (JuliaLean.base.int.lit .i64 0)
      (x.val.natAbs + 1) hx
    refine ⟨JuliaLean.base.int.add (JuliaLean.base.int.lit .i64 0) c,
      decimal128_finish _ x x _ c hr hc, ?_⟩
    have hv := addSmallDecimalCount 0 (by decide) c hd.1 hb
    simpa only [hv, Int.zero_add] using hd
  · have hxpos : 0 < x.val := by omega
    let y := JuliaLean.base.int.lit .u128 (x.val / 10000000000000000000)
    have hyv : y.val = x.val / 10000000000000000000 := decimal128QuotientVal x
    have hypos : 0 < y.val := by rw [hyv]; omega
    have hymax : y.val ≤ 34028236692093846346 := by rw [hyv]; omega
    have hs1 : decimal128Step (x, JuliaLean.base.int.lit .i64 0) =
        .ok (y, JuliaLean.base.int.lit .i64 19) := by
      simp only [decimal128Step, show x.val > 10000000000000000000 by omega,
        ite_true, decimal128Divide, Bind.bind, Except.bind, Pure.pure, Except.pure]
      rfl
    by_cases hy : y.val ≤ 10000000000000000000
    · obtain ⟨c, hc, hd, hb⟩ := decimal128SmallCount y hy
      have hr : repeatM (x.val.natAbs + 1) decimal128Step
          (x, JuliaLean.base.int.lit .i64 0) =
          .ok (y, JuliaLean.base.int.lit .i64 19) := by
        rw [decimalRepeatSucc, hs1]
        exact decimal128Repeat_small y (JuliaLean.base.int.lit .i64 19) _ hy
      refine ⟨JuliaLean.base.int.add (JuliaLean.base.int.lit .i64 19) c,
        decimal128_finish _ x y _ c hr hc, ?_⟩
      have hshift := decimalShiftCount x.val y.val c.val hxpos hypos hyv hd
      have hv := addSmallDecimalCount 19 (by decide) c hd.1 hb
      simpa only [hv, Int.add_comm] using hshift
    · let z := JuliaLean.base.int.lit .u128 (y.val / 10000000000000000000)
      have hzv : z.val = y.val / 10000000000000000000 := decimal128QuotientVal y
      have hzpos : 0 < z.val := by rw [hzv]; omega
      have hz : z.val ≤ 10000000000000000000 := by rw [hzv]; omega
      have hs2 : decimal128Step (y, JuliaLean.base.int.lit .i64 19) =
          .ok (z, JuliaLean.base.int.lit .i64 38) := by
        simp only [decimal128Step, show y.val > 10000000000000000000 by omega,
          ite_true, decimal128Divide, Bind.bind, Except.bind, Pure.pure, Except.pure]
        rfl
      have hfuel : x.val.natAbs = (x.val.natAbs - 1) + 1 := by
        have habs := Int.natAbs_of_nonneg hx0
        omega
      have hr : repeatM (x.val.natAbs + 1) decimal128Step
          (x, JuliaLean.base.int.lit .i64 0) =
          .ok (z, JuliaLean.base.int.lit .i64 38) := by
        rw [decimalRepeatSucc, hs1]
        change repeatM x.val.natAbs decimal128Step
          (y, JuliaLean.base.int.lit .i64 19) = _
        rw [hfuel, decimalRepeatSucc, hs2]
        exact decimal128Repeat_small z (JuliaLean.base.int.lit .i64 38) _ hz
      obtain ⟨c, hc, hd, hb⟩ := decimal128SmallCount z hz
      refine ⟨JuliaLean.base.int.add (JuliaLean.base.int.lit .i64 38) c,
        decimal128_finish _ x z _ c hr hc, ?_⟩
      have hshift1 := decimalShiftCount y.val z.val c.val hypos hzpos hzv hd
      have hshift2 := decimalShiftCount x.val y.val (c.val + 19) hxpos hypos hyv hshift1
      have hv := addSmallDecimalCount 38 (by decide) c hd.1 hb
      have hv' : (JuliaLean.base.int.add (JuliaLean.base.int.lit .i64 38) c).val =
          (c.val + 19) + 19 := by rw [hv]; omega
      simpa only [hv'] using hshift2

theorem decimalUnsigned_function {U : Type} (f : U → Jl JInt64) :
