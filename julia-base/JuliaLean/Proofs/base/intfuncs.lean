    rw [htop]
    simp
  have hformulaInt :
      ((topBit (JuliaLean.base.int.unsigned (JuliaLean.base.int.abs x)) : Int) + 2) / 3 = 1 := by
    rw [htopInt]
    omega
  have hconv :
      JuliaLean.base.int.convert .i64 base = .ok (JuliaLean.base.int.lit .i64 8) := by
    simp [JuliaLean.base.int.convert, JInt.convert, hbase, fits, IntTy.min, IntTy.max,
      IntTy.signed, IntTy.bits, JuliaLean.base.int.lit, JInt.lit, JInt.wrap, wrapInt]
  have hconvValue : (JuliaLean.base.int.lit .i64 8).val = 8 := by decide
  have honeValue : (JuliaLean.base.int.lit .i64 1).val = 1 := by decide
  constructor
  · simp [ndigitsZeroBits, ndigitsZero, ndigitsPositiveBits, ndigitsPositive, hconv, hconvValue,
      hbase, hn, hformulaInt, Bind.bind, Except.bind, Pure.pure, Except.pure]
  · simp [ndigitsBits, ndigits, ndigitsZeroBits, ndigitsZero, ndigitsPositiveBits, ndigitsPositive,
