        (if decide (36 < base) then 62 else 36))
        (boolInt neg + (k + 1 : Nat)) (asciiDigit (decide (36 < base)) (o.value x % base).toNat)
      have hnext : next.bytes = List.replicate ((boolInt neg).toNat + k) 0 ++
          asciiDigit (decide (36 < base)) (o.value x % base).toNat :: tail := by
        have hi : boolInt neg + (k + 1 : Nat) = (((boolInt neg).toNat + k : Nat) : Int) + 1 := by omega
