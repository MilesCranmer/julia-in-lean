  let types := lcmArrayTypeCalls trace
  let subtypes := lcmArraySubtypeCalls trace
  let ones := lcmArrayOneCalls trace
  let strings := lcmArrayStringCalls trace
  let singles := lcmArrayOnlyCalls trace
  let absolutes := lcmArrayAbsCalls trace
  let reductions := lcmArrayReductionCalls trace
  (lcmArrayLengthCalls trace).length = 1 ∧
  comparisons.length ≤ 2 ∧
  comparisons.map (fun call => call.2.1.val) = ([0, 1] : List Int).take comparisons.length ∧
  types.length ≤ 2 ∧ subtypes.length ≤ 1 ∧
  ones.length + strings.length ≤ 1 ∧ singles.length ≤ 1 ∧ absolutes.length ≤ 1 ∧
  reductions.length ≤ 1 ∧
  ones.length + absolutes.length + reductions.length ≤ 1 ∧
  1 ≤ trace.length ∧ trace.length ≤ 6 ∧
  ((0, true) ∈ lcmArrayComparisonResults trace →
    comparisons.length = 1 ∧ 1 ≤ types.length ∧
    singles = [] ∧ absolutes = [] ∧ reductions = []) ∧
  ((0, false) ∈ lcmArrayComparisonResults trace →
    comparisons.length = 2 ∧ types = [] ∧ subtypes = [] ∧ ones = [] ∧ strings = []) ∧
  ((1, true) ∈ lcmArrayComparisonResults trace → singles.length = 1 ∧ reductions = []) ∧
  ((1, false) ∈ lcmArrayComparisonResults trace →
    singles = [] ∧ absolutes = [] ∧ reductions.length = 1) ∧
  (∀ result, result ∈ lcmArraySubtypeOutputs trace → types.length = 2) ∧
  absolutes.map Prod.fst = lcmArrayOnlyOutputs trace ∧
  (ones.map Prod.fst ++ strings.map (fun call => call.2.1)) =
    (lcmArrayTypeOutputs trace).drop 1

