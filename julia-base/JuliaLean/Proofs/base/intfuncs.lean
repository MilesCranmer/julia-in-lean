/-- Mathematical values use unbounded natural magnitudes and a left fold,
independent of the source's right-associated dispatch and machine arithmetic.
The empty-list identities are specification conveniences; each complete
source invocation here has at least two arguments. -/
def naryMathematicalValue (fn : NumberTheoryFunction) (values : List Int) : Nat :=
  match fn with
  | .gcd => values.foldl (fun result value => Nat.gcd result value.natAbs) 0
  | .lcm => values.foldl (fun result value => Nat.lcm result value.natAbs) 1

/-- Every binary result required by the selected n-ary body is the
mathematical value of a suffix containing at least two inputs. If the rest
tuple is empty, the source additionally evaluates unary gcd/lcm on b, so its
singleton magnitude must fit as well. For a nonempty rest tuple there is no
unary call on the final element, and no singleton-fit requirement is added.

This is a condition on mathematical suffix values, not on model executions
or assumed callback results. It appears on both sides of an exhaustive
success/overflow classification below, never as an input restriction. -/
def NaryRequiredMagnitudesFit (t : IntTy) (fn : NumberTheoryFunction)
    (a b : JInt t) (cs : Varargs (JInt t)) : Prop :=
  let values := a :: b :: cs.values
  (∀ skip : Nat, skip + 2 ≤ values.length →
    (naryMathematicalValue fn ((values.drop skip).map Subtype.val) : Int) ≤ t.max) ∧
  (cs.values = [] → (b.val.natAbs : Int) ≤ t.max)

/-- Complete mathematical outcome classification, including overflow in an
inner suffix even when the final mathematical gcd/lcm would be representable.
Every input is included. Native callees are the installed Base models, with
no correctness hypotheses, and every finite success or failure leaves the
world unchanged.

The helper naryTail is covered through the public selected source body.
Julia source: base/intfuncs.jl:152,154,161-162 at
f755f49a9e41380d7da126b3c1db9fe7f83dd027. -/
def NaryBitsMathematicalOutcome (fn : NumberTheoryFunction) : Prop :=
  ∀ (W : Type) (world : W) (t : IntTy) (a b : JInt t)
      (cs : Varargs (JInt t)),
    let expected := naryMathematicalValue fn ((a :: b :: cs.values).map Subtype.val)
    let requiredFit := NaryRequiredMagnitudesFit t fn a b cs
    let ops : NaryOps (JuliaLean.base.io.M W) (JInt t) := naryBitsOps t
    let observed := match fn with
      | .gcd => gcdNary ops a b cs world
      | .lcm => lcmNary ops a b cs world
    (requiredFit →
      ∃ result, observed = some (.ok (result, world)) ∧ result.val = (expected : Int)) ∧
    (¬ requiredFit →
      ∃ message, observed = some (.error (.jl (.overflowError message), world)))

/-- Native selected n-ary gcd terminates with the greatest common
nonnegative divisor exactly when all its required suffix magnitudes fit;
otherwise its first unrepresentable suffix produces OverflowError. This
includes signed minimum, zero in every position, and the empty rest tuple
allowed by the signature. A leading 1 cannot rescue an already-overflowing
inner suffix.

Julia documentation: base/intfuncs.jl:5-43.
Julia source: base/intfuncs.jl:152,161 at
f755f49a9e41380d7da126b3c1db9fe7f83dd027. -/
def GcdNaryBitsAllInputs : Prop := NaryBitsMathematicalOutcome .gcd

/-- Native selected n-ary lcm terminates with the least common nonnegative
multiple exactly when every required suffix magnitude fits; otherwise it
raises OverflowError before any enclosing call can absorb that failure.
In particular, a leading zero does not suppress overflow of an inner suffix.
All machine widths and all bounded rest tuples are included.

Julia documentation: base/intfuncs.jl:98-135.
Julia source: base/intfuncs.jl:154,162 at
f755f49a9e41380d7da126b3c1db9fe7f83dd027. -/
def LcmNaryBitsAllInputs : Prop := NaryBitsMathematicalOutcome .lcm

/-! Open-dispatch accounting observes the original selected actions with the
common recordCall helper. Method selection is pure runtime metadata; only a
selected action is executed and logged. No selected action's result, error,
state behavior or termination is constrained. -/

/-- Completed source-selected unary, binary or custom n-ary calls. -/
inductive NaryEvent (V : Type) where
  | unary (fn : NumberTheoryFunction) (input : V)
      (outcome : Except JuliaLean.base.io.Error V)
  | binary (fn : NumberTheoryFunction) (left right : V)
      (outcome : Except JuliaLean.base.io.Error V)
  | custom (fn : NumberTheoryFunction) (first second : V) (rest : List V)
      (outcome : Except JuliaLean.base.io.Error V)

def observeNaryOps {W V : Type} (ops : NaryOps (JuliaLean.base.io.M W) V) :
    NaryOps (JuliaLean.base.io.M (W × List (NaryEvent V))) V where
  unary fn input := recordCall (.unary fn input) (ops.unary fn input)
  binary fn left right := recordCall (.binary fn left right) (ops.binary fn left right)
  customNary fn first second rest :=
    (ops.customNary fn first second rest).map
      (fun selected => recordCall (.custom fn first second rest) selected)

def naryEventOutcome {V : Type} : NaryEvent V → Except JuliaLean.base.io.Error V
  | .unary _ _ outcome => outcome
  | .binary _ _ _ outcome => outcome
  | .custom _ _ _ _ outcome => outcome

def naryEventError {V : Type} (event : NaryEvent V) : Option JuliaLean.base.io.Error :=
  match naryEventOutcome event with
  | .ok _ => none
  | .error error => some error

def narySuccessfulOutputs {V : Type} (trace : List (NaryEvent V)) : List V :=
  trace.filterMap fun event => (naryEventOutcome event).toOption

def naryBinaryInputs {V : Type} (trace : List (NaryEvent V)) : List (V × V) :=
  trace.filterMap fun event => match event with
    | .binary _ left right _ => some (left, right)
    | _ => none

/-- Inspect only the actual pure method-selection result for a suffix of
the original inputs. It does not execute or assume any custom method.
Fewer than three values cannot select the custom-nary route in naryTail. -/
def narySuffixHasCustom {W V : Type} (ops : NaryOps (JuliaLean.base.io.M W) V)
    (fn : NumberTheoryFunction) (values : List V) (skip : Nat) : Bool :=
  match values.drop skip with
  | first :: second :: third :: rest =>
      (ops.customNary fn first second (third :: rest)).isSome
  | _ => false

/-- The first executed leaf consumes an actual proper suffix. It is either
the unary call of the empty-rest case, the final pair, or the first custom
method selected while descending through proper suffixes. The unconsumed
prefix contains the outer argument a and is subsequently consumed in reverse
order. No arithmetic or callback implementation is reproduced here. -/
def NaryLeafProvenance {W V : Type} (ops : NaryOps (JuliaLean.base.io.M W) V)
    (fn : NumberTheoryFunction) (a b : V) (cs : Varargs V)
    (pending : List V) (leaf : NaryEvent V) : Prop :=
  let values := a :: b :: cs.values
  pending ≠ [] ∧
  (∀ skip : Nat, 1 ≤ skip → skip < pending.length →
    narySuffixHasCustom ops fn values skip = false) ∧
  match leaf with
  | .unary selected input _ =>
      selected = fn ∧ cs.values = [] ∧ pending = [a] ∧ input = b
  | .binary selected left right _ =>
      selected = fn ∧ cs.values ≠ [] ∧ values = pending ++ [left, right]
  | .custom selected first second rest _ =>
      selected = fn ∧ rest ≠ [] ∧ values = pending ++ first :: second :: rest ∧
      narySuffixHasCustom ops fn values pending.length = true

/-- Aggregate source-order accounting after the initial leaf: outer left
operands are the original prefix in reverse order, and each right operand is
the preceding actual successful result. The function identity remains fixed;
no later unary/custom action can be added and no earlier result handle may
be replaced by a copy. Every completed call has an actual input origin.
Source invariant: base/intfuncs.jl:161-162. -/
def NaryOuterAccounting {V : Type} (fn : NumberTheoryFunction)
    (pending : List V) (leaf : NaryEvent V) (outer : List (NaryEvent V)) : Prop :=
  outer.length ≤ pending.length ∧
  (∀ event ∈ outer, ∃ left right outcome, event = .binary fn left right outcome) ∧
  (naryBinaryInputs outer).map Prod.fst = pending.reverse.take outer.length ∧
  (naryBinaryInputs outer).map Prod.snd =
    (narySuccessfulOutputs (leaf :: outer)).take outer.length

/-- A successful public return consumes the complete prefix and has exactly
the last selected call's result. Failure is the unique first observed
exception, at the last completed call; no remaining prefix is evaluated.
No correctness law about any selected operation is a premise.
Source invariant: base/intfuncs.jl:161-162. -/
def NaryTerminalAccounting {V : Type} (pending : List V)
    (leaf : NaryEvent V) (outer : List (NaryEvent V)) :
    Except JuliaLean.base.io.Error V → Prop
  | .ok value =>
      outer.length = pending.length ∧
      (leaf :: outer).filterMap naryEventError = [] ∧
      ∃ final, (leaf :: outer).getLast? = some final ∧ naryEventOutcome final = .ok value
  | .error error =>
      (leaf :: outer).filterMap naryEventError = [error] ∧
      ∃ final, (leaf :: outer).getLast? = some final ∧ naryEventError final = some error

/-- Every completed execution, for all custom type-changing/reference-valued
dispatch and all machine-sized argument tuples, follows suffix/operand
provenance, honors the first selected custom n-ary method, and has a single
right-result chain. Selected actions may mutate, throw or diverge arbitrarily.
The leaf is unique, later calls are binary calls of the same function, and
the first exception stops all remaining outer calls. The result/reference is
the final actual selected result. Infinite selected actions remain permitted.

This property uses observed arguments/results and pure selection outcomes;
it does not rerun any action or assume associativity, commutativity, positivity,
correctness, normalization or termination.

The public models depend on naryTail, so this registered invariant also
covers that helper's actual recursion and selected-custom route.
Julia source: base/intfuncs.jl:161-162 at
f755f49a9e41380d7da126b3c1db9fe7f83dd027. -/
def NaryOpenDispatchAccounting : Prop :=
  ∀ (W V : Type) (ops : NaryOps (JuliaLean.base.io.M W) V)
      (fn : NumberTheoryFunction) (a b : V) (cs : Varargs V) (world : W),
    let observed := match fn with
      | .gcd => gcdNary (observeNaryOps ops) a b cs (world, [])
      | .lcm => lcmNary (observeNaryOps ops) a b cs (world, [])
    match observed with
    | none => True
    | some (.ok (value, (_, trace))) =>
        ∃ pending leaf outer, trace = leaf :: outer ∧
          NaryLeafProvenance ops fn a b cs pending leaf ∧
          NaryOuterAccounting fn pending leaf outer ∧
          NaryTerminalAccounting pending leaf outer (.ok value)
    | some (.error (error, (_, trace))) =>
        ∃ pending leaf outer, trace = leaf :: outer ∧
          NaryLeafProvenance ops fn a b cs pending leaf ∧
          NaryOuterAccounting fn pending leaf outer ∧
          NaryTerminalAccounting pending leaf outer (.error error)

