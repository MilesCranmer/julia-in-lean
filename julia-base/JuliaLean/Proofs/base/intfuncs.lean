      JuliaLean.base.div.modMixedSignedUnsigned, JuliaLean.base.div.modMixedUnsignedSigned,
      JuliaLean.base.int.mod_BitSigned, JuliaLean.base.int.mod_Unsigned,
      JuliaLean.base.int.mod_BitSigned_Unsigned, JuliaLean.base.int.mod_Unsigned_Signed,
      JuliaLean.base.int.remSame, JuliaLean.base.int.rem_BitSigned_Unsigned,
      JuliaLean.base.int.rem_Unsigned_BitSigned, JuliaLean.base.div.fldBitInteger,
      JuliaLean.base.div.fld_same_numeric, JuliaLean.base.div.divBitIntegerMode,
      JuliaLean.base.div.divBitIntegerDown, JuliaLean.base.div.divBitIntegerToZero,
      JuliaLean.base.div.div_Unsigned_Down, JuliaLean.base.div.div_Integer_Down,
      JuliaLean.base.div.div_BitInteger_ToZero, JuliaLean.base.int.divSame] <;> rfl

private theorem divideError_eq {A : Type} (r : Jl A) :
    divideError r ↔ r = .error .divideError := by
  cases r with
  | ok _ => simp [divideError]
  | error e => cases e <;> simp [divideError]

theorem powermodZeroModulus_proven : PowermodZeroModulus := by
  intro g hg s e t x p hp
  have hwrap0 : wrapInt t 0 = 0 := by cases t <;> decide
  by_cases h128 : t.bits = 128
  · have hzero : g.powermod x.val p.val 0 = .error .divideError :=
      (divideError_eq _).mp (hg.2.2 x.val p.val)
    simp [powermodBits, h128, powermod_128, numberCallees, hzero, hwrap0,
