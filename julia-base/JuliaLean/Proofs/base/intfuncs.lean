  | w + 1, p, hp => by
    rw [countP_range_succ_testBit]
    have hp2 : p / 2 < 2 ^ w := by rw [Nat.pow_succ] at hp; omega
    rcases Nat.mod_two_eq_zero_or_one p with h | h
    · simp only [h, Nat.zero_ne_one, ↓reduceIte, Nat.zero_add]
      rw [countP_range_testBit_eq_one w (p / 2) hp2]
