  subtype typeValue upper := observeArrayCall (.subtype typeValue upper) (ops.subtype typeValue upper)
  one typeValue := observeArrayCall (.one typeValue) (ops.one typeValue)
  string textPrefix typeValue := observeArrayCall (.interpolate textPrefix typeValue) (ops.string textPrefix typeValue)
  only array := observeArrayCall (.only array) (ops.only array)
  abs value := observeArrayCall (.absolute value) (ops.abs value)
