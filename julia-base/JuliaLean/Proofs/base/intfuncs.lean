    simp [hi, hne, h2]
  · by_cases hk : i = T.fmt.eb + T.fmt.sb
    · subst hk
      have hsb : ¬ (T.fmt.eb + T.fmt.sb < T.fmt.sb) := by
        have := (good_fty T).emax_succ
        have : 1 ≤ T.fmt.eb := by
          rcases Nat.eq_zero_or_pos T.fmt.eb with h0 | h0
          · rw [h0] at this; simp at this; have := (good_fty T).emax_eq; have := (good_fty T).bias_pos; omega
          · omega
        omega
      have hbit : v.testBit (T.fmt.eb + T.fmt.sb) = decide (v ≥ 2 ^ (T.fmt.eb + T.fmt.sb)) := by
        rw [Nat.testBit_eq_decide_div_mod_eq]
        have hd : v / 2 ^ (T.fmt.eb + T.fmt.sb) < 2 := Nat.div_lt_of_lt_mul (by omega)
        by_cases hv' : v ≥ 2 ^ (T.fmt.eb + T.fmt.sb)
        · have : 1 ≤ v / 2 ^ (T.fmt.eb + T.fmt.sb) :=
            (Nat.le_div_iff_mul_le (Nat.two_pow_pos _)).2 (by omega)
          simp [hv']; omega
        · have : v / 2 ^ (T.fmt.eb + T.fmt.sb) = 0 := Nat.div_eq_of_lt (by omega)
          simp [hv', this]
      rw [hbit]
      split
      · rename_i hv'
        simp [hv', hsb, Nat.testBit_two_pow]
      · rename_i hv'
        simp [hv', hsb]
    · have h2 : ((if v ≥ 2 ^ (T.fmt.eb + T.fmt.sb) then 1 else 0) * 2 ^ (T.fmt.eb + T.fmt.sb)).testBit i
          = false := by
        split
        · rw [Nat.one_mul, Nat.testBit_two_pow]; simp; omega
        · simp
      have hne : ¬ (T.fmt.eb + T.fmt.sb = i) := by omega
      simp [hi, hne, h2]

theorem numberPow2_ClearExp {T : FTy} (x : FV T) :
    withoutBits x.toBits (exponentMask T) T.fmt.width =
      (if x.signbit then 2 ^ (T.fmt.eb + T.fmt.sb) else 0) + x.frac := by
  have hlt : x.toBits < 2 ^ T.fmt.width := x.bits.isLt
  rw [numberPow2_WithoutBitsEq, numberPow2_ExpMaskComplement, numberPow2_LandSignFrac T _ hlt]
  have hs : decide (x.toBits ≥ 2 ^ (T.fmt.eb + T.fmt.sb)) = x.signbit := rfl
  congr 1
  · by_cases h : x.toBits ≥ 2 ^ (T.fmt.eb + T.fmt.sb)
    · have : x.signbit = true := by rw [← hs]; exact decide_eq_true h
      simp [h, this]
    · have : x.signbit = false := by rw [← hs]; exact decide_eq_false h
      simp [h, this]

theorem numberPow2_EncodeBits (T : FTy) (s : Bool) (M : Nat) :
    (Fl.ofBits ((if s then 2 ^ (T.fmt.eb + T.fmt.sb) else 0) + M) : FV T) = NextProofs.encode T s M := rfl

theorem numberPow2_MagKeyNormal (T : FTy) (B r : Nat) (hB : B ≠ 0) (hr : r < 2 ^ T.fmt.sb) :
    magKey T.fmt (B * 2 ^ T.fmt.sb + r) = (r + 2 ^ T.fmt.sb) * 2 ^ (B - 1) := by
  have hP := Nat.two_pow_pos T.fmt.sb
  unfold magKey
  have hd : (B * 2 ^ T.fmt.sb + r) / 2 ^ T.fmt.sb = B := by
    rw [Nat.add_comm, Nat.add_mul_div_right _ _ hP, Nat.div_eq_of_lt hr, Nat.zero_add]
  have hm : (B * 2 ^ T.fmt.sb + r) % 2 ^ T.fmt.sb = r := by
    rw [Nat.add_comm, Nat.add_mul_mod_self_right, Nat.mod_eq_of_lt hr]
  rw [hd, hm]
  simp [hB]

def numberPow2_NormSig {T : FTy} (x : FV T) : Nat :=
  if x.expField = 0 then x.frac * 2 ^ (T.fmt.sb - x.frac.log2) else x.frac + 2 ^ T.fmt.sb

theorem numberPow2_NormSigFacts {T : FTy} (x : FV T) (hx : x.isfinite = true) (hz : x.magnitude ≠ 0) :
    2 ^ T.fmt.sb ≤ numberPow2_NormSig x ∧ numberPow2_NormSig x < 2 ^ (T.fmt.sb + 1) ∧
    magKey T.fmt x.magnitude * 2 ^ T.fmt.sb = numberPow2_NormSig x * 2 ^ (magKey T.fmt x.magnitude).log2 ∧
    (x.expField ≠ 0 → (magKey T.fmt x.magnitude).log2 = T.fmt.sb + x.expField - 1 ∧
      numberPow2_NormSig x = x.frac + 2 ^ T.fmt.sb) ∧
    (x.expField = 0 → (magKey T.fmt x.magnitude).log2 = x.frac.log2 ∧
      magKey T.fmt x.magnitude = x.frac ∧ x.frac.log2 < T.fmt.sb) := by
  have hP := Nat.two_pow_pos T.fmt.sb
  obtain ⟨hmd, hfr⟩ := TruncProofs.mag_decomp x
  have hdiv : x.magnitude / 2 ^ T.fmt.sb = x.expField := (Fl.expField_eq x).symm
  have hpow : 2 ^ (T.fmt.sb + 1) = 2 * 2 ^ T.fmt.sb := by rw [Nat.pow_succ, Nat.mul_comm]
  by_cases hB : x.expField = 0
  · have hnumberPow2_ : x.magnitude = x.frac := by rw [hmd, hB]; simp
    have hf0 : x.frac ≠ 0 := by omega
    have hlog : x.frac.log2 < T.fmt.sb := (Nat.log2_lt hf0).2 hfr
    have hmk : magKey T.fmt x.magnitude = x.frac := by
      unfold magKey; rw [hdiv, hB, ← Fl.frac_eq]; simp
    obtain ⟨-, h1, h2⟩ := Fl.sig_bounds (f := T.fmt) x.frac hf0 (by omega)
    have hc : numberPow2_NormSig x = x.frac * 2 ^ (T.fmt.sb - x.frac.log2) := by simp [numberPow2_NormSig, hB]
    refine ⟨by rw [hc]; exact h1, by rw [hc]; exact h2, ?_, fun h => absurd hB h, fun _ => ⟨by rw [hmk], hmk, hlog⟩⟩
    rw [hmk, hc, Nat.mul_assoc, ← Nat.pow_add]
    congr 2
    omega
  · have hc1 : 2 ^ T.fmt.sb ≤ x.frac + 2 ^ T.fmt.sb := by omega
    have hc2 : x.frac + 2 ^ T.fmt.sb < 2 ^ (T.fmt.sb + 1) := by omega
    have hmk : magKey T.fmt x.magnitude = (x.frac + 2 ^ T.fmt.sb) * 2 ^ (x.expField - 1) := by
      rw [hmd, numberPow2_MagKeyNormal T _ _ hB hfr]
    have hL : (magKey T.fmt x.magnitude).log2 = T.fmt.sb + x.expField - 1 := by
      rw [hmk, Fl.log2_mul_pow _ _ (by omega), numberPow2_Log2Eq _ _ hc1 hc2]
      omega
    have hc : numberPow2_NormSig x = x.frac + 2 ^ T.fmt.sb := by simp [numberPow2_NormSig, hB]
    refine ⟨by rw [hc]; exact hc1, by rw [hc]; exact hc2, ?_, fun _ => ⟨hL, hc⟩, fun h => absurd h hB⟩
    rw [hL, hmk, hc, Nat.mul_assoc, ← Nat.pow_add]
    congr 2
    omega

theorem numberPow2_ClearExpVal (T : FTy) (v : Nat) (hv : v < 2 ^ T.fmt.width) :
    withoutBits v (exponentMask T) T.fmt.width =
      (if v ≥ 2 ^ (T.fmt.eb + T.fmt.sb) then 2 ^ (T.fmt.eb + T.fmt.sb) else 0) + v % 2 ^ T.fmt.sb := by
  rw [numberPow2_WithoutBitsEq, numberPow2_ExpMaskComplement, numberPow2_LandSignFrac T _ hv]

theorem numberPow2_SubnormalShift {T : FTy} (x : FV T) (hx : x.isfinite = true) (hz : x.magnitude ≠ 0)
    (hB : x.expField = 0) :
    leadingZeros T.fmt.width x.magnitude - T.fmt.eb = T.fmt.sb - x.frac.log2 ∧
    withoutBits (x.magnitude * 2 ^ (leadingZeros T.fmt.width x.magnitude - T.fmt.eb) +
        (if fsignbit x then signMask T else 0)) (exponentMask T) T.fmt.width =
      (if x.signbit then 2 ^ (T.fmt.eb + T.fmt.sb) else 0) + (numberPow2_NormSig x - 2 ^ T.fmt.sb) := by
  have hP := Nat.two_pow_pos T.fmt.sb
  obtain ⟨hmd, hfr⟩ := TruncProofs.mag_decomp x
  have hnumberPow2_ : x.magnitude = x.frac := by rw [hmd, hB]; simp
  have hf0 : x.frac ≠ 0 := by omega
  have hlog : x.frac.log2 < T.fmt.sb := (Nat.log2_lt hf0).2 hfr
  have hwidth : T.fmt.width = T.fmt.eb + T.fmt.sb + 1 := by simp [Fmt.width]; omega
  have hlz : leadingZeros T.fmt.width x.magnitude - T.fmt.eb = T.fmt.sb - x.frac.log2 := by
    unfold leadingZeros
    rw [hnumberPow2_, if_neg hf0, hwidth]
    omega
  obtain ⟨hc1, hc2, -, -, -⟩ := numberPow2_NormSigFacts x hx hz
  have hc : numberPow2_NormSig x = x.frac * 2 ^ (T.fmt.sb - x.frac.log2) := by simp [numberPow2_NormSig, hB]
  refine ⟨hlz, ?_⟩
  rw [hlz, hnumberPow2_, ← hc]
  have hsg : fsignbit x = x.signbit := signbit_float_eq x
  have heb : 1 ≤ T.fmt.eb := by cases T <;> decide
  have hS : 2 ^ (T.fmt.sb + 1) ≤ 2 ^ (T.fmt.eb + T.fmt.sb) :=
    Nat.pow_le_pow_right (by decide) (by omega)
  have hw := Fmt.width_pow T.fmt
  have hsm : signMask T = 2 ^ (T.fmt.eb + T.fmt.sb) := rfl
  rw [hsg, hsm, numberPow2_ClearExpVal T _ (by split <;> omega)]
  have hmod : (numberPow2_NormSig x + (if x.signbit then 2 ^ (T.fmt.eb + T.fmt.sb) else 0)) % 2 ^ T.fmt.sb =
      numberPow2_NormSig x - 2 ^ T.fmt.sb := by
    have hsplit : 2 ^ (T.fmt.eb + T.fmt.sb) = 2 ^ T.fmt.eb * 2 ^ T.fmt.sb := Nat.pow_add _ _ _
    have hpow : 2 ^ (T.fmt.sb + 1) = 2 * 2 ^ T.fmt.sb := by rw [Nat.pow_succ, Nat.mul_comm]
    have h1 : numberPow2_NormSig x % 2 ^ T.fmt.sb = numberPow2_NormSig x - 2 ^ T.fmt.sb := by
      rw [Nat.mod_eq_sub_mod (by omega), Nat.mod_eq_of_lt (by omega)]
    split
    · rw [hsplit, Nat.add_mul_mod_self_right, h1]
    · rw [Nat.add_zero, h1]
  rw [hmod]
  split <;> split <;> rename_i h1 h2 <;> first | rfl | (exfalso; omega) | skip
  all_goals simp_all <;> omega

theorem numberPow2_FrexpUnfold {T : FTy} (x : FV T) : frexp x = (Id.run do
    let xu0 := x.toBits
    let mut xu := xu0
    let xs := withoutBits xu0 (signMask T) T.fmt.width
    if xs >= exponentMask T then return (x, 0)
    let mut k : Int := (xs / 2 ^ T.fmt.sb : Nat)
    if k == 0 then
      if xs == 0 then return (x, 0)
      let m := leadingZeros T.fmt.width xs - T.fmt.eb
      let xs := xs * 2 ^ m
      xu := xs + (if fsignbit x then signMask T else 0)
      k := 1 - m
    k := k - (T.fmt.bias - 1)
    xu := withoutBits xu (exponentMask T) T.fmt.width + (T.fmt.bias - 1) * 2 ^ T.fmt.sb
    return (Fl.ofBits xu, k)) := rfl

theorem numberPow2_IdPure {α : Type} (a : α) : (pure a : Id α) = a := rfl

theorem numberPow2_FrexpChar {T : FTy} (x : FV T) (hx : x.isfinite = true) (hz : x.magnitude ≠ 0) :
    frexp x = (NextProofs.encode T x.signbit ((T.fmt.bias - 1) * 2 ^ T.fmt.sb + (numberPow2_NormSig x - 2 ^ T.fmt.sb)),
      ((magKey T.fmt x.magnitude).log2 : Int) - T.fmt.bias - T.fmt.sb + 2) := by
  have hfb := numberPow2_FmtBounds T
  have hbias := (good_fty T).bias_pos
  have hxs : withoutBits x.toBits (signMask T) T.fmt.width = x.magnitude := withoutSignBitMagnitude x
  have hmag := (TruncProofs.isfinite_iff_mag x).1 hx
  have hnm : ¬ (x.magnitude ≥ exponentMask T) := by unfold exponentMask; omega
  have hdiv : x.magnitude / 2 ^ T.fmt.sb = x.expField := (Fl.expField_eq x).symm
  obtain ⟨hc1, hc2, -, hnorm, hsub⟩ := numberPow2_NormSigFacts x hx hz
  rw [numberPow2_FrexpUnfold]
  simp only [Id.run, hxs, hnm, hdiv, Bool.false_eq_true, ↓reduceIte]
  by_cases hB : x.expField = 0
  · obtain ⟨hL, -, hlog⟩ := hsub hB
    obtain ⟨hlz, hclr⟩ := numberPow2_SubnormalShift x hx hz hB
    have hz' : (x.magnitude == 0) = false := by simp [hz]
    simp only [hB, Int.natCast_zero, beq_self_eq_true, ↓reduceIte, hz', Bool.false_eq_true]
    rw [hclr, hlz, hL]
    rw [numberPow2_IdPure]
    refine Prod.ext ?_ ?_
    · show Fl.ofBits _ = _
      rw [← numberPow2_EncodeBits]; congr 1; omega
    · show (_ : Int) = _
      omega
  · obtain ⟨hL, hc⟩ := hnorm hB
    have hBc : ((x.expField : Int) == 0) = false := by simp; omega
    simp only [hBc, Bool.false_eq_true, ↓reduceIte]
    rw [numberPow2_ClearExp x, hL, hc, Nat.add_sub_cancel]
    rw [numberPow2_IdPure]
    refine Prod.ext ?_ ?_
    · show Fl.ofBits _ = _
      rw [← numberPow2_EncodeBits]; congr 1; omega
    · show (_ : Int) = _
      omega

def numberPow2Half (T : FTy) : FV T := reinterpret_Float_Int T (exponent_half T)

theorem numberPow2HalfFacts (T : FTy) :
    (numberPow2Half T).isfinite = true ∧ (numberPow2Half T).iszero = false ∧
      (numberPow2Half T).signbit = false ∧ (numberPow2Half T).frac = 0 ∧
      numberPow2Half T = NextProofs.encode T false ((T.fmt.bias - 1) * 2 ^ T.fmt.sb) := by
  cases T <;> decide

theorem numberPow2HalfConvert (T : FTy) :
    (Fl.convert (numberPow2Half T) : FV .f64) = numberPow2Half .f64 := by
  cases T <;> decide

theorem numberPow2CompareHalf (T : FTy) (x : FV T) :
    eq_IEEEFloat (convertFloat .f64 x) (numberPow2Half .f64) = Fl.eq x (numberPow2Half T) := by
  rw [eq_IEEEFloat_eq, convertFloat_eq]
  cases T with
  | f16 =>
    rw [← numberPow2HalfConvert .f16]
    exact (Fl.convert_widen_cmp (good_fty .f16) (good_fty .f64)
      (by decide) (by decide) (by decide) x (numberPow2Half .f16)).1
  | f32 =>
    rw [← numberPow2HalfConvert .f32]
    exact (Fl.convert_widen_cmp (good_fty .f32) (good_fty .f64)
      (by decide) (by decide) (by decide) x (numberPow2Half .f32)).1
  | f64 =>
    simp only [Fl.convert, beq_self_eq_true, ite_true, Fl.ofBits_toBits]

theorem numberPow2EqHalf (T : FTy) (x : FV T) :
    Fl.eq x (numberPow2Half T) = true ↔ x = numberPow2Half T := by
  have hfinite := (numberPow2HalfFacts T).1
  have hzero := (numberPow2HalfFacts T).2.1
  have hnan := Fl.isnan_of_finite hfinite
  unfold Fl.eq
  simp only [hnan, Bool.not_false, Bool.and_true, hzero, Bool.and_false,
    Bool.or_false, Bool.and_eq_true, beq_iff_eq]
  constructor
  · intro h
    exact Fl.ext_toBits h.2
  · intro h
    subst x
    exact ⟨by rw [hnan]; rfl, rfl⟩

theorem numberPow2FrexpHalf (T : FTy) (x : FV T)
    (hfinite : x.isfinite = true) (hzero : x.magnitude ≠ 0) :
    (frexp x).1 = numberPow2Half T ↔
      x.signbit = false ∧ numberPow2_NormSig x = 2 ^ T.fmt.sb := by
  have hbias := (good_fty T).bias_pos
  have hemax := (good_fty T).emax_eq
  have hfmt := numberPow2_FmtBounds T
  have hN := numberPow2_NormSigFacts x hfinite hzero
  have hpow : 2 ^ (T.fmt.sb + 1) = 2 ^ T.fmt.sb * 2 := Nat.pow_succ _ _
  have hfrac : numberPow2_NormSig x - 2 ^ T.fmt.sb < 2 ^ T.fmt.sb := by omega
  have hB : T.fmt.bias - 1 < 2 ^ T.fmt.eb := by
    have := (good_fty T).emax_succ
    omega
  have hparts := Fl.pack_parts (f := T.fmt) x.signbit (T.fmt.bias - 1)
    (numberPow2_NormSig x - 2 ^ T.fmt.sb) hB hfrac
  rw [numberPow2_FrexpChar x hfinite hzero]
  dsimp only
  constructor
  · intro he
    have hs := congrArg Fl.signbit he
    have hf := congrArg Fl.frac he
    change (Fl.pack x.signbit (T.fmt.bias - 1)
      (numberPow2_NormSig x - 2 ^ T.fmt.sb) : FV T).signbit = _ at hs
    change (Fl.pack x.signbit (T.fmt.bias - 1)
      (numberPow2_NormSig x - 2 ^ T.fmt.sb) : FV T).frac = _ at hf
    rw [hparts.1, (numberPow2HalfFacts T).2.2.1] at hs
    rw [hparts.2.2.1, (numberPow2HalfFacts T).2.2.2.1] at hf
    exact ⟨hs, by omega⟩
  · intro h
    rw [h.1, h.2, Nat.sub_self, Nat.add_zero]
    exact (numberPow2HalfFacts T).2.2.2.2.symm

theorem numberPow2NormSigPower (T : FTy) (x : FV T)
    (hfinite : x.isfinite = true) (hzero : x.magnitude ≠ 0) :
    numberPow2_NormSig x = 2 ^ T.fmt.sb ↔
      ∃ k : Nat, magKey T.fmt x.magnitude = 2 ^ k := by
  have hN := numberPow2_NormSigFacts x hfinite hzero
  have hp : 0 < 2 ^ T.fmt.sb := Nat.two_pow_pos _
  constructor
  · intro he
    refine ⟨(magKey T.fmt x.magnitude).log2, ?_⟩
    have hrel := hN.2.2.1
    rw [he, Nat.mul_comm (2 ^ T.fmt.sb)] at hrel
    exact Nat.eq_of_mul_eq_mul_right hp hrel
  · rintro ⟨k, hk⟩
    have hlog : (magKey T.fmt x.magnitude).log2 = k := by
      rw [hk]
      simpa only [Nat.one_mul, show (1 : Nat).log2 = 0 from rfl, Nat.zero_add]
        using Fl.log2_mul_pow 1 k (by decide)
    have hrel := hN.2.2.1
    rw [hlog, hk, Nat.mul_comm (2 ^ k)] at hrel
    exact (Nat.eq_of_mul_eq_mul_right (Nat.two_pow_pos k) hrel).symm

theorem numberPow2Factor (v : Int) (hv : 0 < v) (a b : Nat)
    (h : v * (2 : Int) ^ a = (2 : Int) ^ b) : ∃ k : Nat, v = (2 : Int) ^ k := by
  have hab : a ≤ b := by
    by_cases hab : a ≤ b
    · exact hab
    · have hp := Int.pow_lt_pow_of_lt (a := 2) (by decide) (show b < a by omega)
      have hm := Int.mul_le_mul_of_nonneg_right (show (1 : Int) ≤ v by omega)
        (show 0 ≤ (2 : Int) ^ a from Int.le_of_lt (Int.pow_pos (by decide)))
      rw [Int.one_mul, h] at hm
      omega
  refine ⟨b - a, ?_⟩
  have hp : (2 : Int) ^ b = (2 : Int) ^ (b - a) * (2 : Int) ^ a := by
    rw [← Int.pow_add]
    congr 1
    omega
  rw [hp] at h
  exact Int.eq_of_mul_eq_mul_right (Int.ne_of_gt (Int.pow_pos (by decide))) h

theorem numberPow2Ratio (n v : Int) (d : Nat) (hd : 0 < d) (D : Nat)
    (hrel : n * (2 : Int) ^ D = v * (d : Int)) :
    (0 < n ∧ ((∃ k : Nat, n = (d : Int) * (2 : Int) ^ k) ∨
      (∃ k : Nat, n * (2 : Int) ^ k = (d : Int)))) ↔
        ∃ k : Nat, v = (2 : Int) ^ k := by
  have hd' : (0 : Int) < (d : Int) := Int.natCast_pos.mpr hd
  have hD : (0 : Int) < (2 : Int) ^ D := Int.pow_pos (by decide)
  constructor
  · intro h
    have hv : 0 < v := Int.pos_of_mul_pos_left (by rw [← hrel]; exact Int.mul_pos h.1 hD) hd'
    rcases h.2 with ⟨k, hk⟩ | ⟨k, hk⟩
    · refine ⟨D + k, ?_⟩
      apply Int.eq_of_mul_eq_mul_right (Int.ne_of_gt hd')
      rw [← hrel, hk, Int.pow_add]
      ac_rfl
    · have hh : v * (2 : Int) ^ k = (2 : Int) ^ D := by
        apply Int.eq_of_mul_eq_mul_right (Int.ne_of_gt hd')
        calc
          (v * (2 : Int) ^ k) * (d : Int) = (v * (d : Int)) * (2 : Int) ^ k :=
            Int.mul_right_comm _ _ _
          _ = (n * (2 : Int) ^ D) * (2 : Int) ^ k := by rw [hrel]
          _ = (n * (2 : Int) ^ k) * (2 : Int) ^ D := Int.mul_right_comm _ _ _
          _ = (2 : Int) ^ D * (d : Int) := by rw [hk, Int.mul_comm]
      exact numberPow2Factor v hv k D hh
  · rintro ⟨k, hk⟩
    have hv : 0 < v := by rw [hk]; exact Int.pow_pos (by decide)
    have hn : 0 < n := Int.pos_of_mul_pos_left (by rw [hrel]; exact Int.mul_pos hv hd') hD
    refine ⟨hn, ?_⟩
    by_cases hDk : D ≤ k
    · left
      refine ⟨k - D, ?_⟩
      apply Int.eq_of_mul_eq_mul_right (Int.ne_of_gt hD)
      calc
        n * (2 : Int) ^ D = v * (d : Int) := hrel
        _ = (2 : Int) ^ (k - D + D) * (d : Int) := by rw [hk]; congr 2; omega
        _ = ((d : Int) * (2 : Int) ^ (k - D)) * (2 : Int) ^ D := by
          rw [Int.pow_add]
          ac_rfl
    · right
      refine ⟨D - k, ?_⟩
      apply Int.eq_of_mul_eq_mul_right (Int.ne_of_gt (Int.pow_pos (by decide) : 0 < (2 : Int) ^ k))
      calc
        (n * (2 : Int) ^ (D - k)) * (2 : Int) ^ k = n * (2 : Int) ^ D := by
          rw [Int.mul_assoc, ← Int.pow_add]
          congr 2
          omega
        _ = v * (d : Int) := hrel
        _ = (d : Int) * (2 : Int) ^ k := by rw [hk, Int.mul_comm]

theorem numberPow2FloatKey (T : FTy) (x : FV T) (hfinite : x.isfinite = true) :
    JuliaLean.Proofs.base.intfuncs.approvedRound3.FloatPowerOfTwo x ↔
      ∃ k : Nat, x.key = (2 : Int) ^ k := by
  have hk := Fl.toRat_key (good_fty T) x hfinite
  unfold JuliaLean.Proofs.base.intfuncs.approvedRound3.FloatPowerOfTwo
  rw [hfinite, eq_self, true_and]
  have hden : (T.fmt.den : Int) = (2 : Int) ^ (T.fmt.bias + T.fmt.sb - 1) := by
    unfold Fmt.den
    rw [Int.natCast_pow]
    rfl
  rw [hden] at hk
  exact numberPow2Ratio x.toRat.1 x.key x.toRat.2 hk.1 _ hk.2

theorem numberPow2KeySign (T : FTy) (x : FV T) :
    (∃ k : Nat, x.key = (2 : Int) ^ k) ↔
      x.signbit = false ∧ ∃ k : Nat, magKey T.fmt x.magnitude = 2 ^ k := by
  unfold Fl.key
  cases hs : x.signbit
  · simp only [Bool.false_eq_true, ite_false, true_and]
