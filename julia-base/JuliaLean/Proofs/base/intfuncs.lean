theorem baseString_positive_success {I B : Type} (o : IntegerOps I) (bo : IntegerOps B)
    (remInt : B → JInt64) (rem : I → Int → Jl Int) (div : I → Int → Jl I)
    (mod : I → Int → Jl Int) (cld : I → Int → Jl I)
    (ndigitsFn : I → JInt64 → JInt64 → Jl JInt64)
    (base : B) (x : I) (pad count : JInt64) (neg : Bool)
    (hb : 2 ≤ bo.value base) (hb62 : bo.value base ≤ 62) (hx : 0 ≤ o.value x)
    (habs : bo.value (bo.abs base) = bo.value base)
    (hbase : (remInt base).val = bo.value base)
    (hneg : neg = false ∨ 0 < o.value x)
    (hcall : ndigitsFn x (remInt base) pad = .ok count)
    (hcount : DigitCount (o.value x) (bo.value base) pad.val count.val)
    (halloc : boolInt neg + count.val ≤ IntTy.max .i64)
    (hrem : ∀ y, 0 ≤ o.value y → rem y (bo.value base) = .ok (o.value y % bo.value base))
    (hdiv : ∀ y, 0 ≤ o.value y → ∃ q, div y (bo.value base) = .ok q ∧
      o.value q = o.value y / bo.value base) :
    ∃ out, baseString o bo remInt rem div mod cld ndigitsFn base x pad neg = .ok out ∧
      StringRepresentation (if neg then -o.value x else o.value x) (bo.value base) pad.val out.bytes := by
  have hc0 : 0 ≤ count.val := hcount.1
  have hsign : 0 ≤ boolInt neg := by cases neg <;> decide
  have hn0 : 0 ≤ boolInt neg + count.val := by omega
  have hnmin : IntTy.min .i64 ≤ boolInt neg + count.val := by
    have hmin : IntTy.min .i64 ≤ 0 := by decide
    omega
  have hnwrap : wrapInt .i64 (boolInt neg + count.val) = boolInt neg + count.val :=
    wrapInt_of_inRange _ _ ⟨hnmin, halloc⟩
  have hnu : boolInt neg + count.val ≤ IntTy.max .u64 := by
    have hmax : IntTy.max .i64 ≤ IntTy.max .u64 := by decide
    omega
  have hlen : (boolInt neg + count.val).toNat = (boolInt neg).toNat + count.val.toNat := by omega
  have hlarge : decide ((remInt base).val.natAbs > 36) = decide (36 < bo.value base) := by
    have hpos : 0 ≤ bo.value base := by omega
    have hnabs : ((bo.value base).natAbs : Int) = bo.value base := Int.natAbs_of_nonneg hpos
    rw [hbase]
    by_cases hlarge : 36 < bo.value base
    · have hnlarge : 36 < (bo.value base).natAbs := by omega
      simp only [hlarge, hnlarge, decide_true]
    · have hnlarge : ¬ 36 < (bo.value base).natAbs := by omega
      simp only [hlarge, hnlarge, decide_false]
  let initial : Buffer := ⟨List.replicate (boolInt neg + count.val).toNat 0, [], []⟩
  obtain ⟨out, hout, hbytes⟩ := baseLoop_written o rem div mod cld (bo.value base) hb hb62 hrem hdiv
    neg count.val.toNat ((boolInt neg + count.val).toNat + 1) x initial []
    (by omega) hx (by simp only [initial, hlen, List.append_nil])
  have hi : boolInt neg + (count.val.toNat : Int) = boolInt neg + count.val := by omega
  rw [hi] at hout
  refine ⟨minusSign neg out, ?_, ?_⟩
  · unfold baseString
    rw [if_neg (by exact fun h => h (Or.inl hx)), if_neg (by rw [habs]; exact fun h => h ⟨hb, hb62⟩)]
    dsimp only
    rw [hcall]
    simp only [Bind.bind, Except.bind, hnwrap]
    rw [newBuffer_nonnegative _ hn0 hnu]
    simp only [Bind.bind, Except.bind, Pure.pure, Except.pure]
    rw [hlarge, hbase]
    simp only [initial] at hout
    rw [hout]
  · have hfinal : (minusSign neg out).bytes =
        (if neg then [45] else []) ++ writtenDigits (bo.value base) (decide (36 < bo.value base)) count.val.toNat (o.value x) := by
      cases neg with
      | false => simpa only [minusSign, Bool.false_eq_true, ite_false, boolInt,
          Int.toNat_zero, List.replicate_zero, List.nil_append, List.append_nil] using hbytes
      | true =>
        simp only [minusSign, ite_true, store]
        have hi0 : ((1 : Int) - 1).toNat = 0 := by decide
        rw [hbytes]
        simp only [boolInt, ite_true, Int.toNat_one, List.replicate_one, List.singleton_append,
          List.append_nil, hi0, List.set_cons_zero]
    rw [hfinal]
    exact writtenDigits_representation _ _ _ _ _ hb hb62 hx hneg hcount


theorem newBuffer_negative (n : Int) (hn : n < 0) :
