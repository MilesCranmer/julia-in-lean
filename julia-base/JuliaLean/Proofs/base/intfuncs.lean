    let expected : Int := Nat.gcd a.val.natAbs b.val.natAbs
    let observed := gcdxIntegerBits (World := W) a b world
    if expected ≤ t.max then
      ∃ d u v, observed = some (.ok ((d, u, v), world)) ∧
        d.val = expected ∧
        (a.val * u.val + b.val * v.val - d.val) % (2 ^ t.bits : Int) = 0 ∧
