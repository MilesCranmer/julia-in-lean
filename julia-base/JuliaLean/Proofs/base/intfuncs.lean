/-- Mathematical representability of both inputs in Julia's selected common
native type. It does not invoke conversion or promotion. -/
def PromotionInputsFit {s t : IntTy} (a : JInt s) (b : JInt t) : Prop :=
  (s.promote t).min ≤ a.val ∧ a.val ≤ (s.promote t).max ∧
  (s.promote t).min ≤ b.val ∧ b.val ≤ (s.promote t).max

/-- Native conversion failure precedes the arithmetic contract. No input is
excluded: if either value is unrepresentable in the common type, the method
requires InexactError even if its hypothetical mathematical result would fit.
Otherwise the nonnegative mathematical result, or exact overflow, is required. -/
def PromotedNativeOutcome {W : Type} {s t : IntTy} (world : W)
    (a : JInt s) (b : JInt t) (expected : Nat)
    (observed : Option
      (Except (JuliaLean.base.io.Error × W) (JInt (s.promote t) × W))) : Prop :=
  if (s.promote t).min ≤ a.val ∧ a.val ≤ (s.promote t).max ∧
      (s.promote t).min ≤ b.val ∧ b.val ≤ (s.promote t).max then
    NativeNonnegativeOutcome world expected observed
  else
    ∃ functionName, observed = some (.error (.jl (.inexactError functionName), world))

