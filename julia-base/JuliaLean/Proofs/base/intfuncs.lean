private theorem ok_bind {α β : Type} (a : α) (f : α → Jl β) :
    (Bind.bind (Except.ok a : Jl α) f) = f a := rfl

private theorem pure_bind {α β : Type} (a : α) (f : α → Jl β) :
    (Bind.bind (Pure.pure a : Jl α) f) = f a := rfl

private theorem err_bind {α β : Type} (e : JlError) (f : α → Jl β) :
    (Bind.bind (Except.error e : Jl α) f) = Except.error e := rfl

private theorem checkedAbsBits_exact (t : IntTy) (x : JInt t) :
    ExactOrOverflow (JuliaLean.base.checked.checkedAbsBits x) (x.val.natAbs : Int) := by
  have habs : JuliaLean.Proofs.base.checked.ExactOrOverflow
      (JuliaLean.base.checked.checkedAbsBits x) (if x.val < 0 then -x.val else x.val) :=
    JuliaLean.Proofs.base.checked.absExact t x
  rw [← natAbs_eq_ite x.val] at habs
  unfold ExactOrOverflow
  unfold JuliaLean.Proofs.base.checked.ExactOrOverflow at habs
  by_cases h : fits t (x.val.natAbs : Int)
  · have h' : t.min ≤ (x.val.natAbs : Int) ∧ (x.val.natAbs : Int) ≤ t.max := h
    rw [if_pos h]
    rw [if_pos h'] at habs
    exact habs
  · have h' : ¬ (t.min ≤ (x.val.natAbs : Int) ∧ (x.val.natAbs : Int) ≤ t.max) := h
    rw [if_neg h]
    rw [if_neg h'] at habs
    cases hcall : JuliaLean.base.checked.checkedAbsBits x with
    | ok _ => rw [hcall] at habs; cases habs
    | error e =>
        rw [hcall] at habs
        cases e <;> simpa [overflowError, JuliaLean.Proofs.base.checked.Overflowed] using habs
theorem rationalUnaryAllWidths_proven : RationalUnaryAllWidths := by
  refine ⟨rationalUnaryGcd_proven, ?_⟩
  intro t R num den ratio hratio a hden
  have habs := checkedAbsBits_exact t (num a)
  unfold ExactOrOverflow at habs
  by_cases hfit : fits t ((num a).val.natAbs : Int)
  · rw [if_pos hfit] at habs ⊢
    obtain ⟨n', hn', hn'val⟩ := habs
    obtain ⟨r, hr, hdenr, hnumr⟩ := hratio n' (den a) hden
    refine ⟨r, ?_, ?_, ?_⟩
    · simp [gcd_Unary_Rational, hn', Bind.bind, Except.bind, hr]
    · rw [hnumr, hn'val]
    · have hnonneg : 0 ≤ ((num a).val.natAbs : Int) * (den r).val :=
        Int.mul_nonneg (Int.natCast_nonneg _) (Int.le_of_lt hdenr)
      rw [← hn'val, ← hnumr] at hnonneg
      exact int_nonneg_of_mul_pos hnonneg hden
  · rw [if_neg hfit] at habs ⊢
    unfold gcd_Unary_Rational
    cases hcall : JuliaLean.base.checked.checkedAbsBits (num a) with
    | ok _ => rw [hcall] at habs; cases habs
    | error e =>
      rw [hcall] at habs
      cases e <;> first | contradiction | trivial

