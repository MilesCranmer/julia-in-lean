        (literal.val = 0 ∨
          (literal.val = 1 ∧ (0, false) ∈ lcmArrayComparisonResults before))
    | .elementType input _ =>
        input = array ∧ (0, true) ∈ lcmArrayComparisonResults before ∧
        ((lcmArrayTypeCalls before).length = 0 ∨
          ((lcmArrayTypeCalls before).length = 1 ∧
            (lcmArraySubtypeOutputs before).length = 1))
    | .subtype typeValue upper _ =>
        upper = .integer ∧ lcmArrayTypeOutputs before = [typeValue]
    | .one typeValue _ =>
        lcmArraySubtypeOutputs before = [true] ∧
        (lcmArrayTypeOutputs before).length = 2 ∧
        (lcmArrayTypeOutputs before).getLast? = some typeValue
    | .interpolate textPrefix typeValue _ =>
        textPrefix = "lcm has no identity for " ∧
        lcmArraySubtypeOutputs before = [false] ∧
        (lcmArrayTypeOutputs before).length = 2 ∧
        (lcmArrayTypeOutputs before).getLast? = some typeValue
    | .only input _ =>
        input = array ∧ (1, true) ∈ lcmArrayComparisonResults before
    | .absolute value _ => lcmArrayOnlyOutputs before = [value]
    | .reduction function input _ =>
        function = .lcm ∧ input = array ∧
        (1, false) ∈ lcmArrayComparisonResults before

