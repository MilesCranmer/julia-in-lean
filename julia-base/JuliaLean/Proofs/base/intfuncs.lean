theorem gcdxUnaryBezout_proven : GcdxUnaryBezout := by
  refine ⟨?_, ?_, ?_⟩
  · intro t a
    have habs := checkedAbsBits_exact t a
    unfold ExactOrOverflow at habs
    by_cases hfit : fits t (a.val.natAbs : Int)
    · rw [if_pos hfit] at habs ⊢
      obtain ⟨d, hd, hdval⟩ := habs
      unfold gcdx_Unary gcd_Unary_Integer
      rw [hd]
      dsimp only [Bind.bind, Except.bind, Pure.pure, Except.pure]
      have h1 : (JuliaLean.base.int.lit t 1).val = 1 := by cases t <;> decide
      let u := if decide (a.val < 0) then JuliaLean.base.int.neg (JuliaLean.base.int.lit t 1)
        else JuliaLean.base.int.lit t 1
      refine ⟨d, u, rfl, hdval, ?_⟩
      by_cases hs : t.signed = true
      · rw [if_pos hs, hdval]
        by_cases hneg : a.val < 0
        · have hu : u.val = -1 := by
            dsimp only [u]
            rw [if_pos (decide_eq_true hneg), JuliaLean.base.int.neg,
              JuliaLean.Proofs.base.int.neg_int_val, h1]
            cases t <;> simp_all [IntTy.signed, wrapInt] <;> decide
          rw [hu]; omega
        · have hu : u.val = 1 := by
            dsimp only [u]; rw [if_neg (by simp [hneg])]; exact h1
          rw [hu]; omega
      · rw [if_neg hs, hdval]
        have ha0 : 0 ≤ a.val := by have := a.property.1; cases t <;> simp_all [IntTy.signed, IntTy.min]
        have hu : u.val = 1 := by
          dsimp only [u]; rw [if_neg (by simp [show ¬ a.val < 0 by omega])]; exact h1
        rw [hu]
        have hsub : a.val * 1 - (a.val.natAbs : Int) = 0 := by omega
        rw [hsub, Int.zero_emod]
    · rw [if_neg hfit] at habs ⊢
      unfold gcdx_Unary gcd_Unary_Integer
      cases hcall : JuliaLean.base.checked.checkedAbsBits a with
      | ok _ => rw [hcall] at habs; cases habs
      | error e =>
        rw [err_bind]
        rw [hcall] at habs
        cases e <;> first | contradiction | trivial
  · intro a
    unfold gcdx_Unary gcd_Unary_Integer bigOps
    dsimp only [Bind.bind, Except.bind, Pure.pure, Except.pure]
    refine ⟨(a.natAbs : Int), if decide (a < 0) then -1 else 1, rfl, rfl, ?_⟩
    by_cases hneg : a < 0
    · rw [if_pos (decide_eq_true hneg)]; omega
    · rw [if_neg (by simp [hneg])]; omega
  · intro R num den ratio one neg hratio hone a hden
    unfold gcdx_Unary gcd_Unary_Rational bigOps
    dsimp only [Bind.bind, Except.bind, Pure.pure, Except.pure]
    obtain ⟨d, hd, hdd, hnumd⟩ := hratio (num a).natAbs (den a) hden
    rw [hd]
    dsimp only
    let u := if decide (num a < 0) then neg (one a) else one a
    refine ⟨d, u, rfl, hnumd, ?_⟩
    have hu_den : den u = 1 := by
      dsimp only [u]
      split
      · rw [(hone _).2.2.2, (hone a).2.1]
      · exact (hone a).2.1
    have hu_num : num a * num u = (num a).natAbs := by
      dsimp only [u]
      by_cases hneg : num a < 0
      · rw [if_pos (decide_eq_true hneg), (hone _).2.2.1, (hone a).1]; omega
      · rw [if_neg (by simp [hneg]), (hone a).1]; omega
    rw [hu_den, hu_num, Int.mul_one, hnumd]

private theorem not_fits_gcdMath_cases {t : IntTy} {a b : JInt t}
    (h : ¬ fits t (gcdMath a.val b.val)) :
    t.signed = true ∧
    ((a = JuliaLean.base.int.typemin t ∧ b = JuliaLean.base.int.typemin t) ∨
     (a = JuliaLean.base.int.typemin t ∧ b = JuliaLean.base.int.lit t 0) ∨
     (a = JuliaLean.base.int.lit t 0 ∧ b = JuliaLean.base.int.typemin t)) := by
  have ha := a.property
  have hb := b.property
  have hmin0 : t.min ≤ 0 := by cases t <;> decide
  have hg0 : 0 ≤ gcdMath a.val b.val := by unfold gcdMath; omega
  have hgt : gcdMath a.val b.val > t.max := by unfold fits at h; omega
  have h_le_a : a.val ≠ 0 → Nat.gcd a.val.natAbs b.val.natAbs ≤ a.val.natAbs :=
    fun ha0 => Nat.gcd_le_left _ (Int.natAbs_pos.mpr ha0)
  have h_le_b : b.val ≠ 0 → Nat.gcd a.val.natAbs b.val.natAbs ≤ b.val.natAbs :=
    fun hb0 => Nat.gcd_le_right _ (Int.natAbs_pos.mpr hb0)
  have ha_case : a.val = 0 ∨ (t.signed = true ∧ a.val = t.min) := by
    by_cases ha0 : a.val = 0
    · exact Or.inl ha0
    · right
      have hle := h_le_a ha0
      unfold gcdMath at hgt
      cases t <;> simp_all [IntTy.signed, IntTy.min, IntTy.max] <;> omega
  have hb_case : b.val = 0 ∨ (t.signed = true ∧ b.val = t.min) := by
    by_cases hb0 : b.val = 0
    · exact Or.inl hb0
    · right
      have hle := h_le_b hb0
      unfold gcdMath at hgt
      cases t <;> simp_all [IntTy.signed, IntTy.min, IntTy.max] <;> omega
  have hmin_val : (JuliaLean.base.int.typemin t).val = t.min := JuliaLean.Proofs.base.int.typemin_val t
  have h0_val : (JuliaLean.base.int.lit t 0).val = 0 := by cases t <;> decide
  rcases ha_case with ha0 | ⟨hs, hamin⟩ <;> rcases hb_case with hb0 | ⟨hs', hbmin⟩
  · exfalso
    rw [ha0, hb0] at hgt
    have h0 : gcdMath 0 0 = 0 := rfl
    have hmax0 : 0 ≤ t.max := by cases t <;> decide
    omega
  · refine ⟨hs', Or.inr (Or.inr ⟨Subtype.ext (ha0.trans h0_val.symm), Subtype.ext (hbmin.trans hmin_val.symm)⟩)⟩
  · refine ⟨hs, Or.inr (Or.inl ⟨Subtype.ext (hamin.trans hmin_val.symm), Subtype.ext (hb0.trans h0_val.symm)⟩)⟩
  · refine ⟨hs, Or.inl ⟨Subtype.ext (hamin.trans hmin_val.symm), Subtype.ext (hbmin.trans hmin_val.symm)⟩⟩

theorem gcdxUnrepresentable_proven : GcdxUnrepresentable := by
  intro t a b hnot
  obtain ⟨hs, hcases⟩ := not_fits_gcdMath_cases hnot
  rcases hcases with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ <;>
    (cases t <;> first | contradiction | decide)

private theorem ndigitsNegative_zero_state {S B : Type} (signedValue : S → Int) (cld : S → B → Jl S)
    (b : B) (s0 : S) (hs0 : signedValue s0 = 0) (d : JInt64) (n : Nat) :
