theorem largeBaseSingleDigit_proven : LargeBaseSingleDigit := by
  intro t b x base hbase hx hlt
  by_cases hfit : fits .i64 base.val
  · have hresult :
        ndigitsZeroBits digitCallees x base = .ok (JuliaLean.base.int.lit .i64 1) ∧
        ndigitsBits digitCallees x base (JuliaLean.base.int.lit .i64 1) = .ok 1 := by
      by_cases htwo : base.val = 2
      · exact largeBaseSingleDigit_fitted_two_proven t b x base htwo hx hlt hfit
      · by_cases height : base.val = 8
        · exact largeBaseSingleDigit_fitted_eight_proven t b x base height hx hlt hfit
        · by_cases hsixteen : base.val = 16
          · exact largeBaseSingleDigit_fitted_sixteen_proven t b x base hsixteen hx hlt hfit
          · by_cases hten : base.val = 10
            · exact largeBaseSingleDigit_fitted_ten_proven t b x base hten hx hlt hfit
            · cases hpow : ispow2Bits (JuliaLean.base.int.lit .i64 base.val) with
              | false =>
                  exact largeBaseSingleDigit_fitted_fallback_proven t b x base hbase hx hlt hfit
                    htwo height hsixteen hten hpow
              | true =>
                  exact largeBaseSingleDigit_fitted_power_proven t b x base hbase hx hlt hfit
                    htwo height hsixteen hten hpow
    simpa [hfit] using hresult
  · have hresult := largeBaseSingleDigit_oversized_proven t b x base hbase hx hlt hfit
    simpa [hfit] using hresult

