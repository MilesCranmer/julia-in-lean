or the conditional's TypeError after custom ! returns a non-Bool. -/
def InvmodTerminal {W V Ty P State Other : Type} (m : V)
    (trace : List (InvmodEvent W V Ty P State Other)) : Except JuliaLean.base.io.Error V → Prop
  | .ok value => trace.filterMap invmodEventError = [] ∧
      ∃ event input, trace.getLast? = some event ∧ event.call = .mod ∧
        event.arguments = [.value input, .value m] ∧ event.outcome = .ok (.value value)
  | .error error =>
      (trace.filterMap invmodEventError = [error] ∧
        ∃ event, trace.getLast? = some event ∧ invmodEventError event = some error) ∨
      (trace.filterMap invmodEventError = [] ∧ ∃ event, trace.getLast? = some event ∧
        ((event.call = .iszero ∧ event.outcome = .ok (.boolean true) ∧
            error = .jl (.domainError "`m` must not be 0.")) ∨
         (event.call = .notEqualOne ∧ event.outcome = .ok (.boolean true) ∧
            error = .jl (.domainError "")) ∨
         (event.call = .customNot ∧ (∃ value, event.outcome = .ok (.nonBool value)) ∧
            error = .foreignError "TypeError" "")))

/-- Every dynamic Integer input pair and arbitrary selected operations obey
operand/type/result provenance, call budgets, original short circuits, final
