theorem polynomial_nonnegative (base : Int) (hb : 0 ≤ base) (ds : List Int)
    (hd : ∀ d ∈ ds, 0 ≤ d) : 0 ≤ evalpoly base ds := by
  induction ds with
  | nil => exact Int.le_refl 0
  | cons d ds ih =>
    have hhead := hd d (by simp only [List.mem_cons, true_or])
    have htail := ih (fun x hx => hd x (by simp only [List.mem_cons]; exact Or.inr hx))
    have hm := Int.mul_nonneg hb htail
    change 0 ≤ d + base * evalpoly base ds
    omega

theorem polynomial_positive_at (base : Int) (hb : 0 < base) (ds : List Int)
    (hd : ∀ d ∈ ds, 0 ≤ d) (j : Nat) (d : Int)
    (hg : ds[j]? = some d) (hp : 0 < d) : 0 < evalpoly base ds := by
  induction ds generalizing j with
  | nil => cases hg
  | cons a ds ih =>
    have ha := hd a (by simp only [List.mem_cons, true_or])
    have htail : ∀ x ∈ ds, 0 ≤ x := fun x hx => hd x (by simp only [List.mem_cons]; exact Or.inr hx)
    cases j with
    | zero =>
      have had : a = d := Option.some.inj hg
      have hn := polynomial_nonnegative base (Int.le_of_lt hb) ds htail
      have hm := Int.mul_nonneg (Int.le_of_lt hb) hn
      change 0 < a + base * evalpoly base ds
      omega
    | succ j =>
      have hpos := ih htail j hg
      have hm := Int.mul_pos hb hpos
      change 0 < a + base * evalpoly base ds
      omega

theorem unsigned_values_nonnegative (ds : List (JInt .u64)) :
    ∀ d ∈ ds.map Subtype.val, 0 ≤ d := by
  intro d hd
