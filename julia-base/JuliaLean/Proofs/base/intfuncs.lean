def floatBits {T : JuliaLean.base.float.FTy} (x : JuliaLean.base.float.FV T) :=
  JuliaLean.base.float.bitcast_from_float T.uintTy x

def floatLowByte {T : JuliaLean.base.float.FTy} (x : JuliaLean.base.float.FV T) : Nat :=
  (JuliaLean.base.int.remT .u8 (floatBits x)).val.toNat

def floatLogicalShift {T : JuliaLean.base.float.FTy} (x : JuliaLean.base.float.FV T) (k : Nat) :=
  JuliaLean.base.float.bitcast_to_float T
    (JuliaLean.base.int.lshr_int (floatBits x) (JuliaLean.base.int.lit .i64 k))

def floatBitstring {T : JuliaLean.base.float.FTy} (x : JuliaLean.base.float.FV T) :=
  bitstring true T.fmt.width floatLowByte floatLowByte floatLowByte floatLogicalShift x

/-- Intrinsic dispatch over a primitive value's stored bits, at any bit width. -/
def primitiveByte {bits : Nat} (x : BitVec bits) : Nat :=
  if h : bits = 8 then (JuliaLean.C.jlBitcast x).toNat
  else if hlt : bits < 8 then
    (JuliaLean.base.int.okOf (JuliaLean.C.jlZextInt 8 x)
      (by intro e he; simp [JuliaLean.C.jlZextInt, Nat.not_le.mpr hlt, pure, Except.pure] at he)).toNat
  else
    (JuliaLean.base.int.okOf (JuliaLean.C.jlTruncInt 8 x)
      (by
        have hb : 8 < bits := by omega
        intro e he
        simp [JuliaLean.C.jlTruncInt, Nat.not_le.mpr hb, pure, Except.pure] at he)).toNat

def primitiveBitstring {bits : Nat} (x : BitVec bits) : Jl Buffer :=
  bitstring true bits primitiveByte primitiveByte primitiveByte
    (fun x k => JuliaLean.C.jlLshrInt x (BitVec.ofNat 64 k)) x

