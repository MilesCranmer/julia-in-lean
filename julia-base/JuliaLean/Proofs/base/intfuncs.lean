def modMixed {s t : IntTy} (x : JInt s) (y : JInt t) : Jl Int :=
  if s.signed = t.signed then (modMixedSameSign x y).map Subtype.val
  else if s.signed then (modMixedSignedUnsigned x y).map Subtype.val
  else (modMixedUnsignedSigned x y).map Subtype.val

def quotient (s t : IntTy) (up down : Bool) (x y : Int) : Jl Int :=
  let a := JuliaLean.base.int.lit s x
  let b := JuliaLean.base.int.lit t y
  if s.signed = t.signed then
    let (a,b) := JuliaLean.base.int.promoteSameSign a b
    (divBitIntegerMode a b (if up then .Up else if down then .Down else .ToZero)).map Subtype.val
  else if s.signed then
    if up then
      (div_Signed_Unsigned_Up
        (JuliaLean.base.int.divrem_BitSigned_Unsigned sameDivrem)
        JuliaLean.base.int.signbit (fun r => decide (r.val = 0))
        (fun q bit => JuliaLean.base.int.add q (JuliaLean.base.int.ofBool _ bit)) a b).map Subtype.val
    else if down then (fldmodMixedSignedUnsigned a b).map (fun pair => pair.1.val)
    else (JuliaLean.base.int.div_BitSigned_Unsigned sameDiv a b).map Subtype.val
  else
    if up then
      (div_Unsigned_Signed_Up
        (JuliaLean.base.int.divrem_Unsigned_BitSigned sameDivrem)
        JuliaLean.base.int.signbit (fun r => decide (r.val = 0))
        (fun q bit => JuliaLean.base.int.add q (JuliaLean.base.int.ofBool _ bit)) a b).map Subtype.val
    else if down then (fldmodMixedUnsignedSigned a b).map (fun pair => pair.1.val)
    else (JuliaLean.base.int.div_Unsigned_BitSigned sameDiv a b).map Subtype.val

