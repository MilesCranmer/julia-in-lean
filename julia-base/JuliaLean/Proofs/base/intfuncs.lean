theorem integerPowerNegative_proven : IntegerPowerNegative := by
  refine ⟨?_, ?_⟩
  · intro t e x p hp
    have hp1 : p.val ≠ 1 := by omega
    have hp0 : p.val ≠ 0 := by omega
    have hp2 : p.val ≠ 2 := by omega
    have h1 : (JuliaLean.base.int.lit t 1).val = 1 := by cases t <;> decide
    have hcall : powerBits x p =
        (if decide (x.val = 1) = true then .ok x
         else if decide ((JuliaLean.base.int.neg x).val = 1) = true then
           .ok (if p.val % 2 = 0 then JuliaLean.base.int.lit t 1 else x)
         else .error (.domainError "")) := by
      unfold powerBits powerBySquaring bitsOps bitOps throwPowerDomain_Integer
      simp only [Bind.bind, Except.bind, Pure.pure, Except.pure, id, hp1, hp0, hp2, hp, ↓reduceIte]
    rw [hcall]
    by_cases hx1 : x.val = 1
    · have hor : x.val = 1 ∨ (JuliaLean.base.int.neg x).val = 1 := Or.inl hx1
      rw [if_pos hor, if_pos (decide_eq_true hx1)]
      refine ⟨x, rfl, ?_⟩
      split <;> omega
    · have hx1f : ¬ (decide (x.val = 1) = true) := by simp [hx1]
      rw [if_neg hx1f]
      by_cases hnx1 : (JuliaLean.base.int.neg x).val = 1
      · have hor : x.val = 1 ∨ (JuliaLean.base.int.neg x).val = 1 := Or.inr hnx1
        rw [if_pos hor, if_pos (decide_eq_true hnx1)]
        refine ⟨if p.val % 2 = 0 then JuliaLean.base.int.lit t 1 else x, rfl, ?_⟩
        split <;> simp [h1]
      · have hor : ¬ (x.val = 1 ∨ (JuliaLean.base.int.neg x).val = 1) := by
          intro hc; rcases hc with hc | hc <;> contradiction
        have hnx1f : ¬ (decide ((JuliaLean.base.int.neg x).val = 1) = true) := by simp [hnx1]
        rw [if_neg hor, if_neg hnx1f]
        trivial
  · intro x p hp
    have hp1 : p ≠ 1 := by omega
    have hp0 : p ≠ 0 := by omega
    have hp2 : p ≠ 2 := by omega
    have hcall : powerBig x p =
        (if decide (x = 1) = true then .ok x
         else if decide (-x = 1) = true then
           .ok (if p % 2 = 0 then 1 else x)
         else .error (.domainError "")) := by
      unfold powerBig powerBySquaring bigOps throwPowerDomain_Integer
      simp only [Bind.bind, Except.bind, Pure.pure, Except.pure, id, hp1, hp0, hp2, hp, ↓reduceIte]
      rfl
    rw [hcall]
    by_cases hx1 : x = 1
    · have hor : x = 1 ∨ -x = 1 := Or.inl hx1
      rw [if_pos hor, if_pos (decide_eq_true hx1)]
      refine ⟨x, rfl, ?_⟩
      split <;> omega
    · have hx1f : ¬ (decide (x = 1) = true) := by simp [hx1]
      rw [if_neg hx1f]
      by_cases hnx1 : -x = 1
      · have hor : x = 1 ∨ -x = 1 := Or.inr hnx1
        rw [if_pos hor, if_pos (decide_eq_true hnx1)]
        exact ⟨if p % 2 = 0 then 1 else x, rfl, rfl⟩
      · have hor : ¬ (x = 1 ∨ -x = 1) := by
          intro hc; rcases hc with hc | hc <;> contradiction
        have hnx1f : ¬ (decide (-x = 1) = true) := by simp [hnx1]
        rw [if_neg hor, if_neg hnx1f]
        trivial
