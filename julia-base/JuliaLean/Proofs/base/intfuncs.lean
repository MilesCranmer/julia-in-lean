    Int.pow_pos (by decide)
  by_cases hq0 : 0 ≤ q
  · have hm := Int.mul_nonneg (Int.le_of_lt hpower) hq0
    omega
  · have hm := Int.mul_le_mul_of_nonneg_left (show q ≤ -1 by omega) (Int.le_of_lt hpower)
    rw [Int.mul_neg_one] at hm
