theorem topBit_zero {t : IntTy} (x : JInt t) (hx : x.val = 0) : topBit x = 0 := by
  have he : x = JuliaLean.base.int.lit t 0 := by
    apply Subtype.ext
    rw [JuliaLean.Proofs.base.int.lit_val, hx]
    cases t <;> decide
  rw [he]
  cases t <;> decide

theorem topBit_bound {t : IntTy} (x : JInt t) : topBit x ≤ 128 := by
  have h := JuliaLean.Proofs.base.int.topSetBit_proven t x
  have hb : t.bits ≤ 128 := by cases t <;> decide
  unfold topBit
  omega

theorem unsigned_topBit {t : IntTy} (ht : t.signed = false) (x : JInt t)
    (hx : x.val ≠ 0) : topBit x = x.val.natAbs.log2 + 1 := by
  have hn := unsigned_nonnegative ht x
  have hp : JuliaLean.Proofs.base.int.pattern x = x.val.natAbs := by
    rw [JuliaLean.Proofs.base.int.pattern_of_unsigned ht]
    omega
  rw [topBit_nonzero x (by rw [hp]; omega), hp]

theorem native_power_count {t : IntTy} (ht : t.signed = false)
    (x : JInt t) (pad : Int) (k : Nat) (hk : 0 < k) :
    let m := (topBit x + k - 1) / k
    m ≤ 128 ∧ DigitCount x.val ((2 : Int) ^ k) pad (max pad (m : Int)) := by
  dsimp only
  by_cases hx : x.val = 0
  · rw [topBit_zero x hx, Nat.zero_add, Nat.div_eq_of_lt (by omega)]
    simp only [Int.natCast_zero, hx]
    exact ⟨by omega, zero_count _ _ (Int.pow_pos (by decide))⟩
  · have htop := unsigned_topBit ht x hx
    have hbits := topBit_bound x
    have he : topBit x + k - 1 = x.val.natAbs.log2 + k := by omega
    rw [he]
    have h := binary_count_bounds x.val hx k hk
    have hb : (1 : Int) < 2 ^ k := by
      have hpow := Int.pow_lt_pow_of_lt (by decide : (1 : Int) < 2) hk
      simpa only [Int.pow_zero] using hpow
    exact ⟨by omega, padded_of_bounds x.val (2 ^ k) pad _ hb hx h.1 h.2.2.1 h.2.2.2⟩

theorem native_shift_value {t : IntTy} (ht : t.signed = false) (x : JInt t)
    (k : Nat) (hk : k ≤ 128) :
    (JuliaLean.base.int.lshr_Int x (JuliaLean.base.int.lit .i64 k)).val =
      x.val / (2 : Int) ^ k := by
  have hc : (JuliaLean.base.int.lit .i64 (k : Int)).val = (k : Int) := by
    apply JuliaLean.Proofs.base.int.lit_of_fits
    change -9223372036854775808 ≤ (k : Int) ∧ (k : Int) ≤ 9223372036854775807
    omega
  have h := JuliaLean.Proofs.base.int.pattern_lshr_Int x
    (JuliaLean.base.int.lit .i64 k) (by rw [hc]; omega)
  rw [JuliaLean.Proofs.base.int.pattern_of_unsigned ht,
    JuliaLean.Proofs.base.int.pattern_of_unsigned ht, hc, Int.toNat_natCast] at h
  have hn := unsigned_nonnegative ht x
  have hs := unsigned_nonnegative ht (JuliaLean.base.int.lshr_Int x
    (JuliaLean.base.int.lit .i64 k))
  have he : (x.val.toNat : Int) = x.val := Int.toNat_of_nonneg hn
  have hs' : (((JuliaLean.base.int.lshr_Int x (JuliaLean.base.int.lit .i64 k)).val.toNat : Nat) : Int) =
      (JuliaLean.base.int.lshr_Int x (JuliaLean.base.int.lit .i64 k)).val := Int.toNat_of_nonneg hs
  have hh := congrArg (fun n : Nat => (n : Int)) h
  have htwo : ((2 : Nat) : Int) = 2 := by decide
  simpa only [hs', Int.natCast_ediv, Int.natCast_pow, htwo, he] using hh

theorem native_lowByte_mod {t : IntTy} (x : JInt t) (k : Nat) (hk : k ≤ 8) :
    (JuliaLean.base.int.remT .u8 x).val.toNat % (2 ^ k) =
      (x.val % ((2 : Int) ^ k)).toNat := by
  rw [JuliaLean.Proofs.base.int.remT_val]
  have hu : wrapInt .u8 x.val = x.val % 256 := by
    rfl
  rw [hu]
  have h256 : (0 : Int) < 256 := by decide
  have hp : (0 : Int) < 2 ^ k := Int.pow_pos (by decide)
  have hd : (2 : Int) ^ k ∣ 256 := by
    have hpow : (256 : Int) = 2 ^ k * 2 ^ (8 - k) := by
      rw [← Int.pow_add, Nat.add_sub_of_le hk]
      decide
    exact ⟨2 ^ (8 - k), hpow⟩
  have hmod := Int.emod_emod_of_dvd x.val hd
  have hnat : ((x.val % 256).toNat : Int) = x.val % 256 :=
    Int.toNat_of_nonneg (Int.emod_nonneg _ (by decide))
  have hcast : ((((x.val % 256).toNat % (2 ^ k) : Nat) : Int)) =
      x.val % (2 : Int) ^ k := by
    have htwo : ((2 : Nat) : Int) = 2 := by decide
    rw [Int.natCast_emod, Int.natCast_pow, htwo, hnat, hmod]
  omega

theorem writer_length_bounds (pad : JInt64) (m : Nat) (hm : m ≤ 128)
    (neg : Bool) (herr : ¬ (neg = true ∧ pad.val = IntTy.max .i64)) :
    0 ≤ max pad.val (m : Int) ∧
    0 ≤ boolInt neg + max pad.val (m : Int) ∧
    boolInt neg + max pad.val (m : Int) ≤ IntTy.max .i64 := by
  have hp := pad.property.2
  have hc : 0 ≤ max pad.val (m : Int) :=
    Int.le_trans (Int.natCast_nonneg m) (Int.le_max_right _ _)
  cases neg with
  | false =>
    simp only [boolInt, Bool.false_eq_true, ite_false, Int.zero_add]
    exact ⟨hc, hc, Int.max_le.mpr ⟨hp, by change (m : Int) ≤ 9223372036854775807; omega⟩⟩
  | true =>
    have hne : pad.val ≠ IntTy.max .i64 := fun h => herr ⟨rfl, h⟩
    have hpad : pad.val ≤ IntTy.max .i64 - 1 := by omega
    have hmax : max pad.val (m : Int) ≤ IntTy.max .i64 - 1 :=
      Int.max_le.mpr ⟨hpad, by change (m : Int) ≤ 9223372036854775807 - 1; omega⟩
    simp only [boolInt, ite_true]
    exact ⟨hc, by omega, by omega⟩

theorem minusSign_prefix (neg : Bool) (b : Buffer) (payload : List Nat)
    (hb : b.bytes = List.replicate (boolInt neg).toNat 0 ++ payload) :
    (minusSign neg b).bytes = (if neg then [45] else []) ++ payload := by
  cases neg <;> simp only [boolInt, ite_true, Bool.false_eq_true, ite_false,
    Int.toNat_zero, Int.toNat_one, List.replicate_zero, List.replicate_one,
    List.nil_append, List.singleton_append] at hb ⊢
  · exact hb
  · simp only [minusSign, ite_true, store, hb]
    rfl

theorem writtenDigits_count {n base pad count : Int} (hb : 2 ≤ base)
    (hb62 : base ≤ 62) (hn : 0 ≤ n) (hcount : DigitCount n base pad count) :
    decodeUnsigned base (writtenDigits base (decide (36 < base)) count.toNat n) = some n ∧
    DigitCount n base pad ((writtenDigits base (decide (36 < base)) count.toNat n).length : Int) := by
  have hc0 : 0 ≤ count := hcount.1
  have hsize : n < base ^ count.toNat := by
    by_cases hz : n = 0
    · rw [hz]
      exact Int.pow_pos (by omega)
    · have h := hcount.2.2
      rw [if_pos (show 0 < base by omega)] at h
      simpa only [Int.natAbs_of_nonneg hn] using (h.2 hz).2.1
  constructor
  · change (writtenDigits base (decide (36 < base)) count.toNat n).foldlM (decodeStep base) 0 = some n
    simpa only [Int.zero_mul, Int.zero_add] using
      writtenDigits_decode base hb hb62 count.toNat n 0 hn hsize
  · rw [writtenDigits_length, Int.toNat_of_nonneg hc0]
    exact hcount

theorem oct_success {U : Type} (bitsOf : U → Nat) (lowByte : U → Nat)
    (shift : U → Nat → U) (x : U) (pad : JInt64) (neg : Bool)
    (size : Int) (before : Buffer)
    (hsize : wrapInt .i64 (boolInt neg + max pad.val (((bitsOf x : Int) + 2) / 3)) = size)
    (halloc : newBuffer size = .ok before) :
    oct bitsOf lowByte shift x pad neg =
      .ok (minusSign neg (octLoop lowByte shift neg (size.toNat + 1) before x size)) := by
  unfold oct
  dsimp only
  simp only [hsize, halloc, Bind.bind, Except.bind, Pure.pure, Except.pure] <;> rfl

theorem oct_error {U : Type} (bitsOf : U → Nat) (lowByte : U → Nat)
    (shift : U → Nat → U) (x : U) (pad : JInt64) (neg : Bool)
    (size : Int) (err : JlError)
    (hsize : wrapInt .i64 (boolInt neg + max pad.val (((bitsOf x : Int) + 2) / 3)) = size)
    (halloc : newBuffer size = .error err) :
    oct bitsOf lowByte shift x pad neg = .error err := by
  unfold oct
  dsimp only
  rw [hsize, halloc]
  rfl

theorem oct_numeral {t : IntTy} (ht : t.signed = false) (x : JInt t)
    (pad : JInt64) (neg : Bool) :
    approvedRound6.WriterNumeral (approvedRound6.Concrete.octBits x pad neg)
      x.val 8 pad.val neg := by
  let m := (topBit x + 2) / 3
  have hmInt : ((topBit x : Int) + 2) / 3 = (m : Int) := by
    dsimp only [m]
    omega
  have hm := native_power_count ht x pad.val 3 (by decide)
  have he : topBit x + 3 - 1 = topBit x + 2 := by omega
  simp only [he] at hm
  change m ≤ 128 ∧ DigitCount x.val 8 pad.val (max pad.val (m : Int)) at hm
  unfold approvedRound6.WriterNumeral
  by_cases herr : neg = true ∧ pad.val = IntTy.max .i64
  · rw [if_pos herr, herr.1]
    have hmax : max pad.val (m : Int) = IntTy.max .i64 := by
      rw [herr.2]
      apply Int.max_eq_left
      change (m : Int) ≤ 9223372036854775807
      omega
    have hsize : wrapInt .i64 (boolInt true + max pad.val (((topBit x : Int) + 2) / 3)) =
        -9223372036854775808 := by
      rw [hmInt, hmax]
      decide
    have hcall := oct_error (@topBit t)
      (fun y : JInt t => (JuliaLean.base.int.remT .u8 y).val.toNat)
      (fun y k => JuliaLean.base.int.lshr_Int y (JuliaLean.base.int.lit .i64 k))
      x pad true (-9223372036854775808) (.inexactError (IntTy.u64.name))
      hsize (newBuffer_negative _ (by decide))
    have hnative : approvedRound6.Concrete.octBits x pad true =
        .error (.inexactError (IntTy.u64.name)) := hcall
    rw [hnative]
    exact True.intro
  · rw [if_neg herr]
    let count := max pad.val (m : Int)
    let size := boolInt neg + count
    have hbounds := writer_length_bounds pad m hm.1 neg herr
    have hc : 0 ≤ count := hbounds.1
    have hn : 0 ≤ size := hbounds.2.1
    have hnmax : size ≤ IntTy.max .i64 := hbounds.2.2
    have hnmaxU : size ≤ IntTy.max .u64 := by
      change size ≤ 18446744073709551615
      change size ≤ 9223372036854775807 at hnmax
      omega
    have hw : wrapInt .i64 size = size := by
      apply wrapInt_of_inRange
      exact ⟨by change -9223372036854775808 ≤ size; omega, hnmax⟩
    let before : Buffer := ⟨List.replicate size.toNat 0, [], []⟩
    let out := minusSign neg (octLoop
      (fun x : JInt t => (JuliaLean.base.int.remT .u8 x).val.toNat)
      (fun x n => JuliaLean.base.int.lshr_Int x (JuliaLean.base.int.lit .i64 n))
      neg (size.toNat + 1) before x size)
    let payload := writtenDigits 8 false count.toNat x.val
    have hsizeNat : size.toNat = (boolInt neg).toNat + count.toNat := by
      have hb : 0 ≤ boolInt neg := by cases neg <;> decide
      dsimp only [size]
      omega
    have hindex : boolInt neg + (count.toNat : Int) = size := by
      rw [Int.toNat_of_nonneg hc]
    have hlow : ∀ y : JInt t, 0 ≤ y.val →
        (JuliaLean.base.int.remT .u8 y).val.toNat % 8 = (y.val % 8).toNat := by
      intro y _
      exact native_lowByte_mod y 3 (by decide)
    have hshift : ∀ y : JInt t, 0 ≤ y.val →
        (JuliaLean.base.int.lshr_Int y (JuliaLean.base.int.lit .i64 3)).val = y.val / 8 := by
      intro y _
      exact native_shift_value ht y 3 (by decide)
    have hloop := octLoop_written (fun y : JInt t => y.val)
      (fun y => (JuliaLean.base.int.remT .u8 y).val.toNat)
      (fun y n => JuliaLean.base.int.lshr_Int y (JuliaLean.base.int.lit .i64 n))
      hlow hshift neg count.toNat (size.toNat + 1) x before []
      (by rw [hsizeNat]; omega) (unsigned_nonnegative ht x)
      (by simp only [before, hsizeNat, List.append_nil])
    rw [hindex, List.append_nil] at hloop
    have hout : out.bytes = (if neg then [45] else []) ++ payload :=
      minusSign_prefix neg _ payload hloop
    have hdecode := writtenDigits_count (by decide : (2 : Int) ≤ 8)
      (by decide : (8 : Int) ≤ 62) (unsigned_nonnegative ht x) hm.2
    refine ⟨out, payload, ?_, hout, hdecode.1, hdecode.2⟩
    have hsize : wrapInt .i64 (boolInt neg + max pad.val (((topBit x : Int) + 2) / 3)) = size := by
      rw [hmInt]
      exact hw
    exact oct_success (@topBit t)
      (fun y : JInt t => (JuliaLean.base.int.remT .u8 y).val.toNat)
      (fun y k => JuliaLean.base.int.lshr_Int y (JuliaLean.base.int.lit .i64 k))
      x pad neg size before hsize (newBuffer_nonnegative size hn hnmaxU)

end NativeFormatWork
