def rawDecimalApprox (r : Nat) (z : Int) : Jl JInt64 := do
  let lz := JuliaLean.base.int.lit .i64 r
  let nd := JuliaLean.base.int.add (JuliaLean.base.int.ashr_int
    (JuliaLean.base.int.mul (JuliaLean.base.int.lit .i64 1233) lz)
    (JuliaLean.base.int.lit .i64 12)) (JuliaLean.base.int.lit .i64 1)
  if nd.val < 1 then .error .boundsError else
    match powersOfTen[(nd.val - 1).toNat]? with
    | none => .error .boundsError
    | some power => pure (JuliaLean.base.int.sub nd
        (JuliaLean.base.int.lit .i64 (if z < power.val then 1 else 0)))

def decimalApprox (r : Nat) (z : Int) : Jl JInt64 :=
  let e := (1233 * r / 4096 + 1 : Nat)
  .ok (JuliaLean.base.int.lit .i64 ((e : Int) - if z < (10 : Int) ^ (e - 1) then 1 else 0))

