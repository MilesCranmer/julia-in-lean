private theorem gcdEuclidLoop_bigOps (n : Nat) : ∀ (a b : Int), b.natAbs < n →
    ∃ g, gcdEuclidLoop bigOps n a b = .ok (g, 0) ∧ g.natAbs = Nat.gcd a.natAbs b.natAbs := by
  induction n with
  | zero => intro a b h; omega
  | succ n ih =>
    intro a b hb
    unfold gcdEuclidLoop
    by_cases h0 : bigOps.value b = 0
    · have hb0 : b = 0 := h0
      subst hb0
      exact ⟨a, by simp [bigOps, Pure.pure, Except.pure], by simp⟩
    · have hb0 : b ≠ 0 := h0
      have hrem : bigOps.rem a b = .ok (a.tmod b) := by simp [bigOps, hb0, Pure.pure, Except.pure]
      have hlt : (a.tmod b).natAbs < b.natAbs := by
        rw [Int.natAbs_tmod]
        exact Nat.mod_lt _ (by omega)
      obtain ⟨g, hg, hgnat⟩ := ih b (a.tmod b) (by omega)
      refine ⟨g, ?_, ?_⟩
      · simp [h0, hrem, Bind.bind, Except.bind, hg]
      · rw [hgnat, Int.natAbs_tmod, Nat.gcd_comm b.natAbs (a.natAbs % b.natAbs),
          ← Nat.gcd_rec, Nat.gcd_comm]

theorem gcd_Integer_bigOps_eq (a b : Int) :
    gcd_Integer bigOps a b = .ok (gcdMath a b) := by
  unfold gcd_Integer magnitude
  obtain ⟨g, hg, hgnat⟩ := gcdEuclidLoop_bigOps (b.natAbs + 1) a b (by omega)
  change (do let (a, _) ← gcdEuclidLoop bigOps (b.natAbs + 1) a b; bigOps.checkedAbs a) = _
  rw [hg]
  simp [bigOps, Bind.bind, Except.bind, Pure.pure, Except.pure, gcdMath, hgnat]

private theorem foldl_gcd_one (xs : List Int) :
    xs.foldl (fun (g : Nat) x => Nat.gcd g x.natAbs) 1 = 1 := by
  induction xs with
  | nil => rfl
  | cons x xs ih =>
    simp only [List.foldl_cons, Nat.gcd_one_left]
    exact ih

private theorem gcd_Array_Integer_loop_bigOps (xs : List Int) (a : Int) (ha : 0 ≤ a) :
    gcd_Array_Integer.loop bigOps (gcd_Integer bigOps) a xs =
      .ok ((xs.foldl (fun (g : Nat) x => Nat.gcd g x.natAbs) a.natAbs : Nat) : Int) := by
  induction xs generalizing a with
  | nil =>
    simp only [gcd_Array_Integer.loop, List.foldl_nil, Pure.pure, Except.pure]
    congr 1
    omega
  | cons b bs ih =>
    unfold gcd_Array_Integer.loop
    rw [gcd_Integer_bigOps_eq]
    change (if bigOps.value (gcdMath a b) = 1 then pure (gcdMath a b)
      else gcd_Array_Integer.loop bigOps (gcd_Integer bigOps) (gcdMath a b) bs) = _
    have hnat : (gcdMath a b).natAbs = Nat.gcd a.natAbs b.natAbs := by
      unfold gcdMath; omega
    by_cases h1 : gcdMath a b = 1
    · have h1nat : Nat.gcd a.natAbs b.natAbs = 1 := by
        unfold gcdMath at h1; omega
      have hval1 : bigOps.value (gcdMath a b) = 1 := h1
      rw [if_pos hval1]
      simp [h1, List.foldl_cons, h1nat, foldl_gcd_one, Pure.pure, Except.pure]
    · have hval1 : bigOps.value (gcdMath a b) ≠ 1 := h1
      rw [if_neg hval1, List.foldl_cons, ih (gcdMath a b) (by unfold gcdMath; omega), hnat]

theorem gcdGenericExact_proven : GcdGenericExact := by
  refine ⟨gcd_Integer_bigOps_eq, ?_⟩
  intro xs
