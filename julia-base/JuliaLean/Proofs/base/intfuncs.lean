    match (JuliaLean.base.intfuncs.invmod_Bottom n rest : Jl R) with
    | .error (.methodError functionName) => functionName = "invmod"
    | _ => False

/-- The Any and AbstractMatrix diagnostic helpers have no eager computed
arguments. On their complete input domains they terminate with DomainError,
never a value or another exception class. This is the narrow error-surface
invariant of these internal helpers; no diagnostic text is specified.
Julia source: base/intfuncs.jl:385-387,393-397 at
f755f49a9e41380d7da126b3c1db9fe7f83dd027. -/
def LazyPowerDomainClasses : Prop :=
  ∀ (A P R : Type) (x : A) (p : P),
    (match (JuliaLean.base.intfuncs.throwPowerDomain_Any x p : Jl R) with
      | .error (.domainError _) => True
      | _ => False) ∧
    (match (JuliaLean.base.intfuncs.throwPowerDomain_Matrix x p : Jl R) with
      | .error (.domainError _) => True
      | _ => False)

/-- Native exponent conversion/negation finish at every width, including the
signed minimum, so the Integer diagnostic helper ultimately raises DomainError
without changing the world. The result carrier remains arbitrary because the
source never returns a normal value. No negative-exponent premise excludes
otherwise admissible direct calls to the internal helper.
