private theorem ndConcreteZero (t b : IntTy) (base : JInt b)
    (hvalid : base.val < -1 ∨ base.val > 1) :
    ndigitsZeroBits approvedRound3.Concrete.digitCallees
      (JuliaLean.base.int.lit t 0) base = .ok (JuliaLean.base.int.lit .i64 0) := by
  unfold ndigitsZeroBits ndigitsZero
  rcases hvalid with hneg | hpos
  · rw [ite_eq_left hneg]
    unfold ndigitsNegativeBits ndigitsNegative
    dsimp only
    by_cases hu : (!t.signed) = true
    · have htu : t.signed = false := by
        cases hs : t.signed
        · rfl
        · rw [hs] at hu
          cases hu
