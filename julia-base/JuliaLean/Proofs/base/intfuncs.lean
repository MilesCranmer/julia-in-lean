namespace JuliaLean.ChatGPT.Batch4.Group12
open JuliaLean JuliaLean.base.intfuncs JuliaLean.Proofs.base.intfuncs

/-- ASCII code of one binary digit. -/
def binaryCharacter (p j : Nat) : Nat := if p.testBit j then 49 else 48

/-- The source's four-byte SIMD packing expression, on an already truncated byte. -/
def binaryPacked (byte : Nat) : Nat :=
  let b32 := JuliaLean.base.int.lit .u32 byte
  let packed := JuliaLean.base.int.mulWrap b32 (JuliaLean.base.int.lit .u32 0x08040201)
  let shifted := JuliaLean.base.int.lshr_int packed (JuliaLean.base.int.lit .u8 3)
  (JuliaLean.base.int.addWrap (JuliaLean.base.int.lit .u32 0x30303030)
    (JuliaLean.base.int.band shifted (JuliaLean.base.int.lit .u32 0x01010101))).val.toNat

set_option maxRecDepth 10000 in
set_option maxHeartbeats 5000000 in
theorem binaryPacked_byte : ∀ b : Fin 256,
    binaryPacked b.val % 256 = binaryCharacter b.val 3 ∧
    binaryPacked b.val / 2^8 % 256 = binaryCharacter b.val 2 ∧
    binaryPacked b.val / 2^16 % 256 = binaryCharacter b.val 1 ∧
    binaryPacked b.val / 2^24 % 256 = binaryCharacter b.val 0 := by
  decide

private theorem binaryCharacter_mod (p j : Nat) (hj : j < 8) :
    binaryCharacter (p % 256) j = binaryCharacter p j := by
  unfold binaryCharacter
  change (if (p % 2^8).testBit j then 49 else 48) = _
  rw [Nat.testBit_mod_two_pow]
  simp only [hj, decide_true, Bool.true_and]

private theorem binaryCharacter_small (p j : Nat) : binaryCharacter p j < 256 := by
  unfold binaryCharacter
  split <;> decide

private theorem binaryCharacter_shift (p i n : Nat) :
    binaryCharacter (p / 2^n) i = binaryCharacter p (i + n) := by
  unfold binaryCharacter
  rw [Nat.testBit_div_two_pow]

def binaryChunk (b : Buffer) (i : Int) (p : Nat) : Buffer :=
  let d := binaryPacked (p % 256)
  let b := store b (i - 3) (d % 256)
  let b := store b (i - 2) (d / 2^8 % 256)
  let b := store b (i - 1) (d / 2^16 % 256)
  store b i (d / 2^24 % 256)

theorem binaryChunk_eq (b : Buffer) (i : Int) (p : Nat) :
    binaryChunk b i p =
      store (store (store (store b (i - 3) (binaryCharacter p 3))
        (i - 2) (binaryCharacter p 2)) (i - 1) (binaryCharacter p 1))
        i (binaryCharacter p 0) := by
  obtain ⟨h3, h2, h1, h0⟩ := binaryPacked_byte ⟨p % 256, Nat.mod_lt p (by decide)⟩
  dsimp only [binaryChunk]
  rw [h3, h2, h1, h0]
  rw [binaryCharacter_mod p 3 (by decide), binaryCharacter_mod p 2 (by decide),
    binaryCharacter_mod p 1 (by decide), binaryCharacter_mod p 0 (by decide)]


theorem binaryStore_length (b : Buffer) (i : Int) (v : Nat) :
    (store b i v).bytes.length = b.bytes.length := by
  simp only [store, List.length_set]

theorem binaryChunk_length (b : Buffer) (i : Int) (p : Nat) :
    (binaryChunk b i p).bytes.length = b.bytes.length := by
  rw [binaryChunk_eq]
  simp only [binaryStore_length]

theorem binaryChunk_get (b : Buffer) (i p j : Nat) (hi : 4 ≤ i)
    (hbuf : i ≤ b.bytes.length) :
    (binaryChunk b i p).bytes[j]? =
      if i - 4 ≤ j ∧ j < i then some (binaryCharacter p (i - 1 - j))
      else b.bytes[j]? := by
  have h0 : ((i : Int) - 1).toNat = i - 1 := by omega
  have h1 : ((i : Int) - 1 - 1).toNat = i - 2 := by omega
  have h2 : ((i : Int) - 2 - 1).toNat = i - 3 := by omega
  have h3 : ((i : Int) - 3 - 1).toNat = i - 4 := by omega
  rw [binaryChunk_eq]
  simp only [store, h0, h1, h2, h3, List.getElem?_set, List.length_set,
    show i - 1 < b.bytes.length by omega, show i - 2 < b.bytes.length by omega,
    show i - 3 < b.bytes.length by omega, show i - 4 < b.bytes.length by omega,
    ite_true, Nat.mod_eq_of_lt (binaryCharacter_small p 0),
    Nat.mod_eq_of_lt (binaryCharacter_small p 1),
    Nat.mod_eq_of_lt (binaryCharacter_small p 2),
    Nat.mod_eq_of_lt (binaryCharacter_small p 3)]
  by_cases h : i - 1 = j
  · have hband : i - 4 ≤ j ∧ j < i := by omega
    rw [ite_eq_left h, ite_eq_left hband, show i - 1 - j = 0 by omega]
  · rw [ite_eq_right h]
    by_cases h' : i - 2 = j
    · have hband : i - 4 ≤ j ∧ j < i := by omega
      rw [ite_eq_left h', ite_eq_left hband, show i - 1 - j = 1 by omega]
    · rw [ite_eq_right h']
      by_cases h'' : i - 3 = j
      · have hband : i - 4 ≤ j ∧ j < i := by omega
        rw [ite_eq_left h'', ite_eq_left hband, show i - 1 - j = 2 by omega]
      · rw [ite_eq_right h'']
        by_cases hlast : i - 4 = j
        · have hband : i - 4 ≤ j ∧ j < i := by omega
          rw [ite_eq_left hlast, ite_eq_left hband, show i - 1 - j = 3 by omega]
        · have hband : ¬ (i - 4 ≤ j ∧ j < i) := by omega
          simp only [hlast, hband, ite_false]


/-- The four-bit loop fills its complete nibble region, preserves every other
byte, and leaves precisely the shifted input and the sub-nibble index. -/
theorem binaryLoop4_spec {U : Type} (pattern lowByte : U → Nat)
    (shr : U → Nat → U)
    (hlow : ∀ x, lowByte x % 256 = pattern x % 256)
    (hshift : ∀ x, pattern (shr x 4) = pattern x / 2^4)
    (m r : Nat) (hr : r < 4) (b : Buffer) (x : U)
    (hbuf : 4 * m + r ≤ b.bytes.length) :
    ∃ out y, binLoop4 lowByte shr (m + 1) b x ((4 * m + r : Nat) : Int) = (out, y, (r : Int)) ∧
      out.bytes.length = b.bytes.length ∧
      (∀ j, out.bytes[j]? =
        if r ≤ j ∧ j < 4 * m + r then
          some (binaryCharacter (pattern x) (4 * m + r - 1 - j))
        else b.bytes[j]?) ∧
      (∀ j, (pattern y).testBit j = (pattern x).testBit (j + 4 * m)) := by
  induction m generalizing b x with
  | zero =>
    have hri : (r : Int) < 4 := by omega
    refine ⟨b, x, ?_, rfl, ?_, ?_⟩
    · simp only [Nat.mul_zero, Nat.zero_add, binLoop4, hri, ite_true]
    · intro j
      rw [ite_eq_right (by omega)]
    · intro j
      simp only [Nat.mul_zero, Nat.add_zero]
  | succ m ih =>
    let i := 4 * (m + 1) + r
    let chunk := binaryChunk b i (pattern x)
    have hchunkLen : chunk.bytes.length = b.bytes.length := binaryChunk_length b i (pattern x)
    have hrecBuf : 4 * m + r ≤ chunk.bytes.length := by rw [hchunkLen]; omega
    obtain ⟨out, y, hcall, hlen, hget, hpat⟩ := ih chunk (shr x 4) hrecBuf
    have hstep : binLoop4 lowByte shr (m + 1 + 1) b x i =
        binLoop4 lowByte shr (m + 1) chunk (shr x 4) ((4 * m + r : Nat) : Int) := by
      rw [binLoop4, ite_eq_right (by dsimp only [i]; omega)]
      dsimp only
      simp only [hlow]
      change binLoop4 lowByte shr (m + 1) chunk (shr x 4) ((i : Int) - 4) = _
      rw [show (i : Int) - 4 = (4 * m + r : Nat) by dsimp only [i]; omega]
    refine ⟨out, y, hstep.trans hcall, hlen.trans hchunkLen, ?_, ?_⟩
    · intro j
      rw [hget]
      by_cases hlowj : r ≤ j ∧ j < 4 * m + r
      · have hwhole : r ≤ j ∧ j < 4 * (m + 1) + r := by omega
        rw [ite_eq_left hlowj, ite_eq_left hwhole, hshift, binaryCharacter_shift]
        rw [show 4 * m + r - 1 - j + 4 = 4 * (m + 1) + r - 1 - j by omega]
      · rw [ite_eq_right hlowj]
        have hchunk := binaryChunk_get b i (pattern x) j (by dsimp only [i]; omega) (by exact hbuf)
        change chunk.bytes[j]? = _ at hchunk
        rw [hchunk]
        by_cases hband : r ≤ j ∧ j < 4 * (m + 1) + r
        · have hbandChunk : i - 4 ≤ j ∧ j < i := by dsimp only [i]; omega
          rw [ite_eq_left hbandChunk, ite_eq_left hband]
        · have hbandChunk : ¬ (i - 4 ≤ j ∧ j < i) := by dsimp only [i]; omega
          rw [ite_eq_right hbandChunk, ite_eq_right hband]
    · intro j
      rw [hpat, hshift, Nat.testBit_div_two_pow]
      rw [show j + 4 * m + 4 = j + 4 * (m + 1) by omega]


/-- Exact low-byte truncation of a native integer's two's-complement pattern. -/
theorem binaryNativeLowByte (t : IntTy) (x : JInt t) :
    (JuliaLean.base.int.remT .u8 x).val.toNat % 256 =
      JuliaLean.Proofs.base.int.pattern x % 256 := by
  rw [← JuliaLean.Proofs.base.int.pattern_of_unsigned (by decide)
    (JuliaLean.base.int.remT .u8 x)]
  rw [JuliaLean.Proofs.base.int.pattern_remT_narrow x (by cases t <;> decide)]
  change (JuliaLean.Proofs.base.int.pattern x % 256) % 256 = _
  exact Nat.mod_mod _ _

private theorem binaryNativeShiftFour (t : IntTy) (x : JInt t) :
    JuliaLean.Proofs.base.int.pattern
      (JuliaLean.base.int.lshr_int x (JuliaLean.base.int.lit .i64 4)) =
      JuliaLean.Proofs.base.int.pattern x / 2^4 := by
  rw [JuliaLean.Proofs.base.int.pattern_lshr_int]
