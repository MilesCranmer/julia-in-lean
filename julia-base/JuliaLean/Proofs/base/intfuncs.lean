private theorem countP_range_succ_testBit (w p : Nat) :
    (List.range (w + 1)).countP (fun i => p.testBit i) =
      (if p % 2 = 1 then 1 else 0) + (List.range w).countP (fun i => (p / 2).testBit i) := by
  rw [List.range_succ_eq_map, List.countP_cons, List.countP_map]
