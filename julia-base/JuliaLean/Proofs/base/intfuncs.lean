        by_cases hlarge : 36 < base <;> simp only [hlarge, decide_true, decide_false, ite_true, Bool.false_eq_true, ite_false] <;> omega
      obtain ⟨hc, hchar, _, _⟩ := asciiDigit_table (decide (36 < base)) (o.value x % base).toNat hrsmall
      obtain ⟨q, hq, hqv⟩ := hdiv x hx
