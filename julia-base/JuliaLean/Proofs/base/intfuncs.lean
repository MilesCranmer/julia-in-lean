/-- Extend the existing observation helper with before/after world snapshots.
The actual action is evaluated once. `recordCall` then records that same
already-observed outcome without re-executing the selected callee. -/
def recordStateCall {W E A : Type}
    (event : W → Except JuliaLean.base.io.Error A → W → E)
    (action : JuliaLean.base.io.M W A) : JuliaLean.base.io.M (W × List E) A :=
  fun (world, trace) =>
    match action world with
    | none => none
    | some (.error (error, nextWorld)) =>
        recordCall (event world · nextWorld)
          (fun _ => some (.error (error, nextWorld))) (world, trace)
    | some (.ok (value, nextWorld)) =>
        recordCall (event world · nextWorld)
          (fun _ => some (.ok (value, nextWorld))) (world, trace)

inductive PromotionEvent (W A B P R : Type) where
  | promoted (before : W) (a : A) (b : B)
      (result : Except JuliaLean.base.io.Error P) (after : W)
  | applied (before : W) (iterate : IterateToken) (function : NumberTheoryFunction)
      (promoted : P) (result : Except JuliaLean.base.io.Error R) (after : W)

def observePromotionOps {W A B P R : Type}
    (ops : PromoteApplyOps (JuliaLean.base.io.M W) A B P R) :
    PromoteApplyOps (JuliaLean.base.io.M (W × List (PromotionEvent W A B P R))) A B P R where
  promote a b := recordStateCall (fun before result after =>
    .promoted before a b result after) (ops.promote a b)
  applyIterate iterate function promoted := recordStateCall
    (fun before result after => .applied before iterate function promoted result after)
    (ops.applyIterate iterate function promoted)

def promotionBefore {W A B P R : Type} : PromotionEvent W A B P R → W
  | .promoted before _ _ _ _ => before
  | .applied before _ _ _ _ _ => before

def promotionAfter {W A B P R : Type} : PromotionEvent W A B P R → W
  | .promoted _ _ _ _ after => after
  | .applied _ _ _ _ _ after => after

def promotionError {W A B P R : Type} :
    PromotionEvent W A B P R → Option JuliaLean.base.io.Error
  | .promoted _ _ _ (.error error) _ => some error
  | .applied _ _ _ _ (.error error) _ => some error
  | _ => none

def promotionInputs {W A B P R : Type} (trace : List (PromotionEvent W A B P R)) :
    List (A × B) :=
  trace.filterMap fun event => match event with
    | .promoted _ a b _ _ => some (a, b)
    | _ => none

def promotionOutputs {W A B P R : Type} (trace : List (PromotionEvent W A B P R)) : List P :=
  trace.filterMap fun event => match event with
    | .promoted _ _ _ (.ok value) _ => some value
    | _ => none

def promotionApplicationOutputs {W A B P R : Type}
    (trace : List (PromotionEvent W A B P R)) : List R :=
  trace.filterMap fun event => match event with
    | .applied _ _ _ _ (.ok value) _ => some value
    | _ => none

/-- Call cardinality, reference identity, fixed function identity, and state
conservation. The runtime receives precisely the opaque promoted object; no
pair, tuple, length or iterator law is assumed. All changes to the private
world originate in actual observed callee changes.
Source invariants: base/intfuncs.jl:159-160. -/
def PromotionTraceInvariant {W A B P R : Type} (function : NumberTheoryFunction)
    (a : A) (b : B) (initial final : W) (trace : List (PromotionEvent W A B P R)) : Prop :=
  trace.length ≤ 2 ∧
  promotionInputs trace = [(a, b)] ∧
  trace.head?.map promotionBefore = some initial ∧
  trace.getLast?.map promotionAfter = some final ∧
  (∀ index first second,
    (trace)[index]? = some first → (trace)[index + 1]? = some second →
    promotionAfter first = promotionBefore second) ∧
  (∀ before iterate actualFunction promoted result after,
    PromotionEvent.applied before iterate actualFunction promoted result after ∈ trace →
      iterate = .baseIterate ∧ actualFunction = function ∧
      promotionOutputs trace = [promoted])

def PromotionTerminalInvariant {W A B P R : Type}
    (trace : List (PromotionEvent W A B P R)) : Except JuliaLean.base.io.Error R → Prop
  | .ok value => promotionApplicationOutputs trace = [value] ∧ trace.filterMap promotionError = []
  | .error error => trace.filterMap promotionError = [error] ∧
      ∃ event, trace.getLast? = some event ∧ promotionError event = some error

def PromotionObservation {W A B P R : Type} (function : NumberTheoryFunction)
    (a : A) (b : B) (initial : W)
    (action : JuliaLean.base.io.M (W × List (PromotionEvent W A B P R)) R) : Prop :=
  match action (initial, []) with
  | none => True
  | some (.ok (value, (final, trace))) =>
      PromotionTraceInvariant function a b initial final trace ∧
      PromotionTerminalInvariant trace (.ok value)
  | some (.error (error, (final, trace))) =>
      PromotionTraceInvariant function a b initial final trace ∧
      PromotionTerminalInvariant trace (.error error)

/-- Universal observation invariants for both Real wrappers. Every value and
