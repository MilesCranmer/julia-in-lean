private theorem ndigitsZeroBits_zero_eq (c : DigitCallees) (hquot : QuotientLaws c)
    (t b : IntTy) (base : JInt b) (hvalid : base.val < -1 ∨ base.val > 1) :
    ndigitsZeroBits c (JuliaLean.base.int.lit t 0) base = .ok (JuliaLean.base.int.lit .i64 0) := by
  have h0 : (JuliaLean.base.int.lit t 0).val = 0 := by cases t <;> decide
  unfold ndigitsZeroBits ndigitsZero
  rcases hvalid with hneg | hpos
  · rw [if_pos hneg]
    unfold ndigitsNegativeBits ndigitsNegative
    dsimp only
    by_cases hu : (!t.signed) = true
    · rw [if_pos hu, h0, if_pos rfl]
      have hnb_ne0 : (JuliaLean.base.int.neg base).val ≠ 0 := by
        rw [JuliaLean.base.int.neg, JuliaLean.Proofs.base.int.neg_int_val]
        have hb := base.property
        cases b <;> simp_all [IntTy.signed, IntTy.min, IntTy.max, IntTy.bits, wrapInt] <;> omega
      have hnotmin : ¬ (t.signed = true ∧ (0 : Int) = t.min ∧ (JuliaLean.base.int.neg base).val = -1) := by
        intro ⟨hs, _⟩; simp [hs] at hu
      have hq := hquot t b false true 0 (JuliaLean.base.int.neg base).val
        (by rw [← h0]; exact (JuliaLean.base.int.lit t 0).property)
        (JuliaLean.base.int.neg base).property hnb_ne0 hnotmin
      have h0fdiv : (0 : Int).fdiv (JuliaLean.base.int.neg base).val = 0 := Int.zero_fdiv _
      have hwrap0 : wrapInt (quotientType t b) 0 = 0 := by cases quotientType t b <;> decide
      have hsigned0 : (JuliaLean.base.int.signed (JuliaLean.base.int.lit t 0)).val = 0 := by
        rw [JuliaLean.Proofs.base.int.signed_val, h0]
        cases t <;> decide
      rw [hq, if_neg Bool.noConfusion, if_pos rfl, h0fdiv, hwrap0]
      dsimp only [Except.map]
      rw [ok_bind, pure_bind, hsigned0]
      rfl
    · rw [if_neg hu, pure_bind, h0]
      rfl
  · have hnotneg : ¬ base.val < -1 := by omega
    rw [if_neg hnotneg, if_pos hpos]
    unfold ndigitsPositiveBits ndigitsPositive
    rw [if_pos h0]
    rfl

