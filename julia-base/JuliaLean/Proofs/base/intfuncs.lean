      trace.filterMap gcdArrayEventError = [] ∧ trace.length = 3
  | .error error =>
      trace.filterMap gcdArrayEventError = [error] ∧
      gcdArrayReductionOutputs trace = [] ∧
      ∃ event, trace.getLast? = some event ∧ gcdArrayEventError event = some error

