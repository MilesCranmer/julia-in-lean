  have hu : (n.natAbs : Int) < (2 : Int) ^ (n.natAbs.log2 + 1) := by
    exact_mod_cast (Nat.lt_log2_self (n := n.natAbs))
  have hl : (2 : Int) ^ n.natAbs.log2 ≤ (n.natAbs : Int) := by
    exact_mod_cast (Nat.log2_self_le (show n.natAbs ≠ 0 by omega))
