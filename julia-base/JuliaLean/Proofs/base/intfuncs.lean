theorem decimalEstimateFacts : ∀ r : Fin 65,
    let e := 1233 * r.val / 4096 + 1
    1 ≤ e ∧ e ≤ 20 ∧ (10 : Int) ^ (e - 2) ≤ 2 ^ (r.val - 1) ∧
      (2 : Int) ^ r.val ≤ 10 ^ e := by decide

theorem decimalDigitCountPositive (z : Int) (k : Nat) (hz : 0 < z) (hk : 1 ≤ k)
    (hlo : (10 : Int) ^ (k - 1) ≤ z) (hhi : z < (10 : Int) ^ k) :
    DigitCount z 10 0 (k : Int) := by
  unfold DigitCount
  refine ⟨by omega, by omega, ?_⟩
  rw [ite_eq_left (by decide)]
  have habs : (z.natAbs : Int) = z := Int.natAbs_of_nonneg (by omega)
  refine ⟨by omega, fun _ => ⟨by omega, ?_, fun _ => ?_⟩⟩
  · simpa only [Int.toNat_natCast, habs] using hhi
  · simpa only [Int.toNat_natCast, habs] using hlo

theorem smallI64Literal (k : Nat) (hk : k ≤ 20) :
    (JuliaLean.base.int.lit .i64 (k : Int)).val = (k : Int) := by
  exact wrapInt_of_inRange .i64 (k : Int) (by
    change -9223372036854775808 ≤ (k : Int) ∧ (k : Int) ≤ 9223372036854775807
    omega)

theorem decimalApprox_spec (r : Nat) (hr : r ≤ 64) (z : Int) (hz : 0 ≤ z)
    (hhi : z < (2 : Int) ^ r) (hlo : 0 < r → (2 : Int) ^ (r - 1) ≤ z) :
    ∃ count, decimalApprox r z = .ok count ∧ DigitCount z 10 0 count.val ∧ count.val ≤ 20 := by
  by_cases hr0 : r = 0
  · subst r
    have hz0 : z = 0 := by change z < 1 at hhi; omega
    subst z
    refine ⟨JuliaLean.base.int.lit .i64 0, rfl, ?_, by decide⟩
    change DigitCount 0 10 0 0
    unfold DigitCount
    rw [ite_eq_left (by decide)]
    decide
  have hrpos : 0 < r := by omega
  let e := 1233 * r / 4096 + 1
  have hf := decimalEstimateFacts ⟨r, by omega⟩
  change 1 ≤ e ∧ e ≤ 20 ∧ (10 : Int) ^ (e - 2) ≤ 2 ^ (r - 1) ∧
    (2 : Int) ^ r ≤ 10 ^ e at hf
  have hlo' := hlo hrpos
  have hp : (0 : Int) < 2 ^ (r - 1) := Int.pow_pos (by decide)
  have hzpos : 0 < z := by omega
  unfold decimalApprox
  change ∃ count, Except.ok (JuliaLean.base.int.lit .i64
    ((e : Int) - if z < 10 ^ (e - 1) then 1 else 0)) = .ok count ∧ _
  by_cases hlt : z < (10 : Int) ^ (e - 1)
  · rw [ite_eq_left hlt]
    have he : 2 ≤ e := by
      by_cases h : 2 ≤ e
      · exact h
      · have he1 : e = 1 := by omega
        rw [he1] at hlt
        change z < 1 at hlt
        omega
    have hcast : (e : Int) - 1 = ((e - 1 : Nat) : Int) := by omega
    rw [hcast]
    refine ⟨JuliaLean.base.int.lit .i64 (e - 1 : Nat), rfl, ?_⟩
    rw [smallI64Literal (e - 1) (by omega)]
    constructor
    · apply decimalDigitCountPositive z (e - 1) hzpos (by omega)
      · have hexp : e - 1 - 1 = e - 2 := by omega
        rw [hexp]
        omega
      · exact hlt
    · omega
  · rw [ite_eq_right hlt, Int.sub_zero]
    refine ⟨JuliaLean.base.int.lit .i64 e, rfl, ?_⟩
    rw [smallI64Literal e hf.2.1]
    constructor
    · apply decimalDigitCountPositive z e hzpos hf.1
      · omega
      · omega
    · omega


theorem bitNdigits64_spec (t : IntTy) (x : JInt t) (hu : t.signed = false)
    (hw : t.bits ≤ 64) :
    ∃ count, bitNdigits64 x hu hw = .ok count ∧ DigitCount x.val 10 0 count.val ∧
      count.val ≤ 20 := by
  have htop := JuliaLean.Proofs.base.int.topSetBit_proven t x
  have hpattern := JuliaLean.Proofs.base.int.val_of_unsigned_pattern hu x
  have hx0 := JuliaLean.Proofs.base.int.nonneg_of_unsigned hu x
  have hcast : ((topBit x : Nat) : Int) = (JuliaLean.base.int.top_set_bit x).val :=
    Int.toNat_of_nonneg htop.1
  have hr : topBit x ≤ 64 := by omega
  have hhi : x.val < (2 : Int) ^ topBit x := by
    unfold topBit
    have h := Int.ofNat_lt.mpr htop.2.2.1
    simpa only [Int.natCast_pow, Int.ofNat_two, hpattern] using h
  have hlo : 0 < topBit x → (2 : Int) ^ (topBit x - 1) ≤ x.val := by
    intro hp
    have hp' : 0 < (JuliaLean.base.int.top_set_bit x).val := by omega
    unfold topBit
    have h := Int.ofNat_le.mpr (htop.2.2.2 hp')
    simpa only [Int.natCast_pow, Int.ofNat_two, hpattern] using h
  have heq : bitNdigits64 x hu hw = rawDecimalApprox (topBit x) x.val := by
    unfold bitNdigits64 rawDecimalApprox
    dsimp only
    generalize (topBit x) = r
    generalize JuliaLean.base.int.add (JuliaLean.base.int.ashr_int
      (JuliaLean.base.int.mul (JuliaLean.base.int.lit .i64 1233)
        (JuliaLean.base.int.lit .i64 r)) (JuliaLean.base.int.lit .i64 12))
      (JuliaLean.base.int.lit .i64 1) = nd
    by_cases h : nd.val < 1
    · simp only [h, ite_true]
    · simp only [h, ite_false]
      cases powersOfTen[(nd.val - 1).toNat]? <;> rfl
  rw [heq, rawDecimalApprox_eq _ hr]
  exact decimalApprox_spec _ hr _ hx0 hhi hlo


theorem decimalShiftCount (n q c : Int) (hn : 0 < n) (hq : 0 < q)
    (hdiv : q = n / 10000000000000000000) (hcount : DigitCount q 10 0 c) :
    DigitCount n 10 0 (c + 19) := by
  rcases hcount with ⟨hc0, _, hc⟩
  rw [ite_eq_left (by decide)] at hc
  obtain ⟨hc1, hhi, hlo⟩ := hc.2 (by omega)
  have habs : (q.natAbs : Int) = q := Int.natAbs_of_nonneg (by omega)
  rw [habs] at hhi hlo
  have hclo := hlo (by omega)
  have hcast : ((c.toNat + 19 : Nat) : Int) = c + 19 := by omega
  rw [← hcast]
  apply decimalDigitCountPositive n (c.toNat + 19) hn (by omega)
  · have he : c.toNat + 19 - 1 = (c.toNat - 1) + 19 := by omega
    rw [he, Int.pow_add]
    change (10 : Int) ^ (c.toNat - 1) * 10000000000000000000 ≤ n
    rw [hdiv] at hclo
    exact Int.mul_le_of_le_ediv (by decide) hclo
  · rw [Int.pow_add]
    change n < (10 : Int) ^ c.toNat * 10000000000000000000
    rw [hdiv] at hhi
    exact Int.lt_mul_of_ediv_lt (by decide) hhi

theorem decimalFoldFixed {S A : Type} (step : S → Jl S) (s : S) (h : step s = .ok s) :
    ∀ xs : List A, xs.foldlM (fun s _ => step s) s = .ok s
  | [] => rfl
  | _ :: xs => by
      rw [List.foldlM_cons, h]
      exact decimalFoldFixed step s h xs

theorem decimalRepeatFixed {S : Type} (step : S → Jl S) (s : S) (h : step s = .ok s) (k : Nat) :
    repeatM k step s = .ok s := decimalFoldFixed step s h _

theorem decimalRepeatSucc {S : Type} (step : S → Jl S) (s : S) (k : Nat) :
    repeatM (k + 1) step s = (step s).bind (repeatM k step) := by
  unfold JuliaLean.base.intfuncs.repeatM
  rw [List.range_succ_eq_map, List.foldlM_cons]
  simp only [List.foldlM_map]
  rfl

def decimal128Step (s : JInt .u128 × JInt64) : Jl (JInt .u128 × JInt64) := do
  if s.1.val > 10000000000000000000 then
    pure (← JuliaLean.base.int.divSame s.1 (JuliaLean.base.int.lit .u128 10000000000000000000),
      JuliaLean.base.int.add s.2 (JuliaLean.base.int.lit .i64 19))
  else pure s

theorem decimal128Divide (x : JInt .u128) :
    JuliaLean.base.int.divSame x (JuliaLean.base.int.lit .u128 10000000000000000000) =
      .ok (JuliaLean.base.int.lit .u128 (x.val / 10000000000000000000)) := by
  rw [JuliaLean.Proofs.base.int.divSame_eq]
  have hz : (JuliaLean.base.int.lit .u128 10000000000000000000).val = 10000000000000000000 := by decide
  rw [hz, ite_eq_right (by simp [IntTy.signed])]
  rw [Int.tdiv_eq_ediv_of_nonneg x.property.1]

theorem decimal128QuotientVal (x : JInt .u128) :
    (JuliaLean.base.int.lit .u128 (x.val / 10000000000000000000)).val =
      x.val / 10000000000000000000 := by
  have hx := x.property
  change 0 ≤ x.val ∧ x.val ≤ 340282366920938463463374607431768211455 at hx
  exact wrapInt_of_inRange .u128 _ (by
    change 0 ≤ x.val / 10000000000000000000 ∧
      x.val / 10000000000000000000 ≤ 340282366920938463463374607431768211455
    omega)

theorem decimal128SmallCount (x : JInt .u128) (hx : x.val ≤ 10000000000000000000) :
    ∃ c, bitNdigits64 (JuliaLean.base.int.remT .u64 x) (by decide) (by decide) = .ok c ∧
      DigitCount x.val 10 0 c.val ∧ c.val ≤ 20 := by
  have hv : (JuliaLean.base.int.remT .u64 x).val = x.val := by
    rw [JuliaLean.Proofs.base.int.remT_val]
    apply wrapInt_of_inRange .u64
    change 0 ≤ x.val ∧ x.val ≤ 18446744073709551615
    have h0 := x.property.1
    change 0 ≤ x.val at h0
    omega
  obtain ⟨c, hcall, hcount, hbound⟩ := bitNdigits64_spec .u64
    (JuliaLean.base.int.remT .u64 x) (by decide) (by decide)
  exact ⟨c, hcall, by simpa only [hv] using hcount, hbound⟩

theorem addSmallDecimalCount (k : Int) (hk : 0 ≤ k ∧ k ≤ 38) (c : JInt64)
