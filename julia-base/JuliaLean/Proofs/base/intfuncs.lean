def weights {R : Type} (val : R → Int) (xs us : List R) : Int :=
  (xs.zip us).foldl (fun z pair => z + val pair.1 * val pair.2) 0

theorem fold_weights_add {R : Type} (val : R → Int) (pairs : List (R × R)) (z : Int) :
    pairs.foldl (fun z pair => z + val pair.1 * val pair.2) z =
      z + pairs.foldl (fun z pair => z + val pair.1 * val pair.2) 0 := by
  induction pairs generalizing z with
  | nil => simp only [List.foldl_nil, Int.add_zero]
  | cons p ps ih =>
    simp only [List.foldl_cons, Int.zero_add]
    rw [ih, ih (val p.1 * val p.2), Int.add_assoc]

theorem weights_cons {R : Type} (val : R → Int) (a u : R) (xs us : List R) :
    weights val (a :: xs) (u :: us) = val a * val u + weights val xs us := by
  simp only [weights, List.zip_cons_cons, List.foldl_cons, Int.zero_add]
  exact fold_weights_add val (xs.zip us) (val a * val u)

theorem weights_nil {R : Type} (val : R → Int) : weights val [] [] = 0 := rfl

theorem combine_mod (M A B I J D X IX JX tail out : Int)
    (hI : M ∣ IX - I * X) (hJ : M ∣ JX - J * X)
    (hp : M ∣ A * I + B * J - D)
    (hn : M ∣ D * X + tail - out) :
    M ∣ A * IX + B * JX + tail - out := by
  have key : A * IX + B * JX + tail - out =
      A * (IX - I * X) + B * (JX - J * X) +
      (A * I + B * J - D) * X + (D * X + tail - out) := by
    simp only [Int.mul_sub, Int.sub_mul, Int.add_mul, Int.mul_assoc]
    omega
  rw [key]
  exact Int.dvd_add (Int.dvd_add (Int.dvd_add
    (Int.dvd_trans hI (Int.dvd_mul_left A _))
    (Int.dvd_trans hJ (Int.dvd_mul_left B _)))
    (Int.dvd_trans hp (Int.dvd_mul_right _ X))) hn

def prefixGood {R : Type} (P : Int → Prop) (val : R → Int) (a b : R) (cs : List R) : Prop :=
