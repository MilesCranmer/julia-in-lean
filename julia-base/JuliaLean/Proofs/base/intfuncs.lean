private def finalizeEntry (existing : Entry) : Entry :=
  match revisedEntries.find? (fun candidate => candidate.id == existing.id) with
  | some replacement => replacement
  | none =>
    if approvedIds.contains existing.id then existing
    else { existing with status := .todo, thm := none, issue := "", notes := "" }

def entries : List Entry :=
  let installed := originalEntries.map finalizeEntry
  let additions := revisedEntries.filter (fun candidate =>
    !(originalEntries.any (fun existing => existing.id == candidate.id)))
  installed ++ additions

end JuliaLean.Proofs.base.intfuncs



