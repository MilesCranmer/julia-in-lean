    if n.val < 0 ∧ effectivePad = IntTy.max .i64 then inexactError (stringBits digitCallees n base pad)
    else ∃ s, stringBits digitCallees n base pad = .ok s ∧
      StringRepresentation n.val base.val effectivePad s.bytes) ∧
  (∀ decimal (n base pad : Int), BigIntRepresentable n → 2 ≤ base → base ≤ 62 →
    let effectivePad := min (max pad (IntTy.min .i64)) (IntTy.max .i64)
    if n < 0 ∧ effectivePad = IntTy.max .i64 then
