-- /Source
def lineContains (x : CI) (r : CartesianStepRange64) : RegionResult Bool := do
  if ← CartesianLine.isEmpty r then return false
  let f ← CartesianLine.first r
  let st := step_StepRangeLen r
  let l ← CartesianLine.last r
  for k in List.range x.length do
    let i := JuliaLean.base.int.add (int k) (int 1)
    let si ← CartesianLine.coordinateAt st i
    if !JuliaLean.base.int.eqSame si (int 0) then
      let xi ← CartesianLine.coordinateAt x i
      let fi ← CartesianLine.coordinateAt f i
      let si ← CartesianLine.coordinateAt st i
      let li ← CartesianLine.coordinateAt l i
      let scalarRange ← RangeDependencies.makeStep fi si li
      let n ← CartesianLine.scalarFindFirst xi scalarRange
      match n with
      | none => return false
      | some n => return cartesianEq (← CartesianLine.indexAt r n) x
  return cartesianEq x f


end CartesianLineClosure

