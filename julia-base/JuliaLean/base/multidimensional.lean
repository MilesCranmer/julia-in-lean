def storeInbounds (reference : Nat × I64) (value : CI) : StoredM Unit := do
  let heap ← get
  match heap[reference.1]? with
  | none => throw (.inr .inboundsViolation)
  | some slots =>
    if 1 ≤ reference.2.val ∧ reference.2.val ≤ (slots.length : Int) then
      liftArray (JuliaLean.base.array.heapSet reference.1 value reference.2)
    else throw (.inr .inboundsViolation)

