  | .inl s :: rest => indexSizesScalar (fun _ => indexSizesDispatch sizeOf rest) s rest
  | .inr a :: rest => indexSizesArray sizeOf (fun _ => indexSizesDispatch sizeOf rest) a rest

def intFld (x y : I64) : Jl I64 :=
