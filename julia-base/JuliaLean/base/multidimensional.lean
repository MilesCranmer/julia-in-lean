namespace JuliaLean.HashOps

open JuliaLean

/-! ## Abstract arrays, `base/multidimensional.jl:1995-2123` -/

structure CanonArray where
  axes : List (Int × Int)
  values : List Nat
  deriving DecidableEq, Repr

def arrayInitial (a : CanonArray) (h : Nat) : Nat :=
  let h := hashNatList (a.axes.map (fun x => x.1.natAbs)) (Nat.xor h 0x7e2d6fb6448beb77)
  hashNatList (a.axes.map (fun x => x.2.natAbs)) h

def setStream (p : List Nat) (i value : Nat) : List Nat := p.set i value

def mediumStreams (xs : List Nat) (h : Nat) : List Nat :=
  (List.range xs.length).foldl (fun p i =>
    let j := i % 8
    setStream p j (mixNat (xs.getD i 0) (p.getD j h))) (List.replicate 8 h)

def foldStreams (p : List Nat) (h : Nat) : Nat := finalNat (p.foldl (fun h x => mixNat x h) h)

def findPrevDifferent (xs : List Nat) (i value : Nat) : Option Nat :=
  (List.range (i + 1)).reverse.find? (fun j => xs.getD j value != value)

/-- The Fibonacci sampler works backwards, increases the skip every 4096
samples, and after each skip finds the previous value distinct from the last
hashed element (`base/multidimensional.jl:2026-2054`). -/
def fibSamples (xs : List Nat) : Nat → Nat → Nat → Nat → Nat → List (Nat × Nat)
  | 0, _, _, _, _ => []
  | fuel + 1, i, skip, prev, n =>
      match xs[i]? with
      | none => []
      | some value =>
          let sample := (i, value)
          if i < skip then [sample]
          else
            let candidate := i - skip
            let n' := n + 1
            let (skip', prev') := if n' % 4096 = 0 then (skip + prev, skip) else (skip, prev)
            match findPrevDifferent xs candidate value with
            | none => [sample]
            | some j => sample :: fibSamples xs fuel j skip' prev' n'

def longStreams (xs : List Nat) (h : Nat) : List Nat :=
  let samples := if xs.isEmpty then [] else fibSamples xs xs.length (xs.length - 1) 1 1 0
  (List.range samples.length).foldl (fun p i =>
    let sample := samples.getD i (0, 0)
    let j := i % 4
    let old := p.getD j h
    setStream p j (mixNat (mixNat sample.1 old) (mixNat sample.2 old))) (List.replicate 4 h)

/-- `hash_shaped`, including its short, eight-stream, and Fibonacci branches. -/
def hashArray (a : CanonArray) (h : Nat) : Nat :=
  let h := arrayInitial a h
  if a.values.length < 8 then hashNatList a.values h
  else if a.values.length < 32768 then foldStreams (mediumStreams a.values h) h
  else foldStreams (longStreams a.values h) h

end JuliaLean.HashOps

namespace JuliaLean.BroadcastViews

open JuliaLean

/-- An element of an index: an `Int` or a `CartesianIndex` with the given subscripts. -/
inductive Elem where
  | int (i : Int)
  | cart (is : List Int)
  deriving DecidableEq, Repr

/-- `x == y` between index elements. `CartesianIndex == Int` has no method of its own and falls
back to `===`, which is false. -/
def Elem.eqb : Elem → Elem → Bool
  | .int a, .int b => a == b
  | .cart a, .cart b => a == b
  | _, _ => false

/-- A parent index of a `SubArray`. -/
inductive Idx where
  /-- An `Int` (`Real` scalar index). -/
  | scalar (i : Int)
  /-- An `AbstractUnitRange{Int}` `lo:hi` (`UnitRange`, `OneTo`, `Slice(OneTo(n))`). -/
  | urange (lo hi : Int)
  /-- A non-unit `StepRange{Int,Int}` with `len` elements. -/
  | srange (start step : Int) (len : Nat)
  /-- A `Vector{Int}`. -/
  | ints (xs : List Int)
  /-- A `Vector{CartesianIndex{n}}` (each element has `n` subscripts). -/
  | carts (n : Nat) (xs : List (List Int))
  deriving DecidableEq, Repr

/-- The elements of an index, in order. -/
def Idx.elems : Idx → List Elem
  | .scalar i => [.int i]
  | .urange lo hi => ((List.range (hi - lo + 1).toNat).map (fun k : Nat => lo + (k : Int))).map .int
  | .srange a s n => ((List.range n).map (fun k : Nat => a + (k : Int) * s)).map .int
  | .ints xs => xs.map .int
  | .carts _ xs => xs.map .cart

/-- `x in A` for an index array `A`: `any(y -> y == x, A)` (the range methods of `in` agree on
`Int`s; a `CartesianIndex` is never `==` to a range element). -/
def inIdx (x : Elem) (A : Idx) : Bool := A.elems.any (fun y => y.eqb x)

/-- `_indicesmightoverlap(A, B)` on the parent index tuples of two views of the same parent,
`base/multidimensional.jl:1158-1188`, with Julia's method specificity:
unit range × unit range (1166), range × range (1162), `Real` × `Real` (1170), `Real` × array (1172),
array × `Real` (1174), array × array (1177), anything else `true` (1188). An index tuple that
runs out before the other throws `error("malformed subarray")` (1159-1160). -/
def indicesMightOverlap : List Idx → List Idx → R Bool
  | [], [] => .ok true
  | [], _ :: _ => .error .argumentError
  | _ :: _, [] => .error .argumentError
  | a :: as, b :: bs =>
    let next := indicesMightOverlap as bs
    match a, b with
    | .urange alo ahi, .urange blo bhi => if max alo blo ≤ min ahi bhi then next else .ok false
    | .urange _ _, .srange _ _ _ | .srange _ _ _, .urange _ _ | .srange _ _ _, .srange _ _ _ =>
      if a.elems.any (fun x => inIdx x b) then next else .ok false
    | .scalar x, .scalar y => if x = y then next else .ok false
    | .scalar x, _ => if inIdx (.int x) b then next else .ok false
    | _, .scalar y => if inIdx (.int y) a then next else .ok false
    | _, _ =>
      match a.elems, b.elems with
      | [x], _ => if inIdx x b then next else .ok false
      | _, [y] => if inIdx y a then next else .ok false
      | _, _ => .ok true

/-- The parent subscripts an index contributes per selected element. -/
def Idx.subs : Idx → List (List Int)
  | .carts _ xs => xs
  | i => i.elems.filterMap (fun | .int k => some [k] | .cart _ => none)

/-- The parent subscript tuples selected by a view's index tuple, in the view's column-major
element order (first index varies fastest). -/
def positions : List Idx → List (List Int)
  | [] => [[]]
  | i :: is => (positions is).flatMap (fun q => i.subs.map (fun p => p ++ q))

/-- Column-major linear index (0-based) of 1-based subscripts in a parent of size `dims`. -/
def linIdx : List Nat → List Int → Nat
  | n :: ns, i :: is => (i - 1).toNat + n * linIdx ns is
  | _, _ => 0

/-- `Base.mightalias(A::SubArray, B::SubArray)` for two nonempty views whose parents are the same
array, `base/multidimensional.jl:1130-1144`, as used by `unalias(dest, A)`
(`base/abstractarray.jl:1566`, 1603: empty arrays never alias). -/
def mightaliasSame (I J : List Idx) : R Bool :=
  if (positions I).isEmpty || (positions J).isEmpty then .ok false else indicesMightOverlap I J

end JuliaLean.BroadcastViews

namespace JuliaLean.Multidim

open JuliaLean

/-- `__inc(state, indices)`, `base/multidimensional.jl:468-483`. The one-dimensional
method adds with `+%`, the multidimensional one with `+`; both wrap. -/
def inc : List I64 → List Rng → Bool × List I64
  | [], [] => (false, [])
  | [s], [r] => (decide (s ≠ r.last), [s + r.step])
  | s :: s' :: ss, r :: r' :: rs =>
    if s ≠ r.last then (true, (s + r.step) :: s' :: ss)
    else
      let p := inc (s' :: ss) (r' :: rs)
      (p.1, r.start :: p.2)
  | _, _ => (false, [])

/-- `iterate(iter::CartesianIndices)`, `base/multidimensional.jl:445-451` (and the
0-dimensional special case, line 486, which this reproduces for `R = []`). -/
def iterFirst (R : List Rng) : Option (List I64) :=
  if R.all (fun r => r.contains r.start) then some (R.map (·.start)) else none

/-- `iterate(iter::CartesianIndices, state)`, `base/multidimensional.jl:452-456`. -/
def iterNext (R : List Rng) (s : List I64) : Option (List I64) :=
  let p := inc s R
  if p.1 then some p.2 else none

/-- `__dec(state, indices)`, `base/multidimensional.jl:592-607`. -/
def dec : List I64 → List Rng → Bool × List I64
  | [], [] => (false, [])
  | [s], [r] => (decide (s ≠ r.start), [s - r.step])
  | s :: s' :: ss, r :: r' :: rs =>
    if s ≠ r.start then (true, (s - r.step) :: s' :: ss)
    else
      let p := dec (s' :: ss) (r' :: rs)
      (p.1, r.last :: p.2)
  | _, _ => (false, [])

/-- `iterate(r::Reverse{<:CartesianIndices})`, `base/multidimensional.jl:572-578`. -/
def revFirst (R : List Rng) : Option (List I64) :=
  if R.all (fun r => r.contains r.last) then some (R.map (·.last)) else none

/-- `iterate(r::Reverse{<:CartesianIndices}, state)`, `base/multidimensional.jl:579-583`. -/
def revNext (R : List Rng) (s : List I64) : Option (List I64) :=
  let p := dec s R
  if p.1 then some p.2 else none

/-- `==(a::CartesianIndices{N}, b::CartesianIndices{N})`,
`base/multidimensional.jl:382-383`: componentwise range equality, where integer
ranges are equal iff they have the same elements. -/
def ciEq (R S : List Rng) : Bool :=
  R.length == S.length && (R.zip S).all fun (r, s) => r.elems == s.elems

/-- `isless(I1::CartesianIndex, I2::CartesianIndex) = isless(reverse(I1.I), reverse(I2.I))`,
`base/multidimensional.jl:142`. -/
def ciLess (a b : List I64) : Bool := tupleLess a.reverse b.reverse

/-! ## `reverse(::CartesianIndices; dims)` -/

/-- Validity check of `_reverse(iter::CartesianIndices, dims::Tuple)`,
`base/multidimensional.jl:558-562`: `dimrev[i] = sum(==(i), dims) == 1` and
`length(dims) == sum(dimrev)`, else `ArgumentError`. -/
def reverseDimsOk (N : Nat) (dims : List Int) : Bool :=
  let dimrev := (List.range N).map fun (i : Nat) => decide (dims.count ((i : Int) + 1) = 1)
  dims.length == dimrev.count true

/-- `copyto!(dest, Rdest::CartesianIndices, src, Rsrc::CartesianIndices)`,
`base/multidimensional.jl:1190-1216`, on arrays with axes `axd`, `axs`. -/
def copytoCI {α : Type} (axd : List (Int × Int)) (dest : List Int → Option α) (Rd : List Rng)
    (axs : List (Int × Int)) (src : List Int → α) (Rs : List Rng) : R (List Int → Option α) :=
  if Rd.any (·.len == 0) then .ok dest                                -- isempty(Rdest)
  else if Rd.map (·.len) ≠ Rs.map (·.len) then .error .argumentError  -- size check
  else if !(inAxes axd (Rd.map (·.start.val)) && inAxes axd (Rd.map (·.last.val)) &&
            inAxes axs (Rs.map (·.start.val)) && inAxes axs (Rs.map (·.last.val)))
  then .error .boundsError
  else .ok fun J =>
    match (Rd.zip J).mapM (fun (r, j) => r.pos j) with
    | some ks => if J.length = Rd.length then some (src ((Rs.zip ks).map fun (r, k) => r.elem k))
                 else dest J
    | none => dest J

/-- The `copyto!` blocks of `_circshift!`, `base/multidimensional.jl:1284-1299`, for the
axes `1:n` of each dimension, in call order (destination block, source block). The
shift amounts are exact integers: `mod(d, n)` of any `Integer` by a positive `Int` is
exact and lies in `[0, n)`, so the sums `first(ind1) + s` and `last(ind1) - s` do not
wrap. -/
def circBlocks : List Nat → List Int → List (List (Int × Int) × List (Int × Int))
  | n :: ns, d :: ds =>
    let s := d % (n : Int)
    let sf := 1 + s
    let sl := (n : Int) - s
    let r1 := ((1 : Int), sf - 1)
    let r2 := (sf, (n : Int))
    let r3 := ((1 : Int), sl)
    let r4 := (sl + 1, (n : Int))
    let rest := circBlocks ns ds
    rest.map (fun b => (r1 :: b.1, r4 :: b.2)) ++ rest.map (fun b => (r2 :: b.1, r3 :: b.2))
  | _, _ => [([], [])]

/-- Run the `copyto!` calls of a block list. -/
def runBlocks {α : Type} (axd axs : List (Int × Int)) (src : List Int → α) :
    List (List (Int × Int) × List (Int × Int)) → (List Int → Option α) → R (List Int → Option α)
  | [], dest => .ok dest
  | (bd, bs) :: rest, dest => do
    let dest' ← copytoCI axd dest (bd.map fun p => unitRng p.1 p.2) axs src
      (bs.map fun p => unitRng p.1 p.2)
    runBlocks axd axs src rest dest'

/-- The `copyto!` blocks of `_circcopy!`, `base/multidimensional.jl:1349-1366`, for
destination and source axes `indd`, `inds` of equal lengths. `mod(_, 0)` is a
`DivideError`. -/
def circcopyBlocks : List (Int × Int) → List (Int × Int) →
    R (List (List (Int × Int) × List (Int × Int)))
  | (fd, ld) :: tds, (fs, ls) :: tss => do
    let l := ld - fd + 1
    if l = 0 then throw .divideError
    let s := (fs - fd) % l
    let sdf := fd + s
    let rd1 := (fd, sdf - 1)
    let rd2 := (sdf, ld)
    let ssf := ls - s
    let rs1 := (fs, ssf)
    let rs2 := (ssf + 1, ls)
    let rest ← circcopyBlocks tds tss
    pure (rest.map (fun b => (rd1 :: b.1, rs2 :: b.2)) ++ rest.map (fun b => (rd2 :: b.1, rs1 :: b.2)))
  | _, _ => pure [([], [])]

/-- `circcopy!(dest, src)`, `base/multidimensional.jl:1337-1346`, for arrays with
nonempty-or-empty axes `axd`, `axs` (`lo:hi`, `hi = lo - 1` when empty). -/
def circcopy {α : Type} (axd : List (Int × Int)) (dest : List Int → Option α)
    (axs : List (Int × Int)) (src : List Int → α) : R (List Int → Option α) := do
  if axs.map (fun p => p.2 - p.1 + 1) ≠ axd.map (fun p => p.2 - p.1 + 1) then
    throw .dimensionMismatch
  if (axs.zip axd).all (fun (s, d) => s.1 - d.1 = 0) then
    -- copyto!(dest, src): same sizes, so it copies elementwise in iteration order
    return fun J => if inAxes axd J then
      some (src ((J.zip (axs.zip axd)).map fun (j, s, d) => j - d.1 + s.1)) else dest J
  let blocks ← circcopyBlocks axd axs
  runBlocks axd axs src blocks dest

/-- `diff(a::AbstractArray; dims)`, `base/multidimensional.jl:1113-1122`: size of
`view(a, r1...) .- view(a, r0...)`, where `r0 = UnitRange(1, n-1)` and
`r1 = UnitRange(2, n)` along `dims`; broadcasting views of different sizes throws
`DimensionMismatch`. -/
def diffSize (sz : List Nat) (dims : Int) : R (List Nat) := do
  if ¬ (1 ≤ dims ∧ dims ≤ sz.length) then throw .argumentError
  let r0 := (List.range sz.length).map fun (i : Nat) =>
    if (i : Int) + 1 = dims then ((sz.getD i 0 : Int) - 1 - 1 + 1).toNat else sz.getD i 0
  let r1 := (List.range sz.length).map fun (i : Nat) =>
    if (i : Int) + 1 = dims then ((sz.getD i 0 : Int) - 2 + 1).toNat else sz.getD i 0
  if r0 ≠ r1 then throw .dimensionMismatch
  pure r1

end JuliaLean.Multidim

namespace JuliaLean.AbstractArrays

open JuliaLean

/-- Logical-mask bounds checks, `base/multidimensional.jl:905-920`. An
N-dimensional mask must have exactly the consumed axes. -/
def checkMask (axes maskAxes : List Axis) : Bool := axes == maskAxes

namespace GVec

/-- `isassigned`, `base/multidimensional.jl:1637-1660`: convert the scalar,
return false for bounds or unassigned slots, and propagate invalid-index
errors. -/
def isAssigned (v : GVec α) (i : ScalarIndex) : Jl Bool := do
  let i ← i.toIndex
  if !v.axis.contains i then return false
  return (v.slots.getD (i.val - v.first.val).toNat none).isSome

end GVec

