def permutationValid (perm : CI) : Bool :=
  decide (perm.map (fun x => x.val.toNat) |>.Perm ((List.range perm.length).map (· + 1)))

def CellArray.strides (first : I64) : CI → CI
  | [] => []
  | n :: ns => first :: CellArray.strides (first * n) ns

