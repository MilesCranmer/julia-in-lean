def incrementStored : CI → Region64 → RegionResult (Bool × CI)
  | [], [] => .ok incEmpty
  | [state], [rng] =>
    let i := JuliaLean.base.int.addWrap state (RangeDependencies.rangeStep rng)
    let valid := state != RangeDependencies.rangeLast rng
    .ok (valid, [i])
  | state :: next :: tail, rng :: nextRange :: ranges => do
    if state != RangeDependencies.rangeLast rng then
      let i := JuliaLean.base.int.add state (RangeDependencies.rangeStep rng)
      return (true, i :: next :: tail)
