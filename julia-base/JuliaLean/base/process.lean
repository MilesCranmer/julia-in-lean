section
variable {World P C Obj Task Cond Token Bytes Vec S Cpu : Type}
variable (f : Fields World P C Obj Task Cond Vec S Cpu)
  (r : Runtime World P Obj Task Cond Token Bytes Vec S Cpu)

def capture {A : Type} (action : M World A) : M World (Except Error A) :=
  tryCatch (do pure (.ok (← action))) (fun error => pure (.error error))

def rethrowResult {A : Type} : Except Error A → M World A
  | .ok value => pure value
  | .error error => throw error

def assertion (message : String) : Error := .foreignError "AssertionError" message

/-- `v[i]` of a `Vector`: `BoundsError` outside it. -/
def getIndex {A : Type} (v : List A) (i : Int) : M World A :=
  match (if 1 ≤ i then v[(i - 1).toNat]? else none) with
  | some x => pure x
  | none => throw (.jl .boundsError)

def setIndex {A : Type} (v : List A) (i : Int) (x : A) : M World (List A) :=
  if 1 ≤ i ∧ i ≤ v.length then pure (v.set (i - 1).toNat x) else throw (.jl .boundsError)

