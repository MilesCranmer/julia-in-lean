def stdio_copy (stdios : List Obj) (fd : Int) (replace : Obj) : M World (List Obj) := do
  let nio := if fd ≥ stdios.length then fd else stdios.length
  let new := stdios ++ List.replicate (nio.toNat - stdios.length) r.devnull
  setIndex new fd replace

