def setup_stdios {A : Type} (body : List Obj → M World A) (stdios : List Obj) : M World A := do
  let nstdio := stdios.length
  let mut open_io : List (Option Obj) := List.replicate nstdio none
  let mut close_io : List Bool := List.replicate nstdio false
  let mut failure : Option Error := none
  for i in List.range nstdio do
    match ← capture (setup_stdio r (stdios.getD i r.devnull) (i == 0)) with
    | .ok (io, c) =>
      open_io := open_io.set i (some io)
      close_io := close_io.set i c
    | .error e =>
      failure := some e
      break
  let result ← match failure with
    | some e => pure (.error e)
    | none => capture (body (open_io.filterMap id))
  for i in List.range nstdio do
    if close_io.getD i false then
      match open_io.getD i none with
      | some io => close_stdio r io
      | none => throw (.foreignError "UndefRefError" "access to undefined reference")
  rethrowResult result

