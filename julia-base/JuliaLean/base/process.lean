def setup_stdio (stdio : Obj) (readable : Bool) : M World (Obj × Bool) := do
  match ← r.stdioKind stdio with
  | .pipeEndpoint => setup_stdio_pipe_endpoint r stdio readable
  | .pipe => setup_stdio_pipe r stdio readable
  | .abstractPipe =>
    let inner ← if readable then r.pipeReader stdio else r.pipeWriter stdio
    -- the reader or writer is dispatched on again
    match ← r.stdioKind inner with
    | .pipeEndpoint => setup_stdio_pipe_endpoint r inner readable
    | .pipe => setup_stdio_pipe r inner readable
    | .iostream => setup_stdio_iostream r inner readable
    | .fileRedirect redirect => setup_stdio_file r redirect readable
    | .io => setup_stdio_io r inner readable
    | .abstractPipe | .other => r.setupStdioOther inner readable
  | .iostream => setup_stdio_iostream r stdio readable
  | .fileRedirect redirect => setup_stdio_file r redirect readable
  | .io => setup_stdio_io r stdio readable
  | .other => r.setupStdioOther stdio readable

