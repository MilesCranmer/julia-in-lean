def spawnPrimitive (file : S) (cmd : Cmd Vec S Cpu) (stdio : List Obj) (tok : Option Token) :
    M World P := do
  r.cancelCheck tok
  let loop ← r.eventloop
  let cpumask ← match cmd.cpus with
    | none => pure none
    | some cpus => pure (some (← as_cpumask r cpus))
  let mut iohandles : List (I32 × U64) := []
  for io in stdio do
    let entry ← match ← r.rawhandle io with
      | .null => pure (JInt.lit .i32 0x00, JInt.lit .u64 0)
      | .osHandle h => pure (JInt.lit .i32 0x02, ← toUInt h)
      | .ptr h => pure (JInt.lit .i32 0x04, h)
      | .other => throw (.errorException ("invalid spawn handle " ++ "from " ++ (← r.reprObj io)))
    iohandles := iohandles ++ [entry]
  let syncd := stdio.filterMap (fun io => match r.closeKind io with
    | .syncCloseFD _ t => some t
    | _ => none)
  let handle ← r.malloc
  r.disassociateJuliaStruct handle
  let mut flags := JuliaLean.base.int.bxor cmd.flags JuliaLean.base.cmd.windowsDisableExactName
  if cmd.uid.isSome then flags := JuliaLean.base.int.or_int flags JuliaLean.base.cmd.processSetuid
  if cmd.gid.isSome then flags := JuliaLean.base.int.or_int flags JuliaLean.base.cmd.processSetgid
  r.iolockBegin
  let dir ← if ← r.isemptyString cmd.dir then pure none else pure (some cmd.dir)
  let typemaxU32 := JInt.lit .u32 0xffffffff
  let err ← r.spawn file cmd.exec loop handle iohandles flags cmd.env dir cpumask
    (cmd.uid.getD typemaxU32) (cmd.gid.getD typemaxU32)
  if err.val == 0 then
    let pp ← processNew f r cmd handle syncd
    r.associateJuliaStruct handle pp
    r.iolockEnd
    return pp
  else
    r.forcecloseUV handle
    r.iolockEnd
    throw (← r.uvError ("could not spawn " ++ (← r.reprCmd cmd)) (JInt.wrap .i64 err.val))

