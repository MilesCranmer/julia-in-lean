def openCmd {Handle' Custom : Type} (handleObj : Handle' → Obj) (isDevnull : Obj → Bool)
    (cmds : Command Vec S Cpu Handle' Custom) (stdio : Obj) (write : Bool := false)
    (read : Bool := !write) (cancel : CancelArg Token := .default) : M World (Spawned P C) := do
  let tok ← r.resolveCancelToken cancel
  if read && write then
    if !isDevnull stdio then
      throw (.jl (.argumentError "no stream can be specified for `stdio` in read-write mode"))
    let input ← r.newPipeEndpoint
    let out ← r.newPipeEndpoint
    let processes ← spawnRedirectables f r handleObj cmds [input, out, ← r.stderr] tok
    setIn f processes input
    setOut f processes out
    return processes
  else if read then
    let out ← r.newPipeEndpoint
    let processes ← spawnRedirectables f r handleObj cmds [stdio, out, ← r.stderr] tok
    setOut f processes out
    return processes
  else if write then
    let input ← r.newPipeEndpoint
    let processes ← spawnRedirectables f r handleObj cmds [input, stdio, ← r.stderr] tok
    setIn f processes input
    return processes
  else
    if !isDevnull stdio then
      throw (.jl (.argumentError "no stream can be specified for `stdio` in no-access mode"))
    spawnRedirectables f r handleObj cmds [r.devnull, r.devnull, ← r.stderr] tok

