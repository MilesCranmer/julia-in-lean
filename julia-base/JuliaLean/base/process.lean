def setup_stdio_io (stdio : Obj) (child_readable : Bool) : M World (Obj × Bool) := do
  let parent ← r.newPipeEndpoint
  let (rd, wr) ← r.linkPipe (!child_readable) child_readable
  match ← capture (r.openPipe parent (if child_readable then wr else rd)) with
  | .error e =>
    r.closePipeSync rd
    r.closePipeSync wr
    throw e
  | .ok () => pure ()
  let child := if child_readable then rd else wr
  match ← capture (do
    let input := if child_readable then parent else stdio
    let output := if child_readable then stdio else parent
    let t ← r.async (finallyDo (do
      match ← capture (r.writeAll input output) with
      | .error ex =>
        r.warnIOError ex
        throw ex
      | .ok () => pure ()) (r.close parent))
    pure (r.syncCloseFD child t, true)) with
  | .error e =>
    r.closePipeSync child
    throw e
  | .ok result => return result

