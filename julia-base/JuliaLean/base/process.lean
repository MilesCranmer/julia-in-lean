def spawnChain {Handle' Custom : Type} (handleObj : Handle' → Obj) :
    Command Vec S Cpu Handle' Custom → List Obj → C → Option Token → M World C
  | .redirect cmd handle stream_no readable, stdios, chain, tok =>
    withRedirect r (handleObj handle) stream_no readable stdios
      (fun stdios => spawnChain handleObj cmd stdios chain tok)
  | .orCmds a b, stdios, chain, tok => do
    withLinkedPipe r (fun in_pipe out_pipe => do
      let stdios_left ← stdio_copy r stdios 2 out_pipe
      let _ ← spawnChain handleObj a stdios_left chain tok
      let stdios_right ← stdio_copy r stdios 1 in_pipe
      let _ ← spawnChain handleObj b stdios_right chain tok)
    return chain
  | .errOrCmds a b, stdios, chain, tok => do
    withLinkedPipe r (fun in_pipe out_pipe => do
      let stdios_left ← stdio_copy r stdios 3 out_pipe
      let _ ← spawnChain handleObj a stdios_left chain tok
      let stdios_right ← stdio_copy r stdios 1 in_pipe
      let _ ← spawnChain handleObj b stdios_right chain tok)
    return chain
  | .andCmds a b, stdios, chain, tok => do
    let _ ← spawnChain handleObj a stdios chain tok
    let _ ← spawnChain handleObj b stdios chain tok
    return chain
  | .cmd cmd, stdios, chain, tok => do
    pushProcess f chain (← spawnCmd f r cmd stdios tok)
    return chain
  | .custom _, _, _, _ => throw (.jl (.methodError "_spawn"))

