def as_cpumask (cpus : Cpu) : M World (List Bool) := do
  let cs ← r.cpus cpus
  let biggest ← match cs.map (fun c => c.val) |>.max? with
    | some m => pure m
    | none => throw (.jl (.argumentError
        "reducing over an empty collection is not allowed; consider supplying `init` to the reducer"))
  let size := (← r.cpumaskSize).val
  let n := if biggest ≥ size then biggest else size
  let mut cpumask := List.replicate n.toNat false
  for i in cs do
    cpumask ← setIndex cpumask i.val true
  return cpumask

