def withRedirect {A : Type} (handle : Obj) (stream_no : I64) (readable : Bool)
    (stdios : List Obj) (body : List Obj → M World A) : M World A := do
  let fdnum := JuliaLean.base.int.add stream_no (JInt.lit .i64 1)
  let (io, close_io) ← setup_stdio r handle readable
  let result ← capture (do body (← stdio_copy r stdios fdnum.val io))
  if close_io then close_stdio r io
  rethrowResult result

/-- `link_pipe` around the two sides of a pipeline, closing both pipe ends afterwards. -/
def withLinkedPipe {A : Type} (body : Obj → Obj → M World A) : M World A := do
  let (in_pipe, out_pipe) ← r.linkPipe false false
  let result ← capture (body in_pipe out_pipe)
  r.closePipeSync out_pipe
  r.closePipeSync in_pipe
  rethrowResult result

