  r.cancelCheck tok
  let out ← r.newPipeEndpoint
  let processes ← spawnRedirectables f r handleObj cmd [r.devnull, out, ← r.stderr] tok
  let ondone : M World Unit := do
    if !(← successSpawned f r processes (.explicit tok)) then
