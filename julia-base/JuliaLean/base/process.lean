def run {Handle' Custom : Type} (handleObj : Handle' → Obj) (cmds : Command Vec S Cpu Handle' Custom)
    (args : StdioArgs Obj := .args []) (wait : Bool := true) (cancel : CancelArg Token := .default) :
    M World (Spawned P C) := do
  let tok ← r.resolveCancelToken cancel
  r.cancelCheck tok
  if wait then
    let ps ← spawnRedirectables f r handleObj cmds (spawn_opts_inherit r args) tok
    if !(← successSpawned f r ps (.explicit tok)) then pipelineErrorSpawned f r ps
    return ps
  else
    let stdios := spawn_opts_swallow r args
    let ps ← spawnRedirectables f r handleObj cmds stdios tok
    if stdios.length > 0 then
      let input ← getIndex stdios 1
      if r.isIO input then setIn f ps input
      if stdios.length > 1 then
        let out ← getIndex stdios 2
        if r.isIO out then setOut f ps out
        if stdios.length > 2 then
          let err ← getIndex stdios 3
          if r.isIO err then setErr f ps err
    return ps

