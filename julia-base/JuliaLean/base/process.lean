def eachline {Handle' Custom EL : Type} (handleObj : Handle' → Obj)
    (eachLine : Obj → Bool → M World Unit → Option Token → M World EL)
    (cmd : Command Vec S Cpu Handle' Custom) (keep : Bool := false)
    (cancel : CancelArg Token := .default) : M World EL := do
