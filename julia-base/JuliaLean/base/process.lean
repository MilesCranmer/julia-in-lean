/-!
# Model of `base/process.jl`

`Process`, `ProcessChain`, spawning, `open`/`read`/`run`/`success` on commands, exit status,
`kill`, `getpid` and `wait` at Julia `f755f49a9e41380d7da126b3c1db9fe7f83dd027`, over the installed
`JuliaLean.base.cmd` model of commands. Processes and chains are references into the mutable
world whose fields are read and written through typed accessors. The I/O objects passed as
redirections and spawn handles (pipes, streams, files, `RawFD`s, `devnull`, `SyncCloseFD`s) are
values of one type `Obj`, and a classifier reports which `setup_stdio`/`close_stdio`/`rawhandle`
method Julia's dispatch selects. libuv calls (`jl_spawn`, `uv_process_kill`, ...), the I/O lock,
pipes, condition variables, tasks, timers and cancellation tokens are typed parameters with no
assumed laws; their documented behaviour enters only through these signatures. Exceptions retain
mutations, `try`/`finally` cleanup runs before rethrowing, and waits are fuel-free.
-/

namespace JuliaLean.base.process

open JuliaLean
open JuliaLean.base.io (M Error CancelArg finallyDo liftJl)
open JuliaLean.base.cmd (Cmd Command FileRedirect)

abbrev I32 := JInt .i32
abbrev I64 := JInt .i64
abbrev U16 := JInt .u16
abbrev U32 := JInt .u32
abbrev U64 := JInt .u64
abbrev Handle := U64

def C_NULL : Handle := JInt.lit .u64 0

/-- `rawhandle(io)`: `C_NULL`, an `OS_HANDLE` (a file descriptor, or a `HANDLE` pointer on
Windows), another `Ptr{Cvoid}`, or a value of another type. -/
inductive RawHandle where
  | null
  | osHandle (value : Int)
  | ptr (address : U64)
  | other

/-- Which `setup_stdio` method dispatch selects for a redirection. -/
inductive StdioKind (S : Type) where
  | pipeEndpoint
  | pipe
  | abstractPipe
  | iostream
  | fileRedirect (redirect : FileRedirect S)
  | io
  /-- A method defined in another file (`RawFD`, `OS_HANDLE`, `DevNull`, ...). -/
  | other

/-- Which `close_stdio` method dispatch selects. -/
inductive CloseKind (Obj Task : Type) where
  | osHandle
  | syncCloseFD (fd : Obj) (t : Task)
  | other

/-- The result of `_spawn`: a single `Process`, or a `ProcessChain`. -/
inductive Spawned (P C : Type) where
  | process (p : P)
  | chain (c : C)

/-- The fields of `Process` references `P`, `ProcessChain` references `C`, on commands of
type `Cmd Vec S Cpu`. -/
structure Fields (World P C Obj Task Cond Vec S Cpu : Type) where
  /-- `new(cmd, handle, devnull, devnull, devnull, syncd, typemin(Int64), typemin(Int32),
  ThreadSynchronizer())`, given the new condition. -/
  newProcess : Cmd Vec S Cpu → Handle → Obj → List Task → I64 → I32 → Cond → M World P
  cmd : P → M World (Cmd Vec S Cpu)
  handle : P → M World Handle
  setHandle : P → Handle → M World Unit
  /-- `@atomicswap :not_atomic proc.handle = v`. -/
  swapHandle : P → Handle → M World Handle
  pin : P → M World Obj
  pout : P → M World Obj
  perr : P → M World Obj
  setPin : P → Obj → M World Unit
  setPout : P → Obj → M World Unit
  setPerr : P → Obj → M World Unit
  syncd : P → M World (List Task)
  exitcode : P → M World I64
  setExitcode : P → I64 → M World Unit
  termsignal : P → M World I32
  setTermsignal : P → I32 → M World Unit
  exitnotify : P → M World Cond
  /-- `new(Process[], devnull, devnull, devnull)`. -/
  newChain : List P → Obj → M World C
  processes : C → M World (List P)
  setProcesses : C → List P → M World Unit
  cin : C → M World Obj
  cout : C → M World Obj
  cerr : C → M World Obj
  setCin : C → Obj → M World Unit
  setCout : C → Obj → M World Unit
  setCerr : C → Obj → M World Unit

/-- The `JL_O_*` open flags generated by `file_constants.jl`. -/
structure OpenFlags where
  rdonly : I64
  wronly : I64
  creat : I64
  append : I64
  trunc : I64

/-- libuv, the C runtime, pipes and the generic I/O methods used here. -/
structure Runtime (World P Obj Task Cond Token Bytes Vec S Cpu : Type) where
  devnull : Obj
  stderr : M World Obj
  /-- `RawFD(fd)`. -/
  rawFD : I32 → Obj
  /-- `SyncCloseFD(fd, t)`. -/
  syncCloseFD : Obj → Task → Obj
  isIO : Obj → Bool
  stdioKind : Obj → M World (StdioKind S)
  closeKind : Obj → CloseKind Obj Task
  rawhandle : Obj → M World RawHandle
  /-- `setup_stdio` methods of other files. -/
  setupStdioOther : Obj → Bool → M World (Obj × Bool)
  close : Obj → M World Unit
  closePipeSync : Obj → M World Unit
  /-- `link_pipe(reader_supports_async, writer_supports_async)`: the read and write ends. -/
  linkPipe : Bool → Bool → M World (Obj × Obj)
  openPipe : Obj → Obj → M World Unit
  newPipeEndpoint : M World Obj
  /-- `stdio.status == StatusInit` for a `PipeEndpoint`. -/
  statusIsInit : Obj → M World Bool
  pipeIn : Obj → M World Obj
  pipeOut : Obj → M World Obj
  linkPipeBang : Obj → M World Unit
  pipeReader : Obj → M World Obj
  pipeWriter : Obj → M World Obj
  /-- `RawFD(fd(stdio))` for an `IOStream`. -/
  iostreamRawFD : Obj → M World Obj
  /-- `Filesystem.open(filename, attr, perm)`. -/
  filesystemOpen : S → I64 → U16 → M World Obj
  openFlags : OpenFlags
  /-- `write(in, out)`. -/
  writeAll : Obj → Obj → M World Unit
  /-- `@warn "Process I/O error" exception=(ex, catch_backtrace())`. -/
  warnIOError : Error → M World Unit
  /-- `@async body`. -/
  async : M World Unit → M World Task
  waitTask : Task → Option Token → M World Unit
  iolockBegin : M World Unit
  iolockEnd : M World Unit
  associateJuliaStruct : Handle → P → M World Unit
  disassociateJuliaStruct : Handle → M World Unit
  closeUV : Handle → M World Unit
  forcecloseUV : Handle → M World Unit
  /-- `ccall(:jl_uv_process_data, ...)`, and the object it points to. -/
  processData : Handle → M World Handle
  unsafePointerToObjref : Handle → M World P
  free : Handle → M World Unit
  malloc : M World Handle
  eventloop : M World Handle
  cpumaskSize : M World I32
  cpus : Cpu → M World (List U16)
  /-- `ccall(:jl_spawn, ...)`: file, exec, loop, handle, the `(Cint, UInt)` handles, flags,
  env, dir (`none` for an empty one), cpumask, uid and gid. -/
  spawn : S → Vec → Handle → Handle → List (I32 × U64) → U32 → Option Vec → Option S →
    Option (List Bool) → U32 → U32 → M World I32
  isemptyString : S → M World Bool
  isemptyVec : Vec → M World Bool
  /-- `cmd.exec[1]`. -/
  firstExec : Vec → M World S
  newCondition : M World Cond
  registerFinalizer : P → M World Unit
  lockCond : Cond → M World Unit
  unlockCond : Cond → M World Unit
  notifyCond : Cond → M World Unit
  waitCond : Cond → Option Token → M World Unit
  preserveHandle : P → M World Unit
  unpreserveHandle : P → M World Unit
  processKill : Handle → I32 → M World I32
  processPid : Handle → M World I32
  uvESRCH : I32
  uvEPIPE : I32
  uvError : String → I64 → M World Error
  reprCmd : Cmd Vec S Cpu → M World String
  reprObj : Obj → M World String
  reprString : String → M World String
  iswindows : Bool
  isapple : Bool
  /-- `ProcessFailedException(procs)`. -/
  processFailed : List P → Error
  /-- `resolve_cancel_token(cancel)` and `check_cancel_arg(cancel)`. -/
  resolveCancelToken : CancelArg Token → M World (Option Token)
  checkCancelArg : CancelArg Token → M World (Option Token)
  cancelCheck : Option Token → M World Unit
  /-- `read(io; cancel)`, `String(bytes)`, `eof(io)`. -/
  readAll : Obj → Option Token → M World Bytes
  eof : Obj → M World Bool
  /-- `applicable(closewrite, x)` and `closewrite(x)`. -/
  applicableClosewrite : Obj → Bool
