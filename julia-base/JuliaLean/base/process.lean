def uv_return_spawn (p : Handle) (exit_status : I64) (termsignal : I32) : M World Unit := do
  let data ← r.processData p
  if data.val == 0 then return
  let proc ← r.unsafePointerToObjref data
  f.setExitcode proc exit_status
  f.setTermsignal proc termsignal
  r.disassociateJuliaStruct (← f.handle proc)
  r.closeUV (← f.handle proc)
  f.setHandle proc C_NULL
  let cond ← f.exitnotify proc
  r.lockCond cond
  finallyDo (r.notifyCond cond) (r.unlockCond cond)

