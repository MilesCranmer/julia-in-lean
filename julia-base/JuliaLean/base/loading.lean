def parse_cache_header {Stream : Type} (o : LOps X Y E D CI CF V)
    (ops : CacheIOOps o Stream) (stream : Stream) (cachefile : Bytes) :
    LM o ParsedCacheHeader := do
  let parsed ← _parse_cache_header o ops stream cachefile
  let indexedIncludes := indexCacheIncludes 0 parsed.includes
  let (sourceIncludes, dependencyIncludes) := partitionCacheIncludes parsed.srcfiles 0 parsed.includes
  let depotTag := lit "@depot" ++ [JuliaLean.base.path.pathsep (← pathPlatform o)]
  let (relocatableSources, anyNotRelocatable) ←
    relocatableCacheSources o depotTag parsed.srcfiles
  let (sourceDepot, anyNoDepotFound, multipleDepotsFound) ←
    if relocatableSources.isEmpty then pure (none, false, false)
    else
      let completeDepot ← findCacheSourceDepot o relocatableSources (← getW o).depot_path
      match completeDepot with
      | some depot => pure (some depot, false, false)
      | none =>
        let (missing, multiple) ← scanCacheSourceDepots o relocatableSources none false false
        pure (none, missing, multiple)
  if anyNoDepotFound then
    ops.logDebug (lit "Unable to resolve @depot tag for at least one include() file from cache file " ++
      cachefile ++ lit ", srcfiles=" ++ ops.showStringVector parsed.srcfiles)
  if anyNotRelocatable then
    ops.logDebug (lit "At least one include() file from " ++ cachefile ++
      lit " is not relocatable, srcfiles=" ++ ops.showStringVector parsed.srcfiles)
  let sourceIncludes ← match multipleDepotsFound, sourceDepot with
    | true, _ =>
      ops.logDebug (lit "Some include() files from " ++ cachefile ++
        lit " are distributed over multiple depots, srcfiles=" ++ ops.showStringVector parsed.srcfiles)
      pure sourceIncludes
    | false, some depot => restoreIndexedCacheIncludes o depot sourceIncludes
    | false, none => pure sourceIncludes
  let dependencyIncludes ←
    resolveDependencyCacheIncludes o ops cachefile sourceDepot dependencyIncludes
  let includes := rebuildCacheIncludes indexedIncludes sourceIncludes dependencyIncludes
  return { parsed with includes, includesSrcFiles := sourceIncludes.map Prod.snd }

def tryFinallyL (o : LOps X Y E D CI CF V) {α : Type}
    (body : LM o α) (cleanup : LM o Unit) : LM o α :=
  ExceptT.mk do
    let result ← ExceptT.run body
    match ← ExceptT.run cleanup with
    | .ok _ => pure result
    | .error err => pure (.error err)

def withValidCacheHeader {Stream α : Type} (o : LOps X Y E D CI CF V)
    (ops : CacheIOOps o Stream) (cachefile : Bytes) (body : Stream → LM o α) : LM o α := do
  let stream ← ops.openRead cachefile
  tryFinallyL o (do
    if (← isvalid_cache_header o ops stream).isNone then
      throwL o (.argumentError (ops.bytesToString (lit "Incompatible header in cache file " ++ cachefile ++ lit ".")))

    body stream) (ops.close stream)

