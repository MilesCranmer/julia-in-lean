def get_preferences_blob {Value : Type} (o : LOps X Y E D CI CF V)
    (ops : PreferenceBlobOps o Value) : LM o Bytes := do
  let preferences := (← getW o).compiletime_preferences
  if preferences.isEmpty then return []
  let mut observed : List (Bytes × List (Bytes × Value)) := []
  let mut unset : List (Bytes × List Bytes) := []
  for (uuid, keys) in preferences do
    let uuidText := ops.uuidString uuid
    let current ← ops.preferences uuid
    let mut values : List (Bytes × Value) := []
    let mut missing : List Bytes := []
    for key in keys do
      match current.find? (fun entry => entry.1 == key) with
      | some (_, value) => values := values ++ [(key, value)]
      | none => if !missing.contains key then missing := key :: missing
    if !values.isEmpty then observed := observed ++ [(uuidText, values)]
    if !missing.isEmpty then unset := unset ++ [(uuidText, ops.sortStrings missing)]
  return ← ops.printTOML observed unset

