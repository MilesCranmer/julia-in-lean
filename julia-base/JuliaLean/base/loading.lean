    List (Bytes × Val X) → LM o (Option PkgId)
  | [] => pure none
  | (dep_name, entries) :: rest => do
    let entries ← asVectorAny o entries
    match ← deps_entries_loop o d wh name dep_name entries with
    | some r => return r
    | none => deps_dict_loop o d wh name rest

