def extension_parent_name {Mod : Type} (o : LOps X Y E D CI CF V)
    (registry : ModuleRegistryOps o Mod) (origins : PkgOriginOps o V)
    (fixupStdlibPath : Bytes → Bytes) (module : Mod) : LM o (Option (Val X)) := do
  let rootModule := registry.moduleroot module
  let sourcePath ← pathof o registry.moduleUuid
    (fun m => registry.moduleName (registry.moduleroot m)) origins fixupStdlibPath rootModule
  match sourcePath with
  | none => return none
  | some sourcePath =>
    let parts := (JuliaLean.base.path.splitpath (← pathPlatform o) o.str (P sourcePath)).map
      (fun part => part.bytes)
    match findLastPathPartIndex (lit "ext") parts with
    | none => return none
    | some extIndex =>
      if extIndex + 3 < parts.length then
        return none
      let parentRoot ← joinpath o (parts.take extIndex)
      match ← locate_project_file o parentRoot with
      | .inl _ => return none
      | .inr projectFile =>
        let project ← parsed_toml o projectFile
        return ← tget o project (lit "name")

