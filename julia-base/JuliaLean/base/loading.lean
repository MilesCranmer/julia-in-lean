structure SHA (n : Nat) where
  bytes : Bytes

def SHA_Vector (_o : LOps X Y E D CI CF V) (n : Nat) (bytes : Bytes) : Except (LErr E) (SHA n) :=
  if bytes.length == n then .ok ⟨bytes⟩
  else .error (.argumentError s!"wrong number of bytes for SHA: Expected {n} bytes, got {bytes.length}")
def SHA_String (o : LOps X Y E D CI CF V) (n : Nat) (s : Bytes) : Except (LErr E) (SHA n) := do
  SHA_Vector o n (← o.hex2bytes s)
def parse_SHA (o : LOps X Y E D CI CF V) (n : Nat) (s : Bytes) : Except (LErr E) (SHA n) := SHA_String o n s
def tryparse_SHA (o : LOps X Y E D CI CF V) (n : Nat) (s : Bytes) : Except (LErr E) (Option (SHA n)) :=
  match parse_SHA o n s with
  | .ok h => .ok (some h)
  | .error (.argumentError _) => .ok none
  | .error e => .error e
def string_SHA (o : LOps X Y E D CI CF V) {n : Nat} (hash : SHA n) : Bytes := o.bytes2hex hash.bytes
def isless_SHA (o : LOps X Y E D CI CF V) {n : Nat} (a b : SHA n) : Bool := o.isless_bytes a.bytes b.bytes
