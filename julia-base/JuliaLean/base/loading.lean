def tryrequireFromSerializedByPath {Stream Mod Reason PrefValue Task Condition Callback Attempt SV Reports IO Color InternalMethod Exception : Type}
    (o : LOps X Y E D CI CF V)
    (ops : TryRequireOps o Stream Mod Reason PrefValue Task Condition Callback Attempt SV Reports IO Color InternalMethod Exception)
    (pkg : PkgId) (path : Bytes) (ocachepath : Option Bytes) :
    LM o (SerializedIncludeResult Mod Exception) := do
  assert_havelock o
  let io ← ops.search.freshest.staleness.io.openRead path
  let validation : Except Exception ParsedCacheHeader ← tryFinallyL o (do
    if (← isvalid_cache_header o ops.search.freshest.staleness.io io).isNone then
      return .error (ops.argumentError
        (lit "Incompatible header in cache file " ++ path ++ lit "."))
    let header ← parse_cache_header o ops.search.freshest.staleness.io io path
    if !header.cloneTargets.isEmpty then
      match ocachepath with
      | none =>
          return .error (ops.argumentError (lit "Expected ocachepath to be provided"))
      | some objectPath =>
          if !(← ops.search.freshest.staleness.io.isFile objectPath) then
            return .error (ops.argumentError
              (lit "Ocachepath " ++ objectPath ++ lit " is not a file."))
          let expectedPath := ocachefile_from_cachefile ops.search.freshest.candidates path
          if objectPath != expectedPath then
            return .error (ops.argumentError
              (objectPath ++ lit " is not the expected ocachefile"))
    else
      if ocachepath.isSome then throwL o (.assertionError "ocachepath === nothing")
      if !(← isvalid_file_crc o ops.search.freshest.staleness.io io) then
        return .error (ops.argumentError
          (lit "Invalid checksum in cache file " ++ path ++ lit "."))
    return .ok header) (ops.search.freshest.staleness.io.close io)
  match validation with
  | .error exception => return .exception exception
  | .ok header =>
      let mut dependencies : List (SerializedDependency Mod) := []
      for (depKey, depBuildId) in header.requiredModules do
        match ← tryrequireFromSerializedByPackage o ops depKey depBuildId with
        | .exception exception => return .exception exception
        | .module module => dependencies := .loaded module :: dependencies
      return ← include_from_serialized o ops.search.«include» pkg path ocachepath
        dependencies.reverse true

