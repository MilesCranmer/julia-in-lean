    if (← thaskey o exts wh.name) then
      let pu ← match proj.uuid with
        | some u => pure u
        | none => throwL o .typeError
      if wh.uuid == some (uuid5 o pu wh.name) then
        -- Extensions can load weak deps if they are an extension trigger
        if ext_may_load_weakdep (← asExtsArg o (← tgetindex o exts wh.name)) name then
          let weakdeps ← asDictOpt o (← tget o d (lit "weakdeps"))
