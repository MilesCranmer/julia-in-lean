def base_project_projects (o : LOps X Y E D CI CF V) (workspace_root project_dir base_project_file : Bytes) :
    List Bytes → LM o (Option Bytes)
  | [] => pure none
  | project :: rest => do
    let project_path ← joinpath o [workspace_root, project]
    if (← liftL o (o.fs.isdir project_path)) then
      if o.pfs.samefile (P project_path) (P project_dir) then
        return some base_project_file
    base_project_projects o workspace_root project_dir base_project_file rest

/-- One iteration of the `while true` loop of `base_project` after `parent_dir` is computed:
`some r` returns `r` from `base_project`, `none` continues with `current_dir = parent_dir`. -/
def base_project_step (o : LOps X Y E D CI CF V) (home_dir project_dir : Bytes) (started_in_home : Bool)
    (current_dir parent_dir : Bytes) : LM o (Option (Option Bytes)) := do
  -- Stop if we've reached root
  if parent_dir == current_dir then return some none
  -- Stop if we started in home and have now left it
  if started_in_home && !(← startswith o parent_dir home_dir) then return some none
  let base_project_file ← env_project_file o parent_dir
  match base_project_file with
  | .inr base_project_file =>
    let d ← parsed_toml o base_project_file
    let workspace ← asDictOpt o (← tget o d (lit "workspace"))
    match workspace with
    | some workspace =>
      let projects ← tget o workspace (lit "projects")
      -- `::Union{Vector{String}, Nothing, String}`
      let projects ← match projects with
        | none => pure none
        | some (.str _) => pure none
        | some v => do
          match ← vectorString? o v with
          | some ps => pure (some ps)
          | none => throwL o .typeError
      match projects with
      | some projects =>
        -- Check if any project in the workspace matches the original project
        let workspace_root ← dirname o base_project_file
        match ← base_project_projects o workspace_root project_dir base_project_file projects with
        | some r => return some (some r)
        | none => return none
      | none => return none
    | none => return none
  | .inl _ => return none

/-- The `while true` loop of `base_project`. -/
def base_project_loop (o : LOps X Y E D CI CF V) (home_dir project_dir : Bytes) (started_in_home : Bool)
    (current_dir : Bytes) : LM o (Option Bytes) := do
  let parent_dir ← dirname o current_dir
  let step ← base_project_step o home_dir project_dir started_in_home current_dir parent_dir
  match step with
  | some r => return r
  | none => base_project_loop o home_dir project_dir started_in_home parent_dir
