def checksums_invalid_file {Stream : Type} (o : LOps X Y E D CI CF V)
    (ops : CacheIOOps o Stream) (state : CacheValidationOps o) (cachefile : Bytes)
    (ocachefile : Option Bytes) (buildId : CacheU128)
    (reasons : Option (AMap Bytes JInt64)) (unverified : Option (List Bytes))
    (splitChecksums : Bool := true) :
    LM o (Bool × Option (AMap Bytes JInt64) × Option (List Bytes)) := do
  let opened ← tryCatchL o (do return some (← ops.openRead cachefile))
    fun err => do
      if !ops.isIOError err && !ops.isSystemError err then throwL o err
      let isFile ← ops.isFile cachefile
      let isFileText := if isFile then lit "true" else lit "false"
      ops.logDebug (lit "Rejecting cache file " ++ cachefile ++
        lit " because it could not be opened (isfile=" ++ isFileText ++ lit ")")
      pure none
  let some stream := opened | return (true, reasons, unverified)
  tryFinallyL o (do
    let checksum ← isvalid_cache_header o ops stream
    let expectedChecksum := JuliaLean.base.int.shrU buildId (i64 64)
    if checksum.isNone ||
        JInt.wrap .u128 (checksum.getD (JInt.lit .u32 0)).val != expectedChecksum then
      ops.logDebug (lit "Rejecting cache file " ++ cachefile ++
        lit " because it changed while being checked")
      return (true, reasons, unverified)
    match unverified with
    | none =>
      let (invalid, reasons) ← checksums_invalid_io o ops stream cachefile ocachefile reasons splitChecksums
      return (invalid, reasons, none)
    | some unverifiedFiles =>
      assert_havelock o
      let key ← checksum_key o ops stream ocachefile
      if ← state.checksumIsValid key then
        let unverifiedFiles :=
          if unverifiedFiles.contains cachefile then unverifiedFiles else unverifiedFiles ++ [cachefile]
        return (false, reasons, some unverifiedFiles)
      let (invalid, reasons) ← checksums_invalid_io o ops stream cachefile ocachefile reasons
      if !invalid && !(← state.generatingOutput) then state.rememberChecksum key
      return (invalid, reasons, some unverifiedFiles)) (ops.close stream)

