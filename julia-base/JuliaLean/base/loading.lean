def find_unsuitable_manifests_versions {Raw : Type} (o : LOps X Y E D CI CF V)
    (ops : ManifestVersionOps o Raw) : LM o (List Bytes × List Bytes) := do
  let current ← ops.currentVersion
  let currentPatch := ops.versionParts current
  let currentPrerelease := ops.prerelease current
  let mut unsuitable : List Bytes := []
  let mut dev : List Bytes := []
  for env in (← ops.loadPath) do
    match ← ops.projectFile env with
    | none => continue
    | some project =>
      match ← ops.manifestFile project with
      | none => continue
      | some manifest =>
        let raw ← ops.manifestVersion manifest
        let versionText := ops.renderVersionValue raw
        let mut reject := true
        match raw with
        | none => pure ()
        | some value =>
          match ops.stringValue value with
          | none => pure ()
          | some text =>
            let version ← ops.parseVersion text
            let versionPrerelease := ops.prerelease version
            if ops.versionParts version != currentPatch ||
                versionPrerelease.isEmpty != currentPrerelease.isEmpty then
              pure ()
            else if versionPrerelease.isEmpty then
              reject := false
            else if versionPrerelease.head! != currentPrerelease.head! then
              pure ()
            else if currentPrerelease.head! == lit "DEV" then
              dev := dev ++ [manifest]
              reject := false
            else
              reject := false
        if reject then
          unsuitable := unsuitable ++ [manifest ++ lit " (v" ++ versionText ++ lit ")"]
  return (unsuitable, dev)

