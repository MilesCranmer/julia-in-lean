def include_package_for_output {Mod Task Condition Inferred ConcreteDeps : Type}
    (o : LOps X Y E D CI CF V)
    (ops : IncludePackageForOutputOps o Mod Task Condition Inferred ConcreteDeps)
    (pkg : PkgId) (input : Bytes) (edition : JInt64 × JInt64) (depotPath dlLoadPath loadPath : List Bytes)
    (concreteDeps : ConcreteDeps) (source : Option Bytes)
    (preResolved : List (PkgId × Bytes) := []) : LM o Unit := do
  withLock o do
    let loaded ← start_loading o ops.registry ops.packageLoading pkg (JInt.wrap .u128 0) false
    if loaded.isSome then throwL o (.assertionError "m === nothing")
    ops.setDepotPath depotPath
    ops.setDynamicLoadPath dlLoadPath
    ops.setLoadPath loadPath
    ops.setLoadPathEnvironment loadPath
    ops.setActiveProjectNothing
    ops.setTrackDependencies true
    let origin ← match ← ops.origins.get pkg with
      | some origin => pure origin
      | none => pure PkgOrigin_new
    ops.origins.set pkg {origin with path := some input}
    ops.replaceConcreteDependencies concreteDeps
    for (key, path) in preResolved do
      ops.setPreresolvedCachefile key path
  let uuidWords ← match pkg.uuid with
    | none => pure (JInt.lit .u64 0, JInt.lit .u64 0)
    | some uuid => ops.uuidWords uuid
  ops.setModuleUuid ops.topLevelModule uuidWords
  if let some sourcePath := source then ops.setSourcePath sourcePath
  ops.setNewlyInferred (some ops.inferred)
  let keepIR := (← ops.outputObject).isSome
  if keepIR then ops.setPrecompileKeepIR (JInt.lit .i8 1)
  ops.topLevel.setParseEdition edition
  ops.topLevel.setSyntaxVersion (ops.cacheEdition edition)
  ops.cumulativeCompileTiming true
  ops.setDependencyLoadTime (JInt.lit .u64 0)
  ops.setDependencyLoadDepth 0
  ops.setPrecompileTrackDependencyLoad true
  let includeStart ← ops.timeNs
  let (compileBefore, _) ← ops.cumulativeCompileTimeNs
  tryFinallyL o (tryCatchL o (ops.includeTopLevel ops.topLevelModule input)
      (fun error => do
        if !ops.isPrecompilableError error then throwL o error
        ops.logPrecompilableAbort error
        ops.exit 125))
    (do
      let (compileAfter, _) ← ops.cumulativeCompileTimeNs
      let includeEnd ← ops.timeNs
      ops.cumulativeCompileTiming false
      ops.setPrecompileTrackDependencyLoad false
      if ← ops.getBoolEnv (lit "JULIA_PRECOMP_REPORT_TIMING") false then
        ops.printTiming (ops.wrappingSubtract includeEnd includeStart)
          (← ops.dependencyLoadTime)
          (ops.wrappingSubtract compileAfter compileBefore) ops.inferred.length
      ops.setNewlyInferred none
      if keepIR then ops.setPrecompileKeepIR (JInt.lit .i8 0))
  let module ← match ← maybe_root_module o ops.registry pkg with
    | some module => pure module
    | none => check_package_module_loaded_error o pkg
  ops.setNewlyInferred (some ops.inferred)
  withLock o (end_loading o ops.packageLoading pkg (some module))

