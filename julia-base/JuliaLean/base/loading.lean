def require_stdlib {Mod Task Condition Callback Stream Reason PrefValue Attempt SV Reports IO Color InternalMethod Exception : Type}
    (o : LOps X Y E D CI CF V)
    (ops : RequireStdlibOps o Mod Task Condition Callback Stream Reason PrefValue Attempt SV Reports IO Color InternalMethod Exception)
    (pkg : PkgId) (extension : Option Bytes) (fromModule : Mod) : LM o Mod := do
  if ← ops.registry.generatingOutput true then
    throwL o (.errorExceptionBytes
      (lit "This interactive function requires a stdlib to be loaded, and package code should instead use it directly from that stdlib."))
  withLock o do
    let thisPkg ← match extension with
      | none => pure pkg
      | some name =>
          match pkg.uuid with
          | none => throwL o .typeError
          | some uuid => pure (JuliaLean.base.pkgid.PkgId_UUID id (uuid5 o uuid name) name)
    let env ← ops.stdlibPath
    let loaded ← start_loading o ops.registry ops.packageLoading thisPkg (JInt.lit .u128 0) true
    if let some module := loaded then return module
    let newModule ← tryCatchL o (do
      let depots ← ops.appendBundledDepotPath []
      let mut fromStdlib := true
      if extension.isSome then
        let fromPkg := JuliaLean.base.pkgid.PkgId_Module ops.registry.moduleUuid
          (fun module => ops.registry.moduleName (ops.registry.moduleroot module)) fromModule
        match ← ops.registry.loadedModule fromPkg with
        | some loadedFrom =>
            if ops.registry.sameModule loadedFrom fromModule then
              let entryPath ← ops.cacheEntryPath fromPkg
              let mut found := false
              for depot in depots do
                if (← startswith o entryPath depot) then found := true
              fromStdlib := found
        | none => pure ()
      if fromStdlib then
        let sourcePath ← match extension with
          | none =>
              let path ← joinpath o [env, thisPkg.name, lit "src", thisPkg.name ++ lit ".jl"]
              normpath o path
          | some ext =>
              let path ← joinpath o [env, pkg.name]
              find_ext_path o (← normpath o path) ext
        set_pkgorigin_version_path o ops.registry ops.origins thisPkg sourcePath
        let spec := PkgLoadSpec_new sourcePath (← ops.versionEdition)
        require_search_from_serialized o ops.search thisPkg spec
          (JInt.lit .u128 0) false none (some depots)
      else pure none
    ) (fun error => do
      end_loading o ops.packageLoading thisPkg none
      throwL o error)
    end_loading o ops.packageLoading thisPkg newModule
    match newModule with
    | some module =>
        insert_extension_triggers_env o env thisPkg
        run_package_callbacks o ops.callbacks thisPkg
        return module
    | none =>
        if extension.isSome then
          modifyW o fun world => {world with ext_primed := world.ext_primed.set thisPkg [pkg]}
        ops.requirePrelocked thisPkg

