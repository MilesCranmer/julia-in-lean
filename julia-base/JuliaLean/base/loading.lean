def require_search_from_serialized {Stream Mod Reason PrefValue Task Condition Callback Attempt SV Reports IO Color InternalMethod Exception : Type}
    (o : LOps X Y E D CI CF V)
    (ops : RequireSearchOps o Stream Mod Reason PrefValue Task Condition Callback Attempt SV Reports IO Color InternalMethod Exception)
    (pkg : PkgId) (sourcespec : PkgLoadSpec) (buildId : CacheU128) (staleCheck : Bool)
    (reasons : Option (AMap Bytes JInt64) := none)
    (depotPath : Option (List Bytes) := none) : LM o (Option Mod) := do
  assert_havelock o
  let mut tryBuildIds := [buildId]
  if buildId.val == 0 then
    match ← ops.freshest.staleness.registry.loadedPrecompiles pkg with
    | none => pure ()
    | some modules =>
        for module in modules do
          tryBuildIds := (← module_build_id o ops.freshest.staleness.registry module) :: tryBuildIds
  let depotPath ← match depotPath with
    | some depots => pure depots
    | none => pure (← getW o).depot_path
  let paths ←
    if tryBuildIds.length == 1 then
      RequireSearchPathSource.lazy <$> lazy_cachefile_candidates o ops.freshest.candidates
        pkg sourcespec.path (some depotPath)
    else
      RequireSearchPathSource.eager <$> find_all_in_cache_path o ops.freshest.candidates
        pkg (some depotPath)
  let preResolved ← ops.preResolvedCacheGet pkg
  let flags := defaultCacheFlags o ops.freshest.staleness.coverage
  let mut tried := 0
  let mut found : Option Mod := none
  for candidateBuildId in tryBuildIds do
    if found.isNone then
      let mut cursor : RequireSearchPathCursor := {first := preResolved, source := paths}
      let mut searching := true
      while searching && found.isNone do
        match ← nextRequireSearchPath o ops.freshest.candidates cursor with
        | none => searching := false
        | some (path, nextCursor) =>
            cursor := nextCursor
            tried := tried + 1
            let trusted := preResolved == some path
            found ← requireSearchTryCandidate o ops pkg sourcespec candidateBuildId path
              depotPath flags staleCheck trusted reasons tried
  return found

