def parse_cache_buildid {Stream : Type} (o : LOps X Y E D CI CF V)
    (ops : CacheBuildIdOps o Stream) (cachePath : Bytes) : LM o (CacheU128 × UUID) := do
  let stream ← ops.io.openRead cachePath
  tryFinallyL o (do
    let checksum ← isvalid_cache_header o ops.io stream
    let checksum ← match checksum with
      | some checksum => pure checksum
      | none => throwL o (.errorExceptionBytes
          (lit "Incompatible header in cache file " ++ cachePath ++ lit "."))
    let _ ← ops.io.readU8 stream
    let _ ← ops.io.readU8 stream
    let _ ← ops.io.readU8 stream
    let nameLength ← ops.io.readI32 stream
    if nameLength.val == 0 then
      throwL o (.errorExceptionBytes (lit "no module defined in " ++ cachePath))
    let _ ← ops.io.readBytes stream (JInt.wrap .i64 nameLength.val)
    let high ← ops.io.readU64 stream
    let low ← ops.io.readU64 stream
    let uuid ← ops.uuidFromWords (high, low)
    let buildId := JInt.wrap .u128 (checksum.val * (2 ^ 64) + low.val)
    return (buildId, uuid)) (ops.io.close stream)

