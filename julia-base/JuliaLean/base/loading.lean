def register_restored_modules {Mod SV Reports IO Color : Type} (o : LOps X Y E D CI CF V)
    (moduleOps : ModuleRegistryOps o Mod) (originOps : PkgOriginOps o V)
    (restoredOps : RestoredModulesOps o Mod SV) (initOps : ModuleInitOps o Mod Reports)
    (timeOps : TimeImportsOps o Mod IO Color) (sv : SV) (pkg : PkgId) (path : Bytes)
    (initReports : Option Reports := none) : LM o (List Mod) := do
  assert_havelock o
  let restored ← restoredOps.restoredModules sv
  for module in restored do
    if ← restoredOps.isDefinedDocsMeta module then
      restoredOps.pushDocsModule module
    if moduleOps.isRootModule module then
      moduleOps.pushLoadedModulesOrder module
      moduleOps.pushLoadedPrecompile pkg module
  let origin ← match ← originOps.get pkg with
    | some origin => pure origin
    | none => pure PkgOrigin_new
  originOps.set pkg {origin with cachepath := some path}
  let inits ← restoredOps.initModules sv
  if !inits.isEmpty then
    modifyW o fun world => {world with require_lock := world.require_lock - 1}
    tryFinallyL o (runModuleInitLoop o initOps timeOps inits 1 initReports)
      (modifyW o fun world => {world with require_lock := world.require_lock + 1})
  return restored

