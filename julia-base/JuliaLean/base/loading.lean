def pkgversion {Mod : Type} (o : LOps X Y E D CI CF V) (moduleroot : Mod → Mod)
    (jl_module_uuid : Mod → U64 × U64) (nameof_moduleroot : Mod → Bytes)
    (origins : PkgOriginOps o V) (fixup_stdlib_path : Bytes → Bytes) (m : Mod) :
    LM o (Option V) := withLock o do
  let pkgid := JuliaLean.base.pkgid.PkgId_Module jl_module_uuid nameof_moduleroot (moduleroot m)
  let pkgorigin ← origins.get pkgid
  if let some origin := pkgorigin then
    if let some version := origin.version then return some version
  let path ← pkgdir o moduleroot
    (fun root => pathof o jl_module_uuid nameof_moduleroot origins fixup_stdlib_path root)
    m []
  let version ← match path with
    | none => pure none
    | some path => get_pkgversion_from_path o path
  if let some origin := pkgorigin then
    origins.set pkgid {origin with version := version}
  return version

