def parse_cache_buildid {X Y D CI CF V Stream Vector Lock : Type}
    (o : LOps X Y JuliaLean.base.io.Error D CI CF V)
    (ops : CacheIOOps o Stream)
    (access : JuliaLean.base.iostream.Access (World X D CI CF) Stream Vector Lock)
    (locks : JuliaLean.base.iostream.Locks (World X D CI CF) Lock)
    (runtime : JuliaLean.base.iostream.Runtime (World X D CI CF) Vector)
    (systemerror : String → Bool → JuliaLean.base.io.M (World X D CI CF) Unit)
    (cachePath : Bytes) : LM o (CacheU128 × JuliaLean.base.uuid.UUID) := do
  let stream ← ops.openRead cachePath
  tryFinallyL o (do
    let checksum ← isvalid_cache_header o ops stream
    let checksum ← match checksum with
      | some checksum => pure checksum
      | none => throwL o (.argumentError
          (ops.bytesToString (lit "Incompatible header in cache file " ++ cachePath ++ lit ".")))
