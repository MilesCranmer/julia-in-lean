def imageFeatureBitsToString {m : Type → Type} [Monad m] {E IO V R : Type}
    [MonadExceptOf (ImageParseException E) m]
    (ops : ParseImageTargetOps m IO V R) (raw nwords : V) :
    m JuliaLean.Strings.JStr := do
  let pointerOwner ← ops.cconvertPointer raw
  let countOwner ← ops.cconvertInt32 nwords
  let owners : ImageCallOwners V := ⟨pointerOwner, countOwner⟩
  let pointerResult ← ops.unsafeConvertPointer owners pointerOwner
  let pointer ← assertImageABI (E := E) pointerResult
  let countResult ← ops.unsafeConvertInt32 owners countOwner
  let count ← assertImageABI (E := E) countResult
  ops.featureBitsToString owners pointer count

