def resolve_depot (o : LOps X Y E D CI CF V) (includePath : Bytes)
    (hint : Option Bytes := none) : LM o CacheDepotResolution := do
  let «prefix» := lit "@depot" ++ [JuliaLean.base.path.pathsep (← pathPlatform o)]
  if !(← startswith o includePath «prefix») then return .notRelocatable
  if let some hint := hint then
    if ← liftL o (o.fs.ispath (← restore_depot_path o includePath hint)) then return .found hint
  resolveDepotLoop o includePath (← getW o).depot_path

def readModuleListLoop {Stream : Type} (o : LOps X Y E D CI CF V)
    (ops : CacheIOOps o Stream) (stream : Stream) (hasBuildIdHi : Bool)
    (modules : List (PkgId × CacheU128)) : LM o (List (PkgId × CacheU128)) := do
