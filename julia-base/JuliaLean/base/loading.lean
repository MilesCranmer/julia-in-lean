def compilecache_spec {Cmd IO Process Stream Mod Task Condition Loaded Callback Attempt SV Reports Color InternalMethod Exception ConcreteDeps LoadableExts Channel : Type}
    (o : LOps X Y E D CI CF V)
    (ops : CompileCacheOps o Cmd IO Process Stream Mod Task Condition Loaded Callback Attempt SV Reports Color InternalMethod Exception ConcreteDeps LoadableExts Channel)
    (pkg : PkgId) (spec : PkgLoadSpec) (internalStderr internalStdout : IO)
    (keepLoadedModules : Bool := true) (flags : Option Cmd := none)
    (cacheFlags : Option CacheFlags := none) (loadableExts : Option LoadableExts := none)
    (signalChannel pidChannel : Option Channel := none) (reportTiming : Bool := false)
    (preResolved : Option (List (PkgId × Bytes)) := none) : LM o (Bytes × Option Bytes) := do
  let cachePath ← compilecache_dir o pkg
  let concreteDeps ← if keepLoadedModules then ops.copyConcreteDependencies else ops.emptyConcreteDependencies
  if keepLoadedModules then
    for (requiredPkg, module) in (← ops.loadedModules) do
      if !ops.isCoreMainOrBase requiredPkg then
        ops.pushConcreteDependency concreteDeps requiredPkg (← module_build_id o ops.modules module)
  ops.path.mkpath cachePath
  let cacheObjects ← ops.usePkgimages
  let (temporary, temporaryIo) ← ops.mktemp cachePath
  let mut temporaryObject : Option Bytes := none
  let mut temporaryObjectIo : Option Stream := none
  let mut temporarySharedObject : Option Bytes := none
  let mut temporarySharedObjectIo : Option Stream := none
  if cacheObjects then
    let (path, stream) ← ops.mktemp cachePath
    temporaryObject := some path
    temporaryObjectIo := some stream
    let (path, stream) ← ops.mktemp cachePath
    temporarySharedObject := some path
    temporarySharedObjectIo := some stream
  let result : Sum Process (Bytes × Option Bytes) ← tryFinallyL o (do
    ops.io.close temporaryIo
    if let some stream := temporaryObjectIo then ops.io.close stream
    if let some stream := temporarySharedObjectIo then ops.io.close stream
    let spawned ← create_expr_cache o ops.createExpr pkg spec temporary temporaryObject
      concreteDeps flags cacheFlags (some internalStderr) (some internalStdout) loadableExts reportTiming preResolved
    if let some channel := pidChannel then
      let _ ← tryCatchL o (do
        ops.putPid channel (← ops.processPid spawned)
        pure true) (fun _ => pure false)
    if let some channel := signalChannel then
      let task ← ops.spawnSamePool (compilecacheSignalLoop o ops spawned channel)
      ops.errorMonitor task
    let succeeded ← tryFinallyL o (ops.processSuccess spawned)
      (match signalChannel with
       | some channel => ops.closeSignal channel
       | none => pure ())
    if !succeeded then return Sum.inl spawned
    if cacheObjects then
      match temporaryObject, temporarySharedObject with
      | some objectPath, some sharedObjectPath => ops.linkImage objectPath sharedObjectPath
      | _, _ => throwL o .boundsError
    let preferences ← preferences_blob_file o ops.io temporary
    let cachefile ← compilecache_path o ops.path ops.coverage pkg preferences cacheFlags
    let objectCacheFile ← if cacheObjects then
      pure (some (ocachefile_from_cachefile ops.candidates cachefile))
    else pure none
    let sharedObjectCrc ← if cacheObjects then
      match temporarySharedObject with
      | some path => ops.io.crc32cPath path (JInt.lit .u32 0)
      | none => throwL o .boundsError
    else pure (JInt.lit .u32 0)
    let stream ← ops.io.openReadWrite temporary
    tryFinallyL o (do
      if (← isvalid_cache_header o ops.io stream).isNone then
        throwL o (.argumentError (ops.io.bytesToString
          (lit "Incompatible header for " ++ (← ops.pkgLog.reprPlainPkg pkg) ++
           lit " in new cache file " ++ temporary ++ lit ".")))
      ops.io.seekEnd stream
      ops.writeU32 stream sharedObjectCrc
      ops.io.seekStart stream
      let size ← ops.io.filesizeStream stream
      let checksum ← ops.io.crc32cStream stream size (JInt.lit .u32 0)
      ops.io.seekEnd stream
      ops.writeU32 stream checksum
      pure ()) (ops.io.close stream)
    let sourceMode ← ops.io.filemodePath spec.path
    let mode := JuliaLean.base.int.or_int
      (JuliaLean.base.int.and_int sourceMode (JInt.wrap .u64 0o777))
      (JInt.wrap .u64 0o600)
    ops.io.chmod temporary mode
    if pkg.uuid.isSome then
      let (_, entryFile) ← cache_file_entry o pkg
      let entries ← ops.io.readdir cachePath
      let mut cacheFiles := []
      for entry in entries do
        if (← startswith o entry (entryFile ++ lit "_")) && cacheBytesEndsWith entry (lit ".ji") then
          cacheFiles := cacheFiles ++ [entry]
      let maxFiles ← ops.maxNumPrecompileFiles
      if cacheFiles.length ≥ maxFiles then
        let mut oldestIndex := 0
        let firstPath ← joinpath o [cachePath, cacheFiles[0]!]
        let firstStat ← ops.io.statPath firstPath
        let mut oldestTime := firstStat.mtime
        let mut index := 1
        while index < cacheFiles.length do
          let candidatePath ← joinpath o [cachePath, cacheFiles[index]!]
          let candidateStat ← ops.io.statPath candidatePath
          if JuliaLean.base.float.lt_IEEEFloat candidateStat.mtime oldestTime then
            oldestIndex := index
            oldestTime := candidateStat.mtime
          index := index + 1
        let evicted ← joinpath o [cachePath, cacheFiles[oldestIndex]!]
        ops.io.logDebug (lit "Evicting file from cache " ++ evicted)
        ops.io.remove evicted true
        tryCatchL o (do
          let objectPath := ocachefile_from_cachefile ops.candidates evicted
          ops.io.remove objectPath true
          if ← ops.isApple then ops.io.removeRecursive (objectPath ++ lit ".dSYM")
          pure ()) (fun error =>
            if ops.io.isIOError error then pure () else throwL o error)
    let mut cachefile := cachefile
    let mut objectCacheFile := objectCacheFile
    if cacheObjects then
      match temporarySharedObject, objectCacheFile with
      | some sharedObjectPath, some objectPath =>
          let newObjectPath ← rename_unique_ocachefile o ops.rename
            sharedObjectPath objectPath objectPath
          if newObjectPath != objectPath then
            cachefile := cachefile_from_ocachefile ops.candidates newObjectPath
            objectCacheFile := some newObjectPath
          if ← ops.isApple then
            ops.runDsymutil newObjectPath
            let relocations ← joinpath o [newObjectPath ++ lit ".dSYM",
              lit "Contents", lit "Resources", lit "Relocations"]
            ops.io.removeRecursive relocations
      | _, _ => throwL o .boundsError
    ops.io.move temporary cachefile true
    return Sum.inr (cachefile, objectCacheFile)
    ) do
      if let some channel := signalChannel then ops.closeSignal channel
      ops.io.remove temporary true
      if cacheObjects then
        match temporaryObject, temporarySharedObject with
        | some objectPath, some sharedObjectPath =>
            ops.io.remove objectPath true
            ops.io.remove sharedObjectPath true
        | _, _ => throwL o .boundsError
  match result with
  | Sum.inr paths => return paths
  | Sum.inl process =>
      if (← ops.processExitCode process).val == 125 then throwL o .precompilableError
      throwL o (.errorExceptionBytes
        (lit "Failed to precompile " ++ (← ops.pkgLog.reprPlainPkg pkg) ++
         lit " to " ++ temporary ++ lit " (" ++ (← ops.processStatus process) ++ lit ")."))

