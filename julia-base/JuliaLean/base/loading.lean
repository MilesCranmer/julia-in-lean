    LM o (List TOMLDictRef) := do
  -- We'll return a list of dicts to be merged
  let mut dicts : List TOMLDictRef := []
  let project ← parsed_toml o project_toml
  let mut pkg_name : Option Bytes := none
  if let some uuid := uuid then
    -- If we've been given a UUID, map that to the name of the package as
