section
variable {X Y E D CI CF V : Type}

abbrev LM (_o : LOps X Y E D CI CF V) (α : Type) := ExceptT (LErr E) (StateT (World X D CI CF) Option) α

def throwL (o : LOps X Y E D CI CF V) {α : Type} (e : LErr E) : LM o α := throw e
def liftL (o : LOps X Y E D CI CF V) {α : Type} : Except (LErr E) α → LM o α
  | .ok a => pure a
  | .error e => throwL o e
def liftPath (o : LOps X Y E D CI CF V) {α : Type} : Except JuliaLean.base.path.PathError α → LM o α
  | .ok a => pure a
  | .error e => throwL o (.path e)
def liftPathAction (o : LOps X Y E D CI CF V) {α : Type}
    (action : JuliaLean.base.path.M (World X D CI CF) α) : LM o α :=
  ExceptT.mk <| StateT.mk fun world => do
    let (result, world) ← action world
    return (result.mapError LErr.path, world)

def pathPlatform (o : LOps X Y E D CI CF V) : LM o JuliaLean.base.path.Platform :=
  liftPath o (JuliaLean.base.path.platformForKernel o.pathKernel)
def getW (o : LOps X Y E D CI CF V) : LM o (World X D CI CF) := get
def modifyW (o : LOps X Y E D CI CF V) (f : World X D CI CF → World X D CI CF) : LM o Unit := modify f

/-- Runs a TOML parser action on `TOML_CACHE.p`. -/
-- Loading reinitializes the parser before each parse (base/loading.jl:224,249), so post-error parser cursor state is unobserved here.
def runToml (o : LOps X Y E D CI CF V) {α : Type} (x : PM o.toml α) : LM o α := do
  match runP o.toml x (← getW o).toml_parser with
  | none => ExceptT.lift (StateT.lift (none : Option α))
  | some (.error e) => throwL o (.toml e)
  | some (.ok (.error pe, _)) => throwL o (.toml (.parserError pe))
  | some (.ok (.ok a, p)) =>
    modifyW o fun w => { w with toml_parser := p }
    return a

/-- `@lock require_lock expr`: `lock`, `expr`, then `unlock`, also on an exception. -/
def withLock (o : LOps X Y E D CI CF V) {α : Type} (body : LM o α) : LM o α :=
  ExceptT.mk (do
    modify fun (w : World X D CI CF) => { w with require_lock := w.require_lock + 1 }
    let r ← ExceptT.run body
    modify fun (w : World X D CI CF) => { w with require_lock := w.require_lock - 1 }
    pure r)

@[partial_fixpoint_monotone]
theorem monotone_withLock {γ : Sort _} [Lean.Order.PartialOrder γ] (o : LOps X Y E D CI CF V) {α : Type}
    (f : γ → LM o α) (hf : Lean.Order.monotone f) : Lean.Order.monotone (fun x => withLock o (f x)) := by
  intro x y hxy
  unfold withLock ExceptT.mk
  apply Lean.Order.MonoBind.bind_mono_right (m := StateT (World X D CI CF) Option)
  intro _
  apply Lean.Order.MonoBind.bind_mono_left (m := StateT (World X D CI CF) Option)
  exact hf x y hxy

/-- `assert_havelock(require_lock)`. -/
def assert_havelock (o : LOps X Y E D CI CF V) : LM o Unit := do
  if (← getW o).require_lock == 0 then throwL o .concurrencyViolation

/-- Updates `LOADING_CACHE[]`'s dictionaries (the cache read earlier is the same object). -/
def modifyCache (o : LOps X Y E D CI CF V) (f : LoadingCache → LoadingCache) : LM o Unit :=
  modifyW o fun w => { w with loading_cache := w.loading_cache.map f }

/-! TOML table access. -/

def tableOf (o : LOps X Y E D CI CF V) (r : TOMLDictRef) : LM o D := do
  match (← getW o).toml_parser.tables[r]? with
  | some d => pure d
  | none => throwL o (.toml (.jl .boundsError))

def vectorOf (o : LOps X Y E D CI CF V) (r : Nat) : LM o (Vec X) := do
  match (← getW o).toml_parser.vectors[r]? with
  | some v => pure v
  | none => throwL o (.toml (.jl .boundsError))

/-- `get(d, key, nothing)`. -/
def tget (o : LOps X Y E D CI CF V) (d : TOMLDictRef) (key : Bytes) : LM o (Option (Val X)) := do
  return o.toml.dict.get (← tableOf o d) key

/-- `haskey(d, key)`. -/
def thaskey (o : LOps X Y E D CI CF V) (d : TOMLDictRef) (key : Bytes) : LM o Bool := do
  return (o.toml.dict.get (← tableOf o d) key).isSome

/-- `d[key]`. -/
def tgetindex (o : LOps X Y E D CI CF V) (d : TOMLDictRef) (key : Bytes) : LM o (Val X) := do
  match o.toml.dict.get (← tableOf o d) key with
  | some v => pure v
  | none => throwL o .keyError

/-- `x::Union{String, Nothing}`. -/
def asStringOpt (o : LOps X Y E D CI CF V) : Option (Val X) → LM o (Option Bytes)
  | none => pure none
  | some (.str s) => pure (some s)
  | some _ => throwL o .typeError

/-- `x::String`. -/
def asString (o : LOps X Y E D CI CF V) : Val X → LM o Bytes
  | .str s => pure s
  | _ => throwL o .typeError

/-- `x::Union{Dict{String, Any}, Nothing}`. -/
def asDictOpt (o : LOps X Y E D CI CF V) : Option (Val X) → LM o (Option TOMLDictRef)
  | none => pure none
  | some (.table r) => pure (some r)
  | some _ => throwL o .typeError

/-- `x::Dict{String, Any}`. -/
def asDict (o : LOps X Y E D CI CF V) : Val X → LM o TOMLDictRef
  | .table r => pure r
  | _ => throwL o .typeError

/-- `x::Vector{Any}`. -/
def asVectorAny (o : LOps X Y E D CI CF V) : Val X → LM o (List (Val X))
  | .vector r => do
    let v ← vectorOf o r
    if v.eltype == .any then pure v.elems else throwL o .typeError
  | _ => throwL o .typeError

/-- A `Vector{String}`'s elements, if `x` is one. -/
def vectorString? (o : LOps X Y E D CI CF V) : Val X → LM o (Option (List Bytes))
  | .vector r => do
    let v ← vectorOf o r
    if v.eltype == .string then
      return some (v.elems.filterMap fun | .str s => some s | _ => none)
    else return none
  | _ => pure none

/-- `get(x, key, nothing)` of an untyped value: a TOML table's entry; `get` has no method for
the other TOML value types. -/
def anyGet (o : LOps X Y E D CI CF V) (x : Val X) (key : Bytes) : LM o (Option (Val X)) :=
  match x with
  | .table r => tget o r key
  | _ => throwL o (.methodError "get")

/-- `haskey(x, key)` of an untyped value. -/
def anyHaskey (o : LOps X Y E D CI CF V) (x : Val X) (key : Bytes) : LM o Bool :=
  match x with
  | .table r => thaskey o r key
  | _ => throwL o (.methodError "haskey")

/-- `x[key]` of an untyped value with a `String` key. -/
def anyGetindex (o : LOps X Y E D CI CF V) (x : Val X) (key : Bytes) : LM o (Val X) :=
  match x with
  | .table r => tgetindex o r key
  | _ => throwL o (.methodError "getindex")

/-- `d[k] = v` on a TOML table. -/
def tsetindex (o : LOps X Y E D CI CF V) (r : TOMLDictRef) (k : Bytes) (v : Val X) : LM o Unit := do
  let d ← tableOf o r
  runToml o (JuliaLean.base.toml.parser.setTable o.toml r (o.toml.dict.set d k v))

/-- `delete!(d, k)` on a TOML table. -/
def tdelete (o : LOps X Y E D CI CF V) (r : TOMLDictRef) (k : Bytes) : LM o Unit := do
  let d ← tableOf o r
  runToml o (JuliaLean.base.toml.parser.setTable o.toml r (o.toml.dict.delete d k))

/-- `Dict{String, Any}()`. -/
def tnew (o : LOps X Y E D CI CF V) : LM o TOMLDictRef := runToml o (JuliaLean.base.toml.parser.allocTable o.toml)

/-- `copy(d)` of a `Dict{String, Any}`: a new dictionary with the same entries. -/
def tcopy (o : LOps X Y E D CI CF V) (r : TOMLDictRef) : LM o TOMLDictRef := do
  let d ← tableOf o r
  let r' ← tnew o
  runToml o (JuliaLean.base.toml.parser.setTable o.toml r' d)
  return r'

/-- `get(Dict{String, Any}, d, key)`: the entry, or a new empty `Dict{String, Any}`. -/
def tgetOrNew (o : LOps X Y E D CI CF V) (r : TOMLDictRef) (key : Bytes) : LM o (Val X) := do
  let v ← tget o r key
  match v with
  | some v => pure v
  | none => return .table (← tnew o)

/-- `merge(a, b)` of two `Dict{String, Any}`s: a copy of `a`, then `b`'s entries. -/
def tmerge (o : LOps X Y E D CI CF V) (a b : TOMLDictRef) : LM o TOMLDictRef := do
  let merged ← tcopy o a
  for (k, v) in o.toml.dict.pairs (← tableOf o b) do
    tsetindex o merged k v
  return merged

/-! Paths (`base/path.jl`) use the platform selected by the installed `Sys` model. -/

def P (b : Bytes) : JuliaLean.base.path.Path := ⟨b⟩

def joinpath (o : LOps X Y E D CI CF V) (parts : List Bytes) : LM o Bytes := do
  return (← liftPath o (JuliaLean.base.path.joinpathStrings (← pathPlatform o) o.str (parts.map P))).bytes
def dirname (o : LOps X Y E D CI CF V) (p : Bytes) : LM o Bytes := do
  return (JuliaLean.base.path.dirname (← pathPlatform o) o.str (P p)).bytes
def basename (o : LOps X Y E D CI CF V) (p : Bytes) : LM o Bytes := do
  return (JuliaLean.base.path.basename (← pathPlatform o) o.str (P p)).bytes
def splitdir (o : LOps X Y E D CI CF V) (p : Bytes) : LM o (Bytes × Bytes) := do
  let (a, b) := JuliaLean.base.path.splitdir (← pathPlatform o) o.str (P p)
  return (a.bytes, b.bytes)
def normpath (o : LOps X Y E D CI CF V) (p : Bytes) : LM o Bytes := do
  return (JuliaLean.base.path.normpath (← pathPlatform o) o.str (P p)).bytes
/-- `normpath(a, b...)`. -/
def normpathMany (o : LOps X Y E D CI CF V) (a : Bytes) (rest : List Bytes) : LM o Bytes := do
  return (← liftPath o (JuliaLean.base.path.normpathMany (← pathPlatform o) o.str (P a) (rest.map P))).bytes
