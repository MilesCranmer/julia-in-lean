def env_project_file (o : LOps X Y E D CI CF V) (env : Bytes) : LM o (Bool ⊕ Bytes) := withLock o do
  let cache := (← getW o).loading_cache
  if let some c := cache then
    if let some project_file := c.env_project_file.get env then
      return project_file
  let project_file ← do
    if (← liftL o (o.fs.isdir env)) then
      locate_project_file o env
    else if project_names.contains (← basename o env) && (← isfile_casesensitive o env) then
      pure (.inr env)
    else
      pure (.inl false)
  if cache.isSome then
    modifyCache o fun c => { c with env_project_file := c.env_project_file.set env project_file }
  return project_file

