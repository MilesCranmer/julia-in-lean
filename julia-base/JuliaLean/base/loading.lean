/-- A `deps` stanza: `Dict{String, Any}`, `Vector{String}` or `nothing`. -/
inductive Stanza where
  | dict (r : TOMLDictRef)
  | names (ns : List Bytes)
  | nothing

/-- The elements of `x::Union{Nothing, Vector{Any}}`; `nothing` has none to iterate. -/
def asVectorAnyOpt (o : LOps X Y E D CI CF V) : Option (Val X) → LM o (List (Val X))
  | none => pure []
  | some v => asVectorAny o v

/-- `x::Union{Vector{String}, Dict{String, Any}, Nothing}`. -/
def asStanza (o : LOps X Y E D CI CF V) : Option (Val X) → LM o Stanza
  | none => pure .nothing
  | some (.table r) => pure (.dict r)
  | some v => do
    match ← vectorString? o v with
    | some ns => pure (.names ns)
    | none => throwL o .typeError

/-- *dispatch*: `dep_stanza_get(stanza, name)`. -/
def dep_stanza_get (o : LOps X Y E D CI CF V) (stanza : Stanza) (name : Bytes) : LM o (Option PkgId) :=
  match stanza with
  | .dict r => dep_stanza_get_Dict o r name
  | .names ns => pure (dep_stanza_get_Vector ns name)
  | .nothing => pure (dep_stanza_get_Nothing name)

