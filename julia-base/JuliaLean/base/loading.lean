def requireModule {Mod Raw : Type} (o : LOps X Y E D CI CF V)
    (ops : RequireModuleOps o Mod Raw) (into : Mod) (mod : Bytes) : LM o Mod := do
  if ops.moduleRegistry.sameModule into ops.topLevelModule &&
      (← ops.moduleRegistry.generatingOutput true) then
    throwL o (.errorExceptionBytes
      (lit "`using/import " ++ ops.symbolString mod ++
        lit "` outside of a Module detected. Importing a package outside of a module is not allowed during package precompilation."))
  let topmod := ops.moduleRegistry.moduleroot into
  if ops.moduleRegistry.moduleName topmod == mod then return topmod
  withLock o do
    let cache ← LoadingCache_new o
    modifyW o fun world => {world with loading_cache := some cache}
    tryFinallyL o (do
      match ← identify_package_env_Module o ops.moduleRegistry.moduleUuid
          (fun module => ops.moduleRegistry.moduleName (ops.moduleRegistry.moduleroot module))
          into (ops.symbolString mod) with
      | none =>
        let packageOfInto := root_module_key ops.moduleRegistry into
        if packageOfInto.uuid.isNone then
          let (hint, dots) ← ops.invokeLatestCheckForHint into mod
          let hintMessage := if hint then
            lit ", maybe you meant `import/using " ++ dots ++ ops.symbolString mod ++ lit "`"
          else []
          let installMessage := if mod != lit "Pkg" then
            let startSentence := if hint then lit "Otherwise, run" else lit "Run"
            lit "\n- " ++ startSentence ++ lit " `import Pkg; Pkg.add(" ++
              ops.symbolRepr mod ++ lit ")` to install the " ++ ops.symbolString mod ++ lit " package."
          else []
          throwL o (.argumentError (ops.bytesToString
            (lit "Package " ++ ops.symbolString mod ++ lit " not found in current path" ++
              hintMessage ++ lit "." ++ installMessage)))
        else
          let warnings ← collect_manifest_warnings o ops.manifestVersions
          let intoText ← ops.moduleRepr into
          throwL o (.argumentError (ops.bytesToString
            (lit "Cannot load (`using/import`) module " ++ ops.symbolString mod ++
              lit " into module " ++ intoText ++ lit " in package " ++ packageOfInto.name ++
              lit "\nbecause package " ++ packageOfInto.name ++ lit " does not have " ++
              ops.symbolString mod ++ lit " in its dependencies:\n" ++ warnings ++
              lit "- You may have a partially installed environment. Try `Pkg.instantiate()`\n" ++
              lit "  to ensure all packages in the environment are installed.\n" ++
              lit "- Or, if you have " ++ packageOfInto.name ++ lit " checked out for development and have\n" ++
              lit "  added " ++ ops.symbolString mod ++ lit " as a dependency but haven't updated your primary\n" ++
              lit "  environment's manifest file, try `Pkg.resolve()`.\n" ++
              lit "- Otherwise you may need to report an issue with " ++ packageOfInto.name)))
      | some (pkg, env) =>
        if ← ops.trackDependencies then
          ops.pushRequireDependency into (ops.binpack pkg)
        ops.requirePrelocked pkg env
    ) (modifyW o fun world => {world with loading_cache := none})

