def include_from_serialized {Mod SV Reports IO Color InternalMethod Exception : Type}
    (o : LOps X Y E D CI CF V)
    (ops : IncludeSerializedOps o Mod SV Reports IO Color InternalMethod Exception)
    (pkg : PkgId) (path : Bytes) (ocachepath : Option Bytes)
    (depmods : List (SerializedDependency Mod)) (register : Bool := true) :
    LM o (SerializedIncludeResult Mod Exception) := do
  assert_havelock o
  let timingImports := decide (0 < (← getW o).timing_imports.val)
  tryFinallyL o (do
    let timingSnapshot ←
      if timingImports then do
        let elapsedStart ← ops.moduleInit.timeNs
        ops.moduleInit.cumulativeCompileTiming true
        let compileStart ← ops.moduleInit.cumulativeCompileTimeNs
        pure (some (elapsedStart, compileStart))
      else
        pure none
    let mut resolvedReverse : List Mod := []
    for dependency in depmods do
      match dependency with
      | .loaded module => resolvedReverse := module :: resolvedReverse
      | .pending depKey depBuildId =>
          let some module ← maybe_loaded_precompile o ops.moduleRegistry depKey depBuildId
            | throwL o (.argumentError "No value arguments present")
          let moduleKey := root_module_key ops.moduleRegistry module
          let moduleBuildId ← module_build_id o ops.moduleRegistry module
          if moduleKey != depKey || moduleBuildId.val != depBuildId.val then
            throwL o (.assertionError
              "PkgId(dep) == depkey && module_build_id(dep) === depbuild_id")
          resolvedReverse := module :: resolvedReverse
    let resolved := resolvedReverse.reverse
    modifyW o fun world => {world with require_lock := world.require_lock - 1}
    let restoredValue ← tryFinallyL o
      (match ocachepath with
       | some objectCachePath =>
           ops.restorePackageImage objectCachePath resolved pkg.name false
       | none =>
           ops.restoreIncremental path resolved pkg.name)
      (modifyW o fun world => {world with require_lock := world.require_lock + 1})
    match restoredValue with
    | .error exception => return .exception exception
    | .ok sv =>
        ops.insertBackedges (← ops.internalMethods sv)
        let initReports ←
          if timingImports then do
            pure (some (← ops.newInitReports))
          else
            pure none
        let restored ← register_restored_modules o ops.moduleRegistry ops.origins
          ops.restoredModules ops.moduleInit ops.timeImports sv pkg path initReports
        for module in restored do
          if ops.moduleRegistry.isRootModule module &&
              root_module_key ops.moduleRegistry module == pkg then
            if register then register_root_module o ops.moduleRegistry module
            if timingImports then
              let some (elapsedStart, (compileStart, recompileStart)) := timingSnapshot
                | throwL o .boundsError
              let some reports := initReports | throwL o .boundsError
              let elapsed := u64SubWrap (← ops.moduleInit.timeNs) elapsedStart
              let (compileEnd, recompileEnd) ← ops.moduleInit.cumulativeCompileTimeNs
              let compileTime := u64SubWrap compileEnd compileStart
              let recompileTime := u64SubWrap recompileEnd recompileStart
              for report in (← ops.initReportValues reports) do
                let (initModule, index, initElapsed, initCompile, initRecompile) := report
                print_time_imports_report_init o ops.timeImports initModule index
                  initElapsed initCompile initRecompile
              print_time_imports_report o ops.moduleRegistry ops.origins ops.fixupStdlibPath
                ops.timeImports module elapsed compileTime recompileTime
            return .module module
        return .exception (ops.exceptionFromMessage
          (lit "Required dependency " ++ ops.formatPkgId pkg ++
            lit " failed to load from a cache file."))
  ) (if timingImports then ops.moduleInit.cumulativeCompileTiming false else pure ())

