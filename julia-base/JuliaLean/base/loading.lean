/-- Callees in other files: the TOML parser's parameters, `base/path.jl`'s string and filesystem
operations, filesystem primitives, `load_path()` (`base/initdefs.jl`), version numbers
(`base/version.jl`, `semver_spec`), hashing and CRC32C, `UUID(::String)`, `hex2bytes` and
`bytes2hex`. `V` is `VersionNumber`. -/
structure LOps (X Y E D CI CF V : Type) where
  toml : JuliaLean.base.toml.parser.Ops X Y E D CI CF
  str : JuliaLean.base.path.StringOps
  pfs : JuliaLean.base.path.FileSystemOps
  pathKernel : String
  pathFiles : JuliaLean.base.path.FileBindings (World X D CI CF)
  fs : FsOps E
  /-- Cached `Sys.isunix()`, `Sys.isapple()` and `Sys.iswindows()` predicates. -/
  sys : JuliaLean.base.osinfo.CachedPredicates
  caseSensitive : CaseSensitiveFsOps E
  load_path : World X D CI CF → Except (LErr E) (List Bytes)
  /-- `Sys.STDLIB` and the decimal strings of `VERSION.major`, `VERSION.minor`. -/
  STDLIB : Bytes
  /-- `Sys.BINDIR` and `Base.DATAROOTDIR`. -/
  BINDIR : Bytes
  DATAROOTDIR : Bytes
  version_major : Bytes
  version_minor : Bytes
  /-- `hash(::UUID)`, `hash(::String, h)`, `hash((SHA, bytes), h)`. -/
  hash_UUID : UUID → U64
  hash_String : Bytes → U64 → U64
  hash_SHA : Bytes → Bytes → U64 → U64
  /-- UUID CRC and the raw `jl_crc32c` checksum of the complete supplied byte buffer. -/
  crc32c_UUID : UUID → U32
  crc32c_bytes : Bytes → U32 → U32
  UUID_String : Bytes → Except (LErr E) UUID
  /-- `UUID(uuid)` when a TOML table supplies an `Any` value; dispatch is selected by that value's type. -/
  UUID_value : Val X → ExceptT (LErr E) (StateT (World X D CI CF) Option) UUID
  hex2bytes : Bytes → Except (LErr E) Bytes
  bytes2hex : Bytes → Bytes
  /-- `isless` on byte tuples. -/
  isless_bytes : Bytes → Bytes → Bool
  /-- `VersionNumber(x)` of a TOML value or `nothing`, `VersionNumber(minimum(semver_spec(x)).t...)`,
  `EditionNumber(v)`, `VersionNumber(edition)`, `<=` on versions, `VERSION_EDITION`, `OLDEST_EDITION`. -/
  VersionNumber_val : Option (Val X) → Except (LErr E) V
  semver_min : Val X → Except (LErr E) V
  EditionNumber : V → Except (LErr E) (JInt64 × JInt64)
  VersionNumber_edition : (JInt64 × JInt64) → Except (LErr E) V
  version_le : V → V → Bool
  VERSION_EDITION : JInt64 × JInt64
