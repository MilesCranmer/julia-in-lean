def bytesEndsWith (value suffix : Bytes) : Bool :=
  suffix.length ≤ value.length && value.drop (value.length - suffix.length) == suffix

def findDependencySourceName (includes : List CacheHeaderIncludes) (baseName : Bytes) :
    Option Bytes :=
  match includes with
  | [] => none
  | «include» :: rest =>
    if bytesEndsWith «include».filename baseName then some «include».filename
    else findDependencySourceName rest baseName

def dependencySourceName (o : LOps X Y E D CI CF V) (includes : List CacheHeaderIncludes)
    (depotFilename : Bytes) : LM o Bytes := do
  let depotTag := lit "@depot" ++ [JuliaLean.base.path.pathsep (← pathPlatform o)]
  if !(← startswith o depotFilename depotTag) then return depotFilename
  else
    let baseName ← restore_depot_path o depotFilename []
    return (findDependencySourceName includes baseName).getD depotFilename

def readDependencySourceLoop {Stream : Type} (o : LOps X Y E D CI CF V)
    (ops : CacheIOOps o Stream) (stream : Stream) (filename : Bytes)
    (includes : List CacheHeaderIncludes) : LM o Bytes := do
  if ← ops.eof stream then
    throwL o (.errorException (ops.bytesToString (filename ++ lit " is not stored in the source-text cache")))
  let filenameLength ← ops.readI32 stream
  if filenameLength.val == 0 then
    throwL o (.errorException (ops.bytesToString (filename ++ lit " is not stored in the source-text cache")))
  let depotFilename ← ops.readBytes stream (JInt.wrap .i64 filenameLength.val)
  let length ← ops.readU64 stream
  if (← dependencySourceName o includes depotFilename) == filename then
    ops.readBytes stream (← ops.u64ToI64 length)
  else
    seekAfterU64 o ops stream length
    readDependencySourceLoop o ops stream filename includes
