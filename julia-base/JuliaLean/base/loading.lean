def parse_CacheFlags {Leaf : Type} (o : LOps X Y E D CI CF V)
    (ops : CacheFlagParseOps o Leaf) (defaults : CacheFlags) (source : Bytes) :
    LM o CacheFlags := do
  let expr ← ops.metaParse source
  let parameters ← match expr with
    | .expr "call" [.symbol "CacheFlags", .expr "parameters" arguments] =>
      cacheFlagParameterLoop o ops [] arguments
    | _ => throwL o (.argumentError "Malformed CacheFlags string")
  let usePkgimages ← cacheFlagBoolean o ops parameters (lit "use_pkgimages")
  let debugLevel ← cacheFlagInteger o ops parameters (lit "debug_level")
  let checkBounds ← cacheFlagInteger o ops parameters (lit "check_bounds")
  let inline ← cacheFlagBoolean o ops parameters (lit "inline")
  let optLevel ← cacheFlagInteger o ops parameters (lit "opt_level")
  let coverage ← cacheFlagInteger o ops parameters (lit "coverage")
  let coveragePath ← match parameters.get (lit "coverage_path") with
    | none => pure none
    | some value =>
      if ops.isNothingSymbol value then pure none
      else match ops.stringValue value with
        | some path => pure (some path)
        | none => throwL o (.argumentError "Malformed CacheFlags string")
  ops.construct defaults
    { use_pkgimages := usePkgimages
      debug_level := debugLevel
      check_bounds := checkBounds
      inline := inline
      opt_level := optLevel
      coverage := coverage
      coverage_path := coveragePath }

