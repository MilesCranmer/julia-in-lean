def liftCoreAction {W L A : Type} (action : JuliaLean.base.boot.CoreM W L A) :
    GenericM W L A :=
  ExceptT.mk (StateT.mk (fun world => do
    match ← action world with
    | .ok (value, finalWorld) => pure (.ok value, finalWorld)
    | .error (error, finalWorld) => pure (.error (.other error), finalWorld)))

