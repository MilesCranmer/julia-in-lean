def get_updated_dict (o : LOps X Y E D CI CF V) (key : Bytes) (f : CachedTOMLDict) : LM o TOMLDictRef := do
  let s ← liftL o (o.fs.stat f.path)
  -- note, this might miss very rapid in-place updates, such that mtime is
  -- identical but that is solvable by not doing in-place updates, and not
  -- rapidly changing these files
  if s.inode != f.inode || !JuliaLean.base.float.eq_float s.mtime f.mtime || f.size != s.size then
    let content ← liftL o (o.fs.read f.path)
    let new_hash ← liftL o (loadingCrc32cBytes o content)
    if new_hash != f.hash then
      let f := { f with inode := s.inode, mtime := s.mtime, size := s.size, hash := new_hash }
      modifyW o fun w => { w with toml_cache := w.toml_cache.set key f }
      let d ← tomlParse o content f.path
      let f := { f with d := d }
      modifyW o fun w => { w with toml_cache := w.toml_cache.set key f }
      return f.d
  return f.d

