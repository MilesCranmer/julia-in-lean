def maybe_fetch_cache {Hook : Type} (o : LOps X Y E D CI CF V)
    (ops : CacheFetchOps o Hook) (pkg : PkgId) (sourcePath : Bytes) : LM o Bool := do
  let hook ← ops.hook
  match hook with
  | none => return false
  | some hook =>
    if ← ops.generatingOutput then return false
    if ← ops.hasInCacheFetchHook then return false
    ops.setInCacheFetchHook
    tryFinallyL o
      (tryCatchL o (do
        match ← ops.invokeLatest hook pkg sourcePath with
        | .bool true => pure true
        | _ => pure false)
        (fun err => do
          ops.logDebugFailure pkg err
          pure false))
      ops.deleteInCacheFetchHook


