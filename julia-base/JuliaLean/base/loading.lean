def checksums_valid_now {Stream : Type} (o : LOps X Y E D CI CF V)
    (ops : CacheIOOps o Stream) (state : CacheValidationOps o) (cachefile : Bytes) :
    LM o Bool := do
  let objectPath ← state.objectCachePath cachefile
  let ocachefile ← if ← ops.isFile objectPath then pure (some objectPath) else pure none
  tryCatchL o (do
    let stream ← ops.openRead cachefile
    tryFinallyL o (do
      let key ← checksum_key o ops stream ocachefile
      let (invalid, _) ← checksums_invalid_io o ops stream cachefile ocachefile none
      if invalid then withLock o (state.forgetChecksum key)
      return !invalid) (ops.close stream))
    fun err => do
      if ops.isIOError err || ops.isSystemError err then pure false
      else throwL o err
end


