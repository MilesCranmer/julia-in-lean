def _include_dependency_record {Mod DepList : Type} (o : LOps X Y E D CI CF V)
    (ops : IncludeDependencyOps o Mod DepList) (depList : DepList)
    (trackDependencies : Bool) (mod : Mod) (sourcePath : Bytes)
    (trackContent pathMayBeDir : Bool) : LM o (Bytes × Option Bytes) := do
  let previous ← source_path o ops.sourcePath none
  let path ← match previous with
    | none => abspath o sourcePath
    | some previous =>
        normpath o (← joinpath o [← dirname o previous, sourcePath])
  if !trackDependencies then
    if !pathMayBeDir && !(← liftL o (o.fs.isfile path)) then
      throwL o (ops.systemError (lit "opening file") path)
    if pathMayBeDir && !(← ops.isReadable path) then
      throwL o (ops.systemError (lit "opening file or folder") path)
  else
    withLock o do
      let stat ← liftL o (o.fs.stat path)
      if trackContent then
        let hash ← if ← liftL o (o.fs.isdir path) then
          pure (ops.hashBytes (ops.joinNames (← ops.readDirectory path)))
        else
          ops.hashFile path
        ops.recordDependency depList mod path (← ops.toUInt64 stat.size) hash
          (JuliaLean.Promotion.Fl.ofBits 0xBFF0000000000000)
      else
        ops.recordDependency depList mod path (JInt.lit .u64 0) (JInt.lit .u32 0) stat.mtime
  return (path, previous)

