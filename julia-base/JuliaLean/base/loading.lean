/-- The `for deps′ in (...)` loop: the first stanza with `name`, as `break resolved`. -/
def ext_stanzas_loop (o : LOps X Y E D CI CF V) (name : Bytes) : List Stanza → LM o (Option PkgId)
  | [] => pure none
  | s :: rest => do
    let dep ← dep_stanza_get o s name
    match dep with
    | none => ext_stanzas_loop o name rest
    | some d => return some d

