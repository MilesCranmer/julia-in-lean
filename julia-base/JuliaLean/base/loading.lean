def create_expr_cache {Cmd IO Process ConcreteDeps LoadableExts : Type}
    (o : LOps X Y E D CI CF V)
    (ops : CreateExprCacheOps o Cmd IO Process ConcreteDeps LoadableExts)
    (pkg : PkgId) (input : PkgLoadSpec) (output : Bytes) (outputObject : Option Bytes)
    (concreteDeps : ConcreteDeps) (flags : Option Cmd := none)
    (cacheFlags : Option CacheFlags := none) (internalStderr internalStdout : Option IO := none)
    (loadableExts : Option LoadableExts := none) (reportTiming : Bool := false)
    (preResolved : Option (List (PkgId × Bytes)) := none) : LM o Process := do
  let depotPath ← (← ops.paths.depotPath).mapM ops.paths.abspath
  let dynamicLoadPath ← (← ops.paths.dynamicLoadPath).mapM ops.paths.abspath
  let mut loadPath ← (← ops.paths.loadPath).mapM ops.paths.abspath
  match ← ops.extensionTriggers pkg with
  | none => pure ()
  | some triggers =>
      let parentId ← ops.firstExtensionTrigger triggers
      let mut loadIndex := 0
      while loadIndex < loadPath.length do
        let env := loadPath[loadIndex]!
        match ← ops.envProjectFile env with
        | .inl true =>
            let (_, parentProjectFile) ← ops.entryPointAndProjectFile env parentId.name
            match parentProjectFile with
            | none => pure ()
            | some projectFile =>
                if ops.samePkgId (← ops.projectFileNameUuid projectFile parentId.name) parentId then
                  loadPath := loadPath ++ [projectFile]
        | _ => pure ()
        loadIndex := loadIndex + 1
  let pathSeparator := if ← ops.paths.isWindows then lit ";" else lit ":"
  if loadPath.any (fun path => ops.paths.containsPathSeparator path pathSeparator) then
    throwL o (.errorExceptionBytes
      (lit "LOAD_PATH entries cannot contain '" ++ pathSeparator ++ lit "'"))
  let cacheFlags := cacheFlags.getD ops.defaultCacheFlags
  let cacheFlags := if outputObject.isNone then {cacheFlags with opt_level := i64 0} else cacheFlags
  let mut options ← translate_cache_flags o ops.cacheFlagText cacheFlags ops.defaultCacheFlags
  options := options ++ coverage_cache_options o cacheFlags
  let cpuTarget ← if outputObject.isSome then do
    ops.logDebug (lit "Generating object cache file for " ++ (← ops.pkgLog.reprPlainPkg pkg))
    let target ← ops.cpuTarget
    match outputObject with
    | some path => options := options ++ [lit "--output-o", path]
    | none => pure ()
    pure target
  else do
    ops.logDebug (lit "Generating cache file for " ++ (← ops.pkgLog.reprPlainPkg pkg))
    pure none
  options := options ++ [lit "--output-ji", output]
  match ← ops.traceCompile with
  | some path => options := options ++ [lit "--trace-compile=" ++ path, lit "--trace-compile-timing"]
  | none => pure ()
  let colorOption ← ops.haveColor
  let colorArg := match colorOption with
    | none => lit "--color=auto"
    | some true => lit "--color=yes"
    | some false => lit "--color=no"
  let trailing := [lit "--output-incremental=yes", lit "--startup-file=no",
    lit "--history-file=no", lit "--warn-overwrite=yes", colorArg, lit "-"]
  let command ← ops.buildCommand (← ops.juliaCmd cpuTarget)
    (flags.getD ops.emptyCmd) options trailing
  let pid ← ops.processIdString
  let environment := [
    (lit "OPENBLAS_NUM_THREADS", some (lit "1")),
    (lit "JULIA_NUM_THREADS", some (lit "1")),
    (lit "JULIA_EXIT_WITH_PARENT_PID", some pid)]
  let command ← ops.addEnv command environment
  let command ← if reportTiming then
    ops.addEnv command [(lit "JULIA_PRECOMP_REPORT_TIMING", some (lit "1"))]
  else pure command
  let io ← ops.openPipeline command (internalStderr.getD ops.internalStderr)
    (internalStdout.getD ops.internalStdout) ops.standardOutput
  let preResolved ← match preResolved with
    | some entries => pure entries
    | none => ops.preResolvedCachefiles
  let sourcePath ← ops.sourcePath
  let nestedStack ← ops.precompileStack
  let precompilingExtension ← ops.precompilingExtension
  let program ← ops.renderWorkerScript
    { pkg, inputPath := input.path, edition := input.julia_edition, depotPath, dynamicLoadPath,
      loadPath, concreteDependencies := concreteDeps, sourcePath, preResolved, nestedStack,
      loadableExtensions := loadableExts, precompilingExtension }
  ops.writeInput io program
  ops.closeInput io
  return io

structure CompileCacheOps (o : LOps X Y E D CI CF V)
    (Cmd IO Process Stream Mod Task Condition Loaded Callback Attempt SV Reports Color InternalMethod Exception ConcreteDeps LoadableExts Channel : Type) where
  path : CachePathOps o
  coverage : CoverageOps o
