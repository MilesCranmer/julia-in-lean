def compilecache_path (o : LOps X Y E D CI CF V) (pathOps : CachePathOps o)
    (coverageOps : CoverageOps o) (pkg : PkgId) (prefsBlob : Bytes)
    (flags : Option CacheFlags := none) (project : Option Bytes := none)
    (environmentId : Option Bytes := none) : LM o Bytes := do
  let flags ← match flags with
    | some flags => pure flags
    | none => pathOps.cacheFlags
  let project ← match project with
    | some project => pure project
    | none => pure ((← pathOps.activeProject).getD [])
  let environmentId ← match environmentId with
    | some environmentId => pure environmentId
    | none => project_environment_id o project
  let (entryPath, entryFile) ← cache_file_entry o pkg
  let depot ← match (← getW o).depot_path with
    | depot :: _ => pure depot
    | [] => throwL o .boundsError
  let cachePath ← joinpath o [depot, entryPath]
  if !(← liftL o (o.fs.isdir cachePath)) then pathOps.mkpath cachePath
  match pkg.uuid with
  | none => return (← abspath2 o cachePath entryFile) ++ lit ".ji"
  | some _ =>
    let mut crc := o.crc32c_bytes project (JInt.lit .u32 0)
    if !environmentId.isEmpty then crc := o.crc32c_bytes environmentId crc
    crc := o.crc32c_bytes (← pathOps.imageFile) crc
    crc := o.crc32c_bytes (← pathOps.juliaBin) crc
    let cacheFlags ← _cacheflag_to_uint8 o coverageOps flags
    crc := o.crc32c_bytes [UInt8.ofNat cacheFlags.val.toNat] crc
    let coverage ← coverageOps.convertUInt8 flags.coverage
    crc := o.crc32c_bytes [UInt8.ofNat coverage.val.toNat] crc
    let cpuTarget ← match (← pathOps.cpuTargetEnv) with
      | some target => pure target
      | none => pathOps.cpuTargetOption
    crc := o.crc32c_bytes cpuTarget crc
    crc := o.crc32c_bytes prefsBlob crc
    let projectSlug := slug crc (i64 5)
    let filename := entryFile ++ lit "_" ++ projectSlug ++ lit ".ji"
    abspath2 o cachePath filename

