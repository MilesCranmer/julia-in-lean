def require_prelocked {Mod Task Condition Callback : Type}
    (o : LOps X Y E D CI CF V)
    (ops : RequireLoadingOps o Mod Task Condition Callback)
    (requireBody : PkgId → Option Bytes → LM o Mod)
    (pkg : PkgId) (env : Option Bytes := none) : LM o (Option Mod) := do
  assert_havelock o
  let runtime := (← getW o).require_runtime
  let track := runtime.trackDependencyLoads
  let mut start : U64 := JInt.lit .u64 0
  if track then
    if runtime.dependencyLoadDepth.val == 0 then start ← ops.timeNs
    modifyW o fun world =>
      let runtime := world.require_runtime
      let depth := JuliaLean.base.int.add_int runtime.dependencyLoadDepth (i64 1)
      let runtime := {runtime with dependencyLoadDepth := depth}
      {world with require_runtime := runtime}
  tryFinallyL o (do
    let loaded ← start_loading o ops.registry ops.packageLoading pkg (JInt.lit .u128 0) true
    match loaded with
    | some _ => return loaded
    | none =>
        let topLevelLoad := (← getW o).require_runtime.topLevelLoad
        modifyW o fun world =>
          let runtime := world.require_runtime
          {world with require_runtime := {runtime with topLevelLoad := false}}
        let loadedResult ← tryCatchL o (requireBody pkg env) (fun error => do
          modifyW o fun world =>
            let runtime := world.require_runtime
            {world with require_runtime := {runtime with topLevelLoad := topLevelLoad}}
          end_loading o ops.packageLoading pkg none
          throwL o error)
        modifyW o fun world =>
          let runtime := world.require_runtime
          {world with require_runtime := {runtime with topLevelLoad := topLevelLoad}}
        end_loading o ops.packageLoading pkg (some loadedResult)
        insert_extension_triggers_PkgId o pkg
        run_package_callbacks o ops.callbacks pkg
        return loadedResult
    ) (do
      if track then
        let depth := JuliaLean.base.int.sub (← getW o).require_runtime.dependencyLoadDepth (i64 1)
        modifyW o fun world =>
          let runtime := world.require_runtime
          {world with require_runtime := {runtime with dependencyLoadDepth := depth}}
        if depth.val == 0 then
          let elapsed := JInt.wrap .u64 ((← ops.timeNs).val - start.val)
          modifyW o fun world =>
            let runtime := world.require_runtime
            let elapsedTotal := JInt.wrap .u64 (runtime.dependencyLoadNs.val + elapsed.val)
            let runtime := {runtime with dependencyLoadNs := elapsedTotal}
            {world with require_runtime := runtime}
    )

