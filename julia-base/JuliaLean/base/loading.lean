def is_stdlib (o : LOps X Y E D CI CF V) (pkgid : PkgId) : LM o Bool := do
  if !(← liftL o (o.fs.readdir o.STDLIB)).contains pkgid.name then return false
  let stdlib_root ← joinpath o [o.STDLIB, pkgid.name]
  let project_file ← locate_project_file o stdlib_root
  match project_file with
  | .inr project_file =>
    let d ← parsed_toml o project_file
    let uuid ← tget o d (lit "uuid")
    match uuid with
    | some value => return some (← o.UUID_value value) == pkgid.uuid
    | none => return false
  | .inl _ => return false

