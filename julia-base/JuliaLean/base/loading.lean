def cache_search_depots (o : LOps X Y E D CI CF V) (ops : CacheCandidateOps o)
    (sourcePath : Bytes) (depotPath : Option (List Bytes) := none) : LM o (List Bytes) := do
  let depots ← match depotPath with
    | some depots => pure depots
    | none => pure (← getW o).depot_path
  let stdlibDir ← joinpath o [o.STDLIB, []]
  if !(← startswith o sourcePath stdlibDir) then return depots
  let priorities ← depots.mapM fun depot => do
    let depotPrefix ← joinpath o [depot, []]
    return !(← startswith o stdlibDir depotPrefix)
  let permutation ← ops.sortperm (fun (left right : Bool) => !left && right) false priorities
  cacheCandidatePermute o depots permutation

