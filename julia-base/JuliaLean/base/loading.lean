structure CacheFreshDependency (Mod : Type) where
  package : PkgId
  buildId : CacheU128
  loadedModule : Option Mod
  loadSpec : Option PkgLoadSpec

structure CacheStaleDecision (Mod : Type) where
  stale : Bool
  dependencies : List (CacheFreshDependency Mod)
  objectCache : Option Bytes
  buildId : CacheU128
  reasons : Option (AMap Bytes JInt64)

def rejectedCacheDecision {Mod : Type} (reasons : Option (AMap Bytes JInt64)) :
    CacheStaleDecision Mod :=
  { stale := true, dependencies := [], objectCache := none, buildId := JInt.wrap .u128 0
    reasons := reasons }

