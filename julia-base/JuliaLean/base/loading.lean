-- `moduleroot(m)` and `pathof(m)` (lines 569-589) reflect on the module; they are parameters.
def pkgdir {Mod : Type} (o : LOps X Y E D CI CF V) (moduleroot : Mod → Mod) (pathof : Mod → LM o (Option Bytes))
    (m : Mod) (paths : List Bytes) : LM o (Option Bytes) := do
  let rootmodule := moduleroot m
  let path ← pathof rootmodule
  match path with
  | none => return none
  | some path =>
    let (path, base) ← splitdir o (← dirname o path)
    let mut path := path
    if base == lit "src" then
      -- package source in `../src/Foo.jl`
      pure ()
    else if base == lit "ext" then
      -- extension source in `../ext/FooExt.jl`
      pure ()
    else if (← basename o path) == lit "ext" then
      -- extension source in `../ext/FooExt/FooExt.jl`
      path ← dirname o path
    else
      -- not a recognized package layout, e.g. a bare `Foo.jl` in a load path entry
      return none
    return some (← joinpath o (path :: paths))

