def stale_prefs {Value : Type} (o : LOps X Y E D CI CF V)
    (ops : PreferenceStalenessOps o Value) (prefsBlob : Bytes) : LM o Bool := do
  if prefsBlob.isEmpty then return false
  let (observed, unset) ← ops.parseBlob prefsBlob
  for (uuidText, preferences) in observed do
    let uuid ← ops.uuidFromString uuidText
    let current ← ops.preferences uuid
    for (key, value) in preferences do
      match current.find? (fun entry => entry.1 == key) with
      | none => return true
      | some (_, now) => if !(← ops.tomlEqual now value) then return true
  for (uuidText, keys) in unset.getD [] do
    let uuid ← ops.uuidFromString uuidText
    let current ← ops.preferences uuid
    for key in keys do
      if (current.find? (fun entry => entry.1 == key)).isSome then return true
  return false

