def deps_entry_outcome (o : LOps X Y E D CI CF V) (wh : PkgId) (name dep_name : Bytes) (entry : Val X) :
    LM o EntryOutcome := do
  let entry ← asDict o entry
  let uuid ← asStringOpt o (← tget o entry (lit "uuid"))
  match uuid with
  | none => return .next
  | some uuid =>
