def init_debuginfo_source_paths (o : LOps X Y E D CI CF V)
    (ops : DebugInfoSourcePathOps o) : LM o Unit := do
  let shareRoot ← joinpath o [o.BINDIR, o.DATAROOTDIR, lit "julia"]
  let shareRoot ← abspath o shareRoot
  let share ← joinpath o [shareRoot, []]
  let buildRoot ← normpathMany o (← ops.buildStdlibPath) [lit "..", lit ".."]
  let buildShare ← joinpath o [buildRoot, []]
  let mut paths := if buildShare == share then [] else [buildShare, share]
  if !ops.dataRoot.isEmpty then paths := paths ++ [ops.dataRoot ++ lit "julia/", share]
  paths := paths ++ [[], ← joinpath o [share, lit "base"]]
  ops.setSourcePaths paths

