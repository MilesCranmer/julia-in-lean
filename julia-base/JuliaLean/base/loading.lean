def parsed_toml_explicit {S Path : Type} (o : LOps X Y E D CI CF V) (memory : TOMLMemory o S)
    (keys : TOMLKeyOps o S Path) (project_file : Path) (toml_cache : TOMLCacheRef S X D CI CF)
    (toml_lock : TOMLField S Nat) : TCM o S TOMLDictRef := withTOMLLock o toml_lock do
  let cache ← tomlReadField o memory.loadingCache
  let dd ← if !(← keys.haskey toml_cache.dictionary project_file) then do
      let file ← keys.construct toml_cache.parser project_file
      keys.setindex toml_cache.dictionary file project_file
      return (← tomlReadField o file).d
    else do
      let file ← keys.getindex toml_cache.dictionary project_file
      let alreadyParsed : Bool ← match cache with
        | none => pure false
        | some cache => keys.containsParsed cache project_file
      if alreadyParsed then return (← tomlReadField o file).d
      updatedTOMLDictAt o memory toml_cache.parser file
  if let some cache := cache then keys.pushParsed cache project_file
  return dd

def globalTOMLParser : TOMLField (World X D CI CF) (Parser X D CI CF) :=
  ⟨World.toml_parser, fun value world => { world with toml_parser := value }⟩

def globalTOMLFile (key : Bytes) (initial : CachedTOMLDict) :
    TOMLField (World X D CI CF) CachedTOMLDict :=
  ⟨fun world => (world.toml_cache.get key).getD initial,
    fun value world => { world with toml_cache := world.toml_cache.set key value }⟩

def globalTOMLCache : TOMLCacheRef (World X D CI CF) X D CI CF :=
  ⟨globalTOMLParser,
    ⟨fun world => world.toml_cache.map fun (key, value) => (key, globalTOMLFile key value),
      fun entries world => { world with toml_cache := entries.map fun (key, value) => (key, value.get world) }⟩⟩

def globalTOMLLock : TOMLField (World X D CI CF) Nat :=
  ⟨World.require_lock, fun value world => { world with require_lock := value }⟩

def globalTOMLMemory (o : LOps X Y E D CI CF V) : TOMLMemory o (World X D CI CF) where
  context := id
  loadingCache :=
    ⟨fun world => world.loading_cache.map fun initial =>
      ⟨fun state => state.loading_cache.getD initial,
        fun value state => { state with loading_cache := some value }⟩,
      fun value world => { world with loading_cache := value.map (fun field => field.get world) }⟩
  allocateFile := fun value => pure (globalTOMLFile value.path value)

def stringTOMLKeyOps {S : Type} (o : LOps X Y E D CI CF V) (memory : TOMLMemory o S) :
    TOMLKeyOps o S Bytes where
  haskey := fun dictionary key => do return ((← tomlReadField o dictionary).get key).isSome
  getindex := fun dictionary key => do
    match (← tomlReadField o dictionary).get key with
    | some file => pure file
    | none => throw .keyError
  setindex := fun dictionary file key => do
    let entries ← tomlReadField o dictionary
    tomlWriteField o dictionary (entries.set key file)
  construct := cachedTOMLDictAt o memory
  containsParsed := fun cache key => do return (← tomlReadField o cache).require_parsed.contains key
  pushParsed := fun cache key => do
    let current ← tomlReadField o cache
    let parsed := if current.require_parsed.contains key then current.require_parsed else current.require_parsed ++ [key]
    tomlWriteField o cache { current with require_parsed := parsed }

