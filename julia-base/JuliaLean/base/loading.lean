-- function precompile(@nospecialize(argt::Type), m::Method)
--     atype, sparams = typeintersect_env(argt, m.sig)
--     mi = Base.Compiler.specialize_method(m, atype, sparams)
--     return precompile(mi)
-- end
-- /Source
structure PrecompileMethodOps (W L : Type) where
  core : JuliaLean.base.boot.CoreOps W L
  call : PrecompileMethodFunction → List (GenericValue L) → GenericM W L (GenericValue L)

/-- Read the concrete Method.sig field, then execute the selected
intersection and explicit two-target destructuring. The first indexed_iterate
result contributes its value and state; the second contributes only its value.
There is no extra iteration, state read or assumed Pair return. Specialization
uses exact Base.Compiler.specialize_method, with the original Method and both
actual extracted values. Its arbitrary result reaches selected precompile
unchanged; no MethodInstance assertion or Bool return restriction is invented.
