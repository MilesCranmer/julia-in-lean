def parse_image_target {Stream : Type} (o : LOps X Y E D CI CF V) (ops : ImageIOOps o Stream)
    (io : Stream) : LM o ImageTarget := do
  let flags ← ops.readInt32 io
  let base ← ops.readInt32 io
  let nwords ← ops.readInt32 io
  let nbytes := i64 (8 * nwords.val)
  let featureEnRaw ← ops.readBytes io nbytes
  let featureDisRaw ← ops.readBytes io nbytes
  let nameLength ← ops.readInt32 io
  let name ← ops.readBytes io (JInt.wrap .i64 nameLength.val)
  let extFeaturesLength ← ops.readInt32 io
  let extFeatures ← ops.readBytes io (JInt.wrap .i64 extFeaturesLength.val)
  let featuresEn ← ops.featureBitsToString featureEnRaw nwords
  let featuresDis ← ops.featureBitsToString featureDisRaw nwords
  return ⟨name, flags, base, extFeatures, featuresEn, featuresDis⟩

/-- `for i in 1:ntargets`, reading each target in order. -/
def parse_image_targets_loop {Stream : Type} (o : LOps X Y E D CI CF V)
    (ops : ImageIOOps o Stream) (io : Stream) : Nat → LM o (List ImageTarget)
  | 0 => pure []
  | n + 1 => do
    let target ← parse_image_target o ops io
    let rest ← parse_image_targets_loop o ops io n
    return target :: rest

