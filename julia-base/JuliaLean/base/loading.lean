  match project_file with
  | .inr project_file =>
    let proj ← project_file_name_uuid o project_file pkg.name
    if JuliaLean.base.pkgid.eq proj pkg then
      -- if `pkg` matches the project, return the project itself
      return .spec (← project_file_load_spec o project_file pkg.name)
    let mby_ext ← project_file_ext_load_spec o project_file pkg
    if let some e := mby_ext then return .spec e
    -- look for manifest file and `where` stanza
    explicit_manifest_uuid_load_spec o project_file pkg
