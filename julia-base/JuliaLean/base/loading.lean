def elapsedMilliseconds {Mod IO Color : Type} (o : LOps X Y E D CI CF V)
    (ops : TimeImportsOps o Mod IO Color) (elapsedTime : U64) : LM o Bytes := do
  let elapsedFloat := JuliaLean.base.float.floatOfInt .f64 elapsedTime
  let million := JuliaLean.base.float.floatOfInt .f64 (JInt.lit .u64 1000000)
  let milliseconds := JuliaLean.base.float.div_IEEEFloat elapsedFloat million
  let rounded ← ops.roundDigits milliseconds (i64 1)
  ops.writeFixed rounded 1

def timePercentage (value total : U64) : JuliaLean.base.float.FV .f64 :=
  let scaled := JuliaLean.base.int.mul_int (JInt.lit .u64 100) value
  JuliaLean.base.float.div_IEEEFloat
    (JuliaLean.base.float.floatOfInt .f64 scaled)
    (JuliaLean.base.float.floatOfInt .f64 total)

def findLastPathPartIndex (needle : Bytes) : List Bytes → Option Nat
  | [] => none
  | part :: rest =>
    match findLastPathPartIndex needle rest with
    | some index => some (index + 1)
    | none => if part == needle then some 0 else none

