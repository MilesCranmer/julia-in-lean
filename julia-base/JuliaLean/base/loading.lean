def isvalid_cache_header {Stream : Type} (o : LOps X Y E D CI CF V)
    (ops : CacheIOOps o Stream) (stream : Stream) : LM o (Option CacheU32) := do
  let header ← ops.readVerifyHeader stream
  if header.status.val == 0 &&
      JuliaLean.base.int.and_int header.flags JI_FLAG_PKGIMAGE == JInt.lit .u32 0 then
    ops.logDebug (lit "Cache header was for a system image")
    return none
  return if header.status.val == 0 then some header.checksum else none

