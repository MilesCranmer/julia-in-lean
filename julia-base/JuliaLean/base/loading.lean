    ∀ error, JuliaLean.base.tuple.isequalRec ops left right ≠ .error error := by
  induction left generalizing right with
  | nil =>
      cases right with
      | nil => simp [JuliaLean.base.tuple.isequalRec]
      | cons _ _ => simp at sameLength
  | cons value rest ih =>
      cases right with
      | nil => simp at sameLength
      | cons other tail =>
