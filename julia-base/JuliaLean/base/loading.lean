def project_get_edition (o : LOps X Y E D CI CF V) (d : TOMLDictRef) : LM o (JInt64 × JInt64) := do
  -- Syntax Evolution. First check syntax.julia_version entry
  let mut sv : Option V := none
  let ds ← tget o d (lit "syntax")
  if let some ds := ds then
    sv := some (← liftL o (o.VersionNumber_val (← anyGet o ds (lit "julia_version"))))
  -- If not found, default to minimum(compat["julia"])
  if sv.isNone then
    let cs ← tget o d (lit "compat")
    if let some cs := cs then
      let jv ← anyGet o cs (lit "julia")
      if let some jv := jv then
        sv := some (← liftL o (o.semver_min jv))
  -- Finally, if neither of those are set, default to the current Julia version.
  -- N.B.: This choice is less "compatible" than defaulting to a fixed older version.
  -- However, it avoids surprises from moving over scripts and REPL code to packages
  match sv with
  | none => return o.VERSION_EDITION
  | some sv' =>
    if o.version_le sv' (← liftL o (o.VersionNumber_edition o.OLDEST_EDITION)) then
      -- Syntax versioning was first introduced in Julia 1.14 - we do not support
      -- going back to versions before syntax version 1.13.
      return o.OLDEST_EDITION
    else
      liftL o (o.EditionNumber sv')

