def register_root_module {Mod : Type} (o : LOps X Y E D CI CF V)
    (ops : ModuleRegistryOps o Mod) (m : Mod) : LM o Unit := withLock o do
  let key := JuliaLean.base.pkgid.PkgId_Module ops.moduleUuid
    (fun module => ops.moduleName (ops.moduleroot module)) m (some (ops.moduleName m))
  if let some oldModule ← ops.loadedModule key then
    if !ops.sameModule oldModule m then
      if ← ops.generatingOutput true then
        throwL o (.errorExceptionBytes (lit "Replacing module `" ++ key.name ++ lit "`"))
      else
        ops.warn (lit "Replacing module `" ++ key.name ++ lit "`")
  let buildid ← module_build_id o ops m
  if (← maybe_loaded_precompile o ops key buildid).isNone then
    ops.pushLoadedModulesOrder m
  ops.setLoadedModule key m
