def rename_unique_ocachefile {Stream : Type} (o : LOps X Y E D CI CF V)
    (ops : RenameUniqueOcacheOps o Stream)
    (temporary original destination : Bytes) (number : JInt64 := i64 0) :
    LM o Bytes :=
  do
    let moved ← tryCatchL o
      (do
        ops.io.move temporary destination true
        pure (Except.ok ()))
      (fun error => pure (Except.error error))
    match moved with
    | .ok _ => pure destination
    | .error error => do
      if !ops.io.isIOError error then throwL o error
      let destinationExists ← ops.io.isFile destination
      if !destinationExists && ops.errorCode error != some ops.uvEacces then throwL o error
      let (name, extension) := ops.splitext original
