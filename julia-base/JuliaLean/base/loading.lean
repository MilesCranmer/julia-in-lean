abbrev Bytes := List UInt8
abbrev JInt64 := JInt .i64
abbrev U32 := JInt .u32

def i64 (z : Int) : JInt64 := JInt.wrap .i64 z
def lit (s : String) : Bytes := s.toUTF8.toList

/-- A `Dict` keyed by strings, `PkgId`s and tuples of them. -/
abbrev AMap (K V : Type) := List (K × V)

def AMap.get {K V : Type} [BEq K] (m : AMap K V) (k : K) : Option V := m.lookup k

/-- `m[k] = v`. -/
def AMap.set {K V : Type} [BEq K] (m : AMap K V) (k : K) (v : V) : AMap K V :=
  if (m.lookup k).isSome then m.map (fun (k', v') => if k' == k then (k', v) else (k', v')) else m ++ [(k, v)]

/-- Exceptions of the loading methods. -/
inductive LErr (E : Type) where
  /-- An exception of the TOML parser model, including a thrown `ParserError`. -/
  | toml (e : Thrown E)
  /-- `IOError` (`Base.IOError` of a failed system call) and `base/path.jl` errors. -/
  | ioError (msg : String)
  | path (e : JuliaLean.base.path.PathError)
  | typeError
  | errorException (msg : String)
  | argumentError (msg : String)
  | assertionError (msg : String)
  /-- `ConcurrencyViolationError` of `assert_havelock`. -/
  | concurrencyViolation
  | keyError
  | keyErrorPkgId (key : PkgId)
  | keyErrorSymbol (name : Bytes)
  | errorExceptionBytes (message : Bytes)
  /-- `LoadError` wraps the filename, line number, and original exception from `include_string`. -/
  | loadError (filename : Bytes) (line : JInt64) (cause : LErr E)
  /-- `ConcurrencyViolationError` raised when loading detects a cycle or recursive lock use. -/
  | concurrencyViolationMessage (message : Bytes)
  /-- `PrecompilableError` thrown when `__precompile__(false)` is evaluated during output generation. -/
  | precompilableError
  | boundsError
  | methodError (fn : String)
  | jl (e : JlError)
  | ext (e : E)

/-- `err isa IOError`. -/
def LErr.isIOError {E : Type} : LErr E → Bool
  | .ioError _ => true
  | .path (.ioError _) => true
  | _ => false

/-- The fields of `stat(path)` read by the loading code. -/
structure StatStruct where
  inode : U64
  mtime : JuliaLean.base.float.FV .f64
  size : JInt64

/-- Filesystem primitives (`base/stat.jl`, `base/file.jl`). `isfile(p)` is true iff it names a
regular file after following symbolic links, `isdir(p)` iff it names a directory, and `ispath(p)`
iff anything exists at `p`; each is false when the path does not exist and throws `IOError` when
`stat` fails otherwise. `readdir(p)` returns sorted entry names; `readdir_unsorted(p)` preserves
the filesystem's enumeration order. `stat` and `read` return metadata and bytes or throw `IOError`;
`touch` updates modification time or throws `IOError`. -/
structure FsOps (E : Type) where
  isfile : Bytes → Except (LErr E) Bool
  isdir : Bytes → Except (LErr E) Bool
  ispath : Bytes → Except (LErr E) Bool
  readdir : Bytes → Except (LErr E) (List Bytes)
  readdir_unsorted : Bytes → Except (LErr E) (List Bytes)
  touch : Bytes → Except (LErr E) Unit
  stat : Bytes → Except (LErr E) StatStruct
  read : Bytes → Except (LErr E) Bytes
structure GetattrListResult where
  status : JInt .i32
  filenameLength : Nat
  /-- Bytes in `struct attrlist`'s filename field, including its terminating NUL. -/
  filenameField : Bytes

/-- Platform adapters for the Windows `GetLongPathNameW` model and macOS
`getattrlist(2)` call in `base/loading.jl:11-83`. The macOS adapter returns the syscall
status, filename length and filename field after the 12-byte result header; `systemError`
implements Julia's `systemerror(:getattrlist, ret != 0)` conversion to `IOError`.
`stringLength`, `isAscii` and `normalizeNFD` are supplied by the installed Julia string and
Unicode models. -/
structure CaseSensitiveFsOps (E : Type) where
  getattrlist : Bytes → Bytes → Nat → JInt .u64 → Except (LErr E) GetattrListResult
  systemError : Bytes → Bool → Except (LErr E) Unit
  stringLength : Bytes → Nat
  isAscii : Bytes → Bool
  normalizeNFD : Bytes → Except (LErr E) Bytes


