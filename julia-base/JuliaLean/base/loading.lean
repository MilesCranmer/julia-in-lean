/-- Byte-view adapter for the installed checked string access. -/
def loadingUUIDCodeunit (bytes : Bytes) (i : JInt64) : Jl UInt8 :=
  match h : JuliaLean.base.strings.string.stringViewCodeunitAt true ⟨bytes⟩ i with
  | .ok byte => .ok byte
  | .error error => by
      have he : error = .jl .boundsError := by
        unfold JuliaLean.base.strings.string.stringViewCodeunitAt at h
        split at h <;> simp_all
      cases he
      exact .error .boundsError

def loadingUUIDIterate (units : UUIDUnits) (state : JInt64) : Jl (Option (UInt8 × JInt64)) :=
  let holder := match units with
    | .codeunits holder => holder
    | .iterated units => JuliaLean.base.strings.basic.codeunits (fun _ : Bytes => UInt8) units.string
  JuliaLean.base.abstractarray.iterateInteger
    (fun holder index => pure (JuliaLean.base.strings.basic.codeUnitsCheckbounds
      (JuliaLean.base.strings.basic.checkboundsScalar (fun bytes => i64 bytes.length)
        (fun index => decide (1 ≤ index.val)) (fun index count => decide (index.val ≤ count.val))) holder index))
    (JuliaLean.base.strings.basic.codeUnitsGetindexWith loadingUUIDCodeunit)
    (fun _ => pure (i64 1)) (fun a b => pure (JuliaLean.base.int.add_int a b)) holder state

def loadingUUIDIterator : JuliaLean.base.uuid.UUIDByteIterator UUIDUnits JInt64 where
  first := fun units => do
    let state ← JuliaLean.base.abstractarray.iterateStartingLinear (fun _ => pure (i64 1)) units
    loadingUUIDIterate units state
  next := loadingUUIDIterate

/-- Malformed UUID diagnostics retain their exception class; message text is
outside this adapter's contract (ARCHITECTURE.md:61-62). -/
def loadingUUIDString (bytes : Bytes) : Except (LErr E) UUID :=
  match JuliaLean.base.uuid.uuidFromString (fun _ : Bytes => true)
      (JuliaLean.base.strings.basic.codeunits (fun _ : Bytes => UInt8))
      loadingUUIDIterator (fun _ => "") bytes with
  | .ok value => .ok value
  | .error (.argumentError _) => .error (.argumentError "Malformed UUID string")
  | .error error => .error (.jl error)

/-- `UUID(x)` of a `String`. -/
def UUIDof (o : LOps X Y E D CI CF V) (s : Bytes) : LM o UUID := liftL o (loadingUUIDString s)

