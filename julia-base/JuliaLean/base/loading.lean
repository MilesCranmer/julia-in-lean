/-- Typed adapters to `Meta.parse`, `Expr`/`Symbol` inspection, and the `CacheFlags` keyword
constructor. `metaParse` is backed by `JuliaLean.base.meta.parse` with type `Expr`, filename
`"none"` and the default module parser. -/
structure CacheFlagParseOps (o : LOps X Y E D CI CF V) (Leaf : Type) where
  metaParse : Bytes → LM o (JuliaLean.base.expr.Value Leaf)
  symbolName : JuliaLean.base.expr.Value Leaf → Option Bytes
  booleanValue : JuliaLean.base.expr.Value Leaf → Option Bool
  integerValue : JuliaLean.base.expr.Value Leaf → LM o JInt64
  stringValue : JuliaLean.base.expr.Value Leaf → Option Bytes
  isNothingSymbol : JuliaLean.base.expr.Value Leaf → Bool
  construct : CacheFlags → CacheFlagOptions → LM o CacheFlags

/-- Builds `Dict{Symbol,Any}` from each parameter expression's first two arguments. -/
def cacheFlagParameterLoop {Leaf : Type} (o : LOps X Y E D CI CF V)
    (ops : CacheFlagParseOps o Leaf) (params : AMap Bytes (JuliaLean.base.expr.Value Leaf)) :
    List (JuliaLean.base.expr.Value Leaf) → LM o (AMap Bytes (JuliaLean.base.expr.Value Leaf))
  | [] => pure params
  | parameter :: rest => do
    let args ← match parameter with
      | .expr _ args => pure args
      | _ => throwL o .typeError
    let key ← match args with
      | key :: _ => pure key
      | [] => throwL o .boundsError
    let value ← match args with
      | _ :: value :: _ => pure value
      | _ => throwL o .boundsError
    let key ← match ops.symbolName key with
      | some key => pure key
      | none => throwL o .typeError
    cacheFlagParameterLoop o ops (params.set key value) rest

def cacheFlagBoolean {Leaf : Type} (o : LOps X Y E D CI CF V) (ops : CacheFlagParseOps o Leaf)
    (params : AMap Bytes (JuliaLean.base.expr.Value Leaf)) (key : Bytes) :
    LM o (Option Bool) := do
  match params.get key with
  | none => return none
  | some value =>
    match ops.booleanValue value with
    | some result => return some result
    | none => throwL o .typeError

def cacheFlagInteger {Leaf : Type} (o : LOps X Y E D CI CF V) (ops : CacheFlagParseOps o Leaf)
    (params : AMap Bytes (JuliaLean.base.expr.Value Leaf)) (key : Bytes) :
    LM o (Option JInt64) := do
  match params.get key with
  | none => return none
  | some value => return some (← ops.integerValue value)

