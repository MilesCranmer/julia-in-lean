      throwL o (.errorExceptionBytes (lit "no module defined in " ++ cachePath))
    let _ ← liftIO o
      (JuliaLean.base.iostream.skip access locks runtime
        (fun (delta : CacheI32) => JuliaLean.base.iostream.toInt delta)
        systemerror stream nameLength)
    let uuidHigh ← ops.readU64 stream
    let uuidLow ← ops.readU64 stream
    let uuid := JuliaLean.base.uuid.uuidFromTuple2 (uuidHigh, uuidLow)
    let checksumHigh := JuliaLean.base.int.shl_Int
      (JuliaLean.base.int.widenTo .u128 checksum) (JInt.lit .i64 64)
    let buildIdLow ← ops.readU64 stream
    let buildId := JuliaLean.base.int.binop JuliaLean.base.int.bor checksumHigh buildIdLow
    return (buildId, uuid)) (ops.close stream)

