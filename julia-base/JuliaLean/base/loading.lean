-- Source: base/loading.jl:5248-5252 @ f755f49a9e41380d7da126b3c1db9fe7f83dd027
-- function precompile(@nospecialize(argt::Type), m::Method)
--     atype, sparams = typeintersect_env(argt, m.sig)
--     mi = Base.Compiler.specialize_method(m, atype, sparams)
--     return precompile(mi)
-- end
-- /Source
def precompileTypeMethod {W L : Type} (ops : PrecompileMethodOps W L)
    (argtype method : GenericValue L) : GenericM W L (GenericValue L) := do
  let signature ← liftCoreAction (ops.core.getfield method (.symbol "sig"))
  let intersection ← ops.call .typeintersectEnv [argtype, signature]
  let first ← ops.call .indexedIterate
    [intersection, JuliaLean.base.boot.intV ops.core (JInt.lit .i64 1)]
  let atype ← liftCoreAction (ops.core.getfield first
    (JuliaLean.base.boot.intV ops.core (JInt.lit .i64 1)))
  let state ← liftCoreAction (ops.core.getfield first
    (JuliaLean.base.boot.intV ops.core (JInt.lit .i64 2)))
  let second ← ops.call .indexedIterate
    [intersection, JuliaLean.base.boot.intV ops.core (JInt.lit .i64 2), state]
  let sparams ← liftCoreAction (ops.core.getfield second
    (JuliaLean.base.boot.intV ops.core (JInt.lit .i64 1)))
  let specialized ← ops.call .compilerSpecializeMethod [method, atype, sparams]
  ops.call .precompile [specialized]

