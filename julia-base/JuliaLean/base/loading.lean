def tryrequireFromSerializedByPackage {Stream Mod Reason PrefValue Task Condition Callback Attempt SV Reports IO Color InternalMethod Exception : Type}
    (o : LOps X Y E D CI CF V)
    (ops : TryRequireOps o Stream Mod Reason PrefValue Task Condition Callback Attempt SV Reports IO Color InternalMethod Exception)
    (modkey : PkgId) (buildId : CacheU128) :
    LM o (SerializedIncludeResult Mod Exception) := do
  assert_havelock o
  let initial ← start_loading o ops.search.freshest.staleness.registry
    ops.search.packageLoading modkey buildId false
  let loaded ← if initial.isNone then do
    let searchResult ← tryCatchL o (do
      match ← locate_package_load_spec o modkey with
      | none =>
          throwL o (.errorExceptionBytes
            (lit "Cannot locate source for " ++ ops.search.«include».formatPkgId modkey))
      | some spec =>
          set_pkgorigin_version_path o ops.search.freshest.staleness.registry
            ops.search.origins modkey spec.path
          require_search_from_serialized o ops.search modkey spec buildId true
      ) (fun error => do
        end_loading o ops.search.packageLoading modkey none
        throwL o error)
    end_loading o ops.search.packageLoading modkey searchResult
    pure searchResult
  else
    pure initial
  if initial.isNone then
    if loaded.isSome then
      insert_extension_triggers_PkgId o modkey
      run_package_callbacks o ops.search.callbacks modkey
  else
    match initial with
    | some module =>
        if (← module_build_id o ops.search.freshest.staleness.registry module) == buildId &&
            (← register_reused_module o ops.search.freshest.staleness.registry module) then
          insert_extension_triggers_PkgId o modkey
          run_package_callbacks o ops.search.callbacks modkey
    | none => pure ()
  match loaded with
  | some module =>
      if root_module_key ops.search.freshest.staleness.registry module == modkey &&
          (← module_build_id o ops.search.freshest.staleness.registry module) == buildId then
        return .module module
  | none => pure ()
  return .exception (ops.search.«include».exceptionFromMessage
    (lit "Required dependency " ++ ops.search.«include».formatPkgId modkey ++
      lit " failed to load from a cache file."))

