--     base = read(io, Int32)
--     nwords = read(io, Int32)  # number of uint64_t feature words
--     feature_en_raw = read(io, 8*nwords)
--     feature_dis_raw = read(io, 8*nwords)
--     name_len = read(io, Int32)
--     name = String(read(io, name_len))
--     ext_features_len = read(io, Int32)
--     ext_features = String(read(io, ext_features_len))
--     features_en = @ccall jl_feature_bits_to_string(feature_en_raw::Ptr{UInt8}, nwords::Int32)::Ref{String}
--     features_dis = @ccall jl_feature_bits_to_string(feature_dis_raw::Ptr{UInt8}, nwords::Int32)::Ref{String}
--     ImageTarget(name, flags, base, ext_features, features_en, features_dis)
-- end
-- /Source
def parseImageTarget {m : Type → Type} [Monad m] {E IO V R : Type}
    [MonadExceptOf (ImageParseException E) m]
    (ops : ParseImageTargetOps m IO V R) (io : IO) : m R := do
  let flags ← ops.readInt32 io
  let base ← ops.readInt32 io
  let nwords ← ops.readInt32 io
  let enabledCount ← ops.multiply (JInt.lit .i64 8) nwords
  let enabledRaw ← ops.readCount io enabledCount
  let disabledCount ← ops.multiply (JInt.lit .i64 8) nwords
  let disabledRaw ← ops.readCount io disabledCount
  let nameLength ← ops.readInt32 io
  let nameRaw ← ops.readCount io nameLength
  let name ← ops.constructString nameRaw
  let extFeaturesLength ← ops.readInt32 io
  let extFeaturesRaw ← ops.readCount io extFeaturesLength
  let extFeatures ← ops.constructString extFeaturesRaw
  let featuresEnabled ← imageFeatureBitsToString (E := E) ops enabledRaw nwords
  let featuresDisabled ← imageFeatureBitsToString (E := E) ops disabledRaw nwords
  ops.constructImageTarget name flags base extFeatures featuresEnabled featuresDisabled

