    else
      if staleCheck && tried > 1 then touch_cachefile o pkg path
      let mut cacheIndex := 0
      while cacheIndex < dependencies.length && !invalid do
        let currentDependencies ← ops.attempt.dependencies state
        match currentDependencies[cacheIndex]? with
        | some (.loaded _) => cacheIndex := cacheIndex + 1
        | some (.cached depKey depBuildId depSpec depPath depObjectCache depDependencies) =>
            set_pkgorigin_version_path o ops.freshest.staleness.registry ops.origins
              depKey depSpec.path
            let depmods := depDependencies.map fun dependency =>
              match dependency.loadedModule with
              | some module => SerializedDependency.loaded module
              | none => SerializedDependency.pending dependency.package dependency.buildId
            match ← include_from_serialized o ops.«include» depKey depPath depObjectCache depmods staleCheck with
            | .exception _ => invalid := true
            | .module module =>
                end_loading o ops.packageLoading depKey (some module)
                ops.attempt.setDependency state cacheIndex (.loaded module)
                ops.attempt.setStartedLoading state (cacheIndex + 1)
                ops.attempt.pushNewDependency state depKey
                cacheIndex := cacheIndex + 1
        | _ => invalid := true
      if invalid then
        return none
      else
        match ← maybe_loaded_precompile o ops.freshest.staleness.registry pkg candidate.buildId with
        | some module =>
            if staleCheck then register_root_module o ops.freshest.staleness.registry module
            return some module
        | none =>
            let currentDependencies ← ops.attempt.dependencies state
            let depmods := currentDependencies.map fun dependency =>
              match dependency with
              | .loaded module => SerializedDependency.loaded module
              | .pending depKey depBuildId _ =>
                  SerializedDependency.pending depKey depBuildId
              | .cached depKey depBuildId _ _ _ _ =>
                  SerializedDependency.pending depKey depBuildId
            match ← include_from_serialized o ops.«include» pkg path candidate.objectCache depmods staleCheck with
            | .module module => return some module
            | .exception _ => return none
  ) (cleanupRequireSearchAttempt o ops state staleCheck)
