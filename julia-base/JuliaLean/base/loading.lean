def sort_cachefile_candidates! (o : LOps X Y E D CI CF V) (ops : CacheCandidateOps o)
    (candidates : CacheCandidates) : LM o (List Bytes) := do
  if candidates.length ≤ 1 then return candidates.map Prod.fst
  let indices := (List.range candidates.length).map (fun index => i64 (Int.ofNat (index + 1)))
  let keys ← cacheSortKeysLoop o candidates indices
  let permutation ← ops.sortperm sort_lt true keys
  return (← cacheCandidatePermute o candidates permutation).map Prod.fst

