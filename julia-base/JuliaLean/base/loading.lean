def canstart_loading {Mod Task Condition Loaded : Type} (o : LOps X Y E D CI CF V)
    (registry : ModuleRegistryOps o Mod)
    (ops : PackageLoadingOps o Mod Task Condition Loaded)
    (modkey : PkgId) (buildId : CacheU128) (stalecheck : Bool) :
    LM o (CanStartLoading Mod Condition) := do
  assert_havelock o
  if (← getW o).require_lock != 1 then throwL o .concurrencyViolation
  let currentTask ← ops.currentTask
  match ← ops.getLock modkey with
  | none =>
      if stalecheck then
        match ← maybe_root_module o registry modkey with
        | some module => return .loaded module
        | none => pure ()
      if !stalecheck && buildId.val != 0 then
        match ← maybe_loaded_precompile o registry modkey buildId with
        | some module => return .loaded module
        | none => pure ()
      return .available
  | some loading =>
      if !stalecheck && buildId.val != 0 && loading.buildId != buildId then
        match ← maybe_loaded_precompile o registry modkey buildId with
        | some module => return .loaded module
        | none => pure ()
      if (← ops.debugDeadlocks) && !ops.sameTask currentTask loading.task then
        match ← followLoadingWaits o ops currentTask loading.task [modkey.name] with
        | some chain =>
            let dependencies := chain ++ [modkey.name]
            let others ← ops.packagesOwnedByTask currentTask
            let otherNames := (others.map PkgId.name).filter fun name => !dependencies.contains name
            let message := lit "deadlock detected in loading " ++
              joinWithBytes (lit " using ") dependencies ++
              if otherNames.isEmpty then [] else
                lit " (while loading " ++ joinWithBytes (lit " and ") otherNames ++ lit ")"
            throwL o (.concurrencyViolationMessage message)
        | none => pure ()
      if ops.sameTask currentTask loading.task then
        let dependencies := [modkey.name, modkey.name]
        let others ← ops.packagesOwnedByTask currentTask
        let otherNames := (others.map PkgId.name).filter fun name => !dependencies.contains name
        let message := lit "deadlock detected in loading " ++
          joinWithBytes (lit " using ") dependencies ++
          if otherNames.isEmpty then [] else
            lit " (while loading " ++ joinWithBytes (lit " and ") otherNames ++ lit ")"
        throwL o (.concurrencyViolationMessage message)
      return .waiting loading.condition

def startLoadingLoop {Mod Task Condition Loaded : Type} (o : LOps X Y E D CI CF V)
    (registry : ModuleRegistryOps o Mod)
    (ops : PackageLoadingOps o Mod Task Condition Loaded)
    (modkey : PkgId) (buildId : CacheU128) (stalecheck : Bool) : LM o (Option Mod) := do
  match ← canstart_loading o registry ops modkey buildId stalecheck with
  | .loaded module => return some module
  | .available =>
      let task ← ops.currentTask
      let condition ← ops.newCondition
      ops.setLock modkey ⟨task, condition, buildId⟩
      return none
  | .waiting condition =>
      match ops.asModule (← ops.wait condition) with
      | some module => return some module
      | none => startLoadingLoop o registry ops modkey buildId stalecheck
