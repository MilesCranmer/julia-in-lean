def print_time_imports_report {Mod IO Color : Type} (o : LOps X Y E D CI CF V)
    (registry : ModuleRegistryOps o Mod) (origins : PkgOriginOps o V)
    (fixupStdlibPath : Bytes → Bytes) (ops : TimeImportsOps o Mod IO Color)
    (mod : Mod) (elapsedTime : U64 := JInt.lit .u64 1)
    (compTime : U64 := JInt.lit .u64 1) (recompTime : U64 := JInt.lit .u64 1) :
    LM o Unit := do
  let elapsed ← elapsedMilliseconds o ops elapsedTime
  ops.printText ops.stdout (ops.leftPad elapsed 9)
  ops.printText ops.stdout (lit " ms  ")
  match ← extension_parent_name o registry origins fixupStdlibPath mod with
  | none => pure ()
  | some (.str parentName) => ops.printText ops.stdout (parentName ++ lit " → ")
  | some _ => throwL o .typeError
  ops.printText ops.stdout (ops.moduleString mod)
  if compTime.val > 0 then
    let percentage := timePercentage compTime elapsedTime
    let formatted ← ops.writeFixed percentage 2
    ops.printStyled ops.stdout (lit " " ++ formatted ++ lit "% compilation time") ops.infoColor
  if recompTime.val > 0 then
    let percentage := timePercentage recompTime compTime
    let recompText ← if JuliaLean.base.float.lt_IEEEFloat percentage
        (JuliaLean.base.float.floatOfInt .f64 (JInt.lit .u64 1)) then
        pure (lit "<1")
      else
        ops.writeFixed percentage 0
    ops.printStyled ops.stdout
      (lit " (" ++ recompText ++ lit "% recompilation)") ops.warningColor
