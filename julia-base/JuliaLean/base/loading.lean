def explicit_manifest_entry_load_spec (o : LOps X Y E D CI CF V) (manifest_file : Bytes) (pkg : PkgId)
    (entry : TOMLDictRef) : LM o SpecResult := do
  -- Resolve syntax version. N.B.: Unlike in project files, an absent syntax.julia_version
  -- entry in manifest files means defaulting to 1.13. This is because we assume the
  -- manifest was created by an older version of julia that did not support syntax versioning.
  -- Newer versions of Pkg will provide syntax version information in the manifest,
  -- even if absent from the project file.
  let mut edition := o.OLDEST_EDITION
  let syntax_table ← tget o entry (lit "syntax")
  if let some syntax_table := syntax_table then
    edition ← liftL o (o.EditionNumber (← liftL o (o.VersionNumber_val (← anyGet o syntax_table (lit "julia_version")))))
    -- Clamp to minimum supported syntax version
    if o.version_le (← liftL o (o.VersionNumber_edition edition)) (← liftL o (o.VersionNumber_edition o.OLDEST_EDITION)) then
      edition := o.OLDEST_EDITION
  -- Resolve path
  let path ← asStringOpt o (← tget o entry (lit "path"))
  let entryfile ← asStringOpt o (← tget o entry (lit "entryfile"))
  match path with
  | some path =>
    let path ← entry_path o (← normpath o (← abspath2 o (← dirname o manifest_file) path)) pkg.name entryfile
    return .spec (PkgLoadSpec_new path edition)
  | none =>
    let hash ← asStringOpt o (← tget o entry (lit "git-tree-sha1"))
    match hash with
    | none =>
      -- stdlibs do not have a git-hash so cannot be loaded from depots. As
      -- a special case, we allow loading these directly from the stdlib location
      -- (treated as an implicit environment).
      let mbyspec ← manifest_uuid_load_spec o o.STDLIB pkg
      match mbyspec with
      | .spec s =>
        if (← isfile o s.path) then return .spec s
        return .nothing
      | _ => return .nothing
    | some hash =>
      let hash ← liftL o (SHA_String o 20 hash)
      -- Keep the 4 since it used to be the default
      let uuid ← match pkg.uuid with
        | some u => pure u
        | none => throwL o .typeError -- checked within `explicit_manifest_uuid_path`
