def sort_lt (a b : CacheCandidateSortKey) : Bool :=
  if a.pkgimage != b.pkgimage then !a.pkgimage && b.pkgimage
  else JuliaLean.base.float.lt_IEEEFloat a.mtime b.mtime

def cacheSortKeysLoop (o : LOps X Y E D CI CF V) (candidates : CacheCandidates) :
    List JInt64 → LM o (List CacheCandidateSortKey)
  | [] => pure []
  | index :: rest => do
    let key ← sort_by o candidates index
    let rest ← cacheSortKeysLoop o candidates rest
    return key :: rest

def cacheCandidatePermute {A : Type} (o : LOps X Y E D CI CF V) (items : List A) :
    List JInt64 → LM o (List A)
  | [] => pure []
  | index :: rest => do
    if index.val < 1 then throwL o .boundsError
    let item ← match items[index.val.toNat - 1]? with
      | some item => pure item
      | none => throwL o .boundsError
    let rest ← cacheCandidatePermute o items rest
    return item :: rest

def cacheCandidateEntriesLoop (o : LOps X Y E D CI CF V) (ops : CacheCandidateOps o)
    (pkg : PkgId) (dir entryFile : Bytes) (entries : List Bytes) (usePkgimages : Bool) :
    List Bytes → LM o CacheCandidates
  | [] => pure []
  | file :: rest => do
    let isCacheFile ← match pkg.uuid with
      | none => pure (file == entryFile ++ lit ".ji")
      | some _ => do
        let matchesPrefix ← startswith o file (entryFile ++ lit "_")
        pure (matchesPrefix && cacheBytesEndsWith file (lit ".ji"))
    if !isCacheFile then
      cacheCandidateEntriesLoop o ops pkg dir entryFile entries usePkgimages rest
    else
      let path ← joinpath o [dir, file]
      let hasPkgimage := usePkgimages &&
        entries.any (· == ocachefile_from_cachefile ops file)
      let remaining ← cacheCandidateEntriesLoop o ops pkg dir entryFile entries usePkgimages rest
      return (path, hasPkgimage) :: remaining

