-- `ExtensionId` is the structure above. `EXT_PRIMED` is `World.ext_primed`; `EXT_DORMITORY` is
-- `World.ext_dormitory` and `EXT_DORMITORY_FAILED` is `World.ext_dormitory_failed`, which hold
-- indices into `World.ext_ids`; all three start empty.
def ExtensionId_new (id parentid : PkgId) (n_total_triggers ntriggers : JInt64) : ExtensionId :=
  ⟨id, parentid, n_total_triggers, ntriggers⟩

/-- `push!(get!(Vector{ExtensionId}, EXT_DORMITORY, key), gid)`. -/
def dormitory_push (o : LOps X Y E D CI CF V) (key : PkgId) (gid : Nat) : LM o Unit :=
  modifyW o fun w => { w with ext_dormitory := w.ext_dormitory.set key (((w.ext_dormitory.get key).getD []) ++ [gid]) }

/-- The `for trigger in triggers` loop of `_insert_extension_triggers`; `trigger_ids` is the
vector stored in `EXT_PRIMED[extid]`. -/
def ext_triggers_loop (o : LOps X Y E D CI CF V) (extid : PkgId) (totaldeps : TOMLDictRef) (gid : Nat)
    (trigger_ids : List PkgId) : List Bytes → LM o Unit
  | [] => pure ()
  | trigger :: rest => do
    -- TODO: Better error message if this lookup fails?
    let uuid_trigger ← UUIDof o (← asString o (← tgetindex o totaldeps trigger))
    let trigger_id := JuliaLean.base.pkgid.PkgId_UUID id uuid_trigger trigger
    let trigger_ids := trigger_ids ++ [trigger_id]
    modifyW o fun w => { w with ext_primed := w.ext_primed.set extid trigger_ids }
    let w ← getW o
    if !w.loaded_modules.contains trigger_id || w.package_locks.contains trigger_id then
      dormitory_push o trigger_id gid
    else
      modifyW o fun w => { w with ext_ids := List.mapIdx (fun i e =>
        if i == gid then { e with ntriggers := JInt.wrap .i64 (e.ntriggers.val - 1) } else e) w.ext_ids }
    ext_triggers_loop o extid totaldeps gid trigger_ids rest

/-- The `for (ext, triggers) in extensions` loop of `_insert_extension_triggers`. -/
def ext_extensions_loop (o : LOps X Y E D CI CF V) (parent : PkgId) (totaldeps : TOMLDictRef) :
    List (Bytes × Val X) → LM o Unit
  | [] => pure ()
  | (ext, triggers) :: rest => do
    let triggers ← asExtsArg o triggers
    let triggers := match triggers with
      | .str s => [s]
      | .strs ss => ss
    let pu ← match parent.uuid with
      | some u => pure u
      | none => throwL o .typeError
    let extid := JuliaLean.base.pkgid.PkgId_UUID id (uuid5 o pu ext) ext
    let w ← getW o
    if (w.ext_primed.get extid).isSome || w.loaded_modules.contains extid then
      -- extension is already primed or loaded, don't add it again
      ext_extensions_loop o parent totaldeps rest
    else
      modifyW o fun w => { w with ext_primed := w.ext_primed.set extid [parent] }
      let n := JInt.wrap .i64 (1 + triggers.length)
      let gid := (← getW o).ext_ids.length
      modifyW o fun w => { w with ext_ids := w.ext_ids ++ [ExtensionId_new extid parent n n] }
      dormitory_push o parent gid
      ext_triggers_loop o extid totaldeps gid [parent] triggers
      ext_extensions_loop o parent totaldeps rest

