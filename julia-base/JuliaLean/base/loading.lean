  let syntaxVersion ← ops.readU8 stream
  let modules ← read_module_list o ops stream false
  let totalBytes ← ops.u64ToI64 (← ops.readU64 stream)
  let (includes, requiredPackages, totalBytes) ←
    readCacheDependenciesLoop o ops stream modules totalBytes [] []
  let preferencesLength ← ops.readI32 stream
  let totalBytes := JuliaLean.base.int.sub totalBytes (i64 4)
  let preferencesBlob ← ops.readBytes stream (JInt.wrap .i64 preferencesLength.val)
  let totalBytes := JuliaLean.base.int.sub totalBytes (JInt.wrap .i64 preferencesLength.val)
  let sourceTextPosition ← ops.readI64 stream
  let totalBytes := JuliaLean.base.int.sub totalBytes (i64 8)
  if totalBytes.val != 0 then
    let buffer ← liftPath o ((JuliaLean.base.intfuncs.dec Subtype.val
      JuliaLean.base.intfuncs.unsignedDivrem
      (fun x pad => do
        let count ← JuliaLean.base.intfuncs.ndigitsPositiveBits x (i64 10)
        pure (i64 (max pad.val count.val)))
      (JuliaLean.base.int.remT .u64)
      (JuliaLean.base.intfuncs.unsignedAbs totalBytes) (i64 0)
      (decide (totalBytes.val < 0))).mapError JuliaLean.base.path.PathError.system)
    let number := buffer.bytes.map UInt8.ofNat
    throwL o (.assertionError (ops.bytesToString (lit "header of cache file appears to be corrupt (totbytes == " ++
      number ++ lit ")")))
  let requiredModules ← read_module_list o ops stream true
  let cloneTargetsLength ← ops.readI32 stream
  let cloneTargets ← ops.readBytes stream (JInt.wrap .i64 cloneTargetsLength.val)
  let srcfiles ← srctext_files o ops stream sourceTextPosition includes
  return ⟨modules, includes, [], srcfiles, requiredPackages, requiredModules,
    sourceTextPosition, preferencesBlob, cloneTargets, flags, syntaxVersion⟩

abbrev IndexedCacheIncludes := List (Nat × CacheHeaderIncludes)
def indexCacheIncludes : Nat → List CacheHeaderIncludes → IndexedCacheIncludes
  | _, [] => []
  | index, «include» :: rest => (index, «include») :: indexCacheIncludes (index + 1) rest


def partitionCacheIncludes (srcfiles : List Bytes) :
    Nat → List CacheHeaderIncludes → IndexedCacheIncludes × IndexedCacheIncludes
  | _, [] => ([], [])
  | index, «include» :: rest =>
    let (sourceIncludes, dependencyIncludes) := partitionCacheIncludes srcfiles (index + 1) rest
    if srcfiles.contains «include».filename then
      ((index, «include») :: sourceIncludes, dependencyIncludes)
    else
      (sourceIncludes, (index, «include») :: dependencyIncludes)

def relocatableCacheSources (o : LOps X Y E D CI CF V) (depotTag : Bytes) :
    List Bytes → LM o (List Bytes × Bool)
  | [] => pure ([], false)
  | source :: rest => do
    let (relocatable, anyNotRelocatable) ← relocatableCacheSources o depotTag rest
    if ← startswith o source depotTag then
      return (source :: relocatable, anyNotRelocatable)
    else
      return (relocatable, true)

def cacheSourcesExistInDepot (o : LOps X Y E D CI CF V) (depot : Bytes) :
    List Bytes → LM o Bool
  | [] => pure true
  | source :: rest => do
    if !(← liftL o (o.fs.ispath (← restore_depot_path o source depot))) then return false
    cacheSourcesExistInDepot o depot rest

def findCacheSourceDepot (o : LOps X Y E D CI CF V) (sources : List Bytes) :
    List Bytes → LM o (Option Bytes)
  | [] => pure none
  | depot :: rest => do
    if ← cacheSourcesExistInDepot o depot sources then return some depot
    findCacheSourceDepot o sources rest

def scanCacheSourceDepots (o : LOps X Y E D CI CF V) (sources : List Bytes)
    (found : Option CacheDepotResolution) (missing multiple : Bool) :
    LM o (Bool × Bool) := do
  match sources with
  | [] => return (missing, multiple)
  | source :: rest =>
    let depot ← resolve_depot o source
    if depot == .noDepotFound then
      scanCacheSourceDepots o rest found true multiple
    else
      match found with
      | none => scanCacheSourceDepots o rest (some depot) missing multiple
      | some previous =>
        scanCacheSourceDepots o rest found missing (multiple || depot != previous)

def restoreIndexedCacheIncludes (o : LOps X Y E D CI CF V) (depot : Bytes) :
    IndexedCacheIncludes → LM o IndexedCacheIncludes
  | [] => pure []
  | (index, «include») :: rest => do
    let filename ← restore_depot_path o «include».filename depot
    return (index, { «include» with filename }) :: (← restoreIndexedCacheIncludes o depot rest)

def resolveDependencyCacheIncludes {Stream : Type} (o : LOps X Y E D CI CF V)
    (ops : CacheIOOps o Stream) (cachefile : Bytes) (hint : Option Bytes) :
    IndexedCacheIncludes → LM o IndexedCacheIncludes
  | [] => pure []
  | (index, «include») :: rest => do
    let depot ← resolve_depot o «include».filename hint
    let «resolvedInclude» ← match depot with
      | .noDepotFound =>
        ops.logDebug (lit "Unable to resolve @depot tag for include_dependency() file " ++
          «include».filename ++ lit " from cache file " ++ cachefile)
        pure «include»
      | .notRelocatable =>
        ops.logDebug (lit "include_dependency() file " ++ «include».filename ++ lit " from " ++
          cachefile ++ lit " is not relocatable")
        pure «include»
      | .found depot => do
        let filename ← restore_depot_path o «include».filename depot
        pure { «include» with filename }
    return (index, «resolvedInclude») :: (← resolveDependencyCacheIncludes o ops cachefile hint rest)

def indexedCacheInclude (index : Nat) : IndexedCacheIncludes → Option CacheHeaderIncludes
  | [] => none
  | (candidate, «include») :: rest =>
    if index == candidate then some «include» else indexedCacheInclude index rest

def rebuildCacheIncludes (all sourceIncludes dependencyIncludes : IndexedCacheIncludes) :
    List CacheHeaderIncludes :=
  match all with
  | [] => []
  | (index, original) :: rest =>
    let resolved := match indexedCacheInclude index sourceIncludes with
      | some source => source
      | none => (indexedCacheInclude index dependencyIncludes).getD original
    resolved :: rebuildCacheIncludes rest sourceIncludes dependencyIncludes

