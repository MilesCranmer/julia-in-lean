def load_path_setup_code (o : LOps X Y E D CI CF V)
    (ops : LoadPathSetupOps o) (includeLoadPath : Bool := true) : LM o Bytes := do
  let depots ← (← ops.depotPath).mapM ops.abspath
  let dynamicLoadPath ← (← ops.dynamicLoadPath).mapM ops.abspath
  let mut code := lit "append!(empty!(Base.DEPOT_PATH), " ++ ops.reprStrings depots ++ lit ")\n" ++
    lit "append!(empty!(Base.DL_LOAD_PATH), " ++ ops.reprStrings dynamicLoadPath ++ lit ")\n"
  if includeLoadPath then
    let paths ← (← ops.loadPath).mapM ops.abspath
    let separator := if ← ops.isWindows then lit ";" else lit ":"
    if paths.any (fun path => ops.containsPathSeparator path separator) then
      throwL o (.errorExceptionBytes
        (lit "LOAD_PATH entries cannot contain '" ++ separator ++ lit "'"))
    let rendered := ops.reprStrings paths
    let joined := joinWithBytes separator paths
    code := code ++ lit "append!(empty!(Base.LOAD_PATH), " ++ rendered ++ lit ")\n" ++
      lit "ENV[\"JULIA_LOAD_PATH\"] = " ++ ops.reprString joined ++ lit "\n" ++
      lit "Base.set_active_project(nothing)\n"
  return code

