def _insert_extension_triggers (o : LOps X Y E D CI CF V) (parent : PkgId) (extensions totaldeps : TOMLDictRef) :
    LM o Unit := do
  ext_extensions_loop o parent totaldeps (o.toml.dict.pairs (← tableOf o extensions))

/-- The `for (dep_name, entries) in d` loop of `expand_deps_list` in `insert_extension_triggers`. -/
def expand_deps_loop (o : LOps X Y E D CI CF V) (deps' : List Bytes) (out : TOMLDictRef) :
    List (Bytes × Val X) → LM o Unit
  | [] => pure ()
  | (dep_name, entries) :: rest => do
    if !deps'.contains dep_name then
      expand_deps_loop o deps' out rest
    else
      let entries ← asVectorAny o entries
      match entries with
      | [entry] =>
        let entry ← asDict o entry
        let uuid ← asString o (← tgetindex o entry (lit "uuid"))
        tsetindex o out dep_name (.str uuid)
        expand_deps_loop o deps' out rest
      | _ => throwL o (.errorException "expected a single entry for dep_name in project_file")

/-- The closure `expand_deps_list(deps′::Vector{String})` of `insert_extension_triggers` over the
manifest's `d`. -/
def expand_deps_list (o : LOps X Y E D CI CF V) (d : TOMLDictRef) (deps' : List Bytes) : LM o TOMLDictRef := do
  let deps'_expanded ← tnew o
  expand_deps_loop o deps' deps'_expanded (o.toml.dict.pairs (← tableOf o d))
  return deps'_expanded

/-- `x::Union{Vector{String}, Dict{String,Any}}`, expanded to a `Dict` by `expand_deps_list`. -/
def expandedDeps (o : LOps X Y E D CI CF V) (d : TOMLDictRef) (x : Val X) : LM o TOMLDictRef := do
  match ← asStanza o (some x) with
  | .dict r => pure r
  | .names ns => expand_deps_list o d ns
  | .nothing => throwL o .typeError

/-- The `for entry in entries` loop of the manifest scan of `insert_extension_triggers(env, pkg)`:
`some true` continues with `insert_extension_triggers(Sys.STDLIB, pkg)`, `some false` returns. -/
def ext_manifest_entries_loop (o : LOps X Y E D CI CF V) (d : TOMLDictRef) (pkg : PkgId) :
    List (Val X) → LM o (Option Bool)
  | [] => pure none
  | entry :: rest => do
    let entry ← asDict o entry
    let uuid ← asStringOpt o (← tget o entry (lit "uuid"))
    match uuid with
    | none => ext_manifest_entries_loop o d pkg rest
    | some uuid =>
      if some (← UUIDof o uuid) == pkg.uuid then
        if (← tget o entry (lit "path")).isNone && (← tget o entry (lit "git-tree-sha1")).isNone then
          -- a stdlib entry is loaded from Sys.STDLIB (see `explicit_manifest_uuid_path`), and
          -- the manifest may have been resolved by a Julia version whose copy of the stdlib
          -- had different extensions, so take them from the stdlib's own Project.toml
          return some true
        let extensions ← asDictOpt o (← tget o entry (lit "extensions"))
        match extensions with
        | none => return some false
        | some extensions =>
          let weakdeps ← tgetOrNew o entry (lit "weakdeps")
          let deps ← tgetOrNew o entry (lit "deps")
          -- `::Union{Vector{String}, Dict{String,Any}}` of both, then `expand_deps_list`
          let _ ← asStanza o (some weakdeps)
          let _ ← asStanza o (some deps)
          let weakdeps ← expandedDeps o d weakdeps
          let deps ← expandedDeps o d deps
          let total_deps ← tmerge o weakdeps deps
          _insert_extension_triggers o pkg extensions total_deps
          return some false
      else
        ext_manifest_entries_loop o d pkg rest

/-- The `for (dep_name, entries) in d` loop of `insert_extension_triggers(env, pkg)`. -/
def ext_manifest_dict_loop (o : LOps X Y E D CI CF V) (d : TOMLDictRef) (pkg : PkgId) :
    List (Bytes × Val X) → LM o (Option Bool)
  | [] => pure none
  | (_dep_name, entries) :: rest => do
    let entries ← asVectorAny o entries
    match ← ext_manifest_entries_loop o d pkg entries with
    | some r => return some r
    | none => ext_manifest_dict_loop o d pkg rest

/-- The body of `insert_extension_triggers(env, pkg)` except its tail call: `true` when the method
continues with `insert_extension_triggers(Sys.STDLIB, pkg)`. -/
def insert_extension_triggers_step (o : LOps X Y E D CI CF V) (env : Bytes) (pkg : PkgId) : LM o Bool := do
  let project_file ← env_project_file o env
  -- `project_file isa String || project_file`
  if project_file == .inl false then return false
  let implicit_project_file ← match project_file with
    | .inr p => pure (some p)
    | .inl _ => do
      -- if env names a directory, search it for an implicit project file (for stdlibs)
      let r ← entry_point_and_project_file o env pkg.name
      pure r.2
  match implicit_project_file with
  | none => return false
  | some implicit_project_file =>
    -- Look in project for extensions to insert
    let proj_pkg ← project_file_name_uuid o implicit_project_file pkg.name
    if JuliaLean.base.pkgid.eq pkg proj_pkg then
      let d_proj ← parsed_toml o implicit_project_file
      let extensions ← asDictOpt o (← tget o d_proj (lit "extensions"))
      match extensions with
      | none => return false
      | some extensions =>
        let weakdeps ← asDict o (← tgetOrNew o d_proj (lit "weakdeps"))
        let deps ← asDict o (← tgetOrNew o d_proj (lit "deps"))
        let total_deps ← tmerge o weakdeps deps
        _insert_extension_triggers o pkg extensions total_deps
        return false
    -- Now look in manifest
    match project_file with
    | .inl _ => return false
    | .inr project_file =>
      let manifest_file ← project_file_manifest_path o project_file
      match manifest_file with
      | none => return false
      | some manifest_file =>
        let d ← get_deps o (← parsed_toml o manifest_file)
        let r ← ext_manifest_dict_loop o d pkg (o.toml.dict.pairs (← tableOf o d))
        return r.getD false

