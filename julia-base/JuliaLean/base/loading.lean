def run_module_init {Mod Reports IO Color : Type} (o : LOps X Y E D CI CF V)
    (ops : ModuleInitOps o Mod Reports) (timeOps : TimeImportsOps o Mod IO Color)
    (module : Mod) (index : JInt64 := i64 1) (reports : Option Reports := none) :
    LM o Unit := do
  if (← getW o).timing_imports == i64 0 then
    ops.initRestoredModule module
  else if ops.isDefinedInit module then
    let started := ← ops.timeNs
    ops.cumulativeCompileTiming true
    let compileStarted ← ops.cumulativeCompileTimeNs
    ops.initRestoredModule module
    let elapsed := u64SubWrap (← ops.timeNs) started
    ops.cumulativeCompileTiming false
    let (compileEnded, recompileEnded) ← ops.cumulativeCompileTimeNs
    let (compileStartedAt, recompileStartedAt) := compileStarted
    let compileTime := u64SubWrap compileEnded compileStartedAt
    let recompileTime := u64SubWrap recompileEnded recompileStartedAt
    match reports with
    | none =>
      print_time_imports_report_init o timeOps module index elapsed compileTime recompileTime
    | some sink =>
      ops.pushReport sink (module, index, elapsed, compileTime, recompileTime)

