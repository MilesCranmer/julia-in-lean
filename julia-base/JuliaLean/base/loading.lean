def touch_cachefile (o : LOps X Y E D CI CF V) (pkg : PkgId) (path : Bytes) : LM o Unit := do
  if (← getW o).depot_path.isEmpty then return
  let cacheDir ← compilecache_dir o pkg
  let cachePrefix ← joinpath o [cacheDir, []]
  if !(← startswith o path cachePrefix) then return
  let bundledPrefix ← joinpath o [← dirname o (← dirname o o.STDLIB), lit "compiled", []]
  if ← startswith o path bundledPrefix then return
  tryCatch (liftL o (o.fs.touch path)) (fun _ => pure ())

