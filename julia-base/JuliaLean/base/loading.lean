  let implicit_manifest := !(match project_file with | .inr _ => true | .inl _ => false)
  let mut project_file := project_file
  if implicit_manifest then
    if project_file == .inl false then return none
    match wh with
    | none =>
      -- Toplevel load with a directory (implicit manifest) - all we look for is the
      -- existence of the package name in the directory.
      let pkg ← implicit_manifest_pkgid o env name
      return pkg
    | some wh =>
      match ← implicit_manifest_project o env wh with
      | none => return none
      | some pf => project_file := .inr pf
  let pfile ← match project_file with
    | .inr pf => pure pf
    | .inl _ => throwL o .typeError
