  accessible : AccessibleFileOps (GenericM W L) (GenericValue L) (GenericValue L)
  splitdir : GenericValue L → GenericM W L (GenericValue L)
  indexedIterateFirst : GenericValue L → JInt .i64 → GenericM W L (GenericValue L)
  indexedIterateNext : GenericValue L → JInt .i64 → GenericValue L →
