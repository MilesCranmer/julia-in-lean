-- `TOML.Parser{nothing}()` and an empty dictionary.
def TOMLCache_initial (p : Parser X D CI CF) : Parser X D CI CF × AMap Bytes CachedTOMLDict := (p, [])

/-- Mutable-object fields in the caller's store; shared field references preserve aliases. -/
structure TOMLField (S A : Type) where
  get : S → A
  set : A → S → S

structure TOMLCacheRef (S X D CI CF : Type) where
  parser : TOMLField S (Parser X D CI CF)
  dictionary : TOMLField S (AMap Bytes (TOMLField S CachedTOMLDict))

abbrev TCM (_o : LOps X Y E D CI CF V) (S A : Type) :=
  ExceptT (LErr E) (StateT S Option) A

structure TOMLMemory (o : LOps X Y E D CI CF V) (S : Type) where
  context : S → World X D CI CF
  loadingCache : TOMLField S (Option (TOMLField S LoadingCache))
  /-- Raw allocation of the mutable CachedTOMLDict object. -/
  allocateFile : CachedTOMLDict → TCM o S (TOMLField S CachedTOMLDict)

def tomlReadField {S A : Type} (o : LOps X Y E D CI CF V)
    (field : TOMLField S A) : TCM o S A := do
  return field.get (← get)

def tomlWriteField {S A : Type} (o : LOps X Y E D CI CF V)
    (field : TOMLField S A) (value : A) : TCM o S Unit :=
  modify (field.set value)

/-- Select the supplied parser while running the installed constructor body. -/
def cachedTOMLDictAt {S : Type} (o : LOps X Y E D CI CF V) (memory : TOMLMemory o S)
    (parser : TOMLField S (Parser X D CI CF)) (path : Bytes) :
    TCM o S (TOMLField S CachedTOMLDict) := do
  let record ← ExceptT.mk <| StateT.mk fun state => do
    let context := { memory.context state with toml_parser := parser.get state }
    let (result, after) ← StateT.run (ExceptT.run (CachedTOMLDict_new o path)) context
    pure (result, parser.set after.toml_parser state)
  memory.allocateFile record

/-- The refresh body runs with the supplied parser and file object. Its field
updates, including updates before an exception, reach every alias of that file. -/
def updatedTOMLDictAt {S : Type} (o : LOps X Y E D CI CF V) (memory : TOMLMemory o S)
    (parser : TOMLField S (Parser X D CI CF)) (file : TOMLField S CachedTOMLDict) :
    TCM o S TOMLDictRef :=
  ExceptT.mk <| StateT.mk fun state => do
    let record := file.get state
    let context := { memory.context state with toml_parser := parser.get state, toml_cache := (memory.context state).toml_cache.set record.path record }
    let (result, after) ← StateT.run (ExceptT.run (get_updated_dict o record.path record)) context
    let state := parser.set after.toml_parser state
    let state := file.set ((after.toml_cache.get record.path).getD record) state
    pure (result, state)

def withTOMLLock {S A : Type} (o : LOps X Y E D CI CF V) (lock : TOMLField S Nat)
    (body : TCM o S A) : TCM o S A :=
  ExceptT.mk <| StateT.mk fun state => do
    let state := lock.set (lock.get state + 1) state
    let (result, state) ← StateT.run (ExceptT.run body) state
    let state := lock.set (lock.get state - 1) state
    pure (result, state)

/-- Calls selected by the AbstractString argument's concrete type. String keys
use the installed constructor and the native dictionary/set representation below. -/
structure TOMLKeyOps (o : LOps X Y E D CI CF V) (S Path : Type) where
  haskey : TOMLField S (AMap Bytes (TOMLField S CachedTOMLDict)) → Path → TCM o S Bool
  getindex : TOMLField S (AMap Bytes (TOMLField S CachedTOMLDict)) → Path → TCM o S (TOMLField S CachedTOMLDict)
  setindex : TOMLField S (AMap Bytes (TOMLField S CachedTOMLDict)) → TOMLField S CachedTOMLDict → Path → TCM o S Unit
  construct : TOMLField S (Parser X D CI CF) → Path → TCM o S (TOMLField S CachedTOMLDict)
  containsParsed : TOMLField S LoadingCache → Path → TCM o S Bool
  pushParsed : TOMLField S LoadingCache → Path → TCM o S Unit

