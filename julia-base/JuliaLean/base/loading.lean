def list_reasons (o : LOps X Y E D CI CF V) (text : ReasonTextOps o)
    (reasons : AMap Bytes JInt64) (orderedPairs : AMap Bytes JInt64 → List (Bytes × JInt64))
    (full : Bool := false) : LM o Bytes := do
  if reasons.isEmpty then return []
  let mut actionable : List Bytes := []
  let mut wrongJulia := false
  let mut verbose : List Bytes := []
  for (key, count) in orderedPairs reasons do
    let (category, desc) := reject_reason key
    verbose := verbose ++ [text.intString count ++ lit " for " ++ desc]
    if category == .actionable then
      actionable := actionable ++ [desc]
    else if category == .wrongJulia then
      wrongJulia := true
  text.debug (lit "Caches not reused: " ++ text.join (lit ", ") verbose)
  if full then
    return lit " (cache not reused: " ++ text.join (lit ", ") (text.sort verbose) ++ lit ")"
  if !actionable.isEmpty then
    return lit " (cache not reused: " ++ text.join (lit ", ") (text.sort actionable) ++ lit ")"
  if wrongJulia then return lit " (no compatible cache for this version of Julia)"
  return []

