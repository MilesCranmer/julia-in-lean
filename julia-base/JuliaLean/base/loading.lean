def check_for_hint {Mod Symbol : Type} (o : LOps X Y E D CI CF V)
    (ops : CheckForHintOps o Mod Symbol) (into : Mod) (mod : Symbol) :
    LM o (Bool × Bytes) := do
  if ← ops.isDefined into mod then
    if ops.isModule (← ops.getField into mod) then return (true, lit ".")
  let parent := ops.parentModule into
  if ← ops.isDefined parent mod then
    if ops.isModule (← ops.getField parent mod) then return (true, lit "..")
  return (false, [])

