def run_extension_callbacks_pkgid (o : LOps X Y E D CI CF V)
    (ops : LoadingCallbacksOps o Callback) (pkgid : PkgId) : LM o Unit := do
  assert_havelock o
  let ids? := (← getW o).ext_dormitory.get pkgid
  match ids? with
  | none => return ()
  | some ids =>
      modifyW o fun world => {world with ext_dormitory := world.ext_dormitory.remove pkgid}
      let loadable ← ops.loadableExtensions
      let mut ready : List (Nat × ExtensionId) := []
      for index in ids do
        let extension ← extensionAtIndex o index
        if extension.ntriggers.val <= 0 then
          throwL o (.assertionError "extid.ntriggers > 0")
        let extension := {extension with ntriggers := JInt.wrap .i64 (extension.ntriggers.val - 1)}
        modifyW o fun world =>
          {world with ext_ids := world.ext_ids.mapIdx fun i old => if i == index then extension else old}
        if extension.ntriggers.val == 0 &&
            (loadable.isNone || (loadable.getD []).contains extension.id) then
          ready := ready ++ [(index, extension)]
      let sortedReady ← ops.sortExtensions ready
      for (index, extension) in sortedReady do
        if !(← run_extension_callbacks_extid o ops extension) then
          modifyW o fun world =>
            {world with ext_dormitory_failed := world.ext_dormitory_failed ++ [index]}
      return ()

