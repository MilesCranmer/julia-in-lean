def locate_package_env (o : LOps X Y E D CI CF V) (pkg : PkgId) (stopenv : Option Bytes := none) :
    LM o (Option (PkgLoadSpec × Bytes)) := do
  assert_havelock o
  let cache := (← getW o).loading_cache
  if let some c := cache then
    if let some specenv := c.located.get (pkg, stopenv) then
      return specenv
  let (env', spec) ← do
    if pkg.uuid.isNone then
      -- The project we're looking for does not have a Project.toml (n.b. - present
      -- `Project.toml` without UUID gets a path-based dummy UUID). It must have
      -- come from an implicit manifest environment, so go through those only.
      -- N.B.: Implicitly loaded packages do not participate in syntax versioning.
      let r ← locate_implicit_loop o pkg stopenv (← load_path o)
      pure (r.getD (none, none))
    else
      let r ← locate_explicit_loop o pkg stopenv (← load_path o)
      match r with
      | some r => pure r
      | none =>
        -- Allow loading of stdlibs if the name/uuid are given
        -- e.g. if they have been explicitly added to the project/manifest
        let mbyspec ← manifest_uuid_load_spec o o.STDLIB pkg
        match mbyspec with
        | .spec s => pure (some o.STDLIB, some s)
        | _ => pure (none, none)
  let mut spec := spec
  if let some s := spec then
    if !(← isfile_casesensitive o s.path) then
      spec := none
  -- `something(env′)` throws `ArgumentError` for `nothing`
  let specenv ← match spec with
    | none => pure none
    | some s => match env' with
      | some e => pure (some (s, e))
      | none => throwL o (.argumentError "No value arguments present")
  if cache.isSome then
    modifyCache o fun c => { c with located := c.located.set (pkg, stopenv) specenv }
  return specenv

