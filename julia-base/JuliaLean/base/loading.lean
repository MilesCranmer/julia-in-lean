def implicit_manifest_uuid_load_spec (o : LOps X Y E D CI CF V) (dir : Bytes) (pkg : PkgId) :
    LM o (Option PkgLoadSpec) := do
  let (path, project_file) ← entry_point_and_project_file o dir pkg.name
  match project_file with
  | none =>
    if pkg.uuid.isSome then return none
    -- Without a project file, treat as empty - which defaults to VERSION
    -- (`PkgLoadSpec(nothing, …)` has no `convert(String, nothing)` method)
    match path with
    | some path => return some (PkgLoadSpec_new path o.VERSION_EDITION)
    | none => throwL o (.methodError "convert")
  | some project_file =>
    let proj ← project_file_name_uuid o project_file pkg.name
    if !JuliaLean.base.pkgid.eq proj pkg then return none
    -- `entry_point_and_project_file` returns a `path` with every project file
    let path ← match path with
      | some path => pure path
      | none => throwL o (.methodError "convert")
    return some (PkgLoadSpec_new path (← project_get_edition o (← parsed_toml o project_file)))

