def translate_cache_flags (o : LOps X Y E D CI CF V) (text : CacheFlagTextOps o)
    (cacheflags defaultflags : CacheFlags) : LM o (List Bytes) := do
  let mut opts : List Bytes := []
  if cacheflags.use_pkgimages != defaultflags.use_pkgimages then
    opts := opts ++ [if cacheflags.use_pkgimages then lit "--pkgimages=yes" else lit "--pkgimages=no"]
  if cacheflags.debug_level != defaultflags.debug_level then
    opts := opts ++ [lit "-g" ++ text.intString cacheflags.debug_level]
  if cacheflags.check_bounds != defaultflags.check_bounds then
    let index := JuliaLean.base.int.add_int cacheflags.check_bounds (i64 1)
    if index.val <= 0 then throwL o .boundsError
    let choices := [lit "--check-bounds=auto", lit "--check-bounds=yes", lit "--check-bounds=no"]
    match choices[(index.val - 1).toNat]? with
    | some value => opts := opts ++ [value]
    | none => throwL o .boundsError
  if cacheflags.inline != defaultflags.inline then
    opts := opts ++ [if cacheflags.inline then lit "--inline=yes" else lit "--inline=no"]
  if cacheflags.opt_level != defaultflags.opt_level then
    opts := opts ++ [lit "-O" ++ text.intString cacheflags.opt_level]
  if cacheflags.coverage != defaultflags.coverage ||
      cacheflags.coverage_path != defaultflags.coverage_path then
    opts := opts ++ coverage_cache_options o cacheflags
  return opts

