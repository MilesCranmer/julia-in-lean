/-- Generic platform fallback, with lowering of two-target destructuring made
explicit: indexed_iterate at Int indices 1 and 2, first value/state projections,
and the second value projection only. No third iteration or extra state read is
introduced. The eager broadcast is materialized before `any`; an arbitrary final
result is returned unchanged. Native String/BitVector bindings are not supplied.
Julia source: base/loading.jl:77-81. -/
-- Source: base/loading.jl:77-81 @ f755f49a9e41380d7da126b3c1db9fe7f83dd027
--     function isfile_casesensitive(path)
--         isaccessiblefile(path) || return false
--         dir, filename = splitdir(path)
--         any(readdir(dir) .== filename)
--     end
-- /Source
def isFileCaseSensitiveGeneric {W L : Type} (ops : GenericCaseOps W L)
    (path : GenericValue L) : GenericM W L (DispatchValue (GenericValue L)) := do
  let accessible ← selectedAccessibleFile (E := GenericValue L) ops.accessible path
  match accessible with
  | .bool false => pure (.bool false)
  | .other _ => throw (DispatchError.typeError : DispatchError (GenericValue L))
  | .bool true => do
      let split ← ops.splitdir path
      let first ← ops.indexedIterateFirst split (JInt.lit .i64 1)
      let dir ← liftCoreAction (ops.core.getfield first
        (JuliaLean.base.boot.intV ops.core (JInt.lit .i64 1)))
      let state ← liftCoreAction (ops.core.getfield first
        (JuliaLean.base.boot.intV ops.core (JInt.lit .i64 2)))
      let second ← ops.indexedIterateNext split (JInt.lit .i64 2) state
      let filename ← liftCoreAction (ops.core.getfield second
        (JuliaLean.base.boot.intV ops.core (JInt.lit .i64 1)))
      let listing ← ops.readdir dir
      let broadcast ← ops.broadcasted .equality listing filename
      let materialized ← ops.materialize broadcast
      ops.any materialized

