def tryLockFile {World Object Handle RawFD Req CString Ptr Buffer RefByte Overlapped Regex Stat : Type}
    (ops : FileSystemOps World Object Handle RawFD Req CString Ptr Buffer RefByte Overlapped Regex Stat)
    (file : File Object) (shared : Bool := false) : M World Bool := do
  fileCheckOpen ops file
  let handle ← ops.access.handle file.object
  if ops.platform == .windows then
    let flags := if shared then lockFileFailImmediately
      else JuliaLean.base.int.or_int lockFileFailImmediately lockFileExclusive
    let status ← ops.runtime.lockFileEx handle flags ops.lockOverlapped
    if status.val != 0 then pure true
    else do
      let code ← ops.runtime.getLastError ()
      if code.val == errorLockViolation.val then pure false
      else eliminateEmpty (ops.errors.windowsError "trylockfile" code)
  else
    let flags := JuliaLean.base.int.or_int (if shared then lockShared else lockExclusive) lockNonblocking
    let status ← ops.runtime.flock handle flags
    if status.val == 0 then pure true
    else do
      let errno ← ops.errors.errno ()
      if errno.val == ops.errors.eagain.val then pure false
      else eliminateEmpty (ops.errors.systemErrorCurrent "trylockfile")
