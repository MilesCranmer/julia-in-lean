structure Overlapped (Ptr : Type) where
  internal : U64
  internalHigh : U64
  offset : U32
  offsetHigh : U32
  event : Ptr
  deriving Repr

def lockFileOverlapped {Ptr : Type} (nullPtr : Ptr) : Overlapped Ptr :=
  ⟨JInt.lit .u64 0, JInt.lit .u64 0, JInt.lit .u32 0xfffffffe,
    JInt.lit .u32 0x7fffffff, nullPtr⟩

def lockFileFailImmediately : U32 := JInt.lit .u32 0x1
def lockFileExclusive : U32 := JInt.lit .u32 0x2
def errorLockViolation : U32 := JInt.lit .u32 0x21
