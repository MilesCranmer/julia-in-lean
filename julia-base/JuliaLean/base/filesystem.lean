def fileClose {World Object Handle RawFD Req CString Ptr Buffer RefByte Overlapped Regex Stat : Type}
    (ops : FileSystemOps World Object Handle RawFD Req CString Ptr Buffer RefByte Overlapped Regex Stat)
    (file : File Object) : M World Unit := do
  if ← fileIsOpen ops file then
    ops.access.setOpen file.object false
    let handle ← ops.access.handle file.object
    let status ← ops.runtime.fsClose handle
    ops.access.setHandle file.object ops.invalidHandle
    ops.errors.uvError "close" status
  pure ()
