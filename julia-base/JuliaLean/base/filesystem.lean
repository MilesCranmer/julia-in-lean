def fileOpen {World Object Handle RawFD Req CString Ptr Buffer RefByte Overlapped Regex Stat P Flags Mode : Type}
    (ops : FileSystemOps World Object Handle RawFD Req CString Ptr Buffer RefByte Overlapped Regex Stat)
    (path : P) (flags : Flags) (mode : Mode) : M World (File Object) := do
  let request ← ops.runtime.malloc ops.uvFsRequestSize
  let handle ← JuliaLean.base.io.finallyDo (do
    let cpath ← ops.toCString path
    let cflags ← ops.toCInt flags
    let cmode ← ops.toCInt mode
    let status ← ops.runtime.uvFsOpen request cpath cflags cmode
    let result ← ops.runtime.uvFsGetResult request
    ops.runtime.reqCleanup request
    if status.val < 0 then
      let pathText ← ops.reprPath path
      let flagsText ← ops.showInteger flags
      let modeText ← ops.showInteger mode
      ops.errors.uvError ("open(" ++ pathText ++ ", " ++ flagsText ++ ", " ++ modeText ++ ")") status
    pure result) (ops.runtime.free request)
  let osHandle ← if ops.platform == .windows then do
    let pointer ← ops.ptrFromInt handle
    pure (ops.handleFromPtr pointer)
  else do
    let cHandle ← ops.toCInt handle
    pure (ops.handleFromCInt cHandle)
  fileFromHandle ops.access osHandle

def fileOpenDefault {World Object Handle RawFD Req CString Ptr Buffer RefByte Overlapped Regex Stat P Flags : Type}
    (ops : FileSystemOps World Object Handle RawFD Req CString Ptr Buffer RefByte Overlapped Regex Stat)
    (path : P) (flags : Flags) : M World (File Object) :=
  fileOpen ops path flags (JInt.lit .i64 0)
/--
