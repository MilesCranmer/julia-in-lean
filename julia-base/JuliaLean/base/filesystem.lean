def readChar {World Object Handle RawFD Req CString Ptr Buffer RefByte Overlapped Regex Stat : Type}
    (ops : FileSystemOps World Object Handle RawFD Req CString Ptr Buffer RefByte Overlapped Regex Stat)
    (file : File Object) (isEof : File Object → M World Bool)
    (position : File Object → M World I64)
    (seek : File Object → I64 → M World (File Object)) : M World U32 := do
  let firstByte ← readUInt8 ops file
  let leading := JuliaLean.base.int.leading_ones_Integer
    JuliaLean.base.int.leading_zeros JuliaLean.base.int.not_int firstByte
  let leading ← ops.toUInt8 leading
  let initial := JuliaLean.base.int.shl_int (JInt.wrap .u32 firstByte.val) (JInt.lit .u32 24)
  if 2 ≤ leading.val && leading.val ≤ 4 then
    let minimumShift := 8 * (4 - leading.val)
    let step (state : U32 × Int) : M World (Sum (U32 × Int) (U32 × Int)) := do
      let (current, shift) := state
      if shift < minimumShift then pure (.inl state)
      else if ← isEof file then pure (.inl state)
      else do
        let previousPosition ← position file
        let nextByte ← readUInt8 ops file
        let marker := JuliaLean.base.int.and_int nextByte (JInt.lit .u8 0xc0)
        if marker.val != (JInt.lit .u8 0x80).val then
          let _ ← seek file previousPosition
          pure (.inl state)
        else
          let shifted := JuliaLean.base.int.shl_int (JInt.wrap .u32 nextByte.val) (JInt.lit .u32 shift)
          pure (.inr (JuliaLean.base.int.or_int current shifted, shift - 8))
    let (result, _) ← JuliaLean.base.io.whileLoop step (initial, 16)
    pure result
  else
    pure initial
