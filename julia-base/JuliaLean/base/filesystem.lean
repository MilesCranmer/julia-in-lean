def unlockFile {World Object Handle RawFD Req CString Ptr Buffer RefByte Overlapped Regex Stat : Type}
    (ops : FileSystemOps World Object Handle RawFD Req CString Ptr Buffer RefByte Overlapped Regex Stat)
    (file : File Object) : M World Unit := do
  fileCheckOpen ops file
  let handle ← ops.access.handle file.object
  if ops.platform == .windows then
    let status ← ops.runtime.unlockFileEx handle ops.lockOverlapped
    if status.val == 0 then
      let code ← ops.runtime.getLastError ()
