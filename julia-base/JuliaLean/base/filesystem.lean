def sendFile {World Object Handle RawFD Req CString Ptr Buffer RefByte Overlapped Regex Stat : Type}
    (ops : FileSystemOps World Object Handle RawFD Req CString Ptr Buffer RefByte Overlapped Regex Stat)
    (dst src : File Object) (sourceOffset bytes : I64) : M World Unit := do
  fileCheckOpen ops dst
  fileCheckOpen ops src
  let step (state : I64 × I64) : M World (Sum Unit (I64 × I64)) := do
    let (offset, remaining) := state
    let sent := if remaining.val > ssizeMaximum.val then ssizeMaximum else remaining
    let sourceHandle ← ops.access.handle src.object
    let destinationHandle ← ops.access.handle dst.object
    let size ← ops.toUInt64 sent
    let status ← ops.runtime.sendfile sourceHandle destinationHandle offset size
    ops.errors.uvError "sendfile" status
    let remaining := JuliaLean.base.int.sub_int remaining sent
    let offset := JuliaLean.base.int.add_int offset sent
    if remaining.val <= 0 then pure (.inl ()) else pure (.inr (offset, remaining))
  JuliaLean.base.io.whileLoop step (sourceOffset, bytes)
