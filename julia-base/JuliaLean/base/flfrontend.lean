# Model of `base/flfrontend.jl`

The hooks to the flisp frontend of Julia `f755f49a9e41380d7da126b3c1db9fe7f83d027`: `fl_parse` and
`fl_lower`. Values, the runtime world and the builtins are those of the installed `base/boot.jl`
model (`JuliaLean.base.boot`: `CoreM`, `CoreOps`). The C functions `jl_fl_parse` and
`jl_fl_lower` are typed operations of `FlfrontendOps` on the converted arguments; a `ccall`
argument of a declared C type `T` other than `Any` is first `Base.cconvert(T, x)` and then
`Base.unsafe_convert(T, ·)` of that, all `cconvert`s before the `unsafe_convert`s, as the
lowering of `ccall` does. Calls of other generic functions (`!=`, `string`, `error`, `sizeof`,
`String`, `typemax`, the conversions) are `CoreOps.call` of the function, dispatched when they
run.
-/

namespace JuliaLean.base.flfrontend

open JuliaLean
open JuliaLean.base.expr (Value Sym)
open JuliaLean.base.boot (CoreM CoreOps)

/-- The operations of this file beyond the `Core` ones. -/
structure FlfrontendOps (W L : Type) extends CoreOps W L where
  /-- The value of the binding `Base.name`. -/
  baseFn : String → L
  /-- `jl_fl_parse(text, text_len, filename, lineno, offset, options)` on the converted
  arguments. -/
  flParse : List (Value L) → CoreM W L (Value L)
  /-- `jl_fl_lower(ex, mod, filename, lineno, world, warn)` on the converted arguments. -/
  flLower : List (Value L) → CoreM W L (Value L)

section
variable {W L : Type} (ops : FlfrontendOps W L)

/-- `Base.name` as a value. -/
def bV (name : String) : Value L := .leaf (ops.baseFn name)

/-- A call `Base.name(args...)`. -/
def callB (name : String) (args : List (Value L)) : CoreM W L (Value L) :=
  ops.call (bV ops name) args

/-- A `String` value. -/
def sV (s : String) : Value L := .leaf (ops.str s)

/-- An `Int` value. -/
def iV (n : Int) : Value L := .leaf (ops.int (JInt.lit .i64 n))

/-- The condition of an `if`: a `Bool`, otherwise the runtime's `TypeError(:if, "", Bool, x)`. -/
def cond (x : Value L) : CoreM W L Bool :=
  match x with
  | .leaf l => match ops.asBool l with
    | some b => pure b
    | none => JuliaLean.base.boot.throwTypeError ops.toCoreOps "if" "" (.leaf (ops.core "Bool")) x
  | _ => JuliaLean.base.boot.throwTypeError ops.toCoreOps "if" "" (.leaf (ops.core "Bool")) x

/-- `a, b = x` as lowered: `indexed_iterate(x, 1)`, then `indexed_iterate(x, 2, state)`. -/
def destructure2 (x : Value L) : CoreM W L (Value L × Value L) := do
  let t1 ← callB ops "indexed_iterate" [x, iV ops 1]
  let a ← ops.getfield t1 (iV ops 1)
  let state ← ops.getfield t1 (iV ops 2)
  let t2 ← callB ops "indexed_iterate" [x, iV ops 2, state]
  let b ← ops.getfield t2 (iV ops 1)
  pure (a, b)

/-- The C type `Ptr{UInt8}`. -/
def ptrUInt8 : CoreM W L (Value L) := ops.applyType (.leaf (ops.core "Ptr")) [bV ops "UInt8"]

/-- The arguments a `ccall` passes for the values `args` of the declared C types `types`
(`none` is `Any`, passed as is). -/
def ccallArgs (args : List (Value L × Option (Value L))) : CoreM W L (List (Value L)) := do
  let mut converted : List (Value L) := []
  for (x, T) in args do
    match T with
    | some T => converted := converted ++ [← callB ops "cconvert" [T, x]]
    | none => converted := converted ++ [x]
  let mut out : List (Value L) := []
  for ((_, T), c) in args.zip converted do
    match T with
    | some T => out := out ++ [← callB ops "unsafe_convert" [T, c]]
    | none => out := out ++ [c]
  pure out

