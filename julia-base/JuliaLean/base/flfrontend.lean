def fl_parse_String (text filename lineno offset options edition : Value L) :
    CoreM W L (Value L) := do
  let VERSION_EDITION : Value L := .leaf (ops.core "VERSION_EDITION")
  if ← cond ops (← callB ops "!=" [edition, VERSION_EDITION]) then
    let _ ← callB ops "error" [← callB ops "string" [sV ops "Edition ", edition,
      sV ops " not supported by flisp parser (", VERSION_EDITION, sV ops ")"]]
  let (text, text_len) ← if ops.isa text (.leaf (ops.core "SimpleVector")) then do
      destructure2 ops text
    else do pure (text, ← callB ops "sizeof" [text])
  let csize := bV ops "Csize_t"
  ops.flParse (← ccallArgs ops [(text, some (← ptrUInt8 ops)), (text_len, some csize),
    (filename, none), (lineno, some csize), (offset, some csize), (options, none)])

