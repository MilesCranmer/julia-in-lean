def fl_lower (ex mod filename lineno world warn : Value L) : CoreM W L (Value L) := do
  let csize := bV ops "Csize_t"
  let cint := bV ops "Cint"
  ops.flLower (← ccallArgs ops [(ex, none), (mod, none), (filename, some (← ptrUInt8 ops)),
    (lineno, some cint), (world, some csize), (warn, some cint)])
def fl_lower5 (ex mod filename lineno world : Value L) : CoreM W L (Value L) :=
  fl_lower ops ex mod filename lineno world (.leaf (ops.ofBool false))
def fl_lower4 (ex mod filename lineno : Value L) : CoreM W L (Value L) := do
  fl_lower5 ops ex mod filename lineno (← callB ops "typemax" [bV ops "Csize_t"])
def fl_lower3 (ex mod filename : Value L) : CoreM W L (Value L) :=
  fl_lower4 ops ex mod filename (iV ops 0)
def fl_lower2 (ex mod : Value L) : CoreM W L (Value L) :=
  fl_lower3 ops ex mod (sV ops "none")

end

