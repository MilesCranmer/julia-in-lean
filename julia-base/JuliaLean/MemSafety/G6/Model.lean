import JuliaLean.Core
import JuliaLean.Strings
import JuliaLean.ReinterpretArrays

/-!
Executable bounds models for the unchecked accesses in `memsafety/sites-6.tsv`.

Every model below computes an access index from the enclosing Julia function's inputs. A
failed Julia check is represented by no access. Loop indices are generated by the same loop
bounds as the Julia source. External C results are represented by their documented result
type: one object for `uv_fs_statfs` and `cglobal`, an MPFR buffer of the size returned by MPFR,
and a PCRE ovector with two slots per match or capture.
-/

namespace JuliaLean.MemSafety.G6

open JuliaLean

def inBounds (len : Nat) (i : Int) : Prop := 1 ≤ i ∧ i ≤ len

def checkedIndex (len : Nat) (i : Int) : Option Int :=
  if 1 ≤ i ∧ i ≤ len then some i else none

def span (first count : Nat) : List Int :=
  (List.range count).map fun k => (first + k : Nat)

theorem mem_span {first count : Nat} {i : Int} (h : i ∈ span first count) :
    ∃ k < count, i = first + k := by
  unfold span at h
  rw [List.mem_map] at h
  obtain ⟨k, hk, rfl⟩ := h
  exact ⟨k, List.mem_range.mp hk, by omega⟩

/-! ## Runtime-owned pointer objects -/

/-- The success result of `uv_fs_statfs` is one complete `uv_statfs_t`, which `DiskStat`
mirrors field for field (`base/file.jl:1662-1713`). The branch on the return code is included:
an error performs no load and success loads object zero. -/
def diskstatLoad (uvSucceeded : Bool) : Option (Nat × Nat) :=
  if uvSucceeded then some (0, 1) else none

def DiskstatPointerLoadInBounds : Prop :=
  ∀ ok offset objects, diskstatLoad ok = some (offset, objects) → offset < objects

theorem diskstatPointerLoadInBounds_proven : DiskstatPointerLoadInBounds := by
  intro ok offset objects h
  unfold diskstatLoad at h
  split at h <;> simp_all <;> omega

/-- `cglobal(:jl_default_debug_info_kind, Cint)` denotes one `Cint`; `unsafe_load` reads its
zero offset (`base/reflection.jl:90`, `src/jl_exported_data.inc`). -/
inductive DebugInfoGlobal where
  | runtimeOwned

def reflectionGlobalLoad (_ : DebugInfoGlobal) : Nat × Nat := (0, 1)

def ReflectionGlobalLoadInBounds : Prop :=
  ∀ global : DebugInfoGlobal, (reflectionGlobalLoad global).1 < (reflectionGlobalLoad global).2

theorem reflectionGlobalLoadInBounds_proven : ReflectionGlobalLoadInBounds := by
  intro global
  cases global
  unfold reflectionGlobalLoad
  omega

/-! ## GenericMemory checked callers -/

inductive MemorySide where
  | source
  | destination
  deriving DecidableEq, Repr

structure MemoryAccess where
  side : MemorySide
  index : Int
  deriving DecidableEq, Repr

/-- `isassigned(a, i)` at `base/genericmemory.jl:189-192`: the access occurs only after
`checkbounds(Bool, a, i)` succeeds. -/
def isassignedAccess (len : Nat) (i : Int) : List MemoryAccess :=
  match checkedIndex len i with
  | some j => [⟨.source, j⟩]
  | none => []

/-- `copy(a::Memory)` at `base/genericmemory.jl:257-262`: both memories have `length(a)` and
the unsafe copy starts at one for exactly that many elements. -/
def copyMemoryAccesses (len : Nat) : List MemoryAccess :=
  (span 1 len).map (⟨.source, ·⟩) ++ (span 1 len).map (⟨.destination, ·⟩)

/-- Range assignment at `base/genericmemory.jl:346-353`. `checkbounds(A, I)` checks the
destination span and `setindex_shape_check(X, length(I))` checks the source length before the
nonempty branch calls `unsafe_copyto!`. -/
def setRangeAccesses (destLen srcLen first count : Nat) : List MemoryAccess :=
  if count = 0 then []
  else if first ≥ 1 ∧ first + count ≤ destLen + 1 ∧ srcLen = count then
    (span first count).map (⟨.destination, ·⟩) ++
      (span 1 count).map (⟨.source, ·⟩)
  else []

/-- Colon assignment at `base/genericmemory.jl:356-362`: the shape check requires
`length(X) == length(A)` and the nonempty branch copies that exact length. -/
def setColonAccesses (destLen srcLen : Nat) : List MemoryAccess :=
  if destLen = 0 then []
  else if srcLen = destLen then
    (span 1 destLen).map (⟨.destination, ·⟩) ++
      (span 1 destLen).map (⟨.source, ·⟩)
  else []

def accessInMemory (srcLen destLen : Nat) (a : MemoryAccess) : Prop :=
  match a.side with
  | .source => inBounds srcLen a.index
  | .destination => inBounds destLen a.index

def GenericMemoryCheckedAccessesInBounds : Prop :=
  (∀ len i a, a ∈ isassignedAccess len i → accessInMemory len 0 a) ∧
  (∀ len a, a ∈ copyMemoryAccesses len → accessInMemory len len a) ∧
  (∀ dl sl first count a, a ∈ setRangeAccesses dl sl first count →
    accessInMemory sl dl a) ∧
  (∀ dl sl a, a ∈ setColonAccesses dl sl → accessInMemory sl dl a)

theorem genericMemoryCheckedAccessesInBounds_proven :
    GenericMemoryCheckedAccessesInBounds := by
  constructor
  · intro len i a h
    unfold isassignedAccess at h
    unfold checkedIndex at h
    split at h <;> simp_all [accessInMemory, inBounds] <;> omega
  constructor
  · intro len a h
    unfold copyMemoryAccesses at h
    rw [List.mem_append] at h
    rcases h with h | h <;> rw [List.mem_map] at h <;>
      obtain ⟨i, hi, rfl⟩ := h <;> obtain ⟨k, hk, rfl⟩ := mem_span hi <;>
      simp [accessInMemory, inBounds] <;> omega
  constructor
  · intro dl sl first count a h
    unfold setRangeAccesses at h
    split at h
    · simp_all
    split at h
    · rename_i hv
      rw [List.mem_append] at h
      rcases h with h | h <;> rw [List.mem_map] at h <;>
        obtain ⟨i, hi, rfl⟩ := h <;> obtain ⟨k, hk, rfl⟩ := mem_span hi <;>
        simp [accessInMemory, inBounds] <;> omega
    · simp_all
  · intro dl sl a h
    unfold setColonAccesses at h
    split at h
    · simp_all
    split at h
    · rename_i heq
      rw [List.mem_append] at h
      rcases h with h | h <;> rw [List.mem_map] at h <;>
        obtain ⟨i, hi, rfl⟩ := h <;> obtain ⟨k, hk, rfl⟩ := mem_span hi <;>
        simp [accessInMemory, inBounds] <;> omega
    · simp_all

/-! ## MPFR storage -/

inductive BigFloatAbi where
  | lp64
  | win64
  deriving DecidableEq, Repr

def BigFloatAbi.limbBytes : BigFloatAbi → Nat
  | .lp64 => 8
  | .win64 => 4

def BigFloatAbi.headerLimbs : BigFloatAbi → Nat
  | .lp64 => 4
  | .win64 => 6

def BigFloatAbi.fieldSpans : BigFloatAbi → List (Nat × Nat)
  | .lp64 => [(0, 8), (8, 4), (16, 8), (24, 8)]
  | .win64 => [(0, 4), (4, 4), (8, 4), (16, 8)]

/-- `mpfr_custom_get_size(precision)` is a whole number of MPFR limbs. -/
def mpfrPayloadLimbs (abi : BigFloatAbi) (precision : Nat) : Nat :=
  (precision + 8 * abi.limbBytes - 1) / (8 * abi.limbBytes)

/-- Algebraic normal form of lines 156-158: `nb` payload bytes plus the aligned header,
rounded up to `sizeof(Limb)`. -/
def bigFloatAllocatedLimbs (abi : BigFloatAbi) (precision : Nat) : Nat :=
  abi.headerLimbs + mpfrPayloadLimbs abi precision

def fieldSpanInBounds (bytes : Nat) (field : Nat × Nat) : Prop :=
  field.1 + field.2 ≤ bytes

/-- `BigFloat(; precision)` throws before allocation when `precision < 1`; otherwise it writes
all four ABI fields at lines 165-168. -/
def bigFloatHeaderAccesses (abi : BigFloatAbi) (precision : Nat) : List (Nat × Nat) :=
  if precision < 1 then [] else abi.fieldSpans

/-- The payload writes of `BigFloat(::Float64)` at lines 330-370. The fast ccall branch and
zero/nonfinite branch perform no payload writes; otherwise both ABI branches fill payload
indices `1:nlimbs` (with different loop grouping on Win64). -/
def bigFloatFloat64PayloadAccesses
    (abi : BigFloatAbi) (precision : Nat) (finiteNonzero : Bool) : List Int :=
  if precision ≤ 53 ∨ !finiteNonzero then [] else span 1 (mpfrPayloadLimbs abi precision)

def BigFloatStorageAccessesInBounds : Prop :=
  (∀ abi precision field, field ∈ bigFloatHeaderAccesses abi precision →
      fieldSpanInBounds (abi.limbBytes * bigFloatAllocatedLimbs abi precision) field) ∧
  (∀ abi precision finiteNonzero i,
    i ∈ bigFloatFloat64PayloadAccesses abi precision finiteNonzero →
      inBounds (mpfrPayloadLimbs abi precision) i)

theorem bigFloatStorageAccessesInBounds_proven : BigFloatStorageAccessesInBounds := by
  constructor
  · intro abi precision field hf
    unfold bigFloatHeaderAccesses at hf
    split at hf
    · simp_all
    · rename_i hp
      cases abi <;> simp [BigFloatAbi.fieldSpans] at hf <;>
        rcases hf with rfl | rfl | rfl | rfl <;>
        simp [fieldSpanInBounds, BigFloatAbi.limbBytes, bigFloatAllocatedLimbs,
          BigFloatAbi.headerLimbs, mpfrPayloadLimbs] <;> omega
  · intro abi precision finiteNonzero i hi
    unfold bigFloatFloat64PayloadAccesses at hi
    split at hi
    · simp_all
    · obtain ⟨k, hk, rfl⟩ := mem_span hi
      simp [inBounds]
      omega

inductive MpfrPrintfResult where
  | failure
  | success (chars : Nat)
  deriving DecidableEq, Repr

/-- On success `mpfr_asprintf` returns the number of non-NUL bytes and owns `chars+1` bytes;
the loop at lines 1228-1231 scans `1:chars` and may store at the first comma. -/
def stringMpfrAccesses : MpfrPrintfResult → Nat × List Int
  | .failure => (0, [])
  | .success chars => (chars + 1, span 1 chars)

def StringMpfrAccessesInBounds : Prop :=
  ∀ result i, i ∈ (stringMpfrAccesses result).2 →
    inBounds (stringMpfrAccesses result).1 i

theorem stringMpfrAccessesInBounds_proven : StringMpfrAccessesInBounds := by
  intro result i hi
  cases result with
  | failure => simp [stringMpfrAccesses] at hi
  | success chars =>
      obtain ⟨k, hk, rfl⟩ := mem_span hi
      simp [stringMpfrAccesses, inBounds]
      omega

/-! ## Integer parser access envelope -/

inductive ParseWord where
  | small
  | bits64
  | bits128
  | generic
  deriving DecidableEq, Repr

def parserStart (bytes : List UInt8) (signed : Bool) : Nat :=
  if signed && (bytes.head? == some 0x2d || bytes.head? == some 0x2b) then 2 else 1

def parserFastLimit (word : ParseWord) (base start last : Nat) : Nat :=
  match word, base with
  | .bits64, 10 => min last (start + 18)
  | .bits128, 10 => min last (start + 37)
  | .bits64, 16 => min last (start + 15)
  | .bits128, 16 => min last (start + 31)
  | _, _ => start - 1

def fastBlockStarts (start limit : Nat) : List Nat :=
  (List.range ((limit + 1 - start) / 8)).map fun block => start + 8 * block

def load8Accesses (start : Nat) : List Int := span start 8

/-- Exact safety envelope of `parsevalue` and `parseint` (`base/parsers/ints.jl:84-189`).
The sign read is at one. Fast blocks start at `i, i+8, ...` while eight bytes fit below the
computed `k`; all scalar and overflow scans are subsets of `start:last`. Invalid digits and
overflow only stop early, so the envelope contains every executed access. -/
def parsevalueAccesses
    (bytes : List UInt8) (signed : Bool) (word : ParseWord) (base : Nat) : List Int :=
  let first := parserStart bytes signed
  let last := bytes.length
  let limit := parserFastLimit word base first last
  let signRead := if signed && 0 < last then [1] else []
  signRead ++
    (fastBlockStarts first limit).flatMap load8Accesses ++
    (if first ≤ last then span first (last + 1 - first) else [])

def ParserAccessesInBounds : Prop :=
  ∀ bytes signed word base i, i ∈ parsevalueAccesses bytes signed word base →
    inBounds bytes.length i

theorem parserAccessesInBounds_proven : ParserAccessesInBounds := by
  intro bytes signed word base i hi
  unfold parsevalueAccesses at hi
  rw [List.mem_append] at hi
  rcases hi with hprefix | hscalar
  · rw [List.mem_append] at hprefix
    rcases hprefix with hsign | hfast
    · split at hsign <;> simp_all [inBounds] <;> omega
    · rw [List.mem_flatMap] at hfast
      obtain ⟨blockStart, hbs, hib⟩ := hfast
      unfold fastBlockStarts at hbs
      rw [List.mem_map] at hbs
      obtain ⟨block, hblock, rfl⟩ := hbs
      obtain ⟨lane, hlane, rfl⟩ := mem_span hib
      have hb := List.mem_range.mp hblock
      have hs : 1 ≤ parserStart bytes signed := by
        unfold parserStart
        split <;> omega
      by_cases h10 : base = 10
      · subst base
        cases word <;> simp [parserFastLimit] at hb <;> simp [inBounds] <;> omega
      · by_cases h16 : base = 16
        · subst base
          cases word <;> simp [parserFastLimit] at hb <;> simp [inBounds] <;> omega
        · cases word <;> simp [parserFastLimit, h10, h16] at hb <;> exfalso <;> omega
  · by_cases hfirst : parserStart bytes signed ≤ bytes.length
    · simp only [if_pos hfirst] at hscalar
      obtain ⟨k, hk, rfl⟩ := mem_span hscalar
      have hs : 1 ≤ parserStart bytes signed := by
        unfold parserStart
        split <;> omega
      have hik : parserStart bytes signed + k ≤ bytes.length := by omega
      unfold inBounds
      constructor
      · exact_mod_cast (show 1 ≤ parserStart bytes signed + k by omega)
      · exact_mod_cast hik
    · simp [hfirst] at hscalar

/-! ## Permuted-dimension tiled loops -/

/-- The two tiled `_permutedims!` kernels visit an axis in blocks of eight. -/
def tiledAxis (first len : Nat) : List Int :=
  (List.range ((len + 7) / 8)).flatMap fun block =>
    (List.range (min 8 (len - 8 * block))).map fun lane =>
      (first + 8 * block + lane : Nat)

def PermutedTileLoopsInBounds : Prop :=
  ∀ first len i, i ∈ tiledAxis first len → first ≤ i ∧ i < first + len

theorem permutedTileLoopsInBounds_proven : PermutedTileLoopsInBounds := by
  intro first len i hi
  unfold tiledAxis at hi
  rw [List.mem_flatMap] at hi
  obtain ⟨block, hxs, hix⟩ := hi
  rw [List.mem_map] at hix
  obtain ⟨lane, hl, rfl⟩ := hix
  have hbm := List.mem_range.mp hxs
  have hlm := List.mem_range.mp hl
  constructor <;> omega

/-! ## Log table indices -/

def roundTiesEven (numerator denominator : Nat) : Nat :=
  let q := numerator / denominator
  let r := numerator % denominator
  q + if denominator < 2 * r ∨ (denominator = 2 * r ∧ q % 2 = 1) then 1 else 0

/-- The `F = (y+C)-C` operation rounds the normalized mantissa to seven fraction bits. -/
def logProc1Index (fractionBits fractionWidth : Nat) : Nat :=
  let dropped := 2 ^ (fractionWidth - 7)
  128 + roundTiesEven fractionBits dropped - 127

/-- `_log_ext`: wrapping subtraction, arithmetic shift and `& (128-1)`, followed by `+1`.
Using the unsigned bit pattern gives the same low seven selected bits. -/
def logExtIndex (xu : Nat) : Nat :=
  ((((xu + 2 ^ 64 - 0x3fe6955500000000) % (2 ^ 64)) / (2 ^ 45)) % 128) + 1

def LogTableAccessesInBounds : Prop :=
  (∀ fraction : Fin (2 ^ 52), 1 ≤ logProc1Index fraction 52 ∧
      logProc1Index fraction 52 ≤ 129) ∧
  (∀ fraction : Fin (2 ^ 23), 1 ≤ logProc1Index fraction 23 ∧
      logProc1Index fraction 23 ≤ 129) ∧
  (∀ xu : Nat, 1 ≤ logExtIndex xu ∧ logExtIndex xu ≤ 128)

theorem logTableAccessesInBounds_proven : LogTableAccessesInBounds := by
  constructor
  · intro fraction
    unfold logProc1Index roundTiesEven
    have hf := fraction.isLt
    simp only [Nat.reduceSubDiff, Nat.reducePow]
    split <;> omega
  constructor
  · intro fraction
    unfold logProc1Index roundTiesEven
    have hf := fraction.isLt
    simp only [Nat.reduceSubDiff, Nat.reducePow]
    split <;> omega
  · intro xu
    unfold logExtIndex
    have hm := Nat.mod_lt (((xu + 2 ^ 64 - 0x3fe6955500000000) % 2 ^ 64) / 2 ^ 45)
      (by decide : 0 < 128)
    omega

/-! ## UUID formatting -/

def uuidHyphens : List Nat := [9, 14, 19, 24]

def uuidHexIndex (value : Nat) (digit : Nat) : Nat :=
  1 + (value / (16 ^ digit)) % 16

def uuidDestination (digit : Nat) : Nat :=
  if digit < 12 then 36 - digit
  else if digit < 16 then 35 - digit
  else if digit < 20 then 34 - digit
  else if digit < 24 then 33 - digit
  else 32 - digit

def uuidWrites (value : Nat) : List (Nat × Nat) :=
  (List.range 32).map fun digit =>
    (uuidDestination digit, uuidHexIndex value digit)

def UuidWritesInBounds : Prop :=
  (∀ value destination hexIndex, (destination, hexIndex) ∈ uuidWrites value →
    1 ≤ destination ∧ destination ≤ 36 ∧ 1 ≤ hexIndex ∧ hexIndex ≤ 16) ∧
  (∀ destination ∈ uuidHyphens, 1 ≤ destination ∧ destination ≤ 36)

theorem uuidWritesInBounds_proven : UuidWritesInBounds := by
  constructor
  · intro value destination hexIndex h
    unfold uuidWrites at h
    rw [List.mem_map] at h
    obtain ⟨digit, hd, h⟩ := h
    have hd' := List.mem_range.mp hd
    cases h
    have hm := Nat.mod_lt (value / 16 ^ digit) (by decide : 0 < 16)
    have hdest : 1 ≤ uuidDestination digit ∧ uuidDestination digit ≤ 36 := by
      unfold uuidDestination
      split
      · omega
      · split
        · omega
        · split
          · omega
          · split <;> omega
    exact ⟨hdest.1, hdest.2, by simp [uuidHexIndex], by simp [uuidHexIndex]; omega⟩
  · intro destination h
    simp [uuidHyphens] at h
    rcases h with rfl | rfl | rfl | rfl <;> omega

/-! ## String code-unit accesses -/

/-- The byte reads of `_thisind_str` and `_thisind_continued`
(`base/strings/string.jl:252-270`). The byte tests select a prefix of `i, i-1, i-2, i-3`;
each later read is present only after the corresponding source guard. -/
def thisindAccesses (s : JuliaLean.Strings.JStr) (i : Int) : List Int :=
  let n := s.bytes.length
  if i = 0 ∨ i = n + 1 ∨ i < 1 ∨ n < i then []
  else
    let b0 := JuliaLean.Strings.cu s (JInt.wrap .i64 i)
    if !(JuliaLean.Strings.isCont b0 && decide (i - 1 > 0)) then [i]
    else
      let b1 := JuliaLean.Strings.cu s (JInt.wrap .i64 (i - 1))
      if JuliaLean.Strings.between b1 0xc0 0xf7 then [i, i - 1]
      else if !(JuliaLean.Strings.isCont b1 && decide (i - 2 > 0)) then [i, i - 1]
      else
        let b2 := JuliaLean.Strings.cu s (JInt.wrap .i64 (i - 2))
        if JuliaLean.Strings.between b2 0xe0 0xf7 then [i, i - 1, i - 2]
        else if !(JuliaLean.Strings.isCont b2 && decide (i - 3 > 0)) then
          [i, i - 1, i - 2]
        else [i, i - 1, i - 2, i - 3]

theorem thisindAccesses_safe (s : JuliaLean.Strings.JStr) (i j : Int)
    (h : j ∈ thisindAccesses s i) : inBounds s.bytes.length j := by
  simp only [thisindAccesses] at h
  split at h
  · simp_all
  split at h
  · simp_all [inBounds]
  split at h
  · simp_all [inBounds]
    omega
  split at h
  · simp_all [inBounds]
    omega
  split at h
  · simp_all [inBounds]
    omega
  split at h <;> simp_all [inBounds] <;> omega

/-- The guarded continuation reads shared by `_nextind_continued`, `iterate_continued`, and
`getindex_continued`. Every byte branch from the source is represented, including the lead-byte
width exits after the first and second continuation bytes. -/
def forwardContinuationAccesses
    (s : JuliaLean.Strings.JStr) (start : Int) (lead : UInt8) : List Int :=
  let n := s.bytes.length
  let i1 := start + 1
  if n < i1 then []
  else
    let b1 := JuliaLean.Strings.cu s (JInt.wrap .i64 i1)
    if !JuliaLean.Strings.isCont b1 then [i1]
    else
      let i2 := start + 2
      if n < i2 ∨ lead < 0xe0 then [i1]
      else
        let b2 := JuliaLean.Strings.cu s (JInt.wrap .i64 i2)
        if !JuliaLean.Strings.isCont b2 then [i1, i2]
        else
          let i3 := start + 3
          if n < i3 ∨ lead < 0xf0 then [i1, i2]
          else [i1, i2, i3]

theorem forwardContinuationAccesses_safe
    (s : JuliaLean.Strings.JStr) (start : Int) (lead : UInt8)
    (hs1 : 1 ≤ start) (_hsn : start ≤ s.bytes.length) (i : Int)
    (hi : i ∈ forwardContinuationAccesses s start lead) :
    inBounds s.bytes.length i := by
  simp only [forwardContinuationAccesses] at hi
  split at hi
  · simp_all
  split at hi
  · simp_all [inBounds]
    omega
  split at hi
  · simp_all [inBounds]
    omega
  split at hi
  · simp_all [inBounds]
    omega
  split at hi <;> simp_all [inBounds] <;> omega

/-- Exact byte trace of `_nextind_str` and `_nextind_continued`. The continuation-byte branch
uses the exact `thisZ` rewind computed by `thisind`; all source exits are preserved.
`base/strings/string.jl:276-305`. -/
def nextindAccesses (s : JuliaLean.Strings.JStr) (i : Int) : List Int :=
  let n := s.bytes.length
  if i = 0 then []
  else if i < 1 ∨ n < i then []
  else
    let lead := JuliaLean.Strings.cu s (JInt.wrap .i64 i)
    if !JuliaLean.Strings.between lead 0x80 0xf7 then [i]
    else if lead < 0xc0 then
      let rewind := JuliaLean.Strings.thisZ s i
      let rewindReads := thisindAccesses s i
      if i ≤ rewind then [i] ++ rewindReads
      else
        let rewindLead := JuliaLean.Strings.cu s (JInt.wrap .i64 rewind)
        if rewindLead < 0x80 ∨ 0xf8 ≤ rewindLead then [i] ++ rewindReads ++ [rewind]
        else [i] ++ rewindReads ++ [rewind] ++
          forwardContinuationAccesses s rewind rewindLead
    else [i] ++ forwardContinuationAccesses s i lead

theorem nextindAccesses_safe (s : JuliaLean.Strings.JStr) (i j : Int)
    (h : j ∈ nextindAccesses s i) : inBounds s.bytes.length j := by
  simp only [nextindAccesses] at h
  split at h
  · simp_all
  split at h
  · simp_all
  rename_i hi
  split at h
  · simp_all [inBounds]
  split at h
  · rename_i hcont
    have hi1 : 1 ≤ i := by omega
    have hz := JuliaLean.Strings.thisZ_range s i hi1
    split at h
    · rw [List.mem_append] at h
      rcases h with h | h
      · simp_all [inBounds]
      · exact thisindAccesses_safe s i j h
    · split at h
      · simp only [List.mem_append, List.mem_cons, List.not_mem_nil, or_false] at h
        rcases h with hprefix | hrewind
        · rcases hprefix with rfl | hthis
          · simp [inBounds]
            omega
          · exact thisindAccesses_safe s i j hthis
        · rw [hrewind]
          simp [inBounds]
          omega
      · simp only [List.mem_append, List.mem_cons, List.not_mem_nil, or_false] at h
        rcases h with hprefix | hforward
        · rcases hprefix with hbase | hrewind
          · rcases hbase with rfl | hthis
            · simp [inBounds]
              omega
            · exact thisindAccesses_safe s i j hthis
          · rw [hrewind]
            simp [inBounds]
            omega
        · exact forwardContinuationAccesses_safe s (JuliaLean.Strings.thisZ s i) _
            (by omega) (by omega) j hforward
  · rw [List.mem_append] at h
    rcases h with h | h
    · simp_all [inBounds]
    · exact forwardContinuationAccesses_safe s i _ (by omega) (by omega) j h

/-- Exact byte trace of `iterate(::Union{String,StringView}, i)` and its continuation helper.
`base/strings/string.jl:508-538`. -/
def iterateStringAccesses (s : JuliaLean.Strings.JStr) (i : Int) : List Int :=
  match checkedIndex s.bytes.length i with
  | none => []
  | some j =>
      let lead := JuliaLean.Strings.cu s (JInt.wrap .i64 j)
      if !JuliaLean.Strings.between lead 0x80 0xf7 ∨ lead < 0xc0 then [j]
      else [j] ++ forwardContinuationAccesses s j lead

theorem iterateStringAccesses_safe (s : JuliaLean.Strings.JStr) (i j : Int)
    (h : j ∈ iterateStringAccesses s i) : inBounds s.bytes.length j := by
  simp only [iterateStringAccesses] at h
  split at h
  · simp_all
  rename_i index hi
  unfold checkedIndex at hi
  split at hi
  · rename_i hb
    cases hi
    split at h
    · simp_all [inBounds]
    · rw [List.mem_append] at h
      rcases h with h | h
      · simp_all [inBounds]
      · exact forwardContinuationAccesses_safe s i _ (by omega) (by omega) j h
  · simp_all

/-- Exact byte trace of checked String `getindex` and `getindex_continued`, including the
invalid-continuation call to `isvalid`. `base/strings/string.jl:540-573`. -/
def getindexStringAccesses (s : JuliaLean.Strings.JStr) (i : Int) : List Int :=
  match checkedIndex s.bytes.length i with
  | none => []
  | some j =>
      let lead := JuliaLean.Strings.cu s (JInt.wrap .i64 j)
      if !JuliaLean.Strings.between lead 0x80 0xf7 then [j]
      else if lead < 0xc0 then [j] ++ thisindAccesses s j
      else [j] ++ forwardContinuationAccesses s j lead

theorem getindexStringAccesses_safe (s : JuliaLean.Strings.JStr) (i j : Int)
    (h : j ∈ getindexStringAccesses s i) : inBounds s.bytes.length j := by
  simp only [getindexStringAccesses] at h
  split at h
  · simp_all
  rename_i index hi
  unfold checkedIndex at hi
  split at hi
  · rename_i hb
    cases hi
    split at h
    · simp_all [inBounds]
    · split at h
      · rw [List.mem_append] at h
        rcases h with h | h
        · simp_all [inBounds]
        · exact thisindAccesses_safe s i j h
      · rw [List.mem_append] at h
        rcases h with h | h
        · simp_all [inBounds]
        · exact forwardContinuationAccesses_safe s i _ (by omega) (by omega) j h
  · simp_all

/-- A checked code-unit or generic `getindex` call performs one local String access only when
its source check succeeds (`base/strings/basic.jl:185-199`, `base/strings/string.jl:212-217`). -/
def checkedStringAccesses (s : JuliaLean.Strings.JStr) (i : Int) : List Int :=
  getindexStringAccesses s i

/-- The generic length/prevind/nextind/ASCII loops range only over a checked source span. The
byte-value branch changes termination, so the set of possible accesses is the loop range.
`base/strings/basic.jl:396-405,447-573,622-652` and
`base/strings/string.jl:597-658`. -/
def checkedStringScan (len first last : Nat) : List Int :=
  if 1 ≤ first ∧ first ≤ last + 1 ∧ last ≤ len then
    if first ≤ last then span first (last + 1 - first) else []
  else []

/-- Exact indices passed to the unchecked `isvalid` call in the generic `nextind(s,i,n)` loop.
The `n` update uses the same wrapping `JInt64` subtraction as Julia; the index advances only
under `i < ncodeunits(s)`. `base/strings/basic.jl:564-573`. -/
def nextindNLoopCalls (s : JuliaLean.Strings.JStr) : Nat → Int → JInt64 → List Int
  | 0, _, _ => []
  | fuel + 1, i, n =>
      if n.val > 0 ∧ i < s.bytes.length then
        let j := i + 1
        j :: nextindNLoopCalls s fuel j
          (n - JuliaLean.Strings.bInt (JuliaLean.Strings.isvalidAt s (JInt.wrap .i64 j)))
      else []

def nextindNAccesses (s : JuliaLean.Strings.JStr) (i n : JInt64) : List Int :=
  if n.val < 0 ∨ i.val < 0 ∨ s.bytes.length < i.val ∨ n.val = 0 then []
  else nextindNLoopCalls s (s.bytes.length - i.val).toNat i.val n

theorem nextindNLoopCalls_safe (s : JuliaLean.Strings.JStr) :
    ∀ (fuel : Nat) (i : Int) (n : JInt64) (j : Int), 0 ≤ i → i ≤ s.bytes.length →
      j ∈ nextindNLoopCalls s fuel i n → inBounds s.bytes.length j := by
  intro fuel
  induction fuel with
  | zero => intro i n j hi0 hin h; simp [nextindNLoopCalls] at h
  | succ fuel ih =>
      intro i n j hi0 hin h
      simp only [nextindNLoopCalls] at h
      split at h
      · rename_i hc
        simp only [List.mem_cons] at h
        rcases h with rfl | h
        · simp [inBounds]
          omega
        · exact ih (i + 1) _ j (by omega) (by omega) h
      · simp_all

theorem nextindNAccesses_safe (s : JuliaLean.Strings.JStr) (i n : JInt64) (j : Int)
    (h : j ∈ nextindNAccesses s i n) : inBounds s.bytes.length j := by
  unfold nextindNAccesses at h
  split at h
  · simp_all
  · exact nextindNLoopCalls_safe s _ i.val n j (by omega) (by omega) h

/-- Exact indices passed to `isvalid` in `prevind(s,i,n)`. The index decrements only under
`1 < i`; `n` uses the same wrapping update as Julia. `base/strings/basic.jl:505-514`. -/
def previndNLoopCalls (s : JuliaLean.Strings.JStr) : Nat → Int → JInt64 → List Int
  | 0, _, _ => []
  | fuel + 1, i, n =>
      if n.val > 0 ∧ 1 < i then
        let j := i - 1
        j :: previndNLoopCalls s fuel j
          (n - JuliaLean.Strings.bInt (JuliaLean.Strings.isvalidAt s (JInt.wrap .i64 j)))
      else []

def previndNAccesses (s : JuliaLean.Strings.JStr) (i n : JInt64) : List Int :=
  if n.val < 0 ∨ i.val ≤ 0 ∨ s.bytes.length + 1 < i.val ∨ n.val = 0 then []
  else previndNLoopCalls s (i.val - 1).toNat i.val n

theorem previndNLoopCalls_safe (s : JuliaLean.Strings.JStr) :
    ∀ (fuel : Nat) (i : Int) (n : JInt64) (j : Int), 1 ≤ i → i ≤ s.bytes.length + 1 →
      j ∈ previndNLoopCalls s fuel i n → inBounds s.bytes.length j := by
  intro fuel
  induction fuel with
  | zero => intro i n j hi1 hin h; simp [previndNLoopCalls] at h
  | succ fuel ih =>
      intro i n j hi1 hin h
      simp only [previndNLoopCalls] at h
      split at h
      · rename_i hc
        simp only [List.mem_cons] at h
        rcases h with rfl | h
        · simp [inBounds]
          omega
        · exact ih (i - 1) _ j (by omega) (by omega) h
      · simp_all

theorem previndNAccesses_safe (s : JuliaLean.Strings.JStr) (i n : JInt64) (j : Int)
    (h : j ∈ previndNAccesses s i n) : inBounds s.bytes.length j := by
  unfold previndNAccesses at h
  split at h
  · simp_all
  · exact previndNLoopCalls_safe s _ i.val n j (by omega) (by omega) h

def StringCoreAccessesInBounds : Prop :=
  (∀ s i j, j ∈ thisindAccesses s i → inBounds s.bytes.length j) ∧
  (∀ s i j, j ∈ nextindAccesses s i → inBounds s.bytes.length j) ∧
  (∀ s i j, j ∈ iterateStringAccesses s i → inBounds s.bytes.length j) ∧
  (∀ s i j, j ∈ getindexStringAccesses s i → inBounds s.bytes.length j) ∧
  (∀ s i j, j ∈ checkedStringAccesses s i → inBounds s.bytes.length j) ∧
  (∀ s i n j, j ∈ nextindNAccesses s i n → inBounds s.bytes.length j) ∧
  (∀ s i n j, j ∈ previndNAccesses s i n → inBounds s.bytes.length j) ∧
  (∀ len first last j, j ∈ checkedStringScan len first last → inBounds len j)

theorem stringCoreAccessesInBounds_proven : StringCoreAccessesInBounds := by
  exact ⟨thisindAccesses_safe, nextindAccesses_safe, iterateStringAccesses_safe,
    getindexStringAccesses_safe, getindexStringAccesses_safe,
    nextindNAccesses_safe, previndNAccesses_safe,
    by
      intro len first last j h
      unfold checkedStringScan at h
      split at h
      · rename_i hc
        split at h
        · obtain ⟨k, hk, rfl⟩ := mem_span h
          simp [inBounds]
          omega
        · simp_all
      · simp_all⟩

/-- Physical StringView access. A view constructed from parent offset `offset` and byte length
`len` first checks `offset+len ≤ parentLen`; a checked local index then maps to
`offset+i`. This is the representation invariant used by the union methods above. -/
def stringViewAccess
    (parentLen offset len : Nat) (i : Int) : Option Int :=
  if offset + len ≤ parentLen then
    match checkedIndex len i with
    | some j => some (offset + j)
    | none => none
  else none

def StringViewAccessesInBounds : Prop :=
  ∀ parentLen offset len i j,
    stringViewAccess parentLen offset len i = some j → inBounds parentLen j

theorem stringViewAccessesInBounds_proven : StringViewAccessesInBounds := by
  intro parentLen offset len i j h
  unfold stringViewAccess checkedIndex at h
  split at h
  · split at h <;> simp_all [inBounds] <;> omega
  · simp_all

/-! ## String ranges, first/last, storage, DFA, and character repetition -/

/-- `getindex(s::String, i:j)` after its nonempty, bounds, and validity checks. The source
end becomes `nextind(s,j)-1`, so the copied byte count is `nextZ(s,j)-i`.
`base/strings/string.jl:580-594`. -/
def stringRangeAccesses (s : JuliaLean.Strings.JStr) (i j : Int) : List Int :=
  let n := s.bytes.length
  if i ≤ j ∧ 1 ≤ i ∧ j ≤ n ∧
      JuliaLean.Strings.thisZ s i = i ∧ JuliaLean.Strings.thisZ s j = j then
    span i.toNat (JuliaLean.Strings.nextZ s j - i).toNat
  else []

def StringRangeAccessesInBounds : Prop :=
  ∀ s i j k, k ∈ stringRangeAccesses s i j → inBounds s.bytes.length k

theorem stringRangeAccessesInBounds_proven : StringRangeAccessesInBounds := by
  intro s i j k hk
  simp only [stringRangeAccesses] at hk
  split at hk
  · rename_i h
    obtain ⟨d, hd, rfl⟩ := mem_span hk
    have hn := JuliaLean.Strings.nextZ_spec s j (by omega) (by omega)
    have hiNat : i.toNat = i := by omega
    rw [hiNat]
    simp [inBounds]
    omega
  · simp_all

/-- The unchecked range selected by `first(s,n)`. `nextindN` computes `k`; `min(lastindex,k)`
is the endpoint. A nonpositive endpoint makes Julia's range empty, otherwise the range copy
reads through `nextZ(endpoint)-1`. -/
def firstStringAccesses (s : JuliaLean.Strings.JStr) (n : JInt64) : List Int :=
  match JuliaLean.Strings.nextindN s (JuliaLean.Strings.ix 0) n with
  | .error _ => []
  | .ok k =>
      let stop := min (JuliaLean.Strings.thisZ s s.bytes.length) k.val
      if stop < 1 then []
      else span 1 (JuliaLean.Strings.nextZ s stop - 1).toNat

/-- The unchecked range selected by `last(s,n)`. `previndN` computes `k`; `max(1,k)` is the
start and `lastindex(s)` the endpoint. -/
def lastStringAccesses (s : JuliaLean.Strings.JStr) (n : JInt64) : List Int :=
  match JuliaLean.Strings.previndN s (JuliaLean.Strings.ncodeunits s + JuliaLean.Strings.ix 1) n with
  | .error _ => []
  | .ok k =>
      let first := max 1 k.val
      let stop := JuliaLean.Strings.thisZ s s.bytes.length
      if stop < first then [] else span first.toNat (s.bytes.length + 1 - first.toNat)

def StringFirstLastAccessesInBounds : Prop :=
  (∀ s n i, i ∈ firstStringAccesses s n → inBounds s.bytes.length i) ∧
  (∀ s n i, i ∈ lastStringAccesses s n → inBounds s.bytes.length i)

theorem stringFirstLastAccessesInBounds_proven : StringFirstLastAccessesInBounds := by
  constructor
  · intro s n i hi
    unfold firstStringAccesses at hi
    split at hi
    · simp_all
    · rename_i k hk
      dsimp only at hi
      split at hi
      · simp_all
      · rename_i hstop
        obtain ⟨d, hd, rfl⟩ := mem_span hi
        have hlen : 0 < s.bytes.length := by
          cases Nat.eq_zero_or_pos s.bytes.length with
          | inl hz =>
              have hzthis : JuliaLean.Strings.thisZ s 0 = 0 := by
                simp [JuliaLean.Strings.thisZ, JuliaLean.Strings.cB, JuliaLean.Strings.bv]
              have hcast : (s.bytes.length : Int) = 0 := by omega
              rw [hcast, hzthis] at hstop
              omega
          | inr hp => exact hp
        have hlast := JuliaLean.Strings.thisZ_range s s.bytes.length (by omega)
        have hmin : min (JuliaLean.Strings.thisZ s s.bytes.length) k.val ≤ s.bytes.length := by
          omega
        have hn := JuliaLean.Strings.nextZ_spec s
          (min (JuliaLean.Strings.thisZ s s.bytes.length) k.val) (by omega) hmin
        simp [inBounds]
        omega
  · intro s n i hi
    unfold lastStringAccesses at hi
    split at hi
    · simp_all
    · rename_i k hk
      dsimp only at hi
      split at hi
      · simp_all
      · rename_i hstop
        obtain ⟨d, hd, rfl⟩ := mem_span hi
        simp [inBounds]
        omega

/-- Safe `Vector{UInt8}(s::AbstractString)` first constructs an owned String of exactly
`ncodeunits(String(s))` bytes, then exposes precisely those bytes (`basic.jl:220-221`,
`string.jl:187-200`). -/
def stringStorageAccesses (bytes : List UInt8) : Nat × List Int :=
  (bytes.length, span 1 bytes.length)

def StringStorageAccessesInBounds : Prop :=
  ∀ bytes i, i ∈ (stringStorageAccesses bytes).2 →
    inBounds (stringStorageAccesses bytes).1 i

theorem stringStorageAccessesInBounds_proven : StringStorageAccessesInBounds := by
  intro bytes i hi
  obtain ⟨k, hk, rfl⟩ := mem_span hi
  simp [stringStorageAccesses, inBounds]
  omega

/-- `_utf_dfa_step` indexes its 256-entry table by the exact `UInt8` expression `byte+1`.
The vector read in `_isvalid_utf8_dfa` is the caller-computed inclusive chunk. -/
def utfDfaTableIndex (byte : UInt8) : Nat := byte.toNat + 1

def utfDfaChunkAccesses (len first last : Nat) : List Int :=
  if 1 ≤ first ∧ first ≤ last + 1 ∧ last ≤ len then
    if first ≤ last then span first (last + 1 - first) else []
  else []

def Utf8DfaAccessesInBounds : Prop :=
  (∀ byte, 1 ≤ utfDfaTableIndex byte ∧ utfDfaTableIndex byte ≤ 256) ∧
  (∀ len first last i, i ∈ utfDfaChunkAccesses len first last → inBounds len i)

theorem utf8DfaAccessesInBounds_proven : Utf8DfaAccessesInBounds := by
  constructor
  · intro byte
    unfold utfDfaTableIndex
    have hb := byte.toNat_lt
    omega
  · intro len first last i hi
    unfold utfDfaChunkAccesses at hi
    split at hi
    · rename_i hc
      split at hi
      · obtain ⟨k, hk, rfl⟩ := mem_span hi
        simp [inBounds]
        omega
      · simp_all
    · simp_all

def repeatCharWidth (u : Nat) : Nat :=
  if u < 2 ^ 8 then 1 else if u < 2 ^ 16 then 2 else if u < 2 ^ 24 then 3 else 4

/-- The stores at `base/strings/string.jl:682-713`, after the negative, zero, and overflow
branches. Widths two and four use typed pointers, so their element index is `i`; width three
uses byte indices `3i+1:3i+3`. This byte-level trace is equivalent for all four branches. -/
def repeatCharAccesses (encoded : UInt32) (copies : Nat) : Nat × List Int :=
  let width := repeatCharWidth (JuliaLean.Strings.bswap32 encoded).toNat
  let allocated := width * copies
  (allocated, (List.range copies).flatMap fun copy => span (width * copy + 1) width)

def RepeatCharAccessesInBounds : Prop :=
  ∀ encoded copies i, i ∈ (repeatCharAccesses encoded copies).2 →
    inBounds (repeatCharAccesses encoded copies).1 i

theorem repeatCharAccessesInBounds_proven : RepeatCharAccessesInBounds := by
  intro encoded copies i hi
  unfold repeatCharAccesses at hi ⊢
  rw [List.mem_flatMap] at hi
  obtain ⟨copy, hc, hi⟩ := hi
  have hc' := List.mem_range.mp hc
  obtain ⟨lane, hl, rfl⟩ := mem_span hi
  let u := (JuliaLean.Strings.bswap32 encoded).toNat
  by_cases h8 : u < 2 ^ 8
  · simp [repeatCharWidth, u, h8, inBounds] at hl ⊢
    omega
  · by_cases h16 : u < 2 ^ 16
    · simp [repeatCharWidth, u, h8, h16, inBounds] at hl ⊢
      omega
    · by_cases h24 : u < 2 ^ 24
      · simp [repeatCharWidth, u, h8, h16, h24, inBounds] at hl ⊢
        omega
      · simp [repeatCharWidth, u, h8, h16, h24, inBounds] at hl ⊢
        omega

/-! ## Regex and annotated-string spans -/

def pcreOvectorLength (captures : Nat) : Nat := 2 * (captures + 1)

def pcreMatchCaptureCount (captures : Nat) : Nat := pcreOvectorLength captures / 2 - 1

/-- The unsafe slot loads in `match` and `_findnext_re` at
`base/regex.jl:430-451,491-511`. PCRE supplies `2(captures+1)` slots; Julia recomputes
`n = ovec_length/2-1`, reads the whole-match pair, then four occurrences of the capture pair
for each `i=1:n`. -/
def pcreOvectorReads (captures : Nat) : List Nat :=
  [1, 2] ++ (List.range (pcreMatchCaptureCount captures)).flatMap fun k =>
    let i := k + 1
    [2 * i + 1, 2 * i + 2, 2 * i + 1, 2 * i + 2, 2 * i + 1]

def RegexOvectorAccessesInBounds : Prop :=
  ∀ captures slot, slot ∈ pcreOvectorReads captures →
    1 ≤ slot ∧ slot ≤ pcreOvectorLength captures

theorem regexOvectorAccessesInBounds_proven : RegexOvectorAccessesInBounds := by
  intro captures slot hs
  unfold pcreOvectorReads at hs
  rw [List.mem_append] at hs
  rcases hs with hs | hs
  · simp at hs
    rcases hs with rfl | rfl <;> simp [pcreOvectorLength] <;> omega
  · rw [List.mem_flatMap] at hs
    obtain ⟨k, hk, hs⟩ := hs
    have hk' := List.mem_range.mp hk
    simp [pcreMatchCaptureCount, pcreOvectorLength] at hk'
    simp at hs
    rcases hs with rfl | rfl | rfl | rfl | rfl <;>
      simp [pcreOvectorLength] <;> omega

/-- A successful PCRE span is a zero-based half-open byte interval in its subject. The match,
capture, `_annotatedmatch`, and `_findnext_re` paths convert it to Julia's one-based indices.
`base/regex.jl:441-461,506`. -/
def pcreSpanAccesses (subjectLen start stop : Nat) : List Int :=
  if start ≤ stop ∧ stop ≤ subjectLen then span (start + 1) (stop - start) else []

/-- `count(pattern, s)` calls `nextind(s,j)` only after the returned match endpoint satisfies
`j ≤ lastindex(s)` (`base/regex.jl:573-583`). -/
def regexCountNextindAccesses
    (s : JuliaLean.Strings.JStr) (matchStop : Int) : List Int :=
  if 1 ≤ matchStop ∧ matchStop ≤ JuliaLean.Strings.thisZ s s.bytes.length then
    nextindAccesses s matchStop
  else []

def RegexSpanAccessesInBounds : Prop :=
  (∀ subjectLen start stop i, i ∈ pcreSpanAccesses subjectLen start stop →
    inBounds subjectLen i) ∧
  (∀ s matchStop i, i ∈ regexCountNextindAccesses s matchStop →
    inBounds s.bytes.length i)

theorem regexSpanAccessesInBounds_proven : RegexSpanAccessesInBounds := by
  constructor
  · intro subjectLen start stop i hi
    unfold pcreSpanAccesses at hi
    split at hi
    · rename_i hspan
      obtain ⟨k, hk, rfl⟩ := mem_span hi
      simp [inBounds]
      omega
    · simp_all
  · intro s matchStop i hi
    unfold regexCountNextindAccesses at hi
    split at hi
    · exact nextindAccesses_safe s matchStop i hi
    · simp_all

/-- `SubString` construction checks a one-based byte span. `unannotate` forwards that stored
span to `raw_substring`; AnnotatedString indexing first checks its index and then uses the same
underlying String index (`base/strings/annotated.jl:184-199`). -/
def annotatedSubstringAccesses (parentLen start count : Nat) : List Int :=
  if 1 ≤ start ∧ start + count ≤ parentLen + 1 then span start count else []

def AnnotatedStringAccessesInBounds : Prop :=
  (∀ parentLen start count i, i ∈ annotatedSubstringAccesses parentLen start count →
    inBounds parentLen i) ∧
  (∀ s index i, i ∈ checkedStringAccesses s index → inBounds s.bytes.length i)

theorem annotatedStringAccessesInBounds_proven : AnnotatedStringAccessesInBounds := by
  constructor
  · intro parentLen start count i hi
    unfold annotatedSubstringAccesses at hi
    split at hi
    · rename_i hspan
      obtain ⟨k, hk, rfl⟩ := mem_span hi
      simp [inBounds]
      omega
    · simp_all
  · intro s index i hi
    exact getindexStringAccesses_safe s index i hi

end JuliaLean.MemSafety.G6
