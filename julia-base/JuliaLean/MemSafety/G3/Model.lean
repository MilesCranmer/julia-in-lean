import JuliaLean.AbstractArrays.Model
import JuliaLean.Dicts.ProofLookup
import JuliaLean.Dicts.ProofInsert
import JuliaLean.ParsePrint.IntParse
import JuliaLean.ParsePrint.IntPrint
import JuliaLean.Reduce.Model
import JuliaLean.Show.Unicode
import JuliaLean.StringUtil.Hex
import JuliaLean.StringUtil.Strip

/-!
Bounds-obligation models for the unchecked accesses in `memsafety/sites-3.tsv`.

The models use zero-based offsets for pointer arithmetic and Julia's one-based
indices for arrays. External C storage is represented by its documented extent.
-/

namespace JuliaLean.MemSafety.G3

open JuliaLean

/-- Membership in an axis of `len` elements beginning at `first`. -/
def inAxis (first : Int) (len : Nat) (i : Int) : Prop :=
  first ≤ i ∧ i < first + len

/-- Membership in a one-based array of length `len`. -/
def inOneBased (len i : Nat) : Prop := 1 ≤ i ∧ i ≤ len

/-- The indices generated by Julia's `for i = 1:n` loops. -/
def oneBasedLoop (n : Nat) : List Nat :=
  (List.range n).map Nat.succ

/-- An `IndexLinear` array with its representable `Int` axis invariant. -/
structure LinearArray (α : Type) where
  first : Int
  values : List α
  firstFits : IntTy.min .i64 ≤ first
  lastFits : first + values.length - 1 ≤ IntTy.max .i64

def linearArrayIndices (a : LinearArray α) : List Int :=
  (List.range a.values.length).map fun (k : Nat) => a.first + (k : Int)

/-- The zero-based column-major offset used by `hvncat_calcindex`,
`base/abstractarray.jl:2865-2873`. -/
def linearOffset : List Nat → List Nat → Nat
  | [], [] => 0
  | d :: ds, c :: cs => c + d * linearOffset ds cs
  | _, _ => 0

/-- Every coordinate is below the corresponding dimension. -/
def coordsValid : List Nat → List Nat → Prop
  | [], [] => True
  | d :: ds, c :: cs => c < d ∧ coordsValid ds cs
  | _, _ => False

def coordsValidB : List Nat → List Nat → Bool
  | [], [] => true
  | d :: ds, c :: cs => decide (c < d) && coordsValidB ds cs
  | _, _ => false

/-- The indices reached after the public copy methods convert starts to `Int`,
reject negative counts, and check the complete span. -/
def checkedSpanAccesses (a : LinearArray α) (start : Int) (count : Nat) : List Int :=
  if a.first ≤ start ∧ start + count ≤ a.first + a.values.length then
    (List.range count).map fun (k : Nat) => start + (k : Int)
  else []

/-- A source or destination access in a paired copy loop. -/
inductive CopyAccess where
  | dest (index : Int)
  | src (index : Int)

/-- Paired iteration indices used by `copyto_unaliased!` after its destination
length check. -/
def unaliasedCopyAccesses (dest : LinearArray α) (src : LinearArray β) : List CopyAccess :=
  if src.values.length ≤ dest.values.length then
    ((linearArrayIndices dest).take src.values.length).map CopyAccess.dest ++
      (linearArrayIndices src).map CopyAccess.src
  else []

/-- Canonical one-based linear index computed from checked Cartesian
coordinates by `_to_linear_index`; the Cartesian path reuses the same checked
coordinates. -/
def canonicalIndexAccess (dims coords : List Nat) : Option Nat :=
  if coordsValidB dims coords then some (linearOffset dims coords + 1) else none

/-- Copy loops in `base/abstractarray.jl:953-1176,1392-1503`: checked spans,
paired `eachindex`/`LinearIndices`, and canonical index conversion. -/
def AbstractArrayCopySafe : Prop :=
  (∀ (α : Type) (a : LinearArray α) start count i,
    i ∈ checkedSpanAccesses a start count → inAxis a.first a.values.length i) ∧
  (∀ (α β : Type) (dest : LinearArray α) (src : LinearArray β) access,
    access ∈ unaliasedCopyAccesses dest src →
      match access with
      | .dest i => inAxis dest.first dest.values.length i
      | .src i => inAxis src.first src.values.length i) ∧
  (∀ dims coords index, canonicalIndexAccess dims coords = some index →
    inOneBased dims.prod index)

/-- All zero-based coordinates of an array shape. -/
def shapeCoordinates : List Nat → List (List Nat)
  | [] => [[]]
  | dim :: dims => (List.range dim).flatMap fun coordinate =>
      (shapeCoordinates dims).map (coordinate :: ·)

/-- Linear destination indices and scratch-vector positions reached by the
hvcat/hvncat fills after their element-count and shape construction. -/
def concatAccesses (dims : List Nat) : List Nat :=
  (shapeCoordinates dims).map fun coords => linearOffset dims coords + 1

def AbstractArrayConcatSafe : Prop :=
  (∀ dims index, index ∈ concatAccesses dims → inOneBased dims.prod index) ∧
  (∀ (dims : List Nat) i, i ∈ oneBasedLoop dims.length → inOneBased dims.length i)

/-- Slice positions allocated by `_dim_stack!`. -/
def stackAccesses (slices : List α) : List Nat := oneBasedLoop slices.length

/-- The write positions of `_keepat!` are a prefix of the vector's iteration
indices; a checked source read stops the loop before a longer invalid prefix. -/
def keepatWriteAccesses (a : LinearArray α) (requested : List Int) : List Int :=
  (linearArrayIndices a).take requested.length

/-- `stack`, `map!`, `map_n!`, and both `_keepat!` methods in
`base/abstractarray.jl:3075-3086,3482-3559,3699-3728`. -/
def AbstractArrayIterationSafe : Prop :=
  (∀ (α : Type) (slices : List α) i,
    i ∈ stackAccesses slices → inOneBased slices.length i) ∧
  (∀ (α : Type) (a : LinearArray α) i,
    i ∈ linearArrayIndices a → inAxis a.first a.values.length i) ∧
  (∀ (α : Type) (a : LinearArray α) requested i,
    i ∈ keepatWriteAccesses a requested → inAxis a.first a.values.length i)

/-- A valid `Memory` has `length` elements backed by at least `length *
aligned_sizeof(T)` bytes. The allocator rejects sizes exceeding `Int`'s
positive range (`src/genericmemory.c:55-71`); externally wrapped storage must
also cover the declared extent. -/
structure DeepcopyMemory (α : Type) where
  elements : List (Option α)
  elementSize : Nat
  storageBytes : Nat
  extent : elements.length * elementSize ≤ storageBytes
  sizeFits : (elements.length * elementSize : Int) ≤ IntTy.max .i64

/-- The ordinary allocator returns the zero-length singleton first; otherwise
it rejects element counts or byte counts at least `MAXINTVAL - 1`. -/
def deepcopyAllocationSucceeds (x : DeepcopyMemory α) : Prop :=
  x.elements.length = 0 ∨
    (x.elements.length < 9223372036854775806 ∧
     x.elements.length * x.elementSize < 9223372036854775806)

instance (x : DeepcopyMemory α) : Decidable (deepcopyAllocationSucceeds x) := by
  unfold deepcopyAllocationSucceeds
  infer_instance

/-- The bits branch calls `copy`, which allocates the same number of elements
and calls the same-type `unsafe_copyto!` at offsets 1. The zero-length return
precedes pointer conversion; otherwise `memmove` receives the wrapping `Int`
product from `base/genericmemory.jl:197-207,223-225,257-263`. -/
def deepcopyBitsBytes (x : DeepcopyMemory α) : Option Int :=
  if deepcopyAllocationSucceeds x ∧ x.elements.length ≠ 0 then
    some (wrapInt .i64 ((x.elementSize : Int) * x.elements.length))
  else none

/-- `copy` allocates storage for the same element count and element layout. -/
def deepcopyDestinationBytes (x : DeepcopyMemory α) : Nat :=
  x.elements.length * x.elementSize

/-- Source references reached by `_deepcopy_memory_t`, after the isbits early
return, from `base/deepcopy.jl:108-127`. -/
def deepcopyMemoryAccesses (isbits : Bool) (x : List (Option α)) : List Nat :=
  if isbits then [] else oneBasedLoop x.length

/-- Destination references are created only for assigned source elements. -/
def deepcopyMemoryWrites (isbits : Bool) (x : List (Option α)) : List Nat :=
  (deepcopyMemoryAccesses isbits x).filter fun i => (x[i - 1]?).join.isSome

/-- The non-bits loop stays in bounds, and the bits path copies exactly the
allocated byte extent without integer overflow or an out-of-bounds span. -/
def DeepcopyMemorySafe : Prop :=
  (∀ (α : Type) (isbits : Bool) (x : List (Option α)) (i : Nat),
    i ∈ deepcopyMemoryAccesses isbits x → inOneBased x.length i) ∧
  (∀ (α : Type) (isbits : Bool) (x : List (Option α)) (i : Nat),
    i ∈ deepcopyMemoryWrites isbits x →
      inOneBased (List.replicate x.length (none : Option α)).length i) ∧
  (∀ (α : Type) (x : DeepcopyMemory α),
    (x.elements.length = 0 → deepcopyBitsBytes x = none) ∧
    (deepcopyAllocationSucceeds x → x.elements.length ≠ 0 →
      deepcopyBitsBytes x = some ((x.elements.length * x.elementSize : Nat) : Int) ∧
      x.elements.length * x.elementSize ≤ x.storageBytes ∧
      x.elements.length * x.elementSize ≤ deepcopyDestinationBytes x))

/-- Every slot reached by a complete probe cycle from the hash-selected home
slot. Actual lookup and insertion loops use prefixes of this list. -/
def dictProbeAccesses (t : Dicts.Table K V) (hash : JInt .u64) : List Nat :=
  if t.size = 0 then [] else
    (List.range t.size).map fun distance =>
      Dicts.pr t.size (Dicts.hashindex hash t.size).1 distance

/-- Every slot reached by `eachindex(slots)`, `1:length(slots)`, rehash copy,
and filter/map scans. -/
def dictScanAccesses (t : Dicts.Table K V) : List Nat :=
  oneBasedLoop t.size

/-- The suffix scanned by Dict iteration and pop, starting at `idxfloor`. -/
def dictFloorAccesses (t : Dicts.Table K V) : List Nat :=
  (List.range (t.size + 1 - t.idxfloor)).map fun k => t.idxfloor + k

/-- Union of computed slots used by rehashing, lookup, insertion, deletion,
iteration, filtering, mapping, and merge paths in `base/dict.jl:140-770`. -/
def dictAccesses (t : Dicts.Table K V) (hash : JInt .u64) : List Nat :=
  dictProbeAccesses t hash ++ dictScanAccesses t ++ dictFloorAccesses t

def DictProbeSafe : Prop :=
  ∀ (K V : Type) (o : Dicts.KeyOps K) (t : Dicts.Table K V) hash index,
    Dicts.Inv o t → index ∈ dictAccesses t hash → inOneBased t.size index

/-- Number of set bits below `n`, matching the mask and `count_ones` in
`HAMT.entry_index`, `base/hamt.jl:138-141`. -/
def bitCountPrefix (bitmap : Nat) : Nat → Nat
  | 0 => 0
  | n + 1 => bitCountPrefix bitmap n + if bitmap.testBit n then 1 else 0

/-- `HAMT.path` reads the entry whose zero-based position is the count of set
bits below `bi`. The representation invariant says the data length is the
number of set bits in the 32-bit bitmap. -/
def PersistentDictPathSafe : Prop :=
  ∀ (bitmap dataLength bi : Nat), bi < 32 → bitmap.testBit bi = true →
    dataLength = bitCountPrefix bitmap 32 →
      inOneBased dataLength (bitCountPrefix bitmap bi + 1)

/-- Word count of the Windows block returned by `GetEnvironmentStringsW`,
represented by the lengths of its NUL-terminated entries and the final NUL,
`base/env.jl:193-228`. -/
def windowsEnvStorageLength : List Nat → Nat
  | [] => 1
  | len :: rest => len + 1 + windowsEnvStorageLength rest

/-- Offsets at which `iterate(::EnvDict)` reads the first word of an entry or
the final NUL. -/
def windowsEnvStarts : Nat → List Nat → List Nat
  | offset, [] => [offset]
  | offset, len :: rest => offset :: windowsEnvStarts (offset + len + 1) rest

/-- Source spans copied after `wcslen` has computed each entry length. -/
def windowsEnvCopies : Nat → List Nat → List (Nat × Nat)
  | _, [] => []
  | offset, len :: rest => (offset, len) :: windowsEnvCopies (offset + len + 1) rest

/-- The 1-based pointer indices read from the POSIX `environ` array, including
its terminating null pointer, `base/env.jl:230-245`. -/
def unixEnvLoads (entries : List Nat) : List Nat :=
  oneBasedLoop (entries.length + 1)

/-- `_environ` loads one pointer from the pointer supplied by Darwin or the
process symbol table. Windows block layout follows the documented
`entry\0...\0\0` format; POSIX `environ` is a null-terminated pointer array. -/
def EnvironmentBufferSafe : Prop :=
  (0 < 1) ∧
  (∀ (entryLengths : List Nat) offset,
    offset ∈ windowsEnvStarts 0 entryLengths →
      offset < windowsEnvStorageLength entryLengths) ∧
  (∀ (entryLengths : List Nat) span,
    span ∈ windowsEnvCopies 0 entryLengths →
      span.1 + span.2 ≤ windowsEnvStorageLength entryLengths) ∧
  (∀ (entries : List Nat) i, i ∈ unixEnvLoads entries →
    inOneBased (entries.length + 1) i)

/-- Union of buffer positions stored by all writer branches, after the shared
`IntPrint.string` model computes the allocation from the integer, base, pad,
sign, digit count, and selected writer. -/
def integerStringAccesses (t bty : IntTy) (n : JInt t) (base : JInt bty) (pad : Int) :
    Jl (Nat × List Nat) :=
  (ParsePrint.IntPrint.string n base pad).map fun buf =>
    (buf.length, oneBasedLoop buf.length)

/-- The fixed-width allocation and store union for `bitstring`. -/
def bitstringAccesses (t : IntTy) (x : JInt t) : Nat × List Nat :=
  let buf := ParsePrint.IntPrint.bitstring x
  (buf.length, oneBasedLoop buf.length)

/-- `_dec_d100[1 + remainder]` after `divrem(_, 100)`. -/
def decimalPairIndex (remainder : Nat) : Nat := remainder % 100 + 1

/-- Digit-table index and table length for `_base`, after the documented base
check and `rem`/`mod` computation. -/
def genericBaseDigitAccess (base x : Int) : Option (Nat × Nat) :=
  let magnitude := base.natAbs
  if 2 ≤ magnitude ∧ magnitude ≤ 62 then
    let index := (x % (magnitude : Int)).toNat + 1
    some (index, if magnitude ≤ 36 then 36 else 62)
  else none

/-- Store/table access union for integer formatting plus the `eachindex(x)`
loop of `clamp!`, `base/intfuncs.jl:878-1165,1518-1523`. -/
def IntegerFormattingSafe : Prop :=
  (∀ t bty n base pad result, integerStringAccesses t bty n base pad = .ok result →
    ∀ i ∈ result.2, inOneBased result.1 i) ∧
  (∀ t (x : JInt t) i, i ∈ (bitstringAccesses t x).2 →
    inOneBased (bitstringAccesses t x).1 i) ∧
  (∀ remainder, inOneBased 100 (decimalPairIndex remainder)) ∧
  (∀ base x index length, genericBaseDigitAccess base x = some (index, length) →
    inOneBased length index) ∧
  (∀ (α : Type) (a : LinearArray α) i, i ∈ linearArrayIndices a →
    inAxis a.first a.values.length i)

/-- An `IO` input to `countlines`, represented by the chunks returned by
`readbytes!(io, a)`. The public `readbytes!` contract says each call returns at
most its `nb = length(a) = 8192` argument (`base/io.jl:1295-1300`). -/
structure CountlinesIO where
  chunks : List (List UInt8)
  chunkLength : ∀ chunk ∈ chunks, chunk.length ≤ 8192

/-- The array indices computed by the nested `while` and `for i=1:nb` loops of
`countlines`, `base/io.jl:1700-1714`. -/
def countlinesAccesses (io : CountlinesIO) : List Nat :=
  io.chunks.flatMap (fun chunk => oneBasedLoop chunk.length)

/-- The byte offsets read by the endianness probe from its one-element
`Vector{UInt32}`, `base/io.jl:817-834`. -/
def endianBomAccesses : List Nat := [0]

/-- The endianness probe reads one byte from four allocated bytes, and every
`countlines` scan index is computed from a documented-size read chunk. -/
def IOSafe : Prop :=
  (∀ offset ∈ endianBomAccesses, offset < 4) ∧
  (∀ (io : CountlinesIO) i, i ∈ countlinesAccesses io → inOneBased 8192 i)

/-- A Symbol points to at least its terminating byte,
`base/module.jl:67-75`. -/
def ModuleSymbolSafe : Prop :=
  ∀ storageLength : Nat, 1 ≤ storageLength → inOneBased storageLength 1

/-- Byte reads performed by `skipspace`, including its ASCII and decoded
Unicode whitespace branches, `base/parse.jl:68-82`. -/
def skipspaceAccessesLoop (s : ParsePrint.IntParse.Bytes) (j : Int) : Nat → Int → List Int
  | 0, _ => []
  | fuel + 1, i =>
    if i ≤ j then
      let b := ParsePrint.IntParse.cu s i
      i :: if ParsePrint.IntParse.isspaceAscii b then
        skipspaceAccessesLoop s j fuel (i + 1)
      else if b.val ≥ 0x80 ∧ ParsePrint.IntParse.skipspacechar s i > i then
        skipspaceAccessesLoop s j fuel (ParsePrint.IntParse.skipspacechar s i)
      else []
    else []

def skipspaceAccesses (s : ParsePrint.IntParse.Bytes) (i j : Int) : List Int :=
  skipspaceAccessesLoop s j (s.length + 1) i

/-- Byte reads performed by `skipspace_back`, `base/parse.jl:84-97`. -/
def skipspaceBackAccessesLoop (s : ParsePrint.IntParse.Bytes) (lo : Int) : Nat → Int → List Int
  | 0, _ => []
  | fuel + 1, j =>
    if j ≥ lo then
      let b := ParsePrint.IntParse.cu s j
      j :: if ParsePrint.IntParse.isspaceAscii b then
        skipspaceBackAccessesLoop s lo fuel (j - 1)
      else if b.val ≥ 0x80 ∧ ParsePrint.IntParse.skipspacecharBack s lo j < j then
        skipspaceBackAccessesLoop s lo fuel (ParsePrint.IntParse.skipspacecharBack s lo j)
      else []
    else []

def skipspaceBackAccesses (s : ParsePrint.IntParse.Bytes) (i j : Int) : List Int :=
  skipspaceBackAccessesLoop s i (s.length + 1) j

/-- Reads made by `parseint_preamble` after the `skipspace` calls compute its
current index, `base/parse.jl:99-123`. -/
def preambleAccesses (signed : Bool) (base : Int) (s : ParsePrint.IntParse.Bytes)
    (start stop : Int) : List Int :=
  let firstReads := skipspaceAccesses s start stop
  let i1 := ParsePrint.IntParse.skipspace s start stop
  let signReads := if signed ∧ i1 ≤ stop then [i1] else []
  let secondReads := skipspaceAccesses s (i1 + 1) stop
  let i2 := ParsePrint.IntParse.skipspace s (i1 + 1) stop
  let prefixReads1 := if base = 0 ∧ i1 < stop then [i1, i1 + 1] else []
  let prefixReads2 := if base = 0 ∧ i2 < stop then [i2, i2 + 1] else []
  firstReads ++ signReads ++ secondReads ++ prefixReads1 ++ prefixReads2

/-- Candidate trailing-scan reads for a digit position computed by a preamble
branch. The source calls the scan only for a nonzero in-range digit position. -/
def guardedParseBackReads (s : ParsePrint.IntParse.Bytes) (d j : Int) : List Int :=
  if 1 ≤ d ∧ d ≤ j then skipspaceBackAccesses s d j else []

/-- All reads at the eight listed sites in `parseint_utf8`, starting from the
public `parse`/`tryparse` inputs `i = 1`, `j = ncodeunits(s)`. This is the union
of the fast path, unsigned and signed preamble paths, prefix branches, and
their possible trailing scans. -/
def integerParseAccesses (t : IntTy) (s : ParsePrint.IntParse.Bytes) (base : Int) : List Int :=
  let j : Int := s.length
  let fastReads := if 1 ≤ j then [1, j] ++ if 2 ≤ j then [2] else [] else []
  let i1 := ParsePrint.IntParse.skipspace s 1 j
  let i2 := ParsePrint.IntParse.skipspace s (i1 + 1) j
  fastReads ++ preambleAccesses t.signed base s 1 j ++
    guardedParseBackReads s i1 j ++ guardedParseBackReads s (i1 + 2) j ++
    guardedParseBackReads s i2 j ++ guardedParseBackReads s (i2 + 2) j

def IntegerParseSafe : Prop :=
  ∀ (t : IntTy) (s : ParsePrint.IntParse.Bytes) base i,
    i ∈ integerParseAccesses t s base → inAxis 1 s.length i

inductive IEEEFloatKind where
  | f64
  | f32
  | f16
  deriving DecidableEq

/-- `pow10range(T)`, `base/parsers/floats.jl:64-68`. -/
def pow10Range : IEEEFloatKind → Int × Int
  | .f64 => (-342, 308)
  | .f32 => (-64, 38)
  | .f16 => (-26, 4)

/-- The `POW5[q - POW5_MIN + 1]` access after the two range-return branches of
`eisellemire`, `base/parsers/floats.jl:94-102`. -/
def pow5Access (kind : IEEEFloatKind) (q : Int) : Option Nat :=
  let range := pow10Range kind
  if q < range.1 ∨ range.2 < q then none else some (q + 343).toNat

/-- The Clinger-table index selected after `abs(q) < length(p10)`,
`base/parsers/floats.jl:143-150`. -/
def exactPow10Index (q : Int) : Nat :=
  if q < 0 then q.natAbs + 1 else q.toNat + 1

/-- The Clinger-table access selected by `abs(q) < length(p10)`,
`base/parsers/floats.jl:143-150`. -/
def exactPow10Access (q : Int) (tableLength : Nat) : Option Nat :=
  if q.natAbs < tableLength then some (exactPow10Index q) else none

/-- Union of byte indices read by `cmpmidpoint`, digit and exponent scans,
hex parsing, word matching, NaN payload parsing, and the public `parsefloat`
branches. Every one is a guarded subrange of the public `1:length(buf)` span,
`base/parsers/floats.jl:171-419`. -/
def floatParseByteAccesses (buf : List UInt8) : List Nat :=
  oneBasedLoop buf.length

def FloatParseSafe : Prop :=
  (∀ kind q index, pow5Access kind q = some index → inOneBased 651 index) ∧
  (∀ q tableLength index, exactPow10Access q tableLength = some index →
    inOneBased tableLength index) ∧
  (∀ buf index, index ∈ floatParseByteAccesses buf → inOneBased buf.length index)

/-- A string returned by `ConvertSidToStringSidW`; `wcslen` computes the
wrapped extent from these code units and excludes the trailing NUL. -/
structure SidString where
  codeunits : List UInt16

def sidWrapLength (sid : SidString) : Nat := sid.codeunits.length
def sidStorageLength (sid : SidString) : Nat := sid.codeunits.length + 1

/-- Pointer widths supported by Julia platforms. -/
inductive SupportedPointerWidth where
  | bits32
  | bits64
  deriving DecidableEq

def pointerBytes : SupportedPointerWidth → Nat
  | .bits32 => 4
  | .bits64 => 8

/-- Byte offsets read for `pw_uid` after the two pointer fields in
`struct passwd`, `base/path.jl:781-807`. -/
def passwdUidOffsets (width : SupportedPointerWidth) : List Nat :=
  (List.range 4).map (fun byte => 2 * pointerBytes width + byte)

/-- The SID wrapper uses exactly the `wcslen` result, and the four-byte uid
load lies inside the 256-byte `pwd_storage` on every supported pointer width. -/
def PathBufferSafe : Prop :=
  (∀ sid : SidString, sidWrapLength sid ≤ sidStorageLength sid) ∧
  (∀ width offset, offset ∈ passwdUidOffsets width → offset < 256)

/-- Runtime thread ids are zero-based and below `maxthreadid()`. -/
structure ThreadRuntime where
  maxThreadId : Nat
  threadId : Fin maxThreadId

/-- The global context vector starts nonempty and only grows. -/
structure MatchContexts where
  length : Nat
  nonempty : 1 ≤ length

def juliaThreadId (runtime : ThreadRuntime) : Nat := runtime.threadId.val + 1

/-- The vector length after the slow-path growth at
`base/pcre.jl:40-56`. -/
def matchContextLength (runtime : ThreadRuntime) (contexts : MatchContexts) : Nat :=
  let tid := juliaThreadId runtime
  if contexts.length < tid then contexts.length + runtime.maxThreadId else contexts.length

/-- A PCRE2 8-bit name table has `count` fixed-size entries; every entry begins
with two capture-number bytes. -/
structure PcreNameTable where
  count : Nat
  entrySize : Nat
  headerFits : 2 ≤ entrySize

/-- The two 1-based pointer indices computed for every table entry by
`capture_names`, `base/pcre.jl:265-280`. -/
def pcreNameByteIndices (table : PcreNameTable) : List Nat :=
  (oneBasedLoop table.count).flatMap fun i =>
    let offset := (i - 1) * table.entrySize + 1
    [offset, offset + 1]

def pcreNameStorageLength (table : PcreNameTable) : Nat :=
  table.count * table.entrySize

def PcreNameTableSafe : Prop :=
  (∀ (runtime : ThreadRuntime) (contexts : MatchContexts),
    inOneBased (matchContextLength runtime contexts) (juliaThreadId runtime)) ∧
  (∀ (table : PcreNameTable) i, i ∈ pcreNameByteIndices table →
    inOneBased (pcreNameStorageLength table) i)

/-- Indices read by the `n == 1` and `n < 16` branches of `_mapreduce`; the
other branches access no element at the listed sites,
`base/reduce.jl:436-455`. -/
def linearMapreduceAccesses (a : LinearArray α) : List Int :=
  match linearArrayIndices a with
  | [] => []
  | [i] => [i]
  | i :: j :: rest => if rest.length + 2 < 16 then i :: j :: rest else []

/-- Word indices computed by `_simple_count(identity, ::Array{Bool})` from
`chunks = length(x) ÷ sizeof(UInt)`, `base/reduce.jl:1097-1112`. -/
def boolWordAccesses (width : SupportedPointerWidth) (length : Nat) : List Nat :=
  oneBasedLoop (length / pointerBytes width)

/-- The short reduction reads only its computed `LinearIndices`. Every word
load covers `sizeof(UInt)` Bool bytes within the complete-word prefix. -/
def ReduceSafe : Prop :=
  (∀ (α : Type) (a : LinearArray α) i, i ∈ linearMapreduceAccesses a →
    inAxis a.first a.values.length i) ∧
  (∀ (width : SupportedPointerWidth) length i,
    i ∈ boolWordAccesses width length → i * pointerBytes width ≤ length)

/-- Character-start indices computed by String iteration. `chopprefix`,
`chopsuffix`, `lstrip`, `rstrip`, truncation, and split advance only through
these states. -/
def stringCharacterAccesses (s : Strings.JStr) : List Int :=
  (Strings.collectPairs s).map fun pair => pair.2.val

/-- Code-unit reads computed by the String fast path of `chomp`. -/
def chompCodeunitAccesses (s : Strings.JStr) : List Nat :=
  let n := s.bytes.length
  if n = 0 then [] else [n] ++ if 1 < n then [n - 1] else []

/-- All sentinel or character boundaries accepted by unchecked SubString and
raw_substring construction: `0` through `ncodeunits(s)+1`. -/
def stringSubstringBoundaries (s : Strings.JStr) : List Int :=
  (List.range (s.bytes.length + 2)).map fun (i : Nat) => (i : Int)

/-- Bounds union for the control flow of `chopprefix`, `chopsuffix`, `chomp`,
`lstrip`, `rstrip`, `string_truncate_boundaries`, and `SplitIterator.iterate`,
`base/strings/util.jl:268-806`. -/
def StringPositionSafe : Prop :=
  (∀ s i, i ∈ stringCharacterAccesses s → inAxis 1 s.bytes.length i) ∧
  (∀ s i, i ∈ chompCodeunitAccesses s → inOneBased s.bytes.length i) ∧
  (∀ s i, i ∈ stringSubstringBoundaries s → 0 ≤ i ∧ i ≤ s.bytes.length + 1)

/-- Destination indices computed by the `eachindex(dest)` loop of
`hex2bytes!`, `base/strings/util.jl:1260-1274`. -/
def hex2bytesDestIndices (dest : List UInt8) : List Nat :=
  oneBasedLoop dest.length

/-- The two output positions computed by `bytes2hex` for every enumerated
input byte, `base/strings/util.jl:1316-1327`. -/
def bytes2hexOutputIndices (bytes : List UInt8) : List Nat :=
  (oneBasedLoop bytes.length).flatMap fun i => [2 * i - 1, 2 * i]

/-- The two `hex_chars` indices computed from every byte. -/
def bytes2hexDigitIndices (bytes : List UInt8) : List Nat :=
  bytes.flatMap fun x => [x.toNat / 16 + 1, x.toNat % 16 + 1]

/-- Code-unit indices computed by `ascii(s::String)` from `sizeof(s)`,
`base/strings/util.jl:1336-1341`. -/
def asciiCodeunitIndices (s : Strings.JStr) : List Nat :=
  oneBasedLoop s.bytes.length

def StringHexSafe : Prop :=
  (∀ dest i, i ∈ hex2bytesDestIndices dest → inOneBased dest.length i) ∧
  (∀ bytes i, i ∈ bytes2hexOutputIndices bytes → inOneBased (2 * bytes.length) i) ∧
  (∀ bytes i, i ∈ bytes2hexDigitIndices bytes →
    inOneBased StringUtil.hexChars.length i) ∧
  (∀ s i, i ∈ asciiCodeunitIndices s → inOneBased s.bytes.length i)

/-- The utf8proc category table used by `category_code`. Its result type is the
documented range `0:30` (`base/strings/unicode.jl:371-381`). -/
structure CategoryData where
  cat : UInt32 → Fin 31
  idStart : UInt32 → Bool
  idChar : UInt32 → Bool

def CategoryData.toUData (d : CategoryData) : Show.UData :=
  ⟨fun u => (d.cat u).val, d.idStart, d.idChar⟩

/-- The index computed by `category_string(::Char)`, including the malformed
character branch of `category_code`, `base/strings/unicode.jl:371-403`. -/
def categoryStringIndex (d : CategoryData) (c : UInt32) : Nat :=
  Show.categoryCode d.toUData c + 1

def UnicodeCategorySafe : Prop :=
  ∀ (d : CategoryData) (c : UInt32), inOneBased 32 (categoryStringIndex d c)

/-- Julia's requested extent and the C array extent for
`jl_gc_page_utilization_stats`, `base/timing.jl:148-152`,
`src/gc-stock.c:942`, and `src/gc-mmtk/gc-mmtk.c:1433-1434`. -/
def gcPageUtilizationRequested : Nat := 51
def gcPageUtilizationStorage : List Unit := List.replicate 51 ()

/-- Julia's reason names and the matching C storage for
`jl_full_sweep_reasons`, `base/timing.jl:157-183` and
`src/gc-stock.h:571-579`. -/
def fullSweepReasonNames : List Nat := [0, 1, 2, 3, 4]
def fullSweepReasonStorage : List Unit := List.replicate 5 ()

/-- Both `unsafe_wrap` calls use extents computed by their matching Julia and C
constants. The later reason reads use indices from `enumerate(names)`. -/
def TimingGlobalsSafe : Prop :=
  gcPageUtilizationRequested ≤ gcPageUtilizationStorage.length ∧
  fullSweepReasonNames.length ≤ fullSweepReasonStorage.length ∧
  ∀ i ∈ oneBasedLoop fullSweepReasonNames.length,
    inOneBased fullSweepReasonStorage.length i

end JuliaLean.MemSafety.G3
